[{"id": 7004138000, "chapter_id": 24138, "verse_number": "४-८७-१", "content_sanskrit": "अगस्त्य उवाच ।\nसर्वज्ञसूनो षड्वक्त्र सर्वार्थकुशल प्रभो ।\nप्रादुर्भावं निशम्यैषां लिंगानां मुक्तिदायिनाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004138001, "chapter_id": 24138, "verse_number": "४-८७-२", "content_sanskrit": "नितरां परितृप्तोस्मि सुधां पीत्वेव निर्जरः ।\nओंकारप्रमुखैर्लिंगैरिदमानंदकाननम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004138002, "chapter_id": 24138, "verse_number": "४-८७-३", "content_sanskrit": "आनंदमेवजनयेदपि पापजुषामिह ।\nपरानंदमहं प्राप्तः श्रुत्वैतल्लिंगकीर्तनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004138003, "chapter_id": 24138, "verse_number": "४-८७-४", "content_sanskrit": "जीवन्मुक्तैवासं हि क्षेत्रतत्त्वश्रुतेरहम् ।\nस्कंददक्षेश्वरादीनि लिंगानीह चतुर्दश ।\nयान्युक्तानि समाचक्ष्व तत्प्रभावमशेषतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004138004, "chapter_id": 24138, "verse_number": "४-८७-५", "content_sanskrit": "यो दक्षो गर्हयामास मध्ये देवसभं विभुम् ।\nस कथं लिंगमीशस्य प्रत्यस्थापयदद्भुतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004138005, "chapter_id": 24138, "verse_number": "४-८७-६", "content_sanskrit": "इति श्रुत्वा शिखिरथः कुंभयोनेरुदीरितम् ।\nसूत संकथयामास दक्षेश्वर समुद्भवम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004138006, "chapter_id": 24138, "verse_number": "४-८७-७", "content_sanskrit": "स्कंद उवाच ।\nआकर्णय मुने वच्मि कथां कल्मषहारिणीम् ।\nपुरश्चरणकामोसौ दक्षः काशीं समाययौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004138007, "chapter_id": 24138, "verse_number": "४-८७-८", "content_sanskrit": "छागवक्त्रो विरूपास्यो दधीचि परिधिक्कृतः ।\nप्रायश्चित्तविधानार्थं सूपदिष्टः स्वयंभुवा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004138008, "chapter_id": 24138, "verse_number": "४-८७-९", "content_sanskrit": "एकदा देवदेवस्य सेवार्थं शशिमौलिनः ।\nकैलासमगमद्विष्णुः पद्मयोनिपुरस्कृतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004138009, "chapter_id": 24138, "verse_number": "४-८७-१०", "content_sanskrit": "इंद्रादयो लोकपाला विश्वेदेवा मरुद्गणाः ।\nआदित्या वसवो रुद्राः साध्या विद्याधरोरगाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004138010, "chapter_id": 24138, "verse_number": "४-८७-११", "content_sanskrit": "ऋषयोऽप्सरसोयक्षा गंधर्वाः सिद्धचारणाः ।\nतैर्नतो देवदेवेशः परिहृष्टतनूरुहैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004138011, "chapter_id": 24138, "verse_number": "४-८७-१२", "content_sanskrit": "स्तुतश्च नाना स्तुतिभिः शंभुनापि कृतादराः ।\nविविशुश्चासनश्रेण्यां तन्मुखासक्तदृष्टयः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004138012, "chapter_id": 24138, "verse_number": "४-८७-१३", "content_sanskrit": "अथ तेषूपविष्टेषु शंभुना विष्टरश्रवाः ।\nकृतहस्तपरिस्पर्शमानः पृष्टो महादरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004138013, "chapter_id": 24138, "verse_number": "४-८७-१४", "content_sanskrit": "श्रीवत्सलांछन हरे दैत्यवंशदवानल ।\nकच्चित्पालयितुं शक्तिस्त्रिलोकीमस्त्यकुंठिता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004138014, "chapter_id": 24138, "verse_number": "४-८७-१५", "content_sanskrit": "दितिजान्दनुजान्दुष्टान्कच्चिच्छासि रणांगणे ।\nअपि कुद्धान्महीदेवान्मामिव प्रतिमन्यसे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004138015, "chapter_id": 24138, "verse_number": "४-८७-१६", "content_sanskrit": "बाधया रहिता गावः कच्चित्संति महीतले ।\nस्त्रियः संति हि सुश्रीकाः पतिव्रतपरायणाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004138016, "chapter_id": 24138, "verse_number": "४-८७-१७", "content_sanskrit": "विधियज्ञाः प्रवर्तंते पृथिव्यां बहुदक्षिणाः ।\nनिराबाधं तपः कच्चिदस्ति शश्वत्तपस्विनाम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004138017, "chapter_id": 24138, "verse_number": "४-८७-१८", "content_sanskrit": "निष्प्रत्यूहं पठंत्येव सांगान्वेदान्द्विजोत्तमाः ।\nमहीपालाः प्रजाः कच्चित्पांति त्वमिवकेशव ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004138018, "chapter_id": 24138, "verse_number": "४-८७-१९", "content_sanskrit": "स्वेषु स्वेषु च धर्मेषु कच्चिद्वर्णाश्रमास्तथा ।\nनिष्ठावंतो हि तिष्ठंति प्रहृष्टेंद्रियमानसाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004138019, "chapter_id": 24138, "verse_number": "४-८७-२०", "content_sanskrit": "धूर्जटिः परिपृछ्येति हृष्टं वैकुंठनायकम् ।\nब्रह्माणं चापि पप्रच्छ ब्राह्मं तेजः समेधते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004138020, "chapter_id": 24138, "verse_number": "४-८७-२१", "content_sanskrit": "सत्यमस्खलितं कच्चिदस्ति त्रैलोक्यमंडपे ।\nतीर्थावरोधो न क्वापि केनचित्क्रियते विधे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004138021, "chapter_id": 24138, "verse_number": "४-८७-२२", "content_sanskrit": "इंद्रादयः सुराः कच्चित्स्वेषु स्वेषु पुरेष्वहो ।\nराज्यं प्रशासति स्वस्थाः कृष्णदोर्दंडपालिताः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004138022, "chapter_id": 24138, "verse_number": "४-८७-२३", "content_sanskrit": "प्रत्येकं परिपृच्छयेशः सर्वानित्थं कृतादरान् ।\nपृष्ट्वा गमनकार्यं च तेषां कृत्वा मनोरथान् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004138023, "chapter_id": 24138, "verse_number": "४-८७-२४", "content_sanskrit": "विससर्जाथ तान्सर्वान्देवः सौधं समाविशत् ।\nगतेष्वथ च देवेषु स्वस्व धिष्ण्येषु हृष्टवत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004138024, "chapter_id": 24138, "verse_number": "४-८७-२५", "content_sanskrit": "मध्ये मार्गं स चिंतोभूद्दक्षः सत्याः पिता तदा ।\nअन्यदेवसमानं स मानं प्राप न चाधिकम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004138025, "chapter_id": 24138, "verse_number": "४-८७-२६", "content_sanskrit": "अतीव क्षुब्धचित्तोभून्मंदराघाततोऽब्धिवत् ।\nउवाच च मनस्येतन्महाक्रोधरयांधदृक् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004138026, "chapter_id": 24138, "verse_number": "४-८७-२७", "content_sanskrit": "अतीवगर्वितो जातः सती मे प्राप्य कन्यकाम् ।\nकस्यचिन्नाप्यसौ प्रायो न कोस्यापि क्वचित्पुनः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004138027, "chapter_id": 24138, "verse_number": "४-८७-२८", "content_sanskrit": "किं वंश्यस्त्वेष किं गोत्रः किं देशीयः किमात्मकः ।\nकिं वृत्तिः किं समाचारो विपा दी वृषवाहनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004138028, "chapter_id": 24138, "verse_number": "४-८७-२९", "content_sanskrit": "न प्रायशस्तपस्व्येष क्व तपः क्वास्त्रधारणम् ।\nन गृहस्थेषु गण्योसौ श्मशाननिलयो यतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004138029, "chapter_id": 24138, "verse_number": "४-८७-३०", "content_sanskrit": "असौ न ब्रह्मचारी स्यात्कृतपाणिग्रह स्थितिः ।\nवानप्रस्थ्यं कुतश्चास्मिन्नैश्वर्यमदमोहिते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004138030, "chapter_id": 24138, "verse_number": "४-८७-३१", "content_sanskrit": "न ब्राह्मणोभवत्येष यतो वेदो न वेत्त्यमुम् ।\nशस्त्रास्त्रधारणात्प्रायः क्षत्रियः स्यान्न सोप्ययम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004138031, "chapter_id": 24138, "verse_number": "४-८७-३२", "content_sanskrit": "क्षतात्संत्राणनात्क्षत्रं तत्क्वास्मिन्प्रलयप्रिये ।\nवैश्योपि न भवेदेष सदा निर्धनचेष्टनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004138032, "chapter_id": 24138, "verse_number": "४-८७-३३", "content_sanskrit": "शूद्रोपि न भवेत्प्रायो नागयज्ञोपवीतवान् ।\nएवं वर्णाश्रमातीतः कोसौ सम्यङ्नकीर्त्यते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004138033, "chapter_id": 24138, "verse_number": "४-८७-३४", "content_sanskrit": "सर्वः प्रकृत्या ज्ञायेत स्थाणुः प्रकृतिवर्जितः ।\nप्रायशः पुरुषोनासावर्धनारीवपुर्यतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004138034, "chapter_id": 24138, "verse_number": "४-८७-३५", "content_sanskrit": "योषापि न भवेदेष यतोसौ श्मश्रुलाननः ।\nनपुंसकोपि न भवेल्लिंगमस्ययतोर्च्यते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004138035, "chapter_id": 24138, "verse_number": "४-८७-३६", "content_sanskrit": "बालोपि न भवत्येष यतोऽयं बहुवार्षिकः ।\nअनादिवृद्धो लोकेषु गीयते चोग्र एष यत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004138036, "chapter_id": 24138, "verse_number": "४-८७-३७", "content_sanskrit": "अतो युवत्वं संभाव्यं नात्र नूनं चिरंतने ।\nवृद्धोऽपि न भवत्येष जरामरणवर्जितः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004138037, "chapter_id": 24138, "verse_number": "४-८७-३८", "content_sanskrit": "ब्रह्मादीन्संहरेत्प्रांते तथापि च न पातकी ।\nपुण्यलेशोपि नास्त्यस्मिन्ब्रह्ममौलिच्छिदिक्रुधा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004138038, "chapter_id": 24138, "verse_number": "४-८७-३९", "content_sanskrit": "अस्थिनेपथ्यवति च क्व शुचित्वं विवाससि ।\nकिं बहूक्तेन नो किंचिज्ज्ञायतेऽस्य विचेष्टितम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004138039, "chapter_id": 24138, "verse_number": "४-८७-४०", "content_sanskrit": "अहो धार्ष्ट्यं महद्दृष्टं जटिलस्याद्य चाद्भुतम् ।\nयदासनान्नोत्थितोसौ दृष्ट्वा मां श्वशुरं गुरुम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004138040, "chapter_id": 24138, "verse_number": "४-८७-४१", "content_sanskrit": "एवंभूता भवंत्येव मातापितृविवर्जिताः ।\nनिर्गुणा अकुलीनाश्च कर्मभ्रष्टा निरंकुशाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004138041, "chapter_id": 24138, "verse_number": "४-८७-४२", "content_sanskrit": "स्वच्छंदचारिणोऽनाथाः सर्वत्र स्वाभिमानिनः ।\nअकिंचना अपिप्रायस्तथापीश्वरमानिनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004138042, "chapter_id": 24138, "verse_number": "४-८७-४३", "content_sanskrit": "जामातॄणां स्वभावोयं प्रायशो गर्वभाजनम् ।\nकिंचिदैश्वयर्मासाद्य भवत्येव न संशयः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004138043, "chapter_id": 24138, "verse_number": "४-८७-४४", "content_sanskrit": "द्विजराजः स गर्विष्ठो रोहिणीप्रेमनिर्भरः ।\nकृत्तिकादिषु चास्नेही मया शप्तः क्षयीकृतः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004138044, "chapter_id": 24138, "verse_number": "४-८७-४५", "content_sanskrit": "अस्याहं गर्वसर्वस्वं हरिष्याम्येव शूलिनः ।\nयथावमानितश्चाहमनेनास्य गृहं गतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004138045, "chapter_id": 24138, "verse_number": "४-८७-४६", "content_sanskrit": "तथास्याहं करिष्यामि मानहानिं च सर्वतः ।\nसंप्रधार्येति बहुशः स तु दक्षः प्रजापतिः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004138046, "chapter_id": 24138, "verse_number": "४-८७-४७", "content_sanskrit": "प्राप्य स्वभवनं देवानाजुहाव सवासवान् ।\nअहं यियक्षुर्यूयं मे यज्ञसाहाय्यकारिणः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004138047, "chapter_id": 24138, "verse_number": "४-८७-४८", "content_sanskrit": "भवंतु यज्ञसंभारानानयंतु त्वरान्विताः ।\nश्वेतद्वीपमथो गत्वा चक्रे चक्रिणमच्युतम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004138048, "chapter_id": 24138, "verse_number": "४-८७-४९", "content_sanskrit": "महाक्रतूपद्रष्टारं यज्ञपूरुषमेव च ।\nतस्यर्त्विजोभवन्सर्व ऋषयो ब्रह्मवादिनः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004138049, "chapter_id": 24138, "verse_number": "४-८७-५०", "content_sanskrit": "प्रावर्तत ततस्तस्य दक्षस्य च महाध्वरः ।\nदृष्ट्वा देवनिकायांश्च तस्मिन्दक्ष महाध्वरे ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004138050, "chapter_id": 24138, "verse_number": "४-८७-५१", "content_sanskrit": "अनीश्वरांस्ततो वेधा व्याजं कृत्वा गृहं ययौ ।\nदधीचिरथ संवीक्ष्य सर्वांस्त्रैलोक्यवासिनः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004138051, "chapter_id": 24138, "verse_number": "४-८७-५२", "content_sanskrit": "दक्षयज्ञे समायातान्सतीश्वरविवर्जितान् ।\nप्राप्तसंमानसंभारान्वासोलंकृतिपूर्वकम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004138052, "chapter_id": 24138, "verse_number": "४-८७-५३", "content_sanskrit": "दक्षस्य हि शुभोदर्कमिच्छन्प्रोवाच चेति वै ।\nदधीचिरुवाच ।\nदक्षप्रजापते दक्ष साक्षाद्धातृस्वरूपधृक् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004138053, "chapter_id": 24138, "verse_number": "४-८७-५४", "content_sanskrit": "न चास्ति तव सामर्थ्यं क्वापि कस्यापि निश्चितम् ।\nयादृशः क्रतुसंभारस्तव चेह समीक्ष्यते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004138054, "chapter_id": 24138, "verse_number": "४-८७-५५", "content_sanskrit": "न तादृङ्नेदसि प्रायः क्वापि ज्ञातो महामते ।\nक्रतुस्तु नैव कर्तव्यो नास्ति क्रतुसमो रिपुः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004138055, "chapter_id": 24138, "verse_number": "४-८७-५६", "content_sanskrit": "कर्तव्यश्चेत्तदाकार्यः स्याच्चेत्संपत्ति रीदृशी ।\nसाक्षादग्निः स्वयं कुंडे साक्षादिंद्रादिदेवताः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004138056, "chapter_id": 24138, "verse_number": "४-८७-५७", "content_sanskrit": "साक्षाच्च सर्वे मंत्रा वै साक्षाद्यज्ञपुमानसौ ।\nआचार्यपदवीमेष देवाचार्यः स्वयं चरेत् ।\nसाक्षाद्ब्रह्मा स्वयं चैष भृगुर्वै कर्मकांडवित् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004138057, "chapter_id": 24138, "verse_number": "४-८७-५८", "content_sanskrit": "अयं पूषा भगस्त्वेष इयं देवी सरस्वती ।\nएते च सर्वदिक्पाला यज्ञरक्षाकृतः स्वयम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004138058, "chapter_id": 24138, "verse_number": "४-८७-५९", "content_sanskrit": "त्वं च दीक्षां शुभां प्राप्तो देव्या च शतरूपया ।\nजामाता त्वेष ते धर्मः पत्नीभिर्दशभिः सह ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004138059, "chapter_id": 24138, "verse_number": "४-८७-६०", "content_sanskrit": "स्वयमेव हि कुर्वीत धर्मकार्यं प्रयत्नतः ।\nओषधीनामयं नाथस्तव जामातृषूत्तमः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004138060, "chapter_id": 24138, "verse_number": "४-८७-६१", "content_sanskrit": "सप्तविंशतिभिः सार्धं पत्नीभिस्तव कार्यकृत् ।\nओषधीः पूरयेत्सर्वा द्विजराजो महासुधीः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004138061, "chapter_id": 24138, "verse_number": "४-८७-६२", "content_sanskrit": "दीक्षितो राजसूयस्य दत्तत्रैलोक्यदक्षिणः ।\nमारीचः कश्यपश्चासौ प्रजापतिषु सत्तमः ।\nत्रयोदशमिताभिश्च भार्याभिस्तव कार्यकृत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004138062, "chapter_id": 24138, "verse_number": "४-८७-६३", "content_sanskrit": "हविः कामदुघा सूते कल्पवृक्षः समित्कुशान् ।\nदारुपात्राणि सर्वाणि शकटं मंडपादिकम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004138063, "chapter_id": 24138, "verse_number": "४-८७-६४", "content_sanskrit": "विश्वकर्माप्यलंकारान्कुरुतेभ्यागतर्त्विजाम् ।\nवसूनि चाऽपि वासांसि वसवोष्टौ ददत्यपि ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004138064, "chapter_id": 24138, "verse_number": "४-८७-६५", "content_sanskrit": "स्वयंलक्ष्मीरलंकुर्याद्यावै चात्र सुवासिनीः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004138065, "chapter_id": 24138, "verse_number": "४-८७-६६", "content_sanskrit": "सर्वे सुखाय मे दक्ष वीक्षमाणस्य सर्वतः ।\nएकं दुःखाकरोत्येव यत्त्वं विस्मृतवानसि ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004138066, "chapter_id": 24138, "verse_number": "४-८७-६७", "content_sanskrit": "जीवहीनो यथा देहो भूषितोपि न शोभते ।\nतथेश्वरं विना यज्ञः श्मशानमिव लक्ष्यते ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004138067, "chapter_id": 24138, "verse_number": "४-८७-६८", "content_sanskrit": "इत्थं दधीचिवचनं श्रुत्वा दक्षः प्रजापतिः ।\nभृशं जज्वाल कोपेन हविषा कृष्णवर्त्मवत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004138068, "chapter_id": 24138, "verse_number": "४-८७-६९", "content_sanskrit": "पूर्वस्तुत्याति संहृष्टो दृष्टो योसौ दधीचिना ।\nस एव चापि कोपाग्निमुद्वमन्वीक्षितो मुखात् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004138069, "chapter_id": 24138, "verse_number": "४-८७-७०", "content_sanskrit": "प्रत्युवाचाथ तं विप्रं वेपमानांगयष्टिकः ।\nदक्षः प्रजापती रोषाज्जिघांसुरिव तं द्विजम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004138070, "chapter_id": 24138, "verse_number": "४-८७-७१", "content_sanskrit": "दक्ष उवाच ।\nब्राह्मणोसि दधीचे त्वं किं करोमि तवात्र वै ।\nदीक्षामहमहो प्राप्तः कर्तुं नायाति किंचन ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004138071, "chapter_id": 24138, "verse_number": "४-८७-७२", "content_sanskrit": "भवान्केन समाहूतो यदत्रागान्महाजडः ।\nआगतोपि हि केन त्वं पृष्ट इत्थं प्रब्रवीषि यत् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004138072, "chapter_id": 24138, "verse_number": "४-८७-७३", "content_sanskrit": "सर्वमंगलमांगल्यो यत्र श्रीमानयं हरिः ।\nस्वयं वै यज्ञपुरुषः स मखः किं श्मशानवत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004138073, "chapter_id": 24138, "verse_number": "४-८७-७४", "content_sanskrit": "यत्र वज्रधरः शक्रः शतयज्ञैकदीक्षितः ।\nत्रयस्त्रिंशतिकोटीनाममराणां पतिः स्वयम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004138074, "chapter_id": 24138, "verse_number": "४-८७-७५", "content_sanskrit": "तं त्वंचोपमिमीषेमुं श्मशानेन महामखम् ।\nधर्मराट्च स्वयं यत्र धर्माधर्मैककोविदः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004138075, "chapter_id": 24138, "verse_number": "४-८७-७६", "content_sanskrit": "श्रीदोस्ति यत्र श्रीदाता साक्षाद्यत्राशुशुक्षणिः ।\nतं यज्ञमुपमासि त्वममंगलभुवातया ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004138076, "chapter_id": 24138, "verse_number": "४-८७-७७", "content_sanskrit": "देवाचार्यः स्वयं यत्र क्रतोराचार्यतागतः ।\nअभिमानवशात्तं त्वमाख्यासि पितृकाननम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004138077, "chapter_id": 24138, "verse_number": "४-८७-७८", "content_sanskrit": "यत्रार्त्विज्यं भजंतेऽमी वसिष्ठप्रमुखर्षयः ।\nतमध्वरं समाचक्षे मंगलेतरभूमिवत् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004138078, "chapter_id": 24138, "verse_number": "४-८७-७९", "content_sanskrit": "निशम्येति मुनिः प्राह दधीचिर्ज्ञानिनां वरः ।\nसर्वमंगलमांगल्यो भवेद्यज्ञपुमान्हरिः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004138079, "chapter_id": 24138, "verse_number": "४-८७-८०", "content_sanskrit": "तथापि शांभवी शक्तिर्वेदे विष्णुः प्रपठ्यते ।\nवामांगं स्रष्टुराद्यस्य हरिस्तदितरद्विधिः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004138080, "chapter_id": 24138, "verse_number": "४-८७-८१", "content_sanskrit": "दीक्षितो योश्वमेधानां शतस्य कुलिशायुधः ।\nदुर्वाससा क्षणेनापि नीतो निःश्रीकतां हि सः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004138081, "chapter_id": 24138, "verse_number": "४-८७-८२", "content_sanskrit": "पुनराराध्य भूतेशं प्रापैकाममरावतीम् ।\nयस्त्वया धर्मराजोत्र कथितः क्रतुरक्षकः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004138082, "chapter_id": 24138, "verse_number": "४-८७-८३", "content_sanskrit": "बलं तस्याखिलैर्ज्ञातं श्वेतं पाशयतः पुरा ।\nधनदस्त्र्यंबकसखस्तच्चक्षुश्चाशुशुक्षणिः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004138083, "chapter_id": 24138, "verse_number": "४-८७-८४", "content_sanskrit": "पार्ष्णिग्राह्यभवद्रुद्रो देवाचार्यस्य वै तदा ।\nयदा तारामधार्षीत्स द्विजराजोऽतिसुंदरीम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004138084, "chapter_id": 24138, "verse_number": "४-८७-८५", "content_sanskrit": "तं विदंति वसिष्ठाद्यास्तवार्त्विज्यं भजंति ये ।\nएको रुद्रो न द्वितीयः संविदाना अपीति हि ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004138085, "chapter_id": 24138, "verse_number": "४-८७-८६", "content_sanskrit": "प्रावर्तंतर्षयोन्येपि गौरवात्तव ते क्रतौ ।\nयदि मे ब्राह्मणस्यैकं शृणोषि वचनं हितम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004138086, "chapter_id": 24138, "verse_number": "४-८७-८७", "content_sanskrit": "तदा क्रतुफलाधीशं विश्वेशं त्वं समाह्वय ।\nविना तेन क्रतुरसौ कृतोप्यकृत एव हि ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004138087, "chapter_id": 24138, "verse_number": "४-८७-८८", "content_sanskrit": "सति तस्म्निमहादेवे विश्वकर्मैकसाक्षिणि ।\nतवापि चैषा सर्वेषां फलिष्यंति मनोरथाः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004138088, "chapter_id": 24138, "verse_number": "४-८७-८९", "content_sanskrit": "यथा जडानि बीजानि न फलंति स्वयं तथा ।\nजडानि सर्वकर्माणि न फलंतीश्वरं विना ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004138089, "chapter_id": 24138, "verse_number": "४-८७-९०", "content_sanskrit": "अर्थहीना यथा वाणी धर्महीना यथा तनुः ।\nपतिहीना यथा नारी शिवहीना तथा क्रिया ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004138090, "chapter_id": 24138, "verse_number": "४-८७-९१", "content_sanskrit": "गंगाहीना यथा देशाः पुत्रहीना यथा गृहाः ।\nदानहीना यथा संपच्छिवहीना तथा क्रिया ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004138091, "chapter_id": 24138, "verse_number": "४-८७-९२", "content_sanskrit": "मंत्रिहीनं यथा राज्यं श्रुतिहीना यथा द्विजाः ।\nयोषा हीनं यथा सौख्यं शिवहीना तथा क्रिया ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004138092, "chapter_id": 24138, "verse_number": "४-८७-९३", "content_sanskrit": "दर्भहीना यथा संध्या तिलहीनं च तर्पणम् ।\nहविर्हीनो यथा होमः शिवहीना तथा क्रिया ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004138093, "chapter_id": 24138, "verse_number": "४-८७-९४", "content_sanskrit": "इत्थं दधीचिनाख्यातं जग्राह वचनं न तत् ।\nदक्षो दक्षोपि तत्रैव शंभोर्माया विमोहितः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004138094, "chapter_id": 24138, "verse_number": "४-८७-९५", "content_sanskrit": "प्रोवाच च भृशं क्रुद्धः का चिंता तव मे क्रतोः ।\nक्रतुमुख्यानि सर्वाणि यानि कर्माणि सर्वतः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004138095, "chapter_id": 24138, "verse_number": "४-८७-९६", "content_sanskrit": "तानि सिद्ध्यंति नियतं यथार्थकरणादिह ।\nअयथार्थविधानेन सिद्ध्येत्कर्मापि नेशितुः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004138096, "chapter_id": 24138, "verse_number": "४-८७-९७", "content_sanskrit": "स्वकर्मसिद्धये चाथ सर्व एव हि चेश्वरः ।\nईश्वरः कर्मणां साक्षी यत्त्वयापीति भाषितम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004138097, "chapter_id": 24138, "verse_number": "४-८७-९८", "content_sanskrit": "तत्तथास्तु परं साक्षी नार्थं दद्याच्च कुत्रचित् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004138098, "chapter_id": 24138, "verse_number": "४-८७-९९", "content_sanskrit": "जडानि सर्वकर्माणि न फलंतीश्वरं विना ।\nयदुक्तं भवता तत्राप्यहो दृष्टांतयाम्यहम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004138099, "chapter_id": 24138, "verse_number": "४-८७-१००", "content_sanskrit": "जडान्यपि च बीजानि कालं संप्राप्यवात्मनः ।\nअंकूरयंति कालाच्च पुष्प्यंति च फलंति च ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004138100, "chapter_id": 24138, "verse_number": "४-८७-१०१", "content_sanskrit": "विनापीशं तथा कर्म स्वयं कालात्फलत्यहो ।\nकिमीश्वरेण तेनात्र महामंगलमूर्तिना ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004138101, "chapter_id": 24138, "verse_number": "४-८७-१०२", "content_sanskrit": "दधीचिरुवाच ।\nयथार्थकरणात्सिद्धमपि कार्यं कदाचन ।\nईश्वरप्रातिकूल्याच्च सिद्धमेवाशु नश्यति ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004138102, "chapter_id": 24138, "verse_number": "४-८७-१०३", "content_sanskrit": "ईश्वरेच्छा बलात्कर्म कृतमप्यविधानतः ।\nसंसिद्ध्येत्तदधीनाश्च कथं सर्व इहेश्वराः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004138103, "chapter_id": 24138, "verse_number": "४-८७-१०४", "content_sanskrit": "सामान्यसाक्षिवन्नेशः सर्वेषां सर्वकर्मणाम् ।\nसाक्षीभवेदसंदिग्धः फलस्य प्रतिभूरपि ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004138104, "chapter_id": 24138, "verse_number": "४-८७-१०५", "content_sanskrit": "भूजलादिस्वरूपेण बीजमाविश्यसर्वकृत् ।\nस्वयं कालस्वरूपेण विदध्यादंकुरोदयम् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004138105, "chapter_id": 24138, "verse_number": "४-८७-१०६", "content_sanskrit": "यत्त्वयोक्तं विनापीशं काले कर्मफलेत्स्वयम् ।\nस एव कालो भगवान्सर्वकर्ता महेशिता ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004138106, "chapter_id": 24138, "verse_number": "४-८७-१०७", "content_sanskrit": "अन्यच्च भवता प्रोक्तं तदेकं तथ्यमेव तत् ।\nकिमीश्वरेण तेनात्र महामंगलमूर्तिना ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004138107, "chapter_id": 24138, "verse_number": "४-८७-१०८", "content_sanskrit": "ये महांतो भवंत्येव ये च मंगलमूर्तयः ।\nईश्वराख्या च येष्वस्ति किं तैरत्र तवांतिके ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004138108, "chapter_id": 24138, "verse_number": "४-८७-१०९", "content_sanskrit": "उत्तरादुत्तरं चेति प्रत्युत्तरयति द्विजे ।\nदधीचौ चुक्रुधेऽत्यंतं दक्षोगर्वातिसुश्रिया ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004138109, "chapter_id": 24138, "verse_number": "४-८७-११०", "content_sanskrit": "आदिदेश समीपस्थानालोक्य परितस्त्विति ।\nब्राह्मणापसदं चामुं परिदूरयताशु वै ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004138110, "chapter_id": 24138, "verse_number": "४-८७-१११", "content_sanskrit": "अमुष्मादध्वरश्रेष्ठादवरिष्ठमनोगतम् ।\nइत्थं दधीचिराकर्ण्य प्रोवाच प्रहसन्निव ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004138111, "chapter_id": 24138, "verse_number": "४-८७-११२", "content_sanskrit": "किं मां दूरयसे मूढ दूरीभूतो भवानपि ।\nसर्वेभ्यो मंगलेभ्यश्च सर्वैरेभिः समं ध्रुवम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004138112, "chapter_id": 24138, "verse_number": "४-८७-११३", "content_sanskrit": "अकांडे क्रोधजो दंडस्तव मूर्ध्नि पतिष्यति ।\nमहेशितुस्त्रिजगती परिशास्तुः प्रजापते ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004138113, "chapter_id": 24138, "verse_number": "४-८७-११४", "content_sanskrit": "इत्युक्त्वा निर्जगामाशु यज्ञवाटात्ततो द्विजः ।\nतस्मिन्निर्याति निर्यातो दुर्वासाश्च्यवनो भवान् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004138114, "chapter_id": 24138, "verse_number": "४-८७-११५", "content_sanskrit": "उत्तंक उपमन्युश्च ऋचीकोद्दालकावपि ।\nमांडव्यो वामदेवश्च गालवो गर्गगौतमौ ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004138115, "chapter_id": 24138, "verse_number": "४-८७-११६", "content_sanskrit": "शिवतत्त्वविदोन्येपि दक्षयज्ञाद्विनिर्ययुः ।\nगते दधीचौ सानंदं प्रावर्तत महामखः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004138116, "chapter_id": 24138, "verse_number": "४-८७-११७", "content_sanskrit": "ये स्थिता ब्राह्मणास्तत्र तेभ्यो द्विगुण दक्षिणाम् ।\nप्रादात्प्रजापतिर्दक्षस्त्वन्येभ्योप्यधिकं वसु ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004138117, "chapter_id": 24138, "verse_number": "४-८७-११८", "content_sanskrit": "सर्वे जामातरस्तेन तोषिता भूरिशोधनैः ।\nकन्याश्चालंकृताः सर्वा महाविभवविस्तरैः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004138118, "chapter_id": 24138, "verse_number": "४-८७-११९", "content_sanskrit": "ऋषिपत्न्योपि बहुशो देवपत्न्योप्यनेकशः ।\nतथा पुरांगनाः सर्वास्तेन मानभुवः कृताः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004138119, "chapter_id": 24138, "verse_number": "४-८७-१२०", "content_sanskrit": "ब्रह्मघोषेण तारेण व्योमशब्दगुणं स्फुटम् ।\nकारितं तेन दक्षेण विप्राणां हृष्टचेतसाम् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004138120, "chapter_id": 24138, "verse_number": "४-८७-१२१", "content_sanskrit": "अग्निर्मंदाग्निरभवत्तस्मिञ्जुह्वति दीक्षिते ।\nहविः परिमलेनैव परितृप्ता दिगंगनाः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004138121, "chapter_id": 24138, "verse_number": "४-८७-१२२", "content_sanskrit": "स्वाहाकारैर्वषट्कारैः सुरा जाताः पिचंडिलाः ।\nरचिता गिरयस्तेन सदन्नानां पदेपदे ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004138122, "chapter_id": 24138, "verse_number": "४-८७-१२३", "content_sanskrit": "घृतकुल्याः कृतास्तेन मधुकुल्याः सहस्रशः ।\nमहासरांसि पयसां द्रप्सस्यापि महाह्रदाः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004138123, "chapter_id": 24138, "verse_number": "४-८७-१२४", "content_sanskrit": "राशयश्च दुकूलानां रत्नानां शिखराणि च ।\nयज्ञवाटस्य वसुधा स्वर्णरूप्यमयीकृता ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004138124, "chapter_id": 24138, "verse_number": "४-८७-१२५", "content_sanskrit": "न लभ्यंते क्रतौ तस्य मार्गिता अपि मार्गणाः ।\nहृष्टाः पुष्टाः समभवन्नपि तत्परिचारकाः ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004138125, "chapter_id": 24138, "verse_number": "४-८७-१२६", "content_sanskrit": "ध्वनिर्मंगलगीतानां व्यानशे गगनांगणम् ।\nजहृषे चाप्सरोवृंदैर्गंधर्वैर्मुमुदेतराम् ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004138126, "chapter_id": 24138, "verse_number": "४-८७-१२७", "content_sanskrit": "विद्याधरैर्ननंदे च वसुधा ववृधे भृशम् ।\nमहाविभवसंभारे तस्मिन्दाक्षे महाक्रतौ ।\nइत्थं प्रवृत्तेऽथ मुनिः कैलासं नारदो ययौ ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}]