[{"id": 2190850, "chapter_id": 5063, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2190851, "chapter_id": 5063, "verse_number": "१", "content_sanskrit": "किंशीलः किंसमाचारः किंविद्यः किम्परायणः ।\nप्राप्नोति ब्रह्मणः स्थानं यत् परं प्रकृतेर्ध्रुवम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2190852, "chapter_id": 5063, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2190853, "chapter_id": 5063, "verse_number": "२", "content_sanskrit": "मोक्षधर्मेषु निरतो लघ्वाहारो जितेन्द्रियः ।\nप्राप्नोति परमं स्थानं यत् परं प्रकृतेर्ध्रुवम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2190854, "chapter_id": 5063, "verse_number": "३", "content_sanskrit": "स्वगृहादभिनिःसृत्य लाभालाभे समो मुनिः ।\nसमुपोढेषु कामेषु निरपेक्षः परिव्रजेत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2190855, "chapter_id": 5063, "verse_number": "४", "content_sanskrit": "न चक्षुषा न मनसा न वाचा दूषयेदपि ।\nन प्रत्यक्षं परोक्षं वा दूषणं व्याहरेत् क्वचित्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2190856, "chapter_id": 5063, "verse_number": "५", "content_sanskrit": "न हिंस्यात् सर्वभूतानि मैत्रायणगतिश्चरेत् ।\nनेदं जीवितमासाद्य वैरं कुर्वीत केनचित्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2190857, "chapter_id": 5063, "verse_number": "६", "content_sanskrit": "अतिवादांस्तितिक्षेत नाभिमन्येत् कथञ्चन ।\nक्रोद्ध्यमानः प्रियं ब्रूयादाक्रुष्टः कुशलं वदेत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2190858, "chapter_id": 5063, "verse_number": "७", "content_sanskrit": "प्रदक्षिणं प्रसव्यं च ग्राममध्ये न चाचरेत् ।\nभैक्षचर्यामनापन्नो न गच्छेत् पूर्वकेतितः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2190859, "chapter_id": 5063, "verse_number": "८", "content_sanskrit": "अवकीर्णः सुगुप्तश्च न वाचा ह्यप्रियं वदेत् ।\nमृदुः स्यादप्रतिक्रूरो विस्रब्धः स्यादरोषणः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2190860, "chapter_id": 5063, "verse_number": "९", "content_sanskrit": "विधूमे न्यस्तमुसले व्यङ्गारे भुक्तवज्जने ।\nअतीते पात्रसञ्चारे भिक्षां लिप्सेत वै मुनिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2190861, "chapter_id": 5063, "verse_number": "१०", "content_sanskrit": "अनुयात्रिकमर्थस्य मात्रालाभेष्वनादृतः ।\nअलाभे न विहन्येत लाभश्चैनं न हर्षयेत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2190862, "chapter_id": 5063, "verse_number": "११", "content_sanskrit": "लाभं साधारणं नेच्छेन्न भुञ्जीताभिपूजितः ।\nअभिपूजितलाभं हि जुगुप्सेतैव तादृशः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2190863, "chapter_id": 5063, "verse_number": "१२", "content_sanskrit": "न चान्नदोषान्निन्देत न गुणानभिपूजयेत् ।\nशय्यासने विविक्ते च नित्यमेवाभिपूजयेत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2190864, "chapter_id": 5063, "verse_number": "१३", "content_sanskrit": "शून्यागारं वृक्षमूलमरण्यमथ वा गुहाम् ।\nअज्ञातचर्यां गत्वान्यां ततोऽन्यत्रैव संविशेत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2190865, "chapter_id": 5063, "verse_number": "१४", "content_sanskrit": "अनुरोधविरोधाभ्यां समः स्यादचलो ध्रुवः ।\nसुकृतं दुष्कृतं चोभे नानुरुद्ध्येत कर्मणि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2190866, "chapter_id": 5063, "verse_number": "१५", "content_sanskrit": "वाचो वेगं मनसः क्रोधवेगं\nविवित्सावेगमुदरोपस्थवेगम् ।\nएतान् वेगान् विनयेद्वै तपस्वी\nनिन्दा चास्य हृदयं नोपहन्यात्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2190867, "chapter_id": 5063, "verse_number": "१६", "content_sanskrit": "मध्यस्थ एव तिष्ठेत प्रशंसानिन्दयोः समः ।\nएतत् पवित्रं परमं परिव्राजक आश्रमे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2190868, "chapter_id": 5063, "verse_number": "१७", "content_sanskrit": "महात्मा सुव्रतो दान्तः सर्वत्रैवानपाश्रितः ।\nअपूर्वचारकः सौम्यो अनिकेतः समाहितः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2190869, "chapter_id": 5063, "verse_number": "१८", "content_sanskrit": "वानप्रस्थगृहस्थाभ्यां न संसृज्येत कर्हिचित् ।\nअज्ञातलिप्सां लिप्सेत न चैनं हर्ष आविशेत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2190870, "chapter_id": 5063, "verse_number": "१९", "content_sanskrit": "विजानतां मोक्ष एष श्रमः स्यादविजानताम् ।\nमोक्षयानमिदं कृत्स्नं विदुषां हारितोऽब्रवीत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2190871, "chapter_id": 5063, "verse_number": "२०", "content_sanskrit": "अभयं सर्वभूतेभ्यो दत्त्वा यः प्रव्रजेद् गृहात् ।\nलोकास्तेजोमयास्तस्य तथानन्त्याय कल्पते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2190872, "chapter_id": 5063, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे द्वादशाधिकशततमोऽध्यायः ॥११२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]