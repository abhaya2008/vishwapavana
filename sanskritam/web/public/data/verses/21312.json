[{"id": 7001312000, "chapter_id": 21312, "verse_number": "४-२-१", "content_sanskrit": "सूत उवाच ।\nगंगातीरे सुप्रसिद्धा काशी खलु विमुक्तिदा ।\nसा हि लिंगमयी ज्ञेया शिववासस्थली स्मृता॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001312001, "chapter_id": 21312, "verse_number": "४-२-२", "content_sanskrit": "लिंगं तत्रैव मुख्यं च सम्प्रोक्तमविमुक्तकम् ।\nकृत्तिवासेश्वरः साक्षात्तत्तुल्यो वृद्धबालकः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001312002, "chapter_id": 21312, "verse_number": "४-२-३", "content_sanskrit": "तिलभाण्डेश्वरश्चैव दशाश्वमेध एव च ।\nगंगा सागरसंयोगे संगमेश इति स्मृतः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001312003, "chapter_id": 21312, "verse_number": "४-२-४", "content_sanskrit": "भूतेश्वरो यः संप्रोक्तो भक्तसर्वार्थदः सदा ।\nनारीश्वर इति ख्यातः कौशिक्याः स समीपगः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001312004, "chapter_id": 21312, "verse_number": "४-२-५", "content_sanskrit": "वर्तते गण्डकीतीरे बटुकेश्वर एव सः ।\nपूरेश्वर इति ख्यातः फल्गुतीरे सुखप्रदः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001312005, "chapter_id": 21312, "verse_number": "४-२-६", "content_sanskrit": "सिद्धनाथेश्वरश्चैव दर्शनात्सिद्धिदो नृणाम् ।\nदूरेश्वर इति ख्यातः पत्तने चोत्तरे तथा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001312006, "chapter_id": 21312, "verse_number": "४-२-७", "content_sanskrit": "शृंगेश्वरश्च नाम्ना वै वैद्यनाथस्तथैव च ।\nजप्येश्वरस्तथा ख्यातो यो दधी चिरणस्थले॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001312007, "chapter_id": 21312, "verse_number": "४-२-८", "content_sanskrit": "गोपेश्वरः समाख्यातः रंगेश्वर इति स्मृतः ।\nवामेश्वरश्च नागेशः काजेशो विमलेश्वरः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001312008, "chapter_id": 21312, "verse_number": "४-२-९", "content_sanskrit": "व्यासेश्वरश्च विख्यातः सुकेशश्च तथैव हि ।\nभाण्डेश्वराश्च विख्यातो हुंकारेशस्तथैव च॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001312009, "chapter_id": 21312, "verse_number": "४-२-१०", "content_sanskrit": "सुरोचनश्च विख्यातो भूतेश्वर इति स्वयम् ।\nसंगमेशस्तथा प्रोक्तो महापातकनाशनः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001312010, "chapter_id": 21312, "verse_number": "४-२-११", "content_sanskrit": "ततश्च तप्तकातीरे कुमारेश्वर एव च ।\nसिद्धेश्वरश्च विख्यातः सेनेशश्च तथा स्मृतः ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001312011, "chapter_id": 21312, "verse_number": "४-२-१२", "content_sanskrit": "रामेश्वर इति प्रोक्तः कुंभेशश्च परो मतः ।\nनन्दीश्वरश्च पुंजेशः पूर्णायां पूर्णकस्तथा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001312012, "chapter_id": 21312, "verse_number": "४-२-१३", "content_sanskrit": "ब्रह्मेश्वरः प्रयोगे च ब्रह्मणा स्थापितः पुरा ।\nदशाश्वमेधतीर्थे हि चतुर्वर्गफलप्रदः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001312013, "chapter_id": 21312, "verse_number": "४-२-१४", "content_sanskrit": "तथा सोमेश्वरस्तत्र सर्ब्वापद्विनिवारकः ।\nभारद्वाजेश्वरश्चैव ब्रह्मवर्चःप्रवर्द्धकः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001312014, "chapter_id": 21312, "verse_number": "४-२-१५", "content_sanskrit": "शूलटंकेश्वरः साक्षात्कामनाप्रद ईरितः ।\nमाधवेशश्च तत्रैव भक्तरक्षाविधायकः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001312015, "chapter_id": 21312, "verse_number": "४-२-१६", "content_sanskrit": "नागेशाख्यः प्रसिद्धो हि साकेतनगरे द्विजा ।\nसूर्य्यवंशोद्भवानां च विशेषेण सुखप्रदः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001312016, "chapter_id": 21312, "verse_number": "४-२-१७", "content_sanskrit": "पुरुषोत्तमपुर्यां तु भुवनेशस्तु सिद्धिदः ।\nलोकेशश्च महालिंगः सर्वानन्दप्रदायकः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001312017, "chapter_id": 21312, "verse_number": "४-२-१८", "content_sanskrit": "कामेश्वरः शंभुलिंगो गंगेशः परशुद्धिकृत् ।\nशक्रेश्वरः शुक्रसिद्धो लोकानां हितकाम्यया॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001312018, "chapter_id": 21312, "verse_number": "४-२-१९", "content_sanskrit": "तथा वटेश्वरः ख्यातः सर्वकामफलप्रदः ।\nसिन्धुतीरे कपालेशो वक्त्रेशः सर्वपापहा॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001312019, "chapter_id": 21312, "verse_number": "४-२-२०", "content_sanskrit": "धौतपापेश्वरः साक्षादंशेन परमेश्वर ।\nभीमेश्वर इति प्रोक्तः सूर्येश्वर इति स्मृतः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001312020, "chapter_id": 21312, "verse_number": "४-२-२१", "content_sanskrit": "नन्देश्वरश्च विज्ञेयो ज्ञानदो लोकपूजितः ।\nनाकेश्वरो महापुण्यस्तथा रामेश्वरः स्मृतः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001312021, "chapter_id": 21312, "verse_number": "४-२-२२", "content_sanskrit": "विमलेश्वरनामा वै कंटकेश्वर एव च ।\nपूर्णसागरसंयोगे धर्तुकेशस्तथैव च॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001312022, "chapter_id": 21312, "verse_number": "४-२-२३", "content_sanskrit": "चन्द्रेश्वरश्च विज्ञेयश्चन्द्रकान्तिफलप्रदः ।\nसर्वकाम प्रदश्चैव सिद्धेश्वर इति स्मृतः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001312023, "chapter_id": 21312, "verse_number": "४-२-२४", "content_sanskrit": "बिल्वेश्वरश्च विख्यातश्चान्धकेशस्तथैव च ।\nयत्र वा ह्यन्धको दैत्यः शंकरेण हतः पुरा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001312024, "chapter_id": 21312, "verse_number": "४-२-२५", "content_sanskrit": "अयं स्वरूपमंशेन धृत्वा शंभुः पुनः स्थितः ।\nशरणेश्वरविख्यातो लोकानां सुखदः सदा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001312025, "chapter_id": 21312, "verse_number": "४-२-२६", "content_sanskrit": "कर्दमेशः परः प्रोक्त कोटीशश्चार्बुदाचले ।\nअचलेशश्च विख्यातो लोकानां सुखदः सदा॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001312026, "chapter_id": 21312, "verse_number": "४-२-२७", "content_sanskrit": "नागेश्वरस्तु कौशिक्यास्तीरे तिष्ठति नित्यशः ।\nअनन्तेश्वरसंज्ञश्च कल्याणशुभभाजनः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001312027, "chapter_id": 21312, "verse_number": "४-२-२८", "content_sanskrit": "योगेश्वरश्च विख्यातो वैद्यनाथेश्वरस्तथा ।\nकोटीश्वरश्च विज्ञेयः सप्तेश्वर इति स्मृतः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001312028, "chapter_id": 21312, "verse_number": "४-२-२९", "content_sanskrit": "भद्रेश्वरश्च विख्यातो भद्रनामा हरः स्वयम् ।\nचण्डीश्वरस्तथा प्रोक्तः संगमेश्वर एव च॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001312029, "chapter_id": 21312, "verse_number": "४-२-३०", "content_sanskrit": "पूर्वस्यां दिशि जातानि शिवलिंगानि यानि च ।\nसामान्यान्यपि चान्यानि तानीह कथितानि ते॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001312030, "chapter_id": 21312, "verse_number": "४-२-३१", "content_sanskrit": "दक्षिणस्यां दिशि तथा शिवलिंगानि यानि च ।\nसंजातानि मुनिश्रेष्ठ तानि ते कथयाम्यहम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]