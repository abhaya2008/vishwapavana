[{"id": 7003190000, "chapter_id": 23190, "verse_number": "४-१२६-१", "content_sanskrit": "अथ षड्विंशत्यधिकशततमोऽध्यायः ।\nनारायण उवाच ।\nगणेशपूजनं कृत्वा माधवो यादवैः सह ।\nदेवैर्मुनिभिरन्यैश्च देवीभिः सह नारद ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003190001, "chapter_id": 23190, "verse_number": "४-१२६-२", "content_sanskrit": "अंशेन देवो देवीभी रुक्मिण्याद्याभिरेव च ।\nप्रययौ द्वारकां रम्यां तस्थौ सिद्धाश्रमे स्वयम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003190002, "chapter_id": 23190, "verse_number": "४-१२६-३", "content_sanskrit": "कृत्वा सुप्रीतिसंभाषां सार्धगोलोकवासिभिः ।\nगोपैः सुहृद्भिर्नन्देन मात्रा गोप्या यशोदया ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003190003, "chapter_id": 23190, "verse_number": "४-१२६-४", "content_sanskrit": "उवाच मातरं तातं सुनीतं च चथोचितम् ।\nगोपांश्च गोकुलस्थांश्च बन्धुवर्गाश्च सांप्रतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003190004, "chapter_id": 23190, "verse_number": "४-१२६-५", "content_sanskrit": "श्रीभगवानुवाच ।\nगच्छ नन्दव्रजं नन्द हे तात प्राणवल्ल्भ ।\nमातर्यशोदे त्वमपि परमार्थे यशस्विनि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003190005, "chapter_id": 23190, "verse_number": "४-१२६-६", "content_sanskrit": "भुक्त्वा कालावशेषं च गच्छ गोलोकमुत्तमम् ।\nसालोक्यमुक्तिं दास्यामि सार्थ गोकुलवासिभिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003190006, "chapter_id": 23190, "verse_number": "४-१२६-७", "content_sanskrit": "इत्युक्त्वा भगवान्कृष्णः पित्रोरनुमतेन च ।\nजगाम राधिकास्थानं नन्दश्च गोकुलं तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003190007, "chapter_id": 23190, "verse_number": "४-१२६-८", "content_sanskrit": "ददर्श राधा रुचिरां मुक्ताहारां च सस्मिताम् ।\nयथा द्वादशवर्षीयां शश्वत्सुस्थिरयौवनाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003190008, "chapter_id": 23190, "verse_number": "४-१२६-९", "content_sanskrit": "रत्नोच्चैरासनस्था च गोपीत्रिशतकोटिभिः ।\nआवृता वेत्रहस्ताभिः सस्मिताभिश्च सांप्रतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003190009, "chapter_id": 23190, "verse_number": "४-१२६-१०", "content_sanskrit": "दृष्ट्वा च दूरतो राधा श्रीकृष्णं प्राणवल्लभम् ।\nशिशुवेषं सुवेषं च सुन्दरेशं च सस्मितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003190010, "chapter_id": 23190, "verse_number": "४-१२६-११", "content_sanskrit": "नवींनजलदश्यामं पींतकौशेयवाससम् ।\nचन्दनोक्षितसर्वाङ्गं रत्नभूषणभूषितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003190011, "chapter_id": 23190, "verse_number": "४-१२६-१२", "content_sanskrit": "मयूरपिच्छचूडं च मालतीमाल्यशोभितम् ।\nईषद्धास्यप्रसन्नास्यं भक्तानुप्रहविग्रहम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003190012, "chapter_id": 23190, "verse_number": "४-१२६-१३", "content_sanskrit": "क्रीडाकमलमम्लानं धृतवन्तं मनोहरम् ।\nमुरलीहस्तविन्यस्तं सुप्रशस्तं च दर्पणम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003190013, "chapter_id": 23190, "verse_number": "४-१२६-१४", "content_sanskrit": "जवेन च समुत्थाय गोपीभिः सह सादरम् ।\nप्रणम्य परया भक्त्या तुष्टाव परमेश्वरम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003190014, "chapter_id": 23190, "verse_number": "४-१२६-१५", "content_sanskrit": "राधिकोवाच ।\nअद्य मे सफलं जन्मजीवितं च सुजीवितम् ।\nयद्दृष्ट्वा मुखचन्द्रं ते सुस्निग्धं लोचनं मनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003190015, "chapter_id": 23190, "verse_number": "४-१२६-१६", "content_sanskrit": "पञ्च प्राणाश्च स्निग्धाश्च परमात्मा च सुप्रियः ।\nउभयोर्हर्षबीजं च दुर्लभं बन्धुदर्शनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003190016, "chapter_id": 23190, "verse_number": "४-१२६-१७", "content_sanskrit": "शोकार्णवे निमग्नाऽहं प्रदग्धा विरहानलैः ।\nत्वद्दृष्ट्याऽमृतवृष्ट्या च सुसिक्ताऽद्य सुशीतला ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003190017, "chapter_id": 23190, "verse_number": "४-१२६-१८", "content_sanskrit": "शिवा शिवप्रदाऽहं च शिवबीजा त्वया सह ।\nशि (श) व स्वरूपा निश्चेष्टाऽप्यदृश्या च त्वया विना ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003190018, "chapter_id": 23190, "verse_number": "४-१२६-१९", "content_sanskrit": "त्वयि तिष्ठति देहे च देही श्रीमाञ्छुचिः स्वयम् ।\nसर्वशक्तिस्वरूपा च शिवरूपा गते त्वयि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003190019, "chapter_id": 23190, "verse_number": "४-१२६-२०", "content_sanskrit": "स्त्रीपुंसो विंरहो नाथसामान्यश्च सुदारुणः ।\nयान्त्येव शक्तिभिः प्राणा विच्छेदात्परमात्मनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003190020, "chapter_id": 23190, "verse_number": "४-१२६-२१", "content_sanskrit": "इत्युक्त्वा राधिका वेवी परमात्मानमीश्वरम् ।\nस्वासने वासयासास कृत्वा पादार्चनं मुदा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003190021, "chapter_id": 23190, "verse_number": "४-१२६-२२", "content_sanskrit": "रत्नसिंहासने श्रीमानुवास राधया सह ।\nगोपीभिः सप्तभिः शश्वत्सेवितः श्वेतचामरैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003190022, "chapter_id": 23190, "verse_number": "४-१२६-२३", "content_sanskrit": "चन्दना सा ददौ गात्रे सुगन्धि चन्दनं हरेः ।\nसस्मिता रत्नमाला सा रत्नमालां गले ददौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003190023, "chapter_id": 23190, "verse_number": "४-१२६-२४", "content_sanskrit": "पद्मैः पद्मार्चिते पादपद्मे पद्मावती सती ।\nअर्ध्या ददौ सा सजलं दूर्वा पुष्पं च चन्दनम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003190024, "chapter_id": 23190, "verse_number": "४-१२६-२५", "content_sanskrit": "मालतो मालतीमाल्यं चूडायां च हरेर्ददौ ।\nचम्पापुष्पस्य पुटकं ददौ चम्पावती सती ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003190025, "chapter_id": 23190, "verse_number": "४-१२६-२६", "content_sanskrit": "पारिजाता च हरये पारिजातं ददौ मुदा ।\nसकर्पूरं च ताम्बूलं वासितं शीतलं जलम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003190026, "chapter_id": 23190, "verse_number": "४-१२६-२७", "content_sanskrit": "ददौ कदम्बमाला सा कदम्बमालिकां शुभाम् ।\nक्रीडाकमलमम्लानममूल्यं र्तनदर्पणम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003190027, "chapter_id": 23190, "verse_number": "४-१२६-२८", "content_sanskrit": "ददौ हस्ते हरेरेव कमला सा सुकोमला ।\nवरुणेन पुरा दत्तं वस्त्रयुग्मं च सुन्दरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003190028, "chapter_id": 23190, "verse_number": "४-१२६-२९", "content_sanskrit": "साक्षाद्गोरोचनाभं च सुन्दरी हरये ददौ ।\nमधुपात्रं मधुस्तस्मै मधुरं मधुपूर्णकम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003190029, "chapter_id": 23190, "verse_number": "४-१२६-३०", "content_sanskrit": "सुधापूर्गं सुधापात्रं ददौ भक्त्या सुधामुखी ।\nचकार पुष्पशय्यां च गोपी चन्दनचर्चिताम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003190030, "chapter_id": 23190, "verse_number": "४-१२६-३१", "content_sanskrit": "अम्लानमालतीपुष्पमालाजालविभूषिताम् ।\nरत्नेन्द्रसारनिर्माणमन्दिरे सुमनोहरे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003190031, "chapter_id": 23190, "verse_number": "४-१२६-३२", "content_sanskrit": "मणीन्द्रमुक्तामाणिक्यहीरहारविभूषिते ।\nकस्तूरीकुङ्कुमाक्तेन वायुना सुरभीकृते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003190032, "chapter_id": 23190, "verse_number": "४-१२६-३३", "content_sanskrit": "रत्नप्रदीपशतकैर्ज्वलद्भिश्च सुदीपिते ।\nधूपिते सततं धूपैर्नानावस्तुसमन्वितैः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003190033, "chapter_id": 23190, "verse_number": "४-१२६-३४", "content_sanskrit": "कृत्वा शय्यां रतिकरीं ययुर्गोप्यश्च सस्मिताः ।\nदृष्ट्वा रहसि तल्पं च सुरम्यं सुमनोहरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003190034, "chapter_id": 23190, "verse_number": "४-१२६-३५", "content_sanskrit": "माधवो राघया सार्ध विवेश रतिमन्दिरम् ।\nनानाप्रकारहास्यं च परिहासं स्मरोचितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003190035, "chapter_id": 23190, "verse_number": "४-१२६-३६", "content_sanskrit": "द्वयोर्बभूव तल्पे च मदनातुरयोस्तथा ।\nमाल्यं ददौ च कृष्णाय ताम्बूलं च सुवासितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003190036, "chapter_id": 23190, "verse_number": "४-१२६-३७", "content_sanskrit": "कस्तूरीकुङ्कुमाक्तं च चन्दनं श्यामवक्षसि ।\nचारुचम्पकपुष्पं च चूडायां प्रददौ सती ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003190037, "chapter_id": 23190, "verse_number": "४-१२६-३८", "content_sanskrit": "सहस्रदलससंक्तक्रीडापद्मं करे ददौ ।\nप्रक्षिप्य मुरलीं हस्तात्प्रददौ रत्नदर्पणम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003190038, "chapter_id": 23190, "verse_number": "४-१२६-३९", "content_sanskrit": "पारिजातस्य कुसुममम्लानं पुरतो ददौ ।\nउवाच मधुरं राधा रहस्ये मधुरं वचः ।\nसस्मिता सस्मितं शान्तं कान्तं कान्ता मनोहरम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003190039, "chapter_id": 23190, "verse_number": "४-१२६-४०", "content_sanskrit": "राधिकोवाच ।\nनिष्फलं मङ्गलप्रश्तं मङ्गले मङ्गलालये ।\nसर्वमङ्गलबीजे च माङ्गल्ये मङ्गलप्रदे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003190040, "chapter_id": 23190, "verse_number": "४-१२६-४१", "content_sanskrit": "तथाऽपि कुशलप्रश्ने सांप्रतं समयोचितम् ।\nलौकिको व्यवहारोऽपि वेदेभ्यो बलवांस्तथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003190041, "chapter_id": 23190, "verse_number": "४-१२६-४२", "content_sanskrit": "कुशलं रुक्मिणीकान्त सत्यभामेश सांप्रतम् ।\nमहन्द्रेण समं युद्धं लीलया च यदाज्ञया ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003190042, "chapter_id": 23190, "verse_number": "४-१२६-४३", "content_sanskrit": "पारिजाततरुं स्वर्गादुत्पाट्य चामरावतीम् ।\nगत्वा विजित्य देवांश्च तस्यै दसमिति श्रुतम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003190043, "chapter_id": 23190, "verse_number": "४-१२६-४४", "content_sanskrit": "पुण्यकं च कृतं तेन पारिजातेन सुव्रतम् ।\nत्वामेव साध्यं कान्तं च संपूर्णे दक्षिणां ददौ ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003190044, "chapter_id": 23190, "verse_number": "४-१२६-४५", "content_sanskrit": "ब्रह्मेशशेषासाध्यस्त्वं तया साध्यः कृतः कथम् ।\nसर्वभ्यः कामिनीभ्यश्च सत्यभामां बिभेषि च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003190045, "chapter_id": 23190, "verse_number": "४-१२६-४६", "content_sanskrit": "रुक्मिण्यां प्रेमसौभाग्यमतिरिक्तं च गौरवम् ।\nभयं माल्यं च धन्यायां सत्यायां सततं श्रुतम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003190046, "chapter_id": 23190, "verse_number": "४-१२६-४७", "content_sanskrit": "सत्यं जाम्बवतीकान्त वद मां च सुनिश्चितम् ।\nतासु सर्वासु कान्तासु कस्यास्ते प्रेम चाधिकम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003190047, "chapter_id": 23190, "verse_number": "४-१२६-४८", "content_sanskrit": "शृङ्गारे सर्वभावे वा तासु का रसिका परा ।\nत्वयि स्निग्धा विदग्धा का तामु धन्याऽतिसुव्रता ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003190048, "chapter_id": 23190, "verse_number": "४-१२६-४९", "content_sanskrit": "सा स्त्री भावानुरक्ता या भार्यां पाति पतिश्च सः ।\nप्रेमातिरिक्तं स्त्रीपुंसोस्त्रैलोक्येषु सुदुर्लभम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003190049, "chapter_id": 23190, "verse_number": "४-१२६-५०", "content_sanskrit": "रसिका स्त्री विजानाति सती गुणवती पतिम् ।\nगुणज्ञं रसिकं शूरं सुशीलं सुरतौ सदा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003190050, "chapter_id": 23190, "verse_number": "४-१२६-५१", "content_sanskrit": "दूराद्धावति पद्मार्थ मधुलोभान्मध्रुव्रतः ।\nभेकस्तन्न हि जानाति तन्मूर्ध्नि पादमुत्सृजेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003190051, "chapter_id": 23190, "verse_number": "४-१२६-५२", "content_sanskrit": "यन्त्री जानाति संगीतरसं यन्त्रं च नैव च ।\nदुग्धास्वादं विदग्धश्च न दर्वी नैव भाजनम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003190052, "chapter_id": 23190, "verse_number": "४-१२६-५३", "content_sanskrit": "परिपक्वफलास्वादं जानन्ति भोगिनः सुखम् ।\nएकत्रावस्थिताः शश्वन्नकिंचित्फलिनो यथा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003190053, "chapter_id": 23190, "verse_number": "४-१२६-५४", "content_sanskrit": "सुशीलजलास्वादं विजानन्ति तृषाल्वः ।\nन च वापी न घटश्चैकत्रावस्थितो यथा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003190054, "chapter_id": 23190, "verse_number": "४-१२६-५५", "content_sanskrit": "भोकिनो हि विजानन्ति शालिस्वादुरसं परम् ।\nएकत्रावस्थितं चेतु न क्षेत्रं भाजनं यथा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003190055, "chapter_id": 23190, "verse_number": "४-१२६-५६", "content_sanskrit": "बुबुधे चन्दनाघ्रणं चन्दनार्थी च भोगवित् ।\nन गर्दभो भारवाही न तस्य पात्रिका यथा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003190056, "chapter_id": 23190, "verse_number": "४-१२६-५७", "content_sanskrit": "यं न यानन्ति वेदाश्च ब्रह्मेशानादयस्तथा ।\nयोगिनो मुनयः सिद्धास्तं किं जानन्ति योषितः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003190057, "chapter_id": 23190, "verse_number": "४-१२६-५८", "content_sanskrit": "सौभाग्यं गौरवं प्रेम दुर्लभं नित्यनूतम् ।\nयौषितां च परं नैव चूर्णीभूतं क्षणेन च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003190058, "chapter_id": 23190, "verse_number": "४-१२६-५९", "content_sanskrit": "अत्युच्छ्रितो निपतनं प्राप्नोत्येव ध्रुवं प्रभो ।\nआराद्विपत्तिबीजं च वैष्णवानां विहिंसनम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003190059, "chapter_id": 23190, "verse_number": "४-१२६-६०", "content_sanskrit": "श्रीदामा च मया शप्तस्त्वद्भक्तो भक्तवत्सलः ।\nएतादृशी विपत्तिर्मे पुत्रश्रीदामशापतः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003190060, "chapter_id": 23190, "verse_number": "४-१२६-६१", "content_sanskrit": "ईश्वरः कस्य वा बन्धुः प्रियो वा विप्रियस्तथा ।\nसततं भक्तिसाध्यश्च यो भक्तश्च तदीश्वरः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003190061, "chapter_id": 23190, "verse_number": "४-१२६-६२", "content_sanskrit": "वेदाश्च वैदिकाः सन्तः पुराणानि वदन्ति च ।\nराधाया माधवः साध्यो भगवानिति निष्फलम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003190062, "chapter_id": 23190, "verse_number": "४-१२६-६३", "content_sanskrit": "जित्वा च सगणं शंभुं बाणस्य भुजकृन्तनम् ।\nकृत्वा च रुक्मिणीपौत्रः समानीतः सभार्यकः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003190063, "chapter_id": 23190, "verse_number": "४-१२६-६४", "content_sanskrit": "अहो त्वयि समायाते रुक्मिणी किमुवाच ह ।\nप्रेम स्थितं समानं ते किं विवृद्धं च गौरवम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003190064, "chapter_id": 23190, "verse_number": "४-१२६-६५", "content_sanskrit": "कुरुपाण्डवयुद्धेन कुरवो निहतास्त्वया ।\nपाण्डवार्थे तथा भूपाः क्व साम्यं परमात्मनः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003190065, "chapter_id": 23190, "verse_number": "४-१२६-६६", "content_sanskrit": "साक्षान्महेन्द्रजातस्य कौन्तेयस्यार्जुनस्य च ।\nराजमण्डलम्ध्यस्थो भवानेव हि सारथिः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003190066, "chapter_id": 23190, "verse_number": "४-१२६-६७", "content_sanskrit": "तेन भक्तेन शुद्धेन भीष्मेण च महात्मना ।\nलज्जितेन किमुक्तं ते महतीषु मभासु च ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003190067, "chapter_id": 23190, "verse_number": "४-१२६-६८", "content_sanskrit": "देवैरपि कथं दृष्टो ब्रह्मेशशेसंषज्ञकैः ।\nभक्तसिहैर्भृत्तैः सर्वैर्न चोक्तं किंचिदेव सः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003190068, "chapter_id": 23190, "verse_number": "४-१२६-६९", "content_sanskrit": "यश्चानिर्वचनीयश्च वेदेषु च चतुर्षु च ।\nपुराणेष्वितिहासेषु प्रकृतेः पर ईश्वरः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003190069, "chapter_id": 23190, "verse_number": "४-१२६-७०", "content_sanskrit": "निर्गुणच नीरीहश्च निर्लिप्तः सर्वकर्मणाम् ।\nकर्मणां साक्षिरूपश्च भक्तानुग्रहविग्रहः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003190070, "chapter_id": 23190, "verse_number": "४-१२६-७१", "content_sanskrit": "परं ब्रह्म परं ज्योतिः परमेशः परात्परः ।\nपरमात्मा च सर्वेषां सूतो नररथस्थितः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003190071, "chapter_id": 23190, "verse_number": "४-१२६-७२", "content_sanskrit": "त्वया कुब्जा च संभुक्ता वृद्धा क्षत्रियकामिनी ।\nअपुत्रिणी चाधिकाङ्गी यूनाऽस्पृश्या च ।\nप्रक्तनात् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003190072, "chapter_id": 23190, "verse_number": "४-१२६-७३", "content_sanskrit": "त्वया च निहतः कंसो मातुलः केन हेतुना ।\nआयास्यतीति कृत्वा च गत्तं न पुनरागतम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003190073, "chapter_id": 23190, "verse_number": "४-१२६-७४", "content_sanskrit": "निहत्य यादवान्सर्वान्विभज्य द्वारकां पुरीम् ।\nत्वां निबध्य समानेतुमीश्वरी वारिता जनैः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003190074, "chapter_id": 23190, "verse_number": "४-१२६-७५", "content_sanskrit": "इत्युक्त्वा राधिका देवी भृशमुच्चै रुरोद सा ।\nमूर्च्छां संप्राप सहसा निनिःश्वासा बभूव ह ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003190075, "chapter_id": 23190, "verse_number": "४-१२६-७६", "content_sanskrit": "गोप्यो गवाक्षजालस्थाः शुश्रुवुर्ददृशुस्तथा ।\nदृष्ट्वा तमाययुः सर्वा ऊचू राधा मृतेति च ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003190076, "chapter_id": 23190, "verse_number": "४-१२६-७७", "content_sanskrit": "उच्चैस्ता रुरुदुः सर्वाः क्रोडे कृत्वा च राधिकाम् ।\nऊचुस्ता रक्षरक्षेति हरे नरहरे प्रभो ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003190077, "chapter_id": 23190, "verse_number": "४-१२६-७८", "content_sanskrit": "गोप्य ऊचुः ।\nकिं कृतं किं कृतं कृष्ण त्वया राधा मृता च नः ।\nराधां जीवय भद्रं ते यास्यामः काननं वयम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003190078, "chapter_id": 23190, "verse_number": "४-१२६-७९", "content_sanskrit": "अन्यथा स्त्रीवधं तुभ्यं दास्यामः सर्वयोषितः ।\nगोपीनां वचनं श्रुत्वा राधिकायाश्च माधवः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003190079, "chapter_id": 23190, "verse_number": "४-१२६-८०", "content_sanskrit": "उवाच जीवयामास मुधादृष्ट्या च नारद ।\nउत्तस्थौ राधिका देवी रुदती मानिनी सती ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003190080, "chapter_id": 23190, "verse_number": "४-१२६-८१", "content_sanskrit": "गोप्यस्तां बोधयामासुःक्रोडे कृत्वा पुनः पुनः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003190081, "chapter_id": 23190, "verse_number": "४-१२६-८२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nश्रृणु राधे प्रवक्ष्यामि ज्ञानमाध्यात्मिकं परम् ।\nयच्छ्रुत्वा हालिको मूर्खः सद्यो भवति पण्डितः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003190082, "chapter_id": 23190, "verse_number": "४-१२६-८३", "content_sanskrit": "जात्याऽहं चगतां स्वामी किं रुक्मिण्यादियोषिताम् ।\nकार्यकारणरूपोऽहं व्यक्तो राधे पृथक् पृथक् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003190083, "chapter_id": 23190, "verse_number": "४-१२६-८४", "content_sanskrit": "एकात्माऽहं च विश्वेषां जात्या ज्योतिर्मयः स्वयम् ।\nसर्वप्राणिषु व्यक्त्या चाप्याब्रह्मादितृणादिषु ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003190084, "chapter_id": 23190, "verse_number": "४-१२६-८५", "content_sanskrit": "एकस्मिंश्च भुक्तवति न तुष्टोऽन्यो जनस्तथा ।\nमय्यात्मनि गतेऽप्येको मृतोऽप्यन्यः सुजीवति ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003190085, "chapter_id": 23190, "verse_number": "४-१२६-८६", "content_sanskrit": "जात्याऽहं कृष्णरूपश्च परिपूर्णतमः स्वयम् ।\nगोलोके गोकुले पुण्ये क्षेत्रे वृन्दावने वने ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003190086, "chapter_id": 23190, "verse_number": "४-१२६-८७", "content_sanskrit": "द्विभुजो गोपवेषश्च स्वयं राधापतिः शिशुः ।\nगोपालैर्गोपिकाभिश्च सहितः कामधेनुभिः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003190087, "chapter_id": 23190, "verse_number": "४-१२६-८८", "content_sanskrit": "चतुर्भुजोऽहं वैकुण्ठे द्विधारूपः सनातनः ।\nलक्ष्मीसरस्वतीकान्तः सततं शान्तविग्रहः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003190088, "chapter_id": 23190, "verse_number": "४-१२६-८९", "content_sanskrit": "यन्मानसी सिन्धुकन्या मर्त्यलक्ष्मीपतिर्भुवि ।\nश्वेतद्वीपे च श्रीरीदे तत्रापि च चतुर्भुजः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003190089, "chapter_id": 23190, "verse_number": "४-१२६-९०", "content_sanskrit": "अहं नारायणर्षिश्च नरो धर्मः सनातनः ।\nधर्मवक्ता च धर्मिष्ठो धर्मवर्त्मप्रवर्तकः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003190090, "chapter_id": 23190, "verse_number": "४-१२६-९१", "content_sanskrit": "शान्तिर्लक्ष्मीस्वरूपा च धर्मिष्ठा च पतिव्रता ।\nअत्र तस्याः पतिरहं पुण्यक्षेत्रे च भारते ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003190091, "chapter_id": 23190, "verse_number": "४-१२६-९२", "content_sanskrit": "सिद्धेशः सिद्धिदः साक्षात्कपिलोऽहं सतीपतिः ।\nनानारूपधरोऽहं च व्यक्तिभेदेन सुन्दरि ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003190092, "chapter_id": 23190, "verse_number": "४-१२६-९३", "content_sanskrit": "अहं चतुर्भुजः शश्वद्द्वार्वत्यां रुक्मिणीवतिः ।\nअहं क्षीरोदशायी च सत्यभामागृहे शुभे ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003190093, "chapter_id": 23190, "verse_number": "४-१२६-९४", "content_sanskrit": "अन्यासां मन्दिरेऽहं च कायव्यूहात्पृथक्पृथक् ।\nअहं नारायणर्षिश्च फाल्गुनस्यास्य सारथिः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003190094, "chapter_id": 23190, "verse_number": "४-१२६-९५", "content_sanskrit": "स नरर्षिर्धर्मपुत्रो मदंशो बलवान्भुवि ।\nतपसाऽऽराधितस्तेन सारथ्येऽहं च पुष्करे ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003190095, "chapter_id": 23190, "verse_number": "४-१२६-९६", "content_sanskrit": "यथा त्वं राधिका देवी गोलेके गोकुले तथा ।\nवैकुण्ठे च महालक्ष्मीर्भवती च सरस्वती ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003190096, "chapter_id": 23190, "verse_number": "४-१२६-९७", "content_sanskrit": "भवती मर्त्यलक्ष्मीश्च क्षीरोदशायिनः प्रिया ।\nधर्मपुत्रवधूस्त्वं च शान्तिर्लक्ष्मीस्वरूपिणी ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003190097, "chapter_id": 23190, "verse_number": "४-१२६-९८", "content_sanskrit": "कपिलस्य प्रिया कान्ताभारते भवती सती ।\nत्वं सीता मिथिलायां च त्वच्छाया द्रौपदी सती ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003190098, "chapter_id": 23190, "verse_number": "४-१२६-९९", "content_sanskrit": "द्वारवत्यां महाल्क्ष्मीर्भवती रुक्मिणी सती ।\nपञ्चानां पाण्डवानां च भवती कलया प्रिया ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003190099, "chapter_id": 23190, "verse_number": "४-१२६-१००", "content_sanskrit": "रावणेन हृता त्वं च स्वं च रामस्य कामिनी ।\nनानारूपा यथा त्वं च च्छायया कलया सती ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003190100, "chapter_id": 23190, "verse_number": "४-१२६-१०१", "content_sanskrit": "नानारूपस्तथाऽहं च श्वांशेन कलया तथा ।\nपरिपूर्णतमोऽहं च परमात्मा परात्परः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003190101, "chapter_id": 23190, "verse_number": "४-१२६-१०२", "content_sanskrit": "इति ते कथितं सर्वमाध्यात्मिकमिदं सति ।\nराधे कर्वापराधं मे क्षमस्व परमेश्वरी ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003190102, "chapter_id": 23190, "verse_number": "४-१२६-१०३", "content_sanskrit": "श्रीकृष्णवचनं श्रुत्वा परितुष्टा च राधिका ।\nपरितुष्टाश्च गोप्यश्च प्रणेमुः परमेश्वरम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}]