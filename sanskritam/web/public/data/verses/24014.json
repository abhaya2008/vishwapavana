[{"id": 7004014000, "chapter_id": 24014, "verse_number": "३-२-२५-१", "content_sanskrit": "सूत उवाच ।\nअथान्यत्संप्रवक्ष्यामि तीर्थमाहात्म्यमुत्तमम् ।\nधर्मारण्ये यथाऽनीता सत्यलोकात्सरस्वती॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004014001, "chapter_id": 24014, "verse_number": "३-२-२५-२", "content_sanskrit": "मार्कंडेयं सुखासीनं महामुनिनिषेवितम् ।\nतरुणादित्यसंकाशं सर्वशास्त्रविशारदम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004014002, "chapter_id": 24014, "verse_number": "३-२-२५-३", "content_sanskrit": "सर्वतीर्थमयं दिव्यमृषीणां प्रवरं द्विजम् ।\nआसनस्थं समायुक्तं धन्यं पूज्यं दृढव्रतम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004014003, "chapter_id": 24014, "verse_number": "३-२-२५-४", "content_sanskrit": "योगात्मानं परं शांतं कमडलुधरं विभुम् ।\nअक्षसूत्रधरं शांतं तथा कल्पां तवासिनम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004014004, "chapter_id": 24014, "verse_number": "३-२-२५-५", "content_sanskrit": "अक्षोभ्यं ज्ञानिनं स्वस्थं पितामहसमुद्युतिम् ।\nएवं दृष्ट्वा समाधिस्थं प्रहर्षोत्फुल्ललोचनम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004014005, "chapter_id": 24014, "verse_number": "३-२-२५-६", "content_sanskrit": "प्रणम्य स्तुतिभिर्युक्त्या मार्क्कंडं मुनयोऽब्रुवन् ।\nभगवन्नैमिषारण्ये सत्रे द्वादशवार्षिके॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004014006, "chapter_id": 24014, "verse_number": "३-२-२५-७", "content_sanskrit": "त्वयावतारिता ब्रह्मन्नदी या ब्रह्मणः सुता ।\nतथा कृतं च तत्रैव गंगा वतरणं क्षितौ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004014007, "chapter_id": 24014, "verse_number": "३-२-२५-८", "content_sanskrit": "गीयमाने कुलपतेः शौनकस्य मुनेः पुरः ।\nसूतेन मुनिना ख्यातमन्येषामपि शृण्वताम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004014008, "chapter_id": 24014, "verse_number": "३-२-२५-९", "content_sanskrit": "तच्छ्रुत्वा महदाख्यानम स्माकं हृदि संस्थितम् ।\nपापघ्नी पुण्यजननी प्राणिनां दर्शनादपि॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004014009, "chapter_id": 24014, "verse_number": "३-२-२५-१०", "content_sanskrit": "मार्कण्डेय उवाच ।\nधर्मारण्ये मया विप्राः सत्यलोकात्सरस्वती ।\nसमानीता सुरेखाद्रौ शरण्या शरणार्थिनाम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004014010, "chapter_id": 24014, "verse_number": "३-२-२५-११", "content_sanskrit": "भाद्रपदे सिते पक्षे द्वादशी पुण्यसंयुता ।\nतत्र द्वारावतीतीर्थे मुनिगंधर्वसेविते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004014011, "chapter_id": 24014, "verse_number": "३-२-२५-१२", "content_sanskrit": "तस्मिन्दिने च तत्तीर्थे पिंडदानादि कारयेत् ।\nतत्फलं समवाप्नोति पितॄणां दत्तमक्षयम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004014012, "chapter_id": 24014, "verse_number": "३-२-२५-१३", "content_sanskrit": "महदाख्यानमखिलं पापघ्नं पुण्यदं च यत् ।\nपवित्रं यत्पवित्राणां महापातकनाशनम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004014013, "chapter_id": 24014, "verse_number": "३-२-२५-१४", "content_sanskrit": "सर्वमंगलमांगल्यं पुण्यं सारस्वतं जलम् ।\nऊर्ध्वं किं दिवि यत्पुण्यं प्रभासांते व्यवस्थितम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004014014, "chapter_id": 24014, "verse_number": "३-२-२५-१५", "content_sanskrit": "सारस्वतजलं नॄणां ब्रह्महत्यां व्यपोहति ।\nसरस्वत्यां नराः स्नात्वा संतर्प्य पितृदेवताः ।\nपश्चात्पिंडप्रदातारो न भवंति स्तनंधयाः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004014015, "chapter_id": 24014, "verse_number": "३-२-२५-१६", "content_sanskrit": "यथा कामदुघा गावो भवन्तीष्टफलप्रदाः ।\nतथा स्वर्गापवर्गैकहैतुभूता सरस्वती॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]