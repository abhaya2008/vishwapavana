[{"id": 2118407, "chapter_id": 3547, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2118408, "chapter_id": 3547, "verse_number": "१", "content_sanskrit": "क्रोशमात्रे पुरस्यासीद् गोष्ठः पार्थस्य शोभनः ।\nतत्राभियात्वा बीभत्सुर्निविष्टो यदुकन्यया \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2118409, "chapter_id": 3547, "verse_number": "२", "content_sanskrit": "ततः सुभद्रां सत्कृत्य पार्थो वचनमब्रवीत् ।\nगोपालिकानां वेषेण गच्छ त्वं व्रजिनं पुरम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2118410, "chapter_id": 3547, "verse_number": "३", "content_sanskrit": "कामव्याहारिणी कृष्णा रोचतां ते वचो मम ॥\nदृष्ट्वा तु परुषं ब्रूयात् सह तत्र मया गताम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2118411, "chapter_id": 3547, "verse_number": "४", "content_sanskrit": "अन्यवेषेण तु गतां दृष्ट्वा सा त्वा प्रियं वदेत् ।\nयत्तु सा प्रथमं ब्रूयान्न तस्यास्ति निवर्तनम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2118412, "chapter_id": 3547, "verse_number": "५", "content_sanskrit": "तस्मान्मानं च दर्पं च व्यपनीय स्वयं व्रज ।\nतस्य तद्वचनं श्रुत्वा सुभद्रा प्रत्यभाषत ।\nएवमेतत् करिष्यामि यथा त्वं पार्थ भाषसे \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2118413, "chapter_id": 3547, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2118414, "chapter_id": 3547, "verse_number": "६", "content_sanskrit": "सुभद्रावचनं श्रुत्वा सुप्रीतः पाकशासनिः ।\nगोपालान् स समानीय त्वरितो वाक्यमब्रवीत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2118415, "chapter_id": 3547, "verse_number": "७", "content_sanskrit": "तरुण्यः सन्ति यावत्यस्ताः सर्वा व्रजयोषितः ।\nआगच्छन्तु गमिष्यन्त्या भद्रया सह सङ्गताः ।\nइन्द्रप्रस्थं पुरवरं कृष्णां द्रष्टुं यशस्विनीम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2118416, "chapter_id": 3547, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2118417, "chapter_id": 3547, "verse_number": "८", "content_sanskrit": "एतच्छ्रुत्वा तु गोपालैरानीता व्रजयोषितः ।\nततस्ताभिः परिवृतां व्रजस्त्रीभिः समन्ततः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2118418, "chapter_id": 3547, "verse_number": "९", "content_sanskrit": "सुभद्रां त्वरमाणस्तु रक्तकौशेयवाससीम् ।\nपार्थः प्रस्थापयामास कृत्वा गोपालिकावपुः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2118419, "chapter_id": 3547, "verse_number": "१०", "content_sanskrit": "साऽधिकं तेन रूपेण शोभमाना यशस्विनी ।\nगोपालिकामध्यगता प्रययौ व्रजिनं पुरम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2118420, "chapter_id": 3547, "verse_number": "११", "content_sanskrit": "ततः पुरवरश्रेष्ठमिन्द्रप्रस्थं यशस्विनी ।\nत्वरिता खाण्डवप्रस्थमाससाद विवेश च \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2118421, "chapter_id": 3547, "verse_number": "१२", "content_sanskrit": "सा गृहश्रेष्ठमासाद्य वीरपत्नी यशस्विनी ।\nववन्दे पृथुताम्राक्षी पृथां भद्रा पितृष्वसाम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2118422, "chapter_id": 3547, "verse_number": "१३", "content_sanskrit": "ततोऽभिगम्य त्वरिता पूर्णेन्दुसदृशानना ।\nववन्दे द्रौपदीं भद्रा प्रेष्याऽहमिति चाब्रवीत् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2118423, "chapter_id": 3547, "verse_number": "१४", "content_sanskrit": "प्रत्युत्थाप्य तु तां देवीं कृष्णा कृष्णसहोदरीम् ।\nसस्वजे चावदत् प्रीत्या निःसपत्नोऽस्तु ते पतिः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2118424, "chapter_id": 3547, "verse_number": "१५", "content_sanskrit": "वीरसूर्भव भद्रे त्वं भव भर्तृप्रिया तथा ।\nओजसा निर्जिता बह्वीरुवाच परमाशिषः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2118425, "chapter_id": 3547, "verse_number": "१६", "content_sanskrit": "तथैव मुदिता भद्रा तामुवाच तथाऽस्त्विति ।\nततः सुभद्रां वार्ष्णेयी परिष्वज्य शुभाननाम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2118426, "chapter_id": 3547, "verse_number": "१७", "content_sanskrit": "अङ्के निवेश्य मुदिता वासुदेवं प्रशस्य च ।\nततः किलकिलाशब्दः क्षणेन समपद्यत \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2118427, "chapter_id": 3547, "verse_number": "१८", "content_sanskrit": "हर्षादानर्तयोधानामासाद्य व्रजिनं पुरम् ।\nदेवपुत्रप्रकाशास्ते जाम्बूनदमयध्वजाः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2118428, "chapter_id": 3547, "verse_number": "१९", "content_sanskrit": "पृष्ठतोऽनुययुः पार्थं पुरुहूतमिवामराः ।\nगोभिरुष्ट्रैः सदश्वैश्च युक्तानि बहुला जनाः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2118429, "chapter_id": 3547, "verse_number": "२०", "content_sanskrit": "ददृशुर्यानमुख्यानि दाशार्हपुरवासिनाम् ।\nततः पुरवरे यूनां प्रहर्षः समजायत \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2118430, "chapter_id": 3547, "verse_number": "२१", "content_sanskrit": "प्रवासादागतं पार्थं दृष्ट्वा स्वमिव बान्धवम् ।\nसोऽभियाय नरश्रेष्ठो दाशार्हगणसंवृतः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2118431, "chapter_id": 3547, "verse_number": "२२", "content_sanskrit": "पौरैः पुरवरे प्रीत्या परया चाभिनन्दितः ।\nप्राप्य चान्तःपुरद्वारमवरुह्य रथर्षभम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2118432, "chapter_id": 3547, "verse_number": "२३", "content_sanskrit": "ववन्दे धौम्यमासाद्य मातरं च धनञ्जयः ।\nस्पृष्ट्वा च चरणौ राज्ञो भीमस्य च धनञ्जयः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2118433, "chapter_id": 3547, "verse_number": "२४", "content_sanskrit": "यमाभ्यां वन्दितो हृष्टः सस्वजे तौ ननन्द च ।\nब्राह्मणप्रमुखान् सर्वान् भ्रातृभिः सह सङ्गतः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2118434, "chapter_id": 3547, "verse_number": "२५", "content_sanskrit": "यथार्हं मानयामास पौरजानपदानपि ।\nततस्तान्यनुयात्राणि प्रदाय गुरवे वसून् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2118435, "chapter_id": 3547, "verse_number": "२६", "content_sanskrit": "पूजयाञ्चक्रुरासाद्य कुन्तीपुत्रं युधिष्ठिरम् ।\nपुरस्तादेव वै तेषां स महात्मा महायशाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2118436, "chapter_id": 3547, "verse_number": "२७", "content_sanskrit": "पूजनार्होऽभवद् राजा यथा वै गदपूर्वजः ।\nपाण्डवेन यथार्हं ते पूजार्हेण सुपूजिताः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2118437, "chapter_id": 3547, "verse_number": "२८", "content_sanskrit": "न्यविशन्ताभ्यनुज्ञाता राज्ञा तुष्टा यशस्विना ।\nतामदीनामदीनार्हां सुभद्रां प्रीतिवर्धिनीम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2118438, "chapter_id": 3547, "verse_number": "२९", "content_sanskrit": "साक्षाच्छ्रियममन्यन्त पार्थाः कृष्णसहोदराम् ।\nगुरूणां श्वशुराणां च देवराणां तथैव च\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2118439, "chapter_id": 3547, "verse_number": "३०", "content_sanskrit": "सुभद्रा स्वेन वृत्तेन बभूव परमप्रिया ।\nततस्ते हृष्टमनसः पाण्डवेया महारथाः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2118440, "chapter_id": 3547, "verse_number": "३१", "content_sanskrit": "युधिष्ठिरमुखाः प्रीता बभूवुर्जनमेजय ।\nकुन्ती च सततं प्रीता कृष्णा च सततं तथा \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2118441, "chapter_id": 3547, "verse_number": "२२६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषड्विंशत्यधिकद्विशततमोऽध्यायः ॥२२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2118442, "chapter_id": 3547, "verse_number": "२", "content_sanskrit": "॥ इति हरणहारिकपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2118443, "chapter_id": 3547, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]