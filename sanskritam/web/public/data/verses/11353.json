[{"id": 50006442, "chapter_id": 11353, "verse_number": "1", "content_sanskrit": "[न्यायमाला (अनुव्याख्याने ४-४-१-२)- अतिक्रमोक्तिः कृतिरर्थलाभः परा गतिः पारगतिस्तदोकः। समस्तकार्यं वशिता च विश्वसम्भावना युक्तयस्त्वन्यपक्षे॥ सामान्यरूपं प्रतिभानमुक्तिराश्चर्यताऽकृत्रिमताऽस्तदोषः। विशेषकॢप्तिः कृतनिश्चयश्च माहात्म्यमित्येव सुनिर्णयार्थाः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006443, "chapter_id": 11353, "verse_number": "2", "content_sanskrit": "॥ ॐ सम्पद्याविहाय स्वेन शब्दात् ॐ॥ अतिक्रमोक्तिः। सामान्यरूपम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006444, "chapter_id": 11353, "verse_number": "3", "content_sanskrit": "॥ ॐ मुक्तः प्रतिज्ञानात् ॐ॥ कृतिः। प्रतिभानम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50006445, "chapter_id": 11353, "verse_number": "4", "content_sanskrit": "॥ ॐ आत्मा प्रकरणात् ॐ॥ अर्थलाभः। उक्तिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50006446, "chapter_id": 11353, "verse_number": "5", "content_sanskrit": "॥ ॐ अविभागेन दृष्टत्वात् ॐ॥ परा गतिः। आश्चर्यता॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50006447, "chapter_id": 11353, "verse_number": "6", "content_sanskrit": "॥ ॐ ब्राह्मेण जैमिनिरुपन्यासादिभ्यः ॐ॥ पारगतिः। अकृत्रिमता॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50006448, "chapter_id": 11353, "verse_number": "7", "content_sanskrit": "॥ ॐ सङ्कल्पादेव च तच्छ्रुतेः ॐ॥ तदोकः। अस्तदोषः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50006