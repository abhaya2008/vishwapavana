[{"id": 2183238, "chapter_id": 4888, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2183239, "chapter_id": 4888, "verse_number": "१", "content_sanskrit": "कथं मृदौ कथं तीक्ष्णे महापक्षे च पार्थिव ।\nअरौ वर्तेत नृपतिस्तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2183240, "chapter_id": 4888, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2183241, "chapter_id": 4888, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nबृहस्पतेश्च संवादमिन्द्रस्य च युधिष्ठिर\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2183242, "chapter_id": 4888, "verse_number": "३", "content_sanskrit": "बृहस्पतिं देवपतिरभिवाद्य कृताञ्जलिः ।\nउपसङ्गम्य पप्रच्छ वासवः परवीरहा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2183243, "chapter_id": 4888, "verse_number": "४", "content_sanskrit": "अहितेषु कथं ब्रह्मन् वर्तयेयमतन्द्रितः ।\nअसमुच्छिद्य चैवेनान् नियच्छेयमुपायतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2183244, "chapter_id": 4888, "verse_number": "५", "content_sanskrit": "सेनयोर्व्यतिषङ्गेण जयः साधारणो भवेत् ।\nकिं कुर्वाणं न मां जह्याज्ज्वलिता श्रीः प्रतापिनी\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2183245, "chapter_id": 4888, "verse_number": "६", "content_sanskrit": "ततो धर्मार्थकामानां कुशलः प्रतिमानवान् ।\nराजधर्मविधानज्ञः प्रत्युवाच पुरन्दरम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2183246, "chapter_id": 4888, "verse_number": "७", "content_sanskrit": "न जातु कलहेनेच्छेन्नियन्तुमपकारिणः ।\nबालसंसेवितं ह्येतद् यदमर्षो यदक्षमा ।\nन शत्रुर्विवृतः कार्यो वधमस्याभिकाङ्क्षता\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2183247, "chapter_id": 4888, "verse_number": "८", "content_sanskrit": "क्रोधं बलममर्षं च नियम्यात्मजमात्मनि ।\nअमित्रमुपसेवेत विश्वस्तवदविश्वसन्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2183248, "chapter_id": 4888, "verse_number": "९", "content_sanskrit": "प्रियमेव वदेन्नित्यं नाप्रियं किञ्चिदाचरेत् ।\nविरमेच्छुष्कवैरेभ्यः कण्ठायासं च वर्जयेत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2183249, "chapter_id": 4888, "verse_number": "१०", "content_sanskrit": "यथा वैतंसिको युक्तो द्विजानां सदृशस्वनः ।\nतान् द्विजान् कुरुते वश्यांस्तथा युक्तो महीपतिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2183250, "chapter_id": 4888, "verse_number": "११", "content_sanskrit": "वशं चोपनयेच्छत्रून् निहन्याच्च पुरन्दर ।\nन नित्यं परिभूयारीन् सुखं स्वपिति वासव ।\nजागर्त्येव च दुष्टात्मा सङ्करेऽग्निरिवोत्थितः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2183251, "chapter_id": 4888, "verse_number": "१२", "content_sanskrit": "न सन्निपातः कर्तव्यः सामान्ये विजये सति ।\nविश्वास्यैवोपसन्न्यास्यो वशे कृत्वा रिपुः प्रभो\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2183252, "chapter_id": 4888, "verse_number": "१३", "content_sanskrit": "सम्प्रधार्य सहामात्यैर्मन्त्रविद्भिर्महात्मभिः ।\nउपेक्ष्यमाणोऽवज्ञातो हृदयेनापराजितः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2183253, "chapter_id": 4888, "verse_number": "१४", "content_sanskrit": "अथास्य प्रहरेत् काले किञ्चिद् विचलिते पदे ।\nदण्डं च दूषयेदस्य पुरुषैराप्तकारिभिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2183254, "chapter_id": 4888, "verse_number": "१५", "content_sanskrit": "आदिमध्यावसानज्ञः प्रच्छन्नं च विचारयेत् ।\nबलानि दूषयेदस्य जानंश्चैव प्रमाणतः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2183255, "chapter_id": 4888, "verse_number": "१६", "content_sanskrit": "भेदेनोपप्रदानेन संसृजन्नौषधैस्तथा ।\nन त्वेव खलु संसर्गं रोचयेदरिभिः सह\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2183256, "chapter_id": 4888, "verse_number": "१७", "content_sanskrit": "दीर्घकालमपि क्षान्त्वा विहन्यादेव शात्रवान् ।\nकालकाङ्क्षी यापयेच्च यथा विस्रम्भमाप्नुयुः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2183257, "chapter_id": 4888, "verse_number": "१८", "content_sanskrit": "न सद्योऽरीन् विनिर्हन्याद् द्रष्टव्यो विजयो ध्रुवः ।\nन यः शल्यं घट्टयति नवं च कुरुते व्रणम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2183258, "chapter_id": 4888, "verse_number": "१९", "content_sanskrit": "प्राप्ते च प्रहरेत् काले न स संवर्तते पुनः ।\nहन्तुकामस्य देवेन्द्र पुरुषस्य रिपुं प्रति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2183259, "chapter_id": 4888, "verse_number": "२०", "content_sanskrit": "यः कालो हि व्यतिक्रामेत् पुरुषं कालकाङ्क्षिणम् ।\nदुर्लभः स पुनः कालः कालधर्मचिकीर्षुणा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2183260, "chapter_id": 4888, "verse_number": "२१", "content_sanskrit": "और्जस्थ्यं विजयेदेवं सङ्गृह्णन् साधुसम्मतान् ।\nकालेन साधयेन्नित्यं नाप्राप्तेऽभिनिपीडयेत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2183261, "chapter_id": 4888, "verse_number": "२२", "content_sanskrit": "विहाय कामं क्रोधं च तथाऽहङ्कारमेव च ।\nयुक्तो विवरमन्विच्छेदहितानां पुरन्दर\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2183262, "chapter_id": 4888, "verse_number": "२३", "content_sanskrit": "मार्दवं दण्ड आलस्यं प्रमादश्च सुरोत्तम ।\nमायाश्च विविधाः शक्र सादयन्त्यविचक्षणम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2183263, "chapter_id": 4888, "verse_number": "२४", "content_sanskrit": "निहत्यैतानि चत्वारि मायां प्रतिविधाय च ।\nततः शक्नोति शत्रूणां प्रहर्तुमविचारयन्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2183264, "chapter_id": 4888, "verse_number": "२५", "content_sanskrit": "यदैवैकेन शक्येत गुह्यं कर्तंु तदाचरेत् ।\nयच्छन्ति सचिवा गुह्यं मिथो विद्रावयन्त्यपि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2183265, "chapter_id": 4888, "verse_number": "२६", "content_sanskrit": "अशक्यमिति कृत्वा वा ततोऽन्यैः संविदं चरेत् ।\nब्रह्मदण्डमदृष्टेषु दृष्टेषु चतुरङ्गिणीम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2183266, "chapter_id": 4888, "verse_number": "२७", "content_sanskrit": "भेदं च प्रथमं युञ्ज्यात् तूष्णीं दण्डं तथैव च ।\nकाले प्रयोजयेद् राजा तस्मिंस्तस्मिंस्तदा तदा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2183267, "chapter_id": 4888, "verse_number": "२८", "content_sanskrit": "प्रणिपातं च गच्छेत काले शत्रोर्बलीयसः ।\nयुक्तोऽस्य वधमन्विच्छेदप्रमत्तः प्रमाद्यतः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2183268, "chapter_id": 4888, "verse_number": "२९", "content_sanskrit": "प्रणिपातेन दानेन वाचा मधुरया ब्रुवन् ।\nअमित्रमुपसेवेत नतु जातु विशङ्कयेत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2183269, "chapter_id": 4888, "verse_number": "३०", "content_sanskrit": "स्थानानि शङ्कितानां च नित्यमेव विवर्जयेत् ।\nनच तेष्वाश्वसेद् द्रुग्ध्वा जाग्रतीह निराकृताः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2183270, "chapter_id": 4888, "verse_number": "३१", "content_sanskrit": "नह्यतो दुष्करं कर्म किञ्चिदस्ति सुरोत्तम ।\nयथा विविधवृत्तानामैश्वर्यममराधिप\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2183271, "chapter_id": 4888, "verse_number": "३२", "content_sanskrit": "तथा विविधशीलानामपि सम्भव उच्यते ।\nयतेत योगमास्थाय मित्रामित्रानवारयन्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2183272, "chapter_id": 4888, "verse_number": "३३", "content_sanskrit": "मृदुमप्यवमन्यन्ते तीक्ष्णादुद्विजते जनः ।\nमातीक्ष्णो मामृदुर्भूस्त्वं तीक्ष्णो भव मृदुर्भव\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2183273, "chapter_id": 4888, "verse_number": "३४", "content_sanskrit": "यथा वप्रे वेधवति सर्वतः सम्प्लुतोदके ।\nनित्यं विदारणाद् बाधस्तथा राज्यं प्रमाद्यतः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2183274, "chapter_id": 4888, "verse_number": "३५", "content_sanskrit": "न बहूनभियुञ्जीत यौगपद्येन शात्रवान् ।\nसाम्ना दानेन भेदेन दण्डेन च पुरन्दर\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2183275, "chapter_id": 4888, "verse_number": "३६", "content_sanskrit": "एकैकमेषां निष्पिंषन् शिष्टेषु निपुणं चरेत् ।\nनच शक्तोऽपि मेधावी सर्वानेवारभेन्नृपः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2183276, "chapter_id": 4888, "verse_number": "३७", "content_sanskrit": "यदा स्यान्महती सेना हयनागरथाकुला ।\nपदातियन्त्रबहुला स्वनुरक्ता पताकिनी\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2183277, "chapter_id": 4888, "verse_number": "३८", "content_sanskrit": "यदा बहुविधां वृद्धिं मन्यते प्रतिलोमतः ।\nतदा विवृत्य प्रहरेद् अरीणामविचारयन्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2183278, "chapter_id": 4888, "verse_number": "३९", "content_sanskrit": "न साम दण्डोपनिषत् प्रशस्यते\nन मार्दवं शत्रुषु यात्रिकं सदा ।\nन सस्यघातो नच सङ्करक्रिया\nनचास्य भूयः प्रकृतेर्विचारणा\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2183279, "chapter_id": 4888, "verse_number": "४०", "content_sanskrit": "मायाविभेदानुपसर्जनानि\nपापं तथैव स्पशसम्प्रयोगात् ।\nआप्तैर्मनुष्यैरुपचारयेत\nपुरेषु राष्ट्रेषु च सम्प्रयुक्तान्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2183280, "chapter_id": 4888, "verse_number": "४१", "content_sanskrit": "पुरापि चैषामनुसृत्य भूमिपाः\nपुरेषु भोगान् निखिलानिहाजयन् ।\nपुरेषु नीतिं विहितां यथाविधि\nप्रयोजयन्तो बलवृत्रसूदन\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2183281, "chapter_id": 4888, "verse_number": "४२", "content_sanskrit": "प्रदाय गूढानि वसूनि नाम\nप्रच्छिद्य भोगानवधाय च स्वान् ।\nदुष्टाः स्वदोषैरिति कीर्तयित्वा\nपुरेषु राष्ट्रेषु च योजयन्ति\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2183282, "chapter_id": 4888, "verse_number": "४३", "content_sanskrit": "तथैव चान्येरपि शास्त्रवेदिभिः\nस्वलङ्कृतैः शास्त्रविधानदृष्टिभिः ।\nसुशिक्षितैर्भाष्यकथाविशारदैः\nपरेषु कृत्यानुपधारयस्व\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2183283, "chapter_id": 4888, "verse_number": "", "content_sanskrit": "इन्दः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2183284, "chapter_id": 4888, "verse_number": "४४", "content_sanskrit": "कानि लिङ्गानि दुष्टस्य भवन्ति द्विजसत्तम ।\nकथं दुष्टं विजानीयादेतत् पृष्टो ब्रवीहि मे\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2183285, "chapter_id": 4888, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2183286, "chapter_id": 4888, "verse_number": "४५", "content_sanskrit": "परोक्षमगुणानाह सद्गुणानभ्यसूयति ।\nपरैर्वा कीर्त्यमानेषु तूष्णीमास्ते पराङ्मुखः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2183287, "chapter_id": 4888, "verse_number": "४६", "content_sanskrit": "तूष्णींभावेऽपि विज्ञेयं नचेद् भवति दारणम् ।\nविश्वासमोष्ठसन्दंशं शिरसश्च प्रकम्पनम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2183288, "chapter_id": 4888, "verse_number": "४७", "content_sanskrit": "करोत्यभीक्ष्णं संसृष्टमसंसृष्टश्च भाषते ।\nअदृष्टितो विकुरुते दृष्ट्वा वा नाभिभाषते\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2183289, "chapter_id": 4888, "verse_number": "४८", "content_sanskrit": "पृथगेत्य समश्नाति नेदमद्य यथाविधि ।\nआसने शयने याने भावा लक्ष्या विशेषतः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2183290, "chapter_id": 4888, "verse_number": "४९", "content_sanskrit": "आर्तिरार्ते प्रिये प्रीतिरेतावन्मित्रलक्षणम् ।\nविपरीतं तु बोद्धव्यमरिलक्षणमेव तत्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2183291, "chapter_id": 4888, "verse_number": "५०", "content_sanskrit": "एतान्येवं यथोक्तानि बुद्ध्येथास्त्रिदशाधिप ।\nपुरुषाणां प्रदुष्टानां स्वभावो बलवत्तरः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2183292, "chapter_id": 4888, "verse_number": "समाप्तिः", "content_sanskrit": "इति दुष्टस्य विज्ञानमुक्तं ते सुरसत्तम ।\nनिशाम्य शास्त्रतत्त्वार्थं यथावदमरेश्वर\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2183293, "chapter_id": 4888, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2183294, "chapter_id": 4888, "verse_number": "५२", "content_sanskrit": "स तद्वचः शत्रुनिबर्हणे रत-\nस्तथा चकारावितथं बृहस्पतेः ।\nचचार काले विजयाय चारिहा\nवशं च शत्रूननयत् पुरन्दरः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2183295, "chapter_id": 4888, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे पञ्चाधिकशततमोऽध्यायः ॥ १०५ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]