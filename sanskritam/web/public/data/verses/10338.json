[{"id": 6000338000, "chapter_id": 10338, "verse_number": null, "content_sanskrit": "अथ षष्ठाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000338001, "chapter_id": 10338, "verse_number": null, "content_sanskrit": "शौनक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.001.m4a", "display_order": 2}, {"id": 6000338002, "chapter_id": 10338, "verse_number": "१२-६-१", "content_sanskrit": "पैलादिभिर्व्यासशिष्यैर्वेदाचार्यैर्महात्मभिः।\nवेदा वै कतिधा व्यस्ता एतत् सौम्याभिधेहि नः॥ १२/६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.002.m4a", "display_order": 3, "topics": [{"text": "कृष्णद्वैपायनेन वेदविभागकरणम्", "range": "१–२६"}]}, {"id": 6000338003, "chapter_id": 10338, "verse_number": null, "content_sanskrit": "सूत उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.003.m4a", "display_order": 4}, {"id": 6000338004, "chapter_id": 10338, "verse_number": "१२-६-२", "content_sanskrit": "समाहितात्मनो ब्रह्मन् ब्रह्मणः परमेष्ठिनः।\nहृदाकाशादभून्नादो वृत्तिरोधाद् विभाव्यते॥ १२/६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.004.m4a", "display_order": 5}, {"id": 6000338005, "chapter_id": 10338, "verse_number": "१२-६-३", "content_sanskrit": "यदुपासनया ब्रह्मन् योगिनो मलमात्मनः।\nद्रव्यक्रियाकारकाख्यं धूत्वा यान्त्यपुनर्भवम्॥ १२/६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.005.m4a", "display_order": 6}, {"id": 6000338006, "chapter_id": 10338, "verse_number": "१२-६-४", "content_sanskrit": "ततोऽभूत् त्रिवृदोङ्कारो यो व्यक्तप्रभवः स्वराट्।\nयत्तल्लिङ्गं भगवतो ब्रह्मणः परमात्मनः॥ १२/६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.006.m4a", "display_order": 7}, {"id": 6000338007, "chapter_id": 10338, "verse_number": "१२-६-५", "content_sanskrit": "शृणोति य इमं स्फोटं सुप्तः श्रोतेव शून्यदृक्।\nयेन वाग् व्यज्यते यस्य व्यक्तिराकाश आत्मनः॥ १२/६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.007.m4a", "display_order": 8}, {"id": 6000338008, "chapter_id": 10338, "verse_number": "१२-६-६", "content_sanskrit": "स्वधाम्नो ब्रह्मणः साक्षाद् वाचकः परमात्मनः।\nस सर्वमन्त्रोपनिषद्वेदबीजं सनातनम्॥ १२/६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.008.m4a", "display_order": 9}, {"id": 6000338009, "chapter_id": 10338, "verse_number": "१२-६-७", "content_sanskrit": "तस्य हासंस्त्रयो वर्णा अकाराद्या भृगूद्वह।\nधार्यन्ते यैस्त्रयो भावा गुणनामर्थवृत्तयः॥ १२/६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.009.m4a", "display_order": 10}, {"id": 6000338010, "chapter_id": 10338, "verse_number": "१२-६-८", "content_sanskrit": "ततोऽक्षरसमाम्नायमसृजद् भगवानजः।\nअन्तःस्थोष्मस्वरस्पर्शह्रस्वदीर्घादिलक्षणम्॥ १२/६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.010.m4a", "display_order": 11}, {"id": 6000338011, "chapter_id": 10338, "verse_number": "१२-६-९", "content_sanskrit": "तेनासौ चतुरो वेदांश्चतुर्भिर्वदनैर्विभुः।\nसव्याहृतिकान् सोङ्कारांश्चातुर्होत्रविवक्षया॥ १२/६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.011.m4a", "display_order": 12}, {"id": 6000338012, "chapter_id": 10338, "verse_number": "१२-६-१०", "content_sanskrit": "पुत्रानध्यापयत् तांस्तु महर्षीन् ब्रह्मकोविदान्।\nते तु धर्मोपदेष्टारः स्वपुत्रेभ्यः समादिशन्॥ १२/६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.012.m4a", "display_order": 13}, {"id": 6000338013, "chapter_id": 10338, "verse_number": "१२-६-११", "content_sanskrit": "ते परम्परया प्राप्तास्तत्तच्छिष्यैर्धृतव्रतैः।\nचतुर्युगेष्वथ व्यस्ता द्वापरादौ महर्षिभिः॥ १२/६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.013.m4a", "display_order": 14}, {"id": 6000338014, "chapter_id": 10338, "verse_number": "१२-६-१२", "content_sanskrit": "क्षीणायुषः क्षीणसत्त्वान् दुर्मेधान् वीक्ष्य कालतः।\nवेदान् ब्रह्मर्षयो व्यस्यन् हृदिस्थाच्युतनोदिताः॥ १२/६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.014.m4a", "display_order": 15}, {"id": 6000338015, "chapter_id": 10338, "verse_number": "१२-६-१३", "content_sanskrit": "अस्मिन्नप्यन्तरे ब्रह्मन् भगवान् लोकभावनः।\nब्रह्मेशाद्यैर्लोकपालैर्याचितो धर्मगुप्तये॥ १२/६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.015.m4a", "display_order": 16}, {"id": 6000338016, "chapter_id": 10338, "verse_number": "१२-६-१४", "content_sanskrit": "पराशरात् सत्यवत्यामंशांशकलया विभुः।\nअवतीर्णो महाभाग वेदं चक्रे चतुर्विधम्॥ १२/६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.016.m4a", "display_order": 17}, {"id": 6000338017, "chapter_id": 10338, "verse_number": "१२-६-१५", "content_sanskrit": "ऋगथर्वयजुःसाम्नां राशीनुद्धृत्य वर्गशः।\nचतस्रः संहिताश्चक्रे सूत्रैर्मणिगणानिव॥ १२/६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.017.m4a", "display_order": 18}, {"id": 6000338018, "chapter_id": 10338, "verse_number": "१२-६-१६", "content_sanskrit": "तासां स चतुरः शिष्यानुपहूय महामतिः।\nएकैकां संहितां ब्रह्मन्नेकैकस्मै ददौ विभुः॥ १२/६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.018.m4a", "display_order": 19}, {"id": 6000338019, "chapter_id": 10338, "verse_number": "१२-६-१७", "content_sanskrit": "पैलाय संहितामाद्यां बह्वृचाख्यामुवाच ह।\nवैशम्पायनसंज्ञाय निगदाख्यं यजुर्गुणम्॥ १२/६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.019.m4a", "display_order": 20}, {"id": 6000338020, "chapter_id": 10338, "verse_number": "१२-६-१८", "content_sanskrit": "साम्नां जैमिनये प्राह तथा च्छन्दोगसंहिताम्।\nअथर्वाङ्गिरसां नाम स्वशिष्याय सुमन्तवे॥ १२/६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.020.m4a", "display_order": 21}, {"id": 6000338021, "chapter_id": 10338, "verse_number": "१२-६-१९", "content_sanskrit": "पैलः स्वसंहितामूचे इन्द्रप्रमितये मुनिः।\nबाष्कलाय च सोऽप्याह शिष्येभ्यः संहितां स्वकाम्॥ १२/६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.021.m4a", "display_order": 22}, {"id": 6000338022, "chapter_id": 10338, "verse_number": "१२-६-२०", "content_sanskrit": "चतुर्धा व्यस्य बोध्याय याज्ञवल्क्याय भार्गव।\nपराशरायाग्निमित्रे इन्द्रप्रमितिरात्मवान्॥ १२/६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.022.m4a", "display_order": 23}, {"id": 6000338023, "chapter_id": 10338, "verse_number": "१२-६-२१", "content_sanskrit": "अध्यापयत् संहितां स्वां माण्डूकेयमृषिं कविम्।\nतस्य शिष्यो वेदमित्रः सौभर्यादिभ्य ऊचिवान्॥ १२/६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.023.m4a", "display_order": 24}, {"id": 6000338024, "chapter_id": 10338, "verse_number": "१२-६-२२", "content_sanskrit": "शाकल्यस्तत्सुतस्तां तु पञ्चधा व्यस्य संहिताम्।\nवात्स्यमौद्गल्यशालीयगोसत्यशिशिरेष्वधात्॥ १२/६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.024.m4a", "display_order": 25}, {"id": 6000338025, "chapter_id": 10338, "verse_number": "१२-६-२३", "content_sanskrit": "जातूकर्ण्यश्च तच्छिष्यः सनिरुक्तां स्वसंहिताम्।\nव्यलीकयोगपैलालविरजेभ्यो ददौ मुनिः॥ १२/६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.025.m4a", "display_order": 26}, {"id": 6000338026, "chapter_id": 10338, "verse_number": "१२-६-२४", "content_sanskrit": "बाष्कलिः प्रतिशाखाभ्यो वालखिल्याख्यसंहिताम्।\nचक्रे बालायनिर्भज्यकासाराश्चैव तां दधुः॥ १२/६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.026.m4a", "display_order": 27}, {"id": 6000338027, "chapter_id": 10338, "verse_number": "१२-६-२५", "content_sanskrit": "बह्वृचाः संहिता ह्येता एभिर्ब्रह्मर्षिभिर्धृताः।\nशृृत्वैतच्छन्दसां व्यासं सर्वपापैः प्रमुच्यते॥ १२/६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.027.m4a", "display_order": 28}, {"id": 6000338028, "chapter_id": 10338, "verse_number": "१२-६-२६", "content_sanskrit": "वैशम्पायनशिष्या वै चरकाध्वर्यवोऽभवन्।\nयच्चेरुर्ब्रह्महत्यांहःक्षपणाय गुरोर्व्रतम्॥ १२/६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.028.m4a", "display_order": 29}, {"id": 6000338029, "chapter_id": 10338, "verse_number": "१२-६-२७", "content_sanskrit": "याज्ञवल्क्यस्तु तच्छिष्य आहांहो भगवन् कियत्।\nचरितेनाल्पसाराणां चरिष्येऽहं सुदुष्करम्॥ १२/६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.029.m4a", "display_order": 30, "topics": [{"text": "याज्ञवल्क्यस्य सूर्याद्वाजसनेयशाखाध्ययनम्", "range": "२७–४४"}]}, {"id": 6000338030, "chapter_id": 10338, "verse_number": "१२-६-२८", "content_sanskrit": "इत्युक्तो गुरुरप्याह कुपितो याह्यलं त्वया।\nविप्रावमन्त्रा शिष्येण मदधीतं त्यजाश्विति॥ १२/६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.030.m4a", "display_order": 31}, {"id": 6000338031, "chapter_id": 10338, "verse_number": "१२-६-२९", "content_sanskrit": "देवरातसुतः सोऽपि छर्दित्वा यजुषां गणम्।\nततो गतोऽथ मुनयो ददृशुस्तान् यजुर्गणान्॥ १२/६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.031.m4a", "display_order": 32}, {"id": 6000338032, "chapter_id": 10338, "verse_number": "१२-६-३०", "content_sanskrit": "भूत्वा तित्तिरयो ब्रह्मन् तल्लोलुपतयाऽऽददुः।\nतैत्तिरीया इति यजुःशाखा आसन् सुपेशलाः॥ १२/६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.032.m4a", "display_order": 33}, {"id": 6000338033, "chapter_id": 10338, "verse_number": "१२-६-३१", "content_sanskrit": "याज्ञवल्क्यस्ततो ब्रह्मन् छन्दांस्यधिगवेषयन्।\nगुरोरविद्यमानानि सूपतस्थेऽर्कमीश्वरम्॥ १२/६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.033.m4a", "display_order": 34}, {"id": 6000338034, "chapter_id": 10338, "verse_number": null, "content_sanskrit": "याज्ञवल्क्य उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.034.m4a", "display_order": 35}, {"id": 6000338035, "chapter_id": 10338, "verse_number": "१२-६-३२", "content_sanskrit": "‘ओं नमो भगवते आदित्यायाखिलजगदात्मस्वरूपेण कालरूपेण च चतुर्विधभूतनिकायानां ब्रह्मादिस्तम्बपर्यन्तानामन्तर्हृदयेषु बहिरप्याकाश इवोपाधिना व्यवधीयमानो भगवानेक एव क्षणलवनिमेषाद्यवयवोपचित संवत्सरगणेन तोयादानविसर्गाभ्यामिमां लोकयात्रामनुवहति॥ १२/६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.035.m4a", "display_order": 36}, {"id": 6000338036, "chapter_id": 10338, "verse_number": "१२-६-३३", "content_sanskrit": "यदिह वाव विबुधर्षभ सवितरदस्तपत्यनुसवनम्अहरहराम्नायविधिनोपतिष्ठमानानामखिल-दुरितवृजिनबीजावभर्जनं भगवतः समभिधीमहि तपन मण्डलम्॥ १२/६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.036.m4a", "display_order": 37}, {"id": 6000338037, "chapter_id": 10338, "verse_number": "१२-६-३४", "content_sanskrit": "य इह वाव स्थिरचरनिकराणां स्वनिकेतनानां मनइन्द्रियासुगणान् अनात्मनस्तत्वं स्वयमात्माऽ-न्तर्यामी प्रचोदयति॥ १२/६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.037.m4a", "display_order": 38}, {"id": 6000338038, "chapter_id": 10338, "verse_number": "१२-६-३५", "content_sanskrit": "य एवेमं लोकमतिकरालवदनान्धकारसञ्ज्ञाजगरगृहीतं मृतकमिव विचेतनमवलोक्यानुकम्पया परमकारुणिक ईक्षयैवोत्थाप्याहरहरनुसवनं श्रेयसि स्वधर्माख्य आत्मावस्थाने प्रवर्तयत्यनिमिषाधिपतिरसाधूनां भयमुदीरयन्नटति परित आशापालैस्तत्र तत्र कमलकोशाञ्जलिभिरुपहृतार्हणः॥ १२/६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.038.m4a", "display_order": 39}, {"id": 6000338039, "chapter_id": 10338, "verse_number": "१२-६-३६", "content_sanskrit": "अथ ह भगवंस्तव चरणनलिनयुगलं त्रिभुवनगुरुभिरभिवन्दितमहमयातयामयजुःकाम उपसरामि’ इति॥ १२/६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.039.m4a", "display_order": 40}, {"id": 6000338040, "chapter_id": 10338, "verse_number": null, "content_sanskrit": "सूत उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.040.m4a", "display_order": 41}, {"id": 6000338041, "chapter_id": 10338, "verse_number": "१२-६-३७", "content_sanskrit": "एवं स्तुतः स भगवान् वाजिरूपधरो रविः।\nयजूंष्ययातयामानि मुनयेऽदात् प्रसादितः॥ १२/६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.041.m4a", "display_order": 42}, {"id": 6000338042, "chapter_id": 10338, "verse_number": "१२-६-३८", "content_sanskrit": "यजुर्भिरकरोच्छाखा दश पञ्च सुतैर्विभुः।\nजगृहुर्वाजसन्यस्ताः काण्वमाध्यन्दिनादयः॥ १२/६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.042.m4a", "display_order": 43}, {"id": 6000338043, "chapter_id": 10338, "verse_number": "१२-६-३९", "content_sanskrit": "जैमिनेः सामगस्यासीत् सुमन्तुस्तनयो मुनेः।\nसुमन्वांस्तत्सुतस्ताभ्यामेकैकां प्राह संहिताम्॥ १२/६/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.043.m4a", "display_order": 44}, {"id": 6000338044, "chapter_id": 10338, "verse_number": "१२-६-४०", "content_sanskrit": "सुकर्मा चापि तच्छिष्यः सामवेदतरोर्महान्।\nसहस्रं संहिताभेदं चक्रे साम्नां ततो द्विजः॥ १२/६/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.044.m4a", "display_order": 45}, {"id": 6000338045, "chapter_id": 10338, "verse_number": "१२-६-४१", "content_sanskrit": "हिरण्यनाभः कौसल्यः पौष्यञ्जिश्च सुकर्मणः।\nशिष्यौ जगृहतुश्चान्य आवन्त्यो ब्रह्मवित्तमः॥ १२/६/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.045.m4a", "display_order": 46}, {"id": 6000338046, "chapter_id": 10338, "verse_number": "१२-६-४२", "content_sanskrit": "उदीच्याः सामगाः शिष्या आसन् पञ्चशतानि वै।\nपौष्यञ्ज्यावन्त्ययोश्चापि तांश्चोदीच्यान् प्रचक्षते॥ १२/६/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.046.m4a", "display_order": 47}, {"id": 6000338047, "chapter_id": 10338, "verse_number": "१२-६-४३", "content_sanskrit": "लौगाक्षिर्लाङ्गलिः कुल्यः कुसीदः कुक्षिरेव च।\nपौष्यञ्जिशिष्या जगृहुः संहितास्ते शतं शतम्॥ १२/६/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.047.m4a", "display_order": 48}, {"id": 6000338048, "chapter_id": 10338, "verse_number": "१२-६-४४", "content_sanskrit": "कृतो हिरण्यनाभस्य चतुर्विंशतिसंहिताः।\nशिष्य ऊचे स्वशिष्येभ्यः शेषा आवन्त्य आत्मवान्॥ १२/६/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.048.m4a", "display_order": 49}, {"id": 6000338049, "chapter_id": 10338, "verse_number": "१२-६-४५", "content_sanskrit": "अथर्ववित् सुमन्तुश्च शिष्यमध्यापयत् स्वकाम्।\nसंहितां सोऽपि पथ्याय वेददर्शाय चोक्तवान्॥ १२/६/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.049.m4a", "display_order": 50, "topics": [{"text": "अथर्ववेदविभागः", "range": "४५–५१"}]}, {"id": 6000338050, "chapter_id": 10338, "verse_number": "१२-६-४६", "content_sanskrit": "शौक्लायनिर्ब्रह्मवालिर्मोदोषः पिप्पलायनिः।\nवेददर्शस्य शिष्यास्ते पथ्यशिष्यानथो शृणु॥ १२/६/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.050.m4a", "display_order": 51}, {"id": 6000338051, "chapter_id": 10338, "verse_number": null, "content_sanskrit": "(कुमुदः शौनको ब्रह्मन् जाजलिश्चाप्यथर्ववित्॥ १२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.051.m4a", "display_order": 52}, {"id": 6000338052, "chapter_id": 10338, "verse_number": "१२-६-४७", "content_sanskrit": ")\nबभ्रुः शिष्योऽप्यङ्गिरसः सैन्धवायन एव च। अधीयेतां संहिते द्वे सावर्ण्याद्यास्तथाऽपरे॥ १२/६/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.052.m4a", "display_order": 53}, {"id": 6000338053, "chapter_id": 10338, "verse_number": "१२-६-४८", "content_sanskrit": "नक्षत्रकल्पः शान्तिश्च कश्यपाङ्गिरसादयः।\nएते आथर्वणाचार्याः शृणु पौराणिकान् मुने॥ १२/६/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.053.m4a", "display_order": 54}, {"id": 6000338054, "chapter_id": 10338, "verse_number": "१२-६-४९", "content_sanskrit": "त्रय्यारुणिः कश्यपश्च सावर्णिरकृतव्रणः।\nवैशंपायनहारीतौ षड् वै पौराणिका इमे॥ १२/६/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.054.m4a", "display_order": 55}, {"id": 6000338055, "chapter_id": 10338, "verse_number": "१२-६-५०", "content_sanskrit": "अधीयन्त व्यासशिष्यात् संहितां मत्पितुर्मुखात्।\nएकैकामहमेतेषां शिष्यः सर्वां समध्यगाम्॥ १२/६/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.055.m4a", "display_order": 56}, {"id": 6000338056, "chapter_id": 10338, "verse_number": "१२-६-५१", "content_sanskrit": "काश्यपोऽहं च सावर्णी रामशिष्योऽकृतव्रणः।\nअधीमहि व्यासपुत्राच्चतस्रो मूलसंहिताः॥ १२/६/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.056.m4a", "display_order": 57}, {"id": 6000338057, "chapter_id": 10338, "verse_number": "१२-६-५२", "content_sanskrit": "पुराणलक्षणं ब्रह्मन् ब्रह्मर्षिभिर्निरूपितम्।\nश्रुणुष्व बुद्धिमाश्रित्य वेदशास्त्रानुसारतः॥ १२/६/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.057.m4a", "display_order": 58, "topics": [{"text": "पुराणलक्षणदशककथनम्", "range": "५२–६६"}]}, {"id": 6000338058, "chapter_id": 10338, "verse_number": "१२-६-५३", "content_sanskrit": "सर्गश्चैव विसर्गश्च वृत्तिरक्षान्तराणि च।\nवंशो वंशानुचरितं संस्था हेतुरपाश्रयः॥ १२/६/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.058.m4a", "display_order": 59}, {"id": 6000338059, "chapter_id": 10338, "verse_number": "१२-६-५४", "content_sanskrit": "दशभिर्लक्षणैर्युक्तं पुराणं तद्विदो विदुः।\nक्‍वचित् पञ्चविधं ब्रह्मन् महदल्पव्यवस्थया॥ १२/६/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.059.m4a", "display_order": 60}, {"id": 6000338060, "chapter_id": 10338, "verse_number": "१२-६-५५", "content_sanskrit": "अव्याकृतगुणक्षोभान्महतस्त्रिवृतोऽहमः।\nभूतसूक्ष्मेन्द्रियार्थानां सम्भवः सर्ग उच्यते॥ १२/६/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.060.m4a", "display_order": 61}, {"id": 6000338061, "chapter_id": 10338, "verse_number": "१२-६-५६", "content_sanskrit": "पुरुषानुगृहीतानामेतेषां वासनामयः।\nविसर्गो यः समाहारो जीवोऽजीवश्चराचरः॥ १२/६/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.061.m4a", "display_order": 62}, {"id": 6000338062, "chapter_id": 10338, "verse_number": "१२-६-५७", "content_sanskrit": "वृत्तिर्भूतानि भूतानां चरणामचराणि च।\nकृतेशेन नृणां तत्र कामाच्चोदनयाऽपि वा॥ १२/६/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.062.m4a", "display_order": 63}, {"id": 6000338063, "chapter_id": 10338, "verse_number": "१२-६-५८", "content_sanskrit": "रक्षाऽच्युतावतारेहा विश्वस्यानु युगेयुगे।\nतिर्यङ्मर्त्यर्षिदेवेषु हन्यन्ते यैस्त्रयीद्विषः॥ १२/६/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.063.m4a", "display_order": 64}, {"id": 6000338064, "chapter_id": 10338, "verse_number": "१२-६-५९", "content_sanskrit": "मन्वन्तरं मनुर्देवा मनुपुत्राः सुरेश्वराः।\nऋषयोंऽशावताराश्च हरेः षड्विधमुच्यते॥ १२/६/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.064.m4a", "display_order": 65}, {"id": 6000338065, "chapter_id": 10338, "verse_number": "१२-६-६०", "content_sanskrit": "राज्ञां मनुप्रसूतानां वंशस्त्रैकालिकोऽन्वयः।\nवंशानुचरितं तेषां वृत्तं वंशधराश्च ये॥ १२/६/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.065.m4a", "display_order": 66}, {"id": 6000338066, "chapter_id": 10338, "verse_number": "१२-६-६१", "content_sanskrit": "नैमित्तिकः प्राकृतिको नित्य आत्यन्तिको लयः।\nसंस्थेति कविभिः प्रोक्ता चतुर्धाऽस्य स्वभावतः॥ १२/६/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.066.m4a", "display_order": 67}, {"id": 6000338067, "chapter_id": 10338, "verse_number": "१२-६-६२", "content_sanskrit": "हेतुर्जीवोऽस्य सर्गादेरविद्याकर्मकारकः।\nयं वाऽनुशायिनं प्राहुरव्याकृतमुतापरे॥ १२/६/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.067.m4a", "display_order": 68}, {"id": 6000338068, "chapter_id": 10338, "verse_number": "१२-६-६३", "content_sanskrit": "व्यतिरेकान्वयौ यस्य जाग्रत्स्वप्नसुषुप्तिषु।\nमायामयासु तद्ब्रह्म जीववृत्तिष्वपाश्रयः॥ १२/६/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.068.m4a", "display_order": 69}, {"id": 6000338069, "chapter_id": 10338, "verse_number": "१२-६-६४", "content_sanskrit": "पदार्थेषु यथा द्रव्यं तन्मात्रं रूपनामसु।\nबीजादिपञ्चतान्तासु ह्यवस्थासु युतायुतम्॥ १२/६/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.069.m4a", "display_order": 70}, {"id": 6000338070, "chapter_id": 10338, "verse_number": "१२-६-६५", "content_sanskrit": "विरमेत यदा चित्तं हित्वा वृत्तित्रयाश्रयम्।\nयोगेन वा तदाऽऽत्मानं वेद नात्मा निवर्तते॥ १२/६/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.070.m4a", "display_order": 71}, {"id": 6000338071, "chapter_id": 10338, "verse_number": "१२-६-६६", "content_sanskrit": "एवं लक्षणलक्ष्याणि पुराणानि पुराविदः।\nमुनयोऽष्टादश प्राहुः क्षुल्लकानि महान्ति च॥ १२/६/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.071.m4a", "display_order": 72}, {"id": 6000338072, "chapter_id": 10338, "verse_number": "१२-६-६७", "content_sanskrit": "ब्राह्मं पाद्मं वैष्णवं च शैवं लिङ्गं च गारुडम्।\nनारदीयं भागवतमाग्नेयं स्कन्दसञ्चितम्॥ १२/६/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.072.m4a", "display_order": 73, "topics": [{"text": "अष्टादशपुराणनामकथनम्", "range": "६७–६९"}]}, {"id": 6000338073, "chapter_id": 10338, "verse_number": "१२-६-६८", "content_sanskrit": "भविष्यं ब्रह्मवैवर्तं मार्कण्डेयं सवामनम्।\nवाराहं मात्स्यं कौर्म्यं च ब्रह्माण्डाख्यमिति त्रिषट्॥ १२/६/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.073.m4a", "display_order": 74}, {"id": 6000338074, "chapter_id": 10338, "verse_number": "१२-६-६९", "content_sanskrit": "ब्रह्मणैतत् समाख्यातं शाखाप्रणयनं मुने।\nशिष्यशिष्यप्रशिष्याणां ब्रह्मतेजोविदीपनम्॥ १२/६/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_006/BhP_12.006.074.m4a", "display_order": 75}, {"id": 6000338075, "chapter_id": 10338, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वादशस्कन्धे षष्ठाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]