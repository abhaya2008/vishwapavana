[{"id": 7006358000, "chapter_id": 26358, "verse_number": "२-१४-१", "content_sanskrit": "वैशम्पायन उवाच\nअथ तौ जातहर्षौ तु वसुदेवसुतावुभौ ।\nतत्  तालवनमुत्सृज्य भूयो भाण्डीरमागतौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006358001, "chapter_id": 26358, "verse_number": "२-१४-२", "content_sanskrit": "चारयन्तौ विवृद्धानि गोधनानि शुभानि च ।\nस्फीतसस्यप्ररूढानि वीक्षमाणौ वनानि च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006358002, "chapter_id": 26358, "verse_number": "२-१४-३", "content_sanskrit": "क्ष्वेडयन्तौ प्रगायन्तौ प्रचिन्वन्तौ च पादपान् ।\nनामभिर्व्याहरन्तौ च सवत्सा गाः परंतपौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006358003, "chapter_id": 26358, "verse_number": "२-१४-४", "content_sanskrit": "निर्योगपाशैरासक्तैः स्कन्धाभ्यां शुभलक्षणौ ।\nवनमालाकुलोरस्कौ बालशृङ्गाविवर्षभौ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006358004, "chapter_id": 26358, "verse_number": "२-१४-५", "content_sanskrit": "सुवर्णाञ्जनचूर्णाभावन्योन्यसदृशाम्बरौ ।\nमहेन्द्रायुधसंसक्तौ शुक्लकृष्णाविवाम्बुदौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006358005, "chapter_id": 26358, "verse_number": "२-१४-६", "content_sanskrit": "कुशाग्रकुसुमानां च कर्णपूरौ मनोरमौ ।\nवनमार्गेषु कुर्वाणौ वन्यवेषधरावुभौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006358006, "chapter_id": 26358, "verse_number": "२-१४-७", "content_sanskrit": "गोवर्धनस्यानु चरौ वने सानुचरौ तु तौ ।\nचेरतुर्लोकसिद्धाभिः क्रीडाभिरपराजितौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006358007, "chapter_id": 26358, "verse_number": "२-१४-८", "content_sanskrit": "तावेवं मानुषीं दीक्षां वहन्तौ सुरपूजितौ ।\nतज्जातिगुणयुक्ताभिः क्रीडाभिश्चेरतुर्वनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006358008, "chapter_id": 26358, "verse_number": "२-१४-९", "content_sanskrit": "तौ तु भाण्डीरमाश्रित्य बालक्रीडानुवर्तिनौ ।\nप्राप्तौ परमशाखाढ्यं न्यग्रोधं शाखिनां वरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006358009, "chapter_id": 26358, "verse_number": "२-१४-१०", "content_sanskrit": "तत्र त्वान्दोलिकाभिश्च युद्धमार्गविशारदौ ।\nअश्मभिः क्षेपणीयैश्च तौ व्यायाममकुर्वताम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006358010, "chapter_id": 26358, "verse_number": "२-१४-११", "content_sanskrit": "युद्धमार्गैश्च विविधैर्गोपालैः सहितावुभौ ।\nमुदितौ सिंहविक्रान्तौ यथाकामं विचेरतुः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006358011, "chapter_id": 26358, "verse_number": "२-१४-१२", "content_sanskrit": "तयो रमयतोरेव तल्लिप्सुरसुरोत्तमः ।\nप्रलम्बोऽभ्यागमत्तत्र च्छिद्रान्वेषी तयोस्तदा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006358012, "chapter_id": 26358, "verse_number": "२-१४-१३", "content_sanskrit": "गोपालवेषमास्थाय वन्यपुष्पविभूषितः ।\nलोभयानः स तौ वीरौ हास्यैः क्रीडनकैस्तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006358013, "chapter_id": 26358, "verse_number": "२-१४-१४", "content_sanskrit": "सोऽवगाहत निश्शङ्कस्तेषां मध्यममानुषः ।\nमानुषं वपुरास्थाय प्रलम्बो दानवोत्तमः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006358014, "chapter_id": 26358, "verse_number": "२-१४-१५", "content_sanskrit": "प्रक्रीडिताश्च ते सर्वे सह तेनामरारिणा ।\nगोपालवपुषं गोपा मन्यमानाः स्वबान्धवम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006358015, "chapter_id": 26358, "verse_number": "२-१४-१६", "content_sanskrit": "स तु च्छिद्रान्तरप्रेप्सुः प्रलम्बो गोपतां गतः ।\nदृष्टिं प्रणिदधे कृष्णे रौहिणेये च दारुणाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006358016, "chapter_id": 26358, "verse_number": "२-१४-१७", "content_sanskrit": "अविषह्यं ततो मत्वा कृष्णमद्भुतविक्रमम् ।\nरौहिणेयवधे यत्नमकरोद् दानवोत्तमः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006358017, "chapter_id": 26358, "verse_number": "२-१४-१८", "content_sanskrit": "हरिणाक्रीडनं नाम बालक्रीडनकं ततः ।\nप्रक्रीडितास्तु ते सर्वे द्वौ द्वौ युगपदुत्पतन् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006358018, "chapter_id": 26358, "verse_number": "२-१४-१९", "content_sanskrit": "कृष्णः श्रीदामसहितः पुप्लुवे गोपसूनुना ।\nसंकर्षणस्तु प्लुतवान् प्रलम्बेन सहानघ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006358019, "chapter_id": 26358, "verse_number": "२-१४-२०", "content_sanskrit": "गोपालास्त्वपरे द्वन्द्वं गोपालैरपरैः सह ।\nप्रद्रुता लङ्घयन्तो वै तेऽन्योन्यं लघुविक्रमाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006358020, "chapter_id": 26358, "verse_number": "२-१४-२१", "content_sanskrit": "श्रीदाममजयत् कृष्णः प्रलम्बं रोहिणीसुतः ।\nगोपालैः कृष्णपक्षीयैर्गोपालास्त्वपरे जिताः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006358021, "chapter_id": 26358, "verse_number": "२-१४-२२", "content_sanskrit": "ते वाहयन्तस्त्वन्योन्यं संहर्षात् सहसा द्रुताः ।\nभाण्डीरस्कन्धमुद्दिश्य मर्यादां पुनरागमन् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006358022, "chapter_id": 26358, "verse_number": "२-१४-२३", "content_sanskrit": "संकर्षणं तु स्कन्धेन शीघ्रमुत्क्षिप्य दानवः ।\nद्रुतं जगाम विमुखः सचन्द्र इव तोयदः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006358023, "chapter_id": 26358, "verse_number": "२-१४-२४", "content_sanskrit": "स भारमसहंस्तस्य रौहिणेयस्य धीमतः ।\nववृधे सुमहाकायः शक्राक्रान्त इवाम्बुदः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006358024, "chapter_id": 26358, "verse_number": "२-१४-२५", "content_sanskrit": "स भाण्डीरवटप्रख्यं दग्धाञ्जनगिरिप्रभम् ।\nस्वं वपुर्दर्शयामास प्रलम्बो दानवोत्तमः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006358025, "chapter_id": 26358, "verse_number": "२-१४-२६", "content_sanskrit": "पञ्चस्तबकयुक्तेन मुकुटेनार्कवर्चसा ।\nदीप्यमानाननो दैत्यः सूर्याक्रान्त इवाम्बुदः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006358026, "chapter_id": 26358, "verse_number": "२-१४-२७", "content_sanskrit": "महाननो महाग्रीवः सुमहानन्तकोपमः ।\nरौद्रः शकटचक्राक्षो नमयंश्चरणैर्महीम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006358027, "chapter_id": 26358, "verse_number": "२-१४-२८", "content_sanskrit": "स्रग्दामलम्बाभरणः प्रलम्बाम्बरभूषणः ।\nवीरः प्रलम्बः प्रययौ लम्बतोय इवाम्बुदः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006358028, "chapter_id": 26358, "verse_number": "२-१४-२९", "content_sanskrit": "स जहाराथ वेगेन रौहिणेयं महासुरः ।\nसागरोपप्लवगतं कृत्स्नं लोकमिवान्तकः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006358029, "chapter_id": 26358, "verse_number": "२-१४-३०", "content_sanskrit": "ह्रियमाणः प्रलम्बेन स तु संकर्षणो बभौ ।\nउह्यमान इवाकाशे कालमेघेन चन्द्रमाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006358030, "chapter_id": 26358, "verse_number": "२-१४-३१", "content_sanskrit": "स संदिग्धमिवात्मानं मेने संकर्षणस्तदा ।\nदैत्यस्कन्धगतः श्रीमान् कृष्णं चेदमुवाच ह ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006358031, "chapter_id": 26358, "verse_number": "२-१४-३२", "content_sanskrit": "ह्रियेऽहं कृष्ण दैत्येन पर्वतोदग्रवर्ष्मणा ।\nप्रदर्शयित्वा महतीं मायां मानुषरूपिणीम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006358032, "chapter_id": 26358, "verse_number": "२-१४-३३", "content_sanskrit": "कथमस्य मया कार्यं शासनं दुष्टचेतसः ।\nप्रलम्बस्य प्रवृद्धस्य दर्पाद् द्विगुणवर्चसः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006358033, "chapter_id": 26358, "verse_number": "२-१४-३४", "content_sanskrit": "तमाह सस्मितं कृष्णः साम्ना हर्षाकुलेन वै ।\nअभिज्ञो रौहिणेयस्य वृत्तस्य च बलस्य च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006358034, "chapter_id": 26358, "verse_number": "२-१४-३५", "content_sanskrit": "अहोऽयं मानुषो भावो व्यक्तमेवानुपाल्यते ।\nयस्त्वं जगन्मयं देवं गुह्याद् गुह्यतरं गतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006358035, "chapter_id": 26358, "verse_number": "२-१४-३६", "content_sanskrit": "स्मर नारायणात्मानं लोकानां त्वं विपर्यये ।\nअवगच्छात्मनाऽऽत्मानं समुद्राणां समागमे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006358036, "chapter_id": 26358, "verse_number": "२-१४-३७", "content_sanskrit": "पुरातनानां देवानां ब्रह्मणः सलिलस्य च ।\nआत्मवृत्तप्रभावाणां संस्मराद्यं च वै वपुः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006358037, "chapter_id": 26358, "verse_number": "२-१४-३८", "content_sanskrit": "शिरः खं ते जलं मूर्त्तिः पादौ भूर्दहनो मुखम् ।\nवायुर्लोकायुरुछ्वासो मनः सोमो ह्यभूत्तव ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006358038, "chapter_id": 26358, "verse_number": "२-१४-३९", "content_sanskrit": "सहस्रास्यः सहस्राङ्गः सहस्रचरणेक्षणः ।\nसहस्रपद्मनाभस्त्वं सहस्रांशुधरोऽरिहा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006358039, "chapter_id": 26358, "verse_number": "२-१४-४०", "content_sanskrit": "यत्त्वया दर्शितं लोके तत् पश्यन्ति दिवौकसः ।\nयत् त्वया नोक्तपूर्वं हि कस्तदन्वेष्टुमर्हति ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006358040, "chapter_id": 26358, "verse_number": "२-१४-४१", "content_sanskrit": "यद् वेदितव्यं लोकेऽस्मिंस्तत्त्वया समुदाहृतम् ।\nविदितं यत् तवैकस्य देवा अपि न तद् विदुः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006358041, "chapter_id": 26358, "verse_number": "२-१४-४२", "content_sanskrit": "आत्मजं ते वपुर्व्योम्नि न पश्यन्त्यात्मसम्भवम् ।\nयत् तु ते कृत्रिमं रूपं तदर्चन्ति दिवौकसः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006358042, "chapter_id": 26358, "verse_number": "२-१४-४३", "content_sanskrit": "देवैर्न दृष्टश्चान्तस्ते तेनानन्त इति स्मृतः ।\nत्वं हि सूक्ष्मो महानेकः सूक्ष्मैरपि दुरासदः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006358043, "chapter_id": 26358, "verse_number": "२-१४-४४", "content_sanskrit": "त्वय्येव जगतः स्तम्भे शाश्वती जगती स्थिता ।\nअचला प्राणिनां योनिर्धारयत्यखिलं जगत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006358044, "chapter_id": 26358, "verse_number": "२-१४-४५", "content_sanskrit": "चतुःसागरभोगस्वंः  चातुर्वर्ण्यविभागवित् ।\nचतुर्युगेषु लोकानां चातुर्होत्रफलाशनः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006358045, "chapter_id": 26358, "verse_number": "२-१४-४६", "content_sanskrit": "यथाहमपि लोकानां तथा त्वं तच्च मे मतम् ।\nउभावेकशरीरौ स्वो जगदर्थे द्विधाकृतौ ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006358046, "chapter_id": 26358, "verse_number": "२-१४-४७", "content_sanskrit": "अहं वा शाश्वतः कृष्णस्त्वं वा शेषः पुरातनः ।\nलोकानां शाश्वतो देवस्त्वं हि शेषः सनातनः ।\nआवयोर्देहमात्रेण द्विधेदं धार्यते जगत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006358047, "chapter_id": 26358, "verse_number": "२-१४-४८", "content_sanskrit": "अहं यः स भवानेव यस्त्वं सोऽहं सनातनः ।\nद्वावेव विहितौ ह्यावामेकदेहौ महाबलौ ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006358048, "chapter_id": 26358, "verse_number": "२-१४-४९", "content_sanskrit": "तदास्से मूढवत् त्वं किं प्राणेन जहि दानवम् ।\nमूर्ध्नि देवरिपुं देव वज्रकल्पेन मुष्टिना ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006358049, "chapter_id": 26358, "verse_number": "२-१४-५०", "content_sanskrit": "वैशम्पायन उवाच\nसंस्मारितस्तु कृष्णेन रौहिणेयः पुरातनम् ।\nबलेनापूर्यत तदा त्रैलोक्यान्तरचारिणा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006358050, "chapter_id": 26358, "verse_number": "२-१४-५१", "content_sanskrit": "ततः प्रलम्बं दुर्वृत्तं स बद्धेन महाभुजः ।\nमुष्टिना वज्रकल्पेन मूर्ध्नि चैनं समाहनत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006358051, "chapter_id": 26358, "verse_number": "२-१४-५२", "content_sanskrit": "तस्योत्तमाङ्गं स्वे काये विकपालं विवेश ह ।\nजानुभ्यां चाहतः शेते गतासुर्दानवोत्तमः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006358052, "chapter_id": 26358, "verse_number": "२-१४-५३", "content_sanskrit": "जगत्यां विप्रकीर्णस्य तस्य रूपमभूत् तदा ।\nप्रलम्बस्याम्बरस्थस्य मेघस्येव विदीर्यतः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006358053, "chapter_id": 26358, "verse_number": "२-१४-५४", "content_sanskrit": "तस्य भग्नोत्तमाङ्गस्य देहात् सुस्राव शोणितम् ।\nबहुगैरिकसंयुक्तं शैलशृङ्गादिवोदकम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006358054, "chapter_id": 26358, "verse_number": "२-१४-५५", "content_sanskrit": "तं निहत्य प्रलम्बं तु संहृत्य बलमात्मनः ।\nपर्यष्वजत वै कृष्णं रौहिणेयः प्रतापवान् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006358055, "chapter_id": 26358, "verse_number": "२-१४-५६", "content_sanskrit": "तं तु कृष्णश्च गोपाश्च दिविस्थाश्च दिवौकसः ।\nतुष्टुवुर्निहते दैत्ये जयाशीर्भिर्महाबलम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006358056, "chapter_id": 26358, "verse_number": "२-१४-५७", "content_sanskrit": "बलेनायं हतो दैत्यो बालेनाक्लिष्टकर्मणा ।\nविवदन्त्यशरीरिण्यो वाचः सुरसमीरिताः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006358057, "chapter_id": 26358, "verse_number": "२-१४-५८", "content_sanskrit": "बलदेवेति नामास्य देवैरुक्तं दिवि स्थितैः ।\nबलं तु बलदेवस्य तदा भुवि जना विदुः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006358058, "chapter_id": 26358, "verse_number": "२-१४-५९", "content_sanskrit": "कर्मजं निहते दैत्ये देवैरपि दुरासदे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]