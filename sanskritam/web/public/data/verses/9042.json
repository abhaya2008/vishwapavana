[{"id": 5000042000, "chapter_id": 9042, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे द्विचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000042001, "chapter_id": 9042, "verse_number": "१-४२-१", "content_sanskrit": "कालधर्मं गते राम सगरे प्रकृतीजनाः ।\nराजानं रोचयामासुरंशुमन्तं सुधार्मिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000042002, "chapter_id": 9042, "verse_number": "१-४२-२", "content_sanskrit": "स राजा सुमहानासीदंशुमान् रघुनन्दन ।\nतस्य पुत्रो महानासीद् दिलीप इति विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000042003, "chapter_id": 9042, "verse_number": "१-४२-३", "content_sanskrit": "तस्मै राज्यं समादिश्य दिलीपे रघुनन्दन ।\nहिमवच्छिखरे रम्ये तपस्तेपे सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000042004, "chapter_id": 9042, "verse_number": "१-४२-४", "content_sanskrit": "द्वात्रिंशच्छतसाहस्रं वर्षाणि सुमहायशाः ।\nतपोवनगतो राजा स्वर्गं लेभे तपोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000042005, "chapter_id": 9042, "verse_number": "१-४२-५", "content_sanskrit": "दिलीपस्तु महातेजाः श्रुत्वा पैतामहं वधम् ।\nदुःखोपहतया बुद्ध्या निश्चयं नाध्यगच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000042006, "chapter_id": 9042, "verse_number": "१-४२-६", "content_sanskrit": "कथं गङ्गावतरणं कथं तेषां जलक्रिया ।\nतारयेयं कथं चैतानिति चिन्तापरोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000042007, "chapter_id": 9042, "verse_number": "१-४२-७", "content_sanskrit": "तस्य चिन्तयतो नित्यं धर्मेण विदितात्मनः ।\nपुत्रो भगीरथो नाम जज्ञे परमधार्मिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000042008, "chapter_id": 9042, "verse_number": "१-४२-८", "content_sanskrit": "दिलीपस्तु महातेजा यज्ञैर्बहुभिरिष्टवान् ।\nत्रिंशद्वर्षसहस्राणि राजा राज्यमकारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000042009, "chapter_id": 9042, "verse_number": "१-४२-९", "content_sanskrit": "अगत्वा निश्चयं राजा तेषामुद्धरणं प्रति ।\nव्याधिना नरशार्दूल कालधर्ममुपेयिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000042010, "chapter_id": 9042, "verse_number": "१-४२-१०", "content_sanskrit": "इन्द्रलोकं गतो राजा स्वार्जितेनैव कर्मणा ।\nराज्ये भगीरथं पुत्रमभिषिच्य नरर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000042011, "chapter_id": 9042, "verse_number": "१-४२-११", "content_sanskrit": "भगीरथस्तु राजर्षिर्धार्मिको रघुनन्दन ।\nअनपत्यो महाराजः प्रजाकामः स च प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000042012, "chapter_id": 9042, "verse_number": "१-४२-१२", "content_sanskrit": "मन्त्रिष्वाधाय तद् राज्यं गङ्गावतरणे रतः ।\nतपो दीर्घं समातिष्ठद् गोकर्णे रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000042013, "chapter_id": 9042, "verse_number": "१-४२-१३", "content_sanskrit": "ऊर्ध्वबाहुः पञ्चतपा मासाहारो जितेन्द्रियः ।\nतस्य वर्षसहस्राणि घोरे तपसि तिष्ठतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000042014, "chapter_id": 9042, "verse_number": "१-४२-१४", "content_sanskrit": "अतीतानि महाबाहो तस्य राज्ञो महात्मनः ।\nसुप्रीतो भगवान् ब्रह्मा प्रजानां प्रभुरीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000042015, "chapter_id": 9042, "verse_number": "१-४२-१५", "content_sanskrit": "ततः सुरगणैः सार्धमुपागम्य पितामहः ।\nभगीरथं महात्मानं तप्यमानमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000042016, "chapter_id": 9042, "verse_number": "१-४२-१६", "content_sanskrit": "भगीरथ महाराज प्रीतस्तेऽहं जनाधिप ।\nतपसा च सुतप्तेन वरं वरय सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000042017, "chapter_id": 9042, "verse_number": "१-४२-१७", "content_sanskrit": "तमुवाच महातेजाः सर्वलोकपितामहम् ।\nभगीरथो महाबाहुः कृताञ्जलिपुटः स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000042018, "chapter_id": 9042, "verse_number": "१-४२-१८", "content_sanskrit": "यदि मे भगवान् प्रीतो यद्यस्ति तपसः फलम् ।\nसगरस्यात्मजाः सर्वे मत्तः सलिलमाप्नुयुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000042019, "chapter_id": 9042, "verse_number": "१-४२-१९", "content_sanskrit": "गङ्गायाः सलिलक्लिन्ने भस्मन्येषां महात्मनाम् ।\nस्वर्गं गच्छेयुरत्यन्तं सर्वे च प्रपितामहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000042020, "chapter_id": 9042, "verse_number": "१-४२-२०", "content_sanskrit": "देव याचे ह संतत्यै नावसीदेत् कुलं च नः ।\nइक्ष्वाकूणां कुले देव एष मेऽस्तु वरः परः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000042021, "chapter_id": 9042, "verse_number": "१-४२-२१", "content_sanskrit": "उक्तवाक्यं तु राजानं सर्वलोकपितामहः ।\nप्रत्युवाच शुभां वाणीं मधुरां मधुराक्षराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000042022, "chapter_id": 9042, "verse_number": "१-४२-२२", "content_sanskrit": "मनोरथो महानेष भगीरथ महारथ ।\nएवं भवतु भद्रं ते इक्ष्वाकुकुलवर्धन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000042023, "chapter_id": 9042, "verse_number": "१-४२-२३", "content_sanskrit": "इयं हैमवती ज्येष्ठा गङ्गा हिमवतः सुता ।\nतां वै धारयितुं राजन् हरस्तत्र नियुज्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000042024, "chapter_id": 9042, "verse_number": "१-४२-२४", "content_sanskrit": "गङ्गायाः पतनं राजन् पृथिवी न सहिष्यते ।\nतां वै धारयितुं राजन् नान्यं पश्यामि शूलिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000042025, "chapter_id": 9042, "verse_number": "१-४२-२५", "content_sanskrit": "तमेवमुक्त्वा राजानं गङ्गां चाभाष्य लोककृत् ।\nजगाम त्रिदिवं देवैः सर्वैः सह मरुद्गणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000042026, "chapter_id": 9042, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे द्विचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]