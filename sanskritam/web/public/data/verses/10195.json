[{"id": 6000195000, "chapter_id": 10195, "verse_number": null, "content_sanskrit": "अथ विंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000195001, "chapter_id": 10195, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.001.m4a", "display_order": 2}, {"id": 6000195002, "chapter_id": 10195, "verse_number": "९-२०-१", "content_sanskrit": "अनोः सभानरश्चक्षुः परेक्षुश्च त्रयः सुताः।\nसभानरात् कालनरः सञ्जयस्तत्सुतस्ततः॥ ९/२०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.002.m4a", "display_order": 3, "topics": [{"text": "ययातिपुत्राणाम् अनुद्रुह्युतुर्वसूनां वंशकथनम्", "range": "१–२०"}]}, {"id": 6000195003, "chapter_id": 10195, "verse_number": "९-२०-२", "content_sanskrit": "जनमेजयस्तस्य पुत्रो महाशीलो महामनाः।\nउशीनरस्तितिक्षुश्च महामनस आत्मजौ॥ ९/२०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.003.m4a", "display_order": 4}, {"id": 6000195004, "chapter_id": 10195, "verse_number": "९-२०-३", "content_sanskrit": "शिबिर्वनः शमिर्दक्षश्चत्वारोशीनरात्मजाः।\nवृषदर्भः सुवीरश्च मद्रः केकय आत्मजाः॥ ९/२०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.004.m4a", "display_order": 5}, {"id": 6000195005, "chapter_id": 10195, "verse_number": "९-२०-४", "content_sanskrit": "शिबेश्चत्वार एवासन् तितिक्षोश्च पृषद्रथः।\nततो हेमोऽथ सुतपा बलिः सुतपसोऽभवत्॥ ९/२०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.005.m4a", "display_order": 6}, {"id": 6000195006, "chapter_id": 10195, "verse_number": "९-२०-५", "content_sanskrit": "अङ्गवङ्गकलिङ्गाद्याः सुद्मपुण्ड्रान्ध्रसञ्ज्ञिताः।\nजज्ञिरे दीर्घतमसो बलेः क्षेत्रे महीक्षितः॥ ९/२०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.006.m4a", "display_order": 7}, {"id": 6000195007, "chapter_id": 10195, "verse_number": "९-२०-६", "content_sanskrit": "चक्रुः स्वनाम्ना विषयान् षडिमान् प्राच्यकानिह।\nखनपानोऽङ्गतो जज्ञे तस्माद् दिविरथस्ततः॥ ९/२०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.007.m4a", "display_order": 8}, {"id": 6000195008, "chapter_id": 10195, "verse_number": "९-२०-७", "content_sanskrit": "सुतो धर्मरथस्तस्य जज्ञे मित्ररथोऽप्रजः। रोमपाद इति ख्यातस्तस्मै दशरथः सखा।\nशान्तां स्वकन्यां प्रायच्छद् ऋष्यशृङ्ग उवाह ताम्॥ ९/२०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.008.m4a", "display_order": 9}, {"id": 6000195009, "chapter_id": 10195, "verse_number": "९-२०-८", "content_sanskrit": "देवेऽवर्षति यं रामा आनिन्युर्हरिणीसुतम्।\nनाट्यसङ्गीतवादित्रैर्विभ्रमालिङ्गनार्हणैः॥ ९/२०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.009.m4a", "display_order": 10}, {"id": 6000195010, "chapter_id": 10195, "verse_number": "९-२०-९", "content_sanskrit": "स तु राज्ञोऽनपत्यस्य निरूप्येष्टिं मरुत्पतेः।\nप्रजामदाद् दशरथो येन लेभेऽप्रजः प्रजाः॥ ९/२०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.010.m4a", "display_order": 11}, {"id": 6000195011, "chapter_id": 10195, "verse_number": "९-२०-१०", "content_sanskrit": "चतुरङ्गो रोमपादात् पृथुलाक्षस्तु तत्सुतः॥ ९/२०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.011.m4a", "display_order": 12}, {"id": 6000195012, "chapter_id": 10195, "verse_number": "९-२०-११", "content_sanskrit": "बृहद्रथो बृहत्कर्मा बृहद्भानुश्च तत्सुताः।\nततो बृहन्मनास्तस्माज्जयद्रथ उदाहृतः॥ ९/२०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.012.m4a", "display_order": 13}, {"id": 6000195013, "chapter_id": 10195, "verse_number": "९-२०-१२", "content_sanskrit": "विजयस्तस्य सम्भूत्यां ततो धृतिरजायत।\nततो धृतव्रतस्तस्य सत्कर्माऽधिरथस्ततः॥ ९/२०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.013.m4a", "display_order": 14}, {"id": 6000195014, "chapter_id": 10195, "verse_number": "९-२०-१३", "content_sanskrit": "योऽसौ गङ्गातटे क्रीडन् मञ्जूषान्तर्गतं शिशुम्।\nकुन्त्याऽपविद्धं कानीनमनपत्योऽकरोत् सुतम्॥ ९/२०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.014.m4a", "display_order": 15}, {"id": 6000195015, "chapter_id": 10195, "verse_number": "९-२०-१४", "content_sanskrit": "वृषसेनः सुतस्तस्य कर्णस्य जगतीपते।\nद्रुह्योश्च तनयो बभ्रुः सेतुस्तस्यात्मजस्ततः॥ ९/२०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.015.m4a", "display_order": 16}, {"id": 6000195016, "chapter_id": 10195, "verse_number": "९-२०-१५", "content_sanskrit": "आरब्धस्तस्य गान्धारस्तस्य धर्मस्ततो धृतः।\nधृतस्य कर्दमस्तस्मात् प्रचेताः प्राचेतसं शतम्॥ ९/२०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.016.m4a", "display_order": 17}, {"id": 6000195017, "chapter_id": 10195, "verse_number": "९-२०-१६", "content_sanskrit": "म्लेच्छाधिपतयोऽभूवन्नुदीचीं दिशमाश्रिताः॥ ९/२०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.017.m4a", "display_order": 18}, {"id": 6000195018, "chapter_id": 10195, "verse_number": "९-२०-१७", "content_sanskrit": "तुर्वसोस्तु सुतो वह्निर्वह्नेर्भागोऽथ भानुमान्। नृभानुस्तत्सुतोऽस्यापि करन्धम उदारधीः।\nमरुतस्तत्सुतोऽपुत्रः पुत्रं पौरवमन्वभूत्॥ ९/२०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.018.m4a", "display_order": 19}, {"id": 6000195019, "chapter_id": 10195, "verse_number": "९-२०-१८", "content_sanskrit": "दुष्यन्तं स पुनर्भेजे स्वयं साम्राज्यकामुकः॥ ९/२०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.019.m4a", "display_order": 20}, {"id": 6000195020, "chapter_id": 10195, "verse_number": "९-२०-१९", "content_sanskrit": "ययातेर्ज्येष्ठपुत्रस्य यदोर्वंशं नरर्षभ।\nवर्णयामि महापुण्यं सर्वपापहरं नृप॥ ९/२०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.020.m4a", "display_order": 21}, {"id": 6000195021, "chapter_id": 10195, "verse_number": "९-२०-२०", "content_sanskrit": "यदोर्वंशं नरः श्रुत्वा सर्वपापैः प्रमुच्यते।\nयत्रावतीर्णो भगवान् परमात्मा नराकृतिः॥ ९/२०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.021.m4a", "display_order": 22}, {"id": 6000195022, "chapter_id": 10195, "verse_number": "९-२०-२१", "content_sanskrit": "यदोः सहस्रजित् क्रोष्टुर्नलो रिपुरिति श्रुताः। चत्वारः सूनवस्तस्य शतजित् प्रथमात्मजः।\nमहाहयो वेणुहयो हैहयश्चेति तत्सुताः॥ ९/२०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.022.m4a", "display_order": 23, "topics": [{"text": "पुनर्यदुवंशमनुक्रम्य ज्यामघपर्यन्तं वर्णनम्", "range": "२०–४०"}]}, {"id": 6000195023, "chapter_id": 10195, "verse_number": "९-२०-२२", "content_sanskrit": "धर्मस्तु हैहयसुतो नेत्रः कुन्तेः पिता ततः।\nसोहञ्जिरभवत् कुन्तेर्महिष्मान् भद्रसेनकः॥ ९/२०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.023.m4a", "display_order": 24}, {"id": 6000195024, "chapter_id": 10195, "verse_number": "९-२०-२३", "content_sanskrit": "दुर्मदो भद्रसेनस्य धनकः कृतवीर्यकः।\nकृत्याग्निः कृतवर्मा च कृतौजा धनकात्मजाः॥ ९/२०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.024.m4a", "display_order": 25}, {"id": 6000195025, "chapter_id": 10195, "verse_number": "९-२०-२४", "content_sanskrit": "अर्जुनः कृतवीर्यस्य सप्तद्वीपेश्वरोऽभवत्।\nदत्तात्रेयाद् हरेरंशात् प्राप्तयोगमहागुणः॥ ९/२०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.025.m4a", "display_order": 26}, {"id": 6000195026, "chapter_id": 10195, "verse_number": "९-२०-२५", "content_sanskrit": "न नूनं कार्तवीर्यस्य गतिं यास्यन्ति पार्थिवाः।\nयमदानतपोयोगैः श्रुतवीर्यजयादिभिः॥ ९/२०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.026.m4a", "display_order": 27}, {"id": 6000195027, "chapter_id": 10195, "verse_number": "९-२०-२६", "content_sanskrit": "पञ्चाशीतिसहस्राणि ह्यव्याहतबलः समाः।\nअकरोदर्जुनो राज्यं हरिं चैवान्वहं स्मरन्॥ ९/२०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.027.m4a", "display_order": 28}, {"id": 6000195028, "chapter_id": 10195, "verse_number": "९-२०-२७", "content_sanskrit": "अनष्टविष्णुस्मरणो बुभुजेऽक्षय्यषड्वसु।\nतस्य पुत्रसहस्राणां पञ्चैवोर्वरिता मृधे॥ ९/२०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.028.m4a", "display_order": 29}, {"id": 6000195029, "chapter_id": 10195, "verse_number": "९-२०-२८", "content_sanskrit": "जयध्वजः शूरसेन ऋषभो मधुरूर्जितः।\nजयध्वजात् तालजङ्घस्तस्य पुत्रशतं त्वभूत्॥ ९/२०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.029.m4a", "display_order": 30}, {"id": 6000195030, "chapter_id": 10195, "verse_number": "९-२०-२९", "content_sanskrit": "क्षत्रं यत् तालजङ्घाख्यमौर्वतेजोपसंहृतम्।\nतेषां ज्येष्ठो वीतिहोत्रो वृष्णिः पुत्रो मधोः स्मृतः॥ ९/२०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.030.m4a", "display_order": 31}, {"id": 6000195031, "chapter_id": 10195, "verse_number": "९-२०-३०", "content_sanskrit": "तस्य पुत्रशतं त्वासीद् वृष्णिज्येष्ठं यतः कुलम्।\nमाधवा वृष्णयो राजन् यादवाश्चेति सञ्ज्ञितम्॥ ९/२०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.031.m4a", "display_order": 32}, {"id": 6000195032, "chapter_id": 10195, "verse_number": "९-२०-३१", "content_sanskrit": "यदुपुत्रस्य च क्रोष्टोः पुत्रो वृजिनवांस्ततः।\nवाहितोऽतोनुशेकुर्वै तस्य चित्ररथस्ततः॥ ९/२०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.032.m4a", "display_order": 33}, {"id": 6000195033, "chapter_id": 10195, "verse_number": "९-२०-३२", "content_sanskrit": "शशबिन्दुर्महायोगी महाभोजो महानभूत्।\nचतुर्दशमहारत्नश्चक्रवर्त्यपराजितः॥ ९/२०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.033.m4a", "display_order": 34}, {"id": 6000195034, "chapter_id": 10195, "verse_number": "९-२०-३३", "content_sanskrit": "तस्य पत्नीसहस्राणां दशासन् स महायशाः।\nदशलक्षसहस्राणि पुत्राणां तास्वजीजनत्॥ ९/२०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.034.m4a", "display_order": 35}, {"id": 6000195035, "chapter_id": 10195, "verse_number": "९-२०-३४", "content_sanskrit": "तेषां तु षट्प्रधानानां पृथुश्रवस आत्मजः।\nधर्मो नामोशनास्तस्य हयमेधशतस्य राट्॥ ९/२०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.035.m4a", "display_order": 36}, {"id": 6000195036, "chapter_id": 10195, "verse_number": "९-२०-३५", "content_sanskrit": "तत्सुतो रुचकस्तस्य पञ्चासन्नात्मजाः शृणु।\nपुरुजिद्रुक्मरुक्मेषु पृथुज्यामघसञ्ज्ञिताः॥ ९/२०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.036.m4a", "display_order": 37}, {"id": 6000195037, "chapter_id": 10195, "verse_number": "९-२०-३६", "content_sanskrit": "ज्यामघस्त्वप्रजोऽप्यन्यां भार्यां शैब्यापतिर्भयात्।\nनाविन्दच्छत्रुभवनात् कन्यां भ्रष्टामहारषीत्॥ ९/२०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.037.m4a", "display_order": 38}, {"id": 6000195038, "chapter_id": 10195, "verse_number": "९-२०-३७", "content_sanskrit": "रथस्थां तां निरीक्ष्याह शैब्या पतिममर्षिता।\nकेयं कुहक मत्स्थानं रथमारोपितेति वै॥ ९/२०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.038.m4a", "display_order": 39}, {"id": 6000195039, "chapter_id": 10195, "verse_number": "९-२०-३८", "content_sanskrit": "स्नुषा तवेत्यभिहिता स्मयन्ती पतिमब्रवीत्।\nअहं वन्ध्याऽसपत्नी च स्नुषा युज्येत मे कथम्॥ ९/२०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.039.m4a", "display_order": 40}, {"id": 6000195040, "chapter_id": 10195, "verse_number": "९-२०-३९", "content_sanskrit": "जनयिष्यसि यं राज्ञि तस्येयमुपपत्स्यते।\nअन्वमोदन्त तद् विश्वेदेवाः पितर एव च॥ ९/२०/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.040.m4a", "display_order": 41}, {"id": 6000195041, "chapter_id": 10195, "verse_number": "९-२०-४०", "content_sanskrit": "शैब्या गर्भमधात् काले कुमारं सुषुवे शुभम्।\nस विदर्भ इति प्रोक्त उपयेमे स्नुषां सतीम्॥ ९/२०/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_020/BhP_09.020.041.m4a", "display_order": 42}, {"id": 6000195042, "chapter_id": 10195, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे विंशाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]