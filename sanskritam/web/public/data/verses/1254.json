[{"id": 2012423, "chapter_id": 1254, "verse_number": "१-२५५-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012424, "chapter_id": 1254, "verse_number": "१-२५५-१", "content_sanskrit": "किमर्थं शार्ङ्गकानग्निर्न ददाह तथा गते।\nतस्मिन्वने दह्यमाने ब्रह्मन्नेतत्प्रचक्ष्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012425, "chapter_id": 1254, "verse_number": "१-२५५-२", "content_sanskrit": "अदाहे ह्यश्वसेनस्य दानवस्य मयस्य च।\nकारणं कीर्तितं ब्रह्मञ्शार्ङ्गकाणां न कीर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012426, "chapter_id": 1254, "verse_number": "१-२५५-३", "content_sanskrit": "तदेतदद्भुतं ब्रह्मञ्शार्ङ्गकाणामनामयम्।\nकीर्तयस्वाग्निसंमर्दे कथं ते न विनाशिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012427, "chapter_id": 1254, "verse_number": "१-२५५-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012428, "chapter_id": 1254, "verse_number": "१-२५५-४", "content_sanskrit": "यदर्थं शार्ङ्गकानग्निर्न ददाह तथा गते।\nतत्ते सर्वं प्रवक्ष्यामि यथा भूतमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012429, "chapter_id": 1254, "verse_number": "१-२५५-५", "content_sanskrit": "धर्मज्ञानां मुख्यतमस्तपस्वी संशितव्रतः।\nआसीन्महर्षिः श्रुतवान्मन्दपाल इति श्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012430, "chapter_id": 1254, "verse_number": "१-२५५-६", "content_sanskrit": "स मार्गमाश्रितो राजन्नृषीणामूर्ध्वरेतसाम्।\nस्वाध्यायवान्धर्मरतस्तपस्वी विजितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012431, "chapter_id": 1254, "verse_number": "१-२५५-७", "content_sanskrit": "स गत्वा तपसः पारं देहमुत्सृज्य भारत।\nजगाम पितृलोकाय न लेभे तत्र तत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012432, "chapter_id": 1254, "verse_number": "१-२५५-८", "content_sanskrit": "स लोकानफलान्दृष्ट्वा तपसा निर्जितानपि।\nपप्रच्छ धर्मराजस्य समीपस्थान्दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012433, "chapter_id": 1254, "verse_number": "१-२५५-९x", "content_sanskrit": "मन्दपाल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012434, "chapter_id": 1254, "verse_number": "१-२५५-९", "content_sanskrit": "किमर्थमावृता लोका ममैते तपसाऽर्जिताः।\nकिं मया न कृतं तत्र यस्यैतत्कर्मणः फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012435, "chapter_id": 1254, "verse_number": "१-२५५-१०", "content_sanskrit": "तत्राहं तत्करिष्यामि यदर्थमिदमावृतम्।\nफलमेतस्य तपसः कथयध्वं दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012436, "chapter_id": 1254, "verse_number": "१-२५५-११x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012437, "chapter_id": 1254, "verse_number": "१-२५५-११", "content_sanskrit": "ऋणिनो मानवा ब्रह्मञ्जायन्ते येन तच्छृणु।\nक्रियाभिर्ब्रह्मचर्येण प्रजया च न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012438, "chapter_id": 1254, "verse_number": "१-२५५-१२", "content_sanskrit": "तदपाक्रियते सर्वं यज्ञेन तपसा सुतैः।\nतपस्वी यज्ञकृच्चासि न च ते विद्यते प्रजा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012439, "chapter_id": 1254, "verse_number": "१-२५५-१३", "content_sanskrit": "त इमे प्रसवस्यार्थे तव लोकाः समावृताः।\nप्रजायस्व ततो लोकानुपभोक्ष्यसि पुष्कलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012440, "chapter_id": 1254, "verse_number": "१-२५५-१४", "content_sanskrit": "पुन्नाम्नो नरकात्पुत्रस्त्रायते पितरं श्रुतिः।\nतस्मादपत्यसन्ताने यतस्व ब्रह्मसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012441, "chapter_id": 1254, "verse_number": "१-२५५-१५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012442, "chapter_id": 1254, "verse_number": "१-२५५-१५", "content_sanskrit": "तच्छ्रुत्वा मन्दपालस्तु वचस्तेषां दिवौकसाम्।\nक्व नु शीघ्रमपत्यं स्याद्बहुलं चेत्यचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012443, "chapter_id": 1254, "verse_number": "१-२५५-१६", "content_sanskrit": "स चिन्तयन्नभ्यगच्छत्सुबहुप्रसवान्खगान्।\nशार्ङ्गिकां शार्ङ्गको भूत्वा जरितां समुपेयिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012444, "chapter_id": 1254, "verse_number": "१-२५५-१७", "content_sanskrit": "तस्यां पुत्रानजनयच्चतुरो ब्रह्मवादिनः।\nतानपास्य स तत्रैव जगाम लपितां प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012445, "chapter_id": 1254, "verse_number": "१-२५५-१८", "content_sanskrit": "बालान्स तानण्डगतान्सह मात्रा मुनिर्वने।\nतस्मिन्गते महाभागे लपितां प्रति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012446, "chapter_id": 1254, "verse_number": "१-२५५-१९", "content_sanskrit": "अपत्यस्नेहसंयुक्ता जरिता बह्वचिन्तयत्।\nतेन त्यक्तानसंत्याज्यानृषीनण्डगतान्वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012447, "chapter_id": 1254, "verse_number": "१-२५५-२०", "content_sanskrit": "न जहौ पुत्रशोकार्ता जरिता खाण्डवे सुतान्।\nबभार चैतान्संजातान्स्ववृत्त्या स्नेहविक्लवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012448, "chapter_id": 1254, "verse_number": "१-२५५-२१", "content_sanskrit": "ततोऽग्निं खाण्डवं दग्धुमायान्तं दृष्टवानृषिः।\nमन्दपालश्चरंस्तस्मिन्वने लपितया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2012449, "chapter_id": 1254, "verse_number": "१-२५५-२२", "content_sanskrit": "तं संकल्पं विदित्वाग्नेर्ज्ञात्वा पुत्रांश्च बालकान्।\nसोऽभितुष्टाव विप्रर्षिब्रार्ह्मणो जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2012450, "chapter_id": 1254, "verse_number": "१-२५५-२३", "content_sanskrit": "पुत्रान्प्रतिवदन्भीतो लोकपालं महौजसम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2012451, "chapter_id": 1254, "verse_number": "१-२५५-२३x", "content_sanskrit": "मन्दपाल उवाच।\nत्वमग्ने सर्वलोकानां मुखं त्वमसि हव्यवाट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2012452, "chapter_id": 1254, "verse_number": "१-२५५-२४", "content_sanskrit": "त्वमन्तः सर्वभूतानां गूढश्चरसि पावक।\nत्वामेकमाहुः कवयस्त्वामाहुस्त्रिविधं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2012453, "chapter_id": 1254, "verse_number": "१-२५५-२५", "content_sanskrit": "त्वामष्टधा कल्पयित्वा यज्ञवाहमकल्पयन्।\nत्वया विश्वमिदं सृष्टं वदन्ति परमर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2012454, "chapter_id": 1254, "verse_number": "१-२५५-२६", "content_sanskrit": "त्वदृते हि जगत्कृत्स्नं सद्यो नश्येद्धुताशन।\nतुभ्यं कृत्वा नमो विप्राः स्वकर्मविजितां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2012455, "chapter_id": 1254, "verse_number": "१-२५५-२७", "content_sanskrit": "गच्छन्ति सह पत्नीभिः सुतैरपि च शाश्वतीम्।\nत्वामग्ने जलदानाहुः खेविषक्तान्सविद्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2012456, "chapter_id": 1254, "verse_number": "१-२५५-२८", "content_sanskrit": "दहन्ति सर्वभूतानि त्वत्तो निष्क्रम्य हेतयः।\nजातवेदस्त्वयैवेदं विश्वं सृष्टं महाद्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2012457, "chapter_id": 1254, "verse_number": "१-२५५-२९", "content_sanskrit": "तवैव कर्मविहितं भूतं सर्वं चराचरम्।\nत्वयापो विहिताः पूर्वं त्वयि सर्वमिदं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2012458, "chapter_id": 1254, "verse_number": "१-२५५-३०", "content_sanskrit": "त्वयि हव्यं च कव्यं च यथावत्संप्रतिष्ठितम्।\nत्वमेव दहनो देव त्वं धाता त्वं बृहस्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2012459, "chapter_id": 1254, "verse_number": "१-२५५-३१", "content_sanskrit": "त्वमश्विनौ यमौ मित्रः सोमस्त्वमसि चानिलः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2012460, "chapter_id": 1254, "verse_number": "१-२५५-३१x", "content_sanskrit": "वैशम्पायन उवाच।\nएवं स्तुतस्तदा तेन मन्दपालेन पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2012461, "chapter_id": 1254, "verse_number": "१-२५५-३२", "content_sanskrit": "तुतोष तस्य नृपते मुनेरमिततेजसः।\nउवाच चैनं प्रीतात्मा किमिष्टं करवाणि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2012462, "chapter_id": 1254, "verse_number": "१-२५५-३३", "content_sanskrit": "तमब्रवीन्मन्दपालः प्राञ्जलिर्हव्यवाहनम्।\nप्रदहन्खाण्डवं दावं मम पुत्रान्विसर्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2012463, "chapter_id": 1254, "verse_number": "१-२५५-३४", "content_sanskrit": "तथेति तत्प्रतिश्रुत्य भगवान्हव्यवाहनः।\nखाण्डवे तेन काले न प्रजज्वाल दिदक्षया॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2012464, "chapter_id": 1254, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि मयदर्शनपर्वणि पञ्चपञ्चाशदधिकद्विशततमोऽध्यायः॥ २५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]