[{"id": 2198287, "chapter_id": 5216, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2198288, "chapter_id": 5216, "verse_number": "१", "content_sanskrit": "अपूर्वं वा भवेत् पात्रमथ वापि चिरोषितम् ।\nदूरादभ्यागतं वापि किं पात्रं स्यात् पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2198289, "chapter_id": 5216, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2198290, "chapter_id": 5216, "verse_number": "२", "content_sanskrit": "क्रिया भवति केषाञ्चिदुपांशुव्रतमुत्तमम् ।\nयो यो याचेत यत् किञ्चित् सर्वं दद्याम इत्युत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2198291, "chapter_id": 5216, "verse_number": "३", "content_sanskrit": "अपीडयन् भृत्यवर्गमित्येवमनुशुश्रुम ।\nपीडयन् भृत्यवर्गं हि आत्मानमपकर्षति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2198292, "chapter_id": 5216, "verse_number": "४", "content_sanskrit": "अपूर्वं वापि यत् पात्रं यच्चापि स्याच्चिरोषितम् ।\nदूरादभ्यागतं चापि तत् पात्रं च विदुर्बुधाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2198293, "chapter_id": 5216, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2198294, "chapter_id": 5216, "verse_number": "५", "content_sanskrit": "अपीडया च भृत्यानां धर्मस्याहिंसया तथा ।\nपात्रं विद्याम तत्त्वेन यस्मै दत्तं न सन्तपेत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2198295, "chapter_id": 5216, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2198296, "chapter_id": 5216, "verse_number": "६", "content_sanskrit": "ऋत्विक्पुरोहिताचार्याः शिष्याः सम्बन्धिबान्धवाः ।\nसर्वे पूज्याश्च मान्याश्च श्रुतवृत्तोपसंहिताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2198297, "chapter_id": 5216, "verse_number": "७", "content_sanskrit": "अतोऽन्यथा वर्तमानाः सर्वे नार्हन्ति सत्क्रियाम् ।\nतस्मान्नित्यं परीक्षेत पुरुषान् प्रणिधाय वै\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2198298, "chapter_id": 5216, "verse_number": "८", "content_sanskrit": "अक्रोधः सत्यवचनमहिंसा दम आर्जवम् ।\nअद्रोहो नातिमानश्च ह्रीस्तितिक्षा तपः शमः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2198299, "chapter_id": 5216, "verse_number": "९", "content_sanskrit": "यस्मिन्नेतानि दृश्यन्ते न चाकार्याणि भारत ।\nभावतो स्वनिविष्टानि तत्पात्रं मानमर्हति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2198300, "chapter_id": 5216, "verse_number": "१०", "content_sanskrit": "तथा चिरोषितं चापि सम्प्रत्यागतमेव च ।\nअपूर्वं चैव पूर्वं च तत्पात्रं मानमर्हति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2198301, "chapter_id": 5216, "verse_number": "११", "content_sanskrit": "अप्रामाण्यं च वेदानां शास्त्राणां चातिलङ्घनम् ।\nसर्वत्र चानवस्थानमेतन्नाशनमात्मनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2198302, "chapter_id": 5216, "verse_number": "१२", "content_sanskrit": "भवेत् पण्डितमानी यो ब्राह्मणो वेदनिन्दकः ।\nआन्वीक्षिकीं तर्कविद्यामनुरक्तो निरर्थिकाम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2198303, "chapter_id": 5216, "verse_number": "१३", "content_sanskrit": "हेतुवादान् ब्रुवन् सत्सु विजेता हेतुवादिकः ।\nआक्रोष्टा चातिवक्ता च ब्राह्मणानां सदैव हि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2198304, "chapter_id": 5216, "verse_number": "१४", "content_sanskrit": "सर्वाभिशङ्की मूढश्च बालः कटुकवागपि ।\nबोद्धव्यस्तादृशस्तात नरश्वानं हि तं विदुः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2198305, "chapter_id": 5216, "verse_number": "१५", "content_sanskrit": "यथा श्वा भषितुं चैव हन्तुं चैवावसृज्यते ।\nएवं सम्भाषणार्थाय सर्वशास्त्रवधाय च ।\nअल्पश्रुताः कुतर्काश्च दृष्टाः सृष्टाः कुपण्डिताः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2198306, "chapter_id": 5216, "verse_number": "१६", "content_sanskrit": "विद्यातपोभ्यां हीनेन न तु ग्राह्यः प्रतिग्रहः ।\nगृह्णन् प्रतिग्रहमधो नयत्यात्मानमेव च \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2198307, "chapter_id": 5216, "verse_number": "१७", "content_sanskrit": "प्रतिग्रहसमर्थोऽपि नादत्ते यः प्रतिग्रहम् ।\nये लोका दानशीलानां स तानाप्नोति पुष्कळान् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2198308, "chapter_id": 5216, "verse_number": "१८", "content_sanskrit": "श्रुतिस्मृतीतिहासादिपुराणारण्यवेदिनः ।\nअनुरुन्ध्याद् बहुज्ञांश्च सारज्ञांश्चैव पण्डितान्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2198309, "chapter_id": 5216, "verse_number": "१९", "content_sanskrit": "लोकयात्रा च द्रष्टव्या धर्मश्चात्महितानि च ।\nएवं नरो वर्तमानः शाश्वतीरेधते समाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2198310, "chapter_id": 5216, "verse_number": "२०", "content_sanskrit": "ऋणमुन्मुच्य देवानामृषीणां च तथैव च ।\nपितॄणामथ विप्राणामतिथीनां च पञ्चमम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2198311, "chapter_id": 5216, "verse_number": "२१", "content_sanskrit": "पर्यायेण विशुद्धेन सुनिर्णिक्तेन कर्मणा ।\nएवं गृहस्थः कर्माणि कुर्वन् धर्मान्न हीयते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2198312, "chapter_id": 5216, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे ब्राह्मणप्रशंसायां पात्रपरीक्षानाम सप्तषष्टितमोऽध्यायः ॥६७॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]