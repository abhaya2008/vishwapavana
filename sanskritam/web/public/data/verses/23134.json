[{"id": 7003134000, "chapter_id": 23134, "verse_number": "४-७०-१", "content_sanskrit": "अथ सप्ततितमोऽध्यायः ।\nनारायण उवाच ।\nअथाक्रूरः स्वशरणं गत्वा कंसेन प्रेषितः ।\nचकार शयनं तल्पे भुक्त्वा मीष्टान्नमुत्तमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003134001, "chapter_id": 23134, "verse_number": "४-७०-२", "content_sanskrit": "सकर्पूरं च ताम्बूलं चखाद वासितं जलम् ।\nजगाम निद्रां सुखतः सुखसंभोगमात्रतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003134002, "chapter_id": 23134, "verse_number": "४-७०-३", "content_sanskrit": "ततो ददर्श सुस्वप्नं पुराणश्रुतिसंमतम् ।\nनिशावशेषसमये बाधादिपरिवर्जितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003134003, "chapter_id": 23134, "verse_number": "४-७०-४", "content_sanskrit": "अरोगी बद्धकेशश्च वस्त्रयुग्मसमन्वितः ।\nसुतल्पशायी सुस्निग्धश्चिन्ताशोकविवर्जितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003134004, "chapter_id": 23134, "verse_number": "४-७०-५", "content_sanskrit": "किशोरवयसं श्यामं द्विभुजं मुरलीधरम् ।\nपीतवस्त्रपरीधानं वनमालाविभूषितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003134005, "chapter_id": 23134, "verse_number": "४-७०-६", "content_sanskrit": "चन्दनोक्षितसर्वाङ्गं मालतीमाल्यशोभितम् ।\nभूषितं भूषणार्हं च सद्रत्नमणिभूषणैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003134006, "chapter_id": 23134, "verse_number": "४-७०-७", "content_sanskrit": "मयूरपिच्छचूडं च सस्मितं पद्मलोचनम् ।\nएवंभूतं द्विचशिशुं ददर्श प्रथमं मुने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003134007, "chapter_id": 23134, "verse_number": "४-७०-८", "content_sanskrit": "ततो ददर्श रुचिरां पतिपुत्रवतीं सतीम् ।\nपीतवस्त्रपरीधानां रत्नभूषणभूषिताम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003134008, "chapter_id": 23134, "verse_number": "४-७०-९", "content_sanskrit": "ज्वलत्प्रदीपहस्तां च शुक्लधान्यकरां वराम् ।\nशरच्चन्द्रनिभास्यां च सस्मितां वरदां शुभाम ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003134009, "chapter_id": 23134, "verse_number": "४-७०-१०", "content_sanskrit": "ततो ददर्श विप्रं च प्रकुर्वन्तं शुभाशिषम् ।\nश्वेतपद्मगतं हंसं तुरगं च सरोवरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003134010, "chapter_id": 23134, "verse_number": "४-७०-११", "content_sanskrit": "ददर्श चित्रितं चारु फलितं पुष्पितं शुभम् ।\nआम्रनिम्बनारिकेलगुर्वर्ककदलीतरुम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003134011, "chapter_id": 23134, "verse_number": "४-७०-१२", "content_sanskrit": "दशन्तं श्वेतसर्पं च स्वात्मानं पर्वतस्थितम् ।\nवृक्षस्थं च गजस्थं च तरिस्थं तुरगस्थितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003134012, "chapter_id": 23134, "verse_number": "४-७०-१३", "content_sanskrit": "वीणां वादितवन्तं च भुक्तवन्तं च पायसम् ।\nदधिक्षीरयुतान्नं च पद्मपत्रस्थमीप्सितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003134013, "chapter_id": 23134, "verse_number": "४-७०-१४", "content_sanskrit": "कृमिविट्सहिताङ्गं च रुदन्तं मोहितं तदा ।\nशुक्लधान्यपुष्पकरं क्षणं चन्दनचर्चितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003134014, "chapter_id": 23134, "verse_number": "४-७०-१५", "content_sanskrit": "प्रासादस्थं समुद्रस्थमात्मानं च सलोहितम् ।\nछिन्नभिन्नं क्षताङ्गं च मेदपूयसमन्वितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003134015, "chapter_id": 23134, "verse_number": "४-७०-१६", "content_sanskrit": "ततो ददर्श रजतं मणिं शुभ्रं च काञ्चनम् ।\nसुक्तामाणिक्यरत्नं च पूर्णकुम्भजलं शुभम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003134016, "chapter_id": 23134, "verse_number": "४-७०-१७", "content_sanskrit": "सुरभिं च सवत्सां च वृषभेन्द्रं मयूरकम् ।\nशुकं च सारसं हंसं चिल्लं खञ्जनमेव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003134017, "chapter_id": 23134, "verse_number": "४-७०-१८", "content_sanskrit": "ताम्बूलं पुष्पमाल्यं च ज्वलदग्निं सुरार्चनम् ।\nपार्वतीप्रतिमां कृष्णप्रतिमां शिवलिङ्गकम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003134018, "chapter_id": 23134, "verse_number": "४-७०-१९", "content_sanskrit": "विप्रबालां च बालं च सुपक्वफलितां कृषिम् ।\nदेवस्थलीं च राजेन्द्रं सिंहं व्याघ्रं गुरुं सुरम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003134019, "chapter_id": 23134, "verse_number": "४-७०-२०", "content_sanskrit": "दृष्ट्वा स्वप्नं समुत्तस्थौ चकाराऽऽह्निकमीप्सितम् ।\nउद्धवं कथयामास सर्वं वृत्तान्तमेव च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003134020, "chapter_id": 23134, "verse_number": "४-७०-२१", "content_sanskrit": "उद्धवाज्ञां समादाय कृत्वा गुरुसुरार्चनम् ।\nयात्रां चकार श्रीकृष्णं ध्यात्वा मनसि नारद ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003134021, "chapter_id": 23134, "verse_number": "४-७०-२२", "content_sanskrit": "ददर्श वर्त्मन्येवं च मङ्गलार्हं शुभप्रदम् ।\nवाञ्छाफलप्रदं रम्यं पुरो मङ्गलसूचकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003134022, "chapter_id": 23134, "verse_number": "४-७०-२३", "content_sanskrit": "वामे शैवं शिवां पूर्णकुम्भं नकुलचाषकम् ।\nपतिपुत्रवतीं साध्वीं दिव्याभरणभूषिताम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003134023, "chapter_id": 23134, "verse_number": "४-७०-२४", "content_sanskrit": "शुक्लपुष्पं च माल्यं च धान्यं च खञ्जनं शुभम् ।\nदक्षिणे ज्वलदग्रिं च विप्रं च वृषभं गजम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003134024, "chapter_id": 23134, "verse_number": "४-७०-२५", "content_sanskrit": "वत्सप्रयुक्तां धेरुं च श्वेताश्वं राजहंसकम् ।\nवेश्यां च पुष्पमालां च पताकां दधि पायसम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003134025, "chapter_id": 23134, "verse_number": "४-७०-२६", "content_sanskrit": "मणिं सुवर्ण रचतं मुक्तामाणिक्यमीप्सितम् ।\nमद्यं मांकं चन्दनं च माध्वीकं घृतमुत्तमम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003134026, "chapter_id": 23134, "verse_number": "४-७०-२७", "content_sanskrit": "कृष्णशारं फलं लाजाः सिद्धान्नं दर्पणं तथा ।\nविचित्रितं विमानं च सुदीप्तां प्रतिमां तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003134027, "chapter_id": 23134, "verse_number": "४-७०-२८", "content_sanskrit": "शुक्लोत्पलं पद्मवनं शङ्खचिल्लं च कीरकम् ।\nमार्जारं पर्वतं मेघं मयूरं शुकसारसम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003134028, "chapter_id": 23134, "verse_number": "४-७०-२९", "content_sanskrit": "शङ्खकोकिलवाद्यानां ध्वनिं शुश्राव मङ्गलम् ।\nविचित्रकृष्णसंगीतं हरिशब्दं जयध्वनिम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003134029, "chapter_id": 23134, "verse_number": "४-७०-३०", "content_sanskrit": "एवंभूतं शुभं दृष्टवा श्रुत्वा प्रहृष्टमानसः ।\nप्रविवेश हरिं स्मृत्वा पुण्यं वृन्दावनं वनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003134030, "chapter_id": 23134, "verse_number": "४-७०-३१", "content_sanskrit": "ददर्श पुरतो रम्यं रासमण्डलमीप्सितम् ।\nचन्दनागुरुकस्तूरीपुष्पचन्दनवायुना ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003134031, "chapter_id": 23134, "verse_number": "४-७०-३२", "content_sanskrit": "वासितं मङ्गलघटै रम्भास्तमभैर्विराजितम् ।\nआम्रपल्लवसंघैश्च पट्टसूत्रविचित्रितैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003134032, "chapter_id": 23134, "verse_number": "४-७०-३३", "content_sanskrit": "शोभितैः परितः शश्वत्पद्मरागविनिर्मितम् ।\nशोभितं शोभनार्हं च त्रिकोटिरत्नमन्दिरैः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003134033, "chapter_id": 23134, "verse_number": "४-७०-३४", "content_sanskrit": "रम्यैः कुञ्जकुटीरैश्च राजितं शतकोटिभिः ।\nरासं वृन्दावनं दृष्ट्वा कियद्दूरं ययौ च सः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003134034, "chapter_id": 23134, "verse_number": "४-७०-३५", "content_sanskrit": "ददर्श पुरतो रम्यं नन्दव्रजमनुत्तमम् ।\nपरं वेकुण्ठसंकाशं वैकुण्ठ निलयं शुभम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003134035, "chapter_id": 23134, "verse_number": "४-७०-३६", "content_sanskrit": "रत्नसोपानसंयुक्तं रत्नस्तम्भैर्विराजितम् ।\nनानाचित्रविचित्राढ्यं सद्रत्नवलयान्वितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003134036, "chapter_id": 23134, "verse_number": "४-७०-३७", "content_sanskrit": "खचितं मणिसारेण रचितं विश्वकर्मणा ।\nद्वारि दृष्टेन मार्गेण राजद्वारं विवेश सः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003134037, "chapter_id": 23134, "verse_number": "४-७०-३८", "content_sanskrit": "पताकारत्नजालाढ्यं सुक्तामाणिक्यभूषितम् ।\nरत्नदर्पणशोभाढ्यं रत्नचित्रविचित्रितम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003134038, "chapter_id": 23134, "verse_number": "४-७०-३९", "content_sanskrit": "रत्नविथीविरचितं मङ्गलं मङ्गरैर्घटैः ।\nअक्रूरागमनं श्रुत्वा साङ्लादो नन्द एव च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003134039, "chapter_id": 23134, "verse_number": "४-७०-४०", "content_sanskrit": "सहितो रामकृष्णाभ्यां जगामानुव्रजाय वै ।\nवृषभान्वादिभिर्युक्तः कृत्वा वेश्यां पुरःसरम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003134040, "chapter_id": 23134, "verse_number": "४-७०-४१", "content_sanskrit": "पूर्णकुम्भं गजेन्द्रं च कृत्वाऽग्रे शुक्लधान्यकम् ।\nकृष्णां गां मधुपर्कं च पाद्यं रत्नासनादिकम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003134041, "chapter_id": 23134, "verse_number": "४-७०-४२", "content_sanskrit": "गृहीत्वा सादरः शान्तः सस्मितो विनतस्था ।\nआनन्दयुक्तो नन्दश्च सगणः सहबालकः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003134042, "chapter_id": 23134, "verse_number": "४-७०-४३", "content_sanskrit": "दृष्ट्वाऽक्रूरं महाभागं तूर्णमालिङ्गनं ददौ ।\nप्रणेमुः शिरमा सर्वै गोपा जगृहुराशिषम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003134043, "chapter_id": 23134, "verse_number": "४-७०-४४", "content_sanskrit": "परस्परं च संयोगो बभूव गुणत्रान्मुने ।\nक्रोडे चकाराक्रूरश्च कृष्णं रामं क्रमेण च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003134044, "chapter_id": 23134, "verse_number": "४-७०-४५", "content_sanskrit": "चुचुम्ब गण्डयुगुले पुलकाञ्यितविग्रहः ।\nसाश्रुनेत्रोऽतिसाह्लादः कृतार्थः सिद्धवाञ्छितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003134045, "chapter_id": 23134, "verse_number": "४-७०-४६", "content_sanskrit": "ददर्श कृष्णं द्विभुजं क्षणं श्यामलसुन्दरम् ।\nपीतवस्त्रपरीधानं मालतीमाल्यभूषितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003134046, "chapter_id": 23134, "verse_number": "४-७०-४७", "content_sanskrit": "चन्दनोक्षितसर्वाङ्गं परं वंशीधरं वरम् ।\nस्तुतं ब्रह्मेशशेषाद्यैर्मुनीन्द्रैः सनकादिभिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003134047, "chapter_id": 23134, "verse_number": "४-७०-४८", "content_sanskrit": "वीक्षितं गोपकन्याभिः परिबूर्णतमं विभुम् ।\nक्षणं ददर्श क्रोडस्थं सस्मितं च चतुर्भुजम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003134048, "chapter_id": 23134, "verse_number": "४-७०-४९", "content_sanskrit": "लक्ष्मींसरस्वतीयुक्तं वनमालाविभूषितम् ।\nसुनन्दनन्दकुमुदैः पार्षदैः परिसेवितम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003134049, "chapter_id": 23134, "verse_number": "४-७०-५०", "content_sanskrit": "सेवितं सिद्धसंघैश्च भक्तिनम्रैः परात्परम् ।\nक्षणं ददर्श देवं तं पञ्चवक्त्रं त्रिलोचनम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003134050, "chapter_id": 23134, "verse_number": "४-७०-५१", "content_sanskrit": "शुद्धस्फटिकसंकाशं नागराजैर्विराजितम् ।\nदिगम्बरं परं ब्रह्म भस्माङ्गं च जटायुतम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003134051, "chapter_id": 23134, "verse_number": "४-७०-५२", "content_sanskrit": "जपमालाकरं ध्याननिष्ठं श्रेष्ठं च योगिनम् ।\nक्षणं चतुर्मुखं ध्याननिष्ठं श्रेष्ठं मनीषिणाम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003134052, "chapter_id": 23134, "verse_number": "४-७०-५३", "content_sanskrit": "क्षणं धर्मस्वरूपं च शेषरुपं क्षणं क्षणम् ।\nक्षणं भास्कररूपं च ज्योतीरूपं सनातनम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003134053, "chapter_id": 23134, "verse_number": "४-७०-५४", "content_sanskrit": "क्षणं परमशोभाढ्यं कोटिकन्दर्पनिन्दितम् ।\nकामिनीकमनीयं च कामुकं कामसंयुतम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003134054, "chapter_id": 23134, "verse_number": "४-७०-५५", "content_sanskrit": "एवंभूतं शिशुं दृष्ट्वा स्थापयामास वक्षसि ।\nरत्नमिंहासने रम्ये नन्ददत्ते च नारद ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003134055, "chapter_id": 23134, "verse_number": "४-७०-५६", "content_sanskrit": "कृत्वा प्रदक्षिणं भक्त्या पुलकाञ्चितविग्रहः ।\nप्रणम्य शिरसा भूमौ तुष्टाव पुरुषोत्तमम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003134056, "chapter_id": 23134, "verse_number": "४-७०-५७", "content_sanskrit": "अक्रूर उवाच ।\nनमः कारणरूपाय परमात्मस्वरूपिणे ।\nसर्वेषामपि विश्वानामीश्वराय नमो नमः ।\nपराय प्रकृतेरीश परात्परतराय च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003134057, "chapter_id": 23134, "verse_number": "४-७०-५८", "content_sanskrit": "निर्गुणाय निरीहाय नीरूपाय स्वरूपिणे ।\nसर्वदेवस्वरूपाय सर्वदेवेश्वराय च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003134058, "chapter_id": 23134, "verse_number": "४-७०-५९", "content_sanskrit": "सर्वदेवाधिदेवाय विश्वादिभूतरूपिणे ।\nअसंश्येषु च विश्वेषु ब्रह्मविष्णुशिवात्मक ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003134059, "chapter_id": 23134, "verse_number": "४-७०-६०", "content_sanskrit": "स्वरूपायाऽऽदिबीजाय तदीशविश्वरूपिणे ।\nनमो गोपाङ्गनेशाय गणेशेश्वररूपिणे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003134060, "chapter_id": 23134, "verse_number": "४-७०-६१", "content_sanskrit": "नमः सुरगणेशाय राधेशाय नमो नमः ।\nराधारमणरूपाय राधारूपधराय च ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003134061, "chapter_id": 23134, "verse_number": "४-७०-६२", "content_sanskrit": "राधाराध्याय राधायाः प्राणाधिकतराय च ।\nराधासाध्याय राधाधिदेवप्रियतमाय च ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003134062, "chapter_id": 23134, "verse_number": "४-७०-६३", "content_sanskrit": "राधाप्राणाधिदेवाय विश्वरूपाय ते नमः ।\nवेदस्तुतात्मवेदज्ञरूपिणे सर्ववेदिने ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003134063, "chapter_id": 23134, "verse_number": "४-७०-६४", "content_sanskrit": "वैदाधिष्ठातृदेवाय वेदबीजाय ते नमः ।\nयस्य लोमसु विश्वानि चासंख्यानि च नित्यशः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003134064, "chapter_id": 23134, "verse_number": "४-७०-६५", "content_sanskrit": "महद्विष्णोरीश्वराय विश्वेशाय नमो नमः ।\nस्वयं प्रकृतिरूपाय प्राकृताय नमो ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003134065, "chapter_id": 23134, "verse_number": "४-७०-६६", "content_sanskrit": "प्रकृतीश्वररूपाय प्रधानपुरूषाय च ।\nइत्येवं स्तवनं कृत्वा मूर्च्छामाप सभातले ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003134066, "chapter_id": 23134, "verse_number": "४-७०-६७", "content_sanskrit": "पपात सहसा भूमौ पुनरीशं ददर्श सः ।\nबहिःस्थं हृदयस्थं च परमात्मानमीश्वरम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003134067, "chapter_id": 23134, "verse_number": "४-७०-६८", "content_sanskrit": "परितः श्यामरूपं च विश्वस्थं विश्वमेव च ।\nअक्रूरं मूर्च्छितं दृष्ट्वा नन्दः सादरपूर्वकम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003134068, "chapter_id": 23134, "verse_number": "४-७०-६९", "content_sanskrit": "रत्नसिंहासने रम्ये वासयामास नारद ।\nपप्रच्छ सर्ववृत्तान्तं किंस्विद्दृष्टमिति त्वया ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003134069, "chapter_id": 23134, "verse_number": "४-७०-७०", "content_sanskrit": "मिष्टान्नं भोजयामाय कुशलं च पुनः पुनः ।\nअक्रूरेः कथयामस कंसवृत्तान्तमीप्सितम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003134070, "chapter_id": 23134, "verse_number": "४-७०-७१", "content_sanskrit": "स्वपित्रोर्मोक्षणार्थं च गमनं रामकृष्णयोः ।\nइत्यक्रूरकृतं स्तोत्रं यः पठेत्सुसमाहितः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003134071, "chapter_id": 23134, "verse_number": "४-७०-७२", "content_sanskrit": "अपुत्रो लभते पुत्रमभार्यों लभते प्रियम् ।\nअधनो धनमाप्नोति निर्भूमिरुर्वरां महीम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003134072, "chapter_id": 23134, "verse_number": "४-७०-७३", "content_sanskrit": "हतप्रजः प्रजालाभं प्रतिष्ठां चाप्रतिष्ठितः ।\nयशः प्राप्नोति विपुलमयशस्वी च लीलया ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003134073, "chapter_id": 23134, "verse_number": "४-७०-७४", "content_sanskrit": "अथ सुष्वाप समये परं संहृष्टमानसः ।\nरम्ये चम्पकतल्पे च कृष्णं कृत्वा स्ववक्षसि ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003134074, "chapter_id": 23134, "verse_number": "४-७०-७५", "content_sanskrit": "प्रातरुथाय सहसा कृत्वाऽऽङ्निकमनुत्तमम् ।\nस्वरथे स्थापयामास रामं कृष्णं जगत्पतिम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003134075, "chapter_id": 23134, "verse_number": "४-७०-७६", "content_sanskrit": "गव्यं पञ्चप्रकारं च नानाद्रव्यं सुदुल्रभम् ।\nवृषभानं च नन्दं च सुनन्दं चन्दभानकम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003134076, "chapter_id": 23134, "verse_number": "४-७०-७७", "content_sanskrit": "नानाप्रकारं वाद्यं च मृदङ्गमुरजादिकम् ।\nपटहं पणवं चैव ढक्कां दुंदुभिमानकम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003134077, "chapter_id": 23134, "verse_number": "४-७०-७८", "content_sanskrit": "सज्जां संनहनीं कास्यपट्टमर्दलमण्डवीम् ।\nवादयामास सानन्दं नन्दगोपो व्रजेश्वरः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003134078, "chapter_id": 23134, "verse_number": "४-७०-७९", "content_sanskrit": "श्रुत्वा वाद्यं च गोप्यश्च गमनं रामकृष्णयोः ।\nदृष्ट्वा कृष्णं रथस्थं तमाययुः कोपपीडिताः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003134079, "chapter_id": 23134, "verse_number": "४-७०-८०", "content_sanskrit": "कृष्णेन वारिताः सर्वाः प्रेरिता राधाया द्विजः ।\nबभञ्जुरीश्वररथं पादाघातेन लीलया ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003134080, "chapter_id": 23134, "verse_number": "४-७०-८१", "content_sanskrit": "तत्र सर्वेषु गोपेश हाहाकारं कृतेषु च ।\nप्रययुर्बलवत्यश्च कृष्णं कृत्वा स्ववक्षसि ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003134081, "chapter_id": 23134, "verse_number": "४-७०-८२", "content_sanskrit": "काचित्क्रूरं तमक्रूरं भर्त्सयामास कोपतः ।\nकाश्चिद्वद्ध्वा च वस्त्रेण चाकूरं प्रययुस्ततः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003134082, "chapter_id": 23134, "verse_number": "४-७०-८३", "content_sanskrit": "काचित्तं ताडयामास कङ्कणेन करेण च ।\nतद्वस्त्रं हारयामास कृत्वा विवसनं मुने ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003134083, "chapter_id": 23134, "verse_number": "४-७०-८४", "content_sanskrit": "क्षतविक्षतसर्वाङ्गं दृष्ट्वाऽक्रूरं च माधवः ।\nजगाम राधानिकटं बोधयामास तां पुनः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003134084, "chapter_id": 23134, "verse_number": "४-७०-८५", "content_sanskrit": "आध्यात्मिकेन योगेन विनयेन च सादरम् ।\nअक्रूरं बोधयामास वोधयामास तां पुनः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003134085, "chapter_id": 23134, "verse_number": "४-७०-८६", "content_sanskrit": "आकाशात्पतितं दिव्यं सन्त्रप्रस्थापितं रथम् ।\nविचित्रवस्त्रसंयुक्तं ददर्श पुरतो हरिः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003134086, "chapter_id": 23134, "verse_number": "४-७०-८७", "content_sanskrit": "खचितं मणिराजेन रचितं विश्वकर्मणा ।\nतं दृष्ट्वा मातृभवनमाजगाम जगत्पतिः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003134087, "chapter_id": 23134, "verse_number": "४-७०-८८", "content_sanskrit": "भुक्त्वा पीत्वा सुखं सुप्त्वा भगवान्सहबान्धवः ।\nतस्थौ मुनीन्द्रदेवेन्द्रब्रह्मेशशेषवन्दितः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003134088, "chapter_id": 23134, "verse_number": "४-७०-८९", "content_sanskrit": "मुषुपुर्गोंपिकाः सर्वाः परं संहृष्टमानसाः ।\nपुष्पतल्पे च रम्ये च राधया सह नारद ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003134089, "chapter_id": 23134, "verse_number": "४-७०-९०", "content_sanskrit": "सर्वे चाऽऽनन्दयुक्ताश्च जना गोकुलवासिनः ।\nकेचिद्गोपाश्च ननृतुः केचित्संगीततत्पराः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]