[{"id": 6000276000, "chapter_id": 10276, "verse_number": null, "content_sanskrit": "अथ अशीतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000276001, "chapter_id": 10276, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.001.m4a", "display_order": 2}, {"id": 6000276002, "chapter_id": 10276, "verse_number": "१०-८०-१", "content_sanskrit": "अथोषस्युपवृत्तायां कुक्कुटान् कूजतोऽशपन्।\nगृहीतकण्ठ्यः पतिभिर्माधव्यो विरहातुराः॥ १०/८०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.002.m4a", "display_order": 3, "topics": [{"text": "कृष्णस्य ब्राह्मे मुहूर्ते ध्यानादि,सभाप्रवेशो, मन्त्रणं, रथेन बहिर्यानमित्यादि नित्यविधिः", "range": "१–२१"}]}, {"id": 6000276003, "chapter_id": 10276, "verse_number": "१०-८०-२", "content_sanskrit": "वयांस्यरूरुवन् कृष्णं बोधयन्तीव वन्दिनः।\nगायत्स्वलिष्वदभ्रेषु मन्दारवनवायुभिः॥ १०/८०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.003.m4a", "display_order": 4}, {"id": 6000276004, "chapter_id": 10276, "verse_number": "१०-८०-३", "content_sanskrit": "मुहूर्तं तं तु वैदर्भी नामृष्यदपि शोभनम्।\nपरिरम्भणविश्लेषात् प्रियबाह्वन्तरं गता॥ १०/८०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.004.m4a", "display_order": 5}, {"id": 6000276005, "chapter_id": 10276, "verse_number": "१०-८०-४", "content_sanskrit": "ब्राह्मे मुहूर्त उत्थाय वार्युपस्पृश्य माधवः।\nदध्यौ प्रसन्नकरणः स्वात्मानं तमसः परम्॥ १०/८०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.005.m4a", "display_order": 6}, {"id": 6000276006, "chapter_id": 10276, "verse_number": "१०-८०-५", "content_sanskrit": "एक परंज्योतिरनन्यमद्वयं स्वसंस्थया नित्यनिरस्तकल्मषम्।\nब्रह्माख्यमस्योद्भवनादिहेतुभिः स्वलक्षणैर्लक्षितभावनिर्वृतिम्॥ १०/८०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.006.m4a", "display_order": 7}, {"id": 6000276007, "chapter_id": 10276, "verse_number": "१०-८०-६", "content_sanskrit": "अथाप्लुतोऽम्भस्यमले यथाविधि क्रियाकलापं परिधाय वाससी।\nचकार सन्ध्योपगमादि सत्तमो हुतानलो ब्रह्म जजाप वाग्यतः॥ १०/८०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.007.m4a", "display_order": 8}, {"id": 6000276008, "chapter_id": 10276, "verse_number": "१०-८०-७", "content_sanskrit": "उपस्थायार्कमुद्यन्तं तर्पयित्वाऽऽत्मनः कलाः।\nदेवान् ऋषीन् पितॄन्वृद्धान्विप्रानभ्यर्च्य चात्मवान्॥ १०/८०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.008.m4a", "display_order": 9}, {"id": 6000276009, "chapter_id": 10276, "verse_number": "१०-८०-८", "content_sanskrit": "धेनूनां रुग्मशृङ्गीणां साध्वीनां मौक्तिकस्रजाम्।\nपयस्विनीनां गृष्टीनां सवत्सानां सुवाससाम्॥ १०/८०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.009.m4a", "display_order": 10}, {"id": 6000276010, "chapter_id": 10276, "verse_number": "१०-८०-९", "content_sanskrit": "ददौ रौप्यखुराग्राणां क्षौमाजिनतिलैः सह।\nअलङ्कृतेभ्यो विप्रेभ्यो बद्वं बद्वं दिनेदिने॥ १०/८०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.010.m4a", "display_order": 11}, {"id": 6000276011, "chapter_id": 10276, "verse_number": "१०-८०-१०", "content_sanskrit": "गोविप्रदेवतावृद्धान् गुरुभूतानि सर्वशः।\nनमस्कृत्वाऽऽत्मसम्भूतिं मङ्गलानि समस्पृशत्॥ १०/८०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.011.m4a", "display_order": 12}, {"id": 6000276012, "chapter_id": 10276, "verse_number": "१०-८०-११", "content_sanskrit": "आत्मानं भूषयामास नरलोकविभूषणम्।\nवासोभिर्भूषणैः स्वीयैर्दिव्यस्रगनुलेपनैः॥ १०/८०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.012.m4a", "display_order": 13}, {"id": 6000276013, "chapter_id": 10276, "verse_number": "१०-८०-१२", "content_sanskrit": "अवेक्ष्याज्यं तथाऽऽदर्शं गोवृषद्विजदेवताः। कामिनां सर्ववर्णानां पौरान्तःपुरचारिणाम्।\nप्रादात् कामान् पृथक् कामैः प्रतोष्य प्रत्यनन्दत॥ १०/८०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.013.m4a", "display_order": 14}, {"id": 6000276014, "chapter_id": 10276, "verse_number": "१०-८०-१३", "content_sanskrit": "संविभज्याग्रतो विप्रान् स्रक्ताम्बूलानुलेपनैः।\nसुहृदः प्रकृतीर्दारान् प्रायुङ्क्त च ततः स्वयम्॥ १०/८०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.014.m4a", "display_order": 15}, {"id": 6000276015, "chapter_id": 10276, "verse_number": "१०-८०-१४", "content_sanskrit": "तावत् सूत उपानीय स्यन्दनं परमाद्भुतम्।\nसुग्रीवाद्यैर्हयैर्युक्तं प्रणम्यावस्थितोऽग्रतः॥ १०/८०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.015.m4a", "display_order": 16}, {"id": 6000276016, "chapter_id": 10276, "verse_number": "१०-८०-१५", "content_sanskrit": "गृहीत्वा पाणिना पाणिं सारथे रथमारुहत्।\nसात्यक्युद्धवसंयुक्तः पूर्वाद्रिमिव भास्करः॥ १०/८०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.016.m4a", "display_order": 17}, {"id": 6000276017, "chapter_id": 10276, "verse_number": "१०-८०-१६", "content_sanskrit": "ईक्षितोऽन्तःपुरस्‍त्रीणां सव्रीडप्रेमवीक्षितैः।\nकृच्छ्राद् विसृष्टो निरगाज्जातहासो हरन् मनः॥ १०/८०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.017.m4a", "display_order": 18}, {"id": 6000276018, "chapter_id": 10276, "verse_number": "१०-८०-१७", "content_sanskrit": "सुधर्माख्यां सभां सर्वैर्वृष्णिभिः परिवारितः।\nप्राविशद् यन्निविष्टानां न सन्त्यङ्ग षडूर्मयः॥ १०/८०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.018.m4a", "display_order": 19}, {"id": 6000276019, "chapter_id": 10276, "verse_number": "१०-८०-१८", "content_sanskrit": "तत्रोपविष्टः परमासने विभुर्बभौ स्वभासा ककुभोऽवभासयन्।\nवृतो नृसिंहैर्यदुभिर्यदूत्तमो यथोडुराजो दिवि तारकागणैः॥ १०/८०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.019.m4a", "display_order": 20}, {"id": 6000276020, "chapter_id": 10276, "verse_number": "१०-८०-१९", "content_sanskrit": "तत्राथ मन्त्रिणो राजन् नानाहास्यरसैर्विभुम्।\nउपतस्थुर्नटाचार्या नर्तक्यस्ताण्डवैः समम्॥ १०/८०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.020.m4a", "display_order": 21}, {"id": 6000276021, "chapter_id": 10276, "verse_number": "१०-८०-२०", "content_sanskrit": "मृदङ्गवीणामुरजवेणुतालदरस्वनैः।\nननृतुर्जगुस्तुष्टुवुश्च सूतमागधवन्दिनः॥ १०/८०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.021.m4a", "display_order": 22}, {"id": 6000276022, "chapter_id": 10276, "verse_number": "१०-८०-२१", "content_sanskrit": "तत्रस्था ब्राह्मणाः केचिदासीना ब्रह्मवादिनः।\nपूर्वेषां पुण्ययशसां राज्ञां चाकथयन् कथाः॥ १०/८०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.022.m4a", "display_order": 23}, {"id": 6000276023, "chapter_id": 10276, "verse_number": "१०-८०-२२", "content_sanskrit": "तत्रैकः पुरुषो राजन्नागतोऽपूर्वदर्शनः।\nविज्ञापितो भगवते प्रतीहारैः प्रवेशितः॥ १०/८०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.023.m4a", "display_order": 24, "topics": [{"text": "जरासन्धावरुद्धनृपाणां स्वमोक्षाय दूतप्रेषणम्", "range": "२२–३१"}]}, {"id": 6000276024, "chapter_id": 10276, "verse_number": "१०-८०-२३", "content_sanskrit": "स नमस्कृत्य कृष्णाय परेशाय कृताञ्जलिः।\nराज्ञामावेदयद् दुःखं जरासन्धोपरोधजम्॥ १०/८०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.024.m4a", "display_order": 25}, {"id": 6000276025, "chapter_id": 10276, "verse_number": "१०-८०-२४", "content_sanskrit": "ये तु दिग्विजये तस्य सन्नतिं नाययुर्नृपाः।\nप्रसह्य रुद्धास्तेनासन्नयुते द्वे गिरिव्रजे॥ १०/८०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.025.m4a", "display_order": 26}, {"id": 6000276026, "chapter_id": 10276, "verse_number": null, "content_sanskrit": "राज्ञां सन्देशः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.026.m4a", "display_order": 27}, {"id": 6000276027, "chapter_id": 10276, "verse_number": "१०-८०-२५", "content_sanskrit": "कृष्ण कृष्णाप्रमेयात्मन् प्रपन्नभयभञ्जन।\nवयं त्वां शरणं यामो भवभीताः पृथग्धियः॥ १०/८०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.027.m4a", "display_order": 28}, {"id": 6000276028, "chapter_id": 10276, "verse_number": "१०-८०-२६", "content_sanskrit": "लोको विकर्मनिरतः कुशले प्रमत्तः कर्मण्ययं त्वदुदिते भवदर्चने स्वे।\nयस्तावदस्य बलवानिह जीविताशां सद्यश्छिनत्त्यनिमिषाय नमोऽस्तु तस्मै॥ १०/८०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.028.m4a", "display_order": 29}, {"id": 6000276029, "chapter_id": 10276, "verse_number": "१०-८०-२७", "content_sanskrit": "कालो भवान् जगदिदं कलयाऽवतीर्णः सद्रक्षणाय खलनिग्रहणाय चान्यत्।\nकश्चित् त्वदीयमतियाति निदेशमीश किं वा जनः सुकृतमृच्छति तन्न विद्मः॥ १०/८०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.029.m4a", "display_order": 30}, {"id": 6000276030, "chapter_id": 10276, "verse_number": "१०-८०-२८", "content_sanskrit": "स्वप्नायितं नृपसुखं परतन्त्रमीश शश्वद्भयेन मृतकेन धुरं वहामः।\nहित्वा यदात्मनि सुखं तदनीहलभ्यं क्लिश्यामहेऽतिकृपणास्तव माययेति॥ १०/८०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.030.m4a", "display_order": 31}, {"id": 6000276031, "chapter_id": 10276, "verse_number": "१०-८०-२९", "content_sanskrit": "तन्नो भवान् प्रणतशोकहराङ्घ्रियुग्मो रुद्धान् वियुङ्क्ष्व मगधाधिपकर्मपाशात्।\nयो भूभुजोऽयुतमतङ्गजवीर्यमेको बिभ्रद् रुरोध भवने मृगराडिवावीः॥ १०/८०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.031.m4a", "display_order": 32}, {"id": 6000276032, "chapter_id": 10276, "verse_number": "१०-८०-३०", "content_sanskrit": "यो वै त्वया द्विनवकृत्व उदात्तचक्रो भग्नो मृधे खलु भवन्तमनन्तवीर्यम्।\nजित्वा नृलोकनिरतं स तु रूढदर्पो युष्मत्प्रजाः क्षिपति चाशु च तद्विधेहि॥ १०/८०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.032.m4a", "display_order": 33}, {"id": 6000276033, "chapter_id": 10276, "verse_number": "१०-८०-३१", "content_sanskrit": "इति मागधसंरुद्धा भवद्दर्शनकाङ्क्षिणः।\nप्रपन्नाः पादमूलं ते दीनानां शं विधीयताम्॥ १०/८०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.033.m4a", "display_order": 34}, {"id": 6000276034, "chapter_id": 10276, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.034.m4a", "display_order": 35}, {"id": 6000276035, "chapter_id": 10276, "verse_number": "१०-८०-३२", "content_sanskrit": "राजदूते ब्रुवत्येवं देवर्षिः परमद्युतिः।\nबिभ्रत् पिङ्गजटाभारं प्रादुरासीद् यथा रविः॥ १०/८०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.035.m4a", "display_order": 36, "topics": [{"text": "धर्मराजस्य राजसूयसङ्कल्पोक्तिश्च", "range": "३२–४५"}]}, {"id": 6000276036, "chapter_id": 10276, "verse_number": "१०-८०-३३", "content_sanskrit": "गायन् गिरा मधुरया प्रियकर्माणि जन्म च।\nद्रावयन्नघसङ्घांश्च लोकान्निरमयन् भृशम्॥ १०/८०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.036.m4a", "display_order": 37}, {"id": 6000276037, "chapter_id": 10276, "verse_number": "१०-८०-३४", "content_sanskrit": "तं दृष्ट्वा भगवान् कृष्णः सर्वलोकेश्वरेश्वरः।\nववन्द उत्थितः शीर्ष्णा ससभ्यः सानुगो मुदा॥ १०/८०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.037.m4a", "display_order": 38}, {"id": 6000276038, "chapter_id": 10276, "verse_number": "१०-८०-३५", "content_sanskrit": "सभाजयित्वा विधिवत् कृतासनपरिग्रहम्।\nबभाषे सूनृतैर्वाक्यैः श्रद्धया तर्पयन् मुनिम्॥ १०/८०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.038.m4a", "display_order": 39}, {"id": 6000276039, "chapter_id": 10276, "verse_number": "१०-८०-३६", "content_sanskrit": "अपिस्विदद्य लोकानां त्रयाणामकुतोभयम्।\nननु भूयान् भगवतो लोकान् पर्यटतो गुणः॥ १०/८०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.039.m4a", "display_order": 40}, {"id": 6000276040, "chapter_id": 10276, "verse_number": "१०-८०-३७", "content_sanskrit": "न हि तेऽविदितं किञ्चित् लोकेष्वीश्वरकर्तृषु।\nअथ पृच्छामहे युष्मान् पाण्डवानां चिकीर्षितम्॥ १०/८०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.040.m4a", "display_order": 41}, {"id": 6000276041, "chapter_id": 10276, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.041.m4a", "display_order": 42}, {"id": 6000276042, "chapter_id": 10276, "verse_number": "१०-८०-३८", "content_sanskrit": "दृष्टा मया ते बहुशो दुरत्यया माया विभो विश्वसृजश्च मायिनः।\nभूतेषु भूमन् चरतः स्वशक्तिभिर्वह्नेरिव च्छन्नरुचो रुचोऽद्भुताः॥ १०/८०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.042.m4a", "display_order": 43}, {"id": 6000276043, "chapter_id": 10276, "verse_number": "१०-८०-३९", "content_sanskrit": "तवेहितं कोऽर्हति साधु वेदितुं स्वमाययेदं सृजतो नियच्छतः।\nयोऽविद्ययाऽनात्मतयाऽवसीयते तस्मै नमस्ते स्वविलक्षणात्मने॥ १०/८०/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.043.m4a", "display_order": 44}, {"id": 6000276044, "chapter_id": 10276, "verse_number": "१०-८०-४०", "content_sanskrit": "जीवस्य यत् संसरतो विमोक्षणं न जायतेऽनर्थवहाच्छरीरतः।\nलीलावतारैः स्वयशःप्रदीपकं प्रज्वालयेस्त्वं तमहं प्रपद्ये॥ १०/८०/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.044.m4a", "display_order": 45}, {"id": 6000276045, "chapter_id": 10276, "verse_number": "१०-८०-४१", "content_sanskrit": "अथाप्याश्रावये ब्रह्मन् नरदेवविडम्बितम्।\nराज्ञः पैतृष्वसेयस्य भक्तस्य च चिकीर्षितम्॥ १०/८०/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.045.m4a", "display_order": 46}, {"id": 6000276046, "chapter_id": 10276, "verse_number": "१०-८०-४२", "content_sanskrit": "यक्ष्यति त्वां मखेन्द्रेण राजसूयेन पाण्डवः।\nनृपतिः पारमेष्ठ्येन तद् भवाननुमोदताम्॥ १०/८०/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.046.m4a", "display_order": 47}, {"id": 6000276047, "chapter_id": 10276, "verse_number": "१०-८०-४३", "content_sanskrit": "तस्मिन् देव क्रतुवरे भवन्तं वै सुरादयः।\nदिदृक्षवः समेष्यन्ति राजानश्च यशस्विनः॥ १०/८०/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.047.m4a", "display_order": 48}, {"id": 6000276048, "chapter_id": 10276, "verse_number": "१०-८०-४४", "content_sanskrit": "श्रवणात् कीर्तनाद् ध्यानात् पूयन्तेऽन्त्यावसायिनः।\nतव ब्रह्ममयस्येश किमुतेक्षाभिमर्शिनः॥ १०/८०/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.048.m4a", "display_order": 49}, {"id": 6000276049, "chapter_id": 10276, "verse_number": "१०-८०-४५", "content_sanskrit": "यस्यामलं दिवि यशः प्रथितं रसायां भूमौ च तेऽमलयशोऽथ दिशां वितानम्।\nमन्दाकिनी च तव पादरजोवहोर्मिः श्रीमत्पदास्पदगताऽथ पुनाति विश्वम्॥ १०/८०/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_080/BhP_10.080.049.m4a", "display_order": 50}, {"id": 6000276050, "chapter_id": 10276, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धेऽशीतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]