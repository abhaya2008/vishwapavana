[{"id": 7003811000, "chapter_id": 23811, "verse_number": "२-३-६-१", "content_sanskrit": "स्कंद उवाच ।\nकराद्विगलितं यत्र कपालं ते महेश्वर ।\nतस्य तीर्थस्य माहात्म्यं कृपया वद मे पितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003811001, "chapter_id": 23811, "verse_number": "२-३-६-२", "content_sanskrit": "शिव उवाच ।\nअतिगुह्यमिदं तीर्थं सुरासुरनमस्कृतम् ।\nब्रह्महाऽपि नरो यत्र स्नानमात्रेण शुद्ध्यति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003811002, "chapter_id": 23811, "verse_number": "२-३-६-३", "content_sanskrit": "पंच तीर्थानि तिष्ठंति कपाले पापमोचने ।\nतत्र स्नानं तपो दानं सर्वमक्षयमिष्यते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003811003, "chapter_id": 23811, "verse_number": "२-३-६-४", "content_sanskrit": "पिंडं विधाय विधिवन्नरकात्तारयेत्पितॄन् ।\nपितृतीर्थमिदं प्रोक्तं गयातोऽष्टगुणाधिकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003811004, "chapter_id": 23811, "verse_number": "२-३-६-५", "content_sanskrit": "तिलतर्प्पणतो यांति पितरः स्वर्गमुत्तमम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003811005, "chapter_id": 23811, "verse_number": "२-३-६-६", "content_sanskrit": "अहोरात्रं स्थिरो भूत्वा जपनिष्ठः समाहितः ।\nतस्येष्टसिद्धिर्महती तत्क्षणादेव जायते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003811006, "chapter_id": 23811, "verse_number": "२-३-६-७", "content_sanskrit": "पारलौकिककर्माणि सर्वाण्यव्याहतानि च ।\nकपालमोचने तीर्थे नाधिकं पितृकर्मणि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003811007, "chapter_id": 23811, "verse_number": "२-३-६-८", "content_sanskrit": "स्कंद उवाच ।\nकुत्र वा ब्रह्मतीर्थं वै फलं वा कीदृशं भवेत् ।\nके वा तत्र वसंतीह कृपया वद मे पितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003811008, "chapter_id": 23811, "verse_number": "२-३-६-९", "content_sanskrit": "शिव उवाच ।\nएकदा विष्णुनाभ्यम्भोरुहस्थस्य प्रजापतेः ।\nवेदान्मुखांबुजाद्धृत्वा जग्मतुर्मधुकैटभौ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003811009, "chapter_id": 23811, "verse_number": "२-३-६-१०", "content_sanskrit": "ततो ह्युत्थाय शयनात्सिसृक्षुरब्जसंभवः ।\nस्रष्टुं विनाऽगमं लोके न शशाक हृतस्मृतिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003811010, "chapter_id": 23811, "verse_number": "२-३-६-११", "content_sanskrit": "तदा बदरिकामेत्य हरिणा प्रतिपालिताम् ।\nतुष्टाव प्रणतो भूत्वा भगवंतं सनातनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003811011, "chapter_id": 23811, "verse_number": "२-३-६-१२", "content_sanskrit": "ततः कुंडात्समुद्भूतो हयशीर्षो निजायुधः ।\nपीतांबरधरः शुक्लश्चतुर्बाहुः सुदृप्तदृक् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003811012, "chapter_id": 23811, "verse_number": "२-३-६-१३", "content_sanskrit": "अत्यद्भुतः प्रकटकठोरलोचनश्चलच्छटाविच्छुरितमेघडंबरः ।\nस्वतेजसा हतनिखिलप्रभाकुलः कृपान्वितो द्रुहिणपुरःसरोऽभवत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003811013, "chapter_id": 23811, "verse_number": "२-३-६-१४", "content_sanskrit": "निरीक्ष्य तं विधिरपि विस्मयाकुलः प्रणम्य च स्तुतिमकरोत्प्रसन्नदृक् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003811014, "chapter_id": 23811, "verse_number": "२-३-६-१५", "content_sanskrit": "ब्रह्मोवाच ।\nनमः कमलनाभाय नमस्ते कमलाश्रय ।\nनमस्ते कमलावासविशालवनमालिने ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003811015, "chapter_id": 23811, "verse_number": "२-३-६-१६", "content_sanskrit": "नमो विज्ञानभात्राय गुहावास निवासिने ।\nहृषीकेशाय शांताय तुभ्यं भगवते नमः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003811016, "chapter_id": 23811, "verse_number": "२-३-६-१७", "content_sanskrit": "स्वभक्तरक्षणकृते धृतदेहाय शार्ङ्गिणे ।\nअनंतक्लेशनाशाय गदिने ब्रह्मणे नमः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003811017, "chapter_id": 23811, "verse_number": "२-३-६-१८", "content_sanskrit": "संसारविविधासारनिवृत्तिकृतकर्मणे ।\nरक्षित्रे सर्वजंतूनां विष्णवे जिष्णवे नमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003811018, "chapter_id": 23811, "verse_number": "२-३-६-१९", "content_sanskrit": "नमो विश्वंभराशेषनिवृत्तगुणवृत्तये ।\nसुरासुरवरस्तंभनिवृत्तिस्थितिकीर्तये ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003811019, "chapter_id": 23811, "verse_number": "२-३-६-२०", "content_sanskrit": "इतीरितः सुरपतिना महेश्वरो हृदिस्थितोऽखिलविदशेषकर्मभिः ।\nततोऽन्तरं सपदि गतो निबध्य तौ सुरद्रुहौ किल निजघान लीलया ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003811020, "chapter_id": 23811, "verse_number": "२-३-६-२१", "content_sanskrit": "ततो निगममादाय ब्रह्मणोंऽतिकमाययौ ।\nदत्त्वा स्वनिगमं तस्मै स्वस्थोऽभूत्स समीडितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003811021, "chapter_id": 23811, "verse_number": "२-३-६-२२", "content_sanskrit": "ततः प्रभृति तत्तीर्थं ब्रह्मणा प्रकटीकृतम् ।\nब्रह्मकुंडमिति ख्यातं त्रिषु लोकेषु विश्रुतम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003811022, "chapter_id": 23811, "verse_number": "२-३-६-२३", "content_sanskrit": "यस्य दर्शनमात्रेण महापातकिनो जनाः ।\nविमुक्तकिल्बिषाः सद्यो ब्रह्मलोकं व्रजंति ते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003811023, "chapter_id": 23811, "verse_number": "२-३-६-२४", "content_sanskrit": "स्नानं कुर्वंति ये लोका व्रतचर्यामथापि वा ।\nब्रह्मलोकमतिक्रम्य विष्णुलोकं व्रजंति ते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003811024, "chapter_id": 23811, "verse_number": "२-३-६-२५", "content_sanskrit": "स्कंद उवाच ।\nततः किमकरोद्धाता लब्ध्वा वेदाञ्जनार्द्दनात् ।\nएतदन्यच्च सर्वं मे कृपया वद सांप्रतम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003811025, "chapter_id": 23811, "verse_number": "२-३-६-२६", "content_sanskrit": "महादेव उवाच ।\nचतुर्णामपि वेदानां दृष्ट्वा बदरिकाश्रमम् ।\nमतिर्न जायते गंतुं ब्रह्मणा सह पुत्रक ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003811026, "chapter_id": 23811, "verse_number": "२-३-६-२७", "content_sanskrit": "ततस्तु विकलं दृष्ट्वा ब्रह्माणं जनवासिनः ।\nसिद्धास्तु विधिवत्स्तुत्वा प्रणिपत्येदमब्रुवन् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003811027, "chapter_id": 23811, "verse_number": "२-३-६-२८", "content_sanskrit": "सिद्धा ऊचुः ।\nआज्ञा भगवतः कार्या सर्वैः स्थावरजंगमैः ।\nभगवान्सर्वजंतूनां कर्त्ता हर्ता पिता गुरुः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003811028, "chapter_id": 23811, "verse_number": "२-३-६-२९", "content_sanskrit": "स्थितिर्ब्रह्मांतिके वश्च हरिणैवानुकल्पिता ।\nनिवृत्तिर्वर्तते चैषा तथाप्येतन्निरामयम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003811029, "chapter_id": 23811, "verse_number": "२-३-६-३०", "content_sanskrit": "एकांते द्रवरूपेण मूर्तिर्वोऽत्रावतिष्ठताम् ।\nद्वितीया ब्रह्मणा सार्द्धं ब्रह्मलोकं व्रजेत्पुनः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003811030, "chapter_id": 23811, "verse_number": "२-३-६-३१", "content_sanskrit": "ततः सहृदया वेदा द्वैधीकृतात्मरूपकाः ।\nब्रह्मणा ब्रह्मलोकं ते ययुः सार्द्धं प्रहर्षिताः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003811031, "chapter_id": 23811, "verse_number": "२-३-६-३२", "content_sanskrit": "ततस्त्रिलोकं विधिवत्ससर्ज चतुराननः ।\nद्रवरूपेषु वेदेषु स्नानदानतपःक्रियाः ।\nकृता विच्छेदिता न स्युर्यावदाभूतसंप्लवम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003811032, "chapter_id": 23811, "verse_number": "२-३-६-३३", "content_sanskrit": "फलमुद्दिश्य कुर्वंति उपवासत्रयं नराः ।\nचतुर्णामपि वेदानां व्याख्यातारो न संशयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003811033, "chapter_id": 23811, "verse_number": "२-३-६-३४", "content_sanskrit": "अनुक्रमेण तिष्ठंति वेदाश्चत्वार एव च ।\nऋग्यजुःसामाथर्वाख्या भगवत्पार्श्ववर्तिनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003811034, "chapter_id": 23811, "verse_number": "२-३-६-३५", "content_sanskrit": "ये पुण्यवंतोऽकलुषा वेदवेदांगपारगाः ।\nते वेदघोषं विरलाः शृण्वंत्यपि कलौ युगे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003811035, "chapter_id": 23811, "verse_number": "२-३-६-३६", "content_sanskrit": "चतुर्णामपि वेदानामुदगस्ति सरस्वती ।\nजप्ताथ सा नृणां हंति जडतां जलरूपिणी ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003811036, "chapter_id": 23811, "verse_number": "२-३-६-३७", "content_sanskrit": "सरस्वत्या जले स्थित्वा जपं कृत्वा समाहितः ।\nमनोस्तस्य न विच्छेदः कदाचिदपि जायते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003811037, "chapter_id": 23811, "verse_number": "२-३-६-३८", "content_sanskrit": "वेदव्यासोऽपि भगवान्यत्प्रसादादुदारधीः ।\nपुराणसंहितार्थज्ञोऽभवदत्र न संशयः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003811038, "chapter_id": 23811, "verse_number": "२-३-६-३९", "content_sanskrit": "त्रयाणामपि लोकानां हिताय जगतां पतिः ।\nस्थापयामास विधिना वाणीं वाग्विभवप्रदाम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003811039, "chapter_id": 23811, "verse_number": "२-३-६-४०", "content_sanskrit": "दर्शनस्पर्शनस्नानपूजास्तुत्यभिवन्दनैः ।\nसरस्वत्या न विच्छेदः कुले तस्य कदाचन ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003811040, "chapter_id": 23811, "verse_number": "२-३-६-४१", "content_sanskrit": "मन्त्रसिद्धिर्विशेषेण सरस्वत्यास्तटे नृणाम् ।\nजपतामचिरणैव जायते नात्र संशयः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003811041, "chapter_id": 23811, "verse_number": "२-३-६-४२", "content_sanskrit": "बहुना किमिहोक्तेन वाणी वाग्विभवप्रदा ।\nद्रवरूपधरा नृणां दर्शनात्पूतिरुज्ज्वला ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003811042, "chapter_id": 23811, "verse_number": "२-३-६-४३", "content_sanskrit": "ततोऽर्वाग्दक्षिणे भागे द्रवधारेति विश्रुतम् ।\nतीर्थमिंद्रपदं यत्र तपश्चक्रे पुरंदरः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003811043, "chapter_id": 23811, "verse_number": "२-३-६-४४", "content_sanskrit": "सुदारुणं तपः कृत्वा परितोष्य जनार्द्दनम् ।\nपदमैंद्रं समालेभे सुरासुरनमस्कृतम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003811044, "chapter_id": 23811, "verse_number": "२-३-६-४५", "content_sanskrit": "तपो दानं जपो होमो व्रतानि नियमा यमाः ।\nतत्रानन्तगुणं प्रोक्तं तत्तीर्थमतिदुर्लभम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003811045, "chapter_id": 23811, "verse_number": "२-३-६-४६", "content_sanskrit": "प्रतिमासे त्रयोदश्यां शुक्लायां हरितोषणे ।\nस्नात्वा सुतीर्थे सुत्रामाच्छन्दं चोपेत्य संगतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003811046, "chapter_id": 23811, "verse_number": "२-३-६-४७", "content_sanskrit": "उपवासद्वयं कृत्वा पूजयित्वा जनार्द्दनम् ।\nसर्वपापविनिर्मुक्तः शक्रलोके महीयते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003811047, "chapter_id": 23811, "verse_number": "२-३-६-४८", "content_sanskrit": "तत्रैव मानसोद्भेदः सर्वपापप्रणाशनः ।\nदुर्लभः सर्वजंतूनां यत्र ते स्युर्महर्षयः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003811048, "chapter_id": 23811, "verse_number": "२-३-६-४९", "content_sanskrit": "मानसं चिदचिद्ग्रन्थिमुद्ग्रथ्नंति च सर्वतः ।\nमानसोद्भेव इत्याख्या ऋषिभिः परिगीयते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003811049, "chapter_id": 23811, "verse_number": "२-३-६-५०", "content_sanskrit": "भिंदंति हृदयग्रंथीश्छिंदन्ति बहुसंशयम् ।\nकर्माणि क्षपयन्त्यस्मान्मानसोद्भेद इत्यभूत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003811050, "chapter_id": 23811, "verse_number": "२-३-६-५१", "content_sanskrit": "यदि भाग्यवशादत्र बिंदुमात्रं लभेन्नरः ।\nतत्क्षणान्मुक्तिमाप्नोति किमतस्त्वधिकं भवेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003811051, "chapter_id": 23811, "verse_number": "२-३-६-५२", "content_sanskrit": "गिरिदरीनिलये निवसत्यमी ऋषिगणाः फलमूलजलाशनाः ।\nजितमनोविषयाः शितबुद्धयः कलिभयादिव पापभयाकुलाः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003811052, "chapter_id": 23811, "verse_number": "२-३-६-५३", "content_sanskrit": "फलसमीरणगह्वरनिर्झराश्रमभरादुपलब्धपटोत्तमाः ।\nत्रिषवणक्रमनिर्जितदुर्जयेन्द्रियपराक्रमणा मुनयस्त्वमी ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003811053, "chapter_id": 23811, "verse_number": "२-३-६-५४", "content_sanskrit": "साधनानि बहून्येव कायक्लेशकराण्यहो ।\nसुलभं साधनं लोके मानसोद्भेददर्शनम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003811054, "chapter_id": 23811, "verse_number": "२-३-६-५५", "content_sanskrit": "यस्मिन्दिने जलं चैतल्लभते पुण्यवाञ्जनः ।\nभवति व्याससदृशो यमपितृसमः क्रमात् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003811055, "chapter_id": 23811, "verse_number": "२-३-६-५६", "content_sanskrit": "काम्यतीर्थमिदं नॄणां कामनावशकृत्पुनः ।\nअकामतस्तु मुक्तिः स्यादुभयोरेष निश्चयः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003811056, "chapter_id": 23811, "verse_number": "२-३-६-५७", "content_sanskrit": "यदि कश्चित्प्रमादेन कामनां कुरुते नरः ।\nफलं भुक्त्वा पुनर्मुक्तिर्भवत्येव न संशयः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003811057, "chapter_id": 23811, "verse_number": "२-३-६-५८", "content_sanskrit": "महरादिषु लोकेषु भुक्त्वा भोगान्यथेप्सितान् ।\nभोगे भुक्ते पुनर्याति कामनावशतो जनः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003811058, "chapter_id": 23811, "verse_number": "२-३-६-५९", "content_sanskrit": "पुरुषार्थसमावाप्त्यै यतनीयं मनीषिभिः ।\nमानसोद्भेदने तीर्थे नापेत्यत्रेति मे मतिः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003811059, "chapter_id": 23811, "verse_number": "२-३-६-६०", "content_sanskrit": "मानसोद्भेदनात्प्रत्यग्दिशि सर्वमनोहरम् ।\nवसुधारेति विख्यातं तीर्थं त्रैलोक्यदुर्लभम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003811060, "chapter_id": 23811, "verse_number": "२-३-६-६१", "content_sanskrit": "त्रिलोक्यां सर्वतीर्थेभ्यः श्रेष्ठो बदरिकाश्रमः ।\nश्रुत्वा तन्नारदात्सर्वे वसवः समुपागताः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003811061, "chapter_id": 23811, "verse_number": "२-३-६-६२", "content_sanskrit": "त्रिंशद्वर्षसहस्राणि तपः परमदारुणम् ।\nदलांबुप्राशनाश्चक्रुस्ततः सिद्धिमुपाययुः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003811062, "chapter_id": 23811, "verse_number": "२-३-६-६३", "content_sanskrit": "भगवद्दर्शनात्प्राप्तानंदनिर्वृत्तविक्लमाः ।\nहृदयानन्दसंदोहप्रफुल्लितमुखांबुजाः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003811063, "chapter_id": 23811, "verse_number": "२-३-६-६४", "content_sanskrit": "दृष्ट्वा नारायणं देवं वरं लब्ध्वा मनोरमम् ।\nहरिभक्तिसुखैश्वर्य्यं परं लब्ध्वा मुदं ययुः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003811064, "chapter_id": 23811, "verse_number": "२-३-६-६५", "content_sanskrit": "अत्र स्नात्वा जलं पीत्वा पूजयित्वा जनार्द्दनम् ।\nइह लोके सुखं भुक्त्वा यात्यंते परमं पदम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003811065, "chapter_id": 23811, "verse_number": "२-३-६-६६", "content_sanskrit": "अत्र पुण्यवतां ज्योतिर्दृश्यते जलमध्यतः ।\nयद्दृष्ट्वा न पुनर्भूयो गर्भवासं प्रपद्यते ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003811066, "chapter_id": 23811, "verse_number": "२-३-६-६७", "content_sanskrit": "येऽशुद्धपितृजाः पापाः पाषंडमतिवृत्तयः ।\nन तेषां शिरसि प्रायः पतंत्यापः कदाचन ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003811067, "chapter_id": 23811, "verse_number": "२-३-६-६८", "content_sanskrit": "दिनत्रयं शुचिर्भूत्वा पूजयित्वा जनार्दनम् ।\nउपोष्य भगवद्भक्त्या सिद्धान्पश्यंति साधवः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003811068, "chapter_id": 23811, "verse_number": "२-३-६-६९", "content_sanskrit": "ये तत्र चपलास्तथ्यं न वदंति च लोलुपाः ।\nपरिहासपरद्रव्यपरस्त्रीकपटाग्रहाः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003811069, "chapter_id": 23811, "verse_number": "२-३-६-७०", "content_sanskrit": "मलचैलावृताऽशांताऽशुचयस्त्यक्तसत्क्रियाः ।\nतेषां मलिनचित्तानां फलमत्र न जायते ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003811070, "chapter_id": 23811, "verse_number": "२-३-६-७१", "content_sanskrit": "ये तत्र साधकाः शांता विरला विधिवर्त्मगाः ।\nतेषां जपस्तपोहोमो दानव्रतजपक्रियाः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003811071, "chapter_id": 23811, "verse_number": "२-३-६-७२", "content_sanskrit": "क्रियमाणा यथाशक्त्या ह्यक्षय्यफलदायकाः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003811072, "chapter_id": 23811, "verse_number": "२-३-६-७३", "content_sanskrit": "यत्किंचिच्छुभकर्माणि क्रियमाणानि देहिनाम् ।\nमहदादिफलं दद्युर्निःश्रेयसमनुत्तमम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003811073, "chapter_id": 23811, "verse_number": "२-३-६-७४", "content_sanskrit": "श्रावणीयमिह किं फलाधिकं यत्र यांति विबुधाः फलार्थिनः ।\nपूजितादनु हरेः प्रियार्थिनः स्वर्गमार्गनिरताः प्रमोदिनः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003811074, "chapter_id": 23811, "verse_number": "२-३-६-७५", "content_sanskrit": "यत्र संति न च विघ्नकारिणः कर्मणां हरिभयात्सुसिध्यति ।\nनिर्विशंति च फलं विवेकिनः कर्ममार्गनिरताः सुदेहिनः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003811075, "chapter_id": 23811, "verse_number": "२-३-६-७६", "content_sanskrit": "ये पठंत्यथ च पाठयंत्यहो पुण्यतीर्थविषयं प्रकाशितम् ।\nभक्तिभावसमलंकृताश्च ते संप्रयान्ति हरिमंदिरं शुभम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003811076, "chapter_id": 23811, "verse_number": "२-३-६-७७", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे बदरिकाश्रममाहात्म्ये शिवकार्त्तिकेयसंवादे वसुधारातीर्थमाहात्म्यवर्णनंनाम षष्ठोऽध्यायः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]