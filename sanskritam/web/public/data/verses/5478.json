[{"id": 2209491, "chapter_id": 5478, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209492, "chapter_id": 5478, "verse_number": "१", "content_sanskrit": "एवमुक्तस्तु कृष्णेन धर्मराजो युधिष्ठिरः ।\nव्यासमामन्त्र्य मेधावी ततो वचनमब्रवीत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209493, "chapter_id": 5478, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209494, "chapter_id": 5478, "verse_number": "२", "content_sanskrit": "यदा कालं भवान् वेत्ति हयमेधस्य तत्त्वतः ।\nदीक्षयस्व तदाऽऽत्मानं त्वदायत्तो हि मे क्रतुः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209495, "chapter_id": 5478, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209496, "chapter_id": 5478, "verse_number": "३", "content_sanskrit": "अहं पैलोऽथ कौन्तेय याज्ञवल्क्यस्तथैव च ।\nविधानं यद्यथाकालं तत् कर्तारो न संशयः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209497, "chapter_id": 5478, "verse_number": "४", "content_sanskrit": "चैत्र्यां हि पौर्णमास्यां वै तव दीक्षा भविष्यति ।\nसम्भाराः सम्भ्रियन्तां वै यज्ञार्थं पुरुषर्षभ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209498, "chapter_id": 5478, "verse_number": "५", "content_sanskrit": "अश्वविद्याविदश्चैव सूता विप्राश्च तद्विदः ।\nमेध्यमश्वं परीक्षन्तां तव यज्ञार्थसिद्धये ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209499, "chapter_id": 5478, "verse_number": "६", "content_sanskrit": "तमुत्सृज्य यथाशास्त्रं पृथिवीं सागराम्बराम् ।\nस पर्येतु यशो दीप्तं तव पार्थिव वर्धयन् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209500, "chapter_id": 5478, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209501, "chapter_id": 5478, "verse_number": "७", "content_sanskrit": "इत्युक्तः स तथेत्युक्त्वा पाण्डवः पृथिवीपतिः ।\nचकार सर्वं राजेन्द्रो यथोक्तं ब्रह्मवादिना ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209502, "chapter_id": 5478, "verse_number": "८", "content_sanskrit": "सम्भाराश्चैव राजेन्द्र सर्वे सङ्कल्पिता भवन् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209503, "chapter_id": 5478, "verse_number": "९", "content_sanskrit": "स सम्भारान् समाहृत्य नृपो धर्मात्मजस्तदा ।\nन्यवेदयदमेयात्मा कृष्णद्वैपायनाय वै ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209504, "chapter_id": 5478, "verse_number": "१०", "content_sanskrit": "ततोऽब्रवीन्महातेजा व्यासो धर्मात्मजं नृपम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209505, "chapter_id": 5478, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209506, "chapter_id": 5478, "verse_number": "११", "content_sanskrit": "यथाकालं यथायोगं सज्जाः स्म तव दीक्षणे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209507, "chapter_id": 5478, "verse_number": "१२", "content_sanskrit": "स्रुक् च कूर्चं च सौवर्णं यच्चान्यदपि कौरव ।\nयत्तु योग्यं भवेत् किञ्चित् तद्रौक्मं क्रियतामिह ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209508, "chapter_id": 5478, "verse_number": "१३", "content_sanskrit": "अश्वश्चोत्सृज्यतामद्य पृथ्व्यामथ यथाक्रमम् ।\nसुगुप्तश्च चरत्वेष यथाशास्त्रं युधिष्ठिर ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209509, "chapter_id": 5478, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209510, "chapter_id": 5478, "verse_number": "१४", "content_sanskrit": "अयमश्वो यथा ब्रह्मन्नुत्सृष्टः पृथिवीमिमाम् ।\nचरिष्यति यथाकामं तत्र सम्यग् विधीयताम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209511, "chapter_id": 5478, "verse_number": "१५", "content_sanskrit": "पृथिवीं पर्यटन्तं हि तुरगं कामचारिणम् ।\nकः पालयेदिति मुने तद्भवान् वक्तुमर्हति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209512, "chapter_id": 5478, "verse_number": "", "content_sanskrit": "वेशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209513, "chapter_id": 5478, "verse_number": "१६", "content_sanskrit": "इत्युक्तः स तु राजेन्द्र कृष्णद्वैपायनोऽब्रवीत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209514, "chapter_id": 5478, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209515, "chapter_id": 5478, "verse_number": "१७", "content_sanskrit": "भीमसेनादवरजः श्रेष्ठः सर्वधनुष्मताम् ।\nजिष्णुः सहिष्णुर्धर्मिष्णुः स एनं पालयिष्यति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209516, "chapter_id": 5478, "verse_number": "१८", "content_sanskrit": "शक्तः स हि महीं जेतुं निवातकवचान्तकः ।\nतस्मिन्नस्त्राणि दिव्यानि वर्तन्ते खलु सर्वदा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209517, "chapter_id": 5478, "verse_number": "१९", "content_sanskrit": "दिव्यं धनुश्चेषुधी च स एनमनुयास्यति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209518, "chapter_id": 5478, "verse_number": "२०", "content_sanskrit": "स हि धर्मार्थकुशलः सर्वविद्याविशारदः ।\nयथाशास्त्रं नृपश्रेष्ठ चारयिष्यति ते हयम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209519, "chapter_id": 5478, "verse_number": "२१", "content_sanskrit": "राजपुत्रो महाबाहुः श्यामो राजीवलोचनः ।\nअभिमन्योः पिता वीरः स एनमनुयास्यति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209520, "chapter_id": 5478, "verse_number": "२२", "content_sanskrit": "भीमसेनोऽपि तेजस्वी कौन्तेयोऽमितविक्रमः ।\nसमर्थो रक्षितुं राष्ट्रं नकुलश्च विशाम्पते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2209521, "chapter_id": 5478, "verse_number": "२३", "content_sanskrit": "सहदेवस्तु कौरव्य सर्वमन्यत् करिष्यति ।\nकुटुम्बतन्त्रं विधिवत् सर्वमेतन्महायशाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2209522, "chapter_id": 5478, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2209523, "chapter_id": 5478, "verse_number": "२४", "content_sanskrit": "एतत्सर्वं यथान्यायमुक्तं कुरुकुलोद्वहः ।\nचकार फल्गुनं चापि सन्दिदेश हयं प्रति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2209524, "chapter_id": 5478, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2209525, "chapter_id": 5478, "verse_number": "२५", "content_sanskrit": "एह्यर्जुन त्वया वीर हयोऽयं परिपाल्यताम् ।\nत्वमर्हो रक्षितुं ह्येनं नान्यः कश्चन मानवः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2209526, "chapter_id": 5478, "verse_number": "२६", "content_sanskrit": "ये चापि त्वां महाबाहो प्रत्युदीयुर्नराधिपाः ।\nतैर्विग्रहो यथा न स्यात् तथा कार्यं त्वयाऽनघ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2209527, "chapter_id": 5478, "verse_number": "२७", "content_sanskrit": "आख्यातव्यश्च भवता यज्ञोऽयं मम सर्वशः ।\nपार्थिवेभ्यो महाबाहो समये गम्यतामिति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2209528, "chapter_id": 5478, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2209529, "chapter_id": 5478, "verse_number": "२८", "content_sanskrit": "एवमुक्त्वा स धर्मात्मा भ्रातरं सव्यसाचिनम् ।\nभीमं च नकुलं चैव पुरगुप्तौ समादधत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2209530, "chapter_id": 5478, "verse_number": "२९", "content_sanskrit": "कुटुम्बतन्त्रे च तदा सहदेवं युधाम्पतिम् ।\nअनुमान्य महीपालं धृतराष्ट्रं युधिष्ठिरः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2209531, "chapter_id": 5478, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अश्वरक्षणसन्देशो नाम द्वासप्ततितमोऽध्यायः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]