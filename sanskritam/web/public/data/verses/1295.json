[{"id": 2014323, "chapter_id": 1295, "verse_number": "२-३६-१", "content_sanskrit": "वैशम्पायन उवाच॥\nरक्षणाद्धर्मराजस्य सत्यस्य परिपालनात्।\nशत्रूणां क्षपणाच्चैव स्वकर्मनिरताः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014324, "chapter_id": 1295, "verse_number": "२-३६-२", "content_sanskrit": "बलीनां सम्यगादानाद्धर्मतश्चानुशासनात्।\nनिकामवर्षी पर्जन्यः स्फीतो जनपदोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014325, "chapter_id": 1295, "verse_number": "२-३६-३", "content_sanskrit": "सर्वारम्भाः सुप्रवृत्ता गोरक्षा कर्षणं वणिक्।\nविशेषात्सर्वमेवैतत्सञ्जज्ञे राजकर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014326, "chapter_id": 1295, "verse_number": "२-३६-४", "content_sanskrit": "दस्युभ्यो वञ्चकेभ्यो वा राजन्प्रति परस्परम्।\nराजवल्लभतश्चैव नाश्रूयन्त मृषागिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014327, "chapter_id": 1295, "verse_number": "२-३६-५", "content_sanskrit": "अवर्षं चातिवर्षं च व्याधिपावकमूर्छनम्।\nसर्वमेतत्तदा नासीद्धर्मनित्ये युधिष्ठिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014328, "chapter_id": 1295, "verse_number": "२-३६-६", "content_sanskrit": "प्रियं कर्तुमुपस्थातुं बलिकर्म स्वभावजम्।\nअभिहर्तुं नृपा जग्मुर्नान्यैः कार्यैः कथञ्चनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014329, "chapter_id": 1295, "verse_number": "२-३६-७", "content_sanskrit": "धर्मैर्धनागमैस्तस्य ववधे निचयो महान्।\nकर्तुं यस्य न शक्येन क्षयो वर्षशतैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014330, "chapter_id": 1295, "verse_number": "२-३६-८", "content_sanskrit": "स्वकोष्ठस्य परीमाणं कोशस्य च महीपतिः।\nविज्ञाय राजा कौन्तेयो यज्ञायैव मनो दधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014331, "chapter_id": 1295, "verse_number": "२-३६-९", "content_sanskrit": "सुहृदश्चैव ये सर्वे पृथक्च सहचाब्रुवन्।\nयज्ञकालस्तव विभो क्रियतामत्र साम्प्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014332, "chapter_id": 1295, "verse_number": "२-३६-१०", "content_sanskrit": "अथैवं ब्रुवतामेव तेषामभ्याययौ हरिः।\nऋषिः पुराणो वेदात्मा दृश्यश्चैव विजानताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014333, "chapter_id": 1295, "verse_number": "२-३६-११", "content_sanskrit": "जगतस्तस्थुषां श्रेष्ठः प्रभवश्चाप्ययश्च ह।\nभूतभव्यभवन्नाथः केशवः केशिसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014334, "chapter_id": 1295, "verse_number": "२-३६-१२", "content_sanskrit": "प्राकारः सर्ववृष्णीनामापत्स्वभयदोऽरिहा।\nबलाधिकारे निक्षिप्य सम्यगानकदुन्दुभिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014335, "chapter_id": 1295, "verse_number": "२-३६-१३", "content_sanskrit": "उच्चावचमुपादाय धर्मराजाय माधवः।\nधनौघं पुरुषव्याघ्रो बलेन महता वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014336, "chapter_id": 1295, "verse_number": "२-३६-१४", "content_sanskrit": "तं धनौघमपर्यन्तं रत्नसागरमक्षयम्।\nनादयन्रथघोषेण प्रविशेश पुरोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014337, "chapter_id": 1295, "verse_number": "२-३६-१५", "content_sanskrit": "पूर्णमापूरयंस्तेषां द्विषच्छोकावहोऽभवत्।\nअसूर्यमिव सूर्येण निवातमिव वायुना।\nकृष्णेन समुपेतेन जहृषे भारतं पुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014338, "chapter_id": 1295, "verse_number": "२-३६-१६", "content_sanskrit": "तं मुदाऽभिसमागम्य सत्कृत्य च यथाविधि।\nस पृष्ट्वा कुशलं चैव सुखासीनं युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014339, "chapter_id": 1295, "verse_number": "२-३६-१७", "content_sanskrit": "धौम्यद्वैपायनमुखैर्ऋत्विग्भिः पुरुषर्षभः।\nभीमार्जुनयमैश्चैव सहितः कृष्णमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014340, "chapter_id": 1295, "verse_number": "२-३६-१८x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014341, "chapter_id": 1295, "verse_number": "२-३६-१८", "content_sanskrit": "त्वत्कृते पृथिवी सर्वा मद्वशे कृष्ण वर्तते।\nधनं च बहु वार्ष्णेय त्वत्प्रसादादुपार्जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014342, "chapter_id": 1295, "verse_number": "२-३६-१९", "content_sanskrit": "सोऽहमिच्छामि तत्सर्वं विधिवद्देवकीसुत।\nउपयोक्तुं द्विजाग्र्येभ्यो हव्यवाहे च माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014343, "chapter_id": 1295, "verse_number": "२-३६-२०", "content_sanskrit": "तदहं यष्टुमिच्छामि दाशार्ह सहितस्त्वया।\nअनुजैश्च महाबाहो तन्माऽनुज्ञातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014344, "chapter_id": 1295, "verse_number": "२-३६-२१", "content_sanskrit": "तद्दीक्षापय गोविन्द त्वमात्मानं महाभुज।\nत्वयीष्टवति दाशार्ह विपाप्मा भविता ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014345, "chapter_id": 1295, "verse_number": "२-३६-२२", "content_sanskrit": "मां वाप्यभ्यनुजानीह सहैभिरनुजैर्विभो।\nअनुज्ञातस्त्वया कृष्ण प्राप्नुयां क्रतुमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014346, "chapter_id": 1295, "verse_number": "२-३६-२३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014347, "chapter_id": 1295, "verse_number": "२-३६-२३", "content_sanskrit": "तं कृष्णःस प्रत्युवाचेदं बहूक्त्वा गुणविस्तरम्।\nत्वमेव राजशार्दूल रम्राडर्हो महाक्रतुम्।\nसम्प्राप्नुहि त्वया प्राप्ते कृतकृत्यास्ततो वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014348, "chapter_id": 1295, "verse_number": "२-३६-२४", "content_sanskrit": "यदस्वाभीप्सितं यज्ञं मयि श्रेयस्यवस्थिते।\nनियुङ्क्ष्व त्वं च मां कृत्ये सर्वं कर्तास्मि ते वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014349, "chapter_id": 1295, "verse_number": "२-३६-२५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014350, "chapter_id": 1295, "verse_number": "२-३६-२५", "content_sanskrit": "सफलः कृष्ण सङ्कल्पः सिद्धिश्च नियता मम।\nयस्यमे त्वं हृषीकेश यथेप्सितमुपस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014351, "chapter_id": 1295, "verse_number": "२-३६-२६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2014352, "chapter_id": 1295, "verse_number": "२-३६-२६", "content_sanskrit": "अनुज्ञातस्तु कृष्णेन पाण्डवो भ्रातृभिः सह।\nईजितुं राजसूयेन साधनान्युपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2014353, "chapter_id": 1295, "verse_number": "२-३६-२७", "content_sanskrit": "ततस्त्वाज्ञापयामास पाण्डवोऽरिनिबर्हणः।\nसहदेवं युधां श्रेष्ठं मन्त्रिणश्चैव सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2014354, "chapter_id": 1295, "verse_number": "२-३६-२८", "content_sanskrit": "अस्मिन्क्रतौ यथोक्तानि यज्ञाङ्गानि द्व्जातिभिः।\nयथोपकरणं सर्वं मङ्गलानि च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2014355, "chapter_id": 1295, "verse_number": "२-३६-२९", "content_sanskrit": "अधियज्ञांश्च सम्भारान्दौम्योक्तान्क्षिप्रमेव हि।\nसमानयन्तु पुरुषा यथायोगं यथाक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2014356, "chapter_id": 1295, "verse_number": "२-३६-३०", "content_sanskrit": "इन्द्रसेनो विशोकश्च पूरश्चार्जुनसारथिः।\nअन्नाद्याहरणे युक्ताः सन्तु मत्प्रियकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2014357, "chapter_id": 1295, "verse_number": "२-३६-३१", "content_sanskrit": "सर्वकामाश्च कार्यन्तां रसगन्धसमन्विताः।\nमनोरथप्रीतिकरा द्विजानां कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2014358, "chapter_id": 1295, "verse_number": "२-३६-३२x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2014359, "chapter_id": 1295, "verse_number": "२-३६-३२", "content_sanskrit": "तद्वाक्यसमकालं च कृतं सर्वं न्यवेदयत्।\nसहदेवो युधां श्रेष्ठो धर्मराजो युधिष्ठिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2014360, "chapter_id": 1295, "verse_number": "२-३६-३३", "content_sanskrit": "ततो द्वैपायनो राजन्नृत्विजः समुपानयत्।\nवेदानिव महाभागान्साक्षान्मूर्तिमतो द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2014361, "chapter_id": 1295, "verse_number": "२-३६-३४", "content_sanskrit": "स्वयं ब्रह्मत्वमकरोत्तस्य सत्यवतीसुतः।\nधनञ्जयानामृषभः सुसामा सामगोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2014362, "chapter_id": 1295, "verse_number": "२-३६-३५", "content_sanskrit": "याज्ञवल्क्यो बभूवाथ ब्रह्मिष्ठोऽध्वर्युसत्तमः।\nपैलो होता वसोः पुत्रो धौम्येन सहितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2014363, "chapter_id": 1295, "verse_number": "२-३६-३६", "content_sanskrit": "एतेषां पुत्रवर्गाश्च शिष्याश्च भरतर्षभ।\nबभूवुर्होत्रगाः सर्वे वेदवेदाङ्गपारगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2014364, "chapter_id": 1295, "verse_number": "२-३६-३७", "content_sanskrit": "ते वाचयित्वा पुण्याहमूहयित्वा च तं विधिम्।\nशास्त्रोक्तं पूजयामासुस्तद्देवयजनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2014365, "chapter_id": 1295, "verse_number": "२-३६-३८", "content_sanskrit": "तत्र चक्रुरनुज्ञाताः शरणान्युत शिल्पिनः।\nगन्धवन्ति विशालानि वेश्मानीव दिवौकसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2014366, "chapter_id": 1295, "verse_number": "२-३६-३९", "content_sanskrit": "तत आज्ञापयामास स राजा राजसत्तमः।\nसहदेवं तदा सद्यो मन्त्रिणं पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2014367, "chapter_id": 1295, "verse_number": "२-३६-४०", "content_sanskrit": "आमन्त्रणार्थं दूतांस्त्वं प्रेषयस्वाशुगान्द्रुतम्।\nउपश्रुत्य वचो राज्ञः स दूतान्प्राहिणोत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2014368, "chapter_id": 1295, "verse_number": "२-३६-४१", "content_sanskrit": "आमन्त्रयध्वं राष्ट्रेषु ब्राह्मणान्भूमिपानथ।\nविनाश्च मान्याञ्शूद्रांश्च सर्वानानयतेति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2014369, "chapter_id": 1295, "verse_number": "२-३६-४२x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2014370, "chapter_id": 1295, "verse_number": "२-३६-४२", "content_sanskrit": "ते सर्वान्पृथिवीपालान्पाण्डवेयस्य शासनात्।\nआमन्त्रयाम्बभूवुस्ते प्रेषयामास चापरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2014371, "chapter_id": 1295, "verse_number": "२-३६-४३", "content_sanskrit": "दूताश्च वाहनैर्जग्भू राष्ट्राणि सुबहून्यपि।\nततो युधिष्ठिरो राजा प्रेषयामास पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2014372, "chapter_id": 1295, "verse_number": "२-३६-४४", "content_sanskrit": "नकुलं हास्तिनपुरं भीष्माय भरतर्षभ।\nद्रोणाय धृतराष्ट्राय विदुराय कृपाय च।\nभ्रातृणां चैव सर्वेणां येऽनुरक्ता युधिष्ठिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2014373, "chapter_id": 1295, "verse_number": "२-३६-४५", "content_sanskrit": "ततस्ते तु यथाकालं कुन्तीपुत्रं युधिष्ठिरम्।\nदीक्षयाञ्चक्रिरे विप्रा राजसूयाय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2014374, "chapter_id": 1295, "verse_number": "२-३६-४६", "content_sanskrit": "ज्येष्ठामूले अमावास्यां मृगाजिनसमावृतः।\nरौरवाजिनसंवीतो नवनीताक्तदेहवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2014375, "chapter_id": 1295, "verse_number": "२-३६-४७", "content_sanskrit": "दीक्षितः स तु धर्मात्मा धर्मराजो युधिष्ठिरः।\nजगाम यज्ञायतनं वृतो विप्रैः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2014376, "chapter_id": 1295, "verse_number": "२-३६-४८", "content_sanskrit": "भातृभिर्ज्ञातिभिश्चैव सुहृद्भिः सचिवैः सह।\nक्षत्रियैश्च मनुष्येन्द्रैर्नानादेशसमागतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2014377, "chapter_id": 1295, "verse_number": "२-३६-४९", "content_sanskrit": "अमात्यैश्च नरश्रेष्ठो धर्मो विग्रहवानिव।\nआजग्मुर्ब्राह्मणास्तत्र विषयेभ्यस्ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2014378, "chapter_id": 1295, "verse_number": "२-३६-५०", "content_sanskrit": "सर्वविद्यासु निष्णाता वेदवेदाङ्गपारगाः।\nतेषामावसथांश्चक्रुर्धर्मराजस्य शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2014379, "chapter_id": 1295, "verse_number": "२-३६-५१", "content_sanskrit": "बह्वन्नाच्छादनैर्युक्तान्सगणानां पृथक् पृथक्।\nसर्वर्तुगुणसम्पन्नाञ्शिल्पिनोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2014380, "chapter_id": 1295, "verse_number": "२-३६-५२", "content_sanskrit": "तेषु ते न्यवसन्राजन्ब्राह्मणा नृपसत्कृताः।\nकथयन्तः कथा बह्वीः पश्यन्तो नटनर्तकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2014381, "chapter_id": 1295, "verse_number": "२-३६-५३", "content_sanskrit": "भुञ्जतां चैव विप्राणां वदतां च महास्वनः।\nअनिशं श्रूयते तत्र मुदितानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2014382, "chapter_id": 1295, "verse_number": "२-३६-५४", "content_sanskrit": "दीयतां दीयतामेषां भुज्यतां भुज्यतामिति।\nएवम्प्रकाराः सञ्जल्पाः श्रूयन्तेस्मात्र नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2014383, "chapter_id": 1295, "verse_number": "२-३६-५५", "content_sanskrit": "गवां शतसहस्राणि शयनानां च भारत।\nरुक्मस्य योषितां चैव धर्मराजः पृथक् ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2014384, "chapter_id": 1295, "verse_number": "२-३६-५६", "content_sanskrit": "प्रावर्ततैव यज्ञः स पाण्डवस्य महात्मनः।\nपृथिव्यामेकवीरस्य शक्रस्येव त्रिविष्टपे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2014385, "chapter_id": 1295, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि दिग्विजयपर्वणि षट्त्रिंशोऽध्यायः॥ ३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]