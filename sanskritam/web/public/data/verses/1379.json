[{"id": 2018266, "chapter_id": 1379, "verse_number": "३-१७-०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018267, "chapter_id": 1379, "verse_number": "३-१७-१", "content_sanskrit": "एवमुक्त्वा रौक्मिणेयो यादवान्यादवर्षभ।\nदंशितैर्हरिभिर्युक्तं रथमास्थाय काञ्चनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018268, "chapter_id": 1379, "verse_number": "३-१७-२", "content_sanskrit": "उच्छ्रित्य मकरं केतुं व्यात्ताननमलङ्कृतम्।\nउत्पतद्भिरिवाकाशं तैर्हयैरन्वयात्परान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018269, "chapter_id": 1379, "verse_number": "३-१७-३", "content_sanskrit": "विक्षिपन्नादयंश्चापि धनुः श्रेष्ठं महाबलैः।\nतूणखङ्गधरः शूरो बद्धगोधाङ्गुलित्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018270, "chapter_id": 1379, "verse_number": "३-१७-४", "content_sanskrit": "सविद्युच्छुरितं चापं विहरन्वै तलात्तलम्।\nमोहयामास दैतेयान्सर्वान्सौभनिवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018271, "chapter_id": 1379, "verse_number": "३-१७-५", "content_sanskrit": "तस्य विक्षिपतश्चापं संदधानस्य चासकृत्।\nनान्तरं ददृशे कश्चिन्नघ्नितः शात्रवान्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018272, "chapter_id": 1379, "verse_number": "३-१७-६", "content_sanskrit": "मुखस्य वर्णो न विकल्पतेऽस्य\nचेलुश्च गात्राणि न चापि तस्य।\nसिंहोन्नतं चाप्यभिगर्जतोऽस्य\nशुश्राव लोकोऽद्भुतवीर्यमग्र्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018273, "chapter_id": 1379, "verse_number": "३-१७-७", "content_sanskrit": "जलेचरः काञ्चनयष्टिसंस्थो\nव्यात्ताननः शत्रुबलप्रमाथी।\nवित्रासयन्राजति वाहमुख्ये\nसाल्वस्य सेनाप्रमुखे ध्वजाग्र्यः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018274, "chapter_id": 1379, "verse_number": "३-१७-८", "content_sanskrit": "ततस्तूर्णं विनिष्पत्य प्रद्युम्नः शत्रुकर्शनः।\nसाल्वमेवाभिदुद्राव विधित्सुः कलहं नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018275, "chapter_id": 1379, "verse_number": "३-१७-९", "content_sanskrit": "अभियानं तु वीरेण प्रद्युम्नेन महारणे।\nनामर्षयत संक्रुद्वः साल्वः कुरुकुलोद्वह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018276, "chapter_id": 1379, "verse_number": "३-१७-१०", "content_sanskrit": "सरोषमहमत्तो वै कामगादवरुह्य च।\nप्रद्युम्नं योधयामास साल्वः परपुरंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018277, "chapter_id": 1379, "verse_number": "३-१७-११", "content_sanskrit": "तयोः सुतुमुलं युद्धं साल्ववृष्णिप्रवीरयोः।\nसमेता ददृशुर्लोका बलिवासवयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018278, "chapter_id": 1379, "verse_number": "३-१७-१२", "content_sanskrit": "तस्य मायामयो वीर रथो हेमपरिष्कृतः।\nसपताकः सध्वजश्च सानुकर्षः स तूणवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018279, "chapter_id": 1379, "verse_number": "३-१७-१३", "content_sanskrit": "स तं रथवरं श्रीमान्समारुह्य किल प्रभो।\nमुमोच बाणान्कौख्य प्रद्युम्नाय महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018280, "chapter_id": 1379, "verse_number": "३-१७-१४", "content_sanskrit": "ततो बाणमयं वर्षं व्यसृजत्तरसा रणे।\nप्रद्युम्नो भुजवेगेन साल्वं संमोहयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018281, "chapter_id": 1379, "verse_number": "३-१७-१५", "content_sanskrit": "स तैरभिहतः सङ्ख्ये नामर्यत सौभराट्।\nशरान्दीप्ताग्निसंकाशान्मुमोच तनये मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018282, "chapter_id": 1379, "verse_number": "३-१७-१६", "content_sanskrit": "तमापतन्तं बाणौधं स चिच्छेद महाबलः।\nततश्चान्याञ्शरान्दीप्तान्प्रचिक्षेप सुते मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018283, "chapter_id": 1379, "verse_number": "३-१७-१७", "content_sanskrit": "स साल्वबाणै राजेन्द्र विद्धो रुक्मिणिनन्दनः।\nमुमोच बाणं त्वरितो मर्मभेदिनमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018284, "chapter_id": 1379, "verse_number": "३-१७-१८", "content_sanskrit": "तस्य वर्म विभिद्याशु स बाणो मत्सुतेरितः।\nविवेश हृदयं पत्री स पपात भृशहतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018285, "chapter_id": 1379, "verse_number": "३-१७-१९", "content_sanskrit": "तस्मिन्निपतिते वीरे साल्वराजे विचेतसि।\nसंप्रद्रबन्दानवेन्द्रा दारयन्तो वसुंधराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018286, "chapter_id": 1379, "verse_number": "३-१७-२०", "content_sanskrit": "हाहाकृतमभूत्सैन्यं साल्वस्य पृथिवीपते।\nनष्टसंज्ञे निपतिते तदा सौभपतौ नृपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018287, "chapter_id": 1379, "verse_number": "३-१७-२१", "content_sanskrit": "तत उत्थाय राजेन्द्र प्रतिलभ्य च चेतनाम्।\nमुमोच बाणान्सहसा प्रद्युम्नाय महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018288, "chapter_id": 1379, "verse_number": "३-१७-२२", "content_sanskrit": "तेन बाणेन महता प्रद्युम्नः समरे स्थितः।\nजत्रुदेशे भृशं विद्धो व्यथितो ददृशे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018289, "chapter_id": 1379, "verse_number": "३-१७-२३", "content_sanskrit": "तं स विद्ध्वा महाराज साल्वो रुक्मिणिनन्दनम्।\nननाद सिंहनादं वै नादेनापूरयन्महीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018290, "chapter_id": 1379, "verse_number": "३-१७-२४", "content_sanskrit": "ततो मोहं समापन्ने तनये मम भारत।\nमुमोच बाणांस्त्वरितः पुनरन्यान्दुरात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2018291, "chapter_id": 1379, "verse_number": "३-१७-२५", "content_sanskrit": "स तैरभिहतो बाणैर्बहुभिस्तेन मोहितः।\nनिश्चेष्टः कौरवश्रेष्ठ प्रद्युम्नोऽभूद्रणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2018292, "chapter_id": 1379, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि सप्तदशोऽध्यायः ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]