[{"id": 2140340, "chapter_id": 4029, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2140341, "chapter_id": 4029, "verse_number": "१", "content_sanskrit": "स्त्रीमध्य उक्तस्तेनासौ वाक्यं तेजःप्रवर्धनम् ।\nअन्तःपुरे श्लाघमान इदं वचनमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2140342, "chapter_id": 4029, "verse_number": "२", "content_sanskrit": "अद्याहमनुगच्छेयं दृढधन्वा गवां पदम् ।\nयदि मे सारथिः कश्चिद् भवेदश्वेषु कोविदः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2140343, "chapter_id": 4029, "verse_number": "३", "content_sanskrit": "तमहं नाधिगच्छामि यो मे यन्ता समो भवेत् ।\nपश्यध्वं सारथिं शीघ्रं मम युद्धं प्रदास्यतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2140344, "chapter_id": 4029, "verse_number": "४", "content_sanskrit": "अष्टाविंशतिरात्रं वा मासं वाऽपि भवेत् ततः ।\nयत्र चासीन्महायुद्धं तत्र मे सारथिर्हतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2140345, "chapter_id": 4029, "verse_number": "५", "content_sanskrit": "यद्यहं त्वभिगच्छेयं यो मे यन्ता भवेद् युधि ।\nत्वरावानद्य यास्यामि समुच्छ्रितमहाध्वजः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2140346, "chapter_id": 4029, "verse_number": "६", "content_sanskrit": "विगाह्य तत् परानीकं गजवाजिरथाकुलम् ।\nशस्त्रप्रतापान्निर्वीर्यान् कुरून् जित्वाऽऽनये पशून्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2140347, "chapter_id": 4029, "verse_number": "७", "content_sanskrit": "दुर्योधनं शान्तनवं कर्णं वैकर्तनं कृपम् ।\nद्रोणं च सह पुत्रेण महेष्वासान् समागतान्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2140348, "chapter_id": 4029, "verse_number": "८", "content_sanskrit": "वित्रासयित्वा सङ्ग्रामे दानवान् मघवानिव ।\nअनेनैव मुहूर्तेन पुनः प्रत्यानये पशून्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2140349, "chapter_id": 4029, "verse_number": "९", "content_sanskrit": "शून्यमाज्ञाय कुरवः प्रयान्त्यादाय गोधनम् ।\nकिं नु शक्यं च तैः कर्तुं यदहं तत्र नाभवम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2140350, "chapter_id": 4029, "verse_number": "१०", "content_sanskrit": "पश्येयुरद्य मे वीर्यं कुरवस्ते समागताः ।\nकिं नु पार्थोर्ऽजुनः साक्षादिति मंस्यन्ति मां परे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2140351, "chapter_id": 4029, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2140352, "chapter_id": 4029, "verse_number": "११", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा स्त्रीषु चात्मप्रशंसनम् ।\nनामर्षयत पाञ्चाली बीभत्सोः परिकीर्तनम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2140353, "chapter_id": 4029, "verse_number": "१२", "content_sanskrit": "श्रुत्वा तदर्जुनो वाक्यमुत्तरेण प्रभाषितम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2140354, "chapter_id": 4029, "verse_number": "१३", "content_sanskrit": "स नीतसमये काले प्रियां भार्यामभाषत ।\nद्रुपदस्य सुतां राज्ञः पाञ्चालीं रूपसम्मताम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2140355, "chapter_id": 4029, "verse_number": "१४", "content_sanskrit": "सत्यार्जवगुणोपेतां भर्तुः प्रियहितैषिणीम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2140356, "chapter_id": 4029, "verse_number": "१५", "content_sanskrit": "उत्तरां ब्रूहि पाञ्चालि गत्वा क्षिप्रं शुचिस्मिते ।\nइयं किल पुरा युद्धे खाण्डवे सव्यसाचिनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2140357, "chapter_id": 4029, "verse_number": "१६", "content_sanskrit": "सारथिः पाण्डुपुत्रस्य पार्थस्य तु बृहन्नळा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2140358, "chapter_id": 4029, "verse_number": "१७", "content_sanskrit": "महान् जयो भवेद् युद्धे सा चेद् यन्ता बृहन्नळा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2140359, "chapter_id": 4029, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2140360, "chapter_id": 4029, "verse_number": "१८", "content_sanskrit": "सा चोदिता तदा तेन ह्यर्जुनेन शुचिस्मिता ।\nपाञ्चाली च तदाऽऽगम्य उत्तराया निवेशनम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2140361, "chapter_id": 4029, "verse_number": "१९", "content_sanskrit": "ज्ञात्वा तु समयान्मुक्तं चन्द्रं राहुमुखादिव\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2140362, "chapter_id": 4029, "verse_number": "२०", "content_sanskrit": "युधिष्ठिरं धर्मपरं सत्यार्जवपथे स्थितम् ।\nअमर्षयन्ती सैरन्ध्री कृष्णा कमललोचना\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2140363, "chapter_id": 4029, "verse_number": "२१", "content_sanskrit": "उत्तरामाह वचनं सखीमध्ये विलासिनीम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2140364, "chapter_id": 4029, "verse_number": "२२", "content_sanskrit": "योऽयं युवा वारणयूथपोपमो\nबृहन्नळाऽस्मीति जनोऽभ्यभाषत ।\nपुरा हि पार्थस्य स सारथिः सदा\nधनुर्वराणां प्रवरस्य मन्ये\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2140365, "chapter_id": 4029, "verse_number": "२३", "content_sanskrit": "स दृष्टपूर्वो हि मया चरन्त्या पाण्डवालये\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2140366, "chapter_id": 4029, "verse_number": "२४", "content_sanskrit": "यदाऽनेन सहायेन खाण्डवं चादहत् पुरा ।\nअर्जुनस्य तदा तेन सङ्गृहीता हयोत्तमाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2140367, "chapter_id": 4029, "verse_number": "२५", "content_sanskrit": "तेन सारथिना पार्थः सर्वभूतानि सर्वशः ।\nअजयत् खाण्डवप्रस्थे न हि यन्ताऽस्ति तादृशः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2140368, "chapter_id": 4029, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2140369, "chapter_id": 4029, "verse_number": "२६", "content_sanskrit": "ततः सैरन्ध्रिसहिता उत्तरा भ्रातुरब्रवीत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2140370, "chapter_id": 4029, "verse_number": "२७", "content_sanskrit": "अभ्यर्थयेमां सारथ्ये वीर शीघ्रं बृहन्नळाम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2140371, "chapter_id": 4029, "verse_number": "२८", "content_sanskrit": "शिक्षितैषा हि सारथ्ये नर्तने गीतवादने ।\nसैरन्ध्र्याह महाप्राज्ञा स्तुवन्ती वै बृहन्नळाम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2140372, "chapter_id": 4029, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2140373, "chapter_id": 4029, "verse_number": "२९", "content_sanskrit": "सैरन्ध्रि जानासि मम व्रतं यथा\nक्लीबं न भाषे पुरुषः स्वयं हि ।\nसोऽहं न शक्ष्यामि बृहन्नळां शुभे\nवक्तुं स्वयं यच्छ हयान् ममेति\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2140374, "chapter_id": 4029, "verse_number": "", "content_sanskrit": "सैरन्ध्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2140375, "chapter_id": 4029, "verse_number": "३०", "content_sanskrit": "भयकाले तु सम्प्राप्ते न व्रतं नाव्रतं पुनः ।\nयथा दुःखं प्रतरति तथा युक्तं चरेद् बुधः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2140376, "chapter_id": 4029, "verse_number": "समाप्तिः", "content_sanskrit": "इति धर्मविदः प्राहुस्तस्माद् वाच्या बृहन्नळा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2140377, "chapter_id": 4029, "verse_number": "३२", "content_sanskrit": "येयं कुमारी सुश्रोणी भगिनी ते यवीयसी ।\nअस्यास्तु वचनं वीर करिष्यति न संशयः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2140378, "chapter_id": 4029, "verse_number": "३३", "content_sanskrit": "यदि ते सारथिः सा स्यात् कुरून् सर्वानसंशयम् ।\nजित्वा गाश्च समादाय ध्रुवमागमनं भवेत्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2140379, "chapter_id": 4029, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2140380, "chapter_id": 4029, "verse_number": "३४", "content_sanskrit": "एवमुक्तः स सैरन्ध्र्या भगिनीं प्रत्यभाषत\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2140381, "chapter_id": 4029, "verse_number": "३५", "content_sanskrit": "गच्छ त्वमनवद्याङ्गि तामानय बृहन्नळाम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2140382, "chapter_id": 4029, "verse_number": "३६", "content_sanskrit": "सा प्राद्रवत् काञ्चनमाल्यधारिणी\nज्येष्ठेन भ्रात्रा प्रहिता यशस्विनी ।\nभ्रातुर्नियोगं तु निशम्य सुभ्रूः\nशुभानना हाटकरत्नभूषिता\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2140383, "chapter_id": 4029, "verse_number": "३७", "content_sanskrit": "सा वज्रमुक्तामणिहेमकुण्डला\nमृदुक्रमा भ्रातृनियोगचोदिता ।\nप्रदक्षिणावर्ततनुः शिखण्डिनी\nपद्मानना पद्मदलायताक्षी\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2140384, "chapter_id": 4029, "verse_number": "३८", "content_sanskrit": "तन्वी समाङ्गी मृदुमन्द्रलोचना\nमात्स्यस्य राज्ञो दुहिता विलासिनी ।\nसा नर्तनागारमरालपक्ष्मा\nशतह्रदा मेधमिवान्वपद्यत\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2140385, "chapter_id": 4029, "verse_number": "३९", "content_sanskrit": "सा नागनासोपमसंहितोरूः\nअनिन्दिता वेदिविलग्नमध्या ।\nआसाद्य तस्थौ वरमाल्यधारिणी\nपार्थं शुभा नागवधूरिव द्विपम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2140386, "chapter_id": 4029, "verse_number": "४०", "content_sanskrit": "तामागतामायतताम्रलोचनाम्\nअवेक्ष्य पार्थः समयेऽभ्यभाषत\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2140387, "chapter_id": 4029, "verse_number": "४१", "content_sanskrit": "किमागता काञ्चनमाल्यधारिणि\nसुगात्रि किञ्चित् त्वरिताऽसि सुभ्रु ।\nकिं ते मुखं सुन्दरि न प्रसन्नम्\nआचक्ष्व शीघ्रं मम चारुहासिनि\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2140388, "chapter_id": 4029, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2140389, "chapter_id": 4029, "verse_number": "४२", "content_sanskrit": "सा वज्रवैडूर्यविकारकुण्डला विनिद्रपद्मोत्पलपत्रगन्धिनी ।\nप्रसन्नताराधिपसन्निभानना पार्थं कुमारी वचनं बभाषे\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2140390, "chapter_id": 4029, "verse_number": "४३", "content_sanskrit": "हरन्ति वित्तं कुरवः पितुर्मे शतं सहस्राणि गवां बृहन्नळे ।\nसा भ्रातुरश्वान् मम संयमस्व पुरा परे दूरतरं हरन्ति गाः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2140391, "chapter_id": 4029, "verse_number": "४४", "content_sanskrit": "सैरन्ध्रिराख्याति बृहन्नळे त्वां\nसुशिक्षितां सङ्ग्रहणे रथाश्वयोः ।\nअहं मरिष्यामि न मेऽत्र संशयो\nमया वृता तत्र न चेद् गमिष्यसि\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2140392, "chapter_id": 4029, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2140393, "chapter_id": 4029, "verse_number": "४५", "content_sanskrit": "तथा नियुक्तो नरदेवकन्यया\nनरोत्तमः प्रीतमना धनञ्जयः ।\nउवाच पार्थः शुभमन्दया गिरा\nशुभाननां शुक्लदतीं शुचिस्मिताम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2140394, "chapter_id": 4029, "verse_number": "४६", "content_sanskrit": "गच्छामि यत्रेच्छसि चारुहासिनि\nहुताशनं प्रज्वलितं विशामि वा ।\nइच्छामि तेऽहं वरगात्रि जीवितं\nकरोमि किं ते प्रियमद्य सुन्दरि\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2140395, "chapter_id": 4029, "verse_number": "४७", "content_sanskrit": "न मत्कृते द्रक्ष्यसि तत्पुरं प्रिये\nवैवस्वतं प्रेतपतेर्महाभयम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2140396, "chapter_id": 4029, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2140397, "chapter_id": 4029, "verse_number": "४८", "content_sanskrit": "स एवमुक्त्वा कुरुवीरपुङ्गवो\nविलासिनीं शुक्लदतीं शुचिस्मिताम् ।\nबृहन्नळारूपविभूषिताननो\nविराटपुत्रस्य समीपमाव्रजत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2140398, "chapter_id": 4029, "verse_number": "४९", "content_sanskrit": "तं सा व्रजन्तं त्वरितं प्रभिन्नमिव कुञ्जरम् ।\nअन्वगच्छद् विशालाक्षी गजं गजवधूरिव\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2140399, "chapter_id": 4029, "verse_number": "५०", "content_sanskrit": "दूरादेव तु सम्प्रेक्ष्य राजपुत्रोऽभ्यभाषत\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2140400, "chapter_id": 4029, "verse_number": "५१", "content_sanskrit": "त्वया सारथिना पार्थः खाण्डवेऽग्निमतर्पयत् ।\nपृथिवीं चाजयत् कृत्स्नां कुन्तीपुत्रो धनञ्जयः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2140401, "chapter_id": 4029, "verse_number": "५२", "content_sanskrit": "सैरन्ध्री त्वां ममाचष्ट सा हि जानाति पाण्डवान्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2140402, "chapter_id": 4029, "verse_number": "५३", "content_sanskrit": "देवेन्द्रसारथिर्वीरो मातलिः ख्यातविक्रमः ।\nसुहोत्रो जामदग्नेश्च विष्णोर्यन्ता च दारुकः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2140403, "chapter_id": 4029, "verse_number": "५४", "content_sanskrit": "अरुणः सूर्ययन्ता च सुमन्त्रो दशरथस्य च ।\nसर्वे सारथयः ख्याता न बृहन्नळया समाः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2140404, "chapter_id": 4029, "verse_number": "५५", "content_sanskrit": "इत्युक्तोऽहं च सैरन्ध्र्या तेन त्वामाह्वयामि वै\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2140405, "chapter_id": 4029, "verse_number": "५६", "content_sanskrit": "आहूता त्वं मया सार्धं योद्धुं याहि बृहन्नळे ।\nदुराद् दूरतरं गावो भवन्ति कुरुभिर्हृताः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2140406, "chapter_id": 4029, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2140407, "chapter_id": 4029, "verse_number": "५७", "content_sanskrit": "तथोक्ता प्रत्युवाचैनं राजपुत्रं बृहन्नळा\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2140408, "chapter_id": 4029, "verse_number": "५८", "content_sanskrit": "का शक्तिर्मम सारथ्यं कर्तुं सङ्ग्राममूर्धनि\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2140409, "chapter_id": 4029, "verse_number": "५९", "content_sanskrit": "नृत्तं वा यदि वा गीतं वादित्रं वा पृथग्विधम् ।\nतत् करिष्यामि भद्रं ते सारथ्यं तु कुतो मम\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2140410, "chapter_id": 4029, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2140411, "chapter_id": 4029, "verse_number": "६०", "content_sanskrit": "त्वं नर्तनो वा यदि वाऽपि गायकः\nक्षिप्रं तनुत्रं परिधत्स्व भानुमत् ।\nअभीक्ष्णमाहुस्तव कर्म पौरुषं\nस्त्रियः प्रशंसन्ति ममाद्य चान्तिके\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2140412, "chapter_id": 4029, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2140413, "chapter_id": 4029, "verse_number": "६१", "content_sanskrit": "इत्येवमुक्त्वा नृपसूनुसत्तमः\nतदा स्मयित्वाऽर्जुनमभ्यनन्दत् ।\nअथोत्तरः पारशवं शताक्षिम्\nसुवर्णचित्रं परिगृह्य भानुमत्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2140414, "chapter_id": 4029, "verse_number": "६२", "content_sanskrit": "बृहन्नळायै प्रददौ स्वयं तदा\nविराटपुत्रः परवीरघातिने ।\nतदाज्ञया मात्स्यसुतस्य वीर्यवान्\nसा कर्तुकामेव समाददे तदा\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2140415, "chapter_id": 4029, "verse_number": "", "content_sanskrit": "बृहन्नळा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2140416, "chapter_id": 4029, "verse_number": "६३", "content_sanskrit": "यद्यस्ति च रणे शौर्यं शक्यं चेद् द्विषतां वधः ।\nअहं त्वामभिगच्छामि यत्र त्वं यासि तत्र भो\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2140417, "chapter_id": 4029, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2140418, "chapter_id": 4029, "verse_number": "६४", "content_sanskrit": "स तत्र नर्मसंयुक्तमकरोत् पाण्डवो बहु ।\nउत्तरायाः प्रमुखतः सर्वं जानन्नरिन्दमः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2140419, "chapter_id": 4029, "verse_number": "६५", "content_sanskrit": "तमाददानं प्रमदा जहासिरे\nह्यधोमुखं वीरवरोऽभ्यहारयत् ।\nततः शिरःखं निकृतः सपत्नहा\nह्यधोमुखं कवचमथाभ्यकर्षत\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2140420, "chapter_id": 4029, "verse_number": "६६", "content_sanskrit": "सम्यक् प्रजानन्नपि सत्यविक्रमो\nह्यज्ञातवत् सर्वकुरुप्रवीरः ।\nऊर्ध्वं क्षिपन् वीरवरोऽभ्यहारयत्\nपुनश्च यत्नात् कवचं धनञ्जयः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2140421, "chapter_id": 4029, "verse_number": "६७", "content_sanskrit": "एवंप्रकाराणि बहूनि कुर्वति\nतस्मिन् कुमार्यः प्रमदा जहासिरे ।\nतथाऽपि कुर्वन्तममित्रकर्शनं\nन चोत्तरः पर्यभवद् धनञ्जयम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2140422, "chapter_id": 4029, "verse_number": "६८", "content_sanskrit": "तं राजपुत्रः समनह्ययत् स्वयं\nजाम्बूनदान्तेन दृढेन वर्मणा ।\nकृशानुतप्तप्रतिमेन भास्वता\nजाज्वल्यमानेन सहस्रराजिना(रश्मिना)\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2140423, "chapter_id": 4029, "verse_number": "६९", "content_sanskrit": "अथास्य शीघ्रं प्रसमीक्ष्य योजयद्\nरथे हयान् काञ्चनजालसंवृतान् ।\nसुवर्णजालान्तरयोक्त्रभूषणं\nसिंहं च सौवर्णमुपाश्रयद् रथे\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2140424, "chapter_id": 4029, "verse_number": "७०", "content_sanskrit": "धनूंषि च विचित्राणि बाणांश्च रुचिरान् बहून् ।\nआयुधानि च तत्रैव रथोपस्थे न्ययोजयत्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2140425, "chapter_id": 4029, "verse_number": "७१", "content_sanskrit": "आरुह्य प्रययौ वीरः सबृहन्नळसारथिः ।\nअथोत्तरा च कन्याश्च सख्यश्चैवाब्रुवंस्तदा\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2140426, "chapter_id": 4029, "verse_number": "७२", "content_sanskrit": "बृहन्नळे आनयेथा वासांसि रुचिराणि नः ।\nपालितार्थानि सूक्ष्माणि रत्नानि विविधानि च\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2140427, "chapter_id": 4029, "verse_number": "७३", "content_sanskrit": "विजित्य सङ्ग्रामगतान् भीष्मद्रोणमुखान् कुरून्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2140428, "chapter_id": 4029, "verse_number": "७४", "content_sanskrit": "अथानुब्रुवतीः कन्याः सहिताः पाण्डुनन्दनः ।\nप्रत्युवाच हसन् पार्थो मेघदुन्दुभिनिस्वनः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2140429, "chapter_id": 4029, "verse_number": "७५", "content_sanskrit": "यद्युत्तरोऽयं सङ्ग्रामे विजेष्यति महारथान् ।\nअथाहरिष्ये वासांसि सूक्ष्माण्याभरणानि च\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2140430, "chapter_id": 4029, "verse_number": "७६", "content_sanskrit": "अथोत्तरो वर्म महाप्रभाववत्\nसुवर्णवैडूर्यपरिष्कृतं दृढम् ।\nआमुच्य वीरः प्रययौ रथोत्तमं\nधनञ्जयं सारथिनं प्रगृह्य\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2140431, "chapter_id": 4029, "verse_number": "७७", "content_sanskrit": "तमुत्तरं प्रेक्ष्य रथोत्तमे स्थितं\nबृहन्नळां चैव महाजनस्तदा ।\nस्त्रियश्च कन्याश्च द्विजाश्च सुव्रताः\nप्रदक्षिणं मङ्गलिनोऽभ्यपूजयन्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2140432, "chapter_id": 4029, "verse_number": "", "content_sanskrit": "पौराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2140433, "chapter_id": 4029, "verse_number": "७८", "content_sanskrit": "यदर्जुनस्यर्षभतुल्यगामिनः\nपुराऽभवत् खाण्डवदाहमङ्गलम् ।\nकुरून् समासाद्य रणे बृहन्नळे\nसहोत्तरेणास्तु तवाद्य मङ्गलम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2140434, "chapter_id": 4029, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि सप्तत्रिंशोऽध्यायः ॥३७॥ गोग्रहणपर्वणि दशमोऽध्यायः ॥१०॥\n* * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]