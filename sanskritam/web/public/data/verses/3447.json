[{"id": 2113792, "chapter_id": 3447, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113793, "chapter_id": 3447, "verse_number": "१", "content_sanskrit": "ततस्ते मन्त्रयामासुर्दुर्योधनपुरोगमाः ।\nप्राणवान् विक्रमी चापि शौर्ये महति च स्थितः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113794, "chapter_id": 3447, "verse_number": "२", "content_sanskrit": "स्पर्धते चापि सततमस्मानेको वृकोदरः ।\nतं तु सुप्तं पुरोद्याने जले शूरं क्षिपामहे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113795, "chapter_id": 3447, "verse_number": "३", "content_sanskrit": "ततो जलविहारार्थं कारयामास भारत ।\nचेलकम्बलवेश्मानि चित्राणि च शुभानि च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113796, "chapter_id": 3447, "verse_number": "४", "content_sanskrit": "तत्र संस्कारयामासुर्नानागाराण्यनेकशः ।\nउदकक्रीडनार्थानि कारयामास भारत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113797, "chapter_id": 3447, "verse_number": "५", "content_sanskrit": "ततो दुर्योधनस्त्वाह पाण्डवांस्तु सुदुर्मतिः ।\nगङ्गामिमां नयामोऽद्य उद्यानवनशोभिताम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113798, "chapter_id": 3447, "verse_number": "६", "content_sanskrit": "सहिता भ्रातरः सर्वे जलक्रीडामवाप्नुमः ।\nएवमस्त्विति तं चापि प्रत्युवाच युधिष्ठिरः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113799, "chapter_id": 3447, "verse_number": "७", "content_sanskrit": "ते रथैर्नगराकारैर्देशजैश्च हयोत्तमैः ।\nनिर्ययुर्नगराद् वीराः कुरवः पाण्डवैः सह\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113800, "chapter_id": 3447, "verse_number": "९", "content_sanskrit": "उद्यानवनमासाद्य सम्प्रसृज्य च वाहनम् ।\nप्राविशंस्तु महावीर्याः सिंहा इव गिरेर्गुहाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113801, "chapter_id": 3447, "verse_number": "१०", "content_sanskrit": "उद्यानं स्माथ पश्यन्ति भ्रातरः सर्व एव ते ।\nउपस्थानगृहैः शुभ्रैर्वलभीभिश्च शोभितम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2113802, "chapter_id": 3447, "verse_number": "११", "content_sanskrit": "गवाक्षकैस्तथा जालैर्जलसंसारकैस्तथा ।\nसूपाकृतं सुधाकारैः चित्रकारैश्च शिल्पिभिः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2113803, "chapter_id": 3447, "verse_number": "१२", "content_sanskrit": "दीर्घिकाभिश्च पुण्याभिः तथा कारण्डकैरपि ।\nजलं तु शुशुभे च्छन्नं फुल्लैर्जलरुहैस्तथा \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2113804, "chapter_id": 3447, "verse_number": "१३", "content_sanskrit": "उपकीर्णा वसुमती तथा पुष्पैर्यथर्तुकैः ।\nउपविष्टास्तथा सर्वे पाण्डवाः कुरवस्तथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2113805, "chapter_id": 3447, "verse_number": "१४", "content_sanskrit": "उपपन्नान् बहून् कामांस्तथा भुक्त्वा ततस्ततः ।\nअथोद्यानवने तस्मिन् तथा क्रीडागताश्च ते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2113806, "chapter_id": 3447, "verse_number": "१५", "content_sanskrit": "परस्परस्य वक्त्रेषु ददुर्भक्ष्यांस्ततस्ततः ।\nततो दुर्योधनः पापः तद् भक्ष्ये कालकूटकम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2113807, "chapter_id": 3447, "verse_number": "१६", "content_sanskrit": "विषं प्रक्षेपयामास भीमसेनजिघांसया ।\nस्वयमुत्थाय चैवाथ हृदयेन क्षुरोपमः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2113808, "chapter_id": 3447, "verse_number": "१७", "content_sanskrit": "सत्कृत्य भ्रातृवत् तत्र वाचा चामृतकल्पया ।\nप्राक्षिपद् वै स्वयं भक्ष्यं वक्त्रे भीमस्य पापकृत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2113809, "chapter_id": 3447, "verse_number": "१८", "content_sanskrit": "प्रभक्षितं च भीमेन ह्यस्य दोषमजानता ।\nततो दुर्योधनस्तत्र हृदयेन हसन्निव \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2113810, "chapter_id": 3447, "verse_number": "१९", "content_sanskrit": "कृतकृत्यमिवात्मानं मन्यते पुरुषाधमः ।\nततस्ते सहिताः सर्वे जलक्रीडामकुर्वत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2113811, "chapter_id": 3447, "verse_number": "२०", "content_sanskrit": "दिवसान्ते परिश्रान्ता विहृत्य कुरुनन्दनाः ।\nविहारायतनेष्वेव वीरा वासमरोचयन् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2113812, "chapter_id": 3447, "verse_number": "२१", "content_sanskrit": "भीमस्तु बलवान् भुक्त्वा व्यायामाभ्यधिको जले ।\nवाहयित्वा कुमारांस्तान् जलक्रीडां महाबलः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2113813, "chapter_id": 3447, "verse_number": "२२", "content_sanskrit": "प्रमाणकोट्यां वासार्थी पुनश्चारुह्य तत्स्थलम् ।\nस हि तत्स्थलमारुह्य श्रान्तश्चाप्सु विशेषतः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2113814, "chapter_id": 3447, "verse_number": "२३", "content_sanskrit": "श्रमेण च परीताङ्गः सुष्वाप मृतकल्पवत् ।\nततो बद्ध्वा दृढं पाशैर्भीमं दुर्योधनः स्वयम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2113815, "chapter_id": 3447, "verse_number": "२४", "content_sanskrit": "शूलान्यप्सु निखायाशु स्थलाज्जलमपातयत् ।\nसशेषत्वान्न सम्प्राप्तो जले शूलानि पाण्डवः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2113816, "chapter_id": 3447, "verse_number": "२५", "content_sanskrit": "पपात यत्र तत्रास्य शूलं नासीद् यदृच्छया ।\nस निस्सञ्ज्ञो जलस्यान्तरवाग् वै पाण्डवोऽविशत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2113817, "chapter_id": 3447, "verse_number": "२६", "content_sanskrit": "आक्रम्य नागभवने तथा नागकुमारकान् ।\nततः समेत्य बहुभिः तथा नागैर्महाविषैः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2113818, "chapter_id": 3447, "verse_number": "२७", "content_sanskrit": "दश्यते पाण्डवस्तत्र विषदिग्धो महाविषैः ।\nततोऽस्य दश्यमानस्य तद् विषं कालकूटकम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2113819, "chapter_id": 3447, "verse_number": "२८", "content_sanskrit": "हतं सर्पविषेणाशु स्थावरं जङ्गमेन तु ।\nततः प्रबुद्धः कौन्तेयः स सञ्छिद्य च बन्धनम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2113820, "chapter_id": 3447, "verse_number": "२९", "content_sanskrit": "पोथयामास तान् सर्पान् कांश्चित् प्राणैर्व्ययोजयत् ।\nते हन्यमानाः पार्थेन सर्पा वासुकिमभ्ययुः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2113821, "chapter_id": 3447, "verse_number": "३०", "content_sanskrit": "ऊचुश्च सर्पराजानं वासुकिं वासवोपमम् ।\nअहन् नरो वै नागेन्द्र ह्यप्सु बद्ध्वा प्रवेशितः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2113822, "chapter_id": 3447, "verse_number": "३१", "content_sanskrit": "तथा च नो मतिर्वीर विषपीतो भविष्यति ।\nनिश्चेष्टोऽस्माननुप्राप्तः स च दष्टोऽन्वबुध्यत \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2113823, "chapter_id": 3447, "verse_number": "३२", "content_sanskrit": "विनिविष्टोऽन्तरप्राप्तः तमपास्याप्यनेकशः ।\nससञ्ज्ञश्च सुसंवृत्तः च्छित्त्वा बन्धनमाशु सः ।\nपोथयन्नो महाबाहुस्तं वै त्वं ज्ञातुमर्हसि \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2113824, "chapter_id": 3447, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2113825, "chapter_id": 3447, "verse_number": "३३", "content_sanskrit": "ततो वासुकिरभ्येत्य नागैरनुगतस्तदा ।\nपश्यति स्म महानागो भीमं भीमपराक्रमम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2113826, "chapter_id": 3447, "verse_number": "३४", "content_sanskrit": "आर्यकौतुकदृष्टः स प्रयातस्त्वार्यकेण तु ।\nततो दृष्टश्च तेनापि परिष्वक्तश्च पाण्डवः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2113827, "chapter_id": 3447, "verse_number": "३५", "content_sanskrit": "सुप्रीतश्चाभवत् तस्य वासुकिः सुमहायशाः ।\nअब्रवीत् तं च नागेन्द्रः किमस्य क्रियतामिति\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2113828, "chapter_id": 3447, "verse_number": "३६", "content_sanskrit": "प्रियं धनौघं रत्नानि यावदस्य प्रदीयताम् ।\nएवमुक्तस्तदा नागो वासुकिं प्रत्यभाषत\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2113829, "chapter_id": 3447, "verse_number": "३७", "content_sanskrit": "यदि नागेन्द्र प्रीतोऽसि किमस्य धनसञ्चयैः ।\nरसं पिबेत् कुमारोऽयं त्वयि प्रीते महाबलः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2113830, "chapter_id": 3447, "verse_number": "३८", "content_sanskrit": "बलं नागसहस्रस्य कुण्डे चास्मिन् प्रतिष्ठितम् ।\nयावत् पिबति बालोऽयं तावदस्मै प्रदीयताम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2113831, "chapter_id": 3447, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2113832, "chapter_id": 3447, "verse_number": "३९", "content_sanskrit": "एवमस्त्विति तं नागं वासुकिः प्रत्यभाषत ।\nततो भीमस्तदा नागैः कृतस्वस्त्ययनः शुचिः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2113833, "chapter_id": 3447, "verse_number": "४०", "content_sanskrit": "प्राङ्मुखश्चोपविष्टश्च रसं पिबत पाण्डवः ।\nएकोच्छ्वासात् तदा कुण्डं पिबति स्म महाबलः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2113834, "chapter_id": 3447, "verse_number": "४१", "content_sanskrit": "एवमष्टौ तु कुण्डानि सोऽपिबत् पाण्डुनन्दनः ।\nदिव्ये ततस्तु शयने नागदत्ते महाभुजः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2113835, "chapter_id": 3447, "verse_number": "४२", "content_sanskrit": "शेते स्म च तदा भीमो दिवसान्यष्ट चैव तु ।\nदुर्योधनोऽपि पापात्मा भीममाशीविषह्रदे \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2113836, "chapter_id": 3447, "verse_number": "४३", "content_sanskrit": "प्रक्षिप्य कृतकृत्यं स्वमात्मानं मन्यते तदा ।\nप्रभातायां रजन्यां च प्रविवेश पुरं ततः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2113837, "chapter_id": 3447, "verse_number": "४४", "content_sanskrit": "ब्रुवाणो भीमसेनस्तु यातो ह्यग्रत एव नः ।\nयुधिष्ठिरस्तु धर्मत्मा चिन्तयन् पापमात्मनि \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2113838, "chapter_id": 3447, "verse_number": "४५", "content_sanskrit": "स्वेनाऽनुमानेन परं तदाऽस्यानुपपश्यति ।\nउपगम्य ततः पार्था मातरं मातृवत्सलाः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2113839, "chapter_id": 3447, "verse_number": "४६", "content_sanskrit": "अभिवाद्याब्रुवंस्ते वै अम्ब भीम इहागतः ।\nनेति स्माह तदा कुन्ती ततस्ते व्यथिता भवन् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2113840, "chapter_id": 3447, "verse_number": "४७", "content_sanskrit": "दूरं गत्वा पुरोद्यानं विचिन्वन्ति स्म पाण्डवाः ।\nभीमभीमेति ते वाचं नित्यमुच्चैरुदीरयन् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2113841, "chapter_id": 3447, "verse_number": "४८", "content_sanskrit": "विचिन्वन्तोऽथ ते सर्वे न स्म पश्यन्ति भ्रातरम् ।\nआगताः स्वगृहं भूय इदमूचुः पृथां तदा\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2113842, "chapter_id": 3447, "verse_number": "४९", "content_sanskrit": "न दृश्यते महाबाहुरम्ब भीमो वने गतः ।\nविचितानि च सर्वाणि उद्यानानि नदीस्तथा \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2113843, "chapter_id": 3447, "verse_number": "५०", "content_sanskrit": "ततो विदुरमानाय्य कुन्ती सा स्वं निवेशनम् ।\nउवाच क्षत्तो बलवान् भीमसेनो न दृश्यते \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2113844, "chapter_id": 3447, "verse_number": "५१", "content_sanskrit": "उद्यानान्निर्गताः सर्वे भ्रातरो भ्रातृभिः सह ।\nतत्र ह्येको महाबाहुर्भीमो नाभ्येति मामिह\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2113845, "chapter_id": 3447, "verse_number": "५२", "content_sanskrit": "न च मे प्रीयते चक्षुः सदा दुर्योधनस्य ह ।\nततः प्रसुप्तं मन्येऽहं पापेन निहतं सुतम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2113846, "chapter_id": 3447, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2113847, "chapter_id": 3447, "verse_number": "५३", "content_sanskrit": "मा मैवं वद कल्याणि शेषसंरक्षणं कुरु ।\nप्रत्यादिष्टो हि पापात्मा शेषेषु प्रहरेत ह\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2113848, "chapter_id": 3447, "verse_number": "५४", "content_sanskrit": "दीर्घायुषस्तव सुतान् तथा ह्यृषिरभाषत ।\nआगमिष्यति ते पुत्रः प्रीतिं ते जनयिष्यति\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2113849, "chapter_id": 3447, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2113850, "chapter_id": 3447, "verse_number": "५५", "content_sanskrit": "एवमुक्ता तदा कुन्ती निश्श्वसन्ती मुहुर्मुहुः ।\nशय्यापरा महाभागा पुत्रैः परिवृता तदा\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2113851, "chapter_id": 3447, "verse_number": "५६", "content_sanskrit": "ततोऽष्टमेऽथ दिवसे प्रत्यबुध्यत पाण्डवः ।\nतस्मिंस्तदा विषे जीर्णे ह्यप्रमेयबलो बली \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2113852, "chapter_id": 3447, "verse_number": "५७", "content_sanskrit": "ओषधीभिर्वनघ्नीभिः सुरभीभिर्विभूषितः ।\nभुक्त्वा तु परमान्नं च नागैर्दत्तं महाभुजः \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2113853, "chapter_id": 3447, "verse_number": "५८", "content_sanskrit": "उत्क्षिप्य च तदा नागैर्जलाज्जलरुहेक्षणः ।\nतस्मिन्नेव वनोद्देशे स्थापितः पाण्डुनन्दनः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2113854, "chapter_id": 3447, "verse_number": "५९", "content_sanskrit": "अन्तर्दधुश्च ते नागाः पाण्डवस्यैव पश्यतः ।\nतत उत्थाय भीमस्तु आजगाम स्वयं गृहे\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2113855, "chapter_id": 3447, "verse_number": "६०", "content_sanskrit": "अभिवाद्य परिष्वक्तः सम्प्राघ्रातश्च मूर्धनि ।\nप्रणम्य धर्मपुत्राय सस्वजे फल्गुनं तदा\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2113856, "chapter_id": 3447, "verse_number": "६१", "content_sanskrit": "अभिवादितश्च तैर्वीरैः सस्वजे च यमावपि ।\nतच्च सर्वं यथावृत्तमाख्याति स्म वृकोदरः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2113857, "chapter_id": 3447, "verse_number": "६२", "content_sanskrit": "यदा त्ववगमंस्ते वै पाण्डवास्तस्य कर्म तत् ।\nतत्रैनं बहुलं चक्रुः प्रयतन्तः स्वरक्षणे \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2113858, "chapter_id": 3447, "verse_number": "६३", "content_sanskrit": "धर्मात्मा विदुरस्तेषां प्रददौ मतिमान् मतिम् ।\nदुर्योधनोऽपि तं दृष्ट्वा पाण्डवं पुनरागतम् \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2113859, "chapter_id": 3447, "verse_number": "६४", "content_sanskrit": "निश्वसंश्चिन्तयंश्चैवमहन्यहनि तप्यते ।\nएवं दुर्योधनः पापः शकुनिश्चापि सौबलः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2113860, "chapter_id": 3447, "verse_number": "६५", "content_sanskrit": "अनेकैरप्युपायैस्तान् जिघांसन्ति स्म पाण्डवान् ।\nपाण्डवाश्चापि तत् सर्वं प्रत्यजानन्नरिन्दम \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2113861, "chapter_id": 3447, "verse_number": "६६", "content_sanskrit": "उद्भावनमकुर्वन्तो विदुरस्य मते स्थिताः ।\nअधिजग्मुश्च कुरवो धनुर्वेदं कृपात् तु ते\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2113862, "chapter_id": 3447, "verse_number": "१२६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषड्विंशत्यधिकशततमोऽध्यायः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2113863, "chapter_id": 3447, "verse_number": "७४", "content_sanskrit": "॥ इति सम्भवपर्वणि चतुःसप्ततितमोऽध्यायः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2113864, "chapter_id": 3447, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]