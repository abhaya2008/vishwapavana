[{"id": 7004987000, "chapter_id": 24987, "verse_number": "७-१-१७०-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि तत्र मातृगणान्सुधीः ।\nतत्रैव बलदेवीं च नातिदूरे व्यवस्थिताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004987001, "chapter_id": 24987, "verse_number": "७-१-१७०-२", "content_sanskrit": "श्रावण्यां श्रावणे मासि यस्तां पूजयते नरः ।\nपायसैर्मधुना वापि दिव्यपुष्पोपहारकैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004987002, "chapter_id": 24987, "verse_number": "७-१-१७०-३", "content_sanskrit": "तस्य वर्षं महादेवि सुखं गच्छेत्सुपूजितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004987003, "chapter_id": 24987, "verse_number": "७-१-१७०-४", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये मातृगणबलदेवीमाहात्म्यवर्णनंनाम सप्तत्युत्तरशततमोध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]