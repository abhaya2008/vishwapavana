[{"id": 900004282, "chapter_id": 8332, "verse_number": "8.1", "content_sanskrit": "तत्र व्याप्तस्य पक्षधर्मत्वप्रतीतिः सिद्धिः । तद्रहितोऽसिद्धः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004283, "chapter_id": 8332, "verse_number": "8.2", "content_sanskrit": "सन्दिग्धव्याप्यत्वासिद्धो यथा ‘स श्यामो मित्रा-तनयत्वात्’", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004284, "chapter_id": 8332, "verse_number": "8.3", "content_sanskrit": "पक्षविपक्षयोरेव वर्तमानो हेतुर्विरुद्धः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004285, "chapter_id": 8332, "verse_number": "8.4", "content_sanskrit": "असति सपक्षे प्रथमो यथा ‘शब्द आकाशविशेषगुणः प्रमेयत्वात्’ इति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004286, "chapter_id": 8332, "verse_number": "8.5", "content_sanskrit": "पक्षत्रयवृत्तिरनैकान्तिकः । सोऽपि बहुविधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900004287, "chapter_id": 8332, "verse_number": "8.6", "content_sanskrit": "साध्यासाधकः पक्ष एव वर्तमानो हेतुरनध्यवसितः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900004288, "chapter_id": 8332, "verse_number": "8.7", "content_sanskrit": "प्रमाणबाधितविषयः कालात्ययापदिष्टः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900004289, "chapter_id": 8332, "verse_number": "8.8", "content_sanskrit": "स्वपरपक्षसिद्धावपि त्रिरूपो हेतुः प्रकरणसमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900004290, "chapter_id": 8332, "verse_number": "8.9", "content_sanskrit": "समबलतयाऽभिमतप्रमाणविरुद्धः सत्प्रतिपक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]