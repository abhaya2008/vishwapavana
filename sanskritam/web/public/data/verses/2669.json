[{"id": 2078589, "chapter_id": 2669, "verse_number": "१२-१७४-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078590, "chapter_id": 2669, "verse_number": "१२-१७४-१", "content_sanskrit": "अतिक्रामति कालेऽस्मिन्सर्वभूतक्षयावहे।\nकिं श्रेयः प्रतिपद्येत तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078591, "chapter_id": 2669, "verse_number": "१२-१७४-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078592, "chapter_id": 2669, "verse_number": "१२-१७४-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nपितुः पुत्रेण संवादं तं निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078593, "chapter_id": 2669, "verse_number": "१२-१७४-३", "content_sanskrit": "द्विजातेः कस्यचित्पार्थ स्वाध्यायनिरतस्य वै।\nबभूव पुत्रो मेधावी मेधावीनाम नामतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078594, "chapter_id": 2669, "verse_number": "१२-१७४-४", "content_sanskrit": "सोऽब्रवीत्पितरं पुत्रः स्वाध्यायकरणे रतम्।\nमोक्षधर्मार्थकुशलो लोकतन्त्रविचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078595, "chapter_id": 2669, "verse_number": "१२-१७४-५x", "content_sanskrit": "पुत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078596, "chapter_id": 2669, "verse_number": "१२-१७४-५", "content_sanskrit": "धीरः किंस्वित्तात कुर्यात्प्रजानन्\nक्षिप्रं ह्यायुर्भ्रश्यते मानवानाम्।\nपितस्तदाचक्ष्व यथार्थयोगं\nममानुपूर्व्या येन धर्मं चरेयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078597, "chapter_id": 2669, "verse_number": "१२-१७४-६x", "content_sanskrit": "पितोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078598, "chapter_id": 2669, "verse_number": "१२-१७४-६", "content_sanskrit": "वेदानधीत्य ब्रह्मचर्येण पुत्र\nपुत्रानिच्छेत्पावनार्थं पितृणाम्।\nअग्नीनाधाय विधिवच्चेष्टयज्ञो\nवनं प्रविश्याथ मुनिर्बुभूषेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078599, "chapter_id": 2669, "verse_number": "१२-१७४-७x", "content_sanskrit": "पुत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078600, "chapter_id": 2669, "verse_number": "१२-१७४-७", "content_sanskrit": "एवमभ्याहते लोके समन्तात्परिवारिते।\nअमोघासु पतन्तीषु किं धीर इव भाषसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078601, "chapter_id": 2669, "verse_number": "१२-१७४-८x", "content_sanskrit": "पितोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078602, "chapter_id": 2669, "verse_number": "१२-१७४-८", "content_sanskrit": "कथमभ्याहतो लोकः केन वा परिवारितः।\nअमोघाः काः पतन्तीह किंनु भीषयसीव माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078603, "chapter_id": 2669, "verse_number": "१२-१७४-९x", "content_sanskrit": "पुत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078604, "chapter_id": 2669, "verse_number": "१२-१७४-९", "content_sanskrit": "मृत्युनाभ्याहतो लोको जरया परिवारितः।\nअहोरात्राः पतन्त्येते ननु कस्मान्न बुध्यसे।\nअमोघा रात्रयश्चापि नित्यमायान्ति यान्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078605, "chapter_id": 2669, "verse_number": "१२-१७४-१०x", "content_sanskrit": "पितोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078606, "chapter_id": 2669, "verse_number": "१२-१७४-१०", "content_sanskrit": "यथाऽहमेतज्जानामि न मृत्युस्तिष्ठतीति ह।\nसोऽहं कथं प्रतीक्षिष्ये जालेनेवावृतश्चरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078607, "chapter_id": 2669, "verse_number": "१२-१७४-११x", "content_sanskrit": "पुत्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078608, "chapter_id": 2669, "verse_number": "१२-१७४-११", "content_sanskrit": "रात्र्यांरात्र्यां व्यतीतायामायुरल्पतरं यदा।\nतदैव बन्ध्यं दिवसमिति विन्द्याद्विचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078609, "chapter_id": 2669, "verse_number": "१२-१७४-१२", "content_sanskrit": "गाधोदके मत्स्य इव सुखं विन्देत कस्तदा।\nअनवाप्तेषु कामेषु मृत्युरभ्योति मानवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078610, "chapter_id": 2669, "verse_number": "१२-१७४-१३", "content_sanskrit": "पुष्पाणीव विचिन्वन्तमन्यत्र गतमानसम्।\nवृकीवोरणमासाद्य मृत्युरादाय गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078611, "chapter_id": 2669, "verse_number": "१२-१७४-१४", "content_sanskrit": "अद्यैव कुरु यच्छ्रेयो मा त्वां कालोऽत्यगादयम्।\nअकृतेष्वेव कार्येषु मृत्युर्वै संप्रकर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078612, "chapter_id": 2669, "verse_number": "१२-१७४-१५", "content_sanskrit": "श्वः कार्यमद्य कुर्वीत पूर्वाह्णे चापराह्णिकम्।\nनहि प्रतीक्षते मृत्युः कृतमस्य न वा कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078613, "chapter_id": 2669, "verse_number": "१२-१७४-१६", "content_sanskrit": "को हि जानाति कस्याद्य मृत्युकालो भविष्यति।\nयुवैव धर्मशीलः स्यादनित्यं खलु जीवितम्।\nकृते धर्मे भवेत्कीर्तिरिह प्रेत्य च वै सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078614, "chapter_id": 2669, "verse_number": "१२-१७४-१७", "content_sanskrit": "मोहेन हि समाविष्टः पुत्रदारार्थमुद्यतः।\nकृत्वा कार्यमकार्यं वा पुष्टिमेषां प्रयच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2078615, "chapter_id": 2669, "verse_number": "१२-१७४-१८", "content_sanskrit": "तं पुत्रपशुसंपन्नं व्यासक्तमनसं नरम्।\nसुप्तं व्याघ्रो मृगमिव मृत्युरादाय गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2078616, "chapter_id": 2669, "verse_number": "१२-१७४-१९", "content_sanskrit": "संचिन्वानकमेवैनं कामानामवितृप्तकम्।\nव्याघ्रः पशुमिवादाय मृत्युरादाय गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2078617, "chapter_id": 2669, "verse_number": "१२-१७४-२०", "content_sanskrit": "इदं कृतमिदं कार्यमिदमन्यत्कृताकृतम्।\nएवमीहासुखासक्तं कृतान्तः कुरुते वशे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2078618, "chapter_id": 2669, "verse_number": "१२-१७४-२१", "content_sanskrit": "कृतानां फलमप्राप्तं कर्मणां कर्मसंज्ञितम्।\nक्षेत्रापणगृहासक्तं मृत्युरादाय गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2078619, "chapter_id": 2669, "verse_number": "१२-१७४-२२", "content_sanskrit": "दुर्बलं बलवन्तं च शूरं भीरुं जडं कविम्।\nअप्राप्तं सर्वकामार्थान्मृत्युरादाय गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2078620, "chapter_id": 2669, "verse_number": "१२-१७४-२३", "content_sanskrit": "नृत्युर्जरा च व्याधिश्च दुःखं चानेककारणम्।\nअनुषक्तं यदा देहे किं स्वस्थ इव तिष्ठसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2078621, "chapter_id": 2669, "verse_number": "१२-१७४-२४", "content_sanskrit": "जातमेवान्तकोऽन्ताय जरा चान्वेति देहिनम्।\nअनुषक्ता द्वयेनैते भावाः स्थावरजङ्गमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2078622, "chapter_id": 2669, "verse_number": "१२-१७४-२५", "content_sanskrit": "अत्योर्वा मुखमेतद्वै या ग्रामे वसतो रतिः।\nवानामेष वै गोष्ठो यदरण्यमिति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2078623, "chapter_id": 2669, "verse_number": "१२-१७४-२६", "content_sanskrit": "तेबन्धनी रज्जुरेषा या ग्रामे वसतो रवि।\nछेत्त्वेता सुकृतो यान्ति नैनां छिन्दन्ति दुष्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2078624, "chapter_id": 2669, "verse_number": "१२-१७४-२७", "content_sanskrit": "हिंसयति यो जन्तून्मनोवाक्कायहेतुभिः।\nजीवितार्थापनयनैः प्राणिभिर्न स हिंस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2078625, "chapter_id": 2669, "verse_number": "१२-१७४-२८", "content_sanskrit": "न मृत्युसेनामायान्तीं जातु कश्चित्प्रबाधते।\nऋते सत्यमसत्त्याज्यं सत्ये ह्यमृतमाश्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2078626, "chapter_id": 2669, "verse_number": "१२-१७४-२९", "content_sanskrit": "तस्मात्सत्यव्रताचारः सत्ययोगपरायणः।\nसत्यागमः सदा दान्तः सत्येनैवान्तकं जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2078627, "chapter_id": 2669, "verse_number": "१२-१७४-३०", "content_sanskrit": "अमृतं चैव मृत्युश्च द्वयं देहे प्रतिष्ठितम्।\nमृत्युरापद्यते मोहात्सत्येनापद्यतेऽमृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2078628, "chapter_id": 2669, "verse_number": "१२-१७४-३१", "content_sanskrit": "सोऽहं ह्यहिंस्रः सत्यार्थी कामक्रोधबहिष्कृतः।\nसमदुःखसुखः क्षेमी मृत्युंहास्याम्यमर्त्यवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2078629, "chapter_id": 2669, "verse_number": "१२-१७४-३२", "content_sanskrit": "शान्तियज्ञरतो दान्तो ब्रह्मयज्ञे स्थितो मुनिः।\nवाङ्भनः कर्मयज्ञश्च भविष्याम्युदगायने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2078630, "chapter_id": 2669, "verse_number": "१२-१७४-३३", "content_sanskrit": "पशुयज्ञैः कथं हिंस्रैर्मादृशो चष्टुमर्हति।\nअन्तवद्भिरिव प्राज्ञः क्षेत्रयज्ञैः पिशाचवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2078631, "chapter_id": 2669, "verse_number": "१२-१७४-३४", "content_sanskrit": "यस्य वाङ्भनसी स्यातां सम्यक्प्रणिहिते सदा।\nतपस्त्यागश्च सत्यं च स वै सर्वमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2078632, "chapter_id": 2669, "verse_number": "१२-१७४-३५", "content_sanskrit": "नास्ति विद्यासमं चक्षुर्नास्ति सत्यसमं तपः।\nनास्ति रागसमंदुःखं नास्ति त्यागसमं सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2078633, "chapter_id": 2669, "verse_number": "१२-१७४-३६", "content_sanskrit": "आत्मन्येवात्मना जात आत्मनिष्ठोऽप्रजोपि वा।\nआत्मन्येव भविष्यामि न मां तारयति प्रजा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2078634, "chapter_id": 2669, "verse_number": "१२-१७४-३७", "content_sanskrit": "नैतादृशं ब्राह्मणस्यास्ति वित्तं\nयथैकता समता सत्यता च।\nशीलं स्थितिर्दण्डनिधानमार्जवं\nततस्ततश्चोपरभः क्रियाभ्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2078635, "chapter_id": 2669, "verse_number": "१२-१७४-३८", "content_sanskrit": "किं ते धनैर्बान्धवैर्वापि किं ते\nकिं ते दारैर्ब्राह्मण यो मरिष्यसि।\nआत्मानमन्विच्छ गुहां प्रविष्टं\nपितामहास्ते क्व गताः पिता च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2078636, "chapter_id": 2669, "verse_number": "१२-१७४-३९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2078637, "chapter_id": 2669, "verse_number": "१२-१७४-३९", "content_sanskrit": "पुत्रस्यैतद्वचः श्रुत्वा यथाऽकार्षीत्पिता नृप।\nतथा त्वमपि वर्तस्व सत्यधर्मपरायणः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2078638, "chapter_id": 2669, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चतुःसप्तत्यधिकशततमोऽध्यायः॥ १७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]