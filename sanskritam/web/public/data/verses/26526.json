[{"id": 7006526000, "chapter_id": 26526, "verse_number": "३-६५-१", "content_sanskrit": "विजयिनं बलिनं प्रति राजलक्ष्म्यादीनां शुमागमनम् वैशम्पायन उवाच निष्प्रयत्नेषु देवेषु त्रैलोक्ये दैत्यपालिते ।\nजये बलेर्बलवतो मयशम्बरयोस्तथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006526001, "chapter_id": 26526, "verse_number": "३-६५-२", "content_sanskrit": "सुधासु दिक्षु सर्वासु प्रवृत्ते धर्मकर्मणि ।\nअपावृत्ते धर्मपथे अयनस्थे दिवाकरे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006526002, "chapter_id": 26526, "verse_number": "३-६५-३", "content_sanskrit": "प्रह्रादशम्बरमयैरनुह्रादेन चैव हि ।\nदिक्षु सर्वासु गुप्तासु गगने दैत्यपालिते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006526003, "chapter_id": 26526, "verse_number": "३-६५-४", "content_sanskrit": "दैत्येषु मखशोभाश्च स्वर्गार्थं दर्शयत्सु च ।\nप्रकृतिस्थे तदा लोके वर्तमाने च सत्पथे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006526004, "chapter_id": 26526, "verse_number": "३-६५-५", "content_sanskrit": "अभावे सर्वपापानां भावे चैव तथा स्थिते ।\nभावे तपसि सिद्धानां सर्वत्राश्रमरक्षिषु ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006526005, "chapter_id": 26526, "verse_number": "३-६५-६", "content_sanskrit": "चतुष्पादे स्थिते धर्मे अधर्मे पादविग्रहे ।\nप्रजापालनयुक्तेषु भ्राजमानेषु राजसु ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006526006, "chapter_id": 26526, "verse_number": "३-६५-७", "content_sanskrit": "स्वधर्मसम्प्रयुक्तेषु सर्वाश्रमनिवासिषु ।\nअभिषिक्तोऽसुरैः सर्वैर्दैत्यराजो बलिस्तदा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006526007, "chapter_id": 26526, "verse_number": "३-६५-८", "content_sanskrit": "हृष्टेष्वसुरसंघेषु नदत्सु मुदितेषु च ।\nअथाभ्युपगता लक्ष्मीर्बलिं पद्मासने स्थिता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006526008, "chapter_id": 26526, "verse_number": "३-६५-९", "content_sanskrit": "पद्मोद्यतकरा देवी वरदा सुरमोहिनी ।\nश्रीरुवाच बले बलवतां श्रेष्ठ महाराज महाद्युते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006526009, "chapter_id": 26526, "verse_number": "३-६५-१०", "content_sanskrit": "प्रीतास्मि तव भद्रं ते देवतानां पराजये ।\nयस्त्वया युधि विक्रम्य देवराजः पराजितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006526010, "chapter_id": 26526, "verse_number": "३-६५-११", "content_sanskrit": "दृष्ट्वा ते परमं सत्त्वं ततोऽहं स्वयमागता ।\nनाश्चर्यं दानवश्रेष्ठ हिरण्यकशिपोः कुले ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006526011, "chapter_id": 26526, "verse_number": "३-६५-१२", "content_sanskrit": "प्रसूतस्यासुरेन्द्रस्य तव कर्मेदमीदृशम् ।\nविशेषितस्त्वया राजन् दैत्येन्द्रः प्रपितामहः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006526012, "chapter_id": 26526, "verse_number": "३-६५-१३", "content_sanskrit": "येन भुक्तं हि निखिलं त्रैलोक्यमिदमव्ययम् ।\nविशेषतस्तव विभो सर्वे धर्मपथे स्थिताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006526013, "chapter_id": 26526, "verse_number": "३-६५-१४", "content_sanskrit": "तेन त्रैलोक्यमुख्येन भोक्ष्यस्यमितविक्रम ।\nएवमुक्त्वा हि सा देवी लक्ष्मीर्दैत्यपतिं बलिम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006526014, "chapter_id": 26526, "verse_number": "३-६५-१५", "content_sanskrit": "प्रविष्टा वरदा सौम्या सर्वभूतमनोरमा ।\nशिष्टाश्च देव्यः प्रवरा ह्रीः कीर्तिर्द्युतिरेव च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006526015, "chapter_id": 26526, "verse_number": "३-६५-१६", "content_sanskrit": "प्रभा धृतिः क्षमा भूतिर्नीतिर्विद्यादया स्मृतिः ।\nकृतिर्लज्जा तथा मेधा लक्ष्मीरीहा गतिस्तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006526016, "chapter_id": 26526, "verse_number": "३-६५-१७", "content_sanskrit": "श्रुतिः प्रीतिरिला कीर्तिः शान्तिः पुष्टिः क्रियास्तथा ।\nसर्वाश्चाप्सरसो दिव्या नृत्यगीतविशारदाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006526017, "chapter_id": 26526, "verse_number": "३-६५-१८", "content_sanskrit": "पतिं प्राप्ताः सुदैतेयं त्रैलोक्ये सचराचरे ।\nप्राप्तमैश्वर्यममितं बलिना ब्रह्मवादिना ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]