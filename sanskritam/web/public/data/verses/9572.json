[{"id": 5000572000, "chapter_id": 9572, "verse_number": "७-३७-१", "content_sanskrit": "अभिषिक्ते तु काकुत्स्थे धर्मेण विदितात्मनि ।\nव्यतीता या निशा पूर्वा पौराणां हर्षवर्धिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000572001, "chapter_id": 9572, "verse_number": "७-३७-२", "content_sanskrit": "तस्यां रजन्यां व्युष्टायां प्रातर्नृपतिबोधकाः ।\nवन्दिनः समुपातिष्ठन्सौम्या नृपतिवेश्मनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000572002, "chapter_id": 9572, "verse_number": "७-३७-३", "content_sanskrit": "ते रक्तकण्ठिनः सर्वे किन्नरा इव शिक्षिताः ।\nतुष्टुवुर्नपतिं वीरं यथावत् सम्प्रहर्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000572003, "chapter_id": 9572, "verse_number": "७-३७-४", "content_sanskrit": "वीर सौम्य प्रबुध्यस्व कौसल्याप्रीतिवर्धन ।\nजगद्धि सर्वं स्वपिति त्वयि सुप्ते नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000572004, "chapter_id": 9572, "verse_number": "७-३७-५", "content_sanskrit": "विक्रमस्ते यथा विष्णो रूपं चैवाश्विनोरिव ।\nबुद्ध्या बृहस्पतेस्तुल्यः प्रजापतिसमो ह्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000572005, "chapter_id": 9572, "verse_number": "७-३७-६", "content_sanskrit": "क्षमा ते पृथिवीतुल्या तेजसा भास्करोपमः ।\nवेगस्ते वायुना तुल्यो गाम्भीर्यमुदधेरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000572006, "chapter_id": 9572, "verse_number": "७-३७-७", "content_sanskrit": "अप्रकम्प्यो यता स्थाणुश्चन्द्रे सौम्यत्वमीदृशम् ।\nनेदृशाः पार्थिवाः पूर्वं भवितारो नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000572007, "chapter_id": 9572, "verse_number": "७-३७-८", "content_sanskrit": "यथा त्वमतिदुर्धर्षो धर्मनित्यः प्रजाहितः ।\nन त्वां जहाति कीर्तिश्च लक्ष्मीश्च पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000572008, "chapter_id": 9572, "verse_number": "७-३७-९", "content_sanskrit": "श्रीश्च धर्मश्च काकुत्स्थ त्वयि नित्यं प्रतिष्ठितौ ।\nएताश्चान्याश्च मधुरा वन्दिभिः परिकीर्तिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000572009, "chapter_id": 9572, "verse_number": "७-३७-१०", "content_sanskrit": "सूताश्च संस्तवैर्दिव्यैर्बोधयन्ति स्म राघवम् ।\nस्तुतिभिः स्तूयमानाभिः प्रत्यबुध्यत राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000572010, "chapter_id": 9572, "verse_number": "७-३७-११", "content_sanskrit": "स तद्विहाय शयनं पाण्डराच्छादनास्तृतम् ।\nउत्तस्थौ नागशयनाद्धरिर्नारायणो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000572011, "chapter_id": 9572, "verse_number": "७-३७-१२", "content_sanskrit": "तमुत्थितं महात्मानं प्रह्वाः प्राञ्जलयो नराः ।\nसलिलं भाजनैः शुभ्रैरुपतस्थुः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000572012, "chapter_id": 9572, "verse_number": "७-३७-१३", "content_sanskrit": "कृतोदकशुचिर्भूत्वा काले हुतहुताशनः ।\nदेवागारं जगामाशु पुण्यमिक्ष्वाकुसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000572013, "chapter_id": 9572, "verse_number": "७-३७-१४", "content_sanskrit": "तत्र देवान्पितऽन्विप्रानर्चयित्वा यथाविधि ।\nबाह्यकक्षान्तरं रामो निर्जगाम जनैर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000572014, "chapter_id": 9572, "verse_number": "७-३७-१५", "content_sanskrit": "उपतस्थुर्महात्मानो मन्त्रिणः सपुरोहिताः ।\nवसिष्ठप्रमुखाः सर्वे दीप्यमाना इवाग्नयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000572015, "chapter_id": 9572, "verse_number": "७-३७-१६", "content_sanskrit": "क्षत्रियाश्च महात्मानो नानाजनपदेश्वराः ।\nरामस्योपाविशन्पार्श्वे शक्रस्येव यथा ऽमराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000572016, "chapter_id": 9572, "verse_number": "७-३७-१७", "content_sanskrit": "भरतो लक्ष्मणश्चात्र शत्रुघ्नश्च महायशाः ।\nउपासाञ्चक्रिरे हृष्टा वेदास्त्रय इवाध्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000572017, "chapter_id": 9572, "verse_number": "७-३७-१८", "content_sanskrit": "याताः प्राञ्जलयो भूत्वा किङ्करा मुदिताननाः ।\nमुदिता नाम पार्श्वस्था बहवः समुपाविशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000572018, "chapter_id": 9572, "verse_number": "७-३७-१९", "content_sanskrit": "वानराश्च महावीर्या विंशतिः कामरूपिणः ।\nसुग्रीवप्रमुखा राममुपासन्ते महौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000572019, "chapter_id": 9572, "verse_number": "७-३७-२०", "content_sanskrit": "विभीषणश्च रक्षोभिश्चतुर्भिः परिवारितः ।\nउपासते महात्मानं धनेशमिव गुह्यकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000572020, "chapter_id": 9572, "verse_number": "७-३७-२१", "content_sanskrit": "तथा निगमवृद्धाश्च कुलीना ये च मानवाः ।\nशिरसा ऽ ऽवन्द्य राजानमुपासन्ते विचक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000572021, "chapter_id": 9572, "verse_number": "७-३७-२२", "content_sanskrit": "तथा परिवृतो राजा श्रीमद्भिर्ऋषिभिर्वृतः ।\nराजभिश्च महावीर्यैर्वानरैश्च सराक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000572022, "chapter_id": 9572, "verse_number": "७-३७-२३", "content_sanskrit": "यथा देवेश्वरो नित्यमृषिभिः समुपास्यते ।\nअधिकस्तेन रूपेण सहस्राक्षाद्विरोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000572023, "chapter_id": 9572, "verse_number": "७-३७-२४", "content_sanskrit": "तेषां समुपविष्टानां तास्ताः सुमधुराः कथाः ।\nकथ्यन्ते धर्मसंयुक्ताः पुराणज्ञैर्महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000572024, "chapter_id": 9572, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे सप्तत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]