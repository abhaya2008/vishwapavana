[{"id": 7004435000, "chapter_id": 24435, "verse_number": "५-३-१२९-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेन्महीपाल ब्रह्मतीर्थमनुत्तमम् ।\nअन्येषां चैव तीर्थानां परात्परतरं महत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004435001, "chapter_id": 24435, "verse_number": "५-३-१२९-२", "content_sanskrit": "तत्र तीर्थे सुरश्रेष्ठो ब्रह्मा लोकपितामहः ।\nचतुर्णामपि वर्णानां नर्मदातटमाश्रितः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004435002, "chapter_id": 24435, "verse_number": "५-३-१२९-३", "content_sanskrit": "वाचिकं मानसं पापं कर्मजं यत्पुराकृतम् ।\nतत्क्षालयति देवेशो दर्शनादेव पातकम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004435003, "chapter_id": 24435, "verse_number": "५-३-१२९-४", "content_sanskrit": "श्रुतिस्मृत्युदितान्येव तत्र स्नात्वा द्विजर्षभाः ।\nप्रायश्चित्तानि कुर्वन्ति तेषां वासस्त्रिविष्टपे॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004435004, "chapter_id": 24435, "verse_number": "५-३-१२९-५", "content_sanskrit": "ये पुनः शास्त्रमुत्सृज्य कामलोभप्रपीडिताः ।\nप्रायश्चित्तं वदिष्यन्ति ते वै निरयगामिनः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004435005, "chapter_id": 24435, "verse_number": "५-३-१२९-६", "content_sanskrit": "स्नात्वादौ पातकी ब्रह्मन्नत्वा तु कीर्तयेदघम् ।\nतस्य तन्नश्यते क्षिप्रं तमः सूर्योदये यथा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004435006, "chapter_id": 24435, "verse_number": "५-३-१२९-७", "content_sanskrit": "तत्र तीर्थे तु यः स्नात्वा पूजयेत्पितृदेवताः ।\nअग्निष्टोमस्य यज्ञस्य स लभेत्फलमुत्तमम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004435007, "chapter_id": 24435, "verse_number": "५-३-१२९-८", "content_sanskrit": "तत्र तीर्थे तु यद्दानं ब्रह्मोद्दिश्य प्रयच्छति ।\nतदक्षयफलं सर्वमित्येवं शङ्करोऽब्रवीत्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004435008, "chapter_id": 24435, "verse_number": "५-३-१२९-९", "content_sanskrit": "गायत्रीसारमात्रोऽपि तत्र यः क्रियते जपः ।\nऋग्यजुःसामसहितः स भवेन्नात्र संशयः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004435009, "chapter_id": 24435, "verse_number": "५-३-१२९-१०", "content_sanskrit": "तत्र तीर्थे तु यो भक्त्या त्यजेद्देहं सुदुस्त्यजम् ।\nअनिवर्तिका गतिस्तस्य ब्रह्मलोकान्न संशयः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004435010, "chapter_id": 24435, "verse_number": "५-३-१२९-११", "content_sanskrit": "यावदस्थीनि तिष्ठन्ति ब्रह्मतीर्थे च देहिनाम् ।\nतावद्वर्षसहस्राणि देवलोके महीयते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004435011, "chapter_id": 24435, "verse_number": "५-३-१२९-१२", "content_sanskrit": "अवतीर्णस्ततो लोके ब्रह्मज्ञो जायते कुले ।\nउत्तमः सर्ववर्णानां देवानामिव देवता॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004435012, "chapter_id": 24435, "verse_number": "५-३-१२९-१३", "content_sanskrit": "विद्यास्थानानि सर्वाणि वेत्ति वेदाङ्गपारगः ।\nजायते पूजितो लोके राजभिः स न संशयः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004435013, "chapter_id": 24435, "verse_number": "५-३-१२९-१४", "content_sanskrit": "पुत्रपौत्रसमोपेतः सर्वव्याधिविवर्जितः ।\nजीवेद्वर्षशतं साग्रं ब्रह्मतीर्थप्रभावतः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004435014, "chapter_id": 24435, "verse_number": "५-३-१२९-१५", "content_sanskrit": "एतत्पुण्यं पापहरं तीर्थं ज्ञानवतां वरम् ।\nये पश्यन्ति महात्मानो ह्यमृतत्वं प्रयान्ति ते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]