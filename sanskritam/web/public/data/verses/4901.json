[{"id": 2183733, "chapter_id": 4901, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2183734, "chapter_id": 4901, "verse_number": "१", "content_sanskrit": "न सन्ति कुलजा यत्र सहायाः पार्थिवस्य तु ।\nअकुलीनाश्च कर्तव्या न वा भारतसत्तम\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2183735, "chapter_id": 4901, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2183736, "chapter_id": 4901, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nनिदर्शनकरं लोके सज्जनाचरितं सदा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2183737, "chapter_id": 4901, "verse_number": "३", "content_sanskrit": "अस्यैवार्थस्य सदृशं यच्छ्रुतं मे तपोवने ।\nजामदग्न्यस्य रामस्य यदुक्तमृषिसत्तमैः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2183738, "chapter_id": 4901, "verse_number": "४", "content_sanskrit": "वने महति कस्मिंश्चिदमनुष्यनिषेविते ।\nऋषिर्मूलफलाहारो नियतो नियतेन्द्रियः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2183739, "chapter_id": 4901, "verse_number": "५", "content_sanskrit": "दीक्षादमपरः शान्तः स्वाध्यायपरमः शुचिः ।\nउपवासविशुद्धात्मा सततं सत्पथे स्थितः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2183740, "chapter_id": 4901, "verse_number": "६", "content_sanskrit": "तस्य सन्दृश्य सद्भावमुपविष्टस्य धीमतः ।\nसर्वसत्त्वाः समीपस्था भवन्ति वनचारिणः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2183741, "chapter_id": 4901, "verse_number": "७", "content_sanskrit": "सिंहव्याघ्राः सशरभा मत्ताश्चैव महागजाः ।\nद्वीपिनः खड्गभल्लूका ये चान्ये भीमदर्शनाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2183742, "chapter_id": 4901, "verse_number": "८", "content_sanskrit": "ते सुखप्रश्नदाः सर्वे भवन्ति क्षतजाशनाः ।\nतस्यर्षेः शिष्यवच्चैव न्यग्भूताः प्रियकारिणः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2183743, "chapter_id": 4901, "verse_number": "९", "content_sanskrit": "दत्वा च ते सुखप्रश्नं सर्वे यान्ति यथागतम् ।\nग्राम्यस्त्वेकः पशुस्तत्र नाजहात् स महामुनिम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2183744, "chapter_id": 4901, "verse_number": "१०", "content_sanskrit": "भक्तोऽनुरक्तः सततमुपवासकृशोऽबलः ।\nफलमूलोत्कराहारः शान्तः शिष्टाकृतिर्यथा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2183745, "chapter_id": 4901, "verse_number": "११", "content_sanskrit": "तस्यर्षेरुपविष्टस्य पादमूले महामुनेः ।\nमनुष्यवद् गतो भावः स्नेहबद्धोऽभवद् भृशम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2183746, "chapter_id": 4901, "verse_number": "१२", "content_sanskrit": "ततोऽभ्ययान्महावीर्यो द्वीपी क्षतजभोजनः ।\nश्वार्थमत्यन्तसन्दुष्टः क्रूरः काल इवान्तकः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2183747, "chapter_id": 4901, "verse_number": "१३", "content_sanskrit": "लेलिह्यमानस्तृषितः पुच्छास्फोटनतत्परः ।\nव्यादितास्यः क्षुधाभग्नः प्रार्थयानस्तदामिषम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2183748, "chapter_id": 4901, "verse_number": "१४", "content_sanskrit": "तं दृष्ट्वा क्रूरमायान्तं जीवितार्थी नराधिप ।\nप्रोवाच श्वा मुनिं तत्र यत् तच्छृणु महामते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2183749, "chapter_id": 4901, "verse_number": "१५", "content_sanskrit": "श्वशत्रुर्भगवन्नत्र द्वीपी मां हन्तुमिच्छति ।\nत्वत्प्रसादाद् भयं न स्यात् तस्मान्मम महामुने\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2183750, "chapter_id": 4901, "verse_number": "", "content_sanskrit": "मुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2183751, "chapter_id": 4901, "verse_number": "१६", "content_sanskrit": "न भयं द्वीपिनः कार्यं मृत्युतस्ते कथञ्चन ।\nएष श्वरूपरहितो द्वीपी भवसि पुत्रक\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2183752, "chapter_id": 4901, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2183753, "chapter_id": 4901, "verse_number": "१७", "content_sanskrit": "ततः श्वा द्वीपितां नीतो जाम्बूनदनिभाकृतिः ।\nचित्राङ्गो विस्फुरद्दंष्ट्रो हृष्टो वने वसति निर्भयः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2183754, "chapter_id": 4901, "verse_number": "१८", "content_sanskrit": "तं दृष्ट्वा स पुनर्द्वीपी आत्मनः सदृशं शुभम् ।\nअविरुद्धस्ततस्तस्य क्षणेन समपद्यत\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2183755, "chapter_id": 4901, "verse_number": "१९", "content_sanskrit": "ततोऽभ्ययान्महारौद्रो व्यादितास्यः क्षुधान्वितः ।\nद्वीपिनं लेलिहद्वक्त्रो व्याघ्रो रुधिरलालसः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2183756, "chapter_id": 4901, "verse_number": "२०", "content_sanskrit": "व्याघ्रं दृष्ट्वा क्षुधाभग्नं दंष्ट्रिणं वनगोचरम् ।\nद्वीपी जीवितरक्षार्थमृषिं शरणमेयिवान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2183757, "chapter_id": 4901, "verse_number": "२१", "content_sanskrit": "ततः संवासजं स्नेहमृषिणा कुर्वता सदा ।\nस द्वीपी व्याघ्रतां नीतो रिपुभिर्बलवत्तरः ।\nततो दृष्ट्वा स शार्दूलो नाभ्यहंस्तं विशाम्पते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2183758, "chapter_id": 4901, "verse_number": "२२", "content_sanskrit": "स तु श्वा व्याघ्रतां प्राप्य बलवान् पिशिताशनः ।\nन मूलफलभोगेषु स्पृहामप्यकरोत् तदा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2183759, "chapter_id": 4901, "verse_number": "२३", "content_sanskrit": "यथा मृगपतिर्नित्यं प्रकाङ्क्षति वनौकसः ।\nतथैव स महाराज व्याघ्रः समभवत् तदा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2183760, "chapter_id": 4901, "verse_number": "२४", "content_sanskrit": "व्याघ्रस्तूटजमूलस्थस्तृप्तः सुप्तो हतैर्मृगैः ।\nनागश्चागात् तमुद्देशं मत्तो मेघ इवोत्थितः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2183761, "chapter_id": 4901, "verse_number": "२५", "content_sanskrit": "प्रभिन्नकरटः प्रांशुः पद्मी विततमस्तकः ।\nसुविषाणो महाकायो मेघगम्भीरनिस्वनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2183762, "chapter_id": 4901, "verse_number": "२६", "content_sanskrit": "तं दृष्ट्वा कुञ्जरं मत्तमायान्तं मदगर्वितम् ।\nव्याघ्रो हस्तिभयात् त्रस्तस्तमृषिं शरणं ययौ\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2183763, "chapter_id": 4901, "verse_number": "२७", "content_sanskrit": "ततोऽनयत् कुञ्जरतां तं व्याघ्रमृषिसत्तमः ।\nमहामेघोपमं दृष्ट्वा तं स भीतोऽभवद् गजः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2183764, "chapter_id": 4901, "verse_number": "२८", "content_sanskrit": "ततः कमलषण्डानि शल्यकीगहनानि च ।\nव्यचरत् स मुदा युक्तः पद्मरेणुविभूषितः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2183765, "chapter_id": 4901, "verse_number": "२९", "content_sanskrit": "कदाचिद् रममाणस्य हस्तिनः सुसुखं तदा ।\nऋषेस्तस्योटजस्थस्य कालोऽगच्छन्निशानिशम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2183766, "chapter_id": 4901, "verse_number": "३०", "content_sanskrit": "अथाजगाम तं देशं केसरी केसरारुणः ।\nगिरिकन्दरजो भीमः सिंहो नागकुलान्तकः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2183767, "chapter_id": 4901, "verse_number": "३१", "content_sanskrit": "तं दृष्ट्वा सिंहमायान्तं नागः सिंहभयाकुलः ।\nऋषिं शरणमापेदे वेपमानो भयातुरः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2183768, "chapter_id": 4901, "verse_number": "३२", "content_sanskrit": "ततः स सिंहतां नीतो नागेन्द्रो मुनिना तदा ।\nवन्यं नागणयत् सिंहं तुल्यजातिसमन्वयात्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2183769, "chapter_id": 4901, "verse_number": "३३", "content_sanskrit": "दृष्ट्वा च सोऽनशत् सिंहो वन्यो भीसन्नवाग्बलः ।\nस चाश्रमेऽवसत् सिंहस्तस्मिन्नेव वने सुखी\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2183770, "chapter_id": 4901, "verse_number": "३४", "content_sanskrit": "न त्वन्ये क्षुद्रपशवस्तपोवननिवासिनः ।\nव्यदृश्यन्त भयत्रस्ता जीविताकाङ्क्षिणः सदा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2183771, "chapter_id": 4901, "verse_number": "३५", "content_sanskrit": "कदाचित् कालयोगेन सर्वप्राणिविहिंसकः ।\nबलवान् क्षतजाहारो नानासत्त्वभयङ्करः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2183772, "chapter_id": 4901, "verse_number": "३६", "content_sanskrit": "अष्टपादोऽर्धनयनः शरभो वनगोचरः ।\nतं सिंहं हन्तुमागच्छन्मुनेस्तस्य निवेशनम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2183773, "chapter_id": 4901, "verse_number": "३७", "content_sanskrit": "तं मुनिः शरभं चक्रे बलोत्कटमरिन्दम ।\nततः स शरभो वन्यो मुनेः शरभमग्रतः ।\nदृष्ट्वा बलिनमत्युग्रं द्रुतं सम्प्राद्रवद् भयात्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2183774, "chapter_id": 4901, "verse_number": "३८", "content_sanskrit": "स एवं शरभस्थाने न्यस्तो वै मुनिना तदा ।\nमुनेः पार्श्वगतो नित्यं शारभ्यं सुखमाप्तवान्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2183775, "chapter_id": 4901, "verse_number": "३९", "content_sanskrit": "ततः शरभसन्त्रस्ताः सर्वे मृगगणा वनात् ।\nदिशः सम्प्राद्रवन् राजन् भयाज्जीवितकाङ्क्षिणः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2183776, "chapter_id": 4901, "verse_number": "४०", "content_sanskrit": "शरभोऽप्यतिसन्दुष्टो नित्यं प्राणिवधे रतः ।\nफलमूलाशनं शान्तं नैच्छत् स पिशिताशनः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2183777, "chapter_id": 4901, "verse_number": "४१", "content_sanskrit": "ततो रुधिरतर्षेण बलिना शरभोऽन्वितः ।\nइयेष तं मुनिं हन्तुमकृतज्ञः श्वयोनिजः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2183778, "chapter_id": 4901, "verse_number": "४२", "content_sanskrit": "चिन्तयामास च तदा शरभः श्वानपूर्वकः ।\nअस्य प्रभावात् सम्प्राप्तो वाङ्मात्रेण तु केवलम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2183779, "chapter_id": 4901, "verse_number": "४३", "content_sanskrit": "शरभत्वं सुदुष्प्रापं सर्वभूतभयङ्करम् ।\nअन्येऽप्यत्र भयत्रस्ता मृगाः पक्षिगणास्तथा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2183780, "chapter_id": 4901, "verse_number": "४४", "content_sanskrit": "तेषामपि कदाचिच्च शरभत्वं प्रयच्छति ।\nसर्वसत्त्वोत्तमे लोके बलं यत्र प्रतिष्ठितम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2183781, "chapter_id": 4901, "verse_number": "४५", "content_sanskrit": "पक्षिणामप्ययं दद्यात् कदाचिद् गारुडं बलम् ।\nयावदन्यत्र सम्प्रीतः कारुण्यं च समाश्रितः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2183782, "chapter_id": 4901, "verse_number": "४६", "content_sanskrit": "न ददाति बलं तुष्टं सत्त्वस्यान्यस्य कस्यचित् ।\nतावदेनमहं विप्रं वधिष्यामि च शीघ्रतः ।\nस्थातुं मया शक्यमिह मुनिघातान्न संशयः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2183783, "chapter_id": 4901, "verse_number": "४७", "content_sanskrit": "ततस्तेन तपःशक्त्या विदितो ज्ञानचक्षुषा ।\nविज्ञाय च महाप्राज्ञो मुनिः श्वानं तमुक्तवान्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2183784, "chapter_id": 4901, "verse_number": "", "content_sanskrit": "मुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2183785, "chapter_id": 4901, "verse_number": "४८", "content_sanskrit": "अहमग्निप्रभो नाम मुनिर्भृगुकुलान्वयः ।\nमनसा निर्दहे सर्वं जगत् सन्धारयामि च\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2183786, "chapter_id": 4901, "verse_number": "४९", "content_sanskrit": "मम वश्यं जगत् सर्वं देवान् वर्ज्यं चराचरम् ।\nसन्ति देवाश्च मे भीताः स्वधर्मं न त्यजन्ति ये ।\nस्वधर्माच्चलितान् सर्वान् वाङ्मात्रेणैव निर्दहे\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2183787, "chapter_id": 4901, "verse_number": "५०", "content_sanskrit": "किमङ्ग त्वं मयाऽनेन शरभत्वमनामयम् ।\nक्रूरः स सर्वभूतेषु हीनश्चाशुचिरेव च ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2183788, "chapter_id": 4901, "verse_number": "५१", "content_sanskrit": "श्वा त्वं द्वीपित्वमापन्नो द्वीपी व्याघ्रत्वमागतः ।\nव्याघ्रो नागो मदपटुर्नागः सिंहत्वमाप्तवान्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2183789, "chapter_id": 4901, "verse_number": "५२", "content_sanskrit": "सिंहोऽतिबलसंयुक्तो भूयः शरभतां गतः ।\nमया स्नेहपरीतेन न विमृष्टः कुलान्वयः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2183790, "chapter_id": 4901, "verse_number": "५३", "content_sanskrit": "यस्मादेवमपापं मां पाप हिंसितुमिच्छसि ।\nतस्मात् स्वयोनिमापन्नः श्वैव त्वं हि भविष्यसि\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2183791, "chapter_id": 4901, "verse_number": "५४", "content_sanskrit": "ततो मुनिजनद्वेषाद् दुष्टात्मा श्वाकृतोऽबुधः ।\nऋषिणा शरभः शप्तः स्वं रूपं पुनराप्तवान्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2183792, "chapter_id": 4901, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे अष्टादशाधिकशततमोध्यायः ॥ ११८ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]