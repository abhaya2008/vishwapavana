[{"id": 7001834000, "chapter_id": 21834, "verse_number": "१३-१", "content_sanskrit": "पुत्र उवाच ।\nअहं वैश्यकुले जातो जन्मन्यस्मात्तु सप्तमे ।\nसमतीते गवां रोधं निपाने कृतवान् पुरा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001834001, "chapter_id": 21834, "verse_number": "१३-२", "content_sanskrit": "विपाकात् कर्मणस्तस्य नरकं भृशदारुणम् ।\nसम्प्राप्तोऽग्निशिखाघोरमयोमुखखगाकुलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001834002, "chapter_id": 21834, "verse_number": "१३-३", "content_sanskrit": "यन्त्रपीडनगात्रासृक्-प्रवाहोद्भूतकर्दमम् ।\nविशस्यमानदुष्कर्मि-तन्निपातरवाकुलम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001834003, "chapter_id": 21834, "verse_number": "१३-४", "content_sanskrit": "पात्यमानस्य मे तत्र साग्रं वर्षशतं गतम् ।\nमहातापार्तितप्तस्य तृष्णादाहान्वितस्य च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001834004, "chapter_id": 21834, "verse_number": "१३-५", "content_sanskrit": "तत्राह्लादकरः सद्यः पवनः सुखशीतलः ।\nकरम्भ-बालुकाकुम्भ-मध्यस्थो मे समागतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001834005, "chapter_id": 21834, "verse_number": "१३-६", "content_sanskrit": "तत्सम्पर्कादशेषाणां नाभवद्यातना नृणाम् ।\nमम चापि यथा स्वर्गे स्वर्गिणां निर्वृतिः परा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001834006, "chapter_id": 21834, "verse_number": "१३-७", "content_sanskrit": "किमेतदिति चाह्लाद-विस्तारस्तिमितेक्षणैः ।\nदृष्टमस्माभिरासन्नं नररत्नमनत्तमम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001834007, "chapter_id": 21834, "verse_number": "१३-८", "content_sanskrit": "याम्यश्च पुरुषो घोरो दण्डहस्तोऽशनिप्रभः ।\nपुरतो दर्शयन् मार्गमिति एहीति वगथ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001834008, "chapter_id": 21834, "verse_number": "१३-९", "content_sanskrit": "पुरुषः स तदा दृष्ट्वा यातनाशतसंकुलम् ।\nनरकं प्राह तं याम्यं किङ्करं कृपयान्वितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001834009, "chapter_id": 21834, "verse_number": "१३-१०", "content_sanskrit": "पुरुष उवाच ।\nभो याम्यपुरुषाचक्ष्व किं मया दुष्कृतं कृतम् ।\nयेनेदं यातनाभीम् प्राप्तोऽस्मि नरकं परम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001834010, "chapter_id": 21834, "verse_number": "१३-११", "content_sanskrit": "विपश्चिदिति विख्यातो जनकानामहं कुले ।\nजातो विदेहविषये सम्यङ्मनुजपालकः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001834011, "chapter_id": 21834, "verse_number": "१३-१२", "content_sanskrit": "यज्ञैर्मयेष्टं बहुभिर्धर्मतः पालिता मही ।\nनोत्सृष्टश्चैव संग्रामो नातिथिर्विमुखो गतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001834012, "chapter_id": 21834, "verse_number": "१३-१३", "content_sanskrit": "पितृ-देवर्षि-भृत्याश्च न चापचरिता मया ।\nकृता स्पृहा च न मया परस्त्रीविभवादिषु ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001834013, "chapter_id": 21834, "verse_number": "१३-१४", "content_sanskrit": "पर्वकालेषु पितरस्तिथिकालेषु देवताः ।\nपुरुषं स्वयमायान्ति निपानमिव धेनवः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001834014, "chapter_id": 21834, "verse_number": "१३-१५", "content_sanskrit": "यतस्ते विमुखा यान्ति निश्वस्य गृहमेधिनः ।\nतस्मादिष्टश्च पूर्तश्च धमौ द्वावपि नश्यतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001834015, "chapter_id": 21834, "verse_number": "१३-१६", "content_sanskrit": "पितृनिश्वासविध्वस्तं सप्तजन्मार्जितं शुभम् ।\nत्रिजन्मप्रभवं दैवो निश्वासो हन्त्यसंशयम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001834016, "chapter_id": 21834, "verse_number": "१३-१७", "content_sanskrit": "तस्माद् दैवे च पित्र्ये च नित्यमेवोद्यतोऽभवम् ।\nसोऽहं कथमिमं प्राप्तो नरङ्क भृशदारुणम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]