[{"id": 7001369000, "chapter_id": 21369, "verse_number": "५-१६-१", "content_sanskrit": "सनत्कुमार उवाच ।\nतेषां मूर्द्धोपरिष्टाद्वै नरकांस्ताञ्छृणुष्व च ।\nमत्तो मुनिवरश्रेष्ठ पच्यंते यत्र पापिनः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001369001, "chapter_id": 21369, "verse_number": "५-१६-२", "content_sanskrit": "रौरवश्शूकरो रोधस्तालो विवसनस्तथा ।\nमहाज्वालस्तप्तकुंभो लवणोपि विलोहितः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001369002, "chapter_id": 21369, "verse_number": "५-१६-३", "content_sanskrit": "वैतरणी पूयवहा कृमिणः कृमिभोजनः ।\nअसिपत्रवनं घोरं लालाभक्षश्च दारुणः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001369003, "chapter_id": 21369, "verse_number": "५-१६-४", "content_sanskrit": "तथा पूयवहः प्रायो बहिर्ज्वालो ह्यधश्शिराः ।\nसंदंशः कालसूत्रश्च तमश्चावीचिरो धनः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001369004, "chapter_id": 21369, "verse_number": "५-१६-५", "content_sanskrit": "श्वभोजनोऽथ रुष्टश्च महारौरवशाल्मली ।\nइत्याद्या बहवस्तत्र नरका दुःखदायकाः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001369005, "chapter_id": 21369, "verse_number": "५-१६-६", "content_sanskrit": "पच्यंते तेषु पुरुषाः पापकर्मरतास्तु ये ।\nक्रमाद्वक्ष्ये तु तान् व्यास सावधानतया शृणु॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001369006, "chapter_id": 21369, "verse_number": "५-१६-७", "content_sanskrit": "कूटसाक्ष्यं तु यो वक्ति विना विप्रान् सुरांश्च गाः ।\nसदाऽनृतं वदेद्यस्तु स नरो याति रौरवम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001369007, "chapter_id": 21369, "verse_number": "५-१६-८", "content_sanskrit": "भ्रूणहा स्वर्णहर्ता च गोरोधी विश्वघातकः ।\nसुरापो ब्रह्महंता च परद्रव्यापहारकः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001369008, "chapter_id": 21369, "verse_number": "५-१६-९", "content_sanskrit": "यस्तत्संगी स वै याति मृतो व्यास गुरोर्वधात् ।\nततः कुंभे स्वसुर्मातुर्गोश्चैव दुहितुस्तथा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001369009, "chapter_id": 21369, "verse_number": "५-१६-१०", "content_sanskrit": "साध्व्या विक्रयकृच्चाथ वार्द्धकी केशविक्रयी ।\nतप्तलोहेषु पच्यंते यश्च भक्तं परित्यजेत्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001369010, "chapter_id": 21369, "verse_number": "५-१६-११", "content_sanskrit": "अवमंता गुरूणां यः पश्चाद्भोक्ता नराधमः ।\nदेवदूषयिता चैव देवविक्रयिकश्च यः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001369011, "chapter_id": 21369, "verse_number": "५-१६-१२", "content_sanskrit": "अगम्यगामी यश्चांते याति सप्तबलं द्विज ।\nचौरो गोघ्नो हि पतितो मर्यादादूषकस्तथा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001369012, "chapter_id": 21369, "verse_number": "५-१६-१३", "content_sanskrit": "देवद्विजपितृद्वेष्टा रत्नदूषयिता च यः ।\nस याति कृमिभक्षं वै कृमीनत्ति दुरिष्टकृत्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001369013, "chapter_id": 21369, "verse_number": "५-१६-१४", "content_sanskrit": "पितृदेवसुरान् यस्तु पर्यश्नाति नराधमः ।\nलालाभक्षं स यात्यज्ञो यश्शस्त्रकूटकृन्नरः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001369014, "chapter_id": 21369, "verse_number": "५-१६-१५", "content_sanskrit": "यश्चांत्यजेन संसेव्यो ह्यसद्ग्राही तु यो द्विजः ।\nअयाज्ययाजकश्चैव तथैवाभक्ष्य भक्षकः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001369015, "chapter_id": 21369, "verse_number": "५-१६-१६", "content_sanskrit": "रुधिरौघे पतंत्येते सोमविक्रयिणश्च ये ।\nमधुहा ग्रामहा याति क्रूरां वैतरणीं नदीम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001369016, "chapter_id": 21369, "verse_number": "५-१६-१७", "content_sanskrit": "नवयौवनमत्ताश्च मर्यादाभेदिनश्च ये ।\nते कृत्यं यांत्यशौचाश्च कुलकाजीविनश्च ये॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001369017, "chapter_id": 21369, "verse_number": "५-१६-१८", "content_sanskrit": "असिपत्रवनं याति वृक्षच्छेदी वृथैव यः ।\nक्षुरभ्रका मृगव्याधा वह्निज्वाले पतंति ते॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001369018, "chapter_id": 21369, "verse_number": "५-१६-१९", "content_sanskrit": "भ्रष्टाचारो हि यो विप्रः क्षत्रियो वैश्य एव च ।\nयात्यंते द्विज तत्रैव यः श्वपाकेषु वह्निदः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001369019, "chapter_id": 21369, "verse_number": "५-१६-२०", "content_sanskrit": "व्रतस्य लोपका ये च स्वाश्रमाद्विच्युताश्च ये ।\nसंदंशयातनामध्ये पतंति भृशदारुणे॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001369020, "chapter_id": 21369, "verse_number": "५-१६-२१", "content_sanskrit": "वीर्यं स्वप्नेषु स्कंदेयुर्ये नरा ब्रह्मचारिणः ।\nपुत्रा नाध्यापिता यैश्च ते पतंति श्वभोजने॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001369021, "chapter_id": 21369, "verse_number": "५-१६-२२", "content_sanskrit": "एते चान्ये च नरकाः शतशोऽथ सहस्रशः ।\nयेषु दुष्कृतकर्माणः पच्यते यातनागताः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001369022, "chapter_id": 21369, "verse_number": "५-१६-२३", "content_sanskrit": "तथैव पापान्येतानि तथान्यानि सहस्रशः ।\nभुज्यंते यानि पुरुषैर्नरकांतरगोचरैः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001369023, "chapter_id": 21369, "verse_number": "५-१६-२४", "content_sanskrit": "वर्णाश्रमविरुद्धं च कर्म कुर्वंति ये नराः ।\nकर्मणा मनसा वाचा निरये तु पतंति ते॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001369024, "chapter_id": 21369, "verse_number": "५-१६-२५", "content_sanskrit": "अधश्शिरोभिर्दृश्यंते नारका दिवि दैवतैः ।\nदेवानधोमुखान्सर्वानधः पश्यंति नारकाः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001369025, "chapter_id": 21369, "verse_number": "५-१६-२६", "content_sanskrit": "स्थावराः कृमिपाकाश्च पक्षिणः पशवो मृगाः ।\nधार्मिकास्त्रिदशास्तद्वन्मोक्षिणश्च यथाक्रमम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001369026, "chapter_id": 21369, "verse_number": "५-१६-२७", "content_sanskrit": "यावंतो जंतवस्स्वर्गे तावंतो नरकौकसः ।\nपापकृद्याति नरकं प्रायश्चित्तपराङ्मुखः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001369027, "chapter_id": 21369, "verse_number": "५-१६-२८", "content_sanskrit": "गुरूणि गुरुभिश्चैव लघूनि लघुभिस्तथा ।\nप्रायश्चित्तानि कालेय मनुस्स्वायम्भुवोऽब्रवीत्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001369028, "chapter_id": 21369, "verse_number": "५-१६-२९", "content_sanskrit": "यानि तेषामशेषाणां कर्मार्ण्युक्तानि तेषु वै ।\nप्रायश्चित्तमशेषेण हरानुस्मरणं परम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001369029, "chapter_id": 21369, "verse_number": "५-१६-३०", "content_sanskrit": "प्रायश्चित्तं तु यस्यैव पापं पुंसः प्रजायते ।\nकृते पापेऽनुतापोऽपि शिवसंस्मरणं परम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001369030, "chapter_id": 21369, "verse_number": "५-१६-३१", "content_sanskrit": "माहेश्वरमवाप्नोति मध्याह्नादिषु संस्मरन् ।\nप्रातर्निशि च संध्यायां क्षीणपापो भवेन्नरः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001369031, "chapter_id": 21369, "verse_number": "५-१६-३२", "content_sanskrit": "मुक्तिं प्रयाति स्वर्गं वा समस्तक्लेशसंक्षयम ।\nशिवस्य स्मरणादेव तस्य शंभोरुमापतेः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001369032, "chapter_id": 21369, "verse_number": "५-१६-३३", "content_sanskrit": "पापन्तरायो विप्रेन्द्र जपहोमार्चनादि च ।\nभवत्येव न कुत्रापि त्रैलोक्ये मुनिसत्तम॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001369033, "chapter_id": 21369, "verse_number": "५-१६-३४", "content_sanskrit": "महेश्वरे मतिर्यस्य जपहोमार्चनादिपु ।\nयत्पुण्यं तत्कृतं तेन देवेन्द्रत्वादिकं फलम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001369034, "chapter_id": 21369, "verse_number": "५-१६-३५", "content_sanskrit": "पुमान्न नरकं याति यः स्मरन्भक्तितो मुने ।\nअहर्निशं शिवं तस्मात्स क्षीणाशेषपातकः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001369035, "chapter_id": 21369, "verse_number": "५-१६-३६", "content_sanskrit": "नरकस्वर्गसंज्ञाये पापपुण्ये द्विजोत्तम ।\nययोस्त्वेकं तु दुःखायान्यत्सुखायोद्भवाय च॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001369036, "chapter_id": 21369, "verse_number": "५-१६-३७", "content_sanskrit": "तदेव प्रीतये भूत्वा पुनर्दुःखाय जायते ।\nतत्स्याद्दुःखात्मकं नास्ति न च किंचित्सुखात्मकम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001369037, "chapter_id": 21369, "verse_number": "५-१६-३८", "content_sanskrit": "मनसः परिणामोऽयं सुखदुःखोपलक्षणः ।\nज्ञानमेव परं ब्रह्म ज्ञानं तत्त्वाय कल्पते॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001369038, "chapter_id": 21369, "verse_number": "५-१६-३९", "content_sanskrit": "ज्ञानात्मकमिदं विश्वं सकलं सचराचरम् ।\nपरविज्ञानतः किंचिद्विद्यते न परं मुने॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001369039, "chapter_id": 21369, "verse_number": "५-१६-४०", "content_sanskrit": "एवमेतन्मयाख्यातं सर्वं नरकमण्डलम् ।\nअत ऊर्ध्वं प्रवक्ष्यामि सांप्रतं मंडलं भुवः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]