[{"id": 2012712, "chapter_id": 1262, "verse_number": "२-३-१", "content_sanskrit": "वैशम्पायन उवाच।\nअथाब्रवीन्मयः पार्थमर्युनं जयतां वरम्।\nआपृच्छे त्वां गमिष्यामि पुनरेष्यामि चाप्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012713, "chapter_id": 1262, "verse_number": "२-३-२", "content_sanskrit": "विश्रुतां त्रिषु लोकेषु पार्थ दिव्यां सभां तव।\nप्राणिनां विस्मयकरीं तव प्रियविवर्धिनीम्।\nपाण्डवानां च सर्वेषां करिष्यामि धनञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012714, "chapter_id": 1262, "verse_number": "२-३-३", "content_sanskrit": "उत्तरेण तु कैलासं मैनाकं पर्वतं प्रति।\nयियक्षमाणेषु पुरा दानवेषु मया कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012715, "chapter_id": 1262, "verse_number": "२-३-४", "content_sanskrit": "चित्रं मणिमयं भाण्डं रम्यं बिन्दुसारः प्रति।\nसभायां सत्यसन्धस्य यदासीद्वृषपर्वणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012716, "chapter_id": 1262, "verse_number": "२-३-५", "content_sanskrit": "आगमिष्यामि तद्गृह्य यदि तिष्ठति भारत।\nततः सभां करिष्यामि पाण्डवस्य यशस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012717, "chapter_id": 1262, "verse_number": "२-३-६", "content_sanskrit": "मनः प्रह्लादिनीं चित्रां सर्वरत्नविभूषिताम्।\nअस्ति बिन्दुसारस्युग्रा गदा च कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012718, "chapter_id": 1262, "verse_number": "२-३-७", "content_sanskrit": "निहिता यौवनाश्वेन राज्ञा हत्वा रणे रिपून्।\nसुवर्णबिन्दुभिश्चित्रा गुर्वी भारसहा दृढा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012719, "chapter_id": 1262, "verse_number": "२-३-८", "content_sanskrit": "सा वै शतसहस्रस्य सम्मिता शत्रुघातिनी।\nअनुरूपा च भीमस्य गाण्डीवं भवतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012720, "chapter_id": 1262, "verse_number": "२-३-९", "content_sanskrit": "वारुणश्च महाशङ्खो देवदत्तः सुघोषवान्।\nसर्वमेतत्प्रदास्यामि भवते नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012721, "chapter_id": 1262, "verse_number": "२-३-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012722, "chapter_id": 1262, "verse_number": "२-३-१०", "content_sanskrit": "इत्युक्त्वा सोऽसुरः पार्थं प्रागुदीचीं दिशं गतः।\nअथोत्तरेण कैलासान्मैनाकं पर्वतं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012723, "chapter_id": 1262, "verse_number": "२-३-११", "content_sanskrit": "हिरण्यशृङ्गः सुमहान्महामणिमयो गिरिः।\nरम्यं बिन्दुसरो नाम यत्र राजा भगीरथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012724, "chapter_id": 1262, "verse_number": "२-३-१२", "content_sanskrit": "द्रुष्टुं भागीरथीं गङ्गामुवास बहुलाः समाः।\nयत्रेष्टं सर्वभूतानामीश्वरेण महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012725, "chapter_id": 1262, "verse_number": "२-३-१३", "content_sanskrit": "आहृताः क्रतवो मुख्याः शतं भरतसत्तम।\nयत्र यूपा मणिमयाश्चैत्याश्चापि हिरण्मयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012726, "chapter_id": 1262, "verse_number": "२-३-१४", "content_sanskrit": "शोभार्थं विहितास्तत्र न तु दृष्टान्ततः कृताः।\nयत्रेष्ट्वा स गतः सिद्धिं सहस्राक्षः शचीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012727, "chapter_id": 1262, "verse_number": "२-३-१५", "content_sanskrit": "यत्र भूतपतिः सृष्ट्वा सर्वाँल्लोकान्सनातनः।\nअपस्यते तिग्मतेजाः स्थितो भूतैः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012728, "chapter_id": 1262, "verse_number": "२-३-१६", "content_sanskrit": "नरनारायणौ ब्रह्मा यमः स्थाणुश्च पञ्चमः।\nउपासते यत्र परं सहस्रयुगपर्यये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012729, "chapter_id": 1262, "verse_number": "२-३-१७", "content_sanskrit": "यत्रेष्टं वासुदेवेन सत्त्रैर्वर्षगणान्बहून्।\nश्रद्दधानेन सततं धर्मसम्प्रतिपत्तये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012730, "chapter_id": 1262, "verse_number": "२-३-१८", "content_sanskrit": "सुवर्णमालिनो यूपाश्चैत्याश्चाप्यतिभास्वराः।\nददौ यत्र सहस्राणि प्रयुतानि च केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012731, "chapter_id": 1262, "verse_number": "२-३-१९", "content_sanskrit": "तत्र गत्वा स जग्राह गदां शङ्खं च भारत।\nतस्माद्गिरेरुपादाय शिलाः सुरुचिरावहाः।\nस्फाटिकं च सभाद्रव्यं यदासीद्वृषपर्वणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012732, "chapter_id": 1262, "verse_number": "२-३-२०", "content_sanskrit": "किङ्करैः सह रक्षोभिर्यदरक्षन्महद्धनम्।\nतदगृह्णान्मयस्तत्र गत्वा सर्वं महाऽसुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012733, "chapter_id": 1262, "verse_number": "२-३-२१", "content_sanskrit": "तदाहृत्य च तां चक्रे सोऽसुरोऽप्रतिमां सभाम्।\nविश्रुतां त्रिषु लोकेषु दिव्यां मणिमयीं शुभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012734, "chapter_id": 1262, "verse_number": "२-३-२२", "content_sanskrit": "गदां च भीमसेनाय प्रवरां प्रददौ तदा।\nदेवदत्तं चार्जुनाय शङ्खप्रवरमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012735, "chapter_id": 1262, "verse_number": "२-३-२३", "content_sanskrit": "यस्य शङ्खस्य नादेन भूतानि प्रचकम्पिरे।\nस कालं कञ्चिदाश्वस्य विश्वकर्मा विचिन्त्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012736, "chapter_id": 1262, "verse_number": "२-३-२४", "content_sanskrit": "सभां प्रचक्रमे कर्तुं पाण्डवानां महात्मनाम्।\nअभिप्रायेण पार्थानां कृष्णस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012737, "chapter_id": 1262, "verse_number": "२-३-२५", "content_sanskrit": "सर्वर्तुगुणसम्पन्नां दिव्यरूपामलङ्कृताम्।\nतर्पयित्वा द्विजश्रेष्ठान्पायसेन सहस्रशः।\nसभा च सा महाराज शातकुम्भमयद्रुमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2012738, "chapter_id": 1262, "verse_number": "२-३-२६", "content_sanskrit": "दशकिष्कुसहस्राणि समन्तादायताभवत्।\nयथा वह्नेर्यथार्कस्य सोमस्य च यथा सभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2012739, "chapter_id": 1262, "verse_number": "२-३-२७", "content_sanskrit": "भ्राजमाना तथाऽत्यर्थं दधार परमं वपुः।\nअभिघ्नतीव प्रभया प्रभामर्कस्य भास्वराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2012740, "chapter_id": 1262, "verse_number": "२-३-२८", "content_sanskrit": "प्रबभौ ज्वलमानेव दिव्या दिव्येन वर्चसा।\nनवमेघप्रतीकाशा दिवमाकृत्य विष्ठिता।\nआयता विपुला रम्या विपाप्मा विगतक्लमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2012741, "chapter_id": 1262, "verse_number": "२-३-२९", "content_sanskrit": "उत्तमद्रव्यसम्पन्ना रत्नप्राकारतोरणा।\nबहुचित्रा बहुधना सुकृता विश्वकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2012742, "chapter_id": 1262, "verse_number": "२-३-३०", "content_sanskrit": "न दाशार्ही सुधर्मा वा ब्रह्मणो वाथ तादृशी।\nसभा रूपेण सम्पन्ना यां चक्रे मतिमान्मयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2012743, "chapter_id": 1262, "verse_number": "२-३-३१", "content_sanskrit": "तां स्म तत्र मयेनोक्ता रक्षन्ति च वहन्ति च।\nसभामष्टौ सहस्राणि किङ्करा नाम राक्षसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2012744, "chapter_id": 1262, "verse_number": "२-३-३२", "content_sanskrit": "अन्तरिक्षचरा घोरा महाकाया महाबलाः।\nरक्ताक्षाः पिङ्गलाक्षाश्च शुक्तिकर्णाः प्रहारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2012745, "chapter_id": 1262, "verse_number": "२-३-३३", "content_sanskrit": "तस्यां सभायां नलिनीं चकाराप्रतिमां मयः।\nवैदूर्यपत्रविततां मणिनालमयाम्बुजाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2012746, "chapter_id": 1262, "verse_number": "२-३-३४", "content_sanskrit": "पद्मसौगन्धिकवतीं नानाद्विजगणायुताम्।\nपुष्पितैः पङ्कजैश्चित्रां कूर्मैर्मत्स्यैश्च काञ्चनैः।\nचित्रस्फटिकसोपानां निष्पङ्कसलिलां शुभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2012747, "chapter_id": 1262, "verse_number": "२-३-३५", "content_sanskrit": "मन्दानिलसमुद्धूतां मुक्ताबिन्दुभिराचिताम्।\nमहामणिशिलापट्टबद्धपर्यन्तवेदिकाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2012748, "chapter_id": 1262, "verse_number": "२-३-३६", "content_sanskrit": "मणिरत्नचितां तां तु केचिदभ्येत्य पार्थिवाः।\nदृष्ट्वापि नाभ्यजानन्त तेऽज्ञानात्प्रपतन्त्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2012749, "chapter_id": 1262, "verse_number": "२-३-३७", "content_sanskrit": "तां सभामभितो नित्यं पुष्पवन्तो महाद्रुमाः।\nआसन्नानाविधा लोलाः शीतच्छाया मनोरमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2012750, "chapter_id": 1262, "verse_number": "२-३-३८", "content_sanskrit": "काननानि सुगन्धीनि पुष्करिण्यश्च सर्वशः।\nहंसकारण्डवोपेताश्चक्रवाकोपशोभिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2012751, "chapter_id": 1262, "verse_number": "२-३-३९", "content_sanskrit": "जलजानां च पद्मानां स्थलजानां च सर्वशः।\nमारुतो गन्धमादाय पाण्डवान्स्म निषेवते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2012752, "chapter_id": 1262, "verse_number": "२-३-४०", "content_sanskrit": "ईदृशीं तां सभां कृत्वा मासैः परिचतुर्दशैः।\nनिष्ठितां धर्मराजाय मयो राजन्न्यवेदयत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2012753, "chapter_id": 1262, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि तृतीयोऽध्यायः॥ ३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]