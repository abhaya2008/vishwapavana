[{"id": 7000918000, "chapter_id": 20918, "verse_number": "७-६-१", "content_sanskrit": "राजोवाच ।\nतिष्ठात्रैव महाबाहो मम राज्ये सुशोभने ।\nकर्तव्या ते मया वृत्तिः संशयो नात्र विद्यते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000918001, "chapter_id": 20918, "verse_number": "७-६-२", "content_sanskrit": "ततो वीरवरस्तस्य सन्निधौ धरणीपतेः ।\nउवास सततं विप्र तत्सेवा गतमानसः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000918002, "chapter_id": 20918, "verse_number": "७-६-३", "content_sanskrit": "अथैकदा तस्य पुरे जैमिने सकलाः प्रजाः ।\nभीमनादो नाम खड्गः क्षोभयामास संततम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000918003, "chapter_id": 20918, "verse_number": "७-६-४", "content_sanskrit": "तद्वधाय ततो राजा प्रेषयामास तं रुषा ।\nततोऽसौ गंडकं हंतु ययौ वीरवरो जनैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000918004, "chapter_id": 20918, "verse_number": "७-६-५", "content_sanskrit": "ददर्श पर्वताकारं सुप्तं तं धरणीतले ।\nदंष्ट्राकरालवदनं खड्गिनं तं सशक्तिधृक् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000918005, "chapter_id": 20918, "verse_number": "७-६-६", "content_sanskrit": "नभसि भ्रामयन्सप्तिं स च वीरवरो रुषा ।\nखड्गिनं तमिति प्राह मेघगंभीरया गिरा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000918006, "chapter_id": 20918, "verse_number": "७-६-७", "content_sanskrit": "उपार्जितास्त्वया ये ये दुरात्मन्पापपादपाः ।\nबभूवुः फलिनस्ते ते ऋतुं प्राप्य यथा द्रुमाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000918007, "chapter_id": 20918, "verse_number": "७-६-८", "content_sanskrit": "खादिताः प्राणिनो ये ये राज्येऽस्मिन्पापिना त्वया ।\nयमालये समस्तैस्तैर्दर्शनं ते भविष्यति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000918008, "chapter_id": 20918, "verse_number": "७-६-९", "content_sanskrit": "मुंच निद्रामरे दुष्ट मां पश्यान्तकरं निजम् ।\nअनया निद्रया किन्ते महानिद्र भविष्यति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000918009, "chapter_id": 20918, "verse_number": "७-६-१०", "content_sanskrit": "ततः सोऽपि समुत्तस्थौ क्रोधसंरक्तलोचनः ।\nधूलिधूसरसर्वाङ्गस्त्यक्तनिद्रो महाबलः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000918010, "chapter_id": 20918, "verse_number": "७-६-११", "content_sanskrit": "भीमनाद उवाच ।\nगर्वं मा कुरु दुर्बुद्धे तवायुः शेषतां गतम् ।\nतत्संदर्शनमात्रेण प्राप्तः कोनु विमुच्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000918011, "chapter_id": 20918, "verse_number": "७-६-१२", "content_sanskrit": "ज्वलदग्निशिखाश्रेणीं प्रविशेच्छलभो यथा ।\nमत्कोपानलराशौ त्वं तथैव निपतिष्यसि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000918012, "chapter_id": 20918, "verse_number": "७-६-१३", "content_sanskrit": "इति ब्रुवंतं तं द्रष्टुं शक्त्या निशितया तया ।\nस जज्वाल महाकोपात्कृत्वा हुंकारनिःस्वनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000918013, "chapter_id": 20918, "verse_number": "७-६-१४", "content_sanskrit": "स पपात महीपृष्ठे गतायुर्गंडकस्ततः ।\nचालयन्पृथिवीं सर्वां स्वनितौघ परिप्लुतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000918014, "chapter_id": 20918, "verse_number": "७-६-१५", "content_sanskrit": "खड्गिनं पतितं दृष्ट्वा गङ्गाब्धिरोधसि द्विज ।\nसमीपं तस्य भूपस्य स गंतुमुपचक्रमे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000918015, "chapter_id": 20918, "verse_number": "७-६-१६", "content_sanskrit": "स गच्छन्पथिविप्रर्षे ददर्शैकं महाशयम् ।\nजाज्वल्यमानं तेजोभिर्द्वितीयमिव भास्करम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000918016, "chapter_id": 20918, "verse_number": "७-६-१७", "content_sanskrit": "विष्णुदूतगणैर्युक्तं तुलसीमाल्यभूषितम् ।\nदिव्याम्बरधरं दिव्यं रथारूढं स्मिताननम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000918017, "chapter_id": 20918, "verse_number": "७-६-१८", "content_sanskrit": "पप्रच्छेति ततो भक्त्या स च वीरवरश्च तम् ।\nकस्त्वं कुत इहायातः क्व गच्छसि वदस्व नः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000918018, "chapter_id": 20918, "verse_number": "७-६-१९", "content_sanskrit": "पुरुष उवाच ।\nकन्येविधृतपुंवेशे मद्वृत्तांतं निशामय ।\nकथयामि समासेन श्रोतुमिच्छसि चेन्मुदा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000918019, "chapter_id": 20918, "verse_number": "७-६-२०", "content_sanskrit": "अहमासं पुरा राजा चौरवंशवनानलः ।\nधर्मबुद्धिरिति ख्यातः सर्वधर्मपरायणः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000918020, "chapter_id": 20918, "verse_number": "७-६-२१", "content_sanskrit": "मया यज्ञाः कृताः सर्वे दानानि सकलानि च ।\nचतुर्वर्षसहस्राणि पालिता च वसुन्धरा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000918021, "chapter_id": 20918, "verse_number": "७-६-२२", "content_sanskrit": "पाखण्डजनवाक्येन मया भूमिर्द्विजन्मनः ।\nलंघिता कोपमासाद्य दोषिता न हि कुत्रचित् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000918022, "chapter_id": 20918, "verse_number": "७-६-२३", "content_sanskrit": "मया तेनापराधेन स्वयमेव विधिस्ततः ।\nजहार तत्क्षणादेव सर्वां राजश्रियं रुषा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000918023, "chapter_id": 20918, "verse_number": "७-६-२४", "content_sanskrit": "अथाहं गतसंपत्तिः शोकाग्निदग्धमानसः ।\nकियिद्भिर्दिवसैः साध्वि यमराजवशं गतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000918024, "chapter_id": 20918, "verse_number": "७-६-२५", "content_sanskrit": "मां दृष्ट्वा चित्रगुप्तेन तत्कर्मप्रकटीकृतम् ।\nउक्तश्च भास्करिर्देवश्चारुहासगतिः प्रभुः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000918025, "chapter_id": 20918, "verse_number": "७-६-२६", "content_sanskrit": "धर्मबुद्धिरयं राजा कृतपुण्यक्रियः सदा ।\nअस्त्यस्य दुरितं किञ्चित्तन्निशामय वच्म्यहम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000918026, "chapter_id": 20918, "verse_number": "७-६-२७", "content_sanskrit": "पाखण्डैर्बोधितोऽयं तु जहार द्विजशासनम् ।\nतेनैव कर्मणा स्थानं नरके चास्यदुत्तरे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000918027, "chapter_id": 20918, "verse_number": "७-६-२८", "content_sanskrit": "वृत्तिच्छेदः सूर्यपुत्र यस्य येन विधीयते ।\nस तस्य वधमाप्नोति शास्त्रेषु इति निश्चितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000918028, "chapter_id": 20918, "verse_number": "७-६-२९", "content_sanskrit": "तस्मादयं पापकर्मा ब्रह्महा पृथिवीपतिः ।\nएतस्य निरये स्थानं कल्पकोटिशतावधि ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000918029, "chapter_id": 20918, "verse_number": "७-६-३०", "content_sanskrit": "आत्मदत्तां हरेद्यस्तु परदत्तां च मेदिनीम् ।\nस कोटिकुलसंयुक्तः प्रयाति नरकं विभो ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000918030, "chapter_id": 20918, "verse_number": "७-६-३१", "content_sanskrit": "यो हरेच्च महीं तावद्देवस्य ब्राह्मणस्य च ।\nन तस्य निष्कृतिर्दृष्टा कल्पकोटिशतावधि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000918031, "chapter_id": 20918, "verse_number": "७-६-३२", "content_sanskrit": "परदत्तां क्षितिं यस्तु रक्षितुर्यस्तु रक्षति ।\nस कोटिगुणमाप्नोति पुण्यं दातृगुणादपि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000918032, "chapter_id": 20918, "verse_number": "७-६-३३", "content_sanskrit": "ततोऽहं शमनादेशाद्भुक्त्वा वै पूतिमृत्तिकाम् ।\nकल्पयोनौ प्राणिहिंसा सर्वदैव मया कृता ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000918033, "chapter_id": 20918, "verse_number": "७-६-३४", "content_sanskrit": "गावश्च ब्राह्मणाश्चैव तथैवान्येऽपि जीविनः ।\nमया दुष्टेन निहताः कोटिकोटिसहस्रशः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000918034, "chapter_id": 20918, "verse_number": "७-६-३५", "content_sanskrit": "कालेन प्रेरिता साध्वि मां सर्वक्षयिताश्रयम् ।\nखड्गयोनिं समुत्पन्नं भवती प्रजघान ह ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000918035, "chapter_id": 20918, "verse_number": "७-६-३६", "content_sanskrit": "गङ्गाब्धिसङ्गमं तीर्थं दुर्ल्लभं दैवतैरपि ।\nस्थलेऽपि मृत्युमासाद्य यत्रेयं मम सद्गतिः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000918036, "chapter_id": 20918, "verse_number": "७-६-३७", "content_sanskrit": "गच्छ सुश्रोणि भद्रं ते भविष्यति न संशयः ।\nअचिरेणैव पतिना दर्शनं ते भविष्यति ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000918037, "chapter_id": 20918, "verse_number": "७-६-३८", "content_sanskrit": "व्यास उवाच ।\nतस्यैतद्वचनं श्रुत्वा सा कन्या परमाद्भुतम् ।\nववंदे चरणौ तस्य धर्मबुद्धिर्महीपतिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000918038, "chapter_id": 20918, "verse_number": "७-६-३९", "content_sanskrit": "ततो रथं समारुह्य स राजा त्रिदिवं ययौ ।\nसोऽपि वीरवरो विप्र जगाम नृपतेः सभाम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000918039, "chapter_id": 20918, "verse_number": "७-६-४०", "content_sanskrit": "राजा च तं मृतं श्रुत्वा खड्गिनं भीमविक्रमम् ।\nतस्यै ददौ विवाहेन जयंतीं निजकन्यकाम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000918040, "chapter_id": 20918, "verse_number": "७-६-४१", "content_sanskrit": "जयंतीं तां समादाय सा कन्या पुरुषाकृतिः ।\nतपस्तप्तुं मनश्चक्रे गङ्गासागरसङ्गमे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000918041, "chapter_id": 20918, "verse_number": "७-६-४२", "content_sanskrit": "गङ्गाब्धिसंगमे स्नात्वा प्रभाते द्विजसत्तम ।\nगीतैर्वाद्यैश्च नृत्यैश्च यजेन्नारायणं प्रभुम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000918042, "chapter_id": 20918, "verse_number": "७-६-४३", "content_sanskrit": "निरामिषं हविष्यं च फलाहारं द्विजोत्तम ।\nकदाचिदुपवासं सा कुरुते च वराङ्गना ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000918043, "chapter_id": 20918, "verse_number": "७-६-४४", "content_sanskrit": "एकाकिनीं समालोक्य कोऽग्रहीदत्र भूतले ।\nमां नीचमिति मत्वासौ समारुह्य च वाजिनम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000918044, "chapter_id": 20918, "verse_number": "७-६-४५", "content_sanskrit": "भूय एव निजं राज्यं साजगाम वराङ्गना ।\nमाधवस्य वियोगेन तस्य विद्याधरस्य वा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000918045, "chapter_id": 20918, "verse_number": "७-६-४६", "content_sanskrit": "मृता सा राजतनया यतोऽन्यं न भजत्यपि ।\nतस्यां मृतायां भृत्योऽसौ निर्जगाम यदृच्छया ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000918046, "chapter_id": 20918, "verse_number": "७-६-४७", "content_sanskrit": "विलप्य बहुधा तत्र प्रचेष्टोऽत्यंत शोकभाक् ।\nजगाम मरणार्थाय गङ्गासागरसङ्गमम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000918047, "chapter_id": 20918, "verse_number": "७-६-४८", "content_sanskrit": "गङ्गाब्धिसङ्गमे स्नात्वा तुलसीमृद्विभूषितः ।\nकृताञ्जलिरिति प्राह प्रचेष्टो भीष्ममातरम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000918048, "chapter_id": 20918, "verse_number": "७-६-४९", "content_sanskrit": "पवित्रे त्वज्जले मातस्त्यजाम्यत्र कलेवरम् ।\nसुलोचना मे कांतास्याद्यथातत्त्वं करिष्यसि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000918049, "chapter_id": 20918, "verse_number": "७-६-५०", "content_sanskrit": "भूयोभूयो ब्रुवंतं तमिति तस्याश्च किंकराः ।\nबध्वा पाशेन तं निन्युर्निरुक्तां तत्सभां प्रति ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000918050, "chapter_id": 20918, "verse_number": "७-६-५१", "content_sanskrit": "तप्ता वीरवरादेशात्किंकरास्ते सुदारुणाः ।\nकारायां स्थापयामासुः प्रचेष्टमनुविह्वलम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000918051, "chapter_id": 20918, "verse_number": "७-६-५२", "content_sanskrit": "एतस्मिन्नेव काले तु दृष्ट्वा तत्कार्यमद्भुतम् ।\nहाहाकारो महानासीत्तद्राज्ये द्विजसत्तम ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000918052, "chapter_id": 20918, "verse_number": "७-६-५३", "content_sanskrit": "एतच्छ्रुत्वाद्भुतं कर्म स च राजा गुणाकरः ।\nआयातोऽत्यंत संतप्तो वदतीति द्विजोत्तम ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000918053, "chapter_id": 20918, "verse_number": "७-६-५४", "content_sanskrit": "निषंगिणश्च रथिनश्चर्मिणः खड्गिनस्तथा ।\nधानुष्काश्च कौंतकाश्च कोटिकोटिसहस्रशः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000918054, "chapter_id": 20918, "verse_number": "७-६-५५", "content_sanskrit": "स्थाने स्थाने पुरे तस्मिन्राजा वै शोकविह्वलः ।\nनियोजयामास तदा रक्षायै द्विजसत्तम ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000918055, "chapter_id": 20918, "verse_number": "७-६-५६", "content_sanskrit": "तेनाज्ञप्तास्ततः सर्वे योद्धारोऽमितविक्रमाः ।\nसत्वराः पतिरक्षासु तस्थुस्तस्मिन्पुरे रुषा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000918056, "chapter_id": 20918, "verse_number": "७-६-५७", "content_sanskrit": "गीतानि गायकैः सर्वैर्नृत्यानि नर्तकैस्तथा ।\nवाद्यानि वादकैश्चैव तत्र त्यक्तानि साध्वसैः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000918057, "chapter_id": 20918, "verse_number": "७-६-५८", "content_sanskrit": "ततः स राजा विप्रर्षे समाहूय स्वमंत्रिणः ।\nकिमेतदिति पप्रच्छ शोकोपहतमानसः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000918058, "chapter_id": 20918, "verse_number": "७-६-५९", "content_sanskrit": "मंत्रिण ऊचुः ।\nदेवाद्भुतमिदं कर्म न दृष्टं न श्रुतं क्वचित् ।\nएतावतां नृणां मध्ये पश्यतां क्व जगाम सा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000918059, "chapter_id": 20918, "verse_number": "७-६-६०", "content_sanskrit": "कोऽपि जल्पति सा लक्ष्मीः शापेनागत्य भूतले ।\nत्वदीयं सौधमेतर्हि स्वयमंतरधीयत ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000918060, "chapter_id": 20918, "verse_number": "७-६-६१", "content_sanskrit": "मायामयी सा रमणी मायया त्वद्गृहे स्थिता ।\nमायां स्वकीयां दर्शित्वा गतेत्यन्ये वदंति वै ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000918061, "chapter_id": 20918, "verse_number": "७-६-६२", "content_sanskrit": "केचिद्वदंति रमणी सर्वलक्षणसंयुता ।\nआगमिष्यति भूयोऽपि भगाङ्गो मघवा यतः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000918062, "chapter_id": 20918, "verse_number": "७-६-६३", "content_sanskrit": "तन्मुखंचन्द्रवन्मत्वा विचिंत्यात्मानमात्मना ।\nकेचिद्वदंति चन्द्रेण नीता सुप्रतिपत्तये ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000918063, "chapter_id": 20918, "verse_number": "७-६-६४", "content_sanskrit": "वदंति केऽपि सा कन्या सद्गुणा दीर्घवासना ।\nभ्रान्त्या चन्द्रमसा ग्रस्ता पूर्णचंद्रनिभानना ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000918064, "chapter_id": 20918, "verse_number": "७-६-६५", "content_sanskrit": "दिग्गजैर्नलिनी भ्रान्त्या प्रफुल्लकमलानना ।\nविषदण्डप्रहस्ता च नीरजा कलिकाकुचा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000918065, "chapter_id": 20918, "verse_number": "७-६-६६", "content_sanskrit": "केचिद्वदंति सृष्ट्वा सा स्रष्टुमन्यां स्त्रियं नृपं ।\nतद्रूपादर्शनालोक्ये नीता रूपगुणास्थिता ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000918066, "chapter_id": 20918, "verse_number": "७-६-६७", "content_sanskrit": "केचिद्वदंति भूपाल त्वया सर्वदिशो जिताः ।\nरूपैर्दैवांगना जेतुं गता सा त्रिदिवं प्रति ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000918067, "chapter_id": 20918, "verse_number": "७-६-६८", "content_sanskrit": "अथ ते मंत्रिणोऽन्योन्यमालोक्येति मुखश्रियः ।\nस्तब्धा इवाभवन्सर्वे निरुत्साहाः ससाध्वसाः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000918068, "chapter_id": 20918, "verse_number": "७-६-६९", "content_sanskrit": "भूपः सुलोचने पुत्रि क्व गतासि विहाय माम् ।\nइत्युक्त्वा स महीपालः पृथिव्यां मूर्च्छितोऽपतत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000918069, "chapter_id": 20918, "verse_number": "७-६-७०", "content_sanskrit": "राजानं पतितं दृष्ट्वा शोकेन महता ततः ।\nजज्ञे हाहारवस्तस्मिन्नगरे द्विजसत्तम ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000918070, "chapter_id": 20918, "verse_number": "७-६-७१", "content_sanskrit": "तत्क्रंदनध्वनिं विप्र प्रतिश्रुत्वा च जायते ।\nउत्प्रेक्षते तत्र लोके क्रंदंति ककुभो दश ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000918071, "chapter_id": 20918, "verse_number": "७-६-७२", "content_sanskrit": "धूलिधूसरतां गंतुं नृपतिं मुक्तकेशकम् ।\nविधृत्य मंत्रिणः सर्वे तरसा सौधमाययुः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000918072, "chapter_id": 20918, "verse_number": "७-६-७३", "content_sanskrit": "अथ विद्याधरस्तत्र श्रीविक्रमदेवजः ।\nतस्याः पीठं समालिङ्ग्य रुरोद करुणस्वनैः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000918073, "chapter_id": 20918, "verse_number": "७-६-७४", "content_sanskrit": "हा प्रिये चंचलापाङ्गि सुवर्णकुसुमप्रभे ।\nशोकाब्धौ पातयित्वा मां क्व गतासि वरानने ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000918074, "chapter_id": 20918, "verse_number": "७-६-७५", "content_sanskrit": "मम किं दूषणं दृष्टं त्वया निर्दोषया प्रिये ।\nन ददासि कथं भद्रे दर्शनं कमलानने ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000918075, "chapter_id": 20918, "verse_number": "७-६-७६", "content_sanskrit": "न जीविष्याम्यंहं भद्रे क्षणमात्रं त्वया विना ।\nअतो मे दर्शनं दत्वा क्रियतां प्राणरक्षणम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000918076, "chapter_id": 20918, "verse_number": "७-६-७७", "content_sanskrit": "किं धनैः किं जनैः किं मे मित्रैः किं वा धनैर्गृहैः ।\nनाप्नोमि यदि भद्रे त्वां प्राणेभ्योऽपि गरीयसीम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000918077, "chapter_id": 20918, "verse_number": "७-६-७८", "content_sanskrit": "एतच्चान्यच्च विप्रर्षे स कृत्वा करुणं महत् ।\nशोकान्मृत्युं विनिश्चिंत्य ययौ गङ्गाब्धिसङ्गमम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000918078, "chapter_id": 20918, "verse_number": "७-६-७९", "content_sanskrit": "तत्र गङ्गाम्भसि स्नात्वा समुद्रजलमिश्रिते ।\nनिवेद्य भास्करायार्घं गंगां नत्वाह मातरम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000918079, "chapter_id": 20918, "verse_number": "७-६-८०", "content_sanskrit": "गंङ्गे देवि जगन्मातस्त्वज्जले विमले तनुम् ।\nत्यजामि तां यथा भूयः प्राप्नोमि तत्करिष्यसि ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000918080, "chapter_id": 20918, "verse_number": "७-६-८१", "content_sanskrit": "इति ब्रुवंतं तं विप्र तत्किंकरवरास्ततः ।\nविधिं विनिन्युः सदृशं क्रुद्धा वीरवरस्य च ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000918081, "chapter_id": 20918, "verse_number": "७-६-८२", "content_sanskrit": "ततो वीरवरः प्राह कस्त्वं भोः कुत आगतः ।\nकथमत्र तनुत्यागं कुरुषे तद्वदस्व मे ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000918082, "chapter_id": 20918, "verse_number": "७-६-८३", "content_sanskrit": "तद्वाक्यमेतदाकर्ण्य ततो विद्याधरोऽखिलाम् ।\nतां कथां कथयामास शृण्वतां विस्मयप्रदाम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000918083, "chapter_id": 20918, "verse_number": "७-६-८४", "content_sanskrit": "अथ त्वं मूर्खलोकानां प्रवरोसि न संशयः ।\nगान्धर्वी राक्षसी वापि पन्नगी वापि किन्नरी ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000918084, "chapter_id": 20918, "verse_number": "७-६-८५", "content_sanskrit": "शापागतेव सा कन्या तस्मादन्तर्हिता स्वयम् ।\nसा देवरूपिणी कन्या देवानां निलयं गता ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000918085, "chapter_id": 20918, "verse_number": "७-६-८६", "content_sanskrit": "कथं तया समं भूयो दर्शनं ते भविष्यति ।\nचकोरपेयं पीयूषं गगने रोहिणीपतेः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000918086, "chapter_id": 20918, "verse_number": "७-६-८७", "content_sanskrit": "किं शक्नुवंति तं पापा वायसा बलिनोऽपि च ।\nयदप्राप्यं न तत्प्राप्यं प्राप्यं यत्तच्च लभ्यते ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000918087, "chapter_id": 20918, "verse_number": "७-६-८८", "content_sanskrit": "जानंति तज्जनं कश्चिन्मोहं प्रति न गच्छति ।\nकेनापि दीयते कन्या कन्या केनापि गृह्यते ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000918088, "chapter_id": 20918, "verse_number": "७-६-८९", "content_sanskrit": "पूर्वजन्मनि या कन्या तां कन्यां लभते पतिः ।\nपुत्रप्रयोजना भार्या पुत्राः पिण्डप्रयोजनाः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000918089, "chapter_id": 20918, "verse_number": "७-६-९०", "content_sanskrit": "कुर्वंति दारग्रहणमतएव मनीषिणः ।\nयथेह दीयते नार्या तथा नारी समश्नुते ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000918090, "chapter_id": 20918, "verse_number": "७-६-९१", "content_sanskrit": "क्रंदन्रजन्यामप्येष भृङ्गः कुमुदिनीं सहेत् ।\nसद्रूपोऽपि पतिः स्त्रीणां संतोषाय भवेन्नहि ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000918091, "chapter_id": 20918, "verse_number": "७-६-९२", "content_sanskrit": "रवौ स्थितेऽपि पद्मिन्या मधूनि भ्रमरः पिबेत् ।\nनारीषु सततं चित्तं विष्णुभक्तिष्वनादरः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000918092, "chapter_id": 20918, "verse_number": "७-६-९३", "content_sanskrit": "शोकैः कैश्चित्तनुत्यागस्तिस्रः पुंसां विडंबनाः ।\nदाराः पुत्रास्तथा भ्राता देशाश्च बांधवास्तथा ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000918093, "chapter_id": 20918, "verse_number": "७-६-९४", "content_sanskrit": "पुनर्लभ्या इमे सर्वे पुनर्लभ्या न चासवः ।\nन मुक्तो विषयो धर्मो न च कर्म कृतं त्वया ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000918094, "chapter_id": 20918, "verse_number": "७-६-९५", "content_sanskrit": "वर्तमाने गते मूढ भविष्यं जन्म दुर्ल्लभम् ।\nमम माता मम पिता भार्या भ्राता धनं मम ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000918095, "chapter_id": 20918, "verse_number": "७-६-९६", "content_sanskrit": "निष्फलं याति वै जन्म नृणां ममतया तया ।\nएवं प्रबोधितः सम्यक्तेन धीरवरेण सः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000918096, "chapter_id": 20918, "verse_number": "७-६-९७", "content_sanskrit": "दौर्मनस्यं परित्यज्य तस्थौ तत्रैव जैमिने ।\nततस्तु गन्धिनी प्रीत्या हसंती स्वगृहं गता ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000918097, "chapter_id": 20918, "verse_number": "७-६-९८", "content_sanskrit": "गत्वा च माधवं मंचे स्वपंतं सा ददर्श ह ।\nगन्धिन्युवाच ।\nउत्तिष्ठोत्तिष्ठ दुर्बुद्धे भ्रमस्ते विफलोऽभवत् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000918098, "chapter_id": 20918, "verse_number": "७-६-९९", "content_sanskrit": "विवाहकाले सा कन्या बभूवांतर्हिता स्वयम् ।\nएवं तस्या वचः श्रुत्वा समुत्तस्थौ स माधवः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000918099, "chapter_id": 20918, "verse_number": "७-६-१००", "content_sanskrit": "विललापाकुलः शोकैर्महद्भिः क्ष्मातले लुठन् ।\nकन्याया दूषणं नास्ति नास्ति विद्याधरस्य वा ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}]