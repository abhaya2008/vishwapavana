[{"id": 7003255000, "chapter_id": 23255, "verse_number": "१-५८-१", "content_sanskrit": "ऋषय ऊचुः  ।\nअभ्यषिंचत्कथं ब्रह्मा चाधिपत्ये प्रजापतिः  ।\nदेवदैत्यमुखान् सर्वान् सर्वात्मा वद सांप्रतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003255001, "chapter_id": 23255, "verse_number": "१-५८-२", "content_sanskrit": "सूत उवाच  ।\nग्रहाधिपत्ये भगवानभ्यषिंचद्दिवाकरम्  ।\nऋक्षाणामोषधीनां च सोमं ब्रह्मा प्रजापतिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003255002, "chapter_id": 23255, "verse_number": "१-५८-३", "content_sanskrit": "अपां च वरुणं देव धनानां यक्षपुंगवम्  ।\nआदित्यानां तथा विष्णुं वसूनां पावकं तथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003255003, "chapter_id": 23255, "verse_number": "१-५८-४", "content_sanskrit": "प्रजापतीनां दक्षं च मरुतां शकमेव च  ।\nदैत्यानां दानवानां च प्रह्लाद दैत्यपुंगवम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003255004, "chapter_id": 23255, "verse_number": "१-५८-५", "content_sanskrit": "धर्मं पितॄणामधिपं निर्ऋतिं पिशितासिनाम्  ।\nरुद्रं पशूनां भूतानां नंदीनां गणनायकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003255005, "chapter_id": 23255, "verse_number": "१-५८-६", "content_sanskrit": "वीराणां वीरभद्रं च पिशाचानां भयंकरम्  ।\nमातॄणां चैव चामुण्डां सर्वदेवनमस्कृताम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003255006, "chapter_id": 23255, "verse_number": "१-५८-७", "content_sanskrit": "रुद्राणां देवदेवशं नीललोहितमीश्वरम्  ।\nविघ्नानां व्योमजं देवं गजस्यं तु विनायकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003255007, "chapter_id": 23255, "verse_number": "१-५८-८", "content_sanskrit": "स्त्रीणां देवीमुमादेवीं वचसां च सरस्वतीम्  ।\nविष्णुं मायाविनां चैव स्वत्मानं जगतां तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003255008, "chapter_id": 23255, "verse_number": "१-५८-९", "content_sanskrit": "हिमवंतं गिरीणां तु नदीनां चैव जाह्नवीम्  ।\nसमुद्राणां च सर्वेषामधिपं पयसां निधिम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003255009, "chapter_id": 23255, "verse_number": "१-५८-१०", "content_sanskrit": "वृक्षाणां चैव चाश्वत्थं प्लक्षं च प्रपितामहः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003255010, "chapter_id": 23255, "verse_number": "१-५८-११", "content_sanskrit": "गंघर्वविद्याधरकिन्नराणामीशं पुनाश्चित्ररथं चकार  ।\nनागाधिपं वासुकिमुग्रवीर्यं सर्पाधिपं तक्षकमुग्रवीर्यम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003255011, "chapter_id": 23255, "verse_number": "१-५८-१२", "content_sanskrit": "दिग्वारणानामधिपं चकार गजेन्द्रमैरावतमुग्रवीर्यम्  ।\nसुपर्णमीशं पततामथाश्वराजानमुच्चैःश्रवसं चकार ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003255012, "chapter_id": 23255, "verse_number": "१-५८-१३", "content_sanskrit": "सिंहं मृगाणां वृषभं गावां च मृगाधिपानां शरभं चकार  ।\nसेनाधिपानां गुहमप्रमेयं श्रुतीस्मृतीनां लकुलीशमीशम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003255013, "chapter_id": 23255, "verse_number": "१-५८-१४", "content_sanskrit": "अभ्यषिंचत्सुधर्माणं तथा शंखपदं दिशाम्  ।\nकेतुमंतं क्रमेणैव हेमरोमाणमेव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003255014, "chapter_id": 23255, "verse_number": "१-५८-१५", "content_sanskrit": "पृथिव्यां पृथुमीशानं सर्वेषां तु महेश्वरम्  ।\nचतुर्मूर्तिषु सर्वज्ञं शंकरं वृषभध्वजम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003255015, "chapter_id": 23255, "verse_number": "१-५८-१६", "content_sanskrit": "प्रसादाद्भगवाञ्छम्भोश्चाभ्यषिंचद्यथाक्रमम्  ।\nपुराभिषिच्य पुण्यात्मा रराज भुवनेश्वरः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003255016, "chapter_id": 23255, "verse_number": "१-५८-१७", "content_sanskrit": "एतद्वो विस्तरेणैव कथितं मुनिपुंगवाः  ।\nअभिषिक्तास्ततस्त्वेते विशिष्टा विश्वयोनिना ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]