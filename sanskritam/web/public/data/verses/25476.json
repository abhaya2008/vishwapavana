[{"id": 7005476000, "chapter_id": 25476, "verse_number": "१-४६-१", "content_sanskrit": "सूत उवच ।\nचतुर्दशसहस्रणि योजनानां महापुरी ।\nमेरोरुपरि विख्याता देवदेवस्य वेधसः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005476001, "chapter_id": 25476, "verse_number": "१-४६-२", "content_sanskrit": "तत्रास्ते भगवान् ब्रह्मा विश्वात्मा विश्वभावनः ।\nउपास्यमानो योगीन्द्रैर्मुनीन्द्रोपेन्द्रशंकरैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005476002, "chapter_id": 25476, "verse_number": "१-४६-३", "content_sanskrit": "तत्र देवेश्वरेशानं विश्वात्मानं प्रजापतिम् ।\nसनत्कुमारो भगवानुपास्ते नित्यमेव हि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005476003, "chapter_id": 25476, "verse_number": "१-४६-४", "content_sanskrit": "स सिद्धऋषिगन्धर्वैः पूज्यमानः सुरैरपि ।\nसमास्ते योगयुक्तत्मा पीत्वा तत्परमामृतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005476004, "chapter_id": 25476, "verse_number": "१-४६-५", "content_sanskrit": "तत्र देवादिदेवस्य शंभोरमिततेजसः ।\nदीप्तमायतनं शुभ्रं पुरस्ताद् ब्रह्मणः स्थितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005476005, "chapter_id": 25476, "verse_number": "१-४६-६", "content_sanskrit": "दिव्यकान्तिसमायुक्तं चतुर्द्धारं सुशोभनम् ।\nमहर्षिगणसंकीर्णं ब्रह्मविद्भिर्निषेवितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005476006, "chapter_id": 25476, "verse_number": "१-४६-७", "content_sanskrit": "देव्या सह महादेवः शशाङ्कार्काग्निलोचनः ।\nरमते तत्र विश्वेशः प्रमथैः प्रमथेश्वरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005476007, "chapter_id": 25476, "verse_number": "१-४६-८", "content_sanskrit": "तत्र वेदविदः शान्ता मुनयो ब्रह्मचारिणः ।\nपूजयन्ति महादेवं तापसाः सत्यवादिनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005476008, "chapter_id": 25476, "verse_number": "१-४६-९", "content_sanskrit": "तेषां साक्षान्महादेवो मुनीनां ब्रह्मवादिनाम् ।\nगृह्णाति पूजां शिरसा पार्वत्या परमेश्वरः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005476009, "chapter_id": 25476, "verse_number": "१-४६-१०", "content_sanskrit": "तत्रैव पर्वतवरे शक्रस्य परमा पुरी ।\nनाम्नाऽमरावती पूर्वे सर्वशोभासमन्विता ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005476010, "chapter_id": 25476, "verse_number": "१-४६-११", "content_sanskrit": "तत्र चाप्सरसः सर्वा गन्धर्वा गीततत्पराः ।\nउपासते सहस्राक्षं देवास्तत्र सहस्रशः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005476011, "chapter_id": 25476, "verse_number": "१-४६-१२", "content_sanskrit": "ये धार्मिका वेदविदो यागहोमपरायणाः ।\nतेषां तत् परमं स्थानं देवानामपि दुर्लभम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005476012, "chapter_id": 25476, "verse_number": "१-४६-१३", "content_sanskrit": "तस्य दक्षिणदिग्भागे वह्नेरमिततेजसः ।\nतेजोवती नाम पुरी दिव्याश्चर्यसमन्विता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005476013, "chapter_id": 25476, "verse_number": "१-४६-१४", "content_sanskrit": "तत्रास्ते भगवान् वह्निर्भ्राजमानः स्वतेजसा ।\nजपिनां होमिनां स्थानं दानवानां दुरासदम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005476014, "chapter_id": 25476, "verse_number": "१-४६-१५", "content_sanskrit": "दक्षिणे पर्वतवरे यमस्यापि महापुरी ।\nनाम्ना संयमनी दिव्या सिद्धगन्धर्वसेविता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005476015, "chapter_id": 25476, "verse_number": "१-४६-१६", "content_sanskrit": "तत्र वैवस्वतं देवं देवाद्याः पर्युपासते ।\nस्थानं तत् सत्यसंधानां लोके पुण्यकृतां नृणाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005476016, "chapter_id": 25476, "verse_number": "१-४६-१७", "content_sanskrit": "तस्यास्तु पश्चिमे भागे निर्ऋतेस्तु महात्मनः ।\nरक्षोवती नाम पुरी राक्षसैः सर्वतो वृता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005476017, "chapter_id": 25476, "verse_number": "१-४६-१८", "content_sanskrit": "तत्र ते निर्ऋतिं देवं राक्षसाः पर्युपासते ।\nगच्छन्ति तां धर्मरता ये वै तामसवृत्तयः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005476018, "chapter_id": 25476, "verse_number": "१-४६-१९", "content_sanskrit": "पश्चिमे पर्वतवरे वरुणस्य महापुरी ।\nनाम्ना शुद्धवती पुण्या सर्वकामर्द्धिसंयुता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005476019, "chapter_id": 25476, "verse_number": "१-४६-२०", "content_sanskrit": "तत्राप्सरोगणैः सिद्धैः सेव्यमानोऽमराधिपैः ।\nआस्ते स वरुणो राजा तत्र गच्छन्ति येऽम्बुदाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005476020, "chapter_id": 25476, "verse_number": "१-४६-२१", "content_sanskrit": "तस्या उत्तरदिग्भागे वायोरपि महापुरी ।\nनाम्ना गन्धवती पुण्या तत्रास्तेऽसौ प्रभञ्जनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005476021, "chapter_id": 25476, "verse_number": "१-४६-२२", "content_sanskrit": "अप्सरोगणगन्धर्वैः सेव्यमानोऽमरप्रभुः ।\nप्राणायामपरामर्त्यास्थानंतद्‌यान्ति शाश्वतम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005476022, "chapter_id": 25476, "verse_number": "१-४६-२३", "content_sanskrit": "तस्याः पूर्वेण दिग्भागे सोमस्य परमा पुरी ।\nनाम्ना कान्तिमती शुभ्रा तत्र सोमो विराजते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005476023, "chapter_id": 25476, "verse_number": "१-४६-२४", "content_sanskrit": "तत्र ये भोगनिरता स्वधर्मं पुर्यपासते ।\nतेषां तदुचितं स्थानं नानाभोगसमन्वितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005476024, "chapter_id": 25476, "verse_number": "१-४६-२५", "content_sanskrit": "तस्याश्च पूर्वदिग्भागे शंकरस्य महापुरी ।\nनाम्ना यशोवती पुण्या सर्वेषां सा दुरासदा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005476025, "chapter_id": 25476, "verse_number": "१-४६-२६", "content_sanskrit": "तत्रेशानस्य भवनं रुद्रेणाधिष्टितं शुभम् ।\nघमेश्वरस्य विपुलं तत्रास्ते स गणावृतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005476026, "chapter_id": 25476, "verse_number": "१-४६-२७", "content_sanskrit": "तत्र भोगाभिलिप्सूनां भक्तानां परमेष्ठिनः ।\nनिवासः कल्पितः पूर्वं देवदेवेन शूलिना ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005476027, "chapter_id": 25476, "verse_number": "१-४६-२८", "content_sanskrit": "विष्णुपादाद् विनिष्क्रान्ता प्लावयित्वेन्दुमण्डलम् ।\nसमन्ताद् ब्रह्मणः पुर्यां गङ्गा पतति वै ततः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005476028, "chapter_id": 25476, "verse_number": "१-४६-२९", "content_sanskrit": "सा तत्र पतिता दिक्षु चतुर्धा ह्यभवद् द्विजाः ।\nसीता चालकनन्दा च सुचक्षुर्भद्रनामिका ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005476029, "chapter_id": 25476, "verse_number": "१-४६-३०", "content_sanskrit": "पूर्वेण शैवाच्छैलं तु सीता यात्यन्तरिक्षगा ।\nततश्च पूर्ववर्षेण भद्राश्वाद्याति चार्णवम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005476030, "chapter_id": 25476, "verse_number": "१-४६-३१", "content_sanskrit": "तथैवालकनन्दा च दक्षिणादेत्य भारतम् ।\nप्रयाति सागरं भित्त्वा सप्तभेदा द्विजोत्तमाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005476031, "chapter_id": 25476, "verse_number": "१-४६-३२", "content_sanskrit": "सुचक्षुः पश्चिमगिरीनतीत्य सकलांस्तथा ।\nपश्चिमं केतुमालाख्यं वर्षं गत्वैति चार्णवम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005476032, "chapter_id": 25476, "verse_number": "१-४६-३३", "content_sanskrit": "भद्रा तथोत्तरगिरीनुत्तरांश्च तथा कुरून् ।\nअतीत्य चोत्तराम्भोधिं समभ्येति महर्षयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005476033, "chapter_id": 25476, "verse_number": "१-४६-३४", "content_sanskrit": "आनीलनिषधायामौ माल्यवद्गन्धमादनौ ।\nतयोर्मध्यगतो मेरुः कर्णिकाकारसंस्थितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005476034, "chapter_id": 25476, "verse_number": "१-४६-३५", "content_sanskrit": "भारताः केतुमालाश्च भद्राश्वाः कुरवस्तथा ।\nपत्राणि लोकपद्मस्य मर्यादाशैलबाह्यतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005476035, "chapter_id": 25476, "verse_number": "१-४६-३६", "content_sanskrit": "जठरो देवकूटश्च मर्यादापर्वतावुभौ ।\nदक्षिणोत्तरमायातावानीलनिषधायतौ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005476036, "chapter_id": 25476, "verse_number": "१-४६-३७", "content_sanskrit": "गन्धमादनकैलासौ पूर्वपश्चायतावुभौ ।\nअशीतियोजनायामावर्णवान्तर्व्यवस्थितौ ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005476037, "chapter_id": 25476, "verse_number": "१-४६-३८", "content_sanskrit": "निषधः पारियात्रश्च मर्यादापर्वताविमौ ।\nमेरोः पश्चिमदिग्भागे यथापूर्व व्यवस्थितौ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005476038, "chapter_id": 25476, "verse_number": "१-४६-३९", "content_sanskrit": "त्रिश्रृङ्गो जारुधिस्तद्वदुत्तरे वर्षपर्वतौ ।\nपूर्वपश्चायतावेतौ अर्णवान्तर्व्यवस्थितौ ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005476039, "chapter_id": 25476, "verse_number": "१-४६-४०", "content_sanskrit": "मर्यादापर्वताः प्रोक्ता अष्टाविह मया द्विजाः ।\nजठराद्याः स्थिता मेरोश्चतुर्दिक्षु महर्षयः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]