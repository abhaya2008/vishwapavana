[{"id": 2098228, "chapter_id": 3102, "verse_number": "१३-२३२-१", "content_sanskrit": "महेश्वर उवाच।\nविधानं सुकृतस्यापि भूयः शृणु शुचिस्मिते।\nप्रोच्यते तत्त्रिधा देवि सुकृतं च समासतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098229, "chapter_id": 3102, "verse_number": "१३-२३२-२", "content_sanskrit": "यदौपरमिकं चैव सुकृतं निरुपद्रवम्।\nतथैव सोपकरणं तावता सुकृतं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098230, "chapter_id": 3102, "verse_number": "१३-२३२-३", "content_sanskrit": "निवृत्तिः पापकर्मभ्यस्तदौपरमिकं प्रिये।\nमनोवाक्कायजा दोषाः शृणु मे वर्जनाच्छुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098231, "chapter_id": 3102, "verse_number": "१३-२३२-४", "content_sanskrit": "त्रैविध्यदोषोपरमे यस्तु दोषव्यपेक्षया।\nस हि प्राप्नोति सकलं सर्वदुष्कृतवर्जनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098232, "chapter_id": 3102, "verse_number": "१३-२३२-५", "content_sanskrit": "प्रथमं वर्जयेद्दोषान्युगपत्पृथगेव वा।\nतथा धर्ममवाप्नोति दोषत्यागो हि दुष्करः।\nदोषसाकल्यसंत्यागान्मुनिर्भवति मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098233, "chapter_id": 3102, "verse_number": "१३-२३२-६", "content_sanskrit": "सौकर्यं पस्य धर्मस्य कार्यारम्भादृतेऽपि च।\nआत्मा च लब्धोपरमो लभन्ते सुकृतं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098234, "chapter_id": 3102, "verse_number": "१३-२३२-७", "content_sanskrit": "अहो नृशंसाः पच्यन्ते मानुषाः स्वल्पबुद्धयः।\nएतादृशं न बुध्यन्ते आत्माधीनं न निर्व्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098235, "chapter_id": 3102, "verse_number": "१३-२३२-८", "content_sanskrit": "दुष्कृतत्यागमात्रेण पदमूर्ध्वं हि लभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098236, "chapter_id": 3102, "verse_number": "१३-२३२-९", "content_sanskrit": "पापभीरुत्वमात्रेण दोषाणां परिवर्जनात्।\nसुशोभनो भवेद्देवि क्रजुर्धर्मव्यपेक्षया।\nइत्यौपरमिकं देवि कथितं सुकृतं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098237, "chapter_id": 3102, "verse_number": "१३-२३२-१०", "content_sanskrit": "श्रुत्वा च वृद्धसंयोगादिन्द्रियाणां च निग्रहात्।\nसन्तोषाच्च धृतेश्चैव शक्यते दोषवर्जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098238, "chapter_id": 3102, "verse_number": "१३-२३२-११", "content_sanskrit": "तदेव धर्ममित्याहुर्दोषसंयमनं प्रिये।\nयमधर्मेण धर्मोस्ति नान्यः शुभतरः प्रिये।\nयमधर्मेण यतयः प्राप्नुवन्त्युत्तमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098239, "chapter_id": 3102, "verse_number": "१३-२३२-१२", "content_sanskrit": "ईश्वराणां प्रभवतां दरिद्राणां च वै नृणाम्।\nसफलो दोषसंत्यागो दानादपि शुभादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098240, "chapter_id": 3102, "verse_number": "१३-२३२-१३", "content_sanskrit": "तपो दानं महादेवि दोषमल्पं हि निर्भरेत्।\nसुकृतं यामिकं चोक्तं वक्ष्ये निरुपसाधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098241, "chapter_id": 3102, "verse_number": "१३-२३२-१४", "content_sanskrit": "सुखाभिसन्धिर्लोकानां सत्यं शौचमथार्जवम्।\nव्रतोपवासः प्रीतिश्च ब्रह्मचर्यं दमः शमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098242, "chapter_id": 3102, "verse_number": "१३-२३२-१५", "content_sanskrit": "एवमादि शुभं कर्म सुकृतं नियमाश्रितम्।\nशृणु तेषां विशेषांश्च कीर्तयिष्यामि भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098243, "chapter_id": 3102, "verse_number": "१३-२३२-१६", "content_sanskrit": "सत्यं स्वर्गस्य सोपानं पारावारस्य नौरिव।\nनास्ति सत्यात्परं दानं नास्ति सत्यात्परं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098244, "chapter_id": 3102, "verse_number": "१३-२३२-१७", "content_sanskrit": "यथा श्रुतं यथा दृष्टमात्मना यद्यथा कृतम्।\nतथा तस्याविकारेण वचनं सत्यलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098245, "chapter_id": 3102, "verse_number": "१३-२३२-१८", "content_sanskrit": "यच्छलेनाभिसंयुक्तं सत्यरूपं मृषैव तत्।\nसत्यमेव प्रवक्तव्यं पारावर्यं विजानता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098246, "chapter_id": 3102, "verse_number": "१३-२३२-१९", "content_sanskrit": "दीर्घायुश्च भवेत्सत्यात्कुलसन्तानपालकः।\nलोकसंस्थितिपालश्च भवेत्सत्येन मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098247, "chapter_id": 3102, "verse_number": "१३-२३२-२०x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098248, "chapter_id": 3102, "verse_number": "१३-२३२-२०", "content_sanskrit": "कथं सन्धारयन्मर्त्यो व्रतं शुभमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098249, "chapter_id": 3102, "verse_number": "१३-२३२-२१x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098250, "chapter_id": 3102, "verse_number": "१३-२३२-२१", "content_sanskrit": "पूर्वमुक्तं तु यत्पापं मनोवाक्कायकर्मभिः।\nव्रतवत्तस्य संत्यागस्तपोव्रतमिति स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2098251, "chapter_id": 3102, "verse_number": "१३-२३२-२२", "content_sanskrit": "त्याज्यं वा यदि वा जोष्यमव्रतेनि वृथा चरन्।\nतथा फलं न लभते तस्माद्धर्मं वृथा चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2098252, "chapter_id": 3102, "verse_number": "१३-२३२-२३", "content_sanskrit": "शुद्धकायो नरो भूत्वा स्नात्वा तीर्थ यथाविधि।\nपञ्चभूतानि चन्द्रार्कौ संध्ये धर्मयमौ पितॄन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2098253, "chapter_id": 3102, "verse_number": "१३-२३२-२४", "content_sanskrit": "आत्मनैव तथाऽऽत्मानं निवेद्य व्रतवच्चरेत्।\nव्रतमामरणाद्वाऽपि कालच्छेदेन वा हरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2098254, "chapter_id": 3102, "verse_number": "१३-२३२-२५", "content_sanskrit": "शाकादिषु व्रतं कुर्यात्तथा पुष्पफलादिषु।\nब्रह्मचर्यव्रतं कुर्यादुपवासव्रतं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2098255, "chapter_id": 3102, "verse_number": "१३-२३२-२६", "content_sanskrit": "एवमन्येषु बहुषु व्रतं कार्यं हितैषिणा।\nव्रतभङ्गो यथा न स्याद्रक्षितव्यं तथा बुधैः।\nव्रतभङ्गे महत्पापमिति विद्धि शुभेक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2098256, "chapter_id": 3102, "verse_number": "१३-२३२-२७", "content_sanskrit": "औषधार्थं यदज्ञानाद्गुरूणां वचनादपि।\nअनुग्रहार्थं बन्धूनां व्रतभङ्गो न दुष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2098257, "chapter_id": 3102, "verse_number": "१३-२३२-२८", "content_sanskrit": "व्रतापवर्गकाले तु दैवब्राह्मणपूजनम्।\nनरेण तु यथा विद्धि कार्यसिद्धिं यथाऽऽप्तुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2098258, "chapter_id": 3102, "verse_number": "१३-२३२-२९x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2098259, "chapter_id": 3102, "verse_number": "१३-२३२-२९", "content_sanskrit": "कथं शौचविधिस्तत्र तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2098260, "chapter_id": 3102, "verse_number": "१३-२३२-३०x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2098261, "chapter_id": 3102, "verse_number": "१३-२३२-३०", "content_sanskrit": "बाह्ममाभ्यन्तरं चेति द्विविधं शौचमिष्यते।\nमानसं सुकृतं यत्तच्छौचमाभ्यन्तरं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2098262, "chapter_id": 3102, "verse_number": "१३-२३२-३१", "content_sanskrit": "सदाऽऽहारविशुद्धिश्च कायप्रक्षालनं च यत्।\nबाह्यशौचं भवेदेतत्तथैवाचमनादिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2098263, "chapter_id": 3102, "verse_number": "१३-२३२-३२", "content_sanskrit": "मृच्चैव शुद्धदेशस्था गोशकृन्मूत्रमेव च।\nद्रव्याणि गन्धयुक्तानि यानि पुष्टिकराणि च।\nएतैः सम्मार्जयेत्कायमम्भसा च पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2098264, "chapter_id": 3102, "verse_number": "१३-२३२-३३", "content_sanskrit": "अक्षोभ्यं यत्प्रकीर्णं च नित्यस्रोतं च यज्जलम्।\nप्रायशस्तादृशे मज्जेदन्यथा च विवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2098265, "chapter_id": 3102, "verse_number": "१३-२३२-३४", "content_sanskrit": "त्रिस्त्रिराचमनं श्रेष्ठं निष्फेनैर्निर्मलैर्जलैः।\nतथा विण्मूत्रयोः शुद्धिरद्भिर्बहुमृदा भवेत्।\nतथैव जलसंशुद्धिर्यत्संशुद्धं तु संस्पृशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2098266, "chapter_id": 3102, "verse_number": "१३-२३२-३५", "content_sanskrit": "शकृता भूमिशुद्धिः स्याल्लौहानां भस्मना स्मृतम्।\nतक्षणं घर्षणं चैव दारवाणां विशोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2098267, "chapter_id": 3102, "verse_number": "१३-२३२-३६", "content_sanskrit": "दहनं मृण्मयानां च मर्त्यानां कृच्छ्रधारणम्।\nशेषाणां देवि सर्वेषामातपेन जलेन च।\nब्राह्मणानां च वाक्येन सदा संशोधनं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2098268, "chapter_id": 3102, "verse_number": "१३-२३२-३७", "content_sanskrit": "अदृष्टमद्भिर्निर्णिक्तं यच्च वाचा प्रशस्यते।\nएवमापदि संशुद्धिरेवं शौचं विधीयते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2098269, "chapter_id": 3102, "verse_number": "१३-२३२-३८x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2098270, "chapter_id": 3102, "verse_number": "१३-२३२-३८", "content_sanskrit": "आहारशुद्धिस्तु कथं देवदेव महेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2098271, "chapter_id": 3102, "verse_number": "१३-२३२-३९x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2098272, "chapter_id": 3102, "verse_number": "१३-२३२-३९", "content_sanskrit": "अमांसमद्यमक्लेद्यमपर्युषितमेव च।\nअतिकट्वम्ललवणहनं च शुभगन्धि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2098273, "chapter_id": 3102, "verse_number": "१३-२३२-४०", "content_sanskrit": "क्रिमिकेशमलैर्हीनं संवृतं शुद्धदर्शम्।\nएवंविधं सदाहार्यं देवब्राह्मणसात्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2098274, "chapter_id": 3102, "verse_number": "१३-२३२-४१", "content_sanskrit": "श्रुतमित्येव तज्ज्ञेयमन्यथा मन्यसेऽशुभम्।\nग्राम्यादारण्यकैः सिद्धं श्रेष्ठमित्यवधारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2098275, "chapter_id": 3102, "verse_number": "१३-२३२-४२", "content_sanskrit": "अतिमात्रगृहीतात्तु अल्पदत्तं भवेच्छुचि।\nयज्ञशेषं हविःशेषं पितृशेषं च निर्मलम्।\nइति ते कथितं देवि भूयः किं श्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2098276, "chapter_id": 3102, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्वात्रिंशदधिकद्विशततमोऽध्यायः॥ २३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]