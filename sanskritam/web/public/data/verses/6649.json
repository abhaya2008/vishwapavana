[
  {
    "id": 20007300,
    "chapter_id": 6649,
    "verse_number": "19.1",
    "content_sanskrit": "अथोत्तस्थे रणाटव्यामसुहृद्वेणुदारिणा । नृपाङ्घ्रिपौघसंघर्षादग्निवद्वेणुदारिणा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20007301,
    "chapter_id": 6649,
    "verse_number": "19.2",
    "content_sanskrit": "आपतन्तममुन्दूरादूरीकृतपराक्रमः । बलोऽवलोकयामास मातङ्गमिव केसरी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20007302,
    "chapter_id": 6649,
    "verse_number": "19.3",
    "content_sanskrit": "जजौजोजाजिजिज्जाजी तं ततोऽतिततातितुत् । भाभोऽभीभाभिभूभारारारिररिरीररः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20007303,
    "chapter_id": 6649,
    "verse_number": "19.4",
    "content_sanskrit": "भवन्भवाय लोकानामाकम्पितमहीतलः । निर्घात इव निर्घोषभीमस्तस्यापतद्रथः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20007304,
    "chapter_id": 6649,
    "verse_number": "19.5",
    "content_sanskrit": "रामे रिपुः शरानाजिमहेष्वास विचक्षणे । कोपादथैनं शितमा महेष्वा स विचक्षणे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20007305,
    "chapter_id": 6649,
    "verse_number": "19.6",
    "content_sanskrit": "दिशमर्कमिवावाचीम्मूर्च्छागतमपाहरत् । मन्दप्रतापं तं सूतः शीघ्रमाजिविहायसः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20007306,
    "chapter_id": 6649,
    "verse_number": "19.7",
    "content_sanskrit": "कृत्वा शिनेः शाल्वचमूं सप्रभावा चमूर्जिताम् । ससर्ज वक्त्रैः फुल्लाब्जसप्रभा वाचमूर्जिताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20007307,
    "chapter_id": 6649,
    "verse_number": "19.8",
    "content_sanskrit": "उल्मुकेन द्रुमं प्राप्य संकुचत्पत्रसंपदम् । तेजः प्रकिरता दिक्षु सप्रतापमदीप्यत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20007308,
    "chapter_id": 6649,
    "verse_number": "19.9",
    "content_sanskrit": "पृथोरध्यक्षिपधृद्रुक्मी यया चापमुदायुधः । तयैव वाचापगमं ययाचापमुदायुधः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20007309,
    "chapter_id": 6649,
    "verse_number": "19.10",
    "content_sanskrit": "समं समन्ततो राज्ञामापतन्तीरनीकिनीः । कार्ष्णिः प्रत्यग्रहीदेकः सारस्वानिव निम्नगाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20007310,
    "chapter_id": 6649,
    "verse_number": "19.11",
    "content_sanskrit": "दधानैर्घनसादृश्यं लसदायसदंशनैः । तत्र काञ्चनसच्छाया ससृजे तैः शराशनिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20007311,
    "chapter_id": 6649,
    "verse_number": "19.12",
    "content_sanskrit": "नखांशुमञ्जरीकीर्णमसौतरुरिवोच्चकैः । बभौ विभ्रमद्धनुःशाखामधिरूढशिलीमुखाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20007312,
    "chapter_id": 6649,
    "verse_number": "19.13",
    "content_sanskrit": "प्रप्य भीममसौ जन्यं सौजन्यं दधदानते । विध्यन्मुमोच न रिपूनरिपूगान्तकः शरैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20007313,
    "chapter_id": 6649,
    "verse_number": "19.14",
    "content_sanskrit": "कृतस्य सर्वक्षितिपैर्विजयाशंसया पुरः । अनेकस्य चकारासौ बाणैर्बाणस्य खण्डनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20007314,
    "chapter_id": 6649,
    "verse_number": "19.15",
    "content_sanskrit": "याबभार कृतानेकमाया सेना ससारताम् । धनुः स कर्षन्रहितमायासेनाससार ताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20007315,
    "chapter_id": 6649,
    "verse_number": "19.16",
    "content_sanskrit": "ओजो महौजाः कृत्वाधस्तत्क्षणादुत्तमौजसः । कुर्वन्नाजावमुख्यत्वमनमन्नाम मुख्यताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20007316,
    "chapter_id": 6649,
    "verse_number": "19.17",
    "content_sanskrit": "दूरादेव चमूर्भल्लैः कुमारो हन्ति स स्म याः । न पुनः सांयुगीं ताः स्म कुमारो हन्ति सस्मयाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20007317,
    "chapter_id": 6649,
    "verse_number": "19.18",
    "content_sanskrit": "निपीड्य तरसा तेन मुक्ताः काममनास्थया । उपाययुर्विलक्षत्वं विद्विषो न शिलीमुखाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20007318,
    "chapter_id": 6649,
    "verse_number": "19.19",
    "content_sanskrit": "तस्यावदानैः समरे सहसा रोमहर्षिभिः । सुरैरशंसि व्योमस्थैः सह सारो महर्षिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20007319,
    "chapter_id": 6649,
    "verse_number": "19.20",
    "content_sanskrit": "सुगन्धयद्दिशः शुभ्रमम्लानि कुसुमं दिवः । भूरि तत्रापतत्तस्मादुत्पपात दिवं यशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20007320,
    "chapter_id": 6649,
    "verse_number": "19.21",
    "content_sanskrit": "सोढुं तस्य द्विषो नालमवयोधरवा रणम् । ऊर्णुनाव यशश्च द्यामपयोधरवारणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20007321,
    "chapter_id": 6649,
    "verse_number": "19.22",
    "content_sanskrit": "केशप्रचुरलोकस्य पर्यस्कारि विकासिना । शेखरेणेव युद्धस्य शिरः कुसुमलक्ष्मणा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20007322,
    "chapter_id": 6649,
    "verse_number": "19.23",
    "content_sanskrit": "सादरं युद्धमानापि तेनान्यनरसादरम् । सा दरं पृतना निन्ये हीयमाना रसादरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20007323,
    "chapter_id": 6649,
    "verse_number": "19.24",
    "content_sanskrit": "इत्यालिङ्गतामालोक्य जयलक्ष्म्या झषध्वजम् । क्रुद्धयेव क्रुधा सद्यः प्रपेदे चेदिभूपतिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20007324,
    "chapter_id": 6649,
    "verse_number": "19.25",
    "content_sanskrit": "अहितानभि वाहिन्या स मानी चतुरङ्गया । चचाल वल्ल्गत्कलभसमानीचतुरङ्गया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20007325,
    "chapter_id": 6649,
    "verse_number": "19.26",
    "content_sanskrit": "ततस्ततधनुर्मौर्वीविस्फारस्फारिनिःस्वनैः । तूर्यैर्युगक्षये क्षुभ्यदकूपारानुकारिणी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20007326,
    "chapter_id": 6649,
    "verse_number": "19.27",
    "content_sanskrit": "सकारनानारकास कायसाददसायका । रसाहवावाहसार नादवाददवादना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20007327,
    "chapter_id": 6649,
    "verse_number": "19.28",
    "content_sanskrit": "लोलासिकालियकुला यमस्यैव स्वसा स्वयम् । चिकीर्षुरुल्लसल्लोहवर्मश्यामा सहायताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20007328,
    "chapter_id": 6649,
    "verse_number": "19.29",
    "content_sanskrit": "सासेनागमनारम्भे रसेनासीदनारता । तारनादजनामत्त धीरनागमनामया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20007329,
    "chapter_id": 6649,
    "verse_number": "19.30",
    "content_sanskrit": "धूतधौतासयः प्रष्ठाः प्रतिष्ठन्तक्षमाभृताम् । शौर्यनुरागनिकषः सा हि वेलानुजीविनाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20007330,
    "chapter_id": 6649,
    "verse_number": "19.31",
    "content_sanskrit": "दिवमिन्युधा गन्तुं कोमलामलसम्पदम् । दधौ दधानोऽसिलतां कोऽमलामलसम्पदम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20007331,
    "chapter_id": 6649,
    "verse_number": "19.32",
    "content_sanskrit": "कृतोरुवेगं युगपद्व्यजिगीषन्त सैनिकाः । विपक्षं बाहुपरिघैर्जङ्घाभिरितरेतरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20007332,
    "chapter_id": 6649,
    "verse_number": "19.33",
    "content_sanskrit": "वाहनाजनि मानासे साराजावनमा ततः । मत्तसारगराजेभे भारीहावज्जनध्वनि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20007333,
    "chapter_id": 6649,
    "verse_number": "19.34",
    "content_sanskrit": "निध्वनज्जवहारीभा भेजे रागरसात्तमः । ततमानवजारासा सेना मानिजनाहवा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20007334,
    "chapter_id": 6649,
    "verse_number": "19.35",
    "content_sanskrit": "अभग्नवृत्ताः प्रसभादाकृष्टा यौवनोद्धतैः । चक्रन्दुरुच्चकैर्मुष्टिग्राह्यमध्या धनुर्लताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20007335,
    "chapter_id": 6649,
    "verse_number": "19.36",
    "content_sanskrit": "करेणुः प्रम्थितोऽनेको रेणुर्घण्टाः सहस्रशः । करेणुः शीकरो जज्ञे रेणुस्तेन शमं ययौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20007336,
    "chapter_id": 6649,
    "verse_number": "19.37",
    "content_sanskrit": "धृतप्रत्यग्रशृङ्गाररसरागरपि द्विपैः । सरोषसम्भ्रमैर्बर्भ्रे रौद्र एव रणे रसः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20007337,
    "chapter_id": 6649,
    "verse_number": "19.38",
    "content_sanskrit": "न तस्थौ भर्तृतः प्राप्तमानसम्प्रतिपत्तिषु । रणैकसर्गेषु भयं मानसं प्रति पत्तिषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20007338,
    "chapter_id": 6649,
    "verse_number": "19.39",
    "content_sanskrit": "बाणाहितपूर्णतूणीरकोटरैर्धन्विशाखिभिः । गोधाश्लिष्टभुजाशाखैरभूद्भीमा रणाटवी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20007339,
    "chapter_id": 6649,
    "verse_number": "19.40",
    "content_sanskrit": "नानाजाववजानाना सा जनौघघनौजसा । परानिहऽहानिराप तान्वियाततयान्विता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20007340,
    "chapter_id": 6649,
    "verse_number": "19.41",
    "content_sanskrit": "विषमं सर्वतोभद्रचक्रगोमूत्रिकादिभिः । श्लोकैरिवमहाकाव्यं व्यूहैस्तदभवद्बलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20007341,
    "chapter_id": 6649,
    "verse_number": "19.42",
    "content_sanskrit": "संहत्या सात्वतां चैद्यं प्रति भास्वरसेनया । ववले योद्धुमुत्पन्नप्रतिमा स्वरसेन या ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20007342,
    "chapter_id": 6649,
    "verse_number": "19.43",
    "content_sanskrit": "विस्तीर्णमायामवती लोललोकनिरन्तरा । नरेन्द्रमार्गं रथ्येव पपात द्विषतां बलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20007343,
    "chapter_id": 6649,
    "verse_number": "19.44",
    "content_sanskrit": "वारणागगभीरा सा साराभीगगणारवा । कारितारिवधा सेना नासेधा वारितारिका ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20007344,
    "chapter_id": 6649,
    "verse_number": "19.45",
    "content_sanskrit": "अधिनागं प्रजविनो विकसत्पिच्छचारवः । पेतुर्बर्हिणदेशीयाः शङ्कवः प्राणहारिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20007345,
    "chapter_id": 6649,
    "verse_number": "19.46",
    "content_sanskrit": "प्रवृत्तेविकसद्ध्वानंसाधनेप्यविषादिभिः । ववृषेविकसद्दानंयुधमाप्यविषाणिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20007346,
    "chapter_id": 6649,
    "verse_number": "19.47",
    "content_sanskrit": "पुरः प्रयुक्तैर्युद्धं तच्चलितैर्लब्धशुद्धिभिः । आलापैरिव गान्धर्वमदीप्यत पदातिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20007347,
    "chapter_id": 6649,
    "verse_number": "19.48",
    "content_sanskrit": "केनचित्स्वासिनान्येषां मण्डलाग्रानवद्यता । प्रापे कीर्तिप्लुतमहीमण्डलाग्रानवद्यत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20007348,
    "chapter_id": 6649,
    "verse_number": "19.49",
    "content_sanskrit": "विहन्तुं विद्विषस्तीक्ष्णः सममेव सुसंहतेः । परिवारात्पृथक्चक्रे खड्गश्चात्मा च केनचित् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20007349,
    "chapter_id": 6649,
    "verse_number": "19.50",
    "content_sanskrit": "अन्येन विदधेऽरीणामतिमात्रा विलासिना । उद्गूर्णेन चमूस्तूर्णमतिमात्राविलासिना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20007350,
    "chapter_id": 6649,
    "verse_number": "19.51",
    "content_sanskrit": "सहस्रपूरणः कश्चिल्लूनमूर्धासिना द्विषः । तथोर्ध्व एव काबन्धीमभजन्नर्तनक्रियाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20007351,
    "chapter_id": 6649,
    "verse_number": "19.52",
    "content_sanskrit": "शस्त्रव्रणमयश्रीमदलङ्करणभूषषितः । ददृशेऽन्यो रावणवदलङ्करणभूषितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20007352,
    "chapter_id": 6649,
    "verse_number": "19.53",
    "content_sanskrit": "द्विषद्विशसनच्छेदनिरस्तोरुयुगोऽपरः । सिक्तश्चास्त्रैरुभयथा बभूवारुणविग्रहः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20007353,
    "chapter_id": 6649,
    "verse_number": "19.54",
    "content_sanskrit": "भीमतामपरोऽम्भोधिसमेऽधित महाहवे । दाक्षे कोपः शिवस्येव समेधितमहा हवे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20007354,
    "chapter_id": 6649,
    "verse_number": "19.55",
    "content_sanskrit": "दन्तौश्चिच्छिदिरे कोपात्प्रतिपक्षं गजा इव । परनिस्त्रिंशनिर्लूनकरवालाः पदातयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20007355,
    "chapter_id": 6649,
    "verse_number": "19.56",
    "content_sanskrit": "रणे रभसनिर्भिन्नद्विपपाटविकासिनि । न तत्र गतभीः कश्चिद्विपपाट विकासिनि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20007356,
    "chapter_id": 6649,
    "verse_number": "19.57",
    "content_sanskrit": "यावन्न सत्कृतैर्भर्तुः स्नेहस्यानृण्यमिच्छुभिः । अमर्षादितरैस्तावत्तत्यजे युधि जीवितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20007357,
    "chapter_id": 6649,
    "verse_number": "19.58",
    "content_sanskrit": "अयशोभिदुरालोके कोपधामरणादृते । अयशोभिदुरा लोके कोपधा मरणादृते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20007358,
    "chapter_id": 6649,
    "verse_number": "19.59",
    "content_sanskrit": "स्खलन्ती नक्वचित्तैक्ष्णादभ्यग्रफलशालिनी । अमोचि शक्तिः शक्तिकैर्लोहजा न शरीरजा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20007359,
    "chapter_id": 6649,
    "verse_number": "19.60",
    "content_sanskrit": "अपादि व्यापृतनयांस्तथा युयुधिरे नृपाः । आप दिव्या पृतनया विस्मयं जनता यथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20007360,
    "chapter_id": 6649,
    "verse_number": "19.61",
    "content_sanskrit": "स्वगुणैराफलप्राप्तेराकृष्य गणिका इव । कामुकानिव नालीकांस्त्रिणन्ताः सहसामुचन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20007361,
    "chapter_id": 6649,
    "verse_number": "19.62",
    "content_sanskrit": "वाजिनः शत्रुसैन्यस्य समारब्धनवाजिनः । वाजिनश्च शरा मध्यमविशन्द्रुतवाजिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20007362,
    "chapter_id": 6649,
    "verse_number": "19.63",
    "content_sanskrit": "पुरस्कृत्य फलं प्राप्तैः सत्पक्षाश्रययशालिभिः । कृतपुङ्खतया लेभे लक्षमप्याशु मार्गणैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20007363,
    "chapter_id": 6649,
    "verse_number": "19.64",
    "content_sanskrit": "रक्तश्रुतिं जपासूनसमरागामिषुव्यधात् । कश्चित्पुरः सपत्नेषु समरागमिषुव्यधात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20007364,
    "chapter_id": 6649,
    "verse_number": "19.65",
    "content_sanskrit": "रयेण रणकाम्यन्तौ दूरादुपगतविभौ । गतासुरन्तरा दन्ती वरण्डक इवाभवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20007365,
    "chapter_id": 6649,
    "verse_number": "19.66",
    "content_sanskrit": "भूरिभिर्भारिभिर्भीरैर्भूभारैरभिरेभिरे । भेरीरेभिभिरभ्राभैरभीरुभिरिभैरिभाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20007366,
    "chapter_id": 6649,
    "verse_number": "19.67",
    "content_sanskrit": "निशितासिलतालूनैस्तथा हस्तैर्न हस्तिनः । युध्यमाना यथा दन्तैर्भग्नैरापुर्विहस्ततां ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20007367,
    "chapter_id": 6649,
    "verse_number": "19.68",
    "content_sanskrit": "निपीडनादिव मिथो दानतोयनारतम् । वपुषामदयापातादिभानामभितोऽगलत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20007368,
    "chapter_id": 6649,
    "verse_number": "19.69",
    "content_sanskrit": "रणाङ्गणं सर इव प्लावितं मदवारिभिः । गजः पृथुकराकृष्टशतपत्रमलोडयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20007369,
    "chapter_id": 6649,
    "verse_number": "19.70",
    "content_sanskrit": "शरक्षते गजे भृङ्गैः सविषादिविषादिनि । रुतव्याजेन रुदितं तत्रासीदतिसीदति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20007370,
    "chapter_id": 6649,
    "verse_number": "19.71",
    "content_sanskrit": "अन्तकस्य पृथौ तत्र शयनीय इवाहवे । दशनव्यसनादीयुर्मत्कुणत्वं मतङ्गजाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20007371,
    "chapter_id": 6649,
    "verse_number": "19.72",
    "content_sanskrit": "अभीकमतिकेनेद्धे भीतानन्दस्यनाशने । कनत्सकामसेनाके मन्दकामकमस्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20007372,
    "chapter_id": 6649,
    "verse_number": "19.73",
    "content_sanskrit": "दधतोऽपि रणे भीममभीक्ष्णं भावमासुरम् । हताः परैरभिमुखाः सुरभूयमुपाययुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20007373,
    "chapter_id": 6649,
    "verse_number": "19.74",
    "content_sanskrit": "येनाङ्गमूहे व्रणवत्सरुचा परतोऽमरैः । समत्वं स ययौ खड्गत्सरुचापरतोऽमरैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20007374,
    "chapter_id": 6649,
    "verse_number": "19.75",
    "content_sanskrit": "निपातितसुहृत्स्वामिपितृव्यभ्रातृमातुलम् । पाणिनीयमिवावलोकि धीरैस्तत्समराजिरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20007375,
    "chapter_id": 6649,
    "verse_number": "19.76",
    "content_sanskrit": "अभावि सिन्ध्वा सन्ध्याभ्रसदृग्रुधिरतोयया । हृते योद्धुं जनः पांशौ स दृग्रुधि रतो यथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20007376,
    "chapter_id": 6649,
    "verse_number": "19.77",
    "content_sanskrit": "विदलत्पुष्कराकीर्णाः पतच्छङ्खकुलाकुलाः । तरत्पत्ररथा नद्यः प्रासर्पन्रक्तवारिजाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20007377,
    "chapter_id": 6649,
    "verse_number": "19.78",
    "content_sanskrit": "असृग्जनोऽस्त्रक्षतिमानवमज्जवसादनम् । रक्षःपिशाचं मुमुदे नवमज्जवसादनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20007378,
    "chapter_id": 6649,
    "verse_number": "19.79",
    "content_sanskrit": "चित्रं चापैरपेतज्यैः स्फुरद्रक्तशतहृदम् । पयोदजालमिव तद्वीराशंसनमाबभौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20007379,
    "chapter_id": 6649,
    "verse_number": "19.80",
    "content_sanskrit": "बन्धौ विपन्नेऽनेकेन नरेणेह तदन्तिके । अशोचि सैन्ये घण्टाभिर्न रेणे हतदन्तिके ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20007380,
    "chapter_id": 6649,
    "verse_number": "19.81",
    "content_sanskrit": "कृत्तैः कीर्णा मही रेजे दन्तैर्गात्रैश्च दन्तिनाम् । क्षुण्णलोकासुभिर्मृत्योर्मुसलोलूखलैरिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20007381,
    "chapter_id": 6649,
    "verse_number": "19.82",
    "content_sanskrit": "युद्धमित्थं विधूतान्यमानवानभियो गतः । चैद्यः परान्पराजिग्ये मानवानभियोगतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20007382,
    "chapter_id": 6649,
    "verse_number": "19.83",
    "content_sanskrit": "अथ वक्षोमणिच्छायाच्छुरितापीतवाससा । स्फुरदिन्द्रधनुर्भिन्नतडितेव तडित्त्वता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20007383,
    "chapter_id": 6649,
    "verse_number": "19.84",
    "content_sanskrit": "नीलेनानालनलिननिलीनोल्ललनालिना । ललनालालनेनालं लीलालोलेन लालिना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20007384,
    "chapter_id": 6649,
    "verse_number": "19.85",
    "content_sanskrit": "अपूर्वयेव तत्कालसमागमसकामया । दृष्टेन राजन्वपुषा कटाक्षैर्विजयश्रिया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20007385,
    "chapter_id": 6649,
    "verse_number": "19.86",
    "content_sanskrit": "विभावी विभवी भाभो विभाभावी विवो विभीः । भवाभिभावी भावावो भवाभावो भुवो विभुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20007386,
    "chapter_id": 6649,
    "verse_number": "19.87",
    "content_sanskrit": "उपैतुकामैस्तत्पारं निश्चितैर्योगिभिः परैः । देहत्यागकृतोद्योगैरदृश्यत परः पुमान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20007387,
    "chapter_id": 6649,
    "verse_number": "19.88",
    "content_sanskrit": "तं श्रिया घनयानस्तरुचा सारतया तया । यातया तरसा चारुस्तनयानघया श्रितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20007388,
    "chapter_id": 6649,
    "verse_number": "19.89",
    "content_sanskrit": "विद्विषोऽद्विषुरुद्वीक्ष्य तथाप्यासन्निरेनसः । अरुच्यमपि रोगघ्नं निसर्गादेव भेषजम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20007389,
    "chapter_id": 6649,
    "verse_number": "19.90",
    "content_sanskrit": "विदितं दिवि केऽनीके तं यातं निजिताजिनि । विगदं गवि रोद्धारो योद्धा यो नतिमेति नः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20007390,
    "chapter_id": 6649,
    "verse_number": "19.91",
    "content_sanskrit": "नियुज्यमानेन पुरः कर्मण्यतिगरीयसि । आरोप्यमाणोरुगुणं भर्त्रा कार्मुकमानमत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20007391,
    "chapter_id": 6649,
    "verse_number": "19.92",
    "content_sanskrit": "तत्र बाणाः सुपरुषः समधीयन्त चारवः । द्विषामभूत्सुपरुषस्तस्याकृष्टस्य चारवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20007392,
    "chapter_id": 6649,
    "verse_number": "19.93",
    "content_sanskrit": "पश्चात्कृतानामप्यस्य नराणामिव पत्रिणाम् । योयो गुणेन संयुक्तः स स कर्णान्तमाययौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20007393,
    "chapter_id": 6649,
    "verse_number": "19.94",
    "content_sanskrit": "प्रपे रूपी पुरारेपाः परिपूरी परः परैः । रोपैरपारैरुपरि पुपूरेऽपि पुरोऽपरैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20007394,
    "chapter_id": 6649,
    "verse_number": "19.95",
    "content_sanskrit": "दिङ्मुखव्यापिनस्तीक्ष्णान्ह्रदिनो मर्मभेदिनः । चिक्षेपैकक्षणेनैव सायकानहितांश्च सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20007395,
    "chapter_id": 6649,
    "verse_number": "19.96",
    "content_sanskrit": "शरवर्षी महानादः स्फुरत्कार्मुककेतनः । नीलच्छविरसौ रेजे केशवच्छलनीरदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20007396,
    "chapter_id": 6649,
    "verse_number": "19.97",
    "content_sanskrit": "न केवलं जनैस्तस्य लघुसंधायिनो धनुः । मण्डलीकृतमोकान्ताद्बलमैक्षि द्विषामपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20007397,
    "chapter_id": 6649,
    "verse_number": "19.98",
    "content_sanskrit": "लोकालोकी कलोऽकल्ककलिलोऽलिकुलालकः । कालोऽकलोऽकलिः काले कोलकेलिकिलः किल ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20007398,
    "chapter_id": 6649,
    "verse_number": "19.99",
    "content_sanskrit": "अक्षितारासु विव्याध द्विषतः स तनुत्रिणः । दानेषु स्थूललक्ष्यत्वं न हि तस्य शरासने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20007399,
    "chapter_id": 6649,
    "verse_number": "19.100",
    "content_sanskrit": "वररोऽविवरो वैरिविवारी वारिरारवः । विववार वरो वैरं वीरो रविरिवौर्वरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20007400,
    "chapter_id": 6649,
    "verse_number": "19.101",
    "content_sanskrit": "मुक्तानेकशरं प्रणानहरद्भूयसां द्विषां । तदीयं धनुरन्यस्य न हि सेहे सजीवताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20007401,
    "chapter_id": 6649,
    "verse_number": "19.102",
    "content_sanskrit": "राजराजी रुरोजाजेरजिरेऽजोऽजरोऽरजाः । रेजारिजूरजोर्जार्जी रराजर्जुरजर्जरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20007402,
    "chapter_id": 6649,
    "verse_number": "19.103",
    "content_sanskrit": "उद्धतान्द्विषतस्तस्य निध्नतो द्वितयं ययुः । पानार्थे रुधिरं धातौ रक्षार्थे भुवनं शराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20007403,
    "chapter_id": 6649,
    "verse_number": "19.104",
    "content_sanskrit": "क्रूरारिकारि कीरेककारकः कारिकाकरः । कोरकाकारकरकः करीरः कर्करोर्ऽकरुक् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 104,
    "avatarnika": ""
  },
  {
    "id": 20007404,
    "chapter_id": 6649,
    "verse_number": "19.105",
    "content_sanskrit": "विधातुमवतीर्णोऽपि लघिमानमसौ भुवः । अनेकमरिसंघातमकरोद्भूमिवर्धनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 105,
    "avatarnika": ""
  },
  {
    "id": 20007405,
    "chapter_id": 6649,
    "verse_number": "19.106",
    "content_sanskrit": "दारी दरदरिद्रोऽरिदारूदारोऽद्रिदूरदः । दूरादरौद्राददरद्रोदोरुद्दारुरादरी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 106,
    "avatarnika": ""
  },
  {
    "id": 20007406,
    "chapter_id": 6649,
    "verse_number": "19.107",
    "content_sanskrit": "एकेषुणा सङ्घतिथान्द्विषो भिन्दन्द्रुमानिव । स जन्मान्तररामस्य चक्रे सदृशमात्मनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 107,
    "avatarnika": ""
  },
  {
    "id": 20007407,
    "chapter_id": 6649,
    "verse_number": "19.108",
    "content_sanskrit": "शूरः शौरिरशिशिरैराशाशैराशु राशिशः । शरारुः श्रीशरीरेशः शुशूरेऽरिशिरः शरैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 108,
    "avatarnika": ""
  },
  {
    "id": 20007408,
    "chapter_id": 6649,
    "verse_number": "19.109",
    "content_sanskrit": "व्क्तासीदरितारिणां यत्तदीयास्तदा मुहुः । मनोहृतोऽपि हृदये लेगुरेषां न पत्रिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 109,
    "avatarnika": ""
  },
  {
    "id": 20007409,
    "chapter_id": 6649,
    "verse_number": "19.110",
    "content_sanskrit": "नामाक्षराणां मलना मा भूद्भर्तुरतः स्फुटम् । अगृह्णत पराङ्गनामसूनस्रं न मार्गणाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 110,
    "avatarnika": ""
  },
  {
    "id": 20007410,
    "chapter_id": 6649,
    "verse_number": "19.111",
    "content_sanskrit": "आच्छिद्य योधसार्थस्य प्राणसर्वस्वमाशुगाः । ऐकागारिकवद्भूमौ दूराज्जग्मुरदर्शनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 111,
    "avatarnika": ""
  },
  {
    "id": 20007411,
    "chapter_id": 6649,
    "verse_number": "19.112",
    "content_sanskrit": "भीमास्त्रराजिनस्तस्य बलस्य ध्वजराजिनः । कृतघोराजिनश्चक्रे भुवः सरुधिरा जिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 112,
    "avatarnika": ""
  },
  {
    "id": 20007412,
    "chapter_id": 6649,
    "verse_number": "19.113",
    "content_sanskrit": "मांसव्यधोचितमुखैः शून्यतां दधदक्रियम् । शकुन्तिभिः शत्रुबलं व्यापि तस्येषुभिर्नभः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 113,
    "avatarnika": ""
  },
  {
    "id": 20007413,
    "chapter_id": 6649,
    "verse_number": "19.114",
    "content_sanskrit": "दाददो दद्ददुद्दादी दादादो दूददीददोः । दुद्दादं दददे दुद्दे ददाददददोऽददः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 114,
    "avatarnika": ""
  },
  {
    "id": 20007414,
    "chapter_id": 6649,
    "verse_number": "19.115",
    "content_sanskrit": "प्लुतेभकुम्भोरसिजैर्हृदयक्षतिजन्मभिः । प्रावर्तयन्नदीरस्रैर्द्विषां तद्योषितां च सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 115,
    "avatarnika": ""
  },
  {
    "id": 20007415,
    "chapter_id": 6649,
    "verse_number": "19.116",
    "content_sanskrit": "सदामदबलप्रायः समुद्धृरसो बभौ । प्रतीतविक्रमः श्रीमन्हारिर्हरिरिवापरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 116,
    "avatarnika": ""
  },
  {
    "id": 20007416,
    "chapter_id": 6649,
    "verse_number": "19.117",
    "content_sanskrit": "द्विधा त्रिधा चतुर्धा च तमेकमपि शत्रवः । पश्यन्तः स्पर्धया सद्यः स्वयं पञ्चत्वमाययुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 117,
    "avatarnika": ""
  },
