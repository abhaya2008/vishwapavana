[{"id": 2006148, "chapter_id": 1122, "verse_number": "१-१२३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006149, "chapter_id": 1122, "verse_number": "१-१२३-१", "content_sanskrit": "धृतराष्ट्राभ्यनुज्ञातः स्वबाहुविजितं धनम्।\nभीष्माय सत्यवत्यै च मात्रे चोपजहार सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006150, "chapter_id": 1122, "verse_number": "१-१२३-२", "content_sanskrit": "विदुराय च वै पाण्डुः प्रेषयामास तद्धनम्।\nसुहृदश्चापि धर्मात्मा धनेन समतर्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006151, "chapter_id": 1122, "verse_number": "१-१२३-३", "content_sanskrit": "ततः सत्यवतीं भीष्मं कौसल्यां च यशस्विनीम्।\nशुभैः पाण्डुर्जितैरर्थैस्तोषयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006152, "chapter_id": 1122, "verse_number": "१-१२३-४", "content_sanskrit": "ननन्द माता कौसल्या तमप्रतिमतेजसम्।\nजयन्तमिव पौलोमी परिष्वज्य नर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006153, "chapter_id": 1122, "verse_number": "१-१२३-५", "content_sanskrit": "तस्य वीरस्य विक्रान्तैः सहस्रशतदक्षिणैः।\nअश्वमेधशतैरीजे धृतराष्ट्रो महामखैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006154, "chapter_id": 1122, "verse_number": "१-१२३-६", "content_sanskrit": "संप्रयुक्तस्तु कुन्त्या च माद्र्या च भरतर्षभ।\nजिततन्द्रिस्तदा पाण्डुर्बभूव वनगोचरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006155, "chapter_id": 1122, "verse_number": "१-१२३-७", "content_sanskrit": "हित्वा प्रासादनिलयं शुभानि शयनानि च।\nअरण्यनित्यः सततं बभूव मृगयापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006156, "chapter_id": 1122, "verse_number": "१-१२३-८", "content_sanskrit": "स चरन्दक्षिणं पार्श्वं रम्यं हिमवतो गिरः।\nउवास गिरिपृष्ठेषु महाशालवनेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006157, "chapter_id": 1122, "verse_number": "१-१२३-९", "content_sanskrit": "रराज कुन्त्या माद्र्या च पाण्डुः सह वने चरन्।\nकरेण्वोरिव मध्यस्थः श्रीमान्पौरन्दरो गजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006158, "chapter_id": 1122, "verse_number": "१-१२३-१०", "content_sanskrit": "भारतं सह भार्याभ्यां खङ्गबाणधनुर्धरम्।\nविचित्रकवचं वीरं परमास्त्रविदं नृपम्।\nदेवोऽयमित्यमन्यन्त चरन्तं वनवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006159, "chapter_id": 1122, "verse_number": "१-१२३-११", "content_sanskrit": "तस्य कामांश्च भोगांश्च नरा नित्यमतन्द्रिताः।\nउपजह्रुर्वनान्तेषु धृतराष्ट्रेण चोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006160, "chapter_id": 1122, "verse_number": "१-१२३-१२", "content_sanskrit": "तदासाद्य महारण्यं मृगव्यालनिषेवितम्।\nतत्र मैथुनकालस्थं ददर्श मृगयूथपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006161, "chapter_id": 1122, "verse_number": "१-१२३-१३", "content_sanskrit": "ततस्तं च मृगीं चैव रुक्मपुङ्खैः सुपत्रिभिः।\nनिर्बिभेद शरैस्तीक्ष्णैः पाण्डुः पञ्चभिराशुगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006162, "chapter_id": 1122, "verse_number": "१-१२३-१४", "content_sanskrit": "स च राजन्महातेजा ऋषिपुत्रस्तपोधनः।\nभार्यया सह तेजस्वी मृगरूपेण सङ्गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006163, "chapter_id": 1122, "verse_number": "१-१२३-१५", "content_sanskrit": "स संयुक्तस्तया मृग्या मानुषीं वाचमीरयन्।\nक्षणेन पतितो भूमौ विललापातुरो मृगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006164, "chapter_id": 1122, "verse_number": "१-१२३-१६x", "content_sanskrit": "मृग उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006165, "chapter_id": 1122, "verse_number": "१-१२३-१६", "content_sanskrit": "काममन्युवशं प्राप्ता बुद्ध्यन्तरगता अपि।\nवर्जयन्ति नृशंसानि पापेष्वपि रता नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006166, "chapter_id": 1122, "verse_number": "१-१२३-१७", "content_sanskrit": "न विधिं ग्रसते प्रज्ञा प्रज्ञां तु ग्रसते विधिः।\nविधिपर्यागतानर्थान्प्रज्ञावान्प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006167, "chapter_id": 1122, "verse_number": "१-१२३-१८", "content_sanskrit": "शस्वद्धर्मात्मनां मुख्ये कुले जातस्य भारत।\nकामलोभाभिभूतस्य कथं ते चलिता मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006168, "chapter_id": 1122, "verse_number": "१-१२३-१९x", "content_sanskrit": "पाण्डुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006169, "chapter_id": 1122, "verse_number": "१-१२३-१९", "content_sanskrit": "शत्रूणां या वधे वृत्तिः सा मृगाणां वधे स्मृता।\nराज्ञां मृग न मां मोहात्त्वं गर्हयितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2006170, "chapter_id": 1122, "verse_number": "१-१२३-२०", "content_sanskrit": "अच्छद्मनाऽमायया च मृगाणां वध इष्यते।\nस एव धर्मो राज्ञां तु तद्धि त्वं किं नु गर्हसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2006171, "chapter_id": 1122, "verse_number": "१-१२३-२१", "content_sanskrit": "अगस्त्यः सत्रमासीनश्चकार मृगयामृषिः।\nआरण्यान्सर्वदैवत्यान्मृगान्प्रोक्ष्य महावने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2006172, "chapter_id": 1122, "verse_number": "१-१२३-२२", "content_sanskrit": "प्रमाणदृष्टधर्मेण कथमस्मान्विगर्हसे।\nअगस्त्यस्याभिचारेण युष्माकं विहितो वधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2006173, "chapter_id": 1122, "verse_number": "१-१२३-२३", "content_sanskrit": "न रिपून्वै समुद्दिश्य विमुञ्चन्ति नराः शरान्।\nरन्ध्र एषां विशेषेण वधकालः प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2006174, "chapter_id": 1122, "verse_number": "१-१२३-२४", "content_sanskrit": "प्रमत्तमप्रमत्तं वा विवृतं घ्नन्ति चौजसा।\nउपायैर्विविधैस्तीक्ष्णैः कस्मान्मृग विगर्हसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2006175, "chapter_id": 1122, "verse_number": "१-१२३-२५x", "content_sanskrit": "मृग उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2006176, "chapter_id": 1122, "verse_number": "१-१२३-२५", "content_sanskrit": "नाहं घ्न्तं मृगन्राजन्विगर्हे चात्मकारणात्।\nमैथुनं तु प्रतीक्ष्यं मे त्वयेहाद्यानृशंस्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2006177, "chapter_id": 1122, "verse_number": "१-१२३-२६", "content_sanskrit": "सर्वभूतहिते काले सर्वभूतेप्सिते तथा।\nको हि विद्वान्मृगं हन्याच्चरन्तं मैथुनं वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2006178, "chapter_id": 1122, "verse_number": "१-१२३-२७", "content_sanskrit": "अस्यां मृग्यां च राजेन्द्र हर्षान्मैथुनमाचरम्।\nपुरुषार्थफलं कर्तुं तत्त्वया विफलीकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2006179, "chapter_id": 1122, "verse_number": "१-१२३-२८", "content_sanskrit": "पौरवाणां महाराज तेषामक्लिष्टकर्मणाम्।\nवंशे जातस्य कौरव्य नानुरूपमिदं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2006180, "chapter_id": 1122, "verse_number": "१-१२३-२९", "content_sanskrit": "नृशंसं कर्म सुमहत्सर्वलोकविगर्हितम्।\nअस्वर्ग्यमयशस्यं चाप्यधर्मिष्ठं च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2006181, "chapter_id": 1122, "verse_number": "१-१२३-३०", "content_sanskrit": "स्त्रीभोगानां विशेषज्ञः शास्त्रधर्मार्थतत्त्ववित्।\nनार्हस्त्वं सुरसङ्काश कर्तुमस्वर्ग्यमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2006182, "chapter_id": 1122, "verse_number": "१-१२३-३१", "content_sanskrit": "त्वया नृशंसकर्तारः पापाचाराश्च मानवाः।\nनिग्राह्याः पार्थिवश्रेष्ठ त्रिवर्गपरिवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2006183, "chapter_id": 1122, "verse_number": "१-१२३-३२", "content_sanskrit": "किं कृतं ते नरश्रेष्ठ मामिहानागसं घ्नतः।\nमुनिं मूलफलाहारं मृगवेषधरं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2006184, "chapter_id": 1122, "verse_number": "१-१२३-३३", "content_sanskrit": "वसमानमरण्येषु नित्यं शमपरायणम्।\nत्वयाऽहं हिंसितो यस्मात्तस्मात्त्वामप्यनागसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2006185, "chapter_id": 1122, "verse_number": "१-१२३-३४", "content_sanskrit": "द्वयोर्नृशंसकर्तारमवशं काममोहितम्।\nजीवितान्तकरो भावो मैथुने समुपैष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2006186, "chapter_id": 1122, "verse_number": "१-१२३-३५", "content_sanskrit": "अहं हि किंदमो नाम तपसा भावितो मुनिः।\nव्यपत्रपन्मनुष्याणां मृग्यां मैथुनमाचरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2006187, "chapter_id": 1122, "verse_number": "१-१२३-३६", "content_sanskrit": "मृगो भत्वा मृगैः सार्धं चरामि गहने वने।\nन तु ते ब्रह्महत्येयं भविष्यत्यविजानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2006188, "chapter_id": 1122, "verse_number": "१-१२३-३७", "content_sanskrit": "मृगरूपधरं हत्वा मामेवं काममोहितम्।\nअस्य तु त्वं फलं मूढ प्राप्स्यसीदृशमेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2006189, "chapter_id": 1122, "verse_number": "१-१२३-३८", "content_sanskrit": "प्रियया सह संवासं प्राप्य कामविमोहितः।\nत्वमप्यस्यामवस्थायां प्रेतलोकं गमिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2006190, "chapter_id": 1122, "verse_number": "१-१२३-३९", "content_sanskrit": "अन्तकाले हि संवासं यया गन्तासि कान्तया।\nप्रेतराजपुरं प्राप्तं सर्वभूतदुरत्ययम्।\nभक्त्या मतिमतां श्रेष्ठ सैव त्वाऽनुगमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2006191, "chapter_id": 1122, "verse_number": "१-१२३-४०", "content_sanskrit": "वर्तमानः सुखे दुःखं यथाऽहं प्रापितस्त्वया।\nतथा त्वां च सुखं प्राप्तं दुःखमभ्यागमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2006192, "chapter_id": 1122, "verse_number": "१-१२३-४१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2006193, "chapter_id": 1122, "verse_number": "१-१२३-४१", "content_sanskrit": "एवमुक्त्वा सुदुःखार्तो जीवितात्स व्यमुच्यत।\nमृगः पाण्डुश्च दुःखार्तः क्षणेन समपद्यत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2006194, "chapter_id": 1122, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि त्रयोविंशत्यधिकशततमोऽध्यायः॥ १२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]