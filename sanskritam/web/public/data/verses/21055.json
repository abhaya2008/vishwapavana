[{"id": 7001055000, "chapter_id": 21055, "verse_number": "५-३७-१", "content_sanskrit": "श्रीपराशर उवाच।\nएवं दैत्यवधं कृष्णो बलदेव सहायवान् ।\nचक्रे दुष्टक्षितीशानां तथैव जगतः कृते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001055001, "chapter_id": 21055, "verse_number": "५-३७-२", "content_sanskrit": "क्षितेश्च भारं भगवान्फाल्गुनेन समन्वितः ।\nआवतारयामास विभुस्समस्ताक्षोहिणी वधात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001055002, "chapter_id": 21055, "verse_number": "५-३७-३", "content_sanskrit": "कृत्वा भारावतरणं भुवो हत्वाऽखिलान्नृपान् ।\nशापव्याजेन विप्राणामुपसंहृतवान्कुलम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001055003, "chapter_id": 21055, "verse_number": "५-३७-४", "content_sanskrit": "उत्सृज्य द्वारकां कृष्णस्त्यक्त्वा मानुष्यमात्मनः ।\nसांशो विष्णुमयं स्थानं प्रविवेश मुने निजम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001055004, "chapter_id": 21055, "verse_number": "५-३७-५", "content_sanskrit": "मैत्रेय उवाच।\nस विप्रशापव्याजेन संजह्रे स्वकुलं कथम् ।\nकथं च मानुषं देहमुत्ससर्ज जनार्दनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001055005, "chapter_id": 21055, "verse_number": "५-३७-६", "content_sanskrit": "श्रीपराशर उवाच।\nविश्वामित्रस्तथा कण्वो नारदश्च महामुनिः ।\nपिंडारके महातीर्थे दृष्ट्वा यदुकुमारकैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001055006, "chapter_id": 21055, "verse_number": "५-३७-७", "content_sanskrit": "ततस्ते यौवनोन्मत्ता भाविकार्यप्रचोदिताः ।\nसांबं जांबवतीपुत्रं भूषयित्वा स्त्रियं यथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001055007, "chapter_id": 21055, "verse_number": "५-३७-८", "content_sanskrit": "प्रश्रितास्तान्मुनीनूचुः प्रणिपातपुरस्सरम् ।\nइयं स्त्री पुत्रकामा वै ब्रूत किं जनयिष्यति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001055008, "chapter_id": 21055, "verse_number": "५-३७-९", "content_sanskrit": "श्रीपराशर उवाच।\nदिव्यज्ञानोपपन्नास्ते विप्रलब्धाः कुमारकैः ।\nमुनयः कुपिताः प्रोचुर्मुसलं जनयिष्यति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001055009, "chapter_id": 21055, "verse_number": "५-३७-१०", "content_sanskrit": "सर्वयादवसंहारकारणं भुवनोत्तरम् ।\nयेनाखिलकुलोत्सादो यादवानां भविष्यति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001055010, "chapter_id": 21055, "verse_number": "५-३७-११", "content_sanskrit": "इत्युक्तास्ते कुमारास्तु आचचक्षुर्यथातथम् ।\nउग्रसेनाय मुसलं जज्ञे सांबस्य चोदरात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001055011, "chapter_id": 21055, "verse_number": "५-३७-१२", "content_sanskrit": "तदुग्रसेनो मुसलमयश्चूर्णमकारयत् ।\nजज्ञे तदेरकाचूर्णं प्रक्षिप्तं तैर्महोदधौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001055012, "chapter_id": 21055, "verse_number": "५-३७-१३", "content_sanskrit": "मुसलस्याथ लोहस्य चूर्णितस्य तु यादवैः ।\nखंडं चूर्णितशेषं तु ततो यत्तोमराकृति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001055013, "chapter_id": 21055, "verse_number": "५-३७-१४", "content_sanskrit": "तदप्यंबुनिधौ क्षिप्तं मत्स्यो जग्राह जालिभिः ।\nघातितस्योदरात्तस्य लुब्धो जग्राह तज्जराः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001055014, "chapter_id": 21055, "verse_number": "५-३७-१५", "content_sanskrit": "विज्ञातपरमार्थोपि भगवान्मधुसूदनः ।\nनैच्छत्तदन्यथा कर्त्तुं विधिना यत्समीहितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001055015, "chapter_id": 21055, "verse_number": "५-३७-१६", "content_sanskrit": "देवैश्च प्रहितो वायुः प्रणिपत्त्याह केशवम् ।\nरहस्येवमहं दूतः प्रहितो भगवन्सुरैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001055016, "chapter_id": 21055, "verse_number": "५-३७-१७", "content_sanskrit": "वस्वश्विमरुदादित्यरुद्र साध्यादिभिस्सह ।\nविज्ञापयति शक्रस्त्वां तदिदं श्रूयतां विभो ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001055017, "chapter_id": 21055, "verse_number": "५-३७-१८", "content_sanskrit": "भारावतरणार्थाय वर्षाणामधिकं शतम् ।\nभगवानवतीर्णोत्र त्रिदशैस्सह चोदितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001055018, "chapter_id": 21055, "verse_number": "५-३७-१९", "content_sanskrit": "दुर्वृत्ता निहता दैत्या भुवो भारोऽवतारितः ।\nत्वया मनाथास्त्रिदशा भवंतु त्रिदिवे सदा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001055019, "chapter_id": 21055, "verse_number": "५-३७-२०", "content_sanskrit": "तदतीतं जगन्नाथ वर्षाणामधिकं शतम् ।\nइदानीं गम्यतां स्वर्गो भवता यदि रोचते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001055020, "chapter_id": 21055, "verse_number": "५-३७-२१", "content_sanskrit": "देवैर्विज्ञाप्यते देव तथात्रैव रतिस्तव ।\nतत्स्थीयतां यथाकालमास्थेयमनुजीविभिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001055021, "chapter_id": 21055, "verse_number": "५-३७-२२", "content_sanskrit": "श्रीभगवानुवाच।\nयत्त्वमात्थाखिलं दूत वेद्म्येतदहमप्युत ।\nप्रारब्ध एव हि मया यादवानां परिक्षयः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001055022, "chapter_id": 21055, "verse_number": "५-३७-२३", "content_sanskrit": "भुवो नाद्यापि भारोऽयं यादवैरनिबर्हितैः ।\nअवतार्य करोम्येतत्सप्तरात्रेण सत्वरः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001055023, "chapter_id": 21055, "verse_number": "५-३७-२४", "content_sanskrit": "यथा गृहीतमंभोधेर्दत्त्वाहं द्वारकाभुवम् ।\nयादवानुपसंहृत्य यास्यामि त्रिदशालयम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001055024, "chapter_id": 21055, "verse_number": "५-३७-२५", "content_sanskrit": "मनुष्यदेहमुत्सृज्य संकर्षणसहायवान् ।\nप्राप्त एवास्मि मंतव्यो देवेंद्रे ण तथाऽमरैः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001055025, "chapter_id": 21055, "verse_number": "५-३७-२६", "content_sanskrit": "जरासंधादयो येऽन्ये निहता भारहेतवः ।\nक्षितेस्तेभ्यःकुमारोऽपि यदूनां नापचीयते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001055026, "chapter_id": 21055, "verse_number": "५-३७-२७", "content_sanskrit": "तदेतं सुमहाभारमवतार्य क्षितेरहम् ।\nयास्याम्यमरलोकस्य पालनाय ब्रवीहि तान् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001055027, "chapter_id": 21055, "verse_number": "५-३७-२८", "content_sanskrit": "श्रीपराशर उवाच।\nइत्युक्तो वासुदेवेन देवदूतः प्रणम्य तम् ।\nमैत्रेय दिव्यया गत्या देवराजांतिकं ययौ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001055028, "chapter_id": 21055, "verse_number": "५-३७-२९", "content_sanskrit": "भगवानप्यथोत्पातान्दिव्यभौमांतरिक्षजान् ।\nददर्श द्वारकापुर्य्यां विनाशाय दिवानिशम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001055029, "chapter_id": 21055, "verse_number": "५-३७-३०", "content_sanskrit": "तान्दृष्ट्वा यादवानाह पश्यध्वमतिदारुणान् ।\nमहोत्पाताञ्छमायैषां प्रभासं याम मा चिरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001055030, "chapter_id": 21055, "verse_number": "५-३७-३१", "content_sanskrit": "श्रीपराशर उवाच।\nएवमुक्ते तु कृष्णेन यादवप्रवरस्ततः ।\nमहाभागवतः प्राह प्रणिपत्योद्धवो हरिम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001055031, "chapter_id": 21055, "verse_number": "५-३७-३२", "content_sanskrit": "भगवन्यन्मया कार्यं तदाज्ञापय सांप्रतम् ।\nमन्ये कुलमिदं सर्वं भगवान्संहरिष्यति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001055032, "chapter_id": 21055, "verse_number": "५-३७-३३", "content_sanskrit": "नाशायास्य निमित्तानि कुलस्याच्युत लक्षये ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001055033, "chapter_id": 21055, "verse_number": "५-३७-३४", "content_sanskrit": "श्रीभगवानुवाच।\nगच्छ त्वं दिव्यया गत्या मत्प्रसादसमुत्थया ।\nयद्बदर्याश्रमं पुण्यं गंधमादनपर्वते ।\nनरनारायणस्थाने तत्पवित्रं महीतले ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001055034, "chapter_id": 21055, "verse_number": "५-३७-३५", "content_sanskrit": "मन्मना मत्प्रसादेन तत्र सिद्धिमवाप्स्यसि ।\nअहं स्वर्गं गमिष्यामि ह्युपसंहृत्य वै कुलम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001055035, "chapter_id": 21055, "verse_number": "५-३७-३६", "content_sanskrit": "द्वारकां च मया त्यक्तां समुद्र ः! प्लावयिष्यति ।\nमद्वेश्म चैकं मुक्त्वा तु भयान्मत्तो जलाशये ।\nतत्र सन्निहितश्चाहं भक्तानां हितकाम्यया ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001055036, "chapter_id": 21055, "verse_number": "५-३७-३७", "content_sanskrit": "श्रीपराशर उवाच।\nइत्युक्तः प्रणिपत्यैनं जगामाशु तपोवनम् ।\nनरनारायणस्थानं केशवेनानुमोदितः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001055037, "chapter_id": 21055, "verse_number": "५-३७-३८", "content_sanskrit": "ततस्ते यादवास्सर्वे रथानारुह्य शीघ्रगान् ।\nप्रभासं प्रययुस्सार्द्धं कृष्णरामादिभिर्द्विज ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001055038, "chapter_id": 21055, "verse_number": "५-३७-३९", "content_sanskrit": "प्रभासं समनुप्राप्ताः कुकुरांधकवृष्णयः ।\nचक्रुस्तत्र महापानं वासुदेवेन चोदिताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001055039, "chapter_id": 21055, "verse_number": "५-३७-४०", "content_sanskrit": "पिबतां तत्र चैतेषां संघर्षेण परस्परम् ।\nअतिवादेंधनो जज्ञे कलहाग्निः क्षयावहः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001055040, "chapter_id": 21055, "verse_number": "५-३७-४१", "content_sanskrit": "मैत्रेय उवाच।\nस्वंस्वं वै भुंजतां तेषां कलहः किंनिमित्तकः ।\nसंघर्षो वा द्विजश्रेष्ठ तन्ममाख्यातुमर्हसि ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001055041, "chapter_id": 21055, "verse_number": "५-३७-४२", "content_sanskrit": "श्रीपराशर उवाच।\nमृष्टं मदीयमन्नं ते न मृष्टमिति जल्पताम् ।\nमृष्टामृष्टकथा जज्ञे संघर्षकलहौ ततः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001055042, "chapter_id": 21055, "verse_number": "५-३७-४३", "content_sanskrit": "ततश्चान्योन्यमभ्येत्य क्रोधसंरक्तलोचनाः ।\nजघ्नुः परस्परं ते तु शस्त्रैर्दैवबलात्कृताः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001055043, "chapter_id": 21055, "verse_number": "५-३७-४४", "content_sanskrit": "क्षीणशस्त्राश्च जगृहुः प्रत्यासन्नामथैरकाम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001055044, "chapter_id": 21055, "verse_number": "५-३७-४५", "content_sanskrit": "एरका तु गृहीता वै वज्रभूतेव लक्ष्यते ।\nतया परस्परं जघ्नुस्संप्रहारे सुदारुणे ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001055045, "chapter_id": 21055, "verse_number": "५-३७-४६", "content_sanskrit": "प्रद्युम्नसांबप्रमुखाः कृतवर्माथ सात्यकिः ।\nअनिरुद्धादयश्चान्ये पृथुर्विपृथुरेव च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001055046, "chapter_id": 21055, "verse_number": "५-३७-४७", "content_sanskrit": "चारुवर्मा चारुकश्च तथाक्रूरादयो द्विज ।\nएरकारूपिभिर्वज्रैस्ते निजघ्नुः परस्परम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001055047, "chapter_id": 21055, "verse_number": "५-३७-४८", "content_sanskrit": "निवारयामास हरिर्यादवांस्ते च केशवम् ।\nसहायं मेनिरेरीणां प्राप्तं जघ्नुः परस्परम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001055048, "chapter_id": 21055, "verse_number": "५-३७-४९", "content_sanskrit": "कृष्णोऽपि कुपितस्तेषामेरकामुष्टिमाददे ।\nवधाय सोपि मुसलं मुष्टर्लौहमभूत्तदा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001055049, "chapter_id": 21055, "verse_number": "५-३७-५०", "content_sanskrit": "जघान तेन निश्श्षोआ!न्यादवानाततायिनः ।\nजघ्नुस्ते सहसाभ्येत्य तथाऽन्येपि परस्परम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001055050, "chapter_id": 21055, "verse_number": "५-३७-५१", "content_sanskrit": "ततश्चार्णवमध्येन जैत्रोऽसौ चक्रिणो रथः ।\nपश्यतो दारुकस्याथ प्रायादश्वैर्धृतो द्विज ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001055051, "chapter_id": 21055, "verse_number": "५-३७-५२", "content_sanskrit": "चक्रं गदा तथा शार्ङ्गं तूणीशंखोसिरेव च ।\nप्रदक्षिणं हरिं कृत्वा जग्मुरादित्यवर्त्त्मना ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001055052, "chapter_id": 21055, "verse_number": "५-३७-५३", "content_sanskrit": "क्षणेन नाभवत्कश्चिद्यादवानामघातितः ।\nऋते कृष्णं महात्मानं दारुकं च महामुने ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001055053, "chapter_id": 21055, "verse_number": "५-३७-५४", "content_sanskrit": "चंक्रम्यमाणौ तौ रामं वृक्षमूले कृतासनम् ।\nददृशाते मुखाच्चास्य निष्क्रामंतं महोरगम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001055054, "chapter_id": 21055, "verse_number": "५-३७-५५", "content_sanskrit": "निष्क्रम्य स मखात्तस्य महाभोगो भुजंगमः ।\nप्रययावर्णवं सिद्धैः पूज्यमानस्तथोरगैः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001055055, "chapter_id": 21055, "verse_number": "५-३७-५६", "content_sanskrit": "ततोर्घ्यमादाय तदा जलधिस्संमुखं ययौ ।\nप्रविवेश ततस्तोयं पूजितः पन्नगोत्तमैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001055056, "chapter_id": 21055, "verse_number": "५-३७-५७", "content_sanskrit": "दृष्ट्वा बलस्य निर्याणं दारुकं प्राह केशवः ।\nइदं सर्वं समाचक्ष्व वसुदेवोग्रसेनयोः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001055057, "chapter_id": 21055, "verse_number": "५-३७-५८", "content_sanskrit": "निर्याणं बलभद्र स्य यादवानां तथा क्षयम् ।\nयोगे स्थित्वाहमप्येतत्परित्यक्ष्ये कलेवरम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001055058, "chapter_id": 21055, "verse_number": "५-३७-५९", "content_sanskrit": "वाच्यश्च द्वारकावासी जनस्सर्वस्तथाहुकः ।\nयथेमां नगरीं सर्वां समुद्र ः! प्लावयिष्यति ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001055059, "chapter_id": 21055, "verse_number": "५-३७-६०", "content_sanskrit": "तस्माद्भवद्भिस्सर्वैस्तु प्रतीक्ष्यो ह्यर्जुनागमः ।\nन स्थेयं द्वारकामध्ये निष्क्रांते तत्र पांडवे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001055060, "chapter_id": 21055, "verse_number": "५-३७-६१", "content_sanskrit": "तेनैव सह गंतव्यं यत्र याति स कौरवः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001055061, "chapter_id": 21055, "verse_number": "५-३७-६२", "content_sanskrit": "गत्वा च ब्रूहि कौंतेयमर्जुनं वचनान्मम ।\nपालनीयस्त्वया शक्त्या जनोऽयं मत्परिग्रहः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001055062, "chapter_id": 21055, "verse_number": "५-३७-६३", "content_sanskrit": "त्वमर्जुनेन सहितो द्वारवत्यां तथा जनम् ।\nगृहीत्वा यादि वज्रश्च यदुराजो भविष्यति ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001055063, "chapter_id": 21055, "verse_number": "५-३७-६४", "content_sanskrit": "श्रीपराशर उवाच।\nइत्युक्तो दारुकः कृष्णं प्रणिपत्य पुनःपुनः ।\nप्रदक्षिणं च बहुशः कृत्वा प्रायाद्यथोदितम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001055064, "chapter_id": 21055, "verse_number": "५-३७-६५", "content_sanskrit": "स च गत्वा तदाचष्ट द्वारकायां तथाऽर्जुनम् ।\nआनिनाय महाबुद्धिर्वज्रं चक्रे तथा नृपम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001055065, "chapter_id": 21055, "verse_number": "५-३७-६६", "content_sanskrit": "भगवानपि गोविंदो वासुदेवात्मकं परम् ।\nब्रह्मात्मनि समारोप्य सर्वभूतेष्वधारयत् ।\nनिष्प्रपंचे महाभाग संयोज्यात्मानमात्मनि ।\nतुर्यावस्थसलीलं च श्तोए!स्म पुरुषोत्तमः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001055066, "chapter_id": 21055, "verse_number": "५-३७-६७", "content_sanskrit": "संमानयन्द्विजवचो दुर्वासा यदुवाच ह ।\nयोगयुक्तोऽभवत्पादं कृत्वा जानुनि सत्तम ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001055067, "chapter_id": 21055, "verse_number": "५-३७-६८", "content_sanskrit": "आययौ स जरानाम तदा तत्र स लुब्धकः ।\nमुसलावशेषलोहैकसायकन्यस्ततोमरः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001055068, "chapter_id": 21055, "verse_number": "५-३७-६९", "content_sanskrit": "स तत्पादं मृगाकारमवेक्ष्यारादवस्थितः ।\nतले विव्याध तेनैव तोमरेण द्विजोत्तम ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001055069, "chapter_id": 21055, "verse_number": "५-३७-७०", "content_sanskrit": "ततश्च ददृशो! तत्र चदुर्बाहुधरं नरम् ।\nप्रणिपत्त्याह चैवैनं प्रसीदेति पुनःपुनः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001055070, "chapter_id": 21055, "verse_number": "५-३७-७१", "content_sanskrit": "अजानता कृतमिदं मया हरिणशंकया ।\nक्षम्यतां मम पापेन दग्धं मां त्रातुमर्हसि ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001055071, "chapter_id": 21055, "verse_number": "५-३७-७२", "content_sanskrit": "श्रीपराशर उवाच।\nततस्तं भगवानाह न तेस्तु भयमण्वपि ।\nगच्छ त्वं मत्प्रसादेन लुब्ध स्वर्गं सुरास्पदम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001055072, "chapter_id": 21055, "verse_number": "५-३७-७३", "content_sanskrit": "श्रीपराशर उवाच।\nविमानमागतं सद्यस्तद्वाक्यसमनंतरम् ।\nआरुह्य प्रययौ स्वर्गं लुब्धकस्तत्प्रसादतः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001055073, "chapter_id": 21055, "verse_number": "५-३७-७४", "content_sanskrit": "गते तस्मिन्सभगवान्संयोज्यात्मानमात्मनि ।\nब्रह्मभूतेऽव्ययेचिंत्ये वासुदेवमयेऽमले ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001055074, "chapter_id": 21055, "verse_number": "५-३७-७५", "content_sanskrit": "अजन्मन्यमरे विष्णावप्रमेयेऽखिलात्मनि ।\nतत्याज मानुषं देहमतीत्य त्रिविधां गतिम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]