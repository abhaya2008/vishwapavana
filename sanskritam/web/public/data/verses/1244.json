[{"id": 2011927, "chapter_id": 1244, "verse_number": "१-२४५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011928, "chapter_id": 1244, "verse_number": "१-२४५-१", "content_sanskrit": "उक्तवन्तो यथावीर्यमसकृत्सर्ववृष्णयः।\nततोऽब्रवीद्वासुदेवो वाक्यं धर्मार्थसंयुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011929, "chapter_id": 1244, "verse_number": "१-२४५-२", "content_sanskrit": "मयोक्तं न श्रुतं पूर्वं सहितैः सर्वयादवैः।\nअतिक्रान्तमतिक्रान्तं न निवर्तेत कर्हिचित्।\nशृणुध्वं सहिताः सर्वे मम वाक्यं सहेतुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011930, "chapter_id": 1244, "verse_number": "१-२४५-३", "content_sanskrit": "नावमानं कुलस्यास्य गुडाकेशः प्रयुक्तवान्।\nसंमानोऽभ्यधिकस्तेन प्रयुक्तोऽयं न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011931, "chapter_id": 1244, "verse_number": "१-२४५-४", "content_sanskrit": "अर्थलुब्धान्न वः पार्थो मन्यते सात्वतान्सदा।\nस्वयंवरमनाधृष्यं मन्यते चापि पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011932, "chapter_id": 1244, "verse_number": "१-२४५-५", "content_sanskrit": "प्रदानमपि कन्यायाः पशुवत्को नु मन्यते।\nविक्रयं चाप्यपत्यस्य कः कुर्यात्पुरुषो भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011933, "chapter_id": 1244, "verse_number": "१-२४५-६", "content_sanskrit": "एतान्दोषांस्तु कौन्तेयो दृष्टवानिति मे मतिः।\nक्षत्रियाणां तु वीर्येण प्रशस्तं हरणं बलात्।\nअतः प्रसह्य हृतवान्कन्यां धर्मेण पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011934, "chapter_id": 1244, "verse_number": "१-२४५-७", "content_sanskrit": "उचितश्चैव संबन्धः सुभद्रा च शयस्विनी।\nएष चापीदृशः पार्थः प्रसह्य हृतवानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011935, "chapter_id": 1244, "verse_number": "१-२४५-८", "content_sanskrit": "भरतस्यान्वये जातं शान्तनोश्च यशस्विनः।\nकुन्तिभोजात्माजापुत्रं का बुभूषेत नार्जुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011936, "chapter_id": 1244, "verse_number": "१-२४५-९", "content_sanskrit": "न तं पश्यामि यः पार्थं विजयेत रणे बलात्।\nवर्जयित्वा विरूपाक्षं भगनेत्रहरं हरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011937, "chapter_id": 1244, "verse_number": "१-२४५-१०", "content_sanskrit": "अपि सर्वेषु लोकेषु सेन्द्ररुद्रेषु मारिष।\nस च नाम रथस्तादृङ्मदीयास्ते च वाजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011938, "chapter_id": 1244, "verse_number": "१-२४५-११", "content_sanskrit": "मम शस्त्रं विशेषेण तूणौ चाक्षयसायकौ।\nयोद्धा पार्थश्च शीघ्रास्त्रः को नु तेन समो भवेत्।\nतमभिद्रुत्य सान्त्वेन परमेण धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011939, "chapter_id": 1244, "verse_number": "१-२४५-१२", "content_sanskrit": "निवर्तयत संहृष्टा ममैषा परमा मतिः।\nयदि निर्जित्य वः पार्थो बलाद्गच्छेत्स्वकं पुरं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011940, "chapter_id": 1244, "verse_number": "१-२४५-१३", "content_sanskrit": "प्रणश्येद्वो यशः सद्यो न तु सान्त्वे पराजयः।\nपितृष्वसायाः पुत्रो मे संबन्धं नार्हति द्विषाम्।\nतच्छ्रुत्वा वासुदेवस्य तथा कर्तुं जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011941, "chapter_id": 1244, "verse_number": "१-२४५-१४", "content_sanskrit": "उद्योगं कृतवन्तस्ते भेरीं सन्नाद्य यादवाः।\nअर्जुनस्तु तदा श्रुत्वा भेरीसन्नादनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011942, "chapter_id": 1244, "verse_number": "१-२४५-१५", "content_sanskrit": "कौन्तेयस्त्वरमाणस्तु सुभद्रामभ्यभाषत।\nआयान्ति वृष्णयः सर्वे ससुहृज्जनबान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011943, "chapter_id": 1244, "verse_number": "१-२४५-१६", "content_sanskrit": "त्वदर्थं योद्धुकामास्ते मदरक्तान्तलोचनाः।\nप्रमत्तानशुचीन्मूढान्सुरामत्तान्नराधमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011944, "chapter_id": 1244, "verse_number": "१-२४५-१७", "content_sanskrit": "वमनं पानशीलांस्तान्करिष्यामि शरोत्तमैः।\nउताहो वा मदोन्मत्तान्नयिष्यामि यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011945, "chapter_id": 1244, "verse_number": "१-२४५-१८", "content_sanskrit": "एवमुक्त्वा प्रियां पार्थो न्यवर्तत महाबलः।\nनिवर्तमानं दृष्ट्वैव सुभद्रा त्रस्ततां गता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011946, "chapter_id": 1244, "verse_number": "१-२४५-१९", "content_sanskrit": "एवं मा वद पार्थेति पादयोः पतिता तदा।\nसुभद्रा तु कलिर्जाता वृष्णीनां निधाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011947, "chapter_id": 1244, "verse_number": "१-२४५-२०", "content_sanskrit": "एवं ब्रुवन्तः पौरास्ते ह्यपवादरताः प्रभो।\nमम शोकं वर्धयन्ति तस्मान्नाशं न चिन्तये।\nपरिवादभयान्मुक्ता त्वत्प्रसादाद्भवाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011948, "chapter_id": 1244, "verse_number": "१-२४५-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011949, "chapter_id": 1244, "verse_number": "१-२४५-२१", "content_sanskrit": "एवमुक्तस्ततः पार्थः प्रियया भद्रया तदा।\nगमनाय मतिं चक्रे पार्थः सत्यपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011950, "chapter_id": 1244, "verse_number": "१-२४५-२२", "content_sanskrit": "स्तितपूर्वं तदाऽऽभाष्य परिष्वज्य प्रियां तदा।\nउत्थाप्य च पुनः पार्थो याहि याहीति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011951, "chapter_id": 1244, "verse_number": "१-२४५-२३", "content_sanskrit": "ततः सुभद्रा त्वरिता रश्मीन्संगृह्य पाणिना।\nचोदयामास जवनाञ्शीग्रमश्वान्कृतत्वरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011952, "chapter_id": 1244, "verse_number": "१-२४५-२४", "content_sanskrit": "ततस्तु कृतसन्नाहा वृष्णिवीराः समाहिताः।\nप्रत्यानयार्थं पार्थस्य जवनैस्तुरगोत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011953, "chapter_id": 1244, "verse_number": "१-२४५-२५", "content_sanskrit": "राजमार्गमनुप्राप्ता दृष्ट्वा पार्थस्य विक्रमम्।\nप्रासादपङ्क्तिस्तम्भेषु वेदिकासु ध्वजेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011954, "chapter_id": 1244, "verse_number": "१-२४५-२६", "content_sanskrit": "अर्जुनस्य शरान्दृष्ट्वा विस्मयं परमं गताः।\nकेशवस्य वचस्तथ्यं मन्यमानास्तु यादवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011955, "chapter_id": 1244, "verse_number": "१-२४५-२७", "content_sanskrit": "अतीत्य तं रैवतकं श्रुत्वा तु विपृथोर्वचः।\nअर्जुनेन कृतं श्रुत्वा गन्तुकामास्तु वृष्णयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011956, "chapter_id": 1244, "verse_number": "१-२४५-२८", "content_sanskrit": "श्रुत्वा दीर्घं गतं पार्थं न्यवर्तन्त महारथाः।\nपुरोद्यानमतिक्रम्य विशालं च गिरिव्रजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011957, "chapter_id": 1244, "verse_number": "१-२४५-२९", "content_sanskrit": "सानुमुज्जयिनीं चैव वनान्युपवनानि च।\nपुण्येष्वानर्तराष्ट्रेषु वापीपद्मसरांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011958, "chapter_id": 1244, "verse_number": "१-२४५-३०", "content_sanskrit": "प्राप्य धेनुमतीतीर्थमश्वरोधसरः प्रति।\nप्रेक्षावर्तं ततः शैलमम्बुदं च नगोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011959, "chapter_id": 1244, "verse_number": "१-२४५-३१", "content_sanskrit": "आराच्छृङ्गमथासाद्य तीर्णः करवतीं नदीम्।\nप्राप्य साल्वेयराष्ट्राणि निषधानप्यतीत्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2011960, "chapter_id": 1244, "verse_number": "१-२४५-३२", "content_sanskrit": "देवापृथुपुरं पश्यन् सर्वतः सुसमाहितः।\nतमतीत्य महाबाहुर्देवारण्यमपश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2011961, "chapter_id": 1244, "verse_number": "१-२४५-३३", "content_sanskrit": "पूजयामासुरायान्तं देवारण्ये महर्षयः।\nस वनानि नदीः शैलान् गिरिप्रस्रवणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2011962, "chapter_id": 1244, "verse_number": "१-२४५-३४", "content_sanskrit": "अतीत्य च तदा पार्थः सुभद्रासारथिस्तदा।\nकौरवं विषयं प्राप्य विशोकः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2011963, "chapter_id": 1244, "verse_number": "१-२४५-३५", "content_sanskrit": "सोदर्याणां महाबाहुः सिंहाशयमिवाशयम्।\nदूरादुपवनोपेतं समन्तात्सलिलावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2011964, "chapter_id": 1244, "verse_number": "१-२४५-३६", "content_sanskrit": "भद्रया मुदितो जिष्णुर्ददर्श वृजिनं पुरम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2011965, "chapter_id": 1244, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि हरणाहरणपर्वणि पञ्चत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]