[{"id": 2050587, "chapter_id": 2108, "verse_number": "७-३५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2050588, "chapter_id": 2108, "verse_number": "७-३५-१", "content_sanskrit": "तदनीकमनाधृष्टं भारद्वाजेन रक्षितम्।\nपार्थाः समभ्यवर्तन्त भीमसेनपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2050589, "chapter_id": 2108, "verse_number": "७-३५-२", "content_sanskrit": "सात्यकिश्चेकितानश्च धृष्टद्युम्नश्च पार्षतः।\nकुन्तिभोजश्च विक्रान्तो द्रुपदश्च महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2050590, "chapter_id": 2108, "verse_number": "७-३५-३", "content_sanskrit": "आर्जुनिः क्षत्रधर्मा च बृहत्क्षत्रश्च वीर्यवान्।\nचेदिपो धृष्टकेतुश्च माद्रीपुत्रौ घटोत्कचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2050591, "chapter_id": 2108, "verse_number": "७-३५-४", "content_sanskrit": "युधामन्युश्च विक्रान्तः शिखण्डी चापराजितः।\nउतक्तमौजाश्च दुर्धर्षो विराटश्च महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2050592, "chapter_id": 2108, "verse_number": "७-३५-५", "content_sanskrit": "द्रौपदेयाश्च संरब्धाः शैशुपालिश्च वीर्यवान्।\nकेकयाश्च महावीर्याः सृञ्जयाश्च सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2050593, "chapter_id": 2108, "verse_number": "७-३५-६", "content_sanskrit": "एते चान्ये च सगणाः कृतास्त्रा युद्धदुर्मदाः।\nसमभ्यधावन्सहसा भारद्वाजं युयुत्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2050594, "chapter_id": 2108, "verse_number": "७-३५-७", "content_sanskrit": "समीपे वर्तमानांस्तान्भारद्वाजोऽतिवीर्यवान्।\nअसम्भ्रान्तः शरौघेण महता समवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2050595, "chapter_id": 2108, "verse_number": "७-३५-८", "content_sanskrit": "महौघः सलिलस्येव गिरिमासाद्य दुर्भिदम्।\nद्रोणं ते नाभ्यवर्तन्त वेलामिव जलाशयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2050596, "chapter_id": 2108, "verse_number": "७-३५-९", "content_sanskrit": "पीड्यमानाः शरै राजन्द्रोणचापविनिःसृतैः।\nन शेकुः प्रमुखे स्थातुं भारद्वाजस्य पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2050597, "chapter_id": 2108, "verse_number": "७-३५-१०", "content_sanskrit": "तदद्भुतमपश्याम द्रोणस्य भुजयोर्बलम्।\nयदेनं नाभ्यवर्तन्त पाञ्चालाः सृञ्जयैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2050598, "chapter_id": 2108, "verse_number": "७-३५-११", "content_sanskrit": "तमायान्तमभिक्रुद्धं द्रोणं दृष्ट्वा युधिष्ठिरः।\nबहुधा चिन्तयामास द्रोणस्य प्रतिवारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2050599, "chapter_id": 2108, "verse_number": "७-३५-१२", "content_sanskrit": "अशक्यं तु तमन्येन द्रोणं मत्त्वा युधिष्ठिरः।\nअविषह्यं गुर भारं सौभद्रे समवासृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2050600, "chapter_id": 2108, "verse_number": "७-३५-१३", "content_sanskrit": "वासुदेवादनवरं फल्गुनाच्चामितौजसम्।\nअब्रवीत्परवीरघ्नमभिमन्युमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2050601, "chapter_id": 2108, "verse_number": "७-३५-१४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2050602, "chapter_id": 2108, "verse_number": "७-३५-१४", "content_sanskrit": "एत्य नो नार्जुनो गर्हेद्यथा तात तथा कुरु।\nद्रोणानीकस्य न वयं विद्मो भेदं कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2050603, "chapter_id": 2108, "verse_number": "७-३५-१५", "content_sanskrit": "त्वं वाऽर्जुनो वा कृष्णो वा भिन्द्यात्प्रद्युम्न एव वा।\nद्रोणानीकं महाबाहो पञ्चमो नोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2050604, "chapter_id": 2108, "verse_number": "७-३५-१६", "content_sanskrit": "अभिमन्यो वरं तात याचे त्वां दातुमर्हसि।\nपितॄणां मातुलानां च सैन्यानां चैव सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2050605, "chapter_id": 2108, "verse_number": "७-३५-१७", "content_sanskrit": "धनञ्जयो हि नस्तात गर्हयेदेत्य संयुगात्।\nक्षिप्रमस्त्रं समादाय द्रोणानीकं विशातय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2050606, "chapter_id": 2108, "verse_number": "७-३५-१८x", "content_sanskrit": "अभिमन्युरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2050607, "chapter_id": 2108, "verse_number": "७-३५-१८", "content_sanskrit": "द्रोणस्य दृढमत्युग्रमनीकप्रवरं युधि।\nपितॄणां जयमाकाङ्क्षन्नवगाहेऽविलम्बितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2050608, "chapter_id": 2108, "verse_number": "७-३५-१९", "content_sanskrit": "उपदिष्टो हि मे पित्रा योगोऽनीकविशातने।\nनोत्सहे हि विनिर्गन्तुमहं कस्याञ्चिदापदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2050609, "chapter_id": 2108, "verse_number": "७-३५-२०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2050610, "chapter_id": 2108, "verse_number": "७-३५-२०", "content_sanskrit": "भिन्ध्यनीकं युधांश्चेष्ठ द्वारं सञ्जनयस्व नः।\nवयं त्वाऽनुगमिष्यामो येन त्वं तात यास्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2050611, "chapter_id": 2108, "verse_number": "७-३५-२१", "content_sanskrit": "धनञ्जयसमं युद्धे त्वां वयं तात संयुते।\nप्रणिधायानुयास्यामो रक्षन्तः सर्वतोमुखाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2050612, "chapter_id": 2108, "verse_number": "७-३५-२२x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2050613, "chapter_id": 2108, "verse_number": "७-३५-२२", "content_sanskrit": "अहं त्वाऽनुगमिष्यामि धृष्टद्युम्नोऽथ सात्यकिः।\nपाञ्चलाः केकया मात्स्यास्तथा सर्वे प्रभद्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2050614, "chapter_id": 2108, "verse_number": "७-३५-२३", "content_sanskrit": "सकृद्भिन्नं त्वया व्यूहं तत्र तत्र पुनः पुनः।\nवयं प्रध्वंसयिष्यामो निघ्नामाना वरान्वरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2050615, "chapter_id": 2108, "verse_number": "७-३५-२४x", "content_sanskrit": "अभिमन्युरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2050616, "chapter_id": 2108, "verse_number": "७-३५-२४", "content_sanskrit": "अहमेतत्प्रवेक्ष्यामि द्रोणानीकं दुरासदम्।\nपतङ्ग इव सङ्क्रुद्धो ज्वलितं जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2050617, "chapter_id": 2108, "verse_number": "७-३५-२५", "content_sanskrit": "तत्कर्माद्य करिष्यामि हितं यद्वंशयोर्द्वयोः।\nमातुलस्य च यत्प्रीतिं करिष्यति पितुश्च मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2050618, "chapter_id": 2108, "verse_number": "७-३५-२६", "content_sanskrit": "शिशुनैकेन सङ्ग्रमे काल्यमानानि सङ्घशः।\nद्रक्ष्यन्ति सर्वभूतानि द्विषत्सैन्यानि वै मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2050619, "chapter_id": 2108, "verse_number": "७-३५-२७", "content_sanskrit": "नाहं पार्थेन जातः स्यां न च जातः सुभद्रया।\nयदि मे संयुगे कश्चिज्जीवितो नाद्य मुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2050620, "chapter_id": 2108, "verse_number": "७-३५-२८", "content_sanskrit": "यदि चैकरथेनाहं समग्रं क्षत्रमण्डलम्।\nन करोम्यष्टधा युद्धे न भवाम्यर्जुनात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2050621, "chapter_id": 2108, "verse_number": "७-३५-२९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2050622, "chapter_id": 2108, "verse_number": "७-३५-२९", "content_sanskrit": "एवं ते भाषमाणस्य बलं सौभद्र वर्धताम्।\nयत्समुत्सहसे भेत्तुं द्रोणानीकं दुरासदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2050623, "chapter_id": 2108, "verse_number": "७-३५-३०", "content_sanskrit": "रक्षितं पुरुषव्याघ्रैर्महेष्वासैर्महाबलै।\nसाध्यरुद्रमरुत्तुल्यैर्वस्वग्न्यादित्यविक्रमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2050624, "chapter_id": 2108, "verse_number": "७-३५-३१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2050625, "chapter_id": 2108, "verse_number": "७-३५-३१", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा स यन्तारमचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2050626, "chapter_id": 2108, "verse_number": "७-३५-३२", "content_sanskrit": "सुमित्राश्वान्रणे क्षिप्रं द्रोणानीकाय चोदय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2050627, "chapter_id": 2108, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि त्रयोधशदिवसयुद्धे पञ्चत्रिंशोऽध्यायः॥ ३५ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-३५-१६ मातुलानां सात्यकिप्रभृतीनाम्॥ ५-३५-१९ योग उपायो युक्तिर्वा ॥ ५-३५-२१ प्रणिधाय प्रविश्य॥ ५-३५-३५ पञ्चत्रिंशोःऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]