[{"id": 2004333, "chapter_id": 1086, "verse_number": "१-८७-०x", "content_sanskrit": "वसुमानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004334, "chapter_id": 1086, "verse_number": "१-८७-१", "content_sanskrit": "पृच्छामि त्वां वसुमानौषदश्वि-\nर्यद्यस्ति लोको दिवि मे नरेन्द्र।\nयद्यन्तरिक्षे प्रथितो महात्मन्\nक्षेत्रज्ञं त्वां तस्य धर्मस्य मन्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004335, "chapter_id": 1086, "verse_number": "१-८७-२x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004336, "chapter_id": 1086, "verse_number": "१-८७-२", "content_sanskrit": "यदन्तरिक्षं पृथिवी दिशश्च\nयत्तेजसा तपते भानुमांश्च।\nलोकास्तावन्तो दिवि संस्थिता वै\nतेनान्तवन्तः प्रतिपालयन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004337, "chapter_id": 1086, "verse_number": "१-८७-३x", "content_sanskrit": "वसुमानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004338, "chapter_id": 1086, "verse_number": "१-८७-३", "content_sanskrit": "तांस्ते ददानि मा प्रपत प्रपातं\nये मे लोकास्तव ते वै भवन्तु।\nक्रीणीष्वैतांस्तृणकेनापि राज-\nन्प्रतिग्रहस्ते यदि धीमन्प्रदुष्टः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004339, "chapter_id": 1086, "verse_number": "१-८७-४x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004340, "chapter_id": 1086, "verse_number": "१-८७-४", "content_sanskrit": "न मिथ्याऽहं विक्रयं वै स्मरामि\nवृथा गृहीतं शिशुकाच्छङ्कमानः।\nकुर्यां न चैवाकृतपूर्वमन्यै-\nर्विधित्समानः किमु तत्र साधुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004341, "chapter_id": 1086, "verse_number": "१-८७-५x", "content_sanskrit": "वसुमानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004342, "chapter_id": 1086, "verse_number": "१-८७-५", "content_sanskrit": "तांस्त्वं लोकान्प्रतिपद्यस्व राज-\nन्मया दत्तान्यदि नेष्टः क्रयस्ते।\nअहं न तान्वै प्रतिगन्ता नरेन्द्र\nसर्वे लोकास्तव ते वै भवन्तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004343, "chapter_id": 1086, "verse_number": "१-८७-६x", "content_sanskrit": "शिबिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004344, "chapter_id": 1086, "verse_number": "१-८७-६", "content_sanskrit": "पृच्छामि त्वां शिबिरौशीनरोऽहं\nममापि लोका यदि सन्तीह तात।\nयद्यन्तरिक्षे यदि वा दिवि श्रिताः\nक्षेत्रज्ञं त्वां तस्य धर्मस्य मन्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004345, "chapter_id": 1086, "verse_number": "१-८७-७x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004346, "chapter_id": 1086, "verse_number": "१-८७-७", "content_sanskrit": "यत्त्वं वाचा हृदयेनापि साधू-\nन्परीप्समानान्नावमंस्था नरेन्द्र।\nतेनानन्ता दिवि लोकाः श्रितास्ते\nविद्युद्रूपाः स्वनवन्तो महान्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004347, "chapter_id": 1086, "verse_number": "१-८७-८x", "content_sanskrit": "शिबिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004348, "chapter_id": 1086, "verse_number": "१-८७-८", "content_sanskrit": "तांस्त्वं लोकान्प्रतिपद्यस्व राज-\nन्मया दत्तान्यदि नेष्टः क्रयस्ते।\nन चाहं तान्प्रतिपत्स्ये ह दत्त्वा\nयत्र गत्वा नानुशोचन्ति धीराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004349, "chapter_id": 1086, "verse_number": "१-८७-९x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004350, "chapter_id": 1086, "verse_number": "१-८७-९", "content_sanskrit": "यथा त्वमिन्द्रप्रतिमप्रभाव-\nस्ते चाप्यनन्ता नरदेव लोकाः।\nतथाऽद्य लोके न रमेऽन्यदत्ते\nतस्माच्छिबे नाभिनन्दामि दायम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004351, "chapter_id": 1086, "verse_number": "१-८७-१०x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004352, "chapter_id": 1086, "verse_number": "१-८७-१०", "content_sanskrit": "न चेदेकैकशो राजँल्लोकान्नः प्रतिनन्दसि।\nसर्वे प्रदाय भवते गन्तारो नरकं वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004353, "chapter_id": 1086, "verse_number": "१-८७-११x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004354, "chapter_id": 1086, "verse_number": "१-८७-११", "content_sanskrit": "यदर्होऽहं तद्यतध्वं सन्तः सत्याभिनन्दिनः।\nअहं तन्नाभिजानामि यत्कृतं न मया पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2004355, "chapter_id": 1086, "verse_number": "१-८७-१२x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2004356, "chapter_id": 1086, "verse_number": "१-८७-१२", "content_sanskrit": "कस्यैते प्रतिदृश्यन्ते रथाः पञ्च हिरण्मयाः।\nयानारुह्य नरो लोकानभिवाञ्छति शाश्वतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2004357, "chapter_id": 1086, "verse_number": "१-८७-१३x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2004358, "chapter_id": 1086, "verse_number": "१-८७-१३", "content_sanskrit": "युष्मानेते वहिष्यन्ति रथाः पञ्च हिरण्मयाः।\nउच्चैः सन्तः प्रकाशन्ते ज्वलन्तोऽग्निशिखा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2004359, "chapter_id": 1086, "verse_number": "१-८७-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2004360, "chapter_id": 1086, "verse_number": "१-८७-१४", "content_sanskrit": "अश्वमेधे महायज्ञे स्वयंभुविहिते पुरा।\nहयस्य यानि चाङ्गानि संनिकृत्य यथाक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2004361, "chapter_id": 1086, "verse_number": "१-८७-१५", "content_sanskrit": "होताऽध्वर्युरथोद्गाता ब्रह्मणा सह भारत।\nअग्नौ प्रास्यन्ति विधिवत्समस्ताः षोडशर्त्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2004362, "chapter_id": 1086, "verse_number": "१-८७-१६", "content_sanskrit": "धूमगन्धं च पापिष्ठा ये जिघ्रन्ति नरा भुवि।\nविमुक्तपापाः पूतास्ते तत्क्षणेनाभवन्नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2004363, "chapter_id": 1086, "verse_number": "१-८७-१७", "content_sanskrit": "एतस्मिन्नन्तरे चैव माधवी सा तपोधना।\nमृगचर्मपरीताङ्गी परिधाय मृगत्वचम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2004364, "chapter_id": 1086, "verse_number": "१-८७-१८", "content_sanskrit": "मृगैः परिचरन्ती सा मृगाहारविचेष्टिता।\nयज्ञवाटं मृगगणैः प्रविश्य भृशविस्मिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2004365, "chapter_id": 1086, "verse_number": "१-८७-१९", "content_sanskrit": "आघ्रायन्ती धूमगन्धं मृगैरेव चचार सा।\nयज्ञवाटमटन्ती सा पुत्रांस्तानपराजितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2004366, "chapter_id": 1086, "verse_number": "१-८७-२०", "content_sanskrit": "पश्यन्ती यज्ञमाहात्म्यं मुदं लेभे च माधवी।\nअसंस्पृशन्तं वसुधां ययातिं नाहुषं यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2004367, "chapter_id": 1086, "verse_number": "१-८७-२१", "content_sanskrit": "दिविष्ठं प्राप्तमाज्ञाय ववन्दे पितरं तदा।\nतदा वसुमनापृच्छन्मातरं वै तपस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2004368, "chapter_id": 1086, "verse_number": "१-८७-२२", "content_sanskrit": "भवत्या यत्कृतमिदं वन्दनं पादयोरिह।\nकोयं देवोपमो राजा याऽभिवन्दसि मे वद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2004369, "chapter_id": 1086, "verse_number": "१-८७-२३x", "content_sanskrit": "माधव्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2004370, "chapter_id": 1086, "verse_number": "१-८७-२३", "content_sanskrit": "शृणुध्वं सहिताः पुत्रा नाहुषोयं पिता मम।\nययातिर्मम पुत्राणां मातामह इति स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2004371, "chapter_id": 1086, "verse_number": "१-८७-२४", "content_sanskrit": "पूरुं मे भ्रातरं राज्ये समावेश्य दिवं गतः।\nकेन वा कारणेनैवमिह प्राप्तो महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2004372, "chapter_id": 1086, "verse_number": "१-८७-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2004373, "chapter_id": 1086, "verse_number": "१-८७-२५", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा स्वर्गाद्भ्रष्टेति चाब्रवीत्।\nसा पुत्रस्य वचः श्रुत्वा संभ्रमाविष्टचेतना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2004374, "chapter_id": 1086, "verse_number": "१-८७-२६", "content_sanskrit": "माधवी पितरं प्राह दौहित्रपरिवारितम्।\nतपसा निर्जिताँल्लोकान्प्रतिगृह्णीष्व मामकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2004375, "chapter_id": 1086, "verse_number": "१-८७-२७", "content_sanskrit": "पुत्राणामिव पौत्राणां धर्मादधिगतं धनम्।\nस्वार्थणेव वदन्तीह ऋषयो धर्मपाठकाः।\nतस्माद्दानेन तपसा चास्माकं दिवमाव्रज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2004376, "chapter_id": 1086, "verse_number": "१-८७-२८x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2004377, "chapter_id": 1086, "verse_number": "१-८७-२८", "content_sanskrit": "यदि धर्मफलं ह्येतच्छोभनं भविता तव।\nदुहित्रा चैव दौहित्रैस्तारितोऽहं महात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2004378, "chapter_id": 1086, "verse_number": "१-८७-२९", "content_sanskrit": "तस्मात्पवित्रं दौहित्रमद्यप्रभृति पैतृके।\nत्रीणि श्राद्धे पवित्राणि दौहित्रः कुतपस्तिलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2004379, "chapter_id": 1086, "verse_number": "१-८७-३०", "content_sanskrit": "त्रीणि चात्र प्रशंसन्ति शौचमक्रोधमत्वराम्।\nभोक्तारः परिवेष्टारः श्रावितारः पवित्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2004380, "chapter_id": 1086, "verse_number": "१-८७-३१", "content_sanskrit": "दिवसस्याष्टमे भागे मन्दीभवति भास्करे।\nस कालः कुतपो नाम पितॄणां दत्तमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2004381, "chapter_id": 1086, "verse_number": "१-८७-३२", "content_sanskrit": "तिलाः पिशाचाद्रक्षन्ति दर्भा रक्षन्ति राक्षसात्।\nरक्षन्ति श्रोत्रियाः पङ्क्तिं यतिभिर्भुक्तमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2004382, "chapter_id": 1086, "verse_number": "१-८७-३३", "content_sanskrit": "लब्ध्वा पात्रं तु विद्वांसं श्रोत्रियं सुव्रतं शुचिम्।\nस कालः कालतो दत्तं नान्यथा काल इष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2004383, "chapter_id": 1086, "verse_number": "१-८७-३४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2004384, "chapter_id": 1086, "verse_number": "१-८७-३४", "content_sanskrit": "एवमुक्त्वा ययातिस्तु पुनः प्रोवाच बुद्धिमान्।\nसर्वे ह्यवभृथस्नातास्त्वरध्वं कार्यगौरवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2004385, "chapter_id": 1086, "verse_number": "१-८७-३५x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2004386, "chapter_id": 1086, "verse_number": "१-८७-३५", "content_sanskrit": "आतिष्ठ स्वरथं राजन्विक्रमस्व विहायसम्।\nवयमप्यनुयास्यामो यदा कालो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2004387, "chapter_id": 1086, "verse_number": "१-८७-३६x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2004388, "chapter_id": 1086, "verse_number": "१-८७-३६", "content_sanskrit": "सर्वैरिदानीं गन्तव्यं सह स्वर्गजितो वयम्।\nएष नो विरजाः पन्था दृश्यते देवसद्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2004389, "chapter_id": 1086, "verse_number": "१-८७-३७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2004390, "chapter_id": 1086, "verse_number": "१-८७-३७", "content_sanskrit": "अष्टकश्च शिबिश्चैव काशेयश्च प्रतर्दनः।\nऐक्ष्वाकवो वसुमनाश्चत्वारो भूमिपास्तदा।\nसर्वे ह्यवभृथस्नाताः स्वर्गताः साधवः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2004391, "chapter_id": 1086, "verse_number": "१-८७-३८", "content_sanskrit": "तेऽधिरुह्य रथान्सर्वे प्रयाता नृपस्तमाः।\nआक्रमन्तो दिवं भाभिर्धर्मेणावृत्य रोदसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2004392, "chapter_id": 1086, "verse_number": "१-८७-३९x", "content_sanskrit": "अष्टक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2004393, "chapter_id": 1086, "verse_number": "१-८७-३९", "content_sanskrit": "अहं मन्ये पूर्वमेकोऽस्मि गन्ता\nसखा चेन्द्रः सर्वथा मे महात्मा।\nकस्मादेवं शिबिरौशीनरोऽय-\nमेकोऽत्यगात्सर्ववेगेन वाहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2004394, "chapter_id": 1086, "verse_number": "१-८७-४०x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2004395, "chapter_id": 1086, "verse_number": "१-८७-४०", "content_sanskrit": "अददद्याचमानाय यावद्वित्तमविन्दत।\nउशीनरस्य पुत्रोऽयं तस्माच्छ्रेष्ठोहि वः शिबिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2004396, "chapter_id": 1086, "verse_number": "१-८७-४१", "content_sanskrit": "दानं तपः संत्यमथाऽपि धर्मो\nह्रीः श्रीः क्षमा सौम्यमथो विधित्सा।\nराजन्नेतान्यप्रमेयाणि राज्ञः\nशिबेः स्थितान्यप्रतिमस्य बुद्ध्या॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2004397, "chapter_id": 1086, "verse_number": "१-८७-४२", "content_sanskrit": "एवं वृत्तो ह्रीनिषेवश्च यस्मा-\nत्तस्माच्छिबिरत्यगाद्वै रथेन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2004398, "chapter_id": 1086, "verse_number": "१-८७-४२x", "content_sanskrit": "वैशम्पायन उवाच।\nअथाष्टकः पुनरेवान्वपृच्छ-\nन्मातामहं कौतुकेनेन्द्रकल्पम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2004399, "chapter_id": 1086, "verse_number": "१-८७-४३", "content_sanskrit": "पृच्छामि त्वां नृपते ब्रूहि सत्यं\nकुतश्च कश्चासि सुतश्च कस्य।\nकृतं त्वया यद्धि न तस्य कर्ता\nलोके त्वदन्यः क्षत्रियो ब्राह्मणो वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2004400, "chapter_id": 1086, "verse_number": "१-८७-४४x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2004401, "chapter_id": 1086, "verse_number": "१-८७-४४", "content_sanskrit": "ययातिरस्मि नहुषस्य पुत्रः\nपूरोः पिता सार्वबौमस्त्विहासम्।\nगुह्यं चार्थं मामकेभ्यो ब्रवीमि\nमातामहोऽहं भवतां प्रकाशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2004402, "chapter_id": 1086, "verse_number": "१-८७-४५", "content_sanskrit": "सर्वामिमां पृथिवीं निर्जिगाय\nदत्त्वा प्रतस्थे विपिनं ब्राह्मणेभ्यः।\nमेध्यानश्वानेकशतान्सुरूपां-\nस्तदा देवाः पुण्यभाजो भवन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2004403, "chapter_id": 1086, "verse_number": "१-८७-४६", "content_sanskrit": "अदामहं पृथिवीं ब्राह्मणेभ्यः\nपूर्णामिमामखिलां वाहनेन।\nगोभिः सुवर्णेन धनैश्च मुख्यै-\nस्तदाऽददं गाः शथमर्बुदानि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2004404, "chapter_id": 1086, "verse_number": "१-८७-४७", "content_sanskrit": "सत्येन मे द्यौश्च वसुन्धरा च\nतथैवाग्निज्वर्लते मानुषेषु।\nन मे वृथा व्याहृतमेव वाक्यं\nसत्यं हि सन्तः प्रतिपूजयन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2004405, "chapter_id": 1086, "verse_number": "१-८७-४८", "content_sanskrit": "यदष्टक प्रब्रवीमीह सत्यं\nप्रतर्दनं चौषदश्विं तथैव।\nसर्वे च लोका मुनयश्च देवाः\nसत्येन पूज्या इति मे मनोगतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2004406, "chapter_id": 1086, "verse_number": "१-८७-४९", "content_sanskrit": "यो नः स्वर्गजितः सर्वान्यथावृत्तं निवेदयेत्।\nअनसूयुर्द्विजाग्र्येभ्यः स लभेन्नः सलोकताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2004407, "chapter_id": 1086, "verse_number": "१-८७-५०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2004408, "chapter_id": 1086, "verse_number": "१-८७-५०", "content_sanskrit": "एवं राजा स महात्मा ह्यतीव\nस्वैर्दौहित्रैस्तारितोऽमित्रसाह।\nत्यक्त्वा महीं परमोदारकर्मा\nस्वर्गं गतः कर्मभिर्व्याप्य पृथ्वीम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2004409, "chapter_id": 1086, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि सप्ताशीतितमोऽध्यायः॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]