[{"id": 5000317000, "chapter_id": 9317, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे पञ्चचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000317001, "chapter_id": 9317, "verse_number": "४-४५-१", "content_sanskrit": "सर्वांश्चाहूय सुग्रीवः प्लवगान् प्लवगर्षभः।\nसमस्तांश्चाब्रवीद् राजा रामकार्यार्थसिद्धये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000317002, "chapter_id": 9317, "verse_number": "४-४५-२", "content_sanskrit": "एवमेतद् विचेतव्यं भवद्भिर्वानरोत्तमैः।\nतदुग्रशासनं भर्तुर्विज्ञाय हरिपुंगवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000317003, "chapter_id": 9317, "verse_number": "४-४५-३", "content_sanskrit": "शलभा इव संछाद्य मेदिनीं सम्प्रतस्थिरे।\nरामः प्रस्रवणे तस्मिन् न्यवसत् सहलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000317004, "chapter_id": 9317, "verse_number": "४-४५-४", "content_sanskrit": "प्रतीक्षमाणस्तं मासं सीताधिगमने कृतः।\nउत्तरां तु दिशं रम्यां गिरिराजसमावृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000317005, "chapter_id": 9317, "verse_number": "४-४५-५", "content_sanskrit": "प्रतस्थे सहसा वीरो हरिः शतबलिस्तदा।\nपूर्वां दिशं प्रतिययौ विनतो हरियूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000317006, "chapter_id": 9317, "verse_number": "४-४५-६", "content_sanskrit": "ताराङ्गदादिसहितः प्लवगः पवनात्मजः।\nअगस्त्याचरितामाशां दक्षिणां हरियूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000317007, "chapter_id": 9317, "verse_number": "४-४५-७", "content_sanskrit": "पश्चिमां च दिशं घोरां सुषेणः प्लवगेश्वरः।\nप्रतस्थे हरिशार्दूलो दिशं वरुणपालिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000317008, "chapter_id": 9317, "verse_number": "४-४५-८", "content_sanskrit": "ततः सर्वा दिशो राजा चोदयित्वा यथातथम्।\nकपिसेनापतिर्वीरो मुमोद सुखितः सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000317009, "chapter_id": 9317, "verse_number": "४-४५-९", "content_sanskrit": "एवं संचोदिताः सर्वे राज्ञा वानरयूथपाः।\nस्वां स्वां दिशमभिप्रेत्य त्वरिताः सम्प्रतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000317010, "chapter_id": 9317, "verse_number": "४-४५-१०", "content_sanskrit": "नदन्तश्चोन्नदन्तश्च गर्जन्तश्च प्लवंगमाः।\nक्ष्वेडन्तो धावमानाश्च विनदन्तो महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000317011, "chapter_id": 9317, "verse_number": "४-४५-११", "content_sanskrit": "एवं संचोदिताः सर्वे राज्ञा वानरयूथपाः।\nआनयिष्यामहे सीतां हनिष्यामश्च रावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000317012, "chapter_id": 9317, "verse_number": "४-४५-१२", "content_sanskrit": "अहमेको वधिष्यामि प्राप्तं रावणमाहवे।\nततश्चोन्मथ्य सहसा हरिष्ये जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000317013, "chapter_id": 9317, "verse_number": "४-४५-१३", "content_sanskrit": "वेपमानां श्रमेणाद्य भवद्भिः स्थीयतामिति।\nएक एवाहरिष्यामि पातालादपि जानकीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000317014, "chapter_id": 9317, "verse_number": "४-४५-१४", "content_sanskrit": "विधमिष्याम्यहं वृक्षान् दारयिष्याम्यहं गिरीन्।\nधरणीं दारयिष्यामि क्षोभयिष्यामि सागरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000317015, "chapter_id": 9317, "verse_number": "४-४५-१५", "content_sanskrit": "अहं योजनसंख्यायाः प्लवेयं नात्र संशयः।\nशतयोजनसंख्यायाः शतं समधिकं ह्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000317016, "chapter_id": 9317, "verse_number": "४-४५-१६", "content_sanskrit": "भूतले सागरे वापि शैलेषु च वनेषु च।\nपातालस्यापि वा मध्ये न ममाच्छिद्यते गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000317017, "chapter_id": 9317, "verse_number": "४-४५-१७", "content_sanskrit": "इत्येकैकस्तदा तत्र वानरा बलदर्पिताः।\nऊचुश्च वचनं तस्य हरिराजस्य संनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000317018, "chapter_id": 9317, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे पञ्चचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]