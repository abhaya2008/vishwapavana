: "तयोस्समागमःपूर्वंप्रीत्यहार्दोव्यजायत ॥ भ्रात्रानिरस्तःक्रुद्धेनसुग्रीवोवालिनापुरा । इतरेतरसंवादात्प्रगाढःप्रणयस्तयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40019626, "chapter_id": 9317, "verse_number": "38", "content_sanskrit": "रामस्स्वबाहुवीर्येणस्वराज्यंप्रत्यपादयत् । वालिनंसमरेहत्वामहाकायंमहाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40019627, "chapter_id": 9317, "verse_number": "39", "content_sanskrit": "सुग्रीवस्स्थापितोराज्येसहितस्सर्ववानरैः । रामायप्रतिजानीतेराजपुत्य्रास्तुमार्गणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40019628, "chapter_id": 9317, "verse_number": "40", "content_sanskrit": "अदिष्टावानरेन्द्रेणसुग्रीवेणमहात्मना । दशकोट्यःप्लवङ्गानांसर्वाःप्रस्थापिताःदिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40019629, "chapter_id": 9317, "verse_number": "41", "content_sanskrit": "तेषांनोविप्रनष्टानांविन्ध्येपर्वतसत्तमो । भृशंशोकानितप्तानांमहान्कालो त्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40019630, "chapter_id": 9317, "verse_number": "42", "content_sanskrit": "भ्रातातुगृध्रराजस्यसम्पातिर्नामवीर्यवान् । समाख्यातिस्मवसतींसीतांरावणमन्दिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40019631, "chapter_id": 9317, "verse_number": "43", "content_sanskrit": "सोहंदुःखपरीतानांदुःखंतद् ज्ञातीनांनुदन् । आत्मवीर्यंसमास्थाययोजनानांशतंप्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40019632, "chapter_id": 9317, "verse_number": "44", "content_sanskrit": "तत्राहमेकामद्राक्षमशोकवनिकांगताम् । कौशेयवस्त्रांमलिनांनिरनन्दांदृढव्रताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40019633, "chapter_id": 9317, "verse_number": "45", "content_sanskrit": "तयासमेत्यविधिवत् पृष्टवासर्वमनिन्दिताम् । अभिज्ञानंमयादत्तंरामनामाङ्गुलीयकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40019634, "chapter_id": 9317, "verse_number": "46", "content_sanskrit": "अभिज्ञानंमणिंलब्द्वाचरितार्धो हमागतः । मया च पुनरागम्यरामस्याक्लिष्टकर्मणः ॥ अभिज्ञानंमयादत्तमर्चिष्मान् स महामणिः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40019635, "chapter_id": 9317, "verse_number": "47", "content_sanskrit": "श्रुत्वातांमैथिलींरामस्त्वाशशंसे च जीवितम् ॥ जीवितान्तमनुप्राप्तःपीत्वामृतमिवातुरः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40019636, "chapter_id": 9317, "verse_number": "48", "content_sanskrit": "उद्योजयिष्यन्नुद्योगंदध्रेकामंवधेमनः ॥ जिघांसुरिवलोकान्तेसर्वान्लोकान्विभावसुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40019637, "chapter_id": 9317, "verse_number": "49", "content_sanskrit": "ततस्समुद्रमासाद्यनलंसेतुमकारयत् ॥ अतरत्कपिवीराणां वाहिनी तेन सेतुना ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40019638, "chapter_id": 9317, "verse_number": "50", "content_sanskrit": "प्रहस्तम्वधीन्नीलःकुम्भकर्णंतुराघवः ॥ लक्ष्मणोरावणसुतंस्वयंरामस्तुरावणम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40019639, "chapter_id": 9317, "verse_number": "51", "content_sanskrit": "सशक्रेणसमागम्ययमेनवरुणेन च ॥ महेश्वरस्वयंभूभ्यां तथा दशरथेन च । तैश्चदत्तवर्श्रीमानृषिभिश्चसमागतैः ॥ सुरर्षिभिश्चकाकुत्स्थोवरान्लेभेपरन्तपः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40019640, "chapter_id": 9317, "verse_number": "52", "content_sanskrit": "सशक्रेणसमागम्ययमेनवरुणेन च ॥ महेश्वरस्वयंभूभ्यां तथा दशरथेन च । तैश्चदत्तवर्श्रीमानृषिभिश्चसमागतैः ॥ सुरर्षिभिश्चकाकुत्स्थोवरान्लेभेपरन्तपः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40019641, "chapter_id": 9317, "verse_number": "53", "content_sanskrit": "सतुदत्तवरःप्रीत्यावानरैश्चसमागतः ॥ पुष्पकेनविमानेनकिष्किनष्धामभ्युपागमत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40019642, "chapter_id": 9317, "verse_number": "54", "content_sanskrit": "तंगङ्गांपुनारासाद्यवसन्तंमुनिसन्निधौ ॥ अविघ्नंपुष्ययोगेनश्वोरामंद्रष्टुमर्हसि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]