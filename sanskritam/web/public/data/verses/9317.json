3}, {"id": 40019612, "chapter_id": 9317, "verse_number": "24", "content_sanskrit": "ततोरामोधनुष्पाणिर्मृगंतमनुधावति । स तंजघानधावन्तंशरेणानतपर्वणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40019613, "chapter_id": 9317, "verse_number": "25", "content_sanskrit": "अथसौम्य दशग्रीवोमृगंयातेतुराघवे । लक्ष्मणेचापिनिष्क्रान्तेप्रविवेशाश्रमंतदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40019614, "chapter_id": 9317, "verse_number": "26", "content_sanskrit": "जग्राहतरसासीतांग्रहःखेरोहिणीमिव । त्रातुकामंततोयुद्धेहत्वागृध्रंजटायुषम् ॥ प्रगृह्यसहसासीतांजगामाशु स राक्षसः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40019615, "chapter_id": 9317, "verse_number": "27", "content_sanskrit": "तस्त्वद्भुतसङ्काशास्स्थिताःपर्वतमूर्धनि ॥ सीतांगृहीत्वागच्छन्तंवानराःपर्वतोपमाः । ददृशुर्मिस्मिताकारारावणंराक्षसाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40019616, "chapter_id": 9317, "verse_number": "28", "content_sanskrit": "तस्त्वद्भुतसङ्काशास्स्थिताःपर्वतमूर्धनि ॥ सीतांगृहीत्वागच्छन्तंवानराःपर्वतोपमाः । ददृशुर्मिस्मिताकारारावणंराक्षसाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40019617, "chapter_id": 9317, "verse_number": "29", "content_sanskrit": "ततशीघ्रतरंगत्वातद्विमानंमनोजवम् । आरुह्यसहवैदेह्यापुष्पकं स महाबलः ॥ प्रविवेशतदालङ्कांरावणोराक्षसेश्वरः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40019618, "chapter_id": 9317, "verse_number": "30", "content_sanskrit": "तांसुवर्णपरिष्कारेशुभेमहतिवेश्मनि ॥ प्रवेश्यमैथिलींवाक्यैस्सान्त्वयामासरावणः ।", "padaccheda": "", "a