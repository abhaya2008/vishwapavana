[{"id": 7003705000, "chapter_id": 23705, "verse_number": "१-४-१३-१", "content_sanskrit": "नंदिकेश्वर उवाच ।\nकेतकीबर्हमप्येनं विहस्य पुनरब्रवीत् ।\nकेतक्युवाच ।\nअपि मूढ न किंचित्त्वं वेत्सि कस्त्वं कुतो न तत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003705001, "chapter_id": 23705, "verse_number": "१-४-१३-२", "content_sanskrit": "ईदृश्यः परितो लग्ना यस्मिन्ब्रह्मांडकोटयः ।\nतस्य प्रमाणमेतावदिति को वेदितुं क्षमः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003705002, "chapter_id": 23705, "verse_number": "१-४-१३-३", "content_sanskrit": "चतुर्युगायुतैर्यातं ततो निपततो मम ।\nइदानीमपि नाप्रोति तन्मध्यं किल भूतलम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003705003, "chapter_id": 23705, "verse_number": "१-४-१३-४", "content_sanskrit": "इति ब्रुवाणमेनं च नमस्कृत्य सरोजभूः ।\nहित्वा निजमहंकारमभाषत कृतांजलिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003705004, "chapter_id": 23705, "verse_number": "१-४-१३-५", "content_sanskrit": "ब्रह्मोवाच ।\nमहात्मन्सत्यमेवास्मि मूढोऽहं केतकच्छद ।\nब्रह्मणा हि मया स्पर्द्धा विष्णुना सह निर्मिता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003705005, "chapter_id": 23705, "verse_number": "१-४-१३-६", "content_sanskrit": "द्वाभ्यामपीदमावाभ्यां विस्मृतं शिववैभवम् ।\nयन्नौ महानभूद्गर्वस्सर्गसंत्राणमात्रतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003705006, "chapter_id": 23705, "verse_number": "१-४-१३-७", "content_sanskrit": "ह्रेपणी संकथा तावदास्तामद्याप्यहं यतः ।\nस्पर्द्धया न विमुक्तोऽस्मि बद्धया गरुडध्वजे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003705007, "chapter_id": 23705, "verse_number": "१-४-१३-८", "content_sanskrit": "सख्यं साप्तपदीनं हि कथ्यते तद्भवान्मयि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003705008, "chapter_id": 23705, "verse_number": "१-४-१३-९", "content_sanskrit": "असंस्तुतधियं हित्वा कर्तुमर्हस्यनुग्रहम् ।\nअहं विष्णुश्च मोहांधौ तेजःस्तंभस्य वीक्षणात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003705009, "chapter_id": 23705, "verse_number": "१-४-१३-१०", "content_sanskrit": "हंसकोलाकृती दध्वो मिथः साम्यं व्यपोहितुम् ।\nमूलं दिदृक्षुः स दशां कीदृशीं यातवानिति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003705010, "chapter_id": 23705, "verse_number": "१-४-१३-११", "content_sanskrit": "न जाने मम चास्याग्रं दिदृक्षोरीदृक्षी दशा ।\nगतमुड्डीयमानस्य मे सहस्रेण हायनेः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003705011, "chapter_id": 23705, "verse_number": "१-४-१३-१२", "content_sanskrit": "जातश्रमोऽस्मि नितरां वियुज्य इव चासुभिः ।\nदिष्ट्याद्य भद्र लब्धस्त्वं मयाऽलंबोवसीदताम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003705012, "chapter_id": 23705, "verse_number": "१-४-१३-१३", "content_sanskrit": "तन्मे कुरुष्व मित्रस्य सफलां याचनामिमाम् ।\nसखाहं सहसंजल्पादस्मि दासोनुषंजनात् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003705013, "chapter_id": 23705, "verse_number": "१-४-१३-१४", "content_sanskrit": "तत्त्वया करणीयैवं प्रार्थनैषा कृतांजलिः ।\nयदि पश्यति मूलं स जितोऽहममुना तदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003705014, "chapter_id": 23705, "verse_number": "१-४-१३-१५", "content_sanskrit": "यद्वा न पश्यति तदाप्यस्मि साम्यमुपेयिवान् ।\nइदं द्वयमपि प्रायो ममातिह्रेपणं सखे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003705015, "chapter_id": 23705, "verse_number": "१-४-१३-१६", "content_sanskrit": "त्वयैव परिहार्यत्वमिदानीं समुपागतम् ।\nअनृतामभिभाष त्वमुचितां च सुहृत्कृते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003705016, "chapter_id": 23705, "verse_number": "१-४-१३-१७", "content_sanskrit": "गिरमेकामिमामग्रे चक्रपाणेरुदीरय ।\nएष हंसाकृतिर्ब्रह्मा तेजःस्तंभस्वरूपिणः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003705017, "chapter_id": 23705, "verse_number": "१-४-१३-१८", "content_sanskrit": "अत्युच्चं दृष्टवानग्रमत्र साक्ष्ये स्थितोऽस्म्यहम् ।\nतेनापि तेजःस्तम्भत्वमेयुषा चन्द्रमौलिना ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003705018, "chapter_id": 23705, "verse_number": "१-४-१३-१९", "content_sanskrit": "संभावितोयं सुतरां पित्रेव हि पितामहः ।\nअतोऽयमेवाभ्यधिको भवतो विष्टरश्रवाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003705019, "chapter_id": 23705, "verse_number": "१-४-१३-२०", "content_sanskrit": "इत्युक्त्वा मम साहाय्यं सुमहत्क्रियतां त्वया ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003705020, "chapter_id": 23705, "verse_number": "१-४-१३-२१", "content_sanskrit": "नंदिकेश्वर उवाच ।\nएवं भूयः प्रार्थितोऽयं विधात्रा दाक्षिण्यार्द्रः केतकीबर्हकोपि ।\nतेजःस्तंभाभ्यर्णभाजे तथैव प्राहाशेषं विष्णवे ब्रह्मवाक्यम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]