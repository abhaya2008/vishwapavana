[{"id": 2019629, "chapter_id": 1408, "verse_number": "३-४६-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019630, "chapter_id": 1408, "verse_number": "३-४६-१", "content_sanskrit": "अत्यद्भुतमिदं कर्म पार्थस्यामिततेजसः।\nधृतराष्ट्रो महातेजाः श्रुत्वा तत्र किमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019631, "chapter_id": 1408, "verse_number": "३-४६-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019632, "chapter_id": 1408, "verse_number": "३-४६-२", "content_sanskrit": "शक्रलोकगतं पार्थं श्रुत्वा राजाऽम्बिकासुतः।\nद्वैपायनादृषिश्रेष्ठात्संजयं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019633, "chapter_id": 1408, "verse_number": "३-४६-३", "content_sanskrit": "श्रुतं मे सूत कार्त्स्न्येन कर्म पार्थस् धीमतः।\nकच्चित्तवापि विदितं याथातथ्येन सारथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019634, "chapter_id": 1408, "verse_number": "३-४६-४", "content_sanskrit": "प्रमत्तो ग्राम्यधर्मेषु मन्दात्मा पापनिश्चयः।\nमम पुत्रः सुदुर्बुद्धिः पृथिवीं घातयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019635, "chapter_id": 1408, "verse_number": "३-४६-५", "content_sanskrit": "यस्य नित्यमृता वाचः स्वैरेष्वपि महात्मनः।\nत्रैलोक्यमपि तस्य स्याद्योद्धा यस्य धनंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019636, "chapter_id": 1408, "verse_number": "३-४६-६", "content_sanskrit": "अस्यतः कर्णिनाराचांस्तीक्ष्णाग्रांश्च शिलाशितान्।\nनार्जुनस्याग्रतस्तिष्ठेदपि मृत्युर्जरातिगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019637, "chapter_id": 1408, "verse_number": "३-४६-७", "content_sanskrit": "मम पुत्रा दुरात्मानः सर्वे मृत्युवशंगताः।\nयेषां युद्धं दुराधर्षैः पाण्डवैः समुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019638, "chapter_id": 1408, "verse_number": "३-४६-८", "content_sanskrit": "तस्यैव च न पश्यामि युधि गाण्डीवधन्वनः।\nअनिशं चिन्तयानोऽपि य एनमुदियाद्युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019639, "chapter_id": 1408, "verse_number": "३-४६-९", "content_sanskrit": "द्रोणकर्णौ प्रतीयातां यदि भीष्मोऽपि वा रणे।\nमहान्स्यात्संशयोलोके न तु पश्यामि नो जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019640, "chapter_id": 1408, "verse_number": "३-४६-१०", "content_sanskrit": "घृणी कर्णः प्रमादी च आचार्यः स्थविरो गुरुः।\nअमर्षी बलवान्पार्थः संरम्भी दृढविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019641, "chapter_id": 1408, "verse_number": "३-४६-११", "content_sanskrit": "भवेत्सुतुमुलं युद्धं सर्वस्याप्यपराजितम्।\nसर्वे ह्यस्त्रविदः शूराः सर्वे प्राप्ता महद्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019642, "chapter_id": 1408, "verse_number": "३-४६-१२", "content_sanskrit": "अपि सर्वेश्वरत्वं हि न वाञ्छेरन्पराजिताः।\nवधे नूनं भवेच्छान्तिरेतेषां फल्गुनस्य वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019643, "chapter_id": 1408, "verse_number": "३-४६-१३", "content_sanskrit": "न तु हन्ताऽर्जुनस्यास्ति जेता वाऽस्य न विद्यते।\nमन्युस्तस्य कथं शाम्येन्मन्दान्प्रति समुत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019644, "chapter_id": 1408, "verse_number": "३-४६-१४", "content_sanskrit": "त्रिदशेशसमो वीरः खाण्डवेऽग्निमतर्पयत्।\nजिगा पार्थिवान्सर्वान्राजसूये महाक्रतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019645, "chapter_id": 1408, "verse_number": "३-४६-१५", "content_sanskrit": "शेषं कुर्याद्गिरेर्वज्रो निपतन्मूर्ध्नि संजय।\nन तु कुर्युः शराः शेषं क्षिप्तास्तात किरीटिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019646, "chapter_id": 1408, "verse_number": "३-४६-१६", "content_sanskrit": "यथा हि किरणा भानोस्तपन्तीह चराचरम्।\nतथा पार्थभुजोत्सृष्टाः शरास्तप्स्यन्ति मत्सुतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019647, "chapter_id": 1408, "verse_number": "३-४६-१७", "content_sanskrit": "अपि तद्रथघोषेण भयार्था सव्यसाचिनः।\nप्रतिभाति विदीर्णेव सर्वतो भारती चमूः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019648, "chapter_id": 1408, "verse_number": "३-४६-१८", "content_sanskrit": "समुद्धरन्प्रवपंश्चैव बाणान्\nस्ताताऽऽततायी समरे किरीटि।\nसृष्टोऽन्तकः सर्वहरो विधात्रा\nभवेद्यथा तद्वदवारणीयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019649, "chapter_id": 1408, "verse_number": "३-४६-१९x", "content_sanskrit": "संजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019650, "chapter_id": 1408, "verse_number": "३-४६-१९", "content_sanskrit": "यदतत्कथितं राजंस्त्वया दुर्योधनं प्रति।\nसर्वमेतद्यथातत्त्वं नतु मिथ्या महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019651, "chapter_id": 1408, "verse_number": "३-४६-२०", "content_sanskrit": "मन्युना हि समाविष्टाः पाण्डवास्त्वमितौजसः।\nदृष्ट्वा कृष्णां सभां नीतां धर्मपत्नीं यशस्विनीं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019652, "chapter_id": 1408, "verse_number": "३-४६-२१", "content_sanskrit": "दुःशासनस्य ता वाचः श्रुत्वा वै कटुकोदयाः।\nकर्णस्य च महाराज न स्वप्स्यन्तीति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019653, "chapter_id": 1408, "verse_number": "३-४६-२२", "content_sanskrit": "श्रुतं हि ते महाराज यथा पार्थेन संयुगे।\nएकादशतनुः स्थाणुर्धेनुषा परितोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019654, "chapter_id": 1408, "verse_number": "३-४६-२३", "content_sanskrit": "कैरातं वेषमास्थाय योधयामास फल्गुनम्।\nजिज्ञासुः सर्वदेवेशः कपर्दी भगवान्स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019655, "chapter_id": 1408, "verse_number": "३-४६-२४", "content_sanskrit": "`लेभे पाशुपतं चापि परमास्त्रं महाद्युतिः।\nतत्रैनं लोकपालास्ते दर्शयामासुरर्जुनम्।\nअस्त्रहेतोः पराक्रान्तं तपसा कौरवर्षभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019656, "chapter_id": 1408, "verse_number": "३-४६-२५", "content_sanskrit": "नैतदुत्सहते चान्यो लब्धुमन्यत्र फल्गुनात्।\nसाक्षाद्दर्शनमेतेषामीश्वराणां नरो भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019657, "chapter_id": 1408, "verse_number": "३-४६-२६", "content_sanskrit": "महेश्वरेण यो राजन्न जीर्णो ग्रस्तमूर्तिमान्।\nकस्तमुत्सहते वीरो युद्धे जरयितुं पुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019658, "chapter_id": 1408, "verse_number": "३-४६-२७", "content_sanskrit": "आसादितमिदं घोरं तुमुलं रोमहर्षणम्।\nद्रौपदीं परिकर्षद्भिः कोपयद्भिश्च पाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019659, "chapter_id": 1408, "verse_number": "३-४६-२८", "content_sanskrit": "यत्र विस्फुरमाणौष्ठो भीमः प्राह वचोऽर्थवत्।\nदृष्ट्वा दुर्योधनेनोरू द्रौपद्या दर्शितावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019660, "chapter_id": 1408, "verse_number": "३-४६-२९", "content_sanskrit": "ऊरुं भेत्स्यामि ते पाप गदया वज्रकल्पया।\nत्रयोदशानां वर्षाणामन्ते दुर्द्यूतदेविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019661, "chapter_id": 1408, "verse_number": "३-४६-३०", "content_sanskrit": "सर्वे प्रहरतां श्रेष्ठाः सर्वेचामिततेजसः।\nसर्वेसर्वास्त्रविद्वांसो देवैरपि सुदुर्जयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2019662, "chapter_id": 1408, "verse_number": "३-४६-३१", "content_sanskrit": "मन्ये मन्युसमुद्भूताः पुत्राणां तव संयुगे।\nअन्तं पार्थाः करिष्यन्ति वीर्यामर्षसमन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2019663, "chapter_id": 1408, "verse_number": "३-४६-३२x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2019664, "chapter_id": 1408, "verse_number": "३-४६-३२", "content_sanskrit": "किं कृतं सूत कर्णेन वदता परुषं वचः।\nपर्याप्तं वैरमेतावद्यत्कृष्णा सा सभां गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2019665, "chapter_id": 1408, "verse_number": "३-४६-३३", "content_sanskrit": "अपीदानीं मम सुतास्तिष्ठेरन्मन्दचेतसः।\nयेषां भ्राता गुरुर्ज्येष्ठो विनये नावतिष्ठते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2019666, "chapter_id": 1408, "verse_number": "३-४६-३४", "content_sanskrit": "ममापि वचनं सूत न शुश्रूषति मन्दभाक्।\nदृष्ट्वा मां चक्षुषा हीनं निर्विचेष्टमचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2019667, "chapter_id": 1408, "verse_number": "३-४६-३५", "content_sanskrit": "ये चास्य सचिवा मन्दाः कर्णसौबलकादयः।\nते तस्य भूयसो दोषान्वर्धयन्ति विचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2019668, "chapter_id": 1408, "verse_number": "३-४६-३६", "content_sanskrit": "स्वैरं मुक्ता ह्यपि शराः पार्थेनामिततेजसा।\nनिर्दहेयुर्मम सुतान्किंपुनर्मन्युनेरिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2019669, "chapter_id": 1408, "verse_number": "३-४६-३७", "content_sanskrit": "पार्थबाहुबलोत्सृष्टा महाचापविनिःसृताः।\nदिव्यास्त्रमन्त्रमुदिताः सादयेयुः सुरानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2019670, "chapter_id": 1408, "verse_number": "३-४६-३८", "content_sanskrit": "यस्य मन्त्री च गोप्ता च सुहृच्चैव जनार्दनः।\nहनिस्त्रैलोक्यनाथः स किंनु तस् न निर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2019671, "chapter_id": 1408, "verse_number": "३-४६-३९", "content_sanskrit": "इदं हि सुमहच्चित्रमर्जुनस्येह संजय।\nमहादेवेन बाहुभ्यां यत्समेत इति श्रुतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2019672, "chapter_id": 1408, "verse_number": "३-४६-४०", "content_sanskrit": "प्रत्यक्षं सर्वलोकस्य खाण्डवे यत्कृतं पुरा।\nफल्गुनेन सहायार्थे वह्नेर्दामोदरेण च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2019673, "chapter_id": 1408, "verse_number": "३-४६-४१", "content_sanskrit": "सर्वथा न हि मे पुत्राः सहामात्याः सबान्धवाः।\nक्रुद्धे पार्थे च भीमे च वासुदेवे च सात्वते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2019674, "chapter_id": 1408, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि इन्द्रलोकाभिगमनपर्वणि षट्चत्वारिंशोऽध्यायः ॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]