[{"id": 2073251, "chapter_id": 2547, "verse_number": "१२-५२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2073252, "chapter_id": 2547, "verse_number": "१२-५२-१", "content_sanskrit": "ततः प्रविश्य भवनं प्रविश्ये मधुसूदनः।\nयाममात्रावशेषायां यामिन्यां प्रत्यबुध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2073253, "chapter_id": 2547, "verse_number": "१२-५२-२", "content_sanskrit": "स ध्यानपथमाविश्य सर्वज्ञानानि माधवः।\nअवलोक्य ततः पश्चाद्दध्यौ ब्रह्म सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2073254, "chapter_id": 2547, "verse_number": "१२-५२-३", "content_sanskrit": "सूताः स्तुतिपुराणज्ञा रक्तकण्ठाः सुशिक्षिताः।\nअस्तुवन्विश्वकर्माणं वासुदेवं प्रजापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2073255, "chapter_id": 2547, "verse_number": "१२-५२-४", "content_sanskrit": "पठन्ति पाणिस्वनिकास्तथा गायन्ति गायनाः।\nशङ्खानथ मृदङ्गांश्च प्रवाद्यन्ति सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2073256, "chapter_id": 2547, "verse_number": "१२-५२-५", "content_sanskrit": "वीणापणववेणूनां स्वनश्चातिमनोरमः।\nसहास इव विस्तीर्णः शुश्रुवे तस्य वेश्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2073257, "chapter_id": 2547, "verse_number": "१२-५२-६", "content_sanskrit": "ततो युधिष्ठिरस्यापि राज्ञो मङ्गलसंहिताः।\nउच्चेरुर्मधुरा वाचो गीतवादित्रबृंहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2073258, "chapter_id": 2547, "verse_number": "१२-५२-७", "content_sanskrit": "तत उत्थाय दाशार्हः स्नातः प्राञ्जलिरच्युतः।\nजप्त्वा गुह्यं महाबाहुरग्नीनाश्रित्य तस्थिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2073259, "chapter_id": 2547, "verse_number": "१२-५२-८", "content_sanskrit": "ततः सहस्रं विप्राणां चतुर्वेदविदां तथा।\nगवां सहस्रेणैकैकं वाचयामास माधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2073260, "chapter_id": 2547, "verse_number": "१२-५२-९", "content_sanskrit": "मङ्गलालम्भनं कृत्वा आत्मानमवलोक्य च।\nआदर्शे विमले कृष्णस्ततः सात्यकिमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2073261, "chapter_id": 2547, "verse_number": "१२-५२-१०", "content_sanskrit": "गच्छ शैनेय जानीहि गत्वा राजनिवेशनम्।\nअपि सञ्जो महातेजा भीष्मं द्रष्टुं युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2073262, "chapter_id": 2547, "verse_number": "१२-५२-११", "content_sanskrit": "ततः कृष्णस्य वचनात्सात्यंकिस्त्वरितो ययौ।\nउपगम्य च राजानं युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2073263, "chapter_id": 2547, "verse_number": "१२-५२-१२", "content_sanskrit": "युक्तो रथवरो राजन्वासुदेवस्य धीमतः।\nसमीपमापगेयस्य प्रयास्यति जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2073264, "chapter_id": 2547, "verse_number": "१२-५२-१३", "content_sanskrit": "भवत्प्रतीक्षः कृष्णोऽसौ धर्मराज महाद्युते।\nयदत्रानन्तरं कृत्यं तद्भवान्कर्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2073265, "chapter_id": 2547, "verse_number": "१२-५२-१४", "content_sanskrit": "एवमुक्तः प्रत्युवाच धर्मपुत्रो युधिष्ठिरः।\nयुज्यतां मे रथवरः फल्गुनाप्रतिमद्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2073266, "chapter_id": 2547, "verse_number": "१२-५२-१५", "content_sanskrit": "न सैनिकैश्च यातव्यं यास्यामो वयमेव हि।\nन च पीडयितव्यो मे भीष्मो धर्मभृतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2073267, "chapter_id": 2547, "verse_number": "१२-५२-१६", "content_sanskrit": "अतः पुरःसराश्चापि निवर्तन्तु धनञ्जय।\nअद्यप्रभृति गाङ्गेयः परं गुह्यं प्रवक्ष्यति।\nअतो नेच्छामि कौन्तेय पृथग्जनसमागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2073268, "chapter_id": 2547, "verse_number": "१२-५२-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2073269, "chapter_id": 2547, "verse_number": "१२-५२-१७", "content_sanskrit": "स तद्वाक्यमथाज्ञाय कुन्तीपुत्रो धनञ्जयः।\nयुक्तं रथवरं तस्मा आचचक्षे नरर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2073270, "chapter_id": 2547, "verse_number": "१२-५२-१८", "content_sanskrit": "ततो युधिष्ठिरो राजा यमौ भीमार्जुनावपि।\nभूतानीव समस्तानि ययुः कृष्णनिवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2073271, "chapter_id": 2547, "verse_number": "१२-५२-१९", "content_sanskrit": "आगच्छत्स्वथ कृष्णोऽपि पाण्डवेषु महात्मसु।\nशैनेयसहितो धीमान्रथमेवान्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2073272, "chapter_id": 2547, "verse_number": "१२-५२-२०", "content_sanskrit": "रथस्थाः संविदं कृत्वा सुखां पृष्ट्वा च शर्वरीम्।\nमेघघोषै रथवरैः प्रययुस्ते नरर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2073273, "chapter_id": 2547, "verse_number": "१२-५२-२१", "content_sanskrit": "बलाहकं मेघपुष्पं शैब्यं सुग्रीवमेवच।\nदारुकश्चोदयामास वासुदेवस्य वाजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2073274, "chapter_id": 2547, "verse_number": "१२-५२-२२", "content_sanskrit": "ते हया वासुदेवस्य दारुकेण प्रचोदिताः।\nगां खुराग्रैस्तथा राजँल्लिखन्तः प्रययुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2073275, "chapter_id": 2547, "verse_number": "१२-५२-२३", "content_sanskrit": "ते ग्रसन्त इवाकाशं वेगवन्तो महाबलाः।\nक्षेत्रं धर्मस्य कृत्स्नस्य कुरुक्षेत्रमवातरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2073276, "chapter_id": 2547, "verse_number": "१२-५२-२४", "content_sanskrit": "ततो ययुर्यत्र भीष्मः शरतल्पगतः प्रभुः।\nआस्ते महर्षिभिः सार्ध्रं ब्रह्मा देवगणैर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2073277, "chapter_id": 2547, "verse_number": "१२-५२-२५", "content_sanskrit": "ततोऽवतीर्य गोविन्दो रथात्स च युधिष्ठिरः।\nभीमो गाण्डीवधन्वा च यमौ सात्यकिरेव च।\nऋषीनभ्यर्चयामासुः करानुद्यम्य दक्षिणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2073278, "chapter_id": 2547, "verse_number": "१२-५२-२६", "content_sanskrit": "स तैः परिवृतो राजा नक्षत्रैरिव चन्द्रमाः।\nअभ्याजगाम गाङ्गेयं ब्रह्माणमिव वासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2073279, "chapter_id": 2547, "verse_number": "१२-५२-२७", "content_sanskrit": "शरतल्पे शयानं तमादित्यं पतितं यथा।\nस ददर्श महाबाहुं भयाच्चागतसाध्वसः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2073280, "chapter_id": 2547, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि द्विपञ्चाशोऽध्यायः॥ ५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]