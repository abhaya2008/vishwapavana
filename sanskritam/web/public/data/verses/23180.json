[{"id": 7003180000, "chapter_id": 23180, "verse_number": "४-११६-१", "content_sanskrit": "अथ षोडशाधिकशततमोऽध्यायः ।\nबाण उवाच ।\nअनिरुद्ध बुधोऽसि त्वं त्वयोक्तं सत्यमेव च ।\nशंभुना चैवमुक्तं च सर्वं बुद्धं स्वचेतसा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003180001, "chapter_id": 23180, "verse_number": "४-११६-२", "content_sanskrit": "त्वयोक्तं शंकरवरात्पञ्चानां स्वामिनां प्रिया ।\nद्रौपदी च महाभागा तन्मे व्याख्यातुमर्हसि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003180002, "chapter_id": 23180, "verse_number": "४-११६-३", "content_sanskrit": "शम्बरेण हृता पूर्व तव माता कथं रतिः ।\nदेवैरपि कथं दत्ता देवास्तेन जिता कथम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003180003, "chapter_id": 23180, "verse_number": "४-११६-४", "content_sanskrit": "अनिरुद्ध उवाच ।\nएकदा रघुनाथश्च सीतया लक्ष्मणो च ।\nस्नातः सरसि तत्रस्थो रम्ये पञ्चवटीतटे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003180004, "chapter_id": 23180, "verse_number": "४-११६-५", "content_sanskrit": "उवाच सीता हेमन्ते जलं सुस्वादु निर्मलम् ।\nतथाऽन्नं व्यञ्जनं रम्यं सर्वं वस्तु सुशीतलम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003180005, "chapter_id": 23180, "verse_number": "४-११६-६", "content_sanskrit": "फलावबचयनं चक्रे सीतायै प्रददौ मुदा ।\nततो ददौ लक्ष्मणाय पश्चाद्भङ्क्ते स्वयं प्रभुः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003180006, "chapter_id": 23180, "verse_number": "४-११६-७", "content_sanskrit": "लक्ष्मणस्तद्गृहीत्वा च नैव भुङ्क्ते फलं जलम् ।\nमेघनादवधार्थं च सीतोद्धारणकारणात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003180007, "chapter_id": 23180, "verse_number": "४-११६-८", "content_sanskrit": "निद्रां न याति नो भुङ्क्ते वर्षाणां च चतुर्दश ।\nय एवं पुरुषो योगी तद्वध्यो रावणत्मजः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003180008, "chapter_id": 23180, "verse_number": "४-११६-९", "content_sanskrit": "एतस्मिन्नन्तरे रामं द्रष्टुं कमललोचनम् ।\nवहनिस्तत्र समायातो द्विजरूपी कृपानिधिः ।\nभविष्यत्कथयामाम श्रुतिकौटपरं वचः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003180009, "chapter_id": 23180, "verse_number": "४-११६-१०", "content_sanskrit": "वह्निरुवाच ।\nशृणु राम महाभाग सीतासंगोपनं कुरु ।\nसप्ताहाभ्यन्तरे चैव रावणो दुष्टराक्षसः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003180010, "chapter_id": 23180, "verse_number": "४-११६-११", "content_sanskrit": "दुर्निवार्यः प्राक्तनेन जानकीं च हरिष्यति ।\nविधात्रा लिखितं कर्म प्राक्तंनं केन वार्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003180011, "chapter_id": 23180, "verse_number": "४-११६-१२", "content_sanskrit": "वेदैश्चतुर्भिः कथितं न च दैवात्परं वरम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003180012, "chapter_id": 23180, "verse_number": "४-११६-१३", "content_sanskrit": "राम उवाच ।\nसीतां गृहीत्वा त्वं गच्छ च्छायाऽत्रैव तु तिष्ठतु ।\nकलत्रवर्जनं कर्म सर्वेषां च जुगुप्सितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003180013, "chapter_id": 23180, "verse_number": "४-११६-१४", "content_sanskrit": "सीतां गृहीत्वा प्रययौ रुदतीं च हुताशनः ।\nसीतया सदृशी छाया तस्थौ श्रीरामसंनिधौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003180014, "chapter_id": 23180, "verse_number": "४-११६-१५", "content_sanskrit": "सा च च्छाया हृता पूर्व रावणेनावलीलया ।\nसमुद्दधार तां रामो निहत्य तं सबान्धवम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003180015, "chapter_id": 23180, "verse_number": "४-११६-१६", "content_sanskrit": "वह्नौ परीक्षाकाले च च्छाया वह्नौ विवेश सा ।\nअग्निश्छायां च संरक्ष्य ददौ रामाय जानकीम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003180016, "chapter_id": 23180, "verse_number": "४-११६-१७", "content_sanskrit": "रामस्तां च गृहीत्वा च प्रययौ स्वाश्रमं मुदा ।\nछाया तस्थौ वह्निपार्श्वे हृदयेन विदूयता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003180017, "chapter_id": 23180, "verse_number": "४-११६-१८", "content_sanskrit": "सा च च्छाया तपश्चक्रे नारायणसरोवरे ।\nतपश्चकार दिव्यं च शातवर्षं च शूलिनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003180018, "chapter_id": 23180, "verse_number": "४-११६-१९", "content_sanskrit": "वरं वृणुष्व भद्रे त्वमुवाच शंकरश्च ताम् ।\nउवाच शिवं व्यग्रा भर्तुर्दुःखेन दुःखिता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003180019, "chapter_id": 23180, "verse_number": "४-११६-२०", "content_sanskrit": "पतिं देहि पञ्चधा सा वरं वव्रे त्रिलोचनम् ।\nसर्वसंपत्प्रदस्तुष्टस्तस्यै शर्वो वरं ददौ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003180020, "chapter_id": 23180, "verse_number": "४-११६-२१", "content_sanskrit": "महादेव उवाच ।\nसाध्वि त्वं पञ्चधा ब्रूहि पतिं देहीति व्याकुला ।\nपञ्चेन्द्राश्च हरेरंशा भविष्यन्ति प्रियास्तव ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003180021, "chapter_id": 23180, "verse_number": "४-११६-२२", "content_sanskrit": "ते च सर्वे च पञ्चेन्द्राश्चाधुना पञ्च पाण्डवाः ।\nसा च च्छाया द्रौपदी च यज्ञकुण्डसमुद्भवा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003180022, "chapter_id": 23180, "verse_number": "४-११६-२३", "content_sanskrit": "कृतयुगे वेदवती त्रेतायां जनकात्मजा ।\nद्वापरे द्रौपदी छाया तेन कृष्णा त्रिहायणी ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003180023, "chapter_id": 23180, "verse_number": "४-११६-२४", "content_sanskrit": "वैष्णपी कृष्णभक्ता च तेन कृष्णा प्रकीर्तिता ।\nस्वर्गलक्ष्मीर्महेन्द्राणां सा च पश्चाद्भविष्यति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003180024, "chapter_id": 23180, "verse_number": "४-११६-२५", "content_sanskrit": "राजा ददौ फाल्गुनाय कन्यायाश्च स्वयंवरे ।\nपप्रच्छ मातरं वीरो वस्तु प्राप्तं मयाऽधुना ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003180025, "chapter_id": 23180, "verse_number": "४-११६-२६", "content_sanskrit": "तमुवाच स्वयं माता गृहाण भ्रातृभिः सह ।\nशंभोर्वरेण पूर्व च परत्र मातुराज्ञया ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003180026, "chapter_id": 23180, "verse_number": "४-११६-२७", "content_sanskrit": "द्रौपद्याः स्वामिनस्तेन हेतुना पञ्च पाण्डवाः ।\nचतुर्दशानामिन्द्राणां पञ्चेन्द्राः पञ्च पाण्डवाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003180027, "chapter_id": 23180, "verse_number": "४-११६-२८", "content_sanskrit": "शंकरेणाभिसंशप्ता सा मात्रा भर्त्सितेन च ।\nभर्ताते भस्मसाद्भूतो हरकोपानलेन च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003180028, "chapter_id": 23180, "verse_number": "४-११६-२९", "content_sanskrit": "हे रति त्वं मया शप्ता दैत्यग्रस्ता भवाधुना ।\nविजित्यदेवान्सेन्द्राश्च शम्बरस्त्वा हरिष्यति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003180029, "chapter_id": 23180, "verse_number": "४-११६-३०", "content_sanskrit": "पुनरुवतं वरं प्रादात्सतीत्वां ते न यास्यति ।\nछायां दत्त्वा तिष्ठ गेहे यावज्जीवति ते पतिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003180030, "chapter_id": 23180, "verse_number": "४-११६-३१", "content_sanskrit": "इति ते कथितं सर्वमितिहासं पुरातनम् ।\nदेवानां गुप्तचरितं श्रृणु दैत्येन्द्र सांप्रतम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003180031, "chapter_id": 23180, "verse_number": "४-११६-३२", "content_sanskrit": "एतस्मिन्नन्तरे तत्र सुभद्रश्च महाबलः ।\nकुम्भाण्डभ्राता बलवान्बाणसेनापतीश्वरः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003180032, "chapter_id": 23180, "verse_number": "४-११६-३३", "content_sanskrit": "निर्भत्सर्य बाणं समरे शस्त्रपाणिर्महारथः ।\nश्रीकृष्णपौत्रं शूलं च चिक्षेप प्रलयाग्निवत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003180033, "chapter_id": 23180, "verse_number": "४-११६-३४", "content_sanskrit": "अर्धयन्द्रेण तच्छूलं चिच्छेद कामपुत्रकः ।\nशक्तिं चिक्षेप भद्रश्च शतसूर्यसमप्रभाम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003180034, "chapter_id": 23180, "verse_number": "४-११६-३५", "content_sanskrit": "वैष्णवास्त्रेण चिच्छेद तां शक्तिं कामपुत्रकः ।\nनारायणास्त्रं चिक्षेप सुभद्रो रणमूर्धनि ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003180035, "chapter_id": 23180, "verse_number": "४-११६-३६", "content_sanskrit": "प्रणम्य शेते निर्भीतो मदनस्य सुतो बली ।\nऊर्ध्वमस्त्रं च बभ्राम शतसूर्यसमप्रभम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003180036, "chapter_id": 23180, "verse_number": "४-११६-३७", "content_sanskrit": "प्रलीनमस्त्रमाकाशे विश्वसंहारकारणम् ।\nअस्त्रे गते सोऽनिरुद्धो गृहीत्वा च महानसिम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003180037, "chapter_id": 23180, "verse_number": "४-११६-३८", "content_sanskrit": "प्रबभञ्जभद्ररथं जघानाश्वांश्च सारथिम् ।\nजघान तं सुभद्रं च लीलया रणमूर्धनि ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003180038, "chapter_id": 23180, "verse_number": "४-११६-३९", "content_sanskrit": "हते सुभद्रे बाणश्च महाबलपराक्रमः ।\nवाणानां शतकं चापि चक्षेप रणमूर्धनि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003180039, "chapter_id": 23180, "verse_number": "४-११६-४०", "content_sanskrit": "कामात्मजोऽग्निबाणेन बाणोधं प्रददाह सः ।\nबाणश्चिक्षेप ब्रह्मास्त्रं सृष्टिसंहारकारणम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003180040, "chapter_id": 23180, "verse_number": "४-११६-४१", "content_sanskrit": "दृष्ट्वा कामात्मजः शीघ्रं सबीजं मन्त्रपूर्वकम् ।\nब्रह्मस्त्रेणैव सहसा संजहारावलीलया ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003180041, "chapter_id": 23180, "verse_number": "४-११६-४२", "content_sanskrit": "बाणः पाशुपतं क्षेप्तुं समारेभे च कोपतः ।\nनिषिद्धश्च गणेशेन स्कन्देन शंभुना तथा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003180042, "chapter_id": 23180, "verse_number": "४-११६-४३", "content_sanskrit": "तद्दृष्ट्वा सोऽनिरुद्धस्तं धनुर्बाणौघ संयुतम् ।\nमुमोच जृम्भणे युद्धे शीघ्रं तं च महारथम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003180043, "chapter_id": 23180, "verse_number": "४-११६-४४", "content_sanskrit": "जडो बभूव बाणश्च निश्चेष्टो रणमूर्धनि ।\nपुनश्चिक्षेप निद्रास्यं निद्रितं तं चकार सः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003180044, "chapter_id": 23180, "verse_number": "४-११६-४५", "content_sanskrit": "बाणं तं निद्रितं दृष्ट्वा गृहीत्वा खड्गमुत्तमम् ।\nबाणं हन्तुं समुद्यन्तं वारयामास कार्तिकः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003180045, "chapter_id": 23180, "verse_number": "४-११६-४६", "content_sanskrit": "स्कन्दश्च शतबाणौश्च वारयामास लीलया ।\nअनिरुद्धं महाभागं बलवान्तं धनुर्धरम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003180046, "chapter_id": 23180, "verse_number": "४-११६-४७", "content_sanskrit": "अनिरुद्धश्च सहसा तथा शक्त्या दुरत्यया ।\nबभञ्ज कार्तिकरथं रत्नेन्द्रसारनिर्मितम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003180047, "chapter_id": 23180, "verse_number": "४-११६-४८", "content_sanskrit": "गदया कार्तिकः क्रुद्धोऽप्यनिरुद्धरयं मुदा ।\nबभञ्ज लीलया तत्र क्षणेन रणमूर्धनि ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003180048, "chapter_id": 23180, "verse_number": "४-११६-४९", "content_sanskrit": "अनिरुद्धोऽर्धचन्द्रेण क्षुरधारेण लीलया ।\nचिच्छेद कार्तिकधनुर्भल्लास्त्रेण नियोजितम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003180049, "chapter_id": 23180, "verse_number": "४-११६-५०", "content_sanskrit": "जधान कार्तिकस्तं च गदया च दुरन्तया ।\nगदां जग्राह तद्धस्ताज्जवेन मदनात्मजः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003180050, "chapter_id": 23180, "verse_number": "४-११६-५१", "content_sanskrit": "शूलं गृहीत्वा स्कन्दं च तमेव हन्तुमु द्यतम् ।\nअनिरुद्धश्च कोपेन प्रेरयामास दूरतः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003180051, "chapter_id": 23180, "verse_number": "४-११६-५२", "content_sanskrit": "कार्तिकः पुनरागत्य गृहीत्वा कामपुत्रकम् ।\nगृहीत्वा च करेणैव पातयामास भूतले ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003180052, "chapter_id": 23180, "verse_number": "४-११६-५३", "content_sanskrit": "अनिरुद्धो गृहीत्वाऽसिं प्रभुस्तस्थौ महाबलः ।\nतयोर्विरोधं दूरं च प्रचकार गणेश्वरः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003180053, "chapter_id": 23180, "verse_number": "४-११६-५४", "content_sanskrit": "कार्तिकः प्रययौ गेहमूषागेहं स्मरात्मजः ।\nसर्व निवेदितुं शंभुं प्रययौ स गणेश्वरः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]