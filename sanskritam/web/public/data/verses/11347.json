[{"id": 50006346, "chapter_id": 11347, "verse_number": "1", "content_sanskrit": "[न्यायमाला (अनुव्याख्याने ३-२-१-४)- पश्चाददृष्ट्यविज्ञानकालदुःखपृथग्भवाः। स्थानभेदो विरुद्धत्वं न्यायसाम्यं स्वतो भवः॥ गुणसाम्यमयोगश्च तर्कबाधो विलोमता। नानाभावः प्रलोभश्च युक्तयः पूर्वपक्षगाः॥ अशक्यकर्तृताशक्तिः स्वतोऽबोधस्तदेव च। अमानकॢप्तिसन्मानव्यवस्थात्यल्पताभवाः॥ विशेषदृष्टिवाक्ये च पुंशक्तिः सुनिर्दशनम्। अलौकिकत्वमाधिक्यं स्वातन्त्र्यं निर्णयप्रमाः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006347, "chapter_id": 11347, "verse_number": "2", "content_sanskrit": "॥ ॐ सन्ध्ये सृष्टिराह हि ॐ॥ पश्चाददृष्टिः। अशक्यकर्तृताशक्तिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006348, "chapter_id": 11347, "verse_number": "3", "content_sanskrit": "॥ ॐ पराभिध्यानात् तु तिरोहितं ततो ह्यस्य बन्धविपर्ययौ ॐ॥ अविज्ञानम्। स्वतोऽबोधः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50006349, "chapter_id": 11347, "verse_number": "4", "content_sanskrit": "॥ ॐ देहयोगाद् वासोऽपि ॐ॥ कालः। तदेव ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50006350, "chapter_id": 11347, "verse_number": "5", "content_sanskrit": "॥ ॐ तदभावो नाडीषु तच्छ्रुतेरात्मनि ह ॐ॥ दुःखम्। अमानकॢप्तिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50006351, "chapter_id": 11347, "verse_number": "6", "content_sanskrit": "॥ ॐ अतः प्रबोधोऽस्मात् ॐ॥ पृथग्भावः। सन्मानम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50006352, "chapter_id": 11347, "verse_number": "7", "content_sanskrit": "॥ ॐ स एव च कर्मानुस्मृतिशब्दविधिभ्यः ॐ॥ पृथग्भावः। सन्मानम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50006353, "chapter_id": 11347, "verse_number": "8", "content_sanskrit": "॥ ॐ मुग्धेऽर्धसम्पत्तिः परिशेषात् ॐ॥ पृथग्भावः। सन्मानम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50006354, "chapter_id": 11347, "verse_number": "9", "content_sanskrit": "॥ ॐ न स्थानतोऽपि परस्योभयलिङ्गं सर्वत्र हि ॐ॥ स्थानभेदः। व्यवस्था॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50006355, "chapter_id": 11347, "verse_number": "10", "content_sanskrit": "॥ ॐ अरूपवदेव हि तत्प्रधानत्वात् ॐ॥ विरुद्धत्वम्। व्यवस्था॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50006356, "chapter_id": 11347, "verse_number": "11", "content_sanskrit": "॥ ॐ अत एव चोपमा सूर्यकादिवत् ॐ॥ न्यायसम्यम्। अत्यल्पता॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50006357, "chapter_id": 11347, "verse_number": "12", "content_sanskrit": "॥ ॐ अम्बुवदग्रहणात् तु न तथात्वम् ॐ॥ स्वतो भवः। भवः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50006358, "chapter_id": 11347, "verse_number": "13", "content_sanskrit": "॥ ॐ वृद्धिह्रासभाक्त्वमन्तर्भावादुभयसामञ्जस्यादेवम् ॐ॥ गुणसाम्यम्। विशेषदृष्टिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50006359, "chapter_id": 11347, "verse_number": "14", "content_sanskrit": "॥ ॐ प्रकृतैतावत्त्वं हि प्रतिषेधति ततो ब्रवीति च भूयः ॐ॥ अयोगः। विशेषवाक्यं च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "displa