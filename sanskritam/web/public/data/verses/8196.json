[{"id": 900000927, "chapter_id": 8196, "verse_number": "4.1", "content_sanskrit": "अन्यच्छ्रेयोऽन्यदुतेव प्रेयस्ते उभे नानार्थे पुरुषं सिनीतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900000928, "chapter_id": 8196, "verse_number": "4.2", "content_sanskrit": "श्रेयश्व प्रेयश्च मनुष्यमेतस्तौ सम्परीत्य विविनक्ति धीरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900000929, "chapter_id": 8196, "verse_number": "4.3", "content_sanskrit": "स त्वं प्रियान् प्रियरूपांश्च कामान् अभिध्यायन् नचिकेतोऽत्यस्राक्षीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900000930, "chapter_id": 8196, "verse_number": "4.4", "content_sanskrit": "दूरमेते विपरीते विषूची अविद्या या च विद्येति ज्ञाता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900000931, "chapter_id": 8196, "verse_number": "4.5", "content_sanskrit": "अविद्यायामन्तरे वर्तमानाः स्वयं धीराः पण्डितंमन्यमानाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900000932, "chapter_id": 8196, "verse_number": "4.6", "content_sanskrit": "न साम्परायः प्रतिभाति बालं प्रमाद्यन्तं वित्तमोहेन मूढम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900000933, "chapter_id": 8196, "verse_number": "4.7", "content_sanskrit": "श्रवणायापि बहुभिर्यो न लभ्यः शृण्वन्तोऽपि बहवो यं न विद्युः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900000934, "chapter_id": 8196, "verse_number": "4.8", "content_sanskrit": "न नरेणावरः प्रोक्त एष सुज्ञेयो बहुधा चिन्त्यमानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900000935, "chapter_id": 8196, "verse_number": "4.9", "content_sanskrit": "नैषा तर्केण मतिरापनेया प्रोक्ताऽन्येनैव सुज्ञानाय प्रेष्ठ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900000936, "chapter_id": 8196, "verse_number": "4.10", "content_sanskrit": "जानाम्यहं शेवधिरित्यनित्यं न ह्यध्रुवैः प्राप्यते हि ध्रुवं तत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900000937, "chapter_id": 8196, "verse_number": "4.11", "content_sanskrit": "कामस्याsप्तिं जगतः प्रतिष्ठां क्रतोरानन्त्य- मभयस्य पारम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900000938, "chapter_id": 8196, "verse_number": "4.12", "content_sanskrit": "तं दुर्दर्शं गूढमनुप्रविष्टं गुहाहितं गह्वरेष्ठं पुराणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900000939, "chapter_id": 8196, "verse_number": "4.13", "content_sanskrit": "एतत् श्रुत्वा सम्परिगृह्य मर्त्यः प्रवृह्य धर्म्यमणुमेनमाप्य", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900000940, "chapter_id": 8196, "verse_number": "4.14", "content_sanskrit": "अन्यत्र धर्मादन्यत्राधर्मादन्यत्रास्मात् कृताकृतात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900000941, "chapter_id": 8196, "verse_number": "4.15", "content_sanskrit": "सर्वे वेदा यत् पदमामनन्ति तपांसि सर्वाणि च यद् वदन्ति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900000942, "chapter_id": 8196, "verse_number": "4.16", "content_sanskrit": "एतद्ध्येवाक्षरं ब्रह्म एतद्ध्येवाक्षरं परम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900000943, "chapter_id": 8196, "verse_number": "4.17", "content_sanskrit": "एतद्ध्येवाक्षरं ब्रह्म एतद्ध्येवाक्षरं परम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900000944, "chapter_id": 8196, "verse_number": "4.18", "content_sanskrit": "न जायते म्रियते वा विपश्चिन्नायं कुतश्चिन्न बभूव कश्चित्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900000945, "chapter_id": 8196, "verse_number": "4.19", "content_sanskrit": "हन्ता चेन्मन्यते हन्तुं हतचेन्मन्यते हतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900000946, "chapter_id": 8196, "verse_number": "4.20", "content_sanskrit": "अणोरणीयान् महतो महीयान् आत्माऽस्य जन्तोर्निहितो गुहायाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900000947, "chapter_id": 8196, "verse_number": "4.21", "content_sanskrit": "आसीनो दूरं व्रजति शयानो याति सर्वतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900000948, "chapter_id": 8196, "verse_number": "4.22", "content_sanskrit": "अशरीरं शरीरेष्वनवस्थेष्ववस्थितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900000949, "chapter_id": 8196, "verse_number": "4.23", "content_sanskrit": "नायमात्मा प्रवचनेन लभ्यो न मेधया न बहुना श्रुतेन", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900000950, "chapter_id": 8196, "verse_number": "4.24", "content_sanskrit": "नाविरतो दुश्चरितान्नाशान्तो नासमाहितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900000951, "chapter_id": 8196, "verse_number": "4.25", "content_sanskrit": "'यस्य ब्रह्म च क्षत्रं चोभे भवत ओदनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]