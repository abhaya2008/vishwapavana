[{"id": 2085254, "chapter_id": 2815, "verse_number": "१२-३२०-०x", "content_sanskrit": "याज्ञवल्क्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085255, "chapter_id": 2815, "verse_number": "१२-३२०-१", "content_sanskrit": "न शक्यो निर्गुणस्तात गुणीकर्तुं विशांपते।\nगुणवांश्चाप्यगुणवान्यथातत्त्वं निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085256, "chapter_id": 2815, "verse_number": "१२-३२०-२", "content_sanskrit": "गुणैर्हि गुणवानेव निर्गुणश्चागुणस्तथा।\nप्राहुरेवं महात्मानो मुनयस्तत्त्वदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085257, "chapter_id": 2815, "verse_number": "१२-३२०-३", "content_sanskrit": "गुणस्वभावस्त्वव्यक्तो गुणानेवाभिवर्तते।\nउपयुङ्क्ते च तानेव स चैवाज्ञः स्वभावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085258, "chapter_id": 2815, "verse_number": "१२-३२०-४", "content_sanskrit": "अव्यक्तस्तु न जानीते पुरुषोऽज्ञः स्वभावतः।\nन मत्तः परमोस्तीति नित्यमेवाभिमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085259, "chapter_id": 2815, "verse_number": "१२-३२०-५", "content_sanskrit": "अनेन कारणेनैतदव्यक्तं स्यादचेतनम्।\nनित्यत्वाच्चाक्षरत्वाच्च क्षरत्वान्न तदन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085260, "chapter_id": 2815, "verse_number": "१२-३२०-६", "content_sanskrit": "यदाऽज्ञानेन कुर्वीत गुणसर्गं पुनःपुनः।\nयदात्मानं न जानीते तदाऽऽत्मापि न मुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085261, "chapter_id": 2815, "verse_number": "१२-३२०-७", "content_sanskrit": "कर्तृत्वाच्चापि सर्गाणां सर्गधर्मा तथोच्यते।\nकर्तृत्वाच्चापि योगानां योगधर्मा तथोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085262, "chapter_id": 2815, "verse_number": "१२-३२०-८", "content_sanskrit": "कर्तृत्वात्प्रकृतीनां च तथा प्रकृतिधर्मिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085263, "chapter_id": 2815, "verse_number": "१२-३२०-९", "content_sanskrit": "कर्तृत्वाच्चापि वीजानां बीजधर्मा तथोच्यते।\nगुणानां प्रसवत्वाच्च प्रलयत्वात्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085264, "chapter_id": 2815, "verse_number": "१२-३२०-१०", "content_sanskrit": "`कर्तृत्वात्प्रलयानां तु तथा प्रलयधर्मि च।\nकर्तृत्वात्प्रभवाणां च तथा प्रभवधर्मि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085265, "chapter_id": 2815, "verse_number": "१२-३२०-११", "content_sanskrit": "बीजत्वात्प्रकृतित्वाच्च प्रलयत्वात्तथैव च।\nउपेक्षत्वादनन्यत्वादभिमानाच्च केवलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085266, "chapter_id": 2815, "verse_number": "१२-३२०-१२", "content_sanskrit": "मन्यन्ते यतयः सिद्धा अध्यात्मज्ञा गतज्वराः।\nअनित्यं नित्यमव्यक्तं व्यक्तमेतद्धि शुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085267, "chapter_id": 2815, "verse_number": "१२-३२०-१३", "content_sanskrit": "अव्यक्तैकत्वमित्याहुर्नानात्वं पुरुषास्तथा।\nसर्वभूतदयावन्तः केवलं ज्ञानमास्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085268, "chapter_id": 2815, "verse_number": "१२-३२०-१४", "content_sanskrit": "अन्यः स पुरुषोऽव्यक्तस्त्वध्रुवो ध्रुवसंज्ञकः।\nयथा मुञ्ज इषीकाणां तथैवैतद्धि जायते।\n`न चैव मुञ्जसंयोगादिषीका तत्र बुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085269, "chapter_id": 2815, "verse_number": "१२-३२०-१५", "content_sanskrit": "अन्यच्च मशकं विद्यादन्यच्चोदुम्बरं तथा।\nच चोदुम्बरसंयोगैर्मशकस्तत्र लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085270, "chapter_id": 2815, "verse_number": "१२-३२०-१६", "content_sanskrit": "अन्य एव तथा मत्स्यस्तदन्यदुदुकं स्मृतम्।\nन चोदकस्य स्पर्शेन मत्स्यो लिप्यति सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085271, "chapter_id": 2815, "verse_number": "१२-३२०-१७", "content_sanskrit": "अन्यो ह्यग्निरुखाऽप्यन्या नित्यमेवमवेहि भोः।\nन चोपलिप्यते सोऽग्निरुखासंस्पर्शनेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085272, "chapter_id": 2815, "verse_number": "१२-३२०-१८", "content_sanskrit": "पुष्करं त्वन्यदेवात्र तथाऽन्यदुदकं स्मृतम्।\nन चोदकस्य स्पर्शेन लिप्यते तत्र पुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2085273, "chapter_id": 2815, "verse_number": "१२-३२०-१९", "content_sanskrit": "एतेषां सहवासं च निवासं चैव नित्यशः।\nयाथातथ्येन पश्यन्ति न नित्यं प्राकृता जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2085274, "chapter_id": 2815, "verse_number": "१२-३२०-२०", "content_sanskrit": "ये त्वन्यथैव पश्यन्ति न सम्यक्तेषु दर्शनम्।\nते व्यक्तं निरयं घोरं प्रविशन्ति पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2085275, "chapter_id": 2815, "verse_number": "१२-३२०-२१", "content_sanskrit": "साङ्ख्यदर्शनमेतत्ते परिसङ्ख्यानमुत्तमम्।\nएवं हि परिसंख्याय साङ्ख्याः केवलतां गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2085276, "chapter_id": 2815, "verse_number": "१२-३२०-२२", "content_sanskrit": "ये त्वन्ये तत्त्वकुशलास्तेषामेतन्निदर्शनम्।\nअतः परं प्रवक्ष्यामि योगानामनुदर्शनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2085277, "chapter_id": 2815, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि विंशत्यधिकत्रिशततमोऽध्यायः॥ ३२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]