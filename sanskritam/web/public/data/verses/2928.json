[{"id": 2090670, "chapter_id": 2928, "verse_number": "१३-५८-१", "content_sanskrit": "मार्कण्डेय उवाच।\nश्रुतं नराणां चापल्यं परस्त्रीषु प्रजायताम्।\nप्रमदानां तु चापल्ये दोषमिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2090671, "chapter_id": 2928, "verse_number": "१३-५८-२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2090672, "chapter_id": 2928, "verse_number": "१३-५८-२", "content_sanskrit": "एकवर्णे विदोषं तु गमनं पूर्वकालिकम्।\nधाता च समनुज्ञातो विष्णुना तत्तथाऽकरोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2090673, "chapter_id": 2928, "verse_number": "१३-५८-३", "content_sanskrit": "भगलिङ्गे महाप्राज्ञ पूर्वमेव प्रजापतिः।\nससर्ज ताभ्यां संयोगमनुज्ञातश्चकार सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2090674, "chapter_id": 2928, "verse_number": "१३-५८-४", "content_sanskrit": "अथ विष्णुप्रसादेन भगो दत्तवरः किल।\nतेन चैव प्रसादेन सर्वांल्लोकानुपाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2090675, "chapter_id": 2928, "verse_number": "१३-५८-५", "content_sanskrit": "तस्मात्तु पुरुषे दोषो ह्यधिको नात्र संशयः।\nविना गर्भं सवर्णेषु न त्याज्या गमनात्स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2090676, "chapter_id": 2928, "verse_number": "१३-५८-६", "content_sanskrit": "प्रायश्चित्तं यथान्यायं दण्डं कुर्यात्स पण्डितः।\nश्वभिर्वा दंशनं स्नानं सवनत्रितयं निशि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2090677, "chapter_id": 2928, "verse_number": "१३-५८-७", "content_sanskrit": "भूमौ च भस्मशयनं दानं भोगविवर्जितम्।\nदोषगौरवतः कालो द्रव्यगौरवमेव च।\nमर्यादा स्थापिता पूर्वमिति तीर्थान्तरं गते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2090678, "chapter_id": 2928, "verse_number": "१३-५८-८", "content_sanskrit": "तद्योषितीं तु दीर्घायो नास्ति दोषो व्यतिक्रमे।\nभगतीर्थान्तरे शुद्धो विष्णोस्तु वचनादिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2090679, "chapter_id": 2928, "verse_number": "१३-५८-९", "content_sanskrit": "रक्ष्याश्चैवान्यसंवादैरन्यगेहाद्विचक्षणैः।\nआसां शुद्धौ विशेषेण कर्मणां फलमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2090680, "chapter_id": 2928, "verse_number": "१३-५८-१०", "content_sanskrit": "नैता वाच्या न वै वध्या न क्लेश्याः शुभमिच्छता।\nविष्णुप्रसादादित्येव भगस्तीर्थान्तरं गतः।\nमासिमासि ऋतुस्तासां दुष्कृतान्यपकर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2090681, "chapter_id": 2928, "verse_number": "१३-५८-११", "content_sanskrit": "स्त्रियस्तोषकरा नॄणां स्त्रियः पुष्टिप्रदाः सदा।\nपुत्रसेतुप्रतिष्ठाश्च स्त्रियो लोके महाद्युते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2090682, "chapter_id": 2928, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टपञ्चाशोऽध्यायः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]