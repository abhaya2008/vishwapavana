[{"id": 7000306000, "chapter_id": 20306, "verse_number": "१-६०-१", "content_sanskrit": "स्कंदौवाच ।\nअपरस्यापि पृच्छामि फलस्य पूततां तरोः ।\nसर्वलोकहितार्थाय वद नो जगदीश्वर॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000306001, "chapter_id": 20306, "verse_number": "१-६०-२", "content_sanskrit": "ईश्वर उवाच ।\nधात्रीफलं परं पूतं सर्वलोकेषु विश्रुतम् ।\nयस्य रोपान्नरो नारी मुच्यते जन्मबंधनात्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000306002, "chapter_id": 20306, "verse_number": "१-६०-३", "content_sanskrit": "पावनं वासुदेवस्य फलं प्रीतिकरं शुभम् ।\nअस्य भक्षणमात्रेण मुच्यते सर्वकल्मषात्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000306003, "chapter_id": 20306, "verse_number": "१-६०-४", "content_sanskrit": "भक्षणे च भवेदायुः पाने वै धर्मसंचयः ।\nअलक्ष्मीनाशनं स्नाने सर्वैश्वर्यमवाप्नुयात्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000306004, "chapter_id": 20306, "verse_number": "१-६०-५", "content_sanskrit": "यस्मिन्गृहे महासेन धात्री तिष्ठति सर्वदा ।\nतस्मिन्गृहे न गच्छंति प्रेता दैतेय राक्षसाः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000306005, "chapter_id": 20306, "verse_number": "१-६०-६", "content_sanskrit": "न गंगा न गया चैव न काशी न च पुष्करम् ।\nएकैव हि नृणां धात्री संप्राप्ते हरिवासरे॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000306006, "chapter_id": 20306, "verse_number": "१-६०-७", "content_sanskrit": "एकादश्यां पक्षयुगे धात्रीस्नानं करोति यः ।\nसर्वपापक्षयं यांति विष्णुलोके महीयते॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000306007, "chapter_id": 20306, "verse_number": "१-६०-८", "content_sanskrit": "धात्रीफलं सदा सेव्यं भक्षणे स्नान एव च ।\nनियतं पारणे विष्णोः स्नानमात्रे हरेर्दिने॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000306008, "chapter_id": 20306, "verse_number": "१-६०-९", "content_sanskrit": "संयते पारणे चैव धात्र्येकस्पर्शने नरः ।\nभुक्त्वा तु लंघयेद्यस्तु एकादश्यां सितासिते॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000306009, "chapter_id": 20306, "verse_number": "१-६०-१०", "content_sanskrit": "एकेनैवोपवासेन कृतेन तु षडानन ।\nसप्तजन्मकृतात्पापान्मुच्यते नात्र संशयः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000306010, "chapter_id": 20306, "verse_number": "१-६०-११", "content_sanskrit": "अक्षयं लभते स्वर्गं विष्णुसायुज्यमाव्रजेत् ।\nतस्मात्सर्वप्रयत्नेन धात्रीव्रतं समाचर॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000306011, "chapter_id": 20306, "verse_number": "१-६०-१२", "content_sanskrit": "धात्रीद्रवेण सततं यस्य केशाः सुरंजिताः ।\nन पिबेत्स पुनर्मातुः स्तनं कश्चित्षडानन॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000306012, "chapter_id": 20306, "verse_number": "१-६०-१३", "content_sanskrit": "धात्रीदर्शनसंस्पर्शान्नाम्न उच्चारणेपि वा ।\nवरदः संमुखो विष्णुः संतुष्टो भवति प्रियः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000306013, "chapter_id": 20306, "verse_number": "१-६०-१४", "content_sanskrit": "धात्रीफलं च यत्रास्ते तत्र तिष्ठति केशवः ।\nतत्र ब्रह्मा स्थिरा पद्मा तस्मात्तां तु गृहे न्यसेत्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000306014, "chapter_id": 20306, "verse_number": "१-६०-१५", "content_sanskrit": "अलक्ष्मीर्नश्यते तत्र यत्र धात्री प्रतिष्ठति ।\nसंतुष्टास्सर्वदेवाश्च न त्यजंति क्षणं मुदा॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000306015, "chapter_id": 20306, "verse_number": "१-६०-१६", "content_sanskrit": "धात्रीफलेन नैवेद्यं यो ददाति महाधनम् ।\nतस्य तुष्टो भवेद्विष्णुर्नान्यैः क्रतुशतैरपि॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000306016, "chapter_id": 20306, "verse_number": "१-६०-१७", "content_sanskrit": "स्नात्वा धात्रीद्रवेणैव पूजयेद्यस्तु माधवम् ।\nसोभीष्टफलमाप्नोति यद्वा मनसि वर्तते॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000306017, "chapter_id": 20306, "verse_number": "१-६०-१८", "content_sanskrit": "तथैव लक्षणं स्मृत्वा पूजयित्वा फलेन तु ।\nसुवर्णशतसाहस्रं फलमेति नरोत्तमः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000306018, "chapter_id": 20306, "verse_number": "१-६०-१९", "content_sanskrit": "या गतिर्ज्ञानिनां स्कंद मुनीनां योगसेविनाम् ।\nगतिं तां समवाप्नोति धात्रीसेवा रतो नरः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000306019, "chapter_id": 20306, "verse_number": "१-६०-२०", "content_sanskrit": "तीर्थसेवाभिगमने व्रतैश्च विविधैस्तथा ।\nसा गतिर्लभ्यते पुंसां धात्रीफलसुसेवया॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000306020, "chapter_id": 20306, "verse_number": "१-६०-२१", "content_sanskrit": "प्रीतिश्च सर्वदेवानां देवीनां नो गणस्य च ।\nसंमुखा वरदा स्नाने धात्रीफलनिषेवणे॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000306021, "chapter_id": 20306, "verse_number": "१-६०-२२", "content_sanskrit": "ग्रहा दुष्टाश्च ये केचिदुग्राश्च दैत्यराक्षसाः ।\nसर्वे न दुष्टतां यांतिधात्रीफल सुसेवनात्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000306022, "chapter_id": 20306, "verse_number": "१-६०-२३", "content_sanskrit": "सर्वयज्ञेषु कार्येषु शस्तं चामलकीफलम् ।\nसर्वदेवस्य पूजायां वर्जयित्वा रविं सुत॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000306023, "chapter_id": 20306, "verse_number": "१-६०-२४", "content_sanskrit": "तस्माद्रविदिने तात सप्तम्यां च विशेषतः ।\nधात्रीफलानि सततं दूरतः परिवर्जयेत्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000306024, "chapter_id": 20306, "verse_number": "१-६०-२५", "content_sanskrit": "यस्तु स्नाति तथाश्नाति धात्रीं च रविवासरे ।\nआयुर्वित्तं कलत्रं च सर्वं तस्य विनश्यति॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000306025, "chapter_id": 20306, "verse_number": "१-६०-२६", "content_sanskrit": "संक्रान्तौ च भृगोर्वारे षष्ठ्यां प्रतिपिदि ध्रुवम् ।\nनवम्यां चाप्यमायां च धात्रीं दूरात्परित्यजेत्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000306026, "chapter_id": 20306, "verse_number": "१-६०-२७", "content_sanskrit": "नासिकाकर्णतुंडेषु मृतस्य चिकुरेषु वा ।\nतिष्ठेद्धात्रीफलं यस्य स याति विष्णुमंदिरम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000306027, "chapter_id": 20306, "verse_number": "१-६०-२८", "content_sanskrit": "धात्रीसंपर्कमात्रेण मृतो यात्यच्युतालयम् ।\nसर्वपापक्षयस्तस्य स्वर्गं याति रथेन तु॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000306028, "chapter_id": 20306, "verse_number": "१-६०-२९", "content_sanskrit": "धात्रीद्रवं नरो लिप्त्वा यस्तु स्नानं समाचरेत् ।\nपदेपदेश्वमेधस्य फलं प्राप्नोति धार्मिकः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000306029, "chapter_id": 20306, "verse_number": "१-६०-३०", "content_sanskrit": "अस्य दर्शनमात्रेण ये वै पापिष्ठजंतवः ।\nसर्वे ते प्रपलायंते ग्रहा दुष्टाश्च दारुणाः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000306030, "chapter_id": 20306, "verse_number": "१-६०-३१", "content_sanskrit": "पुरैकः पुल्कसः स्कंद मृगयार्थं वनं गतः ।\nमृगपक्षिगणान्हत्वा तृषया परिपीडितः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000306031, "chapter_id": 20306, "verse_number": "१-६०-३२", "content_sanskrit": "क्षुधयामलकीवृक्षं पुरः पीनफलान्वितम् ।\nदृष्ट्वा संरुह्य सहसा चखाद फलमुत्तमम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000306032, "chapter_id": 20306, "verse_number": "१-६०-३३", "content_sanskrit": "ततो दैवात्सवृक्षाग्रान्निपपात महीतले ।\nवेदनागाढसंविद्धः पंचत्वमगमत्तदा॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000306033, "chapter_id": 20306, "verse_number": "१-६०-३४", "content_sanskrit": "ततः प्रेतगणाः सर्वे रक्षोभूतगणास्तथा ।\nतनुं वोढुं मुदा सर्वे ये वै शमनसेवकाः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000306034, "chapter_id": 20306, "verse_number": "१-६०-३५", "content_sanskrit": "न शक्नुवंति चांडालं मृतं द्रष्टुं महाबलाः ।\nअन्योन्यं विग्रहस्तेषां ममायमिति भाषताम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000306035, "chapter_id": 20306, "verse_number": "१-६०-३६", "content_sanskrit": "ग्रहीतुं चापि नेतुं च न शक्तास्ते परस्परम् ।\nततस्ते तु समालोक्य गता मुनिगणान्प्रति॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000306036, "chapter_id": 20306, "verse_number": "१-६०-३७", "content_sanskrit": "प्रेता ऊचुः ।\nकिमर्थं मुनयो धीराश्चांडालं पापकारिणम् ।\nप्रेक्षितुं न वयं शक्ता न चापि यमसेवकाः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000306037, "chapter_id": 20306, "verse_number": "१-६०-३८", "content_sanskrit": "म्रियंते पातिता ये च स्थिरैर्युद्धपराङ्मुखाः ।\nसाहसैः पातिता भीता वज्राग्निकाष्ठपीडिताः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000306038, "chapter_id": 20306, "verse_number": "१-६०-३९", "content_sanskrit": "सिंहव्याघ्रहता मर्त्या व्याघ्रैर्वा जलजंतुभिः ।\nजलस्थलस्थिताः प्रेताः वृक्षपर्वतपातिताः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000306039, "chapter_id": 20306, "verse_number": "१-६०-४०", "content_sanskrit": "पशुपक्षिहता ये च कारागारे गरे मृताः ।\nआत्मघातमृता ये च श्राद्धादिकर्मवर्जिताः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000306040, "chapter_id": 20306, "verse_number": "१-६०-४१", "content_sanskrit": "गूढकर्ममृता धूर्ता गुरुविप्रनृपद्विषः ।\nपाषंडाः कौलिकाः क्रूरा गरदाः कूटसाक्षिणः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000306041, "chapter_id": 20306, "verse_number": "१-६०-४२", "content_sanskrit": "आशौचान्नस्य भोक्तारः प्रेतभोग्या न संशयः ।\nममायमिति भाषंतो नेतुं तं च न शक्नुमः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000306042, "chapter_id": 20306, "verse_number": "१-६०-४३", "content_sanskrit": "आदित्य इव दुष्प्रेक्ष्यः किंवा कस्य प्रभावतः ।\nमुनय ऊचुः ।\nअनेन भक्षितं प्रेताः पक्वं चामलकीफलम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000306043, "chapter_id": 20306, "verse_number": "१-६०-४४", "content_sanskrit": "तत्संगं यांति तस्यैव फलानि प्रचुराणि च ।\nतेनैव कारणेनायं दुष्प्रेक्ष्यो भवतां ध्रुवम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000306044, "chapter_id": 20306, "verse_number": "१-६०-४५", "content_sanskrit": "वृक्षाग्रपतितस्याथ प्राणः स्नेहान्न च त्यजेत् ।\nनायं चारेण सूर्यस्य न चान्ये पापकारिणः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000306045, "chapter_id": 20306, "verse_number": "१-६०-४६", "content_sanskrit": "धात्रीभक्षणमात्रेण पापात्पूतो व्रजेद्दिवम् ।\nप्रेता ऊचुः ।\nपृच्छामो वो ह्यविज्ञानान्न वयं निंदकाः क्वचित्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000306046, "chapter_id": 20306, "verse_number": "१-६०-४७", "content_sanskrit": "विष्णुलोकाद्विमानं तु यावन्नैवात्र गच्छति ।\nउच्यतां मुनिशार्दूला वो द्रुतं मनसि स्थितम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000306047, "chapter_id": 20306, "verse_number": "१-६०-४८", "content_sanskrit": "यावद्द्विजा न घोषंति वेदमंत्रादिकल्पितम् ।\nघोष्यंते यत्र वेदाश्च मंत्राणि विविधानि च॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000306048, "chapter_id": 20306, "verse_number": "१-६०-४९", "content_sanskrit": "पुराणस्मृतयो यत्र क्षणं स्थातुं न शक्नुमः ।\nयज्ञहोमजपस्थानदेवतार्चनकर्मणाम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000306049, "chapter_id": 20306, "verse_number": "१-६०-५०", "content_sanskrit": "पुरतो वै न तिष्ठामस्तस्माद्वृत्तं समुच्यताम् ।\nकिं वै कृत्वा प्रेतयोनिं लभंते हि नरा द्विजाः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000306050, "chapter_id": 20306, "verse_number": "१-६०-५१", "content_sanskrit": "श्रोतुमिच्छामहे सम्यक्कथं वै विकृतं वपुः ।\nद्विजा ऊचुः ।\nशीतवातातपक्लेशैः क्षुत्पिपासाविशेषकैः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000306051, "chapter_id": 20306, "verse_number": "१-६०-५२", "content_sanskrit": "अन्यैरपि च दुःखैर्ये पीडिताः कूटसाक्षिणः ।\nवधबंधप्रमीताश्च प्रेतास्ते निरयं गताः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000306052, "chapter_id": 20306, "verse_number": "१-६०-५३", "content_sanskrit": "छिद्रान्वेषपरा ये च द्विजानां कर्मघातिनः ।\nतथैव च गुरूणां च ते प्रेताश्चापुनर्भवाः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000306053, "chapter_id": 20306, "verse_number": "१-६०-५४", "content_sanskrit": "दीयमाने द्विजाग्र्ये तु दातारं प्रतिविध्यति ।\nचिरं प्रेतत्वमाश्रित्य नरकान्न निवर्तते॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000306054, "chapter_id": 20306, "verse_number": "१-६०-५५", "content_sanskrit": "परस्य वाऽत्मनो वा गां कृत्वा पीडनवाहने ।\nन पालयंति ये मूढास्ते प्रेताः कर्मजा भुवि॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000306055, "chapter_id": 20306, "verse_number": "१-६०-५६", "content_sanskrit": "हीनप्रतिज्ञाश्चासत्यास्तथा भग्नव्रता नराः ।\nनलिनीदलभुक्ताश्च ते प्रेताः कर्मजा भुवि॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000306056, "chapter_id": 20306, "verse_number": "१-६०-५७", "content_sanskrit": "विक्रीणन्ति सुतां शुद्धां स्त्रियं साध्वीमकंटकाम् ।\nपितृव्यमातुलादेश्च ते प्रेताः कर्मजा भुवि॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000306057, "chapter_id": 20306, "verse_number": "१-६०-५८", "content_sanskrit": "एते चान्ये च बहवः प्रेता जाताः स्वकर्मभिः ।\nप्रेता ऊचुः ।\nन भवंति कथं प्रेताः कर्मणा केन वा द्विजाः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000306058, "chapter_id": 20306, "verse_number": "१-६०-५९", "content_sanskrit": "हिताय वदनस्तूर्णं सर्वलोकहितं परम् ।\nद्विजा ऊचुः ।\nयेन चैव कृतं स्नानं जले तीर्थस्य धीमता॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000306059, "chapter_id": 20306, "verse_number": "१-६०-६०", "content_sanskrit": "नमस्कृतं परं लिगं न प्रेतो जायते नरः ।\nएकादश्यामुपोष्यैव द्वादश्यां च विशेषतः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000306060, "chapter_id": 20306, "verse_number": "१-६०-६१", "content_sanskrit": "पूजयित्वा हरिं मर्त्याः प्रेतत्वं न व्रजंति वै ।\nवेदाक्षरप्रसूतैश्च स्तोत्रमंत्रादिभिस्तथा॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000306061, "chapter_id": 20306, "verse_number": "१-६०-६२", "content_sanskrit": "देवानां पूजने रक्ता न वै प्रेता भवंति ते ।\nश्रुत्वा पौराणिकं वाक्यं दिव्यं च धर्मसंहितम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000306062, "chapter_id": 20306, "verse_number": "१-६०-६३", "content_sanskrit": "पाठयित्वा पठित्वा च पिशाचत्वं न गच्छति ।\nव्रतैश्च विविधैः पूताः पद्माक्षधारणैस्तथा॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000306063, "chapter_id": 20306, "verse_number": "१-६०-६४", "content_sanskrit": "जप्त्वा पद्माक्षमालायां प्रेतत्वं नैव गच्छति ।\nधात्रीफलद्रवैः स्नात्वा नित्यं तद्भक्षणे रताः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000306064, "chapter_id": 20306, "verse_number": "१-६०-६५", "content_sanskrit": "तेन विष्णुं सुसंपूज्य न गछंति पिशाचताम् ।\nप्रेता ऊचुः ।\nसतां संदर्शनात्पुण्यमिति पौराणिका विदुः॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000306065, "chapter_id": 20306, "verse_number": "१-६०-६६", "content_sanskrit": "तस्माद्वो दर्शनं जातं हितं नः कर्तुमर्हथ ।\nप्रेतभावाद्यथामुक्तिः सर्वेषां नो भविष्यति॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000306066, "chapter_id": 20306, "verse_number": "१-६०-६७", "content_sanskrit": "व्रतोपदेशकं धीरा युष्माकं शरणागताः ।\nततो दयालवः सर्वे तानूचुर्द्विजसत्तमाः॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000306067, "chapter_id": 20306, "verse_number": "१-६०-६८", "content_sanskrit": "धात्रीणां भक्षणं शीघ्रं कुर्वतां मुक्तिहेतवे ।\nप्रेता ऊचुः ।\nधात्रीणां दर्शने विप्रा वयं स्थातुं न शक्नुमः॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000306068, "chapter_id": 20306, "verse_number": "१-६०-६९", "content_sanskrit": "कथं तेषां फलानां च शक्ता वै भक्षणेधुना ।\nद्विजा ऊचुः ।\nअस्माकं वचनेनात्र धात्रीणां भक्षणं शिवम्॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000306069, "chapter_id": 20306, "verse_number": "१-६०-७०", "content_sanskrit": "फलिष्यति परं लोकं तस्माद्गंतुं समर्हथ ।\nअथ तेभ्यो वरं लब्ध्वा धात्रीवृक्षं पिशाचकैः॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000306070, "chapter_id": 20306, "verse_number": "१-६०-७१", "content_sanskrit": "समारुह्य फलं प्राप्य भक्षितं लीलया तदा ।\nततो देवालयात्तूर्णं रथं पीनसुशोभनम्॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000306071, "chapter_id": 20306, "verse_number": "१-६०-७२", "content_sanskrit": "आगतं तं समारुह्य सचांडालपिशाचकाः ।\nगतास्ते त्रिदिवं पुत्र व्रतैर्यज्ञैः सुदुर्लभम्॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000306072, "chapter_id": 20306, "verse_number": "१-६०-७३", "content_sanskrit": "स्कंद उवाच ।\nधात्रीभक्षणमात्रेण पुण्यं लब्ध्वा दिवं गताः ।\nतद्भक्षिणः कथं स्वर्गं न गच्छंति नरादयः॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000306073, "chapter_id": 20306, "verse_number": "१-६०-७४", "content_sanskrit": "ईश्वर उवाच ।\nपूर्वं ते ज्ञानलोपाच्च न जानंति हिताहितम् ।\nउच्छिष्टं श्वभिरुत्स्पृष्टं श्लेष्ममूत्रं शकृत्तु वा॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000306074, "chapter_id": 20306, "verse_number": "१-६०-७५", "content_sanskrit": "मत्वा च मोहिताः श्रेष्ठं प्रेतादंति सदैव हि ।\nशकृच्छौचजलं वांतं बलिसूकरकुक्कुटैः॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000306075, "chapter_id": 20306, "verse_number": "१-६०-७६", "content_sanskrit": "मृतके सूतके जप्यं न त्यक्तं येन केनचित् ।\nतस्यान्नं च जलं प्रेताः खादंति तु सदैव हि॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000306076, "chapter_id": 20306, "verse_number": "१-६०-७७", "content_sanskrit": "दुर्दांता गृहिणी यस्य शुचिसंयमवर्जिता ।\nगुरुनिःसारिता दुष्टा संति प्रेताश्च तत्र वै॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000306077, "chapter_id": 20306, "verse_number": "१-६०-७८", "content_sanskrit": "अपुङ्गवाः कुलैर्जात्या बलोत्साहविवर्जिताः ।\nबधिराश्च कृशा दीनाः पिशाचाः कर्मजातयः॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000306078, "chapter_id": 20306, "verse_number": "१-६०-७९", "content_sanskrit": "क्षणं च मंगलं नास्ति दुःखैर्देहयुता भृशम् ।\nतेनैव विकृताकाराः सर्वभोगविवर्जिताः॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000306079, "chapter_id": 20306, "verse_number": "१-६०-८०", "content_sanskrit": "नग्नका रोगसंतप्ता मृता रूक्षा मलीमसाः ।\nएते चान्ये च दुःखार्ताः सदैव प्रेतजातयः॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000306080, "chapter_id": 20306, "verse_number": "१-६०-८१", "content_sanskrit": "तेन कर्मविपाकेन जायंते काममीदृशाः ।\nपितृमातृगुरूणां च देवनिंदापराश्च ये॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000306081, "chapter_id": 20306, "verse_number": "१-६०-८२", "content_sanskrit": "पाषंडाः कौलिकाः पापास्ते प्रेताः कर्मजा भुवि ।\nगलपाशैर्जलैः शस्त्रैर्गरलैरात्मघातकाः॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000306082, "chapter_id": 20306, "verse_number": "१-६०-८३", "content_sanskrit": "इहलोके च ते प्रेताश्चांडालादिषु संभवाः ।\nअंत्यजाः पतिताश्चैव पापरोगमृताश्च ये॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000306083, "chapter_id": 20306, "verse_number": "१-६०-८४", "content_sanskrit": "अंत्यजैर्घातिता युद्धे ते प्रेता निश्चिता भुवि ।\nमहापातकसंयुक्ता विवाहे च बहिष्कृताः॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000306084, "chapter_id": 20306, "verse_number": "१-६०-८५", "content_sanskrit": "शौर्यात्साहसिका ये च ते प्रेताः कर्मजा भुवि ।\nराजद्रोहकरा ये च पितॄणां द्रोहचिंतकाः॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000306085, "chapter_id": 20306, "verse_number": "१-६०-८६", "content_sanskrit": "ध्यानाध्ययनहीनाश्च व्रतैर्देवार्चनादिभिः ।\nअमंत्राः स्नानहीनाश्च गुरुस्त्रीगमने रताः॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000306086, "chapter_id": 20306, "verse_number": "१-६०-८७", "content_sanskrit": "तथैव चांत्यजस्त्रीषु दुर्गतासु च संगताः ।\nमृताः क्रूरोपवासेन म्लेच्छदेशस्थिता मृताः॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000306087, "chapter_id": 20306, "verse_number": "१-६०-८८", "content_sanskrit": "म्लेच्छभाषायुताशुद्धास्तथाम्लेच्छोपजीविनः ।\nअनुवर्तंति ये म्लेच्छान्स्त्रीधनैरुपजीवकाः॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000306088, "chapter_id": 20306, "verse_number": "१-६०-८९", "content_sanskrit": "स्त्रियो यैश्च न रक्ष्यंते ते प्रेता नात्र संशयः ।\nक्षुधासंतप्तदेहं तु श्रांतं विप्रं गृहागतम्॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000306089, "chapter_id": 20306, "verse_number": "१-६०-९०", "content_sanskrit": "गुणपुण्यातिथिं त्यक्त्वा पिशाचत्वं व्रजंति ते ।\nविक्रीणंति च वै गाश्च म्लेच्छेषु च गवाशिषु॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000306090, "chapter_id": 20306, "verse_number": "१-६०-९१", "content_sanskrit": "प्रेतलोके सुखं स्थित्वा ते च यांत्यपुनर्भवम् ।\nअशौचाभ्यंतरे ये च जाताश्च पशवो मृताः॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000306091, "chapter_id": 20306, "verse_number": "१-६०-९२", "content_sanskrit": "चिरं प्रेताः पिशाचाश्च मृता जाताः पुनः पुनः ।\nजातकर्ममुखैश्चैव संस्कारैर्ये विविर्जिताः॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000306092, "chapter_id": 20306, "verse_number": "१-६०-९३", "content_sanskrit": "एकैकस्मिश्च संस्कारे प्रेतत्वं परिहीयते ।\nस्नानसंध्यासुरार्चाभिर्वेदयज्ञव्रताक्षरैः॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000306093, "chapter_id": 20306, "verse_number": "१-६०-९४", "content_sanskrit": "आजन्मवर्जिताः पापास्ते प्रेताश्चापुनर्भवाः ।\nभोजनोच्छिष्टपात्राणि यानि देहमलानि च॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000306094, "chapter_id": 20306, "verse_number": "१-६०-९५", "content_sanskrit": "निपातयंति ये तीर्थे ते प्रेता नात्र संशयः ।\nदानमानार्चनैर्नैव यैर्विप्रा भुवि तर्पिताः॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000306095, "chapter_id": 20306, "verse_number": "१-६०-९६", "content_sanskrit": "पितरो गुरवश्चैव प्रेतास्ते कर्मजा भृशम् ।\nपतिं त्यक्त्वा च या नार्यो वसंति चेतरैर्जनैः॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000306096, "chapter_id": 20306, "verse_number": "१-६०-९७", "content_sanskrit": "प्रेतलोके चिरं स्थित्वा जायंते चांत्ययोनिषु ।\nपतिं च वंचयित्वा या विषयेंद्रियमोहिताः॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000306097, "chapter_id": 20306, "verse_number": "१-६०-९८", "content_sanskrit": "मिष्टं चादंति याः पापास्तास्तु प्रेताश्चिरं भुवि ।\nविण्मूत्रभक्षका ये च ब्रह्मस्व भक्षणे रताः॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000306098, "chapter_id": 20306, "verse_number": "१-६०-९९", "content_sanskrit": "अभक्ष्यभक्षकाश्चान्ये ते प्रेताश्चापुनर्भवाः ।\nबलाद्ये परवस्तूनि गृह्णंति न ददत्यपि॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000306099, "chapter_id": 20306, "verse_number": "१-६०-१००", "content_sanskrit": "अतिथीनवमन्यंते प्रेता निरयमास्थिताः ।\nतस्मादामलकीं भुक्त्वा स्नात्वा तस्य द्रवेण च॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000306100, "chapter_id": 20306, "verse_number": "१-६०-१०१", "content_sanskrit": "सर्वपापाद्विनिर्मुक्तो विष्णुलोके महीयते ।\nतस्मात्सर्वप्रयत्नेन सेवयामलकीं शिवाम्॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000306101, "chapter_id": 20306, "verse_number": "१-६०-१०२", "content_sanskrit": "य इदं शृणुयान्नित्यं पुण्याख्यानमिदं शुभम् ।\nसर्वपाप प्रपूतात्मा विष्णुलोके महीयते॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000306102, "chapter_id": 20306, "verse_number": "१-६०-१०३", "content_sanskrit": "श्रावयेत्सततं लोके वैष्णवेषु विशेषतः ।\nस याति विष्णुसायुज्यमिति पौराणिका विदुः॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000306103, "chapter_id": 20306, "verse_number": "१-६०-१०४", "content_sanskrit": "स्कंद उवाच ।\nमहीरुह फलं ज्ञातं प्रपूतं द्विविधं प्रभो ।\nइदानीं श्रोतुमिच्छामि पत्रं पुष्पं सुमोक्षदम्॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000306104, "chapter_id": 20306, "verse_number": "१-६०-१०५", "content_sanskrit": "ईश्वर उवाच ।\nसर्वेभ्यः पत्रपुष्पेभ्यः सत्तमा तुलसी शिवा ।\nसर्वकामप्रदा शुद्धा वैष्णवी विष्णुसुप्रिया॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000306105, "chapter_id": 20306, "verse_number": "१-६०-१०६", "content_sanskrit": "भुक्तिमुक्तिप्रदा मुख्या सर्वलोकपरा शुभा ।\nयामाश्रित्य गताः स्वर्गमक्षयं मुनिसत्तमाः॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000306106, "chapter_id": 20306, "verse_number": "१-६०-१०७", "content_sanskrit": "हितार्थं सर्वलोकानां विष्णुनारोपिता पुरा ।\nतुलसीपत्रपुष्पं च सर्वधर्मप्रतिष्ठितम्॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000306107, "chapter_id": 20306, "verse_number": "१-६०-१०८", "content_sanskrit": "यथा विष्णोः प्रियालक्ष्मीर्यथाहं प्रिय एव च ।\nतथेयं तुलसीदेवी चतुर्थो नोपपद्यते॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000306108, "chapter_id": 20306, "verse_number": "१-६०-१०९", "content_sanskrit": "तुलसीपत्रमेकं तु शतहेमफलप्रदम् ।\nनान्यैः पुष्पैस्तथापत्रैर्नान्यैर्गंधानुलेपनैः॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000306109, "chapter_id": 20306, "verse_number": "१-६०-११०", "content_sanskrit": "तुष्यते दैत्यहा विष्णुस्तुलस्याश्च दलैर्विना ।\nअनेन पूजितो येन हरिर्नित्यं पराशया॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000306110, "chapter_id": 20306, "verse_number": "१-६०-१११", "content_sanskrit": "तेन दत्तं हुतं ज्ञातं कृतं यज्ञव्रतादिकम् ।\nजन्मजन्मनि भासित्वं सुखं भाग्यं यशः श्रियं॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000306111, "chapter_id": 20306, "verse_number": "१-६०-११२", "content_sanskrit": "कुलं शीलं कलत्रं च पुत्रं दुहितरं तथा ।\nधनं राज्यमरोगत्वं ज्ञानं विज्ञानमेव च॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000306112, "chapter_id": 20306, "verse_number": "१-६०-११३", "content_sanskrit": "वेदवेदांगशास्त्रं च पुराणागमसंहिताः ।\nसर्वं करगतं मन्ये तुलस्याभ्यर्चने हरेः॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000306113, "chapter_id": 20306, "verse_number": "१-६०-११४", "content_sanskrit": "यथा गंगा पवित्रांगी सुरलोके विमोक्षदा ।\nयथा भागीरथी पुण्या तथैवं तुलसी शिवा॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000306114, "chapter_id": 20306, "verse_number": "१-६०-११५", "content_sanskrit": "किं च गंगाजले नैव किंच पुष्करसेवया ।\nतुलसीदलमिश्रेण जलेनैव प्रमोद्यते॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000306115, "chapter_id": 20306, "verse_number": "१-६०-११६", "content_sanskrit": "माधवः संमुखो यस्य जन्मजन्मसुधीमतः ।\nतस्य श्रद्धा भवेछ्रुत्वा तुलस्या हरिमर्चितुम्॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000306116, "chapter_id": 20306, "verse_number": "१-६०-११७", "content_sanskrit": "यो मंजरीदलैरेव तुलस्या विष्णुमर्चयेत् ।\nतस्य पुण्यफलं स्कन्द कथितुं नैव शक्यते॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000306117, "chapter_id": 20306, "verse_number": "१-६०-११८", "content_sanskrit": "तत्र केशवसान्निध्यं यत्रास्ति तुलसीवनम् ।\nतत्र ब्रह्मा च कमला सर्वदेवगणैः सह॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000306118, "chapter_id": 20306, "verse_number": "१-६०-११९", "content_sanskrit": "तस्मात्तां संनिकृष्टे तु सदा देवीं प्रपूजयेत् ।\nस्तोत्रमंत्रादिकं यद्वा सर्वमानंत्यमश्नुते॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000306119, "chapter_id": 20306, "verse_number": "१-६०-१२०", "content_sanskrit": "ये च प्रेताश्च कूश्मांडाः पिशाचा ब्रह्मराक्षसाः ।\nभूतदैत्यादयस्तत्र पलायंते सदैव हि॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000306120, "chapter_id": 20306, "verse_number": "१-६०-१२१", "content_sanskrit": "अलक्ष्मीर्नाशिनी घूर्णा या डाकिन्यादि मातरः ।\nसर्वाः संकोचितां यांति दृष्ट्वा तु तुलसीदलं॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000306121, "chapter_id": 20306, "verse_number": "१-६०-१२२", "content_sanskrit": "ब्रह्महत्यादयः पापव्याधयः पापसंभवाः ।\nकुमंत्रिणा कृता ये च सर्वे नश्यंति तत्र वै॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000306122, "chapter_id": 20306, "verse_number": "१-६०-१२३", "content_sanskrit": "भूतले वापि तं येन हर्यर्थं तुलसीवनम् ।\nकृतं क्रतुशतं तेन विधिवत्प्रियदक्षिणम्॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000306123, "chapter_id": 20306, "verse_number": "१-६०-१२४", "content_sanskrit": "हरिलिंगेषु चान्येषु सालग्रामशिलासु च ।\nतुलसीग्रहणं कृत्वा विष्णोः सायुज्यमाव्रजेत्॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000306124, "chapter_id": 20306, "verse_number": "१-६०-१२५", "content_sanskrit": "नंदंति पुरुषास्तस्य माधवार्थे क्षितौ तु यः ।\nतुलसीं रोपयेद्धीरः स याति माधवालयम्॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000306125, "chapter_id": 20306, "verse_number": "१-६०-१२६", "content_sanskrit": "पूजयित्वा हरिं देवं निर्माल्यं तुलसीदलम् ।\nधारयेद्यः स्वशीर्षे तु पापात्पूतो दिवं व्रजेत्॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000306126, "chapter_id": 20306, "verse_number": "१-६०-१२७", "content_sanskrit": "पूजने कीर्त्तने ध्याने रोपणे धारणे कलौ ।\nतुलसी दहते पापं र्स्वर्गं मोक्षं ददाति च॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7000306127, "chapter_id": 20306, "verse_number": "१-६०-१२८", "content_sanskrit": "उपदेशं दिशेदस्याः स्वयमाचरते पुनः॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7000306128, "chapter_id": 20306, "verse_number": "१-६०-१२९", "content_sanskrit": "स याति परमं स्थानं माधवस्य निकेतनम् ।\nहरेः प्रियकरं यच्च तन्मे प्रियतरं भवेत्॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7000306129, "chapter_id": 20306, "verse_number": "१-६०-१३०", "content_sanskrit": "सर्वेषामपि देवानां देवीनां च समंततः ।\nश्राद्धेषु यज्ञकार्येषु पर्णमेकं षडानन॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7000306130, "chapter_id": 20306, "verse_number": "१-६०-१३१", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन तुलसीसेवनं कुरु ।\nतुलसी सेविता येन तेन सर्वं तु सेवितम्॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7000306131, "chapter_id": 20306, "verse_number": "१-६०-१३२", "content_sanskrit": "गुरुं विप्रं देवतीर्थं तस्मात्सेवय षण्मुख ।\nशिखायां तुलसीं कृत्वा यस्तु प्राणान्परित्यजेत्॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7000306132, "chapter_id": 20306, "verse_number": "१-६०-१३३", "content_sanskrit": "दुष्कृतौघाद्विनिर्मुक्तः स्वर्गमेति निरामयम् ।\nराजसूयादिभिर्यज्ञैर्व्रतैश्च विविधैर्यमैः॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7000306133, "chapter_id": 20306, "verse_number": "१-६०-१३४", "content_sanskrit": "या गतिः प्राप्यते धीरैः तुलसीसेविनां भवेत् ।\nतुलसीदलेन चैकेन पूजयित्वा हरिं नरः॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7000306134, "chapter_id": 20306, "verse_number": "१-६०-१३५", "content_sanskrit": "वैष्णवत्वमवाप्नोति किमन्यैः शास्त्रविस्तरैः ।\nन पिबेत्स पयो मातुस्तुलस्याः कोटिसंख्यकैः॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7000306135, "chapter_id": 20306, "verse_number": "१-६०-१३६", "content_sanskrit": "अर्चितः केशवो येन शाखामृदुलपल्लवैः ।\nभावयेत्पुरुषान्मर्त्यः शतशोथ सहस्रशः॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7000306136, "chapter_id": 20306, "verse_number": "१-६०-१३७", "content_sanskrit": "पूजयित्वा हरिं नित्यं कोमलैस्तुलसीदलैः ।\nप्रधानतो गुणास्तात तुलस्या गदिता मया॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7000306137, "chapter_id": 20306, "verse_number": "१-६०-१३८", "content_sanskrit": "निखिलं पुरुकालेन गुणं वक्तुं न शक्नुमः ।\nयस्त्विदं शृणुयान्नित्यमाख्यानं पुण्यसंचयम्॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7000306138, "chapter_id": 20306, "verse_number": "१-६०-१३९", "content_sanskrit": "पूर्वजन्मकृतात्पापान्मुच्यते जन्मबंधनात् ।\nसकृत्पठनमात्रेण वह्निष्टोमफलं लभेत्॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7000306139, "chapter_id": 20306, "verse_number": "१-६०-१४०", "content_sanskrit": "न तस्य व्याधयः पुत्र मूर्खत्वं न कदाचन ।\nसर्वदा जयमाप्नोति न गच्छेत्स पराजयं॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7000306140, "chapter_id": 20306, "verse_number": "१-६०-१४१", "content_sanskrit": "लेखस्तिष्ठेद्गृहे यस्य तस्य लक्ष्मीः प्रवर्तते ।\nन चाधयो न च प्रेता न शोको नावमानना॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7000306141, "chapter_id": 20306, "verse_number": "१-६०-१४२", "content_sanskrit": "न तिष्ठंति क्षणं तत्र यत्रेयं वर्तते लिपिः॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}]