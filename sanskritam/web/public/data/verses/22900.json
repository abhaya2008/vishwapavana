[{"id": 7002900000, "chapter_id": 22900, "verse_number": "९-१८५-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nआत्मप्रतिकृतिर्नाम यथोक्तं कस्यचित्पुरा ।\nतत्तेऽहं संप्रवक्ष्यामि दानं मानविवर्धनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002900001, "chapter_id": 22900, "verse_number": "९-१८५-२", "content_sanskrit": "दानकालः सदा तस्य मुनिभिः परिकीर्तितः ।\nपुण्यैः पुण्यदिनं पार्थ प्राप्यते जीवितैर्न च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002900002, "chapter_id": 22900, "verse_number": "९-१८५-३", "content_sanskrit": "लोहजां प्रकृतिं भव्यां कारयित्वात्मनो नृप ।\nअभीष्टवाहनगतामिष्टालंकारसंयुताम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002900003, "chapter_id": 22900, "verse_number": "९-१८५-४", "content_sanskrit": "अभीष्टलोकसहितां सर्वोपस्करसंयुताम् ।\nततः पट्टपटीवस्त्रैश्छादितां रत्नभूषिताम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002900004, "chapter_id": 22900, "verse_number": "९-१८५-५", "content_sanskrit": "कुंकुमेनानुलिप्तांगीं कर्पूरागुरुवासिताम् ।\nस्त्री चेद्ददाति शयने शयितां कारयेत्स्वयम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002900005, "chapter_id": 22900, "verse_number": "९-१८५-६", "content_sanskrit": "यद्यदिष्टतमं किंचित्तत्सर्वं पार्श्वतो न्यसेत् ।\nउपकारकरं स्त्रीणां स्वशरीरे च यद्भवेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002900006, "chapter_id": 22900, "verse_number": "९-१८५-७", "content_sanskrit": "तत्सर्वं स्थापयेत्पार्श्वे स्वयं संचिंत्य चेतसि ।\nएतत्सर्वं मेलयित्वा स्वेस्वे स्थाने निधाय च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002900007, "chapter_id": 22900, "verse_number": "९-१८५-८", "content_sanskrit": "पूजयित्वा लोकपालान्गृहान्देवीं विनायकम् ।\nतत शुक्लांबरः स्नात्वा गृहीतकुसुमांजलिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002900008, "chapter_id": 22900, "verse_number": "९-१८५-९", "content_sanskrit": "इममुच्चारयेन्मंत्रं विप्रस्य पुरतो बुधः ।\nआत्मनः प्रतिमा चेयं सर्वोपकरणैर्युता ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002900009, "chapter_id": 22900, "verse_number": "९-१८५-१०", "content_sanskrit": "सर्वरत्नसमायुक्ता तव विप्र निवेदिता ।\nआत्मा शंभुः शिवः शौरिः शक्रः सुरगणैर्वृतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002900010, "chapter_id": 22900, "verse_number": "९-१८५-११", "content_sanskrit": "तस्मादात्मप्रदानेन ममात्मा सुप्रसीदतु ।\nइत्युच्चार्य ततो दद्याद्ब्राह्मणाय युधिष्ठिर ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002900011, "chapter_id": 22900, "verse_number": "९-१८५-१२", "content_sanskrit": "ब्राह्मणश्चापि गृह्णीयात्कोदादिति च कीर्तयन् ।\nततः प्रदक्षिणीकृत्य प्रणिपत्य विसर्जयेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002900012, "chapter_id": 22900, "verse_number": "९-१८५-१३", "content_sanskrit": "विधिनानेन राजेन्द्र दानमेतत्प्रयच्छति ।\nयः पुमानथ वा नारी शृणुयात्फलमाप्नुयात् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002900013, "chapter_id": 22900, "verse_number": "९-१८५-१४", "content_sanskrit": "साग्रं वर्षशतं दिव्यं स्वर्गलोके सुरैर्वृतः ।\nअभीष्टफलदानेन ह्यभीष्टफलभाग्भवेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002900014, "chapter_id": 22900, "verse_number": "९-१८५-१५", "content_sanskrit": "यत्रैवोत्पद्यते जंतुः प्राप्ते कर्मक्षये पुनः ।\nतत्रैव सर्वकामानां फलभाग्भवते नृपः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002900015, "chapter_id": 22900, "verse_number": "९-१८५-१६", "content_sanskrit": "इष्टबंधुजनैः सार्द्धं न वियोगं कदाचन ।\nप्राप्नोति पुरुषो राजन्स्वर्गे चानंत्यमश्नुते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002900016, "chapter_id": 22900, "verse_number": "९-१८५-१७", "content_sanskrit": "यश्चात्मनः प्रतिकृतिं वरवाहनस्था हैमीं विधाय धनधान्यसमाकुलां च ।\nसोपस्करं द्विजवराय ददाति भक्त्या चंद्रार्कवत्स दिवि भाति हि राजराजः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]