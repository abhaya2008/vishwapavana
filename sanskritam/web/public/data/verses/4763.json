[{"id": 2178054, "chapter_id": 4763, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178055, "chapter_id": 4763, "verse_number": "१", "content_sanskrit": "अहोऽभिहितमाख्यानं भवता तत्त्वदर्शिना ।\nभूय एव महाप्राज्ञ श्रोष्ये वागमृतं तव\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178056, "chapter_id": 4763, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178057, "chapter_id": 4763, "verse_number": "२", "content_sanskrit": "शृणु भूयः प्रवक्ष्यामि मार्गस्यैतस्य विस्तरम् ।\nयच्छ्रुत्वा विप्रमुच्यन्ते संसाराद्धि विचक्षणाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178058, "chapter_id": 4763, "verse_number": "३", "content_sanskrit": "यथा तु पुरुषो राजन् दीर्घमध्वानमास्थितः ।\nक्वचित् क्वचिच्छ्रमाच्छान्तः कुरुते वासमेव वा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178059, "chapter_id": 4763, "verse_number": "४", "content_sanskrit": "एवं संसारपर्याये गर्भवासेषु भारत ।\nकुर्वन्ति दुर्बुधा वासं मुच्यन्ते तत्र पण्डिताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178060, "chapter_id": 4763, "verse_number": "५", "content_sanskrit": "तस्मादध्वानमेवैतत् आहुः शास्त्रविदो जनाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178061, "chapter_id": 4763, "verse_number": "६", "content_sanskrit": "यत् तत् संसारगहनं वनमाहुर्मनीषिणः ।\nसोऽयं लोके समावर्तो मर्त्यानां भरतर्षभ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178062, "chapter_id": 4763, "verse_number": "७", "content_sanskrit": "चराणां स्थावराणां च गृध्येत् तत्र न पण्डितः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178063, "chapter_id": 4763, "verse_number": "८", "content_sanskrit": "शारीरा मानसाश्चैव मर्त्यानां व्याधयस्तु ये ।\nप्रत्यक्षाश्च परोक्षाश्च ते व्यालाः कथिता बुधैः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178064, "chapter_id": 4763, "verse_number": "९", "content_sanskrit": "क्लिश्यमानाश्च ये नित्यं वार्यमाणाश्च भारत ।\nस्वकर्मभिर्महाव्याळैः नोद्विजन्त्यल्पबुद्धयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178065, "chapter_id": 4763, "verse_number": "१०", "content_sanskrit": "अथापि तैर्विमुच्येत व्याधिभिः पुरुषो नृप ।\nआवृणोत्येव तं पश्चाज्जरा रूपविनाशिनी\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178066, "chapter_id": 4763, "verse_number": "११", "content_sanskrit": "शब्दरूपरसस्पर्शगन्धैश्च विविधैरपि ।\nमज्जमानं महापङ्के निरालम्बे समन्ततः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178067, "chapter_id": 4763, "verse_number": "१२", "content_sanskrit": "संवत्सरर्तवो मासाः पक्षाहोरात्रसन्धयः ।\nक्रमेणास्य प्रमार्जन्ति रूपमायुस्तथैव च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178068, "chapter_id": 4763, "verse_number": "१३", "content_sanskrit": "एते कालस्य विधयो नैनं जानन्ति दुर्बुधाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178069, "chapter_id": 4763, "verse_number": "१४", "content_sanskrit": "धात्राभिलिखितान्याहुः सर्वभूतानि कर्मणा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178070, "chapter_id": 4763, "verse_number": "१५", "content_sanskrit": "रथः शरीरं भूतानां सत्त्वमाहुस्तु सारथिम् ।\nइन्द्रियाणि हयानाहुः कर्म बुद्धिश्च रश्मयः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178071, "chapter_id": 4763, "verse_number": "१६", "content_sanskrit": "तेषां हयानां यो वेगं धावतामनुधावति ।\nन संयमयते बुद्ध्या स यन्ता न निवर्तते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178072, "chapter_id": 4763, "verse_number": "१७", "content_sanskrit": "यस्तु संसारचक्रेऽस्मिन् चक्रवत् परिवर्तते ।\nयाम्यमाहू रथं ह्येनं मुह्यन्ते येन दुर्बुधाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178073, "chapter_id": 4763, "verse_number": "१८", "content_sanskrit": "स वै तत् प्राप्नुयाद् राजन् यत् त्वं प्राप्तो नराधिप ।\nराज्यनाशः सुहृन्नाशः सुतनाशश्च भारत\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178074, "chapter_id": 4763, "verse_number": "१९", "content_sanskrit": "अनुतर्षुकमेवैतद् दुःखं भवति भारत ।\nसाधुः परमदुःखानां दुःखभैषज्यमारभेत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178075, "chapter_id": 4763, "verse_number": "२०", "content_sanskrit": "ज्ञानौषधमवाप्येह दुरावापं महौषधम् ।\nछिन्द्याद् दुःखमयं व्याधिं नरः संयतमानसः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178076, "chapter_id": 4763, "verse_number": "२१", "content_sanskrit": "न विक्रमो न चाप्यर्थो न मित्रं न सुहृज्जनः ।\nतथा मोचयते दुःखाद् यथात्मा स्थिरनिश्चयः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178077, "chapter_id": 4763, "verse_number": "२२", "content_sanskrit": "तस्मान्मैत्रं समास्थाय शीलमापद्य भारत ।\nदमस्त्यागोऽप्रमादश्च ते त्रयो ब्रह्मणो हयाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178078, "chapter_id": 4763, "verse_number": "२३", "content_sanskrit": "शीलरश्मिसमायुक्ते स्थितो यो मानसे रथे ।\nत्यक्त्वा मृत्युभयं राजन् ब्रह्मलोकं स गच्छति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2178079, "chapter_id": 4763, "verse_number": "२४", "content_sanskrit": "अभयं सर्वभूतेभ्यो यो ददाति महीपते ।\nस गच्छति परं स्थानं विष्णोः पदमनामयम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2178080, "chapter_id": 4763, "verse_number": "२५", "content_sanskrit": "नैतत् ऋतुसहस्रेण नोपवासेन नित्यशः ।\nअभयस्य हि दानेन यत्फलं प्राप्नुयान्नरः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2178081, "chapter_id": 4763, "verse_number": "२६", "content_sanskrit": "न ह्यात्मनः प्रियतरं किञ्चिद् भूतेषु निश्चितम् ।\nअनिष्टं सर्वभूतानां मरणं नाम भारत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2178082, "chapter_id": 4763, "verse_number": "२७", "content_sanskrit": "तस्मात् सर्वेषु भूतेषु दया कार्या विपश्चिता\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2178083, "chapter_id": 4763, "verse_number": "२८", "content_sanskrit": "नानायोगसमायुक्ता बुद्धिजालेन संवृताः ।\nसुसूक्ष्मदृष्टयो धीरा व्रजन्ति ब्रह्मसाम्यताम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2178084, "chapter_id": 4763, "verse_number": "२९", "content_sanskrit": "एवं ज्ञात्वा महाप्राज्ञ स तेषामौर्ध्वदैहिकम् ।\nकर्तुमर्हति तेनैव फलं प्राप्स्यति वै भवान्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2178085, "chapter_id": 4763, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nधृतराष्ट्रविशोके सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2178086, "chapter_id": 4763, "verse_number": "", "content_sanskrit": "जलप्रदानपर्वणि सप्तमोऽध्यायः ॥७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]