[{"id": 2134987, "chapter_id": 3920, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2134988, "chapter_id": 3920, "verse_number": "१", "content_sanskrit": "चित्रसेनं समागम्य प्रहसन्नर्जुनस्तदा ।\nइदं वचनमक्लीबमब्रवीत् परवीरहा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2134989, "chapter_id": 3920, "verse_number": "२", "content_sanskrit": "भ्रातॄनर्हसि मे वीर मोक्तुं गन्धर्वसत्तम ।\nअनर्हधर्षणा हीमे जीवमानेषु पाण्डुषु \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2134990, "chapter_id": 3920, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2134991, "chapter_id": 3920, "verse_number": "३", "content_sanskrit": "एवमुक्तस्तु गन्धर्वः पाण्डवेन महात्मना ।\nउवाच यत् कर्ण वयं मन्त्रयन्तो विनिर्गताः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2134992, "chapter_id": 3920, "verse_number": "४", "content_sanskrit": "द्रष्टारः स्म सुखाद्धीनान् सदारान् पाण्डवानिति ।\nस्थितो राज्ये च्युतान् स्थानाच्छ्रिया हीनाञ्श्रियावृताः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2134993, "chapter_id": 3920, "verse_number": "५", "content_sanskrit": "तस्मिन्नुच्चार्यमाणे तु गन्धर्वेण वचस्तथा ।\nभूमेर्विवरमन्वैच्छं प्रवेष्टुं व्रीडयान्वितः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2134994, "chapter_id": 3920, "verse_number": "६", "content_sanskrit": "युधिष्ठिरमथागम्य गन्धर्वाः सह पाण्डवैः ।\nअस्मद्दुर्मन्त्रितं तस्मै बद्धांश्चास्मान् न्यवेदयन् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2134995, "chapter_id": 3920, "verse_number": "७", "content_sanskrit": "स्त्रीसमक्षमहं दीनो बद्धः शत्रुवशं गतः ।\nयुधिष्ठिरस्योपहृतः किं नु दुःखमतः परम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2134996, "chapter_id": 3920, "verse_number": "८", "content_sanskrit": "ये मे निराकृता नित्यं रिपुर्येषामहं सदा ।\nतैर्मोक्षितोऽहं दुर्बुद्धिस्तैर्दत्तं जीवितं च मे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2134997, "chapter_id": 3920, "verse_number": "९", "content_sanskrit": "प्राप्तः स्यां यद्यहं वीर वधं तस्मिन् महारणे ।\nश्रेयस्तद् भविता मह्यं नैवम्भूतस्य जीवितम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2134998, "chapter_id": 3920, "verse_number": "१०", "content_sanskrit": "अभूद्यशः पृथिव्यां मे ख्यातं गन्धर्वतो वधात् ।\nप्राप्ताश्च पुण्यलोकाः स्युर्महेन्द्रसदनेऽक्षयाः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2134999, "chapter_id": 3920, "verse_number": "११", "content_sanskrit": "यत्त्वद्य मे व्यवसितं तच्छ्रुणुध्वं नरर्षभाः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2135000, "chapter_id": 3920, "verse_number": "१२", "content_sanskrit": "इह प्रायमुपासिष्ये यूयं व्रजत वै गृहान् ।\nभ्रातरश्चैव मे सर्वे प्रयान्त्वद्य पुरं प्रति \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2135001, "chapter_id": 3920, "verse_number": "१३", "content_sanskrit": "न ह्यहं सम्प्रयास्यामि पुरं शत्रुनिराकृतः ।\nशत्रुमानापहो भूत्वा सुहृदां मानकृत् तथा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2135002, "chapter_id": 3920, "verse_number": "१४", "content_sanskrit": "कारणैः सम्यगभिहितः शत्रुभिर्वै विमानितः ।\nस सुहृच्छोकदो भूत्वा शत्रूणां हर्षवर्धनः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2135003, "chapter_id": 3920, "verse_number": "१५", "content_sanskrit": "वारणाह्वयमासाद्य किं वक्ष्यामि जनाधिपम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2135004, "chapter_id": 3920, "verse_number": "१६", "content_sanskrit": "भीष्मद्रोणौ कृपद्रौणी विदुरः सञ्जयस्तथा ।\nबाह्लीकः सौमदत्तिश्च ये चान्ये वृद्धसम्मताः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2135005, "chapter_id": 3920, "verse_number": "१७", "content_sanskrit": "ब्राह्मणाः श्रेणिमुख्याश्च तथोदासीनवृत्तयः ।\nकिं मां वक्ष्यन्ति किं चापि प्रतिवक्ष्यामि तानहम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2135006, "chapter_id": 3920, "verse_number": "१८", "content_sanskrit": "रिपूणां शिरसि स्थित्वा तथा विक्रम्य चोरसि ।\nआत्मदोषात् परिभ्रष्टः कथं वक्ष्यामि तानहम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2135007, "chapter_id": 3920, "verse_number": "१९", "content_sanskrit": "दुर्विनीताः श्रियं प्राप्य विद्यामैश्वर्यमेव च ।\nतिष्ठन्ति न चिरं भद्रे यथाऽहं मदगर्वितः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2135008, "chapter_id": 3920, "verse_number": "२०", "content_sanskrit": "अहो नार्हमिदं कर्म कष्टं दुश्चरितं कृतम् ।\nस्वयं दुर्बुद्धिना मोहाद् येन प्राप्तोऽस्मि संशयम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2135009, "chapter_id": 3920, "verse_number": "२१", "content_sanskrit": "तस्मात् प्रायमुपासिष्ये न हि शक्ष्यामि जीवितुम् ।\nचेतयानो हि को जीवेत् कृच्छ्राच्छत्रुभिरुद्धृतः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2135010, "chapter_id": 3920, "verse_number": "२२", "content_sanskrit": "शत्रुभिश्चावहसितो मानी पौरुषवर्जितः ।\nपाण्डवैर्विक्रमाढ्यैश्च सावमानमवेक्षितः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2135011, "chapter_id": 3920, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि\nअष्टत्रिंशदधिकद्विशततमोऽध्यायः ॥२३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2135012, "chapter_id": 3920, "verse_number": "", "content_sanskrit": "प्रायोपवेशपर्वणि तृतीयोऽध्यायः ॥३॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]