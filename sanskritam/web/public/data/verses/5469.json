[{"id": 2209207, "chapter_id": 5469, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209208, "chapter_id": 5469, "verse_number": "१", "content_sanskrit": "श्रुत्वैतद् वचनं ब्रह्मन् व्यासेनोक्तं महात्मना ।\nअश्वमेधं प्रति तदा किं चकार युधिष्ठिरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209209, "chapter_id": 5469, "verse_number": "२", "content_sanskrit": "रत्नं च यन्मरुत्तेन निहितं पृथिवीतळे ।\nतदवाप्तं कथं चैतत् तन्मे ब्रूहि द्विजोत्तम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209210, "chapter_id": 5469, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209211, "chapter_id": 5469, "verse_number": "३", "content_sanskrit": "श्रुत्वा द्वैपायनवचो धर्मराजो युधिष्ठिरः ।\nभ्रातॄन् सर्वान् समाभाष्य काले वचनमब्रवीत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209212, "chapter_id": 5469, "verse_number": "४", "content_sanskrit": "अर्जुनं भीमसेनं च माद्रीपुत्रौ यमावपि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209213, "chapter_id": 5469, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209214, "chapter_id": 5469, "verse_number": "५", "content_sanskrit": "श्रुतं वो वचनं वीराः सौहृदाद् यन्महात्मना ।\nकुरूणां हितकामेन प्रोक्तं कृष्णेन धीमता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209215, "chapter_id": 5469, "verse_number": "६", "content_sanskrit": "तपोवृद्धेन महता सुहृदां भूतिमिच्छता ।\nगुरुणा धर्मशीलेन व्यासेनाद्भुतकर्मणा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209216, "chapter_id": 5469, "verse_number": "७", "content_sanskrit": "पितामहेन भीष्मेण गोविन्देन च धीमता ।\nसंस्मृत्य तदहं सम्यक् कर्तुमिच्छामि पाण्डवाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209217, "chapter_id": 5469, "verse_number": "८", "content_sanskrit": "आयत्यां च तदात्वे च सर्वेषां तद्धि नो हितम् ।\nअनुबन्धे च कल्याणं यद्वचो ब्रह्मवादिनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209218, "chapter_id": 5469, "verse_number": "९", "content_sanskrit": "इयं हि वसुधा सर्वा क्षीणरत्ना कुरूद्वहाः ।\nतच्चाचष्ट बहु व्यासो मरुत्तस्य धनं नृपाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209219, "chapter_id": 5469, "verse_number": "१०", "content_sanskrit": "यद्येतद् वो बहुमतं मन्यध्वं वा क्षमं यदि ।\nतदानयामहे सर्वे कथं वा भीम मन्यसे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209220, "chapter_id": 5469, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209221, "chapter_id": 5469, "verse_number": "११", "content_sanskrit": "इत्युक्तवाक्ये नृपतौ तदा कुरुकुलोद्वह ।\nभीमसेनो नृपश्रेष्ठं प्राञ्जलिर्वाक्यमब्रवीत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209222, "chapter_id": 5469, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209223, "chapter_id": 5469, "verse_number": "१२", "content_sanskrit": "रोचते मे महाबाहो यदिदं भाषितं त्वया ।\nव्यासाख्यातस्य वित्तस्य समुपानयनं प्रति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209224, "chapter_id": 5469, "verse_number": "१३", "content_sanskrit": "तत् प्राप्नुयामहे धर्माद् धनमुद्वीक्षितं प्रभो ।\nकृतमेव महाराज भवेदिति मतिर्मम ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209225, "chapter_id": 5469, "verse_number": "१४", "content_sanskrit": "ते वयं प्रणिपातेन गिरीशस्य महात्मनः ।\nतदानयाम भद्रं ते तमभ्यर्च्य कपर्दिनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209226, "chapter_id": 5469, "verse_number": "१५", "content_sanskrit": "तं विभुं देवदेवेशं शूलपाणिं त्रिलोचनम् ।\nअनादिनिधनं शम्भुं नमस्याम महेश्वरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209227, "chapter_id": 5469, "verse_number": "१६", "content_sanskrit": "लोकनाथं गणाध्यक्षं तस्यैवानुचरान् स्थितान् ।\nप्रसाद्यार्थमवाप्स्यामो मनो वाग्बुद्धिकर्मभिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209228, "chapter_id": 5469, "verse_number": "१७", "content_sanskrit": "रक्षन्ति ये च तद् द्रव्यं किन्नरा रौद्रदर्शनाः ।\nते च वश्या भविष्यन्ति प्रसन्ने वृषभध्वजे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209229, "chapter_id": 5469, "verse_number": "१८", "content_sanskrit": "स हि देवः प्रसन्नात्मा भक्तानां परमेश्वरः ।\nददात्यमरतां चापि किं पुनः काञ्चनं प्रभुः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209230, "chapter_id": 5469, "verse_number": "१९", "content_sanskrit": "वनस्थस्य पुरा जिष्णोरस्त्रं पाशुपतं महत् ।\nरौद्रं ब्रह्मशिरश्चादात् प्रसन्नः किं पुनर्धनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209231, "chapter_id": 5469, "verse_number": "२०", "content_sanskrit": "वयं सर्वे च तद्भक्ताः स चास्माकं प्रसीदति ।\nतत्प्रसादाद् वयं राज्यं प्राप्ताः कौरवनन्दन ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209232, "chapter_id": 5469, "verse_number": "२१", "content_sanskrit": "अभिमन्योर्वधे वृत्ते प्रतिज्ञाते धनञ्जये ।\nजयद्रथवधार्थाय स्वप्ने लोकगुरुर्निशि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209233, "chapter_id": 5469, "verse_number": "२२", "content_sanskrit": "प्रसाद्य लब्धवानस्त्रमर्जुनः सहकेशवः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209234, "chapter_id": 5469, "verse_number": "२३", "content_sanskrit": "ततः प्रभातां रजनीं फल्गुनस्याग्रतः प्रभुः ।\nजघान सैन्यं शूलेन प्रत्यक्षं सव्यसाचिनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209235, "chapter_id": 5469, "verse_number": "२४", "content_sanskrit": "कस्तां सेनां महाराज मनसाऽपि प्रधर्षयेत् ।\nद्रोणकर्णमुखैर्युक्तां महेष्वासैः प्रहारिभिः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209236, "chapter_id": 5469, "verse_number": "२५", "content_sanskrit": "ऋते देवान्महेष्वासाद् बहुरूपान्महेश्वरात् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2209237, "chapter_id": 5469, "verse_number": "२६", "content_sanskrit": "तस्यैव च प्रसादेन निहताः शत्रवस्तव ।\nअश्वमेधस्य संसिद्धिं स तु सम्पादयिष्यति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2209238, "chapter_id": 5469, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2209239, "chapter_id": 5469, "verse_number": "२७", "content_sanskrit": "श्रुत्वैव ब्रुवतस्तस्य वाक्यं भीमस्य पार्थिव ।\nप्रीतो धर्मात्मजो राजा बभूवातीव भारत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2209240, "chapter_id": 5469, "verse_number": "२८", "content_sanskrit": "अर्जुनप्रमुखाश्चैव तथेत्येवाब्रुवन् मुदा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2209241, "chapter_id": 5469, "verse_number": "२९", "content_sanskrit": "कृत्वा तु पाण्डवाः सर्वे रत्नाहरणनिश्चयम् ।\nसेनामाज्ञापयामासुः नक्षत्रेऽहनि पूजिते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2209242, "chapter_id": 5469, "verse_number": "३०", "content_sanskrit": "ततो ययुः पाण्डुसुता ब्राह्मणान् स्वस्ति वाच्य च ।\nअर्चयित्वा सुरश्रेष्ठं पूर्वमेव महेश्वरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2209243, "chapter_id": 5469, "verse_number": "३१", "content_sanskrit": "मोदकैः पायसेनाथ माषापूपैस्तथैव च ।\nआराध्य च महात्मानं प्रययुर्मुदिता भृशम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2209244, "chapter_id": 5469, "verse_number": "३२", "content_sanskrit": "तेषां प्रयास्यतां तत्र मङ्गलानि शुभान्यथ ।\nप्राहुः प्रहृष्टमनसो द्विजाग्र्या नागराश्च ये ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2209245, "chapter_id": 5469, "verse_number": "३३", "content_sanskrit": "ततः प्रदक्षिणीकृत्य शिरोभिः प्रणिपत्य च ।\nब्राह्मणानग्निसहितान् प्रययुः पाण्डवर्षभाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2209246, "chapter_id": 5469, "verse_number": "३४", "content_sanskrit": "समनुज्ञाप्य राजानं पुत्रशोकसमाहतम् ।\nधृतराष्ट्रं सभार्यं वै पृथां च पृथुलोचनाम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2209247, "chapter_id": 5469, "verse_number": "३५", "content_sanskrit": "मूले निक्षिप्य कौरव्यं युयुत्सुं धृतराष्ट्रजम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2209248, "chapter_id": 5469, "verse_number": "३६", "content_sanskrit": "सम्पूज्यमानाः पौरैश्च ब्राह्मणैश्च महर्षिभिः ।\nप्रययुः पाण्डवा वीरा नियमस्थाः शुचिव्रताः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2209249, "chapter_id": 5469, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि द्रव्यानयनार्थगमनप्रकारकथनं नाम त्रिषष्टितमोऽध्यायः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]