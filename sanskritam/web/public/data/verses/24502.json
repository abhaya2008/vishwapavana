[{"id": 7004502000, "chapter_id": 24502, "verse_number": "५-३-१९६-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेद्धराधीश हंसतीर्थमनुत्तमम् ।\nयत्र हंसस्तपस्तप्त्वा ब्रह्मवाहनतां गतः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004502001, "chapter_id": 24502, "verse_number": "५-३-१९६-२", "content_sanskrit": "हंसतीर्थे नरः स्नात्वा दानं दत्त्वा च काञ्चनम् ।\nसर्वपापविनिर्मुक्तो ब्रह्मलोकं स गच्छति॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004502002, "chapter_id": 24502, "verse_number": "५-३-१९६-३", "content_sanskrit": "हंसयुक्तेन यानेन तरुणादित्यवर्चसा ।\nसर्वकामसमृद्धेन सेव्यमानोऽप्सरोगणैः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004502003, "chapter_id": 24502, "verse_number": "५-३-१९६-४", "content_sanskrit": "तत्र भुक्त्वा यथाकामं सर्वान् भोगान् यथेप्सितान् ।\nजातिस्मरो हि जायेत पुनर्मानुष्यमागतः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004502004, "chapter_id": 24502, "verse_number": "५-३-१९६-५", "content_sanskrit": "संन्यासेन त्यजेद्देहं मोक्षमाप्नोति भारत॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004502005, "chapter_id": 24502, "verse_number": "५-३-१९६-६", "content_sanskrit": "एतत्ते कथितं पार्थ हंसतीर्थस्य यत्फलम् ।\nसर्वपापहरं पुण्यं सर्वदुःखविनाशनम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]