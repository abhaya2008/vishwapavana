[{"id": 2168303, "chapter_id": 4611, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2168304, "chapter_id": 4611, "verse_number": "१", "content_sanskrit": "स्वेन च्छन्देन नः सर्वानवधीद्व्यक्तमर्जुनः ।\nन ह्यस्य समरे मुच्येदन्तकोऽप्याततायिनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2168305, "chapter_id": 4611, "verse_number": "२", "content_sanskrit": "पार्थो ह्येकोऽहरद् भद्रामेकश्चाग्निमतर्पयत् ।\nएकश्चेमां महीं जित्वा चक्रे बलिभृतो नृपान्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2168306, "chapter_id": 4611, "verse_number": "३", "content_sanskrit": "एको निवातकवचान् अहनद् दिव्यकार्मुकः ।\nएकः किरातरूपेण स्थितं शर्वमयोधयत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2168307, "chapter_id": 4611, "verse_number": "४", "content_sanskrit": "एको ह्यरक्षद् भरतानेको भवमतोषयत् ।\nतेनैकेन जिताः सर्वे मदीया ह्युग्रतेजसः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2168308, "chapter_id": 4611, "verse_number": "५", "content_sanskrit": "न ते निन्द्याः प्रशस्यास्ते यत्ते चक्रुर्ब्रवीहि तत् ।\nततो दुर्योधनः सूत पश्चात् किमकरोत् तदा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2168309, "chapter_id": 4611, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2168310, "chapter_id": 4611, "verse_number": "६", "content_sanskrit": "हतप्रवीरा विध्वस्ता विवर्मायुधवाहनाः ।\nदीनस्वरा दूयमाना मानिनः शत्रुनिर्जिताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2168311, "chapter_id": 4611, "verse_number": "७", "content_sanskrit": "शिबिरस्थाः पुनर्मन्त्रं मन्त्रयन्ति स्म कौरवाः ।\nभग्नदंष्ट्रा हतविषाः पादाक्रान्ता इवोरगाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2168312, "chapter_id": 4611, "verse_number": "८", "content_sanskrit": "तानब्रवीत् ततः कर्णः क्रुद्धः सर्प इव श्वसन् ।\nकरं करेण निष्पीड्य प्रेक्षमाणस्तवात्मजम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2168313, "chapter_id": 4611, "verse_number": "९", "content_sanskrit": "यत्तो दृढश्च दक्षश्च धृतिमानर्जुनः सदा ।\nसम्बोधयति चाप्येनं यथाकालमधोक्षजः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2168314, "chapter_id": 4611, "verse_number": "१०", "content_sanskrit": "सहसाऽस्त्रविसर्गेण कथं तेनाद्य वञ्चिताः ।\nश्वस्त्वहं तस्य सङ्कल्पं सर्वं हन्ता महीपते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2168315, "chapter_id": 4611, "verse_number": "११", "content_sanskrit": "एवमुक्तस्तथेत्युक्त्वा सोऽनुजज्ञे नृपोत्तमान् ।\nतेऽनुज्ञाता नृपाः सर्वे स्वानि वेश्मानि भेजिरे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2168316, "chapter_id": 4611, "verse_number": "१२", "content_sanskrit": "सुखोषितास्तां रजनीं हृष्टा युद्धाय निर्ययुः ।\nतेऽपश्यन् विहितं व्यूहं धर्मराजेन दुर्जयम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2168317, "chapter_id": 4611, "verse_number": "१३", "content_sanskrit": "प्रयत्नात् कुरुमुख्येन बृहस्पत्युशनोमतात्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2168318, "chapter_id": 4611, "verse_number": "१४", "content_sanskrit": "अथ प्रतीपकर्तारं  सततं विजयात्मनः।\nसस्मार वृषभस्कन्धं कर्णं दुर्योधनस्तदा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2168319, "chapter_id": 4611, "verse_number": "१५", "content_sanskrit": "पुरन्दरसमं युद्धे मरुद्गणसमं बले ।\nकार्तवीर्यसमं वीर्ये कर्णं राज्ञोऽगमन्मनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2168320, "chapter_id": 4611, "verse_number": "१६", "content_sanskrit": "सर्वेषां चैव सैन्यानां कर्णमेवागमन्मनः ।\nसूतपुत्रं महेष्वासं बन्धुमात्यन्तिकेष्विव\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2168321, "chapter_id": 4611, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2168322, "chapter_id": 4611, "verse_number": "१७", "content_sanskrit": "यद्वोऽगमन्मनो मन्दाः कर्णं वैकर्तनं प्रति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2168323, "chapter_id": 4611, "verse_number": "१८", "content_sanskrit": "अप्यपश्यत राधेयं शीतार्ता इव भास्करम् ।\nकृतेऽवहारे सैन्यानां प्रवृत्ते च रणे पुनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2168324, "chapter_id": 4611, "verse_number": "", "content_sanskrit": "(दुर्योधनं च तत्राजौ पाण्डवेन भृशार्दितम् ।\nपराक्रान्तान् पाण्डुसुतान् दृष्ट्वाऽपि च महारणे\t॥१९॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2168325, "chapter_id": 4611, "verse_number": "२०", "content_sanskrit": "कथं वैकर्तनः कर्णस्तत्रायुध्यत सञ्जय ।\nकथं च पाण्डवाः सर्वे युयुधुस्तत्र सूतजम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2168326, "chapter_id": 4611, "verse_number": "२१", "content_sanskrit": "कर्णो ह्येको महाबाहुर्हन्यात् पार्थान् ससृञ्जयान् ।\nकर्णस्य भुजयोर्वीर्यं शक्रविष्णुसमं युधि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2168327, "chapter_id": 4611, "verse_number": "२२", "content_sanskrit": "तस्य शस्त्राणि घोराणि विक्रमश्च महात्मनः ।\nकर्णमाश्रित्य सङ्ग्रामे मत्तो दुर्योधनो नृपः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2168328, "chapter_id": 4611, "verse_number": "२३", "content_sanskrit": "जेतुमुत्सहते पार्थान् सपुत्रान् सहकेशवान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2168329, "chapter_id": 4611, "verse_number": "२४", "content_sanskrit": "(यः सौबलं तथा तात नीतिमानिति मन्यते ।\nकर्णं चाप्रतिमं युद्धे देवैरपि दुरुत्सहम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2168330, "chapter_id": 4611, "verse_number": "२५", "content_sanskrit": "मन्यतेऽभ्यधिकं पार्थादेवं चास्य हृदि स्थितम् ।\nविजेष्यति रणे कर्ण एकः पार्थान् ससोमकान्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2168331, "chapter_id": 4611, "verse_number": "", "content_sanskrit": "मम चैव सदा मन्दः शंसते नित्यमग्रतः\t॥२६॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2168332, "chapter_id": 4611, "verse_number": "२७", "content_sanskrit": "अहो बत महद् दुःखं यत्र पाण्डुसुतान् रणे ।\nनातरद् रभसः कर्णो दैवं नूनं परायणम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2168333, "chapter_id": 4611, "verse_number": "२८", "content_sanskrit": "अहो द्यूतस्य निष्ठेयं घोरा सम्प्रति वर्तते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2168334, "chapter_id": 4611, "verse_number": "२९", "content_sanskrit": "अहो तीव्राणि दुःखानि दुर्योधनकृतान्यहम् ।\nसोढा घोराणि बहुशः शल्यभूतानि सञ्जय\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2168335, "chapter_id": 4611, "verse_number": "३०", "content_sanskrit": "सौबलं च तदा तात नीतिमानिति मन्यते ।\nकर्णश्च रभसो नित्यं राजा तं चाप्यनुव्रतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2168336, "chapter_id": 4611, "verse_number": "३१", "content_sanskrit": "यदेवं वर्तमानेषु महायुद्धेषु सञ्जय ।\nअश्रौषं निहतान् पुत्रान्नित्यमेव विनिर्जितान्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2168337, "chapter_id": 4611, "verse_number": "३२", "content_sanskrit": "न पाण्डवानां समरे कश्चिदस्ति निवारकः ।\nस्त्रीमध्यमिव गाहन्ते दैवं तु बलवत्तरम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2168338, "chapter_id": 4611, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2168339, "chapter_id": 4611, "verse_number": "३३", "content_sanskrit": "राजन् पूर्वनिमित्तानि धर्मिष्ठानि विचिन्तय\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2168340, "chapter_id": 4611, "verse_number": "३४", "content_sanskrit": "अतिक्रान्तं हि यत्कार्यं पश्चाच्चिन्तयते नरः ।\nतच्चास्य न भवेत् कार्यं चिन्तया च विनश्यति\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2168341, "chapter_id": 4611, "verse_number": "३५", "content_sanskrit": "तदिदं तव कार्यं तु दूरप्राप्तं विजानतः ।\nन कृतं यत्त्वया पूर्वं प्राप्ताप्राप्तविचारणम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2168342, "chapter_id": 4611, "verse_number": "३६", "content_sanskrit": "उक्तोऽसि बहुधा राजन् मा युध्यस्वेति पाण्डवैः ।\nन च तत्त्वग्रहीर्द्वेषात् पाण्डवेषु विशाम्पते\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2168343, "chapter_id": 4611, "verse_number": "३७", "content_sanskrit": "त्वया पापानि घोराणि समाचीर्णानि पाण्डुषु ।\nत्वत्कृते वर्तते घोरः पार्थिवानां जनक्षयः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2168344, "chapter_id": 4611, "verse_number": "३८", "content_sanskrit": "तत्त्विदानीमतिक्रान्तं मा शुचो भरतर्षभ ।\nशृणु सर्वं यथावृत्तं घोरं वैशसमुच्यते\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2168345, "chapter_id": 4611, "verse_number": "३९", "content_sanskrit": "प्रभातायां रजन्यां तु कर्णो राजानमभ्ययात् ।\nसमेत्य च महाबाहुर्दुर्योधनमथाब्रवीत्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2168346, "chapter_id": 4611, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2168347, "chapter_id": 4611, "verse_number": "४०", "content_sanskrit": "अद्य राजन् समेष्यामि पाण्डवेन यशस्विना ।\nनिहनिष्यामि तं वीरं स वा मां निहनिष्यति\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2168348, "chapter_id": 4611, "verse_number": "४१", "content_sanskrit": "बहुत्वान्मम कार्याणां तथा पार्थस्य भारत ।\nनाभूत्समागमो राजन् मम चैवार्जुनस्य च\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2168349, "chapter_id": 4611, "verse_number": "४२", "content_sanskrit": "इदं तु मे महाराज शृणु वाक्यं विशाम्पते ।\nअनिहत्य रणे पार्थं नाहमेष्यामि भारत\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2168350, "chapter_id": 4611, "verse_number": "४३", "content_sanskrit": "हतप्रवीरे सैन्येऽस्मिन् मयि चावस्थिते युधि ।\nअभियास्यति मां पार्थः शक्रशक्तिविनाकृतम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2168351, "chapter_id": 4611, "verse_number": "४४", "content_sanskrit": "तत्र श्रेयस्करं यच्च तन्निबोध जनेश्वर ।\nआयुधानां च मे वीर्यं दिव्यानामर्जुनस्य च\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2168352, "chapter_id": 4611, "verse_number": "४५", "content_sanskrit": "कायस्य महतो भेदे लाघवे दूरपातने ।\nसौष्टवे चास्त्रवीर्ये च सव्यसाची न मत्समः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2168353, "chapter_id": 4611, "verse_number": "४६", "content_sanskrit": "प्राणे शौर्येऽथ विज्ञाने विक्रमे चापि भारत ।\nनिमित्तज्ञानयोगे च सव्यसाची न मत्समः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2168354, "chapter_id": 4611, "verse_number": "४७", "content_sanskrit": "सर्वायुधमहामात्रं विजयं नाम तद्धनुः ।\nइन्द्रार्थं प्रियकामेन निर्मितं विश्वकर्मणा\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2168355, "chapter_id": 4611, "verse_number": "४८", "content_sanskrit": "येन दैत्यगणान् राजन् जितवान् वै शतक्रतुः ।\nतस्य घोषेण दैत्यानां व्यामुह्यन्त दिशो दश\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2168356, "chapter_id": 4611, "verse_number": "४९", "content_sanskrit": "तद् भार्गवाय प्रायच्छत् शक्रः परमसम्मतम् ।\nतद्दिव्यं भार्गवो मह्यमददद् धनुरुत्तमम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2168357, "chapter_id": 4611, "verse_number": "५०", "content_sanskrit": "तेन योत्स्ये महाबाहुमर्जुनं जयतां वरम् ।\nयथेन्द्रः समरे सर्वान् दैतेयान् वै समागतान्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2168358, "chapter_id": 4611, "verse_number": "", "content_sanskrit": "(निजघान तथा सर्वान् जेष्यामि युधि पाण्डवान्\t॥५१॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2168359, "chapter_id": 4611, "verse_number": "५२", "content_sanskrit": "धनुर्घोरं रामदत्तं गाण्डीवात् तद् विशिष्यते ।\nत्रिःसप्तकृत्वः पृथिवी धनुषा येन निर्जिता\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2168360, "chapter_id": 4611, "verse_number": "५३", "content_sanskrit": "धनुषो ह्यस्य कर्माणि दिव्यानि प्राह भार्गवः ।\nतद्रामो ह्यददान्मह्यं तेन योत्स्यामि पाण्डवम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2168361, "chapter_id": 4611, "verse_number": "५४", "content_sanskrit": "अद्य दुर्योधनाहं त्वां नन्दयिष्ये सबान्धवम् ।\nनिहत्य समरे वीरमर्जुनं जयतां वरम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2168362, "chapter_id": 4611, "verse_number": "५५", "content_sanskrit": "सपर्वतवनद्वीपा हतद्विट्सागराम्बरा ।\nपुत्रपौत्रप्रतिष्ठा ते भविष्यत्यद्य मेदिनी\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2168363, "chapter_id": 4611, "verse_number": "५६", "content_sanskrit": "नाशक्यं विद्यते मेऽद्य त्वत्प्रियार्थं विशेषतः ।\nसत्यधर्मानुरक्तस्य सिद्धिरात्मवतो यथा\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2168364, "chapter_id": 4611, "verse_number": "५७", "content_sanskrit": "न हि मे विक्रमं सोढुं स शक्तोऽग्निं तरुर्यथा ।\nअवश्यं तु मया वाच्यं येन हीनोऽस्मि फल्गुनात्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2168365, "chapter_id": 4611, "verse_number": "५८", "content_sanskrit": "ज्या तस्य धनुषो दिव्या तथाऽक्षय्यौ महेषुधी ।\nसारथिस्तस्य गोविन्दो मम तादृङ् न विद्यते\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2168366, "chapter_id": 4611, "verse_number": "५९", "content_sanskrit": "तस्य दिव्यं धनुः श्रेष्ठं गाण्डीवमजितं युधि ।\nविजयं च महद्दिव्यं ममापि धनुरुत्तमम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2168367, "chapter_id": 4611, "verse_number": "६०", "content_sanskrit": "तत्राहमधिकः पार्थाद् धनुषा तेन पार्थिव ।\nयेन चाप्यधिको वीरः पाण्डवस्तन्निबोध मे\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2168368, "chapter_id": 4611, "verse_number": "६१", "content_sanskrit": "रश्मिग्राहश्च दाशार्हः सर्वलोकनमस्कृतः ।\nअग्निदत्तश्च वै दिव्यो रथः काञ्चनभूषणः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2168369, "chapter_id": 4611, "verse_number": "६२", "content_sanskrit": "अच्छेद्याः सर्वतो वीर वाजिनश्च मनोजवाः ।\nध्वजश्च दिव्यो द्युतिमान् वानरोऽपि भयङ्करः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2168370, "chapter_id": 4611, "verse_number": "६३", "content_sanskrit": "कृष्णश्च जगतः स्रष्टा रथं तमभिरक्षति ।\nएभिस्त्रिभिरहं हीनो योद्धुमिच्छामि पाण्डवम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2168371, "chapter_id": 4611, "verse_number": "६४", "content_sanskrit": "अयं तु सदृशः शौरेः शल्यः समितिशोभनः ।\nसारथ्यं यदि मे कुर्याद् ध्रुवस्ते विजयो भवेत्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2168372, "chapter_id": 4611, "verse_number": "६५", "content_sanskrit": "तस्य मे सारथिः शल्यो भवत्वसुकरः परैः ।\nनाराचान् गार्ध्रपत्रांश्च शकटानि वहन्तु मे\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2168373, "chapter_id": 4611, "verse_number": "६६", "content_sanskrit": "रथाश्च मुख्या राजेन्द्र युक्ता वाजिभिरुत्तमैः ।\nआयान्तु पश्चात्सततं मामेव भरतर्षभ\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2168374, "chapter_id": 4611, "verse_number": "६७", "content_sanskrit": "एवमभ्यधिकः पार्थाद् भविष्यामि गुणैरहम् ।\nशल्योप्यभ्यधिकः कृष्णादर्जुनादपि चाप्यहम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2168375, "chapter_id": 4611, "verse_number": "६८", "content_sanskrit": "यथाऽश्वहृदयं वेद दाशार्हः परवीरहा ।\nतथा शल्यो विजानीते हयज्ञानं महारथः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2168376, "chapter_id": 4611, "verse_number": "६९", "content_sanskrit": "बाहुवीर्ये समो नास्ति मद्रराजस्य कश्चन ।\nतथाऽस्त्रे मत्समो नास्ति कश्चिदेव धनुर्धरः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2168377, "chapter_id": 4611, "verse_number": "७०", "content_sanskrit": "तथा शल्यसमो नास्ति हयज्ञाने हि कश्चन ।\nसोऽयमभ्यधिकः पार्थाद् भविष्यति रथो मम\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2168378, "chapter_id": 4611, "verse_number": "७१", "content_sanskrit": "समुद्यन्तं न शक्ष्यन्ति देवा अपि सवासवाः ।\nएतत्कृतं महाराज त्वयेच्छामि परन्तप\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2168379, "chapter_id": 4611, "verse_number": "७२", "content_sanskrit": "क्रियतामेष कामो मे मा वः कालोऽत्यगादयम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2168380, "chapter_id": 4611, "verse_number": "", "content_sanskrit": "(एवं कृते रथस्थोऽहं गुणैरभ्यधिकोऽर्जुनात् ।\nविजयेयमहं सङ्खे फल्गुनं कुरुसत्तम\t॥७३॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2168381, "chapter_id": 4611, "verse_number": "७४", "content_sanskrit": "एवं कृते कृतं साह्यं त्वया सर्वं भविष्यति\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2168382, "chapter_id": 4611, "verse_number": "७५", "content_sanskrit": "ततो द्रक्ष्यसि सङ्ग्रामे यत्करिष्यामि भारत ।\nसर्वथा पाण्डवान् सङ्खे विजेष्ये वै समागतान्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2168383, "chapter_id": 4611, "verse_number": "७६", "content_sanskrit": "न हि मे समरे शक्ताः समुद्यातुं सुरासुराः ।\nकिमु पाण्डुसुता राजन् रणे मानुषयोनयः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2168384, "chapter_id": 4611, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2168385, "chapter_id": 4611, "verse_number": "७७", "content_sanskrit": "एवमुक्तस्तव सुतः कर्णेनाहवशोभिना ।\nसम्पूज्य सम्प्रहृष्टात्मा ततो राधेयमब्रवीत्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2168386, "chapter_id": 4611, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2168387, "chapter_id": 4611, "verse_number": "७८", "content_sanskrit": "सर्वमेतत्करिष्यामि यथा त्वं कर्ण मन्यसे ।\nसोपासङ्गा रथाः साश्वाः स्वनुयास्यन्ति संयुगे\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2168388, "chapter_id": 4611, "verse_number": "७९", "content_sanskrit": "नाराचान् गार्ध्रपत्रांश्च शकटानि वहन्तु ते ।\nअनुयास्याम कर्ण त्वां वयं सर्वे च पार्थिवाः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2168389, "chapter_id": 4611, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2168390, "chapter_id": 4611, "verse_number": "८०", "content_sanskrit": "एवमुक्त्वा महाराज तव पुत्रः प्रतापवान् ।\nअभिगम्याब्रवीद् राजा मद्रराजमिदं वचः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2168391, "chapter_id": 4611, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nएकत्रिंशोऽध्यायः ॥३१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]