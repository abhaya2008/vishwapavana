[{"id": 6000003000, "chapter_id": 10003, "verse_number": null, "content_sanskrit": "अथ तृतीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "द्वादशस्कन्धात्मकं समग्रं भागवतमपि पूर्वोक्तानां षट्प्रश्नानामेव विवरणरूपं ज्ञातव्यम्", "range": null}]}, {"id": 6000003001, "chapter_id": 10003, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.001.m4a", "display_order": 2}, {"id": 6000003002, "chapter_id": 10003, "verse_number": "१-३-१", "content_sanskrit": "जगृहे पौरुषं रूपं भगवान् महदादिभिः।\nसम्भूतं षोडशकलमादौ लोकसिसृक्षया॥ १/३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.002.m4a", "display_order": 3, "topics": [{"text": "सूतपौराणिकेन शौनकादीन् प्रति संक्षेपेण भगवतः पुरुषाद्यवतारोक्त्या पञ्चमप्रश्नस्योत्तरम्", "range": "१–४४"}]}, {"id": 6000003003, "chapter_id": 10003, "verse_number": "१-३-२", "content_sanskrit": "यस्याम्भसि शयानस्य योगनिद्रां वितन्वतः।\nनाभिह्रदाम्बुजादासीद्ब्रह्मा विश्‍वसृजां पतिः॥ १/३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.003.m4a", "display_order": 4}, {"id": 6000003004, "chapter_id": 10003, "verse_number": "१-३-३", "content_sanskrit": "यस्यावयवसंस्थानैः कल्पितो लोकविस्तरः।\nतद्वै भगवतो रूपं विशुद्धं सत्त्वमूर्जितम्॥ १/३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.004.m4a", "display_order": 5}, {"id": 6000003005, "chapter_id": 10003, "verse_number": "१-३-४", "content_sanskrit": "पश्यन्त्यदो रूपमदभ्रचक्षुषः सहस्रपादोरुभुजाननाद्भुतम्।\nसहस्रमूर्धश्रवणाक्षिनासिकं सहस्रमौल्यम्बरकुण्डलोल्‍लसत्॥ १/३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.005.m4a", "display_order": 6}, {"id": 6000003006, "chapter_id": 10003, "verse_number": "१-३-५", "content_sanskrit": "एतन्नानावताराणां निधानं बीजमव्ययम्।\nयस्यांशांशेन सृज्यन्ते देवतिर्यङ्नरादयः॥ १/३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.006.m4a", "display_order": 7}, {"id": 6000003007, "chapter_id": 10003, "verse_number": "१-३-६", "content_sanskrit": "स एव प्रथमं देवः कौमारं सर्गमास्थितः।\nचचार दुश्‍चरं ब्रह्मा ब्रह्मचर्यमखण्डितम्॥ १/३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.007.m4a", "display_order": 8}, {"id": 6000003008, "chapter_id": 10003, "verse_number": "१-३-७", "content_sanskrit": "द्वितीयं तु भवायास्य रसातलगतां महीम्।\nउद्धरिष्यन्नुपादत्त यज्ञेशः सौकरं वपुः॥ १/३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.008.m4a", "display_order": 9}, {"id": 6000003009, "chapter_id": 10003, "verse_number": "१-३-८", "content_sanskrit": "तृतीयमृषिसर्गं वै देवर्षित्वमुपेत्य सः।\nतन्त्रं सात्वतमाचष्‍ट नैष्कर्म्यं कर्मणां यतः॥ १/३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.009.m4a", "display_order": 10}, {"id": 6000003010, "chapter_id": 10003, "verse_number": "१-३-९", "content_sanskrit": "तुर्यं धर्मकलासर्गः नरनारायणावृषी।\nभूत्वाऽऽत्मोपशमोपेतमकरोद्दुश्‍चरं तपः॥ १/३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.010.m4a", "display_order": 11}, {"id": 6000003011, "chapter_id": 10003, "verse_number": "१-३-१०", "content_sanskrit": "पञ्चमः कपिलो नाम सिद्धेशः कालविप्लुतम्।\nप्रोवाचाऽसुरये साङ्ख्यं तत्त्वग्रामविनिर्णयम्॥ १/३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.011.m4a", "display_order": 12}, {"id": 6000003012, "chapter_id": 10003, "verse_number": "१-३-११", "content_sanskrit": "षष्‍ठमत्रेरपत्यत्वं वृतः प्राप्‍तोऽनसूयया।\nआन्वीक्षिकीमलर्काय प्रह्लादादिभ्य ऊचिवान्॥ १/३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.012.m4a", "display_order": 13}, {"id": 6000003013, "chapter_id": 10003, "verse_number": "१-३-१२", "content_sanskrit": "ततः सप्‍तम आकूत्यां रुचेर्यज्ञोऽभ्यजायत।\nस यामाद्यैः सुरगणैरपात्स्वायम्भुवान्तरम्॥ १/३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.013.m4a", "display_order": 14}, {"id": 6000003014, "chapter_id": 10003, "verse_number": "१-३-१३", "content_sanskrit": "अष्‍टमो मेरुदेव्यां तु नाभेर्जात उरुक्रमः।\nदर्शयन्वर्त्म धीराणां सर्वाश्रमनमस्कृतम्॥ १/३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.014.m4a", "display_order": 15}, {"id": 6000003015, "chapter_id": 10003, "verse_number": "१-३-१४", "content_sanskrit": "ऋषिभिर्याचितो भेजे नवमं पार्थिवं वपुः।\nदुग्धवानोेषधीर्विप्रास्तेनायं च उशत्तमः॥ १/३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.015.m4a", "display_order": 16}, {"id": 6000003016, "chapter_id": 10003, "verse_number": "१-३-१५", "content_sanskrit": "रूपं स जगृहे मात्स्यं चाक्षुषान्तरसंप्‍लवे।\nनाव्यारोप्य महीमय्यामपाद्वैवस्वतं मनुम्॥ १/३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.016.m4a", "display_order": 17}, {"id": 6000003017, "chapter_id": 10003, "verse_number": "१-३-१६", "content_sanskrit": "सुरासुराणामुदधिं मथ्नतां मन्दराचलम्।\nदध्रे कमठरूपेण पृष्‍ठ एकादशं विदुः॥ १/३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.017.m4a", "display_order": 18}, {"id": 6000003018, "chapter_id": 10003, "verse_number": "१-३-१७", "content_sanskrit": "धान्वन्तरं द्वादशमं त्रयोदशममेव च।\nअपाययत्सुधामन्यान् मोहिन्या मोहयन् स्‍त्रिया॥ १/३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.018.m4a", "display_order": 19}, {"id": 6000003019, "chapter_id": 10003, "verse_number": "१-३-१८", "content_sanskrit": "चतुर्दशं नारसिंहं विभ्रद्दैत्येन्द्रमूर्जितम्।\nददार करजैरूरावेरकान् कटकृद्यथा॥ १/३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.019.m4a", "display_order": 20}, {"id": 6000003020, "chapter_id": 10003, "verse_number": "१-३-१९", "content_sanskrit": "पञ्चदशं वामनकं कृत्वाऽगादध्वरं बलेः।\nपदत्रयं याचमानः प्रत्यादित्सुस्‍त्रिविष्‍टपम्॥ १/३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.020.m4a", "display_order": 21}, {"id": 6000003021, "chapter_id": 10003, "verse_number": "१-३-२०", "content_sanskrit": "अवतारे षोडशमे यच्छन्ब्रह्मद्रुहो नृपान्।\nत्रिःसप्‍तकृत्वः कुपितो निःक्षत्रामकरोन्महीम्॥ १/३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.021.m4a", "display_order": 22}, {"id": 6000003022, "chapter_id": 10003, "verse_number": "१-३-२१", "content_sanskrit": "ततः सप्‍तदशे जातः सत्यवत्यां पराशरात्।\nचक्रे वेदतरोः शाखा दृष्‍ट्वा पुंसोऽल्पमेधसः॥ १/३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.022.m4a", "display_order": 23}, {"id": 6000003023, "chapter_id": 10003, "verse_number": "१-३-२२", "content_sanskrit": "नरदेवत्वमापन्नः सुरकार्यचिकिर्षया।\nसमुद्रनिग्रहादीनि चक्रे वीर्याण्यतःपरम्॥ १/३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.023.m4a", "display_order": 24}, {"id": 6000003024, "chapter_id": 10003, "verse_number": "१-३-२३", "content_sanskrit": "एकोनविंशे विंशतिमे वृष्णिषु प्राप्य जन्मनी।\nरामकृष्णाविति भुवो भगवानहरद्भरम्॥ १/३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.024.m4a", "display_order": 25}, {"id": 6000003025, "chapter_id": 10003, "verse_number": "१-३-२४", "content_sanskrit": "ततः कलौ सम्प्रवृत्ते सम्मोहाय सुरद्विषाम्।\nबुद्धो नाम्ना जिनसुतः कीकटेषु भविष्यति॥ १/३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.025.m4a", "display_order": 26}, {"id": 6000003026, "chapter_id": 10003, "verse_number": "१-३-२५", "content_sanskrit": "अथासौ युगसन्ध्यायां दस्युप्रायेषु राजसु।\nजनिता विष्णुयशसो नाम्ना कल्की जगत्पतिः॥ १/३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.026.m4a", "display_order": 27}, {"id": 6000003027, "chapter_id": 10003, "verse_number": "१-३-२६", "content_sanskrit": "अवतारा ह्यसंख्येया हरेः सत्त्वनिधेर्द्विजाः।\nयथा विदासिनः कुल्याः सरसः स्युः सहस्रशः॥ १/३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.027.m4a", "display_order": 28}, {"id": 6000003028, "chapter_id": 10003, "verse_number": "१-३-२७", "content_sanskrit": "ऋषयो मनवो देवा मनुपुत्रा महौजसः।\nकलाः सर्वे हरेरेव सप्रजापतयः स्मृताः॥ १/३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.028.m4a", "display_order": 29}, {"id": 6000003029, "chapter_id": 10003, "verse_number": "१-३-२८", "content_sanskrit": "एते स्वांशकलाः पुंसः कृष्णस्तु भगवान् स्वयम्।\nइन्द्रारिव्याकुलं लोकं मृडयन्ति युगे युगे॥ १/३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.029.m4a", "display_order": 30}, {"id": 6000003030, "chapter_id": 10003, "verse_number": "१-३-२९", "content_sanskrit": "जन्म गुह्यं भगवतो य एवं प्रयतो नरः।\nसायम्प्रातर्गृणन् भक्‍त्या दुःखग्रामाद्विमुच्यते॥ १/३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.030.m4a", "display_order": 31}, {"id": 6000003031, "chapter_id": 10003, "verse_number": "१-३-३०", "content_sanskrit": "एतद्रूपं भगवतो ह्यरूपस्य चिदात्मनः।\nमायागुणैर्विरचितं महदादिभिरात्मनि॥ १/३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.031.m4a", "display_order": 32}, {"id": 6000003032, "chapter_id": 10003, "verse_number": "१-३-३१", "content_sanskrit": "यथा नभसि मेघौघा रेणुर्वा पार्थिवोऽनिले।\nएवं द्रष्‍टरि दृश्यत्वमारोपितमबुद्धिभिः॥ १/३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.032.m4a", "display_order": 33}, {"id": 6000003033, "chapter_id": 10003, "verse_number": "१-३-३२", "content_sanskrit": "अतः परं यदव्यक्‍तमव्यूढगुणबृंहितम्।\nअदृष्‍टाश्रुतवस्तुत्वात्स जीवो यः पुनर्भवः॥ १/३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.033.m4a", "display_order": 34}, {"id": 6000003034, "chapter_id": 10003, "verse_number": "१-३-३३", "content_sanskrit": "यत्रेमे सदसद्रूपे प्रतिषिद्धे स्वसंविदा।\nअविद्ययाऽऽत्मनि कृते इति तद्ब्रह्मदर्शनम्॥ १/३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.034.m4a", "display_order": 35}, {"id": 6000003035, "chapter_id": 10003, "verse_number": "१-३-३४", "content_sanskrit": "यद्येषोपरता देवी माया वैशारदी मतिः।\nसंपन्न एवेति विदुर्महिम्नि स्वे महीयते॥ १/३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.035.m4a", "display_order": 36}, {"id": 6000003036, "chapter_id": 10003, "verse_number": "१-३-३५", "content_sanskrit": "एवं जन्मानि कर्माणि ह्यकर्तुरजनस्य च।\nवर्णयन्ति स्म कवयो वेदगुह्यानि हृत्पतेः॥ १/३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.036.m4a", "display_order": 37}, {"id": 6000003037, "chapter_id": 10003, "verse_number": "१-३-३६", "content_sanskrit": "स वा इदं विश्‍वममोघलीलः सृजत्यवत्यत्ति न सज्‍जतेऽस्मिन्।\nभूतेषु चान्तर्हित आत्मतन्त्रः षाड्वर्गिकं जिघ्रति षड्गुणेशः॥ १/३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.037.m4a", "display_order": 38}, {"id": 6000003038, "chapter_id": 10003, "verse_number": "१-३-३७", "content_sanskrit": "न चास्य कश्‍चिन्निपुणं विधातुरवैति जन्तुः कुमनीष ऊतिम्।\nनामानि रूपाणि मनोवचोभिः सन्तन्वतो नटचर्यामिवाज्ञः॥ १/३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.038.m4a", "display_order": 39}, {"id": 6000003039, "chapter_id": 10003, "verse_number": "१-३-३८", "content_sanskrit": "स वेद धातुः पदवीं पदस्य दुरन्तवीर्यस्य रथाङ्गपाणेः।\nयोऽमायया सन्ततयाऽनुवृत्त्या भजेत तत्पादसरोजगन्धम्॥ १/३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.039.m4a", "display_order": 40}, {"id": 6000003040, "chapter_id": 10003, "verse_number": "१-३-३९", "content_sanskrit": "अथेह धन्या भगवन्त इत्थं यद्वासुदेवेऽखिललोकनाथे।\nकुर्वन्ति सर्वात्मक आत्मभावे न यत्र भूयः परिवर्त उग्रः॥ १/३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.040.m4a", "display_order": 41}, {"id": 6000003041, "chapter_id": 10003, "verse_number": "१-३-४०", "content_sanskrit": "इदं भागवतं नाम पुराणं ब्रह्मसंमितम्।\nउत्तमश्लोकचरितं चकार भगवानृषिः॥ १/३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.041.m4a", "display_order": 42}, {"id": 6000003042, "chapter_id": 10003, "verse_number": "१-३-४१", "content_sanskrit": "निःश्रेयसाय लोकस्य धन्यं स्वस्त्ययनं महत्।\nतदिदं ग्राहयामास सुतमात्मवतां वरम्॥ १/३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.042.m4a", "display_order": 43}, {"id": 6000003043, "chapter_id": 10003, "verse_number": "१-३-४२", "content_sanskrit": "सर्ववेदेतिहासानां सारं सारं समुद्धृतम्।\nस तु संश्रावयामास महाराजं परीक्षितम्॥ १/३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.043.m4a", "display_order": 44}, {"id": 6000003044, "chapter_id": 10003, "verse_number": "१-३-४३", "content_sanskrit": "प्रायोपविष्‍टं गङ्गायां परीतं परमर्षिभिः।\nतस्य कीर्तयतो विप्रा राजर्षेर्भूरितेजसः॥ १/३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.044.m4a", "display_order": 45}, {"id": 6000003045, "chapter_id": 10003, "verse_number": "१-३-४४", "content_sanskrit": "अहं चाध्यगमं तत्र निविष्‍टस्तदनुग्रहात्।\nसोऽहं वः श्रावयिष्यामि यथाऽधीतं यथामति॥ १/३/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.045.m4a", "display_order": 46}, {"id": 6000003046, "chapter_id": 10003, "verse_number": "१-३-४५", "content_sanskrit": "कृष्णे स्वधामोपगते धर्मज्ञानादिभिः सह।\nकलौ नष्‍टदृशां पुंसां पुराणार्कोऽमुनोदितः॥ १/३/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_003/BhP_01.003.046.m4a", "display_order": 47, "topics": [{"text": "‘धर्मः पुराणश्रेष्‍ठं श्रीमद्भागवतमेव शरणं प्राप्‍तः’ इति षष्‍ठस्य प्रश्नस्योत्तरम्", "range": "४५"}]}, {"id": 6000003047, "chapter_id": 10003, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे तृतीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]