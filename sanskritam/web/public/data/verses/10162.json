[{"id": 6000162000, "chapter_id": 10162, "verse_number": null, "content_sanskrit": "अथ नवमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000162001, "chapter_id": 10162, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.001.m4a", "display_order": 2}, {"id": 6000162002, "chapter_id": 10162, "verse_number": "८-९-१", "content_sanskrit": "इति दानवदैतेया नाविन्दन्नमृतं नृप।\nयुक्ताः कर्मणि यत्ताश्च नारायणपराङ्मुखाः॥ ८/९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.002.m4a", "display_order": 3, "topics": [{"text": "दैत्यैर्मत्सराद्देवैस्सह युद्धारम्भः", "range": "१–५१"}]}, {"id": 6000162003, "chapter_id": 10162, "verse_number": "८-९-२", "content_sanskrit": "साधयित्वाऽमृतं राजन् पाययित्वाऽमृतं सुरान्।\nपश्यतां सर्वभूतानां ययौ गरुडवाहनः॥ ८/९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.003.m4a", "display_order": 4}, {"id": 6000162004, "chapter_id": 10162, "verse_number": "८-९-३", "content_sanskrit": "सपत्नानां परामृद्धिं दृष्ट्वा च दितिनन्दनाः।\nअमृष्यमाणा उत्पेतुर्देवान् प्रत्युद्यतायुधाः॥ ८/९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.004.m4a", "display_order": 5}, {"id": 6000162005, "chapter_id": 10162, "verse_number": "८-९-४", "content_sanskrit": "ततः सुरगणाः सर्वे सुधया पीतयैधिताः।\nप्रतिसंयुयुधुः शस्‍त्रैर्नारायणपरायणाः॥ ८/९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.005.m4a", "display_order": 6}, {"id": 6000162006, "chapter_id": 10162, "verse_number": "८-९-५", "content_sanskrit": "तत्र देवासुरो नाम रणः परमदारुणः।\nरोधस्युदन्वतो राजन् तुमुलो रोमहर्षणः॥ ८/९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.006.m4a", "display_order": 7}, {"id": 6000162007, "chapter_id": 10162, "verse_number": "८-९-६", "content_sanskrit": "तत्रान्योन्यं सपत्नास्ते संरब्धमनसो रणे।\nसमासाद्यासिभिर्बाणैर्निजघ्नुर्विविधायुधैः॥ ८/९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.007.m4a", "display_order": 8}, {"id": 6000162008, "chapter_id": 10162, "verse_number": "८-९-७", "content_sanskrit": "शङ्खतूर्यमृदङ्गानां भेरीडमरिणां महान्।\nहस्त्यश्वरथपत्तीनां नदतां निस्स्वनोऽभवत्॥ ८/९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.008.m4a", "display_order": 9}, {"id": 6000162009, "chapter_id": 10162, "verse_number": "८-९-८", "content_sanskrit": "रथिनो रथिभिस्तत्र पत्तिभिः सह पत्तयः।\nहया हयैरिभैश्चेभाः समसज्जन्त संयुगे॥ ८/९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.009.m4a", "display_order": 10}, {"id": 6000162010, "chapter_id": 10162, "verse_number": "८-९-९", "content_sanskrit": "उष्ट्रैः केचिद् द्विजैः केचिदपरेऽभिययुः खरैः।\nकेचिद् गौरमृगैर्ऋक्षैर्द्वीपिभिर्हरिभिर्भटाः॥ ८/९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.010.m4a", "display_order": 11}, {"id": 6000162011, "chapter_id": 10162, "verse_number": "८-९-१०", "content_sanskrit": "गृध्रैः कङ्कैर्बकैरन्ये श्येनैर्भासैस्तिमिङ्गिलैः।\nशरभैर्महिषैः खड्गैर्गोवृषैर्गवयारुणैः॥ ८/९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.011.m4a", "display_order": 12}, {"id": 6000162012, "chapter_id": 10162, "verse_number": "८-९-११", "content_sanskrit": "शिवाभिराखुभिः केचित् कृकलासैः शशैर्नरैः।\nबस्तैरेके कृष्णसारैर्हंसैरन्ये च सूकरैः॥ ८/९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.012.m4a", "display_order": 13}, {"id": 6000162013, "chapter_id": 10162, "verse_number": "८-९-१२", "content_sanskrit": "अन्ये जलस्थलखगैः सत्त्वैर्विकृतविग्रहैः।\nसेनयोरुभयो राजन् विविशुस्तेऽग्रतोऽग्रतः॥ ८/९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.013.m4a", "display_order": 14}, {"id": 6000162014, "chapter_id": 10162, "verse_number": "८-९-१३", "content_sanskrit": "चित्रध्वजपटै राजन्नातपत्रैः सितामलैः।\nमहाधनैर्वज्रदण्डैर्विभ्राजद्बार्हचामरैः॥ ८/९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.014.m4a", "display_order": 15}, {"id": 6000162015, "chapter_id": 10162, "verse_number": "८-९-१४", "content_sanskrit": "वातोद्धूतोत्तरोष्णीषैः सत्कृतैर्वर्मभूषणैः।\nस्फुरद्भिर्विशदैः शस्‍त्रैः सुतरां सूर्यरश्मिभिः॥ ८/९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.015.m4a", "display_order": 16}, {"id": 6000162016, "chapter_id": 10162, "verse_number": "८-९-१५", "content_sanskrit": "देवदानववीराणां ध्वजिन्यौ पाण्डुनन्दन।\nरेजतुर्वीचिमालाभिर्यादसामिव सागरे॥ ८/९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.016.m4a", "display_order": 17}, {"id": 6000162017, "chapter_id": 10162, "verse_number": "८-९-१६", "content_sanskrit": "वैरोचनो बलिः सङ्ख्ये सोऽसुराणां चमूपतिः।\nयानं वैहायसं नाम कामगं मयनिर्मितम्॥ ८/९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.017.m4a", "display_order": 18}, {"id": 6000162018, "chapter_id": 10162, "verse_number": "८-९-१७", "content_sanskrit": "सर्वसाङ्ग्रामिकोपेतं सर्वाश्चर्यमयं प्रभो।\nअप्रतर्क्यमनिर्देश्यं दृश्यमानमदर्शनम्॥ ८/९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.018.m4a", "display_order": 19}, {"id": 6000162019, "chapter_id": 10162, "verse_number": "८-९-१८", "content_sanskrit": "आस्थितस्तद्विमानाग्र्यं सर्वानीकाधिपैर्वृतः।\nवालव्यजनच्छत्राग्र्यै रेजे चन्द्र इवोदये॥ ८/९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.019.m4a", "display_order": 20}, {"id": 6000162020, "chapter_id": 10162, "verse_number": "८-९-१९", "content_sanskrit": "तस्यासन् सर्वतो यानैर्यूथानां पतयोऽसुराः।\nनमुचिः शम्बरो बाणो विप्रचित्तिरयोमुखः॥ ८/९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.020.m4a", "display_order": 21}, {"id": 6000162021, "chapter_id": 10162, "verse_number": "८-९-२०", "content_sanskrit": "द्विमूर्धा कालनाभोऽथ प्रहेतिर्हेतिरिल्वलः।\nशकुनिर्भूतसन्तापो वज्रदंष्ट्रो विरोचनः॥ ८/९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.021.m4a", "display_order": 22}, {"id": 6000162022, "chapter_id": 10162, "verse_number": "८-९-२१", "content_sanskrit": "हयग्रीवः शङ्कुशिराः कपिलो मेघदुन्दुभिः।\nतारकश्चक्रदृक् शुम्भो निशुम्भो जम्भ उत्कलः॥ ८/९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.022.m4a", "display_order": 23}, {"id": 6000162023, "chapter_id": 10162, "verse_number": "८-९-२२", "content_sanskrit": "अरिष्टोऽरिष्टनेमिश्च मयश्च त्रिपुराधिपः।\nअन्ये पौलोमकालेया निवातकवचादयः॥ ८/९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.023.m4a", "display_order": 24}, {"id": 6000162024, "chapter_id": 10162, "verse_number": "८-९-२३", "content_sanskrit": "अलब्धभागाः सोमस्य केवलं क्लेशभागिनः।\nसर्व एते रणमुखे बहुशो निर्जितामराः॥ ८/९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.024.m4a", "display_order": 25}, {"id": 6000162025, "chapter_id": 10162, "verse_number": "८-९-२४", "content_sanskrit": "सिंहनादं विमुञ्चन्तः शङ्खान् दध्मुर्महारवान्।\nदृष्ट्वा सपत्नानुत्सिक्तान् बलभित् कुपितो भृशम्॥ ८/९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.025.m4a", "display_order": 26}, {"id": 6000162026, "chapter_id": 10162, "verse_number": "८-९-२५", "content_sanskrit": "ऐरावतं दिक्‍करिणमारूढो वियति स्वराट्।\nयथा स्रवत्प्रस्रवणमुदयाद्रिमहर्पतिः॥ ८/९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.026.m4a", "display_order": 27}, {"id": 6000162027, "chapter_id": 10162, "verse_number": "८-९-२६", "content_sanskrit": "तस्यासन् सर्वतो देवा नानावाहध्वजायुधाः।\nलोकपालाः सह गणैर्वाय्वग्निवरुणादयः॥ ८/९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.027.m4a", "display_order": 28}, {"id": 6000162028, "chapter_id": 10162, "verse_number": "८-९-२७", "content_sanskrit": "तेऽन्योन्यमभिसंसृत्य क्षिपन्तो नामभिर्मिथः।\nआह्वयन्तो विशन्तोऽग्रे युयुधुर्द्वन्द्वयोधिनः॥ ८/९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.028.m4a", "display_order": 29}, {"id": 6000162029, "chapter_id": 10162, "verse_number": "८-९-२८", "content_sanskrit": "युयुधे बलिरिन्द्रेण तारकेण दिवस्पतिः।\nवरुणो हेतिनाऽयुध्यन्मित्रो राजन् प्रहेतिना॥ ८/९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.029.m4a", "display_order": 30}, {"id": 6000162030, "chapter_id": 10162, "verse_number": "८-९-२९", "content_sanskrit": "यमस्तु कालनाभेन विश्वकर्मा मयेन वै।\nशम्बरो युयुधे त्वष्ट्रा सवित्रा तु विरोचनः॥ ८/९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.030.m4a", "display_order": 31}, {"id": 6000162031, "chapter_id": 10162, "verse_number": "८-९-३०", "content_sanskrit": "अपराजितेन नमुचिरश्विनौ वृषपर्वणा।\nसूर्यो बलिसुतैर्देवो बाणज्येष्ठशतेन सः॥ ८/९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.031.m4a", "display_order": 32}, {"id": 6000162032, "chapter_id": 10162, "verse_number": "८-९-३१", "content_sanskrit": "राहुणा च तथा सोमः पुलोम्ना युयुधेऽनिलः।\nनिशुम्भशुम्भयोर्देवी भद्रकाली नराशनी॥ ८/९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.032.m4a", "display_order": 33}, {"id": 6000162033, "chapter_id": 10162, "verse_number": "८-९-३२", "content_sanskrit": "वृषाकपिस्तु जम्भेन महिषेण विभावसुः।\nइल्वलः सहवातापिर्ब्रह्मपुत्रैररिन्दम॥ ८/९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.033.m4a", "display_order": 34}, {"id": 6000162034, "chapter_id": 10162, "verse_number": "८-९-३३", "content_sanskrit": "कामदेवेन दुर्मर्ष उत्कलो मातृभिः सह।\nबृहस्पतिस्तूशनसा नरकेण शनैश्चरः॥ ८/९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.034.m4a", "display_order": 35}, {"id": 6000162035, "chapter_id": 10162, "verse_number": "८-९-३४", "content_sanskrit": "मरुतो निवातकवचैः कालेयैर्वसवोऽमराः।\nविश्वेदेवास्तु पौलोमै रुद्राः क्रोधवशैः सह॥ ८/९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.035.m4a", "display_order": 36}, {"id": 6000162036, "chapter_id": 10162, "verse_number": "८-९-३५", "content_sanskrit": "त एवमाजावसुराः सुरेन्द्रा द्वन्द्वेन संहत्य च युध्यमानाः।\nअन्योन्यमासाद्य निजघ्नुरोजसा जिगीषवस्तीक्ष्णशरांश्च चिक्षिपुः॥ ८/९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.036.m4a", "display_order": 37}, {"id": 6000162037, "chapter_id": 10162, "verse_number": "८-९-३६", "content_sanskrit": "भूशुण्डिभिश्चक्रगदर्ष्टिपट्टिशैः शक्त्युल्मुकैः प्रासपरश्वधैरपि।\nनिस्‍त्रिंशभल्लैः परिघैः समुद्गरैः सभिण्डिपालैश्च शिरांसि चिच्छिदुः॥ ८/९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.037.m4a", "display_order": 38}, {"id": 6000162038, "chapter_id": 10162, "verse_number": "८-९-३७", "content_sanskrit": "गजास्तुरङ्गाः सरथाः पदातयः सारोहवाहा विविधा विखण्डिताः।\nनिकृत्तबाहूरुशिरोधराङ्घ्रयश्छिन्नध्वजेष्वासतनुत्रभूषणाः॥ ८/९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.038.m4a", "display_order": 39}, {"id": 6000162039, "chapter_id": 10162, "verse_number": "८-९-३८", "content_sanskrit": "तेषां पदाघातरथाङ्गचूर्णितादायोधनादुल्बण उच्छ्रितस्तदा।\nरेणुर्दिशः खं द्युमणिं च छादयन् न्यवर्ततासृक्सृतिभिः परिप्लुतः॥ ८/९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.039.m4a", "display_order": 40}, {"id": 6000162040, "chapter_id": 10162, "verse_number": "८-९-३९", "content_sanskrit": "शिरोभिरुद्वृत्तकिरीटकुण्डलैः संरम्भदृग्भिः परिदष्टदच्छदैः।\nमहाभुजैः साभरणैः सहायुधैः संप्रास्तृता भूः करभोरुभिर्बभौ॥ ८/९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.040.m4a", "display_order": 41}, {"id": 6000162041, "chapter_id": 10162, "verse_number": "८-९-४०", "content_sanskrit": "कबन्धास्तत्र चोत्पेतुः पतितैः स्वशिरोऽक्षिभिः।\nउद्यतायुधदोर्दण्डैराधावन्तो भटान् मृधे॥ ८/९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.041.m4a", "display_order": 42}, {"id": 6000162042, "chapter_id": 10162, "verse_number": "८-९-४१", "content_sanskrit": "बलिर्महेन्द्रं दशभिस्‍त्रिभिरैरावतं शरैः।\nचतुर्भिश्चतुरो वाहानेकेनारोहमार्च्छयत्॥ ८/९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.042.m4a", "display_order": 43}, {"id": 6000162043, "chapter_id": 10162, "verse_number": "८-९-४२", "content_sanskrit": "स तानापततः शक्रस्तावद्भिः शीघ्रविक्रमः।\nचिच्छेद निशितैर्भल्लैरसंप्राप्तान् हसन्निव॥ ८/९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.043.m4a", "display_order": 44}, {"id": 6000162044, "chapter_id": 10162, "verse_number": "८-९-४३", "content_sanskrit": "तस्य कर्मोत्तमं वीक्ष्य दुर्मर्षः शक्तिमाददे।\nतां ज्वलन्तीं महोल्काभां हस्तस्थामच्छिनद्धरिः॥ ८/९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.044.m4a", "display_order": 45}, {"id": 6000162045, "chapter_id": 10162, "verse_number": "८-९-४४", "content_sanskrit": "ततः शूलं ततः प्रासं ततस्तोमरमृष्टयः।\nयद्यच्छस्‍त्रं समादद्यात् सर्वं तदच्छिनद् विभुः॥ ८/९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.045.m4a", "display_order": 46}, {"id": 6000162046, "chapter_id": 10162, "verse_number": "८-९-४५", "content_sanskrit": "ससर्जाथासुरीं मायामन्तर्धानगतोऽसुरः।\nततः प्रादुरभूच्छैलः सुरानीकोपरि प्रभो॥ ८/९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.046.m4a", "display_order": 47}, {"id": 6000162047, "chapter_id": 10162, "verse_number": "८-९-४६", "content_sanskrit": "ततो निपेतुस्तरवो दह्यमाना दवाग्निना।\nशिलाविटङ्कशिखराश्चूर्णयन्तो द्विषद्बलम्॥ ८/९/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.047.m4a", "display_order": 48}, {"id": 6000162048, "chapter_id": 10162, "verse_number": "८-९-४७", "content_sanskrit": "महोरगाः समुत्पेतुर्दन्दशूकाः सवृश्चिकाः।\nसिंहव्याघ्रवराहाश्च मर्दयन्तो महासुरान्॥ ८/९/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.048.m4a", "display_order": 49}, {"id": 6000162049, "chapter_id": 10162, "verse_number": "८-९-४८", "content_sanskrit": "यातुधान्यश्च शतशः शूलहस्ता विवाससः।\nछिन्धि भिन्धीति वादिन्यस्तथा रक्षोगणा विभो॥ ८/९/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.049.m4a", "display_order": 50}, {"id": 6000162050, "chapter_id": 10162, "verse_number": "८-९-४९", "content_sanskrit": "ततो महाघना व्योम्नि गम्भीरपरुषस्वनाः।\nअङ्गारान् मुमुचुर्वातैराहताः स्तनयित्नवः॥ ८/९/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.050.m4a", "display_order": 51}, {"id": 6000162051, "chapter_id": 10162, "verse_number": "८-९-५०", "content_sanskrit": "सृष्टो दैत्येन सुमहान् वह्निः श्वसनसारथिः।\nसांवर्तक इवात्युग्रो विबुधध्वजिनीमधाक्॥ ८/९/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.051.m4a", "display_order": 52}, {"id": 6000162052, "chapter_id": 10162, "verse_number": "८-९-५१", "content_sanskrit": "ततः समुद्र उद्वेलः सर्वतः प्रत्यदृश्यत।\nप्रचण्डवातैरुद्भूततरङ्गावर्तभीषणः॥ ८/९/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.052.m4a", "display_order": 53}, {"id": 6000162053, "chapter_id": 10162, "verse_number": "८-९-५२", "content_sanskrit": "एवं दैत्यैर्महामायैरलक्ष्यगतिभीषणैः।\nसृज्यमानासु मायासु विषेदुः सुरसैनिकाः॥ ८/९/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.053.m4a", "display_order": 54, "topics": [{"text": "पराजितेषु देवेषु तद्रक्षणार्थं भगवत आविर्भावः", "range": "५२–५७"}]}, {"id": 6000162054, "chapter_id": 10162, "verse_number": "८-९-५३", "content_sanskrit": "न तत्प्रतिविधिं यत्र विदुरिन्द्रादयो नृप।\nध्यातः प्रादुरभूत् तत्र भगवान् विश्वभावनः॥ ८/९/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.054.m4a", "display_order": 55}, {"id": 6000162055, "chapter_id": 10162, "verse_number": "८-९-५४", "content_sanskrit": "ततः सुपर्णांसकृताङ्घ्रिपल्लवः पिशङ्गवासा नवकञ्जलोचनः।\nअदृश्यताष्टायुधबाहुरुल्लसच्छ्रीकौस्तुभानर्घ्यकिरीटकुण्डलः॥ ८/९/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.055.m4a", "display_order": 56}, {"id": 6000162056, "chapter_id": 10162, "verse_number": "८-९-५५", "content_sanskrit": "तस्मिन् प्रविष्टेऽसुरकूटकर्मजा माया विनेशुर्महतां महीयसि।\nस्वाप्नो यथाऽहिः प्रतिबोध आगते हरिस्मृतिः सर्वविपद्विनाशिनी॥ ८/९/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.056.m4a", "display_order": 57}, {"id": 6000162057, "chapter_id": 10162, "verse_number": "८-९-५६", "content_sanskrit": "दृष्ट्वा मृधे गरुडवाहमथारिवाह आविध्य शूलमहिनोदथ कालनेमिः।\nतल्लीलया गरुडमूर्ध्नि पतद् गृहीत्वा तेनाहनन्नृप सवाहमरिं त्र्यधीशः॥ ८/९/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.057.m4a", "display_order": 58}, {"id": 6000162058, "chapter_id": 10162, "verse_number": "८-९-५७", "content_sanskrit": "माली सुमाल्यतिबलौ युधि पेततुर्यच्चक्रेण कृत्तशिरसावथ माल्यवांस्तम्।\nआहत्य तिग्मगदयाऽहनदण्डजेन्द्रं तावच्छिरोऽच्छिनदरेर्नदतोऽरिणाऽऽद्यः॥ ८/९/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_009/BhP_08.009.058.m4a", "display_order": 59}, {"id": 6000162059, "chapter_id": 10162, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायाम्ऽष्टमस्कन्धे नवमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]