[{"id": 2061854, "chapter_id": 2321, "verse_number": "८-४२-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061855, "chapter_id": 2321, "verse_number": "८-४२-१", "content_sanskrit": "तथा व्यूढेष्वनीकेषु संसक्तेषु च सञ्जय।\nसंशप्तकाः कथं पार्थं कथं कर्णं च पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061856, "chapter_id": 2321, "verse_number": "८-४२-२", "content_sanskrit": "एतद्विस्तरशो युद्धं प्रब्रूहि कुशलो ह्यसि।\nन हि तृप्यामि वीराणां शृण्वानो युधि विक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061857, "chapter_id": 2321, "verse_number": "८-४२-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061858, "chapter_id": 2321, "verse_number": "८-४२-३", "content_sanskrit": "तत्संस्थिमथो दृष्ट्वा प्रत्यमित्रं महद्बलम्।\nप्रत्यव्यूहत्ततः कर्णो हितार्थं तनयस्य ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061859, "chapter_id": 2321, "verse_number": "८-४२-४", "content_sanskrit": "तत्सादिनागकलिलं पदातिरथसङ्कुलम्।\nधृष्टद्युम्नमुखं घोरमशोभत महद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061860, "chapter_id": 2321, "verse_number": "८-४२-५", "content_sanskrit": "पारावतसवर्णाश्वश्चन्द्रसूर्यसमद्युतिः।\nस पार्षतो बभौ धन्वी कालो विग्रहवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061861, "chapter_id": 2321, "verse_number": "८-४२-६", "content_sanskrit": "पार्षतं त्वभितस्तस्थुर्द्रौपदेया युयुत्सवः।\nसानुगा दीप्तवपुषश्चन्द्रं तारागणा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061862, "chapter_id": 2321, "verse_number": "८-४२-७", "content_sanskrit": "अथ व्यूढेष्वनीकेषु प्रेक्ष्य संशप्तकान्रणे।\nक्रुद्धोऽर्जुनोऽभिदुद्राव व्याक्षिपन्गाण्डिवं धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061863, "chapter_id": 2321, "verse_number": "८-४२-८", "content_sanskrit": "अथ संशप्तकाः पार्थमभ्यधावन्वधैषिणः।\nविजये धृतसङ्कल्पा मृत्युं कृत्वानिवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061864, "chapter_id": 2321, "verse_number": "८-४२-९", "content_sanskrit": "तदश्वसङ्घबहुलं पत्तिनागरथाकुलम्।\nउदीर्यमाणं संरब्धं धनञ्जयमभिद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061865, "chapter_id": 2321, "verse_number": "८-४२-१०", "content_sanskrit": "तदुद्यतं महत्सैन्यं सागरौघसमं जवे।\nपार्थवेलां समासाद्य विष्ठितं समदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061866, "chapter_id": 2321, "verse_number": "८-४२-११", "content_sanskrit": "मृद्गन्तं शवर्षौघैर्द्रुतमर्जुनमार्दयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061867, "chapter_id": 2321, "verse_number": "८-४२-१२", "content_sanskrit": "स सम्प्रहारस्तुमुलस्तेषामासीत्किरीटिना।\nतस्यैव तु यथा राजन्निवातकवचैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061868, "chapter_id": 2321, "verse_number": "८-४२-१३", "content_sanskrit": "रथानश्वान्ध्वजान्नागान्पत्तीन्गजगतानपि।\nइषून्धनूंषि खङ्गांश्च चक्राणि च परश्वथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061869, "chapter_id": 2321, "verse_number": "८-४२-१४", "content_sanskrit": "सायुधानुद्यतान्बाहून्विविधान्यायुधानि च।\nचिच्छेद द्विषतां पार्थः शिरांसि च सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061870, "chapter_id": 2321, "verse_number": "८-४२-१५", "content_sanskrit": "तस्मिन्सैन्यमहावर्ते पातालतलसन्निभे।\nनिमग्नं तं रथं मत्वा नेदुः संशप्तका मुदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061871, "chapter_id": 2321, "verse_number": "८-४२-१६", "content_sanskrit": "स पुरस्तादरीन्हत्वा पुनरुत्तरतोऽवधीत्।\nदक्षिणेन च पश्चाच्च क्रुद्धो रुद्रः पशूनिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061872, "chapter_id": 2321, "verse_number": "८-४२-१७", "content_sanskrit": "अथ पाञ्चालचेदीनां सृढ्जयानां च मारिष।\nत्वदीयैः सह सङ्ग्राम आसीत्परमदारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061873, "chapter_id": 2321, "verse_number": "८-४२-१८", "content_sanskrit": "कृपश्च कृतवर्मा च शकुनिश्चापि सौबलः।\nहृष्टसेनाः सुसंरब्धा रथानीकप्रहारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061874, "chapter_id": 2321, "verse_number": "८-४२-१९", "content_sanskrit": "कोसलैः काश्यमत्स्यैश्च कारूशैः केकयैरपि।\nशूरसेनैः शूरवरैर्युयुधुर्युद्धदुर्मदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061875, "chapter_id": 2321, "verse_number": "८-४२-२०", "content_sanskrit": "तेषामन्तकरं युद्धं देहपाप्मविनाशनम्।\nक्षत्रविट्शूद्रवीराणां धर्म्यं स्वर्ग्यं यशस्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061876, "chapter_id": 2321, "verse_number": "८-४२-२१", "content_sanskrit": "दुर्योधनोऽथ सहितो भ्रातृभिर्भरतर्षभ।\nगुप्तः कुरुप्रवीरैश्च मद्राणां च महारथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061877, "chapter_id": 2321, "verse_number": "८-४२-२२", "content_sanskrit": "पाण्डवैः सह पाञ्चालैश्चेदिभिः सात्यकेन च।\nयुध्यमानं रणे कर्णं कुरुवीरोऽभ्यपालयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061878, "chapter_id": 2321, "verse_number": "८-४२-२३", "content_sanskrit": "कर्णोऽपि निशितैर्बाणैर्विनिहत्य महाचमूम्।\nप्रमृद्य च रथश्रेष्ठान्युधिष्ठिरमपीडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061879, "chapter_id": 2321, "verse_number": "८-४२-२४", "content_sanskrit": "विपत्रायुधदेहासून्कृत्वा शत्रून्सहस्रशः।\nयुक्त्वा स्वर्गयशोभ्यां च स्वेभ्यो मुदमुदावहत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061880, "chapter_id": 2321, "verse_number": "८-४२-२५", "content_sanskrit": "तद्विगाह्य महानीकं सूतपुत्रो महारथः।\nनदीं प्रवर्तयामास शोणितौघतरङ्गिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061881, "chapter_id": 2321, "verse_number": "८-४२-२६", "content_sanskrit": "शोणितोदां क्षुण्णमत्स्थां नागनक्रदुरत्ययाम्।\nमांलमज्जाकर्दमिनीं चक्रकूर्ममहोडुपाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061882, "chapter_id": 2321, "verse_number": "८-४२-२७", "content_sanskrit": "पातितैर्मेघसङ्काशैस्तत्रतत्र महाद्विपैः।\nअशनीभिरिव ध्वस्ता नदी राजन्विराजते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2061883, "chapter_id": 2321, "verse_number": "८-४२-२८", "content_sanskrit": "तां शरोर्मिमहावर्तां छत्रहंससमाकुलाम्।\nतनुत्रोष्णीषसङ्घाटामस्थिपाषाणसङ्कुलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2061884, "chapter_id": 2321, "verse_number": "८-४२-२९", "content_sanskrit": "अपारामनपारां च शङ्खदुन्दुभिघोषिणीम्।\nरौद्रां नदीं महाराज रजसा सर्वतोवृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2061885, "chapter_id": 2321, "verse_number": "८-४२-३०", "content_sanskrit": "अतितीक्ष्णां नराकीर्णां नदीमन्तकगामिनीम्।\nसमं च विषमं चैव समायान्तीं महाभयाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2061886, "chapter_id": 2321, "verse_number": "८-४२-३१", "content_sanskrit": "आकुलाश्चात्र सीदन्ति नराः शोणितकर्दमे।\nनरैरभिपरिक्षिप्ता यथा राजन्महाद्रुमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2061887, "chapter_id": 2321, "verse_number": "८-४२-३२", "content_sanskrit": "ततस्ते तत्रतत्रैव प्रचरन्तो महानदीम्।\nविचेरुः सर्वतो योधा नौवारणमहारथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2061888, "chapter_id": 2321, "verse_number": "८-४२-३३", "content_sanskrit": "शोणितेन समं राजन्कृतमासीत्समन्ततः।\nनदीवेगैर्यथा भूमिस्तद्वदासीद्विशापते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2061889, "chapter_id": 2321, "verse_number": "८-४२-३४", "content_sanskrit": "एवं भारत सङ्ग्रामो नरवाजिगजक्षयः।\nकुरूणां सृञ्जयानां च देवासुरसमोऽभवत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2061890, "chapter_id": 2321, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे द्विचत्वारिंशोऽध्यायः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]