[{"id": 5000550000, "chapter_id": 9550, "verse_number": "७-१५-१", "content_sanskrit": "ततस्ताँल्लक्ष्य वित्रस्तान्यक्षेन्द्रांश्च सहस्रशः ।\nधनाध्यक्षो महायक्षं माणिचारमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000550001, "chapter_id": 9550, "verse_number": "७-१५-२", "content_sanskrit": "रावणं जहि यक्षेन्द्र दुर्वृत्तं पापचेतसम् ।\nशरणं भव वीराणां यक्षाणां युद्धशालिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000550002, "chapter_id": 9550, "verse_number": "७-१५-३", "content_sanskrit": "एवमुक्तो महाबाहुर्माणिभद्रः सुदुर्जयः ।\nवृतो यक्षसहस्रैस्तु चतुर्भिः समयोधयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000550003, "chapter_id": 9550, "verse_number": "७-१५-४", "content_sanskrit": "ते गदामुसलप्रासैः शक्तितोमरमुद्गरैः ।\nअभिघ्नन्तस्तदा यक्षा राक्षसान्समुपाद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000550004, "chapter_id": 9550, "verse_number": "७-१५-५", "content_sanskrit": "कुर्वन्तस्तुमुलं युद्धं चरन्तः श्येनवल्लघु ।\nबाढं प्रयच्छन्नेच्छामि दीयतामिति भाषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000550005, "chapter_id": 9550, "verse_number": "७-१५-६", "content_sanskrit": "ततो देवाः सगन्धर्वा ऋषयो ब्रह्मवादिनः ।\nदृष्ट्वा तत्तुमुलं युद्धं परं विस्मयमागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000550006, "chapter_id": 9550, "verse_number": "७-१५-७", "content_sanskrit": "यक्षाणां तु प्रहस्तेन सहस्रं निहतं रणे ।\nमहोदरेण चानिन्द्यं सहस्रमपरं हतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000550007, "chapter_id": 9550, "verse_number": "७-१५-८", "content_sanskrit": "क्रुद्धेन च तदा राजन्मारीचेन युयुत्सुना ।\nनिमेषान्तरमात्रेण द्वे सहस्रे निपातिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000550008, "chapter_id": 9550, "verse_number": "७-१५-९", "content_sanskrit": "क्व च यक्षार्जवं युद्धं क्व च मायाबलाश्रयम् ।\nरक्षसां पुरुषव्याघ्र तेन ते ऽभ्यधिका युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000550009, "chapter_id": 9550, "verse_number": "७-१५-१०", "content_sanskrit": "धूम्राक्षेण समागम्य माणिभद्रो महारणे ।\nमुसलेनोरसि क्रोधात्तडितो न च कम्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000550010, "chapter_id": 9550, "verse_number": "७-१५-११", "content_sanskrit": "ततो गदां समाविध्य माणिभद्रेण राक्षसः ।\nधूम्राक्षस्ताडितो मूर्ध्नि विह्वलः स पपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000550011, "chapter_id": 9550, "verse_number": "७-१५-१२", "content_sanskrit": "धूम्राक्षं ताडितं दृष्ट्वा पतितं शोणितोक्षितम् ।\nअभ्यधावत सङ्ग्रामे माणिभद्रं दशाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000550012, "chapter_id": 9550, "verse_number": "७-१५-१३", "content_sanskrit": "तं क्रुद्धमभिधावन्तं माणिभद्रो दशाननम् ।\nशक्तिभिस्ताडयामास तिसृभिर्यक्षपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000550013, "chapter_id": 9550, "verse_number": "७-१५-१४", "content_sanskrit": "ताडितो माणिभद्रस्य मुकुटे प्राहरद्रणे ।\nतस्य तेन प्रहारेम मुकुटं पार्श्वमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000550014, "chapter_id": 9550, "verse_number": "७-१५-१५", "content_sanskrit": "ततः संयुध्यमानेन विष्टब्धो न व्यकम्पत ।\nतदाप्रभृति यक्षो ऽसौ पार्श्वमौलिरिति स्मृतः ।\nसन्नादः सुमहान्राजंस्तस्मिन्शैले ऽभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000550015, "chapter_id": 9550, "verse_number": "७-१५-१६", "content_sanskrit": "ततो दूरात्प्रददृशे धनाध्यक्षो गदाधरः ।\nशुक्रप्रौष्ठपदाभ्यां च पद्मशङ्खसमावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000550016, "chapter_id": 9550, "verse_number": "७-१५-१७", "content_sanskrit": "स दृष्ट्वा भ्रातरं सङ्ख्ये शापाद्विभ्रष्टगौरवम् ।\nउवाच वचनं धीमान्युक्तं पैतामहे कुले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000550017, "chapter_id": 9550, "verse_number": "७-१५-१८", "content_sanskrit": "यन्मया वार्यमाणस्त्वं नावगच्छसि दुर्मते ।\nपश्चादस्य फलं प्राप्य ज्ञास्यसे निरयं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000550018, "chapter_id": 9550, "verse_number": "७-१५-१९", "content_sanskrit": "यो हि मोहाद्विषं पीत्वा नावगच्छति दुर्मतिः ।\nस तस्य परिणामान्ते जानीते कर्मणः फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000550019, "chapter_id": 9550, "verse_number": "७-१५-२०", "content_sanskrit": "देवता नाभिनन्दन्ति धर्मयुक्तेन केनचित् ।\nयेन त्वमीदृशं भावं नीतस्सन्नावबुद्ध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000550020, "chapter_id": 9550, "verse_number": "७-१५-२१", "content_sanskrit": "मातरं पितरं यो हि आचार्यं चावमन्यते ।\nस पश्यति फलं तस्य प्रेतराजवशं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000550021, "chapter_id": 9550, "verse_number": "७-१५-२२", "content_sanskrit": "अध्रुवे हि शरीरे यो न करोति तपोर्जनम् ।\nस पश्चात्तप्यते मूढो मृतो दृष्ट्वा ऽ ऽत्मनो गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000550022, "chapter_id": 9550, "verse_number": "७-१५-२३", "content_sanskrit": "धर्माद्राज्यं धनं सौख्यमधर्माद्दुःखमेव च ।\nतस्माद्धर्मं सुखार्थाय कुर्यात्पापं विसर्जयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000550023, "chapter_id": 9550, "verse_number": "७-१५-२४", "content_sanskrit": "पापस्य हि फलं दुःखं तद्भोक्तव्यमिहात्मना ।\nतस्मादात्मापघातार्थं मूढः पापं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000550024, "chapter_id": 9550, "verse_number": "७-१५-२५", "content_sanskrit": "कस्य चिन्न हि दुर्बुद्धेश्छन्दतो जायते मतिः ।\nदेवं चेष्टयते सर्वं हतो दैवेन हन्यते ।\nयादृशं कुरुते कर्म तादृशं फलमश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000550025, "chapter_id": 9550, "verse_number": "७-१५-२६", "content_sanskrit": "बुद्धिरूपं फलं पुत्राञ्छौर्यं धीरत्वमेव च ।\nप्राप्नुवन्ति नरा लोके निर्जितं पुण्यकर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000550026, "chapter_id": 9550, "verse_number": "७-१५-२७", "content_sanskrit": "एवं निरयगामी त्वं यस्य ते मतिरीदृशी ।\nन त्वां समभिभाषिष्ये ऽसद्वृत्तेष्वेव निर्णयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000550027, "chapter_id": 9550, "verse_number": "७-१५-२८", "content_sanskrit": "एवमुक्तास्ततस्तेन तस्यामात्याः समाहताः ।\nमारीचप्रमुखाः सर्वे विमुखा विप्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000550028, "chapter_id": 9550, "verse_number": "७-१५-२९", "content_sanskrit": "ततस्तेन दशग्रीवो यक्षेन्द्रेण महात्मना ।\nगदयाभिहतो मूर्ध्नि न च स्थानात्प्रकम्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000550029, "chapter_id": 9550, "verse_number": "७-१५-३०", "content_sanskrit": "ततस्तौ राम निघ्नन्तौ तदान्योन्यं महामृधे ।\nन विह्वलौ न च श्रान्तौ बभूवतुरमर्षणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000550030, "chapter_id": 9550, "verse_number": "७-१५-३१", "content_sanskrit": "आग्नेयमस्त्रं तस्मै स मुमोच धनदस्तदा ।\nराक्षसेन्द्रो वारुणेन तदस्त्रं प्रत्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000550031, "chapter_id": 9550, "verse_number": "७-१५-३२", "content_sanskrit": "ततो मायां प्रविष्टो ऽसौ राक्षसीं राक्षसेश्वरः ।\nरूपाणां शतसाहस्रं विनाशाय चकार च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000550032, "chapter_id": 9550, "verse_number": "७-१५-३३", "content_sanskrit": "व्याघ्रो वराहो जीमूतः पर्वतः सागरो द्रुमः ।\nयक्षो दैत्यस्वरूपी च सो ऽदृश्यत दशाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000550033, "chapter_id": 9550, "verse_number": "७-१५-३४", "content_sanskrit": "बहूनि च करोति स्म दृश्यन्ते न त्वसौ ततः ।\nप्रतिगृह्य ततो राम महदस्त्रं दशाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000550034, "chapter_id": 9550, "verse_number": "७-१५-३५", "content_sanskrit": "जघान मूर्ध्नि धनदं व्याविद्ध्य महतीं गदाम् ।\nएवं स तेनाभिहतो विह्वलः शोणितोक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000550035, "chapter_id": 9550, "verse_number": "७-१५-३६", "content_sanskrit": "कृत्तमूल इवाशोको निपपात धनाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000550036, "chapter_id": 9550, "verse_number": "७-१५-३७", "content_sanskrit": "ततः पद्मादिभिस्तत्र निधिभिः स तदा वृतः ।\nधनदोच्छ्वासितस्तैस्तु वनमानीय नन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000550037, "chapter_id": 9550, "verse_number": "७-१५-३८", "content_sanskrit": "निर्जित्य राक्षसेन्द्रस्तं धनदं हृष्टमानसः ।\nपुष्पकं तस्य जग्राह विमानं जयलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000550038, "chapter_id": 9550, "verse_number": "७-१५-३९", "content_sanskrit": "काञ्चनस्तम्भसंवीतं वैडूर्यमणितोरणम् ।\nमुक्ताजालप्रतिच्छन्नं सर्वकामफलद्रुमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000550039, "chapter_id": 9550, "verse_number": "७-१५-४०", "content_sanskrit": "मनोजवं कामगमं कामरूपं विहङ्गमम् ।\nमणिकाञ्चनसोपानं तप्तकाञ्चनवेदिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000550040, "chapter_id": 9550, "verse_number": "७-१५-४१", "content_sanskrit": "देवोपवाह्यमक्षय्यं सदादृष्टिमनःसुखम् ।\nबह्वाश्चर्यं भक्तिचित्रं ब्रह्मणा परिनिर्मितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000550041, "chapter_id": 9550, "verse_number": "७-१५-४२", "content_sanskrit": "निर्मितं सर्वकामैस्तु मनोहरमनुत्तमम् ।\nन तु शीतं न चोष्णं च सर्वर्तुसुखदं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000550042, "chapter_id": 9550, "verse_number": "७-१५-४३", "content_sanskrit": "स तं राजा समारुह्य कामगं वीर्यनिर्जितम् ।\nजितं त्रिभुवनं मेने दर्पोत्सेकात्सुदुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000550043, "chapter_id": 9550, "verse_number": "७-१५-४४", "content_sanskrit": "जित्वा वैश्रवणं देवं कैलासात्समवातरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000550044, "chapter_id": 9550, "verse_number": "७-१५-४५", "content_sanskrit": "स्वतेजसा विपुलमवाप्य तं जयं प्रतापवान्विमलकिरीटहारवान् ।\nरराज वै परमविमानमास्थितो निशाचरः सदसि गतो यथानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000550045, "chapter_id": 9550, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे पञ्चदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]