[{"id": 6000020000, "chapter_id": 10020, "verse_number": null, "content_sanskrit": "अथ विंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000020001, "chapter_id": 10020, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.001.m4a", "display_order": 2}, {"id": 6000020002, "chapter_id": 10020, "verse_number": "१-२०-१", "content_sanskrit": "तत्राभवद्भगवान् व्यासपुत्रो यदृच्छया गामटमानोऽनपेक्षः।\nअलक्ष्यलिङ्गो निजलाभतुष्‍टो वृतश्‍च बालैरवधूतवेषः॥ १/२०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.002.m4a", "display_order": 3, "topics": [{"text": "तत्र यदृच्छासमागतं सकलसभ्यजनपूजितं शुकाचार्यं प्रति सप्रणामं मुमूर्षुणा कर्तव्यस्य जाप्यस्य त्याज्यस्य च निवेदनप्रार्थना", "range": "१–१४"}]}, {"id": 6000020003, "chapter_id": 10020, "verse_number": "१-२०-२", "content_sanskrit": "तं द्व्यष्‍टवर्षं सुकुमारपादकरोरुबाह्वंसकपोलगात्रम्।\nचार्वारुणाक्षोन्नसतुल्यकर्णं सुभ्व्राननं कम्बुसुजातकण्ठम्॥ १/२०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.003.m4a", "display_order": 4}, {"id": 6000020004, "chapter_id": 10020, "verse_number": "१-२०-३", "content_sanskrit": "निगूढजत्रुं पृथुतुङ्गवक्षसम् आवर्तनाभिं वलिवल्गूदरञ्च।\nदिगम्बरं वक्रविकीर्णकेशं प्रलम्बबाहुं स्वमरोत्तमाभम्॥ १/२०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.004.m4a", "display_order": 5}, {"id": 6000020005, "chapter_id": 10020, "verse_number": "१-२०-४", "content_sanskrit": "श्यामं सदाऽऽपीच्यवयोङ्गलक्ष्म्या स्‍त्रीणां मनोज्ञं रुचिरस्मितेन।\nप्रत्युत्थिता मुनयश्‍चासनेभ्यः तल्‍लक्षणज्ञा अपि गूढवर्चसम्॥ १/२०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.005.m4a", "display_order": 6}, {"id": 6000020006, "chapter_id": 10020, "verse_number": "१-२०-५", "content_sanskrit": "स विष्णुरातोऽतिथय आगताय तस्मै सपर्यां शिरसाऽऽजहार।\nततो निवृत्ता ह्यबुधाः स्‍त्रियोऽर्भका महासने चोपविवेश पूजितः॥ १/२०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.006.m4a", "display_order": 7}, {"id": 6000020007, "chapter_id": 10020, "verse_number": "१-२०-६", "content_sanskrit": "स संवृतस्तत्र महान्महीयसां ब्रह्मर्षिराजर्षिदेवर्षिसङ्घैः।\nव्यरोचतालं भगवान्यथेन्दुर्ग्रहर्क्षतारानिकरैः परीतः॥ १/२०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.007.m4a", "display_order": 8}, {"id": 6000020008, "chapter_id": 10020, "verse_number": "१-२०-७", "content_sanskrit": "प्रशान्तमासीनमकुण्ठमेधसं मुनिं नृपो भागवतोऽभ्युपेत्य।\nप्रणम्य मूर्ध्नाऽवहितः कृताञ्जलिर्नत्वा गिरा सूनृतयाऽन्वपृच्छत्॥ १/२०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.008.m4a", "display_order": 9}, {"id": 6000020009, "chapter_id": 10020, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.009.m4a", "display_order": 10}, {"id": 6000020010, "chapter_id": 10020, "verse_number": "१-२०-८", "content_sanskrit": "अहो अद्य वयं ब्रह्मन्सत्सेव्याः क्षत्रबन्धवः।\nकृपयाऽतिथिरूपेण भवद्भिस्तीर्थकाः कृताः॥ १/२०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.010.m4a", "display_order": 11}, {"id": 6000020011, "chapter_id": 10020, "verse_number": "१-२०-९", "content_sanskrit": "येषां संस्मरणात्पुंसः सद्यः शुध्यन्ति वै गृहाः।\nकिं पुनर्दर्शनस्पर्शपादशौचासनादिभिः॥ १/२०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.011.m4a", "display_order": 12}, {"id": 6000020012, "chapter_id": 10020, "verse_number": "१-२०-१०", "content_sanskrit": "सान्निध्यात्ते महायोगिन् पातकानि महान्त्यपि।\nसद्यो नश्यन्ति वै पुंसां विष्णोरिव सुरेतराः॥ १/२०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.012.m4a", "display_order": 13}, {"id": 6000020013, "chapter_id": 10020, "verse_number": "१-२०-११", "content_sanskrit": "अपि मे भगवान्प्रीतः कृष्णः पाण्डुसुतप्रियः।\nपैतृष्वसेयप्रीत्यर्थं तद्गोत्रस्याप्‍तबान्धवः॥ १/२०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.013.m4a", "display_order": 14}, {"id": 6000020014, "chapter_id": 10020, "verse_number": "१-२०-१२", "content_sanskrit": "अन्यथा तेऽव्यक्‍तगतेर्दर्शनं नः कथं नृणाम्।\nनितरां म्रियमाणानां संसिद्धस्य वरीयसः॥ १/२०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.014.m4a", "display_order": 15}, {"id": 6000020015, "chapter_id": 10020, "verse_number": "१-२०-१३", "content_sanskrit": "अतः पृच्छामि संसिद्धं योगिनां परमं गुरुम्।\nपुरुषस्येह यत्कार्यं म्रियमाणस्य सर्वदा॥ १/२०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.015.m4a", "display_order": 16}, {"id": 6000020016, "chapter_id": 10020, "verse_number": "१-२०-१४", "content_sanskrit": "यच्छ्रोतव्यमथो जाप्यं यत्कर्तव्यं नृभिः सदा।\nस्मर्तव्यं भजनीयं वा ब्रूहि यद्वा विपर्ययम्॥ १/२०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.016.m4a", "display_order": 17}, {"id": 6000020017, "chapter_id": 10020, "verse_number": "१-२०-१५", "content_sanskrit": "नूनं भगवतो ब्रह्मन् गृहेषु गृहमेधिनाम्।\nन लक्ष्यते ह्यवस्थानमपि गोदोहनं क्‍वचित्॥ १/२०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.017.m4a", "display_order": 18}, {"id": 6000020018, "chapter_id": 10020, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.018.m4a", "display_order": 19}, {"id": 6000020019, "chapter_id": 10020, "verse_number": "१-२०-१६", "content_sanskrit": "एवमाभाषितः पृष्‍टः स राज्ञा श्लक्ष्णया गिरा।\nप्रत्यभाषत धर्मज्ञो भगवान् बादरायणिः॥ १/२०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_020/BhP_01.020.019.m4a", "display_order": 20}, {"id": 6000020020, "chapter_id": 10020, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे विंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 6000020021, "chapter_id": 10020, "verse_number": null, "content_sanskrit": "॥ इति प्रथमस्कन्धः समाप्‍तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]