[{"id": 2061138, "chapter_id": 2307, "verse_number": "८-२८-०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061139, "chapter_id": 2307, "verse_number": "८-२८-१", "content_sanskrit": "इमं चाप्यपरं भूय इति हासं निबोध मे।\nपितुर्मम सकाशे वै ब्राह्मणः प्राह धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061140, "chapter_id": 2307, "verse_number": "८-२८-२", "content_sanskrit": "श्रुत्वा चैतद्वचश्चित्रं हेतुकार्यार्थतत्त्ववित्।\nकुरु शल्य विनिश्चित्य मा भूदत्र विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061141, "chapter_id": 2307, "verse_number": "८-२८-३", "content_sanskrit": "भार्गवाणां कुले जातो जमदग्निर्महातपाः।\nतस्य रामेति विख्यातः पुत्रस्तेजोगुणान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061142, "chapter_id": 2307, "verse_number": "८-२८-४", "content_sanskrit": "स तीव्रं तप आस्थाय सम्प्रसादितवान्भवम्।\nअस्त्रहेतोः प्रसन्नात्मा नियतः संयतेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061143, "chapter_id": 2307, "verse_number": "८-२८-५", "content_sanskrit": "तस्मै तुष्टो महादेवो भक्त्या च प्रशमेन च।\nहृद्गतं चास्य विज्ञाय दर्शयामास शङ्करः।\nप्रत्यक्षेण महादेवः स्वां तनुं सर्वशङ्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061144, "chapter_id": 2307, "verse_number": "८-२८-६x", "content_sanskrit": "शङ्कर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061145, "chapter_id": 2307, "verse_number": "८-२८-६", "content_sanskrit": "राम तुष्टोऽस्मि भद्रं ते विदितं तव चेप्सितम्।\nकुरुष्व पूतमात्मानं सर्वमेतदवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061146, "chapter_id": 2307, "verse_number": "८-२८-७", "content_sanskrit": "दास्यामि ते तदाऽस्त्राणि यदा पूतो भविष्यसि।\nअपात्रमसमर्थं च दहन्त्यस्त्राणि भार्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061147, "chapter_id": 2307, "verse_number": "८-२८-८", "content_sanskrit": "इत्युक्तो जामदग्न्यस्तु देवदेवेन शूलिना।\nप्रत्युवाच महात्मानं शिरसाऽवनतः प्रभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061148, "chapter_id": 2307, "verse_number": "८-२८-९", "content_sanskrit": "यदा जानासि देवेश पात्रं मामस्त्रधारणे।\nतदा शुश्रूषतेऽस्त्राणि भवान्मे दातुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061149, "chapter_id": 2307, "verse_number": "८-२८-१०", "content_sanskrit": "ततः स तपसा चैव व्रतेन नियमेन च।\nपूजोपहारबलिभिर्होममन्त्रपुरस्कृतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061150, "chapter_id": 2307, "verse_number": "८-२८-११", "content_sanskrit": "समाराधितवाञ्शर्वं बहुवर्षगणांस्तदा।\nप्रसन्नश्च महादेवो भार्गवस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061151, "chapter_id": 2307, "verse_number": "८-२८-१२", "content_sanskrit": "असकृच्चाब्रवीत्तस्य गुणान्देव्याः सकाशतः।\nभक्तिमानेष सततं मयि रामो दृढव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061152, "chapter_id": 2307, "verse_number": "८-२८-१३", "content_sanskrit": "एवमस्य गुणान्प्रीतो बहुशो कथयद्विभुः।\nदेवतानां पितॄणां च समक्षमरिसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061153, "chapter_id": 2307, "verse_number": "८-२८-१४", "content_sanskrit": "एतस्मिन्नेव काले तु दैत्या ह्यासन्महाबलाः।\nतैस्तदा दर्पमोहाद्वै अबाध्यन्त दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061154, "chapter_id": 2307, "verse_number": "८-२८-१५", "content_sanskrit": "ततः सम्भूय विबुधास्तान्हन्तुं कृतनिश्चयाः।\nचक्रुः शत्रुवधे यत्नं दैत्याञ्चेतुमशक्नुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061155, "chapter_id": 2307, "verse_number": "८-२८-१६", "content_sanskrit": "अभिगम्य ततो देवा महेश्वरमुमापतिम्।\nप्रासादयंस्तदा भक्त्या जहि शत्रुगणानिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061156, "chapter_id": 2307, "verse_number": "८-२८-१७", "content_sanskrit": "प्रतिज्ञाय ततो देवो देवतानां रिपुक्षयम्।\nरामं भार्गवमाहूय सोऽभ्यभाषत शङ्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061157, "chapter_id": 2307, "verse_number": "८-२८-१८", "content_sanskrit": "रिपून्भार्गव देवानां जहि सर्वान्समागतान्।\nलोकानां हितकामार्थं मत्प्रियार्थं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061158, "chapter_id": 2307, "verse_number": "८-२८-१९x", "content_sanskrit": "परशुराम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061159, "chapter_id": 2307, "verse_number": "८-२८-१९", "content_sanskrit": "का शक्तिर्मम देवेश अकृतास्त्रस्य संयुगे।\nनिहन्तुं दानवान्सर्वान्कृतास्त्रान्युद्धदुर्मदान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061160, "chapter_id": 2307, "verse_number": "८-२८-२०x", "content_sanskrit": "ईश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061161, "chapter_id": 2307, "verse_number": "८-२८-२०", "content_sanskrit": "गच्छ त्वं मदनुज्ञानान्निहनिष्यसि शात्रवान्।\nविजित्य च रिपून्सर्वान्गुणान्प्राप्स्यसि पुष्कलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061162, "chapter_id": 2307, "verse_number": "८-२८-२१x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061163, "chapter_id": 2307, "verse_number": "८-२८-२१", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं प्रतिगृह्य च सर्वशः।\nरामः कृतस्वस्त्ययनः प्रययौ दानवान्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061164, "chapter_id": 2307, "verse_number": "८-२८-२२", "content_sanskrit": "ततोऽजयद्देवशत्रून्महादर्पबलान्वितान्।\nवज्राशनिसमस्पर्शैः प्रहारैरेव भार्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061165, "chapter_id": 2307, "verse_number": "८-२८-२३", "content_sanskrit": "स दानवैः क्षततनुर्जामदग्न्यो नृपोत्तम।\nसंस्पृष्टः स्थाणुना सद्यो निर्व्रणः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061166, "chapter_id": 2307, "verse_number": "८-२८-२४", "content_sanskrit": "प्रीतश्च भगवान्देवः कर्मणा तेन तस्य वै।\nवरान्प्रादाद्बहुविधान्भार्गवाय महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2061167, "chapter_id": 2307, "verse_number": "८-२८-२५", "content_sanskrit": "उक्तश्च प्रीतियुक्तेन देवदेवेन शूलिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2061168, "chapter_id": 2307, "verse_number": "८-२८-२६", "content_sanskrit": "निपातात्तव शस्त्राणां शरीरे याऽभवद्रुजा।\nतया ते मानुषं कर्म व्यपोहं भृगुनन्दन।\nगृहाणास्त्राणि दिव्यानि मत्सकाशाद्यथेप्सितं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2061169, "chapter_id": 2307, "verse_number": "८-२८-२७", "content_sanskrit": "ततोऽस्त्राणि समग्राणि वरांश्च मनसेप्सितान्।\nलब्ध्वा बहुविधान्रामः प्रणम्यशिरसा शिवम्।\nअनुज्ञां प्राप्य देवेशाज्जगाम स महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2061170, "chapter_id": 2307, "verse_number": "८-२८-२८", "content_sanskrit": "एवमेतत्पुरावृत्तं तथा कथितवानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2061171, "chapter_id": 2307, "verse_number": "८-२८-२९", "content_sanskrit": "भार्गवोऽपि ददौ सर्वं धनुर्वेदं महात्मने।\nकर्णाय पुरुषव्याघ्रः सुप्रीतेनान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2061172, "chapter_id": 2307, "verse_number": "८-२८-३०", "content_sanskrit": "वृजिनं न भवेत्किञ्चिदस्य कर्णस्य पार्थिव।\nसूतेन वर्धितो नित्यं न सूतो नृप एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2061173, "chapter_id": 2307, "verse_number": "८-२८-३१", "content_sanskrit": "विशुद्धयोनिं विज्ञाय दिव्यान्यस्त्राण्यदाद्भृगुः।\nनापि सूतकुले जातं मन्ये कर्णं कथञ्चन।\nदेवपुत्रमदं मन्ये क्षत्रियाणां कुलोद्भवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2061174, "chapter_id": 2307, "verse_number": "८-२८-३२", "content_sanskrit": "विसृष्टमविबोधार्थं कुलस्येंति मतिर्मम।\nसर्वथा न ह्यसो शल्य कर्णः सूतकुलोद्भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2061175, "chapter_id": 2307, "verse_number": "८-२८-३३", "content_sanskrit": "सकुण्डलं सकवचं दीर्घबाहुमरिन्दमम्।\nकथमादित्यसङ्काशं मृगी सिंहं प्रसूयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2061176, "chapter_id": 2307, "verse_number": "८-२८-३४", "content_sanskrit": "पश्य ह्यस्य भुजौ पीनौ नागराजकरोपमौ।\nवक्षः पश्य विशालं च सर्वशस्त्रसहं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2061177, "chapter_id": 2307, "verse_number": "८-२८-३५", "content_sanskrit": "न त्वेव प्राकृतः कश्चित्कर्णो वैकर्तनो वृषा।\nमहात्माह्येष राजेन्द्र रामशिष्यः प्रतापवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2061178, "chapter_id": 2307, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि अष्टविंशोऽध्यायः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]