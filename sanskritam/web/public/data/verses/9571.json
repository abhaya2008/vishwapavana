[{"id": 5000571000, "chapter_id": 9571, "verse_number": "७-३६-१", "content_sanskrit": "ततः पितामहं दृष्ट्वा वायुः पुत्रवधार्दितः ।\nशिशुकं तं समादाय उत्तस्थौ धातुरग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000571001, "chapter_id": 9571, "verse_number": "७-३६-२", "content_sanskrit": "चलकुण्डलमौलिस्रक्तपनीयविभूषणः ।\nपादयोर्न्यपतद्वायुस्तिस्रोपस्थाय वेधसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000571002, "chapter_id": 9571, "verse_number": "७-३६-३", "content_sanskrit": "तं तु वेदविदा तेन लम्बाभरणशोभिना ।\nवायुमुत्थाप्य हस्तेन शिशुं तं परिमृष्टवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000571003, "chapter_id": 9571, "verse_number": "७-३६-४", "content_sanskrit": "स्पृष्टमात्रस्ततः सो ऽथ सलीलं पद्मयोनिना ।\nजलसिक्तं यथा सस्यं पुनर्जीवितमाप्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000571004, "chapter_id": 9571, "verse_number": "७-३६-५", "content_sanskrit": "प्राणवन्तमिमं दृष्ट्वा प्राणो गन्धवहो मुदा ।\nचचार सर्वभूतेषु सन्निरुद्धं यथा पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000571005, "chapter_id": 9571, "verse_number": "७-३६-६", "content_sanskrit": "मरुद्रोधाद्विनिर्मुक्तास्ताः प्रजा मुदिता ऽभवन् ।\nशीतदाहविनिर्मुक्ताः पद्मिन्य इव साम्बुजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000571006, "chapter_id": 9571, "verse_number": "७-३६-७", "content_sanskrit": "ततस्त्रियुग्मस्त्रिककुत्ऺित्रधामा त्रिदशार्चितः ।\nउवाच देवता ब्रह्मा मारुतप्रियकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000571007, "chapter_id": 9571, "verse_number": "७-३६-८", "content_sanskrit": "भो महेन्द्रेशवरुणप्रजेश्वरधनेश्वराः ।\nजानतामपि वः सर्वं वक्ष्यामि श्रूयतां हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000571008, "chapter_id": 9571, "verse_number": "७-३६-९", "content_sanskrit": "अनेन शिशुना कार्यं कर्तव्यं वो भविष्यति ।\nतद्वदध्वं वरान्सर्वे मारुतस्यास्य तुष्टये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000571009, "chapter_id": 9571, "verse_number": "७-३६-१०", "content_sanskrit": "ततः सहस्रनयनः प्रीतियुक्तः शुभाननः ।\nकुशेशयमयीं मालामुत्क्षिप्येदं वचो ऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000571010, "chapter_id": 9571, "verse_number": "७-३६-११", "content_sanskrit": "मत्करोत्सृष्टवज्रेण हनुरस्य यथा हतः ।\nनाम्ना वै कपिशार्दूलो भविता हनुमानिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000571011, "chapter_id": 9571, "verse_number": "७-३६-१२", "content_sanskrit": "अहमस्य प्रदास्यामि परमं वरमद्भुतम् ।\nइतः प्रभृति वज्रस्य ममावध्यो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000571012, "chapter_id": 9571, "verse_number": "७-३६-१३", "content_sanskrit": "मार्तण्डस्त्वब्रवीत्तत्र भगवांस्तिमिरापहः ।\nतेजसो ऽस्य मदीयस्य ददामि शतिकां कलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000571013, "chapter_id": 9571, "verse_number": "७-३६-१४", "content_sanskrit": "यदा तु शास्त्राण्यध्येतुं शक्तिरस्य भविष्यति ।\nतदास्य शास्त्रं दास्यामि येन वाग्ग्मी भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000571014, "chapter_id": 9571, "verse_number": "७-३६-१५", "content_sanskrit": "नचास्य भविता कश्चित्सदृशः शास्त्रदर्शने ।\nवरुणश्च वरं प्रादान्नास्य मृत्युर्भविष्यति ।\nवर्षायुतशतेनापि मत्पाशादुदकादपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000571015, "chapter_id": 9571, "verse_number": "७-३६-१६", "content_sanskrit": "यमो दण्डादवध्यत्वमरोगत्वं च नित्यशः ।\nवरं ददामि सन्तुष्ट अविषादं च संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000571016, "chapter_id": 9571, "verse_number": "७-३६-१७", "content_sanskrit": "गदेयं मामिका नैनं संयुगेषु वधिष्यति ।\nइत्येवं वरदः प्राह तदा ह्येकाक्षिपिङ्गलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000571017, "chapter_id": 9571, "verse_number": "७-३६-१८", "content_sanskrit": "मत्तो मदायुधानां च न वध्यो ऽयं भविष्यति ।\nइत्येवं शङ्करेणापि दत्तो ऽस्य परमो वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000571018, "chapter_id": 9571, "verse_number": "७-३६-१९", "content_sanskrit": "सर्वेषां ब्रह्मदण्डानामवध्यो ऽयं भविष्यति ।\nदीर्घायुश्च महात्मा च इति ब्रह्माब्रवीद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000571019, "chapter_id": 9571, "verse_number": "७-३६-२०", "content_sanskrit": "विश्वकर्मा च दृष्ट्वैनं बालसूर्योपमं शिशुम् ।\nशिल्पिनां प्रवरः प्रादाद्वरमस्य महामतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000571020, "chapter_id": 9571, "verse_number": "७-३६-२१", "content_sanskrit": "मत्कृतानि च शस्त्राणि यानि दिव्यानि संयुगे ।\nतैरवध्यत्वमापन्नश्चिरजीवी भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000571021, "chapter_id": 9571, "verse_number": "७-३६-२२", "content_sanskrit": "ततः सुराणां तु वरैर्दृष्ट्वा ह्येनमलङ्कृतम् ।\nचतुर्मुखस्तुष्टमना वायुमाह जगद्गुरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000571022, "chapter_id": 9571, "verse_number": "७-३६-२३", "content_sanskrit": "अमित्राणां भयकरो मित्राणामभयङ्करः ।\nअजेयो भविता पुत्रस्तव मारुत मारुतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000571023, "chapter_id": 9571, "verse_number": "७-३६-२४", "content_sanskrit": "कामरूपः कामचारी कामगः प्लवतां वरः ।\nभवत्यव्याहतगतिः कीर्तिमांश्च भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000571024, "chapter_id": 9571, "verse_number": "७-३६-२५", "content_sanskrit": "रावणोत्सादनार्थानि रामप्रियकरणि च ।\nरोमहर्षकराण्येष कर्ता कर्माणि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000571025, "chapter_id": 9571, "verse_number": "७-३६-२६", "content_sanskrit": "एवमुक्त्वा तमामन्त्र्य मारुतं त्वमरैः सह ।\nयथागतं ययुः सर्वे पितामहपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000571026, "chapter_id": 9571, "verse_number": "७-३६-२७", "content_sanskrit": "सो ऽपि गन्धवहः पुत्रं प्रगृह्य गृहमानयत् ।\nअञ्जनायास्तमाचख्यौ वरदत्तं विनिर्गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000571027, "chapter_id": 9571, "verse_number": "७-३६-२८", "content_sanskrit": "प्राप्य राम वरानेष वरदानसमन्वितः ।\nबलेनात्मनि संस्थेन सो ऽपूर्यत यथा ऽर्णवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000571028, "chapter_id": 9571, "verse_number": "७-३६-२९", "content_sanskrit": "तरसा पूर्यमाणो ऽपि तदा वानरपुङ्गवः ।\nआश्रमेषु महर्षीणामपराध्यति निर्भयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000571029, "chapter_id": 9571, "verse_number": "७-३६-३०", "content_sanskrit": "स्रुग्भाण्डान्यग्निहोत्रं च वल्कलाजिनसञ्चयान् ।\nभग्नविच्छिन्नविध्वस्तान्संशान्तानां करोत्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000571030, "chapter_id": 9571, "verse_number": "७-३६-३१", "content_sanskrit": "एवंविधानि कर्माणि प्रावर्तत महाबलः ।\nसर्वेषां ब्रह्मदण्डानामवध्यः शम्भुना कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000571031, "chapter_id": 9571, "verse_number": "७-३६-३२", "content_sanskrit": "जानन्त ऋषयस्तं वै सहन्ते तस्य शक्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000571032, "chapter_id": 9571, "verse_number": "७-३६-३३", "content_sanskrit": "यथा केसरिणा त्वेष वायुना सो ऽञ्जनासुतः ।\nप्रतिषिद्धो ऽपि मर्यादां लङ्घयत्येव वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000571033, "chapter_id": 9571, "verse_number": "७-३६-३४", "content_sanskrit": "ततो महर्षयः क्रुद्धा भृग्वङ्गिरसवंशजाः ।\nशेपुरेनं रघुश्रेष्ठ नातिक्रुद्धातिमन्यवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000571034, "chapter_id": 9571, "verse_number": "७-३६-३५", "content_sanskrit": "बाधसे यत्समाश्रित्य बलमस्मान्प्लवङ्गम ।\nतद्दीर्घकालं वेत्तासि नास्माकं शापमोहितः ।\nयदा ते स्मार्यते कीर्तिस्तदा ते वर्धते बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000571035, "chapter_id": 9571, "verse_number": "७-३६-३६", "content_sanskrit": "ततस्स हृततेजौजा महर्षिवचनौजसा ।\nएषोश्रमाणि तान्येव मृदुभावं गतो ऽचरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000571036, "chapter_id": 9571, "verse_number": "७-३६-३७", "content_sanskrit": "अथर्क्षरजसो नाम वालिसुग्रीवयोः पिता ।\nसर्ववानरराजा ऽ ऽसीत्तेजसा भास्करप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000571037, "chapter_id": 9571, "verse_number": "७-३६-३८", "content_sanskrit": "स तु राज्यं चिरं कृत्वा वानराणां हरीश्वरः ।\nस च ऋक्षरजा नाम कालधर्मेण सङ्गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000571038, "chapter_id": 9571, "verse_number": "७-३६-३९", "content_sanskrit": "तस्मिन्नस्तमिते चाथ मन्त्रिभिर्मन्त्रकोविदैः ।\nपित्र्ये पदे कृतो वाली सुग्रीवो वालिनः पदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000571039, "chapter_id": 9571, "verse_number": "७-३६-४०", "content_sanskrit": "सुग्रीवेण समं त्वस्य अद्वैधं छिद्रवर्जितम् ।\nआबाल्यं सख्यमभवदनिलस्याग्निना यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000571040, "chapter_id": 9571, "verse_number": "७-३६-४१", "content_sanskrit": "एष शापवशादेव न वेद बलमात्मनः ।\nवालिसुग्रीवयोर्वैरं यदा राम समुत्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000571041, "chapter_id": 9571, "verse_number": "७-३६-४२", "content_sanskrit": "न ह्येष राम सुग्रीवो भ्राम्यमाणो ऽपि वालिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000571042, "chapter_id": 9571, "verse_number": "७-३६-४३", "content_sanskrit": "देव जानाति न ह्येष बलमात्मनि मारुतिः ।\nऋषिशापाहृतबलस्तदैष कपिसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000571043, "chapter_id": 9571, "verse_number": "७-३६-४४", "content_sanskrit": "सिंहः कुञ्जररुद्धो वा आस्थितः सहितो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000571044, "chapter_id": 9571, "verse_number": "७-३६-४५", "content_sanskrit": "पराक्रमोत्साहमतिप्रतापसौशील्यमाधुर्यनयानयैश्च ।\nगाम्भीर्यचातुर्यसुवीर्यधैर्यैर्हनूमतः को ऽभ्यधिको ऽस्ति लोके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000571045, "chapter_id": 9571, "verse_number": "७-३६-४६", "content_sanskrit": "असौ पुनर्व्याकरणं ग्रहीष्यन्सूर्योन्मुखः प्रष्टुमना कपीन्द्रः ।\nउद्यद्गिरेरस्तगिरिं जगाम ग्रन्थं महद्धारयनप्रमेयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000571046, "chapter_id": 9571, "verse_number": "७-३६-४७", "content_sanskrit": "ससूत्रवृत्त्यर्थपदं महार्थं ससङ्ग्रहं साद्ध्यति वै कपीन्द्रः ।\nनह्यस्य कश्चित्सदृशो ऽस्ति शास्त्रे वैशारदे च्छन्दगतौ तथैव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000571047, "chapter_id": 9571, "verse_number": "७-३६-४८", "content_sanskrit": "सर्वासु विद्यासु तपोविधाने प्रस्पर्धते ऽयो हि गुरुं सुराणाम् ।\nसो ऽयं नवव्याकरणार्थवेत्ता ब्रह्मा भविष्यत्यपि ते प्रसादात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000571048, "chapter_id": 9571, "verse_number": "७-३६-४९", "content_sanskrit": "प्रवीविवक्षोरिव सागरस्य लोकान्दिधक्षोरिव पावकस्य\nयुगक्षये ह्येव यथान्तकस्य हनूमतः स्थास्यति कः पुरस्तात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000571049, "chapter_id": 9571, "verse_number": "७-३६-५०", "content_sanskrit": "एषेव चान्ये च महाकपीन्द्राः सुग्रीवमैन्दद्विविदाः सनीलाः ।\nसतारतारेयनलाः सरम्भास्त्वत्कारणाद्राम सुरैर्हि सृष्टाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000571050, "chapter_id": 9571, "verse_number": "७-३६-५१", "content_sanskrit": "तदेत्कथितं सर्वं यन्मां त्वं परिपृच्छसि ।\nहनूमतो बालभावे कर्मैतत्कथितं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000571051, "chapter_id": 9571, "verse_number": "७-३६-५२", "content_sanskrit": "श्रुत्वा ऽगस्त्यस्य कथितं रामः सौमित्रिरेव च ।\nविस्मयं परमं जग्मुर्वानरा राक्षसैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000571052, "chapter_id": 9571, "verse_number": "७-३६-५३", "content_sanskrit": "अगस्त्यस्त्वब्रवीद्रामं सर्वमेतछ्रुतं त्वया ।\nदृष्टः सम्भाषितश्चासि राम गच्छामहे वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000571053, "chapter_id": 9571, "verse_number": "७-३६-५४", "content_sanskrit": "श्रुत्वैतद्राघवो वाक्यमगस्त्यस्योग्रतेजसः ।\nप्राञ्जलिः प्रणतश्चापि महर्षिमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000571054, "chapter_id": 9571, "verse_number": "७-३६-५५", "content_sanskrit": "अद्य मे देवता हृष्टाः पितरः प्रपितामहाः ।\nयुष्माकं दर्शनादेव नित्यं तुष्टाः सबान्धवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000571055, "chapter_id": 9571, "verse_number": "७-३६-५६", "content_sanskrit": "विज्ञाप्यं तु ममैतद्धि यद्वदाम्यागतस्पृहः ।\nतद्भवद्भिर्मम कृते कर्तव्यमनुकम्पया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000571056, "chapter_id": 9571, "verse_number": "७-३६-५७", "content_sanskrit": "पौरजानपदान्स्थाप्य स्वकार्येष्वहमागतः ।\nक्रतूनेव करिष्यामि प्रभावाद्भवतां सताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000571057, "chapter_id": 9571, "verse_number": "७-३६-५८", "content_sanskrit": "सदस्या मम यज्ञेषु भवन्तो नित्यमेव तत् ।\nभविष्यथ महावीर्या ममानुग्रहकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000571058, "chapter_id": 9571, "verse_number": "७-३६-५९", "content_sanskrit": "अहं युष्मान्समाश्रित्य तपोनिर्धूतकल्मषान् ।\nअनुग्रहीतः पितृभिर्भविष्यामि सुनिर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000571059, "chapter_id": 9571, "verse_number": "७-३६-६०", "content_sanskrit": "तदागन्तव्यमनिशं भवद्भिरिह सङ्गतैः ।\nअगस्त्याद्यास्तु तच्छ्रुत्वा ऋषयः संशितव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000571060, "chapter_id": 9571, "verse_number": "७-३६-६१", "content_sanskrit": "एवमस्त्विति तं चोक्त्वा प्रयातुमुपचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000571061, "chapter_id": 9571, "verse_number": "७-३६-६२", "content_sanskrit": "एवमुक्त्वा गताः सर्वे ऋषयस्ते यथागतम् ।\nराघवश्च तमेवार्थं चिन्तयामास विस्मितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000571062, "chapter_id": 9571, "verse_number": "७-३६-६३", "content_sanskrit": "ततो ऽस्तं भास्करे याते विसृज्य नृपवानरान् ।\nसन्ध्यामुपास्य विधिवत्तदा नरवरोत्तमः ।\nप्रवृत्तायां रजन्यां तु सो ऽन्तःपुरचरो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000571063, "chapter_id": 9571, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे षट्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]