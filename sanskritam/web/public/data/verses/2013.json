[{"id": 2045557, "chapter_id": 2013, "verse_number": "६-६२-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2045558, "chapter_id": 2013, "verse_number": "६-६२-१", "content_sanskrit": "दैवमेव परं मन्ये पौरुषादपि सञ्जय।\nयत्सैन्यं मम पुत्रस्य पाण्डुपुत्रेण वध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2045559, "chapter_id": 2013, "verse_number": "६-६२-२", "content_sanskrit": "नित्यं हि मामकांस्तात हतानेव हि शंससि।\nअव्यग्रांश्च प्रहृष्टांश्च नित्यं शंशसि पाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2045560, "chapter_id": 2013, "verse_number": "६-६२-३", "content_sanskrit": "`विभग्नांश्च प्रनष्टांश्च नित्यं शंससि मामकान्।\nहीनान्पुरुषकारेण मामकानद्य सञ्जय ।\nपातितान्पात्यमानांश्च हतानेव च शंससि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2045561, "chapter_id": 2013, "verse_number": "६-६२-४", "content_sanskrit": "युध्यमानान्यथाशक्ति घटमानाञ्जयं प्रति।\nपाण्डवा हि जयन्त्येव जीयन्ते चैव मामकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2045562, "chapter_id": 2013, "verse_number": "६-६२-५", "content_sanskrit": "सोऽहं तीव्राणि दुःस्वानि दुर्योधनकृतानि च।\nश्रोष्यामि सततं तात दुःसहानि बहूनि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2045563, "chapter_id": 2013, "verse_number": "६-६२-६", "content_sanskrit": "तमुपायं न पश्यामि जीयेरन्येन पाण्डवान् ।\nमामका विजयं युद्धे प्राप्नुयुर्येन सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2045564, "chapter_id": 2013, "verse_number": "६-६२-७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2045565, "chapter_id": 2013, "verse_number": "६-६२-७", "content_sanskrit": "क्षयं मनुष्यदेहानां गजवाजिरथक्षयम्।\nश्रृणु राजन्स्थिरो भूत्वा तवैवापनयो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2045566, "chapter_id": 2013, "verse_number": "६-६२-८", "content_sanskrit": "धृष्टद्युम्नस्तु शल्येन पीडितो नवभिः शरैः।\nपीडयामास संक्रुद्धो मद्राधिपतिमायसैःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2045567, "chapter_id": 2013, "verse_number": "६-६२-९", "content_sanskrit": "तत्राद्भुतमपश्याम पार्षस्य पराक्रमम् ।\nन्यवारयत यस्तूर्णं शल्यं समितिशोभनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2045568, "chapter_id": 2013, "verse_number": "६-६२-१०", "content_sanskrit": "नान्तरं दृश्यते तत्र तयोश्च रथिनोस्तदा।\nमुहूर्तमिव तद्युद्धं तयोः सममिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2045569, "chapter_id": 2013, "verse_number": "६-६२-११", "content_sanskrit": "ततः शल्यो महाराज धृष्टद्युम्नस्य संयुगे।\nधनुश्चिच्छेद भल्लेन पीतेन निशितेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2045570, "chapter_id": 2013, "verse_number": "६-६२-१२", "content_sanskrit": "अथैनं शरवर्षेण च्छादयामास संयुगे।\nगिरिं जलागमे यद्वञ्जलदा जलवृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2045571, "chapter_id": 2013, "verse_number": "६-६२-१३", "content_sanskrit": "अभिमन्युस्ततः क्रुद्धो धृष्टद्युम्ने च पीडिते ।\nअभिदुद्राव वेगेन मद्रराजरथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2045572, "chapter_id": 2013, "verse_number": "६-६२-१४", "content_sanskrit": "ततो मद्राधिपस्थं कार्ष्णिः प्राप्यातिकोपनः ।\nआर्तायनिममेयात्मा विव्याध निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2045573, "chapter_id": 2013, "verse_number": "६-६२-१५", "content_sanskrit": "ततस्तु तावका राजन्परीप्सन्तोऽर्जुनं रणे।\nमद्रराजरथं तूर्णं परिवार्यावतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2045574, "chapter_id": 2013, "verse_number": "६-६२-१६", "content_sanskrit": "दुर्योधनो विकर्णश्च दुःशासनविविंशती।\nदुर्मर्षणो दुःसहश्च चित्रसेनोऽथ दुर्मुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2045575, "chapter_id": 2013, "verse_number": "६-६२-१७", "content_sanskrit": "सत्यव्रतश्च भद्रं ते पुरुमित्रश्च भारत।\nएते मद्राधिपरथं पालयन्तः स्थिता रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2045576, "chapter_id": 2013, "verse_number": "६-६२-१८", "content_sanskrit": "तान्भीमसेनः संक्रुद्धो धृष्टद्युम्नश्च पार्षतः ।\nद्रौपदेयाभिमन्युश्च माद्रीपुत्रौ च पाण्डवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2045577, "chapter_id": 2013, "verse_number": "६-६२-१९", "content_sanskrit": "धार्तराष्ट्रान्दश रथान्दशैव प्रत्यवारयन् ।\nनानारूपाणि शस्त्राणि विसृजन्तो विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2045578, "chapter_id": 2013, "verse_number": "६-६२-२०", "content_sanskrit": "अभ्यवर्तन्तं संहृष्टाः परस्परवधैषिणः।\nते वै समेयुः संग्रामे राजन्दुर्मन्त्रिते तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2045579, "chapter_id": 2013, "verse_number": "६-६२-२१", "content_sanskrit": "तस्मिन्दशरथे क्रुद्धे वर्तमाने महाभये।\nतावकानां परेषां वा प्रेक्षका रथिनोऽभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2045580, "chapter_id": 2013, "verse_number": "६-६२-२२", "content_sanskrit": "शस्त्राण्यनेकरूपाणि विसृजन्तो महारथाः।\nअन्योन्यमभिनर्दन्तः संप्रहारं प्रचक्रिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2045581, "chapter_id": 2013, "verse_number": "६-६२-२३", "content_sanskrit": "ते तदा जातसंरम्भाः सर्वेऽन्योन्यं जिघांसवः ।\nअन्योन्यमभिमर्दन्तः स्पर्धमानाः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2045582, "chapter_id": 2013, "verse_number": "६-६२-२४", "content_sanskrit": "अन्योन्यस्पर्धया राजञ्ज्ञातयः संगता मिथः ।\nमहास्राणि विमुञ्चन्तः समापेतुरमर्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2045583, "chapter_id": 2013, "verse_number": "६-६२-२५", "content_sanskrit": "दुर्योधनस्तु संक्रुद्धो धृष्टद्युम्नं महारणे ।\nविव्याध निशितैर्बाणैश्चतुर्भिः समरे द्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2045584, "chapter_id": 2013, "verse_number": "६-६२-२६", "content_sanskrit": "दुर्मर्षणश्च विंशत्या चित्रसेनश्च प़ञ्चभिः ।\nदुर्मुखो नवभिर्बाणैर्दुःसहश्चापि सप्तभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2045585, "chapter_id": 2013, "verse_number": "६-६२-२७", "content_sanskrit": "विविंशतिः पञ्चभिश्च त्रिभिर्दुःशासनस्तथा।\nतान्प्रत्यविध्यद्राजेन्द्र पार्षतः शत्रुतापनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2045586, "chapter_id": 2013, "verse_number": "६-६२-२८", "content_sanskrit": "एकैकं पञ्चविंशत्या दर्शयन्पाणिलाघवम् ।\nसत्यव्रतं च समरे पुरुमित्रं च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2045587, "chapter_id": 2013, "verse_number": "६-६२-२९", "content_sanskrit": "अभिमन्युरविध्यत्तु दशभिर्दशभिः शरैः।\nमाद्रीपुत्रौ तु समरे मातुलं मातृनन्दनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2045588, "chapter_id": 2013, "verse_number": "६-६२-३०", "content_sanskrit": "अविध्येतां शरैस्तीक्ष्णैस्तदद्भुतमिवाभवत्।\nततः शल्यो महाराज स्वस्त्रीयौ रथिनां वरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2045589, "chapter_id": 2013, "verse_number": "६-६२-३१", "content_sanskrit": "शरैर्बहुभिरानर्च्छत्कृतप्रतिकृतैषिणौ ।\nछाद्यमानौ ततस्तौ कतु माद्रीपुत्रौ न चेलतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2045590, "chapter_id": 2013, "verse_number": "६-६२-३२", "content_sanskrit": "अथ दुर्योधनं दृष्ट्वा भीमसेनो महाबलः ।\nविधित्सुः कलहस्यान्तं गदां जग्राह पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2045591, "chapter_id": 2013, "verse_number": "६-६२-३३", "content_sanskrit": "तमुद्यतगदं दृष्ट्वा कैलासमिव श्रृङ्गिणम्।\nभीमसेनं महाबाहुं पुत्रास्ते प्राद्रवन्भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2045592, "chapter_id": 2013, "verse_number": "६-६२-३४", "content_sanskrit": "दुर्योधनस्तु संक्रुद्धो मागधं समचोदयत्।\nअनीकं दशसाहस्रं कुञ्जराणां तरस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2045593, "chapter_id": 2013, "verse_number": "६-६२-३५", "content_sanskrit": "गजानीकेन सहितस्तेन राजा सुयोधनाः ।\nमागधं पुरतः कृत्वा भीमसेनं समभ्ययात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2045594, "chapter_id": 2013, "verse_number": "६-६२-३६", "content_sanskrit": "आपतन्तं च तं दृष्ट्वा गजानीकं वृकोदरः ।\nगदापाणिरवारोहद्रथांत्सिंह इवोन्नदन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2045595, "chapter_id": 2013, "verse_number": "६-६२-३७", "content_sanskrit": "अद्रिसारमयीं गुर्वीं प्रगृह्य महतीं गदाम्।\nअभ्यधावद्गजानीकं व्यादितास्य इवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2045596, "chapter_id": 2013, "verse_number": "६-६२-३८", "content_sanskrit": "स गजान्गदया निघ्नन्व्यचरत्समरे बली।\nभीमसेनो महाबाहुः सवज्र इव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2045597, "chapter_id": 2013, "verse_number": "६-६२-३९", "content_sanskrit": "तस्य नादेन महता मनोहृदयकम्पिना ।\nव्यत्यचेष्टन्त संहत्य गजा भिमस्य गर्जतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2045598, "chapter_id": 2013, "verse_number": "६-६२-४०", "content_sanskrit": "ततस्तु द्रौपदीपुत्राः सौभद्रश्च महारथः।\nनकुलः सहदेवश्च धृष्टद्युम्नश्च पार्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2045599, "chapter_id": 2013, "verse_number": "६-६२-४१", "content_sanskrit": "पृष्ठं भीमस्य रक्षन्तः शरवर्षेण वारणान्।\nअभ्यवर्षन्त धावन्तो मेघा इव गिरिव्रजान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2045600, "chapter_id": 2013, "verse_number": "६-६२-४२", "content_sanskrit": "नाकुलिस्तु शतानीकः समरे शत्रुपूगहा ।\nक्षुरैः क्षुरप्रैर्भल्लैश्च पीतैश्चाञ्जलिकैः शितैः।\nन्यहनच्चोत्तमाङ्गानि पाण्डवो गजयोधिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2045601, "chapter_id": 2013, "verse_number": "६-६२-४३", "content_sanskrit": "शिरोभिः प्रपतद्भिश्च बाहुभिश्च विभूषितैः ।\nअश्मवृष्टिरिवाभाति पाणिभिश्च सहाङ्कुशैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2045602, "chapter_id": 2013, "verse_number": "६-६२-४४", "content_sanskrit": "हृतोत्तमाङ्गाः स्कन्धेषु गजानां गजयोधिनः।\nअदृश्यन्ताचलाग्रेकषु द्रुमा भग्नशिखा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2045603, "chapter_id": 2013, "verse_number": "६-६२-४५", "content_sanskrit": "धृष्टद्युम्नहतानन्यानपश्याम महागजान्।\nपततः पात्यमानांश्च पार्षतेन महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2045604, "chapter_id": 2013, "verse_number": "६-६२-४६", "content_sanskrit": "मागधोऽथ महीपालो गजमैरावणोपमम्।\nप्रेषयामास समरे सौभद्रस्य रथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2045605, "chapter_id": 2013, "verse_number": "६-६२-४७", "content_sanskrit": "तमापतन्तं संप्रेक्ष्य मागधस्य महागजम् ।\nजघानैकेषुणा वीरःत सौभद्रः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2045606, "chapter_id": 2013, "verse_number": "६-६२-४८", "content_sanskrit": "तस्यावर्जितनागस्य कार्ष्णिः परपुरंजयः।\nराज्ञो रजतपुङ्खेन भल्लेनापाहरच्छिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2045607, "chapter_id": 2013, "verse_number": "६-६२-४९", "content_sanskrit": "विगाह्य तद्गजानीकं भीमसेनोऽपि पाण्डवः।\nव्यचरत्समरे मृद्गन्गजानिन्द्रो गिरीनिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2045608, "chapter_id": 2013, "verse_number": "६-६२-५०", "content_sanskrit": "एकप्रहारनिहतान्भीमसेनेन दन्तिनः।\nअपश्याम रणे तस्मिन्गिरीन्वज्रहतानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2045609, "chapter_id": 2013, "verse_number": "६-६२-५१", "content_sanskrit": "भग्नदन्तान्भग्नकरान्भग्नसक्थीश्च वारणान्।\nभग्नपृष्ठत्रिकानन्यान्निहतान्पर्वतोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2045610, "chapter_id": 2013, "verse_number": "६-६२-५२", "content_sanskrit": "नदतः सीदतश्चान्यान्विमुखान्समरे गतान्।\nविद्रुतान्भयसंविग्नांस्तथा विशकृतोऽपरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2045611, "chapter_id": 2013, "verse_number": "६-६२-५३", "content_sanskrit": "भीमसेनस्य मार्गेषु पतितान्पर्वतोपमान् ।\nअपश्यं निहतान्नागान्राजन्निष्ठीवतोपरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2045612, "chapter_id": 2013, "verse_number": "६-६२-५४", "content_sanskrit": "वमन्तो रुधिरं चान्ये भिन्नकुम्भा महागजाः ।\nविह्नलन्तो गता भूमिं शैला इव धरातले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2045613, "chapter_id": 2013, "verse_number": "६-६२-५५", "content_sanskrit": "मेदोरुधिरदिग्धाङ्गो वसामज्जासमुक्षितः ।\nव्यचरत्समरे भीमो दण्डपाणिरिवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2045614, "chapter_id": 2013, "verse_number": "६-६२-५६", "content_sanskrit": "गजानां रुधिरक्लिन्नां गदां बिभ्रद्वृकोदरः ।\nघोरः प्रतिभयश्चासीत्पिनाकीव पिनाकभृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2045615, "chapter_id": 2013, "verse_number": "६-६२-५७", "content_sanskrit": "संमथ्यमानाः क्रुद्धेन भीमसेनेन दन्तिनः ।\nसहसा प्राद्रवन्क्लिष्ठा मृद्गन्तस्तव वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2045616, "chapter_id": 2013, "verse_number": "६-६२-५८", "content_sanskrit": "तं हि वीरं महेष्वासं सौभद्रप्रमुखा रथाः ।\nपर्यरक्षन्त युध्यन्तं वज्रायुधमिवामराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2045617, "chapter_id": 2013, "verse_number": "६-६२-५९", "content_sanskrit": "शोणिताक्तां गदां बिभ्रदुक्षितां गजशोणितैः ।\nकृतान्त इव रोद्रात्मा भीमसेनो व्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2045618, "chapter_id": 2013, "verse_number": "६-६२-६०", "content_sanskrit": "व्यायच्छमानं गदया दिक्षु सर्वासु भारत।\nअपश्याम रणे भीमं नृत्यन्तमिव शङ्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2045619, "chapter_id": 2013, "verse_number": "६-६२-६१", "content_sanskrit": "यमदण्डोपमां गुर्वीमिन्द्राशनिसमकस्वनाम् ।\nअपश्याम महाराय रौद्रां विशसनीं गदाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2045620, "chapter_id": 2013, "verse_number": "६-६२-६२", "content_sanskrit": "विमिश्रां केशमञ्जाभिः प्रदिग्धां रुधिरेण च।\nपिनाकमिव रुद्रस्य क्रुद्धस्याभिघ्नतः पशून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2045621, "chapter_id": 2013, "verse_number": "६-६२-६३", "content_sanskrit": "यथा पशूनां सङ्घातं यष्ट्या पालः प्रकालयेत्।\nतथा भीमो गजानीकं गदया समकालयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2045622, "chapter_id": 2013, "verse_number": "६-६२-६४", "content_sanskrit": "गदया वध्यमानास्ते मार्गणैश्च समन्ततः।\nस्वान्यनीकानि मृद्गन्तः प्राद्रवन्कुञ्जरास्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2045623, "chapter_id": 2013, "verse_number": "६-६२-६५", "content_sanskrit": "महावात इवाभ्राणि विधमित्वा स वारणान्।\nअतिष्ठत्तुमुले भीमः श्मशान इव शूलभृत् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2045624, "chapter_id": 2013, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि चतुर्थदिवसयुद्धे द्विषष्टितमोऽद्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]