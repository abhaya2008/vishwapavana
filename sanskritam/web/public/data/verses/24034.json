[{"id": 7004034000, "chapter_id": 24034, "verse_number": "३-३-५-१", "content_sanskrit": "सूत उवाच ।\nशिवो गुरुः शिवो देवः शिवो बंधुः शरीरिणाम् ।\nशिव आत्मा शिवो जीवःशिवादन्यन्न किञ्चन॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004034001, "chapter_id": 24034, "verse_number": "३-३-५-२", "content_sanskrit": "शिवमुद्दिश्य यत्किंचिद्दत्तं जप्तं हुतं कृतम् ।\nतदनंतफलं प्रोक्तं सर्वागमविनिश्चितम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004034002, "chapter_id": 24034, "verse_number": "३-३-५-३", "content_sanskrit": "भक्त्या निवेदितं शंभोः पत्रं पुष्पं फलं जलम् ।\nअल्पादल्पतरं वापि तदानंत्याय कल्पते॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004034003, "chapter_id": 24034, "verse_number": "३-३-५-४", "content_sanskrit": "विहाय सकलान्धर्मान्सकलागमनिश्चितान् ।\nशिवमेकं भजेद्यस्तु मुच्यते सर्वबन्धनात्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004034004, "chapter_id": 24034, "verse_number": "३-३-५-५", "content_sanskrit": "या प्रीतिरात्मनः पुत्रे या कलत्रे धनेपि सा ।\nकृता चेच्छिवपूजायां त्रायतीति किमद्भुतम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004034005, "chapter_id": 24034, "verse_number": "३-३-५-६", "content_sanskrit": "तस्मात्केचिन्महात्मानः सकलान्विषयासवान् ।\nत्यजंति शिवपूजार्थे स्वदेहमपि दुस्त्यजम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004034006, "chapter_id": 24034, "verse_number": "३-३-५-७", "content_sanskrit": "सा जिह्वा या शिवं स्तौति तन्मनो ध्यायते शिवम् ।\nतौ कर्णौ तत्कथालोलौ तौ हस्तौ तस्य पूजकौ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004034007, "chapter_id": 24034, "verse_number": "३-३-५-८", "content_sanskrit": "ते नेत्रे पश्यतः पूजां तच्छिरः प्रणतं शिवे ।\nतौ पादौ यौ शिवक्षेत्रं भक्त्या पर्यटतः सदा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004034008, "chapter_id": 24034, "verse_number": "३-३-५-९", "content_sanskrit": "यस्येन्द्रियाणि सर्वाणि वर्तंते शिवकर्मसु ।\nस निस्तरति संसारं भुक्तिं मुक्तिं च विंदति॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004034009, "chapter_id": 24034, "verse_number": "३-३-५-१०", "content_sanskrit": "शिवभक्तियुतो मर्त्यश्चांडालः पुल्कसोपि च ।\nनारी नरो वा षंढो वा सद्यो मुच्येत संसृतेः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004034010, "chapter_id": 24034, "verse_number": "३-३-५-११", "content_sanskrit": "किं कुलेन किमाचारैः किंशीलेन गुणेन वा ।\nभक्तिलेशयुतः शंभोः स वंद्यः सर्वदेहिनाम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004034011, "chapter_id": 24034, "verse_number": "३-३-५-१२", "content_sanskrit": "उज्जयिन्यामभूद्राजा चन्द्रसेनसमाह्वयः ।\nजातो मानवरूपेण द्वितीय इव वासवः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004034012, "chapter_id": 24034, "verse_number": "३-३-५-१३", "content_sanskrit": "तस्मिन्पुरे महाकालं वसंतं परमेश्वरम् ।\nसंपूजयत्यसौ भक्त्या चन्द्रसेनो नृपोत्तमः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004034013, "chapter_id": 24034, "verse_number": "३-३-५-१४", "content_sanskrit": "तस्याभवत्सखा राज्ञः शिवपारिषदाग्रणीः ।\nमणिभद्रो जिताभद्रः सर्वलोकनमस्कृतः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004034014, "chapter_id": 24034, "verse_number": "३-३-५-१५", "content_sanskrit": "तस्यै कदा महीभर्तुः प्रसन्नः शंकरानुगः ।\nचिन्तामणिं ददौ दिव्यं मणिभद्रो महामतिः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004034015, "chapter_id": 24034, "verse_number": "३-३-५-१६", "content_sanskrit": "स मणिः कौस्तुभ इव द्योतमानोर्कसन्निभः ।\nदृष्टः श्रुतो वा ध्यातो वा नृणां यच्छति चिंतितम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004034016, "chapter_id": 24034, "verse_number": "३-३-५-१७", "content_sanskrit": "तस्य कांतिलवस्पृष्टं कांस्यं ताम्रमयस्त्रपु ।\nपाषाणादिकमन्यद्वा सद्यो भवति कांचनम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004034017, "chapter_id": 24034, "verse_number": "३-३-५-१८", "content_sanskrit": "स तं चिन्तामणिं कंठे बिभ्रद्राजासनं गतः ।\nरराज राजा देवानां मध्ये भानुरिव स्वयम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004034018, "chapter_id": 24034, "verse_number": "३-३-५-१९", "content_sanskrit": "सदा चिन्तामणिग्रीवं तं श्रुत्वा राजसत्तमम् ।\nप्रवृद्धतर्षा राजानः सर्वे क्षुब्धहृदोऽभवन्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004034019, "chapter_id": 24034, "verse_number": "३-३-५-२०", "content_sanskrit": "स्नेहात्केचिदयाचंत धार्ष्ट्यात्केचन दुर्मदाः ।\nदैवलब्धमजानंतो मणिं मत्सरिणो नृपाः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004034020, "chapter_id": 24034, "verse_number": "३-३-५-२१", "content_sanskrit": "सर्वेषां भूभृतां याञ्चा यदा व्यर्थीकृतामुना ।\nराजानः सर्वदेशानां संरंभं चक्रिरे तदा॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004034021, "chapter_id": 24034, "verse_number": "३-३-५-२२", "content_sanskrit": "सौराष्ट्राः कैकयाः शाल्वाः कलिंगशकमद्रकाः ।\nपांचालावंतिसौवीरा मागधा मत्स्यसृंजयाः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004034022, "chapter_id": 24034, "verse_number": "३-३-५-२३", "content_sanskrit": "एते चान्ये च राजानः सहाश्वरथकुमजराः ।\nचन्द्रसेनं मृधे जेतुमुद्यमं चक्रुरोजसा॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004034023, "chapter_id": 24034, "verse_number": "३-३-५-२४", "content_sanskrit": "ते तु सर्वे सुसंरब्धाः कंपयंतो वसुन्धराम् ।\nउज्जयिन्याश्चतुर्द्वारं रुरुधुर्बहुसैनिकाः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004034024, "chapter_id": 24034, "verse_number": "३-३-५-२५", "content_sanskrit": "संरुध्यमानो स्वपुरीं दृष्ट्वा राजभिरुद्धतैः ।\nचंद्रसेनो महाकालं तमेव शरणं ययौ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004034025, "chapter_id": 24034, "verse_number": "३-३-५-२६", "content_sanskrit": "निर्विकल्पो निराहारः स राजा दृढनिश्चयः ।\nअर्चयामास गौरीशं दिवा नक्त मनन्यधीः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004034026, "chapter_id": 24034, "verse_number": "३-३-५-२७", "content_sanskrit": "एतस्मिन्नंतरे गोपी काचित्तत्पुरवासिनी ।\nएकपुत्रा भर्तृहीना तत्रैवासीच्चिरंतना॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004034027, "chapter_id": 24034, "verse_number": "३-३-५-२८", "content_sanskrit": "सा पंचहायनं बालं वहंती गत भर्तृका ।\nराज्ञा कृतां महापूजां ददर्श गिरिजापतेः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004034028, "chapter_id": 24034, "verse_number": "३-३-५-२९", "content_sanskrit": "सा दृष्ट्वा सर्वमाश्चर्यं शिवपूजामहोदयम् ।\nप्रणिपत्य स्वशिबिरं पुनरेवाभ्यपद्यत॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004034029, "chapter_id": 24034, "verse_number": "३-३-५-३०", "content_sanskrit": "एतत्सर्वमशेषेण स दृष्ट्वा बल्लवीसुतः ।\nकुतूहलेन विदधे शिवपूजां विरक्तिदाम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004034030, "chapter_id": 24034, "verse_number": "३-३-५-३१", "content_sanskrit": "आनीय हृद्यं पाषाणं शून्ये तु शिबिरोत्तमे ।\nनातिदूरे स्वशिबिराच्छिवलिंगमकल्पयत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004034031, "chapter_id": 24034, "verse_number": "३-३-५-३२", "content_sanskrit": "यानि कानि च पुष्पाणि हस्तलभ्यानि चात्मनः ।\nआनीय स्नाप्य तल्लिंगं पूजयामास भक्तितः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004034032, "chapter_id": 24034, "verse_number": "३-३-५-३३", "content_sanskrit": "गंधालंकारवासांसि धूपदीपाक्षतादिकम् ।\nविधाय कृत्रिमैर्दिव्यैर्नैवेद्यं चाप्यकल्पयत्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004034033, "chapter_id": 24034, "verse_number": "३-३-५-३४", "content_sanskrit": "भूयोभूयः समभ्यर्च्य पत्रैः पुष्पैर्मनोरमैः ।\nनृत्यं च विविधं कृत्वा प्रणनाम पुनःपुनः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004034034, "chapter_id": 24034, "verse_number": "३-३-५-३५", "content_sanskrit": "एवं पूजां प्रकुर्वाणं शिवस्यानन्यमानसम् ।\nसा पुत्रं प्रणयाद्गोपी भोजनाय समा ह्वयत्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004034035, "chapter_id": 24034, "verse_number": "३-३-५-३६", "content_sanskrit": "मात्राहूतोपि बहुशः स पूजासक्तमानसः ।\nबालोपि भोजनं नच्छत्तदा माता स्वयं ययौ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004034036, "chapter_id": 24034, "verse_number": "३-३-५-३७", "content_sanskrit": "तं विलोक्य शिवस्याग्रे निषण्णं मी लितेक्षणम् ।\nचकर्ष पाणिं संगृह्य कोपेन समताडयत्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004034037, "chapter_id": 24034, "verse_number": "३-३-५-३८", "content_sanskrit": "आकृष्टस्ताडितो वापि नागच्छत्स्वसुतो यदा ।\nतां पूजां नाशयामास क्षिप्त्वा लिंगं विदूरतः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004034038, "chapter_id": 24034, "verse_number": "३-३-५-३९", "content_sanskrit": "हाहेति रुदमानं तं निर्भर्त्स्य स्वसुतं तदा ।\nपुनर्विवेश स्वगृहं गोपी रोषसमन्विता॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004034039, "chapter_id": 24034, "verse_number": "३-३-५-४०", "content_sanskrit": "मात्रा विनाशितां पूजां दृष्ट्वा देवस्य शूलिनः ।\nदेवदेवेति चुक्रोश निपपात स बालकः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004034040, "chapter_id": 24034, "verse_number": "३-३-५-४१", "content_sanskrit": "प्रनष्टसंज्ञः सहसा बाष्पपूरपरिप्लुतः ।\nलब्धसंज्ञो मुहूर्तेन चक्षुषी उदमीलयत्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004034041, "chapter_id": 24034, "verse_number": "३-३-५-४२", "content_sanskrit": "ततो मणिस्तंभविराजमानं हिरण्मयद्वारकपाटतोरणम् ।\nमहार्हनीलामलवज्रवेदिकं तदेव जातं शिबिरं शिवालयम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004034042, "chapter_id": 24034, "verse_number": "३-३-५-४३", "content_sanskrit": "संतप्तहेम कलशैर्बहुभिर्विचित्रैः प्रोद्भासितस्फटिकसौधतलाभिरामम् ।\nरम्यं च तच्छिवपुरं वरपीठमध्ये लिंगं च रत्नसहितं स ददर्श बालः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004034043, "chapter_id": 24034, "verse_number": "३-३-५-४४", "content_sanskrit": "स दृष्ट्वा सहसोत्थाय भीतविस्मितमानसः ।\nनिमग्न इव संतोषात्परमानंदसागरे॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004034044, "chapter_id": 24034, "verse_number": "३-३-५-४५", "content_sanskrit": "विज्ञाय शिवपूजाया माहात्म्यं तत्प्रभावतः ।\nननाम दंडवद्भूमौ स्वमातुरघशांतये॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004034045, "chapter_id": 24034, "verse_number": "३-३-५-४६", "content_sanskrit": "देव क्षमस्व दुरितं मम मातुरुमापते ।\nमूढायास्त्वामजानंत्याः प्रसन्नो भव शंकर॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004034046, "chapter_id": 24034, "verse_number": "३-३-५-४७", "content_sanskrit": "यद्यस्ति मयि यत्किंचित्पुण्यं त्वद्भक्तिसंभवम् ।\nतेनापि शिव मे माता तव कारुण्यमाप्नुयात्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004034047, "chapter_id": 24034, "verse_number": "३-३-५-४८", "content_sanskrit": "इति प्रसाद्य गिरिशं भूयोभूयः प्रणम्य च ।\nसूर्ये चास्तं गते बालो निर्जगाम शिवालयात्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004034048, "chapter_id": 24034, "verse_number": "३-३-५-४९", "content_sanskrit": "अथापश्यत्स्वशिबिरं पुरंदरपुरोपमम् ।\nसद्यो हिरण्मयीभूतं विचित्रविभवोज्ज्वलम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004034049, "chapter_id": 24034, "verse_number": "३-३-५-५०", "content_sanskrit": "सोंतः प्रविश्य भवनं मोदमानो निशामुखे ।\nमहामणिगणाकीर्णं हेमराशिसमुज्ज्वलम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004034050, "chapter_id": 24034, "verse_number": "३-३-५-५१", "content_sanskrit": "तत्रापश्यत्स्वजननीं स्मरंतीमकुतोभयाम् ।\nमहार्हरत्न पर्यंके सितशय्यामधिश्रिताम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004034051, "chapter_id": 24034, "verse_number": "३-३-५-५२", "content_sanskrit": "रत्नालंकारदीप्तांगीं दिव्यांबरविराजिनीम् ।\nदिव्यलक्षणसंपन्नां साक्षात्सुरवधूमिव॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004034052, "chapter_id": 24034, "verse_number": "३-३-५-५३", "content_sanskrit": "जवेनोत्थापयामास संभ्रमोत्फुल्ललोचनः ।\nअंब जागृहि भद्रं ते पश्येदं महदद्भुतम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004034053, "chapter_id": 24034, "verse_number": "३-३-५-५४", "content_sanskrit": "इति प्रबोधिता गोपी स्वपुत्रेण महात्मना ।\nततोऽपश्यत्स्वजननी स्मयन्ती मुकुटोज्ज्वला॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004034054, "chapter_id": 24034, "verse_number": "३-३-५-५५", "content_sanskrit": "ससंभ्रमं समुत्थाय तत्सर्वं प्रत्यवेक्षत ।\nअपूर्वमिव चात्मानमपूर्वमिव बालकम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004034055, "chapter_id": 24034, "verse_number": "३-३-५-५६", "content_sanskrit": "अपूर्वं च स्वसदनं दृष्ट्वा सीत्सुखविह्वला ।\nश्रुत्वा पुत्रमुखात्सर्वं प्रसादं गिरिजापतेः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004034056, "chapter_id": 24034, "verse_number": "३-३-५-५७", "content_sanskrit": "राज्ञे विज्ञापयामास यो भजत्यनिशं शिवम् ।\nस राजा सहसागत्य समाप्त नियमो निशि॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004034057, "chapter_id": 24034, "verse_number": "३-३-५-५८", "content_sanskrit": "ददर्श गोपिकासूनोः प्रभावं शिवतोषजम् ।\nहिरण्मयं शिवस्थानं लिंगं मणिमयं तथा॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004034058, "chapter_id": 24034, "verse_number": "३-३-५-५९", "content_sanskrit": "गोपवध्वाश्च सदनं माणि क्यवरकोज्ज्वलम् ।\nदृष्ट्वा महीपतिः सर्वं सामात्यः सपुरोहितः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004034059, "chapter_id": 24034, "verse_number": "३-३-५-६०", "content_sanskrit": "मुहूर्तं विस्मितधृतिः परमानंदनिर्भरः ।\nप्रेम्णा वाष्पजलं मुंचन्परिरेभे तम र्भकम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004034060, "chapter_id": 24034, "verse_number": "३-३-५-६१", "content_sanskrit": "एवमत्यद्भुताकाराच्छिवमाहात्म्यकीर्त्तनात् ।\nपौराणां संभ्रमाच्चैव सा रात्रिः क्षणतामगात्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004034061, "chapter_id": 24034, "verse_number": "३-३-५-६२", "content_sanskrit": "अथ प्रभाते युद्धाय पुरं संरुध्य संस्थिताः ।\nराजानश्चारवक्त्रेभ्यः शुश्रुवुः परमाद्भुतम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004034062, "chapter_id": 24034, "verse_number": "३-३-५-६३", "content_sanskrit": "ते त्यक्तवैराः सहसा राजानश्चकिता भृशम् ।\nन्यस्तशस्त्रा निविविशुश्चंद्रसेनानुमोदिताः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004034063, "chapter_id": 24034, "verse_number": "३-३-५-६४", "content_sanskrit": "तां प्रविश्य पुरीं रम्यां महाकालं प्रणम्य च ।\nतद्गोपवनितागेहमाजग्मुः सर्वभूभृतः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004034064, "chapter_id": 24034, "verse_number": "३-३-५-६५", "content_sanskrit": "ते तत्र चंद्रसेनेन प्रत्युद्गम्याभि पूजिताः ।\nमहार्हविष्टरगताः प्रीत्यानंदन्सुविस्मिताः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004034065, "chapter_id": 24034, "verse_number": "३-३-५-६६", "content_sanskrit": "गोपसूनोः प्रसादाय प्रादुर्भूतं शिवालयम् ।\nलिंगं च वीक्ष्य सुमहच्छिवे चक्रुः परां मतिम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004034066, "chapter_id": 24034, "verse_number": "३-३-५-६७", "content_sanskrit": "तस्मै गोपकुमाराय प्रीतास्ते सर्वभूभुजः ।\nवासोहिरण्यरत्नानि गोमहिष्यादिकं धनम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004034067, "chapter_id": 24034, "verse_number": "३-३-५-६८", "content_sanskrit": "गजानश्वान्रथान्रौक्माञ्छत्र यानपरिच्छदान् ।\nदासान्दासीरनेकाश्च ददुः शिवकृपार्थिनः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004034068, "chapter_id": 24034, "verse_number": "३-३-५-६९", "content_sanskrit": "येये सर्वेषु देशेषु गोपास्तिष्ठंति भूरिशः ।\nतेषां तमेव राजानं चक्रिरे सर्व पार्थिवाः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004034069, "chapter_id": 24034, "verse_number": "३-३-५-७०", "content_sanskrit": "अथास्मिन्नंतरे सर्वैस्त्रिदशैरभिपूजितः ।\nप्रादुर्बभूव तेजस्वी हनूमान्वानरेश्वरः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004034070, "chapter_id": 24034, "verse_number": "३-३-५-७१", "content_sanskrit": "तस्याभिगमनादेव राजानो जातसंभ्रमाः ।\nप्रत्युत्थाय नमश्चक्रुर्भक्तिनम्रात्ममूर्त्तयः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004034071, "chapter_id": 24034, "verse_number": "३-३-५-७२", "content_sanskrit": "तेषां मध्ये समासीनः पूजितः प्लवगेश्वरः ।\nगोपात्मजं समाश्लिष्य राज्ञो वीक्ष्येदमववीत्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004034072, "chapter_id": 24034, "verse_number": "३-३-५-७३", "content_sanskrit": "सर्वे शृणुत भद्रं वो राजानो ये च देहिनः ।\nशिवपूजामृते नान्या गतिरस्ति शरीरिणाम॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004034073, "chapter_id": 24034, "verse_number": "३-३-५-७४", "content_sanskrit": "एष गोपसुतो दिष्ट्या प्रदोषे मंदवा सरे ।\nअमंत्रेणापि संपूज्य शिवं शिवमवाप्तवान्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004034074, "chapter_id": 24034, "verse_number": "३-३-५-७५", "content_sanskrit": "मंदवारे प्रदोषोऽयं दुर्लभः सर्वदेहिनाम् ।\nतत्रापि दुर्लभतरः कृष्णपक्षे समागते॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004034075, "chapter_id": 24034, "verse_number": "३-३-५-७६", "content_sanskrit": "एष पुण्यतमो लोके गोपानां कीर्तिवर्धनः ।\nअस्य वंशेऽष्टमो भावी नंदोनाम महायशाः ।\nप्राप्स्यते तस्य पुत्रत्वं कृष्णो नारा यणः स्वयम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004034076, "chapter_id": 24034, "verse_number": "३-३-५-७७", "content_sanskrit": "अद्यप्रभृति लोकेस्मिन्नेष गोपालनंदनः ।\nनाम्ना श्रीकर इत्युच्चैर्लोके ख्यातिं गमिष्यति॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004034077, "chapter_id": 24034, "verse_number": "३-३-५-७८", "content_sanskrit": "सूत उवाच ।\nएवमुक्त्वांजनीसूनुस्तस्मै गोपकसूनवे ।\nउपदिश्य शिवाचारं तत्रैवांतरधीयत॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004034078, "chapter_id": 24034, "verse_number": "३-३-५-७९", "content_sanskrit": "ते च सर्वे महीपालाः संहृष्टाः प्रतिपूजिताः ।\nचन्द्रसेनं समामंत्र्य प्रतिजग्मुर्यथागतम्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004034079, "chapter_id": 24034, "verse_number": "३-३-५-८०", "content_sanskrit": "श्रीकरोऽपि महातेजा उपदिष्टो हनूमता ।\nब्राह्मणैः सह धर्मज्ञैश्चक्रे शम्भोः समर्हणम्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004034080, "chapter_id": 24034, "verse_number": "३-३-५-८१", "content_sanskrit": "कालेन श्रीकरः सोऽपि चंद्रसेनश्च भूपतिः ।\nसमाराध्य शिवं भक्त्या प्रापतुः परमं पदम्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004034081, "chapter_id": 24034, "verse_number": "३-३-५-८२", "content_sanskrit": "इदं रहस्यं परमं पवित्रं यशस्करं पुण्यमहर्द्धिवर्धनम् ।\nआख्यानमाख्यातमघौघनाशनं गौरीशपादांबुजभक्तिवर्धनम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]