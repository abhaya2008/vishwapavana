[
  {
    "id": 20006492,
    "chapter_id": 6639,
    "verse_number": "9.1",
    "content_sanskrit": "अभितापसंपदमथोष्णरुचिर्निजतेसामसहमान इव । पयसि प्रपित्सुरपराम्बुनिधेरधिरोढुमस्तगिरिमभ्यपतत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20006493,
    "chapter_id": 6639,
    "verse_number": "9.2",
    "content_sanskrit": "गतया पुरः प्रतिगवाक्षमुखं दधती रतेन भृशमुत्सुकतां । मुहुरन्तारालभुवमस्तगिरेः सवितुश्च योषिदमिमीत दृशा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20006494,
    "chapter_id": 6639,
    "verse_number": "9.3",
    "content_sanskrit": "विरलात पच्छविरनुष्णवपुः परितो विपाण्डु दधदभ्रशिरः । अभवद्गतः परिणतिं शिथिलः परमन्दसूर्यनयनो दिवसः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20006495,
    "chapter_id": 6639,
    "verse_number": "9.4",
    "content_sanskrit": "अपराह्नशीतलतरेण शनैरनिलेन लोलितलताङ्गुलये । निलयाय शाखिन इवाह्रयते दुदुराकुलाः खगकुलानि गिरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20006496,
    "chapter_id": 6639,
    "verse_number": "9.5",
    "content_sanskrit": "उपसंध्यमास्त तनु सानुमतः शिखरेषु तत्क्षणमशीतरुचः । करजालमस्तमयेऽपि सतामुतितं खलूच्चतरमेव पदम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20006497,
    "chapter_id": 6639,
    "verse_number": "9.6",
    "content_sanskrit": "प्रतिकूलमुपगते हि विधौ विफलत्वमेति बहुसाधनता । अवलम्बनाय दिनभर्तुरभून्न पतिष्यतः करसहस्रमपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20006498,
    "chapter_id": 6639,
    "verse_number": "9.7",
    "content_sanskrit": "नवकुङ्कुमारुणपयोधरया स्वकरावसक्तरुचिराम्बरया । अतिसक्तिमेत्य वरुणस्य दिशा भृशमन्वरज्यदतुषारकरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20006499,
    "chapter_id": 6639,
    "verse_number": "9.8",
    "content_sanskrit": "गतवत्यराजत जपाकुसुमस्तबकद्युतौ दिनकरेऽवनतिम् । बहलानुरागकुरुविन्ददलप्रतिबद्धमध्यमिव दिग्वलयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20006500,
    "chapter_id": 6639,
    "verse_number": "9.9",
    "content_sanskrit": "द्रुतशातकुम्भनिभमंशुमतो वपुरर्धमग्नवपुषः पयसि । रुरुचे विरिञ्चिनखभिन्नबृहद्दणडकैकतरखण्डमिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20006501,
    "chapter_id": 6639,
    "verse_number": "9.10",
    "content_sanskrit": "अनुरागवन्तमपि लोचनयोर्दधतं वपुः सुखमतापकरम् । निरकासयद्रविमपेतवसुं वियदालयादपरदिग्गणिका ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20006502,
    "chapter_id": 6639,
    "verse_number": "9.11",
    "content_sanskrit": "अभितिग्मरश्मि चिरमविरमादवधानखिन्नमनिमेषतया । विगलन्नमधुव्रतकुलाश्रुजलं न्ममीलदब्जनयनं नलिनी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20006503,
    "chapter_id": 6639,
    "verse_number": "9.12",
    "content_sanskrit": "अविभाव्यतारकमदृष्टहिमद्युतिबिम्बमस्तमितभानु नभः । अवसन्नतापमतमिस्रमभादपदोषतैव विगुणस्य गुणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20006504,
    "chapter_id": 6639,
    "verse_number": "9.13",
    "content_sanskrit": "रुचिधाम्नि भर्तरि भृशं विमलाः परलोकमभ्युपगते विवशुः । ज्वलनं त्विषः कथमितरथा सुलभोऽन्यजन्मनि स एव पतिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20006505,
    "chapter_id": 6639,
    "verse_number": "9.14",
    "content_sanskrit": "विहिताञ्जलिर्जनतया दधती विकसत्कुसुम्भकुसुमारुणताम् । चिरमुज्झितापि तनुरौज्झदसौ न पितृप्रसूः प्रकृतिमात्मभुवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20006506,
    "chapter_id": 6639,
    "verse_number": "9.15",
    "content_sanskrit": "अथ सान्द्रसान्ध्यकिरणारुणितं हरिहेतिहूति मिथुनं पततोः । पृथगुत्पपात विरहार्तिदलद्धृदयस्रुतासृगनुलिप्तमिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20006507,
    "chapter_id": 6639,
    "verse_number": "9.16",
    "content_sanskrit": "निलयः श्रियः सततमेतदिति प्रथितं यदेव जलजन्म तया । दिवसात्ययात्तदपि मुक्तमहो चपलाजनं प्रति न चोद्यमदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20006508,
    "chapter_id": 6639,
    "verse_number": "9.17",
    "content_sanskrit": "दिवसोऽनुमित्रमगमद्वलयं किमिहास्यते बत मयाबलया । रुचिभर्तुरस्य विरहाधिगमादिति संध्ययापि सपदि व्यगमि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20006509,
    "chapter_id": 6639,
    "verse_number": "9.18",
    "content_sanskrit": "पतिते पतङ्गमृगराजि निजप्रतिबिम्बरोषित इवाम्बुनिधौ । अथ नागयूथमलिनानि जगत्परितस्तमांसि परितस्तरिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20006510,
    "chapter_id": 6639,
    "verse_number": "9.19",
    "content_sanskrit": "व्यसरन्नु भूधरगुहान्तरतः पचलं बहिर्भहलपङ्करुचि । दिवसावसानपटुनस्तमसो बहिरेत्य चाधिकमभक्त गुहाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20006511,
    "chapter_id": 6639,
    "verse_number": "9.20",
    "content_sanskrit": "किमलम्बताम्बरविलग्नमधः किमवर्धतोर्ध्वमवनीतलतः । विससार तिर्यगथ दिग्भ्य इति प्रचुरीभवन्न निरधारि तमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20006512,
    "chapter_id": 6639,
    "verse_number": "9.21",
    "content_sanskrit": "स्थगिताम्बरक्षितितले परितस्तिमिरे जनस्य दृशमन्धयति । दधिरे रसाञ्जनमपूर्वतः प्रियवेश्मवर्त्म सुदृशो ददृशुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20006513,
    "chapter_id": 6639,
    "verse_number": "9.22",
    "content_sanskrit": "अवधार्य कार्यगुरुतामभवन्न भयाय सान्द्रतमसन्तमसम् । सुतनोः स्तनौ च दयितोपगमे तनुरोमराजिपथवेपथवे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20006514,
    "chapter_id": 6639,
    "verse_number": "9.23",
    "content_sanskrit": "ददृशेऽपि भास्कररुचाह्नि न यः स तमीं तमोबिरभिगम्य तताम् । द्युतिमग्रहीद्ग्रहगणो लघवः प्रकटीभवन्ति मलिनाश्रयतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20006515,
    "chapter_id": 6639,
    "verse_number": "9.24",
    "content_sanskrit": "अनुलेपनानि कुसुमान्यबलाः कृतमन्यवः पतिषु धीपशिखाः । समयेन तेन चिरसुप्तमनोभवबोधनं सममबोधिषत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20006516,
    "chapter_id": 6639,
    "verse_number": "9.25",
    "content_sanskrit": "वसुधान्तनिःसृतमिवाहिपतेः पटलं फणामणिसहस्ररुचाम् । स्फुरदंशुजालमथ शीतरुचः ककुभं समस्कुरुत माधवनीम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20006517,
    "chapter_id": 6639,
    "verse_number": "9.26",
    "content_sanskrit": "विशदप्रभापरिगतं विबभावुदयाचलव्यवहितेन्दुवपुः । मुखमप्रकाशदशनं शनकैः सविलासहासमिव शक्रदिशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20006518,
    "chapter_id": 6639,
    "verse_number": "9.27",
    "content_sanskrit": "कलया तुषारकिरणस्य पुरः परिमन्दभिन्नतिमिरौघजटम् । क्षणमभ्यपद्यत जनैर्न मृषा गगनं गणादिपतिमूर्तिरिति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20006519,
    "chapter_id": 6639,
    "verse_number": "9.28",
    "content_sanskrit": "नवचन्द्रकाकुसुमकीर्णतमःकबरीभृतो मलयजार्द्रमिव । ददृशे ललाटतटहारि हरेर्हरितो मुखे तुहिनरश्मिदलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20006520,
    "chapter_id": 6639,
    "verse_number": "9.29",
    "content_sanskrit": "प्रथमं कलाभवदथार्धमथो हिमदीधितिर्महदभूदुदितः । दधति ध्रुवं क्रमश एव न तु द्युतिशालिनोऽपि सहसोपचयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20006521,
    "chapter_id": 6639,
    "verse_number": "9.30",
    "content_sanskrit": "उदमज्जि कैटभजितः शयनादपनिद्रपाण्डुरसरोजरुचा । प्रथमप्रबुद्धनदराजसुतावदनेन्दुनेव तुहिनद्युतिना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20006522,
    "chapter_id": 6639,
    "verse_number": "9.31",
    "content_sanskrit": "अथ लक्षमणागतकान्तवपुर्जलधिं विलङ्घ्य शशिदाशरथिः । परिवारितः परित ऋक्षगणैस्तिरौघराक्षसकुलं बिभिदे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20006523,
    "chapter_id": 6639,
    "verse_number": "9.32",
    "content_sanskrit": "उपजीवति स्म सततं दधतः परिमुग्धतां वणिगिवोडुपतेः । घनवीथवीथिमवतीर्णवतो निधिरम्भसामुपचयाय कलाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20006524,
    "chapter_id": 6639,
    "verse_number": "9.33",
    "content_sanskrit": "रजनीमवाप्य रुचमाप शशी सपदि व्यभूषयदसावपि ताम् । अविलम्बितक्रममहो महतामितरेतरकृतिमच्चरितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20006525,
    "chapter_id": 6639,
    "verse_number": "9.34",
    "content_sanskrit": "दिवसं भृशोष्णरुचिपादहतां रुदतीमिवानवरतलिरुतैः । मुहुरामृशन्मृगधरोऽग्रकरैरुदशिस्वसत्कुमुदिनीवनिताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20006526,
    "chapter_id": 6639,
    "verse_number": "9.35",
    "content_sanskrit": "प्रतिकामिनीति ददृशुश्चकिताः स्मरजन्मघर्मपयसोपचिताम् । सुदृशोभिभर्तृशशैरश्मिगलज्जलबिन्दुमिन्दुमणिदारुवधूम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20006527,
    "chapter_id": 6639,
    "verse_number": "9.36",
    "content_sanskrit": "अमृतद्रवैर्विदधब्जदृशाममपमार्गमोषधिपतिः स्म करैः । परितो विसर्पि परितापि भृशं वपुषोऽवतारयति मानविषम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20006528,
    "chapter_id": 6639,
    "verse_number": "9.37",
    "content_sanskrit": "अमलात्मसु प्रतिफलन्नभितस्तरुणीकपोलफलकेषु मुहुः । विससार सान्द्रतरमिन्दुरुचामधिकावभासितदिशां निकरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20006529,
    "chapter_id": 6639,
    "verse_number": "9.38",
    "content_sanskrit": "उपगूढवेलमलघूर्मिभुजैः सरितामचुक्षुपदधीशमपि । रजनीकरः किमिव चित्रमदो यदुरागिणां गणमनङ्गलघुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20006530,
    "chapter_id": 6639,
    "verse_number": "9.39",
    "content_sanskrit": "भवनोदरेषु परिमन्दतया शयितोऽलसः स्फटिकयष्टिरुचः । अवलम्ब्य जालकमुखोपगतानुदतिष्ठदिन्दुकिरणान्मदनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20006531,
    "chapter_id": 6639,
    "verse_number": "9.40",
    "content_sanskrit": "अविभावितेषुविषयः प्रथमं मदनोऽपि नूनमभवत्तमसा । उदिते दिशः प्रकटयत्यमुना यदघर्मधाम्नि धनुराचकृषे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20006532,
    "chapter_id": 6639,
    "verse_number": "9.41",
    "content_sanskrit": "युगपद्विकासमुदयाद्गमिते शशिनः शिलीमुखगणोऽलभत । द्रुतमेत्य पुष्पधनुषो धनुषः कुमुदेऽङ्गनामनसि चावसरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20006533,
    "chapter_id": 6639,
    "verse_number": "9.42",
    "content_sanskrit": "ककुभां मुखानि सहसोज्ज्वलयन्दधदाकुलत्वमधिकं रतये । अदिदीपदिन्दुरपरो दहनः कुसुमेषुमत्रिनयनप्रभवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20006534,
    "chapter_id": 6639,
    "verse_number": "9.43",
    "content_sanskrit": "इति निश्चितप्रियतमागतयः सितदीधितावदयवत्यबलाः । प्रतिकर्म कर्तुमुचक्रमिरे समये हि सर्वमुपकारि कृतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20006535,
    "chapter_id": 6639,
    "verse_number": "9.44",
    "content_sanskrit": "सममेकमेव दधतुः सुतनोरु हारभूषणमुरोजतटौ । घटते हि संहततया जनितामिदमेव निर्विरतां दधतोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20006536,
    "chapter_id": 6639,
    "verse_number": "9.45",
    "content_sanskrit": "कदलीप्रकाण्डरुचिरोरुतरौ जघनस्थलीपरिसरे महति । रशनाकलापकगुणेन वधूर्मकरध्वजद्विरदमाकलयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20006537,
    "chapter_id": 6639,
    "verse_number": "9.46",
    "content_sanskrit": "अदरेष्वलक्तकरसः सुदृशां विशदं कपोलभुवि लोध्ररजः । नवमञ्जनं नयनपङ्कजयोर्बिभिदे न शङ्खनिहितात्पयसः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20006538,
    "chapter_id": 6639,
    "verse_number": "9.47",
    "content_sanskrit": "स्फुरदुज्वलाधरदलैर्विसद्दशनांशुकेशकरैः परितः । धृतमुग्धगण्डफलकैर्विबभुविकसद्भिरास्यकमलैः प्रमदाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20006539,
    "chapter_id": 6639,
    "verse_number": "9.48",
    "content_sanskrit": "भजते विदेशमधिकेन जितस्तदनुप्रवेशमथवा कुशलः । मुखमिन्दुरुज्ज्वलकपोलमतः प्रतिमाच्छलेन सुदृशामविशत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20006540,
    "chapter_id": 6639,
    "verse_number": "9.49",
    "content_sanskrit": "ध्रुवमागताः प्रतिहतिं कठिने मदनेषवः कुचतटेमहति । इतराङ्गवन्न यदिदं गरिमग्लपितावलग्नमगमत्तनुतां ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20006541,
    "chapter_id": 6639,
    "verse_number": "9.50",
    "content_sanskrit": "न मनोरमास्वपि विशेषविदां निरचेष्ट योग्यमिदमिति । गृहमेष्यति प्रियतमे सुदृशां वसनाङ्गरागसुमनःसु मनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20006542,
    "chapter_id": 6639,
    "verse_number": "9.51",
    "content_sanskrit": "वपुरन्वलिप्त परिरम्भसुखव्यवधानभीरुकतया न वधूः । क्षमस्य वाढमिदमेव हि यत्प्रियसंगमेष्वनवलेपमदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20006543,
    "chapter_id": 6639,
    "verse_number": "9.52",
    "content_sanskrit": "निजपाणिपल्लवतलस्खलनादभिनासिकविवरमुत्पतितैः । अपरा परीक्ष्य शनकैर्मुमुदे मुखवासमास्यकमलश्वसनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20006544,
    "chapter_id": 6639,
    "verse_number": "9.53",
    "content_sanskrit": "विधृते दिवा सवयसा च पुरः परिपूर्णमण्डलविकाशभृति । हिमधाम्नि दर्पणतले च मुहुः स्वमुखश्रियं मृगदृशो ददृशुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20006545,
    "chapter_id": 6639,
    "verse_number": "9.54",
    "content_sanskrit": "अधिजानु बाहुमुपधाय नमत्करपल्लवार्पितकपोलतलम् । उदकण्ठि कण्ठपरिवर्तिकलस्वरसून्यगानपयापरया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20006546,
    "chapter_id": 6639,
    "verse_number": "9.55",
    "content_sanskrit": "प्रणयप्रकाशनविदो मधुराः सुतरामभीष्टजनचित्तहृतः । प्रजिघाय कान्तमनु मुग्धतरस्तरुणीजनो दृश इवाथ सखीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20006547,
    "chapter_id": 6639,
    "verse_number": "9.56",
    "content_sanskrit": "न च मेऽवगच्छति यथा लघुतां करुणां यथा च कुरुते स मयि । निपुणं तथैनमुपगम्य वदेरभिदूति काचिदिति संदिदिशे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20006548,
    "chapter_id": 6639,
    "verse_number": "9.57",
    "content_sanskrit": "दयितया मानपरयापरया त्वरितं ययावगदितापि सखी । किमु चोदिताः प्रियहितार्थकृतः कृतिनो भवन्ति सुहृदः सुहृदाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20006549,
    "chapter_id": 6639,
    "verse_number": "9.58",
    "content_sanskrit": "प्रतिभिद्य कान्तमपराधकृतं यदि तावदस्य पुनरेव मया । क्रियतेऽनुवृत्तिरुचितैव ततः कलयेदमानमनसं सखि माम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20006550,
    "chapter_id": 6639,
    "verse_number": "9.59",
    "content_sanskrit": "अवधीर्य धैर्यकलिता दयितं विदधे विरोधमथ तेन सह । तव गोप्यते किमिव कर्तुमिदं न सहास्मि साहसमसाहसिकी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20006551,
    "chapter_id": 6639,
    "verse_number": "9.60",
    "content_sanskrit": "तदुपेत्य मा स्म तमुपालभथाः क्ल दोषमस्य न हि विद्म वयम् । इति सम्प्रधार्य रमणाय वधूर्विहितागसेऽपि विससर्ज सखीं ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20006552,
    "chapter_id": 6639,
    "verse_number": "9.61",
    "content_sanskrit": "ननु सन्दिशेति सुदृशोदितया त्रपया न किञ्चन किलाभिदधे । निजमैक्षि मन्दमनिशं निशितैः क्रशितं शरीरमशीरशरैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20006553,
    "chapter_id": 6639,
    "verse_number": "9.62",
    "content_sanskrit": "ब्रुवते स्म दूत्य उपसृत्य नरान्तरवत्प्रगल्भमतिगर्भगिरः । सुहृदर्थमीहितमजिह्मधियां प्रकृतेर्विराजति विरुद्धमपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20006554,
    "chapter_id": 6639,
    "verse_number": "9.63",
    "content_sanskrit": "मम रूपकीर्तिमहरद्भुवि यस्तदनु प्रविष्टहृदयेयमिति । त्वयि मत्सरादिव निरस्तदयः सुतरां क्षिणोति खलु तां मदनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20006555,
    "chapter_id": 6639,
    "verse_number": "9.64",
    "content_sanskrit": "तव सा कथासु परिघट्टयति श्रवणं यदङ्गुलिमुखेन मुहुः । घनतां ध्रुवं नयति तेन भवद्गुणपूगपूरितमतृप्ततया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20006556,
    "chapter_id": 6639,
    "verse_number": "9.65",
    "content_sanskrit": "उपतप्यमानमलघूष्णिभिः श्वसितैः सितेतरसरोजदृशः । द्रवतां न नेतुमधरं क्षमते नवनागवल्लिदलरागरसः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20006557,
    "chapter_id": 6639,
    "verse_number": "9.66",
    "content_sanskrit": "दधति स्फुटं रत्पतेरिषवः शिततां यदुत्पलपलाशदृशः । हृदयं निरन्तरबृहत्कठिनस्तनमणडलावरणमप्यभिदन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20006558,
    "chapter_id": 6639,
    "verse_number": "9.67",
    "content_sanskrit": "कुसुमादपि स्मितदृशः सुतरां सुकुमारमङ्गमिति नापरथा । अनिशं निजैरकरुणः करुणं कुसुमेषुरुत्तपति यद्विशिखैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20006559,
    "chapter_id": 6639,
    "verse_number": "9.68",
    "content_sanskrit": "विषतां निषेवितमपक्रियया समुपैति सर्वमिति सत्यमदः । अमृतुतस्रुऽपि विरहाद्भवतो यदमूं दहन्ति हिमरश्मिरुचः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20006560,
    "chapter_id": 6639,
    "verse_number": "9.69",
    "content_sanskrit": "उदितं प्रियां प्रति सहार्दमिति श्रदधीयत प्रियतमेन वचः । विदितेङ्गिते हि पुर एव जने सपदीरिताः खलु लगन्ति गिरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20006561,
    "chapter_id": 6639,
    "verse_number": "9.70",
    "content_sanskrit": "दयिताहृतस्य युवभिर्मनसः परिमूढतामिव गतैः प्रथमम् । उदिते ततः सपदि लब्धपदैः क्षणदाकरेऽनुपदिभिः प्रयये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20006562,
    "chapter_id": 6639,
    "verse_number": "9.71",
    "content_sanskrit": "निपपात सम्भ्रमभृतः श्रवणादसितभ्रुवः प्रणदितासिकुलम् । दयितावलोकविकसन्नयनप्रसरप्रणुन्नमिव वारिरुहम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20006563,
    "chapter_id": 6639,
    "verse_number": "9.72",
    "content_sanskrit": "उपनेतुमुन्नतिमतेव दिवं कुचयोर्युगेन तरसा कलितां । रभसोत्थितामुपगतः सहसा परिरभ्य कञ्चन वधूमरुधत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20006564,
    "chapter_id": 6639,
    "verse_number": "9.73",
    "content_sanskrit": "अनुदेहमागतवतः प्रतिमां परिणायकस्य गुरुमुद्वहता । मुकुरेण वेपथुभृतोऽतिभरात्कथमप्यपाति न वधूकरतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20006565,
    "chapter_id": 6639,
    "verse_number": "9.74",
    "content_sanskrit": "अवनम्य वक्षसि निमग्नकुचद्वितयेन गाढमुपगूढवता । दयितेन तत्क्षणचलद्रशनाकलकिङ्किणीरवमुदासि वधूः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20006566,
    "chapter_id": 6639,
    "verse_number": "9.75",
    "content_sanskrit": "कररुद्धनीवि दयितोपगतौ गलितं त्वराविरहितासनया । क्षणदृष्टहाटकशिलासदृशस्फुरदूरुभित्ति वसनं ववसे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20006567,
    "chapter_id": 6639,
    "verse_number": "9.76",
    "content_sanskrit": "पिदधानमन्वगुपगम्य दृशौ ब्रुवते जनाय वद कोऽयमिति । अभिधातुमध्यवससौ न गिरा पुलकैः प्रियं नववधून्यगदत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20006568,
    "chapter_id": 6639,
    "verse_number": "9.77",
    "content_sanskrit": "उदितोरुसादमतिवेपथुमत्सुदृशोऽभिभर्तृ विधुरं त्रपया । वपुरादरातिशयशंसि पुनः प्रतिपत्तिमूढमपि वाढमभूत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20006569,
    "chapter_id": 6639,
    "verse_number": "9.78",
    "content_sanskrit": "पिमन्धराभिरलघूरुभरादधिवेश्म पत्युरुपचारविधौ । स्खलिताभिरप्यनुपदं प्रमदाः प्रणयातिभूमिमगमन्गतिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20006570,
    "chapter_id": 6639,
    "verse_number": "9.79",
    "content_sanskrit": "मधुरान्नतभ्रु ललितं च दृशोः सकरप्रयोगचतुरं च वचः । प्रकृति स्थमेव निपुणागमितं स्फुचनृत्तलीलमभवत्सुतनोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20006571,
    "chapter_id": 6639,
    "verse_number": "9.80",
    "content_sanskrit": "तदयुक्तमङ्ग तव विश्वसृजा न कृतं यदीक्षणसहस्रतयम् । प्रकटीकृता जगति येन खलु स्फुटमिन्द्रताद्य मयि गोत्रभिदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20006572,
    "chapter_id": 6639,
    "verse_number": "9.81",
    "content_sanskrit": "न विभावयत्यनिशमक्षिगतामपि मां भवानतिसमीपतया । हृदयस्थितामपि पुनः परितः कथमीक्षते बहिरभीष्टतामाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20006573,
    "chapter_id": 6639,
    "verse_number": "9.82",
    "content_sanskrit": "इति गन्तुमिच्छुमभिधाय पुरः क्षणदृष्टिपातविकसद्वदनाम् । स्वकरावलम्बनविमुक्तगलत्कलकाञञ्चि काञ्चिदरुणत्तरुणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20006574,
    "chapter_id": 6639,
    "verse_number": "9.83",
    "content_sanskrit": "अपयाति सरोषया निरस्ते कृतकं कामिनि चुक्षुषे मृगाक्ष्या । कलयन्नपि सव्यथोऽवतस्थेऽशकुनेन स्खलितः किलेतरोऽपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20006575,
    "chapter_id": 6639,
    "verse_number": "9.84",
    "content_sanskrit": "आलोक्य प्रियतममंशुके विनीवौ यत्तस्थे नमितमुखेन्दु मानवत्या । तन्नूनं पदमवलोकयांबभूवे मानस्य द्रुतमपयानमास्थितस्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20006576,
    "chapter_id": 6639,
    "verse_number": "9.85",
    "content_sanskrit": "सुदृशः सरसव्यलीक तप्तस्तरसास्लष्टवतः सयौवनोष्मा । कथमप्यभवत्स्मरानलोष्मणः स्तनभारो न नखंपचः प्रियस्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20006577,
    "chapter_id": 6639,
    "verse_number": "9.86",
    "content_sanskrit": "दधत्युरोजद्वयमुर्वशीतलं भुवो गतेव स्वयमुर्वशी तलम् । बभौ मुखेनाप्रतिमेन काचन श्रियाधिका तां प्रति मेनका च न ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20006578,
    "chapter_id": 6639,
    "verse_number": "9.87",
    "content_sanskrit": "इत्थं नारीर्घटयितुमलं कामिभिः काममासन्प्रालेयांशोः सपदि रुचयः शान्तमानान्तरायाः । आचार्यत्वं रतिषु विलसन्मन्मथश्रीविलासा ह्रीप्रत्यूहप्रशमकुशलाः शीधवश्चक्रुरासाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  }
]