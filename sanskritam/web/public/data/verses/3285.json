[{"id": 2105758, "chapter_id": 3285, "verse_number": "१६-१४-१", "content_sanskrit": "वैशम्पायन उवाच।\nएवमुक्तस्तु राज्ञा स विदुरो बुद्धिसत्तमः।\nधृतराष्ट्रमुपेत्यैव वाक्यमाह महार्थवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105759, "chapter_id": 3285, "verse_number": "१६-१४-२", "content_sanskrit": "उक्तो युधिष्ठिरो राजा भवद्वचनमादितः।\nस च संश्रुत्य वाक्यं ते प्रशशंस महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105760, "chapter_id": 3285, "verse_number": "१६-१४-३", "content_sanskrit": "बीभत्सुश्च महातेजा निवेदयति ते गृहान्।\nवसु तस्य गृहे यच्च प्राणानपि च केवलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105761, "chapter_id": 3285, "verse_number": "१६-१४-४", "content_sanskrit": "धर्मराजश्च पुत्रस्ते राज्यं प्राणान्धनानि च।\nअनुजानाति राजर्षे यच्चान्यदपि किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105762, "chapter_id": 3285, "verse_number": "१६-१४-५", "content_sanskrit": "भीमस्तु सर्वदुःखानि संस्मृत्य बहुलान्युत।\nकृच्छ्रादिव महाबाहुरनुजज्ञे विनिःश्वसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105763, "chapter_id": 3285, "verse_number": "१६-१४-६", "content_sanskrit": "र राजन्धर्मशीलेन राज्ञा बीभत्सुना तथा।\nअनुनीतो महाबाहुः सौहृदे स्थापितोपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105764, "chapter_id": 3285, "verse_number": "१६-१४-७", "content_sanskrit": "न च मन्युस्त्वया कार्य इति त्वां प्राह धर्मराट्।\nसंस्मृत्य भीमस्तद्वैरं यदन्यायवदाचरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105765, "chapter_id": 3285, "verse_number": "१६-१४-८", "content_sanskrit": "एवंप्रायो हि धर्मोऽयं क्षत्रियाणां नराधिप।\nशुद्धे क्षत्रियधर्मे न निरतोऽयं वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105766, "chapter_id": 3285, "verse_number": "१६-१४-९", "content_sanskrit": "वृकोदरकृते चाहमर्जुनश्च पुनः पुनः।\nप्रसीद याचे नृपते भवान्प्रभुरिहास्ति यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105767, "chapter_id": 3285, "verse_number": "१६-१४-१०", "content_sanskrit": "तद्ददातु भवान्वित्तं यावदिच्छसि पार्थिवः।\nत्वमीश्वरो नो राज्यस्य प्राणानामपि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105768, "chapter_id": 3285, "verse_number": "१६-१४-११", "content_sanskrit": "ब्रह्मदेयाग्रहारांश्च पुत्राणामौर्ध्वदेहिकम्।\nइतो रत्नानि गाश्चैव दासीदासमजाविकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105769, "chapter_id": 3285, "verse_number": "१६-१४-१२", "content_sanskrit": "अर्चयित्वा कुरुश्रेष्ठो ब्राह्मणेभ्यः प्रयच्छतु।\nदीनान्धकृपणेभ्यश्च तत्रतत्र नृपाज्ञया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105770, "chapter_id": 3285, "verse_number": "१६-१४-१३", "content_sanskrit": "बह्वन्नरसपानाढ्याः सभा विदुर कारय।\nगवां निपानान्यन्यच्च विविधं पुण्यकं कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105771, "chapter_id": 3285, "verse_number": "१६-१४-१४", "content_sanskrit": "इति मामब्रवीद्राजा पार्थश्चैव धनंजयः।\nयदत्रानन्तरं कार्यं तद्भवम्ववक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105772, "chapter_id": 3285, "verse_number": "१६-१४-१५", "content_sanskrit": "इत्युक्ते विदुरेणाथ धृतराष्ट्रोऽभिनन्द्य तान्।\nमनश्चक्रे महादाने कार्तिक्यां जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105773, "chapter_id": 3285, "verse_number": "", "content_sanskrit": "॥ इती श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि चतुर्दशोऽध्यायः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]