[{"id": 7003095000, "chapter_id": 23095, "verse_number": "४-३१-१", "content_sanskrit": "श्रीराधिकोवाच ।\nकिमाश्चर्यं श्रुतं नाथ चरितं सुमनोहरम् ।\nअधुना श्रोतुमिच्छामि ब्रह्मणः शापकारणम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003095001, "chapter_id": 23095, "verse_number": "४-३१-२", "content_sanskrit": "यो विधाता त्रिजगतां तपसां फलदायकः ।\nस कथं कुलटाशापादपूज्यश्च बभूव ह ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003095002, "chapter_id": 23095, "verse_number": "४-३१-३", "content_sanskrit": "श्रीकृष्ण उवाच ।\nमन्वन्तरे रैवतस्य सुचन्द्रो नृपपुंगव ।\nतपस्वी वैष्णवः श्रेष्ठो ज्ञानी परमधार्मिकः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003095003, "chapter_id": 23095, "verse_number": "४-३१-४", "content_sanskrit": "स च पूर्वं तपः कुर्वन्नाजगाम मम प्रिये ।\nइमां च मलयद्रोणीं भारतेषु मनोहराम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003095004, "chapter_id": 23095, "verse_number": "४-३१-५", "content_sanskrit": "तपश्चकार राजेन्द्रो वर्षाणां च सहस्रकम् ।\nजीर्णं तस्य शरीरं च कठोरेण तपस्विनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003095005, "chapter_id": 23095, "verse_number": "४-३१-६", "content_sanskrit": "वल्मीकाच्छादितं देहं दृष्ट्वा धाता कृपानिधिः ।\nआजगाम वरं दातुं तपःस्थानं सुनिर्जनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003095006, "chapter_id": 23095, "verse_number": "४-३१-७", "content_sanskrit": "कमण्डलुजलेनैव मम देहोद्भवेन च। ।\nसिषेच तं च मन्त्रेण मया दत्तेन योगवित् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003095007, "chapter_id": 23095, "verse_number": "४-३१-८", "content_sanskrit": "कमण्डलुजलस्पर्शादुत्थाय नृपतिः स्वयम् ।\nननाम भक्त्या जगतां स्रष्टारं च पुरः स्थितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003095008, "chapter_id": 23095, "verse_number": "४-३१-९", "content_sanskrit": "स तं नमन्तं राजानमुवाच कमलोद्भवः ।\nवरं वृण्विति राजेन्द्र यत्ते मनसि वाञ्छितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003095009, "chapter_id": 23095, "verse_number": "४-३१-१०", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा वरं वव्रे परात्परम् ।\nममैव चरणे भक्तिं मदीयं दास्यमेव च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003095010, "chapter_id": 23095, "verse_number": "४-३१-११", "content_sanskrit": "कृपया च वरं ब्रह्मा दत्तवानभिवाञ्छितम् ।\nस च तत्पुरतस्तस्थौ कामदेवसमप्रभः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003095011, "chapter_id": 23095, "verse_number": "४-३१-१२", "content_sanskrit": "एतस्मिन्नन्तरे राजा ददर्श रथमुत्तमम् ।\nआकाशान्निपतन्तं वै शतसूर्यसमप्रभम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003095012, "chapter_id": 23095, "verse_number": "४-३१-१३", "content_sanskrit": "तेजसाऽऽच्छादितं सर्वं सुप्रदीप्तं दिशो दश ।\nरत्नेन्द्रसारनिर्माणं शतचक्रसमन्वितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003095013, "chapter_id": 23095, "verse_number": "४-३१-१४", "content_sanskrit": "अमूल्यरत्नरचितं विचित्रकलशोज्ज्वलम् ।\nमुक्तामाणिक्यहीराणां मालाजालैश्च राजितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003095014, "chapter_id": 23095, "verse_number": "४-३१-१५", "content_sanskrit": "सद्रत्नदर्पणैर्दीप्तैरतीव सुमनोहरम् ।\nभूषितं दिव्यवस्त्रैश्च श्वेतचामरकोटिभिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003095015, "chapter_id": 23095, "verse_number": "४-३१-१६", "content_sanskrit": "पारिजातप्रसूनानां मालाजालैः सुशोभितम् ।\nमनोयायि महाश्चर्यं नानाचित्रेण चित्रितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003095016, "chapter_id": 23095, "verse_number": "४-३१-१७", "content_sanskrit": "वेष्टितं पार्षदैर्दिव्यै रत्नभूषणभूषितैः। ।\nचतुर्भुजैः श्यामलैश्च ज्वलद्भिः स्थिरयौवनैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003095017, "chapter_id": 23095, "verse_number": "४-३१-१८", "content_sanskrit": "पीतवस्त्रपरीधानैश्चन्दनागुरुचर्चितैः ।\nदृष्ट्वा रथस्थान्देवांश्च ननाम नृपतिर्मुदा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003095018, "chapter_id": 23095, "verse_number": "४-३१-१९", "content_sanskrit": "सहसा तस्य शिरसि पुष्पवृष्टिर्बभूव ह ।\nनेदुर्दुन्दुभयः स्वर्गे चानकाश्च मनोहराः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003095019, "chapter_id": 23095, "verse_number": "४-३१-२०", "content_sanskrit": "ऋषयो मुनयः सिद्धाः प्रकुर्वन्तो मुदाऽऽशिषम् ।\nप्रशशंसुः सुराः सर्वे राजानं हर्षनिर्भराः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003095020, "chapter_id": 23095, "verse_number": "४-३१-२१", "content_sanskrit": "राजा च पार्षदान्ध्यात्वा तद्रूपश्च बभूव ह ।\nपार्षदास्तं रथे कृत्वा नीत्वा जग्मुर्ममालयम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003095021, "chapter_id": 23095, "verse_number": "४-३१-२२", "content_sanskrit": "मदीयः पार्षदो भूत्वा स च तस्थौ ममान्तिके ।\nततः स्वमन्दिरं यान्तं ददर्श मोहिनी विधिम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003095022, "chapter_id": 23095, "verse_number": "४-३१-२३", "content_sanskrit": "पुष्पोद्याने च रम्ये च पुष्पचन्दनवायुना। ।\nसद्यो मुमोह तं दृष्ट्वा प्रदग्धा मदानानलैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003095023, "chapter_id": 23095, "verse_number": "४-३१-२४", "content_sanskrit": "विलोक्य  वक्रनयना जुगोप सस्मितं मुखम्।\nसिन्दूरबिन्दुं दधती कस्तूरीबिन्दुना सह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003095024, "chapter_id": 23095, "verse_number": "४-३१-२५", "content_sanskrit": "चारुचम्पकवर्णाभा सततं स्थिरयौवना। ।\nबृहन्नितम्बयुगला पीनश्रोणिपयोधरा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003095025, "chapter_id": 23095, "verse_number": "४-३१-२६", "content_sanskrit": "शरत्पार्वणशुभ्रांशुप्रभामुष्टकरानना ।\nसूक्ष्मवस्त्रपरीधाना रत्नालंकारभूषिता ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003095026, "chapter_id": 23095, "verse_number": "४-३१-२७", "content_sanskrit": "त्रैलोक्यं मोहितुं शक्ता कटाक्षैरेव लीलया ।\nअतीव कामिनी शश्वद्गजेन्द्रमन्दगामिनी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003095027, "chapter_id": 23095, "verse_number": "४-३१-२८", "content_sanskrit": "पुलकाञ्चितसर्वाङ्गी मूर्च्छां संप्राप वर्त्मनि ।\nसन्निरीक्ष्य च तां ब्रह्मा जगाम श्रीहरिं स्मरन् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003095028, "chapter_id": 23095, "verse_number": "४-३१-२९", "content_sanskrit": "स विकारं न हि प्राप ह्यात्मारामो जितेंद्रियः ।\nब्रह्मलोकं च संप्राप ब्रह्मा च जगतां पतिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003095029, "chapter_id": 23095, "verse_number": "४-३१-३०", "content_sanskrit": "सकामा सा च कुलटा बभूव हतचेतना ।\nदिवानिशं चिन्तयन्ती स्वप्ने ज्ञाने चतुर्मुखम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003095030, "chapter_id": 23095, "verse_number": "४-३१-३१", "content_sanskrit": "सर्वं जारं विसस्मार तत्याज हरिमीश्वरी ।\nउत्तिष्ठन्ती निवसती शयनं कुर्वती क्षणम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003095031, "chapter_id": 23095, "verse_number": "४-३१-३२", "content_sanskrit": "तप्तपात्रे यथा सस्यं भ्रमत्येव तथा पथि ।\nएतस्मिन्नन्तरे रम्भा विदग्धाऽप्सरसां वरा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003095032, "chapter_id": 23095, "verse_number": "४-३१-३३", "content_sanskrit": "गच्छन्ती कामलोकं सा सकामा तेन वर्त्मना ।\nदृष्ट्वा सहचरीं तत्र शुष्ककण्ठोष्ठतालुकाम् ।\nअभिप्रायेण बुबुधे पप्रच्छ सस्मिता तदा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003095033, "chapter_id": 23095, "verse_number": "४-३१-३४", "content_sanskrit": "रम्भोवाच ।\nकथमेवंविधा त्वं हि त्रैलोक्यचित्तमोहिनि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003095034, "chapter_id": 23095, "verse_number": "४-३१-३५", "content_sanskrit": "वद शीघ्रं महाभागे रम्भाऽहं चेतनं कुरु ।\nकमुद्दिश्य सकामा त्वं गच्छ त्वं कान्तमीप्सितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003095035, "chapter_id": 23095, "verse_number": "४-३१-३६", "content_sanskrit": "कुलटा सर्वसौभाग्या न वयं कुलपालिकाः ।\nसर्वे व्यग्रा इन्द्रियाणां सुखाय भुवनत्रये ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003095036, "chapter_id": 23095, "verse_number": "४-३१-३७", "content_sanskrit": "यान्ति प्राणा यतः काले का लज्जा तत्र जीविनाम् ।\nन चात्मनः परः कश्चित्प्रियोऽस्ति भुवनत्रये ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003095037, "chapter_id": 23095, "verse_number": "४-३१-३८", "content_sanskrit": "कान्तेऽपत्ये स्वबन्धौ च स्नेहो यः स्वात्महेतुकः ।\nसम्बन्धः स्वात्मनो यावत्तावत्स्नेहोऽस्ति तत्र वै ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003095038, "chapter_id": 23095, "verse_number": "४-३१-३९", "content_sanskrit": "येषु यन्मानसं शश्वत्तेषां प्राणास्त एव हि ।\nगच्छन्तीं कामलोकं च सकामां पश्य मां प्रिये ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003095039, "chapter_id": 23095, "verse_number": "४-३१-४०", "content_sanskrit": "सह सख्या समालोक्य मनसा गच्छ तं प्रियम् ।\nनिबद्ध्य नीवी केशांश्च कृत्वा वेषमभीप्सितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003095040, "chapter_id": 23095, "verse_number": "४-३१-४१", "content_sanskrit": "मुनिमोहनबीजं च तं मोहं कुरु मोहिनि ।\nकथयस्व महाभागे वचनं हृदयंगमम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003095041, "chapter_id": 23095, "verse_number": "४-३१-४२", "content_sanskrit": "रक्षात्मानं प्रभावं च स्त्रीजातीनां जगत्त्रये ।\nस्वाभिप्रायश्च सुरतौ न प्रकाश्यः कदाचन ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003095042, "chapter_id": 23095, "verse_number": "४-३१-४३", "content_sanskrit": "स्वान्तं कान्तं स्वानुरक्तमृज्वीं सहचरीं विना ।\nतस्माद्यत्नेन हृद्वाक्यं प्रकाश्यं च प्रिये प्रिये ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003095043, "chapter_id": 23095, "verse_number": "४-३१-४४", "content_sanskrit": "अन्यथा चोपहासाय मरणायैव कल्पते ।\nतस्याश्च वचनं श्रुत्वा सस्मिता सा सुलज्जिता ।\nहृद्यं च कथयामास यद्धेतोस्तादृशी गतिः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003095044, "chapter_id": 23095, "verse_number": "४-३१-४५", "content_sanskrit": "मोहिन्युवाच ।\nयावद्दृष्टो मया रम्भे निर्जने चतुराननः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003095045, "chapter_id": 23095, "verse_number": "४-३१-४६", "content_sanskrit": "तावन्मनो मेऽतिदग्धं शश्वन्मनसिजानलैः ।\nन दत्तमात्मने भक्ष्यमन्तरे न हि रोचते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003095046, "chapter_id": 23095, "verse_number": "४-३१-४७", "content_sanskrit": "जानामि नाहमुदयं यामिनीशदिनेशयोः ।\nअधुना नहि भेदो मे सततं स्वप्नज्ञानयोः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003095047, "chapter_id": 23095, "verse_number": "४-३१-४८", "content_sanskrit": "मम प्राणाः प्रतीक्षन्ते तस्यालिङ्गनमेव च ।\nक्षणं विज्ञाय न चिरं यास्यन्ति नान्यथा प्रिये ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003095048, "chapter_id": 23095, "verse_number": "४-३१-४९", "content_sanskrit": "कामज्वालाकलापैश्च स्वर्णाकारं कलेवरम् ।\nअनाहारेण चेदानीं बभूव दग्धशैलवत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003095049, "chapter_id": 23095, "verse_number": "४-३१-५०", "content_sanskrit": "गन्तुं स्थातुं न शक्ताऽहं शयनं कर्तुमुद्यता। ।\nधिगस्तु पुंश्चलीजातिं मामेव च विशेषतः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003095050, "chapter_id": 23095, "verse_number": "४-३१-५१", "content_sanskrit": "कमुपायं करिष्यामि वद रम्भेऽतिसाम्प्रतम् ।\nलज्जां वाऽपि शरीरं वा विसृजामि च किं द्वयोः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003095051, "chapter_id": 23095, "verse_number": "४-३१-५२", "content_sanskrit": "मोहिनीवचनं श्रुत्वा प्रहस्याप्सरसां वरा ।\nतामुवाच हितं नीतमुपायं शुभकारणम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003095052, "chapter_id": 23095, "verse_number": "४-३१-५३", "content_sanskrit": "रम्भोवाच ।\nएवमेतदहो भद्रे भद्रस्य कारणं तव ।\nसर्वं त्वपनयिष्यामि शृणूपायं भयं त्यज ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003095053, "chapter_id": 23095, "verse_number": "४-३१-५४", "content_sanskrit": "कृत्वा वेषमपूर्वं च पूर्वमाराध्य मन्मथम् ।\nतेन सार्द्धं स्वयं गत्वा मोहं कुरु च भामिनि॥ ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003095054, "chapter_id": 23095, "verse_number": "४-३१-५५", "content_sanskrit": "जितेन्द्रियाणां प्रवरं साक्षान्नारायणात्मकम् ।\nविना कामसहायेन का शक्ता जेतुमीश्वरम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003095055, "chapter_id": 23095, "verse_number": "४-३१-५६", "content_sanskrit": "भज कामं तपः कृत्वा पुष्करे व्रज मोहिनि ।\nसद्यः साक्षात्स भविता दयालुर्योषितां प्रभुः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003095056, "chapter_id": 23095, "verse_number": "४-३१-५७", "content_sanskrit": "इत्युक्त्वा तामप्सरसां प्रवरा काममन्तिकम् ।\nजगामेन्द्रियशान्त्यर्थं सा जगाम च पुष्करम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003095057, "chapter_id": 23095, "verse_number": "४-३१-५८", "content_sanskrit": "पुष्करे च तपः कृत्वा कामं संप्राप्य मोहिनी ।\nजगाम तेन सार्द्धं च ब्रह्मलोकमनामयम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003095058, "chapter_id": 23095, "verse_number": "४-३१-५९", "content_sanskrit": "ददर्श निर्जनस्थं च मोहिनी कमलोद्भवम् ।\nतमेव मोहनं कर्तुं समारेभे पुरः स्थिता ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003095059, "chapter_id": 23095, "verse_number": "४-३१-६०", "content_sanskrit": "क्षणं ननर्त सुचिरं सुगानेन क्षणं जगौ ।\nसंगीतं मम संबन्धि भक्तानां चित्तमोहनम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003095060, "chapter_id": 23095, "verse_number": "४-३१-६१", "content_sanskrit": "विधाता जगतां तस्याः श्रुत्वा संगीतमीप्सितम् ।\nपुलकाञ्चितसर्वाङ्गो मुमोह साश्रुलोचनः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003095061, "chapter_id": 23095, "verse_number": "४-३१-६२", "content_sanskrit": "दृष्ट्वा मुग्धं चतुर्वक्त्रं मोहिनी हृष्टमानसा ।\nकलाप्रमाणं भावं च चकार तत्र लीलया ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003095062, "chapter_id": 23095, "verse_number": "४-३१-६३", "content_sanskrit": "स्वाङ्गं संदर्शयामास स्मेरभ्रूभङ्गपूर्वकम् ।\nका लज्जा तस्य संसारे यः कामहतचेतनः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003095063, "chapter_id": 23095, "verse_number": "४-३१-६४", "content_sanskrit": "विज्ञाय ब्रह्मा तद्भावं नतवक्त्रो बभूव ह ।\nप्रदाय तस्या दानं च विरतः श्रीहरिं स्मरन् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003095064, "chapter_id": 23095, "verse_number": "४-३१-६५", "content_sanskrit": "विज्ञाय ब्रह्मणो भावं शुष्ककण्ठोष्ठतालुका ।\nहतोद्यमा सा तुष्टाव कामं कामप्रदं वरम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003095065, "chapter_id": 23095, "verse_number": "४-३१-६६", "content_sanskrit": "मोहिन्युवाच ।\nसर्वेन्द्रियाणां प्रवरं विष्णोरंशं च मानसम् ।\nतदेव कर्मणां बीजं तदुद्भव नमोऽस्तु ते ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003095066, "chapter_id": 23095, "verse_number": "४-३१-६७", "content_sanskrit": "स्वयमात्मा हि भगवाञ्ज्ञानरूपो महेश्वरः ।\nनमो ब्रह्मञ्जगत्स्रष्टस्तदुद्भव नमोऽस्तु ते ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003095067, "chapter_id": 23095, "verse_number": "४-३१-६८", "content_sanskrit": "सृष्टिः सर्वशरीरेषु दृष्टिश्च योगिनामपि ।\nजगत्साध्य दुराराध्य दुर्निवार नमोऽस्तु ते ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003095068, "chapter_id": 23095, "verse_number": "४-३१-६९", "content_sanskrit": "सर्वाजित जगज्जेतर्जीव जीवमनोहर। ।\nरतिबीज रतिस्वामिन्रतिप्रिय नमोऽस्तु ते ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003095069, "chapter_id": 23095, "verse_number": "४-३१-७०", "content_sanskrit": "शश्वद्योषिदधिष्ठान योषित्प्राणाधिकप्रिय ।\nयोषिद्वाहन योषास्त्र योषिद्बन्धो नमोऽस्तु ते ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003095070, "chapter_id": 23095, "verse_number": "४-३१-७१", "content_sanskrit": "पतिसाध्यकराशेषरूपाधार गुणाश्रय ।\nसुगन्धिवातसचिव मधुमित्र नमोऽस्तु ते ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003095071, "chapter_id": 23095, "verse_number": "४-३१-७२", "content_sanskrit": "शश्वद्योनिकृताधार स्त्रीसंदर्शनवर्धन ।\nविदग्धानां विरहिणां प्राणान्तक नमोऽस्तु ते ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003095072, "chapter_id": 23095, "verse_number": "४-३१-७३", "content_sanskrit": "अकृपा येषु तेऽनर्थास्तेषां ज्ञानविनाशनम् ।\nअनूहरूपभक्तेषु कृपासिन्धो नमोऽस्तु ते ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003095073, "chapter_id": 23095, "verse_number": "४-३१-७४", "content_sanskrit": "तपस्विनां च तपसां विघ्नबीजावलीलया ।\nमनः सकामं मुक्तानां कर्तुं शक्त नमोऽस्तु ते ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003095074, "chapter_id": 23095, "verse_number": "४-३१-७५", "content_sanskrit": "तपःसाध्याश्चाराध्याश्च सदैवं पाञ्चभौतिकाः ।\nपञ्चेन्द्रियकृताधार पञ्चबाण नमोऽस्तु ते ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003095075, "chapter_id": 23095, "verse_number": "४-३१-७६", "content_sanskrit": "मोहिनीत्येवमुक्त्वा तु मनसा सा विधेः पुरः ।\nविरराम नम्रवक्त्रा बभूव ध्यानतत्परा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003095076, "chapter_id": 23095, "verse_number": "४-३१-७७", "content_sanskrit": "उक्तं माध्यंदिने कान्ते स्तोत्रमेतन्मनोहरम् ।\nपुरा दुर्वाससा दत्तं मोहिन्यै गन्धमादने ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003095077, "chapter_id": 23095, "verse_number": "४-३१-७८", "content_sanskrit": "स्तोत्रमेतन्महापुण्यं कामी भक्त्या यदा पठेत् ।\nअभीष्टं लभते नूनं निष्कलङ्को भवेद् ध्रुवम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003095078, "chapter_id": 23095, "verse_number": "४-३१-७९", "content_sanskrit": "चेष्टां न कुरुते कामः कदाचिदपि तं प्रियम् ।\nभवेदरोगी श्रीयुक्तः कामदेवसमप्रभः ।\nवनितां लभते साध्वीं पत्नीं त्रैलोक्यमोहिनीम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]