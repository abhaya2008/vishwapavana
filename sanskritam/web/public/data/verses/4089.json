[{"id": 2143260, "chapter_id": 4089, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2143261, "chapter_id": 4089, "verse_number": "१", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा प्रज्ञावृद्धो महाद्युतिः ।\nसम्पूज्यैनं यथाकालं भीष्मो वचनमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2143262, "chapter_id": 4089, "verse_number": "२", "content_sanskrit": "दिष्ट्या कुशलिनः सर्वे सह दामोदरेण ते ।\nदिष्ट्या सहायवन्तश्च दिष्ट्या धर्मे च ते रताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2143263, "chapter_id": 4089, "verse_number": "३", "content_sanskrit": "दिष्ट्या च सन्धिकामास्ते भ्रातरः कुरुनन्दनाः ।\nदिष्ट्या न युद्धमनसः पाण्डवाः सह बान्धवैः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2143264, "chapter_id": 4089, "verse_number": "४", "content_sanskrit": "भवता सत्यमुक्तं तु सर्वमेतन्न संशयः ।\nअतितीक्ष्णं तु ते वाक्यं ब्राह्मण्यादिति मे मतिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2143265, "chapter_id": 4089, "verse_number": "५", "content_sanskrit": "असंशयं क्लेशितास्ते वने चैवं च पाण्डवाः ।\nप्राप्ताश्च धर्मतः सर्वं पितुर्धनमसंशयम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2143266, "chapter_id": 4089, "verse_number": "६", "content_sanskrit": "किरीटी बलवान् शूरः कृतास्त्रश्च महाद्युतिः ।\nको हि पाण्डुसुतं युद्धे विषहेत धनञ्जयम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2143267, "chapter_id": 4089, "verse_number": "७", "content_sanskrit": "अपि वज्रधरः साक्षात् किमुतान्ये धनुर्भृतः ।\nत्रयाणामपि लोकानां समर्थ इति मे मतिः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2143268, "chapter_id": 4089, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2143269, "chapter_id": 4089, "verse_number": "८", "content_sanskrit": "भीष्मे ब्रुवति तद् वाक्यं धृष्टमाक्षिप्य मन्युना ।\nदुर्योधनं समालोक्य कर्णो वचनमब्रवीत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2143270, "chapter_id": 4089, "verse_number": "९", "content_sanskrit": "न तन्न विदितं ब्रह्मन् लोके भूतेन केनचित् ।\nपुनरुक्तेन किं तेन भाषितेन पुनः पुनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2143271, "chapter_id": 4089, "verse_number": "१०", "content_sanskrit": "दुर्योधनार्थे शकुनिः द्यूते निर्जितवान् पुरा ।\nसमयेन गतोऽरण्यं पाण्डुपुत्रो युधिष्ठिरः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2143272, "chapter_id": 4089, "verse_number": "११", "content_sanskrit": "स तं समयमुत्सृज्य राज्यमिच्छति पैतृकम् ।\nबलमाश्रित्य मत्स्यानां पाञ्चालानां युधिष्ठिरः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2143273, "chapter_id": 4089, "verse_number": "१२", "content_sanskrit": "दुर्योधनो भयाद् विद्वन् न दद्यात् पादमन्ततः ।\nधर्मतस्तु महीं कृत्स्नां प्रदद्याच्छत्रवेऽपि च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2143274, "chapter_id": 4089, "verse_number": "१३", "content_sanskrit": "यदि काङ्क्षन्ति ते राज्यं पितृपैतामहं पुनः ।\nयथाप्रतिज्ञं तं कालं चरन्तु वनमाश्रिताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2143275, "chapter_id": 4089, "verse_number": "१४", "content_sanskrit": "ततो दुर्योधनस्याङ्के वर्तन्तामकुतोभयाः ।\nअधार्मिकीं त्विमां बुद्धिं मौर्ख्यात् कुर्वन्ति केवलात्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2143276, "chapter_id": 4089, "verse_number": "१५", "content_sanskrit": "अथ ते धर्ममुत्सृज्य युद्धमिच्छन्ति पाण्डवाः ।\nआसाद्येमान् कुरुश्रेष्ठान् स्मरिष्यन्ति वचो मम\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2143277, "chapter_id": 4089, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2143278, "chapter_id": 4089, "verse_number": "१६", "content_sanskrit": "किं नु राधेय वाचा ते कर्म तत् स्मर्तुमर्हसि ।\nएक एव यदा पार्थः षड्रथान् जितवान् युधि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2143279, "chapter_id": 4089, "verse_number": "१७", "content_sanskrit": "विराटनगरे धीरः किं त्वं तत्रैव नागतः ।\nबहुशो जीयमानस्य कर्म दृष्टं तदैव ते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2143280, "chapter_id": 4089, "verse_number": "१८", "content_sanskrit": "न चेदिदं करिष्यामो यदयं ब्राह्मणोऽब्रवीत् ।\nध्रुवं युधि हतास्तेन भक्षयिष्याम पांसुकान्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2143281, "chapter_id": 4089, "verse_number": "१९", "content_sanskrit": "दुर्योधनः सहामात्यो विनङ्क्ष्यति न संशयः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2143282, "chapter_id": 4089, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2143283, "chapter_id": 4089, "verse_number": "२०", "content_sanskrit": "धृतराष्ट्रस्ततो भीष्ममनुमान्य प्रसाद्य च ।\nअवभर्त्स्य च राधेयमिदं वचनमब्रवीत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2143284, "chapter_id": 4089, "verse_number": "२१", "content_sanskrit": "अस्मद्धितमिदं वाक्यमुक्तवान् जाह्नवीसुतः ।\nपाण्डवानां हितं चैव सर्वस्य जगतस्तथा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2143285, "chapter_id": 4089, "verse_number": "२२", "content_sanskrit": "चिन्तयित्वा तु पार्थेभ्यः प्रेषयिष्यामि सञ्जयम् ।\nभगवान् प्रतियात्वद्य पाण्डवानेव मा चिरम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2143286, "chapter_id": 4089, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2143287, "chapter_id": 4089, "verse_number": "२३", "content_sanskrit": "स तं सत्कृत्य कौरव्यः प्रेषयामास पाण्डवान् ।\nसभामध्ये समाहूय सञ्जयं वाक्यमब्रवीत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2143288, "chapter_id": 4089, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकविंशोऽध्यायः ॥२१॥ सञ्जययानपर्वणि द्वितीयोऽध्यायः ॥१॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]