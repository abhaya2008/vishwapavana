[{"id": 5000358000, "chapter_id": 9358, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे एकोनविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000358001, "chapter_id": 9358, "verse_number": "५-१९-१", "content_sanskrit": "तस्मिन्नेव ततः काले राजपुत्री त्वनिन्दिता।\nरूपयौवनसम्पन्नं भूषणोत्तमभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000358002, "chapter_id": 9358, "verse_number": "५-१९-२", "content_sanskrit": "ततो दृष्ट्वैव वैदेही रावणं राक्षसाधिपम्।\nप्रावेपत वरारोहा प्रवाते कदली यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000358003, "chapter_id": 9358, "verse_number": "५-१९-३", "content_sanskrit": "ऊरुभ्यामुदरं छाद्य बाहुभ्यां च पयोधरौ।\nउपविष्टा विशालाक्षी रुदती वरवर्णिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000358004, "chapter_id": 9358, "verse_number": "५-१९-४", "content_sanskrit": "दशग्रीवस्तु वैदेहीं रक्षितां राक्षसीगणैः।\nददर्श दीनां दुःखार्तां नावं सन्नामिवार्णवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000358005, "chapter_id": 9358, "verse_number": "५-१९-५", "content_sanskrit": "असंवृतायामासीनां धरण्यां संशितव्रताम्।\nछिन्नां प्रपतितां भूमौ शाखामिव वनस्पतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000358006, "chapter_id": 9358, "verse_number": "५-१९-६", "content_sanskrit": "मलमण्डनदिग्धांगीं मण्डनार्हाममण्डनाम्।\nमृणाली पङ्कदिग्धेव विभाति न विभाति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000358007, "chapter_id": 9358, "verse_number": "५-१९-७", "content_sanskrit": "समीपं राजसिंहस्य रामस्य विदितात्मनः।\nसंकल्पहयसंयुक्तैर्यान्तीमिव मनोरथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000358008, "chapter_id": 9358, "verse_number": "५-१९-८", "content_sanskrit": "शुष्यन्तीं रुदतीमेकां ध्यानशोकपरायणाम्।\nदुःखस्यान्तमपश्यन्तीं रामां राममनुव्रताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000358009, "chapter_id": 9358, "verse_number": "५-१९-९", "content_sanskrit": "चेष्टमानामथाविष्टां पन्नगेन्द्रवधूमिव।\nधूप्यमानां ग्रहेणेव रोहिणीं धूमकेतुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000358010, "chapter_id": 9358, "verse_number": "५-१९-१०", "content_sanskrit": "वृत्तशीले कुले जातामाचारवति धार्मिके।\nपुनः संस्कारमापन्नां जातामिव च दुष्कुले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000358011, "chapter_id": 9358, "verse_number": "५-१९-११", "content_sanskrit": "सन्नामिव महाकीर्तिं श्रद्धामिव विमानिताम्।\nप्रज्ञामिव परिक्षीणामाशां प्रतिहतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000358012, "chapter_id": 9358, "verse_number": "५-१९-१२", "content_sanskrit": "आयतीमिव विध्वस्तामाज्ञां प्रतिहतामिव।\nदीप्तामिव दिशं काले पूजामपहतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000358013, "chapter_id": 9358, "verse_number": "५-१९-१३", "content_sanskrit": "पौर्णमासीमिव निशां तमोग्रस्तेन्दुमण्डलाम्।\nपद्मिनीमिव विध्वस्तां हतशूरां चमूमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000358014, "chapter_id": 9358, "verse_number": "५-१९-१४", "content_sanskrit": "प्रभामिव तमोध्वस्तामुपक्षीणामिवापगाम्।\nवेदीमिव परामृष्टां शान्तामग्निशिखामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000358015, "chapter_id": 9358, "verse_number": "५-१९-१५", "content_sanskrit": "उत्कृष्टपर्णकमलां वित्रासितविहंगमाम्।\nहस्तिहस्तपरामृष्टामाकुलामिव पद्मिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000358016, "chapter_id": 9358, "verse_number": "५-१९-१६", "content_sanskrit": "पतिशोकातुरां शुष्कां नदीं विस्रावितामिव।\nपरया मृजया हीनां कृष्णपक्षे निशामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000358017, "chapter_id": 9358, "verse_number": "५-१९-१७", "content_sanskrit": "सुकुमारीं सुजातांगीं रत्नगर्भगृहोचिताम्।\nतप्यमानामिवोष्णेन मृणालीमचिरोद‍्धृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000358018, "chapter_id": 9358, "verse_number": "५-१९-१८", "content_sanskrit": "गृहीतामालितां स्तम्भे यूथपेन विनाकृताम्।\nनिःश्वसन्तीं सुदुःखार्तां गजराजवधूमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000358019, "chapter_id": 9358, "verse_number": "५-१९-१९", "content_sanskrit": "एकया दीर्घया वेण्या शोभमानामयत्नतः।\nनीलया नीरदापाये वनराज्या महीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000358020, "chapter_id": 9358, "verse_number": "५-१९-२०", "content_sanskrit": "उपवासेन शोकेन ध्यानेन च भयेन च।\nपरिक्षीणां कृशां दीनामल्पाहारां तपोधनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000358021, "chapter_id": 9358, "verse_number": "५-१९-२१", "content_sanskrit": "आयाचमानां दुःखार्तां प्राञ्जलिं देवतामिव।\nभावेन रघुमुख्यस्य दशग्रीवपराभवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000358022, "chapter_id": 9358, "verse_number": "५-१९-२२", "content_sanskrit": "समीक्षमाणां रुदतीमनिन्दितां\nसुपक्ष्मताम्रायतशुक्ललोचनाम्।\nअनुव्रतां राममतीव मैथिलीं\nप्रलोभयामास वधाय रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000358023, "chapter_id": 9358, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे एकोनविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]