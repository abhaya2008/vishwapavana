[{"id": 40021538, "chapter_id": 9358, "verse_number": "1", "content_sanskrit": "ते प्रयाता महात्मानः पार्थिवास्ते प्रहृष्टवत् । गजवाजिसहस्रौघैः कम्पयन्तो वसुन्धराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40021539, "chapter_id": 9358, "verse_number": "2", "content_sanskrit": "अक्षौहिण्यो हि तत्रासन्राघवार्थे समुद्यताः । भरतस्याज्ञया ऽनेकाः प्रहृष्टा बलवाहनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40021540, "chapter_id": 9358, "verse_number": "3", "content_sanskrit": "ऊचुस्ते च महीपाला बलदर्पसमन्विताः । न रामरावणं युद्धे पश्यामः पुरतः स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40021541, "chapter_id": 9358, "verse_number": "4", "content_sanskrit": "भरतेन वयं पश्चात्समानीता निरर्थकम् । हता हि राक्षसाः क्षिप्रं पार्थिवैः स्युर्न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40021542, "chapter_id": 9358, "verse_number": "5", "content_sanskrit": "रामस्य बाहुवीर्येण रक्षिता लक्ष्मणस्य च । सुखं पारेसमुद्रस्य युध्येम विगतज्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40021543, "chapter_id": 9358, "verse_number": "6", "content_sanskrit": "एताश्चान्याश्च राजानः कथास्तत्र सहस्रशः । कथयन्तः स्वराज्यानि जग्मुर्हर्षसमन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40021544, "chapter_id": 9358, "verse_number": "7", "content_sanskrit": "स्वानि राज्यानि मुख्यानि ऋद्धानि मुदितानि च । समृद्धधनधान्यानि पूर्णानि वसुमन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40021545, "chapter_id": 9358, "verse_number": "8", "content_sanskrit": "यथापुराणि ते गत्वा रत्नानि विविधान्यथ । रामस्य प्रियकामार्थमुपहारान् नृपा ददुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40021546, "chapter_id": 9358, "verse_number": "9", "content_sanskrit": "अश्वान्यानानि रत्नानि हस्तिनश्च मदोत्कटान् । चन्दनानि च मुख्यानि दिव्यान्याभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40021547, "chapter_id": 9358, "verse_number": "10", "content_sanskrit": "मणिमुक्ताप्रवालांस्तु दास्यो रूपसमन्विताः । अजाविकांश्च विविधान् रथांस्तु विविधान्ददुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40021548, "chapter_id": 9358, "verse_number": "11", "content_sanskrit": "भरतो लक्ष्मणश्चैव शत्रुघ्नश्च महाबलाः । आदाय तानि रत्नानि स्वां पुरीं पुनरागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40021549, "chapter_id": 9358, "verse_number": "12", "content_sanskrit": "आगम्य च पुरीं रम्यामयोध्यां पुरुषर्षभाः । तानि रत्नानि चित्राणि रामाय समुपाहरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40021550, "chapter_id": 9358, "verse_number": "13", "content_sanskrit": "प्रतिगृह्य च तत्सर्वं रामः प्रीतिसमन्वितः । सुग्रीवाय ददौ राज्ञे महात्मा कृतकर्मणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40021551, "chapter_id": 9358, "verse_number": "14", "content_sanskrit": "बिभीषणाय च ददौ तथान्येभ्यो ऽपि राघवः । राक्षसेभ्यः कपिभ्यश्च यैर्वृतो जयमाप्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40021552, "chapter_id": 9358, "verse_number": "15", "content_sanskrit": "ते सर्वे रामदत्तानि रत्नानि कपिराक्षसाः । शिरोभिर्धारयामासुर्बाहुभिश्च महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40021553, "chapter_id": 9358, "verse_number": "16", "content_sanskrit": "हनूमन्तं च नृपतिरिक्ष्वाकूणां महारथः । अङ्गदं च महाबाहुमङ्कमारोप्य वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40021554, "chapter_id": 9358, "verse_number": "17", "content_sanskrit": "रामः कमलपत्राक्षः सुग्रीवमिदमब्रवीत् । अङ्गदस्ते सुपुत्रो ऽयं मन्त्री चाप्यनिलात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40021555, "chapter_id": 9358, "verse_number": "18", "content_sanskrit": "सुग्रीवमन्त्रिते युक्तौ मम चापि हिते रतौ । अर्हतो विविधां पूजां त्वत्कृते वै हरीश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40021556, "chapter_id": 9358, "verse_number": "19", "content_sanskrit": "इत्युक्त्वा व्यवमुच्याङ्गाद्भूषणानि महायशाः । स बबन्ध महार्हाणि तदाङ्गदहनूमतोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40021557, "chapter_id": 9358, "verse_number": "20", "content_sanskrit": "आभाष्य च महावीर्यान्राघवो यूथपर्षभान् । नीलं नलं केसरिणं कुमुदं गन्धमादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40021558, "chapter_id": 9358, "verse_number": "21", "content_sanskrit": "सुषेणं पनसं वीरं मैन्दं द्विविदमेव च । जाम्बवन्तं गवाक्षं च विनतं धूम्रमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40021559, "chapter_id": 9358, "verse_number": "22", "content_sanskrit": "वलीमुखं प्रजङ्घं च सन्नादं च महाबलम् । दरीमुखं दधिमुखमिन्द्रजानुं च यूथपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40021560, "chapter_id": 9358, "verse_number": "23", "content_sanskrit": "मधुरं श्लक्ष्णया वाचा नेत्राभ्यामापिबन्निव । सुहृदो मे भवन्तश्च शरीरं भ्रातरस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40021561, "chapter_id": 9358, "verse_number": "24", "content_sanskrit": "युष्माभिरुद्धृतश्चाहं व्यसनात्काननौकसः । धन्यो राजा च सुग्रीवो भवद्भिः सुहृदां वरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40021562, "chapter_id": 9358, "verse_number": "25", "content_sanskrit": "एवमुक्त्वा ददौ तेभ्यो भूषणानि यथार्हतः । वज्राणि च महार्हाणि सस्वजे च नरर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40021563, "chapter_id": 9358, "verse_number": "26", "content_sanskrit": "ते पिबन्तः सुगन्धीनि मधूनि मधुपिङ्गलाः । मांसानि च सुमृष्टानि मूलानि च फलानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40021564, "chapter_id": 9358, "verse_number": "27", "content_sanskrit": "एवं तेषां निवसतां मासः साग्रो ययौ तदा । मुहूर्तमिव ते सर्वे रामभक्त्या च मेनिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40021565, "chapter_id": 9358, "verse_number": "28", "content_sanskrit": "रामो ऽपि रेमे तैः सार्धं वानरैः कामरूपिभिः । राक्षसैश्च महावीर्यैर्ऋक्षैश्चैव महाबलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40021566, "chapter_id": 9358, "verse_number": "29", "content_sanskrit": "एवं तेषां ययौ मासो द्वितीयः शिशिरः सुखम् । वानराणां प्रहृष्टानां राक्षसानां च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40021567, "chapter_id": 9358, "verse_number": "30", "content_sanskrit": "इक्ष्वाकुनगरे रम्ये परां प्रीतिमुपासताम् । रामस्य प्रीतिकरणैः कालस्तेषां सुखं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]