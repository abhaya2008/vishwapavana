[{"id": 7005744000, "chapter_id": 25744, "verse_number": "२१७-१", "content_sanskrit": "राजकृत्यवर्णनम् ।\nमत्स्य उवाच ।\nराजा सहायसंयुक्तः प्रभूत यवसेन्धनम् ।\nरम्यमानतसामन्तं मध्यमन्देशमावसेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005744001, "chapter_id": 25744, "verse_number": "२१७-२", "content_sanskrit": "वैश्यशूद्रजनप्रायमनाहार्यं तथा परैः ।\nकिञ्चिद् ब्राह्मणसंयुक्तं बहुकर्मकरन्तथा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005744002, "chapter_id": 25744, "verse_number": "२१७-३", "content_sanskrit": "अदैवमातृकं रम्यमनुरक्तजनान्वितम् ।\nकरैरापीडितञ्चापि बहुपुष्पफलं तथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005744003, "chapter_id": 25744, "verse_number": "२१७-४", "content_sanskrit": "अगम्यं परचक्राणां तद्वासगृहमापदि ।\nसमदुःखसुखं राज्ञः सततं प्रियमास्थितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005744004, "chapter_id": 25744, "verse_number": "२१७-५", "content_sanskrit": "सरीसृपविहीनञ्च व्याघ्रतस्करवर्जितम् ।\nएवं विधं यथालाभं राजा विषयमावसेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005744005, "chapter_id": 25744, "verse_number": "२१७-६", "content_sanskrit": "तत्र दुर्गं नृपः कुर्यात् षण्णामेकतमं बुधः ।\nधनुर्दुर्गं महीदुर्गं नरदुर्गं तथैव च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005744006, "chapter_id": 25744, "verse_number": "२१७-७", "content_sanskrit": "वार्क्षं चैवाम्बुदुर्गं च गिरिदुर्गं च पार्थिव! ।\nसर्वेषामेव दुर्गाणां गिरिदुर्गं प्रशस्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005744007, "chapter_id": 25744, "verse_number": "२१७-८", "content_sanskrit": "दुर्गञ्च परिखोपेतं वप्राट्टालकसंयुतम् ।\nशतघ्नीयन्त्रमुख्यैश्च शतशश्च समावृतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005744008, "chapter_id": 25744, "verse_number": "२१७-९", "content_sanskrit": "गोपुरं सकपाटञ्च तत्र स्यात्सुमनोहरम् ।\nसपताकं गजारूढो येन राजा विशेत्पुरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005744009, "chapter_id": 25744, "verse_number": "२१७-१०", "content_sanskrit": "चतस्रश्च तथा तत्र कार्यस्त्वायतवीथयः ।\nएकस्मिंस्तत्र वीथ्यग्रे देववेश्म भवेद्दृढम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005744010, "chapter_id": 25744, "verse_number": "२१७-११", "content_sanskrit": "वीथ्यग्रे च द्वितीये च राजवेश्म विधीयते ।\nधर्माधिकरणं कार्यं वीथ्यग्रे च तृतीयके ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005744011, "chapter_id": 25744, "verse_number": "२१७-१२", "content_sanskrit": "चतुर्थेत्वथ वीथ्यग्रे गोपुरञ्च विधीयते ।\nआयतञ्चतुरस्रं वा वृत्तं वा कारयेत् पुरम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005744012, "chapter_id": 25744, "verse_number": "२१७-१३", "content_sanskrit": "मुक्तिहीनं त्रिकोणञ्च यवमध्यं तथैव च ।\nआयतञ्चतुरस्रं वा वृत्तं वा कारयेत्पुरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005744013, "chapter_id": 25744, "verse_number": "२१७-१४", "content_sanskrit": "अर्द्धचन्द्रं प्रशंसन्ति नदीतीरेषु तद्वसन् ।\nअन्यत्तत्र न कर्तव्यं प्रयत्नेन विजानता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005744014, "chapter_id": 25744, "verse_number": "२१७-१५", "content_sanskrit": "राज्ञा कोशगृहं कार्यं दक्षिणे राजवेश्मनः ।\nतस्यापि दक्षिणे भागे गजस्थानं विधीयते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005744015, "chapter_id": 25744, "verse_number": "२१७-१६", "content_sanskrit": "गजानां प्राङ्मुखी शाला कर्तव्या वाप्युदङ्मुखी ।\nआग्नेये च तथा भागे आयुधागारमिष्यते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005744016, "chapter_id": 25744, "verse_number": "२१७-१७", "content_sanskrit": "महानसश्च धर्मज्ञ! कर्मशालास्तथापराः ।\nगृहं पुरोधसः कार्यं वामतो राजवेश्मनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005744017, "chapter_id": 25744, "verse_number": "२१७-१८", "content_sanskrit": "मन्त्रिवेदविदाञ्चैव चिकित्साकर्त्तुरेव च ।\nतत्रैव च तथा भागे कोष्ठागारं विधीयते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005744018, "chapter_id": 25744, "verse_number": "२१७-१९", "content_sanskrit": "गवां स्थानं तथैवात्र तुरगाणां तथैव च ।\nउत्तराभिमुखा श्रेणी तुरगाणां विधीयते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005744019, "chapter_id": 25744, "verse_number": "२१७-२०", "content_sanskrit": "दक्षिणाभिमुखा वाथ परिशिष्टस्तु गर्हिताः ।\nतुरगास्ते तथा धार्याः प्रदीपैः सार्वरात्रिकैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005744020, "chapter_id": 25744, "verse_number": "२१७-२१", "content_sanskrit": "कुक्कुटान् वानरांश्चैव मर्कटांश्च विशेषतः ।\nधारयेदश्वशालासु सवत्सां धेनुमेव च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005744021, "chapter_id": 25744, "verse_number": "२१७-२२", "content_sanskrit": "अजाश्च धार्या यत्नेन तुरगाणां हितैषिणा ।\nगोगजाश्वादिशालासु तत्पुरीषस्य निर्गमः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005744022, "chapter_id": 25744, "verse_number": "२१७-२३", "content_sanskrit": "अस्तङ्गते न कर्तव्यो देवदेवे दिवाकरे ।\nतत्र तत्र यथास्थानं राजा विज्ञाय सारथीन् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005744023, "chapter_id": 25744, "verse_number": "२१७-२४", "content_sanskrit": "दद्यादावसथस्थानं सर्वेषामनुपूर्वशः ।\nयोधानां शिल्पिनाञ्चैव सर्वेषमविशेषतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005744024, "chapter_id": 25744, "verse_number": "२१७-२५", "content_sanskrit": "दद्यादावसथान् दुर्गे कालमन्त्रविदां शुभान् ।\nगौर्वैद्यानश्ववैद्यांश्च गजवैद्यांस्तथैव च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005744025, "chapter_id": 25744, "verse_number": "२१७-२६", "content_sanskrit": "आहरेत भृशं राजा दुर्गे हि प्रबला रुचः ।\nकुशीलवानां विप्राणां दुर्गे स्थानं विधीयते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005744026, "chapter_id": 25744, "verse_number": "२१७-२७", "content_sanskrit": "न बहूनामतो दुर्गे विना कार्यं तथा भवेत् ।\nदुर्गे च तत्र कर्तव्या नाना प्रहरणान्विताः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005744027, "chapter_id": 25744, "verse_number": "२१७-२८", "content_sanskrit": "सहस्रघातिनो राजंस्तैस्तु रक्षा विधीयते ।\nदुर्गे द्वाराणि गुप्तानि कार्याण्यपि च भूभृजा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005744028, "chapter_id": 25744, "verse_number": "२१७-२९", "content_sanskrit": "सञ्चयश्चात्र सर्वेषामायुधानां प्रशस्यते ।\nधनुषां क्षेपणीयानान्तोमराणां च पार्थिवः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005744029, "chapter_id": 25744, "verse_number": "२१७-३०", "content_sanskrit": "शरणामथ खड्गानां कवचानां तथैव च ।\nलगुडानां गुडानाञ्च हुडानां परिघैः सह ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005744030, "chapter_id": 25744, "verse_number": "२१७-३१", "content_sanskrit": "अश्मनाञ्च प्रभूतानां मुद्गराणां तथैव च ।\nत्रिशूलानां पट्टिशानां कुठाराणाञ्च पार्थिव ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005744031, "chapter_id": 25744, "verse_number": "२१७-३२", "content_sanskrit": "प्रासानाञ्च सशूलानां शक्तीनाञ्च नरोत्तमः ।\nपरश्वधानां चक्राणां वर्मणाञ्चर्मभिः सह ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005744032, "chapter_id": 25744, "verse_number": "२१७-३३", "content_sanskrit": "कुद्दालक्षुरवेत्राणां पीठकानान्तथैव च ।\nतुषाणाञ्चैव दात्राणामङ्गाराणाञ्च सञ्चयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005744033, "chapter_id": 25744, "verse_number": "२१७-३४", "content_sanskrit": "सर्वेषां शिल्पिभाण्डानां सञ्चयश्चात्र चेष्यते ।\nवादित्राणाञ्च सर्वेषामौषधीनान्तथैव च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005744034, "chapter_id": 25744, "verse_number": "२१७-३५", "content_sanskrit": "यवसानां प्रभूतानामिन्धनस्य च सञ्चयः ।\nगुडस्य सर्वतैलानां गोरसानान्तथैव च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005744035, "chapter_id": 25744, "verse_number": "२१७-३६", "content_sanskrit": "वसानामथ मज्जानां स्नायूनामस्थिभिः सह ।\nगोचर्मपटहानाञ्च धान्यानां सर्वतस्तथा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005744036, "chapter_id": 25744, "verse_number": "२१७-३७", "content_sanskrit": "तथैवाभ्र पटानाञ्च यव गोधूमयोरपि ।\nरत्नानां सर्ववस्त्राणां लोहानामप्यशेषतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005744037, "chapter_id": 25744, "verse_number": "२१७-३८", "content_sanskrit": "कलापमुद्गमाषाणाञ्चणकानान्तिलैः सह ।\nतथा च सर्वशस्यानां पांशुगोमययोरपि ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005744038, "chapter_id": 25744, "verse_number": "२१७-३९", "content_sanskrit": "शणसर्जरसं भूर्जं जतुलाक्षा च टङ्कणम् ।\nराजा सञ्चिनुयाद्दुर्गे यच्चान्यदपि किञ्चन ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005744039, "chapter_id": 25744, "verse_number": "२१७-४०", "content_sanskrit": "कुम्भाश्चाशीविषैः कार्या व्यालसिंहादयस्तथा ।\nमृगाश्च पक्षिणश्चैव रक्ष्यास्ते च परस्परम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005744040, "chapter_id": 25744, "verse_number": "२१७-४१", "content_sanskrit": "स्थानानि च विरुद्धानां सुगुप्तानि पृथक् पृथक् ।\nकर्तव्यानि महाभाग! यत्नेन पृथिवीक्षिता ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005744041, "chapter_id": 25744, "verse_number": "२१७-४२", "content_sanskrit": "उक्तानि चाप्यनुक्तानि राजद्रव्याण्यशेषतः ।\nसुगुप्तानि पुरे कुर्याज्जनानां हितकाम्यया ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005744042, "chapter_id": 25744, "verse_number": "२१७-४३", "content_sanskrit": "जीवकर्षभकाकोलमामलक्याटरूषकान् ।\nशालपर्णी पृष्ठिपर्णी मुद्गपर्णी तथैव च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005744043, "chapter_id": 25744, "verse_number": "२१७-४४", "content_sanskrit": "माषपर्णी च मदद्वैसारि वेद्वेबलात्रयम् ।\nवारा श्वसन्ती वृष्या च बृहती कण्टकारिका ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005744044, "chapter_id": 25744, "verse_number": "२१७-४५", "content_sanskrit": "शृङ्गी शृङ्गाटकी द्रोणी वर्षाभूर्दर्भरेणुका ।\nमधुपर्णी विदार्ये द्वे महाक्षीरा महातपाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005744045, "chapter_id": 25744, "verse_number": "२१७-४६", "content_sanskrit": "धन्वनः सहदेवाह्वा कटुकैरण्डकं विषः ।\nपर्णी शताह्वा मृद्वीका फल्गु खर्जरयष्टिकाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005744046, "chapter_id": 25744, "verse_number": "२१७-४७", "content_sanskrit": "शुक्रातिशुक्रकाश्मर्यञ्छत्रातिच्छत्रवीरणाः ।\nइक्षुरिक्षुविकाराश्च फाणिताद्याश्च सत्तम ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005744047, "chapter_id": 25744, "verse_number": "२१७-४८", "content_sanskrit": "सिंही च सहदेवी च विश्वेदेवाश्वरोधकम् ।\nमधुकं पुष्पहंसाख्या शतपुष्पा मधूलिका ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005744048, "chapter_id": 25744, "verse_number": "२१७-४९", "content_sanskrit": "शतावरी मधूके च पिप्पलन्तालमेव च ।\nआत्मगुप्ता कट्फलाख्या दार्विका राजशीर्षकी ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005744049, "chapter_id": 25744, "verse_number": "२१७-५०", "content_sanskrit": "राजसर्षपधान्याकमृष्यप्रोक्ता तथोत्कटा ।\nकालशाकं पद्मबीजं गोवल्ली मधुवल्लिका ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005744050, "chapter_id": 25744, "verse_number": "२१७-५१", "content_sanskrit": "शीतपाकी कुवेराक्षी काकजिह्वोरुपुष्पिका ।\nपर्वतत्रपुसौ चोभौ गुञ्जातकपुनर्नवे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005744051, "chapter_id": 25744, "verse_number": "२१७-५२", "content_sanskrit": "कसेरु कारुकाश्मीरी बल्या शालूक केसरम् ।\nतुषधान्यानि सर्वाणि शमी धान्यानि चैव हि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005744052, "chapter_id": 25744, "verse_number": "२१७-५३", "content_sanskrit": "क्षीरं क्षौद्रन्तथा तक्रं तैलं मज्जा वसा घृतम् ।\nनीपश्चारिष्टकाक्षोड वाताम सोम बाणकम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005744053, "chapter_id": 25744, "verse_number": "२१७-५४", "content_sanskrit": "एवमादीनि चान्यानि विज्ञेयो मधुरो गणः ।\nराजा सञ्चिनुयात्सर्वं पुरे निरवशेषतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005744054, "chapter_id": 25744, "verse_number": "२१७-५५", "content_sanskrit": "दाडिमाम्रातकौ चैव तिन्तिडीकाम्लवेतसम् ।\nभव्यकर्कन्धुलकुचकरमर्द्दकरूषकम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005744055, "chapter_id": 25744, "verse_number": "२१७-५६", "content_sanskrit": "बीजपूरककण्डूरे मालतीराजबन्धुकम् ।\nकोलकद्वयपर्णानि द्वयोराम्नातयोरपि ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005744056, "chapter_id": 25744, "verse_number": "२१७-५७", "content_sanskrit": "पारावतं नागरकं प्राचीनोलकमेव च ।\nकपित्थामलकं चुक्र फलन्दन्तशठस्य च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005744057, "chapter_id": 25744, "verse_number": "२१७-५८", "content_sanskrit": "जाम्बवं नवनीतञ्च सौवीर करुषोदके ।\nसुरासवञ्च मद्यानि मण्ड तक्रदधीनि च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005744058, "chapter_id": 25744, "verse_number": "२१७-५९", "content_sanskrit": "शुक्लानि चैव सर्वाणि ज्ञेयमाम्लगणं द्विज ।\nएवमादीनि चान्यानि राजा सञ्चिनुयात्पुरे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005744059, "chapter_id": 25744, "verse_number": "२१७-६०", "content_sanskrit": "सैन्धवोद्भिदपाठेय पाक्यसामुद्रलोमकम् ।\nकुप्य-सौवर्चलविड बालकेयं यवाह्वकम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005744060, "chapter_id": 25744, "verse_number": "२१७-६१", "content_sanskrit": "और्वं क्षारं कालभस्म विज्ञेयो लवणोगणः ।\nएवमादीनि चान्यानि राजा सञ्चिनुयात्पुरे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005744061, "chapter_id": 25744, "verse_number": "२१७-६२", "content_sanskrit": "पिप्पली पिप्पलीमूल चव्यचित्रकनागरम् ।\nकुबेरकं मरिचकं शिग्रुभल्लातसर्षपाः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005744062, "chapter_id": 25744, "verse_number": "२१७-६३", "content_sanskrit": "कुष्ठाज मोदाकिणि-हीहिङ्गु मूलकधान्यकम् ।\nकारवी कुञ्जिका याज्या सुमुखा कालमालिका ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005744063, "chapter_id": 25744, "verse_number": "२१७-६४", "content_sanskrit": "फणिज्जकोथ लशुनं भूस्तृणां सुरसन्तथा ।\nकायस्था च वयस्था च हरितालं मनः शिला ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005744064, "chapter_id": 25744, "verse_number": "२१७-६५", "content_sanskrit": "अमृता च रुदन्ती च रोहिषं कुङ्कुमन्तथा ।\nजया एरण्डकाण्डीरं सल्लकीहञ्जिका तथा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005744065, "chapter_id": 25744, "verse_number": "२१७-६६", "content_sanskrit": "सर्वपित्तानि मूत्राणि प्रायो हरितकानि च ।\nफलानि चैव हि तथा सूक्ष्मैला हिङ्गुपट्टिका ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005744066, "chapter_id": 25744, "verse_number": "२१७-६७", "content_sanskrit": "एवमादीनि चान्यानि गणः कटुकसञ्ज्ञितः ।\nराजा सञ्चिनुयाद्दुर्गे प्रयत्नेन नृपोत्तम! ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005744067, "chapter_id": 25744, "verse_number": "२१७-६८", "content_sanskrit": "मुस्तञ्चन्दन ह्री वेर कृतमालकदारवः ।\nदरिद्रानलदोशीर नक्तमालकदम्बकम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005744068, "chapter_id": 25744, "verse_number": "२१७-६९", "content_sanskrit": "दूर्वा पटोलकटुका दीर्घत्वक् पत्रकं वचा ।\nकिराततिक्त भूतुम्वी विषा चातिविषा तथा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005744069, "chapter_id": 25744, "verse_number": "२१७-७०", "content_sanskrit": "तालीसपत्रतगरं सप्तपर्णविकङ्कताः ।\nकाकोदुम्वरिका दिव्या तथा चैव सुरोद्भवा ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005744070, "chapter_id": 25744, "verse_number": "२१७-७१", "content_sanskrit": "षड्ग्रन्था रोहिणी मांसी पर्पटश्चाथ दन्तिका ।\nरसाञ्जनं भृङ्गराजं पतङ्गी परिपेलवम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005744071, "chapter_id": 25744, "verse_number": "२१७-७२", "content_sanskrit": "दुःस्पर्शा गुरुणी कामा श्यामाकं गन्धनाकुली ।\nरूपपर्णी व्याघ्रनखं मञ्जिष्ठा चतुरङ्गुला ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005744072, "chapter_id": 25744, "verse_number": "२१७-७३", "content_sanskrit": "रम्भा चैवाङ्कुरास्फोता तालास्फोता हरेणुका ।\nवेत्राग्र वेतसस्तुम्बी विषाणी लोध्रपुष्पिणी ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005744073, "chapter_id": 25744, "verse_number": "२१७-७४", "content_sanskrit": "मालतीकरकृष्णाख्या वृश्चिका जीविता तथा ।\nपर्णिका च गुडूची च सगणस्तिक्त सञ्ज्ञकः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005744074, "chapter_id": 25744, "verse_number": "२१७-७५", "content_sanskrit": "एवमादीनि चान्यानि राजा सञ्चिनुयात्पुरे ।\nअभयामलके चोभे तथैव च बिभीतकम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005744075, "chapter_id": 25744, "verse_number": "२१७-७६", "content_sanskrit": "प्रियङ्गुधातकी पुष्पं मोचाख्या चार्जुनासनाः ।\nअनन्ता स्त्रीतुवरिका स्योनाङ्कट् फलन्तथा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005744076, "chapter_id": 25744, "verse_number": "२१७-७७", "content_sanskrit": "भूर्जपत्रं शिलापत्रं पाटलापत्र-लोमकम् ।\nसमङ्गात्रिवृतामूलकार्पास-गैरिकाञ्जनम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005744077, "chapter_id": 25744, "verse_number": "२१७-७८", "content_sanskrit": "विद्रुमं स मधूच्छिष्टं कुम्भिकाकुमुदोत्पलम् ।\nन्यग्रोधोदुम्बराश्वत्थ किंशुकाः शिंशुपा शमी ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005744078, "chapter_id": 25744, "verse_number": "२१७-७९", "content_sanskrit": "प्रियालपीलुकासारि शिरीषाः पद्मकन्तथा ।\nबिल्वोऽग्निमन्थः प्लक्षञ्च श्यामाकश्च वको घनम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7005744079, "chapter_id": 25744, "verse_number": "२१७-८०", "content_sanskrit": "राजादनं करीरञ्च धान्यकं प्रियकस्तथा ।\nकङ्कोला-शोक-बदराः कदम्बखदिरद्वयम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7005744080, "chapter_id": 25744, "verse_number": "२१७-८१", "content_sanskrit": "एषां पत्राणि साराणि मूलानि कुसुमानि च ।\nएवमादीनि चान्यानि कषायाख्यो मतो रसः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7005744081, "chapter_id": 25744, "verse_number": "२१७-८२", "content_sanskrit": "प्रयत्नेन नृपश्रेष्ठ! राजा सञ्चिनुयात्पुरे ।\nकीटाश्च मारणे योग्या व्यङ्गतायां तथैव च ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7005744082, "chapter_id": 25744, "verse_number": "२१७-८३", "content_sanskrit": "वातधूमाश्च मार्गाणां दूषणानि तथैव व ।\nधार्याणि पाथिवैर्दुर्गे तानि वक्ष्यामि पार्थिव ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7005744083, "chapter_id": 25744, "verse_number": "२१७-८४", "content_sanskrit": "विषाणां धारणं कार्यं प्रयत्नेन महीभुजा ।\nविचित्राश्चाङ्गदा धार्या विषस्य शमनास्तथा ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7005744084, "chapter_id": 25744, "verse_number": "२१७-८५", "content_sanskrit": "रक्षोभूतः पिशाचघ्नाः पापघ्नाः पुष्टिवर्धनाः ।\nकलाविदश्च पुरुषाः पुरे धार्याः प्रयत्नतः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7005744085, "chapter_id": 25744, "verse_number": "२१७-८६", "content_sanskrit": "भीतान् प्रमत्तान् कुपितांस्तथैव च विमानितान् ।\nकुभृत्यान् पापशीलांश्च न राजा वासयेत् पुरे ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7005744086, "chapter_id": 25744, "verse_number": "२१७-८७", "content_sanskrit": "यन्त्रायुधाट्टालचयोपपन्नं समग्रधान्यौषधिसम्प्रयुक्तम् ।\nवणिग्जनैश्च वृतमावसेत दुर्गं सुगुप्तं नृपतिः सदैव ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]