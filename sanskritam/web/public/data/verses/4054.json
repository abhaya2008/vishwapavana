[{"id": 2141619, "chapter_id": 4054, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2141620, "chapter_id": 4054, "verse_number": "१", "content_sanskrit": "ततो भीष्मः शान्तनवो वीर्यवान् सायकान् बहून् ।\nसमर्पयन्महावेगान् श्वसतः पन्नगानिव\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2141621, "chapter_id": 4054, "verse_number": "२", "content_sanskrit": "ते ध्वजं पाण्डुपुत्रस्य समासाद्य पतत्रिणः ।\nज्वलन्तं कपिमाजघ्नुर्ध्वजाग्रनिलयं च तम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2141622, "chapter_id": 4054, "verse_number": "३", "content_sanskrit": "सारथिं च हयांश्चापि विव्याध निशितैः शरैः ।\nउरस्यताडयत् पार्थं त्रिभिरेवायसैः शरैः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2141623, "chapter_id": 4054, "verse_number": "४", "content_sanskrit": "तदाऽर्जुनः शरैस्तीक्ष्णैर्विद्ध्वा कुरुपितामहम् ।\nध्वजं च सारथिं चापि विव्याध दशभिः शरैः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2141624, "chapter_id": 4054, "verse_number": "५", "content_sanskrit": "तद्युद्धमभवद् घोरं लोमहर्षणमद्भुतम् ।\nभीष्मस्य सह पार्थेन बलिवासवयोरिव\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2141625, "chapter_id": 4054, "verse_number": "६", "content_sanskrit": "सन्ततं शरमालाभिराकाशं समपद्यत ।\nअम्बुदैरिव धाराभिस्तयोः कार्मुकनिःसृतैः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2141626, "chapter_id": 4054, "verse_number": "७", "content_sanskrit": "भल्लैर्भल्लाः समाहत्य भीष्मपाण्डवयो रणे ।\nअन्तरिक्षे व्यराजन्त खद्योताः प्रावृषीव हि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2141627, "chapter_id": 4054, "verse_number": "८", "content_sanskrit": "अग्निचक्रोपमं घोरं मण्डलीकृतमाहवे ।\nगाण्डीवमभवज्जिष्णोः सव्यं दक्षिणमस्यतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2141628, "chapter_id": 4054, "verse_number": "९", "content_sanskrit": "पर्वतं वारिधाराभिः छादयन्निव तोयदः ।\nअर्जुनश्छादयद् भीष्मं शरवर्षैरनेकशः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2141629, "chapter_id": 4054, "verse_number": "१०", "content_sanskrit": "तां समुद्रमिवोद्धूतां शरवृष्टिं समुद्यताम् ।\nव्यधमत् शनकैर्भीष्मो ह्यर्जुनं सन्न्यवारयत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2141630, "chapter_id": 4054, "verse_number": "११", "content_sanskrit": "ततस्तानि विसृष्टानि शरजालानि सङ्घशः ।\nआहतानि व्यकीर्यन्त अर्जुनस्य रथं प्रति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2141631, "chapter_id": 4054, "verse_number": "१२", "content_sanskrit": "ततः कनकपुङ्खाग्रैः शरैः सन्नतपर्वभिः ।\nपतद्भिः खगवाजैश्च द्यौरासीत् संवृता शरैः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2141632, "chapter_id": 4054, "verse_number": "१३", "content_sanskrit": "ततः प्रासृजदुग्राणि शरजालानि पाण्डवः ।\nतावन्ति शरजालानि भीष्मः पार्थाय प्राहिणोत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2141633, "chapter_id": 4054, "verse_number": "१४", "content_sanskrit": "साश्वं ससूतं सरथं स पार्थं\nसमाहिनोद् भारत वत्सदन्तैः ।\nप्रच्छादयामास दिशश्च सर्वा\nनभश्च बाणैस्तपनीयपुङ्खैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2141634, "chapter_id": 4054, "verse_number": "१५", "content_sanskrit": "ततो देवर्षिगन्धर्वाः साधुसाध्वित्यपूजयन् ।\nदुष्करं कुरुते भीष्मो यदर्जुनमयोधयत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2141635, "chapter_id": 4054, "verse_number": "१६", "content_sanskrit": "बलवानर्जुनो दक्षः क्षिप्रकारी च पाण्डवः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2141636, "chapter_id": 4054, "verse_number": "१७", "content_sanskrit": "कोऽन्यः समर्थः पार्थस्य वेगं धारयितुं रणे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2141637, "chapter_id": 4054, "verse_number": "१८", "content_sanskrit": "ऋते शान्तनवाद् भीष्मात् कृष्णाद्वा देवकीसुतात् ।\nआचार्यवरमुख्याद्वा भारद्वाजान्महाबलात्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2141638, "chapter_id": 4054, "verse_number": "१९", "content_sanskrit": "अस्त्रैरस्त्राणि संविध्य क्रीडन्तौ पुरुषोत्तमौ ।\nचक्षूंषि सर्वभूतानां मोहयन्तौ महाबलौ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2141639, "chapter_id": 4054, "verse_number": "२०", "content_sanskrit": "प्राजापत्यं तथैवेन्द्रमाग्नेयं च सुदारुणम् ।\nकौबेरं वारुणं चैव याम्यं वायव्यमेव च\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2141640, "chapter_id": 4054, "verse_number": "२१", "content_sanskrit": "प्रयुञ्जानौ महात्मानौ समरे तौ विरेजतुः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2141641, "chapter_id": 4054, "verse_number": "२२", "content_sanskrit": "विस्मितान्यथ भूतानि तौ दृष्ट्वा संयुगे तथा ।\nसाधु पार्थ महाबाहो साधु भीष्मेति चाब्रुवन्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2141642, "chapter_id": 4054, "verse_number": "२३", "content_sanskrit": "नैतदन्यो मनुष्येषु प्रदर्शयितुमाहवे ।\nमहास्त्राणां सम्प्रयोगं समरे भीष्मपार्थयोः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2141643, "chapter_id": 4054, "verse_number": "२४", "content_sanskrit": "एवं सर्वास्त्रविदुषोरस्त्रयुद्धमवर्तत\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2141644, "chapter_id": 4054, "verse_number": "२५", "content_sanskrit": "अथ जिष्णुरुदाहृत्य शितधारेण कार्मुकम् ।\nन्यकृन्तद् गृध्रपत्रेण जातरूपपरिष्कृतम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2141645, "chapter_id": 4054, "verse_number": "२६", "content_sanskrit": "निमेषान्तरमात्रेण भीष्मोऽन्यत् कार्मुकं रणे ।\nसमादाय नरव्याघ्रः सज्यं चक्रे महाबलः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2141646, "chapter_id": 4054, "verse_number": "२७", "content_sanskrit": "शरांश्च सुबहून् क्रुद्धो मुमोचाशु धनञ्जये\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2141647, "chapter_id": 4054, "verse_number": "२८", "content_sanskrit": "अर्जुनोऽपि शरान् तीक्ष्णान् भीष्माय निशितान् बहून् ।\nचिक्षेप सुमहातेजास्तथा भीष्मश्च पाण्डवे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2141648, "chapter_id": 4054, "verse_number": "२९", "content_sanskrit": "तयोर्दिव्यास्त्रविदुषोरस्यतोरनिशं शरान् ।\nन विशेषस्तदा राजँल्लक्ष्यते सुमहात्मनोः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2141649, "chapter_id": 4054, "verse_number": "३०", "content_sanskrit": "अथावृणोद् दश दिशः शरैरतिरथस्तथा ।\nकिरीटमाली कौन्तेयः शूरं(रः) शान्तनवं तदा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2141650, "chapter_id": 4054, "verse_number": "३१", "content_sanskrit": "अतीव पाण्डवो भीष्मं भीष्मश्चातीव पाण्डवम् ।\nबभूव तत्र सङ्घे(ङ्खे)ऽस्मिँल्लोके राजंस्तदद्भुतम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2141651, "chapter_id": 4054, "verse_number": "३२", "content_sanskrit": "पाण्डवेन हताः शूरा भीष्मस्य रथरक्षिणः ।\nशेरते समरे राजन् कौन्तेयस्याहताः शरैः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2141652, "chapter_id": 4054, "verse_number": "३३", "content_sanskrit": "ततो गाण्डीवनिर्मुक्ता इषवः पन्नगा इव ।\nअगच्छन् पुङ्खसंसक्ताः श्वेतवाहनपत्रिणः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2141653, "chapter_id": 4054, "verse_number": "३४", "content_sanskrit": "निष्पतन्तो रथात् तस्य धौता हैरण्यवाससः ।\nआकाशे प्रत्यदृश्यन्त हंसानामिव पङ्क्तयः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2141654, "chapter_id": 4054, "verse_number": "३५", "content_sanskrit": "तस्य तद् दिव्यमस्त्रं हि प्रगाढं चित्रमस्यतः ।\nप्रेक्षन्ते स्मान्तरिक्षस्थाः सर्वे देवाः सवासवाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2141655, "chapter_id": 4054, "verse_number": "३६", "content_sanskrit": "तं दृष्ट्वा परमप्रीतो गन्धर्वश्चित्रमद्भुतम् ।\nशशंस देवराजाय चित्रसेनः प्रतापवान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2141656, "chapter_id": 4054, "verse_number": "३७", "content_sanskrit": "पश्येमानरिनिर्दारान् संसक्तानीव गच्छतः ।\nचित्ररूपमिदं जिष्णोर्दिव्यमस्त्रमुदीर्यतः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2141657, "chapter_id": 4054, "verse_number": "३८", "content_sanskrit": "नेदं मनुष्याः श्रद्दध्युर्न हीदं तेषु विद्यते ।\nपौराणानां महास्त्राणां विचित्रोऽयं समागमः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2141658, "chapter_id": 4054, "verse_number": "३९", "content_sanskrit": "मध्यन्दिनगतं सूर्यं प्रतपन्तमिवाम्बरे ।\nन शक्नुवन्ति सैन्यानि पाण्डवं प्रतिवीक्षितुम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2141659, "chapter_id": 4054, "verse_number": "४०", "content_sanskrit": "उभौ विश्रुतकर्माणावुभौ वीरौ महीक्षिताम् ।\nउभौ सदृशकर्माणावुभौ युधि दुरासदौ\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2141660, "chapter_id": 4054, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2141661, "chapter_id": 4054, "verse_number": "४१", "content_sanskrit": "इत्युक्तो देवराजस्तु पार्थभीष्मसमागमम् ।\nपूजयामास दिव्येन पुष्पवर्षेण भारत\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2141662, "chapter_id": 4054, "verse_number": "४२", "content_sanskrit": "ततो भीष्मः शान्तनवो वामपार्श्वे समर्पयत् ।\nअस्यतः प्रतिसन्धाय विवृतं सव्यसाचिनः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2141663, "chapter_id": 4054, "verse_number": "४३", "content_sanskrit": "ततः प्रसँह्य बीभत्सुः पृथुधारेण कार्मुकम् ।\nन्यकृन्तद् गृध्रपत्रेण भीष्मस्यामिततेजसः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2141664, "chapter_id": 4054, "verse_number": "४४", "content_sanskrit": "अथैनं दशभिः पश्चात् प्रत्यविध्यत् स्तनान्तरे ।\nयतमानं पराक्रान्तं कुन्तीपुत्रो धनञ्जयः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2141665, "chapter_id": 4054, "verse_number": "४५", "content_sanskrit": "आपीडितो महाबाहुर्गृहीत्वा रथकूबरम् ।\nगाङ्गेयो युधि दुर्धर्षस्तस्थौ दीर्घमिवातुरः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2141666, "chapter_id": 4054, "verse_number": "४६", "content_sanskrit": "तं विसञ्ज्ञमपोवाह संयन्ता रथवाजिनाम् ।\nउपदेशमनुस्मृत्य रक्षमाणो महारथम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2141667, "chapter_id": 4054, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां विराटपर्वणि द्विषष्टितमोऽध्यायः ॥६२॥\nगोग्रहणपर्वणि पञ्चत्रिंशोऽध्यायः ॥३५॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]