[{"id": 6000331000, "chapter_id": 10331, "verse_number": null, "content_sanskrit": "अथ त्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000331001, "chapter_id": 10331, "verse_number": null, "content_sanskrit": "राजोवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.001.m4a", "display_order": 2}, {"id": 6000331002, "chapter_id": 10331, "verse_number": "११-३०-१", "content_sanskrit": "ततो महाभागवत उद्धवे बदरीं गते।\nद्वारवत्यां किमकरोद् भगवान् भूतभावनः॥ ११/३०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.002.m4a", "display_order": 3, "topics": [{"text": "शुकाचार्येण परीक्षितं प्रति भगवता कृतस्य मौसलव्याजेन यादवकुलसंहारस्य कथनम्", "range": "१–२४"}]}, {"id": 6000331003, "chapter_id": 10331, "verse_number": "११-३०-२", "content_sanskrit": "ब्रह्मशापोपसंसृष्टे स्वकुले यादवर्षभः।\nप्रेयसीं सर्वनेत्राणां तनुं स कथमत्यजत्॥ ११/३०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.003.m4a", "display_order": 4}, {"id": 6000331004, "chapter_id": 10331, "verse_number": "११-३०-३", "content_sanskrit": "प्रत्याक्रष्टुं नयनमबला यत्र मग्नं न शेकुः कर्णाविष्टं न सरति यशो यत् सतामात्मलग्नम्।\nयच्छ्रीवाक्यं जनयति रतिं कोऽनुमानः कवीनां दृष्ट्वा जिष्णोर्युधि रथगतं यच्च तत्साम्यमीयुः॥ ११/३०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.004.m4a", "display_order": 5}, {"id": 6000331005, "chapter_id": 10331, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.005.m4a", "display_order": 6}, {"id": 6000331006, "chapter_id": 10331, "verse_number": "११-३०-४", "content_sanskrit": "दिवि भुव्यन्तरिक्षे च महोत्पातान् समुत्थितान्।\nदृष्ट्वाऽऽसीनान् सुधर्मायां कृष्णः प्राह यदूनिदम्॥ ११/३०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.006.m4a", "display_order": 7}, {"id": 6000331007, "chapter_id": 10331, "verse_number": "११-३०-५", "content_sanskrit": "एते घोरा महोत्पाता द्वार्वत्यां यमकेतवः।\nमुहूर्तमपि न स्थेयमत्र वो यदुपुङ्गवाः॥ ११/३०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.007.m4a", "display_order": 8}, {"id": 6000331008, "chapter_id": 10331, "verse_number": "११-३०-६", "content_sanskrit": "स्त्रियो बालाश्च वृद्धाश्च शङ्खोद्धारं व्रजन्त्वितः।\nवयं प्रभासं यास्यामो यत्र प्रत्यक् सरस्वती॥ ११/३०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.008.m4a", "display_order": 9}, {"id": 6000331009, "chapter_id": 10331, "verse_number": "११-३०-७", "content_sanskrit": "तत्राभिषिच्य शुचय उपोष्य सुसमाहिताः।\nदेवताः पूजयिष्याम स्नपनालेपनार्हणैः॥ ११/३०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.009.m4a", "display_order": 10}, {"id": 6000331010, "chapter_id": 10331, "verse_number": "११-३०-८", "content_sanskrit": "ब्राह्मणांस्तु महाभागान् कृतस्वस्त्ययना वयम्।\nगोभूहिरण्यवासोभिर्गजाश्वरथवेश्मभिः॥ ११/३०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.010.m4a", "display_order": 11}, {"id": 6000331011, "chapter_id": 10331, "verse_number": "११-३०-९", "content_sanskrit": "विधिरेष ह्यरिष्टघ्नो मङ्गलायनमुत्तमम्।\nदेवद्विजगवां पूजा भूतेषु परमा दया॥ ११/३०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.011.m4a", "display_order": 12}, {"id": 6000331012, "chapter_id": 10331, "verse_number": "११-३०-१०", "content_sanskrit": "इति सर्वे समाकर्ण्य यदुवृद्धा मधुद्विषः।\nतथेति नौभिरुत्तीर्य प्रभासं प्रययू रथैः॥ ११/३०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.012.m4a", "display_order": 13}, {"id": 6000331013, "chapter_id": 10331, "verse_number": "११-३०-११", "content_sanskrit": "तस्मिन् भगवताऽदिष्टं यदुदेवेन यादवाः।\nचक्रुः परमया भक्त्या सर्वश्रेयोपबृंहितम्॥ ११/३०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.013.m4a", "display_order": 14}, {"id": 6000331014, "chapter_id": 10331, "verse_number": "११-३०-१२", "content_sanskrit": "ततस्तस्मिन् महापानं पपुर्मैरेयकं मधु।\nदिष्टविभ्रंशितधियो यादवा नष्टमङ्गलाः॥ ११/३०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.014.m4a", "display_order": 15}, {"id": 6000331015, "chapter_id": 10331, "verse_number": "११-३०-१३", "content_sanskrit": "महापानाभिमत्तानां वीराणां दृप्तचेतसाम्।\nकृष्णमायाविमूढानां सङ्घर्षः सुमहानभूत्॥ ११/३०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.015.m4a", "display_order": 16}, {"id": 6000331016, "chapter_id": 10331, "verse_number": "११-३०-१४", "content_sanskrit": "युयुधुः क्रोधसंरब्धा वेलायामाततायिनः।\nधनुर्भिरसिभिर्भल्लैर्गदाभिस्तोमरर्ष्टिभिः॥ ११/३०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.016.m4a", "display_order": 17}, {"id": 6000331017, "chapter_id": 10331, "verse_number": "११-३०-१५", "content_sanskrit": "पतत्पताकैः रथकुञ्जरार्वभिः खरोष्ट्रगोभिर्महिषैर्नरैरपि।\nमिथः समेत्याश्वतरैश्च दुर्मदा न्यहञ्छरैर्दद्भिरिव द्विपा वने॥ ११/३०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.017.m4a", "display_order": 18}, {"id": 6000331018, "chapter_id": 10331, "verse_number": "११-३०-१६", "content_sanskrit": "प्रद्युम्नसाम्बौ युधिरूढमत्सरावक्रूरभोजावनिरुद्धसात्यकी।\nसुभद्रसङ्ग्रामजितौ सुचारुगदौ सुमित्रासुरथौ समीयतुः॥ ११/३०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.018.m4a", "display_order": 19}, {"id": 6000331019, "chapter_id": 10331, "verse_number": "११-३०-१७", "content_sanskrit": "अन्ये च ये वै निशठोल्मुकादयः सहस्रजिच्छतजिद्भानुमुख्याः।\nअन्योन्यमासाद्य मदान्धकारिता जघ्नुर्मुकुन्देन विमोहिता भृशम्॥ ११/३०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.019.m4a", "display_order": 20}, {"id": 6000331020, "chapter_id": 10331, "verse_number": "११-३०-१८", "content_sanskrit": "दाशार्हवृष्ण्यन्धकभोजसात्वता अध्वर्युदा माधुरशूरसेनाः।\nविसर्जनाः कुकुराः कुन्तयश्च मिथस्तु जघ्नुः सुविसृज्य सौहृदम्॥ ११/३०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.020.m4a", "display_order": 21}, {"id": 6000331021, "chapter_id": 10331, "verse_number": "११-३०-१९", "content_sanskrit": "पुत्रास्त्वयुध्यन् पितृभिर्भ्रातृभिश्च स्वस्रीयदौहित्रपितृव्यमातुलैः।\nमित्राणि मित्रैः सुहृदः सुहृद्भिर्ज्ञातींस्त्वहन् ज्ञातय एव मूढाः॥ ११/३०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.021.m4a", "display_order": 22}, {"id": 6000331022, "chapter_id": 10331, "verse_number": "११-३०-२०", "content_sanskrit": "शरेषु हीयमानेषु भज्यमानेषु धन्वसु।\nशस्त्रेषु क्षीयमाणेषु मुष्टिभिर्जह्रुरेरकाः॥ ११/३०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.022.m4a", "display_order": 23}, {"id": 6000331023, "chapter_id": 10331, "verse_number": "११-३०-२१", "content_sanskrit": "ता वज्रकल्पा अभवन् परिघा मुष्टिना हृताः।\nजघ्नुर्द्विषस्ते कृष्णेन वार्यमाणास्तु तं च ते॥ ११/३०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.023.m4a", "display_order": 24}, {"id": 6000331024, "chapter_id": 10331, "verse_number": "११-३०-२२", "content_sanskrit": "प्रत्यनीकं मन्यमाना बलभद्रं च मोहिताः।\nहन्तुं कृतधियो राजन्नापन्ना आततायिनः॥ ११/३०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.024.m4a", "display_order": 25}, {"id": 6000331025, "chapter_id": 10331, "verse_number": "११-३०-२३", "content_sanskrit": "अथ तावपि संक्रुद्धावुद्यम्य कुरुनन्दन।\nएरकामुष्टिपरिघैश्चरन्तौ जघ्नतुर्युधि॥ ११/३०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.025.m4a", "display_order": 26}, {"id": 6000331026, "chapter_id": 10331, "verse_number": "११-३०-२४", "content_sanskrit": "ब्रह्मशापोपसृष्टानां कृष्णमायावृतात्मनाम्।\nस्पर्द्धाक्षोभः क्षयं निन्ये वैणवोऽग्निर्यथा वनम्॥ ११/३०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.026.m4a", "display_order": 27}, {"id": 6000331027, "chapter_id": 10331, "verse_number": "११-३०-२५", "content_sanskrit": "एवं सर्वेषु नष्टेषु कुलेषु स्वेषु केशवः।\nउत्तारितो भुवोभार इति मेनेऽवशेषितः॥ ११/३०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.027.m4a", "display_order": 28}, {"id": 6000331028, "chapter_id": 10331, "verse_number": "११-३०-२६", "content_sanskrit": "रामः समुद्रवेलायां योगमास्थाय पौरुषम्।\nतत्यजे योगमाविश्य संयोज्यात्मानमात्मनि॥ ११/३०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.028.m4a", "display_order": 29, "topics": [{"text": "बलरामस्य देहत्यागः", "range": "२६"}]}, {"id": 6000331029, "chapter_id": 10331, "verse_number": "११-३०-२७", "content_sanskrit": "रामनिर्याणमालोक्य भगवान् देवकीसुतः।\nनिषसाद धरोपस्थे तूष्णीमासाद्य पिप्पलम्॥ ११/३०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.029.m4a", "display_order": 30}, {"id": 6000331030, "chapter_id": 10331, "verse_number": "११-३०-२८", "content_sanskrit": "बिभ्रच्चतुर्भुजं रूपं भ्राजिष्णुप्रभया स्वया।\nदिशो वितिमिराः कुर्वन् विधूम इव पावकः॥ ११/३०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.030.m4a", "display_order": 31}, {"id": 6000331031, "chapter_id": 10331, "verse_number": "११-३०-२९", "content_sanskrit": "श्रीवत्साङ्कं घनश्यामं तप्तहाटकवर्चसम्।\nकौशेयाम्बरयुग्मेन परिवीतं सुमङ्गलम्॥ ११/३०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.031.m4a", "display_order": 32}, {"id": 6000331032, "chapter_id": 10331, "verse_number": "११-३०-३०", "content_sanskrit": "सुन्दरस्मितवक्त्राब्जं नीलकुन्तलमण्डितम्।\nपुण्डरीकाभिरामाक्षं स्फुरन्मकरकुण्डलम्॥ ११/३०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.032.m4a", "display_order": 33}, {"id": 6000331033, "chapter_id": 10331, "verse_number": "११-३०-३१", "content_sanskrit": "कटिसूत्रब्रह्मसूत्रकिरीटकनकाङ्गदैः।\nहारनूपुरमुद्राभिः कौस्तुभेन विराजितम्॥ ११/३०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.033.m4a", "display_order": 34}, {"id": 6000331034, "chapter_id": 10331, "verse_number": "११-३०-३२", "content_sanskrit": "वनमालापरीताङ्गं मूर्तिमद्भिर्निजायुधैः।\nकृत्वोरौ दक्षिणं पादमासीनं पङ्कजारुणम्॥ ११/३०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.034.m4a", "display_order": 35}, {"id": 6000331035, "chapter_id": 10331, "verse_number": "११-३०-३३", "content_sanskrit": "मुसलावशेषायःखण्डकृतेषुर्लुब्धको जरः।\nमृगाकारं तच्चरणं विव्याध मृगशङ्कया॥ ११/३०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.035.m4a", "display_order": 36, "topics": [{"text": "व्याधेन कृष्णं प्रति बाणप्रयोगः", "range": "३३"}]}, {"id": 6000331036, "chapter_id": 10331, "verse_number": "११-३०-३४", "content_sanskrit": "चतुर्भुजं तं पुरुषं दृष्ट्वा स कृतकिल्बिषः।\nभीतः पपात शिरसा पादयोरसुरद्विषः॥ ११/३०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.036.m4a", "display_order": 37}, {"id": 6000331037, "chapter_id": 10331, "verse_number": null, "content_sanskrit": "व्याध उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.037.m4a", "display_order": 38}, {"id": 6000331038, "chapter_id": 10331, "verse_number": "११-३०-३५", "content_sanskrit": "अजानता कृतमिदं पापेन मधुसूदन।\nक्षन्तुमर्हसि पापस्य उत्तमश्लोक मेऽनघ॥ ११/३०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.038.m4a", "display_order": 39, "topics": [{"text": "व्याधस्य क्षमापणम्", "range": "३५"}]}, {"id": 6000331039, "chapter_id": 10331, "verse_number": "११-३०-३६", "content_sanskrit": "यस्यानुस्मरणं नॄणामज्ञानध्वान्तनाशनम्।\nवदन्ति तस्य ते विष्णो मयाऽसाधु कृतं विभो॥ ११/३०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.039.m4a", "display_order": 40}, {"id": 6000331040, "chapter_id": 10331, "verse_number": "११-३०-३७", "content_sanskrit": "तमाशु जहि वैकुण्ठ पाप्मानं मृगलुब्धकम्।\nयथा पुनरहं त्वेवं न कुर्यां सदतिक्रमम्॥ ११/३०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.040.m4a", "display_order": 41}, {"id": 6000331041, "chapter_id": 10331, "verse_number": "११-३०-३८", "content_sanskrit": "यस्यात्मयोगरचितं न विदुर्विरिञ्चरुद्रादयोऽस्य तनयाः पतयो गिरां ये।\nत्वन्मायया विहतदृष्टय एतदञ्जः किं तस्य ते वयमसद्गतयो गृणीमः॥ ११/३०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.041.m4a", "display_order": 42}, {"id": 6000331042, "chapter_id": 10331, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.042.m4a", "display_order": 43}, {"id": 6000331043, "chapter_id": 10331, "verse_number": "११-३०-३९", "content_sanskrit": "मा भैर्जर त्वमुत्तिष्ठ काम एष कृतो हि मे।\nयाहि त्वं मदनुज्ञातः स्वर्गं सुकृतिनां पदम्॥ ११/३०/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.043.m4a", "display_order": 44, "topics": [{"text": "भगवदादेशः", "range": "३९"}]}, {"id": 6000331044, "chapter_id": 10331, "verse_number": null, "content_sanskrit": "श्री शुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.044.m4a", "display_order": 45}, {"id": 6000331045, "chapter_id": 10331, "verse_number": "११-३०-४०", "content_sanskrit": "इत्यादिष्टो भगवता कृष्णेनेच्छाशरीरिणा।\nत्रिः परिक्रम्य तं नत्वा विमानेन दिवं ययौ॥ ११/३०/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.045.m4a", "display_order": 46}, {"id": 6000331046, "chapter_id": 10331, "verse_number": "११-३०-४१", "content_sanskrit": "दारुकः कृष्णपदवीमन्विच्छन् नाधिगम्य तम् ।\nवायुं तुलसिकामोदमाघ्रायाभिमुखं ययौ॥ ११/३०/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.046.m4a", "display_order": 47, "topics": [{"text": "दारुकस्यागमनम्। तं प्रति आदेशः", "range": "४१–५०"}]}, {"id": 6000331047, "chapter_id": 10331, "verse_number": "११-३०-४२", "content_sanskrit": "तं तत्र तिग्मद्युतिमायुधैर्वृतं ह्यश्वत्थमूले कृतकेतनं पतिम् ।\nस्नेहप्लुतात्मा निपपात पादयो रथादवप्लुत्य सबाष्पलोचनः॥ ११/३०/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.047.m4a", "display_order": 48}, {"id": 6000331048, "chapter_id": 10331, "verse_number": null, "content_sanskrit": "दारुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.048.m4a", "display_order": 49}, {"id": 6000331049, "chapter_id": 10331, "verse_number": "११-३०-४३", "content_sanskrit": "अपश्यतस्ते चरणाम्बुजं प्रभो दृष्टिः प्रनष्टा तमसि प्रविष्टा।\nदिशो न जाने न लभे च शान्तिं यथा निशायामुडुपे प्रनष्टे॥ ११/३०/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.049.m4a", "display_order": 50}, {"id": 6000331050, "chapter_id": 10331, "verse_number": null, "content_sanskrit": "श्री शुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.050.m4a", "display_order": 51}, {"id": 6000331051, "chapter_id": 10331, "verse_number": "११-३०-४४", "content_sanskrit": "इति ब्रुवति सूते वै रथो गरुडलाञ्छनः।\nख उत्पपात राजेन्द्र साश्वध्वज उदीक्षितः॥ ११/३०/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.051.m4a", "display_order": 52}, {"id": 6000331052, "chapter_id": 10331, "verse_number": "११-३०-४५", "content_sanskrit": "तमन्वगच्छन् दिव्यानि विष्णुप्रहरणानि च।\nतेनातिविस्मितात्मानं सूतमाह जनार्दनः॥ ११/३०/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.052.m4a", "display_order": 53}, {"id": 6000331053, "chapter_id": 10331, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.053.m4a", "display_order": 54}, {"id": 6000331054, "chapter_id": 10331, "verse_number": "११-३०-४६", "content_sanskrit": "गच्छ द्वारवतीं सूत ज्ञातिनां निधनं मिथः।\nसङ्कर्षणस्य निर्याणं बन्धुभ्यो ब्रूहि मद्दशाम्॥ ११/३०/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.054.m4a", "display_order": 55}, {"id": 6000331055, "chapter_id": 10331, "verse_number": "११-३०-४७", "content_sanskrit": "द्वारकायां न च स्थेयं भवद्भिश्च स्वबन्धुभिः।\nमया त्यक्तां यदुपुरीं समुद्रः प्लावयिष्यति॥ ११/३०/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.055.m4a", "display_order": 56}, {"id": 6000331056, "chapter_id": 10331, "verse_number": "११-३०-४८", "content_sanskrit": "स्वं स्वं परिग्रहं सर्वे आदाय पितरौ च नः।\nअर्जुनेनान्विताः सर्वे इन्द्रप्रस्थं गमिष्यथ॥ ११/३०/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.056.m4a", "display_order": 57}, {"id": 6000331057, "chapter_id": 10331, "verse_number": "११-३०-४९", "content_sanskrit": "त्वं तु मद्धर्ममास्थाय ज्ञाननिष्ठ उपेक्षकः।\nमन्मायारचनामेतां विज्ञायोपशमं व्रज॥ ११/३०/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.057.m4a", "display_order": 58}, {"id": 6000331058, "chapter_id": 10331, "verse_number": null, "content_sanskrit": "श्री शुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.058.m4a", "display_order": 59}, {"id": 6000331059, "chapter_id": 10331, "verse_number": "११-३०-५०", "content_sanskrit": "इत्युक्तस्तं परिक्रम्य नमस्कृत्य पुनः पुनः।\nतत्पादौ शीर्ष्ण्युपाधाय दुर्मनाः प्रययौ पुरीम्॥ ११/३०/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_030/BhP_11.030.059.m4a", "display_order": 60}, {"id": 6000331060, "chapter_id": 10331, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे त्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]