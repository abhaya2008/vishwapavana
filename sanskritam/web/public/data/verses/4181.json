[{"id": 2147215, "chapter_id": 4181, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147216, "chapter_id": 4181, "verse_number": "१", "content_sanskrit": "ऋषभस्य ततः शृङ्गे निपत्य द्विजपक्षिणौ ।\nशाण्डिलीं ब्राह्मणीं तत्र ददृशाते तपोन्विताम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147217, "chapter_id": 4181, "verse_number": "२", "content_sanskrit": "अभिवाद्य सुपर्णस्तु गालवश्चाभिपूज्य ताम् ।\nतया च स्वागतेनोक्तौ विष्टरे सन्निषीदितुः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147218, "chapter_id": 4181, "verse_number": "३", "content_sanskrit": "सिद्धमन्नं तया क्षिप्रं बलिमन्त्रोपबृंहितम् ।\nभुक्त्वा तृप्तावुभौ भूमौ सुप्तौ चैव समाहितौ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147219, "chapter_id": 4181, "verse_number": "४", "content_sanskrit": "मुहूर्तात् प्रतिबुद्धस्तु सुपर्णो गमनेप्सया ।\nअथ भ्रष्टतनूजाङ्गमात्मानं ददृशे खगः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147220, "chapter_id": 4181, "verse_number": "५", "content_sanskrit": "मांसपिण्डोपमोऽभूत् स मुखपादान्वितः खगः ।\nगालवस्तं तथा दृष्ट्वा विषण्णः पर्यपृच्छत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147221, "chapter_id": 4181, "verse_number": "६", "content_sanskrit": "किमिदं भवता प्राप्तमिहागमनजं फलम् ।\nवासोऽयमिह कालं तु कियन्तं नो भविष्यति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147222, "chapter_id": 4181, "verse_number": "७", "content_sanskrit": "किं नु ते मनसा ध्यातमशुभं पततां वर ।\nन ह्ययं भवतः स्वल्पो व्यभिचारो भविष्यति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147223, "chapter_id": 4181, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147224, "chapter_id": 4181, "verse_number": "८", "content_sanskrit": "सुपर्णोऽथाब्रवीद् विप्रं प्रध्यातं वै मया द्विज ।\nइमां सिद्धामितो नेतुं तत्र यत्र प्रजापतिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147225, "chapter_id": 4181, "verse_number": "९", "content_sanskrit": "यत्र देवो महादेवो यत्र विष्णुः सनातनः ।\nयत्र धर्मश्च यज्ञश्च तत्रेयं निवसेदिति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147226, "chapter_id": 4181, "verse_number": "१०", "content_sanskrit": "सोऽहं भगवतीं याचे प्रणतः प्रियकाम्यया ।\nममैतन्नाम प्रध्यातं मनसा शोचता किल\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147227, "chapter_id": 4181, "verse_number": "११", "content_sanskrit": "तदेवं बहुमानं ते मयेहानीप्सितं कृतम् ।\nसुकृतं दुष्कृतं वा त्वं माहात्म्यात् क्षन्तुमर्हसि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147228, "chapter_id": 4181, "verse_number": "१२", "content_sanskrit": "सा तौ तदाऽब्रवीत् तुष्टा पतगेन्द्रद्विजर्षभौ\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147229, "chapter_id": 4181, "verse_number": "१३", "content_sanskrit": "न भेतव्यं सुपर्णोऽसि सुपर्ण त्यज सम्भ्रमम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147230, "chapter_id": 4181, "verse_number": "१४", "content_sanskrit": "निन्दिताऽस्मि त्वया वत्स न च निन्दां क्षमाम्यहम् ।\nलोकेभ्यः सपदि भ्रश्येद् यो मां निन्देत पापकृत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147231, "chapter_id": 4181, "verse_number": "१५", "content_sanskrit": "हीनया लक्षणैः सर्वैः तथा निन्दितया मया ।\nआचारं प्रतिगृह्णन्त्या सिद्धिः प्राप्तेयमुत्तमा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147232, "chapter_id": 4181, "verse_number": "१६", "content_sanskrit": "आचारलक्षणो धर्मो ह्याचाराल्लभते धनम् ।\nआचाराच्छ्रेय आप्नोति आचारो हन्त्यलक्षणम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147233, "chapter_id": 4181, "verse_number": "१७", "content_sanskrit": "तदायुष्मन् खगपते यथेष्टं गम्यतामितः ।\nन च ते गर्हणीयाऽस्मि गर्हितव्याः स्त्रियः क्वचित्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147234, "chapter_id": 4181, "verse_number": "१८", "content_sanskrit": "भवितासि यथा पूर्वं बलवीर्यसमन्वितः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147235, "chapter_id": 4181, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147236, "chapter_id": 4181, "verse_number": "१९", "content_sanskrit": "बभूवतुस्ततस्तस्य पक्षौ द्रवणवत्तरौ ।\nअनुज्ञातस्तु शाण्डिल्या यथागतमुपागमत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147237, "chapter_id": 4181, "verse_number": "२०", "content_sanskrit": "नैव चासादयामास तथारूपांस्तुरङ्गमान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147238, "chapter_id": 4181, "verse_number": "२१", "content_sanskrit": "विश्वामित्रोऽथ तं दृष्ट्वा गालवं चाध्वनि स्थितम् ।\nउवाच वदतां श्रेष्ठो वैनतेयस्य सन्निधौ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147239, "chapter_id": 4181, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147240, "chapter_id": 4181, "verse_number": "२२", "content_sanskrit": "यस्त्वया स्वयमेवार्थः प्रतिज्ञातो मम द्विज ।\nतस्य कालोऽपवर्गस्य यथा वा मन्यते भवान्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147241, "chapter_id": 4181, "verse_number": "२३", "content_sanskrit": "प्रतीक्षिष्याम्यहं कालमेतावन्तं तथा परम् ।\nयथा संसिध्यते विप्र स मार्गः प्रविमृश्यताम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2147242, "chapter_id": 4181, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2147243, "chapter_id": 4181, "verse_number": "२४", "content_sanskrit": "सुपर्णोऽथाब्रवीद् दीनं गालवं भृशदुःखितम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2147244, "chapter_id": 4181, "verse_number": "२५", "content_sanskrit": "प्रत्यक्षं खल्विदानीं मे विश्वामित्रो यदुक्तवान्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2147245, "chapter_id": 4181, "verse_number": "२६", "content_sanskrit": "तदागच्छ द्विजश्रेष्ठ मन्त्रयिष्याव गालव ।\nनादत्त्वा गुरवे शक्यं कृत्स्नमर्थं त्वयाऽऽसितुम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2147246, "chapter_id": 4181, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि द्वादशोत्तरशततमोऽध्यायः ॥११२॥ भगवद्यानपर्वणि त्रिचत्वारिंशोऽध्यायः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]