[{"id": 7004151000, "chapter_id": 24151, "verse_number": "४-१००-१", "content_sanskrit": "सूत उवाच ।\nइदं स्कांदमहं श्रुत्वा काशीखंडमनुत्तमम् ।\nनितरां परितृप्तोस्मि हृदि चापि विधारितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004151001, "chapter_id": 24151, "verse_number": "४-१००-२", "content_sanskrit": "अनुक्रमणिकाध्यायं तथा माहात्म्यमुत्तमम् ।\nपाराशर्य समाचक्ष्व यथापूर्वमिदं भवेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004151002, "chapter_id": 24151, "verse_number": "४-१००-३", "content_sanskrit": "व्यास उवाच ।\nसूतावधेहि धर्मात्मञ्जातूकर्ण्य निशामय ।\nशुकवैशंपायनाद्याः शृण्वंत्वपि च बालकाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004151003, "chapter_id": 24151, "verse_number": "४-१००-४", "content_sanskrit": "अनुक्रमणिकाध्यायं माहात्म्यं चापि खंडजम् ।\nप्रवक्ष्याम्यघनाशाय महापुण्यप्रवर्धनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004151004, "chapter_id": 24151, "verse_number": "४-१००-५", "content_sanskrit": "विंध्यनारदसंवादः प्रथमे परिकीर्तितः ।\nसत्यलोकप्रभावश्च द्वितीयः समुदाहृतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004151005, "chapter_id": 24151, "verse_number": "४-१००-६", "content_sanskrit": "अगस्तेराश्रमपदे देवानामागमस्ततः ।\nपतिव्रता चरित्रं च प्रस्थानं कुंभसंभवः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004151006, "chapter_id": 24151, "verse_number": "४-१००-७", "content_sanskrit": "तीर्थप्रशंसा च ततः सप्तपुर्यस्ततः स्मृताः ।\nसंयमिन्याः स्वरूपं च ब्रध्नलोकस्ततः परम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004151007, "chapter_id": 24151, "verse_number": "४-१००-८", "content_sanskrit": "इंद्राग्न्योर्लोकसंप्राप्तिस्ततश्च शिवशर्मणः ।\nअग्नेः समुद्भवस्तस्मात् क्रव्याद्वरुणसंभवः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004151008, "chapter_id": 24151, "verse_number": "४-१००-९", "content_sanskrit": "गंधवत्यलकापुर्योरीशयोस्तु समुद्भवः ।\nचंद्रलोकपरिप्राप्तिः शिवशर्मद्विजन्मनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004151009, "chapter_id": 24151, "verse_number": "४-१००-१०", "content_sanskrit": "उडुलोक कथा तस्मात्ततः शुक्रसमुद्भवः ।\nमाहेय गुरुसौरीणां लोकानां वर्णनं ततः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004151010, "chapter_id": 24151, "verse_number": "४-१००-११", "content_sanskrit": "सप्तर्षीणां ततो लोका ध्रुवस्य च तपस्ततः ।\nततो ध्रुवपदप्राप्तिर्ध्रुवलोक स्थितिस्ततः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004151011, "chapter_id": 24151, "verse_number": "४-१००-१२", "content_sanskrit": "दर्शनं सत्यलोकस्य तस्य वै शिवशर्मणः ।\nचतुर्भुजाभिषेकश्च निर्वाणं शिवशर्मणः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004151012, "chapter_id": 24151, "verse_number": "४-१००-१३", "content_sanskrit": "स्कंदागस्त्योश्च संवादो मणिकर्ण्याः समुद्भवः ।\nततस्तु गंगामाहात्म्यं ततो दशहरास्तवः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004151013, "chapter_id": 24151, "verse_number": "४-१००-१४", "content_sanskrit": "प्रभावश्चापि गंगाया गंगानामसहस्रकम् ।\nवाराणस्याः प्रशंसाथ भैरवाविर्भवस्ततः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004151014, "chapter_id": 24151, "verse_number": "४-१००-१५", "content_sanskrit": "दंडपाणेः समुद्भूतिर्ज्ञानवाप्युद्भवस्ततः ।\nआख्यानं च कलावत्याः सदाचारस्ततः परम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004151015, "chapter_id": 24151, "verse_number": "४-१००-१६", "content_sanskrit": "ब्रह्मचारि प्रकरणं ततः स्त्रीलक्षणानि च ।\nकृत्याकृत्यप्रकरणमविमुक्तेशवर्णनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004151016, "chapter_id": 24151, "verse_number": "४-१००-१७", "content_sanskrit": "ततो गृहस्थधर्माश्च ततो योगनिरूपणम् ।\nकालज्ञानं ततः प्रोक्तं दिवोदासस्य वर्णनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004151017, "chapter_id": 24151, "verse_number": "४-१००-१८", "content_sanskrit": "काश्याश्च वर्णनं तस्माद्योगिनीवर्णनं ततः ।\nलोलार्कस्य समाख्यानमुत्तरार्ककथा ततः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004151018, "chapter_id": 24151, "verse_number": "४-१००-१९", "content_sanskrit": "सांबादित्यस्य महिमा द्रुपदादित्य शंसनम् ।\nततस्तु गरुडाख्यानमरुणार्कादयस्ततः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004151019, "chapter_id": 24151, "verse_number": "४-१००-२०", "content_sanskrit": "दशाश्वमेधिकं तीर्थं मंदराच्च गणागमः ।\nपिशाचमोचनाख्यानं गणेशप्रेषणं ततः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004151020, "chapter_id": 24151, "verse_number": "४-१००-२१", "content_sanskrit": "मायागणपतेश्चाथ ढुंढिप्रादुर्भवस्ततः ।\nविष्णुमायाप्रपंचोथ दिवोदासविसर्जनम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004151021, "chapter_id": 24151, "verse_number": "४-१००-२२", "content_sanskrit": "ततः पंचनदोत्पत्तिर्बिंदुमाधवसंभवः ।\nततो वैष्णवतीर्थानां माहात्म्यपरिवर्णनम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004151022, "chapter_id": 24151, "verse_number": "४-१००-२३", "content_sanskrit": "प्रयाणं मंदरात्काशीं वृषभध्वजशूलिनः ।\nजैगीषव्येन संवादो ज्येष्ठस्थाने महेशितुः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004151023, "chapter_id": 24151, "verse_number": "४-१००-२४", "content_sanskrit": "ततः क्षेत्ररहस्यस्य कथनं पापनाशनम् ।\nअथातः कंदुकेशस्य व्याघ्रेशस्य समुद्भवः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004151024, "chapter_id": 24151, "verse_number": "४-१००-२५", "content_sanskrit": "ततः शैलेश्वरकथा रत्नेशस्य च दर्शनम् ।\nकृत्तिवासः समुत्पत्तिस्ततश्चायतनागमः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004151025, "chapter_id": 24151, "verse_number": "४-१००-२६", "content_sanskrit": "देवतानामधिष्ठानं दुर्गासुरपराक्रमः ।\nदुर्गाया विजयश्चाथ तत ओंकारवर्णनम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004151026, "chapter_id": 24151, "verse_number": "४-१००-२७", "content_sanskrit": "पुनरोंकारमाहात्म्यं त्रिलोचनसमुद्भवः ।\nत्रिलोचनप्रभावोथ केदाराख्यानमेव च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004151027, "chapter_id": 24151, "verse_number": "४-१००-२८", "content_sanskrit": "ततो धर्मेशमहिमा ततः पक्षिकथा शुभा ।\nततो विश्वभुजाख्यानं दुर्दमस्य कथा ततः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004151028, "chapter_id": 24151, "verse_number": "४-१००-२९", "content_sanskrit": "ततो वीरेश्वराख्यानं वीरेश महिमा पुनः ।\nगंगातीर्थैश्च संयुक्ता कामेश महिमा ततः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004151029, "chapter_id": 24151, "verse_number": "४-१००-३०", "content_sanskrit": "विश्वकर्मेश महिमा दक्षयज्ञसमुद्भवः ।\nसत्या देहविसर्गश्च ततो दक्षेश्वरोद्भवः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004151030, "chapter_id": 24151, "verse_number": "४-१००-३१", "content_sanskrit": "ततो वै पार्वतीशस्य महिम्नः परिकीर्तनम् ।\nगंगेशस्याथ महिमा नर्मदेशसमुद्भवः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004151031, "chapter_id": 24151, "verse_number": "४-१००-३२", "content_sanskrit": "सतीश्वरसमुत्पत्तिरमृतेशादि वणर्नम् ।\nव्यासस्य हि भुजस्तंभो व्यासशापविमोक्षणम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004151032, "chapter_id": 24151, "verse_number": "४-१००-३३", "content_sanskrit": "क्षेत्रतीर्थकदंबं च मुक्तिमंडप संकथा ।\nविश्वेशाविर्भवश्चाथ ततो यात्रापरिक्रमः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004151033, "chapter_id": 24151, "verse_number": "४-१००-३४", "content_sanskrit": "एतदाख्यानशतकं क्रमेण परिकीर्तितम् ।\nयस्य श्रवणमात्रेण सर्वखंड श्रुतेः फलम् ।\nअनुक्रमणिकाध्यायेप्यस्ति यात्रापरिक्रमः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004151034, "chapter_id": 24151, "verse_number": "४-१००-३५", "content_sanskrit": "सूत उवाच ।\nयात्रा परिक्रमं ब्रूहि जनानां हितकाम्यया ।\nयथावत्सिद्धिकामानां सत्यवत्याः सुतोत्तम ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004151035, "chapter_id": 24151, "verse_number": "४-१००-३६", "content_sanskrit": "व्यास उवाच ।\nनिशामय महाप्राज्ञ लोमहर्षण वच्मि ते ।\nयथा प्रथमतो यात्रा कर्तव्या यात्रिकैर्मुदा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004151036, "chapter_id": 24151, "verse_number": "४-१००-३७", "content_sanskrit": "सचैलमादौ संस्नाय चक्रपुष्करिणीजले ।\nसंतर्प्यदेवासपितॄन्ब्राह्मणांश्च तथार्थिनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004151037, "chapter_id": 24151, "verse_number": "४-१००-३८", "content_sanskrit": "आदित्यं द्रौपदीं विष्णुं दंडपाणिं महेश्वरम् ।\nनमस्कृत्य ततो गच्छेद्द्रष्टुं ढुंढिविनायकम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004151038, "chapter_id": 24151, "verse_number": "४-१००-३९", "content_sanskrit": "ज्ञानवापीमुपस्पृश्य नंदिकेशं ततोर्चयेत् ।\nतारकेशं ततोभ्यर्च्य महाकालेश्वरं ततः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004151039, "chapter_id": 24151, "verse_number": "४-१००-४०", "content_sanskrit": "ततः पुनर्दंडपाणिमित्येषा पंचतीर्थिका ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004151040, "chapter_id": 24151, "verse_number": "४-१००-४१", "content_sanskrit": "दैनंदिनी विधातव्या महाफलमभीप्सुभिः ।\nततो वैश्वेश्वरी यात्रा कार्या सर्वार्थ सिद्धिदा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004151041, "chapter_id": 24151, "verse_number": "४-१००-४२", "content_sanskrit": "द्विसप्तायतनानां च कार्या यात्रा प्रयत्नतः ।\nकृष्णां प्रतिपदं प्राप्य भूतावधि यथाविधि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004151042, "chapter_id": 24151, "verse_number": "४-१००-४३", "content_sanskrit": "अथवा प्रतिभूतं च क्षेत्रसिद्धिमभीप्सुभिः ।\nतत्तत्तीर्थकृतस्नानस्तत्तल्लिंगकृतार्चनः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004151043, "chapter_id": 24151, "verse_number": "४-१००-४४", "content_sanskrit": "मौनेन यात्रां कुर्वाणः फलं प्राप्नोति यात्रिकः ।\nओंकारं प्रथमं पश्येन्मत्स्योदर्यां कृतोदकः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004151044, "chapter_id": 24151, "verse_number": "४-१००-४५", "content_sanskrit": "त्रिविष्टपं महादेवं ततो वै कृत्तिवाससम् ।\nरत्नेशं चाथ चंद्रेशं केदारं च ततो व्रजेत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004151045, "chapter_id": 24151, "verse_number": "४-१००-४६", "content_sanskrit": "धर्मेश्वरं च वीरेशं गच्छेत्कामेश्वरं ततः ।\nविश्वकर्मेश्वरं चाथ मणिकर्णीश्वरं ततः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004151046, "chapter_id": 24151, "verse_number": "४-१००-४७", "content_sanskrit": "अविमुक्तेश्वरं दृष्ट्वा ततो विश्वेशमर्चयेत् ।\nएषा यात्रा प्रयत्नेन कर्तव्या क्षेत्रवासिना ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004151047, "chapter_id": 24151, "verse_number": "४-१००-४८", "content_sanskrit": "यस्तु क्षेत्रमुषित्वा तु नैतां यात्रां समाचरेत् ।\nविघ्नास्तस्योपतिष्ठंते क्षेत्रोच्चाटनसूचकाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004151048, "chapter_id": 24151, "verse_number": "४-१००-४९", "content_sanskrit": "अष्टायतन यात्रान्या कर्तव्या विघ्रशांतये ।\nदक्षेशः पार्वतीशश्च तथा पशुपतीश्वरः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004151049, "chapter_id": 24151, "verse_number": "४-१००-५०", "content_sanskrit": "गंगेशो नर्मदेशश्च गभस्तीशः सतीश्वरः ।\nअष्टमस्तारकेशश्च प्रत्यष्टमि विशेषतः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004151050, "chapter_id": 24151, "verse_number": "४-१००-५१", "content_sanskrit": "दृश्यान्येतानि लिंगानि महापापोपशांतये ।\nअपरापि शुभा यात्रा योगक्षेमकरी सदा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004151051, "chapter_id": 24151, "verse_number": "४-१००-५२", "content_sanskrit": "सर्वविघ्रोपहंत्री च कर्तव्या क्षेत्रवासिभिः ।\nशैलेशं प्रथमं वीक्ष्य वरणास्नानपूर्वकम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004151052, "chapter_id": 24151, "verse_number": "४-१००-५३", "content_sanskrit": "स्नानं तु संगमे कृत्वा द्रष्टव्यः संगमेश्वरः ।\nस्वलीन तीर्थे सुस्नातः पश्येत्स्वलीनमीश्वरम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004151053, "chapter_id": 24151, "verse_number": "४-१००-५४", "content_sanskrit": "स्नात्वा मंदाकिनी तीर्थे द्रष्टव्यो मध्यमेश्वरः ।\nपश्येद्धिरण्यगर्भेशं तत्र तीर्थे कृतोदकः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004151054, "chapter_id": 24151, "verse_number": "४-१००-५५", "content_sanskrit": "मणिकर्ण्यां ततः स्नात्वा पश्येदीशानमीश्वरम् ।\nततः कूपमुपस्पृश्य गोप्रेक्षमवलोकयेत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004151055, "chapter_id": 24151, "verse_number": "४-१००-५६", "content_sanskrit": "कापिलेय ह्रदे स्नात्वा वीक्षेत वृषभध्वजम् ।\nउपशांतशिवं पश्येत्तत्कूपविहितोदकः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004151056, "chapter_id": 24151, "verse_number": "४-१००-५७", "content_sanskrit": "पंचचूडाह्रदे स्नात्वा ज्येष्ठस्थानं ततोर्चयेत् ।\nचतुःसमुद्रकूपे तु स्नात्वा देवं समर्चयेत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004151057, "chapter_id": 24151, "verse_number": "४-१००-५८", "content_sanskrit": "देवस्याग्रे तु या वापी तत्रोपस्पर्शने कृते ।\nशुक्रेश्वरं ततः पश्येत्तत्कूपविहितोदकः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004151058, "chapter_id": 24151, "verse_number": "४-१००-५९", "content_sanskrit": "दंडखाते ततः स्नात्वा व्याघ्रेशं पूजयेत्ततः ।\nशौनकेश्वरकुंडे तु स्नानं कृत्वा ततोर्चयेत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004151059, "chapter_id": 24151, "verse_number": "४-१००-६०", "content_sanskrit": "जंबुकेशं महालिंगं कृत्वा यात्रामिमां नरः ।\nक्वचिन्न जायते भूयः संसारे दुःखसागरे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004151060, "chapter_id": 24151, "verse_number": "४-१००-६१", "content_sanskrit": "समारभ्य प्रतिपदं यावत्कृष्णा चतुर्दशी ।\nएतत्क्रमेण कर्तव्यान्ये तदायतनानि वै ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004151061, "chapter_id": 24151, "verse_number": "४-१००-६२", "content_sanskrit": "इमां यात्रां नरः कृत्वा न भूयोप्यभिजायते ।\nअन्या यात्रा प्रकर्तव्यैका दशायतनोद्भवा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004151062, "chapter_id": 24151, "verse_number": "४-१००-६३", "content_sanskrit": "आग्नीध्र कुंडे सुस्नातः पश्येदाग्नीध्रमीश्वरम् ।\nउर्वशीशं ततो गच्छेत्ततस्तु नकुलीश्वरम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004151063, "chapter_id": 24151, "verse_number": "४-१००-६४", "content_sanskrit": "आषाढीशं ततो दृष्ट्वा भारभूतेश्वरं ततः ।\nलांगलीशमथालोक्य ततस्तु त्रिपुरांतकम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004151064, "chapter_id": 24151, "verse_number": "४-१००-६५", "content_sanskrit": "ततो मनःप्रकामेशं प्रीतिकेशमथो व्रजेत् ।\nमदालसेश्वरं तस्मात्तिलपर्णेश्वरं ततः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004151065, "chapter_id": 24151, "verse_number": "४-१००-६६", "content_sanskrit": "यात्रैकादशलिंगानामेषा कार्या प्रयत्नतः ।\nइमां यात्रां प्रकुर्वाणो रुद्रत्वं प्राप्नुयान्नरः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004151066, "chapter_id": 24151, "verse_number": "४-१००-६७", "content_sanskrit": "अतः परं प्रवक्ष्यामि गारी यात्रामनुत्तमाम् ।\nशुक्लपक्षे तृतीयायां या यात्रा विष्वगृद्धिदा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004151067, "chapter_id": 24151, "verse_number": "४-१००-६८", "content_sanskrit": "गोप्रेक्षतीर्थे सुस्नाय मुखनिर्मालिकां व्रजेत् ।\nज्येष्ठावाप्यां नरः स्नात्वा ज्येष्ठागौरीं समर्चयेत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004151068, "chapter_id": 24151, "verse_number": "४-१००-६९", "content_sanskrit": "सौभाग्यगौरी संपूज्या ज्ञानवाप्यां कृतोदकैः ।\nततः शृंगारगौरीं च तत्रैव च कृतोदकः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004151069, "chapter_id": 24151, "verse_number": "४-१००-७०", "content_sanskrit": "स्नात्वा विशालगंगायां विशालाक्षीं ततो व्रजेत् ।\nसुस्नातो ललितातीर्थे ललितामर्चयेत्ततः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004151070, "chapter_id": 24151, "verse_number": "४-१००-७१", "content_sanskrit": "स्नात्वा भवानीतीर्थेथ भवानीं परिपूजयेत् ।\nमंगला च ततोभ्यर्च्या बिंदुतीर्थकृतोदकैः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004151071, "chapter_id": 24151, "verse_number": "४-१००-७२", "content_sanskrit": "ततो गच्छेन्महालक्ष्मीं स्थिरलक्ष्मीसमृद्धये ।\nइमां यात्रां नरः कृत्वा क्षेत्रेस्मिन्मुक्तिजन्मनि ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004151072, "chapter_id": 24151, "verse_number": "४-१००-७३", "content_sanskrit": "न दुःखैरभिभूयेत इहामुत्रापि कुत्रचित् ।\nकुर्यात्प्रतिचतुर्थीह यात्रां विघ्नेशितुः सदा ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004151073, "chapter_id": 24151, "verse_number": "४-१००-७४", "content_sanskrit": "ब्राह्मणेभ्यस्तदुद्देशाद्देया वै मोदका मुदे ।\nभौमे भैरवयात्रा च कार्या पातकहारिणी ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004151074, "chapter_id": 24151, "verse_number": "४-१००-७५", "content_sanskrit": "रविवारे रवेर्यात्रा षष्ठ्यां वारविसंयुजि ।\nतथैव रविसप्तम्यां सर्वविघ्नोपशांतये ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004151075, "chapter_id": 24151, "verse_number": "४-१००-७६", "content_sanskrit": "नवम्यामथवाष्टम्यां चंडीयात्रा शुभा मता ।\nअंतर्गृहस्य वै यात्रा कर्तव्या प्रतिवासरम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004151076, "chapter_id": 24151, "verse_number": "४-१००-७७", "content_sanskrit": "प्रातःस्नानं विधायादौ नत्वा पंचविनायकान् ।\nनमस्कृत्वाथ विश्वेशं स्थित्वा निर्वाणमंडपे ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004151077, "chapter_id": 24151, "verse_number": "४-१००-७८", "content_sanskrit": "अंतर्गृहस्य यात्रा वै करिष्ये घौघशांतये ।\nगृहीत्वा नियमं चेति गत्वाथ मणिकर्णिकाम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004151078, "chapter_id": 24151, "verse_number": "४-१००-७९", "content_sanskrit": "स्नात्वा मौनेन चागत्य मणिकर्णीशमर्चयेत् ।\nकंबलाश्वतरौ नत्वा वासुकीशं प्रणम्य च ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004151079, "chapter_id": 24151, "verse_number": "४-१००-८०", "content_sanskrit": "पर्वतेशं ततो दृष्ट्वा गंगाकेशवमप्यथ ।\nततस्तु ललितां दृष्ट्वा जरासंधेश्वरं ततः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004151080, "chapter_id": 24151, "verse_number": "४-१००-८१", "content_sanskrit": "ततो वै सोमनाथं च वाराहं च ततो व्रजेत् ।\nब्रह्मेश्वरं ततो नत्वा नत्वागस्तीश्वरं ततः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004151081, "chapter_id": 24151, "verse_number": "४-१००-८२", "content_sanskrit": "कश्यपेशं नमस्कृत्य हरिकेशवनं ततः ।\nवैद्यनाथं ततो दृष्ट्वा ध्रुवेशमथ वीक्ष्य च ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004151082, "chapter_id": 24151, "verse_number": "४-१००-८३", "content_sanskrit": "गोकर्णेश्वरमभ्यर्च्य हाटकेशमथो व्रजेत् ।\nअस्थिक्षेप तडागे च दृष्ट्वा वै कीकसेश्वरम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004151083, "chapter_id": 24151, "verse_number": "४-१००-८४", "content_sanskrit": "भारभूतं ततो नत्वा चित्रेगुप्तेश्वरं ततः ।\nचित्रघंटां प्रणम्याथ ततः पशुपतीश्वरम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004151084, "chapter_id": 24151, "verse_number": "४-१००-८५", "content_sanskrit": "पितामहेश्वरं गत्वा ततस्तु कलशेश्वरम् ।\nचंद्रेशस्त्वथ वीरेशो विद्येशोग्नीश एव च ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004151085, "chapter_id": 24151, "verse_number": "४-१००-८६", "content_sanskrit": "नागेश्वरो हरिश्चंद्रश्चिंतामणिविनायकः ।\nसेनाविनायकश्चाथ द्रष्टव्यः सर्वविघ्नहृत् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004151086, "chapter_id": 24151, "verse_number": "४-१००-८७", "content_sanskrit": "वसिष्ठवामदेवौ च मूर्तिरूपधरावुभौ ।\nद्रष्टव्यौ यत्नतः काश्यां महाविघ्नविनाशिनौ ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004151087, "chapter_id": 24151, "verse_number": "४-१००-८८", "content_sanskrit": "सीमाविनायकं चाथ करुणेशं ततो व्रजेत् ।\nत्रिसंध्येशो विशालाक्षी धर्मेशो विश्वबाहुका ।\nआशाविनायकश्चाथ वृद्धादित्यस्ततः पुनः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004151088, "chapter_id": 24151, "verse_number": "४-१००-८९", "content_sanskrit": "चतुर्वक्त्रेश्वरं लिंगं ब्राह्मीशस्तु ततः परः ।\nततो मनःप्रकामेश ईशानेशस्ततः परम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004151089, "chapter_id": 24151, "verse_number": "४-१००-९०", "content_sanskrit": "चंडीचंडीश्वरौ दृश्यौ भवानीशंकरौ ततः ।\nढुंढिं प्रणम्य च ततो राजराजेशमर्चयेत् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004151090, "chapter_id": 24151, "verse_number": "४-१००-९१", "content_sanskrit": "लांगलीशस्ततोभ्यर्च्यस्ततस्तु नकुलीश्वरः ।\nपरान्नेशमथो नत्वा परद्रव्येश्वरं ततः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004151091, "chapter_id": 24151, "verse_number": "४-१००-९२", "content_sanskrit": "प्रतिग्रहेश्वरं वापि निष्कलंकेशमेव च ।\nमार्कंडेयेशमभ्यर्च्य ततश्चाप्सरसेश्वरम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004151092, "chapter_id": 24151, "verse_number": "४-१००-९३", "content_sanskrit": "गंगेशोर्च्यस्ततो ज्ञानवाप्यां स्नानं समाचरेत् ।\nनंदिकेशं तारकेशं महाकालेश्वरं ततः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004151093, "chapter_id": 24151, "verse_number": "४-१००-९४", "content_sanskrit": "दंडपाणिं महेशं च मोक्षेशं प्रणमेत्ततः ।\nवीरभद्रेश्वरं नत्वा अविमुक्तेश्वरं ततः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004151094, "chapter_id": 24151, "verse_number": "४-१००-९५", "content_sanskrit": "विनायकांस्ततः पंच विश्वनाथं ततो व्रजेत् ।\nततो मौनं विसृज्याथ मंत्रमेतमुदीरयेत् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004151095, "chapter_id": 24151, "verse_number": "४-१००-९६", "content_sanskrit": "अंतर्गृहस्य यात्रेयं यथावद्या मया कृता ।\nन्यूनातिरिक्तया शंभुः प्रीयतामनया विभुः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004151096, "chapter_id": 24151, "verse_number": "४-१००-९७", "content_sanskrit": "इति मंत्रं समुच्चार्य क्षणं वै मुक्तिमंडपे ।\nविश्रम्य यायाद्भवनं निष्पापः पुण्यवान्नरः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004151097, "chapter_id": 24151, "verse_number": "४-१००-९८", "content_sanskrit": "संप्राप्य वासरं विष्णोर्विष्णुतीर्थेषु सर्वतः ।\nकार्या यात्रा प्रयत्नेन महापुण्य समृद्धये ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004151098, "chapter_id": 24151, "verse_number": "४-१००-९९", "content_sanskrit": "नभस्य पंचदश्यां च कुलस्तंभं समर्चयेत् ।\nदुःखं रुद्रपिशाचत्वं न भवेद्यस्य पूजनात् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004151099, "chapter_id": 24151, "verse_number": "४-१००-१००", "content_sanskrit": "श्रद्धापूर्वमिमा यात्रा कर्तव्याः क्षेत्रवासिभिः ।\nपर्वस्वपि विशेषेण कार्या यात्राश्च सर्वतः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004151100, "chapter_id": 24151, "verse_number": "४-१००-१०१", "content_sanskrit": "न वंध्यं दिवसं कुर्याद्विनायात्रां क्वचित्कृती ।\nयात्राद्वयं प्रयत्नेन कर्तव्यं प्रतिवासरम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004151101, "chapter_id": 24151, "verse_number": "४-१००-१०२", "content_sanskrit": "आदौ स्वर्गतरंगिण्यास्ततो विश्वेशितुर्ध्रुवम् ।\nयस्य वंध्यं दिनं यातं काश्यां निवसतः सतः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004151102, "chapter_id": 24151, "verse_number": "४-१००-१०३", "content_sanskrit": "निराशाः पितरस्तस्य तस्मिन्नेव दिनेऽभवन् ।\nस दष्टः कालसर्पेण स दृष्टो मृत्युना स्फुटम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004151103, "chapter_id": 24151, "verse_number": "४-१००-१०४", "content_sanskrit": "स मुष्टस्तत्र दिवसे विश्वेशो यत्र नेक्षितः ।\nसर्वतीर्थेषु सस्नौ स सर्वयात्रां व्यधात्स च ।\nमणिकर्ण्यां तु यः स्नातो यो विश्वेशं निरैक्षत ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004151104, "chapter_id": 24151, "verse_number": "४-१००-१०५", "content_sanskrit": "सत्यं सत्यं पुनः सत्यं सत्यं सत्यं पुनःपुनः ।\nदृश्यो विश्वेश्वरो नित्यं स्नातव्या मणिकर्णिका ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004151105, "chapter_id": 24151, "verse_number": "४-१००-१०६", "content_sanskrit": "व्यास उवाच ।\nसूत स्कांदमिदं श्रुत्वा काशीमाहात्म्यमुत्तमम् ।\nनरो न निरयं याति कृत्वाप्यघसहस्रकम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004151106, "chapter_id": 24151, "verse_number": "४-१००-१०७", "content_sanskrit": "स्नात्वा सर्वाणि तीर्थानि यच्छ्रेयः समुपार्ज्यते ।\nकाशीखंडस्य श्रवणात्तत्स्यात्सूत न संशयः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004151107, "chapter_id": 24151, "verse_number": "४-१००-१०८", "content_sanskrit": "दत्त्वा दानानि सर्वाणि कृत्वा यज्ञाननेकशः ।\nतत्पुण्यं लभते मर्त्यस्तदा तच्छ्रवणाद्ध्रुवम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004151108, "chapter_id": 24151, "verse_number": "४-१००-१०९", "content_sanskrit": "तप्त्वा तपांसि चोग्राणि प्राप्यते यन्महत्फलम् ।\nश्रवणादस्य खंडस्य लभते तन्न संशयः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004151109, "chapter_id": 24151, "verse_number": "४-१००-११०", "content_sanskrit": "अधीत्य चतुरो वेदान्सांगान्यत्फलमाप्यते ।\nकाशीखंडं समाकर्ण्य तत्फलं लभ्यते नरैः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004151110, "chapter_id": 24151, "verse_number": "४-१००-१११", "content_sanskrit": "गययां श्राद्धदानाच्च यथा तृप्यंति पूर्वजाः ।\nतथैतच्छ्रवणान्नृणां तृप्नुवंति पितामहाः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004151111, "chapter_id": 24151, "verse_number": "४-१००-११२", "content_sanskrit": "तैश्च सर्वपुराणानि श्रुतानि स्थिरबुद्धिभिः ।\nकाशीखंडं श्रुतं यैश्च सर्वेषां श्रेयसां पदम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004151112, "chapter_id": 24151, "verse_number": "४-१००-११३", "content_sanskrit": "श्रुताश्च सर्वधर्मास्तैर्महापुण्येकराशिभिः ।\nश्रुतं यैः स्थिरचेतोभिः काशीमाहात्म्यमुत्तमम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004151113, "chapter_id": 24151, "verse_number": "४-१००-११४", "content_sanskrit": "इदमेव हि देवेज्या परमा परिकीर्तिता ।\nजपेत्तत्खंडमखिलं श्रोतव्यं श्रद्धया द्विजाः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004151114, "chapter_id": 24151, "verse_number": "४-१००-११५", "content_sanskrit": "शृणुयादेकमपि य आख्यानं काशिखंडजम् ।\nश्रुतानि तेन सर्वाणि धर्मशास्त्राण्यसंशयम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004151115, "chapter_id": 24151, "verse_number": "४-१००-११६", "content_sanskrit": "महाधर्मैकजननं महार्थप्रतिपादकम् ।\nकारणं सर्वकामाप्तेः काशीखंडमिदं स्मृतम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004151116, "chapter_id": 24151, "verse_number": "४-१००-११७", "content_sanskrit": "एतच्छ्रवणतः पुंसां कैवल्यं नैव दूरतः ।\nतुष्यंति सर्वे पितरः श्रुत्वैतत्खंडमुत्तमम् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004151117, "chapter_id": 24151, "verse_number": "४-१००-११८", "content_sanskrit": "प्रीणंत्यमर्त्याः सर्वेपि ब्रह्मविष्णुशिवादयः ।\nमुनयः परिमोदंते माद्यंति सनकादयः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004151118, "chapter_id": 24151, "verse_number": "४-१००-११९", "content_sanskrit": "हृष्टः सर्वो भवेदेव भूतग्रामश्चतुर्विधः ।\nमहिमश्रवणादस्माद्वाराणस्या न संशयः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004151119, "chapter_id": 24151, "verse_number": "४-१००-१२०", "content_sanskrit": "य इदं श्रावयेद्विद्वान्समस्तं त्वर्धमेव वा ।\nपादमात्रं तदर्धं वा त्वेकं व्याख्यानमुत्तमम् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004151120, "chapter_id": 24151, "verse_number": "४-१००-१२१", "content_sanskrit": "स नमस्यः प्रयत्नेन संपूज्यस्त्विष्टदेववत् ।\nतस्मै देयं प्रयत्नेन विश्वेश प्रीतये सदा ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004151121, "chapter_id": 24151, "verse_number": "४-१००-१२२", "content_sanskrit": "तस्मिंस्तुष्टे हि संतुष्टो विश्वेशो नात्र संशयः ।\nयत्रैतत्पठ्यते खंडं परानंदसमाश्रयम् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004151122, "chapter_id": 24151, "verse_number": "४-१००-१२३", "content_sanskrit": "न तत्र प्रभवेत्कश्चिदमंगलसमुद्भवः ।\nय इदं शृणुयाद्विद्वान्यश्चेदं श्रावयेत्सुधीः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004151123, "chapter_id": 24151, "verse_number": "४-१००-१२४", "content_sanskrit": "यः पठेदपि पुण्यात्मा ते सर्वे रुद्रमूर्तयः ।\nय एतत्पुस्तकं रम्यं लेखयित्वा समर्पयेत् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004151124, "chapter_id": 24151, "verse_number": "४-१००-१२५", "content_sanskrit": "अखिलानि पुराणानि तेन दत्तानि नान्यथा ।\nअत्राख्यानानि यावंति श्लोका यावंत एव हि ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004151125, "chapter_id": 24151, "verse_number": "४-१००-१२६", "content_sanskrit": "तथा पदानि यावंति वर्णा यावंत एव हि ।\nयावंत्यपि च मात्राणि यावंत्यः पदपंक्तयः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004151126, "chapter_id": 24151, "verse_number": "४-१००-१२७", "content_sanskrit": "गुणे सूत्राणि यावंति यावंतः पटतंतवः ।\nचित्ररूपाणि यावंति रम्यपुस्तकसंचके ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7004151127, "chapter_id": 24151, "verse_number": "४-१००-१२८", "content_sanskrit": "तावद्युगसहस्राणि दाता स्वर्गे महीयते ।\nएतद्द्वादशकृत्वो यः शृणुयात्खंडमुत्तमम् ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7004151128, "chapter_id": 24151, "verse_number": "४-१००-१२९", "content_sanskrit": "ब्रह्महत्यापि तस्याशु नश्येच्छंभोरनुग्रहात् ।\nअपुत्रः शृणुयाद्यस्तु सुस्नातः श्रद्धयान्वितः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7004151129, "chapter_id": 24151, "verse_number": "४-१००-१३०", "content_sanskrit": "तस्य पुत्रो भवत्येव शंभोराज्ञा प्रभावतः ।\nकिं बहूक्तेन सूतेह यस्य यस्य मनोरथः ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7004151130, "chapter_id": 24151, "verse_number": "४-१००-१३१", "content_sanskrit": "यो यस्तं तं स ससदा श्रुत्वैतत्प्राप्नुयात्कृती ।\nशृणुयाद्दूरदेशेपि यः काशीखंडमुत्तमम् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7004151131, "chapter_id": 24151, "verse_number": "४-१००-१३२", "content_sanskrit": "स काशीवासपुण्यस्य भाजनं स्याच्छिवाज्ञया ।\nएतच्छ्रवणतः पुंसां सर्वत्र विजयो भवेत् ।\nसौभाग्यं चापि सर्वत्र प्राप्नुयान्निर्मलाशयः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7004151132, "chapter_id": 24151, "verse_number": "४-१००-१३३", "content_sanskrit": "यस्य विश्वेश्वरस्तुष्टस्तस्यैतच्छ्रवणे मतिः ।\nजायते पुण्ययुक्तस्य महानिर्मलचेतसः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7004151133, "chapter_id": 24151, "verse_number": "४-१००-१३४", "content_sanskrit": "सर्वेषां मंगलानां च महामंगलमुत्तमम् ।\nगृहेपि लिखितं पूज्यं सर्वमंगलसिद्धये ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7004151134, "chapter_id": 24151, "verse_number": "४-१००-१३५", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीति साहस्र्यां संहितायां चतुर्थे काशीखंड उत्तरार्धेऽनुक्रमणिकानाम शततमोऽध्यायः  ॥ श्रीकाशीखण्डोत्तरार्धं सम्पूर्णम्  ।\nसमाप्तं चेदं चतुर्थं काशीखंडम् ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}]