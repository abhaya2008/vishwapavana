[{"id": 2041528, "chapter_id": 1922, "verse_number": "५-१६७-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041529, "chapter_id": 1922, "verse_number": "५-१६७-१", "content_sanskrit": "शकुनिर्मातुलस्तेऽसौ रथ एको नराधिप।\nप्रयुज्य पाण्डवैर्वैरं योत्स्यते नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041530, "chapter_id": 1922, "verse_number": "५-१६७-२", "content_sanskrit": "एतस्य सेना दुर्धर्षा समरे प्रतियायिनः।\nविकृतायुधभूयिष्ठा वायुवेगसमा जवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041531, "chapter_id": 1922, "verse_number": "५-१६७-३", "content_sanskrit": "द्रोणपुत्रो महेष्वासः सर्वानेवातिधन्विनः ।\nसमरे चित्रयोधी च दृढास्त्रश्च महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041532, "chapter_id": 1922, "verse_number": "५-१६७-४", "content_sanskrit": "एतस्य हि महाराज यथा गाण्डीवधन्वनः।\nशरासनविनिर्मुक्ताः संसक्ता यान्ति सायकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041533, "chapter_id": 1922, "verse_number": "५-१६७-५", "content_sanskrit": "नैष शक्यो मया वीरः संख्यातुं रथसत्तमः ।\nनिर्दहेदपि लोकांस्त्रीनिच्छन्नेष महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041534, "chapter_id": 1922, "verse_number": "५-१६७-६", "content_sanskrit": "क्रोधस्तेजश्च तपसा संभृतोश्रमवासिनाम् ।\nद्रोणेनानुगृहीतश्च दिव्यैरस्त्रैरुदारधीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041535, "chapter_id": 1922, "verse_number": "५-१६७-७", "content_sanskrit": "दोषस्त्वस्य महानेको येनैव भरतर्षभ ।\nन मे रथो नातिरथो मतः पार्थिवसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041536, "chapter_id": 1922, "verse_number": "५-१६७-८", "content_sanskrit": "जीवितं प्रियमत्यर्थमायुष्कामः सदा द्विजः ।\nन ह्यस्य सदृशः कश्चिदुभयोः सेनयोरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041537, "chapter_id": 1922, "verse_number": "५-१६७-९", "content_sanskrit": "हन्यादेकरथेनैव देवानामपि वाहिनीम् ।\nवपुष्मांस्तलघोषेण स्फोटयेदपि पर्वतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041538, "chapter_id": 1922, "verse_number": "५-१६७-१०", "content_sanskrit": "असंख्येयगुणो वीरः प्रहन्ता दारुणद्युतिः।\nदण्डपाणिरिवासह्यः कालवत्प्रचरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041539, "chapter_id": 1922, "verse_number": "५-१६७-११", "content_sanskrit": "युगान्ताग्निसमः क्रोधात्सिंहग्रीवो महाद्युतिः ।\nएष भारत युद्धस्य पृष्ठं संशयमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041540, "chapter_id": 1922, "verse_number": "५-१६७-१२", "content_sanskrit": "पिता त्वस्य महातेजा वृद्धोऽपि युवभिर्वरः ।\nरणे कर्म महत्कर्ता अत्र मे नास्ति संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041541, "chapter_id": 1922, "verse_number": "५-१६७-१३", "content_sanskrit": "अस्त्रवेगानिलोद्भूतः सेनाकक्षेन्धनोत्थितः ।\nपाण्डुपुत्रस्य सैन्यानि प्रधक्ष्यति रणे धृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041542, "chapter_id": 1922, "verse_number": "५-१६७-१४", "content_sanskrit": "रथयूथपयूथानां यूथपोऽय नरर्षभः ।\nभरद्वाजात्मजः कर्ता कर्म तीव्रं हितं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041543, "chapter_id": 1922, "verse_number": "५-१६७-१५", "content_sanskrit": "सर्वमूर्धाभिषिक्तानामाचार्यः स्थविरो गुरुः ।\nगच्छेदन्तं सृञ्जयानां प्रियस्त्वस्य धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041544, "chapter_id": 1922, "verse_number": "५-१६७-१६", "content_sanskrit": "नैष जातु महेष्वासः पार्थमक्लिष्टकारिणम् ।\nहन्यादाचार्यकं दीप्तं संस्मृत्य गुणनिर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041545, "chapter_id": 1922, "verse_number": "५-१६७-१७", "content_sanskrit": "श्लाघते यं सदा वीर पार्थस्य गुणविस्तरैः ।\nपुत्रादभ्यधिकं चैनं भारद्वाजोऽनुपश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041546, "chapter_id": 1922, "verse_number": "५-१६७-१८", "content_sanskrit": "हन्यादेकरथेनैव देवगन्धर्वमानुषान् ।\nएकीभूतानपि रणे दिव्यैरस्त्रैः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041547, "chapter_id": 1922, "verse_number": "५-१६७-१९", "content_sanskrit": "पौरवो राजशार्दूलस्तव राजन्महारथः ।\nमतो मम रथोदारः परवीररथारुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041548, "chapter_id": 1922, "verse_number": "५-१६७-२०", "content_sanskrit": "स्वेन सैन्येन महता प्रतपञ्शत्रुवाहिनीम्।\nप्रधक्ष्यति स पाञ्चालान्कक्षमग्निगतिर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041549, "chapter_id": 1922, "verse_number": "५-१६७-२१", "content_sanskrit": "सत्यश्रवा रथस्त्वेको राजपुत्रो बृहद्बलः।\nतव राजन्रिपुबले कालवत्प्रचरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041550, "chapter_id": 1922, "verse_number": "५-१६७-२२", "content_sanskrit": "एतस्य योधा राजेन्द्र विचित्रकवचायुधाः ।\nविचरिष्यन्ति सङ्ग्रामे निन्घन्तः शास्त्रवांस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2041551, "chapter_id": 1922, "verse_number": "५-१६७-२३", "content_sanskrit": "वृषसेनो रथस्तेऽग्र्यः कर्णपुत्रो महारथः ।\nप्रधक्ष्यति रिपूणां ते बलं तु बलिनां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2041552, "chapter_id": 1922, "verse_number": "५-१६७-२४", "content_sanskrit": "जघसन्धो महातेजा राजन्रथवरस्तव ।\nत्यक्ष्यते समरे प्राणान्माधवः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2041553, "chapter_id": 1922, "verse_number": "५-१६७-२५", "content_sanskrit": "एष योत्स्यति सङ्ग्रामे गजस्कन्धविशारदः ।\nरथेन वा माहबाहुः क्षपयञ्शत्रुवाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2041554, "chapter_id": 1922, "verse_number": "५-१६७-२६", "content_sanskrit": "रथ एष महाराज मतो मे राजसत्तम।\nत्वदर्थे त्यक्ष्यते प्राणान्सहसैन्यो महारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2041555, "chapter_id": 1922, "verse_number": "५-१६७-२७", "content_sanskrit": "एष विक्रान्तयोधी च चित्रयोधी च संगरे ।\nवीतभीश्चापि ते राजञ्शत्रुभिः सह योत्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2041556, "chapter_id": 1922, "verse_number": "५-१६७-२८", "content_sanskrit": "बाह्लीकोऽतिरथश्चैव समरे चानिवर्तनः ।\nमम राजन्मतो युद्धे शूरो वैवस्वतोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2041557, "chapter_id": 1922, "verse_number": "५-१६७-२९", "content_sanskrit": "न ह्येष समरं प्राप्य निवर्तेत कथञ्चन।\nयथा सततगो राजन्स हि हन्यात्परान्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2041558, "chapter_id": 1922, "verse_number": "५-१६७-३०", "content_sanskrit": "सेनापतिर्महाराज सत्यवांस्ते महारथः ।\nरणेष्वद्भुतकर्मा च रथी पररथारुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2041559, "chapter_id": 1922, "verse_number": "५-१६७-३१", "content_sanskrit": "एतस्य समरं दृष्ट्वा न व्यथास्ति कथञ्चन ।\nउत्स्मयन्नुत्पतत्येष परान्रथपथे स्थितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2041560, "chapter_id": 1922, "verse_number": "५-१६७-३२", "content_sanskrit": "एष चारिषु विक्रान्तः कर्म सत्पुरुषोचितम् ।\nकर्ता विमर्दे सुमहत्त्वदर्थे पुरुषोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2041561, "chapter_id": 1922, "verse_number": "५-१६७-३३", "content_sanskrit": "अलम्बुसो राक्षसेन्द्रः क्रूरकर्मा महारथः ।\nहनिष्यति परान्राजन्पूर्ववैरमनुस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2041562, "chapter_id": 1922, "verse_number": "५-१६७-३४", "content_sanskrit": "एष राक्षससैन्यानं सर्वेषां रथसत्तमः ।\nमायावी दृढवैरश्च समरे विचरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2041563, "chapter_id": 1922, "verse_number": "५-१६७-३५", "content_sanskrit": "प्राग्ज्योतिषाधिपो वीरो भगदत्तः प्रतापवान् ।\nगजाङ्कुशधरश्रेष्ठो रथे चैव विशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2041564, "chapter_id": 1922, "verse_number": "५-१६७-३६", "content_sanskrit": "एतेन युद्धमभवत्पुरा गाण्डीवधन्वनः ।\nदिवसान्सुबहून्राजन्नुभयोर्जयगृद्धिनोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2041565, "chapter_id": 1922, "verse_number": "५-१६७-३७", "content_sanskrit": "ततः सखायं गान्धारे मानयन्पाकशासनम् ।\nअकरोत्संविदं तेन पाण्डवेन महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2041566, "chapter_id": 1922, "verse_number": "५-१६७-३८", "content_sanskrit": "एष योत्स्यति सङ्ग्रामे गजस्कन्धविशारदः ।\nऐरावतगतो राजा देवानामिव वासवः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2041567, "chapter_id": 1922, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि रथातिरथसंख्यानपर्वणि सप्तषष्ट्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]