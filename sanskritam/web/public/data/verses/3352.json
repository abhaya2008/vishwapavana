[{"id": 2108577, "chapter_id": 3352, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108578, "chapter_id": 3352, "verse_number": "१", "content_sanskrit": "एते वै भुजगास्तात वीर्यवन्तो दुरासदाः ।\nशापं तं त्वमविज्ञाय कृतवन्तो नु किं परम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108579, "chapter_id": 3352, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108580, "chapter_id": 3352, "verse_number": "२", "content_sanskrit": "तेषां तु भगवान् शेषस्त्यक्त्वा सर्वान् महायशाः ।\nतपो विपुलमातस्थे वायुभक्षो जितेन्द्रियः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108581, "chapter_id": 3352, "verse_number": "३", "content_sanskrit": "गन्धमादनमासाद्य बदर्यां च तपोरतः ।\nदशार्णे पुष्करारण्ये तथा हिमवतस्तटे \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108582, "chapter_id": 3352, "verse_number": "४", "content_sanskrit": "तेषु तेषु च पुण्येषु तीर्थेष्वायतनेषु च ।\nएकान्तशीलो नियतः सततं विजितेन्द्रियः\t ॥ ४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108583, "chapter_id": 3352, "verse_number": "५", "content_sanskrit": "तप्यमानं तपो घोरं तं ददर्श पितामहः ।\nपरिशुष्कमांसत्वक्स्नायुं जटाचीरधरं प्रभुः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108584, "chapter_id": 3352, "verse_number": "६", "content_sanskrit": "तमब्रवीत्सत्यधृतिं तप्यमानं पितामहः\nकिमिदं कुरुषे शेष प्रजानां स्वस्ति वै कुरु \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108585, "chapter_id": 3352, "verse_number": "७", "content_sanskrit": "त्वं हि तीव्रेण तपसा प्रजास्तापयसेऽनघ ।\nब्रूहि कामं च मे शेष यत्ते हृदि चिरस्थितम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108586, "chapter_id": 3352, "verse_number": "", "content_sanskrit": "शेषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108587, "chapter_id": 3352, "verse_number": "८", "content_sanskrit": "सोदर्या मम सर्वे हि भ्रातरो मन्दचेतसः ।\nसह तैर्नोत्सहे वस्तुं तद्भवाननुमन्यताम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108588, "chapter_id": 3352, "verse_number": "९", "content_sanskrit": "अभ्यसूयन्ति सततं परस्परममित्रवत् ।\nततोऽहं तप आतिष्ठे नैतान् पश्येयमित्युत\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108589, "chapter_id": 3352, "verse_number": "१०", "content_sanskrit": "अमर्षयन्ति सततं ससुतां विनतां च ते  ।\nअस्माकं चापरो भ्राता वैनतेयः पितामह\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108590, "chapter_id": 3352, "verse_number": "११", "content_sanskrit": "तं च द्विषन्ति चात्यर्थं स चापि सुमहाबलः ।\nवरप्रदानात् स्वपितुः काश्यपस्य महात्मनः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108591, "chapter_id": 3352, "verse_number": "१२", "content_sanskrit": "सोऽहं तपः समास्थाय मोक्ष्यामीदं कळेबरम् ।\nकथं मे प्रेत्यभावेऽपि तैर्न स्यात् सह सङ्गमः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108592, "chapter_id": 3352, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108593, "chapter_id": 3352, "verse_number": "१३", "content_sanskrit": "जानामि शेष सर्वेषां भ्रातॄणां ते विचेष्टितम् ।\nमातुश्चाप्यपराधाद्वै भ्रातॄणां ते महद्भयम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108594, "chapter_id": 3352, "verse_number": "१४", "content_sanskrit": "कृतोऽत्र परिहारश्च पूर्वमेव भुजङ्गम ।\nभ्रातॄणां तव सर्वेषां सुवृत्तानां विमोक्षणम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108595, "chapter_id": 3352, "verse_number": "१५", "content_sanskrit": "शापात् तस्मान्महाघोरात् मुक्तात्मा त्वं महाबल ।\nवृणीष्व च वरं मत्तः शेष यत्तेऽभिकाङ्क्षितम्\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108596, "chapter_id": 3352, "verse_number": "१६", "content_sanskrit": "दित्सामि हि वरं तेऽद्य प्रीतिर्मे परमा त्वयि ।\nदिष्ट्या च बुद्धिर्धर्मे ते निविष्टा भुजगोत्तम\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108597, "chapter_id": 3352, "verse_number": "", "content_sanskrit": "अतो भूयश्च ते बुद्धिर्धर्मे भवतु सुस्थिरा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108598, "chapter_id": 3352, "verse_number": "", "content_sanskrit": "शेषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108599, "chapter_id": 3352, "verse_number": "१७", "content_sanskrit": "धर्मे मे रमतां बुद्धिः शमे तपसि चेश्वर \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108600, "chapter_id": 3352, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108601, "chapter_id": 3352, "verse_number": "१८", "content_sanskrit": "प्रीतोऽस्म्यनेन ते शेष दमेन प्रशमेन च\nत्वया त्विदं वचः कार्यं मन्नियोगात् प्रजाहितम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108602, "chapter_id": 3352, "verse_number": "१९", "content_sanskrit": "इमां महीं शैलवनोपपन्नां\nससागरां सनगरपत्तनां च ।\nत्वं शेष सम्यक्चलितां यथावत्\nसङ्गृह्य  तिष्ठस्व यथाऽचला स्यात् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108603, "chapter_id": 3352, "verse_number": "", "content_sanskrit": "शेषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108604, "chapter_id": 3352, "verse_number": "२०", "content_sanskrit": "यथाह देवो वरदः प्रजापति-\nर्महीपतिर्भुवनपतिर्जगत्पतिः ।\nतथा महीं धारयितास्मि निश्चलां\nप्रयच्छ तां मे शिरसि प्रजापते \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2108605, "chapter_id": 3352, "verse_number": "", "content_sanskrit": "ब्र्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2108606, "chapter_id": 3352, "verse_number": "२१", "content_sanskrit": "अधो महीं गच्छ भुजङ्गमोत्तम\nस्वयं तवैषा विवरं प्रदास्यति\nइमां धरां धारयता त्वया हि मे\nमहत्प्रियं शेष कृतं भविष्यति \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2108607, "chapter_id": 3352, "verse_number": "२२", "content_sanskrit": "शेषोऽसि नागोत्तम धर्मदेवो\nमहीमिमां धारयसे यदेकः\nअनन्तभोगं परिगृह्य सर्वं\nयथाऽहमेवं बलभित् तथा भवान् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2108608, "chapter_id": 3352, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2108609, "chapter_id": 3352, "verse_number": "२३", "content_sanskrit": "तथेति चोक्त्वा विवरं प्रविश्य स\nप्रभुर्भुवो भुजगवराग्रजः स्थितः\nबिभर्ति देवीं शिरसा महीमिमां\nसमुद्रनेमिं परिगृह्य सर्वशः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2108610, "chapter_id": 3352, "verse_number": "२४", "content_sanskrit": "अधो भूमेर्वसत्येव नागोऽनन्तः प्रतापवान् ।\nधारयन् वसुधामेकः शासनाद् ब्रह्मणो विभुः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2108611, "chapter_id": 3352, "verse_number": "२५", "content_sanskrit": "सुपर्णं च सखायं वै भगवानमरोत्तमः ।\nप्रादादेनमनन्ताय वैनतेयं पितामहः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2108612, "chapter_id": 3352, "verse_number": "२६", "content_sanskrit": "अनन्ते च प्रयाते तु वासुकिः सुमहाबलः ।\nअभ्यगच्छत नागैस्तु देवैरिव च वासवः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2108613, "chapter_id": 3352, "verse_number": "३१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकत्रिंशोऽध्यायः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2108614, "chapter_id": 3352, "verse_number": "१९", "content_sanskrit": "॥ आस्तीकपर्वणि एकोनविंशोऽध्यायः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]