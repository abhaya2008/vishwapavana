[{"id": 5000345000, "chapter_id": 9345, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे षष्ठः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000345001, "chapter_id": 9345, "verse_number": "५-६-१", "content_sanskrit": "स निकामं विमानेषु विचरन् कामरूपधृक्।\nविचचार कपिर्लङ्कां लाघवेन समन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000345002, "chapter_id": 9345, "verse_number": "५-६-२", "content_sanskrit": "आससाद च लक्ष्मीवान् राक्षसेन्द्रनिवेशनम्।\nप्राकारेणार्कवर्णेन भास्वरेणाभिसंवृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000345003, "chapter_id": 9345, "verse_number": "५-६-३", "content_sanskrit": "रक्षितं राक्षसैर्भीमैः सिंहैरिव महद् वनम्।\nसमीक्षमाणो भवनं चकाशे कपिकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000345004, "chapter_id": 9345, "verse_number": "५-६-४", "content_sanskrit": "रूप्यकोपहितैश्चित्रैस्तोरणैर्हेमभूषणैः।\nविचित्राभिश्च कक्ष्याभिर्द्वारैश्च रुचिरैर्वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000345005, "chapter_id": 9345, "verse_number": "५-६-५", "content_sanskrit": "गजास्थितैर्महामात्रैः शूरैश्च विगतश्रमैः।\nउपस्थितमसंहार्यैर्हयैः स्यन्दनयायिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000345006, "chapter_id": 9345, "verse_number": "५-६-६", "content_sanskrit": "सिंहव्याघ्रतनुत्राणैर्दान्तकाञ्चनराजतीः।\nघोषवद्भिर्विचित्रैश्च सदा विचरितं रथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000345007, "chapter_id": 9345, "verse_number": "५-६-७", "content_sanskrit": "बहुरत्नसमाकीर्णं परार्घ्यासनभूषितम्।\nमहारथसमावापं महारथमहासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000345008, "chapter_id": 9345, "verse_number": "५-६-८", "content_sanskrit": "दृश्यैश्च परमोदारैस्तैस्तैश्च मृगपक्षिभिः।\nविविधैर्बहुसाहस्रैः परिपूर्णं समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000345009, "chapter_id": 9345, "verse_number": "५-६-९", "content_sanskrit": "विनीतैरन्तपालैश्च रक्षोभिश्च सुरक्षितम्।\nमुख्याभिश्च वरस्त्रीभिः परिपूर्णं समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000345010, "chapter_id": 9345, "verse_number": "५-६-१०", "content_sanskrit": "मुदितप्रमदारत्नं राक्षसेन्द्रनिवेशनम्।\nवराभरणसंह्रादैः समुद्रस्वननिःस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000345011, "chapter_id": 9345, "verse_number": "५-६-११", "content_sanskrit": "तद् राजगुणसम्पन्नं मुख्यैश्च वरचन्दनैः।\nमहाजनसमाकीर्णं सिंहैरिव महद् वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000345012, "chapter_id": 9345, "verse_number": "५-६-१२", "content_sanskrit": "भेरीमृदङ्गाभिरुतं शङ्खघोषविनादितम्।\nनित्यार्चितं पर्वसुतं पूजितं राक्षसैः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000345013, "chapter_id": 9345, "verse_number": "५-६-१३", "content_sanskrit": "समुद्रमिव गम्भीरं समुद्रसमनिःस्वनम्।\nमहात्मनो महद् वेश्म महारत्नपरिच्छदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000345014, "chapter_id": 9345, "verse_number": "५-६-१४", "content_sanskrit": "महारत्नसमाकीर्णं ददर्श स महाकपिः।\nविराजमानं वपुषा गजाश्वरथसंकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000345015, "chapter_id": 9345, "verse_number": "५-६-१५", "content_sanskrit": "लंकाभरणमित्येव सोऽमन्यत महाकपिः।\nचचार हनुमांस्तत्र रावणस्य समीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000345016, "chapter_id": 9345, "verse_number": "५-६-१६", "content_sanskrit": "गृहाद् गृहं राक्षसानामुद्यानानि च सर्वशः।\nवीक्षमाणोऽप्यसंत्रस्तः प्रासादांश्च चचार सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000345017, "chapter_id": 9345, "verse_number": "५-६-१७", "content_sanskrit": "अवप्लुत्य महावेगः प्रहस्तस्य निवेशनम्।\nततोऽन्यत् पुप्लुवे वेश्म महापार्श्वस्य वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000345018, "chapter_id": 9345, "verse_number": "५-६-१८", "content_sanskrit": "अथ मेघप्रतीकाशं कुम्भकर्णनिवेशनम्।\nविभीषणस्य च तथा पुप्लुवे स महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000345019, "chapter_id": 9345, "verse_number": "५-६-१९", "content_sanskrit": "महोदरस्य च तथा विरूपाक्षस्य चैव हि।\nविद्युज्जिह्वस्य भवनं विद्युन्मालेस्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000345020, "chapter_id": 9345, "verse_number": "५-६-२०", "content_sanskrit": "वज्रदंष्ट्रस्य च तथा पुप्लुवे स महाकपिः।\nशुकस्य च महावेगः सारणस्य च धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000345021, "chapter_id": 9345, "verse_number": "५-६-२१", "content_sanskrit": "तथा चेन्द्रजितो वेश्म जगाम हरियूथपः।\nजम्बुमालेः सुमालेश्च जगाम हरिसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000345022, "chapter_id": 9345, "verse_number": "५-६-२२", "content_sanskrit": "रश्मिकेतोश्च भवनं सूर्यशत्रोस्तथैव च।\nवज्रकायस्य च तथा पुप्लुवे स महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000345023, "chapter_id": 9345, "verse_number": "५-६-२३", "content_sanskrit": "धूम्राक्षस्याथ सम्पातेर्भवनं मारुतात्मजः।\nविद्युद्रूपस्य भीमस्य घनस्य विघनस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000345024, "chapter_id": 9345, "verse_number": "५-६-२४", "content_sanskrit": "शुकनाभस्य चक्रस्य शठस्य कपटस्य च।\nह्रस्वकर्णस्य दंष्ट्रस्य लोमशस्य च रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000345025, "chapter_id": 9345, "verse_number": "५-६-२५", "content_sanskrit": "युद्धोन्मत्तस्य मत्तस्य ध्वजग्रीवस्य सादिनः।\nविद्युज्जिह्वद्विजिह्वानां तथा हस्तिमुखस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000345026, "chapter_id": 9345, "verse_number": "५-६-२६", "content_sanskrit": "करालस्य पिशाचस्य शोणिताक्षस्य चैव हि।\nप्लवमानः क्रमेणैव हनुमान् मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000345027, "chapter_id": 9345, "verse_number": "५-६-२७", "content_sanskrit": "तेषु तेषु महार्हेषु भवनेषु महायशाः।\nतेषामृद्धिमतामृद्धिं ददर्श स महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000345028, "chapter_id": 9345, "verse_number": "५-६-२८", "content_sanskrit": "सर्वेषां समतिक्रम्य भवनानि समन्ततः।\nआससादाथ लक्ष्मीवान् राक्षसेन्द्रनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000345029, "chapter_id": 9345, "verse_number": "५-६-२९", "content_sanskrit": "रावणस्योपशायिन्यो ददर्श हरिसत्तमः।\nविचरन् हरिशार्दूलो राक्षसीर्विकृतेक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000345030, "chapter_id": 9345, "verse_number": "५-६-३०", "content_sanskrit": "शूलमुद‍्गरहस्तांश्च शक्तितोमरधारिणः।\nददर्श विविधान्गुल्मांस्तस्य रक्षःपतेर्गृहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000345031, "chapter_id": 9345, "verse_number": "५-६-३१", "content_sanskrit": "राक्षसांश्च महाकायान् नानाप्रहरणोद्यतान्।\nरक्तान् श्वेतान् सितांश्चापि हरींश्चापि महाजवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000345032, "chapter_id": 9345, "verse_number": "५-६-३२", "content_sanskrit": "कुलीनान् रूपसम्पन्नान् गजान् परगजारुजान्।\nशिक्षितान् गजशिक्षायामैरावतसमान् युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000345033, "chapter_id": 9345, "verse_number": "५-६-३३", "content_sanskrit": "निहन्तॄन् परसैन्यानां गृहे तस्मिन् ददर्श सः।\nक्षरतश्च यथा मेघान् स्रवतश्च यथा गिरीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000345034, "chapter_id": 9345, "verse_number": "५-६-३४", "content_sanskrit": "मेघस्तनितनिर्घोषान् दुर्धर्षान् समरे परैः।\nसहस्रं वाहिनीस्तत्र जाम्बूनदपरिष्कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000345035, "chapter_id": 9345, "verse_number": "५-६-३५", "content_sanskrit": "हेमजालैरविच्छिन्नास्तरुणादित्यसंनिभाः।\nददर्श राक्षसेन्द्रस्य रावणस्य निवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000345036, "chapter_id": 9345, "verse_number": "५-६-३६", "content_sanskrit": "शिबिका विविधाकाराः स कपिर्मारुतात्मजः।\nलतागृहाणि चित्राणि चित्रशालागृहाणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000345037, "chapter_id": 9345, "verse_number": "५-६-३७", "content_sanskrit": "क्रीडागृहाणि चान्यानि दारुपर्वतकानि च।\nकामस्य गृहकं रम्यं दिवागृहकमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000345038, "chapter_id": 9345, "verse_number": "५-६-३८", "content_sanskrit": "ददर्श राक्षसेन्द्रस्य रावणस्य निवेशने।\nस मन्दरसमप्रख्यं मयूरस्थानसंकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000345039, "chapter_id": 9345, "verse_number": "५-६-३९", "content_sanskrit": "ध्वजयष्टिभिराकीर्णं ददर्श भवनोत्तमम्।\nअनन्तरत्ननिचयं निधिजालं समन्ततः।\nधीरनिष्ठितकर्माङ्गं गृहं भूतपतेरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000345040, "chapter_id": 9345, "verse_number": "५-६-४०", "content_sanskrit": "अर्चिर्भिश्चापि रत्नानां तेजसा रावणस्य च।\nविरराज च तद् वेश्म रश्मिवानिव रश्मिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000345041, "chapter_id": 9345, "verse_number": "५-६-४१", "content_sanskrit": "जाम्बूनदमयान्येव शयनान्यासनानि च।\nभाजनानि च शुभ्राणि ददर्श हरियूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000345042, "chapter_id": 9345, "verse_number": "५-६-४२", "content_sanskrit": "मध्वासवकृतक्लेदं मणिभाजनसंकुलम्।\nमनोरममसम्बाधं कुबेरभवनं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000345043, "chapter_id": 9345, "verse_number": "५-६-४३", "content_sanskrit": "नूपुराणां च घोषेण काञ्चीनां निःस्वनेन च।\nमृदङ्गतलनिर्घोषैर्घोषवद्भिर्विनादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000345044, "chapter_id": 9345, "verse_number": "५-६-४४", "content_sanskrit": "प्रासादसंघातयुतं स्त्रीरत्नशतसंकुलम्।\nसुव्यूढकक्ष्यं हनुमान् प्रविवेश महागृहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000345045, "chapter_id": 9345, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे षष्ठः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]