[{"id": 40020911, "chapter_id": 9345, "verse_number": "1", "content_sanskrit": "स तु तत्र दशग्रीवः सह सैन्येन वीर्यवान् । अस्तं प्राप्ते दिनकरे निवासं समरोचयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40020912, "chapter_id": 9345, "verse_number": "2", "content_sanskrit": "उदिते विमले चन्द्रे तुल्यपर्वतवर्चसि । प्रसुप्तं सुमहत्सैन्यं नानाप्रहरणायुधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40020913, "chapter_id": 9345, "verse_number": "3", "content_sanskrit": "रावणस्तु महावीर्यो निषण्णः शैलमूर्धनि । स ददर्श गुणांस्तत्र चन्द्रपादपशोभितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40020914, "chapter_id": 9345, "verse_number": "4", "content_sanskrit": "कर्णिकारवनैर्दीप्तैः कदम्बगहनैस्तथा । पद्मिनीभिश्च फुल्लाभिर्मन्दाकिन्या जलैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40020915, "chapter_id": 9345, "verse_number": "5", "content_sanskrit": "चम्पकाशोकपुन्नागमन्दारतरुभिस्तथा । चूतपाटललोध्रैश्च प्रियङ्ग्वर्जुनकेतकैः । तगरैर्नारिकैलैश्च प्रियालपनसैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40020916, "chapter_id": 9345, "verse_number": "6", "content_sanskrit": "आरग्वधैस्तमालैश्च प्रियालवकुलैरपि । एतैरन्यैश्च तरुभिरुद्भासितवनान्तरे । किन्नरा मदनेनार्ता रक्ता मधुरकण्ठिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40020917, "chapter_id": 9345, "verse_number": "7", "content_sanskrit": "समं सम्प्रजगुर्यत्र मनस्तुष्टिविवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40020918, "chapter_id": 9345, "verse_number": "8", "content_sanskrit": "भिरुद्भासितवनान्तरे । विद्याधरा मदक्षीबा मदरक्तान्तलोचनाः । योषिद्भिः सह सङ्क्रान्ताश्चिक्रीडुर्जहृषुश्च वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40020919, "chapter_id": 9345, "verse_number": "9", "content_sanskrit": "घण्टानामिव सन्नादः शुश्रुवे मधुरस्वरः । अप्सरोगणसङ्घानां गायतां धनदालये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40020920, "chapter_id": 9345, "verse_number": "10", "content_sanskrit": "पुष्पवर्षाणि मुञ्चन्तो नगाः पवनताडिताः । शैलं तं वासयन्तीव मधुमाधवगन्धिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40020921, "chapter_id": 9345, "verse_number": "11", "content_sanskrit": "मधुपुष्परजःपृक्तं गन्धमादाय पुष्कलम् । प्रववौ वर्धयन्कामं रावणस्य सुखो ऽनिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40020922, "chapter_id": 9345, "verse_number": "12", "content_sanskrit": "गेयात्पुष्पसमृद्ध्या च शैत्याद्वायोर्गिरेर्गुणात् । प्रवृत्तायां रजन्यां च चन्द्रस्योदयनेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40020923, "chapter_id": 9345, "verse_number": "13", "content_sanskrit": "रावणस्तु महावीर्यः कामस्य वशमागतः । विनिःश्वस्य विनिःश्वस्य शशिनं समवैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40020924, "chapter_id": 9345, "verse_number": "14", "content_sanskrit": "एतस्मिन्नन्तरे तत्र दिव्याभरणभूषिता । सर्वाप्सरोवरा रम्भा दिव्यपुष्पविभूषिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40020925, "chapter_id": 9345, "verse_number": "15", "content_sanskrit": "दिव्यचन्दनलिप्ताङ्गी मन्दारकृतमूर्धजा । दिव्योत्सवकृतारम्भा पूर्णचन्द्रनिभानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40020926, "chapter_id": 9345, "verse_number": "16", "content_sanskrit": "चक्षुर्मनोहरं पीनं मेखलादामभूषितम् । समुद्वहन्ती जघनं रतिप्राभृतमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40020927, "chapter_id": 9345, "verse_number": "17", "content_sanskrit": "कृतैर्विशेषकैरार्द्रैः षडर्तुकुसुमोद्भवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40020928, "chapter_id": 9345, "verse_number": "18", "content_sanskrit": "बभावन्यतमेव श्रीकान्तिद्युतिमतिह्रियाम् । नीलं सतोयमेघाभं वस्त्रं समवकुण्ठिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40020929, "chapter_id": 9345, "verse_number": "19", "content_sanskrit": "यस्या वक्त्रं शशिनिभं भ्रुवौ चापनिभे शुभे । ऊरू करिकराकारौ करौ पल्लवकोमलौ । सैन्यमध्येन गच्छन्ती रावणेनोपवीक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40020930, "chapter_id": 9345, "verse_number": "20", "content_sanskrit": "तां समुत्थाय गच्छन्तीं कामबाणवशं गतः । करे गृहीत्वा लज्जन्तीं स्मयमानो ऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40020931, "chapter_id": 9345, "verse_number": "21", "content_sanskrit": "क्व गच्छसि वरारोहे कां सिद्धिं भजसे स्वयम् । कस्याभ्युदयकालो ऽयं यस्त्वां समुपभोक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40020932, "chapter_id": 9345, "verse_number": "22", "content_sanskrit": "त्वदाननरसस्याद्य पद्मोत्पलसुगन्धिनः । सुधामृतरसस्येव को ऽद्य तृप्तिं गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40020933, "chapter_id": 9345, "verse_number": "23", "content_sanskrit": "स्वर्णकुम्भनिभौ पीनौ शुभौ भीरु निरन्तरौ । कस्योरस्थलसंस्पर्शं दास्यतस्ते कुचाविमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40020934, "chapter_id": 9345, "verse_number": "24", "content_sanskrit": "सुवर्णचक्रप्रतिमं स्वर्णदामचितं पृथु । अध्यारोहति कस्ते ऽद्य जघनं स्वर्गरूपिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40020935, "chapter_id": 9345, "verse_number": "25", "content_sanskrit": "मद्विशिष्टः पुमान्को ऽद्य शक्रो विष्णुरथाश्विनौ । मामतीत्य हि यं च त्वं यासि भीरु न शोभनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40020936, "chapter_id": 9345, "verse_number": "26", "content_sanskrit": "विश्रम त्वं पृथुश्रोणि शिलातलमिदं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40020937, "chapter_id": 9345, "verse_number": "27", "content_sanskrit": "त्रैलोक्ये यः प्रभुश्चैव मदन्यो नैव विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40020938, "chapter_id": 9345, "verse_number": "28", "content_sanskrit": "तदेवं प्राञ्जलिः प्रह्वो याचते त्वां दशाननः । भर्तुर्भर्ता विधाता च त्रैलोक्यस्य भजस्व माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40020939, "chapter_id": 9345, "verse_number": "29", "content_sanskrit": "एवमुक्ता ऽब्रवीद्रम्भा वेपमाना कृताञ्जलिः । प्रसीद नार्हसे वक्तुमीदृशं त्वं हि मे गुरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40020940, "chapter_id": 9345, "verse_number": "30", "content_sanskrit": "अन्येभ्यो हि त्वया रक्ष्या प्राप्नुयां धर्षणं यदि । तद्धर्मतः स्नुषा ते ऽहं तत्त्वमेव ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40020941, "chapter_id": 9345, "verse_number": "31", "content_sanskrit": "अथाब्रवीद्दशग्रीवश्चरणाधोमुखीं स्थिताम् । रोमहर्षमनुप्राप्तां दृष्टमात्रेण तां तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40020942, "chapter_id": 9345, "verse_number": "32", "content_sanskrit": "सुतस्य यदि मे भार्या ततस्त्वं हि स्नुषा भवेः । बाढमित्येव सा रम्भा प्राह रावणमुत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40020943, "chapter_id": 9345, "verse_number": "33", "content_sanskrit": "धर्मतस्ते सुतस्याहं भार्या राक्षसपुङ्गव । पुत्रः प्रियतरः प्राणैर्भ्रातुर्वैश्रवणस्य ते । विख्यातस्त्रिषु लोकेषु नलकूबर इत्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40020944, "chapter_id": 9345, "verse_number": "34", "content_sanskrit": "धर्मतो यो भवेद्विप्रः क्षत्रियो वीर्यतो भवेत् । क्रोधाद्यश्च भवेदग्निः क्षान्त्या च वसुधासमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40020945, "chapter_id": 9345, "verse_number": "35", "content_sanskrit": "तस्यास्मि कृतसङ्केता लोकपालसुतस्य वै । तमुद्दिश्य तु मे सर्वं विभूषणमिदं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40020946, "chapter_id": 9345, "verse_number": "36", "content_sanskrit": "तथा तस्य हि नान्यस्य भावो मां प्रति तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40020947, "chapter_id": 9345, "verse_number": "37", "content_sanskrit": "तेन सत्येन मां राजन्मोक्तुमर्हस्यरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40020948, "chapter_id": 9345, "verse_number": "38", "content_sanskrit": "स हि तिष्ठति धर्मात्मा मां प्रतीक्ष्य समुत्सुकः । तत्र विघ्नं सुतस्येह कर्तुं नार्हसि मुञ्च माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40020949, "chapter_id": 9345, "verse_number": "39", "content_sanskrit": "सद्भिराचरितं मार्गं गच्छ राक्षसुपुङ्गव । माननीयो मम त्वं हि पालनीया तथा ऽस्मि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40020950, "chapter_id": 9345, "verse_number": "40", "content_sanskrit": "एवमुक्तो दशग्रीवः प्रत्युवाच विनीतवत् । स्नुषा ऽस्मि यदवोचस्त्वमेकपत्नीष्वयं क्रमः । देवलोकस्थितिरियं सुराणां शाश्वती मता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40020951, "chapter_id": 9345, "verse_number": "41", "content_sanskrit": "पतिरप्सरसां नास्ति न चैकस्त्रीपरिग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40020952, "chapter_id": 9345, "verse_number": "42", "content_sanskrit": "अस्मि यदवोचस्त्वमेकपत्नीष्वयं क्रमः । एवमुक्त्वा स तां रक्षो निवेश्य च शिलातले । कामभोगाभिसंसक्तो मैथुनायोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40020953, "chapter_id": 9345, "verse_number": "43", "content_sanskrit": "सा विमुक्ता ततो रम्भा भ्रष्टमाल्यविभूषणा । गजेन्द्राक्रीडमथिता नदीवाकुलतां गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40020954, "chapter_id": 9345, "verse_number": "44", "content_sanskrit": "लुलिताकुलकेशान्ता करवेपितपल्लवा । पवनेनावधूतेव लता कुसुमशालिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40020955, "chapter_id": 9345, "verse_number": "45", "content_sanskrit": "सा वेपमाना लज्जन्ती भीता करकृताञ्जलिः । नलकूबरमासाद्य पादयोर्निपपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40020956, "chapter_id": 9345, "verse_number": "46", "content_sanskrit": "तदवस्थां च तां दृष्ट्वा महात्मा नलकूबरः । अब्रवीत्किमिदं भद्रे पादयोः पतिता ऽसि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40020957, "chapter_id": 9345, "verse_number": "47", "content_sanskrit": "सा वै निःश्वसमाना तु वेपमाना कृताञ्जलिः । तस्मै सर्वं यथातत्त्वमाख्यातुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40020958, "chapter_id": 9345, "verse_number": "48", "content_sanskrit": "एष देव दशग्रीवः प्राप्तो गन्तुं त्रिविष्टपम् । तेन सैन्यसहायेन निशेयं परिणामिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40020959, "chapter_id": 9345, "verse_number": "49", "content_sanskrit": "आयन्ती तेन दृष्टा ऽस्मि त्वत्सकाशमरिन्दम । गृहीता तेन पृष्टा ऽस्मि कस्य त्वमिति रक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40020960, "chapter_id": 9345, "verse_number": "50", "content_sanskrit": "मया तु सर्वं यत्सत्यं तस्मै सर्वं निवेदितम् । काममोहाभिभूतात्मा नाश्रौषीत्तद्वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40020961, "chapter_id": 9345, "verse_number": "51", "content_sanskrit": "याच्यमानो मया देव स्नुषा ते ऽहमिति प्रभो । तत्सर्वं पृष्ठतः कृत्वा बलात्तेनास्मि धर्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40020962, "chapter_id": 9345, "verse_number": "52", "content_sanskrit": "एवं त्वमपराधं मे क्षन्तुमर्हसि सुव्रत । न हि तुल्यं बलं सौम्य स्त्रियाश्च पुरुषस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40020963, "chapter_id": 9345, "verse_number": "53", "content_sanskrit": "एतछुत्वा तु सङ्क्रुद्धस्तदा वैश्रवणात्मजः । धर्षणां तां परां श्रुत्वा ध्यानं सम्प्रविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 40020964, "chapter_id": 9345, "verse_number": "54", "content_sanskrit": "तस्य तत्कर्म विज्ञाय तदा वैश्रवणात्मजः । मुहूर्तात्क्रोधताम्राक्षस्तोयं जग्राह पाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 40020965, "chapter_id": 9345, "verse_number": "55", "content_sanskrit": "गृहीत्वा सलिलं सर्वमुपस्पृश्य यथाविधि । उत्ससर्ज यथा शापं राक्षसेन्द्राय दारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 40020966, "chapter_id": 9345, "verse_number": "56", "content_sanskrit": "अकामा तेन यस्मात्त्वं बलाद्भद्रे प्रधर्षिता । तस्मात्स युवतीमन्यां नाकामामुपयास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 40020967, "chapter_id": 9345, "verse_number": "57", "content_sanskrit": "यदा ह्यकामां कामार्तो धर्षयिष्यति योषितम् । मूर्धा तु सप्तधा तस्य शकलीभविता तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 40020968, "chapter_id": 9345, "verse_number": "58", "content_sanskrit": "तस्मिन्नुदाहृते शापे ज्वलिताग्निसमप्रभे । देवदुन्दुभयो नेदुः पुष्पवृष्टिश्च खाच्च्युता । पितामहमुखाश्चैव सर्वे देवाः प्रहर्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 40020969, "chapter_id": 9345, "verse_number": "59", "content_sanskrit": "ज्ञात्वा लोकगतिं सर्वां तस्य मृत्युं च रक्षसः । ऋषयः पितरश्चैव प्रीतिमापुरनुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 40020970, "chapter_id": 9345, "verse_number": "60", "content_sanskrit": "श्रुत्वा तु स दशग्रीवस्तं शापं रोमहर्षणम् । नारीषु मैथुने भावं नाकामास्वभ्यरोचयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 40020971, "chapter_id": 9345, "verse_number": "61", "content_sanskrit": "तेन नीताः स्त्रियः प्रीतिमापुः सर्वाः पतिव्रताः । नलकूबरनिर्मुक्तं शापं श्रुत्वा मनःप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]