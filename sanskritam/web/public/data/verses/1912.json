[{"id": 2041050, "chapter_id": 1912, "verse_number": "५-१५७-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041051, "chapter_id": 1912, "verse_number": "५-१५७-१", "content_sanskrit": "आपगेयं महात्मानं भीष्मं शस्त्रभृतां वरम्।\nपितामहं भारतानां ध्वजं सर्वमहीक्षिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041052, "chapter_id": 1912, "verse_number": "५-१५७-२", "content_sanskrit": "बृहस्पतिसं बुद्ध्या क्षमया पृथिवीसमम् ।\nसमुद्रमिव गाम्भीर्ये हिमवन्तमिव स्थिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041053, "chapter_id": 1912, "verse_number": "५-१५७-३", "content_sanskrit": "प्रजापतिमिवौदार्ये तेजसा भास्करोपमम् ।\nमहेन्द्रमिव शत्रूणां ध्वंसनं शरवृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041054, "chapter_id": 1912, "verse_number": "५-१५७-४", "content_sanskrit": "रणयज्ञे प्रवितते सुभीमे लोमहर्षणे।\nदीक्षितं चिररात्राय श्रुत्वा तत्र युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041055, "chapter_id": 1912, "verse_number": "५-१५७-५", "content_sanskrit": "किमब्रवीन्महाबाहुः सर्वशस्त्रभृतां वरः ।\nभीमसेनार्जुनौ वापि कृष्णो वा प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041056, "chapter_id": 1912, "verse_number": "५-१५७-६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041057, "chapter_id": 1912, "verse_number": "५-१५७-६", "content_sanskrit": "आपद्धर्मार्थकुशलो महाबुद्धिर्युधिष्ठिरः।\nसर्वान्भ्रातॄन्समानीय वासुदेवं च शाश्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041058, "chapter_id": 1912, "verse_number": "५-१५७-७", "content_sanskrit": "उवाच वदतां श्रेष्ठः सान्त्वपूर्वमिदं वचः।\nपर्याक्रामत सैन्यानि यत्तास्तिष्ठत दंशिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041059, "chapter_id": 1912, "verse_number": "५-१५७-८", "content_sanskrit": "पितामहेन वो युद्धं पूर्वमेव भविष्यति।\nतस्मात्सप्तसु सेनासु प्रणेतॄन्मम पश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041060, "chapter_id": 1912, "verse_number": "५-१५७-९x", "content_sanskrit": "कृष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041061, "chapter_id": 1912, "verse_number": "५-१५७-९", "content_sanskrit": "यथार्हति भवान्वक्तुमस्मिन्काले ह्युपस्थिते।\nतथेदमर्थवद्वाक्यमुक्तं ते भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041062, "chapter_id": 1912, "verse_number": "५-१५७-१०", "content_sanskrit": "रोचते मे महाबाहो क्रियतां यदनन्तरम्।\nनायकास्तव सेनायां क्रियन्तामिह सप्त वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041063, "chapter_id": 1912, "verse_number": "५-१५७-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041064, "chapter_id": 1912, "verse_number": "५-१५७-११", "content_sanskrit": "ततो द्रुपदमानाय्य विराटं शिनिपुङ्गवम् ।\nधृष्टद्युम्नं च पाञ्चाल्यं धृष्टकेतुं च पार्थिव।\nशिखण्डिनं च पाञ्चाल्यं सहदेवं च मागधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041065, "chapter_id": 1912, "verse_number": "५-१५७-१२", "content_sanskrit": "एतान्सप्त महाभागान्वीरान्युद्धाभिकाङ्क्षिणः ।\nसेनाप्रणेतॄन्विधिवदभ्यषिञ्चद्युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041066, "chapter_id": 1912, "verse_number": "५-१५७-१३", "content_sanskrit": "सर्वसेनापतिं चात्र धृष्टद्युम्नं चकार ह ।\nद्रोणान्तहेतोरुत्पन्नो य इद्धाञ्जातवेदसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041067, "chapter_id": 1912, "verse_number": "५-१५७-१४", "content_sanskrit": "सर्वेषामेव तेषां तु समस्तानां महात्मनाम् ।\nसेनापतिपतिं चक्रे गडाकेशं धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041068, "chapter_id": 1912, "verse_number": "५-१५७-१५", "content_sanskrit": "अर्जुनस्यापि नेता च संयन्ता चैव वाजिनाम्।\nसङ्कर्णणानुजः श्रीमान्महाबुद्धिर्जनार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041069, "chapter_id": 1912, "verse_number": "५-१५७-१६", "content_sanskrit": "तद्दृष्ट्वोपस्थितं युद्धं समासन्नं महात्ययम् ।\nप्राविशद्भवनं राज्ञः पाण्डवानां हलायुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041070, "chapter_id": 1912, "verse_number": "५-१५७-१७", "content_sanskrit": "सहाक्रूरप्रभृतिभिर्ददसाम्बोद्धवादिभिः ।\nरौक्मिणेयाहुकसुतैश्चारुदेष्णपुरोगमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041071, "chapter_id": 1912, "verse_number": "५-१५७-१८", "content_sanskrit": "वृष्णिमुख्यैरधिगतैर्व्याघ्रैरिव बलोत्कटैः ।\nअभिगुप्तो महाबाहुर्मरुद्भिरिव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041072, "chapter_id": 1912, "verse_number": "५-१५७-१९", "content_sanskrit": "नीलकौशेयवसनः कैलासशिखरोपमः ।\nसिंहखेलगतिः श्रीमान्मदरक्तान्तलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2041073, "chapter_id": 1912, "verse_number": "५-१५७-२०", "content_sanskrit": "तं दृष्ट्वा धर्मराजश्च केशवश्च महाद्युतिः ।\nउदतिष्ठत्ततः पार्थो भीमकर्मा वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2041074, "chapter_id": 1912, "verse_number": "५-१५७-२१", "content_sanskrit": "गाण्डीवधन्वा ये चान्ये राजानस्तत्र केचन।\nपूजयाञ्चक्रिरे ते वै समायान्तं हलायुधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2041075, "chapter_id": 1912, "verse_number": "५-१५७-२२", "content_sanskrit": "ततस्तं पाण्डवो राजा करे पस्पर्श पाणिना ।\nवासुदेवपुरोगास्तं सर्व एवाभ्यवादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2041076, "chapter_id": 1912, "verse_number": "५-१५७-२३", "content_sanskrit": "विराटद्रुपदौ वृद्धावभिवाद्य हलायुधः ।\nयुधिष्ठिरेण सहित उपाविशदरिन्दमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2041077, "chapter_id": 1912, "verse_number": "५-१५७-२४", "content_sanskrit": "ततस्तेषूपविष्टेषु पार्थिवेषु समन्ततः ।\nवासुदेवमभिप्रेक्ष्य रौहिणेयोऽभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2041078, "chapter_id": 1912, "verse_number": "५-१५७-२५", "content_sanskrit": "भवितायं महारौद्रो दारुणः पुरुषक्षयः ।\nदिष्टमेतद्ध्रुवं मन्ये न शक्यमतिवर्तितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2041079, "chapter_id": 1912, "verse_number": "५-१५७-२६", "content_sanskrit": "तस्माद्युद्धात्समुत्तीर्णानपि वः समुहृञ्जानान्।\nअरोगानक्षतैर्देहैर्द्रष्टास्मीति मतिर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2041080, "chapter_id": 1912, "verse_number": "५-१५७-२७", "content_sanskrit": "समेतं पार्थिवं क्षत्रं कालपक्वमसंशयम् ।\nविमर्दश्च महान्भावी मांसशोणितकदर्दमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2041081, "chapter_id": 1912, "verse_number": "५-१५७-२८", "content_sanskrit": "उक्तो मया वासुदेवः पुनः पुनरुपह्वरे।\nसंबन्धिषु समां वृत्तिं वर्तस्व मधुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2041082, "chapter_id": 1912, "verse_number": "५-१५७-२९", "content_sanskrit": "पाण्डवा हि यथास्माकं तथा दुर्योधनो नृपः।\nतस्यापि क्रियतां साह्यं स पर्येति पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2041083, "chapter_id": 1912, "verse_number": "५-१५७-३०", "content_sanskrit": "तच्च मे नाकरोद्वाक्यं त्वदर्थे मधुसूदनः।\nनिर्विष्टः सर्वभावेन धनञ्जयमवेक्ष्य ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2041084, "chapter_id": 1912, "verse_number": "५-१५७-३१", "content_sanskrit": "ध्रुवो जयः पाण्डवानामिति मे निश्चिता मतिः।\nतथा ह्यभिनिवेशोऽयं वासुदेवस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2041085, "chapter_id": 1912, "verse_number": "५-१५७-३२", "content_sanskrit": "न चाहमृत्सहे कृष्णमृते लोकमुदीक्षितुम् ।\nततोऽहमनुवर्तामि केशवस्य चिकीर्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2041086, "chapter_id": 1912, "verse_number": "५-१५७-३३", "content_sanskrit": "उभौ शिष्यौ हि मे वीरौ गदायद्धविशारदौ ।\nतुल्यस्नेहोऽस्म्यतो भीते तथा दुर्योधने नृपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2041087, "chapter_id": 1912, "verse_number": "५-१५७-३४", "content_sanskrit": "तस्माद्यास्यामि तीर्थानि सरस्वत्या निषेवितुम् ।\nन हि शक्ष्यामि कौरव्यान्नश्यमानानवेक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2041088, "chapter_id": 1912, "verse_number": "५-१५७-३५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2041089, "chapter_id": 1912, "verse_number": "५-१५७-३५", "content_sanskrit": "एवमुक्त्वा महाबाहुरनुज्ञातश्च पाण्डवैः।\nतीर्थयात्रां ययौ रामो निवर्त्य मधुसूदनम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2041090, "chapter_id": 1912, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वमि सैन्यनिर्याणपर्वणि सप्तपञ्चाशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]