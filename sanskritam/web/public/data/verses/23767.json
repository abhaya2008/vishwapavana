[{"id": 7003767000, "chapter_id": 23767, "verse_number": "२-२-११-१", "content_sanskrit": "जैमिनिरुवाच ।\nनारदाद्ब्रह्मणः पुत्राद्भगवद्भक्तिमुत्तमाम् ।\nश्रुत्वेत्थं परमप्रीत इंद्रद्युम्नोऽप्युवाच तम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003767001, "chapter_id": 23767, "verse_number": "२-२-११-२", "content_sanskrit": "इंद्रद्युम्न उवाच ।\nसाधुसंगस्तु विद्वद्भिर्भवव्याधिविनाशनः ।\nममोपदिष्टो भगवन्सोऽभूत्सांप्रतमेव मे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003767002, "chapter_id": 23767, "verse_number": "२-२-११-३", "content_sanskrit": "येन साक्षात्कृतो विष्णुः परमात्मा परात्परः ।\nस त्वं यन्मंदिरायातस्त्वदन्यः साधुरत्र कः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003767003, "chapter_id": 23767, "verse_number": "२-२-११-४", "content_sanskrit": "त्वत्संनिधानाद्भगवस्तमो मे नाशमभ्यगात् ।\nयन्मे त्वरयते चित्तमर्चितुं नीलमाधवम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003767004, "chapter_id": 23767, "verse_number": "२-२-११-५", "content_sanskrit": "वेत्सि ब्रह्मांडवृत्तांतं पर्यटन्सार्वलौकिकः ।\nतदावां रथमास्थाय पश्यावो नीलमाधवम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003767005, "chapter_id": 23767, "verse_number": "२-२-११-६", "content_sanskrit": "पुरुषोत्तमसंज्ञस्य क्षेत्रस्यालंकृतं शुभम् ।\nतत्र तीर्थानि संतीति बहुभिः कथितानि मे ।\nत्वद्वाक्याद्यदि जानामि भवेयुः सफलानि मे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003767006, "chapter_id": 23767, "verse_number": "२-२-११-७", "content_sanskrit": "नारद उवाच ।\nहंत ते दर्शयिष्यामि क्षेत्रं क्षेत्रस्थितानि च ।\nतीर्थानि शक्तिशंभूंश्च क्षेत्रमाहात्म्यमेव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003767007, "chapter_id": 23767, "verse_number": "२-२-११-८", "content_sanskrit": "साक्षाद्द्रक्ष्यसि देवेशं भक्तस्यात्मसमर्पकम् ।\nतवानुग्रहतः शीघ्रं चतुर्द्धा संव्यवस्थितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003767008, "chapter_id": 23767, "verse_number": "२-२-११-९", "content_sanskrit": "यस्य संदर्शनान्मर्त्यो जायते भक्तिभाजनम् ।\nएवं कथांते तौ प्रीतावहःकृत्यं समाप्य च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003767009, "chapter_id": 23767, "verse_number": "२-२-११-१०", "content_sanskrit": "यात्रानुकूलं निर्णीय पंचम्यां बुधवासरे ।\nज्येष्ठकृष्णेतरे पक्षे पुष्यर्क्षे लग्न उत्तमे ।\nएकत्र शयितौ रात्रिं निन्यतुर्नृपनारदौ ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003767010, "chapter_id": 23767, "verse_number": "२-२-११-११", "content_sanskrit": "ततः प्रभाते विमल इंद्रद्युम्नो नृपोत्तमः ।\nघोषणां कारयामास राज्यस्य सह बंधुभिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003767011, "chapter_id": 23767, "verse_number": "२-२-११-१२", "content_sanskrit": "यथाविभवतः सैन्यैर्नीलाद्रिगमनं प्रति ।\nयावज्जीवं तत्र वासं करिष्यामो विनिश्चितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003767012, "chapter_id": 23767, "verse_number": "२-२-११-१३", "content_sanskrit": "या वृत्तिः कल्पिता यस्य स तया तत्र जीवतु ।\nराजानः सावरोधाश्च सामात्याः सपरिच्छदाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003767013, "chapter_id": 23767, "verse_number": "२-२-११-१४", "content_sanskrit": "रथैर्गजैस्तुरगैश्च कोषैः सह पदातिभिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003767014, "chapter_id": 23767, "verse_number": "२-२-११-१५", "content_sanskrit": "व्रजंतु सज्जितास्तत्र ब्राह्मणाः साग्निहोत्रिणः ।\nवणिजः सह भांडैश्च सपण्याः पण्यजीविनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003767015, "chapter_id": 23767, "verse_number": "२-२-११-१६", "content_sanskrit": "राष्ट्रकर्मणि निष्णाता कुशला राजवर्त्मसु ।\nज्योतिर्विदो नृत्यविदो दंडनीतौ प्रवीणकाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003767016, "chapter_id": 23767, "verse_number": "२-२-११-१७", "content_sanskrit": "नृत्यगायनवादित्रचतुर्विधसुबुद्धयः ।\nगजवाजिनराणां च भैषज्ये शास्त्र उत्तमे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003767017, "chapter_id": 23767, "verse_number": "२-२-११-१८", "content_sanskrit": "कुशला दृष्टकर्माणो विद्यास्वष्टादशस्वपि ।\nउपांगविद्यासु तथा कुहकार्थकुतूहलाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003767018, "chapter_id": 23767, "verse_number": "२-२-११-१९", "content_sanskrit": "वाटसाहसिकाश्चोरास्तथान्ये पश्यतोहराः ।\nविचित्रकथनाजीवाश्चाटुकाराश्च मागधाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003767019, "chapter_id": 23767, "verse_number": "२-२-११-२०", "content_sanskrit": "शास्त्रोपजीविनश्चैव तथान्ये शल्यहारकाः ।\nद्यूतकाराश्च पुंश्चल्यो वेश्या वेशानुगा विटाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003767020, "chapter_id": 23767, "verse_number": "२-२-११-२१", "content_sanskrit": "कृषीवलाश्च गोमेपच्छागोष्ट्रखररक्षकाः ।\nशकुंतपालाश्च कपिव्याघ्रशार्दूलरक्षकाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003767021, "chapter_id": 23767, "verse_number": "२-२-११-२२", "content_sanskrit": "आहितुंडिकगोरक्ष्य शबरा म्लेच्छजातयः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003767022, "chapter_id": 23767, "verse_number": "२-२-११-२३", "content_sanskrit": "अन्ये च ये मालवदेशजाता आज्ञां मदीयामनुपालयंति ।\nते यांतु सर्वे वसतौ हि नीलाचले यथास्वं कृतवास्तुभागाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003767023, "chapter_id": 23767, "verse_number": "२-२-११-२४", "content_sanskrit": "एवमाज्ञाप्य नृपतिर्यात्रायां च कृतक्षणः ।\nनारदेन समागम्य दैवज्ञमिदमाह सः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003767024, "chapter_id": 23767, "verse_number": "२-२-११-२५", "content_sanskrit": "सांवत्सर मुहूर्त्तं मे निर्णीतं ते यथा पुरा ।\nतावन्मांगलिकं वस्तुजातं सम्यगुपानय ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003767025, "chapter_id": 23767, "verse_number": "२-२-११-२६", "content_sanskrit": "पुरोहितमतेनास्मिन्क्षणे यावद्विमृग्यते ।\nतेनादिष्टः स गणकः पुरोहितसहायवान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003767026, "chapter_id": 23767, "verse_number": "२-२-११-२७", "content_sanskrit": "आजहार समस्तानि मांगल्यानि द्विजोत्तमाः ।\nअत्रांतरे स राजर्षिर्दिव्यसिंहासनस्थितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003767027, "chapter_id": 23767, "verse_number": "२-२-११-२८", "content_sanskrit": "यात्राभिषेकमांगल्यं विप्रैः प्रागनुभावितम् ।\nश्रीसूक्तवह्निसूक्ताभ्यां सूक्तेनाब्दैवतेन च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003767028, "chapter_id": 23767, "verse_number": "२-२-११-२९", "content_sanskrit": "पावमान्याब्धिसूक्तेन पृथङ्मांगल्यवर्द्धकैः ।\nतीर्थाद्भिरौषधीभिश्च सर्वगन्धैः पृथक्पृथक् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003767029, "chapter_id": 23767, "verse_number": "२-२-११-३०", "content_sanskrit": "अभिषिक्तस्ततो राजा चीनांशुकहृतांभसा ।\nरराज वपुषा दीप्तो निर्धूमः पावको यथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003767030, "chapter_id": 23767, "verse_number": "२-२-११-३१", "content_sanskrit": "आमुक्तशुक्लवसनः स्वाचांतः सपवित्रकः ।\nनांदीमुखान्पितृगणान्पूजयित्वा यथाविधि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003767031, "chapter_id": 23767, "verse_number": "२-२-११-३२", "content_sanskrit": "जयाराष्ट्रभृतो हुत्वा गणहोमांश्च यत्नतः ।\nशंखध्वनिसुगंधाढयं श्वेतवर्णं विधूमकम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003767032, "chapter_id": 23767, "verse_number": "२-२-११-३३", "content_sanskrit": "वह्निं प्रदक्षिणं चक्रे दक्षिणावर्त्तगार्चिषा ।\nसाक्षात्कारेण ददतं जयं राज्ञे जयार्थिने ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003767033, "chapter_id": 23767, "verse_number": "२-२-११-३४", "content_sanskrit": "नवग्रहमखांते च ग्रहकुंभेन सेवितः॥ ग्र  ।\nहाणां दौष्ट्यनाशाय सौस्थ्यस्यापि विवृद्धये ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003767034, "chapter_id": 23767, "verse_number": "२-२-११-३५", "content_sanskrit": "ज्योतिःशास्त्रोदितैर्मंत्रैर्दैवज्ञविधिचोदितैः ।\nततो मांगल्यनेपथ्यविधानमुपचक्रमे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003767035, "chapter_id": 23767, "verse_number": "२-२-११-३६", "content_sanskrit": "चीनांशुकप्रावरणे विधाय कवचं निजम् ।\nशिरोवेष्टनकं शुभ्रं सुरत्नमुकुटोज्ज्वलम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003767036, "chapter_id": 23767, "verse_number": "२-२-११-३७", "content_sanskrit": "सावतंसे श्रुतियुगे रत्नकुंडलभूषिते ।\nग्रैवेयकं महार्घं तु हारं तरलभूषितम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003767037, "chapter_id": 23767, "verse_number": "२-२-११-३८", "content_sanskrit": "दधाराथ नृपश्रेष्ठः केयूरांगदमुद्रिकाः ।\nमध्येन त्रिवलीसक्तं स्वर्णसूत्रं त्रिवृद्दधौ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003767038, "chapter_id": 23767, "verse_number": "२-२-११-३९", "content_sanskrit": "हिरण्यकिंकिणीयुक्त मुक्तातोरणमालिकम् ।\nनानारत्नैः सुघटितां दधाराथ सुमेखलाम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003767039, "chapter_id": 23767, "verse_number": "२-२-११-४०", "content_sanskrit": "अनर्घ्ये पादकटके पादयोः संन्यवेशयत् ।\nसम्मुखादर्शितादर्शे ददृशे स्वं विभूषितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003767040, "chapter_id": 23767, "verse_number": "२-२-११-४१", "content_sanskrit": "मंगलारोपणार्थाय हैमपीठमुपाविशत् ।\nप्राङ्मुखः श्रीधरं देवं संस्मरन्मधुसूदनम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003767041, "chapter_id": 23767, "verse_number": "२-२-११-४२", "content_sanskrit": "मगलायतनं विष्णुं सर्वमांगल्यकारणम ।\nस्मरणादस्य नश्यंति पातकानि बहून्यपि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003767042, "chapter_id": 23767, "verse_number": "२-२-११-४३", "content_sanskrit": "सौमनस्यामथो मालामार्त्तवीं गंधवर्णिताम् ।\nदधार प्रथमं राजा मंत्रितां स्वपुरोधसा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003767043, "chapter_id": 23767, "verse_number": "२-२-११-४४", "content_sanskrit": "मृदं दीपं फलं दूर्वा दधि गोरोचनां ततः ।\nमन्त्राभिमंत्रितान्सर्वान्सिद्धार्थैरभिरक्षितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003767044, "chapter_id": 23767, "verse_number": "२-२-११-४५", "content_sanskrit": "आत्मानं ददृशे राजा सौरभेये हविष्यथ ।\nमुकुरे मंत्रिते पश्चात्स्वं दृष्ट्वा नृपकेसरी ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003767045, "chapter_id": 23767, "verse_number": "२-२-११-४६", "content_sanskrit": "बह्वृचैः शांतिघोषेण समुदीर्णशुभायतिः ।\nयाजुष्कैः पथिसूक्तेन व्रजन्मार्गेऽभिरक्षितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003767046, "chapter_id": 23767, "verse_number": "२-२-११-४७", "content_sanskrit": "पौराणैर्मंगलैर्वाक्यैः कृतवीर्यधृतिर्नृपः ।\nमागधैः स्तुतिपाठेन प्रादुर्भूतपराक्रमः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003767047, "chapter_id": 23767, "verse_number": "२-२-११-४८", "content_sanskrit": "पारिजातहरं सत्यासहितं गरुडध्वजम् ।\nध्यायन्हृत्पंकजे राजा दक्षिणं पादमुद्दधौ ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003767048, "chapter_id": 23767, "verse_number": "२-२-११-४९", "content_sanskrit": "प्रदक्षिणीकृत्य मुनिं नारदं पुरतः स्थितम् ।\nमध्यद्वारमुपागच्छद्वेत्रपाणिभिरावृतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003767049, "chapter_id": 23767, "verse_number": "२-२-११-५०", "content_sanskrit": "आदिष्टपदमार्गोऽसावग्निहोत्रपुरःसरः ।\nतत्रापश्यत्स्थितान्विप्रानात्मनो दक्षिणेन वै ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003767050, "chapter_id": 23767, "verse_number": "२-२-११-५१", "content_sanskrit": "मांगल्यसूक्तंऽ पठतः शुभ्राभान्पांडुरांशुकान् ।\nलाजाः सपुष्पा राजाग्रे क्षिपतः शंसतः शुभम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003767051, "chapter_id": 23767, "verse_number": "२-२-११-५२", "content_sanskrit": "वामपार्श्वस्थिता वेश्याश्चामरव्यग्रपाणयः ।\nशुभ्रालंकारवसनाः स्मेरपद्मानना शुभाः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003767052, "chapter_id": 23767, "verse_number": "२-२-११-५३", "content_sanskrit": "ब्राह्मणान्पूजयामास भक्तिनम्रो द्विजोत्तमाः ।\nवस्त्रालंकारमाल्यैश्च सुगन्धैरनुलेपनैः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003767053, "chapter_id": 23767, "verse_number": "२-२-११-५४", "content_sanskrit": "तोषयामास तान्विप्रान्भगवद्बुद्धि भावितान् ।\nवेश्याभ्यो मागधेभ्यश्च दीनानाथेभ्य एव च ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003767054, "chapter_id": 23767, "verse_number": "२-२-११-५५", "content_sanskrit": "राजानुमत्या सचिवो यथार्हं प्रददौ धनम् ।\nश्वेतान्पारावतान्हंसाञ्छ्वेताश्वं श्वेतकुंजरम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003767055, "chapter_id": 23767, "verse_number": "२-२-११-५६", "content_sanskrit": "सचूतपल्लवं श्वेतमालाफलविभूषितम् ।\nकदलीकांडसन्नद्धतोरणाधः स्थितं नृपः ।\nपूर्णकुंभं स पश्यन्वै मंगलानि बहून्यपि ।\nसितातपत्रेण शिरःप्रदेशे वारितातपः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003767056, "chapter_id": 23767, "verse_number": "२-२-११-५७", "content_sanskrit": "युगपत्पूर्यमाणैस्तु कंबुभिः शतसंख्यकेः ।\nसंमिश्रितानि शुश्राव वादित्राणि बहूनि सः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003767057, "chapter_id": 23767, "verse_number": "२-२-११-५८", "content_sanskrit": "तथा मंगलगीतानि जयशब्दांश्च भूपतिः ।\nततो विवेश प्रासादं नृसिंहमवलोकितुम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003767058, "chapter_id": 23767, "verse_number": "२-२-११-५९", "content_sanskrit": "यं स्मृत्वा जायते मर्त्यः सर्वकल्याणभाजनम् ।\nदृष्ट्वा स दूरान्नृहरिं दिव्यसिंहासनस्थितम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003767059, "chapter_id": 23767, "verse_number": "२-२-११-६०", "content_sanskrit": "प्रणम्य साष्टावयवं सन्तोष्योपनिषद्गिरा ।\nदक्षपार्श्वस्थितां दुर्गां सर्वदुर्गतिमोचिनीम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003767060, "chapter_id": 23767, "verse_number": "२-२-११-६१", "content_sanskrit": "ववंदे चरणाभ्याशे पश्यतीं कृपया नृपः ।\nततः पुरोधा देवांगादवरोप्य शुभा स्रजम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003767061, "chapter_id": 23767, "verse_number": "२-२-११-६२", "content_sanskrit": "आसञ्जयामाम गले सुगंधेनान्वलेपयत् ।\nनीराजयामास राज्ञः शिरश्चावेष्टयन्मुदा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003767062, "chapter_id": 23767, "verse_number": "२-२-११-६३", "content_sanskrit": "पुनः प्रदक्षिणीकृत्य तौ देवौ नृपसत्तमः ।\nशिबिकायां समारोप्य प्रतस्थे च पुरस्कृतौ ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003767063, "chapter_id": 23767, "verse_number": "२-२-११-६४", "content_sanskrit": "प्रादुर्भूय बहिर्द्वारे रथं दृष्ट्वा सुसज्जितम् ।\nतुरंगमैर्वातजवैर्दशभिः परयोजितम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003767064, "chapter_id": 23767, "verse_number": "२-२-११-६५", "content_sanskrit": "प्रदक्षिणीकृत्य नृपो नारदेन समाविशत् ।\nढक्कामृदंगनिःसाणभेरीपणव गोमुखाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003767065, "chapter_id": 23767, "verse_number": "२-२-११-६६", "content_sanskrit": "मधुरीचर्चरीशंखा अवाद्यंत सहस्रशः ।\nस्यन्दनाः कोटिशस्तत्र नृपाणामनुजीविनाम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003767066, "chapter_id": 23767, "verse_number": "२-२-११-६७", "content_sanskrit": "चकाशिरे श्रेणिकृता इन्द्रद्युम्नरथाभितः ।\nनानाप्रहरणोपेताः पताकाभिरलंकृताः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003767067, "chapter_id": 23767, "verse_number": "२-२-११-६८", "content_sanskrit": "ध्वजोच्छ्रिताः स्वर्णरौप्यैः किंकिणीजालदर्पणैः ।\nयन्त्रैर्नानाविधैर्युक्ता गंभीर स्निग्धनिःस्वनाः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003767068, "chapter_id": 23767, "verse_number": "२-२-११-६९", "content_sanskrit": "पदातीनां कुञ्जराणां हयानां वातरंहसाम् ।\nपत्तिसंस्फोटनैर्हस्तिबृंहितैर्हयहेषितैः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003767069, "chapter_id": 23767, "verse_number": "२-२-११-७०", "content_sanskrit": "बहुलै रथनिर्घोषैर्मिश्रिता वाद्यनिःस्वनाः ।\nयुगांतार्णवनिस्वानतुल्याः शुश्रुविरे जनैः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003767070, "chapter_id": 23767, "verse_number": "२-२-११-७१", "content_sanskrit": "तस्मिन्क्षणे पौरजनाः स्वस्वसंभारसज्जिताः ।\nअश्वकै रासभैरुष्ट्रैर्वाहकैः प्रतितस्थिरे ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003767071, "chapter_id": 23767, "verse_number": "२-२-११-७२", "content_sanskrit": "आंदोलिकाश्च पल्यंकाः कोटिशश्च तुरंगकाः ।\nश्रेणीभूताश्च दृश्यंते राष्ट्रप्रस्थानसंकुले ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003767072, "chapter_id": 23767, "verse_number": "२-२-११-७३", "content_sanskrit": "राजावरोधाः शतशो वृता वर्षवरैस्ततः ।\nनानायानसमारूढाः पालिताश्चाधिकारिभिः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003767073, "chapter_id": 23767, "verse_number": "२-२-११-७४", "content_sanskrit": "महासैन्यैश्च संरुद्धा राजागाराद्विनिर्ययुः ।\nयज्वानश्चाग्निहोत्राणि शम्यारूढानि वृन्दशः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003767074, "chapter_id": 23767, "verse_number": "२-२-११-७५", "content_sanskrit": "शकटेषु समारोप्य सपत्नीकाः प्रतस्थिरे ।\nतथा पुस्तकभारांश्च देवतार्चाकरंडकान् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003767075, "chapter_id": 23767, "verse_number": "२-२-११-७६", "content_sanskrit": "इध्मबर्हिकुशान्पात्रीः संभारान्होमसंभृतान् ।\nवाहयामासुरन्यैश्च शकटावाहकद्विजैः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003767076, "chapter_id": 23767, "verse_number": "२-२-११-७७", "content_sanskrit": "सामन्तामात्यभृत्याश्च पुरोधा ऋत्विजश्च ये ।\nराज्ञः प्रकृतद साश्च उपचारनियोगिनः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003767077, "chapter_id": 23767, "verse_number": "२-२-११-७८", "content_sanskrit": "सर्वोपचारसंभारानासतेऽन्ये प्रयायिनः ।\nकोषागारनियुक्ताश्च कोषजातमशेषतः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003767078, "chapter_id": 23767, "verse_number": "२-२-११-७९", "content_sanskrit": "समादाय ययुस्तूर्णं राज्ञोऽवसरसेवकाः ।\nमालाकारादयः सर्वे पण्यजीवादयस्तथा ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003767079, "chapter_id": 23767, "verse_number": "२-२-११-८०", "content_sanskrit": "स्वं स्वं पण्यं समादाय ययू राजनियोगिनः ।\nश्रेष्ठश्रेण्यादयः सर्वे पुरखर्वटवासिभिः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003767080, "chapter_id": 23767, "verse_number": "२-२-११-८१", "content_sanskrit": "समं विनिर्ययुः स्वस्वव्यवहारविलासकाः ।\nइन्द्रद्युम्नस्य नृपतेर्यात्रासमयवादितान् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003767081, "chapter_id": 23767, "verse_number": "२-२-११-८२", "content_sanskrit": "भेरीमृदंगपटहान्व्यश्नुवानान्दिगंतरम् ।\nश्रुत्वा जनपदावासिजनाः सर्वे ससंभ्रमाः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003767082, "chapter_id": 23767, "verse_number": "२-२-११-८३", "content_sanskrit": "राजाज्ञां मूर्ध्नि संमान्य निर्गता नीलपर्वतम् ।\nयस्य यश्च ऋजुः पंथाः स च तेनैव जग्मिवान् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003767083, "chapter_id": 23767, "verse_number": "२-२-११-८४", "content_sanskrit": "न राजमार्गं प्रजवाद्व्यमृग्यंत नृपाज्ञया ।\nनीलाद्रिप्राप्तिमार्गेण दुर्गमेणापि ते ययुः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003767084, "chapter_id": 23767, "verse_number": "२-२-११-८५", "content_sanskrit": "इन्द्रद्युम्नोऽपि राजेन्द्रः समस्तपुरवासिभिः ।\nचतुरंगानीकिनीभिः सहर्षाभिश्च वेष्टितः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003767085, "chapter_id": 23767, "verse_number": "२-२-११-८६", "content_sanskrit": "श्रेणीभूतक्षितिपतिस्यन्दनावलिमध्यगे ।\nरथे रराज राजर्षिः शक्रतुल्य परिच्छदः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003767086, "chapter_id": 23767, "verse_number": "२-२-११-८७", "content_sanskrit": "पुरस्त्रीमङ्गलाचारगीतलाजप्रसूनकैः ।\nमङ्गलाचारशोभाभिः प्रसन्नशुभचेतनः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003767087, "chapter_id": 23767, "verse_number": "२-२-११-८८", "content_sanskrit": "वातरंहैर्हयैर्युक्तरथेन प्रययौ मुदा ।\nअनुकूलानिलप्रोद्यद्घनच्छायसुशीतले ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003767088, "chapter_id": 23767, "verse_number": "२-२-११-८९", "content_sanskrit": "नीरजस्के महीपृष्ठे समीकृतचतुष्पथे ।\nदेशाध्वनीनैः पुरुषैः काननांतरवेदिभिः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003767089, "chapter_id": 23767, "verse_number": "२-२-११-९०", "content_sanskrit": "आदिष्टवर्त्मा नृपतिर्मार्गस्योभयपार्श्वगान् ।\nदेशानरण्यानि मुहुःपश्यन्नानन्दलोचनः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003767090, "chapter_id": 23767, "verse_number": "२-२-११-९१", "content_sanskrit": "सीमामुत्कलदेशस्य विभजंतीं वनांतरे ।\nमार्गस्थां चर्चिकां प्राप चर्चितां मुंडमालया ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003767091, "chapter_id": 23767, "verse_number": "२-२-११-९२", "content_sanskrit": "अवतीर्य रथाद्राजा विनतो नारदाज्ञया ।\nसाष्टांगपातं तां नत्वा तुष्टावानंदचेतनः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003767092, "chapter_id": 23767, "verse_number": "२-२-११-९३", "content_sanskrit": "इन्द्रद्युम्न उवाच ।\nनमस्ते त्रिदशेशानि सर्वापद्विनिवारिणि ।\nब्रह्मविष्णुशिवाद्याभिः कल्पनाभिरुदीरिते ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003767093, "chapter_id": 23767, "verse_number": "२-२-११-९४", "content_sanskrit": "कारणं जगतामाद्ये प्रसीद परमेश्वरि ।\nत्वया विना जगन्नैतत्क्षणमुत्सहते शिवे ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003767094, "chapter_id": 23767, "verse_number": "२-२-११-९५", "content_sanskrit": "सिद्धयः सर्वकार्याणां मंगलानि च शाश्वते ।\nत्वत्पादाराधनफलं मर्त्यलोके हि नान्यथा ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003767095, "chapter_id": 23767, "verse_number": "२-२-११-९६", "content_sanskrit": "चराचरपतेर्विष्णोः शक्तिस्त्वं परमेश्वरि ।\nयया सृजत्यवति च जगत्संहरते विभुः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003767096, "chapter_id": 23767, "verse_number": "२-२-११-९७", "content_sanskrit": "चराचरगुरुं देवं नीलाचलनिवासिनम् ।\nअनुगृह्णीष्व मां देवि यथा पश्ये स्वचक्षुषा ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003767097, "chapter_id": 23767, "verse_number": "२-२-११-९८", "content_sanskrit": "जैमिनिरुवाच ।\nनारदस्योपदेशेन स्तुत्वा देवीं नराधिपः ।\nआरुरोह रथं तूर्णं विवस्वानुदयं यथा ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003767098, "chapter_id": 23767, "verse_number": "२-२-११-९९", "content_sanskrit": "ततः प्रतस्थे तरसा स राजा श्रांतवाहनः ।\nचित्रोत्पलमहानद्यास्तीरे विरलकानने ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003767099, "chapter_id": 23767, "verse_number": "२-२-११-१००", "content_sanskrit": "धातुकन्दरविख्याते न्यवेशयदनीकिनीम् ।\nअपराह्णक्रियां कर्तुं यावदाह्निकमादृतः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003767100, "chapter_id": 23767, "verse_number": "२-२-११-१०१", "content_sanskrit": "जलावतरणे नद्यां विवेश स्वपुरोधसा ।\nपूर्वं संशोधिते प्राज्ञैर्विषकण्टकवर्जिते ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003767101, "chapter_id": 23767, "verse_number": "२-२-११-१०२", "content_sanskrit": "स्नात्वा संतर्प्य देवांश्च पितॄनथ विशांपतिः ।\nसंपूज्य विधिवद्विष्णुं नृपतीन्प्रकृतीस्ततः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003767102, "chapter_id": 23767, "verse_number": "२-२-११-१०३", "content_sanskrit": "संमानयामास नृपः संनिवेशासनादिभिः ।\nनारदेन सह श्रीमान्प्रविश्यांतःपुरं ततः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003767103, "chapter_id": 23767, "verse_number": "२-२-११-१०४", "content_sanskrit": "सुधारसानि भोज्यानि बुभुजे प्रीतमानसः ।\nपश्चिमाद्रिं ततो याते विवस्वति विशांपतिः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003767104, "chapter_id": 23767, "verse_number": "२-२-११-१०५", "content_sanskrit": "सायं विधिं समाप्याशु शीतभानौ समुद्यते ।\nअनुजीविविशां नाथः सभामध्य उपाविशत् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003767105, "chapter_id": 23767, "verse_number": "२-२-११-१०६", "content_sanskrit": "तत्र तस्मिन्नरपतिर्बभौ सात्राज्यलक्षणः ।\nसंपूर्णमंडलश्चन्द्रो ज्योतिषामिव शारदः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003767106, "chapter_id": 23767, "verse_number": "२-२-११-१०७", "content_sanskrit": "कवयः कवयांचकुः कीर्तिं तस्य सुधामलाम् ।\nजगुर्गाथां सुग्रथितां गायकाः कलसुस्वराः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003767107, "chapter_id": 23767, "verse_number": "२-२-११-१०८", "content_sanskrit": "रूपयौवनलावण्यगर्विता गणिकास्ततः ।\nलयतानांगहारैश्च सुशुद्धैर्ननृतुः पुरः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003767108, "chapter_id": 23767, "verse_number": "२-२-११-१०९", "content_sanskrit": "मागधास्तुष्टुवुश्चैनं लोकोत्तरशुभाकृतिम् ।\nगद्यपद्यप्रबन्धाद्यैश्चित्रैः पदकदम्बकैः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003767109, "chapter_id": 23767, "verse_number": "२-२-११-११०", "content_sanskrit": "ततः स राजा प्रानर्च वैष्णवाग्र्यान्सभासदः ।\nसुसंमतैर्गंधमाल्यतांबूलैरतिशोभनैः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003767110, "chapter_id": 23767, "verse_number": "२-२-११-१११", "content_sanskrit": "नृपांश्च शतशस्तत्र सुखासीनान्नृपाज्ञया ।\nसंभावयामास यथायोग्यं नृपतिभाजनैः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003767111, "chapter_id": 23767, "verse_number": "२-२-११-११२", "content_sanskrit": "अथापृच्छन्मुनिवरं नारदं भगवत्प्रियम् ।\nसिंहासनार्हे स्वासीनं बहुमानपुरःसरम् ।\nभगवच्चरितं श्रोतुं सर्वपापापनोदनम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003767112, "chapter_id": 23767, "verse_number": "२-२-११-११३", "content_sanskrit": "इन्द्रद्युम्न उवाच ।\nभगवन्वेदवेदांगनिधान भगवत्प्रिय ।\nत्वमेव चरितं विष्णोर्जानासि ज्ञानचक्षुषा ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003767113, "chapter_id": 23767, "verse_number": "२-२-११-११४", "content_sanskrit": "हरेश्चारित्रसुधया दृढपंकमलीमसम् ।\nक्षालयांतर्मम मुने यद्यनुक्रोशको मयि ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003767114, "chapter_id": 23767, "verse_number": "२-२-११-११५", "content_sanskrit": "इत्थमालापसंमिश्रे मुनिराज्ञोः कथांतरे ।\nप्रविवेश नृपं द्वाःस्थ उत्कलेशप्रसेवकः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003767115, "chapter_id": 23767, "verse_number": "२-२-११-११६", "content_sanskrit": "उवाच देवद्वारांते तिष्ठत्युत्कलभूमिपः ।\nसोपायनो देवपादपद्मं द्रष्टुं समौलिकः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003767116, "chapter_id": 23767, "verse_number": "२-२-११-११७", "content_sanskrit": "विज्ञापितः स राजर्षि द्वास्थेनैवं ससंभ्रमः ।\nउवाच तं हि भो विप्राः श्रुत्वा तद्देशमण्डनम् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003767117, "chapter_id": 23767, "verse_number": "२-२-११-११८", "content_sanskrit": "क्षेत्रं श्रीपुरुषेशस्य तद्वार्त्ताकर्णनोत्सुकः ।\nप्रवेशयाविलंबं तं श्रीमदोढ्रमहीपतिम् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003767118, "chapter_id": 23767, "verse_number": "२-२-११-११९", "content_sanskrit": "स हि नीलगिरौ विष्णुं समाराध्य सुनिर्मलः ।\nयस्य संदर्शनात्सर्वे भविष्यामो हतांहसः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003767119, "chapter_id": 23767, "verse_number": "२-२-११-१२०", "content_sanskrit": "श्रुत्वा तद्वचनं सद्यो द्वारपालो महीपतिम् ।\nप्रवेशयामास सभामिंद्रद्युम्नस्य भूपतेः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003767120, "chapter_id": 23767, "verse_number": "२-२-११-१२१", "content_sanskrit": "विवेशोढ्रपतिस्तूर्णं सचिवैवैर्ष्णवैः सह ।\nननामांघ्रियुगं वन्द्यमिन्द्रद्युम्नस्य सादरम् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003767121, "chapter_id": 23767, "verse_number": "२-२-११-१२२", "content_sanskrit": "युगं वन्द्यमिन्द्रद्युम्नस्य सादरम् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003767122, "chapter_id": 23767, "verse_number": "२-२-११-१२३", "content_sanskrit": "तमुत्थाप्य च राजेंद्रः पुरस्कृत्य स वैष्णवम् ।\nस्वासनांते निवेश्याथ प्रोचे सप्रश्रयं वचः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003767123, "chapter_id": 23767, "verse_number": "२-२-११-१२४", "content_sanskrit": "राजन्सर्वत्र कुशली भवानोढ्रपते किल ।\nअपि देवो विजयते नीलाद्रिशिखरालयः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003767124, "chapter_id": 23767, "verse_number": "२-२-११-१२५", "content_sanskrit": "कच्चित्ते निर्मला बुद्धिर्भगवत्पादपद्मयोः ।\nउपैति समचित्तस्य सर्वभूतेषु ते हरौ ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003767125, "chapter_id": 23767, "verse_number": "२-२-११-१२६", "content_sanskrit": "ओढ्राधीशस्तदा तस्य वचः श्रुत्वा कृतांजलिः ।\nउवाच प्रश्रितं वाक्यं हर्षविस्मयचंचुकः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003767126, "chapter_id": 23767, "verse_number": "२-२-११-१२७", "content_sanskrit": "स्वामिन्सर्वत्र कुशलं त्वत्पादानुग्रहान्मम ।\nसूर्ये तपत्यंधकारः कथं वा प्रभविष्यति ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003767127, "chapter_id": 23767, "verse_number": "२-२-११-१२८", "content_sanskrit": "निसर्गगुणसंसर्गवशीकृतमहीभुजा ।\nत्वया सनाथा पृथिवी जिष्णुनेवामरावती ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003767128, "chapter_id": 23767, "verse_number": "२-२-११-१२९", "content_sanskrit": "सदा धर्मश्चतुष्पादस्त्वयि शासति मेदिनीम् ।\nनिषेधाचरण राजन्केवलं श्रूयते श्रुतौ ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003767129, "chapter_id": 23767, "verse_number": "२-२-११-१३०", "content_sanskrit": "राजनीतिषु ये राज्ञां गुणाः समुदितास्त्वयि ।\nत एकैकं क्षितिभुजां गता दार्ष्टांतिकं विभो ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003767130, "chapter_id": 23767, "verse_number": "२-२-११-१३१", "content_sanskrit": "एतावदपि साम्राज्यं दुर्लभं ते नृपोत्तम ।\nअष्टादशद्वीपवती क्षितिरेकगृहोपमा ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003767131, "chapter_id": 23767, "verse_number": "२-२-११-१३२", "content_sanskrit": "यदि त्वां नासृजद्ब्रह्मा वत्सलं सर्वजंतुषु ।\nकथं शोकविहीनाः स्युर्मृतेष्वात्मजबंधुषु ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003767132, "chapter_id": 23767, "verse_number": "२-२-११-१३३", "content_sanskrit": "साधारणा नृपतयो विष्णोरंशा इति श्रुतिः ।\nभवान्साक्षात्तु भगवान्कोऽन्य ईदृग्गुणाकरः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7003767133, "chapter_id": 23767, "verse_number": "२-२-११-१३४", "content_sanskrit": "दक्षिणोदधि तीरेऽस्ति नीलाद्रिः काननावृतः ।\nन तत्र लोकसंचारस्तत्रास्ते साऽपि देवता ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7003767134, "chapter_id": 23767, "verse_number": "२-२-११-१३५", "content_sanskrit": "वात्यया वालुकाकीर्णः सांप्रतं श्रूयते तु सः ।\nतद्वशान्मम राज्येऽपि दुर्भिक्षमरकादिकम् ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7003767135, "chapter_id": 23767, "verse_number": "२-२-११-१३६", "content_sanskrit": "त्वय्यागते तु सर्वस्मिन्कुशलं मे भविष्यति ।\nइत्युक्तवंतं नृपतिरुत्कलेशं द्विजोत्तमाः ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7003767136, "chapter_id": 23767, "verse_number": "२-२-११-१३७", "content_sanskrit": "विसर्जयामास तदा संनिवेशाय मानयन् ।\nनारदं प्रेक्ष्य निर्विण्णः किमेतदिति भो मुने ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7003767137, "chapter_id": 23767, "verse_number": "२-२-११-१३८", "content_sanskrit": "यदर्थं मे श्रमस्तं च विफलं हि वितर्कये ।\nइत्युक्तवंतं तं प्राह नारदस्तु त्रिकालवित् ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7003767138, "chapter_id": 23767, "verse_number": "२-२-११-१३९", "content_sanskrit": "न कार्यो विस्मयस्तेऽत्र भाग्यवान्वैष्णवोत्तमः ।\nवैष्णवानां न वांछा हि विफला जायते क्वचित् ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7003767139, "chapter_id": 23767, "verse_number": "२-२-११-१४०", "content_sanskrit": "अवश्यं प्रेक्षसे राजन्बिभ्रतं पार्थिवं वपुः ।\nकारणं जगतामादिं नारायणमनामयम् ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7003767140, "chapter_id": 23767, "verse_number": "२-२-११-१४१", "content_sanskrit": "त्वदनुग्रहहेतोर्वै क्षिताववतरिष्यति ।\nजगच्चराचरं सर्वं विष्णोर्वशमुपागतम् ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7003767141, "chapter_id": 23767, "verse_number": "२-२-११-१४२", "content_sanskrit": "न कस्यापि वशे सोऽपि परमात्मा सनातनः ।\nकेवलं भक्तिवशगो भगवान्भक्तवत्सलः ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7003767142, "chapter_id": 23767, "verse_number": "२-२-११-१४३", "content_sanskrit": "ब्रह्मादिकीटपर्यंतं सुगुप्तं यस्य मायया ।\nस कथं परतंत्रः स्यादृते भक्तजनान्नृप ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7003767143, "chapter_id": 23767, "verse_number": "२-२-११-१४४", "content_sanskrit": "धर्मार्थकाममोक्षाणां मूलं भक्तिर्मुरद्विषः ।\nसैव तद्ग्रहणोपायस्तामृते नास्ति किंचन ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7003767144, "chapter_id": 23767, "verse_number": "२-२-११-१४५", "content_sanskrit": "एक एव यदा विष्णुर्बहुधा स्वस्य मायया ।\nतमृते परमात्मानं सुखहेतुर्न विद्यते ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7003767145, "chapter_id": 23767, "verse_number": "२-२-११-१४६", "content_sanskrit": "येऽप्यन्ये शिवदुर्गाद्यास्तैस्तैः कर्मभिरावृताः ।\nयच्छंति पूजिताः कामं तेऽपि विष्णुपरायणाः ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7003767146, "chapter_id": 23767, "verse_number": "२-२-११-१४७", "content_sanskrit": "अन्तर्यामी स भगवान्देवानामपि हृत्स्थितः ।\nयावत्फलं प्रेरयति तावदेव ददत्यमी ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7003767147, "chapter_id": 23767, "verse_number": "२-२-११-१४८", "content_sanskrit": "वैष्णवस्त्वं च राजेंद्र पद्मयोनेश्च पंचमः ।\nअष्टादशानां विद्यानां पारगो वृत्तसंस्थितः ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7003767148, "chapter_id": 23767, "verse_number": "२-२-११-१४९", "content_sanskrit": "न्यायेन रक्षिता पृथ्वीं विशेषाद्ब्राह्मणार्चकः ।\nअवश्यं द्रक्ष्यसि क्षेत्रे वैकुण्ठं चर्मचक्षुषा ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7003767149, "chapter_id": 23767, "verse_number": "२-२-११-१५०", "content_sanskrit": "पितामहोऽप्यत्र कार्ये भवतो मां नियुक्तवान् ।\nसर्वं ते कथयिष्यामि प्राप्ते क्षेत्रोत्तमे नृप ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7003767150, "chapter_id": 23767, "verse_number": "२-२-११-१५१", "content_sanskrit": "सांप्रतं रात्रिशेषो हि तृतीयं याममृच्छति ।\nस्वान्तान्निवेशान्निर्गंतुं राज्ञ आज्ञापयाधुना ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7003767151, "chapter_id": 23767, "verse_number": "२-२-११-१५२", "content_sanskrit": "त्वमप्यंतर्गृहं याहि निद्राया वशमागतः ॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7003767152, "chapter_id": 23767, "verse_number": "२-२-११-१५३", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे पुरुषोत्तमक्षेत्रमाहात्म्ये जैमिनिऋषि संवाद एकादशोऽध्यायः ॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}]