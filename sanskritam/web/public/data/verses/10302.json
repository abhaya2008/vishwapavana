[{"id": 6000302000, "chapter_id": 10302, "verse_number": null, "content_sanskrit": "भगवद्बादरायणप्रणीतं श्रीमद्भागवतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000302001, "chapter_id": 10302, "verse_number": null, "content_sanskrit": "प्रथमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 6000302002, "chapter_id": 10302, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.001.m4a", "display_order": 3}, {"id": 6000302003, "chapter_id": 10302, "verse_number": "११-१-१", "content_sanskrit": "कृत्वा दैत्यवधं कृष्णः सरामो यदुभिर्वृतः।\nभुवोऽवतारयन् भारं जविष्ठं जनयन् कलिम्॥ ११/१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.002.m4a", "display_order": 4, "topics": [{"text": "शुकाचार्येण राज्ञे यदुकुलसंक्षयं वक्तुम् ऋषिदत्तयदुकुमारशापदानकथनम्", "range": "१–७"}]}, {"id": 6000302004, "chapter_id": 10302, "verse_number": "११-१-२", "content_sanskrit": "ये कोपिताः सुबहु पाण्डुसुताः सपत्नैर्दुर्द्यूतहेलनकचग्रहणादिभिस्तान्।\nकृत्वा निमित्तमितरेतरतः समेतान् हत्वा परान् निरहरत् क्षितिभारमीशः॥ ११/१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.003.m4a", "display_order": 5}, {"id": 6000302005, "chapter_id": 10302, "verse_number": "११-१-३", "content_sanskrit": "भूभारराजपृतना यदुभिर्निरस्य गुप्तैः स्वबाहुभिरचिन्तयदप्रमेयः।\nमन्येऽवनेर्ननु गतोऽप्यगतोऽपि भारो यद् यादवं कुलमहो अविषह्यमास्ते॥ ११/१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.004.m4a", "display_order": 6}, {"id": 6000302006, "chapter_id": 10302, "verse_number": "११-१-४", "content_sanskrit": "नैवान्यतः परिभवोऽस्य भवेत् कथञ्चित् मत्संश्रयस्य विभवोन्नहनस्य नित्यम्।\nअन्तःकलिं यदुकुलस्य विधाय वेणुसङ्घस्य वह्निमिव शान्तिमुपैमि धाम॥ ११/१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.005.m4a", "display_order": 7}, {"id": 6000302007, "chapter_id": 10302, "verse_number": "११-१-५", "content_sanskrit": "एवं व्यवसितो राजन् सत्यसङ्कल्प ईश्वरः।\nशापव्याजेन विप्राणां सञ्जह्रे स्वकुलं विभुः॥ ११/१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.006.m4a", "display_order": 8}, {"id": 6000302008, "chapter_id": 10302, "verse_number": "११-१-६", "content_sanskrit": "स्वमूर्त्या लोकलावण्यनिर्मुक्त्या लोचनं नृणाम्।\nगीर्भिस्तां स्मरतां चित्तं पदैस्तामीक्षतां क्रियाः॥ ११/१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.007.m4a", "display_order": 9}, {"id": 6000302009, "chapter_id": 10302, "verse_number": "११-१-७", "content_sanskrit": "आच्छिद्य कीर्तिं सुश्लोकां वितन्वन्नञ्जसा नु कौ।\nतमोऽनया तरिष्यन्तीत्यगात् स्वं पदमीश्वरः॥ ११/१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.008.m4a", "display_order": 10}, {"id": 6000302010, "chapter_id": 10302, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.009.m4a", "display_order": 11}, {"id": 6000302011, "chapter_id": 10302, "verse_number": "११-१-८", "content_sanskrit": "ब्रह्मण्यानां वदान्यानां नित्यं वृद्धोपसेविनाम्।\nविप्रशापः कथमभूद् वृष्णीनां कृष्णचेतसाम्॥ ११/१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.010.m4a", "display_order": 12, "topics": [{"text": "कदाचिद्यदुकुमारैः साम्बं स्त्रीवेषेणालंकृत्य इयमन्तर्वत्नी कुमारं प्रसोष्यत्युत कुमारीमिति पिण्डारकक्षेत्रवासिन ऋषीन्प्रति प्रश्नः", "range": "८–१५"}]}, {"id": 6000302012, "chapter_id": 10302, "verse_number": "११-१-९", "content_sanskrit": "यन्निमित्तो यदोः शापो यादृशो द्विजसत्तम।\nकथमेकात्मनां भेद एतत् सर्वं वदस्व मे॥ ११/१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.011.m4a", "display_order": 13}, {"id": 6000302013, "chapter_id": 10302, "verse_number": null, "content_sanskrit": "बादरायणिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.012.m4a", "display_order": 14}, {"id": 6000302014, "chapter_id": 10302, "verse_number": "११-१-१०", "content_sanskrit": "बिभ्रद् वपुः सकलसुन्दरसन्निवेशं कर्माचरन् भुवि सुमङ्गलमाप्तकामः।\nआस्थाय धाम रममाण उदारकीर्तिः संहर्तुमैच्छत कुलं स्थितकृत्यशेषः॥ ११/१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.013.m4a", "display_order": 15}, {"id": 6000302015, "chapter_id": 10302, "verse_number": "११-१-११", "content_sanskrit": "कर्माणि पुण्यनिवहानि सुमङ्गलानि गायज्जगत्कलिमलापहराणि कृत्वा।\nकालात्मना विवसता यदुदेवगेहे पिण्डारकं समगमन् मुनयो निसृष्टाः॥ ११/१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.014.m4a", "display_order": 16}, {"id": 6000302016, "chapter_id": 10302, "verse_number": "११-१-१२", "content_sanskrit": "विश्वामित्रोऽसितः कण्वो दुर्वासा भृगुरङ्गिराः।\nकश्यपो वामदेवोऽत्रिर्वसिष्ठो नारदादयः॥ ११/१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.015.m4a", "display_order": 17}, {"id": 6000302017, "chapter_id": 10302, "verse_number": "११-१-१३", "content_sanskrit": "क्रीडन्तस्तानुपव्रज्य कुमारा यदुनन्दनाः।\nउपसङ्गृह्य पप्रच्छुरविनीता विनीतवत्॥ ११/१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.016.m4a", "display_order": 18}, {"id": 6000302018, "chapter_id": 10302, "verse_number": "११-१-१४", "content_sanskrit": "ते वेषयित्वा स्‍त्रीवेषैः साम्बं जाम्बवतीसुतम्।\nएषा पृच्छति वो विप्रा अन्तर्वत्न्यसितेक्षणा॥ ११/१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.017.m4a", "display_order": 19}, {"id": 6000302019, "chapter_id": 10302, "verse_number": "११-१-१५", "content_sanskrit": "प्रष्टुं विलज्जती युष्मान् प्रब्रूतामोघदर्शनाः।\nप्रसोष्यन्ती पुत्रकामा किंस्वित् सञ्जनयिष्यति॥ ११/१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.018.m4a", "display_order": 20}, {"id": 6000302020, "chapter_id": 10302, "verse_number": "११-१-१६", "content_sanskrit": "एवं प्रलब्धा मुनयस्तानूचुः कुपिता नृप।\nजनयिष्यति वो मन्दा मुसलं कुलनाशनम्॥ ११/१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.019.m4a", "display_order": 21, "topics": [{"text": "इति च्छलिता महर्षयः इयं युष्मत्कुलनाशकमायसं मुसलं प्रसोष्यतीति शेपुः", "range": "१६–२०"}]}, {"id": 6000302021, "chapter_id": 10302, "verse_number": "११-१-१७", "content_sanskrit": "तच्छ्रुत्वा तेऽतिसन्त्रस्ता विमुच्य सहसोदरम्।\nसाम्बस्य ददृशुस्तस्मिन् मुसलं खल्वयस्मयम्॥ ११/१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.020.m4a", "display_order": 22}, {"id": 6000302022, "chapter_id": 10302, "verse_number": "११-१-१८", "content_sanskrit": "किं कृतं मन्दभाग्यैर्नः किं वदिष्यन्ति नो जनाः।\nइति विह्वलिता गेहानादाय मुसलं ययुः॥ ११/१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.021.m4a", "display_order": 23}, {"id": 6000302023, "chapter_id": 10302, "verse_number": "११-१-१९", "content_sanskrit": "तं चोपनीय सदसि परिम्लानमुखश्रियः।\nराज्ञ आवेदयाञ्चक्रुः सर्वयादवसन्निधौ॥ ११/१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.022.m4a", "display_order": 24}, {"id": 6000302024, "chapter_id": 10302, "verse_number": "११-१-२०", "content_sanskrit": "श्रुत्वाऽमोघं विप्रशापं दृष्ट्वा च मुसलं नृप।\nविस्मिता भयसन्त्रस्ता बभूवुर्द्वारकौकसः॥ ११/१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.023.m4a", "display_order": 25}, {"id": 6000302025, "chapter_id": 10302, "verse_number": "११-१-२१", "content_sanskrit": "तच्चूर्णयित्वा मुसलं यदुराजः स आहुकः।\nसमुद्रसलिले प्रास्यल्लोहं चास्यावशेषितम्॥ ११/१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.024.m4a", "display_order": 26, "topics": [{"text": "यथाशप्तमुत्पन्नमायसं मुसलमुग्रसेनः चूर्णयित्वा समुद्रे प्रास्यत्", "range": "२१"}]}, {"id": 6000302026, "chapter_id": 10302, "verse_number": "११-१-२२", "content_sanskrit": "कश्चिन्मत्स्योऽग्रसील्लोहं चूर्णानि तरलैस्ततः।\nऊह्यमानानि वेलायां लग्नान्यासन् किलैरकाः॥ ११/१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.025.m4a", "display_order": 27}, {"id": 6000302027, "chapter_id": 10302, "verse_number": "११-१-२३", "content_sanskrit": "मत्स्यो गृहीतो मत्स्यघ्नैर्जालेनान्यैः सहार्णवे।\nतस्योदरगतं लोहं शल्येषुं लुब्धकोऽकरोत्॥ ११/१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.026.m4a", "display_order": 28, "topics": [{"text": "ते आयसकणाः समुद्रतीरे एरका अभवन्", "range": "२३"}]}, {"id": 6000302028, "chapter_id": 10302, "verse_number": "११-१-२४", "content_sanskrit": "भगवांस्तात सर्वार्थ ईश्वरोऽपि तदन्यथा।\nकर्तुं नैच्छद् विप्रशापं कालरूप्यन्वमोदत॥ ११/१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_001/BhP_11.001.027.m4a", "display_order": 29, "topics": [{"text": "यादवाः परस्परं ताभिरेरकाभिः प्रहृत्य मम्रुः इति", "range": "२४"}]}, {"id": 6000302029, "chapter_id": 10302, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे प्रथमाध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]