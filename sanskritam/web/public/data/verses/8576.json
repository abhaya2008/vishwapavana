[{"id": 900007613, "chapter_id": 8576, "verse_number": "157.1", "content_sanskrit": "ॐ सर्वथाऽपि तु त एवोभयलिङ्गात् ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007614, "chapter_id": 8576, "verse_number": "157.2", "content_sanskrit": "अन्यशब्दो हरिश्रीस्वसमेभ्योऽन्यविवक्षया", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007615, "chapter_id": 8576, "verse_number": "157.3", "content_sanskrit": "रुद्रादिषु च युक्तितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007616, "chapter_id": 8576, "verse_number": "157.4", "content_sanskrit": "बलज्ञानाधिकत्वं तु तेभ्यो हि ब्रह्मणः सदा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900007617, "chapter_id": 8576, "verse_number": "157.5", "content_sanskrit": "आधिक्यस्य त्वनित्यत्वे न किञ्चिन्मानमीयते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900007618, "chapter_id": 8576, "verse_number": "157.6", "content_sanskrit": "शृण्वे वीर उग्रमुग्रं दमायन्नन्यमन्यमतिनेनीयमानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900007619, "chapter_id": 8576, "verse_number": "157.7", "content_sanskrit": "प्रयान्ति परमां सिद्धिमैहिकामुष्मिकीं द्रुतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900007620, "chapter_id": 8576, "verse_number": "157.8", "content_sanskrit": "यद्यनादिविशेषो न साम्प्रतं कथमेव सः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900007621, "chapter_id": 8576, "verse_number": "157.9", "content_sanskrit": "अदृष्टादेव चादृष्टं स्वकीथं सर्ववादिभिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900007622, "chapter_id": 8576, "verse_number": "157.10", "content_sanskrit": "आकस्मिको विश्चेददृष्टे क्वचिदिष्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900007623, "chapter_id": 8576, "verse_number": "157.11", "content_sanskrit": "अदृष्टाच्चेद्विशेषोऽयमनादित्वं कुतो न तत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900007624, "chapter_id": 8576, "verse_number": "157.12", "content_sanskrit": "अदृष्टाच्चेद्विशेषोऽयमनादित्वं कुतो न तत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900007625, "chapter_id": 8576, "verse_number": "157.13", "content_sanskrit": "न चान्यभेदवद्विष्णौ भेदस्तद्दर्शिनामपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]