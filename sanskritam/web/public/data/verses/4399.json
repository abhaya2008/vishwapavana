[{"id": 2156738, "chapter_id": 4399, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2156739, "chapter_id": 4399, "verse_number": "१", "content_sanskrit": "तस्य लालपितं श्रुत्वा वृद्धः कुरुपितामहः ।\nदेशकालोचितं वाक्यं भीष्मः शान्तनवोऽब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2156740, "chapter_id": 4399, "verse_number": "२", "content_sanskrit": "समुद्र इव सिन्धूनां ज्योतिषामिव भास्करः ।\nसत्यस्य च यथा सन्तो बीजानामिव चोर्वरा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2156741, "chapter_id": 4399, "verse_number": "३", "content_sanskrit": "पर्जन्य इव भूतानां प्रतिष्ठा सुहृदां भवान् ।\nबान्धवास्त्वाऽनुजीवन्तु स्वादुवृक्षमिवाण्डजाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2156742, "chapter_id": 4399, "verse_number": "४", "content_sanskrit": "मानहा भव शत्रूणां मित्राणां हर्षवर्धनः ।\nकौरवाणां भव गतिर्यथा विष्णुर्दिवौकसाम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2156743, "chapter_id": 4399, "verse_number": "५", "content_sanskrit": "स्वबाहुबलवीर्येण धार्तराष्ट्रप्रियैषिणा ।\nकर्ण राजपुरं गत्वा काम्बोजा निहतास्त्वया\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2156744, "chapter_id": 4399, "verse_number": "६", "content_sanskrit": "गिरिव्रजगताश्चापि नग्नजित्प्रमुखा नृपाः ।\nअम्बष्ठाश्च विदेहाश्च गान्धाराश्च जितास्त्वया\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2156745, "chapter_id": 4399, "verse_number": "७", "content_sanskrit": "हिमवद्दुर्गनिलयाः किराता रणकर्कशाः ।\nदुर्योधनस्य वशगास्त्वया कर्ण कृताः पुरा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2156746, "chapter_id": 4399, "verse_number": "८", "content_sanskrit": "उत्कला मेकलाः पुण्ड्राः कळिङ्गाद्याश्च संयुगे ।\nनिषादाश्च त्रिगर्ताश्च बाह्लीकाश्च जितास्त्वया\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2156747, "chapter_id": 4399, "verse_number": "९", "content_sanskrit": "तत्र तत्र च सङ्ग्रामे दुर्योधनहितैषिणा ।\nबहवो निर्जिताः कर्ण त्वयाऽर्णवसमौजसा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2156748, "chapter_id": 4399, "verse_number": "१०", "content_sanskrit": "यथा दुर्योधनस्तात सज्ञातिकुलबान्धवः ।\nतथा त्वमपि सर्वेषां कौरवाणां गतिर्भव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2156749, "chapter_id": 4399, "verse_number": "११", "content_sanskrit": "शिवेनाभिवदामि त्वा गच्छ युद्ध्यस्व शत्रुभिः ।\nअनुशास्य कुरून् सर्वान् धत्स्व दुर्योधने जयम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2156750, "chapter_id": 4399, "verse_number": "१२", "content_sanskrit": "भवान् पौत्रसमोऽस्माकं यथा दुर्योधनस्तथा ।\nतवापि धर्मतः सर्वे यथा तस्य वयं तथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2156751, "chapter_id": 4399, "verse_number": "१३", "content_sanskrit": "यौनात् सम्बन्धकाल्लोके विशिष्टः सङ्गमः सताम् ।\nसद्भिः सङ्गममिच्छन्ति तस्मात् प्राज्ञाः परैरपि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2156752, "chapter_id": 4399, "verse_number": "१४", "content_sanskrit": "स सत्यसङ्गरो भूत्वा ममैतदिति निश्चितम् ।\nकुरूणां पालय बलं यथा दुर्योधनस्तथा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2156753, "chapter_id": 4399, "verse_number": "१५", "content_sanskrit": "यथा च कुरवो युद्धे योधयन्ति स्म पाण्डवान् ।\nतथा कर्ण त्वया कार्यं दुर्योधनहितैषिणा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2156754, "chapter_id": 4399, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2156755, "chapter_id": 4399, "verse_number": "१६", "content_sanskrit": "निशम्य वचनं तस्य चरणावभिवाद्य च ।\nययौ वैकर्तनः कर्णः तूर्णमायोधनं प्रति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2156756, "chapter_id": 4399, "verse_number": "१७", "content_sanskrit": "सोऽभिवीक्ष्य नरौघाणां स्थानमप्रतिमं महत् ।\nव्यूढप्रहरणोरस्कं सैन्यं तत् समबृंहयत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2156757, "chapter_id": 4399, "verse_number": "१८", "content_sanskrit": "अथोषसि महेष्वासो व्यादिश्य रथिनोऽयुतम् ।\nवारणांस्तत्प्रमाणेन चकार तदनन्तरम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2156758, "chapter_id": 4399, "verse_number": "१९", "content_sanskrit": "सादिनोऽथ पदातींश्च यथाशास्त्रं बृहस्पतेः ।\nस्थापयामास च ततः पुत्राणां ते जये धृतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2156759, "chapter_id": 4399, "verse_number": "२०", "content_sanskrit": "ततः पक्षौ प्रपक्षौ च विधाय भरतर्षभ ।\nपक्षकोटी पुनर्द्वाभ्यां पश्चाद् द्वाभ्यामबृंहयत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2156760, "chapter_id": 4399, "verse_number": "२१", "content_sanskrit": "एवमेतं महाव्यूहं कर्णेन विहितं पुनः ।\nप्रेक्षणीयममन्यन्त राजानः कुरुभिः सह\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2156761, "chapter_id": 4399, "verse_number": "२२", "content_sanskrit": "नृत्यन्तमिव तं व्यूहं दिधक्षन्तमिवाहितान् ।\nकृतं बृहस्पत्युशनसोः मते कर्णेन दुर्जयम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2156762, "chapter_id": 4399, "verse_number": "२३", "content_sanskrit": "बलं व्यूहशरीरस्य सारानीकं परस्परम् ।\nद्रोणं दृष्ट्वा महेष्वासं युद्धाय समुपस्थितम्\nतमागतं महाबाहुं सर्वानीकपुरःसरम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2156763, "chapter_id": 4399, "verse_number": "२४", "content_sanskrit": "क्ष्वेडितास्फोटिताक्रुष्टैः सिंहनादरवैरपि ।\nधनुःशब्दैश्च विविधैः कुरवः समपूजयन्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2156764, "chapter_id": 4399, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि चतुर्थोऽध्यायः ॥ ४ ॥\nद्रोणाभिषेकपर्वणि चतुर्थोऽध्यायः ॥ ४ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]