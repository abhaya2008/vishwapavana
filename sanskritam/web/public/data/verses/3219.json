[{"id": 2102524, "chapter_id": 3219, "verse_number": "१४-७५-१", "content_sanskrit": "वैशम्पायन उवाच।\nप्राग्ज्योतिषमथाभ्येत्य व्यचरत्स हयोत्तमः।\nभगदत्तात्मजस्तत्र निर्ययौ रणकर्कशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102525, "chapter_id": 3219, "verse_number": "१४-७५-२", "content_sanskrit": "सहयं पाण्डुपुत्रं तु विषयान्तमुपागतम्।\nयुयुधे भरतश्रेष्ठ यज्ञदत्तो महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102526, "chapter_id": 3219, "verse_number": "१४-७५-३", "content_sanskrit": "सोभिनिर्याय नगराद्भगदत्तसुतो नृपः।\nअश्वमायान्तमुन्मथ्य नगराभिमुखो ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102527, "chapter_id": 3219, "verse_number": "१४-७५-४", "content_sanskrit": "तमालक्ष्य महाबाहुः कुरूणामृषभस्तदा।\nगाण्डीवं विक्षिपंस्तूर्णं सहसा समुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102528, "chapter_id": 3219, "verse_number": "१४-७५-५", "content_sanskrit": "ततो गाण्डीवनिर्मुक्तैरिषुभिर्मोहितो नृपः।\nहयमुत्सृज्य तं वीरस्ततः पार्थमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102529, "chapter_id": 3219, "verse_number": "१४-७५-६", "content_sanskrit": "पुनः प्रविश्य नगरं दंशितः स नृपोत्तमः।\nआरुह्य नागप्रवरं निर्ययौ युद्धकाङ्क्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102530, "chapter_id": 3219, "verse_number": "१४-७५-७", "content_sanskrit": "पाण्डुरेणातपत्रेण ध्रियमाणेन मूर्धनि।\nदोधूयता चामरेण श्वेतेन च महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102531, "chapter_id": 3219, "verse_number": "१४-७५-८", "content_sanskrit": "ततः पार्थं समासाद्य पाण्डवानां महारथम्।\nआह्वयामास बीभत्सुं बाल्यान्मोहाच्च संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102532, "chapter_id": 3219, "verse_number": "१४-७५-९", "content_sanskrit": "स वारणं नगप्रख्यं प्रभिन्नकरटामुखम्।\nप्रेषयामास संक्रुद्धः श्वेताश्वं प्रति पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102533, "chapter_id": 3219, "verse_number": "१४-७५-१०", "content_sanskrit": "विक्षरन्तं महामेघं परवारणवारणम्।\nशस्त्रवत्कल्पितं सङ्ख्ये विवशं युद्धदुर्मदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102534, "chapter_id": 3219, "verse_number": "१४-७५-११", "content_sanskrit": "प्रचोद्यमानः स गजस्तेन राज्ञा महाबलः।\nतदाऽङ्कशेन विबभावुत्पतिष्यन्निवाम्बरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102535, "chapter_id": 3219, "verse_number": "१४-७५-१२", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य क्रुद्धो राजन्धनंजयः।\nभूमिष्ठो वारणगतं योधयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102536, "chapter_id": 3219, "verse_number": "१४-७५-१३", "content_sanskrit": "यज्ञदत्तस्ततः क्रुद्धो मुमोचाशु धनंजये।\nतोमरानग्निसङ्काशाञ्शलभानिव वेगितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102537, "chapter_id": 3219, "verse_number": "१४-७५-१४", "content_sanskrit": "अर्जुनस्तानसम्प्राप्तान्गाण्डीवप्रभवैः शरैः।\nद्विधा त्रिधा च चिच्छेद खगमान्खगमैस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102538, "chapter_id": 3219, "verse_number": "१४-७५-१५", "content_sanskrit": "स तान्दृष्ट्वा तथा छिन्नांस्तोमरान्भगदत्तजः।\nइषूनसक्तांस्त्वरितः प्राहिणोत्पाण्डवं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102539, "chapter_id": 3219, "verse_number": "१४-७५-१६", "content_sanskrit": "ततोऽर्जुनस्तूर्णतरं रुक्मपुङ्खानजिह्मगान्।\nप्रेषयामास संक्रुद्धो भगदत्तात्मजं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102540, "chapter_id": 3219, "verse_number": "१४-७५-१७", "content_sanskrit": "स तैर्विद्धो महातेजा यज्ञदत्तो महामृधे।\nभृशाहतः पपातोर्व्यां न त्वेनमजहात्स्मृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102541, "chapter_id": 3219, "verse_number": "१४-७५-१८", "content_sanskrit": "ततः स पुनरारुह्य वारणप्रवरं रणे।\nअव्यग्रः प्रेषयामास जयार्थी विजयं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102542, "chapter_id": 3219, "verse_number": "१४-७५-१९", "content_sanskrit": "तस्मै बाणांस्ततो जिष्णुर्निर्मुक्ताशीविषोपमान्।\nप्रेषयामास संक्रुद्धो ज्वलितज्वलनोपमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102543, "chapter_id": 3219, "verse_number": "१४-७५-२०", "content_sanskrit": "स तैर्विद्धो महानागो विस्रवन्रुधिरं बभौ।\nहिमवानिव शैलेन्द्रो बहुप्रस्रवणस्तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102544, "chapter_id": 3219, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि पञ्चसप्ततितमोऽध्यायः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]