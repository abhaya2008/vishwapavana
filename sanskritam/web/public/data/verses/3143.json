[{"id": 2100050, "chapter_id": 3143, "verse_number": "१३-२७३-१", "content_sanskrit": "वैशम्पायन उवाच।\nततः कुन्तीसुतो राजा पौरजानपदं जनम्।\nपूजयित्वा यथान्यायमनुजज्ञे गृहान्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100051, "chapter_id": 3143, "verse_number": "१३-२७३-२", "content_sanskrit": "सान्त्वयामास नारीश्च हतपुत्रा हतेश्वराः।\nविपुलैरर्थदानैः स तदा पाण्डुसुतो नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100052, "chapter_id": 3143, "verse_number": "१३-२७३-३", "content_sanskrit": "सोभिषिक्तो महाप्राज्ञः प्राप्य राज्यं युधिष्ठिरः।\nअवस्थाप्य नरश्रेष्ठः सर्वाः स्वप्रकृतीस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100053, "chapter_id": 3143, "verse_number": "१३-२७३-४", "content_sanskrit": "द्विजेभ्यो बलमुख्येभ्यो नैगमेभ्यश्च सर्वशः।\nप्रतिगृह्याशिषो मुख्यास्तथा धर्मभृतांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100054, "chapter_id": 3143, "verse_number": "१३-२७३-५", "content_sanskrit": "उषित्वा शर्वरीः श्रीमान्पञ्चाशन्नगरोत्तमे।\nसमयं कौरवाग्र्यस्य सस्मार पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100055, "chapter_id": 3143, "verse_number": "१३-२७३-६", "content_sanskrit": "स निर्ययौ जगपुराद्यजकैः परिवारितः।\nदृष्ट्वा निवृत्तमादित्यं प्रवृत्तं चोत्तरायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100056, "chapter_id": 3143, "verse_number": "१३-२७३-७", "content_sanskrit": "घृतं माल्यं च गन्धांश्च क्षौमाणि च युधिष्ठिरः।\nचन्दनागरुमुख्यानि तथा कालगरूणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100057, "chapter_id": 3143, "verse_number": "१३-२७३-८", "content_sanskrit": "प्रस्थाप्यच पूर्वं कौन्तेयो भीष्मसंस्करणाय वै।\nमाल्यानि च वरार्हाणि रत्नानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100058, "chapter_id": 3143, "verse_number": "१३-२७३-९", "content_sanskrit": "धृतराष्ट्रं पुरुस्कृत्य गान्धारीं च यशस्विनीम्।\nमातरं च पृथां धामान्भ्रातॄंश्च पुरुषर्षंभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100059, "chapter_id": 3143, "verse_number": "१३-२७३-१०", "content_sanskrit": "जनार्दनेनानुगतो विदुरेण च धीमता।\nयुयुत्सुना च कौरव्यो युयुधानेन चाभिभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100060, "chapter_id": 3143, "verse_number": "१३-२७३-११", "content_sanskrit": "महता राजभोगेन पारिबर्हेण संवृतः।\nस्तूयमानो महातेजा भीष्मिस्याग्नीननुव्रजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100061, "chapter_id": 3143, "verse_number": "१३-२७३-१२", "content_sanskrit": "निश्चक्राम पुरात्तस्माद्यथा देवपतिस्तथा।\nआससाद कुरुक्षेत्रे ततः शान्तनवं नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100062, "chapter_id": 3143, "verse_number": "१३-२७३-१३", "content_sanskrit": "उपास्यमानं व्यासेन पाराशर्येण धीमता।\nनारदेन च राजर्षे देवलेनासितेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100063, "chapter_id": 3143, "verse_number": "१३-२७३-१४", "content_sanskrit": "हतशिष्टैर्नृपैस्चान्यैर्नानादेशसमागतैः।\nरक्षिभिश्च महात्मानं रक्ष्यमाणं समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100064, "chapter_id": 3143, "verse_number": "१३-२७३-१५", "content_sanskrit": "शयानं वीरशयने ददर्श नृपतिस्ततः।\nततो रथादवारोहद्धातृभिः सह धर्मराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100065, "chapter_id": 3143, "verse_number": "१३-२७३-१६", "content_sanskrit": "अभिवाद्याथ कौन्तेयः पितामहमरिंदमम्।\nद्वैपायनादीन्विप्रांश्च तैश्च प्रत्यभिनन्दितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100066, "chapter_id": 3143, "verse_number": "१३-२७३-१७", "content_sanskrit": "ऋत्विग्भिर्ब्रह्मकल्पैश्च भ्रातृभिः सह धर्मजः।\nआसाद्य शरतल्पस्थमृषिभिः परिवारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100067, "chapter_id": 3143, "verse_number": "१३-२७३-१८", "content_sanskrit": "अब्रवीद्भरतश्रेष्ठं धर्मराजो युधिष्ठिरः।\nभ्रातृभिः सह कौरव्यः शयानं निम्नगासुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100068, "chapter_id": 3143, "verse_number": "१३-२७३-१९", "content_sanskrit": "युधिष्ठिरोऽहं नृपते नमस्ते जाह्नवीसुत।\nशृणोषि चेन्महाबाहो ब्रूहि किं करवाणि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100069, "chapter_id": 3143, "verse_number": "१३-२७३-२०", "content_sanskrit": "प्राप्तोस्मि समये राजन्नग्नीनादाय ते विभो।\nआचार्यान्ब्राह्मणांश्चैव ऋत्विजो भ्रातरश्च मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100070, "chapter_id": 3143, "verse_number": "१३-२७३-२१", "content_sanskrit": "पुत्रश्च ते महातेजा धृतराष्ट्रो जनेश्वरः।\nउपस्थितः सहामात्यो वासुदेवश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100071, "chapter_id": 3143, "verse_number": "१३-२७३-२२", "content_sanskrit": "हतशिष्टाश्च राजानः सर्वे च कुरुजाङ्गलाः।\nतान्पश्य नरशार्दूल समुन्मीलय लोचने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100072, "chapter_id": 3143, "verse_number": "१३-२७३-२३", "content_sanskrit": "यच्चेह किञ्चित्कर्तव्यं तत्सर्वं प्रापितं मया।\nयथोक्तं भवता काले सर्वमेव च तत्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100073, "chapter_id": 3143, "verse_number": "१३-२७३-२४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100074, "chapter_id": 3143, "verse_number": "१३-२७३-२४", "content_sanskrit": "एवमुक्तस्तु गाङ्गेयः कुन्तीपुत्रेण धीमता।\nददर्श भारतान्सर्वान्स्थितान्सम्परिवार्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100075, "chapter_id": 3143, "verse_number": "१३-२७३-२५", "content_sanskrit": "ततश्चलवपुर्भीष्मः प्रगृह्य विपुलं भुजम्।\nओघमेघस्वरो वाग्मी काले वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100076, "chapter_id": 3143, "verse_number": "१३-२७३-२६", "content_sanskrit": "दिष्ट्या प्राप्तोसि कौन्तेय सहामात्यो युधिष्ठिर।\nपरिवृत्तो हि भगवान्सहस्रांशुर्दिवाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2100077, "chapter_id": 3143, "verse_number": "१३-२७३-२७", "content_sanskrit": "अष्टपञ्चाशतं रात्र्यः शयानस्याद्य मे गताः।\nशरेषु निशिताग्नेषु यथा वर्षशतं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2100078, "chapter_id": 3143, "verse_number": "१३-२७३-२८", "content_sanskrit": "माघोऽयं समनुप्राप्तो मासः पुण्यो युधिष्ठिर।\nत्रिभागशेषः पक्षोऽयं शुक्लो भवितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2100079, "chapter_id": 3143, "verse_number": "१३-२७३-२९", "content_sanskrit": "एवमुक्त्वा तु गाङ्गेयो धर्मपुत्रं युधिष्ठिरम्।\nधृतराष्ट्रमथामन्त्र्य काले वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2100080, "chapter_id": 3143, "verse_number": "१३-२७३-३०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2100081, "chapter_id": 3143, "verse_number": "१३-२७३-३०", "content_sanskrit": "राजन्विदितधर्मोसि सुनिर्णीतार्थसंशयः।\nबहुश्रुता हि ते विप्रा बहवः पर्युपासिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2100082, "chapter_id": 3143, "verse_number": "१३-२७३-३१", "content_sanskrit": "वेद शास्त्राणि सूक्ष्माणि धर्मांश्च मनुजेश्वर।\nवेदांश्च चतुरः सर्वान्षडङ्गैरुपबृंहितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2100083, "chapter_id": 3143, "verse_number": "१३-२७३-३२", "content_sanskrit": "न शोचितव्यं कौरव्य भवितव्यं हि तत्तथा।\nश्रुतं देवरहस्यं ते कृष्णद्वैपायनादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2100084, "chapter_id": 3143, "verse_number": "१३-२७३-३३", "content_sanskrit": "यथा पाण्डोः सुता राजंस्तथैव तव धर्मतः।\nतान्पालय स्थितो धर्मे गुरुशुश्रूषणे रतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2100085, "chapter_id": 3143, "verse_number": "१३-२७३-३४", "content_sanskrit": "धर्मराजो हि शुद्धात्मा निदेशे स्थास्यते तव।\nआनृशंस्यपरं ह्येन जानामि गुरुवत्सलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2100086, "chapter_id": 3143, "verse_number": "१३-२७३-३५", "content_sanskrit": "तव पुत्रा दुरात्मानः क्रोधलोभपरायणाः।\nईर्ष्याभिभूता दुर्वृत्तास्तान्न शोचितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2100087, "chapter_id": 3143, "verse_number": "१३-२७३-३६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2100088, "chapter_id": 3143, "verse_number": "१३-२७३-३६", "content_sanskrit": "एतावधुक्त्वा वचनं धृतराष्ट्रं मनीषिणम्।\nवासुदेवं महाबाहुमभ्यभाषय कौरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2100089, "chapter_id": 3143, "verse_number": "१३-२७३-३७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2100090, "chapter_id": 3143, "verse_number": "१३-२७३-३७", "content_sanskrit": "भगवन्देवदेवेश सुरासुरनमस्कृत।\nत्रिविक्रम नमस्तुभ्यं शङ्खचक्रगदाधर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2100091, "chapter_id": 3143, "verse_number": "१३-२७३-३८", "content_sanskrit": "वासुदेवो हिरण्यात्मा पुरुषः सविता विराद्।\nजीवभूतोऽनुरूपस्त्वं परमात्मा सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2100092, "chapter_id": 3143, "verse_number": "१३-२७३-३९", "content_sanskrit": "त्वद्भक्तं त्वद्गतिं शान्तमुदारमपरिग्रहम्।\nत्रायस्व पुण्डरीकाक्ष पुरुषोत्तम नित्यशः।\nअनुजानीहि मां कृष्ण वैकुण्ठ पुरुषोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2100093, "chapter_id": 3143, "verse_number": "१३-२७३-४०", "content_sanskrit": "रक्ष्याश्च ते पाण्डवेया भवान्येषां परायणम्।\nउक्तवानस्मि दुर्बद्धिं मन्दं दुर्योधनं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2100094, "chapter_id": 3143, "verse_number": "१३-२७३-४१", "content_sanskrit": "यतः कृष्णस्ततो धर्मो यतो धर्मस्ततो जयः।\nवासुदेवेन तीर्थेन पुत्र संशाम्य पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2100095, "chapter_id": 3143, "verse_number": "१३-२७३-४२", "content_sanskrit": "सन्धानस्य परः कालस्तवेति च पुनःपुनः।\nन च मे तद्वचो मूढः कृतवान्स सुमन्दधीः।\nघातयित्वेह पृथिवीं ततः स निधनं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2100096, "chapter_id": 3143, "verse_number": "१३-२७३-४३", "content_sanskrit": "त्वां तु जानाम्यहं देवं पुराणमृषिसत्तमम्।\nनरेण सहितं देव बदर्यां सुचिरोषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2100097, "chapter_id": 3143, "verse_number": "१३-२७३-४४", "content_sanskrit": "तथा मे नारदः प्राह व्यासश्च सुमहातपाः।\nनरनारायणावेतौ सम्भूतौ मनुजेष्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2100098, "chapter_id": 3143, "verse_number": "१३-२७३-४५", "content_sanskrit": "स मां त्वमनुजानीहि कृष्ण मोक्ष्ये कलेवरम्।\nत्वयाऽहं समनुज्ञातो गच्छेयं परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2100099, "chapter_id": 3143, "verse_number": "१३-२७३-४६x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2100100, "chapter_id": 3143, "verse_number": "१३-२७३-४६", "content_sanskrit": "अनुजानामि भीष्म त्वां वसून्प्राप्नुहि पार्थिव।\nन तेऽस्ति वृजिनं किञ्चिच्छुद्धात्मैश्वर्यसंयुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2100101, "chapter_id": 3143, "verse_number": "१३-२७३-४७", "content_sanskrit": "पितृभक्तोसि राजर्षे मार्कण्डेय इवापरः।\nतेन मृत्युस्तव वशे स्थितो भृत्य इवानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2100102, "chapter_id": 3143, "verse_number": "१३-२७३-४८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2100103, "chapter_id": 3143, "verse_number": "१३-२७३-४८", "content_sanskrit": "एवमुक्तस्तु गाङ्गेयः पाण्डवानिदमब्रवीत्।\nधृतराष्ट्रमुखांश्चापि सर्वांश्च सुहृदस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2100104, "chapter_id": 3143, "verse_number": "१३-२७३-४९", "content_sanskrit": "प्राणानुत्स्रष्टुमिच्छामि तत्रानुज्ञातुमर्हथ।\nसत्येषु यतितव्यं वः सत्यं हि परमं बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2100105, "chapter_id": 3143, "verse_number": "१३-२७३-५०", "content_sanskrit": "आनृशंस्यपरैर्भाव्यं सदैव नियतात्मभिः।\nब्रह्मण्यैर्धर्मशीलैश्च तपोनित्यैश्च भारताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2100106, "chapter_id": 3143, "verse_number": "१३-२७३-५१", "content_sanskrit": "इत्युक्त्वा सुहृदः सर्वांस्तथा सम्पूज्य चैव ह।\n`धनं बहुविधं राजन्दत्त्वा नित्यं द्विजातिषु।\nपुनरेवाब्रवीद्धीमान्युधिष्ठिरमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2100107, "chapter_id": 3143, "verse_number": "१३-२७३-५२", "content_sanskrit": "ब्राह्मणाश्चैव ते नित्यं प्राज्ञाश्चैव विशेषतः।\nआचार्या ऋत्विजश्चैव पूजनीया जनाधिप॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2100108, "chapter_id": 3143, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि भीष्मस्वर्गारोहणपर्वणि त्रिसप्तत्यधिकद्विशततमोऽध्यायः॥ २७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]