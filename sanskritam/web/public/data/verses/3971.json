[{"id": 2137155, "chapter_id": 3971, "verse_number": "१", "content_sanskrit": "एतस्मिन्नेव काले तु द्युमत्सेनो महाबलः ।\nलब्धचक्षुः प्रसन्नायां दृष्ट्यां सर्वं ददर्श ह \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2137156, "chapter_id": 3971, "verse_number": "२", "content_sanskrit": "स सर्वानाश्रमान् गत्वा शैब्यया सह भार्यया ।\nपुत्रहेतोः परामार्तिं जगाम भरतर्षभ \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2137157, "chapter_id": 3971, "verse_number": "३", "content_sanskrit": "तावाश्रमान्नदीश्चैव वनानि च सरांसि च ।\nतस्यां निशि विचिन्वन्तौ दम्पती परिजग्मतुः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2137158, "chapter_id": 3971, "verse_number": "४", "content_sanskrit": "श्रुत्वा शब्दं तु यं कञ्चिदुन्मुखौ सुतशङ्कया ।\nसावित्रीसहितोऽभ्येति सत्यवानित्यभाषताम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2137159, "chapter_id": 3971, "verse_number": "५", "content_sanskrit": "भिन्नैश्च पुरुषैः पादैः सव्रणैः शोणितोक्षितैः ।\nकुशकण्टकविद्धाङ्गावुन्मत्ताविव धावतः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2137160, "chapter_id": 3971, "verse_number": "६", "content_sanskrit": "ततोऽभिसृत्य तैर्विप्रैः सर्वैराश्रमवासिभिः ।\nपरिवार्य समाश्वास्य तावानीतौ स्वमाश्रमम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2137161, "chapter_id": 3971, "verse_number": "७", "content_sanskrit": "तत्र भार्यासहायः स वृतो वृद्धैस्तपोधनैः ।\nआश्वासितोऽपि चित्रार्थैः पूर्वराज्ञां कथाश्रयैः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2137162, "chapter_id": 3971, "verse_number": "८", "content_sanskrit": "ततस्तौ पुनराश्वस्तौ वृद्धौ पुत्रदिदृक्षया ।\nबाल्यवृत्तानि पुत्रस्य स्मरन्तौ भृशदुःखितौ \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2137163, "chapter_id": 3971, "verse_number": "९", "content_sanskrit": "पुनरुक्त्वा च करुणां वाचं तौ शोककर्शितौ ।\nहा पुत्र हा साध्वि वधूः क्वासि क्वासीत्यरोदताम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2137164, "chapter_id": 3971, "verse_number": "", "content_sanskrit": "ब्राह्मणः सत्यवाक्तेषामुवाचेदं तयोर्वचः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2137165, "chapter_id": 3971, "verse_number": "", "content_sanskrit": "ब्राह्मणाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2137166, "chapter_id": 3971, "verse_number": "१०", "content_sanskrit": "यथास्य भार्या सावित्री तपसा च दमेन च ।\nआचारेण च संयुक्ता तथा जीवति सत्यवान् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2137167, "chapter_id": 3971, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2137168, "chapter_id": 3971, "verse_number": "११", "content_sanskrit": "वेदाः साङ्गा मयाधीतास्तपो मे सञ्चितं महत् ।\nकौमारब्रह्मचर्यं च गुरवोऽग्निश्च तोषिताः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2137169, "chapter_id": 3971, "verse_number": "१२", "content_sanskrit": "समाहितेन चीर्णानि सर्वाण्येव व्रतानि मे ।\nवायुभक्षोपवासश्च कृतो मे विधिवत् सदा \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2137170, "chapter_id": 3971, "verse_number": "१३", "content_sanskrit": "अनेन तपसा वेद्मि सर्वं परचिकीर्षितम् ।\nसत्यमेतन्निबोधध्वं ध्रियते सत्यवानिति\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2137171, "chapter_id": 3971, "verse_number": "", "content_sanskrit": "शिष्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2137172, "chapter_id": 3971, "verse_number": "१४", "content_sanskrit": "उपाध्यायस्य मे वक्त्राद् यथा वाक्यं विनिःसृतम् ।\nनैव जातु भवेन्मिथ्या तथा जीवति सत्यवान् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2137173, "chapter_id": 3971, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2137174, "chapter_id": 3971, "verse_number": "१५", "content_sanskrit": "यथास्य भार्या सावित्री सर्वैरेव सुलक्षणैः ।\nअवैधव्यकरैर्युक्ता तथा जीवति सत्यवान् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2137175, "chapter_id": 3971, "verse_number": "", "content_sanskrit": "दाल्भ्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2137176, "chapter_id": 3971, "verse_number": "१६", "content_sanskrit": "यथास्य भार्या सावित्री तपसा च दमेन च ।\nआचारेण च संयुक्ता तथा जीवति सत्यवान् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2137177, "chapter_id": 3971, "verse_number": "१७", "content_sanskrit": "यथा दृष्टिः प्रवृत्ता ते सावित्र्याश्च यथा व्रतम् ।\nगताऽऽहारमकृत्वा च तथा जीवति सत्यवान् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2137178, "chapter_id": 3971, "verse_number": "", "content_sanskrit": "आपस्तम्बः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2137179, "chapter_id": 3971, "verse_number": "१८", "content_sanskrit": "यथा वदन्ति शान्तायां दिशि वै मृगपक्षिणः ।\nपार्थिवी च प्रवृत्तिस्ते तथा जीवति सत्यवान् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2137180, "chapter_id": 3971, "verse_number": "", "content_sanskrit": "धौम्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2137181, "chapter_id": 3971, "verse_number": "१९", "content_sanskrit": "सर्वैर्गुणैरुपेतस्ते यथा पुत्रो जनप्रियः ।\nदीर्घायुर्लक्षणोपेतस्तथा जीवति सत्यवान् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2137182, "chapter_id": 3971, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2137183, "chapter_id": 3971, "verse_number": "२०", "content_sanskrit": "एवमाश्वासितस्तैस्तु सत्यवाग्भिस्तपस्विभिः ।\nतांस्तान् विगणयन् सर्वांस्ततः स्थिर इवाभवत् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2137184, "chapter_id": 3971, "verse_number": "२१", "content_sanskrit": "ततो मुहूर्तात्सावित्री भर्त्रा सत्यवता सह ।\nआजगामाश्रमं रात्रौ प्रहृष्टा प्रविवेश ह \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2137185, "chapter_id": 3971, "verse_number": "२२", "content_sanskrit": "दृष्ट्वा चोत्पतिताः सर्वे हर्षं जग्मुश्च ते द्विजाः ।\nकण्ठं माता पिता चास्य समालिङ्ग्याभ्यरोदताम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2137186, "chapter_id": 3971, "verse_number": "", "content_sanskrit": "ब्राह्मणाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2137187, "chapter_id": 3971, "verse_number": "२३", "content_sanskrit": "पुत्रेण सङ्गतं त्वां तु चक्षुष्मन्तं निरीक्ष्य च ।\nसर्वे वयं वै पृच्छामो वृद्धिं वै पृथिवीपते \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2137188, "chapter_id": 3971, "verse_number": "२४", "content_sanskrit": "समागमेन पुत्रस्य सावित्र्या दर्शनेन च ।\nचक्षुषश्चात्मनो लाभात्त्रिभिर्दिष्ट्या विवर्धसे \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2137189, "chapter_id": 3971, "verse_number": "२५", "content_sanskrit": "सर्वैरस्माभिरुक्तं यत्तथा तन्नात्र संशयः।\nभूयोभूयः समृद्धिस्ते क्षिप्रमेव भविष्यति \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2137190, "chapter_id": 3971, "verse_number": "२६", "content_sanskrit": "ततोऽग्निं तत्र सञ्ज्वाल्य द्विजास्ते सर्व एव हि ।\nउपासाञ्चक्रिरे पार्थ द्युमत्सेनं महीपतिम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2137191, "chapter_id": 3971, "verse_number": "२७", "content_sanskrit": "शैब्या च सत्यवांश्चैव सावित्री चैकतः स्थिताः ।\nसर्वैस्तैरभ्यनुज्ञाता विशोकाः समुपाविशन् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2137192, "chapter_id": 3971, "verse_number": "२८", "content_sanskrit": "ततो राज्ञा सहासीनाः सर्वे ते वनवासिनः ।\nजातकौतूहलाः पार्थ पप्रच्छुर्नृपतेः सुतम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2137193, "chapter_id": 3971, "verse_number": "", "content_sanskrit": "ऋषयः(जनाः)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2137194, "chapter_id": 3971, "verse_number": "२९", "content_sanskrit": "प्रागेव नागतं कस्मात् सभार्येण त्वया विभो ।\nविरात्रे चागतं कस्मात् कोऽनुबन्धस्तवाभवत् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2137195, "chapter_id": 3971, "verse_number": "३०", "content_sanskrit": "सन्तापितः पिता माता वयं चैव नृपात्मज ।\nनाकस्मादेव जानीमस्तत्सर्वं वक्तुमर्हसि \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2137196, "chapter_id": 3971, "verse_number": "", "content_sanskrit": "सत्यवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2137197, "chapter_id": 3971, "verse_number": "३१", "content_sanskrit": "पित्राहमभ्यनुज्ञातः सावित्रीसहितो गतः ।\nअथ मेऽभूच्छिरोदुःखं वने काष्ठानि भिन्दतः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2137198, "chapter_id": 3971, "verse_number": "३२", "content_sanskrit": "सुप्तश्चाहं वेदनया चिरमित्युपलक्षये ।\nतावत्कालं न च मया सुप्तपूर्वं कदाचन \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2137199, "chapter_id": 3971, "verse_number": "३३", "content_sanskrit": "सर्वेषामेव भवतां सन्तापो मा भवेदिति ।\nअतो विरात्रागमनं नान्यदस्तीह कारणम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2137200, "chapter_id": 3971, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2137201, "chapter_id": 3971, "verse_number": "३४", "content_sanskrit": "अकस्माच्चक्षुषः प्राप्तिर्द्युमत्सेनस्य ते पितुः ।\nनास्य त्वं कारणं वेत्सि सावित्री वक्तुमर्हति \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2137202, "chapter_id": 3971, "verse_number": "३५", "content_sanskrit": "श्रोतुमिच्छामि सावित्रि त्वं हि वेत्थ परावरम् ।\nत्वां हि जानामि सावित्रि सावित्रीमिव तेजसा \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2137203, "chapter_id": 3971, "verse_number": "३६", "content_sanskrit": "त्वमत्र हेतुं जानीषे तस्मात् सत्यं निरुच्यताम् ।\nरहस्यं यदि ते नास्ति किञ्चिदत्र वदस्व नः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2137204, "chapter_id": 3971, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2137205, "chapter_id": 3971, "verse_number": "३७", "content_sanskrit": "एवमेतद् यथा वेत्थ सङ्कल्पो नान्यथा हि वः ।\nन हि किञ्चिद् रहस्यं मे श्रूयतां तथ्यमेव यत् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2137206, "chapter_id": 3971, "verse_number": "३८", "content_sanskrit": "मृत्युर्मे पत्युराख्यातो नारदेन महात्मना ।\nस चाद्य दिवसः प्राप्तस्ततो नैनं जहाम्यहम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2137207, "chapter_id": 3971, "verse_number": "३९", "content_sanskrit": "सुप्तं चैनं यमः साक्षादुपागच्छत् सकिङ्करः ।\nस एनमनयद् बद्ध्वा दिशं पितृनिषेविताम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2137208, "chapter_id": 3971, "verse_number": "४०", "content_sanskrit": "अस्तौषं तमहं देवं सत्येन वचसा विभुम् ।\nपञ्च वै तेन मे दत्ता वराः शृणुत तान् मम \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2137209, "chapter_id": 3971, "verse_number": "४१", "content_sanskrit": "चक्षुषी च स्वराज्यं च द्वौ वरौ श्वशुरस्य मे ।\nलब्धं पितुः पुत्रशतं पुत्राणां चात्मनः शतम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2137210, "chapter_id": 3971, "verse_number": "४२", "content_sanskrit": "चतुर्वर्षशतायुर्मे भर्ता लब्धश्च सत्यवान् ।\nभर्तुर्हि जीवितार्थं तु मया चीर्णं त्विदं व्रतम् \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2137211, "chapter_id": 3971, "verse_number": "४३", "content_sanskrit": "एतत् सर्वं मयाऽऽख्यातं कारणं विस्तरेण वः ।\nयथावृत्तं सुखोदर्कमिदं दुःखं महन्मम \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2137212, "chapter_id": 3971, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2137213, "chapter_id": 3971, "verse_number": "४४", "content_sanskrit": "निमज्जमानं व्यसनैरभिद्रुतं\nकुलं नरेन्द्रस्य तमोमये ह्रदे ।\nत्वया सुशीलव्रतपुण्यया कुलं\nसमुद्धृतं साध्वि पुनः कुलीनया \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2137214, "chapter_id": 3971, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2137215, "chapter_id": 3971, "verse_number": "४५", "content_sanskrit": "तथा प्रशस्य ह्यभिपूज्य चैव\nवरस्त्रियं तामृषयः समागताः ।\nनरेन्द्रमामन्त्र्य सपुत्रमञ्जसा\nशिवेन जग्मुर्मुदिताः स्वमालयम् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2137216, "chapter_id": 3971, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि सप्ताशीत्यधिकद्विशततमोऽध्यायः ॥२८७॥\nपतिव्रतामाहात्म्यपर्वणि सावित्र्युपाख्याने षष्ठाध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2137217, "chapter_id": 3971, "verse_number": "", "content_sanskrit": "––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]