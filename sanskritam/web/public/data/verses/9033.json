[{"id": 5000033000, "chapter_id": 9033, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे त्रयस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000033001, "chapter_id": 9033, "verse_number": "१-३३-१", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा कुशनाभस्य धीमतः ।\nशिरोभिश्चरणौ स्पृष्ट्वा कन्याशतमभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000033002, "chapter_id": 9033, "verse_number": "१-३३-२", "content_sanskrit": "वायुः सर्वात्मको राजन् प्रधर्षयितुमिच्छति ।\nअशुभं मार्गमास्थाय न धर्मं प्रत्यवेक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000033003, "chapter_id": 9033, "verse_number": "१-३३-३", "content_sanskrit": "पितृमत्यः स्म भद्रं ते स्वच्छन्दे न वयं स्थिताः ।\nपितरं नो वृणीष्व त्वं यदि नो दास्यते तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000033004, "chapter_id": 9033, "verse_number": "१-३३-४", "content_sanskrit": "तेन पापानुबन्धेन वचनं न प्रतीच्छता ।\nएवं ब्रुवन्त्यः सर्वाः स्म वायुनाभिहता भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000033005, "chapter_id": 9033, "verse_number": "१-३३-५", "content_sanskrit": "तासां तु वचनं श्रुत्वा राजा परमधार्मिकः ।\nप्रत्युवाच महातेजाः कन्याशतमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000033006, "chapter_id": 9033, "verse_number": "१-३३-६", "content_sanskrit": "क्षान्तं क्षमावतां पुत्र्यः कर्तव्यं सुमहत् कृतम् ।\nऐकमत्यमुपागम्य कुलं चावेक्षितं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000033007, "chapter_id": 9033, "verse_number": "१-३३-७", "content_sanskrit": "अलङ्कारो हि नारीणां क्षमा तु पुरुषस्य वा ।\nदुष्करं तच्च वै क्षान्तं त्रिदशेषु विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000033008, "chapter_id": 9033, "verse_number": "१-३३-८", "content_sanskrit": "यादृशी वः क्षमा पुत्र्यः सर्वासामविशेषतः ।\nक्षमा दानं क्षमा सत्यं क्षमा यज्ञाश्च पुत्रिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000033009, "chapter_id": 9033, "verse_number": "१-३३-९", "content_sanskrit": "क्षमा यशः क्षमा धर्मः क्षमायां विष्ठितं जगत् ।\nविसृज्य कन्याः काकुत्स्थ राजा त्रिदशविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000033010, "chapter_id": 9033, "verse_number": "१-३३-१०", "content_sanskrit": "मन्त्रज्ञो मन्त्रयामास प्रदानं सह मन्त्रिभिः ।\nदेशे काले च कर्तव्यं सदृशे प्रतिपादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000033011, "chapter_id": 9033, "verse_number": "१-३३-११", "content_sanskrit": "एतस्मिन्नेव काले तु चूली नाम महाद्युतिः\nऊर्ध्वरेताः शुभाचारो ब्राह्मं तप उपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000033012, "chapter_id": 9033, "verse_number": "१-३३-१२", "content_sanskrit": "तपस्यन्तमृषिं तत्र गन्धर्वी पर्युपासते ।\nसोमदा नाम भद्रं ते ऊर्मिलातनया तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000033013, "chapter_id": 9033, "verse_number": "१-३३-१३", "content_sanskrit": "सा च तं प्रणता भूत्वा शुश्रूषणपरायणा ।\nउवास काले धर्मिष्ठा तस्यास्तुष्टोऽभवद् गुरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000033014, "chapter_id": 9033, "verse_number": "१-३३-१४", "content_sanskrit": "स च तां कालयोगेन प्रोवाच रघुनन्दन ।\nपरितुष्टोऽस्मि भद्रं ते किं करोमि तव प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000033015, "chapter_id": 9033, "verse_number": "१-३३-१५", "content_sanskrit": "परितुष्टं मुनिं ज्ञात्वा गन्धर्वी मधुरस्वरम् ।\nउवाच परमप्रीता वाक्यज्ञा वाक्यकोविदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000033016, "chapter_id": 9033, "verse_number": "१-३३-१६", "content_sanskrit": "लक्ष्म्या समुदितो ब्राह्म्या ब्रह्मभूतो महातपाः ।\nब्राह्मेण तपसा युक्तं पुत्रमिच्छामि धार्मिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000033017, "chapter_id": 9033, "verse_number": "१-३३-१७", "content_sanskrit": "अपतिश्चास्मि भद्रं ते भार्या चास्मि न कस्यचित् ।\nब्राह्मेणोपगतायाश्च दातुमर्हसि मे सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000033018, "chapter_id": 9033, "verse_number": "१-३३-१८", "content_sanskrit": "तस्याः प्रसन्नो ब्रह्मर्षिर्ददौ ब्राह्ममनुत्तमम् ।\nब्रह्मदत्त इति ख्यातं मानसं चूलिनः सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000033019, "chapter_id": 9033, "verse_number": "१-३३-१९", "content_sanskrit": "स राजा ब्रह्मदत्तस्तु पुरीमध्यवसत् तदा ।\nकाम्पिल्यां परया लक्ष्म्या देवराजो यथा दिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000033020, "chapter_id": 9033, "verse_number": "१-३३-२०", "content_sanskrit": "स बुद्धिं कृतवान् राजा कुशनाभः सुधार्मिकः ।\nब्रह्मदत्ताय काकुत्स्थ दातुं कन्याशतं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000033021, "chapter_id": 9033, "verse_number": "१-३३-२१", "content_sanskrit": "तमाहूय महातेजा ब्रह्मदत्तं महीपतिः ।\nददौ कन्याशतं राजा सुप्रीतेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000033022, "chapter_id": 9033, "verse_number": "१-३३-२२", "content_sanskrit": "यथाक्रमं तदा पाणिं जग्राह रघुनन्दन ।\nब्रह्मदत्तो महीपालस्तासां देवपतिर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000033023, "chapter_id": 9033, "verse_number": "१-३३-२३", "content_sanskrit": "स्पृष्टमात्रे तदा पाणौ विकुब्जा विगतज्वराः ।\nयुक्तं परमया लक्ष्म्या बभौ कन्याशतं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000033024, "chapter_id": 9033, "verse_number": "१-३३-२४", "content_sanskrit": "स दृष्ट्वा वायुना मुक्ताः कुशनाभो महीपतिः ।\nबभूव परमप्रीतो हर्षं लेभे पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000033025, "chapter_id": 9033, "verse_number": "१-३३-२५", "content_sanskrit": "कृतोद्वाहं तु राजानं ब्रह्मदत्तं महीपतिम् ।\nसदारं प्रेषयामास सोपाध्यायगणं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000033026, "chapter_id": 9033, "verse_number": "१-३३-२६", "content_sanskrit": "सोमदापि सुतं दृष्ट्वा पुत्रस्य सदृशीं क्रियाम् ।\nयथान्यायं च गन्धर्वी स्नुषास्ताः प्रत्यनन्दत ।\nस्पृष्ट्वा स्पृष्ट्वा च ताः कन्याः कुशनाभं प्रशस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000033027, "chapter_id": 9033, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे त्रयस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]