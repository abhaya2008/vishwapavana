[{"id": 7000374000, "chapter_id": 20374, "verse_number": "२-४६-१", "content_sanskrit": "षट्चत्वारिंशोऽध्यायः ।\nसुकलोवाच ।\nश्वसंतीं शूकरीं दृष्ट्वा पतितां पुत्रवत्सलाम् ।\nसुदेवावकृपयाविष्टा गत्वा तां दुःखितां प्रति॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000374001, "chapter_id": 20374, "verse_number": "२-४६-२", "content_sanskrit": "अभिषिच्य मुखं तस्याः शीतलेनोदकेन च ।\nपुनः सर्वांगमेवापि दुःखितां रणशालिनीम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000374002, "chapter_id": 20374, "verse_number": "२-४६-३", "content_sanskrit": "पुण्येन शीततोयेन सा उवाचाभिषिंचतीम् ।\nउवाच मानुषीं वाचं सुस्वरं नृपतिप्रियाम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000374003, "chapter_id": 20374, "verse_number": "२-४६-४", "content_sanskrit": "सुखं भवतु ते देवि अभिषिक्ता त्वया यदि ।\nसंपर्काद्दर्शनात्तेद्य गतो मे पापसंचयः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000374004, "chapter_id": 20374, "verse_number": "२-४६-५", "content_sanskrit": "तदाकर्ण्य महद्वाक्यमद्भुताकारसंयुतम् ।\nचित्रमेतन्मया दृष्टं कृतं तेऽनामयं वचः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000374005, "chapter_id": 20374, "verse_number": "२-४६-६", "content_sanskrit": "पशुजातिमतीचेयं सौष्ठवं भाषते स्फुटम् ।\nस्वरव्यंजनसंपन्नं संस्कृतमुत्तमं मम॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000374006, "chapter_id": 20374, "verse_number": "२-४६-७", "content_sanskrit": "हर्षेण विस्मयेनापि कृत्वा साहसमुत्तमम् ।\nतत्रस्था सा महाभागा तं पतिं वाक्यमब्रवीत्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000374007, "chapter_id": 20374, "verse_number": "२-४६-८", "content_sanskrit": "पश्य राजन्नपूर्वेयं संस्कृतं भाषते महत् ।\nपशुयोनिगता चेयं यथा वै मानुषो वदेत्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000374008, "chapter_id": 20374, "verse_number": "२-४६-९", "content_sanskrit": "तदाकर्ण्य ततो राजा सर्वज्ञानवतां वरः ।\nअद्भुतमद्भुताकारं यन्न दृष्टं श्रुतं मया॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000374009, "chapter_id": 20374, "verse_number": "२-४६-१०", "content_sanskrit": "तामुवाच ततो राजा सुदेवां सुप्रियां तदा ।\nपृच्छ चैनां शुभां कांते का चेयं तु भविष्यति॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000374010, "chapter_id": 20374, "verse_number": "२-४६-११", "content_sanskrit": "श्रुत्वा तु नृपतेर्वाक्यं सा पप्रच्छ च सूकरीम् ।\nका भविष्यसि त्वं भद्रे चित्रं ते दृश्यते बहु॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000374011, "chapter_id": 20374, "verse_number": "२-४६-१२", "content_sanskrit": "पशुयोनिगता त्वं वै भाषसे मानुषं वचः ।\nसौष्ठवं ज्ञानसंपन्नं वद मे पूर्वचेष्टितम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000374012, "chapter_id": 20374, "verse_number": "२-४६-१३", "content_sanskrit": "भर्तुश्चापि महाराज भटस्यास्य महात्मनः ।\nकोयं धर्मो महावीर्यो गतः स्वर्गं पराक्रमैः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000374013, "chapter_id": 20374, "verse_number": "२-४६-१४", "content_sanskrit": "आत्मनश्च स्वभर्तुश्च सर्वं पूर्वानुगं वद ।\nएवमुक्त्वा महाभागा विरराम नृपप्रिया॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000374014, "chapter_id": 20374, "verse_number": "२-४६-१५", "content_sanskrit": "शूकर्युवाच ।\nयदि पृच्छसि मां भद्रे ममास्य च महात्मनः ।\nतत्सर्वं ते प्रवक्ष्यामि चरितं पूर्वचेष्टितम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000374015, "chapter_id": 20374, "verse_number": "२-४६-१६", "content_sanskrit": "अयमेष महाप्राज्ञो गंधर्वो गीतपंडितः ।\nरंगविद्याधरो नाम सर्वशास्त्रार्थकोविदः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000374016, "chapter_id": 20374, "verse_number": "२-४६-१७", "content_sanskrit": "मेरुं गिरिवरश्रेष्ठं चारुकंदरनिर्झरम् ।\nतमाश्रित्य महातेजाः पुलस्त्यो मुनिसत्तमः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000374017, "chapter_id": 20374, "verse_number": "२-४६-१८", "content_sanskrit": "तपश्चचार तेजस्वी निर्व्यलीकेन चेतसा ।\nविद्याधरस्तत्र गतः स्वेच्छया स महाप्रभो॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000374018, "chapter_id": 20374, "verse_number": "२-४६-१९", "content_sanskrit": "तमाश्रित्य गिरिश्रेष्ठं गीतमभ्यसते तदा ।\nस्वरतालसमोपेतं सुस्वरं चारुहासिनि॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000374019, "chapter_id": 20374, "verse_number": "२-४६-२०", "content_sanskrit": "गीतं श्रुत्वा मुनिस्तस्य ध्यानाच्चलितमानसः ।\nगायंतं तमुवाचेदं गीतविद्याधरं प्रति॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000374020, "chapter_id": 20374, "verse_number": "२-४६-२१", "content_sanskrit": "भवद्गीतेन दिव्येन देवा मुह्यंति नान्यथा ।\nसुस्वरेण सुपुण्येन तालमानेन पंडित॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000374021, "chapter_id": 20374, "verse_number": "२-४६-२२", "content_sanskrit": "लययुक्तेन भावेन मूर्च्छना सहितेन च ।\nमे मनश्चलितं ध्यानाद्गीतेनानेन सुव्रत॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000374022, "chapter_id": 20374, "verse_number": "२-४६-२३", "content_sanskrit": "इदं स्थानं परित्यज्य अन्यस्थानं व्रजस्व तत् ।\nगीतविद्याधर उवाच ।\nआत्मज्ञानसमं गीतमन्यस्थानं व्रजामि किम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000374023, "chapter_id": 20374, "verse_number": "२-४६-२४", "content_sanskrit": "दुःखं ददे न कस्यापि सुखदो नृषु सर्वदा ।\nगीतेनानेन दिव्येन सर्वास्तुष्यंति देवताः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000374024, "chapter_id": 20374, "verse_number": "२-४६-२५", "content_sanskrit": "शंभुश्चापि समानीतो गीतध्वनिरतो द्विज ।\nगीतं सर्वरसं प्रोक्तं गीतमानंददायकम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000374025, "chapter_id": 20374, "verse_number": "२-४६-२६", "content_sanskrit": "शृंगाराद्यारसाः सर्वे गीतेनापि प्रतिष्ठिताः ।\nशोभामायांति गीतेन वेदाश्चत्वार उत्तमाः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000374026, "chapter_id": 20374, "verse_number": "२-४६-२७", "content_sanskrit": "गीतेन देवताः सर्वास्तोषमायांति नान्यथा ।\nतदेवं निन्दसे गीतं मामेवं परिचालयेः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000374027, "chapter_id": 20374, "verse_number": "२-४६-२८", "content_sanskrit": "अन्यायोऽयं महाभाग तवैव इह दृश्यते ।\nपुलस्त्य उवाच ।\nसत्यमुक्तं त्वयाद्यैव गीतार्थं बहुपुण्यदम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000374028, "chapter_id": 20374, "verse_number": "२-४६-२९", "content_sanskrit": "शृणु त्वं मामकं वाक्यं मानं त्यज महामते ।\nनाहं गीतं प्रकुत्सामि गीतं वंदामि नान्यथा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000374029, "chapter_id": 20374, "verse_number": "२-४६-३०", "content_sanskrit": "विद्याश्चतुर्दशैवैता एकीभावेन भावदाः ।\nप्राणिनां सिद्धिमायांति मनसा निश्चलेन च॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000374030, "chapter_id": 20374, "verse_number": "२-४६-३१", "content_sanskrit": "तपश्च तद्वन्मंत्राश्च सुसिद्ध्यंत्येकचिंतया ।\nहृषीकाणां महावर्गश्चपलो मम संमतः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000374031, "chapter_id": 20374, "verse_number": "२-४६-३२", "content_sanskrit": "विषयेष्वेव सर्वेषु नयत्यात्मानमुच्चकैः ।\nचालयित्वा मनस्तस्माद्ध्यानादेव न संशयः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000374032, "chapter_id": 20374, "verse_number": "२-४६-३३", "content_sanskrit": "यत्र शब्दं न रूपं च युवती नैव तिष्ठति ।\nमुनयस्तत्र गच्छंति तपःसिद्ध्यर्थमेव हि॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000374033, "chapter_id": 20374, "verse_number": "२-४६-३४", "content_sanskrit": "अयं गीतः पवित्रस्ते बहुसौख्यप्रदायकः ।\nन पश्येम वयं वीर तिष्ठामो वनसंस्थिताः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000374034, "chapter_id": 20374, "verse_number": "२-४६-३५", "content_sanskrit": "अन्यत्स्थानं प्रयाहि त्वं नोवा वयं व्रजामहे ।\nगीतविधाधर उवाच ।\nइंद्रियाणां बलं वर्गं जितं येन महात्मना॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000374035, "chapter_id": 20374, "verse_number": "२-४६-३६", "content_sanskrit": "स जयी कथ्यते योगी स च वीरः ससाधकः ।\nशब्दं श्रुत्वाथ वा दृष्ट्वा रूपमेवं महामते॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000374036, "chapter_id": 20374, "verse_number": "२-४६-३७", "content_sanskrit": "चलते नैव यो ध्यानात्स धीरस्तपसाधकः ।\nभवांस्तु तेजसा हीन इंद्रियैर्विजितो यतः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000374037, "chapter_id": 20374, "verse_number": "२-४६-३८", "content_sanskrit": "स्वर्गेपि नास्ति सामर्थ्यं मम गीतस्य धर्षणे ।\nवर्जयंति वनं सर्वे हीनवीर्या न संशयः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000374038, "chapter_id": 20374, "verse_number": "२-४६-३९", "content_sanskrit": "अयं साधारणो विप्र वनदेशो न संशयः ।\nदेवानां सर्वजीवानां यथा मम तथा तव॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000374039, "chapter_id": 20374, "verse_number": "२-४६-४०", "content_sanskrit": "कथं गच्छाम्यहं त्यक्त्वा वनमेवमनुत्तमम् ।\nयूयं गच्छंतु तिष्ठंतु यद्भव्यं तत्तु नान्यथा॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000374040, "chapter_id": 20374, "verse_number": "२-४६-४१", "content_sanskrit": "एवमाभाष्य तं विप्रं गीतविद्याधरस्तदा ।\nसमाकर्ण्य ततस्तेन मुनिना तस्य उत्तरम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000374041, "chapter_id": 20374, "verse_number": "२-४६-४२", "content_sanskrit": "चिंतयामास मेधावी किं कृत्वा सुकृतं भवेत् ।\nक्षमां कृत्वा जगामाथ अन्यत्स्थानं द्विजोत्तमः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000374042, "chapter_id": 20374, "verse_number": "२-४६-४३", "content_sanskrit": "तपश्चचार धर्मात्मा योगासनगतः सदा ।\nकामं क्रोधं परित्यज्य मोहं लोभं तथैव च॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000374043, "chapter_id": 20374, "verse_number": "२-४६-४४", "content_sanskrit": "सर्वेन्द्रियाणि संयम्य मनसा सममेव च ।\nएवं स्थितस्तदा योगी पुलस्त्यो मुनिसत्तमः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000374044, "chapter_id": 20374, "verse_number": "२-४६-४५", "content_sanskrit": "सुकलोवाच ।\nगते तस्मिन्महाभागे पुलस्त्ये मुनिपुंगवे ।\nकालादिष्टेन तेनापि गीतविद्याधरेण च॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000374045, "chapter_id": 20374, "verse_number": "२-४६-४६", "content_sanskrit": "चिंतितं सुचिरं कालं न दृष्टोयं भयान्मम ।\nक्व गतस्तिष्ठते वापि कुरुते किं कथं च सः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000374046, "chapter_id": 20374, "verse_number": "२-४६-४७", "content_sanskrit": "ज्ञात्वा पद्मात्मजसुतमेकांतवनशालिनम् ।\nगतो वराहरूपेण तस्याश्रममनुत्तमम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000374047, "chapter_id": 20374, "verse_number": "२-४६-४८", "content_sanskrit": "आसनस्थं महात्मानं तेजोज्वालासमाविलम् ।\nदृष्ट्वा चकार वै क्षोभं तस्य विप्रस्य भामिनि॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000374048, "chapter_id": 20374, "verse_number": "२-४६-४९", "content_sanskrit": "धर्षयेन्नियतं विप्रं तुंडाग्रेण कुचेष्टया ।\nपशुं ज्ञात्वा महाराज क्षमते तस्य दुष्कृतम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000374049, "chapter_id": 20374, "verse_number": "२-४६-५०", "content_sanskrit": "मूत्रयेत्पुरतः कृत्वा विष्ठां च कुरुते ततः ।\nनृत्यते क्रीडते तत्र पतति प्रोच्चलेत्पुनः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000374050, "chapter_id": 20374, "verse_number": "२-४६-५१", "content_sanskrit": "पशुं ज्ञात्वा परित्यक्तो मुनिना तेन भूपते ।\nएकदा तु तथायाते तेन रूपेण वै पुनः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000374051, "chapter_id": 20374, "verse_number": "२-४६-५२", "content_sanskrit": "अट्टाट्टहासेन पुनर्हास्यमेवं कृतं तदा ।\nरोदनं च कृतं तत्र गीतं गायति सुस्वरम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000374052, "chapter_id": 20374, "verse_number": "२-४६-५३", "content_sanskrit": "तथा तमागतं विप्रो गीतविद्याधरं नृप ।\nचेष्टितं तस्य वै दृष्ट्वा घोणिरेष भवेन्नहि॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000374053, "chapter_id": 20374, "verse_number": "२-४६-५४", "content_sanskrit": "ज्ञात्वा तस्य तु वृत्तांतं मामेवं परिचालयेत् ।\nपशुं ज्ञात्वा मया त्यक्तो दुष्ट एष सुनिर्घृणः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000374054, "chapter_id": 20374, "verse_number": "२-४६-५५", "content_sanskrit": "एवं ज्ञात्वा महात्मानं गंधर्वाधममेव हि ।\nचुकोप मुनिशार्दूलस्तं शशाप महामतिः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000374055, "chapter_id": 20374, "verse_number": "२-४६-५६", "content_sanskrit": "यस्माच्छूकररूपेण मामेवं परिचालयेः ।\nतस्माद्व्रज महापाप पापयोनिं तु शौकरीम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000374056, "chapter_id": 20374, "verse_number": "२-४६-५७", "content_sanskrit": "शप्तस्तेनापि विप्रेण गतो देवं पुरंदरम् ।\nतमुवाच महात्मानं कंपमानो वरानने॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000374057, "chapter_id": 20374, "verse_number": "२-४६-५८", "content_sanskrit": "शृणु वाक्यं सहस्राक्ष तव कार्यं कृतं मया ।\nतप एव हि कुर्वन्सन्दारुणं मुनिपुंगवः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000374058, "chapter_id": 20374, "verse_number": "२-४६-५९", "content_sanskrit": "तस्मात्तपःप्रभावात्तु चालितः क्षोभितो मया ।\nशप्तस्तेनास्मि विप्रेण देवरूपं प्रणाशितम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000374059, "chapter_id": 20374, "verse_number": "२-४६-६०", "content_sanskrit": "पशुयोनिं गतं शक्र मामेवं परिरक्षय ।\nज्ञात्वा तस्य स वृत्तांतं गीतविद्याधरस्य च॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000374060, "chapter_id": 20374, "verse_number": "२-४६-६१", "content_sanskrit": "तेन सार्धंगतश्चेंद्रस्तं मुनिं पर्यभाषत ।\nदीयतामनुग्रहो नाथ सिद्धिज्ञोसि द्विजोत्तम॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000374061, "chapter_id": 20374, "verse_number": "२-४६-६२", "content_sanskrit": "क्षम्यतां मुनिवर्यास्मिन्क्रियतां शापमोक्षणम् ।\nइति संप्रार्थितो विप्रो महेंद्रेणाह हृष्टधीः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000374062, "chapter_id": 20374, "verse_number": "२-४६-६३", "content_sanskrit": "पुलस्त्य उवाच ।\nवचनात्तव देवेश क्षंतव्यं च मयापि हि ।\nभविष्यति महाराज मनुपुत्रो महाबलः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000374063, "chapter_id": 20374, "verse_number": "२-४६-६४", "content_sanskrit": "इक्ष्वाकुर्नाम धर्मात्मा सर्वधर्मानुपालकः ।\nतस्य हस्ताद्यदा मृत्युरस्यैव च भविष्यति॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000374064, "chapter_id": 20374, "verse_number": "२-४६-६५", "content_sanskrit": "तदैष वै स्वकं देहं प्राप्स्यते नात्र संशयः ।\nएतत्ते सर्ववृत्तांतं शूकरस्य निवेदितम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000374065, "chapter_id": 20374, "verse_number": "२-४६-६६", "content_sanskrit": "आत्मनश्च प्रवक्ष्यामि पत्या सार्धं शृणुष्व हि ।\nमया च पातकं घोरं कृतं यत्पापया पुरा॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]