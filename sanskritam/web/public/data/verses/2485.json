[{"id": 2070656, "chapter_id": 2485, "verse_number": "११-१७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070657, "chapter_id": 2485, "verse_number": "११-१७-१", "content_sanskrit": "दुर्योधनं हतं दृष्ट्वा गान्धारी शोककर्शिता।\nसहसा न्यपतद्भूमौ छिन्नेव कदली वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070658, "chapter_id": 2485, "verse_number": "११-१७-२", "content_sanskrit": "सा तु लब्ध्वा पुनः संज्ञां विक्रुश्य च विलप्य च।\nदुर्योधनमभिप्रेक्ष्य शयानं रुधिरोक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070659, "chapter_id": 2485, "verse_number": "११-१७-३", "content_sanskrit": "परिष्वज्याथ गान्धारी कृपणं पर्यदेवयत्।\nहाहापुत्रेति शोकार्ता विललापाकुलेन्द्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070660, "chapter_id": 2485, "verse_number": "११-१७-४", "content_sanskrit": "सुगूढजत्रु विपुलं हारनिष्कविभूषितम्।\nवारिणा नेत्रजेनोरः सिञ्चन्ती शोकतापिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070661, "chapter_id": 2485, "verse_number": "११-१७-५", "content_sanskrit": "समीपस्थं हृषीकेशमिद वचनमब्रवीत्।\nउपस्थितेऽस्मिन्सङ्ग्रामे ज्ञातीनां संक्षये विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070662, "chapter_id": 2485, "verse_number": "११-१७-६", "content_sanskrit": "मामयं प्राह वार्ष्णेय प्राञ्चलिर्नृपसत्तमः।\nअस्मिञ्ज्ञातिसमुद्धर्षे जयमम्बा ब्रवीतु मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070663, "chapter_id": 2485, "verse_number": "११-१७-७", "content_sanskrit": "इत्युक्ते जानती सर्वमहं स्वव्यसनागमम्।\nअब्रुवं पुरुषव्याघ्र यतो धर्मस्ततो जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070664, "chapter_id": 2485, "verse_number": "११-१७-८", "content_sanskrit": "तथा तु युव्यमानस्त्वं सम्प्रगृह्य सुपुत्रक।\nध्रुवं शखजिताँल्लोकान्प्राप्स्यस्यमरवत्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070665, "chapter_id": 2485, "verse_number": "११-१७-९", "content_sanskrit": "इत्येवxxx पूर्वं नैवं शोचामि वै प्रभो।\nधृतराष्ट्रं तु शोचामि कृपणं हतबान्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070666, "chapter_id": 2485, "verse_number": "११-१७-१०", "content_sanskrit": "अमर्वणं युधां श्रेष्ठं कृतास्त्रं युद्धदुर्मदम्।\nशयानं वीरशयने पश्य माधव मे सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070667, "chapter_id": 2485, "verse_number": "११-१७-११", "content_sanskrit": "बोऽयं मूर्धावसिक्तानाये याति परन्तपः।\nसोऽवं पांसुषु शेतेऽद्य पञ्च कालस्य पर्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070668, "chapter_id": 2485, "verse_number": "११-१७-१२", "content_sanskrit": "दुवं दुर्योधनो वीरो गतिं न सुलभां गतः।\nतथा ह्यभिxxxx शेते शयने वीरसेविते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070669, "chapter_id": 2485, "verse_number": "११-१७-१३", "content_sanskrit": "यं पुरा पर्युपासीना समयन्ति वरस्त्रियः।\nसं वीरशयने सुप्तं रमयन्त्यशिवाः शिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070670, "chapter_id": 2485, "verse_number": "११-१७-१४", "content_sanskrit": "यं पुरा पर्युपासीना रमयन्ति महीक्षितः।\nमहीतलस्यं निहतं गृध्रास्तं पर्युपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070671, "chapter_id": 2485, "verse_number": "११-१७-१५", "content_sanskrit": "यं पुरा व्यजनैरम्यैरुपवीजन्ति योषितः।\nतमद्य पक्षव्यजनै रुपवीजन्ति पक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070672, "chapter_id": 2485, "verse_number": "११-१७-१६", "content_sanskrit": "एष शेते महाबाहुर्बलवान्सत्यविक्रमः।\nसिंहेनेव द्विपः सङ्ख्ये भीमसेनेन पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070673, "chapter_id": 2485, "verse_number": "११-१७-१७", "content_sanskrit": "पश्य दुर्योधनं कृष्ण शयानं रुधिरोक्षितम्।\nनिहतं भीमसेनेन गदां सम्मृज्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070674, "chapter_id": 2485, "verse_number": "११-१७-१८", "content_sanskrit": "अक्षौहिणीर्महाबाहुर्दश चैकां च केशव।\nआनयद्यः पुरा सङ्ख्ये सोऽनयान्निधनं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070675, "chapter_id": 2485, "verse_number": "११-१७-१९", "content_sanskrit": "एष दुर्योधनः शेते महेष्वासो महाबलः।\nशार्दूल इव सिंहेन भीमसेनेन पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070676, "chapter_id": 2485, "verse_number": "११-१७-२०", "content_sanskrit": "विदुरं ह्यवमत्यैष पितरं चैव मन्दभाक्।\nबालो वृद्धावमानेन मन्दो मृत्युवशं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070677, "chapter_id": 2485, "verse_number": "११-१७-२१", "content_sanskrit": "निःसपत्ना मही यस्य त्रयोदशसमाः स्थिता।\nस शेते निहतो भूमौ पुत्रो मे पृथिवीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070678, "chapter_id": 2485, "verse_number": "११-१७-२२", "content_sanskrit": "अपश्यं कृष्ण पृथिवीं धार्तराष्ट्रानुशासिताम्।\nपूर्णां हस्तिगवाश्वैश्च वार्ष्णेय न तु तच्चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070679, "chapter_id": 2485, "verse_number": "११-१७-२३", "content_sanskrit": "तामेवाद्य महाबाहो पश्याम्यन्यानुशासिताम्।\nहीनां हस्तिगवाश्वेन किन्नु जीवामि माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070680, "chapter_id": 2485, "verse_number": "११-१७-२४", "content_sanskrit": "इदं कष्टतरं पश्य पुत्रस्यापि वधान्मम।\nया इमाः पर्युपासन्ते हताञ्शूरान्रणे स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070681, "chapter_id": 2485, "verse_number": "११-१७-२५", "content_sanskrit": "प्रकीर्णकेशां सुश्रोणीं दुर्योधनभूजाङ्कगाम्।\nरुक्मवेदिनिभां पश्य कृष्ण लक्ष्मणमातरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070682, "chapter_id": 2485, "verse_number": "११-१७-२६", "content_sanskrit": "नूनमेषा पुरा बाला जीवमाने महाभुजे।\nभुजावाश्रित्य रमते सुभुजस्य मनस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070683, "chapter_id": 2485, "verse_number": "११-१७-२७", "content_sanskrit": "कथं तु शतधा नेदं हृदयं मम दीर्यते।\nपश्यन्त्या निहतं पुत्रं पौत्रेण सहितं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2070684, "chapter_id": 2485, "verse_number": "११-१७-२८", "content_sanskrit": "पुत्रं रुधिरसंसिक्तमुपजिघ्रत्यनिन्दिता।\nदुर्योधनं तु वामोरूः पाणिना परिमार्जती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2070685, "chapter_id": 2485, "verse_number": "११-१७-२९", "content_sanskrit": "किन्नु शोचति भर्तारं हतपुत्रं मनस्विनी।\nतथा ह्यवस्थिता भाति पुत्रं चाप्यभिवीक्ष्य सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2070686, "chapter_id": 2485, "verse_number": "११-१७-३०", "content_sanskrit": "स्वशिरः पञ्चशाखाभ्यामभिहत्यायतेक्षणा।\nपतत्युरसि वीरस्य कुरुराजस्य माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2070687, "chapter_id": 2485, "verse_number": "११-१७-३१", "content_sanskrit": "पुण्डरीकनिभा भाति पुण्डरीकान्तरप्रभा।\nमुखं प्रमृज्य पुत्रस्य भर्तुश्चैव तपस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2070688, "chapter_id": 2485, "verse_number": "११-१७-३२", "content_sanskrit": "यदि सत्यागमाः सन्ति यदि वै श्रुतयस्तथा।\nध्रुवं लोकानवाप्तोऽयं नृपो बाहुबलार्जितान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2070689, "chapter_id": 2485, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि स्त्रीविलापपर्वणि सप्तदशोऽध्यायः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]