[{"id": 2015463, "chapter_id": 1326, "verse_number": "२-६७-१", "content_sanskrit": "भीष्म उवाच॥\nनैषा चेदिपतेर्बुद्धिर्यया त्वाह्वयतेऽच्युतम्।\nनूनमेव जगद्भर्तुः कृष्णस्यैव विनिश्चयः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015464, "chapter_id": 1326, "verse_number": "२-६७-२", "content_sanskrit": "को हि मां भीमसेनाद्य क्षितावर्हति पार्थिवः।\nक्षेप्तुं कालपरीतात्मा यथैष कुलपांसनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015465, "chapter_id": 1326, "verse_number": "२-६७-३", "content_sanskrit": "एष ह्यस्य महाबाहुस्तेर्जोशश्च हरेर्ध्रुवम्।\nतमेव पुनरादातुं कुरुतेऽत्र मतिं हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015466, "chapter_id": 1326, "verse_number": "२-६७-४", "content_sanskrit": "येनैष कुरुशार्दूल शार्दूल इव चेदिराट्।\nगर्जत्यतीव दुर्बुद्धिः सर्वानस्मानचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015467, "chapter_id": 1326, "verse_number": "२-६७-५x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015468, "chapter_id": 1326, "verse_number": "२-६७-५", "content_sanskrit": "ततो न ममृषे चैद्यस्तद्भीष्मवचनं तदा।\nउवाच चैन सङ्क्रुद्धः पुनर्भीष्ममथोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015469, "chapter_id": 1326, "verse_number": "२-६७-६x", "content_sanskrit": "शिशुपाल उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015470, "chapter_id": 1326, "verse_number": "२-६७-६", "content_sanskrit": "द्विषतां नोऽस्तु भीष्मैष प्रभावः केशवस्य यः।\nयस्य संस्तववक्ता त्वं बन्दिवत्सततोत्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015471, "chapter_id": 1326, "verse_number": "२-६७-७", "content_sanskrit": "संस्तवे चमनो भीष्म परेषां रमते यदि।\nतदा संस्तुहि राज्ञस्त्वमिमं हित्वा जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015472, "chapter_id": 1326, "verse_number": "२-६७-८", "content_sanskrit": "दरदं स्तुहि बाह्लीकमिमं पार्थिवसत्तमम्।\nजायमानेन येनेयभवद्दारिता मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015473, "chapter_id": 1326, "verse_number": "२-६७-९", "content_sanskrit": "वङ्गाङ्गविषयाध्यक्षं सहस्राक्षसमं बले।\nस्तुहि कर्णमिमं भीष्म महाचापविकर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015474, "chapter_id": 1326, "verse_number": "२-६७-१०", "content_sanskrit": "यस्येमे कुण्डले दिव्ये सहजे देवनिर्मिते।\nकवचं च महाबाहो बालार्कसदृशप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015475, "chapter_id": 1326, "verse_number": "२-६७-११", "content_sanskrit": "वासवप्रतिमो येन जरासन्धोऽतिदुर्जयः।\nविजितो बाहुयुद्धेन देहभेदं च लम्भितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015476, "chapter_id": 1326, "verse_number": "२-६७-१२", "content_sanskrit": "द्रोणं द्रौणिं च साधु त्वं पितापुत्रौ महारथौ।\nस्तुहि स्तुत्यावुभौ भीष्म सततं द्विजसत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015477, "chapter_id": 1326, "verse_number": "२-६७-१३", "content_sanskrit": "ययोरन्यतरो भीष्म सङ्क्रुद्धः सचराचराम्।\nइमां वसुमतीं कुर्यान्निः शेषामिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015478, "chapter_id": 1326, "verse_number": "२-६७-१४", "content_sanskrit": "द्रोणस्य हि समं युद्धे न पश्यामि नराधिपम्।\nनाश्वत्थाम्नः समं भीष्म न च तौ स्तोतुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015479, "chapter_id": 1326, "verse_number": "२-६७-१५", "content_sanskrit": "पृथिव्यां सागरान्तायां यो वैप्रतिसमो भवेत्।\nदुर्योधनं त्वं राजेन्द्रमतिक्रम्य महाभुजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015480, "chapter_id": 1326, "verse_number": "२-६७-१६", "content_sanskrit": "जयद्रथं च राजानं कृतास्त्रं दृढविक्रमम्।\nद्रुमं किम्पुरुषाचार्यं लोके प्रथितविक्रमम्।\nअतिक्रम्य महावीर्यं किं प्रशंससि केशवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015481, "chapter_id": 1326, "verse_number": "२-६७-१७", "content_sanskrit": "वृद्धं च भरताचार्यं तथा शारद्वतं कृपम्।\nअतिक्रम्य महावीर्यं किं प्रशंससि केशवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015482, "chapter_id": 1326, "verse_number": "२-६७-१८", "content_sanskrit": "धनुर्धराणां प्रवरं रुक्मिणं पुरुषोत्तमम्।\nअतिक्रम्य महावीर्यं किं प्रशंससि केशवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015483, "chapter_id": 1326, "verse_number": "२-६७-१९", "content_sanskrit": "भीष्मकं च महावीर्यं दन्तवक्त्रं च भूमिपम्।\nभगदत्तं यूपकेथु जयत्सेनं च मागधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015484, "chapter_id": 1326, "verse_number": "२-६७-२०", "content_sanskrit": "विराटद्रुपदौ चोभौ शकुनिं च बहद्बलम्।\nविन्दानुविन्दावावन्त्यौ पाण्ड्यं श्वेतमथोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015485, "chapter_id": 1326, "verse_number": "२-६७-२१", "content_sanskrit": "शङ्खं च सुमहाभागं वृषसेनं च मानिनम्।\nएकलव्यं च विक्रान्तं कालिङ्गं च महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015486, "chapter_id": 1326, "verse_number": "२-६७-२२", "content_sanskrit": "अतिक्रम्य महावीर्यं किं प्रशंसति केशवम्।\nशल्यादीनपि कस्मात्त्वं न स्तौषि वसुधाधिपान्।\nस्तवाय यदि ते बुद्धिर्वर्तते भीष्म वसुधाधिपान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015487, "chapter_id": 1326, "verse_number": "२-६७-२३", "content_sanskrit": "किं हि शक्यं मया कर्तुं यद्वृद्धानां त्वया नृप।\nपुरा कथयतां नूनं न श्रुतं धर्मवादिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015488, "chapter_id": 1326, "verse_number": "२-६७-२४", "content_sanskrit": "आत्मनिन्दात्मपूजा च परनिन्दा परस्तवः।\nअनाचरितमार्याणामिति ते भीष्म न श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015489, "chapter_id": 1326, "verse_number": "२-६७-२५", "content_sanskrit": "यदस्तव्यमिमं शश्वन्मोहात्संस्तौषि भक्तितः।\nकेशवं तच्च ते भीष्म न कश्चिदनुमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015490, "chapter_id": 1326, "verse_number": "२-६७-२६", "content_sanskrit": "कथं भोजस्य पुरुषे वत्सपाले दुरात्मनि।\nसमावेशयसे सर्वं जगत्केवलकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015491, "chapter_id": 1326, "verse_number": "२-६७-२७", "content_sanskrit": "अथ चैषा न ते बुद्धिः प्रकृतिं याति भारत।\nमयैव कथितं पूर्वं कुलिङ्गशकुनिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015492, "chapter_id": 1326, "verse_number": "२-६७-२८", "content_sanskrit": "कुलिङ्गशकुनिर्नाम पार्श्वे हिमवतः परे।\nभीष्म तस्याः सदा वाचः श्रूयन्तेऽर्थविगर्हिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015493, "chapter_id": 1326, "verse_number": "२-६७-२९", "content_sanskrit": "मा साहसमितीदं सा सततं वाशते किल।\nसाहसं चात्मनातीव चरन्ती नावबुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2015494, "chapter_id": 1326, "verse_number": "२-६७-३०", "content_sanskrit": "सा हि मांसार्गलं भीष्म मुखात्सिंहस्य खादतः।\nदन्तान्तरविलग्नं यत्तदादत्तेऽल्पचेतना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2015495, "chapter_id": 1326, "verse_number": "२-६७-३१", "content_sanskrit": "इच्छतः सा हि सिंहस्य भीष्म जीवत्यसंशयम्।\nतद्वत्त्वमप्यधर्मिष्ठ सदा वाचः प्रभाषसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2015496, "chapter_id": 1326, "verse_number": "२-६७-३२", "content_sanskrit": "इच्छतां भूमिपालानां भीष्म जीवस्यसंशयम्।\nलोकविद्विष्टकर्मा हि नान्योऽस्ति भवता समः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2015497, "chapter_id": 1326, "verse_number": "२-६७-३३x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2015498, "chapter_id": 1326, "verse_number": "२-६७-३३", "content_sanskrit": "ततश्चेदिपतेः श्रुत्वा भीष्मः स कटुकं वचः।\nउवाचेदं वचो राजंश्चेदिराजस्य शृण्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2015499, "chapter_id": 1326, "verse_number": "२-६७-३४", "content_sanskrit": "इच्छतां किल नामाहं जीवाम्येषां महीक्षिताम्।\nसोऽहं न गणयाम्येतांस्तृणेनापि नराधिपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2015500, "chapter_id": 1326, "verse_number": "२-६७-३५", "content_sanskrit": "एवमुक्ते तु भीष्मेण ततः सञ्चुक्रुशुर्नृपाः।\nकेचिज्जहृषिरे तत्र केचिद्भीष्मं जगर्हिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2015501, "chapter_id": 1326, "verse_number": "२-६७-३६", "content_sanskrit": "केचिदूचुर्महेष्वासाः श्रुत्वा भीष्मस्य यद्वचः।\nपापोऽवलिप्तो वृद्धश्च नायं भीष्मोऽर्हति क्षमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2015502, "chapter_id": 1326, "verse_number": "२-६७-३७", "content_sanskrit": "हन्यतां दुर्मतिर्भीष्मः पशुवत्साध्वयं नृपाः।\nसर्वैः समेत्य संरब्धैर्दह्यतां वा कटाग्निना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2015503, "chapter_id": 1326, "verse_number": "२-६७-३८", "content_sanskrit": "इति तेषां वचः श्रुत्वा ततः कुरुपितामहः।\nउवाच मतिमान्भीष्मस्तानेव वसुधाधिपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2015504, "chapter_id": 1326, "verse_number": "२-६७-३९", "content_sanskrit": "उक्तस्योक्तस्य नेहान्तमहं समुपलक्षये।\nयत्तु वक्ष्यामि तत्सर्वं शृणुध्वं वसुधाधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2015505, "chapter_id": 1326, "verse_number": "२-६७-४०", "content_sanskrit": "पशुवद्घातनं वा मे दहनं वा कटाग्निना।\nक्रियतां मूर्ध्नि वो न्यस्तं मयेदं सकलं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2015506, "chapter_id": 1326, "verse_number": "२-६७-४१", "content_sanskrit": "एष तिष्ठति गोविन्दः पूजितोऽस्माभिरच्युतः।\nयस्य वस्त्वरते बुद्धिर्मरणाय स माधवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2015507, "chapter_id": 1326, "verse_number": "२-६७-४२", "content_sanskrit": "कृष्णमाह्वयतामद्य युद्धे चक्रगदाधरम्।\nयादवस्यैव देवस्य देहं विशतु पातितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2015508, "chapter_id": 1326, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि शिशुपालवधपर्वणि सप्तषष्टितमोऽध्यायः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]