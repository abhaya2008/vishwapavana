[{"id": 7000442000, "chapter_id": 20442, "verse_number": "२-११४-१", "content_sanskrit": "कुंजल उवाच ।\nअथ ते दानवाः सर्वे हुंडस्य परिचारकाः ।\nनहुषस्यापि संवादं रंभया तु यथाश्रुतम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000442001, "chapter_id": 20442, "verse_number": "२-११४-२", "content_sanskrit": "आचचक्षुश्च दैत्येंद्रं हुंडं सर्वं सुभाषितम् ।\nतमाकर्ण्य स चुक्रोध दूतं वाक्यमथाब्रवीत्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000442002, "chapter_id": 20442, "verse_number": "२-११४-३", "content_sanskrit": "गच्छ वीर ममादेशाज्जानीहि पुरुषं हि तम् ।\nसंभाषते तया सार्द्धं पुरुषः शिवकन्यया॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000442003, "chapter_id": 20442, "verse_number": "२-११४-४", "content_sanskrit": "स्वामिनिर्देशमाकर्ण्य जगाम लघुदानवः ।\nविविक्ते नहुषं वीरमिदं वचनमब्रवीत्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000442004, "chapter_id": 20442, "verse_number": "२-११४-५", "content_sanskrit": "रथेन साश्वसूतेन दिव्येन परितिष्ठति ।\nधनुषा दिव्यबाणैस्तु सभायां हि भयंकरः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000442005, "chapter_id": 20442, "verse_number": "२-११४-६", "content_sanskrit": "कस्य केन तु कार्येण प्रेषितः केन वैभवान् ।\nअनया रंभया तेऽद्य अन्यया शिवकन्यया॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000442006, "chapter_id": 20442, "verse_number": "२-११४-७", "content_sanskrit": "किमुक्तं तत्स्फुटं सर्वं कथयस्व ममाग्रतः ।\nहुंडस्य देवमर्दस्य न बिभेति भवान्कथम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000442007, "chapter_id": 20442, "verse_number": "२-११४-८", "content_sanskrit": "एतन्मे सर्वमाचक्ष्व यदि जीवितुमिच्छसि ।\nसत्वरं गच्छ मा तिष्ठ दुःसहो दानवाधिपः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000442008, "chapter_id": 20442, "verse_number": "२-११४-९", "content_sanskrit": "नहुष उवाच ।\nयोऽसावायुर्बली राजा सप्तद्वीपाधिपः प्रभुः ।\nतस्य मां तनयं विद्धि सर्वदैत्यविनाशनम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000442009, "chapter_id": 20442, "verse_number": "२-११४-१०", "content_sanskrit": "नहुषं नाम विख्यातं देवब्राह्मणपूजकम् ।\nहुंडेनापहृतं बाल्ये स्वामिना तव दानव॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000442010, "chapter_id": 20442, "verse_number": "२-११४-११", "content_sanskrit": "सेयं कन्या शिवस्यापि दैत्येनापहृता पुरा ।\nघोरं तपश्चरत्येषा हुंडस्यापि वधाय च॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000442011, "chapter_id": 20442, "verse_number": "२-११४-१२", "content_sanskrit": "योहमादौ हृतो बालस्त्वया यः सूतिकागृहात् ।\nदास्या अपि करे दत्तः सूदस्यापि दुरात्मना॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000442012, "chapter_id": 20442, "verse_number": "२-११४-१३", "content_sanskrit": "वधार्थं श्रूयतां पाप सोहमद्य समागतः ।\nअस्यापि हुंडदैत्यस्य दुष्टस्य पापकर्मणः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000442013, "chapter_id": 20442, "verse_number": "२-११४-१४", "content_sanskrit": "अन्यांश्च दानवान्घोरान्नयिष्ये यमसादनम् ।\nमामेवं विद्धि पापिष्ठ एवं कथय दानवम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000442014, "chapter_id": 20442, "verse_number": "२-११४-१५", "content_sanskrit": "एवमाकर्ण्य तत्सर्वं नहुषस्य महात्मनः ।\nगत्वा हुंडं स दुष्टात्मा आचचक्षेऽस्य भाषितम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000442015, "chapter_id": 20442, "verse_number": "२-११४-१६", "content_sanskrit": "निशम्य तन्मुखात्तूर्णं चुक्रोध दितिजेश्वरः ।\nकस्मात्सूदेन पापेन तया दास्या न घातितः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000442016, "chapter_id": 20442, "verse_number": "२-११४-१७", "content_sanskrit": "सोयं वृद्धिं समायातो मया व्याधिरुपेक्षितः ।\nअथैनं घातयिष्यामि अनया शिवकन्यया॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000442017, "chapter_id": 20442, "verse_number": "२-११४-१८", "content_sanskrit": "आयोः पुत्रं खलं युद्धे बाणैरेभिः शिलाशितैः ।\nएवं सचिंतयित्वा तु सारथिं वाक्यमब्रवीत्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000442018, "chapter_id": 20442, "verse_number": "२-११४-१९", "content_sanskrit": "स्यंदनं योजयस्व त्वं तुरगैः साधुभिः शिवैः ।\nसेनाध्यक्षं समाहूय इत्युवाच समातुरः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000442019, "chapter_id": 20442, "verse_number": "२-११४-२०", "content_sanskrit": "सज्जतां मम सैन्यं त्वं शूरान्नागान्प्रकल्पय ।\nसारोहैस्तुरगान्योधान्पताकाच्छत्रचामरैः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000442020, "chapter_id": 20442, "verse_number": "२-११४-२१", "content_sanskrit": "चतुरंगबलं मेऽद्य योजयस्व हि सत्वरम् ।\nएवमाकर्ण्य तत्तस्य हुंडस्यापि ततो लघुः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000442021, "chapter_id": 20442, "verse_number": "२-११४-२२", "content_sanskrit": "सेनाध्यक्षो महाप्राज्ञः सर्वं चक्रे यथाविधि ।\nचतुरंगेन तेनासौ बलेन महता वृतः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000442022, "chapter_id": 20442, "verse_number": "२-११४-२३", "content_sanskrit": "जगाम नहुषं वीरं चापबाणधरं रणे ।\nइंद्रस्य स्यंदने युक्तं सर्वशस्त्रभृतां वरम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000442023, "chapter_id": 20442, "verse_number": "२-११४-२४", "content_sanskrit": "उद्यंतं समरे वीरं दुरापं देवदानवैः ।\nपश्यंति गगने देवा विमानस्था महौजसः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000442024, "chapter_id": 20442, "verse_number": "२-११४-२५", "content_sanskrit": "तेजोज्वालासमाकीर्णं द्वितीयमिव भास्करम् ।\nसूत उवाच ।\nअथ ते दानवाः सर्वे ववृषुस्तं शरोत्तमैः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000442025, "chapter_id": 20442, "verse_number": "२-११४-२६", "content_sanskrit": "खड्गैः पाशैर्महाशूलैः शक्तिभिस्तु परश्वधैः ।\nयुयुधुः संयुगे तेन नहुषेण महात्मना॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000442026, "chapter_id": 20442, "verse_number": "२-११४-२७", "content_sanskrit": "संरब्धा गर्जमानास्ते यथा मेघा गिरौ तथा ।\nतद्विक्रमं समालोक्य आयुपुत्रः प्रतापवान्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000442027, "chapter_id": 20442, "verse_number": "२-११४-२८", "content_sanskrit": "इंद्रायुधसमं चापं विस्फार्य स गुणस्वरम् ।\nवज्रस्फोटसमः शब्दश्चापस्यापि महात्मनः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000442028, "chapter_id": 20442, "verse_number": "२-११४-२९", "content_sanskrit": "नहुषेण कृतो विप्रा दानवानां भयप्रदः ।\nमहता तेन घोषेण दानवाः प्रचकंपिरे॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000442029, "chapter_id": 20442, "verse_number": "२-११४-३०", "content_sanskrit": "कश्मलाविष्टहृदया भग्नसत्वा महाहवे॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]