[{"id": 7005617000, "chapter_id": 25617, "verse_number": "९०-१", "content_sanskrit": "अतः परं प्रवक्ष्यामि रत्नाचलमनुत्तमम् ।\nमुक्ताफलसहस्रेण पर्वतः स्यादनुत्तमः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005617001, "chapter_id": 25617, "verse_number": "९०-२", "content_sanskrit": "मध्यमः पञ्चशतकस्त्रिशतेनाधमः स्मृतः ।\nचतुर्थांशेन विष्कम्भपर्वताः स्युः समन्ततः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005617002, "chapter_id": 25617, "verse_number": "९०-३", "content_sanskrit": "पूर्वेण वज्रगोमेदैर्दक्षिणेनेन्द्रनीलकैः ।\nपद्मरागयुतः कार्य्यो विद्वद्भिर्गन्दमादनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005617003, "chapter_id": 25617, "verse_number": "९०-४", "content_sanskrit": "वैढूर्य्यविद्रुमैः पश्चात्सम्मिश्रोविमलाचलः ।\nपद्मरागैः ससौवर्णैरुत्तरेण च विन्यसेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005617004, "chapter_id": 25617, "verse_number": "९०-५", "content_sanskrit": "धान्यपर्वतवत्सर्वमत्रापि परिकल्पयेत् ।\nतद्वदावाहनं कुर्य्याद्‌वृक्षान्‌ देवांश्च काञ्चनान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005617005, "chapter_id": 25617, "verse_number": "९०-६", "content_sanskrit": "पूजयेत्पुष्पगन्धाद्यैः प्रभाते च विमत्सरः ।\nपूर्ववद्‌गुरुऋत्विग्भ्य इमान् मन्त्रानुदीरयेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005617006, "chapter_id": 25617, "verse_number": "९०-७", "content_sanskrit": "यदा देवगणाः सर्वे सर्वरत्नेष्ववस्थिताः ।\nत्वञ्च रत्नमयो नित्यं नमस्तेऽस्तु सदाचल ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005617007, "chapter_id": 25617, "verse_number": "९०-८", "content_sanskrit": "यस्माद्रत्नप्रदानेन तुष्टिं प्रकुरुते हरिः ।\nसदा रत्नप्रदानेन तस्मान्नः पाहि पर्वत ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005617008, "chapter_id": 25617, "verse_number": "९०-९", "content_sanskrit": "अनेन विधिना यस्तु दद्याद्रत्नमयं गिरिम् ।\nस याति विष्णुसालोक्यममरेश्वरपूजितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005617009, "chapter_id": 25617, "verse_number": "९०-१०", "content_sanskrit": "यावत्कल्पशतं साग्रं वसेच्चेह नराधिप ।\n‘रूपारोग्यगुणोपेतः सप्तद्वीपाधिपो भवेत् ॥१0॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005617010, "chapter_id": 25617, "verse_number": "९०-११", "content_sanskrit": "ब्रह्महत्यादिकं किञ्चिद्यदत्रामुत्र वा कृतम् ।\nतत्सर्वं नाशमायाति गिरिर्वज्रहतो यथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]