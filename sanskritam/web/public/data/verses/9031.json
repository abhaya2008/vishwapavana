[{"id": 5000031000, "chapter_id": 9031, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे एकत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000031001, "chapter_id": 9031, "verse_number": "१-३१-१", "content_sanskrit": "अथ तां रजनीं तत्र कृतार्थौ रामलक्षणौ ।\nऊषतुर्मुदितौ वीरौ प्रहृष्टेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000031002, "chapter_id": 9031, "verse_number": "१-३१-२", "content_sanskrit": "प्रभातायां तु शर्वर्यां कृतपौर्वाह्णिकक्रियौ ।\nविश्वामित्रमृषींश्चान्यान्सहितावभिजग्मतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000031003, "chapter_id": 9031, "verse_number": "१-३१-३", "content_sanskrit": "अभिवाद्य मुनिश्रेष्ठं ज्वलन्तमिव पावकम् ।\nऊचतुर्परमोदारं वाक्यं मधुरभाषिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000031004, "chapter_id": 9031, "verse_number": "१-३१-४", "content_sanskrit": "इमौ स्म मुनिशार्दूल किङ्करौ समुपागतौ ।\nआज्ञापय मुनिश्रेष्ठ शासनं करवाव किम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000031005, "chapter_id": 9031, "verse_number": "१-३१-५", "content_sanskrit": "एवमुक्ते तयोर्वाक्ये सर्व एव महर्षयः ।\nविश्वामित्रं पुरस्कृत्य रामं वचनमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000031006, "chapter_id": 9031, "verse_number": "१-३१-६", "content_sanskrit": "मैथिलस्य नरश्रेष्ठ जनकस्य भविष्यति ।\nयज्ञः परमधर्मिष्ठस्तत्र यास्यामहे वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000031007, "chapter_id": 9031, "verse_number": "१-३१-७", "content_sanskrit": "त्वं चैव नरशार्दूल सहास्माभिर्गमिष्यसि ।\nअद्भुतं च धनूरत्नं तत्र त्वं द्रष्टुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000031008, "chapter_id": 9031, "verse_number": "१-३१-८", "content_sanskrit": "तद्धि पूर्वं नरश्रेष्ठ दत्तं सदसि दैवतैः ।\nअप्रमेयबलं घोरं मखे परमभास्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000031009, "chapter_id": 9031, "verse_number": "१-३१-९", "content_sanskrit": "नास्य देवा न गन्धर्वा नासुरा न च राक्षसाः ।\nकर्तुमारोपणं शक्ता न कथञ्चन मानुषाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000031010, "chapter_id": 9031, "verse_number": "१-३१-१०", "content_sanskrit": "धनुषस्तस्य वीर्यं हि जिज्ञासन्तो महीक्षितः ।\nन शेकुरारोपयितुं राजपुत्रा महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000031011, "chapter_id": 9031, "verse_number": "१-३१-११", "content_sanskrit": "तद्धनुर्नरशार्दूल मैथिलस्य महात्मनः ।\nतत्र द्रक्ष्यसि काकुत्स्थ यज्ञं च परमाद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000031012, "chapter_id": 9031, "verse_number": "१-३१-१२", "content_sanskrit": "तद्धि यज्ञफलं तेन मैथिलेनोत्तमं धनुः ।\nयाचितं नरशार्दूल सुनाभं सर्वदैवतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000031013, "chapter_id": 9031, "verse_number": "१-३१-१३", "content_sanskrit": "आयागभूतं नृपतेस्तस्य वेश्मनि राघव ।\nअर्चितं विविधैर्गन्धैर्धूपैश्चागुरुगन्धिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000031014, "chapter_id": 9031, "verse_number": "१-३१-१४", "content_sanskrit": "एवमुक्त्वा मुनिवरः प्रस्थानमकरोत् तदा ।\nसर्षिसङ्घः सकाकुत्स्थ आमन्त्र्य वनदेताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000031015, "chapter_id": 9031, "verse_number": "१-३१-१५", "content_sanskrit": "स्वस्ति वोऽस्तु गमिष्यामि सिद्धः सिद्धाश्रमादहम् ।\nउत्तरे जाह्नवीतीरे हिमवन्तं शिलोच्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000031016, "chapter_id": 9031, "verse_number": "१-३१-१६", "content_sanskrit": "इत्युक्त्वा मुनिशार्दूलः कौशिकः स तपोधनः ।\nउत्तरां दिशमुद्दिश्य प्रस्थातुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000031017, "chapter_id": 9031, "verse_number": "१-३१-१७", "content_sanskrit": "तं व्रजन्तं मुनिवरमन्वगादनुसारिणाम् ।\nशकटीशतमात्रं तु प्रयाणे ब्रह्मवादिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000031018, "chapter_id": 9031, "verse_number": "१-३१-१८", "content_sanskrit": "मृगपक्षिगणाश्चैव सिद्धाश्रमनिवासिनः ।\nअनुजग्मुर्महात्मानं विश्वामित्रं तपोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000031019, "chapter_id": 9031, "verse_number": "१-३१-१९", "content_sanskrit": "निवर्तयामास ततः स ऋषि सन्घः स पक्षिणः ।\nते गत्वा दूरम् अध्वानम् लम्बमाने दिवाकरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000031020, "chapter_id": 9031, "verse_number": "१-३१-२०", "content_sanskrit": "ते गत्वा दूरमध्वानं लम्बमाने दिवाकरे ।\nवासं चक्रुर्मुनिगणाः शोणाकूले समाहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000031021, "chapter_id": 9031, "verse_number": "१-३१-२१", "content_sanskrit": "तेऽस्तं गते दिनकरे स्नात्वा हुतहुताशनाः ।\nविश्वामित्रं पुरस्कृत्य निषेदुरमितौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000031022, "chapter_id": 9031, "verse_number": "१-३१-२२", "content_sanskrit": "रामोऽपि सहसौमित्रिर्मुनींस्तानभिपूज्य च ।\nअग्रतो निषसादाथ विश्वामित्रस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000031023, "chapter_id": 9031, "verse_number": "१-३१-२३", "content_sanskrit": "अथ रामो महातेजा विश्वामित्रं तपोधनम् ।\nपप्रच्छ मुनिशार्दूलं कौतूहलसमन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000031024, "chapter_id": 9031, "verse_number": "१-३१-२४", "content_sanskrit": "भगवन् को न्वयं देशः समृद्धवनशोभितः ।\nश्रोतुमिच्छामि भद्रं ते वक्तुमर्हसि तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000031025, "chapter_id": 9031, "verse_number": "१-३१-२५", "content_sanskrit": "चोदितो रामवाक्येन कथयामास सुव्रतः ।\nतस्य देशस्य निखिलमृषिमध्ये महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000031026, "chapter_id": 9031, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे एकत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]