[{"id": 7001487000, "chapter_id": 21487, "verse_number": "७-२-२५-१", "content_sanskrit": "उपमन्युरुवाच ।\nअनुक्तं चात्र पूजायाः कमलोपभयादिव ।\nयत्तदन्यत्प्रवक्ष्यामि समासान्न तु विस्तरात्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001487001, "chapter_id": 21487, "verse_number": "७-२-२५-२", "content_sanskrit": "हविर्निवेदनात्पूर्वं दीपदानादनन्तरम् ।\nकुर्यादावरणाभ्यर्चां प्राप्ते नीराजने ऽथ वा॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001487002, "chapter_id": 21487, "verse_number": "७-२-२५-३", "content_sanskrit": "तत्रेशानादिसद्यांतं रुद्राद्यस्त्रांतमेव च ।\nशिवस्य वा शिवायाश्च प्रथमावरणे जपेत्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001487003, "chapter_id": 21487, "verse_number": "७-२-२५-४", "content_sanskrit": "ऐशान्यां पूर्वभागे च दक्षिणे चोत्तरे तथा ।\nपश्चिमे च तथाग्नेय्यामैशान्यां नैरृते तथा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001487004, "chapter_id": 21487, "verse_number": "७-२-२५-५", "content_sanskrit": "वायव्यां पुनरैशान्यां चतुर्दिक्षु ततः परम् ।\nगर्भावरणमाख्यातं मन्त्रसंघातमेव वा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001487005, "chapter_id": 21487, "verse_number": "७-२-२५-६", "content_sanskrit": "हृदयाद्यस्त्रपर्यंतमथवापि समर्चयेत् ।\nतद्बहिः पूर्वतः शक्रं यमं दक्षिणतो यजेत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001487006, "chapter_id": 21487, "verse_number": "७-२-२५-७", "content_sanskrit": "वरुणं वारुणे भागे धनदं चोत्तरे बुधः ।\nईशमैशे ऽनलं स्वीये नैरृते निरृतिं यजेत्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001487007, "chapter_id": 21487, "verse_number": "७-२-२५-८", "content_sanskrit": "मारुते मारुतं विष्णुं नैरृते विधिमैश्वरे ।\nबहिःपद्मस्य वज्राद्यान्यब्जांतान्यायुधान्यपि॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001487008, "chapter_id": 21487, "verse_number": "७-२-२५-९", "content_sanskrit": "प्रसिद्धरूपाण्याशासु लोकेशानां क्रमाद्यजेत् ।\nदेवं देवीं च संप्रेक्ष्य सर्वावरणदेवताः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001487009, "chapter_id": 21487, "verse_number": "७-२-२५-१०", "content_sanskrit": "बद्धांजलिपुटा ध्येयाः समासीना यथासुखम् ।\nसर्वावरणदेवानां स्वाभिधानैर्नमोयुतैः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001487010, "chapter_id": 21487, "verse_number": "७-२-२५-११", "content_sanskrit": "पुष्पैः संपूजनं कुर्यान्नत्वा सर्वान्यथाक्रमम् ।\nगर्भावरणमेवापि यजेत्स्वावरणेन वा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001487011, "chapter_id": 21487, "verse_number": "७-२-२५-१२", "content_sanskrit": "योगे ध्याने जपे होमे वाह्ये वाभ्यंतरे ऽपि वा ।\nहविश्च षड्विधं देयं शुद्धं मुद्गान्नमेव च॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001487012, "chapter_id": 21487, "verse_number": "७-२-२५-१३", "content_sanskrit": "पायसं दधिसंमिश्रं गौडं च मधुनाप्लुतम् ।\nएतेष्वेकमनेकं वा नानाव्यंजनसंयुतम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001487013, "chapter_id": 21487, "verse_number": "७-२-२५-१४", "content_sanskrit": "गुडखंडन्वितं दद्यान्मथितं दधि चोत्तमम् ।\nभक्ष्याण्यपूपमुख्यानि स्वादुमंति फलानि च॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001487014, "chapter_id": 21487, "verse_number": "७-२-२५-१५", "content_sanskrit": "रक्तचन्दनपुष्पाढ्यं पानीयं चातिशीतलम् ।\nमृदु एलारसाक्तं च खण्डं पूगफलस्य च॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001487015, "chapter_id": 21487, "verse_number": "७-२-२५-१६", "content_sanskrit": "दलानि नागवल्ल्याश्च युक्तानि खदिरादिभिः ।\nगौराणि स्वर्णवर्णानि विहितानि शिवानि च॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001487016, "chapter_id": 21487, "verse_number": "७-२-२५-१७", "content_sanskrit": "शैलमेव सितं चूर्णं नातिरूक्षं न दूषितम् ।\nकर्पूरं चाथ कंकोलं जात्यादि च नवं शुभम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001487017, "chapter_id": 21487, "verse_number": "७-२-२५-१८", "content_sanskrit": "आलेपनं चन्दनं स्यान्मूलकाष्ठंरजोमयम् ।\nकस्तूरिका कुंकुमं च रसो मृगमदात्मकः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001487018, "chapter_id": 21487, "verse_number": "७-२-२५-१९", "content_sanskrit": "पुष्पाणि सुरभीण्येव पवित्राणि शुभानि च ।\nनिर्गंधान्युग्रगंधानि दूषितान्युषितानि च॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001487019, "chapter_id": 21487, "verse_number": "७-२-२५-२०", "content_sanskrit": "स्वयमेव विशीर्णानि न देयानि शिवार्चने ।\nवासांसि च मृदून्येव तपनीयमयानि च॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001487020, "chapter_id": 21487, "verse_number": "७-२-२५-२१", "content_sanskrit": "विद्युद्वलयकल्पानि भूषणानि विशेषतः ।\nसर्वाण्येतानि कर्पूरनिर्यासागुरुचन्दनैः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001487021, "chapter_id": 21487, "verse_number": "७-२-२५-२२", "content_sanskrit": "आधूपितानि पुष्पौघैर्वासितानि समंततः ।\nचन्दनागुरुकर्पूरकाष्ठगुग्गुलुचूर्णिकैः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001487022, "chapter_id": 21487, "verse_number": "७-२-२५-२३", "content_sanskrit": "घृतेन मधुना चैव सिद्धो धूपः प्रशस्यते ।\nकपिलासम्भवेनैव घृतेनातिसुगन्धिना॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001487023, "chapter_id": 21487, "verse_number": "७-२-२५-२४", "content_sanskrit": "नित्यं प्रदीपिता दीपाः शस्ताः कर्पूरसंयुताः ।\nपञ्चगव्यं च मधुरं पयो दधि घृतं तथा॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001487024, "chapter_id": 21487, "verse_number": "७-२-२५-२५", "content_sanskrit": "कपिलासम्भवं शम्भोरिष्टं स्नाने च पानके ।\nआसनानि च भद्राणि गजदंतमयानि च॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001487025, "chapter_id": 21487, "verse_number": "७-२-२५-२६", "content_sanskrit": "सुवर्णरत्नयुक्तानि चित्राण्यास्तरणानि च ।\nमृदूपधानयुक्तानि सूक्ष्मतूलमयानि च॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001487026, "chapter_id": 21487, "verse_number": "७-२-२५-२७", "content_sanskrit": "उच्चावचानि रम्याणि शयनानि सुखानि च ।\nनद्यस्समुद्रगामिन्या नटाद्वाम्भः समाहृतम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001487027, "chapter_id": 21487, "verse_number": "७-२-२५-२८", "content_sanskrit": "शीतञ्च वस्त्रपूतं तद्विशिष्टं स्नानपानयोः ।\nछत्रं शशिनिभं चारु मुक्तादामविराजितम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001487028, "chapter_id": 21487, "verse_number": "७-२-२५-२९", "content_sanskrit": "नवरत्नचितं दिव्यं हेमदण्डमनोहरम् ।\nचामरे च सिते सूक्ष्मे चामीकरपरिष्कृते॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001487029, "chapter_id": 21487, "verse_number": "७-२-२५-३०", "content_sanskrit": "राजहंसद्वयाकारे रत्नदंडोपशोभिते ।\nदर्पणं चापि सुस्निग्धं दिव्यगन्धानुलेपनम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001487030, "chapter_id": 21487, "verse_number": "७-२-२५-३१", "content_sanskrit": "समंताद्रत्नसञ्छन्नं स्रग्वैरैश्चापि भूषितम् ।\nगम्भीरनिनदः शंखो हंसकुंदेन्दुसन्निभः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001487031, "chapter_id": 21487, "verse_number": "७-२-२५-३२", "content_sanskrit": "आस्वपृष्ठादिदेशेषु रत्नचामीकराचितः ।\nकाहलानि च रम्याणि नानानादकराणि च॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001487032, "chapter_id": 21487, "verse_number": "७-२-२५-३३", "content_sanskrit": "सुवर्णनिर्मितान्येव मौक्तिकालंकृतानि च ।\nभेरीमृदंगमुरजतिमिच्छपटहादयः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001487033, "chapter_id": 21487, "verse_number": "७-२-२५-३४", "content_sanskrit": "समुद्रकल्पसन्नादाः कल्पनीयाः प्रयत्नतः ।\nभांडान्यपि च रम्याणि पत्राण्यपि च कृत्स्नशः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001487034, "chapter_id": 21487, "verse_number": "७-२-२५-३५", "content_sanskrit": "तदाधाराणि १ सर्वाणि सौवर्णान्येव साधयेत् ।\nआलयं च महेशस्य शिवस्य परमात्मनः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001487035, "chapter_id": 21487, "verse_number": "७-२-२५-३६", "content_sanskrit": "राजावसथवत्कल्प्यं शिल्पशास्त्रोक्तलक्षणम् ।\nउच्चप्राकारसंभिन्नं भूधराकारगोपुरम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001487036, "chapter_id": 21487, "verse_number": "७-२-२५-३७", "content_sanskrit": "अनेकरत्नसंच्छन्नं हेमद्वारकपाटकम् ।\nतप्तजांबूनदमयं रत्नस्तम्भशतावृतम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001487037, "chapter_id": 21487, "verse_number": "७-२-२५-३८", "content_sanskrit": "मुक्तादामवितानाढ्यं विद्रुमद्वारतोरणम् ।\nचामीकरमयैर्दिव्यैर्मुकुटैः कुम्भलक्षणैः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001487038, "chapter_id": 21487, "verse_number": "७-२-२५-३९", "content_sanskrit": "अलंकृतशिरोभागमस्त्र २ आजेन चिह्नितम् ।\nराजन्यार्हनिवासैश्च राजवीथ्यादिशोभितैः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001487039, "chapter_id": 21487, "verse_number": "७-२-२५-४०", "content_sanskrit": "प्रोच्छ्रितप्रांशुशिखरैः प्रासादैश्च समंततः ।\nआस्थानस्थानवर्यैश्च स्थितैर्दिक्षु विदिक्षु च॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001487040, "chapter_id": 21487, "verse_number": "७-२-२५-४१", "content_sanskrit": "अत्यन्तालंकृतप्रांतमंतरावरणैरिव ।\nउत्तमस्त्रीसहस्रैश्च नृत्यगेयविशारदैः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001487041, "chapter_id": 21487, "verse_number": "७-२-२५-४२", "content_sanskrit": "वेणुवीणाविदग्धैश्च पुरुषैर्बहुभिर्युतम् ।\nरक्षितं रक्षिभिर्वीरैर्गजवाजिरथान्वितैः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001487042, "chapter_id": 21487, "verse_number": "७-२-२५-४३", "content_sanskrit": "अनेकपुष्पवाटीभिरनेकैश्च सरोवरैः ।\nदीर्घिकाभिरनेकाभिर्दिग्विदिक्षु विराजितम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001487043, "chapter_id": 21487, "verse_number": "७-२-२५-४४", "content_sanskrit": "वेदवेदांततत्त्वज्ञैश्शिवशास्त्रपरायणैः ।\nशिवाश्रमरतैर्भक्तैः शिवशास्त्रोक्तलक्षणैः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001487044, "chapter_id": 21487, "verse_number": "७-२-२५-४५", "content_sanskrit": "शांतैः स्मितमुखैः स्फीतैः सदाचारपरायणैः ।\nशैवैर्माहेश्वरैश्चैव श्रीमद्भिस्सेवितद्विजैः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001487045, "chapter_id": 21487, "verse_number": "७-२-२५-४६", "content_sanskrit": "एवमंतर्बहिर्वाथयथाशक्तिविनिर्मितैः ।\nस्थाने शिलामये दांते दारवे चेष्टकामये॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001487046, "chapter_id": 21487, "verse_number": "७-२-२५-४७", "content_sanskrit": "केवलं मृन्मये वापि पुण्यारण्ये ऽथ वा गिरौ ।\nनद्यां देवालये ऽन्यत्र देशे वाथ गृहे शुभे॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001487047, "chapter_id": 21487, "verse_number": "७-२-२५-४८", "content_sanskrit": "आढ्यो वाथ दरिद्रो वा स्वकां शक्तिमवंचयन् ।\nद्रव्यैर्न्यायार्जितैरेव भक्त्या देवं समर्चयेत्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001487048, "chapter_id": 21487, "verse_number": "७-२-२५-४९", "content_sanskrit": "अथान्यायार्जितैश्चापि भक्त्या चेच्छिवमर्चयेत् ।\nन तस्य प्रत्यवायो ऽस्ति भाववश्यो यतः प्रभुः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001487049, "chapter_id": 21487, "verse_number": "७-२-२५-५०", "content_sanskrit": "न्यायार्जितैरपि द्रव्यैरभक्त्या पूजयेद्यदि ।\nन तत्फलमवाप्नोति भक्तिरेवात्र कारणम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001487050, "chapter_id": 21487, "verse_number": "७-२-२५-५१", "content_sanskrit": "भक्त्या वित्तानुसारेण शिवमुद्दिश्य यत्कृतम् ।\nअल्पे महति वा तुल्यं फलमाढ्यदरिद्रयोः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001487051, "chapter_id": 21487, "verse_number": "७-२-२५-५२", "content_sanskrit": "भक्त्या प्रचोदितः कुर्यादल्पवित्तोपि मानवः ।\nमहाविभवसारोपि न कुर्याद्भक्तिवर्जितः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001487052, "chapter_id": 21487, "verse_number": "७-२-२५-५३", "content_sanskrit": "सर्वस्वमपि यो दद्याच्छिवे भक्तिविवर्जितः ।\nन तेन फलभाक्स स्याद्भक्तिरेवात्र कारणम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001487053, "chapter_id": 21487, "verse_number": "७-२-२५-५४", "content_sanskrit": "न तत्तपोभिरत्युग्रैर्न च सर्वैर्महामखैः ।\nगच्छेच्छिवपुरं दिव्यं मुक्त्वा भक्तिं शिवात्मकम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001487054, "chapter_id": 21487, "verse_number": "७-२-२५-५५", "content_sanskrit": "गुह्याद्गुह्यतरं कृष्ण सर्वत्र परमेश्वरे ।\nशिवे भक्तिर्न संदेहस्तया भक्तो विमुच्यते॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001487055, "chapter_id": 21487, "verse_number": "७-२-२५-५६", "content_sanskrit": "शिवमंत्रजपो ध्यानं होमो यज्ञस्तपःश्रुतम् ।\nदानमध्ययनं सर्वे भावार्थं नात्र संशयः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001487056, "chapter_id": 21487, "verse_number": "७-२-२५-५७", "content_sanskrit": "भावहीनो नरस्सर्वं कृत्वापि न विमुच्यते ।\nभावयुक्तः पुनस्सर्वमकृत्वापि विमुच्यते॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001487057, "chapter_id": 21487, "verse_number": "७-२-२५-५८", "content_sanskrit": "चांद्रायणसहस्रैश्च प्राजापत्यशतैस्तथा ।\nमासोपवासैश्चान्यैश्च शिवभक्तस्य किं पुनः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001487058, "chapter_id": 21487, "verse_number": "७-२-२५-५९", "content_sanskrit": "अभक्ता मानवाश्चास्मिंल्लोके गिरिगुहासु च ।\nतपंति चाल्पभोगार्थं भक्तो भावेन मुच्यते॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001487059, "chapter_id": 21487, "verse_number": "७-२-२५-६०", "content_sanskrit": "सात्त्विकं मुक्तिदं कर्म सत्त्वे वै योगिनः स्थिताः ।\nराजसं सिद्धिदं कुर्युः कर्मिणो रजसावृताः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001487060, "chapter_id": 21487, "verse_number": "७-२-२५-६१", "content_sanskrit": "असुरा राक्षसाश्चैव तमोगुणसमन्विताः ।\nऐहिकार्थं यजन्तीशं नराश्चान्ये ऽपि तादृशाः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001487061, "chapter_id": 21487, "verse_number": "७-२-२५-६२", "content_sanskrit": "तामसं राजसं वापि सात्त्विकं भावमेव च ।\nआश्रित्य भक्त्या पूजाद्यं कुर्वन्भद्रं समश्नुते॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001487062, "chapter_id": 21487, "verse_number": "७-२-२५-६३", "content_sanskrit": "यतः पापार्णवात्त्रातुं भक्तिर्नौरिव निर्मिता ।\nतस्माद्भक्त्युपपन्नस्य रजसा तमसा च किम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001487063, "chapter_id": 21487, "verse_number": "७-२-२५-६४", "content_sanskrit": "अन्त्यजो वाधमो वापि मूर्खो वा पतितो ऽपि वा ।\nशिवं प्रपन्नश्चेत्कृष्ण पूज्यस्सर्वसुरासुरैः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001487064, "chapter_id": 21487, "verse_number": "७-२-२५-६५", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन भक्त्यैव शिवमर्चयेत् ।\nअभुक्तानां क्वचिदपि फलं नास्ति यतस्ततः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001487065, "chapter_id": 21487, "verse_number": "७-२-२५-६६", "content_sanskrit": "वक्ष्याम्यतिरहस्यं ते शृणु कृष्ण वचो मम ।\nवेदैश्शास्त्रैर्वेदविद्भिर्विचार्य सुविनिश्चितम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]