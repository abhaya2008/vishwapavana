[{"id": 7003319000, "chapter_id": 23319, "verse_number": "२-१४-१", "content_sanskrit": "सनत्कुमार उवाच  ।\nपंच ब्रह्माणि मे नंदिन्नाचक्ष्व गणसत्तम ।\nश्रेयःकरणभूतानि पवित्राणि शरीरिणाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003319001, "chapter_id": 23319, "verse_number": "२-१४-२", "content_sanskrit": "नंदिकेश्वर उवाच  ।\nशिवस्यैव स्वरूपाणि पंच ब्रह्माह्वयानि ते ।\nकथयामि यथातत्त्वं पद्मयोनेः सुतोत्तम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003319002, "chapter_id": 23319, "verse_number": "२-१४-३", "content_sanskrit": "सर्वलोकैकसंहर्ता सर्वलोकैकरक्षिता ।\nसर्वलोकैकनिर्माता पंचब्रह्मात्मकः शिवः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003319003, "chapter_id": 23319, "verse_number": "२-१४-४", "content_sanskrit": "सर्वेषामेव लोकानां यदुपादानकारणम् ।\nनिमित्तकारणं चाहुस्स शिवः पंचधा स्मृतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003319004, "chapter_id": 23319, "verse_number": "२-१४-५", "content_sanskrit": "मूर्तयः पंच विख्याताः पंच ब्रह्माह्वयाः पराः ।\nसर्वलोकशरण्यस्य शिवस्य परमात्मनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003319005, "chapter_id": 23319, "verse_number": "२-१४-६", "content_sanskrit": "क्षेत्रज्ञः प्रथमा मूर्तिशिवस्य परमेष्ठिनः ।\nभोक्ता प्रकृतिवर्गस्य भोग्यस्येशानसंज्ञितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]