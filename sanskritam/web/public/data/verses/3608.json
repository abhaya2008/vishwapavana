[{"id": 2121647, "chapter_id": 3608, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2121648, "chapter_id": 3608, "verse_number": "१", "content_sanskrit": "निहत्य नरकं भौमं वासवेन पुरस्कृतः ।\nसहितो लोकपालैश्च ददर्श नरकालयम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2121649, "chapter_id": 3608, "verse_number": "२", "content_sanskrit": "अथास्य गृहमासाद्य नरकस्य महात्मनः ।\nददर्श धनमक्षय्यं रत्नानि विविधानि च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2121650, "chapter_id": 3608, "verse_number": "३", "content_sanskrit": "मणिमुक्ताप्रवाळानि वैडूर्यविकृतानि च ।\nविस्तारकल्पार्कमणीन् विमलस्फाटिकानपि \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2121651, "chapter_id": 3608, "verse_number": "४", "content_sanskrit": "जाम्बूनदमयान्येव शातकुम्भमयानि च ।\nप्रदीप्तज्वलनाभानि शीतरश्मिप्रभाणि च ।\nहिरण्यवर्णं रुचिरं श्वेतमभ्यन्तरं गृहम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2121652, "chapter_id": 3608, "verse_number": "५", "content_sanskrit": "यदक्षयं गृहे दृष्टं नरकस्य धनं बहु ।\nनहि राज्ञः कुबेरस्य तावद्धनसमुच्छ्रयम् ।\nदृष्टपूर्वं पुरे साक्षान्महेन्द्रसदनेष्वपि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2121653, "chapter_id": 3608, "verse_number": "६", "content_sanskrit": "हते भौमे निसुम्भे च वासवः सगणोऽब्रवीत् ।\nदाशार्हपतिमासीनमाहृत्य मणिकुण्डले\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2121654, "chapter_id": 3608, "verse_number": "७", "content_sanskrit": "हेमसूत्रा महाकक्ष्याः तोमरैर्वीर्यशाळिनः ।\nभीमरूपाश्च मातङ्गाः प्रवाळविकृताः कुथाः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2121655, "chapter_id": 3608, "verse_number": "८", "content_sanskrit": "विमलानि पताकानि वासांसि विविधानि च ।\nते च विंशतिसाहस्रा द्विस्तावत्यः करेणवः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2121656, "chapter_id": 3608, "verse_number": "९", "content_sanskrit": "अष्टौ शतसहस्राणि देशजाश्चोत्तमा हयाः ।\nगोभिश्चाविकृतैर्यान्यैः कामं तव जनार्दन \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2121657, "chapter_id": 3608, "verse_number": "१०", "content_sanskrit": "आविकानि च सूक्ष्माणि शयनावसथानि च ।\nकामव्याहारिणश्चापि पक्षिणः प्रियदर्शनात्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2121658, "chapter_id": 3608, "verse_number": "११", "content_sanskrit": "चन्दनागरुमुख्यानि यानानि विविधानि च ।\nतच्च ते प्रापयिष्यामि वृष्ण्यावासमरिन्दम\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2121659, "chapter_id": 3608, "verse_number": "१२", "content_sanskrit": "वसु यत् त्रिषु लोकेषु धर्मेणैवार्जितं मया ।\nदेवगन्धर्वरत्नानि दैतेयासुरजानि च ।\nयानि सन्तीह रत्नानि नरकस्य निवेशने\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2121660, "chapter_id": 3608, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2121661, "chapter_id": 3608, "verse_number": "१३", "content_sanskrit": "एतत् तु गरुडे सर्वं क्षिप्रमारोप्य वासवः ।\nदाशार्हपतिना सार्धमुपायान्मणिपर्वतम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2121662, "chapter_id": 3608, "verse_number": "१४", "content_sanskrit": "तत्र पुण्या ववुर्वाताः प्रभाश्चित्राः समुज्ज्वलाः ।\nप्रेक्षतां सुरसङ्घानां विस्मयः समपद्यत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2121663, "chapter_id": 3608, "verse_number": "१५", "content_sanskrit": "त्रिदशा ऋषयश्चैव चन्द्रादित्यौ यथा दिवि ।\nप्रभया तस्य शैलस्य निर्विशेषमिवाभवत् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2121664, "chapter_id": 3608, "verse_number": "१६", "content_sanskrit": "अनुज्ञातस्तु रामेण केशवो वासवेन च ।\nप्रीयमाणो महाबाहुर्विवेश मणिपर्वतम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2121665, "chapter_id": 3608, "verse_number": "१७", "content_sanskrit": "तत्र वैडूर्यवर्णानि ददर्श मधुसूदनः ।\nगन्धर्वासुरनागानां प्रिया दुहितरस्तदा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2121666, "chapter_id": 3608, "verse_number": "१८", "content_sanskrit": "त्रिविष्टपसमे देशे तिष्ठन्तमपराजितम् ।\nपरिवव्रुर्महाबाहुमेकवेणीधराः स्त्रियः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2121667, "chapter_id": 3608, "verse_number": "१९", "content_sanskrit": "सर्वाः काषायवासिन्यः सर्वाश्च नियतेन्द्रियाः ।\nव्रतसन्तापजः शोको नात्र काञ्चिदपीडयत् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2121668, "chapter_id": 3608, "verse_number": "२०", "content_sanskrit": "अरजांसि च वासांसि बिभ्रत्यः कौशिकान्यपि ।\nसमेत्य यदुसिंहस्य चक्रुर्धाराञ्जलिं स्त्रियः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2121669, "chapter_id": 3608, "verse_number": "२१", "content_sanskrit": "ऊचुश्चैनं हृषीकेशं सर्वास्ताः कमलेक्षणाः ।\nनारदेन समाख्यातमस्माकं पुरुषोत्तम ।\nआगमिष्यति गोविन्दः सुरकार्यार्थसिद्धये\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2121670, "chapter_id": 3608, "verse_number": "२२", "content_sanskrit": "सोऽसुरं नरकं हत्वा निसुम्भं मुरमेव च ।\nभौमं च सपरीवारं हयग्रीवं च दानवम् ।\nतथा पञ्चजनं चैव प्राप्स्यते धनमक्षयम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2121671, "chapter_id": 3608, "verse_number": "२३", "content_sanskrit": "सोऽचिरेणैव कालेन युष्मद्भर्ता भविष्यति ।\nएवमुक्त्वाऽगमद् धीमान् देवर्षिर्नारदस्तदा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2121672, "chapter_id": 3608, "verse_number": "२४", "content_sanskrit": "त्वां चिन्तयानाः सततं तपो घोरमुपास्महे ।\nकालेऽतीते महाबाहुं कदा द्रक्ष्याम माधवम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2121673, "chapter_id": 3608, "verse_number": "२५", "content_sanskrit": "इत्येवं हृदि सङ्कल्पं कृत्वा पुरुषसत्तम ।\nतपश्चराम सततं रक्ष्यमाणा हि दानवैः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2121674, "chapter_id": 3608, "verse_number": "२६", "content_sanskrit": "ततोऽस्मत्प्रियकामार्थं भगवान् मारुतः स्वयम् ।\nयथोक्तं नारदेनाथ नचिरात् तद् भविष्यति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2121675, "chapter_id": 3608, "verse_number": "२७", "content_sanskrit": "तासां परमनारीणामृषभाक्षं पुरस्कृतम् ।\nददृशुर्देवगन्धर्वा गृष्टीनामिव गोपतिम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2121676, "chapter_id": 3608, "verse_number": "२८", "content_sanskrit": "तस्य चन्द्रोपमं वक्त्रमुदीक्ष्य मुदितेन्द्रियाः ।\nसम्प्रहृष्टा महाबाहुमिदं वचनमब्रुवन्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2121677, "chapter_id": 3608, "verse_number": "२९", "content_sanskrit": "सत्यं बत पुरा वायुरिदमस्मानिहाब्रवीत् ।\nसर्वभूतकृतज्ञश्च महर्षिरपि नारदः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2121678, "chapter_id": 3608, "verse_number": "३०", "content_sanskrit": "विष्णुर्नारायणो देवः शङ्खचक्रगदासिधृत् ।\nस भौमं नरकं हत्वा भर्ता वो भविता त्विह\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2121679, "chapter_id": 3608, "verse_number": "३१", "content_sanskrit": "दिष्ट्या तस्यर्षिमुख्यस्य नारदस्य महात्मनः ।\nवचनादेव सत्यं नो भर्ता भवितुमर्हति\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2121680, "chapter_id": 3608, "verse_number": "३२", "content_sanskrit": "यत् प्रियं बत पश्याम वक्त्रं चन्द्रोपमं तु ते ।\nदर्शनेन कृतार्थाः स्मो वयमद्य महात्मनः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2121681, "chapter_id": 3608, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2121682, "chapter_id": 3608, "verse_number": "३३", "content_sanskrit": "उवाच स यदुश्रेष्ठः सर्वास्ता जातमन्मथाः ।\nयथा ब्रूत विशालाक्ष्यस्तत् सर्वं वो भविष्यति\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2121683, "chapter_id": 3608, "verse_number": "३४", "content_sanskrit": "तानि सर्वाणि रत्नानि गमयित्वाऽथ किङ्करैः ।\nस्त्रियश्च गमयित्वाऽथ देवर्षिनृपकन्यकाः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2121684, "chapter_id": 3608, "verse_number": "३५", "content_sanskrit": "वैनतेयभुजे कृष्णो मणिपर्वतमुत्तमम् ।\nक्षिप्रमारोपयाञ्चक्रे भगवान् देवकीसुतः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2121685, "chapter_id": 3608, "verse_number": "३६", "content_sanskrit": "सपक्षिगणमातङ्गं सव्याळमृगपन्नगम् ।\nशाखामृगगणैर्जुष्टं सप्रस्तरशिलातळम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2121686, "chapter_id": 3608, "verse_number": "३७", "content_sanskrit": "न्यङ्कुभिश्च वराहैश्च रुरुभिश्च निषेवितम् ।\nसप्रपातमहासानुं विचित्राशिखिसङ्कुलम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2121687, "chapter_id": 3608, "verse_number": "३८", "content_sanskrit": "तं महेन्द्रानुजः शौरिः चकार गरुडोपरि ।\nपश्यतां सर्वभूतानामुत्पाट्य मणिपर्वतम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2121688, "chapter_id": 3608, "verse_number": "३९", "content_sanskrit": "उपेन्द्रं बलदेवं च वासवं च महाबलम् ।\nतं च रत्नौघमतुळं पर्वतं च महाबलः ।\nवरुणस्यामृतं दिव्यं छत्रं चन्द्रोपमं शुभम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2121689, "chapter_id": 3608, "verse_number": "४०", "content_sanskrit": "स्वपक्षबलविक्षेपैर्महाद्रिशिखरोपमैः ।\nदिक्षु सर्वासु संरावं स चक्रे गरुडो वहन् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2121690, "chapter_id": 3608, "verse_number": "४१", "content_sanskrit": "आरुहन् पर्वताग्राणि पादपांश्च समुत्क्षिपन् ।\nसञ्जहार महाभ्राणि वैश्वानरपथं गतः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2121691, "chapter_id": 3608, "verse_number": "४२", "content_sanskrit": "ग्रहनक्षत्रताराणां सप्तर्षिगणतेजसाम् ।\nप्रभाजालमतिक्रम्य चन्द्रसूर्यपथं गतः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2121692, "chapter_id": 3608, "verse_number": "४३", "content_sanskrit": "मेरोः शिखरमासाद्य मध्यमं मधुसूदनः ।\nदेवस्थानानि सर्वाणि ददर्श भरतर्षभ\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2121693, "chapter_id": 3608, "verse_number": "४४", "content_sanskrit": "विश्वेषां मरुतां चैव साध्यानां च युधिष्ठिर ।\nभ्राजमानान्यतिक्रम्य अश्विनोश्च परन्तप\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2121694, "chapter_id": 3608, "verse_number": "४५", "content_sanskrit": "प्राप्य पुण्यतमं स्थानं देवलोकमरिन्दमः ।\nशक्रसद्म समासाद्य चावरुह्य जनार्दनः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2121695, "chapter_id": 3608, "verse_number": "४६", "content_sanskrit": "सोऽभिवाद्यादितेः पादावर्चितः सर्वदैवतैः ।\nब्रह्मदक्षपुरोगैश्च प्रजापतिभिरेव च\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2121696, "chapter_id": 3608, "verse_number": "४७", "content_sanskrit": "अदितेः कुण्डले दिव्ये ददावथ तदा विभुः ।\nरत्नानि च परार्घ्याणि रामेण सह केशवः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2121697, "chapter_id": 3608, "verse_number": "४८", "content_sanskrit": "प्रतिगृह्य च तत् सर्वमदितिर्वासवानुजम् ।\nपूजयामास दाशार्हं रामं च विगतज्वरा\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2121698, "chapter_id": 3608, "verse_number": "४९", "content_sanskrit": "शची महेन्द्रमहिषी कृष्णस्य महिषीं तदा ।\nसत्यभामां तु सङ्गृह्य अदित्यै वै न्यवेदयत्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2121699, "chapter_id": 3608, "verse_number": "५०", "content_sanskrit": "सा तस्याः सत्यभामायाः कृष्णप्रियचिकीर्षया ।\nवरं प्रादाद् देवमाता सत्यायै विगतज्वरा\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2121700, "chapter_id": 3608, "verse_number": "५१", "content_sanskrit": "जरां न यास्यसि शुभे यावद्वै कृष्णमानुषम् ।\nसर्वगन्धगुणोपेता भविष्यसि वरानने\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2121701, "chapter_id": 3608, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2121702, "chapter_id": 3608, "verse_number": "५२", "content_sanskrit": "विहृत्य सत्यभामा वै पौलोम्या च सुमध्यमा ।\nशच्या च समनुज्ञाता ययौ कृष्णनिवेशनम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2121703, "chapter_id": 3608, "verse_number": "५३", "content_sanskrit": "सम्पूज्यमानस्त्रिदशैर्महर्षिगणसेवितः ।\nद्वारकां प्रययौ कृष्णो देवलोकादरिन्दमः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2121704, "chapter_id": 3608, "verse_number": "५४", "content_sanskrit": "सोऽवपद्य महाबाहुर्दीर्घमध्वानमच्युतः ।\nवर्धमानपुरद्वारमाससाद पुरोत्तमम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2121705, "chapter_id": 3608, "verse_number": "१९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि पञ्चाशोऽध्यायः ॥५०॥\n॥ अर्घाभिहरणपर्वणि एकोनविंशोऽध्यायः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2121706, "chapter_id": 3608, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]