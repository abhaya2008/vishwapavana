[{"id": 7000697000, "chapter_id": 20697, "verse_number": "६-४०-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nपौषस्य कृष्णपक्षे तु किं नामैकादशी भवेत् ।\nकिं नाम को विधिस्तस्या एतद्विस्तरतो वद ।\nएतदाख्याहि भो स्वामिन्को देवस्तत्र पूज्यते ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000697001, "chapter_id": 20697, "verse_number": "६-४०-२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nकथयिष्यामि राजेंद्र भवतः स्नेहबंधनात् ।\nतुष्टिर्मे न तथा राजन्यज्ञैर्बहुलदक्षिणैः ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000697002, "chapter_id": 20697, "verse_number": "६-४०-३", "content_sanskrit": "यथा मे तुष्टिरायाति ह्येकादशीव्रतेन वै ।\nतस्मात्सर्वप्रयत्नेन कर्त्तव्यो हरिवासरः ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000697003, "chapter_id": 20697, "verse_number": "६-४०-४", "content_sanskrit": "सत्यमेतन्न वै मिथ्या धर्मिष्ठानां विशारद ।\nपौषस्य कृष्णपक्षे या सफला नाम नामतः ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000697004, "chapter_id": 20697, "verse_number": "६-४०-५", "content_sanskrit": "तस्यां नारायणं देवं पूजयेच्च यथाविधि ।\nपूर्वेणैव विधानेन कर्त्तव्यैकादशी शुभा ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000697005, "chapter_id": 20697, "verse_number": "६-४०-६", "content_sanskrit": "नागानां च यथा शेषो पक्षिणां पन्नगाशनः ।\nदेवानां च यथा विष्णुर्द्विपदानां यथा द्विजः ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000697006, "chapter_id": 20697, "verse_number": "६-४०-७", "content_sanskrit": "व्रतानां च यथा राजन्श्रेष्ठा चैकादशी तिथिः ।\nते जनाश्चैव भो राजन्पूज्या वै सर्वदा मम ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000697007, "chapter_id": 20697, "verse_number": "६-४०-८", "content_sanskrit": "हरिवासरसंलीनाः कुर्वंत्येकादशीव्रतम् ।\nइहैव धनसंयुक्ता मृता मोक्षं लभंति ते ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000697008, "chapter_id": 20697, "verse_number": "६-४०-९", "content_sanskrit": "सफलायां फलै राजन्पूजयेन्नामतो हरिम् ।\nनारिकेलफलैश्चैव क्रमुकैर्बीजपूरकैः ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000697009, "chapter_id": 20697, "verse_number": "६-४०-१०", "content_sanskrit": "जंबीरैर्दाडिमैश्चैव तथा धात्रीफलैः शुभैः ।\nलवंगैर्बदरीभिश्च तथाम्रैश्च विशेषतः ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000697010, "chapter_id": 20697, "verse_number": "६-४०-११", "content_sanskrit": "पूजयेद्देवदेवेशं धूपदीपैस्तथैव च ।\nसफलायां विशेषेण दीपदानं तु कारयेत् ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000697011, "chapter_id": 20697, "verse_number": "६-४०-१२", "content_sanskrit": "रात्रौ जागरणं चैव कर्त्तव्यं सह वैष्णवैः ।\nयावन्निमेषो नेत्रस्य तावज्जागर्ति यो निशि ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000697012, "chapter_id": 20697, "verse_number": "६-४०-१३", "content_sanskrit": "एकाग्रमनसो राजन्तस्य पुण्यं शृणुष्व हि ।\nतत्समो नास्ति यज्ञो वै तीर्थं वा तत्समं नहि ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000697013, "chapter_id": 20697, "verse_number": "६-४०-१४", "content_sanskrit": "सर्वव्रतानि राजेंद्र कलां नार्हंति षोडशीम् ।\nएवं वर्षसहस्राणि तपसा नैव यत्फलम् ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000697014, "chapter_id": 20697, "verse_number": "६-४०-१५", "content_sanskrit": "तत्फलं समवाप्नोति यः करोति हि जागरम् ।\nश्रूयतां राजशार्दूल सफलायाः कथा शुभा ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000697015, "chapter_id": 20697, "verse_number": "६-४०-१६", "content_sanskrit": "चंपावतीति विख्याता पुरी माहिष्मतस्य च ।\nबभूवुस्तस्य राजर्षेः पुत्राः पंच कुमारकाः ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000697016, "chapter_id": 20697, "verse_number": "६-४०-१७", "content_sanskrit": "तेषां मध्ये तु ज्येष्ठो वै महापापरतः सदा ।\nपरदाराभिचारी च वेश्यासक्तश्च मद्यपः ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000697017, "chapter_id": 20697, "verse_number": "६-४०-१८", "content_sanskrit": "पितुर्द्रव्यं तु तेनैव गमितं पापकर्मणा ।\nअसद्वृत्तिरतो नित्यं भूसुराणां तु निंदकः ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000697018, "chapter_id": 20697, "verse_number": "६-४०-१९", "content_sanskrit": "वैष्णवानां च देवानां नित्यं निंदां करोति सः ।\nईदृशं तु ततो दृष्ट्वा पुत्रं माहिष्मतो नृपः ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000697019, "chapter_id": 20697, "verse_number": "६-४०-२०", "content_sanskrit": "नाम्ना तु लुंपक इति राजपुत्रेषु चापठत् ।\nराज्यान्निष्कासितस्तेन पित्रा चैव तु बंधुभिः ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000697020, "chapter_id": 20697, "verse_number": "६-४०-२१", "content_sanskrit": "स चैवं परिवारैस्तु त्यक्तश्च परिपंथिवत् ।\nलुंपकोऽपि तथा त्यक्तश्चिंतयामास वै तदा ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000697021, "chapter_id": 20697, "verse_number": "६-४०-२२", "content_sanskrit": "त्यक्तोऽहं बांधवैः पित्रा राज्यान्निष्कासितः किल ।\nइति संचिंत्यमानोऽसौ मतिं पापे तदाकरोत् ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000697022, "chapter_id": 20697, "verse_number": "६-४०-२३", "content_sanskrit": "मया गंतव्यमेवास्तु दारुणे गहने वने ।\nतस्माच्चैव पुरं सर्वं लुंपयिष्यामि वै पितुः ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000697023, "chapter_id": 20697, "verse_number": "६-४०-२४", "content_sanskrit": "इत्येवं स मतिं कृत्वा लुंपको दैवयोगतः ।\nनिर्जगाम पुरात्तस्माद्गतोऽसौ गहने वने ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000697024, "chapter_id": 20697, "verse_number": "६-४०-२५", "content_sanskrit": "जीवघातरतो नित्यं स्तेयद्यूतकलानिधिः ।\nसर्वं च नगरं तेन मुषितं पापकर्मणा ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000697025, "chapter_id": 20697, "verse_number": "६-४०-२६", "content_sanskrit": "स्तेयाभिगामी नगरे गृहीतः स निशाचरैः ।\nउवाच तान्सुतोऽहं वै राज्ञो माहिष्मतस्य च ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000697026, "chapter_id": 20697, "verse_number": "६-४०-२७", "content_sanskrit": "स तैर्मुक्तः पापकर्मा चागतो विपिनं पुनः ।\nआमिषाभिरतो नित्यं तरोर्वै फलभक्षणे ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000697027, "chapter_id": 20697, "verse_number": "६-४०-२८", "content_sanskrit": "आश्रमस्तस्य दुष्टस्य वासुदेवस्य संनिधौ ।\nअश्वत्थो वर्त्तते तत्र जीर्णश्च बहुवार्षिकः ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000697028, "chapter_id": 20697, "verse_number": "६-४०-२९", "content_sanskrit": "देवत्वं तस्य वृक्षस्य विपिने वर्तते महत् ।\nतत्रैव निवसंश्चैव लुंपकः पापबुद्धिमान् ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000697029, "chapter_id": 20697, "verse_number": "६-४०-३०", "content_sanskrit": "गते बहुतिथे काले कस्यचित्पुण्यसंचयात् ।\nपौषस्य कृष्णपक्षे तु दशम्यां दिवसे तथा ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000697030, "chapter_id": 20697, "verse_number": "६-४०-३१", "content_sanskrit": "फलानि भुक्त्वा वृक्षाणां रात्रौ शीतेन पीडितः ।\nलुंपको नाम पापिष्ठो वस्त्रहीनो गतेक्षणः ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000697031, "chapter_id": 20697, "verse_number": "६-४०-३२", "content_sanskrit": "पीड्यमानोऽतिशीतेन हरिवृक्षसमीपतः ।\nन निद्रा न सुखं तस्य गतप्राण इवाभवत् ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000697032, "chapter_id": 20697, "verse_number": "६-४०-३३", "content_sanskrit": "आछाद्य दशनैरास्यमेवं नीता निशाखिला ।\nभानूदयेऽपि पापिष्ठो न लेभे चेतनां तदा ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000697033, "chapter_id": 20697, "verse_number": "६-४०-३४", "content_sanskrit": "लुंपको गतसंज्ञस्तु सफलाया दिने तथा ।\nरवौ मध्यंगते चैव संज्ञां लेभे स लुंपकः ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000697034, "chapter_id": 20697, "verse_number": "६-४०-३५", "content_sanskrit": "इतस्ततो विलोक्याथ व्यथितश्च तदासनात् ।\nस्खलत्पद्भ्यां प्रचलितः खंजन्निव मुहुर्मुहुः ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000697035, "chapter_id": 20697, "verse_number": "६-४०-३६", "content_sanskrit": "वनमध्ये गतस्तत्र क्षुत्क्षामः पीडितोऽभवत् ।\nन शक्तिर्जीवघाते तु लुंपकस्य दुरात्मनः ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000697036, "chapter_id": 20697, "verse_number": "६-४०-३७", "content_sanskrit": "फलानि च तदा राजन्नाजहार स लुंपकः ।\nयावत्समागतस्तत्र तावदस्तं गतो रविः ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000697037, "chapter_id": 20697, "verse_number": "६-४०-३८", "content_sanskrit": "किं भविष्यति तातेति स विलापं चकार ह ।\nफलानि तत्र भूरीणि वृक्षमूले न्यवेशयत् ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000697038, "chapter_id": 20697, "verse_number": "६-४०-३९", "content_sanskrit": "इत्युवाच फलैरेभिः श्रीपतिस्तुष्यतां हरिः ।\nइत्युक्त्वा लुंपकश्चैव निद्रां लेभे न वै निशि ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000697039, "chapter_id": 20697, "verse_number": "६-४०-४०", "content_sanskrit": "रात्रौ जागरणं मेने विष्णुस्तस्य दुरात्मनः ।\nफलैस्तु पूजनं मेने सफलायास्तथानघ ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000697040, "chapter_id": 20697, "verse_number": "६-४०-४१", "content_sanskrit": "अकस्माद्व्रतमेवैतत्कृतवान्वै स लुंपकः ।\nतेन पुण्यप्रभावेन प्राप्तं राज्यमकंटकम् ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000697041, "chapter_id": 20697, "verse_number": "६-४०-४२", "content_sanskrit": "सूर्यस्योदयनं यावत्तावद्विष्णुर्जगाम ह ।\nदिवि तत्कालमुत्पन्ना वागुवाचाशरीरिणी ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000697042, "chapter_id": 20697, "verse_number": "६-४०-४३", "content_sanskrit": "राज्यं प्राप्स्यसि पुत्रत्वं सफलायाः प्रसादतः ।\nतथेत्युक्ते तु वचसि दिव्यरूपधरोऽभवत् ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000697043, "chapter_id": 20697, "verse_number": "६-४०-४४", "content_sanskrit": "मतिरासीत्ततस्तस्य परमा वैष्णवी नृप ।\nदिव्याभरणशोभाढ्यो लेभे राज्यमकंटकम् ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000697044, "chapter_id": 20697, "verse_number": "६-४०-४५", "content_sanskrit": "कृतं राज्यं तु तेनैवं वर्षाणि दशपंच च ।\nमनोदास्तस्यपुत्रास्तु दाराः कृष्णप्रसादतः ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000697045, "chapter_id": 20697, "verse_number": "६-४०-४६", "content_sanskrit": "आशु राज्यं परित्यज्य पुत्रे चैव समर्प्य च ।\nगतः कृष्णस्य सांनिध्यं यत्र गत्वा न शोचति ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000697046, "chapter_id": 20697, "verse_number": "६-४०-४७", "content_sanskrit": "एवं यः कुरुते राजन्सफलाव्रतमुत्तमम् ।\nइहलोके सुखं प्राप्य मृतो मोक्षमवाप्नुयात् ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000697047, "chapter_id": 20697, "verse_number": "६-४०-४८", "content_sanskrit": "धन्यास्ते मानवा लोके सफलायां च ये रताः ।\nतेषां च सफलं जन्म नात्र कार्या विचारणा ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000697048, "chapter_id": 20697, "verse_number": "६-४०-४९", "content_sanskrit": "पठनाच्छ्रवणाच्चैव करणाच्च विशांपते ।\nराजसूयस्य यज्ञस्य फलमाप्नोति मानवः ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]