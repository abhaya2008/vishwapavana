[{"id": 7003093000, "chapter_id": 23093, "verse_number": "४-२९-१", "content_sanskrit": "श्रीनारायण उवाच ।\nअथ गोपाङ्गनाः सर्वाः काममत्ततया मुने ।\nअतिप्रौढाश्च मानिन्यो नेश्वरं मेनिरे पतिम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003093001, "chapter_id": 23093, "verse_number": "४-२९-२", "content_sanskrit": "काश्चिदूचुरहो कृष्ण सस्मिता वक्रलोचनाः ।\nमालतीपुष्पमुत्तोल्य देहि मे मालिकामिति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003093002, "chapter_id": 23093, "verse_number": "४-२९-३", "content_sanskrit": "काश्चिदूचुरये कृष्ण स्वक्रोडेऽस्मांश्च कुर्विति ।\nगृहीत्वाश्रीहरेः स्कन्धमारुरोह च काचन ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003093003, "chapter_id": 23093, "verse_number": "४-२९-४", "content_sanskrit": "उवाच काचिद्दर्पेण प्रमत्ता प्राणवल्लभम् ।\nस्वकीयपीतवसनं परिधारय मामिति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003093004, "chapter_id": 23093, "verse_number": "४-२९-५", "content_sanskrit": "उवाच काचिदीशं तं सिन्दूरं देहि मामिति ।\nउवाच काचित्प्राणेशं शीघ्रमागत्य साम्प्रतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003093005, "chapter_id": 23093, "verse_number": "४-२९-६", "content_sanskrit": "कृत्वा कुन्तलसंस्कारं कुरु मे कबरीमिति ।\nकाश्चित्संप्रेरयामासुः श्रीखण्डं बल्लवाय च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003093006, "chapter_id": 23093, "verse_number": "४-२९-७", "content_sanskrit": "स्वांगवेषविधायिन्यो भूषार्थं श्रुतिमूलयोः ।\nउवाच काचित्कामेन परं संकेतपूर्वकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003093007, "chapter_id": 23093, "verse_number": "४-२९-८", "content_sanskrit": "पश्यन्ती तन्मुखाम्भोजं सस्मिता मैथुनाय च ।\nकाचिज्जग्राह मुरलीं बलादाकृष्य माधवम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003093008, "chapter_id": 23093, "verse_number": "४-२९-९", "content_sanskrit": "जहार पीतवसनं कृत्वा नग्नं च कामिनी ।\nकामिन्यः काश्चिदित्यूचुर्मानिन्यो मधुसूदनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003093009, "chapter_id": 23093, "verse_number": "४-२९-१०", "content_sanskrit": "अलक्तकद्रवं देहि पादयोर्नखरेषु च ।\nउवाच काचित्प्रेम्णा तं गण्डयोः स्तनयोर्मम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003093010, "chapter_id": 23093, "verse_number": "४-२९-११", "content_sanskrit": "नानाचित्रविचित्राढ्यां करु पत्रावलीमिति ।\nकृत्वाऽनुमानं मनसा दृष्ट्वा तासां प्रमत्तताम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003093011, "chapter_id": 23093, "verse_number": "४-२९-१२", "content_sanskrit": "माधवो राधया सार्द्धमन्तर्धानं चकार ह ।\nअतीव निर्जने स्थाने मुदा स्वेच्छामयो विभुः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003093012, "chapter_id": 23093, "verse_number": "४-२९-१३", "content_sanskrit": "कलामानप्रकारं च शृंगारं च चकार ह ।\nपर्वते पर्वते रम्ये द्वीपेद्वीपे सुनिर्जने ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003093013, "chapter_id": 23093, "verse_number": "४-२९-१४", "content_sanskrit": "तटे तटे नदीनां च सर्वजन्तुविवर्जिते ।\nश्रीगोष्ठे रत्नशैले च वेलागङ्गातटेऽपि च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003093014, "chapter_id": 23093, "verse_number": "४-२९-१५", "content_sanskrit": "कालिन्दे च पुलिन्दे च मन्दिरे गन्धमादने ।\nमनोहरे कुन्दवने कावेरीतीरनीरजे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003093015, "chapter_id": 23093, "verse_number": "४-२९-१६", "content_sanskrit": "पुष्पभद्रापुलिनजे पुष्पोद्याने सुपुष्पिते ।\nसर्वत्र रमणं कृत्वा राधावेषं विधाय च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003093016, "chapter_id": 23093, "verse_number": "४-२९-१७", "content_sanskrit": "जगाम मलयद्रोणीं रम्यां चन्दनवायुना ।\nशय्यां पुष्पमयीं कृत्वा तत्र रेमे तया सह ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003093017, "chapter_id": 23093, "verse_number": "४-२९-१८", "content_sanskrit": "अतीव सुखसंभोगान्मूर्च्छां संप्राप्य राधिका ।\nकृत्वा वक्षसि गोविन्दं पुलकाञ्चितविग्रहा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003093018, "chapter_id": 23093, "verse_number": "४-२९-१९", "content_sanskrit": "दृष्ट्वा तां मूर्च्छितां कृष्णो घनश्रोणिपयोधराम् ।\nविलुप्तवेषां कामार्तां नग्नां शिथिलकुन्तलाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003093019, "chapter_id": 23093, "verse_number": "४-२९-२०", "content_sanskrit": "चेतनां कारयामास कृत्वा वक्षसि तन्द्रिताम् ।\nवासयामास वसनं राधायामेखलाम्बरम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003093020, "chapter_id": 23093, "verse_number": "४-२९-२१", "content_sanskrit": "कबरीं रचयामास किंचिद्वामेन वक्रताम् ।\nमालतीमाल्यसंयुक्तां कुन्दपुष्पैश्च वेष्टिताम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003093021, "chapter_id": 23093, "verse_number": "४-२९-२२", "content_sanskrit": "तस्याः कपाले सिंदूरतिलकं सुन्दरं ददौ ।\nगण्डयोः स्तनयोश्चित्रां चकार पत्रिकां मुदा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003093022, "chapter_id": 23093, "verse_number": "४-२९-२३", "content_sanskrit": "सालक्तकांश्च नखरांश्चित्रितान्पादपद्मयोः ।\nनखैः कृत्रिमपद्मानि निर्ममे श्रोणिवक्षसोः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003093023, "chapter_id": 23093, "verse_number": "४-२९-२४", "content_sanskrit": "उत्थायाथ तया सार्द्धं जगाम हि सरोवरम् ।\nनानाप्रकारपद्मानां राजिभिश्च विराजितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003093024, "chapter_id": 23093, "verse_number": "४-२९-२५", "content_sanskrit": "निर्मलस्फटिकाकारजलपूर्णं मनोहरम् ।\nहंसकारण्डवाकीर्णं जलकुक्कुटकूजितम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003093025, "chapter_id": 23093, "verse_number": "४-२९-२६", "content_sanskrit": "मधुलुब्धमधुघ्राणां पद्मस्थानं सुपद्मजम् ।\nचारुणा कलशब्देन शब्दितं शश्वदेव हि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003093026, "chapter_id": 23093, "verse_number": "४-२९-२७", "content_sanskrit": "तत्र स्नात्वा जलक्रीडां चकार ह तया सह ।\nजलं ददौ राधिकायै मुदा सा माधवाय च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003093027, "chapter_id": 23093, "verse_number": "४-२९-२८", "content_sanskrit": "सहस्रदलपद्मे च गृहीत्वा माधवः स्वयम्।\nएकं ददौ राधिकायै ररक्ष स्वार्थमेककम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003093028, "chapter_id": 23093, "verse_number": "४-२९-२९", "content_sanskrit": "चन्दनागुरुकस्तूरीकुङ्कुमद्रवमीप्सितम् ।\nस्वाङ्गं दत्त्वा राधिकायै लिलेप राधिकेश्वरः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003093029, "chapter_id": 23093, "verse_number": "४-२९-३०", "content_sanskrit": "ततो गच्छंस्तया सार्द्धं ददर्श पुरतो वटम् ।\nअतीवोत्तुङ्गशाखाग्रमतिविस्तृतमेव च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003093030, "chapter_id": 23093, "verse_number": "४-२९-३१", "content_sanskrit": "मूले योजनपर्यन्तं छायया परिवेष्टितम् ।\nउवास तत्र गोविन्दः केतकीवनसन्निधौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003093031, "chapter_id": 23093, "verse_number": "४-२९-३२", "content_sanskrit": "पुष्पाक्तेन सुशीतेन वायुना सुरभीकृते ।\nचित्रं रहस्यं सुचिरं पुराणं च पुरातनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003093032, "chapter_id": 23093, "verse_number": "४-२९-३३", "content_sanskrit": "प्रहर्षितश्च श्रीकृष्णः कथयामास राधिकाम्।\nएतस्मिन्नन्तरे तत्र ददर्श मुनिपुंगवम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003093033, "chapter_id": 23093, "verse_number": "४-२९-३४", "content_sanskrit": "आगच्छन्तं च तं दृष्ट्वा प्रसन्नवदनेक्षणम् ।\nन दृष्ट्वा हृदये रूपमीशस्य परमात्मनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003093034, "chapter_id": 23093, "verse_number": "४-२९-३५", "content_sanskrit": "ध्यानाद्विरतमग्रे च पश्यन्तं बहिरेव तत् ।\nसर्वावयववक्रं च कृष्णं सर्वदिगम्बरम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003093035, "chapter_id": 23093, "verse_number": "४-२९-३६", "content_sanskrit": "नाम्नाऽष्टवक्रं जटिलं ज्वलन्तं ब्रह्मतेजसा ।\nमुखतोऽग्निमुद्गिरन्तं तपोराशिमिवोत्थितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003093036, "chapter_id": 23093, "verse_number": "४-२९-३७", "content_sanskrit": "अहो किं वा ब्रह्मतेजो मूर्तिमन्तमिह स्वयम् ।\nनखश्मश्रुसुदीर्घं च शांतं तेजस्विनं परम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003093037, "chapter_id": 23093, "verse_number": "४-२९-३८", "content_sanskrit": "पुटाञ्जलियुतं भक्त्या भीतं प्रणतकंधरम् ।\nदृष्ट्वा हसन्तीं राधां तां वारयामास माधवः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003093038, "chapter_id": 23093, "verse_number": "४-२९-३९", "content_sanskrit": "प्रभावं कथयामास मुनीन्द्रस्य महात्मनः ।\nअथ प्रणम्य गोविन्दं तुष्टाव मुनिपुंगवः ।\nयत्स्तोत्रं च पुरा दत्तं शंकरेण महात्मना ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003093039, "chapter_id": 23093, "verse_number": "४-२९-४०", "content_sanskrit": "अष्टावक्र उवाच ।\nगुणातीत गुणाधार गुणबीज गुणात्मक ।\nगुणीश गुणिनां बीज गुणायन नमोऽस्तु ते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003093040, "chapter_id": 23093, "verse_number": "४-२९-४१", "content_sanskrit": "सिद्धिस्वरूप सिद्ध्येश सिद्धिबीज परात्पर ।\nसिद्धिसिद्धिगुणाधीश सिद्धानां गुरवे नमः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003093041, "chapter_id": 23093, "verse_number": "४-२९-४२", "content_sanskrit": "हे वेदबीज वेदज्ञ वेदिन्वेदविदां वर ।\nवेदाज्ञाताद्यरूपेश वेदाज्ञेश नमोऽस्तु  ते४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003093042, "chapter_id": 23093, "verse_number": "४-२९-४३", "content_sanskrit": "ब्रह्मानन्तेश शेषेन्द्र धर्मादीनामधीश्वर ।\nसर्व सर्वेश शर्वेश बीजरूप नमोऽस्तु ते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003093043, "chapter_id": 23093, "verse_number": "४-२९-४४", "content_sanskrit": "प्रकृते प्राकृत प्रज्ञ प्रकृतीश परात्पर ।\nसंसारवृक्ष तद्बीज  फलरूप नमोऽस्तु ते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003093044, "chapter_id": 23093, "verse_number": "४-२९-४५", "content_sanskrit": "सृष्टिस्थित्यन्तबीजेश सृष्टिस्थित्यन्तकारण ।\nमहाविराट्तरोर्बीज राधिकेश नमोऽस्तु ते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003093045, "chapter_id": 23093, "verse_number": "४-२९-४६", "content_sanskrit": "अहो यस्य त्रयः स्कन्धा ब्रह्मविष्णुमहेश्वराः ।\nशाखाप्रशाखा वेदाद्यास्तपांसि कुसुमानि च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003093046, "chapter_id": 23093, "verse_number": "४-२९-४७", "content_sanskrit": "संसारविफला एव प्रकृत्यंकुरमेव च ।\nतदाधार निराधार सर्वाधार नमोऽस्तु ते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003093047, "chapter_id": 23093, "verse_number": "४-२९-४८", "content_sanskrit": "तेजोरूप निराकार प्रत्यक्षानूहमेव च ।\nसर्वाकारातिप्रत्यक्ष स्वेच्छामय नमोऽस्तु ते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003093048, "chapter_id": 23093, "verse_number": "४-२९-४९", "content_sanskrit": "इत्युक्त्वा स मुनिश्रेष्ठो निपत्य चरणाम्बुजे ।\nप्राणांस्तत्याज योगेन तयोः प्रत्यक्ष एव च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003093049, "chapter_id": 23093, "verse_number": "४-२९-५०", "content_sanskrit": "पपात तत्र तद्देहः पादपद्मसमीपतः ।\nतत्तेजश्च समुत्तस्थौ ज्वलदग्निशिखोपमम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003093050, "chapter_id": 23093, "verse_number": "४-२९-५१", "content_sanskrit": "सप्ततालप्रमाणं तु चोत्थाय च पपात ह। ।\nभ्रामं भ्रामं च परितो लीनं चाभूत्पदाम्बुजे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003093051, "chapter_id": 23093, "verse_number": "४-२९-५२", "content_sanskrit": "अष्टावक्रकृतं स्तोत्रं प्रातरुत्थाय यः पठेत् ।\nपरं निर्वाण मोक्षं च समाप्नोति न संशयः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003093052, "chapter_id": 23093, "verse_number": "४-२९-५३", "content_sanskrit": "प्राणाधिको मुमुक्षूणां स्तोत्रराजश्च नारद ।\nहरिणाऽहो पुरा दत्तो वैकुण्ठे शंकराय च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]