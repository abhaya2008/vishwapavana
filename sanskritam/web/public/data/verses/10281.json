[{"id": 6000281000, "chapter_id": 10281, "verse_number": null, "content_sanskrit": "अथ पञ्चाशीतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000281001, "chapter_id": 10281, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.001.m4a", "display_order": 2}, {"id": 6000281002, "chapter_id": 10281, "verse_number": "१०-८५-१", "content_sanskrit": "अजातशत्रोस्तं दृष्ट्वा राजसूयमहोदयम्।\nसर्वे मुमुदिरे ब्रह्मन् देवा ये च समागताः॥ १०/८५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.002.m4a", "display_order": 3, "topics": [{"text": "राजसूयावभृथसम्भ्रमः", "range": "१–३०"}]}, {"id": 6000281003, "chapter_id": 10281, "verse_number": "१०-८५-२", "content_sanskrit": "दुर्योधनं वर्जयित्वा राजान ऋषयः सुराः।\nइति श्रुतं नो भगवंस्तत्र कारणमुच्यताम्॥ १०/८५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.003.m4a", "display_order": 4}, {"id": 6000281004, "chapter_id": 10281, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.004.m4a", "display_order": 5}, {"id": 6000281005, "chapter_id": 10281, "verse_number": "१०-८५-३", "content_sanskrit": "पितामहस्य ते यज्ञे राजसूये महात्मनः।\nबान्धवाः परिचर्यायां तस्यासन् प्रेमबन्धनाः॥ १०/८५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.005.m4a", "display_order": 6}, {"id": 6000281006, "chapter_id": 10281, "verse_number": "१०-८५-४", "content_sanskrit": "भीमो महानसाध्यक्षो धनाध्यक्षः सुयोधनः।\nसहदेवस्तु पूजायां नकुलो द्रव्यसाधने॥ १०/८५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.006.m4a", "display_order": 7}, {"id": 6000281007, "chapter_id": 10281, "verse_number": "१०-८५-५", "content_sanskrit": "सतां शुश्रूषणे जिष्णुः कृष्णः पादावनेजने।\nपरिवेषणे द्रुपदजा कर्णो दाने महामनाः॥ १०/८५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.007.m4a", "display_order": 8}, {"id": 6000281008, "chapter_id": 10281, "verse_number": "१०-८५-६", "content_sanskrit": "युयुधानो विकर्णश्च हार्दिक्यो विदुरादयः।\nबाह्लीकपुत्रा भूर्याद्या ये च सन्तर्दनादयः॥ १०/८५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.008.m4a", "display_order": 9}, {"id": 6000281009, "chapter_id": 10281, "verse_number": "१०-८५-७", "content_sanskrit": "निरूपिता महायज्ञे नानाकर्मसु ते तदा।\nप्रवर्तन्ते स्म राजेन्द्र राज्ञः प्रियचिकीर्षया॥ १०/८५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.009.m4a", "display_order": 10}, {"id": 6000281010, "chapter_id": 10281, "verse_number": "१०-८५-८", "content_sanskrit": "ऋत्विक्सदस्यबहुवित्सु सुहृत्तमेषु स्विष्टेषु सूनृतमहार्हणदक्षिणाभिः।\nचैद्ये च सात्त्वतपतेश्चरणं प्रविष्टे चक्रुस्ततस्त्ववभृथस्नपनं द्युनद्याम्॥ १०/८५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.010.m4a", "display_order": 11}, {"id": 6000281011, "chapter_id": 10281, "verse_number": "१०-८५-९", "content_sanskrit": "मृदङ्गशङ्खपणवधुन्धुर्यानकगोमुखाः।\nवादित्राणि विचित्राणि नेदुरारान्महोत्सवे॥ १०/८५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.011.m4a", "display_order": 12}, {"id": 6000281012, "chapter_id": 10281, "verse_number": "१०-८५-१०", "content_sanskrit": "नर्तक्यो ननृतुर्हृष्टा गायका यूथशो जगुः।\nवीणावेणुतलोन्नादस्तेषां स दिवमस्पृशत्॥ १०/८५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.012.m4a", "display_order": 13}, {"id": 6000281013, "chapter_id": 10281, "verse_number": "१०-८५-११", "content_sanskrit": "चित्रध्वजपताकाढ्यैरिभेन्द्रस्यन्दनादिभिः।\nस्वलङ्कृतैर्भटैर्भूपा निर्ययू रुग्ममालिनः॥ १०/८५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.013.m4a", "display_order": 14}, {"id": 6000281014, "chapter_id": 10281, "verse_number": "१०-८५-१२", "content_sanskrit": "यदुसृञ्जयकाम्बोजाः कुरुकोसलकेकयाः।\nकम्पयन्तो भुवं सैन्यैर्यजमानपुरःसराः॥ १०/८५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.014.m4a", "display_order": 15}, {"id": 6000281015, "chapter_id": 10281, "verse_number": "१०-८५-१३", "content_sanskrit": "सदस्यर्त्विग्द्विजश्रेष्ठा ब्रह्मघोषेण भूयसा।\nदेवर्षिपितृगन्धर्वास्तुष्टुवुः पुष्पवर्षिणः॥ १०/८५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.015.m4a", "display_order": 16}, {"id": 6000281016, "chapter_id": 10281, "verse_number": "१०-८५-१४", "content_sanskrit": "स्वलङ्कृता नरा नार्यो गन्धस्रग्भूषणाम्बरैः।\nविलिम्पन्तोऽभिषिञ्चन्तो विजह्रुर्विविधै रसैः॥ १०/८५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.016.m4a", "display_order": 17}, {"id": 6000281017, "chapter_id": 10281, "verse_number": "१०-८५-१५", "content_sanskrit": "तैलगोरसगन्धोदहरिद्रासान्द्रकुङ्कुमैः।\nपुम्भिर्लिप्ताः प्रलिम्पन्त्यो विजह्रुर्वारयोषितः॥ १०/८५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.017.m4a", "display_order": 18}, {"id": 6000281018, "chapter_id": 10281, "verse_number": "१०-८५-१६", "content_sanskrit": "गुप्ता नृभिर्निरगमन्नुपलब्धुमेतद् देव्यो यथा दिवि विमानवरैर्नृदेव्यः।\nता मातुलेयसखिभिः परिषिच्यमानाः सव्रीडहासविकसद्वदना विरेजुः॥ १०/८५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.018.m4a", "display_order": 19}, {"id": 6000281019, "chapter_id": 10281, "verse_number": "१०-८५-१७", "content_sanskrit": "ता देवरानुत सखीन् सिषिचुर्दृतीभिः क्लिन्नाम्बरा विवृतगात्रकुचोरुमध्याः।\nऔत्सुक्यमुक्तकबरच्यवमानमाल्याः क्षोभं दधुर्मलधियां रुचिरैः समेताः॥ १०/८५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.019.m4a", "display_order": 20}, {"id": 6000281020, "chapter_id": 10281, "verse_number": "१०-८५-१८", "content_sanskrit": "स सम्राड् रथमारूढः सदश्वं रुग्ममालिनम्।\nव्यरोचत स्वपत्नीभिः क्रियाभिः क्रतुराडिव॥ १०/८५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.020.m4a", "display_order": 21}, {"id": 6000281021, "chapter_id": 10281, "verse_number": "१०-८५-१९", "content_sanskrit": "पत्नीसंयाजावभृथ्यैश्चरित्वा ते तमृत्विजः।\nआचान्तं स्नापयाञ्चक्रुर्गङ्गायां सह कृष्णया॥ १०/८५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.021.m4a", "display_order": 22}, {"id": 6000281022, "chapter_id": 10281, "verse_number": "१०-८५-२०", "content_sanskrit": "दिवि दुन्दुभयो नेदुर्नरदुन्दुभिभिः समम्।\nमुमुचुः पुष्पवर्षाणि देवर्षिपितृमानवाः॥ १०/८५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.022.m4a", "display_order": 23}, {"id": 6000281023, "chapter_id": 10281, "verse_number": "१०-८५-२१", "content_sanskrit": "सस्नुस्तत्र ततः सर्वे वर्णाश्रमयुता जनाः।\nअथ राजाऽहते क्षौमे परिधाय स्वलङ्कृतः॥ १०/८५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.023.m4a", "display_order": 24}, {"id": 6000281024, "chapter_id": 10281, "verse_number": "१०-८५-२२", "content_sanskrit": "ऋत्विक्सदस्यविप्रादीनानर्च्याभरणाम्बरैः।\nबन्धून् ज्ञातीन् नृपान् मित्रसुहृदोऽन्यांश्च सर्वशः॥ १०/८५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.024.m4a", "display_order": 25}, {"id": 6000281025, "chapter_id": 10281, "verse_number": "१०-८५-२३", "content_sanskrit": "अभीक्ष्णं पूजयामास नारायणपरो नृपः॥ १०/८५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.025.m4a", "display_order": 26}, {"id": 6000281026, "chapter_id": 10281, "verse_number": "१०-८५-२४", "content_sanskrit": "सर्वे जनाः सुररुचो मणिकुण्डलस्रगुष्णीषकञ्चुकदुकूलमहार्घ्यहाराः।\nनार्यश्च कुण्डलयुगालकवृन्दजुष्टवक्त्रश्रियः कनकमेखलया विरेजुः॥ १०/८५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.026.m4a", "display_order": 27}, {"id": 6000281027, "chapter_id": 10281, "verse_number": "१०-८५-२५", "content_sanskrit": "अथर्त्विजो महाशिक्षाः सदस्या ब्रह्मवादिनः।\nविप्रक्षत्रियविट्शूद्रा राजानो ये समागताः॥ १०/८५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.027.m4a", "display_order": 28}, {"id": 6000281028, "chapter_id": 10281, "verse_number": "१०-८५-२६", "content_sanskrit": "देवर्षिपितृभूतानि लोकपालाः सहानुगाः।\nपूजितास्तमनुज्ञाप्य स्वधामानि ययुर्मुदा॥ १०/८५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.028.m4a", "display_order": 29}, {"id": 6000281029, "chapter_id": 10281, "verse_number": "१०-८५-२७", "content_sanskrit": "हरिदासस्य राजर्षे राजसूयमहोदयम्।\nनैवातृप्यन् प्रशंसन्तः पिबन् मर्त्यो यथाऽमृतम्॥ १०/८५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.029.m4a", "display_order": 30}, {"id": 6000281030, "chapter_id": 10281, "verse_number": "१०-८५-२८", "content_sanskrit": "ततो युधिष्ठिरो राजा सुहृत्सम्बन्धिबान्धवान्।\nप्रेम्णा निवारयामास कृष्णं च त्यागकातरः॥ १०/८५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.030.m4a", "display_order": 31}, {"id": 6000281031, "chapter_id": 10281, "verse_number": "१०-८५-२९", "content_sanskrit": "भगवानपि तत्राङ्ग न्यवात्सीत् तत्प्रियङ्करः।\nप्रस्थाप्य यदुवीरान् स्वान् साम्बादींस्तु कुशस्थलीम्॥ १०/८५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.031.m4a", "display_order": 32}, {"id": 6000281032, "chapter_id": 10281, "verse_number": "१०-८५-३०", "content_sanskrit": "इत्थं राजा धर्मसुतो मनोरथमहार्णवम्।\nसुसमृद्धं समुत्तीर्य कृष्णेनासीद् गतज्वरः॥ १०/८५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.032.m4a", "display_order": 33}, {"id": 6000281033, "chapter_id": 10281, "verse_number": "१०-८५-३१", "content_sanskrit": "एकदान्तःपुरे तस्य वीक्ष्य दुर्योधनः श्रियम्।\nअतप्यद् राजसूयस्य महित्वं चाच्युतात्मनः॥ १०/८५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.033.m4a", "display_order": 34, "topics": [{"text": "ततः सभायामुपविष्टानां पाण्डवानां वैभववर्णनम्", "range": "३१–३६"}]}, {"id": 6000281034, "chapter_id": 10281, "verse_number": "१०-८५-३२", "content_sanskrit": "यस्मिन् नरेन्द्रदितिजेन्द्रसुरेन्द्रलक्ष्म्यो नाना विभान्ति किल विश्वसृजोपकॢप्ताः।\nताभिः पतिं द्रुपदराजसुतोपतस्थे यस्यां विषक्तहृदयः कुरुराज एषः॥ १०/८५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.034.m4a", "display_order": 35}, {"id": 6000281035, "chapter_id": 10281, "verse_number": "१०-८५-३३", "content_sanskrit": "यस्मिंस्तदा मधुरिपोर्महिषीसहस्रं श्रोणीभरेण शनकैः क्‍वणदङ्घ्रिशोभम्।\nवक्षस्सुचारुकुचकुङ्कुमशोणहारं श्रीमन्मुखं च चलकुण्डलकुन्तलाढ्यम्॥ १०/८५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.035.m4a", "display_order": 36}, {"id": 6000281036, "chapter_id": 10281, "verse_number": "१०-८५-३४", "content_sanskrit": "सभायां मयक्लृप्तायां क्‍वापि धर्मसुतो विराट्।\nवृतोऽनुजैर्बन्धुभिश्च कृष्णेनापि स्वचक्षुषा॥ १०/८५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.036.m4a", "display_order": 37}, {"id": 6000281037, "chapter_id": 10281, "verse_number": "१०-८५-३५", "content_sanskrit": "आसीनः काञ्चने साक्षादासने मघवानिव।\nपारमेष्ठ्यश्रिया जुष्टः स्तूयमानश्च बन्दिभिः॥ १०/८५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.037.m4a", "display_order": 38}, {"id": 6000281038, "chapter_id": 10281, "verse_number": "१०-८५-३६", "content_sanskrit": "उपास्यमानो विप्रेन्द्रैर्नानादेशसमागतैः। दोधूयमानो धवलैर्बालव्यजनसङ्कुलैः।\nरराज राजशार्दूलो दिवि देवपतिर्यथा॥ १०/८५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_085/BhP_10.085.038.m4a", "display_order": 39}, {"id": 6000281039, "chapter_id": 10281, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे पञ्चाशीतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]