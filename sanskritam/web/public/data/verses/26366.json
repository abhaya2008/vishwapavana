[{"id": 7006366000, "chapter_id": 26366, "verse_number": "२-२२-१", "content_sanskrit": "वैशम्पायन उवाच\nकृष्णं व्रजगतं श्रुत्वा वर्धमानमिवानलम् ।\nउद्वेगमगमत् कंसः शङ्कमानस्ततो भयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006366001, "chapter_id": 26366, "verse_number": "२-२२-२", "content_sanskrit": "पूतनायां हतायां च कालिये च पराजिते ।\nधेनुके प्रलयं नीते प्रलम्बे च निपातिते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006366002, "chapter_id": 26366, "verse_number": "२-२२-३", "content_sanskrit": "धृते गोवर्धने शैले विफले शक्रशासने ।\nगोषु त्रातासु च तथा स्पृहणीयेन कर्मणा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006366003, "chapter_id": 26366, "verse_number": "२-२२-४", "content_sanskrit": "ककुद्मिनि हतेऽरिष्टे गोपेषु मुदितेषु च ।\nदृश्यमाने विनाशे च संनिकृष्टे महाभये ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006366004, "chapter_id": 26366, "verse_number": "२-२२-५", "content_sanskrit": "कर्षणे वृक्षयोश्चैव शकटस्य तथैव च ।\nअचिन्त्यं कर्म्म तच्छ्रुत्वा वर्धमानेषु शत्रुषु ॥ ५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006366005, "chapter_id": 26366, "verse_number": "२-२२-६", "content_sanskrit": "प्राप्तारिष्टमिवात्मानं मेने स मथुरेश्वरः ।\nविसंज्ञेन्द्रियभूतात्मा गतासुप्रतिमो बभौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006366006, "chapter_id": 26366, "verse_number": "२-२२-७", "content_sanskrit": "ततो ज्ञातीन् समानाय्य पितरं चोग्रशासनः ।\nनिशि स्तिमितमूकायां मथुरायां जनाधिपः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006366007, "chapter_id": 26366, "verse_number": "२-२२-८", "content_sanskrit": "वसुदेवं च देवाभं कङ्कं चाहूय यादवम् ।\nसत्यकं दारुकं चैव कङ्कावरजमेव च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006366008, "chapter_id": 26366, "verse_number": "२-२२-९", "content_sanskrit": "भोजं वैतरणं चैव विकद्रुं च महाबलम् ।\nभयशङ्खं च धर्मज्ञं विपृथुं च पृथुश्रियम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006366009, "chapter_id": 26366, "verse_number": "२-२२-१०", "content_sanskrit": "बभ्रुं दानपतिं चैव कृतवर्माणमेव च ।\nभूरितेजसमक्षोभ्यं भूरिश्रवसमेव च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006366010, "chapter_id": 26366, "verse_number": "२-२२-११", "content_sanskrit": "एतान्स यादवान् सर्वानाभाष्य शृणुतेति च ।\nउग्रसेनसुतो राजा प्रोवाच मथुरेश्वरः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006366011, "chapter_id": 26366, "verse_number": "२-२२-१२", "content_sanskrit": "भवन्तः सर्वकार्यज्ञा वेदेषु परिनिष्ठिताः ।\nन्यायवृत्तान्तकुशलास्त्रिवर्गस्य प्रवर्तकाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006366012, "chapter_id": 26366, "verse_number": "२-२२-१३", "content_sanskrit": "कर्तव्यानां च कर्तारो लोकस्य विबुधोपमाः ।\nतस्थिवांसो महावृत्ते निष्कम्पा इव पर्वताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006366013, "chapter_id": 26366, "verse_number": "२-२२-१४", "content_sanskrit": "अदम्भवृत्तयः सर्वे सर्वे गुरुकुलोषिताः ।\nराजमन्त्रधराः सर्वे सर्वे धनुषि पारगाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006366014, "chapter_id": 26366, "verse_number": "२-२२-१५", "content_sanskrit": "यशःप्रदीपा लोकानां वेदार्थानां विवक्षवः ।\nआश्रमाणां निसर्गज्ञा वर्णानां क्रमपारगाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006366015, "chapter_id": 26366, "verse_number": "२-२२-१६", "content_sanskrit": "प्रवक्तारः सुनियतां नेतारो नयदर्शिनाम् ।\nभेत्तारः परराष्ट्राणां त्रातारः शरणार्थिनाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006366016, "chapter_id": 26366, "verse_number": "२-२२-१७", "content_sanskrit": "एवमक्षतचारित्रैः श्रीमद्भिरुदितोदितैः ।\nद्यौरप्यनुगृहीता स्याद्भवद्भिः किं पुनर्मही ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006366017, "chapter_id": 26366, "verse_number": "२-२२-१८", "content_sanskrit": "ऋषीणामिव वो वृत्तं प्रभावो मरुतामिव ।\nरुद्राणामिव वः क्रोधो दीप्तिरङ्गिरसारमिव ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006366018, "chapter_id": 26366, "verse_number": "२-२२-१९", "content_sanskrit": "व्यावर्तमानं सुमहद् भवद्भिः ख्यात कीर्तिभिः ।\nधृतं यदुकुलं वीरैर्भूतलं पर्वतैरिव ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006366019, "chapter_id": 26366, "verse_number": "२-२२-२०", "content_sanskrit": "एवं भवत्सु युक्तेषु मम चित्तानुवर्तिषु ।\nवर्धमानो ममानर्थो भवद्भिः किमुपेक्षितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006366020, "chapter_id": 26366, "verse_number": "२-२२-२१", "content_sanskrit": "एष कृष्ण इति ख्यातो नन्दगोपसुतो व्रजे ।\nवर्धमान इवाम्भोभिर्मूलं नः परिकृन्तति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006366021, "chapter_id": 26366, "verse_number": "२-२२-२२", "content_sanskrit": "अनमात्यस्य शून्यस्य चारान्धस्य ममैव तु ।\nकारणान्नन्दगोपस्य स सुतो गोपितो गृहे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006366022, "chapter_id": 26366, "verse_number": "२-२२-२३", "content_sanskrit": "उपेक्षित इव व्याधिः पूर्यमाण इवाम्बुदः ।\nनदन्मेघ इवोष्णान्ते स दुरात्मा विवर्धते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006366023, "chapter_id": 26366, "verse_number": "२-२२-२४", "content_sanskrit": "तस्य नाहं गतिं जाने न योगं न पराक्रमम् ।\nनन्दगोपस्य भवने जातस्याद्भुतकर्मणः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006366024, "chapter_id": 26366, "verse_number": "२-२२-२५", "content_sanskrit": "किं तद्भूतं समुद्भूतं देवापत्यं न विद्महे ।\nअतिदेवैरमानुष्यैः कर्मभिः सोऽनुमीयते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006366025, "chapter_id": 26366, "verse_number": "२-२२-२६", "content_sanskrit": "पूतना शकुनी बाल्ये शिशुनोत्तानशायिना ।\nस्तनपानेप्सुना पीता प्राणैः सह दुरासदा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006366026, "chapter_id": 26366, "verse_number": "२-२२-२७", "content_sanskrit": "यमुनाया ह्रदे नागः कालियो दमितस्तथा ।\nरसातलचरो नीतः क्षणेनादर्शनं ह्रदात् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006366027, "chapter_id": 26366, "verse_number": "२-२२-२८", "content_sanskrit": "नन्दगोपसुतो योगं कृत्वा स पुनरुत्थितः ।\nचेनुकस्तालशिखरात् पातितो जीवितं विना ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006366028, "chapter_id": 26366, "verse_number": "२-२२-२९", "content_sanskrit": "प्रलम्बं यं मृधे देवा न शेकुरतिवर्तितुम् ।\nबालेन मुष्टिनैकेन स हतः प्राकृतो यथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006366029, "chapter_id": 26366, "verse_number": "२-२२-३०", "content_sanskrit": "वासवस्योत्सवं भङक्त्वा वर्षं वासवरोषजम् ।\nनिर्जित्य गोगृहार्थाय धृतो गोवर्धनो गिरिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006366030, "chapter_id": 26366, "verse_number": "२-२२-३१", "content_sanskrit": "हतस्त्वरिष्टो बलवान् निःशृङ्गश्च कृतो व्रजे ।\nअबालो बाल्यमास्थाय रमते शिशुलीलया ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006366031, "chapter_id": 26366, "verse_number": "२-२२-३२", "content_sanskrit": "प्रबन्धः कर्मणामेव तस्य गोव्रजवासिनः ।\nसंनिकृष्टं भयं चैव केशिनो मम च धुवम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006366032, "chapter_id": 26366, "verse_number": "२-२२-३३", "content_sanskrit": "भूतपूर्वश्च मे मृत्युः सततं पूर्वदैहिकः ।\nयुद्धाकाङ्क्षी च स यथा तिष्ठतीह ममाग्रतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006366033, "chapter_id": 26366, "verse_number": "२-२२-३४", "content_sanskrit": "क्व च गोपत्वमशुभं मानुष्यं मृत्युदुर्बलम् ।\nक्व च देवप्रभावेण क्रीडितव्यं व्रजे मम ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006366034, "chapter_id": 26366, "verse_number": "२-२२-३५", "content_sanskrit": "अहो नीचेन वपुषाच्छादयित्वाऽऽत्मनो वपुः ।\nकोऽप्येष रमते देवः श्मशानस्य इवानलः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006366035, "chapter_id": 26366, "verse_number": "२-२२-३६", "content_sanskrit": "श्रूयते हि पुरा विष्णुः सुराणां कारणान्तरे ।\nवामनेन तु रूपेण जहार पृथिवीमिमाम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006366036, "chapter_id": 26366, "verse_number": "२-२२-३७", "content_sanskrit": "कृत्वा केसरिणो रूपं विष्णुना प्रभविष्णुना ।\nहतो हिरण्यकशिपुर्दानवानां पितामहः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006366037, "chapter_id": 26366, "verse_number": "२-२२-३८", "content_sanskrit": "अचिन्त्यरूपमास्थाय श्वेतशैलस्य मूर्धनि ।\nभवेन च्याविता दैत्याः पुरा तत्त्रिपुरं घ्नता ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006366038, "chapter_id": 26366, "verse_number": "२-२२-३९", "content_sanskrit": "चालितो गुरुपुत्रेण भार्गवोऽङ्गिरसेन वै ।\nप्रविश्य दार्दुरीं मायामनावृष्टिं चकार ह ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006366039, "chapter_id": 26366, "verse_number": "२-२२-४०", "content_sanskrit": "अनन्तः शाश्वतो देवः सहस्रशिरसोऽव्ययः ।\nवाराहं रूपमास्थाय प्रोज्जहारार्णवान्मही म् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006366040, "chapter_id": 26366, "verse_number": "२-२२-४१", "content_sanskrit": "अमृते निर्मिते पूर्वं विष्णुः स्त्रीरूपमास्थितः ।\nसुराणामसुराणां च युद्धं चक्रे सुदारुणम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006366041, "chapter_id": 26366, "verse_number": "२-२२-४२", "content_sanskrit": "अमृतार्थे पुरा चापि देवदैत्यसमागमे ।\nदधार मन्दरं विष्णुरकूपार इति श्रुतिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006366042, "chapter_id": 26366, "verse_number": "२-२२-४३", "content_sanskrit": "वपुर्वामनमास्थाय नन्दनीयं पुरा बलेः ।\nत्रिभिः क्रमैस्तु त्रींल्लोकाञ्जहार त्रिदिवालयम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006366043, "chapter_id": 26366, "verse_number": "२-२२-४४", "content_sanskrit": "चतुर्धा तेजसो भागं कृत्वा दाशरथे गृहे ।\nस एव रामसंज्ञो वै रावणं व्यनशत् तदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006366044, "chapter_id": 26366, "verse_number": "२-२२-४५", "content_sanskrit": "एवमेव निकृत्या वै तत्तद्रूपमुपागतः ।\nसाधयत्यात्मनः कार्यं सुराणामर्थसिद्धये ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006366045, "chapter_id": 26366, "verse_number": "२-२२-४६", "content_sanskrit": "तदेव नूनं विष्णुर्वा शक्रो वा मरुतां पतिः ।\nमत्साधनेच्छया प्राप्तो नारदो मां यदुक्तवान् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006366046, "chapter_id": 26366, "verse_number": "२-२२-४७", "content_sanskrit": "अत्र मे शङ्कते बुद्धिर्वसुदेवं प्रति ध्रुवा ।\nअस्य बुद्धिविशेषेण वयं कातरतां गताः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006366047, "chapter_id": 26366, "verse_number": "२-२२-४८", "content_sanskrit": "अहं हि खट्वाङ्गवने नारदेन समागतः ।\nद्वितीयं स हि मां विप्रः पुनरेवाब्रवीद् वचः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006366048, "chapter_id": 26366, "verse_number": "२-२२-४९", "content_sanskrit": "यस्त्वया हि कृतो यत्नः कंस गर्भकृते महान् ।\nवसुदेवेन ते रात्रौ तत्कर्म विफलीकृतम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006366049, "chapter_id": 26366, "verse_number": "२-२२-५०", "content_sanskrit": "दारिका या त्वया रात्रौ शिलायां कंस पातिता ।\nतां यशोदासुतां विद्धि कृष्णं च वसुदेवजम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006366050, "chapter_id": 26366, "verse_number": "२-२२-५१", "content_sanskrit": "रात्रौ व्यावर्तितावेतौ गर्भौ तव वधाय वै ।\nवसुदेवेन संधाय मित्ररूपेण शत्रुणा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006366051, "chapter_id": 26366, "verse_number": "२-२२-५२", "content_sanskrit": "सा तु कन्या यशोदाया विन्ध्ये पर्वतसत्तमे ।\nहत्वा शुम्भनिशुम्भौ द्वौ दानवौ नगचारिणौ ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006366052, "chapter_id": 26366, "verse_number": "२-२२-५३", "content_sanskrit": "कृताभिषेका वरदा भूतसंघनिषेविता ।\nअर्च्यते दस्युभिर्घोरैर्महाबलिपशुप्रिया ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006366053, "chapter_id": 26366, "verse_number": "२-२२-५४", "content_sanskrit": "सुरापिशितपूर्णाभ्यां कुम्भाभ्यामुपशोभिता ।\nमयूराङ्गदचित्रैश्च बर्हभारैर्विभूषिता ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006366054, "chapter_id": 26366, "verse_number": "२-२२-५५", "content_sanskrit": "हृष्टकुक्कुटसंनादं वनं वायसनादितम् ।\nमृगसंघैश्च सम्पूर्णमविरुद्धैश्च पक्षिभिः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006366055, "chapter_id": 26366, "verse_number": "२-२२-५६", "content_sanskrit": "सिंहव्याघ्रवराहाणां नादेन प्रतिनादितम् ।\nवृक्षगम्भीरनिबिडं कान्तारैः सर्वतो वृतम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006366056, "chapter_id": 26366, "verse_number": "२-२२-५७", "content_sanskrit": "दिव्यभृङ्गारुचमरैरादर्शैरुपशोभितम् ।\nदेवतूर्यनिनादैश्च शतशः प्रतिनादितम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006366057, "chapter_id": 26366, "verse_number": "२-२२-५८", "content_sanskrit": "स्थानं तस्या नगे विन्ध्ये निर्मितं स्वेन तेजसा ।\nरिपूणां त्रासजननी नित्यं तत्र मनोरमे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006366058, "chapter_id": 26366, "verse_number": "२-२२-५९", "content_sanskrit": "वसते परमप्रीता देवतैरपि पूजिता ।\nयस्त्वयं नन्दगोपस्य कृष्ण इत्युच्यते सुतः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006366059, "chapter_id": 26366, "verse_number": "२-२२-६०", "content_sanskrit": "अत्र मे नारदः प्राह सुमहत्कर्मकारणम् ।\nद्वितीयो वसुदेवाद् वै वासुदेवो भविष्यति ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006366060, "chapter_id": 26366, "verse_number": "२-२२-६१", "content_sanskrit": "स हि ते सहजो मृत्युर्बान्धवश्च भविष्यति ।\nस एव वासुदेवो वै वसुदेवसुतो बली ।\nबान्धवो धर्मतो मह्यं हृदयेनान्तको रिपुः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006366061, "chapter_id": 26366, "verse_number": "२-२२-६२", "content_sanskrit": "नेत्रे तुदति तस्यैव वक्त्रेणामिषगृद्धिना ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006366062, "chapter_id": 26366, "verse_number": "२-२२-६३", "content_sanskrit": "वसुदेवस्तथैवायं सपुत्रज्ञातिबान्धवः ।\nछिनत्ति मम मूलानि भुङ्क्ते च मम पार्श्वतः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006366063, "chapter_id": 26366, "verse_number": "२-२२-६४", "content_sanskrit": "भ्रूणहत्यापि संतार्या गोवधः स्त्रीवधोऽपि वा ।\nन कृतघ्नस्य लोकोऽस्ति बान्धवस्य विशेषतः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006366064, "chapter_id": 26366, "verse_number": "२-२२-६५", "content_sanskrit": "पतितानुगतं मार्गं निषेवत्यचिरेण सः ।\nयः कृतघ्नोऽनुबन्धेन प्रीतिं वहति दारुणाम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006366065, "chapter_id": 26366, "verse_number": "२-२२-६६", "content_sanskrit": "नरकाध्युषितः पन्था गन्तव्यस्तेन दारुणः ।\nअपापे पापहृदयो यः पापमनुतिष्ठति ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006366066, "chapter_id": 26366, "verse_number": "२-२२-६७", "content_sanskrit": "अहं वा स्वजनः श्लाघ्यः स वा श्लाघ्यतरः सुतः ।\nनियमैर्गुणवृत्तेन त्वया बान्धवकाम्यया ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006366067, "chapter_id": 26366, "verse_number": "२-२२-६८", "content_sanskrit": "हस्तिनां कलहे घोरे वधमृच्छन्ति वीरुधः ।\nयुद्धव्युपरमे ते तु सहाश्नन्ति महावने ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006366068, "chapter_id": 26366, "verse_number": "२-२२-६९", "content_sanskrit": "बान्धवानामपि तथा भेदकाले समुत्थिते ।\nवध्यते योऽन्तरप्रेप्सुः स्वजनो यदि वेतरः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006366069, "chapter_id": 26366, "verse_number": "२-२२-७०", "content_sanskrit": "कालस्त्वं हि विनाशाय मया पुष्टो विजानता ।\nवसुदेव कुलस्यास्य यद् विरोधयसे भृशम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006366070, "chapter_id": 26366, "verse_number": "२-२२-७१", "content_sanskrit": "अमर्षी वैरशीलश्च सदा पापमतिः शठः ।\nस्थाने यदुकुलं मूढ शोचनीयं त्वया कृतम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006366071, "chapter_id": 26366, "verse_number": "२-२२-७२", "content_sanskrit": "वसुदेव वृथा वृद्ध यन्मया त्वं पुरस्कृतः ।\nश्वेतेन शिरसा वृद्धो नैव वर्षशतैर्भवेत् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006366072, "chapter_id": 26366, "verse_number": "२-२२-७३", "content_sanskrit": "यस्य बुद्धिः परिणता स वै वृद्धतरो नृणाम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006366073, "chapter_id": 26366, "verse_number": "२-२२-७४", "content_sanskrit": "त्वं च कर्कशशीलश्च बुद्ध्या च न बहुश्रुतः ।\nकेवलं वयसा वृद्धो यथा शरदि तोयदः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006366074, "chapter_id": 26366, "verse_number": "२-२२-७५", "content_sanskrit": "किं च त्वं साधु जानीषे वसुदेव वृथामते ।\nमृते कंसे मम सुतो मथुरां पालयिष्यति ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006366075, "chapter_id": 26366, "verse_number": "२-२२-७६", "content_sanskrit": "छिन्नाशस्त्वं वृथावृद्धो मिथ्यात्वेवं विचारितम् ।\nजिजीविषुर्न सोऽप्यस्ति योऽवतिष्ठेन्ममाग्रतः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006366076, "chapter_id": 26366, "verse_number": "२-२२-७७", "content_sanskrit": "प्रहर्तुकामो विश्वस्ते यस्त्वं दुष्टेन चेतसा ।\nतत् ते प्रतिकरिष्येऽहं पुत्रयोस्तव पश्यतः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006366077, "chapter_id": 26366, "verse_number": "२-२२-७८", "content_sanskrit": "न मे वृद्धवधः कश्चिद् द्विजस्त्रीवध एव च ।\nकृतपूर्वः करिष्ये वा विशेषेण तु बान्धवे ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006366078, "chapter_id": 26366, "verse_number": "२-२२-७९", "content_sanskrit": "इह त्वं जातसंवृद्धो मम पित्रा विवर्धितः ।\nपितृष्वसुश्च मे भर्ता यदूनां प्रथमो गुरुः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006366079, "chapter_id": 26366, "verse_number": "२-२२-८०", "content_sanskrit": "कुले महति विख्यातः प्रथिते चक्रवर्तिनाम् ।\nगुर्वर्थं पूजितः सद्भिर्महद्भिर्धर्मबुद्धिभिः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006366080, "chapter_id": 26366, "verse_number": "२-२२-८१", "content_sanskrit": "किं करिष्यामहे सर्वे सत्सु वक्तव्यतां गताः ।\nयदूनां यूथमुख्यस्य यस्य ते वृत्तमीदृशम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006366081, "chapter_id": 26366, "verse_number": "२-२२-८२", "content_sanskrit": "मद्वधो वा जयो वाथ वसुदेवस्य दुर्नयैः ।\nसत्सु यास्यन्ति पुरुषा यदूनामवगुण्ठिताः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006366082, "chapter_id": 26366, "verse_number": "२-२२-८३", "content_sanskrit": "त्वया हि मद्वधोपायं तर्कमाणेन वै मृधे ।\nअविश्वास्यं कृतं कर्म वाच्याश्च यदवः कृताः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006366083, "chapter_id": 26366, "verse_number": "२-२२-८४", "content_sanskrit": "अशाम्यं वैरमुत्पन्नं मम कृष्णस्य चोभयोः ।\nशान्तिमेकतरे शान्तिं गते यास्यन्ति यादवाः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006366084, "chapter_id": 26366, "verse_number": "२-२२-८५", "content_sanskrit": "गच्छ दानपते क्षिप्रं ताविहानयितुं व्रजात् ।\nनन्दगोपं च गोपांश्च करदान् मम शासनात् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006366085, "chapter_id": 26366, "verse_number": "२-२२-८६", "content_sanskrit": "वाच्यश्च नन्दगोपो वै करमादाय वार्षिकम् ।\nशीघ्रमागच्छ नगरं गोपैः सह समन्वितः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006366086, "chapter_id": 26366, "verse_number": "२-२२-८७", "content_sanskrit": "कृष्णसंकर्षणौ चैव वसुदेवसुतावुभौ ।\nद्रष्टुमिच्छति वै कंसः सभृत्यः सपुरोहितः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006366087, "chapter_id": 26366, "verse_number": "२-२२-८८", "content_sanskrit": "एतौ युद्धविदौ रङ्गे कालनिर्माणयोधिनौ ।\nदृढौ च कृतिनौ चैव शृणोमि व्यायतोद्यमौ ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006366088, "chapter_id": 26366, "verse_number": "२-२२-८९", "content_sanskrit": "अस्माकमपि मल्लौ द्वौ सज्जौ युद्धकृतोत्सवौ ।\nताभ्यां सह नियोत्स्येते तौ युद्धकुशलावुभौ ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006366089, "chapter_id": 26366, "verse_number": "२-२२-९०", "content_sanskrit": "द्रष्टव्यौ च मयावश्यं बालौ तावमरोपमौ ।\nपितृष्वसुः सुतौ मुख्यौ व्रजवासौ वनेचरौ ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006366090, "chapter_id": 26366, "verse_number": "२-२२-९१", "content_sanskrit": "वक्तव्यं च व्रजे तस्मिन् समीपे व्रजवासिनाम् ।\nराजा धनुर्मखं नाम कारयिष्यति वै सुखी ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006366091, "chapter_id": 26366, "verse_number": "२-२२-९२", "content_sanskrit": "संनिकृष्टे वने ते तु निवसन्तु यथासुखम् ।\nजनस्यामन्त्रितस्यार्थे यथा स्यात् सर्वमव्ययम् ॥९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006366092, "chapter_id": 26366, "verse_number": "२-२२-९३", "content_sanskrit": "पयसः सर्पिषश्चैव दध्नो दध्युत्तरस्य च ।\nयथाकामप्रदानाय भोज्याधिश्रयणाय च ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006366093, "chapter_id": 26366, "verse_number": "२-२२-९४", "content_sanskrit": "अक्रूर गच्छ शीघ्रं त्वं तावानय ममाज्ञया ।\nसंकर्षणं च कृष्णं च द्रष्टुं कौतूहलं हि मे ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006366094, "chapter_id": 26366, "verse_number": "२-२२-९५", "content_sanskrit": "तयोरागमने प्रीतिः परमा मत्कृता भवेत्।\nदृष्ट्वा तु तौ महावीर्यौ तद्विधास्यामि यद्धितम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006366095, "chapter_id": 26366, "verse_number": "२-२२-९६", "content_sanskrit": "शासनं यदि वा श्रुत्वा मम तौ परिभाषितम् ।\nनागच्छेतां यथाकालं निग्राह्यावपि तौ मम ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006366096, "chapter_id": 26366, "verse_number": "२-२२-९७", "content_sanskrit": "सान्त्वमेव तु बालेषु प्रधानं प्रथमो नयः ।\nमधुरेणैव तौ मन्दौ स्वयमेवानयाशु वै ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006366097, "chapter_id": 26366, "verse_number": "२-२२-९८", "content_sanskrit": "अक्रूर कुरु मे प्रीतिमेतां परमदुर्लभाम् ।\nयदि वा नोपजप्तोऽसि वसुदेवेन सुव्रत ।\nतथा कर्तव्यमेतद्धि यथा तावागमिष्यतः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006366098, "chapter_id": 26366, "verse_number": "२-२२-९९", "content_sanskrit": "एवमाक्षिप्यमाणोऽपि वसुदेवो वसूपमः ।\nसागराकारमात्मानं निष्प्रकम्पमधारयत् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006366099, "chapter_id": 26366, "verse_number": "२-२२-१००", "content_sanskrit": "वाक्छल्यैस्ताड्यमानस्तु कंसेनादीर्घदर्शिना ।\nक्षमां मनसि संधाय नोत्तरं प्रत्यभाषत ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006366100, "chapter_id": 26366, "verse_number": "२-२२-१०१", "content_sanskrit": "ये तु तं ददृशुस्तत्र क्षिप्यमाणमनेकधा ।\nधिग्धिगित्यसकृत्ते वै शनैरूचुरवाङ्मुखाः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006366101, "chapter_id": 26366, "verse_number": "२-२२-१०२", "content_sanskrit": "अक्रूरस्तु महातेजा जानन् दिव्येन चक्षुषा ।\nजलं दृष्ट्वेव तृषितः प्रेषितः प्रीतिमानभूत् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006366102, "chapter_id": 26366, "verse_number": "२-२२-१०३", "content_sanskrit": "तस्मिन्नेव मुहूर्ते तु मथुरायाः स निर्ययौ ।\nप्रीतिमान्पुण्डरीकाक्षं द्रष्टुं दानपतिः स्वयम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}]