[{"id": 2190744, "chapter_id": 5059, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2190745, "chapter_id": 5059, "verse_number": "१", "content_sanskrit": "कथं भवति पापात्मा कथं धर्मं करोति वा ।\nकेन निर्वेदमादत्ते मोक्षं वा केन गच्छति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2190746, "chapter_id": 5059, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2190747, "chapter_id": 5059, "verse_number": "२", "content_sanskrit": "विदिताः सर्वधर्मास्ते स्थित्यर्थमनुपृच्छसि ।\nशृणु मोक्षं सनिर्वेदं पापं धर्मं च मूलतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2190748, "chapter_id": 5059, "verse_number": "३", "content_sanskrit": "विज्ञानार्थं हि पञ्चानामिच्छा पूर्वं प्रवर्तते ।\nप्राप्य तान् जायते कामो द्वेषो वा भरतर्षभ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2190749, "chapter_id": 5059, "verse_number": "४", "content_sanskrit": "ततस्तदर्थं यतते कर्म चारभते पुनः ।\nइष्टानां रूपगन्धानामभ्यासं च चिकीर्षति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2190750, "chapter_id": 5059, "verse_number": "५", "content_sanskrit": "ततो रागः प्रभवति द्वेषश्च तदनन्तरम् ।\nततो लोभः प्रभवति मोहश्च तदनन्तरम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2190751, "chapter_id": 5059, "verse_number": "६", "content_sanskrit": "लोभमोहाभिभूतस्य रागद्वेषान्वितस्य च ।\nन धर्मे जायते बुद्धिर्व्याजाद् धर्मं करोति च\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2190752, "chapter_id": 5059, "verse_number": "७", "content_sanskrit": "व्याजेन चरतो धर्ममर्थव्याजोऽपि रोचते ।\nव्याजेन सिद्ध्यमानेषु धनेषु कुरुनन्दन\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2190753, "chapter_id": 5059, "verse_number": "८", "content_sanskrit": "तत्रैव कुरुते बुद्धिं ततः पापं चिकीर्षति ।\nसुहृद्भिर्वार्यमाणोऽपि पण्डितैश्चापि भारत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2190754, "chapter_id": 5059, "verse_number": "९", "content_sanskrit": "उत्तरं न्यायसम्बद्धं ब्रवीतिति विचोदितः ।\nअधर्मस्त्रिविधस्तस्य वर्धते रागमोहजः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2190755, "chapter_id": 5059, "verse_number": "१०", "content_sanskrit": "पापं चिन्तयते चैव प्रब्रवीति करोति च ।\nतस्याधर्मप्रवृत्तस्य दोषान् पश्यन्ति साधवः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2190756, "chapter_id": 5059, "verse_number": "११", "content_sanskrit": "एकशीलाश्च मित्रत्वं भजन्ते पापकर्मिणः ।\nस नेह सुखमाप्नोति कुत एव परत्र वै\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2190757, "chapter_id": 5059, "verse_number": "१२", "content_sanskrit": "एवं भवति पापात्मा धर्मात्मानं तु मे शृणु ।\nयथा कुशलधर्मा स कुशलं प्रतिपद्यते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2190758, "chapter_id": 5059, "verse_number": "१३", "content_sanskrit": "य एतान् प्रज्ञया दोषान् पूर्वमेवानुपश्यति ।\nकुशलः सुखदुःखानां साधूंश्चाप्युपसेवते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2190759, "chapter_id": 5059, "verse_number": "१४", "content_sanskrit": "तस्य साधुसमाचारादभ्यासाच्चैव वर्धते ।\nप्रज्ञा धर्मे च रमते धर्मं चैवोपजीवति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2190760, "chapter_id": 5059, "verse_number": "१५", "content_sanskrit": "सोऽथ धर्मादवाप्तेषु धनेषु कुरुते मनः ।\nतस्यैव सिञ्चते मूलं गुणान् पश्यति यत्र वै\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2190761, "chapter_id": 5059, "verse_number": "१६", "content_sanskrit": "धर्मात्मा भवति ह्येवं मित्रं च लभते शुभम् ।\nस मित्रधनलाभात्तु प्रेत्य चेह च नन्दति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2190762, "chapter_id": 5059, "verse_number": "१७", "content_sanskrit": "शब्दे स्पर्शे तथा रूपे रसे गन्धे च भारत ।\nप्रभुत्वं लभते जन्तुर्धर्मस्यैतत्फलं विदुः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2190763, "chapter_id": 5059, "verse_number": "१८", "content_sanskrit": "स धर्मस्य फलं लब्ध्वा न तृप्यति युधिष्ठिर ।\nअतृप्यमाणो निर्वेदमादत्ते ज्ञानचक्षुषा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2190764, "chapter_id": 5059, "verse_number": "१९", "content_sanskrit": "प्रज्ञाचक्षुर्यदा कामे दोषमेवानुपश्यति ।\nविरज्यते तदा कामान्न च धर्मं विमुञ्चति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2190765, "chapter_id": 5059, "verse_number": "२०", "content_sanskrit": "सर्वत्यागे च यतते दृष्ट्वा लोकं क्षयात्मकम् ।\nततो मोक्षाय यतते नानुपायादुपायतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2190766, "chapter_id": 5059, "verse_number": "२१", "content_sanskrit": "शनैर्निर्वेदमादत्ते पापं कर्म जहाति च ।\nधर्मात्मा चैव भवति मोक्षं च लभते परम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2190767, "chapter_id": 5059, "verse_number": "२२", "content_sanskrit": "एतत्ते कथितं तात यन्मां त्वं परिपृच्छसि ।\nपापं धर्मं तथा मोक्षं निर्वेदं चैव भारत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2190768, "chapter_id": 5059, "verse_number": "२३", "content_sanskrit": "तस्माद्धर्मे प्रवर्तेथाः सर्वावस्थं युधिष्ठिर ।\nधर्मे स्थितानां कौन्तेय सिद्धिर्भवति शाश्वती\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2190769, "chapter_id": 5059, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे अष्टाधिकशततमोऽध्यायः ॥१०८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]