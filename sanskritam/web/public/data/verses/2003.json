[{"id": 2044940, "chapter_id": 2003, "verse_number": "६-५२-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2044941, "chapter_id": 2003, "verse_number": "६-५२-१", "content_sanskrit": "एवं व्यूढेष्वनीकेषु मामकेष्वितरेषु च ।\nकथं प्रहरतां श्रेष्ठाः संप्रहारं प्रचक्रिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2044942, "chapter_id": 2003, "verse_number": "६-५२-२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2044943, "chapter_id": 2003, "verse_number": "६-५२-२", "content_sanskrit": "तथा व्यूढेष्वनीकेषु सन्नद्धरुचिरध्वजाः।\n`तावकाः पाण्डवैः सार्धं यथाऽयुध्यन्त तच्छृणु।\nअपारमिव संदृश्य सागरप्रतिमं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2044944, "chapter_id": 2003, "verse_number": "६-५२-३", "content_sanskrit": "तेषां मध्ये स्थितो राजन्पुत्रो दुर्योधनस्तव ।\nअब्रवीत्तावकान्सर्वान्युद्ध्यध्वमिति दंशिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2044945, "chapter_id": 2003, "verse_number": "६-५२-४", "content_sanskrit": "ते मनः क्रूरमाधाय समभित्यक्तजीविताः ।\nपाण्डवानभ्यवर्तन्त सर्व एवोच्छ्रितध्वजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2044946, "chapter_id": 2003, "verse_number": "६-५२-५", "content_sanskrit": "ततो युद्धं समभवत्तुमुलं रोमहर्षणम्।\nतावकानां परेषां च व्यतिषक्तरथद्विपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2044947, "chapter_id": 2003, "verse_number": "६-५२-६", "content_sanskrit": "मुक्तास्तु रथिभिर्बाणा रुक्मपुङ्खाः सुतेजिताःक ।\nसन्निपेतुरकुण्ठाग्रा नागेषु च हयेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2044948, "chapter_id": 2003, "verse_number": "६-५२-७", "content_sanskrit": "तथा प्रवृत्ते संग्रामे धनुरुद्यम्य दंशितः ।\nअभिपत्य महाबाहुर्भीष्मो भीमपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2044949, "chapter_id": 2003, "verse_number": "६-५२-८", "content_sanskrit": "सौभद्रे भीमसेने च सात्यकौ च महारथे ।\nकैकेये च विराटे च धृष्टद्युम्ने च पार्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2044950, "chapter_id": 2003, "verse_number": "६-५२-९", "content_sanskrit": "एतेषु नरवीरेषु चेदिमत्स्येषु चाभिभूः ।\nववर्ष शरवर्षाणि वृद्धः कुरुपितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2044951, "chapter_id": 2003, "verse_number": "६-५२-१०", "content_sanskrit": "अभिद्यत ततो व्यूहस्तस्मिन्वीरसमागमे।\nसर्वेषामेव सैन्यानामासीद्व्यतिकरो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2044952, "chapter_id": 2003, "verse_number": "६-५२-११", "content_sanskrit": "सादिनो ध्वजिनश्चैव हतप्रवरवाजिनः ।\nविप्रद्रुतरथानीकाः समपद्यन्त पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2044953, "chapter_id": 2003, "verse_number": "६-५२-१२", "content_sanskrit": "अर्जुनस्तु नरव्याघ्रो दृष्ट्वा भीष्मं महारथम् ।\nवार्ष्णेयमब्रवीत्क्रुद्धो याहि यत्र पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2044954, "chapter_id": 2003, "verse_number": "६-५२-१३", "content_sanskrit": "एष भीष्मः सुसंक्रुद्धो वार्ष्णेय मम वाहिनीम् ।\nनाशयिष्यति सुव्यक्तं दुर्योधनहिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2044955, "chapter_id": 2003, "verse_number": "६-५२-१४", "content_sanskrit": "एष द्रोणः कृपः शल्यो विकर्णश्च जनार्दन ।\nधार्तराष्ट्राश्च सहिता दुर्योधनपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2044956, "chapter_id": 2003, "verse_number": "६-५२-१५", "content_sanskrit": "पाञ्चालान्निहनिष्यन्ति रक्षिता दृढधन्वना ।\nसोऽहं भीष्मं वधिष्यामि सैन्यहेतोर्जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2044957, "chapter_id": 2003, "verse_number": "६-५२-१६", "content_sanskrit": "तमब्रवीद्वासुदेवो यत्तो भव धनंजय।\nएष त्वां प्रापयिष्यामि पितामहरथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2044958, "chapter_id": 2003, "verse_number": "६-५२-१७", "content_sanskrit": "एवमुक्त्वा ततः शौरी रथं तं लोकविश्रुतम् ।\nप्रापयामास भीष्मस्य रथं प्रति जनेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2044959, "chapter_id": 2003, "verse_number": "६-५२-१८", "content_sanskrit": "चलद्बहुपातकेन बलाकावर्णवाजिना ।\nसमुच्छ्रितमहाभीमनदद्वानरकेतुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2044960, "chapter_id": 2003, "verse_number": "६-५२-१९", "content_sanskrit": "महता मेघनादेन रथेनामिततेजसा ।\nविनिघ्नन्कौरवानीकं शूरसेनांश्च पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2044961, "chapter_id": 2003, "verse_number": "६-५२-२०", "content_sanskrit": "प्रायाच्छरणदः शीघ्रं सुहृदां हर्षवर्धनः ।\nतमापतन्तं वेगेन प्रभिन्नमिव वारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2044962, "chapter_id": 2003, "verse_number": "६-५२-२१", "content_sanskrit": "त्रसयनतं रणे शूरान्मर्दयन्तं च सायकैः ।\nसैन्धवप्रमुखैर्गुप्तः प्राच्यसौवीरकेकयैः ।\nसहसा प्रत्युदीयाय भीष्मः शान्तनवोऽर्जुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2044963, "chapter_id": 2003, "verse_number": "६-५२-२२", "content_sanskrit": "को हि गाण्डीवधन्वानमन्यः कुरुपितामहात्।\nद्रोणवैकर्तनाभ्यां वा रथी संयातुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2044964, "chapter_id": 2003, "verse_number": "६-५२-२३", "content_sanskrit": "ततो भीष्मो महाराज सर्वलोकमहारथः ।\nअर्जुनं सप्ततसप्तत्या नाराचानां समाचिनोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2044965, "chapter_id": 2003, "verse_number": "६-५२-२४", "content_sanskrit": "द्रोणश्च पञ्चविंशत्या कृपः पञ्चाशता शरैः।\nदुर्योधनश्रतुःषष्ट्या शल्यश्च नवभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2044966, "chapter_id": 2003, "verse_number": "६-५२-२५", "content_sanskrit": "सैन्धवो नवभिश्चैव शकुनिश्चापि पञ्चभिः ।\nविकर्णो दशभिर्भल्लै राजन्विव्याध पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2044967, "chapter_id": 2003, "verse_number": "६-५२-२६", "content_sanskrit": "स तैर्विद्धो महेष्वासः समन्तान्निशितैः शरैः।\nन विव्यथे महाबाहुर्भिद्यमान इवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2044968, "chapter_id": 2003, "verse_number": "६-५२-२७", "content_sanskrit": "स भीष्मं पञ्चविंशत्या कृपं च नवभिः शरैः ।\nद्रोणं षष्ट्या नरव्याघ्रो विकर्णं च त्रिभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2044969, "chapter_id": 2003, "verse_number": "६-५२-२८", "content_sanskrit": "शल्यं चैव त्रिभिर्बाणै राजानं चैव पञ्चभिः ।\nप्रत्यविध्यदमेयात्मा किरीटी भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2044970, "chapter_id": 2003, "verse_number": "६-५२-२९", "content_sanskrit": "तं सात्यकिर्विराटश्च धृष्टद्युम्नश्च पार्षतः।\nसौभद्रो द्रौपदेयाश्च परिवव्रुर्धनंजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2044971, "chapter_id": 2003, "verse_number": "६-५२-३०", "content_sanskrit": "ततो द्रोणं महेष्वासं गाङ्गेयस्य प्रिये रतम्।\nअभ्यवर्तत पाञ्चाल्यः संयुक्तः सह सोमकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2044972, "chapter_id": 2003, "verse_number": "६-५२-३१", "content_sanskrit": "भीष्मस्तु रथिनां श्रेष्ठो राजन्विव्याध पाण्डवम्।\nअशीत्या निशितैर्बाणैस्ततोऽक्रोशन्त पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2044973, "chapter_id": 2003, "verse_number": "६-५२-३२", "content_sanskrit": "तेषां तु निनदं श्रुत्वा सहितानां प्रहृष्टवत्।\nप्रविवेश ततो मध्यं नरसिंहः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2044974, "chapter_id": 2003, "verse_number": "६-५२-३३", "content_sanskrit": "तेषां महारथानां स मध्यं प्राप्य धनंजयः।\nचिक्रीड धनुषा राजँल्लक्षं कृत्वा महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2044975, "chapter_id": 2003, "verse_number": "६-५२-३४", "content_sanskrit": "`क्षत्रियाणां शिरांस्युग्रैः कृन्तञ्शस्त्रैर्महारथः ।\nशून्यान्कृत्वा रथोपस्थान्व्यचरत्फल्गुनस्तदा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2044976, "chapter_id": 2003, "verse_number": "६-५२-३५", "content_sanskrit": "ततो दुर्योधनो राजा भीष्ममाह जनेश्वरः ।\nपीड्यमानं स्वकं सैन्यं दृष्ट्वा पार्थेन संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2044977, "chapter_id": 2003, "verse_number": "६-५२-३६", "content_sanskrit": "एष पाण्डुसुतस्तात कृष्णेन सहितो बली।\nयततां सर्वसैन्यानां मूलं नः परिकृन्तति।\nत्वयि जीवति गाङ्गेय द्रोणे च रथिनां वरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2044978, "chapter_id": 2003, "verse_number": "६-५२-३७", "content_sanskrit": "त्वत्कृते चैव कर्णोऽपि न्यस्तशस्त्रो विशांपते।\nन युध्यति रणे पार्थान्हितकामः सदा मम।\nस तथा कुरु गाङ्गेय यथा हन्येत फल्गुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2044979, "chapter_id": 2003, "verse_number": "६-५२-३८", "content_sanskrit": "एवमुक्तस्ततो राजन्पिता देवव्रतस्तव।\nधिक् क्षात्रं धर्ममित्युक्त्वा प्रायात्पार्थं रथं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2044980, "chapter_id": 2003, "verse_number": "६-५२-३९", "content_sanskrit": "उभौ श्वेतहयौ राजन्संसक्तौ प्रेक्ष्य पार्थिवाः ।\nसिंहनादान्भृशं चक्रुः शङ्खान्दध्मुश्च मारिषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2044981, "chapter_id": 2003, "verse_number": "६-५२-४०", "content_sanskrit": "द्रौणिर्दुर्योधनश्चैव विकर्णश्च तवात्मजः ।\nपरिवार्य रणे भीष्मं स्थिता युद्धाय मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2044982, "chapter_id": 2003, "verse_number": "६-५२-४१", "content_sanskrit": "तथैव पाण्डवाः सर्वे परिवार्य धनञ्जयम् ।\nस्थिता युद्धाय महते ततो युद्धमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2044983, "chapter_id": 2003, "verse_number": "६-५२-४२", "content_sanskrit": "गाङ्गेयस्तु रणे पार्थमानर्च्छन्नवभिः शरैः ।\nतमर्जुनः प्रत्यविध्यद्दशभिर्मर्मभेदिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2044984, "chapter_id": 2003, "verse_number": "६-५२-४३", "content_sanskrit": "ततः शरसहस्रेण सुप्रयुक्तेन पाण्डवः ।\nअर्जुनः समरश्लाघी भीष्मस्यावारयद्दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2044985, "chapter_id": 2003, "verse_number": "६-५२-४४", "content_sanskrit": "शरजालं ततस्तत्तु शरजालेन मारिष।\nवारयामास पार्थस्य भीष्मः शान्तनवस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2044986, "chapter_id": 2003, "verse_number": "६-५२-४५", "content_sanskrit": "उभौ परमसंहृष्टावुभौ युद्धाभिनन्दिनौ ।\nनिर्विशेषमयुध्येतां कृतप्रतिकृतैषिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2044987, "chapter_id": 2003, "verse_number": "६-५२-४६", "content_sanskrit": "भीष्मचापविमुक्तानि शरजालानि शङ्घशः।\nशीर्यमाणान्यदृश्यन्त भिन्नान्यर्जुनसायकैःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2044988, "chapter_id": 2003, "verse_number": "६-५२-४७", "content_sanskrit": "तथैवार्जुनमुक्तानि शरजालानि सर्वशः ।\nगाङ्गेयशरनुन्नानि प्रापतन्त महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2044989, "chapter_id": 2003, "verse_number": "६-५२-४८", "content_sanskrit": "अर्जुनः पञ्चविंशत्या भीष्ममार्च्छच्छितैः शरैः ।\nभीष्मोपि समरे पार्थं विव्याध निशितैः शरैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2044990, "chapter_id": 2003, "verse_number": "६-५२-४९", "content_sanskrit": "अन्योन्यस्य हयान्विद्ध्वा ध्वजौ च सुमहाबलौ ।\nरथेषां रथचक्रे च चिक्रीडतुररिन्दमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2044991, "chapter_id": 2003, "verse_number": "६-५२-५०", "content_sanskrit": "ततः क्रुद्धो महाराज भीष्मः प्रहरतां वरः।\nवासुदेवं त्रिभिर्बाणैराजघान स्तनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2044992, "chapter_id": 2003, "verse_number": "६-५२-५१", "content_sanskrit": "भीष्मचापच्युतैस्तैस्तु निर्विद्धो मधुसूदनः ।\nविरराज रणे राजन्सपुष्प इव किंशुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2044993, "chapter_id": 2003, "verse_number": "६-५२-५२", "content_sanskrit": "ततोऽर्जुनो भृशं क्रुद्धो निर्विद्धं प्रेक्ष्य माधवम् ।\nसारथिं कुरुवृद्धस्य निर्बिभेद शितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2044994, "chapter_id": 2003, "verse_number": "६-५२-५३", "content_sanskrit": "यतमानौ तु तौ वीरावन्योन्यस्य वधं प्रति।\nन शक्नुतां तदाऽन्योन्यमभिसन्धातुमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2044995, "chapter_id": 2003, "verse_number": "६-५२-५४", "content_sanskrit": "तौ मण्डलानि चित्राणि गतत्प्रत्यागतानि च।\nअदर्शयेतां बहुधा सूतसामर्थ्यलाघवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2044996, "chapter_id": 2003, "verse_number": "६-५२-५५", "content_sanskrit": "अन्तरं च प्रहारेषु तर्कयन्तौ परस्परम् ।\nराजन्नन्तरमार्गस्थौ स्थितावास्तां मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2044997, "chapter_id": 2003, "verse_number": "६-५२-५६", "content_sanskrit": "उभौ सिंहरवोन्मिश्रं शङ्खशब्दं च चक्रतुः ।\nतथैव चापनिर्घोषं चक्रतुस्तौ महारथौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2044998, "chapter_id": 2003, "verse_number": "६-५२-५७", "content_sanskrit": "तयोः शङ्खनिनादेन रथनेमिस्वनेन च।\nदारिता सहसा भूमिश्चकम्पे च ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2044999, "chapter_id": 2003, "verse_number": "६-५२-५८", "content_sanskrit": "नोभयोरन्तरं कश्चिद्ददृशे भरतर्षभ ।\nबलिनौ युद्धदुर्धर्षावन्योन्यसदृशावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2045000, "chapter_id": 2003, "verse_number": "६-५२-५९", "content_sanskrit": "चिह्नमात्रेण भीष्मं तु प्रजज्ञुस्तत्र कौरवाः ।\nतथा पाण्डुसुताः पार्थं चिह्नमात्रेण जज्ञिरेक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2045001, "chapter_id": 2003, "verse_number": "६-५२-६०", "content_sanskrit": "तयोर्नृवरयोर्दृष्ट्वा तादृशं तं पराक्रमम्।\nविस्कमयं सर्वभूतानि जग्मुर्भारतसंयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2045002, "chapter_id": 2003, "verse_number": "६-५२-६१", "content_sanskrit": "न तयोर्विवरं कश्चिद्रणे पश्यति भारत।\nधर्मे स्थितस्य हि यथा न कश्चिद्वृजिनं क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2045003, "chapter_id": 2003, "verse_number": "६-५२-६२", "content_sanskrit": "उभौ च शरजालेन तावदृश्यो बभूवतुः।\nप्रकाशौ च पुनस्तूर्णं बभूवतुरुभौ रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2045004, "chapter_id": 2003, "verse_number": "६-५२-६३", "content_sanskrit": "तत्र देवाः सगन्धर्वाश्चारणाश्चर्षिभिः सह।\nअन्योन्यं प्रत्यभाषन्त तयोर्दृष्ट्वा पराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2045005, "chapter_id": 2003, "verse_number": "६-५२-६४", "content_sanskrit": "न शक्यौ युधि संरब्धौ जेतुमेतौ कथंचन।\nसदेवासुरगन्धर्वैर्लोकैरपि महारथौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2045006, "chapter_id": 2003, "verse_number": "६-५२-६५", "content_sanskrit": "आश्चर्यभूतं लोकेषु युद्धमेतन्महाद्भुतम् ।\nनैतादृशानि युद्धानि भविष्यन्ति कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2045007, "chapter_id": 2003, "verse_number": "६-५२-६६", "content_sanskrit": "न हि शक्यो रणे जेतुं भीष्मः पार्थेन धीमता।\nसधनुः सरथः साश्वः प्रवपन्सायकान्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2045008, "chapter_id": 2003, "verse_number": "६-५२-६७", "content_sanskrit": "तथैव पाण्डवं युद्धे देवैरपि दुरासदम् ।\nन विजेतुं रणे भीष्म उत्सहेत धनुर्धरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2045009, "chapter_id": 2003, "verse_number": "६-५२-६८", "content_sanskrit": "आलोकादपि युद्धं हि सममेतद्भविष्यति।\nइति स्म वाचोऽश्रूयन्त प्रोच्चरन्त्यकस्ततस्ततः।\nगाङ्गेयार्जुनयोः सङ्ख्ये स्तवयुक्ता विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2045010, "chapter_id": 2003, "verse_number": "६-५२-६९", "content_sanskrit": "त्वदीयास्तु तदा योधाः पाण्डवेयाश्च भारत।\nअन्योन्यं समरे जघ्नुस्तयोस्तत्र समागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2045011, "chapter_id": 2003, "verse_number": "६-५२-७०", "content_sanskrit": "शितधारैस्तथा स्वङ्गैर्विमलैश्च परश्वधैः ।\nशरैरन्यैश्च बहुभिः सस्त्रैर्नानाविधैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2045012, "chapter_id": 2003, "verse_number": "६-५२-७१", "content_sanskrit": "उभयोः सेनयोः शूरा न्यकृन्तन्त परस्परम् ।\nवर्तमाने तथा घोरे तस्मिन्युद्धे सुदारुणे।\nद्रोणपाञ्चाल्ययो राजन्महानासीत्समागमः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2045013, "chapter_id": 2003, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि द्वितीयदिवसयुद्धे द्विपञ्चशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]