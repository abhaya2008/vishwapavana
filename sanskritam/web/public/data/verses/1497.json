[{"id": 2023228, "chapter_id": 1497, "verse_number": "३-१३५-०x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023229, "chapter_id": 1497, "verse_number": "३-१३५-१", "content_sanskrit": "अन्धस्य पन्था बधिरस्य पन्थाः\nस्त्रियः पन्था भारवाहस्य पन्थाः।\nराज्ञः पन्था ब्राह्मणेनासमेत्य\nसमेत्य तु ब्राह्मणस्यैव पन्थाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023230, "chapter_id": 1497, "verse_number": "३-१३५-२x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023231, "chapter_id": 1497, "verse_number": "३-१३५-२", "content_sanskrit": "पन्था अयं तेऽद्य मया निसृष्टो\nयेनेच्छसे तेन कामं व्रजस्व।\nन पावको विद्यते वै लघीया-\nनिन्द्रोपि नित्यं नमते ब्राह्मणानाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023232, "chapter_id": 1497, "verse_number": "३-१३५-३x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023233, "chapter_id": 1497, "verse_number": "३-१३५-३", "content_sanskrit": "`स एवमुक्तो मातुलेनैव सार्धं\nयथेष्टमार्गो यज्ञनिवेशनं तत्।\nसंप्राप्य धर्मेण निवारितः सन्\nद्वारि द्वाःस्थं वाक्यमिदं बभाषे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023234, "chapter_id": 1497, "verse_number": "३-१३५-४", "content_sanskrit": "यज्ञं द्रष्टुं प्राप्तवन्तौ स्म तात\nकौतूहलं बलवद्वै विवृद्धम्।\nआवां प्राप्तावतिथी संप्रवेशं\nकाङ्क्षावहे द्वारपते तवाज्ञाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023235, "chapter_id": 1497, "verse_number": "३-१३५-५", "content_sanskrit": "ऐन्द्रद्युम्नेर्यज्ञदृशाविहावां\nविवक्षू वै जनकेन्द्रं दिदृक्षू।\nन वै क्रुध्यो वन्दिना चोत्तमेन\nसंयोजय द्वारपाल क्षणेन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023236, "chapter_id": 1497, "verse_number": "३-१३५-५x", "content_sanskrit": "द्वारपाल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023237, "chapter_id": 1497, "verse_number": "३-१३५-६", "content_sanskrit": "वन्देः समादेशकरा वयं स्म\nनिबोध वाक्यं च मयेर्यमाणम्।\nन वै बालाः प्रविशन्त्यत्र विप्रा\nवृद्धा विदग्धाः प्रविशन्ति द्विजाग्र्याः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023238, "chapter_id": 1497, "verse_number": "३-१३५-७x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023239, "chapter_id": 1497, "verse_number": "३-१३५-७", "content_sanskrit": "यद्यत्रवृद्धेषु कृतः प्रवेशो\nयुक्तं मया द्वारपाल प्रवेष्टुम्।\nवयं हि वृद्धाश्चरितव्रताश्च\nवेदप्रभावेन समन्विताश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023240, "chapter_id": 1497, "verse_number": "३-१३५-८", "content_sanskrit": "शुश्रूषवश्चापि जितेन्द्रियाश्च\nज्ञानागमे चापि गताः स्म निष्ठाम्।\nन बाल इत्येव मन्तव्यमाहु-\nर्बालोऽप्यग्निर्दहति स्पृश्यमानः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023241, "chapter_id": 1497, "verse_number": "३-१३५-९x", "content_sanskrit": "द्वारपाल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023242, "chapter_id": 1497, "verse_number": "३-१३५-९", "content_sanskrit": "सरस्वतीमीरय वेद जुष्टा-\nमेकाक्षरां बहुरूपां विराजम्।\nअङ्गात्मानं समवेक्षस्व बालं\nकिं श्लाघसे दुर्लभा वादसिद्धिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023243, "chapter_id": 1497, "verse_number": "३-१३५-१०x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023244, "chapter_id": 1497, "verse_number": "३-१३५-१०", "content_sanskrit": "न ज्ञायते कायवृद्ध्या विवृद्धि-\nर्यथाऽष्ठीला शाल्मलेः संप्रवृद्धाः।\nह्रस्वोऽल्पकायः फलितो विवृद्धो\nयश्चाफलस्तस्य न वृद्धभावः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023245, "chapter_id": 1497, "verse_number": "३-१३५-११x", "content_sanskrit": "द्वारपाल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023246, "chapter_id": 1497, "verse_number": "३-१३५-११", "content_sanskrit": "वृद्धेभ्य एवेह मतिं स्म बाला\nगृह्णन्ति कालेन भवन्ति वृद्धाः।\nन हि ज्ञातुमल्पकालेन शक्यं\nकस्माद्बालः स्थविर इव प्रभाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023247, "chapter_id": 1497, "verse_number": "३-१३५-१२x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023248, "chapter_id": 1497, "verse_number": "३-१३५-१२", "content_sanskrit": "न तेन स्थविरो भवति येनास्य पलितं शिरः।\nबालोपि यः प्रजानाति तं देवाः स्थविरं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023249, "chapter_id": 1497, "verse_number": "३-१३५-१३", "content_sanskrit": "न हायनैर्न पलितैर्न वित्तैर्न च बन्धुभिः।\nऋषयश्चक्रिरे धर्मं योऽनूचानः स नो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023250, "chapter_id": 1497, "verse_number": "३-१३५-१४", "content_sanskrit": "दिदृक्षुरस्मि संप्राप्तो बन्दिनं राजसंसदि।\nनिवेदयस्व मां द्वाःस्थ राज्ञे पुष्करमालिने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023251, "chapter_id": 1497, "verse_number": "३-१३५-१५", "content_sanskrit": "द्रष्टास्यद्य वदतोऽस्मान्द्वारपाल मनीषिभिः।\nसह वादे विवृद्धे तु वन्दिनं चापि निर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023252, "chapter_id": 1497, "verse_number": "३-१३५-१६", "content_sanskrit": "पश्यन्तु विप्राः परिपूर्णविद्याः\nसहैव राज्ञा सपुरोधमुख्याः।\nउताहो वाऽप्युच्चतां नीचतां वा\nतूष्णींभूतेष्वेव सर्वेष्वथाद्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023253, "chapter_id": 1497, "verse_number": "३-१३५-१७x", "content_sanskrit": "द्वारपाल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2023254, "chapter_id": 1497, "verse_number": "३-१३५-१७", "content_sanskrit": "कथं यज्ञं दशवर्षो विशेस्त्वं\nविनीतानां विदुषां संप्रवेशम्।\nउपायतः प्रयतिष्ये तवाहं\nप्रवेशने कुरु यत्नं यथावत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2023255, "chapter_id": 1497, "verse_number": "३-१३५-१८", "content_sanskrit": "`एष राजा संश्रवणे स्थितस्ते\nस्तुह्येनं त्वं वचसा संस्कृतेन।\nस चानुज्ञां दास्यति प्रीतियुक्तः\nप्रवेशने यच्च किंचित्तवेष्टम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2023256, "chapter_id": 1497, "verse_number": "३-१३५-१९x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2023257, "chapter_id": 1497, "verse_number": "३-१३५-१९", "content_sanskrit": "भोभो राजञ्जनकानां वरिष्ठ\nत्वं वै सम्राट् त्वयि सर्वं समृद्धम्।\nत्वं वा कर्ता कर्मणां यज्ञियानां\nययातिरेको नृपतिर्वा पुरस्तात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2023258, "chapter_id": 1497, "verse_number": "३-१३५-२०", "content_sanskrit": "विद्वान्वन्दी वादविदो निगृह्य\nवादे भग्नानप्रतिशङ्कमानः।\nत्वयाऽभिसृष्टैः पुरुषैराप्तकृद्भि-\nर्जले सर्वान्मज्जयतीति नः श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2023259, "chapter_id": 1497, "verse_number": "३-१३५-२१", "content_sanskrit": "सोऽहं श्रुत्वा ब्राह्मणानां सकाशे\nब्रह्माद्य वै कथयितुमागतोस्मि।\nक्वासौ वनदी यावदेनं समेत्य\nनक्षत्राणीव सविता नाशयामि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2023260, "chapter_id": 1497, "verse_number": "३-१३५-२२x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2023261, "chapter_id": 1497, "verse_number": "३-१३५-२२", "content_sanskrit": "आशंससे वन्दिनं वै विजेतु-\nमविज्ञाय त्वं वाक्यबलं परस्य।\nविज्ञातवीर्यैः शक्यमेवं प्रवक्तुं\nदृष्टश्चासौ ब्राह्मणैर्वादशीलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2023262, "chapter_id": 1497, "verse_number": "३-१३५-२३", "content_sanskrit": "आशंसमाना वन्दिनं वै बिजेतु-\nमविज्ञात्वा तु बलं वन्दिनोऽस्य।\nसमागता ब्राह्मणास्तेन पूर्वं\nन शोभन्ते भास्करेणेव ताराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2023263, "chapter_id": 1497, "verse_number": "३-१३५-२४", "content_sanskrit": "आशानुबन्धो हि तवात्र यत्नः\nस वन्दिमासाद्यतथा विनश्यति।\nविज्ञानवन्तो निकृतास्तु तात\nकथं सदस्तर्तुमिदं समर्थः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2023264, "chapter_id": 1497, "verse_number": "३-१३५-२५x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2023265, "chapter_id": 1497, "verse_number": "३-१३५-२५", "content_sanskrit": "विवादितोऽसौ न हि मादृशैर्हि\nसिंहीकृतस्तेन वदन्यभीतः।\nसमेत्य मां निहतः शेष्यतेऽद्य\nमार्गे भग्नं शकटमिवाबलाक्षम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2023266, "chapter_id": 1497, "verse_number": "३-१३५-२६x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2023267, "chapter_id": 1497, "verse_number": "३-१३५-२६", "content_sanskrit": "षण्नाभेर्द्वादशाक्षस्य चतुर्विंशतिपर्वणः।\nयस्त्रिषष्टिशतारस्य वेदार्थं स परः कविः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2023268, "chapter_id": 1497, "verse_number": "३-१३५-२७x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2023269, "chapter_id": 1497, "verse_number": "३-१३५-२७", "content_sanskrit": "चतुर्विंशतिपर्व त्वां षणअनाभि द्वादशप्रधि।\nतत्रिषष्टिशतारं वै चक्रं पातु सदागति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2023270, "chapter_id": 1497, "verse_number": "३-१३५-२८x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2023271, "chapter_id": 1497, "verse_number": "३-१३५-२८", "content_sanskrit": "बडबे इव संयुक्ते श्येनपाते दिवौकसाम्।\nकस्तयोर्गर्भमाधत्ते गर्भं सुषुवतुश्च कम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2023272, "chapter_id": 1497, "verse_number": "३-१३५-२९x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2023273, "chapter_id": 1497, "verse_number": "३-१३५-२९", "content_sanskrit": "मा स्म भूः स्वगृहे राजञ्शात्रवाणामपि ध्रुवम्।\nवातसारथिराधत्ते गर्भं सुषुवतुश्च तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2023274, "chapter_id": 1497, "verse_number": "३-१३५-३०x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2023275, "chapter_id": 1497, "verse_number": "३-१३५-३०", "content_sanskrit": "किंस्वित्स्तुप्तं न निमिषति किंस्विज्जातं न चोपति।\nकस्यखिद्धृदयं नास्ति किंस्विद्वेगेन वर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2023276, "chapter_id": 1497, "verse_number": "३-१३५-३१x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2023277, "chapter_id": 1497, "verse_number": "३-१३५-३१", "content_sanskrit": "मत्स्यः सुप्तो न निमिषत्यण्डं जातं न चोपति।\nअश्मनो हृदयं नास्ति नदी वेगेन वर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2023278, "chapter_id": 1497, "verse_number": "३-१३५-३२x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2023279, "chapter_id": 1497, "verse_number": "३-१३५-३२", "content_sanskrit": "न त्वां मन्ये मानुषं देवसत्व\nन त्वं बालः स्थविरः संमतो मे।\nन ते तुल्यो विद्यते वाक्प्रलापे\nतस्माद्द्वारं वितराम्येष विद्वन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2023280, "chapter_id": 1497, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि पञ्चत्रिंशदधिकशततमोऽध्यायः ॥ १३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]