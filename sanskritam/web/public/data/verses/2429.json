[{"id": 2068042, "chapter_id": 2429, "verse_number": "९-४७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2068043, "chapter_id": 2429, "verse_number": "९-४७-१", "content_sanskrit": "शृणु मातृगणान्राजन्कुमारानुचरानिमान्।\nकीर्त्यमानान्मया वीर सपत्नगणसूदनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2068044, "chapter_id": 2429, "verse_number": "९-४७-२", "content_sanskrit": "यशस्विनीनां मातॄणां शृणु नामानि भारत\nयाभिर्वायप्तास्त्रयोलोकाः कल्याणीभिश्च भागशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2068045, "chapter_id": 2429, "verse_number": "९-४७-३", "content_sanskrit": "प्रभावती विशालाक्षी पालिता गोस्तानी तथा।\nश्रीमती बहुला चैव तथैव बहुपुत्रिका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2068046, "chapter_id": 2429, "verse_number": "९-४७-४", "content_sanskrit": "अप्सुजाता च गोपाली बृहदम्बालिका तथा।\nजयावती मालतिका ध्रुवरत्ना भयङ्करी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2068047, "chapter_id": 2429, "verse_number": "९-४७-५", "content_sanskrit": "वसुदामा च दामा च विशोका नन्दिनी तथा।\nएकचूडा महाचूडा चक्रनेमिश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2068048, "chapter_id": 2429, "verse_number": "९-४७-६", "content_sanskrit": "उत्तेजनी जयत्सेना कमलाक्ष्यथ शोभना।\nशत्रुञ्जया तथा चैव क्रोधना शलभी खरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2068049, "chapter_id": 2429, "verse_number": "९-४७-७", "content_sanskrit": "माधवी शुभवक्त्रा च तीर्थसेनिश्च भारत।\nगीतप्रिया च कल्याणी रुद्ररोमाऽमिताशना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2068050, "chapter_id": 2429, "verse_number": "९-४७-८", "content_sanskrit": "मेघस्वना भोगवती सुभ्रूश्च कनकावती।\nअलाताक्षी वीर्यवती विद्युज्जिह्वा च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2068051, "chapter_id": 2429, "verse_number": "९-४७-९", "content_sanskrit": "पुन्नावती सुनक्षत्रा कन्दरा बहुयोजना।\nसन्तानिका च कौरव्य कमला च महाबला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2068052, "chapter_id": 2429, "verse_number": "९-४७-१०", "content_sanskrit": "सुदामा बहुदामा च सुप्रभा च यशस्विनी।\nनृत्यप्रिया च राजेन्द्र शतोलूखलमेखला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2068053, "chapter_id": 2429, "verse_number": "९-४७-११", "content_sanskrit": "शतघण्टा शतानन्दा भगनन्दा च भाविनी।\nवपुष्मती चन्द्रशीता भद्रकाली च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2068054, "chapter_id": 2429, "verse_number": "९-४७-१२", "content_sanskrit": "ऋक्षाम्बिका निष्कुटिका वामा चत्वरवासिनी।\nसुमङ्गला स्वस्तिमती बुद्धिकामा जयप्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2068055, "chapter_id": 2429, "verse_number": "९-४७-१३", "content_sanskrit": "धनदा सुप्रसादा च भवदा च जलेश्वरी।\nएडी भेडी समेडी च वेतालजननी तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2068056, "chapter_id": 2429, "verse_number": "९-४७-१४", "content_sanskrit": "कण्डूतिः कालिका चैव देवमित्रा च भारत।\nवसुश्रीः कोटरा चैव चित्रसेना तथाऽचला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2068057, "chapter_id": 2429, "verse_number": "९-४७-१५", "content_sanskrit": "कुक्कुटिका शङ्खलिका तथा शकुनिका नृप।\nकुण्डारिका कौकुलिका कुम्भिकाऽथ शतोदरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2068058, "chapter_id": 2429, "verse_number": "९-४७-१६", "content_sanskrit": "उत्क्राथिनी जलेला च महावेगा च कङ्कणा।\nमनोजवा कण्टकिनी प्रघसा पूतना तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2068059, "chapter_id": 2429, "verse_number": "९-४७-१७", "content_sanskrit": "केशयन्त्री त्रुटिर्वामा क्रोशनाऽथ तडित्प्रभा।\nमन्दोदरी च मुण्डी च कोटरा मेघवाहिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2068060, "chapter_id": 2429, "verse_number": "९-४७-१८", "content_sanskrit": "सुभगा लम्बिनी लम्बा ताम्रचूडा विकाशिनी।\nऊर्ध्ववेणीधरा चैव पिङ्गाक्षी लोहमेखला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2068061, "chapter_id": 2429, "verse_number": "९-४७-१९", "content_sanskrit": "पृथुवस्त्रा मधुलिका मधुकुम्भा तथैव च।\nपक्षालिका मत्कुलिका जरायुर्जर्जरानना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2068062, "chapter_id": 2429, "verse_number": "९-४७-२०", "content_sanskrit": "ख्याता दहदहा चैव तथा धमधमा नृप।\nखण्डखण्डा च राजेन्द्र पूषणा मणिकुट्टिका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2068063, "chapter_id": 2429, "verse_number": "९-४७-२१", "content_sanskrit": "अमोघा चैव कौरव्य तथा लम्बपयोधरा।\nवेणुवीणाधरा चैव पिङ्गाक्षी लोहमेखला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2068064, "chapter_id": 2429, "verse_number": "९-४७-२२", "content_sanskrit": "शशोकूलमुखी कृष्णा खरजङ्घा महाजवा।\nशिशुमारमुखी श्वेता लोहिताक्षी विभीषणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2068065, "chapter_id": 2429, "verse_number": "९-४७-२३", "content_sanskrit": "जटालिका कामचरी दीर्घजिह्वा बलोत्कटा।\nकालेहिका वामनिका मुकुटा चैव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2068066, "chapter_id": 2429, "verse_number": "९-४७-२४", "content_sanskrit": "लोहिताक्षी महाकाया हरिपिण्डा च भूमिप।\nएकत्वचा सुकुसुमा कृष्णकर्णी च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2068067, "chapter_id": 2429, "verse_number": "९-४७-२५", "content_sanskrit": "क्षुरकर्णी चतुष्कर्णी कर्णप्रावरणा तथा।\nचतुष्पथनिकेता च गोकर्णी महिषानना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2068068, "chapter_id": 2429, "verse_number": "९-४७-२६", "content_sanskrit": "खरकर्णी महाकर्णी भेरीस्वनमहास्वना।\nशङ्खकुम्भश्रवाश्चैव भगदा च महाबला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2068069, "chapter_id": 2429, "verse_number": "९-४७-२७", "content_sanskrit": "गणा च सुगणा चैव तथा भीत्यथ कामदा।\nचतुष्पथरता चैव भूतितीर्थान्यगोचरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2068070, "chapter_id": 2429, "verse_number": "९-४७-२८", "content_sanskrit": "पशुदा वित्तदा चैव सुखदा च महायशाः।\nपयोदा गोमहिषदा सविशाला च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2068071, "chapter_id": 2429, "verse_number": "९-४७-२९", "content_sanskrit": "प्रतिष्ठा सुप्रतिष्ठा च रोचमाना सुरोचना।\nनौकर्णी मुखकर्णी च विशिरा मन्थिनी तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2068072, "chapter_id": 2429, "verse_number": "९-४७-३०", "content_sanskrit": "एकचन्द्रा मेघकर्णा मेघमाला विरोचना।\nएताश्चान्याश्च बहवो मातरो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2068073, "chapter_id": 2429, "verse_number": "९-४७-३१", "content_sanskrit": "कार्तिकेयानुयायिन्यो नानारूपाः सहस्रशः।\nदीर्घनख्यो दीर्घदन्त्यो दीर्घतुण्ड्श्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2068074, "chapter_id": 2429, "verse_number": "९-४७-३२", "content_sanskrit": "सबला मधुराश्चैव यौवनस्थाः स्वलङ्कृताः।\nमाहात्म्येन च संयुक्ताः कामरूपधरास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2068075, "chapter_id": 2429, "verse_number": "९-४७-३३", "content_sanskrit": "निर्मासगात्र्यः श्वेताश्च तथा काञ्चनसन्निभाः।\nकृष्णमेघनिभाश्चान्या धूम्नाश्च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2068076, "chapter_id": 2429, "verse_number": "९-४७-३४", "content_sanskrit": "अरुणाभा महाभोगा दीर्घकेश्यः सिताम्बराः।\nऊर्ध्ववेणीधराश्चैव पिङ्गाक्ष्यो लम्बमेखलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2068077, "chapter_id": 2429, "verse_number": "९-४७-३५", "content_sanskrit": "लम्बोदर्यो लम्बकर्णास्तथा लम्बपयोधराः।\nताम्राक्ष्यस्ताम्रवर्णाश्च हर्यक्ष्यश्च तथाऽपराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2068078, "chapter_id": 2429, "verse_number": "९-४७-३६", "content_sanskrit": "वरदाः कामचारिण्यो नित्यं प्रमुदितास्तथा।\nयाम्या रौद्रास्तथा सौम्याः कौबेर्योऽथ महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2068079, "chapter_id": 2429, "verse_number": "९-४७-३७", "content_sanskrit": "वारुण्योऽथ च माहेन्द्यस्तथाऽऽग्नेय्यः परन्तप।\nवायव्यश्चाथ कौमार्यो ब्राह्मश्च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2068080, "chapter_id": 2429, "verse_number": "९-४७-३८", "content_sanskrit": "वैष्णव्यश्च तथा सौर्यो वाराह्यश्च महाबलाः।\nरूपेणाप्सरसां तुल्या मनोहार्यो मनोरमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2068081, "chapter_id": 2429, "verse_number": "९-४७-३९", "content_sanskrit": "परपुष्टोपमा वाक्ये तथर्द्ध्या धनदोपमाः।\nशक्रवीर्योपमा युद्धे दीप्ता वह्निसमास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2068082, "chapter_id": 2429, "verse_number": "९-४७-४०", "content_sanskrit": "शत्रुणां विग्रहे नित्यं भयदास्ता भवन्त्युत।\nकामरूपधराश्चैव जवे वायुसमास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2068083, "chapter_id": 2429, "verse_number": "९-४७-४१", "content_sanskrit": "अचिन्त्यबलवीर्याश्च तथाऽचिन्त्यपराक्रमाः।\nवृक्षचत्वरवासिन्यश्चतुष्पथनिकेतनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2068084, "chapter_id": 2429, "verse_number": "९-४७-४२", "content_sanskrit": "गुहाश्मशानवासिन्यः शैलप्रस्रवणालयाः।\nनानाभरणधारिण्यो नानामाल्याम्बरास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2068085, "chapter_id": 2429, "verse_number": "९-४७-४३", "content_sanskrit": "नानाविचित्रवेषाश्च नानाभाषास्तथैव च।\nएते चान्ये च मातॄणां गणाः शत्रुभयङ्कराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2068086, "chapter_id": 2429, "verse_number": "९-४७-४४", "content_sanskrit": "अनुजग्मुर्महात्मानं त्रिदशेन्द्रस्य सम्मते।\nततः शक्त्यस्त्रमददद्भगवान्पाकशासनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2068087, "chapter_id": 2429, "verse_number": "९-४७-४५", "content_sanskrit": "गुहाय राजशार्दूल विनाशाय सुरद्विषाम्।\nमहास्वनां महाघण्टां द्योतमानां सितप्रभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2068088, "chapter_id": 2429, "verse_number": "९-४७-४६", "content_sanskrit": "अरुणादित्यवर्णां च पताकां भरतर्षभ।\nददौ पशुपतिस्तस्मै सर्वभूतमहाचमूम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2068089, "chapter_id": 2429, "verse_number": "९-४७-४७", "content_sanskrit": "उग्रां नानाप्रहरणां तपोवीर्यबलान्विताम्।\nअजेयां स्वगणैर्युक्तां नाम्ना सेनां धनञ्जयाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2068090, "chapter_id": 2429, "verse_number": "९-४७-४८", "content_sanskrit": "रुद्रतुल्यबलैर्युक्तां योधानामयुतैस्त्रिभिः।\nन सा विजानाति रणात्कदाचिद्विनिवर्तितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2068091, "chapter_id": 2429, "verse_number": "९-४७-४९", "content_sanskrit": "विष्णुर्ददौ वैजयन्तीं मालां बलविवर्धिनीम्।\nउमा ददौ विरजसी वाससी रविसप्रभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2068092, "chapter_id": 2429, "verse_number": "९-४७-५०", "content_sanskrit": "गङ्गा कमण्डलुं दिव्यममृतोद्भवमुत्तमम्।\nददौ प्रीत्या कुमाराय दण्डं चैव बृहस्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2068093, "chapter_id": 2429, "verse_number": "९-४७-५१", "content_sanskrit": "गरुडो दयितं पुत्रं मयरं चित्रबर्हिणम्।\nअरुणस्ताम्रचूडं च प्रददौ चरणायुधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2068094, "chapter_id": 2429, "verse_number": "९-४७-५२", "content_sanskrit": "छागं तु वरुणो राजा बलवीर्यसमन्वितम्।\nकृष्णाजिनं ततो ब्रह्मा ब्रह्मण्याय ददौ प्रभुः।\nसमरेषु जयं चैव प्रददौ लोकभावनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2068095, "chapter_id": 2429, "verse_number": "९-४७-५३", "content_sanskrit": "सैनापत्यमनुप्राप्य स्कन्दो देवगणस्य ह।\nशुशुभे ज्वलितोर्चिष्मान्द्वितीय इव पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2068096, "chapter_id": 2429, "verse_number": "९-४७-५४", "content_sanskrit": "ततः पारिषदैश्चैव मातृभिश्च समन्वितः।\nययौ देत्यविनाशाय ह्लादयन्सुरपुङ्गवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2068097, "chapter_id": 2429, "verse_number": "९-४७-५५", "content_sanskrit": "सा सेना नैर्ऋती भीमा सघण्टोच्छ्रितकेतना।\nसभेरीशङ्खमुरजा सायुधा सपताकिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2068098, "chapter_id": 2429, "verse_number": "९-४७-५६", "content_sanskrit": "शारदी द्यौरिवाभाति ज्योतिर्भिरिव शोभिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2068099, "chapter_id": 2429, "verse_number": "९-४७-५७", "content_sanskrit": "ततो देवनिकायास्ते नानाभूतगणास्तथा।\nवादयामासुरव्याग्रा भेरीः शङ्खांश्च पुष्कलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2068100, "chapter_id": 2429, "verse_number": "९-४७-५८", "content_sanskrit": "पटहान्झर्झरांश्चैव क्रकचान्गोविषाणिकान्।\nआडम्बरान्गोमुखांश्च डिण्डिमांश्च महास्वनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2068101, "chapter_id": 2429, "verse_number": "९-४७-५९", "content_sanskrit": "तुष्टुवुस्ते कुमारं तु सर्वे देवाः सवासवाः।\nजगुश्च देवगन्धर्वा ननृतुश्चाप्सरोगणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2068102, "chapter_id": 2429, "verse_number": "९-४७-६०", "content_sanskrit": "ततः प्रीतो महासेनस्त्रिदशेभ्यो वरं ददौ।\nरिपून्दन्ताऽस्मि समरे ये वो वधचिकीर्षवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2068103, "chapter_id": 2429, "verse_number": "९-४७-६१", "content_sanskrit": "प्रतिगृह्य वरं देवास्तस्माद्विबुधसत्तमात्।\nप्रीतात्मानो महात्मानो मेनिरे निहतान्रिपून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2068104, "chapter_id": 2429, "verse_number": "९-४७-६२", "content_sanskrit": "सर्वेषां भूतसङ्घानां हर्षान्नादः समुत्थितः।\nअपूरयत लोकांस्त्रीन्वरे दत्ते महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2068105, "chapter_id": 2429, "verse_number": "९-४७-६३", "content_sanskrit": "स निर्ययौ महासेनो महत्या सेनया वृतः।\nवधाय युधि दैत्यानां रक्षार्थं च दिवोकसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2068106, "chapter_id": 2429, "verse_number": "९-४७-६४", "content_sanskrit": "व्यवसायो जयो धर्मः सिद्धिर्लक्ष्मीर्धृतिः स्मृतिः।\nमहासेनस्य सैन्यानामग्रे जग्मुर्नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2068107, "chapter_id": 2429, "verse_number": "९-४७-६५", "content_sanskrit": "स तया भीमया देवः शुलमुद्गरहस्तया।\nज्वलितालातधारिण्या चित्राभरणवर्मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2068108, "chapter_id": 2429, "verse_number": "९-४७-६६", "content_sanskrit": "गदामुसलनाराचशक्तितोमरहरतया।\nदृप्तसिंहनिनादिन्या विनद्य प्रययौ गुहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2068109, "chapter_id": 2429, "verse_number": "९-४७-६७", "content_sanskrit": "`तं दष्ट्वा सर्वदैतेया राक्षसा दानवास्तथा।\nव्यद्रवन्त दिशः सर्वा भयोद्विग्नाः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2068110, "chapter_id": 2429, "verse_number": "९-४७-६८", "content_sanskrit": "अभ्यद्रवन्त देवास्तान्विविधायुधपाणयः।\nदृष्ट्वा च स ततः क्रुद्धः स्कन्दस्तेजोबलान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2068111, "chapter_id": 2429, "verse_number": "९-४७-६९", "content_sanskrit": "शक्त्यस्त्रं भगवान्भीमं पुनःपुनरवाकिरत्।\nआदधच्चात्मनस्तेजो हविषेद्ध इवानलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2068112, "chapter_id": 2429, "verse_number": "९-४७-७०", "content_sanskrit": "अभ्यस्यमाने शक्त्यस्त्रे स्कन्देनामिततेजसा।\nउल्काज्वाला महाराज पपात वसुधातले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2068113, "chapter_id": 2429, "verse_number": "९-४७-७१", "content_sanskrit": "संहादयन्तश्च तथा निर्घाताश्चापतन्क्षिपौ।\nयथान्तकालसमये सुघोराः स्युस्तथा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2068114, "chapter_id": 2429, "verse_number": "९-४७-७२", "content_sanskrit": "क्षिप्ता ह्येका यदा शक्तिः सुघोराऽनलसूनुना।\nततः कोट्यो विनिष्पेतुः शक्तीनां भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2068115, "chapter_id": 2429, "verse_number": "९-४७-७३", "content_sanskrit": "ततः प्रीतो महासेनो जघान भगवान्प्रभुः।\nदैत्येन्द्रं तारकं नाम महाबलपराक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2068116, "chapter_id": 2429, "verse_number": "९-४७-७४", "content_sanskrit": "वृतं दैत्यायुतैर्वीरैर्बलिभिर्दशभिर्नृप।\nमहिषं चाष्टभिः पद्मैर्वृतं सङ्ख्ये निजघ्निवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2068117, "chapter_id": 2429, "verse_number": "९-४७-७५", "content_sanskrit": "त्रिपादं चायुतशतैर्जघान दशभिर्वृतम्।\nहदोदरं निखर्वैश्च वृतं दशभिरीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2068118, "chapter_id": 2429, "verse_number": "९-४७-७६", "content_sanskrit": "जघानानुचरैः सार्धं विविधायुधपाणिभिः।\nतथाऽकुर्वन्त विपुलं नादं वध्यत्सु शत्रुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2068119, "chapter_id": 2429, "verse_number": "९-४७-७७", "content_sanskrit": "कुमारानुचरा राजन्पूरयन्तो दिशो दश।\nननृतुश्च ववल्गुश्च जहसुश्च मुदान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2068120, "chapter_id": 2429, "verse_number": "९-४७-७८", "content_sanskrit": "शक्त्यस्त्रस्य तु राजेन्द्र ततोऽर्चिर्भिः समन्ततः।\nत्रैलोक्यं त्रासितं सर्वं जृम्भमाणाभिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2068121, "chapter_id": 2429, "verse_number": "९-४७-७९", "content_sanskrit": "दग्धाः सहस्रशो दैत्या नादैः स्कन्दस्य चापरे।\nपताकयावधूताश्च हताः केचित्सुरद्विषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2068122, "chapter_id": 2429, "verse_number": "९-४७-८०", "content_sanskrit": "केचिद्धण्टारवत्रस्ता निषेदुर्वसुधातले।\nकेचित्प्रहरणैश्छिन्ना विनिष्पेतुर्गतायुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2068123, "chapter_id": 2429, "verse_number": "९-४७-८१", "content_sanskrit": "एवं सुरद्विषोऽनेकान्बलवानाततायिनः।\nजघान समरे वीरः कार्तिकेयो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2068124, "chapter_id": 2429, "verse_number": "९-४७-८२", "content_sanskrit": "बाणो नामाथ दैतेयो बलेः पुत्रो महाबलः।\nक्रौञ्चं पर्वतमाश्रित्य देवसङ्घानबाधत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2068125, "chapter_id": 2429, "verse_number": "९-४७-८३", "content_sanskrit": "तमभ्ययान्महासेनः सुरशत्रुमुदारधीः।\nस कार्तिकेयस्य भयात्क्रौञ्चं शरणमीयिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2068126, "chapter_id": 2429, "verse_number": "९-४७-८४", "content_sanskrit": "ततः क्रौञ्चं महामन्युः क्रौञ्चनादनिनादितम्।\nशक्त्या बिभेद भगवान्कार्तिकेयोऽग्निदत्तया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2068127, "chapter_id": 2429, "verse_number": "९-४७-८५", "content_sanskrit": "ससालस्कन्धशबलं त्रस्तवानरवारणम्।\nप्रोङ्कीनोद्धान्तविहगं विनिष्पतितपन्नगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2068128, "chapter_id": 2429, "verse_number": "९-४७-८६", "content_sanskrit": "गोलाङ्गूलर्क्षसङ्घैश्च द्रवद्भिरनुनादितम्।\nकुरङ्गमविनिर्घोषनिनादितवनान्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2068129, "chapter_id": 2429, "verse_number": "९-४७-८७", "content_sanskrit": "विनिष्पतद्भिः शरभैः सिंहैश्च सहसा द्रुतैः।\nशोच्यामपि दशां प्राप्तो रराजेव सपर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2068130, "chapter_id": 2429, "verse_number": "९-४७-८८", "content_sanskrit": "विद्याधराः समुत्पेतुस्तस्य शृङ्गनिवासिनः।\nकिन्नराश्च समुद्विग्नाः शक्तिपातरवोद्धताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2068131, "chapter_id": 2429, "verse_number": "९-४७-८९", "content_sanskrit": "ततो दैत्या विनिष्पेतुः शतशोऽथ सहस्रशः।\nप्रदीप्तात्पर्वतश्रेष्ठाद्विचित्राभरणस्रजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2068132, "chapter_id": 2429, "verse_number": "९-४७-९०", "content_sanskrit": "तान्निजघ्नुरतिक्रम्य कुमाराजुचरा मृधे।\nस चैव भगवान्क्रुद्धो दैत्येन्द्रस्य सुतं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2068133, "chapter_id": 2429, "verse_number": "९-४७-९१", "content_sanskrit": "सहानुजं जघानाशु वृत्रं देवपतिर्यथा।\nबिभेद क्रौञ्चं शक्त्या च पावकिः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2068134, "chapter_id": 2429, "verse_number": "९-४७-९२", "content_sanskrit": "बहुधा चैकधा चैव कृत्वाऽऽत्मानं महाबलः।\nशक्तिः क्षिप्ता रणे तस्य पाणिमेति पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2068135, "chapter_id": 2429, "verse_number": "९-४७-९३", "content_sanskrit": "एवम्प्रभावो भगवांस्ते भूयश्च पावकिः।\nशौर्याद्द्विगुणयोगेन तेजसा यशसा श्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2068136, "chapter_id": 2429, "verse_number": "९-४७-९४", "content_sanskrit": "क्रौञ्चस्ते विनिर्भिन्नो दैत्याश्च शतशो हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2068137, "chapter_id": 2429, "verse_number": "९-४७-९५", "content_sanskrit": "ततः स भगवान्देवो निहत्य विबुधद्विषः।\nसभाज्यमानो विबुधैः परं हर्षमवाप ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2068138, "chapter_id": 2429, "verse_number": "९-४७-९६", "content_sanskrit": "ततो दुन्दुभयो राजन्नेदुः शङ्खाश्च भारत।\nमुमुचुर्देवयोषाश्च पुष्पवर्षमनुत्तमम्।\nयोगिनामीश्वरं देवं शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2068139, "chapter_id": 2429, "verse_number": "९-४७-९७", "content_sanskrit": "दिव्यगन्धमुपादाय ववौ पुण्यश्च मारुतः।\nगन्धर्वास्तुष्टुवुश्चैनं यज्वानश्च महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2068140, "chapter_id": 2429, "verse_number": "९-४७-९८", "content_sanskrit": "केचिदनं व्यवस्यान्ति पितामहसुतं प्रभुम्।\nसनत्कुमारं सर्वेषां ब्रह्मयोनिं तमग्रजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2068141, "chapter_id": 2429, "verse_number": "९-४७-९९", "content_sanskrit": "केचिन्महेश्वरसुतं केचित्पुत्रं विभावसोः।\nउमायाः कृत्तिकानां च गङ्गायाश्च वदन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2068142, "chapter_id": 2429, "verse_number": "९-४७-१००", "content_sanskrit": "एकधा च द्विधा चैव चतुर्धा च महाबलम्।\nयोगिनामीश्वरं देवं शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2068143, "chapter_id": 2429, "verse_number": "९-४७-१", "content_sanskrit": "एतत्ते कथितं राजन्कार्तिकेयाभिषेचनम्।\nशृणु चैव सरस्वत्यास्तीर्थवंशस्य पुण्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2068144, "chapter_id": 2429, "verse_number": "९-४७-२", "content_sanskrit": "बभूव तीर्थप्रवरं हतेषु सुरशत्रुषु।\nकुमारेण महाराज त्रिविष्टपमिवापरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2068145, "chapter_id": 2429, "verse_number": "९-४७-३", "content_sanskrit": "ऐश्वर्याणि च तत्रस्थो ददावीशः पृथक्पृथक्।\nददौ नैर्ऋतमुख्येभ्यस्त्रैलोक्यं पावकात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2068146, "chapter_id": 2429, "verse_number": "९-४७-४", "content_sanskrit": "एवं स भगवांस्तस्मिंस्तीर्थे दैत्यकुलान्तकः।\nअभिषिक्तो महाराज देवसेनापतिः सुरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2068147, "chapter_id": 2429, "verse_number": "९-४७-५", "content_sanskrit": "औशनं नाम तत्तीर्थं यत्र पूर्वमपाम्पतिः।\nअभिषिक्तः सुरगणैर्वरुणो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2068148, "chapter_id": 2429, "verse_number": "९-४७-६", "content_sanskrit": "अस्मिंस्तीर्थवरे स्नात्वा स्कन्दं चाभ्यर्च्य लाङ्गली।\nब्राह्मणेभ्योददौ रुक्मं वासांस्याभरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2068149, "chapter_id": 2429, "verse_number": "९-४७-७", "content_sanskrit": "उषित्वा रजनीं तत्र माधवः परवीरहा।\nपूज्यतीर्थवरं तच्च स्पृष्ट्वा तोयं च लाङ्गली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2068150, "chapter_id": 2429, "verse_number": "९-४७-८", "content_sanskrit": "हृष्टः प्रीतमनाश्चैव ह्यभवन्माधवोत्तमः।\nएतत्ते सर्वमाख्यातं यन्मां त्वं परिपृच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2068151, "chapter_id": 2429, "verse_number": "९-४७-९", "content_sanskrit": "यथाऽभिषिक्तो भगवान्स्कन्दो देवैः समागतैः।\n`सेनानीश्च कृतो राजन्बाल एव महाबलः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2068152, "chapter_id": 2429, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि सप्तचत्वारिंशोऽध्यायः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}]