[{"id": 7000471000, "chapter_id": 20471, "verse_number": "३-१८-१", "content_sanskrit": "स्कंदतीर्थं ततो गच्छेत्सर्वपापप्रणाशनम् ।\nआजन्मनः कृतं पापं स्नानमात्राद्व्यपोहति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000471001, "chapter_id": 20471, "verse_number": "३-१८-२", "content_sanskrit": "आंगिरसं ततो गच्छेत्स्नानं तत्र समाचरेत् ।\nगोसहस्रफलं तस्य रुद्रलोके महीयते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000471002, "chapter_id": 20471, "verse_number": "३-१८-३", "content_sanskrit": "लांगलतीर्थं ततो गच्छेत्सर्वपापप्रणाशनम् ।\nतत्र गत्वा तु राजेंद्र स्नानं तत्र समाचरेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000471003, "chapter_id": 20471, "verse_number": "३-१८-४", "content_sanskrit": "सप्तजन्मकृतैः पापैर्मुच्यते नात्र संशयः ।\nवटेश्वरं ततो गच्छेत्सर्वतीर्थमनुत्तमम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000471004, "chapter_id": 20471, "verse_number": "३-१८-५", "content_sanskrit": "तत्र स्नात्वा नरो राजन्गोसहस्रफलं लभेत् ।\nसंगमेश्वरं ततो गच्छेत्सर्वपापहरं परम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000471005, "chapter_id": 20471, "verse_number": "३-१८-६", "content_sanskrit": "तत्र स्नात्वा नरो राज्यं लभते नात्र संशयः ।\nभद्रतीर्थं समासाद्य दानं दद्यात्तु यो नरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000471006, "chapter_id": 20471, "verse_number": "३-१८-७", "content_sanskrit": "तस्य तीर्थप्रभावेण सर्वं कोटिगुणं भवेत् ।\nअथ नारी भवेत्कापि तत्र स्नानं समाचरेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000471007, "chapter_id": 20471, "verse_number": "३-१८-८", "content_sanskrit": "गौरीतुल्या भवेत्सा तु इंद्रं याति न संशयः ।\nअंगारेश्वरं ततो गच्छेत्स्नानं तत्र समाचरेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000471008, "chapter_id": 20471, "verse_number": "३-१८-९", "content_sanskrit": "स्नातमात्रो नरस्तत्र रुद्रलोके महीयते ।\nअंगारक्यां चतुर्थ्यां तु स्नानं तत्र समाचरेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000471009, "chapter_id": 20471, "verse_number": "३-१८-१०", "content_sanskrit": "अक्षयं मोदते कालं मुरारिकृतशासनः ।\nअयोनिसंगमे स्नात्वा न पश्येद्योनिमंदिरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000471010, "chapter_id": 20471, "verse_number": "३-१८-११", "content_sanskrit": "पांडवेश्वरकं गत्वा स्नानं तत्र समाचरेत् ।\nअक्षयं मोदते कालमवध्यस्तु सुरासुरैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000471011, "chapter_id": 20471, "verse_number": "३-१८-१२", "content_sanskrit": "विष्णुलोकं ततो गत्वा क्रीडाभोगसमन्वितः ।\nतत्र भुक्त्वा महाभोगान्मर्त्ये राजाभिजायते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000471012, "chapter_id": 20471, "verse_number": "३-१८-१३", "content_sanskrit": "कंबोतिकेश्वरं गच्छेत्स्नानं तत्र समाचरेत् ।\nउत्तरायणे तु संप्राप्ते यदिच्छेत्तस्य तद्भवेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000471013, "chapter_id": 20471, "verse_number": "३-१८-१४", "content_sanskrit": "चंद्रभागां ततो गच्छेत्स्नानं तत्र समाचरेत् ।\nस्नातमात्रो नरस्तत्र सोमलोके महीयते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000471014, "chapter_id": 20471, "verse_number": "३-१८-१५", "content_sanskrit": "ततो गच्छेत राजेंद्र तीर्थं शक्रस्य विश्रुतम् ।\nपूजितं देवराजेन देवैरपि नमस्कृतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000471015, "chapter_id": 20471, "verse_number": "३-१८-१६", "content_sanskrit": "तत्र स्नात्वा नरो राजन्दानं दत्वा च कांचनम् ।\nअथवा नीलवर्णाभं वृषभं यः समुत्सृजेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000471016, "chapter_id": 20471, "verse_number": "३-१८-१७", "content_sanskrit": "वृषभस्य तु रोमाणि तत्प्रसूतिकुलेषु च ।\nतावद्वर्षसहस्राणि नरो हरपुरे वसेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000471017, "chapter_id": 20471, "verse_number": "३-१८-१८", "content_sanskrit": "ततः स्वर्गात्परिभ्रष्टो राजा भवति वीर्यवान् ।\nअश्वानां श्वेतवर्णानां सहस्रेषु नराधिप ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000471018, "chapter_id": 20471, "verse_number": "३-१८-१९", "content_sanskrit": "स्वामी भवति मर्त्येषु तस्य तीर्थ प्रभावतः ।\nततो गच्छेत राजेंद्र ब्रह्मावर्त्तमनुत्तमम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000471019, "chapter_id": 20471, "verse_number": "३-१८-२०", "content_sanskrit": "तत्र स्नात्वा नरो राजंस्तर्पयेत्पितृदेवताः ।\nउपोष्य रजनीमेकां पिंडं दत्वा यथाविधि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000471020, "chapter_id": 20471, "verse_number": "३-१८-२१", "content_sanskrit": "कन्यागते यथाऽदित्ये अक्षयं संचितं भवेत् ।\nततो गच्छेत राजेंद्र कपिलातीर्थमुत्तमम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000471021, "chapter_id": 20471, "verse_number": "३-१८-२२", "content_sanskrit": "तत्र स्नात्वा नरो राजन्कपिलां यः प्रयच्छति ।\nसंपूर्णां पृथिवीं दत्वा यत्फलं तदवाप्नुयात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000471022, "chapter_id": 20471, "verse_number": "३-१८-२३", "content_sanskrit": "नर्मदेश्वरं परं तीर्थं न भूतं न भविष्यति ।\nतत्र स्नात्वा नरो राजन्नश्वमेधफलं लभेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000471023, "chapter_id": 20471, "verse_number": "३-१८-२४", "content_sanskrit": "तत्र सर्वगतो राजा पृथिव्यामभिजायते ।\nसर्वलक्षणसंपूर्णः सर्वव्याधिविवर्जितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000471024, "chapter_id": 20471, "verse_number": "३-१८-२५", "content_sanskrit": "नार्मदीयोत्तरेकूले तीर्थं परमशोभनम् ।\nआदित्यायतनं रम्यमीश्वरेण तु भावितम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000471025, "chapter_id": 20471, "verse_number": "३-१८-२६", "content_sanskrit": "तत्र स्नात्वा तु राजेंद्र दानं दत्वा च शक्तितः ।\nतस्य तीर्थप्रभावेण दत्तं भवति चाक्षयम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000471026, "chapter_id": 20471, "verse_number": "३-१८-२७", "content_sanskrit": "दरिद्रा व्याधिता ये तु ये च दुष्कृतकर्मणः ।\nमुच्यंते सर्वपापेभ्यः सूर्यलोकं प्रयांति च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000471027, "chapter_id": 20471, "verse_number": "३-१८-२८", "content_sanskrit": "माघमासे तु संप्राप्ते शुक्लपक्षस्य सप्तमीम् ।\nवसेदायतने यस्तु निरात्मा यो जितेंद्रियः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000471028, "chapter_id": 20471, "verse_number": "३-१८-२९", "content_sanskrit": "न जायते व्याधितश्च कालेंधो बधिरस्तथा ।\nसुभगो रूपसंपन्नः स्त्रीणां भवति वल्लभः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000471029, "chapter_id": 20471, "verse_number": "३-१८-३०", "content_sanskrit": "इदं तीर्थं महापुण्यं मार्कंडेयेन भाषितम् ।\nये प्रयांति न राजेंद्र वंचितास्ते न संशयः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000471030, "chapter_id": 20471, "verse_number": "३-१८-३१", "content_sanskrit": "मासेश्वरं ततो गच्छेत्स्नानं तत्र समाचरेत् ।\nस्नातमात्रो नरस्तत्र स्वर्गलोकमवाप्नुयात् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000471031, "chapter_id": 20471, "verse_number": "३-१८-३२", "content_sanskrit": "मोदते सर्वलोकस्थो यावदिंद्राश्चतुर्दश ।\nततः समीपतः स्थित्वा नागेश्वरं तपोवनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000471032, "chapter_id": 20471, "verse_number": "३-१८-३३", "content_sanskrit": "तत्र स्नात्वा तु राजेंद्र शुचिर्भूत्वा समाहितः ।\nबहुभिर्नागकन्याभिः क्रीडते कालमक्षयम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000471033, "chapter_id": 20471, "verse_number": "३-१८-३४", "content_sanskrit": "कुबेरभवनं गच्छेत्कुबेरो यत्र संस्थितः ।\nकालेश्वरं परं तीर्थं कुबेरो यत्र तोषितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000471034, "chapter_id": 20471, "verse_number": "३-१८-३५", "content_sanskrit": "यत्र स्नात्वा तु राजेंद्र सर्वसंपदमाप्नुयात् ।\nततः पश्चिमतो गच्छेन्मरुतालयमुत्तमम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000471035, "chapter_id": 20471, "verse_number": "३-१८-३६", "content_sanskrit": "तत्र स्नात्वा तु राजेंद्र शुचिर्भूत्वा समाहितः ।\nकांचनं तु ततो दद्यादन्नशक्त्या तु बुद्धिमान् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000471036, "chapter_id": 20471, "verse_number": "३-१८-३७", "content_sanskrit": "पुष्पकेण विमानेन वायुलोकं स गच्छति ।\nमम तीर्थं ततो गच्छेन्माघमासे युधिष्ठिर ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000471037, "chapter_id": 20471, "verse_number": "३-१८-३८", "content_sanskrit": "कृष्णपक्षे चतुर्दश्यां स्नानं तत्र समाचरेत् ।\nनक्तं भोज्यं ततः कुर्यान्न गच्छेद्योनिसंकटम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000471038, "chapter_id": 20471, "verse_number": "३-१८-३९", "content_sanskrit": "अहल्यातीर्थं ततो गच्छेत्स्नानं तत्र समाचरेत् ।\nस्नातमात्रो नरस्तत्र अप्सरोभिः प्रमोदते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000471039, "chapter_id": 20471, "verse_number": "३-१८-४०", "content_sanskrit": "पारमेश्वरे तपस्तप्त्वा अहल्या मुक्तिमागमत् ।\nचैत्रमासे तु संप्राप्ते शुक्लपक्षे त्रयोदशी ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000471040, "chapter_id": 20471, "verse_number": "३-१८-४१", "content_sanskrit": "कामदेवदिने तस्मिन्नहल्यां तु प्रपूजयेत् ।\nयत्र तत्र समुत्पन्नो नरस्तत्र प्रियो भवेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000471041, "chapter_id": 20471, "verse_number": "३-१८-४२", "content_sanskrit": "स्त्रीवल्लभो भवेच्छ्रीमान्कामदेव इवापरः ।\nअयोध्यां तु समासाद्य तीर्थं शक्रस्य विश्रुतम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000471042, "chapter_id": 20471, "verse_number": "३-१८-४३", "content_sanskrit": "स्नातमात्रो नरस्तत्र गोसहस्र फलं लभेत् ।\nसोमतीर्थं ततो गच्छेत्स्नानमात्रं समाचरेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000471043, "chapter_id": 20471, "verse_number": "३-१८-४४", "content_sanskrit": "स्नातमात्रो नरस्तत्र सर्वपापैः प्रमुच्यते ।\nसोमग्रहे तु राजेंद्र पापक्षयकरं भवेत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000471044, "chapter_id": 20471, "verse_number": "३-१८-४५", "content_sanskrit": "त्रैलोक्यविश्रुतं राजन्सोमतीर्थं महाफलम् ।\nयस्तु चांद्रायणं कुर्यात्तस्मिंस्तीर्थे नराधिप ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000471045, "chapter_id": 20471, "verse_number": "३-१८-४६", "content_sanskrit": "सर्वपापविशुद्धात्मा सोमलोकं स गच्छति ।\nअग्निप्रवेशे तु जलेप्यथवापि ह्यनाशने ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000471046, "chapter_id": 20471, "verse_number": "३-१८-४७", "content_sanskrit": "सोमतीर्थे मृतो यस्तु नासौ मर्त्येभिजायते ।\nस्तंभतीर्थं ततो गच्छेत्स्नानं तत्र समाचरेत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000471047, "chapter_id": 20471, "verse_number": "३-१८-४८", "content_sanskrit": "स्नातमात्रो नरस्तत्र सोमलोके महीयते ।\nततो गच्छेत राजेंद्र विष्णुतीर्थमनुत्तमम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000471048, "chapter_id": 20471, "verse_number": "३-१८-४९", "content_sanskrit": "योधनीपुरविख्यातं विष्णुतीर्थमनुत्तमम् ।\nअसुरा योधितास्तत्र वासुदेवेन कोटिशः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000471049, "chapter_id": 20471, "verse_number": "३-१८-५०", "content_sanskrit": "तत्र तीर्थं समुत्पन्नं विष्णुः प्रीतो भवेदिह ।\nअहोरात्रोपवासेन ब्रह्महत्यां व्यपोहति ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000471050, "chapter_id": 20471, "verse_number": "३-१८-५१", "content_sanskrit": "ततो गच्छेत्तु राजेंद्र तापसेश्वरमुत्तमम् ।\nअमोहकमिति ख्यातं पितॄन्यस्तत्र तर्पयेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000471051, "chapter_id": 20471, "verse_number": "३-१८-५२", "content_sanskrit": "पौर्णमास्याममावास्यां श्राद्धं कुर्याद्यथाविधि ।\nतत्र स्नात्वा नरो राजन्पितृपिंडं तु दापयेत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000471052, "chapter_id": 20471, "verse_number": "३-१८-५३", "content_sanskrit": "गजरूपाः शिलास्तत्र तोयमध्ये प्रतिष्ठिताः ।\nतस्मिंस्तु दापयेत्पिंडं वैशाखे तु विशेषतः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000471053, "chapter_id": 20471, "verse_number": "३-१८-५४", "content_sanskrit": "तृप्यंति पितरस्तावद्यावत्तिष्ठति मेदिनी ।\nततो गच्छेत राजेंद्र सिद्धेश्वरमनुत्तमम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000471054, "chapter_id": 20471, "verse_number": "३-१८-५५", "content_sanskrit": "तत्र गत्वा तु राजेंद्र गणपत्यंतिकं व्रजेत् ।\nततो गच्छेत राजेंद्र लिंगो यत्र जनार्दनः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000471055, "chapter_id": 20471, "verse_number": "३-१८-५६", "content_sanskrit": "तत्र स्नात्वा तु राजेंद्र विष्णुलोके महीयते ।\nनर्मदादक्षिणेकूले तीर्थं परमशोभनम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000471056, "chapter_id": 20471, "verse_number": "३-१८-५७", "content_sanskrit": "कामदेवः स्वयं तत्र तपस्तप्यत्यसौ महान् ।\nदिव्यं वर्षसहस्रं तु शंकरं पर्युपासते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000471057, "chapter_id": 20471, "verse_number": "३-१८-५८", "content_sanskrit": "समाधिपर्वदग्धस्तु शंकरेण महात्मना ।\nश्वेतपर्वोपमश्चैव हुताशः शुक्लपर्वणि ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000471058, "chapter_id": 20471, "verse_number": "३-१८-५९", "content_sanskrit": "एते दग्धास्तु ते सर्वे कुसुमेश्वरसंस्थिताः ।\nदिव्यवर्षसहस्रेण तुष्टस्तेषां महेश्वरः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000471059, "chapter_id": 20471, "verse_number": "३-१८-६०", "content_sanskrit": "उमया सहितो रुद्रस्तेषां तुष्टो वरप्रदः ।\nविमोक्षयित्वा तान्सर्वान्नर्म्मदातटमास्थितान् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000471060, "chapter_id": 20471, "verse_number": "३-१८-६१", "content_sanskrit": "तस्य तीर्थप्रभावेण पुनर्देवत्वमागतः ।\nत्वत्प्रसादान्महादेव तीर्थं च भवतूत्तमम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000471061, "chapter_id": 20471, "verse_number": "३-१८-६२", "content_sanskrit": "अर्धयोजनविस्तीर्णं तीर्थं दिक्षु समंततः ।\nतस्मिंस्तीर्थे नरः स्नात्वा उपवासपरायणः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000471062, "chapter_id": 20471, "verse_number": "३-१८-६३", "content_sanskrit": "कुसुमायुधरूपेण रुद्रलोके महीयते ।\nवैश्वानरे यमेनैव कामदेवेन वायवे ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000471063, "chapter_id": 20471, "verse_number": "३-१८-६४", "content_sanskrit": "तपस्तप्त्वा तु राजेंद्र तत्रैव च पुरागतैः ।\nअंधोनस्य समीपे तु नातिदूरे तु तस्य वै ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000471064, "chapter_id": 20471, "verse_number": "३-१८-६५", "content_sanskrit": "स्नानं दानं च तत्रैव भोजनं पिंडपातनम् ।\nअग्निवेशे जले वापि अथवापि अनाशने ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000471065, "chapter_id": 20471, "verse_number": "३-१८-६६", "content_sanskrit": "अनिवर्तिका गतिस्तस्य मृतस्याप्यर्द्धयोजने ।\nत्रैयंबकेण तोयेन स्नापयेन्नरपुंगवः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000471066, "chapter_id": 20471, "verse_number": "३-१८-६७", "content_sanskrit": "अंधोनमूले दत्वा तु पिंडं चैव यथाविधि ।\nपितरस्तस्य तृप्यंति यावच्चंद्र दिवाकरौ ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000471067, "chapter_id": 20471, "verse_number": "३-१८-६८", "content_sanskrit": "उत्तरायणे तु संप्राप्ते तत्र स्नानं करोति यः ।\nपुरुषो वापि स्त्री वापि वसेदायतने शुचिः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000471068, "chapter_id": 20471, "verse_number": "३-१८-६९", "content_sanskrit": "सिद्धेश्वरस्य देवस्य प्रभाते पूजनान्नरः ।\nस तां गतिमवाप्नोति न तां सर्वैर्महामखैः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000471069, "chapter_id": 20471, "verse_number": "३-१८-७०", "content_sanskrit": "यदा च तीर्थकालेन रूपवान्सुभगो भवेत् ।\nमर्त्ये भवति राजासावासमुद्रांतगोचरे ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000471070, "chapter_id": 20471, "verse_number": "३-१८-७१", "content_sanskrit": "क्षेत्रपालं न पश्येच्च दंडपालं महाबलम् ।\nवृथा तस्य भवेद्यात्रा अदृष्ट्वा कर्णकुंडलम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000471071, "chapter_id": 20471, "verse_number": "३-१८-७२", "content_sanskrit": "एतत्तीर्थफलं ज्ञात्वा सर्वेदेवाः समागताः ।\nमुंचंति पुष्पवृष्टिं तु स्तुवंति कुसुमेश्वरम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]