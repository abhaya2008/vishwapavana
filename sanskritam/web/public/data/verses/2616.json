[{"id": 2076211, "chapter_id": 2616, "verse_number": "१२-१२१-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076212, "chapter_id": 2616, "verse_number": "१२-१२१-१", "content_sanskrit": "अयं पितामहेनोक्तो राजधर्मः सनातनः।\nकीदृशश्च महादण्डो दण्डे सर्वं प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076213, "chapter_id": 2616, "verse_number": "१२-१२१-२", "content_sanskrit": "देवतानामृषीणां च पितॄणां च महात्मनाम्।\nयक्षरक्षः पिशाचानां मर्त्यानां च विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076214, "chapter_id": 2616, "verse_number": "१२-१२१-३", "content_sanskrit": "सर्वेषां प्राणिनां लोके तिर्यक्ष्वपि निवासिनाम्।\nसर्वस्यापि महातेजा दण्डः श्रेयानिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076215, "chapter_id": 2616, "verse_number": "१२-१२१-४", "content_sanskrit": "इत्येतदुक्तं भवता दण्डे वै सचराचरम्।\nपश्यतां लोक आयत्तं ससुरासुरमानुषम्।\nएतदिच्छाम्यहं श्रोतुं तत्त्वेन भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076216, "chapter_id": 2616, "verse_number": "१२-१२१-५", "content_sanskrit": "को दण्डः कीदृशो दण्डः किंरूपः किंपरायणः।\nकिमात्मकः कथंभूतः कतिमूर्तिः कथं प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076217, "chapter_id": 2616, "verse_number": "१२-१२१-६", "content_sanskrit": "जागर्ति च कथं दण्डः प्रजासु विहितात्मकः।\nकश्च पूर्वापरमिदं जागर्ति प्रतिपालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076218, "chapter_id": 2616, "verse_number": "१२-१२१-७", "content_sanskrit": "कश्च विज्ञायते पूर्वः को वरो दण्डसंज्ञितः।\nकिंसंस्थश्चाभवद्दण्डः का चास्य गतिरिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076219, "chapter_id": 2616, "verse_number": "१२-१२१-८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076220, "chapter_id": 2616, "verse_number": "१२-१२१-८", "content_sanskrit": "शृणु कौरव्य यो दण्डो व्यवहारो यथा च सः।\nयस्मिन्हि सर्वमायत्तं स धर्म इति केवलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076221, "chapter_id": 2616, "verse_number": "१२-१२१-९", "content_sanskrit": "धर्मस्यार्थे महाराज व्यवहार इतीष्यते।\nतस्य लोपः कथं न स्याल्लोकेष्विह महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076222, "chapter_id": 2616, "verse_number": "१२-१२१-१०", "content_sanskrit": "इत्यर्थं व्यवाहरस्य व्यवहारत्वमिष्यते।\nअपि चैतत्पुरा राजन्मनुना प्रोक्तमादितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076223, "chapter_id": 2616, "verse_number": "१२-१२१-११", "content_sanskrit": "सुप्रणीतेन दण्डेन प्रियाप्रियसमात्मना।\nप्रजा रक्षति यः सम्यग्धर्म एव स केवलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076224, "chapter_id": 2616, "verse_number": "१२-१२१-१२", "content_sanskrit": "यथोक्तमेतद्वचनं प्रागेव मनुना पुरा।\nयन्मयोक्तं वसिष्ठेन ब्रह्मणो वचनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076225, "chapter_id": 2616, "verse_number": "१२-१२१-१३", "content_sanskrit": "प्रागिदं वचनं प्रोक्तमतः प्राग्वचनं विदुः।\nव्यवहारस्य चाख्यानाद्व्यवहार इहोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076226, "chapter_id": 2616, "verse_number": "१२-१२१-१४", "content_sanskrit": "दण्डान्त्रिवर्गः सततं सुप्रणीतात्प्रवर्तते।\nदैवं हि परमो दण्डो रूपतोऽग्निरिवोत्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076227, "chapter_id": 2616, "verse_number": "१२-१२१-१५", "content_sanskrit": "नीलोत्पलदलश्यामश्चतुर्दंष्ट्रश्चतुर्भुजः।\nअष्टपान्नैकनयनः शङ्कुकर्णोर्ध्वरोमवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076228, "chapter_id": 2616, "verse_number": "१२-१२१-१६", "content_sanskrit": "जटी द्विजिह्वस्ताम्रास्यो मृगराजतनुच्छदः।\nएतद्रूपं बिभर्त्युग्रं दण्डो नित्यं दुरासदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076229, "chapter_id": 2616, "verse_number": "१२-१२१-१७", "content_sanskrit": "असिर्धनुर्गदा शक्तिस्त्रिशूलं मुद्गरः शरः।\nमुसलं परशुश्चक्रं प्रासदण्डर्ष्टितोमराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076230, "chapter_id": 2616, "verse_number": "१२-१२१-१८", "content_sanskrit": "सर्वप्रहरणीयानि यानि यानीह कानिचित्।\nदण्ड एव स सर्वात्मा लोके चरति मूर्तिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076231, "chapter_id": 2616, "verse_number": "१२-१२१-१९", "content_sanskrit": "भिन्दंश्छिन्दन्रुजन्कृन्तन्दारयन्पाटयंस्तथा।\nघातयन्नभिधावंश्च दण्ड एव चरत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2076232, "chapter_id": 2616, "verse_number": "१२-१२१-२०", "content_sanskrit": "असिर्विशसनो धर्मस्तीक्ष्णवर्मा दुरासदः।\nश्रीगर्भो विजयः शास्ता व्यवहारः प्रजागरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2076233, "chapter_id": 2616, "verse_number": "१२-१२१-२१", "content_sanskrit": "शास्त्रं ब्राह्मणमन्त्राश्च शास्ता प्रवचनं परम्।\nधर्मपालोऽक्षरो गोपः सत्यगो नित्यगो गृहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2076234, "chapter_id": 2616, "verse_number": "१२-१२१-२२", "content_sanskrit": "असङ्गो रुद्रतनयो मनुर्ज्येष्ठः शिवंकरः।\nनामान्येतानि दण्डस्य कीर्तितानि युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2076235, "chapter_id": 2616, "verse_number": "१२-१२१-२३", "content_sanskrit": "दण्डो हि भगवान्विष्णुर्यज्ञो नारायणः प्रभुः।\nशश्वद्रुपं महद्बिभ्रन्महात्पुरुष उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2076236, "chapter_id": 2616, "verse_number": "१२-१२१-२४", "content_sanskrit": "तथोक्ता ब्रह्मकन्येति लक्ष्मीर्नीतिः सरस्वती।\nदण्डनीतिर्जगद्धात्री दण्डो हि बहुविग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2076237, "chapter_id": 2616, "verse_number": "१२-१२१-२५", "content_sanskrit": "अर्थानर्थौ सुखं दुःखं धर्माधर्मौ बलाबले।\nदौर्भाग्यं भागधेयं च पुण्यापुण्ये गुणागुणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2076238, "chapter_id": 2616, "verse_number": "१२-१२१-२६", "content_sanskrit": "कामाकामावृतुर्मासः शर्वरी दिवसः क्षणः।\nअप्रमादः प्रमादश्च हर्षशोकौ शमो दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2076239, "chapter_id": 2616, "verse_number": "१२-१२१-२७", "content_sanskrit": "दैवं पुरुषकारश्च मोक्षामोक्षौ भयाभये।\nहिंसाहिंसे तपो यज्ञः संयमोऽथ विषामृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2076240, "chapter_id": 2616, "verse_number": "१२-१२१-२८", "content_sanskrit": "अन्तश्चादिश्च मध्यं च कृतानां च प्रपञ्चनम्।\nमदः प्रमोदो दर्पश्च दम्भो धैर्यं नयानयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2076241, "chapter_id": 2616, "verse_number": "१२-१२१-२९", "content_sanskrit": "अशक्तिः शक्तिरित्येवं मानस्तम्भौ व्ययाव्ययौ।\nविनयश्च विसर्गश्च कालाकालौ च कौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2076242, "chapter_id": 2616, "verse_number": "१२-१२१-३०", "content_sanskrit": "अनृतं चाज्ञता सत्यं श्रद्धाश्रद्धे तथैव च।\nक्लीबता व्यवसायश्च लाभालाभौ जयाजयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2076243, "chapter_id": 2616, "verse_number": "१२-१२१-३१", "content_sanskrit": "तीक्ष्णता मृदुतात्युग्रमागमानागमौ तथा।\nविरोधश्चाविरोधश्च कार्याकार्ये बलाबले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2076244, "chapter_id": 2616, "verse_number": "१२-१२१-३२", "content_sanskrit": "असूया चानसूया च धर्माधर्मौ तथैव च।\nअपत्रपानपत्रपे ह्रीश्च संपद्विपच्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2076245, "chapter_id": 2616, "verse_number": "१२-१२१-३३", "content_sanskrit": "तेजः कर्माणि पाण्डित्यं वाक्शक्तिर्बुद्धितत्वता।\nएवं दण्डस्य लोकेऽस्मिञ्जागर्ति बहुरूपता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2076246, "chapter_id": 2616, "verse_number": "१२-१२१-३४", "content_sanskrit": "न स्याद्यदीह दण्डो वै प्रमथेयुः परस्परम्।\nभयाद्दण्डस्य नान्योन्यं घ्नन्ति चैव युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2076247, "chapter_id": 2616, "verse_number": "१२-१२१-३५", "content_sanskrit": "दण्डेन रक्ष्यमाणा हि राजन्नहरहः प्रजाः।\nराजानं वर्धयन्तीह तस्माद्दण्डः परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2076248, "chapter_id": 2616, "verse_number": "१२-१२१-३६", "content_sanskrit": "व्यवस्थापयते नित्यमिमं लोकं नरेश्वर।\nसत्ये व्यवस्थितो धर्मो ब्राह्मणेष्ववतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2076249, "chapter_id": 2616, "verse_number": "१२-१२१-३७", "content_sanskrit": "धर्मयुक्ता द्विजश्रेष्ठा देवयुक्ता भवन्ति च।\nबभूव यज्ञो देवेभ्यो यज्ञः प्रीणाति देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2076250, "chapter_id": 2616, "verse_number": "१२-१२१-३८", "content_sanskrit": "प्रीताश्च देवता लोकमिन्द्रे प्रतिददत्युत।\nअत्रं ददाति शक्रश्चाप्यनुगृह्णन्निमाः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2076251, "chapter_id": 2616, "verse_number": "१२-१२१-३९", "content_sanskrit": "प्राणाश्च सर्वभूतानां नित्यमन्ने प्रतिष्ठिताः।\nतस्मात्प्रजाः प्रतिष्ठन्ते दण्डो जागर्ति तासु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2076252, "chapter_id": 2616, "verse_number": "१२-१२१-४०", "content_sanskrit": "एवंप्नयोजनश्चैव दण्डः क्षत्रियतां गतः।\nरक्षप्रजाः स जागर्ति नित्यं स्ववहितोक्षरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2076253, "chapter_id": 2616, "verse_number": "१२-१२१-४१", "content_sanskrit": "ईश्वरः पुरुषः प्राणः सत्वं वृत्तं प्रजापतिः।\nभूतात्मा जीव इत्येवं नामभिः प्रोच्यतेऽष्टभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2076254, "chapter_id": 2616, "verse_number": "१२-१२१-४२", "content_sanskrit": "अददद्दण्डमेवास्मै धृतमैश्वर्यमेव च।\nबले नयश्च संयुक्तः सदा पञ्चविधात्मकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2076255, "chapter_id": 2616, "verse_number": "१२-१२१-४३", "content_sanskrit": "कुलं बहुधनामात्याः प्रज्ञा प्रोक्ता बलानि तु।\nआहार्यमष्टकैर्द्रव्यैर्बलमन्यद्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2076256, "chapter_id": 2616, "verse_number": "१२-१२१-४४", "content_sanskrit": "हस्तिनोऽश्वा रथाः पत्तिर्नावो विष्टिस्तथैव च।\nदेशिकाश्चादिकाश्चैव तदष्टाङ्गं बलं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2076257, "chapter_id": 2616, "verse_number": "१२-१२१-४५", "content_sanskrit": "अथ चाङ्गस्य युक्तस्य रथिनो हस्तियायिनः।\nअश्वारोहाः पदाताश्च मन्त्रिणो रसदाश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2076258, "chapter_id": 2616, "verse_number": "१२-१२१-४६", "content_sanskrit": "भिक्षुकाः प्राड्विवाकाश्च मौहूर्ता दैवचिन्तकाः।\nकोशो मित्राणि धान्यं च सर्वोपकरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2076259, "chapter_id": 2616, "verse_number": "१२-१२१-४७", "content_sanskrit": "सप्तप्रकृति चाष्टाङ्गं शरीरमिह तं विदुः।\nराज्यस्य दण्डमेवाङ्गं दण्डः प्रभव एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2076260, "chapter_id": 2616, "verse_number": "१२-१२१-४८", "content_sanskrit": "ईश्वरेण प्रसन्नेन कारणात्क्षत्रियस्य च।\nदण्डो दत्तः सदा गोप्ता दण्डो हीदं सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2076261, "chapter_id": 2616, "verse_number": "१२-१२१-४९", "content_sanskrit": "राजा पूज्यतमो नान्यो यथा धर्मः प्रदर्शितः।\nब्रह्मणा लोकरक्षार्थं स्वधर्मस्थापनाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2076262, "chapter_id": 2616, "verse_number": "१२-१२१-५०", "content_sanskrit": "भर्तृप्रत्यय उत्पन्नो व्यवहारस्तथाविधः।\nतस्याद्य सहितो दृष्टो भर्तृप्रत्ययलक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2076263, "chapter_id": 2616, "verse_number": "१२-१२१-५१", "content_sanskrit": "व्यवहारस्तु वेदात्मा वेदप्रत्यय उच्यते।\nमौलश्च नरशार्दूल शास्त्रोक्तश्च तथाऽपरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2076264, "chapter_id": 2616, "verse_number": "१२-१२१-५२", "content_sanskrit": "उक्तो यश्चापि दण्डोऽसौ भर्तृप्रत्ययलक्षणः।\nज्ञेयो नः स नरेन्द्रस्थो दण्डः प्रत्यय एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2076265, "chapter_id": 2616, "verse_number": "१२-१२१-५३", "content_sanskrit": "दण्डप्रत्ययदृष्टोऽपि व्यवहारात्मकः स्मृतः।\nव्यवहारः स्मृतो यश्च स वेदविषयात्मकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2076266, "chapter_id": 2616, "verse_number": "१२-१२१-५४", "content_sanskrit": "यश्च वेदप्रसूतात्मा स धर्मो गुणदर्शनः।\nधर्मप्रत्यय उद्दिष्टो यश्च धर्मः कृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2076267, "chapter_id": 2616, "verse_number": "१२-१२१-५५", "content_sanskrit": "व्यवहारः प्रजागोप्ता ब्रह्मदृष्टो युधिष्ठिर।\nत्रीन्धारयति लोकान्वै सत्यात्मा भूतिवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2076268, "chapter_id": 2616, "verse_number": "१२-१२१-५६", "content_sanskrit": "यश्च दण्डः स दृष्टो नो व्यवहारः सनातनः।\nव्यवहारश्च दृष्टो यः स वेद इति नः श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2076269, "chapter_id": 2616, "verse_number": "१२-१२१-५७", "content_sanskrit": "यश्च वेदः स वै धर्मो यश्च धर्मः स सत्पथः।\nब्रह्मा पितामहः पूर्वं भगवांश्च प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2076270, "chapter_id": 2616, "verse_number": "१२-१२१-५८", "content_sanskrit": "लोकानां स हि सर्वेषां ससुरासुररक्षसाम्।\nस मनुष्योरगवतां कर्ता चैव स भूतकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2076271, "chapter_id": 2616, "verse_number": "१२-१२१-५९", "content_sanskrit": "ततो नो व्यवहारोऽयं भर्तृप्रत्ययलक्षणः।\nतस्मादिदमवोचाम व्यवहारनिदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2076272, "chapter_id": 2616, "verse_number": "१२-१२१-६०", "content_sanskrit": "माता पिता च भ्राता च भार्या चैव पुरोहितः।\nनादण्ड्यो विद्यते राज्ञो यः स्वधर्मेण तिष्ठति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2076273, "chapter_id": 2616, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकविंशत्यधिकशततमोऽध्यायः॥ १२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]