[{"id": 2175987, "chapter_id": 4726, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2175988, "chapter_id": 4726, "verse_number": "१", "content_sanskrit": "प्रजापतेरुत्तरवेदिरुच्यते\nसनातनं राम समन्तपञ्चकम् ।\nसमीजिरे यत्र दिवौकसः पुरा\nपरेण सत्रेण महावरप्रदाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2175989, "chapter_id": 4726, "verse_number": "२", "content_sanskrit": "पुरा हि राजर्षिवरेण धीमता\nबहूनि वर्षाण्यमितेन तेजसा ।\nप्रकृष्टमेतत् कुरुणा महात्मना\nततः कुरुक्षेत्रमिहोच्यते बुधैः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2175990, "chapter_id": 4726, "verse_number": "", "content_sanskrit": "रामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2175991, "chapter_id": 4726, "verse_number": "३", "content_sanskrit": "किमर्थं कुरुणा कृष्टं क्षेत्रमेतन्महात्मना ।\nएतदिच्छाम्यहं श्रोतुं कथ्यमानं तपोधनाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2175992, "chapter_id": 4726, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2175993, "chapter_id": 4726, "verse_number": "४", "content_sanskrit": "पुरा किल कुरुं राम कृषन्तं सहसोत्थितम् ।\nअभ्येत्य शक्रस्त्रिदिवात् पर्यपृच्छत कारणम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2175994, "chapter_id": 4726, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2175995, "chapter_id": 4726, "verse_number": "५", "content_sanskrit": "किमिदं वर्तते कर्म प्रयत्नेन परेण ह ।\nराजर्षे किमभिप्रेतं यदियं कृष्यते मही\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2175996, "chapter_id": 4726, "verse_number": "", "content_sanskrit": "कुरुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2175997, "chapter_id": 4726, "verse_number": "६", "content_sanskrit": "इह ये पुरुषव्याघ्रा जनिष्यन्ति शतक्रतो ।\nते गमिष्यन्ति सुकृताँल्लोकान् पापविवर्जिताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2175998, "chapter_id": 4726, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2175999, "chapter_id": 4726, "verse_number": "७", "content_sanskrit": "अपहास्य तु तं शक्रो जगाम त्रिदिवं पुनः ।\nराजर्षिरप्यनिर्विण्णः कृषत्येव वसुन्धराम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2176000, "chapter_id": 4726, "verse_number": "८", "content_sanskrit": "आगम्यागम्य चैवेह भूयो भूयोऽपहास्य च ।\nशतक्रतुरनिर्विण्णं दृष्ट्वा दृष्ट्वा जगाम ह\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2176001, "chapter_id": 4726, "verse_number": "९", "content_sanskrit": "यदा तु तपसोग्रेण चकर्ष वसुधां नृपः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2176002, "chapter_id": 4726, "verse_number": "१०", "content_sanskrit": "ततः शक्रोऽब्रवीद् देवान् राजर्षेर्यच्चिकीर्षितम् ।\nतच्छ्रुत्वाथाब्रुवन् देवाः सहस्राक्षमिदं वचः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2176003, "chapter_id": 4726, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2176004, "chapter_id": 4726, "verse_number": "११", "content_sanskrit": "वरेण च्छन्द्यतां शीघ्रं राजर्षिर्यदि शक्यते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2176005, "chapter_id": 4726, "verse_number": "१२", "content_sanskrit": "यदि ह्यत्र प्रसूता वै स्वर्गं गच्छन्ति मानवाः ।\nअस्माननिष्ट्वा क्रतुभिर्भागो नो न भविष्यति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2176006, "chapter_id": 4726, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2176007, "chapter_id": 4726, "verse_number": "१३", "content_sanskrit": "आगम्य तु ततः शक्रः तदा राजर्षिमब्रवीत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2176008, "chapter_id": 4726, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2176009, "chapter_id": 4726, "verse_number": "१४", "content_sanskrit": "अलं खेदेन भवतः क्रियतां वचनं मम\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2176010, "chapter_id": 4726, "verse_number": "१५", "content_sanskrit": "मानवा ये निराहारा देहं त्यक्ष्यन्त्यतन्द्रिताः ।\nयुद्धे वा निहताः सम्यग् अपि तिर्यग्गता नृप\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2176011, "chapter_id": 4726, "verse_number": "१६", "content_sanskrit": "ते स्वर्गभाजो राजेन्द्र भवन्त्विह महामते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2176012, "chapter_id": 4726, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2176013, "chapter_id": 4726, "verse_number": "१७", "content_sanskrit": "तथाऽस्त्विति ततो राजा कुरुः शक्रमुवाच ह\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2176014, "chapter_id": 4726, "verse_number": "१९", "content_sanskrit": "एवमेतद् यदुश्रेष्ठ कृष्टं राजर्षिणा पुरा ।\nशक्रेण चाभ्यनुज्ञातः पुण्ये प्राणान् मुमोच ह\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2176015, "chapter_id": 4726, "verse_number": "२०", "content_sanskrit": "अपि चात्र स्वयं शक्रो जगौ गाथां सुरेश्वरः ।\nकुरुक्षेत्रनिबद्धां वै तां शृणुष्व हलायुध\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2176016, "chapter_id": 4726, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2176017, "chapter_id": 4726, "verse_number": "२१", "content_sanskrit": "पांसवोऽपि कुरुक्षेत्रे वायुना समुदीरिताः ।\nअपि दुष्कृतकर्माणः ते यान्ति परमां गतिम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2176018, "chapter_id": 4726, "verse_number": "२२", "content_sanskrit": "कुरुक्षेत्रं गमिष्यामि कुरुक्षेत्रे वसाम्यहम् ।\nइत्येवं निश्चितो भूत्वा तेनैव स्वर्गमेष्यति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2176019, "chapter_id": 4726, "verse_number": "२३", "content_sanskrit": "कुरुक्षेत्रं गमिष्यामि कुरुक्षेत्रे वसाम्यहम् ।\nतथा स्थानं च मौनं च वीरासनमुपास्महे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2176020, "chapter_id": 4726, "verse_number": "२४", "content_sanskrit": "एवं प्रलपमानोऽपि चिन्तयंश्च मुहुर्मुहुः ।\nदूरस्थो यदि वा तिष्ठँल्लभेत् स्वर्गं सुनिश्चितम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2176021, "chapter_id": 4726, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2176022, "chapter_id": 4726, "verse_number": "२५", "content_sanskrit": "सुरर्षयो ब्राह्मणसत्तमाश्च\nतथा नृगाद्या नरदेवमुख्याः ।\nइष्ट्वा महार्हैः क्रतुभिर्नृसिंहाः\nसन्न्यस्तदेहाः सुगतिं प्रपन्नाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2176023, "chapter_id": 4726, "verse_number": "२६", "content_sanskrit": "नरन्दुकारन्दुकयोर्यदन्तरं\nरामह्रदानां च नरन्दुकस्य ।\nएतत् कुरुक्षेत्रस्यमन्तपञ्चकं\nपितामहस्योत्तरवेदिरुच्यते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2176024, "chapter_id": 4726, "verse_number": "२७", "content_sanskrit": "इदं शिवं पुण्यतमं दिवौकसां\nसुसम्मतं स्वर्गगुणैः समन्वितम् ।\nअतश्च सर्वेऽत्र वसुन्धराधिपा\nहता गमिष्यन्ति महात्मनां गतिम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2176025, "chapter_id": 4726, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि कुरुक्षेत्रशंसनं नाम चतुर्विंशोऽध्यायः ॥२४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]