[{"id": 7004464000, "chapter_id": 24464, "verse_number": "५-३-१५८-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेत्परं तीर्थं सङ्गमेश्वरमुत्तमम् ।\nनर्मदादक्षिणे कूले सर्वपापभयापहम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004464001, "chapter_id": 24464, "verse_number": "५-३-१५८-२", "content_sanskrit": "धनदस्तत्र विश्रान्तो मुहूर्तं नृपसत्तम ।\nपितृलोकात्समायातः कैलासं धरणीधरम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004464002, "chapter_id": 24464, "verse_number": "५-३-१५८-३", "content_sanskrit": "प्रत्ययार्थं नृपश्रेष्ठ ह्यद्यापि धरणीतले ।\nकृष्णवर्णा हि पाषाणा दृश्यन्ते स्फटिकोज्ज्वलाः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004464003, "chapter_id": 24464, "verse_number": "५-३-१५८-४", "content_sanskrit": "विन्ध्यनिर्झरनिष्क्रान्ता पुण्यतोया सरिद्वरा ।\nप्रविष्टा नर्मदातोये सर्वपापप्रणाशने॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004464004, "chapter_id": 24464, "verse_number": "५-३-१५८-५", "content_sanskrit": "सङ्गमे तत्र यः स्नात्वा पूजयेत्सङ्गमेश्वरम् ।\nअश्वमेधस्य यज्ञस्य फलं प्राप्नोत्यसंशयम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004464005, "chapter_id": 24464, "verse_number": "५-३-१५८-६", "content_sanskrit": "घण्टापताकावितनं यो ददेत्सङ्गमेश्वरे ।\nहंसयुक्तविमानस्थो दिव्यस्त्रीशतसंवृतः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004464006, "chapter_id": 24464, "verse_number": "५-३-१५८-७", "content_sanskrit": "स रुद्रपदमाप्नोति रुद्रस्यानुचरो भवेत् ।\nदधि भक्ते न देवस्य यः कुर्याल्लिङ्गपूरणम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004464007, "chapter_id": 24464, "verse_number": "५-३-१५८-८", "content_sanskrit": "सिक्थसंख्यं शिवे लोके स वसेत्कालमीप्सितम् ।\nश्रीफलैः पूरयेल्लिङ्गं निःस्वो भूत्वा भवस्य तु॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004464008, "chapter_id": 24464, "verse_number": "५-३-१५८-९", "content_sanskrit": "सोऽपि तत्फलमाप्नोति गतः स्वर्गे नरेश्वर ।\nअक्षया सन्ततिस्तस्य जायते सप्तजन्मसु॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004464009, "chapter_id": 24464, "verse_number": "५-३-१५८-१०", "content_sanskrit": "स्नपनं देवदेवस्य दध्ना मधुघृतेन वा ।\nयः करोति विधानेन तस्य पुण्यफलं शृणु॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004464010, "chapter_id": 24464, "verse_number": "५-३-१५८-११", "content_sanskrit": "धृतक्षीरवहा नद्यो यत्र वृक्षा मधुस्रवाः ।\nतत्र ते मानवा यान्ति सुप्रसन्ने महेश्वरे॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004464011, "chapter_id": 24464, "verse_number": "५-३-१५८-१२", "content_sanskrit": "पत्रं पुष्पं फलं तोयं यस्तु दद्यान्महेश्वरे ।\nतत्सर्वं सप्तजन्मानि ह्यक्षयं फलमश्नुते॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004464012, "chapter_id": 24464, "verse_number": "५-३-१५८-१३", "content_sanskrit": "सर्वेषामेव पात्राणां महापात्रं महेश्वरः ।\nतस्मात्सर्वप्रयत्नेन पूजनीयो महेश्वरः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004464013, "chapter_id": 24464, "verse_number": "५-३-१५८-१४", "content_sanskrit": "ब्रह्मचर्यस्थितो नित्यं यस्तु पूजयते शिवम् ।\nइह जीवन्स देवेशो मृतो गच्छेदनामयम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004464014, "chapter_id": 24464, "verse_number": "५-३-१५८-१५", "content_sanskrit": "शिवे तु पूजिते पार्थ यत्फलं प्राप्यते बुधैः ।\nयोगीन्द्रे चैव तत्पार्थ पूजिते लभते फलम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004464015, "chapter_id": 24464, "verse_number": "५-३-१५८-१६", "content_sanskrit": "ते धन्यास्ते महात्मानस्तेषां जन्म सुजीवितम् ।\nयेषां गृहेषु भुञ्जन्ति शिवभक्तिरता नराः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004464016, "chapter_id": 24464, "verse_number": "५-३-१५८-१७", "content_sanskrit": "संनिरुध्येन्द्रियग्रामं यत्रयत्र वसेन्मुनिः ।\nतत्र तत्र कुरुक्षेत्रं नैमिषं पुष्कराणि च॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004464017, "chapter_id": 24464, "verse_number": "५-३-१५८-१८", "content_sanskrit": "यत्फलं वेदविदुषि भोजिते शतसंख्यया ।\nतत्फलं जायते पार्थ ह्येकेन शिवयोगिना॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004464018, "chapter_id": 24464, "verse_number": "५-३-१५८-१९", "content_sanskrit": "यत्र भुञ्जति भस्माङ्गी मूर्खो वा यदि पण्डितः ।\nतत्र भुञ्जति देवेशः सपत्नीको वृषध्वजः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004464019, "chapter_id": 24464, "verse_number": "५-३-१५८-२०", "content_sanskrit": "विप्राणां वेदविदुषां कोटिं संभोज्य यत्फलम् ।\nभिक्षामात्रप्रदानेन तत्फलं शिवयोगिनाम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004464020, "chapter_id": 24464, "verse_number": "५-३-१५८-२१", "content_sanskrit": "सङ्गमेश्वरमासाद्य प्राणत्यागं करोति यः ।\nन तस्य पुनरावृत्तिः शिवलोकात्कदाचन॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]