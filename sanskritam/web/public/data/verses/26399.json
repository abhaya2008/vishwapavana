[{"id": 7006399000, "chapter_id": 26399, "verse_number": "२-५६-१", "content_sanskrit": "वैशम्पायन उवाच\nकस्यचित्त्वथ कालस्य सभ्यांस्तान् यदुसंसदि ।\nबभाषे पुण्डरीकाक्षो हेतुमद्वाक्यमुत्तमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006399001, "chapter_id": 26399, "verse_number": "२-५६-२", "content_sanskrit": "यादवानामियं भूमिर्मथुरा राष्ट्रमालिनी ।\nवयं चैवेह सम्भूता व्रजे च परिवर्द्धिताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006399002, "chapter_id": 26399, "verse_number": "२-५६-३", "content_sanskrit": "तदिदानीं गतं दुःखं शत्रवश्च पराजिताः ।\nनृपेषु जनितं वैरं जरासंधेन विग्रहः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006399003, "chapter_id": 26399, "verse_number": "२-५६-४", "content_sanskrit": "वाहनानि च नः सन्ति पादातं चाप्यनन्तकम् ।\nरत्नानि च विचित्राणि मित्राणि च बहूनि च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006399004, "chapter_id": 26399, "verse_number": "२-५६-५", "content_sanskrit": "इयं च माथुरी भूमिरल्पा गम्या परस्य तु ।\nवृद्धिश्चैव परास्माकं बलतो मित्रतस्तथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006399005, "chapter_id": 26399, "verse_number": "२-५६-६", "content_sanskrit": "कुमारकोट्यो याश्चेमाः पदातीनां गणाश्च ये ।\nएषामपीह वसतां सम्मर्दमुपलक्षये ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006399006, "chapter_id": 26399, "verse_number": "२-५६-७", "content_sanskrit": "अत्र नो रोचते मह्यं निवासो यदुपुङ्गवाः ।\nपुरीं निवेशयिष्यामि मम तत्क्षन्तुमर्हथ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006399007, "chapter_id": 26399, "verse_number": "२-५६-८", "content_sanskrit": "एतद् यदनुरूपं वो ममाभिप्रायजं वचः ।\nभवाय भवतां काले यदुक्तं यदुसंसदि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006399008, "chapter_id": 26399, "verse_number": "२-५६-९", "content_sanskrit": "तमूचुर्यादवाः सर्वे हृष्टेन मनसा तदा ।\nसाध्यतां यदभिप्रेतं जनस्यास्य भवाय वै ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006399009, "chapter_id": 26399, "verse_number": "२-५६-१०", "content_sanskrit": "ततः सम्मन्त्रयामासुर्वृष्णयो मन्त्रमुत्तमम् ।\nअवध्योऽसौ कृतोऽस्माकं सुमहच्च रिपोर्बलम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006399010, "chapter_id": 26399, "verse_number": "२-५६-११", "content_sanskrit": "कृतः सैन्यक्षयश्चापि महानिह नराधिपैः ।\nबहुलानि च सैन्यानि हन्तुं वर्षशतैरपि ।\nन शक्ष्यामो ह्यतस्तेषामपयानेऽभवन्मतिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006399011, "chapter_id": 26399, "verse_number": "२-५६-१२", "content_sanskrit": "तस्मिंश्चैवान्तरे राजा सकालयवनस्तदा ।\nसैन्येन तद्विधेनैव मथुरामभ्युपागमत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006399012, "chapter_id": 26399, "verse_number": "२-५६-१३", "content_sanskrit": "ततो जरासंधबलं दुर्निवार्यमभूत् तदा ।\nते कालयवनं चैव श्रुत्वेदं प्रतिपेदिरे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006399013, "chapter_id": 26399, "verse_number": "२-५६-१४", "content_sanskrit": "केशवः पुनरेवाह यादवान् सत्यसंगरः ।\nअद्यैव दिवसः पुण्यो निर्यामः स्वबलानुगाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006399014, "chapter_id": 26399, "verse_number": "२-५६-१५", "content_sanskrit": "ततो निश्चक्रमुः सर्वे यादवाः कृष्णशासनात् ।\nओघा इव समुद्रस्य बलौघप्रतिनादिताः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006399015, "chapter_id": 26399, "verse_number": "२-५६-१६", "content_sanskrit": "संगृह्य ते कलत्राणि वसुदेवपुरोगमाः ।\nसुसन्नद्धैर्गजैर्मत्तै रथैरश्वैश्च दंशितैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006399016, "chapter_id": 26399, "verse_number": "२-५६-१७", "content_sanskrit": "आहत्य दुन्दुभीन् सर्वे स्वजनज्ञातिबान्धवाः ।\nनिर्ययुर्यादवाः सर्वे मथुरामपहाय वै ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006399017, "chapter_id": 26399, "verse_number": "२-५६-१८", "content_sanskrit": "स्यन्दनैः काञ्चनापीडैर्मत्तैश्च वरवारणैः ।\nसूतैः प्लुतैश्च तुरगैः कशापार्ष्णिप्रणोदितैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006399018, "chapter_id": 26399, "verse_number": "२-५६-१९", "content_sanskrit": "स्वानि स्वानि बलाग्राणि शोभयन्तः प्रकर्षिणः ।\nप्रत्यङ्मुखा ययुर्हृष्टा वृष्णयो भरतर्षभ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006399019, "chapter_id": 26399, "verse_number": "२-५६-२०", "content_sanskrit": "ततो मुख्यतमाः सर्वे यादवा रणकोविदाः ।\nअनीकाग्राणि कर्षन्तो वासुदेवपुरोगमाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006399020, "chapter_id": 26399, "verse_number": "२-५६-२१", "content_sanskrit": "ते स्म नानालताचित्रं नारिकेलवनायुतम् ।\nकीर्णं नागबलैः कान्तं केतकीखण्डमण्डितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006399021, "chapter_id": 26399, "verse_number": "२-५६-२२", "content_sanskrit": "तालपुन्नागबकुलद्राक्षावनघनं क्वचित् ।\nअनूपं सिन्धुराजस्य प्रपेतुर्यदुपुङ्गवाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006399022, "chapter_id": 26399, "verse_number": "२-५६-२३", "content_sanskrit": "ते तत्र रमणीयेषु विषयेषु सुखप्रियाः ।\nमुमुदुर्यादवाः सर्वे देवाः स्वर्गगता इव ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006399023, "chapter_id": 26399, "verse_number": "२-५६-२४", "content_sanskrit": "पुरवास्तु विचिन्वन् स कृष्णस्तु परवीरहा ।\nददर्श विपुलं देशं सागरेणोपशोभितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006399024, "chapter_id": 26399, "verse_number": "२-५६-२५", "content_sanskrit": "वाहनानां हितं चैव सिकताताम्रमृत्तिकम् ।\nपुरलक्षणसम्पन्नं कृतास्पदमिव श्रिया ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006399025, "chapter_id": 26399, "verse_number": "२-५६-२६", "content_sanskrit": "सागरानिलसंवीतं सागराम्बुनिषेवितम् ।\nविषयं सिन्धुराजस्य शोभितं पुरलक्षणैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006399026, "chapter_id": 26399, "verse_number": "२-५६-२७", "content_sanskrit": "तत्र रैवतको नाम पर्वतो नातिदूरतः ।\nमन्दरोदारशिखरः सर्वतोऽभिविराजते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006399027, "chapter_id": 26399, "verse_number": "२-५६-२८", "content_sanskrit": "तत्रैकलव्यसंवासो द्रोणेनाध्युषितश्चिरम् ।\nप्रभूतपुरुषोपेतः सर्वरत्नसमाकुलः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006399028, "chapter_id": 26399, "verse_number": "२-५६-२९", "content_sanskrit": "विहारभूमिस्तत्रैव तस्य राज्ञः सुनिर्मिता ।\nनाम्ना द्वारवती नाम स्वायताष्टापदोपमा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006399029, "chapter_id": 26399, "verse_number": "२-५६-३०", "content_sanskrit": "केशवेन मतिस्तत्र पुर्यर्थे विनिवेशिता ।\nनिवेशं तत्र सैन्यानां रोचयन्ति स्म यादवाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006399030, "chapter_id": 26399, "verse_number": "२-५६-३१", "content_sanskrit": "ते रक्तसूर्यदिवसे तत्र यादवपुङ्गवाः ।\nसेनापालांश्च संचक्रुः स्कन्धावारनिवेशनम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006399031, "chapter_id": 26399, "verse_number": "२-५६-३२", "content_sanskrit": "ध्रुवाय तत्र न्यवसत् केशवः सह यादवैः ।\nदेशे पुरनिवेशाय स यदुप्रवरो विभुः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006399032, "chapter_id": 26399, "verse_number": "२-५६-३३", "content_sanskrit": "तस्यास्तु विधिवन्नाम वास्तूनि च गदाग्रजः ।\nनिर्ममे पुरुषश्रेष्ठो मनसा यादवोत्तमः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006399033, "chapter_id": 26399, "verse_number": "२-५६-३४", "content_sanskrit": "एवं द्वारवतीं चैव पुरीं प्राप्य सबान्धवाः ।\nसुखिनो न्यवसन् राजन् स्वर्गे देवगणा इव ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006399034, "chapter_id": 26399, "verse_number": "२-५६-३५", "content_sanskrit": "कृष्णोऽपि कालयवनं ज्ञात्वा केशिनिषूदनः ।\nजरासंधभयाच्चैव पुरीं द्वारवतीं ययौ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]