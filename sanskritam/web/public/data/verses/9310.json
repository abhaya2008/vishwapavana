[{"id": 5000310000, "chapter_id": 9310, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे अष्टात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000310001, "chapter_id": 9310, "verse_number": "४-३८-१", "content_sanskrit": "प्रतिगृह्य च तत् सर्वमुपायनमुपाहृतम्।\nवानरान् सान्त्वयित्वा च सर्वानेव व्यसर्जयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000310002, "chapter_id": 9310, "verse_number": "४-३८-२", "content_sanskrit": "विसर्जयित्वा स हरीन् सहस्रान् कृतकर्मणः।\nमेने कृतार्थमात्मानं राघवं च महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000310003, "chapter_id": 9310, "verse_number": "४-३८-३", "content_sanskrit": "स लक्ष्मणो भीमबलं सर्ववानरसत्तमम्।\nअब्रवीत् प्रश्रितं वाक्यं सुग्रीवं सम्प्रहर्षयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000310004, "chapter_id": 9310, "verse_number": "४-३८-४", "content_sanskrit": "किष्किन्धाया विनिष्क्राम यदि ते सौम्य रोचते।\nतस्य तद् वचनं श्रुत्वा लक्ष्मणस्य सुभाषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000310005, "chapter_id": 9310, "verse_number": "४-३८-५", "content_sanskrit": "सुग्रीवः परमप्रीतो वाक्यमेतदुवाच ह।\nएवं भवतु गच्छाम स्थेयं त्वच्छासने मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000310006, "chapter_id": 9310, "verse_number": "४-३८-६", "content_sanskrit": "तमेवमुक्त्वा सुग्रीवो लक्ष्मणं शुभलक्षणम्।\nविसर्जयामास तदा ताराद्याश्चैव योषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000310007, "chapter_id": 9310, "verse_number": "४-३८-७", "content_sanskrit": "एहीत्युच्चैर्हरिवरान् सुग्रीवः समुदाहरत्।\nतस्य तद् वचनं श्रुत्वा हरयः शीघ्रमाययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000310008, "chapter_id": 9310, "verse_number": "४-३८-८", "content_sanskrit": "बद्धाञ्जलिपुटाः सर्वे ये स्युः स्त्रीदर्शनक्षमाः।\nतानुवाच ततः प्राप्तान् राजार्कसदृशप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000310009, "chapter_id": 9310, "verse_number": "४-३८-९", "content_sanskrit": "उपस्थापयत क्षिप्रं शिबिकां मम वानराः।\nश्रुत्वा तु वचनं तस्य हरयः शीघ्रविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000310010, "chapter_id": 9310, "verse_number": "४-३८-१०", "content_sanskrit": "समुपस्थापयामासुः शिबिकां प्रियदर्शनाम्।\nतामुपस्थापितां दृष्ट्वा शिबिकां वानराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000310011, "chapter_id": 9310, "verse_number": "४-३८-११", "content_sanskrit": "लक्ष्मणारुह्यतां शीघ्रमिति सौमित्रिमब्रवीत्।\nइत्युक्त्वा काञ्चनं यानं सुग्रीवः सूर्यसंनिभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000310012, "chapter_id": 9310, "verse_number": "४-३८-१२", "content_sanskrit": "बहुभिर्हरिभिर्युक्तमारुरोह सलक्ष्मणः।\nपाण्डुरेणातपत्रेण ध्रियमाणेन मूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000310013, "chapter_id": 9310, "verse_number": "४-३८-१३", "content_sanskrit": "शुक्लैश्च वालव्यजनैर्धूयमानैः समन्ततः।\nशंखभेरीनिनादैश्च बन्दिभिश्चाभिनन्दितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000310014, "chapter_id": 9310, "verse_number": "४-३८-१४", "content_sanskrit": "निर्ययौ प्राप्य सुग्रीवो राज्यश्रियमनुत्तमाम्।\nस वानरशतैस्तीक्ष्णैर्बहुभिः शस्त्रपाणिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000310015, "chapter_id": 9310, "verse_number": "४-३८-१५", "content_sanskrit": "परिकीर्णो ययौ तत्र यत्र रामो व्यवस्थितः।\nस तं देशमनुप्राप्य श्रेष्ठं रामनिषेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000310016, "chapter_id": 9310, "verse_number": "४-३८-१६", "content_sanskrit": "अवातरन्महातेजाः शिबिकायाः सलक्ष्मणः।\nआसाद्य च ततो रामं कृताञ्जलिपुटोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000310017, "chapter_id": 9310, "verse_number": "४-३८-१७", "content_sanskrit": "कृताञ्जलौ स्थिते तस्मिन् वानराश्चाभवंस्तथा।\nतटाकमिव तं दृष्ट्वा रामः कुड्मलपङ्कजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000310018, "chapter_id": 9310, "verse_number": "४-३८-१८", "content_sanskrit": "वानराणां महत् सैन्यं सुग्रीवे प्रीतिमानभूत्।\nपादयोः पतितं मूर्ध्ना तमुत्थाप्य हरीश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000310019, "chapter_id": 9310, "verse_number": "४-३८-१९", "content_sanskrit": "प्रेम्णा च बहुमानाच्च राघवः परिषस्वजे।\nपरिष्वज्य च धर्मात्मा निषीदेति ततोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000310020, "chapter_id": 9310, "verse_number": "४-३८-२०", "content_sanskrit": "निषण्णं तं ततो दृष्ट्वा क्षितौ रामोऽब्रवीत् ततः।\nधर्ममर्थं च कामं च काले यस्तु निषेवते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000310021, "chapter_id": 9310, "verse_number": "४-३८-२१", "content_sanskrit": "विभज्य सततं वीर स राजा हरिसत्तम।\nहित्वा धर्मं तथार्थं च कामं यस्तु निषेवते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000310022, "chapter_id": 9310, "verse_number": "४-३८-२२", "content_sanskrit": "स वृक्षाग्रे यथा सुप्तः पतितः प्रतिबुध्यते।\nअमित्राणां वधे युक्तो मित्राणां संग्रहे रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000310023, "chapter_id": 9310, "verse_number": "४-३८-२३", "content_sanskrit": "त्रिवर्गफलभोक्ता च राजा धर्मेण युज्यते।\nउद्योगसमयस्त्वेष प्राप्तः शत्रुनिषूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000310024, "chapter_id": 9310, "verse_number": "४-३८-२४", "content_sanskrit": "संचिन्त्यतां हि पिङ्गेश हरिभिः सह मन्त्रिभिः।\nएवमुक्तस्तु सुग्रीवो रामं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000310025, "chapter_id": 9310, "verse_number": "४-३८-२५", "content_sanskrit": "प्रणष्टा श्रीश्च कीर्तिश्च कपिराज्यं च शाश्वतम्।\nत्वत्प्रसादान्महाबाहो पुनः प्राप्तमिदं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000310026, "chapter_id": 9310, "verse_number": "४-३८-२६", "content_sanskrit": "तव देव प्रसादाच्च भ्रातुश्च जयतां वर।\nकृतं न प्रतिकुर्याद् यः पुरुषाणां हि दूषकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000310027, "chapter_id": 9310, "verse_number": "४-३८-२७", "content_sanskrit": "एते वानरमुख्याश्च शतशः शत्रुसूदन।\nप्राप्ताश्चादाय बलिनः पृथिव्यां सर्ववानरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000310028, "chapter_id": 9310, "verse_number": "४-३८-२८", "content_sanskrit": "ऋक्षाश्च वानराः शूरा गोलाङ्गूलाश्च राघव।\nकान्तारवनदुर्गाणामभिज्ञा घोरदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000310029, "chapter_id": 9310, "verse_number": "४-३८-२९", "content_sanskrit": "देवगन्धर्वपुत्राश्च वानराः कामरूपिणः।\nस्वैः स्वैः परिवृताः सैन्यैर्वर्तन्ते पथि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000310030, "chapter_id": 9310, "verse_number": "४-३८-३०", "content_sanskrit": "शतैः शतसहस्रैश्च वर्तन्ते कोटिभिस्तथा।\nअयुतैश्चावृता वीर शङ्कुभिश्च परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000310031, "chapter_id": 9310, "verse_number": "४-३८-३१", "content_sanskrit": "अर्बुदैरर्बुदशतैर्मध्यैश्चान्त्यैश्च वानराः।\nसमुद्राश्च परार्धाश्च हरयो हरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000310032, "chapter_id": 9310, "verse_number": "४-३८-३२", "content_sanskrit": "आगमिष्यन्ति ते राजन् महेन्द्रसमविक्रमाः।\nमेघपर्वतसंकाशा मेरुविन्ध्यकृतालयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000310033, "chapter_id": 9310, "verse_number": "४-३८-३३", "content_sanskrit": "ते त्वामभिगमिष्यन्ति राक्षसं योद्धुमाहवे।\nनिहत्य रावणं युद्धे ह्यानयिष्यन्ति मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000310034, "chapter_id": 9310, "verse_number": "४-३८-३४", "content_sanskrit": "ततः समुद्योगमवेक्ष्य वीर्यवान्\nहरिप्रवीरस्य निदेशवर्तिनः।\nबभूव हर्षाद् वसुधाधिपात्मजः\nप्रबुद्धनीलोत्पलतुल्यदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000310035, "chapter_id": 9310, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे अष्टात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]