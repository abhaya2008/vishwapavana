[{"id": 40019351, "chapter_id": 9310, "verse_number": "1", "content_sanskrit": "एतच्छ्रुत्वाशुभंवाक्यंराघवेणानुभाषितम् । ततश्शुभतरंवाक्यंव्याजहारमहेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40019352, "chapter_id": 9310, "verse_number": "2", "content_sanskrit": "पुष्कराक्ष महाबाहो महावक्ष परन्तप । दिष्ट्याकृतमिदंकर्मत्वयाधर्मभृतांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40019353, "chapter_id": 9310, "verse_number": "3", "content_sanskrit": "दिष्ट्यासर्वस्यलोकस्यप्रवृद्धंदारुणंतमः । अपावृत्तंत्वयासङ्ख्येरामरावणजंभयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40019354, "chapter_id": 9310, "verse_number": "4", "content_sanskrit": "आश्वास्यभरतंदीनंकौसल्यां च यशस्विनीम् । कैकेयीं च सुमित्रां च दृष्टवालक्ष्मणमातरम् ॥ प्राप्यराज्यमयोध्यायांनन्दयित्वासुहृज्जनम् । इक्ष्वाकूणांकुलेवंशंस्थापयित्वामहाबल ॥ इष्टवातुरगमेधेनप्राप्यचानुत्तमंयशः । ब्राह्मणेभ्योधनंदत्त्वात्रिदिवंगन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40019355, "chapter_id": 9310, "verse_number": "5", "content_sanskrit": "आश्वास्यभरतंदीनंकौसल्यां च यशस्विनीम् । कैकेयीं च सुमित्रां च दृष्टवालक्ष्मणमातरम् ॥ प्राप्यराज्यमयोध्यायांनन्दयित्वासुहृज्जनम् । इक्ष्वाकूणांकुलेवंशंस्थापयित्वामहाबल ॥ इष्टवातुरगमेधेनप्राप्यचानुत्तमंयशः । ब्राह्मणेभ्योधनंदत्त्वात्रिदिवंगन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40019356, "chapter_id": 9310, "verse_number": "6", "content_sanskrit": "आश्वास्यभरतंदीनंकौसल्यां च यशस्विनीम् । कैकेयीं च सुमित्रां च दृष्टवालक्ष्मणमातरम् ॥ प्राप्यराज्यमयोध्यायांनन्दयित्वासुहृज्जनम् । इक्ष्वाकूणांकुलेवंशंस्थापयित्वामहाबल ॥ इष्टवातुरगमेधेनप्राप्यचानुत्तमंयशः । ब्राह्मणेभ्योधनंदत्त्वात्रिदिवंगन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40019357, "chapter_id": 9310, "verse_number": "7", "content_sanskrit": "एषराजादशरथोविमानस्थःपितातव । काकुत्स्थमानुषेलोकेगुरुस्तवमहायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40019358, "chapter_id": 9310, "verse_number": "8", "content_sanskrit": "इन्द्रलोकंगतःश्रीमांस्त्वयापुत्रेणतारितः । लक्ष्मणेनसहभ्रात्रात्वमेममभिवादय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40019359, "chapter_id": 9310, "verse_number": "9", "content_sanskrit": "महदेववच्श्रुत्वाराघवःसहलक्ष्मणः । लक्ष्मणेनसहभ्रात्राददर्शपितरंप्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40019360, "chapter_id": 9310, "verse_number": "10", "content_sanskrit": "दीप्यमानंस्वयालक्ष्मविरजोऽम्भरधारिणम् । लक्ष्मणेनसहभ्रात्राददर्शपितरंप्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40019361, "chapter_id": 9310, "verse_number": "11", "content_sanskrit": "हर्षेणमहताविष्टोविमनस्थोमहीपतिः । प्राणैःप्रियतरंदृष्टवापुत्रंदशरथस्तदा ॥ आरोप्याङ्केमहबाहुर्वरासनगतःप्रभुः । बाहुभ्यांसम्परिष्वज्यततोवाक्यंसमाददे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40019362, "chapter_id": 9310, "verse_number": "12", "content_sanskrit": "हर्षेणमहताविष्टोविमनस्थोमहीपतिः । प्राणैःप्रियतरंदृष्टवापुत्रंदशरथस्तदा ॥ आरोप्याङ्केमहबाहुर्वरासनगतःप्रभुः । बाहुभ्यांसम्परिष्वज्यततोवाक्यंसमाददे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40019363, "chapter_id": 9310, "verse_number": "13", "content_sanskrit": "न मेस्वर्गोबहुमतस्सम्मानश्चसुरर्षभैः । त्वयारामविहीनस्यसत्यंप्रतिशृणोमिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40019364, "chapter_id": 9310, "verse_number": "14", "content_sanskrit": "अद्यत्वांनिहतामित्रंदृष्टवासम्पूर्णमानसम् । निस्तीर्णवनवासं च प्रीतिरासीत्परामम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40019365, "chapter_id": 9310, "verse_number": "15", "content_sanskrit": "कैकेय्यायानिचोक्तानिवाक्यानिवदतांवर । तवप्रव्राजनार्थानिस्थितानिहृदयेमम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40019366, "chapter_id": 9310, "verse_number": "16", "content_sanskrit": "त्वांतुदृष्टवाकुशलिनंपरिष्वज्यसलक्ष्मणम् । अद्यदुःखाद्विमुक्तोऽस्मिनीहारादिवभास्करः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40019367, "chapter_id": 9310, "verse_number": "17", "content_sanskrit": "तारितोऽहंत्वयापुत्र सुपुत्रेणमहात्मना । अष्टावक्रेणधर्मात्माकहोलोब्राह्मणोयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40019368, "chapter_id": 9310, "verse_number": "18", "content_sanskrit": "इदानीं च विजानामियथासौम्य सुरेश्वरैः । वधार्थंरावणस्येहविहितंपुरुषोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40019369, "chapter_id": 9310, "verse_number": "19", "content_sanskrit": "सिद्धार्थाखलुकौसल्यायात्वांराम गृहंगतम् । वनान्निवृत्तंसंहृष्टाद्रक्ष्यतेशत्रुसूदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40019370, "chapter_id": 9310, "verse_number": "20", "content_sanskrit": "सिद्धार्थाःखलुतेराम नरायेत्वांपुरींगतम् । राज्येचावाभिषिक्तं च द्रक्ष्यन्तेवसुधाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40019371, "chapter_id": 9310, "verse_number": "21", "content_sanskrit": "अनुरक्तेनबलिनाशुचिनाधर्मचारिणा । इच्छेयंत्वामहंद्रष्टुंभरतेनसमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40019372, "chapter_id": 9310, "verse_number": "22", "content_sanskrit": "चतुर्दशसमास्सौम्यवनेनिर्यातितास्त्वया । वसतासीतयासार्धंलक्ष्मणेन च धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40019373, "chapter_id": 9310, "verse_number": "23", "content_sanskrit": "निवृत्तवनवासोऽसिप्रतिज्ञापूरितात्वया । रावणं च रणेहत्वादेवताःपरितोषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40019374, "chapter_id": 9310, "verse_number": "24", "content_sanskrit": "कृतंकर्मयशश्श्लाघ्यंप्राप्तंतेशत्रुसूदन । भ्रातृभिःसहराज्यस्थोदीर्घमायुरवाप्नुहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40019375, "chapter_id": 9310, "verse_number": "25", "content_sanskrit": "इतिब्रुवाणंराजानंरामःप्राञ्जलिरब्रवीत् । कुरुप्रसादंधर्मज्ञकैकेय्याभरतस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40019376, "chapter_id": 9310, "verse_number": "26", "content_sanskrit": "सपुत्रांत्वांत्यजामीतियदुक्ताकेकयीत्वया । स शापःकेकयींघोरस्सपुत्रां न स्पृशेत्प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40019377, "chapter_id": 9310, "verse_number": "27", "content_sanskrit": "तथेति स महाराजोराममुक्त्वाकृताञ्जलिम् । लक्ष्मणं च परिष्वज्यपुनर्वाक्यमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40019378, "chapter_id": 9310, "verse_number": "28", "content_sanskrit": "रामंशुश्रूषताभक्त्यावैदेह्यासहसीतया । कृतमममहाप्रीतिःप्राप्तंधर्मफलं च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40019379, "chapter_id": 9310, "verse_number": "29", "content_sanskrit": "धर्मंप्राप्स्यसिधर्मज्ञ यशश्चविपुलंभुवि । रामेप्रसन्नेस्वर्गं च महिमानंतथोत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40019380, "chapter_id": 9310, "verse_number": "30", "content_sanskrit": "रामंशुश्रूषभद्रंतेसुमित्रानन्दवर्धन । रामस्सर्वस्यलोकस्यसुभेष्वभिरतःसदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40019381, "chapter_id": 9310, "verse_number": "31", "content_sanskrit": "एतेसेन्द्रास्त्रयोलोकास्सिद्धाश्चपरमर्षयः । अभिगम्यमहात्मानमर्चन्तिपुरुषोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40019382, "chapter_id": 9310, "verse_number": "32", "content_sanskrit": "एतत्तदुक्तमव्यक्तमक्षरंब्रह्मनिर्मितम् । देवानांहृदयंसौम्य गुह्यंरामःपरन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40019383, "chapter_id": 9310, "verse_number": "33", "content_sanskrit": "अवाप्तंधर्मचरणंयशश्चविपुलंत्वया । एनंशुश्रूषताभक्त्यावैदेह्यासहसीतया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40019384, "chapter_id": 9310, "verse_number": "34", "content_sanskrit": "इत्युक्त्वालक्ष्मणंराजास्नुषांबद्धाञ्जलिंस्थिताम् । पुत्रीत्याभाष्यमधुरंशनैरेनामुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40019385, "chapter_id": 9310, "verse_number": "35", "content_sanskrit": "कर्तव्यो न तुवैदेहीमन्युस्त्यागमिमंप्रति । रामेणेत्वद्विशुध्यर्थंकृतमेतद्धितैषिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40019386, "chapter_id": 9310, "verse_number": "36", "content_sanskrit": "सुदुष्करमिदंपुत्रितवचारित्रलक्षणम् । कृतंयत्तेऽन्यनारीणांयशोह्यभिभविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40019387, "chapter_id": 9310, "verse_number": "37", "content_sanskrit": "न त्वंकामंसमाधेयाभर्तृशुश्रूषणंप्रति । अवश्यंतुमयावाच्यमेषतेदैवतंपरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40019388, "chapter_id": 9310, "verse_number": "38", "content_sanskrit": "इतिप्रतिसमादिश्यपुत्रौसीतां च राघवः । इन्द्रलोकंविमानेनययौदशरथोज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]