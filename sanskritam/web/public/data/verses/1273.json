[{"id": 2013289, "chapter_id": 1273, "verse_number": "२-१४-१", "content_sanskrit": "कृष्ण उवाच॥\nसर्वैर्गुणैर्महाराज राजसूयं त्वमर्हसि।\nजानतस्त्वेव ते सर्वं किञ्चिद्वक्ष्यामि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013290, "chapter_id": 1273, "verse_number": "२-१४-२", "content_sanskrit": "जामदग्न्येन रामेण क्षत्रं यदवशेषितम्।\nतस्मादवरजं लोके यदिदं क्षत्रसंज्ञितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013291, "chapter_id": 1273, "verse_number": "२-१४-३", "content_sanskrit": "कृतोऽयं कलुसङ्कल्पः क्षत्रियैर्वसुधाधिप।\nनिदेशवाग्भिस्तत्तेह विदितं भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013292, "chapter_id": 1273, "verse_number": "२-१४-४", "content_sanskrit": "ऐलस्येक्ष्वाकुवंशस्य प्रकृतिं परिचक्षते।\nराजानः श्रेणिबद्धाश्च तथाऽन्ये क्षत्रिया भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013293, "chapter_id": 1273, "verse_number": "२-१४-५", "content_sanskrit": "ऐलवंश्याश्च ये राजंस्तथैवेक्ष्वाकवो नृपाः।\nतानि चैकशतं विद्धि कुलानि भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013294, "chapter_id": 1273, "verse_number": "२-१४-६", "content_sanskrit": "ययातेस्त्वेव भोजानां विस्तरो गुणतो महान्।\nभजतेऽद्य महाराज विस्तरं सचतुर्दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013295, "chapter_id": 1273, "verse_number": "२-१४-७", "content_sanskrit": "तेषां तथैव तां लक्ष्मीं सर्वक्षत्रमुपासते।\nइदानीमेव वै राजञ्जरासन्धो महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013296, "chapter_id": 1273, "verse_number": "२-१४-८", "content_sanskrit": "अभिभूय श्रियं तेषां कुलानामभिषेचितः।\nस्थितो मूर्ध्नि नरेन्द्राणामोजसाऽऽक्रम्य सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013297, "chapter_id": 1273, "verse_number": "२-१४-९", "content_sanskrit": "सोऽवनीं मध्यमां भुक्त्वा मिथो भेदममन्यत।\nप्रभुर्यस्तु परो राजा यस्मिन्नेकवशे जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013298, "chapter_id": 1273, "verse_number": "२-१४-१०", "content_sanskrit": "स साम्राज्यं महाराज प्राप्तो भवति योगतः।\nतं स राजा जरासन्धं संश्रित्य किल सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013299, "chapter_id": 1273, "verse_number": "२-१४-११", "content_sanskrit": "राजन्सेनापतिर्जातः शिशुपालः प्रतापवान्।\nतमेव च महाराज शिष्यवत्समुपस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013300, "chapter_id": 1273, "verse_number": "२-१४-१२", "content_sanskrit": "वक्रः करूषाधिपतिर्मायायोधी महाबलः॥\nअपरौ च महावीर्यौ महात्मानौ समाश्रितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013301, "chapter_id": 1273, "verse_number": "२-१४-१३", "content_sanskrit": "जरासन्धं महावीर्यं तौ हिंसडिम्बिकावुभौ।\nवक्रदन्तः करूषस्य करभो मेघवाहनः।\nमूर्ध्ना दिव्यं मणिं बिभ्रद्यमद्भुतमणिं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013302, "chapter_id": 1273, "verse_number": "२-१४-१४", "content_sanskrit": "मरुं च नरकं चैव शास्ति यो यवनाधिपः।\nअपर्यन्तबलो राजा प्रतीच्यां वरुणो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013303, "chapter_id": 1273, "verse_number": "२-१४-१५", "content_sanskrit": "भगदत्तो महाराज वृद्धस्तव पितुः सखा।\nस वाचा प्रणतस्तस्य कर्मणा च विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013304, "chapter_id": 1273, "verse_number": "२-१४-१६", "content_sanskrit": "स्नेहबद्धश्च मनसा पितृवद्भक्तिमांस्त्वयि।\nप्रतीच्यां दक्षिणं चान्तं पृथिव्याः प्रति यो नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013305, "chapter_id": 1273, "verse_number": "२-१४-१७", "content_sanskrit": "मातुलो भवतः शूरः पुरुजित्कुन्तिवर्धनः।\nस ते सन्नितिमानेकः स्नेहतः शत्रुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013306, "chapter_id": 1273, "verse_number": "२-१४-१८", "content_sanskrit": "जरासन्धं गतस्त्वेव पुरा यो न मया हतः।\nपुरुषोत्तमविज्ञातो योसौ चेदिषु दुर्मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013307, "chapter_id": 1273, "verse_number": "२-१४-१९", "content_sanskrit": "आत्मानं प्रतिजानाति लोकेऽस्मिन्पुरुषोत्तमम्।\nआदत्ते सततं मोहाद्यः स चिह्नं च मामकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013308, "chapter_id": 1273, "verse_number": "२-१४-२०", "content_sanskrit": "वङ्गपुण्ड्रकिरातेषु राजा बलसमन्वितः।\nपौण्ड्रको वासुदेवेति योसौ लोकेऽभिविश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013309, "chapter_id": 1273, "verse_number": "२-१४-२१", "content_sanskrit": "चतुर्थभाङ्महाराज भोज इन्द्रसखो बली।\nविद्याबलाद्यो व्यजयत्स पाण्ड्यक्रथकैशिकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013310, "chapter_id": 1273, "verse_number": "२-१४-२२", "content_sanskrit": "भ्राता तस्याकृतिः शूरो जामदग्न्यसमोऽभवत्।\nस भक्तो मागधं राजा भीष्मकः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013311, "chapter_id": 1273, "verse_number": "२-१४-२३", "content_sanskrit": "प्रियाण्याचरतः प्रह्वान्सदा सम्बन्धिनस्ततः।\nभजतो न भजत्यस्मानप्रियेषु व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013312, "chapter_id": 1273, "verse_number": "२-१४-२४", "content_sanskrit": "न कुलं सबलं राजन्नभ्यजानात्तथाऽऽत्मनः।\nपश्यमानो यशो दीप्तं जरासन्धमुपस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013313, "chapter_id": 1273, "verse_number": "२-१४-२५", "content_sanskrit": "उदीच्याश्च तथा भोजाः कुलान्यष्टादश प्रभो।\nजरासन्धभयादेव प्रतीचीं दिशमास्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013314, "chapter_id": 1273, "verse_number": "२-१४-२६", "content_sanskrit": "शूरसेना भद्रकारा बोधाः शाल्वाः पटच्चराः।\nसुस्थलाश्च सुकुट्टाश्च कुलिन्दाः कुन्तिभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013315, "chapter_id": 1273, "verse_number": "२-१४-२७", "content_sanskrit": "शाल्वायनाश्च राजानः सोदर्यानुचरैः सह।\nदक्षिणा ये च पञ्चालाः पूर्वाः कुन्तिषु कोसलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013316, "chapter_id": 1273, "verse_number": "२-१४-२८", "content_sanskrit": "तथोत्तरां दिशं चापि परित्यज्य भयार्दिताः।\nमत्स्याः सन्न्यस्तपादाश्च दक्षिणां दिशमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013317, "chapter_id": 1273, "verse_number": "२-१४-२९", "content_sanskrit": "तथैव सर्वपञ्चाला जरासन्धभायर्दिताः।\nस्वराज्यं सम्परित्यज्य विद्रुताः सर्वतोदिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2013318, "chapter_id": 1273, "verse_number": "२-१४-३०", "content_sanskrit": "अग्रतो ह्यस्य पाञ्चालास्तत्रानीके महात्मनः।\nअनिर्गते सारबले मागधेभ्यो गिरिव्रजात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2013319, "chapter_id": 1273, "verse_number": "२-१४-३१", "content_sanskrit": "उग्रसेनसुतः कंसः पुरा निर्जित्य बान्धवान्।\nबार्हद्रथसुते देव्यावुपागच्छद्वृथामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2013320, "chapter_id": 1273, "verse_number": "२-१४-३२", "content_sanskrit": "अस्तिः प्रास्तिश्च नाम्ना ते सहदेवानुजेऽबले।\nबलेन तेन स्वज्ञातीनभिभूय वृथामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2013321, "chapter_id": 1273, "verse_number": "२-१४-३३", "content_sanskrit": "श्रैष्ठ्यं प्राप्तः स तस्यासीदतीवापनयो महान्।\nभोजराजन्यवृद्धैश्च पीड्यमानैर्दुरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2013322, "chapter_id": 1273, "verse_number": "२-१४-३४", "content_sanskrit": "ज्ञातित्राणमभीप्सद्भिरस्मत्सम्भावना कृता।\nदत्वाऽऽक्रूराय सुतनुं तामाहुकसुतां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2013323, "chapter_id": 1273, "verse_number": "२-१४-३५", "content_sanskrit": "सङ्कर्षणद्वितीयेन ज्ञातिकार्यं मया कृतम्।\nहतौ कंससुनामानौ मया रामेण चाप्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2013324, "chapter_id": 1273, "verse_number": "२-१४-३६", "content_sanskrit": "हत्वा कंसं तथैवादौ जरासन्धस्य बिभ्यतः।\nमया रामेण चान्यत्र ज्ञातयः परिपालितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2013325, "chapter_id": 1273, "verse_number": "२-१४-३७", "content_sanskrit": "भये तु समतिक्रान्ते जरासन्धे समुद्यते।\nमन्त्रोऽयं मन्त्रितो राजन्कुलैरष्टादशावरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2013326, "chapter_id": 1273, "verse_number": "२-१४-३८", "content_sanskrit": "अनारमन्तो निघ्नन्तो महास्त्रैः शत्रुघातिभिः।\nन हन्यामो वयं तस्य त्रिभिर्वर्षशतैर्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2013327, "chapter_id": 1273, "verse_number": "२-१४-३९", "content_sanskrit": "तस्य ह्यमरसङ्काशौ बलेन बलिनां वरौ।\nनामभ्यां हंसडिबिकावशस्त्रनिधनावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2013328, "chapter_id": 1273, "verse_number": "२-१४-४०", "content_sanskrit": "तावुभौ सहितौ वीरौ जरासन्धश्च वीर्यवान्।\nत्रयस्त्रयाणां लोकानां पर्याप्ता इति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2013329, "chapter_id": 1273, "verse_number": "२-१४-४१", "content_sanskrit": "न हि केवलमस्माकं यावन्तोऽन्ये च पार्थिवाः।\nतथैव तेषामासीच्च बुद्धिर्बुद्धिमतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2013330, "chapter_id": 1273, "verse_number": "२-१४-४२", "content_sanskrit": "अष्टादश मया तस्य सङ्ग्रामा रोमहर्षणाः।\nदत्ता न च हतो राजञ्जरासन्धो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2013331, "chapter_id": 1273, "verse_number": "२-१४-४३", "content_sanskrit": "अथ हंस इति ख्यातः कश्चिदासीन्महान्नृपः।\nरामेण स हतस्तत्र सङ्ग्रामेऽष्टादशावरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2013332, "chapter_id": 1273, "verse_number": "२-१४-४४", "content_sanskrit": "हतो हंस इति प्रोक्तस्य केनापि भारत।\nतच्छ्रुत्वा डिबिको राजन्यमुनाम्भस्यमज्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2013333, "chapter_id": 1273, "verse_number": "२-१४-४५", "content_sanskrit": "विना हसेन लोकेऽस्मिन्नाहं जीवितुमुत्सहे।\nइत्येतां मतिमास्थाय डिबिको निधनं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2013334, "chapter_id": 1273, "verse_number": "२-१४-४६", "content_sanskrit": "तथा तु डिबिकं श्रुत्वा हंसः परुपुरञ्जयः।\nप्रपेदे यमुनामेव सोपि तस्यां न्यमज्जत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2013335, "chapter_id": 1273, "verse_number": "२-१४-४७", "content_sanskrit": "तौ स राजा जराजन्धः श्रुत्वा च निधनं गतौ।\nपुरं शून्येन मनसा प्रययौ भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2013336, "chapter_id": 1273, "verse_number": "२-१४-४८", "content_sanskrit": "ततो वयमित्रघ्न तस्मिन्प्रतिगते नृपे।\nपुनरान्दिनः सर्वे मधुरायां वसामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2013337, "chapter_id": 1273, "verse_number": "२-१४-४९", "content_sanskrit": "यदा त्वभ्येत्य पितरं सा वै राजीवलोचना।\nकंसभार्या जरासन्धं दुहिता मागधं नृपम्।\nचोदयत्येव राजेन्द्र पतिव्यसनदुःखिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2013338, "chapter_id": 1273, "verse_number": "२-१४-५०", "content_sanskrit": "पतिघ्नं मे जहीत्येवं पुनः पुनररिन्दम।\nततो वयं महाराज तं मन्त्रं पूर्वमन्त्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2013339, "chapter_id": 1273, "verse_number": "२-१४-५१", "content_sanskrit": "संस्मरन्तो विमनसो व्यपयाता नराधिप।\nपृथक्त्वेन महाराज सङ्क्षिप्य महतीं श्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2013340, "chapter_id": 1273, "verse_number": "२-१४-५२", "content_sanskrit": "पलायामो भयात्तस्य ससुतज्ञातिबान्धवाः।\nइति सञ्चिन्त्य सर्वे स्म प्रतीचीं दिशमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2013341, "chapter_id": 1273, "verse_number": "२-१४-५३", "content_sanskrit": "कुशस्थलीं पुरीं रम्यां रैवतेनोपशोभिताम्।\nततो निवेशं तस्यां च कृतवन्तो वयं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2013342, "chapter_id": 1273, "verse_number": "२-१४-५४", "content_sanskrit": "तथैव दुर्गसंस्कारं देवैरपि दुरासदम्।\nस्त्रियोऽपि यस्यां युध्येयुः किमु वृष्णिमहारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2013343, "chapter_id": 1273, "verse_number": "२-१४-५५", "content_sanskrit": "तस्यां वयममित्रघ्न निवसामोऽकुतोभयाः।\nआलोच्य गिरिमुख्यं तं मागधं तीर्णमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2013344, "chapter_id": 1273, "verse_number": "२-१४-५६", "content_sanskrit": "माधवाः कुरुशार्दूल परां मुदमवाप्नुवन्।\nएवं वयं जरासन्धादभितः कृतकिल्बिषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2013345, "chapter_id": 1273, "verse_number": "२-१४-५७", "content_sanskrit": "सामर्थ्यवन्तः सम्बन्धाद्गोमन्तं समुपाश्रिताः।\nत्रियोजनायतं सद्म त्रिस्कन्धं योजनावधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2013346, "chapter_id": 1273, "verse_number": "२-१४-५८", "content_sanskrit": "योजनान्ते शतद्वारं वीरविक्रमतोरणम्।\nअष्टादशावरैर्नद्धं क्षत्रियैर्युद्धदुर्मदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2013347, "chapter_id": 1273, "verse_number": "२-१४-५९", "content_sanskrit": "अष्टादश सहस्राणि भ्रातृणां सन्ति नः कले।\nआहुकस्य शतं पुत्रा एकैकस्त्रिदशावरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2013348, "chapter_id": 1273, "verse_number": "२-१४-६०", "content_sanskrit": "चारुदेष्णः सह भ्रात्रा चक्रदेवोऽथ सात्यकिः।\nअहं च रोहिणेयश्च साम्बः प्रद्युम्न एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2013349, "chapter_id": 1273, "verse_number": "२-१४-६१", "content_sanskrit": "एवमेते रथाः सप्त राजन्नन्यान्निबोध मे।\nकृतवर्मा ह्यनाधृष्टिः समीकः समिर्तिजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2013350, "chapter_id": 1273, "verse_number": "२-१४-६२", "content_sanskrit": "कङ्कः शङ्कुश्च कुन्तिश्च सप्तैते वै महारथाः।\nप्रद्युम्नश्चानिरुद्धश्च भानुरक्रूरसारणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2013351, "chapter_id": 1273, "verse_number": "२-१४-६३", "content_sanskrit": "निशठश्च गदश्चैव सप्त चैते महारथाः।\nविकमो झिल्लिबभ्रू च उद्धवोऽथ विदूरथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2013352, "chapter_id": 1273, "verse_number": "२-१४-६४", "content_sanskrit": "वसुदेवोग्रसेनौ च सप्तैते मन्त्रिपुङ्गवाः।\nप्रसेनजिच्च यमलो राजराजगुणान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2013353, "chapter_id": 1273, "verse_number": "२-१४-६५", "content_sanskrit": "स्यमन्तको मणिर्यस्य रुक्मं निस्रुवते बहु।\nपुत्रौ चान्धकभोजस्य वृद्धो राजा च ते दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2013354, "chapter_id": 1273, "verse_number": "२-१४-६६", "content_sanskrit": "वज्रसंहनना वीरी वीर्यवन्तो महाबलाः।\nस्मरन्तो मध्यमं देशं वृष्णिवीरा गतज्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2013355, "chapter_id": 1273, "verse_number": "२-१४-६७", "content_sanskrit": "पाण्डवैश्चापि सततं नाथवन्तो वयं नृप।\nसर्वसम्पद्गुणैः सिद्धे तस्मिन्नेवं व्यवस्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2013356, "chapter_id": 1273, "verse_number": "२-१४-६८", "content_sanskrit": "क्षत्रे सम्राजमात्मानं कर्तुमर्हसि भारत।\nदुर्योधनं शान्तनवं द्रोणं द्रौणायनिं कृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2013357, "chapter_id": 1273, "verse_number": "२-१४-६९", "content_sanskrit": "कर्णं च शिशुपालं च रुक्मिणं च धनुर्धरम्।\nएकलव्यं द्रुमं श्वेतं शैब्यं शकुनिमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2013358, "chapter_id": 1273, "verse_number": "२-१४-७०", "content_sanskrit": "एतानजित्वा सङ्ग्रामे कथं शक्नोषि तं क्रतुम्।\nतथैते गौरवेणैव न योत्स्यन्ति नराधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2013359, "chapter_id": 1273, "verse_number": "२-१४-७१", "content_sanskrit": "एकस्तत्र बलोन्मत्तः कर्णो वैकर्तनो वृषा।\nयोत्स्यते स परामर्षी दिव्यास्रबलगर्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2013360, "chapter_id": 1273, "verse_number": "२-१४-७२", "content_sanskrit": "न तु शक्यं जरासन्धे जीवमाने महाबल\nराजसूयस्त्वयाऽवाप्तुमेषा राजन्मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2013361, "chapter_id": 1273, "verse_number": "२-१४-७३", "content_sanskrit": "तेन रुद्धा हि राजानः सर्वे जित्वा गिरिव्रजे।\nकन्दरे पर्वतेन्द्रस्य सिंहेनेव महाद्विपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2013362, "chapter_id": 1273, "verse_number": "२-१४-७४", "content_sanskrit": "स हि राजा जरासन्धो यियक्षुर्वसुधाधिपैः।\nअभिषिक्तः स राजन्यैः सहस्रैरुत चाष्टभिः।\nमहादेवं महात्मानमुमापतिमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2013363, "chapter_id": 1273, "verse_number": "२-१४-७५", "content_sanskrit": "आराध्य तपसोग्रेण निर्जितास्तेन पार्थिवाः।\nप्रतिज्ञायाश्च पारं स गतः पार्थिवसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2013364, "chapter_id": 1273, "verse_number": "२-१४-७६", "content_sanskrit": "स हि निर्जित्य निर्जित्य पार्थिवान्पृतनागतान्।\nपुरमानीय बद्ध्वा च चकार पुरुषव्रजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2013365, "chapter_id": 1273, "verse_number": "२-१४-७७", "content_sanskrit": "वयं चैव महाराज जरासन्धभयात्तदा।\nमधुरा सम्परित्यज्य गता द्वारवतीं पुरीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2013366, "chapter_id": 1273, "verse_number": "२-१४-७८", "content_sanskrit": "यदि त्वेनं महाराज यज्ञं प्राप्तुमभीप्ससि।\nयतस्व तेषां मोक्षाय जरासन्धवधाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2013367, "chapter_id": 1273, "verse_number": "२-१४-७९", "content_sanskrit": "समारम्भो न शक्योऽयमन्यथा कुरुनन्दन।\nराजसूयस्य कार्त्स्न्येन कर्तुं मतिमतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2013368, "chapter_id": 1273, "verse_number": "२-१४-८०", "content_sanskrit": "इत्येषा मे मती राजन्यथा वा मन्यसेऽनघ।\nएवं गते ममाचक्ष्व स्वयं निश्चित्य हेतुभिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2013369, "chapter_id": 1273, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि मन्त्रपर्वणि चतुर्दशोऽध्यायः॥ १४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]