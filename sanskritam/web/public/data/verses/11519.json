[{"id": 50013748, "chapter_id": 11519, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50013749, "chapter_id": 11519, "verse_number": "2", "content_sanskrit": "तदा देवर्षिगन्धर्वा ब्रह्मेशानपुरोगमाः। मुमुचुः कुसुमासारं शंसन्तः कर्म तद्धरेः॥ ८/४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50013750, "chapter_id": 11519, "verse_number": "3", "content_sanskrit": "नेदुर्दुन्दुभयो दिव्या गन्धर्वा ननृतुर्जगुः। ऋषयश्चारणाः सिद्धास्तुष्टुवुः पुरुषोत्तमम्॥ ८/४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50013751, "chapter_id": 11519, "verse_number": "4", "content_sanskrit": "योऽसौ ग्राहः स वै सद्यः परमाश्चर्यरूपधृक्। मुक्तो देवलशापेन हूहू गन्धर्वसत्तमः॥ ८/४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50013752, "chapter_id": 11519, "verse_number": "5", "content_sanskrit": "प्रणम्य शिरसाऽधीशमुत्तमश्लोकमव्ययम्। अगायत यशोधाम कार्तन्यगुणसत्कथम्॥ ८/४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50013753, "chapter_id": 11519, "verse_number": "6", "content_sanskrit": "सोऽनुकम्पित ईशेन परिक्रम्य प्रणम्य तम्। लोकस्य पश्यतो लोकं स्वमगान्मुक्तकिल्बिषः॥ ८/४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50013754, "chapter_id": 11519, "verse_number": "7", "content_sanskrit": "गजेन्द्रो भगवत्स्पर्शाद् विमुक्तोऽज्ञानबन्धनात्। प्राप्तो भगवतो रूपं पीतवासाश्चतुर्भुजः॥ ८/४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50013755, "chapter_id": 11519, "verse_number": "8", "content_sanskrit": "स वै पूर्वमभूद्राजा पाण्ड्यो द्रमिळसत्तमः१। इन्द्रद्युम्न इति ख्यातो विष्णुव्रतपरायणः॥ ८/४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50013756, "chapter_id": 11519, "verse_number": "9", "content_sanskrit": "स एकदाऽऽराधनकाल आत्मवान् गृहीतमौनव्रत ईश्वरं हरिम्। जटाधरस्तापस आप्लुतोऽच्युतं समर्चयामास कुलाचलाश्रयः॥ ८/४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50013757, "chapter_id": 11519, "verse_number": "10", "content_sanskrit": "यदृच्छया तत्र महायशा मुनिः समागमच्छिष्यगणैः परिश्रितः। तं वीक्ष्य तूष्णीमकृतार्हणादिकं रहस्युपासीनमृषिश्चुकोप ह॥ ८/४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50013758, "chapter_id": 11519, "verse_number": "11", "content_sanskrit": "तस्मा इमं शापमदादसाधुरयं दुरात्माऽकृतबुद्धिरद्य। मद्धेळनात् प्राविशतां तमिस्रं यथा गजः स्तब्धमतिः सदोषः॥ ८/४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50013759, "chapter_id": 11519, "verse_number": "12", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50013760, "chapter_id": 11519, "verse_number": "13", "content_sanskrit": "एवं शप्त्वा गतोऽगस्त्यो भगवान् नृप सानुगः। इन्द्रद्युम्नोऽपि राजर्षिर्दिष्टं तदुपधारयन्॥ ८/४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50013761, "chapter_id": 11519, "verse_number": "14", "content_sanskrit": "आपन्नः कौञ्जरीं योनिमात्मस्मृतिविनाशनीम्। हर्यर्चनानुभावेन यद् गजत्वेऽप्यनुस्मृतिः॥ ८/४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50013762, "chapter_id": 11519, "verse_number": "15", "content_sanskrit": "एवं विमोक्ष्य गजयूथपमब्जनाभस्तेनापि पार्षदगतिं गमितेन युक्तः। गन्धर्वसिद्धविबुधैरुपगीयमानकर्माऽद्भुतं स्वभुवनं गरुडासनोऽगात्॥ ८/४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50013763, "chapter_id": 11519, "verse_number": "16", "content_sanskrit": "एवं महाराज तवेरितो मया कृष्णानुभावो गजराजमोक्षणम्। र्स्वग्यं यशस्यं कलिकल्मषापहं दुःस्वप्ननाशं कुरुवर्य शृण्वताम्॥ ८/४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50013764, "chapter_id": 11519, "verse_number": "17", "content_sanskrit": "अथानुकार्तयन्त्येतच्छ्रेयस्कामा द्विजातयः। शुचयः प्रातरुत्थाय दुःस्वप्नाद्युपशान्तये॥ ८/४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50013765, "chapter_id": 11519, "verse_number": "18", "content_sanskrit": "इदमाह हरिः प्रीतो गजेन्द्रं कुरुसत्तम। शृण्वतां सर्वभूतानां सर्वभूतमयो विभुः॥ ८/४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50013766, "chapter_id": 11519, "verse_number": "19", "content_sanskrit": "श्रीभगवानुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50013767, "chapter_id": 11519, "verse_number": "20", "content_sanskrit": "ये मां त्वां च सरश्चेदं गिरिकन्दरकाननम्। वेत्रकाचकवेणूनां गुल्मानि सुरपादपान्॥ ८/४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50013768, "chapter_id": 11519, "verse_number": "21", "content_sanskrit": "शृङ्गाणीमानि धिष्ण्यानि ब्रह्मणो मे शिवस्य च। क्षीरोदं मे प्रियं धाम श्वेतद्वीपं च भास्वरम्॥ ८/४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50013769, "chapter_id": 11519, "verse_number": "22", "content_sanskrit": "श्रीवत्सं कौस्तुभं मालां गदां कौमोदकां मम। सुदर्शनं पाञ्चजन्यं सुपर्णं पतगेश्वरम्॥ ८/४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50013770, "chapter_id": 11519, "verse_number": "23", "content_sanskrit": "शेषं च मत्कलां सूक्ष्मां श्रियं देवीं मदाश्रयाम्। ब्रह्माणं नारदमृषिं भवं प्रह्लादमेव च॥ ८/४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50013771, "chapter_id": 11519, "verse_number": "24", "content_sanskrit": "मत्स्यकूर्मवराहाद्यैरवतारैः कृतानि मे। कर्माण्यनन्तपुण्यानि सूर्यसोमहुताशनान्॥ ८/४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50013772, "chapter_id": 11519, "verse_number": "25", "content_sanskrit": "प्रणवं सत्यमव्यक्तं गोविप्रान् धर्ममक्षयम्। दाक्षायणीं धर्मपत्नीं सोमकश्यपयोरपि॥ ८/४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50013773, "chapter_id": 11519, "verse_number": "26", "content_sanskrit": "गङ्गां सरस्वतीं नन्दां काळिन्दीं सितवारणम्। ध्रुवं ब्रह्मऋषीन् सप्त पुण्यश्लोकांश्च मानवान्॥ ८/४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50013774, "chapter_id": 11519, "verse_number": "27", "content_sanskrit": "उत्थायापररात्रान्ते प्रयताः सुसमाहिताः। स्मरन्ति मम रूपाणि मुच्यन्ते तेंऽहसोऽखिलात्॥ ८/४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50013775, "chapter_id": 11519, "verse_number": "28", "content_sanskrit": "ये मां स्तुवन्त्यनेनाङ्ग प्रतिबुद्ध्य निशात्यये। तेषां प्राणात्ययेऽहं वै ददामि विमलां गतिम्॥ ८/४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50013776, "chapter_id": 11519, "verse_number": "29", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50013777, "chapter_id": 11519, "verse_number": "30", "content_sanskrit": "इत्यादिश्य हृषीकेशः प्राध्माय जलजोत्तमम्। हर्षयन् विबुधानीकमारुरोह खगाधिपम्॥ ८/४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50013778, "chapter_id": 11519, "verse_number": "31", "content_sanskrit": "इति श्रीमद्भागवते अष्टमस्कन्धे चतुर्थोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]