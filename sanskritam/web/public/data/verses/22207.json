[{"id": 7002207000, "chapter_id": 22207, "verse_number": "२५२-१", "content_sanskrit": "अग्निरुवाच ।\nभ्रान्तमुद् भ्रान्तमाविद्धमाप्लुतं विप्लुतं सृतं ।\nसम्पातं समुदीशञ्च श्येनपातमथाकुलं ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002207001, "chapter_id": 22207, "verse_number": "२५२-२", "content_sanskrit": "उद्धूतमवधूतञ्च सव्यं दक्षिणमेव च ।\nअनालक्षितविस्फोटौ करालेन्द्रमहासखौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002207002, "chapter_id": 22207, "verse_number": "२५२-३", "content_sanskrit": "विकरालनिपातौ च विभीषणभयानकौ ।\nसमग्रार्द्धतीयांशपादपादार्द्धवारिजाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002207003, "chapter_id": 22207, "verse_number": "२५२-४", "content_sanskrit": "प्रात्यालीढमथालीढं वराहं लुलितन्तथा ।\nइति द्वात्रिंशतो ज्ञेयाः खड्गचर्मविधौ रणे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002207004, "chapter_id": 22207, "verse_number": "२५२-५", "content_sanskrit": "परवृत्तमपावृत्तं गृहीतं लघुसञ्ज्ञितं ।\nऊद्र्ध्वात् क्षैप्तमधः क्षिप्तं सन्धारितविधारितं ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002207005, "chapter_id": 22207, "verse_number": "२५२-६", "content_sanskrit": "श्येनपातं गजपानं ग्राहग्राह्यन्तथैव च ।\nएवमेकादशविधा ज्ञेयाः पाशविधा रणाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002207006, "chapter_id": 22207, "verse_number": "२५२-७", "content_sanskrit": "ऋज्वायतं विशालञ्च तिर्य्यग्भ्रामितमेव च ।\nपञ्चकर्म विनिर्द्दिष्टं व्यस्ते पाशे महात्मभिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002207007, "chapter_id": 22207, "verse_number": "२५२-८", "content_sanskrit": "छेदनं भेदनं पातो भ्रमणं शयनं तथा ।\nविकर्त्तनं कर्त्तऩञ्च चक्रकर्मेदमेव च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002207008, "chapter_id": 22207, "verse_number": "२५२-९", "content_sanskrit": "आस्फोटः क्ष्वेडनं भेदस्त्रासान्दोलितकौ तथा ।\nशूलकर्माणि जानीहि षष्ठमाघातसञ्ज्ञितं ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002207009, "chapter_id": 22207, "verse_number": "२५२-१०", "content_sanskrit": "दृष्टिघातं भुजाघातं पार्श्वघातं द्विजोत्तम ।\nऋजुपक्षेषुणा पातं तोमरस्य प्रकीर्त्तितं ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002207010, "chapter_id": 22207, "verse_number": "२५२-११", "content_sanskrit": "आहतं विप्र गोमूत्रप्रभूतङ्कमलासनं ।\nततोर्द्धगात्रं नमितं वामदक्षिणमेव च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002207011, "chapter_id": 22207, "verse_number": "२५२-१२", "content_sanskrit": "आवृत्तञ्च चपरावृत्तं पादोद्धतमवप्लुतं ।\nहंसमर्द्दं विमर्दञ्च गदाकर्म प्रकीर्त्तितं ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002207012, "chapter_id": 22207, "verse_number": "२५२-१३", "content_sanskrit": "करालमवघातञ्च दंशोपप्लुतमेव च ।\nक्षिप्तहस्तं स्थितं शून्यं परशोस्तु विनिर्दिशेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002207013, "chapter_id": 22207, "verse_number": "२५२-१४", "content_sanskrit": "ताडनं छेदनं विप्र तथा चूर्णनमेव च ।\nमुद्गरस्य तु कर्माणि तथा प्लवनघातनं ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002207014, "chapter_id": 22207, "verse_number": "२५२-१५", "content_sanskrit": "सं श्रान्तमथ विश्रान्तं गोविसर्गं सुदुर्द्धरं ।\nभिन्दिपालस्य कर्माणि लगुडस्य च तान्यपि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002207015, "chapter_id": 22207, "verse_number": "२५२-१६", "content_sanskrit": "अन्त्यं मध्यं परावृत्तं निदेशान्तं द्विजोत्तम ।\nवज्रस्यैतानि कर्माणि लगुडस्य च तान्यपि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002207016, "chapter_id": 22207, "verse_number": "२५२-१७", "content_sanskrit": "हरणं छेदनं घातो बलोद्धारणमायतं ।\nकृपाणकर्म निर्दिष्टं पातनं स्फोटनं तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002207017, "chapter_id": 22207, "verse_number": "२५२-१८", "content_sanskrit": "त्रासनं रक्षणं घातो बलोद्धरणमायतम् ।\nक्षेपणीकर्म निर्दिष्टं यन्त्रकर्मैतदेव तु ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002207018, "chapter_id": 22207, "verse_number": "२५२-१९", "content_sanskrit": "सन्त्यागमवदंशश्च वराहोद्धूतकं तथा ।\nहस्तावहस्तमालीनमेकहस्तावहस्तके ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002207019, "chapter_id": 22207, "verse_number": "२५२-२०", "content_sanskrit": "द्विहस्तवाहुपाशे च कटिरेचितकोद्गते ।\nउरोललाटघाते च भुजाविधमनन्तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002207020, "chapter_id": 22207, "verse_number": "२५२-२१", "content_sanskrit": "द्विहस्तवाहुपाशे च कटिरेचिककोद्गते ।\nगात्रसंश्लेषणं शान्तं तथा गात्रविपर्य्ययः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002207021, "chapter_id": 22207, "verse_number": "२५२-२२", "content_sanskrit": "ऊद्र्ध्वप्र्हारं घातञ्च गोमूत्रं सव्यदक्षिणे ।\nपारकन्तारकं दण्डं४ करवीरन्धमाकुलं ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002207022, "chapter_id": 22207, "verse_number": "२५२-२३", "content_sanskrit": "तिर्य्यग्बन्धमपामार्गं५ भीमवेगं सुदर्शनं ।\nसिंहाक्रान्तं गजाक्रान्तं गर्द्दभाक्रान्तमेव च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002207023, "chapter_id": 22207, "verse_number": "२५२-२४", "content_sanskrit": "गदाकर्माणि जानीयान्नियुद्धस्याथ कर्म च ।\nआकर्षणं विकषञ्च बाहूनां मूलमेव च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002207024, "chapter_id": 22207, "verse_number": "२५२-२५", "content_sanskrit": "ग्रीवाविपरिवर्त्तञ्च पृष्ठभङ्गं सुदारुणं ।\nपर्य्यासनविपर्य्यासौ पशुमारमजाविकं ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002207025, "chapter_id": 22207, "verse_number": "२५२-२६", "content_sanskrit": "पादप्रहारमास्फोटं ककटिरेचितकन्तथा ।\nगात्रश्लेषं स्कन्धगतं महीव्याजनमेव च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002207026, "chapter_id": 22207, "verse_number": "२५२-२७", "content_sanskrit": "उरोललाटघातञ्च विस्पष्टकरणन्तथा ।\nउद्धूतमवधूतञ्च तिर्य्यङ्मार्गगतं तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002207027, "chapter_id": 22207, "verse_number": "२५२-२८", "content_sanskrit": "गजस्कन्धमवक्षेपमपराङ्मुखमेव च ।\nदेवमार्गमधोमार्गममार्गगमनाकुलं ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002207028, "chapter_id": 22207, "verse_number": "२५२-२९", "content_sanskrit": "यष्टिघातमवक्षेपो वसुधादारणन्तथा ।\nजानुबन्धं भुजाबन्धं गात्रबन्धं सुदारुणं ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002207029, "chapter_id": 22207, "verse_number": "२५२-३०", "content_sanskrit": "विपृष्ठं सोदकं शुभ्रं भुजावेष्टितमेव च ।\nसन्नद्धैः संयुगे भाव्यं सशस्त्रैस्तैर्गजादिभिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002207030, "chapter_id": 22207, "verse_number": "२५२-३१", "content_sanskrit": "वराङ्कुशधरौ चोभौ एको ग्रीवागतोऽपरः ।\nस्कन्धगौ द्वौ च धानुष्कौ द्वौ च खड्गधरौगजे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002207031, "chapter_id": 22207, "verse_number": "२५२-३२", "content_sanskrit": "रथे रणे गजे चैव तुरङ्गाणां त्रयं भवेत् ।\nधानुष्काणान्त्रयं प्रोक्तं रक्षआर्थे तुरगस्य च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002207032, "chapter_id": 22207, "verse_number": "२५२-३३", "content_sanskrit": "धन्विनो रक्षणार्थाय चर्मिणन्तु६ नियोजयेत् ।\nस्वमन्त्रैः शस्त्रमभ्यर्च्य शास्त्रान्त्रैलोक्यमोहनं ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]