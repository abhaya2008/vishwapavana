[{"id": 6000083000, "chapter_id": 10083, "verse_number": null, "content_sanskrit": "अथ एकोनविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "चरममश्वमेधं कुर्वाणे पृथौ इन्द्रेण असूयया यज्ञियाश्वहरणम्", "range": null}]}, {"id": 6000083001, "chapter_id": 10083, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.001.m4a", "display_order": 2}, {"id": 6000083002, "chapter_id": 10083, "verse_number": "४-१९-१", "content_sanskrit": "अथादीक्षत राजर्षिर्हयमेधशतेन सः।\nब्रह्मावर्ते मनोः क्षेत्रे यत्र प्राची सरस्वती॥ ४/१९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.002.m4a", "display_order": 3, "topics": [{"text": "पृथुचक्रवर्तिना शताश्वमेधकरणारम्भः", "range": "१–९"}]}, {"id": 6000083003, "chapter_id": 10083, "verse_number": "४-१९-२", "content_sanskrit": "तदभिप्रेत्य भगवान् कर्मातिशयमात्मनः।\nशतक्रतुर्न ममृषे पृथोर्यज्ञमहोत्सवम्॥ ४/१९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.003.m4a", "display_order": 4}, {"id": 6000083004, "chapter_id": 10083, "verse_number": "४-१९-३", "content_sanskrit": "यत्र यज्ञपतिः साक्षाद् भगवान् हरिरीश्वरः।\nअन्वाहूयत सर्वात्मा सर्वलोकगुरुः प्रभुः॥ ४/१९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.004.m4a", "display_order": 5}, {"id": 6000083005, "chapter_id": 10083, "verse_number": "४-१९-४", "content_sanskrit": "अन्वितौ ब्रह्मशर्वाभ्यां लोकपालैः सहानुगैः।\nउपगीयमानो गन्धर्वैर्मुनिभिश्चाप्सरोगणैः॥ ४/१९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.005.m4a", "display_order": 6}, {"id": 6000083006, "chapter_id": 10083, "verse_number": "४-१९-५", "content_sanskrit": "सिद्धा विद्याधरा दैत्या दानवा गुह्यकादयः।\nसुनन्दनन्दप्रमुखाः पार्षदप्रवरा हरेः॥ ४/१९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.006.m4a", "display_order": 7}, {"id": 6000083007, "chapter_id": 10083, "verse_number": "४-१९-६", "content_sanskrit": "कपिलो नारदो दत्तो योगेशाः सनकादयः।\nतमन्वीयुर्भागवता ये च तत्सेवनोत्सुकाः॥ ४/१९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.007.m4a", "display_order": 8}, {"id": 6000083008, "chapter_id": 10083, "verse_number": "४-१९-७", "content_sanskrit": "यत्र धर्मदुघा भूमिः सर्वकामदुघा मही।\nदोग्धि स्माभीप्सितानर्थान् यजमानस्य भारत॥ ४/१९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.008.m4a", "display_order": 9}, {"id": 6000083009, "chapter_id": 10083, "verse_number": "४-१९-८", "content_sanskrit": "ऊहुः सर्वरसान् नद्यः क्षीरदध्यन्नगोरसान्।\nतरवो भूरिवर्ष्माणः प्रासूयन्त मधुच्युतः॥ ४/१९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.009.m4a", "display_order": 10}, {"id": 6000083010, "chapter_id": 10083, "verse_number": "४-१९-९", "content_sanskrit": "सिन्धवो रत्ननिकरान् गिरयोऽन्नं चतुर्विधम्।\nउपायनान्युपाजह्रुः सर्वे लोकाः सपालकाः॥ ४/१९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.010.m4a", "display_order": 11}, {"id": 6000083011, "chapter_id": 10083, "verse_number": "४-१९-१०", "content_sanskrit": "इति चाधोक्षजेशस्य पृथोर्यज्ञमहोदयम्।\nअसूयन् भगवानिन्द्रः प्रतिघातमचीकरत्॥ ४/१९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.011.m4a", "display_order": 12}, {"id": 6000083012, "chapter_id": 10083, "verse_number": "४-१९-११", "content_sanskrit": "चरमेणाश्वमेधेन यजमाने यजुष्पतिम्।\nवैन्ये यज्ञपशुं स्पर्धन्नपोवाह तिरोहितः॥ ४/१९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.012.m4a", "display_order": 13}, {"id": 6000083013, "chapter_id": 10083, "verse_number": "४-१९-१२", "content_sanskrit": "तमत्रिर्भगवानैक्षत् त्वरमाणं विहायसा।\nआमुक्तमिव पाषण्डं योऽधर्मे धर्मविभ्रमः॥ ४/१९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.013.m4a", "display_order": 14}, {"id": 6000083014, "chapter_id": 10083, "verse_number": "४-१९-१३", "content_sanskrit": "अत्रिणा चोदितो हन्तुं पृथुपुत्रो महारथः।\nअन्वधावत संक्रुद्धस्तिष्ठ तिष्ठेति चाब्रवीत्॥ ४/१९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.014.m4a", "display_order": 15}, {"id": 6000083015, "chapter_id": 10083, "verse_number": "४-१९-१४", "content_sanskrit": "तं तादृशाकृतिं वीक्ष्य मेनेऽधर्मशरीरिणम्।\nजटिलं भस्मना छन्नं तस्मै बाणं न मुञ्चति॥ ४/१९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.015.m4a", "display_order": 16}, {"id": 6000083016, "chapter_id": 10083, "verse_number": "४-१९-१५", "content_sanskrit": "पापान्निवृत्तं वै भूयो हन्तवेऽत्रिरचोदयत्।\nजहि यज्ञहनं तात महेन्द्रं विबुधाधिपम्॥ ४/१९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.016.m4a", "display_order": 17}, {"id": 6000083017, "chapter_id": 10083, "verse_number": "४-१९-१६", "content_sanskrit": "एवं वैन्यसुतः प्रोक्तस्त्वरमाणं विहायसा।\nअन्वधावदतिक्रुद्धो रावणं गृध्रराडिव॥ ४/१९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.017.m4a", "display_order": 18}, {"id": 6000083018, "chapter_id": 10083, "verse_number": "४-१९-१७", "content_sanskrit": "सोऽश्वं रूपं च तद्धित्वा तस्थावन्तर्हितः स्वराट्।\nधीरः स्वपशुमादाय पितुर्यज्ञमुपेयिवान्॥ ४/१९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.018.m4a", "display_order": 19}, {"id": 6000083019, "chapter_id": 10083, "verse_number": "४-१९-१८", "content_sanskrit": "तत् तस्य चाद्भुतं कर्म विलक्ष्य परमर्षयः।\nनामधेयं ददुस्तस्मै विजिताश्व इति प्रभो॥ ४/१९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.019.m4a", "display_order": 20}, {"id": 6000083020, "chapter_id": 10083, "verse_number": "४-१९-१९", "content_sanskrit": "उपसृज्य तमस्तीव्रं जहाराश्वं पुनर्हरिः।\nचषालयूपयोश्छन्नो हिरण्यरशनं विभुः॥ ४/१९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.020.m4a", "display_order": 21}, {"id": 6000083021, "chapter_id": 10083, "verse_number": "४-१९-२०", "content_sanskrit": "अत्रिः संदर्शयामास त्वरमाणं विहायसा।\nकपालखट्वाङ्गधरं वीरो नैनमबोधत॥ ४/१९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.021.m4a", "display_order": 22}, {"id": 6000083022, "chapter_id": 10083, "verse_number": "४-१९-२१", "content_sanskrit": "अत्रिणा चोदितस्तस्मै सन्दधे विशिखं रुषा।\nसोऽश्वं रूपं च तद्धित्वा तस्थावन्तर्हितः स्वराट्॥ ४/१९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.022.m4a", "display_order": 23}, {"id": 6000083023, "chapter_id": 10083, "verse_number": "४-१९-२२", "content_sanskrit": "वीरश्चाश्वमुपादाय पितृयज्ञमथाव्रजत्।\nतदवद्यं हरे रूपं जगृहुर्ज्ञानदुर्बलाः॥ ४/१९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.023.m4a", "display_order": 24}, {"id": 6000083024, "chapter_id": 10083, "verse_number": "४-१९-२३", "content_sanskrit": "यानि रूपाणि जगृहे इन्द्रो हयजिहीर्षया।\nतानि पापस्य खण्डानि लिङ्गं खण्डमिहोच्यते॥ ४/१९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.024.m4a", "display_order": 25}, {"id": 6000083025, "chapter_id": 10083, "verse_number": "४-१९-२४", "content_sanskrit": "एवमिन्द्रे हरत्यश्वं वैन्ययज्ञजिघांसया।\nतद्गृहीतविसृष्टेषु पाषण्डेषु मतिर्नृणाम्॥ ४/१९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.025.m4a", "display_order": 26}, {"id": 6000083026, "chapter_id": 10083, "verse_number": "४-१९-२५", "content_sanskrit": "धर्म इत्युपधर्मेषु नग्नरक्तपटादिषु।\nप्रायेण सज्जते भ्रान्त्या पेशलेषु च वाग्मिषु॥ ४/१९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.026.m4a", "display_order": 27}, {"id": 6000083027, "chapter_id": 10083, "verse_number": "४-१९-२६", "content_sanskrit": "तदभिज्ञाय भगवान् पृथुः पृथुपराक्रमः।\nइन्द्राय कुपितो बाणमादत्तोद्यतकार्मुकः॥ ४/१९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.027.m4a", "display_order": 28}, {"id": 6000083028, "chapter_id": 10083, "verse_number": "४-१९-२७", "content_sanskrit": "तमृत्विजः शक्रवधाभिसन्धितं विचक्ष्य दुष्प्रेक्ष्यमसह्यरंहसा।\nनिवारयामासुरहो महामते न युज्यतेऽत्रान्यवधोऽप्रचोदितः॥ ४/१९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.028.m4a", "display_order": 29}, {"id": 6000083029, "chapter_id": 10083, "verse_number": "४-१९-२८", "content_sanskrit": "वयं मरुत्वन्तमिहार्थनाशनं ह्वयामहे त्वच्छ्रवसा हतत्विषम्।\nअयातयामोपहवैस्तमग्नये प्रसह्य राजन् जुहवाम तेऽहितम्॥ ४/१९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.029.m4a", "display_order": 30}, {"id": 6000083030, "chapter_id": 10083, "verse_number": "४-१९-२९", "content_sanskrit": "इत्यामन्त्र्य क्रतुपतिं विदुरास्यर्त्विजो रुषा।\nस्रुङ्न्यस्तं जुह्वतोऽभ्येत्य स्वयंभूः प्रत्यषेधत॥ ४/१९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.030.m4a", "display_order": 31}, {"id": 6000083031, "chapter_id": 10083, "verse_number": "४-१९-३०", "content_sanskrit": "न वध्यो भवतामिन्द्रो यद् यज्ञो भगवत्तनुः।\nतं जिघांसत यज्ञे न यस्येष्टास्तनवः सुराः॥ ४/१९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.031.m4a", "display_order": 32, "topics": [{"text": "इन्द्रं हन्तुं प्रवृत्तस्य पृथोः ब्रह्मणा निवारणम्", "range": "३०–४१"}]}, {"id": 6000083032, "chapter_id": 10083, "verse_number": "४-१९-३१", "content_sanskrit": "तदिदं पश्यत महद् धर्मव्यतिकरं द्विजाः।\nइन्द्रेणानुष्ठितं राज्ञः कर्मैतद्धि जिघांसया॥ ४/१९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.032.m4a", "display_order": 33}, {"id": 6000083033, "chapter_id": 10083, "verse_number": "४-१९-३२", "content_sanskrit": "पृथुकीर्तिः पृथो भूयास्त्वं ह्येकोनशतक्रतुः।\nअलं ते क्रतुभिः शिष्टैर्यद् भवान् मोक्षधर्मवित्॥ ४/१९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.033.m4a", "display_order": 34}, {"id": 6000083034, "chapter_id": 10083, "verse_number": "४-१९-३३", "content_sanskrit": "नैवात्मने महेन्द्राय रोषमाहर्तुमर्हसि।\nउभावपि हि भद्रं ते उत्तमश्लोकविग्रहौ॥ ४/१९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.034.m4a", "display_order": 35}, {"id": 6000083035, "chapter_id": 10083, "verse_number": "४-१९-३४", "content_sanskrit": "माऽस्मिन् महाराज कृथाः स्म चिन्तां निशामयास्मद्वच आदृतात्मा।\nयद् ध्यायतो दैवहतं तु कर्तुं मनोऽतिकष्टं विशते तमोऽन्धम्॥ ४/१९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.035.m4a", "display_order": 36}, {"id": 6000083036, "chapter_id": 10083, "verse_number": "४-१९-३५", "content_sanskrit": "क्रतुर्विरमतामेष देवेषु दुरवग्रहः।\nधर्मव्यतिकरो यत्र पाषण्डैरिन्द्रनिर्मितैः॥ ४/१९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.036.m4a", "display_order": 37}, {"id": 6000083037, "chapter_id": 10083, "verse_number": "४-१९-३६", "content_sanskrit": "एभिरिन्द्रोपसंसृष्टैः पाखण्डैर्हारिभिर्जनम्।\nह्रियमाणं विचक्ष्वैतद् यस्ते यज्ञध्रुगश्वमुट्॥ ४/१९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.037.m4a", "display_order": 38}, {"id": 6000083038, "chapter_id": 10083, "verse_number": "४-१९-३७", "content_sanskrit": "भवान् परित्रातुमिहावतीर्णो धर्मं च नानासमयानुरूपम्।\nवेनापचारादवलुप्तमद्य तद्देहतो विष्णुकलाऽसि वैन्य॥ ४/१९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.038.m4a", "display_order": 39}, {"id": 6000083039, "chapter_id": 10083, "verse_number": "४-१९-३८", "content_sanskrit": "स त्वं विमृश्याभिभवं प्रजापतेः सङ्कल्पितं विश्वसृजोऽतिपीपृहि।\nऐन्द्रीं च मायामुपधर्ममातरं प्रचण्डपाखण्डपथं प्रभो जहि॥ ४/१९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.039.m4a", "display_order": 40}, {"id": 6000083040, "chapter_id": 10083, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.040.m4a", "display_order": 41}, {"id": 6000083041, "chapter_id": 10083, "verse_number": "४-१९-३९", "content_sanskrit": "इत्थं स लोकगुरुणा समादिष्टो विशांपतिः।\nतथा च कृतवान् सख्यं मघोनाऽपि च सन्दधे॥ ४/१९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.041.m4a", "display_order": 42}, {"id": 6000083042, "chapter_id": 10083, "verse_number": "४-१९-४०", "content_sanskrit": "कृतावभृथ्यस्नानाय पृथवे भूरिकर्मणे।\nवरान् ददुस्ते वरदा ये तद्बर्हिषि तर्पिताः॥ ४/१९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.042.m4a", "display_order": 43}, {"id": 6000083043, "chapter_id": 10083, "verse_number": "४-१९-४१", "content_sanskrit": "विप्राः सत्याशिषस्तुष्टाः श्रद्धया लब्धदक्षिणाः।\nआशिषो युयुजुः क्षत्तरादिराजाय सत्कृताः॥ ४/१९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.043.m4a", "display_order": 44}, {"id": 6000083044, "chapter_id": 10083, "verse_number": "४-१९-४२", "content_sanskrit": "तथाऽऽहूता महाबाहो सर्व एव समागताः।\nपूजिता दानमानाभ्यां पितृदेवर्षिमानवाः॥ ४/१९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_019/BhP_04.019.044.m4a", "display_order": 45}, {"id": 6000083045, "chapter_id": 10083, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे एकोनविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]