[{"id": 7006518000, "chapter_id": 26518, "verse_number": "३-५७-१", "content_sanskrit": "देवासुरसंग्रामे कुजम्भस्य, असिलोम्नः वृत्रासुरस्य च उत्कर्षस्य वर्णनं, हरेः अश्विनीकुमाराभ्यां च पराजयः वैशम्पायन उवाच ततः सर्वाणि सैन्यानि देवराजस्य शासनात् ।\nअभ्यद्रवन्त दितिजान्नदन्तो भैरवान् रवान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006518001, "chapter_id": 26518, "verse_number": "३-५७-२", "content_sanskrit": "तं बलौघमपर्यन्तं देवानां सुदुरासदम् ।\nरथनागाश्वकलिलं शङ्खदुन्दुभिनिःस्वनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006518002, "chapter_id": 26518, "verse_number": "३-५७-३", "content_sanskrit": "आपतन्तं सुदुष्पारं रजसा सर्वतोवृतम् ।\nसैन्यसागरमक्षोभ्यं वेलेव मकरालयम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006518003, "chapter_id": 26518, "verse_number": "३-५७-४", "content_sanskrit": "तदाश्चर्यमपश्यन्त अश्रद्धेयमिवाद्भुतम् ।\nउदीर्णां पृतनां सर्वां साश्वां सरथकुञ्जराम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006518004, "chapter_id": 26518, "verse_number": "३-५७-५", "content_sanskrit": "आवार्य समरेऽतिष्ठत् कुजम्भस्तरसा बली ।\nसैन्यार्णवं देवतानां गिरिर्मेरुरिवाचलः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006518005, "chapter_id": 26518, "verse_number": "३-५७-६", "content_sanskrit": "अनीकिनीं कुजम्भस्तु गदया स न्यवारयत् ।\nसा तथा वारिता सेना विह्वलाभून्निरुद्यमा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006518006, "chapter_id": 26518, "verse_number": "३-५७-७", "content_sanskrit": "तस्मिंस्तथा वर्तमाने सम्प्रहारे सुदारुणे ।\nअसिलोमा तु बलवान् दानवो दानवाधिपः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006518007, "chapter_id": 26518, "verse_number": "३-५७-८", "content_sanskrit": "देवसैन्यस्य सर्वस्य धूमकेतुरिवोत्थितः ।\nतपत्यर्क इवामोघः सुरसैन्यानि संयुगे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006518008, "chapter_id": 26518, "verse_number": "३-५७-९", "content_sanskrit": "सहस्ररश्मिप्रतिमो दानवस्य रथोत्तमः ।\nशरैर्मेघ इवावर्षद् देवानीकं प्रतापवान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006518009, "chapter_id": 26518, "verse_number": "३-५७-१०", "content_sanskrit": "शरौघरश्मिभिर्दीप्तैः प्रतप्तो घोरविक्रमः ।\nरौद्रः क्रूरो दुराधर्षो दुरापो ध्वजिनीमुखे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006518010, "chapter_id": 26518, "verse_number": "३-५७-११", "content_sanskrit": "युध्यते दैवतैः सार्धं ग्रसमान इव प्रभुः ।\nउग्रेषुरुग्रवदनः समारुह्य महागजम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006518011, "chapter_id": 26518, "verse_number": "३-५७-१२", "content_sanskrit": "सुराणामुत्तमाङ्गानि प्रचिनोति महाबलः ।\nग्रसन् दैवतसैन्यानि शरदंष्ट्रः प्रतापवान् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006518012, "chapter_id": 26518, "verse_number": "३-५७-१३", "content_sanskrit": "असिजिह्वश्चक्रहस्तश्चापव्यात्ताननोऽसुरः ।\nपरश्वधनखः श्रीमान् मृदङ्गापूरितध्वनिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006518013, "chapter_id": 26518, "verse_number": "३-५७-१४", "content_sanskrit": "तिष्ठते दानवश्रेष्ठः संयुगे व्याघ्रवद् बली ।\nमौर्वीघोषस्तनयित्नुः पृषत्कः प्रथितो महान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006518014, "chapter_id": 26518, "verse_number": "३-५७-१५", "content_sanskrit": "धनुर्विद्युद्गणश्चापो महामेघ इवापरः ।\nइष्वस्त्रसागरो घोरो बाहुग्राहो दुरासदः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006518015, "chapter_id": 26518, "verse_number": "३-५७-१६", "content_sanskrit": "कार्मुकोर्मितरङ्गौघो बाणावर्तमहाह्रदः ।\nगदासिमकरो रौद्रो ज्यावेलः शिक्षयोद्धतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006518016, "chapter_id": 26518, "verse_number": "३-५७-१७", "content_sanskrit": "पदातिमीनः सुमहान् गर्जितोत्क्रुष्टघोषवान् ।\nहयान्गजान्पदातींश्च रथांश्च सहसा बहून् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006518017, "chapter_id": 26518, "verse_number": "३-५७-१८", "content_sanskrit": "न्यमज्जयत समरे परवीरान् महारथान् ।\nआप्लावयत् स देवौघान् दारुणो दानवेश्वरः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006518018, "chapter_id": 26518, "verse_number": "३-५७-१९", "content_sanskrit": "प्रावर्तत युधि श्रीमान्युधि श्रेष्ठो युधि स्थिरः ।\nअपश्यंस्त्रिदशाः सर्वे शुद्धजाम्बूनदप्रभम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006518019, "chapter_id": 26518, "verse_number": "३-५७-२०", "content_sanskrit": "सन्नद्धं तत्र युध्यन्तं ज्वलन्तमिव पावकम् ।\nमध्यंदिनगतं सूर्यं ज्वलन्तमिव तेजसा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006518020, "chapter_id": 26518, "verse_number": "३-५७-२१", "content_sanskrit": "न शेकुः सर्वभूतानि दानवं प्रसमीक्षितुम् ।\nयथा प्ररूढं घर्मान्ते दहेत् कक्षं हुताशनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006518021, "chapter_id": 26518, "verse_number": "३-५७-२२", "content_sanskrit": "तथा सुरवरान् दैत्यो दहति स्म सुतेजसा ।\nदेवानां दानवानां च बलं नर्दति दारुणम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006518022, "chapter_id": 26518, "verse_number": "३-५७-२३", "content_sanskrit": "विरूढमभवत् सर्वमाकुलं च समन्तत ।\nशूराश्च ते बलोदग्रा हस्त्यश्वरथधूर्गताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006518023, "chapter_id": 26518, "verse_number": "३-५७-२४", "content_sanskrit": "आर्यां बुद्धिं समास्थाय न त्यजन्ति महारणम् ।\nतदुत्पिञ्जलकं युद्धमभवद् रोमहर्षणम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006518024, "chapter_id": 26518, "verse_number": "३-५७-२५", "content_sanskrit": "देवदानवयोः संख्ये रुधिरस्रावकर्दमम् ।\nन दिशः प्रत्यजानन्त भयग्राहनिपीडिताः ।\nशस्त्रपातांश्च विविधान् दानवानां महारणे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006518025, "chapter_id": 26518, "verse_number": "३-५७-२६", "content_sanskrit": "अन्योन्यं मूढचित्तास्ते निजघ्नुर्व्याकुलीकृताः ।\nस्वान् परान्नाभिजानन्ति विमूढाः शस्त्रपाणयः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006518026, "chapter_id": 26518, "verse_number": "३-५७-२७", "content_sanskrit": "शिरोरुहेषु संगृह्य कश्चिच्छूरस्य संयुगे ।\nशूरश्छिनत्ति मूर्धानं संदष्टौष्ठपुटाननम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006518027, "chapter_id": 26518, "verse_number": "३-५७-२८", "content_sanskrit": "बाहुभिर्मुष्टिभिश्चैव वज्रकल्पैः सुदारुणैः ।\nप्रहरन्ति रणे वीरा आत्तशस्त्राः परस्परम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006518028, "chapter_id": 26518, "verse_number": "३-५७-२९", "content_sanskrit": "योधप्राणहरे रौद्रे स्वर्गद्वारेनपावृते ।\nसंकुले तुमुले युद्धे वर्तमाने महाभये ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006518029, "chapter_id": 26518, "verse_number": "३-५७-३०", "content_sanskrit": "हयो हयं गजो नागं वीरो वीरं महाहवे ।\nअभ्यद्रवज्जिघांसन्तो ह्यसमञ्जसमाहवे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006518030, "chapter_id": 26518, "verse_number": "३-५७-३१", "content_sanskrit": "असुराश्च सुराश्चैव विक्रमाख्या महारथाः ।\nजुहुवुः समरे प्राणान् निजघ्नुरितरेतरम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006518031, "chapter_id": 26518, "verse_number": "३-५७-३२", "content_sanskrit": "मुक्तकेशा विकवचा विरथाश्छिन्नकार्मुकाः ।\nहस्तैः पादैश्च युध्यन्ते दानवास्त्रिदशैः सह ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006518032, "chapter_id": 26518, "verse_number": "३-५७-३३", "content_sanskrit": "हरिस्तु निशितं भल्लं प्रेषयामास संयुगे ।\nस तस्य धनुषः कोटिं छित्त्वा भूमावपातयत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006518033, "chapter_id": 26518, "verse_number": "३-५७-३४", "content_sanskrit": "पुनश्चापि पृषत्कानां शतानि नतपर्वणाम् ।\nप्राहिणोत् सहसा तस्य दानवेन्द्रस्य संयुगे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006518034, "chapter_id": 26518, "verse_number": "३-५७-३५", "content_sanskrit": "तस्य देहे विमुक्तास्ते मारुतेन समीरिताः ।\nमग्नार्धकाया विविशुः पन्नगा इव पर्वते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006518035, "chapter_id": 26518, "verse_number": "३-५७-३६", "content_sanskrit": "स तैर्निपतितैर्गात्रैः क्षरद्भिरसृगावली ।\nबभौ दैत्यो महाबाहुर्मेरुर्धातुमिवोत्सृजन् ।\nपुनश्चापि पृषत्कानां शतानि नतपर्वणाम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006518036, "chapter_id": 26518, "verse_number": "३-५७-३७", "content_sanskrit": "ततोऽसिलोमा संक्रुद्धः प्रगृह्यान्यन्महाधनुः ।\nरुक्मपुङ्खांश्च निशितान्प्रेषयामास सायकान् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006518037, "chapter_id": 26518, "verse_number": "३-५७-३८", "content_sanskrit": "तैस्तु मर्मसु विव्याध सर्पानलविषोपमैः ।\nगात्रं सछादयामास महाभ्रैरिव पर्वतम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006518038, "chapter_id": 26518, "verse_number": "३-५७-३९", "content_sanskrit": "भूयः संधाय च शरं मुमोचान्तकसंनिभम् ।\nसुपुङ्खं सूर्यसंकाशं बाणमप्रतिमं रणे ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006518039, "chapter_id": 26518, "verse_number": "३-५७-४०", "content_sanskrit": "तेन बाणप्रहारेण संयुगे भीमकर्मणा ।\nमुमोह सहसा देवो भूमौ चापि पपात ह ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006518040, "chapter_id": 26518, "verse_number": "३-५७-४१", "content_sanskrit": "ततो हाहाकृताः सर्वे देवे भूतलमाश्रिते ।\nजगत् सदेवमाविग्नं यथार्कपतनं तथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006518041, "chapter_id": 26518, "verse_number": "३-५७-४२", "content_sanskrit": "परिवारं तु समरे तस्य हत्वा महासुरः ।\nएकत्रिंशत्सहस्राणि योधानां दानवोत्तमः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006518042, "chapter_id": 26518, "verse_number": "३-५७-४३", "content_sanskrit": "जयश्रिया सेव्यमानो दीप्यमान इवाचलः ।\nप्रगृह्य कार्मुकं घोरं गतः शक्ररथं प्रति ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006518043, "chapter_id": 26518, "verse_number": "३-५७-४४", "content_sanskrit": "तथैव तु महायुद्धे ससैन्यावश्विनावुभौ ।\nप्रयुद्धौ सह वृत्रेण बलिना देवतारिणा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006518044, "chapter_id": 26518, "verse_number": "३-५७-४५", "content_sanskrit": "बाणखड्गधनुष्पाणिः समरे त्यक्त जीवितः ।\nआसाद्य सोऽश्विनौ दैत्यः स्थितो गिरिरिवाचलः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006518045, "chapter_id": 26518, "verse_number": "३-५७-४६", "content_sanskrit": "ततः शङ्खमुपाध्माय द्विषतां लोमहर्षणम् ।\nज्याघोषतलशब्दैश्च सर्वभूतान्यवेजयत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006518046, "chapter_id": 26518, "verse_number": "३-५७-४७", "content_sanskrit": "ततः संहृष्टरोमाणः शङ्खशब्दं विशुश्रुवुः ।\nयक्षराक्षसदेवौघा वृत्रस्यापि च निःस्वनम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006518047, "chapter_id": 26518, "verse_number": "३-५७-४८", "content_sanskrit": "गदातोमरनिस्त्रिंशशूलशक्तिपरश्वधाः ।\nप्रगृहीता व्यराजन्त यक्षराक्षसबाहुभिः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006518048, "chapter_id": 26518, "verse_number": "३-५७-४९", "content_sanskrit": "तैः प्रयुक्तान्महाकायैः शूलशक्तिपरश्वधान् ।\nभल्लैर्वृत्रः प्रचिच्छेद भीमवेगरवैस्तथा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006518049, "chapter_id": 26518, "verse_number": "३-५७-५०", "content_sanskrit": "अन्तरिक्षचराणां च भूमिस्थानां च गर्जताम् ।\nशरैर्विव्याध गात्राणि देवानां प्रियदर्शिनाम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006518050, "chapter_id": 26518, "verse_number": "३-५७-५१", "content_sanskrit": "वृत्रासुरभुजोत्सृष्टैर्बहुधा यक्षरक्षसाम् ।\nनिकृत्तान्येव दृश्यन्ते शरीराणि शिरांसि च ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006518051, "chapter_id": 26518, "verse_number": "३-५७-५२", "content_sanskrit": "अथ रक्तमहावृष्टिरभ्यवर्षत मेदिनीम् ।\nगदापरिघभिन्नानां देवानां गात्रसम्भवा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006518052, "chapter_id": 26518, "verse_number": "३-५७-५३", "content_sanskrit": "प्रच्छादयन्तं बाणौघैर्वृत्रं भीमपराक्रमम् ।\nददृशुः सर्वभूतानि भानुमन्तमिवांशुभिः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006518053, "chapter_id": 26518, "verse_number": "३-५७-५४", "content_sanskrit": "तीक्ष्णरश्मिरिवादित्यः प्रतपन् सर्वदेवताः ।\nअविध्यद् बलवान् क्रुद्धः सायकैर्मर्मभेदिभिः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006518054, "chapter_id": 26518, "verse_number": "३-५७-५५", "content_sanskrit": "नदतो विविधान् नादानर्दितस्यापि सायकैः ।\nन मोहमसुरेन्द्रस्य ददृशुस्त्रिदशा रणे ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006518055, "chapter_id": 26518, "verse_number": "३-५७-५६", "content_sanskrit": "तेऽसिचर्मगदाभिश्च परिघप्रासतोमरैः ।\nपरश्वधैश्च शूलैश्च प्रववर्षुर्महारथाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006518056, "chapter_id": 26518, "verse_number": "३-५७-५७", "content_sanskrit": "ततो वृत्रः सुसंक्रुद्धस्तैस्तदाभ्यर्दितो बली ।\nअभ्यवर्षच्छितैर्बाणैस्तान् सर्वान् सत्यविक्रमः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006518057, "chapter_id": 26518, "verse_number": "३-५७-५८", "content_sanskrit": "तेन वित्रासिता देवा विप्रकीर्णमहायुधाः ।\nघोरमार्तस्वरं चक्रुर्वृत्रासुरभयार्दिताः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006518058, "chapter_id": 26518, "verse_number": "३-५७-५९", "content_sanskrit": "उत्सृज्य ते गदाशक्तिशूलर्ष्टिपरिघाशनीन् ।\nउत्तरां दिशमाजग्मुस्त्रासिता दृढधन्विना ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006518059, "chapter_id": 26518, "verse_number": "३-५७-६०", "content_sanskrit": "शूलशक्तिगदापाणिर्व्यूढोरस्को महाभुजः ।\nप्रावर्तत रणे वृत्रस्त्रासयानश्चराचरान् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006518060, "chapter_id": 26518, "verse_number": "३-५७-६१", "content_sanskrit": "तत्रैकस्तु महाबाहुरसिशूलधरः प्रभुः ।\nअभ्यधावत दैत्येन्द्रं वृत्रमप्रतिमं रणे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006518061, "chapter_id": 26518, "verse_number": "३-५७-६२", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य निर्भिन्नमिव वारणम् ।\nवत्सदन्तैस्त्रिभिः पार्श्वे विव्याध सुरसत्तमम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006518062, "chapter_id": 26518, "verse_number": "३-५७-६३", "content_sanskrit": "सोऽपि विद्धो महेष्वासः शरैरमितविक्रमः ।\nगदां जग्राह बलवान् गदायुद्धविशारदः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006518063, "chapter_id": 26518, "verse_number": "३-५७-६४", "content_sanskrit": "तां प्रगृह्य गदां भीमामयःसारमयीं दृढाम् ।\nअश्विनं सहसाऽऽगम्य ताडयामास वीर्यवान् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006518064, "chapter_id": 26518, "verse_number": "३-५७-६५", "content_sanskrit": "दीप्यमानं ततः शूलमश्वी सुविपुलं दृढम् ।\nप्रासृजद् वृत्रदैत्याय सहसा रोमहर्षणम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006518065, "chapter_id": 26518, "verse_number": "३-५७-६६", "content_sanskrit": "भङक्त्वा शूलं गदाग्रेण गदायुद्धविशारदः ।\nअश्विनं सहसाभ्येत्य गरुत्मानिव पन्नगम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006518066, "chapter_id": 26518, "verse_number": "३-५७-६७", "content_sanskrit": "सोऽन्तरिक्षात्समुत्पत्य विधूय महतीं गदाम् ।\nनासत्योपरि चिक्षेप गिरिशृङ्गोपमां बली ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006518067, "chapter_id": 26518, "verse_number": "३-५७-६८", "content_sanskrit": "गदयाभिहतः सोऽश्वी त्यक्त्वा शूलमनुत्तमम् ।\nप्रयातः सहसा तत्र यत्र युध्यति वासवः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006518068, "chapter_id": 26518, "verse_number": "३-५७-६९", "content_sanskrit": "पराजित्य तु संग्रामे अश्विनं भीमविक्रमम् ।\nजयश्रिया सेव्यमानो वृत्रो युद्धे व्यवस्थितः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]