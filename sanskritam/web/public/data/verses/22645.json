[{"id": 7002645000, "chapter_id": 22645, "verse_number": "६-२३-१", "content_sanskrit": "व्यास उवाच ।\nइति श्रुत्वा तु मुनयो विशालानगरीस्थिताः ।\nस्नात्वा केदारकुण्डे ते मनसा पूजयञ्छिवम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002645001, "chapter_id": 22645, "verse_number": "६-२३-२", "content_sanskrit": "समाधिनिष्ठास्ते सर्वे वर्षमेकं व्यतीतयन् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002645002, "chapter_id": 22645, "verse_number": "६-२३-३", "content_sanskrit": "एतस्मिन्नंतरे राजा विक्रमादित्यभूपतिः ।\nनत्वा मुनीन्समाधिस्थांस्तुष्टाव परया गिरा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002645003, "chapter_id": 22645, "verse_number": "६-२३-४", "content_sanskrit": "उषित्वा ते तु मुनयः सूतं गत्वाऽब्रुवन्निदम् ।\nसोऽयं राजा समायातो यस्यैवं वर्णिता कथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002645004, "chapter_id": 22645, "verse_number": "६-२३-५", "content_sanskrit": "वाजिमेधं च नृपतेः कारयामस्त्वदाज्ञया ।\nभवान्हि चक्रतीर्थे च स्थित्वा ध्यानपरो भवेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002645005, "chapter_id": 22645, "verse_number": "६-२३-६", "content_sanskrit": "तथेत्युक्त्वा तु सूतस्तैः सार्धं च पुनरागमत् ।\nविधिना कारयामास हयमेधं महामखम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002645006, "chapter_id": 22645, "verse_number": "६-२३-७", "content_sanskrit": "पूर्वे तु कपिलस्थानं दक्षिणे सेतुबन्धनम् ।\nपश्चिमे सिंधुनद्यन्तं चोत्तरे बदरीवनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002645007, "chapter_id": 22645, "verse_number": "६-२३-८", "content_sanskrit": "हयो जगाम तरसा ततः क्षिप्रां नदीं गतः ।\nत्यक्त्वा कलेवरं वह्नौ स्वर्गलोकमतो ययौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002645008, "chapter_id": 22645, "verse_number": "६-२३-९", "content_sanskrit": "नृपयज्ञे सुराः सर्वे सपत्नीकाः समागताः ।\nचंद्रमास्तत्र नायातो भूपतिर्विमना अभूत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002645009, "chapter_id": 22645, "verse_number": "६-२३-१०", "content_sanskrit": "यज्ञांते विविधं दानं दत्त्वा वैतालसंयुतः ।\nचंद्रलोकं गतो राजा चंद्रमाः सुखितोऽभवत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002645010, "chapter_id": 22645, "verse_number": "६-२३-११", "content_sanskrit": "भोभो राजन्महाभाग कलौ प्राप्ते भयंकरे ।\nमद्गतिर्भूतले नास्ति तस्मान्नायामि तेऽन्तिकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002645011, "chapter_id": 22645, "verse_number": "६-२३-१२", "content_sanskrit": "दत्त्वा सुधामयं तोयं चंद्रश्चान्तर्दधे पुनः ।\nज्ञात्वेन्द्रस्तत्र संप्राप्य द्विजरूपी ह्ययाचयत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002645012, "chapter_id": 22645, "verse_number": "६-२३-१३", "content_sanskrit": "दत्तं राज्ञा तदमृतं शक्रः स्वर्गमुमुपागतः ।\nतेन तस्य फलं जातमायुर्लक्ष समं ह्यभूत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002645013, "chapter_id": 22645, "verse_number": "६-२३-१४", "content_sanskrit": "तस्मिन्काले द्विजः कश्चिज्जयन्तो नाम विश्रुतः ।\nतत्फलं तपसा प्राप्तः शक्रतः स्वर्गृहं ययौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002645014, "chapter_id": 22645, "verse_number": "६-२३-१५", "content_sanskrit": "जयन्तो भर्तृहरये लक्षस्वर्णेन वर्णयन् ।\nभुक्त्वा भर्तृहरिस्तत्र योगारूढो वनं ययौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002645015, "chapter_id": 22645, "verse_number": "६-२३-१६", "content_sanskrit": "विक्रमादित्य एवास्य राज्यमकंटकम् ।\nशतवर्षं मुदायुक्तो जगाम मरणे दिवम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002645016, "chapter_id": 22645, "verse_number": "६-२३-१७", "content_sanskrit": "शौनकाद्यास्तु ऋषयो ज्ञात्वा भूपस्य स्वर्गतिम् ।\nगत्वा सूतं प्रणम्योचुर्धर्मं मुख्यं वदाधुना ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002645017, "chapter_id": 22645, "verse_number": "६-२३-१८", "content_sanskrit": "तेभ्यः सूतः पुराणानि श्रावयामास वै पुनः ।\nशतवर्षं पञ्चलक्षश्लोकमध्यापयन्मुदा ।\nते श्रुत्वा मुनयः सर्वे जग्मुर्हृष्टाः स्वमालयम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]