[{"id": 2103406, "chapter_id": 3242, "verse_number": "१४-९८-१", "content_sanskrit": "वैशम्पायन उवाच।\nएवं श्रुत्वा वचस्तस्य धर्मपुत्रोऽच्युतस्य तु।\nपप्रच्छ पुनरप्यन्यं धर्मं धर्मात्मजो हरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2103407, "chapter_id": 3242, "verse_number": "१४-९८-२", "content_sanskrit": "वृथा च कति जन्मानि वृथा दानानि कानि च।\nवृथा च जीवितं केषां नराणां पुरुषोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2103408, "chapter_id": 3242, "verse_number": "१४-९८-३", "content_sanskrit": "कीदृशासु ह्यवस्थासु दानं दत्तं जनार्दन।\nइह लोकेऽनुभवति पुरुषः पुरुषोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2103409, "chapter_id": 3242, "verse_number": "१४-९८-४", "content_sanskrit": "गर्भस्थः किं समश्नाति किं बाल्ये वाऽपि केशव।\nयौवनस्थेऽपि किं कृष्ण वार्धके वाऽपि किं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2103410, "chapter_id": 3242, "verse_number": "१४-९८-५", "content_sanskrit": "सात्विकं कीदृशं दानं राजसं कीदृशं भवेत्।\nतामसं कीदृशं देव तर्पयिष्यति किं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2103411, "chapter_id": 3242, "verse_number": "१४-९८-६", "content_sanskrit": "उत्तमं कीदृशं दानं तेषां वा किं फलं भवेत्।\nकिं दानं नयति ह्यूर्ध्वं किं गतिं मध्यमां नयेत्।\nगतिं जघन्यामथवा देवदेव ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2103412, "chapter_id": 3242, "verse_number": "१४-९८-७", "content_sanskrit": "एतदिच्छामि विज्ञातुं परं कौतूहलं हि मे।\nत्वदीयं वचनं सत्यं पुण्यं च मधुसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2103413, "chapter_id": 3242, "verse_number": "१४-९८-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2103414, "chapter_id": 3242, "verse_number": "१४-९८-८", "content_sanskrit": "एवं धर्मं प्रयत्नेन पृष्टः पाण्डुसुतेन वै।\nउवाच वासुदेवोऽथ धर्मान्धर्मात्मजस्य तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2103415, "chapter_id": 3242, "verse_number": "१४-९८-९x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2103416, "chapter_id": 3242, "verse_number": "१४-९८-९", "content_sanskrit": "शृणु राजन्यथान्यायं वचनं तथ्यमुत्तमम्।\nकथ्यमानं मया पुण्यं सर्वपापव्यपोहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2103417, "chapter_id": 3242, "verse_number": "१४-९८-१०", "content_sanskrit": "वृथा च दश जन्मानि चत्वारि च नराधिप।\nवृथा दानानि पञ्चाशत्पञ्चैव च यथाक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2103418, "chapter_id": 3242, "verse_number": "१४-९८-११", "content_sanskrit": "वृथा च जीवितं येषां ते च षट् परिकीर्तिताः।\nअनुक्रमेण वक्ष्यामि तानि सर्वाणि पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2103419, "chapter_id": 3242, "verse_number": "१४-९८-१२", "content_sanskrit": "धर्मघ्नानां वृथा जन्म लुब्धानां पापिनां तथा।\nवृथा पाकं च येऽश्नन्ति परदाररताश्च ये।\nपाकभेदकरा ये च ये च स्युः सत्यवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2103420, "chapter_id": 3242, "verse_number": "१४-९८-१३", "content_sanskrit": "मृष्टमश्नाति यश्चैकः क्लिस्यमानैस्तु बान्धवैः।\nपितरं मातरं चैव उपाध्यायं गुरुं तथा।\nमातुलं मातुलानीं च यो निहन्याच्छपेत वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2103421, "chapter_id": 3242, "verse_number": "१४-९८-१४", "content_sanskrit": "ब्राह्मणश्चैव यो भूत्वा सन्ध्योपासनवर्जितः।\nनिस्स्वाहो निस्स्वधश्चैव शूद्राणामन्नभुग्द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2103422, "chapter_id": 3242, "verse_number": "१४-९८-१५", "content_sanskrit": "मम वा शंकरस्याथ ब्रह्मणो वा युधिष्ठिर।\nअथवा ब्राह्मणानां तु ये न भक्ता नराधमाः।\nवृथाजन्मान्यथैतेषां पापिनां विद्धि डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2103423, "chapter_id": 3242, "verse_number": "१४-९८-१६", "content_sanskrit": "अश्रद्धयाऽपि यद्दत्तमवामानेन वाऽपि यत्।\nडंभार्थमपि यद्दत्तं यत्पाषण्डिहृतं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2103424, "chapter_id": 3242, "verse_number": "१४-९८-१७", "content_sanskrit": "शूद्राचाराय यद्दत्तं यद्दत्त्वा चानुकीर्तितम्।\nरोषयुक्तं तु यद्दत्तं यद्दत्तमनुशोचितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2103425, "chapter_id": 3242, "verse_number": "१४-९८-१८", "content_sanskrit": "डंभार्जितं च यद्दत्तं यच्च वाऽप्यनृतार्जितम्।\nब्राह्मणस्वं च यद्दत्तं चौर्येणाप्यार्जितं च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2103426, "chapter_id": 3242, "verse_number": "१४-९८-१९", "content_sanskrit": "अभिशास्ताहृतं यत्तु यद्दत्तं पतिते द्विजे।\nनिर्ब्रह्माभिहृतं यत्तु यद्दत्तं सर्वयाचकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2103427, "chapter_id": 3242, "verse_number": "१४-९८-२०", "content_sanskrit": "व्राप्यैस्तु यद्धृतं दानमारूढपतितैश्च यत्।\nयद्दत्तं स्वैरिणीभर्तुः श्वशुराननुवर्तिने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2103428, "chapter_id": 3242, "verse_number": "१४-९८-२१", "content_sanskrit": "यद्ग्रामयाचकहृतं यत्कृतघ्नहृतं तथा।\nउपपातकिने दत्तं देवविक्रयिणे च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2103429, "chapter_id": 3242, "verse_number": "१४-९८-२२", "content_sanskrit": "स्त्रीजिताय च यद्दत्तं यद्दत्तं राजसेविने।\nगणकाय च यद्दत्तं यच्च कारणिकाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2103430, "chapter_id": 3242, "verse_number": "१४-९८-२३", "content_sanskrit": "वृषलीपतये दत्तं यद्दत्तं शस्त्रजीविने।\nभृतकाय च यद्दत्तं व्यालग्राहिहृतं च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2103431, "chapter_id": 3242, "verse_number": "१४-९८-२४", "content_sanskrit": "पुरोहिताय यद्दत्तं चिकित्सकहृतं च यत्।\nयद्वणिंक्कर्मिणे दत्तं क्षुद्रमन्त्रोपजीविने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2103432, "chapter_id": 3242, "verse_number": "१४-९८-२५", "content_sanskrit": "यच्छूद्रजीविने दत्तं यच्च देवलकाय च।\nदेवद्रव्याशिने यच्च यद्दत्तं चित्रकर्मिणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2103433, "chapter_id": 3242, "verse_number": "१४-९८-२६", "content_sanskrit": "रङ्गोपजीविने दत्तं यच्च मांसोपजीविने।\nसेवकाय च यद्दत्तं यद्दत्तं ब्राह्मणब्रुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2103434, "chapter_id": 3242, "verse_number": "१४-९८-२७", "content_sanskrit": "अदेशिने च यद्दत्तं दत्तं वार्धुषिकाय च।\nयदनाचारिणे दत्तं यत्तु दत्तमनग्रये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2103435, "chapter_id": 3242, "verse_number": "१४-९८-२८", "content_sanskrit": "असन्ध्योपासिने दत्तं यच्छूद्रग्रामवासिने।\nयन्मिथ्यालिङ्गिने दत्तं दत्तं सर्वाशिने च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2103436, "chapter_id": 3242, "verse_number": "१४-९८-२९", "content_sanskrit": "नास्तिकाया च यद्दत्तं धर्मविक्रयिणे च यत्।\nवराकाय च यद्दत्तं यद्दत्तं कूटसाक्षिणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2103437, "chapter_id": 3242, "verse_number": "१४-९८-३०", "content_sanskrit": "ग्रामकूटाय यद्दत्तं दानं पार्तिवपुङ्गव।\nवृथा भवति तत्सर्वं नात्र कार्या विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2103438, "chapter_id": 3242, "verse_number": "१४-९८-३१", "content_sanskrit": "विप्राणामधरा एते लोलुपा ब्राह्मणाधमाः।\nनात्मानं तारयन्त्येते न दातारं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2103439, "chapter_id": 3242, "verse_number": "१४-९८-३२", "content_sanskrit": "एतेभ्यो दत्तमात्राणि दानानि सुबहून्यपि।\nवृथा भवन्ति राजेन्द्र भस्मन्याज्याहुतिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2103440, "chapter_id": 3242, "verse_number": "१४-९८-३३", "content_sanskrit": "एतेषु यत्फलं किंचिद्भविष्यति कथंचन।\nराक्षसाश्च पिशाचाश्च तद्विलुंपन्ति हर्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2103441, "chapter_id": 3242, "verse_number": "१४-९८-३४", "content_sanskrit": "वृथा ह्येतानि दत्तानि कथितानि समासतः।\nजीवितं तु वृथा येषां चच्छृणुष्व युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2103442, "chapter_id": 3242, "verse_number": "१४-९८-३५", "content_sanskrit": "ये मां न प्रतिपद्यन्ते शङ्करं वा नराधमाः।\nब्रैह्मणान्वा महीदेवान्वृथा जीवन्ति ते नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2103443, "chapter_id": 3242, "verse_number": "१४-९८-३६", "content_sanskrit": "हेतुशास्त्रेषु ये सक्ताः कुदृष्टिपथमाश्रिताः।\nदेवान्निन्दन्त्यनाचारा वृथा जीवन्ति ते नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2103444, "chapter_id": 3242, "verse_number": "१४-९८-३७", "content_sanskrit": "कुशलैः कृतशास्त्राणि पठित्वा ये नराधमाः।\nविप्रान्निन्दन्ति यज्ञांश्च वृथा जीवन्ति ते नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2103445, "chapter_id": 3242, "verse_number": "१४-९८-३८", "content_sanskrit": "ये दुर्गां वा कुमारं वा वायुमग्निं जलं रविम्।\nपितरं मातरं चैव गुरुमिन्द्रं निशाकरम्।\nमूढा निन्दन्त्यनाचारा वृथा जीवन्ति ते नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2103446, "chapter_id": 3242, "verse_number": "१४-९८-३९", "content_sanskrit": "विद्यमाने धने यस्तु दानधर्मविवर्जितः।\nमृष्टमश्नाति यश्चैको वृथा जीवति सोपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2103447, "chapter_id": 3242, "verse_number": "१४-९८-४०", "content_sanskrit": "वृथा जीवितमाख्यातं दानकालं ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2103448, "chapter_id": 3242, "verse_number": "१४-९८-४१", "content_sanskrit": "तमोनिविष्टचित्तेन दत्तं दानं तु यद्भवेत्।\nतदस्य फलमश्नाति नरो गर्भगतो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2103449, "chapter_id": 3242, "verse_number": "१४-९८-४२", "content_sanskrit": "ईर्ष्यामत्सरसंयुक्तो डंभार्थं चार्थकारणात्।\nददाति दानं यो मर्त्यो बालभावे तदश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2103450, "chapter_id": 3242, "verse_number": "१४-९८-४३", "content_sanskrit": "भोक्तं भोगमशक्तस्तु व्याधिभिः पीडितो भृशम्।\nददाति दानं यो मर्त्यो वृद्धभावे तदश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2103451, "chapter_id": 3242, "verse_number": "१४-९८-४४", "content_sanskrit": "श्रद्धायुक्तः शुचिः स्नातः प्रसन्नेन्द्रियमानसः।\nददाति दानं यो मर्त्यो यौवने स तदश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2103452, "chapter_id": 3242, "verse_number": "१४-९८-४५", "content_sanskrit": "स्वयं नीत्वा तु यद्दानं भक्त्या पात्रे प्रदीयते।\nतत्सार्वकालिकं विद्धि दानमामरणान्तिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2103453, "chapter_id": 3242, "verse_number": "१४-९८-४६", "content_sanskrit": "राजसं सात्विकं चापि तामसं च युधिष्ठिर।\nदानं दानफलं चैव गतिं च त्रिविधां शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2103454, "chapter_id": 3242, "verse_number": "१४-९८-४७", "content_sanskrit": "दानं दातव्यमित्येव मतिं कृत्वा द्विजाय वै।\nउपकारवियुक्ताय यद्दत्तं तद्धि सात्विकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2103455, "chapter_id": 3242, "verse_number": "१४-९८-४८", "content_sanskrit": "श्रोत्रियाय दरिद्राय बहुभृत्याय पाण्डव।\nदीयते यत्प्रहृष्टेन तत्सात्विकमुदाहृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2103456, "chapter_id": 3242, "verse_number": "१४-९८-४९", "content_sanskrit": "वेदाक्षरविहीनाय यत्तु पूर्वोपकारिणे।\nसमृद्धाय च यद्दत्तं तद्दानं राजसं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2103457, "chapter_id": 3242, "verse_number": "१४-९८-५०", "content_sanskrit": "संबन्धिने च यद्दत्तं प्रमत्ताय च पाण्डव।\nफलार्थिभिरपात्राय तद्दानं राजसं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2103458, "chapter_id": 3242, "verse_number": "१४-९८-५१", "content_sanskrit": "वैश्वदेवविहीनाय दानमश्रोत्रियाय च।\nदीयते तस्करायापि तद्दानं तामसं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2103459, "chapter_id": 3242, "verse_number": "१४-९८-५२", "content_sanskrit": "सरोषमवधूतं च क्लेशयुक्तमवज्ञया।\nसेवकाय च यद्दतं तत्तामसमुदाहृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2103460, "chapter_id": 3242, "verse_number": "१४-९८-५३", "content_sanskrit": "देवाः पितृगणाश्चैव मुनयश्चाग्नयस्तथा।\nसात्विकं दानमश्नन्ति तुष्यन्ति च नरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2103461, "chapter_id": 3242, "verse_number": "१४-९८-५४", "content_sanskrit": "दानवा दैत्यसङ्गाश्च ग्रहा यक्षाः सराक्षसाः।\nराजसं दानमश्नन्ति वर्जितं पितृदैवतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2103462, "chapter_id": 3242, "verse_number": "१४-९८-५५", "content_sanskrit": "पिशाचाः प्रेतसङ्घाश्च कश्मला ये मलीमसाः।\nतामसं दानमश्नन्ति गतिं च त्रिविधां शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2103463, "chapter_id": 3242, "verse_number": "१४-९८-५६", "content_sanskrit": "सात्विकानां तु दानानामुत्तमं फलमश्नुते।\nमध्यमं राजसानां तु तामसानां तु पश्चिमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2103464, "chapter_id": 3242, "verse_number": "१४-९८-५७", "content_sanskrit": "अभिगम्योपनीतानां दानानामुत्तमं फलम्।\nमध्यमं तु समाहूय जघन्यं याचते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2103465, "chapter_id": 3242, "verse_number": "१४-९८-५८", "content_sanskrit": "अयाचितप्रदाता यः स याति गतिमुत्तमाम्।\nसमाहूय तु यो दद्यान्मध्यमां स गतिं व्रजेत्।\nयाचितो यश्च वै दद्याज्जघन्यां स गतिं व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2103466, "chapter_id": 3242, "verse_number": "१४-९८-५९", "content_sanskrit": "उत्तमा दैविकी ज्ञेया मध्यमा मानुषी गतिः।\nगतिर्जघन्या तिर्यक्षु गतिरेषा त्रिधा स्मृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2103467, "chapter_id": 3242, "verse_number": "१४-९८-६०", "content_sanskrit": "पात्रभूतेषु विप्रेषु संस्थितेष्वाहिताग्निषु।\nयत्तु निक्षिप्यते दानमक्षयं संप्रकीर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2103468, "chapter_id": 3242, "verse_number": "१४-९८-६१", "content_sanskrit": "श्रोत्रियाणां दरिद्राणां भरणं कुरु पार्थिव।\nसमृद्धानां द्विजातीनां कुर्यास्तेषां तु रक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2103469, "chapter_id": 3242, "verse_number": "१४-९८-६२", "content_sanskrit": "दरिद्रान्वित्तहीनांश्च प्रदानैः सुष्ठु पूजय।\nआतुरस्यैषधैः कार्यं नीरुजस्य किमौषधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2103470, "chapter_id": 3242, "verse_number": "१४-९८-६३", "content_sanskrit": "पापं प्रतिग्रहीतारं प्रदातुरपगच्छति।\nप्रतिग्रहीतुर्यत्पुण्यं प्रदातारमुपैति तत्।\nतस्माद्दानं सदा कार्यं परत्र हितमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2103471, "chapter_id": 3242, "verse_number": "१४-९८-६४", "content_sanskrit": "वेदविद्यावदातेषु सदा शूद्रान्नवर्जिषु।\nप्रयत्नेन विधातव्यो महादानमयो निधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2103472, "chapter_id": 3242, "verse_number": "१४-९८-६५", "content_sanskrit": "येषां दाराः प्रतीक्षन्ते सहस्रस्येव लम्भनम्।\nभुक्तशेषस्य भक्तस्य तान्निमन्त्रय पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2103473, "chapter_id": 3242, "verse_number": "१४-९८-६६", "content_sanskrit": "आमन्त्र्य तु निराशानि न कर्तव्यानि भारत।\nकुलानि सुदरिद्राणि तेषामाशा हता भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2103474, "chapter_id": 3242, "verse_number": "१४-९८-६७", "content_sanskrit": "मद्भक्ता ये नरश्रेष्ठ मद्गता मत्परायणाः।\nमद्याजिनो मन्नियमास्तान्प्रयत्नेन पूजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2103475, "chapter_id": 3242, "verse_number": "१४-९८-६८", "content_sanskrit": "तेषां तु पावनायाहं नित्यमेव युधिष्ठिर।\nउभे सन्ध्येऽधितिष्ठामि ह्यस्कन्नं तद्व्रतं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2103476, "chapter_id": 3242, "verse_number": "१४-९८-६९", "content_sanskrit": "तस्मादष्टाक्षरं मन्त्रं मद्भक्तैर्वीतकल्मषैः।\nसन्ध्याकाले तु जप्तव्यं सततं चात्मशुद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2103477, "chapter_id": 3242, "verse_number": "१४-९८-७०", "content_sanskrit": "अन्येषामपि विप्राणां किल्बिषं हि विनश्यति।\nउभे सन्ध्येप्युपासीत तस्माद्विप्रो विशुद्धये।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2103478, "chapter_id": 3242, "verse_number": "१४-९८-७१", "content_sanskrit": "दैवे श्राद्धेपि विप्रः स नियोक्तव्योऽजुगुप्सया।\nजुगुप्सितस्तु यः श्राद्धं दहत्यग्निरिवेन्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2103479, "chapter_id": 3242, "verse_number": "१४-९८-७२", "content_sanskrit": "भारतं मानवो धर्मो वेदाः साङ्गाश्चिकित्सितम्।\nआज्ञासिद्धानि चत्वारि न हन्तव्यानि हेतुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2103480, "chapter_id": 3242, "verse_number": "१४-९८-७३", "content_sanskrit": "न ब्राह्मणान्परीक्षेत दैवे कर्मणि धर्मवित्।\nमहान्भवेत्परीवादो ब्राह्मणानां परीक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2103481, "chapter_id": 3242, "verse_number": "१४-९८-७४", "content_sanskrit": "ब्राह्मणानां परीवादं यः कुर्यात्स नराधमः।\nरासभानां शुनां योनिं गच्छेत्पुरुषदूषकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2103482, "chapter_id": 3242, "verse_number": "१४-९८-७५", "content_sanskrit": "श्वत्वं प्राप्नोति निन्दित्वा परीवादात्खरो भवेत्।\nकृमिर्भवत्यभिभवात्कीटो भवति मत्सरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2103483, "chapter_id": 3242, "verse_number": "१४-९८-७६", "content_sanskrit": "दुर्वृत्ता वा सुवृत्ता वा प्राकृता वा सुसंस्कृताः।\nब्राह्मणा नावमन्तव्या भस्मच्छन्ना इवाग्नयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2103484, "chapter_id": 3242, "verse_number": "१४-९८-७७", "content_sanskrit": "क्षत्रियं चैव सर्पं च ब्राह्मणं च बहुश्रुतम्।\nनावमन्येत मेधावी कृशानपि कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2103485, "chapter_id": 3242, "verse_number": "१४-९८-७८", "content_sanskrit": "एतत्त्रयं हि पुरुषं निर्दहेदवमानितम्।\nतस्मादेतत्प्रयत्नेन नावमन्येत बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2103486, "chapter_id": 3242, "verse_number": "१४-९८-७९", "content_sanskrit": "यथा सर्वास्ववस्थासु पावको दैवतं महत्।\nतथा सर्वास्ववस्थासु ब्राह्मणो दैवतं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2103487, "chapter_id": 3242, "verse_number": "१४-९८-८०", "content_sanskrit": "व्यङ्गाः काणाश्च कुब्जाश्च वामनाङ्गास्तथैव च।\nसर्वे दैवे नियोक्तव्या व्यामिश्रा वेदपारगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2103488, "chapter_id": 3242, "verse_number": "१४-९८-८१", "content_sanskrit": "मन्युं नोत्पादयेत्तेषां न चारिष्टं समाचरेत्।\nमन्युप्रहरणा विप्रा न विप्राः शश्त्रपाणयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2103489, "chapter_id": 3242, "verse_number": "१४-९८-८२", "content_sanskrit": "मन्युना घ्नन्ति ते शत्रून्वज्रेणेन्द्र इवासुरान्।\nब्राह्मणो हि महद्दैवं जातिमात्रेण जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2103490, "chapter_id": 3242, "verse_number": "१४-९८-८३", "content_sanskrit": "ब्राह्मणः सर्वभूतानां धर्मकोशस्य गुप्तये।\nकिं पुनर्ये च कौन्तेय सन्ध्यां नित्यमुपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2103491, "chapter_id": 3242, "verse_number": "१४-९८-८४", "content_sanskrit": "यस्यास्येन समश्नन्ति हव्यानि त्रिदिवौकसः।\nकव्यानि चैव पितरः किं भूतमधिकं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2103492, "chapter_id": 3242, "verse_number": "१४-९८-८५", "content_sanskrit": "उत्पत्तिरेव विप्रस्य मूर्तिधर्मस्य शाश्वती।\nस हि धर्मार्थमुत्पन्नो ब्रह्मभूयाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2103493, "chapter_id": 3242, "verse_number": "१४-९८-८६", "content_sanskrit": "स्वमेव ब्राह्मणो भुङ्क्ते स्वं वस्ते स्वं ददाति च।\nआनृशंस्याद्ब्राह्मणस्य भुञ्जते हीतरे जनाः।\nतस्मात्ते नावमन्तव्या मद्भक्ता हि द्विजाः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2103494, "chapter_id": 3242, "verse_number": "१४-९८-८७", "content_sanskrit": "आरण्यकोपनिषदि ये तु पश्यन्ति मां द्विजाः।\nनिगूढं निष्कलावस्थं तान्प्रयत्नेन पूजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2103495, "chapter_id": 3242, "verse_number": "१४-९८-८८", "content_sanskrit": "स्वगृहे वा प्रवासे वा दिवारात्रमथापि वा।\nश्रद्धया ब्राह्मणाः पूज्या मद्भक्ता ये च पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2103496, "chapter_id": 3242, "verse_number": "१४-९८-८९", "content_sanskrit": "नास्ति विप्रसमं दैवं नास्ति विप्रसमो गुरुः।\nनास्ति विप्रात्परो बन्धुर्नास्ति विप्रात्परो निधिः।\nनास्ति विप्रात्परं तीर्थं न पुण्यं ब्राह्मणात्परम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2103497, "chapter_id": 3242, "verse_number": "१४-९८-९०", "content_sanskrit": "न पवित्रं परं विप्रान्न द्विजात्पावनं परम्।\nनास्ति विप्राप्तरो धर्मो नास्ति विप्रात्परा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2103498, "chapter_id": 3242, "verse_number": "१४-९८-९१", "content_sanskrit": "पापकर्मसमाक्षिप्तं पतन्तं नरके नरम्।\nत्रायते पात्रमप्येकं पात्रभूते तु तद्द्विजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2103499, "chapter_id": 3242, "verse_number": "१४-९८-९२", "content_sanskrit": "बालाहिताग्नयो ये च शान्ताः शूद्रान्नवर्जिताः।\nमामर्चयन्ति तद्भक्तास्तेभ्यो दत्तमिहाक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2103500, "chapter_id": 3242, "verse_number": "१४-९८-९३", "content_sanskrit": "प्रदानैः पूजितो विप्रो वन्दितो वापि संस्कृतः।\nसम्भाषितो वा दृष्टो वा मद्भक्तो दिवमुन्नयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2103501, "chapter_id": 3242, "verse_number": "१४-९८-९४", "content_sanskrit": "ये पठन्ति नमस्यन्ति ध्यायन्ति पुरुषास्तु माम्।\nस तान्स्पृष्ट्वा च दृष्ट्वा च नरः पापैः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2103502, "chapter_id": 3242, "verse_number": "१४-९८-९५", "content_sanskrit": "मद्भक्ता मद्गतप्राणा मद्गीता मत्परायणाः।\nबीजयोनिविशुद्धा यै श्रोत्रियाः संयतेन्द्रियाः।\nशूद्रान्नविरता नित्यं ते पुनन्तीह दर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2103503, "chapter_id": 3242, "verse_number": "१४-९८-९६", "content_sanskrit": "स्वंय नीत्वा विशेषेण दानं तेषां गृहेष्वथ।\nनिवापयेत्तु यद्भक्त्या तद्दानं कोटिसंमितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2103504, "chapter_id": 3242, "verse_number": "१४-९८-९७", "content_sanskrit": "जाग्रतः स्वपतो वापि प्रवासेषु गृहेष्वथ।\nहृदये न प्रणश्यामि यस्य विप्रस्य भावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2103505, "chapter_id": 3242, "verse_number": "१४-९८-९८", "content_sanskrit": "स पूजितो वा दृष्टो वा स्पृष्टो वापि द्विजोत्तमः।\nसम्भाषितो वा राजेन्द्र पुनात्येव नरं सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2103506, "chapter_id": 3242, "verse_number": "१४-९८-९९", "content_sanskrit": "एवं सर्वास्ववस्थासु सर्वदानानि पाण्डव।\nमद्भक्तेभ्यः प्रदत्तानि स्वर्गमार्गप्रदानि वै॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2103507, "chapter_id": 3242, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि अष्टनवतितमोऽध्यायः॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}]