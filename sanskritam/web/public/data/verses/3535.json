[{"id": 2117752, "chapter_id": 3535, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117753, "chapter_id": 3535, "verse_number": "१", "content_sanskrit": "जित्वा तु पृथिवीं दैत्यौ निःसपत्नौ गतव्यथौ ।\nत्रैलोक्यं तु वशे कृत्वा कृतकृत्यौ बभूवतुः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117754, "chapter_id": 3535, "verse_number": "२", "content_sanskrit": "देवगन्धर्वयक्षाणां नागपार्थिवरक्षसाम् ।\nआदाय सर्वरत्नानि परां तुष्टिमुपागतौ \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117755, "chapter_id": 3535, "verse_number": "३", "content_sanskrit": "कृतं न प्रतिषेद्धारस्तयोर्येन क्रमेण च ।\nनिरुद्विग्नौ ततो भूत्वा विजह्राते यथाऽमरौ \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117756, "chapter_id": 3535, "verse_number": "४", "content_sanskrit": "स्त्रीभिर्माल्यैश्च गन्धैश्च भक्ष्यैर्भोज्यैश्च पुष्कळैः ।\nपानैश्च विविधैरन्यैः परां प्रीतिमवापतुः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117757, "chapter_id": 3535, "verse_number": "५", "content_sanskrit": "अन्तःपुरे वनोद्याने पर्वतोपवनेषु च ।\nयथेप्सितेषु देशेषु विजह्रातेऽमराविव \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117758, "chapter_id": 3535, "verse_number": "६", "content_sanskrit": "ततः कदाचिद् विन्ध्यस्य पृष्ठोत्तमशिलातळे ।\nपुष्पिताग्रेषु सालेषु विहारमभिजग्मतुः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117759, "chapter_id": 3535, "verse_number": "७", "content_sanskrit": "दिव्येषु सर्वकामेषु समानीतेषु तत्र तौ ।\nवरासनेषु संहृष्टौ सह स्त्रीभिर्निषीदतुः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117760, "chapter_id": 3535, "verse_number": "८", "content_sanskrit": "ततो वादित्रनृत्ताभ्यामुपातिष्ठंस्ततः स्त्रियः ।\nगीतैश्च स्तुतिसंयुक्तैः प्रीत्यर्थमुपजग्मिरे \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117761, "chapter_id": 3535, "verse_number": "९", "content_sanskrit": "ततस्तिलोत्तमा तस्मिन् वने पुष्पाणि चिन्वती ।\nवेषमादीप्तमाधाय रक्तेनैकेन वाससा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117762, "chapter_id": 3535, "verse_number": "१०", "content_sanskrit": "नदीतीरेषु जातान् सा कर्णिकारान् प्रचिन्वती ।\nशनैर्जगाम तं देशं यत्रास्तां तौ महासुरौ \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117763, "chapter_id": 3535, "verse_number": "११", "content_sanskrit": "तौ तु पीत्वा परं पानं मदरक्तान्तलोचनौ ।\nदृष्ट्वैव तां वरारोहां व्यथितौ सम्बभूवतुः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117764, "chapter_id": 3535, "verse_number": "१२", "content_sanskrit": "तावाप्लुत्यासनं हित्वा जग्मतुर्यत्र सा स्थिता ।\nउभौ च कामसम्प्राप्तावुभौ प्रार्थयतां च ताम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117765, "chapter_id": 3535, "verse_number": "१३", "content_sanskrit": "दक्षिणे च करे क्रूरः सुन्दो जग्राह पाणिना ।\nउपसुन्दोऽपि जग्राह वामे पाणौ तिलोत्तमाम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117766, "chapter_id": 3535, "verse_number": "१४", "content_sanskrit": "वरप्रदानमत्तौ तावौरसेन बलेन च ।\nधनरत्नमदाभ्यां च सुरपानमदेन च \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117767, "chapter_id": 3535, "verse_number": "१५", "content_sanskrit": "सर्वैरेतैर्मदैर्मत्तावन्योन्यभ्रुकुटीकृतौ ।\nतौ कटाक्षेण दैत्येन्द्रावाकर्षति मुहुर्मुहुः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117768, "chapter_id": 3535, "verse_number": "१६", "content_sanskrit": "दक्षिणेन कटाक्षेण सुन्दं जग्राह कामिनी ।\nवामेनैव कटाक्षेण उपसुन्दं जिघृक्षती \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117769, "chapter_id": 3535, "verse_number": "१७", "content_sanskrit": "गन्धाभरणरूपैस्तौ व्यामोहं जग्मतुस्तदा ।\nमदकामसमाविष्टावन्योन्यमिति होचतुः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117770, "chapter_id": 3535, "verse_number": "१८", "content_sanskrit": "मम भार्या तव गुरुरिति सुन्दोऽभ्यभाषत ।\nमम भार्या तव वधूरुपसुन्दोऽभ्यभाषत \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117771, "chapter_id": 3535, "verse_number": "१९", "content_sanskrit": "नैषा तव ममैषेति तत्र तौ मन्युराविशत् ।\nतस्या हेतोर्गदे भीमे तावुभावप्यगृह्णताम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117772, "chapter_id": 3535, "verse_number": "२०", "content_sanskrit": "तौ प्रगृह्य गदे भीमे तस्याः कामेन मोहितौ ।\nअहंपूर्वमहंपूर्वमित्यन्योन्यं निजघ्नतुः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117773, "chapter_id": 3535, "verse_number": "२१", "content_sanskrit": "तौ गदानिहतौ भीमौ पेततुर्धरणीतळे ।\nरुधिरेणैव लिप्ताङ्गौ द्वाविवार्कौ नभश्च्युतौ \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117774, "chapter_id": 3535, "verse_number": "२२", "content_sanskrit": "ततस्ता विद्रुता नार्यस्ते च दैत्यगणास्तदा ।\nपातालमगमन् सर्वे विषादभयशङ्किताः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117775, "chapter_id": 3535, "verse_number": "२३", "content_sanskrit": "ततः पितामहस्तत्र सहदेवैर्महर्षिभिः ।\nआजगाम विशुद्धात्मा पूजयिष्यंस्तिलोत्तमाम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117776, "chapter_id": 3535, "verse_number": "२४", "content_sanskrit": "वरेण च्छन्दिता सा च भगवत्प्रीतिमेव सा ।\nवरयामासाथ तत्रैतां प्रीतः प्राह पितामहः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117777, "chapter_id": 3535, "verse_number": "२५", "content_sanskrit": "आदित्यचरिताँल्लोकान् विचरिष्यसि तेजसा ।\nतेजसैव सुजुष्टां त्वां न हरिष्यति कश्चन \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2117778, "chapter_id": 3535, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2117779, "chapter_id": 3535, "verse_number": "२६", "content_sanskrit": "एवं तस्यै वरं दत्वा सर्वलोकपितामहः ।\nइन्द्रे त्रैलोक्यमाधाय ब्रह्मलोकं गतः प्रभुः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2117780, "chapter_id": 3535, "verse_number": "२७", "content_sanskrit": "एवं तौ सहितौ भूत्वा सर्वार्थेष्वेकनिश्चयौ ।\nतिलोत्तमार्थे सङ्क्रुद्धावन्योन्यमभिजघ्नतुः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2117781, "chapter_id": 3535, "verse_number": "२८", "content_sanskrit": "तस्माद् ब्रवीमि वः स्नेहात् सर्वान् भारतसत्तमान् ।\nयथा वो नात्र भेदः स्यात् सर्वेषां द्रौपदीकृते \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2117782, "chapter_id": 3535, "verse_number": "२९", "content_sanskrit": "तथा कुरुत भद्रं वो मम चेत् प्रियमिच्छथ ।\nयथा सुन्दोपसुन्दाभ्यां तथा न स्याद् युधिष्ठिर \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2117783, "chapter_id": 3535, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2117784, "chapter_id": 3535, "verse_number": "३०", "content_sanskrit": "एवमुक्ता महात्मानो नारदेन महर्षिणा ।\nसमयं चक्रिरे राजंस्तेऽन्योन्येन समागताः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2117785, "chapter_id": 3535, "verse_number": "३१", "content_sanskrit": "समक्षं तस्य देवर्षेर्नारदस्यामितौजसः ।\nएकैकस्य गृहे कृष्णा वसेद् वर्षमकल्मषा \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2117786, "chapter_id": 3535, "verse_number": "३२", "content_sanskrit": "द्रौपद्या च समासीनमन्योन्यं यो विदर्शयेत् ।\nस नो द्वादश वै मासान् व्रतचारी वने वसेत् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2117787, "chapter_id": 3535, "verse_number": "३३", "content_sanskrit": "कृते च समये तस्मिन् पाण्डवैर्धर्मचारिभिः ।\nततः स भगवांस्तत्र पाण्डवैरर्चितः प्रभुः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2117788, "chapter_id": 3535, "verse_number": "३४", "content_sanskrit": "निर्ययौ सुशुभे काले इन्द्रप्रस्थान्महातपाः ।\nनारदोऽप्यगमत् प्रीत इष्टं देशं महानृषिः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2117789, "chapter_id": 3535, "verse_number": "३५", "content_sanskrit": "एवं तैः समयः पूर्वं कृतो नारदचोदितैः ।\nयेन भेदं न जग्मुस्ते तदाऽन्योन्येन भारत \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2117790, "chapter_id": 3535, "verse_number": "३६", "content_sanskrit": "एतद् विस्तरशः सर्वमाख्यातं ते नरेश्वर ।\nकाले च तस्मिन् सम्पन्नं यथावज्जनमेजय \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2117791, "chapter_id": 3535, "verse_number": "२१४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचतुर्दशाधिकद्विशततमोऽध्यायः ॥२१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2117792, "chapter_id": 3535, "verse_number": "६", "content_sanskrit": "॥ इति राज्यलाभपर्वणि षष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2117793, "chapter_id": 3535, "verse_number": "", "content_sanskrit": "॥ समाप्तं राज्यलाभपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]