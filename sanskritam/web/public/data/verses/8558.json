: "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900007425, "chapter_id": 8558, "verse_number": "139.10", "content_sanskrit": "यदि तेऽपि निषिध्यन्ते किं नोक्तिस्ते निषिध्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900007426, "chapter_id": 8558, "verse_number": "139.11", "content_sanskrit": "यदुक्तवाक्यप्रामाण्यं प्रत्यक्षेणोपलभ्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900007427, "chapter_id": 8558, "verse_number": "139.12", "content_sanskrit": "अप्रामाण्यं तदुक्तेश्च वृथा वाचाऽवसीयते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900007428, "chapter_id": 8558, "verse_number": "139.13", "content_sanskrit": "वृथा वाचं वृथा हन्याद्यदि तस्य किमुत्तरम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900007429, "chapter_id": 8558, "verse_number": "139.14", "content_sanskrit": "स्वजीवनविरोधाय वदन्किन्नाम बुद्धिमान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]