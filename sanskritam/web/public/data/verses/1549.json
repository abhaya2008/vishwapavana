[{"id": 2025532, "chapter_id": 1549, "verse_number": "३-१८७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2025533, "chapter_id": 1549, "verse_number": "३-१८७-१", "content_sanskrit": "मार्कण्डेयं महात्मानमूचुः पाण्डुसुतास्तदा।\nमाहात्म्यं द्विजमुख्यानां श्रोतुमिच्छाम कथ्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2025534, "chapter_id": 1549, "verse_number": "३-१८७-२", "content_sanskrit": "एवमुक्तः स भगवान्मार्कण्डेयो महातपाः।\nउवाच सुमहातेजाः सर्वशास्त्रविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2025535, "chapter_id": 1549, "verse_number": "३-१८७-३", "content_sanskrit": "हेहयानां कुलकरो राजा परपुरंजयः।\nकुमारो रूपसंपननो मृगयां व्यचरद्बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2025536, "chapter_id": 1549, "verse_number": "३-१८७-४", "content_sanskrit": "चरमाणस्तु सोऽरण्ये तृणवीरुत्समावृते।\nकृष्णाजिनोत्तरासङ्गं ददर्श मुनिमन्तिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2025537, "chapter_id": 1549, "verse_number": "३-१८७-५", "content_sanskrit": "स तेन हिंसितोऽरण्ये मन्यमानेन वै मृगम्।\nव्यथितः कर्म तत्कृत्वा शोकोपहतचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2025538, "chapter_id": 1549, "verse_number": "३-१८७-६", "content_sanskrit": "जगाम हेहयानां वै सकाशं प्रथितात्मनाम्।\nराज्ञां राजीवनेत्रोसौ कुमारः पृथिवीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2025539, "chapter_id": 1549, "verse_number": "३-१८७-७", "content_sanskrit": "तेषां च तद्यथावृत्तं कथयामास वै तदा।\n`स कुमारो महीपालो हेहयानां महीभृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2025540, "chapter_id": 1549, "verse_number": "३-१८७-८", "content_sanskrit": "तं चापि हिंसितं तात मुनिं मूलफलाशिनम्।\nश्रुत्वा दृष्ट्वा च ते तत्र बभूवुर्दीनमानसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2025541, "chapter_id": 1549, "verse_number": "३-१८७-९", "content_sanskrit": "कस्यायमिति ते सर्वे मार्गमाणास्ततस्ततः।\nजग्मुश्चारिष्टनाम्नोऽथ तार्क्ष्यस्याश्रममञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2025542, "chapter_id": 1549, "verse_number": "३-१८७-१०", "content_sanskrit": "तेऽभिवाद्य महात्मानं तं मुनिं संशितव्रतम्।\nतस्थुः सर्वे स तु मुनिस्तेषां पूजामथाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2025543, "chapter_id": 1549, "verse_number": "३-१८७-११", "content_sanskrit": "ते तमूचुर्महात्मानं न वयं सक्रियां मुने।\nत्वत्तोऽर्हाः कर्मदोषेण ब्राह्मणो हिंसितो हि नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2025544, "chapter_id": 1549, "verse_number": "३-१८७-१२", "content_sanskrit": "तानब्रवीत्स विप्रर्षिः कथं वो ब्राह्मणो हतः।\nक्व चासौ ब्रूत सहिताः पश्यध्वं मे रतपोबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2025545, "chapter_id": 1549, "verse_number": "३-१८७-१३", "content_sanskrit": "ते तु तत्सर्वमखिलमाख्यायास्मै यथातथम्।\nनापश्यंस्तमृषिं तत्र गतासुं ते समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2025546, "chapter_id": 1549, "verse_number": "३-१८७-१४", "content_sanskrit": "अन्वेषमाणाः सव्रीडाः सुप्तवद्गतमानसाः।\nतानब्रवीत्तत्रमुनिस्तार्क्ष्यः परपुरंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2025547, "chapter_id": 1549, "verse_number": "३-१८७-१५", "content_sanskrit": "स्यादयं ब्राह्मणः सोऽथयुष्माभिर्यो विनाशितः।\nपुत्रो ह्ययं मम नृपास्तपोबलसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2025548, "chapter_id": 1549, "verse_number": "३-१८७-१६", "content_sanskrit": "ते च दृष्ट्वैव तमृषिं विस्मयं परमं गताः।\nमहदाश्चर्यमिति वै ते ब्रुवाणा महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2025549, "chapter_id": 1549, "verse_number": "३-१८७-१७", "content_sanskrit": "मृतो ह्ययमितो दृष्टः कथं जीवितमाप्तवान्।\nकिमेतत्तपसो वीर्यं येनायं जीवितः पुनः।\nश्रोतुमिच्छामहे विप्र यदि श्रोतव्यमित्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2025550, "chapter_id": 1549, "verse_number": "३-१८७-१८", "content_sanskrit": "स तानुवाच नास्माकं मृत्युः प्रभवते नृपाः।\nकारणं च प्रवक्ष्यामि हेतुयोगं समासतः।\n`मृत्युः प्रभवते येन नास्माकं नृपसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2025551, "chapter_id": 1549, "verse_number": "३-१८७-१९", "content_sanskrit": "शुद्धाचारादनलसाः साध्योपासनतत्पराः।\nशुद्धान्नाः शुद्धसदना ब्रह्मचर्यव्रतान्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2025552, "chapter_id": 1549, "verse_number": "३-१८७-२०", "content_sanskrit": "सत्यमेवाभिजानीमो नानृते कुर्महे मनः।\nस्वधर्ममनुतिष्ठामस्तस्मान्मृत्युभयं न नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2025553, "chapter_id": 1549, "verse_number": "३-१८७-२१", "content_sanskrit": "यद्ब्राह्मणानां कुशलं तदेषां कथयामहे।\nतेषां हि चरितं ब्रूमस्तस्मान्मृत्युभयं न नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2025554, "chapter_id": 1549, "verse_number": "३-१८७-२२", "content_sanskrit": "अतिथीनन्नपानेन भृत्यानत्यशनेन च।\nसंभोज्य शेषमश्नीमस्तस्मान्मृत्युभयं न नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2025555, "chapter_id": 1549, "verse_number": "३-१८७-२३", "content_sanskrit": "क्षान्ता दान्ताः क्षमाशीलास्तीर्थदानपरायणाः।\nपुण्यदेशनिवासाच्च तस्मान्मृत्युभयं न नः।\nतेजस्विदेशवासाच्च तस्मान्मृत्युभयं न नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2025556, "chapter_id": 1549, "verse_number": "३-१८७-२४", "content_sanskrit": "एतद्वै लेशमात्रं वः समाख्यातं विमत्सराः।\nगच्छध्वं सहिताः सर्वे न पापाद्भयमस्ति वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2025557, "chapter_id": 1549, "verse_number": "३-१८७-२५", "content_sanskrit": "एवमस्त्विति ते सर्वे प्रतिपूज्य महामुनिम्।\nस्वदेशमगमन्हृष्टा राजानो भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2025558, "chapter_id": 1549, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि सप्ताशीत्यधिकशततमोऽध्यायः ॥ १८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]