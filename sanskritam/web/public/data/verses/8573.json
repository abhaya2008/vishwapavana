[{"id": 900007549, "chapter_id": 8573, "verse_number": "154.1", "content_sanskrit": "ॐ स्तुतयेऽनुमतिर्वा ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007550, "chapter_id": 8573, "verse_number": "154.2", "content_sanskrit": "गुणहानिश्च नैवास्ति ब्रह्मणस्त्वविकर्मतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007551, "chapter_id": 8573, "verse_number": "154.3", "content_sanskrit": "प्राप्तह्रासो भवेत्क्त्वापि महता तु विकर्मणा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007552, "chapter_id": 8573, "verse_number": "154.4", "content_sanskrit": "ह्रासोऽपि मानुषादीनामानन्दस्य विकर्मणा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900007553, "chapter_id": 8573, "verse_number": "154.5", "content_sanskrit": "ॐ कामकारेण चैके ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900007554, "chapter_id": 8573, "verse_number": "154.6", "content_sanskrit": "देवादीनां यथाक्रमम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900007555, "chapter_id": 8573, "verse_number": "154.7", "content_sanskrit": "इत्युक्तनियमो भवेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900007556, "chapter_id": 8573, "verse_number": "154.8", "content_sanskrit": "एवमाद्यपि सम्प्रोक्तं तन्त्रभागवते स्फुटम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900007557, "chapter_id": 8573, "verse_number": "154.9", "content_sanskrit": "तारतम्यं फले नो चेद्ब्रह्मादीनां कथं श्रुतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900007558, "chapter_id": 8573, "verse_number": "154.10", "content_sanskrit": "संसार एव चेदेतत्तारतम्यं न मुख्यतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900007559, "chapter_id": 8573, "verse_number": "154.11", "content_sanskrit": "कामस्य यत्राप्ताः कामास्तत्र माममृतं कृधि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900007560, "chapter_id": 8573, "verse_number": "154.12", "content_sanskrit": "अप्रयत्नेन कामानामवाप्तिः सा यदा भवेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900007561, "chapter_id": 8573, "verse_number": "154.13", "content_sanskrit": "अव्यक्तिरेव कामानां न नाशो मोहसुप्तयोः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900007562, "chapter_id": 8573, "verse_number": "154.14", "content_sanskrit": "यत्कामः स्वापमाप्नोति तदेवोत्थापितः पुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900007563, "chapter_id": 8573, "verse_number": "154.15", "content_sanskrit": "सर्वकामानवाप्नोति ब्रह्मणा सह मुक्तिगः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]