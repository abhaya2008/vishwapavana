[{"id": 7006405000, "chapter_id": 26405, "verse_number": "२-६३-१", "content_sanskrit": "जनमेजय उवाच\nप्रत्येत्य द्वारकां विष्णुर्हते रुक्मिणि वीर्यवान् ।\nअकरोद् यन्महाबाहुस्तन्मे वद महामुने ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006405001, "chapter_id": 26405, "verse_number": "२-६३-२", "content_sanskrit": "वैशम्पायन उवाच\nस तैः परिवृतः श्रीमान् पुरी यादवनन्दनः ।\nद्वारकां भगवान् विष्णुः प्रत्यवैक्षत वीर्यवान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006405002, "chapter_id": 26405, "verse_number": "२-६३-३", "content_sanskrit": "प्रत्यपद्यत रत्नानि विविधानि वसूनि च ।\nयथाहं पुण्डरीकाक्षो नैर्ऋतान् प्रत्यवारयत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006405003, "chapter_id": 26405, "verse_number": "२-६३-४", "content_sanskrit": "तत्र विघ्नं चरन्ति स्म दैतेयाः सह दानवैः ।\nताञ्जघान महाबाहुर्वरदृप्तान् महासुरान् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006405004, "chapter_id": 26405, "verse_number": "२-६३-५", "content_sanskrit": "विघ्नं चास्याकरोत् तत्र नरको नाम दानवः ।\nत्रासनः सर्वदेवानां देवराजरिपुर्महान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006405005, "chapter_id": 26405, "verse_number": "२-६३-६", "content_sanskrit": "स भूमौ मूर्तिलिङ्गस्थः सर्वदेवाधिबाधिता ।\nदेवतानामृषीणां च प्रतीपमकरोत् तदा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006405006, "chapter_id": 26405, "verse_number": "२-६३-७", "content_sanskrit": "त्वष्टुर्दुहितरं भौमः कशेरुमगमत् तदा ।\nगजरूपेण जग्राह रुचिराङ्गीं चतुर्दशीम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006405007, "chapter_id": 26405, "verse_number": "२-६३-८", "content_sanskrit": "प्रमथ्य तां वरारोहां नरको वाक्यमब्रवीत् ।\nनष्टशोकभयो मोहात् प्राग्ज्योतिषपतिस्तदा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006405008, "chapter_id": 26405, "verse_number": "२-६३-९", "content_sanskrit": "यानि देवमनुष्येषु रत्नानि विविधानि च ।\nबिभर्ति च मही कृत्स्ना सागरेषु च यद् वसु ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006405009, "chapter_id": 26405, "verse_number": "२-६३-१०", "content_sanskrit": "अद्यप्रभृति तानीह सहिताः सर्वनैर्ऋताः ।\nतवैवोपाहरिष्यन्ति दैत्याश्च सह दानवैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006405010, "chapter_id": 26405, "verse_number": "२-६३-११", "content_sanskrit": "एवमुत्तमरत्नानि वस्त्राणि विविधानि च ।\nस जहार तदा भौमस्तच्च नाधिचकार सः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006405011, "chapter_id": 26405, "verse_number": "२-६३-१२", "content_sanskrit": "गन्धर्वाणां च याः कन्या जहार नरको बली ।\nयाश्च देवमनुष्याणां सप्त चाप्सरसां गणाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006405012, "chapter_id": 26405, "verse_number": "२-६३-१३", "content_sanskrit": "चतुर्दश सहस्राणि एकविंशच्छतानि च ।\nएकवेणीधराः सर्वाः सतीमार्गमनुव्रताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006405013, "chapter_id": 26405, "verse_number": "२-६३-१४", "content_sanskrit": "वैशम्पायन उवाच\nतासां पुरवरं भौमोऽकारयन्मणिपर्वतम् ।\nअलकायामदीनात्मा मुरो स्वविषयं प्रति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006405014, "chapter_id": 26405, "verse_number": "२-६३-१५", "content_sanskrit": "ताश्च प्राग्ज्योतिषपतिं मुरोश्चैव दशात्मजाः ।\nनैर्ऋताश्च यथा मुख्याः पालयन्त उपासते ।\nस एष तपसः पारे वरदृप्तो महासुरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006405015, "chapter_id": 26405, "verse_number": "२-६३-१६", "content_sanskrit": "न चासुरगणैः सर्वैः सहितैः कर्म तत् पुरा ।\nकृतपूर्वं तदा घोरं यदकार्षीन्महासुरः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006405016, "chapter_id": 26405, "verse_number": "२-६३-१७", "content_sanskrit": "अदितिं धर्षयामास कुण्डलार्थे महासुरः ।\nयं मही सुषुवे देवी यस्य प्राग्ज्योतिषं पुरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006405017, "chapter_id": 26405, "verse_number": "२-६३-१८", "content_sanskrit": "द्वारपालाश्च चत्वारस्तस्यासन् युद्धदुर्मदाः ।\nहयग्रीवो निसुन्दश्च वीरः पञ्चनदस्तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006405018, "chapter_id": 26405, "verse_number": "२-६३-१९", "content_sanskrit": "मुरुः पुत्रसहस्रैश्च वरदत्तोऽसुरो महान् ।\nआदेवयानमावृत्य पन्थानं समुपस्थितः ।\nवित्रासनः सुकृतिनां विरूपै राक्षसैः सह ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006405019, "chapter_id": 26405, "verse_number": "२-६३-२०", "content_sanskrit": "तद्वधार्थं महाबाहुः शङ्खचक्रगदासिभृत् ।\nजातो वृष्णिषु देवक्यां वसुदेवाज्जनार्दनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006405020, "chapter_id": 26405, "verse_number": "२-६३-२१", "content_sanskrit": "तस्याथ पुरुषेन्द्रस्य लोकप्रथिततेजसः ।\nनिवासो द्वारका देवैरुपायादुपपादिता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006405021, "chapter_id": 26405, "verse_number": "२-६३-२२", "content_sanskrit": "अतीव हि पुरी रम्या द्वारका वासवक्षयात् ।\nमहार्णवपरिक्षिप्ता पञ्चपर्वतशोभिता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006405022, "chapter_id": 26405, "verse_number": "२-६३-२३", "content_sanskrit": "तस्यां देवपुराभायां सभा काञ्चनतोरणा ।\nसा दाशार्हीति विख्याता योजनायामविस्तृता ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006405023, "chapter_id": 26405, "verse_number": "२-६३-२४", "content_sanskrit": "तत्र वृष्ण्यन्धकाः सर्वे रामकृष्णपुरोगमाः ।\nलोकयात्रामिमां कृत्स्नां परिरक्षन्त आसते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006405024, "chapter_id": 26405, "verse_number": "२-६३-२५", "content_sanskrit": "तत्रासीनेषु सर्वेषु कदाचिद् भरतर्षभ ।\nदिव्यगन्धो ववौ वायुः पुष्पवर्षं पपात ह ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006405025, "chapter_id": 26405, "verse_number": "२-६३-२६", "content_sanskrit": "ततः किलकिलाशब्दः प्रभाजालाभिसंवृतः ।\nमुहूर्तमन्तरिक्षेऽभूत् ततो भूमौ प्रतिष्ठितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006405026, "chapter_id": 26405, "verse_number": "२-६३-२७", "content_sanskrit": "मध्ये तु तेजसस्तस्य पाण्डुरं गजमास्थितः ।\nवृतो देवगणैः सर्वैर्वासवः समदृश्यत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006405027, "chapter_id": 26405, "verse_number": "२-६३-२८", "content_sanskrit": "रामकृष्णौ च राजा स वृष्ण्यन्धकगणैः सह ।\nप्रत्युद्ययुर्महात्मानं पूजयन्तः सुरेश्वरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006405028, "chapter_id": 26405, "verse_number": "२-६३-२९", "content_sanskrit": "सोऽवर्तार्य गजात् तूर्णं परिष्वज्य जनार्दनम् ।\nसस्वजे बलदेवं च तं च राजानमाहुकम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006405029, "chapter_id": 26405, "verse_number": "२-६३-३०", "content_sanskrit": "वृष्णीनन्यान् सस्वजे च यथाकालं यथावयः ।\nपूजितो रामकृष्णाभ्यामाविवेश स तां सभाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006405030, "chapter_id": 26405, "verse_number": "२-६३-३१", "content_sanskrit": "तत्रासीनोऽभ्यलंकृत्वा सभां ताममरेश्वरः ।\nअर्घ्यादिसमुदाचारं प्रत्यगृह्णाद् यथाविधि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006405031, "chapter_id": 26405, "verse_number": "२-६३-३२", "content_sanskrit": "वैशम्पायन उवाच\nअथोवाच महातेजा वासवो वासवानुजम्।\nसान्त्वपूर्वं करेणास्य संस्पृश्य वदनं शुभम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006405032, "chapter_id": 26405, "verse_number": "२-६३-३३", "content_sanskrit": "देवकीनन्दन वचः शृणु मे मधुसूदन ।\nयेन त्वाभिगतोऽस्म्यद्य कार्येणामित्रकर्शन ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006405033, "chapter_id": 26405, "verse_number": "२-६३-३४", "content_sanskrit": "नैर्ऋतो नरको नाम ब्रह्मणो वरदर्पितः ।\nअदित्याः कुण्डले मोहाज्जहार दितिनन्दनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006405034, "chapter_id": 26405, "verse_number": "२-६३-३५", "content_sanskrit": "देवानां विप्रिये नित्यमृषीणां च स वर्तते ।\nतं च देवान्तरं प्रेक्ष्य जहि त्वं पापपूरुषम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006405035, "chapter_id": 26405, "verse_number": "२-६३-३६", "content_sanskrit": "अयं त्वां गरुडस्तत्र प्रापयिष्यति कामगः ।\nकामवीर्योऽतितेजस्वी वैनतेयोऽन्तरिक्षगः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006405036, "chapter_id": 26405, "verse_number": "२-६३-३७", "content_sanskrit": "अवध्यः सर्वभूतानां भौमः स नरकोऽसुरः ।\nनिषूदयित्वा तं पापं क्षिप्रमागन्तुमर्हसि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006405037, "chapter_id": 26405, "verse_number": "२-६३-३८", "content_sanskrit": "इत्युक्तः पुण्डरीकाक्षो देवराजेन केशवः ।\nप्रतिजज्ञे महाबाहुर्नरकस्य निबर्हणे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006405038, "chapter_id": 26405, "verse_number": "२-६३-३९", "content_sanskrit": "ततः सहैव शक्रेण शङ्खचक्रगदासिभृत् ।\nप्रतस्थे गरुडेनाथ सत्यभाभासहायवान् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006405039, "chapter_id": 26405, "verse_number": "२-६३-४०", "content_sanskrit": "क्रमेण सप्तस्कन्धान् स मरुतां सहवासवः ।\nपश्यतां यदुसिंहानामूर्ध्वमाचक्रमे बली ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006405040, "chapter_id": 26405, "verse_number": "२-६३-४१", "content_sanskrit": "वारणेन्द्रगतः शक्रो गरुडस्थो जनार्दनः ।\nविदूरत्वात् प्रकाशेते सूर्याचन्द्रमसाविव ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006405041, "chapter_id": 26405, "verse_number": "२-६३-४२", "content_sanskrit": "अन्तरिक्षे च गन्धर्वैरप्सरोभिश्च केशवः ।\nस्तूयमानोऽथ शक्रश्च क्रमेणान्तरधीयत ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006405042, "chapter_id": 26405, "verse_number": "२-६३-४३", "content_sanskrit": "समाधायेतिकर्तव्यं वासवो विबुधाधिपः ।\nस्वमेव भवनं प्रायात् कृष्णः प्राग्ज्योतिषं प्रति ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006405043, "chapter_id": 26405, "verse_number": "२-६३-४४", "content_sanskrit": "पक्षानिलहतो वायुः प्रतिलोमं ववौ तदा ।\nततो भीमरवा मेघा बभ्रमुर्गगनेचराः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006405044, "chapter_id": 26405, "verse_number": "२-६३-४५", "content_sanskrit": "क्षणेन समनुप्राप्तो द्विजेनाकाशगेन वै ।\nदूरादेव च तान् दृष्ट्वा प्रययौ यत्र ते स्थिताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006405045, "chapter_id": 26405, "verse_number": "२-६३-४६", "content_sanskrit": "अपश्यद् द्वारि तत्रस्थां हस्त्यश्वरथवाहिनीम् ।\nक्षुरान्तान् मौरवान्पाशान् षट्सहस्रान्ददर्श ह॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006405046, "chapter_id": 26405, "verse_number": "२-६३-४७", "content_sanskrit": "वैशम्पायन उवाच\nगरुडस्योपरि श्रीमाञ्छङ्खचक्रगदाधरः ।\nबिभ्रन्नीलाम्बुदाकारं पीतवासाश्चतुर्भुजः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006405047, "chapter_id": 26405, "verse_number": "२-६३-४८", "content_sanskrit": "वनमालाकुलोरस्कः श्रीवत्साङ्कितभूषणः ।\nकिरीटमूर्द्धा सूर्याभः सविद्युदिव चन्द्रमाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006405048, "chapter_id": 26405, "verse_number": "२-६३-४९", "content_sanskrit": "ज्यां विकूजन्महाशब्दः श्रूयतेऽशनिनिःस्वनः ।\nज्ञात्वा च दानवः सर्वं स्वयं विष्णुरिहागतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006405049, "chapter_id": 26405, "verse_number": "२-६३-५०", "content_sanskrit": "क्रोधाद् द्विगुणरक्ताक्षो मुरुः कालान्तकोपमः ।\nअभ्यधावत वेगेन शक्तिं गृह्य महासुरः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006405050, "chapter_id": 26405, "verse_number": "२-६३-५१", "content_sanskrit": "चिक्षेप सुमहाशक्तिं वज्रकाञ्चनभूषिताम् ।\nतामापतन्तीं शक्तिं तु महोल्कां ज्वलितामिव ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006405051, "chapter_id": 26405, "verse_number": "२-६३-५२", "content_sanskrit": "समाधत्त शरं चैकं रुक्मपुङ्खं जनार्दनः ।\nद्विधाच्छिनत्क्षुरप्रेण वासुदेवः स वीर्यवान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006405052, "chapter_id": 26405, "verse_number": "२-६३-५३", "content_sanskrit": "शक्तिं चिच्छेद तत्रासौ विद्युत्पुञ्ज इव ज्वलन् ।\nपुनश्च क्रोधरक्ताक्षो मुरुर्गृह्य महागदाम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006405053, "chapter_id": 26405, "verse_number": "२-६३-५४", "content_sanskrit": "इन्द्राशनिरिवेन्द्रेण विकृष्ट इव निःस्वनः ।\nआकर्णमुक्तं चिक्षेप अर्धचन्द्रं सुरोत्तमः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006405054, "chapter_id": 26405, "verse_number": "२-६३-५५", "content_sanskrit": "मध्यदेशे तु चिच्छेद गदां तां रुक्मभूषिताम् ।\nपुनश्चिच्छेद भल्लेन दानवस्य शिरो रणे ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006405055, "chapter_id": 26405, "verse_number": "२-६३-५६", "content_sanskrit": "संछिद्य पाशान् सर्वांस्तान् मुरुं हत्वा सबान्धवम् ।\nसोऽग्र्यान्रक्षोगणान् हत्वा नरकस्य महाबलान् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006405056, "chapter_id": 26405, "verse_number": "२-६३-५७", "content_sanskrit": "शिलासंघानतिक्रम्य भगवान् देवकीसुतः ।\nअपश्यद् दानवं सैन्यं निसुन्दं च महाबलम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006405057, "chapter_id": 26405, "verse_number": "२-६३-५८", "content_sanskrit": "हयग्रीवं च दितिजं तथान्यांश्चित्रयोधिनः ।\nरोधयामास तन्मार्गं स्वसैन्येन महाबलः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006405058, "chapter_id": 26405, "verse_number": "२-६३-५९", "content_sanskrit": "निसुन्दो बलिनां श्रेष्ठो रथमारुह्य सत्वरम् ।\nजग्राह कार्मुकं दिव्यं हेमपृष्ठं दुरासदम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006405059, "chapter_id": 26405, "verse_number": "२-६३-६०", "content_sanskrit": "विव्याध दशभिर्बाणैर्निसुन्दो मधुसूदनम् ।\nकेशवश्चापि सप्तत्या विव्याध निशितैः शरैः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006405060, "chapter_id": 26405, "verse_number": "२-६३-६१", "content_sanskrit": "अप्राप्तांश्चान्तरिक्षे ताञ्छरांश्चिच्छेद माधवः ।\nते सर्वे सैनिकाः कृष्णं समन्तात्पर्यवारयन् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006405061, "chapter_id": 26405, "verse_number": "२-६३-६२", "content_sanskrit": "शरजालेन महता छाद्यमानः सुरोत्तमः ।\nदृष्ट्वा तान्दानवान्सर्वान्सक्रोधो मधुसूदनः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006405062, "chapter_id": 26405, "verse_number": "२-६३-६३", "content_sanskrit": "ततो दिव्येन चास्त्रेण पार्जन्येन जनार्दनः ।\nमहता शरवर्षेण वारयामास तद्बलम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006405063, "chapter_id": 26405, "verse_number": "२-६३-६४", "content_sanskrit": "पञ्चपञ्चशरैस्तेषु एकैकेन च तान् बहून् ।\nपार्जन्यस्य प्रभावेण सर्वान् मर्मस्वताडयत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006405064, "chapter_id": 26405, "verse_number": "२-६३-६५", "content_sanskrit": "दुद्रुवुर्भयसंत्रस्ता भग्नास्ते दानवा रणे ।\nस्वसैन्यं विद्रुतं दृष्ट्वा निश्चक्राम पुनर्मृधे ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006405065, "chapter_id": 26405, "verse_number": "२-६३-६६", "content_sanskrit": "विसृजञ्छरवर्षाणि छादयामास केशवम् ।\nन विभाति रणे सूर्यो नापि व्योम दिशो दश ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006405066, "chapter_id": 26405, "verse_number": "२-६३-६७", "content_sanskrit": "शरैः संछादयामास निसुन्दो गरुडध्वजम् ।\nसावित्रं नाम दिव्यास्त्रं जग्राह पुरुषोत्तमः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006405067, "chapter_id": 26405, "verse_number": "२-६३-६८", "content_sanskrit": "तेन बाणेन तान् बाणांश्चिच्छेद समरे हरिः ।\nबाणैर्बाणांश्च संच्छिद्य तस्य कृष्णो महाबलः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006405068, "chapter_id": 26405, "verse_number": "२-६३-६९", "content_sanskrit": "छत्रमेकेन बाणेन रथेषां च त्रिभिः शरैः ।\nपुनश्चिच्छेद तानश्वांश्चतुर्भिश्चतुरः शरैः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006405069, "chapter_id": 26405, "verse_number": "२-६३-७०", "content_sanskrit": "सारथिं पञ्चभिर्बाणैर्ध्वजमेकेन चिच्छिदे ।\nशरैकेन वपुः कृष्णः सुतीक्ष्णेन शितेन वै ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006405070, "chapter_id": 26405, "verse_number": "२-६३-७१", "content_sanskrit": "शिरश्चिच्छेद भल्लेन निसुन्दस्य सुरोत्तमः ।\nयः सहस्रसमास्त्वेकः सर्वान् देवानयोधयत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006405071, "chapter_id": 26405, "verse_number": "२-६३-७२", "content_sanskrit": "निसुन्दं पतितं दृष्ट्वा हयग्रीवः प्रतापवान् ।\nशिलां प्रगृह्य महतीं तोलयामास दानवः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006405072, "chapter_id": 26405, "verse_number": "२-६३-७३", "content_sanskrit": "आविध्य सहसा मुञ्चच्छिलां शैलसमां प्रभुः ।\nगृहीत्वा दिव्यपार्जन्यमस्त्रमस्त्रविदां वरः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006405073, "chapter_id": 26405, "verse_number": "२-६३-७४", "content_sanskrit": "दिव्यास्त्रेण शिलां विष्णुः सप्तधाकृत तेजसा ।\nतद् विदार्य महच्चाश्म पातयामास भूतले ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006405074, "chapter_id": 26405, "verse_number": "२-६३-७५", "content_sanskrit": "ततस्तैः शार्ङ्गनिर्मुक्तैर्नानावर्णैर्महाशरैः ।\nयथा देवासुरं युद्धमभवद् भरतर्षभ ।\nनानाप्रहरणाकीर्णं तथा घोरमवर्तत ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006405075, "chapter_id": 26405, "verse_number": "२-६३-७६", "content_sanskrit": "ततः शार्ङ्गविनिर्मुक्तैर्नानावर्णैर्महाशरै ।\nगरुडस्थो महाबाहुर्निजघान महासुरान् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006405076, "chapter_id": 26405, "verse_number": "२-६३-७७", "content_sanskrit": "महालाङ्गलनिर्भिन्नाः शङ्खशक्तिनिपातिताः ।\nविनेशुर्दानवाः सर्वे समासाद्य जनार्दनम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006405077, "chapter_id": 26405, "verse_number": "२-६३-७८", "content_sanskrit": "केचिच्चक्राग्निनिर्दग्धा दानवाः पेतुरम्बरात् ।\nसंनिकर्षगताः केचिद् गतासुविकृताननाः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006405078, "chapter_id": 26405, "verse_number": "२-६३-७९", "content_sanskrit": "असृजञ्छरवर्षाणि वृष्टिमन्त इवाम्बुदाः ।\nविकृताङ्गासुराः सर्वे कृष्णबाणप्रपीडिताः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006405079, "chapter_id": 26405, "verse_number": "२-६३-८०", "content_sanskrit": "शोणिताक्ताः स्म दृश्यन्ते पुष्पिता इव किंशुकाः।\nव्यद्रवन्त सुवित्रस्ता भग्नास्त्राश्चित्रयोधिनः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006405080, "chapter_id": 26405, "verse_number": "२-६३-८१", "content_sanskrit": "पुनश्च क्रोधरक्ताक्षो वायुवेगेन दानवः ।\nदशव्यामोच्छ्रितं वृक्षं समारुह्य वनस्पतिम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006405081, "chapter_id": 26405, "verse_number": "२-६३-८२", "content_sanskrit": "वृक्षमुत्पाट्य वेगेन प्रतिगृह्याभ्यधावत ।\nचिक्षेप स महावृक्षं शिक्षया सुघनाकृतिः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006405082, "chapter_id": 26405, "verse_number": "२-६३-८३", "content_sanskrit": "वृक्षवेगानिलोद्भूतः शुश्रुवे सुमहास्वनः ।\nततः शरसहस्रेण यतमानो जनार्दनः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006405083, "chapter_id": 26405, "verse_number": "२-६३-८४", "content_sanskrit": "नैकधा तं प्रचिच्छेद चित्रभानुनिभाकृतिम् ।\nपुनश्चैकेन बाणेन हयग्रीवस्य चोरसि ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006405084, "chapter_id": 26405, "verse_number": "२-६३-८५", "content_sanskrit": "विव्याध स्तनयोर्मध्ये सायको ज्वलनप्रभः ।\nविवेश सोऽपि वेगेन हृदं भित्त्वा विनिर्गतः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006405085, "chapter_id": 26405, "verse_number": "२-६३-८६", "content_sanskrit": "तं जघान महाघोरं हयग्रीवं महाबलम् ।\nअपारतेजा दुर्द्धर्षः स वै यादवनन्दनः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006405086, "chapter_id": 26405, "verse_number": "२-६३-८७", "content_sanskrit": "मध्ये लोहितगङ्गस्य भगवान् देवकीसुतः ।\nऔदकायां विरूपाक्षं पाप्मानं पुरुषोत्तमः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006405087, "chapter_id": 26405, "verse_number": "२-६३-८८", "content_sanskrit": "अष्टौ शतसहस्राणि दानवानां परंतपः ।\nनिहत्य पुरुषव्याघ्रः प्राग्ज्योतिषमुपाद्रवत् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006405088, "chapter_id": 26405, "verse_number": "२-६३-८९", "content_sanskrit": "हत्वा पञ्चनदं नाम नरकस्य महासुरम् ।\nततः प्राग्ज्योतिषं नाम दीप्यमानमिव श्रिया ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006405089, "chapter_id": 26405, "verse_number": "२-६३-९०", "content_sanskrit": "पुरमासादयामास युद्धं तत्राभवन्महत् ।\nततः प्राध्मापयच्छङ्खं पाञ्चजन्यं महाबलः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006405090, "chapter_id": 26405, "verse_number": "२-६३-९१", "content_sanskrit": "शुश्रुवे सुमहाशब्दः संवर्तनिनदो यथा ।\nश्रूयते त्रिषु लोकेषु भीमगम्भीरनिःस्वनः ।\nतं श्रुत्वा नरकश्चासीत् क्रोधसंरक्तलोचनः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006405091, "chapter_id": 26405, "verse_number": "२-६३-९२", "content_sanskrit": "लोहचक्राष्टसंयुक्तं विनल्वप्रतिमं रथम् ।\nरत्नकाञ्चनचित्राढ्यं वेदिकाभोगविस्तरम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006405092, "chapter_id": 26405, "verse_number": "२-६३-९३", "content_sanskrit": "वज्रध्वजेन महता काञ्चनेन विराजितम् ।\nहेमदण्डपताकाढ्यं वैदूर्यमणिकूबरम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006405093, "chapter_id": 26405, "verse_number": "२-६३-९४", "content_sanskrit": "युक्तमश्वसहस्रेण रथं पररथारुजम् ।\nलोहजालैश्च संछन्नं चित्रभक्तिविराजितम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006405094, "chapter_id": 26405, "verse_number": "२-६३-९५", "content_sanskrit": "रथमध्यगतो वीरः ससंध्य इव भास्करः ।\nनानाप्रहरणाकीर्णं रथं हेमपरिष्कृतम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006405095, "chapter_id": 26405, "verse_number": "२-६३-९६", "content_sanskrit": "वज्रं तथोरच्छदमिन्दुवर्णं व्यानद्धमुक्तानलतुल्यतेजाः ।\nकिरीटमूर्द्धार्कहुताशनाभः कर्णौ तथा कुण्डलयोर्ज्वलन्तौ ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006405096, "chapter_id": 26405, "verse_number": "२-६३-९७", "content_sanskrit": "धूम्रवर्णा महाकाया रक्ताक्षा विकृताननाः ।\nनानाकवचिनः सर्वे दैत्यदानवराक्षसाः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006405097, "chapter_id": 26405, "verse_number": "२-६३-९८", "content_sanskrit": "खड्गचर्मधराः केचित् केचित् तूणधनुर्भृतः ।\nशक्तिहस्तास्तथा केचिच्छूलहस्तास्तथापरे ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006405098, "chapter_id": 26405, "verse_number": "२-६३-९९", "content_sanskrit": "गजवाजिरथौघैश्च चालयन्तश्च मेदिनीम् ।\nनिर्ययुर्नगरात् सर्वे सुसंनद्धाः प्रहारिणः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006405099, "chapter_id": 26405, "verse_number": "२-६३-१००", "content_sanskrit": "वृतो दैत्यगणैः सार्द्धं नरकः कालसंनिभः ।\nभेरीशङ्खमृदङ्गानां पणवानां सहस्रशः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006405100, "chapter_id": 26405, "verse_number": "२-६३-१०१", "content_sanskrit": "शुश्राव वाद्यमानानां जीमूतनिनदोपमम् ।\nयतः कृष्णस्ततो गत्वा सर्वे ते विकृताननाः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006405101, "chapter_id": 26405, "verse_number": "२-६३-१०२", "content_sanskrit": "परिवार्य गरुत्मन्तं सर्वेऽयुध्यन्त संगताः ।\nमहता छादयामासुः शरवर्षेण सैनिकाः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006405102, "chapter_id": 26405, "verse_number": "२-६३-१०३", "content_sanskrit": "शक्तिशूलगदाप्रासांस्तोमरान्सायकान्बहून् ।\nआकाशं छादयामासुर्विमुञ्चन्तः सहस्रशः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006405103, "chapter_id": 26405, "verse_number": "२-६३-१०४", "content_sanskrit": "कृष्णः कृष्णाम्बुदाकारः शार्ङ्गं गृह्य धनुस्ततः ।\nविस्फार्य सुमहच्चापं धनुर्जलदनिःस्वनम् ॥१०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006405104, "chapter_id": 26405, "verse_number": "२-६३-१०५", "content_sanskrit": "व्यसृजच्छरवर्षाणि दानवानां जनार्दनः ।\nशरवर्षेण तत्सैन्यं व्यद्रवत् तु महाहवात् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006405105, "chapter_id": 26405, "verse_number": "२-६३-१०६", "content_sanskrit": "तद् युद्धमभवद् घोरं घोररूपेण रक्षसा ।\nभग्नव्यूहाश्च ते सर्वे कृष्णबाणप्रपीडिताः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7006405106, "chapter_id": 26405, "verse_number": "२-६३-१०७", "content_sanskrit": "केचिच्छिन्नभुजाश्चैव च्छिन्नग्रीवाशिराननाः ।\nकेचिच्चक्रद्विधाच्छिन्नाः केचिद् बाणार्दितोरसः॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7006405107, "chapter_id": 26405, "verse_number": "२-६३-१०८", "content_sanskrit": "केचिद् द्विधाकृताः शक्त्या गजाश्वरथवाहनाः ।\nकेचित्कौमोदकीभिन्नाः केचिच्चक्रविदारिताः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7006405108, "chapter_id": 26405, "verse_number": "२-६३-१०९", "content_sanskrit": "एवं विमथिता सर्वा नराश्वरथवाहिनी ।\nतत्रासीन्नरकेणास्य युद्धं परमदारुणम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7006405109, "chapter_id": 26405, "verse_number": "२-६३-११०", "content_sanskrit": "यत् समासेन वक्ष्यामि तन्मे निगदतः शृणु ।\nत्रासनः सुरसंघानां नरकः पुरुषोत्तमम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7006405110, "chapter_id": 26405, "verse_number": "२-६३-१११", "content_sanskrit": "योधयामास तेजस्वी मधुवन्मधुसूदनम् ।\nक्रोधरक्तान्तनयनो नरको घनसंनिभः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7006405111, "chapter_id": 26405, "verse_number": "२-६३-११२", "content_sanskrit": "जग्राह कार्मुकं वीरः शक्रचापमिवोच्छ्रितम् ।\nतथार्ककिरणप्रख्यं बाणं जग्राह केशवः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7006405112, "chapter_id": 26405, "verse_number": "२-६३-११३", "content_sanskrit": "दिव्येनास्त्रेण समरे पूरयामास तं रथम् ।\nउत्तमास्त्रं महापातं मुमोच नरको बली ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7006405113, "chapter_id": 26405, "verse_number": "२-६३-११४", "content_sanskrit": "बज्रविस्कूर्जिताकारमायान्तं वीक्ष्य केशवः ।\nचिच्छेदास्त्रं महाभागश्चक्रेण मधुसूदनः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7006405114, "chapter_id": 26405, "verse_number": "२-६३-११५", "content_sanskrit": "व्यहनत् सारथिं चास्य शरैकेण जनार्दनः ।\nस रथं सध्वजं साश्वं जघान दशभिः शरैः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7006405115, "chapter_id": 26405, "verse_number": "२-६३-११६", "content_sanskrit": "तनुत्रं चैव चिच्छेद शरेण मधुसूदनः ।\nततो विमुक्तकवचः सर्पस्येव तनुर्यथा ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7006405116, "chapter_id": 26405, "verse_number": "२-६३-११७", "content_sanskrit": "हताश्वोऽपि रणे वीरो वितनुत्रश्च दानवः ।\nजग्राह विमलज्वालं लोहभारार्पितं दृढम् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7006405117, "chapter_id": 26405, "verse_number": "२-६३-११८", "content_sanskrit": "आविध्य सहसा मुक्तं शूलमिन्द्राशनिप्रभम् ।\nतदापतत् स सम्प्रेक्ष्य शूलं हेमपरिष्कृतम् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7006405118, "chapter_id": 26405, "verse_number": "२-६३-११९", "content_sanskrit": "द्विधा छिन्नं क्षुरप्रेण कृष्णेनाद्भुतकर्मणा ।\nतद् युद्धमभवद् घोरं घोररूपेण रक्षसा ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7006405119, "chapter_id": 26405, "verse_number": "२-६३-१२०", "content_sanskrit": "शस्त्रपातमहाघातं नरकेण महात्मना ।\nमुहूर्तं योधयामास नरकं मधुसूदनः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7006405120, "chapter_id": 26405, "verse_number": "२-६३-१२१", "content_sanskrit": "अथोग्रचक्रश्चक्रेण प्रदीप्तेनाकरोद् द्विधा ।\nचक्रद्विधाकृतं तस्य शरीरमपतद् भुवि ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7006405121, "chapter_id": 26405, "verse_number": "२-६३-१२२", "content_sanskrit": "विभक्तं कुलिशेनैव गिरेः शृङ्गं द्विधाकृतम् ।\nकृष्णमासाद्य देवेशं जगामास्तमिवांशुमान् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7006405122, "chapter_id": 26405, "verse_number": "२-६३-१२३", "content_sanskrit": "चक्रोत्कृन्तितगात्रोऽसौ दानवः पतितो रणे ।\nवज्रप्रहारनिर्भिन्नं यथा गैरिकपर्वतम् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7006405123, "chapter_id": 26405, "verse_number": "२-६३-१२४", "content_sanskrit": "भूमिस्तु पतितं पुत्रं निरीक्ष्यादाय कुण्डले ।\nउपातिष्ठत गोविन्दं वचनं चेदमब्रवीत् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7006405124, "chapter_id": 26405, "verse_number": "२-६३-१२५", "content_sanskrit": "दत्तस्त्वयैव गोविन्द त्वयैव विनिपातितः ।\nयथेच्छसि तथा क्रीड बालः क्रीडनकैरिव ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7006405125, "chapter_id": 26405, "verse_number": "२-६३-१२६", "content_sanskrit": "इमे ते कुण्डले देव प्रजास्तस्यानुपालय ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}]