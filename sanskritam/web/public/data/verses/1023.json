[{"id": 2001443, "chapter_id": 1023, "verse_number": "१-२४-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001444, "chapter_id": 1023, "verse_number": "१-२४-१", "content_sanskrit": "स श्रुत्वाऽथात्मनो देहं सुपर्णः प्रेक्ष्य च स्वयम्।\nशरीरप्रतिसंहारमात्मनः संप्रचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001445, "chapter_id": 1023, "verse_number": "१-२४-२x", "content_sanskrit": "सुपर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001446, "chapter_id": 1023, "verse_number": "१-२४-२", "content_sanskrit": "न मे सर्वाणि भूतानि विभियुर्देहदर्शनात्।\nभीमरूपात्समुद्विग्रास्तस्मात्तेजस्तु संहरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001447, "chapter_id": 1023, "verse_number": "१-२४-३x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001448, "chapter_id": 1023, "verse_number": "१-२४-३", "content_sanskrit": "ततः कामगमः पक्षी कामवीर्यो विहंगमः।\nअरुणं चात्मनः पृष्ठमारोप्य स पितुर्गृहात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001449, "chapter_id": 1023, "verse_number": "१-२४-४", "content_sanskrit": "मातुरन्तिकमागच्छत्परं तीरं महोदधेः।\nतत्रारुणश्च निक्षिप्तो पुरोदेशे महाद्युतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001450, "chapter_id": 1023, "verse_number": "१-२४-५", "content_sanskrit": "सूर्यस्तेजोभिरत्युग्रैर्लोकान्दग्धुमना यदा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001451, "chapter_id": 1023, "verse_number": "१-२४-५x", "content_sanskrit": "रुरुरुवाच।\nकिमर्थं भगवान्सूर्यो लोकान्दग्धुमनास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001452, "chapter_id": 1023, "verse_number": "१-२४-६", "content_sanskrit": "किमस्तापहृतं देवैर्येनमं मन्युराविशत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001453, "chapter_id": 1023, "verse_number": "१-२४-६x", "content_sanskrit": "प्रमतिरुवाच।\nचन्द्रार्काभ्यां यदा राहुराख्यातो ह्यमृतं पिबन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001454, "chapter_id": 1023, "verse_number": "१-२४-७", "content_sanskrit": "वैरानुबन्धं कृतवांश्चन्द्रादित्यौ तदाऽनघ।\nबाध्यमानं ग्रहेणाथ ह्यादित्यं मन्युराविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001455, "chapter_id": 1023, "verse_number": "१-२४-८", "content_sanskrit": "सुरार्थाय समुत्पन्नो रोषो राहोस्तु मां प्रति।\nबह्वनर्थकरं पापमेकोऽहं समवाप्नुयाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001456, "chapter_id": 1023, "verse_number": "१-२४-९", "content_sanskrit": "सहाय एव कार्येषु न च कृच्छ्रेषु दृश्यते।\nपश्यन्ति ग्रस्यमानं मां सहन्ते वै दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001457, "chapter_id": 1023, "verse_number": "१-२४-१०", "content_sanskrit": "तस्माल्लोकविनाशार्थं ह्यवतिष्ठे न संशयः।\nएवं कृतमतिः सूर्यो ह्यस्तमभ्यगमद्गिरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001458, "chapter_id": 1023, "verse_number": "१-२४-११", "content_sanskrit": "तस्माल्लोकविनाशाय संतापयत भास्करः।\nततो देवानुपागम्य प्रोचुरेवं महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001459, "chapter_id": 1023, "verse_number": "१-२४-१२", "content_sanskrit": "आद्यार्धरात्रसमये सर्वलोकभयावहः।\nउत्पत्स्यते महान्दाहस्त्रैलोक्यस्य विनाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001460, "chapter_id": 1023, "verse_number": "१-२४-१३", "content_sanskrit": "ततो देवाः सर्षिगणा उपगम्य पितामहम्।\nअब्रुवन्किमिवेहाद्य महद्दाहकृतं भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001461, "chapter_id": 1023, "verse_number": "१-२४-१४", "content_sanskrit": "न तावद्दृश्यते सूर्यः क्षयोऽयं प्रतिभाति च।\nउदिते भगवन्भानौ कथनेतद्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001462, "chapter_id": 1023, "verse_number": "१-२४-१५x", "content_sanskrit": "पितामह उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001463, "chapter_id": 1023, "verse_number": "१-२४-१५", "content_sanskrit": "एष लोकविनाशाय रविरुद्यन्तुमुद्यतः।\nदृश्यन्नेव हि लोकान्स भस्मराशीकरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001464, "chapter_id": 1023, "verse_number": "१-२४-१६", "content_sanskrit": "तस्य प्रतिविधानं च विहितं पूर्वमेव हि।\nकश्यपस्य सुतो धीमानरुणेत्यभिविश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001465, "chapter_id": 1023, "verse_number": "१-२४-१७", "content_sanskrit": "महाकायो महातेजाः स स्थास्यति पुरो रवेः।\nकरिष्यति च सारथ्यं तेजश्चास्य हरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001466, "chapter_id": 1023, "verse_number": "१-२४-१८", "content_sanskrit": "लोकानां स्वस्ति चैवं स्यादृषीणां च दिवौकसाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001467, "chapter_id": 1023, "verse_number": "१-२४-१८x", "content_sanskrit": "प्रमतिरुवाच।\nततः पितामहाज्ञातः सर्वं चक्रे तदाऽरुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001468, "chapter_id": 1023, "verse_number": "१-२४-१९", "content_sanskrit": "उदितश्चैव सविता ह्यरुणेन समावृतः।\nएतत्ते सर्वमाख्यातं यत्सूर्यं मन्युराविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001469, "chapter_id": 1023, "verse_number": "१-२४-२०", "content_sanskrit": "अरुणश्च यथैवास्य सारथ्यमकरोत्प्रभुः।\nभूय एवापरं प्रश्नं शृणु पूर्वमुदाहृतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001470, "chapter_id": 1023, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि चतुर्विंशोऽध्यायः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]