[{"id": 2014735, "chapter_id": 1306, "verse_number": "२-४७-१", "content_sanskrit": "भीष्म उवाच॥\nपुरा त्रेतायुगे राजन्बलिर्वैरोजनोऽभवत्।\nदैत्यानां पार्थिवो वीरो बलेनाप्रतिमो बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014736, "chapter_id": 1306, "verse_number": "२-४७-२", "content_sanskrit": "तदा बलिर्महाराज दैत्यसङ्घैः समावृतः।\nविजेतुं तरसा शक्रमिन्द्रस्थानमवाप सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014737, "chapter_id": 1306, "verse_number": "२-४७-३", "content_sanskrit": "तेन वित्रासिता देवा बलिनाऽऽखण्डलादयः।\nब्रह्माणं तु पुरस्कृत्य गत्वा क्षीरोदधिं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014738, "chapter_id": 1306, "verse_number": "२-४७-४", "content_sanskrit": "तुष्टुवुः सहिताः सर्वे देवं नारायणं प्रभुम्।\nस तेषां दर्शनं चक्रे विबुधानां हरिस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014739, "chapter_id": 1306, "verse_number": "२-४७-५", "content_sanskrit": "प्रसादजं तस्य विभोरदित्यां जन्म उच्यते।\nअदितेरपि पुत्रत्वमेत्य यादवनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014740, "chapter_id": 1306, "verse_number": "२-४७-६", "content_sanskrit": "एष विष्णुरिति ख्यात इन्द्रस्यावरजोऽभवत्।\nतस्मिन्नेव च काले तु दैत्येन्द्रो बलवीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014741, "chapter_id": 1306, "verse_number": "२-४७-७", "content_sanskrit": "अश्वमेधं क्रतुश्रेष्ठमाहर्तुमुपचक्रमे।\nवर्तमाने तदा यज्ञे दैत्येन्द्रस्य युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014742, "chapter_id": 1306, "verse_number": "२-४७-८", "content_sanskrit": "स विष्णुर्मानवो भूत्वा प्रच्छन्नो ब्रह्मसंवृतः।\nमुण्डो यत्रोपवीती च कृष्णाजिनधरः शिखी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014743, "chapter_id": 1306, "verse_number": "२-४७-९", "content_sanskrit": "पालाशदण्डं सङ्गृह्य वामनोऽद्भुतदर्शनः।\nप्रविश्य स बलेर्यज्ञे वर्तमानो च दक्षिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014744, "chapter_id": 1306, "verse_number": "२-४७-१०", "content_sanskrit": "देहीत्युवाच दैत्येन्द्रं विक्रमांस्त्रीनिहैव ह।\nदीयतां त्रिपदीमात्रमित्ययाचन्महासुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014745, "chapter_id": 1306, "verse_number": "२-४७-११", "content_sanskrit": "स तथेति प्रतिश्रुत्य प्रददौ विष्णवे तदा।\nतेन लब्ध्वा हिरर्भूमिं जृम्भयामास वै भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014746, "chapter_id": 1306, "verse_number": "२-४७-१२", "content_sanskrit": "स शिशुः सदिवं खं च पृथिवीं वच विशाम्पते।\nत्रिभिर्विक्रमणैश्चैव सर्वमाक्रमताभिभूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014747, "chapter_id": 1306, "verse_number": "२-४७-१३", "content_sanskrit": "बलेर्बलवतो यज्ञे बलिना विष्णुना पुरा।\nविक्रमैस्त्रिभिरक्षोभ्याः क्षोभितास्ते महासुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014748, "chapter_id": 1306, "verse_number": "२-४७-१४", "content_sanskrit": "विप्रचित्तिमुखाः क्रुद्धाः सर्वसङ्घा महासुराः।\nनानावक्रा महाकाया नानावेषधरा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014749, "chapter_id": 1306, "verse_number": "२-४७-१५", "content_sanskrit": "नानाप्रहरणा रौद्रा नानामाल्यानुलेपनाः।\nस्वान्यायुधानि सङ्गृह्य प्रदीप्ता इव तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014750, "chapter_id": 1306, "verse_number": "२-४७-१६", "content_sanskrit": "क्रममाणं हरि तत्र उपावर्तन्त भारत।\nप्रमथ्य सर्वान्दैतेयान्पादहस्ततलैस्तु तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014751, "chapter_id": 1306, "verse_number": "२-४७-१७", "content_sanskrit": "रूपं कृत्वा महाभीमं जहाराशु स मेदिनीम्।\nसम्प्राप्य दिवमाकाशमादित्यसदने स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014752, "chapter_id": 1306, "verse_number": "२-४७-१८", "content_sanskrit": "अत्यरोचत भूतात्मा आदित्यस्यैव तेजसा।\nप्रकाशयन्दिशः सर्वाः प्रदिशश्च महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014753, "chapter_id": 1306, "verse_number": "२-४७-१९", "content_sanskrit": "शुशुभे स महाबाहुः सर्वलोकान्प्रकाशयन्।\nतस्य विक्रमतो भूमिं चन्द्रादित्यौ स्तनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014754, "chapter_id": 1306, "verse_number": "२-४७-२०", "content_sanskrit": "नभस्तु क्रममाणस्य नाभ्यां किल तदा स्थितौ।\nपरमाक्रममाणस्य नानुभ्यां तौ व्यवस्थितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014755, "chapter_id": 1306, "verse_number": "२-४७-२१", "content_sanskrit": "विष्णोरमितवीर्यस्य वदन्त्येवं द्विजातयः।\nअथास्य पादाक्रमणात्पफालाण्डो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014756, "chapter_id": 1306, "verse_number": "२-४७-२२", "content_sanskrit": "तच्छिद्रात्स्यन्दिनी तस्य पादभ्रष्टा तु निम्नगा।\nससार सागरं सा तु पावनी सागरंगमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014757, "chapter_id": 1306, "verse_number": "२-४७-२३", "content_sanskrit": "जहार मेदिनीं सर्वां हत्वा दानवपुङ्गवान्।\nआसुरी श्रियमाहृत्य त्रील्लोकान्स जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014758, "chapter_id": 1306, "verse_number": "२-४७-२४", "content_sanskrit": "सपुत्रदारानसुरान्पाताले संन्यवेशयत्।\nनमुचिः शम्बरश्चैव प्रह्लादश्च महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014759, "chapter_id": 1306, "verse_number": "२-४७-२५", "content_sanskrit": "महाभूतानि भूतात्मा सविशेषानि वै हरिः।\nकालं च सकलं राजन्गात्रभूतान्यदर्शयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014760, "chapter_id": 1306, "verse_number": "२-४७-२६", "content_sanskrit": "तस्य गात्रे जगत्सर्वमानीतमधिपश्यति।\nन किञ्चिदस्ति लोकेषु यदनाप्तं महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014761, "chapter_id": 1306, "verse_number": "२-४७-२७", "content_sanskrit": "तद्धि रूपमुपेन्द्रस्य देवदानवमानवाः।\nदृष्ट्वा संमुमुहुः सर्वे विष्णुतेजोऽभिपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014762, "chapter_id": 1306, "verse_number": "२-४७-२८", "content_sanskrit": "बलिर्बद्धोऽभिमानी च यज्ञवाटे महात्मना।\nविरोचनकुलं सर्वं पाताले विनिवेशितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014763, "chapter_id": 1306, "verse_number": "२-४७-२९", "content_sanskrit": "एवंविधानि कर्माणि कृत्वा गरुडावाहनः।\nन विस्मयमुपागच्छत्पारमेष्ठ्येन तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2014764, "chapter_id": 1306, "verse_number": "२-४७-३०", "content_sanskrit": "स सर्वमसुरैश्वर्यं सम्प्रदाय शचीपतेः।\nत्रैलोक्यं च ददौ शक्रे विष्णुर्दानवसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2014765, "chapter_id": 1306, "verse_number": "२-४७-३१", "content_sanskrit": "एष ते वामनो नाम प्रादुर्भावो महात्मनः।\nवेदविद्भिर्द्विजैरेतच्छ्रूयते वैष्णवं यशः।\nमानुषेषु ततो विष्णोः प्रादुर्भावांस्तथा शृणु॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2014766, "chapter_id": 1306, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि सप्तचत्वारिंशोऽध्यायः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]