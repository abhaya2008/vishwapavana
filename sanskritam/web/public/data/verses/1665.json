[{"id": 2030479, "chapter_id": 1665, "verse_number": "३-३०३-०x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030480, "chapter_id": 1665, "verse_number": "३-३०३-१", "content_sanskrit": "भगवन्तमहं भक्तो यथा मां वेत्थ गोपते।\nतथा परमतिग्मांशो नास्त्यदेयं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030481, "chapter_id": 1665, "verse_number": "३-३०३-२", "content_sanskrit": "न मे दारा न मेपुत्रा न चात्मा सुहृदो न च।\nतथेष्टा वै सदा भक्त्या यथा त्वं गोपते मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030482, "chapter_id": 1665, "verse_number": "३-३०३-३", "content_sanskrit": "इष्टानां च महात्मानो भक्तानां च न संशयः।\nकुर्वन्ति भक्तिमिष्टां च जानीषे त्वं च भास्कर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030483, "chapter_id": 1665, "verse_number": "३-३०३-४", "content_sanskrit": "इष्टो भक्तश्च मे कर्णो न चान्यद्दैवतं दिवि।\nजानीत इतिवै कृत्वा भगवानाह मद्धितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030484, "chapter_id": 1665, "verse_number": "३-३०३-५", "content_sanskrit": "भूयश्च शिरसा याचे प्रसाद्य च पुनःपुनः।\nइति ब्रवीमि तिग्मांशो त्वं तु मे क्षन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030485, "chapter_id": 1665, "verse_number": "३-३०३-६", "content_sanskrit": "बिभेमि न तथा मृत्योर्यथा बिभ्येऽनृतादहम्।\nविशेषेण द्विजातीनां सर्वेषां सर्वदा सताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030486, "chapter_id": 1665, "verse_number": "३-३०३-७", "content_sanskrit": "प्रदाने जीवितस्यापि न मेऽत्रास्ति विचारणा।\nयच्च मामात्थ देव त्वं पाण्डवं फल्गुनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030487, "chapter_id": 1665, "verse_number": "३-३०३-८", "content_sanskrit": "व्येतु संतापजं दुःखं तव भास्कर मानसम्।\nअर्जुनप्रतिमं चैव विजेष्यामि रणेऽर्जुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030488, "chapter_id": 1665, "verse_number": "३-३०३-९", "content_sanskrit": "तवापि विदितं देव ममाप्यस्त्रबलं महत्।\nजामदग्न्यादुपात्तं यत्तथा द्रोणान्महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030489, "chapter_id": 1665, "verse_number": "३-३०३-१०", "content_sanskrit": "इदं त्वमनुजानीहि सुरश्रेष्ठ व्रतं मम।\nभिक्षते वज्रिणे दद्यामपि जीवितमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030490, "chapter_id": 1665, "verse_number": "३-३०३-११x", "content_sanskrit": "सूर्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030491, "chapter_id": 1665, "verse_number": "३-३०३-११", "content_sanskrit": "यदि तात ददास्येते वज्रिणे कुण्डले शुभे।\nत्वमप्येनमथो ब्रूया विजयार्थं महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030492, "chapter_id": 1665, "verse_number": "३-३०३-१२", "content_sanskrit": "नियमेन प्रदद्यास्त्वं कुण्डलेवै शतक्रतोः।\nअवध्यो ह्यसि भूतानां कुण्डलाभ्यां समन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030493, "chapter_id": 1665, "verse_number": "३-३०३-१३", "content_sanskrit": "अर्जुनन विनाशं हि तव दानवसूदनः।\nप्रार्तयानो रणे वत्स कुण्डले ते जिहीर्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030494, "chapter_id": 1665, "verse_number": "३-३०३-१४", "content_sanskrit": "स त्वमप्येनमाराध्य सूनृताभिः पुनः पुनः।\nअभ्यर्थयेथा देवेशममोघार्थं पुरंदरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030495, "chapter_id": 1665, "verse_number": "३-३०३-१५", "content_sanskrit": "अमोघां देहि मे शक्तिममित्रविनिबर्हिणीम्।\nदास्यामि ते सहस्राक्ष कुण्डले वर्म चोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030496, "chapter_id": 1665, "verse_number": "३-३०३-१६", "content_sanskrit": "इत्येव नियमेन त्वं दद्याः शक्राय कुण्डले।\nतया त्वं कर्ण संग्रामे हनिष्यसि रणे रिपून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030497, "chapter_id": 1665, "verse_number": "३-३०३-१७", "content_sanskrit": "नाहत्वा हि महाबाहो शत्रूनेति करं पुनः।\nसा शक्तिर्देवराजस्य शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030498, "chapter_id": 1665, "verse_number": "३-३००-१८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030499, "chapter_id": 1665, "verse_number": "३-३०३-१८", "content_sanskrit": "एवमुक्त्वा सहस्रांशुः सहसाऽन्तरधीयत।\n`कर्णस्तु बुबुधे राजन्स्वप्नान्ते प्रव्यथन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030500, "chapter_id": 1665, "verse_number": "३-३०३-१९", "content_sanskrit": "प्रतिबुद्धस्तु राधेयः स्वप्नं संचिन्त्य भारत।\nचकार निश्चयं राजञ्शक्त्यर्थं वदतांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2030501, "chapter_id": 1665, "verse_number": "३-३०३-२०", "content_sanskrit": "यदि मामिन्द्र आयाति कुण्डलार्थं परन्तप।\nशक्त्या तस्मै प्रदास्यामि कुण्डले वर्म चैव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2030502, "chapter_id": 1665, "verse_number": "३-३०३-२१", "content_sanskrit": "स कृत्वा प्रातरुत्थाय कार्याणि भरतर्षभ।\nब्राह्मणान्वाचयित्वा च यथाकार्यमुपाक्रमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2030503, "chapter_id": 1665, "verse_number": "३-३०३-२२", "content_sanskrit": "विधिना राजशार्दूल मुहूर्तमजपत्तदा।\nततः सूर्याय जप्यान्ते कर्णः स्वप्नं न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2030504, "chapter_id": 1665, "verse_number": "३-३०३-२३", "content_sanskrit": "यथा दृष्टं यथातत्त्वं यथोक्तमुभयोर्निसि।\nतत्सर्वमानुपूर्व्येण शशंसास्मै वृषस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2030505, "chapter_id": 1665, "verse_number": "३-३०३-२४", "content_sanskrit": "तच्छ्रुत्वा भगवान्देवो भानुः स्वर्भानुसूदनः।\nउवाच तं तथेत्येव कर्णं सूर्यः स्मयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2030506, "chapter_id": 1665, "verse_number": "३-३०३-२५", "content_sanskrit": "ततस्तत्त्वमिति ज्ञात्वा राधेयः परवीरहा।\nशक्तिमेवाभिकाङ्क्षन्वै वासवं प्रत्यपालयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2030507, "chapter_id": 1665, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि कुण्डलाहरणपर्वणि त्र्यधिकत्रिशततमोऽध्यायः ॥ ३०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]