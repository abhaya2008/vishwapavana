[{"id": 6000028000, "chapter_id": 10028, "verse_number": null, "content_sanskrit": "अथ अष्टमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "परीक्षिता शुकं प्रति जीवेशयोर्देहसंबन्धाद्यनेकप्रश्नकरणम्", "range": null}]}, {"id": 6000028001, "chapter_id": 10028, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.001.m4a", "display_order": 2}, {"id": 6000028002, "chapter_id": 10028, "verse_number": "२-८-१", "content_sanskrit": "ब्रह्मणा चोदितो ब्रह्मन्गुणाख्यानेऽगुणस्य च।\nयस्मै यस्मै यथा प्राह नारदो देवदर्शनः॥ २/८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.002.m4a", "display_order": 3}, {"id": 6000028003, "chapter_id": 10028, "verse_number": "२-८-२", "content_sanskrit": "एतद्वेदितुमिच्छामि तत्त्वं वेदविदां वर।\nहरेरद्भुतवीर्यस्य कथा लोकसुमङ्गलाः॥ २/८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.003.m4a", "display_order": 4}, {"id": 6000028004, "chapter_id": 10028, "verse_number": "२-८-३", "content_sanskrit": "प्रथयस्व महाभाग यथाऽहमखिलात्मनि।\nकृष्णे निवेश्य निःसङ्गं मनस्त्यक्ष्ये कलेवरम्॥ २/८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.004.m4a", "display_order": 5}, {"id": 6000028005, "chapter_id": 10028, "verse_number": "२-८-४", "content_sanskrit": "शृृण्वतः श्रद्धया नित्यं गृणतश्च स्वचेष्टितम्।\nकालेनानतिदीर्घेण भगवान्विशते हृदि॥ २/८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.005.m4a", "display_order": 6}, {"id": 6000028006, "chapter_id": 10028, "verse_number": "२-८-५", "content_sanskrit": "प्रविष्टः कर्णरन्ध्रेण स्वानां भावसरोरुहम्।\nधुनोति शमलं कृष्णः सलिलस्थं(सलिलस्य) यथा शरत्॥ २/८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.006.m4a", "display_order": 7}, {"id": 6000028007, "chapter_id": 10028, "verse_number": "२-८-६", "content_sanskrit": "धौतात्मा पुरुषः कृष्णपादमूलं न मुञ्चति।\nमुक्तसर्वपरिक्लेशः पान्थः स्वशरणं यथा॥ २/८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.007.m4a", "display_order": 8}, {"id": 6000028008, "chapter_id": 10028, "verse_number": "२-८-७", "content_sanskrit": "यदधातुमतो ब्रह्मन्देहारम्भोऽस्य धातुभिः।\nयदृच्छया हेतुना वा भवन्तो जानते यथा॥ २/८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.008.m4a", "display_order": 9}, {"id": 6000028009, "chapter_id": 10028, "verse_number": "२-८-८", "content_sanskrit": "आसीद्यदुदरात्पद्मं लोकसंस्थानलक्षणम्। यावानयं वै पुरुष इयत्तावयवैः पृथक्।\nतावानसाविति प्रोक्तस्तथाऽवयववानिव॥ २/८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.009.m4a", "display_order": 10}, {"id": 6000028010, "chapter_id": 10028, "verse_number": "२-८-९", "content_sanskrit": "अजः सृजति भूतानि भूतात्मा यदनुग्रहात्।\nददृशे येन तद्रूपं नाभिपद्मसमुद्भवः॥ २/८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.010.m4a", "display_order": 11}, {"id": 6000028011, "chapter_id": 10028, "verse_number": "२-८-१०", "content_sanskrit": "स चापि यत्र पुरुषो विश्वस्थित्युद्भवाप्ययः।\nमुक्त्वाऽऽत्ममायां मायेशः शेते सर्वगुणाश्रयः॥ २/८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.011.m4a", "display_order": 12}, {"id": 6000028012, "chapter_id": 10028, "verse_number": "२-८-११", "content_sanskrit": "पुरुषावयवैर्लोकाः सपालाः पूर्वकल्पिताः।\nलोकैरमुष्यावयवाः सपालैरिति शुश्रुमः॥ २/८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.012.m4a", "display_order": 13}, {"id": 6000028013, "chapter_id": 10028, "verse_number": "२-८-१२", "content_sanskrit": "यावान्कल्पो विकल्पो वा यथा कालोऽनुमीयते।\nभूतभव्यभवच्छब्द आयुर्मानं च यत्कृतम्॥ २/८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.013.m4a", "display_order": 14}, {"id": 6000028014, "chapter_id": 10028, "verse_number": "२-८-१३", "content_sanskrit": "कालस्यानुगतिर्या तु लक्ष्यतेऽण्वी महत्यपि।\nयावतीः कर्मगतयो यादृशीर्द्विजसत्तम॥ २/८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.014.m4a", "display_order": 15}, {"id": 6000028015, "chapter_id": 10028, "verse_number": "२-८-१४", "content_sanskrit": "यस्मिन्कर्मसमावापो यथा येनोपगृह्यते।\nगुणानां गुणिनां चैव परिमाणं सुविस्तरम्॥ २/८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.015.m4a", "display_order": 16}, {"id": 6000028016, "chapter_id": 10028, "verse_number": "२-८-१५", "content_sanskrit": "भूपातालककुब्व्योम ग्रहनक्षत्रभूभृताम्।\nसरित्समुद्रद्वीपानां सम्भवञ्चैतदोकसाम्॥ २/८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.016.m4a", "display_order": 17}, {"id": 6000028017, "chapter_id": 10028, "verse_number": "२-८-१६", "content_sanskrit": "प्रमाणमण्डकोशस्य बाह्याभ्यन्तरवस्तुनः।\nमहतां चानुचरितं वर्णाश्रमविनिर्णयम्॥ २/८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.017.m4a", "display_order": 18}, {"id": 6000028018, "chapter_id": 10028, "verse_number": "२-८-१७", "content_sanskrit": "अवतारानुचरितं यदाश्चर्यतमं हरेः।\nयुगानि युगमानं च धर्मो यश्च युगे युगे॥ २/८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.018.m4a", "display_order": 19}, {"id": 6000028019, "chapter_id": 10028, "verse_number": "२-८-१८", "content_sanskrit": "नृणां साधारणो धर्मः सविशेषश्च यादृशः।\nश्रेणीनां राजर्षीणां च धर्मः कृच्छ्रेषु जीवताम्॥ २/८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.019.m4a", "display_order": 20}, {"id": 6000028020, "chapter_id": 10028, "verse_number": "२-८-१९", "content_sanskrit": "तत्त्वानां परिसङ्ख्यानं लक्षणं हेतुलक्षणम्।\nपुरुषाराधनविधिं योगस्याऽध्यात्मिकस्य च॥ २/८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.020.m4a", "display_order": 21}, {"id": 6000028021, "chapter_id": 10028, "verse_number": "२-८-२०", "content_sanskrit": "योगेश्वरैश्वर्यगतिं लिङ्गभङ्गं च योगिनाम्।\nवेदोपवेदधर्माणाम् इतिहासपुराणयोः॥ २/८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.021.m4a", "display_order": 22}, {"id": 6000028022, "chapter_id": 10028, "verse_number": "२-८-२१", "content_sanskrit": "सम्भवः सर्वभूतानां विक्रमः प्रतिसङ्क्रमः।\nइष्टापूर्तस्य काम्यानां त्रिवर्गस्य च यो विधिः॥ २/८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.022.m4a", "display_order": 23}, {"id": 6000028023, "chapter_id": 10028, "verse_number": "२-८-२२", "content_sanskrit": "यो वाऽनुशयिनां सर्गः पाखण्डस्य च सम्भवः।\nआत्मनो बन्धमोक्षश्च व्यवस्थानं स्वरूपतः॥ २/८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.023.m4a", "display_order": 24}, {"id": 6000028024, "chapter_id": 10028, "verse_number": "२-८-२३", "content_sanskrit": "यथाऽऽत्मतन्त्रो भगवान्विक्रीडत्यात्ममायया।\nविसृज्य च यथा मायामुदास्ते साक्षिवद्विभुः॥ २/८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.024.m4a", "display_order": 25}, {"id": 6000028025, "chapter_id": 10028, "verse_number": "२-८-२४", "content_sanskrit": "सर्वमेतच्च भगवान् पृच्छतो मेऽनुपूर्वशः।\nतत्त्वतोऽर्हस्युदाहर्तुं प्रपन्नाय महामुने॥ २/८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.025.m4a", "display_order": 26}, {"id": 6000028026, "chapter_id": 10028, "verse_number": "२-८-२५", "content_sanskrit": "अत्र प्रमाणं हि भवान्परमेष्ठी यथाऽऽत्मभूः।\nअपरे ह्यनुतिष्ठन्ति पूर्वेषां पूर्वजैः कृतम्॥ २/८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.026.m4a", "display_order": 27}, {"id": 6000028027, "chapter_id": 10028, "verse_number": "२-८-२६", "content_sanskrit": "न मेऽसवः परायन्ति ब्रह्मन्ननशनादमी।\nपिबतोऽच्युतपीयूषं त्वद्वाक्याद्धि विनिःसृतम्॥ २/८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.027.m4a", "display_order": 28}, {"id": 6000028028, "chapter_id": 10028, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.028.m4a", "display_order": 29}, {"id": 6000028029, "chapter_id": 10028, "verse_number": "२-८-२७", "content_sanskrit": "स उपामन्त्रितो राज्ञा कथायामिति सत्पतेः।\nब्रह्मरातो भृशं प्रीतो विष्णुरातेन संसदि॥ २/८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.029.m4a", "display_order": 30}, {"id": 6000028030, "chapter_id": 10028, "verse_number": "२-८-२८", "content_sanskrit": "आह भागवतं नाम पुराणं ब्रह्मसम्मितम्।\nब्रह्मणे भगवत्प्रोक्तं ब्रह्मकल्प उपागते॥ २/८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.030.m4a", "display_order": 31}, {"id": 6000028031, "chapter_id": 10028, "verse_number": "२-८-२९", "content_sanskrit": "यद्यत्परीक्षिद् ऋषभः पाण्डूनामनुपृच्छति।\nआनुपूर्व्येण तत्सर्वमाख्यातुमुपचक्रमे॥ २/८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_008/BhP_02.008.031.m4a", "display_order": 32}, {"id": 6000028032, "chapter_id": 10028, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वितीयस्कन्धे अष्टमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]