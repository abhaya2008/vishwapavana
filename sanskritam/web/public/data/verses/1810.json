[{"id": 2037506, "chapter_id": 1810, "verse_number": "५-५५-०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037507, "chapter_id": 1810, "verse_number": "५-५५-१", "content_sanskrit": "न भेतव्यं महाराज न शोच्या भवतां वयम्।\nसमर्थाः स्म पराञ्जेतुं बलिनः समरे विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037508, "chapter_id": 1810, "verse_number": "५-५५-२", "content_sanskrit": "वने प्रव्राजितान्पार्थान्यदायान्मधुसूदनः ।\nमहता बलचक्रेण परराष्ट्रावमर्दिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037509, "chapter_id": 1810, "verse_number": "५-५५-३", "content_sanskrit": "केकया धृष्टकेतुश्च धृष्टद्युम्नश्च पार्षत।\nराजानश्चान्वयुः पार्थान्बहवोऽन्येऽनुयायिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037510, "chapter_id": 1810, "verse_number": "५-५५-४", "content_sanskrit": "इन्द्रप्रस्थस्य चादूरात्समाजग्मुर्महारथाः ।\nव्यगर्हयंश्च संगम्य भवन्तं कुरुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037511, "chapter_id": 1810, "verse_number": "५-५५-५", "content_sanskrit": "ते युधिष्ठिरमासीनमजिनैः प्रतिवासितम्।\nकृष्णप्रधानाः संहत्य पर्युपासन्त भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037512, "chapter_id": 1810, "verse_number": "५-५५-६", "content_sanskrit": "प्रत्यादनं च राज्यस्य कार्यमूचुर्नराधिपाः ।\nभवतः सानुबन्धस्य समुच्छेदं चिकीर्षवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037513, "chapter_id": 1810, "verse_number": "५-५५-७", "content_sanskrit": "श्रुत्वा चैवं मयोस्तास्तु भीष्मद्रोणकृपास्तदा।\nज्ञातिक्षयभयाद्राजन्भीतेन भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037514, "chapter_id": 1810, "verse_number": "५-५५-८", "content_sanskrit": "ततः स्थास्यन्ति समये पाण्डवा इति मे मतिः।\nसमुच्छेदं हि नः कृत्स्नं वासुदेवश्चिकीर्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037515, "chapter_id": 1810, "verse_number": "५-५५-९", "content_sanskrit": "ऋते च विदुरात्सर्वे यूयं वध्या मता मम।\nधृतराष्ट्रस्तु धर्मज्ञो न वध्यः कुरुसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037516, "chapter_id": 1810, "verse_number": "५-५५-१०", "content_sanskrit": "समुच्छेदं च कृत्स्नं नः कृत्वा तात जनार्दनः।\nएकराज्यं कुरूणां स्म चिकीर्षति युधिष्ठिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037517, "chapter_id": 1810, "verse_number": "५-५५-११", "content_sanskrit": "तत्र किं प्राप्तकालं नः प्रणिपातः पलायनम्।\nप्राणान्वा संपरित्यज्य प्रतियुध्यामाहे परान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037518, "chapter_id": 1810, "verse_number": "५-५५-१२", "content_sanskrit": "प्रतियुद्धे तु नियतः स्यादस्माकं पराजयः।\nयुधिष्ठिरस्य सर्वे हि पार्थिवा वशवर्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037519, "chapter_id": 1810, "verse_number": "५-५५-१३", "content_sanskrit": "विरक्तराष्ट्राश्च वयं मित्राणि कुपितानि नः।\nधिक्कृताः पार्थिवैः सर्वैः स्वजनेन च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037520, "chapter_id": 1810, "verse_number": "५-५५-१४", "content_sanskrit": "प्रणिपाते न दोषोस्ति सन्धिर्नः शाश्वतीः समाः।\nपितरं त्वेव शोचामि प्रज्ञानेत्रं जनाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037521, "chapter_id": 1810, "verse_number": "५-५५-१५", "content_sanskrit": "मत्कृते दुःखमापन्नं क्लेशं प्राप्तमनन्तकम्।\nकृतं हि तव पुत्रैश्च परेषामवरोधनम् ।\nमत्प्रयार्थं पुरैवैतद्विदितं ते नरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037522, "chapter_id": 1810, "verse_number": "५-५५-१६", "content_sanskrit": "ते राज्ञो धृतराष्ट्रस्य सामात्यस्य महारथाः ।\nवैरं प्रतिकरिष्यन्ति कुलोच्छेदेन पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037523, "chapter_id": 1810, "verse_number": "५-५५-१७", "content_sanskrit": "ततो द्रोणोऽब्रवीद्भीष्मः कृपो द्रौणिश्च भारत।\nमत्वा मां महतीं चिन्तामास्थितंव्यथितेन्द्रियं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2037524, "chapter_id": 1810, "verse_number": "५-५५-१८", "content_sanskrit": "अभिद्रुग्धाः परे चेन्नो न भेतव्यं परन्तप।\nअसमर्थाः परे जेतुमस्मान्युधि समास्थितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2037525, "chapter_id": 1810, "verse_number": "५-५५-१९", "content_sanskrit": "एकैकशः समर्थाः स्मो विजेतुं सर्वपार्थिवान्।\nआगच्छन्तु विनेष्यामो दर्पमेषां शितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2037526, "chapter_id": 1810, "verse_number": "५-५५-२०", "content_sanskrit": "पुरैकेन हि भीष्मेण विजिताः सर्वपार्थिवाः।\nमृते पितर्यतिक्रुद्धो रथेनैकेन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2037527, "chapter_id": 1810, "verse_number": "५-५५-२१", "content_sanskrit": "जघान सुबहूंस्तेषां संरब्धः कुरुसत्तमः।\nततस्ते शरणं जग्मुर्देवव्रतमिमं भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2037528, "chapter_id": 1810, "verse_number": "५-५५-२२", "content_sanskrit": "स भीष्मः सुसमर्थोऽयमस्माभिः सहितो रणे।\nपरान्विजेतुं तस्मात्ते व्येतु भीर्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2037529, "chapter_id": 1810, "verse_number": "५-५५-२३", "content_sanskrit": "इत्येषां निश्चयो ह्यासीत्तत्कालेऽमिततेजसाम्।\nपुरा तेषां पृथिवी कृत्स्नासीद्वशवर्तिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2037530, "chapter_id": 1810, "verse_number": "५-५५-२४", "content_sanskrit": "अस्मान्पुनरमी नाद्य समर्था जेतुमाहवे।\nछिन्नपक्षाः परे ह्यद्य वीर्यहीनाश्च पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2037531, "chapter_id": 1810, "verse_number": "५-५५-२५", "content_sanskrit": "अस्मत्संस्था च पृथिवी वर्तते भरतर्षभ।\nएकार्थाः सुखदुःखेषु समानीताश्च पार्थिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2037532, "chapter_id": 1810, "verse_number": "५-५५-२६", "content_sanskrit": "अप्यग्निं प्रविशेयुस्ते समुद्रं वा परन्तप।\nमदर्थं पार्थिवाः सर्वे तद्विद्धि कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2037533, "chapter_id": 1810, "verse_number": "५-५५-२७", "content_sanskrit": "उन्मत्तमिव चापि त्वां प्रहसन्तीह दुःखितम्।\nविलपन्तं बहुविधं भीतं परविकत्थने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2037534, "chapter_id": 1810, "verse_number": "५-५५-२८", "content_sanskrit": "एषां ह्येकैकशो राज्ञां समर्थं पाण्डवान्प्रति ।\nआत्मानं मन्यते सर्वो व्येतु ते भयमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2037535, "chapter_id": 1810, "verse_number": "५-५५-२९", "content_sanskrit": "जेतुं समग्रां सेनां मे वासवोऽपि न शक्नुयात्।\nहन्तुमक्षय्यरूपेयं ब्रह्मणोऽपि स्वयंभुवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2037536, "chapter_id": 1810, "verse_number": "५-५५-३०", "content_sanskrit": "युधिष्ठिरः पुरं हित्वा पञ्चग्रामान्स याचते।\nभीतो हि मामकात्सैन्यात्प्रभावाच्चैव मे विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2037537, "chapter_id": 1810, "verse_number": "५-५५-३१", "content_sanskrit": "समर्थं मन्यसे यच्च कुन्तीपुत्रं वृकोदरम्।\nतन्मिथ्या न हि मे कृत्स्नं प्रभावं वेत्सि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2037538, "chapter_id": 1810, "verse_number": "५-५५-३२", "content_sanskrit": "मत्समो हि गदायुद्धे पृथिव्यां नास्ति कश्चन।\nनासीत्कश्चिदतिक्रान्तो भविता न च कश्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2037539, "chapter_id": 1810, "verse_number": "५-५५-३३", "content_sanskrit": "युक्तो दुःखोषितश्चाहं विद्यापारगतस्तथा।\nतस्मान्न भीमान्नान्येभ्यो भयं मे विद्यते क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2037540, "chapter_id": 1810, "verse_number": "५-५५-३४", "content_sanskrit": "दुर्योधनसमो नास्ति गदायामिति निश्चयः।\nसङ्कर्षणस्य भवने यत्तदैनमुपावसम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2037541, "chapter_id": 1810, "verse_number": "५-५५-३५", "content_sanskrit": "युद्धे सङ्कर्षणसमो बलेनाभ्यधिको भुवि।\nगदाप्रहारं भीमो मे न जातु विषहेद्युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2037542, "chapter_id": 1810, "verse_number": "५-५५-३६", "content_sanskrit": "एकं प्रहारं यं दद्यां भीमाय रुषितो नृप।\nस एवैनं नयोद्धोरः क्षिप्रं वैवस्वतक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2037543, "chapter_id": 1810, "verse_number": "५-५५-३७", "content_sanskrit": "इच्छेयं च गदाहस्तं राजन्द्रष्टुं वृकोदरम्।\nसुचिरं प्रार्थितो ह्येष मम नित्यं मनोरथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2037544, "chapter_id": 1810, "verse_number": "५-५५-३८", "content_sanskrit": "गदया निहतो ह्याजौ मया पार्थो वृकोदरः ।\nविशीर्णगावः पृथिवीं परासुः प्रपतिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2037545, "chapter_id": 1810, "verse_number": "५-५५-३९", "content_sanskrit": "गदाप्रहाराभिहतो हिमवानपि पर्वतः।\nसकृन्मया विदीर्येत गिरिः शतसहस्रधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2037546, "chapter_id": 1810, "verse_number": "५-५५-४०", "content_sanskrit": "स चाप्येतद्विजानाति वासुदेवार्जुनौ तथा।\nदुर्योधनसमो नास्ति गदायामिति निश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2037547, "chapter_id": 1810, "verse_number": "५-५५-४१", "content_sanskrit": "तत्ते वृकोदरमयं भयं व्येतु महाहवे।\nव्यपनेष्याम्यहं ह्येनं मा राजन्विमना भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2037548, "chapter_id": 1810, "verse_number": "५-५५-४२", "content_sanskrit": "तस्मिन्मया हते क्षिप्रमर्जुनं बहवो रथाः ।\nतुल्यरूपा विशिष्टाश्च क्षेप्स्यन्ति भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2037549, "chapter_id": 1810, "verse_number": "५-५५-४३", "content_sanskrit": "भीष्मो द्रोणः कृपो द्रौणिः कर्णो भूरिश्रवास्तथा ।\nप्राग्ज्योतिषाधिपः शल्यः सिन्धुराजो जयद्रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2037550, "chapter_id": 1810, "verse_number": "५-५५-४४", "content_sanskrit": "एकैक एषां शक्तस्तु हन्तुं भारत पाण्डवान्।\nसमेतास्तु क्षणेनैतान्नेष्यन्ति यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2037551, "chapter_id": 1810, "verse_number": "५-५५-४५", "content_sanskrit": "समग्रा पार्थिवी सेना पार्थमेकं धनञ्जयम्।\nकस्मादशक्ता निर्जेतुमिति हेतुर्न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2037552, "chapter_id": 1810, "verse_number": "५-५५-४६", "content_sanskrit": "शरव्रातैस्तु भीष्मेण शतशो निचितोऽवशः।\nद्रोणद्रौणिकृपैश्चैव गन्ता पार्थो यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2037553, "chapter_id": 1810, "verse_number": "५-५५-४७", "content_sanskrit": "पितामहोऽपि गाङ्गेयः शान्तनोरधि भारत।\nब्रह्मर्पिसदृशो जज्ञे देवैरपि सुदुःसहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2037554, "chapter_id": 1810, "verse_number": "५-५५-४८", "content_sanskrit": "न हन्ता विद्यते चापि राजन्भीष्मस्य कश्चन।\nपित्रा ह्युक्तः प्रसन्नेन नाकामस्त्वं मरिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2037555, "chapter_id": 1810, "verse_number": "५-५५-४९", "content_sanskrit": "ब्रह्मर्षेश्च भरद्वाजाद्द्रोणो द्रोण्यामजायत।\nद्रोणाज्जज्ञे महाराज द्रौणिश्च परमाश्त्रवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2037556, "chapter_id": 1810, "verse_number": "५-५५-५०", "content_sanskrit": "कृपश्चाचार्यमुख्योयं महर्षेर्गौतमादपि ।\nशरस्तम्बोद्भवः श्रीमानवध्य इति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2037557, "chapter_id": 1810, "verse_number": "५-५५-५१", "content_sanskrit": "अयोनिजास्त्रयो ह्येते पिता माता च मातुलः ।\nअश्वत्थाम्नो महारात स च शूरः स्थितो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2037558, "chapter_id": 1810, "verse_number": "५-५५-५२", "content_sanskrit": "सर्व एते महाराज देवकल्पा महारथाः।\nशक्रस्यापि व्यथां कुर्युः संयुगे भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2037559, "chapter_id": 1810, "verse_number": "५-५५-५३", "content_sanskrit": "नैतेषामर्जुनः शक्त एकैकं प्रतिवीक्षितुम्।\nसहितास्तु नरव्याघ्रा हनिष्यन्ति धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2037560, "chapter_id": 1810, "verse_number": "५-५५-५४", "content_sanskrit": "भीष्माद्रोणकृपाणां च तुल्यः कर्णो मतो मम।\nअनुज्ञातश्च रामेण मत्समोऽसीति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2037561, "chapter_id": 1810, "verse_number": "५-५५-५५", "content_sanskrit": "कुण्डले रुचिरे चास्तां कर्णस्य सहजे शुभे ।\nते शच्यर्थं महेन्द्रेण याचितः स परन्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2037562, "chapter_id": 1810, "verse_number": "५-५५-५६", "content_sanskrit": "अमोघया महाराज शक्त्या परमभीमया।\nतस्य शक्त्योपगूढस्य कस्माज्जीवेद्धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2037563, "chapter_id": 1810, "verse_number": "५-५५-५७", "content_sanskrit": "विजयो मे ध्रुवं राजन्फलं पाणाविवाहितम्।\nअभिव्यक्तः परेषां च कृत्स्नो भुवि पराजयः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2037564, "chapter_id": 1810, "verse_number": "५-५५-५८", "content_sanskrit": "अह्ना ह्येकेन भीष्मोयं प्रयुतं हन्ति भारत।\nतत्समाश्च महेष्वासा द्रोणद्रौणिकृपा अपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2037565, "chapter_id": 1810, "verse_number": "५-५५-५९", "content_sanskrit": "संशप्तकानां वृन्दानि क्षत्रियाणां परन्तप।\nअर्जुनं वयमस्मान्वा निहन्यात्कपिकेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2037566, "chapter_id": 1810, "verse_number": "५-५५-६०", "content_sanskrit": "तांश्चालमिति मन्यन्ते सव्यसाचिवधे धृताः।\nपार्थिवाः स भवांस्तेभ्यो ह्यकस्माद्व्यथते कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2037567, "chapter_id": 1810, "verse_number": "५-५५-६१", "content_sanskrit": "भीमसेने च निहते कोऽन्यो युध्येत भारत।\nपरेषां तन्ममाचक्ष्व यदि वेत्थ परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2037568, "chapter_id": 1810, "verse_number": "५-५५-६२", "content_sanskrit": "पञ्च ते भ्रातरः सर्वे धृष्टद्युम्नोऽथ सात्यकिः ।\nपरेषां सप्त ये राजन्योधाः सारं बलं मतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2037569, "chapter_id": 1810, "verse_number": "५-५५-६३", "content_sanskrit": "अस्माकं तु विशिष्टा ये भीष्मद्रोणकृपादयः ।\nद्रौणिर्विकर्तनः कर्णः सोमदत्तोथ बाह्लिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2037570, "chapter_id": 1810, "verse_number": "५-५५-६४", "content_sanskrit": "प्राग्ज्योतिषाधिपः शल्य आवन्त्यौ च जयद्रथः।\nदुःशासनो दुर्मखश्च दुःसहश्च विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2037571, "chapter_id": 1810, "verse_number": "५-५५-६५", "content_sanskrit": "श्रुतायुश्चित्रसेनश्च पुरुमित्रो विविंशतिः।\nशलो भूरिश्रवाश्चैव विकर्णश्च तवात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2037572, "chapter_id": 1810, "verse_number": "५-५५-६६", "content_sanskrit": "अक्षौहिण्यो हि मे राजन्दशैका च समाहृताः।\nन्यूना परेषां सप्तैव कस्मान्मे स्यात्पराजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2037573, "chapter_id": 1810, "verse_number": "५-५५-६७", "content_sanskrit": "बलं त्रिगुणतो हीनं योध्यं प्राह बृहस्पतिः।\nपरेभ्यस्त्रिगुणा चेयं मम राजन्ननीकिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2037574, "chapter_id": 1810, "verse_number": "५-५५-६८", "content_sanskrit": "गुणहीनं परेषां च बहु पश्यामि भारत।\nगुणोदयं बहुगुणमात्मनश्च विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2037575, "chapter_id": 1810, "verse_number": "५-५५-६९", "content_sanskrit": "एतत्सर्वं समाज्ञाय बलाग्र्यं मम भारत ।\nन्यूनतां पाण्डवानां च न मोहं गन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2037576, "chapter_id": 1810, "verse_number": "५-५५-७०", "content_sanskrit": "इत्युक्त्वा सञ्जयं भूयः पर्यपृच्छत भारत।\nविवित्सुः प्राप्तकालानि ज्ञात्वा परपुरञ्जयः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2037577, "chapter_id": 1810, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि पञ्चपञ्चाशत्तशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]