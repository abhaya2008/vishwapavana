[{"id": 2213761, "chapter_id": 5567, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213762, "chapter_id": 5567, "verse_number": "१", "content_sanskrit": "तेषु चोपनिवृत्तेषु पाण्डवेषु यदृच्छया ।\nदेवर्षिर्नारदो राजन्नाजगाम युधिष्ठिरम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213763, "chapter_id": 5567, "verse_number": "२", "content_sanskrit": "तमभ्यर्च्य महाबाहुः कुरुराजो युधिष्ठिरः ।\nआसीनं परिविश्वस्तं प्रोवाच वदतांवरः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213764, "chapter_id": 5567, "verse_number": "३", "content_sanskrit": "चिरात्तु नानुपश्यामि भगवन्तमुपस्थितम् ।\nकच्चित्ते कुशलं विप्र शुभं वा प्रत्युपस्थितम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213765, "chapter_id": 5567, "verse_number": "४", "content_sanskrit": "के देशाः परिदृष्टास्ते किं च कार्यं करोमि ते ।\nतद् ब्रूहि द्विजमुख्यस्त्वं ह्यस्माकं च प्रियोऽतिथिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213766, "chapter_id": 5567, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213767, "chapter_id": 5567, "verse_number": "५", "content_sanskrit": "चिरदृष्टोसि मेऽत्येवमागतोऽहं तपोवनात् ।\nपरिदृष्टानि तीर्थानि गङ्गा चैव मया नृप\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213768, "chapter_id": 5567, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213769, "chapter_id": 5567, "verse_number": "६", "content_sanskrit": "वदन्ति पुरुषा मेऽद्य गङ्गातीरनिवासिनः ।\nधृतराष्ट्रं महात्मानमास्थितं परमं तपः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213770, "chapter_id": 5567, "verse_number": "७", "content_sanskrit": "अपि दृष्टस्त्वया तत्र कुशली स कुरूद्वहः ।\nगान्धारी च पृथा चैव सूतपुत्रश्च सञ्जयः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213771, "chapter_id": 5567, "verse_number": "८", "content_sanskrit": "कथं च वर्तते चाद्य पिता मम स पार्थिवः ।\nश्रोतुमिच्छामि भगवन् यदि दृष्टस्त्वया नृपः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213772, "chapter_id": 5567, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213773, "chapter_id": 5567, "verse_number": "९", "content_sanskrit": "स्थिरीभूय महाराज शृणु वृत्तं यथातथम् ।\nयथाश्रुतं च दृष्टं च मया तस्मिंस्तपोवने\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213774, "chapter_id": 5567, "verse_number": "१०", "content_sanskrit": "वनवासनिवृत्तेषु भवत्सु कुरुनन्दन ।\nकुरुक्षेत्रात् पिता तुभ्यं गङ्गाद्वारं ययौ नृप\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213775, "chapter_id": 5567, "verse_number": "११", "content_sanskrit": "गान्धार्या सहितो धीमान् वध्वा कुन्त्या समन्वितः ।\nसञ्जयेन च सूतेन साग्निहोत्रः सयाजकः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213776, "chapter_id": 5567, "verse_number": "१२", "content_sanskrit": "आतस्थे स तपस्तीव्रं पिता तव तपोधनः ।\nअग्निं मुखे समाधाय वायुभक्षोऽभवद् मुनिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213777, "chapter_id": 5567, "verse_number": "१३", "content_sanskrit": "वने स मुनिभिः सर्वैः पूज्यमानो महातपाः ।\nत्वगस्थिमात्रशेषः स षण्मासानभवन्नृपः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213778, "chapter_id": 5567, "verse_number": "१४", "content_sanskrit": "गान्धारी तु जलाहारी कुन्ती मासोपवासिनी ।\nसञ्जयः षष्ठभुक्तेन वर्तयामास भारत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213779, "chapter_id": 5567, "verse_number": "१५", "content_sanskrit": "अग्नींस्तु याजकास्तत्र जुहुवुर्विधिवत् प्रभो ।\nदृश्यतोऽदृश्यतश्चैव वने तस्मिन्नृपस्य वै\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213780, "chapter_id": 5567, "verse_number": "१६", "content_sanskrit": "अनिकेतोथ राजा स बभूव वनगोचरः ।\nते चापि सहिते देव्यौ सञ्जयश्च तमन्वयुः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213781, "chapter_id": 5567, "verse_number": "१७", "content_sanskrit": "सञ्जयो नृपतेर्नेता समेषु विषमेषु च ।\nगान्धार्याश्च पृथा चैव चक्षुरासीदनिन्दिता\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213782, "chapter_id": 5567, "verse_number": "१८", "content_sanskrit": "ततः कदाचिद् गङ्गायाः कच्छे स नृपसत्तमः ।\nगङ्गायामाप्लुतो धीमानाश्रमाभिमुखो ययौ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213783, "chapter_id": 5567, "verse_number": "१९", "content_sanskrit": "अथ वायुः समुद्भूतो दावाग्निरभवन्महान् ।\nददाह तद्वनं सर्वं परिगृह्य समन्ततः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213784, "chapter_id": 5567, "verse_number": "२०", "content_sanskrit": "दहत्सु मृगयूथेषु द्विजिह्वेषु समन्ततः ।\nवराहाणां च यूथेषु संश्रयत्सु जलाशयान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2213785, "chapter_id": 5567, "verse_number": "२१", "content_sanskrit": "सम्प्रदीप्ते वने तस्मिन् प्राप्ते व्यसन उत्तमे ।\nनिराहारतया राजा मन्दप्राणविचेष्टितः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2213786, "chapter_id": 5567, "verse_number": "२२", "content_sanskrit": "असमर्थोऽपसरणे सुकृशे मातरौ च ते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2213787, "chapter_id": 5567, "verse_number": "२३", "content_sanskrit": "ततः स नृपतिर्दृष्ट्वा वह्निमायान्तमन्तिकात् ।\nइदमाह ततः सूतं सञ्जयं जयतांवरः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2213788, "chapter_id": 5567, "verse_number": "२४", "content_sanskrit": "गच्छ सञ्जय यत्राग्निर्न त्वां दहति कर्हिचित् ।\nवयमत्राग्निना युक्ता गमिष्यामः परां गतिम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2213789, "chapter_id": 5567, "verse_number": "२५", "content_sanskrit": "तमुवाच किलोद्विग्नः सञ्जयो वदतांवरः ।\nराजन् मृत्युरनिष्टोऽयं भविता ते वृथाऽग्निना\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2213790, "chapter_id": 5567, "verse_number": "२६", "content_sanskrit": "न चोपायं प्रपश्यामि मोक्षणे जातवेदसः ।\nयदत्रानन्तरं कार्यं तद्भवान् वक्तुमर्हति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2213791, "chapter_id": 5567, "verse_number": "२७", "content_sanskrit": "इत्युक्तः सञ्जयेनेदं पुनराह स पार्थिवः ।\nनैष मृत्युरनिष्टो नो निःसृतानां गृहात्स्वयम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2213792, "chapter_id": 5567, "verse_number": "२८", "content_sanskrit": "जलमग्निस्तथा वायुरथवाऽपि विकर्षणम् ।\nतापसानां प्रशस्यं ते गच्छ सञ्जय माचिरम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2213793, "chapter_id": 5567, "verse_number": "२९", "content_sanskrit": "इत्युक्त्वा सञ्जयं राजा समाधाय मनस्तथा ।\nप्राङ्मुखः सह गान्धार्या कुन्त्या चोपाविशत् तदा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2213794, "chapter_id": 5567, "verse_number": "३०", "content_sanskrit": "सञ्जयस्तं तथा दृष्ट्वा प्रदक्षिणमथाकरोत् ।\nउवाच चैनं मेधावी युङ्क्ष्वात्मानमिति प्रभो\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2213795, "chapter_id": 5567, "verse_number": "३१", "content_sanskrit": "ऋषिपुत्रो मनीषी स राजा चक्रेऽस्य तद्वचः ।\nसन्निरुद्ध्येन्द्रियग्राममासीत् काष्ठोपमस्तदा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2213796, "chapter_id": 5567, "verse_number": "३२", "content_sanskrit": "गान्धारी च महाभागा जननी च पृथा तव ।\nदावाग्निना समायुक्ते स च राजा पिता तव\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2213797, "chapter_id": 5567, "verse_number": "३३", "content_sanskrit": "सञ्जयस्तु महाप्राज्ञस्तस्माद् दावादमुच्यत ।\nगङ्गाकूले मया दृष्टस्तापसैः परिवारितः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2213798, "chapter_id": 5567, "verse_number": "३४", "content_sanskrit": "स तानामन्त्र्य तेजस्वी निवेद्यैतच्च सर्वशः ।\nप्रययौ सञ्जयो धीमान् हिमवन्तं महीधरम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2213799, "chapter_id": 5567, "verse_number": "३५", "content_sanskrit": "एवं स निधनं प्राप्तः कुरुराजो महामनाः ।\nगान्धारी च पृथा चैव जनन्यौ ते विशाम्पते\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2213800, "chapter_id": 5567, "verse_number": "३६", "content_sanskrit": "यदृच्छयाऽनुव्रजता मया राज्ञः कलेबरम् ।\nतयोश्च देव्योरुभयोर्मया दृष्टानि भारत\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2213801, "chapter_id": 5567, "verse_number": "३७", "content_sanskrit": "ततस्तपोवने तस्मिन् समाजग्मुस्तपोधनाः ।\nश्रुत्वा राज्ञस्तदा निष्ठां न त्वशोचन् गतीश्च ते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2213802, "chapter_id": 5567, "verse_number": "३८", "content_sanskrit": "तत्राश्रौषमहं सर्वमेतत्पुरुषसत्तम ।\nयथा च नृपतिर्दग्धो देव्यौ ते चेति पाण्डव\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2213803, "chapter_id": 5567, "verse_number": "३९", "content_sanskrit": "इत्युक्तो मुनिना तेन धर्मराजं सहानुजः ।\nतीव्रशोकसमायुक्तो बाष्पपर्याकुलेक्षणः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2213804, "chapter_id": 5567, "verse_number": "४०", "content_sanskrit": "भीमसेनादयः सर्वे तीव्रशोकेन दुःखिताः ।\nविसञ्ज्ञां ते गता सर्वे पेतुः सर्वे महीतळे\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2213805, "chapter_id": 5567, "verse_number": "४१", "content_sanskrit": "अन्तःपुराणां च तदा महानार्तस्वरोऽभवत् ।\nपौराणां च महाराज श्रुत्वा राज्ञस्तदा गतिम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2213806, "chapter_id": 5567, "verse_number": "४२", "content_sanskrit": "अहो धिगिति राजा तु विक्रुश्य भृशदुःखितः ।\n(ऊर्ध्वबाहुः स्मरन् मातुः प्ररुरोद युधिष्ठिरः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2213807, "chapter_id": 5567, "verse_number": "४३", "content_sanskrit": "भीमसेनपुरोगाश्च भ्रातरः सर्व एव ते ।\nरुरुदुर्दुःखसन्तप्ता वर्णयन्तः पृथां तदा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2213808, "chapter_id": 5567, "verse_number": "४४", "content_sanskrit": "अन्तःपुरेषु च तदा सुमहान्नुदितस्वनः ।\nप्रादुरासीन्महाराज पृथां श्रुत्वा तथागताम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2213809, "chapter_id": 5567, "verse_number": "४५", "content_sanskrit": "तं च वृद्धं तथा दग्धं हतपुत्रं नराधिपम् ।\nअन्वशोचन्त ते सर्वे गान्धारीं च तपस्विनीम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2213810, "chapter_id": 5567, "verse_number": "४६", "content_sanskrit": "तस्मिन्नुपरते शब्दे मुहूर्तादिव भारत ।)\nनिगृह्य बाष्पं धैर्येण धर्मराजोऽब्रवीदिदम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2213811, "chapter_id": 5567, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्रमवासिकपर्वणि\nयुधिष्ठिरनारदसमागमे धृतराष्ट्रगान्धार्यादीनां स्वर्गारोहणं श्रुत्वा पाण्डवानां शोककथनं नाम त्रिचत्वारिंशोऽध्यायः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2213812, "chapter_id": 5567, "verse_number": "१", "content_sanskrit": "नारदागमनपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2213813, "chapter_id": 5567, "verse_number": "", "content_sanskrit": "॥ समाप्तं नारदागमनपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2213814, "chapter_id": 5567, "verse_number": "", "content_sanskrit": "॥ समाप्तमाश्रमवासिकपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]