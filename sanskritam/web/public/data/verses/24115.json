[{"id": 7004115000, "chapter_id": 24115, "verse_number": "४-६४-१", "content_sanskrit": "अगस्त्य उवाच ।\nदृष्ट्वा भूदेवताः शंभुं किमाचख्युः षडानन ।\nकानिकानि च लिंगानि तत्र तान्यपिचक्ष्व मे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004115001, "chapter_id": 24115, "verse_number": "४-६४-२", "content_sanskrit": "ज्येष्ठस्थाने महापुण्ये देवदेवस्य वल्लभे ।\nआश्चर्यं किमभूत्तत्र तदाचक्ष्व षडानन ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004115002, "chapter_id": 24115, "verse_number": "४-६४-३", "content_sanskrit": "स्कंद उवाच ।\nशृण्वगस्त्य यथा पृच्छि भवता तद्ब्रवीम्यहम् ।\nमंदराद्रिं यदा देवो गतवान्ब्रह्मगौरवात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004115003, "chapter_id": 24115, "verse_number": "४-६४-४", "content_sanskrit": "तदा निराश्रया विप्राः क्षेत्रसंन्यासिनोनघाः ।\nउपाकृताश्चाविरतं महाक्षेत्रप्रतिग्रहात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004115004, "chapter_id": 24115, "verse_number": "४-६४-५", "content_sanskrit": "खातंखातं च दंडाग्रैर्भूमिं कंदादिवृत्तयः ।\nचक्रुः पुष्करिणीं रम्यां दंडखाताभिधां मुने ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004115005, "chapter_id": 24115, "verse_number": "४-६४-६", "content_sanskrit": "तत्तीर्थं परितः स्थाप्य महालिंगान्यनेकशः ।\nमहेशाराधनपरास्तपश्चक्रुः प्रयत्नतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004115006, "chapter_id": 24115, "verse_number": "४-६४-७", "content_sanskrit": "विभूतिधारिणो नित्यं नित्यरुद्राक्षधारिणः ।\nलिंगपूजारता नित्यं शतरुद्रियजापिनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004115007, "chapter_id": 24115, "verse_number": "४-६४-८", "content_sanskrit": "ते श्रुत्वा देवदेवस्य पुनरागमनं मुने ।\nतपःकृशा अतितरामासुरानंद मेदुराः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004115008, "chapter_id": 24115, "verse_number": "४-६४-९", "content_sanskrit": "द्विजाः पंचसहस्राणि चरतो विपुलं तपः ।\nदंडखातान्महातीर्थादाजग्मुर्देवदर्शने ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004115009, "chapter_id": 24115, "verse_number": "४-६४-१०", "content_sanskrit": "तीर्थान्मंदाकिनी नाम्नो द्विजाः पाशुपतव्रताः ।\nशिवैकाराधनपराः समेता अयुतोन्मिताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004115010, "chapter_id": 24115, "verse_number": "४-६४-११", "content_sanskrit": "हंसतीर्थात्परिप्राप्ता अयुतं त्रिशतोत्तरम् ।\nशतदुर्वाससस्तीर्थादेकादश शताधिकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004115011, "chapter_id": 24115, "verse_number": "४-६४-१२", "content_sanskrit": "मत्स्योदर्याः परापेतुः सहस्राणि षडेव हि ।\nकपालमोचनात्सप्त शतान्यभ्यागता द्विजाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004115012, "chapter_id": 24115, "verse_number": "४-६४-१३", "content_sanskrit": "ऋणमोचनतस्तीर्थात्सहस्रं द्विशताधिकम् ।\nवैतरण्या अपि मुने द्विजानामयुतार्धकम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004115013, "chapter_id": 24115, "verse_number": "४-६४-१४", "content_sanskrit": "ततः पृथूदकात्कुंडात्पृथुना परिखानितात् ।\nअयासिषुर्द्विजानां च शतान्येव त्रयोदश ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004115014, "chapter_id": 24115, "verse_number": "४-६४-१५", "content_sanskrit": "तथैवाप्सरसः कुंडान्मेनकाख्याच्छतद्वयम् ।\nउर्वशीकुंडतः प्राप्ताः सहस्रं द्विशताधिकम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004115015, "chapter_id": 24115, "verse_number": "४-६४-१६", "content_sanskrit": "तथैरावतकुंडाच्च ब्राह्मणास्त्रिशतानि च ।\nगंधर्वाप्सरसः सप्त शतानि द्विशतानि च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004115016, "chapter_id": 24115, "verse_number": "४-६४-१७", "content_sanskrit": "वृषेशतीर्थादाजग्मुर्नवतिः सशतत्रया ।\nयक्षिणीकुंडतः प्राप्ताः सहस्रं त्रिशतोत्तरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004115017, "chapter_id": 24115, "verse_number": "४-६४-१८", "content_sanskrit": "लक्ष्मीतीर्थात्परं जग्मुः षोडशैव शतानि च ।\nपिशाचमोचनात्सप्त सहस्राणि द्विजोत्तमाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004115018, "chapter_id": 24115, "verse_number": "४-६४-१९", "content_sanskrit": "पितृकुंडाच्छतंसाग्रं ध्रुवतीर्थाच्छतानि षट् ।\nमानसाख्याच्च सरसो द्विशती सशतत्रया ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004115019, "chapter_id": 24115, "verse_number": "४-६४-२०", "content_sanskrit": "ब्राह्मणा वासुकिहृदात्सहस्राणि दशैव तु ।\nतथैवाष्टशतं द्रष्टुं जानकीकुंडतो द्विजाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004115020, "chapter_id": 24115, "verse_number": "४-६४-२१", "content_sanskrit": "काशीनाथमनुप्राप्ताः परमानंददायिनम् ।\nतथा गौतमकुंडाच्च शतानिनव चागताः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004115021, "chapter_id": 24115, "verse_number": "४-६४-२२", "content_sanskrit": "तीर्थाद्दुर्गतिसंहर्तुर्बाह्मणाः प्रतिपेदिरे ।\nएकादशशतान्येव द्रष्टुं देवमुमापतिम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004115022, "chapter_id": 24115, "verse_number": "४-६४-२३", "content_sanskrit": "असीसंभेदमारभ्य गंगातीरस्थिता द्विजाः ।\nआसंगमेश्वरात्तत्र परिप्राप्ता घटोद्भव ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004115023, "chapter_id": 24115, "verse_number": "४-६४-२४", "content_sanskrit": "अष्टादशसहस्राणि तथा पंचशतान्यपि ।\nब्राह्मणाः पंचपंचाशद्गंगातीरात्समागताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004115024, "chapter_id": 24115, "verse_number": "४-६४-२५", "content_sanskrit": "सार्द्रदूर्वाक्षतकरैः सपुष्पफलपाणिभिः ।\nसुगंधमाल्यहस्तैश्च ब्राह्मणैर्जयवादिभिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004115025, "chapter_id": 24115, "verse_number": "४-६४-२६", "content_sanskrit": "स्तुतो मंगलसूक्तैश्च प्रणतश्च पुनःपुनः ।\nतेभ्यो दत्ताभयः शंभुः पप्रच्छ कुशलं मुदा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004115026, "chapter_id": 24115, "verse_number": "४-६४-२७", "content_sanskrit": "ततस्ते ब्राह्मणाः प्रोचुः प्रबद्धकरसंपुटाः ।\nक्षेत्रे निवसतां नाथ सदानः कुशलोदयः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004115027, "chapter_id": 24115, "verse_number": "४-६४-२८", "content_sanskrit": "विशेषतः कृतोऽस्माभिः साक्षान्नयनगोचरः ।\nत्वं यत्स्वरूपं श्रुतयो न विदुः परमार्थतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004115028, "chapter_id": 24115, "verse_number": "४-६४-२९", "content_sanskrit": "सदैवाकुशलं तेषां ये त्वत्क्षेत्रपराङ्मुखाः ।\nचतुर्दशापि वै लोकास्तेषां नित्यं पराङ्मुखाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004115029, "chapter_id": 24115, "verse_number": "४-६४-३०", "content_sanskrit": "येषां हृदि सदैवास्ते काशीत्वाशीविषां गद ।\nसंसाराशीविषविषं न तेषां प्रभवेत्क्वचित् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004115030, "chapter_id": 24115, "verse_number": "४-६४-३१", "content_sanskrit": "गर्भरक्षामणिर्मंत्रः काशीवर्णद्वयात्मकः ।\nयस्य कंठे सदा तिष्ठेत्तस्याकुशलता कुतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004115031, "chapter_id": 24115, "verse_number": "४-६४-३२", "content_sanskrit": "सुधां पिबति यो नित्यं काशीवर्णद्वयात्मिकाम् ।\nस नैर्जरीं दशां हित्वा सुधैव परिजायते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004115032, "chapter_id": 24115, "verse_number": "४-६४-३३", "content_sanskrit": "श्रुतं कर्णामृतं येन काशीत्यक्षरयुग्मकम् ।\nन समाकणर्यत्येव स पुनर्गर्भजां कथाम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004115033, "chapter_id": 24115, "verse_number": "४-६४-३४", "content_sanskrit": "काशी रजोपि यन्मूर्ध्नि पतेदप्यनिलाहतम् ।\nचंद्रशेखरतन्मूर्धा भवेच्चंद्रकलांकितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004115034, "chapter_id": 24115, "verse_number": "४-६४-३५", "content_sanskrit": "प्रसंगतोपि यन्नेत्रपथमानंदकाननम् ।\nयातं तेत्र न जायंते नेक्षेरन्पितृकान नम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004115035, "chapter_id": 24115, "verse_number": "४-६४-३६", "content_sanskrit": "गच्छता तिष्ठता वापि स्वपता जाग्रताथवा ।\nकाशीत्येष महामंत्रो येन जप्तः सनिर्भयः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004115036, "chapter_id": 24115, "verse_number": "४-६४-३७", "content_sanskrit": "येन बीजाक्षरयुगं काशीति हृदि धारितम् ।\nअबीजानि भवंत्येव कर्मबीजानि तस्य वै ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004115037, "chapter_id": 24115, "verse_number": "४-६४-३८", "content_sanskrit": "काशी काशीति काशीति जपतो यस्य संस्थितिः ।\nअन्यत्रापि सतस्तस्य पुरो मुक्तिः प्रकाशते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004115038, "chapter_id": 24115, "verse_number": "४-६४-३९", "content_sanskrit": "क्षेममूर्तिरियं काशी क्षेममूर्तिर्भवान्भव ।\nक्षेममूर्तिस्त्रिपथगा नान्यत्क्षेमत्रयं क्वचित् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004115039, "chapter_id": 24115, "verse_number": "४-६४-४०", "content_sanskrit": "ब्राह्मणानामिति वचः क्षेत्रभक्तिविबृंहितम् ।\nनिशम्य गिरिजाकांतस्तुतोष नितरां हरः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004115040, "chapter_id": 24115, "verse_number": "४-६४-४१", "content_sanskrit": "प्रोवाच च प्रसन्नात्मा धन्या यूयं द्विजर्षभाः ।\nयेषामिहेदृशी भक्तिर्मम क्षेत्रेतिपावने ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004115041, "chapter_id": 24115, "verse_number": "४-६४-४२", "content_sanskrit": "जाने सत्त्वमया जाताः क्षेत्रस्यास्य निषेवणात् ।\nनीरजस्का वितमसः संसारार्णवपारगाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004115042, "chapter_id": 24115, "verse_number": "४-६४-४३", "content_sanskrit": "वाराणस्यास्तु ये भक्तास्ते भक्ता मम निश्चितम् ।\nजीवन्मुक्ता हि ते नूनं मोक्षलक्ष्म्या कटाक्षिताः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004115043, "chapter_id": 24115, "verse_number": "४-६४-४४", "content_sanskrit": "यैश्च काशीस्थितो जंतुरल्पकोपि विरोधितः ।\nतैर्वै विश्वंभरा सर्वा मया सह विरोधिता ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004115044, "chapter_id": 24115, "verse_number": "४-६४-४५", "content_sanskrit": "वाराणस्याः स्तुतिमपि यो निशम्यानुमोदते ।\nअपि ब्रह्मांडमखिलं ध्रुवं तेनानुमोदितम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004115045, "chapter_id": 24115, "verse_number": "४-६४-४६", "content_sanskrit": "निवसंति हि ये मर्त्या अस्मिन्नानंदकानने ।\nममांतःकरणे ते वै निवसेयुरकल्मषाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004115046, "chapter_id": 24115, "verse_number": "४-६४-४७", "content_sanskrit": "निवसंति मम क्षेत्रे मम भक्तिं प्रकुर्वते ।\nमम लिंगधरा ये तु तानेवोपदिशाम्यहम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004115047, "chapter_id": 24115, "verse_number": "४-६४-४८", "content_sanskrit": "निवसंति मम क्षेत्रे मम भक्तिं न कुर्वते ।\nमम लिंगधरा ये नो न तानुपदिशाम्यहम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004115048, "chapter_id": 24115, "verse_number": "४-६४-४९", "content_sanskrit": "काशी निर्वाणनगरी येषां चित्ते प्रकाशते ।\nते मत्पुरः प्रकाशंते नैःश्रेयस्या श्रिया वृताः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004115049, "chapter_id": 24115, "verse_number": "४-६४-५०", "content_sanskrit": "मोक्षलक्ष्मीरियं काशी न येभ्यः परिरोचते ।\nस्वर्लक्ष्मीं कांक्षमाणेभ्यः पतितास्ते न संशयः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004115050, "chapter_id": 24115, "verse_number": "४-६४-५१", "content_sanskrit": "काथीं संकाक्षमाणानां पुरुषार्थचतुष्टयम् ।\nपुरः किंकरवत्तिष्ठेन्ममानुग्रहतो द्विजाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004115051, "chapter_id": 24115, "verse_number": "४-६४-५२", "content_sanskrit": "आनंदकानने ह्यत्र ज्वलद्दावानलोस्म्यहम् ।\nकर्मबीजानि जंतूनां ज्वालये न प्ररोहये ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004115052, "chapter_id": 24115, "verse_number": "४-६४-५३", "content_sanskrit": "वस्तव्यं सततं काश्यां यष्टव्योहं प्रयत्नतः ।\nजेतव्यौ कलिकालौ च रंतव्या मुक्तिरंगना ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004115053, "chapter_id": 24115, "verse_number": "४-६४-५४", "content_sanskrit": "प्राप्यापि काशीं दुर्बुद्धिर्यो न मां परिसेवते ।\nतस्य हस्तगताप्याशु कैवल्यश्रीः प्रणश्यति ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004115054, "chapter_id": 24115, "verse_number": "४-६४-५५", "content_sanskrit": "धन्या मद्भक्तिलक्ष्माणो ब्राह्मणाः काशिवासिनः ।\nयूयं यच्चेतसो वृत्तेर्न दूरेहं न काशिका ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004115055, "chapter_id": 24115, "verse_number": "४-६४-५६", "content_sanskrit": "दातव्यो वो वरः कोत्र व्रियतां मे यथारुचि ।\nप्रेयांसो मे यतो यूयं क्षेत्रसंन्यासकारिणः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004115056, "chapter_id": 24115, "verse_number": "४-६४-५७", "content_sanskrit": "इति पीत्वा महेशानमुखक्षीराब्धिजां सुधाम् ।\nपरितृप्ता द्विजाः सर्वे वव्रुर्वरमनुत्तमम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004115057, "chapter_id": 24115, "verse_number": "४-६४-५८", "content_sanskrit": "ब्राह्मणा ऊचुः ।\nउमापते महेशान सर्वज्ञ वर एष नः ।\nकाशी कदापि न त्याज्या भवता भवतापहृत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004115058, "chapter_id": 24115, "verse_number": "४-६४-५९", "content_sanskrit": "वचनाद्ब्राह्मणानां तु शापो मा प्रभवत्विह ।\nकदाचिदपि केषांचित्काश्यां मोक्षांतरायकः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004115059, "chapter_id": 24115, "verse_number": "४-६४-६०", "content_sanskrit": "तव पादाबुंजद्वंद्वे निर्द्वंद्वा भक्तिरस्तु नः ।\nआ कलेवरपातं च काशीवासोस्तु नोनिशम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004115060, "chapter_id": 24115, "verse_number": "४-६४-६१", "content_sanskrit": "किमन्येन वरेणेश देय एष वरो हि नः ।\nअवधेह्यंधकध्वंसिन्वरमन्यं वृणीमहे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004115061, "chapter_id": 24115, "verse_number": "४-६४-६२", "content_sanskrit": "तव प्रतिनिधी कृत्यास्माभिस्त्वद्भक्तिभावितैः ।\nप्रतिष्ठितेषु लिंगेषु सान्निध्यं भवतोऽस्त्विह ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004115062, "chapter_id": 24115, "verse_number": "४-६४-६३", "content_sanskrit": "श्रुत्वेति तेषां वाक्यानि तथास्त्विति पिनाकिना ।\nप्रोचेऽन्योपि वरो दत्तो ज्ञानं वश्च भविष्यति ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004115063, "chapter_id": 24115, "verse_number": "४-६४-६४", "content_sanskrit": "पुनः प्रोवाच देवेशो निशामयत भो द्विजाः ।\nहितं वः कथयाम्यत्र तदनुष्ठीयतां ध्रुवम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004115064, "chapter_id": 24115, "verse_number": "४-६४-६५", "content_sanskrit": "सेव्योत्तरवहा नित्यं लिंगमर्च्यं प्रयत्नतः ।\nदमो दानं दया नित्यं कर्तव्यं मुक्तिकांक्षिभिः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004115065, "chapter_id": 24115, "verse_number": "४-६४-६६", "content_sanskrit": "इदमेव रहस्यं च कथितं क्षेत्रवासिनाम् ।\nमतिः परहिता कार्या वाच्यं नोद्वेगकृद्वचः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004115066, "chapter_id": 24115, "verse_number": "४-६४-६७", "content_sanskrit": "मनसापि न कर्तव्यमेनोत्र विजिगीषुणा ।\nअत्रत्यमक्षयं यस्मात्सुकृतं सुकृतेतरम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004115067, "chapter_id": 24115, "verse_number": "४-६४-६८", "content_sanskrit": "अन्यत्र यत्कृतं पापं तत्काश्यां परिणश्यति ।\nवाराणस्यां कृतं पापमंतर्गेहे प्रणश्यति ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004115068, "chapter_id": 24115, "verse_number": "४-६४-६९", "content_sanskrit": "अंतर्गेहे कृतं पापं पैशाच्यनरकावहम् ।\nपिशाचनरकप्राप्तिर्गच्छत्येव बहिर्यदि ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004115069, "chapter_id": 24115, "verse_number": "४-६४-७०", "content_sanskrit": "न कल्पकोटिभिः काश्यां कृतं कर्म प्रमृज्यते ।\nकिंतु रुद्रपिशाचत्वं जायतेऽत्रायुतत्रयम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004115070, "chapter_id": 24115, "verse_number": "४-६४-७१", "content_sanskrit": "वाराणस्यां स्थितो यो वै पातकेषु रतः सदा ।\nयोनिं प्राप्यापि पैशाचीं वर्षाणामयुतत्रयम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004115071, "chapter_id": 24115, "verse_number": "४-६४-७२", "content_sanskrit": "पुनरत्रैव निवसञ्ज्ञानं प्राप्स्यत्यनुत्तमम् ।\nतेन ज्ञानेथ संप्राप्ते मोक्षमाप्स्यत्यनुत्तमम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004115072, "chapter_id": 24115, "verse_number": "४-६४-७३", "content_sanskrit": "दुष्कृतानि विधायेह बहिः पंचत्वमागताः ।\nतेषां गतिं प्रवक्ष्यामि शृणुत द्विजसत्तमाः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004115073, "chapter_id": 24115, "verse_number": "४-६४-७४", "content_sanskrit": "यामाख्या मे गणाः संति घोरा विकृतमूर्त्तयः ।\nमूषायां ते धमंत्यादौ क्षेत्रदुष्कृतकारिणः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004115074, "chapter_id": 24115, "verse_number": "४-६४-७५", "content_sanskrit": "नयंत्यनूपप्रायां च ततः प्राचीं दुरासदाम् ।\nवर्षाकाले दुराचारान्पातयंति महाजले ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004115075, "chapter_id": 24115, "verse_number": "४-६४-७६", "content_sanskrit": "जलौकाभिः सपक्षाभिर्दंदशूकैर्जलोद्भवैः ।\nदुर्निवारैश्च मशकैर्दश्यंते ते दिवानिशम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004115076, "chapter_id": 24115, "verse_number": "४-६४-७७", "content_sanskrit": "ततो यामैर्हिमर्तौ ते नीयंतेऽद्रौ हिमालये ।\nअशनावरणैर्हीनाः क्लेश्यंते ते दिवानिशम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004115077, "chapter_id": 24115, "verse_number": "४-६४-७८", "content_sanskrit": "मरुस्थले ततो ग्रीष्मे वारिवृक्षविवर्जिते ।\nदिवाकरकरैस्तीव्रैस्ताप्यंते ते पिपासिताः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004115078, "chapter_id": 24115, "verse_number": "४-६४-७९", "content_sanskrit": "क्लेशितास्ते गणैरुग्रैर्यातनाभिः समंततः ।\nइत्थं कालमसंख्यातमानीयंते ततस्त्विह ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004115079, "chapter_id": 24115, "verse_number": "४-६४-८०", "content_sanskrit": "निवेदयंति ते यामाः कालराजांतिके ततः ।\nकालराजोपि तान्द्रष्ट्वा कर्मसंस्मार्य दुष्कृतम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004115080, "chapter_id": 24115, "verse_number": "४-६४-८१", "content_sanskrit": "विवस्त्रान्क्षुत्तृषार्तांश्च लग्नपृष्ठोदरत्वचः ।\nअन्यै रुद्रपिशाचैश्च सहसंयोजयत्यपि ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004115081, "chapter_id": 24115, "verse_number": "४-६४-८२", "content_sanskrit": "ततो रुद्रपिशाचास्ते भैरवानुचराः सदा ।\nसहंते क्लममत्यर्थं क्षुत्तृष्णोग्रत्वसंभवम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004115082, "chapter_id": 24115, "verse_number": "४-६४-८३", "content_sanskrit": "आहारं रुधिरोन्मिश्रं ते लभंते कदाचन ।\nएवं त्र्ययुतसंख्याकं कालं तत्रातिदुःखिताः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004115083, "chapter_id": 24115, "verse_number": "४-६४-८४", "content_sanskrit": "श्मशानस्तंभमभितो नीयंते कंठपाशिताः ।\nपिपासिता अपि न तेंऽबुस्पर्शमपि चाप्नुयुः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004115084, "chapter_id": 24115, "verse_number": "४-६४-८५", "content_sanskrit": "अथ संक्षीणपापास्ते कालभैरवदर्शनात् ।\nइहैव देहिनो भूत्वा मुच्यंते ते ममाज्ञया ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004115085, "chapter_id": 24115, "verse_number": "४-६४-८६", "content_sanskrit": "तस्मान्न कामयेतात्र वाङ्मनःकर्मणाप्यघह म् ।\nशुचौ पथि सदा स्थेयं महालाभमभीप्सुभिः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004115086, "chapter_id": 24115, "verse_number": "४-६४-८७", "content_sanskrit": "नाविमुक्ते मृतः कश्चिन्नरकं याति किल्बिषी ।\nममानुग्रहमासाद्य गच्छत्येव परां गतिम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004115087, "chapter_id": 24115, "verse_number": "४-६४-८८", "content_sanskrit": "अनाशनं यः कुरुते मद्भक्त इह सुव्रतः ।\nन तस्य पुनरावृत्तिः कल्पकोटिशतैरपि ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004115088, "chapter_id": 24115, "verse_number": "४-६४-८९", "content_sanskrit": "अशाश्वतमिदं ज्ञात्वा मानुष्यं बहुकिल्विषम् ।\nअविमुक्तं सदा सेव्यं संसारभयमोचकम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004115089, "chapter_id": 24115, "verse_number": "४-६४-९०", "content_sanskrit": "नान्यत्पश्यामि जंतूनां मुक्त्वा वाराणसीं पुरीम् ।\nसर्वपापप्रशमनीं प्रायश्चित्तं कलौ युगे ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004115090, "chapter_id": 24115, "verse_number": "४-६४-९१", "content_sanskrit": "जन्मांतरसहस्रेषु यत्पापं समुपार्जितम् ।\nअविमुक्तं प्रविष्टस्य तत्सर्वं व्रजति क्षयम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004115091, "chapter_id": 24115, "verse_number": "४-६४-९२", "content_sanskrit": "जन्मांतरसहस्रेषु युंजन्योगी यदाप्नुयात् ।\nतदिहैव परो मोक्षो मरणादधि गम्यते ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004115092, "chapter_id": 24115, "verse_number": "४-६४-९३", "content_sanskrit": "तिर्यग्योनिगताः सत्त्वा ये विमुक्तकृतालयाः ।\nकालेन निधनं प्राप्तास्तेपि यांति परां गतिम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004115093, "chapter_id": 24115, "verse_number": "४-६४-९४", "content_sanskrit": "अविमुक्तं न सेवंते ये मूढास्तमसावृताः ।\nविण्मूत्ररेतसां मध्ये ते वसंति पुनः पुनः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004115094, "chapter_id": 24115, "verse_number": "४-६४-९५", "content_sanskrit": "अविमुक्तं समासाद्य यो लिंगं स्थापयेत्सुधीः ।\nकल्पकोटिशतैर्वापि नास्ति तस्य पुनर्भवः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004115095, "chapter_id": 24115, "verse_number": "४-६४-९६", "content_sanskrit": "ग्रहनक्षत्रताराणां कालेन पतनं ध्रुवम् ।\nअविमुक्ते मृतानां तु पतनं नैव विद्यते ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004115096, "chapter_id": 24115, "verse_number": "४-६४-९७", "content_sanskrit": "ब्रह्महत्यां नरः कृत्वा पश्चात्संयतमानसः ।\nप्राणांस्त्यजति यः काश्यां स मुक्तो नात्र संशयः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004115097, "chapter_id": 24115, "verse_number": "४-६४-९८", "content_sanskrit": "स्त्रियः पतिव्रता याश्च मम भक्तिसमाहिताः ।\nअविमुक्ते मृता विप्रा यांति ताः परमां गतिम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004115098, "chapter_id": 24115, "verse_number": "४-६४-९९", "content_sanskrit": "अत्रोत्क्रमणकालेहं स्वयमेव द्विजोत्तमाः ।\nदिशामि तारकं ब्रह्म देही स्याद्येन तन्मयः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004115099, "chapter_id": 24115, "verse_number": "४-६४-१००", "content_sanskrit": "मन्मना मम भक्तश्च मयि सर्वार्पितक्रियः ।\nयथा मोक्षमिहाप्नोति न तथान्यत्रकुत्रचित् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004115100, "chapter_id": 24115, "verse_number": "४-६४-१०१", "content_sanskrit": "मरणं निश्चितं ज्ञात्वा गतिं चासुखरूपिणीम् ।\nचलमागंतुकं सर्वं ततः काशीं समाश्रयेत् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004115101, "chapter_id": 24115, "verse_number": "४-६४-१०२", "content_sanskrit": "काशी समाश्रिता यैस्तु मनोवाक्कायकर्मभिः ।\nतानत्र निर्मलधियो निवार्णश्रीः समाश्रयेत् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004115102, "chapter_id": 24115, "verse_number": "४-६४-१०३", "content_sanskrit": "काशीस्थितैकमपि यः प्रीणयेन्न्यायजैर्धनैः ।\nतेन त्रैलोक्यमखिलं प्रीणितं तु मया सह ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004115103, "chapter_id": 24115, "verse_number": "४-६४-१०४", "content_sanskrit": "यः प्रीणयति पुण्यात्मा निर्वाणनगरी नरम् ।\nपुमर्थेन स्थितेर्नित्यं ब्राह्मणाः प्रीणयामि तम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004115104, "chapter_id": 24115, "verse_number": "४-६४-१०५", "content_sanskrit": "दिवोदासोपि राजर्षिः काशीं धर्मेण पालयन् ।\nसदेहो मत्पदं प्राप्तो यतो न पुनरागतिः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004115105, "chapter_id": 24115, "verse_number": "४-६४-१०६", "content_sanskrit": "अत्र योगस्तथा ज्ञानं मुक्तिरेकेन जन्मना ।\nअतो विमुक्तमासाद्य नान्यद्गच्छेत्तपोवनम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004115106, "chapter_id": 24115, "verse_number": "४-६४-१०७", "content_sanskrit": "मोक्षं सुदुर्लभं ज्ञात्वा संसारं चातिभीषणम् ।\nअश्मना चरणौ हत्वा कालमत्र प्रतीक्षयेत् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004115107, "chapter_id": 24115, "verse_number": "४-६४-१०८", "content_sanskrit": "अविमुक्तं परित्यज्य यदा यास्यंति दुर्धियः ।\nहसिष्यंति तदा भूतान्यन्योन्यकरताडनैः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004115108, "chapter_id": 24115, "verse_number": "४-६४-१०९", "content_sanskrit": "प्राप्य वाराणसीं पुण्यां सिद्धिक्षेत्रमनुत्तमम् ।\nपरिनिष्क्रांतुमन्यत्र कस्य जंतोर्मतिर्भवेत् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004115109, "chapter_id": 24115, "verse_number": "४-६४-११०", "content_sanskrit": "महादानेन चान्यत्र यत्फलं लभ्यते नरैः ।\nअविमुक्ते तु काकिण्यां दत्तायां तदवाप्यते ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004115110, "chapter_id": 24115, "verse_number": "४-६४-१११", "content_sanskrit": "एकं समर्चयेल्लिंगं तपस्तप्येत चापरः ।\nतयोर्मध्ये तु स श्रेष्ठो यो लिंगं पूजयेदिह ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004115111, "chapter_id": 24115, "verse_number": "४-६४-११२", "content_sanskrit": "तीर्थांतरे गवां कोटिं विधिवद्यः प्रयच्छति ।\nएकाहं यो वसेत्काश्यां काशीवासी तयोर्वरः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004115112, "chapter_id": 24115, "verse_number": "४-६४-११३", "content_sanskrit": "अन्यत्र ब्राह्मणानां तु कोटिं संभोज्य यत्फलम् ।\nवाराणस्यां तु चैकेन भोजितेन तदाप्यते ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004115113, "chapter_id": 24115, "verse_number": "४-६४-११४", "content_sanskrit": "सन्निहत्यां कुरुक्षेत्रे राहुग्रस्ते दिवाकरे ।\nतुलापुरुषदानेन काशीभिक्षा समा भवेत् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004115114, "chapter_id": 24115, "verse_number": "४-६४-११५", "content_sanskrit": "ममेह परमं ज्योतिरापातालाद्व्यवस्थितम् ।\nअतीत्य सप्तलोकादीननंतं लिंगरूपधृक् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004115115, "chapter_id": 24115, "verse_number": "४-६४-११६", "content_sanskrit": "पृथिव्यंतेपि ये लिंगमविमुक्तं स्मरंति मे ।\nकलुषैस्ते विमुच्यंते महद्भिरिति निश्चितम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004115116, "chapter_id": 24115, "verse_number": "४-६४-११७", "content_sanskrit": "अस्मिन्क्षेत्रे तु ये नाहं दृष्टः स्पृष्टः समर्चितः ।\nसंप्राप्य तारकं ज्ञानं न स भूयोभिजायते ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004115117, "chapter_id": 24115, "verse_number": "४-६४-११८", "content_sanskrit": "यो मामिह समभ्यर्च्य म्रियतेन्यत्रकुत्रचित् ।\nजन्मांतरेपि मां प्राप्य स विमुक्तो भविष्यति ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004115118, "chapter_id": 24115, "verse_number": "४-६४-११९", "content_sanskrit": "इत्युक्त्वा क्षेत्रमाहात्म्यं द्विजानामग्रतो हरः ।\nपश्यतामेव तेषां तु तत्रैवांतर्हितोभवत् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004115119, "chapter_id": 24115, "verse_number": "४-६४-१२०", "content_sanskrit": "तेपि साक्षाद्विरूपाक्षं प्रत्यक्षीकृत्य वाडवाः ।\nप्रहृष्टमनसोऽत्यंतं प्रययुः स्वस्वमाश्रयम् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004115120, "chapter_id": 24115, "verse_number": "४-६४-१२१", "content_sanskrit": "शंभोर्वाक्यं विनिश्चित्य सर्वज्ञस्य कृपानिधेः ।\nत्यक्त्वा कार्यांतरं विप्रा लिंगान्येव समर्चिषुः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004115121, "chapter_id": 24115, "verse_number": "४-६४-१२२", "content_sanskrit": "स्कंद उवाच ।\nपठित्वा पाठयित्वा च रहस्याख्यानमुत्तमम् ।\nश्रद्धालुः पातकैर्मुक्तः शिवलोके महीयते ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004115122, "chapter_id": 24115, "verse_number": "४-६४-१२३", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीति साहस्र्यां संहितायां चतुर्थे काशीखंड उत्तरार्द्धे क्षेत्ररहस्यकथनंनाम चतुःषष्टितमोऽध्यायः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}]