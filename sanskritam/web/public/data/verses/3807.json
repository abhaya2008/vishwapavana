[{"id": 2130205, "chapter_id": 3807, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2130206, "chapter_id": 3807, "verse_number": "१", "content_sanskrit": "एतच्छ्रुत्वा वचस्तस्य वानरेन्द्रस्य धीमतः ।\nभीमसेनस्तदा वीरः प्रोवाचामित्रकर्षणः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2130207, "chapter_id": 3807, "verse_number": "२", "content_sanskrit": "को भवान् किन्निमित्तं वा वानरं वपुरास्थितः ।\nब्राह्मणानन्तरो वर्णः क्षत्रियस्त्वां तु पृच्छति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2130208, "chapter_id": 3807, "verse_number": "३", "content_sanskrit": "कौरवः सोमवंशीयः कुन्त्या गर्भेण धारितः ।\nपाण्डवो वायुतनयो भीमसेन इति श्रुतः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2130209, "chapter_id": 3807, "verse_number": "", "content_sanskrit": "वैशम्पायतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2130210, "chapter_id": 3807, "verse_number": "४", "content_sanskrit": "स वाक्यं कुरुवीरस्य स्मितेन प्रतिगृह्य तत् ।\nहनूमान् वायुतनयो वायुपुत्रमभाषत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2130211, "chapter_id": 3807, "verse_number": "", "content_sanskrit": "हनूमान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2130212, "chapter_id": 3807, "verse_number": "५", "content_sanskrit": "वानरोऽहं न ते मार्गं प्रदास्यामि यथेप्सितम् ।\nसाधु गच्छ निवर्तस्व मा त्वं प्राप्स्यसि वैशसम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2130213, "chapter_id": 3807, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2130214, "chapter_id": 3807, "verse_number": "६", "content_sanskrit": "वैशसं वाऽस्तु यद्वाऽन्यन्न त्वां पृच्छामि वानर ।\nप्रयच्छ मार्गमुत्तिष्ठ मा मत्तः प्राप्स्यसे व्यथाम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2130215, "chapter_id": 3807, "verse_number": "", "content_sanskrit": "हनूमान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2130216, "chapter_id": 3807, "verse_number": "७", "content_sanskrit": "नास्ति शक्तिर्ममोत्थातुं व्याधिना क्लेशितो ह्यहम् ।\nयद्यवश्यं प्रयातव्यं लङ्घयित्वा प्रयाहि माम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2130217, "chapter_id": 3807, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2130218, "chapter_id": 3807, "verse_number": "८", "content_sanskrit": "निर्गुणः परमात्मा तु देहं व्याप्यावतिष्ठते ।\nतमहं ज्ञानविज्ञेयं नावमन्ये न लङ्घये\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2130219, "chapter_id": 3807, "verse_number": "९", "content_sanskrit": "यद्यागमैर्न विद्यां च तमहं भूतभावनम् ।\nक्रमेयं त्वां गिरिं चैव हनूमानिव सागरम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2130220, "chapter_id": 3807, "verse_number": "", "content_sanskrit": "हनूमान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2130221, "chapter_id": 3807, "verse_number": "१०", "content_sanskrit": "क एष हनुमान्नाम सागरो येन लङ्घितः ।\nपृच्छामि त्वां नरश्रेष्ठ कथ्यतां यदि शक्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2130222, "chapter_id": 3807, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2130223, "chapter_id": 3807, "verse_number": "११", "content_sanskrit": "भ्राता मम गुणश्लाघ्यो बुद्धिसत्त्वबलान्वितः ।\nरामायणेऽतिविख्यातः श्रीमान् वानरपुङ्गवः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2130224, "chapter_id": 3807, "verse_number": "१२", "content_sanskrit": "रामपत्नीकृते येन शतयोजनविस्तृतः ।\nसागरः प्लवगेन्द्रेण क्रमेणैकेन लङ्घितः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2130225, "chapter_id": 3807, "verse_number": "१३", "content_sanskrit": "स मे भ्राता महावीर्यस्तुल्योऽहं तस्य तेजसा ।\nबले पराक्रमे युद्धे शक्तोऽहं तव निग्रहे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2130226, "chapter_id": 3807, "verse_number": "१४", "content_sanskrit": "इमं देशमनुप्राप्तः कारणेनास्मि केनचित् ।\nउत्तिष्ठ देहि मे मार्गं पश्य मे चाद्य पौरुषम् ।\nमच्छासनमकुर्वाणं त्वां वा नेष्ये यमक्षयम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2130227, "chapter_id": 3807, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2130228, "chapter_id": 3807, "verse_number": "१५", "content_sanskrit": "विज्ञाय तं बलोन्मत्तं बाहुवीर्येण दर्पितम् ।\nहृदयेनावहस्यैनं हनूमान् वाक्यमब्रवीत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2130229, "chapter_id": 3807, "verse_number": "१६", "content_sanskrit": "प्रसीद नास्ति मे शक्तिरुत्थातुं जरयाऽनघ ।\nममानुकम्पया त्वेतत्पुच्छमुत्सार्य गम्यताम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2130230, "chapter_id": 3807, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2130231, "chapter_id": 3807, "verse_number": "१७", "content_sanskrit": "एवमुक्तस्तु बलवान् भीमो भीमपराक्रमः ।\nसावज्ञमथ वामेन स्मयन् जग्राह पाणिना\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2130232, "chapter_id": 3807, "verse_number": "१८", "content_sanskrit": "न चाशकच्चालयितुं भीमः पुच्छं महाकपेः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2130233, "chapter_id": 3807, "verse_number": "१९", "content_sanskrit": "उच्चिक्षेप पुनर्दोर्भ्यामिन्द्रायुधमिवोच्छ्रितम् ।\nनोद्धर्तुमशकद् भीमो दोर्भ्यामपि महाबलः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2130234, "chapter_id": 3807, "verse_number": "२०", "content_sanskrit": "उत्क्षिप्तभ्रूर्विवृत्ताक्षः संहतभ्रुकुटीमुखः ।\nस्विन्नगात्रोऽभवद् भीमो न चोद्धर्तुं शशाक तम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2130235, "chapter_id": 3807, "verse_number": "२१", "content_sanskrit": "यत्नवानपि तु श्रीमाँल्लाङ्गूलोद्धरणे ततः(णोद्धुरः)।\nकपेः पार्श्वगतो भीमस्तस्थौ व्रीडानताननः ।\nप्रणिपत्य च कौन्तेयः प्राञ्जलिर्वाक्यमब्रवीत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2130236, "chapter_id": 3807, "verse_number": "२२", "content_sanskrit": "प्रसीद कपिशार्दूल दुरुक्तं क्षम्यतां मम\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2130237, "chapter_id": 3807, "verse_number": "२३", "content_sanskrit": "सिद्धो वा यदि वा देवो गन्धर्वो वाऽथ गुह्यकः ।\nपृष्टः सन् काम्यया ब्रूहि कस्त्वं वानररूपधृक्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2130238, "chapter_id": 3807, "verse_number": "", "content_sanskrit": "शिष्यवत्त्वां तु पृच्छामि उपपन्नोऽस्मि तेऽनघ ।\nगन्धर्वो गुह्यको वा त्वं कथयस्व ममानघ ।\nकामेन पृच्छतो ब्रूहि कस्त्वं वानररूपधृक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2130239, "chapter_id": 3807, "verse_number": "", "content_sanskrit": "न चेद् गुह्यं महाभाग श्रोतव्यं स्यान्मया यदि ॥ (अ.पा)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2130240, "chapter_id": 3807, "verse_number": "", "content_sanskrit": "हनूमान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2130241, "chapter_id": 3807, "verse_number": "२४", "content_sanskrit": "यत् ते मम परिज्ञाने कौतूहलमरिन्दम ।\nतत्सर्वमखिलेन त्वं शृणु पाण्डवनन्दन\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2130242, "chapter_id": 3807, "verse_number": "२५", "content_sanskrit": "अहं केसरिणः क्षेत्रे वायुना जगदायुषा ।\nजातः कमलपत्राक्ष हनूमान्नाम वानरः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2130243, "chapter_id": 3807, "verse_number": "२६", "content_sanskrit": "सूर्यपुत्रं च सुग्रीवं शक्रपुत्रं च वालिनम्।\nसर्वे वानरराजानस्तथा वानरयूथपाः ।\nउपतस्थुर्महावीर्या मम चामित्रकर्षण\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2130244, "chapter_id": 3807, "verse_number": "२७", "content_sanskrit": "सुग्रीवेणाभवत् प्रीतिरनिलस्याग्निना यथा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2130245, "chapter_id": 3807, "verse_number": "२८", "content_sanskrit": "निकृतः स ततो भ्रात्रा कस्मिंश्चित् कारणान्तरे ।\nऋष्यमूके मया सार्धं सुग्रीवो न्यवसच्चिरम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2130246, "chapter_id": 3807, "verse_number": "२९", "content_sanskrit": "अथ दाशरथिर्वीरो रामो नाम महाबलः ।\nविष्णुर्मानुषरूपेण चचार वसुधातळम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2130247, "chapter_id": 3807, "verse_number": "३०", "content_sanskrit": "स पितुः प्रियमन्विच्छन् सहभार्यः सहानुजः ।\nसधनुर्धन्विनां श्रेष्ठो दण्डकारण्यमाश्रितः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2130248, "chapter_id": 3807, "verse_number": "३१", "content_sanskrit": "तस्य भार्या जनस्थानाच्छलेनापहृता बलात् ।\nवञ्चयित्वा नरव्याघ्रं मारीचेन तदाऽनघ \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2130249, "chapter_id": 3807, "verse_number": "३२", "content_sanskrit": "राक्षसेन्द्रेण बलिना रावणेन दुरात्मना ।\nसुवर्णरत्नचित्रेण मृगरूपेण रक्षसा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2130250, "chapter_id": 3807, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि चतुश्चत्वारिंशदधिकशततमोऽध्यायः ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2130251, "chapter_id": 3807, "verse_number": "१००", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि शततमोऽध्यायः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2130252, "chapter_id": 3807, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]