[{"id": 2080519, "chapter_id": 2712, "verse_number": "१२-२१७-०x", "content_sanskrit": "गुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080520, "chapter_id": 2712, "verse_number": "१२-२१७-१", "content_sanskrit": "दुरन्तेष्विन्द्रियार्थेषु सक्ताः सीदन्ति जन्तवः।\nये त्वसक्ता महात्मानस्ते यान्ति परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080521, "chapter_id": 2712, "verse_number": "१२-२१७-२", "content_sanskrit": "जन्ममृत्युजरादुःखैर्व्याधिभिर्मानसक्लमैः।\nदृष्ट्वैव संततं लोकं घटेन्मोक्षाय बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080522, "chapter_id": 2712, "verse_number": "१२-२१७-३", "content_sanskrit": "वाङ्भनोभ्यां शरीरेण शुचिः स्यादनहंकृतः।\nप्रशान्तो ज्ञानवान्भिक्षुर्निरपेक्षश्चरेत्सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080523, "chapter_id": 2712, "verse_number": "१२-२१७-४", "content_sanskrit": "`वशा मोक्षवतां पाशास्तासां रूपं प्रदर्शकम्।\nदुर्ग्रहं पश्यमानोऽपि मन्यते मोहितस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080524, "chapter_id": 2712, "verse_number": "१२-२१७-५", "content_sanskrit": "एवं पश्यन्तमात्मानमनुध्यातं हि बन्धुषु।\nअयथात्वेन जानामि भेदरूपेण संस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080525, "chapter_id": 2712, "verse_number": "१२-२१७-६", "content_sanskrit": "अथवा मनसः सङ्गं पश्येद्भूतानुकम्पया।\nतत्राप्युपेक्षां कुर्वीत ज्ञात्वा कर्मफलं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080526, "chapter_id": 2712, "verse_number": "१२-२१७-७", "content_sanskrit": "यत्कृतं स्याच्छुभं कर्म पापं वा यदि वाऽश्नुते।\nतस्माच्छुभानि कर्माणि कुर्याद्वा बुद्धिकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080527, "chapter_id": 2712, "verse_number": "१२-२१७-८", "content_sanskrit": "अहिंसा सत्यवचनं सर्वभूतेषु चार्जवम्।\nक्षमा चैवाप्रमादश्च यस्यैते स सुखी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080528, "chapter_id": 2712, "verse_number": "१२-२१७-९", "content_sanskrit": "`अनक्षसाध्यं तद्ब्रह्म निर्मलं जगतः परम्।\nस्वात्मप्रकाशमग्राह्यमहेतुकमचञ्चलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080529, "chapter_id": 2712, "verse_number": "१२-२१७-१०", "content_sanskrit": "विवेकज्ञानवाचिस्थो ह्याशुरूपेण संस्थितः।\nवैकारिकात्प्रदृश्येतै गैरिके मधुधारवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080530, "chapter_id": 2712, "verse_number": "१२-२१७-११", "content_sanskrit": "यश्चैनं परमं धर्मं सर्वभूतसुखावहम्।\nदुःखान्निः सरणं वेद तत्त्वज्ञः स सुखी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080531, "chapter_id": 2712, "verse_number": "१२-२१७-१२", "content_sanskrit": "तस्मात्समाहितं बुद्ध्या मनो भूतेषु धारयेत्।\nनापथ्यायेन्न स्पृहयेन्नाबद्धं चिन्तयेदसत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080532, "chapter_id": 2712, "verse_number": "१२-२१७-१३", "content_sanskrit": "अथामोघप्रयत्नेन मनो ज्ञाने निवेशयेत्।\nसुवाचोऽथ प्रयोगेण मनोज्ञं संप्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080533, "chapter_id": 2712, "verse_number": "१२-२१७-१४", "content_sanskrit": "विवेकयित्वा तद्वाक्यं धर्मसूक्ष्ममवेक्ष्य च।\nसत्यां वाचमहिंस्रां च वदेदनपवादिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2080534, "chapter_id": 2712, "verse_number": "१२-२१७-१५", "content_sanskrit": "कल्कापेतामपरुषामनृशंसामपैशुनीम्।\nईदृगल्पं च वक्तव्यमविक्षिप्तेन चेतसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2080535, "chapter_id": 2712, "verse_number": "१२-२१७-१६", "content_sanskrit": "वाक्यबन्धेन संरागविहाराद्व्याहरेद्यदि।\nबुद्ध्याऽप्यनुगृहीतेन मनसा कर्म तामसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2080536, "chapter_id": 2712, "verse_number": "१२-२१७-१७", "content_sanskrit": "रजोभूतैर्हि करणैः कर्मणि प्रतिपद्यते।\nस दुःखं प्राप्य लोकेऽस्मिन्नरकायोपपद्यते।\nतस्मान्मनोवाक्शरीरैराचरेद्वैर्यमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2080537, "chapter_id": 2712, "verse_number": "१२-२१७-१८", "content_sanskrit": "प्रकीर्ण एव भारो हि यद्वद्धार्येत दस्युभिः।\nप्रतिलोमां दिशं बुद्ध्वा संसारमबुधास्तथा।\n`संसारमार्गमापन्नः प्रतिलोमं विवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2080538, "chapter_id": 2712, "verse_number": "१२-२१७-१९", "content_sanskrit": "तामेव च यथा दस्यून्हत्वा गच्छेच्छिवां दिशम्।\nतथा रजस्तमः कर्माण्युत्सृज्य प्राप्नुयाच्छुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2080539, "chapter_id": 2712, "verse_number": "१२-२१७-२०", "content_sanskrit": "निःसंदिग्धमनीहो वै मुक्तः सर्वपरिग्रहैः।\nविविक्तचारी लघ्वाशी तपस्वी नियतेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2080540, "chapter_id": 2712, "verse_number": "१२-२१७-२१", "content_sanskrit": "ज्ञानदग्धपरिक्लेशः प्रयोगरतिरात्मवान्।\nनिष्प्रचारेण मनसा परं तदधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2080541, "chapter_id": 2712, "verse_number": "१२-२१७-२२", "content_sanskrit": "धृतिमानात्मवान्बुद्धिं निगृह्णीयादसंशयम्।\nमनो बुद्ध्या निगृह्णीयाद्विषयान्मनसाऽऽत्मनः।\n`योजयित्वा मनस्तत्र निश्चलं परमात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2080542, "chapter_id": 2712, "verse_number": "१२-२१७-२३", "content_sanskrit": "योगाभिसन्धियुक्तस्य ब्रह्म तत्संप्रकाशते।\nऐकान्त्यं तदिदं विद्धि सर्ववस्त्वन्तरस्थितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2080543, "chapter_id": 2712, "verse_number": "१२-२१७-२४", "content_sanskrit": "विशेषहीनं गृह्णन्ति विशेषां कारणात्मिकाम्।\nअथवा न प्रभुस्तत्र परमात्मनि वर्तितुम्।\nआगामित्तत्त्वं योगात्मा योगतन्त्रमुपक्रमेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2080544, "chapter_id": 2712, "verse_number": "१२-२१७-२५", "content_sanskrit": "निगृहीतेन्द्रियस्यास्य कुर्वाणस्य मनो वशे।\nदेवतास्ताः प्रकाशन्ते हृष्टा यान्ति तमीश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2080545, "chapter_id": 2712, "verse_number": "१२-२१७-२६", "content_sanskrit": "ताभिः संयुक्तमनसो ब्रह्म तत्संप्रकाशते।\nशनैश्चापगते सत्वे ब्रह्मभूयाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2080546, "chapter_id": 2712, "verse_number": "१२-२१७-२७", "content_sanskrit": "अथवा न प्रवर्तेत योगतन्त्रैरुपक्रमेत्।\nयोगतन्त्रमयं तन्त्रं वृत्तिः स्यात्ततदाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2080547, "chapter_id": 2712, "verse_number": "१२-२१७-२८", "content_sanskrit": "कणकुल्माषपिण्याकशाकयावकसक्तवः।\nतथा मूलफलं भैक्ष्यं पर्यायेणोपयोजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2080548, "chapter_id": 2712, "verse_number": "१२-२१७-२९", "content_sanskrit": "आहारनियमं चैव देशे काले च सात्विकः।\nतत्परीक्ष्यानुवर्तेत यत्प्रवृत्त्यनुवर्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2080549, "chapter_id": 2712, "verse_number": "१२-२१७-३०", "content_sanskrit": "प्रवृत्तं नोपरुन्धेत शनैरग्निमिवेन्धयेत्।\nज्ञानैधितं तथा ज्ञानमर्कवत्संप्रकाशते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2080550, "chapter_id": 2712, "verse_number": "१२-२१७-३१", "content_sanskrit": "ज्ञानाधिष्ठानमज्ञानं त्रील्लोँकानधितिष्ठति।\nविज्ञानानुगतं ज्ञानमज्ञानेनापकृष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2080551, "chapter_id": 2712, "verse_number": "१२-२१७-३२", "content_sanskrit": "पृथक्त्वात्संप्रयोगाच्च नासूयुर्वेद शाश्वतम्।\nस तयोरपवर्गज्ञो वीतरागो विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2080552, "chapter_id": 2712, "verse_number": "१२-२१७-३३", "content_sanskrit": "वयोतीतो जरामृत्यू जित्वा ब्रह्म सनातनम्।\nअमृतं तदवाप्नोति यत्तदक्षरमव्ययम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2080553, "chapter_id": 2712, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि सप्तदशाधिकद्विशततमोऽध्यायः॥ २१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]