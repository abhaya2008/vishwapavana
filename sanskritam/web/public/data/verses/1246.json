[{"id": 2012001, "chapter_id": 1246, "verse_number": "१-२४७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012002, "chapter_id": 1246, "verse_number": "१-२४७-१", "content_sanskrit": "अथ शुश्राव निर्वृत्ते वृष्णीनां परमोत्सवे।\nअर्जुनेन हृतां भद्रां शङ्खचक्रगदाधरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012003, "chapter_id": 1246, "verse_number": "१-२४७-२", "content_sanskrit": "पुरस्तादेव पौराणां संशयः समजायत।\nजानता वासुदेवेन वासितो भरतर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012004, "chapter_id": 1246, "verse_number": "१-२४७-३", "content_sanskrit": "लोकस्य विदितं ह्यद्य पूर्वं विपृथुना यथा।\nसान्त्वयित्वाभ्यनुज्ञातो भद्रया सह सङ्गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012005, "chapter_id": 1246, "verse_number": "१-२४७-४", "content_sanskrit": "दित्सता सोदरां तस्मै पतत्त्रिवरकेतुना।\nअर्हते पार्थिवेन्द्राय पार्थायायतलोचनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012006, "chapter_id": 1246, "verse_number": "१-२४७-५", "content_sanskrit": "सत्कृत्य पाण्डवश्रेष्ठं प्रेषयामास चार्जुनम्।\nभद्रया सह बीभत्सुः प्रापितो वृजिनं पुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012007, "chapter_id": 1246, "verse_number": "१-२४७-६", "content_sanskrit": "इति पौरजनाः सर्वे वदन्ति च समन्ततः।\nश्रुत्वा तु पुण्डरीकाक्षः संप्राप्तं स्वपुरोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012008, "chapter_id": 1246, "verse_number": "१-२४७-७", "content_sanskrit": "अर्जुनं पाण्डवश्रेष्ठमिन्द्रप्रस्थगतं तथा।\nयियासुः खाण्डवप्रस्थममन्त्रयत केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012009, "chapter_id": 1246, "verse_number": "१-२४७-८", "content_sanskrit": "पूर्वं सत्कृत्य राजानमाहुकं मधुसूदनः।\nतथा विपृथुमक्रूरं संकर्षणविडूरथौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012010, "chapter_id": 1246, "verse_number": "१-२४७-९", "content_sanskrit": "मन्त्रयामास तैः सार्धं पुरस्तादभिमानितैः।\nसंकर्षणेन संमन्त्र्य ह्यनुज्ञातो महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012011, "chapter_id": 1246, "verse_number": "१-२४७-१०", "content_sanskrit": "संप्रीतः प्रीयमाणेन वृष्णिराज्ञा जनार्दनः।\nअभिमन्त्र्याभ्यनुज्ञातो योजयामास वाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012012, "chapter_id": 1246, "verse_number": "१-२४७-११", "content_sanskrit": "ततस्तु यानान्यासाद्य दाशार्हाणां यशस्विनाम्।\nसिंहनादः प्रहृष्टानां क्षणेन समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012013, "chapter_id": 1246, "verse_number": "१-२४७-१२", "content_sanskrit": "योजयन्तः सदश्वांस्तु यानयुग्यं रथांस्तथा।\nगजांश्च परमप्रीतः समपद्यन्त वृष्णयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012014, "chapter_id": 1246, "verse_number": "१-२४७-१३", "content_sanskrit": "वृष्ण्यन्धकमहामात्रैः सह वीरैर्महारथैः।\nभ्रातृभिश्च कुमारैश्च योधैश्च शतशो वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012015, "chapter_id": 1246, "verse_number": "१-२४७-१४", "content_sanskrit": "सैन्येन महता शौरिरभिगुप्तः समन्ततः।\nतत्र दानपतिः श्रीमाञ्जगाम स महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012016, "chapter_id": 1246, "verse_number": "१-२४७-१५", "content_sanskrit": "अक्रूरो वृष्णिवीराणां सेनापतिररिन्दमः।\nअनाधृष्टिर्महातेजा उद्धवश्च महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012017, "chapter_id": 1246, "verse_number": "१-२४७-१६", "content_sanskrit": "साक्षाद्वृहस्पतेः शिष्यो महाबुद्धिर्महामनाः।\nसत्यकः सात्यकिश्चैव कृतवर्मा च सात्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012018, "chapter_id": 1246, "verse_number": "१-२४७-१७", "content_sanskrit": "प्रद्युम्नश्चैव साम्बश्च निशङ्कुः शङ्कुरेव च।\nचारुदेष्णश्च विक्रान्तो झिल्ली विपृथुरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012019, "chapter_id": 1246, "verse_number": "१-२४७-१८", "content_sanskrit": "सारणश्च महाबाहुर्गदश्च विदुषां वरः।\nएते चान्ये च बहवो वृष्णिभोजान्धकास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012020, "chapter_id": 1246, "verse_number": "१-२४७-१९", "content_sanskrit": "आजग्मः खाण्डवप्रस्थमादाय हरणं बहु।\nउपहारं समादाय पृथुवृष्णिपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012021, "chapter_id": 1246, "verse_number": "१-२४७-२०", "content_sanskrit": "प्रययुः सिंहनादेन सुभध्रामवलोककाः।\nते त्वदीर्घेण कालेन कृष्णेन सह यादवाः।\nपुरमासाद्य पार्थानां परां प्रीतिमवाप्नुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012022, "chapter_id": 1246, "verse_number": "१-२४७-२१", "content_sanskrit": "ततो युधिष्ठिरो सजा श्रुत्वा माघवमागतम्।\nप्रतिग्रहार्थं कृष्णस्य यमौ प्रास्थापयत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012023, "chapter_id": 1246, "verse_number": "१-२४७-२२", "content_sanskrit": "ताभ्यां प्रतिगृहीतं तु वृष्णिचक्रं महर्द्धिमत्।\nविवेश खाण्डवप्रस्थं पताकाध्वजशोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012024, "chapter_id": 1246, "verse_number": "१-२४७-२३", "content_sanskrit": "संमृष्टसिक्तपन्थानं पुष्पप्रकरशोभितम्।\nचन्दनस्य रसैः शीतैः पुम्यगन्धैर्निषेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012025, "chapter_id": 1246, "verse_number": "१-२४७-२४", "content_sanskrit": "दह्यताऽगुरुणा चैव देशे देशे सुगन्धिना।\nहृष्टपुष्टजनाकीर्णं वणिग्भिरुपशोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012026, "chapter_id": 1246, "verse_number": "१-२४७-२५", "content_sanskrit": "प्रतिपेदे महाबाहुः सह रामेण केशवः।\nवृष्ण्यन्धकैस्तथा भोजैः समेतः पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2012027, "chapter_id": 1246, "verse_number": "१-२४७-२६", "content_sanskrit": "संपूज्यमानः पौरैश्च ब्राह्मणैश्च सहस्रशः।\nविवेश भवनं राज्ञः पुरन्दरगृहोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2012028, "chapter_id": 1246, "verse_number": "१-२४७-२७", "content_sanskrit": "युधिष्ठिरस्तु रामेण समागच्छद्यथाविधि।\nमूर्ध्नि केशवमाघ्राय बाहुभ्यां परिषस्वजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2012029, "chapter_id": 1246, "verse_number": "१-२४७-२८", "content_sanskrit": "तं प्रीयमाणो गोविन्दो विनयेनाभिपूजयन्।\nभीमं च पुरुषव्याघ्रं विधिवत्प्रत्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2012030, "chapter_id": 1246, "verse_number": "१-२४७-२९", "content_sanskrit": "तांश्च वृष्ण्यन्धकश्रेष्ठान्कुन्तीपुत्रो युधिष्ठिरः।\nप्रतिजग्राह सत्कारैर्यथाविधि यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2012031, "chapter_id": 1246, "verse_number": "१-२४७-३०", "content_sanskrit": "गुरुवत्पूजयामास कांश्चित्कांश्चिद्वयस्यवत्।\nकांश्चिदभ्यवदत्प्रेम्णा कैश्चिदप्यभिवादितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2012032, "chapter_id": 1246, "verse_number": "१-२४७-३१", "content_sanskrit": "ततः पृथा च पार्थाश्च मुदिताः कृष्णया सह।\nपुण्डरीकाक्षमासाद्य बभूवुर्मुदितेन्द्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2012033, "chapter_id": 1246, "verse_number": "१-२४७-३२", "content_sanskrit": "हर्षादभिगतौ दृष्ट्वा संकर्षणजनार्दनौ।\nबन्धुमन्तं पृथा पार्थं युधिष्ठिरममन्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2012034, "chapter_id": 1246, "verse_number": "१-२४७-३३", "content_sanskrit": "ततः सङ्कर्षणाक्रूरावप्रमेयावदीनवत्।\nभद्रवत्यै सुभद्रायै धनौघमुपजह्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2012035, "chapter_id": 1246, "verse_number": "१-२४७-३४", "content_sanskrit": "प्रवालानि च हाराणि भूषणानि सहस्रशः।\nकुथास्तरपरिस्तोमान्व्याघ्राजिनपुरस्कृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2012036, "chapter_id": 1246, "verse_number": "१-२४७-३५", "content_sanskrit": "विविधैश्चैव रंत्नौगैर्दीप्तप्रभमजायत।\nशयनासनयानैश्च युधिष्ठिरनिवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2012037, "chapter_id": 1246, "verse_number": "१-२४७-३६", "content_sanskrit": "ततः प्रीतिकरो यूनां विवाहपरमोत्सवः।\nभद्रवत्यै सुभद्रायै सप्तरात्रमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2012038, "chapter_id": 1246, "verse_number": "१-२४७-३७", "content_sanskrit": "तेषां ददौ हृषीकेशो जन्यार्थे धनमुत्तमम्।\nहरणं वै सुभद्राया ज्ञातिदेयं महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2012039, "chapter_id": 1246, "verse_number": "१-२४७-३८", "content_sanskrit": "रथानां काञ्चनाङ्गानां किङ्किणीजालमालिनाम्।\nचतुर्युजामुपेतानां सूतैः कुशलशिक्षितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2012040, "chapter_id": 1246, "verse_number": "१-२४७-३९", "content_sanskrit": "सहस्रं प्रददौ कृष्मो गवामयुतमेव च।\nश्रीमान्माथुरदेश्यानां दोग्ध्रीणां पुण्यवर्चसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2012041, "chapter_id": 1246, "verse_number": "१-२४७-४०", "content_sanskrit": "बडवानां च शुद्धानां चन्द्रांशुसमवर्चसाम्।\nददौ जनार्दनः प्रीत्या सहस्रं हेमभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2012042, "chapter_id": 1246, "verse_number": "१-२४७-४१", "content_sanskrit": "तथैवाश्वतरीणां च दान्तानां वातरंहसाम्।\nशतान्यञ्जनकेशीनां श्वेतानां पञ्चपञ्च च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2012043, "chapter_id": 1246, "verse_number": "१-२४७-४२", "content_sanskrit": "स्नानपानोत्सवे चैव प्रयुक्तं वयसान्वितम्।\nस्त्रीणां सहस्रं गौरीणां सुवेषाणां सुवर्चसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2012044, "chapter_id": 1246, "verse_number": "१-२४७-४३", "content_sanskrit": "सुवर्णशतकण्ठीनामरोमाणां स्वलङ्कृताम्।\nपरिचर्यासु दक्षाणां प्रददौ पुष्करेक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2012045, "chapter_id": 1246, "verse_number": "१-२४७-४४", "content_sanskrit": "पृष्ठ्यानामपि चाश्वानां बाह्लिकानां जनार्दनः।\nददौ शतसहस्राख्यं कन्याधनमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2012046, "chapter_id": 1246, "verse_number": "१-२४७-४५", "content_sanskrit": "कृताकृतस्य मुख्यस्य कनकस्याग्निवर्चसः।\nमनुष्यभारान्दाशार्हो ददौ दश जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2012047, "chapter_id": 1246, "verse_number": "१-२४७-४६", "content_sanskrit": "गजानां तु प्रभिन्नानां त्रिधा प्रस्रवतां मदम्।\nगिरिकूटनिकाशानां समरेष्वनिवर्तिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2012048, "chapter_id": 1246, "verse_number": "१-२४७-४७", "content_sanskrit": "क्लृप्तानां पटुघण्टानां चारूणां हेममालिनाम्।\nहस्त्यारोहैरुपेतानां सहस्रं साहसप्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2012049, "chapter_id": 1246, "verse_number": "१-२४७-४८", "content_sanskrit": "रामः पाणिग्रहणिकं ददौ पार्थाय लाङ्गली।\nप्रीयमाणो हलधरः संबन्धं प्रति मानयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2012050, "chapter_id": 1246, "verse_number": "१-२४७-४९", "content_sanskrit": "स महाधनरत्नौघो वस्त्रकम्बलफेनवान्।\nमहागजमहाग्राहः पताकाशैवलाकुलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2012051, "chapter_id": 1246, "verse_number": "१-२४७-५०", "content_sanskrit": "पाण्डुसागरमाविद्धः प्रविवेश महाधनः।\nपूर्णमापूरयंस्तेषां द्विषच्छोकावहोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2012052, "chapter_id": 1246, "verse_number": "१-२४७-५१", "content_sanskrit": "प्रतिजग्राह तत्सर्वं धर्मराजो युधिष्ठिरः।\nपूजयामास तांश्चैव वृष्ण्यन्धकमहारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2012053, "chapter_id": 1246, "verse_number": "१-२४७-५२", "content_sanskrit": "ते समेता महात्मानः कुरुवृष्ण्यन्धकोत्तमाः।\nविजह्रुरमरावासे नराः सुकृतिनो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2012054, "chapter_id": 1246, "verse_number": "१-२४७-५३", "content_sanskrit": "तत्रतत्र महानादैरुत्कृष्टतलनादितैः।\nयथायोगं यथाप्रीति विजह्रुः कुरुवृष्णयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2012055, "chapter_id": 1246, "verse_number": "१-२४७-५४", "content_sanskrit": "एवमुत्तमवीर्यास्ते विहृत्य दिवसान्बहून्।\nपूजिताः कुरुभिर्जग्मुः पुनर्द्वारवतीं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2012056, "chapter_id": 1246, "verse_number": "१-२४७-५५", "content_sanskrit": "रामं पुरुस्कृत्य ययुर्वृष्म्यन्धकमहारथाः।\nरत्नान्यादाय शुभ्राणि दत्तानि कुरुसत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2012057, "chapter_id": 1246, "verse_number": "१-२४७-५६", "content_sanskrit": "रामः सुभद्रां संपूज्य परिष्वज्य स्वसां तदा।\nन्यासेति द्रौपदीमुक्त्वा परिधाय महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2012058, "chapter_id": 1246, "verse_number": "१-२४७-५७", "content_sanskrit": "पितृष्वसायाश्चरणावभिवाद्य ययौ तदा।\nतस्मिन्काले पृथा प्रीता पूजयामास तं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2012059, "chapter_id": 1246, "verse_number": "१-२४७-५८", "content_sanskrit": "स वृष्णिवीरः पार्थैश्च पौरैश्च परमार्चितः।\nययौ द्वारवतीं रामो वृष्णिभिः सह संयुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2012060, "chapter_id": 1246, "verse_number": "१-२४७-५९", "content_sanskrit": "वासुदेवस्तु पार्थेन तत्रैव सह भारत।\nचतुस्त्रिंशदहोरात्रं रममाणो महाबलः।\nउवास नगरे रम्ये शक्रप्रस्थे महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2012061, "chapter_id": 1246, "verse_number": "१-२४७-६०", "content_sanskrit": "व्यचरद्यमुनातीरे मृगयां स महायशाः।\nमृगान्विध्यन्वराहांश्च रेमे सार्धं किरीटिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2012062, "chapter_id": 1246, "verse_number": "१-२४७-६१", "content_sanskrit": "ततः सुभद्रा सौभद्रं केशवस्य प्रिया स्वसा।\nजयन्तमिव पौलोमी ख्यातिमन्तमजीजनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2012063, "chapter_id": 1246, "verse_number": "१-२४७-६२", "content_sanskrit": "दीर्घबाहुं महोरस्कं वृषभाक्षमरिन्दमम्।\nसुभद्रा सुषुवे वीरमभिमन्युं नरर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2012064, "chapter_id": 1246, "verse_number": "१-२४७-६३", "content_sanskrit": "अभीश्च मन्युमांश्चैव ततस्तमरिमर्दनम्।\nअभिमन्युरिति प्राहुरार्जुनिं पुरुषर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2012065, "chapter_id": 1246, "verse_number": "१-२४७-६४", "content_sanskrit": "स सात्वत्यामतिरथः संबभूव घनञ्जयात्।\nमखे निर्मथनेनेव शमीगर्भाद्धुताशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2012066, "chapter_id": 1246, "verse_number": "१-२४७-६५", "content_sanskrit": "यस्मिञ्जाते महातेजाः कुन्तीपुत्रो युधिष्ठिरः।\nअयुतं गा द्विजातिभ्यः प्रादान्निष्कांश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2012067, "chapter_id": 1246, "verse_number": "१-२४७-६६", "content_sanskrit": "दयितो वासुदेवस्य वाल्यात्प्रभृति चाभवत्।\nपितॄणां चैव सर्वेषां प्रजानामिव चन्द्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2012068, "chapter_id": 1246, "verse_number": "१-२४७-६७", "content_sanskrit": "जन्मप्रभृति कृष्णश्च चक्रे तस्य क्रियाः शुभाः।\nस चापि ववृधे बालः शुक्लपक्षे यथा शशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2012069, "chapter_id": 1246, "verse_number": "१-२४७-६८", "content_sanskrit": "चतुष्पादं दशविधं धनुर्वेदमरिन्दमः।\nअर्जुनाद्वेद वेदज्ञः सकलं दिव्यमानुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2012070, "chapter_id": 1246, "verse_number": "१-२४७-६९", "content_sanskrit": "विज्ञानेष्वपि चास्त्राणां सौष्ठवे च महाबलः।\nक्रियास्वपि च सर्वासु विशेषानभ्यसिक्षयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2012071, "chapter_id": 1246, "verse_number": "१-२४७-७०", "content_sanskrit": "आगमे च प्रयोगे च चक्रे तुल्यमिवात्मना।\nतुतोष पुत्रं सौभद्रं प्रेक्षणाणो धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2012072, "chapter_id": 1246, "verse_number": "१-२४७-७१", "content_sanskrit": "सर्वसंहननोपेतं सर्वलक्षणलक्षितम्।\nदुर्धर्षमृषभस्कन्धं व्यात्ताननमिवोरगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2012073, "chapter_id": 1246, "verse_number": "१-२४७-७२", "content_sanskrit": "सिंहदर्पं महेष्वासं मत्तमातङ्गविक्रमम्।\nमेघदुन्दुभिनिर्घोषं पूर्णचन्द्रनिभाननम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2012074, "chapter_id": 1246, "verse_number": "१-२४७-७३", "content_sanskrit": "कृष्णस्य सदृशं शौर्ये वीर्ये रूपे तथाऽऽकृतौ।\nददर्श पुत्रं बीभत्सुर्मघवानिव तं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2012075, "chapter_id": 1246, "verse_number": "१-२४७-७४", "content_sanskrit": "पाञ्चाल्यपि तु पञ्चभ्यः पतिभ्यः शुभलक्षणा।\nलेभे पञ्च सुतान्वीराञ्श्रेष्ठान्पञ्चाचलानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2012076, "chapter_id": 1246, "verse_number": "१-२४७-७५", "content_sanskrit": "युधिष्ठिरात्प्रतिविन्ध्यं सुतसोमं वृकोदरात्।\nअर्जुनाच्छ्रुतकर्माणं शतानीकं च नाकुलिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2012077, "chapter_id": 1246, "verse_number": "१-२४७-७६", "content_sanskrit": "सहदेवाच्छ्रुतसेनमेतान्पञ्च महारथान्।\nपाञ्चाली सुषुवे वीरानादित्यानदितिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2012078, "chapter_id": 1246, "verse_number": "१-२४७-७७", "content_sanskrit": "शास्त्रतः प्रतिविन्ध्यन्तमूचुर्विप्रायुधिष्ठिरम्।\nपरप्रहरणज्ञाने प्रतिविन्ध्यो भत्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2012079, "chapter_id": 1246, "verse_number": "१-२४७-७८", "content_sanskrit": "सुतेसोमसहस्रे तु सोमार्कसमतेजसम्।\nसुतसोमं महेष्वासं सुषुवे भीमसेनतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2012080, "chapter_id": 1246, "verse_number": "१-२४७-७९", "content_sanskrit": "श्रुतं कर्म महत्कृत्वा निवृत्तेन किरीटिना।\nजातः पुत्रस्तथेत्येवं श्रुतकर्मा ततोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2012081, "chapter_id": 1246, "verse_number": "१-२४७-८०", "content_sanskrit": "शतानीकस्य राजर्षेः कौरव्यस्य महात्मनः।\nचक्रे पुत्रं सनामानं नकुलः कीर्तिवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2012082, "chapter_id": 1246, "verse_number": "१-२४७-८१", "content_sanskrit": "ततस्त्वजीजनत्कृष्णा नक्षत्रे वह्निदैवते।\nसहदेवात्सुतं तस्माच्छ्रुतसेनेति तं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2012083, "chapter_id": 1246, "verse_number": "१-२४७-८२", "content_sanskrit": "एकवर्षान्तरास्त्वेते द्रौपदेया यशस्विनः।\nअन्वजायन्त राजेन्द्र परस्परहितैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2012084, "chapter_id": 1246, "verse_number": "१-२४७-८३", "content_sanskrit": "जातकर्माण्यानुपूर्व्याच्चूडोपनयनानि च।\nचकार विधिवद्धौम्यस्तेषां भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2012085, "chapter_id": 1246, "verse_number": "१-२४७-८४", "content_sanskrit": "कृत्वा च वेदाध्ययनं ततः सुचरितव्रताः।\nजगृहुः सर्वमिष्वस्त्रमर्जुनाद्दिव्यमानुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2012086, "chapter_id": 1246, "verse_number": "१-२४७-८५", "content_sanskrit": "दिव्यगर्भोपमैः पुत्रैर्व्यूढोरस्कैर्महारथैः।\nअन्विता राजशार्दूल पाण्डवा मुदमाप्नुवन्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2012087, "chapter_id": 1246, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि हरणाहरणपर्वणि सप्तचत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४७ ॥ ॥ समाप्तं च हरणाहरणपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]