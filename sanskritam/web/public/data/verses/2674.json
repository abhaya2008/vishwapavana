[{"id": 2078839, "chapter_id": 2674, "verse_number": "१२-१७९-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078840, "chapter_id": 2674, "verse_number": "१२-१७९-१", "content_sanskrit": "यद्यस्ति दत्तमिष्टं वा तपस्तप्तं तथैव च।\nगुरूणां वाऽपि शुश्रूषा तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078841, "chapter_id": 2674, "verse_number": "१२-१७९-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078842, "chapter_id": 2674, "verse_number": "१२-१७९-२", "content_sanskrit": "`यथाऽस्मिंश्च तथा तत्र जानीयां नृपसत्तम।\nदुष्कर्तारो यथा लोके यत्कुर्वन्ति तथा शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078843, "chapter_id": 2674, "verse_number": "१२-१७९-३", "content_sanskrit": "आत्मनाऽनर्थयुक्तेन पापे निविशते मनः।\nस्वकर्म कलुषं कृत्वा दुःखे महति धीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078844, "chapter_id": 2674, "verse_number": "१२-१७९-४", "content_sanskrit": "दुर्भिक्षादेव दुर्भिक्षं क्लेशात्क्लेशं भयाद्भयम्।\nमृतेभ्यः प्रमृता यान्ति दरिद्राः पापकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078845, "chapter_id": 2674, "verse_number": "१२-१७९-५", "content_sanskrit": "उत्सवादुत्सवं यान्ति स्वर्गात्स्वर्गं सुखात्सुखम्।\nश्रद्दधानाश्च दान्ताश्च सत्वस्थाः शुभकारिणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078846, "chapter_id": 2674, "verse_number": "१२-१७९-६", "content_sanskrit": "व्यालकुञ्जरदुर्गेषु सर्पचोरभयेषु च।\nहस्तावापेन गच्छन्ति नास्तिकाः किमतः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078847, "chapter_id": 2674, "verse_number": "१२-१७९-७", "content_sanskrit": "प्रियदेवातिथेयाश्च वदान्याः प्रियसाधवः।\nक्षेम्यमात्मवतां मार्गमास्थिता हस्तदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078848, "chapter_id": 2674, "verse_number": "१२-१७९-८", "content_sanskrit": "पुलाका इव धान्येषु पुत्तिका इव पक्षिषु।\nतद्विधास्ते मनुष्येषु येषां धर्मो न कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078849, "chapter_id": 2674, "verse_number": "१२-१७९-९", "content_sanskrit": "सुशीघ्रमपि धावन्तं विधानमनुधावति।\nशेते सह शयानेन येनयेन यथाकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078850, "chapter_id": 2674, "verse_number": "१२-१७९-१०", "content_sanskrit": "उपतिष्ठति तिष्ठन्तं गच्छन्तमनुगच्छति।\nकरोति कुर्वतः कर्म छायेवाऽनुविधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078851, "chapter_id": 2674, "verse_number": "१२-१७९-११", "content_sanskrit": "येनयेन यथा यद्यत्पुरा कर्म समार्जितम्।\nतत्तदेव नरो भुङ्क्ते नित्यं विहितमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078852, "chapter_id": 2674, "verse_number": "१२-१७९-१२", "content_sanskrit": "स्वकर्मफलनिक्षेपं विधानपरिरक्षितम्।\nभूतग्राममिमं कालः समन्तात्परिकर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078853, "chapter_id": 2674, "verse_number": "१२-१७९-१३", "content_sanskrit": "अचोद्यमानानि यथा पुष्पाणि च फलानि च।\nस्वं कालं नातिवर्तन्ते तथा कर्म पुराकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078854, "chapter_id": 2674, "verse_number": "१२-१७९-१४", "content_sanskrit": "संमानश्चावमानश्च लाभालाभौ क्षयोदयौ।\nप्रवृत्तानि विवर्तन्ते विद्यानान्ते पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078855, "chapter_id": 2674, "verse_number": "१२-१७९-१५", "content_sanskrit": "आत्मना विहितं दुःखमात्मना विहितं सुखम्।\nगर्भशय्यामुपादाय भुज्यते पौर्वदेहिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078856, "chapter_id": 2674, "verse_number": "१२-१७९-१६", "content_sanskrit": "बालो युवा च वृद्धश्च यत्करोति शुभाशुभम्।\nतस्यांतस्यामवस्थायां भुङ्क्ते जन्मनिजन्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078857, "chapter_id": 2674, "verse_number": "१२-१७९-१७", "content_sanskrit": "यथा धेनुसहस्रेषु वत्सो विन्दति मातरम्।\nतथा पूर्वकृतं कर्म कर्तारमनुगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078858, "chapter_id": 2674, "verse_number": "१२-१७९-१८", "content_sanskrit": "संक्लिन्नमग्रतो वस्त्रं पश्चाच्छुध्यति वारिणा।\n`दुष्कर्मापि तथा पश्चात्पूयते पुण्यकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078859, "chapter_id": 2674, "verse_number": "१२-१७९-१९", "content_sanskrit": "तपसा तप्यते देहस्तपसा विन्दते महत्॥\nउपवासैः प्रतप्तानां दीर्घं सुखमनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078860, "chapter_id": 2674, "verse_number": "१२-१७९-२०", "content_sanskrit": "दीर्घकालेन तपसा सेवितेन तपोवने।\nधर्मनिर्धूतपापानां संसिद्ध्यन्ते मनोरथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078861, "chapter_id": 2674, "verse_number": "१२-१७९-२१", "content_sanskrit": "शकुनीनामिवाकाशे मत्स्यानामिव चोदके।\nपदं यथा न दृश्येत तथा धर्मविदां गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078862, "chapter_id": 2674, "verse_number": "१२-१७९-२२", "content_sanskrit": "अलमन्यैरुपालम्भैः कीर्तितैश्च व्यतिक्रमैः।\nपेशलं चानुरूपं च कर्तव्यं हितमात्मनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078863, "chapter_id": 2674, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकोनाशीत्यधिकशततमोऽध्यायः॥ १७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]