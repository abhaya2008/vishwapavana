[{"id": 2074717, "chapter_id": 2578, "verse_number": "१२-८३-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074718, "chapter_id": 2578, "verse_number": "१२-८३-१", "content_sanskrit": "सभासदः सहायाश्च सुहृदश्च विशांपते।\nपरिच्छदास्तथाऽमात्याः कीदृशाः स्युः पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074719, "chapter_id": 2578, "verse_number": "१२-८३-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074720, "chapter_id": 2578, "verse_number": "१२-८३-२", "content_sanskrit": "ह्रीनिषेवास्तथा दान्ताः सत्यार्जवसमन्विताः।\nशक्ताः कथयितुं सम्यक्ते तव स्युः सभासदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074721, "chapter_id": 2578, "verse_number": "१२-८३-३", "content_sanskrit": "अमात्याश्चातिशूराश्च ब्रह्मण्याश्च बहुश्रुताः।\nसुसंतृष्टाश्च कौन्तेय महोत्साहाश्च कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074722, "chapter_id": 2578, "verse_number": "१२-८३-४", "content_sanskrit": "एतान्सहायाँल्लिप्सेथाः सर्वास्वापत्सु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074723, "chapter_id": 2578, "verse_number": "१२-८३-५", "content_sanskrit": "कुलीनः पूजितो नित्यं न हि शक्तिं निगूहति।\nप्रसन्नमप्रसन्नं वा पीडितं हतमेव वा।\nआवर्तयति भूयिष्ठं तदेव ह्यनुपालितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074724, "chapter_id": 2578, "verse_number": "१२-८३-६", "content_sanskrit": "कुलीना देशजाः प्राज्ञा रूपवन्तो बहुश्रुताः।\nप्रगल्भाश्चानुरक्ताश्च ते तव स्युः परिच्छदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074725, "chapter_id": 2578, "verse_number": "१२-८३-७", "content_sanskrit": "दौष्कुलेयाश्च लुब्धाश्च नृशंसा निरपत्रपाः।\nते त्वां तात निषेवेयुर्यावदार्द्रकपाणयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074726, "chapter_id": 2578, "verse_number": "१२-८३-८", "content_sanskrit": "कुलीनाञ्शीलसंपन्नानिङ्गितज्ञाननिष्ठुरान्।\nदेशकालविधानज्ञान्भर्तृकार्यहितैपिणः।\nनित्यमर्थेषु सर्वेषु राजा कुर्वीत मन्त्रिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074727, "chapter_id": 2578, "verse_number": "१२-८३-९", "content_sanskrit": "अर्थमानार्घसत्कारैर्भोगैरुच्चावचैः प्रियैः।\nयानर्थभाजो मन्येथास्तेते स्युः सुखभागिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074728, "chapter_id": 2578, "verse_number": "१२-८३-१०", "content_sanskrit": "अभिन्नवृत्ता विद्वांसः सद्वॄत्ताश्चरितव्रताः।\nनत्वां नित्यार्थिनो जह्युरक्षुद्राः सत्यवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074729, "chapter_id": 2578, "verse_number": "१२-८३-११", "content_sanskrit": "अनार्या ये न जानन्ति समयं मन्दचेतसः।\nतेभ्यः परिजुगुप्सेथा ये चापि समयच्युताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074730, "chapter_id": 2578, "verse_number": "१२-८३-१२", "content_sanskrit": "नैकमिच्छेद्गणं हित्वा स्याच्चेदन्यतरग्रहः।\nयस्त्वेको बहुभिः श्रेयान्कामं तेन गणं त्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074731, "chapter_id": 2578, "verse_number": "१२-८३-१३", "content_sanskrit": "श्रेयसो लक्षणं चैतद्विक्रमो यस्य दृश्यते।\nकीर्तिप्रधानो यश्च स्यात्समये यश्च तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074732, "chapter_id": 2578, "verse_number": "१२-८३-१४", "content_sanskrit": "समर्थान्पूजयेद्यश्च नास्पर्ध्यैः स्पर्धते च यः।\nन च कामाद्भयात्क्रोधाल्लोभाद्वा धर्ममुत्सृजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074733, "chapter_id": 2578, "verse_number": "१२-८३-१५", "content_sanskrit": "अमानी अत्यवाक्शक्तो जितात्मा मानसंयुतः।\nस ते मन्त्रसहायः स्यात्सर्वावस्थापरीक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074734, "chapter_id": 2578, "verse_number": "१२-८३-१६", "content_sanskrit": "कुलीनः कुलसंपन्नस्तितिक्षुर्दश आत्मवान्।\nशूरः कृतज्ञः सत्यश्च श्रेयसः पार्थ लक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074735, "chapter_id": 2578, "verse_number": "१२-८३-१७", "content_sanskrit": "तस्यैवं वर्तमानस्य पुरुषस्य विजानतः।\nअमित्राः संप्रसीदन्ति तथा मित्रीभवन्त्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074736, "chapter_id": 2578, "verse_number": "१२-८३-१८", "content_sanskrit": "अत ऊर्ध्वममात्यानां परीक्षेत गुणागुणम्।\nसंयतात्मा कृतप्रज्ञो भूतिकामश्च भूमिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074737, "chapter_id": 2578, "verse_number": "१२-८३-१९", "content_sanskrit": "संबन्धिपुरुषैराप्तैरभिजातैः स्वदेशजैः।\nअहार्यैरव्यभीचारैः सर्वशः सुपरीक्षितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074738, "chapter_id": 2578, "verse_number": "१२-८३-२०", "content_sanskrit": "यौनाः श्रौतास्तथा मौलास्तथैवाप्यनहंकृताः।\nकर्तव्या भूतिकामेन पुरुषेण बुभूपता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074739, "chapter_id": 2578, "verse_number": "१२-८३-२१", "content_sanskrit": "एषां वैनयिकी बुद्धिः प्रकृतिश्चैव शोभना।\nतेजो धैर्यं क्षमा शौचमनुरागः स्थितिर्धृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074740, "chapter_id": 2578, "verse_number": "१२-८३-२२", "content_sanskrit": "परीक्ष्य च गुणान्नित्यं प्रौढभावान्धुरंधरान्।\nपञ्चोपधाव्यतीतांश्च कुर्याद्राजाऽर्थकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074741, "chapter_id": 2578, "verse_number": "१२-८३-२३", "content_sanskrit": "पर्याप्तवचनान्वीरान्प्रतिपत्तिविशारदान्।\nकुलीनान्सत्वसंपन्नानिङ्गितज्ञाननिष्ठुरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074742, "chapter_id": 2578, "verse_number": "१२-८३-२४", "content_sanskrit": "देशकालविधानज्ञान्भर्तृकार्यहितैषिणः।\nनित्यमर्थेषु सर्वेषु राजन्कुर्वीत मन्त्रिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074743, "chapter_id": 2578, "verse_number": "१२-८३-२५", "content_sanskrit": "हीनतेजोभिसंसृष्टो नैव जातु व्यवस्यति।\nअवश्यं जनयत्येव सर्वकर्मसु संशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074744, "chapter_id": 2578, "verse_number": "१२-८३-२६", "content_sanskrit": "एवमल्पश्रुतो मन्त्री कल्याणाभिजनोऽप्युत।\nधर्मार्थकामसंयुक्तो नालं मन्त्रं परीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074745, "chapter_id": 2578, "verse_number": "१२-८३-२७", "content_sanskrit": "तथैवानभिजातोऽपि काममस्तु बहुश्रुतः।\nअनायक इवाचक्षुर्मुह्यत्यूह्येषु कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074746, "chapter_id": 2578, "verse_number": "१२-८३-२८", "content_sanskrit": "यो वाऽप्यस्थिरसंकल्पो बुद्धिमानागतागमः। १२-८३-२८bउपायज्ञोऽपि नालं स कर्म प्रापयितुं चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2074747, "chapter_id": 2578, "verse_number": "१२-८३-२९", "content_sanskrit": "केवलात्पुनरादानात्कर्मणो नोपपद्यते।\nपरामर्शो विशेषणामश्रुतस्येह दुर्मतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2074748, "chapter_id": 2578, "verse_number": "१२-८३-३०", "content_sanskrit": "मन्त्रिण्यननुरक्ते तु विश्वासो नोपपद्यते।\nतस्मादननुरक्ताय नैव मन्त्रं प्रकाशयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2074749, "chapter_id": 2578, "verse_number": "१२-८३-३१", "content_sanskrit": "व्यथयेद्धि स राजानं मन्त्रिभिः सहितोऽनृजुः।\nमारुतोपहितच्छिद्रैः प्रविश्याग्निरिव द्रुमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2074750, "chapter_id": 2578, "verse_number": "१२-८३-३२", "content_sanskrit": "संक्रुद्धश्चैकदा स्वामी स्थानाच्चैवापकर्षति।\nवाचा क्षिपति संरब्धः पुनः पश्चात्प्रसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2074751, "chapter_id": 2578, "verse_number": "१२-८३-३३", "content_sanskrit": "तानितान्यनुरक्तेन शक्यानि हि तितिक्षितुम्।\nमन्त्रिणां च भवेत्क्रोधो विस्फूर्जितमिवाशनेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2074752, "chapter_id": 2578, "verse_number": "१२-८३-३४", "content_sanskrit": "यस्तु संहरते तानि भर्तुः प्रियचिकीर्षया।\nसमानसुखदुःखं तं पृच्छेदर्थेषु मानवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2074753, "chapter_id": 2578, "verse_number": "१२-८३-३५", "content_sanskrit": "अनृजुस्त्वनुरक्तोऽपि संपन्नश्चेतरैर्गुणैः।\nराज्ञः प्रज्ञानयुक्तोऽपि न मन्त्रं श्रोतुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2074754, "chapter_id": 2578, "verse_number": "१२-८३-३६", "content_sanskrit": "योऽमित्रैः सह संबद्धो न परान्बहुमन्यते।\nअसुहृत्तादृशो ज्ञेयो न मन्त्रं श्रोतुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2074755, "chapter_id": 2578, "verse_number": "१२-८३-३७", "content_sanskrit": "अविद्वानशुचिः स्तब्धः शत्रुसेवी विकत्थनः।\nअसुहृत्क्रोधनो लुब्धो न मन्त्रं श्रोतुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2074756, "chapter_id": 2578, "verse_number": "१२-८३-३८", "content_sanskrit": "आगन्तुश्चानुरक्तोऽपि काममस्तु बहुश्रुतः।\nसत्कृतः संविभक्तो वा न मन्त्रं श्रोतुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2074757, "chapter_id": 2578, "verse_number": "१२-८३-३९", "content_sanskrit": "विधर्मतो विप्रकृतः पिता यस्याभवत्पुरा।\nसत्कृतः स्थापितः सोऽपि न मन्त्रं श्रोतुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2074758, "chapter_id": 2578, "verse_number": "१२-८३-४०", "content_sanskrit": "यः स्वल्पेनापि कार्येण सुहृदाक्षारितो भवेत्।\nपुनरन्यैर्गुणैर्युक्तो न मन्त्रं श्रोतुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2074759, "chapter_id": 2578, "verse_number": "१२-८३-४१", "content_sanskrit": "कृतप्रज्ञश्च मेधावी बुधो जानपदः शुचिः।\nसर्वकर्मसु यः शुद्धः स मन्त्रं श्रोतुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2074760, "chapter_id": 2578, "verse_number": "१२-८३-४२", "content_sanskrit": "ज्ञानविज्ञानसंपन्नः प्रकृतिज्ञः परात्मनोः।\nसुहृदात्मसमो राज्ञः स मन्त्रं श्रोतुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2074761, "chapter_id": 2578, "verse_number": "१२-८३-४३", "content_sanskrit": "सत्यवाक्शीलसंपन्नो गन्भीरः सत्रपो मृदुः।\nपितृपैतामहो यः स्यात्स मन्त्रं श्रोतुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2074762, "chapter_id": 2578, "verse_number": "१२-८३-४४", "content_sanskrit": "संतुष्टः संमतः सद्भिः शौटीरो द्वेष्यपापकः।\nमन्त्रवित्कालविच्छूरः स मन्त्रं श्रोतुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2074763, "chapter_id": 2578, "verse_number": "१२-८३-४५", "content_sanskrit": "सर्वलोकमिमं शक्तः सान्त्वेन कुरुते वशम्।\nतस्मै मन्त्रः प्रयोक्तव्यो दण्डमाधित्सता नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2074764, "chapter_id": 2578, "verse_number": "१२-८३-४६", "content_sanskrit": "पौरजानपदा यस्मिन्विश्वासं धर्मतो गताः।\nयोद्धा नयविपश्चिच्च स मन्त्रं श्रोतुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2074765, "chapter_id": 2578, "verse_number": "१२-८३-४७", "content_sanskrit": "तस्मात्सर्वैर्गुणैरेतैरुपपन्नाः सुपूजिताः।\nमन्त्रिणः प्रकृतिज्ञाः स्युख्यवरा महदीप्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2074766, "chapter_id": 2578, "verse_number": "१२-८३-४८", "content_sanskrit": "स्वासु प्रकृतिषु च्छिद्रं लक्षयेरन्परस्य च।\nमन्त्रिणां मन्त्रमूलं हि राज्ञो राष्ट्रं विवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2074767, "chapter_id": 2578, "verse_number": "१२-८३-४९", "content_sanskrit": "नास्य च्छिद्रं परः पश्येच्छिद्रेषु परमन्वियात्।\nगूहेत्कूर्म इवाङगानि रक्षेद्विवरमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2074768, "chapter_id": 2578, "verse_number": "१२-८३-५०", "content_sanskrit": "मन्त्रग्राहा हि राजस्य मन्त्रिणो ये मनीषिणः।\nमन्त्रसंहननो राजा मन्त्राङ्गानीतरे जन्गः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2074769, "chapter_id": 2578, "verse_number": "१२-८३-५१", "content_sanskrit": "राज्यं प्रणिधिमूलं हि मन्त्रसारं प्रचक्षते।\nस्वामिनं त्वनुवर्न्तते वृत्त्यर्थमिह मन्त्रिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2074770, "chapter_id": 2578, "verse_number": "१२-८३-५२", "content_sanskrit": "संविनीयमदक्रोधौ मानमीर्ष्यां च निर्वृताः।\nनित्यं पञ्चोपधातीतैर्मन्त्रयेत्सह मन्त्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2074771, "chapter_id": 2578, "verse_number": "१२-८३-५३", "content_sanskrit": "तेषां त्रयाणां त्रिविधं विमर्शं\nविबुध्य चित्तं विनिवेश्य तत्र।\nस्वनिश्चयं तं परनिश्चयं च\nनिदर्शयेदुत्तरमन्त्रकाले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2074772, "chapter_id": 2578, "verse_number": "१२-८३-५४", "content_sanskrit": "धर्मार्थकामज्ञमुपेत्य पृच्छे\nद्युक्तो गुरुं ब्राह्मणमुत्तरार्थम्।\nनिष्ठा कृता तेन यदा सहः स्या\nत्तं मन्त्रमार्गं प्रणयेदसक्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2074773, "chapter_id": 2578, "verse_number": "१२-८३-५५", "content_sanskrit": "एवं सदा मन्त्रयितत्र्यमाहु\nर्ये मन्त्रतत्त्वार्थविनिश्चयज्ञाः।\nतस्मात्तमेवं प्रणयेत्सदैव\nमन्त्रं प्रजासंग्रहणे समर्थम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2074774, "chapter_id": 2578, "verse_number": "१२-८३-५६", "content_sanskrit": "न वामनाः कुब्जकृशा न खञ्जा\nनान्धा जडाः स्त्री च नपुंसकाश्च।\nन चात्र तिर्यक्च पुरो न पश्चा\nन्नोर्ध्वं न चाधः प्रपरेत्कथंचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2074775, "chapter_id": 2578, "verse_number": "१२-८३-५७", "content_sanskrit": "आरुह्य वा वेश्म तथैव शून्यं\nस्थलं प्रकाशं कुशकाशहीनम्।\nवागङ्गदोषान्परिहृत्य सर्वा\nन्संमन्त्रयेत्कार्यमहीनकालम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2074776, "chapter_id": 2578, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि त्र्यशीतितमोऽध्यायः॥ ८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]