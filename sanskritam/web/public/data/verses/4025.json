[{"id": 2140164, "chapter_id": 4025, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2140165, "chapter_id": 4025, "verse_number": "१", "content_sanskrit": "निर्ययुर्नगराच्छूरा व्यूढानीकाः प्रहारिणः ।\nत्रिगर्तानस्पृशन् मत्स्याः सूर्ये परिणते सति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2140166, "chapter_id": 4025, "verse_number": "२", "content_sanskrit": "ते त्रिगर्ताश्च मत्स्याश्च व्यूढानीकाः प्रहारिणः ।\nअन्योन्यमभिवर्तन्ते गोषु गृध्रा महाबलाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2140167, "chapter_id": 4025, "verse_number": "३", "content_sanskrit": "भीमाश्च मत्तमातङ्गाः तोमराङ्कुशचोदिताः ।\nग्रामणीयैः समारूढाः कुशलैर्हस्तिसादिभिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2140168, "chapter_id": 4025, "verse_number": "४", "content_sanskrit": "तेषां समागमो घोरस्तुमुलो रोमहर्षणः ।\nदेवासुरसमो राजन्नासीत् सूर्येऽवलम्बति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2140169, "chapter_id": 4025, "verse_number": "५", "content_sanskrit": "उदतिष्ठद् रजो भौमं न प्राज्ञायत किञ्चन ।\nपक्षिणश्चापतन् भूमौ सैन्येन रजसा वृताः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2140170, "chapter_id": 4025, "verse_number": "६", "content_sanskrit": "इषुभिर्व्यतिसंयद्भिरादित्योऽन्तरधीयत ।\nखद्योतैरिव सम्पृक्तमन्तरिक्षं व्यराजत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2140171, "chapter_id": 4025, "verse_number": "७", "content_sanskrit": "रुग्मपृष्ठानि चापानि विचेरुर्विद्युतो यथा ।\nनर्दतां लोकवीराणां सव्यं दक्षिणमस्यताम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2140172, "chapter_id": 4025, "verse_number": "८", "content_sanskrit": "रथा रथैः समाजग्मुः पत्तयश्च पदातिभिः ।\nसादिभिः सादिनो जग्मुर्गजैश्चापि महागजाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2140173, "chapter_id": 4025, "verse_number": "९", "content_sanskrit": "असिभिः पट्टसैश्चापि शक्तिभिस्तोमरैरपि ।\nसंरब्धाः समरे योधा निजघ्नुरितरेतरम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2140174, "chapter_id": 4025, "verse_number": "१०", "content_sanskrit": "निघ्नन्तः समरेऽन्योन्यं हृष्टाः परिघबाहवः ।\nन शेकुरतिसंरब्धाः शूराः कर्तुं पराङ्मुखम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2140175, "chapter_id": 4025, "verse_number": "११", "content_sanskrit": "रक्ताधरोष्ठं सुनसं रक्तश्मश्रु स्वलङ्कृतम् ।\nअदृश्यत शिरश्छिन्नं रजोध्वस्तं सकुण्डलम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2140176, "chapter_id": 4025, "verse_number": "१२", "content_sanskrit": "दृश्यन्ते तत्र गात्राणि वीरैश्छिन्नानि भागशः ।\nसालस्कन्धनिकाशानि क्षत्रियाणां महामृधे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2140177, "chapter_id": 4025, "verse_number": "१३", "content_sanskrit": "नागभोगनिकाशैश्च बाहुभिश्चन्दनोक्षितैः ।\nआकीर्णा वसुधा तत्र शिरोभिश्च सकुण्डलैः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2140178, "chapter_id": 4025, "verse_number": "१४", "content_sanskrit": "यथा वा वाससी श्लक्ष्णे महारजनरञ्जिते ।\nबिभ्रती युवती श्यामा भाति तद्वद् वसुन्धरा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2140179, "chapter_id": 4025, "verse_number": "१५", "content_sanskrit": "उपशाम्य रजो भौमं रुधिरेण प्रवर्षता ।\nकश्मलं प्राविशद् घोरं निर्मर्यादमवर्तत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2140180, "chapter_id": 4025, "verse_number": "१६", "content_sanskrit": "युधिष्ठिरोऽपि धर्मात्मा भ्रातृभिः सहितस्तदा ।\nव्यूहं कृत्वा विराटस्य अन्वयुध्यत पाण्डवः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2140181, "chapter_id": 4025, "verse_number": "१७", "content_sanskrit": "आत्मानं श्येनवत् कृत्वा तुण्डमासीद् युधिष्ठिरः ।\nपक्षौ यमौ च भवतः पृच्छमासीद् वृकोदरः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2140182, "chapter_id": 4025, "verse_number": "१८", "content_sanskrit": "सहस्रं न्यहनत् तत्र कुन्तीपुत्रो युधिष्ठिरः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2140183, "chapter_id": 4025, "verse_number": "१९", "content_sanskrit": "भीमसेनः सुसङ्क्रुद्धः सर्वशस्त्रभृतां वरः ।\nद्विसहस्रं रथान् वीरः परलोकं प्रवेशयत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2140184, "chapter_id": 4025, "verse_number": "२०", "content_sanskrit": "नकुलस्त्रिशतं जघ्ने सहदेवश्चतुःशतम् ।\nशतानीकः शतं हत्वा मदिराश्वश्चतुःशतम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2140185, "chapter_id": 4025, "verse_number": "२१", "content_sanskrit": "प्रहृष्टां महतीं सेनां त्रिगर्तानां महारथौ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2140186, "chapter_id": 4025, "verse_number": "२२", "content_sanskrit": "आर्च्छतां बहुसाहस्रं केशाकेशि रथारथि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2140187, "chapter_id": 4025, "verse_number": "२३", "content_sanskrit": "लक्षयित्वा त्रिगर्तानां तौ प्रविष्टौ महाचमूः ।\nजग्मतुः सूर्यदत्तश्च मदिराश्वश्च पृष्ठतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2140188, "chapter_id": 4025, "verse_number": "२४", "content_sanskrit": "शङ्खो विराटपुत्रस्तु महेष्वासो महाबलः ।\nविनिघ्नन् समरे शत्रून् प्रविवेश महाचमूम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2140189, "chapter_id": 4025, "verse_number": "२५", "content_sanskrit": "विराटस्तत्र सङ्ग्रामे हत्वा पञ्चशतं रथान् ।\nकुञ्जराणां शतं चैव सहस्रं वाजिनामपि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2140190, "chapter_id": 4025, "verse_number": "२६", "content_sanskrit": "चरन् स विविधान् मार्गान् रथेन रथयूथपः ।\nत्रिगर्तानां सुशर्माणमार्च्छद् रुग्मरथं रणे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2140191, "chapter_id": 4025, "verse_number": "२७", "content_sanskrit": "तौ तु प्राहरतां तत्र महेष्वासौ महाबलौ ।\nअन्योन्यमभिनिघ्नन्तौ गोष्ठे गोवृषभाविव\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2140192, "chapter_id": 4025, "verse_number": "२८", "content_sanskrit": "राजसिंहौ सुसंरब्धौ दन्ताभ्यामिव कुञ्जरौ ।\nकृतास्त्रौ निशितैर्बाणैर्वारयामासतू रणे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2140193, "chapter_id": 4025, "verse_number": "२९", "content_sanskrit": "मात्स्यो राजा सुशर्माणं विव्याध निशितैः शरैः ।\nपञ्चभिः पञ्चभिर्बाणैर्विव्याध चतुरो हयान्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2140194, "chapter_id": 4025, "verse_number": "३०", "content_sanskrit": "द्वाभ्यां सूतं च विव्याध केतुं च त्रिभिराशुगैः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2140195, "chapter_id": 4025, "verse_number": "३१", "content_sanskrit": "तथैव मत्स्यराजं तु सुशर्मा युद्धदुर्मदः ।\nपञ्चाशद्भिः शितैर्बाणैर्विव्याध परमास्त्रवित्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2140196, "chapter_id": 4025, "verse_number": "३२", "content_sanskrit": "तयोर्बलानि राजेन्द्र समस्तानि महारणे ।\nनाजानन्त तदाऽन्योन्यं प्रदोषे रजसा वृते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2140197, "chapter_id": 4025, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि त्रयस्त्रिंशोऽध्यायः ॥३३॥\nगोग्रहणपर्वणि षष्ठोऽध्यायः ॥६॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]