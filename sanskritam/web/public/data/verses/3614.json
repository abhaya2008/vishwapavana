[{"id": 2121881, "chapter_id": 3614, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2121882, "chapter_id": 3614, "verse_number": "१", "content_sanskrit": "सूदिता मौरवाः पाशा निसुम्भनरकौ हतौ ।\nकृतक्षेमः पुनः पन्थाः पुरं प्राग्योतिषं प्रति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2121883, "chapter_id": 3614, "verse_number": "२", "content_sanskrit": "शौरिणा पृथिवीपालाः त्रासिता भरतर्षभ ।\nधनुषञ्च प्रणादेन पाञ्चजन्यस्वनेन च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2121884, "chapter_id": 3614, "verse_number": "३", "content_sanskrit": "मेघप्रख्यैरनीकैश्च दाक्षिणात्याभिसंवृतम् ।\nरुग्मिणं त्रासयामास केशवो भरतर्षभ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2121885, "chapter_id": 3614, "verse_number": "४", "content_sanskrit": "ततः पर्जन्यघोषेण रथेनादित्यवर्चसा ।\nउवाह महिषीं भोज्याम् एष चक्रगदाधरः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2121886, "chapter_id": 3614, "verse_number": "५", "content_sanskrit": "आरथ्यामाहतक्रोधः शिशुपालश्च निर्जितः ।\nवक्रश्च सह शैब्येन शतधन्वा च क्षत्रियः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2121887, "chapter_id": 3614, "verse_number": "६", "content_sanskrit": "इन्द्रद्युम्नो हतः कोपाद् यवनश्च कशेरुमान् ।\nहतः सौभपतिश्चैष साल्वश्च कृतधन्विना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2121888, "chapter_id": 3614, "verse_number": "७", "content_sanskrit": "पर्वतानां सहस्रं च चक्रेण पुरुषोत्तमः ।\nविभज्य पुण्डरीकाक्षो द्युमत्सेनमयोधयत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2121889, "chapter_id": 3614, "verse_number": "८", "content_sanskrit": "महेन्द्रशिखरे चैव निमेषान्तरचारिणौ ।\nजग्राह भरतश्रेष्ठ रावणस्याभितश्चरौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2121890, "chapter_id": 3614, "verse_number": "९", "content_sanskrit": "इरावत्यामुभौ वीरावग्निसूर्यसमौ बले ।\nगोपतिस्ताळकेतुश्च निहतौ शार्ङ्गधन्वना ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2121891, "chapter_id": 3614, "verse_number": "१०", "content_sanskrit": "अक्षप्रपतने चैव नेमिहंसपदेषु च ।\nउभौ तावपि कृष्णेन स्वराष्ट्रे विनिपातितौ ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2121892, "chapter_id": 3614, "verse_number": "११", "content_sanskrit": "दग्धा वाराणसी तात केशवेन महात्मना ।\nसानुबन्धः सराष्ट्रश्च काशीनामृषभो हतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2121893, "chapter_id": 3614, "verse_number": "१२", "content_sanskrit": "प्राग्ज्योतिषपुरं श्रेष्ठमसुरैर्बहुभिर्वृतम् ।\nप्राप्य लोहितकूटानि कृष्णेन वरुणो जितः ।\nअजेयो दुष्प्रधर्षश्च लोकपालो महाद्युतिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2121894, "chapter_id": 3614, "verse_number": "१३", "content_sanskrit": "इन्द्रद्वीपो महेन्द्रेण गुप्तो मघवता स्वयम् ।\nपारिजातो हृतः पार्थ केशवेन महात्मना ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2121895, "chapter_id": 3614, "verse_number": "१४", "content_sanskrit": "पाण्ड्यं पौण्ड्रं च मात्स्यं च कळिङ्गं च जनार्दनः ।\nजघान सहितान् सर्वानङ्गराजं च माधवः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2121896, "chapter_id": 3614, "verse_number": "१५", "content_sanskrit": "एष चैकशतं हत्वा रथेन क्षत्रपुङ्गवान् ।\nगान्धारीमवहत् कृष्णो महिषीं यादवर्षभः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2121897, "chapter_id": 3614, "verse_number": "१६", "content_sanskrit": "एष गाण्डीवधन्वानं क्रीडार्थं मधुसूदनः ।\nजिगाय भरतश्रेष्ठ कुन्त्याश्च प्रमुखे विभुः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2121898, "chapter_id": 3614, "verse_number": "१७", "content_sanskrit": "द्रोणं द्रौणिं कृपं कर्णं भीमसेनं सुयोधनम् ।\nवक्रानुयाने सहितान् जिगाय भरतर्षभ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2121899, "chapter_id": 3614, "verse_number": "१८", "content_sanskrit": "बभ्रोश्च प्रियमन्विच्छन्नेष चक्रगदाधरः ।\nवेणुदारिवृतां भार्यां प्रममाथ युधिष्ठिर ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2121900, "chapter_id": 3614, "verse_number": "१९", "content_sanskrit": "पर्याप्तां पृथिवीं सर्वां साश्वां सरथकुञ्जराम् ।\nवेणुदारिवशे युक्तां जिगाय मधुसूदनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2121901, "chapter_id": 3614, "verse_number": "२०", "content_sanskrit": "अवाप्य तपसा वीर्यं बलमोजश्च भारत ।\nत्रासिताः सगणाः सर्वे बाणेन विबुधाधिपाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2121902, "chapter_id": 3614, "verse_number": "२१", "content_sanskrit": "वज्राशनिगदापाशैः त्रासयद्भिरनेकशः ।\nतस्य नासीद् रणे मृत्युर्देवैरपि सवासवैः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2121903, "chapter_id": 3614, "verse_number": "२२", "content_sanskrit": "सोऽभिभूतश्च कृष्णेन निहतश्च महात्मना ।\nछित्त्वा बाहुसहस्रं तद् गोविन्देन महात्मना ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2121904, "chapter_id": 3614, "verse_number": "२३", "content_sanskrit": "एष क्रीडन् महाबाहुः कंसं च मधुसूदनः ।\nपैठकं चातिलोमानं निजघान जनार्दनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2121905, "chapter_id": 3614, "verse_number": "२४", "content_sanskrit": "जम्भमैरावतं चैव विरूपं च महायशाः ।\nजघान भरतश्रेष्ठ शम्बरं चारिमर्दनम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2121906, "chapter_id": 3614, "verse_number": "२५", "content_sanskrit": "एष भोगवतीं गत्वा वासुकिं भरतर्षभ ।\nनिर्जित्य पुण्डरीकाक्षो रौहिणेयममोचयत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2121907, "chapter_id": 3614, "verse_number": "२६", "content_sanskrit": "एवं बहूनि कर्माणि शिशुरेव जनार्दनः ।\nकृतवान् पुण्डरीकाक्षः सर्ङ्कषणसहायवान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2121908, "chapter_id": 3614, "verse_number": "२७", "content_sanskrit": "एवमेषोऽसुराणां च सुराणामपि सर्वशः ।\nभयाभयकरः कृष्णः सर्वलोकेश्वरः प्रभुः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2121909, "chapter_id": 3614, "verse_number": "२८", "content_sanskrit": "एवमेव महाबाहुः शास्ता सर्वदुरात्मनाम् ।\nकृत्वा देवार्थममितं स्वस्थानं प्रतिपत्स्यते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2121910, "chapter_id": 3614, "verse_number": "२९", "content_sanskrit": "एष भोगवतीं पुण्यां ऋषीकान्तां महायशाः ।\nद्वारकामात्मसात् कृत्वा सागरं गमयिष्यति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2121911, "chapter_id": 3614, "verse_number": "३०", "content_sanskrit": "बहुरम्यवतीं पुण्यां चैत्ययूपवतीं शुभाम् ।\nद्वारकां वरुणावासं प्रवेक्ष्यति सकाननाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2121912, "chapter_id": 3614, "verse_number": "३१", "content_sanskrit": "तां सूर्यसदनप्रख्यां मनोज्ञां शार्ङ्गधन्वना ।\nविसृष्टां वासुदेवेन सागरः प्लावयिष्यति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2121913, "chapter_id": 3614, "verse_number": "३२", "content_sanskrit": "सुरासुरमनुष्येषु नाभून्न भविता क्वचित् ।\nयस्तामध्यवसद् राजा अन्यत्र मधुसूदनात् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2121914, "chapter_id": 3614, "verse_number": "३३", "content_sanskrit": "भ्राजमानास्तु बहवो वृष्ण्यन्धकमहारथाः ।\nतज्जुष्टं प्रतिपत्स्यन्ते नाकपृष्ठं गतासवः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2121915, "chapter_id": 3614, "verse_number": "३४", "content_sanskrit": "एवमेष दशार्हाणां विधाय विधिना विधिम् ।\nविष्णुर्नारायणः सोमः सूर्यश्च सविता स्वयम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2121916, "chapter_id": 3614, "verse_number": "३५", "content_sanskrit": "अप्रमेयोऽनियोज्यश्च तत्र कामगमो वशी ।\nमोदते भगवान् भूतैर्बालः क्रीडनकैरिव ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2121917, "chapter_id": 3614, "verse_number": "३६", "content_sanskrit": "नैष गर्भत्वमापेदे न योन्यामावसत् प्रभुः ।\nआत्मनस्तेजसा कृष्णः सर्वेषां कुरुते गतिम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2121918, "chapter_id": 3614, "verse_number": "३७", "content_sanskrit": "यथा बुद्वुद उत्थाय तत्रैव प्रविलीयते ।\nचराचराणि भूतानि तथा नारायणे सदा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2121919, "chapter_id": 3614, "verse_number": "३८", "content_sanskrit": "न प्रमातुं महाबाहुः शक्यो भारत केशवः ।\nपरो हि परमस्तस्माद् विश्वरूपान्न विद्यते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2121920, "chapter_id": 3614, "verse_number": "२५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि षट्पञ्चाशोऽध्यायः ॥५६॥\n॥ अर्घाभिहरणपर्वणि पञ्चविंशोऽध्यायः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2121921, "chapter_id": 3614, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]