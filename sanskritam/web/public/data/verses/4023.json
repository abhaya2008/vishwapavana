[{"id": 2140021, "chapter_id": 4023, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2140022, "chapter_id": 4023, "verse_number": "१", "content_sanskrit": "ततः शारद्वतो वाक्यमित्युवाच कृपस्तदा ।\nयुक्तं प्राप्तं च वृद्धेन पाण्डवान् प्रति भाषितम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2140023, "chapter_id": 4023, "verse_number": "२", "content_sanskrit": "धर्मार्थसहितं श्लक्ष्णं सर्वं तथ्यं सहेतुकम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2140024, "chapter_id": 4023, "verse_number": "३", "content_sanskrit": "तत्रानुरूपं भीष्मस्य ममापि वचनं शृणु\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2140025, "chapter_id": 4023, "verse_number": "४", "content_sanskrit": "तेषां चैव गतिस्तत्र निवासश्चानुचिन्त्यताम् ।\nनीतिर्विधीयतां चात्र साम्प्रतं या हिता भवेत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2140026, "chapter_id": 4023, "verse_number": "५", "content_sanskrit": "नावज्ञेयो रिपुस्तात प्राकृतोऽपि बुभूषता ।\nकिं पुनः पाण्डवाः शूरा विद्वांसो बलिनस्तथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2140027, "chapter_id": 4023, "verse_number": "६", "content_sanskrit": "तस्मात् सत्रं प्रविष्टेषु पाण्डवेषु महात्मसु ।\nगूढभावेषु छन्नेषु काले चोदयमागते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2140028, "chapter_id": 4023, "verse_number": "७", "content_sanskrit": "स्वराष्ट्रपरराष्ट्रेषु ज्ञातव्यं बलमात्मनः ।\nउदयः पाण्डवानां च प्राप्तकालो न संशयः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2140029, "chapter_id": 4023, "verse_number": "८", "content_sanskrit": "निवासं पाण्डुपुत्राणां दर्शने मृगयामहे ।\nनिवृत्तसमयाः पार्था महात्मानो महाबलाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2140030, "chapter_id": 4023, "verse_number": "९", "content_sanskrit": "महोत्साहा भविष्यन्ति नित्यं धर्मपरायणाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2140031, "chapter_id": 4023, "verse_number": "१०", "content_sanskrit": "तस्माद् बलं च कोशं च नीतिश्चात्र विधीयताम् ।\nयथा कालोदये प्राप्ते सम्यक् सन्दध्महे परैः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2140032, "chapter_id": 4023, "verse_number": "११", "content_sanskrit": "त्वं वै तन्मनसा श्रेयो बुध्यस्यहितमात्मनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2140033, "chapter_id": 4023, "verse_number": "१२", "content_sanskrit": "निश्चयः सर्वमित्रेषु बलवत्स्वबलेषु च ।\nसारं वल्गुफलं ज्ञात्वा मध्यस्थं चापि भारत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2140034, "chapter_id": 4023, "verse_number": "१३", "content_sanskrit": "स्वराष्ट्रपरराष्ट्रेषु ज्ञातव्यं बलमात्मनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2140035, "chapter_id": 4023, "verse_number": "१४", "content_sanskrit": "प्रहृष्टमप्रहृष्टं वा तथा सन्दध्महे परैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2140036, "chapter_id": 4023, "verse_number": "१५", "content_sanskrit": "साम्ना दानेन भेदेन दण्डेन बलिकर्मणा ।\nयथाकालं मनुष्येन्द्र चिरं सुखमवाप्स्यसि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2140037, "chapter_id": 4023, "verse_number": "१६", "content_sanskrit": "न्यायेनानन्यबलिनो बलाच्चानन्यदुर्हृदः ।\nसान्त्वयित्वा च मित्राणि बलं चाभाष्यतां सुखम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2140038, "chapter_id": 4023, "verse_number": "१७", "content_sanskrit": "स्वकोशबलसंवृद्धः सर्वां सिद्धिमवाप्स्यसि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2140039, "chapter_id": 4023, "verse_number": "१८", "content_sanskrit": "योत्स्यसे चापि बलिभिररिभिः प्रत्युपस्थितैः ।\nअन्यैर्वा पाण्डवैर्वाऽपि हीनस्वबलवाहनैः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2140040, "chapter_id": 4023, "verse_number": "१९", "content_sanskrit": "एवं सर्वं विनिश्चित्य व्यवहर्तासि न्यायतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2140041, "chapter_id": 4023, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2140042, "chapter_id": 4023, "verse_number": "२०", "content_sanskrit": "ततो दुर्योधनो वाक्यं श्रुत्वा तेषां महात्मनाम् ।\nमुहूर्तमिव सञ्चिन्त्य सचिवानिदमब्रवीत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2140043, "chapter_id": 4023, "verse_number": "२१", "content_sanskrit": "श्रुतं ह्येतन्मया पूर्वं कथासु जनसंसदि ।\nवीराणां शास्त्रविदुषां कृतिनां तत्वनिर्णये\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2140044, "chapter_id": 4023, "verse_number": "२२", "content_sanskrit": "कृतिनां सारफल्गुत्वं जानामि नयचक्षुषा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2140045, "chapter_id": 4023, "verse_number": "२३", "content_sanskrit": "सत्वे बाहुबले धैर्ये प्राणे शारीरसम्भवे ।\nसाम्प्रतं मानुषे लोके सदैत्यनरराक्षसे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2140046, "chapter_id": 4023, "verse_number": "२४", "content_sanskrit": "चत्वारः प्राणिनां श्रेष्ठाः सम्पूर्णबलपौरुषाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2140047, "chapter_id": 4023, "verse_number": "२५", "content_sanskrit": "भीमश्च बलभद्रश्च मद्रराजश्च वीर्यवान् ।\nचतुर्थः कीचकस्तेषां पञ्चमं नानुशुश्रुमः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2140048, "chapter_id": 4023, "verse_number": "२६", "content_sanskrit": "अन्योन्यानन्तरबलाः क्रमादेव प्रकीर्तिताः ।\nबाहुयुद्धमभीप्सन्ते नित्यं संरब्धमानसाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2140049, "chapter_id": 4023, "verse_number": "२७", "content_sanskrit": "तेनाहमवगच्छामि प्रत्ययेन वृकोदरम् ।\nमनस्यभिनिविष्टं मे व्यक्तं जीवन्ति पाण्डवाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2140050, "chapter_id": 4023, "verse_number": "२८", "content_sanskrit": "तत्राहं कीचकं मन्ये भीमसेनेन मारितम् ।\nसैरन्ध्रीं द्रौपदीं मन्ये नात्र कार्या विचारणा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2140051, "chapter_id": 4023, "verse_number": "२९", "content_sanskrit": "श्रुतः कृष्णानिमित्तेन भीमसेनेन कीचकः ।\nगन्धर्वव्यपदेशेन हतो निशि महाबलः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2140052, "chapter_id": 4023, "verse_number": "३०", "content_sanskrit": "को हि शक्तः परो भीमात् कीचकं हन्तुमोजसा ।\nशस्त्रं विना बाहुवीर्यात् तथा सर्वाङ्गचूर्णने\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2140053, "chapter_id": 4023, "verse_number": "३१", "content_sanskrit": "मर्दितुं वा तथा शीघ्रं चर्ममांसास्थिचूर्णितम् ।\nरूपमन्यत् समास्थाय भीमस्यैतद् विचेष्टितम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2140054, "chapter_id": 4023, "verse_number": "३२", "content_sanskrit": "ध्रुवं कृष्णानिमित्तं तु भीमसेनेन सूतजाः ।\nगन्धर्वव्यपदेशेन हता निशि न संशयः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2140055, "chapter_id": 4023, "verse_number": "३३", "content_sanskrit": "पितामहेन ये चोक्ता देशस्य च जनस्य च ।\nगुणास्ते मत्स्यराष्ट्रस्य बहुशोऽपि मया श्रुताः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2140056, "chapter_id": 4023, "verse_number": "३४", "content_sanskrit": "विराटनगरे मन्ये पाण्डवाश्छन्नचारिणः ।\nनिवसन्ति पुरे रम्ये तत्र यात्रा विधीयताम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2140057, "chapter_id": 4023, "verse_number": "३५", "content_sanskrit": "मत्स्यराष्ट्रं हनिष्यामो ग्रहीष्यामश्च गोधनम् ।\nगृहीते गोधने नूनं तेऽपि योत्स्यन्ति पाण्डवाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2140058, "chapter_id": 4023, "verse_number": "३६", "content_sanskrit": "अपूर्णे समये चापि यदि पश्येम पाण्डवान् ।\nद्वादशान्यानि वर्षाणि प्रवेक्ष्यन्ति पुनर्वनम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2140059, "chapter_id": 4023, "verse_number": "३७", "content_sanskrit": "तस्मादनन्तरेणापि लाभोऽस्माकं भविष्यति ।\nकोशवृद्धिरिहास्माकं शत्रूणां निधनं भवेत्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2140060, "chapter_id": 4023, "verse_number": "३८", "content_sanskrit": "कथं सुयोधनं गच्छेद् युधिष्ठिरभृतः पुरा ।\nएतच्चापि वदत्येष मात्स्यः परिभवान्मयि\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2140061, "chapter_id": 4023, "verse_number": "३९", "content_sanskrit": "तस्मात् कर्तव्यमेतद् वै तत्र यात्रा विधीयताम् ।\nएतत् सुनीतं मन्येऽहं सर्वेषां यदि रोचते\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2140062, "chapter_id": 4023, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2140063, "chapter_id": 4023, "verse_number": "४०", "content_sanskrit": "ततो राजा त्रिगर्तानां सुशर्मा रथयूथपः ।\nपूर्वमाभाष्य कर्णेन तथा दुःशासनेन च\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2140064, "chapter_id": 4023, "verse_number": "४१", "content_sanskrit": "प्राप्तकालमिदं वाक्यमुवाच त्वरितो बली\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2140065, "chapter_id": 4023, "verse_number": "४२", "content_sanskrit": "असकृन्निकृतः पूर्वं मात्स्यसाल्वेयकेकयैः ।\nसूतेन च विराटस्य कीचकेन पुनः पुनः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2140066, "chapter_id": 4023, "verse_number": "४३", "content_sanskrit": "बाधितो बन्धुभिः सार्धं बलाद् बलवता विभो ।\nराष्ट्रं ममासकृद् राजन् राज्ञा मात्स्येन बाधितम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2140067, "chapter_id": 4023, "verse_number": "४४", "content_sanskrit": "प्रणेता कीचकस्तस्य बलमत्तोऽभवत् पुरा ।\nअमर्षी दुर्जयो जेता प्रख्यातबलपौरुषः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2140068, "chapter_id": 4023, "verse_number": "४५", "content_sanskrit": "स हतस्तत्र गन्धर्वैः पापकर्मा नृशंसकृत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2140069, "chapter_id": 4023, "verse_number": "४६", "content_sanskrit": "तस्मिन् विनिहते राजन् हीनदर्पो निराश्रयः ।\nभविष्यति निरुत्साहो विराट इति मे मतिः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2140070, "chapter_id": 4023, "verse_number": "४७", "content_sanskrit": "तत्र यात्रा मम मता निहते कीचकेऽनघ ।\nकौरवाणां च सर्वेषां कर्णस्य च महात्मनः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2140071, "chapter_id": 4023, "verse_number": "४८", "content_sanskrit": "एतत् कार्यमहं मन्ये परमात्ययिकं महत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2140072, "chapter_id": 4023, "verse_number": "४९", "content_sanskrit": "राष्ट्रं तस्याभियात्वा तु धनधान्यसमाकुलम् ।\nआददामो हि रत्नानि विविधानि वसूनि च\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2140073, "chapter_id": 4023, "verse_number": "५०", "content_sanskrit": "ग्रामान् राष्ट्राणि वा तस्य हरिष्यामो विभागशः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2140074, "chapter_id": 4023, "verse_number": "५१", "content_sanskrit": "अथवा गोसहस्राणि बहूनि शुभदर्शन ।\nविविधं तद्धरिष्यामः परिपीड्य पुरं बलात्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2140075, "chapter_id": 4023, "verse_number": "५२", "content_sanskrit": "कौरवाः सह संहत्य त्रिगर्ताश्च विशाम्पते ।\nगाश्च तस्य हरामाशु सह सर्वैर्महारथैः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2140076, "chapter_id": 4023, "verse_number": "५३", "content_sanskrit": "सन्धिं वा तेन कृत्वा तु निबध्नीमोऽस्य पौरुषम् ।\nहत्वा चास्य चमूं कृत्स्नां वशमन्वानयामहे\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2140077, "chapter_id": 4023, "verse_number": "५४", "content_sanskrit": "तं वशे न्यायतः कृत्वा सुखं वत्स्यामहे वयम् ।\nभवतो बलवृद्धिश्च भविष्यति न संशयः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2140078, "chapter_id": 4023, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2140079, "chapter_id": 4023, "verse_number": "५५", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य कर्णो राजानमब्रवीत्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2140080, "chapter_id": 4023, "verse_number": "५६", "content_sanskrit": "सूक्तं सुशर्मणा वाक्यं प्राप्तकालमिदं हि नः ।\nतस्मात् क्षिप्रं विनिर्यामो योजयित्वा वरूथिनीम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2140081, "chapter_id": 4023, "verse_number": "५७", "content_sanskrit": "यदेतत् तेऽभिरुचितं मम चैतद्धि रोचते ।\nप्रविभज्यं च सैन्यानि यथा वा मन्यते भवान्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2140082, "chapter_id": 4023, "verse_number": "५८", "content_sanskrit": "प्रज्ञावान् कुलवृद्धश्च सर्वेषां नः पितामहः ।\nआचार्यश्च कृपश्चापि शकुनिश्चापि सौबलः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2140083, "chapter_id": 4023, "verse_number": "५९", "content_sanskrit": "यथा ते मन्वते सर्वे तथा यात्रा विधीयताम् ।\nसम्मन्त्र्य चाशु गच्छामः साधनार्थं महीपते\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2140084, "chapter_id": 4023, "verse_number": "६०", "content_sanskrit": "किं नु नः पाण्डवैः कार्यं हीनार्थबलपौरुषैः ।\nअत्यर्थं हि प्रणष्टास्ते प्राप्ता वाऽपि यमक्षयम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2140085, "chapter_id": 4023, "verse_number": "६१", "content_sanskrit": "तद् भवांश्चतुरङ्गेण बलेन महता वृतः ।\nविराटनगरं यातु सर्वसैन्येन भारत\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2140086, "chapter_id": 4023, "verse_number": "६२", "content_sanskrit": "आदास्यामो हि गास्तस्य वसूनि विविधानि च\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2140087, "chapter_id": 4023, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2140088, "chapter_id": 4023, "verse_number": "६३", "content_sanskrit": "ततो दुर्योधनो राजा वचः श्रुत्वा तु तस्य तत् ।\nवैकर्तनस्य कर्णस्य क्षिप्रमाज्ञापयत् ततः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2140089, "chapter_id": 4023, "verse_number": "६४", "content_sanskrit": "शासने नित्ययुक्तं तु दुःशासनमनन्तरम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2140090, "chapter_id": 4023, "verse_number": "६५", "content_sanskrit": "सह वृद्धैस्तु सम्मन्त्र्य क्षिप्रं योजय वाहिनीम् ।\nयथोद्देशं तु गच्छामः सहिताः सर्वकौरवैः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2140091, "chapter_id": 4023, "verse_number": "६६", "content_sanskrit": "सुशर्मा तु यथोद्दिष्टं देशं यातु महारथः ।\nत्रिगर्तैः सहितः सर्वैः प्रख्यातबलपौरुषैः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2140092, "chapter_id": 4023, "verse_number": "६७", "content_sanskrit": "प्रागेव तु सुसंयत्तः विराटविषयं प्रति\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2140093, "chapter_id": 4023, "verse_number": "६८", "content_sanskrit": "जघन्यतो वयं तस्य यास्यामो दिवसान्तरम् ।\nविषयं मत्स्यराजस्य सुसमृद्धं सुसंहितम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2140094, "chapter_id": 4023, "verse_number": "६९", "content_sanskrit": "सुशर्मणा गृहीते तु मत्स्यराजस्य गोधने ।\nविराटः सैन्यमादाय त्रिगर्तैः सह योत्स्यते\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2140095, "chapter_id": 4023, "verse_number": "७०", "content_sanskrit": "अपरं दिवसं गास्तु तत्र गृह्णन्तु कौरवाः ।\nगवार्थे पाण्डवास्तत्र योत्स्यन्ति कुरुभिः सह\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2140096, "chapter_id": 4023, "verse_number": "७१", "content_sanskrit": "तथा गत्वा यथोद्देशं विराटनगरान्तिकम् ।\nक्षिप्रं गोष्ठं समासाद्य गृह्णन्तु विपुलं धनम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2140097, "chapter_id": 4023, "verse_number": "७२", "content_sanskrit": "गवां शतसहस्राणि श्रीमन्ति गुणवन्ति च ।\nवयमस्य निगृह्णीमो द्विधा कृत्वा वरूथिनीम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2140098, "chapter_id": 4023, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2140099, "chapter_id": 4023, "verse_number": "७३", "content_sanskrit": "स तु गत्वा यथोद्दिष्टं देशं मत्स्यमहीपतेः ।\nआदत्त गाः सुशर्मा वै कृष्णपक्षस्य चाष्टमी\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2140100, "chapter_id": 4023, "verse_number": "७४", "content_sanskrit": "अपरं दिवसं चापि सह सम्भूय कौरवाः ।\nनवम्यां ते न्यगृह्णन्त गोकुलानि सहस्रशः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2140101, "chapter_id": 4023, "verse_number": "७५", "content_sanskrit": "कौरवास्तु महावीर्या मत्स्यानां विषयान्तरे\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2140102, "chapter_id": 4023, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि एकत्रिंशोऽध्यायः ॥३१॥ गोग्रहणपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]