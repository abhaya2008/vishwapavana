[{"id": 2134133, "chapter_id": 3896, "verse_number": "१", "content_sanskrit": "ततः प्रहृष्टास्त्रिदशा वादित्राण्यभ्यवादयन् ।\nस्कन्दपारिषदान् घोरान् शृणुष्वाद्भुतदर्शनान् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2134134, "chapter_id": 3896, "verse_number": "२", "content_sanskrit": "वज्रप्रहारात् स्कन्दस्य जज्ञुस्तत्र कुमारकाः ।\nये हरन्ति शिशून् जातान् गर्भस्थांश्चैव दारुणाः ।\nवज्रप्रहारात् कन्याश्च जज्ञिरेऽस्य महाबलाः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2134135, "chapter_id": 3896, "verse_number": "३", "content_sanskrit": "वृतः कन्यागणैः सर्वैरात्मीयैः सह पुत्रकैः ।\nमातृणां प्रेक्षतां चैव भद्रशाखस्तु कोमलैः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2134136, "chapter_id": 3896, "verse_number": "४", "content_sanskrit": "कुमारस्तु विशाखं च पुत्रत्वे समकल्पयत् ।\nस भूत्वा भगवान् सङ्खे रक्षंश्छागमुखस्तदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2134137, "chapter_id": 3896, "verse_number": "५", "content_sanskrit": "ततः कुमारपितरं स्कन्दमाहुर्जना भुवि \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2134138, "chapter_id": 3896, "verse_number": "६", "content_sanskrit": "रुद्रमग्निमुमां स्वाहां प्रदेशेषु महाबलम् ।\nयजन्ति पुत्रकामाश्च पुत्रिणश्च सदा जनाः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2134139, "chapter_id": 3896, "verse_number": "७", "content_sanskrit": "यास्तास्त्वजनयत् कन्यास्तपो नाम हुताशनः ।\nकिं करोमीति ताः स्कन्दं सम्प्राप्ताः समभाषयन् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2134140, "chapter_id": 3896, "verse_number": "८", "content_sanskrit": "भवेम सर्वलोकस्य मातरो वयमुत्तमाः ।\nप्रसादात्तव पूज्याश्च प्रियमेतत् कुरुष्व नः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2134141, "chapter_id": 3896, "verse_number": "९", "content_sanskrit": "सोऽब्रवीद् बाढमित्येवं भविष्यध्वं पृथग्विधाः ।\nअशिवाश्च शिवाश्चैव पुनः पुनरुदारधीः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2134142, "chapter_id": 3896, "verse_number": "१०", "content_sanskrit": "अग्निर्भूत्वा ततश्चैनं छागवक्त्रो बहुप्रजः ।\nरमयामास शैलस्थं बालं क्रीडनकैरिव \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2134143, "chapter_id": 3896, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि सप्तदशाधिकद्विशततमोऽध्यायः ॥२१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2134144, "chapter_id": 3896, "verse_number": "", "content_sanskrit": "॥ इति मार्कण्डेयसमास्यापर्वणि आङ्गिरसे कुमारोत्पत्तौ द्विचत्वारिंशोऽध्यायः ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]