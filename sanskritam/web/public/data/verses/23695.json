[{"id": 7003695000, "chapter_id": 23695, "verse_number": "१-४-३-१", "content_sanskrit": "मार्कंडेय उवाच ।\nभगवन्वंचनेनालं त्वदेकप्रवणे मयि ।\nकिं मादृशोऽस्ति ते शिष्यस्त्वत्कृपैवात्र साक्षिणी ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003695001, "chapter_id": 23695, "verse_number": "१-४-३-२", "content_sanskrit": "स्थानेषु प्राक्त्वदुक्तेषु फलानि च पृथक्पृथक् ।\nयत्र सर्वफलप्राप्तिः स्थानं तद्वद मे विभो ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003695002, "chapter_id": 23695, "verse_number": "१-४-३-३", "content_sanskrit": "चराचराणां भूतानां जानतामप्यजानताम् ।\nयस्य स्मरणमात्रेण मुक्तिस्तद्वद देशिक ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003695003, "chapter_id": 23695, "verse_number": "१-४-३-४", "content_sanskrit": "पश्यैतेन मयैकेन भगवान्नानुराध्यसे ।\nसर्वैरप्येतदर्थं हि मुनिभिः परिवार्यसे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003695004, "chapter_id": 23695, "verse_number": "१-४-३-५", "content_sanskrit": "पुलहेन पुलस्त्येन वशिष्ठेन मरीचिना ।\nअगस्त्येन दधीचेन नक्रुणा भृगुणात्रिणा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003695005, "chapter_id": 23695, "verse_number": "१-४-३-६", "content_sanskrit": "जाबालिना जैमिनिना धौम्येन जमदग्निना ।\nउपयाजेन याजेन भरतेनार्वरीवता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003695006, "chapter_id": 23695, "verse_number": "१-४-३-७", "content_sanskrit": "पिप्पलादेन कण्ठेन कुमुदेनोपमन्युना ।\nकुमुदाक्षेण कुत्सेन वत्सेन वरतंतुना ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003695007, "chapter_id": 23695, "verse_number": "१-४-३-८", "content_sanskrit": "विभांडकेन व्यासेन कण्वरीषेण कंडुना ।\nमांडव्येन मतंगेन कुक्षिणा मांडकर्णिना ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003695008, "chapter_id": 23695, "verse_number": "१-४-३-९", "content_sanskrit": "चंडकौशिकशांडिल्यशाकटायनकौशिकैः ।\nशातातपमधुच्छन्दोगर्गसौभरिरोमशैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003695009, "chapter_id": 23695, "verse_number": "१-४-३-१०", "content_sanskrit": "आपस्तंबपृथुस्तंबभार्गवोदंकपर्वतैः ।\nभारद्वाजेन दाल्भ्येन दांतेन श्वेतकेतुना ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003695010, "chapter_id": 23695, "verse_number": "१-४-३-११", "content_sanskrit": "कौंडिन्यपुण्डरीकाभ्यां रैभ्येण तृणबिन्दुना ।\nवाल्मीकिना नारदेन वह्निना दृढमन्युना ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003695011, "chapter_id": 23695, "verse_number": "१-४-३-१२", "content_sanskrit": "बोधायनसुबोधाभ्यां हारीतेन मृकण्डुना ।\nदुर्वाससातितीक्ष्णेन जालपादेन शक्तिना ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003695012, "chapter_id": 23695, "verse_number": "१-४-३-१३", "content_sanskrit": "कांक्वार्येण नदन्तेन देवदत्तेन न्यंकुना ।\nसुश्रुता चाग्निवेश्येन गालवेन मरुत्वता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003695013, "chapter_id": 23695, "verse_number": "१-४-३-१४", "content_sanskrit": "लोकाक्षिणा विश्रवसा सैंधवेन सुमंतुना ।\nशिशुपायनमौद्गल्यपथ्यचावनमातुरैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003695014, "chapter_id": 23695, "verse_number": "१-४-३-१५", "content_sanskrit": "ऋष्यशृङ्गैकपात्क्रौंचदृढगोमुखदेवलैः ।\nअंगिरोवामदेवौर्वपतंजलिकपिंजलैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003695015, "chapter_id": 23695, "verse_number": "१-४-३-१६", "content_sanskrit": "सनत्कुमारसनकसनंदनसनातनैः ।\nहिरण्यनाभसत्याख्यवाताशनसुहोतृभिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003695016, "chapter_id": 23695, "verse_number": "१-४-३-१७", "content_sanskrit": "मैत्रेयपुष्पजित्सत्यतपःशालीष्यशैशिरैः ।\nनिदाघोतथ्यसंवर्त्तशौल्कायनिपराशरैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003695017, "chapter_id": 23695, "verse_number": "१-४-३-१८", "content_sanskrit": "वैशंपायनकौशल्यशारद्वतकपिध्वजैः ।\nकुशस्वार्चिककैवल्ययाज्ञवल्क्याश्वलायनैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003695018, "chapter_id": 23695, "verse_number": "१-४-३-१९", "content_sanskrit": "कृष्णातपोत्तमानंतकरुणामलकप्रियैः ।\nचरकेण पवित्रेण कपिलेन कणाशिना ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003695019, "chapter_id": 23695, "verse_number": "१-४-३-२०", "content_sanskrit": "नरनारायणाभ्यां च दिव्यैश्चान्यैर्महर्षिभिः ।\nमत्प्रश्नोत्तरशुश्रूषातत्परैः प्रत्यवेक्ष्यसे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003695020, "chapter_id": 23695, "verse_number": "१-४-३-२१", "content_sanskrit": "माहेश्वराग्रगण्यस्त्वं समस्तागमपारगः ।\nव्याप्तश्च सर्वलोकेषु यस्मात्तदनुसाधि नः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003695021, "chapter_id": 23695, "verse_number": "१-४-३-२२", "content_sanskrit": "त्वन्मुखादेव भगवन्वयमेते सुशिक्षिताः ।\nपूर्वमेव त्वया देव किं वान्यदुपपद्यते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003695022, "chapter_id": 23695, "verse_number": "१-४-३-२३", "content_sanskrit": "दिव्यागमपुराणानि द्रष्टव्यः परमेश्वरः ।\nकात्यायनी वा स्कन्दो वा भगवान्वाथ वा भवान् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003695023, "chapter_id": 23695, "verse_number": "१-४-३-२४", "content_sanskrit": "त्वयि यद्यस्ति नो भक्तिर्दया चास्मासु ते यदि ।\nरहस्यमिदमुद्घाट्य प्रसादं कर्तुमर्हसि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003695024, "chapter_id": 23695, "verse_number": "१-४-३-२५", "content_sanskrit": "इत्थं मृकण्डुतनयेन स नंदिकेशो विज्ञापितः सविनयं स्मयमानवक्त्रम् ।\nतं प्राह चोन्नततरं शिवभक्तिमस्तु प्राग्भक्तितोषितशिवाप्तशरीरसिद्धिम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]