[{"id": 2119407, "chapter_id": 3564, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2119408, "chapter_id": 3564, "verse_number": "१", "content_sanskrit": "सम्पूज्याथाभ्यनुज्ञातो महर्षेर्वचनात् परम् ।\nप्रत्युवाचानुपूर्व्येण धर्मराजो युधिष्ठिरः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2119409, "chapter_id": 3564, "verse_number": "२", "content_sanskrit": "भगवन् यन्ममाहैतन्मदर्थं धर्मसंहितम् ।\nयथाशक्ति यथान्यायं क्रियतेऽयं विधिर्मया\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2119410, "chapter_id": 3564, "verse_number": "३", "content_sanskrit": "राजभिस्तु तथा कार्यं पुराणज्ञैर्न संशयः ।\nयथान्यायोपनीतार्थं कृतं हेतुमदर्थवत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2119411, "chapter_id": 3564, "verse_number": "४", "content_sanskrit": "वयं तु सत्पथे तेषां यातुमिच्छामहे प्रभो ।\nनतु शक्यं तथा गन्तुं यथा तैर्नियतात्मभिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2119412, "chapter_id": 3564, "verse_number": "५", "content_sanskrit": "एवमुक्त्वा स धर्मात्मा वाक्यं तमभिपूज्य च ।\nमुहूर्तात् प्राप्तकालं च दृष्ट्वा लोकचरं मुनिम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2119413, "chapter_id": 3564, "verse_number": "६", "content_sanskrit": "नारदं सुस्थमासीनम् उपासीनो युधिष्ठिरः ।\nतं तु विश्रान्तमासीनं देवर्षिममितद्युतिम् ।\nअपृच्छद् राजमध्ये तं प्रीतिपूर्वमिदं तदा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2119414, "chapter_id": 3564, "verse_number": "७", "content_sanskrit": "भगवान् सञ्चरंल्लोकान् सदा नानाविधान् बहून् ।\nब्रह्मणा निर्मितान् पूर्वं प्रेक्षमाणो मनोजवः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2119415, "chapter_id": 3564, "verse_number": "८", "content_sanskrit": "ईदृशी भविता काचिद् दृष्टपूर्वा सभा क्वचित् ।\nइतो वा श्रेयसी ब्रह्मंस्तन्ममाचक्ष्व पृच्छतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2119416, "chapter_id": 3564, "verse_number": "९", "content_sanskrit": "तच्छ्रुत्वा नारदस्तस्य धर्मराजस्य भाषितम् ।\nपाण्डवं प्रत्युवाचेदं स्मयन् मधुरया गिरा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2119417, "chapter_id": 3564, "verse_number": "१०", "content_sanskrit": "मानुषेषु न मे काचिद् दृष्टपूर्वा न च श्रुता ।\nसभा मणिमयी राजन् यथेयं तव भारत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2119418, "chapter_id": 3564, "verse_number": "११", "content_sanskrit": "सभां तु पितृराजस्य वरुणस्य च धीमतः ।\nकथयिष्ये तथेन्द्रस्य कैलासनिलयस्य च\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2119419, "chapter_id": 3564, "verse_number": "१२", "content_sanskrit": "ब्रह्मणश्च सभां दिव्यां कथयिष्ये गतक्लमाम् ।\nयदि ते श्रवणे बुद्धिर्वर्तते भरतर्षभ\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2119420, "chapter_id": 3564, "verse_number": "१३", "content_sanskrit": "नारदेनैवमुक्तस्तु धर्मराजो युधिष्ठिरः ।\nप्राञ्जलिर्भ्रातृभिः सार्धं तैश्च सर्वैर्नृपैर्वृतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2119421, "chapter_id": 3564, "verse_number": "१४", "content_sanskrit": "नारदं प्रत्युवाचेदं सभामध्ये व्यवस्थितम् ।\nसभाः कथय ताः सर्वाः श्रोतुमिच्छामहे वयम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2119422, "chapter_id": 3564, "verse_number": "१५", "content_sanskrit": "किन्द्रव्यास्ताः सभा ब्रह्मन् किंविस्ताराः किमायताः ।\nपितामहं च के तस्यां सभायां पर्युपासते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2119423, "chapter_id": 3564, "verse_number": "१६", "content_sanskrit": "वासवं देवराजं च यमं वैवस्वतं च के ।\nवरुणं च कुबेरं च सभायां समुपासते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2119424, "chapter_id": 3564, "verse_number": "१७", "content_sanskrit": "एतत् सर्वं यथातत्त्वं देवर्षे वदतस्तव ।\nश्रोतुमिच्छाम सहिताः परं कौतूहलं हि नः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2119425, "chapter_id": 3564, "verse_number": "१८", "content_sanskrit": "एवमुक्तः पाण्डवेन नारदः प्रत्युवाच ह ।\nक्रमेण राजन् दिव्यास्ताः श्रूयतामिह नः सभाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2119426, "chapter_id": 3564, "verse_number": "", "content_sanskrit": "॥ इति श्रीमहाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां सभापर्वणि षष्ठोऽध्यायः ॥ ॥ मन्त्रपर्वणि षष्ठोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2119427, "chapter_id": 3564, "verse_number": "", "content_sanskrit": "— ०  —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]