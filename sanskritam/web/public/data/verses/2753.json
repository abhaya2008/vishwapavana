[{"id": 2082411, "chapter_id": 2753, "verse_number": "१२-२५८-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082412, "chapter_id": 2753, "verse_number": "१२-२५८-१", "content_sanskrit": "द्वन्द्वासि मोक्षजिज्ञासुरर्थधर्मानुतिष्ठतः।\nवक्रा गुणवता शिष्यः श्राव्यः पूर्वमिदं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082413, "chapter_id": 2753, "verse_number": "१२-२५८-२", "content_sanskrit": "आकाशं मारुतो ज्योतिरा--पृथ्वी च पञ्चमी।\nभावाभावौ च कालश्च सर्वभूतेषु पञ्चसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082414, "chapter_id": 2753, "verse_number": "१२-२५८-३", "content_sanskrit": "अन्तरात्मकमाकाशं तन्मयं श्रोत्रमिन्द्रियम्।\nतस्य शब्दं गुणं विद्यान्मुनिः शास्त्रविधानवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082415, "chapter_id": 2753, "verse_number": "१२-२५८-४", "content_sanskrit": "चरणं मारुतात्मेति प्राणापानौ च तन्मयौ।\nस्पर्शनं चेन्द्रियं विद्यात्तथा स्पर्शं च तन्मयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082416, "chapter_id": 2753, "verse_number": "१२-२५८-५", "content_sanskrit": "तापः पाकः प्रकाशश्च ज्योतिश्चक्षुश्च तन्मयम्।\nतस्य रूपं गुणं विद्यात्तमोनाशकमात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082417, "chapter_id": 2753, "verse_number": "१२-२५८-६", "content_sanskrit": "प्रक्लेदो द्रवता स्नेह इत्यपामुपदिश्यते।\n[असृङ्भज्जा च यच्चान्यत्स्निग्धं विद्यात्तदात्मकम्॥]\nरसनं चेन्द्रियं जिह्वा रसश्चापां गुणो मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082418, "chapter_id": 2753, "verse_number": "१२-२५८-७", "content_sanskrit": "संघातः पार्थिवो धातुरस्थिदन्तनखानि च।\nश्मश्चु रोम च केशाश्च सिरा स्नायु च चर्म च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082419, "chapter_id": 2753, "verse_number": "१२-२५८-८", "content_sanskrit": "इन्द्रियं घ्राणसंज्ञातं नासिकेत्यभिसंज्ञिता।\nगन्धश्चैवेन्द्रियार्थोऽयं विज्ञेयः पृथिवीमयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082420, "chapter_id": 2753, "verse_number": "१२-२५८-९", "content_sanskrit": "उत्तरेषु गुणाः सर्वे सन्ति पूर्वेषु नोत्तराः।\nपञ्चानां भूतसङ्घानां संततिं मुनयो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082421, "chapter_id": 2753, "verse_number": "१२-२५८-१०", "content_sanskrit": "मनो नवममेषां तु बुद्धिस्तु दशमी स्मृता।\nएकादशस्त्वन्तरात्मा स सर्वः पर उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082422, "chapter_id": 2753, "verse_number": "१२-२५८-११", "content_sanskrit": "व्यवसायात्मिका बुद्धिर्मनो व्याकरणात्मकम्।\nकर्मानुमानाद्विज्ञेयः स जीवः क्षेत्रसंज्ञकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082423, "chapter_id": 2753, "verse_number": "१२-२५८-१२", "content_sanskrit": "एभिः कालात्मकैर्भावैर्यः सर्वैः सर्वमन्वितम्।\nपश्यत्यकलुयं बुद्ध्या स मोहं नानुवर्तते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082424, "chapter_id": 2753, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अष्टपञ्चाशदधिकद्विशततमोऽध्यायः॥ २५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]