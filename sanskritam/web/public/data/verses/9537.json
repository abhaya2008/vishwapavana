[{"id": 5000537000, "chapter_id": 9537, "verse_number": "७-२-१", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा राघवस्य महात्मनः ।\nकुम्भयोनिर्मिहातेजा राममेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000537001, "chapter_id": 9537, "verse_number": "७-२-२", "content_sanskrit": "शृणु राम कथावृत्तं तस्य तेजोबलं महत् ।\nजघान शत्रून्येनासौ न च वध्यः स शत्रुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000537002, "chapter_id": 9537, "verse_number": "७-२-३", "content_sanskrit": "तावत्ते रावणस्येदं कुलं जन्म च राघव ।\nवरप्रदानं च तथा तस्मै दत्तं ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000537003, "chapter_id": 9537, "verse_number": "७-२-४", "content_sanskrit": "पुरा कृतयुगे राम प्रजापतिसुतः प्रभुः ।\nपुलस्त्यो नाम ब्रह्मर्षिः साक्षादिव पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000537004, "chapter_id": 9537, "verse_number": "७-२-५", "content_sanskrit": "नानुकीर्त्या गुणास्तस्य धर्मतः शीलतस्तथा ।\nप्रजापतेः पुत्र इति वक्तुं शक्यं हि नामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000537005, "chapter_id": 9537, "verse_number": "७-२-६", "content_sanskrit": "प्रजापतिसुतत्वेन देवानां वल्लभो हि सः ।\nहृष्टः सर्वस्य लोकस्य गुणैः शुभ्रैर्महामतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000537006, "chapter_id": 9537, "verse_number": "७-२-७", "content_sanskrit": "स तु धर्मप्रसङ्गेन मेरोः पार्श्वे महागिरेः ।\nतृणविन्द्वाश्रमं गत्वा न्यवसन्मुनिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000537007, "chapter_id": 9537, "verse_number": "७-२-८", "content_sanskrit": "तपस्तेपे स धर्मात्मा स्वाध्यायनियतेन्द्रियः ।\nगत्वाश्रमपदं तस्य विघ्नं कुर्वन्ति कन्यकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000537008, "chapter_id": 9537, "verse_number": "७-२-९", "content_sanskrit": "देवपन्नगकन्याश्च राजर्षितनयाश्च याः ।\nक्रीडन्त्यो ऽप्सरसश्चैव तं देशमुपपेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000537009, "chapter_id": 9537, "verse_number": "७-२-१०", "content_sanskrit": "सर्वर्तुषृपभोग्यत्वाद्रम्यत्वात्काननस्य च ।\nनित्यशस्तास्तु तं देशं गत्वा क्रीडन्ति कन्यकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000537010, "chapter_id": 9537, "verse_number": "७-२-११", "content_sanskrit": "देशस्य रमणीयत्वात्पुलस्त्यो यत्र स द्विजः ।\nगायन्त्यो वादयन्त्यश्च लासयन्त्यस्तथैव च ।\nमुनेस्तपस्विनस्तस्य विघ्नं चक्रुरनिन्दिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000537011, "chapter_id": 9537, "verse_number": "७-२-१२", "content_sanskrit": "अथ क्रुद्धो महातेजा व्याजहार महामुनिः ।\nया मे दर्शनमागच्छेत्सा गर्भं धारयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000537012, "chapter_id": 9537, "verse_number": "७-२-१३", "content_sanskrit": "तास्तु सर्वाः प्रतिश्रुत्य तस्य वाक्यं महात्मनः ।\nब्रह्मशापभयाद्भीतास्तं देशं नोपचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000537013, "chapter_id": 9537, "verse_number": "७-२-१४", "content_sanskrit": "तृणबिन्दोस्तु राजर्षेस्तनया न शृणोति तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000537014, "chapter_id": 9537, "verse_number": "७-२-१५", "content_sanskrit": "गत्वाश्रमपदं तत्र विचचार सुनिर्भया ।\nन सापश्यत्स्थिता तत्र काञ्चिदभ्यागतां सखीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000537015, "chapter_id": 9537, "verse_number": "७-२-१६", "content_sanskrit": "तस्मिन्काले महातेजाः प्राजापत्यो महानृषिः ।\nस्वाध्यायमकरोत्तत्र तपसा भावितः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000537016, "chapter_id": 9537, "verse_number": "७-२-१७", "content_sanskrit": "सा तु वेदश्रुतिं श्रुत्वा दृष्ट्वा वै तपसो निधिम् ।\nअभवत्पाण्डुदेहा सा सुव्यञ्जितशरीरजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000537017, "chapter_id": 9537, "verse_number": "७-२-१८", "content_sanskrit": "वभूव च समुद्विग्ना दृष्ट्वा तद्दोषमात्मनः ।\nइदं मे किन्त्विति ज्ञात्वा पितुर्गत्वा ऽ ऽश्रमे स्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000537018, "chapter_id": 9537, "verse_number": "७-२-१९", "content_sanskrit": "तां तु दृष्ट्वा तथाभूतां तृणविन्दुरथाब्रवीत् ।\nकिं त्वमेतत्त्वसदृशं धारयस्यात्मनो वपुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000537019, "chapter_id": 9537, "verse_number": "७-२-२०", "content_sanskrit": "सा तु कृत्वाञ्जलिं दीना कन्योवाच तपोधनम् ।\nन जाने कारणं तात येन मे रूपमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000537020, "chapter_id": 9537, "verse_number": "७-२-२१", "content_sanskrit": "किं तु पूर्वं गतास्म्येका महर्षेर्भावितात्मनः ।\nपुलस्त्यस्याश्रमं दिव्यमन्वेष्टुं स्वसखीजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000537021, "chapter_id": 9537, "verse_number": "७-२-२२", "content_sanskrit": "न च पश्याम्यहं तत्र काञ्चिदभ्यागतां सखीम् ।\nरूपस्य तु विपर्यासं दृष्ट्वा त्रासादिहागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000537022, "chapter_id": 9537, "verse_number": "७-२-२३", "content_sanskrit": "तृणबिन्दुस्तु राजर्षिस्तपसा द्योतितप्रभः ।\nध्यानं विवेश तच्चापि ह्यपश्यदृषिकर्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000537023, "chapter_id": 9537, "verse_number": "७-२-२४", "content_sanskrit": "स तु विज्ञाय तं शापं महर्षेर्भावितात्मनः ।\nगृहीत्वा तनयां गत्वा पुलस्त्यमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000537024, "chapter_id": 9537, "verse_number": "७-२-२५", "content_sanskrit": "भगवंस्तनयां मे त्वं गुणैः स्वैरेव भूषिताम् ।\nभिक्षां प्रतिगृहाणेमां महर्षे स्वयमुद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000537025, "chapter_id": 9537, "verse_number": "७-२-२६", "content_sanskrit": "तपश्चरणयुक्तस्य श्रम्यमाणेन्द्रियस्य ते ।\nशुश्रूषणपरा नित्यं भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000537026, "chapter_id": 9537, "verse_number": "७-२-२७", "content_sanskrit": "तं ब्रुवाणं तु तद्वाक्यं राजर्षिं धार्मिकं तदा ।\nजिघृक्षुरब्रवीत्कन्यां बाढमित्येव स द्विजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000537027, "chapter_id": 9537, "verse_number": "७-२-२८", "content_sanskrit": "दत्त्वा स तु यथान्यायं स्वमाश्रमपदं गतः ।\nसापि तत्रावसत्कन्या तोषयन्ती पतिं गुणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000537028, "chapter_id": 9537, "verse_number": "७-२-२९", "content_sanskrit": "तस्यास्तु शीलवृत्ताभ्यां तुतोष मुनिपुङ्गवः ।\nप्रीतः स तु महातेजा वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000537029, "chapter_id": 9537, "verse_number": "७-२-३०", "content_sanskrit": "परितुष्टो ऽस्मि सुश्रोणि गुणानां सम्पदा भृशम् ।\nतस्माद्देवि ददाम्यद्य पुत्रमात्मसमं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000537030, "chapter_id": 9537, "verse_number": "७-२-३१", "content_sanskrit": "उभयोर्वंशकर्तारं पौलस्त्य इति विश्रुतम् ।\nयस्मात्तु विश्रुतो वेदस्त्वयैषो ऽध्ययतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000537031, "chapter_id": 9537, "verse_number": "७-२-३२", "content_sanskrit": "तस्मात्स विश्रवा नाम भविष्यति न संशयः ।\nएवमुक्ता तु सा देवी प्रहृष्टेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000537032, "chapter_id": 9537, "verse_number": "७-२-३३", "content_sanskrit": "अचिरेणैव कालेनासूत विश्रवसं सुतम् ।\nत्रिषु लोकेषु विख्यातं यशोधर्मसमन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000537033, "chapter_id": 9537, "verse_number": "७-२-३४", "content_sanskrit": "श्रुतिमान्समदर्शी च व्रताचाररतस्तथा ।\nपितेव तपसा युक्तो ह्यभवद्विश्रवा मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000537034, "chapter_id": 9537, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे द्वितीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]