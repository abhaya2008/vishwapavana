[{"id": 7003716000, "chapter_id": 23716, "verse_number": "१-४-२४-१", "content_sanskrit": "मार्कंडेय उवाच ।\nभगवन्भवमाहात्म्यरत्नाकरसुधाकरम् ।\nनंदीश चित्रं चारित्रं श्रुतं विद्याभृतोर्द्वयोः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003716001, "chapter_id": 23716, "verse_number": "१-४-२४-२", "content_sanskrit": "कदा वज्रांगदः सिद्धः कथं देवमपूजयत् ।\nकथं चान्वग्रहीत्प्रह्वं देवस्तमरुणेश्वरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003716002, "chapter_id": 23716, "verse_number": "१-४-२४-३", "content_sanskrit": "नंदिकेश्वर उवाच ।\nनिवर्त्तनेच्छां हित्वाथ नृपो निजपुरं प्रति ।\nतस्यैव पादपर्यंते स्वस्य वासमरोचयत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003716003, "chapter_id": 23716, "verse_number": "१-४-२४-४", "content_sanskrit": "अथास्य महती सेना वाहमार्गानुसारिणी ।\nप्राप्ता शतांगमातंगतुरंगभटसंकुला ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003716004, "chapter_id": 23716, "verse_number": "१-४-२४-५", "content_sanskrit": "समदृश्यत भूपालस्तादृशो धैर्यसागरः ।\nपुरोधोमंत्रिसामंतसेनापतिसुहृत्तमैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003716005, "chapter_id": 23716, "verse_number": "१-४-२४-६", "content_sanskrit": "ततस्तामागतां सेनामवनीपतिरादृतः ।\nअरुणाद्रेश्च सीमाया बहिरेव न्यवेशयत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003716006, "chapter_id": 23716, "verse_number": "१-४-२४-७", "content_sanskrit": "स्वकीयमखिलं कोशं देशानपि महाफलान् ।\nशोणाद्रिनाथपूजायै कल्पयामास भक्तिमान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003716007, "chapter_id": 23716, "verse_number": "१-४-२४-८", "content_sanskrit": "गौतमस्याश्रमाभ्याशे स्वयं कृततपोवनः ।\nपुरोधोक्तः ससचिवः शिवार्चनरतोऽभवत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003716008, "chapter_id": 23716, "verse_number": "१-४-२४-९", "content_sanskrit": "रत्नांगदाख्यं तनयं स्थापयित्वा निजे पदे ।\nतत्प्रेषितैरपर्याप्तैः शोणेशं पर्यतर्पयत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003716009, "chapter_id": 23716, "verse_number": "१-४-२४-१०", "content_sanskrit": "परितः शोणशैलस्य परिपूर्णजलाशयान् ।\nअग्रहारान्बहुफलान्ब्राह्मणेभ्योऽतिसृष्टवान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003716010, "chapter_id": 23716, "verse_number": "१-४-२४-११", "content_sanskrit": "तेजसारुणनाथस्य ज्वलनस्तंभरूपिणः ।\nधन्वप्रायेऽपि देशेऽस्मिन्दीर्घिकाः शतशो व्यधात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003716011, "chapter_id": 23716, "verse_number": "१-४-२४-१२", "content_sanskrit": "सौंदर्यशालिनीरात्मपरिवारवरांगनाः ।\nसेवार्थं शोणनाथस्य दत्तवान्दीर्घदर्शनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003716012, "chapter_id": 23716, "verse_number": "१-४-२४-१३", "content_sanskrit": "अथागतेनागस्त्येन लोपामुद्रासखेन सः ।\nअभ्यनंद्यत शोणाद्रिनाथपूजापरायणः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003716013, "chapter_id": 23716, "verse_number": "१-४-२४-१४", "content_sanskrit": "प्रत्यहं नवतीर्थाख्ये सरसि स्नानमाचरन् ।\nपापनाशप्रवालेशौ प्रयतः पर्यपूजयत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003716014, "chapter_id": 23716, "verse_number": "१-४-२४-१५", "content_sanskrit": "महिषासुरसंहारकारिणी मानवेश्वरः ।\nनित्यमाराधयामास दुर्गां दुर्ग्गार्तिहारिणीम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003716015, "chapter_id": 23716, "verse_number": "१-४-२४-१६", "content_sanskrit": "प्रतिक्षणं ब्रह्मविष्णुपूज्यस्य लिंगरूपिणः ।\nआदिदेवस्य विविधाः सपर्याः पर्यकल्पयत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003716016, "chapter_id": 23716, "verse_number": "१-४-२४-१७", "content_sanskrit": "प्रत्युषस्युत्थितः स्नातः पादाभ्यामेव पार्थिवः ।\nजपन्पंचाक्षरीमंत्रमकार्षीत्त्रिः प्रदक्षिणाम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003716017, "chapter_id": 23716, "verse_number": "१-४-२४-१८", "content_sanskrit": "पौर्णमास्यां स कार्त्तिक्यां पार्वतीवल्लभप्रियम् ।\nमहादीपोत्सवं चक्रे महितं भुवनत्रये ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003716018, "chapter_id": 23716, "verse_number": "१-४-२४-१९", "content_sanskrit": "सुगंधसारकह्लारकर्पूरजलपूरितः ।\nसहस्रैः स्वर्णकुंभानामभ्यषिंचत्त्रियंत्रकम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003716019, "chapter_id": 23716, "verse_number": "१-४-२४-२०", "content_sanskrit": "प्रतिमासध्वजारोहपूर्वं तीर्थोत्सवादिकम् ।\nत्रैलोक्याभ्यर्हितं चक्रे रथारोहं महोत्सवम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003716020, "chapter_id": 23716, "verse_number": "१-४-२४-२१", "content_sanskrit": "अंगं प्रदक्षिणं चास्य विदधे विशदाशयः ।\nयोजनत्रितयायामव्यापिनः शोणभूभृतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003716021, "chapter_id": 23716, "verse_number": "१-४-२४-२२", "content_sanskrit": "अरुणाचलनाथेति करुणामृतसागरः ।\nअरुणांवासनाथेति तुष्टाव च मुहुर्मुहुः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003716022, "chapter_id": 23716, "verse_number": "१-४-२४-२३", "content_sanskrit": "संलिप्य विविधैर्द्रव्यैर्नित्यं पंचामृतादिभिः ।\nआचर्च यद्गंधसारपंकैः कर्पूरपांडुरैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003716023, "chapter_id": 23716, "verse_number": "१-४-२४-२४", "content_sanskrit": "अपूजयत कल्हारैः स्रवन्मृगमदद्रवैः॥ प्रा  ।\nतरारभ्य शोणाद्रिनायकं गणरूपिणम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003716024, "chapter_id": 23716, "verse_number": "१-४-२४-२५", "content_sanskrit": "इति वर्षत्रयं तस्य वशिनो वरिवस्यया ।\nअरुणाद्रीश्वरस्तुष्टः प्रत्यक्षत्वमगाहत ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003716025, "chapter_id": 23716, "verse_number": "१-४-२४-२६", "content_sanskrit": "नीहाराचलसंकाशमारूढो वृषपुंगवम् ।\nअन्वगासीनया देव्या कृतगाढोपगूहनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003716026, "chapter_id": 23716, "verse_number": "१-४-२४-२७", "content_sanskrit": "ब्रह्मर्षिभिर्वसिष्ठाद्यैर्नारदाद्यैर्महर्षिभिः ।\nगणैर्निकुंभकुंभाद्यैः क्रियमाणजयस्तुतिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003716027, "chapter_id": 23716, "verse_number": "१-४-२४-२८", "content_sanskrit": "करुणासिंधुकल्लोलैः कमलावासवेश्मभिः ।\nकटाक्षपातैर्जगतां कालुष्यमिव वारयन् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003716028, "chapter_id": 23716, "verse_number": "१-४-२४-२९", "content_sanskrit": "दृष्ट्वा च देवदेवं तमष्टांगं न्यस्य भूतले ।\nप्रणनाम परं हृष्टो वज्रांगदमहीपतिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003716029, "chapter_id": 23716, "verse_number": "१-४-२४-३०", "content_sanskrit": "व्यज्ञापयच्च भूपालो मौलीकृतशतांजलिः ।\nक्षालयन्निव दंतांशुजालैस्तत्पादपंकजे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003716030, "chapter_id": 23716, "verse_number": "१-४-२४-३१", "content_sanskrit": "वज्रांगद उवाच ।\nदेवेश यदहं मोहाद्बहुपातकसंचयम् ।\nअचारिषं स एकोऽयं क्षम्यतां मे व्यतिक्रमः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003716031, "chapter_id": 23716, "verse_number": "१-४-२४-३२", "content_sanskrit": "इतिवादिनमत्यंतं दीनमेव दयानिधिः ।\nजगाद जगतीनाथो देवः शोणाचलेश्वरः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003716032, "chapter_id": 23716, "verse_number": "१-४-२४-३३", "content_sanskrit": "श्रीमहेश्वर उवाच ।\nमा भैषीर्वत्स भद्रं ते संत्यष्टौ मम मूर्त्तयः ।\nताः सर्वाः सर्वजंतूनामत्यर्थं परिकल्पिताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003716033, "chapter_id": 23716, "verse_number": "१-४-२४-३४", "content_sanskrit": "पुरा पुरंदरस्त्वं हि कैलासशिखरे स्थितम् ।\nगर्वितो मामवामंस्थाः स्तंभितश्च तदा मया ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003716034, "chapter_id": 23716, "verse_number": "१-४-२४-३५", "content_sanskrit": "क्षणं गलितगर्वस्त्वं स्तंभना व्रीडितस्तदा ।\nअयाचिष्ठाः शिवज्ञानमखिलैश्वर्यकारणम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003716035, "chapter_id": 23716, "verse_number": "१-४-२४-३६", "content_sanskrit": "आदिष्टस्त्वं मया वज्रिन्नवतीर्यावनिं भवान् ।\nराजा वज्रांगदो भूत्वा लप्स्यसे मत्कृपामिति ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003716036, "chapter_id": 23716, "verse_number": "१-४-२४-३७", "content_sanskrit": "जातं ततः प्रभावेण क्षेत्रमेतन्मदास्पदम् ।\nशिक्षितोतीव मुग्धस्त्वं भक्तोसि च परं मयि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003716037, "chapter_id": 23716, "verse_number": "१-४-२४-३८", "content_sanskrit": "अधुनातिसपर्याभिस्त्वत्कृताभिरहर्निशम् ।\nपरितुष्टोस्म्यहं राजन्नतस्त्वां बोधयाम्यहम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003716038, "chapter_id": 23716, "verse_number": "१-४-२४-३९", "content_sanskrit": "खं वायुरनलो वारि भूः सूर्य शशिनौ पुमान् ।\nइति मन्मूर्त्तिभिर्विश्वं भासते सचराचरम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003716039, "chapter_id": 23716, "verse_number": "१-४-२४-४०", "content_sanskrit": "कालो हि कालयाम्यर्थान्सत्त्वानध्वन एव च ।\nतत्त्वातीतः शिवश्चाहं न मत्तोस्तीह किंचन ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003716040, "chapter_id": 23716, "verse_number": "१-४-२४-४१", "content_sanskrit": "अपर्यंतचिदानंदसिंधोर्मे केचिदूर्मयः ।\nवेधोमुकुन्दरुद्रेंद्रमुखानाहुरुदित्वराः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003716041, "chapter_id": 23716, "verse_number": "१-४-२४-४२", "content_sanskrit": "वाणीलक्ष्मीक्षमाश्रद्धाप्रज्ञास्वाहास्वधादयः ।\nअसंख्येयमहाशक्तेर्मम विसृष्टिशक्तयः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003716042, "chapter_id": 23716, "verse_number": "१-४-२४-४३", "content_sanskrit": "इयं मम महाशक्तिर्गौरी माया जगत्प्रसूः ।\nअनयाच्छाद्यते विश्वं शश्वद्विस्तार्यतेऽपि च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003716043, "chapter_id": 23716, "verse_number": "१-४-२४-४४", "content_sanskrit": "शक्त्यानयान्वितः सर्गरक्षासंहृतिविभ्रमः ।\nविचित्रमेतत्पश्यामि जगच्चित्रं निजेच्छया ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003716044, "chapter_id": 23716, "verse_number": "१-४-२४-४५", "content_sanskrit": "अपवाहितमोहस्त्वं महिमा मे विचारय ।\nआत्मानमविभिन्नं मे तरंगमिव वारिधेः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003716045, "chapter_id": 23716, "verse_number": "१-४-२४-४६", "content_sanskrit": "ततो मद्रूपशालिन्या आधिपत्यं क्षितेर्गतः ।\nमत्प्रसादेन राजेंद्र भुंक्ष्व भोगान्यथासुखम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003716046, "chapter_id": 23716, "verse_number": "१-४-२४-४७", "content_sanskrit": "पुनः पुरंदरत्वेन भुक्तदिव्यसुखश्चिरम् ।\nमदेकरूपतां राजन्निश्चयात्त्वमवाप्स्यसि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003716047, "chapter_id": 23716, "verse_number": "१-४-२४-४८", "content_sanskrit": "नंदिकेश्वर उवाच ।\nइत्युक्त्वांतर्हिते देवे राजा वज्रांगदः कृती ।\nशोणेशं पूजयन्नेव सर्वान्भोगानवाप्तवान् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003716048, "chapter_id": 23716, "verse_number": "१-४-२४-४९", "content_sanskrit": "इत्थं ते कथितं साधो शिवभक्तविजृंभणम् ।\nप्रदक्षिणाफलं चैव शोणशैलस्य शाश्वतम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003716049, "chapter_id": 23716, "verse_number": "१-४-२४-५०", "content_sanskrit": "किं वाचां विस्तरेणात्र शोणशैलप्रदक्षिणा ।\nमहतामश्वमेधानां शतादपि विशिष्यते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003716050, "chapter_id": 23716, "verse_number": "१-४-२४-५१", "content_sanskrit": "विषुवायनसंक्राति व्यतीपातादिपर्वसु ।\nप्रदक्षिणाच्छोणगिरेरसंख्येयं फलं लभेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003716051, "chapter_id": 23716, "verse_number": "१-४-२४-५२", "content_sanskrit": "न क्षेत्रमरुणादस्ति नास्ति देवोऽरुणेश्वरात् ।\nनापि प्रदक्षिणादन्यद्विपद्यतेऽभ्यधिकं तपः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003716052, "chapter_id": 23716, "verse_number": "१-४-२४-५३", "content_sanskrit": "इति कथयति नंदिकेश्वरेस्मिन्पुलकितसर्ववपुर्मृकण्डुपुत्रः ।\nमुहुरधिगतहर्षवाष्पवृष्टिर्महति निमग्न इवाभवत्सुधाब्धौ ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003716053, "chapter_id": 23716, "verse_number": "१-४-२४-५४", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डेऽरुणाचलमाहात्म्य उत्तरार्धे वज्रांगदसद्गतिवर्णनंनाम चतुर्विंशतितमोऽध्यायः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]