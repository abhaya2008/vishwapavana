[{"id": 2108938, "chapter_id": 3363, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108939, "chapter_id": 3363, "verse_number": "१", "content_sanskrit": "वासुकिस्त्वब्रवीद् वाक्यं जरत्कारुमृषिं तदा ।\nसनामा तव कन्येयं स्वसा मे तपसान्विता\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108940, "chapter_id": 3363, "verse_number": "२", "content_sanskrit": "प्रदास्यामि च ते भार्यां प्रतीच्छेमां द्विजोत्तम ।\nरक्षणं च करिष्येऽस्याः सर्वशक्त्या तपोधन ।\nत्वदर्थं रक्ष्यते चैषा मया मुनिवरप्रभो \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108941, "chapter_id": 3363, "verse_number": "", "content_sanskrit": "ऋषिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108942, "chapter_id": 3363, "verse_number": "३", "content_sanskrit": "न भरिष्येऽहमेतां वै एष मे समयः कृतः ।\nअप्रियं न च कर्तव्यं कृते चैव त्यजाम्यहम्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108943, "chapter_id": 3363, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108944, "chapter_id": 3363, "verse_number": "४", "content_sanskrit": "प्रतिश्रुते तु नागेन भरिष्ये भगिनीमिति ।\nजरत्कारुस्तदा वेश्म भुजगस्य जगाम ह\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108945, "chapter_id": 3363, "verse_number": "५", "content_sanskrit": "तत्र मन्त्रविदां श्रेष्ठस्तपोवृद्धो महामतिः ।\nजग्राह पाणिं धर्मात्मा विधिमन्त्रपुरस्कृतः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108946, "chapter_id": 3363, "verse_number": "६", "content_sanskrit": "ततो वासगृहं शुभ्रं पन्नगेन्द्रस्य धीमतः ।\nजगाम भार्यामादाय स्तूयमानो महर्षिभिः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108947, "chapter_id": 3363, "verse_number": "७", "content_sanskrit": "शयनं तत्र वै क्लृप्तं स्वर्थ्यास्तरणसंवृतम् ।\nतत्र भार्यासहायः स जरत्कारुरुवास ह ।\nस तत्र समयं चक्रे भार्यया सह सत्तमः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108948, "chapter_id": 3363, "verse_number": "", "content_sanskrit": "जरत्कारुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108949, "chapter_id": 3363, "verse_number": "८", "content_sanskrit": "विप्रियं मे न कर्तव्यं न च वाच्यं कदाचन ।\nत्यजेयमप्रिये हित्वा कृते वासं च ते गृहे ।\nएतद् गृहाण वचनं मया यत् समुदीरितम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108950, "chapter_id": 3363, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108951, "chapter_id": 3363, "verse_number": "९", "content_sanskrit": "ततः परमसंविग्ना स्वसा नागपतेस्तु सा ।\nअतिदुःखान्विता वाक्यं तमुवाचैवमस्त्विति \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108952, "chapter_id": 3363, "verse_number": "१०", "content_sanskrit": "तथैव सा च भर्तारं दुःखशीलमुपाचरत् ।\nउपायैः श्वेतकाकीयैः प्रियकामा मनस्विनी \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108953, "chapter_id": 3363, "verse_number": "११", "content_sanskrit": "ऋतुकाले ततः स्नाता कदाचिद् वासुकेः स्वसा ।\nभर्तारं तु यथान्यायम् उपतस्थे महामुनिम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108954, "chapter_id": 3363, "verse_number": "१२", "content_sanskrit": "ततस्तस्यां समभवद् गर्भो ज्वलनसन्निभः ।\nअतीव तपसा युक्तो वैश्वानरसमद्युतिः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108955, "chapter_id": 3363, "verse_number": "१३", "content_sanskrit": "शुक्लपक्षे यथा सोमो व्यवर्धत तथैव सः ।\nततः कतिपयाहस्सु जरत्कारुर्महातपाः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108956, "chapter_id": 3363, "verse_number": "१४", "content_sanskrit": "उत्सङ्गेऽस्याः शिरः कृत्वा सुष्वाप परिखिन्नवत् ।\nतस्मिंश्च सुप्ते विप्रेन्द्रे सविताऽस्तमियाद् गिरिम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108957, "chapter_id": 3363, "verse_number": "१५", "content_sanskrit": "अह्नः परिक्षये ब्रह्मंस्ततः साऽचिन्तयत् तदा ।\nवासुकेर्भगिनी भीता धर्मलोपान्मनस्विनी\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108958, "chapter_id": 3363, "verse_number": "१६", "content_sanskrit": "किं नु मे सुकृतं भूयाद् भर्तुरुत्थापनेन वा ।\nदुःखशीलो हि धर्मात्मा कथं नास्यापराध्नुयाम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108959, "chapter_id": 3363, "verse_number": "१७", "content_sanskrit": "कोपो वा धर्मशीलस्य धर्मलोपोऽथवा पुनः ।\nधर्मलोपो गरीयान् वै स्यादित्यत्राकरोन्मतिम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108960, "chapter_id": 3363, "verse_number": "१८", "content_sanskrit": "उत्थापयिष्ये यद्येनं ध्रुवं कोपो भविष्यति ।\nधर्मलोपो भवेदस्य सन्ध्यातिक्रमणे ध्रुवम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108961, "chapter_id": 3363, "verse_number": "समाप्तिः", "content_sanskrit": "इति निश्चित्य मनसा जरत्कारुर्भुजङ्गमा ।\nतमृषिं दीप्ततपसं शयानमनलोपमम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108962, "chapter_id": 3363, "verse_number": "२०", "content_sanskrit": "उवाचेदं वचः श्लक्ष्णं ततो मधुरभाषिणी ।\nउत्तिष्ठ त्वं महाभाग सूर्योऽस्तमुपगच्छति \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108963, "chapter_id": 3363, "verse_number": "२१", "content_sanskrit": "सन्ध्यामुपास्स्व भगवन् अपः स्पृष्ट्वा महाव्रतः ।\nप्रादुष्कृताग्निहोत्रोऽयं मुहूर्तो रम्यदारुणः\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108964, "chapter_id": 3363, "verse_number": "२२", "content_sanskrit": "सन्ध्या प्रवर्तते चेयं पश्चिमस्यां दिशि प्रभो ।\nएवमुक्तः स भगवान् जरत्कारुर्महातपाः ।\nभार्यां तां स्फुरमाणोष्ठ  इदं वचनमब्रवीत् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108965, "chapter_id": 3363, "verse_number": "", "content_sanskrit": "जरत्कारुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2108966, "chapter_id": 3363, "verse_number": "२३", "content_sanskrit": "अवमानः प्रयुक्तोऽयं त्वया मेऽद्य भुजङ्गमे ।\nसमीपे ते न वत्स्यामि गमिष्यामि यथागतम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2108967, "chapter_id": 3363, "verse_number": "२४", "content_sanskrit": "न हि तेजोऽस्ति वामोरु मयि सुप्ते विभावसोः ।\nअस्तं गन्तुं यथाकालमिति मे वर्तते मतिः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2108968, "chapter_id": 3363, "verse_number": "२५", "content_sanskrit": "न चाह्यवमतस्येह वस्तुं रोचेत कस्यचित् ।\nकिं पुनर्धर्मशीलस्य मम वा मद्विधस्य वा \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2108969, "chapter_id": 3363, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2108970, "chapter_id": 3363, "verse_number": "२६", "content_sanskrit": "एवमुक्ता जरत्कारुर्भर्त्रा हृदयकम्पनम् ।\nअब्रवीद् भगिनी तत्र वासुकेस्तु निवेशने \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2108971, "chapter_id": 3363, "verse_number": "२७", "content_sanskrit": "नावमानात् कृतवती तवाहं प्रतिबोधनम् ।\nधर्मलोपो न ते विप्र स्यादित्येवं कृतं मया \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2108972, "chapter_id": 3363, "verse_number": "२८", "content_sanskrit": "उवाच भार्यामित्युक्तो जरत्कारुर्महातपाः ।\nऋषिः कोपसमाविष्टः त्यक्तुकामो भुजङ्गमाम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2108973, "chapter_id": 3363, "verse_number": "२९", "content_sanskrit": "न मे वागनृतं प्राह गमिष्येऽहं भुजङ्गमे ।\nसमयो ह्येष मे पूर्वं त्वया सह मिथः कृतः\t ॥ २९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2108974, "chapter_id": 3363, "verse_number": "३०", "content_sanskrit": "सुखमध्युषितो भद्रे ब्रूयास्त्वं भ्रातरं शुभे ।\nइतो मयि गते भीरु गतः स भगवानिति ।\nत्वं चापि मयि निष्क्रान्ते न शोकं कर्तुमर्हसि \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2108975, "chapter_id": 3363, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2108976, "chapter_id": 3363, "verse_number": "३१", "content_sanskrit": "इत्युक्ता साऽनवद्याङ्गी प्रत्युवाच पतिं तदा ।\nजरत्कारुं जरत्कारुः चिन्ताशोकसमन्विता \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2108977, "chapter_id": 3363, "verse_number": "३२", "content_sanskrit": "बाष्पगद्गदया वाचा मुखेन परिशुष्यता ।\nकृताञ्जलिर्वरारोहा पर्यश्रुनयना ततः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2108978, "chapter_id": 3363, "verse_number": "३३", "content_sanskrit": "धैर्यमालम्ब्य वामोरुः हृदयेन प्रदूयता ।\nन मामर्हसि धर्मज्ञ परित्यक्तुमनागसीम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2108979, "chapter_id": 3363, "verse_number": "३४", "content_sanskrit": "धर्मे स्थितां स्थितो धर्मे सदा प्रियहिते रताम् ।\nप्रदाने कारणं यच्च मम तुभ्यं द्विजोत्तम\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2108980, "chapter_id": 3363, "verse_number": "३५", "content_sanskrit": "तदलब्धवतीं मन्दां किं मां वक्ष्यति वासुकिः ।\nमातृशापाभिभूतानां ज्ञातीनां मम सत्तम\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2108981, "chapter_id": 3363, "verse_number": "३६", "content_sanskrit": "अपत्यमीप्सितं त्वत्तः तच्च तावन्न दृश्यते ।\nत्वत्तो ह्यपत्यलाभेन ज्ञातीनां मे सुखं भवेत् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2108982, "chapter_id": 3363, "verse_number": "३७", "content_sanskrit": "सम्प्रयोगो भवेन्नायं मम मोघस्त्वया द्विज ।\nज्ञातीनां हितमिच्छन्ती भगवंस्त्वां प्रसादये \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2108983, "chapter_id": 3363, "verse_number": "३८", "content_sanskrit": "इममव्यक्तरूपं मे गर्भमाधाय सत्तम ।\nकथं त्यक्त्वा महाभाग गन्तुमिच्छस्यनागसीम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2108984, "chapter_id": 3363, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2108985, "chapter_id": 3363, "verse_number": "३९", "content_sanskrit": "एवमुक्तस्तु स मुनिर्भार्यां वचनमब्रवीत् ।\nयद् युक्तमनुरूपं च जरत्कारुं तपोधनः\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2108986, "chapter_id": 3363, "verse_number": "४०", "content_sanskrit": "अस्त्येष गर्भः सुभगे तव वैश्वानरोपमः ।\nऋषिः परमधर्मात्मा वेदवेदाङ्गपारगः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2108987, "chapter_id": 3363, "verse_number": "४१", "content_sanskrit": "एवमुक्त्वा स धर्मात्मा जरत्कारुर्महामुनिः ।\nविहाय तपसे भूयो जगाम कृतनिश्चयः\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2108988, "chapter_id": 3363, "verse_number": "४२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि द्विचत्वारिंशोऽध्यायः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2108989, "chapter_id": 3363, "verse_number": "३०", "content_sanskrit": "॥ आस्तीकपर्वणि त्रिंशोऽध्यायः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]