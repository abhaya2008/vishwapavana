[{"id": 6000021000, "chapter_id": 10021, "verse_number": null, "content_sanskrit": "भगवद्बादरायणप्रणीतं श्रीमद्भागवतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000021001, "chapter_id": 10021, "verse_number": null, "content_sanskrit": "अथ प्रथमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 6000021002, "chapter_id": 10021, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.001.m4a", "display_order": 3}, {"id": 6000021003, "chapter_id": 10021, "verse_number": "२-१-१", "content_sanskrit": "वरीयानेष ते प्रश्नः कृतो लोकहितं नृप।\nआत्मवित्सम्मतः पुंसां श्रोतव्यादिषु यः परः॥ २/१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.002.m4a", "display_order": 4, "topics": [{"text": "शुकेन परीक्षितं प्रति मुमूर्षुणा नारायणस्मरणस्य अवश्यंकरणीयत्वकथनपूर्वकं तच्चरित्रप्रतिपादकभागवतपुराण-कथनप्रतिज्ञानम्", "range": "१–२२"}]}, {"id": 6000021004, "chapter_id": 10021, "verse_number": "२-१-२", "content_sanskrit": "श्रोतव्यानीह राजेन्द्र नृणां सन्ति सहस्रशः।\nअपश्यतामात्मतत्त्वं गृहेषु गृहमेधिनाम्॥ २/१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.003.m4a", "display_order": 5}, {"id": 6000021005, "chapter_id": 10021, "verse_number": "२-१-३", "content_sanskrit": "निद्रया ह्रियते नक्तं व्यवायेन नवं वयः।\nदिवा चार्थेहया राजन् कुटुम्बभरणेन वा॥ २/१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.004.m4a", "display_order": 6}, {"id": 6000021006, "chapter_id": 10021, "verse_number": "२-१-४", "content_sanskrit": "देहापत्यकलत्रादिष्वात्मदैन्येष्वसत्स्वपि।\nतेषु प्रसक्तो निधनं पश्यन्नपि न पश्यति॥ २/१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.005.m4a", "display_order": 7}, {"id": 6000021007, "chapter_id": 10021, "verse_number": "२-१-५", "content_sanskrit": "तस्माद्भारत सर्वात्मा भगवान् हरिरीश्वरः।\nश्रोतव्यः कीर्तितव्यश्च स्मर्तव्यश्चेच्छताऽभयम्॥ २/१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.006.m4a", "display_order": 8}, {"id": 6000021008, "chapter_id": 10021, "verse_number": "२-१-६", "content_sanskrit": "एतावान्साङ्ख्ययोगाभ्यां स्वधर्मपरिनिष्ठया।\nजन्मलाभः परः पुंसामन्ते नारायणस्मृतिः॥ २/१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.007.m4a", "display_order": 9}, {"id": 6000021009, "chapter_id": 10021, "verse_number": "२-१-७", "content_sanskrit": "प्रायेण मुनयो राजन्निवृत्ता विधिनिषेधतः।\nनैर्गुण्यस्था रमन्ते स्म गुणानुकथने हरेः॥ २/१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.008.m4a", "display_order": 10}, {"id": 6000021010, "chapter_id": 10021, "verse_number": "२-१-८", "content_sanskrit": "इदं भागवतं नाम पुराणं ब्रह्मसम्मितम्।\nअधीतवान् द्वापरादौ पितुर्द्वैपायनादहम्॥ २/१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.009.m4a", "display_order": 11}, {"id": 6000021011, "chapter_id": 10021, "verse_number": "२-१-९", "content_sanskrit": "परिनिष्ठितोऽपि नैर्गुण्य उत्तमश्लोकलीलया।\nगृहीतचेता राजर्ष आख्यानं यदधीतवान्॥ २/१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.010.m4a", "display_order": 12}, {"id": 6000021012, "chapter_id": 10021, "verse_number": "२-१-१०", "content_sanskrit": "तदहं तेऽभिधास्यामि महापूरुषिको भवान्।\nयत्र श्रद्दधतामाशु स्यान्मुकुन्दे मतिः सती॥ २/१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.011.m4a", "display_order": 13}, {"id": 6000021013, "chapter_id": 10021, "verse_number": "२-१-११", "content_sanskrit": "एतन्निर्विद्यमानानाम् इच्छतामकुतोभयम्।\nयोगिनां नृप निर्णीतं हरेर्नामानुकीर्तनम्॥ २/१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.012.m4a", "display_order": 14}, {"id": 6000021014, "chapter_id": 10021, "verse_number": "२-१-१२", "content_sanskrit": "किं प्रमत्तस्य बहुभिः परोक्षैर्हायनैरिह।\nपरं मुहूर्तं विदितं घटते श्रेयसे यतः॥ २/१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.013.m4a", "display_order": 15}, {"id": 6000021015, "chapter_id": 10021, "verse_number": "२-१-१३", "content_sanskrit": "खट्वाङ्गो नाम राजर्षिः ज्ञात्वेयत्तामिहायुषः।\nमुहूर्तात्सङ्गमुत्सृज्य गतवानभयं हरिम्॥ २/१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.014.m4a", "display_order": 16}, {"id": 6000021016, "chapter_id": 10021, "verse_number": "२-१-१४", "content_sanskrit": "तवाप्येतर्हि कौरव्य सप्ताहं जीवितावधिः।\nउपकल्पय तत्सर्वं यत्तावत्साम्परायिकम्॥ २/१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.015.m4a", "display_order": 17}, {"id": 6000021017, "chapter_id": 10021, "verse_number": "२-१-१५", "content_sanskrit": "अन्तकाले तु पुरुष आगते गतसाध्वसः।\nछिन्द्यादसङ्गशस्‍त्रेण स्पृहां देहेऽनु ये च तम्॥ २/१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.016.m4a", "display_order": 18}, {"id": 6000021018, "chapter_id": 10021, "verse_number": "२-१-१६", "content_sanskrit": "गृहात्प्रव्रजितो धीरः पुण्यतीर्थजलाप्लुतः।\nशुचौ विविक्त आसीनो विधिवत्कल्पितासने॥ २/१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.017.m4a", "display_order": 19}, {"id": 6000021019, "chapter_id": 10021, "verse_number": "२-१-१७", "content_sanskrit": "अभ्यसेन्मनसा शुद्धं त्रिवृद्ब्रह्माक्षरं परम्।\nमनो यच्छेज्जितश्वासो ब्रह्मबीजमनुस्मरन्॥ २/१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.018.m4a", "display_order": 20}, {"id": 6000021020, "chapter_id": 10021, "verse_number": "२-१-१८", "content_sanskrit": "नियच्छेद्विषयेभ्योऽक्षान्मनसा बुद्धिसारथिः।\nमनः कर्मभिराक्षिप्तं शुभार्थे धारयेद्धिया॥ २/१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.019.m4a", "display_order": 21}, {"id": 6000021021, "chapter_id": 10021, "verse_number": "२-१-१९", "content_sanskrit": "तत्रैकावयवं ध्यायेदव्युच्छिन्नेन चेतसा।\nमनो निर्विषयं युङ्‌क्‍त्वा ततः किञ्चिन्न संस्मरेत्।\nपदं तत्परमं विष्णोर्मनो यत्र प्रसीदति॥ २/१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.020.m4a", "display_order": 22}, {"id": 6000021022, "chapter_id": 10021, "verse_number": "२-१-२०", "content_sanskrit": "रजस्तमोभ्यामाक्षिप्तं विमूढं मन आत्मनः।\nयच्छेद्धारणया धीरो हन्ति या तत्कृतं मलम्॥ २/१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.021.m4a", "display_order": 23}, {"id": 6000021023, "chapter_id": 10021, "verse_number": "२-१-२१", "content_sanskrit": "यस्यां सन्धार्यमाणायां योगिनो भक्तिलक्षणः।\nआशु सम्पद्यते योग आश्रयं भद्रमीक्षतः॥ २/१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.022.m4a", "display_order": 24}, {"id": 6000021024, "chapter_id": 10021, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.023.m4a", "display_order": 25}, {"id": 6000021025, "chapter_id": 10021, "verse_number": "२-१-२२", "content_sanskrit": "यथा सन्धार्यते ब्रह्मन् धारणा यत्र संमता।\nयादृशी वा हरेदाशु पुरुषस्य मनोमलम्॥ २/१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.024.m4a", "display_order": 26}, {"id": 6000021026, "chapter_id": 10021, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.025.m4a", "display_order": 27}, {"id": 6000021027, "chapter_id": 10021, "verse_number": "२-१-२३", "content_sanskrit": "जितासनो जितश्वासो जितसङ्गो जितेन्द्रियः।\nस्थूले भगवतो रूपे मनः सन्धारयेद्धिया॥ २/१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.026.m4a", "display_order": 28, "topics": [{"text": "तथा सपरिकरभगवद्‍ध्यानप्रकारनिरूपणपूर्वकं स्थूलोपासनाय विराड्रूपनिरूपणम्", "range": "२३–३८"}]}, {"id": 6000021028, "chapter_id": 10021, "verse_number": "२-१-२४", "content_sanskrit": "विशेषस्तस्य देहोऽयं स्थविष्ठश्च स्थवीयसाम्।\nयत्रेदं दृश्यते विश्वं भूतं भव्यं भवच्च यत्॥ २/१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.027.m4a", "display_order": 29}, {"id": 6000021029, "chapter_id": 10021, "verse_number": "२-१-२५", "content_sanskrit": "आण्डकोशे शरीरेऽस्मिन्सप्तावरणसंयुते।\nवैराजः पुरुषो योऽसौ भगवान्धारणाश्रयः॥ २/१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.028.m4a", "display_order": 30}, {"id": 6000021030, "chapter_id": 10021, "verse_number": "२-१-२६", "content_sanskrit": "पातालमेतस्य हि पादमूलं पठन्ति पार्ष्णिप्रपदे रसातलम्।\nमहातलं विश्वसृजस्सुगुल्फौ तलातलं वै पुरुषस्य जङ्घे॥ २/१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.029.m4a", "display_order": 31}, {"id": 6000021031, "chapter_id": 10021, "verse_number": "२-१-२७", "content_sanskrit": "द्वे जानुनी सुतलं विश्वमूर्तेरूरुद्वयं वितलं चातलं च।\nमहीतलं तज्जघनं महीपते नभस्तलं नाभिसरो गृणन्ति॥ २/१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.030.m4a", "display_order": 32}, {"id": 6000021032, "chapter_id": 10021, "verse_number": "२-१-२८", "content_sanskrit": "उरःस्थलं ज्योतिरनीकमस्य ग्रीवा महर्वदनं वै जनोऽस्य।\nतपो रराटिं विदुरादिपुंसः सत्यन्तु शीर्षाणि सहस्रशीर्ष्णः॥ २/१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.031.m4a", "display_order": 33}, {"id": 6000021033, "chapter_id": 10021, "verse_number": "२-१-२९", "content_sanskrit": "इन्द्रादयो बाहव आहुरस्य कर्णौ दिशः श्रोत्रममुष्य शब्दः।\nनासत्यदस्रौ परमस्य नासे घ्राणञ्च गन्धो मुखमग्निरिद्धः॥ २/१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.032.m4a", "display_order": 34}, {"id": 6000021034, "chapter_id": 10021, "verse_number": "२-१-३०", "content_sanskrit": "द्यौरक्षिणी चक्षुरभूत्पतङ्गः पक्ष्माणि विष्णोरहनी उभे च।\nतद्‌‍भ्रूविजृम्भः परमेष्ठिधिष्ण्यमापोऽस्य तालू रस एव जिह्वा॥ २/१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.033.m4a", "display_order": 35}, {"id": 6000021035, "chapter_id": 10021, "verse_number": "२-१-३१", "content_sanskrit": "छन्दांस्यनन्तस्य गिरो गृणन्ति दंष्ट्राऽर्यमेन्दूडुगणा द्विजानि।\nहासो जनोन्मादकरी च माया दुरन्तसर्गो यदपाङ्गमोक्षः॥ २/१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.034.m4a", "display_order": 36}, {"id": 6000021036, "chapter_id": 10021, "verse_number": "२-१-३२", "content_sanskrit": "व्रीडोत्तरोष्ठोऽधर एव लोभो धर्मः स्तनोऽधर्मपथश्च पृष्ठः।\nकस्तस्य मेढ्रं वृषणौ च मित्रः कुक्षिः समुद्रा गिरयोऽस्थिसङ्घाः॥ २/१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.035.m4a", "display_order": 37}, {"id": 6000021037, "chapter_id": 10021, "verse_number": "२-१-३३", "content_sanskrit": "नद्योऽस्य नाड्योऽथ तनूरुहाणि महीरुहा विश्वतनोर्नृपेन्द्र।\nअन्नञ्च वीर्यं श्वसितं मातरिश्वा गतिर्वयः कर्म गुणप्रवाहः॥ २/१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.036.m4a", "display_order": 38}, {"id": 6000021038, "chapter_id": 10021, "verse_number": "२-१-३४", "content_sanskrit": "ईशस्य केशान्विदुरम्बुवाहान् वासस्तु सन्ध्ये कुरुवर्य भूम्नः।\nअव्यक्तमाहुर्हृदयं मनस्तु स चन्द्रमाः सर्वविकारकोशः॥ २/१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.037.m4a", "display_order": 39}, {"id": 6000021039, "chapter_id": 10021, "verse_number": "२-१-३५", "content_sanskrit": "विज्ञानशक्तिं मतिमामनन्ति सर्वात्मनोऽन्तःकरणं गिरित्रः।\nअश्वाश्वतर्युष्ट्रगजा नखानि सर्वे मृगाः पशवः श्रोणिदेशे॥ २/१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.038.m4a", "display_order": 40}, {"id": 6000021040, "chapter_id": 10021, "verse_number": "२-१-३६", "content_sanskrit": "वचांसि तद्व्याहरणं विचित्रं मनुर्मनीषा मनुजो निवासः।\nगन्धर्वविद्याधरचारणाप्सरःस्वरस्मृतिर्ह्यसुरानीकवीर्यः॥ २/१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.039.m4a", "display_order": 41}, {"id": 6000021041, "chapter_id": 10021, "verse_number": "२-१-३७", "content_sanskrit": "ब्रह्माननः क्षत्रभुजो महात्मा विडूरुरङ्घ्रिश्रितकृष्णवर्णः।\nस्वाहास्वधावीर्यगुणोपपन्नो हव्यात्मकः कर्मवितानयोगः॥ २/१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.040.m4a", "display_order": 42}, {"id": 6000021042, "chapter_id": 10021, "verse_number": "२-१-३८", "content_sanskrit": "इयानसावीश्वरविग्रहस्य यः सन्निवेशः कथितो मया ते।\nसन्धार्यतेऽस्मिन् वपुषि स्थविष्ठे मनः स्वबुद्ध्या न यतोऽस्ति किञ्चित्॥ २/१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_001/BhP_02.001.041.m4a", "display_order": 43}, {"id": 6000021043, "chapter_id": 10021, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वितीयस्कन्धे प्रथमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]