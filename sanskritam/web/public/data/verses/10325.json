[{"id": 6000325000, "chapter_id": 10325, "verse_number": null, "content_sanskrit": "अथ चतुर्विंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000325001, "chapter_id": 10325, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.001.m4a", "display_order": 2}, {"id": 6000325002, "chapter_id": 10325, "verse_number": "११-२४-१", "content_sanskrit": "अथ ते सम्प्रवक्ष्यामि साङ्ख्यं पूर्वविनिश्चितम्।\nयद् विज्ञाय पुमान् सद्यो जह्याद् वैकल्पिकं मलम्॥ ११/२४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.002.m4a", "display_order": 3, "topics": [{"text": "मनोमोहनिरासार्थं साङ्ख्यकथनम्", "range": "१–४"}]}, {"id": 6000325003, "chapter_id": 10325, "verse_number": "११-२४-२", "content_sanskrit": "आसीज्ज्ञानमथो अर्थश्चैकमेवाविकल्पितम्।\nयदा विवेकनिपुणा आदौ कृतयुगे जनाः॥ ११/२४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.003.m4a", "display_order": 4}, {"id": 6000325004, "chapter_id": 10325, "verse_number": "११-२४-३", "content_sanskrit": "तन्मया फलरूपेण केवलेन विकल्पितम्।\nवाङ्मनोगोचरं सत्यं द्विधा समभवद् बृहत्॥ ११/२४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.004.m4a", "display_order": 5}, {"id": 6000325005, "chapter_id": 10325, "verse_number": "११-२४-४", "content_sanskrit": "तयोरेकतरो ह्यर्थः प्रकृतिः सोभयात्मिका।\nज्ञानं त्वन्यतमो भागः पुरुषः सोऽभिधीयते॥ ११/२४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.005.m4a", "display_order": 6}, {"id": 6000325006, "chapter_id": 10325, "verse_number": "११-२४-५", "content_sanskrit": "तमो रजः सत्त्वमिति प्रकृतेरभवन् गुणाः।\nमया प्रक्षोभ्यमाणायाः पुरुषानुमतेन वा॥ ११/२४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.006.m4a", "display_order": 7, "topics": [{"text": "प्राधान्येन सृष्टिवर्णनम्", "range": "५–२०"}]}, {"id": 6000325007, "chapter_id": 10325, "verse_number": "११-२४-६", "content_sanskrit": "तेभ्यः समभवत् सूत्रं मत्सूत्रेण च संयुतम्।\nततो विकुर्वतो जातो योऽहंकारो विमोहकः॥ ११/२४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.007.m4a", "display_order": 8}, {"id": 6000325008, "chapter_id": 10325, "verse_number": "११-२४-७", "content_sanskrit": "वैकारिकस्तैजसश्च तामसश्चेत्यहं त्रिवृत्।\nतन्मात्रेन्द्रियमनसां कारणं चिदचिन्मयः॥ ११/२४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.008.m4a", "display_order": 9}, {"id": 6000325009, "chapter_id": 10325, "verse_number": "११-२४-८", "content_sanskrit": "अर्थस्तन्मात्रको जज्ञे तामसाद्, इन्द्रियाणि च।\nतैजसाद्, देवता आसन्नेकादश च वैकृतात्॥ ११/२४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.009.m4a", "display_order": 10}, {"id": 6000325010, "chapter_id": 10325, "verse_number": "११-२४-९", "content_sanskrit": "मया सञ्चोदिता भावाः सर्वे संहत्य कारिणः।\nअण्डमुत्पादयामासुर्ममायतनमुत्तमम्॥ ११/२४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.010.m4a", "display_order": 11}, {"id": 6000325011, "chapter_id": 10325, "verse_number": "११-२४-१०", "content_sanskrit": "तस्मिन्नहं समभवमण्डे सलिलसंस्थिते।\nमम नाभ्यामभूत् पद्मं विश्वाख्यं तत्र चात्मभूः॥ ११/२४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.011.m4a", "display_order": 12}, {"id": 6000325012, "chapter_id": 10325, "verse_number": "११-२४-११", "content_sanskrit": "सोऽसृजत् तपसा युक्तो रजसा मदनुग्रहात्।\nलोकान् सपालान् विश्वात्मा भूर्भुवःस्वरिति त्रिधा॥ ११/२४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.012.m4a", "display_order": 13}, {"id": 6000325013, "chapter_id": 10325, "verse_number": "११-२४-१२", "content_sanskrit": "देवानामोक आसीत् स्वर्भूतानां च भुवः पदम्।\nमर्त्यादीनां च भूर्लोकः सिद्धानां त्रितयात् परम्॥ ११/२४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.013.m4a", "display_order": 14}, {"id": 6000325014, "chapter_id": 10325, "verse_number": "११-२४-१३", "content_sanskrit": "अधोऽसुराणां नागानां भूमेरोकोऽसृजत् प्रभुः।\nत्रिलोक्यां गतयः सर्वाः कर्मणां त्रिगुणात्मनाम्॥ ११/२४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.014.m4a", "display_order": 15}, {"id": 6000325015, "chapter_id": 10325, "verse_number": "११-२४-१४", "content_sanskrit": "योगस्य तपसश्चैव ज्ञानस्य गतयोऽमलाः।\nमहर्जनस्तपः सत्यं भक्तियोगस्य मद्गतिः॥ ११/२४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.015.m4a", "display_order": 16}, {"id": 6000325016, "chapter_id": 10325, "verse_number": "११-२४-१५", "content_sanskrit": "मया कालात्मना धात्रा कर्मयुक्तमिदं जगत्।\nगुणप्रवाह एतस्मिन्नुन्मज्जति निमज्जति॥ ११/२४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.016.m4a", "display_order": 17}, {"id": 6000325017, "chapter_id": 10325, "verse_number": "११-२४-१६", "content_sanskrit": "अणुर्बृहत् कृशः स्थूलो यो यो भावः प्रसिध्यति।\nसर्वं ह्युभयसंयुक्तं प्रकृत्या पुरुषेण च॥ ११/२४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.017.m4a", "display_order": 18}, {"id": 6000325018, "chapter_id": 10325, "verse_number": "११-२४-१७", "content_sanskrit": "यस्तु यस्यादिरन्तश्च स वै मध्यं च तस्य तत्।\nविकारो व्यवहारार्थो यथा तैजसपार्थिवाः॥ ११/२४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.018.m4a", "display_order": 19}, {"id": 6000325019, "chapter_id": 10325, "verse_number": "११-२४-१८", "content_sanskrit": "यदुपादाय पूर्वस्तु भावो विकुरुते परम्।\nआदिरन्तो यतो यस्मिंस्तत् सत्यमभिधीयते॥ ११/२४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.019.m4a", "display_order": 20}, {"id": 6000325020, "chapter_id": 10325, "verse_number": "११-२४-१९", "content_sanskrit": "प्रकृतिर्ह्यस्योपादानमाधारः पुरुषः परः।\nसतोऽभिव्यञ्जकः कालो ब्रह्म तत् त्रितयं त्वहम्॥ ११/२४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.020.m4a", "display_order": 21}, {"id": 6000325021, "chapter_id": 10325, "verse_number": "११-२४-२०", "content_sanskrit": "सर्गः प्रवर्तते तावत् पौर्वापर्येण नित्यशः।\nमहान् गुणविसर्गोऽर्थः स्थित्यन्तो यावदीक्षणम्॥ ११/२४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.021.m4a", "display_order": 22}, {"id": 6000325022, "chapter_id": 10325, "verse_number": "११-२४-२१", "content_sanskrit": "विराण्मयाऽऽसाद्यमानो लोककल्पविकल्पकः।\nपञ्चत्वायाविशेषाय कल्पते भुवनैः सह॥ ११/२४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.022.m4a", "display_order": 23, "topics": [{"text": "लयकथनम्", "range": "२१–२८"}]}, {"id": 6000325023, "chapter_id": 10325, "verse_number": "११-२४-२२", "content_sanskrit": "अन्ने प्रलीयते मर्त्य अन्नं धानासु लीयते।\nधाना भूमौ प्रलीयन्ते भूमिर्गन्धे प्रलीयते॥ ११/२४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.023.m4a", "display_order": 24}, {"id": 6000325024, "chapter_id": 10325, "verse_number": "११-२४-२३", "content_sanskrit": "अप्सु प्रलीयते गन्ध आपश्च स्वगुणे रसे।\nलीयते ज्योतिषि रसो ज्योती रूपे प्रलीयते॥ ११/२४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.024.m4a", "display_order": 25}, {"id": 6000325025, "chapter_id": 10325, "verse_number": "११-२४-२४", "content_sanskrit": "रूपं वायौ स च स्पर्शे लीयते सोऽपि चाम्बरे।\nअम्बरं शब्दतन्मात्र इन्द्रियाणि स्वयोनिषु॥ ११/२४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.025.m4a", "display_order": 26}, {"id": 6000325026, "chapter_id": 10325, "verse_number": "११-२४-२५", "content_sanskrit": "योनिर्वैकारिके सौम्य लीयते महतीश्वरे।\nशब्दो भूतादिमप्येति भूतादिर्महति प्रभुः॥ ११/२४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.026.m4a", "display_order": 27}, {"id": 6000325027, "chapter_id": 10325, "verse_number": "११-२४-२६", "content_sanskrit": "स लीयते महान् स्वेषु गुणेषु गुणवत्तमः।\nतेऽव्यक्ते सम्प्रलीयन्ते तत् काले लीयतेऽव्यये॥ ११/२४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.027.m4a", "display_order": 28}, {"id": 6000325028, "chapter_id": 10325, "verse_number": "११-२४-२७", "content_sanskrit": "कालो मायामये जीवे जीव आत्मनि मय्यजे।\nआत्मा केवल आत्मस्थो विकल्पापायलक्षणः॥ ११/२४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.028.m4a", "display_order": 29}, {"id": 6000325029, "chapter_id": 10325, "verse_number": "११-२४-२८", "content_sanskrit": "एवमन्वीक्षमाणस्य कथं वैकल्पिको भ्रमः।\nमनसो हृदि तिष्ठेत व्योम्नीवार्कोदये तमः॥ ११/२४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_024/BhP_11.024.029.m4a", "display_order": 30}, {"id": 6000325030, "chapter_id": 10325, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे चतुर्विंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]