[{"id": 2150142, "chapter_id": 4255, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150143, "chapter_id": 4255, "verse_number": "१", "content_sanskrit": "ततो रात्र्यां व्यतीतायां प्रतिबुद्धोऽस्मि भारत ।\nततः सञ्चिन्त्य वै स्वप्नमवापं हर्षमुत्तमम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150144, "chapter_id": 4255, "verse_number": "२", "content_sanskrit": "ततः समभवद् युद्धं मम तस्य च भारत ।\nतुमुलं सर्वभूतानां लो(रो)महर्षणमद्भुतम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150145, "chapter_id": 4255, "verse_number": "३", "content_sanskrit": "ततो बाणमयं वर्षं ववर्ष मयि भार्गवः ।\nन्यवारयमहं तच्च शरजालेन भारत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150146, "chapter_id": 4255, "verse_number": "४", "content_sanskrit": "ततः परमसङ्क्रुद्धः पुनरेव महातपाः ।\nह्यस्तनेन च कोपेन शक्तिं वै प्राहिणोन्मयि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150147, "chapter_id": 4255, "verse_number": "५", "content_sanskrit": "इन्द्राशनिसमस्पर्शां यमदण्डोपमप्रभाम् ।\nज्वलन्तीमग्निवत् सङ्खे लेलिहानां समन्ततः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150148, "chapter_id": 4255, "verse_number": "६", "content_sanskrit": "ततो भरतशार्दूल धिष्ण्यमाकाशगं यथा ।\nसा मामभ्यवधीत् तूर्णमंसदेशे च भारत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150149, "chapter_id": 4255, "verse_number": "७", "content_sanskrit": "अथासृगस्रवद् घोरं गिरेर्गैरिकधातुवत् ।\nरामेण सुमहाबाहो क्षतस्य क्षतजोक्षणम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150150, "chapter_id": 4255, "verse_number": "८", "content_sanskrit": "ततोऽहं जामदग्न्याय भृशं क्रोधसमन्वितः ।\nप्रैषयं मृत्युसङ्काशं बाणं सर्पविषोपमम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150151, "chapter_id": 4255, "verse_number": "९", "content_sanskrit": "स तेनाभिहतो वीरो ललाटे द्विजसत्तमः ।\nअशोभत महाराज सशृङ्ग इव पर्वतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150152, "chapter_id": 4255, "verse_number": "१०", "content_sanskrit": "स संरब्धः समावृत्य शरं कालान्तकोपमम् ।\nसन्दधे बलवत् कृष्य घोरं शत्रुनिबर्हणम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150153, "chapter_id": 4255, "verse_number": "११", "content_sanskrit": "स वक्षसि पपातोग्रः शरो व्याल इव श्वसन् ।\nमहीं राजंस्ततश्चाहमगमं रुधिराविलः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150154, "chapter_id": 4255, "verse_number": "१२", "content_sanskrit": "सम्प्राप्य तु पुनः सञ्ज्ञां जामदग्न्याय धीमते ।\nप्राहिण्वं विमलां शक्तिं ज्वलन्तीमशनीमिव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150155, "chapter_id": 4255, "verse_number": "१३", "content_sanskrit": "सा तस्य द्विजमुख्यस्य निपपात भुजान्तरे ।\nविह्वलश्चाभवद् राजन् वेपथुश्चैनमाविशत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150156, "chapter_id": 4255, "verse_number": "१४", "content_sanskrit": "तत एनं परिष्वज्य सखा विप्रो महातपाः ।\nअकृतव्रणः शुभैर्वाक्यैराश्वासयदनेकधा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150157, "chapter_id": 4255, "verse_number": "१५", "content_sanskrit": "समाश्वस्तस्ततो रामः क्रोधामर्षसमन्वितः ।\nप्रादुश्चक्रे तदा ब्राह्मं परमास्त्रं महाव्रतः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150158, "chapter_id": 4255, "verse_number": "१६", "content_sanskrit": "ततस्तत्प्रतिघातार्थं ब्राह्ममेवास्त्रमुत्तमम् ।\nमया प्रयुक्तं जज्वाल युगान्तमिव दर्शयत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150159, "chapter_id": 4255, "verse_number": "१७", "content_sanskrit": "तयोर्ब्रह्मास्त्रयोरासीद् अन्तरा खे समागमः ।\nअसम्प्राप्यैव रामं च मां च भारतसत्तम\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150160, "chapter_id": 4255, "verse_number": "१८", "content_sanskrit": "ततो व्योम्नि प्रादुरभूत् तेज एव हि केवलम् ।\nभूतानि चैव सर्वाणि जग्मुरार्तिं विशाम्पते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150161, "chapter_id": 4255, "verse_number": "१९", "content_sanskrit": "ऋषयश्च सगन्धर्वा देवताश्चैव भारत ।\nसन्तापं परमं जग्मुरस्त्रतेजोभिपीडिताः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150162, "chapter_id": 4255, "verse_number": "२०", "content_sanskrit": "ततश्चचाल पृथिवी सपर्वतवनद्रुमा ।\nसन्तप्तानि च भूतानि विषादं जग्मुरुत्तमम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150163, "chapter_id": 4255, "verse_number": "२१", "content_sanskrit": "प्रजज्वाल नभो राजन् धूमायन्ते दिशो दश ।\nन स्थातुमन्तरिक्षे च शेकुराकाशगास्तदा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150164, "chapter_id": 4255, "verse_number": "२२", "content_sanskrit": "ततो हाहाकृते लोके सदेवासुरराक्षसे ।\nइदमन्तरमित्येव मोक्तुकामोऽस्मि भारत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150165, "chapter_id": 4255, "verse_number": "२३", "content_sanskrit": "प्रस्वापमस्त्रं दयितं वचनाद् ब्रह्मवादिनाम् ।\nचिन्तितं च तदाऽस्त्रं मे मनसा प्रत्यभात् तदा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150166, "chapter_id": 4255, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि षडशीत्युत्तरशततमोऽध्यायः ॥१८६॥\nअम्बोपाख्यानपर्वणि षोडशोऽध्यायः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]