[{"id": 2090585, "chapter_id": 2925, "verse_number": "१३-५५-१", "content_sanskrit": "`मार्कण्डेय उवाच।\nश्रुतं वर्णावरैर्दत्तं हव्यं कव्यं च नारद।\nसम्प्रयोगे च पुत्राणां कन्यानां च ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2090586, "chapter_id": 2925, "verse_number": "१३-५५-२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2090587, "chapter_id": 2925, "verse_number": "१३-५५-२", "content_sanskrit": "कन्याप्रदानं प्रत्राणां स्त्रीणां संयोगमेव च।\nआनुपूर्व्यान्मया सम्यगुच्यमानं निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2090588, "chapter_id": 2925, "verse_number": "१३-५५-३", "content_sanskrit": "जातमात्रा तु दातव्या कन्यका सदृशे वरे।\nकाले दत्तासु कन्यासु पिता धर्मेण युज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2090589, "chapter_id": 2925, "verse_number": "१३-५५-४", "content_sanskrit": "यस्तु पुष्पवतीं कन्यां बान्धवो न प्रयच्छति।\nमासिमासि गते बन्धुस्तस्या भ्रौणघ्न्यमाप्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2090590, "chapter_id": 2925, "verse_number": "१३-५५-५", "content_sanskrit": "यस्तु कन्यां गृहे रुन्ध्याद्ग्राम्यैर्भोगैर्विवर्जिताम्।\nअवध्यातः स कन्याया बन्धुः प्राप्नोति भ्रूणहाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2090591, "chapter_id": 2925, "verse_number": "१३-५५-६", "content_sanskrit": "दूषिता पाणिमात्रेण मृते भर्तरि दारिका।\nसंस्कारं लभते नारी द्वितीये सा पुनः पतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2090592, "chapter_id": 2925, "verse_number": "१३-५५-७", "content_sanskrit": "पुनर्भूर्नाम सा कन्या सपुत्रा हव्यकव्यदा।\nअदूष्या सा प्रसूतीषु प्रजानां दारकर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2090593, "chapter_id": 2925, "verse_number": "१३-५५-८x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2090594, "chapter_id": 2925, "verse_number": "१३-५५-८", "content_sanskrit": "या तु कन्या प्रसूयेत गर्भिणी या तु वा भवेत्।\nकथं दारक्रियां भूयः सा भवेदृषिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2090595, "chapter_id": 2925, "verse_number": "१३-५५-९x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2090596, "chapter_id": 2925, "verse_number": "१३-५५-९", "content_sanskrit": "तत्वार्थनिश्चितं शब्दं कन्यका नयतेऽग्नये।\nतस्मात्कुर्वन्ति वै भावं कुमार्यस्ता न कन्यकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2090597, "chapter_id": 2925, "verse_number": "१३-५५-१०", "content_sanskrit": "ब्रह्महत्यात्रिभागेन गर्भाधानविशोधितः।\nगृह्णीयात्तां चतुर्भागविशुद्धां सर्जनात्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2090598, "chapter_id": 2925, "verse_number": "१३-५५-११x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2090599, "chapter_id": 2925, "verse_number": "१३-५५-११", "content_sanskrit": "कथं कन्यासु ये जाता बन्धूनां दूषिताः सदा।\nकस्य ते हव्यकव्यानि प्रदास्यन्ति महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2090600, "chapter_id": 2925, "verse_number": "१३-५५-१२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2090601, "chapter_id": 2925, "verse_number": "१३-५५-१२", "content_sanskrit": "कन्यायास्तु पितुः पुत्राः कानीना हव्यकव्यदाः।\nअन्तर्वत्नयास्तु यः पाणिं गृह्णीयात्स सहोढजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2090602, "chapter_id": 2925, "verse_number": "१३-५५-१३x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2090603, "chapter_id": 2925, "verse_number": "१३-५५-१३", "content_sanskrit": "अथ येनाहितो गर्भः कन्यायां तत्र नारद।\nकथं पुत्रफलं तस्य भवेदेतत्प्रचक्ष्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2090604, "chapter_id": 2925, "verse_number": "१३-५५-१४x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2090605, "chapter_id": 2925, "verse_number": "१३-५५-१४", "content_sanskrit": "धर्माचारेषु ते नित्यं दूषकाः कृतशोधनाः।\nबीजं च नश्यते तेषां मोघचेष्टा भवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2090606, "chapter_id": 2925, "verse_number": "१३-५५-१५x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2090607, "chapter_id": 2925, "verse_number": "१३-५५-१५", "content_sanskrit": "अथ काचिद्भवेत्कन्या क्रीता दत्ता हृताऽपि वा।\nकथं पुत्रकृतं तस्यास्तद्भवेद्दषिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2090608, "chapter_id": 2925, "verse_number": "१३-५५-१६x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2090609, "chapter_id": 2925, "verse_number": "१३-५५-१६", "content_sanskrit": "क्रीता दत्ता हृता चैव या कन्या पाणिवर्जिता।\nकौमारी नाम सा भार्या प्रसवेदौरसान्सुतान्।\nन पत्न्यर्थे शुभा प्रोक्ता तत्कर्मण्यपराजिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2090610, "chapter_id": 2925, "verse_number": "१३-५५-१७x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2090611, "chapter_id": 2925, "verse_number": "१३-५५-१७", "content_sanskrit": "केन मङ्गलकृत्येषु विनियुज्यन्ति कन्यकाः।\nएतदिच्छामि विज्ञातुं तत्वेनेह महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2090612, "chapter_id": 2925, "verse_number": "१३-५५-१८x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2090613, "chapter_id": 2925, "verse_number": "१३-५५-१८", "content_sanskrit": "नित्यं निवसते लक्ष्मीः कन्यकासु प्रतिष्ठिता।\nशोभना शुभयोग्या च पूज्या मङ्गलकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2090614, "chapter_id": 2925, "verse_number": "१३-५५-१९", "content_sanskrit": "आकरस्थं यथा रत्नं सर्वकामफलोपगम्।\nतथा कन्या महालक्ष्मीः सर्वलोकस्य मङ्गलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2090615, "chapter_id": 2925, "verse_number": "१३-५५-२०", "content_sanskrit": "एवं कन्या परा लक्ष्मी रतिस्तोषश्च देहिनाम्।\nमहाकुलानां चारित्रवृत्तेन निकषोपलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2090616, "chapter_id": 2925, "verse_number": "१३-५५-२१", "content_sanskrit": "आनयित्वा स्वकाद्वर्णात्कन्यकां यो भजेन्नरः।\nदातारं हव्यकव्यानां पुत्रकं या प्रसूयति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2090617, "chapter_id": 2925, "verse_number": "१३-५५-२२", "content_sanskrit": "साध्वी कुलं वर्धयति साध्वी पुष्टिग्रहे परा।\nसाध्वी लक्ष्मी रतिः साक्षात्प्रतिष्ठा सन्ततिस्तथा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2090618, "chapter_id": 2925, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चपञ्चाशोऽध्यायः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]