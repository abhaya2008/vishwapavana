[{"id": 6000031000, "chapter_id": 10031, "verse_number": null, "content_sanskrit": "भगवद्बादरायणप्रणीतं श्रीमद्भागवतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000031001, "chapter_id": 10031, "verse_number": null, "content_sanskrit": "अथ प्रथमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 6000031002, "chapter_id": 10031, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.001.m4a", "display_order": 3}, {"id": 6000031003, "chapter_id": 10031, "verse_number": "३-१-१", "content_sanskrit": "एवमेतत् पुरा पृष्टो मैत्रेयो भगवान् किल।\nक्षत्त्रा वनं प्रविष्टेन त्यक्त्वा स्वगृहमृद्धिमत्॥ ३/१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.002.m4a", "display_order": 4}, {"id": 6000031004, "chapter_id": 10031, "verse_number": "३-१-२", "content_sanskrit": "यदा त्वयं मन्त्रकृद् वो भगवानखिलेश्वरः।\nपौरवेन्द्रपुरं हित्वा प्रविवेशाऽत्मसात्कृतम्॥ ३/१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.003.m4a", "display_order": 5}, {"id": 6000031005, "chapter_id": 10031, "verse_number": null, "content_sanskrit": "परीक्षिदुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.004.m4a", "display_order": 6}, {"id": 6000031006, "chapter_id": 10031, "verse_number": "३-१-३", "content_sanskrit": "कुत्र क्षत्तुर्भगवता मैत्रेयेणास सङ्गमः।\nकदा वा सह संवाद एतद् वर्णय नः प्रभो॥ ३/१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.005.m4a", "display_order": 7}, {"id": 6000031007, "chapter_id": 10031, "verse_number": "३-१-४", "content_sanskrit": "न ह्यल्पार्थोदयस्तस्य विदुरस्यामलात्मनः।\nतस्मिन् वरीयसि प्रश्नः साधुवादोपबृंहितः॥ ३/१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.006.m4a", "display_order": 8}, {"id": 6000031008, "chapter_id": 10031, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.007.m4a", "display_order": 9}, {"id": 6000031009, "chapter_id": 10031, "verse_number": "३-१-५", "content_sanskrit": "स एवमृषिवर्योऽयं पृष्टो राज्ञा परीक्षिता।\nप्रत्याह तं सुबहुवित् प्रीतात्मा श्रूयतामिति॥ ३/१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.008.m4a", "display_order": 10}, {"id": 6000031010, "chapter_id": 10031, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.009.m4a", "display_order": 11}, {"id": 6000031011, "chapter_id": 10031, "verse_number": "३-१-६", "content_sanskrit": "यदा तु राजा स्वसुतानसाधून् पुष्णन्नधर्मेण विनष्टदृष्टिः।\nभ्रातुर्यविष्ठस्य सुतान् विबन्धून् प्रवेश्य लाक्षाभवने ददाह॥ ३/१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.010.m4a", "display_order": 12, "topics": [{"text": "पूर्ववृत्तान्तपरामर्शेन सह विदुरेण धृतराष्ट्रं प्रति धर्मबिधनम्", "range": "६–१३"}]}, {"id": 6000031012, "chapter_id": 10031, "verse_number": "३-१-७", "content_sanskrit": "यदा सभायां कुरुदेवदेव्याः केशाभिमर्शं सुतकर्म गर्ह्यम्।\nन वारयामास नृपः स्नुषाया अस्रैर्हरन्त्याः कुचकुङ्कुमानि॥ ३/१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.011.m4a", "display_order": 13}, {"id": 6000031013, "chapter_id": 10031, "verse_number": "३-१-८", "content_sanskrit": "द्यूते त्वधर्मेण जितस्य साधोः सत्यावलम्बस्य वनागतस्य।\nन याचितोऽदात् समयेन दायं तमोजुषाणो यदजातशत्रोः॥ ३/१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.012.m4a", "display_order": 14}, {"id": 6000031014, "chapter_id": 10031, "verse_number": "३-१-९", "content_sanskrit": "यदा तु पार्थप्रहितः सभायां जगद्गुरुर्यानि जगाद कृष्णः।\nन तानि पुंसाममृतायनानि राजाऽनुमेने हतपुण्यलेशः॥ ३/१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.013.m4a", "display_order": 15}, {"id": 6000031015, "chapter_id": 10031, "verse_number": "३-१-१०", "content_sanskrit": "यदोपहूतो भवनं प्रविष्टो मन्त्राय पृष्टः किल पूर्वजेन।\nअथाह तं मन्त्रदृशां वरीयान् यन्मन्त्रिणो वैदुरिकं वदन्ति॥ ३/१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.014.m4a", "display_order": 16}, {"id": 6000031016, "chapter_id": 10031, "verse_number": "३-१-११", "content_sanskrit": "अजातशत्रोः प्रतियच्छ दायं तितिक्षतो दुर्विषहं तवागः।\nसहानुजो यत्र वृकोदरो हि स्वशत्रुहा यं त्वमलं बिभेषि॥ ३/१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.015.m4a", "display_order": 17}, {"id": 6000031017, "chapter_id": 10031, "verse_number": "३-१-१२", "content_sanskrit": "यदा तु पार्थान् भगवान् मुकुन्दो गृहीतवान् स क्षितिदेवदेवः।\nआस्ते स्वपुर्यां यदुदेवदेवो विनिर्जिताशेषनृदेवदेवः॥ ३/१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.016.m4a", "display_order": 18}, {"id": 6000031018, "chapter_id": 10031, "verse_number": "३-१-१३", "content_sanskrit": "स एष दोषः पुरुषद्विडास्ते गृहं प्रविष्टो यमपत्यमत्या।\nपुष्णासि कृष्णाद् विमुखो गतश्रीस्त्यजाश्वथैनं कुलकौशलाय॥ ३/१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.017.m4a", "display_order": 19}, {"id": 6000031019, "chapter_id": 10031, "verse_number": "३-१-१४", "content_sanskrit": "इत्यूचिवांस्तत्र सुयोधनेन प्रवृद्धकोपस्फुरिताधरेण।\nअसत्कृतः सत्स्पृहणीयशीलः क्षत्ता सकर्णानुजसौबलेन॥ ३/१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.018.m4a", "display_order": 20, "topics": [{"text": "दुर्योधनासत्कृतेन विदुरेण तीर्थयात्रार्थं प्रभासक्षेत्रगमनम्", "range": "१४–२३"}]}, {"id": 6000031020, "chapter_id": 10031, "verse_number": "३-१-१५", "content_sanskrit": "क एनमत्रोपजुहाव जिह्मं दास्याः सुतं यद्बलिनैव पुष्टः।\nतस्मिन् प्रतीपः परकृत्य आस्ते निर्वास्यतामाशु पुराच्छ्वसानः॥ ३/१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.019.m4a", "display_order": 21}, {"id": 6000031021, "chapter_id": 10031, "verse_number": "३-१-१६", "content_sanskrit": "स इत्थमत्युल्बणकर्णबाणैर्भ्रातुः पुरो मर्मसु ताडितोऽपि।\nस्मयन् धनुर्द्वारि निधाय मायां गतव्यथोऽयादुरु मानयानः॥ ३/१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.020.m4a", "display_order": 22}, {"id": 6000031022, "chapter_id": 10031, "verse_number": "३-१-१७", "content_sanskrit": "स निर्गतः कौरवपुण्यलब्धगजाह्वयात् तीर्थपदः पदानि।\nअन्वाक्रमत् पुण्यचिकीर्षयोर्व्यामधिष्ठितो यानि सहस्रमूर्तिः॥ ३/१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.021.m4a", "display_order": 23}, {"id": 6000031023, "chapter_id": 10031, "verse_number": "३-१-१८", "content_sanskrit": "वनेषु पुण्योपवनाद्रिकुञ्जेष्वपङ्कतोयेषु सरित्सरस्सु।\nअनन्तलिङ्गैः समलङ्कृतेषु चचार तीर्थायतनेष्वनन्यः॥ ३/१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.022.m4a", "display_order": 24}, {"id": 6000031024, "chapter_id": 10031, "verse_number": "३-१-१९", "content_sanskrit": "गां पर्यटन् मेध्यविविक्तवृत्तिः सदाऽऽप्लुतोऽधःशयनावधूतः।\nअलक्षितः स्वैरवधूतकेशो व्रतानि चेरे हरितोषणानि॥ ३/१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.023.m4a", "display_order": 25}, {"id": 6000031025, "chapter_id": 10031, "verse_number": "३-१-२०", "content_sanskrit": "इत्थं व्रजन् भारतमेव वर्षं कालेन यावद् गतवान् प्रभासम्।\nतावच्छशास क्षितिमेकचक्रामेकातपत्रामजितेन पार्थः॥ ३/१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.024.m4a", "display_order": 26}, {"id": 6000031026, "chapter_id": 10031, "verse_number": "३-१-२१", "content_sanskrit": "तत्राथ शुश्राव सुहृद्विनष्टिं वनं यथा वेणुजं वह्निनाऽऽश्रयम्।\nसंस्पर्धया दग्धमथानुशोचन् सरस्वतीं प्रत्यगियाय तूष्णीम्॥ ३/१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.025.m4a", "display_order": 27}, {"id": 6000031027, "chapter_id": 10031, "verse_number": "३-१-२२", "content_sanskrit": "तस्यां त्रितस्योशनसो मनोश्च पृथोरथाग्नेरसितस्य वायोः।\nतीर्थं सुदासस्य गवां गुहस्य यच्छ्राद्धदेवस्य स आसिषेवे॥ ३/१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.026.m4a", "display_order": 28}, {"id": 6000031028, "chapter_id": 10031, "verse_number": "३-१-२३", "content_sanskrit": "अन्यानि चेह द्विजदेवदेवैः कृतानि नानायतनानि विष्णोः।\nप्रत्यङ्कमुख्याङ्कितमन्दिराणि यद्दर्शनात् कृष्णमनुस्मरन्ति॥ ३/१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.027.m4a", "display_order": 29}, {"id": 6000031029, "chapter_id": 10031, "verse_number": "३-१-२४", "content_sanskrit": "ततस्त्वतिव्रज्य सुराष्ट्रमृद्धं सौवीरमत्स्यान् कुरुजाङ्गलांश्च।\nकालेन तावद् यमुनामुपेत्य तत्रोद्धवं भागवतं ददर्श॥ ३/१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.028.m4a", "display_order": 30, "topics": [{"text": "ततो यमुनां गतस्य तस्य तत्र उद्धवस्य दर्शनम्", "range": "२४"}]}, {"id": 6000031030, "chapter_id": 10031, "verse_number": "३-१-२५", "content_sanskrit": "स वासुदेवानुचरं प्रशान्तं बृहस्पतेः प्राप्तनयं प्रतीतम्।\nआलिङ्ग्य गाढं प्रणयेन भद्रं स्वानामपृच्छद् भगवत्प्रजानाम्॥ ३/१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.029.m4a", "display_order": 31, "topics": [{"text": "विदुरेण तं प्रति द्वारकाजनकुशलप्रश्नः", "range": "२५–४५"}]}, {"id": 6000031031, "chapter_id": 10031, "verse_number": "३-१-२६", "content_sanskrit": "कच्चित् पुराणौ पुरुषौ स्वनाभ्यपद्मानुवृत्त्येह कलावतीर्णौ।\nआसात उर्व्याः कुशलं विधाय कृतक्षणौ कुशलं शूरगेहे॥ ३/१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.030.m4a", "display_order": 32}, {"id": 6000031032, "chapter_id": 10031, "verse_number": "३-१-२७", "content_sanskrit": "कच्चित् कुरूणां परमः सुहृन्नो भामः स आस्ते सुखमङ्ग शौरिः।\nयो वै स्वसॄणां पितृवद् ददाति वरान् वदान्यो वरतर्पणेन॥ ३/१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.031.m4a", "display_order": 33}, {"id": 6000031033, "chapter_id": 10031, "verse_number": "३-१-२८", "content_sanskrit": "कच्चिद् वरूथाधिपतिर्यदूनां प्रद्युम्न आस्ते सुखमङ्ग वीरः।\nयं रुक्मिणी भगवतोऽभिलेभे आराध्य विप्रान् स्मरमादिसर्गे॥ ३/१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.032.m4a", "display_order": 34}, {"id": 6000031034, "chapter_id": 10031, "verse_number": "३-१-२९", "content_sanskrit": "कच्चित् सुखं सात्वतवृष्णिभोजदाशार्हकाणामधिपः स आस्ते।\nयमभ्यषिञ्चच्छतपत्रनेत्रो नृपासनाधिं परिहृत्य दूरात्॥ ३/१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.033.m4a", "display_order": 35}, {"id": 6000031035, "chapter_id": 10031, "verse_number": "३-१-३०", "content_sanskrit": "कच्चिद्धरेः सौम्यसुतः सदृक्ष आस्तेऽग्रणी रथिनां साधु साम्बः।\nअसूत यं जाम्बवती व्रताढ्या देवं गुहं योऽम्बिकया धृतोऽग्रे॥ ३/१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.034.m4a", "display_order": 36}, {"id": 6000031036, "chapter_id": 10031, "verse_number": "३-१-३१", "content_sanskrit": "क्षेमं स कच्चिद् युयुधान आस्ते यः फल्गुनाल्लब्धधनूरहस्यः।\nलेभेऽञ्जसाऽधोक्षजसेवयैव गतिं तदीयां यतिभिर्दुरापाम्॥ ३/१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.035.m4a", "display_order": 37}, {"id": 6000031037, "chapter_id": 10031, "verse_number": "३-१-३२", "content_sanskrit": "कच्चिद् बुधः स्वस्त्यनमीव आस्ते श्वफल्कपुत्रो भगवत्प्रपन्नः।\nयः कृष्णपादाङ्कितमार्गपांसुष्वचेष्टत प्रेमविभिन्नधैर्यः॥ ३/१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.036.m4a", "display_order": 38}, {"id": 6000031038, "chapter_id": 10031, "verse_number": "३-१-३३", "content_sanskrit": "कच्चिच्छिवं देवकभोजपुत्र्या विष्णुप्रजाया इव देवमातुः।\nया वै स्वगर्भेण बभार देवं त्रयी यथा यज्ञवितानमर्थम्॥ ३/१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.037.m4a", "display_order": 39}, {"id": 6000031039, "chapter_id": 10031, "verse_number": "३-१-३४", "content_sanskrit": "अपिस्विदास्ते भगवान् सुखं वा यः सात्वतां कामदुघोऽनिरुद्धः।\nयमामनन्ति स्म हि शब्दयोनिं मनोमयं सत्वतुरीयमर्थम्॥ ३/१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.038.m4a", "display_order": 40}, {"id": 6000031040, "chapter_id": 10031, "verse_number": "३-१-३५", "content_sanskrit": "अपिस्विदन्ये च निजात्मदैवमनन्यवृत्त्या समनुव्रता ये।\nहार्दिक्यसत्यात्मजचारुदेष्णगदादयः स्वस्ति चरन्ति सौम्य॥ ३/१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.039.m4a", "display_order": 41}, {"id": 6000031041, "chapter_id": 10031, "verse_number": "३-१-३६", "content_sanskrit": "अपि स्वदोर्भ्यां विजयाच्युताभ्यां धर्मेण धर्मः परिपाति सेतुम्।\nदुर्योधनोऽतप्यत यत्सभायां साम्राज्यलक्ष्म्या विजयानुवृत्त्या॥ ३/१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.040.m4a", "display_order": 42}, {"id": 6000031042, "chapter_id": 10031, "verse_number": "३-१-३७", "content_sanskrit": "किं वा कृताघेष्वघमत्यमर्षी भीमोऽहिवद् दीर्घतमं व्यमुञ्चत्।\nयस्याङ्घ्रिपातं रणभूर्न सेहे मार्गं गदायाश्चरतो विचित्रम्॥ ३/१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.041.m4a", "display_order": 43}, {"id": 6000031043, "chapter_id": 10031, "verse_number": "३-१-३८", "content_sanskrit": "कच्चिद् यशोधा रथयूथपानां गाण्डीवधन्वोपरतारिरास्ते।\nअलक्षितो यच्छरकूटगूढो मायाकिरातो गिरिशस्तुतोष॥ ३/१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.042.m4a", "display_order": 44}, {"id": 6000031044, "chapter_id": 10031, "verse_number": "३-१-३९", "content_sanskrit": "यमावुतस्वित् तनयौ च माद्र्याः पार्थैर्वृतौ पक्ष्मभिरक्षिणीव।\nरेमात उद्धृत्य मृधे स्वरिक्थं सुधां सुपर्णाविव वज्रिवक्त्रात्॥ ३/१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.043.m4a", "display_order": 45}, {"id": 6000031045, "chapter_id": 10031, "verse_number": "३-१-४०", "content_sanskrit": "अहो पृथापि ध्रियतेऽर्भकार्थे राजर्षिवर्येण विनाऽपि तेन।\nयस्त्वेकवीरोऽतिरथो विजिग्ये धनुर्द्वितीयः ककुभश्चतस्रः॥ ३/१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.044.m4a", "display_order": 46}, {"id": 6000031046, "chapter_id": 10031, "verse_number": "३-१-४१", "content_sanskrit": "सोम्यानुशोचे तमधःपतन्तं भ्रात्रे परेताय विदुद्रुहे यः।\nनिर्यापितो येन सुहृत् स्वपुर्या अहं स्वपुत्रान् समनुव्रतेन॥ ३/१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.045.m4a", "display_order": 47}, {"id": 6000031047, "chapter_id": 10031, "verse_number": "३-१-४२", "content_sanskrit": "सोऽहं हरेर्मर्त्यविडम्बनेन दृशो नृणां चालयतो विधातुः।\nनान्योपलक्ष्यः पदवीं प्रसादाच्चरामि पश्यन् गतविस्मयोऽत्र॥ ३/१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.046.m4a", "display_order": 48}, {"id": 6000031048, "chapter_id": 10031, "verse_number": "३-१-४३", "content_sanskrit": "नूनं नृपाणां त्रिमदोत्पथानां महीं मुहुश्चालयतां चमूभिः।\nवधात् प्रपन्नार्तिजिहीर्षयेशो ह्युपैक्षताघं भगवान् कुरूणाम्॥ ३/१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.047.m4a", "display_order": 49}, {"id": 6000031049, "chapter_id": 10031, "verse_number": "३-१-४४", "content_sanskrit": "अजस्य जन्मोत्पथनाशनाय कर्माण्यकर्तुर्ग्रहणाय पुंसाम्।\nन त्वन्यथा कोऽर्हति देहयोगं परो गुणानामुत कर्मतन्त्रम्॥ ३/१/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.048.m4a", "display_order": 50}, {"id": 6000031050, "chapter_id": 10031, "verse_number": "३-१-४५", "content_sanskrit": "तस्य प्रपन्नाखिललोकपानाम् अवस्थितानाम् अनुशासने स्वे।\nअर्थाय जातस्य यदुष्वजस्य वार्तां सखे कीर्तय तीर्थकीर्तेः॥ ३/१/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_001/BhP_03.001.049.m4a", "display_order": 51}, {"id": 6000031051, "chapter_id": 10031, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे प्रथमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]