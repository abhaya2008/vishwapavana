[{"id": 7006517000, "chapter_id": 26517, "verse_number": "३-५६-१", "content_sanskrit": "देवदानवानां घोरसंग्रामम् – विरोचनस्य विष्वक्सेनेन सह, कुजम्भस्य अंशदेवेन सह युद्धकाले घोरपराक्रमस्य प्रदर्शनम् वैशम्पायन उवाच तस्मिन् महाहवे रौद्रे तुमुले लोमहर्षणे ।\nववर्षुः शरवर्षाणि संरब्धा देवदानवाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006517001, "chapter_id": 26517, "verse_number": "३-५६-२", "content_sanskrit": "व्याक्रोशन्त गजास्तत्र शरघातप्रपीडिताः ।\nअश्वाश्च पर्यधावन्त हतारोहा दिशो दश ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006517002, "chapter_id": 26517, "verse_number": "३-५६-३", "content_sanskrit": "उत्पत्य निपतन्त्यन्ये शरवर्षप्रपीडिताः ।\nदेवानां दानवानां च गजाश्वरथिनां रणे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006517003, "chapter_id": 26517, "verse_number": "३-५६-४", "content_sanskrit": "समरे तत्र शूराणामन्योन्यमभिधावताम् ।\nधनुर्ज्यातलशब्देन न प्राज्ञायत किंचन ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006517004, "chapter_id": 26517, "verse_number": "३-५६-५", "content_sanskrit": "शरशक्तिगदाभिस्ते खड्गैश्चामिततेजसः ।\nनिजघ्नुर्महतीं सेनामन्योन्यस्य परंतप ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006517005, "chapter_id": 26517, "verse_number": "३-५६-६", "content_sanskrit": "बाहूनामुत्तमाङ्गानां कार्मुकाणां च संयुगे ।\nराशयस्तत्र दृश्यन्ते देवदैत्यसमागमे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006517006, "chapter_id": 26517, "verse_number": "३-५६-७", "content_sanskrit": "अश्वानां कुञ्जराणां च रथानां च वरूथिनाम् ।\nनान्तं समभिगच्छन्ति निहतानां सुरासुरैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006517007, "chapter_id": 26517, "verse_number": "३-५६-८", "content_sanskrit": "गदाभिरसिभिः प्रासैर्भल्लैः संनतपर्वभिः ।\nयोधास्तत्राभ्यहन्यन्त हस्त्यश्वं चामितं बहु ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006517008, "chapter_id": 26517, "verse_number": "३-५६-९", "content_sanskrit": "प्रावर्तत नदी घोरा शोणितौघा तरङ्गिणी ।\nतदा मध्ये तु सैन्यानां केशशैवलशाद्वला ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006517009, "chapter_id": 26517, "verse_number": "३-५६-१०", "content_sanskrit": "हाहाकारो महाशब्दो योधानामभवत् तदा ।\nदानवैर्हन्यमानानां त्रिदशानां महारणे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006517010, "chapter_id": 26517, "verse_number": "३-५६-११", "content_sanskrit": "वैशम्पायन उवाच तेषां तदभवद् युद्धं देवानामसुरैः सह ।\nविभीषणं महारौद्रं विकृतं भीमदर्शनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006517011, "chapter_id": 26517, "verse_number": "३-५६-१२", "content_sanskrit": "विरोचनस्तु तत्रैव विष्वक्सेनं महाहवे ।\nजघान रुधिराभाक्षं साध्यं परमधन्विनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006517012, "chapter_id": 26517, "verse_number": "३-५६-१३", "content_sanskrit": "तमायान्तमभिप्रेक्ष्य विष्वक्सेनः सुरैर्वृतः ।\nअमेयात्मा सुरश्रेष्ठः प्रत्यविध्यत् स्तनान्तरे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006517013, "chapter_id": 26517, "verse_number": "३-५६-१४", "content_sanskrit": "साध्यस्य बाणाभिहतस्तोत्रार्पित इव द्विपः ।\nविरोचनः प्रजज्वाल क्रोधेनाग्निरिवाध्वरे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006517014, "chapter_id": 26517, "verse_number": "३-५६-१५", "content_sanskrit": "स कार्मुकविनिर्मुक्तैः शरैर्दानवसत्तमः ।\nविष्वक्सेनं बिभेदाजौ दीप्तैः सप्तभिराशुगैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006517015, "chapter_id": 26517, "verse_number": "३-५६-१६", "content_sanskrit": "सोऽतिविद्धो बलवता दानवेन सुरोत्तमः ।\nमूर्च्छामभिजगामाशु ध्वजं चाप्याश्रयत्प्रभुः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006517016, "chapter_id": 26517, "verse_number": "३-५६-१७", "content_sanskrit": "ततः स पुनराश्वस्य साध्यो युद्धे मनो दधे ।\nविस्फार्य च महाचापं दैत्यमध्ये व्यवस्थितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006517017, "chapter_id": 26517, "verse_number": "३-५६-१८", "content_sanskrit": "विरोचनस्तु बलवानभ्ययुध्यत सर्वशः ।\nक्षोभयन् सुरसैन्यानि समन्तान्निशितैः शरैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006517018, "chapter_id": 26517, "verse_number": "३-५६-१९", "content_sanskrit": "ततस्तस्यासुरेन्द्रस्य युद्ध्यमानस्य संयुगे ।\nश्रूयते तुमुलः शब्दो जीमूतस्येव गर्जतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006517019, "chapter_id": 26517, "verse_number": "३-५६-२०", "content_sanskrit": "जगर्ज च महाघोषो विनिघ्नन् देववाहिनीम् ।\nचण्डवेगाश्मवर्षी च सविद्युत्स्तनयित्नुमान् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006517020, "chapter_id": 26517, "verse_number": "३-५६-२१", "content_sanskrit": "दिशो विद्रावयामास शरवर्षेण दानवः ।\nसर्वसैन्यानि देवानामुद्यतास्त्रो महाहवे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006517021, "chapter_id": 26517, "verse_number": "३-५६-२२", "content_sanskrit": "ते प्राद्रवन्त वित्रस्ता रथेभ्यो रथिनस्तदा ।\nसादिनश्चाश्वपृष्ठेभ्यो भूमौ चापि पदातयः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006517022, "chapter_id": 26517, "verse_number": "३-५६-२३", "content_sanskrit": "श्रुत्वा कार्मुकनिर्घोषं विस्फूर्जितमिवाशनेः ।\nसर्वसैन्यानि भीतानि निव्यलीयन्त संयुगे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006517023, "chapter_id": 26517, "verse_number": "३-५६-२४", "content_sanskrit": "विरोचनभयत्रस्ता रथेभ्यो रथिनस्तदा ।\nपदातीनां ययुः संघा यत्र देवः शचीपतिः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006517024, "chapter_id": 26517, "verse_number": "३-५६-२५", "content_sanskrit": "विष्वक्सेनस्य साध्यस्य सर्वतः सुमहाबलः ।\nपदा रक्षःसहस्राणि निजघान चतुर्दश ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006517025, "chapter_id": 26517, "verse_number": "३-५६-२६", "content_sanskrit": "अश्ववृन्देषु नागेषु रथानीकेषु चाभिभूः ।\nपदातीनां च संघेषु विनिघ्नन् प्रत्यदृश्यत ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006517026, "chapter_id": 26517, "verse_number": "३-५६-२७", "content_sanskrit": "वितत्य श्येनवत् पक्षौ सर्वतः स वरूथिनीम् ।\nभित्त्वा छित्त्वा महाबाहुः शिरांस्याजौ ह्यकृन्तत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006517027, "chapter_id": 26517, "verse_number": "३-५६-२८", "content_sanskrit": "सादिनश्च पदाताश्च हतशेषा रथास्तथा ।\nविष्वक्सेनेन सहिता विरोचनमथाद्रवन् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006517028, "chapter_id": 26517, "verse_number": "३-५६-२९", "content_sanskrit": "तेऽसिचर्मगदाशक्तिपरिघप्रासतोमरैः ।\nतमेकमभ्यधावन्त सिंहनादं प्रचक्रिरे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006517029, "chapter_id": 26517, "verse_number": "३-५६-३०", "content_sanskrit": "ततः सोऽसिं समुद्यम्य जवमास्थाय दानवः ।\nवकर्त रथिनामाजौ शिरांसि च धनूंषि च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006517030, "chapter_id": 26517, "verse_number": "३-५६-३१", "content_sanskrit": "रथनागाश्ववृन्देषु बलवानरिसूदनः ।\nविरोचनश्चरन् मार्गान् प्रकारानेकविंशतिम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006517031, "chapter_id": 26517, "verse_number": "३-५६-३२", "content_sanskrit": "भ्रान्तमुद्भ्रान्तमाविद्धमाप्लुतं विप्लुतं प्लुतम् ।\nसम्पातं समुदीर्णं च दर्शयामास दानवः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006517032, "chapter_id": 26517, "verse_number": "३-५६-३३", "content_sanskrit": "केचिद् वरासिना रुग्णा दानवेन महात्मना ।\nविनेदुश्छिन्नवर्माणो निपेतुश्च गतासवः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006517033, "chapter_id": 26517, "verse_number": "३-५६-३४", "content_sanskrit": "छिन्नपृष्ठा हतारोहा दानवेन महात्मना ।\nविद्रुताः स्वान्यनीकानि जघ्नुस्त्रिदशवारणाः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006517034, "chapter_id": 26517, "verse_number": "३-५६-३५", "content_sanskrit": "निपेतुरुर्व्यामाकाशे निकृता दृढधन्विना ।\nविविधास्तोमराश्चापा महामात्रशिरांसि च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006517035, "chapter_id": 26517, "verse_number": "३-५६-३६", "content_sanskrit": "प्रतीपमाहरन्नागानश्वांश्च दृढविक्रमान् ।\nचकर्त रथिनः कांश्चित् परामृश्य महाबलः ।\nसूतांश्चिच्छेद खड्गेन रथानपि च दानवः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006517036, "chapter_id": 26517, "verse_number": "३-५६-३७", "content_sanskrit": "मुहुरुत्पततो दिक्षु धावतश्च यशस्विनः ।\nमार्गांश्चरति वैचित्रान् व्यस्मयन्त ततोऽसुराः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006517037, "chapter_id": 26517, "verse_number": "३-५६-३८", "content_sanskrit": "निजघान पदा काश्चिदाक्षिप्यान्यानपोथयत् ।\nखड्गेन चान्यांश्चिच्छेद नादेनान्यांश्च भीषयन् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006517038, "chapter_id": 26517, "verse_number": "३-५६-३९", "content_sanskrit": "ऊरुस्तम्भगृहीताश्च निपतन्त्यपरे भुवि ।\nअपरे दैत्यमालोक्य भयात्प्राणानवासृजन् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006517039, "chapter_id": 26517, "verse_number": "३-५६-४०", "content_sanskrit": "तस्मिंस्तथा वर्तमाने युद्धे महति दारुणे ।\nरथौघगजपत्तीनां सुराणां च महाक्षये ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006517040, "chapter_id": 26517, "verse_number": "३-५६-४१", "content_sanskrit": "कुजम्भो दानवश्रेष्ठो ह्यंशमादित्यमाहवे ।\nयोधयामास समरे वृषः प्रतिवृषं यथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006517041, "chapter_id": 26517, "verse_number": "३-५६-४२", "content_sanskrit": "जघानाचलसंकाशो मत्तवारणविक्रमः ।\nस्फुरद्भिर्निशितैस्तीक्ष्णशरैर्बहुभिराशुगैः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006517042, "chapter_id": 26517, "verse_number": "३-५६-४३", "content_sanskrit": "देवसैन्यसहस्राणि सरथानि महाहवे ।\nतस्य बाणपथं प्राप्य नाभ्यवर्तन्त सर्वशः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006517043, "chapter_id": 26517, "verse_number": "३-५६-४४", "content_sanskrit": "प्रणेदुः सर्वभूतानि बभूवुस्तिमिरा दिशः ।\nदेवानामजयः क्रूरः प्रत्यपद्यत दारुणः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006517044, "chapter_id": 26517, "verse_number": "३-५६-४५", "content_sanskrit": "अंशस्तु दानवेन्द्रस्य जघानोत्तमविक्रमः ।\nअनीकं दशसाहस्रं कुञ्जराणां तरस्विनाम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006517045, "chapter_id": 26517, "verse_number": "३-५६-४६", "content_sanskrit": "आपतन्तं गजानीकं कुजम्भो वीक्ष्य दानवः ।\nगदापाणिरवारोहद् रथोपस्थादरिंदमः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006517046, "chapter_id": 26517, "verse_number": "३-५६-४७", "content_sanskrit": "अद्रिसारमयीं गुर्वीं प्रगृह्य महतीं गदाम् ।\nअभ्यद्रवद् गजानीकं व्यादितास्य इवान्तकः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006517047, "chapter_id": 26517, "verse_number": "३-५६-४८", "content_sanskrit": "स गजान् गदया निघ्नन् व्यचरत्समरे बली ।\nकुजम्भो दानवश्रेष्ठो गदापाणिर्बलाधिकः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006517048, "chapter_id": 26517, "verse_number": "३-५६-४९", "content_sanskrit": "विशीर्णदन्तांश्च वद्वन्भिन्नकुम्भाम्बदारुणान् ।\nअकरोद् दानवश्रेष्ठ उद्दिश्योद्दिश्य तान् बली ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006517049, "chapter_id": 26517, "verse_number": "३-५६-५०", "content_sanskrit": "विशीर्णदन्ता बहवो भिन्नकुम्भास्तथा परे ।\nकुजम्भेनार्दिता नागा व्यद्रवन्त दिशो दश ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006517050, "chapter_id": 26517, "verse_number": "३-५६-५१", "content_sanskrit": "कुजम्भस्य च येऽमात्या दानवा घोरविक्रमाः ।\nनाराचैर्विविधैस्तीक्ष्णैरपास्तगजयोधिनः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006517051, "chapter_id": 26517, "verse_number": "३-५६-५२", "content_sanskrit": "क्षुरैः क्षुरप्रैर्भल्लैश्च पातैरञ्जलिकैः शितैः ।\nचिच्छेद चोत्तमाङ्गानि कुजम्भो दानवोत्तमः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006517052, "chapter_id": 26517, "verse_number": "३-५६-५३", "content_sanskrit": "शिरोभिः प्रपतद्भिस्तु गगनं प्रत्यपूर्यत ।\nअश्मवृष्टिरिवाकाशे बहुभिश्च सहाङ्कुशैः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006517053, "chapter_id": 26517, "verse_number": "३-५६-५४", "content_sanskrit": "कृत्तोत्तमाङ्गाः स्कन्धेषु गजानां गजयोधिनः ।\nअदृश्यन्त महाराज ताला विशिरसो यथा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006517054, "chapter_id": 26517, "verse_number": "३-५६-५५", "content_sanskrit": "आपतन्तं महानागमंशस्यासुरसत्तमः ।\nजघानैकेषुणा क्रुद्धस्ततः स विमुखोऽभवत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006517055, "chapter_id": 26517, "verse_number": "३-५६-५६", "content_sanskrit": "विगाह्यैवं गजानीकं कुजम्भो दानवोत्तमः ।\nविनिघ्नन्प्रवरान्सैन्यान्गदया बलिनां वरः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006517056, "chapter_id": 26517, "verse_number": "३-५६-५७", "content_sanskrit": "एकप्रहाराभिहतान् कुजम्भेन महागजान् ।\nअपश्यन्त सुराः सर्वे पर्वतानिव पातितान् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006517057, "chapter_id": 26517, "verse_number": "३-५६-५८", "content_sanskrit": "कुजम्भस्य च मार्गेषु विशीर्णास्ते महागजाः ।\nवज्राहता इवेन्द्रेण विशीर्णा इव पर्वताः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006517058, "chapter_id": 26517, "verse_number": "३-५६-५९", "content_sanskrit": "अपश्यंस्त्रिदशाः सर्वे मूर्तिमन्तमिवान्तकम् ।\nगजास्तथा व्यदीर्यन्त सिंहस्येवेतरे मृगाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006517059, "chapter_id": 26517, "verse_number": "३-५६-६०", "content_sanskrit": "स बभौ तां गदां बिभ्रत् प्रोक्षितां गजशोणितैः ।\nव्यादितास्योऽनदत्क्रुद्धो रौद्ररूपो भयानकः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006517060, "chapter_id": 26517, "verse_number": "३-५६-६१", "content_sanskrit": "यथा हि भगवान्क्रुद्धः प्रजानां संक्षये पुरा ।\nविक्रीडमानो गदया रणमध्ये महासुरः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006517061, "chapter_id": 26517, "verse_number": "३-५६-६२", "content_sanskrit": "गोपाल इव दण्डेन कालयन्स महागजान् ।\nक्रुद्धं कालमिवाकाले दण्डमुद्यम्य दानवम् ।\nअपश्यन्त सुराः सर्वे कुजम्भं भीमविक्रमम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006517062, "chapter_id": 26517, "verse_number": "३-५६-६३", "content_sanskrit": "हतारोहास्तु तत्रान्ये प्रभिन्ना वारणोत्तमाः ।\nते हन्यमाना गदया बाणैश्च भृशविक्षताः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006517063, "chapter_id": 26517, "verse_number": "३-५६-६४", "content_sanskrit": "असहन्तः कुजम्भस्य गदावेगं महाहवे ।\nस्वान्यनीकानि मृद्नन्तः प्राद्रवन्त महागजाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006517064, "chapter_id": 26517, "verse_number": "३-५६-६५", "content_sanskrit": "महावात इवाभ्राणि विधमन् गदया गजान् ।\nअतिष्ठत्समरे दैत्यः कालः संवर्तको यथा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]