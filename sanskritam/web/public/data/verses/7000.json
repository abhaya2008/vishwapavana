    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20130572,
    "chapter_id": 7000,
    "verse_number": "18.101",
    "content_sanskrit": "ये तेषामधिवासाः पुराणवादेषु पर्वताः प्रोक्ताः । सम्भोगस्तेषु भवेत्कर्मारम्भो भवेदस्मिन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20130573,
    "chapter_id": 7000,
    "verse_number": "18.102",
    "content_sanskrit": "प्रहसनमपि विज्ञेयं द्विविधं शुद्धं तथा सङ्कीर्णम् । अङ्कस्य लक्षणमिदं व्याख्यातमशेषयोगमात्रगतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20130574,
    "chapter_id": 7000,
    "verse_number": "18.103",
    "content_sanskrit": "प्रहसनमतः परं सलक्षणं संप्रवक्ष्यामि । वक्ष्यामि तयोर्युक्त्या पृथग्पृथग्लक्षणविशेषम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20130575,
    "chapter_id": 7000,
    "verse_number": "18.104",
    "content_sanskrit": "भगवत्तापसविप्रैरन्यैरपि हास्यवादसम्बद्धम् । कापुरुषसंप्रयुक्तं परिहासाभाषणप्रायम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 104,
    "avatarnika": ""
  },
  {
    "id": 20130576,
    "chapter_id": 7000,
    "verse_number": "18.105",
    "content_sanskrit": "अविकृतभाषाचारं विशेषभावोपपन्नचरितपदम् । नियतगतिवस्तुविषयं शुद्धं ज्ञेयं प्रहसनं तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 105,
    "avatarnika": ""
  },
  {
    "id": 20130577,
    "chapter_id": 7000,
    "verse_number": "18.106",
    "content_sanskrit": "वेश्याचेटनपुंसकविटधूर्ता बन्धकी च यत्र स्युः । अनिभृतवेषपरिच्छदचेष्टितकरणैस्तु संकीर्णम् ॥",
