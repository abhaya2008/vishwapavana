    "avatarnika": ""
  },
  {
    "id": 20130551,
    "chapter_id": 7000,
    "verse_number": "18.80",
    "content_sanskrit": "उद्धतपुरुषप्रायः स्त्रीरोषग्रथितकाव्यबन्धश्च । संक्षोभविद्रवकृतः संफेटकृतस्तथा चैव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20130552,
    "chapter_id": 7000,
    "verse_number": "18.81",
    "content_sanskrit": "स्त्रीभेदनापहरणावमर्दनप्राप्तवस्तुशृङ्गारः । ईहामृगस्तु कार्यः सुसमाहितकाव्यबन्धश्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20130553,
    "chapter_id": 7000,
    "verse_number": "18.82",
    "content_sanskrit": "यद्व्यायोगे कार्यं ये पुरुषा वृत्तयो रसाश्चैव । ईहामृगे ऽपि ते स्युः केवलममरस्त्रिया योगः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
