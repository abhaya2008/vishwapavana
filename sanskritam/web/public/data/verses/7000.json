  },
  {
    "id": 20130565,
    "chapter_id": 7000,
    "verse_number": "18.94",
    "content_sanskrit": "एवंविधस्तु कार्यो व्यायोगो दीप्तकाव्यरसयोनिः । वक्ष्याम्यतः परमहं लक्षणमुत्सृष्टाङ्कस्य ॥",
