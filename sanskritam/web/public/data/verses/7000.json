    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20130562,
    "chapter_id": 7000,
    "verse_number": "18.91",
    "content_sanskrit": "व्यायोगस्तु विधिज्ञैः कार्यः प्रख्यातनायकशरीरः । अल्पस्त्रीजनयुक्तस्त्वेकाहकृतस्तथा चैव ॥",
