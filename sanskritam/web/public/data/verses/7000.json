    "avatarnika": ""
  },
  {
    "id": 20130571,
    "chapter_id": 7000,
    "verse_number": "18.100",
    "content_sanskrit": "उपवनगमनक्रीडा विहारनारीरतिप्रमोदाः स्युः । तेषु हि वर्षेषु सदा न तत्र दुःखं न वा शोकः ॥",
