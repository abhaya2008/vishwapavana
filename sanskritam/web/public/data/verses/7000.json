    "avatarnika": ""
  },
  {
    "id": 20130548,
    "chapter_id": 7000,
    "verse_number": "18.77",
    "content_sanskrit": "उष्णिग्गायत्र्यादीन्यन्यानि च यानि बन्धकुटिलानि । वृत्तानि समवकारे कविभिस्तानि प्रयोज्यानि ॥",
