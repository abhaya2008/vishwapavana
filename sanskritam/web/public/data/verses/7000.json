    "avatarnika": ""
  },
  {
    "id": 20130567,
    "chapter_id": 7000,
    "verse_number": "18.96",
    "content_sanskrit": "करुणरसप्रायकृतो निवृत्तयुद्धोद्यतप्रहारश्च । स्त्रीपरिदेवितबहुलो निर्वेदितभाषितश्चैव ॥",
