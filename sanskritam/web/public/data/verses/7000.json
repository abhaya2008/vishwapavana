    "avatarnika": ""
  },
  {
    "id": 20130547,
    "chapter_id": 7000,
    "verse_number": "18.76",
    "content_sanskrit": "कन्याविलोभनकृतं प्राप्तौ स्त्रीपुंसयोस्तु रम्यं वा । निभृतं सावेगं वा यस्य भवेत्कामशृङ्गारः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
