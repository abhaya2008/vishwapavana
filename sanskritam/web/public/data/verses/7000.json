    "avatarnika": ""
  },
  {
    "id": 20130560,
    "chapter_id": 7000,
    "verse_number": "18.89",
    "content_sanskrit": "षोडशनायकबहुलः सात्वत्त्यारभटीवृत्तिसम्पन्नः । कार्यो डिमः प्रयत्नान्नानाश्रयभावसम्पन्नः ॥",
    "padaccheda": "",
    "anvaya": "",
