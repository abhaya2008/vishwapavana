    "avatarnika": ""
  },
  {
    "id": 20130566,
    "chapter_id": 7000,
    "verse_number": "18.95",
    "content_sanskrit": "प्रख्यातवस्तुविषयस्त्वप्रख्यातः कदाचिदेव स्यात् । दिव्यपुरुषैर्वियुक्तः शेषैर्युक्तो भवेत्पुंभिः ॥",
