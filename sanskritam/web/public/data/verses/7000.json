    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20130559,
    "chapter_id": 7000,
    "verse_number": "18.88",
    "content_sanskrit": "मायेन्द्रजालबहुलो बहुपुस्तोत्थानयोगयुक्तश्च । देवभुजगेन्द्रराक्षसयक्षपिशाचावकीर्णश्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
