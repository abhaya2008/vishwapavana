    "avatarnika": ""
  },
  {
    "id": 20130557,
    "chapter_id": 7000,
    "verse_number": "18.86",
    "content_sanskrit": "शृङ्गारहास्यवर्जं शेषैः सर्वै रसैः समायुक्तः । दीप्तरसकाव्ययोनिर्नानाभावोपसम्पन्नः ॥",
