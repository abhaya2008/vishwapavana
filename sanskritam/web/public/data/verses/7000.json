    "avatarnika": ""
  },
  {
    "id": 20130549,
    "chapter_id": 7000,
    "verse_number": "18.78",
    "content_sanskrit": "एवं कार्यस्तज्ज्ञैर्नानारससंश्रयः समवकारः । वक्ष्याम्यतः परमहं लक्षणमीहामृगस्यापि ॥",
