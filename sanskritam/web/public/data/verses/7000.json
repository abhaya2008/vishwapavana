    "avatarnika": ""
  },
  {
    "id": 20130554,
    "chapter_id": 7000,
    "verse_number": "18.83",
    "content_sanskrit": "यत्र तु वधेप्सितानां वधो ह्युदग्रो भवेद्धि पुरुषाणाम् । किञ्चिद्व्याजं कृत्वा तेषां युद्धं शमयितव्यम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20130555,
    "chapter_id": 7000,
    "verse_number": "18.84",
    "content_sanskrit": "ईहामृगस्य लक्षणमुक्तं विप्राः समासयोगेन । डिमलक्षणं तु भूयो लक्षणयुक्त्या प्रवक्ष्यामि ॥",
