    "avatarnika": ""
  },
  {
    "id": 20130563,
    "chapter_id": 7000,
    "verse_number": "18.92",
    "content_sanskrit": "बहवश्च तत्र पुरुषा व्यायच्छन्ते यथा समवकारे । न च दिव्यनायकयुक्तः कार्यस्त्वेकाङ्क एवायम् ॥",
