    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20130556,
    "chapter_id": 7000,
    "verse_number": "18.85",
    "content_sanskrit": "प्रख्यातवस्तुविषयः प्रख्यातोदात्तनायकश्चैव । षड्रसलक्षणयुक्तश्चतुरङ्को वै डिमः कार्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
