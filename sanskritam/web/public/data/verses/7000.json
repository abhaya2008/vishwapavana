    "avatarnika": ""
  },
  {
    "id": 20130558,
    "chapter_id": 7000,
    "verse_number": "18.87",
    "content_sanskrit": "निर्घातोल्कापातैरुपरागेणेन्दुसूर्ययोर्युक्तः । युद्धनियुद्धाधर्षणसंफेटकृतश्च कर्तव्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
