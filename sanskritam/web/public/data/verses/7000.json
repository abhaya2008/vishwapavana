    "avatarnika": ""
  },
  {
    "id": 20130570,
    "chapter_id": 7000,
    "verse_number": "18.99",
    "content_sanskrit": "कस्माद्भारतमिष्टं वर्षेष्वन्येषु देवविहितेषु । हृद्या सर्वा भूमिः शुभगन्धा काञ्चनी यस्मात् ॥",
