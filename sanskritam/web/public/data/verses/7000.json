[
  {
    "id": 20130472,
    "chapter_id": 7000,
    "verse_number": "18.1",
    "content_sanskrit": "अथ अष्टादशो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20130473,
    "chapter_id": 7000,
    "verse_number": "18.2",
    "content_sanskrit": "वर्त्तयिष्याम्यहं विप्रा दशरूपविकल्पनम् । नामतः कर्मतश्चैव तथा चैव प्रयोगतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20130474,
    "chapter_id": 7000,
    "verse_number": "18.3",
    "content_sanskrit": "नाटकं सप्रकरणमङ्को व्यायोग एव च । भाणः समवकारश्च वीथी प्रहसनं डिमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20130475,
    "chapter_id": 7000,
    "verse_number": "18.4",
    "content_sanskrit": "ईहामृगश्च विज्ञेया दशेमे नाट्यलक्षणे । एतेषां लक्षणमहं व्याख्यास्याम्यनुपूर्वशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20130476,
    "chapter_id": 7000,
    "verse_number": "18.5",
    "content_sanskrit": "सर्वेषामेव काव्यानां मातृका वृत्तयः स्मृताः । आभ्यो विनिसृतं ह्येतद्दशरूपं प्रयोगतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20130477,
    "chapter_id": 7000,
    "verse_number": "18.6",
    "content_sanskrit": "जातिभिः श्रुतिभिश्चैव स्वरा ग्रामत्वमागताः । यथा तथा वृत्तिभेदैः काव्यबन्धा भवन्ति हि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20130478,
    "chapter_id": 7000,
    "verse_number": "18.7",
    "content_sanskrit": "ग्रामौ पूर्णस्वरौ द्वौ तु यथा वै षड्जमध्यमौ । सर्ववृत्तिविनिष्पन्नौ काव्यबन्धौ तथा त्विमौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20130479,
    "chapter_id": 7000,
    "verse_number": "18.8",
    "content_sanskrit": "ज्ञेयं प्रकरणं चैव तथा नाटकमेव च । सर्ववृत्तिविनिष्पन्नं नानाबन्धसमाश्रयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20130480,
    "chapter_id": 7000,
    "verse_number": "18.9",
    "content_sanskrit": "वीथी समवकारश्च तथेहामृग एव च । उत्सृष्टिकाङ्को व्यायोगो भाणः प्रहसनं डिमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20130481,
    "chapter_id": 7000,
    "verse_number": "18.10",
    "content_sanskrit": "कैशिकीवृत्तिहीनानि रूपाण्येतानि कारयेत् । अत ऊर्ध्वं प्रवक्ष्यामि काव्यबन्धविकल्पनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20130482,
    "chapter_id": 7000,
    "verse_number": "18.11",
    "content_sanskrit": "प्रख्यातवस्तुविषयं प्रख्यातोदात्तनायकं चैव । राजर्षिवंश्यचरितं तथैव दिव्याश्रयोपेतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20130483,
    "chapter_id": 7000,
    "verse_number": "18.12",
    "content_sanskrit": "नानाविभूतिभिर्युतमृद्धिविलासादिभिर्गुणैश्चैव । अङ्कप्रवेशकाढ्यं भवति हि तन्नाटकं नाम ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20130484,
    "chapter_id": 7000,
    "verse_number": "18.13",
    "content_sanskrit": "नृपतीनां यच्चरितं नानारसभावचेष्टितं बहुधा । सुखदुःखोत्पत्तिकृतं भवति हि तन्नाटकं नाम ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20130485,
    "chapter_id": 7000,
    "verse_number": "18.14",
    "content_sanskrit": "अस्यावस्थोपेतं कार्यं प्रसमीक्ष्य बिन्दुविस्तारात् । कर्तव्यो ऽङ्कः सो ऽपि तु गुणान्वितं नाट्यतत्त्वज्ञैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20130486,
    "chapter_id": 7000,
    "verse_number": "18.15",
    "content_sanskrit": "अङ्क इति रूढिशब्दो भावैश्च रसैश्च रोहयत्यर्थान् । नानाविधानयुक्तो यस्मात्तस्माद्भवेदङ्कः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20130487,
    "chapter_id": 7000,
    "verse_number": "18.16",
    "content_sanskrit": "अङ्कसमाप्तिः कार्या काव्यच्छेदेन बीजसंहारः । वस्तुव्यापी बिन्दुः काव्यसमुत्थो ऽत्र नित्यं स्यात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20130488,
    "chapter_id": 7000,
    "verse_number": "18.17",
    "content_sanskrit": "यत्रार्थस्य समाप्तिर्यत्र च बीजस्य भवति संहारः । किञ्चिदवलग्नबिन्दुः सो ऽङ्क इति सदावगन्तव्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20130489,
    "chapter_id": 7000,
    "verse_number": "18.18",
    "content_sanskrit": "ये नायका निगदितास्तेषां प्रत्यक्षचरितसंयोगः । नानावस्थोपेतः कार्यस्त्वङ्को ऽविप्रकृष्टस्तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20130490,
    "chapter_id": 7000,
    "verse_number": "18.19",
    "content_sanskrit": "नायकदेवीगुरुजनपुरोहितामात्यसार्थवाहानाम् । नैकरसान्तरविहितो ह्यङ्क इति स वेदितव्यस्तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20130491,
    "chapter_id": 7000,
    "verse_number": "18.20",
    "content_sanskrit": "पञ्चाक्षरा दशपरा ह्यङ्काः स्युर्नाटके प्रकरणे च । निष्क्रामः सर्वेषां यस्मिन्नङ्कः स विज्ञेयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20130492,
    "chapter_id": 7000,
    "verse_number": "18.21",
    "content_sanskrit": "क्रोधप्रसादशोकाः शापोत्सर्गो ऽथ विद्रवोद्वाहौ । अद्भुतसम्भवदर्शनमङ्के प्रत्यक्षजानि स्युः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20130493,
    "chapter_id": 7000,
    "verse_number": "18.22",
    "content_sanskrit": "एकदिवसप्रवृत्तः कार्यस्त्वङ्को ऽर्थबीजमधिकृत्य । आवश्यककार्याणामविरोधेन प्रयोगेषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20130494,
    "chapter_id": 7000,
    "verse_number": "18.23",
    "content_sanskrit": "एकाङ्केन कदाचिद्बहूनि कार्याणि योजयेद्धीमान् । आवश्यकाविरोधेन तत्र काव्यानि कार्याणि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20130495,
    "chapter_id": 7000,
    "verse_number": "18.24",
    "content_sanskrit": "रङ्गं तु ये प्रविष्टाः सर्वेषां भवति तत्र निष्क्रामः । बीजार्थयुक्तियुक्तं कृत्वा काव्यं यथार्थरसम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20130496,
    "chapter_id": 7000,
    "verse_number": "18.25",
    "content_sanskrit": "न बहूनीह कार्याणि त्वेकाङ्के विनियोजयेत् । आवश्यकानां कार्याणां विरोधो हि तथा भवेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20130497,
    "chapter_id": 7000,
    "verse_number": "18.26",
    "content_sanskrit": "ज्ञात्वा दिवसावस्थां क्षणयाममुहूर्तलक्षणोपेताम् । विभजेत्सर्वमशेषं पृथक्पृथक्काव्यमङ्केषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20130498,
    "chapter_id": 7000,
    "verse_number": "18.27",
    "content_sanskrit": "दिवसावसानकार्यं यद्यङ्के नोपपद्यते सर्वम् । अङ्कच्छेदं कृत्वा प्रवेशकैस्तद्विधातव्यम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20130499,
    "chapter_id": 7000,
    "verse_number": "18.28",
    "content_sanskrit": "विप्रकृष्टं तु यो देशं गच्छेत्कार्यवशानुगः । अङ्कच्छेदे ऽथ संक्षेपान्निर्दिशेत्तं प्रवेशकैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20130500,
    "chapter_id": 7000,
    "verse_number": "18.29",
    "content_sanskrit": "सन्निहितनायको ऽङ्कः कर्तव्यो नाटके प्रकरणे वा । परिजनकथानुबन्धः प्रवेशको नाम विज्ञेयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20130501,
    "chapter_id": 7000,
    "verse_number": "18.30",
    "content_sanskrit": "प्रकरणनाटकविषये पञ्चाद्या दशपरा भवन्त्यङ्काः । अङ्कान्तरसन्धिषु च प्रवेशकास्तेषु तावन्तः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20130502,
    "chapter_id": 7000,
    "verse_number": "18.31",
    "content_sanskrit": "अनयोरन्तरविहितः प्रवेशको ऽर्थक्रियां समभिवीक्ष्य । संक्षेपार्थः सन्धिष्वर्थानां संविधातव्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20130503,
    "chapter_id": 7000,
    "verse_number": "18.32",
    "content_sanskrit": "अङ्कच्छेदं कृत्वा मासकृतं वर्षसञ्चितं वापि । तत्सर्वं कर्तव्यं वर्षादूर्ध्वं न तु कदाचित् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20130504,
    "chapter_id": 7000,
    "verse_number": "18.33",
    "content_sanskrit": "यः कश्चित्कार्यवशाद्गच्छति पुरुषः प्रकृष्टमध्वानम् । तत्राप्यङ्कच्छेदः कर्तव्यः पूर्ववत्तज्ञैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20130505,
    "chapter_id": 7000,
    "verse_number": "18.34",
    "content_sanskrit": "अङ्कान्तरानुसारी संक्षेपार्थमधिकृत्य बिन्दूनाम् । प्रकरणनाटकविषये प्रवेशकः संविधातव्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20130506,
    "chapter_id": 7000,
    "verse_number": "18.35",
    "content_sanskrit": "नोत्तममध्यमपुरुषैराचरितो नाप्युदात्तवचनकृतः । प्राकृतभाषाचारः प्रयोगमाश्रित्य कर्तव्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20130507,
    "chapter_id": 7000,
    "verse_number": "18.36",
    "content_sanskrit": "कालोत्थानगतिरसौ व्याख्यासंरम्भकार्यविषयाणाम् । अर्थाभिधानयुक्तः प्रवेशकः स्यादनेकार्थः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20130508,
    "chapter_id": 7000,
    "verse_number": "18.37",
    "content_sanskrit": "बह्वाश्रयमपि कार्यं प्रवेशकैः संक्षिपेच्च सन्धिषु वा । बहुचूर्णपदैर्युक्तं जनयति खेदं प्रयोगस्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20130509,
    "chapter_id": 7000,
    "verse_number": "18.38",
    "content_sanskrit": "यत्रार्थस्य समाप्तिर्न भवत्यङ्के प्रयोगबाहुल्यात् । वृत्तान्तस्वल्पकथैः प्रवेशकैः सो ऽभिधातव्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20130510,
    "chapter_id": 7000,
    "verse_number": "18.39",
    "content_sanskrit": "युद्धं राज्यभ्रंशो मरणं नगरोपरोधनं चैव । प्रत्यक्षाणि तु नाङ्के प्रवेशकैः संविधेयानि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20130511,
    "chapter_id": 7000,
    "verse_number": "18.40",
    "content_sanskrit": "अङ्के प्रवेशके च प्रकरणमाश्रित्य नाटके वापि । न वधः कर्तव्यः स्याद्यो ऽभ्युदयी नायकः ख्यातः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20130512,
    "chapter_id": 7000,
    "verse_number": "18.41",
    "content_sanskrit": "अपसरणमेव कार्यं ग्रहणं वा सन्धिरेव वा योज्यः । काव्यश्लेषैर्बहुभिर्यथारसं नाट्यतत्त्वज्ञैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20130513,
    "chapter_id": 7000,
    "verse_number": "18.42",
    "content_sanskrit": "न महाजनपरिवारं कर्तव्यं नाटकं प्रकरणं वा । ये तत्र कार्यपुरुषाश्चत्वारः पञ्च वा ते स्युः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20130514,
    "chapter_id": 7000,
    "verse_number": "18.43",
    "content_sanskrit": "कार्यं गोपुच्छाग्रं कर्तव्यं काव्यबन्धमासाद्य । ये चोदात्ता भावास्ते सर्वे पृष्ठतः कार्याः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20130515,
    "chapter_id": 7000,
    "verse_number": "18.44",
    "content_sanskrit": "सर्वेषां काव्यानां नानारसभावयुक्तियुक्तानाम् । निर्वहणे कर्तव्यो नित्यं हि रसो ऽद्भुतस्तज्ज्ञैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20130516,
    "chapter_id": 7000,
    "verse_number": "18.45",
    "content_sanskrit": "नाटकलक्षणमेतन्मया समासेन कीर्तितं विधिवत् । प्रकरणमतः परमहं लक्षणयुक्त्या प्रवक्ष्यामि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20130517,
    "chapter_id": 7000,
    "verse_number": "18.46",
    "content_sanskrit": "यत्र कविरात्मशक्त्या वस्तु शरीरं च नायकं चैव । औत्पत्तिकं प्रकुरुते प्रकरणमिति तद्बुधैर्ज्ञेयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20130518,
    "chapter_id": 7000,
    "verse_number": "18.47",
    "content_sanskrit": "यदनार्षमथाहार्यं काव्यं प्रकरोत्यभूतगुणयुक्तम् । उत्पन्नबीजवस्तु प्रकरणमिति तदपि विज्ञेयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20130519,
    "chapter_id": 7000,
    "verse_number": "18.48",
    "content_sanskrit": "यन्नाटके मयोक्तं वस्तु शरीरं च वृत्तिभेदाश्च । तत्प्रकरणे ऽपि योज्यं सलक्षणं सर्वसन्धिषु तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20130520,
    "chapter_id": 7000,
    "verse_number": "18.49",
    "content_sanskrit": "विप्रवणिक्षचिवानां पुरोहितामात्यसार्थवाहानाम् । चरितं यन्नैकविधं ज्ञेयं तत्प्रकरणं नाम ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20130521,
    "chapter_id": 7000,
    "verse_number": "18.50",
    "content_sanskrit": "नोदात्तनायककृतं न दिव्यचरितं न राजसम्भोगम् । बाह्यजनसंप्रयुक्तं तज्ज्ञेयं प्रकरणं तज्ज्ञैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20130522,
    "chapter_id": 7000,
    "verse_number": "18.51",
    "content_sanskrit": "दासविटश्रेष्ठियुतं वेशस्त्र्युपचारकारणोपेतम् । मन्दकुलस्त्रीचरितं काव्यं कार्यं प्रकरणे तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20130523,
    "chapter_id": 7000,
    "verse_number": "18.52",
    "content_sanskrit": "सचिवश्रेष्ठिब्राह्मणपुरोहितामात्यसार्थवाहानाम् । गृहवार्ता यत्र भवेन्न तत्र वेश्याङ्गना कार्या ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20130524,
    "chapter_id": 7000,
    "verse_number": "18.53",
    "content_sanskrit": "यदि वेशयुवतियुक्तं न कुलस्त्री सङ्गमो ऽपि स्यात् । अथ कुलजनप्रयुक्तं न वेशयुवतिर्भवेत्तत्र ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20130525,
    "chapter_id": 7000,
    "verse_number": "18.54",
    "content_sanskrit": "यदि वा कारणयुक्त्या वेशकुलस्त्रीकृतोपचारः स्यात् । अविकृतभाषाचारं तत्र तु पाठ्यं प्रयोक्तव्यम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20130526,
    "chapter_id": 7000,
    "verse_number": "18.55",
    "content_sanskrit": "मध्यमपुरुषैर्नित्यं योज्यो विष्कम्भको ऽत्र तत्त्वज्ज्ञैः । संस्कृतवचनानुगतः संक्षेपार्थः प्रवेशकवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20130527,
    "chapter_id": 7000,
    "verse_number": "18.56",
    "content_sanskrit": "शुद्धः संकीर्णो वा द्विविधो विष्कम्भको ऽपि कर्तव्यः । मध्यमपात्रः शुद्धः संकीर्णो नीचमध्यकृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20130528,
    "chapter_id": 7000,
    "verse_number": "18.57",
    "content_sanskrit": "अङ्कान्तरालविहितः प्रवेशको ऽर्थक्रियां समभिवीक्ष्य । संक्षेपात्सन्धीनामर्थानां चैव कर्तव्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20130529,
    "chapter_id": 7000,
    "verse_number": "18.58",
    "content_sanskrit": "अनयोश्च बन्धयोगादन्यो भेदः प्रयोक्तृभिः कार्यः । प्रख्यातस्त्वितरो वा नाटकयोगे प्रकरणे वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20130530,
    "chapter_id": 7000,
    "verse_number": "18.59",
    "content_sanskrit": "प्रकरणनाटकभेदादुत्पाद्यं वस्तु नायकं नृपतिम् । अन्तःपुरसङ्गीतककन्यामधिकृत्य कर्तव्या ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20130531,
    "chapter_id": 7000,
    "verse_number": "18.60",
    "content_sanskrit": "स्त्रीप्राया चतुरङ्का ललिताभिनयात्मिका सुविहिताङ्गी । बहुनृत्तगीतपाठ्या रतिसम्भोगात्मिका चैव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20130532,
    "chapter_id": 7000,
    "verse_number": "18.61",
    "content_sanskrit": "राजोपचारयुक्ता प्रसादनक्रोधदम्भसंयुक्ता । नायकदेवीदूती सपरिजना नाटिका ज्ञेया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20130533,
    "chapter_id": 7000,
    "verse_number": "18.62",
    "content_sanskrit": "अन्तर्भावगता ह्येषा भावयोरुभयोर्यतः । अत एव दशैतानि रूपाणीत्युदितानि वै ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20130534,
    "chapter_id": 7000,
    "verse_number": "18.63",
    "content_sanskrit": "प्रकरणनाटकलक्षणमुक्तं विप्रा मया समासेन । वक्ष्याम्यतः परमहं लक्षणं युक्त्या समवकारम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20130535,
    "chapter_id": 7000,
    "verse_number": "18.64",
    "content_sanskrit": "देवासुरबीजकृतः प्रख्यातोदात्तनायकश्चैव । त्र्यङ्कस्तथा त्रिकपटस्त्रिविद्रवः स्यात्त्रिशृङ्गारः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20130536,
    "chapter_id": 7000,
    "verse_number": "18.65",
    "content_sanskrit": "द्वादशनायकबहुलो ह्यष्टादशनाडिकाप्रमाणश्च । वक्ष्याम्यस्याङ्कविधिं यावत्यो नाडिका यत्र ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20130537,
    "chapter_id": 7000,
    "verse_number": "18.66",
    "content_sanskrit": "अङ्कस्तु सप्रहसनः सविद्रवः सकपटः सवीथीकः । द्वादशनाडीविहितः प्रथमः कार्यः क्रियोपेतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20130538,
    "chapter_id": 7000,
    "verse_number": "18.67",
    "content_sanskrit": "कार्यस्तथा द्वितीयः समाश्रितो नाडिकाश्चतस्रस्तु । वस्तुसमापनविहितो द्विनाडिकः स्यात्तृतीयस्तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20130539,
    "chapter_id": 7000,
    "verse_number": "18.68",
    "content_sanskrit": "नाडीसंज्ञा ज्ञेया मानं कालस्य यन्मुहूर्तार्धम् । तन्नाडिकाप्रमाणं यथोक्तमङ्केषु संयोज्यम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20130540,
    "chapter_id": 7000,
    "verse_number": "18.69",
    "content_sanskrit": "या नाडिकेति संज्ञा कालविभागे क्रियाभिसंपन्ना । कार्या च सा प्रयत्नाद्यथा क्रमेणैव शास्त्रोक्ता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20130541,
    "chapter_id": 7000,
    "verse_number": "18.70",
    "content_sanskrit": "अङ्को ऽङ्कस्त्वन्यार्थः कर्तव्यः काव्यबन्धमासाद्य । अर्थं हि समवकारे ह्यप्रतिसम्बन्धमिच्छन्ति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20130542,
    "chapter_id": 7000,
    "verse_number": "18.71",
    "content_sanskrit": "युद्धजलसम्भवो वा वाय्वग्निगजेन्द्रसंभ्रमकृतो वा । नगरोपरोधजो वा विज्ञेयो विद्रवस्त्रिविधः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20130543,
    "chapter_id": 7000,
    "verse_number": "18.72",
    "content_sanskrit": "वस्तुगतक्रमविहितो देववशाद्वा परप्रयुक्तो वा । सुखदुःखोत्पत्तिकृतस्त्रिविधः कपटो ऽत्र विज्ञेयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20130544,
    "chapter_id": 7000,
    "verse_number": "18.73",
    "content_sanskrit": "त्रिविधश्चात्र विधिज्ञैः पृथक्पृथक्कार्यविहितार्थः । शृङ्गारः कर्तव्यो धर्मे चार्थे च कामे च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20130545,
    "chapter_id": 7000,
    "verse_number": "18.74",
    "content_sanskrit": "यस्मिन् धर्मप्रापकमात्महितं भवति साधनं बहुधा । व्रतनियमतपोयुक्तो ज्ञेयो ऽसौ धर्मशृङ्गारः ॥",
