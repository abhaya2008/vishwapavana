    "avatarnika": ""
  },
  {
    "id": 20130561,
    "chapter_id": 7000,
    "verse_number": "18.90",
    "content_sanskrit": "डिमलक्षणमित्युक्तं मया समासेन लक्षणानुगतम् । व्यायोगस्य तु लक्षणमतः परं संप्रवक्ष्यामि ॥",
