    "avatarnika": ""
  },
  {
    "id": 20130550,
    "chapter_id": 7000,
    "verse_number": "18.79",
    "content_sanskrit": "दिव्यापुरुषाश्रयकृतो दिव्यस्त्रीकारणोपगतयुद्धः । सुविहितवस्तुनिबद्धो विप्रत्ययकारकश्चैव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
