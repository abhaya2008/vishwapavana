    "avatarnika": ""
  },
  {
    "id": 20130568,
    "chapter_id": 7000,
    "verse_number": "18.97",
    "content_sanskrit": "नानाव्याकुलचेष्टः सात्वत्त्यारभटिकैशिकीहीनः । कार्यः काव्यविधिज्ञैः सततं ह्युत्सृष्टिकाङ्कस्तु ॥",
