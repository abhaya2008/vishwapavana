    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 107,
    "avatarnika": ""
  },
  {
    "id": 20130579,
    "chapter_id": 7000,
    "verse_number": "18.108",
    "content_sanskrit": "वीथ्यङ्गैः संयुक्तं कर्तव्यं प्रहसनं यथायोग्यम् । भाणस्यापि तु लक्षणमतः परं संप्रवक्ष्यामि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 108,
    "avatarnika": ""
  },
  {
    "id": 20130580,
    "chapter_id": 7000,
    "verse_number": "18.109",
    "content_sanskrit": "आत्मानुभूतशंसी परसंश्रयवर्णनाविशेषस्तु । विविधाश्रयो हि भाणो विज्ञेयस्त्वेकहार्यश्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 109,
    "avatarnika": ""
  },
  {
    "id": 20130581,
    "chapter_id": 7000,
    "verse_number": "18.110",
    "content_sanskrit": "परवचनमात्मसंस्थं प्रतिवचनैरुत्तमोत्तमग्रथितैः । आकाशपुरुषकथितैरङ्गविकारैरभिनयैश्चैव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 110,
    "avatarnika": ""
  },
  {
    "id": 20130582,
    "chapter_id": 7000,
    "verse_number": "18.111",
    "content_sanskrit": "धूर्तविटसंप्रयोज्यो नानावस्थान्तरात्मकश्चैव । एकाङ्को बहुचेष्टः सततं कार्यो बुधैर्भाणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 111,
    "avatarnika": ""
  },
  {
    "id": 20130583,
    "chapter_id": 7000,
    "verse_number": "18.112",
    "content_sanskrit": "भाणस्यापि हि निखिलं लक्षणमुक्तं तथागमानुगतम् । वीथ्याः संप्रति निखिलं कथयामि यथाक्रमं विप्राः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 112,
    "avatarnika": ""
  },
  {
    "id": 20130584,
    "chapter_id": 7000,
    "verse_number": "18.113",
    "content_sanskrit": "सर्वरसलक्षणाढ्या युक्ता ह्यङ्गैस्त्रयोदशभिः । वीथी स्यादेकाङ्का तथैकहार्या द्विहार्या वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 113,
    "avatarnika": ""
  },
  {
    "id": 20130585,
    "chapter_id": 7000,
    "verse_number": "18.114",
    "content_sanskrit": "अधमोत्तममध्याभिर्युक्ता स्यात्प्रकृतिभिस्तिसृभिः । उद्धात्यकावलगितावस्पन्दितनाल्यसत्प्रलापाश्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 114,
    "avatarnika": ""
  },
  {
    "id": 20130586,
    "chapter_id": 7000,
    "verse_number": "18.115",
    "content_sanskrit": "वाक्केल्यथ प्रपञ्चो मृदवाधिबले छलं त्रिगतम् । व्याहारो गण्डश्च त्रयोदशाङ्गान्युदाहृतान्यस्याः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 115,
    "avatarnika": ""
  },
  {
    "id": 20130587,
    "chapter_id": 7000,
    "verse_number": "18.116",
    "content_sanskrit": "अथ वीथी संप्रोक्ता लक्षणमेषां प्रवक्ष्यामि । पदानि त्वगतार्थानि ये नराः पुनरादरात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 116,
    "avatarnika": ""
  },
  {
    "id": 20130588,
    "chapter_id": 7000,
    "verse_number": "18.117",
    "content_sanskrit": "योजयन्ति पदैरन्यैस्तदुद्धात्यकमुच्यते । यत्रान्यस्मिन् समावेश्य कार्यमन्यत्प्रसाध्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 117,
    "avatarnika": ""
  },
  {
    "id": 20130589,
    "chapter_id": 7000,
    "verse_number": "18.118",
    "content_sanskrit": "तच्चावलगितं नाम विज्ञेयं नाट्ययोक्तृभिः । आक्षिप्ते ऽर्थे तु कस्मि।ण्श्चिच्छुभाशुभसमुत्थिते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 118,
    "avatarnika": ""
  },
  {
    "id": 20130590,
    "chapter_id": 7000,
    "verse_number": "18.119",
    "content_sanskrit": "कौशलादुच्यते ऽन्यो ऽर्थस्तदवस्पन्दितं भवेत् । हास्येनोपगतार्थप्रहेलिका नालिकेति विज्ञेया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 119,
    "avatarnika": ""
  },
  {
    "id": 20130591,
    "chapter_id": 7000,
    "verse_number": "18.120",
    "content_sanskrit": "मूर्खजनसन्निकर्षे हितमपि यत्र प्रभाषते विद्वान् । न च गृह्यते ऽस्य वचनं विज्ञेयो ऽसत्प्रलापो ऽसौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 120,
    "avatarnika": ""
  },
  {
    "id": 20130592,
    "chapter_id": 7000,
    "verse_number": "18.121",
    "content_sanskrit": "एकद्विप्रतिवचना वाक्केली स्यात्प्रयोगे ऽस्मिन् । यदसद्भूतं वचनं संस्तवयुक्तं द्वयोः परस्परं यत्तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 121,
    "avatarnika": ""
  },
  {
    "id": 20130593,
    "chapter_id": 7000,
    "verse_number": "18.122",
    "content_sanskrit": "एकस्य चार्थहेतोः स हास्यजननः प्रपञ्चः स्यात् । यत्कारणाद् गुणानां दोषीकरणं भवेद्विवादकृतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 122,
    "avatarnika": ""
  },
  {
    "id": 20130594,
    "chapter_id": 7000,
    "verse_number": "18.123",
    "content_sanskrit": "दोषगुणीकरणं वा तन्मृदवं नाम विज्ञेयम् । परवचनमात्मनश्चोत्तरोत्तरसमुद्भवं द्वयोर्यत्र ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 123,
    "avatarnika": ""
  },
  {
    "id": 20130595,
    "chapter_id": 7000,
    "verse_number": "18.124",
    "content_sanskrit": "अन्योन्यार्थविशेषकमधिबलमिति तद् बुधैर्ज्ञेयम् । अन्यार्थमेव वाक्यं छलमभिसन्धानहास्यरोषकरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 124,
    "avatarnika": ""
  },
  {
    "id": 20130596,
    "chapter_id": 7000,
    "verse_number": "18.125",
    "content_sanskrit": "श्रुतिसारूप्याद्यस्मिन् बहवो ऽर्था युक्तिभिर्नियुज्यन्ते । यद्धास्यमहास्यं वा तत्त्रिगतं नाम विज्ञेयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 125,
    "avatarnika": ""
  },
  {
    "id": 20130597,
    "chapter_id": 7000,
    "verse_number": "18.126",
    "content_sanskrit": "प्रत्यक्षवृत्तिरुक्तो व्याहारो हास्यलेशार्थः । संरम्भसंभ्रमयुतं विवादयुक्तं तथापवादकृतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 126,
    "avatarnika": ""
  },
  {
    "id": 20130598,
    "chapter_id": 7000,
    "verse_number": "18.127",
    "content_sanskrit": "बहुवचनाक्षेपकृतं गण्डं प्रवदन्ति तत्त्वज्ञाः । इति दशरूपविधानं सर्वं प्रोक्तं मया हि लक्षणतः । पुनरस्य शरीरगतं सन्धिविधौ लक्षणं वक्ष्ये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 127,
    "avatarnika": ""
  },
  {
    "id": 20130599,
    "chapter_id": 7000,
    "verse_number": "18.128",
    "content_sanskrit": "इति भारतीये नाट्यशास्त्रे दशरूपनिरूपणं नामाष्टादशो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
