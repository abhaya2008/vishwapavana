    "avatarnika": ""
  },
  {
    "id": 20130564,
    "chapter_id": 7000,
    "verse_number": "18.93",
    "content_sanskrit": "न च दिव्यनायककृतः कार्यो राजर्षिनायकनिबद्धः । युद्धनियुद्धाघर्षणसंघर्षकृतश्च कर्तव्यः ॥",
