    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 106,
    "avatarnika": ""
  },
  {
    "id": 20130578,
    "chapter_id": 7000,
    "verse_number": "18.107",
    "content_sanskrit": "लोकोपचारयुक्ता या वार्ता यश्च दम्भसंयोगः । स प्रहसने प्रयोज्यो धूर्तप्रविवादसम्पन्नः ॥",
