[{"id": 2172998, "chapter_id": 4684, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2172999, "chapter_id": 4684, "verse_number": "१", "content_sanskrit": "तस्मिन् विलुलिते सैन्ये वध्यमाने परस्परम् ।\nअभ्यद्रवत सङ्ग्रामे पाण्डवानाततायिनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2173000, "chapter_id": 4684, "verse_number": "२", "content_sanskrit": "पाण्डवाश्च महाराज समरे जितकाशिनः ।\nमद्रराजं समासाद्य विव्यधुर्निशितैः शरैः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2173001, "chapter_id": 4684, "verse_number": "३", "content_sanskrit": "ततः शरशतैस्तीक्ष्णैः मद्रराजो महारथः ।\nअर्दयामास तां सेनां धर्मराजस्य पश्यतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2173002, "chapter_id": 4684, "verse_number": "४", "content_sanskrit": "प्रादुरासन् निमित्तानि घोररूपाण्यनेकशः ।\nचचाल शब्दं कुर्वाणा मही चापि सपर्वता\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2173003, "chapter_id": 4684, "verse_number": "५", "content_sanskrit": "सदण्डशूलदीप्ताग्राः शीर्यमाणाः समन्ततः ।\nउल्का भूमौ दिवः पेतुः आहत्य रविमण्डलम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2173004, "chapter_id": 4684, "verse_number": "६", "content_sanskrit": "मृगाश्च महिषाश्चैव पक्षिणश्च विशाम्पते ।\nअपसव्यं तदा चक्रुः सेनां ते बहुशो नृप\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2173005, "chapter_id": 4684, "verse_number": "७", "content_sanskrit": "ततस्तु युद्धमत्युग्रमभवत् सम्प्रहारिणाम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2173006, "chapter_id": 4684, "verse_number": "८", "content_sanskrit": "ततः सर्वाण्यनीकानि सन्निपत्य जनाधिप ।\nअभ्ययुः कौरवा राजन् पाण्डवानामनीकिनीम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2173007, "chapter_id": 4684, "verse_number": "९", "content_sanskrit": "शल्यस्तु शरवर्षेण वर्षन्निव सहस्रदृक् ।\nअभ्यवर्षददीनात्मा कुन्तीपुत्रं युधिष्ठिरम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2173008, "chapter_id": 4684, "verse_number": "१०", "content_sanskrit": "भीमसेनं शरैश्चापि रुग्मपुङ्खैः शिलाशितैः ।\nद्रौपदेयांस्ततः सर्वान् माद्रीपुत्रौ च पाण्डवौ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2173009, "chapter_id": 4684, "verse_number": "११", "content_sanskrit": "धृष्टद्युम्नं स शैनेयं शिखण्डिनमथाहवे ।\nएकैकं दशभिर्वाणैः विव्याध च महाबलः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2173010, "chapter_id": 4684, "verse_number": "१२", "content_sanskrit": "ततोऽसृजद् बाणवर्षं घर्मान्ते मघवानिव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2173011, "chapter_id": 4684, "verse_number": "१३", "content_sanskrit": "ततः प्रभद्रका राजन् सोमकाश्च सहस्रशः ।\nपतिताः पात्यमानाश्च दृश्यन्ते तस्य सायकैः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2173012, "chapter_id": 4684, "verse_number": "१४", "content_sanskrit": "भ्रमराणामिव व्राताः शलभानामिव व्रजाः ।\nह्रादिन्य इव मेघेभ्यः शल्यस्य न्यपतन् शराः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2173013, "chapter_id": 4684, "verse_number": "१५", "content_sanskrit": "द्विरदास्तुरगाश्चार्ताः पत्तयो रथिनस्तथा ।\nशल्यस्य बाणैर्न्यपतन् बभ्रमुर्व्यनदंस्तथा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2173014, "chapter_id": 4684, "verse_number": "१६", "content_sanskrit": "आविष्ट इति मद्रेशो मन्युना पौरुषेण च ।\nप्रोत्सादयदरीन् सङ्खे कालसृष्ट इवान्तकः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2173015, "chapter_id": 4684, "verse_number": "१७", "content_sanskrit": "विनर्दमानो मद्रेशो मेघह्रादो महाबलः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2173016, "chapter_id": 4684, "verse_number": "१८", "content_sanskrit": "सा वध्यमाना शल्येन पाण्डवानामनीकिनी ।\nअजातशत्रुं कौन्तेयमभ्यधावद् युधिष्ठिरम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2173017, "chapter_id": 4684, "verse_number": "१९", "content_sanskrit": "तां समर्प्य ततः सङ्खे लघुहस्तः शितैः शरैः ।\nशरवर्षेण महता युधिष्ठिरमपीडयत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2173018, "chapter_id": 4684, "verse_number": "२०", "content_sanskrit": "तमापतन्तं जात्यश्वैः क्रुद्धो राजा युधिष्ठिरः ।\nअवारयच्छरैस्तीक्ष्णैः मत्तद्विपमिवाङ्कुशैः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2173019, "chapter_id": 4684, "verse_number": "२१", "content_sanskrit": "तस्य शल्यः शरं घोरं मुमोचाशीविषोपमम् ।\nसोऽतिविद्धो महात्मा वै वेगेनाभ्यपतच्च गाम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2173020, "chapter_id": 4684, "verse_number": "२२", "content_sanskrit": "ततो वृकोदरः क्रुद्धः शल्यं विव्याध सप्तभिः ।\nपञ्चभिः सहदेवस्तु नकुलो दशभिः शरैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2173021, "chapter_id": 4684, "verse_number": "२३", "content_sanskrit": "द्रौपदेयाश्च शत्रुघ्नं शूरमार्तायनिं शरैः ।\nअभ्यवर्षन् महामेघा महीधरमिवोन्नतम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2173022, "chapter_id": 4684, "verse_number": "२४", "content_sanskrit": "ततो दृष्ट्वा विनर्दन्तं शल्यं पार्थैः समन्ततः ।\nकृतवर्मा कृपश्चैव सङ्क्रुद्धावभ्यधावताम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2173023, "chapter_id": 4684, "verse_number": "२५", "content_sanskrit": "उलूकश्चापि कौरव्यः शकुनिश्चापि सौबलः ।\nस्मयमानश्च शनकैरश्वत्थामा महाबलः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2173024, "chapter_id": 4684, "verse_number": "२६", "content_sanskrit": "तव पुत्राश्च सबला जुगुपुः शल्यमाहवे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2173025, "chapter_id": 4684, "verse_number": "२७", "content_sanskrit": "भीमसेनं त्रिभिर्विद्ध्वा कृतवर्मा शिलीमुखैः ।\nबाणवर्षेण महता क्रुद्धरूपमवारयत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2173026, "chapter_id": 4684, "verse_number": "२८", "content_sanskrit": "धृष्टद्युम्नं कृपः क्रुद्धो बाणवर्षैरवर्षयत् ।\nद्रौपदेयांश्च शकुनिर्यमौ च द्रौणिरभ्ययात्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2173027, "chapter_id": 4684, "verse_number": "२९", "content_sanskrit": "दुर्योधनो युधां श्रेष्ठो ह्याहवे केशवार्जुनौ ।\nसमभ्यगादुग्रतेजाः शरैश्चाभ्यहनद् युधि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2173028, "chapter_id": 4684, "verse_number": "३०", "content_sanskrit": "एवं द्वन्द्वशतान्यासन् त्वदीयानां परैः सह ।\nघोररूपाणि चित्राणि तत्र तत्र विशाम्पते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2173029, "chapter_id": 4684, "verse_number": "३१", "content_sanskrit": "ऋक्षवर्णान् जघानाश्वान् भोजो भीमस्य संयुगे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2173030, "chapter_id": 4684, "verse_number": "३२", "content_sanskrit": "सोऽवतीर्य रथोपस्थाद्धताश्वः पाण्डुनन्दनः ।\nकालो दण्डमिवोद्यम्य गदापाणिरयुध्यत\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2173031, "chapter_id": 4684, "verse_number": "३३", "content_sanskrit": "प्रमुखे सहदेवस्य जघानाश्वांस्तु मद्रराट् ।\nततः शल्यस्य तनयं सहदेवोऽसिनाऽवधीत्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2173032, "chapter_id": 4684, "verse_number": "३४", "content_sanskrit": "गौतमः पुनराचार्यो धृष्टद्युम्नमयोधयत् ।\nअसम्भ्रान्तो ह्यसम्भ्रान्तं यत्नवान् यत्नवत्तरम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2173033, "chapter_id": 4684, "verse_number": "३५", "content_sanskrit": "द्रौपदेयांस्तथा वीरान् एकैकं दशभिः शरैः ।\nअविध्यदाचार्यसुतो नातिक्रुद्धः स्मयन्निव\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2173034, "chapter_id": 4684, "verse_number": "३६", "content_sanskrit": "भोजश्च भीमसेनस्य जघानाश्वान् महाहवे ।\nसोऽवतीर्य रथात् तूर्णं हताश्वः पाण्डुनन्दनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2173035, "chapter_id": 4684, "verse_number": "३७", "content_sanskrit": "कालो दण्डमिवोद्यम्य गदां क्रुद्धो महाबलः ।\nपोथयामास तुरगान् रथं च कृतवर्मणः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2173036, "chapter_id": 4684, "verse_number": "३८", "content_sanskrit": "कृतवर्मा त्ववप्लुत्य रथात् तस्मादपाक्रमत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2173037, "chapter_id": 4684, "verse_number": "३९", "content_sanskrit": "शल्योऽपि राजन् सङ्क्रुद्धो निघ्नन् पाण्डवसोमकान् ।\nपुनरेव शितैर्बाणैर्युधिष्ठिरमपीडयत्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2173038, "chapter_id": 4684, "verse_number": "४०", "content_sanskrit": "तस्य भीमो रणे क्रुद्धः सन्दष्टदशनच्छदः ।\nविनाशायाभिसन्धाय गदामादत्त वीर्यवान्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2173039, "chapter_id": 4684, "verse_number": "४१", "content_sanskrit": "यमदण्डप्रतीकाशां कालरात्रिमिवोद्यताम् ।\nगजवाजिमनुष्याणां प्राणान्तकरणीमपि\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2173040, "chapter_id": 4684, "verse_number": "४२", "content_sanskrit": "हेमपट्टपरिक्षिप्तामुल्कामापतितामिव ।\nशैक्यां व्यालीमिवात्युग्रां वज्रकल्पामयस्मयीम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2173041, "chapter_id": 4684, "verse_number": "४३", "content_sanskrit": "चन्दनागरुपङ्काक्तां प्रमदामीप्सितामिव ।\nवसामेदोऽसृगादिग्धां जिह्वां वैवस्वतीमिव\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2173042, "chapter_id": 4684, "verse_number": "४४", "content_sanskrit": "बद्धघण्टारवयुतां वासवीमशनीमिव ।\nनिर्मुक्ताशीविषाकारां पृक्तां गजमदैरपि\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2173043, "chapter_id": 4684, "verse_number": "४५", "content_sanskrit": "त्रासनीं परसैन्यानां स्वसैन्यपरिहर्षिणीम् ।\nमनुष्यलोके विख्यातां गिरिशृङ्गविदारिणीम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2173044, "chapter_id": 4684, "verse_number": "४६", "content_sanskrit": "यथा कैलासशिखरे महेश्वरसखं बली ।\nआह्वयामास कौन्तेयः सङ्क्रुद्धमलकापतिम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2173045, "chapter_id": 4684, "verse_number": "४७", "content_sanskrit": "यथा मायाविनो दृप्तान् सुबहून् धनदालये ।\nजघान गुह्यकान् क्रुद्धः कल्हारार्थे महाबलः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2173046, "chapter_id": 4684, "verse_number": "४८", "content_sanskrit": "निवार्यमाणो बहुभिः द्रौपद्याः प्रियमास्थितः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2173047, "chapter_id": 4684, "verse_number": "४९", "content_sanskrit": "तां वज्रमणिरत्नाङ्कामष्टाश्रां वज्रगौरवाम् ।\nसमुद्यम्य महाबाहुः शल्यमभ्यद्रवद् रणे\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2173048, "chapter_id": 4684, "verse_number": "५०", "content_sanskrit": "गदया युद्धकुशलस्तया दारुणनादया ।\nपोथयामास शल्यस्य चतुरोऽश्वान् महाजवान्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2173049, "chapter_id": 4684, "verse_number": "५१", "content_sanskrit": "ततः शल्यो रणे क्रुद्धः पीने वक्षसि तोमरम् ।\nचिक्षेप भीमसेनस्य सोऽस्रवच्छोणितं बहु\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2173050, "chapter_id": 4684, "verse_number": "५२", "content_sanskrit": "तमेवादाय भीमस्तु ततः कोपसमन्वितः ।\nयन्तारं मद्रराजस्य निर्बिभेद तदा हृदि\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2173051, "chapter_id": 4684, "verse_number": "५३", "content_sanskrit": "स भिन्नवर्मा रुधिरं वमन् वित्रस्तमानसः ।\nपपाताभिमुखो वीरो मद्रराजस्त्वपाक्रमत्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2173052, "chapter_id": 4684, "verse_number": "५४", "content_sanskrit": "कृतप्रतिकृतं दृष्ट्वा शल्यो विस्मितमानसः ।\nगदामाश्रित्य धीरात्मा पत्यमित्रमुदैक्षत\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2173053, "chapter_id": 4684, "verse_number": "५५", "content_sanskrit": "ततः सुमनसः पार्था भीमसेनमपूजयन् ।\nतद् दृष्ट्वा कर्म सङ्ग्रामे घोरमक्लिष्टकर्मणः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2173054, "chapter_id": 4684, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि एकादशोऽध्यायः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2173055, "chapter_id": 4684, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि एकादशोऽध्यायः ॥११॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]