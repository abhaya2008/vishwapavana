[{"id": 7002806000, "chapter_id": 22806, "verse_number": "९-९१-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nअम्बुपूर्णतडागेषु महातोयाशयेषु च ।\nकस्यार्थं सम्प्रयच्छंति कृष्णैताः कुलयोषितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002806001, "chapter_id": 22806, "verse_number": "९-९१-२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nमासि भाद्रपदे प्राप्ते शुक्ले भूततिथौ नृप ।\nतडागपाल्यां दातव्यं वरुणायार्घ्यमुत्तमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002806002, "chapter_id": 22806, "verse_number": "९-९१-३", "content_sanskrit": "ब्राह्मणैः क्षत्रियैर्वैश्यैः शूद्रैः स्त्रीभिस्तथैव च ।\nतस्मिन्दिने भक्तिनम्रैर्देयादर्घ्यं युधिष्ठिर ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002806003, "chapter_id": 22806, "verse_number": "९-९१-४", "content_sanskrit": "पुष्पैः फलैस्तथा वस्त्रैर्दीपालक्तकचन्दनैः ।\nअनग्निपाकोसिद्धान्नैस्तिलतण्डुलमिश्रकैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002806004, "chapter_id": 22806, "verse_number": "९-९१-५", "content_sanskrit": "खर्जूरैर्नालिकेरैश्च बीजपूर्णारकैस्तथा ।\nद्राक्षादाडिमपूगैश्च त्रपुसैश्चापि पूजयेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002806005, "chapter_id": 22806, "verse_number": "९-९१-६", "content_sanskrit": "आलिख्य मण्डले देवं वरुणं वारुणीयुतम् ।\nमंत्रेणानेन राजेन्द्र पूजयेद्भक्तिभावतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002806006, "chapter_id": 22806, "verse_number": "९-९१-७", "content_sanskrit": "वरुणाय नमस्तुभ्यं नमस्ते यादसांपते ।\nअपांपते नमस्तेऽस्तु रसानांपतये नमः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002806007, "chapter_id": 22806, "verse_number": "९-९१-८", "content_sanskrit": "मा क्लेदं मा च दौर्गंध्यं विरस्यं मा मुखेऽस्तु मे ।\nवरुणो वारुणीभर्ता वरदोऽस्तु सदा मम ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002806008, "chapter_id": 22806, "verse_number": "९-९१-९", "content_sanskrit": "एवं यः पूजयेद्भक्त्या वरुणं वरुणालयम् ।\nमध्याह्ने सरसि स्नात्वा नग्निपाकी व्रती नृप ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002806009, "chapter_id": 22806, "verse_number": "९-९१-१०", "content_sanskrit": "चातुर्वर्ण्यथ वै नारी व्रतेनानेन पांडव ।\nनैवेद्यं ब्राह्मणे देयं यन्नैवेद्ये प्रकल्पितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002806010, "chapter_id": 22806, "verse_number": "९-९१-११", "content_sanskrit": "एवं यः कुरुते पार्थ पालीव्रतमुत्तमम् ।\nतत्क्षणात्सर्वपापेभ्यो मुच्यते नात्र संशयः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002806011, "chapter_id": 22806, "verse_number": "९-९१-१२", "content_sanskrit": "संरुद्धशुद्धसलिलातिबलां विशालां पालीमुपेत्य बहुभिस्तरुभिः कृतालीम् ।\nये पूजयंति वरुणं सहितं समुद्रैस्तेषां गृहे भवति भूतिरलब्धनाशा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]