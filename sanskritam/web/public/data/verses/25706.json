[{"id": 7005706000, "chapter_id": 25706, "verse_number": "१७९-१", "content_sanskrit": "भवमाहात्म्यवर्णनम् ।\nऋषय ऊचुः ।\nश्रुतः पद्मोद्भवस्तात विस्तरेण त्वयेरितः ।\nसमासाद् भव माहात्म्यं भैरवस्य विधीयताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005706001, "chapter_id": 25706, "verse_number": "१७९-२", "content_sanskrit": "सूत उवाच ।\nतस्यापि देवदेवस्य श्रृणुध्वं कर्म चोत्तमम् ।\nआसीद्दैत्योऽन्धको नाम भिन्नाञ्जन चयोपमः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005706002, "chapter_id": 25706, "verse_number": "१७९-३", "content_sanskrit": "तपसा महतायुक्तो ह्यबध्यस्त्रिदिवौकसाम् ।\nस कदाचित् महादेवं पार्वत्या सहितं प्रभुम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005706003, "chapter_id": 25706, "verse_number": "१७९-४", "content_sanskrit": "क्रीडमानं तदा दृष्ट्वा हर्तुं देवीं प्रचक्रमे ।\nतस्य युद्धं तदा घोरमभवत् सह शम्भुना ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005706004, "chapter_id": 25706, "verse_number": "१७९-५", "content_sanskrit": "आवन्त्ये विषये घोरे महाकालवनं प्रति ।\nतस्मिन्युद्धे तदा रुद्रश्चान्धकेनातिपीडितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005706005, "chapter_id": 25706, "verse_number": "१७९-६", "content_sanskrit": "सुषुवे बाणमत्युग्र नाम्ना पाशुपतं हि तत् ।\nरुद्रबाणविनिर्भेदाद्रुधिरादन्धकस्य तु ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005706006, "chapter_id": 25706, "verse_number": "१७९-७", "content_sanskrit": "अन्धकाश्च समुत्पन्नाः शतशोऽथ सहस्रशः ।\nतेषां विदार्यमाणानां रुधिरादपरे पुनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005706007, "chapter_id": 25706, "verse_number": "१७९-८", "content_sanskrit": "बभूवुरन्धका घोरा यैर्व्याप्तमखिलं जगत् ।\nएवं मायाविनं दृष्ट्वा तञ्च देवस्तदान्धकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005706008, "chapter_id": 25706, "verse_number": "१७९-९", "content_sanskrit": "पानार्थमन्धकास्रस्य सोऽसृजन्मातरस्तदा ।\nमाहेश्वरी तथाब्राह्मी कौमारी मालिनी तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005706009, "chapter_id": 25706, "verse_number": "१७९-१०", "content_sanskrit": "सौपर्णी ह्यथ वायव्या शाक्री वै नैऋती तथा ।\nसौरी सौम्या शिवा दूती चामुण्डा चाथ वारुणी ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005706010, "chapter_id": 25706, "verse_number": "१७९-११", "content_sanskrit": "वाराही नारसिंहीच वैष्णवीच चलच्छिखा ।\nशतानन्दा भगानन्दा पिच्छिला भगमालिनी ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005706011, "chapter_id": 25706, "verse_number": "१७९-१२", "content_sanskrit": "बला चातिबला रक्ता सुरभी मुखमण्डिका ।\nमातृनन्दा सुनन्दाच विडाली शकुनी तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005706012, "chapter_id": 25706, "verse_number": "१७९-१३", "content_sanskrit": "रेवतीच महारक्ता तथैव पिल पिच्छिका ।\nजयाच विजया चैव जयन्ती चापराजिता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005706013, "chapter_id": 25706, "verse_number": "१७९-१४", "content_sanskrit": "काली चैव महाकाली दूती चैव तथैव च ।\nसुभागा दुर्भगा चैव कराली नन्दिनी तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005706014, "chapter_id": 25706, "verse_number": "१७९-१५", "content_sanskrit": "अदितिश्च दितिश्चैव मारीवै मृत्युरेव च ।\nकर्णमोटी तथा ग्राम्या उलूकीच घटोदरी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005706015, "chapter_id": 25706, "verse_number": "१७९-१६", "content_sanskrit": "कपाली वज्रहस्ता च पिशाची राक्षसी तथा ।\nभुशुण्डी शाङ्करी चण्डा लाङ्गली कुटभी तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005706016, "chapter_id": 25706, "verse_number": "१७९-१७", "content_sanskrit": "खेटा सुलोचना धूम्रा एकवीरा करालिनी ।\nविशालदंष्ट्रिणी श्यामा त्रिजटी कुक्कुटी तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005706017, "chapter_id": 25706, "verse_number": "१७९-१८", "content_sanskrit": "वैनायकी च वैताली उन्मत्तो दुम्वरी तथा ।\nसिद्धिश्च लेलिहाना च केकरी गर्दभी तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005706018, "chapter_id": 25706, "verse_number": "१७९-१९", "content_sanskrit": "भ्रुकुटी बहुपुत्रीच प्रेतयाना विडम्बिनी ।\nक्रौञ्चा शैलमुखी चैव विनता सुरमा दनुः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005706019, "chapter_id": 25706, "verse_number": "१७९-२०", "content_sanskrit": "उषा रम्भा मेनकाच सलिला चित्ररूपिणी ।\nस्वाहा स्वधा वषट्कारा धृतिर्ज्येष्ठाकपर्दिनी ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005706020, "chapter_id": 25706, "verse_number": "१७९-२१", "content_sanskrit": "माया विचित्ररूपा च कामरूपा च सङ्गमा ।\nमुखेविला मङ्गला च महानासा महामुखी ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005706021, "chapter_id": 25706, "verse_number": "१७९-२२", "content_sanskrit": "कुमारी रोचना भोमा सदाहा सा मदोद्धता ।\nअलम्बाक्षी कालपर्णी कुम्भकर्णो महासुरी ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005706022, "chapter_id": 25706, "verse_number": "१७९-२३", "content_sanskrit": "केशिनी शङ्किनी लम्बा पिङ्गला लोहितामुखी ।\nघण्टारवाथ दंष्ट्राला रोचना काकजङ्घिका ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005706023, "chapter_id": 25706, "verse_number": "१७९-२४", "content_sanskrit": "गोकर्णिकाच मुखिका महाग्रीवा महामुखी ।\nउल्कामुखी धूमशिखा कम्पिनी परिकम्पिनी ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005706024, "chapter_id": 25706, "verse_number": "१७९-२५", "content_sanskrit": "मोहना कम्पनाक्ष्वेला निर्भया बाहुशाहिनी ।\nसर्पकर्णी तथैकाक्षी विशोका नन्दिनी तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005706025, "chapter_id": 25706, "verse_number": "१७९-२६", "content_sanskrit": "जोत्स्ना मुखी च रभसा निकुम्भा रक्तकम्पना ।\nअविकारा महाचित्रा चन्द्रसेना मनोरमा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005706026, "chapter_id": 25706, "verse_number": "१७९-२७", "content_sanskrit": "अदर्शना हरत्पापा मातङ्गी लम्बमेखला ।\nअवाला वञ्चना काली प्रमोदा लाङ्गलावती ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005706027, "chapter_id": 25706, "verse_number": "१७९-२८", "content_sanskrit": "चित्ता चित्तजला कोणा शान्तिकाघविनाशिनी ।\nलम्बस्तनी लम्बसटा विसटा वासचूर्णिनी ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005706028, "chapter_id": 25706, "verse_number": "१७९-२९", "content_sanskrit": "स्खलन्ती दीर्घकेशीच सुचिरा सुन्दरी शुभा ।\nअयोमुखी कटुमुखी क्रोधनीच तथाशनी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005706029, "chapter_id": 25706, "verse_number": "१७९-३०", "content_sanskrit": "कुटुम्बिका मुक्तिका च चन्द्रिका बलमोहिनी ।\nसामान्या हासिनी लम्बा कोविदारी समासवी ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005706030, "chapter_id": 25706, "verse_number": "१७९-३१", "content_sanskrit": "कङ्कुकर्णी महानादा महादेवी महोदरी ।\nहुङ्कारी रुद्रसुसटा रुद्रेशी भूतडामरी ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005706031, "chapter_id": 25706, "verse_number": "१७९-३२", "content_sanskrit": "पिण्डजिह्वा चलज्ज्वाला शिवा ज्वालामुखी तथा ।\nएताश्चान्याश्च देवेशः सोऽसृजन्मातरस्तदा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005706032, "chapter_id": 25706, "verse_number": "१७९-३३", "content_sanskrit": "अन्धकानां महाघोराः पपुस्तद्रुधिरं तदा ।\nततोऽन्धकासृजः सर्वाः परां तृप्तिमुपागताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005706033, "chapter_id": 25706, "verse_number": "१७९-३४", "content_sanskrit": "तासु तृप्तासु सम्भूता भूय एवान्धकप्रजाः ।\nअर्दितस्तैर्महादेवः शूलमुद्गर पाणिभिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005706034, "chapter_id": 25706, "verse_number": "१७९-३५", "content_sanskrit": "ततः स शङ्करो देवस्त्वन्धकै र्व्याकुलीकृतः ।\nजगाम शरणं देवं वासुदेवमजं विभुम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005706035, "chapter_id": 25706, "verse_number": "१७९-३६", "content_sanskrit": "ततस्तु भगवान् विष्णुः सृष्टवान् शुष्करेवतीम् ।\nया पपौ सकलन्तेषामन्धकानामसृक् क्षणात् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005706036, "chapter_id": 25706, "verse_number": "१७९-३७", "content_sanskrit": "तथा तथाऽधिकं देवी संशुष्यति जनाधिप! ।\nपीयमाने तथातेषामन्धकानां तथासृजि  ।\nअन्धकास्तु क्षयन्नीताः सर्वं ते त्रिपुरारिणा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005706037, "chapter_id": 25706, "verse_number": "१७९-३८", "content_sanskrit": "मूलान्धकन्तु विक्रम्य तदा शर्वस्त्रिलोकधृक् ।\nचकार वेगाच्छूलाग्रे स चतुष्टाव शङ्करम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005706038, "chapter_id": 25706, "verse_number": "१७९-३९", "content_sanskrit": "अन्धकस्तु महावीर्यस्तस्य तुष्टोऽभवद् भवः ।\nसामीप्यं प्रददौ नित्यं गणेशत्वं तथैव च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005706039, "chapter_id": 25706, "verse_number": "१७९-४०", "content_sanskrit": "ततो मातृगणाः सर्वे शङ्करं वाक्यमब्रुवन् ।\nभगवन्! भक्षयिष्यामः स देवासुरमानुषान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005706040, "chapter_id": 25706, "verse_number": "१७९-४१", "content_sanskrit": "त्वत्प्रसादाज्जगत् सर्वं तदनुज्ञातुमर्हसि ।\nशङ्कर उवाच ।\nभवतीभिः प्रजाः सर्वा रक्षणीया न संशयः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005706041, "chapter_id": 25706, "verse_number": "१७९-४२", "content_sanskrit": "तस्माद्घोरानभिप्रायान्मनः शीघ्रं निवर्त्यताम् ।\nइत्येवं शङ्करेणोक्तमनादृत्य वचस्तदा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005706042, "chapter_id": 25706, "verse_number": "१७९-४३", "content_sanskrit": "भक्षयामासुरत्युग्रास्त्रैलोक्यं सचराचरम् ।\nत्रैलोक्ये भक्ष्यमाणे तु तदा मातृगणेन वै ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005706043, "chapter_id": 25706, "verse_number": "१७९-४४", "content_sanskrit": "नृसिंहमूर्तिं देवेशं प्रदध्यौ भगवाञ्छिवः ।\nअनादिनिधनं देवं सर्वलोक भवोद्भवम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005706044, "chapter_id": 25706, "verse_number": "१७९-४५", "content_sanskrit": "दैत्येन्द्रवक्षोरुधिर चर्चिताग्र महानखम् ।\nविद्युज्जिह्वं महादंष्ट्रं स्फुरत्केसरकण्टकम् ॥कल्पान्तमारुतक्षुब्धं सप्तपर्ण समस्वनम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005706045, "chapter_id": 25706, "verse_number": "१७९-४६", "content_sanskrit": "वज्रतीक्ष्णनखं घोरमाकर्ण-व्यादिताननम् ।\nमेरुशैलप्रतीकाशमुदयार्कसमेक्षणम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005706046, "chapter_id": 25706, "verse_number": "१७९-४७", "content_sanskrit": "हिमाद्रिशिखराकारं चारुदंष्ट्रोज्वलाननम् ।\nनखनिःसृतरोषाग्नि ज्वाला केसरमालिनम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005706047, "chapter_id": 25706, "verse_number": "१७९-४८", "content_sanskrit": "वज्राङ्गदं सुमुकुटं हारकेयूरभूषणम् ।\nश्रोणीसूत्रेण महता काञ्चनेन विराजितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005706048, "chapter_id": 25706, "verse_number": "१७९-४९", "content_sanskrit": "नीलोत्पलदलश्यामं वासोयुगविभूषणम् ।\nतेजसाक्रान्तसकल ब्रह्माण्डागार सङ्कुलम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005706049, "chapter_id": 25706, "verse_number": "१७९-५०", "content_sanskrit": "पवनं भ्राम्यमाणानां हुतहव्य-वहार्चिषाम् ।\nआवर्तसदृशाकारैः संयुक्तं देहलोमजैः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005706050, "chapter_id": 25706, "verse_number": "१७९-५१", "content_sanskrit": "सर्वपुष्पविचित्राञ्च दारयन्तं महास्रजम् ।\nस ध्यातमात्रो भगवान् प्रददौ तस्य दर्शनम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005706051, "chapter_id": 25706, "verse_number": "१७९-५२", "content_sanskrit": "यादृशेनैवरूपेण ध्याते रुद्रेण धीमता ।\nतादृशेनैव रूपेण दुर्निरीक्ष्येण दैवतैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005706052, "chapter_id": 25706, "verse_number": "१७९-५३", "content_sanskrit": "प्रणिपत्य तु देवेशं तदा तुष्टाव शङ्करः ।\nशङ्कर उवाच ।\nनमस्तेऽतु जगन्नाथ! नरसिंह वपुर्धर! ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005706053, "chapter_id": 25706, "verse_number": "१७९-५४", "content_sanskrit": "दैत्यनाथासृजापूर्ण! नखशक्ति विराजित! ।\nततः सकल संलग्ने हेमपिङ्गलविग्रह! ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005706054, "chapter_id": 25706, "verse_number": "१७९-५५", "content_sanskrit": "नतोऽस्मि पद्मनाभ! त्वां सुरशक्र! जगद्गुरो! ।\nकल्पान्ताम्भोदनिर्घोष! सूर्यकोटिसमप्रभ ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005706055, "chapter_id": 25706, "verse_number": "१७९-५६", "content_sanskrit": "सहस्रयमसङ्क्रोध! सहस्रेन्द्रपराक्रम! ।\nसहस्रधनदस्फीत! सहस्रवरुणात्मक! ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005706056, "chapter_id": 25706, "verse_number": "१७९-५७", "content_sanskrit": "सहस्रकालरचित! सहस्रनियतेन्द्रिय! ।\nसहस्रभूमिसद्धैर्य! सहस्रानन्त! मूर्तिमन्! ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005706057, "chapter_id": 25706, "verse_number": "१७९-५८", "content_sanskrit": "सहस्रचन्द्रप्रतिम! सहस्रग्रहविक्रम! ।\nसहस्ररुद्रतेजस्क! सहस्रब्रह्मसंस्तुत! ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005706058, "chapter_id": 25706, "verse_number": "१७९-५९", "content_sanskrit": "सहस्रबाहुवर्गोग्र! सहस्रास्य निरीक्षण! ।\nसहस्रयन्त्रमथन! सहस्रवधमोचन! ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005706059, "chapter_id": 25706, "verse_number": "१७९-६०", "content_sanskrit": "अन्धकस्य विनाशाय याः सृष्टाः मातरो मया ।\nअनादृत्य तु मद्वाक्यम् भक्षयन्त्यद्यताः प्रजाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005706060, "chapter_id": 25706, "verse_number": "१७९-६१", "content_sanskrit": "कृत्वा ताश्च न शक्तोऽहं संहर्तुमपराजित! ।\nस्वयङ्कृत्वा कथन्तासां विनाशमभिकारये ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005706061, "chapter_id": 25706, "verse_number": "१७९-६२", "content_sanskrit": "एवमुक्तः स रुद्रेण नरसिंहवपुर्धरः ।\nससर्ज देवो जिह्वायास्तदावाणीश्वरीं हरिः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005706062, "chapter_id": 25706, "verse_number": "१७९-६३", "content_sanskrit": "हृदयाच्च तथा माया गुह्याच्च भवमालिनी ।\nअस्थिभ्यश्च तथाकाली सृष्टा पूर्वं महात्मना ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005706063, "chapter_id": 25706, "verse_number": "१७९-६४", "content_sanskrit": "यया तद्रुधिरम्पीतमन्धकानां महात्मनाम् ।\nयाचास्मिन्कथिता लोके नामतः शुष्करेवती ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005706064, "chapter_id": 25706, "verse_number": "१७९-६५", "content_sanskrit": "द्वात्रिंशन्मातरः सृष्टा गात्रेभ्यश्चक्रिणा ततः ।\nतासां नामानि वक्ष्यामि तानि मे गदतः श्रुणु ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005706065, "chapter_id": 25706, "verse_number": "१७९-६६", "content_sanskrit": "सर्वास्तासु महाभागा घण्टाकर्णी तथैव च ।\nत्रैलोक्यमोहिनी पुण्या सर्वसत्व वशङ्करी ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005706066, "chapter_id": 25706, "verse_number": "१७९-६७", "content_sanskrit": "तथा च चक्रहृदया पञ्चमी व्योमचारिणी ।\nशङ्खिनी लेखिनी चैव कालसङ्कर्षणी तथा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005706067, "chapter_id": 25706, "verse_number": "१७९-६८", "content_sanskrit": "इत्येतः पृष्ठगा राजन्! वागीशानुचराः स्मृताः ।\nसङ्कर्षणी तथाश्वत्था वीजभावा पराजिता ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005706068, "chapter_id": 25706, "verse_number": "१७९-६९", "content_sanskrit": "कल्याणी मधुदंष्ट्री च कमलोत्पल हस्तिका ।\nइति देव्यष्टकं राजन्! मायानुचरमुच्यते ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005706069, "chapter_id": 25706, "verse_number": "१७९-७०", "content_sanskrit": "अजिता सूक्ष्महृदया वृद्धा वेशाश्म दंशना ।\nनृसिंसभैरवा बिल्वा गरुत्महृदया जया ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005706070, "chapter_id": 25706, "verse_number": "१७९-७१", "content_sanskrit": "भवमालिन्यनुचरा इत्यष्टौ नृपमातरः ।\nआकर्णनी सम्भटा च तथैवोत्तरमालिका ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005706071, "chapter_id": 25706, "verse_number": "१७९-७२", "content_sanskrit": "ज्वालामुखी भीषणिका कामधेनुश्च बालिका ।\nतथा पद्मकरा राजन्! रेवत्यनुचराः स्मृताः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005706072, "chapter_id": 25706, "verse_number": "१७९-७३", "content_sanskrit": "अष्टौ महाबलाः सर्वा देवगात्र समुद्भवाः ।\nत्रैलोक्यसृष्टिसंहार समर्थाः सर्वदेवताः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005706073, "chapter_id": 25706, "verse_number": "१७९-७४", "content_sanskrit": "ताः सृष्टमात्रा देवेन क्रुद्धा मातृगणस्य तु ।\nप्रधाविता महाराज! क्रोधविस्फारितेक्षणाः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005706074, "chapter_id": 25706, "verse_number": "१७९-७५", "content_sanskrit": "अविषह्य तमन्तासां दृष्टितेजः सुदारुणम् ।\nतमेव शरणं प्राप्ता नृसिंहो वाक्यमब्रवीत् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005706075, "chapter_id": 25706, "verse_number": "१७९-७६", "content_sanskrit": "यथा मनुष्याः पशवः पालयन्ति चिरात् सुतान् ।\nजयन्ति ते तथैवाशु यथा वै देवतागणः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005706076, "chapter_id": 25706, "verse_number": "१७९-७७", "content_sanskrit": "भवत्यस्तु तथालोकान्पालयन्तु मयेरिताः ।\nमनुजैश्च तता देवैर्यजध्वं त्रिपुरान्तकम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005706077, "chapter_id": 25706, "verse_number": "१७९-७८", "content_sanskrit": "नच बाधा प्रकर्तव्या ये भक्ता स्त्रिपुरान्तके ।\nयेच मां संस्मरन्तीह ते च रक्ष्याः सदा नराः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005706078, "chapter_id": 25706, "verse_number": "१७९-७९", "content_sanskrit": "बलिकर्म करिष्यन्ति युष्माकं ये सदा नराः ।\nसर्वकामप्रदास्तेषां भविष्यध्वन्तथैव च ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7005706079, "chapter_id": 25706, "verse_number": "१७९-८०", "content_sanskrit": "उच्छासनादिकं ये च कथयन्ति मयेरितम् ।\nते च रक्ष्याः सदालोका रक्षितव्यं मदासनम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7005706080, "chapter_id": 25706, "verse_number": "१७९-८१", "content_sanskrit": "रौद्रीं चैव परां मूर्तिं महादेवः प्रदास्यति ।\nयुष्मन्मुख्या महादेव्यस्तदुक्तं परिरक्षय ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7005706081, "chapter_id": 25706, "verse_number": "१७९-८२", "content_sanskrit": "मया मातृगणः सृष्टो योऽयं विगतसाध्वसः ।\nएष नित्यं विशालाक्ष्यो मयैव सह रंस्यते ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7005706082, "chapter_id": 25706, "verse_number": "१७९-८३", "content_sanskrit": "मया सार्द्धं तथा पूजां नरेभ्यश्चैव लप्स्यथ ।\nपृथक् सुपूजिता लोकैः सर्वान् कामान् प्रदास्यथ ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7005706083, "chapter_id": 25706, "verse_number": "१७९-८४", "content_sanskrit": "शुष्कां सम्पूजयिष्यन्ति ये च पुत्रार्थिनो जनाः ।\nतेषां पुत्रप्रदा देवी भविष्यन्ति न संशयः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7005706084, "chapter_id": 25706, "verse_number": "१७९-८५", "content_sanskrit": "एवमुक्त्वा तु भगवान् सह मातृगणेन तु ।\nज्वाला मालाकुलवपुस्तत्रैवान्तरधीयत ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7005706085, "chapter_id": 25706, "verse_number": "१७९-८६", "content_sanskrit": "तत्र तीर्थं समुत्पन्नं कृतशौचेति यज्जगुः ।\nतत्रापि पूर्वजो देवो जगदार्तिहरो हरः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7005706086, "chapter_id": 25706, "verse_number": "१७९-८७", "content_sanskrit": "रौद्रस्य मातृवर्गस्य दत्त्वा रुद्रस्तु पार्थिव ।\nरौद्रां दिव्यां तनुं तत्र मातृ मध्ये व्यवस्थितः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7005706087, "chapter_id": 25706, "verse_number": "१७९-८८", "content_sanskrit": "सप्त ता मातरो देव्यः सार्द्धनारीनरः शिवः ।\nनिवेश्य रौद्रं तत् स्थानं तत्रैवान्तरधीयत ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7005706088, "chapter_id": 25706, "verse_number": "१७९-८९", "content_sanskrit": "स मातृवर्गस्य हरस्य मूर्तिर्यदा यदा याति च तत्समीपे ।\nदेवेश्वरस्यापि नृसिंहमूर्तेः पूजां विधत्ते त्रिपुरान्धकारिः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]