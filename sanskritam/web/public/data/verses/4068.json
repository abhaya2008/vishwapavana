[{"id": 2142349, "chapter_id": 4068, "verse_number": "", "content_sanskrit": "उपप्लाव्ये रामकृष्णादीनां द्रुपदादीनां च समागमः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142350, "chapter_id": 4068, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142351, "chapter_id": 4068, "verse_number": "१", "content_sanskrit": "ततस्त्रयोदशे वर्षे निवृत्ते पञ्च पाण्डवाः ।\nउपप्लाव्ये विराटस्य वासं चक्रुः पुरोत्तमे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142352, "chapter_id": 4068, "verse_number": "२", "content_sanskrit": "ततो मित्रेषु सर्वेषु वासुदेवे च भारत ।\nप्रेषयामास कौन्तेयो विराटश्च महीपतिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2142353, "chapter_id": 4068, "verse_number": "३", "content_sanskrit": "तेषु तत्रोपविष्टेषु प्रेषितेषु ततस्ततः ।\nतत्रागमन्महाबाहुर्वनमाली हलायुधः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2142354, "chapter_id": 4068, "verse_number": "४", "content_sanskrit": "तस्मिन् काले निशम्याथ दूतवाक्यं जनार्दनः ।\nदयितं स्वस्रियं पुत्रं सुभद्रायाः सुमानितम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2142355, "chapter_id": 4068, "verse_number": "५", "content_sanskrit": "अभिमन्युं समादाय रामेण सहितस्तदा ।\nसर्वयादवमुख्यैश्च संवृतः परवीरहा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2142356, "chapter_id": 4068, "verse_number": "६", "content_sanskrit": "शङ्खदुन्दुभिनिर्घोषैर्विराटनगरं ययौ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2142357, "chapter_id": 4068, "verse_number": "७", "content_sanskrit": "कृतवर्मा च हार्दिक्यो युयुधानश्च सात्यकिः ।\nअनाधृष्टिस्तथाऽक्रूरः साम्बो निशठ एव च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2142358, "chapter_id": 4068, "verse_number": "८", "content_sanskrit": "प्रद्युम्नश्च महाबाहुरुल्मुकश्च महाबलः ।\nअभिमन्युमुपादाय सह मात्रा परन्तपाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2142359, "chapter_id": 4068, "verse_number": "९", "content_sanskrit": "कृष्णेन सहिताः सर्वे पाण्डवान् द्रष्टुमागताः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2142360, "chapter_id": 4068, "verse_number": "१०", "content_sanskrit": "शतनागसहस्राणि रथानां च शतायुतम् ।\nहयानामर्बुदं पूर्णं निखर्वं च पदातयः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2142361, "chapter_id": 4068, "verse_number": "११", "content_sanskrit": "वृष्ण्यन्धकाश्च शतशो भोजाश्च परमौजसः ।\nअन्वयुर्वृष्णिशार्दूलं वासुदेवं महाद्युतिम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2142362, "chapter_id": 4068, "verse_number": "१२", "content_sanskrit": "इन्द्रसेनादयश्चैव रथैस्तैः सुसमाहितैः ।\nउपेयुः सादिनः सर्वे परिसंवत्सरोषिताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2142363, "chapter_id": 4068, "verse_number": "१३", "content_sanskrit": "वासुदेवं तदाऽऽयान्तं श्रुत्वा पाण्डुसुतास्तदा ।\nमात्स्येन सहिताः सर्वे प्रत्युद्याता जनार्दनम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2142364, "chapter_id": 4068, "verse_number": "१४", "content_sanskrit": "शङ्खदुन्दुभिनिर्घोषैर्मङ्गलैश्च जनार्दनम् ।\nववन्दुर्मुदिताः सर्वे पादयोस्तस्य पाण्डवाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2142365, "chapter_id": 4068, "verse_number": "१५", "content_sanskrit": "मात्स्येन सहिताः सर्वे आनन्दाश्रुपरिप्लुताः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2142366, "chapter_id": 4068, "verse_number": "", "content_sanskrit": "पाण्डवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2142367, "chapter_id": 4068, "verse_number": "१६", "content_sanskrit": "तव कृष्ण प्रसादाद् वै वर्षाण्येतानि सर्वशः ।\nत्रयोदशोऽपि दाशार्ह यथा स समयः कृतः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2142368, "chapter_id": 4068, "verse_number": "१७", "content_sanskrit": "उषिताः स्मो जगन्नाथ त्वं नाथो नो जनार्दन\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2142369, "chapter_id": 4068, "verse_number": "१८", "content_sanskrit": "रक्षस्व देवदेवेश त्वामद्य शरणं गताः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2142370, "chapter_id": 4068, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2142371, "chapter_id": 4068, "verse_number": "१९", "content_sanskrit": "तान् वन्दमानान् सहसा परिष्वज्य जनार्दनः ।\nविराटस्य सहायांस्तान् सर्वयादवसंवृतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2142372, "chapter_id": 4068, "verse_number": "२०", "content_sanskrit": "यथार्हं पूजयामास मुदा परमया युतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2142373, "chapter_id": 4068, "verse_number": "२१", "content_sanskrit": "वृष्णिवीराश्च तान् सर्वान् यथार्हं प्रतिपेदिरे ।\nकृष्णा च देवकीपुत्रं ववन्दे पादयोस्तथा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2142374, "chapter_id": 4068, "verse_number": "२२", "content_sanskrit": "तामुद्यम्य सुसंहृष्टो नयने परिमार्ज्य च ।\nउवाच वाक्यं देवेशः सर्वयादवसन्निधौ\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2142375, "chapter_id": 4068, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2142376, "chapter_id": 4068, "verse_number": "२३", "content_sanskrit": "मा शोकं कुरु कल्याणि धार्तराष्ट्रान् समाहितान् ।\nअचिराद् घातयित्वाऽहं पार्थेन सहितः क्षितिम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2142377, "chapter_id": 4068, "verse_number": "२४", "content_sanskrit": "युधिष्ठिराय दास्यामि यातु ते मानसो ज्वरः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2142378, "chapter_id": 4068, "verse_number": "२५", "content_sanskrit": "अभिमन्युना च पार्थेन रौग्मिणेयेन ते शपे ।\nसत्यमेतद् वचो मह्यमवेहि त्वमनिन्दिते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2142379, "chapter_id": 4068, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2142380, "chapter_id": 4068, "verse_number": "२६", "content_sanskrit": "इत्युक्त्वा तां विसृज्याथ प्रीयमाणो युधिष्ठिरम् ।\nअन्वास्त वृष्णिशार्दूलः सह वृष्ण्यन्धकैस्तदा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2142381, "chapter_id": 4068, "verse_number": "२७", "content_sanskrit": "काशिराजश्च शैब्यश्च भजमानौ युधिष्ठिरम् ।\nअक्षोहिणीभ्यां सहितावागतौ पृथिवीपते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2142382, "chapter_id": 4068, "verse_number": "२८", "content_sanskrit": "अक्षोहिणीभिः पाञ्चालस्तिसृभिश्च महाबलः ।\nद्रौपद्याश्च सुता वीराः शिखण्डी चापराजितः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2142383, "chapter_id": 4068, "verse_number": "२९", "content_sanskrit": "धृष्टद्युम्नश्च दुर्धर्षः सर्वशस्त्रभृतां वरः ।\nउपप्लाव्यं ययुः शीघ्रं पाण्डवार्थे महाबलाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2142384, "chapter_id": 4068, "verse_number": "३०", "content_sanskrit": "ततः शतसहस्राणि प्रयुतान्यर्बुदानि च ।\nसमीपमभिवर्तन्ते योधा यौधिष्ठिरं बलम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2142385, "chapter_id": 4068, "verse_number": "३१", "content_sanskrit": "समुद्रमिव घर्मान्ते स्रोतःश्रेष्ठाः पृथक् पृथक् ।\nआपूरयन् महीपालाः सर्वे पाण्डुसुतं तदा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2142386, "chapter_id": 4068, "verse_number": "३२", "content_sanskrit": "वेदावभृथसम्पन्नाः शूराः सर्वे तनुत्यजः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2142387, "chapter_id": 4068, "verse_number": "३३", "content_sanskrit": "तानागतानभिप्रेक्ष्य पार्थो ज्ञानभृतां वरः ।\nपूजयामास विधिवद् यथार्हं राजसत्तमान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2142388, "chapter_id": 4068, "verse_number": "३४", "content_sanskrit": "पारिबर्हं ददौ कृष्णः पाण्डवानां महात्मनाम् ।\nस्त्रियो रत्नानि वासांसि पृथक्पृथगनेकशः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2142389, "chapter_id": 4068, "verse_number": "३५", "content_sanskrit": "राजानो राजपुत्राश्च निवृत्ते समये तथा ।\nयथार्हं पाण्डवश्रेष्ठे ह्यवर्तन्ताभिपूजिताः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2142390, "chapter_id": 4068, "verse_number": "३६", "content_sanskrit": "आसन् प्रहृष्टमनसः पारिबर्हं ददुस्तदा\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2142391, "chapter_id": 4068, "verse_number": "३७", "content_sanskrit": "तेषु तत्रोपविष्टेषु राजभिर्वृष्णिभिः सह ।\nविवाहो विधिवद् राजन् ववृधे कुरुमात्स्ययोः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2142392, "chapter_id": 4068, "verse_number": "३८", "content_sanskrit": "ततः शङ्खा मृदङ्गाश्च गोमुखा डिण्डिमास्तदा ।\nपार्थैः संयुज्यमानस्य नेदुर्मात्स्यस्य वेश्मनि\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2142393, "chapter_id": 4068, "verse_number": "३९", "content_sanskrit": "उच्चावचांस्तदा जघ्नुर्वाद्यसङ्घान् सहस्रशः ।\nभक्ष्यभोज्यान्नपानानि प्रभूतान्यभ्यहारयत्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2142394, "chapter_id": 4068, "verse_number": "४०", "content_sanskrit": "गायनाख्यानशीलाश्च नटा वैतालिकास्तथा ।\nस्तुवन्तस्तानुपातिष्ठन् सूताश्च सह मागधैः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2142395, "chapter_id": 4068, "verse_number": "४१", "content_sanskrit": "स्त्रियो वृद्धाः कुटुम्बिन्य उत्सवज्ञाश्च मङ्गले ।\nद्रौपद्यन्तःपुरे चैव विराटस्य गृहे स्त्रियः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2142396, "chapter_id": 4068, "verse_number": "४२", "content_sanskrit": "सुदेष्णां तु पुरस्कृत्य मत्स्यानां केवलाः स्त्रियः ।\nआजग्मुश्चारुपीनाङ्ग्यः समृष्टमणिकुण्डलाः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2142397, "chapter_id": 4068, "verse_number": "४३", "content_sanskrit": "कर्णोपपन्नास्ता नार्यो रूपवत्यः स्वलङ्कृताः ।\nसर्वाश्चाभ्यभवत् कृष्णा रूपेण वपुषा श्रिया\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2142398, "chapter_id": 4068, "verse_number": "४४", "content_sanskrit": "परिवार्योत्तरां श्लाघ्यां राजपुत्रीमलङ्कृताम् ।\nसुतामिव महेन्द्रस्य पुरस्कृत्योपतस्थिरे\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2142399, "chapter_id": 4068, "verse_number": "४५", "content_sanskrit": "भृङ्गारं तु समादाय सौवर्णं जलपूरितम् ।\nपार्थस्य हस्ते सहसा सुतामिन्दीवरेक्षणाम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2142400, "chapter_id": 4068, "verse_number": "४६", "content_sanskrit": "स्नुषार्थं प्राक्षिपद् वारि विराटो वाहिनीपतिः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2142401, "chapter_id": 4068, "verse_number": "४७", "content_sanskrit": "तां प्रत्यगृह्णात् कौन्तेयः सुतस्यार्थे महामनाः ।\nसौभद्रस्यानवद्याङ्गीं विराटतनयां तदा\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2142402, "chapter_id": 4068, "verse_number": "४८", "content_sanskrit": "तत्रातिष्ठन्महाराजो रूपमिन्द्रस्य धारयन् ।\nस्नुषां तां परिगृह्णानः कुन्तीपुत्रो युधिष्ठिरः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2142403, "chapter_id": 4068, "verse_number": "४९", "content_sanskrit": "द्रुपदश्च विराटश्च शिखण्डी च महायशाः ।\nकाशिराजश्च शैब्यश्च धृष्टद्युम्नश्च सात्यकिः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2142404, "chapter_id": 4068, "verse_number": "५०", "content_sanskrit": "सप्तैतेऽक्षोहिणीपाला यज्वानो भूरिदक्षिणाः ।\nपाण्डवं परिवार्याथ निवासं चक्रिरे तदा\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2142405, "chapter_id": 4068, "verse_number": "५१", "content_sanskrit": "तत्रस्थायां तु सेनायां विराटो जगतीपतिः ।\nप्रीतो दुहितरं गृह्य प्रददावभिमन्यवे\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2142406, "chapter_id": 4068, "verse_number": "५२", "content_sanskrit": "मुदा गृह्योत्तरां पार्थ आनाय्य च जनार्दनम् ।\nविवाहं कारयामास सौभद्रस्य महात्मनः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2142407, "chapter_id": 4068, "verse_number": "५३", "content_sanskrit": "ततो विवाहो ववृते स्थितः सर्वगुणान्वितः ।\nसौभद्रस्याद्भुतश्चैव पितुस्तव पितुस्तदा\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2142408, "chapter_id": 4068, "verse_number": "५४", "content_sanskrit": "धौम्यः शिष्यैः परिवृतो जुहावाग्नौ विधानतः ।\nअग्निं प्रदक्षिणीकुर्वन् सौभद्रः पाणिमग्रहीत्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2142409, "chapter_id": 4068, "verse_number": "५५", "content_sanskrit": "ततः सभार्यः संहृष्टो मत्स्यराजो धनं महत् ।\nतस्मै शतसहस्राणि हयानां वातरंहसाम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2142410, "chapter_id": 4068, "verse_number": "५६", "content_sanskrit": "द्वे गजानां शते मुख्ये विराटः प्रददौ पिता ।\nप्रादान्मत्स्यपतिर्हृष्टः कन्याधनमनुत्तमम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2142411, "chapter_id": 4068, "verse_number": "५७", "content_sanskrit": "पारिबर्हं च पार्थस्य प्रददौ मत्स्यपुङ्गवः ।\nकृष्णेन सह कौन्तेयः प्रत्यगृह्णात् परन्तपः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2142412, "chapter_id": 4068, "verse_number": "५८", "content_sanskrit": "कृते विवाहे तु तदा धर्मपुत्रो युधिष्ठिरः ।\nब्राह्मणेभ्यो ददौ वित्तं यदुपाहरदच्युतः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2142413, "chapter_id": 4068, "verse_number": "५९", "content_sanskrit": "गोसहस्राणि रत्नानि वस्त्राणि विविधानि च ।\nभूषणानि च सर्वाणि यानानि शयनानि च\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2142414, "chapter_id": 4068, "verse_number": "६०", "content_sanskrit": "पट्टवासांसि चित्राणि दासीदासान् बहून् ददौ ।\nनागरान् प्रीतिभिर्दिव्यैस्तर्पयामास भूपतिः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2142415, "chapter_id": 4068, "verse_number": "६१", "content_sanskrit": "तन्महोत्सवसङ्काशं हृष्टपुष्टजनाकुलम् ।\nनगरं मत्स्यराजस्य शुशुभे भरतर्षभ\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2142416, "chapter_id": 4068, "verse_number": "६२", "content_sanskrit": "पुरोहितैरमात्यैश्च पौरैर्जानपदैः सह ।\nविराटो नृपतिः श्रीमान् सौभद्रायाभिमन्यवे\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2142417, "chapter_id": 4068, "verse_number": "६३", "content_sanskrit": "तां सुतामुत्तरां दत्त्वा मुमुदे परमां तदा\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2142418, "chapter_id": 4068, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2142419, "chapter_id": 4068, "verse_number": "६४", "content_sanskrit": "वृत्ते विवाहे हृष्टात्मा यदुवाच युधिष्ठिरः ।\nतत्सर्वं कथयस्वेह कृतवन्तो यदुत्तरम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2142420, "chapter_id": 4068, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि षट्सप्ततितमोऽध्यायः ॥७६॥\nवैवाहिकपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2142421, "chapter_id": 4068, "verse_number": "", "content_sanskrit": "॥ समाप्तं वैवाहिकपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2142422, "chapter_id": 4068, "verse_number": "", "content_sanskrit": "॥ समाप्तं विराटपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2142423, "chapter_id": 4068, "verse_number": "", "content_sanskrit": "॥ श्रीमध्वेशार्पणमस्तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]