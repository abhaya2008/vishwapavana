[{"id": 7005494000, "chapter_id": 25494, "verse_number": "२-११-१", "content_sanskrit": "ईश्वर उवाच ।\nअतः परं प्रवक्ष्यामि योगं परमदुर्लभम ।\nयेनात्मानं प्रपश्यन्ति भानुमन्तमिवेश्वरम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005494001, "chapter_id": 25494, "verse_number": "२-११-२", "content_sanskrit": "योगाग्निर्दहति क्षीप्रमशेहं पापपत्र्जरम ।\nप्रसन्नं जायते ज्ञानं साक्षन्निर्वाणसिद्धदम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005494002, "chapter_id": 25494, "verse_number": "२-११-३", "content_sanskrit": "योगात संजायते ज्ञानं ज्ञानाद योगः प्रवर्तते ।\nयोगज्ञानाभियुक्तस्यं प्रसीदति महेश्वरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005494003, "chapter_id": 25494, "verse_number": "२-११-४", "content_sanskrit": "एकाकलां द्विकलं वा त्रिकालं नित्यमेव वा ।\nये युत्र्जन्तीह मद्योगं ते विज्ञेय महेश्वराः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005494004, "chapter_id": 25494, "verse_number": "२-११-५", "content_sanskrit": "योगस्तु द्विविधो ज्ञेयो ह्माभवः प्रथमो मतः ।\nअपरस्तु महायोगः सर्वयोगोत्तमोत्तमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005494005, "chapter_id": 25494, "verse_number": "२-११-६", "content_sanskrit": "शुन्यं सर्वनिराभासं स्वरुपं यत्र चिन्त्यते ।\nअभागयोगः स प्रोक्तो येनात्मनं प्रपश्यति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005494006, "chapter_id": 25494, "verse_number": "२-११-७", "content_sanskrit": "यत्र पश्यति चात्मानं नित्यानदं निरत्र्जनम ।\nमयैक्यं स महायोगी भाषितं परमेश्वरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005494007, "chapter_id": 25494, "verse_number": "२-११-८", "content_sanskrit": "ये चान्ये योगिनां योगाः श्रुयन्ते ग्रन्थाविस्तरे ।\nसर्वे ते ब्रह्मायोगस्य कलां नार्हन्ति षोडशीम ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005494008, "chapter_id": 25494, "verse_number": "२-११-९", "content_sanskrit": "यत्र साक्षत प्रपश्यन्ति विमुक्ता विश्‍वमीश्वरम ।\nसर्वेषामेव योगानां स योगः परमो मतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005494009, "chapter_id": 25494, "verse_number": "२-११-१०", "content_sanskrit": "सहस्त्रशोऽथं शतशो ये चेश्वरबहिकृताः ।\nन ते पश्यन्ति मामेकं योगिनो यतमानसाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005494010, "chapter_id": 25494, "verse_number": "२-११-११", "content_sanskrit": "प्राणायामस्तथा ध्यानं प्रत्याहारोऽथ धारणा ।\nसमाधिश्च मुनिश्रेष्ठा यमो नियम आसनम ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005494011, "chapter_id": 25494, "verse_number": "२-११-१२", "content_sanskrit": "मय्येकचित्तत्तायोगो वृत्यन्तरनिरोधतः ।\nतत्साधनान्यष्टधा तु युष्माकं कथितानि तु ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005494012, "chapter_id": 25494, "verse_number": "२-११-१३", "content_sanskrit": "अहिंसा सत्यमस्तेयं ब्रह्माचर्यापरिग्रहौ ।\nयमाः संक्षेपतः प्रोक्ताश्चित्तशुद्धिप्रदा नृणाम ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005494013, "chapter_id": 25494, "verse_number": "२-११-१४", "content_sanskrit": "कर्मणा मनसा वाचा सर्वभुत्षु सर्वदा ।\nअक्लेशजननं प्रोक्तं त्वहिंसा परमार्षिभिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005494014, "chapter_id": 25494, "verse_number": "२-११-१५", "content_sanskrit": "अहिंसायाः परो धर्मो नास्त्यहिम्सा परं सुखम ।\nविधिना या भवेद्धिंसा त्वहिंसैव प्रकीर्तिता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005494015, "chapter_id": 25494, "verse_number": "२-११-१६", "content_sanskrit": "सत्येन सर्वमाप्नोति सत्ये सर्वं प्रतिष्ठितम ।\nयथार्थकथानाचारः सत्यं प्रोक्तं द्विजातिभिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005494016, "chapter_id": 25494, "verse_number": "२-११-१७", "content_sanskrit": "परद्रव्यापहरणं चौर्याद वाथ बलेन वा ।\nस्तेयं तस्यानाचरणदस्तेयं धर्मसाधनम ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005494017, "chapter_id": 25494, "verse_number": "२-११-१८", "content_sanskrit": "कर्मणा मनसा वाच सर्वावस्थासु सर्वदा ।\nसर्वत्र मैथुनत्यगं ब्रह्माचर्य प्रचक्षते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005494018, "chapter_id": 25494, "verse_number": "२-११-१९", "content_sanskrit": "द्रव्यणमप्यन्दानमापद्यपि यथेच्छाया ।\nअपरिग्रह इत्याहुस्तं प्रयत्‍नेन पालयेत ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005494019, "chapter_id": 25494, "verse_number": "२-११-२०", "content_sanskrit": "तपः स्वध्यायसंतोषाः शौचमीश्वरपुजनम ।\nसमसन्नियमाः प्रोक्त योगसिद्धप्रदायिनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005494020, "chapter_id": 25494, "verse_number": "२-११-२१", "content_sanskrit": "उपवासपराकादिकृश्च्छ्रचान्दायणादिभिः ।\nशरीरशोषणं प्राहुस्तापसास्तप उत्तमम ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005494021, "chapter_id": 25494, "verse_number": "२-११-२२", "content_sanskrit": "वेदान्तशतरुद्रीयप्रणवादिजपं बुधाः ।\nसत्वशुद्धिकरं पुंसां स्वाध्यायं परिचक्षते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005494022, "chapter_id": 25494, "verse_number": "२-११-२३", "content_sanskrit": "स्वाध्यायस्य त्रयो भेदा वाचिकोपांशुमानसाः ।\nउत्तरोत्तरवैशष्टयं प्राहुर्वेदार्थवेदिनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005494023, "chapter_id": 25494, "verse_number": "२-११-२४", "content_sanskrit": "यः शद्द्बाबोधजननः परेषा श्रुण्वतां स्फूटम ।\nस्वाध्यायी वाचिकः प्रोक्त उपांशोरथ लक्षणम ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005494024, "chapter_id": 25494, "verse_number": "२-११-२५", "content_sanskrit": "ओष्ठयोः स्पन्दमात्रेण परस्याशब्दबोधकः ।\nउपांशुरेषु निर्दिष्टः साहस्त्रों वाचिकाज्जपः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005494025, "chapter_id": 25494, "verse_number": "२-११-२६", "content_sanskrit": "यत्पदाक्षरसंगत्या परिप्न्दनवर्जितम ।\nचिन्तन सर्वशब्दानां मानसं तं जपं विदुः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005494026, "chapter_id": 25494, "verse_number": "२-११-२७", "content_sanskrit": "यदृच्छालाभतो नित्यमलं पुंसोअ भवेदिति ।\nया धीस्तामृषयः प्राहुः संतोषं सुखलक्षणम ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005494027, "chapter_id": 25494, "verse_number": "२-११-२८", "content_sanskrit": "ब्राह्ममाभ्यन्तरं शौचं द्विधा प्रोक्तं द्विजोत्तमाः ।\nमृज्जलाभ्यां स्मृतं बाह्मं मनः शुद्धिरथान्तरम ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005494028, "chapter_id": 25494, "verse_number": "२-११-२९", "content_sanskrit": "स्तुतिस्मरणपुजाभिर्वागंन कायकर्मभिः ।\nसुनिश्चला शिवे भक्तिरेतदीश्वरपुजनम ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005494029, "chapter_id": 25494, "verse_number": "२-११-३०", "content_sanskrit": "यमाः सनियामाः प्रोक्ताः प्राणायामं निबोधत ।\nप्राणः स्वदेहजो वायुराजामस्तान्निरोधनम ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005494030, "chapter_id": 25494, "verse_number": "२-११-३१", "content_sanskrit": "उत्तमाधममध्यत्वात त्रिधायं प्रतिपादितः ।\nस एव द्विगिधः प्रोक्तः सगर्भाऽगर्भ एव च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005494031, "chapter_id": 25494, "verse_number": "२-११-३२", "content_sanskrit": "मात्राद्वादशको मन्दश्चर्विशातिमात्रिकः ।\nमध्यमः प्राणसंरोधः षटत्रिंशोन्मात्रिकोत्तमः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005494032, "chapter_id": 25494, "verse_number": "२-११-३३", "content_sanskrit": "प्रस्वेदकम्पनोत्थानजनकत्वं यथाक्रमम ।\nमन्दमध्यममुख्यानामनन्दादुत्तमोत्तमः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005494033, "chapter_id": 25494, "verse_number": "२-११-३४", "content_sanskrit": "सगर्भमाहुः सजपमगर्भ विजपं बुधाः ।\nएतद वै योगिनामुक्तं प्राणायामस्य लक्षणम ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005494034, "chapter_id": 25494, "verse_number": "२-११-३५", "content_sanskrit": "सव्याह्रतिं सप्रणवां गायत्रीं शिरसा सह ।\nत्रिर्जपेदायतप्राणः प्राणायामः स उच्यते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005494035, "chapter_id": 25494, "verse_number": "२-११-३६", "content_sanskrit": "रेचकः पूरकश्चैव प्राणायामोऽथ कुम्भकः ।\nप्रोच्यते सर्वशास्त्रेषु योगिभिर्यतमानसैः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005494036, "chapter_id": 25494, "verse_number": "२-११-३७", "content_sanskrit": "रेचकोऽजस्त्रनिःश्वासात पुरकस्तन्निरोधत ।\nसाम्येन संस्थितिर्या सा कुम्भक परिगीयते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005494037, "chapter_id": 25494, "verse_number": "२-११-३८", "content_sanskrit": "इन्द्रियाणां विचरतां विषयेषु स्वभावतः ।\nनिग्रहः प्रोच्यते सद्भिः प्रत्याहारस्तु सत्तमाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005494038, "chapter_id": 25494, "verse_number": "२-११-३९", "content_sanskrit": "हृत्पुण्डरीके नाभ्यां वा मूर्ध्नि पर्वतमस्तके ।\nएवमादिषु देशेषु धारणा चित्तबन्धनम ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005494039, "chapter_id": 25494, "verse_number": "२-११-४०", "content_sanskrit": "देशावस्थितिमालम्ब्य बुद्धेर्य वृत्तिसंतति ।\nवृत्यन्तरैरसंसृष्टा तद्धायानं सुरयो विदुः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005494040, "chapter_id": 25494, "verse_number": "२-११-४१", "content_sanskrit": "एकाकारः समाधिः स्याद देशालम्बनवर्जितःइति ।\nप्रत्ययो ह्रार्थमात्रेण योगसाधनमुत्तमम ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005494041, "chapter_id": 25494, "verse_number": "२-११-४२", "content_sanskrit": "धारणा द्वादशायमा ध्यानं द्वादश धारणाः ।\nध्यानं द्वादशाकं यावतं समधिरभिधीयते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005494042, "chapter_id": 25494, "verse_number": "२-११-४३", "content_sanskrit": "आसनं स्वस्तिकं प्रोक्तं पद्ममर्धासनं तथा ।\nसाधनांना च सर्वेषमेतत्साधनमुत्तमम ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005494043, "chapter_id": 25494, "verse_number": "२-११-४४", "content_sanskrit": "ऊर्वोरुपरि विप्रेनन्द्राः कृत्वा पादतले उभे ।\nसमासीतात्मनः पद्ममेतदानमुत्तमम ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005494044, "chapter_id": 25494, "verse_number": "२-११-४५", "content_sanskrit": "एकं पादमथैकस्मिन विन्यस्य्रुणि सत्तमाः ।\nआसीतार्धासनमिदं योगसाधनमुत्तमम ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005494045, "chapter_id": 25494, "verse_number": "२-११-४६", "content_sanskrit": "उभे कृत्वा पादतले जाणुर्वोरन्तरेण हि ।\nसमासीतात्मनः प्रोक्तमासनं स्वस्तिकं परम ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005494046, "chapter_id": 25494, "verse_number": "२-११-४७", "content_sanskrit": "अदेशकाले योगस्य दर्शन ही न विद्यते ।\nअग्न्यभ्यशे जले वापो शुष्कपर्ण चये तथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005494047, "chapter_id": 25494, "verse_number": "२-११-४८", "content_sanskrit": "जन्तुव्याप्ते श्‍मशाने च जीर्णगोष्ठे चतुष्पथे ।\nसशब्दे सभये वापि चैत्यवल्मीकसंचये ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005494048, "chapter_id": 25494, "verse_number": "२-११-४९", "content_sanskrit": "अशुभे दुर्जनाक्रान्ते मशकादिसमन्विते ।\nनाचरेद देहबाधे वा दौर्मनस्यादिसम्भवे ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005494049, "chapter_id": 25494, "verse_number": "२-११-५०", "content_sanskrit": "सुगुप्ते सुशुभेदेशे गुहायां पर्वतस्य तु ।\nनद्यास्तीरे पुण्यदेशे देवतायतने तथा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005494050, "chapter_id": 25494, "verse_number": "२-११-५१", "content_sanskrit": "गृहे वा सुशुभे रम्ये विजने जन्तुवर्जिते ।\nयुत्र्जीत योगी सततमात्मानं मप्तरायणः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005494051, "chapter_id": 25494, "verse_number": "२-११-५२", "content_sanskrit": "नमस्कृत्य तु योगीन्द्रान सशिष्यांश्रं विनायक ।\nगुरुं चैवाथ मां योगी युत्र्जीत सुसमाहितः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005494052, "chapter_id": 25494, "verse_number": "२-११-५३", "content_sanskrit": "आसनं स्वस्तिकं बद्धवा अद्ममर्धमथापि वा ।\nनासिकाग्रे समा दृश्टिमीषदुन्मीलितक्षणः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005494053, "chapter_id": 25494, "verse_number": "२-११-५४", "content_sanskrit": "कृत्वाथ निर्भयःशान्तस्त्यवक्त्या मायामयं जगत ।\nस्वात्मन्यवस्थितं देवं चिन्तयेत परमेश्वरम ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005494054, "chapter_id": 25494, "verse_number": "२-११-५५", "content_sanskrit": "शिखाग्रे द्वादशांगुल्ये कल्पयित्वाथ पंकजम ।\nधर्मकन्दसमुदभुत ज्ञाननालं सुशोभनम ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005494055, "chapter_id": 25494, "verse_number": "२-११-५६", "content_sanskrit": "ऐश्‍वर्याष्टदलं श्‍वेत परं वैराग्यकर्णिकम ।\nचिन्तयेत परम कोशं कर्णिकायां हिरणमयम ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005494056, "chapter_id": 25494, "verse_number": "२-११-५७", "content_sanskrit": "सर्वशक्तिमयं साक्षाद यं प्राहुर्दिव्यमव्ययम ।\nओंकार्वाच्यमव्यक्त रश्मिजालासमाकुलम ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005494057, "chapter_id": 25494, "verse_number": "२-११-५८", "content_sanskrit": "चिन्तयेत तत्र विमलं परं ज्योतिर्यदक्षरम ।\nतस्मिन ज्योतिषि विन्यस्य स्वात्मानं तदभेदतः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005494058, "chapter_id": 25494, "verse_number": "२-११-५९", "content_sanskrit": "ध्यायीताकाशमध्यस्थमीशं परमकारणम ।\nतदात्मा सर्वगो भूत्वा न किंचिदपि चिन्तयेत ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005494059, "chapter_id": 25494, "verse_number": "२-११-६०", "content_sanskrit": "एतद गुह्मातमं ध्यानं ध्यानान्तरमथोच्यते ।\nचिन्तयित्वा तु पुर्वाक्त हृदये पद्ममुत्तमम ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005494060, "chapter_id": 25494, "verse_number": "२-११-६१", "content_sanskrit": "आत्मनमथ कर्तारं तत्रानलसमत्विषम ।\nमध्ये वह्रिशिखाकारं पुरुषं पंचविशकम ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005494061, "chapter_id": 25494, "verse_number": "२-११-६२", "content_sanskrit": "चिन्तयेत परमात्मानं तन्ममध्ये गगन परम ।\nओंकारबोधितं तत्त्वं शाश्‍वतं शिवमच्युतम ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005494062, "chapter_id": 25494, "verse_number": "२-११-६३", "content_sanskrit": "अव्यक्तं प्रकृतौ लीनं परं ज्योतिरनुत्तमम ।\nतदन्तः परमं तत्त्वमात्माधारं निरत्र्जनम ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005494063, "chapter_id": 25494, "verse_number": "२-११-६४", "content_sanskrit": "ध्यायीत तन्मयो नित्यमेकरुपं महेश्‍वारम ।\nविशोध्य सर्वतत्वानि प्रणवेनाथवा पुनः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005494064, "chapter_id": 25494, "verse_number": "२-११-६५", "content_sanskrit": "संस्थाप्य मयि चात्मानं निर्मले परमे पदे ।\nप्लावयित्वात्मने देहं तेनैव ज्ञानवारिणा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005494065, "chapter_id": 25494, "verse_number": "२-११-६६", "content_sanskrit": "मदात्मा मन्मयो भस्म गृहीत्वा ह्माग्निहोत्रजम ।\nतेनोद्धत्य तु सर्वांगमिग्निरित्यादिमन्ग्त्रतः ।\nचिन्तयेत स्वात्मनीशान् परं ज्योति स्वरुपिणम ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005494066, "chapter_id": 25494, "verse_number": "२-११-६७", "content_sanskrit": "एष पाशुपतो योगः पशुपशविमुक्तये ।\nसर्ववेदान्तसारोऽयमत्याश्रमिति श्रुतिः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005494067, "chapter_id": 25494, "verse_number": "२-११-६८", "content_sanskrit": "एतत परतरं गुह्मं मत्सयुज्योपपादकम ।\nद्विजातीनां तु कथितं भक्तनां ब्रह्माचरिणाम ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005494068, "chapter_id": 25494, "verse_number": "२-११-६९", "content_sanskrit": "ब्रह्माचर्यमहिंसा च क्षमा शौचं तपो दमः ।\nसंतोषः सत्यमास्तिक्यं व्रतांगनि विशेषतः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005494069, "chapter_id": 25494, "verse_number": "२-११-७०", "content_sanskrit": "एकेनप्यथ हेनेन व्रतमस्य तु लुप्यते ।\nतस्मादात्मगुणोपेतो मदव्रतं वोषुमर्हति ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005494070, "chapter_id": 25494, "verse_number": "२-११-७१", "content_sanskrit": "ब्रीतरागयक्रोधा मन्मय मामुपश्रिताः ।\nबहवोऽनेने योगेन पुता मद्भावमागताः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005494071, "chapter_id": 25494, "verse_number": "२-११-७२", "content_sanskrit": "ये यथ मां प्रपद्यन्ते तांस्तथैव भजाम्यहम ।\nज्ञानयोगेन मां तस्माद यजेत परमेश्वरम ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005494072, "chapter_id": 25494, "verse_number": "२-११-७३", "content_sanskrit": "अथवा भक्तियोगेन वैराग्येण परेण तु ।\nचेतसा बोधयुक्तेन पुजयेन्मां सदा शुचिः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005494073, "chapter_id": 25494, "verse_number": "२-११-७४", "content_sanskrit": "सर्वकर्माणि संनस्य भिक्षाशी निष्पारिग्रहः ।\nप्राप्नोति मम सायुज्यं गुह्मामेतन्मयोदितम ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005494074, "chapter_id": 25494, "verse_number": "२-११-७५", "content_sanskrit": "अद्वेष्टा सर्वभुतानां मैत्रः करुण एव च ।\nनिर्ममो निरहंकारो यो मद्भक्तः स मे प्रियः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005494075, "chapter_id": 25494, "verse_number": "२-११-७६", "content_sanskrit": "संतुष्टः सततं योगी यतात्मा दृढनिश्चयः ।\nमययार्पितमनो बुद्धियों मद्भक्तः स मे प्रिय ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005494076, "chapter_id": 25494, "verse_number": "२-११-७७", "content_sanskrit": "यस्मान्नोद्विजते लोको लोकान्नोद्विजते च यः ।\nहर्षामर्षभयोद्वेगैर्मुक्तो यः स हि मे प्रियः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005494077, "chapter_id": 25494, "verse_number": "२-११-७८", "content_sanskrit": "अनपेक्षः शुचिर्दक्श उदासीनो गतव्यथः ।\nसर्वारम्भपरित्यगी भक्तिमानु य स मे प्रियः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005494078, "chapter_id": 25494, "verse_number": "२-११-७९", "content_sanskrit": "तुल्यनिन्दासुतित्मौनीं संतुष्टो येन केनचित ।\nअनिकेतःस्थिअरमर्तिर्मद्भक्तो मामुपैष्यति ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7005494079, "chapter_id": 25494, "verse_number": "२-११-८०", "content_sanskrit": "सर्वकर्माण्यपि सदा कुर्वाणो मत्परायणः ।\nमत्प्रसादादवाप्नोति शाश्वतं परमं पदम ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7005494080, "chapter_id": 25494, "verse_number": "२-११-८१", "content_sanskrit": "चेतसा सर्वकर्माणि मयि सन्यस्य मप्तरः ।\nनिराशीनिर्ममो भुत्वा मामेकं शरणं व्रजेत ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7005494081, "chapter_id": 25494, "verse_number": "२-११-८२", "content_sanskrit": "त्यक्त्वा कर्मफलासंग नित्यतृत्पो निराश्रयः ।\nकर्मण्यर्भिप्रवृतोऽपि नैव तैन निबध्यते ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7005494082, "chapter_id": 25494, "verse_number": "२-११-८३", "content_sanskrit": "निराशीर्यतचितात्मा त्यक्तसर्वपरिग्रहः ।\nशारीरं केवलं कर्म कुर्वन्नाप्नोत तत्पदम ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7005494083, "chapter_id": 25494, "verse_number": "२-११-८४", "content_sanskrit": "यदुच्छालाभतुष्टस्य द्वान्द्वातीतस्य चैव हि ।\nकुर्वतो मत्प्रसादार्थं कर्मं संसारनाशनम ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7005494084, "chapter_id": 25494, "verse_number": "२-११-८५", "content_sanskrit": "मन्मना मन्नमस्कारो मद्याजी मत्परायणः ।\nमामुपैष्यति योगीशं ज्ञात्वाम माम परमेश्वरम ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7005494085, "chapter_id": 25494, "verse_number": "२-११-८६", "content_sanskrit": "मदबुद्धयो मां सततं बोधयन्तः परस्परम ।\nकथयन्तश्च मां नित्यं मम सायुज्यमाप्नुयुः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7005494086, "chapter_id": 25494, "verse_number": "२-११-८७", "content_sanskrit": "एवं नित्यभियुक्तानां मायेयं कर्मसान्वगम ।\nनाशयामि तमः कृत्स्नं ज्ञानदीपेन भास्वताः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7005494087, "chapter_id": 25494, "verse_number": "२-११-८८", "content_sanskrit": "मदबुद्धयो मां सततं पुजयन्तीह ये जनाः ।\nतेषं नित्याभियुक्तांना योगक्षेम वहाम्पहम ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7005494088, "chapter_id": 25494, "verse_number": "२-११-८९", "content_sanskrit": "ये‍ऽन्ये च कामभोगार्थ यजन्ते ह्रान्यदेवताः ।\nतेषां तदन्तं विज्ञेयं देवतानुगतं फलम ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7005494089, "chapter_id": 25494, "verse_number": "२-११-९०", "content_sanskrit": "ये चान्यदेवताभक्त पुज्यन्तीह देवताः ।\nमद्भावनासमायुक्ता मुच्यन्ते तेऽपि भावतः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7005494090, "chapter_id": 25494, "verse_number": "२-११-९१", "content_sanskrit": "तस्मादनीश्वरानन्यास्त्यवक्त्वा देवानशेषतः ।\nममेव संश्रयेदीशंस याति परमं पदम ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7005494091, "chapter_id": 25494, "verse_number": "२-११-९२", "content_sanskrit": "त्यक्त्वा पुत्रादिषु स्नेहं निःशोको निष्परिग्रहः ।\nयजेच्चार्मरणाल्लिंगे विरक्तः परमेश्वरम ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7005494092, "chapter_id": 25494, "verse_number": "२-११-९३", "content_sanskrit": "येऽर्चयन्ति सदा लिंग त्यक्त्वा भोगानशेषतः ।\nएकेन जन्मना तेषां ददामि परमैश्वरम ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7005494093, "chapter_id": 25494, "verse_number": "२-११-९४", "content_sanskrit": "परानन्दात्मकं लिंग केवलं सन्निरत्र्जनम ।\nज्ञनात्मकं सर्वगतं योगिनं हृदि संस्थितम ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7005494094, "chapter_id": 25494, "verse_number": "२-११-९५", "content_sanskrit": "ये चान्ये नियता भक्तो भावयित्वा विधानतः ।\nयत्र क्वचन तल्लिंगमर्चयन्ति महेश्वरम ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7005494095, "chapter_id": 25494, "verse_number": "२-११-९६", "content_sanskrit": "जले व वह्निमध्ये व व्योम्नि सौर्येऽथ वान्यतः ।\nरत्‍नादौ भावयित्वेशमर्चयेलिंगमैश्‍वरम ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7005494096, "chapter_id": 25494, "verse_number": "२-११-९७", "content_sanskrit": "सर्व लिंगमयं ह्योतत सर्व लिंग प्रतिष्ठितम ।\nतस्माल्लिगें‍ऽर्चयेदीशं यत्र क्वचन शाश्वतम ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7005494097, "chapter_id": 25494, "verse_number": "२-११-९८", "content_sanskrit": "अग्नौ क्रियवतामप्सु व्योग्नि सुर्ये मनीषिणाम ।\nकाष्ठादिष्वेव मुर्खाणां हृदि लिंग तु योगिनाम ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7005494098, "chapter_id": 25494, "verse_number": "२-११-९९", "content_sanskrit": "यद्यनुप्तन्नविज्ञानो विरक्तः प्रतिसंयुतः ।\nयावज्जीवं जपेद युक्तः प्रणवः ब्रह्माणो वपुः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7005494099, "chapter_id": 25494, "verse_number": "२-११-१००", "content_sanskrit": "अथवा शतरुद्रीयं जपेदामरणाद द्विजः ।\nएककी यताचित्तात्म स याति परमं पदम ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7005494100, "chapter_id": 25494, "verse_number": "२-११-१०१", "content_sanskrit": "वसेद वामरणाद विप्रो वाराणस्यां समाहित ।\nसोऽपीश्‍वरप्रसादेन याति तत परमं पदम ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7005494101, "chapter_id": 25494, "verse_number": "२-११-१०२", "content_sanskrit": "तत्रोक्रमणकाले हि सर्वेषामेव देहिनाम ।\nददति तत परं ज्ञान येन मुच्येत बन्धनात ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7005494102, "chapter_id": 25494, "verse_number": "२-११-१०३", "content_sanskrit": "वर्नाश्रमाविधिं कृत्स्नं कुर्वाणो मत्परायणः ।\nतेनैव जन्मना ज्ञान लब्ध्वा याति शिवं पदम ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7005494103, "chapter_id": 25494, "verse_number": "२-११-१०४", "content_sanskrit": "येऽपि तत्र वसन्तीह नीचा वा पापयोनयः ।\nसर्वे तरन्ति संसारमीश्‍वरानुग्रहाद द्विजाः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7005494104, "chapter_id": 25494, "verse_number": "२-११-१०५", "content_sanskrit": "किन्तु विघ्ना भविष्यन्ति पापोपहतचेतसाम ।\nधर्म समाश्रयेत तस्मान्मुक्तये नियतं द्विजाः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7005494105, "chapter_id": 25494, "verse_number": "२-११-१०६", "content_sanskrit": "एतद रहस्यं वेदानां न देयं यस्य कस्याचित ।\nधार्मिकायैव दातव्यं भक्तायं ब्रह्माचारिणे ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7005494106, "chapter_id": 25494, "verse_number": "२-११-१०७", "content_sanskrit": "व्यास उवाच ।\nइत्येतदुक्त्वा बह्गवानात्मयोगमनुत्तमम ।\nव्याजहार समासीनं नारायणमनामयम ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7005494107, "chapter_id": 25494, "verse_number": "२-११-१०८", "content_sanskrit": "मयैतद भाषितं ज्ञानं हितार्थं ब्रह्मावादिनाम ।\nदातव्यं शान्तचित्तेभ्यं शिष्येभ्यों भवता शिवम ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7005494108, "chapter_id": 25494, "verse_number": "२-११-१०९", "content_sanskrit": "उक्त्वैवमथ योगीन्द्रानब्रवीद भगवानजः ।\nहिताय सर्वभक्तानां द्विजातीनां द्विजोत्तमाः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7005494109, "chapter_id": 25494, "verse_number": "२-११-११०", "content_sanskrit": "भवन्तोऽपि हि मंज्ज्ञानं शिष्याणां विधिपुर्वकम ।\nउपदेक्ष्यन्ति भक्तांना सर्वेषां वचनान्मम ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7005494110, "chapter_id": 25494, "verse_number": "२-११-१११", "content_sanskrit": "अयं नारायणो योऽहमीश्वरो नात्र स्संशयः ।\nनान्तरं ये प्रपश्यन्ति तेषां देयमिदं परम ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7005494111, "chapter_id": 25494, "verse_number": "२-११-११२", "content_sanskrit": "ममैषा परमा मुर्तिर्नारायणसमह्वाया ।\nसर्वभुतात्मभुतस्था शान्ता चाक्षरसंज्ञिता ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7005494112, "chapter_id": 25494, "verse_number": "२-११-११३", "content_sanskrit": "ये त्वन्यथा प्रपश्यन्ति लोके भेदद्रुशो जनाः ।\nन ते माम सम्प्रपश्यन्ति जायन्ते च पुनः पुनः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7005494113, "chapter_id": 25494, "verse_number": "२-११-११४", "content_sanskrit": "ये त्विमं विष्णूमव्यक्तं मां वा देवं महेश्वरम ।\nएकीभावेन पश्यन्ति न तेषां पुनरुद्द्भवः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7005494114, "chapter_id": 25494, "verse_number": "२-११-११५", "content_sanskrit": "तस्मदनादिनिधनं विष्णुमात्मानमव्ययम ।\nमामेव सम्प्रपश्यध्वं पुजयध्वं तथैव हि ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7005494115, "chapter_id": 25494, "verse_number": "२-११-११६", "content_sanskrit": "येऽन्यथा मां प्रपश्यन्ति मत्वेमं देवातान्तरम ।\nते यान्ति नरकान घोरान नाहं तेषु व्यवस्थितः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7005494116, "chapter_id": 25494, "verse_number": "२-११-११७", "content_sanskrit": "मुर्ख वा पाण्डीतं वापि ब्राह्मणं वा मदाश्रयम ।\nमोचयामि श्‍वपाकं वा न नारायणानिन्दकम ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7005494117, "chapter_id": 25494, "verse_number": "२-११-११८", "content_sanskrit": "तस्मादेष महायोगी मद्भकैः पुरुषोत्तमः ।\nअर्चनीयो नमस्कार्यो मत्प्रीतिजननय हि ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7005494118, "chapter_id": 25494, "verse_number": "२-११-११९", "content_sanskrit": "एवमुक्त्वा समालिंगग्य वासुदेव पिनाकधृक ।\nअन्तार्हितो‍ऽभवत तेषां सर्वेषाएव पश्यताम ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7005494119, "chapter_id": 25494, "verse_number": "२-११-१२०", "content_sanskrit": "नारायणोऽपि भगवांस्तपसं वेषमुत्तमम ।\nजग्राह योगिनः सर्वास्त्यक्त्वा वै परमं वपुः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7005494120, "chapter_id": 25494, "verse_number": "२-११-१२१", "content_sanskrit": "ज्ञातं भवद्भिरमलं प्रसदात परमेष्ठिनः ।\nसाक्षदेव महेशस्य ज्ञानं संसरनाशनम ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7005494121, "chapter_id": 25494, "verse_number": "२-११-१२२", "content_sanskrit": "गच्छध्वं विज्वराः सर्वे विज्ञानं परमेष्ठिनः ।\nप्रवर्तयध्वं शिष्येभ्यो धार्मिकेभ्यो मुनीश्वरा ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7005494122, "chapter_id": 25494, "verse_number": "२-११-१२३", "content_sanskrit": "इंद्र भक्ताय शान्ताय धार्मिकायहिताग्नये ।\nविज्ञानमैश्वरं देयं ब्राह्माणाय विशेषतः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7005494123, "chapter_id": 25494, "verse_number": "२-११-१२४", "content_sanskrit": "एवमुक्त्वा स विश्वात्मा योगिनां योगवित्तमः ।\nनारय्णो महयोगी योगिनं योगवित्तमः ।\nनारय्णो महयोगे जगामदर्शन स्वयम ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7005494124, "chapter_id": 25494, "verse_number": "२-११-१२५", "content_sanskrit": "तेऽपि देवादिदेवेशं नमस्कृत्य महेश्वरम ।\nन्र्य्णं च भुतदिं स्वनि स्थ्नानि भेजिरे ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7005494125, "chapter_id": 25494, "verse_number": "२-११-१२६", "content_sanskrit": "सनत्कुमारो भगवान संवर्ताय महामुनिः ।\nदत्तवानैश्वरं ज्ञानं सोऽपि सत्यव्रताय तु ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7005494126, "chapter_id": 25494, "verse_number": "२-११-१२७", "content_sanskrit": "सनन्दनोऽपि योगीन्द्रः पुलहय महर्षये ।\nप्रददु गौतमाय्थ पुलहोऽपि प्रजापतिः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7005494127, "chapter_id": 25494, "verse_number": "२-११-१२८", "content_sanskrit": "अंगिर वेदविदुषे भरद्वजय दत्तवन ।\nजैगीषव्याय कपिलस्तथा पंचशिखय च ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7005494128, "chapter_id": 25494, "verse_number": "२-११-१२९", "content_sanskrit": "पराशरोऽपि सनकात पित मे सर्वत्त्त्वदृक ।\nलेभे तत्परमं ज्ञानं तस्मद वल्मीकिरत्ववन ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7005494129, "chapter_id": 25494, "verse_number": "२-११-१३०", "content_sanskrit": "मामुवाच पुरा देवः सतीदेवभवंगंजः ।\nवामदेवो महयोगी रुद्रः किल पिनाकधृकः ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7005494130, "chapter_id": 25494, "verse_number": "२-११-१३१", "content_sanskrit": "नारायणोऽपि भगवन देवकीतनयो हरिः ।\nअर्जुनय स्वयं सक्षात दत्तवानिदमुत्तमम ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7005494131, "chapter_id": 25494, "verse_number": "२-११-१३२", "content_sanskrit": "यदहं लब्धवान रुद्राद वामदेवादनुत्तमम ।\nविशेषाद गिरिशे भक्तिस्त्स्मादारभ्यं मेऽभवत ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7005494132, "chapter_id": 25494, "verse_number": "२-११-१३३", "content_sanskrit": "शरण्यं शरणं रुद्रं प्रपन्नोऽहं विशेषतः ।\nभुतेशंगिरिशं स्थाणुं देवदेवं त्रिशुलिनम ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7005494133, "chapter_id": 25494, "verse_number": "२-११-१३४", "content_sanskrit": "भवन्तोऽपि हि तं देवं शम्भुं गोव्रुषवाहनम ।\nप्रपद्यध्वं सपात्नीकाः सपुत्राः शरणं शिवम ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7005494134, "chapter_id": 25494, "verse_number": "२-११-१३५", "content_sanskrit": "वर्तध्वं तत्प्रसादेन कर्मयोगेन शंकरम ।\nपुजयध्वं महादेवं गोपतिं भूतिभुषणम ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7005494135, "chapter_id": 25494, "verse_number": "२-११-१३६", "content_sanskrit": "एवमुक्तेऽथ मुनयः शौनकाद्या महेश्वरम ।\nप्रणेमुः शाश्वतं स्थाणु व्यासं सत्यवतीसुतम ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7005494136, "chapter_id": 25494, "verse_number": "२-११-१३७", "content_sanskrit": "अब्रुवन हृष्टमनसः कृष्णद्वैपायनं प्रभुम ।\nसाक्षादेव हृषीकेशं सर्वलोकमहेश्वरम ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7005494137, "chapter_id": 25494, "verse_number": "२-११-१३८", "content_sanskrit": "भवत्प्रसादादचला शरण्ये गोवृषध्वजे ।\nइदानीं जायते भक्तियाँ देवैरपि दुर्लभा ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7005494138, "chapter_id": 25494, "verse_number": "२-११-१३९", "content_sanskrit": "काथयस्व मुनिश्रेष्ठ कर्मयोगमनुत्तमम ।\nयेनासौ भगवानीशः समाराध्यो मुमुक्षुभिः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7005494139, "chapter_id": 25494, "verse_number": "२-११-१४०", "content_sanskrit": "त्वत्संनिधावेष सुतः श्रुणोतु भगवद्वचः ।\nतद्वदाखिललोकनां रक्षण धर्मसंग्रहम ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7005494140, "chapter_id": 25494, "verse_number": "२-११-१४१", "content_sanskrit": "यदुक्तं देवदेवेन विष्णुनं कूर्मरुपिणा ।\nपृष्टेन मुनिभिः पुर्व शक्रेणमृतमन्थने ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7005494141, "chapter_id": 25494, "verse_number": "२-११-१४२", "content_sanskrit": "श्रुत्वा सत्यवतीसुनुः कर्मयोगं सनातनम ।\nमुनीनां भाषितं कृष्णः प्रोवच सुसमहितः ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7005494142, "chapter_id": 25494, "verse_number": "२-११-१४३", "content_sanskrit": "य इमं पठते नित्यं संवादं कृत्तिवाससः ।\nसनत्कुमप्रमुखैः सर्वपापैः प्रमुच्यते ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7005494143, "chapter_id": 25494, "verse_number": "२-११-१४४", "content_sanskrit": "श्रावयेद व द्विजान शुद्धान ब्रह्माचर्यपरयणान ।\nयो वा विचारयेदर्थ स यति परमां गतिम ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7005494144, "chapter_id": 25494, "verse_number": "२-११-१४५", "content_sanskrit": "यश्चैतच्छ्रणुयान्नित्यं भक्तियुक्तो दृढव्रतः ।\nसर्वपापविनिर्मुक्तो ब्रह्मलोके महीयते ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7005494145, "chapter_id": 25494, "verse_number": "२-११-१४६", "content_sanskrit": "तस्मात स्र्वप्रयत्नेन पठितव्यो मनीषिभिः ।\nश्रोतव्यश्चथ मन्तव्यो विशेषाद ब्राह्मणैः सद ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}]