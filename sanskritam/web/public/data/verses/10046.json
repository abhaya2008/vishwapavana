[{"id": 6000046000, "chapter_id": 10046, "verse_number": null, "content_sanskrit": "अथ षोडशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000046001, "chapter_id": 10046, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.001.m4a", "display_order": 2}, {"id": 6000046002, "chapter_id": 10046, "verse_number": "३-१६-१", "content_sanskrit": "प्राजापत्यं तु तत् तेजः परतेजोहनं दितिः।\nदधार वर्षाणि शतं शङ्कमानाऽसुरार्दनात्॥ ३/१६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.002.m4a", "display_order": 3, "topics": [{"text": "दितिगर्भतेजसा हतालोके लोके देवैः प्रार्थितेन ब्रह्मणा तान्प्रति तत्कारणकथनोपक्रमः", "range": "१–१०"}]}, {"id": 6000046003, "chapter_id": 10046, "verse_number": "३-१६-२", "content_sanskrit": "लोके तेन हृतालोके लोकपाला हतौजसः।\nन्यवेदयन् विश्वसृजे ध्वान्तव्यतिकरं दिशाम्॥ ३/१६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.003.m4a", "display_order": 4}, {"id": 6000046004, "chapter_id": 10046, "verse_number": null, "content_sanskrit": "देवा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.004.m4a", "display_order": 5}, {"id": 6000046005, "chapter_id": 10046, "verse_number": "३-१६-३", "content_sanskrit": "तम एतद् विभो वेत्थ संविग्ना यद् वयं भृशम्।\nन ह्यव्यक्तं भगवतः कालेनास्पृष्टवर्त्मनः॥ ३/१६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.005.m4a", "display_order": 6}, {"id": 6000046006, "chapter_id": 10046, "verse_number": "३-१६-४", "content_sanskrit": "देवदेव जगद्धातर्लोकनाथ शिखामणे।\nपरेषामपरेषां वा त्वं भूतानामसि भाववित्॥ ३/१६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.006.m4a", "display_order": 7}, {"id": 6000046007, "chapter_id": 10046, "verse_number": "३-१६-५", "content_sanskrit": "नमो विज्ञानवीर्याय माययेदमुपेयुषे।\nगृहीतगुणभेदाय नमस्तेऽव्यक्तयोनये॥ ३/१६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.007.m4a", "display_order": 8}, {"id": 6000046008, "chapter_id": 10046, "verse_number": "३-१६-६", "content_sanskrit": "ये त्वामनन्यभावेन भावयन्त्यात्मभावनम्।\nआत्मनि प्रोतभुवनं परं सदसदात्मकम्॥ ३/१६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.008.m4a", "display_order": 9}, {"id": 6000046009, "chapter_id": 10046, "verse_number": "३-१६-७", "content_sanskrit": "तेषां सुव्यक्तयोगानां जितश्वासेन्द्रियात्मनाम्।\nलब्धयुष्मत्प्रसादानां न कुतश्चित् पराभवः॥ ३/१६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.009.m4a", "display_order": 10}, {"id": 6000046010, "chapter_id": 10046, "verse_number": "३-१६-८", "content_sanskrit": "यस्य वाचा प्रजाः सर्वा गावस्तन्त्र्येव यन्त्रिताः।\nहरन्ति बलिमायत्तास्तस्मै मुख्यात्मने नमः॥ ३/१६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.010.m4a", "display_order": 11}, {"id": 6000046011, "chapter_id": 10046, "verse_number": "३-१६-९", "content_sanskrit": "स त्वं विधत्स्व शं भूमन् तमसा लुप्तकर्मणाम्।\nअदभ्रदयया दृष्ट्या प्रपन्नानर्हसीक्षितुम्॥ ३/१६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.011.m4a", "display_order": 12}, {"id": 6000046012, "chapter_id": 10046, "verse_number": "३-१६-१०", "content_sanskrit": "एष देव दितेर्गर्भ ओजः काश्यपमर्पितम्।\nदिशस्तिमिरयन् सर्वा एधतेऽग्निरिवैधसि॥ ३/१६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.012.m4a", "display_order": 13}, {"id": 6000046013, "chapter_id": 10046, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.013.m4a", "display_order": 14}, {"id": 6000046014, "chapter_id": 10046, "verse_number": "३-१६-११", "content_sanskrit": "स प्रहस्य महाबाहो भगवान् शब्दगोचरः।\nप्रत्याचष्टात्मभूर्देवान् प्रीणन् रुचिरया गिरा॥ ३/१६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.014.m4a", "display_order": 15}, {"id": 6000046015, "chapter_id": 10046, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.015.m4a", "display_order": 16}, {"id": 6000046016, "chapter_id": 10046, "verse_number": "३-१६-१२", "content_sanskrit": "मानसा मे सुता युष्मत्पूर्वं वै सनकादयः।\nचेरुर्विहायसा लोकान् लोकेषु विगतस्पृहाः॥ ३/१६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.016.m4a", "display_order": 17, "topics": [{"text": "कदाचन सनकादीनां वैकुण्ठगमनम्", "range": "१२–१३"}]}, {"id": 6000046017, "chapter_id": 10046, "verse_number": "३-१६-१३", "content_sanskrit": "त एकदा भगवतो वैकुण्ठस्यामलात्मनः।\nययुर्विकुण्ठनिलयं सर्वभूतनमस्कृतम्॥ ३/१६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.017.m4a", "display_order": 18}, {"id": 6000046018, "chapter_id": 10046, "verse_number": "३-१६-१४", "content_sanskrit": "वसन्ति यत्र पुरुषाः सर्वे वैकुण्ठमूर्तयः।\nये नित्यमनिमित्तेन धर्मेणाराधयन् हरिम्॥ ३/१६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.018.m4a", "display_order": 19, "topics": [{"text": "वैकुण्ठवर्णनम्", "range": "१४–२६"}]}, {"id": 6000046019, "chapter_id": 10046, "verse_number": "३-१६-१५", "content_sanskrit": "यत्र चाद्यः पुमानास्ते भगवान् शब्दगोचरः।\nसत्त्वं विष्टभ्य विरजं स्वानां नो मृडयन् वृषः॥ ३/१६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.019.m4a", "display_order": 20}, {"id": 6000046020, "chapter_id": 10046, "verse_number": "३-१६-१६", "content_sanskrit": "यत्र नैःश्रेयसं नाम वनं कामदुघैर्द्रुमैः।\nसर्वर्तुश्रीभिर्विभ्राजत्कैवल्यमिव मूर्तिमत्॥ ३/१६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.020.m4a", "display_order": 21}, {"id": 6000046021, "chapter_id": 10046, "verse_number": "३-१६-१७", "content_sanskrit": "वैमानिकाः सललनाश्चरितानि यत्र गायन्ति लोकशमलक्षपणानि भर्तुः।\nअन्तर्जले तु विलसन्मधुमाधवीनां गन्धेन खण्डितधियोऽप्यनिलं क्षिपन्तः॥ ३/१६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.021.m4a", "display_order": 22}, {"id": 6000046022, "chapter_id": 10046, "verse_number": "३-१६-१८", "content_sanskrit": "पारावतान्यभृतसारसचक्रवाकदात्यूहहंसशुकतित्तिरबर्हिणाद्यैः।\nकोलाहले विरचिते चिरमात्रयोच्चैर्भृङ्गाधिपे हरिकथामनुगायमाने॥ ३/१६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.022.m4a", "display_order": 23}, {"id": 6000046023, "chapter_id": 10046, "verse_number": "३-१६-१९", "content_sanskrit": "मन्दारकुन्दकुरबोत्पलचम्पकोर्णपुन्नागनागबकुलाम्बुजपारिजाताः।\nगन्धेऽर्चिते तुलसिकाभरणेन तस्या यस्मिंस्तपः सुमनसो बहुमानयन्ति॥ ३/१६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.023.m4a", "display_order": 24}, {"id": 6000046024, "chapter_id": 10046, "verse_number": "३-१६-२०", "content_sanskrit": "यत् सङ्कुलं हरिपदानतिमात्रतृप्तैर्वैडूर्यमारकतहेममयैर्विमानैः।\nयेषां बृहत्कटितटाः स्मितशोभिमुख्यः कृष्णात्मनां न रज आदधुरुत्स्मयाद्यैः॥ ३/१६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.024.m4a", "display_order": 25}, {"id": 6000046025, "chapter_id": 10046, "verse_number": "३-१६-२१", "content_sanskrit": "श्रीरूपिणी क्‍वणयती चरणारविन्दं नीलाम्बुजेन हरिसद्मनि मुक्तदोषा।\nसंलक्ष्यते स्फटिककुड्य उपेतहेम्नि सम्मार्जतीव यदनुग्रहणेऽन्ययत्नाः॥ ३/१६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.025.m4a", "display_order": 26}, {"id": 6000046026, "chapter_id": 10046, "verse_number": "३-१६-२२", "content_sanskrit": "वापीषु विद्रुमतटास्वमृतामलाप्सु प्रेष्यान्विता निजवने तुलसीभिरीशम्।\nअभ्यर्चती स्वलकमुन्नसमीक्ष्य वक्त्रमुच्छेषितं भगवतेत्यमताङ्ग यच्छ्रीः॥ ३/१६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.026.m4a", "display_order": 27}, {"id": 6000046027, "chapter_id": 10046, "verse_number": "३-१६-२३", "content_sanskrit": "यन्न व्रजन्त्यघभिदोऽरचनानुवादाः शृण्वन्ति येऽन्यविषयाः कुकथा मतिघ्नीः।\nयास्तु श्रुता हतभगैर्नृभिरात्तवीर्यास्तास्तान् क्षिपन्त्यशरणेषु तमस्सु हन्त॥ ३/१६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.027.m4a", "display_order": 28}, {"id": 6000046028, "chapter_id": 10046, "verse_number": "३-१६-२४", "content_sanskrit": "येऽभ्यर्थितामपि च नो नृगतिं प्रपन्ना ज्ञानं च तत्त्वविषयं सहधर्म यत्र।\nनाराधनं भगवतो वितरन्त्यमुष्य संमोहिता विततया ननु मायया ते॥ ३/१६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.028.m4a", "display_order": 29}, {"id": 6000046029, "chapter_id": 10046, "verse_number": "३-१६-२५", "content_sanskrit": "यत्र प्रयान्त्यनिमिषामृषभानुवृत्त्या दूरेयमा ह्युपरि नः स्पृहणीयशीलाः।\nभर्तुर्मिथः सुयशसः कथनानुरागवैक्लव्यबाष्पकलया पुलकीकृताङ्गाः॥ ३/१६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.029.m4a", "display_order": 30}, {"id": 6000046030, "chapter_id": 10046, "verse_number": "३-१६-२६", "content_sanskrit": "तद्विश्वगुर्वधिकृतं भुवनैकवन्द्यं दिव्यं विचित्रविबुधाग्र्यविमानशोचिः।\nआपुः परां मुदमपूर्वमुपेत्य योगमायाबलेन मुनयस्तदथो विकुण्ठम्॥ ३/१६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.030.m4a", "display_order": 31}, {"id": 6000046031, "chapter_id": 10046, "verse_number": "३-१६-२७", "content_sanskrit": "तस्मिन्नतीत्य मुनयः षडसज्जमानाः कक्ष्याः समानवयसस्त्वथ सप्तमायाम्।\nदेवावचक्षत गृहीतगदौ परार्घ्यकेयूरकुण्डलकिरीटविटङ्कवेषौ॥ ३/१६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.031.m4a", "display_order": 32, "topics": [{"text": "भगवन्मन्दिरं प्रविशतां तेषां जयविजयाभ्यां निरोधः", "range": "२७–३०"}]}, {"id": 6000046032, "chapter_id": 10046, "verse_number": "३-१६-२८", "content_sanskrit": "मत्तद्विरेफवनमालिकया निवीतौ विन्यस्तयाऽसितचतुष्टयबाहुमध्ये।\nवक्त्रभ्रुवा कुटिलया स्फुटनिर्गतेन रक्तेक्षणेन च मनाग् रभसं दधानौ॥ ३/१६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.032.m4a", "display_order": 33}, {"id": 6000046033, "chapter_id": 10046, "verse_number": "३-१६-२९", "content_sanskrit": "द्वार्येतयोः प्रविविशुर्मिषतोरपृष्ट्वा पूर्वा यथाऽऽरपुटवज्रकपाटिका याः।\nसर्वत्र ते ह्यविषया मुनयः स्वदृष्ट्या ये सञ्चरन्त्यविहता विगताभिशङ्काः॥ ३/१६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.033.m4a", "display_order": 34}, {"id": 6000046034, "chapter_id": 10046, "verse_number": "३-१६-३०", "content_sanskrit": "तान् वीक्ष्य वातरशनांश्चतुरः कुमारान् वृद्धान् दशार्धवयसो विदितात्मतत्त्वान्।\nवेत्रेण चास्खलयतामतदर्हणांस्तौ तेजो विहस्य भगवत्प्रतिकूलशीलौ॥ ३/१६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.034.m4a", "display_order": 35}, {"id": 6000046035, "chapter_id": 10046, "verse_number": "३-१६-३१", "content_sanskrit": "ताभ्यां मिषत्स्वनिमिषेषु निषिध्यमानाः स्वर्हत्तमा ह्यपि हरेः प्रतिहारपाभ्याम्।\nऊचुः सुहृत्तमदिदृक्षितभङ्ग ईषत् कामानुजेन सहसा त उपप्लुताक्षाः॥ ३/१६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.035.m4a", "display_order": 36, "topics": [{"text": "क्रुद्धैः सनकादिभिः जयविजययोरासुरजन्मप्रापकशापदानम्", "range": "३१–३६"}]}, {"id": 6000046036, "chapter_id": 10046, "verse_number": "३-१६-३२", "content_sanskrit": "को वा इहैत्य भगवत्परिचर्ययोच्चैस्तद्धर्मिणामपि सतां विषमस्वभावः।\nतस्मिन् प्रशान्तपुरुषे गतविग्रहे वां को वाऽत्मवत् कुहकयोः परिशङ्कनीयः॥ ३/१६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.036.m4a", "display_order": 37}, {"id": 6000046037, "chapter_id": 10046, "verse_number": "३-१६-३३", "content_sanskrit": "न ह्यन्तरं भगवतीह समस्तकुक्षौ आत्मानमात्मनि नभो नभसीव धीराः।\nपश्यन्ति यत्र युवयोः सुरलिङ्गिनोः किं व्युत्पादितं ह्युदरभेदि भयं यतोऽस्य॥ ३/१६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.037.m4a", "display_order": 38}, {"id": 6000046038, "chapter_id": 10046, "verse_number": "३-१६-३४", "content_sanskrit": "तद् वा अमुष्य परमस्य विकुण्ठभर्तुः कर्तुं न युक्तमिति धीमहि मन्दधीभ्याम्।\nलोकानितो व्रजतमन्तरभावदृष्ट्या पापीयसस्‍त्रय इमे रिपवोऽस्य यत्र॥ ३/१६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.038.m4a", "display_order": 39}, {"id": 6000046039, "chapter_id": 10046, "verse_number": "३-१६-३५", "content_sanskrit": "तेषामितीरितमुभाववधार्य घोरं तं ब्रह्मदण्डमनिवारणमस्‍त्रपूगैः।\nसद्यो हरेरनुचरावुरुबिभ्यतस्तत्पादग्रहावपततामतिकातरेण॥ ३/१६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.039.m4a", "display_order": 40}, {"id": 6000046040, "chapter_id": 10046, "verse_number": "३-१६-३६", "content_sanskrit": "भूयानघाद्धि भगवद्भिरकारि दण्डो यो नौ हरेत सुरहेलनमप्यशेषम्।\nमा वोऽनुतापकलया भगवत्स्मृतिघ्नो मोहो भवेदिह तु नौ व्रजतोरधोऽधः॥ ३/१६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.040.m4a", "display_order": 41}, {"id": 6000046041, "chapter_id": 10046, "verse_number": "३-१६-३७", "content_sanskrit": "एवं तदैव भगवानरविन्दनाभः स्वानां विबुध्य सदतिक्रममार्यहृद्यः।\nतस्मिन् ययौ परमहंसमहामुनीनामन्वेषणीयचरणो निलयात् सहश्रीः॥ ३/१६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.041.m4a", "display_order": 42, "topics": [{"text": "सनकादिभिः भगवद्दर्शनम्, भगवत्कीर्तनं च", "range": "३७–५०"}]}, {"id": 6000046042, "chapter_id": 10046, "verse_number": "३-१६-३८", "content_sanskrit": "तं त्वागतं प्रतिहृतौपयिकं स्वपुंभिस्तेऽचक्षताक्षविषयं स्वसमाधिगम्यम्।\nहंसश्रियोर्व्यजनयोः शिववायुलोलशुभ्रातपत्रशशिकेसरशीकराम्बुम्॥ ३/१६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.042.m4a", "display_order": 43}, {"id": 6000046043, "chapter_id": 10046, "verse_number": "३-१६-३९", "content_sanskrit": "कृत्स्नप्रसादसुमुखं स्पृहणीयधामस्नेहावलोककलया हृदि संस्पृशन्तम्।\nश्यामे पृथावुरसि शोभितया श्रिया स्वग्रीवामणिं सुभगयन्तमिवात्मधिष्ण्यम्॥ ३/१६/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.043.m4a", "display_order": 44}, {"id": 6000046044, "chapter_id": 10046, "verse_number": "३-१६-४०", "content_sanskrit": "पीतांशुकं पृथुनितम्बमधिस्फुरन्त्या काञ्च्याऽलिभिर्विरुतया वनमालया च।\nवल्गुप्रकोष्ठवलयं विनतासुतांसे विन्यस्तहस्तमितरेण धुनानमब्जम्॥ ३/१६/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.044.m4a", "display_order": 45}, {"id": 6000046045, "chapter_id": 10046, "verse_number": "३-१६-४१", "content_sanskrit": "विद्युत्क्षिपन्मकरकुण्डलमण्डनार्हगण्डस्थलोन्नसमुखं मणिमत्किरीटम्।\nदोर्दण्डखण्डविवरे चरता परार्घ्यहारेण कन्धरगतेन च कौस्तुभेन॥ ३/१६/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.045.m4a", "display_order": 46}, {"id": 6000046046, "chapter_id": 10046, "verse_number": "३-१६-४२", "content_sanskrit": "अत्रोपसृष्टमिति चोत्स्मृतमिन्दिरायाः स्वानां धिया विरचितं बहुसौभगाढ्यम्।\nमह्यं भवस्य भवतां भजनीयमङ्गं नेमुर्निरीक्ष्य नवितृप्तदृशो मुदा कैः॥ ३/१६/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.046.m4a", "display_order": 47}, {"id": 6000046047, "chapter_id": 10046, "verse_number": "३-१६-४३", "content_sanskrit": "तस्यारविन्दनयनस्य पदारविन्दकिञ्जल्कमिश्रतुलसीमकरन्दवायुः।\nअन्तर्गतः स्वविवरेण चकार तेषां सङ्क्षोभमक्षरजुषामपि चित्ततन्वोः॥ ३/१६/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.047.m4a", "display_order": 48}, {"id": 6000046048, "chapter_id": 10046, "verse_number": "३-१६-४४", "content_sanskrit": "ते वा अमुष्य वदनासितपद्मकोशमुद्वीक्ष्य सुन्दरतराधरकुन्दहासम्।\nलब्धाशिषः पुनरवेक्ष्य तदीयमङ्घ्रिद्वन्द्वं नखारुणमणिश्रयणं निदध्युः॥ ३/१६/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.048.m4a", "display_order": 49}, {"id": 6000046049, "chapter_id": 10046, "verse_number": "३-१६-४५", "content_sanskrit": "पुंसां गतिं मृगयतामिह योगमार्गैर्ध्यानास्पदं बहुमतं नयनाभिरामम्।\nते तद्वपुर्दर्शयानमनन्यसिद्धैरौत्पत्तिकैः समगृणन् युतमष्टभोगैः॥ ३/१६/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.049.m4a", "display_order": 50}, {"id": 6000046050, "chapter_id": 10046, "verse_number": null, "content_sanskrit": "कुमारा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.050.m4a", "display_order": 51}, {"id": 6000046051, "chapter_id": 10046, "verse_number": "३-१६-४६", "content_sanskrit": "योऽन्तर्हितो हृदि गतोऽपि दुरात्मनां त्वमद्यैषि नो नयनमूलमनन्तराद्धः।\nयर्ह्येव कर्णविवरेण गुहां गतो नः पित्राऽनुवर्णितरहो भवदुद्भवेन॥ ३/१६/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.051.m4a", "display_order": 52}, {"id": 6000046052, "chapter_id": 10046, "verse_number": "३-१६-४७", "content_sanskrit": "तं त्वा विदाम भगवन् परमात्मतत्त्वं सत्त्वेन सम्प्रति रतिं रचयन्तमेषाम्।\nयत् तेऽनुभावविदितैर्दृढभक्तियोगैरुद्ग्रन्थयो हृदि विदुर्मुनयो विरागाः॥ ३/१६/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.052.m4a", "display_order": 53}, {"id": 6000046053, "chapter_id": 10046, "verse_number": "३-१६-४८", "content_sanskrit": "नात्यन्तिकं विगणयन्त्यपि ते प्रसादं किं चान्यदर्पितभयं भ्रुव उन्नयैस्ते।\nयेऽङ्ग त्वदङ्घ्रिशरणा भवतः कथायाः कीर्तन्यतीर्थयशसः कुशला रसज्ञाः॥ ३/१६/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.053.m4a", "display_order": 54}, {"id": 6000046054, "chapter_id": 10046, "verse_number": "३-१६-४९", "content_sanskrit": "कामं व्रजेम वृजिनैर्निरयेषु नष्टाश्चेतोऽलिवद् यदि नु ते पदयो रमेत।\nवाचश्च नस्तुलसिवद् यदि तेऽङ्घ्रिशोभाः पूर्येत ते गुणगणैर्यदि कर्णरन्ध्रः॥ ३/१६/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.054.m4a", "display_order": 55}, {"id": 6000046055, "chapter_id": 10046, "verse_number": "३-१६-५०", "content_sanskrit": "प्रादुश्चकर्थ यदिदं पुरुहूत रूपं तेनेश निर्वृतिमवापुरलं दृशो नः।\nतस्मा इदं भगवते नम उद्विधेम योऽनात्मनां दुरुदयो भगवान् प्रतीतः॥ ३/१६/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_016/BhP_03.016.055.m4a", "display_order": 56}, {"id": 6000046056, "chapter_id": 10046, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे षोडशाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]