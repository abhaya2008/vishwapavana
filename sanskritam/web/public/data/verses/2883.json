[{"id": 2088487, "chapter_id": 2883, "verse_number": "१३-१३-१", "content_sanskrit": "भीष्म उवाच।\nअत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nचतुर्णामपि वेदानां संवादं शृणु पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088488, "chapter_id": 2883, "verse_number": "१३-१३-२x", "content_sanskrit": "ऋग्वेद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088489, "chapter_id": 2883, "verse_number": "१३-१३-२", "content_sanskrit": "गृहानाश्रयमाणस्य अग्निहोत्रं च जुह्वतः।\nसर्वं सुकृतमादत्ते यः साये नुद्यतेऽतिथिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088490, "chapter_id": 2883, "verse_number": "१३-१३-३", "content_sanskrit": "न स्कन्दते न व्यथते नास्योर्ध्वं सर्पते रजः।\nवरिष्ठमग्निहोत्राच्च ब्राह्मणस्य मुखे हुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088491, "chapter_id": 2883, "verse_number": "१३-१३-४x", "content_sanskrit": "सामवेद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088492, "chapter_id": 2883, "verse_number": "१३-१३-४", "content_sanskrit": "न चेद्धन्ति पितरं मातरं वा\nन ब्राह्मणं नापवादं करोति।\nयत्किंचिदन्यद्वृजिनं करोति।\nप्रीतोऽतिथिस्तदुपहन्ति पापम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088493, "chapter_id": 2883, "verse_number": "१३-१३-५x", "content_sanskrit": "अथर्ववेद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088494, "chapter_id": 2883, "verse_number": "१३-१३-६", "content_sanskrit": "यत्क्रोधनो यजते यद्ददाति\nयद्वा तपस्तप्यति यज्जुहोति।\nवैवस्वतो हरते सर्वमस्य\nमोघं चेष्टं भवति क्रोधनस्य॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088495, "chapter_id": 2883, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रयोदशोऽध्यायः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]