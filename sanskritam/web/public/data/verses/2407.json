[{"id": 2066742, "chapter_id": 2407, "verse_number": "९-२५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2066743, "chapter_id": 2407, "verse_number": "९-२५-१", "content_sanskrit": "गजानीके हते तस्मिन्पाण्डुपुत्रेण भारत।\nवध्यमाने बले चैव भीमसेनेन संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2066744, "chapter_id": 2407, "verse_number": "९-२५-२", "content_sanskrit": "चरन्तं च प्रपश्यामो भीमसेनमरिन्दमम्।\nदण्डहस्तं यथा क्रुद्वमन्तकं प्राणहारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2066745, "chapter_id": 2407, "verse_number": "९-२५-३", "content_sanskrit": "समेत्य समरे राजन्हतशेषाः सुतास्तव।\nअदृश्यमाने कौरव्ये पुत्रे दुर्योधने तव।\nसोदर्याः सहिता भूत्वा भीमसेनमुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2066746, "chapter_id": 2407, "verse_number": "९-२५-४", "content_sanskrit": "श्रुतर्वा सञ्जयश्चैव जयत्सेनः श्रुतान्तकः।\nदुर्विमोचनकश्चैव तथा दुर्विषहो बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2066747, "chapter_id": 2407, "verse_number": "९-२५-५", "content_sanskrit": "दुर्मर्षणः सुजातश्च जैत्रो भूरिबलो रविः।\nइत्येते सहिता भूत्वा तव पुत्राः समन्ततः।\nभीमसेनमभिद्रुत्य रुरुधुः सर्वतो दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2066748, "chapter_id": 2407, "verse_number": "९-२५-६", "content_sanskrit": "ततो भीमो महाराज स्वरथं पुनरास्थितः।\nमुमोच निशितान्बाणान्पुत्राणां तव मर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2066749, "chapter_id": 2407, "verse_number": "९-२५-७", "content_sanskrit": "ते कीर्यमाणा भीमेन पुत्रास्तव महारणे।\nभीमसेनमुपासेदुः प्रवाता इव कुञ्जरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2066750, "chapter_id": 2407, "verse_number": "९-२५-८", "content_sanskrit": "ततः क्रुद्धो रणे भीमः शिरो दुर्मर्षणस्य ह।\nक्षुरप्रेण प्रमथ्याशु पातयामास भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2066751, "chapter_id": 2407, "verse_number": "९-२५-९", "content_sanskrit": "ततोऽपरेण भल्लेन सर्वावरणभेदिना।\nश्रुतान्तमवधीद्बीमस्तव पुत्रं महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2066752, "chapter_id": 2407, "verse_number": "९-२५-१०", "content_sanskrit": "जयत्सेनं ततो विद्वा नाराचेन हसन्निव।\nपातयामास कौरव्यं रथोपस्थादरिन्दमः।\nस पपात रथाद्राजन्भूमौ तूर्णं ममार च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2066753, "chapter_id": 2407, "verse_number": "९-२५-११", "content_sanskrit": "श्रुतर्वा तु ततो भीमं क्रुद्धो विव्याध मारिष।\nशतेन गृघ्रवाजानां शराणां नतपर्वणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2066754, "chapter_id": 2407, "verse_number": "९-२५-१२", "content_sanskrit": "ततः क्रुद्धो रणे भीमो जैत्रं भूरिबलं रविम्।\nत्रीनेतांस्त्रिभिरानर्च्छद्विषाग्निप्रतिमैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2066755, "chapter_id": 2407, "verse_number": "९-२५-१३", "content_sanskrit": "ते हता न्यपतन्भूमौ स्यन्दनेभ्यो महारथाः।\nवसन्ते पुष्पशबला निकृत्ता इव किंशुकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2066756, "chapter_id": 2407, "verse_number": "९-२५-१४", "content_sanskrit": "ततोऽपरेण भल्लेन तीक्ष्णेन च परन्तपः।\nदुर्विमोचनमाहत्य प्रेषयामास मृत्यवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2066757, "chapter_id": 2407, "verse_number": "९-२५-१५", "content_sanskrit": "स हतः प्रापतद्भूमौ स्वरथाद्रथिनां वरः।\nगिरेस्तु कूटजो भग्नो मारुतेनेव पादपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2066758, "chapter_id": 2407, "verse_number": "९-२५-१६", "content_sanskrit": "दुष्प्रधर्षं ततश्चैव सुजातं च सुतं तव।\nएकैकं न्यहनत्सङ्ख्ये द्वाभ्यांद्वाभ्यां चमूमुखे।\nतौ शिलीमुखविद्धाङ्गौ पेततू रथसत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2066759, "chapter_id": 2407, "verse_number": "९-२५-१७", "content_sanskrit": "ततः पतन्तं समरे अभिवीक्ष्य सुतं तव।\nभल्लेन पातयामास भीमो दुर्विपहं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2066760, "chapter_id": 2407, "verse_number": "९-२५-१८", "content_sanskrit": "स पपात हतो बाहात्पश्यतां सर्वधन्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2066761, "chapter_id": 2407, "verse_number": "९-२५-१९", "content_sanskrit": "दृष्ट्वा तु निहतान्भ्रातॄन्वहूनेकेन संयुगे।\nअमर्षधशमापसः श्रुतर्वा भीममभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2066762, "chapter_id": 2407, "verse_number": "९-२५-२०", "content_sanskrit": "विक्षिपन्सुमहच्चापं कार्तखरविभूषितम्।\nविमृजन्सायकांश्चैव विषाग्निप्रतिमान्वहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2066763, "chapter_id": 2407, "verse_number": "९-२५-२१", "content_sanskrit": "स तु राजन्धनुश्छित्त्वा पाण्डवस्य महामृधे।\nअथैनं छिन्नधन्वानं विंशत्या समवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2066764, "chapter_id": 2407, "verse_number": "९-२५-२२", "content_sanskrit": "ततोऽन्यद्धनुरादाय भीमसेनो महाबलः।\nअवाकिरत्तव सुतं तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2066765, "chapter_id": 2407, "verse_number": "९-२५-२३", "content_sanskrit": "महदासीत्तयोर्युद्धं चित्ररूपं भयानकम्।\nबादृशं समरे पूर्वं तम्भवासवयोर्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2066766, "chapter_id": 2407, "verse_number": "९-२५-२४", "content_sanskrit": "तयोस्तत्र शितैर्गुक्तैर्यमदण्डनिभैः शरैः।\nसमाच्छकाधारा सर्वा त्वं दिशो विदिशस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2066767, "chapter_id": 2407, "verse_number": "९-२५-२५", "content_sanskrit": "अतः श्रुतर्वा सङ्क्रुद्धो धनुरादाय सायकैः।\nभीमसेनं रणे राजन्बाह्वोरुरसि चार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2066768, "chapter_id": 2407, "verse_number": "९-२५-२६", "content_sanskrit": "सोऽतिविद्धो महाराज तव पुत्रेण धन्विना।\nभीमः सञ्चुक्षुभे क्रुद्धः पर्वणीव महोदधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2066769, "chapter_id": 2407, "verse_number": "९-२५-२७", "content_sanskrit": "ततो भीमो रुषाविष्टः पुत्रस्य तव मारिष।\nसारथिं चतुरश्चाश्वाञ्शरैर्निन्ये यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2066770, "chapter_id": 2407, "verse_number": "९-२५-२८", "content_sanskrit": "विरथं तं समालक्ष्य विशिखैर्लोमवाहिभिः।\nअवाकिरदमेयात्मा दर्शयन्पाणिलाघवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2066771, "chapter_id": 2407, "verse_number": "९-२५-२९", "content_sanskrit": "श्रुतर्वा विरथो राजन्नाददे खङ्गचर्मणी।\nअथास्याददतः खह्गं शतचन्द्रं च भानुमत्।\nक्षुरप्रेणं शिरः कायात्पातयामास पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2066772, "chapter_id": 2407, "verse_number": "९-२५-३०", "content_sanskrit": "छिन्नोत्तमाङ्गस्य ततः क्षुरप्रेण महात्मना।\nपपात कायः स्वरथाद्वसुधामनुनादयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2066773, "chapter_id": 2407, "verse_number": "९-२५-३१", "content_sanskrit": "तस्मिन्निपतिते वीरे तावका भयमोहिताः।\nअभ्यद्रवन्त सङ्ग्रामे भीमसेनं युयुत्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2066774, "chapter_id": 2407, "verse_number": "९-२५-३२", "content_sanskrit": "तानापतत एवाशु हतशेषाद्बलार्णवात्।\nदंशितान्प्रतिजग्राह भीमसेनः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2066775, "chapter_id": 2407, "verse_number": "९-२५-३३", "content_sanskrit": "ते तु तं वै समासाद्य परिवव्रुः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2066776, "chapter_id": 2407, "verse_number": "९-२५-३४", "content_sanskrit": "ततस्तु संवृतो भीमस्तावकान्निशितैः शरैः।\nपीडयामास तान्सर्वान्सहस्राक्ष इवासुरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2066777, "chapter_id": 2407, "verse_number": "९-२५-३५", "content_sanskrit": "ततः पञ्चशतान्हत्वा सवरूथान्महारथान्।\nजघान कुञ्जरानीकं पुनः सप्तशतं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2066778, "chapter_id": 2407, "verse_number": "९-२५-३६", "content_sanskrit": "हत्वा शतसहस्राणि पत्तीनां परमेषुभिः।\nवाजिनां च शतान्यष्टौ पाण्डवः स्म विराजते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2066779, "chapter_id": 2407, "verse_number": "९-२५-३७", "content_sanskrit": "भीमसेनस्तु कौन्तेयो हत्वा युद्धे सुतांस्तव।\nमेने कृतार्थमात्मानं सफलं जन्म च प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2066780, "chapter_id": 2407, "verse_number": "९-२५-३८", "content_sanskrit": "तं तथा युध्यमानं च विनिघ्नन्तं च तावकान्।\nईक्षितुं नोत्सहन्ते स्म तव सैन्या नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2066781, "chapter_id": 2407, "verse_number": "९-२५-३९", "content_sanskrit": "विद्राव्य च कुरून्सर्वांस्तांश्च हत्वा पदानुगान्।\nदोर्भ्यां शब्दं ततश्चक्रे त्रासयानो महाद्विपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2066782, "chapter_id": 2407, "verse_number": "९-२५-४०", "content_sanskrit": "हतभूयिष्ठयोधा तु तव सेना विशामम्पते।\nकिञ्चिच्छेषा महाराज कृपणं समपद्यत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2066783, "chapter_id": 2407, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि अष्टादशदिवसयुद्धे पञ्चविंशोऽध्यायः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]