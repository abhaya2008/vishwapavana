[{"id": 7004039000, "chapter_id": 24039, "verse_number": "३-३-१०-१", "content_sanskrit": "सूत उवाच ।\nविचित्रं शिवनिर्माणं विचित्र शिवचेष्टितम् ।\nविचित्रं शिवमाहात्म्यं विचित्रं शिवभाषितम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004039001, "chapter_id": 24039, "verse_number": "३-३-१०-२", "content_sanskrit": "विचित्रं शिवभक्तानां चरितं पापनाशनम् ।\nस्वर्गापवर्गयोः सत्यं साधनं तद्ब्रवीम्यहम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004039002, "chapter_id": 24039, "verse_number": "३-३-१०-३", "content_sanskrit": "अवंतीविषये कश्चिद्ब्राह्मणो मंदराह्वयः ।\nबभूव विषयारामः स्त्रीजितो धनसंग्रही॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004039003, "chapter_id": 24039, "verse_number": "३-३-१०-४", "content_sanskrit": "संध्यास्नापरित्यक्तो गंधमाल्यांबरप्रियः ।\nकुस्त्रीसक्तः कुमार्गस्थो यथा पूर्वमजामिलः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004039004, "chapter_id": 24039, "verse_number": "३-३-१०-५", "content_sanskrit": "स वेश्यां पिंगलां नाम रममाणो दिवानिशम् ।\nतस्या एव गृहे नित्यमासीदविजितेंद्रियः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004039005, "chapter_id": 24039, "verse_number": "३-३-१०-६", "content_sanskrit": "कदाचित्सदने तस्यास्तस्मिन्निवसति द्विजे ।\nऋषभो नाम धर्मात्मा शिवयोगी समाययौ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004039006, "chapter_id": 24039, "verse_number": "३-३-१०-७", "content_sanskrit": "तमागतमभिप्रेक्ष्य मत्वा स्वं पुण्यमूर्जितम् ।\nसा वेश्या स च विप्रश्च पर्यपूजयतामुभौ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004039007, "chapter_id": 24039, "verse_number": "३-३-१०-८", "content_sanskrit": "तमारोप्य महापीठे कंबलांबरसंभृते ।\nप्रक्षाल्य चरणौ भक्त्या तज्जलं दधतुः शिरः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004039008, "chapter_id": 24039, "verse_number": "३-३-१०-९", "content_sanskrit": "स्वागतार्घ्यनमस्कारैर्गंधपुष्पाक्षतादिभिः ।\nउपचारैः समभ्यर्च्य भोजयामासतुर्मुदा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004039009, "chapter_id": 24039, "verse_number": "३-३-१०-१०", "content_sanskrit": "तं भुक्तवंतमाचांतं पर्यंके सुखसंस्तरे ।\nउपवेश्य मुदा युक्तौ तांबूलं प्रत्ययच्छताम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004039010, "chapter_id": 24039, "verse_number": "३-३-१०-११", "content_sanskrit": "पादसंवाहनं भक्त्या कुर्वंतौ दैवचो दितौ ।\nकल्पयित्वा तु शुश्रूषां प्रीणयामासतुश्चिरम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004039011, "chapter_id": 24039, "verse_number": "३-३-१०-१२", "content_sanskrit": "एवं समर्चितस्ताभ्यां शिवयोगी महाद्युतिः ।\nअतिवाह्य निशामेकां ययौ प्रातस्तदादृतः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004039012, "chapter_id": 24039, "verse_number": "३-३-१०-१३", "content_sanskrit": "एवं काले गतप्राये स विप्रो निधनं गतः ।\nसा च वेश्या मृता काले ययौ कर्मार्जितां गतिम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004039013, "chapter_id": 24039, "verse_number": "३-३-१०-१४", "content_sanskrit": "स विप्रः कर्मणा नीतो दशार्णधरणीपतेः ।\nवज्रबाहुकुटुंबिन्याः सुमत्या गर्भमास्थितः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004039014, "chapter_id": 24039, "verse_number": "३-३-१०-१५", "content_sanskrit": "तां ज्येष्ठपत्नीं नृपतेर्गर्भसंपदमाश्रिताम् ।\nअवेक्ष्य तस्यै गरलं सपत्न्यश्छद्मना ददुः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004039015, "chapter_id": 24039, "verse_number": "३-३-१०-१६", "content_sanskrit": "सा भुक्त्वा गरलं घोरं न मृता दैवयोगतः ।\nक्लेशमेव परं प्राप मरणादतिदुःसहम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004039016, "chapter_id": 24039, "verse_number": "३-३-१०-१७", "content_sanskrit": "अथ काले समायाते पुत्रमे कमजीजनत् ।\nक्लेशेन महता साध्वी पीडिता वरवर्णिनी॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004039017, "chapter_id": 24039, "verse_number": "३-३-१०-१८", "content_sanskrit": "स निर्दशो राजपुत्रः स्पृष्टपूर्वो गरेण यत् ।\nतेनावाप महाक्लेशं क्रंदमानो दिवानिशम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004039018, "chapter_id": 24039, "verse_number": "३-३-१०-१९", "content_sanskrit": "तस्य बालस्य माता च सर्वांगव्रणपीडिता ।\nबभूवतुरतिक्लिष्टौ गरयोगप्रभावतः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004039019, "chapter_id": 24039, "verse_number": "३-३-१०-२०", "content_sanskrit": "तौ राज्ञा च समानीतौ वैद्यैश्च कृतभेषजौ ।\nन स्वास्थ्यमापतुर्यत्नैरनेकैर्योजितैरपि॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004039020, "chapter_id": 24039, "verse_number": "३-३-१०-२१", "content_sanskrit": "न रात्रौ लभते निद्रां सा राज्ञी विपुलव्यथा ।\nस्वपुत्रस्य च दुःखेन दुःखिता नितरां कृशा॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004039021, "chapter_id": 24039, "verse_number": "३-३-१०-२२", "content_sanskrit": "नीत्वैवं कतिचिन्मासान्स राजा मातृपुत्रकौ ।\nजीवंतौ च मृतप्रायौ विलोक्यात्मन्यचिंतयत्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004039022, "chapter_id": 24039, "verse_number": "३-३-१०-२३", "content_sanskrit": "एतौ मे गृहिणीपुत्रौ निरयादागताविह ।\nअश्रांतरोगौ क्रंदंतौ निद्राभंगविधायिनौ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004039023, "chapter_id": 24039, "verse_number": "३-३-१०-२४", "content_sanskrit": "अत्रोपायं करिष्यामि पापयोर्ध्रुवमेतयोः ।\nमर्तुं वा जीवितुं वापि न क्षमौ पापभोगिनौ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004039024, "chapter_id": 24039, "verse_number": "३-३-१०-२५", "content_sanskrit": "इत्थं विनिश्चित्य च भूमिपालः सक्तः सपत्नीषु तदात्मजेषु ।\nआहूय सूतं निजदारपुत्रौ निर्वापयामास रथेन दूरम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004039025, "chapter_id": 24039, "verse_number": "३-३-१०-२६", "content_sanskrit": "तौ सूतेन परित्यक्तौ कुत्रचिद्विजने वने ।\nअवापतुः परां पीडां क्षुत्तृड्भ्यां भृशविह्वलौ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004039026, "chapter_id": 24039, "verse_number": "३-३-१०-२७", "content_sanskrit": "सोद्वहंती निजं बालं निपतंती पदे पदे ।\nनिःश्वसंती निजं कर्म निंदंती चकिता भृशम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004039027, "chapter_id": 24039, "verse_number": "३-३-१०-२८", "content_sanskrit": "क्वचित्कंटकभिन्नांगी मुक्तकेशी भयातुरा ।\nक्वचिद्व्याघ्रस्वनैर्भीता क्वचिद्व्यालैरनुद्रुता॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004039028, "chapter_id": 24039, "verse_number": "३-३-१०-२९", "content_sanskrit": "भर्त्स्यमाना पिशाचैश्च वेतालैर्ब्रह्मराक्षसैः ।\nमहागुल्मेषु धावंती भिन्नपादा क्षुराश्मभिः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004039029, "chapter_id": 24039, "verse_number": "३-३-१०-३०", "content_sanskrit": "सैवं घोरे महारण्ये भ्रमंती नृपगे हिनी ।\nदैवात्प्राप्ता वणिङ्मार्गं गोवाजिनरसेवितम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004039030, "chapter_id": 24039, "verse_number": "३-३-१०-३१", "content_sanskrit": "गच्छंती तेन मार्गेण सुदूरमतियत्नतः ।\nददर्श वैश्यनगरं वहुस्त्रीनरसेवितम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004039031, "chapter_id": 24039, "verse_number": "३-३-१०-३२", "content_sanskrit": "तस्य गोप्ता महावैश्यो नगरस्य महाजनः ।\nअस्ति पद्माकरो नाम राजराज इवापरः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004039032, "chapter_id": 24039, "verse_number": "३-३-१०-३३", "content_sanskrit": "तस्य वैश्यपतेः काचिद्गृहदासी नृपांगनाम् ।\nआयांती दूरतो दृष्ट्वा तदंतिकमुपाययौ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004039033, "chapter_id": 24039, "verse_number": "३-३-१०-३४", "content_sanskrit": "सा दासी नृपतेः कांतां सपुत्रां भृशपीडिताम् ।\nस्वयं विदितवृत्तांता स्वामिने प्रत्यदर्शयत्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004039034, "chapter_id": 24039, "verse_number": "३-३-१०-३५", "content_sanskrit": "स तां दृष्ट्वा विशां नाथो रुजार्त्तां क्लिष्टपुत्रकाम् ।\nनीत्वा रहसि सुव्यक्तं तद्वृत्तांतमपृच्छत॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004039035, "chapter_id": 24039, "verse_number": "३-३-१०-३६", "content_sanskrit": "तया निवेदिताशेषवृत्तांतः स वणिक्पतिः ।\nअहोकष्टमिति ज्ञात्वा निशश्वास मुहुर्मुहुः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004039036, "chapter_id": 24039, "verse_number": "३-३-१०-३७", "content_sanskrit": "तामंतिके स्वगेहस्य संनिवेश्य रहोगृहे ।\nवासोन्नपानशयनैर्मातृसाम्यमपूजयत्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004039037, "chapter_id": 24039, "verse_number": "३-३-१०-३८", "content_sanskrit": "तस्मिन्गृहे नृपवधूर्निवसंती सुरक्षिता ।\nव्रणयक्ष्मादिरोगाणां न शांतिं प्रत्यपद्यत॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004039038, "chapter_id": 24039, "verse_number": "३-३-१०-३९", "content_sanskrit": "ततो दिनैः कतिपयैः स बालो व्रणपीडितः ।\nविलंघितभिषक्सत्त्वो ममार च विधेर्वशात्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004039039, "chapter_id": 24039, "verse_number": "३-३-१०-४०", "content_sanskrit": "मृते स्वतनये राज्ञी शोकेन महतावृता ।\nमूर्च्छिता चापतद्भूमौ गजभग्नेव वल्लरी॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004039040, "chapter_id": 24039, "verse_number": "३-३-१०-४१", "content_sanskrit": "दैवात्संज्ञामवाप्याथ वाष्पक्लिन्नपयोधरा ।\nसांत्विताऽपि वणिक्स्त्रीभिर्विललाप सुदुःखिता॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004039041, "chapter_id": 24039, "verse_number": "३-३-१०-४२", "content_sanskrit": "हा ताततात हा पुत्र हा मम प्राणरक्षक ।\nहा राजकुलपूर्णेन्दो हा ममानंदवर्धन॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004039042, "chapter_id": 24039, "verse_number": "३-३-१०-४३", "content_sanskrit": "इमामनाथां कृपणां त्वत्प्राणां त्यक्तवबांधवाम् ।\nमातरं ते परित्यज्य क्व यातोऽसि नृपात्मज॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004039043, "chapter_id": 24039, "verse_number": "३-३-१०-४४", "content_sanskrit": "इत्येभिरुदितैर्वाक्यैः शोकचिंताविवर्धकैः ।\nविलपंतीं मृतापत्यां को नु सांत्वयितुं क्षमः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004039044, "chapter_id": 24039, "verse_number": "३-३-१०-४५", "content_sanskrit": "एतस्मिन्समये तस्या दुःखशोकचिकित्सकः ।\nऋषभः पूर्वमाख्यातः शिवयोगी समाययौ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004039045, "chapter_id": 24039, "verse_number": "३-३-१०-४६", "content_sanskrit": "स योगी वैश्यनाथेन सार्घहस्तेन पूजितः ।\nतस्याः सकाशमगमच्छोचन्त्या इदमब्रवीत्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004039046, "chapter_id": 24039, "verse_number": "३-३-१०-४७", "content_sanskrit": "ऋषभ उवाच ।\nअकस्मात्किमहो वत्से रोरवीषि विमूढधीः ।\nको जातः कतमो लोके को मृतो वद सांप्रतम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004039047, "chapter_id": 24039, "verse_number": "३-३-१०-४८", "content_sanskrit": "अमी देहादयो भावास्तोयफेनसधर्मकाः ।\nक्वचिद्भ्रांतिः क्वचिच्छांतिः स्थितिर्भवति वा पुनः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004039048, "chapter_id": 24039, "verse_number": "३-३-१०-४९", "content_sanskrit": "अतोऽस्मिन्फेनसदृशे देहे पञ्चत्वमागते ।\nशोकस्यानवकाशत्वान्न शोचंति विपश्चितः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004039049, "chapter_id": 24039, "verse_number": "३-३-१०-५०", "content_sanskrit": "गुणैर्भूतानि सृज्यंते भ्राम्यंते निजकर्मभिः ।\nकालेनाथ विकृष्यंते वासनायां च शेरते॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004039050, "chapter_id": 24039, "verse_number": "३-३-१०-५१", "content_sanskrit": "माययोत्पत्तिमायांति गुणाः सत्त्वादयस्त्रयः ।\nतैरेव देहा जायंते जातास्तल्लक्षणाश्रयाः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004039051, "chapter_id": 24039, "verse_number": "३-३-१०-५२", "content_sanskrit": "देवत्वं यानि सत्त्वेन रजसा च मनुष्यताम् ।\nतिर्यक्त्वं तमसा जंतुर्वासनानुगतोवशः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004039052, "chapter_id": 24039, "verse_number": "३-३-१०-५३", "content_sanskrit": "संसारे वर्तमानेस्मिञ्जंतुः कर्मानुबन्धनात् ।\nदुर्विभाव्यां गतिं याति सुखदुःखमयीं मुहुः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004039053, "chapter_id": 24039, "verse_number": "३-३-१०-५४", "content_sanskrit": "अपि कल्पायुषां तेषां देवानां तु विपर्ययः ।\nअनेकामयबद्धानां का कथा नरदेहिनाम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004039054, "chapter_id": 24039, "verse_number": "३-३-१०-५५", "content_sanskrit": "केचिद्वदंति देहस्य कालमेव हि कारणम् ।\nकर्म केचिद्गुणान्केचिद्देहः साधारणो ह्ययम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004039055, "chapter_id": 24039, "verse_number": "३-३-१०-५६", "content_sanskrit": "कालकर्मगुणाधानं पञ्चात्मकमिदं वपुः ।\nजातं दृष्ट्वा न हृष्यंति न शोचंति मृतं बुधाः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004039056, "chapter_id": 24039, "verse_number": "३-३-१०-५७", "content_sanskrit": "अव्यक्ते जायते जंतुरव्यक्ते च प्रलीयते ।\nमध्ये व्यक्तवदाभाति जलबुद्बुदसन्निभः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004039057, "chapter_id": 24039, "verse_number": "३-३-१०-५८", "content_sanskrit": "यदा गर्भगतो देही विनाशः कल्पितस्तदा ।\nदैवाज्जीवति वा जातो म्रियते सहसैव वा॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004039058, "chapter_id": 24039, "verse_number": "३-३-१०-५९", "content_sanskrit": "गर्भस्था एव नश्यंति जातमात्रास्तथा परे ।\nक्वचिद्युवानो नश्यंति म्रियंते केपि वार्धके॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004039059, "chapter_id": 24039, "verse_number": "३-३-१०-६०", "content_sanskrit": "यादृशं प्राक्तनं कर्म तादृशं विंदते वपुः ।\nभुंक्ते तदनुरूपाणि सुखदुःखानि वै ह्यसौ॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004039060, "chapter_id": 24039, "verse_number": "३-३-१०-६१", "content_sanskrit": "मायानुभावेरितयोः पित्रोः सुरतसंभ्रमात् ।\nदेह उत्पद्यते कोपि पुंयोषित्क्लीबलक्षणः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004039061, "chapter_id": 24039, "verse_number": "३-३-१०-६२", "content_sanskrit": "आयुः सुखं च दुःख च पुण्यं पापं श्रुतं धनम् ।\nललाटे लिखितं धात्रा वहञ्जंतुः प्रजायते॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004039062, "chapter_id": 24039, "verse_number": "३-३-१०-६३", "content_sanskrit": "कर्मणामविलंघ्यत्वात्कालस्याप्यनतिक्रमात् ।\nअनित्यत्वाच्च भावानां न शोकं कर्तुमर्हसि॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004039063, "chapter_id": 24039, "verse_number": "३-३-१०-६४", "content_sanskrit": "क्व स्वप्ने नियतं स्थैर्यमिंद्रजाले क्व सत्यता ।\nक्व नित्यता शरन्मेघे क्व शश्वत्त्वं कलेवरे॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004039064, "chapter_id": 24039, "verse_number": "३-३-१०-६५", "content_sanskrit": "तव जन्मान्यतीतानि शतकोट्ययुतानि च ।\nअजानंत्याः परं तत्त्वं संप्राप्तोऽयं महाश्रमः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004039065, "chapter_id": 24039, "verse_number": "३-३-१०-६६", "content_sanskrit": "कस्यकस्यासि तनया जननी कस्यकस्य वा ।\nकस्यकस्यासि गृहिणी भवकोटिषु वर्त्तिनी॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004039066, "chapter_id": 24039, "verse_number": "३-३-१०-६७", "content_sanskrit": "पञ्चभूतात्मको देहस्त्वगसृङ्मांसबन्धनः ।\nमेदोमज्जास्थिनिचितो विण्मूत्रश्लेष्मभाजनम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004039067, "chapter_id": 24039, "verse_number": "३-३-१०-६८", "content_sanskrit": "शरीरांतरमप्येतन्निजदेहोद्भवं मलम् ।\nमत्त्वा स्वतनयं मूढे मा शोकं कर्तुमर्हसि॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004039068, "chapter_id": 24039, "verse_number": "३-३-१०-६९", "content_sanskrit": "यदि नाम जनः कश्चिन्मृत्युं तरति यत्नतः ।\nकथं तर्हि विपद्येरन्सर्वे पूर्वे विपश्चितः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004039069, "chapter_id": 24039, "verse_number": "३-३-१०-७०", "content_sanskrit": "तपसा विद्यया बुद्ध्या मन्त्रौषधिरसायनैः ।\nअतियाति परं मृत्युं न कश्चिदपि पंडितः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004039070, "chapter_id": 24039, "verse_number": "३-३-१०-७१", "content_sanskrit": "एकस्याद्य मृतिर्जंतोः श्वश्चान्यस्य वरानने ।\nतस्मादनित्यावयवे न त्वं शोचितुमर्हसि॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004039071, "chapter_id": 24039, "verse_number": "३-३-१०-७२", "content_sanskrit": "नित्यं सन्निहितो मृत्युः किं सुखं वद देहिनाम् ।\nव्याघ्रे पुरः स्थिते ग्रासः पशूनां किं नु रोचते॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004039072, "chapter_id": 24039, "verse_number": "३-३-१०-७३", "content_sanskrit": "अतो जन्मजरां जेतुं यदीच्छसि वरानने ।\nशरणं व्रज सर्वेशं मृत्युंजयमुमापतिम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004039073, "chapter_id": 24039, "verse_number": "३-३-१०-७४", "content_sanskrit": "तावन्मृत्युभयं घोरं तावज्जन्मजराभयम् ।\nयावन्नो याति शरणं देही शिवपदांबुजम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004039074, "chapter_id": 24039, "verse_number": "३-३-१०-७५", "content_sanskrit": "अनुभूयेह दुःखानि संसारे भृशदारुणे ।\nमनो यदा वियुज्येत तदा ध्येयो महेश्वरः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004039075, "chapter_id": 24039, "verse_number": "३-३-१०-७६", "content_sanskrit": "मनसा पिबतः पुंसः शिवध्यानरसामृतम् ।\nभूयस्तृष्णा न जायेत संसारविषयासवे॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004039076, "chapter_id": 24039, "verse_number": "३-३-१०-७७", "content_sanskrit": "विमुक्तं सर्वसंगैश्च मनो वैराग्ययंत्रितम् ।\nयदा शिवपदे मग्नं तदा नास्ति पुनर्भवः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004039077, "chapter_id": 24039, "verse_number": "३-३-१०-७८", "content_sanskrit": "तस्मादिदं मनो भद्रे शिवध्यानैकसाधनम् ।\nशोकमोहसमाविष्टं मा कुरुष्व शिवं भज॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004039078, "chapter_id": 24039, "verse_number": "३-३-१०-७९", "content_sanskrit": "सूत उवाच ।\nइत्थं सानुनयं राज्ञी बोधिता शिवयोगिना ।\nप्रत्याचष्ट गुरोस्तस्य प्रणम्य चरणां बुजम्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004039079, "chapter_id": 24039, "verse_number": "३-३-१०-८०", "content_sanskrit": "राज्ञ्युवाच ।\nभगवन्मृतपुत्रायास्त्यक्तायाः प्रियबन्धुभिः ।\nमहारोगातुराया मे का गतिर्मरणं विना॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004039080, "chapter_id": 24039, "verse_number": "३-३-१०-८१", "content_sanskrit": "अतोऽहं मर्तुमिच्छामि सहैव शिशुनाऽमुना ।\nकृतार्थाहं यदद्य त्वामपश्यं मरणोन्मुखी॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004039081, "chapter_id": 24039, "verse_number": "३-३-१०-८२", "content_sanskrit": "सूत उवाच ।\nइति तस्या वचः श्रुत्वा शिवयोगी दयानिधिः ।\nपूर्वोपकारं संस्मृत्य मृतस्यांतिकमाययौ॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004039082, "chapter_id": 24039, "verse_number": "३-३-१०-८३", "content_sanskrit": "स तदा भस्म संगृह्य शिवमन्त्राभिमंत्रितम् ।\nविदीर्णे तन्मुखे क्षिप्त्वा मृतं प्राणैरयोजयत्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004039083, "chapter_id": 24039, "verse_number": "३-३-१०-८४", "content_sanskrit": "स बालः संगतः प्राणैः शनैरुन्मील्य लोचने ।\nप्राप्तपूर्वेन्द्रियबलो रुरोद स्तन्यकांक्षया॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004039084, "chapter_id": 24039, "verse_number": "३-३-१०-८५", "content_sanskrit": "मृतस्य पुनरुत्थानं वीक्ष्य बालस्य विस्मिताः ।\nजना मुमुदिरे सर्वे नगरेषु पुरोगमाः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004039085, "chapter_id": 24039, "verse_number": "३-३-१०-८६", "content_sanskrit": "अथानंदभरा राज्ञी विह्वलोन्मत्तलोचना ।\nजग्राह तनयं शीघ्रं बाष्पव्याकुललोचना॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004039086, "chapter_id": 24039, "verse_number": "३-३-१०-८७", "content_sanskrit": "उपगुह्य तदा तन्वी परमानंदनिर्वृता ।\nन वेदात्मानमन्यं वा सुषुप्तेव परिश्रमात्॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004039087, "chapter_id": 24039, "verse_number": "३-३-१०-८८", "content_sanskrit": "पुनश्च ऋषभो योगी तयोर्मातृकुमारयोः ।\nविषव्रणयुतं देहं भस्मनैव परामृशत्॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004039088, "chapter_id": 24039, "verse_number": "३-३-१०-८९", "content_sanskrit": "तौ च तद्भस्मना स्पृष्टौ प्राप्तदिव्यकलेवरौ ।\nदेवानां सदृशं रूपं दधतुः कांतिभूषितम्॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004039089, "chapter_id": 24039, "verse_number": "३-३-१०-९०", "content_sanskrit": "संप्राप्ते त्रिदिवैश्वर्ये यत्सुखं पुण्यकर्मणाम् ।\nतस्माच्छतगुणं प्राप सा राज्ञी सुखमुत्तमम्॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004039090, "chapter_id": 24039, "verse_number": "३-३-१०-९१", "content_sanskrit": "तां पादयोर्निपतितामृषभः प्रेमविह्वलः ।\nउत्थाप्याश्वासयामास दुःखैर्मुक्तामुवाच ह॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004039091, "chapter_id": 24039, "verse_number": "३-३-१०-९२", "content_sanskrit": "अयि वत्से महाराज्ञि जीवत्वं शाश्वतीः समाः ।\nयावज्जीवसि लोकेस्मिन्न तावत्प्राप्स्यसे जराम्॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004039092, "chapter_id": 24039, "verse_number": "३-३-१०-९३", "content_sanskrit": "एष ते तनयः साध्वि भद्रायुरिति नामतः ।\nख्यातिं यास्यति लोकेषु निजं राज्यमवाप्स्यति॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004039093, "chapter_id": 24039, "verse_number": "३-३-१०-९४", "content_sanskrit": "अस्य वैश्यस्य सदने तावत्तिष्ठ शुचिस्मिते ।\nयावदेष कुमारस्ते प्राप्तविद्यो भविष्यति॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004039094, "chapter_id": 24039, "verse_number": "३-३-१०-९५", "content_sanskrit": "सूत उवाच॥  ।\nइति तामृषभो योगी तं च राजकुमारकम् ।\nसंजीव्य भस्मवीर्येण ययौ देशान्यथेप्सितान्॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]