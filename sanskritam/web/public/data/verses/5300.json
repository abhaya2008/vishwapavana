[{"id": 2201730, "chapter_id": 5300, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2201731, "chapter_id": 5300, "verse_number": "१", "content_sanskrit": "आलोकदानं नामैतत् कीदृशं भरतर्षभ ।\nकथमेतत् समुत्पन्नं फलं चात्र ब्रवीहि मे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2201732, "chapter_id": 5300, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2201733, "chapter_id": 5300, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nमनोः प्रजापतेर्वादं सुवर्णस्य च भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2201734, "chapter_id": 5300, "verse_number": "३", "content_sanskrit": "तपस्वी कश्चिदभवत् सुवर्णो नाम नामतः ।\nवर्णतो हेमवर्णः स सुवर्ण इति पप्रथे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2201735, "chapter_id": 5300, "verse_number": "४", "content_sanskrit": "कुलशीलगुणोपेतः स्वाध्याये च परं गतः ।\nबहून् स्ववंशप्रभवान् समतीतः स्वकैर्गुणैः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2201736, "chapter_id": 5300, "verse_number": "५", "content_sanskrit": "स कदाचिन्मनुं विप्रो ददर्शोपससर्प च ।\nकुशलप्रश्नमन्योन्यं तौ च तत्र प्रचक्रतुः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2201737, "chapter_id": 5300, "verse_number": "६", "content_sanskrit": "ततस्तौ सिद्धसङ्कल्पौ मेरौ काञ्चनपर्वते ।\nरमणीये शिलापृष्ठे सहितौ सन्न्यषीदताम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2201738, "chapter_id": 5300, "verse_number": "७", "content_sanskrit": "तत्र तौ कथयामास्तां कथा नानाविधाश्रयाः ।\nब्रह्मर्षिदेवदैत्यानां पुराणानां महात्मनाम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2201739, "chapter_id": 5300, "verse_number": "८", "content_sanskrit": "सुवर्णस्त्वब्रवीद् वाक्यं मनुं स्वायम्भुवं प्रभुम् ।\nहितार्थं सर्वभूतानां प्रश्नं मे वक्तुमर्हसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2201740, "chapter_id": 5300, "verse_number": "९", "content_sanskrit": "सुमनोभिर्यदिज्यन्ते दैवतानि प्रजेश्वर ।\nकिमेतत् कथमुत्पन्नं फलयोगं च शंस मे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2201741, "chapter_id": 5300, "verse_number": "", "content_sanskrit": "मनुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2201742, "chapter_id": 5300, "verse_number": "१०", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nशुक्रस्य च बलेश्चैव संवादं वै समागमे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2201743, "chapter_id": 5300, "verse_number": "११", "content_sanskrit": "बलेर्वैरोचनस्येह त्रैलोक्यमनुशासतः ।\nसमीपमाजगामाशु शुक्रो भृगुकुलोद्वहः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2201744, "chapter_id": 5300, "verse_number": "१२", "content_sanskrit": "तमर्घ्यादिभिरभ्यर्च्य भार्गवं सोऽसुराधिपः ।\nनिषसादासने पश्चाद् विधिवद् भूरिदक्षिणः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2201745, "chapter_id": 5300, "verse_number": "१३", "content_sanskrit": "कथेयमभवत् तत्र या त्वया परिकीर्तिता ।\nसुमनोधूपदीपानां सम्प्रदाने फलं प्रति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2201746, "chapter_id": 5300, "verse_number": "१४", "content_sanskrit": "ततः पप्रच्छ दैत्येन्द्रः कवीन्द्रं प्रश्नमुत्तमम् ।\nसुमनोधूपदीपानां किं फलं ब्रह्मवित्तम ।\nप्रदानस्य द्विजश्रेष्ठ तद् भवान् वक्तुमर्हति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2201747, "chapter_id": 5300, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2201748, "chapter_id": 5300, "verse_number": "१५", "content_sanskrit": "तपः पूर्वं समुत्पन्नं धर्मस्तस्मादनन्तरम् ।\nएतस्मिन्नन्तरे चैव वीरुदोषध्य एव च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2201749, "chapter_id": 5300, "verse_number": "१६", "content_sanskrit": "सोमस्यात्मा च बहुधा सम्भूतः पृथिवीतळे ।\nअमृतं च विषं चैव याश्चान्यास्तुल्यजातयः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2201750, "chapter_id": 5300, "verse_number": "१७", "content_sanskrit": "अमृतं मनसः प्रीतिं सद्यः पुष्टिं ददाति च ।\nमनो ग्लपयते तीव्रं विषं गन्धेन सर्वशः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2201751, "chapter_id": 5300, "verse_number": "१८", "content_sanskrit": "अमृतं मङ्गळं विद्धि महद् विषममङ्गलम् ।\nओषध्यो ह्यमृतं सर्वं विषं तेजोऽग्निसम्भवम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2201752, "chapter_id": 5300, "verse_number": "१९", "content_sanskrit": "मनो ह्लादयते यस्माच्छ्रियं चापि दधाति ह ।\nतस्मात् सुमनसः प्रोक्ता नरैः सुकृतकर्मभिः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2201753, "chapter_id": 5300, "verse_number": "२०", "content_sanskrit": "देवताभ्यः सुमनसो यो ददाति नरः शुचिः ।\nदेवाः सुमनसः तस्मै तस्मात् समुनसः स्मृताः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2201754, "chapter_id": 5300, "verse_number": "२१", "content_sanskrit": "यं यमुद्दिश्य दीयेरन् देवं सुमनसः प्रभो ।\nमङ्गळार्थं स तेनास्य प्रीतो भवति दैत्यप\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2201755, "chapter_id": 5300, "verse_number": "२२", "content_sanskrit": "ज्ञेयास्तूग्राश्च सौम्याश्च तेजस्विन्यश्च ताः पृथक् ।\nओषध्यो बहुवीर्याश्च बहुरूपास्तथैव च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2201756, "chapter_id": 5300, "verse_number": "२३", "content_sanskrit": "यज्ञियानां च वृक्षाणामयज्ञियान् निबोध मे ।\nआसुराणि च माल्यानि दैवतेभ्यो हितानि च\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2201757, "chapter_id": 5300, "verse_number": "२४", "content_sanskrit": "राक्षसानां सुराणां च यक्षाणां च तथा प्रियाः ।\nपितॄणां मानुषाणां च कान्ता यास्त्वनुपूर्वशः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2201758, "chapter_id": 5300, "verse_number": "२५", "content_sanskrit": "वन्या ग्राम्याश्चेह तथा कृष्टोप्ताः पर्वताश्रयाः ।\nअकण्टकाः कण्टकिन्यो गन्धरूपरसान्विताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2201759, "chapter_id": 5300, "verse_number": "२६", "content_sanskrit": "द्विविधो हि स्मृतो गन्ध इष्टोऽनिष्टश्च पुष्पजः ।\nइष्टगन्धानि देवानां पुष्पाणीति विभावयेत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2201760, "chapter_id": 5300, "verse_number": "२७", "content_sanskrit": "अकण्टकानां वृक्षाणां श्वेतप्रायाश्च वर्णतः ।\nतेषां पुष्पाणि देवानामिष्टानि सततं प्रभो\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2201761, "chapter_id": 5300, "verse_number": "२८", "content_sanskrit": "जलजानि च माल्यानि पद्मादीनि च यानि च ।\nगन्धर्वनागयक्षेभ्यस्तानि दद्याद् विचक्षणः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2201762, "chapter_id": 5300, "verse_number": "२९", "content_sanskrit": "ओषध्यो रक्तपुष्पाश्च कटुकाः कण्टकान्विताः ।\nशत्रूणामभिचारार्थमथर्वसु निदर्शिताः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2201763, "chapter_id": 5300, "verse_number": "३०", "content_sanskrit": "तीक्ष्णवीर्यास्तु भूतानां दुरालम्भाः सकण्टकाः ।\nरक्तभूयिष्ठवर्णाश्च कृष्णा रक्षोगणेष्विह\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2201764, "chapter_id": 5300, "verse_number": "३१", "content_sanskrit": "मनोहृदयनन्दिन्यो विमर्दे मधुराश्च याः ।\nचारुरूपाः सुमनसो मानुष्यांश्च स्मृता विभो\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2201765, "chapter_id": 5300, "verse_number": "३२", "content_sanskrit": "न तु स्मशानसम्भूता न देवायतनोद्भवाः ।\nसन्नयेत् पुष्टियुक्तेषु विवाहेषु रहःसु च\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2201766, "chapter_id": 5300, "verse_number": "३३", "content_sanskrit": "गिरिसानुरुहाः सौम्या देवानामुपपादयेत् ।\nप्रोक्षिताभ्युक्षिताः सौम्या यथायोगं यथास्मृति\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2201767, "chapter_id": 5300, "verse_number": "३४", "content_sanskrit": "गन्धेन देवास्तुष्यन्ति दर्शनाद् यक्षराक्षसाः ।\nनागाः समुपभोगेन त्रिभिरेतैस्तु मानुषाः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2201768, "chapter_id": 5300, "verse_number": "३५", "content_sanskrit": "सद्यः प्रीणाति देवान् वै ते प्रीता भावयन्त्युत ।\nसङ्कल्पसिद्धिर्भूतानां पुष्पैर्लभ्याऽसुरैः सदा\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2201769, "chapter_id": 5300, "verse_number": "३६", "content_sanskrit": "देवाः प्रीणन्ति सततं मानिता मानयन्ति च ।\nअवज्ञातावधूताश्च निर्दहन्त्यधमान् नरान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2201770, "chapter_id": 5300, "verse_number": "३७", "content_sanskrit": "अत ऊर्ध्वं प्रवक्ष्यामि धूपदानविधौ फलम् ।\nधूपांश्च विविधान् साधूनसाधूंश्च निबोध मे\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2201771, "chapter_id": 5300, "verse_number": "३८", "content_sanskrit": "निर्यासः सारिणश्चैव कृत्रिमश्चैव ते त्रयः ।\nइष्टानिष्टो भवेद् गन्धस्तन्मे विस्तरतः शृणु\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2201772, "chapter_id": 5300, "verse_number": "३९", "content_sanskrit": "निर्यासाः सल्लकीवर्ज्या देवानां दयितास्तु ते ।\nगुग्गुलुः प्रवरस्तेषां सर्वेषामिति निश्चयः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2201773, "chapter_id": 5300, "verse_number": "४०", "content_sanskrit": "अगरुः सारिणां श्रेष्ठो यक्षगन्धर्वरक्षसाम् ।\nदैत्यानां सल्लकीजश्च काङ्क्षितो यश्च तद्विधः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2201774, "chapter_id": 5300, "verse_number": "४१", "content_sanskrit": "अथ सर्जरसादीनि गन्धैः पार्थिवदारवैः ।\nफाणितासवसंयुक्तैर्मनुष्याणां विधीयते\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2201775, "chapter_id": 5300, "verse_number": "४२", "content_sanskrit": "देवदानवभूतानां सद्यस्तुष्टिकरः स्मृतः ।\nयेऽन्ये वैहारिकास्ते तु मानुषाणामिति स्मृताः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2201776, "chapter_id": 5300, "verse_number": "४३", "content_sanskrit": "य एवोक्ताः सुमनसां प्रदाने गुणहेतवः ।\nधूपेष्वपि परिज्ञेयास्त एव प्रीतिवर्धनाः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2201777, "chapter_id": 5300, "verse_number": "४४", "content_sanskrit": "दीपदाने प्रवक्ष्यामि फलयोगमनुत्तमम् ।\nयथा येन यदा चैव प्रदेया यादृशाश्च ते\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2201778, "chapter_id": 5300, "verse_number": "४५", "content_sanskrit": "ज्योतिस्तेजः प्रकाशश्चाप्यूर्ध्वगं चापि वर्ण्यते ।\nप्रदानं तेजसो तस्मात् तेजो वर्धयते नृणाम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2201779, "chapter_id": 5300, "verse_number": "४६", "content_sanskrit": "अन्धं तमस्तमिस्रं च दक्षिणायनमेव च ।\nउत्तरायणमेतस्माज्ज्योतिर्दानं प्रशस्यते\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2201780, "chapter_id": 5300, "verse_number": "४७", "content_sanskrit": "यस्मादूर्ध्वगमेतत् तु तमसश्चैव भेषजम् ।\nतस्मादूर्ध्वगतिर्दाता भवेदिति विनिश्चयः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2201781, "chapter_id": 5300, "verse_number": "४८", "content_sanskrit": "देवास्तेजस्विनो यस्मात् प्रभावन्तः प्रकाशकाः ।\nतामसा राक्षसाश्चेति तस्माद् दीपः प्रदीपयेत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2201782, "chapter_id": 5300, "verse_number": "४९", "content_sanskrit": "आलोकदानात् चक्षुष्मान् प्रभायुक्तो भवेन्नरः ।\nतान् दत्त्वा नोपहिंसेत न हरेन्नोपनाशयेत्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2201783, "chapter_id": 5300, "verse_number": "५०", "content_sanskrit": "दीपहर्ता भवेदन्धस्तमोगतिरसुप्रभः ।\nदीपप्रदः स्वर्गलोके दीपमाली विराजते\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2201784, "chapter_id": 5300, "verse_number": "५१", "content_sanskrit": "हविषा प्रथमः कल्पो द्वितीयस्त्वौषधीरसैः ।\nवसामेदोस्थिनिर्यासैर्न कार्यः पुष्टिमिच्छता\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2201785, "chapter_id": 5300, "verse_number": "५२", "content_sanskrit": "गिरिप्रपाते गहने चैत्यस्थाने चतुष्पथे ।\nदीपदाता भवेन्नित्यं य इच्छेद् भूतिमात्मनः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2201786, "chapter_id": 5300, "verse_number": "५३", "content_sanskrit": "कुलोद्द्योतो विशुद्धात्मा प्रकाशत्वं च गच्छति ।\nज्योतिषां चैव सालोक्यं दीपदाता नरः सदा\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2201787, "chapter_id": 5300, "verse_number": "५४", "content_sanskrit": "बलिकर्मसु वक्ष्यामि गुणान् कर्मफलोदयान् ।\nदेवयक्षोरगनृणां भूतानामथ रक्षसाम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2201788, "chapter_id": 5300, "verse_number": "५५", "content_sanskrit": "येषां नाग्रभुजो विप्रा देवतातिथिबालकाः ।\nराक्षसानेव तान् विद्धि निर्वषट्कारमङ्गलान्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2201789, "chapter_id": 5300, "verse_number": "५६", "content_sanskrit": "तस्मादग्रं प्रयच्छेत देवेभ्यश्च प्रपूजयेत् ।\nशिरसा प्रणतश्चापि हरेद् बलिमतन्द्रितः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2201790, "chapter_id": 5300, "verse_number": "५७", "content_sanskrit": "गृह्या हि देवता नित्यमाशंसन्ति गृहान् सदा ।\nबाह्याश्चागन्तवो येऽन्ये यक्षराक्षसपन्नगाः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2201791, "chapter_id": 5300, "verse_number": "५८", "content_sanskrit": "इतो दत्तेन जीवन्ति देवताः पितरस्तथा ।\nते प्रीताः प्रीणयन्त्येतानायुषा यशसा धनैः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2201792, "chapter_id": 5300, "verse_number": "५९", "content_sanskrit": "बलयः सह पुष्पैस्तु देवानामुपहारयेत् ।\nदधिद्रप्सयुताः पुण्याः सुगन्धाः प्रियदर्शनाः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2201793, "chapter_id": 5300, "verse_number": "६०", "content_sanskrit": "कार्या रुधिरमांसाढ्या बलयो यक्षरक्षसाम् ।\nसुरासवपुरस्कारा लाजोल्लेपनभूषिताः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2201794, "chapter_id": 5300, "verse_number": "६१", "content_sanskrit": "नागानां दयिता नित्यं पद्मोत्पलविमिश्रिताः ।\nतिलपिष्टं सुसम्पन्नं भूतानामुपहारयेत्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2201795, "chapter_id": 5300, "verse_number": "६२", "content_sanskrit": "अग्रदाताऽग्रभोगी स्याद् बलवर्णसमन्वितः ।\nतस्मादग्रं प्रयच्छेत देवादिभ्यः सुपूजितम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2201796, "chapter_id": 5300, "verse_number": "६३", "content_sanskrit": "ज्वलत्यहरहो वेश्म याश्चास्य गृहदेवताः ।\nताः पूज्या भूतिकामेन प्रसृताग्रप्रदायिना\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2201797, "chapter_id": 5300, "verse_number": "६४", "content_sanskrit": "इत्येतदसुरेन्द्राय काव्यः प्रोवाच भार्गवः ।\nसुवर्णाय मनुः प्राह सुवर्णो नारदाय च\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2201798, "chapter_id": 5300, "verse_number": "६५", "content_sanskrit": "नारदोऽपि मयि प्राह गुणानेतान् महाद्युते ।\nत्वमप्येतद् विदित्वेह सर्वमाचर पौत्रक\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2201799, "chapter_id": 5300, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे दीपादिदानविधिकथनं नाम एकपञ्चाशदुत्तरशततमोऽध्यायः ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2201800, "chapter_id": 5300, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]