[{"id": 5000069000, "chapter_id": 9069, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे एकोनसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000069001, "chapter_id": 9069, "verse_number": "१-६९-१", "content_sanskrit": "ततो रात्र्यां व्यतीतायां सोपाध्यायः सबान्धवः।\nराजा दशरथो हृष्टः सुमन्त्रमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000069002, "chapter_id": 9069, "verse_number": "१-६९-२", "content_sanskrit": "अद्य सर्वे धनाध्यक्षा धनमादाय पुष्कलम्।\nव्रजन्त्वग्रे सुविहिता नानारत्नसमन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000069003, "chapter_id": 9069, "verse_number": "१-६९-३", "content_sanskrit": "चतुरंगबलं चापि शीघ्रं निर्यातु सर्वशः।\nममाज्ञासमकालं च यानं युग्यमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000069004, "chapter_id": 9069, "verse_number": "१-६९-४", "content_sanskrit": "वसिष्ठो वामदेवश्च जाबालिरथ कश्यपः।\nमार्कण्डेयस्तु दीर्घायुर्ऋषिः कात्यायनस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000069005, "chapter_id": 9069, "verse_number": "१-६९-५", "content_sanskrit": "एते द्विजाः प्रयान्त्वग्रे स्यन्दनं योजयस्व मे।\nयथा कालात्ययो न स्याद् दूता हि त्वरयन्ति माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000069006, "chapter_id": 9069, "verse_number": "१-६९-६", "content_sanskrit": "वचनाच्च नरेन्द्रस्य सेना च चतुरंगिणी।\nराजानमृषिभिः सार्धं व्रजन्तं पृष्ठतोऽन्वयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000069007, "chapter_id": 9069, "verse_number": "१-६९-७", "content_sanskrit": "गत्वा चतुरहं मार्गं विदेहानभ्युपेयिवान्।\nराजा च जनकः श्रीमान् श्रुत्वा पूजामकल्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000069008, "chapter_id": 9069, "verse_number": "१-६९-८", "content_sanskrit": "ततो राजानमासाद्य वृद्धं दशरथं नृपम्।\nमुदितो जनको राजा प्रहर्षं परमं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000069009, "chapter_id": 9069, "verse_number": "१-६९-९", "content_sanskrit": "उवाच वचनं श्रेष्ठो नरश्रेष्ठं मुदान्वितम्।\nस्वागतं ते नरश्रेष्ठ दिष्ट्या प्राप्तोऽसि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000069010, "chapter_id": 9069, "verse_number": "१-६९-१०", "content_sanskrit": "पुत्रयोरुभयोः प्रीतिं लप्स्यसे वीर्यनिर्जिताम्।\nदिष्ट्या प्राप्तो महातेजा वसिष्ठो भगवानृषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000069011, "chapter_id": 9069, "verse_number": "१-६९-११", "content_sanskrit": "सह सर्वैर्द्विजश्रेष्ठैर्देवैरिव शतक्रतुः।\nदिष्ट्या मे निर्जिता विघ्ना दिष्ट्या मे पूजितं कुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000069012, "chapter_id": 9069, "verse_number": "१-६९-१२", "content_sanskrit": "राघवैः सह सम्बन्धाद् वीर्यश्रेष्ठैर्महाबलैः।\nश्वः प्रभाते नरेन्द्र त्वं संवर्तयितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000069013, "chapter_id": 9069, "verse_number": "१-६९-१३", "content_sanskrit": "यज्ञस्यान्ते नरश्रेष्ठ विवाहमृषिसत्तमैः।\nतस्य तद् वचनं श्रुत्वा ऋषिमध्ये नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000069014, "chapter_id": 9069, "verse_number": "१-६९-१४", "content_sanskrit": "वाक्यं वाक्यविदां श्रेष्ठः प्रत्युवाच महीपतिम्।\nप्रतिग्रहो दातृवशः श्रुतमेतन्मया पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000069015, "chapter_id": 9069, "verse_number": "१-६९-१५", "content_sanskrit": "यथा वक्ष्यसि धर्मज्ञ तत् करिष्यामहे वयम्।\nतद् धर्मिष्ठं यशस्यं च वचनं सत्यवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000069016, "chapter_id": 9069, "verse_number": "१-६९-१६", "content_sanskrit": "श्रुत्वा विदेहाधिपतिः परं विस्मयमागतः।\nततः सर्वे मुनिगणाः परस्परसमागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000069017, "chapter_id": 9069, "verse_number": "१-६९-१७", "content_sanskrit": "हर्षेण महता युक्तास्तां रात्रिमवसन् सुखम्।\nअथ रामो महातेजा लक्ष्मणेन समं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000069018, "chapter_id": 9069, "verse_number": "१-६९-१८", "content_sanskrit": "विश्वामित्रं पुरस्कृत्य पितुः पादावुपस्पृशन्।\nराजा च राघवौ पुत्रौ निशाम्य परिहर्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000069019, "chapter_id": 9069, "verse_number": "१-६९-१९", "content_sanskrit": "उवास परमप्रीतो जनकेनाभिपूजितः।\nजनकोऽपि महातेजाः क्रिया धर्मेण तत्त्ववित्।\nयज्ञस्य च सुताभ्यां च कृत्वा रात्रिमुवास ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000069020, "chapter_id": 9069, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे एकोनसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]