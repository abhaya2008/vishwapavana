[{"id": 7004367000, "chapter_id": 24367, "verse_number": "५-३-६१-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेत्परं पुण्यं नर्मदादक्षिणे तटे ।\nशक्रतीर्थं सुविख्यातमशेषाघविनाशनम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004367001, "chapter_id": 24367, "verse_number": "५-३-६१-२", "content_sanskrit": "पुरा शक्रेण तत्रैव तपो वै दुरतिक्रमम् ।\nप्रारब्धं परया भक्त्या देवं प्रति महेश्वरम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004367002, "chapter_id": 24367, "verse_number": "५-३-६१-३", "content_sanskrit": "ततः संतोषितो देव उमापतिर्नराधिप ।\nदेवेन्द्रत्वं वरं राज्यं दानवानां वधं ददौ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004367003, "chapter_id": 24367, "verse_number": "५-३-६१-४", "content_sanskrit": "लब्धं शक्रेण नृपते नर्मदातीर्थभावतः ।\nततः पुण्यतमं तीर्थं संजातं वसुधातले॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004367004, "chapter_id": 24367, "verse_number": "५-३-६१-५", "content_sanskrit": "कार्त्तिकस्य तु मासस्य कृष्णपक्षे त्रयोदशीम् ।\nउपोष्य वै नरो भक्त्या सर्वपापैः प्रमुच्यते॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004367005, "chapter_id": 24367, "verse_number": "५-३-६१-६", "content_sanskrit": "दुःस्वप्नसम्भवैः पापैर्दुर्निमित्तसमुद्भवैः ।\nग्रहशाकिनिसम्भूतैर्मुच्यते पाण्डुनन्दन॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004367006, "chapter_id": 24367, "verse_number": "५-३-६१-७", "content_sanskrit": "शक्रेश्वरं नृपश्रेष्ठ ये प्रपश्यन्ति भक्तितः ।\nतेषां जन्मकृतं पापं नश्यते नात्र संशयः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004367007, "chapter_id": 24367, "verse_number": "५-३-६१-८", "content_sanskrit": "अगम्यागमने चैव अवाह्ये चैव वाहिते ।\nस्वामिमित्रविघाते यन्नश्यते नात्र संशयः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004367008, "chapter_id": 24367, "verse_number": "५-३-६१-९", "content_sanskrit": "गोप्रदानं प्रकर्तव्यं शुभं ब्राह्मणपुंगवे ।\nधुर्यं वा दापयेत्तस्मिन् सर्वाङ्गरुचिरं नृप॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004367009, "chapter_id": 24367, "verse_number": "५-३-६१-१०", "content_sanskrit": "दातव्यं परया भक्त्या स्वर्गे वासमभीप्सता ।\nएतत्ते सर्वमाख्यातं शक्रेश्वरफलं नृप॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]