[{"id": 2183384, "chapter_id": 4891, "verse_number": "", "content_sanskrit": "राजपुत्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2183385, "chapter_id": 4891, "verse_number": "१", "content_sanskrit": "न निकृत्या न डम्भेन ब्रह्मन्निच्छामि जीवितुम् ।\nनाधर्मयुक्तानिच्छेयमर्थान् सुमहतोऽप्यहम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2183386, "chapter_id": 4891, "verse_number": "२", "content_sanskrit": "पुरस्तादेव भगवन्मयैतदपवर्जितम् ।\nयेन मां नाभिशङ्केत यद्वा कृत्स्नं हितं भवेत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2183387, "chapter_id": 4891, "verse_number": "३", "content_sanskrit": "आनृशंस्येन धर्मेण लोके ह्यस्मिन् जिजीविषुः ।\nनाहमेतदलं कर्तंु नैतन्मय्युपपद्यते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2183388, "chapter_id": 4891, "verse_number": "", "content_sanskrit": "मुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2183389, "chapter_id": 4891, "verse_number": "४", "content_sanskrit": "उपपन्नस्त्वमेतेन यथा क्षत्रिय भाषसे ।\nप्रकृत्या ह्युपपन्नोऽसि बुद्ध्या चाद्भुतदर्शन\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2183390, "chapter_id": 4891, "verse_number": "५", "content_sanskrit": "उभयोरेव वामर्थे यतिष्ये तव तस्य च ।\nसंश्लेषं वा करिष्यामि शाश्वतं ह्यनपायिनम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2183391, "chapter_id": 4891, "verse_number": "६", "content_sanskrit": "त्वादृशं हि कुले जातमनृशंसं बहुश्रुतम् ।\nअमात्यं को न कुर्वीत राज्यप्रणयकोविदम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2183392, "chapter_id": 4891, "verse_number": "७", "content_sanskrit": "यस्त्वं प्अ्रव्राजितो राज्याद् व्यसनं चोत्तमं गतः ।\nआनृशंस्येन वृत्तेन क्षत्रियेच्छसि जीवितुम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2183393, "chapter_id": 4891, "verse_number": "८", "content_sanskrit": "आगन्ता मद्गृहं तात वैदेहः सत्यसङ्गरः ।\nयथाहं तं नियोक्ष्यामि तत् करिष्यत्यसंशयम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2183394, "chapter_id": 4891, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2183395, "chapter_id": 4891, "verse_number": "९", "content_sanskrit": "तत आहूय वैदेहं मुनिर्वचनमब्रवीत् ।\nअयं राजकुले जातो विदिताभ्यन्तरो मम\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2183396, "chapter_id": 4891, "verse_number": "१०", "content_sanskrit": "आदर्श इव शुद्धात्मा शारदश्चन्द्रमा इव ।\nनास्मिन् पश्यामि वृजिनं सर्वतो मे परीक्षितः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2183397, "chapter_id": 4891, "verse_number": "११", "content_sanskrit": "तेन ते सन्धिरेवास्तु विश्वसास्मिन् यथा मयि ।\nन राज्यमनमात्येन शक्यं शास्तुममित्रहन्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2183398, "chapter_id": 4891, "verse_number": "१२", "content_sanskrit": "अमात्यः शूर एव स्याद् बुद्धिसम्पन्न एव च ।\nतस्माच्चैव भयं राज्ञः पश्य राज्यस्य योजनम् ।\nधर्मात्मनां क्वचिल्लोके नान्यास्ति गतिरीदृशी\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2183399, "chapter_id": 4891, "verse_number": "१३", "content_sanskrit": "कृतात्मा राजपुत्रोऽयं सतां मार्गमनुष्ठितः ।\nसुसङ्गृहीतस्त्वेवैष त्वया धर्मपुरोगमः ।\nसंसेव्यमानः पुत्रस्ते गृह्णीयाद् वदतो गुणान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2183400, "chapter_id": 4891, "verse_number": "१४", "content_sanskrit": "यद्ययं प्रतियुद्ध्येत् त्वां स्वकर्म क्षत्रियस्य तत् ।\nजिगीषमाणस्त्वां युद्धे पितृपैतामहे पदे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2183401, "chapter_id": 4891, "verse_number": "१५", "content_sanskrit": "त्वं चापि प्रतियुद्ध्येथा विजिगीषुव्रते स्थितः ।\nअयुद्ध्वैव नियोगान्मे वशे वैदेह ते स्थितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2183402, "chapter_id": 4891, "verse_number": "१६", "content_sanskrit": "स त्वं धर्ममवेक्षस्व त्यक्त्वाऽधर्ममसाम्प्रतम् ।\nनहि कामान्नच द्रोहात् स्वधर्मं हातुमर्हसि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2183403, "chapter_id": 4891, "verse_number": "१७", "content_sanskrit": "नैव नित्यं जयस्तात नैव नित्यं पराजयः ।\nतस्माद् भोजयितव्यश्च भोक्तव्यश्च परो जनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2183404, "chapter_id": 4891, "verse_number": "१८", "content_sanskrit": "आत्मन्येव हि सन्दृश्यावुभौ जयपराजयौ ।\nनिःशेषकारिणां तात निःशेषकरणाद् भयम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2183405, "chapter_id": 4891, "verse_number": "१९", "content_sanskrit": "इत्युक्तः प्रत्युवाचेदं वचनं ब्राह्मणर्षभम् ।\nअभिपूज्याभिसत्कृत्य पूजार्हमनुमान्य च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2183406, "chapter_id": 4891, "verse_number": "२०", "content_sanskrit": "यथा ब्रूयान्महाप्राज्ञो यथा ब्रूयाद् बहुश्रुतः ।\nश्रेयस्कामो यथा ब्रूयादुभयोर्यत् क्षमं भवेत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2183407, "chapter_id": 4891, "verse_number": "२१", "content_sanskrit": "तथा वचनमुक्तोऽस्मि करिष्यामि च तत् तथा ।\nएतद्धि परमं श्रेयो न मेऽत्रास्ति विचारणा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2183408, "chapter_id": 4891, "verse_number": "२२", "content_sanskrit": "ततः कौसल्यमाहूय वैदेहो वाक्यमब्रवीत् ।\nधर्मतो नीतितश्चैव बलेन च जितो मया\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2183409, "chapter_id": 4891, "verse_number": "२३", "content_sanskrit": "सोऽहं त्वया त्वात्मगुणैर्जितः पार्थिवसत्तम ।\nआत्मानमनवज्ञाय जितवद् वर्ततां भवान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2183410, "chapter_id": 4891, "verse_number": "२४", "content_sanskrit": "नावमन्ये च ते बुद्धिं नावमन्ये च पौरुषम् ।\nनावमन्ये जयामीति जितवद् वर्ततां भवान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2183411, "chapter_id": 4891, "verse_number": "२५", "content_sanskrit": "यथावत् पूजितो राजन् गृहं गन्तासि मे गृहात् ।\nततः सम्पूज्य तौ विप्रं विश्वस्तौ जग्मतुर्गृहान्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2183412, "chapter_id": 4891, "verse_number": "२६", "content_sanskrit": "वैदेहस्त्वथ कौसल्यं प्रवेश्य गृहमञ्जसा ।\nपाद्यार्घ्यमधुपर्कैस्तं पूजार्हं प्रत्यपूजयत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2183413, "chapter_id": 4891, "verse_number": "२७", "content_sanskrit": "ददौ दुहितरं चास्मै रत्नानि विविधानि च ।\nएष राज्ञां परो धर्मः सह्यौ जयपराजयौ\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2183414, "chapter_id": 4891, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे अष्टाधिकशततमोध्यायः ॥ १०८ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]