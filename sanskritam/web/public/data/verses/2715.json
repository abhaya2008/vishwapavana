[{"id": 2080633, "chapter_id": 2715, "verse_number": "१२-२२०-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080634, "chapter_id": 2715, "verse_number": "१२-२२०-१", "content_sanskrit": "केन वृत्तेन वृत्तज्ञो जनको मिथिलाधिपः।\nजगाम मोक्षं धर्मज्ञो भोगानुत्सृज्य बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080635, "chapter_id": 2715, "verse_number": "१२-२२०-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080636, "chapter_id": 2715, "verse_number": "१२-२२०-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nयेन वृत्तेन धर्मज्ञः स जगाम महत्सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080637, "chapter_id": 2715, "verse_number": "१२-२२०-३", "content_sanskrit": "जनको जनदेवस्तु मिथिलायां जनाधिप।\nऔर्ध्वदेहिकधर्माणामासीद्युक्तो विचिन्तने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080638, "chapter_id": 2715, "verse_number": "१२-२२०-४", "content_sanskrit": "तस्य स्म शतमाचार्या वसन्ति सततं गृहे।\nदर्शयन्तः पृथग्धर्मान्नानापाषण्डवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080639, "chapter_id": 2715, "verse_number": "१२-२२०-५", "content_sanskrit": "स तेषां प्रेत्यभावेन प्रेत्य गातौ विनिश्चये।\nआगमस्थः स भूयिष्ठमात्मतत्त्वेन तुष्यन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080640, "chapter_id": 2715, "verse_number": "१२-२२०-६", "content_sanskrit": "तत्र पञ्चशिखो नाम कापिलेयो महामुनिः।\nपरिधावन्महीं कृत्स्नां जगाम यलामथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080641, "chapter_id": 2715, "verse_number": "१२-२२०-७", "content_sanskrit": "सर्वसंन्यासधर्माणां तत्त्वज्ञाननिश्चये।\nसुपर्यवसितार्थश्च निर्द्वन्द्वो नष्टगशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080642, "chapter_id": 2715, "verse_number": "१२-२२०-८", "content_sanskrit": "ऋषीणामाहुरेकं यं कामाद-----नृषु।\nशाश्वतं सुखमत्यन्तमन्वि---सुदुर्लभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080643, "chapter_id": 2715, "verse_number": "१२-२२०-९", "content_sanskrit": "यमाहुः कपिलं साङ्ख्याः परमर्षि प्रजापतिम्।\nसमेत्य तेन रूपेण विस्मापयति हि स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080644, "chapter_id": 2715, "verse_number": "१२-२२०-१०", "content_sanskrit": "आसुरेः प्रथमं शिष्यं यमाहुश्चिरजीविनम्।\nपञ्चस्रोतसि यः सत्रमास्ते वर्षसहस्रिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080645, "chapter_id": 2715, "verse_number": "१२-२२०-११", "content_sanskrit": "तमासीनं समागम्य कापिलं मण्डलं महत्।\n[पञ्चस्रोतसि निष्णातः पञ्चरात्रविशारदः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080646, "chapter_id": 2715, "verse_number": "१२-२२०-१२", "content_sanskrit": "पञ्चज्ञः पञ्चकृत्पञ्चगुणः पञ्चशिखः स्मृतः।]\nपुरुषावस्थमव्यक्तं परमार्थं न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080647, "chapter_id": 2715, "verse_number": "१२-२२०-१३", "content_sanskrit": "इष्ट्वा सत्रेण संपृष्टो भूयश्च तपसाऽऽसुरिः।\nक्षेत्रक्षेत्रज्ञयोर्व्यक्तिं बुबुधे देवदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2080648, "chapter_id": 2715, "verse_number": "१२-२२०-१४", "content_sanskrit": "यत्तदेकाक्षरं ब्रह्म नानारूपं प्रदृश्यते।\n`बोधायनपरान्विप्रानृषिभावमुपागतः।\nआसुरिर्मण्डले तस्मिन्प्रतिपेदे तदव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2080649, "chapter_id": 2715, "verse_number": "१२-२२०-१५", "content_sanskrit": "तस्य पञ्चशिखः शिष्यो मानुष्याः पयसा भृतः।\nब्राह्मणी कपिला नाम काचिदासीत्कुटुम्बिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2080650, "chapter_id": 2715, "verse_number": "१२-२२०-१६", "content_sanskrit": "तस्याः पुत्रत्वमागम्य स्त्रियाः स पिबति स्तनौ।\nततः स कापिलेयत्वं लेभे बुद्धिं च नैष्ठिकीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2080651, "chapter_id": 2715, "verse_number": "१२-२२०-१७", "content_sanskrit": "एतन्मे भगवानाह कापिलेयस्य संभवम्।\nतस्य तत्कापिलेयत्वं सर्ववित्त्वमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2080652, "chapter_id": 2715, "verse_number": "१२-२२०-१८", "content_sanskrit": "सामान्यं जनकं ज्ञात्वा धर्मज्ञानामनुत्तमम्।\nउपेत्य शतमाचार्यान्मोहयामास हेतुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2080653, "chapter_id": 2715, "verse_number": "१२-२२०-१९", "content_sanskrit": "`निराकरिष्णुस्तान्सर्वांस्तेषां हेतुगुणान्वहून्।\nश्रावयामास मतिमान्मुनिः पञ्चशिखो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2080654, "chapter_id": 2715, "verse_number": "१२-२२०-२०", "content_sanskrit": "जनकस्त्वभिसंरक्तः कापिलेयानुदर्शनात्।\nउत्सृज्य शतमाचार्यान्पृष्ठतोऽनुजगाम तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2080655, "chapter_id": 2715, "verse_number": "१२-२२०-२१", "content_sanskrit": "तस्मै परमकल्याय प्रणताय च धर्मतः।\nअब्रवीत्परमं मोक्षं यतः साङ्ख्यं विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2080656, "chapter_id": 2715, "verse_number": "१२-२२०-२२", "content_sanskrit": "जातिनिर्वेदमुक्त्वा स कर्मनिर्वेदमब्रवीत्।\nकर्मनिर्वेदमुक्त्वा च सर्वनिर्वेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2080657, "chapter_id": 2715, "verse_number": "१२-२२०-२३", "content_sanskrit": "यदर्थं धर्मसंसर्गः कर्मणां च फलोदयः।\nतमनाश्वासिकं मोहं विनाशि चलमध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2080658, "chapter_id": 2715, "verse_number": "१२-२२०-२४", "content_sanskrit": "दृश्यमाने विनाशे च प्रत्यक्षे लोकसाक्षिके।\nआगमात्परमस्तीति ब्रुवन्नपि पराजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2080659, "chapter_id": 2715, "verse_number": "१२-२२०-२५", "content_sanskrit": "आत्मना ह्यात्मनो नित्यं क्लेशमृत्युजरामयम्।\nआत्मानं मन्यते मोहात्तदसम्यक्परं मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2080660, "chapter_id": 2715, "verse_number": "१२-२२०-२६", "content_sanskrit": "अथ चेदेवमप्यस्ति यल्लोके नोपपद्यते।\nअजरोऽयममृत्युश्च राजाऽसौ मन्यते तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2080661, "chapter_id": 2715, "verse_number": "१२-२२०-२७", "content_sanskrit": "अस्ति नास्तीति चाप्येतत्तस्मिन्नसति लक्षणे।\nकिमधिष्ठाय तद्ब्रूयाल्लोकयात्राविनिश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2080662, "chapter_id": 2715, "verse_number": "१२-२२०-२८", "content_sanskrit": "प्रत्यक्षं ह्येतयोर्मूलं कृतान्तैतिह्ययोरपि।\nप्रत्यक्षेणागमो भिन्नः कृतान्तो वा न कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2080663, "chapter_id": 2715, "verse_number": "१२-२२०-२९", "content_sanskrit": "यत्रतत्रानुमानेऽस्मिन्कृतं भावयतोऽपि च।\nनान्यो जीवः शरीरस्य नास्तिकानां मते स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2080664, "chapter_id": 2715, "verse_number": "१२-२२०-३०", "content_sanskrit": "रेतो वटकणीकायां घृतपाकाधिवासनम्।\nजातिः स्मृतिरयस्कान्तः सूर्यकान्तोऽम्बुभक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2080665, "chapter_id": 2715, "verse_number": "१२-२२०-३१", "content_sanskrit": "प्रेत्य भूताप्ययश्चैव देवताभ्युपयाचनम्।\nमृते कर्मनिवृत्तिश्च प्रमाणमिति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2080666, "chapter_id": 2715, "verse_number": "१२-२२०-३२", "content_sanskrit": "न त्वेते हेतवः सन्ति ये केचिन्मूर्तिसंस्थिताः।\nअमूर्तस्य हि मूर्तेन सामान्यं नोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2080667, "chapter_id": 2715, "verse_number": "१२-२२०-३३", "content_sanskrit": "अविद्याकर्मचेष्टानां केचिदाहुः पुनर्भवे।\nकारणं लोभमोहौ तु दोषाणां च निषेवणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2080668, "chapter_id": 2715, "verse_number": "१२-२२०-३४", "content_sanskrit": "अविद्यां क्षेत्रमाहुर्हि कर्मबीजं तथा कृतम्।\nतृष्णासंजननं स्नेह एष तेषां पुनर्भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2080669, "chapter_id": 2715, "verse_number": "१२-२२०-३५", "content_sanskrit": "तस्मिन्मूढे च जग्धे च देहे मरणधर्मिणि।\nअन्योऽसौ जायते प्रेतस्तदाहुस्तत्वमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2080670, "chapter_id": 2715, "verse_number": "१२-२२०-३६", "content_sanskrit": "यदा स्वरूपतश्चान्यो जातितः श्रुतितोऽर्थतः।\nकथमस्मिन्स इत्येवं संबोधः स्यादसंहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2080671, "chapter_id": 2715, "verse_number": "१२-२२०-३७", "content_sanskrit": "एवं सति च का प्रीतिर्दानविद्यातपोबलैः।\nयद्यदाचरितं कर्म सर्वमन्यत्प्रपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2080672, "chapter_id": 2715, "verse_number": "१२-२२०-३८", "content_sanskrit": "यदि ह्ययमिहैवान्यैः प्राकृतैर्दुःखितो भवेत्।\nसुखितो दुःखितैर्वाऽपि दृश्यो ह्यस्यविनिर्णयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2080673, "chapter_id": 2715, "verse_number": "१२-२२०-३९", "content_sanskrit": "यदा हि मुसलैर्हन्युः शरीरं न पुनर्भवेत्।\nपृथग्ज्ञानं यदन्यच्च येनैतन्नोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2080674, "chapter_id": 2715, "verse_number": "१२-२२०-४०", "content_sanskrit": "ऋतुसंवत्सरौ तिथ्यः शीतोष्णेऽथ प्रियाप्रिये।\nयथाऽतीता न दृश्यन्ते तादृशः सत्वसंक्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2080675, "chapter_id": 2715, "verse_number": "१२-२२०-४१", "content_sanskrit": "जरयाऽभिपरीतस्य मृत्युना न विनाशिना।\nदुर्बलं दुर्बलं पूर्वं गृहस्येव विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2080676, "chapter_id": 2715, "verse_number": "१२-२२०-४२", "content_sanskrit": "इन्द्रियाणी मनो वायुः शोणितं मांसमस्थि च।\nआनुपूर्व्या विनश्यन्ति स्वं धातुमुपयान्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2080677, "chapter_id": 2715, "verse_number": "१२-२२०-४३", "content_sanskrit": "लोकयात्राविधानं च दानधर्मफलागमः।\nतदर्थं वेदशब्दाश्च व्यवहाराश्च लौकिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2080678, "chapter_id": 2715, "verse_number": "१२-२२०-४४", "content_sanskrit": "इति सम्यङ्भनस्येते बहवः सन्ति हेतवः।\nएतदासीन्ममास्तीति न कश्चित्प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2080679, "chapter_id": 2715, "verse_number": "१२-२२०-४५", "content_sanskrit": "तेषां विमृशतामेवं तत्तत्समभिधावताम्।\nक्वचिन्निविशते बुद्धिस्तत्र जीर्यति वृक्षवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2080680, "chapter_id": 2715, "verse_number": "१२-२२०-४६", "content_sanskrit": "एवमर्थैरनर्थैश्च दुःखिताः सर्वजन्तवः।\nआगमैरपकृष्यन्ते हस्तिपैर्हस्तिनो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2080681, "chapter_id": 2715, "verse_number": "१२-२२०-४७", "content_sanskrit": "`न जातु कामः कामानामुपभोगेन शाम्यति।\nहविषा कृष्णवर्त्मेव भूय एवाभिवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2080682, "chapter_id": 2715, "verse_number": "१२-२२०-४८", "content_sanskrit": "अर्थांस्तथाऽत्यन्तमुखावहांश्च\nलिप्सन्त एते बहवो विशुष्काः।\nमहत्तरं दुःखमनुप्रपन्ना\nहित्वा सुखं मृत्युवशं प्रयान्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2080683, "chapter_id": 2715, "verse_number": "१२-२२०-४९", "content_sanskrit": "विनाशिनो ह्यध्नुवजीवितस्य\nकिं बन्धुभिर्मित्रपरिग्रहैश्च।\nविहाय यो गच्छति सर्वमेव\nक्षणेन गत्वा न निवर्तते च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2080684, "chapter_id": 2715, "verse_number": "१२-२२०-५०", "content_sanskrit": "भूव्योमतोयानलवायवोऽपि\nसदा शरीरं प्रतिपालयन्ति।\nइतीदमालक्ष्य रतिः कुतो भवे\nद्विनाशिनो ह्यस्य न कर्म विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2080685, "chapter_id": 2715, "verse_number": "१२-२२०-५१", "content_sanskrit": "इदमनुपधिवाक्यमच्छलं\nपरमनिरामयमात्मसाक्षिकम्।\nनरपतिरभिवीक्ष्य विस्मितः\nपुनरनुयोक्तुमिदं प्रचक्रमे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2080686, "chapter_id": 2715, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि विंशत्यधिकद्विशततमोऽध्यायः॥ २२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]