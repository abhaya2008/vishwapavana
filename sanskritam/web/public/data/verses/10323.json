[{"id": 6000323000, "chapter_id": 10323, "verse_number": null, "content_sanskrit": "अध्यायः २२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000323001, "chapter_id": 10323, "verse_number": null, "content_sanskrit": "अथ द्वाविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.001.m4a", "display_order": 2}, {"id": 6000323002, "chapter_id": 10323, "verse_number": null, "content_sanskrit": "उद्धव उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.002.m4a", "display_order": 3}, {"id": 6000323003, "chapter_id": 10323, "verse_number": "११-२२-१", "content_sanskrit": "कानि तत्वानि विश्वेश सङ्ख्यातान्यृषिभिः प्रभो।\nनवैकादश पञ्च त्रीनात्थ त्वमिह शुश्रुम॥ ११/२२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.003.m4a", "display_order": 4, "topics": [{"text": "तत्त्वसंख्यानप्रभेदानामविरोधकथनम्", "range": "१–२४"}]}, {"id": 6000323004, "chapter_id": 10323, "verse_number": "११-२२-२", "content_sanskrit": "केचित् षड्विंशतिं प्राहुरपरे पञ्चविंशतिम्। सप्तैके नव षट् केचिच्चत्वार्येकादशापरे।\nकेचित् सप्तदश प्राहुः षोडशैके त्रयोदश॥ ११/२२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.004.m4a", "display_order": 5}, {"id": 6000323005, "chapter_id": 10323, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.005.m4a", "display_order": 6}, {"id": 6000323006, "chapter_id": 10323, "verse_number": "११-२२-३", "content_sanskrit": "एतावत्त्वं हि सङ्ख्यानामृषयो यद्विवक्षया।\nगायन्ति पृथगायुष्मन्निदं नो वक्तुमर्हसि॥ ११/२२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.006.m4a", "display_order": 7}, {"id": 6000323007, "chapter_id": 10323, "verse_number": "११-२२-४", "content_sanskrit": "युक्तयः सन्ति सर्वत्र भाषन्ते ब्राह्मणा यथा।\nमायां मदीयामुद्गृह्य वदतां किं नु दुर्घटम्॥ ११/२२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.007.m4a", "display_order": 8}, {"id": 6000323008, "chapter_id": 10323, "verse_number": "११-२२-५", "content_sanskrit": "नैतदेवं यथाऽत्थ त्वं यदहं वच्मि तत् तथा।\nएवं विवदतां हेतुः शक्तयो मे दुरत्ययाः॥ ११/२२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.008.m4a", "display_order": 9}, {"id": 6000323009, "chapter_id": 10323, "verse_number": "११-२२-६", "content_sanskrit": "यासां व्यतिकरादासीद् विकल्पो वदतां पदम्।\nप्राप्ते शमदमे व्येति वादस्तमनुशाम्यति॥ ११/२२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.009.m4a", "display_order": 10}, {"id": 6000323010, "chapter_id": 10323, "verse_number": "११-२२-७", "content_sanskrit": "परस्परानुप्रवेशात् तत्वानां पुरुषर्षभ।\nपौर्वापर्यप्रसङ्ख्यानं यथा वक्तुर्विवक्षितम्॥ ११/२२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.010.m4a", "display_order": 11}, {"id": 6000323011, "chapter_id": 10323, "verse_number": "११-२२-८", "content_sanskrit": "एकस्मिन्नपि दृश्यन्ते प्रविष्टानीतराणि च।\nपूर्वस्मिन् वाऽपरस्मिन् वा तत्वे तत्वानि सर्वशः॥ ११/२२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.011.m4a", "display_order": 12}, {"id": 6000323012, "chapter_id": 10323, "verse_number": "११-२२-९", "content_sanskrit": "पौर्वापर्यमथोऽमीषां प्रसङ्ख्यानमभीप्सताम्।\nयथा विविक्तं यद्युक्तं गृह्णीमो युक्तिसम्भवात्॥ ११/२२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.012.m4a", "display_order": 13}, {"id": 6000323013, "chapter_id": 10323, "verse_number": "११-२२-१०", "content_sanskrit": "अनाद्यविद्यायुक्तस्य पुरुषस्यात्मवेदनम्।\nस्वतो न सम्भवेद् यस्मात् ततोऽन्यः पुरुषो भवेत्॥ ११/२२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.013.m4a", "display_order": 14}, {"id": 6000323014, "chapter_id": 10323, "verse_number": "११-२२-११", "content_sanskrit": "पुरुषेश्वरयोरत्र न वैलक्षण्यमण्वपि।\nतदन्यकल्पनाऽपार्था ज्ञानं च प्रकृतेर्गुणः॥ ११/२२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.014.m4a", "display_order": 15}, {"id": 6000323015, "chapter_id": 10323, "verse_number": "११-२२-१२", "content_sanskrit": "प्रकृतेर्गुणसाम्ये तु प्रकृतेर्नात्मनो गुणाः।\nसत्वं रजस्तम इति स्थित्युत्पत्त्यन्तहेतवः॥ ११/२२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.015.m4a", "display_order": 16}, {"id": 6000323016, "chapter_id": 10323, "verse_number": "११-२२-१३", "content_sanskrit": "सत्वं ज्ञानं रजः कर्म तमोऽज्ञानमिहोच्यते।\nगुणव्यतिकरः कालः स्वभावः सूत्रमेव च॥ ११/२२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.016.m4a", "display_order": 17}, {"id": 6000323017, "chapter_id": 10323, "verse_number": "११-२२-१४", "content_sanskrit": "पुरुषः प्रकृतिर्व्यक्तमहङ्कारो नभोऽनिलः।\nज्योतिरापः क्षितिरिति तत्वान्युक्तानि मे नव॥ ११/२२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.017.m4a", "display_order": 18}, {"id": 6000323018, "chapter_id": 10323, "verse_number": "११-२२-१५", "content_sanskrit": "श्रोत्रं त्वग् दर्शनं घ्राणो जिह्वेति ज्ञानशक्तयः।\nवाक्पाण्युपस्थपाय्वङ्घ्रिकर्माण्यङ्गोभयं मनः॥ ११/२२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.018.m4a", "display_order": 19}, {"id": 6000323019, "chapter_id": 10323, "verse_number": "११-२२-१६", "content_sanskrit": "शब्दः स्पर्शो रसो गन्धो रूपं चेत्यर्थजातयः।\nगत्युक्त्युत्सर्गशिल्पानि कर्मायतनसिद्धयः॥ ११/२२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.019.m4a", "display_order": 20}, {"id": 6000323020, "chapter_id": 10323, "verse_number": "११-२२-१७", "content_sanskrit": "सर्गादौ प्रकृतिर्ह्यस्य कार्यकारणरूपिणी।\nसत्वादिभिर्गुणैर्धत्ते पुरुषोऽव्यक्तमीक्षते॥ ११/२२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.020.m4a", "display_order": 21}, {"id": 6000323021, "chapter_id": 10323, "verse_number": "११-२२-१८", "content_sanskrit": "व्यक्तादयो विकुर्वाणा धातवः पुरुषेक्षया।\nलब्धवीर्याः सृजन्त्यण्डं संहताः प्रकृतेर्बलात्॥ ११/२२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.021.m4a", "display_order": 22}, {"id": 6000323022, "chapter_id": 10323, "verse_number": "११-२२-१९", "content_sanskrit": "सप्तैव धातव इति यत्रार्थाः पञ्च खादयः।\nज्ञानमात्मोभयाधारस्ततो देहेन्द्रियासवः॥ ११/२२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.022.m4a", "display_order": 23}, {"id": 6000323023, "chapter_id": 10323, "verse_number": "११-२२-२०", "content_sanskrit": "षडित्यत्रापि भूतानि पञ्च षष्ठः परः पुमान्।\nतैर्युक्त आत्मसम्भूतैः सृष्ट्वेदं समुपाविशत्॥ ११/२२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.023.m4a", "display_order": 24}, {"id": 6000323024, "chapter_id": 10323, "verse_number": "११-२२-२१", "content_sanskrit": "चत्वार्येवेति तत्रापि तेज आपोऽन्नमात्मनः।\nजातानि तैरिदं जातं जन्मावयविनः खलु॥ ११/२२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.024.m4a", "display_order": 25}, {"id": 6000323025, "chapter_id": 10323, "verse_number": "११-२२-२२", "content_sanskrit": "सङ्ख्याने सप्तदशके भूतमात्रेन्द्रियाणि च।\nपञ्चपञ्चैकमनसा आत्मा सप्तदशः स्मृतः॥ ११/२२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.025.m4a", "display_order": 26}, {"id": 6000323026, "chapter_id": 10323, "verse_number": "११-२२-२३", "content_sanskrit": "तद्वत् षोडशसङ्ख्यानि आत्मना मन उच्यते।\nभूतेन्द्रियाणि पञ्चैव मन आत्मा त्रयोदश॥ ११/२२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.026.m4a", "display_order": 27}, {"id": 6000323027, "chapter_id": 10323, "verse_number": "११-२२-२४", "content_sanskrit": "इति नानाप्रसङ्ख्यानं तत्वानामृषिभिः कृतम्।\nसर्वं न्याय्यं युक्तिमत्त्वाद् विदुषां किमशोभनम्॥ ११/२२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.027.m4a", "display_order": 28}, {"id": 6000323028, "chapter_id": 10323, "verse_number": null, "content_sanskrit": "उद्धव उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.028.m4a", "display_order": 29}, {"id": 6000323029, "chapter_id": 10323, "verse_number": "११-२२-२५", "content_sanskrit": "प्रकृतिः पुरुषश्चोभौ यद्यप्यात्मविलक्षणौ।\nअन्योन्यापाश्रयात् कृष्ण दृश्यते न भिदा तयोः॥ ११/२२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.029.m4a", "display_order": 30, "topics": [{"text": "प्रकृतिपुरुषविवेकः", "range": "२५–३२"}]}, {"id": 6000323030, "chapter_id": 10323, "verse_number": "११-२२-२६", "content_sanskrit": "प्रकृतौ लक्ष्यते ह्यात्मा प्रकृतिश्च तथाऽऽत्मनि। एतन्मे पुण्डरीकाक्ष महान्तं संशयं हृदि।\nछेत्तुमर्हसि पद्मेश वचोभिस्तत्वनैपुणैः॥ ११/२२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.030.m4a", "display_order": 31}, {"id": 6000323031, "chapter_id": 10323, "verse_number": "११-२२-२७", "content_sanskrit": "त्वत्तो ज्ञानं हि जीवानां प्रमोषस्तनुशक्तितः।\nत्वमेव ह्यात्ममायाया गतिं वेत्थ नचापरः॥ ११/२२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.031.m4a", "display_order": 32}, {"id": 6000323032, "chapter_id": 10323, "verse_number": "११-२२-२९", "content_sanskrit": "ममाङ्ग माया गुणमय्यनेकधा विकल्पबुद्धिं च गुणैर्विधत्ते।\nवैकारिकस्त्रिविधोऽध्यात्ममेकमथाधिदैवमधिभूतमन्यत्॥ ११/२२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.032.m4a", "display_order": 33}, {"id": 6000323033, "chapter_id": 10323, "verse_number": "११-२२-३०", "content_sanskrit": "दृग्‍रूपमर्कश्च परत्र रन्ध्रे परस्परं सिध्यति न स्वतोऽसौ।\nआत्मा यदेषामुपराम आद्यः स्वयाऽनुभूत्याऽखिलसिद्ध्यसिद्धिः॥ ११/२२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.033.m4a", "display_order": 34}, {"id": 6000323034, "chapter_id": 10323, "verse_number": "११-२२-३१", "content_sanskrit": "एवं त्वगादि श्रवणादि चक्षुर्जिह्वादि नासादि च चित्तयुक्तम्॥ ११/२२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.034.m4a", "display_order": 35}, {"id": 6000323035, "chapter_id": 10323, "verse_number": "११-२२-३२", "content_sanskrit": "योऽसौ गुणक्षोभकृतो विकारः प्रधानमूलो जगतः प्रसूतिः।\nअहं त्रिवृन्मोह विकल्पहेतुर्वैकारिकस्तामस ऐन्द्रियश्च॥ ११/२२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.035.m4a", "display_order": 36}, {"id": 6000323036, "chapter_id": 10323, "verse_number": "११-२२-३३", "content_sanskrit": "आत्मा परिज्ञानमयो विवादो ह्यस्तीति नास्तीति भिदाऽर्थनिष्ठः।\nव्यर्थोऽपि नैवोपरमेत पुंसां मत्तः परावृत्तधियां स्वलोकात्॥ ११/२२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.036.m4a", "display_order": 37, "topics": [{"text": "जन्ममृत्युप्रकारकथनम्", "range": "३३–५९"}]}, {"id": 6000323037, "chapter_id": 10323, "verse_number": null, "content_sanskrit": "उद्धव उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.037.m4a", "display_order": 38}, {"id": 6000323038, "chapter_id": 10323, "verse_number": "११-२२-३४", "content_sanskrit": "त्वत्तः परावृत्तधियः स्वकृतैः कर्मभिः प्रभो।\nउच्चावचान् यथा देहान् गृह्णन्ति विसृजन्ति च॥ ११/२२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.038.m4a", "display_order": 39}, {"id": 6000323039, "chapter_id": 10323, "verse_number": "११-२२-३५", "content_sanskrit": "तन्ममाख्याहि गोविन्द दुर्विभाव्यमनात्मभिः।\nन ह्येतत्प्रायशो लोके विद्वांसोऽञ्चन्ति वञ्चिताः॥ ११/२२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.039.m4a", "display_order": 40}, {"id": 6000323040, "chapter_id": 10323, "verse_number": null, "content_sanskrit": "श्री भगवानुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.040.m4a", "display_order": 41}, {"id": 6000323041, "chapter_id": 10323, "verse_number": "११-२२-३६", "content_sanskrit": "मनः कर्ममयं नॄणामिन्द्रियैः पञ्चभिर्युतम्।\nलोकाल्लोकं प्रयात्यन्यमात्मा तदनुवर्तते॥ ११/२२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.041.m4a", "display_order": 42}, {"id": 6000323042, "chapter_id": 10323, "verse_number": "११-२२-३७", "content_sanskrit": "ध्यायन्मनो हि विषयान् दृष्टान् वाऽनुश्रुतानथ।\nउद्यत् सीदत् कर्मतन्त्रं स्मृतिस्तदनु शाम्यति॥ ११/२२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.042.m4a", "display_order": 43}, {"id": 6000323043, "chapter_id": 10323, "verse_number": "११-२२-३८", "content_sanskrit": "विषयाभिनिवेशेन नात्मानं यत् स्मरेन्मनः।\nजन्तोर्वै कस्यचिद्धेतोर्मृत्युरत्यन्तविस्मृतिः॥ ११/२२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.043.m4a", "display_order": 44}, {"id": 6000323044, "chapter_id": 10323, "verse_number": "११-२२-३९", "content_sanskrit": "जन्म त्वात्मतया पुंसः सर्वभावेन भूरिद।\nविषयस्वीकृतिं प्राहुर्यथा स्वप्नमनोरथः॥ ११/२२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.044.m4a", "display_order": 45}, {"id": 6000323045, "chapter_id": 10323, "verse_number": "११-२२-४०", "content_sanskrit": "स्वप्नं मनोरथं चार्थं प्राक्तनं न स्मरत्यसौ।\nतत्र पूर्वमिवात्मानमपूर्वं चानुपश्यति॥ ११/२२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.045.m4a", "display_order": 46}, {"id": 6000323046, "chapter_id": 10323, "verse_number": "११-२२-४१", "content_sanskrit": "ईदृशायास विज्ञाय त्रैविध्यं भाति वस्तुनि।\nबहिरन्तर्भिदाहेतुर्जनोऽसज्जनकृद् यथा॥ ११/२२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.046.m4a", "display_order": 47}, {"id": 6000323047, "chapter_id": 10323, "verse_number": "११-२२-४२", "content_sanskrit": "नित्यदा ह्यङ्ग भूतानि भवन्ति न भवन्ति च।\nकालेनालक्ष्यवेगेन सूक्ष्मत्वात् तन्न दृश्यते॥ ११/२२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.047.m4a", "display_order": 48}, {"id": 6000323048, "chapter_id": 10323, "verse_number": "११-२२-४३", "content_sanskrit": "यथाऽर्चिषां स्रोतसां च फलानां वा वनस्पतेः।\nतथैव सर्वभूतानां वयोऽवस्था च तत्कृता॥ ११/२२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.048.m4a", "display_order": 49}, {"id": 6000323049, "chapter_id": 10323, "verse_number": "११-२२-४४", "content_sanskrit": "सोऽयं दीपोऽर्चिषां यद्वत् स्रोतसां तदिदं जलम्।\nसोऽयं पुमानिति नृणां मृषागीर्भिर्मृषायुषाम्॥ ११/२२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.049.m4a", "display_order": 50}, {"id": 6000323050, "chapter_id": 10323, "verse_number": "११-२२-४५", "content_sanskrit": "आद्यः स्वकर्मबीजेन जायते सोऽव्ययः पुमान्।\nम्रियते चामरो भ्रान्त्या यथाऽग्निर्दारुसंयुतः॥ ११/२२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.050.m4a", "display_order": 51}, {"id": 6000323051, "chapter_id": 10323, "verse_number": "११-२२-४६", "content_sanskrit": "निषेकगर्भजन्मानि बाल्यकौमारयौवनम्।\nवयो मध्यं जरा मृत्युरित्यवस्थास्तनोर्नव॥ ११/२२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.051.m4a", "display_order": 52}, {"id": 6000323052, "chapter_id": 10323, "verse_number": "११-२२-४७", "content_sanskrit": "एता मनोरथमयीर्ह्यन्यस्योच्चावचास्तनूः।\nगुणसङ्गादुपादत्ते क्‍वचित् काश्चिज्जहाति च॥ ११/२२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.052.m4a", "display_order": 53}, {"id": 6000323053, "chapter_id": 10323, "verse_number": "११-२२-४८", "content_sanskrit": "आत्मनः पितृपुत्राभ्यामनुमेयौ भवाप्ययौ।\nभवाप्ययौ हि भूतानामभिज्ञाद्वयलक्षणौ॥ ११/२२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.053.m4a", "display_order": 54}, {"id": 6000323054, "chapter_id": 10323, "verse_number": "११-२२-४९", "content_sanskrit": "तरोर्बीजविकाराभ्यां यो विद्वान् जन्मसंयमौ।\nतरोर्विलक्षणो दृष्ट एवं द्रष्टा तनोः पृथक्॥ ११/२२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.054.m4a", "display_order": 55}, {"id": 6000323055, "chapter_id": 10323, "verse_number": "११-२२-५०", "content_sanskrit": "प्रकृतेरेवमात्मानमविविच्याबुधः पुमान्।\nतत्वेन स्पर्शसम्मूढः संसारं प्रतिपद्यते॥ ११/२२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.055.m4a", "display_order": 56}, {"id": 6000323056, "chapter_id": 10323, "verse_number": "११-२२-५१", "content_sanskrit": "सत्वसङ्गाद् ऋषीन् देवान् रजसाऽऽसुरमानुषान्।\nतमसा भूततिर्यक्त्वं भ्रामितो याति कर्मभिः॥ ११/२२/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.056.m4a", "display_order": 57}, {"id": 6000323057, "chapter_id": 10323, "verse_number": "११-२२-५२", "content_sanskrit": "नृत्यतो गायतः पश्यन् यथैवानुकरोति तान्।\nएवं बुद्धिगुणान् पश्यन्ननीहोऽप्यनुकार्यते॥ ११/२२/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.057.m4a", "display_order": 58}, {"id": 6000323058, "chapter_id": 10323, "verse_number": "११-२२-५३", "content_sanskrit": "यथाऽम्भसा प्रचलता तरवोऽपि चला इव।\nचक्षुषा भ्राम्यमाणेन दृश्यते भ्रमतीव भूः॥ ११/२२/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.058.m4a", "display_order": 59}, {"id": 6000323059, "chapter_id": 10323, "verse_number": "११-२२-५४", "content_sanskrit": "यथा मनोरथधियो विषयानुभवो मृषा।\nस्वप्नदृष्टश्च दाशार्ह तथा संसार आत्मनः॥ ११/२२/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.059.m4a", "display_order": 60}, {"id": 6000323060, "chapter_id": 10323, "verse_number": "११-२२-५५", "content_sanskrit": "अर्थे ह्यविद्यमानेऽपि संसृतिर्न निवर्तते।\nध्यायतो विषयान् पुंसः स्वप्नेऽप्यर्थागमो यथा॥ ११/२२/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.060.m4a", "display_order": 61}, {"id": 6000323061, "chapter_id": 10323, "verse_number": "११-२२-५६", "content_sanskrit": "तस्मादुद्धव मा भुङ्क्ष्व विषयानसदिन्द्रियैः।\nआत्माग्रहणनिष्पन्नं पश्यन् वैकल्पिकं भ्रमम्॥ ११/२२/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.061.m4a", "display_order": 62}, {"id": 6000323062, "chapter_id": 10323, "verse_number": "११-२२-५७", "content_sanskrit": "क्षिप्तोऽवमानितोऽसद्भिः प्रलब्धः शापितोऽपि वा।\nताडितः सन्निरुद्धो वा वृत्त्या वा परिहापितः॥ ११/२२/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.062.m4a", "display_order": 63}, {"id": 6000323063, "chapter_id": 10323, "verse_number": "११-२२-५८", "content_sanskrit": "विष्ठितो मूत्रितो वाऽज्ञैर्बहुधैवं प्रकम्पितः।\nश्रेयस्कामः कृच्छ्रगत आत्मनाऽऽत्मानमुद्धरेत्॥ ११/२२/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.063.m4a", "display_order": 64}, {"id": 6000323064, "chapter_id": 10323, "verse_number": null, "content_sanskrit": "उद्धव उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.064.m4a", "display_order": 65}, {"id": 6000323065, "chapter_id": 10323, "verse_number": "११-२२-५९", "content_sanskrit": "यथैवमनुबुध्येयं वद नो वदतां वर।\nसुदुःसहमहं मन्ये आत्मन्यसदतिक्रमम्॥ ११/२२/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.065.m4a", "display_order": 66}, {"id": 6000323066, "chapter_id": 10323, "verse_number": "११-२२-६०", "content_sanskrit": "विदुषामपि विश्वात्मन् प्रकृतिर्हि बलीयसी।\nऋते त्वद्धर्मनिरतान् शान्तांस्ते चरणालयान्॥ ११/२२/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_022/BhP_11.022.066.m4a", "display_order": 67}, {"id": 6000323067, "chapter_id": 10323, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे द्वाविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]