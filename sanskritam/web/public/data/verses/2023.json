[{"id": 2046042, "chapter_id": 2023, "verse_number": "६-७२-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2046043, "chapter_id": 2023, "verse_number": "६-७२-१", "content_sanskrit": "शिखण्डी सह मत्स्येन विराटेन विशांपते।\nभीष्ममाशु महेष्वासमाससाद सुदुर्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2046044, "chapter_id": 2023, "verse_number": "६-७२-२", "content_sanskrit": "द्रोणं कृपं विकर्णं च महेष्वासं महाबलम् ।\nराज्ञश्चान्यान्रणे शूरान्बहूनार्च्छद्धनंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2046045, "chapter_id": 2023, "verse_number": "६-७२-३", "content_sanskrit": "सैन्धवं च महेष्वासं सामात्यं सह बन्धुभिः ।\nप्राच्यांश्च दाक्षिणात्यांश्च भूमिपान्भूमिपर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2046046, "chapter_id": 2023, "verse_number": "६-७२-४", "content_sanskrit": "पुत्रं च ते महेष्वासं दुर्योधनममर्षणम् ।\nदुःसहं चैव समरे भीमसेनोऽभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2046047, "chapter_id": 2023, "verse_number": "६-७२-५", "content_sanskrit": "सहदेवस्तु शकुनिमुलूकं च महारथम् ।\nपितापुत्रौ महेष्वासावभ्यवर्तत दुर्जयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2046048, "chapter_id": 2023, "verse_number": "६-७२-६", "content_sanskrit": "युधिष्ठिरो महाराज गजानीकं महारथः ।\nसमवर्तत संग्रामे पुत्रेण निकृतस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2046049, "chapter_id": 2023, "verse_number": "६-७२-७", "content_sanskrit": "माद्रीपुत्रस्तु नकुलः शूरसंक्रन्दनो युधि ।\nत्रिगर्तानां बलैः सार्धं समसञ्जत पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2046050, "chapter_id": 2023, "verse_number": "६-७२-८", "content_sanskrit": "अभ्यवर्तन्त संक्रुद्धाः समरे साल्वकेकयान्।\nसात्यकिश्चेकितानश्च सौभद्रश्च महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2046051, "chapter_id": 2023, "verse_number": "६-७२-९", "content_sanskrit": "धृष्टकेतुश्च समरे राक्षसश्च घटोत्कचः ।\nनाकुलिश्च शतानीकः समरे रथपुङ्गवः ।\nपुत्राणां ते रथानीकं प्रत्युद्याताः सुदुर्जयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2046052, "chapter_id": 2023, "verse_number": "६-७२-१०", "content_sanskrit": "सेनापतिरमेयात्मा धृष्टद्युम्नो महाबलः ।\nद्रोणेन समरे राजन्समियायोग्रकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2046053, "chapter_id": 2023, "verse_number": "६-७२-११", "content_sanskrit": "एवमेते महेष्वासास्तावकाः पाण्डवैः सह ।\nसमेत्य समरे शूराः संप्राहारं प्रचक्रिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2046054, "chapter_id": 2023, "verse_number": "६-७२-१२", "content_sanskrit": "मध्यंदिनगते सूर्ये नभस्याकुलतां गते ।\nकुरवः पाण्डवेयाश्च निजघ्नुरितरेतरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2046055, "chapter_id": 2023, "verse_number": "६-७२-१३", "content_sanskrit": "ध्वजिनो हेमचित्राङ्गा विचरन्तो रणाजिरे ।\nसपताका रथा रेजुर्वैयाघ्रपरिवारणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2046056, "chapter_id": 2023, "verse_number": "६-७२-१४", "content_sanskrit": "समेतानां च समरे जिगीषूणां परस्परम् ।\nबभूव तुमुलः शब्दः सिंहानामिव नर्दताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2046057, "chapter_id": 2023, "verse_number": "६-७२-१५", "content_sanskrit": "तत्राद्भुतमपश्यास संप्रहारं सुदारुणम्।\nयदकुर्वन्रणे शूराः सृञ्जयाः कुरुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2046058, "chapter_id": 2023, "verse_number": "६-७२-१६", "content_sanskrit": "नैव खं न दिशो राजन्न सूर्यं शत्रुतापन।\nविदिशो वापि पश्यामः शरैर्मुक्तैः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2046059, "chapter_id": 2023, "verse_number": "६-७२-१७", "content_sanskrit": "शक्तीनां विमलाग्राणां तोमराणां तथास्यताम् ।\nनिस्त्रिंशानां च पीतानां नीलोत्पलनिभाः प्रभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2046060, "chapter_id": 2023, "verse_number": "६-७२-१८", "content_sanskrit": "कवचानां विचित्राणां भूषणानां प्रभास्तथा ।\nखं दिशः प्रदिशश्चैव भासयामासुरोजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2046061, "chapter_id": 2023, "verse_number": "६-७२-१९", "content_sanskrit": "वपुर्भिश्च नरेन्द्राणां चन्द्रसूर्यसमप्रभैः ।\nविरराज तदा राजंस्तत्रतत्र रणाङ्गणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2046062, "chapter_id": 2023, "verse_number": "६-७२-२०", "content_sanskrit": "रथसङ्घा नरव्याघ्राः समायान्तश्च संयुगे।\nविरेजुः समरे राजन्ग्रहा इव नभस्तले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2046063, "chapter_id": 2023, "verse_number": "६-७२-२१", "content_sanskrit": "भीष्मस्तु रथिनां श्रेष्ठो भीमसेनं महाबलम् ।\nअवारयत संक्रुद्धः सर्वसैन्यस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2046064, "chapter_id": 2023, "verse_number": "६-७२-२२", "content_sanskrit": "ततो भीष्मविनिर्मुक्ता रुक्मपुङ्खाः शिलाशिताः।\nअभ्यङ्गन्तमरे भीमं तैलघौताः सुतेजनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2046065, "chapter_id": 2023, "verse_number": "६-७२-२३", "content_sanskrit": "तस्य शक्तिं महावेगं भीमसेनो महाबलः ।\nक्रुद्धाशीविषसंकाशं प्रेषयामास भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2046066, "chapter_id": 2023, "verse_number": "६-७२-२४", "content_sanskrit": "तामापतन्तीं सहसा रुक्मदण्डं दुरासदाम्।\nचिच्छेद समरे भीष्मः शरैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2046067, "chapter_id": 2023, "verse_number": "६-७२-२५", "content_sanskrit": "ततोऽपरेण भल्लेन पीतेन निशितेन च।\nकार्मुकं भीमसेनस्य द्विधा चिच्छेद भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2046068, "chapter_id": 2023, "verse_number": "६-७२-२६", "content_sanskrit": "अपास्य तु धनुश्छिन्नं भीमसेनो महाबलः ।\nशरैर्बहुभिरानर्च्छद्भीष्मं शान्तनवं युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2046069, "chapter_id": 2023, "verse_number": "६-७२-२७", "content_sanskrit": "सात्यकिस्तु ततस्तूर्णं भीष्ममासाद्य संयुगे ।\nआकर्णप्रहितैस्त्रीक्ष्णैर्निशितैस्तिग्मतेजनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2046070, "chapter_id": 2023, "verse_number": "६-७२-२८", "content_sanskrit": "शरैर्बहुभिरानर्च्छत्पितरं ते जनेश्वर ।\nततः संधाय वै तीक्ष्णं शरं परमदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2046071, "chapter_id": 2023, "verse_number": "६-७२-२९", "content_sanskrit": "वार्ष्णेयस्य रथाद्भीष्मः पातयामास सारथिम्।\nतस्याश्वाः प्रद्रुता राजन्निहते रथसारथौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2046072, "chapter_id": 2023, "verse_number": "६-७२-३०", "content_sanskrit": "तेन तेनैव धावन्ति मनोमारुतरंहसः।\nततः सर्वस्य सैन्यस्य निःस्वनस्तुमुलोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2046073, "chapter_id": 2023, "verse_number": "६-७२-३१", "content_sanskrit": "हाहाकारश्च संजज्ञे पाण्डवानां महात्मनाम् ।\nअभ्यद्रवत गृह्णीत हयान्यच्छत धावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2046074, "chapter_id": 2023, "verse_number": "६-७२-३२", "content_sanskrit": "इत्यासीत्तुमुलः शब्दो युयुधानरथं प्रति ।\nएतस्मिन्नेव काले तु भीष्मः शान्तनवस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2046075, "chapter_id": 2023, "verse_number": "६-७२-३३", "content_sanskrit": "न्यहनत्पाण्डवीं सेनामासुरीमिव वृत्राहा ।\nते वध्यमाना भीष्मेण पाञ्चालाः सोमकैः सह ।\nस्थिरां युद्धे मतिं कृत्वा भीष्ममेवाभिदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2046076, "chapter_id": 2023, "verse_number": "६-७२-३४", "content_sanskrit": "धृष्टद्युम्नमुखाश्चापि पार्थाः शान्तनवं रणे।\nअभ्यधावञ्जिगीषन्तस्तव पुत्रस्य वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2046077, "chapter_id": 2023, "verse_number": "६-७२-३५", "content_sanskrit": "तथैव कौरवा राजन्भीष्मद्रोणपुरोगमाः।\nअभ्यधावन्त वेगेन ततो युद्धमवर्तत ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2046078, "chapter_id": 2023, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि पञ्चमदिवसयुद्धे द्विसप्ततितमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-७२-१८ ओजसा स्वप्रभावेण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]