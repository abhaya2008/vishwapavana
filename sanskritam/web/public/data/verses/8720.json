[{"id": 900009041, "chapter_id": 8720, "verse_number": "10.1", "content_sanskrit": "यथा शक्तिः पदार्थान्तरमेवं तमो द्रव्यान्तरम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009042, "chapter_id": 8720, "verse_number": "10.2", "content_sanskrit": "न चासिद्धिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009043, "chapter_id": 8720, "verse_number": "10.3", "content_sanskrit": "किञ्चान्धकारो नालोकाभावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009044, "chapter_id": 8720, "verse_number": "10.4", "content_sanskrit": "तेजोऽभावबहुत्वादिनोत्कर्षादिधीश्चेत्सुखादावपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009045, "chapter_id": 8720, "verse_number": "10.5", "content_sanskrit": "ननु तमसो रूपित्वे आलोकनिरपेक्षचक्षुर्ग्राह्यत्वं न स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009046, "chapter_id": 8720, "verse_number": "10.6", "content_sanskrit": "ननु तत्राप्यालोकावयवग्रहे महत आलोकावयविनः तद्ग्रहे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009047, "chapter_id": 8720, "verse_number": "10.7", "content_sanskrit": "यत्तु वर्धमानोक्तं वस्तुतो रूपवतो विशेष्यस्य चाक्षुषत्वे आलोकापेक्षा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009048, "chapter_id": 8720, "verse_number": "10.8", "content_sanskrit": "किञ्च गृह्यमाणरूपस्य संसर्गारोपार्थमेव ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900009049, "chapter_id": 8720, "verse_number": "10.9", "content_sanskrit": "किञ्च रूपिणो घटादेरिव रूपिघटाद्यभावस्य ग्रहोऽपि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900009050, "chapter_id": 8720, "verse_number": "10.10", "content_sanskrit": "न च छायायां गतेः स्वाभाविकत्वे आवरकछत्रादिद्रव्यानु-विधानानुपपत्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900009051, "chapter_id": 8720, "verse_number": "10.11", "content_sanskrit": "न च स्पर्शसमानाधिकरणद्रव्यत्वसाक्षाद्व्याप्यजातेरुद्भूतस्पर्श..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900009052, "chapter_id": 8720, "verse_number": "10.12", "content_sanskrit": "यत्तु वर्धमानादिभिरुक्तं प्रौढालोकमध्ये सर्वतो..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900009053, "chapter_id": 8720, "verse_number": "10.13", "content_sanskrit": "मनस्तु नारम्भकं प्रयोजनाभावात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900009054, "chapter_id": 8720, "verse_number": "10.14", "content_sanskrit": "एतेनालोकज्ञानाभाव एव तमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]