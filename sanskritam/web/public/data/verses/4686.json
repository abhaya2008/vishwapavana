[{"id": 2173126, "chapter_id": 4686, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2173127, "chapter_id": 4686, "verse_number": "१", "content_sanskrit": "पीडिते धर्मराजे तु मद्रराजेन मारिष ।\nसात्यकिर्भीमसेनश्च माद्रीपुत्रौ च दुर्जयौ\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2173128, "chapter_id": 4686, "verse_number": "२", "content_sanskrit": "परिवार्य रथैः शल्यं पीडयामासुराहवे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2173129, "chapter_id": 4686, "verse_number": "३", "content_sanskrit": "तमेकं बहुभिर्दृष्ट्वा पीड्यमानं महारथैः ।\nसाधुवादो महान् जज्ञे सिद्धाश्चासन् प्रहर्षिताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2173130, "chapter_id": 4686, "verse_number": "४", "content_sanskrit": "आश्चर्यमित्यभाषन्त मुनयश्चापि सङ्गताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2173131, "chapter_id": 4686, "verse_number": "५", "content_sanskrit": "भीमसेनो रणे शल्यं शल्यभूतं पराक्रमे ।\nएकेन विद्ध्वा बाणेन पुनर्विव्याध सप्तभिः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2173132, "chapter_id": 4686, "verse_number": "६", "content_sanskrit": "सात्यकिश्च शतेनैनं धर्मराजपरीप्सया ।\nमद्रेश्वरमवाकीर्य सिंहनादमथानदत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2173133, "chapter_id": 4686, "verse_number": "७", "content_sanskrit": "नकुलः पञ्चभिश्चैव सहदेवश्च सप्तभिः ।\nविद्ध्वा तत्र ततस्तूर्णं पुनर्विव्याध सप्तभिः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2173134, "chapter_id": 4686, "verse_number": "८", "content_sanskrit": "स तु शूरो रणे यत्तः पीडितस्तैर्महारथैः ।\nविकृष्य कार्मुकं घोरं वेगघ्नं भारसाधनम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2173135, "chapter_id": 4686, "verse_number": "९", "content_sanskrit": "सात्यकिं पञ्चविंशत्या शल्यो विव्याध मारिष\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2173136, "chapter_id": 4686, "verse_number": "१०", "content_sanskrit": "भीमसेनं त्रिसप्तत्या नकुलं पञ्चभिस्तथा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2173137, "chapter_id": 4686, "verse_number": "११", "content_sanskrit": "सम्यक् सविशिखं चापं सहदेवस्य धन्विनः ।\nछित्त्वा भल्लेन समरे विव्याधैनं त्रिसप्तभिः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2173138, "chapter_id": 4686, "verse_number": "१२", "content_sanskrit": "सहदेवस्तु समरे मातुलं भूरिवर्चसम् ।\nसज्जमन्यद्धनुः कृत्वा पञ्चभिः समताडयत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2173139, "chapter_id": 4686, "verse_number": "१३", "content_sanskrit": "शरैराशीविषाकारैरर्कज्वलनसन्निभैः ।\nसारथिं चास्य समरे शरेणानतपर्वणा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2173140, "chapter_id": 4686, "verse_number": "१४", "content_sanskrit": "विव्याध भृशसङ्क्रुद्धस्तं च भूयस्त्रिभिः शरैः ।\nभीमसेनः त्रिसप्तत्या सात्यकिर्नवभिः शरैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2173141, "chapter_id": 4686, "verse_number": "१५", "content_sanskrit": "धर्मराजस्तथा षष्ट्या गात्रे शल्यं समर्पयत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2173142, "chapter_id": 4686, "verse_number": "१६", "content_sanskrit": "ततः शल्यो महाराज निर्विद्धस्तैर्महारथैः ।\nसुस्राव रुधिरं गात्रैर्गैरिकं पर्वतो यथा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2173143, "chapter_id": 4686, "verse_number": "१७", "content_sanskrit": "तांश्च सर्वान् महेष्वासान् पञ्चभिः पञ्चभिः शरैः ।\nविव्याध तरसा राजन् तदद्भुतमिवाभवत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2173144, "chapter_id": 4686, "verse_number": "१८", "content_sanskrit": "ततोऽपरेण भल्लेन धर्मपुत्रस्य मारिष ।\nधनुश्चिच्छेद समरे सज्यं स च महारथः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2173145, "chapter_id": 4686, "verse_number": "१९", "content_sanskrit": "अथान्यद् धनुरादाय धर्मपुत्रो महारथः ।\nसाश्वसूतध्वजरथं शल्यं प्राच्छादयच्छरैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2173146, "chapter_id": 4686, "verse_number": "२०", "content_sanskrit": "प्रच्छाद्यमानः समरे धर्मपुत्रस्य सायकैः ।\nयुधिष्ठिरमथाविध्यद् दशभिर्निशितैः शरैः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2173147, "chapter_id": 4686, "verse_number": "२१", "content_sanskrit": "सात्यकिस्तु ततः क्रुद्धो धर्मपुत्रे शरार्दिते ।\nमद्राणामधिपं शूरं शरैर्विव्याध पञ्चभिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2173148, "chapter_id": 4686, "verse_number": "२२", "content_sanskrit": "स सात्यकेश्च चिच्छेद क्षुरप्रेण महद्धनुः ।\nभीमसेनमुखांस्तांस्तान् त्रिभिस्त्रिभिरताडयत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2173149, "chapter_id": 4686, "verse_number": "२३", "content_sanskrit": "तस्य क्रुद्धो महाराज सात्यकिः सत्यविक्रमः ।\nतोमरं प्रेषयामास स्वर्णदण्डं महारणे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2173150, "chapter_id": 4686, "verse_number": "२४", "content_sanskrit": "भीमसेनः शरं घोरं कार्तस्वरविभूषितम् ।\nनकुलः समरे शक्तिं सहदेवो गदां शुभाम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2173151, "chapter_id": 4686, "verse_number": "२५", "content_sanskrit": "धर्मराजः शतघ्नीं तु जिघांसुः शल्यमाहवे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2173152, "chapter_id": 4686, "verse_number": "२६", "content_sanskrit": "तानापतत एवाशु पञ्चानां वै भुजच्युतान् ।\nसात्यकिप्रहितं शल्यो भल्लैश्चिच्छेद तोमरम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2173153, "chapter_id": 4686, "verse_number": "२७", "content_sanskrit": "वृकोदरेण प्रहितं शरं कनकभूषितम् ।\nद्विधा चिच्छेद समरे कृतहस्तः प्रतापवान्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2173154, "chapter_id": 4686, "verse_number": "२८", "content_sanskrit": "नकुलप्रेषितां शक्तिं हेमदण्डां भयावहाम् ।\nगदां च सहदेवेन शरौघैः समवारयत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2173155, "chapter_id": 4686, "verse_number": "२९", "content_sanskrit": "शराभ्यां च शतघ्नीं तां राज्ञश्चिच्छेद भारत ।\nपश्यतां पाण्डुपुत्राणां सिंहनादमनादयत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2173156, "chapter_id": 4686, "verse_number": "३०", "content_sanskrit": "नामृष्यत् तत्तु शैनेयः शत्रोर्विजयमाहवे\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2173157, "chapter_id": 4686, "verse_number": "३१", "content_sanskrit": "अथान्यद् धनुरादाय सात्यकिः क्रोधमूर्च्छितः ।\nद्वाभ्यां मद्रेश्वरं विद्ध्वा सारथिं च त्रिभिः शरैः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2173158, "chapter_id": 4686, "verse_number": "३२", "content_sanskrit": "ततः शल्यो रणे राजन् सर्वांस्तान् दशभिः शरैः ।\nविव्याध सुभृशं क्रुद्धः तोत्रैरिव महाद्विपान्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2173159, "chapter_id": 4686, "verse_number": "३३", "content_sanskrit": "ते वार्यमाणाः समरे मद्रराजेन धीमता ।\nन शेकुः प्रमुखे स्थातुं तस्य शत्रुनिषूदन\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2173160, "chapter_id": 4686, "verse_number": "३४", "content_sanskrit": "ततो दुर्योधनो राजा दृष्ट्वा शल्यस्य विक्रमम् ।\nनिहतान् पाण्डवान् मेने पाञ्चालांश्च ससृञ्जयान्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2173161, "chapter_id": 4686, "verse_number": "३५", "content_sanskrit": "तथाविधं महाराज मद्रराजस्य विक्रमम् ।\nअसह्यं मानवैर्युद्धे तद् बभूव नरर्षभ\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2173162, "chapter_id": 4686, "verse_number": "३६", "content_sanskrit": "ततो राजन् महाबाहुः भीमसेनः प्रतापवान् ।\nसन्त्यज्य मनसा प्राणान् मद्रराजमयोधयत्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2173163, "chapter_id": 4686, "verse_number": "३७", "content_sanskrit": "नकुलः सहदेवश्च सात्यकिश्च महारथः ।\nपरिवार्य तदा शल्यं समन्ताद् व्यकिरच्छरैः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2173164, "chapter_id": 4686, "verse_number": "३८", "content_sanskrit": "स चतुर्भिर्महेष्वासैः पाण्डवानां महारथैः ।\nवृतस्तान् योधयामास मद्रराजः प्रतापवान्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2173165, "chapter_id": 4686, "verse_number": "३९", "content_sanskrit": "तस्य धर्मसुतो राजन् क्षुरप्रेण महाहवे ।\nचक्ररक्षं जघानाशु मद्रराजस्य पश्यतः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2173166, "chapter_id": 4686, "verse_number": "४०", "content_sanskrit": "तस्मिंस्तु निहते शूरे चक्ररक्षे महाबले ।\nमद्रराजोऽतिबलवान् सैनिकानावृणोच्छरैः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2173167, "chapter_id": 4686, "verse_number": "४१", "content_sanskrit": "समाच्छन्नांस्ततस्तांस्तु राजन् वीक्ष्य स्वसैनिकान् ।\nचिन्तयामास समरे धर्मपुत्रो युधिष्ठिरः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2173168, "chapter_id": 4686, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2173169, "chapter_id": 4686, "verse_number": "४२", "content_sanskrit": "कथं नु न भवेत् सत्यं माधवस्य वचो महत् ।\nअभिक्रुद्धो महाराज क्षपयेत बलं मम\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2173170, "chapter_id": 4686, "verse_number": "४३", "content_sanskrit": "अहं मद्भ्रातरश्चैव सात्यकिश्च महारथः ।\nपाञ्चालाः सृञ्जयाश्चैव न शक्ताः स्म हि मद्रपम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2173171, "chapter_id": 4686, "verse_number": "४४", "content_sanskrit": "निहनिष्यति चैवाद्य मातुलोऽस्मान् महाबलः ।\nगोविन्दवचनं सत्यं कथं भवति किन्त्विदम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2173172, "chapter_id": 4686, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2173173, "chapter_id": 4686, "verse_number": "४५", "content_sanskrit": "ततः सरथनागाश्वाः पाण्डवाः पाण्डुपूर्वज ।\nमद्रेश्वरं समासेदुः पीडयन्तः समन्ततः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2173174, "chapter_id": 4686, "verse_number": "४६", "content_sanskrit": "नानाशस्त्रौघबहुलां शस्त्रवृष्टिं समुत्थिताम् ।\nव्यधमत् समरे राजन् महाभ्राणीव मारुतः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2173175, "chapter_id": 4686, "verse_number": "४७", "content_sanskrit": "ततः कनकपुङ्खान्तां शल्यक्षिप्तां वियद्गताम् ।\nशरवृष्टिमपश्याम शलभानामिवायतिम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2173176, "chapter_id": 4686, "verse_number": "४८", "content_sanskrit": "ते शरा मद्रराजेन प्रेषिता रणमूर्धनि ।\nसम्पतन्तः स्म दृश्यन्ते शलभानां व्रजा इव\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2173177, "chapter_id": 4686, "verse_number": "४९", "content_sanskrit": "मद्रराजधनुर्मुक्तैः शरैः कनकभूषणैः ।\nनिरन्तरमिवाकाशं सम्बभूव जनाधिप\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2173178, "chapter_id": 4686, "verse_number": "५०", "content_sanskrit": "न पाण्डवानां नास्माकं तत्र कश्चिद् व्यदृश्यत ।\nबाणान्धकारे महति कृते तत्र महाहवे\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2173179, "chapter_id": 4686, "verse_number": "५१", "content_sanskrit": "मद्रराजेन बलिना लाघवाच्छरवृष्टिभिः ।\nलोड्यमानं तदा दृष्ट्वा पाण्डवानां बलार्णवम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2173180, "chapter_id": 4686, "verse_number": "५२", "content_sanskrit": "विस्मयं परमं जग्मुः देवगन्धर्वदानवाः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2173181, "chapter_id": 4686, "verse_number": "५३", "content_sanskrit": "स तु तान् सर्वतो यत्नात् शरैः सम्पीड्य मारिष ।\nधर्मराजमवच्छाद्य सिंहवद् व्यनदन् मुहुः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2173182, "chapter_id": 4686, "verse_number": "५४", "content_sanskrit": "ते च्छन्नाः समरे तेन पाण्डवानां महारथाः ।\nन शेकुस्ते तदा युद्धे प्रत्युद्यातुं महारथाः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2173183, "chapter_id": 4686, "verse_number": "५५", "content_sanskrit": "धर्मराजपुरोगास्तु भीमसेनमुखा रथाः ।\nनिजघ्नुः समरे शूरं शल्यमाहवशोभिनम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2173184, "chapter_id": 4686, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि त्रयोदशोऽध्यायः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2173185, "chapter_id": 4686, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि त्रयोदशोऽध्यायः ॥१३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]