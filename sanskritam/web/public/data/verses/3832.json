[{"id": 2131226, "chapter_id": 3832, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131227, "chapter_id": 3832, "verse_number": "१", "content_sanskrit": "ततस्तामवसं प्रीतो रजनीं तत्र भारत ।\nप्रसादाद् देवदेवस्य त्र्यम्बकस्य महात्मनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131228, "chapter_id": 3832, "verse_number": "२", "content_sanskrit": "व्युषितो रजनीं चाहं कृत्वा पौर्वाह्णिकीः क्रियाः ।\nअपश्यं तं द्विजश्रेष्ठं दृष्टवानस्मि यं पुरा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131229, "chapter_id": 3832, "verse_number": "३", "content_sanskrit": "तस्मै चाहं यथावृत्तं सर्वमेव न्यवेदयम् ।\nभगवन्तं महादेवं समेतोऽस्मीति भारत \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131230, "chapter_id": 3832, "verse_number": "४", "content_sanskrit": "स मामुवाच राजेन्द्र प्रीयमाणो द्विजोत्तमः ।\nदृष्टस्त्वया महादेवो यथा नान्येन केनचित्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2131231, "chapter_id": 3832, "verse_number": "५", "content_sanskrit": "समेत्य लोकपालैस्तु सर्वैर्वैवस्वतादिभिः ।\nद्रष्टास्यनघ देवेन्द्रं स च तेऽस्त्राणि दास्यति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2131232, "chapter_id": 3832, "verse_number": "६", "content_sanskrit": "एवमुक्त्वा स मां राजन्नाश्लिष्य च पुनः पुनः ।\nअगच्छत् स यथाकामं ब्राह्मणः सूर्यसन्निभः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2131233, "chapter_id": 3832, "verse_number": "७", "content_sanskrit": "अथापराह्णे तस्याह्नः प्रावात् पुण्यः समीरणः ।\nपुनर्नवमिमं लोकं कुर्वन्निव सपत्नहन्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2131234, "chapter_id": 3832, "verse_number": "८", "content_sanskrit": "दिव्यानि चैव माल्यानि सुगन्धीनि नवानि च ।\nशैशिरस्य गिरेः पादे प्रादुरासन् समीपतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2131235, "chapter_id": 3832, "verse_number": "९", "content_sanskrit": "वादित्राणि च दिव्यानि सुघोराणि समन्ततः ।\nस्तुतयश्चेन्द्रसंयुक्ता अश्रूयन्त मनोहराः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2131236, "chapter_id": 3832, "verse_number": "१०", "content_sanskrit": "गणाश्चाप्सरसां तत्र गन्धर्वाणां तथैव च ।\nपुरस्ताद् देवदेवस्य जगुर्गीतानि सर्वशः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2131237, "chapter_id": 3832, "verse_number": "११", "content_sanskrit": "मरुतां च गणास्तत्र देवयानैरुपागमन् ।\nमहेन्द्रानुचरा ये च ये च सद्मनिवासिनः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2131238, "chapter_id": 3832, "verse_number": "१२", "content_sanskrit": "ततो मरुत्वान् हरिभिर्युक्तैर्वाहैः स्वलङ्कृतैः ।\nशचीसहायस्तत्रायात् सह सर्वैस्तदामरैः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2131239, "chapter_id": 3832, "verse_number": "१३", "content_sanskrit": "एतस्मिन्नेव काले तु कुबेरो नरवाहनः ।\nदर्शयामास मां राजँल्लक्ष्म्या परमया युतः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2131240, "chapter_id": 3832, "verse_number": "१४", "content_sanskrit": "दक्षिणस्यां दिशि यमं प्रत्यपश्यं व्यवस्थितम् ।\nवरुणं देवराजं च यथास्थानमवस्थितम् ।\nते मामूचुर्महाराज सान्त्वयित्वा नरर्षभ \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2131241, "chapter_id": 3832, "verse_number": "१५", "content_sanskrit": "सव्यसाचिन् निरीक्षास्माँल्लोकपालानवस्थितान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2131242, "chapter_id": 3832, "verse_number": "१६", "content_sanskrit": "सुरकार्यार्थसिद्ध्यर्थं दृष्टवानसि शङ्करम् ।\nअस्मत्तोऽपि गृहाण त्वमस्त्राणीति समन्ततः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2131243, "chapter_id": 3832, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2131244, "chapter_id": 3832, "verse_number": "१७", "content_sanskrit": "ततोऽहं प्रयतो भूत्वा प्रणिपत्य सुरर्षभान् ।\nप्रत्यगृह्णं तदाऽस्त्राणि महान्ति विधिवद् विभो॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2131245, "chapter_id": 3832, "verse_number": "१८", "content_sanskrit": "गृहीतास्त्रस्ततो देवैरनुज्ञातोऽस्मि भारत ।\nअथ देवा ययुः सर्वे यथागतमरिन्दम\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2131246, "chapter_id": 3832, "verse_number": "१९", "content_sanskrit": "मघवानपि देवेशो रथमारुह्य सुप्रभम् ।\nउवाच भगवान् स्वर्गं गन्तव्यं फल्गुन त्वया\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2131247, "chapter_id": 3832, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2131248, "chapter_id": 3832, "verse_number": "२०", "content_sanskrit": "पुरैवागमनादस्माद् वेदाहं त्वां धनञ्जय ।\nअतः परं त्वहं वै त्वां दर्शये भरतर्षभ\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2131249, "chapter_id": 3832, "verse_number": "२१", "content_sanskrit": "त्वया हि तीर्थेषु पुरा समाप्लावः कृतोऽसकृत् ।\nतपश्चेदं महत्तप्तं स्वर्गं गन्तासि पाण्डव \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2131250, "chapter_id": 3832, "verse_number": "२२", "content_sanskrit": "भूयश्चैव च तप्तव्यं तपश्चरणमुत्तमम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2131251, "chapter_id": 3832, "verse_number": "२३", "content_sanskrit": "स्वर्गं त्ववश्यं गन्तव्यं त्वया शत्रुनिषूदन ।\nमातलिर्मन्नियोगात् त्वां त्रिदिवं प्रापयिष्यति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2131252, "chapter_id": 3832, "verse_number": "२४", "content_sanskrit": "विदितस्त्वं हि देवानां मुनीनां च महात्मनाम् ।\nइहस्थः पाण्डवश्रेष्ठ तपः कुर्वन् सुदुष्करम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2131253, "chapter_id": 3832, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2131254, "chapter_id": 3832, "verse_number": "२५", "content_sanskrit": "ततोऽहमब्रुवं शक्रं प्रसीद भगवन् मम ।\nआचार्यं वरयेयं त्वामस्त्रार्थं त्रिदशेश्वर \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2131255, "chapter_id": 3832, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2131256, "chapter_id": 3832, "verse_number": "२६", "content_sanskrit": "क्रूरकर्मास्त्रवित्तात भविष्यसि परन्तप ।\nयदर्थमस्त्राणीप्सुस्त्वं तं कामं पाण्डवाप्नुहि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2131257, "chapter_id": 3832, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2131258, "chapter_id": 3832, "verse_number": "२७", "content_sanskrit": "ततोऽहमब्रुवं नाहं दिव्यान्यस्त्राणि शत्रुहन् ।\nमानुषेषु प्रयोक्ष्यामि विनाऽस्त्रप्रतिघातनात्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2131259, "chapter_id": 3832, "verse_number": "२८", "content_sanskrit": "तानि दिव्यानि मेऽस्त्राणि प्रयच्छ विबुधाधिप ।\nलोकांश्चास्त्रजितान् पश्चाल्लभेयं सुरपुङ्गव \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2131260, "chapter_id": 3832, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2131261, "chapter_id": 3832, "verse_number": "२९", "content_sanskrit": "परीक्षार्थं मयैतत् ते वाक्यमुक्तं धनञ्जय ।\nममात्मजस्य वचनं सूपपन्नमिदं तव \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2131262, "chapter_id": 3832, "verse_number": "३०", "content_sanskrit": "शिक्षामि भवनं गत्वा सर्वाण्यस्त्राणि भारत ।\nवायोरग्नेर्वसुभ्योऽपि वरुणात्समरुद्गणात्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2131263, "chapter_id": 3832, "verse_number": "३१", "content_sanskrit": "साध्यं पैतामहं चैव गन्धर्वोरगरक्षसाम् ।\nवैष्णवानि च सर्वाणि नैर्ऋतानि तथैव च ।\nमद्गतानि च जानीहि सर्वास्त्राणि कुरूद्वह \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2131264, "chapter_id": 3832, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2131265, "chapter_id": 3832, "verse_number": "३२", "content_sanskrit": "एवमुक्त्वा तु मां शक्रस्तत्रैवान्तरधीयत \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2131266, "chapter_id": 3832, "verse_number": "३३", "content_sanskrit": "अथापश्यं हरियुजं(तं) रथमैन्द्रमुपस्थितम् ।\nदिव्यं मायामयं पुण्यं यत्तं मातलिना नृप ।\nलोकपालेषु यातेषु मामुवाचाथ मातलिः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2131267, "chapter_id": 3832, "verse_number": "३४", "content_sanskrit": "द्रष्टुमिच्छति शक्रस्त्वां देवराजो महाद्युते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2131268, "chapter_id": 3832, "verse_number": "३५", "content_sanskrit": "संसिद्ध्यस्व महाबाहो कुरु कार्यमनन्तरम् ।\nपश्य पुण्यकृताँल्लोकान् सशरीरो दिवं व्रज \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2131269, "chapter_id": 3832, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2131270, "chapter_id": 3832, "verse_number": "३६", "content_sanskrit": "इत्युक्तोऽहं मातलिना गिरिमामन्त्र्य शैशिरम् ।\nप्रदक्षिणमुपावृत्य समारोहं रथोत्तमम् ।\nचोदयामास स हयान्मनोमारुतरंहसः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2131271, "chapter_id": 3832, "verse_number": "३७", "content_sanskrit": "मातलिर्हयतत्त्वज्ञो सर्वशास्त्रविशारदः ।\nअवैक्षत च मे वक्त्रं स्थितस्याथ स सारथिः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2131272, "chapter_id": 3832, "verse_number": "३८", "content_sanskrit": "तथा भ्रान्ते रथे राजन् विस्मितश्चेदमब्रवीत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2131273, "chapter_id": 3832, "verse_number": "३९", "content_sanskrit": "अत्यद्भुतमिदं त्वद्य विचित्रं प्रतिभाति मे ।\nयदास्थितो रथं दिव्यं पदान्न चलितः पदम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2131274, "chapter_id": 3832, "verse_number": "४०", "content_sanskrit": "देवराजोऽपि हि मया नित्यमत्रोपलक्षितः ।\nविचलन् प्रथमोत्पाते हयानां भरतर्षभ\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2131275, "chapter_id": 3832, "verse_number": "४१", "content_sanskrit": "त्वं पुनः स्थित एवात्र रथे भ्रान्ते कुरूद्वह ।\nअतिशक्रमिदं सर्वं तवेति प्रतिभाति मे\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2131276, "chapter_id": 3832, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2131277, "chapter_id": 3832, "verse_number": "४२", "content_sanskrit": "इत्युक्त्वाऽऽकाशमाविश्य मातलिर्विबुधालयान् ।\nदर्शयामास मे राजन् विमानानि च भारत\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2131278, "chapter_id": 3832, "verse_number": "४३", "content_sanskrit": "नन्दनादीनि देवानां वनान्युपवनानि च ।\nदर्शयामास मे शीघ्रं मातलिः शक्रसारथिः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2131279, "chapter_id": 3832, "verse_number": "४४", "content_sanskrit": "ततः शक्रस्य भवनमपश्यममरावतीम् ।\nदिव्यैः कामफलैर्वृक्षै रत्नैश्च समलङ्कृताम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2131280, "chapter_id": 3832, "verse_number": "४५", "content_sanskrit": "न तत्र सूर्यस्तपति न शीतोष्णे न च क्लमः ।\nन बाधते तत्र रजस्तत्रास्ति न जरा नृप\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2131281, "chapter_id": 3832, "verse_number": "४६", "content_sanskrit": "न तत्र शोको दैन्यं वा दौर्बल्यं चोपलक्ष्यते ।\nदिवौकसां महाराज न ग्लानिररिमर्दन ।\nन क्रोधलोभौ तत्रास्तां सुरादीनां विशाम्पते\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2131282, "chapter_id": 3832, "verse_number": "४७", "content_sanskrit": "नित्यतुष्टाश्च ते राजन् प्राणिनः सुरवेश्मनि ।\nनित्यपुष्पफलास्तत्र पादपा हरितच्छदाः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2131283, "chapter_id": 3832, "verse_number": "४८", "content_sanskrit": "पुष्करिण्यश्च विविधाः पद्मसौगन्धिकायुताः ।\nशीतस्तत्र ववौ वायुः सुगन्धी जीवनः शुचिः \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2131284, "chapter_id": 3832, "verse_number": "४९", "content_sanskrit": "सर्वरत्नविचित्रा च भूमिः पुष्पविभूषिता ।\nमृगद्विजाश्च बहवो रुचिरा मधुरस्वराः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2131285, "chapter_id": 3832, "verse_number": "५०", "content_sanskrit": "विमानगामिनश्चात्र दृश्यन्ते बहवोऽम्बरे\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2131286, "chapter_id": 3832, "verse_number": "५१", "content_sanskrit": "ततोऽपश्यं वसून् रुद्रान् साध्यांश्च समरुद्गणान् ।\nआदित्यानश्विनौ चैव तान् सर्वान् प्रत्यपूजयम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2131287, "chapter_id": 3832, "verse_number": "५२", "content_sanskrit": "ते मां वीर्येण यशसा तेजसा च बलेन च ।\nअस्त्रैश्चाप्यन्वजानन्त सङ्ग्रामे विजयेन च \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2131288, "chapter_id": 3832, "verse_number": "५३", "content_sanskrit": "प्रविश्य तां पुरीं दिव्यां देवगन्धर्वपूजिताम् ।\nदेवराजं सहस्राक्षमुपातिष्ठं कृताञ्जलिः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2131289, "chapter_id": 3832, "verse_number": "५४", "content_sanskrit": "ददावर्धासनं प्रीतः शक्रो मे ददतां वरः ।\nबहुमानाच्च गात्राणि पस्पर्श मम वासवः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2131290, "chapter_id": 3832, "verse_number": "५५", "content_sanskrit": "तत्राहं देवगन्धर्वैः सहितो भूरिदक्षिणैः ।\nअस्त्रार्थमवसं स्वर्गे शिक्षाणोऽस्त्राणि भारत\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2131291, "chapter_id": 3832, "verse_number": "५६", "content_sanskrit": "विश्वावसोश्च वै पुत्रश्चित्रसेनोऽभवत् सखा ।\nस च गान्धर्वमखिलं ग्राहयामास मां नृप\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2131292, "chapter_id": 3832, "verse_number": "५७", "content_sanskrit": "तत्राहमवसं राजन् गृहीतास्त्रः सुपूजितः ।\nसुखं शक्रस्य भवने सर्वकामसमन्वितः \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2131293, "chapter_id": 3832, "verse_number": "५८", "content_sanskrit": "शृण्वन् वै गीतशब्दं च तूर्यशब्दं च पुष्कलम् ।\nपश्यंश्चाप्सरसः श्रेष्ठा नृत्यन्तीर्भरतर्षभ\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2131294, "chapter_id": 3832, "verse_number": "५९", "content_sanskrit": "तत्सर्वमनवज्ञाय तथ्यं विज्ञाय भारत ।\nअत्यर्थं प्रतिगृह्याहमस्त्रेष्वेव व्यवस्थितः \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2131295, "chapter_id": 3832, "verse_number": "६०", "content_sanskrit": "ततोऽतुष्यत् सहस्राक्षस्तेन कामेन मे विभुः ।\nएवं मे वसतो राजन्नेष कालोऽत्यगादिति\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2131296, "chapter_id": 3832, "verse_number": "६१", "content_sanskrit": "कृतास्त्रमतिविश्वस्तमथ मां हरिवाहनः ।\nसंस्पृश्य मूर्ध्नि पाणिभ्यामिदं वचनमब्रवीत्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2131297, "chapter_id": 3832, "verse_number": "६२", "content_sanskrit": "न त्वमद्य युधा जेतुं शक्यः सुरगणैरपि ।\nकिं पुनर्मानुषे लोके मानुषैरकृतात्मभिः \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2131298, "chapter_id": 3832, "verse_number": "६३", "content_sanskrit": "अप्रमेयोऽप्रधृष्यश्च युद्धेष्वप्रतिमस्तथा ।\nअजेयस्त्वं हि सङ्ग्रामे सर्वैरपि सुरासुरैः \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2131299, "chapter_id": 3832, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2131300, "chapter_id": 3832, "verse_number": "६४", "content_sanskrit": "अथाब्रवीत् पुनर्देवः सम्प्रहृष्टतनूरुहः ।\nअस्त्रयुद्धे समो वीर न ते कश्चिद् भविष्यति\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2131301, "chapter_id": 3832, "verse_number": "६५", "content_sanskrit": "अप्रमत्तः सदा दक्षः सत्यवादी जितेन्द्रियः ।\nब्रह्मण्यश्चास्त्रविच्चासि शूरश्चासि कुरूद्वह \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2131302, "chapter_id": 3832, "verse_number": "६६", "content_sanskrit": "अस्त्राणि समवाप्तानि त्वया दश च पञ्च च ।\nपञ्चभिर्विधिभिः पार्थ विद्यते न त्वया समः \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2131303, "chapter_id": 3832, "verse_number": "६७", "content_sanskrit": "प्रयोगमुपसंहारमावृत्तिं च धनञ्जय ।\nप्रायश्चित्तं च वेत्थ त्वं प्रतीघातं च सर्वशः \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2131304, "chapter_id": 3832, "verse_number": "६८", "content_sanskrit": "ततो गुर्वर्थकालोऽयं समुत्पन्नः परन्तप ।\nप्रतिजानीष्व तं कर्तुं ततो वेत्स्याम्यहं परम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2131305, "chapter_id": 3832, "verse_number": "६९", "content_sanskrit": "ततोऽहमब्रुवं राजन् देवराजमिदं वचः ।\nविषह्यं यन्मया कर्तुं कृतमेव निबोध तत्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2131306, "chapter_id": 3832, "verse_number": "७०", "content_sanskrit": "ततो मामब्रवीद् राजन् प्रहसन् बलवृत्रहा ।\nनाविषह्यं तवाद्यास्ति त्रिषु लोकेषु किञ्चन\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2131307, "chapter_id": 3832, "verse_number": "७१", "content_sanskrit": "निवातकवचा नाम दानवा मम शत्रवः ।\nसमुद्रकुक्षिमाश्रित्य दुर्गे प्रतिवसन्त्युत\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2131308, "chapter_id": 3832, "verse_number": "७२", "content_sanskrit": "तिस्रः कोट्यः समाख्यातास्तुल्यरूपबलप्रभाः ।\nतांस्तत्र जहि कौन्तेय गुर्वर्थस्ते भविष्यति\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2131309, "chapter_id": 3832, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2131310, "chapter_id": 3832, "verse_number": "७३", "content_sanskrit": "ततो मातलिसंयुक्तं मयूरसमरोमभिः ।\nहयैरुपेतं प्रादान्मे रथं दिव्यं महाप्रभम् \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2131311, "chapter_id": 3832, "verse_number": "७४", "content_sanskrit": "बबन्ध चैव मे मूर्ध्नि किरीटमिदमुत्तमम् ।\nस्वरूपसदृशं चैव प्रादादङ्गविभूषणम्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2131312, "chapter_id": 3832, "verse_number": "७५", "content_sanskrit": "अभेद्यं कवचं चेदं स्पर्शरूपवदुत्तमम् ।\nअजरां ज्यामिमां चापि गाण्डीवे समयोजयत्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2131313, "chapter_id": 3832, "verse_number": "७६", "content_sanskrit": "ततः प्रायामहं तेन स्यन्दनेन विराजता ।\nयेनाजयद् देवपतिर्बलिं वैरोचनिं पुरा\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2131314, "chapter_id": 3832, "verse_number": "७७", "content_sanskrit": "ततो देवाः सर्व एव तेन घोषेण बोधिताः\nमन्वाना देवराजं मां समाजग्मुर्विशाम्पते \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2131315, "chapter_id": 3832, "verse_number": "७८", "content_sanskrit": "दृष्ट्वा च मामपृच्छन्त किं करिष्यसि फल्गुन ।\nतानब्रुवं यथाभूतमिदं कर्तास्मि संयुगे \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2131316, "chapter_id": 3832, "verse_number": "७९", "content_sanskrit": "निवातकवचानां तु प्रस्थितं मां वधैषिणम् ।\nनिबोधत महाभागाः शिवं चाशास्त मेऽनघाः \t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2131317, "chapter_id": 3832, "verse_number": "८०", "content_sanskrit": "ततो वाग्भिः प्रशस्ताभिस्त्रिदशाः पृथिवीपते ।\nतुष्टुवुर्मां प्रसन्नास्ते यथा देवं पुरन्दरम् \t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2131318, "chapter_id": 3832, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2131319, "chapter_id": 3832, "verse_number": "८१", "content_sanskrit": "रथेनानेन मघवा जितवान् शम्बरं युधि ।\nनमुचिं बलवृत्रौ च प्रह्लादनरकावपि\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2131320, "chapter_id": 3832, "verse_number": "८२", "content_sanskrit": "बहूनि च सहस्राणि प्रयुतान्यर्बुदान्यपि ।\nरथेनानेन दैत्यानां जितवान् मघवा युधि\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2131321, "chapter_id": 3832, "verse_number": "८३", "content_sanskrit": "त्वमप्यनेन कौन्तेय निवातकवचान् रणे ।\nविजेता युधि विक्रम्य पुरेव मघवा वशी\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2131322, "chapter_id": 3832, "verse_number": "८४", "content_sanskrit": "अयं च शङ्खप्रवरो येन जेतासि दानवान् ।\nअनेन विजिता लोकाः शक्रेणापि महात्मना\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2131323, "chapter_id": 3832, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2131324, "chapter_id": 3832, "verse_number": "८५", "content_sanskrit": "प्रदीयमानं देवैस्तं देवदत्तं जलोद्भवम् ।\nप्रत्यगृह्णं जयायैनं स्तूयमानस्तदाऽमरैः \t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2131325, "chapter_id": 3832, "verse_number": "८६", "content_sanskrit": "स शङ्खी कवची बाणी प्रगृहीतशरासनः ।\nदानवालयमत्युग्रं प्रयातोऽस्मि युयुत्सया\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2131326, "chapter_id": 3832, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि निवातकवच-\nयुद्धपर्वण्यर्जुनवाक्ये त्रिषष्ट्यधिकशततमोऽध्यायः ॥१६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2131327, "chapter_id": 3832, "verse_number": "१०", "content_sanskrit": "यक्षयुद्धपर्वणि दशमोऽध्यायः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}]