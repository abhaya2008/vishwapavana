[{"id": 2108203, "chapter_id": 3340, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108204, "chapter_id": 3340, "verse_number": "१", "content_sanskrit": "ततो रात्र्यां व्यतीतायां प्रभातेऽभ्युदिते रवौ ।\nकद्रूश्च विनता चैव भगिन्यौ ते तपोधन \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108205, "chapter_id": 3340, "verse_number": "२", "content_sanskrit": "अमर्षिते सुसंरब्धे दास्ये कृतपणे तदा ।\nजग्मतुस्तुरगं द्रष्टुमुच्चैःश्रवसमन्तिकात्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108206, "chapter_id": 3340, "verse_number": "३", "content_sanskrit": "ददृशाते उभे तत्र समुद्रं निधिमम्भसाम् ।\nमहान्तमुदकागाधं क्षोभ्यमाणं महास्वनम्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108207, "chapter_id": 3340, "verse_number": "५", "content_sanskrit": "तिमिङ्गिलझषाकीर्णं मकरैरावृतं तथा ।\nसत्त्वैश्च बहुसाहस्रैर्नानारूपैः समावृतम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108208, "chapter_id": 3340, "verse_number": "६", "content_sanskrit": "उग्रैर्नित्यमनाधृष्यं कूर्मग्राहसमाकुलम् ।\nआकरं सर्वरत्नानामालयं वरुणस्य च \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108209, "chapter_id": 3340, "verse_number": "७", "content_sanskrit": "नागानामाश्रयं रम्यमुत्तमं सरितां पतिम् ।\nपाताळज्वलनावासमसुराणां च बन्धनम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108210, "chapter_id": 3340, "verse_number": "८", "content_sanskrit": "भयङ्करं च सत्त्वानां पयसां निधिमद्भुतम् ।\nशुभ्रं दिव्यममर्त्यानाममृतस्याकरं परम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108211, "chapter_id": 3340, "verse_number": "९", "content_sanskrit": "अप्रमेयमचिन्त्यं च सुपुण्यजलमद्भुतम् ।\nघोरं जलचराकीर्णं रौद्रं भैरवनिस्वनम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108212, "chapter_id": 3340, "verse_number": "१०", "content_sanskrit": "गम्भीरावर्तसलिलं सर्वभूतभयङ्करम् ।\nवेलाडोलानिलबलक्षोभवेगसमुत्थितैः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108213, "chapter_id": 3340, "verse_number": "११", "content_sanskrit": "वीचीहस्तैः प्रचलितैर्नृत्यन्तमिव सर्वतः ।\nचन्द्रवृद्धिक्षयवशादुद्धृतोर्मिं दुरासदम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108214, "chapter_id": 3340, "verse_number": "१२", "content_sanskrit": "पाञ्चजन्यस्य जननं रत्नाकरमनुत्तमम् ।\nगां विन्दता भगवता गोविन्देनामितौजसा \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108215, "chapter_id": 3340, "verse_number": "१३", "content_sanskrit": "वराहरूपिणा चान्तर्विलोळितजलाविलम् ।\nब्रह्मर्षिणा च तपता वर्षाणां शतमत्रिणा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108216, "chapter_id": 3340, "verse_number": "१४", "content_sanskrit": "अनासादितपर्यन्तं पाताळतळमव्ययम् ।\nअध्यात्मयोगनिद्रां च पद्मनाभस्य सेवतः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108217, "chapter_id": 3340, "verse_number": "१५", "content_sanskrit": "युगान्तकालशयनं विष्णोरमिततेजसः ।\nवडवामुखदीप्ताग्नेस्तोयहव्यप्रदं शुभम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108218, "chapter_id": 3340, "verse_number": "१६", "content_sanskrit": "अगाधपारविस्तीर्णमप्रमेयं सरित्पतिम् ।\nमहानदीभिर्बह्वीभिः स्पर्धयेव सहस्रशः ।\nअभिसार्यमाणमनिशं तत्र तत्र समन्ततः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108219, "chapter_id": 3340, "verse_number": "१७", "content_sanskrit": "इत्येवं झषमकरोर्मिसङ्कुलं तं\nगम्भीरं विलसितमम्बरप्रकाशम् ।\nपातालज्वलनशिखाविदीपितान्तं\nपश्यन्त्यौ द्रुतमभिपेततुस्तदाब्धिम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108220, "chapter_id": 3340, "verse_number": "१९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि एकोनविंशोऽध्यायः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108221, "chapter_id": 3340, "verse_number": "", "content_sanskrit": "॥ आस्तीकपर्वणि सप्तमोऽध्यायः ॥७॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]