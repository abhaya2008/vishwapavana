[{"id": 2011226, "chapter_id": 1228, "verse_number": "१-२२९-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011227, "chapter_id": 1228, "verse_number": "१-२२९-१", "content_sanskrit": "शणु मे विस्तरेणेममितिहासं पुरातनम्।\nभ्रातृभिः सहितः पार्थ यथा वृत्तं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011228, "chapter_id": 1228, "verse_number": "१-२२९-२", "content_sanskrit": "महासुरस्यान्ववाये हिरण्यकशिपोः पुरा।\nनिकुम्भो नाम दैत्येन्द्रस्तेजस्वी बलवानभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011229, "chapter_id": 1228, "verse_number": "१-२२९-३", "content_sanskrit": "तस्य पुत्रौ महावीर्यौ जातौ भीमपराक्रमौ।\nसुन्दोपसुन्दौ दैत्येन्द्रौ दारुणौ क्रूरमानसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011230, "chapter_id": 1228, "verse_number": "१-२२९-४", "content_sanskrit": "तावेकनिश्चयौ दैत्यावेककार्यार्थसंमतौ।\nनिरन्तरमवर्तेतां समदुःखसुखावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011231, "chapter_id": 1228, "verse_number": "१-२२९-५", "content_sanskrit": "विनाऽन्योन्यं न भुञ्जाते विनाऽन्योन्यं न जल्पतः।\nअन्योन्यस्य प्रियकरावन्योन्यस्य प्रियंवदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011232, "chapter_id": 1228, "verse_number": "१-२२९-६", "content_sanskrit": "एकशीलसमाचारौ द्विधैवैकोऽभवत्कृतः।\nतौ विवृद्धौ महावीर्यौ कार्येष्वप्येकनिश्चयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011233, "chapter_id": 1228, "verse_number": "१-२२९-७", "content_sanskrit": "त्रैलोक्यविजयार्थाय समाधायैकनिश्चयम्।\nदीक्षां कृत्वा गतौ विन्ध्यं तावुग्रं तेपतुस्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011234, "chapter_id": 1228, "verse_number": "१-२२९-८", "content_sanskrit": "तौ तु दीर्घेण कालेन तपोयुक्तौ बभूवतुः।\nक्षुत्पिपासापरिश्रान्तौ जटावल्कलधारिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011235, "chapter_id": 1228, "verse_number": "१-२२९-९", "content_sanskrit": "मलोपचितसर्वाङ्गौ वायुभक्षौ बभूवतुः।\nआत्ममांसानि जुह्वान्तौ पादाङ्गुष्ठाग्रधिष्ठितौ।\nऊर्ध्वबाहू चानिमिषौ दीर्घकालं धृतव्रतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011236, "chapter_id": 1228, "verse_number": "१-२२९-१०", "content_sanskrit": "तयोस्तपःप्रभावेण दीर्घकालं प्रतापितः।\nधूमं प्रमुमुचे विन्ध्यस्तद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011237, "chapter_id": 1228, "verse_number": "१-२२९-११", "content_sanskrit": "ततो देवा भयं जग्मुरुग्रं दृष्ट्वा तयोस्तपः।\nतपोविघातार्थमथो देवा विघ्नानि चक्रिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011238, "chapter_id": 1228, "verse_number": "१-२२९-१२", "content_sanskrit": "रत्नैः प्रलोभयामासुः स्त्रीभिश्चोभौ पुनःपुनः।\nन च तौ चक्रतुर्भङ्गं व्रतस्य सुमहाव्रतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011239, "chapter_id": 1228, "verse_number": "१-२२९-१३", "content_sanskrit": "अथ मायां पुनर्देवास्तयोश्चक्रुर्महात्मनोः।\nभगिन्यो मातरो भार्यास्तयोश्चात्मजनस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011240, "chapter_id": 1228, "verse_number": "१-२२९-१४", "content_sanskrit": "प्रपात्यमाना विस्रस्ताः शूलहस्तेन रक्षसा।\nभ्रष्टाभरणकेशान्ता भ्रष्टाभरणवाससः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011241, "chapter_id": 1228, "verse_number": "१-२२९-१५", "content_sanskrit": "अभिभाष्य ततः सर्वास्तौ त्राहीति विचुक्रुशुः।\nन च तौ चक्रतुर्भङ्गं व्रतस्य सुमहाव्रतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011242, "chapter_id": 1228, "verse_number": "१-२२९-१६", "content_sanskrit": "यदा क्षोभं नोपयाति नार्तिमन्यतरस्तयोः।\nततः स्त्रियस्ता भूतं च सर्वमन्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011243, "chapter_id": 1228, "verse_number": "१-२२९-१७", "content_sanskrit": "ततः पितामहः साक्षादभिगम्य महासुरौ।\nवरेण च्छ्दयामास क्वलोकहितः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011244, "chapter_id": 1228, "verse_number": "१-२२९-१८", "content_sanskrit": "ततः सुन्दोपसुन्दौ तौ भ्रातरौ दृढविक्रमौ।\nदृष्ट्वा पितामहं देवं तस्थतुः प्राञ्जली तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011245, "chapter_id": 1228, "verse_number": "१-२२९-१९", "content_sanskrit": "ऊचतुश्च प्रभुं देवं ततस्तौ सहितौ तदा।\nआवयोस्तपसाऽनेन यदि प्रीतः पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011246, "chapter_id": 1228, "verse_number": "१-२२९-२०", "content_sanskrit": "मायाविदावस्त्रविदौ बलिनौ कामरूपिणौ।\nउभावप्यमरौ स्यावः प्रसन्नो यदि नौ प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011247, "chapter_id": 1228, "verse_number": "१-२२९-२१x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011248, "chapter_id": 1228, "verse_number": "१-२२९-२१", "content_sanskrit": "ऋतेऽमरत्वं युवयोः सर्वमुक्तं भविष्यति।\nअन्यद्वृणीतं मृत्योश्च विधानममरैः सम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011249, "chapter_id": 1228, "verse_number": "१-२२९-२२", "content_sanskrit": "प्रभविष्याव इति यन्महदभ्युद्यतं तपः।\nयुवयोर्हेतुनानेन नामरत्वं विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011250, "chapter_id": 1228, "verse_number": "१-२२९-२३", "content_sanskrit": "त्रैलोक्यविजयार्थाय भवद्भ्यामास्थितं तपः।\nहेतुनाऽनेन दैत्येन्द्रौ न वां कामं करोम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011251, "chapter_id": 1228, "verse_number": "१-२२९-२४", "content_sanskrit": "सुन्दोपसुन्दावूचतुः।\nत्रिषु लोकेषु यद्भूतं किंचित्स्थावरजङ्गमम्।\nसर्वस्मान्नौ भयं न स्यादृतेऽन्योन्यं पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011252, "chapter_id": 1228, "verse_number": "१-२२९-२५x", "content_sanskrit": "पितामह उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011253, "chapter_id": 1228, "verse_number": "१-२२९-२५", "content_sanskrit": "यत्प्रार्थितं यथोक्तं च काममेतद्ददानि वाम्।\nमृत्योर्विधानमेतच्च यथावद्वा भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011254, "chapter_id": 1228, "verse_number": "१-२२९-२६x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011255, "chapter_id": 1228, "verse_number": "१-२२९-२६", "content_sanskrit": "ततः पितामहो दत्त्वा वरमेतत्तदा तयोः।\nनिवर्त्य तपसस्तौ च ब्रह्मलोकं जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011256, "chapter_id": 1228, "verse_number": "१-२२९-२७", "content_sanskrit": "लब्ध्वा वराणि दैत्येन्द्रावथ तौ भ्रातरावुभौ।\nअवध्यौ सर्वलोकस्य स्वमेव भवनं गतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011257, "chapter_id": 1228, "verse_number": "१-२२९-२८", "content_sanskrit": "तौ तु लब्धवरौ दृष्ट्वा कृतकामौ मनस्विनौ।\nसर्वः सुहृञ्जनस्ताभ्यां प्रहर्षमुपजग्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011258, "chapter_id": 1228, "verse_number": "१-२२९-२९", "content_sanskrit": "ततस्तौ तु जटा भित्त्वा मौलिनौ संबभूवतुः।\nमहार्हाभरणोपेतौ विरजोम्बरधारिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2011259, "chapter_id": 1228, "verse_number": "१-२२९-३०", "content_sanskrit": "अकालकौमुदीं चैव चक्रतुः सार्वकालिकीम्।\nनित्यः प्रमुदितः सर्वस्तयोश्चैव सुहृञ्जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2011260, "chapter_id": 1228, "verse_number": "१-२२९-३१", "content_sanskrit": "भक्ष्यतां भुज्यतां नित्यं दीयतां रम्यतामिति।\nगीयेतां पीयतां चेति शभ्दश्चासीद्गृहे गृहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2011261, "chapter_id": 1228, "verse_number": "१-२२९-३२", "content_sanskrit": "तत्रतत्र महानादैरुत्कृष्टतलनादितैः।\nहृष्टं प्रमुदितं सर्वं दैत्यानामभवत्पुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2011262, "chapter_id": 1228, "verse_number": "१-२२९-३३", "content_sanskrit": "तैस्तैर्विहारैर्बहुभिर्दैत्यानां कामरूपिणाम्।\nसमाः संक्रीडतां तेषामहरेकमिवाभवत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2011263, "chapter_id": 1228, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि विदुरागमनराज्यलाभपर्वणि एकोनत्रिंशदधिकद्विशततमोऽध्यायः॥ २२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]