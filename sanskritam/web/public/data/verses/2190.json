[{"id": 2054204, "chapter_id": 2190, "verse_number": "७-११७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2054205, "chapter_id": 2190, "verse_number": "७-११७-१", "content_sanskrit": "काल्यमानेषु सैन्येषु शैनेयेन ततस्ततः।\nभारद्वाजः शरव्रातैर्मर्मभिद्भिरवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2054206, "chapter_id": 2190, "verse_number": "७-११७-२", "content_sanskrit": "स सम्प्रहारस्तुमुलो द्रोणसात्वतयोरभूत्।\nपश्यतां सर्वसैन्यानां बलिवासवयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2054207, "chapter_id": 2190, "verse_number": "७-११७-३", "content_sanskrit": "ततो द्रोणः शिनेः पौत्रं चित्रैः सर्वायसैः शरैः।\nत्रिभिराशीविपाकारैर्ललाटे समविध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2054208, "chapter_id": 2190, "verse_number": "७-११७-४", "content_sanskrit": "तैर्ललाटार्पितैर्बाणैर्युयुधानस्त्वजिह्मगैः।\nव्यरोचत महाराज त्रिशृङ्ग इव पर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2054209, "chapter_id": 2190, "verse_number": "७-११७-५", "content_sanskrit": "ततोऽस्य बाणानपरानिन्द्राशनिसमस्वनान्।\nभारद्वाजोऽन्तरप्रेक्षी प्रेषयामास संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2054210, "chapter_id": 2190, "verse_number": "७-११७-६", "content_sanskrit": "तान्द्रोणचापनिर्मुक्तान्दाशार्हः पततः शरान्।\nद्वाभ्यांद्वाभ्यां सुपुङ्खाभ्यां चिच्छेद परमास्त्रवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2054211, "chapter_id": 2190, "verse_number": "७-११७-७", "content_sanskrit": "तामस्य लघुतां द्रोणः समवेक्ष्य विशाम्पते।\nप्रहस्य सहसाऽविध्यत्त्रिंशतां शिनिपुङ्गवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2054212, "chapter_id": 2190, "verse_number": "७-११७-८", "content_sanskrit": "पुनः पञ्चशतेषूणां शितेन च समार्पयत्।\nलघुतां युयुधानस्य लाघवेन विशेषयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2054213, "chapter_id": 2190, "verse_number": "७-११७-९", "content_sanskrit": "समुत्पतन्ति वल्मीकाद्यथा क्रुद्धा महोरगाः।\nतथा द्रोणरथाद्राजन्नापतन्ति तनुच्छिदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2054214, "chapter_id": 2190, "verse_number": "७-११७-१०", "content_sanskrit": "तथैव युयुधानेन सृष्टाः सतसहस्रशः।\nअवाकिरन्द्रोणरथं शरा रुधिरभोजनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2054215, "chapter_id": 2190, "verse_number": "७-११७-११", "content_sanskrit": "लाघवाद्दिजमुख्यस्य सात्वतस्य च मारिष।\nविशेषं नाध्यगच्छाम समावास्तां नरर्षभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2054216, "chapter_id": 2190, "verse_number": "७-११७-१२", "content_sanskrit": "सात्यकिस्तु ततो द्रोणं नवभिर्नतपर्वभिः।\nआजघान भृशं क्रुद्धो ध्वजं च निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2054217, "chapter_id": 2190, "verse_number": "७-११७-१३", "content_sanskrit": "सारथिं च शतेनैव भारद्वाजस्य पश्यतः।\nलाघवं युयुधानस्य दृष्ट्वा द्रोणो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2054218, "chapter_id": 2190, "verse_number": "७-११७-१४", "content_sanskrit": "सप्तत्या सारथिं विद्व्वा तुरङ्गांश्च त्रिभिस्त्रिभिः।\nध्वजमेकेन चिच्छेद माधवस्य रथे स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2054219, "chapter_id": 2190, "verse_number": "७-११७-१५", "content_sanskrit": "अथापरेण भल्लेन हेमपुङ्खेन पत्रिणा।\nधनुश्चिच्छेद समरे माधवस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2054220, "chapter_id": 2190, "verse_number": "७-११७-१६", "content_sanskrit": "सात्यकिस्तु ततः क्रुद्धो धनुस्त्यक्त्वा महारथः।\nगदां जग्राह महतीं भारद्वाजाय चाक्षिपत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2054221, "chapter_id": 2190, "verse_number": "७-११७-१७", "content_sanskrit": "तामापतन्तीं सहसा पट्टबद्धामयस्मयीम्।\nन्यवारयच्छरैर्द्रोणो बहुभिर्बहुरूपिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2054222, "chapter_id": 2190, "verse_number": "७-११७-१८", "content_sanskrit": "अथान्यद्धनुरादाय सात्यकिः सत्यविक्रमः।\nविव्याध बहुभिर्वीरं भारद्वाजं शिलाशितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2054223, "chapter_id": 2190, "verse_number": "७-११७-१९", "content_sanskrit": "स विद्वा समरे द्रोणं सिंहनादममुञ्चत।\nतं वै न मृमषे द्रोणः सिंहनादं महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2054224, "chapter_id": 2190, "verse_number": "७-११७-२०", "content_sanskrit": "ततः शक्तिं रणे द्रोणो रुक्मदण्डामयस्मयीम्।\nतरसा प्रेषयामास माधवस्य रथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2054225, "chapter_id": 2190, "verse_number": "७-११७-२१", "content_sanskrit": "अनासाद्य तु शैनेयं सा शक्तिः कालसन्निभा।\nभित्त्वा रथं जगामोग्ना धरणीं दारुणस्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2054226, "chapter_id": 2190, "verse_number": "७-११७-२२", "content_sanskrit": "ततो द्रोणं शिनेः पौत्रो राजन्विव्याध पत्रिणा।\nदक्षिणं भुजमासाद्य पीडयन्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2054227, "chapter_id": 2190, "verse_number": "७-११७-२३", "content_sanskrit": "द्रोणोऽपि समरे राजन्माधवस्य महद्धनुः।\nअर्धचन्द्रेण चिच्छेद रथशक्त्या च सारथिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2054228, "chapter_id": 2190, "verse_number": "७-११७-२४", "content_sanskrit": "मुमोह सारथिस्तस्य रथशक्त्या समाहतः।\nस रथोपस्थमासाद्य मुहूर्तं सन्न्यषीदत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2054229, "chapter_id": 2190, "verse_number": "७-११७-२५", "content_sanskrit": "चकार सात्यकी राजंस्तत्र कर्मातिमानुषम्।\nअयोधयच्च यद्द्रोणं रश्मीञ्जग्राह च स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2054230, "chapter_id": 2190, "verse_number": "७-११७-२६", "content_sanskrit": "ततः शरशतेनैव युयुधानो महारथः।\nअविध्यद्ब्राह्मणं सङ्ख्ये हृष्टरूपो विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2054231, "chapter_id": 2190, "verse_number": "७-११७-२७", "content_sanskrit": "तस्य द्रोणः शरान्पञ्च प्रेषयामास भारत।\nते घोराः कवचं भित्त्वा पपुः शोणितमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2054232, "chapter_id": 2190, "verse_number": "७-११७-२८", "content_sanskrit": "निर्विद्धस्तु शरैर्घोरैरक्रुद्ध्यत्सात्यकिर्भृशम्।\nसायकान्व्यसृजच्चापि वीरो रुक्मरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2054233, "chapter_id": 2190, "verse_number": "७-११७-२९", "content_sanskrit": "ततो द्रोणस्य यन्तारं निपात्यैकेषुणा भुवि।\nअश्वान्व्यद्रावयद्बाणैर्हतसूतांस्ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2054234, "chapter_id": 2190, "verse_number": "७-११७-३०", "content_sanskrit": "स रथः प्रद्रुतः सङ्ख्ये मण्डलानि सहस्रशः।\nचकार राजतो राजन्भ्राजमान इवांशुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2054235, "chapter_id": 2190, "verse_number": "७-११७-३१", "content_sanskrit": "अभिद्रवत गृह्णीत हयान्द्रोणस्य धावत।\nइति स्म चुक्रुशुः सर्वे राजपुत्राः सराजकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2054236, "chapter_id": 2190, "verse_number": "७-११७-३२", "content_sanskrit": "ते सात्यकिमपास्याशु राजन्युधि महारथाः।\nयतो द्रोणस्ततः सर्वे सहसा समुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2054237, "chapter_id": 2190, "verse_number": "७-११७-३३", "content_sanskrit": "तान्दृष्ट्वा प्रद्रुतान्सङ्ख्ये सात्वतेन शरार्दितान्।\nप्रभग्नं पुनरेवासीत्तव सैन्यं समाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2054238, "chapter_id": 2190, "verse_number": "७-११७-३४", "content_sanskrit": "व्यूहस्यैव पुनर्द्वारं गत्वा द्रोणो व्यवस्थितः।\nवातायमानैस्तैरश्वैर्नीतो वृष्णिशरार्दितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2054239, "chapter_id": 2190, "verse_number": "७-११७-३५", "content_sanskrit": "पाण्डुपाञ्चालसम्भिन्नं व्यूहमालोक्य वीर्यवान्।\nशैनेये नाकरोद्यत्नं व्यूहमेवाभ्यरक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2054240, "chapter_id": 2190, "verse_number": "७-११७-३६", "content_sanskrit": "निवार्य पाण़्डुपाञ्चालान्द्रोणाग्निः प्रदहन्निव।\nतस्थौ क्रोधेध्मसन्दीप्तः कालसूर्य इवोद्यतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2054241, "chapter_id": 2190, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे सप्तदशाधिकशततमोऽध्यायः॥ ११७ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-११७-२३ रथशक्त्या केतकपत्राकारमुखया शक्त्या॥ ५-११७-११७ सप्तदशाधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]