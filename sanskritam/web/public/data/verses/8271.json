[{"id": 900002821, "chapter_id": 8271, "verse_number": "5.1", "content_sanskrit": "सन्न्यासं कर्मणां कृष्ण पुनर्योगं च शंससि । यच्छ्रेय एतयोरेकं तन्मे ब्रूहि सुनिश्चितम् ।। १ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900002822, "chapter_id": 8271, "verse_number": "5.2", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900002823, "chapter_id": 8271, "verse_number": "5.3", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900002824, "chapter_id": 8271, "verse_number": "5.4", "content_sanskrit": "सन्न्यासः कर्मयोगश्च निःश्रेयसकरावुभौ । तयोस्तु कर्मसन्न्यासात् कर्मयोगो विशिष्यते ।। २ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900002825, "chapter_id": 8271, "verse_number": "5.5", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900002826, "chapter_id": 8271, "verse_number": "5.6", "content_sanskrit": "ज्ञेयस्स नित्यसन्न्यासी यो न द्वेष्टि न काङ्क्षति । निर्द्वन्द्वो हि महाबाहो सुखं बन्धात् प्रमुच्यते ।। ३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900002827, "chapter_id": 8271, "verse_number": "5.7", "content_sanskrit": "साङ्ख्ययोगौ पृथग्बालाः प्रवदन्ति न पण्डिताः । एकमप्यास्थितः सम्यगुभयोर्विन्दते फलम् ।। ४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900002828, "chapter_id": 8271, "verse_number": "5.8", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900002829, "chapter_id": 8271, "verse_number": "5.9", "content_sanskrit": "यत् साङ्ख्यैः प्राप्यते स्थानं तद्योगैरपि गम्यते । एकं साङ्ख्यं च योगं च यः पश्यति स पश्यति ।। ५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900002830, "chapter_id": 8271, "verse_number": "5.10", "content_sanskrit": "सन्न्यासस्तु महाबाहो दुःखमाप्तुमयोगतः । योगयुक्तो मुनिर्ब्रह्म न चिरेणाधिगच्छति ।। ६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900002831, "chapter_id": 8271, "verse_number": "5.11", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900002832, "chapter_id": 8271, "verse_number": "5.12", "content_sanskrit": "योगयुक्तो विशुद्धात्मा विजितात्मा जितेन्द्रियः । सर्वभूतात्मभूतात्मा कुर्वन्नपि न लिप्यते ।। ७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900002833, "chapter_id": 8271, "verse_number": "5.13", "content_sanskrit": "नैव किञ्चत् करोमीति युक्तो मन्येत तत्त्ववित् । पश्यञ्च्छृण्वन् स्पृशञ्जिघ्रन्नश्नन् गच्छन् स्वपन् श्वसन् ।। ८ ।। प्रलपन् विसृजन् गृह्णन्नुन्मिषन् निमिषन्नपि । इन्द्रियाणीन्द्रियार्थेषु वर्तन्त इति धारयन् ।। ९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900002834, "chapter_id": 8271, "verse_number": "5.14", "content_sanskrit": "ब्रह्मण्याधाय कर्माणि सङ्गं त्यक्त्वा करोति यः । लिप्यते न स पापेन पद्मपत्रमिवाम्भसा ।। १० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900002835, "chapter_id": 8271, "verse_number": "5.15", "content_sanskrit": "कायेन मनसा बुद्ध्या केवलैरिन्द्रियैरपि । योगिनः कर्म कुर्वन्ति सङ्गं त्यक्त्वाऽऽत्मशुद्धये ।। ११ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900002836, "chapter_id": 8271, "verse_number": "5.16", "content_sanskrit": "युक्तः कर्मफलं त्यक्त्वा शान्तिमाप्नोति नैष्ठिकीम् । अयुक्तः कामकारेण फले सक्तो निबद्ध्यते ।। १२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900002837, "chapter_id": 8271, "verse_number": "5.17", "content_sanskrit": "सर्वकर्माणि मनसा सन्न्यस्याऽस्ते सुखं वशी । नवद्वारे पुरे देही नैव कुर्वन्न कारयन् ।। १३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900002838, "chapter_id": 8271, "verse_number": "5.18", "content_sanskrit": "न कर्तृत्वं न कर्माणि लोकस्य सृजति प्रभुः । न कर्मफलसंयोगं स्वभावस्तु प्रवर्तते ।। १४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900002839, "chapter_id": 8271, "verse_number": "5.19", "content_sanskrit": "नादत्ते कस्यचित् पापं न चैव सुकृतं विभुः । अज्ञानेनाऽवृतं ज्ञानं तेन मुह्यन्ति जन्तवः।। १५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900002840, "chapter_id": 8271, "verse_number": "5.20", "content_sanskrit": "ज्ञानेन तु तदज्ञानं येषां नाशितमात्मनः । तेषामादित्यवज्ज्ञानं प्रकाशयति तत्परम् ।। १६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900002841, "chapter_id": 8271, "verse_number": "5.21", "content_sanskrit": "तद्बुद्धयस्तदात्मानस्तन्निष्ठास्तत्परायणाः । गच्छन्त्यपुनरावृत्तिं ज्ञाननिर्धूतकल्मषाः ।। १७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900002842, "chapter_id": 8271, "verse_number": "5.22", "content_sanskrit": "विद्याविनयसम्पन्ने ब्राह्मणे गवि हस्तिनि । शुनि चैव श्वपाके च पण्डिताः समदर्शिनः ।। १८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900002843, "chapter_id": 8271, "verse_number": "5.23", "content_sanskrit": "इहैव तैर्जितः सर्गो येषां साम्ये स्थितं मनः । निर्दोषं हि समं ब्रह्म तस्माद् ब्रह्मणिे ते स्थिताः ।। १९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900002844, "chapter_id": 8271, "verse_number": "5.24", "content_sanskrit": "न प्रहृष्येत् प्रियं प्राप्य नोद्विजेत् प्राप्य चाप्रियम् । स्थिरबुद्धिरसम्मूढो ब्रह्मविद् ब्रह्मणि स्थितः ।। २० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900002845, "chapter_id": 8271, "verse_number": "5.25", "content_sanskrit": "बाह्यस्पर्शेष्वसक्तात्मा विन्दत्यात्मनि यत् सुखम् । स ब्रह्मयोगयुक्तात्मा सुखमक्षयमश्नुते ।। २१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900002846, "chapter_id": 8271, "verse_number": "5.26", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900002847, "chapter_id": 8271, "verse_number": "5.27", "content_sanskrit": "ये हि संस्पर्शजा भोगा दुःखयोनय एव ते । आद्यन्तवन्तः कौन्तेय न तेषु रमते बुधः ।। २२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900002848, "chapter_id": 8271, "verse_number": "5.28", "content_sanskrit": "शक्नोतीहैव यः सोढुं प्राक्च्छरीरविमोक्षणात् । कामक्रोधोद्भवं वेगं स युक्तः स सुखी नरः ।। २३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900002849, "chapter_id": 8271, "verse_number": "5.29", "content_sanskrit": "योऽन्तस्सुखोऽन्तरारामस्तथाऽन्तर्ज्योतिरेव यः । स योगी ब्रह्मनिर्वाणं ब्रह्मभूतोऽधिगच्छति ।। २४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900002850, "chapter_id": 8271, "verse_number": "5.30", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900002851, "chapter_id": 8271, "verse_number": "5.31", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900002852, "chapter_id": 8271, "verse_number": "5.32", "content_sanskrit": "लभन्ते ब्रह्मनिर्वाणमृषयः क्षीणकल्मषाः । छिन्नद्वैधाऽऽयतात्मानः सर्वभूतहिते रताः ।। २५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900002853, "chapter_id": 8271, "verse_number": "5.33", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900002854, "chapter_id": 8271, "verse_number": "5.34", "content_sanskrit": "कामक्रोधवियुक्तानां यतीनां यतचेतसाम् । अभितो ब्रह्म निर्वाणं वर्तते विदितात्मनाम् ।। २६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900002855, "chapter_id": 8271, "verse_number": "5.35", "content_sanskrit": "स्पर्शान् कृत्वा बहिर्बाह्यांश्चक्षुश्चैवान्तरे भ्रुवोः । प्राणापानौ समौ कृत्वा नासाभ्यन्तरचारिणौ ।। २७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900002856, "chapter_id": 8271, "verse_number": "5.36", "content_sanskrit": "यतेन्द्रियमनोबुद्धिर्मुनिर्मोक्षपरायणः । विगतेच्छाभयक्रोधो यः सदा मुक्त एव सः ।। २८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900002857, "chapter_id": 8271, "verse_number": "5.37", "content_sanskrit": "भोक्तारं यज्ञतपसां सर्वलोकमहेश्वरम् । सुहृदं सर्वभूतानां ज्ञात्वा मां शान्तिमृच्छति ।। २९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]