[{"id": 2209339, "chapter_id": 5473, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209340, "chapter_id": 5473, "verse_number": "१", "content_sanskrit": "उत्थितायां पृथायां तु सुभद्रा भ्रातरं तदा ।\nदृष्ट्वा चुक्रोश दुःखार्ता वचनं चेदमब्रवीत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209341, "chapter_id": 5473, "verse_number": "", "content_sanskrit": "सुभद्रा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209342, "chapter_id": 5473, "verse_number": "२", "content_sanskrit": "पुण्डरीकाक्ष पश्य त्वं पौत्रं पार्थस्य धीमतः ।\nपरिक्षीणेषु कुरुषु परिक्षीणं गतायुषम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209343, "chapter_id": 5473, "verse_number": "३", "content_sanskrit": "इषीका द्रोणपुत्रेण भीमसेनार्थमुद्यता ।\nसोत्तरायां निपतिता विजये मयि चैव ह ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209344, "chapter_id": 5473, "verse_number": "४", "content_sanskrit": "सेयं ज्वलन्ती हृदये मम तिष्ठति केशव ।\nयन्न पश्यामि दुर्धर्षमहं पुत्रसुतं विभो ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209345, "chapter_id": 5473, "verse_number": "५", "content_sanskrit": "किं नु वक्ष्यति धर्मात्मा धर्मपुत्रो युधिष्ठिरः ।\nभीमसेनार्जुनौ चोभौ माद्रवत्याः सुतौ च तौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209346, "chapter_id": 5473, "verse_number": "६", "content_sanskrit": "श्रुत्वाऽभिमन्योस्तनयं जातं च मृतमेव च ।\nमुषिता इव वार्ष्णेय द्रोणपुत्रेण पाण्डवाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209347, "chapter_id": 5473, "verse_number": "७", "content_sanskrit": "अभिमन्युः प्रियः कृष्ण पितॄणां नात्र संशयः ।\nते श्रुत्वा किं नु वक्ष्यन्ति द्रोणपुत्रास्त्रनिर्जिताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209348, "chapter_id": 5473, "verse_number": "८", "content_sanskrit": "भविता नः परं दुःखं किं नु मन्ये जनार्दन ।\nअभिमन्योः सुतात् कृष्ण मृताज्जातादरिन्दम ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209349, "chapter_id": 5473, "verse_number": "९", "content_sanskrit": "साऽहं प्रसादये कृष्ण त्वामद्य शिरसा नता ।\nपृथां च द्रौपदीं चैव मां पश्य पुरुषोत्तम ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209350, "chapter_id": 5473, "verse_number": "१०", "content_sanskrit": "यदा द्रोणसुतो गर्भान् पाण्डूनां हन्ति माधव ।\nत्वया किल पुरा द्रौणिः क्रुद्धेनोक्तोऽरिमर्दन ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209351, "chapter_id": 5473, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209352, "chapter_id": 5473, "verse_number": "११", "content_sanskrit": "अकामं त्वां करिष्यामि ब्रह्मबन्धो नराधम ।\nअहं सञ्जीवयिष्यामि किरीटितनयात्मजम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209353, "chapter_id": 5473, "verse_number": "", "content_sanskrit": "सुभद्रा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209354, "chapter_id": 5473, "verse_number": "१२", "content_sanskrit": "इत्येतद् वचनं श्रुत्वा जानानाऽहं बलं तव ।\nप्रसादये त्वां दुर्धर्ष जीवतामभिमन्युजः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209355, "chapter_id": 5473, "verse_number": "१३", "content_sanskrit": "यद्येतत् त्वं प्रतिश्रुत्य न करोषि वचः शुभम् ।\nसफलं वृष्णिशार्दूल मृतां मामवधारय ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209356, "chapter_id": 5473, "verse_number": "१४", "content_sanskrit": "अभिमन्योः सुतो वीर न सञ्जीवति यद्ययम् ।\nजीवति त्वयि दुर्धर्ष किं करिष्याम्यहं त्वया ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209357, "chapter_id": 5473, "verse_number": "१५", "content_sanskrit": "सञ्जीवयैनं दुर्धर्ष मृतं त्वमभिमन्युजम् ।\nसदृशाक्षसुतं वीर सत्यं वर्षास्विवाम्बुदः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209358, "chapter_id": 5473, "verse_number": "१६", "content_sanskrit": "त्वं हि केशव धर्मात्मा सत्यवाक् सत्यविक्रमः ।\nस तां वाचमृतां कर्तुमर्हसि त्वमरिन्दम ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209359, "chapter_id": 5473, "verse_number": "१७", "content_sanskrit": "इच्छन्नपि हि लोकांस्त्रीन् जीवयेथा मृतानपि ।\nकिं पुनर्दयितं जातं स्वस्रीयस्यात्मजं मृतम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209360, "chapter_id": 5473, "verse_number": "१८", "content_sanskrit": "प्रभावज्ञाऽस्मि ते कृष्ण तस्मादेतद् ब्रवीमि ते ।\nकुरुष्व पाण्डुपुत्राणामिमं परमनुग्रहम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209361, "chapter_id": 5473, "verse_number": "१९", "content_sanskrit": "स्वसेति वा महाबाहो हतपुत्रेति वा पुनः ।\nप्रपन्ना मामियं वेति दयां कर्तुमिहार्हसि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209362, "chapter_id": 5473, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्वमेधिकपर्वणि श्रीकृष्णप्रार्थनं नाम सप्तषष्टितमोऽध्यायः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]