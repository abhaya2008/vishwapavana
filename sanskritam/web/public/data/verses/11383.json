[{"id": 50007658, "chapter_id": 11383, "verse_number": "1", "content_sanskrit": "राजोवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50007659, "chapter_id": 11383, "verse_number": "2", "content_sanskrit": "ब्रह्मणा चोदितो ब्रह्मन् गुणाख्यानेऽगुणस्य च। यस्मैयस्मै यथा प्राह नारदो देवदर्शनः॥ २/८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50007660, "chapter_id": 11383, "verse_number": "3", "content_sanskrit": "एतद् वेदितुमिच्छामि तत्वं वेदविदां वर। हरेरद्भुतवीर्यस्य कथा लोकसुमङ्गळाः॥ २/८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50007661, "chapter_id": 11383, "verse_number": "4", "content_sanskrit": "प्रथयस्व महाभाग यथाऽहमखिलात्मनि। कृष्णे निवेश्य निःसङ्गं मनस्त्यक्ष्ये कळेबरम्॥ २/८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50007662, "chapter_id": 11383, "verse_number": "5", "content_sanskrit": "शृण्वतः श्रद्धया नित्यं गृणतश्च स्वचेष्टितम्। कालेनानतिदीर्घेण भगवान् विशते हृदि॥ २/८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50007663, "chapter_id": 11383, "verse_number": "6", "content_sanskrit": "प्रविष्टः कर्णरन्ध्रेण स्वानां भावसरोरुहम्। धुनोति शमलं कृष्णः सलिलस्य\\patha“सलिलस्थं यथा शरत्॥ २/८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50007664, "chapter_id": 11383, "verse_number": "7", "content_sanskrit": "धौतात्मा पुरुषः कृष्णपादमूलं न मुञ्चति। मुक्तसर्वपरिक्लेशः पान्थः स्वशरणं यथा॥ २/८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50007665, "chapter_id": 11383, "verse_number": "8", "content_sanskrit": "यदधातुमतो ब्रह्मन् देहारम्भोऽस्य धातुभिः। यदृच्छया हेतुना वा भवन्तो जानते यथा॥ २/८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50007666, "chapter_id": 11383, "verse_number": "9", "content_sanskrit": "आसीद् यदुदरात् पद्मं लोकसंस्थानलक्षणम्। यावानयं वै पुरुष इयत्तावयवैः पृथक्। तावानसाविति प्रोक्तस्तथाऽवयववानिव॥ २/८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50007667, "chapter_id": 11383, "verse_number": "10", "content_sanskrit": "अजः सृजति भूतानि भूतात्मा यदनुग्रहात्। ददृशे येन तद्रूपं नाभिपद्मसमुद्भवः॥ २/८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50007668, "chapter_id": 11383, "verse_number": "11", "content_sanskrit": "स चापि यत्र पुरुषो विश्वस्थित्युद्भवाप्ययः। मुक्त्वाऽऽत्ममायां मायेशः शेते सर्वगुणाश्रयः॥ २/८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50007669, "chapter_id": 11383, "verse_number": "12", "content_sanskrit": "पुरुषावयवैर्लोकाः सपालाः पूर्वकल्पिताः। लोकैरमुष्यावयवाः सपालैरिति शुश्रुमः॥ २/८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50007670, "chapter_id": 11383, "verse_number": "13", "content_sanskrit": "यावान् कल्पो विकल्पो वा यथा कालोऽनुमीयते। भूतभव्यभवच्छब्द आयुर्मानं च यत्कृतम्॥ २/८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50007671, "chapter_id": 11383, "verse_number": "14", "content_sanskrit": "कालस्यानुगतिर्या तु लक्ष्यतेऽण्वी महत्यपि। यावतीः कर्मगतयो यादृशीर्द्विजसत्तम॥ २/८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50007672, "chapter_id": 11383, "verse_number": "15", "content_sanskrit": "यस्मिन् कर्मसमवायः\\patha“कर्मसमावापो” यथा येनोपगृह्यते। गुणानां गुणिनां चैव परिमाणं सुविस्तरम्॥ २/८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50007673, "chapter_id": 11383, "verse_number": "16", "content_sanskrit": "भूपाताळककुब्व्योमग्रहनक्षत्रभूभृताम्। सरित्समुद्रद्वीपानां सम्भवं चैतदोकसाम्॥ २/८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50007674, "chapter_id": 11383, "verse_number": "17", "content_sanskrit": "प्रमाणमण्डकोशस्य बाह्याभ्यन्तरवस्तुनः। महतां चानुचरितं वर्णाश्रमविनिर्णयम्॥ २/८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50007675, "chapter_id": 11383, "verse_number": "18", "content_sanskrit": "अवतारानुचरितं यदाश्चर्यतमं हरेः। युगानि युगमानं च धर्मो यश्च युगेयुगे॥ २/८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50007676, "chapter_id": 11383, "verse_number": "19", "content_sanskrit": "नृणां साधारणो धर्मः सविशेषश्च यादृशः। श्रेणीनां राजर्षीणां च धर्मः कृच्छ्रेषु जीवताम्॥ २/८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50007677, "chapter_id": 11383, "verse_number": "20", "content_sanskrit": "तत्वानां परिसङ्ख्यानं लक्षणं हेतुलक्षणम्। पुरुषाराधनविधिर्योगस्याध्यात्मिकस्य च॥ २/८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50007678, "chapter_id": 11383, "verse_number": "21", "content_sanskrit": "योगेश्वरैश्वर्यगतिं लिङ्गभङ्गं च योगिनाम्। वेदोपवेदधर्माणामितिहासपुराणयोः॥ २/८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50007679, "chapter_id": 11383, "verse_number": "22", "content_sanskrit": "सम्भवः सर्वभूतानां विक्रमः प्रतिसङ्क्रमः। इष्टापूर्तस्य काम्यानां त्रिवर्गस्य च यो विधिः॥ २/८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50007680, "chapter_id": 11383, "verse_number": "23", "content_sanskrit": "यो वाऽनुशयिनां सर्गः पाषण्डस्य च सम्भवः। आत्मनो बन्धमोक्षौ च व्यवस्थानं स्वरूपतः॥ २/८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50007681, "chapter_id": 11383, "verse_number": "24", "content_sanskrit": "यथात्मतन्त्रो भगवान् विक्रीडत्यात्ममायया। विसृज्य च यथा मायामुदास्ते साक्षिवद् विभुः॥ २/८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50007682, "chapter_id": 11383, "verse_number": "25", "content_sanskrit": "सर्वमेतच्च भगवान् पृच्छतो मेऽनुपूर्वशः। तत्वतोऽर्हस्युदाहर्तुं प्रपन्नाय महामुने॥ २/८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50007683, "chapter_id": 11383, "verse_number": "26", "content_sanskrit": "अत्र प्रमाणं हि भवान् परमेष्ठी यथाऽऽत्मभूः। अपरे ह्यनुतिष्ठन्ति पूर्वेषां पूर्वजैः कृतम्॥ २/८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50007684, "chapter_id": 11383, "verse_number": "27", "content_sanskrit": "न मेऽसवः परायन्ति ब्रह्मन्ननशनादमी। पिबतोऽच्युतपीयूषं त्वद्वाक्याद्धि विनिःसृतम्॥ २/८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50007685, "chapter_id": 11383, "verse_number": "28", "content_sanskrit": "सूत उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50007686, "chapter_id": 11383, "verse_number": "29", "content_sanskrit": "स उपामन्त्रितो राज्ञा कथायामिति सत्पतेः। ब्रह्मरातो भृशं प्रीतो विष्णुरातेन संसदि॥ २/८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50007687, "chapter_id": 11383, "verse_number": "30", "content_sanskrit": "आह भागवतं नाम पुराणं ब्रह्मसम्मितम्। ब्रह्मणे भगवत्प्रोक्तं ब्रह्मकल्प उपागते॥ २/८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50007688, "chapter_id": 11383, "verse_number": "31", "content_sanskrit": "यद्यत् परीक्षिद् ऋषभः पाण्डूनामनुपृच्छति। आनुपूर्व्येण तत् सर्वमाख्यातुमुपचक्रमे॥ २/८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50007689, "chapter_id": 11383, "verse_number": "32", "content_sanskrit": "॥ इति श्रीमद्भागवते द्वितीयस्कन्धे अष्टमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]