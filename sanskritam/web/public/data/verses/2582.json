[{"id": 2074869, "chapter_id": 2582, "verse_number": "१२-८७-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074870, "chapter_id": 2582, "verse_number": "१२-८७-१", "content_sanskrit": "राष्ट्रगुप्तिं च मे राजन्राष्ट्रस्यैव तु संग्रहम्।\nसम्यग्जिज्ञासमानाय प्रब्रूहि भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074871, "chapter_id": 2582, "verse_number": "१२-८७-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074872, "chapter_id": 2582, "verse_number": "१२-८७-२", "content_sanskrit": "राष्ट्रगुप्तिं च ते सम्यग्राष्ट्रस्यैव तु संग्रहम्।\nहन्त सर्वं प्रवक्ष्यामि तत्त्वमेकमनाः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074873, "chapter_id": 2582, "verse_number": "१२-८७-३", "content_sanskrit": "ग्रामस्याधिपतिः कार्यो दशग्रामपतिस्तथा।\nविंशतित्रिंशतीशं च सहस्रस्य च कारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074874, "chapter_id": 2582, "verse_number": "१२-८७-४", "content_sanskrit": "ग्रामेयान्ग्रामदोषांश्च ग्रामिकः प्रतिभावेयेत्।\nतानाचक्षीत दशिने दशिको विंशिने पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074875, "chapter_id": 2582, "verse_number": "१२-८७-५", "content_sanskrit": "विंशाधिपस्तु तत्सर्वं वृत्तं जानपदे जने।\nग्रामाणां शतपालाय सर्वमेव निवेदयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074876, "chapter_id": 2582, "verse_number": "१२-८७-६", "content_sanskrit": "यानि ग्राम्याणि भोज्यानि ग्रामिकस्तान्युपाश्निया।\nदशपस्तेन भर्तव्यस्तेनापि द्विगुणाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074877, "chapter_id": 2582, "verse_number": "१२-८७-७", "content_sanskrit": "ग्रामं ग्रामशताध्यक्षो भोक्तुमर्हति सत्कुरः।\nमहान्तं भरतश्रेष्ठ सुस्फीतं जनसंकुलम्।\nतत्र ह्यनेकपायत्तं राज्ञो भवति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074878, "chapter_id": 2582, "verse_number": "१२-८७-८", "content_sanskrit": "शाखानगरमर्हस्तु सहस्रपतिरुत्तमः।\nधान्यहैरण्यभोगेन भोक्तुं राष्ट्रीयसंगतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074879, "chapter_id": 2582, "verse_number": "१२-८७-९", "content_sanskrit": "तेषां संग्रामकृत्यं स्याद्वामकृत्यं च तेषु यत्।\nधर्मज्ञः सचिवः कश्चित्तत्तत्पश्येदतन्द्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074880, "chapter_id": 2582, "verse_number": "१२-८७-१०", "content_sanskrit": "नगरेनगरे वा स्यादेकः सर्वार्थचिन्तकः।\nउच्चैः स्थाने घोररूपो नक्षत्राणामिव ग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074881, "chapter_id": 2582, "verse_number": "१२-८७-११", "content_sanskrit": "भवेत्स तान्परिक्रामेत्सर्वानेव सभासदः।\nतेषां वृत्तिं परिणयेत्कश्चिद्राष्ट्रेषु तच्चरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074882, "chapter_id": 2582, "verse_number": "१२-८७-१२", "content_sanskrit": "जिघांसवः पापकामाः परस्वादायिनः शठाः।\nरक्षाभ्यधिकृता नाम तेभ्यो रक्षेदिमाः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074883, "chapter_id": 2582, "verse_number": "१२-८७-१३", "content_sanskrit": "विक्रयं क्रयमध्वानं भक्तं च सपरिव्ययम्।\nयोगक्षेमं च संप्रेक्ष्य वणिजां कारयेत्करान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074884, "chapter_id": 2582, "verse_number": "१२-८७-१४", "content_sanskrit": "उत्पत्तिं दानवृत्तिं च शिल्पं संप्रेक्ष्य चासकृत्।\nशिल्पं प्रति करानेवं शिल्पिनः प्रति कारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074885, "chapter_id": 2582, "verse_number": "१२-८७-१५", "content_sanskrit": "उच्चावचकरन्यायाः पूर्वराज्ञां युधिष्ठिर।\nयथायथा न सीदेरंस्तथा कुर्यान्महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074886, "chapter_id": 2582, "verse_number": "१२-८७-१६", "content_sanskrit": "फलं कर्म च संप्रेक्ष्य ततः सर्वं प्रकल्पयेत्।\nफलं कर्म च निर्हेतु न कश्चित्संप्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074887, "chapter_id": 2582, "verse_number": "१२-८७-१७", "content_sanskrit": "यथा राजा च कर्ता च स्यातां कर्मणि भागिनौ।\nसंवेक्ष्य तु तथा राज्ञा प्रणेयाः सततं कराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074888, "chapter_id": 2582, "verse_number": "१२-८७-१८", "content_sanskrit": "नोच्छिद्याहात्मनो मूलं परेषां चापि तृष्णया।\nईहाद्वाराणि संरुध्य राजा संवृतदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074889, "chapter_id": 2582, "verse_number": "१२-८७-१९", "content_sanskrit": "प्रद्विषन्ति परिख्यातं राजानमतिखादिनम्।\nप्रद्विष्टस्य कुतः श्रेयो संवृतो लभते श्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074890, "chapter_id": 2582, "verse_number": "१२-८७-२०", "content_sanskrit": "वत्सौपम्येन दोग्धव्यं राष्ट्रमक्षीणबुद्धिना।\nभृतो वत्सो जातबलः षीडां सहति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074891, "chapter_id": 2582, "verse_number": "१२-८७-२१", "content_sanskrit": "न कर्म कुरुते वत्सो भृशं दुग्धो युधिष्ठिर।\nराष्ट्रमप्यातिदुग्धं हि न कर्म कुरुते महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074892, "chapter_id": 2582, "verse_number": "१२-८७-२२", "content_sanskrit": "यो राष्ट्रमनुगृह्णाति परिरक्षन्स्वयं नृपः।\nसंजातमुपजीवन्स लभते सुमहत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074893, "chapter_id": 2582, "verse_number": "१२-८७-२३", "content_sanskrit": "आपदर्थं च निचयात्राजानो हि चिचिन्वते।\nराष्ट्रं च कोशभूतं स्यात्कोशो वेश्मगतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074894, "chapter_id": 2582, "verse_number": "१२-८७-२४", "content_sanskrit": "पौरजानपदान्सर्वान्संश्रितोषाश्रितांस्तथा।\nयथाशक्त्यनुकम्पेत सर्वान्स्वल्पधनानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074895, "chapter_id": 2582, "verse_number": "१२-८७-२५", "content_sanskrit": "बाह्यं जनं भेदयित्वा भोक्तव्यो मध्यमः सुखम्।\nएवं नास्य प्रकुप्यन्ति जनाः सुखितदुः खिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074896, "chapter_id": 2582, "verse_number": "१२-८७-२६", "content_sanskrit": "प्रामेव तु धनादानमनुभाष्य ततः पुनः।\nसन्निपत्य स्वविषये भयं राष्ट्रे प्रदर्शयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074897, "chapter_id": 2582, "verse_number": "१२-८७-२७", "content_sanskrit": "इयमापत्समुत्पन्ना परचक्रभयं महत्।\nअपि चान्ताय कल्पन्ते वेणोरिव फलागमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074898, "chapter_id": 2582, "verse_number": "१२-८७-२८", "content_sanskrit": "अरयो मे समुत्थाय बहुभिर्दस्युभिः सह।\nइदमात्मवधायैव राष्ट्रमिच्छन्ति बाधितुम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2074899, "chapter_id": 2582, "verse_number": "१२-८७-२९", "content_sanskrit": "अस्यामापदि घोरायां संप्राप्ते दारुणे भये।\nपरित्राणाय भवतः प्रार्थयिष्ये धनानि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2074900, "chapter_id": 2582, "verse_number": "१२-८७-३०", "content_sanskrit": "प्रतिदास्ये च भवतां सर्वं चाहं भयक्षये।\nनारयः प्रतिदास्यन्ति यद्धरेयुर्बलादितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2074901, "chapter_id": 2582, "verse_number": "१२-८७-३१", "content_sanskrit": "कलत्रमादितः कृत्वा सर्वं वो विनशेदिति।\nशरीरपुत्रदारार्थमर्थसंचय इष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2074902, "chapter_id": 2582, "verse_number": "१२-८७-३२", "content_sanskrit": "नन्दामि वः प्रभावेण पुत्राणामिव चोदये।\nयखाशक्त्युपगृह्णामि राष्ट्रस्यापीडया च वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2074903, "chapter_id": 2582, "verse_number": "१२-८७-३३", "content_sanskrit": "आपत्स्वेव निवोढव्यं भवद्भिः संगतैरिह।\nन वः प्रियतरं कार्यं धनं कस्यांचिदापदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2074904, "chapter_id": 2582, "verse_number": "१२-८७-३४", "content_sanskrit": "इति वाचा मधुरया श्लक्ष्णया सोपचारया।\nस्वरश्मीनभ्यवसृजेद्योगमाधाय कालवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2074905, "chapter_id": 2582, "verse_number": "१२-८७-३५", "content_sanskrit": "प्रचारं भृत्यभरणं व्ययं संग्रामतो भयम्।\nयोगक्षेणं च संप्रेक्ष्य गोमिनः कारयेत्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2074906, "chapter_id": 2582, "verse_number": "१२-८७-३६", "content_sanskrit": "उपेक्षिता हि नश्येयुर्गोमिनोऽरण्यवासिनः।\nतस्मात्तेषु विशेषेण मृदुपूर्वं समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2074907, "chapter_id": 2582, "verse_number": "१२-८७-३७", "content_sanskrit": "सान्त्वनं रक्षणं दानमवस्था चाप्यभीक्ष्णशः।\nगोमिनां पार्थ कर्तव्यः संविभागः प्रियाणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2074908, "chapter_id": 2582, "verse_number": "१२-८७-३८", "content_sanskrit": "अजस्रमुपयोक्तव्यं फलं गोमिषु भारत।\nप्रभावयन्ति राष्ट्रं च व्यवहारं कृषिं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2074909, "chapter_id": 2582, "verse_number": "१२-८७-३९", "content_sanskrit": "तस्माद्गोमिषु यत्नेन प्रीतिं कुर्याद्विचक्षणः।\nदयावानप्रमत्तश्च करान्संप्रणयन्मृदून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2074910, "chapter_id": 2582, "verse_number": "१२-८७-४०", "content_sanskrit": "सर्वत्र क्षेमचरणं सुलभं नाम गोमिषु।\nन ह्यतः सदृशं किंचिद्धनमस्ति युधिष्ठिर॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2074911, "chapter_id": 2582, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि सप्ताशीतितमोऽध्यायः॥ ८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]