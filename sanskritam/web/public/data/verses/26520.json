[{"id": 7006520000, "chapter_id": 26520, "verse_number": "३-५९-१", "content_sanskrit": "वृषपर्वणः निष्कुम्भेन विश्वेदेवेन सार्द्धं, प्रह्रादस्य कालेन सार्द्धं घोरयुद्धस्य वर्णनम् वैशम्पायन उवाच वृषपर्वा तु दैत्येन्द्रो विश्वमद्भुतदर्शनम् ।\nनिष्कुम्भं योधयामास लोहितार्कसमद्युतिम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006520001, "chapter_id": 26520, "verse_number": "३-५९-२", "content_sanskrit": "क्रोधमूर्च्छितवक्त्रस्तु धुन्वन् परमकार्मुकम् ।\nधनूंषि प्रेक्ष्य शत्रूणां सारथिं त्वरितोऽब्रवीत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006520002, "chapter_id": 26520, "verse_number": "३-५९-३", "content_sanskrit": "अत्रैव तावत् त्वरितं नय मे सारथे रथम् ।\nएते देवाश्च सहिता घ्नन्ति नः समरे बलम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006520003, "chapter_id": 26520, "verse_number": "३-५९-४", "content_sanskrit": "एतान् निहन्तुमिच्छामि समरश्लाघिनो रणे ।\nएतैर्हि दानवानीकं कृतच्छिद्रमिदं महत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006520004, "chapter_id": 26520, "verse_number": "३-५९-५", "content_sanskrit": "ततः प्रजविताश्वेन रथेन रथिनां वरः ।\nअरीनभ्यहनत् क्रुद्धः शरजालैर्महासुरः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006520005, "chapter_id": 26520, "verse_number": "३-५९-६", "content_sanskrit": "न स्थातुं देवताः शक्ताः किं पुनर्योद्धुमाहवे ।\nवृषपर्वेषुनिर्भिन्नाः सर्व एवाभिदुद्रुवुः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006520006, "chapter_id": 26520, "verse_number": "३-५९-७", "content_sanskrit": "तान् मृत्युवशमापन्नान् वैवस्वतवशं गतान् ।\nसमीक्ष्य निहताञ्ज्ञातीनवतस्थे महासुरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006520007, "chapter_id": 26520, "verse_number": "३-५९-८", "content_sanskrit": "दृष्ट्वा तं तत्र निष्कुम्भं सर्वे ते त्रिदशोत्तमाः ।\nसमेत्य सहिताः सर्वे द्रुतं तं पर्यवारयन् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006520008, "chapter_id": 26520, "verse_number": "३-५९-९", "content_sanskrit": "व्यवस्थितं तु निष्कुम्भं दृष्ट्वा त्रिदशसत्तमम् ।\nबभूवुर्बलवन्तो वै तस्यास्त्रबलतेजसा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006520009, "chapter_id": 26520, "verse_number": "३-५९-१०", "content_sanskrit": "वृषपर्वा तु शैलाभं निष्कुम्भं समरे स्थितम् ।\nमहेन्द्र इव धाराभिः शरवर्षैरवाकिरत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006520010, "chapter_id": 26520, "verse_number": "३-५९-११", "content_sanskrit": "अचिन्तयित्वा तु शराञ्छरीरे पतितान् बहून् ।\nस्थितश्च प्रमुखे श्रीमान् ससैन्यः स महाबलः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006520011, "chapter_id": 26520, "verse_number": "३-५९-१२", "content_sanskrit": "सम्प्रहस्य महातेजा वृषपर्वाणमाहवे ।\nअभिदुद्राव वेगेन कम्पयन्निव मेदिनीम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006520012, "chapter_id": 26520, "verse_number": "३-५९-१३", "content_sanskrit": "तस्य त्वाधावमानस्य दीप्यमानस्य तेजसा ।\nबभूव रूपं दुर्धर्षं दीप्तस्येव विभावसोः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006520013, "chapter_id": 26520, "verse_number": "३-५९-१४", "content_sanskrit": "रथं त्यक्त्वा महातेजाः सक्रोधः समपद्यत ।\nवृक्षमुत्पाटयामास महातालं महोच्छ्रयम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006520014, "chapter_id": 26520, "verse_number": "३-५९-१५", "content_sanskrit": "ततश्चिक्षेप तं वृक्षं निष्कुम्भो वृषपर्वणः ।\nतं गृहीत्वा महावृक्षं पाणिनैकेन दानवः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006520015, "chapter_id": 26520, "verse_number": "३-५९-१६", "content_sanskrit": "विनद्य सुमहानादं भ्रामयित्वा च वीर्यवान् ।\nसगजान् सगजारोहान् सरथान् रथिनस्तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006520016, "chapter_id": 26520, "verse_number": "३-५९-१७", "content_sanskrit": "जघान दानवस्तेन शाखिना त्रिदशांस्तदा ।\nतमन्तकमिव क्रुद्धं समरे प्राणहारिणम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006520017, "chapter_id": 26520, "verse_number": "३-५९-१८", "content_sanskrit": "वृषपर्वाणमासाद्य त्रिदशा विप्रदुद्रुवुः ।\nतमापतन्तं संक्रुद्धं त्रिदशानां भयावहम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006520018, "chapter_id": 26520, "verse_number": "३-५९-१९", "content_sanskrit": "आलोक्य धन्वी निष्कुम्भश्चुक्रोध च ननाद च ।\nस तत्र निशितैर्बाणैस्त्रिंशद्भिर्मर्मभेदिभिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006520019, "chapter_id": 26520, "verse_number": "३-५९-२०", "content_sanskrit": "निर्बिभेद महावीर्यो निष्कुम्भो दानवाधिपम् ।\nशरशक्तिभिरुग्राभिदैत्यानामधिपोऽप्यमुम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006520020, "chapter_id": 26520, "verse_number": "३-५९-२१", "content_sanskrit": "विद्धः स रणमध्यस्थो रुधिरं प्रास्रवद् बहु ।\nउद्विग्ना मुक्तकेशास्ते भग्नदर्पाः पराजिताः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006520021, "chapter_id": 26520, "verse_number": "३-५९-२२", "content_sanskrit": "श्वसन्तो दुद्रुवुः सर्वे भयाद् वै वृषपर्वणः ।\nअन्योन्यं प्रममन्थुस्ते त्रासिता वृषपर्वणा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006520022, "chapter_id": 26520, "verse_number": "३-५९-२३", "content_sanskrit": "पृष्ठवक्त्राः सुसंविग्नाः प्रेक्षमाणा मुहुर्मुहुः ।\nत्यक्तप्रहरणाः सर्वे कृतास्ते वृषपर्वणा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006520023, "chapter_id": 26520, "verse_number": "३-५९-२४", "content_sanskrit": "संग्रामे युद्धशौण्डेन तदा निष्कुम्भसैनिकाः ।\nतत्रैव तु महावीर्यः प्रह्लादः कालमाहवे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006520024, "chapter_id": 26520, "verse_number": "३-५९-२५", "content_sanskrit": "योधयामास रकाक्षो हिरण्यकशिपोः सुतः ।\nतस्य दानववीरस्य युद्धकाले जयक्रियाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006520025, "chapter_id": 26520, "verse_number": "३-५९-२६", "content_sanskrit": "चकार त्वरया युक्तो भार्गवो विजयावहाः ।\nहुताशनं तर्पयतो ब्राह्मणांश्च नमस्यतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006520026, "chapter_id": 26520, "verse_number": "३-५९-२७", "content_sanskrit": "आज्यगन्धप्रतिवहो मारुतः सुरभिर्ववौ ।\nस्रजश्च विविधाश्चित्रा जयार्थमभिमन्त्रिताः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006520027, "chapter_id": 26520, "verse_number": "३-५९-२८", "content_sanskrit": "प्रह्लादस्य शुभे मूर्धन्याबबन्धोशनाः स्वयम् ।\nकालेन सह संग्रामे प्रयुद्धस्य महात्मनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006520028, "chapter_id": 26520, "verse_number": "३-५९-२९", "content_sanskrit": "प्रह्लादस्यातिवीर्यस्य शान्ति चक्रे स भार्गवः ।\nदश शिष्यसहस्राणि भार्गवस्य महात्मनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006520029, "chapter_id": 26520, "verse_number": "३-५९-३०", "content_sanskrit": "यानि दानववीराणां जेपुः शान्तिमनुतमाम् ।\nअथवणमथो दिव्यं ब्रह्मसंस्तवचोदितम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006520030, "chapter_id": 26520, "verse_number": "३-५९-३१", "content_sanskrit": "ततः सर्वास्त्रविदुषः समरेष्वनिवर्तिनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006520031, "chapter_id": 26520, "verse_number": "३-५९-३२", "content_sanskrit": "विद्यया तपसा युक्ताः कृतस्वस्त्ययनक्रियाः ।\nधनुर्हस्ताः कवचिनो वेगेनाप्लुत्य दानवाः ।\nबलिमभ्यर्च्य राजानं प्रह्लादं पर्यवारयन् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006520032, "chapter_id": 26520, "verse_number": "३-५९-३३", "content_sanskrit": "आस्थाय परमं दिव्यं रथं पररथारुजम् ।\nनानाप्रहरणाकीर्णं सवज्रमिव पर्वतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006520033, "chapter_id": 26520, "verse_number": "३-५९-३४", "content_sanskrit": "तद् बभूव मुहूर्तेन क्ष्वेडितास्फोटिताकुलम् ।\nमेरोः शिखरमाकीर्णं द्यौरिवाम्बुधरागमे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006520034, "chapter_id": 26520, "verse_number": "३-५९-३५", "content_sanskrit": "स्रजः पद्मपलाशानामामुच्य सुविभूषिताः ।\nबान्धवान् सम्परित्यज्य निपतन्ति रणप्रियाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006520035, "chapter_id": 26520, "verse_number": "३-५९-३६", "content_sanskrit": "महायुधधरः श्रीमाञ्छुभचर्मधरः प्रभुः ।\nसतनुत्रशिरस्त्राणो धन्वी परमदुर्जयः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006520036, "chapter_id": 26520, "verse_number": "३-५९-३७", "content_sanskrit": "सिंहशार्दूलदर्पाणां गदतां किङ्किणीकिनाम् ।\nदैत्यानां च सहस्राणि प्रयान्त्यग्रे महारणे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006520037, "chapter_id": 26520, "verse_number": "३-५९-३८", "content_sanskrit": "सैन्यपक्षहितास्तस्य रथाः परमदुर्जयाः ।\nसप्ततिर्वै सहस्राणि गजास्तावन्त एव च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006520038, "chapter_id": 26520, "verse_number": "३-५९-३९", "content_sanskrit": "मध्ये व्यूहोदरस्थस्तु कालनेमिर्महासुरः ।\nधनुर्विस्फारयन् घोरं ननाद प्रजहास च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006520039, "chapter_id": 26520, "verse_number": "३-५९-४०", "content_sanskrit": "तस्मिञ्छतसहस्राणि पुरो यान्ति महाद्युतेः ।\nदानवानां बलवतां शक्रप्रतिमतेजसाम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006520040, "chapter_id": 26520, "verse_number": "३-५९-४१", "content_sanskrit": "स समं वर्तमानस्तु पक्षाभ्यां विस्तृतो महान् ।\nअभवद् दानवव्यूहो दुर्भेद्यः सर्वदैवतैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006520041, "chapter_id": 26520, "verse_number": "३-५९-४२", "content_sanskrit": "षष्टी रथसहस्राणि दानवानां धनुर्भृताम् ।\nनानाप्रहरणानां च परिमाणं न विद्यते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006520042, "chapter_id": 26520, "verse_number": "३-५९-४३", "content_sanskrit": "गदापरिघनिस्त्रिशैः शूलमुद्गरपट्टिशैः ।\nप्रगृहीतैर्व्यराजन्त दानवाः पर्वतोपमाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006520043, "chapter_id": 26520, "verse_number": "३-५९-४४", "content_sanskrit": "गर्जन्तो निनदन्तश्च विक्रोशन्तः पुनः पुनः ।\nअयुध्यन्त महावीर्याः समरेष्वनिवर्तिनः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006520044, "chapter_id": 26520, "verse_number": "३-५९-४५", "content_sanskrit": "तत्र तूर्यसहस्राणि भेरीशङ्खरवाणि च ।\nहयानां च गजानां च गर्जतामतिवेगिनाम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006520045, "chapter_id": 26520, "verse_number": "३-५९-४६", "content_sanskrit": "दुन्दुभीनां च निर्घोषः पर्जन्यनिनदोपमः ।\nशुश्रुवे शङ्खशब्दश्च पटहानां च निःस्वनः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006520046, "chapter_id": 26520, "verse_number": "३-५९-४७", "content_sanskrit": "तेन शङ्खनिनादेन भेरीतूर्यरवेण च ।\nनिर्घोषेण रथानां च क्रोशतीव नभस्तलम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006520047, "chapter_id": 26520, "verse_number": "३-५९-४८", "content_sanskrit": "सागरप्रतिमौघेन बलेन महता वृतः ।\nप्रह्लादोऽयुध्यत रणे कालान्तकयमोपमः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006520048, "chapter_id": 26520, "verse_number": "३-५९-४९", "content_sanskrit": "तस्य नादेन रौद्रेण घोरेणाप्रतिमौजसः ।\nविनेदुः सर्वभूतानि त्रैलोक्यनिकृतैः स्वनैः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006520049, "chapter_id": 26520, "verse_number": "३-५९-५०", "content_sanskrit": "अन्तरिक्षात् पपातोल्का वायुश्च परुषो ववौ ।\nवमन्त्यः पावकं घोरं शिवाश्चैव ववाशिरे ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006520050, "chapter_id": 26520, "verse_number": "३-५९-५१", "content_sanskrit": "प्रह्लादस्तु महावीर्यः प्रहसन् युद्धदुर्मदः ।\nउवाच वचनं श्रीमांस्तत्कालक्षममुत्तमम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006520051, "chapter_id": 26520, "verse_number": "३-५९-५२", "content_sanskrit": "अद्याहं दर्शयिष्यामि स्वबाहुबलमूर्जितम् ।\nअद्य मद्बाणनिहतान् देवान् द्रक्ष्यथ संयुगे ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006520052, "chapter_id": 26520, "verse_number": "३-५९-५३", "content_sanskrit": "बान्धवा निहता येषां त्रिदशैरिह संयुगे ।\nअद्य निर्वर्तयिष्यन्ति शत्रुमांसानि दानवाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006520053, "chapter_id": 26520, "verse_number": "३-५९-५४", "content_sanskrit": "इममद्य समुद्भूतं रेणुं समरमूर्धनि ।\nअहं तु शमयिष्यामि शत्रुशोणितविस्रवैः ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006520054, "chapter_id": 26520, "verse_number": "३-५९-५५", "content_sanskrit": "तिमिरौघहतार्कं तु सैन्यरेण्वरुणीकृतम् ।\nआकाशं सम्पतिष्यन्ति खद्योता इव मे शराः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006520055, "chapter_id": 26520, "verse_number": "३-५९-५६", "content_sanskrit": "हृष्टाः सम्परिमोदध्वं देवेभ्यस्त्यज्यतां भयम् ।\nअद्याहं निहनिष्यामि कालेन्द्रं धनुषा रणे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006520056, "chapter_id": 26520, "verse_number": "३-५९-५७", "content_sanskrit": "तोषयिष्यामि राजानं बलिं बलवतां वरम् ।\nत्रिदशान् सगणान् हत्वा रणे चान्तकमन्तिकात् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006520057, "chapter_id": 26520, "verse_number": "३-५९-५८", "content_sanskrit": "अक्षयाः सन्ति मे तूणाः शराश्चाशीविषोपमाः ।\nस्थातुं मे पुरतः शक्ताः के रणे जीवितेप्सवः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006520058, "chapter_id": 26520, "verse_number": "३-५९-५९", "content_sanskrit": "हत्वा रिपुगणांस्तुष्टिरनुरागश्च राजसु ।\nहतस्य त्रिदिवे वासो नास्ति युद्धसमा गतिः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006520059, "chapter_id": 26520, "verse_number": "३-५९-६०", "content_sanskrit": "तद् भयं पृष्ठतः कृत्वा रणे दानवसत्तमाः ।\nनिहत्येमानरीन् सर्वान् मोदध्वं नन्दने वने ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006520060, "chapter_id": 26520, "verse_number": "३-५९-६१", "content_sanskrit": "एवमुक्त्वा महत्सैन्यं प्रह्लादो दानवोत्तमः ।\nकालसैन्यं महारौद्रं तरसामर्दतासुरः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006520061, "chapter_id": 26520, "verse_number": "३-५९-६२", "content_sanskrit": "सर्वास्त्रविद्वान् वीरश्च नित्यं चाप्यपराजितः ।\nयुद्धे ह्यभिमुखो नित्यं स्वबाहुबलदर्पितः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006520062, "chapter_id": 26520, "verse_number": "३-५९-६३", "content_sanskrit": "षष्टिं रथसहस्राणि विविधायुधधारिणीम् ।\nप्रह्लादस्यातिवीर्यस्य ते तस्य तनया निजाः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006520063, "chapter_id": 26520, "verse_number": "३-५९-६४", "content_sanskrit": "तैस्तु क्रतुशतैरिष्टं विपुलैराप्तदक्षिणैः ।\nक्षान्ता धर्मपरा नित्यं सत्यव्रतपरायणाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006520064, "chapter_id": 26520, "verse_number": "३-५९-६५", "content_sanskrit": "दातारः प्रियवक्तारो वक्तारः शास्त्रवस्तुषु ।\nस्वदारनिरता दान्ता ब्रह्मण्याः सत्यसङ्गराः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006520065, "chapter_id": 26520, "verse_number": "३-५९-६६", "content_sanskrit": "यष्टारः क्रतुभिर्नित्यं नित्यं चाध्ययने रताः ।\nइष्वस्त्रकुशलाः सर्वे बहुशो दृढविक्रमाः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006520066, "chapter_id": 26520, "verse_number": "३-५९-६७", "content_sanskrit": "मत्तवारणविक्रान्ताः शत्रुसैन्यप्रमर्दकाः ।\nदारयन्तः पदाक्षेपैः सुघोरान् वातरेचकान् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006520067, "chapter_id": 26520, "verse_number": "३-५९-६८", "content_sanskrit": "युद्धोत्सुकधिया नित्यं क्रोधरञ्जितलोचनाः ।\nसंदष्टौष्ठपुटा दैत्या विनेदुर्भीमविक्रमाः ।\nक्ष्वेडितास्फोटितरवैरन्योन्यं समहर्षयन् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006520068, "chapter_id": 26520, "verse_number": "३-५९-६९", "content_sanskrit": "वेणुशङ्खरवैश्चैव सिंहनादैश्च पुष्कलैः ।\nआप्लुत्याप्लुत्य सहसा रणे वव्रुरनेकशः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006520069, "chapter_id": 26520, "verse_number": "३-५९-७०", "content_sanskrit": "तालमात्राणि चापानि विकृष्य सुमहाबलाः ।\nअमृष्यमाणाः सहसा दानवाश्चापपाणयः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006520070, "chapter_id": 26520, "verse_number": "३-५९-७१", "content_sanskrit": "सुरासुरैरप्यजितं योधयन्ति रणेऽन्तकम् ।\nप्रतप्तहेमाभरणाः सर्वे ते श्वेतवाससः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006520071, "chapter_id": 26520, "verse_number": "३-५९-७२", "content_sanskrit": "दानवा मानिनः सर्वे सर्वे स्वर्गाभिकाङ्क्षिणः ।\nसर्वे जयैषिणो वीराः सर्वे शत्रुवधोद्यताः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006520072, "chapter_id": 26520, "verse_number": "३-५९-७३", "content_sanskrit": "शुशुभे सा चमूर्दीप्ता पताकाध्वजमालिनी ।\nगजाश्वरथसंबाधा स्वर्गमार्गाभिकाङ्क्षिणी ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006520073, "chapter_id": 26520, "verse_number": "३-५९-७४", "content_sanskrit": "ततः कालः सुनिर्यातो भीमो भीमपराक्रमः ।\nनिनदन् सुमहाकायो व्याधिभिर्बहुभिर्वृतः ॥७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006520074, "chapter_id": 26520, "verse_number": "३-५९-७५", "content_sanskrit": "ददर्श महतीं सेनां दानवानां बलीयसाम् ।\nअभिसंजातदर्पाणां कालं समभिगर्जताम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006520075, "chapter_id": 26520, "verse_number": "३-५९-७६", "content_sanskrit": "तदायान्तं तदानीकं दानवानां तरस्विनाम् ।\nप्रतिलोमं चकाराशु व्याधिभिः सहितोऽन्तकः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006520076, "chapter_id": 26520, "verse_number": "३-५९-७७", "content_sanskrit": "प्रविश्य ध्वजिनीं चैषां पातयामास दानवान् ।\nकालो रुधिररक्ताक्षः स्वेनानीकेन संवृतः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006520077, "chapter_id": 26520, "verse_number": "३-५९-७८", "content_sanskrit": "प्रह्लादबलमत्युग्रं प्रह्लादं च महाबलम् ।\nआजघान रणे कालो दण्डमुद्गरपट्टिशैः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006520078, "chapter_id": 26520, "verse_number": "३-५९-७९", "content_sanskrit": "शरशक्त्यृष्टिखड्गांश्च शूलानि मुसलानि च ।\nगदाश्च परिघाश्चैव विचित्राश्च परश्वधाः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006520079, "chapter_id": 26520, "verse_number": "३-५९-८०", "content_sanskrit": "धनूंषि च विचित्राणि शतघ्नीश्च स्थिरायसीः ।\nपात्यन्ते व्याधिभिर्युद्धे दानवानां चमूमुखे ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006520080, "chapter_id": 26520, "verse_number": "३-५९-८१", "content_sanskrit": "बहवो व्याधयो युद्धे बहूनसुरपुङ्गवान् ।\nव्याधीनपि च दैत्यौघा निजघ्नुर्बहवो बहून् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006520081, "chapter_id": 26520, "verse_number": "३-५९-८२", "content_sanskrit": "शूलैः प्रमथिताः केचित् केचिच्छिन्नाः परश्वधैः ।\nपरिघैराहताः केचित् केचिच्च परमायुधैः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006520082, "chapter_id": 26520, "verse_number": "३-५९-८३", "content_sanskrit": "केचिद् द्विधा कृताः खड्गैः स्फुरन्तः पतिता भुवि ।\nव्याधयो दानवैरेव नानाशस्त्रैर्विदारिताः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006520083, "chapter_id": 26520, "verse_number": "३-५९-८४", "content_sanskrit": "ते चापि व्याधिभिः सर्वे विविधैरायुधोत्तमैः ।\nखड्गैश्च मुसलैस्तीक्ष्णैः प्रासतोमरमुद्गरैः ।\nभिन्नाश्च दानवाः सर्वे निकृत्ताश्च परश्वधैः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006520084, "chapter_id": 26520, "verse_number": "३-५९-८५", "content_sanskrit": "मुद्गरैः पट्टिशैश्चैव व्याधिभिश्च महाबलैः ।\nकृत्वा शस्त्रैरनेकैश्च मुष्टिभिश्च हता भृशम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006520085, "chapter_id": 26520, "verse_number": "३-५९-८६", "content_sanskrit": "वेमुः शोणितमन्योन्यं विष्टब्धदशनेक्षणाः ।\nआर्तस्वरं च नदतां सिंहनादं च गर्जताम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006520086, "chapter_id": 26520, "verse_number": "३-५९-८७", "content_sanskrit": "बभूव तुमुलः शब्दः संग्रामे लोमहर्षणे ।\nमुष्टिभिश्चोत्तमाङ्गानि तलैर्गात्राणि चासकृत् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006520087, "chapter_id": 26520, "verse_number": "३-५९-८८", "content_sanskrit": "सादितानि महीं जग्मुस्तिष्ठतामेव संयुगे ।\nअस्त्रफेना ध्वजावर्ता च्छिन्नबाहुमहोरगा ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006520088, "chapter_id": 26520, "verse_number": "३-५९-८९", "content_sanskrit": "शूलशक्तिमहामत्स्या चापग्राहसमाकुला ।\nरथेषोपलसम्बाधा ध्वजदुमलतावृता ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006520089, "chapter_id": 26520, "verse_number": "३-५९-९०", "content_sanskrit": "सशब्दघोषविस्तारा लोहितोदाभवन्नदी ।\nस्वधनुःशक्रधनुषौ काञ्चनाङ्गदविद्युतौ ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006520090, "chapter_id": 26520, "verse_number": "३-५९-९१", "content_sanskrit": "तौ दैत्यकालजलदौ शरधारां व्यमुञ्चताम् ।\nतौ महामेघसंकाशौ रथनागगतौ तदा ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006520091, "chapter_id": 26520, "verse_number": "३-५९-९२", "content_sanskrit": "बभूवतुरभिक्रुद्धौ साम्बुगर्भाविवाम्बुदौ ।\nतप्तकाञ्चनसंनाहौ दिव्यहारविभूषितौ ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006520092, "chapter_id": 26520, "verse_number": "३-५९-९३", "content_sanskrit": "तौ विरेजतुरायस्तौ सूर्यवैश्वानरोपमौ ।\nतौ महाबलसंकाशावन्योन्यस्य चमूमुखे ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006520093, "chapter_id": 26520, "verse_number": "३-५९-९४", "content_sanskrit": "शक्राशनिसमस्पर्शैर्बाणैर्जघ्नतुराहवे ।\nपरस्परं समासाद्य तयोर्युधि दुरासदे ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006520094, "chapter_id": 26520, "verse_number": "३-५९-९५", "content_sanskrit": "नाशंसन्त तदा योधा जीवितान्यपि संयुगे ।\nशरैर्विभिन्नसर्वाङ्गा युधि प्रक्षीणबान्धवाः ।\nनिपेतुर्योधमुख्यास्तु रुधिरोक्षितवक्षसः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006520095, "chapter_id": 26520, "verse_number": "३-५९-९६", "content_sanskrit": "पतितैर्निष्पतद्भिश्च पात्यमानैश्च संयुगे ।\nबभूव भूः समाकीर्णा योधैरुद्गतजीवितैः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006520096, "chapter_id": 26520, "verse_number": "३-५९-९७", "content_sanskrit": "संगृह्णतोः शरान् घोरान्न च संदधतोस्तयोः ।\nअन्तरं ददृशे कश्चित् प्रयत्नादपि संयुगे ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006520097, "chapter_id": 26520, "verse_number": "३-५९-९८", "content_sanskrit": "लघुत्वाच्च महाबाहू युद्धशौण्डौ महाबलौ ।\nमण्डलीभूतधनुषौ सकृदेव बभूवतुः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006520098, "chapter_id": 26520, "verse_number": "३-५९-९९", "content_sanskrit": "प्रह्लादस्य च बाणौघैर्दुद्रावान्तकवाहिनी ।\nउह्यमानं बलवता वायुनेवाभ्रमण्डलम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006520099, "chapter_id": 26520, "verse_number": "३-५९-१००", "content_sanskrit": "हतदर्पं तु विज्ञाय प्रह्लादः कालमाहवे ।\nअपयातं च समरे द्विषन्तं सम्प्रतर्क्य तम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006520100, "chapter_id": 26520, "verse_number": "३-५९-१०१", "content_sanskrit": "मत्वा वशगतं चैव प्रह्लादो युद्धदुर्मदः ।\nतत्रैवान्यां चमूं भूयः सम्ममर्द महासुरः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006520101, "chapter_id": 26520, "verse_number": "३-५९-१०२", "content_sanskrit": "कालप्रह्लादयोर्युद्धमभवद् यादृशं पुरा ।\nतादृशं सर्वलोकेषु न भूतं न भविष्यति ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006520102, "chapter_id": 26520, "verse_number": "३-५९-१०३", "content_sanskrit": "एवमद्भुतवीर्यौजा महारणकृतव्रणः ।\nप्रह्लादस्त्वथ वृद्धोऽत्र कालस्त्वपसृतो रणात्॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}]