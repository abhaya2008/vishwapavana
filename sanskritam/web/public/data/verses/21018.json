, "content_sanskrit": "कपटवेषधारणमेव महत्त्वहेतुः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001018092, "chapter_id": 21018, "verse_number": "४-२४-९३", "content_sanskrit": "इत्येवमनेकदोषोत्तरे तु भूमंडले सर्ववर्णेष्वेव योयो बलवान्सस भूपतिर्भविष्यति ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001018093, "chapter_id": 21018, "verse_number": "४-२४-९४", "content_sanskrit": "एवं चातिलुब्धकराजासहाश्शैलानामंतरद्रो णीः प्रजास्संश्रयिष्यंति ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001018094, "chapter_id": 21018, "verse_number": "४-२४-९५", "content_sanskrit": "मधुशाकमूलफलपत्रपुष्पाद्याहाराश्च भविष्यंति ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001018095, "chapter_id": 21018, "verse_number": "४-२४-९६", "content_sanskrit": "तरुवल्कलपर्णचीरप्रावरणाश्चातिबहुप्रजाश्शीतवातातपवर्षसहाश्च भविष्यंति ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001018096, "chapter_id": 21018, "verse_number": "४-२४-९७", "content_sanskrit": "न च कश्चित्त्रयोविंशतिवर्षाणि जीविष्यति अनवरतं चात्र कलियुगे क्षयमायात्यखिल एवैष जनः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001018097, "chapter_id": 21018, "verse_number": "४-२४-९८", "content_sanskrit": "श्रौतस्मार्त्ते च धर्मे विप्लवमत्यंतमुपगते क्षीणप्राये च कलावश्षोजगत्स्रष्टुश्चराचरगुरोरादिमध्यांतरहितस्य ब्रह्ममयस्यात्मरूपिणो भगवतो वासुदेवस्यांशश्शंबलग्रामप्रधानब्राह्मणस्य विष्णुयशसो गृहेष्टगुणर्द्धिसमन्वितः कल्किरूपीजगत्यत्रावतीर्य सकलम्लेच्छदस्युदुष्टाचरणचेतसामश्षोआ!णामपरिच्छिन्नशक्तिमाहा-त्म्यः क्षयं करिष्यति स्वधर्मेषु चाखिलमेव संस्थापयिष्यति ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001018098, "chapter_id": 21018, "verse_number": "४-२४-९९", "content_sanskrit": "अनंतरं चाश्षोकलेरवसाने निशावसाने विबुद्धानामिव तेषामेव जनपदानाममलस्फटिकदलशुद्धा मतयो भविष्यंति ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001018099, "chapter_id": 21018, "verse_number": "४-२४-१००", "content_sanskrit": "तेषां च बीजभूतानामश्षोमनुष्याणां परिणतानामपि तत्कालकृतापत्यप्रसूतिर्भविष्यति ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001018100, "chapter_id": 21018, "verse_number": "४-२४-१०१", "content_sanskrit": "तानि च तदपत्यानि कृतयुगानुसारीण्येव भविष्यंति ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001018101, "chapter_id": 21018, "verse_number": "४-२४-१०२", "content_sanskrit": "अत्रोच्यते ।\nयथा चंद्र श्च सूर्यश्च तथा तिष्यो बृहस्पतिः ।\nएकराशौ समेष्यंति तदा भवति वै कृतम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001018102, "chapter_id": 21018, "verse_number": "४-२४-१०३", "content_sanskrit": "अतीता वर्त्तमानाश्च तथैवानागताश्च ये ।\nएते वंश्षोउ! भूपालाः कथिता मुनिसत्तम ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7001018103, "chapter_id": 21018, "verse_number": "४-२४-१०४", "content_sanskrit": "यावत्परीक्षितो जन्म यावन्नंदाभिषेचनम् ।\nएतद्वर्षसहस्रं तु ज्ञेयं पंचाशदुत्तरम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7001018104, "chapter_id": 21018, "verse_number": "४-२४-१०५", "content_sanskrit": "सप्तर्षीणां तु यौ पूर्वौ दृश्येते ह्युदितौ दिवि ।\nतयोस्तु मध्ये नक्षत्रं दृश्यते यत्समं निशि ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7001018105, "chapter_id": 21018, "verse_number": "४-२४-१०६", "content_sanskrit": "तेन सप्तर्षयो युक्तास्तिष्ठंत्यब्दशतं नृणाम् ।\nते तु पारीक्षिते काले मघास्वासन्द्विजोत्तम ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7001018106, "chapter_id": 21018, "verse_number": "४-२४-१०७", "content_sanskrit": "तदा प्रवृत्तश्च कलिर्द्वादशाब्दशतात्मकः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7001018107, "chapter_id": 21018, "verse_number": "४-२४-१०८", "content_sanskrit": "यदैव भगवान्विष्णोरंशो यातो दिवं द्विज ।\nवसुदेवकुलोद्भूतस्तदैवात्रागतः कलिः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7001018108, "chapter_id": 21018, "verse_number": "४-२४-१०९", "content_sanskrit": "यावत्सपादपद्माभ्यां पस्पर्शेमां वसुंधराम् ।\nतावत्पृथ्वीपरिष्वंगे समर्थो नाभवत्कलिः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7001018109, "chapter_id": 21018, "verse_number": "४-२४-११०", "content_sanskrit": "गते सनातनस्यांशो! विष्णोस्तत्र भुवो दिवम् ।\nतत्याज सानुजो राज्यं धर्म पुत्रो युधिष्ठिरः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7001018110, "chapter_id": 21018, "verse_number": "४-२४-१११", "content_sanskrit": "विपरीतानि दृष्ट्वा च निमित्तानि हि पांडवः ।\nयाते कृष्णे चकाराऽथ सोऽभिषेकं परीक्षितः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7001018111, "chapter_id": 21018, "verse_number": "४-२४-११२", "content_sanskrit": "प्रयास्यंति यदा चैते पूर्वाषाढां महर्षयः ।\nतदा नंदात्प्रभृत्येष गतिवृद्धिं गमिष्यति ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7001018112, "chapter_id": 21018, "verse_number": "४-२४-११३", "content_sanskrit": "यस्मिन् कृष्णो दिवं यातस्तस्मिन्नेव तदा हनि ।\nप्रतिपन्नं कलियुगं तस्य संख्यां निबोध मे ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7001018113, "chapter_id": 21018, "verse_number": "४-२४-११४", "content_sanskrit": "त्रीणि लक्षाणि वर्षाणां द्विज मानुष्यसंख्यया ।\nषष्टिश्चैव सहस्राणि भविष्यत्येष वै कलिः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7001018114, "chapter_id": 21018, "verse_number": "४-२४-११५", "content_sanskrit": "शतानि तानि दिव्यानां सप्त पंच च संख्यया ।\nनिश्श्षोए!ण गते तस्मिन्भविष्यति पुनः कृतम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7001018115, "chapter_id": 21018, "verse_number": "४-२४-११६", "content_sanskrit": "ब्राह्मणाः क्षत्त्रिया वैश्याश्शूद्रा श्च द्विजसत्तम ।\nयुगेयुगे महात्मानः समतीतास्सहस्रशः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7001018116, "chapter_id": 21018, "verse_number": "४-२४-११७", "content_sanskrit": "बहुत्वान्नामधेयानां परिसंख्या कुलेकुले ।\nपौनरुक्त्याद्धि साम्याच्च न मया परिकीर्त्तिता ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7001018117, "chapter_id": 21018, "verse_number": "४-२४-११८", "content_sanskrit": "देवापिः पौरवो राजा पुरुश्चेक्षाकुवंशजः ।\nमहायोगबलोपेतौ कलापग्रामसंश्रितौ ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7001018118, "chapter_id": 21018, "verse_number": "४-२४-११९", "content_sanskrit": "कृते युगे त्विहागम्य क्षत्रप्रावर्त्तकौ हि तौ ।\nभविष्यतो मनोर्वंशबीजभूतौ व्यवस्थितौ ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7001018119, "chapter_id": 21018, "verse_number": "४-२४-१२०", "content_sanskrit": "एतेन क्रमयोगेन मनुपुत्रैर्वसुंधरा ।\nकृतत्रेताद्वापराणि युगानि त्रीणि भुज्यते ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7001018120, "chapter_id": 21018, "verse_number": "४-२४-१२१", "content_sanskrit": "कलौ ते बीजभूता वै केचित्तिष्ठंति वै मुने ।\nयथैव देवापिपुरू सांप्रतं समधिष्ठितौ ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7001018121, "chapter_id": 21018, "verse_number": "४-२४-१२२", "content_sanskrit": "एष तूद्देशतो वंशस्तवोक्तो भूभुजां मया ।\nनिखिलो गदितुं शक्यो नैष वर्षशतैरपि ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7001018122, "chapter_id": 21018, "verse_number": "४-२४-१२३", "content_sanskrit": "एते चान्ये च भूपाला यैरत्र क्षितिमंडले ।\nकृतं ममत्वं मोहांधैर्नित्यं हेयकलेवरे ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7001018123, "chapter_id": 21018, "verse_number": "४-२४-१२४", "content_sanskrit": "कथं ममेयमचला मत्पुत्रस्य कथं मही ।\nमद्वंशस्येतिचिंतार्त्ता जग्मुरंतमिमे नृपाः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7001018124, "chapter_id": 21018, "verse_number": "४-२४-१२५", "content_sanskrit": "तेभ्यः पूर्वतराश्चान्ये तेभ्यस्तेभ्यस्तथा परे ।\nभविष्याश्चैव यास्यंति तेषामन्ये च येऽप्यनु ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7001018125, "chapter_id": 21018, "verse_number": "४-२४-१२६", "content_sanskrit": "विलोक्यात्मजयोद्योगं यात्राव्यग्रान्नराधिपान् ।\nपुष्पप्रहासैश्शरदि हसंतीव वसुंधरा ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7001018126, "chapter_id": 21018, "verse_number": "४-२४-१२७", "content_sanskrit": "मैत्रेय पृथिवीगीताञ्छ्लोकांश्चात्र निबोध मे ।\nयानाह धर्मध्वजिने नजकायासितो मुनिः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7001018127, "chapter_id": 21018, "verse_number": "४-२४-१२८", "content_sanskrit": "पृथिव्युवाच ।\nकथमेष नरेंद्रा णां मोहो बुद्धिमतामपि ।\nयेन केन सधर्माणोप्यतिविश्वस्तचेतसः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7001018128, "chapter_id": 21018, "verse_number": "४-२४-१२९", "content_sanskrit": "पूर्वमात्मजयं कृत्वा जेतुमिच्छंति मंत्रिणः ।\nततो भृत्यांश्च पौरांश्च जिगीषंते तथा रिपून् ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7001018129, "chapter_id": 21018, "verse_number": "४-२४-१३०", "content_sanskrit": "क्रमेणानेन जेष्यामो वयं पृथ्वीं ससागराम् ।\nइत्यासक्तधियो मृत्युं न पश्यंत्यविदूरगम् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7001018130, "chapter_id": 21018, "verse_number": "४-२४-१३१", "content_sanskrit": "समुद्रा वरणं याति भूमंडलमथो वशम् ।\nकियदात्मजयस्यैतन्मुक्तिरात्मजये फलम् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7001018131, "chapter_id": 21018, "verse_number": "४-२४-१३२", "content_sanskrit": "उत्सृज्य पूर्वजा याता यां नादाय गतः पिता ।\nतां मामतीव मूढत्वाज्जेतुमिच्छंति पार्थिवाः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7001018132, "chapter_id": 21018, "verse_number": "४-२४-१३३", "content_sanskrit": "मत्कृते पितृपुत्राणां भ्रातॄणां चापि विग्रहः ।\nजायतेत्यंतमोहेन ममत्वादृतचेतसाम् ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7001018133, "chapter_id": 21018, "verse_number": "४-२४-१३४", "content_sanskrit": "पृथ्वी ममेयं सकला ममैषा मदन्वयस्यापि च शाश्वतीयम् ।\nयोयो मृतेऽन्यत्र बभूव राजा कुबुद्धिरासीदिति तस्यतस्य ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7001018134, "chapter_id": 21018, "verse_number": "४-२४-१३५", "content_sanskrit": "दृष्ट्वा ममत्वादृतचित्तमेकं विहाय मां मृत्युवशं व्रजंतम् ।\nतस्यानुयस्तस्य कथं ममत्वं हृद्यास्पदं मत्प्रभवं करोति ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7001018135, "chapter_id": 21018, "verse_number": "४-२४-१३६", "content_sanskrit": "पृथ्वी ममैषाऽऽशु परित्यजैनां वदंति ये दूतमुखैस्स्वशत्रून् ।\nनराधिपास्तेषु ममातिहासः पुनश्च मूढेषु दयाऽभ्युपैति ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7001018136, "chapter_id": 21018, "verse_number": "४-२४-१३७", "content_sanskrit": "श्रीपराशर उवाच।\nइत्येते धरणीगीताश्श्लोका मैत्रेय यैश्श्रुताः ।\nममत्वं विलयं याति तपत्यर्के यथा हिमम् ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7001018137, "chapter_id": 21018, "verse_number": "४-२४-१३८", "content_sanskrit": "इत्येष कथितः सम्यङ्मनोर्वंशो मया तव ।\nयत्र स्थितिप्रवृत्तस्य विष्णोरंशांशका नृपाः ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7001018138, "chapter_id": 21018, "verse_number": "४-२४-१३९", "content_sanskrit": "शृणोति य इमं भक्त्या मनोर्वंशमनुक्रमात् ।\nतस्य पापमश्षॐ वै प्रणश्यत्यमलात्मनः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7001018139, "chapter_id": 21018, "verse_number": "४-२४-१४०", "content_sanskrit": "धनधान्यर्द्धिमतुलां प्राप्नोत्यव्याहतेंद्रि यः ।\nश्रुत्वैवमखिलं वंशं प्रशस्तं शशिसूर्ययोः ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7001018140, "chapter_id": 21018, "verse_number": "४-२४-१४१", "content_sanskrit": "इक्ष्वाकुजह्नुमांधातृसगराविक्षितान्रघून् ।\nययातिनहुषाद्यांश्च ज्ञात्वा निष्ठामुपागतान् ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7001018141, "chapter_id": 21018, "verse_number": "४-२४-१४२", "content_sanskrit": "महाबलान्महावीर्याननन्तधनसंचयान् ।\nकृतान्कालेन बलिना कथाश्षोआ!न्नराधिपान् ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7001018142, "chapter_id": 21018, "verse_number": "४-२४-१४३", "content_sanskrit": "श्रुत्वा न पुत्रदारादौ गृहक्षेत्रादिके तथा ।\nद्र व्यादौ वा कृतप्रज्ञो ममत्वं कुरुते नरः ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7001018143, "chapter_id": 21018, "verse_number": "४-२४-१४४", "content_sanskrit": "तप्तं तपो यैः पुरुषप्रवीरैरुद्वाहुभिर्वर्षगणाननेकान् ।\nइष्ट्वा सुयज्ञैर्बलिनोतिवीर्याः कृतानुकालेन कथावशेषाः ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7001018144, "chapter_id": 21018, "verse_number": "४-२४-१४५", "content_sanskrit": "पृथुस्समस्तान्विचचार लोकानव्याहतो यो विजितारिचक्रः ।\nस कालवाताभिहतः प्रणष्टः क्षिप्तं यथा शाल्मलितूलमग्नौ ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7001018145, "chapter_id": 21018, "verse_number": "४-२४-१४६", "content_sanskrit": "यः कार्त्तवीर्यो बुभुजे समस्तान्द्वीपान्समाक्रम्य हतारिचक्रः ।\nकथाप्रसंगेष्वभिधीयमानस्स एव संकल्पविकल्पहेतुः ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7001018146, "chapter_id": 21018, "verse_number": "४-२४-१४७", "content_sanskrit": "दशाननाविक्षतराघवाणामैश्वर्यमुद्भासितदिङ्मुखानाम् ।\nभस्मापि शिष्टं न कथं क्षणेन भ्रूभंगपातेन धिगंतकस्य ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7001018147, "chapter_id": 21018, "verse_number": "४-२४-१४८", "content_sanskrit": "कथाशरीरत्वमवाप यद्वै मांधातृनामा भुवि चक्रवर्त्ती ।\nश्रुत्वापि तत्को हि करोति साधुर्ममत्वमान्मन्यपि मंदचेताः ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7001018148, "chapter_id": 21018, "verse_number": "४-२४-१४९", "content_sanskrit": "भगीरथाद्यास्सगरं ककुत्स्थो दशननो राघवलक्ष्मणौ च ।\nयुधिष्ठिराद्याश्च बभूवुरेते सत्यं न मिथ्या क्व नु ते न विद्मः ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7001018149, "chapter_id": 21018, "verse_number": "४-२४-१५०", "content_sanskrit": "ये सांप्रतं ये च नृपा भविष्याः प्रोक्ता मया विप्रवरोग्रवीयाः ।\nएते तथाऽन्ये च तथाभिधेयाः सर्वे भविष्यंति यथैव पूर्वे ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7001018150, "chapter_id": 21018, "verse_number": "४-२४-१५१", "content_sanskrit": "एत द्विदित्वा न नरेण कार्यं ममत्वमात्मन्यपि पंडितेन ।\nतिष्ठंतु तावत्तनयात्मजायाः क्षेत्रादयो ये च शरीरिणोऽन्ये ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}]