[{"id": 2118292, "chapter_id": 3545, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2118293, "chapter_id": 3545, "verse_number": "१", "content_sanskrit": "शासनात् पुरुषेन्द्रस्य बलेन महता बली ।\nगिरौ रैवतके नित्यं बभूव विपृथुश्रवाः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2118294, "chapter_id": 3545, "verse_number": "२", "content_sanskrit": "प्रवासे वासुदेवस्य तस्मिन् हलधरोपमः ।\nसम्बभूव तदा गोप्ता पुरस्य पुरवर्धनः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2118295, "chapter_id": 3545, "verse_number": "३", "content_sanskrit": "प्राप्य पाण्डवनिर्याणं निर्ययौ विपृथुश्रवाः ।\nनिशम्य पुरनिर्घोषं स्वमनीकमचोदयत् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2118296, "chapter_id": 3545, "verse_number": "४", "content_sanskrit": "सोऽभिपत्य तदाऽध्वानं ददर्श पुरुषर्षभम् ।\nनिःसृतं द्वारकाद्वारादंशुमन्तमिवाम्बुदात् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2118297, "chapter_id": 3545, "verse_number": "५", "content_sanskrit": "सविद्युतमिवाम्भोदं प्रेक्ष्य बाणधनुर्धरम् ।\nपार्थमासाद्य योधानां विस्मयः समपद्यत \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2118298, "chapter_id": 3545, "verse_number": "६", "content_sanskrit": "उदीर्णरथनागाश्वमनीकमभिवीक्ष्य तत् ।\nउवाच परमप्रीता सुभद्रा भरतर्षभम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2118299, "chapter_id": 3545, "verse_number": "७", "content_sanskrit": "सङ्गृहीतुमभिप्रायो दीर्घकालकृतो मम ।\nयुध्यमानस्य सङ्ग्रामे रथं तव नरर्षभ \t॥ ७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2118300, "chapter_id": 3545, "verse_number": "८", "content_sanskrit": "ओजस्तेजोद्युतिबलैरजितस्य महात्मनः ।\nपार्थस्य वै सारथित्वे भवेथा इत्यशिक्षयत् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2118301, "chapter_id": 3545, "verse_number": "९", "content_sanskrit": "एवमुक्तः प्रियः प्रीतः प्रत्युवाच नरर्षभः ।\nचोदयाश्वानसंसक्तान् विशन्तु विपृथोर्बलम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2118302, "chapter_id": 3545, "verse_number": "१०", "content_sanskrit": "बहुभिर्युध्यमानस्य तावकानजिघांसतः ।\nपश्य बाहुबलं भद्रे शरान् विक्षिपतो मम \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2118303, "chapter_id": 3545, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2118304, "chapter_id": 3545, "verse_number": "११", "content_sanskrit": "एवमुक्ता तदा भद्रा पार्थेन भरतर्षभ ।\nचुचोद चाश्वान् विस्रब्धा ततस्ते विविशुर्बलम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2118305, "chapter_id": 3545, "verse_number": "१२", "content_sanskrit": "तदाहतमहावाद्यं समुदग्रध्वजायुधम् ।\nअनीकं विपृथोर्हृष्टं पार्थमेवान्ववर्तत \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2118306, "chapter_id": 3545, "verse_number": "१३", "content_sanskrit": "रथैर्बहुविधैर्हृष्टा सदश्वैश्च महाजवैः ।\nकिरन्तः शरवर्षाणि परिवव्रुर्धनञ्जयम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2118307, "chapter_id": 3545, "verse_number": "१४", "content_sanskrit": "तेषामस्त्राणि संवार्य दिव्यैरस्त्रैर्महास्त्रवित् ।\nआवृणोन्महदाकाशं शरैः परपुरञ्जयः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2118308, "chapter_id": 3545, "verse_number": "१५", "content_sanskrit": "तेषां बाणान् महाबाहुर्विसृष्टान् सन्धितानपि ।\nचिच्छेद निशितैर्बाणैः शरासींश्च धनूंषि च \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2118309, "chapter_id": 3545, "verse_number": "१६", "content_sanskrit": "युगानीषा रथादींश्च यन्त्राणि विविधानि च ।\nअजिघांसुश्चरन् पार्थश्चिच्छेद निशितैः शरैः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2118310, "chapter_id": 3545, "verse_number": "१७", "content_sanskrit": "निर्धनुष्कान् विकवचान् विरथांश्च महारथान् ।\nकृत्वा पार्थः प्रियां प्रीतः प्रेक्ष्यतामित्यदर्शयत् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2118311, "chapter_id": 3545, "verse_number": "१८", "content_sanskrit": "सा दृष्ट्वा महदाश्चर्यं सुभद्रा पार्थमब्रवीत् ।\nअवाप्तार्थाऽस्मि भद्रं ते याहि पार्थ यथासुखम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2118312, "chapter_id": 3545, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2118313, "chapter_id": 3545, "verse_number": "१९", "content_sanskrit": "संसक्तं पाण्डुपुत्रेण समीक्ष्य विपृथुर्बलम् ।\nत्वरमाणोऽभिनिष्क्रम्य स्थीयतामित्यभाषत \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2118314, "chapter_id": 3545, "verse_number": "२०", "content_sanskrit": "तत्तु सेनापतेर्वाक्यं नात्यवर्तन्त यादवाः ।\nसागरे मारुतोद्धूता वेलामिव महोर्मयः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2118315, "chapter_id": 3545, "verse_number": "२१", "content_sanskrit": "ततो रथवरात् तूर्णमवरुह्य नरर्षभः ।\nअभिगम्य नरव्याघ्रं प्रहृष्टः परिषस्वजे \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2118316, "chapter_id": 3545, "verse_number": "२२", "content_sanskrit": "सोऽब्रवीत् पार्थमासाद्य दीर्घकालमिदं तव ।\nनिवासमभिजानामि शङ्खचक्रगदाधरात् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2118317, "chapter_id": 3545, "verse_number": "२३", "content_sanskrit": "न चास्त्यविदितं किञ्चिद् यद्यदाचरितं त्वया ।\nसुभद्रासम्प्रयोगेण प्रीतस्तव जनार्दनः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2118318, "chapter_id": 3545, "verse_number": "२४", "content_sanskrit": "प्राप्तस्य यतिलिङ्गेन द्वारकां तु धनञ्जय ।\nविसृष्टा सर्ववृष्णीनामृषभेण च सोदरा \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2118319, "chapter_id": 3545, "verse_number": "२५", "content_sanskrit": "त्वमिमां वीर दाशार्हीं शचीमिव शचीपतिः ।\nभक्तां गुणवतीं भद्रां सदा सत्कर्तुमर्हसि \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2118320, "chapter_id": 3545, "verse_number": "२६", "content_sanskrit": "बन्धुर्भव सुभद्राया गतिश्च त्वं धनञ्जय ।\nबन्धुमानसि रामेण महेन्द्रावरजेन च \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2118321, "chapter_id": 3545, "verse_number": "२७", "content_sanskrit": "मामेव हि सदाऽकार्षीन्मन्त्रिणं मधुसूदनः ।\nअन्तरेण सुभद्रां च त्वां च वक्तुं धनञ्जय \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2118322, "chapter_id": 3545, "verse_number": "२८", "content_sanskrit": "इमं रथवरं दिव्यं सर्वशस्त्रसमन्वितम् ।\nइदमेवानुयात्रं च निर्दिश्य गदपूर्वजः \t॥ २८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2118323, "chapter_id": 3545, "verse_number": "२९", "content_sanskrit": "अन्तर्द्वीपं तदा वीर यातो वृष्णिसुखावहः ।\nदीर्घकालावरुद्धं त्वां सम्प्राप्तं प्रियया सह \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2118324, "chapter_id": 3545, "verse_number": "३०", "content_sanskrit": "पश्यन्तु भ्रातरस्तत्र वज्रपाणिमिवामराः ।\nआगते तु दशार्हाणामृषभे शार्ङ्गघन्वनि \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2118325, "chapter_id": 3545, "verse_number": "३१", "content_sanskrit": "भद्रामनुगमिष्यन्ति रत्नानि च वसूनि च ।\nअरिष्टं गच्छ पन्थानं सुखी भव धनञ्जय \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2118326, "chapter_id": 3545, "verse_number": "३२", "content_sanskrit": "नष्टशोकैर्विशोकस्य सुहृद्भिः सङ्गमोऽस्तु ते ।\nततो विपृथुमामन्त्र्य पार्थः प्रीतोऽभिवाद्य च \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2118327, "chapter_id": 3545, "verse_number": "३३", "content_sanskrit": "कृष्णस्य मतमास्थाय कृष्णस्य रथमास्थितः ।\nपूर्वमेव तु पार्थाय कृष्णेन विनियोजितम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2118328, "chapter_id": 3545, "verse_number": "३४", "content_sanskrit": "सर्वरत्नसुसम्पूर्णं सर्वभोगसमन्वितम् ।\nरथेन काञ्चनाङ्गेन कल्पितेन यथाविधि\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2118329, "chapter_id": 3545, "verse_number": "३५", "content_sanskrit": "शैब्यसुग्रीवयुक्तेन किङ्किणीजालमालिना ।\nसर्वशस्त्रोपपन्नेन जीमूतरवनादिना \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2118330, "chapter_id": 3545, "verse_number": "३६", "content_sanskrit": "ज्वलिताग्निप्रकाशेन द्विषतां हर्षघातिना ।\nसन्नद्धः कवची खङ्गी बद्धगोधाङ्गुलित्रवान् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2118331, "chapter_id": 3545, "verse_number": "३७", "content_sanskrit": "गुप्तः सेनानुयात्रेण रथमारोप्य माधवीम् ।\nरथेनाकाशगेनेव प्रययौ स्वपुरं प्रति \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2118332, "chapter_id": 3545, "verse_number": "३८", "content_sanskrit": "ह्रियमाणां तु तां दृष्ट्वा सुभद्रां सैनिको जनः ।\nव्याक्रोशत् प्राद्रवत् सर्वो द्वारकामभितः पुरीम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2118333, "chapter_id": 3545, "verse_number": "३९", "content_sanskrit": "ते समासाद्य सहिताः सुधर्मामभितः पुरीम् ।\nसभापालस्य तत् सर्वमाचख्युः पार्थविक्रमम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2118334, "chapter_id": 3545, "verse_number": "४०", "content_sanskrit": "तेषां श्रुत्वा सभापालो भेरीं सन्नाहयत् तदा ।\nसमाजघ्ने महाघोषां जाम्बूनदपरिष्कृताम् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2118335, "chapter_id": 3545, "verse_number": "४१", "content_sanskrit": "क्षोभितास्तेन शब्देन भोजवृष्ण्यन्धकास्तदा ।\nअन्तर्द्वीपात् समुत्पेतुः सहसा सहितास्तदा \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2118336, "chapter_id": 3545, "verse_number": "४२", "content_sanskrit": "अन्नपानमपाहाय समापेतुः समन्ततः ।\nततो जाम्बूनदाङ्गानि परार्घ्यास्तरणानि च \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2118337, "chapter_id": 3545, "verse_number": "४३", "content_sanskrit": "मणिविद्रुमचित्राणि ज्वलिताग्निप्रभाणि च ।\nभेजिरे पुरुषव्याघ्रा वृष्ण्यन्धकमहारथाः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2118338, "chapter_id": 3545, "verse_number": "४४", "content_sanskrit": "सिंहासनानि शतशो धिष्ण्यानीव हुताशनाः ।\nतेषां समुपविष्टानां देवानामुपसङ्गमे \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2118339, "chapter_id": 3545, "verse_number": "४५", "content_sanskrit": "आचख्यौ चेष्टितं जिष्णोः सभापालः सहानुगः ।\nतच्छ्रुत्वा वृष्णिवीरास्ते मदरक्तान्तलोचनाः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2118340, "chapter_id": 3545, "verse_number": "४६", "content_sanskrit": "अमृष्यमाणाः पार्थस्य समुत्पेतुर्महाबलाः ।\nयोजयित्वा रथानाशु नागानश्वांस्तथैव च \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2118341, "chapter_id": 3545, "verse_number": "४७", "content_sanskrit": "कवचानाहरन् क्षिप्रं प्रासानाहरतेति च ।\nधनूंषि च महार्हाणि कवचानि बृहन्ति च \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2118342, "chapter_id": 3545, "verse_number": "४८", "content_sanskrit": "सूतान् विचुक्रुशुः केचिद् रथान् योजयतेति च ।\nस्वयं च तुरगान् केचित् निन्युर्हेमविभूषितान् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2118343, "chapter_id": 3545, "verse_number": "४९", "content_sanskrit": "रथेष्वानीयमानेषु कवचेषु ध्वजेषु च ।\nअभिक्रन्दो नृवीराणां तदासीत् तुमुलो महान्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2118344, "chapter_id": 3545, "verse_number": "५०", "content_sanskrit": "वनमाली ततः क्षीबः कैलासशिखरोपमः ।\nनीलवासा मदोत्सिक्त इदं वचनमब्रवीत् \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2118345, "chapter_id": 3545, "verse_number": "५१", "content_sanskrit": "किमिदं चाकृतप्रज्ञास्तूष्णीम्भूते जनार्दने ।\nअस्य भावमविज्ञाय सङ्क्रुद्धा मोघगर्जिताः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2118346, "chapter_id": 3545, "verse_number": "५२", "content_sanskrit": "एष तावदभिप्रायमाख्यातु मम यद्धृदि ।\nयदस्य सूचितं कर्तुं तत् कुरुध्वमतन्द्रिताः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2118347, "chapter_id": 3545, "verse_number": "५३", "content_sanskrit": "ततस्ते वचनं श्रुत्वा ग्राह्यरूपं हलायुधात् ।\nतूष्णीम्भूतास्ततः सर्वे साधुसाध्विति चाब्रुवन्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2118348, "chapter_id": 3545, "verse_number": "५४", "content_sanskrit": "समा वाचो निशम्यैव बलदेवस्य धीमतः ।\nपुनरेव सभामध्ये सर्वे ते समुपाविशन् \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2118349, "chapter_id": 3545, "verse_number": "५५", "content_sanskrit": "ततोऽब्रवीत् कामपालो वासुदेवं परन्तपम् ।\nत्रैलोक्यनाथ भो कृष्ण भूतभव्यभविष्यवित् \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2118350, "chapter_id": 3545, "verse_number": "५६", "content_sanskrit": "किमुवाऽत्रोपविष्टोऽसि प्रेक्षमाणो जनाकुलम् ।\nसत्कृतस्त्वत्कृते पार्थः सर्वैरस्माभिरच्युत \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2118351, "chapter_id": 3545, "verse_number": "५७", "content_sanskrit": "न च सोऽर्हति तां पूजां दुर्बुद्धिः कुलपांसनः ।\nको हि तत्रैव भुक्त्वाऽन्नं भाजनं भेत्तुमर्हति \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2118352, "chapter_id": 3545, "verse_number": "५८", "content_sanskrit": "मन्यमानः कुले जातमात्मानं पुरुषः क्कचित् ।\nईत्समानश्च सम्बन्धं कृतपूर्वं च मानयन्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2118353, "chapter_id": 3545, "verse_number": "५९", "content_sanskrit": "को हि नाम भवेदर्थी साहसेन चरेद् बुधः ।\nसोऽवमत्य च नामास्मानवमत्य च केशवम् \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2118354, "chapter_id": 3545, "verse_number": "६०", "content_sanskrit": "प्रसह्य हृतवानद्य सुभद्रां मृत्युमात्मनः ।\nकथं हि शिरसो मध्ये कृतं तेन पदं मम \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2118355, "chapter_id": 3545, "verse_number": "६१", "content_sanskrit": "त्वया चेदभ्यनुज्ञातो मर्षयिष्यामि माधव ।\nन मर्षयिष्ये गोविन्द पादस्पर्शमिवोरगः \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2118356, "chapter_id": 3545, "verse_number": "६२", "content_sanskrit": "अद्य निष्कौरवामेकः करिष्यामि वसुन्धराम् ।\nन हि मे मर्षणीयोऽयमर्जुनस्य व्यतिक्रमः ।\nतमहं भ्रातृभिः सार्धं निहन्मि कुलपांसनम् \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2118357, "chapter_id": 3545, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2118358, "chapter_id": 3545, "verse_number": "६३", "content_sanskrit": "रौहिणेयं गर्जमानं मेघदुन्दुभिनिस्वनम् ।\nअन्वपद्यन्त ते सर्वे भोजवृष्ण्यन्धकास्तथा \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2118359, "chapter_id": 3545, "verse_number": "२२४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचतुर्विंशत्यधिकद्विशततमोऽध्यायः ॥२२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2118360, "chapter_id": 3545, "verse_number": "५", "content_sanskrit": "॥ इति सुभद्राहरणपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2118361, "chapter_id": 3545, "verse_number": "", "content_sanskrit": "॥ समाप्तं सुभद्राहरणपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]