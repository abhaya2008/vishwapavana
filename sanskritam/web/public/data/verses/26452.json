[{"id": 7006452000, "chapter_id": 26452, "verse_number": "२-११३-१", "content_sanskrit": "अर्जुन उवाच\nततः पर्वतजालानि सरितश्च वनानि च ।\nअपश्यं समतिक्रम्य सागरं वरुणालयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006452001, "chapter_id": 26452, "verse_number": "२-११३-२", "content_sanskrit": "ततोऽर्घ्यमुदधिः साक्षादुपनीय जनार्दनम् ।\nस प्राञ्जलिः समुत्थाय किंकरोमीति चाब्रवीत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006452002, "chapter_id": 26452, "verse_number": "२-११३-३", "content_sanskrit": "प्रतिगृह्य स तां पूजां तमुवाच जनार्दनः ।\nरथपन्थानमिच्छामि त्वया दत्तं नदीपते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006452003, "chapter_id": 26452, "verse_number": "२-११३-४", "content_sanskrit": "अथाब्रवीत् समुद्रस्तु प्राञ्जलिर्गरुडध्वजम् ।\nप्रसीद भगवन् नैवमन्योऽप्येवं गमिष्यति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006452004, "chapter_id": 26452, "verse_number": "२-११३-५", "content_sanskrit": "त्वयैव स्थापितः पूर्वमगाधोऽस्मि जनार्दन ।\nत्वया प्रवर्तिते मार्गे यास्यामि गमनायताम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006452005, "chapter_id": 26452, "verse_number": "२-११३-६", "content_sanskrit": "अन्येऽप्येवं गमिष्यन्ति राजानो दर्पमोहिताः ।\nएवं संचिन्त्य गोविन्द यत् क्षमं तत् समाचर ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006452006, "chapter_id": 26452, "verse_number": "२-११३-७", "content_sanskrit": "वासुदेव उवाच\nब्राह्मणार्थं मदर्थ च कुरु सागर मद्वचः ।\nमदृते  न पुमान् कश्चिदन्यस्त्वां धर्षयिष्यति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006452007, "chapter_id": 26452, "verse_number": "२-११३-८", "content_sanskrit": "अथाब्रवीत् समुद्रस्तु पुनरेव जनार्दनम् ।\nअभिशापभयाद् भीतो बाढमेवं भविष्यति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006452008, "chapter_id": 26452, "verse_number": "२-११३-९", "content_sanskrit": "शोषयाम्येष मार्गं ते येन त्वं कृष्ण यास्यसि ।\nरथेन सह सूतेन सध्वजेन तु केशव ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006452009, "chapter_id": 26452, "verse_number": "२-११३-१०", "content_sanskrit": "वासुदेव उवाच\nमया दत्तो वरः पूर्वं न शोषं यास्यसीति ह ।\nमानुषास्ते न जानीयुर्विविधान् रत्नसंचयान ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006452010, "chapter_id": 26452, "verse_number": "२-११३-११", "content_sanskrit": "जलं स्तम्भय साधो त्वं ततो यास्याम्यहं रथी ।\nन च कश्चित् प्रमाणं ते रत्नानां वेत्स्यते नरः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006452011, "chapter_id": 26452, "verse_number": "२-११३-१२", "content_sanskrit": "सागरेण तथेत्युक्ते प्रस्थिताः स्मो जलेन वै ।\nस्तम्भितेन पथा भूमौ मणिवर्णेन भास्वता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006452012, "chapter_id": 26452, "verse_number": "२-११३-१३", "content_sanskrit": "ततोऽर्णवं समुत्तीर्य कुरूनप्युत्तरान् वयम् ।\nक्षणेन समतिक्रान्ता गन्धमादनमेव च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006452013, "chapter_id": 26452, "verse_number": "२-११३-१४", "content_sanskrit": "ततस्तु पर्वताः सप्त केशवं समुपस्थिताः ।\nजयन्तो वैजयन्तश्च नीलो रजतपर्वतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006452014, "chapter_id": 26452, "verse_number": "२-११३-१५", "content_sanskrit": "महामेरुः सकैलास इन्द्रकूटश्च नामतः ।\nबिभ्राणा वर्णरूपाणि विविधान्यद्भुतानि च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006452015, "chapter_id": 26452, "verse_number": "२-११३-१६", "content_sanskrit": "उपस्थाय च गोविन्दं किं कुर्मेत्यब्रुवंस्तदा ।\nतांश्चैव प्रतिजग्राह विधिवन्मधुसूदनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006452016, "chapter_id": 26452, "verse_number": "२-११३-१७", "content_sanskrit": "तानुवाच हृषीकेशः प्रणामावनतान् स्थितान् ।\nविवरं गच्छतो मेऽद्य रथमार्गः प्रदीयताम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006452017, "chapter_id": 26452, "verse_number": "२-११३-१८", "content_sanskrit": "ते कृष्णस्य वचः श्रुत्वा प्रतिगृह्य च पर्वताः ।\nप्रददुः कामतो मार्गं गच्छतो भरतर्षभ ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006452018, "chapter_id": 26452, "verse_number": "२-११३-१९", "content_sanskrit": "तत्रैवान्तर्हिताः सर्वे तदाश्चर्यतरं मम ।\nअसक्तं च रथो याति मेघज्ञालेष्विवांशुमान् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006452019, "chapter_id": 26452, "verse_number": "२-११३-२०", "content_sanskrit": "सप्त द्वीपान् ससिन्धुश्च सप्त सप्त गिरीनथ ।\nलोकालोकं तथातीत्य विवेश सुमहत्तमः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006452020, "chapter_id": 26452, "verse_number": "२-११३-२१", "content_sanskrit": "ततः कदाचिद् दुःखेन रथमूहुस्तुरङ्गमाः ।\nपङ्कभूतं हि तिमिरं स्पर्शाद् विज्ञायते नृप ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006452021, "chapter_id": 26452, "verse_number": "२-११३-२२", "content_sanskrit": "अथ पर्वतभूतं तत् तिमिरं समपद्यत ।\nतदासाद्य महाराज निष्प्रयत्ना हयाः स्थिताः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006452022, "chapter_id": 26452, "verse_number": "२-११३-२३", "content_sanskrit": "ततश्चक्रेण गोविन्दः पाटयित्वा तमस्तदा ।\nआकाशं दर्शयामास रथपन्थानमुत्तमम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006452023, "chapter_id": 26452, "verse_number": "२-११३-२४", "content_sanskrit": "निष्क्रम्य तमसस्तस्मादाकाशे दर्शिते तदा ।\nभविष्यामीति संज्ञा मे भयं च विगतं मम ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006452024, "chapter_id": 26452, "verse_number": "२-११३-२५", "content_sanskrit": "ततस्तेजः प्रज्वलितमपश्यं तत् तदाम्बरे ।\nसर्वलोकं समाविश्य स्थितं पुरुषविग्रहम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006452025, "chapter_id": 26452, "verse_number": "२-११३-२६", "content_sanskrit": "तं प्रविष्टो हृषीकेशो दीप्तं तेजोनिधिं तदा ।\nरथ एव स्थितश्चाहं स च ब्राह्मणसत्तमः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006452026, "chapter_id": 26452, "verse_number": "२-११३-२७", "content_sanskrit": "स मुहूर्तात् ततः कृष्णो निश्चक्राम तदा प्रभुः ।\nचतुरो बालकान् गृह्य ब्राह्मणस्यात्मजांस्तदा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006452027, "chapter_id": 26452, "verse_number": "२-११३-२८", "content_sanskrit": "प्रददौ ब्राह्मणायाथ पुत्रान् सर्वाञ्जनार्दनः ।\nत्रयः पूर्वं हृता ये च सद्योजातश्च बालकः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006452028, "chapter_id": 26452, "verse_number": "२-११३-२९", "content_sanskrit": "प्रहृष्टो ब्राह्मणस्तत्र पुत्रान् दृष्ट्वा पुनः प्रभो ।\nअहं च परमप्रीतो विस्मितश्चाभवं तदा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006452029, "chapter_id": 26452, "verse_number": "२-११३-३०", "content_sanskrit": "ततो वयं पुनः सर्वे ब्राह्मणस्य च ते सुताः ।\nयथा गता निवृ्त्ताः स्म तथैव भरतर्षभ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006452030, "chapter_id": 26452, "verse_number": "२-११३-३१", "content_sanskrit": "ततः स्म द्वारकां प्राप्ताः क्षणेन नृपसत्तम् ।\nअसम्प्राप्तेऽर्धदिवसे विस्मितोऽहं पुनः पुनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006452031, "chapter_id": 26452, "verse_number": "२-११३-३२", "content_sanskrit": "सपुत्रं भोजयित्वा तु द्विजं कृष्णो महायशाः ।\nधनेन वर्धयित्वा च गृहं प्रास्थापयत् तदा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]