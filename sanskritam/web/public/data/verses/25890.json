[{"id": 7005890000, "chapter_id": 25890, "verse_number": "१-७३-१", "content_sanskrit": "सूत उवाच ।\nवैदूर्य्यपुष्परागाणां कर्केते भीष्मके वदे ।\nपरीक्षां ब्रह्मणा प्रोक्तां व्यासेन कथितां द्विजा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005890001, "chapter_id": 25890, "verse_number": "१-७३-२", "content_sanskrit": "कल्पान्तकालक्षुबिताम्बुराशेर्निर्ह्रादकल्पाद्दितिजस्य नादत्।\nवैदूर्य्यमुत्पन्नमनेकवर्णं शोभाभिरामद्युतिवर्णबीजम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005890002, "chapter_id": 25890, "verse_number": "१-७३-३", "content_sanskrit": "अविदूरे विदूरस्य गिरेरुत्तुङ्गरोधसः।\nकामभूतिकसीमानमनु तस्याकरो भवेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005890003, "chapter_id": 25890, "verse_number": "१-७३-४", "content_sanskrit": "तस्य नादसमुत्थत्वादाकरः सुमहागुणः।\nअभूदुत्तरीतो लोके लोकत्रयविभूषणः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005890004, "chapter_id": 25890, "verse_number": "१-७३-५", "content_sanskrit": "तस्यैव दानवपतेर्निनदानुरूपाः प्रवृट्पयोदवरदर्शित चारुरूपाः ।\nवैदूर्य्यरत्नमणयो विविधावभासस्तस्मात्स्फुलिङ्गनिवहा इव संबभूवुः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005890005, "chapter_id": 25890, "verse_number": "१-७३-६", "content_sanskrit": "पद्मरागमुपादाय मणिवर्णा हि ये क्षितौ ।\nसर्वांस्तान्वर्णशोभाभिर्वैदूर्य्यमनुगच्छति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005890006, "chapter_id": 25890, "verse_number": "१-७३-७", "content_sanskrit": "तेषां प्रधानं शिखिकण्ठनीलं यद्वा भवेद्वेणुदलप्रकाशम् ।\nचाषाग्रपक्षप्रतिमश्रियो ये न ते प्रशस्ता मणिशास्त्रविद्भिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005890007, "chapter_id": 25890, "verse_number": "१-७३-८", "content_sanskrit": "गुणवान्वैदूर्य्यमणिर्योजयति स्वामिनं परंभ (भो) ग्यैः।\nदोषैर्युक्तो दोषैस्तस्माद्यत्नात्परीक्षेत ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005890008, "chapter_id": 25890, "verse_number": "१-७३-९", "content_sanskrit": "गिरिकाचशिशुपालौ काच स्फटिकाश्च धूमनिर्भिननाः।\nवैदूर्य्यमणेरेते विजातयः सन्निभाः सन्ति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005890009, "chapter_id": 25890, "verse_number": "१-७३-१०", "content_sanskrit": "लिख्याभावात्काचं लघुभावाच्छैसुपालकं विद्यात् ।\nगिरिकाचसदीप्तित्वात्स्फटिकं वर्णोज्ज्वलत्वेन ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005890010, "chapter_id": 25890, "verse_number": "१-७३-११", "content_sanskrit": "यदिन्द्रनीलस्य महागुणस्य सुवर्णसंख्याकलितस्य मूल्यम् ।\nतदेव वैदूर्य्यमणेः प्रदिष्टं पलद्वयोन्मापि तगौरवस्य ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005890011, "chapter_id": 25890, "verse_number": "१-७३-१२", "content_sanskrit": "जात्यस्य सर्वेऽपि मणेस्तु यादृग्विजातयः सन्ति मनवर्णाः।\nतथापि नानाकरणानुमेयभेदप्रकारः परमः प्रदिष्टः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005890012, "chapter_id": 25890, "verse_number": "१-७३-१३", "content_sanskrit": "सुखोपलक्ष्यश्च सदा विचार्य्यो ह्ययं प्रभेदो विदुषा नरेण ।\nस्नेहप्रभेदो लघुता मृदुत्वं विजातिलिङ्गं खलु सार्वजन्यम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005890013, "chapter_id": 25890, "verse_number": "१-७३-१४", "content_sanskrit": "कुशलाकुशलैः प्रपूर्य्यमाणाः प्रतिबद्धाः प्रतिसत्क्रियाप्रयोगै।\nगुणदोषसमुद्भवं लभन्ते मणयोऽर्थोन्तरमूल्यमेव भिन्नाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005890014, "chapter_id": 25890, "verse_number": "१-७३-१५", "content_sanskrit": "क्रमशः समतीतवर्त्तमानाः प्रतिबद्धा मणिबन्धकेन यत्नात् ।\nयदि नाम भवन्ति दोषहीना मणयः षड्गुणमाप्नुवन्ति मूल्यम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005890015, "chapter_id": 25890, "verse_number": "१-७३-१६", "content_sanskrit": "आकरान्समतीतानामुदधेस्तीरसन्निधौ ।\nमूल्यमेतन्मणीनां तु न सर्वत्र महीतले ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005890016, "chapter_id": 25890, "verse_number": "१-७३-१७", "content_sanskrit": "सुवर्णो मनुना यस्तु प्रोक्तः षोडशमाषकः ।\nतस्य सप्ततितमो भागः संज्ञारूपं करिष्यति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005890017, "chapter_id": 25890, "verse_number": "१-७३-१८", "content_sanskrit": "शाणश्चतुर्माषमानो माषकः पंचकृष्णलः ।\nपलस्य दशमो भागो धरणः परिकीर्त्तितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005890018, "chapter_id": 25890, "verse_number": "१-७३-१९", "content_sanskrit": "इत्थं मणिविधिः प्रोक्तो रत्नानां मूल्यनिश्चये ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]