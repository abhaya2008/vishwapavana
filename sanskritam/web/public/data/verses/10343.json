[{"id": 6000343000, "chapter_id": 10343, "verse_number": null, "content_sanskrit": "अथ एकादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000343001, "chapter_id": 10343, "verse_number": null, "content_sanskrit": "शौनक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.001.m4a", "display_order": 2}, {"id": 6000343002, "chapter_id": 10343, "verse_number": "१२-११-१", "content_sanskrit": "शुको यदाह भगवान् विष्णुराताय पृच्छते।\nसौरे गणो मासि मासि नाना वसति सप्तकः॥ १२/११/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.002.m4a", "display_order": 3, "topics": [{"text": "सूर्यव्यूहवर्णनम्", "range": "१–२४"}]}, {"id": 6000343003, "chapter_id": 10343, "verse_number": "१२-११-२", "content_sanskrit": "तेषां नामानि कर्माणि नियुक्तानामधीश्वरैः।\nब्रूहि नः श्रद्धधानानां व्यूहं सूर्यात्मनो हरेः॥ १२/११/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.003.m4a", "display_order": 4}, {"id": 6000343004, "chapter_id": 10343, "verse_number": null, "content_sanskrit": "सूत उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.004.m4a", "display_order": 5}, {"id": 6000343005, "chapter_id": 10343, "verse_number": "१२-११-३", "content_sanskrit": "आनाद्यविद्यया विष्णोरात्मनः सर्वदेहिनाम्।\nनिर्मितो लोकतन्त्रोऽयं लोकेषु परिवर्तते॥ १२/११/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.005.m4a", "display_order": 6}, {"id": 6000343006, "chapter_id": 10343, "verse_number": "१२-११-४", "content_sanskrit": "एक एव हि लोकानां सूर्य आत्माऽऽदिकृद् हरिः।\nसर्ववेदक्रियामूलमृषिभिर्बहुधोदितः॥ १२/११/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.006.m4a", "display_order": 7}, {"id": 6000343007, "chapter_id": 10343, "verse_number": "१२-११-५", "content_sanskrit": "कालो देशः क्रिया कर्ता करणं कार्यमागमः।\nद्रव्यं फलमिति ब्रह्मन् नवधोक्तोऽजया हरिः॥ १२/११/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.007.m4a", "display_order": 8}, {"id": 6000343008, "chapter_id": 10343, "verse_number": "१२-११-६", "content_sanskrit": "मध्वादिषु द्वादशसु भगवान् कालरूपधृक्।\nलोकतन्त्राय चरति पृथग् द्वादशभिर्गुणैः॥ १२/११/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.008.m4a", "display_order": 9}, {"id": 6000343009, "chapter_id": 10343, "verse_number": "१२-११-७", "content_sanskrit": "धाता कृतस्थली हेतिर्वासुकी रथकृन्मुने।\nपुलस्त्यस्तुम्बुरुरिति मधुमासं नयन्त्यमी॥ १२/११/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.009.m4a", "display_order": 10}, {"id": 6000343010, "chapter_id": 10343, "verse_number": "१२-११-८", "content_sanskrit": "अर्यमा पुलहाऽथौजाः प्रहेतिः पुञ्जकस्थली।\nनारदः कच्छनीरश्च नयन्त्येते स्म माधवम्॥ १२/११/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.010.m4a", "display_order": 11}, {"id": 6000343011, "chapter_id": 10343, "verse_number": "१२-११-९", "content_sanskrit": "मित्रोऽत्रिः पौरुषेयोऽथ तक्षको मेनका हहाः।\nरथस्वन इति ह्येते शुक्रमासं नयन्त्यमी॥ १२/११/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.011.m4a", "display_order": 12}, {"id": 6000343012, "chapter_id": 10343, "verse_number": "१२-११-१०", "content_sanskrit": "वसिष्ठो वरुणो रम्भा सहजन्यस्तथा हुहूः।\nशुक्रश्चित्रस्वनश्चैव शुचिमासं नयन्त्यमी॥ १२/११/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.012.m4a", "display_order": 13}, {"id": 6000343013, "chapter_id": 10343, "verse_number": "१२-११-११", "content_sanskrit": "इन्द्रो विश्वावसुः श्रोता एलापत्रस्तथाङ्गिराः।\nप्रम्लोचा राक्षसः स्वर्यो नभोमासं नयन्त्यमी॥ १२/११/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.013.m4a", "display_order": 14}, {"id": 6000343014, "chapter_id": 10343, "verse_number": "१२-११-१२", "content_sanskrit": "विवस्वानुग्रसेनश्च व्याघ्र आसारणो भृगुः।\nअनुम्लोचा शङ्खपालो नभस्याख्यं नयन्त्यमी॥ १२/११/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.014.m4a", "display_order": 15}, {"id": 6000343015, "chapter_id": 10343, "verse_number": "१२-११-१३", "content_sanskrit": "पूषा धनञ्जयो वातः सुषेणः सुरुचिस्तथा।\nघृताची गौतमश्चेति तपोमासं नयन्त्यमी॥ १२/११/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.015.m4a", "display_order": 16}, {"id": 6000343016, "chapter_id": 10343, "verse_number": "१२-११-१४", "content_sanskrit": "ऋतुर्वर्चा भरद्वाजः पर्जन्यः सेनजित् तथा।\nविश्व ऐरावतश्चैव तपस्याख्यं नयन्त्यमी॥ १२/११/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.016.m4a", "display_order": 17}, {"id": 6000343017, "chapter_id": 10343, "verse_number": "१२-११-१५", "content_sanskrit": "अथांशुः कश्यपस्तार्क्ष्यो धृतसेनस्तथोर्वशी।\nविद्युच्छङ्कुर्महाशङ्खः सहोमासं नयन्त्यमी॥ १२/११/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.017.m4a", "display_order": 18}, {"id": 6000343018, "chapter_id": 10343, "verse_number": "१२-११-१६", "content_sanskrit": "भगः स्फूर्जोऽरिष्टनेमिरूर्ण आयुश्च पञ्चमः।\nकर्कोटकः पूर्वचित्तिः सहस्याख्यं नयन्त्यमी॥ १२/११/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.018.m4a", "display_order": 19}, {"id": 6000343019, "chapter_id": 10343, "verse_number": "१२-११-१७", "content_sanskrit": "त्वष्टा ऋचीकतनयः कम्बलश्च तिलोत्तमा।\nब्रह्मरातोऽथ शतजिद् धृतराष्ट्र इषम्भराः॥ १२/११/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.019.m4a", "display_order": 20}, {"id": 6000343020, "chapter_id": 10343, "verse_number": "१२-११-१८", "content_sanskrit": "विष्णुरश्वतरो रम्भा सूर्यवर्चोऽश्वसत्यकौ।\nविश्वामित्रमुखा एत ऊर्जमासं नयन्त्यमी॥ १२/११/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.020.m4a", "display_order": 21}, {"id": 6000343021, "chapter_id": 10343, "verse_number": "१२-११-१९", "content_sanskrit": "एता भगवतो विष्णोरादित्यस्य विभूतयः।\nस्मरतां सन्ध्ययोर्नॄणां हरन्त्यंहो दिनेदिने॥ १२/११/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.021.m4a", "display_order": 22}, {"id": 6000343022, "chapter_id": 10343, "verse_number": "१२-११-२०", "content_sanskrit": "द्वादशस्वपि मासेषु देवोऽसौ षड्भिरस्य वै।\nचरन् समन्तात् तनुते परत्रेह च सन्मतिम्॥ १२/११/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.022.m4a", "display_order": 23}, {"id": 6000343023, "chapter_id": 10343, "verse_number": "१२-११-२१", "content_sanskrit": "सामर्ग्यजुर्भिस्तल्लिङ्गैर्ऋषयः संस्तुवन्त्यमुम्।\nगन्धर्वाः सम्प्रगायन्ति नृत्यन्त्यप्सरसोऽग्रतः॥ १२/११/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.023.m4a", "display_order": 24}, {"id": 6000343024, "chapter_id": 10343, "verse_number": "१२-११-२२", "content_sanskrit": "उन्नह्यन्ति रथं नागा ग्रामण्यो रथयोजकाः।\nचोदयन्ति रथं पृष्ठे नैर्ऋता बलशालिनः॥ १२/११/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.024.m4a", "display_order": 25}, {"id": 6000343025, "chapter_id": 10343, "verse_number": "१२-११-२३", "content_sanskrit": "वालखिल्याः सहस्राणि षष्टिर्ब्रह्मर्षयोऽमलाः।\nपुरतोऽभिमुखं यान्ति स्तुवन्तः स्तुतिभिर्विभुम्॥ १२/११/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.025.m4a", "display_order": 26}, {"id": 6000343026, "chapter_id": 10343, "verse_number": "१२-११-२४", "content_sanskrit": "एवं ह्यनादिनिधनो भगवान् हरिरीश्वरः।\nकल्पे कल्पे स्वमात्मानं व्यूह्य लोकान् तपत्यजः॥ १२/११/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_011/BhP_12.011.026.m4a", "display_order": 27}, {"id": 6000343027, "chapter_id": 10343, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वादशस्कन्धे एकादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]