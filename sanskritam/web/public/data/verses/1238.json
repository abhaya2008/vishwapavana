[{"id": 2011598, "chapter_id": 1238, "verse_number": "१-२३९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011599, "chapter_id": 1238, "verse_number": "१-२३९-१", "content_sanskrit": "ततः कतिपयाहस्य तस्मिन्रैवतके गिरौ।\nवृष्ण्यन्धकानामभवदुत्सवो नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011600, "chapter_id": 1238, "verse_number": "१-२३९-२", "content_sanskrit": "तत्र दानं ददुर्वीरा ब्राह्मणेभ्यः सहस्रशः।\nभोजवृष्ण्यन्धकाश्चैव महे तस्य गिरेस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011601, "chapter_id": 1238, "verse_number": "१-२३९-३", "content_sanskrit": "प्रसादै रत्नचित्रैश्च गिरेस्तस्य समन्ततः।\nस देशः शोभितो राजन्कल्पवृक्षैश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011602, "chapter_id": 1238, "verse_number": "१-२३९-४", "content_sanskrit": "वादित्राणि च तत्रान्ये वादकाः समवादयन्।\nननृतुर्नर्तकाश्चैव जगुर्गेयानि गायनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011603, "chapter_id": 1238, "verse_number": "१-२३९-५", "content_sanskrit": "अलङ्कृताः कुमाराश्च वृष्णीनां सुमहौजसाम्।\nयानैर्हाटकचित्रैश्च चञ्चूर्यन्ते स्म सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011604, "chapter_id": 1238, "verse_number": "१-२३९-६", "content_sanskrit": "पौराश्च पादचारेण यानैरुच्चावचैस्तथा।\nसदाराः सानुयात्राश्च शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011605, "chapter_id": 1238, "verse_number": "१-२३९-७", "content_sanskrit": "ततो हलधरः क्षीबो रेवतीसहितः प्रभुः।\nअनुगम्यमानो गन्धर्वैरचरत्रत्र भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011606, "chapter_id": 1238, "verse_number": "१-२३९-८", "content_sanskrit": "तथैव राजा वृष्णीनामुग्रसेनः प्रतापवान्।\nअनुगीयमानो गन्धर्वैः स्त्रीसहस्रसहायवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011607, "chapter_id": 1238, "verse_number": "१-२३९-९", "content_sanskrit": "रौक्मिणेयश्च साम्बश्च क्षीबौ समरदुर्मदौ।\nदिव्यमाल्याम्बरधरौ विजह्वातेऽमराविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011608, "chapter_id": 1238, "verse_number": "१-२३९-१०", "content_sanskrit": "अक्रूरः सारणश्चैव गदो बभ्रुर्विदूरथः।\nनिशठश्चारुदेष्णश्च पृथुर्विपृथुरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011609, "chapter_id": 1238, "verse_number": "१-२३९-११", "content_sanskrit": "सत्यकः सात्यकिश्चैव भङ्गकारमहारवौ।\nहार्दिक्य उद्धवश्चैव ये चान्ये नानुकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011610, "chapter_id": 1238, "verse_number": "१-२३९-१२", "content_sanskrit": "एते परिवृताः स्त्रीभिर्गन्धर्वैश्च पृथक्पृथक्।\nतमुत्सवं रैवतके शोभयाञ्चक्रिरे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011611, "chapter_id": 1238, "verse_number": "१-२३९-१३", "content_sanskrit": "वासदेवो ययौ तत्र सह स्त्रीभिर्मुदान्वितः।\nदत्त्वा दानं द्विजातिभ्यः परिव्राजमपश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011612, "chapter_id": 1238, "verse_number": "१-२३९-१४", "content_sanskrit": "चित्रकौतूहले तस्मिन्वर्तमाने महाद्भुते।\nवासुदेवश्च पार्थश्च सहितौ परिजग्मतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011613, "chapter_id": 1238, "verse_number": "१-२३९-१५", "content_sanskrit": "तत्र चङ्क्रममाणौ तौ वसुदेवसुतां शुभाम्।\nअलङ्कृतां सखीमध्ये भद्रां ददृशतुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011614, "chapter_id": 1238, "verse_number": "१-२३९-१६", "content_sanskrit": "दृष्ट्वैव तामर्जुनस्य कन्दर्पः समजायत।\nतं तदैकाग्रमनसं कृष्णः पार्थमलक्षयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011615, "chapter_id": 1238, "verse_number": "१-२३९-१७", "content_sanskrit": "अब्रवीत्पुरुषव्याघ्रः प्रसहन्निव भारत।\nवनेचरस्य किमिदं कामेनालोड्यते मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011616, "chapter_id": 1238, "verse_number": "१-२३९-१८", "content_sanskrit": "ममैषा भगिनी पार्थ सारणस्य सहोदरी।\nसुभद्रा नाम भद्रं ते पितुर्मे दयिता सुता।\nयदि ते वर्तते बुद्धिर्वक्ष्यामि पितरं स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011617, "chapter_id": 1238, "verse_number": "१-२३९-१९x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011618, "chapter_id": 1238, "verse_number": "१-२३९-१९", "content_sanskrit": "दुहिता वसुदेवस्य वासुदेवस्य च स्वसा।\nरूपेण चैषा संपन्ना कमिवैषा न मोहयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011619, "chapter_id": 1238, "verse_number": "१-२३९-२०", "content_sanskrit": "कृतमेव तु कल्याणं सर्वं मम भवेद्ध्रुवम्।\nयदि स्यान्मम वार्ष्णेयी महिषीयं स्वसा तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011620, "chapter_id": 1238, "verse_number": "१-२३९-२१", "content_sanskrit": "प्राप्तौ तु क उपायः स्यात्तं व्रवीहि जनार्दन।\nआस्थास्यामि तदा सर्वं यदि शक्यं नरेण तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011621, "chapter_id": 1238, "verse_number": "१-२३९-२२x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011622, "chapter_id": 1238, "verse_number": "१-२३९-२२", "content_sanskrit": "स्वयं वरः क्षत्रियाणां विवाहः पुरुषर्षभ।\nस च संशयितः पार्थ स्वभावस्यानिमित्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011623, "chapter_id": 1238, "verse_number": "१-२३९-२३", "content_sanskrit": "प्रसह्य हरणं चापि क्षत्रियाणां प्रशस्यते।\nविवाहहेतुः शूराणामिति धर्मविदो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011624, "chapter_id": 1238, "verse_number": "१-२३९-२४", "content_sanskrit": "स त्वमर्जुन कल्याणीं प्रसह्य भगिनीं मम।\nयतिरूपधरस्तं तु यथा कालविपाकता।\nहर स्वयंवरे ह्यस्याः को वै वेद चिकीर्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011625, "chapter_id": 1238, "verse_number": "१-२३९-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011626, "chapter_id": 1238, "verse_number": "१-२३९-२५", "content_sanskrit": "ततोऽर्जुनश्च कृष्णश्च विनिश्चित्येतिकृत्यताम्।\nशीघ्रगान्पुरुषानन्प्रेषयामासतुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011627, "chapter_id": 1238, "verse_number": "१-२३९-२६", "content_sanskrit": "धर्मराजाय तत्सर्वमिन्द्रप्रस्थगताय वै।\nश्रुत्वैव च महाबाहुरनुजज्ञे समातृकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011628, "chapter_id": 1238, "verse_number": "१-२३९-२७", "content_sanskrit": "भीमसेनस्तु तच्छ्रुत्वा कृतकृत्यं स्म मन्यते।\nइत्येवं मनुजैरुक्तं कृष्णः श्रुत्वा महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011629, "chapter_id": 1238, "verse_number": "१-२३९-२८", "content_sanskrit": "अनुज्ञाप्य तदा पार्थं हृदि स्थाप्य चिकीर्षितम्।\nइत्येवं मनुजैः सार्धं द्वारकां समुपेयिवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011630, "chapter_id": 1238, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि सुभद्राहरणपर्वणि ऊनचत्वारिंशदधिकद्विशततमोऽध्यायः॥ २३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]