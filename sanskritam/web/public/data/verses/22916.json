[{"id": 7002916000, "chapter_id": 22916, "verse_number": "९-२०१-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nअथातः संप्रवक्ष्यामि घृताचलमनुत्तमम् ।\nतेजोऽमृतमयं दिव्यं महापातकनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002916001, "chapter_id": 22916, "verse_number": "९-२०१-२", "content_sanskrit": "पंचाशद्घृतकुम्भानामुत्तमः स्याद्घृताचलः ।\nमध्यमस्तु तदर्धेन तदर्द्धेनावरः स्मृतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002916002, "chapter_id": 22916, "verse_number": "९-२०१-३", "content_sanskrit": "अल्पवित्तस्तु कुर्वीत यथाशक्त्या विधानतः ।\nविष्कंभपर्वतांस्तद्वच्चतुर्भागेन कल्पयेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002916003, "chapter_id": 22916, "verse_number": "९-२०१-४", "content_sanskrit": "शालेयतंदुलानां च कुंभांश्च परिविन्यसेत् ।\nकारयेत्संहतानुच्चान्यथाशोभं विधानतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002916004, "chapter_id": 22916, "verse_number": "९-२०१-५", "content_sanskrit": "वेष्टयेच्छुक्लवासोभिरिक्षुदंडफलादिकैः ।\nधान्यपर्वतवच्छेषं विधानमिह पठ्यते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002916005, "chapter_id": 22916, "verse_number": "९-२०१-६", "content_sanskrit": "अधिवासनपूर्वं च तद्वद्धोमं सुरार्चनम् ।\nप्रभातायां तु शर्वयां गुरवे विनिवेदयेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002916006, "chapter_id": 22916, "verse_number": "९-२०१-७", "content_sanskrit": "विष्कंभपर्वतांस्तद्वदृत्विग्भ्यः शांतमानसः ।\nमंत्रेणानेन कौंतेय तच्छृणुष्व वदामि ते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002916007, "chapter_id": 22916, "verse_number": "९-२०१-८", "content_sanskrit": "संयोगाद्घृतमुत्पन्नं यस्मादमृततेजसे ।\nतस्माद्घृताचलश्चास्मात्प्रीयतां मम शंकरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002916008, "chapter_id": 22916, "verse_number": "९-२०१-९", "content_sanskrit": "तस्मात्तेजोमयं ब्रह्म घृते नित्यं व्यवस्थितम् ।\nघृतपर्वतरूपेण तस्मान्नः पाहि भूधर ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002916009, "chapter_id": 22916, "verse_number": "९-२०१-१०", "content_sanskrit": "अनेन विधिना दद्याद्घृताचलमनुत्तमम् ।\nमहापातकयुक्तोऽपि लोकमायाति शांकरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002916010, "chapter_id": 22916, "verse_number": "९-२०१-११", "content_sanskrit": "हंससारससंयुक्ते किंकिणीजालमालिते ।\nविमाने अप्सरोभिश्च सिद्धविद्याधरैर्वृतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002916011, "chapter_id": 22916, "verse_number": "९-२०१-१२", "content_sanskrit": "विहरेत्पितृभिः सार्द्धं यावदाभूतसंप्लवम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002916012, "chapter_id": 22916, "verse_number": "९-२०१-१३", "content_sanskrit": "आज्याचलं प्रचलकुंडलसुन्दरीभिः संसेव्यमानमिह ये वितरंति मर्त्याः ।\nस्वर्गं सुरेंद्रभवनं भवसंनिधिं वा स्नेहानुबंधमचलं भवतीति सर्वम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]