[{"id": 2148484, "chapter_id": 4214, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148485, "chapter_id": 4214, "verse_number": "१", "content_sanskrit": "ततः सूर्यान्निःसरन्तीं कर्णः शुश्राव भारतीम् ।\nदुरत्ययां प्रणयिनीं पितृवद् गौरवेरिताम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148486, "chapter_id": 4214, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148487, "chapter_id": 4214, "verse_number": "२", "content_sanskrit": "सत्यमाह पृथा वाक्यं कर्ण मातृवचः शृणु ।\nश्रेयस्ते स्यान्नरव्याघ्र सर्वमाचरतस्तथा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148488, "chapter_id": 4214, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148489, "chapter_id": 4214, "verse_number": "३", "content_sanskrit": "एवमुक्तस्य मात्रा च स्वयं पित्रा च भानुना ।\nचचाल नैव कर्णस्य मतिः सत्यधृतेस्तदा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148490, "chapter_id": 4214, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148491, "chapter_id": 4214, "verse_number": "४", "content_sanskrit": "न चैतच्छ्रद्दधे वाक्यं क्षत्रिये भाषितं त्वया ।\nधर्मद्वारं ममैतत् स्यान्नियोगकरणं तव\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148492, "chapter_id": 4214, "verse_number": "५", "content_sanskrit": "अकरोन्मयि यत् पापं भवती सुमहात्ययम् ।\nअवकीर्णोऽस्मि यन्मातः तद् यशःकीर्तिनाशनम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148493, "chapter_id": 4214, "verse_number": "६", "content_sanskrit": "अहं च क्षत्रियो जातो न प्राप्तः क्षत्रसत्क्रियाम् ।\nत्वत्कृते किं नु पापीयः शत्रुः कुर्यान्ममाहितम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148494, "chapter_id": 4214, "verse_number": "७", "content_sanskrit": "क्रियाकाले त्वनुक्रोशमकृत्वा त्वमिमं मम ।\nसुसङ्गृहीतसमयमद्य मां समचूचुदः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148495, "chapter_id": 4214, "verse_number": "८", "content_sanskrit": "न वै मम हितं पूर्वं मातृवच्चेष्टितं त्वया ।\nसा मां सम्बोधयस्यद्य केवलात्महितैषिणी\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148496, "chapter_id": 4214, "verse_number": "९", "content_sanskrit": "कृष्णेन सहितात् को वै न व्यथेत धनञ्जयात् ।\nकोऽद्य भीतं न मां विद्यात् पार्थानां समितिं गतम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148497, "chapter_id": 4214, "verse_number": "१०", "content_sanskrit": "अभ्राता विदितः पूर्वं युद्धकाले प्रकाशितः ।\nपाण्डवान् यदि गच्छामि किं मां क्षत्रं वदिष्यति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148498, "chapter_id": 4214, "verse_number": "११", "content_sanskrit": "सर्वकामैः संविभक्तः पूजितश्च यथासुखम् ।\nअहं वै धार्तराष्ट्राणां कुर्यां तदफलं कथम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148499, "chapter_id": 4214, "verse_number": "१२", "content_sanskrit": "उपनह्य परैर्वैरं ये मां नित्यमुपासते ।\nनमस्कुर्वन्ति च सदा वसवो वासवं यथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148500, "chapter_id": 4214, "verse_number": "१३", "content_sanskrit": "मम प्राणेन ये शत्रून् शक्ताः प्रतिसमासितुम् ।\nमन्यन्ते ते कथं तेषामहं छिन्द्यां मनोरथम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148501, "chapter_id": 4214, "verse_number": "१४", "content_sanskrit": "मया प्लवेन सङ्ग्रामं तितीर्षन्ति दुरत्ययम् ।\nअपारे पारकामा ये त्यजेयं तानहं कथम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148502, "chapter_id": 4214, "verse_number": "१५", "content_sanskrit": "अयं हि कालः सम्प्राप्तो धार्तराष्ट्रोपजीविनाम् ।\nनिर्वेष्टव्यं मया तत्र प्राणानपरिरक्षता\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148503, "chapter_id": 4214, "verse_number": "१६", "content_sanskrit": "कृतार्थाः सुभृता ये हि कृत्यकाले ह्युपस्थिते ।\nअनवेक्ष्य कृतं पापाः कुर्वन्ति प्रियमात्मनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148504, "chapter_id": 4214, "verse_number": "१७", "content_sanskrit": "राजकिल्बिषिणां तेषां भर्तृपिण्डापहारिणाम् ।\nनैवायं न परो लोको विद्यते पापकर्मणाम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148505, "chapter_id": 4214, "verse_number": "१८", "content_sanskrit": "धृतराष्ट्रस्य पुत्राणामर्थे योत्स्यामि ते सुतैः ।\nबलं च शक्तिं चास्थाय न वै त्वय्यनृतं वदे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148506, "chapter_id": 4214, "verse_number": "१९", "content_sanskrit": "आनृशंस्यमथो वृत्तं रक्षन् सत्पुरुषोचितम् ।\nअतोऽर्थकरमप्येतन्न करोम्यद्य ते वचः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2148507, "chapter_id": 4214, "verse_number": "२०", "content_sanskrit": "न च तेऽयं समारम्भो मयि मोघो भविष्यति ।\nवध्यान् विषँह्यान् सङ्ग्रामे न हनिष्यामि ते सुतान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2148508, "chapter_id": 4214, "verse_number": "२१", "content_sanskrit": "युधिष्ठिरं च भीमं च यमौ तावर्जुनादृते ।\nअर्जुनेन समं युद्धं मम यौधिष्ठिरे बले\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2148509, "chapter_id": 4214, "verse_number": "२२", "content_sanskrit": "अर्जुनं विनिहत्याजौ सम्प्राप्तं स्यात् फलं मया ।\nयशसा वा न मुच्येयं निहतः सव्यसाचिना\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2148510, "chapter_id": 4214, "verse_number": "२३", "content_sanskrit": "न ते जातु नशिष्यन्ति पुत्राः पञ्च यशस्विनि ।\nनिरर्जुनाः सकर्णा वा सार्जुना वा हते मयि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2148511, "chapter_id": 4214, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2148512, "chapter_id": 4214, "verse_number": "समाप्तिः", "content_sanskrit": "इति कर्णवचः श्रुत्वा कुन्ती दुःखात् प्रवेपती ।\nउवाच पुत्रमाश्लिष्य कर्णं धैर्यादकम्पनम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2148513, "chapter_id": 4214, "verse_number": "२५", "content_sanskrit": "एवं वै भाव्यमेतेन क्षयं यास्यन्ति कौरवाः ।\nयथा त्वं भाषसे कर्ण दैवं तु बलवत्तरम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2148514, "chapter_id": 4214, "verse_number": "२६", "content_sanskrit": "त्वया चतुर्णां भ्रातॄणामभयं शत्रुकर्शन ।\nदत्तं तत् प्रतिजानीहि सङ्गरप्रतिमोचनम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2148515, "chapter_id": 4214, "verse_number": "२७", "content_sanskrit": "अनामयं स्वस्ति चेति पृथाऽथो कर्णमब्रवीत् ।\nतां कर्णोऽभ्यवदत् प्रीतः ततस्तौ जग्मतुः सुखम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2148516, "chapter_id": 4214, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि पञ्चचत्वारिंशोत्तरशततमोऽध्यायः ॥१४५॥\nविवादपर्वणि सप्तमोऽध्यायः ॥७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]