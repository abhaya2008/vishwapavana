[{"id": 6000171000, "chapter_id": 10171, "verse_number": null, "content_sanskrit": "अथ अष्टादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000171001, "chapter_id": 10171, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.001.m4a", "display_order": 2}, {"id": 6000171002, "chapter_id": 10171, "verse_number": "८-१८-१", "content_sanskrit": "इति वैरोचनेर्वाक्यं धर्मयुक्तं सुसूनृतम्।\nनिशम्य भगवान् प्रीतः प्रतिनन्द्येदमब्रवीत्॥ ८/१८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.002.m4a", "display_order": 3, "topics": [{"text": "वामनेन बलिप्रशंसनपूर्वकं स्वपदत्रयमितभूयाचनम्", "range": "१–२७"}]}, {"id": 6000171003, "chapter_id": 10171, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.003.m4a", "display_order": 4}, {"id": 6000171004, "chapter_id": 10171, "verse_number": "८-१८-२", "content_sanskrit": "वचस्तवैतज्जनदेव सूनृतं कुलोचितं धर्मयुतं यशस्करम्।\nयस्य प्रमाणं भृगवः साम्पराये पितामहः कुलवृद्धः प्रशान्तः॥ ८/१८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.004.m4a", "display_order": 5}, {"id": 6000171005, "chapter_id": 10171, "verse_number": "८-१८-३", "content_sanskrit": "न ह्येतस्मिन् कुले कश्चिन्निस्सत्त्वः कृपणः पुमान्।\nप्रत्याख्याता प्रतिश्रुत्य यो वाऽदाता द्विजातये॥ ८/१८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.005.m4a", "display_order": 6}, {"id": 6000171006, "chapter_id": 10171, "verse_number": "८-१८-४", "content_sanskrit": "न सन्ति तीर्थे युधि वाऽर्थिनाऽर्थिताः पराङ्मुखा ये त्वमनस्विनो नृप।\nयुष्मत्कुले यद् यशसाऽमलेन प्रह्लाद उद्भाति यथोडुपः खे॥ ८/१८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.006.m4a", "display_order": 7}, {"id": 6000171007, "chapter_id": 10171, "verse_number": "८-१८-५", "content_sanskrit": "यतो जातो हिरण्याक्षश्चरन्नेक इमां महीम्।\nप्रतिवीरं दिग्विजये नाविन्दत गदायुधः॥ ८/१८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.007.m4a", "display_order": 8}, {"id": 6000171008, "chapter_id": 10171, "verse_number": "८-१८-६", "content_sanskrit": "यं विनिर्जित्य कृच्छ्रेण विष्णुः क्ष्मोद्धार आगते।\nनात्मानं जयिनं मेने तद्वीर्यं भूर्यनुस्मरन्॥ ८/१८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.008.m4a", "display_order": 9}, {"id": 6000171009, "chapter_id": 10171, "verse_number": "८-१८-७", "content_sanskrit": "निशम्य तद्वधं भ्राता हिरण्यकशिपुः पुरा।\nहन्तुं भ्रातृहणं क्रुद्धो जगाम निलयं हरेः॥ ८/१८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.009.m4a", "display_order": 10}, {"id": 6000171010, "chapter_id": 10171, "verse_number": "८-१८-८", "content_sanskrit": "तमायान्तं समालोक्य शूलपाणिं कृतान्तवत्।\nचिन्तयामास कालज्ञो विष्णुर्मायाविनां वरः॥ ८/१८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.010.m4a", "display_order": 11}, {"id": 6000171011, "chapter_id": 10171, "verse_number": "८-१८-९", "content_sanskrit": "यतो यतोऽहं तत्रासौ मृत्युः प्राणभृतामिव।\nअतोऽहमस्य हृदयं प्रवेक्ष्यामि पराग्दृशः॥ ८/१८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.011.m4a", "display_order": 12}, {"id": 6000171012, "chapter_id": 10171, "verse_number": "८-१८-१०", "content_sanskrit": "एवं स निश्चित्य रिपोः शरीरमाधावतो निर्विविशेऽसुरेन्द्र।\nश्वासानिलान्तर्हितसूक्ष्मदेहस्तद्‌घ्राणरन्ध्रेण विविग्नचेताः॥ ८/१८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.012.m4a", "display_order": 13}, {"id": 6000171013, "chapter_id": 10171, "verse_number": "८-१८-११", "content_sanskrit": "स तन्निकेतं परिमृश्य शून्यमपश्यमानः कुपितो ननाद।\nक्ष्मां द्यां दिशः खं विवरान् समुद्रान् विष्णुं विचिन्वन् न ददर्श वीरः॥ ८/१८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.013.m4a", "display_order": 14}, {"id": 6000171014, "chapter_id": 10171, "verse_number": "८-१८-१२", "content_sanskrit": "अपश्यन्निति होवाच मयाऽन्विष्टमिदं जगत्।\nभ्रातृहा मे गतो नूनं यतो नावर्तते पुमान्॥ ८/१८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.014.m4a", "display_order": 15}, {"id": 6000171015, "chapter_id": 10171, "verse_number": "८-१८-१३", "content_sanskrit": "वैरानुबन्ध एतावान् आमृत्योरिह देहिनाम्।\nअज्ञानप्रभवो मन्युरहम्मानोपबृंहितः॥ ८/१८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.015.m4a", "display_order": 16}, {"id": 6000171016, "chapter_id": 10171, "verse_number": "८-१८-१४", "content_sanskrit": "पिता प्रह्लादपुत्रस्ते तद्विद्वान् द्विजवत्सलः।\nस्वमायुर्द्विजलिङ्गेभ्यो देवेभ्योऽदात् स याचितः॥ ८/१८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.016.m4a", "display_order": 17}, {"id": 6000171017, "chapter_id": 10171, "verse_number": "८-१८-१५", "content_sanskrit": "भवानाचरिता धर्मान् आस्थितान् गृहमेधिभिः।\nब्राह्मणैः पूर्वजैः शूरैरन्यैश्चोद्दामकीर्तिभिः॥ ८/१८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.017.m4a", "display_order": 18}, {"id": 6000171018, "chapter_id": 10171, "verse_number": "८-१८-१६", "content_sanskrit": "तस्मात् त्वत्तो महीमीषद् वृणेऽहं वरदर्षभ।\nपदानि त्रीणि दैत्येन्द्र सम्मितानि पदा मम॥ ८/१८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.018.m4a", "display_order": 19}, {"id": 6000171019, "chapter_id": 10171, "verse_number": "८-१८-१७", "content_sanskrit": "नान्यं ते कामये राजन् वदान्याज्जगदीश्वरात्।\nनैनः प्राप्नोति वै विद्वान् यावदर्थं प्रतिग्रहात्॥ ८/१८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.019.m4a", "display_order": 20}, {"id": 6000171020, "chapter_id": 10171, "verse_number": null, "content_sanskrit": "बलिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.020.m4a", "display_order": 21}, {"id": 6000171021, "chapter_id": 10171, "verse_number": "८-१८-१८", "content_sanskrit": "अहो ब्राह्मणदायाद वाचस्तेऽवृद्धसम्मताः।\nत्वं बालो बालिशमतिः स्वार्थं प्रत्यबुधो यथा॥ ८/१८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.021.m4a", "display_order": 22}, {"id": 6000171022, "chapter_id": 10171, "verse_number": "८-१८-१९", "content_sanskrit": "मां वचोभिः समाराध्य लोकानामेकमीश्वरम्।\nपदत्रयं वृणीते योऽबुद्धिमानिव दाशुषम्॥ ८/१८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.022.m4a", "display_order": 23}, {"id": 6000171023, "chapter_id": 10171, "verse_number": "८-१८-२०", "content_sanskrit": "न पुमान् मामनुव्रज्य भूयो याचितुमर्हति।\nतस्माद् वृत्तिकरीं भूमिं वटो कामं प्रतीच्छ मे॥ ८/१८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.023.m4a", "display_order": 24}, {"id": 6000171024, "chapter_id": 10171, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.024.m4a", "display_order": 25}, {"id": 6000171025, "chapter_id": 10171, "verse_number": "८-१८-२१", "content_sanskrit": "यावन्तो विषयाः प्रेष्ठास्‍त्रिलोक्यामजितेन्द्रियम्।\nन शक्नुवन्ति ते सर्वे प्रतिपूरयितुं नृप॥ ८/१८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.025.m4a", "display_order": 26}, {"id": 6000171026, "chapter_id": 10171, "verse_number": "८-१८-२२", "content_sanskrit": "त्रिभिः क्रमैरसन्तुष्टो द्वीपेनापि न पूर्यते।\nनववर्षसमेतेन सप्तद्वीपधरेच्छया॥ ८/१८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.026.m4a", "display_order": 27}, {"id": 6000171027, "chapter_id": 10171, "verse_number": "८-१८-२३", "content_sanskrit": "सप्तद्वीपाधिपतयो नृपा वैन्यगयादयः।\nअर्थैः कामैर्गता नान्तं तृष्णाया इति नः श्रुतम्॥ ८/१८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.027.m4a", "display_order": 28}, {"id": 6000171028, "chapter_id": 10171, "verse_number": "८-१८-२४", "content_sanskrit": "यदृच्छयोपपन्नेन सन्तुष्टो वर्तते सुखम्।\nनासन्तुष्टस्‍त्रिभिर्लोकैरजितात्मोपसादितैः॥ ८/१८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.028.m4a", "display_order": 29}, {"id": 6000171029, "chapter_id": 10171, "verse_number": "८-१८-२५", "content_sanskrit": "पुंसोऽयं संसृतेर्हेतुरसन्तोषोऽर्थकामयोः।\nयदृच्छयोपपन्नेन सन्तोषो मुक्तये स्मृतः॥ ८/१८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.029.m4a", "display_order": 30}, {"id": 6000171030, "chapter_id": 10171, "verse_number": "८-१८-२६", "content_sanskrit": "यदृच्छालाभतुष्टस्य तेजो विप्रस्य वर्धते।\nतत् प्रशाम्यत्यसन्तोषादम्भसेवाशुशुक्षणिः॥ ८/१८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.030.m4a", "display_order": 31}, {"id": 6000171031, "chapter_id": 10171, "verse_number": "८-१८-२७", "content_sanskrit": "तस्मात् त्रीणि पदान्येव वृणे त्वद् वरदर्षभात्।\nएतावतैव सिद्धोऽहं वित्तं यावत्प्रयोजनम्॥ ८/१८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.031.m4a", "display_order": 32}, {"id": 6000171032, "chapter_id": 10171, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.032.m4a", "display_order": 33}, {"id": 6000171033, "chapter_id": 10171, "verse_number": "८-१८-२८", "content_sanskrit": "इत्युक्तः स हसन्नाह वाञ्छितं प्रतिगृह्यताम्।\nवामनाय महीं दातुं जग्राह जलभाजनम्॥ ८/१८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.033.m4a", "display_order": 34, "topics": [{"text": "तत्प्रदातुमुद्युक्तस्य बलेः शुक्राचार्येण तस्य वामनस्य विष्णुत्वकथनपूर्वकं भूप्रदाननिषेधः", "range": "२८–४३"}]}, {"id": 6000171034, "chapter_id": 10171, "verse_number": "८-१८-२९", "content_sanskrit": "विष्णवे क्ष्मां प्रदास्यन्तमुशना असुरेश्वरम्।\nजानंश्चिकीर्षितं विष्णोः शिष्यं प्राह विदां वरः॥ ८/१८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.034.m4a", "display_order": 35}, {"id": 6000171035, "chapter_id": 10171, "verse_number": null, "content_sanskrit": "उशना उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.035.m4a", "display_order": 36}, {"id": 6000171036, "chapter_id": 10171, "verse_number": "८-१८-३०", "content_sanskrit": "एष वैरोचने साक्षाद् भगवान् विष्णुरव्ययः।\nकश्यपाददितेर्जातो देवानां कार्यसाधकः॥ ८/१८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.036.m4a", "display_order": 37}, {"id": 6000171037, "chapter_id": 10171, "verse_number": "८-१८-३१", "content_sanskrit": "प्रतिश्रुतं त्वयैतस्मै यदनर्थमजानता।\nन साधु मन्ये दैत्यानां महानुपगतोऽनयः॥ ८/१८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.037.m4a", "display_order": 38}, {"id": 6000171038, "chapter_id": 10171, "verse_number": "८-१८-३२", "content_sanskrit": "एष ते स्थानमैश्वर्यं श्रुतं तेजो यशः श्रुतम्।\nदास्यत्याच्छिद्य शक्राय मायामाणवको हरिः॥ ८/१८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.038.m4a", "display_order": 39}, {"id": 6000171039, "chapter_id": 10171, "verse_number": "८-१८-३३", "content_sanskrit": "त्रिभिः क्रमैरिमाल्‍ँलोकान् विश्वकायः क्रमिष्यति।\nसर्वस्वं विष्णवे दत्त्वा मूढ वर्तिष्यसे कथम्॥ ८/१८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.039.m4a", "display_order": 40}, {"id": 6000171040, "chapter_id": 10171, "verse_number": "८-१८-३४", "content_sanskrit": "क्रमतो गां पदैकेन द्वितीयेन दिवं विभोः।\nखं च कायेन महता तार्तीयस्य कुतो गतिः॥ ८/१८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.040.m4a", "display_order": 41}, {"id": 6000171041, "chapter_id": 10171, "verse_number": "८-१८-३५", "content_sanskrit": "निष्ठान्तं नरकं मन्ये ह्यप्रदातुः प्रतिश्रुतम्।\nप्रतिश्रुतस्य योऽनीशः प्रतिपादयितुं भवान्॥ ८/१८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.041.m4a", "display_order": 42}, {"id": 6000171042, "chapter_id": 10171, "verse_number": "८-१८-३६", "content_sanskrit": "न तद्दानं प्रशंसन्ति येन वृत्तिर्विपद्यते।\nदानं यज्ञस्तपः कर्म लोके वृत्तिमतो यतः॥ ८/१८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.042.m4a", "display_order": 43}, {"id": 6000171043, "chapter_id": 10171, "verse_number": "८-१८-३७", "content_sanskrit": "धर्माय यशसेऽर्थाय कामाय स्वजनाय च।\nपञ्चधा विभजन् वित्तमिहामुत्र च मोदते॥ ८/१८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.043.m4a", "display_order": 44}, {"id": 6000171044, "chapter_id": 10171, "verse_number": "८-१८-३८", "content_sanskrit": "अत्रापि बह्वृचैर्गीतं शृणुष्वासुरसत्तम।\nसत्यमोमिति यत् प्रोक्तं यन्नेत्याहानृतं हि तत्॥ ८/१८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.044.m4a", "display_order": 45}, {"id": 6000171045, "chapter_id": 10171, "verse_number": "८-१८-३९", "content_sanskrit": "सत्यं पुष्पफलं विद्यादात्मवृक्षस्य जीवतः।\nवृक्षेऽजीवति तन्न स्यादनृतं मूलमात्मनः॥ ८/१८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.045.m4a", "display_order": 46}, {"id": 6000171046, "chapter_id": 10171, "verse_number": "८-१८-४०", "content_sanskrit": "तद् यथा वृक्ष उन्मूलः शुष्यत्युद्वर्ततेऽचिरात्।\nएवं नष्टानृतः सद्य आत्मा शुष्येन्न संशयः॥ ८/१८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.046.m4a", "display_order": 47}, {"id": 6000171047, "chapter_id": 10171, "verse_number": "८-१८-४१", "content_sanskrit": "पराग्रिक्तमपूर्णं वा अक्षरं यत् तदोमिति।\nतद् यत् किञ्चोमिति ब्रूयान्न स रिच्येत वै पुमान्॥ ८/१८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.047.m4a", "display_order": 48}, {"id": 6000171048, "chapter_id": 10171, "verse_number": "८-१८-४२", "content_sanskrit": "भिक्षवे सर्वमोङ्कुर्वन्नालं कामेभ्य आत्मने।\nअथैतत् पूर्णमभ्यात्मं यच्च नेत्यनृतं वचः॥ ८/१८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.048.m4a", "display_order": 49}, {"id": 6000171049, "chapter_id": 10171, "verse_number": "८-१८-४३", "content_sanskrit": "सर्वं नेत्यर्थिनं ब्रूयात् स दुष्कीर्तिः श्वसन्मृतः। स्‍त्रीषु नर्मे विवाहे च वृत्त्यर्थे प्राणसङ्कटे।\nगोब्राह्मणार्थे हिंसायां नानृतं स्याज्जुगुप्सितम्॥ ८/१८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_018/BhP_08.018.049.m4a", "display_order": 50}, {"id": 6000171050, "chapter_id": 10171, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धे अष्टादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]