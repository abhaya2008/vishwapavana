[{"id": 6000149000, "chapter_id": 10149, "verse_number": null, "content_sanskrit": "अथ एकादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000149001, "chapter_id": 10149, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.001.m4a", "display_order": 2}, {"id": 6000149002, "chapter_id": 10149, "verse_number": "७-११-१", "content_sanskrit": "श्रुत्वेहितं साधुसभासभाजितं महत्तमाग्रण्य उरुक्रमात्मनः।\nयुधिष्ठिरो दैत्यपतेर्मुदान्वितः पप्रच्छ भूयस्तनयं स्वयम्भुवः॥ ७/११/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.002.m4a", "display_order": 3, "topics": [{"text": "नारदोक्तं प्रह्लादचरित्रं श्रुतवता युधिष्ठिरेण तं प्रति वर्णाश्रमाचारकथनप्रार्थना", "range": "१–४"}]}, {"id": 6000149003, "chapter_id": 10149, "verse_number": null, "content_sanskrit": "युधिष्ठिर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.003.m4a", "display_order": 4}, {"id": 6000149004, "chapter_id": 10149, "verse_number": "७-११-२", "content_sanskrit": "भगवन् श्रोतुमिच्छामि नृणां धर्मं सनातनम्।\nवर्णाश्रमाचारयुतं यत् पुमान् विन्दते परम्॥ ७/११/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.004.m4a", "display_order": 5}, {"id": 6000149005, "chapter_id": 10149, "verse_number": "७-११-३", "content_sanskrit": "भवान् प्रजापतेः साक्षादात्मजः परमेष्ठिनः।\nसुतानां सम्मतो ब्रह्मन् तपोज्ञानसमाधिभिः॥ ७/११/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.005.m4a", "display_order": 6}, {"id": 6000149006, "chapter_id": 10149, "verse_number": "७-११-४", "content_sanskrit": "नारायणपरा विप्रा धर्मं गुह्यं यथा विदुः।\nकरुणाः साधवः शान्तास्त्वद्विधा न तथा परे॥ ७/११/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.006.m4a", "display_order": 7}, {"id": 6000149007, "chapter_id": 10149, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.007.m4a", "display_order": 8}, {"id": 6000149008, "chapter_id": 10149, "verse_number": "७-११-५", "content_sanskrit": "नत्वा भगवतेऽजाय लोकानां धर्महेतवे।\nवक्ष्ये सनातनं धर्मं नारायणमुखाच्छ्रुतम्॥ ७/११/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.008.m4a", "display_order": 9, "topics": [{"text": "नारदेन नृणां साधारणधर्मस्य, वर्णधर्माणां स्त्रीधर्माणां च कथनम्", "range": "५–३६"}]}, {"id": 6000149009, "chapter_id": 10149, "verse_number": "७-११-६", "content_sanskrit": "योऽवतीर्यात्मनोंऽशेन दाक्षायण्यां तु धर्मतः।\nलोकानां स्वस्तयेऽध्यास्ते तपो बदरिकाश्रमे॥ ७/११/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.009.m4a", "display_order": 10}, {"id": 6000149010, "chapter_id": 10149, "verse_number": "७-११-७", "content_sanskrit": "धर्ममूलं हि भगवान् सर्ववेदमयो हरिः।\nस्मृतिश्च तद्विदां राजन् येन चात्मा प्रसीदति॥ ७/११/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.010.m4a", "display_order": 11}, {"id": 6000149011, "chapter_id": 10149, "verse_number": "७-११-८", "content_sanskrit": "सत्यं दया तपः शौचं तितिक्षेक्षा शमो दमः।\nअहिंसा ब्रह्मचर्यं च त्यागः स्वाध्याय आर्जवम्॥ ७/११/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.011.m4a", "display_order": 12}, {"id": 6000149012, "chapter_id": 10149, "verse_number": "७-११-९", "content_sanskrit": "सन्तोषः समदृक्सेवा ग्राम्येहोपरमः शनैः।\nनृणां विपर्ययेहेक्षा मौनमात्मविमर्शनम्॥ ७/११/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.012.m4a", "display_order": 13}, {"id": 6000149013, "chapter_id": 10149, "verse_number": "७-११-१०", "content_sanskrit": "अन्नाद्यादेः संविभागो भूतेभ्यश्च यथाऽर्हतः।\nतेष्वात्मदेवताबुद्धिः सुतरां नृषु पाण्डव॥ ७/११/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.013.m4a", "display_order": 14}, {"id": 6000149014, "chapter_id": 10149, "verse_number": "७-११-११", "content_sanskrit": "श्रवणं कीर्तनं चास्य स्मरणं महतां गतेः।\nसेवेज्याऽवनतिः सख्यं दास्यमात्मसमर्पणम्॥ ७/११/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.014.m4a", "display_order": 15}, {"id": 6000149015, "chapter_id": 10149, "verse_number": "७-११-१२", "content_sanskrit": "नृणामयं परो धर्मः सर्वेषां समुदाहृतः।\nत्रिंशल्लक्षणसंयुक्तः सर्वात्मा येन तुष्यति॥ ७/११/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.015.m4a", "display_order": 16}, {"id": 6000149016, "chapter_id": 10149, "verse_number": "७-११-१३", "content_sanskrit": "संस्कारा यद्यविच्छिन्ना स द्विजो वैदिकादयः।\nइज्याध्ययनदानानि विहितानि द्विजन्मनाम्॥ ७/११/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.016.m4a", "display_order": 17}, {"id": 6000149017, "chapter_id": 10149, "verse_number": "७-११-१४", "content_sanskrit": "जन्मकर्मावदातानां क्रियाश्च निगमोदिताः।\nविप्रस्याध्यापनादीनि ततोऽन्यस्यापरिग्रहः॥ ७/११/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.017.m4a", "display_order": 18}, {"id": 6000149018, "chapter_id": 10149, "verse_number": "७-११-१५", "content_sanskrit": "राज्ञो वृत्तिः प्रजागोप्तुरविप्राद् वा करादिभिः।\nवैश्यस्तु वार्तावृत्तिः स्यान्नित्यं ब्रह्मकुलानुगः॥ ७/११/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.018.m4a", "display_order": 19}, {"id": 6000149019, "chapter_id": 10149, "verse_number": "७-११-१६", "content_sanskrit": "शूद्रस्य द्विजशुश्रूषा वृत्तिश्च स्वामिनो भवेत्॥ ७/११/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.019.m4a", "display_order": 20}, {"id": 6000149020, "chapter_id": 10149, "verse_number": "७-११-१७", "content_sanskrit": "वार्ता विचित्रशालीनं यायावर्यं शिलोञ्छनम्। विप्रवृत्तिश्चतुर्धेयं श्रेयसी चोत्तरोत्तरा।\nजघन्यो नोत्तमां वृत्तिमनापदि भजेन्नरः॥ ७/११/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.020.m4a", "display_order": 21}, {"id": 6000149021, "chapter_id": 10149, "verse_number": "७-११-१८", "content_sanskrit": "ऋते राजन्यमापत्सु सर्वेषामपि सर्वशः।\nऋतामृताभ्यां जीवेत मृतेन प्रमृतेन वा॥ ७/११/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.021.m4a", "display_order": 22}, {"id": 6000149022, "chapter_id": 10149, "verse_number": "७-११-१९", "content_sanskrit": "सत्यानृताभ्यां जीवेत न श्ववृत्त्या कथञ्चन।\nऋतमुञ्छशिलं प्रोक्तममृतं यदयाचितम्॥ ७/११/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.022.m4a", "display_order": 23}, {"id": 6000149023, "chapter_id": 10149, "verse_number": "७-११-२०", "content_sanskrit": "मृतं तु नित्ययाञ्चा स्यात् प्रमृतं कर्षणं स्मृतम्।\nसत्यानृतं तु वाणिज्यं श्ववृत्तिर्नीचसेवनम्॥ ७/११/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.023.m4a", "display_order": 24}, {"id": 6000149024, "chapter_id": 10149, "verse_number": "७-११-२१", "content_sanskrit": "वर्जयेत् तां सदा विप्रो राजन्यश्च जुगुप्सिताम्।\nसर्ववेदमयो विप्रः सर्वदेवमयो नृपः॥ ७/११/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.024.m4a", "display_order": 25}, {"id": 6000149025, "chapter_id": 10149, "verse_number": "७-११-२२", "content_sanskrit": "शमो दमस्तपः शौचं सन्तोषः क्षान्तिरार्जवम्।\nदानं दयाऽच्युतात्मत्वं सत्यं च ब्रह्मलक्षणम्॥ ७/११/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.025.m4a", "display_order": 26}, {"id": 6000149026, "chapter_id": 10149, "verse_number": "७-११-२३", "content_sanskrit": "शौर्यं वीर्यं धृतिस्तेजस्त्याग आत्मजयः क्षमा।\nब्रह्मण्यता प्रसादश्च रक्षा च क्षत्रलक्षणम्॥ ७/११/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.026.m4a", "display_order": 27}, {"id": 6000149027, "chapter_id": 10149, "verse_number": "७-११-२४", "content_sanskrit": "देवगुर्वार्यगोभक्तिस्‍त्रिवर्गपरितोषणम्।\nआस्तिक्यमुद्यमो नित्यं नैपुण्यं वैश्यलक्षणम्॥ ७/११/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.027.m4a", "display_order": 28}, {"id": 6000149028, "chapter_id": 10149, "verse_number": "७-११-२५", "content_sanskrit": "शूद्रस्य सन्नतिः शौचं सेवा स्वामिन्यमायया।\nअमन्त्रयज्ञो ह्यस्तेयं मौढ्यं गोविप्ररक्षणम्॥ ७/११/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.028.m4a", "display_order": 29}, {"id": 6000149029, "chapter_id": 10149, "verse_number": "७-११-२६", "content_sanskrit": "स्‍त्रीणां तु पतिदेवानां तच्छुश्रूषाऽनुकूलता।\nतद्बन्धुष्वनुवृत्तिश्च नित्यं तद्व्रतधारणम्॥ ७/११/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.029.m4a", "display_order": 30}, {"id": 6000149030, "chapter_id": 10149, "verse_number": "७-११-२७", "content_sanskrit": "सम्मार्जनोपलेपाभ्यां गृहमण्डनवर्तनैः।\nस्वयं च मण्डिता नित्यं परिमृष्टपरिच्छदा॥ ७/११/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.030.m4a", "display_order": 31}, {"id": 6000149031, "chapter_id": 10149, "verse_number": "७-११-२८", "content_sanskrit": "कामैरुच्चावचैः साध्वी प्रश्रयेण दमेन च।\nवाक्यैः सत्यैः प्रियैः प्रेम्णा काले काले भजेत् पतिम्॥ ७/११/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.031.m4a", "display_order": 32}, {"id": 6000149032, "chapter_id": 10149, "verse_number": "७-११-२९", "content_sanskrit": "सन्तुष्टाऽलोलुपा दक्षा धर्मज्ञा प्रियसत्यवाक्।\nअप्रमत्ता शुचिः स्निग्धा पतिं त्वपतितं भजेत्॥ ७/११/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.032.m4a", "display_order": 33}, {"id": 6000149033, "chapter_id": 10149, "verse_number": "७-११-३०", "content_sanskrit": "या पतिं हरिभावेन भजेच्छ्रीरिव तत्परा।\nहर्यात्मना हरेर्लोके पत्या श्रीरिव मोदते॥ ७/११/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.033.m4a", "display_order": 34}, {"id": 6000149034, "chapter_id": 10149, "verse_number": "७-११-३१", "content_sanskrit": "वृत्तिः सङ्करजातीनां तत्तत्कुलकृता भवेत्।\nअचौराणामपापानामन्त्यजान्तेऽवसायिनाम्॥ ७/११/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.034.m4a", "display_order": 35}, {"id": 6000149035, "chapter_id": 10149, "verse_number": "७-११-३२", "content_sanskrit": "प्रायः स्वभावविहितो नृणां धर्मो युगे युगे।\nवेददृग्भिः स्मृतो राजन् प्रेत्य चेह च शर्मकृत्॥ ७/११/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.035.m4a", "display_order": 36}, {"id": 6000149036, "chapter_id": 10149, "verse_number": "७-११-३३", "content_sanskrit": "वृत्त्या स्वभावकृतया वर्तमानः स्वकर्मणि।\nहित्वा स्वभावजं कर्म शनैर्निर्गुणतामियात्॥ ७/११/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.036.m4a", "display_order": 37}, {"id": 6000149037, "chapter_id": 10149, "verse_number": "७-११-३४", "content_sanskrit": "उप्यमानं मुहुः क्षेत्रं स्वयं निर्वीर्यतामियात्।\nन कल्पते पुनः सूत्यै उप्तं बीजं च नश्यति॥ ७/११/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.037.m4a", "display_order": 38}, {"id": 6000149038, "chapter_id": 10149, "verse_number": "७-११-३५", "content_sanskrit": "एवं कामाशयं चित्तं कामानामतिसेवया।\nविरज्येत यथा राजन्नाग्निवत् कामबिन्दुभिः॥ ७/११/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.038.m4a", "display_order": 39}, {"id": 6000149039, "chapter_id": 10149, "verse_number": "७-११-३६", "content_sanskrit": "यस्य यल्लक्षणं प्रोक्तं पुंसो वर्णादिव्यञ्जकम्।\nयद्यन्यत्रापि दृश्येत तत् तेनैव विनिर्दिशेत्॥ ७/११/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_011/BhP_07.011.039.m4a", "display_order": 40}, {"id": 6000149040, "chapter_id": 10149, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां सप्तमस्कन्धे एकादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]