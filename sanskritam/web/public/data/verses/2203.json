[{"id": 2054964, "chapter_id": 2203, "verse_number": "७-१३०-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2054965, "chapter_id": 2203, "verse_number": "७-१३०-१", "content_sanskrit": "तस्मिन्विलुलिते सैन्ये सैन्धवायार्जुने गते।\nसात्वते भीमसेने च पुत्रस्ते द्रोणमभ्ययात्।\nत्वरन्नेकरथेनैव बहु कृत्यं विचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2054966, "chapter_id": 2203, "verse_number": "७-१३०-२", "content_sanskrit": "स रथस्तव पुत्रस्य त्वरया परया युतः।\nतूर्णमभ्यद्रवद्द्रोणं मनोमारुतवेगवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2054967, "chapter_id": 2203, "verse_number": "७-१३०-३", "content_sanskrit": "`इह दृष्ट इतो नष्टः सरथः प्राद्रवन्नृपः।\nमुहूर्तादिव पुत्रस्ते द्रोणमासाद्य मारिष।\nससम्भ्रमामिदं वाक्यमब्रवीत्कुरनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2054968, "chapter_id": 2203, "verse_number": "७-१३०-४", "content_sanskrit": "अर्जुनो भीमसेनश्च सात्यकिश्चापराजितः।\nविजित्य सर्वसैन्यानि सुमहान्ति महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2054969, "chapter_id": 2203, "verse_number": "७-१३०-५", "content_sanskrit": "सम्प्राप्ताः सिन्धुराजस्य समीपमनिवारिताः।\nव्यायच्छन्ति च तत्रापि सर्व एवापराजिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2054970, "chapter_id": 2203, "verse_number": "७-१३०-६", "content_sanskrit": "यदि तावद्रणे पार्थो व्यतिक्रान्तो महारथः।\nकथं सात्यकिभीमाभ्यां व्यतिक्रान्तोऽसि मानद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2054971, "chapter_id": 2203, "verse_number": "७-१३०-७", "content_sanskrit": "आश्चर्यभूतो लोकेऽस्मिन्समुद्रस्येव शोषणम्।\nनिर्जयस्तव विप्राग्र्य सात्वतेनार्जुनेन च।\nतथैव भीमसेनेन लोकः संवदते भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2054972, "chapter_id": 2203, "verse_number": "७-१३०-८", "content_sanskrit": "कथं द्रोणो जितः सङ्ख्ये धनुर्वेदस्य पारगः।\nइत्येवं ब्रुवते योधा अश्रद्धेयमिदं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2054973, "chapter_id": 2203, "verse_number": "७-१३०-९", "content_sanskrit": "नाश एव तु मे नूनं मन्दभाग्यस्य संयुगे।\nयत्र त्वां पुरुषव्याघ्रं व्यतिक्रान्तास्त्रयो रथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2054974, "chapter_id": 2203, "verse_number": "७-१३०-१०x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2054975, "chapter_id": 2203, "verse_number": "७-१३०-१०", "content_sanskrit": "एवं गते तु कृत्येऽस्मिन्ब्रूहि यत्ते विवक्षितम्।\nयद्गतं गतमेवेदं शेषं चिन्तय मानद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2054976, "chapter_id": 2203, "verse_number": "७-१३०-११x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2054977, "chapter_id": 2203, "verse_number": "७-१३०-११", "content_sanskrit": "यत्कृत्यं सिन्धुराजस्य प्राप्तकालमनन्तरम्।\nतत्संविधीयतां क्षिप्रं साधु सञ्चिन्त्य नो द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2054978, "chapter_id": 2203, "verse_number": "७-१३०-१२x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2054979, "chapter_id": 2203, "verse_number": "७-१३०-१२", "content_sanskrit": "चिन्त्यं बहुविधं तात यत्कृत्यं तच्छृणुष्व मे।\nत्रयो हि समतिक्रान्ताः पाण्डवानां महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2054980, "chapter_id": 2203, "verse_number": "७-१३०-१३", "content_sanskrit": "यावत्तेषां भयं पश्चात्तावदेषां पुरःसरम्।\nतद्गरीयस्तरं मन्ये यत्र कृष्णधनञ्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2054981, "chapter_id": 2203, "verse_number": "७-१३०-१४", "content_sanskrit": "सा पुरस्ताच्च पश्चाच्च गृहीता भारती चमूः।\nतत्र कृत्यमहं मन्ये सैन्धवस्याभिरक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2054982, "chapter_id": 2203, "verse_number": "७-१३०-१५", "content_sanskrit": "स नो रक्ष्यतमस्तात क्रुद्धाद्भीतो धनञ्जयात्।\nगतौ च सैन्धवं भीमौ युयुधानवृकोदरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2054983, "chapter_id": 2203, "verse_number": "७-१३०-१६", "content_sanskrit": "सम्प्राप्तं तदिदं द्यूतं यत्तच्छकुनिबुद्धिजम्।\nन सभायां जयो वृत्तो नापि तत्र पराजयः।\nइह नो ग्लहमानानामद्य तावज्जयाजयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2054984, "chapter_id": 2203, "verse_number": "७-१३०-१७", "content_sanskrit": "यान्स्म तान्ग्लहते घोराञ्छकुनिः कुरुसंसदि।\nअक्षान्स मन्यमानः प्राक्शरास्ते हि दुरासदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2054985, "chapter_id": 2203, "verse_number": "७-१३०-१८", "content_sanskrit": "यत्र ते बहवस्तात कौरवेया व्यवस्थिताः।\nसेन्नां दुरोदरं विद्धि शरानक्षान्विशाम्पते।\nग्लहं च सैन्धवं राजंस्तत्र द्यूतस्य निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2054986, "chapter_id": 2203, "verse_number": "७-१३०-१९", "content_sanskrit": "सैन्धवे तु महद्द्यूंत समासक्तं परैः सह।\nअत्र ते ध्रुवमायत्तो जयो वाऽजय एव वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2054987, "chapter_id": 2203, "verse_number": "७-१३०-२०", "content_sanskrit": "अत्र सर्वे महाराज त्यक्त्वा जीवितमात्मनः।\nसैन्धवस्य रणे रक्षां विधिवत्कर्तुमर्हथ।\nतत्र नो ग्लहमानानां ध्रुवौ जयपराजयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2054988, "chapter_id": 2203, "verse_number": "७-१३०-२१", "content_sanskrit": "यत्र ते परमेष्वासा यत्ता रक्षन्ति सैन्धवम्।\nतत्र गच्छ स्वयं शीघ्रं तांश्च रक्षस्व रक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2054989, "chapter_id": 2203, "verse_number": "७-१३०-२२", "content_sanskrit": "इहैव त्वहमासिष्ये प्रेषयिष्यामि चापरान्।\nनिरोत्स्यामि च पाञ्चालान्सहितान्पाण्डुसृञ्जयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2054990, "chapter_id": 2203, "verse_number": "७-१३०-२३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2054991, "chapter_id": 2203, "verse_number": "७-१३०-२३", "content_sanskrit": "ततो दुर्योधनोऽगच्छत्तूर्णमाचार्यशासनात्।\nउद्यम्यात्मानमुग्राय कर्मणे स पदानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2054992, "chapter_id": 2203, "verse_number": "७-१३०-२४", "content_sanskrit": "चक्ररक्षौ तु पाञ्चाल्यौ युधामन्यूत्तमौजसौ।\nबाह्येन सेनामभ्येत्य जग्मतुः सव्यसाचिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2054993, "chapter_id": 2203, "verse_number": "७-१३०-२५", "content_sanskrit": "यौ तु पूर्वं महाराज वारितौ कृतवर्मणा।\nप्रविष्टे त्वर्जुने राजंस्तव सैन्यं युयुत्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2054994, "chapter_id": 2203, "verse_number": "७-१३०-२६", "content_sanskrit": "पार्श्वे भित्त्वा चमूं वीरौ प्रविष्टौ तव वाहिनीम्।\nपार्श्वेन सैन्यमायान्तौ कुरुराजो ददर्श ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2054995, "chapter_id": 2203, "verse_number": "७-१३०-२७", "content_sanskrit": "ताभ्यां दुर्योधनः सार्धमकरोत्सङ्ख्यमुत्तमम्।\nत्वरितस्त्वरमाणाभ्यां भ्रातृभ्यां भारतो बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2054996, "chapter_id": 2203, "verse_number": "७-१३०-२८", "content_sanskrit": "तावेनमभ्यद्रवतामुभावुद्यतकार्मुकौ।\nमहारथसमाख्यातौ क्षत्रियप्रवरौ युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2054997, "chapter_id": 2203, "verse_number": "७-१३०-२९", "content_sanskrit": "तमविध्यद्युधामन्युस्त्रिंशता कङ्कपत्रिभिः।\nविंशत्या सारथिं चास्य चतुर्भिश्चतुरो हयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2054998, "chapter_id": 2203, "verse_number": "७-१३०-३०", "content_sanskrit": "दुर्योधनो युधामन्योर्ध्वजमेकेषुणाऽच्छिनत्।\nएकेन कार्मुकं चास्य चकर्त तनयस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2054999, "chapter_id": 2203, "verse_number": "७-१३०-३१", "content_sanskrit": "सारथिं चास्य भल्लेन रथनीडादपाहरत्।\nततोऽविध्यच्छरैस्तीक्ष्णैश्चतुर्भिश्चतुरो हयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2055000, "chapter_id": 2203, "verse_number": "७-१३०-३२", "content_sanskrit": "युधामन्युश्च सङ्क्रुद्धः सरांस्त्रिंशतमाहवे।\nव्यसृजत्तव पुत्रस्य त्वरमाणः स्तनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2055001, "chapter_id": 2203, "verse_number": "७-१३०-३३", "content_sanskrit": "तथोत्तमौजाः सङ्क्रुद्धः शरैर्हेमविभूषितैः।\nअविध्यत्सारथिं चास्य प्राहिणोद्यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2055002, "chapter_id": 2203, "verse_number": "७-१३०-३४", "content_sanskrit": "दुर्योधनोऽपि राजेन्द्र पाञ्चाल्यस्यौत्तमौजसः।\nजघान चतुरोऽस्याश्चानुभौ तौ पार्ष्णिसारथी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2055003, "chapter_id": 2203, "verse_number": "७-१३०-३५", "content_sanskrit": "उत्तमौजा हताश्वस्तु हतसूतश्च संयुगे।\nआरुरोह रथं भ्रातुर्युधामन्योरभित्वरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2055004, "chapter_id": 2203, "verse_number": "७-१३०-३६", "content_sanskrit": "स रथं प्राप्य तं भ्रातुर्दुर्योधनहयाञ्शरैः।\nबहुभिस्ताडयामास ते हताः प्रापतन्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2055005, "chapter_id": 2203, "verse_number": "७-१३०-३७", "content_sanskrit": "हयेषु पतितेष्वस्य चिच्छेद परमेषुणा।\nयुधामन्युर्धनुः शीघ्रं शरावापं च संयुगे।\n`अविध्यत्सारथिं चास्य प्राहिणोद्यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2055006, "chapter_id": 2203, "verse_number": "७-१३०-३८", "content_sanskrit": "हताश्वसूतात्सरथादवतीर्य नराधिपः।\nगदामादाय ते पुत्रः पाञ्चल्यावभ्यधावत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2055007, "chapter_id": 2203, "verse_number": "७-१३०-३९", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य क्रुद्धं कुरुपतिं तदा।\nअवप्लुतौ रथोपस्थाद्युधामन्यूत्तमौजसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2055008, "chapter_id": 2203, "verse_number": "७-१३०-४०", "content_sanskrit": "ततः स हेमचित्रं तं गदया स्यन्दनं गती।\nसङ्क्रुद्धः पोथयामास साश्वसूतध्वजं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2055009, "chapter_id": 2203, "verse_number": "७-१३०-४१", "content_sanskrit": "`एतदीदृशकं पुत्रस्तवाकार्षीज्जनाधिप।\nगदया गदिनां श्रेष्ठः सर्वलोकमहारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2055010, "chapter_id": 2203, "verse_number": "७-१३०-४२", "content_sanskrit": "भङ्क्त्वा रथं स पुत्रस्ते हताश्वो हतसारथिः।\nमद्रराजरथं तूर्णमारुरोह परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2055011, "chapter_id": 2203, "verse_number": "७-१३०-४३", "content_sanskrit": "पाञ्चालानां ततो मुख्यौ राजपुत्रौ महारथौ।\nरथावन्यौ समारुह्य बीभत्सुमभिजग्मुतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2055012, "chapter_id": 2203, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे त्रिंशदधिकशततमोऽध्यायः॥ १३० ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१३०-१७ तान्प्रसिद्धान् यानक्षान्। अक्षान् मन्यमानः प्राग् ग्लहतेस्म इत्यन्वयः॥ ५-१३०-१८ यत्र सभायाम। दूरोदरं द्यूतकारिणम्॥ ५-१३०-२० जयपराजयौ जयः पराजयो वेत्यर्थः॥ ५-१३०-१३० त्रिंशदधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]