[{"id": 7000506000, "chapter_id": 20506, "verse_number": "३-५३-१", "content_sanskrit": "व्यास उवाच ।\nएवं दंडादिभिर्युक्तः शौचाचारसमन्वितः ।\nआहूतोध्यापनं कुर्याद्वीक्ष्यमाणो गुरोर्मुखम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000506001, "chapter_id": 20506, "verse_number": "३-५३-२", "content_sanskrit": "नित्यमुद्यतपाणिः स्यात्साध्वाचारः सुसंयतः ।\nआस्यतामिति चोक्तः सन्नासीताभिमुखं गुरोः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000506002, "chapter_id": 20506, "verse_number": "३-५३-३", "content_sanskrit": "प्रतिश्रवणसंभाषे शयानो न समाचरेत् ।\nआसीनो न च भुंजानो न तिष्ठेन्न पराङ्मुखः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000506003, "chapter_id": 20506, "verse_number": "३-५३-४", "content_sanskrit": "नीचैः शय्यासनं चास्य सर्वदा गुरुसन्निधौ ।\nगुरोस्तु चक्षुर्विषयेन यथेष्टासनो भवेत्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000506004, "chapter_id": 20506, "verse_number": "३-५३-५", "content_sanskrit": "नोदाहरेदस्य नाम परोक्षमपि केवलम् ।\nन चैवास्यानुकुर्वीत गतिभाषणचेष्टितम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000506005, "chapter_id": 20506, "verse_number": "३-५३-६", "content_sanskrit": "गुरोर्यत्र परीवादो निंदा वापि प्रवर्तते ।\nकर्णौ तत्र पिधातव्यौ गंतव्यं वा ततोऽन्यतः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000506006, "chapter_id": 20506, "verse_number": "३-५३-७", "content_sanskrit": "दूरस्थो नार्चयेदेनं न क्रुद्धो नांतिके स्त्रियः ।\nन चैवास्योत्तरं ब्रूयात्स्थितो नासीत सन्निधौ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000506007, "chapter_id": 20506, "verse_number": "३-५३-८", "content_sanskrit": "उदकुंभं कुशान्पुष्पं समिधोऽस्याहरेत्सदा ।\nमार्जनं लेपनं नित्यमंगानां वै समाचरेत्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000506008, "chapter_id": 20506, "verse_number": "३-५३-९", "content_sanskrit": "नास्य निर्माल्यशयनं पादुकोपानहावपि ।\nआक्रामेदासनं चास्य च्छायादीन्वा कदाचन॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000506009, "chapter_id": 20506, "verse_number": "३-५३-१०", "content_sanskrit": "साधयेद्दंतकाष्ठादींल्लब्धं चास्मै निवेदयेत् ।\nअनापृच्छ्य न गंतव्यं भवेत्प्रियहिते रतः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000506010, "chapter_id": 20506, "verse_number": "३-५३-११", "content_sanskrit": "न पादौ सारयेदस्य सन्निधाने कदाचन ।\nजृंभितं हसितं चैव कंठप्रावरणं तथा॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000506011, "chapter_id": 20506, "verse_number": "३-५३-१२", "content_sanskrit": "वर्जयेत्सन्निधौ नित्यमंगस्फोटनमेव च ।\nयथाकालमधीयीत यावन्न विमना गुरुः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000506012, "chapter_id": 20506, "verse_number": "३-५३-१३", "content_sanskrit": "आसीनोऽधो गुरोः पार्श्वे सेवां च सुसमाहितः ।\nआसने शयने याने नैव तिष्ठेत्कदाचन॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000506013, "chapter_id": 20506, "verse_number": "३-५३-१४", "content_sanskrit": "धावंतमनुधावेत गच्छंतमनुगच्छति ।\nगोश्वोष्ट्रयानप्रासादे तथाधोविष्टरेषु च॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000506014, "chapter_id": 20506, "verse_number": "३-५३-१५", "content_sanskrit": "आसीत गुरुणा सार्द्धं शिलाफलक नौषु च ।\nजितेंद्रियः स्यात्सततं वश्यात्माक्रोधनः शुचिः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000506015, "chapter_id": 20506, "verse_number": "३-५३-१६", "content_sanskrit": "प्रयुंजीत सदा वाचं मधुरां हितकारिणीम् ।\nगंधमाल्यं रसं कल्पं शुक्तिं प्राणिविहिंसनम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000506016, "chapter_id": 20506, "verse_number": "३-५३-१७", "content_sanskrit": "अभ्यंजनांजनोन्मर्द्दच्छत्रधारणमेव च ।\nकामं लोभं भयं निद्रां गीतवादित्रनर्तनम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000506017, "chapter_id": 20506, "verse_number": "३-५३-१८", "content_sanskrit": "आतर्जनं परीवादं स्त्रीप्रेक्षालंभनं तथा ।\nपरोपघातं पैशुन्यं प्रयत्नेन विवर्जयेत्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000506018, "chapter_id": 20506, "verse_number": "३-५३-१९", "content_sanskrit": "उदकुंभं सुमनसो गोशकृन्मृत्तिका कुशान् ।\nआहरेद्यावदन्नानि भैक्ष्यं चाहरहश्चरेत्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000506019, "chapter_id": 20506, "verse_number": "३-५३-२०", "content_sanskrit": "घृतं च लवणं सर्वं वर्ज्यं पर्युषितं च यत् ।\nअनृत्यदर्शी सततं भवेद्गीतादि निस्पृहः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000506020, "chapter_id": 20506, "verse_number": "३-५३-२१", "content_sanskrit": "नादित्यं वै समीहेत नाचरेद्दंतधावनम् ।\nएकांतमशुचिस्त्रीभिः शूद्राद्यैरभिभाषणम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000506021, "chapter_id": 20506, "verse_number": "३-५३-२२", "content_sanskrit": "गुरूच्छिष्टं भेषजान्नं प्रयुंजीत न कामतः ।\nमलापकर्षणं स्नानं नाचरेद्धि कदाचन॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000506022, "chapter_id": 20506, "verse_number": "३-५३-२३", "content_sanskrit": "न कुर्यान्मानसं विप्रो गुरोस्त्यागे कथंचन ।\nमोहाद्वा यदि वा लोभात्त्यक्त्वा तु पतितो भवेत्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000506023, "chapter_id": 20506, "verse_number": "३-५३-२४", "content_sanskrit": "लौकिकं वैदिकं वापि तथाध्यात्मिकमेव वा ।\nआददीत यतो ज्ञानं तं न द्रुह्येत्कदाचन॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000506024, "chapter_id": 20506, "verse_number": "३-५३-२५", "content_sanskrit": "गुरोरप्यवलिप्तस्य कार्याकार्यमजानतः ।\nउत्पथप्रतिपन्नस्य न मनुस्त्यागमब्रवीत्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000506025, "chapter_id": 20506, "verse_number": "३-५३-२६", "content_sanskrit": "गुरोर्गुरौ सन्निहिते गुरुवद्वृत्तिमाचरेत् ।\nनत्वाभिसृष्टो गुरुणा स्वान्गुरूनभिवादयेत्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000506026, "chapter_id": 20506, "verse_number": "३-५३-२७", "content_sanskrit": "विद्यागुरुष्वेतदेवं नित्यावृत्तिषु योगिषु ।\nप्रतिषेधत्सु चाधर्माद्धितं चोपदिशत्सु च॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000506027, "chapter_id": 20506, "verse_number": "३-५३-२८", "content_sanskrit": "श्रेयः स्वगुरुवद्वृत्तिं नित्यमेव समाचरेत् ।\nगुरुपुत्रेषु दारेषु गुरोश्चैव स्वबंधुषु॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000506028, "chapter_id": 20506, "verse_number": "३-५३-२९", "content_sanskrit": "बालः संमानयेन्मान्याञ्छिष्टो वा यदि कर्म्मणि ।\nअध्यापयन्गुरोः सूनुं गुरुवन्मानमर्हति॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000506029, "chapter_id": 20506, "verse_number": "३-५३-३०", "content_sanskrit": "उत्सादनं च गात्राणां स्नापनोच्छिष्टभोजनः ।\nन कुर्याद्गुरुपुत्रस्य पादयोः शौचमेव च॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000506030, "chapter_id": 20506, "verse_number": "३-५३-३१", "content_sanskrit": "गुरुवत्प्रतिपूज्याश्च सवर्णा गुरुयोषितः ।\nअसवर्णाश्च संपूज्याः प्रत्युत्थानाभिवादनैः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000506031, "chapter_id": 20506, "verse_number": "३-५३-३२", "content_sanskrit": "अभ्यंजनं स्नापनं च गात्रोत्सादनमेव च ।\nगुरुपत्न्या न कार्याणि केशानां च प्रसाधनम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000506032, "chapter_id": 20506, "verse_number": "३-५३-३३", "content_sanskrit": "गुरुपत्नी तु युवती नाभिवाद्या तु पादयोः ।\nकुर्वीत वंदनं भूम्यामसावहमिति ब्रुवन्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000506033, "chapter_id": 20506, "verse_number": "३-५३-३४", "content_sanskrit": "विप्रोष्य पादग्रहणपूर्वकं चाभिवादनम् ।\nगुरुदारेषु कुर्वीत सतां धर्म्ममनुस्मरन्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000506034, "chapter_id": 20506, "verse_number": "३-५३-३५", "content_sanskrit": "मातृष्वसा मातुलानी श्वश्रूश्चाथ पितृष्वसा ।\nसंपूज्या गुरुपत्नीवत्समास्ता गुरुभार्यया॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000506035, "chapter_id": 20506, "verse_number": "३-५३-३६", "content_sanskrit": "भ्रातृभार्याश्च संग्राह्या सवर्णा हन्यहन्यपि ।\nविप्रोष्य तूपसंग्राह्या ज्ञातिसंबंधियोषितः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000506036, "chapter_id": 20506, "verse_number": "३-५३-३७", "content_sanskrit": "पितुर्भगिन्या मातुश्च जायस्यां च स्वसर्यपि ।\nमातृवद्वृत्तिमातिष्ठेन्माता ताभ्यो गरीयसी॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000506037, "chapter_id": 20506, "verse_number": "३-५३-३८", "content_sanskrit": "एवमाचारसंपन्नमात्मवंतमदांभिकम् ।\nवेदमध्यापयेद्धर्म्मं पुराणांगानि नित्यशः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000506038, "chapter_id": 20506, "verse_number": "३-५३-३९", "content_sanskrit": "संवत्सरोषिते शिष्ये गुरुर्ज्ञानमनिर्दिशन् ।\nहरते दुष्कृतं तस्य शिष्यस्य वसतो गुरुः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000506039, "chapter_id": 20506, "verse_number": "३-५३-४०", "content_sanskrit": "आचार्यपुत्रः शुश्रूषुर्ज्ञानदो धार्मिकः शुचिः ।\nशक्तोन्नदोंबुदः साधुरध्याप्यादश धर्मतः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000506040, "chapter_id": 20506, "verse_number": "३-५३-४१", "content_sanskrit": "कृतकंठस्तथाऽद्रोहः मेधावी गुरुकृन्नरः ।\nआप्तः प्रियोऽथ विधिवत्षडध्याप्या द्विजातयः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000506041, "chapter_id": 20506, "verse_number": "३-५३-४२", "content_sanskrit": "एतेषु ब्राह्मणे दानमन्यत्र तु यथोचितम् ।\nआचम्य संयतो नित्यमधीयीत उदङ्मुखः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000506042, "chapter_id": 20506, "verse_number": "३-५३-४३", "content_sanskrit": "उपसंगृह्य तत्पादौ वीक्ष्यमाणो गुरोर्मुखम् ।\nअधीष्व भो इति ब्रूयाद्विरामोऽस्त्विति चाऽरमेत्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000506043, "chapter_id": 20506, "verse_number": "३-५३-४४", "content_sanskrit": "प्राक्कूलान्पर्युपासीत पवित्रैश्चैव पावकः ।\nप्राणायामैस्त्रिभिः पूतस्ततोंकारमर्हति॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000506044, "chapter_id": 20506, "verse_number": "३-५३-४५", "content_sanskrit": "ब्राह्मणः प्रणवं कुर्यादंतेऽपि विधिवद्द्विजाः ।\nकुर्यादध्यापनं नित्यं सब्रह्मांजलिपूर्वतः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000506045, "chapter_id": 20506, "verse_number": "३-५३-४६", "content_sanskrit": "सर्वेषामेव भूतानां वेदश्चक्षुः सनातनः ।\nअधीयीताप्ययं नित्यं ब्राह्मण्याद्धीयतेऽन्यथा॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000506046, "chapter_id": 20506, "verse_number": "३-५३-४७", "content_sanskrit": "अधीयीत ऋचो नित्यं क्षीराहुत्या सदेवताः ।\nप्रीणाति तर्पयन्कालं कामैर्हूताः सदैवताः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000506047, "chapter_id": 20506, "verse_number": "३-५३-४८", "content_sanskrit": "यजूंष्यधीते नियतं दध्ना प्रीणाति देवताः ।\nसामान्यधीते प्रीणाति घृताहुतिभिरन्वहम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000506048, "chapter_id": 20506, "verse_number": "३-५३-४९", "content_sanskrit": "अथर्वांगिरसो नित्यं मध्वा प्रीणाति देवताः ।\nधर्मांगानि पुराणानि मांसैस्तर्पयतेसुरान्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000506049, "chapter_id": 20506, "verse_number": "३-५३-५०", "content_sanskrit": "प्रातश्च सायं प्रयतो नैत्यकं विधिमाश्रितः ।\nगायत्रीं समधीयीत गत्वारण्यं समाहितः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000506050, "chapter_id": 20506, "verse_number": "३-५३-५१", "content_sanskrit": "सहस्रपरमां देवीं शतमध्यां दशावराम् ।\nगायत्रीं वै जपेन्नित्यं जपयज्ञः प्रकीर्तितः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000506051, "chapter_id": 20506, "verse_number": "३-५३-५२", "content_sanskrit": "गायत्रीं चैव वेदांश्च तुलया तोलयत्प्रभुः ।\nएकतश्चतुरोवेदा गायत्रीं च तथैकतः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000506052, "chapter_id": 20506, "verse_number": "३-५३-५३", "content_sanskrit": "ओंकारमादितः कृत्वा व्याहृतीस्तदनंतरम् ।\nततोऽधीयीत सावित्रीमेकाग्रः श्रद्धयान्वितः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000506053, "chapter_id": 20506, "verse_number": "३-५३-५४", "content_sanskrit": "पुराकल्पे समुत्पन्ना भूर्भुवः स्वः सनातनाः ।\nमहाव्याहृतयस्तिस्रः सर्वाशुभनिबर्हणाः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000506054, "chapter_id": 20506, "verse_number": "३-५३-५५", "content_sanskrit": "प्रधानं पुरुषः कालो विष्णुब्रह्ममहेश्वराः ।\nसत्वंरजस्तमस्तिस्रः क्रमाद्व्याहृतयः स्मृताः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000506055, "chapter_id": 20506, "verse_number": "३-५३-५६", "content_sanskrit": "ओंकारस्तत्परं ब्रह्म सावित्री स्यात्तदुत्तरम् ।\nएष मंत्रो महायोगः सारात्सार उदाहृतः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000506056, "chapter_id": 20506, "verse_number": "३-५३-५७", "content_sanskrit": "योऽधीतेऽहन्यहन्येतां गायत्रीं वेदमातरम् ।\nविज्ञायार्थं ब्रह्मचारी स याति परमां गतिम्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000506057, "chapter_id": 20506, "verse_number": "३-५३-५८", "content_sanskrit": "गायत्री वेदजननी गायत्री लोकपावनी ।\nगायत्र्या न परं जप्यमेतद्विज्ञायमुच्यते॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000506058, "chapter_id": 20506, "verse_number": "३-५३-५९", "content_sanskrit": "श्रावणस्य तु मासस्य पौर्णमास्यां द्विजोत्तमाः ।\nआषाढ्यां प्रोष्ठपद्यां वा वेदोपाकरणं स्मृतम्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000506059, "chapter_id": 20506, "verse_number": "३-५३-६०", "content_sanskrit": "यत्सूर्ययाम्यगमनं मासान्विप्रोर्द्धपंचमान् ।\nअधीयीत शुचौ देशे ब्रह्मचारी समाहितः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000506060, "chapter_id": 20506, "verse_number": "३-५३-६१", "content_sanskrit": "पुष्ये तुच्छंदसां कुर्याद्बहिरुत्सर्जनं द्विजः ।\nमासि शुक्लस्य वा प्राप्ते पूर्वाह्णे प्रथमेऽहनि॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000506061, "chapter_id": 20506, "verse_number": "३-५३-६२", "content_sanskrit": "छदांसि च द्विजोऽभ्यस्येच्छुक्लपक्षे तु वै द्विजः ।\nवेदांगानि पुराणानि कृष्णपक्षेषु मानवः॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000506062, "chapter_id": 20506, "verse_number": "३-५३-६३", "content_sanskrit": "इमान्नित्यमनध्यायानधीयानो विवर्जयेत् ।\nअध्यापनं च कुर्वाणोऽभ्यस्यन्नपि प्रयत्नतः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000506063, "chapter_id": 20506, "verse_number": "३-५३-६४", "content_sanskrit": "कर्णश्रवेऽनिले रात्रौ दिवापांसुसमूहने ।\nविद्युत्स्तनितवर्षेषु महोल्कानां च संप्लवे॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000506064, "chapter_id": 20506, "verse_number": "३-५३-६५", "content_sanskrit": "अकालिकमनध्यायमेतेष्वाह प्रजापतिः ।\nएतानभ्युदिनान्विद्याद्यदा प्रादुष्कृताग्निषु॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000506065, "chapter_id": 20506, "verse_number": "३-५३-६६", "content_sanskrit": "तदा विद्यादनध्यायमनृतौ चाभ्रदर्शने ।\nनिर्घाते भूमिचलने ज्योतिषां चोपसर्जने॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000506066, "chapter_id": 20506, "verse_number": "३-५३-६७", "content_sanskrit": "एतानकालिकान्विद्यादनध्यायानृतावपि ।\nप्रादुष्कृतेष्वग्निषु च विद्युत्स्तनितनिस्वने॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000506067, "chapter_id": 20506, "verse_number": "३-५३-६८", "content_sanskrit": "सज्योतिः स्यादनध्यायः शेषे रात्रौ यथा दिवा ।\nनित्यानध्याय एव स्याद्ग्रामेषु नगरेषु च॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000506068, "chapter_id": 20506, "verse_number": "३-५३-६९", "content_sanskrit": "धर्मनैपुण्यकामानां पूतिगंधे च नित्यशः ।\nअंतः शवगतेग्रामे वृषलस्य च सन्निधौ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000506069, "chapter_id": 20506, "verse_number": "३-५३-७०", "content_sanskrit": "अनध्यायोरुद्यमाने समये जलदस्य च ।\nउदके चार्धरात्रे च विण्मूत्रं च विसर्जयन्॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000506070, "chapter_id": 20506, "verse_number": "३-५३-७१", "content_sanskrit": "उच्छिष्टः श्राद्धभुक्चैव मनसापि न चिंतयेत् ।\nप्रतिगृह्य द्विजो विद्वानेकोद्दिष्टस्य वेतनम्॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000506071, "chapter_id": 20506, "verse_number": "३-५३-७२", "content_sanskrit": "त्र्यहं न कारयेद्ब्रह्म राज्ञो राहोश्च सूतके ।\nयावदेकान्ननिष्ठा स्यात्स्नेहालोपश्च तिष्ठति॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000506072, "chapter_id": 20506, "verse_number": "३-५३-७३", "content_sanskrit": "विप्रस्य विदुषो देहे तावद्ब्रह्म न कीर्तयेत् ।\nशयानः प्रौढपादश्च कृत्वा चैवावसक्थिकाम्॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000506073, "chapter_id": 20506, "verse_number": "३-५३-७४", "content_sanskrit": "नाधीयीतामिषं जग्ध्वा शूद्रश्राद्धान्नमेव च ।\nनीहारे बाणशब्दे च संध्ययोरुभयोरपि॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000506074, "chapter_id": 20506, "verse_number": "३-५३-७५", "content_sanskrit": "अमावास्या चतुर्दश्योः पौर्णमास्यष्टमीषु च ।\nउपाकर्मणि चोत्सर्गे त्रिरात्रं क्षपणं स्मृतम्॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000506075, "chapter_id": 20506, "verse_number": "३-५३-७६", "content_sanskrit": "अष्टकासु अहोरात्रमृत्वंतासु च रात्रिषु ।\nमार्गशीर्षे तथा पौषे माघमासे तथैव च॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000506076, "chapter_id": 20506, "verse_number": "३-५३-७७", "content_sanskrit": "तिस्रोऽष्टकाः समाख्याता कृष्णपक्षेषु सूरिभिः ।\nश्लेष्मातकस्य च्छायायां शाल्मलेर्मधुकस्य च॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000506077, "chapter_id": 20506, "verse_number": "३-५३-७८", "content_sanskrit": "कदाचिदपि नाध्येयं कोविदारकपित्थयोः ।\nसमानविद्ये च मृते तथा सब्रह्मचारिणि॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000506078, "chapter_id": 20506, "verse_number": "३-५३-७९", "content_sanskrit": "आचार्ये संस्थिते चापि त्रिरात्रं क्षपणं स्मृतम् ।\nछिद्राण्येतानि विप्राणामनध्यायाः प्रकीर्तिताः॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000506079, "chapter_id": 20506, "verse_number": "३-५३-८०", "content_sanskrit": "हिंसंति राक्षसास्तेषु तस्मादेतान्विवर्जयेत् ।\nनैत्यकेनास्त्यनध्यायः संध्योपासनमेव च॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000506080, "chapter_id": 20506, "verse_number": "३-५३-८१", "content_sanskrit": "उपाकर्म्मणि होमांते होममध्ये तथैव च ।\nएकामृचमथैकं वा यजुः सामानि वा पुनः॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000506081, "chapter_id": 20506, "verse_number": "३-५३-८२", "content_sanskrit": "नाष्टकाद्यास्वधीयीत मारुते चाभिधावति ।\nअनध्यायस्तु नांगेषु नेतिहासपुराणयोः॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000506082, "chapter_id": 20506, "verse_number": "३-५३-८३", "content_sanskrit": "न धर्मशास्त्रेष्वन्येषु सर्वाण्येतानि वर्जयेत् ।\nएष धर्मः समासेन कीर्तितो ब्रह्मचारिणः॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000506083, "chapter_id": 20506, "verse_number": "३-५३-८४", "content_sanskrit": "ब्रह्मणाऽभिहितः पूर्वमृषीणां भावितात्मनाम् ।\nयोऽन्यत्र कुरुते यत्नमनधीत्य श्रुतिं द्विजः॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000506084, "chapter_id": 20506, "verse_number": "३-५३-८५", "content_sanskrit": "स संमूढो न संभाष्यो वेदबाह्यो द्विजातिभिः ।\nन वेदपाठमात्रेण संतुष्टो वै भवेद्द्विजः॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000506085, "chapter_id": 20506, "verse_number": "३-५३-८६", "content_sanskrit": "पाठमात्रावसानस्तु पंके गौरिव सीदति ।\nयोऽधीत्य विधिवद्वेदं वेदार्थं न विचारयेत्॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000506086, "chapter_id": 20506, "verse_number": "३-५३-८७", "content_sanskrit": "स संमूढः शूद्रकल्पः पात्रतां न प्रपद्यते ।\nयदित्वात्यंतिकं वासं कर्तुमिच्छति वै गुरौ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000506087, "chapter_id": 20506, "verse_number": "३-५३-८८", "content_sanskrit": "युक्तः परिचरेदेनमाशरीरविमोक्षणम् ।\nगत्वा वनं च विधिवज्जुहुयाज्जातवेदसम्॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000506088, "chapter_id": 20506, "verse_number": "३-५३-८९", "content_sanskrit": "अधीयीत तथा नित्यं ब्रह्मनिष्ठः समाहितः ।\nसावित्रीं शतरुद्रीयं वेदांतांश्च विशेषतः ।\nअभ्यसेत्सततं युक्तो भिक्षाशनपरायणः॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000506089, "chapter_id": 20506, "verse_number": "३-५३-९०", "content_sanskrit": "एतद्विधानं परमं पुराणं वेदागमे सम्यगिहोदितं वः ।\nपुरा महर्षिप्रवराभिपृष्टः स्वायंभुवो यन्मनुराह देवः॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]