[{"id": 2035152, "chapter_id": 1760, "verse_number": "५-५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035153, "chapter_id": 1760, "verse_number": "५-५-१", "content_sanskrit": "द्रुपदेनैवमुक्ते तु वाक्ये वाक्यविदां वरः।\nवसुदेवसुतस्तत्र पृष्णिसिंहोऽब्रवीदिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035154, "chapter_id": 1760, "verse_number": "५-५-२", "content_sanskrit": "उपपन्नमिदं वाक्यं सोमकानां धुरंधरे।\nअर्थसिद्धिकरं राज्ञः पाण्डवस्यामितौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035155, "chapter_id": 1760, "verse_number": "५-५-३", "content_sanskrit": "एतच्च पूर्वं कार्यं नः सुनीतिमभिकाङ्क्षताम्।\nअन्यथा ह्याचरन्कर्म पुरुषः स्यात्सुबालिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035156, "chapter_id": 1760, "verse_number": "५-५-४", "content_sanskrit": "किं तु संबन्धकं तुल्यमस्माकं कुरुपाण्डुषु।\nयथेष्टं वर्तमानेषु पाण्डवेषु च तेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035157, "chapter_id": 1760, "verse_number": "५-५-५", "content_sanskrit": "ते विवाहार्थमानीता वयं सर्वे तथा भवान् ।\nकृते विवाहे मुदिता गमिष्यामो गृहान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035158, "chapter_id": 1760, "verse_number": "५-५-६", "content_sanskrit": "भवान्वृद्धतमो राज्ञां वयसा च श्रुतेन च।\nशिष्यवत्ते वयं सर्वे भवामेह न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035159, "chapter_id": 1760, "verse_number": "५-५-७", "content_sanskrit": "भवन्तं धृतराष्ट्रश्च सततं बहु मन्यते।\nआचार्ययोः सखा चासि द्रोणस्य च कृपस्व च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035160, "chapter_id": 1760, "verse_number": "५-५-८", "content_sanskrit": "स भवान्प्रेषयत्वद्य पाण्डवार्थकरं वचः।\nसर्वेषां निश्चितं तन्नः प्रेषयिष्यति यद्भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035161, "chapter_id": 1760, "verse_number": "५-५-९", "content_sanskrit": "यदि तावच्छमं कुर्यन्न्यायेन कुरुपुङ्गवः।\nन भवेत्कुरुपाण्डूनां सौभ्रात्रेण महान्क्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035162, "chapter_id": 1760, "verse_number": "५-५-१०", "content_sanskrit": "अथ दर्पान्वितो मोहान्न कुर्याद्धृतराष्ट्रजः ।\nअन्येषां प्रेषयित्वा च पश्चादस्मान्सभाह्वये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035163, "chapter_id": 1760, "verse_number": "५-५-११", "content_sanskrit": "ततो दुर्योधनो मन्दः सहामात्यः सबान्धवः ।\nनिष्ठामापत्स्यते मूढः क्रुद्धे गाण्डीवधन्वनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035164, "chapter_id": 1760, "verse_number": "५-५-१२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035165, "chapter_id": 1760, "verse_number": "५-५-१२", "content_sanskrit": "ततः सत्कृत्य वार्ष्णेयं विराटः पृथिवीपतिः ।\nगृहान्प्रस्थापयामास सगणं सहबान्धवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035166, "chapter_id": 1760, "verse_number": "५-५-१३", "content_sanskrit": "द्वारकं तु गते कृष्णे युधिष्ठिरपुरोगमाः।\nचक्रुः साङ्घ्रामिकं सर्वं विराटश्च महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035167, "chapter_id": 1760, "verse_number": "५-५-१४", "content_sanskrit": "ततः संप्रेषयामास विराटः सह बान्धवैः ।\nसर्वेषां भूमिपालानां द्रुपदश्च महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035168, "chapter_id": 1760, "verse_number": "५-५-१५", "content_sanskrit": "वचनात्कुरुसिंहानां मत्स्यपाञ्चालयोश्च ते ।\nसमाजग्मुर्महीपालाः संप्रहृष्टा महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035169, "chapter_id": 1760, "verse_number": "५-५-१६", "content_sanskrit": "तच्छ्रुत्वा पाण्डुपुत्राणां समागच्छन्महद्बलम् ।\nधृतराष्ट्रसुताश्चापि समानिन्युर्महीपतीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035170, "chapter_id": 1760, "verse_number": "५-५-१७", "content_sanskrit": "समाकुला मही राजन्कुरुपाण्डवकारणात्।\nतदा समभवत्कृत्स्ना संप्रयाणे महीक्षिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035171, "chapter_id": 1760, "verse_number": "५-५-१८", "content_sanskrit": "संकुला च तदा भूमिश्चतुरङ्गवलान्विता।\nबलानि तेषां वीराणामागच्छन्ति ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035172, "chapter_id": 1760, "verse_number": "५-५-१९", "content_sanskrit": "चालयन्तीव गां देवीं सपर्वतवनामिमाम्।\nततः प्रज्ञावयोवृद्धं पाञ्चाल्यः स्वपुरोहितम्।\nकुरुभ्यः प्रेषयामास युधिष्ठिरमते स्थितः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035173, "chapter_id": 1760, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सेनोद्येगपर्वणि प़ञ्चमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]