[{"id": 2003514, "chapter_id": 1069, "verse_number": "१-७०-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2003515, "chapter_id": 1069, "verse_number": "१-७०-१", "content_sanskrit": "ययातिः पूर्वजोऽस्माकं दशमो यः प्रजापतेः।\nकथं स शुक्रतनयां लेभे परमदुर्लभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2003516, "chapter_id": 1069, "verse_number": "१-७०-२", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं विस्तरेण तपोधन।\nआनुपूर्व्या च मे शंस राज्ञो वंशकरान्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2003517, "chapter_id": 1069, "verse_number": "१-७०-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2003518, "chapter_id": 1069, "verse_number": "१-७०-३", "content_sanskrit": "ययातिरासीन्नृपतिर्देवराजसमद्युतिः।\nतं शुक्रवृषपर्वाणौ वव्राते वै यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2003519, "chapter_id": 1069, "verse_number": "१-७०-४", "content_sanskrit": "तत्तेऽहं संप्रवक्ष्यामि पृच्छते जनमेजय।\nदेवयान्याश्च संयोगं ययातेर्नाहुषस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2003520, "chapter_id": 1069, "verse_number": "१-७०-५", "content_sanskrit": "सुराणामसुराणां च समजायत वै मिथः।\nऐश्वर्यं प्रति संघर्षस्त्रैलोक्ये सचराचरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2003521, "chapter_id": 1069, "verse_number": "१-७०-६", "content_sanskrit": "जिगीषया ततो देवा वव्रिरेऽङ्गिरसं मुनिम्।\nपौरोहित्येन याज्यार्थे काव्यं तूशनसं परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2003522, "chapter_id": 1069, "verse_number": "१-७०-७", "content_sanskrit": "ब्राह्मणौ तावुभौ नित्यमन्योन्यस्पर्धिनौ भृशम्।\nतत्र देवा निजघ्नुर्यान्दानवान्युधि संगतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2003523, "chapter_id": 1069, "verse_number": "१-७०-८", "content_sanskrit": "तान्पुनर्जीवयामास काव्यो विद्याबलाश्रयात्।\nततस्ते पुनरुत्थाय योधयांचक्रिरे सुरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2003524, "chapter_id": 1069, "verse_number": "१-७०-९", "content_sanskrit": "असुरास्तु निजघ्नुर्यान्सुरान्समरमूर्धनि।\nन तान्सञ्जीवयामास बृहस्पतिरुदारधीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2003525, "chapter_id": 1069, "verse_number": "१-७०-१०", "content_sanskrit": "न हि वेद स तां विद्यां यां काव्योवेत्ति वीर्यवान्।\nसञ्जीविनीं ततो देवा विषादमगमन्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2003526, "chapter_id": 1069, "verse_number": "१-७०-११", "content_sanskrit": "ते तु देवा भयोद्विग्नाः काव्यादुशनसस्तदा।\nऊचुः कचमुपागम्य ज्येष्ठं पुत्रं बृहस्पतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2003527, "chapter_id": 1069, "verse_number": "१-७०-१२", "content_sanskrit": "भजमानान्भजस्वास्मान्कुरु नः साह्यमुत्तमम्।\nया सा विद्या निवसति ब्राह्मणेऽमिततेजसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2003528, "chapter_id": 1069, "verse_number": "१-७०-१३", "content_sanskrit": "शुक्रे तामाहर क्षिप्रं भागभाङ्गो भविष्यसि।\nवृषपर्वसमीपे हि शक्यो द्रष्टुं त्वया द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2003529, "chapter_id": 1069, "verse_number": "१-७०-१४", "content_sanskrit": "रक्षते दानवांस्तत्र न स रक्षत्यदानवान्।\nतमाराधयितुं शक्तो भवान्पूर्ववयाः कविम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2003530, "chapter_id": 1069, "verse_number": "१-७०-१५", "content_sanskrit": "देवयानीं च दयितां सुतां तस्य महात्मनः।\nत्वमाराधयितुं शक्तो नान्यः कश्चन विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2003531, "chapter_id": 1069, "verse_number": "१-७०-१६", "content_sanskrit": "शीलदाक्षिण्यमाधुर्यैराचारेण दमेन च।\nदेवयान्यां हि तुष्टायां विद्यां तां प्राप्स्यसि ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2003532, "chapter_id": 1069, "verse_number": "१-७०-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2003533, "chapter_id": 1069, "verse_number": "१-७०-१७", "content_sanskrit": "तथेत्युक्त्वा ततः प्रायाद्बृहस्पतिसुतः कचः।\nतदाऽभिपूजितो देवैः समीपे वृषपर्वणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2003534, "chapter_id": 1069, "verse_number": "१-७०-१८", "content_sanskrit": "स गत्वा त्वरितो राजन्देवैः संप्रेषितः कचः।\nअसुरेन्द्रपुरे शुक्रं दृष्ट्वा वाक्यमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2003535, "chapter_id": 1069, "verse_number": "१-७०-१९", "content_sanskrit": "ऋषेरङ्गिरसः पौत्रं पुत्रं साक्षाद्बृहस्पतेः।\nनाम्ना कच इति ख्यातं शिष्यं गृह्णात् मां भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2003536, "chapter_id": 1069, "verse_number": "१-७०-२०", "content_sanskrit": "ब्रह्मचर्यं चरिष्यामि त्वय्यहं परमं गुरौ।\nअनुमन्यस्व मां ब्रह्मन्सहस्रं परिवत्सरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2003537, "chapter_id": 1069, "verse_number": "१-७०-२१x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2003538, "chapter_id": 1069, "verse_number": "१-७०-२१", "content_sanskrit": "कच सुस्वागतं तेऽस्तु प्रतिगृह्णामि ते वचः।\nअर्चयिष्येऽहमर्च्यं त्वामर्चितोऽस्तु बृहस्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2003539, "chapter_id": 1069, "verse_number": "१-७०-२२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2003540, "chapter_id": 1069, "verse_number": "१-७०-२२", "content_sanskrit": "कचस्तु तं तथेत्युक्त्वा प्रतिजग्राह तद्व्रतम्।\nआदिष्टं कविपुत्रेण शुक्रेणोशनसा स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2003541, "chapter_id": 1069, "verse_number": "१-७०-२३", "content_sanskrit": "व्रतस्य प्राप्तकालं स यथोक्तं प्रत्यगृह्णत।\nआराधयन्नुपाध्यायं देवयानीं च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2003542, "chapter_id": 1069, "verse_number": "१-७०-२४", "content_sanskrit": "नित्यमाराधयिष्यंस्तां युवा यौवनगां मुनिः।\nगायन्नृत्यन्वादयंश्च देवयानीमतोषयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2003543, "chapter_id": 1069, "verse_number": "१-७०-२५", "content_sanskrit": "स शीलयन्देवयानीं कन्यां संप्राप्तयौवनाम्।\nपुष्पैः फलैः प्रेषणैश्च तोषयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2003544, "chapter_id": 1069, "verse_number": "१-७०-२६", "content_sanskrit": "देवयान्यपि तं विप्रं नियमव्रतधारिणम्।\nगायन्ती च ललन्ती च रहः पर्यचरत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2003545, "chapter_id": 1069, "verse_number": "१-७०-२७", "content_sanskrit": "गायन्तं चैव शुल्कं च दातारं प्रियवादिनम्।\nनार्यो नरं कामयन्ते रूपिणं स्रग्विणं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2003546, "chapter_id": 1069, "verse_number": "१-७०-२८", "content_sanskrit": "पञ्चवर्षशतान्येवं कचस्य चरतो व्रतम्।\nतत्रातीयुरथो बुद्ध्वा दानवास्तं ततः कचम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2003547, "chapter_id": 1069, "verse_number": "१-७०-२९", "content_sanskrit": "गा रक्षन्तं वने दृष्ट्वा रहस्येकममर्षिताः।\nजघ्नुर्बृहस्पतेर्द्वेषाद्विद्यारक्षार्थमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2003548, "chapter_id": 1069, "verse_number": "१-७०-३०", "content_sanskrit": "हत्वा शालावृकेभ्यश्च प्रायच्छँल्लवशः कृतम्।\nततो गावो निवृत्तास्ता अगोपाः स्वं निवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2003549, "chapter_id": 1069, "verse_number": "१-७०-३१", "content_sanskrit": "सा दृष्ट्वा रहिता गाश्च कचेनाभ्यागता वनात्।\nउवाच वचनं काले देवयान्यथ भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2003550, "chapter_id": 1069, "verse_number": "१-७०-३२x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2003551, "chapter_id": 1069, "verse_number": "१-७०-३२", "content_sanskrit": "आहुतं चाग्निहोत्रं ते सूर्यश्चास्तं गतः प्रभो।\nअगोपाश्चागता गावः कचस्तात न दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2003552, "chapter_id": 1069, "verse_number": "१-७०-३३", "content_sanskrit": "व्यक्तं हतो मृतो वापि कचस्तात भविष्यति।\nतं विना न च जीवेयमिति सत्यं ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2003553, "chapter_id": 1069, "verse_number": "१-७०-३४x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2003554, "chapter_id": 1069, "verse_number": "१-७०-३४", "content_sanskrit": "अयमेहीति संशब्द्य मृतं संजीवयाम्यहम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2003555, "chapter_id": 1069, "verse_number": "१-७०-३४x", "content_sanskrit": "वैशम्पायन उवाच।\nततः संजीविनीं विद्यां प्रयुज्य कचमाह्वयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2003556, "chapter_id": 1069, "verse_number": "१-७०-३५", "content_sanskrit": "भित्त्वा भित्त्वा शरीराणि वृकाणां स विनिर्गतः।\nआहूतः प्रादुरभवत्कचो हृष्टोऽथ विद्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2003557, "chapter_id": 1069, "verse_number": "१-७०-३६", "content_sanskrit": "कस्माच्चिरायितोऽसीति पृष्टस्तामाह भार्गवीम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2003558, "chapter_id": 1069, "verse_number": "१-७०-३६x", "content_sanskrit": "कच उवाच।\nसमिधश्च कुशादीनि काष्ठभारं च भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2003559, "chapter_id": 1069, "verse_number": "१-७०-३७", "content_sanskrit": "गृहीत्वा श्रमभारार्तो वटवृक्षं समाश्रितः।\nगावश्च सहिताः सर्वा वृक्षच्छायामुपाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2003560, "chapter_id": 1069, "verse_number": "१-७०-३८", "content_sanskrit": "असुरास्तत्र मां दृष्ट्वा कस्त्वमित्यभ्यचोदयन्।\nबृहस्पतिसुतश्चाहं कच इत्यभिविश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2003561, "chapter_id": 1069, "verse_number": "१-७०-३९", "content_sanskrit": "इत्युक्तमात्रे मां हत्वा पेषीकृत्वा तु दानवाः।\nदत्त्वा शालावृकेभ्यस्तु सुखं जग्मुः स्वमालयं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2003562, "chapter_id": 1069, "verse_number": "१-७०-४०", "content_sanskrit": "आहूतो विद्यया भद्रे भार्गवेण महात्मना।\nत्वत्समीपमिहायातः कथंचित्प्राप्तजीवितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2003563, "chapter_id": 1069, "verse_number": "१-७०-४१", "content_sanskrit": "हतोऽहमिति चाचख्यौ पृष्टो ब्राह्मणकन्यया।\nस पुनर्देवयान्योक्तः पुष्पाण्याहर मे द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2003564, "chapter_id": 1069, "verse_number": "१-७०-४२", "content_sanskrit": "वनं ययौ कचो विप्रो ददृशुर्दानवाश्च तम्।\nपुनस्तं पेषयित्वा तु समुद्राम्भस्यमिश्रयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2003565, "chapter_id": 1069, "verse_number": "१-७०-४३", "content_sanskrit": "चिरं गतं पुनः कन्या पित्रे तं संन्यवेदयत्।\nविप्रेण पुनराहूतो विद्यया गुरुदेहजः।\nपुनरावृत्य तद्वृत्तं न्यवेदयत तद्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2003566, "chapter_id": 1069, "verse_number": "१-७०-४४", "content_sanskrit": "ततस्तृतीयं हत्वा तं दग्ध्वा कृत्वा च चूर्णशः।\nप्रायच्छन्ब्राह्मणायैव सुरायामसुरास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2003567, "chapter_id": 1069, "verse_number": "१-७०-४५", "content_sanskrit": "अपिबत्सुरया सार्धं कचभस्म भृगूद्वहः।\nसा सायन्तनवेलायामगोपा गाः समागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2003568, "chapter_id": 1069, "verse_number": "१-७०-४६", "content_sanskrit": "देवयानी शङ्कमाना दृष्ट्वा पितरमब्रवीत्।\nपुष्पाहारः प्रेषणकृत्कचस्तात न दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2003569, "chapter_id": 1069, "verse_number": "१-७०-४७", "content_sanskrit": "व्यक्तं हतो मृतो वापि कचस्तात भविष्यति।\nतं विना न च जीवेयं कचं सत्यं ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2003570, "chapter_id": 1069, "verse_number": "१-७०-४८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2003571, "chapter_id": 1069, "verse_number": "१-७०-४८", "content_sanskrit": "श्रुत्वा पुत्रीवचः काव्यो मन्त्रेणाहूतवान्कचम्।\nज्ञात्वा बहिष्ठमज्ञात्वा स्वकुक्षिस्थं कचं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2003572, "chapter_id": 1069, "verse_number": "१-७०-४९x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2003573, "chapter_id": 1069, "verse_number": "१-७०-४९", "content_sanskrit": "बृहस्पतेः सुतः पुत्रि कचः प्रेतगतिं गतः।\nविद्यया जीवितोऽप्येवं हन्यते करवाम किम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2003574, "chapter_id": 1069, "verse_number": "१-७०-५०", "content_sanskrit": "मैवं शुचो मा रुद देवयानि\nन त्वादृशी मर्त्यमनुप्रशोचते।\nयस्यास्तव ब्रह्म च ब्राह्मणाश्च\nसेन्द्रा देवा वसवोऽथाश्विनौ च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2003575, "chapter_id": 1069, "verse_number": "१-७०-५१", "content_sanskrit": "सुरद्विषश्चैव जगच्च सर्व-\nमुपस्थाने सन्नमन्ति प्रभावात्।\nअशक्योऽसौ जीवयितुं द्विजातिः\nसंजीवितो वध्यते चैव भूयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2003576, "chapter_id": 1069, "verse_number": "१-७०-५२x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2003577, "chapter_id": 1069, "verse_number": "१-७०-५२", "content_sanskrit": "यस्याङ्गिरा वृद्धतमः पितामहो\nबृहस्पतिश्चापि पिता तपोनिधिः।\nऋषेः पुत्रं तमथो वापि पौत्रं\nकथं न शोचेयमहं न रुद्याम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2003578, "chapter_id": 1069, "verse_number": "१-७०-५३", "content_sanskrit": "स ब्रह्मचारी च तपोधनश्च\nसदोत्थितः कर्मसु चैव दक्षः।\nकचस्य मार्गं प्रतिपत्स्ये न भोक्ष्ये\nप्रियो हि मे तात कचोऽभिरूपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2003579, "chapter_id": 1069, "verse_number": "१-७०-५४x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2003580, "chapter_id": 1069, "verse_number": "१-७०-५४", "content_sanskrit": "असंशयं मामसुरा द्विषन्ति\nये शिष्यं मेऽनागसं सूदयन्ति।\nअब्राह्मणं कर्तुमिच्छ्ति रौद्रा-\nस्ते मां यथा व्यभिचरन्ति नित्यम्।\nअप्यस्य पापस्य भवेदिहान्तः\nकं ब्रह्महत्या न दहेदपीन्द्रम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2003581, "chapter_id": 1069, "verse_number": "१-७०-५५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2003582, "chapter_id": 1069, "verse_number": "१-७०-५५", "content_sanskrit": "संचोदितो देवयान्या महर्षिः पुनराह्वयत्।\nसंरम्भेणैव काव्यो हि बृहस्पतिसुतं कचम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2003583, "chapter_id": 1069, "verse_number": "१-७०-५६", "content_sanskrit": "कचोऽपि राजन्स महानुभावो\nविद्याबलाल्लब्धमतिर्महात्मा।\nगुरोर्हि भीतो विद्यया चोपहूतः।\nशनैर्वाक्यं जठरे व्याजहार॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2003584, "chapter_id": 1069, "verse_number": "१-७०-५७", "content_sanskrit": "प्रसीद भगवन्मह्यं कचोऽहमभिवादये।\nयथा बहुमतः पुत्रस्तथा मन्यतु मां भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2003585, "chapter_id": 1069, "verse_number": "१-७०-५८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2003586, "chapter_id": 1069, "verse_number": "१-७०-५८", "content_sanskrit": "तमब्रवीत्केन पथोपनीत-\nस्त्वं चोदरे तिष्ठसि ब्रूहि विप्र।\nअस्मिन्मुहूर्ते ह्यसुरान्विनाश्य\nगच्छामि देवानहमद्य विप्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2003587, "chapter_id": 1069, "verse_number": "१-७०-५९x", "content_sanskrit": "कच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2003588, "chapter_id": 1069, "verse_number": "१-७०-५९", "content_sanskrit": "तव प्रसादान्न जहाति मां स्मृतिः\nस्मरामि सर्वं यच्च यथा च वृत्तम्।\nनत्वेवं स्यात्तपसः संक्षयो मे\nततः क्लेशं घोरमिमं सहामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2003589, "chapter_id": 1069, "verse_number": "१-७०-६०", "content_sanskrit": "असुरैः सुरायां भवतोऽस्मि दत्तो\nहत्वा दग्ध्वा चूर्णयित्वा च काव्य।\nब्राह्मीं मायां चासुरीं विप्र मायां\nत्वयि स्थिते कथमेवातिवर्तेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2003590, "chapter_id": 1069, "verse_number": "१-७०-६१x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2003591, "chapter_id": 1069, "verse_number": "१-७०-६१", "content_sanskrit": "किं ते प्रियं करवाण्यद्य वत्से\nवधेन मे जीवितं स्यात्कचस्य।\nनान्यत्र कुक्षेर्मम भेदनेन\nदृश्येत्कचो मद्गतो देवयानि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2003592, "chapter_id": 1069, "verse_number": "१-७०-६२x", "content_sanskrit": "देवयान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2003593, "chapter_id": 1069, "verse_number": "१-७०-६२", "content_sanskrit": "द्वौ मां शोकावग्निकल्पौ दहेतां\nकचस्य नाशस्तव चैवोपघातः।\nकचस्य नाशे मम शर्म नास्ति\nतवोपघाते जीवितुं नास्मि शक्ता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2003594, "chapter_id": 1069, "verse_number": "१-७०-६३x", "content_sanskrit": "शुक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2003595, "chapter_id": 1069, "verse_number": "१-७०-६३", "content_sanskrit": "संसिद्धरूपोऽसि बृहस्पतेः सुत\nयत्त्वां भक्तं भजते देवयानी।\nविद्यामिमां प्राप्नुहि जीवनीं त्वं\nन चेदिन्द्रः कचरूपी त्वमद्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2003596, "chapter_id": 1069, "verse_number": "१-७०-६४", "content_sanskrit": "न निवर्तेत्पुनर्जीवन्कश्चिदन्यो ममोदरात्।\nब्राह्मणं वर्जयित्वैकं तस्माद्विद्यामवाप्नुहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2003597, "chapter_id": 1069, "verse_number": "१-७०-६५", "content_sanskrit": "पुत्रो भूत्वा भावय भावितो मा-\nमस्मद्देहादुपनिष्क्रम्य तात।\nसमीक्षेथा धर्मवतीमवेक्षां\nगुरोः सकाशात्प्राप्य विद्यां सविद्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2003598, "chapter_id": 1069, "verse_number": "१-७०-६६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2003599, "chapter_id": 1069, "verse_number": "१-७०-६६", "content_sanskrit": "गुरोः सकाशात्समवाप्य विद्यां\nभित्त्वा कुक्षिं निर्विचक्राम विप्रः।\nकचोऽभिरूपस्तत्क्षणाद्ब्राह्मणस्य\nशुक्लात्यये पौर्णमास्यामिवेन्दुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2003600, "chapter_id": 1069, "verse_number": "१-७०-६७", "content_sanskrit": "दृष्ट्वा च तं पतितं ब्रह्मराशि-\nमुत्थापयामास मृतं कचोऽपि।\nविद्यां सिद्धां तामवाप्याभिवाद्य\nततः कचस्तं गुरुमित्युवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2003601, "chapter_id": 1069, "verse_number": "१-७०-६८", "content_sanskrit": "यः श्रोत्रयोरमृतं सन्निषिञ्चे-\nद्विद्यामविद्यस्य यथा त्वमार्यः।\nतं मन्येऽहं पितरं मातरं च\nतस्मै न द्रुह्येत्कृतमस्य जानन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2003602, "chapter_id": 1069, "verse_number": "१-७०-६९", "content_sanskrit": "ऋतस्य दातारमनुत्तमस्य\nनिधिं निधीनामपि लब्धविद्याः।\nये नाद्रियन्ते गुरुमर्चनीयं\nपापाँल्लोकांस्ते व्रजन्त्यप्रतिष्ठाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2003603, "chapter_id": 1069, "verse_number": "१-७०-७०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2003604, "chapter_id": 1069, "verse_number": "१-७०-७०", "content_sanskrit": "सुरापानाद्वञ्चनां प्राप्य विद्वा-\nन्संज्ञानाशं चैव महातिघोरम्।\nदृष्ट्वा कचं चापि तथाभिरूपं\nपीतं तदा सुरया मोहितेन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2003605, "chapter_id": 1069, "verse_number": "१-७०-७१", "content_sanskrit": "समन्युरुत्थाय महानुभाव-\nस्तदोशना विप्रहितं चिकीर्षुः।\nसुरापानं प्रति संजातमन्युः\nकाव्यः स्वयं वाक्यमिदं जगाद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2003606, "chapter_id": 1069, "verse_number": "१-७०-७२", "content_sanskrit": "यो ब्राह्मणोऽद्यप्रभृतीह कश्चि-\nन्मोहात्सुरां पास्यति मन्दबुद्धिः।\nअपेतधर्मा ब्र्हमहा चैव स स्या-\nदस्मिंल्लोके गर्हितः स्यात्परे च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2003607, "chapter_id": 1069, "verse_number": "१-७०-७३", "content_sanskrit": "मया चैतां विप्रधर्मोक्तिसीमां\nमर्यादां वै स्थापितां सर्वलोके।\nसन्तो विप्राः शुश्रुवांसो गुरूणां\nदेवा लोकाश्चोपशृण्वन्तु सर्वे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2003608, "chapter_id": 1069, "verse_number": "१-७०-७४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2003609, "chapter_id": 1069, "verse_number": "१-७०-७४", "content_sanskrit": "इतीदमुक्त्वा स महानुभाव-\nस्तपोनिधीनां निधिरप्रमेयः।\nतान्दानवान्दैवविमूढबुद्धी-\nनिदं समाहूय वचोऽभ्युवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2003610, "chapter_id": 1069, "verse_number": "१-७०-७५", "content_sanskrit": "आचक्षे वो दानवा बालिशाः स्थ\nसिद्धः कचो वत्स्यति मत्सकाशे।\nसञ्जीविनीं प्राप्य विद्यां महात्मा\nतुल्यप्रभावो ब्राह्मणो ब्रह्मभूतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2003611, "chapter_id": 1069, "verse_number": "१-७०-७६", "content_sanskrit": "योऽकार्षीद्दुष्करं कर्म देवानां कारणात्कचः।\nन तत्किर्तिर्जरां गच्छेद्याज्ञीयश्च भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2003612, "chapter_id": 1069, "verse_number": "१-७०-७७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2003613, "chapter_id": 1069, "verse_number": "१-७०-७७", "content_sanskrit": "एतावदुक्त्वा वचनं विरराम स भार्गवः।\nदानवा विस्मयाविष्टाः प्रययुः स्वं निवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2003614, "chapter_id": 1069, "verse_number": "१-७०-७८", "content_sanskrit": "गुरोरुष्य सकाशे तु दश वर्षशतानि सः।\nअनुज्ञातः कचो गन्तुमियेष त्रिदशालयम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2003615, "chapter_id": 1069, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्मेहाभारते आदिपर्वणि संभवपर्वणि सप्ततितमोऽध्यायः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}]