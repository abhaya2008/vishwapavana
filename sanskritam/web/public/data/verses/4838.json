[{"id": 2181126, "chapter_id": 4838, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2181127, "chapter_id": 4838, "verse_number": "१", "content_sanskrit": "अथाब्रवीन्महातेजा वाक्यं कौरवनन्दनः ।\nहन्त धर्मान् प्रवक्ष्यामि दृढे वाङ्मनसी मम ।\nतव प्रसादाद् गोविन्द भूतात्मा ह्यसि शाश्वतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2181128, "chapter_id": 4838, "verse_number": "२", "content_sanskrit": "युधिष्ठिरस्तु मां राजा धर्मान् समनुपृच्छतु ।\nएवं प्रीतो भविष्यामि धर्मान् वक्ष्यामि चानघ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2181129, "chapter_id": 4838, "verse_number": "३", "content_sanskrit": "यस्मिन् राजर्षभे जाते धर्मात्मनि महात्मनि ।\nअहृष्यन् ऋषयः सर्वे स मां पृच्छतु पाण्डवः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2181130, "chapter_id": 4838, "verse_number": "४", "content_sanskrit": "सर्वेषां दीप्तयशसां कुरूणां धर्मचारिणाम् ।\nयस्य नास्ति समः कश्चित् स मां पृच्छतु पाण्डवः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2181131, "chapter_id": 4838, "verse_number": "५", "content_sanskrit": "धृतिर्दमो ब्रह्मचर्यं क्षमा धर्मश्च नित्यदा ।\nयस्मिन्नोजश्च तेजश्च स मां पृच्छतु पाण्डवः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2181132, "chapter_id": 4838, "verse_number": "६", "content_sanskrit": "सत्यं दानं तपः शौचं शान्तिर्दाक्ष्यमसम्भ्रमः ।\nयस्मिन्नेतानि सर्वाणि स मां पृच्छतु पाण्डवः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2181133, "chapter_id": 4838, "verse_number": "७", "content_sanskrit": "यो न कामान्न संरम्भान्न भयान्नार्थकारणात् ।\nकुर्यादधर्मं धर्मात्मा स मां पृच्छतु पाण्डवः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2181134, "chapter_id": 4838, "verse_number": "८", "content_sanskrit": "सम्बन्धिनोऽतिथीन् भृत्यान् संश्रितोपाश्रितांश्च यः ।\nसम्मानयति सत्कृत्य स मां पृच्छतु पाण्डवः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2181135, "chapter_id": 4838, "verse_number": "९", "content_sanskrit": "सत्यनित्यः क्षमानित्यो ज्ञाननित्योऽतिथिप्रियः ।\nयो ददाति सतां नित्यं स मां पृच्छतु पाण्डवः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2181136, "chapter_id": 4838, "verse_number": "१०", "content_sanskrit": "इज्याध्ययननित्यश्च धर्मे च निरतः सदा ।\nशान्तः श्रुतरहस्यश्च स मां पृच्छतु पाण्डवः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2181137, "chapter_id": 4838, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2181138, "chapter_id": 4838, "verse_number": "११", "content_sanskrit": "लज्जया परयोपेतो धर्मात्मा स युधिष्ठिरः ।\nअभिशापभयाद् भीतो भवन्तं नोपसर्पति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2181139, "chapter_id": 4838, "verse_number": "१२", "content_sanskrit": "लोकस्य कदनं कृत्वा लोकनाथो विशाम्पते ।\nअभिशापभयाद् भीतो भवन्तं नोपसर्पति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2181140, "chapter_id": 4838, "verse_number": "१३", "content_sanskrit": "पूज्यान् मान्यांश्च भक्तांश्च गुरून् सम्बन्धिबान्धवान् ।\nअर्घ्यार्हानिषुभिर्हत्वा भवन्तं नोपसर्पति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2181141, "chapter_id": 4838, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2181142, "chapter_id": 4838, "verse_number": "१४", "content_sanskrit": "ब्राह्मणानां यथा धर्मो दानमध्ययनं तपः ।\nक्षत्रियाणां तथा कृष्ण समरे देहपातनम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2181143, "chapter_id": 4838, "verse_number": "१५", "content_sanskrit": "पितॄन् पितामहान् पुत्रान् गुरून् सम्बन्धिबान्धवान् ।\nमिथ्याप्रवृत्तान् यः सङ्खे निहन्याद् धर्म एव सः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2181144, "chapter_id": 4838, "verse_number": "१६", "content_sanskrit": "समयत्यागिनो लुब्धान् गुरूनपि च केशवः ।\nनिहन्ति समरे पापान् क्षत्रियो यः स धर्मवित्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2181145, "chapter_id": 4838, "verse_number": "१७", "content_sanskrit": "लोहितोदां केशतृणां गजशैलां ध्वजद्रुमम् ।\nमहीं करोति युद्धेषु क्षत्रियो यः स धर्मवित्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2181146, "chapter_id": 4838, "verse_number": "१८", "content_sanskrit": "आहूतेन रणे नित्यं योद्धव्यं क्षत्रबन्धुना ।\nधर्म्यं स्वर्ग्यं च लोक्यं च युद्धं हि मनुरब्रवीत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2181147, "chapter_id": 4838, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2181148, "chapter_id": 4838, "verse_number": "१९", "content_sanskrit": "एवमुक्तस्तु भीष्मेण धर्मराजो युधिष्ठिरः ।\nविनीतवदुपागम्य तस्थौ सन्दर्शनेऽग्रतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2181149, "chapter_id": 4838, "verse_number": "२०", "content_sanskrit": "अथास्य पादौ जग्राह भीष्मश्चाभिननन्द तम् ।\nमूर्ध्नि चैनमुपाघ्राय निषीदेत्यब्रवीत् तदा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2181150, "chapter_id": 4838, "verse_number": "२१", "content_sanskrit": "तमुवाचाथ गाङ्गेय ऋषभः सर्वधन्विनाम् ।\nपृच्छ मां तात विस्रब्धं मा भैस्त्वं कुरुसत्तम\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2181151, "chapter_id": 4838, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे पञ्चपञ्चाशोऽध्यायः ॥ ५५ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]