[{"id": 50026131, "chapter_id": 12074, "verse_number": "1", "content_sanskrit": "स्वयमुद्देशनत्यन्तौ मन्त्रौ द्वावपरौ तयोः॥ ७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50026132, "chapter_id": 12074, "verse_number": "2", "content_sanskrit": "मन्त्रा एते हरेः प्रीतिदायकाः सर्वकामदाः। इष्टं दैवं हरिः साक्षाल्लक्ष्मीर्भाग्यस्य देवता। गुरुर्ब्रह्माऽथ वायुर्वा विद्या देव्यौ प्रकीर्तिते॥ ७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50026133, "chapter_id": 12074, "verse_number": "3", "content_sanskrit": "तस्मादेते प्रिया विष्णोरन्तरङ्गतया सदा। ज्ञेयाश्चैव प्रपूज्याश्च विष्णोः प्रीतिमभीप्सता॥ ७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]