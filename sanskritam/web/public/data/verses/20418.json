[{"id": 7000418000, "chapter_id": 20418, "verse_number": "२-९०-१", "content_sanskrit": "सूतौवाच ।\nएवमाकर्ण्य तत्सर्वं समुज्ज्वलस्य भाषितम् ।\nकुंजलः स हि धर्मात्मा प्रत्युवाच सुतं प्रति॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000418001, "chapter_id": 20418, "verse_number": "२-९०-२", "content_sanskrit": "कुंजल उवाच ।\nसंप्रवक्ष्याम्यहं तात श्रूयतां स्थिरमानसः ।\nसर्वसंदेहविध्वंसं चरित्रं पापनाशनम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000418002, "chapter_id": 20418, "verse_number": "२-९०-३", "content_sanskrit": "इंद्रलोके प्रववृते संवादो देव कौतुकः ।\nसभायां तस्य देवस्य इंद्रस्यापि महात्मनः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000418003, "chapter_id": 20418, "verse_number": "२-९०-४", "content_sanskrit": "देवं द्रष्टुं सहस्राक्षं नारदस्त्वरितं ययौ ।\nसमागतं सहस्राक्षः सूर्यतेजःसमप्रभम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000418004, "chapter_id": 20418, "verse_number": "२-९०-५", "content_sanskrit": "तं दृष्ट्वा हर्षमायातः समुत्थाय महामतिः ।\nददावर्घं च पाद्यं च भक्त्या प्रणतमानसः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000418005, "chapter_id": 20418, "verse_number": "२-९०-६", "content_sanskrit": "बद्धांजलिपुटोभूत्वा प्रणाममकरोत्तदा ।\nआसने कोमले पुण्ये विनिवेश्य द्विजोत्तमम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000418006, "chapter_id": 20418, "verse_number": "२-९०-७", "content_sanskrit": "पप्रच्छ प्रणतो भूत्वा श्रद्धया परया युतः ।\nकस्माच्चागमनं तेऽद्य कारणं वद सांप्रतम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000418007, "chapter_id": 20418, "verse_number": "२-९०-८", "content_sanskrit": "इत्युक्तो देवराजेन प्रत्युवाच महामुनिः ।\nभवंतं द्रष्टुमायातः पृथिव्यास्तु पुरंदरः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000418008, "chapter_id": 20418, "verse_number": "२-९०-९", "content_sanskrit": "स्नात्वा पुण्यप्रदेशेषु तीर्थेषु च सुश्रद्धया ।\nदेवान्पितॄन्समभ्यर्च्य दृष्ट्वा तीर्थान्यनेकशः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000418009, "chapter_id": 20418, "verse_number": "२-९०-१०", "content_sanskrit": "एतत्ते सर्वमाख्यातं यत्त्वया पृच्छितं पुरा ।\nदेवेंद्र उवाच ।\nदृष्टानि पुण्यतीर्थानि सुक्षेत्राणि त्वया मुने॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000418010, "chapter_id": 20418, "verse_number": "२-९०-११", "content_sanskrit": "किं तीर्थं प्राप्य मुच्येत ब्रह्मघ्नो ब्रह्महत्यया ।\nसुरापोमुच्यतेपापाद्गोघ्नोहेमापहारकः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000418011, "chapter_id": 20418, "verse_number": "२-९०-१२", "content_sanskrit": "स्वामिद्रोहान्महाभाग नारीहंता कथं सुखी ।\nनारद उवाच ।\nयानि कानि च तीर्थानि गयादीनि सुरेश्वर॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000418012, "chapter_id": 20418, "verse_number": "२-९०-१३", "content_sanskrit": "तेषां नैव प्रजानामि विशेषं पापनाशनम् ।\nसुपुण्यानि सुदिव्यानि पापघ्नानि समानि च॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000418013, "chapter_id": 20418, "verse_number": "२-९०-१४", "content_sanskrit": "सर्वाण्येव सुतीर्थानि जानाम्यहं पुरंदर ।\nअविशेषं विशेषं वै नैव जानामि सांप्रतम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000418014, "chapter_id": 20418, "verse_number": "२-९०-१५", "content_sanskrit": "प्रत्ययं क्रियतां देव तीर्थानां गतिदायकम् ।\nएवमाकर्ण्य तद्वाक्यं नारदस्य महात्मनः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000418015, "chapter_id": 20418, "verse_number": "२-९०-१६", "content_sanskrit": "समाहूतानि चेंद्रेण तीर्थानि भूगतानि च ।\nमूर्तिवर्तीनि दिव्यानि समायातानि शासनात्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000418016, "chapter_id": 20418, "verse_number": "२-९०-१७", "content_sanskrit": "बद्धांजलीनि दिव्यानि भूषितानि सुभूषणैः ।\nदिव्यांबराणि स्निग्धानि तेजोवंति च सुव्रत॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000418017, "chapter_id": 20418, "verse_number": "२-९०-१८", "content_sanskrit": "स्त्रीपुंसोश्च स्वरूपाणि कृतानि च विशेषतः ।\nहेमचंदनकाशानि दिव्यरूपधराणि च॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000418018, "chapter_id": 20418, "verse_number": "२-९०-१९", "content_sanskrit": "मुक्ताफलस्यवर्णेन प्रभासंति नरेश्वर ।\nतप्तकांचनवर्णानि सारुण्यानि च तत्र वै॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000418019, "chapter_id": 20418, "verse_number": "२-९०-२०", "content_sanskrit": "कति शुक्ल सुपीतानि प्रभावंति सभांतरे ।\nकानि पद्मनिभान्येव मूर्तिवर्तीनि तानि तु॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000418020, "chapter_id": 20418, "verse_number": "२-९०-२१", "content_sanskrit": "सूर्यतेजः प्रकाशानि तडित्तेजः समानि च ।\nपावकाभानि चान्यानि प्रभासंति सभांतरे॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000418021, "chapter_id": 20418, "verse_number": "२-९०-२२", "content_sanskrit": "सर्वाभरणशोभाढ्यैः प्रशोभंते नरेश्वर ।\nहारकंकणकेयूरमालाभिस्तु सुचंदनैः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000418022, "chapter_id": 20418, "verse_number": "२-९०-२३", "content_sanskrit": "दिव्यचंदनदिग्धानि सुरभीणि गुरूणि च ।\nकमंडलुकराण्येव आयातानि सभांतरे॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000418023, "chapter_id": 20418, "verse_number": "२-९०-२४", "content_sanskrit": "गंगा च नर्मदा पुण्या चंद्रभागा सरस्वती ।\nदेविका बिंबिका कुब्जा कुंजला मंजुला श्रुता॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000418024, "chapter_id": 20418, "verse_number": "२-९०-२५", "content_sanskrit": "रंभा भानुमती पुण्या पारा चैव सुघर्घरा ।\nशोणा च सिंधुसौवीरा कावेरी कपिला तथा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000418025, "chapter_id": 20418, "verse_number": "२-९०-२६", "content_sanskrit": "कुमुदा वेदनदी पुण्या सुपुण्या च महेश्वरी ।\nचर्मण्वती तथा ख्याता लोपा चान्या सुकौशिकी॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000418026, "chapter_id": 20418, "verse_number": "२-९०-२७", "content_sanskrit": "सुहंसी हंसपादा च हंसवेगा मनोरथा ।\nसुरुथास्वारुणा वेणा भद्र वेणा सुपद्मिनी॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000418027, "chapter_id": 20418, "verse_number": "२-९०-२८", "content_sanskrit": "नाहलीसुमरी चान्या पुण्या चान्या पुलिंदिका ।\nहेमा मनोरथा दिव्या चंद्रिका वेदसंक्रमा॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000418028, "chapter_id": 20418, "verse_number": "२-९०-२९", "content_sanskrit": "ज्वालाहुताशनी स्वाहा काला चैव कपिंजला ।\nस्वधा च सुकला लिंगा गंभीरा भीमवाहिनी॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000418029, "chapter_id": 20418, "verse_number": "२-९०-३०", "content_sanskrit": "देवद्रीची वीरवाहा लक्षहोमा अघापहा ।\nपाराशरी हेमगर्भा सुभद्रा वसुपुत्रिका॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000418030, "chapter_id": 20418, "verse_number": "२-९०-३१", "content_sanskrit": "एता नद्यो महापुण्या मूर्तिमत्यो नरेश्वर ।\nसर्वाभरणशोभाढ्याः कुंभहस्ताः सुपूजिताः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000418031, "chapter_id": 20418, "verse_number": "२-९०-३२", "content_sanskrit": "प्रयागः पुष्करश्चैव अर्घदीर्घो मनोरथा ।\nवाराणसी महापुण्या ब्रह्महत्या व्यपोहिनी॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000418032, "chapter_id": 20418, "verse_number": "२-९०-३३", "content_sanskrit": "द्वारावती प्रभासश्च अवंती नैमिषस्तथा ।\nचंडकश्च महारत्नो महेश्वरकलेश्वरौ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000418033, "chapter_id": 20418, "verse_number": "२-९०-३४", "content_sanskrit": "कलिंजरो ब्रह्मक्षेत्रं माथुरो मानवाहकः ।\nमायाकांती तथान्यानि दिव्यानि विविधानि च॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000418034, "chapter_id": 20418, "verse_number": "२-९०-३५", "content_sanskrit": "अष्टषष्टिः सुतीर्थानि नदीनां शतकोटयः ।\nगोदावरीमुखाः सर्वा समायातास्तदाज्ञया॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000418035, "chapter_id": 20418, "verse_number": "२-९०-३६", "content_sanskrit": "द्वीपानां तु समस्तानि सुतीर्थानि महांति च ।\nमूर्तिलिंगधराण्येव सहस्राक्षं सुरेश्वरम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000418036, "chapter_id": 20418, "verse_number": "२-९०-३७", "content_sanskrit": "समाजग्मुः समस्तानि तदादेशकराणि च ।\nप्रणेमुर्देवदेवेशं नतशीर्षाणि सर्वशः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000418037, "chapter_id": 20418, "verse_number": "२-९०-३८", "content_sanskrit": "सूत उवाच ।\nतैः प्रोक्तं तु महातीर्थैर्देवराजं यशस्विनम् ।\nकस्मात्त्वया समाहूता देवदेव वदस्व नः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000418038, "chapter_id": 20418, "verse_number": "२-९०-३९", "content_sanskrit": "ब्रूहि नः कारणं सर्वं नमस्तुभ्यं सुराधिप ।\nएवमाकर्ण्य तद्वाक्यं देवराजोभ्यभाषत॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000418039, "chapter_id": 20418, "verse_number": "२-९०-४०", "content_sanskrit": "कः समर्थो महातीर्थो ब्रह्महत्यां व्यपोहितुम् ।\nगोवधाख्यं महापापं स्त्रीवधाख्यमनुत्तमम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000418040, "chapter_id": 20418, "verse_number": "२-९०-४१", "content_sanskrit": "स्वामिद्रोहाच्च संभूतं सुरापानाच्च दारुणम् ।\nहेमस्तेयात्तथा जातं गुरुनिंदा समुद्भवम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000418041, "chapter_id": 20418, "verse_number": "२-९०-४२", "content_sanskrit": "भ्रूणहत्यां महाघोरां नाशयेत्कः समर्थवान् ।\nराजद्रोहान्महापापं बहुपीडाप्रदायकम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000418042, "chapter_id": 20418, "verse_number": "२-९०-४३", "content_sanskrit": "मित्रद्रोहात्तथा चान्यदन्यद्विश्वासघातकम् ।\nदेवभेदं तथा चान्यं लिंगभेदमतः परम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000418043, "chapter_id": 20418, "verse_number": "२-९०-४४", "content_sanskrit": "वृत्तिच्छेदं च विप्राणां गोप्रचारप्रणाशनम् ।\nआगारदहनं चान्यद्गृहदीपनकं तथा॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000418044, "chapter_id": 20418, "verse_number": "२-९०-४५", "content_sanskrit": "षोडशैते महापापा अगम्यागमनं तथा ।\nस्वामित्यागात्समुद्भूतं रणस्थानात्पलायनात्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000418045, "chapter_id": 20418, "verse_number": "२-९०-४६", "content_sanskrit": "एतानि नाशयेत्को वै समर्थस्तीर्थौत्तमः ।\nसमर्थो भवतां मध्ये प्रायश्चित्तं विना ध्रुवम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000418046, "chapter_id": 20418, "verse_number": "२-९०-४७", "content_sanskrit": "पश्यतां देवतानां च नारदस्य च पश्यतः ।\nब्रुवंतु सर्वे संचिंत्य विचार्यैवं सुनिश्चितम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000418047, "chapter_id": 20418, "verse_number": "२-९०-४८", "content_sanskrit": "एवमुक्ते शुभे वाक्ये देवराज्ञामहात्मना ।\nसंमंत्र्य तीर्थराजेन प्रोचुः शक्रं सभागतम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000418048, "chapter_id": 20418, "verse_number": "२-९०-४९", "content_sanskrit": "तीर्थान्यूचुः ।\nश्रूयतामभिधास्यामो देवराज नमोस्तु ते ।\nसंति वै सर्वतीर्थानि सर्वपापहराणि च॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000418049, "chapter_id": 20418, "verse_number": "२-९०-५०", "content_sanskrit": "ब्रह्महत्यादिकान्यांश्च त्वया प्रोक्तान्सुरेश्वर ।\nमहाघोरान्सुदीप्तांश्च नाशितुं नैव शक्नुमः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000418050, "chapter_id": 20418, "verse_number": "२-९०-५१", "content_sanskrit": "प्रयागः पुष्करश्चैव अर्घतीर्थमनुत्तमम् ।\nवाराणसी महाभाग समर्था पापनाशिनी॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000418051, "chapter_id": 20418, "verse_number": "२-९०-५२", "content_sanskrit": "महापातकनाशार्थे चत्वारोमितविक्रमाः ।\nउपपातकनाशार्थं चत्वारोमितविक्रमाः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000418052, "chapter_id": 20418, "verse_number": "२-९०-५३", "content_sanskrit": "सृष्टा धात्रा च देवेंद्र पुष्कराद्या महाबलाः ।\nएवमाकर्ण्य तद्वाक्यं तीर्थानां सुरराट् ततः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000418053, "chapter_id": 20418, "verse_number": "२-९०-५४", "content_sanskrit": "हर्षेण महताविष्टस्तेषां स्तोत्रं चकार सः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]