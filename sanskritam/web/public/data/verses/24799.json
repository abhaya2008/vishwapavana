[{"id": 7004799000, "chapter_id": 24799, "verse_number": "६-२६१-१", "content_sanskrit": "नारद उवाच ।\nकथं नित्या भगवती हरपत्नी यशस्विनी ।\nयोगसिद्धिं सुमहतीं प्राप मासचतुष्टये ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004799001, "chapter_id": 24799, "verse_number": "६-२६१-२", "content_sanskrit": "मन्त्रराजमिमं जप्त्वा द्वादशाक्षरसंभवम् ।\nएतन्मे विस्तरेण त्वं कथयस्व यथातथम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004799002, "chapter_id": 24799, "verse_number": "६-२६१-३", "content_sanskrit": "ब्रह्मोवाच ।\nचातुर्मास्ये हरौ सुप्ते पार्वती नियतव्रता ।\nमनसा कर्मणा वाचा हरिभक्तिपरायणा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004799003, "chapter_id": 24799, "verse_number": "६-२६१-४", "content_sanskrit": "चारुशृंगे पितुर्नित्यं तिष्ठंती तपसि स्थिता ।\nदेवद्विजाग्निगोऽश्वत्थातिथिपूजापरायणा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004799004, "chapter_id": 24799, "verse_number": "६-२६१-५", "content_sanskrit": "चातुर्मास्येऽथ संप्राप्ते विमले हरिवासरे ।\nजजाप परमं मंत्रं यथादिष्टं पिनाकिना ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004799005, "chapter_id": 24799, "verse_number": "६-२६१-६", "content_sanskrit": "शंखचक्रधरो विष्णुश्चतुर्हस्तः किरीटधृक् ।\nमेघश्यामोंऽबुजाक्षश्च सूर्यकोटिसमप्रभः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004799006, "chapter_id": 24799, "verse_number": "६-२६१-७", "content_sanskrit": "गरुडाधिष्ठितो हृष्टो वसन्व्याप्य जगत्त्रयम् ।\nश्रीवत्सकौस्तुभयुतः पीतकौशेयवस्त्रकः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004799007, "chapter_id": 24799, "verse_number": "६-२६१-८", "content_sanskrit": "सर्वाभरणशोभाभिरभिदीप्तमहावपुः ।\nबभाषे पार्वतीं विष्णुः प्रसन्नवदनः शुभाम् ।\nदेवि तुष्टो ऽस्मि भद्रं ते कथयस्व तवेप्सितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004799008, "chapter_id": 24799, "verse_number": "६-२६१-९", "content_sanskrit": "पार्वत्युवाच ।\nतज्ज्ञानममलं देहि येन नावर्त्तनं भवेत् ।\nइत्युक्तः स महाविष्णुः प्रत्युवाच हरप्रियाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004799009, "chapter_id": 24799, "verse_number": "६-२६१-१०", "content_sanskrit": "स एव देवदेवेशस्तव वक्ष्यत्यसंशयम् ।\nस एव भगवान्साक्षी देहांतरबहिःस्थितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004799010, "chapter_id": 24799, "verse_number": "६-२६१-११", "content_sanskrit": "विश्वस्रष्टा च गोप्ता च पवित्राणां च पावनः ।\nअनादिनिधनो धर्मो धर्मादीनां प्रभुर्हि सः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004799011, "chapter_id": 24799, "verse_number": "६-२६१-१२", "content_sanskrit": "अक्षरत्रयसेव्यं यत्सकलं ब्रह्म एव सः ।\nमूर्त्तामूर्त्तस्वरूपेण योऽजो जन्मधरो हि सः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004799012, "chapter_id": 24799, "verse_number": "६-२६१-१३", "content_sanskrit": "ममाधिकारो नैवास्ति वक्तुं तव न संशयः ।\nइत्युक्त्वा भगवानीशो विरराम प्रहृष्टवान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004799013, "chapter_id": 24799, "verse_number": "६-२६१-१४", "content_sanskrit": "एतस्मिन्नंतरे शंभुर्गिरिजाश्रममभ्यगात् ।\nसर्वभूत गणैर्युक्तो विमाने सार्वकामिके ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004799014, "chapter_id": 24799, "verse_number": "६-२६१-१५", "content_sanskrit": "तया वै भगवान्देवः पूजितः परमेश्वरः ।\nसखीनामपि प्रत्यक्षमाश्चर्यं समजायत ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004799015, "chapter_id": 24799, "verse_number": "६-२६१-१६", "content_sanskrit": "स्तुत्वाऽथ तं महादेवं विष्णुर्देहे लयं ययौ ।\nअथोवाच महेशानः पार्वतीं परमेश्वरः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004799016, "chapter_id": 24799, "verse_number": "६-२६१-१७", "content_sanskrit": "विमानवरमारुह्य तुष्टोऽहं तव सुव्रते ।\nगत्वैकांतप्रदेशं ते कथये परमं महः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004799017, "chapter_id": 24799, "verse_number": "६-२६१-१८", "content_sanskrit": "एवमुक्त्वा भगवतीं करे गृह्य मुदान्वितः ।\nविमानवरमारोप्य लीलया प्रययौ तदा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004799018, "chapter_id": 24799, "verse_number": "६-२६१-१९", "content_sanskrit": "नानाधातुमयानद्रीन्नानारत्नविचित्रितान् ।\nनदीनिर्झरकुंजांश्च नदान्कोकिलकूजितान् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004799019, "chapter_id": 24799, "verse_number": "६-२६१-२०", "content_sanskrit": "अखातान्देवखातांश्च गंगाद्याः सरितस्तथा ।\nसौगंधिकांश्च कल्हारान्सहस्रदलपिंजरान् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004799020, "chapter_id": 24799, "verse_number": "६-२६१-२१", "content_sanskrit": "दर्शन्यकर्णिकारांश्च कोविदारान्महाद्रुमान् ।\nतालांस्तमालान्हिंतालान्प्रियंगून्पनसानपि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004799021, "chapter_id": 24799, "verse_number": "६-२६१-२२", "content_sanskrit": "तिलकान्बकुलांश्चैव बहूनपि च पुष्पितान् ।\nक्षेत्राणि कलनाभानि पिञ्जराणि विदर्शयन् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004799022, "chapter_id": 24799, "verse_number": "६-२६१-२३", "content_sanskrit": "ययौ देवनदीतीरे गतं शरवणं महत् ।\nफुल्लकाशं स्वर्णमयं शरस्तंबगणान्वितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004799023, "chapter_id": 24799, "verse_number": "६-२६१-२४", "content_sanskrit": "हेम भूमिविभागस्थं वह्निकांतिमृगद्विजम् ।\nतत्र तीरगतानां च मुनीनामूर्ध्वरेतसाम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004799024, "chapter_id": 24799, "verse_number": "६-२६१-२५", "content_sanskrit": "आश्रमान्स विमानाग्रे तिष्ठन्पत्न्यै प्रदर्शयत् ।\nषट्कृत्तिकाश्च ददृशे पार्वती वनसन्निधौ ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004799025, "chapter_id": 24799, "verse_number": "६-२६१-२६", "content_sanskrit": "स्नाताः स्वलंकृताश्चन्द्रपत्न्यस्ता विरजांबराः ।\nऊचुस्ता योजितकरा केऽयं पुत्राय गम्यते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004799026, "chapter_id": 24799, "verse_number": "६-२६१-२७", "content_sanskrit": "तत्कथ्यतां महाभागे स च ते दर्शनं गतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004799027, "chapter_id": 24799, "verse_number": "६-२६१-२८", "content_sanskrit": "पार्वत्युवाच ।\nमम भाग्यवशात्पुत्रः कथमुत्संगमाहरेत् ।\nन ह्यभाग्यवशात्पुंसां क्वापि सौख्यं निरन्तरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004799028, "chapter_id": 24799, "verse_number": "६-२६१-२९", "content_sanskrit": "सुतनाम्नाप्यहं दृष्ट्वा भवतीनां च दर्शनात् ।\nकिमर्थमिह संप्राप्ताः कथ्यतामविलंबितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004799029, "chapter_id": 24799, "verse_number": "६-२६१-३०", "content_sanskrit": "कृत्तिका ऊचुः ।\nवयं तव सुतं न्यस्तं प्रदातुमिह सुन्दरि ।\nचातुर्मास्ये रवौ स्नातुमागता देवनिम्नगाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004799030, "chapter_id": 24799, "verse_number": "६-२६१-३१", "content_sanskrit": "पार्वत्युवाच ।\nन हास्यावसरः सख्यः सत्यमेव हि कथ्यताम् ।\nएकांतावसरे हास्यं जायते चेतरेतरम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004799031, "chapter_id": 24799, "verse_number": "६-२६१-३२", "content_sanskrit": "कृत्तिका ऊचुः ।\nसत्यं वदामहे देवि तव त्रैलोक्यशोभिते ।\nअस्य स्तंबसमूहस्य मध्यस्थं बालकं वृणु ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004799032, "chapter_id": 24799, "verse_number": "६-२६१-३३", "content_sanskrit": "कृत्तिकानां वचः श्रुत्वा शंकिता पार्वती तदा ।\nददर्श बालं दीप्ताभं षण्मुखं दीप्तवर्चसम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004799033, "chapter_id": 24799, "verse_number": "६-२६१-३४", "content_sanskrit": "तडित्कोटिप्रतीकाशं रूपदिव्यश्रिया युतम् ।\nवह्निपुत्रं च गांगेयं कार्तिकेयं महाबलम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004799034, "chapter_id": 24799, "verse_number": "६-२६१-३५", "content_sanskrit": "सा वत्सेति गृहीत्वा तं कुमारं पाणिना मुदा ।\nविमानमध्यमादाय कृत्वोत्संगे ह्युवाच ह ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004799035, "chapter_id": 24799, "verse_number": "६-२६१-३६", "content_sanskrit": "चिरंजीव चिरं नन्द चिरं नंदय बाधवान् ।\nइत्युक्त्वा गाढमालिंग्य मूर्ध्नि चाघ्राय तं सुतम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004799036, "chapter_id": 24799, "verse_number": "६-२६१-३७", "content_sanskrit": "संहृष्टा परमोदारं भास्वरं हृष्टमानसम् ।\nकार्तिकेयो महाप्रेम्णा प्रणिपत्य महेश्वरम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004799037, "chapter_id": 24799, "verse_number": "६-२६१-३८", "content_sanskrit": "ततः प्रांजलिरव्यग्रः प्रहृष्टेनांतरात्मना ।\nतद्विमानं ययौ शीघ्रं तीर्त्वा नदनदीपतीन् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004799038, "chapter_id": 24799, "verse_number": "६-२६१-३९", "content_sanskrit": "जंबुद्वीपमतिक्रम्य लक्षयोजनमायतम् ।\nततः समुद्रं द्विगुणं लवणोदं तथैव च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004799039, "chapter_id": 24799, "verse_number": "६-२६१-४०", "content_sanskrit": "उत्तरांश्च कुरून्नीत्वा विमानेनार्कतेजसा ।\nसमुद्रद्विगुणं द्वीपं कुशनाभेति कीर्तितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004799040, "chapter_id": 24799, "verse_number": "६-२६१-४१", "content_sanskrit": "दिव्यलोकसमाक्रांतं दिव्यपर्वतसंकुलम् ।\nइक्षूदाद्विगुणं द्वीपं तद्द्वीपाद्द्विगुणः पुनः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004799041, "chapter_id": 24799, "verse_number": "६-२६१-४२", "content_sanskrit": "तमतिक्रम्य तत्सिन्धोर्दविगुणं क्रौंचसंज्ञितम् ।\nततोऽपि द्विगुणः सिन्धुः सुरोदो यक्षसेवितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004799042, "chapter_id": 24799, "verse_number": "६-२६१-४३", "content_sanskrit": "ततोऽपि द्विगुणं द्वीपं शाकद्वीपेतिसंज्ञितम् ।\nअर्णवद्विगुणं तस्मादाज्यरूपं सुनिर्मितं ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004799043, "chapter_id": 24799, "verse_number": "६-२६१-४४", "content_sanskrit": "परमस्वादसंपूर्णं यत्र सिद्धाः समंततः ।\nतस्माच्च द्विगुणं द्वीपं शाल्मलीवृक्षसंज्ञितम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004799044, "chapter_id": 24799, "verse_number": "६-२६१-४५", "content_sanskrit": "समुद्रो द्विगुणस्तत्र दधिमंडोदसंभवः ।\nसाध्या वसंति नियतं महत्तपसि संस्थिताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004799045, "chapter_id": 24799, "verse_number": "६-२६१-४६", "content_sanskrit": "ततोऽपि द्विगुणं द्वीपं प्लक्षनामेति विश्रुतम् ।\nक्षीरोदो द्विगुणस्तत्र यत्रयत्रमहर्षयः ।\nषडिमानि सुदिव्यानि भौमः स्वर्ग उदाहृतः ।\nतत्र स्वर्णमयी भूमिस्तथा रजतसंयुता ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004799046, "chapter_id": 24799, "verse_number": "६-२६१-४७", "content_sanskrit": "दृष्टवा मधूपलस्वादैः सर्वकामप्रदायका ।\nयत्र स्त्रीपुरुषाणां च कल्पवृक्षा गृहे स्थिताः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004799047, "chapter_id": 24799, "verse_number": "६-२६१-४८", "content_sanskrit": "वासांसि भूषणानां च समूहान्हर्षयंति च ।\nएतानि दक्षचिह्नानि द्वीपानि मुनिसत्तम ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004799048, "chapter_id": 24799, "verse_number": "६-२६१-४९", "content_sanskrit": "महेश्वरो विमानेन व्यतिक्रामद्विहायसा ।\nप्लक्षद्वीपस्य च प्रांते द्विगुणः क्षीरसागरः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004799049, "chapter_id": 24799, "verse_number": "६-२६१-५०", "content_sanskrit": "तन्मध्ये सुमह्द्वीपं श्वेतं नाम सुनिश्चितम् ।\nरम्यकः पर्वतस्तत्र शतशृंगोमितद्रुमः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004799050, "chapter_id": 24799, "verse_number": "६-२६१-५१", "content_sanskrit": "तस्य शृंगे महद्दिव्ये विमानं स्थापितं तदा ।\nतदाऽमृतफलैर्वृक्षैः सेविते हेमवालुके ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004799051, "chapter_id": 24799, "verse_number": "६-२६१-५२", "content_sanskrit": "क्षीरच्छेदेन विहृते शिलातलसुसंवृते ।\nविविक्ते सर्वसुभगे मणिरत्नसमन्विते ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004799052, "chapter_id": 24799, "verse_number": "६-२६१-५३", "content_sanskrit": "उमायै कथयामास देवदेवः पिनाकधृक् ।\nकार्तिकेयोऽपि शुश्राव गुह्याद्गुह्यतरं महत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004799053, "chapter_id": 24799, "verse_number": "६-२६१-५४", "content_sanskrit": "ध्यानयोगं मंत्ररूपं द्वादशाक्षरसंज्ञितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004799054, "chapter_id": 24799, "verse_number": "६-२६१-५५", "content_sanskrit": "प्रणवेन युतं साग्रं सरहस्यं श्रुतेः परम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004799055, "chapter_id": 24799, "verse_number": "६-२६१-५६", "content_sanskrit": "ईश्वर उवाच ।\nअक्षरत्रयसंयुक्तो मन्त्रोऽयं सकृदक्षरः ।\nमाघमासहितश्चायममाक्षोहेनश्चायममायो विश्वपावनः ।\nविष्णुगम्यो विष्णु मध्यो मन्त्रत्रयसमन्वितः ।\nतुरीयकलयाऽशेषब्रह्मांडगणसेवितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004799056, "chapter_id": 24799, "verse_number": "६-२६१-५७", "content_sanskrit": "निष्कामैर्मुनिभिः सेव्यो महाविद्यादिसेवितः ।\nनाभितः शिरसि व्याप्त अखण्डसुखदायकः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004799057, "chapter_id": 24799, "verse_number": "६-२६१-५८", "content_sanskrit": "ओंकारेति प्रियोक्तिस्ते महादुःखविनाशनः ।\nतं पूर्वं प्रणवं ध्यात्वा ज्ञानरूपं सुखाश्रयम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004799058, "chapter_id": 24799, "verse_number": "६-२६१-५९", "content_sanskrit": "ज्ञात्वा सर्वगतं ब्रह्म देहशोधनतत्परः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004799059, "chapter_id": 24799, "verse_number": "६-२६१-६०", "content_sanskrit": "पद्मासनपरो भूत्वा संपूज्य ज्ञानलोचनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004799060, "chapter_id": 24799, "verse_number": "६-२६१-६१", "content_sanskrit": "नेत्रे मुकुलिते कृत्वा शुरो करौ कृत्वा तु संहतौ ।\nचेतसि ध्यानरूपेण चिंतयेच्छिवमंगलम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004799061, "chapter_id": 24799, "verse_number": "६-२६१-६२", "content_sanskrit": "तडित्कोटिप्रतीकाशं सूर्यकोटिसमच्छविम् ।\nचन्द्रलक्षसमच्छन्नं पुरुषं द्योतिताखिलम् १ ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004799062, "chapter_id": 24799, "verse_number": "६-२६१-६३", "content_sanskrit": "मूर्त्तामूर्त्तवैराजं तं सदसद्रूप मव्यम् ।\nचिंतयित्वा विराड्रूपं न भूयःस्तनपो भवेत् ।\nचातुर्मास्ये सकृदपि ध्यानात्कल्मषसंक्षयः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004799063, "chapter_id": 24799, "verse_number": "६-२६१-६४", "content_sanskrit": "एवं च मद्रूपमिदं मुरारेरमोघवीर्यं गुण तोप्यपारम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004799064, "chapter_id": 24799, "verse_number": "६-२६१-६५", "content_sanskrit": "विलोकयेद्योऽघविनाशनाय क्षणं प्रभुर्जन्मशतोद्भवाय ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004799065, "chapter_id": 24799, "verse_number": "६-२६१-६६", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीसाहस्र्यां संहितायां षष्ठे नागरखण्डे हाटकेश्वरक्षेत्रमाहात्म्ये शेषशाय्युपाख्याने ब्रह्मनारदसंवादे चातुर्मास्यमाहात्म्ये ध्यानयोगोनामैकषष्ट्युत्तरद्विशततमोऽध्यायः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]