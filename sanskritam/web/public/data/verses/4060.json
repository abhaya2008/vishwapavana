[{"id": 2141928, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2141929, "chapter_id": 4060, "verse_number": "१", "content_sanskrit": "अवजित्य धनं चैव विराटो वाहिनीपतिः ।\nप्राविशन्नगरं हृष्टश्चतुर्भिः सह पाण्डवैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2141930, "chapter_id": 4060, "verse_number": "२", "content_sanskrit": "जित्वा त्रिगर्तान् सङ्ग्रामे गाश्चैवानाय्य केवलाः ।\nअशोभत महाराजः सह पार्थैः श्रिया वृतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2141931, "chapter_id": 4060, "verse_number": "३", "content_sanskrit": "तमासनगतं वीरं सुहृदां नन्दवर्धनम् ।\nउपतस्थुः प्रकृतयः समस्ता ब्राह्मणैः सह\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2141932, "chapter_id": 4060, "verse_number": "४", "content_sanskrit": "सभाजितः स ताभिस्तु प्रतिनन्द्य स मत्स्यराट् ।\nविसर्जयामास तदा द्विजांश्च प्रकृतीस्तदा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2141933, "chapter_id": 4060, "verse_number": "५", "content_sanskrit": "ततः स राजा मत्स्यानां विराटो वाहिनीपतिः ।\nउत्तरं परिपप्रच्छ क्व यात इति चाब्रवीत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2141934, "chapter_id": 4060, "verse_number": "६", "content_sanskrit": "आचख्युस्तत्र संहृष्टाः स्त्रियः कन्याश्च वेश्मनि ।\nअन्तःपुरचराश्चैव कुरुभिर्गोधनं हृतम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2141935, "chapter_id": 4060, "verse_number": "७", "content_sanskrit": "तान् जेतुमतिसंरब्ध एक एवातिसाहसात् ।\nबृहन्नळासहायश्च निर्यातः पृथिवीञ्जयः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2141936, "chapter_id": 4060, "verse_number": "८", "content_sanskrit": "उपयातानतिरथान् द्रोणं शान्तनवं कृपम् ।\nकर्णं दुर्योधनं चैव द्रोणपुत्रं च षड्रथान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2141937, "chapter_id": 4060, "verse_number": "९", "content_sanskrit": "ततो विराटः परमाभितप्तः\nपुत्रं निशम्यैकरथेन यातम् ।\nबृहन्नळासारथिमाजिमर्दनं\nप्रोवाच सर्वानथ मन्त्रिमुख्यान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2141938, "chapter_id": 4060, "verse_number": "१०", "content_sanskrit": "गवां शतसहस्राणि अभिभूय ममात्मजम् ।\nकुरवः कालयन्ति स्म सर्वे युद्धविशारदाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2141939, "chapter_id": 4060, "verse_number": "११", "content_sanskrit": "तस्माद् गच्छन्तु मे योधा बलेन महता वृताः ।\nउत्तरस्य परीप्सार्थं ये त्रिगर्तैरविक्षताः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2141940, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2141941, "chapter_id": 4060, "verse_number": "१२", "content_sanskrit": "हयांश्च नागांश्च रथांश्च शीघ्रं\nवादित्रसङ्घांश्च ततः प्रभूतान् ।\nप्रस्थापयामास सुतस्य हेतोः\nविचित्रवस्त्राभरणोपपन्नम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2141942, "chapter_id": 4060, "verse_number": "१३", "content_sanskrit": "एवं स राजा मत्स्यानां महानक्षोहिणीपतिः ।\nव्यादिदेशाथ स क्षिप्रं वाहिनीं चतुरङ्गिणीम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2141943, "chapter_id": 4060, "verse_number": "१४", "content_sanskrit": "कुमारमाशु जानीत यदि जीवति वा न वा ।\nयस्य यन्ता गतः षण्डो मन्येऽहं न च जीवति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2141944, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2141945, "chapter_id": 4060, "verse_number": "१५", "content_sanskrit": "तमब्रवीद् धर्मसुतो विराटम्\nआर्तं विदित्वा कुरुभिः प्रतप्तम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2141946, "chapter_id": 4060, "verse_number": "१६", "content_sanskrit": "बृहन्नळा सारथिश्चेन्नरेन्द्र\nपरे न नेष्यन्ति तवाद्य गाश्च\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2141947, "chapter_id": 4060, "verse_number": "१७", "content_sanskrit": "सर्वान् महीपान् सहितान् कुरूंश्च\nतथैव देवासुरनागयक्षान् ।\nअलं विजेतुं समरे सुतस्ते\nस्वनुष्ठितः सारथिना हि तेन\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2141948, "chapter_id": 4060, "verse_number": "१८", "content_sanskrit": "सर्वथा कुरवश्चापि ये चान्ये वसुधाधिपाः ।\nत्रिगर्तान् निर्जितान् श्रुत्वा न स्थास्यन्ति कथञ्चन\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2141949, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2141950, "chapter_id": 4060, "verse_number": "१९", "content_sanskrit": "अथोत्तरेण प्रहिता दूतास्ते शीघ्रगामिनः ।\nविराटनगरं प्राप्य जयं प्रावेदयंस्तदा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2141951, "chapter_id": 4060, "verse_number": "२०", "content_sanskrit": "राजानं तत आचक्ष्युर्मन्त्रिभिर्जयमुत्तमम् ।\nपराजयं कुरूणां चाप्युपायान्तं तथोत्तरम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2141952, "chapter_id": 4060, "verse_number": "२१", "content_sanskrit": "सर्वा विनिर्जिता गावः कुरवश्च पराजिताः ।\nउत्तरः सह सूतेन कुशली च परन्तपः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2141953, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "कङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2141954, "chapter_id": 4060, "verse_number": "२२", "content_sanskrit": "दिष्ट्या ते निर्जिता गावः कुरवश्च पराजिताः ।\nदिष्ट्या ते विजयी पुत्रः श्रूयते पार्थिवर्षभ\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2141955, "chapter_id": 4060, "verse_number": "२३", "content_sanskrit": "नात्यद्भुतमिदं मन्ये यत् ते पुत्रोऽजयत् कुरून् ।\nध्रुव एव जयस्तस्य यस्य यन्ता बृहन्नळा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2141956, "chapter_id": 4060, "verse_number": "२४", "content_sanskrit": "देवेन्द्रसारथिश्चैव मातलिर्लघुविक्रमः ।\nकृष्णस्य सारथिश्चैव न बृहन्नळया समौ\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2141957, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2141958, "chapter_id": 4060, "verse_number": "२५", "content_sanskrit": "ततो विराटो नृपतिः सम्प्रहृष्टतनूरुहः ।\nश्रुत्वा तु विजयं तस्य कुमारस्यामितौजसः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2141959, "chapter_id": 4060, "verse_number": "२६", "content_sanskrit": "सन्तोषयित्वा दूतांस्तान् धनरत्नैश्च सर्वशः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2141960, "chapter_id": 4060, "verse_number": "२७", "content_sanskrit": "गते त्वनुबले तस्मिन् दूतवाक्यं निशम्य तु ।\nउत्तरस्य जयं प्रीतो विराटः प्रत्यभाषत\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2141961, "chapter_id": 4060, "verse_number": "२८", "content_sanskrit": "राजमार्गाः क्रियन्तां वै पताकाभिरलङ्कृताः ।\nपुष्पोपहारैरर्च्यन्तां देवताश्चापि सर्वशः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2141962, "chapter_id": 4060, "verse_number": "२९", "content_sanskrit": "कुमारा योधमुख्याश्च गणिकाश्च स्वलङ्कृताः ।\nवादित्राणि च सर्वाणि प्रत्युद्यान्तु सुतं मम\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2141963, "chapter_id": 4060, "verse_number": "३०", "content_sanskrit": "भवन्तु ते लब्धजये सुते मे\nपौराश्च नार्यश्च पुरे च मर्त्याः ।\nते शुक्लवस्त्राः प्रभवन्तु मार्गे\nसुगन्धमाल्याभरणाश्च नार्यः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2141964, "chapter_id": 4060, "verse_number": "३१", "content_sanskrit": "भजन्तु सर्वा गणिकाः सुतं मे\nनार्यश्च कन्याः सहकन्यकाश्च ।\nस्वलङ्कृतास्ता सुभगा सुवेषाः\nपुत्रस्य पन्थानमनुव्रजन्तु\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2141965, "chapter_id": 4060, "verse_number": "३२", "content_sanskrit": "सघण्ठं साङ्कुशं शीघ्रं मत्तमारुह्य वारणम् ।\nशृङ्गाटकेषु सर्वेषु समाख्यातु जयं मम\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2141966, "chapter_id": 4060, "verse_number": "३३", "content_sanskrit": "उत्तरा च कुमारीभिर्बह्वाभरणभूषिता ।\nसखीं विजितसङ्ग्रामां प्रत्युद्यातु बृहन्नळाम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2141967, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2141968, "chapter_id": 4060, "verse_number": "३४", "content_sanskrit": "श्रुत्वा तु वचनं राज्ञः पौराः स्वस्तिकपाणयः ।\nसर्वे सुप्रीतमनसः प्रतिजग्मुर्यथोचितम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2141969, "chapter_id": 4060, "verse_number": "३५", "content_sanskrit": "सूताश्च सर्वे सहमागधाश्च\nदृष्ट्वा विराटस्य पुरं जनौघाः ।\nभेरीश्च तूर्याणि च वारिजांश्च\nवेषैः परार्घ्यैः प्रमदाजनाश्च\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2141970, "chapter_id": 4060, "verse_number": "३६", "content_sanskrit": "वन्दिप्रवादाः पणवादिकाश्च\nतथैव वाद्यानि च वंशशब्दाः ।\nसकंसतालं मधुरं च गीतम्\nआदाय नार्यो नगरान्निरीयुः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2141971, "chapter_id": 4060, "verse_number": "३७", "content_sanskrit": "प्रत्युद्ययुः पुत्रमनन्तवीर्यं\nते ब्राह्मणाः शान्तिपराः प्रधानाः ।\nस्वाध्यायवेदाध्ययनक्रमज्ञाः\nस्वस्तिक्रियागीतजयप्रधानाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2141972, "chapter_id": 4060, "verse_number": "३८", "content_sanskrit": "प्रस्थाप्य सेनां कन्याश्च गणिकाश्च स्वलङ्कृताः ।\nमत्स्यराजो महाप्राज्ञः प्रहृष्ट इदमब्रवीत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2141973, "chapter_id": 4060, "verse_number": "३९", "content_sanskrit": "अक्षानाहर सैरन्ध्रि कङ्क द्यूतं प्रवर्तताम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2141974, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2141975, "chapter_id": 4060, "verse_number": "४०", "content_sanskrit": "तं तथावादिनं दृष्ट्वा पाण्डवः प्रत्यभाषत\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2141976, "chapter_id": 4060, "verse_number": "४१", "content_sanskrit": "न देवितव्यं हृष्टेन कितवेनेति नः श्रुतम् ।\nन त्वामद्य मुदा युक्तमहं देवितुमुत्सहे\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2141977, "chapter_id": 4060, "verse_number": "४२", "content_sanskrit": "प्रियं तु ते चिकीर्षामि वर्ततां यदि रोचते\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2141978, "chapter_id": 4060, "verse_number": "४३", "content_sanskrit": "द्यूतं कर्तुं न वाञ्छामि नरेन्द्र जनसंसदि\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2141979, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "विराटः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2141980, "chapter_id": 4060, "verse_number": "४४", "content_sanskrit": "स्त्रियो गावो हिरण्यं च यच्चान्यद् वस्तु किञ्चन ।\nन मे किञ्चित् त्वया रक्ष्यमन्तरेणापि देवितम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2141981, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "कङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2141982, "chapter_id": 4060, "verse_number": "४५", "content_sanskrit": "किं ते द्यूतेन राजेन्द्र बहुदोषेण मानद ।\nदेवने बहवो दोषास्तस्मात् तत् परिवर्जयेत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2141983, "chapter_id": 4060, "verse_number": "४६", "content_sanskrit": "श्रुतस्ते यदि वा दृष्टः पाण्डवो वै युधिष्ठिरः ।\nस राज्यं धनमक्ष्यय्यं पणमेकममन्यत\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2141984, "chapter_id": 4060, "verse_number": "४७", "content_sanskrit": "कृष्णां च भार्यां दयितां भ्रातॄंश्च त्रिदशोपमान् ।\nनिःसंशयं स कितवः पश्चात् तपति पाण्डवः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2141985, "chapter_id": 4060, "verse_number": "४८", "content_sanskrit": "विविधानां च रत्नानां धनानां च पराजये ।\nअथ क्षितिविनाशश्च वाक्पारुष्यमनन्तरम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2141986, "chapter_id": 4060, "verse_number": "४९", "content_sanskrit": "अविश्वासं बुधैर्नित्यमेकाह्ना द्रव्यनाशनम् ।\nद्यूते हारितवान् सर्वं तस्माद् द्यूतं न रोचये\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2141987, "chapter_id": 4060, "verse_number": "५०", "content_sanskrit": "अथवा मन्यसे राजन् दीव्याव यदि रोचते\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2141988, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2141989, "chapter_id": 4060, "verse_number": "५१", "content_sanskrit": "एवमाभाष्य वादैस्तु क्रीडतस्तौ नरोत्तमौ ।\nप्रवर्तमाने द्यूते तु मात्स्यः पाण्डवमब्रवीत्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2141990, "chapter_id": 4060, "verse_number": "५२", "content_sanskrit": "पश्य पुत्रेण मे युद्धे तादृशाः कुरवो जिताः ।\nकुरवोऽतिरथाः सर्वे देवैरपि सुदुर्जयाः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2141991, "chapter_id": 4060, "verse_number": "५३", "content_sanskrit": "ततोऽब्रवीद् धर्मराजो द्यूते मात्स्यं युधिष्ठिरः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2141992, "chapter_id": 4060, "verse_number": "५४", "content_sanskrit": "दिष्ट्या ते विजिता गावः कुरवश्च पराजिताः ।\nअत्यद्भुतमहं मन्ये उत्तरश्चेत् कुरून् जयेत्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2141993, "chapter_id": 4060, "verse_number": "५५", "content_sanskrit": "यन्ता बृहन्नळा यस्य सा कथञ्चिद् विजेष्यते\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2141994, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2141995, "chapter_id": 4060, "verse_number": "५६", "content_sanskrit": "ततो विराटः क्षुभितो मन्युनाऽतिपरिप्लुतः ।\nउवाच वचनं क्रुद्धः परिव्राजमनन्तरम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2141996, "chapter_id": 4060, "verse_number": "५७", "content_sanskrit": "तादृशेन तु युद्धेन महेष्वासेन धीमता ।\nकुरवो निर्जिता युद्धे तत्र किं ब्राह्मणाद्भुतम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2141997, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2141998, "chapter_id": 4060, "verse_number": "५८", "content_sanskrit": "यन्ता तथाविधो यस्य रथे तिष्ठति वीर्यवान् ।\nयदि तद् दुष्करं कुर्यात् तत्र किं नाद्भुतं भवेत्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2141999, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "विराटः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2142000, "chapter_id": 4060, "verse_number": "५९", "content_sanskrit": "पुमांसो बहवो दृष्टाः सूताश्च बहवो मया ।\nविक्रम्य यन्ता योद्धा च न मे दृष्टः कथञ्चन\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2142001, "chapter_id": 4060, "verse_number": "६०", "content_sanskrit": "विप्रियं नाचरेद् राज्ञामनुरूपं प्रियं वदेत् ।\nआचरन् विप्रियं राज्ञां न जातु सुखमेधते\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2142002, "chapter_id": 4060, "verse_number": "६१", "content_sanskrit": "वयस्यत्वात्तु ते सर्वमपराधमिमं क्षमे ।\nनेदृशीं प्रवदेर्वाचं यदि जीवितुमिच्छसि\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2142003, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2142004, "chapter_id": 4060, "verse_number": "६२", "content_sanskrit": "ततोऽब्रवीत् पुनः कङ्कः प्रहस्य कुरुनन्दन\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2142005, "chapter_id": 4060, "verse_number": "६३", "content_sanskrit": "बृहन्नळाया राजेन्द्र घुष्यतां नगरे जयः ।\nउत्तरेण हि सारथ्यं कृतं नूनं भविष्यति\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2142006, "chapter_id": 4060, "verse_number": "६४", "content_sanskrit": "निमित्तं किञ्चदुत्पन्नं तर्कश्चापि दृढो मम ।\nइतो जानामि राजेन्द्र नान्यथा तद् भविष्यति\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2142007, "chapter_id": 4060, "verse_number": "६५", "content_sanskrit": "कुरवोऽपि महावीर्या देवैरपि सुदुर्जयाः ।\nससोमवरुणादित्यैः सकुबेरहुताशनैः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2142008, "chapter_id": 4060, "verse_number": "६६", "content_sanskrit": "यत्र शान्तनवो भीष्मो द्रोणकर्णौ सुदुर्जयौ ।\nअश्वत्थामा विकर्णश्च सोमदत्तो जयद्रथः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2142009, "chapter_id": 4060, "verse_number": "६७", "content_sanskrit": "भूरिश्रवाः शलो भूरिर्जलसन्धश्च वीर्यवान् ।\nदुर्योधनो दुष्प्रसहो दुःशासनविविंशती\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2142010, "chapter_id": 4060, "verse_number": "६८", "content_sanskrit": "वृषसेनोऽश्वसेनश्च वातवेगसुवर्चसौ ।\nबाह्लीकः शूरसेनश्च युयुत्सुश्च परन्तपः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2142011, "chapter_id": 4060, "verse_number": "६९", "content_sanskrit": "सौबलः शकुनिश्चैव द्युमत्सेनश्च साल्वराट् ।\nअन्ये च बहवः शूरा नानाजनपदेश्वराः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2142012, "chapter_id": 4060, "verse_number": "७०", "content_sanskrit": "कृपेणाचार्यमुख्येन सहिता कुरवो नृपाः ।\nसज्जकार्मुकनिस्त्रिंशा रथिनो रथयूथपाः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2142013, "chapter_id": 4060, "verse_number": "७१", "content_sanskrit": "अन्ये चैव महावीर्या राजपुत्रा महारथाः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2142014, "chapter_id": 4060, "verse_number": "७२", "content_sanskrit": "मरुद्गणैः परिवृतः साक्षादपि पुरन्दरः ।\nतद्बलं न जयेत् क्रुद्धो भीष्मद्रोणादिभिर्वृतम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2142015, "chapter_id": 4060, "verse_number": "७३", "content_sanskrit": "कस्तद् बृहन्नळादन्यो मनुष्यः प्रतियोत्स्यति\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2142016, "chapter_id": 4060, "verse_number": "७४", "content_sanskrit": "यस्य बाहुबले तुल्यो न भूतो न भविष्यति ।\nअतीवसमरं दृष्ट्वा हर्षो यस्य हि जायते\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2142017, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2142018, "chapter_id": 4060, "verse_number": "७५", "content_sanskrit": "तेन सङ्क्षुभितो राजा दीर्यमाणेन चेतसा ।\nअब्रवीद् वचनं तात अजानन् वै युधिष्ठिरम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2142019, "chapter_id": 4060, "verse_number": "७६", "content_sanskrit": "कङ्क मा त्वं ब्रवीर्वाक्यं प्रतिकूलं द्विजोत्तम ।\nबहुशः प्रतिषिद्धः सन् न चेद् वाचं नियच्छसि\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2142020, "chapter_id": 4060, "verse_number": "७७", "content_sanskrit": "नियन्ता चेन्न विद्येत न कश्चिद् धर्ममाचरेत्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2142021, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2142022, "chapter_id": 4060, "verse_number": "७८", "content_sanskrit": "ततः प्रक्षुभितो राजा सोऽक्षेणाभ्यहनद् भृशम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2142023, "chapter_id": 4060, "verse_number": "७९", "content_sanskrit": "ततः स करिभोगाभं बाहुमुद्यम्य दक्षिणम् ।\nविराटः प्राहरत् क्रुद्धः कर्णमाश्रित्य दक्षिणम्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2142024, "chapter_id": 4060, "verse_number": "८०", "content_sanskrit": "मुखे युधिष्ठिरं कोपान्मैवमित्यवभर्त्सयन्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2142025, "chapter_id": 4060, "verse_number": "८१", "content_sanskrit": "बलवत् प्रतिविद्धस्य ततः शोणितमागमत्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2142026, "chapter_id": 4060, "verse_number": "८२", "content_sanskrit": "अक्षेणाभिहतो राजा विराटेन महीपतिः ।\nतूष्णीमासीन्महाबाहुः कृष्णां सम्प्रेक्ष्य दुःखितः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2142027, "chapter_id": 4060, "verse_number": "८४", "content_sanskrit": "तस्य रक्तोत्पलनिभं शिरसः शोणितं तदा ।\nप्रावर्तत महाबाहोरभिघातान्महात्मनः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2142028, "chapter_id": 4060, "verse_number": "८४", "content_sanskrit": "तदप्राप्तं महीं पार्थः पाणिभ्यां समधारयत् ।\nअवैक्षत च धर्मात्मा द्रौपदीं पार्श्वतः स्थिताम्\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2142029, "chapter_id": 4060, "verse_number": "८५", "content_sanskrit": "सा वेदनामभिज्ञाय भर्तुश्चित्तवशानुगा ।\nसा विषण्णा च भीता च क्रुद्धा च द्रुपदात्मजा\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2142030, "chapter_id": 4060, "verse_number": "८६", "content_sanskrit": "बाष्पं नियम्य दुःखं च भर्तुर्निश्रेयकारिणी ।\nउत्तरीयेण सूक्ष्मेण तूर्णं जग्राह शोणितम्\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2142031, "chapter_id": 4060, "verse_number": "८७", "content_sanskrit": "निगृह्य रक्तं वस्त्रेण सैरन्ध्री दुःखमोहिता ।\nसौवर्णं गृह्य भृङ्गारं शोणितं तदपासृजत्\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2142032, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "विराटः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2142033, "chapter_id": 4060, "verse_number": "८८", "content_sanskrit": "सैरन्ध्रि किमिदं रक्तमुत्तरीयेण गृह्यते ।\nकोऽत्र हेतुर्विशालाक्षि तन्ममाचक्ष्व तत्त्वतः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2142034, "chapter_id": 4060, "verse_number": "", "content_sanskrit": "सैरन्ध्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2142035, "chapter_id": 4060, "verse_number": "८९", "content_sanskrit": "रक्तबिन्दूनि कङ्कस्य यावन्ति धरणीं ययुः ।\nतावद्वर्षाणि राष्ट्रे तेऽनावृष्टिर्भविष्यति\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2142036, "chapter_id": 4060, "verse_number": "९०", "content_sanskrit": "एतन्निमित्तं मत्स्येन्द्र कङ्कस्य रुधिरं मया ।\nगृहीतमुत्तरीयेण विनाशो मा भवेत् तव\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2142037, "chapter_id": 4060, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nविराटपर्वणि अष्टषष्टितमोऽध्यायः ॥६८॥\nगोग्रहणपर्वणि एकचत्वारिंशोऽध्यायः ॥४१॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}]