[{"id": 7000316000, "chapter_id": 20316, "verse_number": "१-७०-१", "content_sanskrit": "व्यास उवाच ।\nततो देवांतको दैत्यो व्यनदत्समरं प्रति ।\nरणं चकार धर्मेण संदष्टौष्ठपुटो बली॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000316001, "chapter_id": 20316, "verse_number": "१-७०-२", "content_sanskrit": "स गत्वा चाब्रवीद्वाक्यं सर्वलोकविगर्हितं ।\nन जानासि महद्धर्मं दुष्ट मोहाद्यथाक्रमम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000316002, "chapter_id": 20316, "verse_number": "१-७०-३", "content_sanskrit": "पापपुण्यप्रयोगेण निग्रहानुग्रहे प्रभुः ।\nअहं च निर्मितो धात्रा करोमि तव शासनम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000316003, "chapter_id": 20316, "verse_number": "१-७०-४", "content_sanskrit": "न जानासि यतो धर्मं कालमृत्यु पुरःसरः ।\nन रोगो न जरा कालो न मृत्युर्न च किंकरः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000316004, "chapter_id": 20316, "verse_number": "१-७०-५", "content_sanskrit": "धर्मात्प्रचलितः कर्मी कष्टं याति दिवानिशम् ।\nउक्तं वसुं महावीर्यं यमं धर्मैकसाक्षिकम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000316005, "chapter_id": 20316, "verse_number": "१-७०-६", "content_sanskrit": "स जघान त्रिभिर्बाणैः कालमृत्युसमप्रभैः ।\nप्रचिच्छेद स धर्मात्मा ते त्वन्यैर्विशिखैस्त्रिभिः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000316006, "chapter_id": 20316, "verse_number": "१-७०-७", "content_sanskrit": "ततस्तूच्चैः शरैः प्राज्यैर्युगांतानलसप्रभैः ।\nनिजघान यमं संख्ये स चिच्छेद शरैः शरान्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000316007, "chapter_id": 20316, "verse_number": "१-७०-८", "content_sanskrit": "एतस्मिन्नंतरे क्रुद्धौ परस्परजयैषिणौ ।\nजघ्नतुः समरेन्योन्यं महाबलपराक्रमौ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000316008, "chapter_id": 20316, "verse_number": "१-७०-९", "content_sanskrit": "अहोरात्रं तयोर्युद्धमवर्त्तत सुदारुणम् ।\nएतस्मिन्नन्तरे क्रुद्धः शक्त्या प्रशमनं रुषा॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000316009, "chapter_id": 20316, "verse_number": "१-७०-१०", "content_sanskrit": "बिभेद दैत्यशार्दूलो ह्यहंकारयुतो बली ।\nतामेवाथ रुषा धर्मो गृहीत्वा शक्तिकां द्रुतं॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000316010, "chapter_id": 20316, "verse_number": "१-७०-११", "content_sanskrit": "निजघान तयैवामुंस्तनयोरंतरे भृशम् ।\nस विह्वलित सर्वांगो मुखादागतशोणितः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000316011, "chapter_id": 20316, "verse_number": "१-७०-१२", "content_sanskrit": "ततः क्रुद्धो महातेजा धृत्वा दंडं सुदारुणम् ।\nअमोघं पातयामास तस्य दैत्यस्य विग्रहे॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000316012, "chapter_id": 20316, "verse_number": "१-७०-१३", "content_sanskrit": "साश्वं रथं तथा सूतं योद्धारं शस्त्रसंचयम् ।\nचकार भस्मसात्तं च शमनः क्रोधमूर्च्छितः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000316013, "chapter_id": 20316, "verse_number": "१-७०-१४", "content_sanskrit": "पतिते च तथा दैत्ये दुर्धर्षो नाम दानवः ।\nशमनं शूलहस्तस्तु प्रदुद्राव जिघांसया॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000316014, "chapter_id": 20316, "verse_number": "१-७०-१५", "content_sanskrit": "शूलहस्तं समायांतं बडवानलसन्निभम् ।\nआससाद रणे मृत्युः शक्तिहस्तोतिनिर्भयः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000316015, "chapter_id": 20316, "verse_number": "१-७०-१६", "content_sanskrit": "स च दृष्ट्वाऽसुरो मृत्युं शूलेनैव जघान ह ।\nशक्तिं चैव ततो मृत्युः प्रचिक्षेप रणाजिरे॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000316016, "chapter_id": 20316, "verse_number": "१-७०-१७", "content_sanskrit": "संदह्य सहसा शूलं वह्निकूटसमप्रभम् ।\nदैत्यस्य हृदयं भित्वा गता सा च धरातलम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000316017, "chapter_id": 20316, "verse_number": "१-७०-१८", "content_sanskrit": "सरथः स पपातोर्व्यां शक्तिजर्जरविग्रहः ।\nअथान्यो दुर्मुखो मृत्युं कृष्टचापो महाबलः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000316018, "chapter_id": 20316, "verse_number": "१-७०-१९", "content_sanskrit": "खड्गचर्मधरः कालो रथ एव गतोभवत् ।\nदृष्ट्वा तं विशिखैः प्राज्यैर्जघान स यमं रणे॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000316019, "chapter_id": 20316, "verse_number": "१-७०-२०", "content_sanskrit": "स चाप्लत्य रथाद्देवो ह्यसिना च सकुंडलम् ।\nशिरश्चिच्छेद सहसा पातयित्वा च भूतले॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000316020, "chapter_id": 20316, "verse_number": "१-७०-२१", "content_sanskrit": "हतशेषं बलं सर्वं प्रदुद्राव दिशो दश॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]