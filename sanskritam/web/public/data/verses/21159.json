[{"id": 7001159000, "chapter_id": 21159, "verse_number": "२-३-७-१", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nततो मेना पुरस्सा वै सुता भूत्वा महाद्युतिः ।\nचकार रोदनं तत्र लौकिकीं गतिमाश्रिता॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001159001, "chapter_id": 21159, "verse_number": "२-३-७-२", "content_sanskrit": "अरिष्टशय्यां परितस्सद्विसारिसुतेजसा ।\nनिशीथदीपा विहतत्विष आसन्नरं मुने॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001159002, "chapter_id": 21159, "verse_number": "२-३-७-३", "content_sanskrit": "श्रुत्वा तद्रोदनं रम्यं गृहस्थास्सर्वयोषितः ।\nजहृषुस्सम्भ्रमात्तत्रागताः प्रीतिपुरस्सराः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001159003, "chapter_id": 21159, "verse_number": "२-३-७-४", "content_sanskrit": "तच्छुद्धान्तचरः शीघ्रं शशंस भूभृते तदा ।\nपार्वतीजन्म सुखदं देवकार्यकरं शुभम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001159004, "chapter_id": 21159, "verse_number": "२-३-७-५", "content_sanskrit": "तच्छुद्धान्तचरायाशु पुत्रीजन्म सुशंसते ।\nसितातपत्रं नादेयमासीत्तस्य महीभृतः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001159005, "chapter_id": 21159, "verse_number": "२-३-७-६", "content_sanskrit": "गतस्तत्र गिरिः प्रीत्या सपुरोहितसद्विजः ।\nददर्श तनयां तान्तु शोभमानां सुभाससा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001159006, "chapter_id": 21159, "verse_number": "२-३-७-७", "content_sanskrit": "नीलोत्पलदल श्यामां सुद्युतिं सुमनोरमाम् ।\nदृष्ट्वा च तादृशीं कन्यां मुमोदाति गिरीश्वरः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001159007, "chapter_id": 21159, "verse_number": "२-३-७-८", "content_sanskrit": "सर्वे च मुमुदुस्तत्र पौराश्च पुरुषाः स्त्रियः ।\nतदोत्सवो महानासीन्नेदुर्वाद्यानि भूरिशः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001159008, "chapter_id": 21159, "verse_number": "२-३-७-९", "content_sanskrit": "बभूव मंगलं गानं ननृतुर्वारयोषितः ।\nदानं ददौ द्विजातिभ्यो जातकर्मविधाय च॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001159009, "chapter_id": 21159, "verse_number": "२-३-७-१०", "content_sanskrit": "अथ द्वारं समागत्य चकार सुमहोत्सवम् ।\nहिमाचलः प्रसन्नात्मा भिक्षुभ्यो द्रविणन्ददौ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001159010, "chapter_id": 21159, "verse_number": "२-३-७-११", "content_sanskrit": "अथो मुहूर्त्ते सुमते हिमवान्मुनिभिः सह ।\nनामाऽकरोत्सुतायास्तु कालीत्यादि सुखप्रदम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001159011, "chapter_id": 21159, "verse_number": "२-३-७-१२", "content_sanskrit": "दानं ददौ तदा प्रीत्या द्विजेभ्यो बहु सादरम् ।\nउत्सवं कारयामास विविधं गानपूर्व्वकम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001159012, "chapter_id": 21159, "verse_number": "२-३-७-१३", "content_sanskrit": "इत्थं कृत्वोत्सवं भूरि कालीं पश्यन्मुहुर्मुहुः ।\nलेभे मुदं सपत्नीको बहुपुत्रोऽपि भूधरः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001159013, "chapter_id": 21159, "verse_number": "२-३-७-१४", "content_sanskrit": "तत्र सा ववृधे देवी गिरिराजगृहे शिवा ।\nगंगेव वर्षासमये शरदीवाथ चन्द्रिका॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001159014, "chapter_id": 21159, "verse_number": "२-३-७-१५", "content_sanskrit": "एवं सा कालिका देवी चार्वङ्गी चारुदर्शना ।\nदध्रे चानुदिनं रम्यां चन्द्रबिम्बकलामिव॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001159015, "chapter_id": 21159, "verse_number": "२-३-७-१६", "content_sanskrit": "कुलोचितेन नाम्ना तां पार्वतीत्याजुहावहा ।\nबन्धुप्रियां बन्धुजनः सौशील्यगुणसंयुताम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001159016, "chapter_id": 21159, "verse_number": "२-३-७-१७", "content_sanskrit": "उमेति मात्रा तपसे निषिद्धा कालिका च सा ।\nपश्चादुमाख्यां सुमुखी जगाम भुवने मुने॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001159017, "chapter_id": 21159, "verse_number": "२-३-७-१८", "content_sanskrit": "दृष्टिः पुत्रवतोऽप्यद्रेस्तस्मिंस्तृप्तिं जगाम न ।\nअपत्ये पार्वतीत्याख्ये सर्वसौभाग्य संयुते॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001159018, "chapter_id": 21159, "verse_number": "२-३-७-१९", "content_sanskrit": "मधोरनन्तपुष्पस्य चूते हि भ्रमरावलिः ।\nविशेषसंगा भवति सहकारे मुनीश्वर॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001159019, "chapter_id": 21159, "verse_number": "२-३-७-२०", "content_sanskrit": "पूतो विभूषितश्चापि स बभूव तया गिरिः ।\nसंस्कारवत्येव गिरा मनीषीव हिमालयः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001159020, "chapter_id": 21159, "verse_number": "२-३-७-२१", "content_sanskrit": "प्रभामहत्या शिखयेव दीपो भुवनस्य च ।\nत्रिमार्गयेव सन्मार्गस्तद्वद्गिरिजया गिरिः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001159021, "chapter_id": 21159, "verse_number": "२-३-७-२२", "content_sanskrit": "कन्दुकैः कृत्रिमैः पुत्रैस्सखीमध्यगता च सा ।\nगंगासैकतवेदीभिर्बाल्ये रेमे मुहुर्मुहुः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001159022, "chapter_id": 21159, "verse_number": "२-३-७-२३", "content_sanskrit": "अथ देवी शिवा सा चोपदेशसमये मुने ।\nपपाठ विद्यात्सुप्रीत्या यतचित्ता च सद्गुरोः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001159023, "chapter_id": 21159, "verse_number": "२-३-७-२४", "content_sanskrit": "प्राक्तना जन्मविद्यास्तां शरदीव प्रपेदिरे ।\nहंसालिस्स्वर्णदी नक्तमात्मभासो महौषधिम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001159024, "chapter_id": 21159, "verse_number": "२-३-७-२५", "content_sanskrit": "इत्थं सुवर्णिता लीला शिवायाः काचिदेव हि ।\nअन्यलीलाम्प्रवक्ष्येऽहं शृणु त्वं प्रेमतो मुने॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]