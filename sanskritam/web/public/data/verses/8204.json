[{"id": 900001027, "chapter_id": 8204, "verse_number": "3.1", "content_sanskrit": "तदेतत् सत्यम् । मन्त्रेषु कर्माणि कवयो यान्यपश्यन् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001028, "chapter_id": 8204, "verse_number": "3.2", "content_sanskrit": "यदा लेलायते ह्यर्चिः समिद्धे हव्यवाहने", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001029, "chapter_id": 8204, "verse_number": "3.3", "content_sanskrit": "यस्याग्निहोत्रमदर्शमपौर्णमासमनाग्रयणमतिथिविर्जितं च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001030, "chapter_id": 8204, "verse_number": "3.4", "content_sanskrit": "काळी कराळी च मनोजवा च सुलोहिता या च सुधूम्रवर्णा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001031, "chapter_id": 8204, "verse_number": "3.5", "content_sanskrit": "एतेषु यश्वरते भ्राजमानेषु यथाकालं चाऽहुतयो ह्याददायन्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001032, "chapter_id": 8204, "verse_number": "3.6", "content_sanskrit": "एह्येहीति तमाहुतयः सुवर्चसः सूर्यस्य रश्मिभिर्यजमानं वहन्ति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001033, "chapter_id": 8204, "verse_number": "3.7", "content_sanskrit": "'सहयज्ञाः प्रजाः सृष्ट्वा' इत्युक्त्वा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900001034, "chapter_id": 8204, "verse_number": "3.8", "content_sanskrit": "अग्निष्टोमादिभिर्यज्ञैः सर्वदेवस्थितं हरिम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900001035, "chapter_id": 8204, "verse_number": "3.9", "content_sanskrit": "प्लवा ह्येते अदृढा यज्ञरूपा अष्टादशोक्तमवरं येषु कर्म", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900001036, "chapter_id": 8204, "verse_number": "3.10", "content_sanskrit": "अविद्यायामन्तरे वेष्ट्यमानाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900001037, "chapter_id": 8204, "verse_number": "3.11", "content_sanskrit": "अविद्यायां बहुधा वर्तमाना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900001038, "chapter_id": 8204, "verse_number": "3.12", "content_sanskrit": "इष्टापूर्त्तं मन्यमाना वरिष्ठं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900001039, "chapter_id": 8204, "verse_number": "3.13", "content_sanskrit": "तपःश्रद्धे (येऽभ्यु) ये ह्युपवसन्त्यरण्ये", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900001040, "chapter_id": 8204, "verse_number": "3.14", "content_sanskrit": "परीक्ष्य लोकान् कर्मचितान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900001041, "chapter_id": 8204, "verse_number": "3.15", "content_sanskrit": "तस्मै स विद्वानुपसन्नाय सम्यक्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]