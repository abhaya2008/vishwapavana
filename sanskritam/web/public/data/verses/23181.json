[{"id": 7003181000, "chapter_id": 23181, "verse_number": "४-११७-१", "content_sanskrit": "अथ सप्तदशाधिकशततमोऽध्यायः ।\nनारायण उवाच ।\nगणेशस्तु शिवस्थानं गत्वा नत्वा महेश्वरम् ।\nसर्व विज्ञापयामास क्रमेण च पृथक्पृथक् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003181001, "chapter_id": 23181, "verse_number": "४-११७-२", "content_sanskrit": "बाणानिरुद्धयोर्युद्धं सुभद्रनिधनं तथा ।\nस्कन्दानिरुद्धयोर्युद्धमनिरुद्धस्य विक्रमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003181002, "chapter_id": 23181, "verse_number": "४-११७-३", "content_sanskrit": "गणेशवचनं श्रुत्वा प्रहस्य भगवान्भवः ।\nउवाच श्लक्ष्णया वाचा सुगुप्तं वेदसंमतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003181003, "chapter_id": 23181, "verse_number": "४-११७-४", "content_sanskrit": "महादेव उवाच ।\nगणेश्वर महाभाग श्रूयतां वचनं मम ।\nहितं तथ्यं नीतिसारं परिणामसुखावहम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003181004, "chapter_id": 23181, "verse_number": "४-११७-५", "content_sanskrit": "असंख्यविश्वसंघं च सर्व कृष्णात्मजं सुतम् ।\nकृष्णं जानीहि यत्कार्यं कारणानां च कारणम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003181005, "chapter_id": 23181, "verse_number": "४-११७-६", "content_sanskrit": "ब्रह्मादितृणपर्यन्तं जगत्मर्व गणेश्वर ।\nनिबोध सत्यं कृष्णं च भगवन्तं सनातनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003181006, "chapter_id": 23181, "verse_number": "४-११७-७", "content_sanskrit": "गोलोके द्विभुजं शान्तं राधाकान्तं मनोहरम् ।\nशिशुरूपं गोपवेषं गोपवेषं परिपूर्णतमं प्रभुम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003181007, "chapter_id": 23181, "verse_number": "४-११७-८", "content_sanskrit": "गोपीभिर्गोपनिकरैः सहितं कामधेनुभिः ।\nपुण्ये वृन्दावने रम्ये सुन्दरे रासमण्डले ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003181008, "chapter_id": 23181, "verse_number": "४-११७-९", "content_sanskrit": "चरन्तं मुरलीहस्तं ब्रह्मेशशेषवन्दितम् ।\nशतशृङ्गै च शैलेशे वटमूले निराकुले ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003181009, "chapter_id": 23181, "verse_number": "४-११७-१०", "content_sanskrit": "गोष्ठे भाण्डीरनिकटे निर्मले विरजातटे ।\nनवीननीरदश्यामं शोभितं पीतवाससा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003181010, "chapter_id": 23181, "verse_number": "४-११७-११", "content_sanskrit": "यथा नवं घनौघं च सौदामिन्था विराजितम् ।\nआविर्भावश्च तेषां वै गोलोके रासमण्डले ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003181011, "chapter_id": 23181, "verse_number": "४-११७-१२", "content_sanskrit": "तावन्तो गोकुले रम्ये पुण्ये वृन्दावने वने ।\nसर्वे चांशकलाः पुंसःकृष्णस्तु भगवान्स्वयम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003181012, "chapter_id": 23181, "verse_number": "४-११७-१३", "content_sanskrit": "परिपूर्णतमः कामो ब्रह्मशापात्स्वविस्मृतः ।\nतस्य पुत्रोऽनिरुद्धश्च महाबलपराक्रमः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003181013, "chapter_id": 23181, "verse_number": "४-११७-१४", "content_sanskrit": "मया प्रस्थापितः स्कन्दो महायुद्धे सुदारुणे ।\nमृतो बाणश्च संग्रामे तेन स्कन्देन रक्षितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003181014, "chapter_id": 23181, "verse_number": "४-११७-१५", "content_sanskrit": "स्कन्दानिरुद्धयोर्युद्धे समत्वं तु गणेश्वर ।\nअष्टौ च भैरवाः सर्वे रुद्राश्चैकादशैव ते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003181015, "chapter_id": 23181, "verse_number": "४-११७-१६", "content_sanskrit": "अष्टौ च वसवश्चैते देवाः शक्रादयस्तथा ।\nतथैव द्वादशादित्याः सर्वे दैत्येश्वरास्तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003181016, "chapter_id": 23181, "verse_number": "४-११७-१७", "content_sanskrit": "देवानामग्रणीः स्कन्दो बाणश्च सगणस्तथा ।\nसर्वे ते चानिरुद्धं च संग्रामे जेतुमक्षमाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003181017, "chapter_id": 23181, "verse_number": "४-११७-१८", "content_sanskrit": "अनिरुद्धः स्वयं ब्रह्मा प्रद्युम्नः काम एव च ।\nबलदेवः स्वयं शेषः कृष्णश्च प्रकृतेः परः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003181018, "chapter_id": 23181, "verse_number": "४-११७-१९", "content_sanskrit": "एतत्ते कथितं सर्वं बाणं रक्ष गणेश्वर ।\nभवाञ्शुभस्वरूपश्च विघ्नखण्डनकारकः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003181019, "chapter_id": 23181, "verse_number": "४-११७-२०", "content_sanskrit": "आरादायास्यति हरिर्गृहीत्वा च सुदर्शनम् ।\nअव्यर्थमस्त्रप्रवरं सूर्यकोटिसमप्रभम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]