[{"id": 6000288000, "chapter_id": 10288, "verse_number": null, "content_sanskrit": "अथ द्विनवतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000288001, "chapter_id": 10288, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.001.m4a", "display_order": 2}, {"id": 6000288002, "chapter_id": 10288, "verse_number": "१०-९२-१", "content_sanskrit": "दुर्योधनसुतां राजन् लक्षणां समितिञ्जयः।\nस्वयंवरस्थामहरत् साम्बो जाम्बवतीसुतः॥ १०/९२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.002.m4a", "display_order": 3, "topics": [{"text": "साम्बेन स्वयंवरस्थाया लक्षणाया हरणम् , कुरूणां तन्निग्रहः", "range": "१–१४"}]}, {"id": 6000288003, "chapter_id": 10288, "verse_number": "१०-९२-२", "content_sanskrit": "कुरवः कुपिता ऊचुर्दुर्विनीतोऽयमर्भकः।\nकदर्थीकृत्य नः कन्यामकामामहरद् बलात्॥ १०/९२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.003.m4a", "display_order": 4}, {"id": 6000288004, "chapter_id": 10288, "verse_number": "१०-९२-३", "content_sanskrit": "बध्नीतैनं दुर्विनीतं किं करिष्यन्ति वृष्णयः।\nयेऽस्मत्प्रसादोपचितां दत्तां नो भुञ्जते महीम्॥ १०/९२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.004.m4a", "display_order": 5}, {"id": 6000288005, "chapter_id": 10288, "verse_number": "१०-९२-४", "content_sanskrit": "निगृहीतं सुतं श्रुत्वा यद्येष्यन्तीह वृष्णयः।\nभग्नदर्पाः शमं यान्ति शीर्णदन्ता इवाहयः॥ १०/९२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.005.m4a", "display_order": 6}, {"id": 6000288006, "chapter_id": 10288, "verse_number": "१०-९२-५", "content_sanskrit": "इति कर्णं समालोक्य भूरिश्रवसुयोधनौ।\nसदुःशासनगान्धारौ दुर्मन्त्रैकान्तशीलिनौ॥ १०/९२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.006.m4a", "display_order": 7}, {"id": 6000288007, "chapter_id": 10288, "verse_number": "१०-९२-६", "content_sanskrit": "एतेऽतिक्रम्य विदुरं गान्धारीं च यशस्विनीम्।\nसाम्बमारेभिरे बद्धुं कुरुवृद्धैरसङ्गताः॥ १०/९२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.007.m4a", "display_order": 8}, {"id": 6000288008, "chapter_id": 10288, "verse_number": "१०-९२-७", "content_sanskrit": "दृष्ट्वाऽनुधावतः साम्बो धार्तराष्ट्रान् महारथः।\nप्रगृह्य रुचिरं चापं तस्थौ सिंह इवैकलः॥ १०/९२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.008.m4a", "display_order": 9}, {"id": 6000288009, "chapter_id": 10288, "verse_number": "१०-९२-८", "content_sanskrit": "ते तं जिघृक्षवः क्रुद्धं तिष्ठ तिष्ठेति वादिनः।\nआसाद्य धन्विनो बाणैः कर्णमुख्याः समाकिरन्॥ १०/९२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.009.m4a", "display_order": 10}, {"id": 6000288010, "chapter_id": 10288, "verse_number": "१०-९२-९", "content_sanskrit": "सोऽतिबद्धः कुरुश्रेष्ठ कुरुभिर्यदुनन्दनः।\nनामृष्यत् तत्परिभवं दण्डाहत इवोरगः॥ १०/९२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.010.m4a", "display_order": 11}, {"id": 6000288011, "chapter_id": 10288, "verse_number": "१०-९२-१०", "content_sanskrit": "विष्फार्य सुमहच्चापं सर्वान् विव्याध सायकैः।\nकर्णादीन् सहयाग्रण्यांस्तावद्भिर्युगपत् पृथक्॥ १०/९२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.011.m4a", "display_order": 12}, {"id": 6000288012, "chapter_id": 10288, "verse_number": "१०-९२-११", "content_sanskrit": "चतुर्भिश्चतुरो वाहानेकैकेन च सारथीन्।\nरथिनश्च महेष्वासास्तस्य तत् तेऽभ्यपूजयन्॥ १०/९२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.012.m4a", "display_order": 13}, {"id": 6000288013, "chapter_id": 10288, "verse_number": "१०-९२-१२", "content_sanskrit": "तं तु ते विरथं चक्रुश्चत्वारश्चतुरो हयान्।\nएकस्तु सारथिं जघ्ने चिच्छेदान्यः शरासनम्॥ १०/९२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.013.m4a", "display_order": 14}, {"id": 6000288014, "chapter_id": 10288, "verse_number": "१०-९२-१३", "content_sanskrit": "ते तथा विरथं कृत्वा कृच्छ्रेण कुरवो युधि।\nकुमारं गृह्य कन्यां च स्वपुरं जयिनोऽविशन्॥ १०/९२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.014.m4a", "display_order": 15}, {"id": 6000288015, "chapter_id": 10288, "verse_number": "१०-९२-१४", "content_sanskrit": "तच्छ्रुत्वा नारदोक्तेन राजन् सञ्जातमन्यवः।\nकुरून् प्रत्युद्यमं चक्रुरुग्रसेनप्रचोदिताः॥ १०/९२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.015.m4a", "display_order": 16}, {"id": 6000288016, "chapter_id": 10288, "verse_number": "१०-९२-१५", "content_sanskrit": "सान्त्वयित्वा तु तान् रामः सङ्क्रुद्धान् वृष्णिपुङ्गवान्।\nनैच्छत् कुरूणां वृष्णीनां कलिं कलहशङ्कितः॥ १०/९२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.016.m4a", "display_order": 17, "topics": [{"text": "बलरामस्य हितोक्तिः, कौरवाणां दुर्वचनम्", "range": "१५–२९"}]}, {"id": 6000288017, "chapter_id": 10288, "verse_number": "१०-९२-१६", "content_sanskrit": "जगाम हास्तिनपुरं रथेनादित्यवर्चसा।\nब्राह्मणैः कुलवृद्धैश्च वृतश्चन्द्र इव ग्रहैः॥ १०/९२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.017.m4a", "display_order": 18}, {"id": 6000288018, "chapter_id": 10288, "verse_number": "१०-९२-१७", "content_sanskrit": "गत्वा गजाह्वयं रामो बाह्योपवनमाश्रितः।\nउद्धवं प्रेषयामास धृतराष्ट्राय शान्तये॥ १०/९२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.018.m4a", "display_order": 19}, {"id": 6000288019, "chapter_id": 10288, "verse_number": "१०-९२-१८", "content_sanskrit": "सोऽभिवन्द्याम्बिकापुत्रं भीष्मं द्रोणं च बाह्लिकम्।\nदुर्योधनं च विधिवदब्रवीद् राममागतम्॥ १०/९२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.019.m4a", "display_order": 20}, {"id": 6000288020, "chapter_id": 10288, "verse_number": "१०-९२-१९", "content_sanskrit": "तेऽतिप्रीताः समाकर्ण्य प्राप्तं रामं सुहृत्तमम्।\nतमर्चयित्वाऽभिययुः सर्वे मङ्गलपाणयः॥ १०/९२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.020.m4a", "display_order": 21}, {"id": 6000288021, "chapter_id": 10288, "verse_number": "१०-९२-२०", "content_sanskrit": "तं सङ्गम्य यथान्यायं गामर्घ्यं च न्यवेदयन्।\nतेषां ये तत्प्रभावज्ञाः प्रणेमुः शिरसा बलम्॥ १०/९२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.021.m4a", "display_order": 22}, {"id": 6000288022, "chapter_id": 10288, "verse_number": "१०-९२-२१", "content_sanskrit": "बन्धून् कुशलिनः श्रुत्वा पृष्ट्वा शिवमनामयम्।\nपरस्परमथो रामो बभाषेऽविक्लवं वचः॥ १०/९२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.022.m4a", "display_order": 23}, {"id": 6000288023, "chapter_id": 10288, "verse_number": "१०-९२-२२", "content_sanskrit": "उग्रसेनः क्षितीशेशो यद् व आज्ञापयत् प्रभुः।\nतदव्यग्रधियः श्रुत्वा कुरुध्वं मा विलम्बितम्॥ १०/९२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.023.m4a", "display_order": 24}, {"id": 6000288024, "chapter_id": 10288, "verse_number": "१०-९२-२३", "content_sanskrit": "यद् यूयं बहवस्त्वेकं जित्वाऽधर्मेण धार्मिकम्।\nअबध्नीताथ तन्मृष्येबन्धूनामिष्टकाम्यया॥ १०/९२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.024.m4a", "display_order": 25}, {"id": 6000288025, "chapter_id": 10288, "verse_number": "१०-९२-२४", "content_sanskrit": "वीर्यशौर्यबलोन्नद्धमात्मशक्तिसमं वचः।\nकुरवो बलदेवस्य निशम्योचुः प्रकोपिताः॥ १०/९२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.025.m4a", "display_order": 26}, {"id": 6000288026, "chapter_id": 10288, "verse_number": "१०-९२-२५", "content_sanskrit": "अहो महच्चित्रमिदं कालगत्या दुरत्ययम्।\nआरुरुक्षत्युपानद् वै शिरो मुकुटसेवितम्॥ १०/९२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.026.m4a", "display_order": 27}, {"id": 6000288027, "chapter_id": 10288, "verse_number": "१०-९२-२६", "content_sanskrit": "एते यौनेयसम्बन्धाः सहशय्यासनाशनाः।\nवृष्णयस्तुल्यतां नीता अस्मद्दत्तनृपासनाः॥ १०/९२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.027.m4a", "display_order": 28}, {"id": 6000288028, "chapter_id": 10288, "verse_number": "१०-९२-२७", "content_sanskrit": "चामरव्यजने शङ्खमातपत्रं च पाण्डुरम्।\nकिरीटमासनं मह्यं भुञ्जन्त्यस्मदुपेक्षया॥ १०/९२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.028.m4a", "display_order": 29}, {"id": 6000288029, "chapter_id": 10288, "verse_number": "१०-९२-२८", "content_sanskrit": "अलं यदूनां नरदेवलाञ्छनैर्दातृप्रतीपैः फणिनामिवामृतैः।\nयेऽस्मत्प्रसादोपचिता हि यादवा आज्ञापयन्त्यद्य गतत्रपा बत॥ १०/९२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.029.m4a", "display_order": 30}, {"id": 6000288030, "chapter_id": 10288, "verse_number": "१०-९२-२९", "content_sanskrit": "कथमिन्द्रोऽपि कुरुभिर्भीष्मद्रोणार्जुनादिभिः।\nअदत्तमवरुन्धीत सिंहग्रस्त इवोरणः॥ १०/९२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.030.m4a", "display_order": 31}, {"id": 6000288031, "chapter_id": 10288, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.031.m4a", "display_order": 32}, {"id": 6000288032, "chapter_id": 10288, "verse_number": "१०-९२-३०", "content_sanskrit": "जन्मबन्धुश्रियोन्नद्धमदास्ते भरतर्षभ।\nआश्राव्य रामं दुर्वाक्यैरटव्यां पुरमाविशन्॥ १०/९२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.032.m4a", "display_order": 33, "topics": [{"text": "कोपेन बलेन हस्तिनपुरस्य कर्षणे कौरवशरणागतिः, बलरामस्य द्वारकागमनं च", "range": "२९–५५"}]}, {"id": 6000288033, "chapter_id": 10288, "verse_number": "१०-९२-३१", "content_sanskrit": "दृष्ट्वा कुरूणां दौःशील्यं श्रुत्वा वाच्यातिवाच्यताम्।\nअवोचत्कोपसंरब्धो दुष्प्रेक्ष्यः प्रहसन्मुहुः॥ १०/९२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.033.m4a", "display_order": 34}, {"id": 6000288034, "chapter_id": 10288, "verse_number": "१०-९२-३२", "content_sanskrit": "नूनं नाम मदोन्नद्धाः शान्तिं नेच्छन्त्यसाधवः।\nतेषां हि प्रशमो दण्डः पशूनां लगुटो यथा॥ १०/९२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.034.m4a", "display_order": 35}, {"id": 6000288035, "chapter_id": 10288, "verse_number": "१०-९२-३३", "content_sanskrit": "अहो यदून् सुसंरब्धान् कृष्णं च कुपितं शनैः।\nसान्त्वयित्वाऽहमेतेषां शममिच्छन्निहागतः॥ १०/९२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.035.m4a", "display_order": 36}, {"id": 6000288036, "chapter_id": 10288, "verse_number": "१०-९२-३४", "content_sanskrit": "त इमे मन्दमतयः कलहातिरताः खलाः।\nतस्मात् तं मामवज्ञाय दुर्भाषां मानिनोऽब्रुवन्॥ १०/९२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.036.m4a", "display_order": 37}, {"id": 6000288037, "chapter_id": 10288, "verse_number": "१०-९२-३५", "content_sanskrit": "नोग्रसेनः किल विभुर्भोजवृष्ण्यन्धकेश्वरः।\nशक्रादयो लोकपाला यस्यादेशानुवर्तिनः॥ १०/९२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.037.m4a", "display_order": 38}, {"id": 6000288038, "chapter_id": 10288, "verse_number": "१०-९२-३६", "content_sanskrit": "सुधर्माऽऽक्रम्यते येन पारिजातोऽमराङ्घ्रिपः।\nआनीय भुज्यते सोऽसौ न किलाध्यासनार्हकः॥ १०/९२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.038.m4a", "display_order": 39}, {"id": 6000288039, "chapter_id": 10288, "verse_number": "१०-९२-३७", "content_sanskrit": "यस्य पादयुगं साक्षाच्छ्रीरुपास्तेऽखिलेश्वरी।\nस नार्हति किल श्रीशो नरदेवपरिच्छदान्॥ १०/९२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.039.m4a", "display_order": 40}, {"id": 6000288040, "chapter_id": 10288, "verse_number": "१०-९२-३८", "content_sanskrit": "यस्याङ्घ्रिपङ्कजरजोऽखिललोकपालमौल्युत्तमैर्धृतमुपासिततीर्थतीर्थम्।\nब्रह्मा भवोऽहमपि यस्य कलाकलांशाः श्रद्धामहे सुचिरमस्य नृपासनं क्‍व॥ १०/९२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.040.m4a", "display_order": 41}, {"id": 6000288041, "chapter_id": 10288, "verse_number": "१०-९२-३९", "content_sanskrit": "भुज्यते कुरुभिर्दत्तं भूखण्डं वृष्णिभिः किल।\nउपानहः किल वयं स्वयं तु कुरवः शिरः॥ १०/९२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.041.m4a", "display_order": 42}, {"id": 6000288042, "chapter_id": 10288, "verse_number": "१०-९२-४०", "content_sanskrit": "अहो ऐश्वर्यमत्तानां मत्तानामिव मानिनाम्।\nअसम्बद्धा गिरो रूक्षाः कः सहेतानुशासिता॥ १०/९२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.042.m4a", "display_order": 43}, {"id": 6000288043, "chapter_id": 10288, "verse_number": "१०-९२-४१", "content_sanskrit": "अद्य निष्कौरवां पृथ्वीं करिष्यामीत्यमर्षितः।\nगृहीत्वा हलमुत्तस्थौ दहन्निव जगत्त्रयम्॥ १०/९२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.043.m4a", "display_order": 44}, {"id": 6000288044, "chapter_id": 10288, "verse_number": "१०-९२-४२", "content_sanskrit": "लाङ्गलाग्रेण नगरमुद्विदार्य गजाह्वयम्।\nविचकर्ष स गङ्गायां प्रहरिष्यन्नमर्षितः॥ १०/९२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.044.m4a", "display_order": 45}, {"id": 6000288045, "chapter_id": 10288, "verse_number": "१०-९२-४३", "content_sanskrit": "जलयानमिवाघूर्णं गङ्गायां नगरं पतत्।\nआकृष्यमाणमालोक्य कौरवा जातसम्भ्रमाः॥ १०/९२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.045.m4a", "display_order": 46}, {"id": 6000288046, "chapter_id": 10288, "verse_number": "१०-९२-४४", "content_sanskrit": "तमेव शरणं जग्मुः सकुटुम्बा जिजीषवः।\nसलक्षणं पुरस्कृत्य साम्बं प्राञ्जलयोऽब्रुवन्॥ १०/९२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.046.m4a", "display_order": 47}, {"id": 6000288047, "chapter_id": 10288, "verse_number": "१०-९२-४५", "content_sanskrit": "रामरामाखिलाधार प्रभावं न विदाम ते।\nमूढानां नः कुटुम्बीनां क्षन्तुमर्हस्यधीश्वर॥ १०/९२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.047.m4a", "display_order": 48}, {"id": 6000288048, "chapter_id": 10288, "verse_number": "१०-९२-४६", "content_sanskrit": "स्थित्युत्पत्तिलयानां त्वमेको हेतुर्निराश्रयः।\nलोकान् क्रीडनकानीश बहवस्ते वदन्ति हि॥ १०/९२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.048.m4a", "display_order": 49}, {"id": 6000288049, "chapter_id": 10288, "verse_number": "१०-९२-४७", "content_sanskrit": "त्वमेव मूर्ध्नीदमनन्त लीलया भूमण्डलं बिभर्षि सहस्रमूर्धन्।\nअन्ते च यः स्वात्मनि रुद्धविश्वः शेषेऽद्वितीयः परिशिष्यमाणः॥ १०/९२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.049.m4a", "display_order": 50}, {"id": 6000288050, "chapter_id": 10288, "verse_number": "१०-९२-४८", "content_sanskrit": "कोपस्तेऽखिलशिक्षार्थं न द्वेषान्न च मत्सरात्।\nबिभ्रतो भगवान् स त्वं स्थितिपालनतत्परः॥ १०/९२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.050.m4a", "display_order": 51}, {"id": 6000288051, "chapter_id": 10288, "verse_number": "१०-९२-४९", "content_sanskrit": "नमस्ते सर्वभूतात्मन् सर्वशक्तिधराव्यय।\nविश्वकर्मन् नमस्तेऽस्तु त्वां वयं शरणं गताः॥ १०/९२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.051.m4a", "display_order": 52}, {"id": 6000288052, "chapter_id": 10288, "verse_number": "१०-९२-५०", "content_sanskrit": "एवं प्रपन्नैः संविग्नैर्वेपमानायनैर्बलः।\nप्रसादितः सम्प्रसन्नो मा भैष्टेत्यभयं ददौ॥ १०/९२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.052.m4a", "display_order": 53}, {"id": 6000288053, "chapter_id": 10288, "verse_number": "१०-९२-५३", "content_sanskrit": "प्रतिगृह्य तु तत्सर्वं भगवान् सात्वतर्षभः।\nससुतः सस्नुषः प्रायात् सुहृद्भिरभिवन्दितः॥ १०/९२/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.053.m4a", "display_order": 54}, {"id": 6000288054, "chapter_id": 10288, "verse_number": "१०-९२-५४", "content_sanskrit": "ततः प्रविष्टः स्वपुरीं हलायुधः समेत्य बन्धूननुरक्तचेतसः।\nशशंस सर्वं यदुपुङ्गवानां मध्ये सभायां कुरुषु स्वचेष्टितम्॥ १०/९२/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.054.m4a", "display_order": 55}, {"id": 6000288055, "chapter_id": 10288, "verse_number": "१०-९२-५५", "content_sanskrit": "अद्यापि वः पुरं ह्येतत् सूचयद् रामविक्रमम्।\nसमुन्नतं दक्षिणतो गङ्गायां ननु दृश्यते॥ १०/९२/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_092/BhP_10.092.055.m4a", "display_order": 56}, {"id": 6000288056, "chapter_id": 10288, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे द्विनवतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]