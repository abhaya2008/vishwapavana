[{"id": 7001198000, "chapter_id": 21198, "verse_number": "२-३-४६-१", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nअथ शंभुः प्रसन्नात्मा सदूतं स्वगणैस्सुरैः ।\nसर्वैरन्यैर्गिरेर्द्धाम जगाम सकुतूहलम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001198001, "chapter_id": 21198, "verse_number": "२-३-४६-२", "content_sanskrit": "मेनापि स्त्रीगणैस्तैश्च हिमाचलवरप्रिया ।\nतत उत्थाय स्वगृहा भ्यंतरं सा जगाम ह॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001198002, "chapter_id": 21198, "verse_number": "२-३-४६-३", "content_sanskrit": "नीराजनार्थं शम्भोश्च दीपपात्रकरा सती ।\nसर्वर्षिस्त्रीगणैस्साकमगच्छद्द्वारमादरात्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001198003, "chapter_id": 21198, "verse_number": "२-३-४६-४", "content_sanskrit": "तत्रागतं महेशानं शंकरं गिरिजावरम् ।\nददर्श प्रीतितो मेना सेवितं सकलैस्सुरैः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001198004, "chapter_id": 21198, "verse_number": "२-३-४६-५", "content_sanskrit": "चारुचंपकवर्णाभं ह्येकवक्त्रं त्रिलोचनम् ।\nईषद्धास्यप्रसन्नास्यं रत्नस्वर्णादिभूषितम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001198005, "chapter_id": 21198, "verse_number": "२-३-४६-६", "content_sanskrit": "मालतीमालया युक्तं सद्रत्नमुकुटोज्ज्वलम् ।\nसत्कंठाभरणं चारुवलयांगदभूषितम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001198006, "chapter_id": 21198, "verse_number": "२-३-४६-७", "content_sanskrit": "वह्निशौचेनातुलेन त्वतिसूक्ष्मेण चारुणा ।\nअमूल्यवस्त्रयुग्मेन विचित्रेणातिराजितम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001198007, "chapter_id": 21198, "verse_number": "२-३-४६-८", "content_sanskrit": "चन्दनागरुकस्तूरीचारुकुंकुम भूषितम् ।\nरत्नदर्पणहस्तं च कज्जलोज्ज्वललोचनम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001198008, "chapter_id": 21198, "verse_number": "२-३-४६-९", "content_sanskrit": "सर्वस्वप्रभयाच्छन्नमतीवसुमनोहरम् ।\nअतीव तरुणं रम्यं भूषितांगैश्च भूषितम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001198009, "chapter_id": 21198, "verse_number": "२-३-४६-१०", "content_sanskrit": "कामिनीकांतमव्यग्रं कोटिचन्द्राननांबुजम् ।\nकोटिस्मराधिकतनुच्छविं सर्वांगसुंदरम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001198010, "chapter_id": 21198, "verse_number": "२-३-४६-११", "content_sanskrit": "ईदृग्विधं सुदेवं तं स्थितं स्वपुरतः प्रभुम् ।\nदृष्ट्वा जामातरं मेना जहौ शोकम्मुदाऽन्विता॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001198011, "chapter_id": 21198, "verse_number": "२-३-४६-१२", "content_sanskrit": "प्रशशंस स्वभाग्यं सा गिरिजां भूधरं कुलम् ।\nमेने कृतार्थमात्मानं जहर्ष च पुनः पुनः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001198012, "chapter_id": 21198, "verse_number": "२-३-४६-१३", "content_sanskrit": "नीराजनं चकारासौ प्रफुल्लवदना सती ।\nअवलोकपरा तत्र मेना जामातरं मुदा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001198013, "chapter_id": 21198, "verse_number": "२-३-४६-१४", "content_sanskrit": "गिरिजोक्तमनुस्मृत्य मेना विस्मयमागता ।\nमनसैव ह्युवाचेदं हर्षफुल्लाननाम्बुजा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001198014, "chapter_id": 21198, "verse_number": "२-३-४६-१५", "content_sanskrit": "यद्वै पुरोक्तं च तया पार्वत्या मम तत्र च ।\nततोधिकं प्रपश्यामि सौन्दर्य्यं परमेशितुः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001198015, "chapter_id": 21198, "verse_number": "२-३-४६-१६", "content_sanskrit": "महेशस्य सुलावण्यमनिर्वाच्यं च संप्रति ।\nएवं विस्मयमापन्ना मेना स्वगृहमाययौ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001198016, "chapter_id": 21198, "verse_number": "२-३-४६-१७", "content_sanskrit": "प्रशशंसुर्युवतयो धन्या धन्या गिरेः सुता ।\nदुर्गा भगवतीत्येवमूचुः काश्चन कन्यकाः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001198017, "chapter_id": 21198, "verse_number": "२-३-४६-१८", "content_sanskrit": "न दृष्टो वर इत्येवमस्माभिर्द्दानगोचरः ।\nधन्या हि गिरिजा देवीमूचुः काश्चन कन्यकाः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001198018, "chapter_id": 21198, "verse_number": "२-३-४६-१९", "content_sanskrit": "जगुर्गन्धर्व्वप्रवरा ननृतुश्चाप्सरोगणाः ।\nदृष्ट्वा शंकररूपं च प्रहृष्टास्सर्वदेवताः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001198019, "chapter_id": 21198, "verse_number": "२-३-४६-२०", "content_sanskrit": "नानाप्रकारवाद्यानि वादका मधुराक्षरम् ।\nनानाप्रकारशिल्पेन वादयामासुरादरात्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001198020, "chapter_id": 21198, "verse_number": "२-३-४६-२१", "content_sanskrit": "हिमाचलोऽपि मुदितो द्वाराचारमथाकरोत् ।\nमेनापि सर्वनारीभिर्महोत्सवपुरस्सरम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001198021, "chapter_id": 21198, "verse_number": "२-३-४६-२२", "content_sanskrit": "परपुच्छां चकारासौ मुदिता स्वगृहं ययौ ।\nशिवो निवेदितं स्थानं जगाम गणनिर्जरैः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001198022, "chapter_id": 21198, "verse_number": "२-३-४६-२३", "content_sanskrit": "एतस्मिन्नन्तरे दुर्गां शैलान्तःपुरचारिका ।\nबहिर्जग्मुस्समादाय पूजितुं कुलदेवताम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001198023, "chapter_id": 21198, "verse_number": "२-३-४६-२४", "content_sanskrit": "तत्र तां ददृशुर्देवा निमेषरहिता मुदा ।\nसुनीलांजनवर्णाभां स्वांगैश्च प्रतिभूषिताम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001198024, "chapter_id": 21198, "verse_number": "२-३-४६-२५", "content_sanskrit": "त्रिनेत्रादृतनेत्रांतामन्यवारितलोचनाम् ।\nईषद्धास्यप्रसन्नास्यां सकटाक्षां मनोहराम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001198025, "chapter_id": 21198, "verse_number": "२-३-४६-२६", "content_sanskrit": "सुचारुकबरीभारां चारुपत्रक शोभिताम् ।\nकस्तूरीबिन्दुभिस्सार्द्धं सिन्दूरबिन्दुशोभिताम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001198026, "chapter_id": 21198, "verse_number": "२-३-४६-२७", "content_sanskrit": "रत्नेन्द्रसारहारेण वक्षसा सुविराजिताम् ।\nरत्नकेयूरवलयां रत्नकङ्कणमंडिताम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001198027, "chapter_id": 21198, "verse_number": "२-३-४६-२८", "content_sanskrit": "सद्रत्नकुण्डलाभ्यां च चारुगण्डस्थलोज्ज्वलाम् ।\nमणिरत्नप्रभामुष्टिदन्तराजिविराजिताम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001198028, "chapter_id": 21198, "verse_number": "२-३-४६-२९", "content_sanskrit": "मधुबिम्बाधरोष्ठां च रत्नयावकसंयुताम् ।\nरत्नदर्प्पणहस्तां च क्रीडापद्मविभूषिताम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001198029, "chapter_id": 21198, "verse_number": "२-३-४६-३०", "content_sanskrit": "चन्दनागुरुकस्तूरीकुंकुमेनाति च र्चिताम् ।\nक्वणन्मंजीरपादां च रक्तांघ्रितलराजिताम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001198030, "chapter_id": 21198, "verse_number": "२-३-४६-३१", "content_sanskrit": "प्रणेमुश्शिरसा देवीं भक्तियुक्ताः समेनकाम् ।\nसर्वे सुरादयो दृष्ट्वा जगदाद्यां जगत्प्रसूम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001198031, "chapter_id": 21198, "verse_number": "२-३-४६-३२", "content_sanskrit": "त्रिनेत्रो नेत्रकोणेन तां ददर्श मुदान्वितः ।\nशिवः सत्याकृतिं दृष्ट्वा विजहौ विरहज्वरम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001198032, "chapter_id": 21198, "verse_number": "२-३-४६-३३", "content_sanskrit": "शिवस्सर्वं विसस्मार शिवासंन्यस्तलोचनः ।\nपुलकांचितसर्वाङ्गो हर्षाद्गौरीविलोचनः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001198033, "chapter_id": 21198, "verse_number": "२-३-४६-३४", "content_sanskrit": "अथ कालीबहिः पुर्य्यां गत्वा पूज्य कुलाम्बिकाम् ।\nविवेश भवनं रम्यं स्वपितुस्सद्विजाङ्गना॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001198034, "chapter_id": 21198, "verse_number": "२-३-४६-३५", "content_sanskrit": "शङ्करोपि सुरैस्सार्द्धं हरिणा ब्राह्मणा तथा ।\nहिमाचलसमुद्दिष्टं स्वस्थानमगमन्मुदा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001198035, "chapter_id": 21198, "verse_number": "२-३-४६-३६", "content_sanskrit": "तत्र सर्वे सुखं तस्थुस्सेवन्तश्शङ्करं यथा ।\nसम्मानिता गिरीशेन नानाविधसुसम्पदा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]