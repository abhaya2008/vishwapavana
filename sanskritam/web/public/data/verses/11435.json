[{"id": 50010120, "chapter_id": 11435, "verse_number": "1", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50010121, "chapter_id": 11435, "verse_number": "2", "content_sanskrit": "भृग्वादयस्ते मुनयो लोकानां क्षेमदर्शिनः। गोप्तर्यसति वै नॄणां पश्यन्तः पशुसाम्यताम्॥ ४/१४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50010122, "chapter_id": 11435, "verse_number": "3", "content_sanskrit": "वीर मातरमाहूय सुनीथां ब्रह्मवादिनः। प्रकृत्याऽसम्मतं वेनमभ्यषिञ्चन् पतिं भुवः॥ ४/१४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50010123, "chapter_id": 11435, "verse_number": "4", "content_sanskrit": "श्रुत्वा नृपासनगतं वेनमत्युग्रशासनम्। निलिल्युर्दस्यवः सद्यः सर्पत्रस्ता इवाखवः॥ ४/१४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50010124, "chapter_id": 11435, "verse_number": "5", "content_sanskrit": "स आरूढनृपस्थान उन्नद्धोऽष्टविभूतिभिः। अवमेने महाभागान् स्तब्धः सम्भावितः स्वयम्॥ ४/१४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50010125, "chapter_id": 11435, "verse_number": "6", "content_sanskrit": "एवं मदान्ध उत्सिक्तो निरङ्कुश इव द्विपः। पर्यटन् रथमास्थाय कम्पयन्निव रोदसी॥ ४/१४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50010126, "chapter_id": 11435, "verse_number": "7", "content_sanskrit": "न यष्टव्यं न दातव्यं न होतव्यं द्विजाः क्वचित्। इति न्यवारयद् धर्मं भेरीघोषेण सर्वतः॥ ४/१४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50010127, "chapter_id": 11435, "verse_number": "8", "content_sanskrit": "वेनस्यावेक्ष्य मुनयो दुर्वृत्तस्य विचेष्टितम्। विमृश्य लोकव्यसनं कृपयोचुः स्म सत्रिणः॥ ४/१४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50010128, "chapter_id": 11435, "verse_number": "9", "content_sanskrit": "अहो उभयतः प्राप्तं लोकस्य व्यसनं महत्। दारुण्युभयतो दीप्त इव तस्करपालयोः॥ ४/१४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50010129, "chapter_id": 11435, "verse_number": "10", "content_sanskrit": "अराजकभयादेष कृतो राजाऽतदर्हणः। ततोऽप्यासीद् भयं त्वद्य कथं स्यात् स्वस्ति देहिनाम्॥ ४/१४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50010130, "chapter_id": 11435, "verse_number": "11", "content_sanskrit": "अहेरिव पयःपोषः पोषकस्याप्यनर्थकृत्॥ ४/१४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50010131, "chapter_id": 11435, "verse_number": "12", "content_sanskrit": "वेनः प्रकृत्यैव खलः सुनीथागर्भसम्भवः। निरूपितः प्रजापालः स जिघांसति वै प्रजाः॥ ४/१४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50010132, "chapter_id": 11435, "verse_number": "13", "content_sanskrit": "तथाऽपि सान्त्वयामैनं माऽस्मांस्तत्पातकं स्पृशेत्। तद्विद्वद्भिरसद्वृत्तो वेनोऽस्माभिः कृतो नृपः॥ ४/१४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50010133, "chapter_id": 11435, "verse_number": "14", "content_sanskrit": "सान्त्वितो यदि नो वाचं न ग्रहीष्यत्यधर्मकृत्। लोकधिक्कारसन्दग्धं दहिष्यामः स्वतेजसा॥ ४/१४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50010134, "chapter_id": 11435, "verse_number": "15", "content_sanskrit": "एवमध्यवसायैनं मुनयो गूढमन्यवः। उपव्रज्याब्रुवन् वेनं सान्त्वयित्वाऽथ सामभिः॥ ४/१४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50010135, "chapter_id": 11435, "verse_number": "16", "content_sanskrit": "नृपवर्य निबोधेदं यद्धि विज्ञापयाम भोः। आयुःश्रीबलकार्तीनां तव तात विवर्धनम्॥ ४/१४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50010136, "chapter_id": 11435, "verse_number": "17", "content_sanskrit": "धर्म आचरितः पुंसां वाङ्मनःकायबुद्धिभिः। लोकान् विशोकान् वितरत्यप्यानन्त्यमसङ्गिनाम्॥ ४/१४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50010137, "chapter_id": 11435, "verse_number": "18", "content_sanskrit": "स ते मा विनशेद् वीर प्रजानां क्षेमलक्षणः। यस्मिन् विनष्टे नृपतिरैश्वर्यादवरोहति॥ ४/१४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50010138, "chapter_id": 11435, "verse_number": "19", "content_sanskrit": "राजन्नसाध्वमात्येभ्यश्चोरादिभ्यः प्रजा नृपः। रक्षन् यथा बलिं गृह्णन्निह प्रेत्य च मोदते॥ ४/१४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50010139, "chapter_id": 11435, "verse_number": "20", "content_sanskrit": "यस्य राष्ट्रे पुरे चैव भगवान् यज्ञपूरुषः। इज्यते स्वेन धर्मेण जनैर्वर्णाश्रमात्मकैः॥ ४/१४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50010140, "chapter_id": 11435, "verse_number": "21", "content_sanskrit": "तस्य राज्ञो महाराज भगवान् भूतभावनः। परितुष्यति विश्वात्मा तिष्ठतो निजशासने॥ ४/१४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50010141, "chapter_id": 11435, "verse_number": "22", "content_sanskrit": "तस्मिंस्तुष्टे किमप्राप्यं जगतामीश्वरेश्वरे। लोकाः सपाला ह्येतस्मै हरन्ति बलिमादृताः॥ ४/१४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50010142, "chapter_id": 11435, "verse_number": "23", "content_sanskrit": "तं सर्वलोकामरयज्ञसङ्ग्रहं त्रयीमयं द्रव्यमयं तपोमयम्। यज्ञैर्विचित्रैर्यजतो भवाय ते राजन् स्वदेशाननुरोद्धुमर्हसि॥ ४/१४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50010143, "chapter_id": 11435, "verse_number": "24", "content_sanskrit": "यज्ञेन युष्मद्विषये द्विजातिभि- र्वितायमानेन सुराः कला हरेः। स्विष्टाः सुतुष्टाः प्रदिशन्ति वाञ्छितं तद्धेळनं नार्हसि वीर चेष्टितुम्॥ ४/१४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50010144, "chapter_id": 11435, "verse_number": "25", "content_sanskrit": "वेन उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50010145, "chapter_id": 11435, "verse_number": "26", "content_sanskrit": "बालिशा बत यूयं वा अधर्मे धर्ममानिनः। ये वृत्तिदं पतिं हित्वा जारं पतिमुपासते॥ ४/१४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50010146, "chapter_id": 11435, "verse_number": "27", "content_sanskrit": "अवजानन्ति ये मूढा नृपरूपिणमीश्वरम्। नानुविन्दन्ति ते भद्रमिह लोके परत्र च॥ ४/१४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50010147, "chapter_id": 11435, "verse_number": "28", "content_sanskrit": "को यज्ञपुरुषो नाम यत्र वो भक्तिरीदृशी। भर्तृस्नेहविदूराणां यथा जारे कुयोषिताम्॥ ४/१४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50010148, "chapter_id": 11435, "verse_number": "29", "content_sanskrit": "विष्णुर्विरिञ्चो गिरिश इन्द्रो वायुर्यमो रविः। पर्जन्यो धनदः सोमः क्षितिरग्निरपां पतिः॥ ४/१४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50010149, "chapter_id": 11435, "verse_number": "30", "content_sanskrit": "एते चान्ये च विबुधाः प्रभवो वरशापयोः। देहे भवन्ति नृपतेः सर्वदेवमयो नृपः॥ ४/१४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50010150, "chapter_id": 11435, "verse_number": "31", "content_sanskrit": "तस्मान्मां कर्मभिर्विप्रा यजध्वं गतमत्सराः। बलिं च मह्यं हरत मत्तोऽन्यः कोऽग्रभुक् पुमान्॥ ४/१४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50010151, "chapter_id": 11435, "verse_number": "32", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50010152, "chapter_id": 11435, "verse_number": "33", "content_sanskrit": "इत्थं विपर्ययमतिः पापीयानुत्पथं गतः। अनुनीयमानस्तद्याञ्चां न चक्रे भ्रष्टमङ्गलः॥ ४/१४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50010153, "chapter_id": 11435, "verse_number": "34", "content_sanskrit": "इति तेऽसत्कृतास्तेन द्विजाः पण्डितमानिना। भग्नायां हव्ययाञ्चायां तस्मै विदुर चुक्रुधुः॥ ४/१४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50010154, "chapter_id": 11435, "verse_number": "35", "content_sanskrit": "ऋषय ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50010155, "chapter_id": 11435, "verse_number": "36", "content_sanskrit": "हन्यतां हन्यतामेष पापः प्रकृतिदारुणः। जीवन् जगदसावाशु कुरुते भस्मसाद् ध्रुवम्॥ ४/१४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50010156, "chapter_id": 11435, "verse_number": "37", "content_sanskrit": "नायमर्हत्यसद्वृत्तो नरदेववरासनम्। योऽविद् यज्ञपतिं विष्णुं विनिन्दत्यनपत्रपः॥ ४/१४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50010157, "chapter_id": 11435, "verse_number": "38", "content_sanskrit": "को वैनं परिचक्षीत वेनमेकमृतेऽशुभम्। प्राप्त ईदृशमैश्वर्यं यदनुग्रहभाजनम्॥ ४/१४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50010158, "chapter_id": 11435, "verse_number": "39", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50010159, "chapter_id": 11435, "verse_number": "40", "content_sanskrit": "इत्थं व्यवसिता हन्तुमृषयो रूढमन्यवः। निजघ्नुर्हुङ्कृतैर्वेनं हतमच्युतनिन्दया॥ ४/१४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50010160, "chapter_id": 11435, "verse_number": "41", "content_sanskrit": "ऋषिभिः स्वाश्रमपदं गते पुत्रकळेबरम्। सुनीथा पालयामास विद्यायोगेन शोचती॥ ४/१४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50010161, "chapter_id": 11435, "verse_number": "42", "content_sanskrit": "एकदा मुनयस्ते तु सरयूसलिलाप्लुताः। हुत्वाऽग्निं सत्कथाश्चक्रुरुपविष्टाः सरित्तटे॥ ४/१४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50010162, "chapter_id": 11435, "verse_number": "43", "content_sanskrit": "वीक्ष्योत्थितान् महोत्पातानाहुर्लोकभयङ्करान्। अप्यभद्रमनाथाया दस्युभ्यो न भवेद् भुवः॥ ४/१४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50010163, "chapter_id": 11435, "verse_number": "44", "content_sanskrit": "एवं ब्रुवत्सु ऋषिषु धावतां सर्वतो दिशम्। पांसुः समुत्थितो भूमेश्चोराणां वसु लुम्पताम्॥ ४/१४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50010164, "chapter_id": 11435, "verse_number": "45", "content_sanskrit": "तदुपद्रवमाज्ञाय लोकस्य वसु लुम्पताम्। भर्तर्युपरते तस्मिन्नन्योन्यं च जिघांसताम्॥ ४/१४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50010165, "chapter_id": 11435, "verse_number": "46", "content_sanskrit": "चोरप्रायं जनपदं हीनसत्त्वमराजकम्। लोका नावारयञ्छक्ता अपि तद्दोषदर्शिनः॥ ४/१४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50010166, "chapter_id": 11435, "verse_number": "47", "content_sanskrit": "ब्राह्मणः समदृक् शान्तो दीनानां समुपेक्षकः। स्रवते ब्रह्म तस्यापि भिन्नभाण्डात् पयो यथा॥ ४/१४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50010167, "chapter_id": 11435, "verse_number": "48", "content_sanskrit": "नाङ्गस्य वंशो राजर्षेरेवं संस्थातुमर्हति। अमोघवीर्या हि नृपा वंशेऽस्मिन् केशवाश्रयाः॥ ४/१४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50010168, "chapter_id": 11435, "verse_number": "49", "content_sanskrit": "विनिश्चित्यैवमृषयो विपन्नस्य महीपतेः। ममन्थुरूरुं तरसा तत्रासीद् बाहुको नरः॥ ४/१४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50010169, "chapter_id": 11435, "verse_number": "50", "content_sanskrit": "काककृष्णोऽतिह्वस्वाङ्गो ह्वस्वबाहुर्महाहनुः। ह्वस्वपान्निम्ननासाग्रो रक्ताक्षस्ताम्रमूर्धजः॥ ४/१४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50010170, "chapter_id": 11435, "verse_number": "51", "content_sanskrit": "तं तु तेऽवनतं दीनं किं करोमीति वादिनम्। निषीदेत्यब्रुवंस्तात स निषादस्ततोऽभवत्॥ ४/१४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50010171, "chapter_id": 11435, "verse_number": "52", "content_sanskrit": "तस्य वंश्यास्तु नैषादा गिरिकाननगोचराः। योऽपाहरज्जायमानो वेनकल्मषमुद्बणम्॥ ४/१४/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50010172, "chapter_id": 11435, "verse_number": "53", "content_sanskrit": "अथ तस्य पुनर्विप्रैर्विपन्नस्य महीपतेः। बाहुभ्यां मथ्यमानाभ्यां मिथुनं समपद्यत॥ ४/१४/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50010173, "chapter_id": 11435, "verse_number": "54", "content_sanskrit": "तद् दृष्ट्वा मिथुनं जातमृषयो ब्रह्मवादिनः। ऊचुः परमसन्तुष्टा विदित्वा भगवत्कलाम्॥ ४/१४/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50010174, "chapter_id": 11435, "verse_number": "55", "content_sanskrit": "ऋषय ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50010175, "chapter_id": 11435, "verse_number": "56", "content_sanskrit": "एष विष्णोर्भगवतः कला भुवनपालनी। इयं च लक्ष्मीः सम्भूतिः पुरुषस्यानपायिनी॥ ४/१४/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50010176, "chapter_id": 11435, "verse_number": "57", "content_sanskrit": "इति श्रीमद्भागवते चतुर्थस्कन्धे चतुर्दशोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]