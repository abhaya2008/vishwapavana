[{"id": 2097726, "chapter_id": 3092, "verse_number": "१३-२२२-१", "content_sanskrit": "उमोवाच।\nभगवन्देवदेवेश शूलपाणे वृषध्वज।\nपुंश्चल्य इव या स्त्रीषु नीचवृत्तिरताः स्मृताः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2097727, "chapter_id": 3092, "verse_number": "१३-२२२-२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2097728, "chapter_id": 3092, "verse_number": "१३-२२२-२", "content_sanskrit": "याः पुरा मनुजा देवि बुद्धिमोहसमन्विताः।\nकामरागसमायुक्ताः पतीनतिचरन्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2097729, "chapter_id": 3092, "verse_number": "१३-२२२-३", "content_sanskrit": "प्रतिकूलपरा यास्तु पतीन्प्रति यथा तथा।\nशौचं लज्जां तु विस्मृत्य यथेष्टपरिचारणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2097730, "chapter_id": 3092, "verse_number": "१३-२२२-४", "content_sanskrit": "एवंयुक्तसमाचारा यमलोके सुदण्डिताः।\nयदि वै मानुषं जन्म लभेरंस्तास्तथाविधाः।\nबहुसाधारणा एव पुंश्चल्यश्च भवन्ति ताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2097731, "chapter_id": 3092, "verse_number": "१३-२२२-५", "content_sanskrit": "पौश्चल्यं यत्तु तद्वृत्तं स्त्रीणां कष्टतमं स्मृतम्।\nततःप्रभृति ता देवि पतन्त्येव न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2097732, "chapter_id": 3092, "verse_number": "१३-२२२-६", "content_sanskrit": "शोचन्ति चेत्तु तद्वृत्तं मनसा हितमाप्नुयुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2097733, "chapter_id": 3092, "verse_number": "१३-२२२-६x", "content_sanskrit": "उमोवाच।\nभगवन्देवदेवेश प्रमदा विधवा भृशम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2097734, "chapter_id": 3092, "verse_number": "१३-२२२-७", "content_sanskrit": "दृश्यन्ते मानुषा लोके सर्वकल्याणवर्जिताः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2097735, "chapter_id": 3092, "verse_number": "१३-२२२-८x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2097736, "chapter_id": 3092, "verse_number": "१३-२२२-८", "content_sanskrit": "याः पुरा मनुजा देवि बुद्धिमोहसमन्विताः।\nकुटुम्बं तत्र वे पत्युर्नाशयन्ति वृथा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2097737, "chapter_id": 3092, "verse_number": "१३-२२२-९", "content_sanskrit": "विषदाश्चाग्निदाश्चैव पतीन्प्रति सुनिर्दयाः।\nअन्यासां हि पतीन्यान्ति स्वपतिद्वेषकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2097738, "chapter_id": 3092, "verse_number": "१३-२२२-१०", "content_sanskrit": "एवंयुक्तसमाचारा यमलोके सुदण्डिताः।\nनिरयस्थाश्चिरं कालं कथंचित्प्राप्य मानुषम्।\nतत्र ता भोगरहिता विधवास्तु भवन्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2097739, "chapter_id": 3092, "verse_number": "१३-२२२-११x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2097740, "chapter_id": 3092, "verse_number": "१३-२२२-११", "content_sanskrit": "भगवन्प्रमदा लोके पत्यौ ज्ञातिषु सत्सुच।\nलिङ्गिन्यः सम्प्रदृश्यन्ते पाषण्डं मतमाश्रिताः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2097741, "chapter_id": 3092, "verse_number": "१३-२२२-१२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2097742, "chapter_id": 3092, "verse_number": "१३-२२२-१२", "content_sanskrit": "याः पुरा भावदोषेणि लोभमोहसमन्विताः।\nपरद्रव्यपरा लोभात्परेषां द्रव्यहारकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2097743, "chapter_id": 3092, "verse_number": "१३-२२२-१३", "content_sanskrit": "अभ्यसूयापरा यास्तु सपत्नीनां प्रदूषकाः।\nईर्ष्यापराः कोपनाश्च बन्धूनां विफलाः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2097744, "chapter_id": 3092, "verse_number": "१३-२२२-१४", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि ताः स्त्रियः।\nअलक्षणसमायुक्ताः पाषण्डं धर्ममाश्रिताः।\nस्त्रियः प्रव्राजशीलाश्च भवन्त्येव न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2097745, "chapter_id": 3092, "verse_number": "१३-२२२-१५x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2097746, "chapter_id": 3092, "verse_number": "१३-२२२-१५", "content_sanskrit": "भगवन्मानुषाः केचित्कारुवृत्तिसमाश्रिताः।\nप्रदृश्यन्ते मनुष्येषु नीचकर्मरतास्तथा।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2097747, "chapter_id": 3092, "verse_number": "१३-२२२-१६x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2097748, "chapter_id": 3092, "verse_number": "१३-२२२-१६", "content_sanskrit": "ये पुरा मनुजा देवि स्तब्धमानयुता भृशम्।\nदर्पाहङ्कारसंयुक्ताः केवलात्मपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2097749, "chapter_id": 3092, "verse_number": "१३-२२२-१७", "content_sanskrit": "तादृशा मानुषा देवि पुनर्जन्मनि शोभने।\nकात्वो नटगन्धर्वाः सम्भवन्ति यथा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2097750, "chapter_id": 3092, "verse_number": "१३-२२२-१८", "content_sanskrit": "नापिता बन्दिनश्चैव तथा वैतालिकाः प्रिये।\nएवंभूतास्त्वधोवृत्तिं जीवन्त्याश्रित्य मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2097751, "chapter_id": 3092, "verse_number": "१३-२२२-१९", "content_sanskrit": "परप्रसाधनकरास्ते परैः कृतवेतनाः।\nपरावमानस्य फलं भुञ्जते पौर्वदैहिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2097752, "chapter_id": 3092, "verse_number": "१३-२२२-२०x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2097753, "chapter_id": 3092, "verse_number": "१३-२२२-२०", "content_sanskrit": "भगवन्देवदेवेश मानुषेष्वेव केचन।\nदासभूताः प्रदृश्यन्ते सर्वकर्मपरा भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2097754, "chapter_id": 3092, "verse_number": "१३-२२२-२१", "content_sanskrit": "आघातभर्त्सनसहाः पीड्यमानाश्च सर्वशः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2097755, "chapter_id": 3092, "verse_number": "१३-२२२-२२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2097756, "chapter_id": 3092, "verse_number": "१३-२२२-२२", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु कल्याणि कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2097757, "chapter_id": 3092, "verse_number": "१३-२२२-२३", "content_sanskrit": "ये पुरा मनुजा देवि परेषां वित्तहारकाः।\nऋणवृद्धिकरं कृष्या न्यासदत्तं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2097758, "chapter_id": 3092, "verse_number": "१३-२२२-२४", "content_sanskrit": "निक्षेपकारणाद्दत्तपरद्रव्यापहारिणः।\nप्रमादाद्विस्मृतं नष्टं परेषां धनहारकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2097759, "chapter_id": 3092, "verse_number": "१३-२२२-२५", "content_sanskrit": "वधबन्धपरिक्लेशैर्दासत्वं कुर्वते परान्।\nतादृशा मरणं प्राप्ता दण्डिता यमशासनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2097760, "chapter_id": 3092, "verse_number": "१३-२२२-२६", "content_sanskrit": "कथञ्चित्प्राप्य मानुष्यं तत्र ते देवि सर्वथा।\nदासभूता भविष्यन्ति जन्मप्रभृति मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2097761, "chapter_id": 3092, "verse_number": "१३-२२२-२७", "content_sanskrit": "तेषां कर्माणि कुर्वन्ति येषां ते धनहारकाः।\nआसमाप्तेः स्वपापस्य कुर्वन्तीति विनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2097762, "chapter_id": 3092, "verse_number": "१३-२२२-२८", "content_sanskrit": "पशुभूतास्तथा चान्ये भवन्ति धनहारकाः।\nतत्तथा क्षीयते कर्म तेषां पूर्वापराधजम्।\nअतोऽन्यथा न तच्छक्यं कर्म भोक्तुं सुरासुरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2097763, "chapter_id": 3092, "verse_number": "१३-२२२-२९", "content_sanskrit": "किन्तु मोक्षविधिस्तेषां सर्वता तत्प्रसादनम्।\nअयथावन्मोक्षकामः पुनर्जन्मनि चेष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2097764, "chapter_id": 3092, "verse_number": "१३-२२२-३०", "content_sanskrit": "मोक्षकामी यथान्यायं कुर्वन्कर्माणि सर्वशः।\nभर्तुः प्रसादमाकाङ्क्षेदायासान्सर्वथा सहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2097765, "chapter_id": 3092, "verse_number": "१३-२२२-३१", "content_sanskrit": "प्रीतिपूर्वं तु यो भर्त्रा मुक्तो मुक्तः स्वपापतः।\nतथाभूतान्कर्मकरान्सदा सन्तोषयेत्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2097766, "chapter_id": 3092, "verse_number": "१३-२२२-३२", "content_sanskrit": "यथार्हं कारयेत्कर्म दण्डकारणतः क्षिपेत्।\nवृद्धान्बालांस्तथा क्षीणान्पालयन्धर्ममाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2097767, "chapter_id": 3092, "verse_number": "१३-२२२-३३", "content_sanskrit": "इति ते कथितं देवि भूयः श्रोतुं किमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2097768, "chapter_id": 3092, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्वाविंशत्यधिकद्विशततमोऽध्यायः॥ २२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]