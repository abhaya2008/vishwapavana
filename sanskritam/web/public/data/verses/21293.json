[{"id": 7001293000, "chapter_id": 21293, "verse_number": "३-२५-१", "content_sanskrit": "नन्दीश्वर उवाच ।\nअथ लोके व्यवस्थाय धर्मस्य स्थापनेच्छया ।\nमहालीलां चकारेशस्तामहो सन्मुने शृणु॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001293001, "chapter_id": 21293, "verse_number": "३-२५-२", "content_sanskrit": "एकदा पुष्पभद्रायां स्नातुं गच्छन्मुनीश्वरः ।\nददर्श पद्मां युवतीं शिवांशां सुमनोहराम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001293002, "chapter_id": 21293, "verse_number": "३-२५-३", "content_sanskrit": "तल्लिप्सुस्तत्पितुः स्थानमनरण्यस्य भूपतेः ।\nजगाम भुवनाचारी लोकतत्त्वविचक्षणः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001293003, "chapter_id": 21293, "verse_number": "३-२५-४", "content_sanskrit": "राजा नराणां तं दृष्ट्वा प्रणम्य च भयाकुलः ।\nमधुपर्कादिकं दत्त्वा पूजयामास भक्तितः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001293004, "chapter_id": 21293, "verse_number": "३-२५-५", "content_sanskrit": "स्नेहात्सर्वं गृहीत्वा स ययाचे कन्यकां मुनिः ।\nमौनी बभूव नृपतिः किंचिन्निर्वक्तुमक्षमः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001293005, "chapter_id": 21293, "verse_number": "३-२५-६", "content_sanskrit": "मुनिः प्रोवाच नृपतिं कन्यां मे देहि भक्तितः ।\nअन्यथा भस्मसात्सर्वं करिष्येहं त्वया सह॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001293006, "chapter_id": 21293, "verse_number": "३-२५-७", "content_sanskrit": "अथो बभूवुराच्छन्नाः सर्वे राजजनास्तदा ।\nतेजसा पिप्पलादस्य दाधीचस्य महामुने॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001293007, "chapter_id": 21293, "verse_number": "३-२५-८", "content_sanskrit": "अथ राजा महाभीतो विलप्य च मुहुर्मुहुः ।\nकन्यामलंकृताम्पद्मां वृद्धाय मुनये ददौ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001293008, "chapter_id": 21293, "verse_number": "३-२५-९", "content_sanskrit": "पद्मां विवाह्य स मुनिश्शिवांशाम्भूपतेः सुताम् ।\nपिप्पलादो गृहीत्वा तां मुदितः स्वाश्रमं ययौ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001293009, "chapter_id": 21293, "verse_number": "३-२५-१०", "content_sanskrit": "तत्र गत्वा मुनिवरो वयसा जर्जरोधिकः ।\nउवाच नार्या स तया तपस्वीनातिलम्पटः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001293010, "chapter_id": 21293, "verse_number": "३-२५-११", "content_sanskrit": "अथोऽनरण्यकन्या सा सिषेवे भक्तितो मुनिम् ।\nकर्मणा मनसा वाचा लक्ष्मीर्नारायणं यथा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001293011, "chapter_id": 21293, "verse_number": "३-२५-१२", "content_sanskrit": "इत्थं स पिप्पलादो हि शिवांशो मुनिसत्तमः ।\nरेमे तया युवत्या च युवाभूय स्वलीलया॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001293012, "chapter_id": 21293, "verse_number": "३-२५-१३", "content_sanskrit": "दश पुत्रा महात्मानो बभूवुस्सुतपस्विनः ।\nमुनेः पितुस्समाः सर्वे पद्मायाः सुखवर्द्धनाः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001293013, "chapter_id": 21293, "verse_number": "३-२५-१४", "content_sanskrit": "एवं लीलावतारो हि शंकरस्य महाप्रभोः ।\nपिप्पलादो मुनिवरो नानालीलाकरः प्रभुः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001293014, "chapter_id": 21293, "verse_number": "३-२५-१५", "content_sanskrit": "येन दत्तो वरः प्रीत्या लोकेभ्यो हि दयालुना ।\nदृष्ट्वा लोके शनेः पीडां सर्वेषामनिवारिणीम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001293015, "chapter_id": 21293, "verse_number": "३-२५-१६", "content_sanskrit": "षोडशाब्दावधि नृणां जन्मतो न भवेच्च सा ।\nतथा च शिवभक्तानां सत्यमेतद्धि मे वचः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001293016, "chapter_id": 21293, "verse_number": "३-२५-१७", "content_sanskrit": "अथानादृत्य मद्वाक्यं कुर्यात्पीडां शनिः क्वचित् ।\nतेषां नृणां तदा स स्याद्भस्मसान्न हि संशयः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001293017, "chapter_id": 21293, "verse_number": "३-२५-१८", "content_sanskrit": "इति तद्भयतस्तात विकृतोपि शनैश्चरः ।\nतेषां न कुरुते पीडां कदाचिद्ग्रहसत्तमः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001293018, "chapter_id": 21293, "verse_number": "३-२५-१९", "content_sanskrit": "इति लीलामनुष्यस्य पिप्पलादस्य सन्मुने ।\nकथितं सुचरित्रन्ते सर्वकामफलप्रदम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001293019, "chapter_id": 21293, "verse_number": "३-२५-२०", "content_sanskrit": "गाधिश्च कौशिकश्चैव पिप्पलादो महामुनिः ।\nशनैश्चरकृतां पीडां नाशयन्ति स्मृतास्त्रयः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001293020, "chapter_id": 21293, "verse_number": "३-२५-२१", "content_sanskrit": "पिप्पलादस्य चरितं पद्माचरितसंयुतम् ।\nयः पठेच्छृणुयाद्वापि सुभक्त्या भुवि मानवः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001293021, "chapter_id": 21293, "verse_number": "३-२५-२२", "content_sanskrit": "शनिपीडाविनाशार्थमेतच्चरितमुत्तमम् ।\nयः पठेच्छणुयाद्वापि सर्वान्कामानवाप्नुयात्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001293022, "chapter_id": 21293, "verse_number": "३-२५-२३", "content_sanskrit": "धन्यो मुनिवरो ज्ञानी महाशैवः सताम्प्रियः ।\nअस्य पुत्रो महेशानः पिप्पलादाख्य आत्मवान्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001293023, "chapter_id": 21293, "verse_number": "३-२५-२४", "content_sanskrit": "इदमाख्यानमनघं स्वर्ग्यं कुग्रहपोषहृत् ।\nसर्वकामप्रदन्तात शिवभक्तिविवर्द्धनम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]