[{"id": 2032644, "chapter_id": 1705, "verse_number": "४-२८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2032645, "chapter_id": 1705, "verse_number": "४-२८-१", "content_sanskrit": "ते दृष्ट्वा निहतान्सूतान्भीमसेनेन भारत।\nपौराश्च सहिताः सर्वे राज्ञे गत्वा न्यवेदयन् ।\nगन्धर्वेण हता राजन्सूतपुत्राः परश्शतम् ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2032646, "chapter_id": 1705, "verse_number": "४-२८-२", "content_sanskrit": "यथा वज्रेण दीर्णं वै पर्वतस्य महच्छिरः।\nविनिकार्णाः प्रदृश्यन्ते तथा सूता महीतले ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2032647, "chapter_id": 1705, "verse_number": "४-२८-३", "content_sanskrit": "सैरन्ध्री चापि मुक्ता सा पुनरायाति ते गृहम् ।\nसर्वं संशयितं राजन्नगरं ते भविष्यति ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2032648, "chapter_id": 1705, "verse_number": "४-२८-४", "content_sanskrit": "तथारूपा हि सैरन्ध्री गन्धर्वाश्च महाबलाः ।\nपुंसामिष्टश्च विषयो मैथुनाय न संशयः ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2032649, "chapter_id": 1705, "verse_number": "४-२८-५", "content_sanskrit": "यथा सैरन्ध्रिदोषेण नेदं राजन्पुरं तव।\nविनाशमेति वै क्षिप्रं तथा साधु विधीयताम् ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2032650, "chapter_id": 1705, "verse_number": "४-२८-६", "content_sanskrit": "सर्वाङ्गसौष्ठवयुतां रूपलावण्यशालिनीम् ।\nपश्यतामनिमेषेण चक्षुषा वनितां शुभाम्।\nमनसश्चक्षुषश्चैव प्रतिबन्धो न विद्यते ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2032651, "chapter_id": 1705, "verse_number": "४-२८-७", "content_sanskrit": "तस्मात्तां यः पुमान्दृष्ट्वा रूपेणाप्रतिमां भुवि।\nगच्छेत्कामवशं मूढो गन्धर्वैः स निहन्यते ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2032652, "chapter_id": 1705, "verse_number": "४-२८-८", "content_sanskrit": "निष्कासयैनां भवनात्पुराच्चैव विशेषतः।\nकालः प्रविश्य सैरन्ध्रीं पुरं नाशयते ध्रुवम् ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2032653, "chapter_id": 1705, "verse_number": "४-२८-९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2032654, "chapter_id": 1705, "verse_number": "४-२८-९", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा विराटो वाहिनीपतिः।\nअब्रवीत्क्रियतामेषां सूतानामपरक्रिया ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2032655, "chapter_id": 1705, "verse_number": "४-२८-१०", "content_sanskrit": "एकस्मिन्नेव ते सर्वे सुसमिद्धे हुताशने।\nदह्यन्तां कीचकाः सर्वे सर्वगन्धैश्च सर्वशः ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2032656, "chapter_id": 1705, "verse_number": "४-२८-११", "content_sanskrit": "इत्युक्त्वा परमोद्वग्निः प्रविश्यान्तःपुरं शुभम्।\nसुदेष्णां चाब्रवीद्राजा महिषीं जातसाध्वसः ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2032657, "chapter_id": 1705, "verse_number": "४-२८-१२", "content_sanskrit": "सैरन्ध्रीमागतां ब्रूया ममैव वचनादिह ।\nगच्छ सैरन्ध्रि भद्रं ते यथाकामं चराधुना ।\nबिभेति राजा सैरन्धि गन्धर्वेभ्यः पराभवात् ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2032658, "chapter_id": 1705, "verse_number": "४-२८-१३", "content_sanskrit": "न हि तामुत्सहे वक्तुं स्वयं गन्धर्वरक्षिताम् ।\nस्त्रियास्त्वदोषस्तां वक्तुमतस्त्वां प्रब्रवीम्यहम् ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2032659, "chapter_id": 1705, "verse_number": "४-२८-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2032660, "chapter_id": 1705, "verse_number": "४-२८-१४", "content_sanskrit": "एकस्मिन्नेव ते सर्वे सुसमिद्धे हुताशने।\nअदहन्कीचकान्सर्वान्संस्कारैश्चैव सर्वशः ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2032661, "chapter_id": 1705, "verse_number": "४-२८-१५", "content_sanskrit": "अथ मुक्ता भयात्कृष्णा सूतपुत्रान्निरस्य च।\nमोक्षिता भीमसेनेन जगाम नगरं प्रति ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2032662, "chapter_id": 1705, "verse_number": "४-२८-१६", "content_sanskrit": "त्रासितेव मृगी बाला शार्दूलेन मनस्विनी।\nसा तु गात्राणि वासश्च प्रक्षाल्य प्रविवेश ह ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2032663, "chapter_id": 1705, "verse_number": "४-२८-१७", "content_sanskrit": "तां दृष्ट्वा पुरुषा राजन्प्राद्रवन्त दिशो दश।\nगन्धर्वाणां भयत्रस्ताः केचिद्दृष्टिं न्यमीलयन् ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2032664, "chapter_id": 1705, "verse_number": "४-२८-१८", "content_sanskrit": "प्रदुद्रुवुश्चाप्यपरे तथा जना हस्तैश्च चक्षूंषि पिधाय मोहिताः।\nमा पश्यत स्मेति च तां ब्रुवन्तस्तथा जनाश्चुक्रुशुरार्तरूपाः ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2032665, "chapter_id": 1705, "verse_number": "४-२८-१९", "content_sanskrit": "तामद्य यः पश्यति रूपशालिनीं शयीत भग्नोऽत्र यथैव कीचकाः।\nइति ब्रुवन्तो भयविग्नचेतसो भयेन गन्धर्वगतेन मोहिताः ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2032666, "chapter_id": 1705, "verse_number": "४-२८-२०", "content_sanskrit": "ततो महानसद्वारे भीमसेनमवस्थितम्।\nददर्श राजन्पाञ्चाली यथा मत्तं महाद्विपम् ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2032667, "chapter_id": 1705, "verse_number": "४-२८-२१", "content_sanskrit": "सोपहासं तु शनकैः संज्ञाभिरिदमब्रवीत्।\nनमो गन्धर्वराजाय येनास्मि परिमोक्षिता ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2032668, "chapter_id": 1705, "verse_number": "४-२८-२२", "content_sanskrit": "कीचकेभ्यो विनिर्दोषामनाथां वसतीं गृहे।\nयो मां रक्षति सन्त्रस्तां गन्धर्वाय नमोस्तु ते ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2032669, "chapter_id": 1705, "verse_number": "४-२८-२३x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2032670, "chapter_id": 1705, "verse_number": "४-२८-२३", "content_sanskrit": "ये यस्या विचरन्तीह पुरुषा वशवर्तिनः।\nतेषां च वशगा नित्यं विचर त्वं यथेष्टतः ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2032671, "chapter_id": 1705, "verse_number": "४-२८-२४", "content_sanskrit": "ये पुरा विचरन्तीह पुरुषा वशवर्तिनः।\nतस्यास्ते वचनं श्रुत्वा ह्यनृणा विहरन्त्वितः ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2032672, "chapter_id": 1705, "verse_number": "४-२८-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2032673, "chapter_id": 1705, "verse_number": "४-२८-२५", "content_sanskrit": "तयोस्तद्वचनं श्रुत्वा जझिरे नेतरे जनाः।\nततः पाञ्चालराजस्य सुता चापि जगाम ह ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2032674, "chapter_id": 1705, "verse_number": "४-२८-२६", "content_sanskrit": "ततः सा नर्तनागारे धनंजयमपश्यत।\nराज्ञः कन्या विराटस्य नर्तयन्तं महाभुजम् ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2032675, "chapter_id": 1705, "verse_number": "४-२८-२७", "content_sanskrit": "ततस्ता नर्तनागाराद्विनिष्क्रम्य सहार्जुनाः।\nकन्या ददृशुरायान्तीं कृष्णां क्लिष्टामनागसम् ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2032676, "chapter_id": 1705, "verse_number": "४-२८-२८x", "content_sanskrit": "कान्या ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2032677, "chapter_id": 1705, "verse_number": "४-२८-२८", "content_sanskrit": "दिष्ट्या सैरन्ध्रि मुक्ताऽसि दिष्ट्याऽसि पुनरागता।\nदिष्ट्या च निहताः सूता ये त्वां क्लिश्यन्त्यनागसम् ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2032678, "chapter_id": 1705, "verse_number": "४-२८-२९x", "content_sanskrit": "बृहन्नलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2032679, "chapter_id": 1705, "verse_number": "४-२८-२९", "content_sanskrit": "कथं सैरन्ध्रि मुक्ताऽसि कथं पापाश्च ते हताः।\nइच्छामि ते कथां श्रोतुं कथयस्व यथातथम् ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2032680, "chapter_id": 1705, "verse_number": "४-२८-३०x", "content_sanskrit": "सैरन्ध्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2032681, "chapter_id": 1705, "verse_number": "४-२८-३०", "content_sanskrit": "बृहन्नले किंनु तव सैरन्ध्र्या कार्यमद्य वै।\nया त्वं रंस्यसि कल्याणि सदा कन्यापुरे सुखं ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2032682, "chapter_id": 1705, "verse_number": "४-२८-३१", "content_sanskrit": "न हि दुःख समाप्नोषि सैरन्ध्री यदुपाश्रुते।\nसुखेन वर्तसे येह न तद्दुःखमवाप्यते।\nतेन मां दुःखितामेवं पृच्छसि प्रहसन्त्यपि ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2032683, "chapter_id": 1705, "verse_number": "४-२८-३२x", "content_sanskrit": "बृहन्नलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2032684, "chapter_id": 1705, "verse_number": "४-२८-३२", "content_sanskrit": "बृहन्नलाऽपि कल्याणि दुःखमाप्नोत्यनन्तकम्।\nतिर्यग्योनिगतेवेयं न चैनामवबुध्यसे ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2032685, "chapter_id": 1705, "verse_number": "४-२८-३३", "content_sanskrit": "त्वया सहोषिता चास्मि त्वं च सर्वैः सहोषिता।\nत्वत्तः कृच्छ्रतरं वासं वसेयमहमङ्गने ।\nक्लिश्यन्त्यां त्वयि सुश्रोणि कोनु दुःखं न चिन्तयेत्। ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2032686, "chapter_id": 1705, "verse_number": "४-२८-३४", "content_sanskrit": "न तु केनचिदन्यन्तं कस्यचिद्धृदयं क्वचित्।\nवेदितुं शक्यते नूनं तेन मां नावबुध्यसे ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2032687, "chapter_id": 1705, "verse_number": "४-२८-३५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2032688, "chapter_id": 1705, "verse_number": "४-२८-३५", "content_sanskrit": "ततः सहैव कन्याभिर्द्रौपदी राजवेश्म तत्।\nप्रविवेश सुदेष्णायाः समीपमनसूयिनी ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2032689, "chapter_id": 1705, "verse_number": "४-२८-३६", "content_sanskrit": "तामब्रवीद्राजपत्नी विराटवचनादिदम् ।\nसैरन्ध्रि गम्यतां शीघ्रं यत्र कामयसे गतिम् ।\nराजा बिभेति सैरन्ध्रि गन्धर्वेभ्यः पराभवात् ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2032690, "chapter_id": 1705, "verse_number": "४-२८-३७", "content_sanskrit": "त्वं चापि तरुणी सुभ्रू रूपेणाप्रतिमा भुवि ।\nचित्तानि च नृणां भद्रे रक्तानि स्पर्शजे सुखे ॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2032691, "chapter_id": 1705, "verse_number": "४-२८-३८", "content_sanskrit": "तस्मात्त्वत्तो भयं मह्यं राष्ट्रस्य नगरस्य च।\nगच्छाद्यैव यथेष्टं त्वं नगराद्यत्र रंस्यसे ॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2032692, "chapter_id": 1705, "verse_number": "४-२८-३९", "content_sanskrit": "त्वन्निमित्तं शुभे मह्यं सर्वो बन्धुजनो हतः।\nनृशंसा खलु ते बुद्धिर्भ्रातॄणां मे कृतो वधः ॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2032693, "chapter_id": 1705, "verse_number": "४-२८-४०", "content_sanskrit": "तस्माद्गन्धर्वराजेभ्यो भयमद्य प्रवर्तते।\nयथेष्टं गच्छ सैरन्ध्रि स्वस्ति चेह यथा भवेत् ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2032694, "chapter_id": 1705, "verse_number": "४-२८-४१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2032695, "chapter_id": 1705, "verse_number": "४-२८-४१", "content_sanskrit": "सुदेष्णाया वचः श्रुत्वा सैरन्ध्री चेदमब्रवीत् ।\nत्रयोदशाहमात्रं तु राजा क्षाम्यतु भामिनि ॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2032696, "chapter_id": 1705, "verse_number": "४-२८-४२", "content_sanskrit": "कृतकृत्या अविष्यन्ति गन्धर्वास्ते न संशयः ।\nततो मामुपनेष्यन्ति करिष्यन्ति च ते प्रियम् ॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2032697, "chapter_id": 1705, "verse_number": "४-२८-४३", "content_sanskrit": "ध्रुवं च श्रेयसा राजा योक्ष्यते सह बान्धवैः ।\nराज्ञः कृतोपकाराश्च कृतज्ञाश्च सदा शुभे।\nसाधवश्च बलोत्सिक्ताः कृतप्रतिकृतेप्सवः ॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2032698, "chapter_id": 1705, "verse_number": "४-२८-४४", "content_sanskrit": "अर्थिनी मा ब्रवीत्येषा यद्वातद्वेति चिन्तय।\nभरस्व तदहर्मात्रं तत्ते श्रेयो भविष्यति ॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2032699, "chapter_id": 1705, "verse_number": "४-२८-४५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2032700, "chapter_id": 1705, "verse_number": "४-२८-४५", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा कैकेयी दुःखमोहिता।\nउवाच द्रौपदीमार्ता भ्रातृव्यसनकर्शिता ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2032701, "chapter_id": 1705, "verse_number": "४-२८-४६", "content_sanskrit": "वस भद्रे यथेष्टं त्वं त्वामहं शरणं गता।\nत्रायस्व मम भर्तारं पुत्रांश्चैव विशेषतः ॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2032702, "chapter_id": 1705, "verse_number": "४-२८-४७", "content_sanskrit": "इत्युक्तवा राजशार्दूल राज्ञे सर्वं न्यवेदयत् ।\nत्रिंशद्रात्रिमिमां भीरुः कृतकृत्या निवासये ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2032703, "chapter_id": 1705, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि कीचकवधपर्वणि अष्टाविंशोऽध्यायः ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]