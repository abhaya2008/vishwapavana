[{"id": 2206903, "chapter_id": 5410, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2206904, "chapter_id": 5410, "verse_number": "१", "content_sanskrit": "शुश्रूषे तस्य धर्मज्ञ राजर्षेः परिकीर्तनम् ।\nद्वैपायन मरुत्तस्य कथां प्रब्रूहि मेऽनघ\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2206905, "chapter_id": 5410, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2206906, "chapter_id": 5410, "verse_number": "२", "content_sanskrit": "आसीत् कृतयुगे पूर्वं मनुर्दण्डधरः प्रभुः ।\nतस्य पुत्रो महेष्वासः प्रजातिरभवन् नृपः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2206907, "chapter_id": 5410, "verse_number": "३", "content_sanskrit": "प्रजातेरभवत् पुत्रः क्षुप इत्यभिविश्रुतः ।\nक्षुपस्य पुत्र इक्ष्वाकुर्महीपालोऽभवत् प्रभुः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2206908, "chapter_id": 5410, "verse_number": "४", "content_sanskrit": "तस्य पुत्रशतं राजन्नासीत् परमधार्मिकम् ।\nतांस्तु सर्वान् महीपालान् इक्ष्वाकुरकरोत् प्रभुः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2206909, "chapter_id": 5410, "verse_number": "५", "content_sanskrit": "तेषां ज्येष्ठस्तु विंशोऽभूत् प्रतिमानं धनुष्मताम् ।\nविंशस्य पुत्रः कल्याणो विविंशो नाम भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2206910, "chapter_id": 5410, "verse_number": "६", "content_sanskrit": "विविंशस्य सुता राजन् बभूवुर्दश पञ्च च ।\nसर्वे धनुषि विक्रान्ता ब्रह्मण्याः सत्यवादिनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2206911, "chapter_id": 5410, "verse_number": "७", "content_sanskrit": "दानकर्मरताः सन्तः प्रजाहितचिकीर्षवः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2206912, "chapter_id": 5410, "verse_number": "८", "content_sanskrit": "तेषां ज्येष्ठः खनीनेत्रः स तान् सर्वानपीडयत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2206913, "chapter_id": 5410, "verse_number": "९", "content_sanskrit": "खनीनेत्रस्तु विक्रान्तो जित्वा राज्यमकण्टकम् ।\nनाशक्नोद् रक्षितुं राज्यं नानुरञ्जन्ति तं प्रजाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2206914, "chapter_id": 5410, "verse_number": "१०", "content_sanskrit": "तमपाहाय तद्राज्ये तस्य पुत्रं सुवर्चसम् ।\nअभ्यषिञ्चन्त राजेन्द्र मुदिता ह्यभवंस्तदा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2206915, "chapter_id": 5410, "verse_number": "११", "content_sanskrit": "स पितुर्विक्रियां दृष्ट्वा राज्यान्निरसनं तथा ।\nनियतो वर्तयामास प्रजाहितचिकीर्षया\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2206916, "chapter_id": 5410, "verse_number": "१२", "content_sanskrit": "ब्रह्मण्यः सत्यवादी च शुचिः शमदमान्वितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2206917, "chapter_id": 5410, "verse_number": "१३", "content_sanskrit": "प्रजास्तं चान्वरज्यन्त धर्मनित्यं मनस्विनम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2206918, "chapter_id": 5410, "verse_number": "१४", "content_sanskrit": "तस्य धर्मप्रवृत्तस्य व्यशीर्यत् कोशवाहनम् ।\nतं क्षीणकोशं सामन्ताः समन्तात् पर्यपीडयन्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2206919, "chapter_id": 5410, "verse_number": "१५", "content_sanskrit": "स पीड्यमानो बहुभिः क्षीणकोशाश्ववाहनः ।\nआर्तिमार्च्छत् परां राजा सह भृत्यैः पुरेण च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2206920, "chapter_id": 5410, "verse_number": "१६", "content_sanskrit": "न चैनं परिहर्तुं ते शक्नुवन् परिसङ्क्षये ।\nसम्यग् वृत्तो हि राजाऽसौ धर्मनित्यो युधिष्ठिर\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2206921, "chapter_id": 5410, "verse_number": "१७", "content_sanskrit": "यदा तु परमामार्तिं गतोऽसौ सपुरो नृप ।\nततः प्रदध्मौ स करं प्रादुरासीत् ततो बलम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2206922, "chapter_id": 5410, "verse_number": "१८", "content_sanskrit": "ततस्तानजयत् सर्वान् प्रतिसीमान् नराधिपान् ।\nएतस्मात् कारणाद् राजन् विश्रुतः स करन्धमः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2206923, "chapter_id": 5410, "verse_number": "१९", "content_sanskrit": "पुत्रस्त्रेतायुगमुखेऽभवदावीक्षिसञ्ज्ञकः ।\nइन्द्रादनवमः श्रीमान् देवैरपि सुदुर्जयः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2206924, "chapter_id": 5410, "verse_number": "२०", "content_sanskrit": "कारन्धम इति ख्यातो बभूव जगतीपतिः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2206925, "chapter_id": 5410, "verse_number": "२१", "content_sanskrit": "तस्य सर्वे महीपाला वर्तन्ते स्म वशे तदा ।\nस हि सम्राडभूद् तेषां वृत्तेन च बलेन च\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2206926, "chapter_id": 5410, "verse_number": "२२", "content_sanskrit": "अविक्षिदेव धर्मात्मा शौर्येणेन्द्रसमोऽभवत् ।\nयज्ञशीलो कर्मरतो धृतिमान् संयतेन्द्रियः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2206927, "chapter_id": 5410, "verse_number": "२३", "content_sanskrit": "तेजसाऽऽदित्यसदृशः क्षमया पृथिवीसमः ।\nबृहस्पतिसमो बुद्ध्या हिमवानिव सुस्थिरः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2206928, "chapter_id": 5410, "verse_number": "२४", "content_sanskrit": "कर्मणा मनसा वाचा दमेन प्रशमेन च ।\nमनांस्याराधयामास प्रजानां स महीपतिः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2206929, "chapter_id": 5410, "verse_number": "२५", "content_sanskrit": "य ईजे हयमेधानां शतेन विधिवत् प्रभुः ।\nयाजयामास यं विद्वान् स्वयमेवाङ्गिराः प्रभुः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2206930, "chapter_id": 5410, "verse_number": "२६", "content_sanskrit": "तस्य पुत्रोऽतिचक्राम पितरं गुणवत्तया ।\nमरुत्तो नाम धर्मज्ञः चक्रवर्ती महायशाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2206931, "chapter_id": 5410, "verse_number": "२७", "content_sanskrit": "नागायुतसमप्राणः साक्षाद् विष्णुरिवापरः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2206932, "chapter_id": 5410, "verse_number": "२८", "content_sanskrit": "स यक्ष्यमाणो धर्मात्मा शातकुम्भमयानि तु ।\nकारयामास शुभ्राणि भाजनानि सहस्रशः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2206933, "chapter_id": 5410, "verse_number": "२९", "content_sanskrit": "मेरुं पर्वतमासाद्य हिमवत्पार्श्व उत्तरे ।\nकाञ्चनः सुमहान् पादः तत्र कर्म चकार सः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2206934, "chapter_id": 5410, "verse_number": "३०", "content_sanskrit": "ततः कुण्डानि पात्र्यश्च पिठराण्यासनानि च ।\nचक्रुः सुवर्णकर्तारः तेषां सङ्ख्या न विद्यते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2206935, "chapter_id": 5410, "verse_number": "३१", "content_sanskrit": "तस्यैव च समीपे तु यज्ञवाटो बभूव ह\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2206936, "chapter_id": 5410, "verse_number": "३२", "content_sanskrit": "ईजे तत्र स धर्मात्मा विधिवत् पृथिवीपतिः ।\nमरुत्तः सहितैः सर्वैः प्रजापालैर्नराधिपः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2206937, "chapter_id": 5410, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्याम् आश्वमेधिकपर्वणि मरुत्तयज्ञस्थळकथनं नाम चतुर्थोऽध्यायः ॥४॥\nअश्वमेधपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]