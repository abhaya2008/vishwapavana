[{"id": 2128735, "chapter_id": 3764, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128736, "chapter_id": 3764, "verse_number": "१", "content_sanskrit": "ततः प्रयातः कौन्तेयः क्रमेण भरतर्षभ ।\nनन्दां परमनन्दां च नद्यौ पापभयापहे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128737, "chapter_id": 3764, "verse_number": "२", "content_sanskrit": "स पर्वतं समासाद्य हेमकूटमनामयम् ।\nअचिन्त्यानद्भुतान् भावान् ददर्श सुबहून् नृपः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128738, "chapter_id": 3764, "verse_number": "३", "content_sanskrit": "वर्षायिताऽभवन् मेघा उपलाश्च सहस्रशः ।\nनाशक्नुवंस्तदारोढुं विषण्णमनसो जनाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128739, "chapter_id": 3764, "verse_number": "५", "content_sanskrit": "वायुर्यत्र ववौ नित्यं नित्यं देवश्च वर्षति ।\nसायं प्रातश्च भगवान् दृश्यते हव्यवाहनः\t॥४॥\nएवं बहुविधान् भावानद्भुतान् वीक्ष्य पाण्डवः ।\nलोमशं पुनरेव स्म पर्यपृच्छत् तदद्भुतम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128740, "chapter_id": 3764, "verse_number": "६", "content_sanskrit": "यदेतद् भगवंश्चित्रं पर्वतेऽस्मिन् महौजसि ।\nएतन्मे सर्वमाचक्ष्व विस्तरेण महाद्युते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128741, "chapter_id": 3764, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128742, "chapter_id": 3764, "verse_number": "७", "content_sanskrit": "यथाश्रुतमिदं पूर्वमस्माभिररिकर्शन ।\nतदेकाग्रमना राजन् निबोध वदतो मम\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128743, "chapter_id": 3764, "verse_number": "८", "content_sanskrit": "अस्मिन्नृषभकूटे तु ऋषभो नाम तापसः ।\nअनेकशतवर्षायुः तपस्वी कोपनो भृशम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128744, "chapter_id": 3764, "verse_number": "९", "content_sanskrit": "स वै सम्भाष्यमाणोऽन्यैः कोपाद् गिरिमुवाच ह ।\nय इह व्याहरेत् कश्चिद् उपलानुत्सृजेस्तथा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128745, "chapter_id": 3764, "verse_number": "१०", "content_sanskrit": "वातं चाहूय मा शब्दमित्युवाच स तापसः ।\nव्याहरंश्चैव पुरुषो मेघेन विनिवार्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128746, "chapter_id": 3764, "verse_number": "११", "content_sanskrit": "एवमेतानि कर्माणि राजंस्तेन महर्षिणा ।\nकृतानि कानिचित् कोपात् प्रतिषिद्धानि कानिचित् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128747, "chapter_id": 3764, "verse_number": "१२", "content_sanskrit": "नन्दामभिगता देवाः पुरा राजन्निति श्रुतिः ।\nअन्वपद्यन्त सहसा पुरुषा देवदर्शिनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128748, "chapter_id": 3764, "verse_number": "१३", "content_sanskrit": "तेनादर्शनमिच्छन्तो देवाः शक्रपुरोगमाः ।\nदुर्गं चक्रुरिमं देशं गिरिं प्रत्यूहरूपकम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128749, "chapter_id": 3764, "verse_number": "१४", "content_sanskrit": "तदा प्रभृति कौन्तेय नरा गिरिमिमं सदा ।\nनाशक्नुवन्नभिद्रष्टुं कुत एवाधिरोहितुम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128750, "chapter_id": 3764, "verse_number": "१५", "content_sanskrit": "नातप्ततपसा शक्यो द्रष्टुमेष महागिरिः ।\nआरोढुं वाऽपि कौन्तेय तस्मान्नियतवाग्भव \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128751, "chapter_id": 3764, "verse_number": "१६", "content_sanskrit": "इह देवास्तदा सर्वे यज्ञानाजह्नुरुत्तमान् ।\nतेषामेतानि लिङ्गानि दृश्यन्ते पुरुषर्षभ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128752, "chapter_id": 3764, "verse_number": "१७", "content_sanskrit": "कुशाकारेण दूर्वेयं संस्तीर्णेव च मेदिनी ।\nयूपप्रकारा बहवो वृक्षाश्चेमे विशांपते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2128753, "chapter_id": 3764, "verse_number": "१८", "content_sanskrit": "देवाश्च ऋषयश्चापि वसन्त्यद्यापि भारत ।\nतेषां सायं तथा प्रातर्दृश्यते हव्यवाहनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2128754, "chapter_id": 3764, "verse_number": "१९", "content_sanskrit": "इहाप्लुतानां कौन्तेय पाप्मा सद्यो विहन्यते ।\nकुरुश्रेष्ठाभिषेकं त्वमस्मिन् कुरु सहानुजैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2128755, "chapter_id": 3764, "verse_number": "२०", "content_sanskrit": "ततो नन्दाप्लुताङ्गस्त्वं कौशिकीमभियास्यसि ।\nविश्वामित्रेण वै यत्र तपस्तप्तमनुत्तमम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2128756, "chapter_id": 3764, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2128757, "chapter_id": 3764, "verse_number": "२१", "content_sanskrit": "ततस्तत्र समाप्लुत्य गात्राणि सगणो नृपः ।\nजगाम कौशिकीं पुण्यां रम्यां शिवजलां नदीम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2128758, "chapter_id": 3764, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि षडुत्तरशततमोऽध्यायः ॥१०६॥\n॥ तीर्थयात्रापर्वणि द्विषष्टितमोऽध्यायः ॥६२॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]