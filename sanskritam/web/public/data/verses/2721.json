[{"id": 2080985, "chapter_id": 2721, "verse_number": "१२-२२६-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080986, "chapter_id": 2721, "verse_number": "१२-२२६-१", "content_sanskrit": "द्विजातयो व्रतोपेता यदिदं भुञ्जते हविः।\nअन्नं ब्राह्मणकामाय कथमेतत्पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080987, "chapter_id": 2721, "verse_number": "१२-२२६-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080988, "chapter_id": 2721, "verse_number": "१२-२२६-२", "content_sanskrit": "अवेदोक्तव्रतोपेता भुञ्जानाः कार्यकारिणः।\nवेदोक्तेषु च भुञ्जाना व्रतलुब्धा युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080989, "chapter_id": 2721, "verse_number": "१२-२२६-३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080990, "chapter_id": 2721, "verse_number": "१२-२२६-३", "content_sanskrit": "यदिदं तप इत्याहुरुपवासं पृथग्जनाः।\nएतत्तपो महाराज उताहो किं तपो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080991, "chapter_id": 2721, "verse_number": "१२-२२६-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080992, "chapter_id": 2721, "verse_number": "१२-२२६-४", "content_sanskrit": "मासपक्षोपवासेन मन्यन्ते यत्तपो जनाः।\nआत्मतन्त्रोपधातस्तु न तपस्तत्सतां मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080993, "chapter_id": 2721, "verse_number": "१२-२२६-५", "content_sanskrit": "त्यागश्च सन्नतिश्चैव शिष्यते तप उत्तमम्।\nसदोपवासी स भवेद्ब्रह्मचारी सदा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080994, "chapter_id": 2721, "verse_number": "१२-२२६-६", "content_sanskrit": "मुनिश्च स्यात्सदा विप्रो दैवतं च सदा भवेत्।\nकुटुम्बिको धर्मपरः सदाऽस्वप्नश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080995, "chapter_id": 2721, "verse_number": "१२-२२६-७", "content_sanskrit": "अमांसादी सदा च स्यात्पवित्री च सदा भवेत्।\nअमृताशी सदा च स्यान्न च स्याद्विषभोजनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080996, "chapter_id": 2721, "verse_number": "१२-२२६-८", "content_sanskrit": "विधसाशी सदा च स्यात्सदा चैवातिथिप्रियः।\n[श्रद्दधानः सदा च स्याद्देवताद्विजपूजकः]॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080997, "chapter_id": 2721, "verse_number": "१२-२२६-९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080998, "chapter_id": 2721, "verse_number": "१२-२२६-९", "content_sanskrit": "कथं सदोपवासी स्याद्ब्रह्मचारी कथं भवेत्।\nविघसाशी कथं च स्यात्सदा चैवातिथिप्रयिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080999, "chapter_id": 2721, "verse_number": "१२-२२६-१०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2081000, "chapter_id": 2721, "verse_number": "१२-२२६-१०", "content_sanskrit": "अन्तरा प्रातराशं च सायमाशं तथैव च।\nसदोपवासी स भवेद्यो न भुङ्क्तेऽन्तरा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2081001, "chapter_id": 2721, "verse_number": "१२-२२६-११", "content_sanskrit": "भार्यां गच्छन्ब्रह्मचारी ऋतौ भवति ब्राह्मणः।\nऋतवादी भवेन्नित्यं ज्ञाननित्यश्च यो नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2081002, "chapter_id": 2721, "verse_number": "१२-२२६-१२", "content_sanskrit": "न भक्षयेद्वृथा मांसममांसाशी भवत्यपि।\nदाननित्यः पवित्रीस्यादस्वप्नश्च दिवाऽस्वपन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2081003, "chapter_id": 2721, "verse_number": "१२-२२६-१३", "content_sanskrit": "भृत्यातिथिषु यो भुङ्क्ते भुक्तवत्सु सदा नरः।\nअमृतं केवलं भुङ्क्ते इति विद्धि युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2081004, "chapter_id": 2721, "verse_number": "१२-२२६-१४", "content_sanskrit": "अभुक्तवत्सु भुञ्जानो विषमश्नाति वै द्विजः।\nअदत्त्वा योऽतिथिभ्योऽन्नं न भुङ्क्ते सोतिथिप्रियः।\n`अभुक्त्वा दैवतेभ्यश्च यो न भुङ्क्ते सदैवतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2081005, "chapter_id": 2721, "verse_number": "१२-२२६-१५", "content_sanskrit": "देवताभ्यः पितृभ्यश्च भृत्येभ्योऽतिथिभिः सह।\nअवशिष्टं तु योऽश्नाति तमाहुर्विघसाशिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2081006, "chapter_id": 2721, "verse_number": "१२-२२६-१६", "content_sanskrit": "तेषां लोका ह्यपर्यन्ताः सदने ब्रह्मणा सह।\nउपस्थिताश्चाप्सरोभिः परियान्ति दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2081007, "chapter_id": 2721, "verse_number": "१२-२२६-१७", "content_sanskrit": "देवताभिश्च ये सार्धं पितृभ्यश्चोपभुञ्जते।\nरमन्ते पुत्रपौत्रैश्च तेषां गतिरनुत्तमा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2081008, "chapter_id": 2721, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि षङ्विशत्यधिकद्विशततमोऽध्यायः॥ २२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]