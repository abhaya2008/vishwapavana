[{"id": 6000312000, "chapter_id": 10312, "verse_number": null, "content_sanskrit": "एकादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000312001, "chapter_id": 10312, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.001.m4a", "display_order": 2}, {"id": 6000312002, "chapter_id": 10312, "verse_number": "११-११-१", "content_sanskrit": "बद्धो मुक्त इति ह्याख्या गुणतो मे न वस्तुतः।\nगुणस्य मायामूलत्वान्न मे मोक्षो न बन्धनम्॥ ११/११/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.002.m4a", "display_order": 3, "topics": [{"text": "कृष्णेनोद्धवं प्रति बद्धमुक्तलक्षणकथनम्", "range": "१–२५"}]}, {"id": 6000312003, "chapter_id": 10312, "verse_number": "११-११-२", "content_sanskrit": "शोकमोहौ सुखं दुःखं देहापत्तिश्च मायया।\nस्वप्ने यथाऽऽत्मनः ख्यातिः संसृतिर्नतु वास्तवी॥ ११/११/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.003.m4a", "display_order": 4}, {"id": 6000312004, "chapter_id": 10312, "verse_number": "११-११-३", "content_sanskrit": "विद्याविद्ये मम तनू विद्ध्युद्धव शरीरिणाम्।\nमोक्षबन्धकरी आद्ये मायया मे विनिर्मिते॥ ११/११/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.004.m4a", "display_order": 5}, {"id": 6000312005, "chapter_id": 10312, "verse_number": "११-११-४", "content_sanskrit": "एकस्यैव ममांशस्य जीवस्यैवं महामते।\nबन्धोऽस्याविद्ययाऽनादिर्विद्यया च तथेतरत्॥ ११/११/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.005.m4a", "display_order": 6}, {"id": 6000312006, "chapter_id": 10312, "verse_number": "११-११-५", "content_sanskrit": "अथ बद्धस्य मुक्तस्य वैलक्षण्यं वदामि ते।\nविरुद्धधर्मिणोस्तात स्थितयोरेकधर्मिणि॥ ११/११/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.006.m4a", "display_order": 7}, {"id": 6000312007, "chapter_id": 10312, "verse_number": "११-११-६", "content_sanskrit": "सुपर्णावेतौ सदृशौ सखायौ यदृच्छया कृतनीडौ च वृक्षे।\nएकस्तयोः खादति पिप्पलान्नमन्यो निरन्नोऽपि बलेन भूयान्॥ ११/११/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.007.m4a", "display_order": 8}, {"id": 6000312008, "chapter_id": 10312, "verse_number": "११-११-७", "content_sanskrit": "आत्मानमन्यं च स वेद विद्वानपिप्पलादो न तु पिप्पलादः।\nयोऽविद्ययाऽन्धः स तु नित्यबद्धो विद्यामयो यः स तु नित्यमुक्तः॥ ११/११/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.008.m4a", "display_order": 9}, {"id": 6000312009, "chapter_id": 10312, "verse_number": "११-११-८", "content_sanskrit": "देहस्थोऽपि न देहस्थो विद्वान् स्वप्नाद् यथोत्थितः।\nअदेहस्थोऽपि देहस्थः कुमतिः स्वप्नदृग् यथा॥ ११/११/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.009.m4a", "display_order": 10}, {"id": 6000312010, "chapter_id": 10312, "verse_number": "११-११-९", "content_sanskrit": "इन्द्रियैरिन्द्रियार्थेषु गुणैरपि गुणेषु च।\nगृह्यमाणेष्वहंकुर्यान्न विद्वान् यस्त्वविक्रियः॥ ११/११/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.010.m4a", "display_order": 11}, {"id": 6000312011, "chapter_id": 10312, "verse_number": "११-११-१०", "content_sanskrit": "दैवाधीने शरीरेऽस्मिन् गुणभाव्येन कर्मणा।\nवर्तमानोऽबुधस्तत्र कर्ताऽस्मीति निबध्यते॥ ११/११/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.011.m4a", "display_order": 12}, {"id": 6000312012, "chapter_id": 10312, "verse_number": "११-११-११", "content_sanskrit": "एवं विरक्तः शयन आसनाटनमज्जने।\nदर्शनस्पर्शनघ्राणभोजनश्रवणादिषु॥ ११/११/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.012.m4a", "display_order": 13}, {"id": 6000312013, "chapter_id": 10312, "verse_number": "११-११-१२", "content_sanskrit": "न तथा बध्यते विद्वान् तत्र तत्राददन् गुणान्।\nप्रकृतिस्थोऽप्यसंसक्तो यथा खं सविताऽनिलः॥ ११/११/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.013.m4a", "display_order": 14}, {"id": 6000312014, "chapter_id": 10312, "verse_number": "११-११-१३", "content_sanskrit": "वैशारद्येक्षयाऽसङ्गशितया च्छिन्नसंशयः।\nप्रतिबुद्ध इव स्वप्नान्नानात्वाद् विनिवर्तते॥ ११/११/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.014.m4a", "display_order": 15}, {"id": 6000312015, "chapter_id": 10312, "verse_number": "११-११-१४", "content_sanskrit": "यस्य स्युर्वीतसङ्कल्पाः प्राणेन्द्रियमनोधियाम्।\nवृत्तयः स विनिर्मुक्तो देहस्थोऽपि हि तद्गुणैः॥ ११/११/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.015.m4a", "display_order": 16}, {"id": 6000312016, "chapter_id": 10312, "verse_number": "११-११-१५", "content_sanskrit": "यस्यात्मा हिंस्यते हिंस्रैर्येन किञ्चिद् यदृच्छया।\nअर्च्यते वा क्‍वचित् तत्र न तु विक्रियते बुधः॥ ११/११/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.016.m4a", "display_order": 17}, {"id": 6000312017, "chapter_id": 10312, "verse_number": "११-११-१६", "content_sanskrit": "न स्तुवीत न निन्देत कुर्वतः साध्वसाधु वा।\nवदतो गुणदोषाभ्यां वर्जितः समदृङ्मुनिः॥ ११/११/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.017.m4a", "display_order": 18}, {"id": 6000312018, "chapter_id": 10312, "verse_number": "११-११-१७", "content_sanskrit": "न कुर्यान्न वदेत् किञ्चिन्न ध्यायेत् साध्वसाधु वा।\nआत्मारामोऽनया वृत्त्या विचरेज्जडवन्मुनिः॥ ११/११/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.018.m4a", "display_order": 19}, {"id": 6000312019, "chapter_id": 10312, "verse_number": "११-११-१८", "content_sanskrit": "शब्दब्रह्मणि निष्णातो न निष्णायात् परे यदि।\nश्रमस्तत्र भ्रमफलो ह्यधेनुमिव रक्षतः॥ ११/११/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.019.m4a", "display_order": 20}, {"id": 6000312020, "chapter_id": 10312, "verse_number": "११-११-१९", "content_sanskrit": "गां दुग्धदोहामसतीं च भार्यां देहं पराधीनमसत्प्रजां च।\nवित्तं त्वतीर्थीकृतमङ्ग वाचं हीनां मया रक्षति दुःखदुःखी॥ ११/११/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.020.m4a", "display_order": 21}, {"id": 6000312021, "chapter_id": 10312, "verse_number": "११-११-२०", "content_sanskrit": "यस्यां न मे पावनमङ्ग कर्मस्थित्युद्भवत्राणनिरोधमस्य।\nलीलावतारेहितकर्म वा स्याद् वन्ध्यां गिरं तां बिभृयान्न धीरः॥ ११/११/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.021.m4a", "display_order": 22}, {"id": 6000312022, "chapter_id": 10312, "verse_number": "११-११-२१", "content_sanskrit": "एवं जिज्ञासयाऽपोह्य नानात्वभ्रममात्मनि।\nउपारमेत विरजं मनो मय्यर्प्य सर्वगे॥ ११/११/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.022.m4a", "display_order": 23}, {"id": 6000312023, "chapter_id": 10312, "verse_number": "११-११-२२", "content_sanskrit": "यद्यनीशो धारयितुं मनो ब्रह्मणि निश्चलम्।\nमयि सर्वाणि कर्माणि निरपेक्षः समाचर॥ ११/११/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.023.m4a", "display_order": 24}, {"id": 6000312024, "chapter_id": 10312, "verse_number": "११-११-२३", "content_sanskrit": "श्रद्धालुर्मे कथाः शृण्वन् सुभद्रा लोकपावनीः।\nगायन्ननुस्मरन् कर्म जन्म वाऽभिनयन् मुहुः॥ ११/११/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.024.m4a", "display_order": 25}, {"id": 6000312025, "chapter_id": 10312, "verse_number": "११-११-२४", "content_sanskrit": "मदर्थे धर्मकामार्थानाचरन् मदुपाश्रयः।\nलभते निश्चलां भक्तिं मय्युद्धव सनातने॥ ११/११/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.025.m4a", "display_order": 26}, {"id": 6000312026, "chapter_id": 10312, "verse_number": "११-११-२५", "content_sanskrit": "सत्सङ्गलब्धया भक्त्या मयि मां य उपासते।\nस वै मे दर्शितं सद्भिरञ्जसा विन्दते पदम्॥ ११/११/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.026.m4a", "display_order": 27}, {"id": 6000312027, "chapter_id": 10312, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.027.m4a", "display_order": 28}, {"id": 6000312028, "chapter_id": 10312, "verse_number": "११-११-२६", "content_sanskrit": "साधुत्व उत्तमश्लोक मनः कीदृग्विधं प्रभो।\nभक्तिस्त्वय्युपयुञ्जीत कीदृशी सद्भिरादृता॥ ११/११/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.028.m4a", "display_order": 29, "topics": [{"text": "साधूनां भक्तेश्च लक्षणम्", "range": "२६–४९"}]}, {"id": 6000312029, "chapter_id": 10312, "verse_number": "११-११-२७", "content_sanskrit": "एतन्मे पुरुषाध्यक्ष प्रपन्नाय च कथ्यताम्॥ ११/११/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.029.m4a", "display_order": 30}, {"id": 6000312030, "chapter_id": 10312, "verse_number": "११-११-२८", "content_sanskrit": "त्वं ब्रह्म परमं व्योम पुरुषः प्रकृतेः परः।\nअवतीर्णोऽसि भगवन् स्वेच्छोपात्तपृथग्वपुः॥ ११/११/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.030.m4a", "display_order": 31}, {"id": 6000312031, "chapter_id": 10312, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.031.m4a", "display_order": 32}, {"id": 6000312032, "chapter_id": 10312, "verse_number": "११-११-२९", "content_sanskrit": "कृपालुरकृतद्रोहस्तितिक्षुः सर्वदेहिनाम्।\nसत्यसारोऽनवद्यात्मा समः सर्वोपकारकः॥ ११/११/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.032.m4a", "display_order": 33}, {"id": 6000312033, "chapter_id": 10312, "verse_number": "११-११-३०", "content_sanskrit": "कामैरहतधीर्दान्तो मृदुः शुचिरकिञ्चनः।\nअनीहो मितभुक् शान्तः स्थिरो मच्छरणो मुनिः॥ ११/११/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.033.m4a", "display_order": 34}, {"id": 6000312034, "chapter_id": 10312, "verse_number": "११-११-३१", "content_sanskrit": "अप्रमत्तो गभीरात्मा धृतिमान् जितषड्गुणः।\nअमानी मानदः कल्पो मैत्रः कारुणिकः कविः॥ ११/११/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.034.m4a", "display_order": 35}, {"id": 6000312035, "chapter_id": 10312, "verse_number": "११-११-३२", "content_sanskrit": "आज्ञायैव गुणान्दोषान् मया दिष्टानपि स्वकान्।\nधर्मान् सन्त्यज्य यः सर्वान् मां भजेत् स च सत्तमः॥ ११/११/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.035.m4a", "display_order": 36}, {"id": 6000312036, "chapter_id": 10312, "verse_number": "११-११-३३", "content_sanskrit": "ज्ञात्वा ज्ञात्वाऽथ ये वै मां यावान् यश्चास्मि यादृशः।\nभजन्त्यनन्यभावेन ते मे भक्ततमा मताः॥ ११/११/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.036.m4a", "display_order": 37}, {"id": 6000312037, "chapter_id": 10312, "verse_number": "११-११-३४", "content_sanskrit": "मल्लिङ्गमद्भक्तजनदर्शनस्पर्शनार्चनम्।\nपरिचर्या स्तुतिप्रह्वगुणकर्मानुकीर्तनम्॥ ११/११/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.037.m4a", "display_order": 38}, {"id": 6000312038, "chapter_id": 10312, "verse_number": "११-११-३५", "content_sanskrit": "मत्कथाश्रवणे श्रद्धा मदनुध्यानमुद्धव।\nसर्वलाभोपहरणं दास्येनात्मनिवेदनम्॥ ११/११/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.038.m4a", "display_order": 39}, {"id": 6000312039, "chapter_id": 10312, "verse_number": "११-११-३६", "content_sanskrit": "मज्जन्मकर्मकथनं मम पर्वानुमोदनम्।\nगीतताण्डववादित्रगोष्ठीभिर्मद्गृहोत्सवः॥ ११/११/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.039.m4a", "display_order": 40}, {"id": 6000312040, "chapter_id": 10312, "verse_number": "११-११-३७", "content_sanskrit": "यात्रा बलिविधानं च सर्ववार्षिकपर्वसु।\nवैदिकी तान्त्रिकी दीक्षा मदीयव्रतधारणम्॥ ११/११/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.040.m4a", "display_order": 41}, {"id": 6000312041, "chapter_id": 10312, "verse_number": "११-११-३८", "content_sanskrit": "ममार्चास्थापने श्रद्धा मम सद्मनि चोद्यमः।\nउद्यानोपवनाक्रीडपुरमन्दिरकर्मणि॥ ११/११/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.041.m4a", "display_order": 42}, {"id": 6000312042, "chapter_id": 10312, "verse_number": "११-११-३९", "content_sanskrit": "सम्मार्जनोपलेपाभ्यां सेकमण्डलवर्तनैः।\nगृहे शुश्रूषणं मह्यं दासवद् यदमायया॥ ११/११/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.042.m4a", "display_order": 43}, {"id": 6000312043, "chapter_id": 10312, "verse_number": "११-११-४०", "content_sanskrit": "अमानित्वमदम्भित्वं कृतस्यापरिकीर्तनम्।\nअपि दीपावलोकं मे नोपयुञ्ज्यान्निवेदितम्॥ ११/११/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.043.m4a", "display_order": 44}, {"id": 6000312044, "chapter_id": 10312, "verse_number": "११-११-४१", "content_sanskrit": "यद्यदिष्टतमं लोके यच्चातिप्रियमात्मनः।\nतत्तन्निवेदयेन्मह्यं तदानन्त्याय कल्पते॥ ११/११/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.044.m4a", "display_order": 45}, {"id": 6000312045, "chapter_id": 10312, "verse_number": "११-११-४२", "content_sanskrit": "सूर्योऽग्निर्ब्राह्मणो गावो वैष्णवः खं मरुज्जलम्।\nभूरात्मा सर्वभूतानि भद्र पूजापदानि मे॥ ११/११/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.045.m4a", "display_order": 46}, {"id": 6000312046, "chapter_id": 10312, "verse_number": "११-११-४३", "content_sanskrit": "सूर्ये तु विद्यया त्रय्या हविषाऽग्नौ यजेत माम्।\nआतिथ्येन तु विप्राग्र्ये गोष्ठे गा यवसादिना॥ ११/११/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.046.m4a", "display_order": 47}, {"id": 6000312047, "chapter_id": 10312, "verse_number": "११-११-४४", "content_sanskrit": "वैष्णवे बन्धुसत्कृत्या हृदि खे ध्याननिष्ठया।\nवायौ मुख्यधिया तोये द्रव्यैस्तोयपुरस्कृतैः॥ ११/११/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.047.m4a", "display_order": 48}, {"id": 6000312048, "chapter_id": 10312, "verse_number": "११-११-४५", "content_sanskrit": "स्थण्डिले मन्त्रहृदयैर्भोगैरात्मनमात्मनि।\nक्षेत्रज्ञं सर्वभूतेषु समत्वेन यजेत माम्॥ ११/११/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.048.m4a", "display_order": 49}, {"id": 6000312049, "chapter_id": 10312, "verse_number": "११-११-४६", "content_sanskrit": "धिष्ण्येष्वेतेषु मद्रूपं शङ्खचक्रगदाम्बुजैः।\nयुक्तं चतुर्भुजं शान्तं ध्यायन्नर्चेत् समाहितः॥ ११/११/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.049.m4a", "display_order": 50}, {"id": 6000312050, "chapter_id": 10312, "verse_number": "११-११-४७", "content_sanskrit": "इष्टापूर्तेन मामेवं यो यजेत समाहितः।\nलभते मयि सद्भक्तिं मत्स्मृतिं साधुसेवया॥ ११/११/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.050.m4a", "display_order": 51}, {"id": 6000312051, "chapter_id": 10312, "verse_number": "११-११-४८", "content_sanskrit": "प्रायेण भक्तियोगेन साङ्ख्येन च विनोद्धव।\nनोपायो विद्यते सध्य्रक् प्रायणं हि सतामहम्॥ ११/११/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.051.m4a", "display_order": 52}, {"id": 6000312052, "chapter_id": 10312, "verse_number": "११-११-४९", "content_sanskrit": "अथैतत् परमं गुह्यं शृण्वते यदुनन्दन।\nसुगोप्यमपि वक्ष्यामि त्वं मे भृत्यः सुहृत् सखा॥ ११/११/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_011/BhP_11.011.052.m4a", "display_order": 53}, {"id": 6000312053, "chapter_id": 10312, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे एकादशाध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]