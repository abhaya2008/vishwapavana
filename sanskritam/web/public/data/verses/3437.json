[{"id": 2113299, "chapter_id": 3437, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113300, "chapter_id": 3437, "verse_number": "१", "content_sanskrit": "धृतराष्ट्रस्य पुत्राणामादितः कथितं त्वया ।\nऋषेर्मतात् पुत्रशतं न तु कन्याऽत्र कीर्तिता \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113301, "chapter_id": 3437, "verse_number": "२", "content_sanskrit": "वैश्यापुत्रो युयुत्सुश्च एतदेकशतं द्विज ।\nजन्मापि धार्तराष्ट्रस्य उक्तमेतन्महर्षिणा ।\nकथं हि सम्भवस्तस्माद् दुःशलाया ब्रवीहि मे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113302, "chapter_id": 3437, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113303, "chapter_id": 3437, "verse_number": "३", "content_sanskrit": "साध्वयं प्रश्न उद्दिष्टः पाण्डवेय ब्रवीमि ते ।\nतां मांसपेशीं तु तदा स्वयमेव महामुनिः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113304, "chapter_id": 3437, "verse_number": "४", "content_sanskrit": "शीताभिरद्भिः सिञ्चन् वै भागं भागमधारयत् ।\nयो यथा कल्पते भागस्तं तु धात्री स्म वै पृथक् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113305, "chapter_id": 3437, "verse_number": "५", "content_sanskrit": "घृतपूर्णेषु कुण्डेषु एकैकं प्राक्षिपत् तदा ।\nएतस्मिन्नन्तरे साध्वी गान्धारी सुमहायशाः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113306, "chapter_id": 3437, "verse_number": "६", "content_sanskrit": "ब्रह्मर्षिं नाब्रवीत् किञ्चिद् गौरवाच्च यशस्विनी ।\nमनसाऽचिन्तयद् देवी एतत् पुत्रशतं मम \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113307, "chapter_id": 3437, "verse_number": "७", "content_sanskrit": "भविष्यति न सन्देहो न चर्षिर्भाषतेऽन्यथा ।\nमम वै परमा तुष्टिर्दुहिता मे भवेद् यदि \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113308, "chapter_id": 3437, "verse_number": "८", "content_sanskrit": "एका शताधिका बाला शतस्यापि कनीयसी ।\nततो दौहित्रजान् लोकानवाप्तः स्यात् पतिर्मम \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2113309, "chapter_id": 3437, "verse_number": "९", "content_sanskrit": "अहं च कृतकृत्या स्यां दुहित्रा सह सङ्गता ।\nअधिकं किल नारीणां प्रीतिर्जामातृभिर्भवेत् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2113310, "chapter_id": 3437, "verse_number": "१०", "content_sanskrit": "अपत्यं युवतिं चापि दृष्ट्वा प्रीतिमवाप्नुयाम् ।\nयदि सत्यं तपो वा मे गुरवस्तोषिता यदि ।\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2113311, "chapter_id": 3437, "verse_number": "११", "content_sanskrit": "सुकृतं चेह लोकेऽस्ति तथाऽस्तु दुहिता मम ।\nएतस्मिन्नेव काले तु कृष्णद्वैपायनः स्वयम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2113312, "chapter_id": 3437, "verse_number": "१२", "content_sanskrit": "व्यभजत् सहसा विप्रस्तां पेशीं गर्भसम्भवाम् ।\nगण्यमानेषु कुण्डेषु शते पूर्णे महात्मना \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2113313, "chapter_id": 3437, "verse_number": "१३", "content_sanskrit": "अभवच्चापरं खण्डं वामहस्ते तदा किल ।\nपूर्णं पुत्रशतं ह्येव न मिथ्या वागुदीरिता \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2113314, "chapter_id": 3437, "verse_number": "१४", "content_sanskrit": "दैवयोगात् त्वयं भाग एको दृष्टः शतात् परः ।\nएषा ते सुभगे कन्या भविष्यति यथेप्सिता \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2113315, "chapter_id": 3437, "verse_number": "१५", "content_sanskrit": "ततोऽन्यद् घृतकुण्डं तु आनाय्याशु महायशाः ।\nप्राक्षिपत् तं तदा राजन् कन्याभागं परन्तप \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2113316, "chapter_id": 3437, "verse_number": "१६", "content_sanskrit": "सम्भूता चैव कालेन सर्वेषां च यवीयसी ।\nएतत्ते कथितं वीर दुःशलाजन्म चैव तु ।\nब्रूहि राजेन्द्र किं भूयः कथये पाण्डुनन्दन \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2113317, "chapter_id": 3437, "verse_number": "११६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषोडशाधिकशततमोऽध्यायः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2113318, "chapter_id": 3437, "verse_number": "६४", "content_sanskrit": "॥ इति सम्भवपर्वणि चतुःषष्टितमोऽध्यायः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2113319, "chapter_id": 3437, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]