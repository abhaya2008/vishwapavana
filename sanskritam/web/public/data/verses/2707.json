[{"id": 2080311, "chapter_id": 2707, "verse_number": "१२-२१२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080312, "chapter_id": 2707, "verse_number": "१२-२१२-१", "content_sanskrit": "योगं मे परमं तात मोक्षस्य वदभारत।\nतमहं तत्त्वतो ज्ञातुमिच्छामि वदतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080313, "chapter_id": 2707, "verse_number": "१२-२१२-२", "content_sanskrit": "`भूयोपि ज्ञानसद्भावे स्थित्यर्थं त्वां ब्रवीम्यहम्।\nअचिन्त्यं वासुदेवाख्यं तस्मात्प्रब्रूहि सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080314, "chapter_id": 2707, "verse_number": "१२-२१२-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080315, "chapter_id": 2707, "verse_number": "१२-२१२-३", "content_sanskrit": "अत्राप्युदाह न्तीममितिहासं पुरातनम्।\nसंवादं मोक्षसंयुक्तं शिष्यस्य गुरुणा सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080316, "chapter_id": 2707, "verse_number": "१२-२१२-४", "content_sanskrit": "कश्चिद्ब्राह्मणमासीनमाचार्यमृषिसत्तमम्।\nतेजोराशिं महात्मानं सत्यसन्धं जितेन्द्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080317, "chapter_id": 2707, "verse_number": "१२-२१२-५", "content_sanskrit": "शिष्यः परममेधावी श्रेयोर्थी सुसमाहितः।\nचरणावुपसंगृह्य स्थितः प्राञ्जलिरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080318, "chapter_id": 2707, "verse_number": "१२-२१२-६", "content_sanskrit": "उपासनात्प्रसन्नोऽसि यदि वै भगवन्मम।\nसंशयो मे महान्कश्चित्तं मे व्याख्यातुमर्हसि।\nकुतश्चाहं कुतश्च त्वं तत्सम्यग्ब्रूहि यत्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080319, "chapter_id": 2707, "verse_number": "१२-२१२-७", "content_sanskrit": "कथं च सर्वभूतेषु समेषु द्विजसत्तम।\nसम्यग्वृत्ता निवर्तन्ते विपरीताः क्षयोदयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080320, "chapter_id": 2707, "verse_number": "१२-२१२-८", "content_sanskrit": "वेदेषु चापि यद्वाक्यं लौकिकं व्यापकं च यत्।\nएतद्विद्वन्यथातत्त्वं सर्वं व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080321, "chapter_id": 2707, "verse_number": "१२-२१२-९x", "content_sanskrit": "गुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080322, "chapter_id": 2707, "verse_number": "१२-२१२-९", "content_sanskrit": "शृणु शिष्य महाप्राज्ञ ब्रह्मगुह्यमिदं परम्।\nअध्यात्मं सर्वभूतानामागमानां च यद्वसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080323, "chapter_id": 2707, "verse_number": "१२-२१२-१०", "content_sanskrit": "वासुदेवः सर्वमिदं विश्वस्य ब्रह्मणो सुखम्।\nसत्यं दानं तपो यज्ञस्तितिक्षा दम आर्जवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080324, "chapter_id": 2707, "verse_number": "१२-२१२-११", "content_sanskrit": "पुरुषं सनातनं विष्णुं यं तं वेदविदो विदुः।\nसर्गप्रलयकर्तारमव्यक्तं ब्रह्म शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080325, "chapter_id": 2707, "verse_number": "१२-२१२-१२", "content_sanskrit": "तदिदं ब्रह्म वार्ष्णोयमितिहासं शृणुष्व मे।\nब्राह्मणो ब्राह्मणैः श्राव्यो राजन्यः क्षत्रियैस्तता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2080326, "chapter_id": 2707, "verse_number": "१२-२१२-१३", "content_sanskrit": "[वैश्यो वैश्यैस्तथा श्राव्यः शूद्रः शूद्रैर्महामनाः।]\nमाहात्म्यं देवदेवस्य विष्णोरमिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2080327, "chapter_id": 2707, "verse_number": "१२-२१२-१४", "content_sanskrit": "अर्हस्त्वमसि कल्याणं वार्ष्णेयाध्यात्ममुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2080328, "chapter_id": 2707, "verse_number": "१२-२१२-१५", "content_sanskrit": "`यमच्युतं परं नित्यं लिङ्गहीनं च निर्मलम्।\nनिर्वाणममृतं श्रीमत्तद्विष्णोः परमं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2080329, "chapter_id": 2707, "verse_number": "१२-२१२-१६", "content_sanskrit": "भवे च भेदवद्भिन्नं प्रदानं गुणकारकम्।\nतस्मिन्न सज्यते नित्यं स एष पुरुषोऽपरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2080330, "chapter_id": 2707, "verse_number": "१२-२१२-१७", "content_sanskrit": "पुरुषाधिष्ठितं नित्यं प्रधानं ब्रह्म कारणम्।\nकालस्वरूपं रूपेण विष्णुना प्रभविष्णुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2080331, "chapter_id": 2707, "verse_number": "१२-२१२-१८", "content_sanskrit": "क्षोभ्यमाणं सृजत्येव नानाभूतानि भागशः।\nतद्दृष्ट्वा पुरुषोतत्वं साक्षीभूत्वा प्रवर्तते।\nतत्प्रविश्य यथायोगमभिन्नो भिन्नलक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2080332, "chapter_id": 2707, "verse_number": "१२-२१२-१९", "content_sanskrit": "कालचक्रमनाद्यन्तं भावाभावस्वलक्षणम्।\nत्रैलोक्ये सर्वभूतेषु चक्रवत्परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2080333, "chapter_id": 2707, "verse_number": "१२-२१२-२०", "content_sanskrit": "यत्तदक्षरमव्यक्तममृतं ब्रह्म शाश्वतम्।\nवदन्ति पुरुषव्याघ्र केशवं पुरुषर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2080334, "chapter_id": 2707, "verse_number": "१२-२१२-२१", "content_sanskrit": "`तदक्षरमचिन्त्यं वै भिन्नरूपेण दृश्यते।\nपश्य कालाख्यमनिशं न चोष्णं नातिशीतलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2080335, "chapter_id": 2707, "verse_number": "१२-२१२-२२", "content_sanskrit": "न सन्त्येते गुणास्तस्मिंतथा तस्मात्प्रवर्तते।\nशीतलोऽयमनुप्राप्तः कालो ग्रीष्मस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2080336, "chapter_id": 2707, "verse_number": "१२-२१२-२३", "content_sanskrit": "वक्ष्यन्ति सर्वभूतानि ह्येते सूर्योदयं प्रति।\nआगच्छन्ति निवर्तन्ति स कालो गुणराशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2080337, "chapter_id": 2707, "verse_number": "१२-२१२-२४", "content_sanskrit": "न चैव प्रकृतिस्थेन कालयुक्तेन नित्यशः।\nगुणैः संभोगमरतिस्तत्वविज्ञानकोविदम्।\nपुरुषाधिष्ठिता नित्यं प्रकृतिः सूयते परा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2080338, "chapter_id": 2707, "verse_number": "१२-२१२-२५", "content_sanskrit": "पितॄन्देवानृषींश्चैव तथा वै यक्षराक्षसान्।\nनागासुरमनुष्यांश्च सृजते मनसाऽव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2080339, "chapter_id": 2707, "verse_number": "१२-२१२-२६", "content_sanskrit": "तथैव वेदशास्त्राणि लोकधर्मांश्च शाश्वतान्।\nप्रलये प्रकृतिं यातान्युगादौ सृजते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2080340, "chapter_id": 2707, "verse_number": "१२-२१२-२७", "content_sanskrit": "यथर्तुष्वृतुलिङ्गानि नानारूपाणि पर्यये।\nदृश्यन्ते तानि तान्येव तथा भावा युगादिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2080341, "chapter_id": 2707, "verse_number": "१२-२१२-२८", "content_sanskrit": "अथ यद्यद्यदा भावि कालयोगाद्युगादिषु।\nतत्तदुत्पद्यते ज्ञानं लोकयात्राविधानजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2080342, "chapter_id": 2707, "verse_number": "१२-२१२-२९", "content_sanskrit": "`श्रुतिरेषा समाख्याता तदर्थं कारणात्मना।\nअनाम्नायविधानाद्वै वेदा ह्यन्तर्हिता यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2080343, "chapter_id": 2707, "verse_number": "१२-२१२-३०", "content_sanskrit": "युगान्ते ह्यस्तभूतानि शास्त्राणि विविधानि च।\nसर्वसत्वविना द्वै जीवात्मनित्यया स्मृताः।\nअन्यस्मिन्नण्डसद्भावे वर्तमानानि नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2080344, "chapter_id": 2707, "verse_number": "१२-२१२-३१", "content_sanskrit": "युगान्तेऽन्तर्हितान्वेदान्सेतिहासान्महर्षयः।\nलेभिरे तपसा पूर्वमनुज्ञाताः स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2080345, "chapter_id": 2707, "verse_number": "१२-२१२-३२", "content_sanskrit": "`नियोगाद्ब्रह्मणो विप्रा लोकतन्त्रप्रवर्तकाः।\nवेदविद्भगवान्ब्रह्मा वेदाङ्गानि बृहस्पतिः।\nभार्गवो नीतिशास्त्रं तु जगाद जगतो हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2080346, "chapter_id": 2707, "verse_number": "१२-२१२-३३", "content_sanskrit": "गान्धर्वं नारदो वेद भरद्वाजो धनुर्ग्रहम्।\nदेवर्षिचरितं गर्गो कृष्णात्रेयश्चिकित्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2080347, "chapter_id": 2707, "verse_number": "१२-२१२-३४", "content_sanskrit": "`न्यायतन्त्रं हि कार्त्स्न्येन गौतमो वेद तत्वतः।\nवेदान्तकर्मायोगं च वेदविद्ब्रह्मविद्विभुः।\nद्वैपायनो निजग्राह शिल्पशास्त्रं भृगुः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2080348, "chapter_id": 2707, "verse_number": "१२-२१२-३५", "content_sanskrit": "न्यायतन्त्राण्यनेकानि तस्तैरुक्तानि वादिभिः।\nहेत्वागमसदाचारैर्यदुक्तं तदुपास्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2080349, "chapter_id": 2707, "verse_number": "१२-२१२-३६", "content_sanskrit": "अनाद्यं तत्परं ब्रह्म न देवा नर्षयो विदुः।\nएकस्तद्वेद भगवान्धाता नारायणः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2080350, "chapter_id": 2707, "verse_number": "१२-२१२-३७", "content_sanskrit": "नारायणादृषिगणास्तथा मुख्याः सुरासुराः।\nराजर्षयः पुराणाश्च परमं दुःखभेषडम्।\n`वक्ष्येऽहं तव यत्प्राप्तमृषेद्वैपोयनान्मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2080351, "chapter_id": 2707, "verse_number": "१२-२१२-३८", "content_sanskrit": "पुरुषाधिष्ठितान्भावान्प्रकृतिः सूयते यदा।\nहेतुयुक्तमतः पूर्वं जगत्संपरिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2080352, "chapter_id": 2707, "verse_number": "१२-२१२-३९", "content_sanskrit": "दीपादन्ये यथा दीपाः प्रवर्तन्ते सहस्रशः।\nप्रकृतिः सूयते सद्वदानन्त्यान्नापचीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2080353, "chapter_id": 2707, "verse_number": "१२-२१२-४०", "content_sanskrit": "अव्यक्तकर्मजा बुद्धिरहंकारं प्रसूयते।\nआकाशं चाप्यहंकाराद्वायुराकाशसंभवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2080354, "chapter_id": 2707, "verse_number": "१२-२१२-४१", "content_sanskrit": "वायोस्तेजस्ततश्चाप अद्भ्योऽथ वसुधोद्गता।\nमूलप्रकृतयो ह्यष्टौ जगदेतास्ववस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2080355, "chapter_id": 2707, "verse_number": "१२-२१२-४२", "content_sanskrit": "ज्ञानेन्द्रियाण्यतः पञ्च पञ्च कर्मेन्द्रियाण्यपि।\nविषयाः पञ्च चैकं च विकाराः षोडशं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2080356, "chapter_id": 2707, "verse_number": "१२-२१२-४३", "content_sanskrit": "श्रोत्रं त्वक्चक्षुषी जिह्वा घ्राणं ज्ञानेन्द्रियाण्यश्च।\nपादौ पायुरुपस्थश्च हस्तौ वाक्कर्मणी अपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2080357, "chapter_id": 2707, "verse_number": "१२-२१२-४४", "content_sanskrit": "शब्दः स्पर्शश्च रूपं च रसो गन्धस्तथैव च।\nविज्ञेयं व्यापकं चित्तं तेषु सर्वगतं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2080358, "chapter_id": 2707, "verse_number": "१२-२१२-४५", "content_sanskrit": "`बुद्धीन्द्रियार्था इत्युक्ता दशसंसर्गयोनयः।\nसदसद्भावयोगे च मन इत्यभिधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2080359, "chapter_id": 2707, "verse_number": "१२-२१२-४६", "content_sanskrit": "व्यवसायगुणा बुद्धिरहंकारोऽभिमानकः।\nन बीजं देहयोगे च कर्मबीजप्रवर्तनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2080360, "chapter_id": 2707, "verse_number": "१२-२१२-४७", "content_sanskrit": "रसज्ञाने तु जिह्वेयं व्याहृते वाक्यथैव च।\nइन्द्रियैर्विविधैर्युक्तं सर्वैर्व्यतं मनस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2080361, "chapter_id": 2707, "verse_number": "१२-२१२-४८", "content_sanskrit": "विद्यात्तु षोडशैतानि दैवतानि विभागशः।\nदेहेषु ज्ञानकर्तारमुपासीनमुपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2080362, "chapter_id": 2707, "verse_number": "१२-२१२-४९", "content_sanskrit": "तत्र सोमगुणा जिह्वा गन्धस्तु पृथिवीगुणः।\nश्रोत्रे शब्दगुणे चैव चक्षुरग्नेर्गुणस्तथा।\nस्पर्शं वायुगुणं विद्यात्सर्वभूतेषु सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2080363, "chapter_id": 2707, "verse_number": "१२-२१२-५०", "content_sanskrit": "मनः सत्वगुणं प्राहु सत्वमव्यक्तजं तथा।\nसर्वभूतात्मभूतस्थं तस्माद्बुद्ध्येत बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2080364, "chapter_id": 2707, "verse_number": "१२-२१२-५१", "content_sanskrit": "एते भावा जगत्सर्वं बहन्ति सचराचरम्।\nश्रिता विरजसं देवं यमाहुः परमं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2080365, "chapter_id": 2707, "verse_number": "१२-२१२-५२", "content_sanskrit": "नवद्वारं पुरं पुण्यमेतैर्भावैः स्मन्वितम्।\nव्याप्य शेते महानात्मा तस्मात्पुरुष उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2080366, "chapter_id": 2707, "verse_number": "१२-२१२-५३", "content_sanskrit": "अजरश्चामरश्चैव व्यक्ताव्यक्तोपदेशवान्।\nव्यापकः सगुणः सूक्ष्मः सर्वभूतगुणाश्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2080367, "chapter_id": 2707, "verse_number": "१२-२१२-५४", "content_sanskrit": "यथा दीपः प्रकाशात्मा ह्रस्वो वा यदि वा महान्।\nज्ञानात्मानं तथा विद्यात्पुरुषं सर्वजन्तुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2080368, "chapter_id": 2707, "verse_number": "१२-२१२-५५", "content_sanskrit": "श्रोत्रं वेदयते वेद्यं स शृणोति स पश्यति।\nकारणं तस्य देहोऽयं स कर्ता सर्वकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2080369, "chapter_id": 2707, "verse_number": "१२-२१२-५६", "content_sanskrit": "अग्निर्दारुगतो यद्वद्भिन्ने दारौ न दृश्यते।\nतथैवात्मा शरीरस्थ ऋते योगान्न दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2080370, "chapter_id": 2707, "verse_number": "१२-२१२-५७", "content_sanskrit": "अग्निर्यथा ह्युपायेन मथित्वा दारु दृश्यते।\nतथैवात्मा शरीरस्थो योगेनैवात्र दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2080371, "chapter_id": 2707, "verse_number": "१२-२१२-५८", "content_sanskrit": "नदीष्वापो यथा युक्ता यथा सूर्ये मरीचयः।\nसंतन्वाना यथा यान्ति तथा देहाः शरीरिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2080372, "chapter_id": 2707, "verse_number": "१२-२१२-५९", "content_sanskrit": "स्वप्नयोगे यथैवात्मा पञ्चेन्द्रियसमायुतः।\nदेहमुत्सृज्य वै याति तथैवात्मोपलभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2080373, "chapter_id": 2707, "verse_number": "१२-२१२-६०", "content_sanskrit": "कर्मणा व्याप्यते सर्वं कर्मणैवोपपद्यते।\nकर्मणा नीयतेऽन्यत्र स्वकृतेन बलीयसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2080374, "chapter_id": 2707, "verse_number": "१२-२१२-६१", "content_sanskrit": "स तु देहाद्यथा देहं त्यक्त्वाऽन्यं प्रतिपद्यते।\nतथा तं संप्रवक्ष्यामि भूतग्रामं स्वकर्मजम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2080375, "chapter_id": 2707, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि द्वादशाधिकद्विशततमोऽध्यायः॥ २१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]