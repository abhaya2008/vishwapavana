[{"id": 7001143000, "chapter_id": 21143, "verse_number": "२-२-३४-१", "content_sanskrit": "ब्रह्मोवाच ।\nएवं प्रचलिते चास्मिन् वीरभद्रे गणान्विते ।\nदुष्टचिह्नानि दक्षेण दृष्टानि विबुधैरपि॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001143001, "chapter_id": 21143, "verse_number": "२-२-३४-२", "content_sanskrit": "उत्पाता विविधाश्चासन् वीरभद्रे गणान्विते ।\nत्रिविधा अपि देवर्षे यज्ञविध्वंससूचकाः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001143002, "chapter_id": 21143, "verse_number": "२-२-३४-३", "content_sanskrit": "दक्षवामाक्षिबाहूरुविस्पंदस्समजायत ।\nनानाकष्टप्रदस्तात सर्वथाऽशुभसूचकः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001143003, "chapter_id": 21143, "verse_number": "२-२-३४-४", "content_sanskrit": "भूकंपस्समभूत्तत्र दक्षयागस्थले तदा ।\nदक्षोपश्यच्च मध्याह्ने नक्षत्राण्यद्भुतानि च॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001143004, "chapter_id": 21143, "verse_number": "२-२-३४-५", "content_sanskrit": "दिशश्चासन्सुमलिनाः कर्बुरोभूद्दिवाकरः ।\nपरिवेषसहस्रेण संक्रांतश्च भयंकरः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001143005, "chapter_id": 21143, "verse_number": "२-२-३४-६", "content_sanskrit": "नक्षत्राणि पतंति स्म विद्युदग्निप्रभाणि च ।\nनक्षत्राणामभूद्वक्रा गतिश्चाधोमुखी तदा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001143006, "chapter_id": 21143, "verse_number": "२-२-३४-७", "content_sanskrit": "गृध्रा दक्ष शिरः स्पृष्ट्वा समुद्भूताः सहस्रशः ।\nआसीद्गृध्रपक्षच्छायैस्सच्छायो यागमंडपः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001143007, "chapter_id": 21143, "verse_number": "२-२-३४-८", "content_sanskrit": "ववाशिरे यागभूमौ क्रोष्टारो नेत्रकस्तदा ।\nउल्कावृष्टिरभूत्तत्र श्वेतवृश्चिकसंभवा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001143008, "chapter_id": 21143, "verse_number": "२-२-३४-९", "content_sanskrit": "खरा वाता ववुस्तत्र पांशुवृष्टिसमन्विताः ।\nशलभाश्च समुद्भूता विवर्तानिलकंपिताः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001143009, "chapter_id": 21143, "verse_number": "२-२-३४-१०", "content_sanskrit": "रीतैश्च पवनै रूर्द्ध्वं स दक्षाध्वरमंडपः ।\nदैवान्वितेन दक्षेण यः कृतो नूतनोद्भुतः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001143010, "chapter_id": 21143, "verse_number": "२-२-३४-११", "content_sanskrit": "वेमुर्दक्षादयस्सर्वे तदा शोणितमद्भुतम् ।\nवेमुश्च मांसखण्डानि सशल्यानि मुहुर्मुहुः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001143011, "chapter_id": 21143, "verse_number": "२-२-३४-१२", "content_sanskrit": "सकंपाश्च बभूवुस्ते दीपा वातहता इव ।\nदुःखिताश्चाभवन्सर्वे शस्त्रधाराहता इव॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001143012, "chapter_id": 21143, "verse_number": "२-२-३४-१३", "content_sanskrit": "तदा निनादजातानि बाष्पवर्षाणि तत्क्षणे ।\nप्रातस्तुषारवर्षीणि पद्मानीव वनांतरे॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001143013, "chapter_id": 21143, "verse_number": "२-२-३४-१४", "content_sanskrit": "दक्षाद्यक्षीणि जातानि ह्यकस्माद्विशदान्यपि ।\nनिशायां कमलाश्चैव कुमुदानीव संगवे॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001143014, "chapter_id": 21143, "verse_number": "२-२-३४-१५", "content_sanskrit": "असृग्ववर्ष देवश्च तिमिरेणावृता दिशः ।\nदिग्दाहोभूद्विशेषेण त्रासयन् सकलाञ्जनान्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001143015, "chapter_id": 21143, "verse_number": "२-२-३४-१६", "content_sanskrit": "एवं विधान्यरिष्टानि ददृशुर्विबुधादयः ।\nभयमापेदिरेऽत्यंतं मुने विष्ण्वादिकास्तदा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001143016, "chapter_id": 21143, "verse_number": "२-२-३४-१७", "content_sanskrit": "भुवि ते मूर्छिताः पेतुर्हा हताः स्म इतीरयन् ।\nतरवस्तीरसंजाता नदीवेगहता इव॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001143017, "chapter_id": 21143, "verse_number": "२-२-३४-१८", "content_sanskrit": "पतित्वा ते स्थिता भूमौ क्रूराः सर्पा हता इव ।\nकंदुका इव ते भूयः पतिताः पुनरुत्थिताः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001143018, "chapter_id": 21143, "verse_number": "२-२-३४-१९", "content_sanskrit": "ततस्ते तापसंतप्ता रुरुदुः कुररी इव ।\nरोदनध्वनिसंक्रातोरुक्तिप्रत्युक्तिका इव॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001143019, "chapter_id": 21143, "verse_number": "२-२-३४-२०", "content_sanskrit": "सवैकुंठास्ततस्सर्वे तदा कुंठितशक्तयः ।\nस्वस्वोपकंठमाकंठं लुलुठुः कमठा इव॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001143020, "chapter_id": 21143, "verse_number": "२-२-३४-२१", "content_sanskrit": "एतस्मिन्नंतरे तत्र संजाता चाशरीरवाक् ।\nश्रावयत्यखिलान् देवान्दक्षं चैव विशेषतः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001143021, "chapter_id": 21143, "verse_number": "२-२-३४-२२", "content_sanskrit": "आकाशवाण्युवाच ।\nधिक् जन्म तव दक्षाद्य महामूढोसि पापधीः ।\nभविष्यति महद्दुःखमनिवार्यं हरोद्भवम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001143022, "chapter_id": 21143, "verse_number": "२-२-३४-२३", "content_sanskrit": "हाहापि नोत्र ये मूढास्तव देवादयस्थिताः ।\nतेषामपि महादुःखं भविष्यति न संशयः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001143023, "chapter_id": 21143, "verse_number": "२-२-३४-२४", "content_sanskrit": "ब्रह्मोवाच॥ तच्छ्रुत्वाकाशवचनं दृष्ट्वारिष्टानि तानि च  ।\nदक्षः प्रापद्भयं चाति परे देवादयोपि ह॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001143024, "chapter_id": 21143, "verse_number": "२-२-३४-२५", "content_sanskrit": "वेपमानस्तदा दक्षो विकलश्चाति चेतसि ।\nअगच्छच्छरणं विष्णोः स्वप्रभोरिंदिरापतेः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001143025, "chapter_id": 21143, "verse_number": "२-२-३४-२६", "content_sanskrit": "सुप्रणम्य भयाविष्टः संस्तूय च विचेतनः ।\nअवोचद्देवदेवं तं विष्णुं स्वजनवत्सलम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]