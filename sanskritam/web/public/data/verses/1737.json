[{"id": 2034198, "chapter_id": 1737, "verse_number": "४-६०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2034199, "chapter_id": 1737, "verse_number": "४-६०-१", "content_sanskrit": "तं पार्थः प्रतिजग्राह वायुवेगमिवाचलः।\nशरजालेन महता वर्षमाण इवाम्बुदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2034200, "chapter_id": 1737, "verse_number": "४-६०-२", "content_sanskrit": "तयोर्देवासुरसमः सन्निपातो महानभूत् ।\nकिरतोः शरजालानि वृत्रवासवयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2034201, "chapter_id": 1737, "verse_number": "४-६०-३", "content_sanskrit": "न स्म सूर्यस्तदा भाति न च वाति समीरणः ।\nशरगाढे कृते व्योम्नि छायाभूतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2034202, "chapter_id": 1737, "verse_number": "४-६०-४", "content_sanskrit": "महांश्चटचटाशब्दो योधयोर्युध्यमानयोः ।\nदह्यतामिव वेणूनामासीत्परमदारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2034203, "chapter_id": 1737, "verse_number": "४-६०-५", "content_sanskrit": "हयांस्तस्यार्जुनः सङ्ख्ये कृतवानल्पतेजसाः ।\nते राजन्न प्रजानन्ति दिशं कांचन मोहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2034204, "chapter_id": 1737, "verse_number": "४-६०-६", "content_sanskrit": "ततो द्रौणिर्महावीर्यः पार्थस्य विचरिष्यतः ।\nविवरं सूक्ष्ममालोक्य ज्यां नुनोद क्षुरेण सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2034205, "chapter_id": 1737, "verse_number": "४-६०-७", "content_sanskrit": "तदस्यापूजयन्देवाः कर्म दृष्ट्वाऽतिमानुषम् ।\nन शक्तोऽन्यः पुमान्स्थातुमृते द्रौणेर्धनंजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2034206, "chapter_id": 1737, "verse_number": "४-६०-८", "content_sanskrit": "ततो द्रौणिर्धनुर्व्यस्य व्यपक्रम्य नरर्षभः ।\nपुनरप्यभ्यहन्पार्थं हृदये कङ्कपत्रिभिः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2034207, "chapter_id": 1737, "verse_number": "४-६०-९", "content_sanskrit": "ततः पार्थो महाबाहुः प्रहसन्स्वनवत्तदा।\nयोजयामास च तदा मौर्व्या गाण्डीवमोजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2034208, "chapter_id": 1737, "verse_number": "४-६०-१०", "content_sanskrit": "तं दृष्ट्वा ऋद्धमायान्तं प्रभिन्नमिव कुञ्जरम् ।\nऋद्धः समाह्वयामास द्रौणिर्युद्धाय भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2034209, "chapter_id": 1737, "verse_number": "४-६०-११", "content_sanskrit": "ततोऽर्धचन्द्रपाहृत्य तेन पार्थः समाहतः ।\nचिच्छेद तस्य चापं च सूतं चाश्वं च तेजसा ।\nविव्याध निशितैश्चापि शरैराशीविपोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2034210, "chapter_id": 1737, "verse_number": "४-६०-१२", "content_sanskrit": "सोऽन्यं रथं समास्थाय प्रत्यायाद्रथिपुङ्गवः।\nवारणेनेव मत्तेन मत्तो वारणयूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2034211, "chapter_id": 1737, "verse_number": "४-६०-१३", "content_sanskrit": "ततः प्रववृते युद्धं पृथिव्यामेकवीरयोः ।\nरणमध्ये द्वयोरेव सुमहद्रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2034212, "chapter_id": 1737, "verse_number": "४-६०-१४", "content_sanskrit": "तौ वीरौ कुरवः सर्वे ददृशुर्विस्मयान्विताः।\nयुध्यमानौ महात्मानौ द्विरदाविव संगतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2034213, "chapter_id": 1737, "verse_number": "४-६०-१५", "content_sanskrit": "तौ समाजघ्नतुर्वीरौ परस्परजयैषिणौ ।\nशरै राशीविषाकारैर्ज्वलद्भिरिव पावकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2034214, "chapter_id": 1737, "verse_number": "४-६०-१६", "content_sanskrit": "अक्षयाविषुधी दिव्यौ पाण्डवस्य महात्मनः।\nतेन पार्थो रणे शूरस्तस्थौ गिरिरिवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2034215, "chapter_id": 1737, "verse_number": "४-६०-१७", "content_sanskrit": "अश्वत्थाम्नः पुनर्बाणाः क्षिप्रमभ्यस्यतो रणे।\nजग्मुः परिक्षयं शीघ्रमभूत्तेनाधिकोऽर्जुनः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2034216, "chapter_id": 1737, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि षष्टितमोऽध्यायः ॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]