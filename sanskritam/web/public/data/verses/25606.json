[{"id": 7005606000, "chapter_id": 25606, "verse_number": "७९-१", "content_sanskrit": "मन्दारसप्तमीव्रतकथनम् ।\nईश्वर उवाच ।\nअथातः सम्प्रवक्ष्यामि सर्वपापप्रणाशिनीम् ।\nसर्वकामप्रदां रम्यां नाम्ना मन्दारसप्तमीम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005606001, "chapter_id": 25606, "verse_number": "७९-२", "content_sanskrit": "माघस्यामलपक्षे तु पञ्चम्यां लघुभुङ् नरः ।\nदन्तकाष्ठं ततः कृत्वा षष्ठीमुपवसेद्‌ बुधः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005606002, "chapter_id": 25606, "verse_number": "७९-३", "content_sanskrit": "विप्रान् सम्पूजयित्वा तु मन्दारं प्राशयेन्निशि ।\nततः प्रभाते उत्थाय कृत्वा स्नानं पुनर्द्विजान् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005606003, "chapter_id": 25606, "verse_number": "७९-४", "content_sanskrit": "भोजयेच्छक्तितः कृत्वा मन्दारकुसुमाष्टकम् ।\nसौवर्णं पुरुषं तद्वत्पद्महस्तं सुशोभनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005606004, "chapter_id": 25606, "verse_number": "७९-५", "content_sanskrit": "पद्मं कृष्णतिलैः कृत्वा ताम्रपात्रेषु पात्रकम् ।\nहैममन्दारकुसुमैर्भास्करायेति पूर्वतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005606005, "chapter_id": 25606, "verse_number": "७९-६", "content_sanskrit": "नमस्कारेण तद्वच्च सूर्य्यायेत्यानले दले ।\nदक्षिणे तद्वदर्काय तथार्यम्णेति नैर्ऋते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005606006, "chapter_id": 25606, "verse_number": "७९-७", "content_sanskrit": "पश्चिमे वेदधाम्ने च वायव्ये चण्डभानवे ।\nपूष्णेत्युत्तरतः पूज्यमानन्दायेत्यतः परम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005606007, "chapter_id": 25606, "verse_number": "७९-८", "content_sanskrit": "कर्णिकायाञ्च पुरुषं स्थाप्य सर्वात्मनेति च ।\nशुक्लवस्त्रैः समावेष्ट्य भक्ष्यैर्माल्यफलादिभिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005606008, "chapter_id": 25606, "verse_number": "७९-९", "content_sanskrit": "एवमभ्यर्च्य तत्सर्वं दद्याद्वेदविदे पुनः ।\nभुञ्जीतातैललवणं वाग्यतः प्राङ्‌मुखो गृही ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005606009, "chapter_id": 25606, "verse_number": "७९-१०", "content_sanskrit": "अनेन विधिना सर्वं सप्तम्यां मासि मासि च ।\nकुर्यात् सम्वत्सरं यावद्वित्तशाठ्यविवर्जितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005606010, "chapter_id": 25606, "verse_number": "७९-११", "content_sanskrit": "एतदेव व्रतान्ते तु निधाय कलशोपरि ।\nगोभिर्विभवतः सार्द्धं दातव्यं भूतिमिच्छता ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005606011, "chapter_id": 25606, "verse_number": "७९-१२", "content_sanskrit": "नमो मन्दारनाथाय मन्दारभवनाय च ।\nत्वं रवे! तारयस्वास्मान् संसारभयसागरात् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005606012, "chapter_id": 25606, "verse_number": "७९-१३", "content_sanskrit": "अनेन विधिना यस्तु कुर्य्यान्मन्दारसप्तमीम् ।\nविपाप्मा स सुखीमर्त्यः कल्पञ्च दिविमोदते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005606013, "chapter_id": 25606, "verse_number": "७९-१४", "content_sanskrit": "इमामघौघपटल भीषणध्वान्तदीपिकाम् ।\nगच्छन् प्रगृह्य संसारे सर्वार्थांश्च लभेन्नरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005606014, "chapter_id": 25606, "verse_number": "७९-१५", "content_sanskrit": "मन्दारसप्तमीमेतामीप्सितार्थफलप्रदाम् ।\nयः पठेच्छृगुयाद्वापि सर्वपापैः प्रमुच्यते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]