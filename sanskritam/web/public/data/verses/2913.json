[{"id": 2089448, "chapter_id": 2913, "verse_number": "१३-४३-१", "content_sanskrit": "`भगवानुवाच।\nमां न देवा न गन्धर्वा नासुरा न व राक्षसाः।\nविदुस्तत्वेन सत्वस्थं सूक्ष्मात्मानमवस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2089449, "chapter_id": 2913, "verse_number": "१३-४३-२", "content_sanskrit": "चतुर्धाऽहं विभक्तात्मा लोकानां हितकाम्यया।\nभूतभव्यभविष्यादिरनादिर्विश्वकृत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2089450, "chapter_id": 2913, "verse_number": "१३-४३-३", "content_sanskrit": "पृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम्।\nमनो बुद्धिश्च चेतश्च तमः सत्वं रजस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2089451, "chapter_id": 2913, "verse_number": "१३-४३-४", "content_sanskrit": "प्रकृतिर्विकृतिश्चैव विद्याविद्ये शुभाशुभे।\nमत्त एतानि जायन्ते नाहमेभ्यः कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2089452, "chapter_id": 2913, "verse_number": "१३-४३-५", "content_sanskrit": "यत्किंचिच्छ्रेयसा युक्तं श्रेयस्करमनुत्तमम्।\nधर्मयुक्तं च पुण्यं च सोऽहमस्मि निरामयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2089453, "chapter_id": 2913, "verse_number": "१३-४३-६", "content_sanskrit": "यत्स्वभावात्मतत्वज्ञैः कारणैरुपलक्ष्यते।\nअनादिमध्यनिधनः सोन्तरात्माऽस्मि शाश्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2089454, "chapter_id": 2913, "verse_number": "१३-४३-७", "content_sanskrit": "यत्तु मे परमं गुह्यं रूपं सूक्ष्मार्थदर्शिभिः।\nगृह्यते सूक्ष्मभावज्ञैः सोऽविभाव्योस्मि शाश्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2089455, "chapter_id": 2913, "verse_number": "१३-४३-८", "content_sanskrit": "तत्तु मे परमं गुह्यं येन व्याप्तमिदं जगत्।\nसोहङ्गतः सर्वसत्वः सर्वस्य प्रभवोऽव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2089456, "chapter_id": 2913, "verse_number": "१३-४३-९", "content_sanskrit": "मत्तो जायन्ति भूतानि मया धार्यन्त्यहर्निशम्।\nमय्येव विलयं यान्ति प्रलये पन्नगाशन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2089457, "chapter_id": 2913, "verse_number": "१३-४३-१०", "content_sanskrit": "यो मां यथा वेदयति तथा तस्यास्मि काश्यप।\nमनोबुद्धिगतः श्रेयो विदधामि विहङ्गम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2089458, "chapter_id": 2913, "verse_number": "१३-४३-११", "content_sanskrit": "मां तु ज्ञातुं कृता बुद्धिर्भवता पक्षिसत्तम।\nशृणु योऽहं यतश्चाहं यदर्थश्चाहमुद्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2089459, "chapter_id": 2913, "verse_number": "१३-४३-१२", "content_sanskrit": "ये केचिन्नियतात्मानस्त्रेताग्निपरमार्चिताः।\nअग्निकार्यपरा नित्यं जपहोमपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2089460, "chapter_id": 2913, "verse_number": "१३-४३-१३", "content_sanskrit": "आत्मन्यग्नीन्समाधाय नियता नियतेन्द्रियाः।\nअनन्यमनसस्ते मां सर्वे वै समुपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2089461, "chapter_id": 2913, "verse_number": "१३-४३-१४", "content_sanskrit": "यजन्तो जपयज्ञैर्मां मानसैश्च सुसंयताः।\nअग्नीनभ्युद्ययुः शश्वदग्निष्वेवाभिसंश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2089462, "chapter_id": 2913, "verse_number": "१३-४३-१५", "content_sanskrit": "अनन्यकार्याः शुचयो नित्यमग्निपरायणाः।\nय एवंबुद्ध्यो धीरास्ते मां गच्छन्ति तादृशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2089463, "chapter_id": 2913, "verse_number": "१३-४३-१६", "content_sanskrit": "अकामहतसङ्कल्पा ज्ञाने नित्यं समाहिताः।\nआत्मन्यग्निं समाधाय निराहारा निराशिषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2089464, "chapter_id": 2913, "verse_number": "१३-४३-१७", "content_sanskrit": "विषयेषु निरारम्भा विमुक्ता ज्ञानचक्षुषः।\nअनन्यमनसो धीराः स्वभावनियमान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2089465, "chapter_id": 2913, "verse_number": "१३-४३-१८", "content_sanskrit": "यत्तद्वियति दृष्टं तत्सरः पद्मोत्पलायुतम्।\nतत्राग्नयः सन्निहिता दीप्यन्ते स्म निरिन्धनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2089466, "chapter_id": 2913, "verse_number": "१३-४३-१९", "content_sanskrit": "ज्ञानामलाशयास्तस्मिन्ये च चन्द्रांशुनिर्मलाः।\nउपासीना गृणन्तोऽग्निमस्पष्टाक्षरभाषिणः।\nआकाङ्क्षमाणाः शुचयस्तेष्वग्रिषु विहङ्गम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2089467, "chapter_id": 2913, "verse_number": "१३-४३-२०", "content_sanskrit": "ये मया भावितात्मानो मय्येवाभिरताः सदा।\nउपासते च मामेव ज्योतिर्भूता निरामयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2089468, "chapter_id": 2913, "verse_number": "१३-४३-२१", "content_sanskrit": "तैर्हि तत्रैव वस्तव्यं नीरागादिभिरच्युतैः।\nनिराहारा ह्यनिष्पन्दाश्चन्द्रांशुसदृशप्रभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2089469, "chapter_id": 2913, "verse_number": "१३-४३-२२", "content_sanskrit": "निर्मला निरहङ्कारा निरालम्बा निराशिषः।\nमद्भक्ताः सततं तेवै भक्तांस्तानपि चाप्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2089470, "chapter_id": 2913, "verse_number": "१३-४३-२३", "content_sanskrit": "चतुर्धाऽहं विभक्तात्मा चरामि जगतो हितः।\nलोकानां धारणार्थाय विधानं विदधामि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2089471, "chapter_id": 2913, "verse_number": "१३-४३-२४", "content_sanskrit": "यथावत्तदशेषेण श्रोतुमर्हति मे भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2089472, "chapter_id": 2913, "verse_number": "१३-४३-२५", "content_sanskrit": "एका मूर्तिर्निर्गुणाख्या योगं परममास्थिता।\nद्वितीया सृजते तात भूतग्रामं चराचरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2089473, "chapter_id": 2913, "verse_number": "१३-४३-२६", "content_sanskrit": "सृष्टं संहरते चैका जगत्स्थावरजङ्गमम्।\nज्ञातात्मनिष्ठा क्षपयन्मोहयन्तीव मायया।\nक्षपयन्ती मोहयति आत्मनिष्ठा स्वमायया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2089474, "chapter_id": 2913, "verse_number": "१३-४३-२७", "content_sanskrit": "चतुर्थी मे महामूर्तिर्जगद्वृद्धिं ददाति सा।\nरक्षते चापि नियता सोहमस्मि नभश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2089475, "chapter_id": 2913, "verse_number": "१३-४३-२८", "content_sanskrit": "मया सर्वमिदं व्याप्तं मयि सर्वं प्रतिष्ठितम्।\nअहं सर्वजगद्बीजं सर्वत्रगतिरव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2089476, "chapter_id": 2913, "verse_number": "१३-४३-२९", "content_sanskrit": "यानि तान्यग्निहोत्राणि ये च चन्द्रांशुराशयः।\nगृणन्ति वेदं सततं तेष्वग्निषु विहङ्गम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2089477, "chapter_id": 2913, "verse_number": "१३-४३-३०", "content_sanskrit": "क्रमेण मां समायान्ति सुखिनो ज्ञानसंयुताः।\nतेषामहं तपो दीप्तं तेजः सम्यक्समाहितम्।\nनित्यं ते मयि वर्तन्ते तेषु चाहमतन्द्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2089478, "chapter_id": 2913, "verse_number": "१३-४३-३१", "content_sanskrit": "सर्वतो मुक्तसङ्गेन मय्यनन्यसमाधिना।\nशक्यः समासादयितुमहं वै ज्ञानचक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2089479, "chapter_id": 2913, "verse_number": "१३-४३-३२", "content_sanskrit": "मां स्थूलदर्शनं विद्धि जगतः कार्यकारणम्।\nमत्तश्च सम्प्रसूतान्वै विद्धि लोकान्सदैवतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2089480, "chapter_id": 2913, "verse_number": "१३-४३-३३", "content_sanskrit": "मया चापि चतुर्धात्मा विभक्तः प्राणिषु स्यिथः।\nआत्मभूतो वासुदेवो ह्यनिरुद्धो मतौ स्यितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2089481, "chapter_id": 2913, "verse_number": "१३-४३-३४", "content_sanskrit": "सङ्कर्षणोऽहङ्कारे च प्रद्युम्नो मनसि स्यितः।\nअन्यथा च चतुर्दा यत्सम्यक्त्वं श्रोतुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2089482, "chapter_id": 2913, "verse_number": "१३-४३-३५", "content_sanskrit": "यत्तत्पद्ममभूत्पूर्वं तत्र ब्रह्मा व्यजायत।\nब्राह्मणश्चापि सम्भूतः शिव इत्यवधार्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2089483, "chapter_id": 2913, "verse_number": "१३-४३-३६", "content_sanskrit": "शिवात्स्कन्दः संवभूव एतत्सृष्टिचतुष्टयम्।\nदैत्यदानवदर्पघ्नमेवं मां विद्धि नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2089484, "chapter_id": 2913, "verse_number": "१३-४३-३७", "content_sanskrit": "दैत्यदानवरक्षोभिर्यदा धर्मः प्रपीड्यते।\nतदाऽहं धर्मवृद्ध्यर्थं मूर्तिमान्भविताऽऽशुग॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2089485, "chapter_id": 2913, "verse_number": "१३-४३-३८", "content_sanskrit": "वेदव्रतपरा ये तु धीरा निश्चितबुद्ध्यः।\nयोगिनो योगयुक्ताश्च ते मां पश्यन्ति नान्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2089486, "chapter_id": 2913, "verse_number": "१३-४३-३९", "content_sanskrit": "पञ्चभिः सम्प्रयुक्तोऽहं विप्रयुक्तश्च पञ्चभिः।\nवर्तमानश्च तेष्वेवं निवृत्तश्चैव तेष्वहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2089487, "chapter_id": 2913, "verse_number": "१३-४३-४०", "content_sanskrit": "ये विदुर्जातसङ्कल्पास्ते मां पश्यन्ति तादृशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2089488, "chapter_id": 2913, "verse_number": "१३-४३-४१", "content_sanskrit": "स्वं वायुरापो ज्योतिश्च पृथिवी चेति पञ्चमम्।\nतदात्मकोऽस्मि विज्ञेयो न चान्योस्मीति निश्चितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2089489, "chapter_id": 2913, "verse_number": "१३-४३-४२", "content_sanskrit": "वर्तमानमतीतं च पञ्चवर्गेषु निश्चलम्।\nशब्दस्पर्शेषु रूपेषु रसगन्धेषु चाप्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2089490, "chapter_id": 2913, "verse_number": "१३-४३-४३", "content_sanskrit": "रजस्तमोभ्यामाविष्टा येषां बुद्धिरनिश्चिता।\nते न पश्यन्ति मे तत्वं तपसा महता ह्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2089491, "chapter_id": 2913, "verse_number": "१३-४३-४४", "content_sanskrit": "नोपवासैर्न नियमैर्न व्रतैर्विविधैरपि।\nद्रष्टुं वा वेदितुं वाऽपि न शक्या परमा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2089492, "chapter_id": 2913, "verse_number": "१३-४३-४५", "content_sanskrit": "महामोहार्थपङ्के तु निमग्रानां गतिर्हरिः।\nएकान्तिनो ध्यानपरा यतिभावाद्ब्रजन्ति माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2089493, "chapter_id": 2913, "verse_number": "१३-४३-४६", "content_sanskrit": "सत्वयुक्ता मतिर्येषां केवलाऽऽत्मविनिश्चिता।\nते पश्यन्ति स्वमात्मानं परमात्मानमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2089494, "chapter_id": 2913, "verse_number": "१३-४३-४७", "content_sanskrit": "अहिंसा सर्वभूतेषु तेष्ववस्तितमार्जवम्।\nतेष्वेव च समाधाय सम्यगेति च मामजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2089495, "chapter_id": 2913, "verse_number": "१३-४३-४८", "content_sanskrit": "यदेतत्परमं गुह्यमाख्यानं परमाद्भुतम्।\nयत्तेन तदशेषेण यथावच्छ्रोतुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2089496, "chapter_id": 2913, "verse_number": "१३-४३-४९", "content_sanskrit": "ये त्वग्निहोत्रनियता जपयज्ञपरायणाः।\nते मामुपासते शश्वद्यांस्तांस्त्वं दृष्टवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2089497, "chapter_id": 2913, "verse_number": "१३-४३-५०", "content_sanskrit": "शास्त्रदृष्टविधानज्ञा असक्ताः क्वचिदन्यथा।\nशक्योऽहं वेदितुं तैस्तु यन्मे परममव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2089498, "chapter_id": 2913, "verse_number": "१३-४३-५१", "content_sanskrit": "ये तु सांख्यं च योगं च ज्ञात्वाऽप्यधृतनिश्चयाः।\nन ते गच्छन्ति कुशलाः परां गतिमनुत्तमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2089499, "chapter_id": 2913, "verse_number": "१३-४३-५२", "content_sanskrit": "तस्माज्ज्ञानेन शुद्धेन प्रसन्नात्माऽऽन्मविच्छुचिः।\nआसादयति तद्ब्रह्म यत्र गत्वा न शोचति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2089500, "chapter_id": 2913, "verse_number": "१३-४३-५३", "content_sanskrit": "शुद्धाभिजनसम्पन्नाः श्रद्धायुक्तेन चेतसा।\nमद्भक्त्या च द्विजश्रेष्ठा गच्छन्ति परमां गतिं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2089501, "chapter_id": 2913, "verse_number": "१३-४३-५४", "content_sanskrit": "यद्गह्यं परमं बुद्धेरलिङ्गग्रहणं च यत्।\nतत्सूक्ष्मं गृह्यते विप्रैर्यतिभिस्तत्त्वदर्शिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2089502, "chapter_id": 2913, "verse_number": "१३-४३-५५", "content_sanskrit": "न वायुः पवते तत्र न तस्मिञ्ज्योतिषां गतिः।\nन चापः पृथिवी चैव नाकाशं न मनोगतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2089503, "chapter_id": 2913, "verse_number": "१३-४३-५६", "content_sanskrit": "तस्माच्चैतानि सर्वाणि प्रजायन्ते विहङ्गम।\nसर्वेभ्यश्च स तेभ्यश्च प्रभवत्यमलो विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2089504, "chapter_id": 2913, "verse_number": "१३-४३-५७", "content_sanskrit": "स्थूलदर्शनमेतन्मे यद्दृष्टं भवताऽनघ।\nएतत्सूक्ष्मस्य तद्द्वारं कार्याणां कारणं त्वहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2089505, "chapter_id": 2913, "verse_number": "१३-४३-५८", "content_sanskrit": "दृष्टो वै भवता तस्मात्सरस्यमितविक्रम।\nब्रह्मणो यदहोरात्रसङ्ख्याभिज्ञैर्विभाव्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2089506, "chapter_id": 2913, "verse_number": "१३-४३-५९", "content_sanskrit": "एष कालस्त्वया तत्र सरस्यहमुपागतः।\nमां यज्ञमाहुर्यज्ञज्ञा वेदं वेदविदो जनाः।\nमुनयश्चापि मामेव जपयज्ञं प्रचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2089507, "chapter_id": 2913, "verse_number": "१३-४३-६०", "content_sanskrit": "वक्ता मन्ता रसयिता घ्राता द्रष्टा प्रदर्शकः।\nबोद्धा बोधयिता चाहं गन्ता श्रोता चिदात्मकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2089508, "chapter_id": 2913, "verse_number": "१३-४३-६१", "content_sanskrit": "मामिष्ट्वा स्वर्गमायान्ति तथा चाप्नुवते महत्।\nज्ञात्वा मामेव चैवान्ते निःसङ्गेनान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2089509, "chapter_id": 2913, "verse_number": "१३-४३-६२", "content_sanskrit": "अहं तेजो द्विजातीनां मम तेजो द्विजातयः।\nमम यस्तेजसो देहः सोग्निरित्यवगम्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2089510, "chapter_id": 2913, "verse_number": "१३-४३-६३", "content_sanskrit": "प्राणपालः शरीरेऽहं योगिनामहमीश्वरः।\nसांख्यानामिदमेवाग्रे मयि सर्वमिदं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2089511, "chapter_id": 2913, "verse_number": "१३-४३-६४", "content_sanskrit": "धर्ममर्तं च कामं च मोक्षं चैवार्जवं जपम्।\nतमः सत्वं रजश्चैव कर्मजं च भवाप्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2089512, "chapter_id": 2913, "verse_number": "१३-४३-६५", "content_sanskrit": "स तदाऽहं तथारूपस्त्वया दृष्टः सनातनः।\nततस्त्वहं परतरः शक्यः कालेन वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2089513, "chapter_id": 2913, "verse_number": "१३-४३-६६", "content_sanskrit": "मम यत्परमं गुह्यं शाश्वतं ध्रुवमव्ययम्।\nतदेवं परमो गुह्यो देवो नारायणो हरिः।\nन तच्छक्यं भुजङ्गारे वेत्तुमभ्युदयान्वितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2089514, "chapter_id": 2913, "verse_number": "१३-४३-६७", "content_sanskrit": "निरारम्भनमस्कारा निराशीर्बन्धनास्तथा।\nगच्छन्ति तं महात्मानः परं ब्रह्म सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2089515, "chapter_id": 2913, "verse_number": "१३-४३-६८", "content_sanskrit": "स्थूलोऽहमेवं विहग त्वया दृष्टस्तथाऽनघ।\nएतच्चापि न वेत्त्यन्यस्त्वामृते पन्नगाशन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2089516, "chapter_id": 2913, "verse_number": "१३-४३-६९", "content_sanskrit": "मा मतिस्तव गान्नाशमेषा गतिरनुत्तमा।\nमद्भक्तो भव नित्यं त्वं ततो वेत्स्यसि मे पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2089517, "chapter_id": 2913, "verse_number": "१३-४३-७०", "content_sanskrit": "एतत्ते सर्वमाख्यातं रहस्यं दिव्यमानुषम्।\nएतच्छ्रेयः परं चैतत्पन्थानं विद्धि मोक्षिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2089518, "chapter_id": 2913, "verse_number": "१३-४३-७१", "content_sanskrit": "एवमुक्त्वा स भगवांस्तत्रैवान्तरधीयत।\nपश्यतो मे महायोगी जगामात्मगतिर्गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2089519, "chapter_id": 2913, "verse_number": "१३-४३-७२", "content_sanskrit": "एतदेवंविधं तस्य महिमानं महात्मनः।\nअच्युतस्याप्रमेयस्य दृष्टवानस्मि यत्पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2089520, "chapter_id": 2913, "verse_number": "१३-४३-७३", "content_sanskrit": "एतद्वः सर्वमाख्यातं चेष्टितं तस्य धीमतः।\nमयाऽनुभूतं प्रत्यक्षं दृष्ट्वा चाद्भुतकर्मणः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2089521, "chapter_id": 2913, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रिचत्वारिंशोऽध्यायः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]