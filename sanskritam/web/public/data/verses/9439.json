[{"id": 5000439000, "chapter_id": 9439, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे द्वात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000439001, "chapter_id": 9439, "verse_number": "६-३२-१", "content_sanskrit": "सा सीता तच्छिरो दृष्ट्वा तच्च कार्मुकमुत्तमम्।\nसुग्रीवप्रतिसंसर्गमाख्यातं च हनूमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000439002, "chapter_id": 9439, "verse_number": "६-३२-२", "content_sanskrit": "नयने मुखवर्णं च भर्तुस्तत्सदृशं मुखम्।\nकेशान् केशान्तदेशं च तं च चूडामणिं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000439003, "chapter_id": 9439, "verse_number": "६-३२-३", "content_sanskrit": "एतैः सर्वैरभिज्ञानैरभिज्ञाय सुदुःखिता।\nविजगर्हेऽत्र कैकेयीं क्रोशन्ती कुररी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000439004, "chapter_id": 9439, "verse_number": "६-३२-४", "content_sanskrit": "सकामा भव कैकेयि हतोऽयं कुलनन्दनः।\nकुलमुत्सादितं सर्वं त्वया कलहशीलया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000439005, "chapter_id": 9439, "verse_number": "६-३२-५", "content_sanskrit": "आर्येण किं नु कैकेय्याः कृतं रामेण विप्रियम्।\nयन्मया चीरवसनं दत्त्वा प्रव्राजितो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000439006, "chapter_id": 9439, "verse_number": "६-३२-६", "content_sanskrit": "एवमुक्त्वा तु वैदेही वेपमाना तपस्विनी।\nजगाम जगतीं बाला छिन्ना तु कदली यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000439007, "chapter_id": 9439, "verse_number": "६-३२-७", "content_sanskrit": "सा मुहूर्तात् समाश्वस्य परिलभ्याथ चेतनाम्।\nतच्छिरः समुपास्थाय विललापायतेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000439008, "chapter_id": 9439, "verse_number": "६-३२-८", "content_sanskrit": "हा हतास्मि महाबाहो वीरव्रतमनुव्रत।\nइमां ते पश्चिमावस्थां गतास्मि विधवा कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000439009, "chapter_id": 9439, "verse_number": "६-३२-९", "content_sanskrit": "प्रथमं मरणं नार्या भर्तुर्वैगुण्यमुच्यते।\nसुवृत्तः साधुवृत्तायाः संवृत्तस्त्वं ममाग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000439010, "chapter_id": 9439, "verse_number": "६-३२-१०", "content_sanskrit": "महद् दुःखं प्रपन्नाया मग्नायाः शोकसागरे।\nयो हि मामुद्यतस्त्रातुं सोऽपि त्वं विनिपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000439011, "chapter_id": 9439, "verse_number": "६-३२-११", "content_sanskrit": "सा श्वश्रूर्मम कौसल्या त्वया पुत्रेण राघव।\nवत्सेनेव यथा धेनुर्विवत्सा वत्सला कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000439012, "chapter_id": 9439, "verse_number": "६-३२-१२", "content_sanskrit": "उद्दिष्टं दीर्घमायुस्ते दैवज्ञैरपि राघव।\nअनृतं वचनं तेषामल्पायुरसि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000439013, "chapter_id": 9439, "verse_number": "६-३२-१३", "content_sanskrit": "अथवा नश्यति प्रज्ञा प्राज्ञस्यापि सतस्तव।\nपचत्येनं तथा कालो भूतानां प्रभवो ह्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000439014, "chapter_id": 9439, "verse_number": "६-३२-१४", "content_sanskrit": "अदृष्टं मृत्युमापन्नः कस्मात् त्वं नयशास्त्रवित्।\nव्यसनानामुपायज्ञः कुशलो ह्यसि वर्जने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000439015, "chapter_id": 9439, "verse_number": "६-३२-१५", "content_sanskrit": "तथा त्वं सम्परिष्वज्य रौद्रयातिनृशंसया।\nकालरात्र्या ममाच्छिद्य हृतः कमललोचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000439016, "chapter_id": 9439, "verse_number": "६-३२-१६", "content_sanskrit": "इह शेषे महाबाहो मां विहाय तपस्विनीम्।\nप्रियामिव यथा नारीं पृथिवीं पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000439017, "chapter_id": 9439, "verse_number": "६-३२-१७", "content_sanskrit": "अर्चितं सततं यत्नाद् गन्धमाल्यैर्मया तव।\nइदं ते मत्प्रियं वीर धनुः काञ्चनभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000439018, "chapter_id": 9439, "verse_number": "६-३२-१८", "content_sanskrit": "पित्रा दशरथेन त्वं श्वशुरेण ममानघ।\nसर्वैश्च पितृभिः सार्धं नूनं स्वर्गे समागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000439019, "chapter_id": 9439, "verse_number": "६-३२-१९", "content_sanskrit": "दिवि नक्षत्रभूतं च महत्कर्मकृतं तथा।\nपुण्यं राजर्षिवंशं त्वमात्मनः समुपेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000439020, "chapter_id": 9439, "verse_number": "६-३२-२०", "content_sanskrit": "किं मां न प्रेक्षसे राजन् किं वा न प्रतिभाषसे।\nबालां बालेन सम्प्राप्तां भार्यां मां सहचारिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000439021, "chapter_id": 9439, "verse_number": "६-३२-२१", "content_sanskrit": "संश्रुतं गृह्णता पाणिं चरिष्यामीति यत् त्वया।\nस्मर तन्नाम काकुत्स्थ नय मामपि दुःखिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000439022, "chapter_id": 9439, "verse_number": "६-३२-२२", "content_sanskrit": "कस्मान्मामपहाय त्वं गतो गतिमतां वर।\nअस्माल्लोकादमुं लोकं त्यक्त्वा मामपि दुःखिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000439023, "chapter_id": 9439, "verse_number": "६-३२-२३", "content_sanskrit": "कल्याणै रुचिरं गात्रं परिष्वक्तं मयैव तु।\nक्रव्यादैस्तच्छरीरं ते नूनं विपरिकृष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000439024, "chapter_id": 9439, "verse_number": "६-३२-२४", "content_sanskrit": "अग्निष्टोमादिभिर्यज्ञैरिष्टवानाप्तदक्षिणैः।\nअग्निहोत्रेण संस्कारं केन त्वं न तु लप्स्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000439025, "chapter_id": 9439, "verse_number": "६-३२-२५", "content_sanskrit": "प्रव्रज्यामुपपन्नानां त्रयाणामेकमागतम्।\nपरिप्रेक्ष्यति कौसल्या लक्ष्मणं शोकलालसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000439026, "chapter_id": 9439, "verse_number": "६-३२-२६", "content_sanskrit": "स तस्याः परिपृच्छन्त्या वधं मित्रबलस्य ते।\nतव चाख्यास्यते नूनं निशायां राक्षसैर्वधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000439027, "chapter_id": 9439, "verse_number": "६-३२-२७", "content_sanskrit": "सा त्वां सुप्तं हतं ज्ञात्वा मां च रक्षोगृहं गताम्।\nहृदयेनावदीर्णेन न भविष्यति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000439028, "chapter_id": 9439, "verse_number": "६-३२-२८", "content_sanskrit": "मम हेतोरनार्याया अनघः पार्थिवात्मजः।\nरामः सागरमुत्तीर्य वीर्यवान् गोष्पदे हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000439029, "chapter_id": 9439, "verse_number": "६-३२-२९", "content_sanskrit": "अहं दाशरथेनोढा मोहात् स्वकुलपांसनी।\nआर्यपुत्रस्य रामस्य भार्या मृत्युरजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000439030, "chapter_id": 9439, "verse_number": "६-३२-३०", "content_sanskrit": "नूनमन्यां मया जातिं वारितं दानमुत्तमम्।\nयाहमद्यैव शोचामि भार्या सर्वातिथेरिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000439031, "chapter_id": 9439, "verse_number": "६-३२-३१", "content_sanskrit": "साधु घातय मां क्षिप्रं रामस्योपरि रावण।\nसमानय पतिं पत्न्या कुरु कल्याणमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000439032, "chapter_id": 9439, "verse_number": "६-३२-३२", "content_sanskrit": "शिरसा मे शिरश्चास्य कायं कायेन योजय।\nरावणानुगमिष्यामि गतिं भर्तुर्महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000439033, "chapter_id": 9439, "verse_number": "६-३२-३३", "content_sanskrit": "इतीव दुःखसंतप्ता विललापायतेक्षणा।\nभर्तुः शिरो धनुश्चैव ददर्श जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000439034, "chapter_id": 9439, "verse_number": "६-३२-३४", "content_sanskrit": "एवं लालप्यमानायां सीतायां तत्र राक्षसः।\nअभिचक्राम भर्तारमनीकस्थः कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000439035, "chapter_id": 9439, "verse_number": "६-३२-३५", "content_sanskrit": "विजयस्वार्यपुत्रेति सोऽभिवाद्य प्रसाद्य च।\nन्यवेदयदनुप्राप्तं प्रहस्तं वाहिनीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000439036, "chapter_id": 9439, "verse_number": "६-३२-३६", "content_sanskrit": "अमात्यैः सहितः सर्वैः प्रहस्तस्त्वामुपस्थितः।\nतेन दर्शनकामेन अहं प्रस्थापितः प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000439037, "chapter_id": 9439, "verse_number": "६-३२-३७", "content_sanskrit": "नूनमस्ति महाराज राजभावात् क्षमान्वित।\nकिंचिदात्ययिकं कार्यं तेषां त्वं दर्शनं कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000439038, "chapter_id": 9439, "verse_number": "६-३२-३८", "content_sanskrit": "एतच्छ्रुत्वा दशग्रीवो राक्षसप्रतिवेदितम्।\nअशोकवनिकां त्यक्त्वा मन्त्रिणां दर्शनं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000439039, "chapter_id": 9439, "verse_number": "६-३२-३९", "content_sanskrit": "स तु सर्वं समर्थ्यैव मन्त्रिभिः कृत्यमात्मनः।\nसभां प्रविश्य विदधे विदित्वा रामविक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000439040, "chapter_id": 9439, "verse_number": "६-३२-४०", "content_sanskrit": "अन्तर्धानं तु तच्छीर्षं तच्च कार्मुकमुत्तमम्।\nजगाम रावणस्यैव निर्याणसमनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000439041, "chapter_id": 9439, "verse_number": "६-३२-४१", "content_sanskrit": "राक्षसेन्द्रस्तु तैः सार्धं मन्त्रिभिर्भीमविक्रमैः।\nसमर्थयामास तदा रामकार्यविनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000439042, "chapter_id": 9439, "verse_number": "६-३२-४२", "content_sanskrit": "अविदूरस्थितान् सर्वान् बलाध्यक्षान् हितैषिणः।\nअब्रवीत् कालसदृशं रावणो राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000439043, "chapter_id": 9439, "verse_number": "६-३२-४३", "content_sanskrit": "शीघ्रं भेरीनिनादेन स्फुटं कोणाहतेन मे।\nसमानयध्वं सैन्यानि वक्तव्यं च न कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000439044, "chapter_id": 9439, "verse_number": "६-३२-४४", "content_sanskrit": "ततस्तथेति प्रतिगृह्य तद्वच-\nस्तदैव दूताः सहसा महद् बलम्।\nसमानयंश्चैव समागतं च\nन्यवेदयन् भर्तरि युद्धकाङ्क्षिणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000439045, "chapter_id": 9439, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे द्वात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]