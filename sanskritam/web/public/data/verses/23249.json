[{"id": 7003249000, "chapter_id": 23249, "verse_number": "१-५२-१", "content_sanskrit": "सूत उवाच  ।\nनद्यश्च बहवः प्रोक्ता सदा बहुजलाः शुभाः  ।\nसरोवरेभ्यः संभूतास्त्वसंख्याता द्विजोत्तमाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003249001, "chapter_id": 23249, "verse_number": "१-५२-२", "content_sanskrit": "प्राङ्मुखा दक्षिणास्यास्तु चोत्तरप्रभवाः शुभाः  ।\nपश्चिमाग्राः पवित्राश्च प्रतिवर्षं प्रकीर्तिताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003249002, "chapter_id": 23249, "verse_number": "१-५२-३", "content_sanskrit": "आकाशांभोनिधिर्योसौ सोम इत्यभिधीयते  ।\nआधारः सर्वभूतानां देवानाममृताकरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003249003, "chapter_id": 23249, "verse_number": "१-५२-४", "content_sanskrit": "अस्मात्प्रवृत्ता पुण्योदा नदी त्वाकाश गामिनी  ।\nसप्तमेनानिलपथा प्रवृत्ता चामृतोदका ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003249004, "chapter_id": 23249, "verse_number": "१-५२-५", "content_sanskrit": "सा ज्योतिंष्यनुवर्तन्ती ज्योतिर्गणनिषोविता  ।\nताराकोटिसहस्राणां नभसश्च समायुता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003249005, "chapter_id": 23249, "verse_number": "१-५२-६", "content_sanskrit": "परिवर्तत्यहरहो यथा सोमस्तथैव सा  ।\nचत्वार्यशीतिश्च तथा सहस्राणां समुच्छ्रितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003249006, "chapter_id": 23249, "verse_number": "१-५२-७", "content_sanskrit": "योजनानां महामेरुः श्रीकंठाक्रीडकोमलः  ।\nतत्रासीनो यतः शर्वः सांबः सह गणेश्वरैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003249007, "chapter_id": 23249, "verse_number": "१-५२-८", "content_sanskrit": "क्रीडते सुचिरं कालं तस्मात्पुण्यजला शिवा  ।\nगिरिं मेरुं नदी पुण्या सा प्रयाति प्रदक्षिणम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003249008, "chapter_id": 23249, "verse_number": "१-५२-९", "content_sanskrit": "विभज्यमानसलिला सा जवेनानिलेन च  ।\nमेरोरंतरकूटेषु निपपात चतुर्ष्वपि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003249009, "chapter_id": 23249, "verse_number": "१-५२-१०", "content_sanskrit": "समंतात्समतिक्रम्य सर्वाद्रीन्प्रविभागशः  ।\nनियोगाद्देवदेवस्य प्रविष्टा सा महार्णवम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003249010, "chapter_id": 23249, "verse_number": "१-५२-११", "content_sanskrit": "अस्या विनिर्गता नद्यः शतशोथ सहस्रशः  ।\nसर्वद्वीपाद्रिवर्षेषु बहवः परिकीर्तिताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003249011, "chapter_id": 23249, "verse_number": "१-५२-१२", "content_sanskrit": "क्षुद्रनद्यस्त्वसंख्याता गंगा यद्गां गताम्बरात्  ।\nकेतुमाले नराः कालाः सर्वे पनसभोजनाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003249012, "chapter_id": 23249, "verse_number": "१-५२-१३", "content_sanskrit": "स्त्रियश्चोत्पलवर्णाभा जीवितं चायुतं स्मृतम्  ।\nभद्राश्वे शुक्लवर्णाश्च स्त्रियश्चन्द्रांशु सन्निभाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003249013, "chapter_id": 23249, "verse_number": "१-५२-१४", "content_sanskrit": "कालाम्रभोजनाः सर्वे निरातंका रतिप्रियाः  ।\nदशवर्षसहस्राणि जीवंति शिवभाविताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003249014, "chapter_id": 23249, "verse_number": "१-५२-१५", "content_sanskrit": "हिरण्मया इवात्यर्थमीश्वरार्पितचेतसः  ।\nतथा रमणके जीवा न्यग्रोधफलभोजनाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003249015, "chapter_id": 23249, "verse_number": "१-५२-१६", "content_sanskrit": "दशवर्षसहस्राणि शतानि दशपंच च  ।\nजीवंति शुक्लास्ते सर्वे शिवध्यानपरायणाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003249016, "chapter_id": 23249, "verse_number": "१-५२-१७", "content_sanskrit": "हैरण्मया महाभागा हिरण्मयवनाश्रयाः  ।\nएकादश सहस्राणि शतानि दशपंच च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003249017, "chapter_id": 23249, "verse_number": "१-५२-१८", "content_sanskrit": "वर्षाणां तत्र जीवंति अश्वत्थाशनजीवनाः  ।\nहैरण्मया इवात्यर्थमीश्वरार्पितमानसाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003249018, "chapter_id": 23249, "verse_number": "१-५२-१९", "content_sanskrit": "कुरुवर्षे तु कुरवः स्वर्गलोकात्परीच्युताः  ।\nसर्वे मैथुन जाताश्च क्षीरिणः क्षीरभोजनाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003249019, "chapter_id": 23249, "verse_number": "१-५२-२०", "content_sanskrit": "अन्योन्यमनुरक्ताश्च चक्रवाकसधर्मिणः  ।\nअनामया ह्यशोकाश्च नित्यं सुखनिषेविणः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003249020, "chapter_id": 23249, "verse_number": "१-५२-२१", "content_sanskrit": "त्रयोदश सहस्राणि शतानि दशपंच च  ।\nजीवंति ते महावीर्या न चान्यस्त्रीनिषेविणः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003249021, "chapter_id": 23249, "verse_number": "१-५२-२२", "content_sanskrit": "सहैव मरणं तेषां कुरूणां स्वर्गवासिनाम्  ।\nहृष्टानां सुप्रवृद्धानां सर्वान्नामृतभोजिनाम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003249022, "chapter_id": 23249, "verse_number": "१-५२-२३", "content_sanskrit": "सदा तु चंद्रकान्तानां सदा योवनशालिनाम्  ।\nश्यामांगानां सदा सर्वभूषणास्पददेहिनाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003249023, "chapter_id": 23249, "verse_number": "१-५२-२४", "content_sanskrit": "जंबूद्वीपे तु तत्रापि कुरुवर्षं सुशोभनम्  ।\nतत्र चन्द्रप्रभं शम्भोर्विमानं चंद्रमौलिनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003249024, "chapter_id": 23249, "verse_number": "१-५२-२५", "content_sanskrit": "वर्षे तु भारते मर्त्याः पुण्याः कर्मवशायुषः  ।\nशतायुषः समाख्याता नानावर्णाल्पदेहिनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003249025, "chapter_id": 23249, "verse_number": "१-५२-२६", "content_sanskrit": "नानादेवर्चने युक्ता नानाकर्मफलाशिनः  ।\nनानाज्ञानार्थसंपन्ना दुर्बलाश्चाल्पभोगिनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003249026, "chapter_id": 23249, "verse_number": "१-५२-२७", "content_sanskrit": "इंद्रद्वीपे तथा केचित्तथैव च कसेरुके  ।\nताम्रद्वीपं गताः केचित्कोचिद्देशं गभस्तिमत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003249027, "chapter_id": 23249, "verse_number": "१-५२-२८", "content_sanskrit": "नागद्वीपं तता सौम्यं गांधर्वं वारुणं गताः  ।\nकेचिन्म्लेच्छाः पुलिंदाश्च नानाजातिसमुद्भवाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003249028, "chapter_id": 23249, "verse_number": "१-५२-२९", "content_sanskrit": "पूर्वे किरातास्तस्यांते पश्चिमे यवनाः स्मृताः  ।\nब्राह्मणाः क्षत्रिया वैश्या मध्ये शूद्राश्च सर्वशः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003249029, "chapter_id": 23249, "verse_number": "१-५२-३०", "content_sanskrit": "इज्यायुद्धवणिज्याभिर्वर्तयंतो व्यवस्थिताः  ।\nतेषां संव्यवहारोयं वर्ततेऽत्र परस्परम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003249030, "chapter_id": 23249, "verse_number": "१-५२-३१", "content_sanskrit": "धर्मार्थकामसंयुक्तो वर्णानां तु स्वकर्मसु  ।\nसंकल्पश्चाभिमानश्च आश्रमाणां यथाविधि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003249031, "chapter_id": 23249, "verse_number": "१-५२-३२", "content_sanskrit": "इह स्वर्गापवर्गार्थं प्रवृत्तिर्यत्र मानुषी  ।\nतेषां च युगकर्माणि नान्यत्र मुनिपुंगवाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003249032, "chapter_id": 23249, "verse_number": "१-५२-३३", "content_sanskrit": "दशवर्षसहस्राणि स्थितिः किंपुरुषे नृणाम्  ।\nसुवर्णवर्णाश्च नरास्त्रियश्चाप्सरसोपमाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003249033, "chapter_id": 23249, "verse_number": "१-५२-३४", "content_sanskrit": "अनामया ह्यशोकाश्च सर्वे ते शिवभाविताः  ।\nशुद्धसत्त्वाश्च हेमाभाः सदाराः प्लक्षभोजनाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003249034, "chapter_id": 23249, "verse_number": "१-५२-३५", "content_sanskrit": "महारजतसंकाशा हरिवर्षेपि मानवाः  ।\nदेवलोकाच्च्युताः सर्वे देवाकाराश्च सर्वशः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003249035, "chapter_id": 23249, "verse_number": "१-५२-३६", "content_sanskrit": "हरं यजंति सर्वेशं पिबंतीक्षुरसं शुभम्  ।\nन जरा बाधते तेन न च जीर्यांति ते नराः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003249036, "chapter_id": 23249, "verse_number": "१-५२-३७", "content_sanskrit": "दशवर्षसहस्राणि तत्र जीवांति मानवाः  ।\nमध्यमं यन्मया प्रोक्तं नाम्ना वर्षमिलावृतम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003249037, "chapter_id": 23249, "verse_number": "१-५२-३८", "content_sanskrit": "न तत्र सूर्यस्तपति न ते जीर्यंति मानवाः  ।\nचंद्रसूर्यौ न नक्षत्रं जीवंति मानवाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003249038, "chapter_id": 23249, "verse_number": "१-५२-३९", "content_sanskrit": "पद्मप्रभाः पद्म मुखाः पद्मपत्रनिभेक्षणाः  ।\nपद्मपत्रसुगंधाश्च जायंते भवभाविताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003249039, "chapter_id": 23249, "verse_number": "१-५२-४०", "content_sanskrit": "जंबूफलरसाहारा अनिष्पन्दाः सुगंधिनः  ।\nदेवलोकागतास्तत्र जायंते ह्यजरामराः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003249040, "chapter_id": 23249, "verse_number": "१-५२-४१", "content_sanskrit": "त्रयोदशसहस्राणि वर्षाणां ते नरोत्तमाः  ।\nआयुःप्रमाणं जीवंति वर्षे दिव्ये त्विलावृते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003249041, "chapter_id": 23249, "verse_number": "१-५२-४२", "content_sanskrit": "जंबूफलरसं पीत्वा न जरा बाधते त्विमान्  ।\nन क्षुधा न क्लमश्चापि न जनो मृत्यु मांस्तथा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003249042, "chapter_id": 23249, "verse_number": "१-५२-४३", "content_sanskrit": "तत्र जाम्बूनदं नाम कनकं देवभूषणम्  ।\nइंद्रगोपप्रतीकाशं जायते भास्वरं तु तत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003249043, "chapter_id": 23249, "verse_number": "१-५२-४४", "content_sanskrit": "एवं मया समाख्याता नववर्षानुवर्तिनः  ।\nवर्णायुर्भोजनाद्यानि संक्षिप्य न तु विस्तरात् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003249044, "chapter_id": 23249, "verse_number": "१-५२-४५", "content_sanskrit": "हेमकूटे तु गंधर्वा विज्ञेयाश्चाप्सरोगणाः  ।\nसर्वे नागाश्च निषघे शेषवासुकितक्षकाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003249045, "chapter_id": 23249, "verse_number": "१-५२-४६", "content_sanskrit": "महाबलास्त्रयस्त्रिंशद्रमंते याज्ञिकाः सुराः  ।\nनीले तु वैडूर्यमये सिद्धा ब्रह्मर्षयोऽमलाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003249046, "chapter_id": 23249, "verse_number": "१-५२-४७", "content_sanskrit": "दैत्यानां दानवानां च श्वेतः पर्वत उच्यते  ।\nश्रृंगवान् पर्वतश्चैव पितॄणां निलयः सदा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003249047, "chapter_id": 23249, "verse_number": "१-५२-४८", "content_sanskrit": "हिमवान् यक्षमुख्यानां भूतानामिश्वरस्य च  ।\nसर्वाद्रिषु महादेवो हरिणा ब्रह्मणांबया ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003249048, "chapter_id": 23249, "verse_number": "१-५२-४९", "content_sanskrit": "नंदिना च गणैश्चैव वर्षेषु च वनेषु च  ।\nनीलश्वेतत्रिश्रृंगे च भगवान्नीललोहितः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003249049, "chapter_id": 23249, "verse_number": "१-५२-५०", "content_sanskrit": "सिद्धैर्देवैश्च पितृभिर्दृष्टो नित्यं विशेषतः  ।\nनीलश्च वैडूर्यमयः श्वेतः शुक्लो हिरण्मयः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003249050, "chapter_id": 23249, "verse_number": "१-५२-५१", "content_sanskrit": "मयूरबर्हवर्णस्तु शातकुंभस्त्रिश्रृंगवान्  ।\nएते पर्वतराजानो जंबूद्वीपे व्यवस्थिताः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]