[{"id": 7001132000, "chapter_id": 21132, "verse_number": "२-२-२३-१", "content_sanskrit": "ब्रह्मोवाच ।\nएवं कृत्वा विहारं वै शंकरेण च सा सती ।\nसंतुष्टा साभवच्चाति विरागा समजायत॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001132001, "chapter_id": 21132, "verse_number": "२-२-२३-२", "content_sanskrit": "एकस्मिन्दिवसे देवी सती रहसि संगता ।\nशिवं प्रणम्य सद्भक्त्या न्यस्योच्चैः सुकृतांजलिः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001132002, "chapter_id": 21132, "verse_number": "२-२-२३-३", "content_sanskrit": "सुप्रसन्नं प्रभुं नत्वा सा दक्षतनया सती ।\nउवाच सांजलिर्भक्त्या विनयावनता ततः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001132003, "chapter_id": 21132, "verse_number": "२-२-२३-४", "content_sanskrit": "सत्युवाच ।\nदेवदेव महादेव करुणा सागर प्रभो ।\nदीनोद्धर महायोगिन् कृपां कुरु ममोपरि॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001132004, "chapter_id": 21132, "verse_number": "२-२-२३-५", "content_sanskrit": "त्वं परः पुरुषस्स्वामी रजस्सत्त्वतमः परः ।\nनिर्गुणस्सगुणस्साक्षी निर्विकारी महाप्रभुः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001132005, "chapter_id": 21132, "verse_number": "२-२-२३-६", "content_sanskrit": "धन्याहं ते प्रिया जाता कामिनी सुविहारिणी ।\nजातस्त्वं मे पतिस्स्वामिन्भक्तिवात्सल्यतो हर॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001132006, "chapter_id": 21132, "verse_number": "२-२-२३-७", "content_sanskrit": "कृतो बहुसमा नाथ विहारः परमस्त्वया ।\nसंतुष्टाहं महेशान निवृत्तं मे मनस्ततः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001132007, "chapter_id": 21132, "verse_number": "२-२-२३-८", "content_sanskrit": "ज्ञातुमिच्छामि देवेश परं तत्त्वं सुखावहम् ।\nयं न संसारदुःखाद्वै तरेज्जीवोंजसा हर॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001132008, "chapter_id": 21132, "verse_number": "२-२-२३-९", "content_sanskrit": "यत्कृत्वा विषयी जीवस्स लभेत्परमं पदम् ।\nसंसारी न भवेन्नाथ तत्त्वं वद कृपां कुरु॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001132009, "chapter_id": 21132, "verse_number": "२-२-२३-१०", "content_sanskrit": "ब्रह्मोवाच ।\nइत्यपृच्छत्स्म सद्भक्त्या शंकरं सा सती मुने ।\nआदिशक्तिर्महेशानी जीवोद्धाराय केवलम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001132010, "chapter_id": 21132, "verse_number": "२-२-२३-११", "content_sanskrit": "आकर्ण्य तच्छिवः स्वामी स्वेच्छयोपात्तविग्रहः ।\nअवोचत्परमप्रीतस्सतीं योगविरक्तधीः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001132011, "chapter_id": 21132, "verse_number": "२-२-२३-१२", "content_sanskrit": "॥ शिव उवाच  ।\nशृणु देवि प्रवक्ष्यामि दाक्षायणि महेश्वरि ।\nपरं तत्त्वं तदेवानुशयी मुक्तो भवेद्यतः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001132012, "chapter_id": 21132, "verse_number": "२-२-२३-१३", "content_sanskrit": "परतत्त्वं विजानीहि विज्ञानं परमेश्वरी ।\nद्वितीयं स्मरणं यत्र नाहं ब्रह्मेति शुद्धधीः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001132013, "chapter_id": 21132, "verse_number": "२-२-२३-१४", "content_sanskrit": "तद्दुर्लभं त्रिलोकेस्मिंस्तज्ज्ञाता विरलः प्रिये ।\nयादृशो यस्सदासोहं ब्रह्मसाक्षात्परात्परः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001132014, "chapter_id": 21132, "verse_number": "२-२-२३-१५", "content_sanskrit": "तन्माता मम भक्तिश्च भुक्तिमुक्तिफलप्रदा ।\nसुलभा मत्प्रसादाद्धि नवधा सा प्रकीर्तिता॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001132015, "chapter_id": 21132, "verse_number": "२-२-२३-१६", "content_sanskrit": "भक्तौ ज्ञाने न भेदो हि तत्कर्तुस्सर्वदा सुखम् ।\nविज्ञानं न भवत्येव सति भक्तिविरोधिनः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001132016, "chapter_id": 21132, "verse_number": "२-२-२३-१७", "content_sanskrit": "भक्त्या हीनस्सदाहं वै तत्प्रभावाद्गृहेष्वपि ।\nनीचानां जातिहीनानां यामि देवि न संशयः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001132017, "chapter_id": 21132, "verse_number": "२-२-२३-१८", "content_sanskrit": "सा भक्तिर्द्विविधा देवि सगुणा निर्गुणा मता ।\nवैधी स्वाभाविकी या या वरा सा त्ववरा स्मृता॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001132018, "chapter_id": 21132, "verse_number": "२-२-२३-१९", "content_sanskrit": "नैष्ठिक्या नैष्ठिकी भेदाद्द्विविधे द्विविधे हि ते ।\nषड्विधा नैष्ठिकी ज्ञेया द्वितीयैकविधा स्मृता॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001132019, "chapter_id": 21132, "verse_number": "२-२-२३-२०", "content_sanskrit": "विहिताविहिताभेदात्तामनेकां विदुर्बुधाः ।\nतयोर्बहुविधत्वाच्च तत्त्वं त्वन्यत्र वर्णितम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001132020, "chapter_id": 21132, "verse_number": "२-२-२३-२१", "content_sanskrit": "ते नवांगे उभे ज्ञेये वर्णिते मुनिभिः प्रिये ।\nवर्णयामि नवांगानि प्रेमतः शृणु दक्षजे॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001132021, "chapter_id": 21132, "verse_number": "२-२-२३-२२", "content_sanskrit": "श्रवणं कीर्तनं चैव स्मरणं सेवनं तथा ।\nदास्यं तथार्चनं देवि वंदनं मम सर्वदा॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001132022, "chapter_id": 21132, "verse_number": "२-२-२३-२३", "content_sanskrit": "सख्यमात्मार्पणं चेति नवांगानि विदुर्बुधाः ।\nउपांगानि शिवे तस्या बहूनि कथितानि वै॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001132023, "chapter_id": 21132, "verse_number": "२-२-२३-२४", "content_sanskrit": "शृणु देवि नवांगानां लक्षणानि पृथक्पृथक् ।\nमम भक्तेर्मनो दत्त्वा भक्ति मुक्तिप्रदानि हि॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001132024, "chapter_id": 21132, "verse_number": "२-२-२३-२५", "content_sanskrit": "कथादेर्नित्यसम्मानं कुर्वन्देहादिभिर्मुदा ।\nस्थिरासनेन तत्पानं यत्तच्छ्रवणमुच्यते॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001132025, "chapter_id": 21132, "verse_number": "२-२-२३-२६", "content_sanskrit": "हृदाकाशेन संपश्यञ् जन्मकर्माणि वै मम ।\nप्रीत्याचोच्चारणं तेषामेतत्कीर्तनमुच्यते॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001132026, "chapter_id": 21132, "verse_number": "२-२-२३-२७", "content_sanskrit": "व्यापकं देवि मां दृष्ट्वा नित्यं सर्वत्र सर्वदा ।\nनिर्भयत्वं सदा लोके स्मरणं तदुदाहृतम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001132027, "chapter_id": 21132, "verse_number": "२-२-२३-२८", "content_sanskrit": "अरुणोदयमारभ्य सेवाकालेंचिता हृदा ।\nनिर्भयत्वं सदा लोके स्मरणं तदुदाहृतम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001132028, "chapter_id": 21132, "verse_number": "२-२-२३-२९", "content_sanskrit": "सदा सेव्यानुकूल्येन सेवनं तद्धि गोगणैः ।\nहृदयामृतभोगेन प्रियं दास्यमुदाहृतम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001132029, "chapter_id": 21132, "verse_number": "२-२-२३-३०", "content_sanskrit": "सदा भृत्यानुकूल्येन विधिना मे परात्मने ।\nअर्पणं षोडशानां वै पाद्यादीनां तदर्चनम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001132030, "chapter_id": 21132, "verse_number": "२-२-२३-३१", "content_sanskrit": "मंत्रोच्चारणध्यानाभ्यां मनसा वचसा क्रमात् ।\nयदष्टांगेन भूस्पर्शं तद्वै वंदनमुच्यते॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001132031, "chapter_id": 21132, "verse_number": "२-२-२३-३२", "content_sanskrit": "मंगलामंगलं यद्यत्करोतीतीश्वरो हि मे ।\nसर्वं तन्मंगलायेति विश्वासः सख्यलक्षणम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001132032, "chapter_id": 21132, "verse_number": "२-२-२३-३३", "content_sanskrit": "कृत्वा देहादिकं तस्य प्रीत्यै सर्वं तदर्पणम् ।\nनिर्वाहाय च शून्यत्वं यत्तदात्मसमर्पणम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001132033, "chapter_id": 21132, "verse_number": "२-२-२३-३४", "content_sanskrit": "नवांगानीति मद्भक्तेर्भुक्तिमुक्तिप्रदानि च ।\nमम प्रियाणि चातीव ज्ञानोत्पत्तिकराणि च॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001132034, "chapter_id": 21132, "verse_number": "२-२-२३-३५", "content_sanskrit": "उपांगानि च मद्भक्तेर्बहूनि कथितानि वै ।\nबिल्वादिसेवनादीनि समू ह्यानि विचारतः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001132035, "chapter_id": 21132, "verse_number": "२-२-२३-३६", "content_sanskrit": "इत्थं सांगोपांगभक्तिर्मम सर्वोत्तमा प्रिये ।\nज्ञानवैराग्यजननी मुक्तिदासी विराजते॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001132036, "chapter_id": 21132, "verse_number": "२-२-२३-३७", "content_sanskrit": "सर्वकर्मफलोत्पत्तिस्सर्वदा त्वत्समप्रिया ।\nयच्चित्ते सा स्थिता नित्यं सर्वदा सोति मत्प्रियः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001132037, "chapter_id": 21132, "verse_number": "२-२-२३-३८", "content_sanskrit": "त्रैलोक्ये भक्तिसदृशः पंथा नास्ति सुखावहः ।\nचतुर्युगेषु देवेशि कलौ तु सुविशेषतः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001132038, "chapter_id": 21132, "verse_number": "२-२-२३-३९", "content_sanskrit": "कलौ तु ज्ञानवैरागो वृद्धरूपौ निरुत्सवौ ।\nग्राहकाभावतो देवि जातौ जर्जर तामति॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001132039, "chapter_id": 21132, "verse_number": "२-२-२३-४०", "content_sanskrit": "कलौ प्रत्यक्षफलदा भक्तिस्सर्वयुगेष्वपि ।\nतत्प्रभावादहं नित्यं तद्वशो नात्र संशयः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001132040, "chapter_id": 21132, "verse_number": "२-२-२३-४१", "content_sanskrit": "यो भक्तिमान्पुमांल्लोके सदाहं तत्सहायकृत् ।\nविघ्नहर्ता रिपुस्तस्य दंड्यो नात्र च संशयः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001132041, "chapter_id": 21132, "verse_number": "२-२-२३-४२", "content_sanskrit": "भक्तहेतोरहं देवि कालं क्रोधपरिप्लुतः ।\nअदहं वह्निना नेत्रभवेन निजरक्षकः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001132042, "chapter_id": 21132, "verse_number": "२-२-२३-४३", "content_sanskrit": "भक्तहेतोरहं देवि रव्युपर्यभवं किल ।\nअतिक्रोधान्वितः शूलं गृहीत्वाऽन्वजयं पुरा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001132043, "chapter_id": 21132, "verse_number": "२-२-२३-४४", "content_sanskrit": "भक्तहेतोरहं देवि रावणं सगणं क्रुधा ।\nत्यजति स्म कृतो नैव पक्षपातो हि तस्य वै॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001132044, "chapter_id": 21132, "verse_number": "२-२-२३-४५", "content_sanskrit": "भक्तहेतोरहं देवि व्यासं हि कुमतिग्रहम् ।\nकाश्या न्यसारयत् क्रोधाद्दण्डयित्वा च नंदिना॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001132045, "chapter_id": 21132, "verse_number": "२-२-२३-४६", "content_sanskrit": "किं बहूक्तेन देवेशि भक्त्याधीनस्सदा ह्यहम् ।\nतत्कर्तुं पुरुषस्यातिवशगो नात्र संशयः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001132046, "chapter_id": 21132, "verse_number": "२-२-२३-४७", "content_sanskrit": "ब्रह्मोवाच ।\nइत्थमाकर्ण्य भक्तेस्तु महत्त्वं दक्षजा सती ।\nजहर्षातीव मनसि प्रणनाम शिवं मुदा॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001132047, "chapter_id": 21132, "verse_number": "२-२-२३-४८", "content_sanskrit": "पुनः पप्रच्छ सद्भक्त्या तत्काण्डविषयं मुने ।\nशास्त्रं सुखकरं लोके जीवोद्धारपरायणम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001132048, "chapter_id": 21132, "verse_number": "२-२-२३-४९", "content_sanskrit": "सयंत्रमंत्रशास्त्रं च तन्माहात्म्यं विशेषतः ।\nअन्यानि धर्मवस्तूनि जीवोद्धारकराणि हि॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001132049, "chapter_id": 21132, "verse_number": "२-२-२३-५०", "content_sanskrit": "शंकरोपि तदाकर्ण्य सतीं प्रश्नं प्रहृष्टधीः ।\nवर्णयामास सुप्रीत्या जीवोद्धाराय कृत्स्नशः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001132050, "chapter_id": 21132, "verse_number": "२-२-२३-५१", "content_sanskrit": "तत्र शास्त्रं सयंत्रं हि सपंचाङ्गं महेश्वरः ।\nबभाषे महिमानं च तत्तद्दैववरस्य वै॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001132051, "chapter_id": 21132, "verse_number": "२-२-२३-५२", "content_sanskrit": "सेतिहासकथं तेषां भक्तमाहात्म्यमेव च ।\nसवर्णाश्रमधर्मांश्च नृपधर्मान् मुनीश्वर॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001132052, "chapter_id": 21132, "verse_number": "२-२-२३-५३", "content_sanskrit": "सुतस्त्रीधर्ममाहात्म्यं वर्णाश्रममनश्वरम् ।\nवैद्यशास्त्रं तथा ज्योतिश्शास्त्रं जीवसुखावहम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001132053, "chapter_id": 21132, "verse_number": "२-२-२३-५४", "content_sanskrit": "सामुद्रिकं परं शास्त्रमन्यच्छास्त्राणि भूरिशः ।\nकृपां कृत्वा महे शानो वर्णयामास तत्त्वतः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001132054, "chapter_id": 21132, "verse_number": "२-२-२३-५५", "content_sanskrit": "इत्थं त्रिलोकसुखदौ सर्वज्ञौ च सतीशिवौ ।\nलोकोपकारकरणधृतसद्गुणविग्रहौ॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001132055, "chapter_id": 21132, "verse_number": "२-२-२३-५६", "content_sanskrit": "चिक्रीडाते बहुविधे कैलासे हिमवद्गिरौ ।\nअन्यस्थलेषु च तदा परब्रह्मस्वरूपिणौ॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]