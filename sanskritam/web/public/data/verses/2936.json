[{"id": 2091153, "chapter_id": 2936, "verse_number": "१३-६६-१", "content_sanskrit": "युधिष्ठिर उवाच।\nके पूज्या वै त्रिलोकेऽस्मिन्मानवा भरतर्पभ।\nविस्तरेण तदाचक्ष्व न हि तृप्यामि कथ्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091154, "chapter_id": 2936, "verse_number": "१३-६६-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091155, "chapter_id": 2936, "verse_number": "१३-६६-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nनारदस्य च संवादं वासुदेवस्य चोभयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091156, "chapter_id": 2936, "verse_number": "१३-६६-३", "content_sanskrit": "नारदं प्राञ्जलिं दृष्ट्वा पूजयानं द्विजर्षभान्।\nकेशवः परिपप्रच्छ भगवन्क्रान्नमस्यमि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091157, "chapter_id": 2936, "verse_number": "१३-६६-४", "content_sanskrit": "बहुमानपरस्तेषु भगवन्यान्नमस्यसि।\nशक्यं चेच्छ्रोतुमस्माभिर्ब्रूह्येतद्धर्मवित्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091158, "chapter_id": 2936, "verse_number": "१३-६६-५x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091159, "chapter_id": 2936, "verse_number": "१३-६६-५", "content_sanskrit": "शृणु गोविन्द यानेतान्पूजयाम्यरिमर्दन।\nत्वत्तोऽन्यः कः पुमाँल्लोके श्रोतुमेतदिहार्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091160, "chapter_id": 2936, "verse_number": "१३-६६-६", "content_sanskrit": "वरुणं वायुमादित्यं पर्जन्यं जातवेदसम्।\nस्थाणु स्कन्दं महालक्ष्मीं विष्णुं ब्रह्माणमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091161, "chapter_id": 2936, "verse_number": "१३-६६-७", "content_sanskrit": "वाचस्पतिं चन्द्रमसमपः पृथ्वीं सरस्वतीम्।\nसततं ये नमस्यन्ति तान्नमस्याम्यहं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091162, "chapter_id": 2936, "verse_number": "१३-६६-८", "content_sanskrit": "तपोधनान्वेदविदो नित्यं वेदपरायणान्।\nमहार्हान्वृष्णिशार्दूल सदा सम्पूजयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091163, "chapter_id": 2936, "verse_number": "१३-६६-९", "content_sanskrit": "अभुक्त्वा देवकार्याणि कुर्वते येऽविकत्थनाः।\nसन्तुष्टाश्च क्षमायुक्तास्तान्नमस्याम्यहं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091164, "chapter_id": 2936, "verse_number": "१३-६६-१०", "content_sanskrit": "सम्यग्यजन्ति ये चेष्टीः क्षान्ता दान्ता जितेन्द्रियाः।\nसत्यं धर्मं क्षितिं गाश्च तान्नमस्यामि यादव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091165, "chapter_id": 2936, "verse_number": "१३-६६-११", "content_sanskrit": "ये वै तपसि वर्तन्ते वने मूलफलाशनाः।\nअसञ्चयाः क्रियावन्तस्तान्नमस्यामि यादव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091166, "chapter_id": 2936, "verse_number": "१३-६६-१२", "content_sanskrit": "ये भृत्यभरणे शक्ताः सततं चातिथिव्रताः।\nभुञ्जते देवशेषाणि तान्नमस्यामि यादव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091167, "chapter_id": 2936, "verse_number": "१३-६६-१३", "content_sanskrit": "ये वेद प्राप्य दुर्धर्षा वाग्मिनो ब्रह्मचारिणः।\nयाजनाध्यापने युक्ता नित्यं तान्पूजयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091168, "chapter_id": 2936, "verse_number": "१३-६६-१४", "content_sanskrit": "प्रसन्नहृदयाश्चैव सर्वसत्वेषु नित्यशः।\nअपृष्ठतापान्स्वाध्याये युक्तास्तान्पूजयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091169, "chapter_id": 2936, "verse_number": "१३-६६-१५", "content_sanskrit": "गुरुप्रसादे स्वाध्याये यतन्तो ये स्थिरव्रताः।\nशुश्रूषवोऽनसूयन्तस्तान्नमस्यामि यादव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091170, "chapter_id": 2936, "verse_number": "१३-६६-१६", "content_sanskrit": "सुव्रता मुनयो ये च ब्राह्मणाः सत्यसङ्गराः।\nवोढारो हव्यकव्यानां तान्नमस्यामि यादव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091171, "chapter_id": 2936, "verse_number": "१३-६६-१७", "content_sanskrit": "भैक्षचर्यासु निरताः कृशा गुरुकुलाश्रयाः।\nनिःसुखा निर्धना ये तु तान्नमस्यामि यादव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091172, "chapter_id": 2936, "verse_number": "१३-६६-१८", "content_sanskrit": "निर्ममा निष्प्रतिद्वन्द्वा निष्ठिता निष्प्रयोजनाः।\nये वेदं प्राप्य दुर्धर्षा वाग्मिनो ब्रह्मवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091173, "chapter_id": 2936, "verse_number": "१३-६६-१९", "content_sanskrit": "अहिंसानिरता ये च ये च सत्यव्रता नराः।\nदान्ताः शमपराश्चैव तान्नमस्यामि केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091174, "chapter_id": 2936, "verse_number": "१३-६६-२०", "content_sanskrit": "देवतातिथिपूजायां युक्ता ये गृहमेधिनः।\nकपोतवृत्तयो नित्यं तान्नमस्यामि यादव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091175, "chapter_id": 2936, "verse_number": "१३-६६-२१", "content_sanskrit": "येषां त्रिवर्गः कृत्येषु वर्तते नोपहीयते।\nशिष्टाचारप्रवृत्ताश्च तान्नमस्याम्यहं सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2091176, "chapter_id": 2936, "verse_number": "१३-६६-२२", "content_sanskrit": "ब्राह्मणाः श्रुतसम्पन्ना ये त्रिवर्गमनुष्ठिताः।\nअलोलुपाः पुण्यशीलास्तान्नमस्यामि केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2091177, "chapter_id": 2936, "verse_number": "१३-६६-२३", "content_sanskrit": "`अवन्ध्यकाला येऽलुब्धास्त्रिवर्गे साधनेषु च।\nविशिष्टाचारयुक्ताश्च नारायण नमामि तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2091178, "chapter_id": 2936, "verse_number": "१३-६६-२४", "content_sanskrit": "अब्भक्षा वायुभक्षाश्चक सुधाभक्षाश्च ये सदा।\nव्रतैश्च विविधैर्युक्तास्तान्नमस्यामि माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2091179, "chapter_id": 2936, "verse_number": "१३-६६-२५", "content_sanskrit": "अयोनीनग्नियोनींश्च ब्रह्मयोनींस्तथैव च।\nसर्वभूतात्मयोनींश्च तान्नमस्याम्यहं सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2091180, "chapter_id": 2936, "verse_number": "१३-६६-२६", "content_sanskrit": "नित्यमेतान्नमस्यामि कृष्ण लोककरानृषीन्।\nलोकज्येष्ठान्कुलज्येष्ठांस्तमोघ्नँल्लोकभास्करान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2091181, "chapter_id": 2936, "verse_number": "१३-६६-२७", "content_sanskrit": "तस्मात्त्वमपि वार्ष्णेय द्विजान्पूजय नित्यदा।\nपूजिताः पूजनार्हा हि सुखं दास्यन्ति तेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2091182, "chapter_id": 2936, "verse_number": "१३-६६-२८", "content_sanskrit": "अस्मिँल्लोके सदा ह्येते परत्र च सुखप्रदाः।\nचरन्ते मान्यमाना वै प्रदास्यन्ति सुखं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2091183, "chapter_id": 2936, "verse_number": "१३-६६-२९", "content_sanskrit": "ये सर्वातिथयो नित्यं गोषु च ब्राह्मणेषु च।\nनित्यं सत्ये चाभिरता दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2091184, "chapter_id": 2936, "verse_number": "१३-६६-३०", "content_sanskrit": "नित्यं शमपरा ये च तथा ये चानसूयकाः।\nनित्यस्वाध्यायिनो ये च दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2091185, "chapter_id": 2936, "verse_number": "१३-६६-३१", "content_sanskrit": "सर्वान्देवान्नमस्यन्ति य चैकं वेदमाश्रिताः।\nश्रद्दधानाश्च दान्ताश्च दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2091186, "chapter_id": 2936, "verse_number": "१३-६६-३२", "content_sanskrit": "तथैव विप्रप्रवरान्नमस्कृत्य यतव्रताः।\nभवन्ति ये दानरता दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2091187, "chapter_id": 2936, "verse_number": "१३-६६-३३", "content_sanskrit": "तपस्विनश्च ये नित्यं कौमारब्रह्मचारिणः।\nतपसा भावितात्मानो दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2091188, "chapter_id": 2936, "verse_number": "१३-६६-३४", "content_sanskrit": "देवतातिथिभृत्यानां पितॄणां चार्चने रताः।\nशिष्टान्नभोजिनो ये च दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2091189, "chapter_id": 2936, "verse_number": "१३-६६-३५", "content_sanskrit": "अग्निमाधाय विधिवत्प्रणता धारयन्ति ये।\nप्राप्तः सोमाहुतिं चैव दुर्गाण्यतितरन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2091190, "chapter_id": 2936, "verse_number": "१३-६६-३६", "content_sanskrit": "मातापित्रोर्गुरुषु च सम्यग्वर्तन्ति ये सदा।\nयथा त्वं वृष्णिशार्दूलेत्युक्त्वैवं विरराम सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2091191, "chapter_id": 2936, "verse_number": "१३-६६-३७", "content_sanskrit": "तस्मात्त्वमपि कौन्तेय पितृदेवद्विजातिथीन्।\nसम्यक्पूजयसे नित्यं गतिमिष्टामवाप्स्यसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2091192, "chapter_id": 2936, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षट्षष्टितमोऽध्यायः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]