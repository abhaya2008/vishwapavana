[{"id": 5000014000, "chapter_id": 9014, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे चतुर्दशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000014001, "chapter_id": 9014, "verse_number": "१-१४-१", "content_sanskrit": "अथ संवत्सरे पूर्णे तस्मिन् प्राप्ते तुरङ्गमे ।\nसरय्वाश्चोत्तरे तीरे राज्ञो यज्ञोऽभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000014002, "chapter_id": 9014, "verse_number": "१-१४-२", "content_sanskrit": "ऋष्यशृङ्गं पुरस्कृत्य कर्म चक्रुर्द्विजर्षभाः ।\nअश्वमेधे महायज्ञे राज्ञोऽस्य सुमहात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000014003, "chapter_id": 9014, "verse_number": "१-१४-३", "content_sanskrit": "कर्म कुर्वन्ति विधिवद् याजका वेदपारगाः ।\nयथाविधि यथान्यायं परिक्रामन्ति शास्त्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000014004, "chapter_id": 9014, "verse_number": "१-१४-४", "content_sanskrit": "प्रवर्ग्यं शास्त्रतः कृत्वा तथैवोपसदं द्विजाः ।\nचक्रुश्च विधिवत् सर्वमधिकं कर्म शास्त्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000014005, "chapter_id": 9014, "verse_number": "१-१४-५", "content_sanskrit": "अभिपूज्य ततो हृष्टाः सर्वे चक्रुर्यथाविधि ।\nप्रातःसवनपूर्वाणि कर्माणि मुनिपुङ्गवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000014006, "chapter_id": 9014, "verse_number": "१-१४-६", "content_sanskrit": "ऐन्द्रश्च विधिवत् दत्तो राजा चाभिषुतोऽनघः ।\nमध्यन्दिनं च सवनं प्रावर्तत यथाक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000014007, "chapter_id": 9014, "verse_number": "१-१४-७", "content_sanskrit": "तृतीयसवनं चैव राज्ञोऽस्य सुमहात्मनः ।\nचक्रुस्ते शास्त्रतो दृष्ट्वा यथा ब्राह्मणपुङ्गवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000014008, "chapter_id": 9014, "verse_number": "१-१४-८", "content_sanskrit": "आह्वायाञ्चक्रिरे तत्र शक्रादीन् विबुधोत्तमान् ।\nऋष्यशृङ्गादयो मन्त्रैः शिक्षाक्षरसमन्वितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000014009, "chapter_id": 9014, "verse_number": "१-१४-९", "content_sanskrit": "गीतिभिर्मधुरैः स्निग्धैर्मन्त्राह्वानैर्यथार्हतः ।\nहोतारो ददुरावाह्य हविर्भागान् दिवौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000014010, "chapter_id": 9014, "verse_number": "१-१४-१०", "content_sanskrit": "न चाहुतमभूत् तत्र स्खलितं वा न किञ्चन ।\nदृश्यते ब्रह्मवत् सर्वं क्षेमयुक्तं हि चक्रिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000014011, "chapter_id": 9014, "verse_number": "१-१४-११", "content_sanskrit": "न तेष्वहःसु श्रान्तो वा क्षुधितो वा न दृश्यते ।\nनाविद्वान् ब्राह्मणः कश्चिन्नाशतानुचरस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000014012, "chapter_id": 9014, "verse_number": "१-१४-१२", "content_sanskrit": "ब्राह्मणा भुञ्जते नित्यं नाथवन्तश्च भुञ्जते ।\nतापसा भुञ्जते चापि श्रमणाश्चैव भुञ्जते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000014013, "chapter_id": 9014, "verse_number": "१-१४-१३", "content_sanskrit": "वृद्धाश्च व्याधिताश्चैव स्त्रीबालाश्च तथैव च ।\nअनिशं भुञ्जमानानां न तृप्तिरुपलभ्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000014014, "chapter_id": 9014, "verse_number": "१-१४-१४", "content_sanskrit": "दीयतां दीयतामन्नं वासांसि विविधानि च ।\nइति संचोदितास्तत्र तथा चक्रुरनेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000014015, "chapter_id": 9014, "verse_number": "१-१४-१५", "content_sanskrit": "अन्नकूटाश्च दृश्यन्ते बहवः पर्वतोपमाः ।\nदिवसे दिवसे तत्र सिद्धस्य विधिवत् तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000014016, "chapter_id": 9014, "verse_number": "१-१४-१६", "content_sanskrit": "नानादेशादनुप्राप्ताः पुरुषाः स्त्रीगणास्तथा ।\nअन्नपानैः सुविहितास्तस्मिन् यज्ञे महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000014017, "chapter_id": 9014, "verse_number": "१-१४-१७", "content_sanskrit": "अन्नं हि विधिवत्स्वादु प्रशंसन्ति द्विजर्षभाः ।\nअहो तृप्ताः स्म भद्रं ते इति शुश्राव राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000014018, "chapter_id": 9014, "verse_number": "१-१४-१८", "content_sanskrit": "स्वलंकृताश्च पुरुषा ब्राह्मणान् पर्यवेषयन् ।\nउपासन्ते च तानन्ये सुमृष्टमणिकुण्डलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000014019, "chapter_id": 9014, "verse_number": "१-१४-१९", "content_sanskrit": "कर्मान्तरे तदा विप्रा हेतुवादान् बहूनपि ।\nप्राहुः सुवाग्मिनो धीराः परस्परजिगीषया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000014020, "chapter_id": 9014, "verse_number": "१-१४-२०", "content_sanskrit": "दिवसे दिवसे तत्र संस्तरे कुशला द्विजाः ।\nसर्वकर्माणि चक्रुस्ते यथाशास्त्रं प्रचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000014021, "chapter_id": 9014, "verse_number": "१-१४-२१", "content_sanskrit": "नाषडङ्गविदत्रासीन्नाव्रतो नाबहुश्रुतः ।\nसदस्यास्तस्य वै राज्ञो नावादकुशलो द्विजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000014022, "chapter_id": 9014, "verse_number": "१-१४-२२", "content_sanskrit": "प्राप्ते यूपोच्छ्रये तस्मिन् षड् बैल्वाः खादिरास्तथा ।\nतावन्तो बिल्वसहिताः पर्णिनश्च तथा परे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000014023, "chapter_id": 9014, "verse_number": "१-१४-२३", "content_sanskrit": "श्लेष्मातकमयो दिष्टो देवदारुमयस्तथा ।\nद्वावेव तत्र विहितौ बाहुव्यस्तपरिग्रहौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000014024, "chapter_id": 9014, "verse_number": "१-१४-२४", "content_sanskrit": "कारिताः सर्व एवैते शास्त्रज्ञैर्यज्ञकोविदैः ।\nशोभार्थं तस्य यज्ञस्य काञ्चनालंकृता भवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000014025, "chapter_id": 9014, "verse_number": "१-१४-२५", "content_sanskrit": "एकविंशतियूपास्ते एकविंशत्यरत्नयः ।\nवासोभिरेकविंशद्भिरेकैकं समलंकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000014026, "chapter_id": 9014, "verse_number": "१-१४-२६", "content_sanskrit": "विन्यस्ता विधिवत् सर्वे शिल्पिभिः सुकृता दृढाः ।\nअष्टाश्रयः सर्व एव श्लक्ष्णरूपसमन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000014027, "chapter_id": 9014, "verse_number": "१-१४-२७", "content_sanskrit": "आच्छादितास्ते वासोभिः पुष्पैर्गन्धैश्च पूजिताः ।\nसप्तर्षयो दीप्तिमन्तो विराजन्ते यथा दिवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000014028, "chapter_id": 9014, "verse_number": "१-१४-२८", "content_sanskrit": "इष्टकाश्च यथान्यायं कारिताश्च प्रमाणतः ।\nचितोऽग्निर्ब्राह्मणैस्तत्र कुशलैः शुल्बकर्मणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000014029, "chapter_id": 9014, "verse_number": "१-१४-२९", "content_sanskrit": "स चित्यो राजसिंहस्य संचितः कुशलैर्द्विजैः ।\nगरुडो रुक्मपक्षो वै त्रिगुणोऽष्टादशात्मकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000014030, "chapter_id": 9014, "verse_number": "१-१४-३०", "content_sanskrit": "नियुक्तास्तत्र पशवस्तत्तदुद्दिश्य दैवतम् ।\nउरगाः पक्षिणश्चैव यथाशास्त्रं प्रचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000014031, "chapter_id": 9014, "verse_number": "१-१४-३१", "content_sanskrit": "शामित्रे तु हयस्तत्र तथा जलचराश्च ये ।\nऋषिभिः सर्वमेवैतन्नियुक्तं शास्त्रतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000014032, "chapter_id": 9014, "verse_number": "१-१४-३२", "content_sanskrit": "पशूनां त्रिशतं तत्र यूपेषु नियतं तदा ।\nअश्वरत्नोत्तमं तत्र राज्ञो दशरथस्य ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000014033, "chapter_id": 9014, "verse_number": "१-१४-३३", "content_sanskrit": "कौसल्या तं हयं तत्र परिचर्य समन्ततः ।\nकृपाणैर्विससारैनं त्रिभिः परमया मुदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000014034, "chapter_id": 9014, "verse_number": "१-१४-३४", "content_sanskrit": "पतत्रिणा तदा सार्धं सुस्थितेन च चेतसा ।\nअवसद् रजनीमेकां कौसल्या धर्मकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000014035, "chapter_id": 9014, "verse_number": "१-१४-३५", "content_sanskrit": "होताध्वर्युस्तथोद्गाता हस्तेन समयोजयन् ।\nमहिष्या परिवृत्त्याथ वावातामपरां तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000014036, "chapter_id": 9014, "verse_number": "१-१४-३६", "content_sanskrit": "पतत्रिणस्तस्य वपामुद्धृत्य नियतेन्द्रियः ।\nऋत्विक्परमसम्पन्नः श्रपयामास शास्त्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000014037, "chapter_id": 9014, "verse_number": "१-१४-३७", "content_sanskrit": "धूमगन्धं वपायास्तु जिघ्रति स्म नराधिपः ।\nयथाकालं यथान्यायं निर्णुदन् पापमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000014038, "chapter_id": 9014, "verse_number": "१-१४-३८", "content_sanskrit": "हयस्य यानि चाङ्गानि तानि सर्वाणि ब्राह्मणाः ।\nअग्नौ प्रास्यन्ति विधिवत् समस्ताः षोडशर्त्विजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000014039, "chapter_id": 9014, "verse_number": "१-१४-३९", "content_sanskrit": "प्लक्षशाखासु यज्ञानामन्येषां क्रियते हविः ।\nअश्वमेधस्य चैकस्य वैतसो भाग इष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000014040, "chapter_id": 9014, "verse_number": "१-१४-४०", "content_sanskrit": "त्र्यहोऽश्वमेधः संख्यातः कल्पसूत्रेण ब्राह्मणैः ।\nचतुष्टोममहस्तस्य प्रथमं परिकल्पितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000014041, "chapter_id": 9014, "verse_number": "१-१४-४१", "content_sanskrit": "उक्थ्यं द्वितीयं संख्यातमतिरात्रं तथोत्तरम् ।\nकारितास्तत्र बहवो विहिताः शास्त्रदर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000014042, "chapter_id": 9014, "verse_number": "१-१४-४२", "content_sanskrit": "ज्योतिष्टोमायुषी चैवमतिरात्रौ च निर्मितौ ।\nअभिजिद्विश्वजिच्चैवमाप्तोर्यामौ महाक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000014043, "chapter_id": 9014, "verse_number": "१-१४-४३", "content_sanskrit": "प्राचीं होत्रे ददौ राजा दिशं स्वकुलवर्धनः ।\nअध्वर्यवे प्रतीचीं तु ब्रह्मणे दक्षिणां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000014044, "chapter_id": 9014, "verse_number": "१-१४-४४", "content_sanskrit": "उद्गात्रे तु तथोदीचीं दक्षिणैषा विनिर्मिता ।\nअश्वमेधे महायज्ञे स्वयम्भूविहिते पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000014045, "chapter_id": 9014, "verse_number": "१-१४-४५", "content_sanskrit": "क्रतुं समाप्य तु तदा न्यायतः पुरुषर्षभः ।\nऋत्विग्भ्यो हि ददौ राजा धरां तां कुलवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000014046, "chapter_id": 9014, "verse_number": "१-१४-४६", "content_sanskrit": "एवम् दत्त्वा प्रहृष्टोऽभूच्छ्रीमाननिक्ष्वाकुनन्दनः ।\nऋत्विजस्त्वब्रुवन् सर्वे राजानं गतकिल्बिषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000014047, "chapter_id": 9014, "verse_number": "१-१४-४७", "content_sanskrit": "भवानेव महीं कृत्स्नामेको रक्षितुमर्हति ।\nन भूम्या कार्यमस्माकं नहि शक्ताः स्म पालने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000014048, "chapter_id": 9014, "verse_number": "१-१४-४८", "content_sanskrit": "रताः स्वाध्यायकरणे वयं नित्यं हि भूमिप ।\nनिष्क्रयं किञ्चिदेवेह प्रयच्छतु भवानिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000014049, "chapter_id": 9014, "verse_number": "१-१४-४९", "content_sanskrit": "मणिरत्नं सुवर्णं वा गावो यद्वा समुद्यतम् ।\nतत् प्रयच्छ नरश्रेष्ठ धरण्या न प्रयोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000014050, "chapter_id": 9014, "verse_number": "१-१४-५०", "content_sanskrit": "एवमुक्तो नरपतिर्ब्राह्मणैर्वेदपारगैः ।\nगवां शतसहस्राणि दश तेभ्यो ददौ नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000014051, "chapter_id": 9014, "verse_number": "१-१४-५१", "content_sanskrit": "दशकोटिं सुवर्णस्य रजतस्य चतुर्गुणम् ।\nऋत्विजस्तु ततः सर्वे प्रददुः सहिता वसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000014052, "chapter_id": 9014, "verse_number": "१-१४-५२", "content_sanskrit": "ऋष्यशृङ्गाय मुनये वसिष्ठाय च धीमते ।\nततस्ते न्यायतः कृत्वा प्रविभागं द्विजोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000014053, "chapter_id": 9014, "verse_number": "१-१४-५३", "content_sanskrit": "सुप्रीतमनसः सर्वे प्रत्यूचुर्मुदिता भृशम् ।\nततः प्रसर्पकेभ्यस्तु हिरण्यं सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000014054, "chapter_id": 9014, "verse_number": "१-१४-५४", "content_sanskrit": "जाम्बूनदं कोटिसंख्यं ब्राह्मणेभ्यो ददौ तदा ।\nदरिद्राय द्विजायथ हस्ताभरणमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000014055, "chapter_id": 9014, "verse_number": "१-१४-५५", "content_sanskrit": "कस्मैचित् याचमानाय ददौ राघवनन्दनः ।\nततः प्रीतेषु विधिवत् द्विजेषु द्विजवत्सलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000014056, "chapter_id": 9014, "verse_number": "१-१४-५६", "content_sanskrit": "प्रणाममकरोत् तेषां हर्षव्याकुलितेन्द्रियः ।\nतस्याशिषोऽथ विविधा ब्राह्मणैः समुदाहृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000014057, "chapter_id": 9014, "verse_number": "१-१४-५७", "content_sanskrit": "उदारस्य नृवीरस्य धरण्यां पतितस्य च ।\nततः प्रीतमना राजा प्राप्य यज्ञमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000014058, "chapter_id": 9014, "verse_number": "१-१४-५८", "content_sanskrit": "पापापहं स्वर्नयनं दुस्तरं पार्थिवर्षभैः ।\nततोऽब्रवीदृशष्यशृङ्गं राजा दशरथस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000014059, "chapter_id": 9014, "verse_number": "१-१४-५९", "content_sanskrit": "कुलस्य वर्धनं तत् तु कर्तुमर्हसि सुव्रत\nतथेति च स राजानमुवाच द्विजसत्तमः\nभविष्यन्ति सुता राजंश्चत्वारस्ते कुलोद्वहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000014060, "chapter_id": 9014, "verse_number": "१-१४-६०", "content_sanskrit": "स तस्य वाक्यं मधुरं निशम्य\nप्रणम्य तस्मै प्रयतो नृपेन्द्रः ।\nजगाम हर्षं परमं महात्मा\nतमृष्यशृङ्गं पुनरप्युवाच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000014061, "chapter_id": 9014, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे चतुर्दशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]