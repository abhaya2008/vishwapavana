[{"id": 7002514000, "chapter_id": 22514, "verse_number": "१-१७६-१", "content_sanskrit": "सुमंतुरुवाच ।\nपद्मासनः पद्मवर्णः पद्मपत्रनिभेक्षणः ।\nकमण्डलुधरः श्रीमान्देवगंधर्वपूजितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002514001, "chapter_id": 22514, "verse_number": "१-१७६-२", "content_sanskrit": "चतुर्मुखो देवपतिः सूर्यार्चनपरः सदा ।\nसुरज्येष्ठो महातेजाः सर्व लोकप्रजापतिः ।\nब्रह्मशब्देन दिव्येन ब्रह्मा शांतिं करोतु ते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002514002, "chapter_id": 22514, "verse_number": "१-१७६-३", "content_sanskrit": "पीतांबरधरो देव आत्रेयीदयितः सदा ।\nशंखचक्रगदापाणिः श्यामवर्णश्चतुर्भुजः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002514003, "chapter_id": 22514, "verse_number": "१-१७६-४", "content_sanskrit": "यज्ञदेहः क्रमो देव आत्रेयीदयितः सदा ।\nशंखचक्रगदापाणिर्माधवो मधुसूदनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002514004, "chapter_id": 22514, "verse_number": "१-१७६-५", "content_sanskrit": "सूर्यभक्तान्वितो नित्यं विगतिर्विगतत्रयः ।\nसूर्यध्यानपरो नित्यं विष्णुः शांतिं करोतु ते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002514005, "chapter_id": 22514, "verse_number": "१-१७६-६", "content_sanskrit": "शशिकुंदेंदुसंकाशो विश्रुताभरणैरिह ।\nचतुर्भुजो महातेजाः पुष्पार्धकृतशेखरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002514006, "chapter_id": 22514, "verse_number": "१-१७६-७", "content_sanskrit": "चतुर्मुखो भस्मधरः स्मशाननिलयः सदा ।\nगोत्रारिर्विश्वनिलयस्तथा च क्रतुदूषणः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002514007, "chapter_id": 22514, "verse_number": "१-१७६-८", "content_sanskrit": "वरो वरेण्यो वरदो देवदेवो महेश्वरः ।\nआदित्यदेहसंभूतः स ते शांतिं करोतु वै ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]