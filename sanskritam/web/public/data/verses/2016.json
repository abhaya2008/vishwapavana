[{"id": 2045750, "chapter_id": 2016, "verse_number": "६-६५-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2045751, "chapter_id": 2016, "verse_number": "६-६५-१", "content_sanskrit": "भयं मे सुमहञ्जातं विस्मयश्चैव सञ्जय।\nश्रुत्वा पाण्डुकुमाराणां कर्म देवैः सुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2045752, "chapter_id": 2016, "verse_number": "६-६५-२", "content_sanskrit": "पुत्राणां च पराभावं श्रुत्वा सञ्जय सर्वशः।\nचिन्ता मे महती सूत भविष्यति कथं त्विति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2045753, "chapter_id": 2016, "verse_number": "६-६५-३", "content_sanskrit": "ध्रुवं विदुरवाक्यानि धक्ष्यन्ति हृदयं मम।\nतथा हि दृश्यते सर्वं दैवयोगेन सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2045754, "chapter_id": 2016, "verse_number": "६-६५-४", "content_sanskrit": "यत्र भीष्ममुखान्सर्वाञ्शस्त्रज्ञान्योधसत्तमान्।\nपाण्डवानामनीकेषु योधयन्ति प्रहारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2045755, "chapter_id": 2016, "verse_number": "६-६५-५", "content_sanskrit": "केनावध्या महात्मानः पाण्डुपुत्रा महाबलाः ।\nकेन दत्तवरास्तात किं वा ज्ञानं विदन्ति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2045756, "chapter_id": 2016, "verse_number": "६-६५-६", "content_sanskrit": "येन क्षयं न गच्छन्ति दिवि तारागणा इव।\nपुनःपुनर्न मृष्यामि हतं सैन्यं तु पाण्डवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2045757, "chapter_id": 2016, "verse_number": "६-६५-७", "content_sanskrit": "मय्येव दण्डः पतति दैवात्परमदारुणः।\nयथाऽवध्याः पाण्डुसुता यथा वाध्याश्च मे सुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2045758, "chapter_id": 2016, "verse_number": "६-६५-८", "content_sanskrit": "एतन्मे सर्वमाचक्ष्व याथातथ्येन सञ्जय ।\nन हि पारं प्रपश्यामि दुःखस्यास्य कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2045759, "chapter_id": 2016, "verse_number": "६-६५-९", "content_sanskrit": "समुद्रस्येव महतो भुजाभ्यां प्रतरन्नरः ।\nपुत्राणां व्यसनं मन्ये ध्रुवं प्राप्तं सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2045760, "chapter_id": 2016, "verse_number": "६-६५-१०", "content_sanskrit": "घातयिष्यति मे स्रवान्पुत्रान्भीमो न शंसयः।\nन हि पश्यामि तं वीरं यो मे रक्षेत्सुतान्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2045761, "chapter_id": 2016, "verse_number": "६-६५-११", "content_sanskrit": "ध्रुवं विनाशः संप्राप्तः पुत्रामां मम सञ्जय।\nतस्मान्मे कारणं सूत शक्तिं चैव विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2045762, "chapter_id": 2016, "verse_number": "६-६५-१२", "content_sanskrit": "पृच्छतो वै यथातत्त्वं सर्वमाख्यातुमर्हसि।\nदुर्योधनश्च यच्चक्रे दृष्ट्वा स्वान्विमुखान्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2045763, "chapter_id": 2016, "verse_number": "६-६५-१३", "content_sanskrit": "भीष्मद्रोणौ कृपश्चैव सौबलश्च जयद्रथः ।\nद्रौणिर्वापि महेष्वासो विकर्णो वा महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2045764, "chapter_id": 2016, "verse_number": "६-६५-१४", "content_sanskrit": "निश्चयो वापि कस्तेषां तदा ह्यासीन्महात्मानाम् ।\nविमुखेषु महाप्राज्ञ मम पुत्रेषु सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2045765, "chapter_id": 2016, "verse_number": "६-६५-१५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2045766, "chapter_id": 2016, "verse_number": "६-६५-१५", "content_sanskrit": "श्रृणु राजन्नवहितः श्रुत्वा चैवावधारय।\nनैव मन्त्रकृतं किंचिन्नैव मायां तथाविधाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2045767, "chapter_id": 2016, "verse_number": "६-६५-१६", "content_sanskrit": "न वै विभीषिकां कांचिद्राजन्कुर्वन्ति पाण्डवाः ।\nयुध्यन्ति ते यथान्यायं शक्तिमन्तश्च संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2045768, "chapter_id": 2016, "verse_number": "६-६५-१७", "content_sanskrit": "धर्मेण सर्वकार्याणि जीवितादीनि भारत।\nआरभन्ते सदा पार्थाः प्रार्थयाना महद्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2045769, "chapter_id": 2016, "verse_number": "६-६५-१८", "content_sanskrit": "न ते युद्धान्निवर्तन्ते धर्मोपेता महाबलाः ।\nश्रिया परमया युक्ता यतो धर्मस्ततो जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2045770, "chapter_id": 2016, "verse_number": "६-६५-१९", "content_sanskrit": "तेनावध्या रणे पार्था जययुक्ताश्च पार्थिव ।\nतव पुत्रा दुरात्मानः पापेष्वभिरताः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2045771, "chapter_id": 2016, "verse_number": "६-६५-२०", "content_sanskrit": "निष्ठुरा हीनकर्माणस्तेन हीयन्ति संयुगे।\nसुबहूनि नृशंसानि पुत्रैस्तव जनेश्वरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2045772, "chapter_id": 2016, "verse_number": "६-६५-२१", "content_sanskrit": "निकृतानीह पाण्डूनां नीचैरिव यथा नरैः ।\nसर्वं च तदनादृत्य पुत्राणां तव किल्बिषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2045773, "chapter_id": 2016, "verse_number": "६-६५-२२", "content_sanskrit": "धर्ममूलाः सदैवासन्पाण्डवाः पाण्डुपूर्वज।\nन चैतान्बहुमन्यन्ते पुत्रास्तव विशांपते ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2045774, "chapter_id": 2016, "verse_number": "६-६५-२३", "content_sanskrit": "तस्य पापस्य सततं क्रियमाणस्य कर्मणः।\nसांप्रतं सुमहद्धोरं फलं प्राप्तं जनेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2045775, "chapter_id": 2016, "verse_number": "६-६५-२४", "content_sanskrit": "स त्वं भुङ्क्ष्व महाराज सपुत्रः समुहृञ्जनः।\nनावबुध्यसि यद्राजन्वार्यमाणः सुहृज्जनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2045776, "chapter_id": 2016, "verse_number": "६-६५-२५", "content_sanskrit": "विदुरेणाथ भीष्मेण द्रोणेन न महात्मना।\nतथा मया चाप्यसकृद्वार्यमाणो न बुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2045777, "chapter_id": 2016, "verse_number": "६-६५-२६", "content_sanskrit": "वाक्यं हितं च पथ्यं च मर्त्यः पथ्यमिवौषधम् ।\nपुत्राणां मतमास्थाय जितान्मन्यसि पाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2045778, "chapter_id": 2016, "verse_number": "६-६५-२७", "content_sanskrit": "शृणु भूयो यथातत्त्वं यन्मां त्वं परिपृच्छसि।\nकारणं भरतश्रेष्ठ पाण्डवानां जयं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2045779, "chapter_id": 2016, "verse_number": "६-६५-२८", "content_sanskrit": "तत्तेऽहं कथयिष्यामि यथाश्रुतमरिन्दम।\nदुर्योधनेन संपृष्ट एतमर्थं पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2045780, "chapter_id": 2016, "verse_number": "६-६५-२९", "content_sanskrit": "दृष्ट्वा भ्रातॄन्रणे सर्वान्निर्जितांस्तु महारथान् ।\nशोकसंमूढहृदयो निशाकाले स्म कौरवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2045781, "chapter_id": 2016, "verse_number": "६-६५-३०", "content_sanskrit": "पितामहं महाप्राज्ञं विनयोपगम्य ह।\nयदब्रवीत्सुतस्तेऽसौ तन्मे शृणु जनेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2045782, "chapter_id": 2016, "verse_number": "६-६५-३१x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2045783, "chapter_id": 2016, "verse_number": "६-६५-३१", "content_sanskrit": "भवान्द्रोणश्च कर्णश्च कृपो द्रौणिस्तथैव च।\nकृतवर्मा च हार्दिक्यः काम्भोजश्च सुदक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2045784, "chapter_id": 2016, "verse_number": "६-६५-३२", "content_sanskrit": "भूरिश्रवा विकर्णश्च भगदत्तश्च वीर्यवान् ।\nमहारथाः समाख्याताः कुलपुत्रास्तनुत्यजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2045785, "chapter_id": 2016, "verse_number": "६-६५-३३", "content_sanskrit": "त्रयाणामपि लोकानां पर्याप्ता इति मे मतिः।\nपाण्डवानां समस्ताश्च न तिष्ठन्ति पराक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2045786, "chapter_id": 2016, "verse_number": "६-६५-३४", "content_sanskrit": "तत्र मे संशयो जातस्तत्त्वमाचक्ष्व पृच्छतः।\nयं समाश्रित्य कौन्तेय जयन्त्यस्मान्क्षणेक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2045787, "chapter_id": 2016, "verse_number": "६-६५-३५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2045788, "chapter_id": 2016, "verse_number": "६-६५-३५", "content_sanskrit": "शृणु राजन्वचो मह्यं यथा वक्ष्यामि कौरव।\nबहुशश्च मयोक्तोऽसि न च मे तत्त्वया कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2045789, "chapter_id": 2016, "verse_number": "६-६५-३६", "content_sanskrit": "क्रियतां पाण्डवैः सार्ध समो भरतसत्तम।\nएतत्क्षेममहं मन्ये पृथिव्यास्तव वा विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2045790, "chapter_id": 2016, "verse_number": "६-६५-३७", "content_sanskrit": "भुङ्क्ष्वेमां पृथिवीं राजन्भ्रातृभिः सहितः सुखी।\nदुर्हृदस्तापयन्सर्वान्नन्दयंश्चापि बान्धवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2045791, "chapter_id": 2016, "verse_number": "६-६५-३८", "content_sanskrit": "न च मे क्रोशतस्तात श्रुतवानसि वै पुरा।\nतदिदं समनुप्राप्तं यत्पाण्डूनवमन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2045792, "chapter_id": 2016, "verse_number": "६-६५-३९", "content_sanskrit": "यश्च हेतुरवध्यत्वे तेकषामक्लिष्टकर्मणाम्।\nतं शृणुष्व महाबाहो मम कीर्तयतः प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2045793, "chapter_id": 2016, "verse_number": "६-६५-४०", "content_sanskrit": "नास्ति लोकेषु तद्भूतं भविता नो भविष्यति।\nयो जयेत्पाण्डवान्सर्वान्पालिताञ्छार्ङ्गधन्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2045794, "chapter_id": 2016, "verse_number": "६-६५-४१", "content_sanskrit": "यत्तु मे कथितं तात मुनिभिर्भावितात्मभिः।\nपुराणगीतं धर्मज्ञ तच्छृणुष्व यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2045795, "chapter_id": 2016, "verse_number": "६-६५-४२", "content_sanskrit": "पुरा किल सुराः सर्वे ऋषयश्च समागताः ।\nपितामहमुपासेदुः पर्वत गन्धमादने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2045796, "chapter_id": 2016, "verse_number": "६-६५-४३", "content_sanskrit": "तेषां मध्ये समासीनः प्रजापतिरपश्यत ।\nविमानं प्रज्वलद्भासा स्थितं प्रवरमम्बरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2045797, "chapter_id": 2016, "verse_number": "६-६५-४४", "content_sanskrit": "ध्यानेनावेद्य तद्ब्रह्मा कृत्वा च नियतोऽञ्जलिम् ।\nनमश्चकार हृष्टात्मा पुरुषं परमेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2045798, "chapter_id": 2016, "verse_number": "६-६५-४५", "content_sanskrit": "ऋषयस्त्वथ देवाश्च दृष्ट्वा ब्रह्माणमुत्थितम् ।\nस्थिताः प्राञ्जलयः सर्वे पश्यन्तो महदद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2045799, "chapter_id": 2016, "verse_number": "६-६५-४६", "content_sanskrit": "यथावच्च तमभ्यर्च्य ब्रह्मा ब्रह्मविदां वरः ।\nजगाद जगतः स्रष्टा परं परमधर्मवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2045800, "chapter_id": 2016, "verse_number": "६-६५-४७", "content_sanskrit": "विश्वावसुर्विश्वमूर्तिर्हि विश्वे\nविष्वक्सेनो विश्वकर्मा वशी च।\nविश्वेश्वरो वासुदेवोऽसि तस्मा-\nद्योगात्मानं देवतं त्वामुपैमि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2045801, "chapter_id": 2016, "verse_number": "६-६५-४८", "content_sanskrit": "जय विश्वमहादेव जय लोकहिते रत।\nजय योगीश्वर विभो जय योगपरावर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2045802, "chapter_id": 2016, "verse_number": "६-६५-४९", "content_sanskrit": "पद्मगर्भविशालाक्ष जय लोकेश्वरेश्वर।\nभूतभव्यभवन्नाथ जय सौम्यात्मजात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2045803, "chapter_id": 2016, "verse_number": "६-६५-५०", "content_sanskrit": "असङ्क्येयगुणाधार जय सर्वपरायण।\nनारायण सुदुष्पार जय शार्ङ्गधनुर्धर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2045804, "chapter_id": 2016, "verse_number": "६-६५-५१", "content_sanskrit": "जय सर्वगुणोपेत विश्वमूर्ते निरामय।\nविश्वेश्वर महाबाहो जय लोकार्थतत्पर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2045805, "chapter_id": 2016, "verse_number": "६-६५-५२", "content_sanskrit": "महोरगवराहाद्य हरिकेश विभो जय।\nहरिवासदिशामीश विश्ववासामिताव्यय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2045806, "chapter_id": 2016, "verse_number": "६-६५-५३", "content_sanskrit": "व्यक्ताव्यक्तामितस्थान नियतेन्द्रिय सत्त्क्रिय ।\nअसङ्ख्येयात्मभावज्ञ जय गम्भीर कामद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2045807, "chapter_id": 2016, "verse_number": "६-६५-५४", "content_sanskrit": "अनन्त विदित ब्रह्मन्नित्यभूतविभावन ।\nकृतकार्य कृतप्रज्ञ धर्मज्ञ विजयावह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2045808, "chapter_id": 2016, "verse_number": "६-६५-५५", "content_sanskrit": "गुह्यात्मन्सर्वयोगात्मन्स्फुटसंभूतसंभव।\nभूताद्य लोकत्त्वेश जय भूतविभावन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2045809, "chapter_id": 2016, "verse_number": "६-६५-५६", "content_sanskrit": "आत्मयोगे महाभाग कल्पसंक्षेपतत्पर ।\nउद्भावनमनोभाव जय ब्रह्म जयप्रिय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2045810, "chapter_id": 2016, "verse_number": "६-६५-५७", "content_sanskrit": "निसर्गसर्गनिरत कामेश परमेश्वर ।\nअमृतोद्भवसद्भाव मुक्तात्मन्विजयप्रद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2045811, "chapter_id": 2016, "verse_number": "६-६५-५८", "content_sanskrit": "प्रजापतिपते देव पद्मनाभ महाबल।\nआत्मभूतमहाभूत सत्वात्मञ्जय सर्वदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2045812, "chapter_id": 2016, "verse_number": "६-६५-५९", "content_sanskrit": "पादौ तव धा देवी दिशो बाहु दिवं शिरः।\nमूर्तिस्तेऽहं सुराः कायश्चन्द्रादित्यौ च चक्षुषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2045813, "chapter_id": 2016, "verse_number": "६-६५-६०", "content_sanskrit": "बलं तपश्च सत्यं च कर्म धर्मात्मकं तव।\nतेजोऽग्निः पवनः श्वास आपस्ते स्वेदसंभवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2045814, "chapter_id": 2016, "verse_number": "६-६५-६१", "content_sanskrit": "अश्विनौ श्रवणौ नित्यं देवी जिह्वा सरस्वती।\nवेदाः संस्कारनिष्ठा हि त्वयीदं जगदाश्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2045815, "chapter_id": 2016, "verse_number": "६-६५-६२", "content_sanskrit": "न सङ्ख्यानं परीमाणं न तेजो न पराक्रमम् ।\nन बलं योगयोगीश जानीमस्ते परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2045816, "chapter_id": 2016, "verse_number": "६-६५-६३", "content_sanskrit": "त्वद्भक्तिनिरता देव नियमैस्त्वां समाश्रिताः।\nअर्चयामः सदा विष्णो परमेशं महेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2045817, "chapter_id": 2016, "verse_number": "६-६५-६४", "content_sanskrit": "ऋषयो देवगन्धर्वा यक्षराक्षसपन्नगाः।\nपिशाचा मानुषाश्चैव मृगपक्षिसरीसृपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2045818, "chapter_id": 2016, "verse_number": "६-६५-६५", "content_sanskrit": "एवमादि मया सृष्टं पृथिव्यां त्वत्प्रसादजम् ।\nपद्मनाभ विशालाक्ष कृष्ण दुःश्वप्रणाशन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2045819, "chapter_id": 2016, "verse_number": "६-६५-६६", "content_sanskrit": "त्वं गतिः सर्वभूतानां त्वं नेता त्वं जगद्गुरुः ।\nत्वत्प्रसादेन देवेश सुखिनो विबुधाः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2045820, "chapter_id": 2016, "verse_number": "६-६५-६७", "content_sanskrit": "पृथिवी निर्भया देव त्वत्प्रसादात्सदाऽभवत् ।\nतस्माद्भव विशालाक्ष यदुवंशविवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2045821, "chapter_id": 2016, "verse_number": "६-६५-६८", "content_sanskrit": "धर्मसंस्थापनार्थाय दैत्यानां च बधाय च।\nजगतो धारणार्थाय विज्ञाप्यं कुरु मे विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2045822, "chapter_id": 2016, "verse_number": "६-६५-६९", "content_sanskrit": "यत्तत्परमकं गुह्यं त्वत्प्रसादादिदं विभो।\nवासुदेव तदेतत्ते मयोद्गीतं यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2045823, "chapter_id": 2016, "verse_number": "६-६५-७०", "content_sanskrit": "सृष्ट्वा संकर्षणं देवं स्वयमात्मानमात्मना।\nकृष्ण त्वमात्मनास्राक्षीः प्रद्युम्नं चात्मसंभवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2045824, "chapter_id": 2016, "verse_number": "६-६५-७१", "content_sanskrit": "प्रद्युम्नादनिरुद्धं त्वं यं विदुर्विष्णुमव्ययम्।\nअनिरुद्धोऽसृजन्मां वै ब्रह्माणं लोकधारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2045825, "chapter_id": 2016, "verse_number": "६-६५-७२", "content_sanskrit": "वासुदेवमयः सोऽहं त्वयैवास्मि विनिर्मितः।\nतस्माद्याचामि लोकेश चतुरात्मानमात्मना।\nविभज्य भागशोत्मानं व्रज मानुषतां विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2045826, "chapter_id": 2016, "verse_number": "६-६५-७३", "content_sanskrit": "तत्रासुरवधं कृत्वा सर्वलोकसुखाय वै।\nधर्मं प्राप्य यशः प्राप्य योगं प्राप्स्यति तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2045827, "chapter_id": 2016, "verse_number": "६-६५-७४", "content_sanskrit": "त्वां हि ब्रह्मर्षयो लोके देवाश्चामितविक्रम ।\nतैस्तैर्हि नामभिर्युक्ता गायन्ति परमात्मकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2045828, "chapter_id": 2016, "verse_number": "६-६५-७५", "content_sanskrit": "स्थिताश्च सर्वे त्वयि भूतसङ्घाः\nकृत्वाश्रयं त्वां वरदं सुबाहो।\nअनादिमध्यान्तमपारयोगं\nलोकस्य सेतुं प्रवदन्ति विप्राः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2045829, "chapter_id": 2016, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि पञ्चषष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]