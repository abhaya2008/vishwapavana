[{"id": 2110259, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2110260, "chapter_id": 3386, "verse_number": "१", "content_sanskrit": "ययातिः पूर्वकोऽस्माकं दशमो यः प्रजापतेः ।\nकथं स शुक्रतनयां लेभे परमदुर्लभाम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2110261, "chapter_id": 3386, "verse_number": "२", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं व्यासतो द्विजसत्तम ।\nआनुपूर्व्येण ये चान्ये राजानो वंशधारिणः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2110262, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2110263, "chapter_id": 3386, "verse_number": "३", "content_sanskrit": "ययातिर्नाहुषो राजा देवराजसमद्युतिः ।\nतं शुक्रवृषपर्वाणौ वव्राते वरमुत्तमम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2110264, "chapter_id": 3386, "verse_number": "४", "content_sanskrit": "तदहं सम्प्रवक्ष्यामि पृच्छतस्ते महीपते ।\nदेवयान्याश्च संयोगं ययातेर्नाहुषस्य च \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2110265, "chapter_id": 3386, "verse_number": "५", "content_sanskrit": "सुराणामसुराणां च भेदो वै समजायत ।\nऐश्वर्यस्य च सङ्घर्षात् त्रैलोक्यस्य च कारणात्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2110266, "chapter_id": 3386, "verse_number": "६", "content_sanskrit": "देवा दैत्यैर्योत्स्यमाना वव्रिरेऽङ्गिरसं मुनिम् ।\nपौरोहित्येन राज्यार्थं काव्यं तूशनसं परे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2110267, "chapter_id": 3386, "verse_number": "७", "content_sanskrit": "ब्राह्मणौ तावुभौ नित्यमन्योन्यस्पर्धिनौ भृशम् ।\nतत्र देवा निजघ्नुर्यान् दानवान् युधि सङ्गतान् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2110268, "chapter_id": 3386, "verse_number": "८", "content_sanskrit": "तान् पुनर्जीवयामास काव्यो विद्याबलाश्रयात् ।\nततस्ते पुनरुत्थाय योधयाञ्चक्रिरे सुरान् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2110269, "chapter_id": 3386, "verse_number": "९", "content_sanskrit": "असुरास्तु निजघ्नुर्यान् सुरान् समरमूर्धनि ।\nस तान् न जीवयामास बृहस्पतिरुदारधीः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2110270, "chapter_id": 3386, "verse_number": "१०", "content_sanskrit": "न हि वेद स तां विद्यां यां काव्यो वेद वीर्यवान् ।\nसञ्जीविनीं ततो देवा विषादमगमन् परम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2110271, "chapter_id": 3386, "verse_number": "११", "content_sanskrit": "ते देवाऽथ भयोद्विग्नाः काव्यादौशनसात् तदा ।\nऊचुः कचमुपागम्य ज्येष्ठं पुत्रं बृहस्पतेः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2110272, "chapter_id": 3386, "verse_number": "१२", "content_sanskrit": "भजमानान् भजस्वास्मान् कुरु साह्यमनुत्तमम् ।\nया वै विद्या निवसति ब्राह्मणेऽमिततेजसि \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2110273, "chapter_id": 3386, "verse_number": "१३", "content_sanskrit": "शुक्रे तामाहर क्षिप्रं भागभाङ् नो भविष्यसि ।\nवृर्षपर्वसमीपे तु शक्यो द्रष्टुं त्वया द्विजः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2110274, "chapter_id": 3386, "verse_number": "१४", "content_sanskrit": "रक्षते दानवांस्तत्र न स रक्षत्यदानवान् ।\nतमाराधयितुं शक्तो भवान् पूर्ववयो मुनिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2110275, "chapter_id": 3386, "verse_number": "१५", "content_sanskrit": "देवयानीमौशनसीं भक्त्याऽऽराधय सुव्रत ।\nतामाराधयितुं शक्तो नान्यः कश्चन विद्यते \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2110276, "chapter_id": 3386, "verse_number": "१६", "content_sanskrit": "शीलमाधुर्यदाक्षिण्यैरादरेण दमेन च ।\nदेवयान्यां हि तुष्टायां विद्यां तामाप्स्यसि ध्रुवम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2110277, "chapter_id": 3386, "verse_number": "१७", "content_sanskrit": "तथेत्युक्त्वा कचः प्रायान्मुहूर्तेऽलघुमार्दवे ।\nतथाऽभिपूजितो देवैः समीपं वृषपर्वणः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2110278, "chapter_id": 3386, "verse_number": "१८", "content_sanskrit": "स गत्वा त्वरितो राजन् देवैः सम्प्रेषितः कचः ।\nअसुरेन्द्रपुरे शुक्रमभिवाद्येदमब्रवीत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2110279, "chapter_id": 3386, "verse_number": "१९", "content_sanskrit": "ऋषेरङ्गिरसः पौत्रः पुत्रश्चाहं बृहस्पतेः ।\nनाम्ना कच इति ख्यातः शिष्यं गृह्णातु मां ऋषे \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2110280, "chapter_id": 3386, "verse_number": "२०", "content_sanskrit": "ब्रह्मचर्यं चरिष्यामि त्वत्समीपे यथाऽऽत्थ माम् ।\nअनुमन्यस्व मां ब्रह्मन् सहस्रपरिवत्सरम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2110281, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2110282, "chapter_id": 3386, "verse_number": "२१", "content_sanskrit": "कच स्वागतमद्यास्तु प्रतिगृह्णाम ते वचः ।\nअर्चयिष्येऽहमर्च्यं त्वामर्चितोऽस्तु बृहस्पतिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2110283, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2110284, "chapter_id": 3386, "verse_number": "२२", "content_sanskrit": "कचस्तु तं तथेत्युक्त्वा प्रतिजग्राह तं व्रतम् ।\nआदिष्टं भृगुपुत्रेण शुक्रेणोशनसा स्वयम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2110285, "chapter_id": 3386, "verse_number": "२३", "content_sanskrit": "व्रतं सव्रतकाले स यथोक्तं सङ्गृहीतवान् ।\nआराधयन्नुपाध्यायं देवयानीं च भारत \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2110286, "chapter_id": 3386, "verse_number": "२४", "content_sanskrit": "नित्यमाराधयिप्यंस्तां युवा यौवनगां मखे ।\nगायन् नृत्यन् वादयंश्च देवयानीमतोषयत् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2110287, "chapter_id": 3386, "verse_number": "२५", "content_sanskrit": "तत्सहस्रं गुरुगवां रक्षित्वा वन्यमाहरत् ।\nदेवयान्यपि तं विप्रं नियतव्रतचारिणम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2110288, "chapter_id": 3386, "verse_number": "२६", "content_sanskrit": "अनुगायमाना ललना रहः पर्यचरत् तथा ।\nगायन्तं चैव शल्कं च दातारं प्रियवादिनम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2110289, "chapter_id": 3386, "verse_number": "२७", "content_sanskrit": "नार्यो नरं कामयन्ते रूपिणं स्रग्विणं तथा ।\nपञ्चवर्षशतान्येवं कचस्य चरतो व्रतम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2110290, "chapter_id": 3386, "verse_number": "२८", "content_sanskrit": "तत्रातीयुरथो बुद्ध्वा दानवास्तं ततः कचम् ।\nततस्ते गास्तु रक्षन्तं दानवाः संशितव्रतम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2110291, "chapter_id": 3386, "verse_number": "२९", "content_sanskrit": "जघ्नुर्बृहस्पतेर्द्वेषाद् विद्यारक्षार्थमेव च ।\nहत्वा सालावृकेभ्यस्तं प्रायच्छंस्तिलशः कृतम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2110292, "chapter_id": 3386, "verse_number": "३०", "content_sanskrit": "ततो गावो निवृत्तास्ता अगोपाः स्वं निवेशनम् ।\nदृष्ट्वा स्म रहिता गास्तु कचे नाभ्यागते वनात् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2110293, "chapter_id": 3386, "verse_number": "३१", "content_sanskrit": "उवाच वचनं काले देवयान्यथ भारत ।\nआहुतं चाग्निहोत्रं ते सूर्याश्चास्तं गतः प्रभो \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2110294, "chapter_id": 3386, "verse_number": "३२", "content_sanskrit": "अगोपाश्चागता गावः कचस्तात न दृश्यते ।\nव्यक्तं गतो मृतो वापि कचस्तात भविष्यति \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2110295, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "तं विना न च जीवेयं कचं सत्यं ब्रवीम्यहम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2110296, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2110297, "chapter_id": 3386, "verse_number": "३३", "content_sanskrit": "अयमेहीति शब्देन कचं सञ्जीवयाम्यहम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2110298, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2110299, "chapter_id": 3386, "verse_number": "३४", "content_sanskrit": "ततः सञ्जीविनीं विद्यां प्रजप्त्वा कचमाह्वयत् ।\nभित्त्वा भित्त्वा शरीराणि वृकाणां स विनिष्पतन्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2110300, "chapter_id": 3386, "verse_number": "३५", "content_sanskrit": "आहूतः प्रादुरभूत् कचो रिष्टोऽथ विद्यया ।\nहतोऽहमिति चाचष्ट पृष्टो भार्गवकन्यया\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2110301, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "कचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2110302, "chapter_id": 3386, "verse_number": "३६", "content_sanskrit": "समित्पुष्पफलादीनि काष्ठभारं च भामिनि ।\nगृहीत्वा भूरिभारार्तो वटवृक्षं समाश्रितः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2110303, "chapter_id": 3386, "verse_number": "३७", "content_sanskrit": "गावश्च सहिताः सर्वा वृक्षच्छायां समाश्रिताः ।\nअसुरास्तत्र मां दृष्ट्वा कस्त्वमित्यभ्यचोदयन् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2110304, "chapter_id": 3386, "verse_number": "३८", "content_sanskrit": "बृहस्पतिसुतश्चाहं कच इत्यभिविश्रुतः ।\nइत्युक्तमात्रे मां पेशीकृत्वा तु दानवाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2110305, "chapter_id": 3386, "verse_number": "३९", "content_sanskrit": "दत्त्वा सालावृकेभ्यस्ते सुखं जग्मुः स्वमालयम् ।\nआहूतो विद्ययाऽनेन भार्गवेण महात्मना\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2110306, "chapter_id": 3386, "verse_number": "४०", "content_sanskrit": "त्वत्समीपमिहायातः कथञ्चित् प्राप्तजीवितः ।\nपुनश्च देवयान्योक्तः पुष्पाण्याहर मे द्विज\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2110307, "chapter_id": 3386, "verse_number": "४१", "content_sanskrit": "तथेति स गतः केचिद् दानवा ददृशुर्वने ।\nपुनश्च पोथयित्वा तं समुद्रेऽम्भस्यमिश्रयन् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2110308, "chapter_id": 3386, "verse_number": "४२", "content_sanskrit": "चिरं गतं पुनः कन्या पित्रे तं सन्न्यवेदयत् ।\nविप्रेण पुनराहूतो विद्यया बाह्मणस्तदा \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2110309, "chapter_id": 3386, "verse_number": "४३", "content_sanskrit": "पुनरावृत्त्य वृत्तान्तं न्यवेदयत तत्वतः ।\nदेवयान्या पुनरपि वन्यं पुष्पं समाहर \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2110310, "chapter_id": 3386, "verse_number": "४४", "content_sanskrit": "अगच्छद् वनमित्युक्तो दानवा ददृशुः पुनः ।\nतृतीयमपि हत्वा तं दग्ध्वा पिष्ट्वा च सूक्ष्मतः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2110311, "chapter_id": 3386, "verse_number": "४५", "content_sanskrit": "प्रायच्छन् ब्राह्मणायैव सुरायामसुरास्तदा ।\nदेवयानी शङ्कमाना दृष्ट्वा पितरमब्रवीत् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2110312, "chapter_id": 3386, "verse_number": "४६", "content_sanskrit": "पुष्पाहरः प्रेषितो मे कचस्तात न दृश्यते ।\nव्यक्तं गतो मृतो वापि कचस्तात महातपाः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2110313, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2110314, "chapter_id": 3386, "verse_number": "४७", "content_sanskrit": "आहूतो विद्ययाऽपीह नाभ्येति करवाणि किम् ।\nबृहस्पतेः सुतः पुत्रि कचः प्रेतगतिं गतः ।\nविद्यया जीवितो ह्येष हन्यते करवाणि किम् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2110315, "chapter_id": 3386, "verse_number": "४८", "content_sanskrit": "तन्मा शुचो मा रुद देवयानि\nन त्वादृशी मर्त्यमनुप्रशोचेत् ।\nसुराश्च विश्वे च जगच्च सर्व-\nमुपस्थितां वै विपदं व्रजन्ति\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2110316, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2110317, "chapter_id": 3386, "verse_number": "४९", "content_sanskrit": "यस्याङ्गिरा वृद्धतमः पितामहो\nबृहस्पतिश्चापि पिता महर्षिः ।\nऋषेः पुत्रं तव शिष्यं कथं नु\nपितर्न शोचामि कथं न रुद्याम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2110318, "chapter_id": 3386, "verse_number": "५०", "content_sanskrit": "स ब्रह्मचारी च तपोधनश्च\nनित्योत्थितः कर्मसु चैव दक्षः ।\nकचस्य मार्गं प्रतिपत्स्ये न मोक्ष्ये\nप्रियो हि मे तात कचोऽभिरूपः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2110319, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2110320, "chapter_id": 3386, "verse_number": "५१", "content_sanskrit": "असंशयं मामसुरा द्विषन्ति\nये शिष्यं मेऽनागसं सूदयन्ति ।\nअब्राह्मणं लोकमिच्छन्ति पापा\nरौद्री तथा दानवानां प्रवृत्तिः।\nअप्यस्य पापस्य भवेदिहान्तः\nकं ब्रह्महत्या न दहेदपीन्द्रम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2110321, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2110322, "chapter_id": 3386, "verse_number": "५२", "content_sanskrit": "सञ्चोदितो देवयान्या महर्षिः समुपाह्वयत् ।\nसंरभेणैव काव्यो हि बृहस्पतिसुतं कचम् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2110323, "chapter_id": 3386, "verse_number": "५३", "content_sanskrit": "गुरोर्भीतो विद्यया चोपहूतः\nशनैर्वाचं जठरे व्याजहार \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2110324, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "कचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2110325, "chapter_id": 3386, "verse_number": "५४", "content_sanskrit": "प्रसीद भगवन् मह्यं कचोऽहमभिवादये ।\nयथा बहुमतः पुत्रस्तथा मन्यतु मां भवान्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2110326, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2110327, "chapter_id": 3386, "verse_number": "५५", "content_sanskrit": "तमब्रवीत् केन पथोपनीतो\nममोदरे तिष्ठसि व्रूहि विप्र ।\nअस्मिन् मुहूर्ते ह्यसुरान् विनाश्य\nगच्छामि देवानहमद्य विप्र\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2110328, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "कचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2110329, "chapter_id": 3386, "verse_number": "५६", "content_sanskrit": "तव प्रसादान्न जहाति मां स्मृतिः\nस वै सर्वं वेद्मि यथा च वृत्तम् ।\nनन्वेव तु स्यात् तपसो व्ययो मे\nततः क्लेशं घोरमिमं सहामि\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2110330, "chapter_id": 3386, "verse_number": "५७", "content_sanskrit": "असुरैः सुरायां भवतोऽस्मि दत्तो\nहत्वा दग्ध्वा चूर्णयित्वा च काव्य ।\nब्राह्मीं मायामासुरीं चाद्य माया\nत्वयि स्थिते कथमेवातिवर्तेत्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2110331, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2110332, "chapter_id": 3386, "verse_number": "६०", "content_sanskrit": "किं ते प्रियं करवाण्यद्य वत्से\nवधेन मे जीवितं स्यात् कचस्य ।\nनान्यत्र कुक्षेर्मम भेदाद्धि दृश्येत्\nकन्ये कचो मद्गतो देवयानि\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2110333, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "शुक्रः (?)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2110334, "chapter_id": 3386, "verse_number": "६१", "content_sanskrit": "द्वौ मे शोकौ वह्निकल्पौ दहेतां\nकचस्य नाशस्तव चैवोपघातः ।\nकचस्य नाशे मम शर्म नास्ति\nतवोपघाते जीवितुं नास्मि शक्तः(?)\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2110335, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2110336, "chapter_id": 3386, "verse_number": "६२", "content_sanskrit": "संसिद्धरूपोऽसि बृहस्पतेः सुतः\nयत् त्वां भक्त्या भजते देवयानी ।\nविद्यामिमां प्राप्नुहि जीवनीं त्वं\nन चेदिन्द्रः कचरूपी त्वमद्य \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2110337, "chapter_id": 3386, "verse_number": "६३", "content_sanskrit": "न निवर्तेत् पुनर्जीवन् कश्चिदन्यो ममोदरात् ।\nब्राह्मणं वर्जयित्वा तु तस्माद् विद्यामवाप्नुहि\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2110338, "chapter_id": 3386, "verse_number": "६४", "content_sanskrit": "पुत्रो भूत्वा भावय भावितो मां\nअस्मद्देहादुपनिष्क्रम्य तात ।\nसमीक्षेथा धर्मवतीमवेक्षां\nगुरोः सकाशात् प्राप्य विद्याः सविद्यः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2110339, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2110340, "chapter_id": 3386, "verse_number": "६५", "content_sanskrit": "गुरोः सकाशात् समवाप्य विद्यां\nभित्त्वा पार्श्वं निर्विचक्राम विप्रः ।\nकचोऽभिरूपो तत्क्षणाद् ब्राह्मणस्य\nशुक्लात्यये पौर्णमास्यामिवेन्दुः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2110341, "chapter_id": 3386, "verse_number": "६६", "content_sanskrit": "दृष्ट्वा शयानं ब्राह्मणं ब्रह्मराशि-\nमुत्थापयामास मृतं कचश्च ।\nविद्यां सिद्धां समवाप्याभिवाद्य\nततः कचस्तं गुरुमित्युवाच\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2110342, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "कचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2110343, "chapter_id": 3386, "verse_number": "६७", "content_sanskrit": "यः श्रोत्रयोरमृतं सन्निषिञ्चेद्\nविद्यामविद्यस्य यथा ममायम् ।\nतं मन्येऽहं पितरं मातरं च\nतस्मै न द्रुह्येत् कृतमस्य जानन्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2110344, "chapter_id": 3386, "verse_number": "६८", "content_sanskrit": "ऋतस्य दातारमनुत्तमस्य\nनिधिं निधीनां चतुरन्वयानाम् ।\nये नाद्रियन्ते गुरुमर्चनीयं\nपापान् लोकांस्ते व्रजन्त्यप्रतिष्ठान्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2110345, "chapter_id": 3386, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2110346, "chapter_id": 3386, "verse_number": "६९", "content_sanskrit": "शृण्वत्सु भूतेष्विदमाह काव्यः\nसमुत्थितो ब्रह्मराशिः पुराणः ।\nसुरापानाद् वञ्चनां प्राप्य तीव्रां\nसञ्ज्ञानाशं पापकृत्याफलं यत्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2110347, "chapter_id": 3386, "verse_number": "७०", "content_sanskrit": "दृष्ट्वा कचं चापि तथा स जीवितं\nपीत्वा सुरां सुरया मोहितः सन् ।\nसमन्युरुत्थाय महानुभावः\nतदोशना विप्रहितं चिकीर्षुः ।\nकाव्यः स्वयं वाक्यमिदं जगाद\nसुरापानं वै प्रतिशङ्कमानः \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2110348, "chapter_id": 3386, "verse_number": "७१", "content_sanskrit": "यो ब्राह्मणोऽद्यप्रभृतीह कश्चि-\nन्मोहात् सुरां पास्यति मन्दबुद्धिः ।\nअपेतधर्मो ब्रह्महा चैव स स्याद्\nअस्मिंल्लोके गर्हितः स्यात् परे च\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2110349, "chapter_id": 3386, "verse_number": "७२", "content_sanskrit": "मया चेमां विप्रधर्मोक्तसीमां\nमर्यादां वै स्थापितां सर्वलोके ।\nसन्तो विप्राः शुश्रुवांसो गुरूणां\nदेवा लोकाश्चोपशृण्वन्तु सर्वे\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2110350, "chapter_id": 3386, "verse_number": "७३", "content_sanskrit": "इतीदमुक्त्वा तु महानुभावस्तपोनिधीनां निधिरप्रमेयः ।\nतान् दानवान् देवविमूढबुद्धीन् इदं समाहूय वचोऽभ्युवाच\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2110351, "chapter_id": 3386, "verse_number": "७४", "content_sanskrit": "आचक्षे वो दानवा बालिशाः स्थ\nसिद्धः कचो यास्यति मत्सकाशात् ।\nसञ्जीविनीं प्राप्य विद्यां महार्थां\nतुल्यप्रभावो ब्रह्मणा ब्रह्मभूतः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2110352, "chapter_id": 3386, "verse_number": "७५", "content_sanskrit": "योऽकार्षीद् दुष्करं कर्म देवानां कारणात् कचः ।\nन चेत् किञ्चिच्चिरां गच्छेः याज्ञीयश्च भविष्यसि\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2110353, "chapter_id": 3386, "verse_number": "७६", "content_sanskrit": "गुरोरुष्य सकाशे तु दश वर्षशतानि च ।\nअनुज्ञातः कचो गन्तुमियेष त्रिदशालयम्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2110354, "chapter_id": 3386, "verse_number": "१३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि पञ्चषष्टितमोऽध्यायः ॥६५॥ ॥ सम्भवपर्वणि त्रयोदशोऽध्यायः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}]