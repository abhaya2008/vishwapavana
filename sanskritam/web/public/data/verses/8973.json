[{"id": 40006292, "chapter_id": 8973, "verse_number": "1", "content_sanskrit": "स्निग्धगम्भीरघोषेण स्यन्दनेनोपयान्प्रभुः। अयोध्यां भरतः क्षिप्रं प्रविवेश महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40006293, "chapter_id": 8973, "verse_number": "2", "content_sanskrit": "बिडालोलूकचरितामालीननरवारणाम्। तिमिराभ्याहतां कालीमप्रकाशां निशामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40006294, "chapter_id": 8973, "verse_number": "3", "content_sanskrit": "राहुशत्रोः प्रियां पत्नीं श्रिया प्रज्वलितप्रभाम्। ग्रहेणाभ्युत्थितेनैकां रोहिणीमिव पीडिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40006295, "chapter_id": 8973, "verse_number": "4", "content_sanskrit": "अल्पोष्णक्षुब्धसलिलां घर्मोत्तप्तविहङ्गमाम्। लीनमीनझषग्राहां कृशां गिरिनदीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40006296, "chapter_id": 8973, "verse_number": "5", "content_sanskrit": "विधूमामिव हेमाभामध्वराग्ने स्समुत्थिताम्। हविरभ्युक्षितां पश्चाच्छिखां विप्रलयं गताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40006297, "chapter_id": 8973, "verse_number": "6", "content_sanskrit": "विध्वस्तकवचां रुग्णगजवाजिरथध्वजाम्। हतप्रवीरामापन्नां चमूमिव महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40006298, "chapter_id": 8973, "verse_number": "7", "content_sanskrit": "सफेनां सस्वनां भूत्वा सागरस्य समुत्थिताम्। प्रशान्तमारुतोद्धूतां जलोर्मिमिव निस्स्वनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40006299, "chapter_id": 8973, "verse_number": "8", "content_sanskrit": "त्यक्तां यज्ञायुधैः सर्वैरभिरूपैश्च याजकैः। सुत्याकाले सुनिर्वृत्ते वेदिं गतरवामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40006300, "chapter_id": 8973, "verse_number": "9", "content_sanskrit": "गोष्ठमध्ये स्थितामार्तामचरन्तीं तृणं नवम्। गोवृषेण परित्यक्तां गवां पक्तिमिवोत्सुकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40006301, "chapter_id": 8973, "verse_number": "10", "content_sanskrit": "प्रभाकराद्यै स्सुस्निग्धैः प्रज्वलद्भिरिवोत्तमैः। वियुक्तां मणिभिर्जात्यैर्नवां मुक्तावलीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40006302, "chapter_id": 8973, "verse_number": "11", "content_sanskrit": "सहसा चलितां स्थानान्महीं पुण्यक्षयाद्गताम्। संवृतद्युतिविस्तारां तारामिव दिवश्च्युताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40006303, "chapter_id": 8973, "verse_number": "12", "content_sanskrit": "पुष्पनद्धां वसन्तान्ते मत्तभ्रमरनादिताम्। द्रुतदावाग्नि विप्लुष्टां क्लान्तां वनलतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40006304, "chapter_id": 8973, "verse_number": "13", "content_sanskrit": "सम्मूढनिगमांस्तब्धां संक्षिप्तविपणापणाम्। प्रच्छन्नशशिनक्षत्रां द्यामिवाम्बुधरैर्वृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40006305, "chapter_id": 8973, "verse_number": "14", "content_sanskrit": "क्षीणपानोत्तमैर्भग्नैः शरावैरभिसंवृताम्। हतशौण्डामिव ध्वस्तांं पानभूमिमसंस्कृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40006306, "chapter_id": 8973, "verse_number": "15", "content_sanskrit": "वृक्णभूमितलां निम्नां वृक्णपात्रैस्समावृताम्। उपयुक्तोदकां भग्नां प्रपां निपतितामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40006307, "chapter_id": 8973, "verse_number": "16", "content_sanskrit": "विपुलां विततां चैव युक्तपाशां तरस्विनाम्। भूमौ बाणैर्विनिष्कृत्तां पतितां ज्यामिवायुधात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40006308, "chapter_id": 8973, "verse_number": "17", "content_sanskrit": "सहसा युद्धशौण्डेन हयारोहेण वाहिताम्। निहतां प्रतिसैन्येन वडवामिव पातिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40006309, "chapter_id": 8973, "verse_number": "18", "content_sanskrit": "शुष्कतोयां महामत्स्यैः कूर्मैश्च बहुभिर्वृताम्। प्रभिन्नतटविस्तीर्णां वापीमिव हृतोत्पलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40006310, "chapter_id": 8973, "verse_number": "19", "content_sanskrit": "पुरुषस्याप्रहृष्टस्य प्रतिषिद्धानुलेपनाम्। सन्तप्तामिव शोकेन गात्रयष्टिमभूषणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40006311, "chapter_id": 8973, "verse_number": "20", "content_sanskrit": "प्रावृषि प्रविगाढायां प्रविष्टस्याभ्रमण्डलम्। प्रच्छन्नां नीलजीमूतैर्भास्करस्य प्रभामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40006312, "chapter_id": 8973, "verse_number": "21", "content_sanskrit": "भरतस्तु रथस्थ स्सन् श्रीमान्दशरथात्मजः। वाहयन्तं रथश्रेष्ठं सारथिं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40006313, "chapter_id": 8973, "verse_number": "22", "content_sanskrit": "किं नु खल्वद्य गम्भीरो मूर्छितो न निशम्यते। यथापुरमयोध्यायां गीतवादित्रनिस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40006314, "chapter_id": 8973, "verse_number": "23", "content_sanskrit": "वारुणीमदगन्धश्च माल्यगन्धश्च मूर्छितः। धूपितागुरुगन्धश्च न प्रवाति समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40006315, "chapter_id": 8973, "verse_number": "24", "content_sanskrit": "यानप्रवरघोषश्च स्निग्धश्च हयनिस्वनः। प्रमत्तगजनादश्च महांश्च रथनिस्वनः ॥ नेदानीं श्रूयते पुर्यामस्यां रामे विवासिते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40006316, "chapter_id": 8973, "verse_number": "25", "content_sanskrit": "चन्दनागरुगन्धांश्च महार्हाश्च नवस्रजः। गते हि रामे तरुणा स्संतप्ता नोपभुञ्जते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40006317, "chapter_id": 8973, "verse_number": "26", "content_sanskrit": "चन्दनागरुगन्धांश्च महार्हाश्च नवस्रजः। गते हि रामे तरुणा स्संतप्ता नोपभुञ्जते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40006318, "chapter_id": 8973, "verse_number": "27", "content_sanskrit": "बहिर्यात्रां न गच्छन्ति चित्रमाल्यधरा नराः। नोत्सवा स्सम्प्रवर्तन्ते रामशोकार्दिते पुरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40006319, "chapter_id": 8973, "verse_number": "28", "content_sanskrit": "सह नूनं मम भ्रात्रा पुरस्यास्य द्युतिर्गता। न हि राजत्ययोध्येयं सासारेवार्जुनी क्षपा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40006320, "chapter_id": 8973, "verse_number": "29", "content_sanskrit": "कदा नु खलु मे भ्राता महोत्सव इवाऽगतः। जनयिष्यत्ययोध्यायां हर्षं ग्रीष्म इवाम्बुदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40006321, "chapter_id": 8973, "verse_number": "30", "content_sanskrit": "तरुणैश्चारुवेषैश्च नरैरुन्नतगामिभिः। सम्पतद्भिरयोध्यायां नाभिभान्ति महापथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40006322, "chapter_id": 8973, "verse_number": "31", "content_sanskrit": "एवं बहुविधं जल्पन्विवेश वसतिं पितुः। तेन हीनां नरेन्द्रेण सिंहहीनां गुहामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]