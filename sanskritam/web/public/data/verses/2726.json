[{"id": 2081226, "chapter_id": 2726, "verse_number": "१२-२३१-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2081227, "chapter_id": 2726, "verse_number": "१२-२३१-१", "content_sanskrit": "पुनेरव तु सं शक्रः अहसन्निदमब्रवीत्।\nनिश्वसन्तं यथा गायं प्रत्याहाराय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2081228, "chapter_id": 2726, "verse_number": "१२-२३१-२", "content_sanskrit": "यथज्ञानसहस्रेण ज्ञातिभिः परिवारितः।\nलोकान्यतापयन्तर्वान्यास्यस्मानवितर्कयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2081229, "chapter_id": 2726, "verse_number": "१२-२३१-३", "content_sanskrit": "दृष्ट्वा सुकृष्णां चेमागयस्थामात्मनो बले।\nज्ञातिमित्रपरित्यक्तः शोचस्याहो न शोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2081230, "chapter_id": 2726, "verse_number": "१२-२३१-४", "content_sanskrit": "प्रीतिं प्राप्यातुलां पूर्वं लोकांश्चात्मवशे स्थितान्।\nविनिपातमिमं चाद्य शोचस्याहो न शोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2081231, "chapter_id": 2726, "verse_number": "१२-२३१-५x", "content_sanskrit": "बलिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2081232, "chapter_id": 2726, "verse_number": "१२-२३१-५", "content_sanskrit": "`गर्वं हित्वा तथा मानं देवराज शृणुष्व मे।\nमया च त्वाऽनुसद्भावं पूर्वमाचरितं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2081233, "chapter_id": 2726, "verse_number": "१२-२३१-६", "content_sanskrit": "अवश्यकालपर्यायमात्मनः परिवर्तनम्।\nअविदँल्लोकमाहात्म्यं-------॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2081234, "chapter_id": 2726, "verse_number": "१२-२३१-७", "content_sanskrit": "अनित्यमुपलक्ष्येह कालपर्यायमात्मनः।\nतस्माच्छक्र न शोचामि सर्वं ह्येवेदमन्तवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2081235, "chapter_id": 2726, "verse_number": "१२-२३१-८", "content_sanskrit": "अन्तवन्त इमे देहा भूतानां च सुराधिप।\nतेन शक्र न शोचामि नापराधादिदं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2081236, "chapter_id": 2726, "verse_number": "१२-२३१-९", "content_sanskrit": "जीवितं च शरीरं च जात्या वै सह जायते।\nउभे सह विवर्धेते उभे सह विनश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2081237, "chapter_id": 2726, "verse_number": "१२-२३१-१०", "content_sanskrit": "न हीदृशमहंभावमवशः प्राप्य केवलम्।\nयदेवमभिजानामि का व्यथा मे विजानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2081238, "chapter_id": 2726, "verse_number": "१२-२३१-११", "content_sanskrit": "भूतानां निधनं निष्ठा स्रोतसामिव सागरः।\nनैतत्सम्यग्विजानन्तो नरा मुह्यन्ति वज्रधृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2081239, "chapter_id": 2726, "verse_number": "१२-२३१-१२", "content_sanskrit": "ये त्वेवं नाभिजानन्ति रजोमोहपरायणाः।\nते कृच्छ्रं प्राप्य सीदन्ति बुद्धिर्येषां प्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2081240, "chapter_id": 2726, "verse_number": "१२-२३१-१३", "content_sanskrit": "बुद्धिलाभात्तु पुरुषः सर्वं तुदति किल्विषम्।\nविपाप्मा लभते सत्वं सत्वस्थः संप्रसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2081241, "chapter_id": 2726, "verse_number": "१२-२३१-१४", "content_sanskrit": "ततस्तु ये निवर्तन्ते जायन्ते वा पुनः पुनः।\nकृपणाः परितप्यन्ते तैरर्थैरभिचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2081242, "chapter_id": 2726, "verse_number": "१२-२३१-१५", "content_sanskrit": "अर्थसिद्धिमनर्थं च जीवितं मरणं तथा।\nसुखं दुःखं फलं चैव न द्वेष्मि न च कामये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2081243, "chapter_id": 2726, "verse_number": "१२-२३१-१६", "content_sanskrit": "हतं हन्ति हतो ह्येव यो नरो हन्ति कंचन।\nउभौ तौ न विजानीतो यश्च हन्ति हतश्च यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2081244, "chapter_id": 2726, "verse_number": "१२-२३१-१७", "content_sanskrit": "हत्वा जित्वा च मघवन्यः कश्चित्पुरुषायते।\nअकर्ता ह्येव भवति कर्ता ह्येव करोति तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2081245, "chapter_id": 2726, "verse_number": "१२-२३१-१८", "content_sanskrit": "को हि लोकस्य कुरुते विनाशप्रभवावुभौ।\nकृतं हि तत्कृतेनैव कर्ता तस्यापि चापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2081246, "chapter_id": 2726, "verse_number": "१२-२३१-१९", "content_sanskrit": "पृथिवी ज्योतिराकाशमापो वायुश्च पञ्चमः।\nएतद्योनीनि भूतानि तत्र का परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2081247, "chapter_id": 2726, "verse_number": "१२-२३१-२०", "content_sanskrit": "महाविद्योऽल्पविद्यश्च बलवान्दुर्बलश्च यः।\nदर्शनीयो विरूपश्च सुभगो दुर्भगश्च यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2081248, "chapter_id": 2726, "verse_number": "१२-२३१-२१", "content_sanskrit": "सर्वं कालः समादत्ते गम्भीरः स्वेन तेजसा।\nतस्मिन्कालवशं प्राप्ते का व्यथा मे विजानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2081249, "chapter_id": 2726, "verse_number": "१२-२३१-२२", "content_sanskrit": "दग्धमेवानुदहते हतमेवानुहन्यते।\nनश्यते नष्टमेवाग्रे लब्धव्यं लभते नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2081250, "chapter_id": 2726, "verse_number": "१२-२३१-२३", "content_sanskrit": "नास्य द्वीपः कुतः पारो नावारः संप्रदृश्यते।\nनान्तमस्य प्रपश्यामि विधेर्दिव्यस्य चिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2081251, "chapter_id": 2726, "verse_number": "१२-२३१-२४", "content_sanskrit": "यदि मे पश्यतः कालो भूतानि न विनाशयेत्।\nस्यान्मे हर्षश्च दर्पश्च क्रोधश्चैव शचीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2081252, "chapter_id": 2726, "verse_number": "१२-२३१-२५", "content_sanskrit": "तुषभक्षं तु मां ज्ञात्वा प्रविविक्तजने गृहे।\nबिभ्रतं गार्दभं रूपमागत्य परिगर्हसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2081253, "chapter_id": 2726, "verse_number": "१२-२३१-२६", "content_sanskrit": "इच्छन्नहं विकुर्यां हि रूपाणि बहृधाऽऽत्मनः।\nविभीषणानि यानीक्ष्य पलायेथास्त्वमेव मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2081254, "chapter_id": 2726, "verse_number": "१२-२३१-२७", "content_sanskrit": "कालः सर्वं समादत्ते कालः सर्वं प्रयच्छति।\nकालेन विहितं सर्वं मा कृथाः शक्र पौरुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2081255, "chapter_id": 2726, "verse_number": "१२-२३१-२८", "content_sanskrit": "पुरा सर्वं प्रव्यथितं मयि क्रुद्धे पुरंदर।\n`विद्रवन्ति त्वया सार्धं सर्व एव दिबौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2081256, "chapter_id": 2726, "verse_number": "१२-२३१-२९", "content_sanskrit": "अवैमि त्वस्य लोकस्य कर्मं शक्र सनातनम्।\nत्वमप्येवमवेक्षस्व माऽऽत्मना विस्मगं गमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2081257, "chapter_id": 2726, "verse_number": "१२-२३१-३०", "content_sanskrit": "प्रभवश्च प्रभावश्च नात्मसंस्थः कदाचन।\nकौमारमेव ते चित्तं तथैवाद्य यथा पुरा।\nसमवेक्षस्व मघवन्बुद्धिं विन्दस्व नैष्ठिकीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2081258, "chapter_id": 2726, "verse_number": "१२-२३१-३१", "content_sanskrit": "देवा मनुष्याः पितरो गन्धर्वोरगराक्षसाः।\nआसन्सर्वे मम वशे तत्सर्वं वेत्थ वासव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2081259, "chapter_id": 2726, "verse_number": "१२-२३१-३२", "content_sanskrit": "नमस्तस्यै दिशेऽप्यस्तु यस्यां वैरोचनो बलिः।\nइति मामभ्यपद्यन्त बुद्धिमात्सर्यमोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2081260, "chapter_id": 2726, "verse_number": "१२-२३१-३३", "content_sanskrit": "नाहं तदनुशोचामि नात्मभ्रंशं शचीपते।\nएवं मे निश्चिता बुद्धिः शास्तुस्तिष्ठाम्यहं वशे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2081261, "chapter_id": 2726, "verse_number": "१२-२३१-३४", "content_sanskrit": "दृश्यते हि कुले जातो दर्शनीयः प्रतापवान्।\nदुःखं जीवन्सहामात्यो भवितव्यं हि तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2081262, "chapter_id": 2726, "verse_number": "१२-२३१-३५", "content_sanskrit": "दौष्कुलेयस्तथा मूढो दुर्जातः शक्र दृश्यते।\nसुखं जीवन्सहामात्यो भवितव्यं हि तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2081263, "chapter_id": 2726, "verse_number": "१२-२३१-३६", "content_sanskrit": "कल्याणी रूपसंपन्ना दुर्भगा शक्र दृश्यते।\nअलक्षणा विरूपा च सुभगा दृश्यते परा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2081264, "chapter_id": 2726, "verse_number": "१२-२३१-३७", "content_sanskrit": "नैतदस्मत्कृतं शक्र नैतच्छक्र त्वया कृतम्।\nयत्तमेवं गतो वज्रिन्यच्चाप्येवं गता वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2081265, "chapter_id": 2726, "verse_number": "१२-२३१-३८", "content_sanskrit": "न कर्म तव नान्येषां कुतो मम शतक्रतो।\nऋद्धिर्वाऽप्यथवा नर्द्धिः पर्यायकृतमेव तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2081266, "chapter_id": 2726, "verse_number": "१२-२३१-३९", "content_sanskrit": "पश्यामि त्वां विराजन्तं देवराजमवस्थितम्।\nश्रीमन्तं द्युतिमन्तं च गर्जमानं ममोपरि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2081267, "chapter_id": 2726, "verse_number": "१२-२३१-४०", "content_sanskrit": "एवं नैव न चेत्कालो मामाक्रम्य स्थितो भवेत्।\nपातयेयमहं त्वाऽद्य सवज्रमपि मुष्टिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2081268, "chapter_id": 2726, "verse_number": "१२-२३१-४१", "content_sanskrit": "न तु विक्रमकालोऽयं शान्तिकालोऽयमागतः।\nकालः स्थापयते सर्वं कालः पचति वै तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2081269, "chapter_id": 2726, "verse_number": "१२-२३१-४२", "content_sanskrit": "मां चेदभ्यागतः कालो दानवेश्वरमूर्जितम्।\nगर्जन्तं प्रतपन्तं च कमन्यं नागमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2081270, "chapter_id": 2726, "verse_number": "१२-२३१-४३", "content_sanskrit": "द्वादशानां तु भवतामादित्यानां महात्मनाम्।\nतेजांस्येकेन सर्वेषां देवराज धृतानि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2081271, "chapter_id": 2726, "verse_number": "१२-२३१-४४", "content_sanskrit": "अहमेवोद्वहाम्यापो विसृजामि च वासव।\nतपामि चैव त्रैलोक्यं विद्योताम्यहमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2081272, "chapter_id": 2726, "verse_number": "१२-२३१-४५", "content_sanskrit": "संरक्षामि विलुम्पामि ददाम्यहमथाददे।\nसंयच्छामि नियच्छामि लोकेषु प्रभुरीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2081273, "chapter_id": 2726, "verse_number": "१२-२३१-४६", "content_sanskrit": "तदद्य विनिवृत्तं मे प्रभुत्वममराधिप।\nकालसैन्यावगाढस्य सर्वं न प्रतिभाति मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2081274, "chapter_id": 2726, "verse_number": "१२-२३१-४७", "content_sanskrit": "नाहं कर्ता न चैव त्वं नान्यः कर्ता शचीपते।\nपर्यायेण हि भुज्यन्ते लोकाः शक्र यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2081275, "chapter_id": 2726, "verse_number": "१२-२३१-४८", "content_sanskrit": "मासमासार्धवेश्मानमहोरात्राभिसंवृतम्।\nऋतुद्वारं वायुमुखमायुर्वेदविदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2081276, "chapter_id": 2726, "verse_number": "१२-२३१-४९", "content_sanskrit": "आहुः सर्वमिदं चिन्त्यं जनाः केचिन्मनीषया।\n`अनित्यपञ्चवर्षाणि षष्ठो दृश्यति देहिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2081277, "chapter_id": 2726, "verse_number": "१२-२३१-५०", "content_sanskrit": "अस्याः पञ्चैव चिन्तायाः पर्येष्यामि च पञ्चधा।\n`ततस्तानि न पश्यामि काले तमपि वृत्रहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2081278, "chapter_id": 2726, "verse_number": "१२-२३१-५१", "content_sanskrit": "गम्भीरं गहनं ब्रह्म महत्तोयार्णवं यथा।\nअनादिनिधनं चाहुरक्षरं क्षरमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2081279, "chapter_id": 2726, "verse_number": "१२-२३१-५२", "content_sanskrit": "सत्त्वेषु लिङ्गमाविश्य निर्लिङ्गमपि तत्स्वयम्।\nमन्यन्ते ध्रुवमेवैनं ये जनास्तत्त्वदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2081280, "chapter_id": 2726, "verse_number": "१२-२३१-५३", "content_sanskrit": "`यमिन्द्रियाणि सर्वाणि नानुपश्यन्ति पञ्चधा।\nतं कालमिति जानीहि यस्य सर्वमिदं वशे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2081281, "chapter_id": 2726, "verse_number": "१२-२३१-५४", "content_sanskrit": "भूतानां तु विषर्यासं कुरुते भगवानिति।\nन ह्येतावद्भवेद्ग्राम्यं न यस्मात्प्रभवेत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2081282, "chapter_id": 2726, "verse_number": "१२-२३१-५५", "content_sanskrit": "गतिं हि सर्वभूतानामगत्वा क्व गमिष्यति।\nयो धावता न हातव्यस्तिष्ठन्नपि न हीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2081283, "chapter_id": 2726, "verse_number": "१२-२३१-५६", "content_sanskrit": "तमिन्द्रियाणि सर्वाणि नानुपश्यन्ति पञ्चधा।\nआहुश्चैनं केचिदग्निं केचिदाहुः प्रजापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2081284, "chapter_id": 2726, "verse_number": "१२-२३१-५७", "content_sanskrit": "ऋतून्मासार्धमासांश्च दिवसांश्च क्षणांस्तथा।\nपूर्वाह्णमपराह्णं च मध्याह्नमपि चापरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2081285, "chapter_id": 2726, "verse_number": "१२-२३१-५८", "content_sanskrit": "मुहूर्तमपि चैवाहुरेकं सन्तमनेकधा।\nतं कालमिति जानीहि यस्य सर्वमिदं वशे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2081286, "chapter_id": 2726, "verse_number": "१२-२३१-५९", "content_sanskrit": "बहूनीन्द्रसहस्राणि समतीतानि वासव।\nबलवीर्योपपन्नानि यथैव त्वं शचीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2081287, "chapter_id": 2726, "verse_number": "१२-२३१-६०", "content_sanskrit": "त्वामप्यतिबलं शक्र देवराजं बलोत्कटम्।\nप्राप्ते काले महावीर्यः कालः संशमयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2081288, "chapter_id": 2726, "verse_number": "१२-२३१-६१", "content_sanskrit": "य इदं सर्वमादत्ते तस्माच्छक्र स्थिरो भव।\nमया त्वया च पूर्वैश्च न स शक्योऽतिवर्तितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2081289, "chapter_id": 2726, "verse_number": "१२-२३१-६२", "content_sanskrit": "यामेतां प्राप्य जानीषे राज्यश्रियमनुत्तमाम्।\nस्थिता मयीति तन्मिथ्या नैषा ह्येकत्र तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2081290, "chapter_id": 2726, "verse_number": "१२-२३१-६३", "content_sanskrit": "स्थिता हीन्द्रसहस्रेषु त्वद्विशिष्टतमेष्वियम्।\nमां च लोला परित्यज्य त्वामगाद्विबुधाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2081291, "chapter_id": 2726, "verse_number": "१२-२३१-६४", "content_sanskrit": "मैवं शक्र पुनः कार्षीः शान्तो भवितुमर्हसि।\nत्वामप्येवंविधं ज्ञात्वा क्षिप्रमन्यं गमिष्यति।\n`कालेन चोदिता शक्र मा ते गर्वः शतक्रतो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2081292, "chapter_id": 2726, "verse_number": "१२-२३१-६५", "content_sanskrit": "क्षमस्व कालयोगं तमागतं विद्धि देवप।\nनिर्लज्जश्चैव कस्मात्त्वं देवराज विकत्थसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2081293, "chapter_id": 2726, "verse_number": "१२-२३१-६६", "content_sanskrit": "सर्वासुराणामधिपः सर्वदेवभयंकरः।\nजितवान्ब्रह्मणो लोकं को विद्यादागतं गतिम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2081294, "chapter_id": 2726, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकत्रिंशदधिकद्विशततमोऽध्यायः॥ २३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]