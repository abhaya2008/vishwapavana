[{"id": 7002980000, "chapter_id": 22980, "verse_number": "२-२७-१", "content_sanskrit": "सावित्र्युवाच ।\nप्रयांति स्वर्गमन्यं च येन येनैव कर्म्मणा ।\nमानवाः पुण्यवन्तश्च तन्मे व्याख्यातुमर्हसि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002980001, "chapter_id": 22980, "verse_number": "२-२७-२", "content_sanskrit": "यम उवाच ।\nअन्नदानं च विप्राय यः करोति च भारते ।\nअन्नप्रमाणवर्ष च शक्रलोके महीयते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002980002, "chapter_id": 22980, "verse_number": "२-२७-३", "content_sanskrit": "अन्नदानात्परं दानं न भूतं न भविष्यति ।\nनात्र पात्रपरीक्षा स्यान्न कालनियमः क्वचित् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002980003, "chapter_id": 22980, "verse_number": "२-२७-४", "content_sanskrit": "देवेभ्यो ब्राह्मणेभ्यो वा ददाति चासनं यदि ।\nमहीयते वह्निलोके वर्षाणामयुतं ध्रुवम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002980004, "chapter_id": 22980, "verse_number": "२-२७-५", "content_sanskrit": "यो ददाति च विप्राय दिव्यां धेनुं पयस्विनीम् ।\nतल्लोममानवर्णं च वैकुण्ठे च महीयते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002980005, "chapter_id": 22980, "verse_number": "२-२७-६", "content_sanskrit": "चतुर्गुणं पुण्यदिने तीर्थे शतगुणं फलम् ।\nदानं नारायणक्षेत्रे फलं कोटिगुणं भवेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002980006, "chapter_id": 22980, "verse_number": "२-२७-७", "content_sanskrit": "गां यो ददाति विप्राय भारते भक्तिपूर्वकम् ।\nवर्षाणामयुतं चैव चन्द्रलोके महीयते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002980007, "chapter_id": 22980, "verse_number": "२-२७-८", "content_sanskrit": "यश्चोभयमुखीदानं करोति ब्राह्मणाय च ।\nतल्लोममानवर्षं च वैकुण्ठे च महीयते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002980008, "chapter_id": 22980, "verse_number": "२-२७-९", "content_sanskrit": "यो ददाति ब्राह्मणाय शालिग्रामं सवस्त्रकम् ।\nमहीयते स वैकुण्ठे यावच्चन्द्रदिवाकरौ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002980009, "chapter_id": 22980, "verse_number": "२-२७-१०", "content_sanskrit": "यो ददाति ब्राह्मणाय छत्रं च सुमनोहरम् ।\nवर्षाणामयुतं सोऽपि मोदते वरुणालये ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002980010, "chapter_id": 22980, "verse_number": "२-२७-११", "content_sanskrit": "विप्राय पादुकायुग्मं यो ददाति च भारते ।\nमहीयते वायुलोके वर्षाणामयुतं सति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002980011, "chapter_id": 22980, "verse_number": "२-२७-१२", "content_sanskrit": "यो ददाति ब्राह्मणाय शय्यां दिव्यां मनोहराम् ।\nमहीयते चन्द्रलोके यावच्चन्द्रदिवाकरौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002980012, "chapter_id": 22980, "verse_number": "२-२७-१३", "content_sanskrit": "यो ददाति प्रदीपं च देवाय ब्राह्मणाय च ।\nयावन्मन्वन्तरं सोऽपि ब्रह्मलोके महीयते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002980013, "chapter_id": 22980, "verse_number": "२-२७-१४", "content_sanskrit": "सम्प्राप्य मानवीं योनिं चक्षुष्मांश्च भवेद्ध्रुवम् ।\nन याति यमलोकं च तेन पुण्येन सुन्दरि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002980014, "chapter_id": 22980, "verse_number": "२-२७-१५", "content_sanskrit": "करोति गजदानं च यो हि विप्राय भारते ।\nयावदिन्द्रादिदेवस्य लोके चार्धासने वसेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002980015, "chapter_id": 22980, "verse_number": "२-२७-१६", "content_sanskrit": "भारते योऽश्वदानं च करोति ब्राह्मणाय च ।\nमोदते वारुणे लोके यावदिन्द्राश्चतुर्दश ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002980016, "chapter_id": 22980, "verse_number": "२-२७-१७", "content_sanskrit": "प्रकृष्टां शिबिकां यो हि ददाति ब्राह्मणाय च ।\nमहीयते विष्णुलोके यावन्मन्वन्तरं सति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002980017, "chapter_id": 22980, "verse_number": "२-२७-१८", "content_sanskrit": "यो ददाति च विप्राय व्यजनं श्वेतचामरम् ।\nमहीयते वायुलोके वर्षाणामयुतं ध्रुवम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002980018, "chapter_id": 22980, "verse_number": "२-२७-१९", "content_sanskrit": "धान्याचलं यो ददाति ब्राह्मणाय च भारते ।\nस च धान्यप्रमाणाब्दं विष्णुलोके महीयते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002980019, "chapter_id": 22980, "verse_number": "२-२७-२०", "content_sanskrit": "ततः स्वयोनिं संप्राप्य चिरजीवी भवेत्सुखी ।\nदाता ग्रहीता तौ द्वौ च ध्रुवं वैकुण्ठगामिनौ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002980020, "chapter_id": 22980, "verse_number": "२-२७-२१", "content_sanskrit": "सततं श्रीहरेर्नाम भारते यो जपेन्नरः ।\nस एव चिरजीवी च ततो मृत्युः पलायते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002980021, "chapter_id": 22980, "verse_number": "२-२७-२२", "content_sanskrit": "यो नरो भारते वर्षे दोलनं कारयेद्धरेः ।\nपूर्णिमारजनीशेषे जीवन्मुक्तो भवेन्नरः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002980022, "chapter_id": 22980, "verse_number": "२-२७-२३", "content_sanskrit": "इह लोके सुखं भुक्त्वा यात्यन्ते विष्णुमन्दिरम् ।\nनिश्चितं निवसेत्तत्र शतमन्वन्तरावधि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002980023, "chapter_id": 22980, "verse_number": "२-२७-२४", "content_sanskrit": "फलमुत्तरफाल्गुन्यां ततोऽपि द्विगुणं भवेत् ।\nकल्पान्तजीवी स भवेदित्याह कमलोद्भवः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002980024, "chapter_id": 22980, "verse_number": "२-२७-२५", "content_sanskrit": "तिलदानं ब्राह्मणाय यः करोति च भारते ।\nतिलप्रमाणवर्षं च मोदते विष्णुमन्दिरे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002980025, "chapter_id": 22980, "verse_number": "२-२७-२६", "content_sanskrit": "ततः स्वयोनिं संप्राप्य चिरजीवी भवेत्सुखी ।\nताम्रपात्रस्थदानेन द्विगुणं च फलं लभेत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002980026, "chapter_id": 22980, "verse_number": "२-२७-२७", "content_sanskrit": "सालंकृतां च भोग्यां च सवस्त्रां सुन्दरीं प्रियाम् ।\nयो ददाति ब्राह्मणा य भारते च पतिव्रताम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002980027, "chapter_id": 22980, "verse_number": "२-२७-२८", "content_sanskrit": "महीयते चन्द्रलोके यावदिन्द्राश्चतुर्दश ।\nतत्र स्वर्वेश्यया सार्द्धं मोदते च दिवानिशम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002980028, "chapter_id": 22980, "verse_number": "२-२७-२९", "content_sanskrit": "ततो गन्धर्वलोके च वर्षाणामयुतं सति ।\nदिवानिशं कौतुकेन चोर्वश्या सह मोदते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002980029, "chapter_id": 22980, "verse_number": "२-२७-३०", "content_sanskrit": "ततो जन्मसहस्रं च प्राप्नोति सुन्दरीं प्रियाम् ।\nसतीं सौभाग्ययुक्तां च कोमलां प्रियवादिनीम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002980030, "chapter_id": 22980, "verse_number": "२-२७-३१", "content_sanskrit": "ददाति सफलं वृक्षं ब्राह्मणाय च यो नरः ।\nफलप्रमाणवर्षं च शक्रलोके महीयते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002980031, "chapter_id": 22980, "verse_number": "२-२७-३२", "content_sanskrit": "पुनः स्वयोनिं संप्राप्य लभते सुतमुत्तमम् ।\nसफलानां च वृक्षाणां सहस्रं च प्रशंसितम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002980032, "chapter_id": 22980, "verse_number": "२-२७-३३", "content_sanskrit": "केवलं फलदानं च ब्राह्मणाय ददाति यः ।\nसुचिरं स्वर्गवासं च कृत्वा याति च भारतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002980033, "chapter_id": 22980, "verse_number": "२-२७-३४", "content_sanskrit": "नानाद्रव्यसमायुक्तं नानासस्यसमन्वितम् ।\nददाति यश्च विप्राय भारते विपुलं गृहम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002980034, "chapter_id": 22980, "verse_number": "२-२७-३५", "content_sanskrit": "कुबेरलोके वसति स च मन्वन्तरावधि ।\nततः स्वयोनिं संप्राप्य महांश्च धनवान्भवेत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002980035, "chapter_id": 22980, "verse_number": "२-२७-३६", "content_sanskrit": "यो जनः सस्यसंयुक्तां भूमिं च रुचिरां सति ।\nददाति भक्त्या विप्राय पुण्यक्षेत्रे च वा सति॥ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002980036, "chapter_id": 22980, "verse_number": "२-२७-३७", "content_sanskrit": "महीयते स वैकुण्ठे मन्वन्तरशतं ध्रुवम् ।\nपुनः स्वयोनिं संप्राप्य महांश्च भूमिवान्भवेत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002980037, "chapter_id": 22980, "verse_number": "२-२७-३८", "content_sanskrit": "तं न त्यजति भूमिश्च जन्मनां शतकं परम् ।\nश्रीमांश्च धनवांश्चैव पुत्रवांश्च प्रजेश्वरः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002980038, "chapter_id": 22980, "verse_number": "२-२७-३९", "content_sanskrit": "सप्रजं च प्रकृष्टं च ग्रामं दद्याद्द्विजातये ।\nलक्षमन्वन्तरं चैव वैकुण्ठे स महीयते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002980039, "chapter_id": 22980, "verse_number": "२-२७-४०", "content_sanskrit": "पुनः स्वयोनिं संप्राप्य ग्रामलक्षं लभेद्ध्रुवम् ।\nन जहाति च तं पृथ्वी जन्मनां लक्षमेव च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002980040, "chapter_id": 22980, "verse_number": "२-२७-४१", "content_sanskrit": "सप्रजं सुप्रकृष्टं च पञ्चसस्यसमन्वितम् ।\nनानापुष्करिणीवृक्षफलभोगसमन्वितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002980041, "chapter_id": 22980, "verse_number": "२-२७-४२", "content_sanskrit": "नगरं यश्च विप्राय ददाति भारते भुवि ।\nमहीयते स वैकुण्ठे दशलक्षेन्द्रकालकम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002980042, "chapter_id": 22980, "verse_number": "२-२७-४३", "content_sanskrit": "पुनः स्वयोनिं संप्राप्य राजेन्द्रो भारते भवेत् ।\nनगराणां च नियुतं लभते नात्र संशयः॥ ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002980043, "chapter_id": 22980, "verse_number": "२-२७-४४", "content_sanskrit": "धरा तं न जहात्येव जन्मनां नियुतं ध्रुवम् ।\nपरमैश्वर्य संयुक्तो भवेदेव महीतले ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002980044, "chapter_id": 22980, "verse_number": "२-२७-४५", "content_sanskrit": "नगराणां च शतकं देशं यो हि द्विजातये ।\nसुप्रकृष्टप्रजायुक्तं ददाति भक्तिपूर्वकम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002980045, "chapter_id": 22980, "verse_number": "२-२७-४६", "content_sanskrit": "वापीतडागसंयुक्तं नानावृक्षसमन्वितम् ।\nमहीयते स वैकुण्ठे कोटिमन्वन्तरावधि ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002980046, "chapter_id": 22980, "verse_number": "२-२७-४७", "content_sanskrit": "पुनः स्वयोनिं संप्राप्य जम्बूद्वीपपतिर्भवेत् ।\nपरमैश्वर्य्यसंयुक्तो यथा शक्रस्तथा भुवि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002980047, "chapter_id": 22980, "verse_number": "२-२७-४८", "content_sanskrit": "मही तं न जहात्येव जन्मनां कोटिमेव च ।\nकल्पान्तजीवी स भवेद्राजराजेश्वरो महान् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002980048, "chapter_id": 22980, "verse_number": "२-२७-४९", "content_sanskrit": "स्वाधिकारं समग्रं च यो ददाति द्विजातये ।\nचतुर्गुण फलं चातो भवेत्तस्य न संशयः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002980049, "chapter_id": 22980, "verse_number": "२-२७-५०", "content_sanskrit": "जम्बूद्वीपं यो ददाति ब्राह्मणाय पतिव्रते ।\nफलं शतगुणं चातो भवेत्तस्य न संशयः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002980050, "chapter_id": 22980, "verse_number": "२-२७-५१", "content_sanskrit": "सप्तद्वीपमहीदातुः सर्वतीर्थानुसेविनः ।\nसर्वेषां तपसां कर्त्तुः सर्वोपवासकारिणः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002980051, "chapter_id": 22980, "verse_number": "२-२७-५२", "content_sanskrit": "सर्वदानप्रदातुश्च सर्वसिद्धेश्वरस्य च ।\nअस्त्येव पुनरावृत्तिर्न भक्तस्य हरेरहो ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002980052, "chapter_id": 22980, "verse_number": "२-२७-५३", "content_sanskrit": "असंख्यब्रह्मणा पातं पश्यन्ति वैष्णवाः सति ।\nनिवसन्ति हि गोलोके वैकुण्ठे वा हरेः पदे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002980053, "chapter_id": 22980, "verse_number": "२-२७-५४", "content_sanskrit": "विष्णुमन्त्रोपासकश्च विहाय मानवीं तनुम् ।\nबिभर्त्ति दिव्यरूपं च जन्ममृत्युजरापहम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002980054, "chapter_id": 22980, "verse_number": "२-२७-५५", "content_sanskrit": "लब्ध्वा विष्णोश्च सारूप्यं विष्णुसेवां करोति च ।\nस च पश्यति गोलोके ह्यसंख्यं प्राकृतं लयम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002980055, "chapter_id": 22980, "verse_number": "२-२७-५६", "content_sanskrit": "नश्यन्ति देवाः सिद्धाश्च विश्वानि निखिलानि च ।\nकृष्णभक्ता न नश्यन्ति जन्ममृत्युजराहराः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002980056, "chapter_id": 22980, "verse_number": "२-२७-५७", "content_sanskrit": "कार्त्तिके तुलसीदानं करोति हरये च यः ।\nयुगं पत्रप्रमाणं च मोदते हरिमन्दिरे ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002980057, "chapter_id": 22980, "verse_number": "२-२७-५८", "content_sanskrit": "पुनः स्वयोनिं संप्राप्य हरिभक्तिं लभेद्ध्रुवम् ।\nसुखी च चिरजीवी च स भवेद्भारते भुवि ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002980058, "chapter_id": 22980, "verse_number": "२-२७-५९", "content_sanskrit": "घृतप्रदीपं हरये कार्त्तिके यो ददाति च ।\nपलप्रमाणं वर्षं च मोदते हरिमन्दिरे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002980059, "chapter_id": 22980, "verse_number": "२-२७-६०", "content_sanskrit": "पुनः स्वयोनिं संप्राप्य विष्णुभक्तिं लभेद्ध्रुवम् ।\nमहाधनाढ्यः स भवेच्चक्षुष्मांश्चैव दीप्तिमान् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002980060, "chapter_id": 22980, "verse_number": "२-२७-६१", "content_sanskrit": "माघे यः स्नाति गङ्गायामरुणोदयकालतः ।\nयुगषष्टिसहस्राणि मोदते हरिमन्दिरे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002980061, "chapter_id": 22980, "verse_number": "२-२७-६२", "content_sanskrit": "पुनः स्वयोनिं संप्राप्य विष्णुभक्तिं लभेद्ध्रुवम् ।\nजितेन्द्रियाणां प्रवरः स भवेद्भारते भुवि ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002980062, "chapter_id": 22980, "verse_number": "२-२७-६३", "content_sanskrit": "माघे यः स्नाति गंगायां प्रयागे चारुणोदये ।\nवैकुण्ठे मोदते सोऽपि लक्षमन्वन्तरावधि ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002980063, "chapter_id": 22980, "verse_number": "२-२७-६४", "content_sanskrit": "पुनः स्वयोनिं संप्राप्य विष्णुमन्त्रं लभेद्ध्रुवम् ।\nत्यक्त्वा च मानुषं देहं पुनर्याति हरेः पदम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002980064, "chapter_id": 22980, "verse_number": "२-२७-६५", "content_sanskrit": "नास्ति तत्पुनरावृत्तिर्वैकुण्ठाच्च महीतले ।\nकरोति हरिदास्यं च लब्ध्वा सारूप्यमेव च ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002980065, "chapter_id": 22980, "verse_number": "२-२७-६६", "content_sanskrit": "नित्यस्नायी च गङ्गायां स पूतः सूर्य्यवद्भुवि ।\nपदे पदेऽश्वमेधस्य लभते निश्चितं फलम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002980066, "chapter_id": 22980, "verse_number": "२-२७-६७", "content_sanskrit": "तस्यैव पादरजसा सद्यः पूता वसुन्धरा ।\nमोदते स च वैकुण्ठे यावच्चन्द्रदिवाकरौ ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002980067, "chapter_id": 22980, "verse_number": "२-२७-६८", "content_sanskrit": "पुनः स्वयोनिं संप्राप्य तपस्विप्रवरो भवेत् ।\nस्वधर्मनिरतः शुद्धो विद्वांश्च सुजितेन्द्रियः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002980068, "chapter_id": 22980, "verse_number": "२-२७-६९", "content_sanskrit": "मीनकर्कटयोर्मध्ये गाढं तपति भास्करे ।\nभारते यो ददात्येव जलमेव सुवासितम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002980069, "chapter_id": 22980, "verse_number": "२-२७-७०", "content_sanskrit": "मोदते स च वैकुण्ठे यावदिन्द्राश्चतुर्दश ।\nपुनः स्वयोनिं संप्राप्य सुखी निष्कपटो भवेत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002980070, "chapter_id": 22980, "verse_number": "२-२७-७१", "content_sanskrit": "वैशाखे हरये भक्त्या यो ददाति च चन्दनम् ।\nयुगषष्टिसहस्राणि मोदते विष्णुमन्दिरे ।\nपुनः स्वयोनिं संप्राप्य रूपवांश्च सुखी भवेत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002980071, "chapter_id": 22980, "verse_number": "२-२७-७२", "content_sanskrit": "वैशाखे सक्तुदानं च यः करोति द्विजातये ।\nसक्तुरेणुप्रमाणाब्दं मोदते विष्णुमन्दिरे ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002980072, "chapter_id": 22980, "verse_number": "२-२७-७३", "content_sanskrit": "करोति भारते यो हि कृष्णजन्माष्टमीव्रतम् ।\nशतजन्मकृतात्पापान्मुच्यते नात्र संशयः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002980073, "chapter_id": 22980, "verse_number": "२-२७-७४", "content_sanskrit": "वैकुण्ठे मोदते सोऽपि यावदिन्द्राश्चतुर्दश ।\nपुनः स्वयोनिं संप्राप्य कृष्णभक्तिं लभेद्ध्रुवम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002980074, "chapter_id": 22980, "verse_number": "२-२७-७५", "content_sanskrit": "इहैव भारते वर्षे शिवरात्रिं करोति यः ।\nमोदते शिवलोके च सप्तमन्वन्तरावधि ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002980075, "chapter_id": 22980, "verse_number": "२-२७-७६", "content_sanskrit": "शिवाय शिवरात्रौ च बिल्वपत्रं ददाति यः ।\nपत्रप्रमाणं च युगं मोदते शिवमन्दिरे ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002980076, "chapter_id": 22980, "verse_number": "२-२७-७७", "content_sanskrit": "पुनः स्वयोनिं संप्राप्य शिवभक्तिं लभेद्ध्रुवम् ।\nविद्यावान्पुत्रवाञ्छ्रीमान्प्रजावान्भूमिवान्भवेत् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002980077, "chapter_id": 22980, "verse_number": "२-२७-७८", "content_sanskrit": "चैत्रमासेऽथवा माघे शङ्करं योऽर्चयेद्व्रती ।\nकरोति नर्त्तनं भक्त्या वेत्रपाणिर्दिवानिशम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002980078, "chapter_id": 22980, "verse_number": "२-२७-७९", "content_sanskrit": "मासं वाप्यर्द्धमासं वा दश सप्तदिनानि वा ।\nदिनमानं युगं सोऽपि शिवलोके महीयते ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002980079, "chapter_id": 22980, "verse_number": "२-२७-८०", "content_sanskrit": "श्रीरामनवमीं यो हि करोति भारते नरः ।\nसप्तमन्वन्तरं यावन्मोदते विष्णुमन्दिरे ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002980080, "chapter_id": 22980, "verse_number": "२-२७-८१", "content_sanskrit": "पुनः स्वयोनिं संप्राप्य रामभक्तिं लभेद्ध्रुवम् ।\nजितेन्द्रियाणां प्रवरो महांश्च धार्मिको भवेत् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002980081, "chapter_id": 22980, "verse_number": "२-२७-८२", "content_sanskrit": "शारदीयां महापूजां प्रकृतेर्यः करोति च ।\nमहिषैश्छागलैर्मेषैरिक्षुकूष्माण्डकैस्तथा ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002980082, "chapter_id": 22980, "verse_number": "२-२७-८३", "content_sanskrit": "नैवेद्यैरुपहारैश्च धूपदीपादिभिस्तथा ।\nनृत्यगीतादिभिर्वाद्यैर्नानाकौतुकमङ्गलैः॥ ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002980083, "chapter_id": 22980, "verse_number": "२-२७-८४", "content_sanskrit": "शिवलोके वसेत्सोऽपि सप्तमन्वन्तरावधि ।\nपुनः स्वयोनिं संप्राप्य बुद्धिं च निर्मलां लभेत् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002980084, "chapter_id": 22980, "verse_number": "२-२७-८५", "content_sanskrit": "अचलां श्रियमाप्नोति पुत्रपौत्रादिवर्द्धिनीम् ।\nमहाप्रभावयुक्तश्च गजवाजिसमन्वितः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002980085, "chapter_id": 22980, "verse_number": "२-२७-८६", "content_sanskrit": "राजराजेश्वरः सोऽपि भवेदेव न संशयः ।\nभाद्रशुक्लाष्टमीं प्राप्य महालक्ष्मीं च योऽर्चयेत् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002980086, "chapter_id": 22980, "verse_number": "२-२७-८७", "content_sanskrit": "नित्यं भक्त्या पक्षमेकं पुण्यक्षेत्रे च भारते ।\nदत्त्वा तस्यै प्रकृष्टानि चोपचाराणि षोडश ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002980087, "chapter_id": 22980, "verse_number": "२-२७-८८", "content_sanskrit": "वैकुण्ठे मोदते सोऽपि यावच्चन्द्रदिवाकरौ ।\nपुनः स्वयोनिं संप्राप्य राजराजेश्वरो भवेत् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002980088, "chapter_id": 22980, "verse_number": "२-२७-८९", "content_sanskrit": "कार्तिकीपूर्णिमायां च कृत्वा तु रासमण्डलम् ।\nगोपानां शतकं कृत्वा गोपीनां शतकं तथा ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002980089, "chapter_id": 22980, "verse_number": "२-२७-९०", "content_sanskrit": "शिलायां प्रतिमायां वा श्रीकृष्णं राधया सह ।\nभारते पूजयेद्दत्त्वा चोपचाराणि षोडश ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002980090, "chapter_id": 22980, "verse_number": "२-२७-९१", "content_sanskrit": "गोलोके च वसेत्सोऽपि यावद्वै ब्रह्मणो वयः ।\nभारतं पुनरागत्य हरिभक्तिं लभेद्ध्रुवम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7002980091, "chapter_id": 22980, "verse_number": "२-२७-९२", "content_sanskrit": "क्रमेण सुदृढां भक्तिं लब्ध्वा मन्त्रं हरेरपि ।\nदेहं त्यक्त्वा च गोलोकं पुनरेव प्रयाति सः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7002980092, "chapter_id": 22980, "verse_number": "२-२७-९३", "content_sanskrit": "तत्र कृष्णस्य सारूप्यं संप्राप्य पार्षदो भवेत् ।\nपुनस्तत्पतनं नास्ति जरामृत्युहरो महान् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7002980093, "chapter_id": 22980, "verse_number": "२-२७-९४", "content_sanskrit": "शुक्लां वाऽप्यथवा कृष्णां करोत्येकादशीं च यः ।\nवैकुण्ठे मोदते सोऽपि यावद्वै ब्रह्मणो वयः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7002980094, "chapter_id": 22980, "verse_number": "२-२७-९५", "content_sanskrit": "भारतं पुनरागत्य हरिभक्तिं लभेद्ध्रुवम् ।\nपुनर्याति च वैकुण्ठं न तस्य पतनं भवेत् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7002980095, "chapter_id": 22980, "verse_number": "२-२७-९६", "content_sanskrit": "भाद्रे शुक्ले च द्वादश्यां यः शक्रं पूजयेन्नरः ।\nषष्टिवर्षसहस्राणि शक्रलोके महीयते ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7002980096, "chapter_id": 22980, "verse_number": "२-२७-९७", "content_sanskrit": "रविवारेऽर्कसंक्रान्त्यां सप्तम्यां शुक्लपक्षतः ।\nसम्पूज्यार्कं हविष्यान्नं यः करोति च भारते ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7002980097, "chapter_id": 22980, "verse_number": "२-२७-९८", "content_sanskrit": "महीयते सोऽर्कलोके यावच्चन्द्रदिवाकरौ ।\nभारतं पुनरागत्य चारोगी श्रीयुतो भवेत् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7002980098, "chapter_id": 22980, "verse_number": "२-२७-९९", "content_sanskrit": "ज्येष्ठशुक्लचतुर्दश्यां सावित्रीं यो हि पूजयेत् ।\nमहीयते ब्रह्मलोके सप्तमन्वन्तरावधि ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7002980099, "chapter_id": 22980, "verse_number": "२-२७-१००", "content_sanskrit": "पुनर्महीं समागत्य श्रीमानतुलविक्रमः ।\nचिरजीवी भवेत्सोऽपि ज्ञानवान्सम्पदा युतः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7002980100, "chapter_id": 22980, "verse_number": "२-२७-१०१", "content_sanskrit": "माघस्य शुक्लपञ्चम्यां पूजयेद्यः सरस्वतीम् ।\nसंयतो भक्तितो दत्त्वा चोपचाराणि षोडश ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7002980101, "chapter_id": 22980, "verse_number": "२-२७-१०२", "content_sanskrit": "महीयते स वैकुण्ठे यावद्ब्रह्मदिवानिशम् ।\nसंप्राप्य च पुनर्जन्म स भवेत्कविपण्डितः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7002980102, "chapter_id": 22980, "verse_number": "२-२७-१०३", "content_sanskrit": "गां सुवर्णादिकं यो हि ब्राह्मणाय ददाति च ।\nनित्यं जीवनपर्यन्तं भक्तियुक्तश्च भारते ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7002980103, "chapter_id": 22980, "verse_number": "२-२७-१०४", "content_sanskrit": "गवां लोमप्रमाणाब्दं द्विगुणं विष्णुमन्दिरे ।\nमोदते हरिणा सार्द्धं क्रीडाकौतुकमङ्गलैः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7002980104, "chapter_id": 22980, "verse_number": "२-२७-१०५", "content_sanskrit": "ततः पुनरिहागत्य विष्णुभक्तिं लभेद्ध्रुवम् ।\nततः पुनरिहागत्य राजराजेश्वरो भवेत् ।\nगोमांश्च पुत्रवान्विद्वाञ्ज्ञानवान्सर्वतः सुखी ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7002980105, "chapter_id": 22980, "verse_number": "२-२७-१०६", "content_sanskrit": "भोजयेद्यो हि मिष्टान्नं ब्राह्मणेभ्यश्च भारते ।\nविप्रलोमप्रमाणाब्दं मोदते विष्णुमन्दिरे ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7002980106, "chapter_id": 22980, "verse_number": "२-२७-१०७", "content_sanskrit": "ततः पुनरिहागत्य स सुखी धनवान्भवेत् ।\nविद्वान्सुचिरजीवी च श्रीमानतुलविक्रमः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7002980107, "chapter_id": 22980, "verse_number": "२-२७-१०८", "content_sanskrit": "यो वक्ति वा ददात्येव हरेर्नामानि भारते ।\nयुगनामप्रमाणं च विष्णुलोके महीयते ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7002980108, "chapter_id": 22980, "verse_number": "२-२७-१०९", "content_sanskrit": "ततः पुनरिहागत्य विष्णुभक्तिं लभेद्ध्रुवम् ।\nयदि नारायणक्षेत्रे फलं कोटिगुणं लभेत् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7002980109, "chapter_id": 22980, "verse_number": "२-२७-११०", "content_sanskrit": "नाम्नां कोटिं हरेर्यो हि क्षेत्रे नारायणे जपेत् ।\nसर्वपापविनिर्मुक्तो जीवन्मुक्तो भवेद्ध्रुवम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7002980110, "chapter_id": 22980, "verse_number": "२-२७-१११", "content_sanskrit": "लभते न पुनर्जन्म वैकुण्ठे स महीयते ।\nलभेद्विष्णोश्च सारूप्यं न तस्य पतनं भवेत् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7002980111, "chapter_id": 22980, "verse_number": "२-२७-११२", "content_sanskrit": "यः शिवं पूजयेन्नित्यं कृत्वा लिङ्गं च पार्थिवम् ।\nयावज्जीवनपर्य्यन्तं स याति शिवमन्दिरम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7002980112, "chapter_id": 22980, "verse_number": "२-२७-११३", "content_sanskrit": "मृदां रेणुप्रमाणाब्दं शिवलोके महीयते ।\nततः पुनरिहागत्य राजेन्द्रो भारते भवेत्॥ ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7002980113, "chapter_id": 22980, "verse_number": "२-२७-११४", "content_sanskrit": "शिलां च योऽर्चयेन्नित्यं शिलातोयं च भक्षति ।\nमहीयते स वैकुण्ठे यावद्वै ब्रह्मणः शतम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7002980114, "chapter_id": 22980, "verse_number": "२-२७-११५", "content_sanskrit": "ततो लब्ध्वा पुनर्जन्म हरिभक्तिं सुदुर्लभाम् ।\nमहीयते विष्णुलोके न तस्य पतनं भवेत् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7002980115, "chapter_id": 22980, "verse_number": "२-२७-११६", "content_sanskrit": "तपांसि चैव सर्वाणि व्रतानि निखिलानि च ।\nकृत्वा तिष्ठति वैकुण्डे यावदिन्द्राश्चतुर्दश ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7002980116, "chapter_id": 22980, "verse_number": "२-२७-११७", "content_sanskrit": "ततो लब्ध्वा पुनर्जन्म राजेन्द्रो भारते भवेत् ।\nततो मुक्तो भवेत्पश्चात्पुनर्जन्म न विद्यते ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7002980117, "chapter_id": 22980, "verse_number": "२-२७-११८", "content_sanskrit": "यः स्नाति सर्वर्तीर्थेषु भुवि कृत्वा प्रदक्षिणम् ।\nस च निर्वाणतां याति न तज्जन्म भवेद्भुवि ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7002980118, "chapter_id": 22980, "verse_number": "२-२७-११९", "content_sanskrit": "पुण्यक्षेत्रे भारते च योऽश्वमेधं करोति च ।\nअश्वलोमप्रमाणाब्दं शक्रस्यार्द्धासने वसेत् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7002980119, "chapter_id": 22980, "verse_number": "२-२७-१२०", "content_sanskrit": "चतुर्गुणं राजसूये फलमाप्नोति मानवः ।\nनरमेधेऽश्वमेधार्द्धं गोमेधे च तदेव च ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7002980120, "chapter_id": 22980, "verse_number": "२-२७-१२१", "content_sanskrit": "पुत्रेष्टौ च तदर्धं च सुपुत्रं च लभेद्ध्रुवम् ।\nलभते लाङ्गलेष्टौ च गोमेधसदृशं फलम् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7002980121, "chapter_id": 22980, "verse_number": "२-२७-१२२", "content_sanskrit": "तत्समानं च विप्रेष्टौ वृद्धियागे च तत्फलम् ।\nपद्मयज्ञे तदर्द्धं च फलमाप्नोति मानवः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7002980122, "chapter_id": 22980, "verse_number": "२-२७-१२३", "content_sanskrit": "विशोके च विशोकं च पद्मार्द्धं स्वर्गमश्नुते ।\nविजये विजयी राजा स्वर्गे पद्मसमं भवेत् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7002980123, "chapter_id": 22980, "verse_number": "२-२७-१२४", "content_sanskrit": "प्राजापत्ये प्रजालाभो भूवृद्धिर्भूभृतां भवेत् ।\nइह राजश्रियं लब्ध्वा पद्मार्द्धं स्वर्गमश्नुते ।\nऋद्धियागे महैश्वर्यं स्वर्गं पद्मसमं भवेत् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7002980124, "chapter_id": 22980, "verse_number": "२-२७-१२५", "content_sanskrit": "विष्णुयज्ञः प्रधानं च सर्वयज्ञेषु सुन्दरि ।\nब्रह्मणा च कृतः पूर्वं महासम्भारसंयुतः ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7002980125, "chapter_id": 22980, "verse_number": "२-२७-१२६", "content_sanskrit": "बभूव कलहो यत्र दक्षशङ्करयोः सति ।\nशेपुश्च नन्दिनं विप्रा नन्दी विप्रांश्च कोपतः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7002980126, "chapter_id": 22980, "verse_number": "२-२७-१२७", "content_sanskrit": "यतो हेतोर्दक्षयज्ञं बभञ्ज चन्द्रशेखरः ।\nचकार विष्णुयज्ञं च पुरा दक्षप्रजापतिः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7002980127, "chapter_id": 22980, "verse_number": "२-२७-१२८", "content_sanskrit": "धर्मश्च कश्यपश्चैव शेषश्चापि च कर्दमः ।\nस्वायम्भुवो मनुश्चैव तत्पुत्रश्च प्रियव्रतः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7002980128, "chapter_id": 22980, "verse_number": "२-२७-१२९", "content_sanskrit": "शिवः सनत्कुमारश्च कपिलश्च ध्रुवस्तथा ।\nराजसूयसहस्राणां समृद्ध्या च क्रतुर्भवेत् ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7002980129, "chapter_id": 22980, "verse_number": "२-२७-१३०", "content_sanskrit": "राजसूयसहस्राणां फलमाप्नोति निश्चितम् ।\nविष्णुयज्ञात्परो यज्ञो नास्ति वेदे फलप्रदः ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7002980130, "chapter_id": 22980, "verse_number": "२-२७-१३१", "content_sanskrit": "बहुकल्पान्तजीवी च जीवन्मुक्तो भवेद्ध्रुवम् ।\nज्ञानेन तेजसा चैव विष्णुतुल्यो भवेदिह ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7002980131, "chapter_id": 22980, "verse_number": "२-२७-१३२", "content_sanskrit": "देवानां च यथा विष्णुर्वैष्णवानां यथा शिवः ।\nशास्त्राणां च यथा वेदा आश्रमाणां च ब्राह्मणाः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7002980132, "chapter_id": 22980, "verse_number": "२-२७-१३३", "content_sanskrit": "तीर्थानां च यथा गङ्गा पवित्राणां च वैष्णवाः ।\nएकादशी व्रतानां च पुष्पाणां तुलसी यथा ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7002980133, "chapter_id": 22980, "verse_number": "२-२७-१३४", "content_sanskrit": "नक्षत्राणां यथा चन्द्रः पक्षिणां गरुडो यथा ।\nयथा स्त्रीणां च प्रकृतिराधाराणां वसुन्धरा॥ ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7002980134, "chapter_id": 22980, "verse_number": "२-२७-१३५", "content_sanskrit": "शीघ्रगानां चेन्द्रियाणां चञ्चलानां यथा मनः ।\nप्रजापतीनां ब्रह्मा च प्रजेशानां प्रजापतिः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7002980135, "chapter_id": 22980, "verse_number": "२-२७-१३६", "content_sanskrit": "वृन्दावनं वनानां च वर्षाणां भारतं यथा ।\nश्रीमतां च यथा श्रीश्च विदुषां च सरस्वती ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7002980136, "chapter_id": 22980, "verse_number": "२-२७-१३७", "content_sanskrit": "पतिव्रतानां दुर्गा च सौभाग्यानां च राधिका ।\nविष्णुयज्ञस्तथा वत्से यज्ञेषु च महानिति ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7002980137, "chapter_id": 22980, "verse_number": "२-२७-१३८", "content_sanskrit": "अश्वमेधशतेनैव शक्रत्वं लभते ध्रुवम् ।\nसहस्रेण विष्णुपदं संप्राप पृथुरेव च॥ ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7002980138, "chapter_id": 22980, "verse_number": "२-२७-१३९", "content_sanskrit": "स्नानं च सर्वतीर्थेषु सर्वयज्ञेषु दक्षिणम् ।\nसर्वेषां च व्रतानां च तपसां फलमेव च ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7002980139, "chapter_id": 22980, "verse_number": "२-२७-१४०", "content_sanskrit": "पाठश्चतुर्णां वेदानां प्रादक्षिण्यं भुवस्तथा ।\nफलं बीजमिदं सर्वं मुक्तिदं कृष्णसेवनम् ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7002980140, "chapter_id": 22980, "verse_number": "२-२७-१४१", "content_sanskrit": "पुराणेषु च वेदेषु चेतिहासेषु सर्वतः ।\nनिरूपितं सारभूतं कृष्णपादाम्बुजार्चनम् ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7002980141, "chapter_id": 22980, "verse_number": "२-२७-१४२", "content_sanskrit": "तद्वर्णनं च तद्ध्यानं तन्नामगुणकीर्त्तनम् ।\nतत्स्तोत्रं स्मरणं चैव वन्दनं जप एव च ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7002980142, "chapter_id": 22980, "verse_number": "२-२७-१४३", "content_sanskrit": "तत्पादोदकनैवेद्यभक्षणं नित्यमेव च ।\nसर्वसम्मतमित्येवं सर्वेप्सितमिदं सति ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7002980143, "chapter_id": 22980, "verse_number": "२-२७-१४४", "content_sanskrit": "भज कृष्णं परं ब्रह्म निर्गुणं प्रकृतेः परम् ।\nगृहाण स्वामिनं वत्से सुखं गच्छ स्वमन्दिरम् ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7002980144, "chapter_id": 22980, "verse_number": "२-२७-१४५", "content_sanskrit": "एतत्ते कथितं सर्वं विपाकं कर्मणां नृणाम् ।\nसर्वेप्सितं सर्वमतं परं तत्त्वप्रदं नृणाम् ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}]