[{"id": 2061721, "chapter_id": 2318, "verse_number": "८-३९-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061722, "chapter_id": 2318, "verse_number": "८-३९-१", "content_sanskrit": "ततः परानीकभिदं व्यूहमप्रतिमं कृतम्।\nसमीक्ष्य कर्णः पार्थानां धृष्टधुम्नाभिरक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061723, "chapter_id": 2318, "verse_number": "८-३९-२", "content_sanskrit": "प्रययौ रथघोषेण सिंहनादरवेण च।\nवादित्राणां च निनदैः कम्पयन्निव मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061724, "chapter_id": 2318, "verse_number": "८-३९-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061725, "chapter_id": 2318, "verse_number": "८-३९-३", "content_sanskrit": "ततः प्रयान्तं राधेयं मद्रराजः स्मयन्निव।\nअवधूय इदं वाक्यमब्रवीत्कुरुसन्निधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061726, "chapter_id": 2318, "verse_number": "८-३९-४", "content_sanskrit": "चमूं तवेमां विपुलां समृद्वा--\nमसङ्खेयामश्वनराकुलां च।\nतथा प्रवेष्टा समरे धनञ्जयः\nकक्षं दहन्दीप्त इवाश्रयाशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061727, "chapter_id": 2318, "verse_number": "८-३९-५", "content_sanskrit": "रथे स्तितौ वीरवरौ वरेण्यौ\nसिंहस्कन्धौ लोहितपद्मनेत्रौ।\nद्रष्टा भवानद्य विना प्रयत्ना--\nत्तथाहि मे शकुना वेदयन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061728, "chapter_id": 2318, "verse_number": "८-३९-६", "content_sanskrit": "अद्य द्रष्टाऽसि तं वीरं श्वेताश्वं कृष्णसारथिम्।\nनिघ्नन्तं शात्रवान्सङ्ख्ये यं कर्ण परिपृच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061729, "chapter_id": 2318, "verse_number": "८-३९-७", "content_sanskrit": "अद्य तौ पुरुषव्याघ्रौ लोहिताक्षौ परन्तपौ।\nवासुदेवार्जुनौ कर्ण द्रष्टाऽस्यमितविक्रमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061730, "chapter_id": 2318, "verse_number": "८-३९-८", "content_sanskrit": "सारथिर्यस्य गोविन्दो गाण्डीवं यस्य कार्मुकम्।\nतं चेद्वन्ताऽसि राधेय त्वं नो राजा भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061731, "chapter_id": 2318, "verse_number": "८-३९-९", "content_sanskrit": "प्रवात्येष महावायुरभितस्तव वाहिनीम्।\nक्रव्यादा व्याहरन्त्येते मृगाः कुर्वन्ति भैरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061732, "chapter_id": 2318, "verse_number": "८-३९-१०", "content_sanskrit": "पश्य कर्ण महाघोरं भयं वै रोमहर्षणम्।\nअर्कं जीमूतसङ्काशः कबन्धो वार्य तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061733, "chapter_id": 2318, "verse_number": "८-३९-११", "content_sanskrit": "पश्य यूथं मृगशतं मृगाणां सर्वतोदिशम्।\nररास दीप्तलाङ्गूलमादित्यामभि संस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061734, "chapter_id": 2318, "verse_number": "८-३९-१२", "content_sanskrit": "पश्य काकांश्च गृध्रांश्च समवेतान्सहस्रशः।\nआदित्यमभिवीक्षन्ते ह्यशिवाः कर्ण सस्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061735, "chapter_id": 2318, "verse_number": "८-३९-१३", "content_sanskrit": "श्वेतवाजिसमायुक्ते तव कर्ण महारथे।\nपताकाः प्रज्वलन्त्येता ध्वजश्चातीव कम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061736, "chapter_id": 2318, "verse_number": "८-३९-१४", "content_sanskrit": "उदीर्यतो हयान्पश्य महाकायान्महाजवान्।\nप्लवमानान्महावीर्यानाकाशे गरुडानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061737, "chapter_id": 2318, "verse_number": "८-३९-१५", "content_sanskrit": "ध्रुवमेषु निमित्तेषु भूमिमावृत्य पार्थिवाः।\nस्वप्स्यन्ति निहताः कर्ण शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061738, "chapter_id": 2318, "verse_number": "८-३९-१६", "content_sanskrit": "शङ्खानां तुमुलः शब्दः श्रूयते रोमहर्षणः।\nआनकानां च राधेय मृदङ्गानां च हन्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061739, "chapter_id": 2318, "verse_number": "८-३९-१७", "content_sanskrit": "शृणु शब्दान्बहुविधान्नराश्वरथवाजिनाम्।\nज्यातलत्रेषुशब्दांश्च शृणु कर्ण महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061740, "chapter_id": 2318, "verse_number": "८-३९-१८", "content_sanskrit": "हेमरूप्यप्रमृष्टानां वाससां शिल्पिनिर्मिताः।\nसहेमचन्द्रताराभाः पताकाः किङ्गिणीयुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061741, "chapter_id": 2318, "verse_number": "८-३९-१९", "content_sanskrit": "नानावर्णा रणे भान्ति श्वसनेन प्रकम्पिताः।\nपश्य कर्णार्जुनस्यैताः सौदामिन्य इवाम्बुदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061742, "chapter_id": 2318, "verse_number": "८-३९-२०", "content_sanskrit": "ध्वजाः कणकणायन्ते वातेनातिसमीरिताः।\nसपताकरथाश्चापि पाञ्चालानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061743, "chapter_id": 2318, "verse_number": "८-३९-२१", "content_sanskrit": "एष रेणुः समुद्भूतो दिवमावृत्य तिष्ठति।\nगजवाजिप्रणुन्ना च कम्पते कर्ण मेदिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061744, "chapter_id": 2318, "verse_number": "८-३९-२२", "content_sanskrit": "श्रूयते मेघसङ्काशो रथनेमिस्वनस्तथा।\nपश्य कुन्तीसुतं वीरं बीभत्सुमपराजितम्।\nप्रहरिष्यन्तमायान्तं कपिप्रवरकेतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061745, "chapter_id": 2318, "verse_number": "८-३९-२३", "content_sanskrit": "गजाश्वरथपत्त्योघांस्तावकान्युधि निघ्नतः।\nध्वजाग्रं दृश्यते तस्य ज्याशब्दश्चैव श्रूयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061746, "chapter_id": 2318, "verse_number": "८-३९-२४", "content_sanskrit": "एष संशप्तकान्भूयस्तानेवाभिमुखो गतः।\nकरोति कदनं चैष सङ्गामे द्विषतां बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061747, "chapter_id": 2318, "verse_number": "८-३९-२५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061748, "chapter_id": 2318, "verse_number": "८-३९-२५", "content_sanskrit": "इति ब्रुवाणं मद्रेशं कर्णः प्रोवाच मन्युमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061749, "chapter_id": 2318, "verse_number": "८-३९-२६", "content_sanskrit": "पश्य संशप्तकैः क्रुद्धैः समन्तात्समभिद्रुतः।\nएष सूर्य इवाम्भोदैश्छन्नः पार्थो न दृश्यते।\nएष दान्तोऽर्जुनः शल्य निमग्नः शोकसागरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2061750, "chapter_id": 2318, "verse_number": "८-३९-२७x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2061751, "chapter_id": 2318, "verse_number": "८-३९-२७", "content_sanskrit": "वरुणं कोऽम्भसा हन्यादिन्धनेन च कोऽनलम्।\nकोवाऽनिलं निगृह्णीयात्पिबेद्वा को महार्णवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2061752, "chapter_id": 2318, "verse_number": "८-३९-२८", "content_sanskrit": "ईदृग्रूपमहं मन्ये पार्थस्य युधि निर्जयम्।\nन हि शक्योऽर्जुनो जेतुं युधि देवासुरैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2061753, "chapter_id": 2318, "verse_number": "८-३९-२९", "content_sanskrit": "अथैघं परितोषस्ते वाग्भिस्त्वं सुमाना भव।\nन हि शक्यो युधा जेतुमन्यं कुरु मनोरथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2061754, "chapter_id": 2318, "verse_number": "८-३९-३०", "content_sanskrit": "बाहुभ्यामुद्धरेद्भूमिं दहेत्क्रुद्ध इमाः प्रजाः।\nपातयेत्त्रिदिवाद्देवान्नार्जुनं समरे जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2061755, "chapter_id": 2318, "verse_number": "८-३९-३१", "content_sanskrit": "पश्य कुन्तीसुतं भीमं वीरमक्लिष्टकारिणम्।\nप्रहरन्तं महाबाहुं स्थितं मेरुमिवाचलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2061756, "chapter_id": 2318, "verse_number": "८-३९-३२", "content_sanskrit": "अमर्षी पुरुषव्याघ्रः सदा वैरमनुस्मरन्।\nएष भीमो जयप्रेप्सुर्युधि तिष्ठति वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2061757, "chapter_id": 2318, "verse_number": "८-३९-३३", "content_sanskrit": "एष धर्मभृतां श्रेष्ठो धर्मराजो युधिष्ठिरः।\nतिष्ठत्यसुकरः सङ्ख्ये परैः परपुरञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2061758, "chapter_id": 2318, "verse_number": "८-३९-३४", "content_sanskrit": "एतौ च पुरुषव्याघ्रावाश्विनेयौ महारथौ।\nनकुलः सहदेवश्च तिष्ठतो युधि दुर्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2061759, "chapter_id": 2318, "verse_number": "८-३९-३५", "content_sanskrit": "एते तिष्ठन्ति कार्ष्णेयाः पञ्च पञ्चाचला इव।\nयोत्स्यमाना महावीर्या भीमार्जुनसमा युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2061760, "chapter_id": 2318, "verse_number": "८-३९-३६", "content_sanskrit": "एते द्रुपदपुत्राश्च धृष्टद्युम्नपुरोगमाः।\nहीनाः सत्यजिता वीरास्तिष्ठन्ति परमौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2061761, "chapter_id": 2318, "verse_number": "८-३९-३७", "content_sanskrit": "यत्र कृष्णार्जुनौ वीरौ यत्र राजा युधिष्ठिरः।\nतत्र धर्मश्च सत्यं च यतो धर्मस्ततो जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2061762, "chapter_id": 2318, "verse_number": "८-३९-३८", "content_sanskrit": "इति संवदतोरेव तयोः पुरुषसिंहयोः।\nते सेने समसज्जेतां ङ्गायमुनवद्भृशम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2061763, "chapter_id": 2318, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि एकोनचत्वारिंशोऽध्यायः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]