[{"id": 7003323000, "chapter_id": 23323, "verse_number": "२-१८-१", "content_sanskrit": "देवा ऊचुः    ।\nय एष भगवान् रुद्रो ब्रह्मविष्णुमहेश्वराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003323001, "chapter_id": 23323, "verse_number": "२-१८-२", "content_sanskrit": "स्कंदश्चापि तथा चेद्रो भुवनानि चतुर्दश ।\nअश्विनौ ग्रहतारास्च नक्षत्राणि च खं दिशः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003323002, "chapter_id": 23323, "verse_number": "२-१८-३", "content_sanskrit": "भूतानि च तथा सूर्यः सोमश्चाष्टौ ग्रहास्तथा ।\nप्राणः कालो यमो मृत्युरमृतः परमेश्वरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003323003, "chapter_id": 23323, "verse_number": "२-१८-४", "content_sanskrit": "भूतं भव्यं भविष्यच्च वर्तमानं महेश्वरः ।\nविश्वं कृत्स्नं जगत्सर्वं सत्यं तस्मै नमोनमः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003323004, "chapter_id": 23323, "verse_number": "२-१८-५", "content_sanskrit": "त्वमादौ च तथा भूतो भूर्भुवः स्वस्तथैव च ।\nअंते त्वं विश्वरूपोऽसि शीर्षं तु जगतः संदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003323005, "chapter_id": 23323, "verse_number": "२-१८-६", "content_sanskrit": "ब्रह्मैकस्त्वं द्वित्रिधार्थमधश्च त्वं सुरेश्वरः ।\nशांतिश्च त्वं तथा पुष्टिस्तुष्टिश्चाप्यहुतं हुतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003323006, "chapter_id": 23323, "verse_number": "२-१८-७", "content_sanskrit": "विश्वं चैव तथाविश्वं दत्तं वादत्तमीश्वरम्  ।\nकृतं चाप्यकृतं देवं परमप्यपरं ध्रुवम् ।\nपरायणं सतां चैव ह्यसतामपि शंकरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003323007, "chapter_id": 23323, "verse_number": "२-१८-८", "content_sanskrit": "अपामसोमममृता अभूमागन्म ज्योति रविदाम देवान् ।\nकिं नूनमस्मान्कृणवदरातिः किमु धूर्तिरमृतं मर्त्यस्य ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003323008, "chapter_id": 23323, "verse_number": "२-१८-९", "content_sanskrit": "एतज्जगद्धितं दिव्यमक्षरं सूक्ष्ममव्ययम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003323009, "chapter_id": 23323, "verse_number": "२-१८-१०", "content_sanskrit": "प्राजा पत्यं पवित्रं च सौम्यमग्राह्यमव्ययम् ।\nअग्राह्येणापि वा ग्राह्यं वायव्येन समीरणः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003323010, "chapter_id": 23323, "verse_number": "२-१८-११", "content_sanskrit": "सौम्येन सौम्यं ग्रसति तेजसा स्वेन लीलया ।\nतस्मै नमोऽपसंहर्त्रे महाग्रासाय शूलिने ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003323011, "chapter_id": 23323, "verse_number": "२-१८-१२", "content_sanskrit": "हृदिस्था देवताः सर्वा हृदि प्राणे प्रतिष्ठिताः ।\nहृदि त्वमसि यो नित्यं तिस्रो मात्राः परस्तु सः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003323012, "chapter_id": 23323, "verse_number": "२-१८-१३", "content_sanskrit": "शिरश्चोत्तरतश्चैव पादौ दक्षिणतस्तथा ।\nयो वै चोत्तरतः साक्षात्स ओंकारः सनातनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003323013, "chapter_id": 23323, "verse_number": "२-१८-१४", "content_sanskrit": "ओंकारो यः स एवेह प्रणवो व्याप्य तिष्ठति ।\nअनंतस्तारसूक्ष्मं च शुक्लं वैद्युतमेव च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003323014, "chapter_id": 23323, "verse_number": "२-१८-१५", "content_sanskrit": "परं ब्रह्मा स ईशान एकोरुद्रः स एव च ।\nभवान्महेश्वरः साक्षान्महादेवो न संशयः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003323015, "chapter_id": 23323, "verse_number": "२-१८-१६", "content_sanskrit": "ऊर्ध्वमुन्नामयत्येव स ओंकारः प्रकीर्तितः ।\nप्राणानवति यस्तस्मात् प्रणवः परिकीर्तितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003323016, "chapter_id": 23323, "verse_number": "२-१८-१७", "content_sanskrit": "सर्वं व्याप्नोति यस्तस्मात्सर्वव्यापी सनातनः ।\nब्रह्मा हरिश्च भगवानाद्यंतं नोपलब्धवान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003323017, "chapter_id": 23323, "verse_number": "२-१८-१८", "content_sanskrit": "तथान्ये च ततोऽनंतो रुद्रः परमकारणम् ।\nयस्तारयति संसारात्तार इत्यभिधीयते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003323018, "chapter_id": 23323, "verse_number": "२-१८-१९", "content_sanskrit": "सूक्ष्मो भूत्वा शरीराणि सर्वदा ह्यधितिष्ठिति ।\nतस्मात्सूक्ष्मः समाख्यातो भगवन्नीललोहितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003323019, "chapter_id": 23323, "verse_number": "२-१८-२०", "content_sanskrit": "नीलश्च लोहितश्चैव प्रधानपुरुषान्वयात् ।\nस्कंदतेऽस्य यतः शुक्रं तथा शुक्रमपैतिच ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003323020, "chapter_id": 23323, "verse_number": "२-१८-२१", "content_sanskrit": "विद्योतयति यस्तस्माद्वैद्युतः परिगीयते ।\nबृहत्त्वाद्बृंहणत्वाच्च बृहते च परापरे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003323021, "chapter_id": 23323, "verse_number": "२-१८-२२", "content_sanskrit": "तस्माद्बृंहति यस्माद्धि परं ब्रह्मेति कीर्तितम् ।\nअद्वितीयोऽथ भगवांस्तुरीयः परमेश्वरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003323022, "chapter_id": 23323, "verse_number": "२-१८-२३", "content_sanskrit": "ईशानमस्य जगतः सर्वदृशां चक्षुरीश्वरम् ।\nईशानमिंद्रसूरयः सर्वेषामपि सर्वदा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003323023, "chapter_id": 23323, "verse_number": "२-१८-२४", "content_sanskrit": "ईशानः सर्वविद्यानां यत्तदीशान उच्यते ।\nयदीक्षते च भगवान्निरीक्ष्यमिति चाज्ञया ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003323024, "chapter_id": 23323, "verse_number": "२-१८-२५", "content_sanskrit": "आत्मज्ञानं महादेवो योगं गमयति स्वयम् ।\nभगवांश्चोच्यते देवो देवदेवो महेश्वरः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003323025, "chapter_id": 23323, "verse_number": "२-१८-२६", "content_sanskrit": "सर्वांल्लोकान्क्रमेणैव यो गृह्णति महेश्वरः ।\nविसृजत्येप देवेशो वासयत्यपि लीलया ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003323026, "chapter_id": 23323, "verse_number": "२-१८-२७", "content_sanskrit": "एषो हि देवः प्रदिशोऽनुसर्वाः पूर्वो हि जातः स उ गर्भे अंतः ।\nस एव जातः स जनिष्यमाणः प्रत्यङ्मुखास्तिष्ठति सर्वतोमुखः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003323027, "chapter_id": 23323, "verse_number": "२-१८-२८", "content_sanskrit": "उपासितव्यं यत्नेन तदेतत्सद्भिरव्ययम् ।\nयतो वाचो निवर्तंते ह्यप्राप्य मनसा सह ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003323028, "chapter_id": 23323, "verse_number": "२-१८-२९", "content_sanskrit": "तदग्रहणमेवेह यद्वाग्वदति यत्नतः ।\nअपरं च परं वेति परायणमिति स्वयम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003323029, "chapter_id": 23323, "verse_number": "२-१८-३०", "content_sanskrit": "वदंति वाचः सर्वज्ञः शंकरं नीललोहितम् ।\nएष सर्वो नमस्तस्मै पुरुषः पिंगलः शिवः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003323030, "chapter_id": 23323, "verse_number": "२-१८-३१", "content_sanskrit": "स एष स महारुद्रो विश्वं भूतं भविष्यति ।\nभुवनं बहुधा जातं जायमानमितस्ततः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003323031, "chapter_id": 23323, "verse_number": "२-१८-३२", "content_sanskrit": "हिरण्यबाहुर्भगवान् हिरण्यपतिरीश्वरः ।\nअंबिकापतिरीशानो हेमरेता वृषध्वजः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003323032, "chapter_id": 23323, "verse_number": "२-१८-३३", "content_sanskrit": "उमापतिर्विरूपाक्षो विश्वसृग्विश्ववाहनः ।\nब्रह्माणं विदधे योऽसौ पुत्रमग्रे सनातनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003323033, "chapter_id": 23323, "verse_number": "२-१८-३४", "content_sanskrit": "प्रहिणोति स्म तस्यैव ज्ञानमात्मप्रकाशकम् ।\nतमेकं पुरुषं रुद्रं पुरुहुतं पुरुष्टुतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003323034, "chapter_id": 23323, "verse_number": "२-१८-३५", "content_sanskrit": "बालाग्रमात्रं हृदयस्य मध्ये विश्वंदेवं वह्निरूपं वरेण्यम् ।\nतमात्मस्थं येऽनुपश्यंति धीरास्तेषां शांतिः शाश्वती नेतरेषाम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003323035, "chapter_id": 23323, "verse_number": "२-१८-३६", "content_sanskrit": "महतो यो महीयांश्च ह्यणोरप्यणुरव्ययः ।\nगुहायां निहितश्चात्मा जंतोरस्य महेश्वरः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003323036, "chapter_id": 23323, "verse_number": "२-१८-३७", "content_sanskrit": "वेश्मभूतोऽस्य विश्वस्य कमलस्थो हृति स्वयम् ।\nगह्वरं गहनं तत्स्थं तस्यांतश्चोर्ध्वतः स्थितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003323037, "chapter_id": 23323, "verse_number": "२-१८-३८", "content_sanskrit": "तत्रापि दह्रं गगनमोंकारं परमेश्वरम् ।\nबालाग्रमात्रं तन्मध्ये ऋतं परमकारणम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003323038, "chapter_id": 23323, "verse_number": "२-१८-३९", "content_sanskrit": "सत्यं ब्रह्म महादेवं पुरुषं कृष्णपिंगलम् ।\nऊर्ध्वरतेसमीशानं विरूपाक्षमजोद्भवम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003323039, "chapter_id": 23323, "verse_number": "२-१८-४०", "content_sanskrit": "अधितिष्ठति योनिं यो योनिं वाचैक ईश्वरः ।\nदेहं पंचविधं येन तमीशानं पुरातनम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003323040, "chapter_id": 23323, "verse_number": "२-१८-४१", "content_sanskrit": "प्राणेष्वंतर्मनसो लिंगमाहुर्यस्मिन्क्रोधो या च तृष्णा क्षमा च ।\nतृष्णां छित्त्वा हेतुजालस्य मूलं बुद्ध्याचिंत्यं स्थापयित्वा च रुद्रे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003323041, "chapter_id": 23323, "verse_number": "२-१८-४२", "content_sanskrit": "एकं तमाहुर्वै रुद्रं शाश्वतं परमेश्वरम् ।\nपरात्परतरं वापि परात्परतरं ध्रुवम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003323042, "chapter_id": 23323, "verse_number": "२-१८-४३", "content_sanskrit": "ब्रह्मणो जनकं विष्णोर्वह्नेर्वायोः सदाशिवम् ।\nध्यात्वाग्निना च शोध्यांगं विशोध्य च पृथक्पृथक् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003323043, "chapter_id": 23323, "verse_number": "२-१८-४४", "content_sanskrit": "पंचभूतानि संयम्य मात्राविधिगुणक्रमात् ।\nमात्राः पंच चतस्रश्च त्रिमात्रादिस्ततः परम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003323044, "chapter_id": 23323, "verse_number": "२-१८-४५", "content_sanskrit": "एकमात्रममात्रं हि द्वादशांते व्यवस्थितम् ।\nस्थित्वा स्थाप्यामृतो भूत्वा व्रतं पाशुपतं चरेत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003323045, "chapter_id": 23323, "verse_number": "२-१८-४६", "content_sanskrit": "एतद्व्रतं पाशुपतं चरिष्यामि समासतः ।\nअग्निमाधाय विधिवदृग्यजुः सामसंभवैः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003323046, "chapter_id": 23323, "verse_number": "२-१८-४७", "content_sanskrit": "उपोषितः शुचिः स्नातः शुक्लांबरधरः स्वयम् ।\nशुक्लयज्ञोपवीति च शुक्लमाल्यानुलेपनः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003323047, "chapter_id": 23323, "verse_number": "२-१८-४८", "content_sanskrit": "जुहुयाद्विरजोविद्वान् विरजाश्च भविष्यति ।\nवायवः शुध्यंतां वाङ्मनश्चरणादयः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003323048, "chapter_id": 23323, "verse_number": "२-१८-४९", "content_sanskrit": "श्रोत्रं जिह्वा ततः प्राणस्ततो बुद्धिस्तथैव च ।\nशिरः पाणिस्तथा पार्श्वं पृष्ठोदरमनंतरम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003323049, "chapter_id": 23323, "verse_number": "२-१८-५०", "content_sanskrit": "जंघे शिश्रमुपस्थं च पायुर्मेढ्रं तथैव च ।\nत्वचा मांसं च रुधिरं मेदोऽस्थीनि तथैव च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003323050, "chapter_id": 23323, "verse_number": "२-१८-५१", "content_sanskrit": "शब्दः स्पर्शं च रूपं च रसो गंधस्तथैव च ।\nभूतानि चैव शुध्यंतां देहे मेदादयस्तथा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003323051, "chapter_id": 23323, "verse_number": "२-१८-५२", "content_sanskrit": "अन्नं प्राणे मनो ज्ञानं शुध्यंतां वै शिवेच्छया ।\nहुत्वाज्येन समिद्भिश्च चरुणा च यथाक्रमम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003323052, "chapter_id": 23323, "verse_number": "२-१८-५३", "content_sanskrit": "उपसंहृत्य रुद्राग्निं गृहीत्वा भस्म यत्नतः ।\nअग्निरित्यादिना धीमान् विमृज्यांगानि संस्पृशेत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003323053, "chapter_id": 23323, "verse_number": "२-१८-५४", "content_sanskrit": "एतत्पाशुपतं दिव्यं व्रतं पाशविमोचनम् ।\nब्राह्मणानां हितं प्रोक्तं क्षत्रियाणां तथैव च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003323054, "chapter_id": 23323, "verse_number": "२-१८-५५", "content_sanskrit": "वैश्यानामपि योग्यानां यतीनां तु विशेषतः ।\nवानप्रस्थाश्रमस्थानां गृहस्थानां सतामपि ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003323055, "chapter_id": 23323, "verse_number": "२-१८-५६", "content_sanskrit": "विमुक्तिर्विधिनानेन दृष्ट्वा वै ब्रह्मचारिणाम् ।\nअग्निरित्यादिना भस्म गृहीत्वा ह्यग्निहोत्रजम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003323056, "chapter_id": 23323, "verse_number": "२-१८-५७", "content_sanskrit": "सोऽपि पाशुपतो विप्रो विमृज्यांगानि संस्पृशेत् ।\nभस्माच्छन्नो द्विजो विद्वान् महापातकसंभवैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003323057, "chapter_id": 23323, "verse_number": "२-१८-५८", "content_sanskrit": "पापौर्विमुच्यते सद्यो मुच्यते च न संशयः ।\nवीर्यमग्रेर्यतो भस्म वीर्यवान्भस्मसंयुतः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003323058, "chapter_id": 23323, "verse_number": "२-१८-५९", "content_sanskrit": "भस्मास्नानरतो विप्रो भस्मशायी जितेंद्रियः ।\nसर्वपापविनिर्मुक्तः शिवसायुज्यमाप्नुयात् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003323059, "chapter_id": 23323, "verse_number": "२-१८-६०", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन भूत्यंगं पूजयेद्वुधः ।\nरेरेकारो न कर्तव्यस्तुंतुंकारस्तथैव च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003323060, "chapter_id": 23323, "verse_number": "२-१८-६१", "content_sanskrit": "न तत्क्षमति देवेशो ब्रह्मा वा यदि केशवः ।\nमम पुत्रो भस्मधारी गणेशश्च वरानने ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003323061, "chapter_id": 23323, "verse_number": "२-१८-६२", "content_sanskrit": "तेषां विरुद्धं यत्त्याज्यं स याति नरकार्णवम् ।\nगृहस्थो ब्रह्महीनोपि त्रिपुंड्रं यो न कारयेत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003323062, "chapter_id": 23323, "verse_number": "२-१८-६३", "content_sanskrit": "पूजा कर्म क्रिया तस्य दानं स्नानं तथैव च ।\nनिष्फलं जायते सर्वं यथा भस्मनि वै हुतम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003323063, "chapter_id": 23323, "verse_number": "२-१८-६४", "content_sanskrit": "तस्माच्च सर्वकार्येषु त्रिपुंड्रं धारयेद्बुधः ।\nइत्युक्त्वा भगवान्ब्रह्मा स्तुत्वा देवैः समं प्रभुः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003323064, "chapter_id": 23323, "verse_number": "२-१८-६५", "content_sanskrit": "भस्माच्छन्नैः स्वयं छन्नो विरराम विशांपते ।\nअथ तेषां प्रसादार्थं पशूनां पतिरीश्वरः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003323065, "chapter_id": 23323, "verse_number": "२-१८-६६", "content_sanskrit": "सगमश्चांबया सार्धं सान्निध्यमकरोत्प्रभुः ।\nअथ संनिहितं रुद्रं तुष्टुवुः सुरपुंगवम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003323066, "chapter_id": 23323, "verse_number": "२-१८-६७", "content_sanskrit": "रुद्राध्यायेन सर्वेशं देवदेव मुमापतिम् ।\nदेवोपि देवानालोक्य घृणया वृषभध्वजः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003323067, "chapter_id": 23323, "verse_number": "२-१८-६८", "content_sanskrit": "तुष्टोस्मीत्याह देवेभ्यो वरं दातुं सुरारिहा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]