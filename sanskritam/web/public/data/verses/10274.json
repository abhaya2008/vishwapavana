[{"id": 6000274000, "chapter_id": 10274, "verse_number": null, "content_sanskrit": "अथ अष्टसप्ततितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000274001, "chapter_id": 10274, "verse_number": "१०-७८-१", "content_sanskrit": "अपश्यतां चानिरुद्धं तद्बन्धूनां च भारत।\nचत्वारो वार्षिका मासा व्यतीयुरनुशोचताम्॥ १०/७८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.001.m4a", "display_order": 2, "topics": [{"text": "शिवकृष्णयोः, स्कन्दप्रद्युम्नयोः युद्धम्", "range": "१–३०"}]}, {"id": 6000274002, "chapter_id": 10274, "verse_number": "१०-७८-२", "content_sanskrit": "नारदात्तदुपाकर्ण्य वार्तां बद्धस्य कर्म च।\nप्रययुः शोणितपुरं वृष्णयः कृष्णदेवताः॥ १०/७८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.002.m4a", "display_order": 3}, {"id": 6000274003, "chapter_id": 10274, "verse_number": "१०-७८-३", "content_sanskrit": "प्रद्युम्नो युयुधानश्च गदः साम्बोऽथ सारणः।\nनन्दोपनन्दभद्राद्या रामकृष्णानुवर्तिनः॥ १०/७८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.003.m4a", "display_order": 4}, {"id": 6000274004, "chapter_id": 10274, "verse_number": "१०-७८-४", "content_sanskrit": "अक्षौहिणीभिर्द्वादशभिः समेताः सर्वतो दिशम्।\nरुरुधुर्बाणनगरं समन्तात् सात्त्वतर्षभाः॥ १०/७८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.004.m4a", "display_order": 5}, {"id": 6000274005, "chapter_id": 10274, "verse_number": "१०-७८-५", "content_sanskrit": "भज्यमानपुरोद्यानप्राकाराट्टालगोपुरम्।\nप्रेक्षमाणो रुषाऽऽविष्टस्तुल्यसैन्योऽभिनिर्ययौ॥ १०/७८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.005.m4a", "display_order": 6}, {"id": 6000274006, "chapter_id": 10274, "verse_number": "१०-७८-६", "content_sanskrit": "बाणार्थे भगवान् रुद्रः ससुतैः प्रमथैर्वृतः।\nआरुह्य नन्दीवृषभं युयुधे रामकृष्णयोः॥ १०/७८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.006.m4a", "display_order": 7}, {"id": 6000274007, "chapter_id": 10274, "verse_number": "१०-७८-७", "content_sanskrit": "आसीत् सुतुमुलं युद्धमद्भुतं रोमहर्षणम्।\nकृष्णशङ्करयो राजन् प्रद्युम्नगुहयोरपि॥ १०/७८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.007.m4a", "display_order": 8}, {"id": 6000274008, "chapter_id": 10274, "verse_number": "१०-७८-८", "content_sanskrit": "कुम्भाण्डकूपकर्णाभ्यां बलेन सह संयुगः।\nसाम्बस्य बाणपुत्रेण, बाणेन सह सात्यकेः॥ १०/७८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.008.m4a", "display_order": 9}, {"id": 6000274009, "chapter_id": 10274, "verse_number": "१०-७८-९", "content_sanskrit": "ब्रह्मादयः सुराधीशा मुनयः सिद्धचारणाः।\nगन्धर्वाप्सरसो यक्षा विमानैर्द्रष्टुमागमन्॥ १०/७८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.009.m4a", "display_order": 10}, {"id": 6000274010, "chapter_id": 10274, "verse_number": "१०-७८-१०", "content_sanskrit": "शङ्करानुचराञ्छौरिर्भूतप्रमथगुह्यकान्।\nडाकिनीर्यातुधानांश्च वेतालान् सविनायकान्॥ १०/७८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.010.m4a", "display_order": 11}, {"id": 6000274011, "chapter_id": 10274, "verse_number": "१०-७८-११", "content_sanskrit": "प्रेतमातृपिशाचांश्च कूष्माण्डान् ब्रह्मराक्षसान्।\nद्रावयामास तीक्ष्णाग्रैः शरैः शार्ङ्गधनुश्च्युतैः॥ १०/७८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.011.m4a", "display_order": 12}, {"id": 6000274012, "chapter_id": 10274, "verse_number": "१०-७८-१२", "content_sanskrit": "पृथग्विधानि प्रायुङ्क्त पिनाक्यस्‍त्राणि शार्ङ्गिणे।\nप्रत्यस्‍त्रैः शमयामास शार्ङ्गपाणिरविस्मितः॥ १०/७८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.012.m4a", "display_order": 13}, {"id": 6000274013, "chapter_id": 10274, "verse_number": "१०-७८-१३", "content_sanskrit": "ब्रह्मास्‍त्रस्य च ब्रह्मास्‍त्रं वायव्यस्य च पार्वतम्।\nआग्नेयस्य च पार्जन्यं नैजं पाशुपतस्य च॥ १०/७८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.013.m4a", "display_order": 14}, {"id": 6000274014, "chapter_id": 10274, "verse_number": "१०-७८-१४", "content_sanskrit": "मोहयित्वा तु गिरिशं जृम्भणास्‍त्रेण जृम्भितम्।\nबाणस्य पृतनां शौरिर्जघानासिगदेषुभिः॥ १०/७८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.014.m4a", "display_order": 15}, {"id": 6000274015, "chapter_id": 10274, "verse_number": "१०-७८-१५", "content_sanskrit": "स्कन्दः प्रद्युम्नबाणौघैरर्द्यमानः समन्ततः।\nअसृग् विमुञ्चन् गात्रेभ्यः शिखिनाऽपाक्रमद् रणात्॥ १०/७८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.015.m4a", "display_order": 16}, {"id": 6000274016, "chapter_id": 10274, "verse_number": "१०-७८-१६", "content_sanskrit": "कुम्भाण्डः कूपकर्णश्च पेततुर्मुसलार्दितौ।\nदुद्रुवुस्तदनीकानि हतनाथानि सर्वतः॥ १०/७८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.016.m4a", "display_order": 17}, {"id": 6000274017, "chapter_id": 10274, "verse_number": "१०-७८-१७", "content_sanskrit": "विशीर्यमाणं स्वबलं दृष्ट्वा बाणोऽत्यमर्षणः।\nकृष्णमभ्यद्रवत् सङ्ख्ये रथी हित्वैव सात्यकिम्॥ १०/७८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.017.m4a", "display_order": 18}, {"id": 6000274018, "chapter_id": 10274, "verse_number": "१०-७८-१८", "content_sanskrit": "धनूंष्याकृष्य युगपद् बाणः पञ्चशतानि वै।\nएकैकस्मिञ्छरौ द्वौ द्वौ सन्दधे रणदुर्मदः॥ १०/७८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.018.m4a", "display_order": 19}, {"id": 6000274019, "chapter_id": 10274, "verse_number": "१०-७८-१९", "content_sanskrit": "तानि चिच्छेद भगवान् धनूंषि युगपद्धरिः।\nसारथिं रथमश्वांश्च हत्वा शङ्खमपूरयत्॥ १०/७८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.019.m4a", "display_order": 20}, {"id": 6000274020, "chapter_id": 10274, "verse_number": "१०-७८-२०", "content_sanskrit": "तन्माता कोटरी नाम नग्ना मुक्तशिरोरुहा।\nपुरोऽवतस्थे कृष्णस्य पुत्रप्राणरिरक्षया॥ १०/७८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.020.m4a", "display_order": 21}, {"id": 6000274021, "chapter_id": 10274, "verse_number": "१०-७८-२१", "content_sanskrit": "ततस्तिर्यङ्मुखो नग्नामनिरीक्षन् गदाग्रजः।\nबाणश्च तावद् विरथश्छिन्नधन्वाऽविशत् पुरम्॥ १०/७८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.021.m4a", "display_order": 22}, {"id": 6000274022, "chapter_id": 10274, "verse_number": "१०-७८-२२", "content_sanskrit": "विद्राविते भूतगणे ज्वरस्तु त्रिशिरास्‍त्रिपात्।\nअभ्यधावत दाशार्हं दहन्निव दिशो दश॥ १०/७८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.022.m4a", "display_order": 23}, {"id": 6000274023, "chapter_id": 10274, "verse_number": "१०-७८-२३", "content_sanskrit": "अथ नारायणो देवस्तं दृष्ट्वा व्यसृजज्ज्वरम्।\nमाहेश्वरो वैष्णवश्च युयुधाते ज्वरावुभौ॥ १०/७८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.023.m4a", "display_order": 24}, {"id": 6000274024, "chapter_id": 10274, "verse_number": "१०-७८-२४", "content_sanskrit": "माहेश्वरः समाक्रन्दन् वैष्णवेन बलार्दितः। अलब्ध्वाऽभयमन्यत्र भीतो माहेश्वरो ज्वरः।\nशरणार्थी हृषीकेशं तुष्टाव प्रयताञ्जलिः॥ १०/७८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.024.m4a", "display_order": 25}, {"id": 6000274025, "chapter_id": 10274, "verse_number": "१०-७८-२५", "content_sanskrit": "नमामि त्वाऽनन्तशक्तिं परेशं सर्वात्मानं केवलं ज्ञप्तिमात्रम्।\nविश्वोत्पत्तिस्थानसंरोधहेतुं यत्तद् ब्रह्म ब्रह्मलिङ्गं प्रशान्तम्॥ १०/७८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.025.m4a", "display_order": 26}, {"id": 6000274026, "chapter_id": 10274, "verse_number": "१०-७८-२६", "content_sanskrit": "कालो दैवं कर्म जीवः स्वभावो द्रव्यं क्षेत्रं प्राण आत्मा विकारः।\nतत्सङ्घातो बीजरोहप्रवाहस्त्वन्मायैषा तन्निषेधं प्रपद्ये॥ १०/७८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.026.m4a", "display_order": 27}, {"id": 6000274027, "chapter_id": 10274, "verse_number": "१०-७८-२७", "content_sanskrit": "नानाभावैर्लीलयैवोपपन्नैर्देवान् साधूँल्लोकसेतून् बिभर्षि।\nहंस्युन्मार्गान् हिंसया वर्तमानान् जन्मैतत्ते भारहाराय भूमेः॥ १०/७८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.027.m4a", "display_order": 28}, {"id": 6000274028, "chapter_id": 10274, "verse_number": "१०-७८-२८", "content_sanskrit": "तप्तोऽहं ते तेजसा दुःसहेन शान्तोग्रेणात्युल्बणेन ज्वरेण।\nतावत्तापो देहिनां तेऽङ्घ्रिमूलं नो सेवेरन् यावदाशानुबद्धाः॥ १०/७८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.028.m4a", "display_order": 29}, {"id": 6000274029, "chapter_id": 10274, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.029.m4a", "display_order": 30}, {"id": 6000274030, "chapter_id": 10274, "verse_number": "१०-७८-२९", "content_sanskrit": "त्रिशिरस्ते प्रसन्नोऽस्मि व्येतु ते मज्ज्वराद् भयम्।\nयो नौ स्मरति संवादं तस्य त्वन्न भवेद् भयम्॥ १०/७८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.030.m4a", "display_order": 31}, {"id": 6000274031, "chapter_id": 10274, "verse_number": "१०-७८-३०", "content_sanskrit": "इत्युक्तोऽच्युतमानम्य गतो माहेश्वरो ज्वरः।\nबाणस्तु रथमारूढः प्रागाद्योत्स्यञ्जनार्दनम्॥ १०/७८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.031.m4a", "display_order": 32}, {"id": 6000274032, "chapter_id": 10274, "verse_number": "१०-७८-३१", "content_sanskrit": "ततो बाहुसहस्रेण नानायुधधरोऽसुरः।\nमुमोच परमक्रुद्धो बाणांश्चक्रायुधे नृप॥ १०/७८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.032.m4a", "display_order": 33, "topics": [{"text": "बाणासुरभुजकृन्तनम्", "range": "३१–३३"}]}, {"id": 6000274033, "chapter_id": 10274, "verse_number": "१०-७८-३२", "content_sanskrit": "तस्यास्यतोऽस्‍त्राण्यसकृच्चक्रेण क्षुरनेमिना।\nचिच्छेद भगवान् बाहून् शाखा इव वनस्पतेः॥ १०/७८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.033.m4a", "display_order": 34}, {"id": 6000274034, "chapter_id": 10274, "verse_number": "१०-७८-३३", "content_sanskrit": "बाहुषु च्छिद्यमानेषु बाणस्य भगवान् भवः।\nभक्तानुकम्प्युपव्रज्य चक्रायुधमभाषत॥ १०/७८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.034.m4a", "display_order": 35}, {"id": 6000274035, "chapter_id": 10274, "verse_number": null, "content_sanskrit": "श्रीरुद्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.035.m4a", "display_order": 36}, {"id": 6000274036, "chapter_id": 10274, "verse_number": "१०-७८-३४", "content_sanskrit": "त्वं हि ब्रह्म परं ज्योतिर्गूढं ब्रह्मणि वाङ्मये।\nयं पश्यन्त्यमलात्मान आकाशमिव केवलम्॥ १०/७८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.036.m4a", "display_order": 37, "topics": [{"text": "शिवेन श्रीकृष्णस्तुतिः, निवेदनं च", "range": "३४–४५"}]}, {"id": 6000274037, "chapter_id": 10274, "verse_number": "१०-७८-३५", "content_sanskrit": "नाभिर्नभोऽग्निर्मुखमम्बु रेतो द्यौः शीर्षमाशा श्रुतिरङ्घ्रिरुर्वी।\nचन्द्रो मनो यस्य दृगर्क आत्मा अहं समुद्रो जठरं भुजेन्द्रः॥ १०/७८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.037.m4a", "display_order": 38}, {"id": 6000274038, "chapter_id": 10274, "verse_number": "१०-७८-३६", "content_sanskrit": "रोमाणि यस्यौषधयोऽम्बुवाहाः केशा विरिञ्चो धिषणा विसर्गः।\nप्रजापतिर्हृदयं यस्य धर्मः स वै भवान् पुरुषो लोककल्पः॥ १०/७८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.038.m4a", "display_order": 39}, {"id": 6000274039, "chapter_id": 10274, "verse_number": "१०-७८-३७", "content_sanskrit": "तवावतारोऽयमकुण्ठधामन् धर्मस्य गुप्त्यै जगतो भवाय।\nवयं च सर्वे भवतानुभाविता विभावयामो भुवनानि सप्त॥ १०/७८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.039.m4a", "display_order": 40}, {"id": 6000274040, "chapter_id": 10274, "verse_number": "१०-७८-३८", "content_sanskrit": "त्वमेक आद्यः पुरुषोऽद्वितीयस्तुर्यः स्वदृग् हेेतुरहेतुरीशः।\nप्रतीयसेऽथापि यथाविकारं स्वमायया सर्वगुणप्रसिद्ध्यै॥ १०/७८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.040.m4a", "display_order": 41}, {"id": 6000274041, "chapter_id": 10274, "verse_number": "१०-७८-३९", "content_sanskrit": "यथैव सूर्योऽपिहितश्छायया स्वया छायां च रूपाणि च सञ्चकास्ति।\nएवं गुणेनापिहितो गुणांस्त्वमात्मप्रदीपो गुणिनश्च भूमन्॥ १०/७८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.041.m4a", "display_order": 42}, {"id": 6000274042, "chapter_id": 10274, "verse_number": "१०-७८-४०", "content_sanskrit": "यन्मायामोहितधियः पुत्रदारगृहादिषु।\nउन्मज्जन्ति निमज्जन्ति प्रसक्ता वृजिनार्णवे॥ १०/७८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.042.m4a", "display_order": 43}, {"id": 6000274043, "chapter_id": 10274, "verse_number": "१०-७८-४१", "content_sanskrit": "देवदत्तमिमं लब्ध्वा नृलोकमजितेन्द्रियः।\nयो नाद्रियेत त्वत्पादौ स शोच्यो ह्यात्मवञ्चकः॥ १०/७८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.043.m4a", "display_order": 44}, {"id": 6000274044, "chapter_id": 10274, "verse_number": "१०-७८-४२", "content_sanskrit": "यस्त्वां विसृजते मर्त्य आत्मानं प्रियमीश्वरम्।\nविपर्ययेन्द्रियार्थार्थं विषमत्त्यमृतं त्यजन्॥ १०/७८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.044.m4a", "display_order": 45}, {"id": 6000274045, "chapter_id": 10274, "verse_number": "१०-७८-४३", "content_sanskrit": "अहं ब्रह्माऽथ विबुधा मुनयश्चामलाशयाः।\nसर्वात्मना प्रपन्नास्त्वामात्मानं प्रेष्ठमीश्वरम्॥ १०/७८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.045.m4a", "display_order": 46}, {"id": 6000274046, "chapter_id": 10274, "verse_number": "१०-७८-४४", "content_sanskrit": "तं त्वा जगत्स्थित्युदयान्तहेतुं समं प्रशान्तं सुहृदात्मदैवम्।\nअनन्यमेकं जगदात्मकेतं भवापवर्गाय भजाम देवम्॥ १०/७८/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.046.m4a", "display_order": 47}, {"id": 6000274047, "chapter_id": 10274, "verse_number": "१०-७८-४५", "content_sanskrit": "अयं ममेष्टो दयितोऽनुवर्ती मयाऽभयं दत्तममुष्य देव।\nसम्पाद्यतां तद् भवतः प्रसादो यथा हि ते दैत्यपतौ प्रसादः॥ १०/७८/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.047.m4a", "display_order": 48}, {"id": 6000274048, "chapter_id": 10274, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.048.m4a", "display_order": 49}, {"id": 6000274049, "chapter_id": 10274, "verse_number": "१०-७८-४६", "content_sanskrit": "यदाऽऽत्थ भगवंस्त्वन्नः करवाम प्रियं तव।\nभवता यद् व्यवसितं तन्मे साध्वनुमोदितम्॥ १०/७८/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.049.m4a", "display_order": 50, "topics": [{"text": "भगवतः प्रत्युत्तरम्", "range": "४६–४९"}]}, {"id": 6000274050, "chapter_id": 10274, "verse_number": "१०-७८-४७", "content_sanskrit": "अवध्योऽयं मयाऽप्येष वैरोचनिसुतोऽसुरः।\nप्रह्लादाय वरो दत्तो न वध्यो मे तवान्वयः॥ १०/७८/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.050.m4a", "display_order": 51}, {"id": 6000274051, "chapter_id": 10274, "verse_number": "१०-७८-४८", "content_sanskrit": "दर्पोपशमनायास्य प्रवृक्णा बाहवो मया।\nसूदितं च बलं भूरि यच्च भारायितं भुवः॥ १०/७८/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.051.m4a", "display_order": 52}, {"id": 6000274052, "chapter_id": 10274, "verse_number": "१०-७८-४९", "content_sanskrit": "चत्वारोऽस्य भुजाः शिष्टा भविष्यन्त्यजरामराः।\nपार्षदमुख्यो भवतो नकुतश्चिद्भयोऽसुरः॥ १०/७८/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.052.m4a", "display_order": 53}, {"id": 6000274053, "chapter_id": 10274, "verse_number": "१०-७८-५०", "content_sanskrit": "इति लब्ध्वाऽभयं कृष्णं प्रणम्य शिरसाऽसुरः।\nप्राद्युम्निं रथमारोप्य स वध्वा समुपानयत्॥ १०/७८/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.053.m4a", "display_order": 54, "topics": [{"text": "उषानिरुद्धयोर्विवाहः", "range": "५०–५३"}]}, {"id": 6000274054, "chapter_id": 10274, "verse_number": "१०-७८-५१", "content_sanskrit": "अक्षौहिण्या परिवृतं सुवासःसमलङ्कृतम्।\nसपत्नीकं पुरस्कृत्य ययौ रुद्रानुमोदितः॥ १०/७८/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.054.m4a", "display_order": 55}, {"id": 6000274055, "chapter_id": 10274, "verse_number": "१०-७८-५२", "content_sanskrit": "स्वराजधानीं समलङ्कृतां ध्वजैः सतोरणैरुक्षितमार्गचत्वराम्।\nविवेश शङ्खानकदुन्दुभिस्वनैरभ्युद्यतः पौरसुहृद्द्विजातिभिः॥ १०/७८/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.055.m4a", "display_order": 56}, {"id": 6000274056, "chapter_id": 10274, "verse_number": "१०-७८-५३", "content_sanskrit": "य एवं कृष्णविजयं शङ्करेण च संयुगम्।\nसंस्मरेत् प्रातरुत्थाय न तस्य स्यात् पराजयः॥ १०/७८/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_078/BhP_10.078.056.m4a", "display_order": 57}, {"id": 6000274057, "chapter_id": 10274, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धेऽष्टसप्ततितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]