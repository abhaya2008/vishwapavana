[{"id": 7005998000, "chapter_id": 25998, "verse_number": "१-१८१-१", "content_sanskrit": "हरिरुवाच । ताम्बूलञ्च घृतं क्षौद्रं लवणं ताम्रभाजने। ।\nतथा पयः समायुक्तं चक्षुः शूलहरं परम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005998001, "chapter_id": 25998, "verse_number": "१-१८१-२", "content_sanskrit": "हरीतकी वचा कुष्ठं व्योषं हिङ्गु मनः शिला ।\nकासे श्वासे च हिक्कायां लिह्यात्क्षौद्रं घृप्लुतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005998002, "chapter_id": 25998, "verse_number": "१-१८१-३", "content_sanskrit": "पिप्पलीत्रिफलाचूर्णं मधुना लेहयेन्नरः ।\nनश्यते पीनसः कासः श्वासश्च बलवत्तरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005998003, "chapter_id": 25998, "verse_number": "१-१८१-४", "content_sanskrit": "समूलचित्रकं भस्मपिप्पलीचूर्णकं लिहेत् ।\nश्वासं कासञ्च हिक्काञ्च मधुमिश्रं वृषध्वज ! ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005998004, "chapter_id": 25998, "verse_number": "१-१८१-५", "content_sanskrit": "नीलोत्पलं शर्करा च मधुकं पद्मकं समम ।\nतण्डुलोदकसंमिश्रं प्रशमेद्रक्तविक्रियाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005998005, "chapter_id": 25998, "verse_number": "१-१८१-६", "content_sanskrit": "शुण्ठी च शर्करा चैव तथा क्षौद्रेण संयुत ।\nकोकिलस्वर एव स्याद्गुटिका भुक्तिमात्रतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005998006, "chapter_id": 25998, "verse_number": "१-१८१-७", "content_sanskrit": "हरितालं शङ्खचूर्णं कदलीदलभस्मना ।\nएतद्द्रव्येण चोद्वर्त्य लोमशातनमुत्तमम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005998007, "chapter_id": 25998, "verse_number": "१-१८१-८", "content_sanskrit": "लवणं हरितालञ्च तुम्बिन्याश्च फलान च ।\nलाक्षारससमायुक्तं लोमशातनमुत्तम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005998008, "chapter_id": 25998, "verse_number": "१-१८१-९", "content_sanskrit": "सुधा च हरितालञ्च शङ्खभस्म मनः शिला। ।\nसैन्धवेन सहैकत्र छागमूत्रेण पेषयेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005998009, "chapter_id": 25998, "verse_number": "१-१८१-१०", "content_sanskrit": "तत्क्षणोद्वर्तनादेव लोमशातनमुत्तमम् ।\nशङ्खमामलकं पत्रं धातक्याः कुसुमानि च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005998010, "chapter_id": 25998, "verse_number": "१-१८१-११", "content_sanskrit": "पिष्ट्वा तत्पयसा सार्धं सप्ताहं धारयेन्मुखे ।\nस्निग्धाः श्वेताश्च दन्ताश्च भवन्ति विमलप्रभाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]