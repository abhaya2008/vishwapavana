[{"id": 2074394, "chapter_id": 2571, "verse_number": "१२-७६-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074395, "chapter_id": 2571, "verse_number": "१२-७६-१", "content_sanskrit": "स्वकर्मण्यपरे युक्तास्तथैवान्ये विकर्मणि।\nतेषां विशेषमाचक्ष्व ब्राह्मणानां पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074396, "chapter_id": 2571, "verse_number": "१२-७६-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074397, "chapter_id": 2571, "verse_number": "१२-७६-२", "content_sanskrit": "विद्यालक्षणसंपन्नाः सर्वत्राम्नायदर्शिनः।\nएते ब्रह्मसमा राजन्ब्राह्मणाः परिकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074398, "chapter_id": 2571, "verse_number": "१२-७६-३", "content_sanskrit": "ऋत्विगाचार्यसंपन्नाः स्वेषु कर्मस्ववस्थिताः।\nएते देवसमा राजन्ब्राह्मणानां भवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074399, "chapter_id": 2571, "verse_number": "१२-७६-४", "content_sanskrit": "`गोऽजाविमहिषाणां च बडवानां च पोषकाः।\nवृत्त्यर्थं प्रतिपद्यन्ते तान्वैश्यान्संप्रचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074400, "chapter_id": 2571, "verse_number": "१२-७६-५", "content_sanskrit": "ऐश्वर्यकामा ये चापि सामिपा वाऽपि भारत।\nनिग्रहानुग्रहरतांस्तान्द्विजान्क्षत्रियान्विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074401, "chapter_id": 2571, "verse_number": "१२-७६-६", "content_sanskrit": "अश्वारोहा गजारोहा रथिनोऽथ पदातयः।\nएते वैश्यसमा राजन्ब्राह्मणानां भवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074402, "chapter_id": 2571, "verse_number": "१२-७६-७", "content_sanskrit": "जन्मकर्मविहीना ये कदर्या ब्रह्मबन्धवः।\nएते शूद्रसमा राजन्ब्राह्मणानां भवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074403, "chapter_id": 2571, "verse_number": "१२-७६-८", "content_sanskrit": "अश्रोत्रियाः सर्वे एते सर्वे चानाहिताग्नयः।\nतान्सर्वान्धार्मिको राजा बलिं विष्टिं च कारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074404, "chapter_id": 2571, "verse_number": "१२-७६-९", "content_sanskrit": "आह्वायका देवलका नाक्षत्रा ग्रामयाजकाः।\nएते ब्राह्मणचाण्डाला महापथिकपञ्चमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074405, "chapter_id": 2571, "verse_number": "१२-७६-१०", "content_sanskrit": "[ऋत्विक्पुरोहितो मन्त्री दूतो वार्तानुकर्षकः।\nएते क्षत्रसमा राजन्ब्राह्मणानां भवन्त्युत॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074406, "chapter_id": 2571, "verse_number": "१२-७६-११", "content_sanskrit": "`म्लेच्छदेशाश्च ये केचित्पापैरध्युषिता नरैः।\nगत्वा तु ब्राह्मणस्तांश्च चण्डालः प्रेत्य चेह च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074407, "chapter_id": 2571, "verse_number": "१२-७६-१२", "content_sanskrit": "व्रात्यान्म्लेच्छांश्च शूद्रांश्च याजयित्वा द्विजाधमः।\nअकीर्तिमिह संप्राप्य नरकं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074408, "chapter_id": 2571, "verse_number": "१२-७६-१३", "content_sanskrit": "महावृन्दसमुद्राभ्यां पर्यायेणैकविंशतिम्।\nब्राह्मणो ऋग्यजुः साम्नां मूढः कृत्वा तु विप्लवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074409, "chapter_id": 2571, "verse_number": "१२-७६-१४", "content_sanskrit": "कल्पमेकं कृमिस्थोऽथ नानाविष्ठासु जायते।\nव्रात्ये म्लेच्छे तथा शूद्रे तस्करे पत्तितेऽशुचौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074410, "chapter_id": 2571, "verse_number": "१२-७६-१५", "content_sanskrit": "कुदेशे च सुरापे च ब्रह्मघ्ने वृषलीपतौ।\nअनधीतेषु सर्वत्र भुञ्जाने यत्र तत्र वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074411, "chapter_id": 2571, "verse_number": "१२-७६-१६", "content_sanskrit": "वालस्त्रीवृद्धहन्तुश्च मातापित्रोर्गुरोस्तथा।\nमित्रद्रुहि कृतघ्ने च गोघ्ने चैव कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074412, "chapter_id": 2571, "verse_number": "१२-७६-१७", "content_sanskrit": "पुत्रघातिनि शत्रौ च न मन्त्राद्याजयेद्द्विजः।\nस तेषां विप्लवः प्रोक्तो मन्त्रविद्भिः सनातनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074413, "chapter_id": 2571, "verse_number": "१२-७६-१८", "content_sanskrit": "यदि विप्रो विदेशस्थस्तीर्थयात्रां गतोऽपि वा।\nयदि भीतः प्रपन्नो वा कुदेशं शौचवर्जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074414, "chapter_id": 2571, "verse_number": "१२-७६-१९", "content_sanskrit": "सुसयतः शुचिर्भुत्वा मन्त्रानुच्चारयेद्द्विजः।\nआर्तश्चोच्चारयेन्मन्त्रमार्तत्राणपरोऽथवा।\nहीनेष्वपि प्रयुञ्जानो नासौ विप्लावकः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074415, "chapter_id": 2571, "verse_number": "१२-७६-२०", "content_sanskrit": "क्रूरकर्मा विकर्मा वा कर्मभिर्वञ्चितोऽथवा।\nतत्त्ववित्तरते पापं शीलवान्सयतेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074416, "chapter_id": 2571, "verse_number": "१२-७६-२१", "content_sanskrit": "एतेभ्यो बलिमादद्याद्धीनकोशो महीपतिः।\nऋते ब्रह्मसमेभ्यश्च देवकल्पेभ्य एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074417, "chapter_id": 2571, "verse_number": "१२-७६-२२", "content_sanskrit": "अब्राह्मणानां वित्तस्य स्वामी राजेति नः श्रुतिः।\nब्राह्मणानां च येकेचिद्विकर्मस्था इति श्रुतिः।\n`प्रागुक्तांश्चाप्यनुक्तांश्च सर्वास्तान्दापयेत्करान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074418, "chapter_id": 2571, "verse_number": "१२-७६-२३", "content_sanskrit": "विकर्मस्थाश्च नोपेक्ष्या विप्रा राज्ञा कथंचन।\nनियम्याः संविभज्याश्च धर्मानुग्रहकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074419, "chapter_id": 2571, "verse_number": "१२-७६-२४", "content_sanskrit": "यस्य स्म विषये राज्ञः स्तेनो भवति वै द्विजः।\nराज्ञ एवापराधं तं मन्यन्ते तद्विदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074420, "chapter_id": 2571, "verse_number": "१२-७६-२५", "content_sanskrit": "अवृत्त्या यो भवेत्स्तेनो वेदवित्स्नातकस्तथा।\nराजन्स राज्ञा भर्तव्य इति वेदविदो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074421, "chapter_id": 2571, "verse_number": "१२-७६-२६", "content_sanskrit": "स चेन्नापि निवर्तेत कृतवृत्तिः परन्तप।\nततो निर्वासनीयः स्यात्तस्माद्देशात्सबान्धवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074422, "chapter_id": 2571, "verse_number": "१२-७६-२७", "content_sanskrit": "`यज्ञः श्रुतमपैशुन्यमर्हिसाऽतिथिपूजनम्।\nदमः सत्यं तपो दानमेतद्ब्राह्मणलक्षणम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074423, "chapter_id": 2571, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि षट्सप्ततितमोऽध्यायः॥ ७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]