[{"id": 2170501, "chapter_id": 4641, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2170502, "chapter_id": 4641, "verse_number": "१", "content_sanskrit": "द्रौणिस्तु रथवंशेन महता परिवारितः ।\nआपतत्सहसा राजन् यत्र पार्थो व्यवस्थितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2170503, "chapter_id": 4641, "verse_number": "२", "content_sanskrit": "तमापतन्तं सहसा शूरः शौरिसहायवान् ।\nदधार सहसा पार्थो वेलेव मकरालयम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2170504, "chapter_id": 4641, "verse_number": "३", "content_sanskrit": "ततः क्रुद्धो महाराज द्रोणपुत्रः प्रतापवान् ।\nअर्जुनं वासुदेवं च छादयामास सायकैः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2170505, "chapter_id": 4641, "verse_number": "४", "content_sanskrit": "अवच्छन्नौ ततः कृष्णौ दृष्ट्वा तत्र महारथाः ।\nविस्मयं परमं गत्वा प्रैक्षन्त कुरवस्तदा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2170506, "chapter_id": 4641, "verse_number": "५", "content_sanskrit": "अर्जुनस्तु ततो दिव्यमस्त्रं चक्रे हसन्निव ।\nतदस्त्रं ब्राह्मणो युद्धे वारयामास भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2170507, "chapter_id": 4641, "verse_number": "६", "content_sanskrit": "यद्यद्धि व्याक्षिपद् युद्धे पाण्डवोऽस्त्रं जिघांसया ।\nतत्तदस्त्रं महेष्वासो द्रोणपुत्रो व्यशातयत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2170508, "chapter_id": 4641, "verse_number": "७", "content_sanskrit": "अस्त्रयुद्धे ततो राजन् वर्तमाने भयावहे ।\nअपश्याम रथे द्रौणिं व्यात्ताननमिवान्तकम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2170509, "chapter_id": 4641, "verse_number": "८", "content_sanskrit": "स दिशो विदिशश्चैव छादयित्वा विजिह्मगैः ।\nवासुदेवं त्रिभिर्बाणैरविध्यद् दक्षिणे भुजे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2170510, "chapter_id": 4641, "verse_number": "९", "content_sanskrit": "ततोऽर्जुनो हयान् हत्वा सर्वांस्तस्य महात्मनः ।\nचकार समरे भूमिं शोणितौघतरङ्गिणीम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2170511, "chapter_id": 4641, "verse_number": "१०", "content_sanskrit": "निहता रथिनः पेतुः पार्थचापच्युतैः शरैः ।\nहयाश्च पर्यधावन्त मुक्तयोक्त्रास्ततस्ततः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2170512, "chapter_id": 4641, "verse_number": "११", "content_sanskrit": "तद् दृष्ट्वा कर्म पार्थस्य द्रौणिराहवशोभिनः ।\nअवाकिरद् रणे कृष्णौ समन्तान्निशितैः शरैः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2170513, "chapter_id": 4641, "verse_number": "१२", "content_sanskrit": "गाण्डीवधन्वा प्रसभं शरवर्षैरुदारधीः ।\nसञ्छाद्य समरे द्रौणिं चिच्छेदास्य च कार्मुकम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2170514, "chapter_id": 4641, "verse_number": "१३", "content_sanskrit": "स च्छिन्नधन्वा परिघं वज्रस्पर्शसमं युधि ।\nआदाय चिक्षेप तदा द्रोणपुत्रः किरीटिने\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2170515, "chapter_id": 4641, "verse_number": "१४", "content_sanskrit": "तमापतन्तं परिघं कार्तस्वरविभूषितम् ।\nपार्थश्चिच्छेद सहसा तत उच्चुक्रुशुर्जनाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2170516, "chapter_id": 4641, "verse_number": "१५", "content_sanskrit": "सोऽनेकधापतद् भूमौ रणे पार्थस्य सायकैः ।\nविशीर्णः पर्वतो राजन् यथा वज्रेण ताडितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2170517, "chapter_id": 4641, "verse_number": "१६", "content_sanskrit": "ततोऽर्जुनो रणे द्रौणिं विव्याध दशभिः शरैः ।\nसारथिं चास्य भल्लेन रथनीडादपाहरत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2170518, "chapter_id": 4641, "verse_number": "१७", "content_sanskrit": "स सङ्गृह्य स्वयं वाहान् कृष्णौ प्राच्छादयच्छरैः ।\nतत्राद्भुतमपश्याम द्रौणेराशु पराक्रमम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2170519, "chapter_id": 4641, "verse_number": "१८", "content_sanskrit": "अयच्छत्तुरगान्यच्च फल्गुनं चाप्ययोधयत् ।\nतदस्य समरे राजन् सर्वे योधा अपूजयन्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2170520, "chapter_id": 4641, "verse_number": "१९", "content_sanskrit": "यदा त्वाक्रम्यत रणे द्रोणपुत्रेण फल्गुनः ।\nततो रश्मीन् रथाश्वानां क्षुरप्रैश्छिच्छिदे जयः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2170521, "chapter_id": 4641, "verse_number": "२०", "content_sanskrit": "प्राद्रवंस्तुरगास्ते तु शरवेगप्रपीडिताः ।\nततोऽभून्निनदो भूयस्तव सैन्यस्य भारत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2170522, "chapter_id": 4641, "verse_number": "२१", "content_sanskrit": "पाण्डवास्तु जयं लब्ध्वा तव सैन्यमुपाद्रवन् ।\nसमन्तान्निशितान् बाणान् विमुञ्चन्तो जयैषिणः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2170523, "chapter_id": 4641, "verse_number": "२२", "content_sanskrit": "पाण्डवैस्तु महाराज धार्तराष्ट्री महाचमूः ।\nपुनः पुनरथो वीरैरभञ्जि जितकाशिभिः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2170524, "chapter_id": 4641, "verse_number": "२३", "content_sanskrit": "पश्यतां ते महाराज पुत्राणां चित्रयोधिनाम् ।\nशकुनेः सौबलेयस्य कर्णस्य च विशाम्पते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2170525, "chapter_id": 4641, "verse_number": "२४", "content_sanskrit": "वार्यमाणा महासेना पुत्रैस्तव जनेश्वर ।\nनावतिष्ठत सङ्ग्रामे ताड्यमाना समन्ततः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2170526, "chapter_id": 4641, "verse_number": "२५", "content_sanskrit": "ततो योधैर्महाराज पलायद्भिस्ततस्ततः ।\nअभवद् व्याकुलं भीतैः पुत्राणां ते महद् बलम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2170527, "chapter_id": 4641, "verse_number": "२६", "content_sanskrit": "तिष्ठ तिष्ठेति सततं सूतपुत्रस्य जल्पतः ।\nनावतिष्ठत सा सेना वध्यमाना महात्मभिः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2170528, "chapter_id": 4641, "verse_number": "२७", "content_sanskrit": "अथोत्क्रुष्टं महाराज पाण्डवैर्जितकाशिभिः ।\nधार्तराष्ट्रबलं दृष्ट्वा द्रवमाणं समन्ततः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2170529, "chapter_id": 4641, "verse_number": "२८", "content_sanskrit": "ततो दुर्योधनः कर्णमब्रवीत् प्रणयादिव ।\nपश्य कर्ण यथा सेना पाण्डवैरर्दिता भृशम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2170530, "chapter_id": 4641, "verse_number": "२९", "content_sanskrit": "त्वयि तिष्ठति सन्त्रासात् पलायनपरायणा ।\nएतज्ज्ञात्वा महाबाहो कुरु प्राप्तमरिन्दम\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2170531, "chapter_id": 4641, "verse_number": "३०", "content_sanskrit": "सहस्राणि च योधानां त्वामेव पुरुषर्षभ ।\nक्रोशन्ति समरे वीर द्राव्यमाणानि पाण्डवैः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2170532, "chapter_id": 4641, "verse_number": "३१", "content_sanskrit": "एतच्छ्रुत्वा तु राधेयो दुर्योधनवचो महान् ।\nमद्रराजमिदं वाक्यमब्रवीत् सूतनन्दनः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2170533, "chapter_id": 4641, "verse_number": "३२", "content_sanskrit": "पश्य मे भुजयोर्वीर्यमस्त्राणां च जनेश्वर ।\nअद्य हन्मि रणे सर्वान् पाञ्चालान् पाण्डुभिः सह\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2170534, "chapter_id": 4641, "verse_number": "३३", "content_sanskrit": "वाहयाश्वान्नरव्याघ्र भद्रायैव न संशयः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2170535, "chapter_id": 4641, "verse_number": "३४", "content_sanskrit": "एवमुक्त्वा महाराज सूतपुत्रः प्रतापवान् ।\nप्रगृह्य विजयं वीरो धनुःश्रेष्ठं पुरातनम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2170536, "chapter_id": 4641, "verse_number": "३५", "content_sanskrit": "सज्यं कृत्वा महाराज सम्मृज्य च पुनः पुनः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2170537, "chapter_id": 4641, "verse_number": "३६", "content_sanskrit": "सन्निवार्य च योधान् स्वान् सत्येन शपथेन च ।\nप्रायोजयदमेयात्मा भार्गवास्त्रं महाबलः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2170538, "chapter_id": 4641, "verse_number": "३७", "content_sanskrit": "ततो राजन् सहस्राणि प्रयुतान्यर्बुदानि च ।\nकोटिशश्च शरास्तीक्ष्णाः निरगच्छन् महामृधे\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2170539, "chapter_id": 4641, "verse_number": "३८", "content_sanskrit": "ज्वलितैस्तैर्महाघोरैः कङ्कबर्हिणवाजितैः ।\nसञ्छन्ना पाण्डवी सेना न प्राज्ञायत किञ्चन\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2170540, "chapter_id": 4641, "verse_number": "३९", "content_sanskrit": "भार्गवं भार्गवश्रेष्ठादवाप्तमतितेजसम् ।\nयेन प्रयुज्यमानेन सदेवासुरमानवम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2170541, "chapter_id": 4641, "verse_number": "४०", "content_sanskrit": "सपातालार्णवजलं सम्प्राप्तं प्रलयोत्तमम् ।\nसशैलकाननवनं त्रैलोक्यमशिवं बभौ\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2170542, "chapter_id": 4641, "verse_number": "४१", "content_sanskrit": "हाहाकारो महानासीत् पाञ्चालानां विशाम्पते ।\nपीडितानां बलवता भार्गवास्त्रेण संयुगे\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2170543, "chapter_id": 4641, "verse_number": "४२", "content_sanskrit": "निपतद्भिर्गजै राजन्नरैश्चापि सहस्रशः ।\nरथैश्चापि नरव्याघ्र हयैश्चापि समन्ततः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2170544, "chapter_id": 4641, "verse_number": "४३", "content_sanskrit": "प्राकम्पत मही राजन्निहतैस्तैस्ततस्ततः ।\nव्याकुलं सर्वमभवत् पाण्डवानां महद्बलम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2170545, "chapter_id": 4641, "verse_number": "४४", "content_sanskrit": "कर्णस्त्वेको युधां श्रेष्ठो विधूम इव पावकः ।\nदहन् शत्रून्नरव्याघ्र शुशुभे स परन्तपः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2170546, "chapter_id": 4641, "verse_number": "४५", "content_sanskrit": "ते वध्यमानाः कर्णेन पाञ्चालाश्चेदिभिः सह ।\nतत्र तत्र व्यमुह्यन्त वनदाहे यथा द्विपाः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2170547, "chapter_id": 4641, "verse_number": "४६", "content_sanskrit": "चुक्रुशुस्ते नरव्याघ्र यथाप्राणं नरोत्तमाः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2170548, "chapter_id": 4641, "verse_number": "४७", "content_sanskrit": "तेषां तु क्रोशतां दीनं भीतानां रणमूर्धनि ।\nधावतां च दिशो राजन् वित्रस्तानां समन्ततः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2170549, "chapter_id": 4641, "verse_number": "४८", "content_sanskrit": "आर्तनादो महानासीत् प्रेतानामिव सम्प्लवे\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2170550, "chapter_id": 4641, "verse_number": "४९", "content_sanskrit": "वध्यमानांस्तु तान् दृष्ट्वा सूतपुत्रेण मारिष ।\nवित्रेसुः सर्वभूतानि तिर्यग्योनिगतान्यपि\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2170551, "chapter_id": 4641, "verse_number": "५०", "content_sanskrit": "ते वध्यमानाः समरे सूतपुत्रेण सृञ्जयाः ।\nअर्जुनं वासुदेवं च व्याक्रोशन्त मुहुर्मुहुः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2170552, "chapter_id": 4641, "verse_number": "५१", "content_sanskrit": "प्रेतराजपुरे यद्वत् प्रेतराजं विचेतसः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2170553, "chapter_id": 4641, "verse_number": "५२", "content_sanskrit": "श्रुत्वा तु निनदं तेषां वध्यतां कर्णसायकैः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2170554, "chapter_id": 4641, "verse_number": "५३", "content_sanskrit": "अथाब्रवीद् वासुदेवं कुन्तीपुत्रो धनञ्जयः ।\nभार्गवास्त्रं महाघोरं दृष्ट्वा तत्र समीरितम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2170555, "chapter_id": 4641, "verse_number": "५४", "content_sanskrit": "पश्य कृष्ण महाबाहो भार्गवास्त्रस्य विक्रमम् ।\nनैतदस्त्रं हि समरे शक्यं हन्तुं कथञ्चन\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2170556, "chapter_id": 4641, "verse_number": "५५", "content_sanskrit": "सूतपुत्रं च संरब्धं पश्य कृष्ण महारणे ।\nअन्तकप्रतिमं वीरं कुर्वाणं कर्म दारुणम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2170557, "chapter_id": 4641, "verse_number": "५६", "content_sanskrit": "अभीक्ष्णं चोदयन्नश्वान् प्रेक्षते मां मुहुर्मुहुः ।\nन च पश्यामि समरे कर्णं प्रति पलायितुम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2170558, "chapter_id": 4641, "verse_number": "५७", "content_sanskrit": "जीवन् प्राप्नोति पुरुषः सङ्खे जयपराजयौ ।\nमृतस्य तु हृषीकेश वध एव कुतो जयः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2170559, "chapter_id": 4641, "verse_number": "५८", "content_sanskrit": "एवमुक्तस्तु पार्थेन कृष्णो मतिमतां वरम् ।\nधनञ्जयमुवाचेदं प्राप्तकालमरिन्दमम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2170560, "chapter_id": 4641, "verse_number": "", "content_sanskrit": "(कर्णेन हि दृढं राजा कुन्तीपुत्रः परिक्षतः ।\nतं दृष्ट्वाश्वास्य च पुनः कर्णं पार्थ वधिष्यसि\t॥५९॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2170561, "chapter_id": 4641, "verse_number": "६०", "content_sanskrit": "ततो जनार्दनः प्रायाद् द्रष्टुमिच्छन्युधिष्ठिरम् ।\nश्रमेण ग्राहयिष्यंश्च कर्णं युद्धेन मारिष\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2170562, "chapter_id": 4641, "verse_number": "६१", "content_sanskrit": "विश्रमार्थं च कौरव्य पाण्डवस्य महात्मनः ।\nअपयातो रणाद् वीरो राजानं द्रष्टुमेव च\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2170563, "chapter_id": 4641, "verse_number": "६२", "content_sanskrit": "प्रत्यनीकमवस्थाप्य भीमं भीमपराक्रमम् ।\nअलं विषहितुं ह्येष कुरूणां सम्प्रपद्यताम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2170564, "chapter_id": 4641, "verse_number": "६३", "content_sanskrit": "ततो धनञ्जयो द्रष्टुं राजानं बाणपीडितम् ।\nरथेन प्रययौ क्षिप्रं सङ्ग्रामे केशवाज्ञया\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2170565, "chapter_id": 4641, "verse_number": "६४", "content_sanskrit": "गच्छन्नेव तु कौन्तेयो धर्मराजदिदृक्षया ।\nसैन्यमालोकयामास नापश्यत् तत्र चाग्रजम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2170566, "chapter_id": 4641, "verse_number": "६५", "content_sanskrit": "युद्धं कृत्वा तु कौन्तेयो द्रोणपुत्रेण भारत ।\nदुःसहं वज्रिणा सङ्खे पराजिग्ये गुरोः सुतम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2170567, "chapter_id": 4641, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nएकषष्टितमोऽध्यायः ॥६१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]