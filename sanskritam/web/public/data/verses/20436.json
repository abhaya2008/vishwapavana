[{"id": 7000436000, "chapter_id": 20436, "verse_number": "२-१०८-१", "content_sanskrit": "कुंजल उवाच ।\nब्रह्मपुत्रो महातेजा वशिष्ठस्तपतां वरः ।\nनहुषं तं समाहूय इदं वचनमब्रवीत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000436001, "chapter_id": 20436, "verse_number": "२-१०८-२", "content_sanskrit": "वनं गच्छ स्वशीघ्रेण वन्यमानय पुष्कलम् ।\nसमाकर्ण्य मुनेर्वाक्यं नहुषो वनमाययौ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000436002, "chapter_id": 20436, "verse_number": "२-१०८-३", "content_sanskrit": "तत्र किंचित्सुवृत्तांतं शुश्राव नहुषो बलः ।\nअयमेष स धर्मात्मा नहुषो नाम वीर्यवान्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000436003, "chapter_id": 20436, "verse_number": "२-१०८-४", "content_sanskrit": "आयोः पुत्रो महाप्राज्ञो बाल्यान्मात्रा वियोजितः ।\nअस्यैवातिवियोगेन आयुभार्या प्ररोदिति॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000436004, "chapter_id": 20436, "verse_number": "२-१०८-५", "content_sanskrit": "अशोकसुंदरी तेपे तपः परमदुष्करम् ।\nकदा पश्यति सा देवी पुत्रमिंदुमती शुभा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000436005, "chapter_id": 20436, "verse_number": "२-१०८-६", "content_sanskrit": "नाहुषं नाम धर्मज्ञं हृतं पूर्वं तु दानवैः ।\nतपस्तेपे निरालंबा शिवस्य तनया वरा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000436006, "chapter_id": 20436, "verse_number": "२-१०८-७", "content_sanskrit": "अशोकसुंदरी बाला आयुपुत्रस्य कारणात् ।\nअनेनापि कदा सा हि संगता तु भविष्यति॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000436007, "chapter_id": 20436, "verse_number": "२-१०८-८", "content_sanskrit": "एवं सांसारिकं वाक्यं दिवि चारणभाषितम् ।\nशुश्राव स हि धर्मात्मा नहुषो विभ्रमान्वितः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000436008, "chapter_id": 20436, "verse_number": "२-१०८-९", "content_sanskrit": "स गत्वा वन्यमादाय वशिष्ठस्याश्रमं प्रति ।\nवन्यं निवेद्य धर्मात्मा वशिष्ठाय महात्मने॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000436009, "chapter_id": 20436, "verse_number": "२-१०८-१०", "content_sanskrit": "बद्धांजलिपुटोभूत्वा भक्त्या नमितकंधरः ।\nतमुवाच महाप्राज्ञं वशिष्ठं तपतां वरम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000436010, "chapter_id": 20436, "verse_number": "२-१०८-११", "content_sanskrit": "भगवञ्छ्रूयतां वाक्यमपूर्वं चारणेरितम् ।\nएष वै नहुषो नाम्ना आयुपुत्रो वियोजितः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000436011, "chapter_id": 20436, "verse_number": "२-१०८-१२", "content_sanskrit": "मात्रा सह सुदुःखैस्तु इंदुमत्या हि दानवैः ।\nशिवस्य तनया बाला तपस्तेपे सुदुश्चरम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000436012, "chapter_id": 20436, "verse_number": "२-१०८-१३", "content_sanskrit": "निमित्तमस्य धीरस्य नहुषस्येति वै गुरो ।\nएवमाभाषितं तैस्तु तत्सर्वं हि मया श्रुतम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000436013, "chapter_id": 20436, "verse_number": "२-१०८-१४", "content_sanskrit": "कोसावायुः स धर्मात्मा कासा त्विंदुमती शुभा ।\nअशोकसुंदरी कासा नहुषेति क उच्यते॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000436014, "chapter_id": 20436, "verse_number": "२-१०८-१५", "content_sanskrit": "एतन्मे संशयं जातं तद्भवांश्छेत्तुमर्हति ।\nअन्यः कोपि महाप्राज्ञः कुत्रासौ नहुषेति च॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000436015, "chapter_id": 20436, "verse_number": "२-१०८-१६", "content_sanskrit": "तत्सर्वं तात मे ब्रूहि कारणांतरमेव हि ।\nवशिष्ठ उवाच ।\nआयु राजा स धर्मात्मा सप्तद्वीपाधिपो बली॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000436016, "chapter_id": 20436, "verse_number": "२-१०८-१७", "content_sanskrit": "भार्या इंदुमती तस्य सत्यरूपा यशस्विनी ।\nतस्यामुत्पादितः पुत्रो भवान्वै गुणमंदिरम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000436017, "chapter_id": 20436, "verse_number": "२-१०८-१८", "content_sanskrit": "आयुना राजराजेन सोमवंशस्य भूषणम् ।\nहरस्य कन्या सुश्रोणी गुणरूपैरलंकृता॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000436018, "chapter_id": 20436, "verse_number": "२-१०८-१९", "content_sanskrit": "अशोकसुंदरी नाम्ना सुभगा चारुहासिनी ।\nतस्य हेतोस्तपस्तेपे निरालंबा तपोवने॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000436019, "chapter_id": 20436, "verse_number": "२-१०८-२०", "content_sanskrit": "तस्या भर्ता भवान्सृष्टो धात्रा योगेन निश्चितः ।\nगंगायास्तीरमाश्रित्य ध्यानयोग समाश्रिता॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000436020, "chapter_id": 20436, "verse_number": "२-१०८-२१", "content_sanskrit": "हुंडश्च दानवेंद्रो यो दृष्ट्वा चैकाकिनीं सतीम् ।\nतपसा प्रज्वलंतीं च सुभगां कमलेक्षणाम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000436021, "chapter_id": 20436, "verse_number": "२-१०८-२२", "content_sanskrit": "रूपौदार्यगुणोपेतां कामबाणैः प्रपीडितः ।\nतां बभाषेऽन्तिकं गत्वा मम भार्या भवेति च॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000436022, "chapter_id": 20436, "verse_number": "२-१०८-२३", "content_sanskrit": "एवं सा तद्वचः श्रुत्वा तमुवाच तपस्विनी ।\nमा हुंड साहसं कार्षीर्मा जल्पस्व पुनः पुनः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000436023, "chapter_id": 20436, "verse_number": "२-१०८-२४", "content_sanskrit": "अप्राप्याहं त्वया वीर परभार्या विशेषतः ।\nदैवेन मे पुरा सृष्ट आयुपुत्रो महाबलः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000436024, "chapter_id": 20436, "verse_number": "२-१०८-२५", "content_sanskrit": "नहुषो नाम मेधावी भविष्यति न संशयः ।\nदेवदत्तो महातेजा अन्यथा त्वं करिष्यसि॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000436025, "chapter_id": 20436, "verse_number": "२-१०८-२६", "content_sanskrit": "ततः शाप्रं पदास्यामि येन भस्मी भविष्यसि ।\nएवमाकर्ण्य तद्वाक्यं कामबाणैः प्रपीडितः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000436026, "chapter_id": 20436, "verse_number": "२-१०८-२७", "content_sanskrit": "व्याजेनापि हृता तेन प्रणीता निजमंदिरे ।\nज्ञात्वा तया महाभाग शप्तोऽसौ दानवाधमः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000436027, "chapter_id": 20436, "verse_number": "२-१०८-२८", "content_sanskrit": "नहुषस्यैव हस्तेन तव मृत्युर्भविष्यति ।\nअजाते त्वयि संजाता वदसे त्वं यथैव तत्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000436028, "chapter_id": 20436, "verse_number": "२-१०८-२९", "content_sanskrit": "स त्वमायुसुतो वीर हृतो हुंडेन पापिना ।\nसूदेन रक्षितो दास्या प्रेषितो मम चाश्रमम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000436029, "chapter_id": 20436, "verse_number": "२-१०८-३०", "content_sanskrit": "भवंतं वनमध्ये च दृष्ट्वा चारणकिन्नरैः ।\nयत्तु वै श्रावितं वत्स मया ते कथितं पुनः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000436030, "chapter_id": 20436, "verse_number": "२-१०८-३१", "content_sanskrit": "जहि तं पापकर्तारं हुंडाख्यं दानवाधमम् ।\nनेत्राभ्यां हि प्रमुंचंतीमश्रूणि परिमार्जय॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000436031, "chapter_id": 20436, "verse_number": "२-१०८-३२", "content_sanskrit": "इतो गत्वा प्रपश्य त्वं गंगातीरं महाबलम् ।\nनिपात्य दानवेंद्रं तं कारागृहात्समानय॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000436032, "chapter_id": 20436, "verse_number": "२-१०८-३३", "content_sanskrit": "अशोकसुंदरी याहि तस्या भर्ता भवस्व हि ।\nएतत्ते सर्वमाख्यातं प्रश्नस्यास्य हि कारणम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000436033, "chapter_id": 20436, "verse_number": "२-१०८-३४", "content_sanskrit": "आभाष्य नहुषं विप्रो विरराम महामतिः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000436034, "chapter_id": 20436, "verse_number": "२-१०८-३५", "content_sanskrit": "आकर्ण्य सर्वं मुनिना प्रयुक्तमाश्चर्यभूतं स हि चिंत्यमानः ।\nतस्यांतमेकः परिकर्तुकाम आयोः सुतः कोपमथो चकार॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]