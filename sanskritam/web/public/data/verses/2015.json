[{"id": 2045660, "chapter_id": 2015, "verse_number": "६-६४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2045661, "chapter_id": 2015, "verse_number": "६-६४-१", "content_sanskrit": "ततो भूरिश्रवा राजन्सात्यकिं नवभिः शरैः।\nप्राविध्यद्भृशसंक्रुद्धस्तोत्रैरिव महाद्विपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2045662, "chapter_id": 2015, "verse_number": "६-६४-२", "content_sanskrit": "कौरवं सात्यकिश्चैव शरैः सन्नतपर्वभिः।\nअवारयदमेयात्मा सर्वलोकस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2045663, "chapter_id": 2015, "verse_number": "६-६४-३", "content_sanskrit": "ततो दुर्योधनो राजा सोदर्यैः परिवारितः।\nसोमदत्तिं रणे यत्तः समन्तात्पर्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2045664, "chapter_id": 2015, "verse_number": "६-६४-४", "content_sanskrit": "तं चैव पाण्डवाः सर्वे सात्यकिं रभसं रणे।\nपरिवार्य स्थिताः सङ्ख्ये समन्तात्सुमहौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2045665, "chapter_id": 2015, "verse_number": "६-६४-५", "content_sanskrit": "भीमसेनस्तु संक्रुद्धो गजामुद्यम्य भारत ।\nदुर्योधनमुखान्सर्वान्पुत्रांस्ते पर्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2045666, "chapter_id": 2015, "verse_number": "६-६४-६", "content_sanskrit": "रथैरनेकसाहस्रैः क्रोधामर्षसमन्वितः ।\nनन्दकस्तव पुत्रस्तु भीमसेनं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2045667, "chapter_id": 2015, "verse_number": "६-६४-७", "content_sanskrit": "विव्याध विशिखैः षड्भिः कङ्कपत्रैः शिलाशितैः ।\nदुर्योधनस्तदा राजन्भीमसेनं महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2045668, "chapter_id": 2015, "verse_number": "६-६४-८", "content_sanskrit": "आजघानोरसि क्रुद्धो मार्गणैर्नवभिः शितैः ।\nततो भीमो महाबाहुः स्वरथं सुमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2045669, "chapter_id": 2015, "verse_number": "६-६४-९", "content_sanskrit": "आरुरोह रथश्रेष्ठं विशोकं चेदमब्रवीत् ।\nएते महारथाः शूरा धार्तराष्ट्राः समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2045670, "chapter_id": 2015, "verse_number": "६-६४-१०", "content_sanskrit": "मामेव भृशसंक्रुद्धा हन्तुमभ्युद्यता युधि।\nमनोरथद्रुमोऽस्माकं चिन्तितो बहुवार्षिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2045671, "chapter_id": 2015, "verse_number": "६-६४-११", "content_sanskrit": "सफलः सूत चाद्येह योऽहं पश्यामि सोदरान्।\nयत्राशोकसमुत्क्षिप्ता रेणवो रथनेमिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2045672, "chapter_id": 2015, "verse_number": "६-६४-१२", "content_sanskrit": "प्रयास्यन्त्यन्तरिक्षं हि शरबृन्दैर्दिगन्तरे ।\nतत्र तिष्ठति सन्नद्धः स्वयं राजा सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2045673, "chapter_id": 2015, "verse_number": "६-६४-१३", "content_sanskrit": "भ्रातरश्चास्य सन्नद्धाः कुलपुत्रा मदोत्कटाः ।\nएतानद्य हनिष्यामि पश्यतस्ते न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2045674, "chapter_id": 2015, "verse_number": "६-६४-१४", "content_sanskrit": "तस्मान्ममाश्वान्संग्रमे यत्तः संयच्छ सारथे।\nएवमुक्त्वा ततः पार्थस्तव पुत्रं विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2045675, "chapter_id": 2015, "verse_number": "६-६४-१५", "content_sanskrit": "विव्याध निशितैस्तीक्ष्णैः शरैः कनकभूषणैः।\nनन्दकं च त्रिभिर्भाणैरभ्यविध्यत्स्तनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2045676, "chapter_id": 2015, "verse_number": "६-६४-१६", "content_sanskrit": "तं तु दुर्योधनः षष्ट्या विद्ध्वा भीमं महाबलम्।\nत्रिभिरन्यैः सुनिशितैर्विशोकं प्रत्यविध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2045677, "chapter_id": 2015, "verse_number": "६-६४-१७", "content_sanskrit": "भिमस्य च रणे राजन्धनुश्चिच्छेद भासुरम् ।\nमुष्टिदेशे भृशं तीक्ष्णौस्त्रिभिर्भल्लैर्हसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2045678, "chapter_id": 2015, "verse_number": "६-६४-१८", "content_sanskrit": "समरे प्रेक्ष्य यन्तारं विशोकं तु वृकोदरः ।\nपीडितं विशिखैस्तीक्ष्णैस्तव पुत्रेण धन्विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2045679, "chapter_id": 2015, "verse_number": "६-६४-१९", "content_sanskrit": "अमृष्यमाणः संरब्धो धनुर्दिव्यं परामृशम् ।\nपुत्रस्य ते महाराज वधार्थं भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2045680, "chapter_id": 2015, "verse_number": "६-६४-२०", "content_sanskrit": "समादधत्सुसंक्रुद्धः क्षुरप्रं रोमवाहिनम् ।\nतेन चिच्छेद नृपतेर्भीमः कार्मुकमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2045681, "chapter_id": 2015, "verse_number": "६-६४-२१", "content_sanskrit": "सोऽपविद्ध्य धनुश्छिन्नं पुत्रस्ते क्रोधमूर्च्छितः ।\nअन्यत्कार्मुकमादत्त सत्वरं वेगवत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2045682, "chapter_id": 2015, "verse_number": "६-६४-२२", "content_sanskrit": "संदधे विशिखं घोर कालमृत्युसमप्रभम् ।\nतेनाजघान संक्रुद्धो भीमसेनं स्तनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2045683, "chapter_id": 2015, "verse_number": "६-६४-२३", "content_sanskrit": "स गाढविद्धो व्यथितः स्यान्दनोपस्थ आविशत्।\nस निषण्णो रथोपस्थे मूर्च्छामभिजगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2045684, "chapter_id": 2015, "verse_number": "६-६४-२४", "content_sanskrit": "तं दृष्ट्वा व्यथितं भीममभिमन्युपुरोगमाः ।\nनामृष्यन्त महेष्वासाः पाण्डवानां महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2045685, "chapter_id": 2015, "verse_number": "६-६४-२५", "content_sanskrit": "ततस्तु तुमुलां वृष्टिं शस्त्राणां तिग्मतेजसाम् ।\nपातयामासुरव्यग्राः पुत्रस्य तव मूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2045686, "chapter_id": 2015, "verse_number": "६-६४-२६", "content_sanskrit": "प्रतिलभ्य ततः संज्ञां भीमसेनो महाबलः ।\nदुर्योधनं त्रिभिर्विद्ध्वा पुनर्विव्याध पञ्चभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2045687, "chapter_id": 2015, "verse_number": "६-६४-२७", "content_sanskrit": "शल्यं च पञ्चविंशत्या शरैर्विव्याध पाण्डवः।\nरुक्मपुङ्खैर्महेष्वासः स विद्धो व्यपयाद्रणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2045688, "chapter_id": 2015, "verse_number": "६-६४-२८", "content_sanskrit": "प्रत्युद्ययुस्ततो भीमं तव पुत्राश्चतुर्दश ।\nसेनापतिः सुषेणश्च जलसन्धः सुलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2045689, "chapter_id": 2015, "verse_number": "६-६४-२९", "content_sanskrit": "उद्रो भीमरथो भीमो वीरबाहुरलोलुपः ।\nदुर्मुखो दुष्प्रधर्षश्च विवित्सुर्विकटः समः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2045690, "chapter_id": 2015, "verse_number": "६-६४-३०", "content_sanskrit": "विसृजन्तो बहून्बाणान्क्रोधसंरक्तलोचनाः ।\nभीमसेनमभिद्रुत्य विव्यधुः सहिता भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2045691, "chapter_id": 2015, "verse_number": "६-६४-३१", "content_sanskrit": "पुत्रांस्तु तव संप्रेक्ष्य भीमसेनो महाबलः ।\nसृक्किणी विलिहन्वीरः पशुमध्ये यथा वृकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2045692, "chapter_id": 2015, "verse_number": "६-६४-३२", "content_sanskrit": "अभिपत्य महाबाहुर्गरुत्मानिव वेगितः।\nसेनापतेः क्षुरप्रेण शिरश्चिच्छेद पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2045693, "chapter_id": 2015, "verse_number": "६-६४-३३", "content_sanskrit": "संप्रहस्य च हृष्टात्मा त्रिभिर्बाणैर्महाभुजः ।\nजलसन्धं विनिर्भिद्य सोऽनयद्यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2045694, "chapter_id": 2015, "verse_number": "६-६४-३४", "content_sanskrit": "सुषेणं च ततो हत्वा प्रेषयामास मृत्यवे।\nउग्रस्य सशिरस्त्राणं शिरश्चन्द्रोपमं भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2045695, "chapter_id": 2015, "verse_number": "६-६४-३५", "content_sanskrit": "पातयामास भल्लेन कुण्डलाभ्यां विभूषितम्।\nवीरबाहुं च सप्तत्या साश्वकेतुं ससारथिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2045696, "chapter_id": 2015, "verse_number": "६-६४-३६", "content_sanskrit": "निनाय समरे वीरः परलोकाय पाण्डवः।\nभीमं भीमरथं चोभौ भीमसेनो हसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2045697, "chapter_id": 2015, "verse_number": "६-६४-३७", "content_sanskrit": "पुत्रौ ते दुर्मदौ राजन्ननयद्यमसादनम् ।\nततः सुलोचनं भीमः क्षुरप्रेण महामृधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2045698, "chapter_id": 2015, "verse_number": "६-६४-३८", "content_sanskrit": "मिषतां सर्वसैन्यानामनयद्यमसादनम्।\nपुत्रास्तु तव तं दृष्ट्वा भीमसेनपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2045699, "chapter_id": 2015, "verse_number": "६-६४-३९", "content_sanskrit": "शेषा येऽन्येऽभवंस्तत्र ते भीमस्य भयार्दिताः।\nविप्रद्रुता दिशो राजन्वध्यमाना महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2045700, "chapter_id": 2015, "verse_number": "६-६४-४०", "content_sanskrit": "ततोऽब्रवीच्छान्तनवः सर्वानेव महारथान्।\nएष भीमो रणे क्रुद्धो धार्तराष्ट्रान्महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2045701, "chapter_id": 2015, "verse_number": "६-६४-४१", "content_sanskrit": "यथा प्राग्र्यान्यथा ज्येष्ठान्यथा शूरांश्च संगतान्।\nनिपातयत्युग्रधन्वा तं प्रगृह्णीत माचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2045702, "chapter_id": 2015, "verse_number": "६-६४-४२", "content_sanskrit": "एवमुक्त्वा ततः सर्वे धार्तराष्ट्रस्य सैनिकाः।\nअभ्यद्रवन्त संक्रुद्धा भीमसेनं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2045703, "chapter_id": 2015, "verse_number": "६-६४-४३", "content_sanskrit": "भगदत्तः प्रभिन्नेन कुञ्जरेण विशांपते ।\nअभ्ययात्सहसा तत्रयत्र भीमो व्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2045704, "chapter_id": 2015, "verse_number": "६-६४-४४", "content_sanskrit": "आपतन्नेव च रणे भीमसेनं शिलीमुखैः ।\nअदृश्यं समरे चक्रे जीमूत इव भास्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2045705, "chapter_id": 2015, "verse_number": "६-६४-४५", "content_sanskrit": "अभिमन्युमुखास्तत्तु नामृष्यन्त महारथाः ।\nभीमस्याच्छादनं शङ्ख्ये स्वबाहुबलमाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2045706, "chapter_id": 2015, "verse_number": "६-६४-४६", "content_sanskrit": "त एनं शरवर्षेण समन्तात्पर्यवारयन् । ६-६४-४६bगजं च शरवृष्ट्या तु बिभिदुस्ते समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2045707, "chapter_id": 2015, "verse_number": "६-६४-४७", "content_sanskrit": "स शस्त्रवृष्ट्याऽभिहतः समस्तैस्तैर्महारथैः।\nप्राग्ज्योतिषगजो राजन्नानालिङ्गैः सुतेजनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2045708, "chapter_id": 2015, "verse_number": "६-६४-४८", "content_sanskrit": "संजातरुधिरोत्पीडः प्रेक्षणीयोऽभवद्रणे।\nगभस्तिभिरिवार्कस्य संस्यूतो जलदो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2045709, "chapter_id": 2015, "verse_number": "६-६४-४९", "content_sanskrit": "संचोदितो मदस्रावी भगदत्तेन वारणः।\nअभ्यधावत तन्सर्वान्कालोत्सृष्ट इवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2045710, "chapter_id": 2015, "verse_number": "६-६४-५०", "content_sanskrit": "द्विगुणं जवमास्थाय कम्पयंश्चरणैर्महीम्।\nतस्य तत्सुमहद्रूपं दृष्ट्वा सर्वे महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2045711, "chapter_id": 2015, "verse_number": "६-६४-५१", "content_sanskrit": "असह्यं मन्यमानाश्च नातिप्रमनसोऽभवन् ।\nततस्तु नृपतिः क्रुद्धो भीमसेनं स्तनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2045712, "chapter_id": 2015, "verse_number": "६-६४-५२", "content_sanskrit": "आजघान महाराज शरेणानतपर्वणा।\nसोऽतिविद्धो महेष्वासस्तेन राज्ञा महारथः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2045713, "chapter_id": 2015, "verse_number": "६-६४-५३", "content_sanskrit": "मूर्च्छयाऽभिपरीतात्मा ध्वजयष्टिं समाश्रयत्।\nतांस्तु भीतान्समालक्ष्य भीमसेनं च मूर्च्छितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2045714, "chapter_id": 2015, "verse_number": "६-६४-५४", "content_sanskrit": "ननाद बलवन्नादं भगदत्तः प्रतापवान्।\nततो घटोत्कचो राजन्प्रेक्ष्य भीमं तथाऽऽगतं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2045715, "chapter_id": 2015, "verse_number": "६-६४-५५", "content_sanskrit": "संक्रुद्धो राक्षसो घोरस्तत्रैवान्तरधीयत।\nस कृत्वा दारुणां मायां भूरूणां भयवर्धिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2045716, "chapter_id": 2015, "verse_number": "६-६४-५६", "content_sanskrit": "अदृश्यत निमेषार्धाद्धोररूपं समास्थितः।\nऐरावतं समारूढः स वै मायाकृतं स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2045717, "chapter_id": 2015, "verse_number": "६-६४-५७", "content_sanskrit": "तस्य चान्येऽपि दिङ्वागा बभूवुरनुयायिनः।\nअञ्जनो वमानश्चैव महापद्मश्च सुप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2045718, "chapter_id": 2015, "verse_number": "६-६४-५८", "content_sanskrit": "त्रय एते महानागा राक्षसैः समधिष्ठिताः।\nमहाकायास्त्रिधा राजन्प्रस्रवन्तो मदं बहु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2045719, "chapter_id": 2015, "verse_number": "६-६४-५९", "content_sanskrit": "तेजोवीर्यबलोपेता महाबलपराक्रमाः।\nघटोत्कचस्तु स्वं नागं चोदयामास तं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2045720, "chapter_id": 2015, "verse_number": "६-६४-६०", "content_sanskrit": "सगजं भगदत्तं तु हन्तुकामः परंतपः।\nते चान्ये चोदिता नागा राक्षसैस्तैर्महाबलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2045721, "chapter_id": 2015, "verse_number": "६-६४-६१", "content_sanskrit": "परिपेतुः सुसंरब्धाश्चतुर्दंष्ट्राश्चतुर्दिशम्।\nभगदत्तस्य तं नागं विषाणैरभ्यपीडयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2045722, "chapter_id": 2015, "verse_number": "६-६४-६२", "content_sanskrit": "स पीड्यमानस्तैर्नागैर्वेदनार्तः शराहतः।\nअनदत्सुमहानादमिन्द्राशनिसमस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2045723, "chapter_id": 2015, "verse_number": "६-६४-६३", "content_sanskrit": "`व्यवर्तत महाघोषो भैमसेनिशरार्दितः ।\nमृदित्वा सर्वसैन्यानि तव पुत्रस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2045724, "chapter_id": 2015, "verse_number": "६-६४-६४", "content_sanskrit": "तस्य तं नदतो नादं सुघोरं भीमनिःश्वनम् ।\nश्रुत्वा भीष्मोऽब्रवीद्द्रोणं राजानं च सुयोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2045725, "chapter_id": 2015, "verse_number": "६-६४-६५", "content_sanskrit": "एष युध्यति संग्रामे हैडिम्बेन दुरात्मना।\nभगदत्तो महेष्वासः कृच्छ्रे च परिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2045726, "chapter_id": 2015, "verse_number": "६-६४-६६", "content_sanskrit": "राक्षसश्च महामायः स च राजाऽतिकोपनः ।\nएतौ समेतौ समरे कालमृत्युसमावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2045727, "chapter_id": 2015, "verse_number": "६-६४-६७", "content_sanskrit": "श्रीयते चैव हृष्टानां पाण्डवानां महास्वनः ।\nहस्तिनश्चैव सुमहान्भीतस्य रुदितध्वनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2045728, "chapter_id": 2015, "verse_number": "६-६४-६८", "content_sanskrit": "तत्र गच्छाम भद्रं वो राजानं परिरक्षितुम् ।\nअरक्ष्यमाणः समरे क्षिप्रं प्राणान्विमोक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2045729, "chapter_id": 2015, "verse_number": "६-६४-६९", "content_sanskrit": "ते त्वरध्वं महावीर्याः किं चिरेण प्रयामहे ।\nमहान्हि वर्तते रौद्रः संग्रामो रोमहर्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2045730, "chapter_id": 2015, "verse_number": "६-६४-७०", "content_sanskrit": "भक्तश्च कुलपुत्रश्च शूरश्च पृतनापतिः।\nयुक्तं तस्य परित्राणं कर्तुमस्माभिरच्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2045731, "chapter_id": 2015, "verse_number": "६-६४-७१", "content_sanskrit": "भीष्मस्य तद्वचः श्रुत्वा सर्व एव महारथाः ।\nद्रोणभीष्मौ पुरस्कृत्य भगदत्तपरीप्सया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2045732, "chapter_id": 2015, "verse_number": "६-६४-७२", "content_sanskrit": "उत्तमं जवमास्थाय प्रययुर्यत्र सोऽभवत्।\nतान्प्रयातान्समालोक्य युधिष्ठिरपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2045733, "chapter_id": 2015, "verse_number": "६-६४-७३", "content_sanskrit": "पञ्चालाः पाण्डवैः सार्धं पृष्ठतोऽनुययुः परान्।\nतान्यनीकान्यथालोक्य राक्षसेन्द्रः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2045734, "chapter_id": 2015, "verse_number": "६-६४-७४", "content_sanskrit": "ननाद सुमहानादं विस्फोटमशनेरिव ।\nतस्य तं निनदं श्रुत्वा दृष्ट्वा नागांश्च युध्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2045735, "chapter_id": 2015, "verse_number": "६-६४-७५", "content_sanskrit": "भीष्मः शान्तनवो भूयो भारद्वाजमभाषत ।\nन रोचते मे संग्रामो हैडिम्बेन दुरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2045736, "chapter_id": 2015, "verse_number": "६-६४-७६", "content_sanskrit": "बलवीर्यमसाविष्टः ससहायश्च सांप्रतज् ।\nनैष शक्यो युधा जेतुमपि वज्रभृता स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2045737, "chapter_id": 2015, "verse_number": "६-६४-७७", "content_sanskrit": "लब्धलक्षः प्रहारी च वयं च श्रान्तवाहनाः।\nपाञ्चालैः पाण्डवेयैश्च दिवसं क्षतविक्षताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2045738, "chapter_id": 2015, "verse_number": "६-६४-७८", "content_sanskrit": "इदानीं युधि निर्जेतुं न शक्योऽसौ स राक्षसः ।\nअस्तमभ्येति सविता रात्रौ योद्धुं कन शक्यते।\nअवहारमतः कुर्मः श्वो योत्स्यामः परै सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2045739, "chapter_id": 2015, "verse_number": "६-६४-७९", "content_sanskrit": "पितामहवचः श्रुत्वा यथा चक्रुःस्म कौरवाः ।\nउपायेनापयानं ते घटोत्कचभयार्दिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2045740, "chapter_id": 2015, "verse_number": "६-६४-८०", "content_sanskrit": "कौरवेषु निवृत्तेषु पाण्डवा जितकाशिनः।\nसिंहनादान्भृशं चक्रुः शङ्खान्दध्मुश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2045741, "chapter_id": 2015, "verse_number": "६-६४-८१", "content_sanskrit": "एवं तदभवद्युद्धं दिवसं भरतर्षभ ।\nपाण्डवानां कुरूणां च पुरस्कृत्य घटोत्कचम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2045742, "chapter_id": 2015, "verse_number": "६-६४-८२", "content_sanskrit": "कौरवास्तु ततो राजन्प्रययुः शिबिरं स्वकम्।\nव्रीडमाना निशाकाले पाण्डवेयैः पराजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2045743, "chapter_id": 2015, "verse_number": "६-६४-८३", "content_sanskrit": "शरविक्षतगात्रास्तु पाण्डपपुत्रा महारथाः।\nयुद्धे सुमनसो भूत्वा जग्मुः स्वशिबिरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2045744, "chapter_id": 2015, "verse_number": "६-६४-८४", "content_sanskrit": "पुरस्कृत्य महाराज भीमसेनघटोत्कचौ।\nपूजयन्तस्तदान्योन्यं मुदा परमया युताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2045745, "chapter_id": 2015, "verse_number": "६-६४-८५", "content_sanskrit": "नदन्तो विविधान्नादांस्तूर्यस्वनविमिश्रितान् ।\nसिंहनादांश्च कुर्वन्तो विमिश्राञ्शङ्खनिः स्वनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2045746, "chapter_id": 2015, "verse_number": "६-६४-८६", "content_sanskrit": "विनदन्तो महात्मानः कम्पयन्तश्च मेदिनीम् ।\nघट्टयन्तश्च मर्माणि तव पुत्रस्य मारिष ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2045747, "chapter_id": 2015, "verse_number": "६-६४-८७", "content_sanskrit": "प्रयाताः शिबिरायैव निशाकाले परंतप ।\nदुर्योधनस्तु नृपतिर्दीनो भ्रातृवधेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2045748, "chapter_id": 2015, "verse_number": "६-६४-८८", "content_sanskrit": "मुहूर्तं चिन्तयामास बाष्पशोकसमाकुलः।\nततः कृत्वा विधिं सर्वं शिबिरस्य यथाविधि ।\nप्रदध्यौ शोकसंतप्तो भ्रातृव्यसनकर्शितः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2045749, "chapter_id": 2015, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि चतुर्थदिवसयुद्धे चतुःषष्टितमोऽध्यायः ॥ ॥ इति चतुर्थदिवसयुद्धं समाप्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]