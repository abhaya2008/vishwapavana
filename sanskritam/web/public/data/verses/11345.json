[{"id": 50006311, "chapter_id": 11345, "verse_number": "1", "content_sanskrit": "[न्यायमाला (अनुव्याख्याने २-४-२-३)- ---- ---- तत्र स्पष्टार्थवच्छ्रुतिः। विशेषश्रुतिवैरूप्यं माहात्म्यं व्यक्तसद्गुणाः। दृष्टायुक्तिः समानत्वं कर्तृशक्तिर्विमिश्रिता। युक्तयः पूर्वपक्षेषु सुनिर्णीतास्तु तादृशाः। युक्तयो निर्णयस्यैव स्वयं भगवतोदिताः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006312, "chapter_id": 11345, "verse_number": "2", "content_sanskrit": "॥ ॐ तथा प्राणाः ॐ॥ स्पष्टार्थवच्छ्रुतिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006313, "chapter_id": 11345, "verse_number": "3", "content_sanskrit": "॥ ॐ तत्प्राक्छ्रुतेश्च ॐ॥ विशेषश्रुतिवैरूप्यम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50006314, "chapter_id": 11345, "verse_number": "4", "content_sanskrit": "॥ ॐ तत्पूर्वकत्वाद् वाचः ॐ॥ विशेषश्रुतिवैरूप्यम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50006315, "chapter_id": 11345, "verse_number": "5", "content_sanskrit": "॥ ॐ सप्त गतेर्विशेषितत्वाच्च ॐ॥ विशेषश्रुतिवैरूप्यम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50006316, "chapter_id": 11345, "verse_number": "6", "content_sanskrit": "॥ ॐ अणवश्च ॐ॥ विशेषश्रुतिवैरूप्यम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50006317, "chapter_id": 11345, "verse_number": "7", "content_sanskrit": "॥ ॐ श्रेष्ठश्च ॐ (ॐ चक्षुरादिवत् तु तत्सहशिष्ट्यादिभ्यः ॐ) ॥ माहात्म्यम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50006318, "chapter_