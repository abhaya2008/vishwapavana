[{"id": 900004847, "chapter_id": 8369, "verse_number": "5.1", "content_sanskrit": "तक्को जगत्कर्ता । 'तक निर्माणे' इति धातोः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004848, "chapter_id": 8369, "verse_number": "5.2", "content_sanskrit": "अतीदु शक्र ओहत इन्द्रो विश्वा अति द्विष:", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004849, "chapter_id": 8369, "verse_number": "5.3", "content_sanskrit": "अर्भको न कुमारकोऽधितिष्ठन्नवं रथम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004850, "chapter_id": 8369, "verse_number": "5.4", "content_sanskrit": "यथास्थिताः प्रज्ञाताः । इतस्ततस्संयोजनं विना यथास्थितशंसनं पथः प्राप्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004851, "chapter_id": 8369, "verse_number": "5.5", "content_sanskrit": "व्याप्तो विशेषेणापन्नः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900004852, "chapter_id": 8369, "verse_number": "5.6", "content_sanskrit": "इतस्ततो विशेषेण हृतं विहृतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900004853, "chapter_id": 8369, "verse_number": "5.7", "content_sanskrit": "न चैवमादिवाक्यानां स्वार्थे प्रामाण्याभावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900004854, "chapter_id": 8369, "verse_number": "5.8", "content_sanskrit": "यत्र वाचनिकार्थादन्यस्तात्पर्यार्थः प्रतीयते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900004855, "chapter_id": 8369, "verse_number": "5.9", "content_sanskrit": "वेदवाक्यस्य तु वाचनिकार्थं विना नैवान्यो युज्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900004856, "chapter_id": 8369, "verse_number": "5.10", "content_sanskrit": "वाचनिकानां तु बहूनामप्यविरोधे स्वीकार्यता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900004857, "chapter_id": 8369, "verse_number": "5.11", "content_sanskrit": "वाचनिकमर्थं परित्यज्य नियोगार्थकल्पने ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900004858, "chapter_id": 8369, "verse_number": "5.12", "content_sanskrit": "न च क्रियायामेव प्रयोजनं न सिद्ध इति युक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900004859, "chapter_id": 8369, "verse_number": "5.13", "content_sanskrit": "न च कर्ममात्रे पर्यवसितिर्वेदस्य । सुखज्ञानस्यैव प्रयोजनत्वात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900004860, "chapter_id": 8369, "verse_number": "5.14", "content_sanskrit": "प्रशंसादीनां च तात्पर्यं वाचनिकार्थात्यागेनैव कथितं स्वयं भगवता..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900004861, "chapter_id": 8369, "verse_number": "5.15", "content_sanskrit": "उद्यन्द्रध्नस्य विष्टपं गृहमिन्द्रश्च गन्वहि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900004862, "chapter_id": 8369, "verse_number": "5.16", "content_sanskrit": "अपाः पूर्वेषां हरिवः सुतानामथो इदं सवनं केवलं ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900004863, "chapter_id": 8369, "verse_number": "5.17", "content_sanskrit": "विहृतपक्षे तु-पादान्व्यवधायार्धर्चशश्शंसेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900004864, "chapter_id": 8369, "verse_number": "5.18", "content_sanskrit": "महानाम्नीनां पञ्चाक्षरानुपसर्गानुपसृजत्येकादशाक्षरेषु पादेषु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900004865, "chapter_id": 8369, "verse_number": "5.19", "content_sanskrit": "भगवद्भक्तिज्ञानवैराग्यपूर्वकं च कर्म कर्तव्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900004866, "chapter_id": 8369, "verse_number": "5.20", "content_sanskrit": "नमो नारायणायाजभवशक्रोष्णरुङ्मुखैः । सदा वन्दितपादाय श्रीपाय प्रेयसेऽधिकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]