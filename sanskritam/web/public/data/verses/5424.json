[{"id": 2207485, "chapter_id": 5424, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207486, "chapter_id": 5424, "verse_number": "१", "content_sanskrit": "शुभानामशुभानां च नेह नाशोऽस्ति कर्मणाम् ।\nप्राप्य प्राप्य तु पच्यन्ते क्षेत्रं क्षेत्रं तथा तथा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207487, "chapter_id": 5424, "verse_number": "२", "content_sanskrit": "यथा प्रसूयमानस्तु समादद्यात् फलं बहु ।\nतथा स्याद् विपुलं पुण्यं शुद्धेन मनसा कृतम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207488, "chapter_id": 5424, "verse_number": "३", "content_sanskrit": "पापं चापि तथैव स्यात् पापेन मनसा कृतम् ।\nपुरोधाय मनो हीह कर्मण्यात्मा प्रवर्तते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207489, "chapter_id": 5424, "verse_number": "४", "content_sanskrit": "यथा कर्म समाविष्टः काममन्युसमावृतः ।\nनरो गर्भं प्रविशति तत्रापि शृणु चोत्तरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207490, "chapter_id": 5424, "verse_number": "५", "content_sanskrit": "शुक्रं शोणितसंयुक्तं स्त्रिया गर्भाशयं गतम् ।\nक्षेत्रधर्ममवाप्नोति शुभं वा यदि वाऽशुभम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207491, "chapter_id": 5424, "verse_number": "६", "content_sanskrit": "सौक्ष्म्यादव्यक्तभावाच्च न स क्वचन सज्जति ।\nसम्प्राप्य ब्रह्मणः कायं तस्मात् तद् ब्रह्म शाश्वतम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207492, "chapter_id": 5424, "verse_number": "७", "content_sanskrit": "तद्बीजं सर्वजन्तूनां तेन जीवन्ति जन्तवः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207493, "chapter_id": 5424, "verse_number": "८", "content_sanskrit": "स जीवः सर्वजन्तूनां गर्भमाविश्य भागशः ।\nस याति तेजसा सम्यक् प्राणस्थानेष्ववस्थितः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207494, "chapter_id": 5424, "verse_number": "९", "content_sanskrit": "ततः स्पन्दयतेऽङ्गानि स गर्भश्चेतनान्वितः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207495, "chapter_id": 5424, "verse_number": "१०", "content_sanskrit": "यथा लोहितविष्यन्दो निषिक्तो बिम्बविग्रहम् ।\nउपैति तद्वज्जानीहि गर्भे जीवप्रवेशनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207496, "chapter_id": 5424, "verse_number": "११", "content_sanskrit": "लोहपिण्डं यथा वह्निः स प्रविश्यातितापयेत् ।\nतथा त्वमपि जानीहि गर्भे जीवोपपादनम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207497, "chapter_id": 5424, "verse_number": "१२", "content_sanskrit": "यथा च दीपः शरणं दीप्यमानः प्रकाशयेत् ।\nएवमेव शरीराणि प्रकाशयति चेतना\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207498, "chapter_id": 5424, "verse_number": "१३", "content_sanskrit": "यद्यच्च कुरुते कर्म शुभं वा यदि वाऽशुभम् ।\nपूर्वदेहकृतं सर्वमवश्यमुपभुज्यते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207499, "chapter_id": 5424, "verse_number": "१४", "content_sanskrit": "ततस्तु क्षीयते चैव पुनश्चान्यत् प्रचीयते ।\nयावत् तु मोक्षयोगस्थं धर्मं नैवावबुध्यते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207500, "chapter_id": 5424, "verse_number": "१५", "content_sanskrit": "तत् ते धर्मं प्रवक्ष्यामि सुखी भवति येन वै ।\nआवर्तमानो जातीषु यथाऽन्योन्यासु सत्तम\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207501, "chapter_id": 5424, "verse_number": "१६", "content_sanskrit": "दानं व्रतं ब्रह्मचर्यं यथोक्तव्रतधारणम् ।\nदमः प्रशान्तता चैव भूतानां चानुकम्पनम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207502, "chapter_id": 5424, "verse_number": "१७", "content_sanskrit": "संयमश्चानृशंस्यं च परस्वादानवर्जनम् ।\nव्यलीकानामकरणं भूतानामनुकम्पनम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207503, "chapter_id": 5424, "verse_number": "१८", "content_sanskrit": "मातापित्रोश्च शुश्रूषा देवतातिथिपूजनम् ।\nगुरुपूजा घृणा शौचं नित्यमिन्द्रियसंयमः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207504, "chapter_id": 5424, "verse_number": "१९", "content_sanskrit": "प्रवर्तनं शुभानां च तत् सतां व्रतमुच्यते ।\nततो धर्मः प्रभवति यः प्रजाः पाति शाश्वतम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207505, "chapter_id": 5424, "verse_number": "२०", "content_sanskrit": "सद्भिराचरितो धर्मः सदाचारे प्रतिष्ठितः ।\nउभयार्थो भवत्येव स्वर्गार्थो मोक्षदस्तथा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207506, "chapter_id": 5424, "verse_number": "२१", "content_sanskrit": "एवं सत्सु सदा पश्येत् तत्र ह्येषा ध्रुवा स्थितिः ।\nआचारो धर्ममाचष्टे यस्मिन् सन्तो व्यवस्थिताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207507, "chapter_id": 5424, "verse_number": "२२", "content_sanskrit": "तेषु तद्धर्मनिक्षिप्तो यः स धर्मः सनातनः ।\nयस्तं समभिपद्येत न स दुर्गतिमाप्नुयात्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207508, "chapter_id": 5424, "verse_number": "२३", "content_sanskrit": "अतो नियम्यते लोकः प्रमुह्यन् धर्मवर्त्मसु ।\nयस्तु योगी च मुक्तश्च स वै तेभ्यो विशिष्यते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207509, "chapter_id": 5424, "verse_number": "२४", "content_sanskrit": "वर्तमानस्य धर्मेण पुरुषस्य यथा तथा ।\nसंसारतारणं यस्य कालेन महता भवेत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207510, "chapter_id": 5424, "verse_number": "२५", "content_sanskrit": "एवं पूर्वकृतं कर्म सर्वो जन्तुर्निषेवते ।\nसर्वं तत् कारणं येन निकृतोऽयमिहागतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207511, "chapter_id": 5424, "verse_number": "२६", "content_sanskrit": "शरीरग्रहणं चास्य केन पूर्वं प्रकल्पितम् ।\nइत्येवं संशये लोके तच्च वक्ष्याम्यतःपरम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2207512, "chapter_id": 5424, "verse_number": "२७", "content_sanskrit": "शरीरमात्मनः कृत्वा सर्वलोकपितामहः ।\nत्रैलोक्यमसृजद् ब्रह्मा कृत्स्नं स्थावरजङ्गमम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2207513, "chapter_id": 5424, "verse_number": "२८", "content_sanskrit": "ततः प्रधानमसृजद् चेतनानां शरीरिणाम् ।\nमया सर्वमिदं व्याप्तं यां लोके परमां विदुः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2207514, "chapter_id": 5424, "verse_number": "२९", "content_sanskrit": "इह तत् क्षरमित्युक्तं परं त्वमृतमक्षरम् ।\nत्रयाणां मिथुनं सर्वम् एकैकस्य पृथक् पृथक्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2207515, "chapter_id": 5424, "verse_number": "३०", "content_sanskrit": "असृजत् सर्वभूतानां पूर्वसृष्टिं प्रजापतिः ।\nस्थावराणि च बीजानि इत्येषा पौर्विकी श्रुतिः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2207516, "chapter_id": 5424, "verse_number": "३१", "content_sanskrit": "तस्य कालपरीणाममकरोत् स पितामहः ।\nभूतेषु परिवृत्तिं च पुनरावृत्तिमेव च\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2207517, "chapter_id": 5424, "verse_number": "३२", "content_sanskrit": "यथाऽत्र कश्चिन्मेधावी दृष्ट्वा कर्म तु पूर्वकम् ।\nयत् प्रवक्ष्यामि तत्सर्वं यथावदुपपद्यते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2207518, "chapter_id": 5424, "verse_number": "३३", "content_sanskrit": "सुखं दुःखं यथा सम्यगनित्ये यः प्रपश्यति ।\nकायं चामेध्यसङ्घातं विनाशं कर्मसंहितम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2207519, "chapter_id": 5424, "verse_number": "३४", "content_sanskrit": "यच्च किञ्चित् सुखं दृष्टं तच्च दुःखमिति स्मरन् ।\nसंसारसागरं घोरं तरिष्यति सुदुस्तरम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2207520, "chapter_id": 5424, "verse_number": "३५", "content_sanskrit": "जनीमरणरोगैश्च समाविष्टः प्रधानवित् ।\nचेतनावत्सु चैतन्यं समं भूतेषु पश्यति\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2207521, "chapter_id": 5424, "verse_number": "३६", "content_sanskrit": "निर्विद्यते स्वतः कश्चिन्मार्गमाणः परं पदम् ।\nतस्योपदेशं वक्ष्यामि याथातथ्येन सत्तम\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2207522, "chapter_id": 5424, "verse_number": "३७", "content_sanskrit": "शाश्वतस्याव्ययस्याथ पदस्य ज्ञानमुत्तमम् ।\nप्रोच्यमानं मया विप्र निबोधेदमशेषतः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2207523, "chapter_id": 5424, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि\nगर्भविचारकथनं नाम अष्टादशोऽध्यायः ॥१८॥\nअनुगीतापर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]