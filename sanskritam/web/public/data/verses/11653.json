[{"id": 50020033, "chapter_id": 11653, "verse_number": "1", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50020034, "chapter_id": 11653, "verse_number": "2", "content_sanskrit": "देवासुरमनुष्येषु ये भजन्त्यशिवं शिवम्। प्रायस्ते धनिनो ब्रह्मन् न तु लक्ष्मीपतिं हरिम्॥ १०/९२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50020035, "chapter_id": 11653, "verse_number": "3", "content_sanskrit": "एतद् वेदितुमिच्छामि सन्देहोऽत्र महान् हि नः। विरुद्धशीलयोः प्रभ्वोर्विरुद्धां भजतोर्गतिम्॥ १०/९२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50020036, "chapter_id": 11653, "verse_number": "4", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50020037, "chapter_id": 11653, "verse_number": "5", "content_sanskrit": "शिवः शक्तियुतः शश्वत् त्रिलिङ्गो गुणसंवृतः। वैकारिकस्तैजसश्च तामसश्चेत्यहं त्रिधा॥ १०/९२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50020038, "chapter_id": 11653, "verse_number": "6", "content_sanskrit": "ततो विकारा अभवन् षोडशामीषु पञ्चसु। उपाधावन् विभूतीनां सर्वासामश्नुते फलम्॥ १०/९२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50020039, "chapter_id": 11653, "verse_number": "7", "content_sanskrit": "हरिस्तु निर्गुणः साक्षात् पुरुषः प्रकृतेः परः। स सर्वदृगुपद्रष्टा तं भजन् निर्गुणो भवेत्॥ १०/९२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50020040, "chapter_id": 11653, "verse_number": "8", "content_sanskrit": "निवृत्तेष्वश्वमेधेषु राजा युष्मत्पितामहः। शृण्वन् भगवतो धर्मानपृच्छदिदमच्युतम्॥ १०/९२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50020041, "chapter_id": 11653, "verse_number": "9", "content_sanskrit": "स चाह भगवांस्तस्मै प्रीतः शुश्रूषवे प्रभुः। नृणां निःश्रेयसार्थाय योऽवतीर्णो यदोः कुले॥ १०/९२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50020042, "chapter_id": 11653, "verse_number": "10", "content_sanskrit": "श्रीभगवानुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50020043, "chapter_id": 11653, "verse_number": "11", "content_sanskrit": "यस्याहमनुगृह्णामि हरिष्ये तद्धनं शनैः। ततोऽधनं त्यजन्त्यस्य स्वजना दुःखदुःखिनम्॥ १०/९२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50020044, "chapter_id": 11653, "verse_number": "12", "content_sanskrit": "स यदा वितथोद्योगो निर्विण्णः स्याद् धनेहया। मत्परैः कृतमैत्रस्य करिष्ये तदनुग्रहम्॥ १०/९२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50020045, "chapter_id": 11653, "verse_number": "13", "content_sanskrit": "तद् ब्रह्म परमं सूक्ष्मं चिन्मात्रं सदनन्तकम्। अतो मां सुदुराराध्यं हित्वाऽन्यान् भजते पुनः॥ १०/९२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50020046, "chapter_id": 11653, "verse_number": "14", "content_sanskrit": "ततस्त आशुतोषेभ्यो लब्धराज्यश्रियोद्धताः। प्रमत्ता वरदान् देवान् विस्मरन्त्यवजानते॥ १०/९२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50020047, "chapter_id": 11653, "verse_number": "15", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50020048, "chapter_id": 11653, "verse_number": "16", "content_sanskrit": "शापप्रसादयोरीशा ब्रह्मविष्णुशिवादयः। सद्यः शापप्रसादोऽङ्ग शिवो ब्रह्मा च नाच्युतः॥ १०/९२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50020049, "chapter_id": 11653, "verse_number": "17", "content_sanskrit": "अत्रैवोदाहरन्तीममितिहासं पुरातनम्। वृकासुराय गिरिशो वरं दत्वाऽऽप सङ्कटम्॥ १०/९२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50020050, "chapter_id": 11653, "verse_number": "18", "content_sanskrit": "वृको नामासुरः पुत्रः शकुनेः पथि नारदम्। दृष्ट्वाऽऽशुतोषं पप्रच्छ देवेषु त्रिषु दुर्मतिः॥ १०/९२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50020051, "chapter_id": 11653, "verse_number": "19", "content_sanskrit": "स आदिदेश गिरिशमुपाधावस्व सिद्धये। सोऽल्पाभ्यां गुणदोषाभ्यामाशु तुष्यति कुप्यति॥ १०/९२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50020052, "chapter_id": 11653, "verse_number": "20", "content_sanskrit": "दशास्यबाणयोस्तुष्टः स्तुवतोर्वन्दिनोरिव। ≠श्वर्यमतुलं दत्त्वा तत आप सुसङ्कटम्॥ १०/९२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50020053, "chapter_id": 11653, "verse_number": "21", "content_sanskrit": "इत्यादिष्टस्तमसुर उपाधावत् सुयन्त्रितः। केदार आत्मक्रव्येण जुह्वन्नग्निमुखं हरम्॥ १०/९२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50020054, "chapter_id": 11653, "verse_number": "22", "content_sanskrit": "देवोपलब्धिमप्राप्य निर्वेदात् सप्तमेऽहनि। शिरो जिहीर्षुरसिना स तीर्थक्ल्न्निमूर्धजः॥ १०/९२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50020055, "chapter_id": 11653, "verse_number": "23", "content_sanskrit": "तदा महाकारुणिकः स धूर्जटिर्यथाऽवयव्यग्निरिवोत्थितोऽनलात्। निगृह्य दोर्भ्यां भुजयोर्न्यवारयत् तत्स्पर्शनाद् भूय उपाकृताकृतिम्॥ १०/९२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50020056, "chapter_id": 11653, "verse_number": "24", "content_sanskrit": "तमाह चाङ्गालमलं वृणीष्व मे यथानिकामं वितरामि ते वरम्। शिवेन जीवेन नृणां प्रपद्यतामहो त्वयाऽऽत्मा भृशमर्द्यते वृथा॥ १०/९२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50020057, "chapter_id": 11653, "verse_number": "25", "content_sanskrit": "देवात् स वव्रे पापीयान् वरं भूतभयावहम्। यस्य पुंसः करं शीर्ष्णि धास्ये स म्रियतामिति॥ १०/९२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50020058, "chapter_id": 11653, "verse_number": "26", "content_sanskrit": "तच्छ्र२त्वा भगवान् रुद्रो दुर्मना इव भारत। ओमिति प्रहसंस्तस्मै ददौ वरमृतं तथा॥ १०/९२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50020059, "chapter_id": 11653, "verse_number": "27", "content_sanskrit": "स तद्वरपरीक्षार्थं शम्भोः शीर्ष्णि वृकासुरः। स्वहस्तं दातुमारेभे सोऽबिभेत् स्वकृताच्छिवः॥ १०/९२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50020060, "chapter_id": 11653, "verse_number": "28", "content_sanskrit": "तेनोपसृष्टः सन्त्रस्तः पराधावत् सवेपथुः। यावदन्तं दिवो भूमेः कोष्ठानामधरं भुवः॥ २४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50020061, "chapter_id": 11653, "verse_number": "29", "content_sanskrit": "अजानन्तः प्रतिविधिं तूष्णीमासन् सुरेश्वराः। ततो वैकुण्ठमगमद् भास्वरं तमसः परम्॥ १०/९२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50020062, "chapter_id": 11653, "verse_number": "30", "content_sanskrit": "यत्र नारायणः साक्षान्न्यासिनां परमा गतिः। शान्तानां न्यस्तदण्डानां यतो नावर्तते गतः॥ १०/९२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50020063, "chapter_id": 11653, "verse_number": "31", "content_sanskrit": "तं तथाव्यसनं दृष्ट्वा भगवान् व्रजिनार्दनः। दूरात् प्रत्युदितो भूप दारको योगमायया॥ १०/९२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50020064, "chapter_id": 11653, "verse_number": "32", "content_sanskrit": "मेखलाजिनदण्डाद्यैस्तेजसाऽग्निरिव ज्वलन्। अभिवादयामास च तं कुशपाणिर्विनीतवत्॥ १०/९२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50020065, "chapter_id": 11653, "verse_number": "33", "content_sanskrit": "श्रीभगवानुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50020066, "chapter_id": 11653, "verse_number": "34", "content_sanskrit": "शाकुनेय भवान् व्यक्तं श्रान्तः किं दूरमागतः। क्षणं विश्रम्यतां पुंस आत्माऽयं सर्वकामधुक्॥ १०/९२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50020067, "chapter_id": 11653, "verse_number": "35", "content_sanskrit": "यदि नः श्रवणायालं युष्मद्व्यवसितं विभो। भण्यतां पुरुषः साधो पुम्भिरर्थितमीहते॥ १०/९२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50020068, "chapter_id": 11653, "verse_number": "36", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50020069, "chapter_id": 11653, "verse_number": "37", "content_sanskrit": "एवं भगवता पृष्टो वचसाऽमृतवर्षिणा। गतक्ल्मोऽब्रवीत् तस्मै यथापूर्वमनुष्ठितम्॥ १०/९२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50020070, "chapter_id": 11653, "verse_number": "38", "content_sanskrit": "श्रीभगवानुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50020071, "chapter_id": 11653, "verse_number": "39", "content_sanskrit": "एवं चेत् तर्हि तद्वाक्यं वयं न श्रद्दधीमहि। यो दक्षशापात् पैशाच्यं प्राप्तः प्रेतपिशाचराट्॥ १०/९२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50020072, "chapter_id": 11653, "verse_number": "40", "content_sanskrit": "यदि वस्तत्र विस्रम्भो दानवेन्द्र जगद्गुरौ। तर्ह्यङ्गापि स्वशिरसि हस्तन्यासः प्रदीयताम्॥ १०/९२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50020073, "chapter_id": 11653, "verse_number": "41", "content_sanskrit": "यद्यसत्यं वचः शम्भोः कथञ्चिद् दानवर्षभ। तदैनं जह्यसद्वाचं न च वक्ताऽनृतं पुनः१॥ ३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50020074, "chapter_id": 11653, "verse_number": "42", "content_sanskrit": "इत्थं भगवतश्चित्रैर्वचोभिश्च सुपेशलैः। भिन्नधीर्विस्मृतः शीर्ष्णि स्वहस्तं कुमतिर्व्यधात्॥ १०/९२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50020075, "chapter_id": 11653, "verse_number": "43", "content_sanskrit": "अथापतद् भिन्नशिरा वज्राहत इव क्षणात्। जयशब्दो नमःशब्दः साधुशब्दोऽभवद् दिवि॥ १०/९२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50020076, "chapter_id": 11653, "verse_number": "44", "content_sanskrit": "मुमुचुः पुष्पवर्षाणि हते पापे वृकासुरे। देवर्षिपितृगन्धर्वा मोचितः सङ्कटाच्छिवः॥ १०/९२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50020077, "chapter_id": 11653, "verse_number": "45", "content_sanskrit": "मुक्तं गिरिशमप्याह भगवान् पुरुषोत्तमः। अहो देव महादेव पापोऽयं स्वेन पाप्मना॥ १०/९२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50020078, "chapter_id": 11653, "verse_number": "46", "content_sanskrit": "हतः कोनु कुतश्चापि जन्तुर्वै कृतकिल्बिषः। क्षेमी स्यात् किमु विश्वेशे कृतपापो जगद्गुरौ॥ १०/९२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50020079, "chapter_id": 11653, "verse_number": "47", "content_sanskrit": "य एवमव्याकृतशक्त्युदन्वतः परस्य साक्षात् परमात्मनो हरेः। गिरीशमोक्षं कथयेत् शृणोति वा विमुच्यते संसृतिभिस्तथाऽरिभिः॥ १०/९२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50020080, "chapter_id": 11653, "verse_number": "48", "content_sanskrit": "इति श्रीमद्भागवते दशमस्कन्धे द्विनवतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]