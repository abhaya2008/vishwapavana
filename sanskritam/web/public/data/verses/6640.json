[
  {
    "id": 20006579,
    "chapter_id": 6640,
    "verse_number": "10.1",
    "content_sanskrit": "सञ्जितानि सुरभीण्यथ यूनामुल्लसन्नयनवारिरुहाणि । आयुषः शुघटितानि सुरायाः पात्रतां प्रियतमावदनानि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20006580,
    "chapter_id": 6640,
    "verse_number": "10.2",
    "content_sanskrit": "सोपचारमुपशान्तविचारं सानुतर्षमनुतर्षपदेन । ते मुहूर्तमथ मूर्तमपीप्यन्प्रम मानमवधूय वधूः स्वाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20006581,
    "chapter_id": 6640,
    "verse_number": "10.3",
    "content_sanskrit": "कान्ताकान्तवदनप्रतिबिम्बे भग्नबालसहकारसुगन्धौ । स्वादुनि प्रणदितालिनि शीते निर्विवार मधुनीन्द्रियवर्गः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20006582,
    "chapter_id": 6640,
    "verse_number": "10.4",
    "content_sanskrit": "कापिशायनसुगन्धि विघूर्णन्नुन्मदोऽधिशयितुं समशेत । फुल्लदृष्टि वदनं प्रमदानामब्जचारु चषकं च षडङ्ध्रिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20006583,
    "chapter_id": 6640,
    "verse_number": "10.5",
    "content_sanskrit": "बिम्बितं बृतपरिस्रुति जानन्भाजने जलजमित्यबलायाः । घ्रातुमक्षि पतति भ्रमरः स्म भ्रान्तिभाजि भवति क्व विवेकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20006584,
    "chapter_id": 6640,
    "verse_number": "10.6",
    "content_sanskrit": "दत्तमिष्टतमया मधु पत्युर्बाडमाप पिबतो रसवत्ताम् । यत्सुवर्णमुकुटांशुभिरासाच्चेतनाविरहितैरपि पतिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20006585,
    "chapter_id": 6640,
    "verse_number": "10.7",
    "content_sanskrit": "स्वदनेन सुतनोरविचारादोष्ठतः समचरिष्ट रसोऽत्र । अन्यमन्यदिव यन्मनधु यूनः स्वादमिष्टमतनिष्ट तदेव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20006586,
    "chapter_id": 6640,
    "verse_number": "10.8",
    "content_sanskrit": "बिभ्रतौ मधुरतामतिमात्रं रागिभिर्युगपदेव पपाते । आननैर्मधुरसो विकसदभिर्नासिकाभिरसितोत्पलगन्धः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20006587,
    "chapter_id": 6640,
    "verse_number": "10.9",
    "content_sanskrit": "पतिवत्यभिमते मधुतुल्यस्वादमोष्ठकं विददङ्क्षौ । लभ्यते स्म परिरक्ततयात्मा यावकेन वियतापि युवत्याः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20006588,
    "chapter_id": 6640,
    "verse_number": "10.10",
    "content_sanskrit": "कस्यचित्समदनं मदनीयप्रयसीवदनपानपरस्य । स्वादितः सकृदिवासव एव प्रत्युत क्षणविदंशपदेऽभूत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20006589,
    "chapter_id": 6640,
    "verse_number": "10.11",
    "content_sanskrit": "पीतशीतधुमधुरैर्मिधुनानामाननैः परिहृतं चषकान्तः । व्रीडया रुददिवालिविरावैर्नीलनीरजमगच्छदधस्तात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20006590,
    "chapter_id": 6640,
    "verse_number": "10.12",
    "content_sanskrit": "प्रातिभत्रिसरकेण गतानां वक्रवाक्यरचनारमणीयः । गूढसूचितरहस्यसहासः सुभ्रुवां प्रववृते परिहासः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20006591,
    "chapter_id": 6640,
    "verse_number": "10.13",
    "content_sanskrit": "हावकारि हसितं वचनानां खौशलं दृशि विकारविशेषाः । चकिरे भृशमृजोरपि वध्वाः कामिनेव तरुणेन मदेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20006592,
    "chapter_id": 6640,
    "verse_number": "10.14",
    "content_sanskrit": "अप्रसन्नमपराद्धरि पत्यौ कोपदीप्तमुररीकृतधैर्यम् । क्षालितं नु शमितं नु वधूनां द्रवितं नु हृदयं मधुवारैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20006593,
    "chapter_id": 6640,
    "verse_number": "10.15",
    "content_sanskrit": "सन्तमेव चिरप्रकृतत्वादप्रकाशितमद्द्युतङ्गे । विभ्रमं मधुमदः प्रमदानां धातुलीनमुपसर्ग इवार्थम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20006594,
    "chapter_id": 6640,
    "verse_number": "10.16",
    "content_sanskrit": "सावशेषपदमुक्तमुपेक्षा स्रस्तमाल्यवसनाभरणेषु । गन्तुमुत्थिमकारणतः स्म द्योतयन्ति मदविभ्रममासाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20006595,
    "chapter_id": 6640,
    "verse_number": "10.17",
    "content_sanskrit": "मद्यमन्दविगलत्त्रपमीषच्चक्षुरुन्मिषितपक्ष्म दधत्या । वीक्ष्यते स्म शनकैर्नववध्वा कामिनोमुखमधोमुखयैव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20006596,
    "chapter_id": 6640,
    "verse_number": "10.18",
    "content_sanskrit": "या कथञअचन सखीवचनेन प्रागभिप्रियतमं प्रजगल्भे । व्रीडाजाड्यमभजन्मधुपा सा स्वां मदात्प्रकृतिमेति हि सर्वः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20006597,
    "chapter_id": 6640,
    "verse_number": "10.19",
    "content_sanskrit": "छादितः कथमपि त्रपययान्तर्यः प्रियं प्रति चिराय रमण्याः । वारुणीमदविशङअगमथाविश्चक्षुषोऽभवदसाविव रागाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20006598,
    "chapter_id": 6640,
    "verse_number": "10.20",
    "content_sanskrit": "आगतानगणितप्रतियातान्वल्लभानभिसिसारयिषूणाम् । प्रापि चेतसि सविप्रतिसारे सुभ्रुवामवसरः सरकेण ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20006599,
    "chapter_id": 6640,
    "verse_number": "10.21",
    "content_sanskrit": "मा पुनस्तमभिसीसरमागस्कारिणं मदविमोहितचित्ता । योषिदित्यभिलाष न हालां दुस्त्यजः खलु सुखादपि मानः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20006600,
    "chapter_id": 6640,
    "verse_number": "10.22",
    "content_sanskrit": "ह्रीविमोहमहरद्दयितानामन्तिकं रतिसुखाय निनाय । सप्रसादमिव सेवितमासीत्सद्य एव फलदं मधु तासाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20006601,
    "chapter_id": 6640,
    "verse_number": "10.23",
    "content_sanskrit": "दत्तमात्तमदनं दयितेन व्याप्तमतिशाकेन रसेन । सस्वदे मुखसुरं प्रमदाभ्यो नाम रूढमपि च व्युदपादि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20006602,
    "chapter_id": 6640,
    "verse_number": "10.24",
    "content_sanskrit": "लब्धसौरभगुणो मदिराणामङ्गनास्यचषकस्य च गन्धः । मोदितालिरितरेतरयोगादन्यतामभजतातिशयं नु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20006603,
    "chapter_id": 6640,
    "verse_number": "10.25",
    "content_sanskrit": "मानभङ्गपचटुना सुरतेच्छां तन्वता प्रथयता दृशि रागम् । लेभिरे सपदि भावयतान्तर्योषितः प्रणयिनेव मदेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20006604,
    "chapter_id": 6640,
    "verse_number": "10.26",
    "content_sanskrit": "पानधौतनवयावकरागं सुभ्रुवो निभृतचुम्बनदक्षाः । प्रेयसामधररागरसेन स्वं किलाधरमुपालि ररञ्जुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20006605,
    "chapter_id": 6640,
    "verse_number": "10.27",
    "content_sanskrit": "अर्पितं रसितवत्यपि नामग्राहमन्ययुवतेर्दयितेन । उज्झति स्म मदमप्यपिबन्ती वीक्ष्य मद्यमितरा तु ममाद ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20006606,
    "chapter_id": 6640,
    "verse_number": "10.28",
    "content_sanskrit": "अन्यान्यवनितागतचित्तं चित्तनाथमभिशङ्कितवत्या । पीतभूरिसुरयापि नमेदे निर्वृतिर्हिमनसो मदहेतुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20006607,
    "chapter_id": 6640,
    "verse_number": "10.29",
    "content_sanskrit": "कोपवत्यनुनयानगृहीत्वा प्रागथो मधुमदाहितमोहा । कोपितं विरहखेदितचित्ता कान्तमेव कलयन्त्यनुनिन्ये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20006608,
    "chapter_id": 6640,
    "verse_number": "10.30",
    "content_sanskrit": "कुर्वता मुकुलिताक्षियुगानामङ्गसादमवसादितवगचाम् । ईर्ष्ययेव हरता ह्रियमासां तद्गुणः स्वयमकारि मदेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20006609,
    "chapter_id": 6640,
    "verse_number": "10.31",
    "content_sanskrit": "गण्डभित्तिषु पुरा सदृशीषु व्याञ्जि नाञ्जितदृशां प्रतिमेन्दुः । पानपाटलितकान्तिषु पश्चाल्लोध्रचूर्णतिलकाकृतिरासीत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20006610,
    "chapter_id": 6640,
    "verse_number": "10.32",
    "content_sanskrit": "उद्धतैरिव परस्परसङ्गादीरितान्युभयतः कुचकुम्भैः । योषितामतिमदेन जुघूर्णुर्विभ्रमातिशयपुंसि वपूंषि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20006611,
    "chapter_id": 6640,
    "verse_number": "10.33",
    "content_sanskrit": "चारुता वपुरभूषयदासां तामनूननवयौवनयोगः । तं पुनर्मकरकेतनलक्षक्ष्मीस्तां मदो दयितसंगमभूषः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20006612,
    "chapter_id": 6640,
    "verse_number": "10.34",
    "content_sanskrit": "क्षीबतामनुगतास्वनुवेलं तासु रोषपरितोषवतीषु । अग्रहीन्न सशरं धनुरुज्झामास नूज्झितनिषङ्गमनङ्गः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20006613,
    "chapter_id": 6640,
    "verse_number": "10.35",
    "content_sanskrit": "शहङ्गयान्ययुवतौ वनिताभिः प्रत्यभेदि दयितः स्फुटमेव । न क्षमं भवति तत्वविचारे मत्सरेण हतसंवृति चेतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20006614,
    "chapter_id": 6640,
    "verse_number": "10.36",
    "content_sanskrit": "आननैर्विचकसे हृषिताभिर्वल्लभानभि तनूभिरभावि । आर्द्रतां हृदयमाप च रोषो लोलति स्म वचनेषु वधूनाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20006615,
    "chapter_id": 6640,
    "verse_number": "10.37",
    "content_sanskrit": "रूपमप्रतिविधानमनोज्ञं प्रेम कार्यमनपेक्ष्य विकासि । चाटु चाकृतकसंभ्रममासां कार्मणत्वमगमन्रमणेषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20006616,
    "chapter_id": 6640,
    "verse_number": "10.38",
    "content_sanskrit": "लीलयैव सुतनोस्तुलयित्वा गौरवाढ्यमपि लावणिकेन । मानवञ्जनविदा वदनेन क्रीतमेव हृदयं दयितस्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20006617,
    "chapter_id": 6640,
    "verse_number": "10.39",
    "content_sanskrit": "स्पर्शभाजि विशदच्छविचारौ कल्पिते मृगदृशां सुरताय । सन्नतिं दधति पेतुरजस्रं दृष्टयः प्रियतमे शयने च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20006618,
    "chapter_id": 6640,
    "verse_number": "10.40",
    "content_sanskrit": "यूनि रागतरलैरपि तिर्यक्पातिभिः श्रुतिगुणेन युतस्य । दीर्घदर्शिभिरकारि वधूनां लङ्घनं न नयनैः श्रवणस्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20006619,
    "chapter_id": 6640,
    "verse_number": "10.41",
    "content_sanskrit": "संकथेच्छुरभिधातुमनीशा संमुखी न च बभूव दिदृक्षुः । स्पर्शनेन दयितस्य नतभ्रूरङ्गचपलापि चकम्पे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20006620,
    "chapter_id": 6640,
    "verse_number": "10.42",
    "content_sanskrit": "उत्तरीयविनयात्त्रपमाणा रुन्धती किल तदीक्षणमार्गम् । आचरिष्ट विकटेन विवोढुर्वक्षसैव कुचमणडलमन्या ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20006621,
    "chapter_id": 6640,
    "verse_number": "10.43",
    "content_sanskrit": "अंशुकं हृतवता तनुबाहुस्वस्तिकापिहितमुग्धकुचाग्रा । भिन्नशङ्खवलयं परिणेत्रा पर्यरम्भि रभसादचिरोढा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20006622,
    "chapter_id": 6640,
    "verse_number": "10.44",
    "content_sanskrit": "संजहार सहसा परिरब्धप्रेयसीषु विरहय्य विरोधम् । संहितं रतिपतिः स्मितभिन्नक्रोधमाशु तरुणेषु महेषुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20006623,
    "chapter_id": 6640,
    "verse_number": "10.45",
    "content_sanskrit": "स्रंसमानमुपयन्तरि वध्वाः श्लिष्टवत्युपसपक्षि रसेन । आत्मनैव रुरुधे कृतिनेव स्वसङ्गि वसनं जघनेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20006624,
    "chapter_id": 6640,
    "verse_number": "10.46",
    "content_sanskrit": "पीडिते पुर उरः प्रतिषेधं भर्तरि स्तनयुगेन युवत्याः । स्पष्टमेव दलतः प्रतिनार्यस्तन्मयत्वमभवद्धृदयस्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20006625,
    "chapter_id": 6640,
    "verse_number": "10.47",
    "content_sanskrit": "दीपितस्मरमुरस्यपपीडं वल्लभे घनमभिष्वजमाने । वक्रतां न ययतुः कुचकुम्भौ सुभ्रुवः कठिनतातिशयेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20006626,
    "chapter_id": 6640,
    "verse_number": "10.48",
    "content_sanskrit": "संप्रवेष्टुमिव योषित ईषुः श्लिष्यतां हृदयमिष्टतमानाम् । आत्मनः सततमेव तदन्तर्वर्तिनो न खलु नूनमजानन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20006627,
    "chapter_id": 6640,
    "verse_number": "10.49",
    "content_sanskrit": "स्नहनिर्भरमदत्त वधूनामार्द्रतां वपुरसंशयमन्तः । यूनि गाढपरिरम्भिणि वस्त्रक्नोपमम्बु ववृषे यदनेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20006628,
    "chapter_id": 6640,
    "verse_number": "10.50",
    "content_sanskrit": "न स्म माति वपुषः प्रमदानामन्तरिष्टतमसङ्गमजन्मा । तद्बहुर्बहिरवाप्य विकासं व्यानशे तनुरुहाण्यपि हर्षः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20006629,
    "chapter_id": 6640,
    "verse_number": "10.51",
    "content_sanskrit": "यत्प्रियव्यतिकराद्वनितानमङ्गजेन पुलकेन बभूवे । प्रापि तेन भृशमुच्छ्वसिभिर्नीविभिः सपदि बन्धनमोक्षः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20006630,
    "chapter_id": 6640,
    "verse_number": "10.52",
    "content_sanskrit": "ह्रीभरादवनतं परिरम्भे रागवानवटुजेष्ववकृष्य । अर्पितोष्ठदलमाननपद्मं योषितो मुकुलिताक्षमधासीत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20006631,
    "chapter_id": 6640,
    "verse_number": "10.53",
    "content_sanskrit": "पल्वोपमितसाम्यसपक्षं दष्टत्यधरबिम्बमभीष्टे । पर्यकूजि सरुजेव तरुण्यास्तारलोलवलयेन करेण ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20006632,
    "chapter_id": 6640,
    "verse_number": "10.54",
    "content_sanskrit": "केनचितन्मधुरमुल्बणरागं बाष्पतप्तमधिकं विरहेषु । ओष्ठपल्लवमवाप्य मुहूर्त सुभ्रुवः सरसमक्षि चुचुम्बे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20006633,
    "chapter_id": 6640,
    "verse_number": "10.55",
    "content_sanskrit": "रेचितं परिजनेन महीयः केवलाभिरतदम्पति धाम । साम्यमाप कमलासखविष्वक्सेनसेवितयुगान्तपयोधेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20006634,
    "chapter_id": 6640,
    "verse_number": "10.56",
    "content_sanskrit": "आवृतान्यपि निरन्तरमुच्चैर्योषितामुरसिजद्वतयेन । रागिणामित इतो विमृशद्भिः पाणिभिर्जगृहिरे हृदयानि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20006635,
    "chapter_id": 6640,
    "verse_number": "10.57",
    "content_sanskrit": "कामिनामसकलानि विभुग्नैः स्वदवारिमृदुभिः करजाग्रैः । आक्रियन्त कठिनेषु कथञ्चित्कामिनीकुचतटेषु पदानि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20006636,
    "chapter_id": 6640,
    "verse_number": "10.58",
    "content_sanskrit": "सोष्मणः स्तनशिलाशिखराग्रादात्तघर्मसलिलैस्तरुणानाम् । उच्छ्वसत्कमलचारुषु हस्तैनिम्ननाभिसरसीषु निपेते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20006637,
    "chapter_id": 6640,
    "verse_number": "10.59",
    "content_sanskrit": "आमृशद्भिरभितो वलिवीचिर्लोलमानवितताङ्गुलिहस्तैः । सुभ्रुवामनुभवात्प्रतिपेदे मुष्टिमेयमिति मघ्यमभीष्टैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20006638,
    "chapter_id": 6640,
    "verse_number": "10.60",
    "content_sanskrit": "प्राप्य नाभिनदमज्जनमाशु प्रस्थितं निवसनग्रहणाय । औपनीविकमरुन्ध किल स्त्री वल्लभस्य करमात्मकराभ्याम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20006639,
    "chapter_id": 6640,
    "verse_number": "10.61",
    "content_sanskrit": "कामिनः कृतरतोत्सवकालक्षेपमाकुलवधूकरसङ्गि । मेखलागुणविलग्नमसूयां दीर्घसूत्रमकरोत्परिधानम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20006640,
    "chapter_id": 6640,
    "verse_number": "10.62",
    "content_sanskrit": "अम्बरं विनयतः प्रियपाणेर्योषितस्य करयोः कलहस्य । वारणमिव विधातुमभीक्ष्णं कक्ष्यया च वलयैश्च शिशिञ्चे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20006641,
    "chapter_id": 6640,
    "verse_number": "10.63",
    "content_sanskrit": "ग्रन्थिमुद्ग्रथयितुं हृदयदेशे वाससः स्पृशति मानधनायाः । भ्रूयुगेण सपदि प्रतिपेदे रोमभिश्च सममेव विभेदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20006642,
    "chapter_id": 6640,
    "verse_number": "10.64",
    "content_sanskrit": "आशु लङ्घितवतीष्टकराग्रे नीवीमर्धमुकुलीकृतदृष्ट्या । रक्तवैणिक हताधरतन्त्रीमण्डलक्वणितचारु चुकूजे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20006643,
    "chapter_id": 6640,
    "verse_number": "10.65",
    "content_sanskrit": "आयताङ्गुलिरभूदतिरिक्तः सुभ्रुवां क्रशिमशालिनि मध्ये । श्रोणिषु प्रियकरः पृथुलासु स्पर्शमाप सकलेन तलेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20006644,
    "chapter_id": 6640,
    "verse_number": "10.66",
    "content_sanskrit": "चक्रुरेव ललनोरुषु राजीः स्पर्शलोभवशलोलकराणाम् । कामिनामनिभृतान्यपि रम्भास्त म्भकोमलतलेषु नखानि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20006645,
    "chapter_id": 6640,
    "verse_number": "10.67",
    "content_sanskrit": "ऊरुमूलचपलेक्षणमघ्नन्यैर्वतंसकुसुमैः प्रियमेताः । चक्रिरे सपदि तानि यथार्थ मन्मथस्य कुसुमायुधनाम ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20006646,
    "chapter_id": 6640,
    "verse_number": "10.68",
    "content_sanskrit": "धैर्यमुल्बणमनोभवभवा वामतां च वपुरर्पितवत्यः । व्रीडितं ललित सौरतधार्ष्ट्यअस्तेनिरेऽभिरुचितेषु तरुण्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20006647,
    "chapter_id": 6640,
    "verse_number": "10.69",
    "content_sanskrit": "पाणिरोधमविरोधवाञ्छं भर्त्सनाश्च मधुरस्मितगर्भाः । कामिनः स्म कुरुते करभोरुर्हअरि शुष्करुदितं च सुखऽपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20006648,
    "chapter_id": 6640,
    "verse_number": "10.70",
    "content_sanskrit": "वारणार्थपदगद्गदवाचामीर्ष्यया मुहुरपत्रपया च । कुर्वते स्म सुदृशामनुकूलं प्रतिकूलिकतयैव युवानः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20006649,
    "chapter_id": 6640,
    "verse_number": "10.71",
    "content_sanskrit": "अन्यकालपरिहार्यमजस्रं तद्द्वयेन विदधे द्वयमेव । धृष्टता रहसि भर्तृषु ताभिर्निर्दयत्वमितरैरबलासु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20006650,
    "chapter_id": 6640,
    "verse_number": "10.72",
    "content_sanskrit": "बाहुपीडनकचग३हणाभ्यामाहतेन नखदन्तनिपातैः । बोधितस्तनुशयतरुणीनामुन्मिमील विशदं विषमेषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20006651,
    "chapter_id": 6640,
    "verse_number": "10.73",
    "content_sanskrit": "कान्तया सपदि कोऽप्युपगूढः प्रौढपाणिरपनेतुमियेष । संहतस्तनतिरस्कृतदृष्टिर्भ्रष्टमेव न दुकूलमपश्यत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20006652,
    "chapter_id": 6640,
    "verse_number": "10.74",
    "content_sanskrit": "आहतं कुचतटेन तरुण्याः साधु सोढममुनेति पपात । त्रुट्यतः प्रियतमोरसि हारात्पुष्पवृष्चटरिव मौक्तिकवृष्टिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20006653,
    "chapter_id": 6640,
    "verse_number": "10.75",
    "content_sanskrit": "सीत्कृतानि मणितं करुणोक्तिः स्निग्धमुक्तमलमर्थवचांसि । हासभूषणरवाश्च रमण्याः कामसूत्रपदतामुपजग्मुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20006654,
    "chapter_id": 6640,
    "verse_number": "10.76",
    "content_sanskrit": "उद्धतैर्निभृतमेकमनेकैश्छदवन्मृगदृशामविरामैः । श्रूयते स्म मणितं कलकाञ्चीनूपुरध्वनिभिरक्षतमेव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20006655,
    "chapter_id": 6640,
    "verse_number": "10.77",
    "content_sanskrit": "ईदृशस्य भवतः खतमेतल्लाघवं मुहुरतीव रतेषु । क्षिप्तमायतमदर्शयदुर्व्या काञ्चिदाम जघनस्य महत्वम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20006656,
    "chapter_id": 6640,
    "verse_number": "10.78",
    "content_sanskrit": "प्रप्यते स्म गतचित्रकचित्रैश्चत्रमार्द्रनखलक्ष्मकपोलैः । दध्रिरेऽथ रभसच्युतपुष्पाः स्वबिन्दुकुसुमान्यलकान्ताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20006657,
    "chapter_id": 6640,
    "verse_number": "10.79",
    "content_sanskrit": "यद्यदेव रुरुचे रुचिरेभ्यः सुभ्रुवो रहसि त्तदकुर्वन् । आनुकूलिकतया हि नराणामाक्षिपन्ति हृदयानि तरुण्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20006658,
    "chapter_id": 6640,
    "verse_number": "10.80",
    "content_sanskrit": "प्राप्य मन्मथरसादतिभूमिं दुर्वहस्तनभराः सुरतस्य । शश्रमुः श्रमजलार्द्रललाटश्लिष्टकेशमसितायतकेश्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20006659,
    "chapter_id": 6640,
    "verse_number": "10.81",
    "content_sanskrit": "संगताभिरुचितैश्चलितापि प्रागमुच्यत चिरेण सखीव । भूय एव समगंस्त रतान्ते ह्रीवधूभिरसहा विरहस्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20006660,
    "chapter_id": 6640,
    "verse_number": "10.82",
    "content_sanskrit": "प्रेक्षणीयकमेव क्षणमासन्ह्रीविभङ्गुरविलोचनपाताः । संभ्रमद्रुतगृहीतदुकूलच्छाद्यमानवपुषः सुरतान्ताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20006661,
    "chapter_id": 6640,
    "verse_number": "10.83",
    "content_sanskrit": "अप्रभूतमतनीयसि तन्वी काञ्चिधाम्निपिहितैकतरोरु । क्षौममाकुलकरा विचकर्ष कान्तापल्लवमभीष्टतमेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20006662,
    "chapter_id": 6640,
    "verse_number": "10.84",
    "content_sanskrit": "मृष्टचन्दनविशेषकभक्तिर्म्रषअटभूषणकदर्थितमाल्यः । सापराध इव मण्डनमासीदात्मनैव सुदृशामुपभोगः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20006663,
    "chapter_id": 6640,
    "verse_number": "10.85",
    "content_sanskrit": "योषितः पतितकाञ्चनकाञ्चौ मोहनातिरभसेन नितम्बे । मेखलेव परितः स्म विचित्रा राजते वननखक्षतलक्ष्मीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20006664,
    "chapter_id": 6640,
    "verse_number": "10.86",
    "content_sanskrit": "भातु नाम सुदृशां दशनाङ्कः पाटलो धवलगणडतलेषु । दन्तवाससि समानगुणश्रीः संमुखोऽपि परभागमवाप ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20006665,
    "chapter_id": 6640,
    "verse_number": "10.87",
    "content_sanskrit": "सुभ्रुवामधिपयोधरपीठं पीडनैस्त्रुटितवत्यपि पत्युः । णुक्तमौक्तिकलघुगुणशेषा हारयष्चिरभवत्गुरुरेव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20006666,
    "chapter_id": 6640,
    "verse_number": "10.88",
    "content_sanskrit": "विश्रमार्थमुपगूढमजस्रं यत्प्रियैः प्रथमरत्यवसाने । योषितामुदितमन्मथमादौ तद्द्वितीयसुरतस्य बभूव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20006667,
    "chapter_id": 6640,
    "verse_number": "10.89",
    "content_sanskrit": "आस्तृतेऽभिनवपल्लवपुष्पैरप्यनारतरताभिरताभ्यः । दीयते स्म शयितुं शयनीये न क्षणः क्षणदयापि वधूभ्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20006668,
    "chapter_id": 6640,
    "verse_number": "10.90",
    "content_sanskrit": "योषितामतितरां नखलूनं गात्रमुज्जवलतया न खलूनम् । क्षोभमाशु हृदयं नयदूनां रागवृद्धिमकरोन्न यदूनाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20006669,
    "chapter_id": 6640,
    "verse_number": "10.91",
    "content_sanskrit": "इति मदमदनाभ्यां रागिणः स्पष्टरागननवरतरतश्रीसङ्गिनस्तानवेक्ष्य । अभजत परिवृत्तिं साथ पर्यस्तहस्ता रजनिरवनतेन्दुर्लज्जयाधोमुखीव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  }
]