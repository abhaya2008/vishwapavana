[{"id": 2055699, "chapter_id": 2217, "verse_number": "७-१४४-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2055700, "chapter_id": 2217, "verse_number": "७-१४४-१", "content_sanskrit": "अजितो द्रोणराधेयविकर्णकृतवर्मभिः।\n`यश्चैवोत्सहते वेतुं समस्तं मामकं बलम।\nतीर्णः सैन्यार्णवं वीरः प्रतिश्रुत्य युधिष्ठिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2055701, "chapter_id": 2217, "verse_number": "७-१४४-२", "content_sanskrit": "स कथं कौरवेयेण समरेष्वनिवारितः।\nनिगृह्य भूरिश्रवसा बलाद्भुवि निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2055702, "chapter_id": 2217, "verse_number": "७-१४४-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2055703, "chapter_id": 2217, "verse_number": "७-१४४-३", "content_sanskrit": "शृणु राजन्निहोत्पत्तिं शैनेयस्य यथा पुरा।\nयथा च भूरिश्रवसो यत्र ते संशयो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2055704, "chapter_id": 2217, "verse_number": "७-१४४-४", "content_sanskrit": "`ब्रह्मणस्त्वभवत्पुत्रो मानसोऽत्रिर्महातपाः।\nअत्रेः पुत्रोऽभवत्सोमः सोमस्य तु बुधः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2055705, "chapter_id": 2217, "verse_number": "७-१४४-५", "content_sanskrit": "बुधस्यैलो महाबाहुः पुत्र आसीत्पुरूरवाः।\nपुरूरवस आयुस्तु आयुषो नहुषः सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2055706, "chapter_id": 2217, "verse_number": "७-१४४-६", "content_sanskrit": "नहुषस्य ययातिस्तु राजा देवर्षिसम्मतः।\nययातेर्देवयान्यां तु यदुर्ज्येष्ठोऽभवत्सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2055707, "chapter_id": 2217, "verse_number": "७-१४४-७", "content_sanskrit": "यदोरभूदन्ववाये आजमीढ इति स्मृतः।\nयादवस्तस्य तु सुतः शूरस्त्रैलोक्यसम्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2055708, "chapter_id": 2217, "verse_number": "७-१४४-८", "content_sanskrit": "शूरस्य शौरिर्नृवरो वसुदेवो महायशाः।\nधनुष्यनवरः शूरः कार्तवीर्यसमो युधि।\nधनुष्यनवरः शूरः कार्तवीर्यसमो युधि।\nतद्वार्यश्चापि तत्रैव कुले शिनिरभून्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2055709, "chapter_id": 2217, "verse_number": "७-१४४-९", "content_sanskrit": "एतस्मिन्नेव काले तु देवकस्य महात्मनः।\nदुहितः स्वयंवरे राजन्सर्वक्षत्रसमागमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2055710, "chapter_id": 2217, "verse_number": "७-१४४-१०", "content_sanskrit": "तत्र वै देवकीं देवीं वसुदेवार्थमाशु वै।\nनिर्जित्व पार्थिवान्सर्वान्रथमारोपयच्छिनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2055711, "chapter_id": 2217, "verse_number": "७-१४४-११", "content_sanskrit": "तां दृष्ट्वा देवकीं शूरो रथस्थां पुरुषर्षभः।\nनामृष्यत महातेजाः सोमदत्तः शिनेर्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2055712, "chapter_id": 2217, "verse_number": "७-१४४-१२", "content_sanskrit": "तयोर्युद्धमभूद्राजन्दिनार्धं चित्रमुद्भतम्।\nबाहुयुद्धं सुबलिनोः प्रसक्तं पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2055713, "chapter_id": 2217, "verse_number": "७-१४४-१३", "content_sanskrit": "शिनिना सोमदत्तस्तु प्रसह्य भुवि पातितः।\nअसिमुद्यम्य केशेषु प्रगृह्य च पदा हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2055714, "chapter_id": 2217, "verse_number": "७-१४४-१४", "content_sanskrit": "मध्ये राजसहस्राणां प्रेक्षकाणां समन्ततः।\nकृपया च पुनस्तेन स जीवेति विसर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2055715, "chapter_id": 2217, "verse_number": "७-१४४-१५", "content_sanskrit": "तदवस्थः कृतस्तेन सोमदत्तोऽथ मारिष।\nप्रासादयन्महादेवममर्षवशमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2055716, "chapter_id": 2217, "verse_number": "७-१४४-१६", "content_sanskrit": "तस्य तुष्टो महादेवो वराणां वरदः प्रभुः।\nवरेण च्छन्दयामास स तु वव्रे वरं नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2055717, "chapter_id": 2217, "verse_number": "७-१४४-१७", "content_sanskrit": "पुत्रमिच्छामि भगवन्यो निपात्य शिनेः सुतम्।\nमध्ये राजसहस्राणां पदा हन्याच्च संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2055718, "chapter_id": 2217, "verse_number": "७-१४४-१८", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सोमदत्तस्य पार्थिव।\nएवमस्त्विति तत्रोक्त्वा स देवोऽन्तरधीयत।\nस तेन वरदानेन लब्धवान्भूरिदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2055719, "chapter_id": 2217, "verse_number": "७-१४४-१९", "content_sanskrit": "अपातयच्च समरे सौमदत्तिः शिनेः सुतम्।\nपश्यतां सर्वसैन्यानां पदा चैनमताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2055720, "chapter_id": 2217, "verse_number": "७-१४४-२०", "content_sanskrit": "एतत्ते कथितं राजन्यन्मां त्वं परिपृच्छसि।\nन हि शक्यो रणे जेतुं सात्वतो मनुजर्षभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2055721, "chapter_id": 2217, "verse_number": "७-१४४-२१", "content_sanskrit": "लब्धलक्ष्याश्च सङ्ग्रामे बहुशश्चित्रयोधिनः।\nदेवदानवगन्धर्वान्विजेतारो ह्यविस्मिताः।\nस्ववीर्यविजये युक्ता नैते परपरिग्रहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2055722, "chapter_id": 2217, "verse_number": "७-१४४-२२", "content_sanskrit": "न तुल्यं वृष्णिभिरिह दृश्यते किञ्चन प्रभो।\nभूतं भव्यं भविष्यच्च बलेन भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2055723, "chapter_id": 2217, "verse_number": "७-१४४-२३", "content_sanskrit": "न ज्ञातिमवमन्यन्ते वृद्धानां शासने रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2055724, "chapter_id": 2217, "verse_number": "७-१४४-२४", "content_sanskrit": "न देवासुरगन्धर्वा न यक्षोरगराक्षसाः।\nजेतारो वृष्णिवीराणां किं पुनर्मानवा रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2055725, "chapter_id": 2217, "verse_number": "७-१४४-२५", "content_sanskrit": "ब्रह्मद्रव्ये गुरुद्रव्ये ज्ञातिस्वे चाप्यहिंसकाः।\nएतेषां रक्षितारश्च ये स्युः कस्याञ्चिदापदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2055726, "chapter_id": 2217, "verse_number": "७-१४४-२६", "content_sanskrit": "अर्थवन्तो न चोत्सिक्ता ब्रह्मण्याः सत्यवादिनः।\nसमर्थान्नावमन्यन्ते दीनानभ्युद्वरन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2055727, "chapter_id": 2217, "verse_number": "७-१४४-२७", "content_sanskrit": "नित्यं देवपरा दान्तास्त्रातारश्चाविकत्थनाः।\nतेन वृष्णिप्रवीराणां चक्रं न प्रतिहन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2055728, "chapter_id": 2217, "verse_number": "७-१४४-२८", "content_sanskrit": "अपि मेरुं वहेत्कश्चित्तरेद्वा मकरालयम्।\nन तु वृष्णिप्रवीराणां समेत्यान्तं व्रजेन्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2055729, "chapter_id": 2217, "verse_number": "७-१४४-२९", "content_sanskrit": "एतत्ते सर्वमाख्यातं यत्र ते संशयः प्रभो।\nकुरुराज नरश्रेष्ठ तव व्यपनयो महान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2055730, "chapter_id": 2217, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे चतुश्चत्वारिंशदधिकशततमोऽध्यायः॥ १४४ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१४४-२१ परपग्रहाः रिपराधीनाः॥ २१ ॥ ५-१४४-२७ चक्रं प्रतापः॥ ५-१४४-१४४ चतुश्चत्वारिंशदधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]