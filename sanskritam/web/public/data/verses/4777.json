[{"id": 2178586, "chapter_id": 4777, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178587, "chapter_id": 4777, "verse_number": "१", "content_sanskrit": "एष वैकर्तनः शेते महेष्वासो महारथः ।\n(ज्वलितानलवत् सङ्खे संशान्तः पार्थतेजसा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178588, "chapter_id": 4777, "verse_number": "२", "content_sanskrit": "पश्य वैकर्तनं कर्णं निपात्यातिरथान् बहून् ।\nशोणितौघपरीताङ्गं शयानं पतितं भुवि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178589, "chapter_id": 4777, "verse_number": "३", "content_sanskrit": "अमर्षी दीर्घरोषश्च महेष्वासो महारथः ।\nरणे विनिहतः शेते शूरो गाण्डीवधन्वना\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178590, "chapter_id": 4777, "verse_number": "४", "content_sanskrit": "यं स्म पाण्डवसन्त्रासान्मम पुत्रा महारथाः ।)\nप्रायुद्ध्यन्त पुरस्कृत्य मातङ्गमिव यूथपम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178591, "chapter_id": 4777, "verse_number": "५", "content_sanskrit": "शार्दूलमिव सिंहेन समरे सव्यसाचिना ।\nमातङ्गमिव मत्तेन मातङ्गेन निपातितम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178592, "chapter_id": 4777, "verse_number": "६", "content_sanskrit": "त एताः पुरुषव्याघ्र निहतं शूरमाहवे ।\nप्रकीर्णमूर्धजास्तस्य स्त्रियस्तं पर्युपासते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178593, "chapter_id": 4777, "verse_number": "७", "content_sanskrit": "उद्विग्नः सततं यस्माद् धर्मराजो युधिष्ठिरः ।\nत्रयोदश समा निद्रां चिन्तयन् नाधिगच्छति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178594, "chapter_id": 4777, "verse_number": "८", "content_sanskrit": "अनाधृष्यः परैर्युद्धे शत्रुभिर्मघवानिव ।\nयुगान्ताग्निरिवार्चिष्मान् हिमवानिव सुस्थिरः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178595, "chapter_id": 4777, "verse_number": "९", "content_sanskrit": "स भूत्वा शरणं पूर्वं धार्तराष्ट्रस्य माधव ।\nभूमौ विनिहतः शेते वातरुग्ण इव द्रुमः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178596, "chapter_id": 4777, "verse_number": "१०", "content_sanskrit": "पश्य कर्णस्य पत्नीं त्वं वृषसेनस्य मातरम् ।\nलालप्यमानां करुणं रुदन्तीं पतितां भुवि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178597, "chapter_id": 4777, "verse_number": "११", "content_sanskrit": "आचार्यशापोऽनुगतो ध्रुवं त्वां\nयदग्रसच्चक्रमिदं धरा ते ।\nततः शरेणाभिहतं शिरस्ते\nधनञ्जयेनाहवचक्रमध्ये\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178598, "chapter_id": 4777, "verse_number": "१२", "content_sanskrit": "अहो धिगेषा पतिता विसञ्ज्ञा\nसमीक्ष्य जाम्बूनदबद्धनिष्कम् ।\nकर्णं महाबाहुरदीनसत्त्वं\nसुषेणमाता रुदती भृशार्ता\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178599, "chapter_id": 4777, "verse_number": "१३", "content_sanskrit": "कलावशेषो हि कृतो महात्मा\nशरीरभक्षैः परिभक्षयद्भिः ।\nद्रष्टुं न सम्प्रीतिकरः शशीव ।\nकृष्णस्य पक्षस्य चतुर्दशाहे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178600, "chapter_id": 4777, "verse_number": "१४", "content_sanskrit": "विवर्तमाना पतिता पृथिव्याम्\nउत्थाय दीना पुनरेव चैषा ।\nकर्णस्य वक्त्रं परिजिघ्रमाणा\nरोरूयते पुत्रवधाभितप्ता\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178601, "chapter_id": 4777, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां स्त्रीपर्वणि एकविंशोऽध्यायः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178602, "chapter_id": 4777, "verse_number": "", "content_sanskrit": "स्त्रीपर्वणि षष्ठोऽध्यायः ॥६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]