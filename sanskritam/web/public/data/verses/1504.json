[{"id": 2023541, "chapter_id": 1504, "verse_number": "३-१४२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023542, "chapter_id": 1504, "verse_number": "३-१४२-१", "content_sanskrit": "अन्तर्हितानि भूतानि रक्षांसि बलवन्ति च।\nअग्निना तपसा चैव शक्यं गन्तुं वृकोदर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023543, "chapter_id": 1504, "verse_number": "३-१४२-२", "content_sanskrit": "सन्निवर्तय कौन्तेय क्षुत्पिपासे बलाश्रयात्।\nततो बलं च दाक्ष्यं च संश्रयस्व वृकोदर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023544, "chapter_id": 1504, "verse_number": "३-१४२-३", "content_sanskrit": "ऋषेस्त्वया श्रुतं वाक्यं कैलासं पर्वतं प्रति।\nबुद्ध्या प्रपश्य कौन्तेय कथं कृष्णा गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023545, "chapter_id": 1504, "verse_number": "३-१४२-४", "content_sanskrit": "अथवा सहदेवेन धौम्येन च समं विभो।\nसूतैः पौरोगवैश्चैव सर्वैश्च परिचारकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023546, "chapter_id": 1504, "verse_number": "३-१४२-५", "content_sanskrit": "रथैरश्वैश्च ये चान्ये विप्राः क्लेशासहाः पथि।\nसर्वैस्त्वं सहितो भीम निवर्तस्वायतेक्षण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023547, "chapter_id": 1504, "verse_number": "३-१४२-६", "content_sanskrit": "त्रयो वयं गमिष्यामो लध्वाहारा यतव्रताः।\nअहं च नकुलश्चैव लोमशश्च महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023548, "chapter_id": 1504, "verse_number": "३-१४२-७", "content_sanskrit": "ममागमनमाकाङ्क्षन्ग्गाद्वारे समाहितः।\nवसेह द्रौपदीं रक्षन्यावदागमनं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023549, "chapter_id": 1504, "verse_number": "३-१४२-८x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023550, "chapter_id": 1504, "verse_number": "३-१४२-८", "content_sanskrit": "राजपुत्री श्रमेणार्ता दुःखार्ता चैव भारत।\nव्रजत्येव हि कल्याणी श्वेतवाहदिदृक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023551, "chapter_id": 1504, "verse_number": "३-१४२-९", "content_sanskrit": "तवचाप्यरतिस्तीव्रा वर्तते तमपश्यतः।\nगुडाकेशं महात्मानं संग्रामेष्वपलायिनम्।\nकिं पुनः सहदेवं च मां च कृष्णां च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023552, "chapter_id": 1504, "verse_number": "३-१४२-१०", "content_sanskrit": "द्विजाः कामं निवर्तन्तां सर्वे च परिचारकाः।\nसूताः पौरोगवाश्चैव यं च मन्येत नो भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023553, "chapter_id": 1504, "verse_number": "३-१४२-११", "content_sanskrit": "न ह्यहं हातुमिच्छामि भवन्तमिह कर्हिचित्।\nशैलेऽस्मिन्राक्षसाकीर्णे दुर्गेषु विपमेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023554, "chapter_id": 1504, "verse_number": "३-१४२-१२", "content_sanskrit": "इयं चापि महाभागा राजपुत्री पतिव्रता।\nत्वामृते पुरुषव्याघ्र नोत्सहेद्विनिवर्तितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023555, "chapter_id": 1504, "verse_number": "३-१४२-१३", "content_sanskrit": "तथैवसहदेवोऽयं सततं त्वामनुव्रतः।\nन जातु विनिवर्तेत मतज्ञो ह्यहमस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023556, "chapter_id": 1504, "verse_number": "३-१४२-१४", "content_sanskrit": "अपिचात्र महाराज सव्यसाचिदिदृक्षया।\nसर्वे लालसभूताः स्म तस्माद्यास्यामहे सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023557, "chapter_id": 1504, "verse_number": "३-१४२-१५", "content_sanskrit": "यद्यशक्यो रथैर्गन्तुं शैलोऽयं बहुकन्दरः।\nपद्भिरेव गमिष्यामो मा राजन्विमना भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023558, "chapter_id": 1504, "verse_number": "३-१४२-१६", "content_sanskrit": "अहं वहिष्ये पाञ्चालीं यत्रयत्र न शक्ष्यति।\nइति मे वर्तते बुद्धिर्मा राजन्विमना भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023559, "chapter_id": 1504, "verse_number": "३-१४२-१७", "content_sanskrit": "सुकुमारौ तथा वीरौ माद्रीनन्दिकरावुभौ।\nदुर्गे संतारयिष्यामि यत्राशक्तौ भविष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023560, "chapter_id": 1504, "verse_number": "३-१४२-१८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023561, "chapter_id": 1504, "verse_number": "३-१४२-१८", "content_sanskrit": "एवं ते भाषमाणस्य बलं भीमाभिवर्धताम्।\nयत्त्वमुत्सहसे वोढुं पाञ्चालीं विपुलेऽध्वनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023562, "chapter_id": 1504, "verse_number": "३-१४२-१९", "content_sanskrit": "यमजौ चापि भद्रं ते नैतदन्यत्र विद्यते।\nबलं तव यशश्चैवधर्मः कीर्तिश्च वर्धताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023563, "chapter_id": 1504, "verse_number": "३-१४२-२०", "content_sanskrit": "यत्त्वमुत्सहसे नेतुं भ्रातरौ सह कृष्णया।\nमा ते ग्लानिर्महाबाहो मा च तेऽस्तु पराभवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023564, "chapter_id": 1504, "verse_number": "३-१४२-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023565, "chapter_id": 1504, "verse_number": "३-१४२-२१", "content_sanskrit": "ततः कृष्णाऽब्रवीद्वाक्यं प्रहसन्ती मनोरमा।\nगमिष्यामि न संताप कार्यो मां प्रति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023566, "chapter_id": 1504, "verse_number": "३-१४२-२२x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2023567, "chapter_id": 1504, "verse_number": "३-१४२-२२", "content_sanskrit": "तपसा शक्यते गन्तुं पर्वतो गन्धमादनः।\nतपसा चैव कौन्तेय सर्वे योक्ष्यामहे वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2023568, "chapter_id": 1504, "verse_number": "३-१४२-२३", "content_sanskrit": "नकुलः सहदेवश्च भीमसेनश् पार्थिव।\nअहं च त्वं च कौन्तेय द्रक्ष्यामः श्वेतवाहनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2023569, "chapter_id": 1504, "verse_number": "३-१४२-२४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2023570, "chapter_id": 1504, "verse_number": "३-१४२-२४", "content_sanskrit": "एवं संभाषमाणास्ते सुबाहुविषयं महत्।\nददृशुर्मुदिता राजन्प्रभूतगजवाजिमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2023571, "chapter_id": 1504, "verse_number": "३-१४२-२५", "content_sanskrit": "किराततङ्गणाकीर्णं पुलिन्दशतसंकुलम्।\nहिमवत्यमरैर्जुष्टं बह्वाश्चर्यसमाकुलम्।\nसुबाहुश्चापि तान्दृष्ट्वा पूजयाप्रत्यगृह्णत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2023572, "chapter_id": 1504, "verse_number": "३-१४२-२६", "content_sanskrit": "विषयान्ते कुलिन्दानामीश्वरः प्रीतिपूर्वकम्।\nतत्र ते पूजितास्तेन सर्व एव सुखोपिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2023573, "chapter_id": 1504, "verse_number": "३-१४२-२७", "content_sanskrit": "प्रतस्थुर्विमले सूर्ये हिमवन्तं गिरिं प्रति।\nइन्द्रसेनमुखांश्चापि भृत्यान्पौरोगवांस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2023574, "chapter_id": 1504, "verse_number": "३-१४२-२८", "content_sanskrit": "सूदांश्च पारिबर्हांश्च द्रौपद्याः सर्वशो नृप।\nराज्ञः कुलिन्दाधिपतेः परिदाय महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2023575, "chapter_id": 1504, "verse_number": "३-१४२-२९", "content_sanskrit": "पद्भिरेव महावीर्या ययुः कौरवनन्दनाः।\nते शनैः प्राद्रवन्सर्वे कृष्णया सह पाण्डवाः।\nतस्माद्देशात्सुसंहृष्टा द्रष्टुकामा धनंजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2023576, "chapter_id": 1504, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि द्विचत्वारिंशदधिकशततमोऽध्यायः ॥ १४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]