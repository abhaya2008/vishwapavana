[{"id": 7005004000, "chapter_id": 25004, "verse_number": "७-१-१८७-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि सर्वकामफलप्रदम् ।\nप्रभासपंचकं पुण्यमाद्यं तत्र व्यवस्थितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005004001, "chapter_id": 25004, "verse_number": "७-१-१८७-२", "content_sanskrit": "तस्यैव पश्चिमे भागे प्रभास इति चोच्यते ।\nवृद्धप्रभासश्च ततो दक्षिणे नातिदूरतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005004002, "chapter_id": 25004, "verse_number": "७-१-१८७-३", "content_sanskrit": "जल प्रभासश्च ततो दक्षिणेन वरानने ।\nकृतस्मरप्रभासश्च श्मशानं यत्र भैरवम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005004003, "chapter_id": 25004, "verse_number": "७-१-१८७-४", "content_sanskrit": "एवं पंचप्रभासान्यः पश्येद्भक्तया समन्वितः ।\nस याति परमं स्थानं जरामरणवर्जितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005004004, "chapter_id": 25004, "verse_number": "७-१-१८७-५", "content_sanskrit": "न निवर्तति यत्प्राप्य दुष्प्राप्यं त्रिदशैरपि ।\nप्रभासं प्रथमं तीर्थं त्रिषु लोकेषु विश्रुतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005004005, "chapter_id": 25004, "verse_number": "७-१-१८७-६", "content_sanskrit": "देवानामपि दुष्प्राप्यं महापातकनाशनम् ।\nप्रभासे त्वेकरात्रेण अमावास्यां कृतोदकः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005004006, "chapter_id": 25004, "verse_number": "७-१-१८७-७", "content_sanskrit": "मुच्यते पातकैः सर्वैः शिवलोकं स गच्छति ।\nसप्तजन्मकृतं पापं गंगासागरसंगमे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005004007, "chapter_id": 25004, "verse_number": "७-१-१८७-८", "content_sanskrit": "जन्मनां च सहस्रेण यत्पापं कुरुते नरः ।\nस्नानादेवास्य नश्येत सागरे लवणांभसि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005004008, "chapter_id": 25004, "verse_number": "७-१-१८७-९", "content_sanskrit": "चतुर्दश्याममावास्यां पञ्चदश्यां विशेषतः ।\nअहोरात्रोषितो भूत्वा ब्राह्मणान्भोज्य शक्तितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005004009, "chapter_id": 25004, "verse_number": "७-१-१८७-१०", "content_sanskrit": "दत्त्वा गां कांचनं तेभ्यः शिवः प्रीतो भवत्विति ।\nएवं कृत्वा नरो देवि कुलानां तारयेच्छतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005004010, "chapter_id": 25004, "verse_number": "७-१-१८७-११", "content_sanskrit": "देव्युवाच ।\nप्रभासपंचकं ह्येतद्यत्त्वया परिकीर्तितम् ।\nकथमत्र समुद्भूतमेतन्मे कौतुकं महत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005004011, "chapter_id": 25004, "verse_number": "७-१-१८७-१२", "content_sanskrit": "एक एव श्रुतोऽस्माभिः प्रभासस्तीर्थवासितः ।\nप्रभासाः पंच देवेश यत्त्वया परिकीर्तिताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005004012, "chapter_id": 25004, "verse_number": "७-१-१८७-१३", "content_sanskrit": "एतन्मे संशयं सर्वं यथावद्वक्तुमर्हसि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005004013, "chapter_id": 25004, "verse_number": "७-१-१८७-१४", "content_sanskrit": "ईश्वर उवाच ।\nशृणु देवि प्रवक्ष्यामि कथां पापप्रणाशनीम् ।\nयां श्रुत्वा मानवो भक्त्या प्राप्नोति परमां गतिम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005004014, "chapter_id": 25004, "verse_number": "७-१-१८७-१५", "content_sanskrit": "पुरा महेश्वरो देवश्चचार वसुधामिमाम् ।\nदिव्यरूपधरः कान्तो दिग्वासाः स यदृच्छया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005004015, "chapter_id": 25004, "verse_number": "७-१-१८७-१६", "content_sanskrit": "एवं च रममाणस्तु ऋषीणामाश्रमं महत् ।\nजगाम कौतुकाविष्टो भिक्षार्थं दारुके वने ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005004016, "chapter_id": 25004, "verse_number": "७-१-१८७-१७", "content_sanskrit": "भ्रममाणस्य तस्याथ दृष्ट्वा रूपमनुत्तमम् ।\nता नार्यः कामसंतप्ता बभूवुर्व्यथितेन्द्रियाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005004017, "chapter_id": 25004, "verse_number": "७-१-१८७-१८", "content_sanskrit": "सानुरागास्ततः सर्वा अनुगच्छंति तं सदा ।\nसमालिंगंति ताः काश्चित्काश्च वीक्षंति रागतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005004018, "chapter_id": 25004, "verse_number": "७-१-१८७-१९", "content_sanskrit": "प्रार्थयंति तथा चान्याः परित्यज्य गृहान्स्वकान् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005004019, "chapter_id": 25004, "verse_number": "७-१-१८७-२०", "content_sanskrit": "एवं तासां स्वरूपं ते दृष्ट्वा सर्वे महर्षयः ।\nकोपेन महता युक्ताः शेपुस्तं वृषभध्वजम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005004020, "chapter_id": 25004, "verse_number": "७-१-१८७-२१", "content_sanskrit": "यस्मात्त्वं नग्नतामेत्य आश्रमेऽस्मिन्ममागतः ।\nमोहयानः स्त्रियोऽस्माकं लज्जां नैवं करोषि च ।\nतस्मात्ते पतताल्लिंगं सद्य एव वृषध्वज ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005004021, "chapter_id": 25004, "verse_number": "७-१-१८७-२२", "content_sanskrit": "ततस्तत्पतितं लिंगं तत्क्षणाच्छंकरस्य च ।\nतस्मिन्प्रपतिते भूमौ प्राकंपत वसुंधरा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005004022, "chapter_id": 25004, "verse_number": "७-१-१८७-२३", "content_sanskrit": "क्षुभिताः सागराः सर्वे मर्यादा विजहुस्तदा ।\nशीर्णानि गिरिशृंगाणि त्रस्ताः सर्वे दिवौकसः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005004023, "chapter_id": 25004, "verse_number": "७-१-१८७-२४", "content_sanskrit": "ततो देवाः सगन्धर्वाः समहोरगकिन्नराः ।\nऊचुः पितामहं गत्वा किमेतत्कारणं विभो ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005004024, "chapter_id": 25004, "verse_number": "७-१-१८७-२५", "content_sanskrit": "सागराः क्षुभिता येन प्लावयंति वसुंधराम् ।\nशीर्यंते गिरिशृङ्गाणि कंपते च वसुंधरा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005004025, "chapter_id": 25004, "verse_number": "७-१-१८७-२६", "content_sanskrit": "चिह्नानि लोकनाशाय दृश्यन्ते दारुणानि च ।\nतेषां तद्वचन श्रुत्वा ब्रह्मलोके पितामहः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005004026, "chapter_id": 25004, "verse_number": "७-१-१८७-२७", "content_sanskrit": "ध्यात्वा तु सुचिरं कालं वाक्यमेतदुवाच ह ।\nशिवलिंगं निपतितं पृथिव्यां सुरसत्तमाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005004027, "chapter_id": 25004, "verse_number": "७-१-१८७-२८", "content_sanskrit": "शापेन ऋषिमुख्यानां भार्गवाणां महात्मनाम् ।\nतस्मिन्निपतिते भूमौ त्रैलोक्यं सचराचरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005004028, "chapter_id": 25004, "verse_number": "७-१-१८७-२९", "content_sanskrit": "एतदवस्थतां प्राप्तं तस्मात्तत्रैव गम्यताम् ।\nविष्णुना सह गीर्वाणास्तथा नीतिर्विधीयताम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005004029, "chapter_id": 25004, "verse_number": "७-१-१८७-३०", "content_sanskrit": "ततः क्षीरोदधिं जग्मुर्ब्रह्माद्यास्त्रिदिवौकसः ।\nयत्र शेते चतुर्बाहुर्योगनिद्रां च संगतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005004030, "chapter_id": 25004, "verse_number": "७-१-१८७-३१", "content_sanskrit": "तस्मै सर्वं समाचख्युस्तेनैव सहितास्ततः ।\nजग्मुर्यत्र महादेवो लिंगेन रहितो विभुः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005004031, "chapter_id": 25004, "verse_number": "७-१-१८७-३२", "content_sanskrit": "ऊचुः समाहिताः सर्वे प्रणिपत्य दिवौकसः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005004032, "chapter_id": 25004, "verse_number": "७-१-१८७-३३", "content_sanskrit": "लिंगमुत्क्षिप्यतामेतद्यत्क्षितौ पतितं विभो ।\nएते महार्णवाः सर्वे प्लावयंति वसुंधराम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005004033, "chapter_id": 25004, "verse_number": "७-१-१८७-३४", "content_sanskrit": "भगवानुवाच ।\nऋषिभिः पातितं ह्येतन्मम लिंगं सुरेश्वराः ।\nन तु शक्यो मया कर्तुं बाधस्तेषां महात्मनाम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005004034, "chapter_id": 25004, "verse_number": "७-१-१८७-३५", "content_sanskrit": "शापो हि भार्गवेन्द्राणामतो मे श्रूयतां वचः ।\nपूजयध्वं सुराः सर्वे ब्रह्मविष्णुपुरस्सराः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005004035, "chapter_id": 25004, "verse_number": "७-१-१८७-३६", "content_sanskrit": "लिंगमेतत्ततः सर्वे सर्वं लिप्सथ सत्तमाः ।\nप्रकृतिं सागराः सर्वे यास्यंति गिरयस्तथा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005004036, "chapter_id": 25004, "verse_number": "७-१-१८७-३७", "content_sanskrit": "एतत्पुण्यतमे क्षेत्रे धृत्वा सर्वे समाहिताः ।\nअथोद्धृत्य सुराः सर्वे प्रभासं क्षेत्रमागताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005004037, "chapter_id": 25004, "verse_number": "७-१-१८७-३८", "content_sanskrit": "तत्रैव निदधुः सर्वे ततः पूजां प्रचक्रिरे ।\nब्रह्मणा पूजितं लिंगं विष्णुना प्रभविष्णुना ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005004038, "chapter_id": 25004, "verse_number": "७-१-१८७-३९", "content_sanskrit": "शक्रेणाथ कुबेरेण यमेन वरुणेन च ।\nऊचुश्चैव ततो देवा लिंगं संपूज्य भक्तितः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005004039, "chapter_id": 25004, "verse_number": "७-१-१८७-४०", "content_sanskrit": "अद्यप्रभृति रुद्रस्य लिंगं संपूज्य भक्तितः ।\nभविष्यामो न संदेहस्तथा पितृगणाश्च ये ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005004040, "chapter_id": 25004, "verse_number": "७-१-१८७-४१", "content_sanskrit": "य एनं पूजयिष्यंति भक्तियुक्ताश्च मानवाः ।\nयास्यंति ते सुरावासं सशरीरा नरोत्तमाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005004041, "chapter_id": 25004, "verse_number": "७-१-१८७-४२", "content_sanskrit": "अत्रैव प्रथमं लिगं यतोस्माऽभिः प्रतिष्ठितम् ।\nप्रभासं नाम चास्यापि प्रभासेति भविष्यति ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005004042, "chapter_id": 25004, "verse_number": "७-१-१८७-४३", "content_sanskrit": "एवमुक्त्वा गताः सर्वे त्रिदिवं सुरसत्तमाः ।\nतं दृष्ट्वा त्रिदिवं यान्ति भूयांसः प्राणिनो भुवि ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005004043, "chapter_id": 25004, "verse_number": "७-१-१८७-४४", "content_sanskrit": "ततस्त्रिविष्टपं व्याप्तं बहुभिः प्राणिभिः प्रिये ।\nतद्दृष्ट्वा त्रिदिवं व्याप्तं सहस्राक्षः सुदुःखितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005004044, "chapter_id": 25004, "verse_number": "७-१-१८७-४५", "content_sanskrit": "ज्ञात्वा लिंगप्रभावं तु ततश्चागत्य भूतलम् ।\nवज्रेणाच्छादयामास समंतात्स वरानने ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005004045, "chapter_id": 25004, "verse_number": "७-१-१८७-४६", "content_sanskrit": "ततः प्रभृति नो देवि स्वर्गं गच्छंति मानवाः ।\nइति संक्षेपतः प्रोक्तः प्रभासस्य महोदयः ।\nसर्वपापोपशमनः सर्वकामफलं प्रदः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005004046, "chapter_id": 25004, "verse_number": "७-१-१८७-४७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमेप्रभासक्षेत्रमाहात्म्ये प्रभासपञ्चकमाहात्म्यवर्णनंनाम सप्ताशीत्युत्तरशततमोऽध्यायः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]