[{"id": 7003334000, "chapter_id": 23334, "verse_number": "२-२९-१", "content_sanskrit": "सनत्कुमार उवाच  ।\nतुला ते कथिता ह्येषा आद्या सामान्यरूपिणी ।\nहिरण्यगर्भं वक्ष्यामि द्वितीयं सर्वसिद्धिदम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003334001, "chapter_id": 23334, "verse_number": "२-२९-२", "content_sanskrit": "अधः पात्रं सहस्रेण हिरण्येन विधीयते ।\nऊर्ध्वपात्रं तदर्धेन मुखं संवेशमात्रकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003334002, "chapter_id": 23334, "verse_number": "२-२९-३", "content_sanskrit": "हैममेवं शुभं कुर्यात्सर्वाकारसंयुतम् ।\nअधः पात्रे स्मरेद्देवीं गुणत्रयसमन्विताम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003334003, "chapter_id": 23334, "verse_number": "२-२९-४", "content_sanskrit": "चतुर्विशतिकां देवीं ब्रह्मविष्ण्वग्निरूपिणीम् ।\nऊर्ध्वपात्रे गुणातीतं षड्विशकमुमापतिम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003334004, "chapter_id": 23334, "verse_number": "२-२९-५", "content_sanskrit": "आत्मानं पुरुषं ध्यायेत्पंचविशकमग्रजम् ।\nपूर्वोक्तस्थानमध्येऽथ वेदिकोपरि मंडले ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003334005, "chapter_id": 23334, "verse_number": "२-२९-६", "content_sanskrit": "शालीमध्ये क्षिपेन्नीत्वा नववस्त्रैश्च वेष्टयेत् ।\nमाषकल्केन चालिष्य पंचद्रव्येण पूजयेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003334006, "chapter_id": 23334, "verse_number": "२-२९-७", "content_sanskrit": "ईशानाद्यैर्यथान्यायं पंचभिः परिपूजयेत् ।\nपूर्ववच्छिवपूजा च होमश्चैव यथक्रमम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003334007, "chapter_id": 23334, "verse_number": "२-२९-८", "content_sanskrit": "देवीं गायत्रिकां जप्त्वा प्रविशेत्प्राङ्मुखः स्वयम् ।\nविधिनैव तु संपाद्य गर्भाधानादिकां क्रियाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003334008, "chapter_id": 23334, "verse_number": "२-२९-९", "content_sanskrit": "कृत्वा षोडशमार्गेण विधिना ब्राह्मणोत्तमः ।\nदूर्वाकुरैस्तु कर्तव्या सेचना दक्षिणे पुटे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003334009, "chapter_id": 23334, "verse_number": "२-२९-१०", "content_sanskrit": "औदुंबरफलैः सार्धकविंशत्कुशोदकम् ।\nईशान्यां तावदेवात्र कुर्यात्सीमंतकर्मणि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003334010, "chapter_id": 23334, "verse_number": "२-२९-११", "content_sanskrit": "उद्वहेत्कन्यकां कृत्वा त्रिंशन्निष्केण शोभनाम् ।\nअलंकृत्य तथा हुत्वा शिवाय विनिवेदयेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003334011, "chapter_id": 23334, "verse_number": "२-२९-१२", "content_sanskrit": "अन्नप्राशनके विद्वान् भोजयेत्पायसादिभिः ।\nएवं विश्वजितांता वै गर्भाधानादिकाः क्रियाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003334012, "chapter_id": 23334, "verse_number": "२-२९-१३", "content_sanskrit": "शक्तिबीजेन कर्तव्या ब्राह्मणैर्वेदपारगैः ।\nशेषं सर्वं च विधिवत्तुलाहेमवदाचरेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]