[{"id": 50026061, "chapter_id": 12045, "verse_number": "1", "content_sanskrit": "मनुस्तस्यापरस्तारबीजोद्देशनमोयुतः । नमः सोद्देशभगवान् महाशब्दयुतश्च सः। तादृशः स्वाहया युक्तो वराहस्यापरो मनुः॥ ४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50026062, "chapter_id": 12045, "verse_number": "2", "content_sanskrit": "श्यामः सुदर्शनदराभयसद्वरेतो भूम्या युतोऽखिलनिजोक्तपरिग्रहैश्च। ध्येयो निजैश्च तनुभिः सकलैरुपेतः कोलो हरिः सकलवाञ्छितसिद्धयेऽजः॥ ५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50026063, "chapter_id": 12045, "verse_number": "3", "content_sanskrit": "वैष्णवानां मुनिर्ब्रह्मा मन्त्राणां वर्णभेदतः। ज्ञेयं छन्दो दैवतैकस्तत्तद्रूपो हरिः परः॥ ६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50026064, "chapter_id": 12045, "verse_number": "4", "content_sanskrit": "प्रणवेन स्वनाम्ना च भूधरेण परात्मना। सर्वज्ञसर्वशक्तिभ्यां षडङ्गानि विदो विदुः॥ ७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50026065, "chapter_id": 12045, "verse_number": "5", "content_sanskrit": "ज्ञानैश्वर्यप्रभानन्दतेजःशक्तिभिरेव वा। पूर्णात्ममध्यगैः सर्ववैष्णवाङ्गान्यथो विदुः॥ ८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]