[{"id": 2159150, "chapter_id": 4449, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2159151, "chapter_id": 4449, "verse_number": "१", "content_sanskrit": "अङ्गं च पौरवं वीरं मृतं सृञ्जय शुश्रुम ।\nयः सहस्रं सहस्राणां श्वेतानश्वानवासृजत्\nतस्याश्वमेधे राजर्षेः सर्वे देवाः समाययुः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2159152, "chapter_id": 4449, "verse_number": "२", "content_sanskrit": "शिक्षाक्षरविधिज्ञानां नासीत् सङ्ख्या विपश्चिताम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2159153, "chapter_id": 4449, "verse_number": "३", "content_sanskrit": "वेदविद्याव्रतस्नाता वदान्याः प्रियदर्शनाः ।\nसुभक्षाच्छादनगृहाः सुशय्यासनवाहनाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2159154, "chapter_id": 4449, "verse_number": "४", "content_sanskrit": "नटनर्तकगन्धर्वैः प्लवकैर्वर्धमानकैः ।\nनियोधकैश्च क्रीडन्तः तत्रोषुः परमार्चिताः ।\nयज्ञे यज्ञे यथाकालं दक्षिणाः सोऽत्यकालयत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2159155, "chapter_id": 4449, "verse_number": "५", "content_sanskrit": "द्विपान् दशसहस्राख्यान् अददात् काञ्चनावृतान् ।\nसध्वजान् सपताकांश्च सवरूथान् सुकल्पितान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2159156, "chapter_id": 4449, "verse_number": "६", "content_sanskrit": "सहस्रं च सहस्राणां कन्या हेमविभूषिताः ।\nचतुर्युजरथारूढाः सगृहक्षेत्रगोधनाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2159157, "chapter_id": 4449, "verse_number": "७", "content_sanskrit": "शतं शतसहस्राणि स्वर्णमालानथर्षभान् ।\nगवां सहस्रानुचरान् दक्षिणाः सोऽत्यकालयत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2159158, "chapter_id": 4449, "verse_number": "८", "content_sanskrit": "हेमशृङ्ग्यो रौप्यखुराः सवत्साः कांस्यदोहनाः ।\nदासीदासखरोष्ट्रं च प्रादाच्छागाविकं बहु\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2159159, "chapter_id": 4449, "verse_number": "९", "content_sanskrit": "रत्नानां विविधान् कूटान् विविधानन्नपर्वतान् ।\nतत् सर्वं वितते यज्ञे दक्षिणामत्यकालयत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2159160, "chapter_id": 4449, "verse_number": "१०", "content_sanskrit": "अत्रापि गाथा गायन्ति ते पुराणविदो जनाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2159161, "chapter_id": 4449, "verse_number": "११", "content_sanskrit": "अङ्गस्य यजमानस्य अपि विष्णुपदे वयम् ।\nअमाद्यदिन्द्रः सोमेन दक्षिणाभिर्द्विजातयः ।\nदेवमानुषगन्धर्वाः चात्यरोचन्त दक्षिणाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2159162, "chapter_id": 4449, "verse_number": "१२", "content_sanskrit": "अङ्गस्य यजमानस्य स्वधर्मानुगताः शुभाः ।\nगुणोत्तरास्ते क्रतवः तत्रासन् सर्वकामदाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2159163, "chapter_id": 4449, "verse_number": "१३", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2159164, "chapter_id": 4449, "verse_number": "१४", "content_sanskrit": "पुत्रात् पुण्यतमस्तुभ्यं मा पुत्रमनुतप्यथाः ।\nअयज्वानमदक्षिण्यमधिवैत्येत्युदाहरत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2159165, "chapter_id": 4449, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां द्रोणपर्वणि चतुःपञ्चाशत्तमोऽध्यायः ॥ ५४ ॥\nअभिमन्युवधपर्वणि त्रयोविंशोऽध्यायः ॥ १३ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]