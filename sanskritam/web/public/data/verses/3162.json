[{"id": 2100726, "chapter_id": 3162, "verse_number": "१४-१८-१", "content_sanskrit": "वासुदेव उवाच।\nततस्तस्योपसङ्गृह्य पादौ प्रश्नान्सुदुर्वचान्।\nपप्रच्छ तांश्च धर्मान्स प्राह धर्मभृतांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100727, "chapter_id": 3162, "verse_number": "१४-१८-२x", "content_sanskrit": "काश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100728, "chapter_id": 3162, "verse_number": "१४-१८-२", "content_sanskrit": "कथं शरीराच्च्यवते कथं चैवोपपद्यते।\nकथं कष्टाच्च संसारात्संसरन्परिमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100729, "chapter_id": 3162, "verse_number": "१४-१८-३", "content_sanskrit": "आत्मानं वा कथं युक्त्वा तच्छरीरं विमुञ्चति।\nशरीरे च विनिर्मुक्तो कथमन्यत्प्रपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100730, "chapter_id": 3162, "verse_number": "१४-१८-४", "content_sanskrit": "कथं शुभाशुभे चायं कर्मणी स्वकृते नरः।\nउपभुङ्क्ते क्व वा कर्म विदेहस्योपतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100731, "chapter_id": 3162, "verse_number": "१४-१८-५x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100732, "chapter_id": 3162, "verse_number": "१४-१८-५", "content_sanskrit": "एवं सञ्चोदितः सिद्धः प्रश्नांस्तान्प्रत्यभाषत।\nआनुपूर्व्येण वार्ष्णेय तन्मे निगदतः शृणुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100733, "chapter_id": 3162, "verse_number": "१४-१८-६x", "content_sanskrit": "सिद्ध उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100734, "chapter_id": 3162, "verse_number": "१४-१८-६", "content_sanskrit": "`अस्मिन्नेवाशु फलदा आयुष्यास्तु क्रियाःस्मृताः।\nआयुःकीर्तिकराणीह यानि कृत्यानि सेवते।\nशरीरग्रहणेऽन्यस्मिंस्तेषु क्षीणेषु सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100735, "chapter_id": 3162, "verse_number": "१४-१८-७", "content_sanskrit": "आयुःक्षयपरीतात्मा विपरीतानि सेवते।\nबुद्धिर्व्यावर्तते चास्य विनाशे प्रत्युपस्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100736, "chapter_id": 3162, "verse_number": "१४-१८-८", "content_sanskrit": "सत्त्वं बलं च कालं चाविदित्वा चात्मनस्तथा।\nअतिवेलमुपाश्नाति स्वविरुद्धान्यनात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100737, "chapter_id": 3162, "verse_number": "१४-१८-९", "content_sanskrit": "यदाऽयमतिकष्टानि सर्वाण्युपनिषेवते।\nअत्यर्थमपि वा भुङ्क्ते न वा भुङ्क्ते कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100738, "chapter_id": 3162, "verse_number": "१४-१८-१०", "content_sanskrit": "दुष्टान्नामिषपानं च यदन्योन्यविरोधि च।\nगुरु चाप्यमितं भुङ्क्ते नातिजीर्णे दिवा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100739, "chapter_id": 3162, "verse_number": "१४-१८-११", "content_sanskrit": "व्यायाममतिमात्रं च व्यावाय चोपसेवते।\nसततं कर्मलोभाद्वा प्राप्तं वेगं विधारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100740, "chapter_id": 3162, "verse_number": "१४-१८-१२", "content_sanskrit": "रसाभियुक्तमन्नं वा दिवास्वप्नं च सेवते।\nअपक्वानागते काले स्वयं दोषान्प्रकोपयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100741, "chapter_id": 3162, "verse_number": "१४-१८-१३", "content_sanskrit": "स्वदोषकोपनाद्रोगं लभते मरणान्तिकम्।\nअपि वोद्बन्धनादीनि परीतानि व्यवस्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100742, "chapter_id": 3162, "verse_number": "१४-१८-१४", "content_sanskrit": "तस्य तैः कारणैर्जन्तोः शरीरं च्यवते तदा।\nजीवितं प्रोच्यमानं तद्यथावदुपधारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100743, "chapter_id": 3162, "verse_number": "१४-१८-१५", "content_sanskrit": "ऊष्मा प्रकुपितः काये तीव्रवायुसमीरितः।\nशरीरमनुपर्येत्य सर्वान्प्राणान्रुणद्धि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100744, "chapter_id": 3162, "verse_number": "१४-१८-१६", "content_sanskrit": "अत्यर्थं बलवानूष्मा शरीरे परिकोपितः।\nभिनत्ति जीवस्थानानि तानि कर्मणि विद्धि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100745, "chapter_id": 3162, "verse_number": "१४-१८-१७", "content_sanskrit": "ततः सवेदनः सद्यो जीवः प्रच्यवते क्षरन्।\nशरीरं त्यजते जन्तुश्छिद्यमानेषु मर्मसु।\nवेदनाभिः परीतात्मा तद्विद्धि द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100746, "chapter_id": 3162, "verse_number": "१४-१८-१८", "content_sanskrit": "जनीमरणसंविग्राः सततं सर्वजन्तवः।\nदृश्यन्ते संत्यजन्तश्च शरीराणि द्विजर्षभ॥\nगर्भसंक्रमणे चापि गर्भाणापुपसर्पणे।\nतादृशीमेव लभते वेदनां मानवः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100747, "chapter_id": 3162, "verse_number": "१४-१८-२०", "content_sanskrit": "भिन्नसंधिरथ क्लेदमद्भिः स लभते नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100748, "chapter_id": 3162, "verse_number": "१४-१८-२१", "content_sanskrit": "यथा पञ्चसु भूतेषु सम्भूतत्वं नियच्छति।\nशैत्यात्प्रकुपितः काये तीव्रवायुसमीरितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100749, "chapter_id": 3162, "verse_number": "१४-१८-२२", "content_sanskrit": "यः स पञ्चसु भूतेषु प्राणापाने व्यवस्थितः।\nस गच्छत्यूर्ध्वगो वायुः कृच्छ्रान्मुक्त्वा शरीरिणः।\nशरीरं च जहात्येवं निरुच्छ्वासश्च दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100750, "chapter_id": 3162, "verse_number": "१४-१८-२३", "content_sanskrit": "स निरूष्मा निरुच्छ्वासो निःश्रीको गतचेतनः।\nकर्मणा सम्परित्यक्तो मृत इत्युच्यते नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100751, "chapter_id": 3162, "verse_number": "१४-१८-२४", "content_sanskrit": "स्रोतोभिर्यैर्विजानाति इन्द्रियार्थाञ्शरीरभृत्।\nतैरेव न विजानाति प्राणानाहारसम्भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100752, "chapter_id": 3162, "verse_number": "१४-१८-२५", "content_sanskrit": "तत्रैव कुरुते काये यः स जीवः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2100753, "chapter_id": 3162, "verse_number": "१४-१८-२६", "content_sanskrit": "तथा यद्यद्भवेन्मुक्तं सन्निपाते क्वचित्क्वचित्।\nतत्तन्मर्म विजानीहि शास्त्रदृष्टं हि तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2100754, "chapter_id": 3162, "verse_number": "१४-१८-२७", "content_sanskrit": "तेषु मर्मसु भिन्नेषु ततः स समुदीरयन्।\nआविश्य हृदयं जन्तोः सत्त्वं चाशु रुणद्धि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2100755, "chapter_id": 3162, "verse_number": "१४-१८-२८", "content_sanskrit": "ततः सचेतनो जन्तुर्नाभिजानाति किञ्चन।\nतमसा संवृतज्ञानः संवृतेष्वेव मर्मसु।\nस जीवो निरदिष्ठानश्चाल्यते मातरिश्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2100756, "chapter_id": 3162, "verse_number": "१४-१८-२९", "content_sanskrit": "ततः स तं महोच्छ्वासं भृशमुच्छ्वस्य दारुणम्।\nनिष्क्रमन्कम्पयत्याशु तच्छरीरमचेतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2100757, "chapter_id": 3162, "verse_number": "१४-१८-३०", "content_sanskrit": "स जीवः प्रच्युतः कायात्कर्मभिः स्वैः समावृतः।\nअङ्कितः स्वैः शुभैः पुण्यैः पापैर्वाऽप्युपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2100758, "chapter_id": 3162, "verse_number": "१४-१८-३१", "content_sanskrit": "ब्राह्मणा ज्ञानसम्पन्ना यथावच्छ्रुतनिश्चयाः।\nइतरं कृतपुण्यं वा तं विजानन्ति लक्षणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2100759, "chapter_id": 3162, "verse_number": "१४-१८-३२", "content_sanskrit": "यथान्धकारे खद्येतं दीप्यमानं ततस्ततः।\nचक्षुष्मन्तः प्रपश्यन्ति तथा च ज्ञानचक्षुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2100760, "chapter_id": 3162, "verse_number": "१४-१८-३३", "content_sanskrit": "पश्यन्त्येवंविधं सिद्धा जीवं दिव्येन चक्षुषा।\nच्यवन्तं जायमानं च योनिं चानुप्रवेशितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2100761, "chapter_id": 3162, "verse_number": "१४-१८-३४", "content_sanskrit": "तस्य स्थानानि दृष्टानि विविधानीह शास्त्रतः।\nकर्मभूमिरियं भूमिर्यत्र तिष्ठन्ति जन्तवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2100762, "chapter_id": 3162, "verse_number": "१४-१८-३५", "content_sanskrit": "ततः शुभाशुभं कृत्वा लभन्ते सर्वदेहिनः।\nइहैवोच्चावचान्भोगान्प्राप्नुवन्ति स्वकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2100763, "chapter_id": 3162, "verse_number": "१४-१८-३६", "content_sanskrit": "इहैवाशुभकर्माणः कर्मभिर्निरयं गताः।\nअवाग्गतिरियं कष्टा यत्र पच्यन्ति मानवाः।\nतस्मात्सुदुर्लभो मोक्षो रक्ष्यश्चात्मा ततो भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2100764, "chapter_id": 3162, "verse_number": "१४-१८-३७", "content_sanskrit": "ऊर्ध्वं तु जन्तवो गत्वा येषु स्थानेष्ववस्थिताः।\nकीर्त्यमानानि तानीह तत्त्वतः संनिबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2100765, "chapter_id": 3162, "verse_number": "१४-१८-३८", "content_sanskrit": "तच्छ्रुत्वा नैष्ठिकीं बुद्धिं बुद्ध्येथाः कर्मनिश्चयम्।\nतारारूपाणि सर्वाणि यत्रैतच्चन्द्रमण्डलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2100766, "chapter_id": 3162, "verse_number": "१४-१८-३९", "content_sanskrit": "यत्र विभ्राजते लोके स्वभासा सूर्यमण्डलम्।\nस्थानान्येतानि जानीहि जनानां पुण्यकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2100767, "chapter_id": 3162, "verse_number": "१४-१८-४०", "content_sanskrit": "कर्मक्षयाच्च ते सर्वे च्यवन्ते वै पुनः पुनः।\nतत्रापि च विशेषोस्ति दिवि नीचोच्चमध्यमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2100768, "chapter_id": 3162, "verse_number": "१४-१८-४१", "content_sanskrit": "न च तत्रापि संतोषो दृष्ट्वा दीप्ततरां श्रियम्।\nइत्येता गतयः सर्वाः पृथक्ते समुदीरिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2100769, "chapter_id": 3162, "verse_number": "१४-१८-४२", "content_sanskrit": "उपपत्तिं तु वक्ष्यामि गर्भस्याहमतः परम्।\nतथावत्तां निगदतः शृणुष्वावहितो द्विज॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2100770, "chapter_id": 3162, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि अष्टादशोऽध्यायः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]