[{"id": 2022927, "chapter_id": 1488, "verse_number": "३-१२६-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022928, "chapter_id": 1488, "verse_number": "३-१२६-१", "content_sanskrit": "तं दृष्ट्वा घोरवदनं मदं देवः शतक्रतुः।\nआयान्तं भक्षयिष्यन्तं व्यात्ताननमिवान्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022929, "chapter_id": 1488, "verse_number": "३-१२६-२", "content_sanskrit": "भयात्संस्तम्भितभुजः सृक्विणी लेलिहन्मुहुः।\nततोऽव्रवीद्देवराजश्च्यवनं भयपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022930, "chapter_id": 1488, "verse_number": "३-१२६-३", "content_sanskrit": "सोमार्हावश्विनावेतावद्य प्रभृति भार्गव।\nभविष्यतः सत्यमेतद्वचो विप्र प्रसीद मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022931, "chapter_id": 1488, "verse_number": "३-१२६-४", "content_sanskrit": "न ते मिथ्या समारम्भो भवत्वेष परो विधिः।\nजानामि चाहं विप्रर्षे न मिथ्या त्वं करिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022932, "chapter_id": 1488, "verse_number": "३-१२६-५", "content_sanskrit": "सोमपावश्विनावेतौ यथा वाद्य कृतौ त्वया।\n`तथैव मामपि ब्रह्मञ्श्रेयसा योक्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022933, "chapter_id": 1488, "verse_number": "३-१२६-६", "content_sanskrit": "भूय एव तु ते वीर्यं प्रकाशेदिति भार्गव।\nसुकन्यायाः पितुश्चास्य लोके कीर्तिः प्रथेदिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022934, "chapter_id": 1488, "verse_number": "३-१२६-७", "content_sanskrit": "अतो मयैतद्विहितं तव वीर्यप्रकाशनम्।\nतस्मान्प्रसादं कुरु मे भवत्वेवं यथेच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022935, "chapter_id": 1488, "verse_number": "३-१२६-८", "content_sanskrit": "एवमुक्तस्य शक्रेण च्यवनस्य महात्मनः।\nस मन्युर्व्यगमच्छीघ्रं सुमोच च पुरंदरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022936, "chapter_id": 1488, "verse_number": "३-१२६-९", "content_sanskrit": "मदं च व्यभजद्राजन्पाने स्त्रीषु च वीर्यवान्।\nअक्षेषु मृगयायां च पूर्वसृष्टं पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022937, "chapter_id": 1488, "verse_number": "३-१२६-१०", "content_sanskrit": "तदा मदं विनिक्षिप्य शक्रं संतर्प्य चेन्दुना।\nअश्विभ्यां सहितान्देवान्याजयित्वा च तं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022938, "chapter_id": 1488, "verse_number": "३-१२६-११", "content_sanskrit": "विख्याप्य वीर्यं लोकेषु सर्वेषु वदतांवरः।\nसुकन्यया सहारण्ये विजहारानुकूलया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022939, "chapter_id": 1488, "verse_number": "३-१२६-१२", "content_sanskrit": "तस्यैतद्द्विजसंघुष्टं सरो राजन्प्रकाशते।\nअत्रत्वं सह सोदर्यैः पितृडन्देवांश्च तर्पय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022940, "chapter_id": 1488, "verse_number": "३-१२६-१३", "content_sanskrit": "एतद्दृष्ट्वा महीपाल सिकताक्षं च भारत।\nसैन्धवारण्यमासाद्य कुल्यानां कुरु दर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022941, "chapter_id": 1488, "verse_number": "३-१२६-१४", "content_sanskrit": "पुष्करेषु महाराज सर्वेषु च जलं स्पृश।\nस्थाणोर्मन्त्राणि च जपन्सिद्धिं प्राप्स्यसि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022942, "chapter_id": 1488, "verse_number": "३-१२६-१५", "content_sanskrit": "संधिर्द्वयोर्नरश्रेष्ठ त्रेताया द्वापरस्य च।\nअयं हि दृश्यते पार्थ सर्वपापप्रणाशनः।\nअत्रोपस्पृश चैव त्वं सर्वपापप्रणाशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022943, "chapter_id": 1488, "verse_number": "३-१२६-१६", "content_sanskrit": "आर्चीकपर्वतश्चैव निवासौ वै मनीषिणाम्।\nसदाफलः सदास्रोतो मरुतां स्तानमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022944, "chapter_id": 1488, "verse_number": "३-१२६-१७", "content_sanskrit": "चैत्याश्चैते बहुविधास्त्रिदशानां युधिष्ठिर।\nएतच्चन्द्रमसस्तीर्थमृषयः पर्युपासते।\nवैखानसप्रभृतयो वालखिल्यास्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022945, "chapter_id": 1488, "verse_number": "३-१२६-१८", "content_sanskrit": "शृङ्गाणि त्रीणि पुण्यानि त्रीणि प्रसर्वणानि च।\nसर्वाण्यनुपरिक्रम्य यथाकाममुपस्पृश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022946, "chapter_id": 1488, "verse_number": "३-१२६-१९", "content_sanskrit": "शान्तनुश्चात्र राजेन्द्र शुनकश्च नराधिपः।\nनरनारायणौ चोभौ तपस्तप्त्वा चिरं नृप।\nस्थानं सनातनं प्राप्तावीश्वरध्यानतत्परौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022947, "chapter_id": 1488, "verse_number": "३-१२६-२०", "content_sanskrit": "इह नित्याश्रया देवाः पितरश्च महर्षिभिः।\nआर्चीकपर्वते तेपुस्तान्यजस्व युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022948, "chapter_id": 1488, "verse_number": "३-१२६-२१", "content_sanskrit": "इह ते वै चरून्प्राश्नन्नृषयश्च विशांपते।\nयमुना चाक्षयस्रोताः कृष्णश्चेह तपोरतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022949, "chapter_id": 1488, "verse_number": "३-१२६-२२", "content_sanskrit": "यमौ च भीमसेनश्च कृष्णा चामित्रकर्शन।\nसर्वे चात्र गमिष्यामस्त्वयैव सह पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022950, "chapter_id": 1488, "verse_number": "३-१२६-२३", "content_sanskrit": "एतत्प्रस्रवणं पुण्यमिन्द्रस्य मनुजेश्वर।\nयत्रधाता विधाता च वपरुणश्चोर्ध्वमागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022951, "chapter_id": 1488, "verse_number": "३-१२६-२४", "content_sanskrit": "इह तेऽप्यवसन्राजञ्शान्ताः परमधर्मिणः।\nमैत्राणामृजुबुद्धीनामयं गिरिवरः शुभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022952, "chapter_id": 1488, "verse_number": "३-१२६-२५", "content_sanskrit": "एषा सा यमुना राजन्महर्षिगणसेविता।\nनानायज्ञचिता राजन्पुण्या पापभयापहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022953, "chapter_id": 1488, "verse_number": "३-१२६-२६", "content_sanskrit": "अत्रराजा महेष्वासो मांधाताऽयजत स्वयम्।\nसाहदेविश्च कौन्तेय सोमको ददतांवरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022954, "chapter_id": 1488, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि षड्विंशत्यधिकशततमोऽध्यायः ॥ १२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]