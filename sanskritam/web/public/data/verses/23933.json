[{"id": 7003933000, "chapter_id": 23933, "verse_number": "२-९-२८-१", "content_sanskrit": "श्रीनारायण उवाच ।\nआचम्य प्राणानायम्य ततोसौ स्वस्थमानसः ।\nनमस्कृत्येष्टदेवादीन्देशकालौ च कीर्तयेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003933001, "chapter_id": 23933, "verse_number": "२-९-२८-२", "content_sanskrit": "एकान्तधर्मसिद्यर्थं वासुदेवस्य पूजनम् ।\nकरिष्य इति संकल्प्य कुर्यान्न्यासविधिं ततः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003933002, "chapter_id": 23933, "verse_number": "२-९-२८-३", "content_sanskrit": "न्यासे मन्त्रा द्वादशार्णो गायत्री वैष्णवी तथा ।\nनारायणाष्टाक्षरश्च ज्ञेया विष्णुषडक्षरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003933003, "chapter_id": 23933, "verse_number": "२-९-२८-४", "content_sanskrit": "एते द्विजानां विहितास्तदन्येषां त्विह त्रयः ।\nवासुदेवाष्टाक्षरश्च हरिपञ्चाक्षरस्तथा ।\nषडर्णः केशवस्येति न्यासे होमे च संमताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003933004, "chapter_id": 23933, "verse_number": "२-९-२८-५", "content_sanskrit": "श्रीविष्णुप्रतिमांगेषु स्वांगेष्विव ततोऽखिलान् ।\nकुर्यान्यासांश्च तैर्मन्त्रैस्ततोर्चां वाससाऽमृजेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003933005, "chapter_id": 23933, "verse_number": "२-९-२८-६", "content_sanskrit": "कलशं वामभागे स्वे संस्थाप्यावाह्य तत्र च ।\nतीर्थानि गन्धपुष्पाद्यैरुपचारैस्तमर्चयेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003933006, "chapter_id": 23933, "verse_number": "२-९-२८-७", "content_sanskrit": "पूजाद्रव्याणि चात्मानं प्रोक्षयित्वा तदम्बुना ।\nशंखं घण्टां च संपूज्य भूतशुद्धिं समाचरेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003933007, "chapter_id": 23933, "verse_number": "२-९-२८-८", "content_sanskrit": "आभ्यन्तराग्निवायुभ्यां दग्ध्वा पापात्मकं वपुः ।\nशुद्धस्य स्वात्मनस्त्वैक्यं भावयेद्ब्रह्मणा स्थिरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003933008, "chapter_id": 23933, "verse_number": "२-९-२८-९", "content_sanskrit": "ततोऽक्षरब्रह्मरूपो राधाकृष्णं हृदि प्रभुम् ।\nध्यायेदव्यग्रमनसा प्राणायामं समाचरन् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003933009, "chapter_id": 23933, "verse_number": "२-९-२८-१०", "content_sanskrit": "अधोमुखं नाभिपद्मं कदलीपुष्पवत्स्थितम् ।\nविभाव्यापानपवनं प्राणेनैक्यमुपानयेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003933010, "chapter_id": 23933, "verse_number": "२-९-२८-११", "content_sanskrit": "पद्मनाले तमानीय सह तेन तदम्बुजम् ।\nआकर्षेदूर्ध्वमथ तन्नदत्तीव्रमुपैति हृत् ।\nप्रफुल्लति च तत्रैतद्धृदयाकाश उल्लसत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003933011, "chapter_id": 23933, "verse_number": "२-९-२८-१२", "content_sanskrit": "तेजोराशिमये तत्र ततोप्यधिकतेजसा ।\nदर्शनीयतमं शान्तं ध्यायेच्छ्रीराधिकापतिम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003933012, "chapter_id": 23933, "verse_number": "२-९-२८-१३", "content_sanskrit": "उपविष्टं स्थितं वा तं दिव्यचिन्मयविग्रहम् ।\nध्यायेत्किशोरवयसं कोटिकन्दर्पसुन्दरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003933013, "chapter_id": 23933, "verse_number": "२-९-२८-१४", "content_sanskrit": "रूपानुरूपसंपूर्णदिव्यावयवलक्षितम् ।\nशरच्चन्द्रावदातांगं दीर्घचारुभुजद्वयम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003933014, "chapter_id": 23933, "verse_number": "२-९-२८-१५", "content_sanskrit": "आरक्तकोमलतलरम्यांगुलिपदाम्बुजम् ।\nतुंगारुणस्निग्धनखद्युतिलज्जायितोडुपम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003933015, "chapter_id": 23933, "verse_number": "२-९-२८-१६", "content_sanskrit": "शिञ्जत्किंकिणिमञ्जीरहंसकांघ्रियुगश्रियम् ।\nसुवृत्तजंघायुगलं समजानूरुशोभनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003933016, "chapter_id": 23933, "verse_number": "२-९-२८-१७", "content_sanskrit": "सद्रत्नरशनाबद्धपीताम्बरकटिश्रियम् ।\nउत्तुंगकुक्षिनाभ्यन्तर्निम्ननाभिवलित्रयम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003933017, "chapter_id": 23933, "verse_number": "२-९-२८-१८", "content_sanskrit": "विततोत्तुंगहृदयं श्रीवत्सावर्त्तशोभितम् ।\nललन्तीगुच्छगुच्छार्द्धदेवच्छन्दादिभूषितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003933018, "chapter_id": 23933, "verse_number": "२-९-२८-१९", "content_sanskrit": "नानासुगन्धिपुष्पस्रक्स्वर्णयज्ञोपवीतिनम् ।\nउन्निद्रशोणपद्माभकरकंकणभूषणम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003933019, "chapter_id": 23933, "verse_number": "२-९-२८-२०", "content_sanskrit": "सूक्ष्मपर्वांगुलिद्योतन्नैकसद्रत्नमुद्रिकम् ।\nनिनादयन्तं मधुरं वेणुं सर्वमनोहरम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003933020, "chapter_id": 23933, "verse_number": "२-९-२८-२१", "content_sanskrit": "विपुलांसं गूढजत्रुं महाबाह्वंगदद्युतिम् ।\nभ्रमत्सुगन्धलुब्धालिझंकारितवनस्रजम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003933021, "chapter_id": 23933, "verse_number": "२-९-२८-२२", "content_sanskrit": "कम्बूपमगलभ्राजत्सद्ग्रैवेयककौस्तुभम् ।\nशोभमानहनुं बिम्बीफलशोणाधरद्युतिम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003933022, "chapter_id": 23933, "verse_number": "२-९-२८-२३", "content_sanskrit": "सितस्मितकलाराजत्पूर्णचन्द्रनिभाननम् ।\nतिलपुष्पसमाकारदर्शनीयसुनासिकम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003933023, "chapter_id": 23933, "verse_number": "२-९-२८-२४", "content_sanskrit": "समानकर्णविभ्राजन्मकराकृतिकुण्डलम् ।\nकर्णोपरिलसच्चित्रपुष्पगुच्छावतंसकम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003933024, "chapter_id": 23933, "verse_number": "२-९-२८-२५", "content_sanskrit": "समसूक्ष्मरदज्योत्स्नोल्लसद्गण्डस्थलश्रियम् ।\nपद्मपत्रायतारक्तप्रान्तरम्यविलोचनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003933025, "chapter_id": 23933, "verse_number": "२-९-२८-२६", "content_sanskrit": "पृथुतुंगललाटं च कामचापायितभ्रुवम् ।\nवक्रसूक्ष्मासितस्निग्धमनोहरशिरोरुहम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003933026, "chapter_id": 23933, "verse_number": "२-९-२८-२७", "content_sanskrit": "नानासद्रत्नखचितकिरीटधृतशेखरम् ।\nप्रेम्णा निजं वीक्षमाणं प्रसन्नं स्निग्धया दृशा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003933027, "chapter_id": 23933, "verse_number": "२-९-२८-२८", "content_sanskrit": "ध्यात्वेत्थं कृष्णमथ तद्वामे राधां विचिन्तयेत् ।\nद्विभुजां स्वर्णगौरांगीं कौसुम्भामलवाससम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003933028, "chapter_id": 23933, "verse_number": "२-९-२८-२९", "content_sanskrit": "समकर्णोल्लसद्रत्नभूषणांशुकनासिकाम् ।\nकिशोरीं मृगशावाक्षीं पीनोन्नतघनस्तनीम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003933029, "chapter_id": 23933, "verse_number": "२-९-२८-३०", "content_sanskrit": "कृशमध्यां पृथुश्रोणिं रत्नकाञ्चीविभूषिताम् ।\nअनेकदिव्याभरणां विकचाब्जाननस्मिताम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003933030, "chapter_id": 23933, "verse_number": "२-९-२८-३१", "content_sanskrit": "रत्नांगुलीयकेयूरकङ्कणादिलसत्कराम् ।\nशिञ्जद्धंसकमञ्जीरशोभमानांघ्रिपङ्कजाम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003933031, "chapter_id": 23933, "verse_number": "२-९-२८-३२", "content_sanskrit": "विशालभालविलसत्सत्काश्मीरललाटिकाम् ।\nबिम्बोष्ठीं सुकपोलां च वेणीग्रथितमालतीम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003933032, "chapter_id": 23933, "verse_number": "२-९-२८-३३", "content_sanskrit": "प्रेक्षमाणां प्रभुं प्रेम्णा दधानामम्बुजं करे ।\nध्यात्वैवं राधिकां तत्र प्रभुमर्चेत्तया सह ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003933033, "chapter_id": 23933, "verse_number": "२-९-२८-३४", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे श्रीवासुदेवमाहात्म्ये क्रियायोगे श्रीराधाकृष्णस्वरूपध्याननिरूपणं नामाऽष्टाविंशोऽध्यायः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]