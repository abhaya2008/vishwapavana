[{"id": 2209428, "chapter_id": 5476, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209429, "chapter_id": 5476, "verse_number": "१", "content_sanskrit": "ब्रह्मास्त्रं तु महाराज कृष्णेन प्रतिसंहृतम् ।\nतदा तद्वेश्म ते पित्रा सर्वतोऽपि विदीपितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209430, "chapter_id": 5476, "verse_number": "२", "content_sanskrit": "ततो रक्षांसि सर्वाणि नेशुस्त्यक्त्वा गृहं तु तत् ।\nअन्तरिक्षे च वागासीत् साधु केशव साध्विति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209431, "chapter_id": 5476, "verse_number": "३", "content_sanskrit": "तदस्त्रं ज्वलितं चापि पितामहमगात् तदा ।\nततः प्राणान् पुनर्लेभे पिता तव जनेश्वर ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209432, "chapter_id": 5476, "verse_number": "४", "content_sanskrit": "व्यचेष्टत च बालोऽसौ यथोक्तं शौरिणा तदा ।\nबभूवुर्मुदिता राजन् ततस्ता भरतस्त्रियः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209433, "chapter_id": 5476, "verse_number": "५", "content_sanskrit": "ब्राह्मणा वाचयामासुर्गोविन्दस्य च शासनात् ।\nततस्ता मुदिताः सर्वाः प्रशशंसुर्जनार्दनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209434, "chapter_id": 5476, "verse_number": "६", "content_sanskrit": "स्त्रियो भरतसिंहानां नावं दृष्ट्वेव पारगाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209435, "chapter_id": 5476, "verse_number": "७", "content_sanskrit": "कुन्ती द्रुपदपुत्री च सुभद्रा चोत्तरा तथा ।\nस्त्रियश्चान्या नृसिंहानां बभूवुर्हृष्टमानसाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209436, "chapter_id": 5476, "verse_number": "८", "content_sanskrit": "तत्र मल्ला नटा झल्ला रञ्जिकाः सौखशायिकाः ।\nसूतमागधसङ्घाश्चाप्यस्तुवंस्तं जनार्दनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209437, "chapter_id": 5476, "verse_number": "९", "content_sanskrit": "कुरुवंशस्तवार्थाभिराशीर्भिर्भरतर्षभ ।\nसभाजयत संहृष्टो महाराज महाजनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209438, "chapter_id": 5476, "verse_number": "१०", "content_sanskrit": "उत्थाय तु यथाकालमुत्तरा यदुनन्दनम् ।\nअभ्यवादयत प्रीता सह पुत्रेण भारत ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209439, "chapter_id": 5476, "verse_number": "११", "content_sanskrit": "तस्यै कृष्णो ददौ प्रीतो बहुरत्नं विशेषवित् ।\nतथैव वृष्णिशार्दूलो नाम चास्याकरोत् प्रभुः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209440, "chapter_id": 5476, "verse_number": "१२", "content_sanskrit": "पितुस्तव महाराज सत्यसन्धो जनार्दनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209441, "chapter_id": 5476, "verse_number": "१३", "content_sanskrit": "परिक्षीणे कुले यस्मात् जातोऽयमभिमन्युजः ।\nपरीक्षिदिति नामास्य भवत्वित्यब्रवीत् तदा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209442, "chapter_id": 5476, "verse_number": "१४", "content_sanskrit": "सोऽवर्धत यथाकालं पिता तव नराधिप ।\nमनःप्रह्लादनश्चासीत् सर्वलोकस्य भारत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209443, "chapter_id": 5476, "verse_number": "१५", "content_sanskrit": "मासं जातस्तु ते वीर पिता भवति भारत ।\nअथाजग्मुः सुबहुलं रत्नमादाय पाण्डवाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209444, "chapter_id": 5476, "verse_number": "१६", "content_sanskrit": "मेरुकूटनिभान् भाण्डान् कलशान् भाजनानि च ।\nकृताकृतं महद्धैममादाय पुरुषोत्तमाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209445, "chapter_id": 5476, "verse_number": "१७", "content_sanskrit": "भारार्तैर्वाहनैस्तत्र गोरुते गोरुते पथि ।\nनिवसन्तो ययुर्देवं स्मरन्तः परमेष्ठिनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209446, "chapter_id": 5476, "verse_number": "१८", "content_sanskrit": "नासीत् तत्र नरः कश्चिद् अभारार्तो नृपं विना ।\nभीमादयोऽपि यज्ञार्थं वहन्ते किं पुनर्जनाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209447, "chapter_id": 5476, "verse_number": "१९", "content_sanskrit": "तान् समीपगतान् दृष्ट्वा निर्ययुर्वृष्णिपुङ्गवाः ।\nअलञ्चक्रुश्च माल्यौघैर्नगरं नागसाह्वयम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209448, "chapter_id": 5476, "verse_number": "२०", "content_sanskrit": "पताकाभिर्विचित्राभिर्ध्वजैश्च विविधैरपि ।\nवेश्मानि समलञ्चक्रुः पौराश्चापि नराधिप ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209449, "chapter_id": 5476, "verse_number": "२१", "content_sanskrit": "देवतायतनानां च पूजा बहुविधास्तथा ।\nसन्दिदेशाथ विदुरः पाण्डुपुत्रप्रियेप्सया ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209450, "chapter_id": 5476, "verse_number": "२२", "content_sanskrit": "राजमार्गाश्च तत्रासन् सुमनोभिरलङ्कृताः ।\nशुशुभे तत्पुरं चापि समुद्रौघनिभस्वनम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209451, "chapter_id": 5476, "verse_number": "२३", "content_sanskrit": "नर्तकैश्चापि नृत्यद्भिर्गायकानां च निःस्वनैः ।\nआसीद्वैश्रवणस्येव निवासस्तत् पुरं तदा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209452, "chapter_id": 5476, "verse_number": "२४", "content_sanskrit": "वन्दिभिश्च नरै राजन् स्त्रीसहायैः सहस्रशः ।\nतत्र तत्र विविक्तेषु समन्तादुपशोभितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209453, "chapter_id": 5476, "verse_number": "२५", "content_sanskrit": "पताका धूयमानाश्च समन्तान्मातरिश्वना ।\nअदर्शयन्निव तदा कुरून् वै दक्षिणोत्तरान् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209454, "chapter_id": 5476, "verse_number": "२६", "content_sanskrit": "अघोषयंस्तदा चापि पुरुषा राजमार्गतः ।\nसर्वरात्रविहारोऽद्य रत्नाभरणलक्षणः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209455, "chapter_id": 5476, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि हस्तिनापुरि शृङ्गारकथनं नाम सप्ततितमोऽध्यायः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]