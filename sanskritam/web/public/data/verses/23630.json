[{"id": 7003630000, "chapter_id": 23630, "verse_number": "१-२-१७-१", "content_sanskrit": "नारद उवाच ।\nततस्तयोः समायोगः सेनयोरुभयोरभूत् ।\nयुगांते समनुप्राप्ते यथा क्षुब्धसमुद्रयोः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003630001, "chapter_id": 23630, "verse_number": "१-२-१७-२", "content_sanskrit": "सुरासुराणां संमर्दे तस्मिन्परमदारुणे ।\nतुमुलं सुमहत्क्रांते सेनयोरुभयोरपि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003630002, "chapter_id": 23630, "verse_number": "१-२-१७-३", "content_sanskrit": "गर्जतां देवदैत्यानां शंखभेरीरवेण च ।\nतूर्याणां चैव निर्घोषैर्मातंगानां च बृंहितैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003630003, "chapter_id": 23630, "verse_number": "१-२-१७-४", "content_sanskrit": "हेषितैर्हयवृंदानां रथनेमिस्वनेन च ।\nघोषेण चैव तूर्याणां युगांत इव चाभवत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003630004, "chapter_id": 23630, "verse_number": "१-२-१७-५", "content_sanskrit": "रोषेणाबिपरीतांगास्त्यक्तजीवितचेतसः ।\nसमसज्जन्त तेन्योन्यं प्रक्रमेणातिलोहिताः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003630005, "chapter_id": 23630, "verse_number": "१-२-१७-६", "content_sanskrit": "रथा रथैः समासक्ता गजाश्चापि महागजैः ।\nपत्तयः पत्तिभिश्चैव हयाश्चापि महाहयैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003630006, "chapter_id": 23630, "verse_number": "१-२-१७-७", "content_sanskrit": "ततः प्रासाशनिगदाभिंडिपालपरश्वधैः ।\nशक्तिभिः पट्टिशैः शूलैर्मुद्गरैः कणयैर्गुडैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003630007, "chapter_id": 23630, "verse_number": "१-२-१७-८", "content_sanskrit": "चक्रैश्च शक्तिभिश्चैव तोमरैरंकुशैरपि ।\nकर्णिनालीकनाराचवत्सदंतार्द्धचंद्रकैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003630008, "chapter_id": 23630, "verse_number": "१-२-१७-९", "content_sanskrit": "भल्लैर्वेतसपत्रैश्च शुकतुंडैश्च निर्मलैः ।\nवृष्टिभिश्चाद्भुताकारैर्गगनं समपद्यत ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003630009, "chapter_id": 23630, "verse_number": "१-२-१७-१०", "content_sanskrit": "संप्रच्छाद्य दिशः सर्वास्तमोमयमिवाभवत् ।\nप्राज्ञायंत न तेऽन्योन्यं तस्मिंस्तमसि संकुले ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003630010, "chapter_id": 23630, "verse_number": "१-२-१७-११", "content_sanskrit": "अदृश्यभूतास्तमसि न्यकृंतंत परस्परम् ।\nततो भुजैर्ध्वजैश्छत्रैः शिरोभिश्च सकुंडलैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003630011, "chapter_id": 23630, "verse_number": "१-२-१७-१२", "content_sanskrit": "गजैस्तुरंगैः पादातैः पतद्भिः पतितैरपि ।\nआकाशशिरसो भ्रष्टैः पंकजैरिव भूश्चिता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003630012, "chapter_id": 23630, "verse_number": "१-२-१७-१३", "content_sanskrit": "भग्नदंता भिन्नकुंभाश्छिन्नदीर्घमहाकराः ।\nगजाः शैलनिभाः पेतुर्धरण्यां रुधिरस्रवाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003630013, "chapter_id": 23630, "verse_number": "१-२-१७-१४", "content_sanskrit": "भग्नैषाश्च रथाः पेतुर्भग्नाक्षाः शकलीकृताः ।\nपत्तयः कोटिशः पेतुस्तुरंगाश्च सहस्रशः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003630014, "chapter_id": 23630, "verse_number": "१-२-१७-१५", "content_sanskrit": "ततः शोणितनद्यश्च हर्षदाः पिशिताशिनाम् ।\nवैतालानंददायिन्यो व्यजायंत सहस३शः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003630015, "chapter_id": 23630, "verse_number": "१-२-१७-१६", "content_sanskrit": "तस्मिंस्तथाविधे युद्धे सेनानीर्ग्रसनोऽरिहा ।\nबाणवर्षेण महता देवसैन्यमकंपयत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003630016, "chapter_id": 23630, "verse_number": "१-२-१७-१७", "content_sanskrit": "ततो ग्रसनमालोक्य यमः क्रोधविमूर्छितः ।\nववर्ष शरवर्षेण विशेषादग्निवर्चसा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003630017, "chapter_id": 23630, "verse_number": "१-२-१७-१८", "content_sanskrit": "स विद्धो बहुभिर्षाणैर्ग्रसनोऽतिपराक्रमः ।\nकृतप्रतिकृताकांक्षी धनुरानम्य भैरवम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003630018, "chapter_id": 23630, "verse_number": "१-२-१७-१९", "content_sanskrit": "शरैः सहस्रैश्च पञ्चलक्षैश्चैव व्यताडयत् ।\nग्रसनेन विमुक्तांस्ताञ्छरान्सोपि निवार्य च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003630019, "chapter_id": 23630, "verse_number": "१-२-१७-२०", "content_sanskrit": "बाणवृष्टिभिरुग्राभिर्यमो ग्रसनमर्दयत् ।\nकृतांतशरवृष्टीनां संततीः प्रतिसर्पतीः ।\nचिच्छेद शरवर्षेण ग्रसनो दानवेश्वरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003630020, "chapter_id": 23630, "verse_number": "१-२-१७-२१", "content_sanskrit": "विफलां तां समालोक्य यमः स्वशरसंततिम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003630021, "chapter_id": 23630, "verse_number": "१-२-१७-२२", "content_sanskrit": "प्राहिणोन्मुद्गरं दीप्तं ग्रसनस्य रथं प्रति ।\nस तं मुद्गरमायांतमुत्पत्य रथसत्तमात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003630022, "chapter_id": 23630, "verse_number": "१-२-१७-२३", "content_sanskrit": "जग्राह वामहस्तेन लीलया ग्रसनोऽरिहा ।\nतेनैव मुद्गरेणाथ यमस्य महिषं रुषा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003630023, "chapter_id": 23630, "verse_number": "१-२-१७-२४", "content_sanskrit": "ताडयामास वेगेन स पपात महीतले ।\nउत्पत्याथ यमस्तस्मान्महिषान्निपतिष्यतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003630024, "chapter_id": 23630, "verse_number": "१-२-१७-२५", "content_sanskrit": "प्रासेन ताडयामास ग्रसनं वदने दृढम् ।\nस तु प्राप्तप्रहारेण मूर्छितो न्यपतद्भुवि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003630025, "chapter_id": 23630, "verse_number": "१-२-१७-२६", "content_sanskrit": "ग्रसनं पतित दृष्ट्वा जंभो भीमपराक्रमः ।\nयमस्य भिंडिपालेन प्रहारमकरोद्धृदि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003630026, "chapter_id": 23630, "verse_number": "१-२-१७-२७", "content_sanskrit": "यमस्तेन प्रहारेण सुस्राव रुधिरं मुखात् ।\nअतिगाढ प्रहारार्त्तः कृतांतोमूर्छितोऽभवत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003630027, "chapter_id": 23630, "verse_number": "१-२-१७-२८", "content_sanskrit": "कृतांतमर्दितं दृष्ट्वा गदापाणिर्धनादिपः ।\nवृतो यक्षायुतगणैर्जंभं प्रत्युद्ययौ रुषआ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003630028, "chapter_id": 23630, "verse_number": "१-२-१७-२९", "content_sanskrit": "जंभो रुषा तमायांतं दानवा नीकसंवृतः ।\nजग्राह वाक्यं राज्ञस्तु यता स्निग्धेन भाषितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003630029, "chapter_id": 23630, "verse_number": "१-२-१७-३०", "content_sanskrit": "ग्रसनो लब्धसंज्ञोऽथ यमस्य प्राहिणोद्गदाम् ।\nमणिहेमपरिष्कारां गुर्वी परिघमर्दिनीम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003630030, "chapter_id": 23630, "verse_number": "१-२-१७-३१", "content_sanskrit": "तामापतंतीं संप्रेक्ष्य गदां महिषवाहनः ।\nगदायाः प्रतिघातार्थं जगज्ज्वलनभैरवम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003630031, "chapter_id": 23630, "verse_number": "१-२-१७-३२", "content_sanskrit": "दंडं मुमोच कोपेन ज्वालामालासमाकुलम् ।\nस गदां वियति प्राप्य ररासांबुधरोद्धतम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003630032, "chapter_id": 23630, "verse_number": "१-२-१७-३३", "content_sanskrit": "संवट्टश्चाभवत्ताभ्यां शैलाभ्यामिव दुःसहः ।\nताभ्यां निष्पेषनिर्ह्राद जडीकृतदिगंतरम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003630033, "chapter_id": 23630, "verse_number": "१-२-१७-३४", "content_sanskrit": "जगद्व्याकुलतां यातं प्रलयागमशंकया ।\nक्षणात्प्रशांतनिर्ह्रादं ज्वलदुल्कासमाचितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003630034, "chapter_id": 23630, "verse_number": "१-२-१७-३५", "content_sanskrit": "निष्पेषणं तयोर्भीमम भूद्गनगोचरम् ।\nनिहत्याथ गदां दण्डस्ततो ग्रसनमूर्धनि ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003630035, "chapter_id": 23630, "verse_number": "१-२-१७-३६", "content_sanskrit": "पपात पौरुषं हत्वा यथा दैवं पुरार्जितम् ।\nसतु तेन प्रहारेण दृष्ट्वा सतिमिरादिशः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003630036, "chapter_id": 23630, "verse_number": "१-२-१७-३७", "content_sanskrit": "पपात भूमौ निःसंज्ञो भूमिरेणुविभूषितः ।\nततो हाहारवो घोरः सेनयोरुभयोरभूत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003630037, "chapter_id": 23630, "verse_number": "१-२-१७-३८", "content_sanskrit": "ततो महूर्तमात्रेण ग्रसनः प्राप्य चेतनाम् ।\nअपश्यत्स्वां तनुं ध्वस्तां विलोलाभरणांबराम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003630038, "chapter_id": 23630, "verse_number": "१-२-१७-३९", "content_sanskrit": "स चापि चिंतयामास कृतप्रतिकृतक्रियाम् ।\nधिगस्तु पौरुषं मह्यं प्रभोरग्रेसरः कथम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003630039, "chapter_id": 23630, "verse_number": "१-२-१७-४०", "content_sanskrit": "मय्याश्रितानि सैन्यानि जिते मयि जितानि च ।\nअसंभावितरूपो हि सज्जनो मोदते सुखम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003630040, "chapter_id": 23630, "verse_number": "१-२-१७-४१", "content_sanskrit": "संभावितस्त्वशक्तश्चेत्तस्य नायं परोऽपि वा ।\nएवं संचिंत्य वेगेन समुत्तस्थौ महाबलः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003630041, "chapter_id": 23630, "verse_number": "१-२-१७-४२", "content_sanskrit": "मुद्गरं कालदण्डाभं गृहीत्वा गिरिसंनिभम् ।\nग्रसनो घोरसंकल्पः संदष्टौष्ठपुटच्छदः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003630042, "chapter_id": 23630, "verse_number": "१-२-१७-४३", "content_sanskrit": "रथेन त्वरितोऽगच्छदाससादांतकं रणे ।\nसमासाद्य यमं युद्धे ग्रसनो भ्राम्य मुद्गरम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003630043, "chapter_id": 23630, "verse_number": "१-२-१७-४४", "content_sanskrit": "वेगेन महता रौद्रं चिक्षेप यममूर्धनि ।\nविलोक्य मुद्गरं दीप्तं यमः संभ्रांतलोचनः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003630044, "chapter_id": 23630, "verse_number": "१-२-१७-४५", "content_sanskrit": "वंचयामास दुर्द्धर्षं मुद्गरं तं महाबलः ।\nतस्मिन्नपसृते दूरं चंडानां भीमकर्मणाम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003630045, "chapter_id": 23630, "verse_number": "१-२-१७-४६", "content_sanskrit": "याम्यानां किंकराणां च अयुतं निष्पिपेष ह ।\nततस्तदयुतं दृष्ट्वा हतं किंकरवाहिनी ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003630046, "chapter_id": 23630, "verse_number": "१-२-१७-४७", "content_sanskrit": "दशार्बुदमिता क्रुद्धा ग्रसनायान्वधावत ।\nग्रसनस्तु समालोक्य तां किंकरमयां शुभाम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003630047, "chapter_id": 23630, "verse_number": "१-२-१७-४८", "content_sanskrit": "मेने यमसहस्राणि तादृग्रूपबला हि सा ।\nविगाह्य ग्रसनं सेना ववर्ष शरवृष्टिभिः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003630048, "chapter_id": 23630, "verse_number": "१-२-१७-४९", "content_sanskrit": "कल्पांतघोरसंकाशो बभूव स महारणः ।\nकेचिच्छैलेन बिभिदुः केचिद्बाणैरजिह्यगैः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003630049, "chapter_id": 23630, "verse_number": "१-२-१७-५०", "content_sanskrit": "पिपिषुर्गदया केचित्कोचिन्मुद्गरवृष्टिभिः ।\nकेचित्प्रासप्रहारैश्च ताडयामासुरुद्धताः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003630050, "chapter_id": 23630, "verse_number": "१-२-१७-५१", "content_sanskrit": "अपरे किंकरास्तस्य ललंबुर्बाहुमंडले ।\nशिलाभिरपरे जघ्नुर्द्रुमैरन्ये महोच्छ्रयैः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003630051, "chapter_id": 23630, "verse_number": "१-२-१७-५२", "content_sanskrit": "तस्यापरे च गात्रेषु दशनांश्चन्यपातयन् ।\nअपरे मुष्टिभिः पृष्ठं किंकरास्ताडयंति च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003630052, "chapter_id": 23630, "verse_number": "१-२-१७-५३", "content_sanskrit": "एवं चाभिद्रुतस्तैः स ग्रसनः क्रोधमूर्छितः ।\nउत्साद्य गात्रं भूपृष्ठे निष्पिपेष सहस्रशः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003630053, "chapter_id": 23630, "verse_number": "१-२-१७-५४", "content_sanskrit": "कांश्चिदुत्थाय जघ्नेऽसौ मुष्टिभिः किंकरान्रणे ।\nकांश्चित्पादप्रहारेण धावन्नन्यानचूर्णयत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003630054, "chapter_id": 23630, "verse_number": "१-२-१७-५५", "content_sanskrit": "क्षणैकेन स तान्निन्ये यमलोकायभारत ।\nस च किंकरयुद्धेन ववृधेऽग्निरिवैधसा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003630055, "chapter_id": 23630, "verse_number": "१-२-१७-५६", "content_sanskrit": "तमालोक्य यमोऽश्रांतं श्रांतंस्तांश्च हतान्स्वकान् ।\nआजगाम समुद्यम्य दंडं महिषवाहनः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003630056, "chapter_id": 23630, "verse_number": "१-२-१७-५७", "content_sanskrit": "ग्रसनस्तु तमायांतमाजघ्ने गदयोरसि ।\nअचिंतयित्वा तत्कर्म ग्रसनस्यांतकोऽरिहा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003630057, "chapter_id": 23630, "verse_number": "१-२-१७-५८", "content_sanskrit": "व्याघ्रान्दंडेन संजघ्ने स रथान्न्य पतद्भुवि ।\nततः क्षणेन चोत्थाय संचिंत्यात्मानमुद्धतः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003630058, "chapter_id": 23630, "verse_number": "१-२-१७-५९", "content_sanskrit": "वायुवेगेन सहसा ययौ यमरथं प्रति ।\nपदातिः स रथं तं च समारुह्य यमं तदा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003630059, "chapter_id": 23630, "verse_number": "१-२-१७-६०", "content_sanskrit": "योधयामास बाहुभ्यामाकृष्य बलिनां वरः ।\nयमोऽपि शस्त्राण्युत्सृज्च बाहुयुद्धे प्रवर्तते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003630060, "chapter_id": 23630, "verse_number": "१-२-१७-६१", "content_sanskrit": "ग्रसनं कटिवस्त्रे तु यमं गृह्य बलोत्कटः ।\nभ्रामयामास वेगेन संभ्रमाविष्टचेतसम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003630061, "chapter_id": 23630, "verse_number": "१-२-१७-६२", "content_sanskrit": "विमोच्याथ यमः कष्टात्कंठेऽवष्टभ्य चासुरम् ।\nबाहुभ्यां भ्रामयामास सोऽप्यात्मानममोचयत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003630062, "chapter_id": 23630, "verse_number": "१-२-१७-६३", "content_sanskrit": "ततो जघ्नतुरन्योन्यं मुष्टिभिर्निर्दयौ च तौ ।\nदैत्येंद्रस्यातिवीर्यत्वात्परिश्रांततरो यमः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003630063, "chapter_id": 23630, "verse_number": "१-२-१७-६४", "content_sanskrit": "स्कंधे निधाय दैत्यस्य मुखं विश्रांतिमैच्छत ।\nतमा लक्ष्य ततो दैत्यः श्रांतमुत्पाट्य चौजसा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003630064, "chapter_id": 23630, "verse_number": "१-२-१७-६५", "content_sanskrit": "निष्पिपेष महीपृष्ठे विनिघ्नन्पार्ष्णिपाणिभिः ।\nततो यमस्य वदनात्सुस्राव रुधिरं बहु ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003630065, "chapter_id": 23630, "verse_number": "१-२-१७-६६", "content_sanskrit": "निर्जीवमिति तं दृष्ट्वा ततः संत्यज्य दानवः ।\nजयं प्राप्योद्धतं नादं मुक्त्वा संत्रास्य देवताः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003630066, "chapter_id": 23630, "verse_number": "१-२-१७-६७", "content_sanskrit": "स्वकं सैन्यं समासाद्य तस्थौ गिरिरिवाचलः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003630067, "chapter_id": 23630, "verse_number": "१-२-१७-६८", "content_sanskrit": "नादेन तस्य ग्रसनस्य संख्ये महायुधैश्चार्दितसर्वगात्राः ।\nगते कृथांते वसुधां च निष्प्रभे चकंपिरे कांदिशिकाः सुरास्ते ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]