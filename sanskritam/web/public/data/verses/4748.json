[{"id": 2177517, "chapter_id": 4748, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177518, "chapter_id": 4748, "verse_number": "१", "content_sanskrit": "स दृष्ट्वा निहतान् सङ्खे पुत्रान् पौत्रान् सखींस्तथा ।\nमहादुःखपरीतात्मा बभूव जनमेजय\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177519, "chapter_id": 4748, "verse_number": "२", "content_sanskrit": "ततस्तस्य महान् शोकः प्रादुरासीन्महात्मनः ।\nस्मरतः पुत्रपौत्रांस्तान् भ्रातॄन् सुहृद एव च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177520, "chapter_id": 4748, "verse_number": "३", "content_sanskrit": "तमश्रुपरिपूर्णाक्षं वेपमानमचेतसम् ।\nसुहृदो भृशसंविग्नाः सान्त्वयाञ्चक्रिरे तदा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177521, "chapter_id": 4748, "verse_number": "४", "content_sanskrit": "(कृत्वा तु विधिवत् तेषां पुत्राणाममितौजसाम् ।\nप्रेतकार्याणि सर्वेषां बभूव भृशदुःखितः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177522, "chapter_id": 4748, "verse_number": "", "content_sanskrit": "तस्मिन् मुहूर्ते जवनैर्वाजिभिर्हेममालिभिः\t॥५॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177523, "chapter_id": 4748, "verse_number": "६", "content_sanskrit": "ततः तस्मिन् क्षणे काले रथेनादित्यवर्चसा ।\nनकुलः कृष्णया सार्धमुपायात् परमार्तवत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177524, "chapter_id": 4748, "verse_number": "७", "content_sanskrit": "उपप्लाव्यगता सा तु श्रुत्वा सुमहदप्रियम् ।\nमहाविनाशं पुत्राणां सर्वेषां व्यथितेन्द्रिया\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177525, "chapter_id": 4748, "verse_number": "८", "content_sanskrit": "कम्पमानेव कदळी वातेनाभिसमाहता ।\nकृष्णा राजानमासाद्य शोकार्ता न्यपतद् भुवि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177526, "chapter_id": 4748, "verse_number": "९", "content_sanskrit": "विबभौ वदनं तस्या रुदन्त्याः शोककर्शितम् ।\nफुल्लपद्मपलाशाक्षं तमोग्रस्त इवांशुमान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177527, "chapter_id": 4748, "verse_number": "१०", "content_sanskrit": "हा पुत्रबान्धवाश्चैव इत्येवं विललाप सा ।\nततो भीमो तामुत्थाप्य वचनं चेदमब्रवीत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177528, "chapter_id": 4748, "verse_number": "११", "content_sanskrit": "निवर्तय त्वं कल्याणि मा च शोकमनःकृथाः ।\nअश्वत्थामानमद्येह हनिष्यामि न संशयः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177529, "chapter_id": 4748, "verse_number": "१२", "content_sanskrit": "यदि मे दृष्टिप्राप्तोऽसौ जीवितं न भविष्यति ।\nतस्य शिरस्त्वदग्रे च पातयिष्याम्यहं ध्रुवम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177530, "chapter_id": 4748, "verse_number": "१३", "content_sanskrit": "कृपं च कृतवर्माणं तं हनिष्यामि चाद्य वै ।\nया मयात्र त्वदग्रे च उक्ता वाचस्त्वया कृते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177531, "chapter_id": 4748, "verse_number": "१४", "content_sanskrit": "ताः सर्वाः सफला कृत्वा न हि शोके मनः कृथाः ।\nइत्येवमुक्त्वा तां वाक्यं भीमसेनो न्यवर्तत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177532, "chapter_id": 4748, "verse_number": "१५", "content_sanskrit": "ततो युधिष्ठिरो ब्रूयाद् वाक्यं तस्या हितं प्रियम् ।\nन हि त्वं देव(वि) जानीषे मम वाक्यं निबोध वै\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177533, "chapter_id": 4748, "verse_number": "१६", "content_sanskrit": "द्रोणो हतो च गाङ्गेयः कर्णश्चापि तथैव च ।\nशल्यो जयद्रथश्चैव ये चान्ये क्षत्रिया रणे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177534, "chapter_id": 4748, "verse_number": "१७", "content_sanskrit": "हतो दुर्योधनो राजा भ्रातृभिः परिवारितः ।\nतस्य पुत्राश्च पौत्राश्च ते च सर्वे निपातिताः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177535, "chapter_id": 4748, "verse_number": "१८", "content_sanskrit": "सुयोधनबलं क्षीणं मम चैव न संशयः ।\nकालेन हीयते सर्वं जगद्वै सचराचरम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177536, "chapter_id": 4748, "verse_number": "१९", "content_sanskrit": "दशरथसुतो रामो रावणस्य भयङ्कराम् ।\nहत्वा सेनां बभौ तस्य ध्वस्तमेध इवांशुमान्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2177537, "chapter_id": 4748, "verse_number": "२०", "content_sanskrit": "ततस्तां पतितां दृष्ट्वा संरभी सत्यविक्रमः ।\nबाहुभ्यां प्रतिजग्राह समुपेत्य वृकोदरः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2177538, "chapter_id": 4748, "verse_number": "२१", "content_sanskrit": "तां दृष्ट्वा सम्परिष्वज्य संरम्भात् सत्यविक्रमः ।\nबाहुभ्यां परिजग्राह समुपेत्य वृकोदरः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2177539, "chapter_id": 4748, "verse_number": "२२", "content_sanskrit": "सा समाश्वासिता तेन भीमसेनेन भामिनी ।\nरुदती पाण्डवज्येष्ठमिदं वचनमब्रवीत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2177540, "chapter_id": 4748, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2177541, "chapter_id": 4748, "verse_number": "२३", "content_sanskrit": "दिष्ट्या राजन्नवाप्येमामखिलां भोक्ष्यसे महीम् ।\nआत्मजान् क्षत्रधर्मेण श्रुत्वा सङ्खे निपातितान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2177542, "chapter_id": 4748, "verse_number": "२४", "content_sanskrit": "दिष्ट्या सर्वास्त्रकुशलं मत्तमातङ्गगामिनम् ।\nअवाप्य पृथिवीं कृत्स्नां सौभद्रं न स्मरिष्यसि\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2177543, "chapter_id": 4748, "verse_number": "२५", "content_sanskrit": "आत्मजांस्तैरधर्मेण श्रुत्वा शूरान् निपातितान् ।\nस्थितो राज्ये मया सार्धं विहरन् न स्मरिष्यसि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2177544, "chapter_id": 4748, "verse_number": "२६", "content_sanskrit": "प्रसुप्तानां वधं श्रुत्वा द्रौणिना पापकर्मणा ।\nशोको मां दहते गाढं हुताशन इवाश्रयम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2177545, "chapter_id": 4748, "verse_number": "२७", "content_sanskrit": "तस्य पापकृतो द्रौणेर्न चेदद्य दुरात्मनः ।\nह्रियते सानुबन्धस्य युधि विक्रम्य जीवितम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2177546, "chapter_id": 4748, "verse_number": "२८", "content_sanskrit": "इहैव प्रायमासिष्ये तन्निबोधत पाण्डवाः ।\nन चेत् फलमवाप्नोति द्रौणिः पापस्य कर्मणः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2177547, "chapter_id": 4748, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2177548, "chapter_id": 4748, "verse_number": "२९", "content_sanskrit": "एवमुक्त्वा ततः कृष्णा पाण्डवं समुपाविशत् ।\nयुधिष्ठिरं धर्मपत्नी याज्ञसेनी यशस्विनी\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2177549, "chapter_id": 4748, "verse_number": "३०", "content_sanskrit": "दृष्ट्वोपविष्टां राजा तु पाण्डवो महिषीं प्रियाम् ।\nप्रत्युवाच स धर्मात्मा द्रौपदीं चारुदर्शनाम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2177550, "chapter_id": 4748, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2177551, "chapter_id": 4748, "verse_number": "३१", "content_sanskrit": "क्षत्रधर्मेण धर्मज्ञे प्राप्तास्ते निधनं शुभे ।\nपुत्रास्ते भ्रातरश्चैव तान् न शोचितुमर्हसि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2177552, "chapter_id": 4748, "verse_number": "३२", "content_sanskrit": "द्रोणपुत्रस्तु कल्याणि वनदुर्गं गतो ध्रुवम् ।\nतस्य त्वं पातनं सङ्खे कथं ज्ञास्यसि शोभने\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2177553, "chapter_id": 4748, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2177554, "chapter_id": 4748, "verse_number": "३३", "content_sanskrit": "द्रोणपुत्रस्य सहजो मणिः शिरसि मे श्रुतः ।\nनिहत्य सङ्खे तं पापं पश्येयं मणिमाहृतम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2177555, "chapter_id": 4748, "verse_number": "३४", "content_sanskrit": "द्रौणेः शिरस उत्कृत्तं जीवेयमिति मे मतिः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2177556, "chapter_id": 4748, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2177557, "chapter_id": 4748, "verse_number": "३५", "content_sanskrit": "इत्युक्त्वा पाण्डवं कृष्णा राजानं चारुदर्शना ।\nभीमसेनं करे स्पृष्ट्वा कुपिता वाक्यमब्रवीत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2177558, "chapter_id": 4748, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2177559, "chapter_id": 4748, "verse_number": "३६", "content_sanskrit": "त्रातुमर्हसि मां भीम क्षत्रधर्ममनुस्मरन् ।\nजहि तं पापकर्माणं शम्बरं मघवानिव\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2177560, "chapter_id": 4748, "verse_number": "३७", "content_sanskrit": "न हि ते विक्रमे तुल्यः पुमानस्तीह कश्चन ।\nश्रुतं तत् सर्वलोकेषु परमव्यसने तथा\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2177561, "chapter_id": 4748, "verse_number": "३८", "content_sanskrit": "द्वीपोऽभूस्त्वं हि पार्थानां नगरे वारणावते ।\nहिडिम्बदर्शने चैव तथा त्वमभवो गतिः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2177562, "chapter_id": 4748, "verse_number": "३९", "content_sanskrit": "तथा विराटनगरे कीचकेन भृशार्दितम् ।\nमामप्युद्धृतवान् कृच्छ्रात् पौलोमीं मघवानिव\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2177563, "chapter_id": 4748, "verse_number": "४०", "content_sanskrit": "यथैतान्यकृथाः पार्थ महाकर्माणि वै पुरा ।\nतथा द्रौणिममित्रघ्नं विनिहत्य सुखी भव\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2177564, "chapter_id": 4748, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2177565, "chapter_id": 4748, "verse_number": "४१", "content_sanskrit": "तस्या बहुविधं दुःखं निशम्य परिदेवितुम् ।\nनामर्षयत कौन्तेयो भीमसेनो महाबलः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2177566, "chapter_id": 4748, "verse_number": "४२", "content_sanskrit": "स काञ्चनविचित्राङ्गमारुरोह रथोत्तमम् ।\nआदाय रुचिरं चित्रं समार्गणगुणं धनुः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2177567, "chapter_id": 4748, "verse_number": "४३", "content_sanskrit": "नकुलं सारथिं कृत्वा द्रोणपुत्रवधे धृतः ।\nविष्फार्य सशरं चापं तूर्णमश्वानचोदयत्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2177568, "chapter_id": 4748, "verse_number": "४४", "content_sanskrit": "ते हयाः पुरुषव्याघ्र चोदिता वातरंहसः ।\nवेगेन सहसा जग्मुर्हरयः शीघ्रगामिनः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2177569, "chapter_id": 4748, "verse_number": "४५", "content_sanskrit": "शिबिरात् स गृहीत्वा तु रथस्य पदमच्युतः ।\nद्रोणपुत्रगतेनाशु ययौ मार्गेण भारत\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2177570, "chapter_id": 4748, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nऐषीकपर्वणि द्रौपदीप्रायोप्रवेशो नाम द्वितीयोऽध्यायः ॥२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]