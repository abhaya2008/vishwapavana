[{"id": 2108425, "chapter_id": 3347, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108426, "chapter_id": 3347, "verse_number": "१", "content_sanskrit": "अपराधो महेन्द्रस्य कः प्रमादश्च सूतज ।\nतपसा वालखिल्यानां  सम्भूतो गरुडः कथम्\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108427, "chapter_id": 3347, "verse_number": "२", "content_sanskrit": "काश्यपस्य द्विजातेश्च कथं वै पक्षिराट् सुतः ।\nअधृष्यः सर्वभूतानामवध्यश्चाभवत् कथम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108428, "chapter_id": 3347, "verse_number": "३", "content_sanskrit": "कथं च कामरूपी स कामवीर्यश्च खेचरः ।\nएतदिच्छाम्यहं श्रोतुं पुराणे यदि पठ्यते\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108429, "chapter_id": 3347, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108430, "chapter_id": 3347, "verse_number": "४", "content_sanskrit": "विषयोऽयं पुराणस्य यन्मां त्वं परिपृच्छसि ।\nशृणु मे वदतः सर्वमेतत् सङ्क्षेपतो द्विज \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108431, "chapter_id": 3347, "verse_number": "५", "content_sanskrit": "यजतः पुत्रकामस्य काश्यपस्य प्रजापतेः ।\nसाहाय्यमृषयो देवा गन्धर्वाश्च ददुः किल \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108432, "chapter_id": 3347, "verse_number": "६", "content_sanskrit": "तत्रेध्मानयने शक्रो नियुक्तः काश्यपेन हि ।\nमुनयो वालखिल्याश्च ये चान्ये देवतागणाः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108433, "chapter_id": 3347, "verse_number": "७", "content_sanskrit": "शक्रस्तु वीर्यसदृशमिध्मभारं गिरिप्रभम् ।\nसमुद्यम्यानयामास नातिकृच्छ्रादिव प्रभुः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108434, "chapter_id": 3347, "verse_number": "८", "content_sanskrit": "अथापश्यदृषीन् सर्वान् ह्रस्वानङ्गुष्ठमात्रकान् ।\nपालाशवृन्तिकामेकां वहतः सहितान् पथि\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108435, "chapter_id": 3347, "verse_number": "९", "content_sanskrit": "प्रलीनान् स्वेषु चाङ्गेषु निराहारांस्तपोधनान् ।\nक्लिश्यमानान् मृदुबलान् गोष्पदे सम्प्लुतोदके \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108436, "chapter_id": 3347, "verse_number": "१०", "content_sanskrit": "तान् सर्वान् विस्मयाविष्टो वीर्यमत्तः पुरन्दरः ।\nअपहस्याभ्यगाच्छीघ्रं लङ्घयित्वाऽवमत्य च \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108437, "chapter_id": 3347, "verse_number": "११", "content_sanskrit": "ते तु रोषसमाविष्टा सुभृशं जातमन्यवः ।\nआरेभिरे महत्कर्म तदा शक्रभयङ्करम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108438, "chapter_id": 3347, "verse_number": "११", "content_sanskrit": "जुहुवुस्ते सुतपसो विधिवज्जातवेदसि ।\nमन्त्रैरुच्चावचैर्विप्रा येन कामेन तच्छ्रुणु \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108439, "chapter_id": 3347, "verse_number": "१२", "content_sanskrit": "कामवीर्यः कामवेगो देवराजभयप्रदः ।\nइन्द्रोऽन्यः सर्वभूतानां भवेदिति यतव्रताः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108440, "chapter_id": 3347, "verse_number": "१३", "content_sanskrit": "इन्द्राच्छतगुणो वीर्ये शौर्ये चैव मनोजवः ।\nतपसो नः फलेनाद्य दारुणः सम्भवत्विति \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108441, "chapter_id": 3347, "verse_number": "१४", "content_sanskrit": "तच्छ्रुत्वा भृशसंविग्नो देवराजः पुरन्दरः  ।\nजगाम शरणं तत्र काश्यपं संशितव्रतम्\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108442, "chapter_id": 3347, "verse_number": "१५", "content_sanskrit": "तच्छ्रुत्वा देवराजस्य काश्यपोऽथ प्रजापतिः ।\nवालखिल्यानुपागम्य कर्मसिद्धिमपृच्छत \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108443, "chapter_id": 3347, "verse_number": "१६", "content_sanskrit": "एवमस्त्विति तं चापि प्रत्यूचुः सत्यवादिनः ।\nतान् काश्यप उवाचेदं सान्त्वपूर्वं प्रजापतिः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108444, "chapter_id": 3347, "verse_number": "१७", "content_sanskrit": "अयमिन्द्रस्त्रिभुवने नियोगाद् ब्रह्मणः कृतः ।\nइन्द्रार्थं च भवन्तोऽपि यत्नवन्तस्तपोधनाः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108445, "chapter_id": 3347, "verse_number": "१८", "content_sanskrit": "न मिथ्यां ब्रह्मणो वाक्यं कर्तुमर्हथ सत्तमाः ।\nभवतां च न मिथ्याऽयं सङ्कल्पो विचिकीर्षितः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108446, "chapter_id": 3347, "verse_number": "१९", "content_sanskrit": "भवत्वेष पतत्रीणामिन्द्रोऽतिबलविक्रमः  ।\nप्रसादः क्रियतां चैव देवराजाय याचते \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108447, "chapter_id": 3347, "verse_number": "२०", "content_sanskrit": "एवमुक्ताः काश्यपेन वालखिल्यास्तपस्विनः ।\nप्रत्यूचुरभिसम्पूज्य मुनिश्रेष्ठं प्रजापतिम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108448, "chapter_id": 3347, "verse_number": "", "content_sanskrit": "वालखिल्याः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108449, "chapter_id": 3347, "verse_number": "२१", "content_sanskrit": "इन्द्रार्थोऽयं समारम्भः सर्वेषां नः प्रजापते ।\nअपत्यार्थं समारम्भो भवतश्चायमीप्सितः\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108450, "chapter_id": 3347, "verse_number": "२२", "content_sanskrit": "तदिदं सकलं कर्म त्वया वै प्रतिगृह्यताम् ।\nतथा चैवं विधत्स्वात्र यथा श्रेयोऽनुपश्यसि\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108451, "chapter_id": 3347, "verse_number": "२३", "content_sanskrit": "एतस्मिन्नेव काले तु देवी दाक्षायणी शुभा ।\nविनता नाम कल्याणी पुत्रकामा यशस्विनी\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108452, "chapter_id": 3347, "verse_number": "२४", "content_sanskrit": "तपस्तप्त्वा व्रतपरा स्नाता पुंसवने शुचिः ।\nउपचक्राम भर्तारं तामुवाचाथ काश्यपः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2108453, "chapter_id": 3347, "verse_number": "२५", "content_sanskrit": "आरम्भः सफलो देवि भविताऽयं तवेप्सितः ।\nजनयिष्यसि पुत्रौ द्वौ वीरौ त्रिभुवनेश्वरौ \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2108454, "chapter_id": 3347, "verse_number": "२६", "content_sanskrit": "तपसा वालखिल्यानां मम सङ्कल्पजौ तथा ।\nभविष्यतो महाभागौ पुत्रौ ते लोकपूजितौ \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2108455, "chapter_id": 3347, "verse_number": "२७", "content_sanskrit": "उवाच चैनां भगवान् मारीचः पुनरेव ह ।\nधार्यतामप्रमादेन गर्भोऽयं सुमहोदयः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2108456, "chapter_id": 3347, "verse_number": "२८", "content_sanskrit": "एतौ सर्वपतत्रीणामिन्द्रत्वं कारयिष्यतः ।\nलोकसम्भावितौ वीरौ कामवीर्यौ विहङ्गमौ  \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2108457, "chapter_id": 3347, "verse_number": "२९", "content_sanskrit": "शतक्रतुमथोवाच प्रीयमाणः प्रजापतिः ।\nत्वत्सहायौ सखायौ तौ खगावेतौ भविष्यतः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2108458, "chapter_id": 3347, "verse_number": "३०", "content_sanskrit": "नैताभ्यां भविता दोषः सकाशात् ते पुरन्दर ।\nव्येतु ते शक्र सन्तापस्त्वमेवेन्द्रो भविष्यसि \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2108459, "chapter_id": 3347, "verse_number": "३१", "content_sanskrit": "न चाप्येवं त्वया भूयः क्षेप्तव्या ब्रह्मवादिनः ।\nन चावमान्या दर्पात् ते वाग्विषा भृशकोपनाः\t ॥ ३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2108460, "chapter_id": 3347, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2108461, "chapter_id": 3347, "verse_number": "३२", "content_sanskrit": "एवमुक्तो जगामेन्द्रो निर्विशङ्कस्त्रिविष्टपम् ।\nविनता चापि सिद्धार्था बभूव मुदिता तदा\t ॥ ३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2108462, "chapter_id": 3347, "verse_number": "३३", "content_sanskrit": "जनयामास पुत्रौ द्वावरुणं गरुडं तथा ।\nविकलाङ्गोऽरुणस्तत्र आदित्यस्य पुरस्सरः\t ॥ ३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2108463, "chapter_id": 3347, "verse_number": "३४", "content_sanskrit": "पतत्रिणां तु गरुड इन्द्रत्वेनाभ्यषिच्यत ।\nतस्यैतत् सुमहत्कर्म श्रूयतां भृगुनन्दन \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2108464, "chapter_id": 3347, "verse_number": "१४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि षड्विंशोऽध्यायः ॥२६॥ ॥ आस्तीकपर्वणि चतुर्दशोऽध्यायः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]