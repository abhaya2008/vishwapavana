[{"id": 2099632, "chapter_id": 3132, "verse_number": "१३-२६२-१", "content_sanskrit": "भीष्म उवाच।\nतूष्णीमासीदर्जुनस्तु पवनस्त्वब्रवीत्पुनः।\nशृणु मे ब्राह्मणेष्वेव मुख्यं कर्म जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099633, "chapter_id": 3132, "verse_number": "१३-२६२-२", "content_sanskrit": "मदस्यास्यमनुप्राप्ता यदा सेन्द्रा दिवौकसः।\nतदैव च्यवनेन द्यौर्हृता तेषां वसुन्धरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099634, "chapter_id": 3132, "verse_number": "१३-२६२-३", "content_sanskrit": "उभौ लोकौ हृतौ मत्वा ते देवा दुःखिताऽभवन्।\nशोकार्ताश्त महात्मानं ब्रह्माणं शरणं ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099635, "chapter_id": 3132, "verse_number": "१३-२६२-४x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099636, "chapter_id": 3132, "verse_number": "१३-२६२-४", "content_sanskrit": "मदास्यव्यतिषिक्तानामस्माकं लोकपूजित।\nच्यवनेन हृता भूमिः कपैश्चैव दिवं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099637, "chapter_id": 3132, "verse_number": "१३-२६२-५x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099638, "chapter_id": 3132, "verse_number": "१३-२६२-५", "content_sanskrit": "गच्छध्वं शरणं विप्रानाशु सेन्द्रा दिवौकसः।\nप्रसाद्य तानुभौ लोकाववाप्स्यथ यथापुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099639, "chapter_id": 3132, "verse_number": "१३-२६२-६", "content_sanskrit": "ते ययुः शरणं विप्रानूचुस्ते काञ्जयामहे।\nइत्युक्तास्ते द्विजान्प्राहुर्जयतेह कपानिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099640, "chapter_id": 3132, "verse_number": "१३-२६२-७", "content_sanskrit": "भूगतान्हि विजेतारो वयमित्यब्रुवन्द्विजाः।\nततः कर्म समारब्धं ब्राह्मणैः कपनाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099641, "chapter_id": 3132, "verse_number": "१३-२६२-८", "content_sanskrit": "तच्छ्रुत्वा प्रेषितो दूतो ब्राह्मणेभ्यो धनी कपैः।\nस च तान्ब्राह्मणानाह धनी कपवचो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099642, "chapter_id": 3132, "verse_number": "१३-२६२-९", "content_sanskrit": "भवद्भिः सदृशः सर्वे कपाः किमिह वर्तते।\nसर्वे वेदविदः प्राज्ञाः सर्वे च क्रतुयाजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099643, "chapter_id": 3132, "verse_number": "१३-२६२-१०", "content_sanskrit": "सर्वे सत्यव्रताश्चैव सर्वे तुल्या महर्षिभिः।\nश्रीश्चैव रमते तेषु धारयन्ति श्रियं च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099644, "chapter_id": 3132, "verse_number": "१३-२६२-११", "content_sanskrit": "वृथा दारान्न गच्छन्ति वृथा मांसं न भुञ्जते।\nदीप्तमग्निं जुह्वते च गुरूणां वचने स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099645, "chapter_id": 3132, "verse_number": "१३-२६२-१२", "content_sanskrit": "सर्वे च नियतात्मानो बालानां संविभागिनः।\nउपेत्य शनकैर्यान्ति न सेवन्ति रजस्वलाम्।\nस्वर्गातिं चैव गच्छन्ति तथैव शुभकर्मिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099646, "chapter_id": 3132, "verse_number": "१३-२६२-१३", "content_sanskrit": "अभुक्तवत्सु नाश्नन्ति गर्भिणीवृद्धकादिषु।\nपूर्वाह्णेषु न दीव्यन्ति दिवा चैव न शेरते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099647, "chapter_id": 3132, "verse_number": "१३-२६२-१४", "content_sanskrit": "एतैश्चान्यैश्च बहुभिर्गुणैर्युक्तान्कथं कपान्।\nविजेष्यथ निवर्तध्वं निवृत्तानां सुखं हि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099648, "chapter_id": 3132, "verse_number": "१३-२६२-१५x", "content_sanskrit": "ब्राह्मणा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099649, "chapter_id": 3132, "verse_number": "१३-२६२-१५", "content_sanskrit": "कपान्वयं विजेष्यामो ये देवास्ते वयं स्मृताः।\nतस्माद्वध्याः कपाऽस्माकं धनिन्याहि यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099650, "chapter_id": 3132, "verse_number": "१३-२६२-१६", "content_sanskrit": "धनी गत्वा कपानाह न वो विप्राः प्रियङ्कराः।\nगृहीत्वाऽस्त्राण्यतो विप्रान्कपाः सर्वे समाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099651, "chapter_id": 3132, "verse_number": "१३-२६२-१७", "content_sanskrit": "समुदग्रध्वजान्दृष्ट्वा कपान्सर्वे द्विजातयः।\nव्यसृजञ्ज्वलितानग्नीन्कपानां प्राणनाशनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2099652, "chapter_id": 3132, "verse_number": "१३-२६२-१८", "content_sanskrit": "ब्रह्मसृष्टा हव्यभुजः कपान्हत्वा सनातनाः।\nनभसीव यथाऽभ्राणि व्यराजन्त नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2099653, "chapter_id": 3132, "verse_number": "१३-२६२-१९", "content_sanskrit": "हत्वा वै दानवान्देवाः सर्वे सम्भूय संयुगे।\nते नाभ्यजानन्हि तदा ब्राह्मणैर्निहतान्कपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2099654, "chapter_id": 3132, "verse_number": "१३-२६२-२०", "content_sanskrit": "अथागम्य महातेजा नारदोऽकथयद्विभो।\nयथा हता महाभागैस्तेजसा ब्राह्मणैः कपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2099655, "chapter_id": 3132, "verse_number": "१३-२६२-२१", "content_sanskrit": "नारदस्य वचः श्रुत्वा प्रीताः सर्वे दिवौकसः।\nप्रशशंसुर्द्विजांश्चापि ब्राह्मणांश्च यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2099656, "chapter_id": 3132, "verse_number": "१३-२६२-२२", "content_sanskrit": "तेषां तेजस्तथा वीर्यं देवानां ववृधे ततः।\nअवाप्नुवंश्चामरत्वं त्रिषु लोकेषु पूजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2099657, "chapter_id": 3132, "verse_number": "१३-२६२-२३", "content_sanskrit": "इत्युक्तवचनं वायुमर्जुनः प्रत्युवाच ह।\nप्रतिपूज्य महाबाहो यत्तच्छृणु नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2099658, "chapter_id": 3132, "verse_number": "१३-२६२-२४x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2099659, "chapter_id": 3132, "verse_number": "१३-२६२-२४", "content_sanskrit": "जीवाम्यहं ब्राह्मणार्थं सर्वथा सततं प्रभो।\nब्रह्मण्यो ब्राह्मणेभ्यश्च प्रणमामि च नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2099660, "chapter_id": 3132, "verse_number": "१३-२६२-२५", "content_sanskrit": "दत्तात्रेयप्रसादाच्च मया प्राप्तमिदं बलम्।\nलोके च परमा कीर्तिर्धर्मश्चाचरितो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2099661, "chapter_id": 3132, "verse_number": "१३-२६२-२६", "content_sanskrit": "अहो ब्राह्मणकर्माणि मयि मारुत तत्त्वतः।\nत्वया प्रोक्तानि कार्त्स्न्येन श्रुतानि प्रयतेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2099662, "chapter_id": 3132, "verse_number": "१३-२६२-२७x", "content_sanskrit": "वायुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2099663, "chapter_id": 3132, "verse_number": "१३-२६२-२७", "content_sanskrit": "ब्राह्मणान्क्षात्राधर्मेण पालयस्वेन्द्रियाणि च।\nविप्रेभ्यस्ते भयं घोरं तत्तु कालाद्भविष्यति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2099664, "chapter_id": 3132, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्विषष्ट्यधिकद्विशततमोऽध्यायः॥ २६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]