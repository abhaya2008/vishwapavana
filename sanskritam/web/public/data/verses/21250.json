[{"id": 7001250000, "chapter_id": 21250, "verse_number": "२-५-२३-१", "content_sanskrit": "उपमन्युरुवाच ।\nव्याख्यां पूजाविधानस्य प्रवदामि समासतः ।\nशिवशास्त्रे शिवेनैव शिवायै कथितस्य तु॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001250001, "chapter_id": 21250, "verse_number": "२-५-२३-२", "content_sanskrit": "अंगमभ्यंतरं यागमग्निकार्यावसानकम् ।\nविधाय वा न वा पश्चाद्बहिर्यागं समाचरेत्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001250002, "chapter_id": 21250, "verse_number": "२-५-२३-३", "content_sanskrit": "तत्र द्रव्याणि मनसा कल्पयित्वा विशोध्य च ।\nध्यात्वा विनायकं देवं पूजयित्वा विधानतः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001250003, "chapter_id": 21250, "verse_number": "२-५-२३-४", "content_sanskrit": "दक्षिणे चोत्तरे चैव नंदीशं सुयशं तथा ।\nआराध्य मनसा सम्यगासनं कल्पयेद्बुधः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001250004, "chapter_id": 21250, "verse_number": "२-५-२३-५", "content_sanskrit": "आराधनादिकैर्युक्तस्सिंहयोगासनादिकम् ।\nपद्मासनं वा विमलं तत्त्वत्रयसमन्वितम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001250005, "chapter_id": 21250, "verse_number": "२-५-२३-६", "content_sanskrit": "तस्योपरि शिवं ध्यायेत्सांबं सर्वमनोहरम् ।\nसर्वलक्षणसंपन्नं सर्वावयवशोभनम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001250006, "chapter_id": 21250, "verse_number": "२-५-२३-७", "content_sanskrit": "सर्वातिशयसंयुक्तं सर्वाभरणभूषितम् ।\nरक्तास्यपाणिचरणं कुंदचंद्रस्मिताननम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001250007, "chapter_id": 21250, "verse_number": "२-५-२३-८", "content_sanskrit": "शुद्धस्फटिकसंकाशं फुल्लपद्मत्रिलोचनम् ।\nचतुर्भुजमुदाराङ्गं चारुचंद्रकलाधरम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001250008, "chapter_id": 21250, "verse_number": "२-५-२३-९", "content_sanskrit": "वरदाभयहस्तं च मृगटंकधरं हरम् ।\nभुजंगहारवलयं चारुनीलगलांतरम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001250009, "chapter_id": 21250, "verse_number": "२-५-२३-१०", "content_sanskrit": "सर्वोपमानरहितं सानुगं सपरिच्छदम् ।\nततः संचिंतयेत्तस्य वामभागे महेश्वरीम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001250010, "chapter_id": 21250, "verse_number": "२-५-२३-११", "content_sanskrit": "प्रफुल्लोत्पलपत्राभां विस्तीर्णायतलोचनाम् ।\nपूर्णचंद्राभवदनां नीलकुंचितमूर्धजाम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001250011, "chapter_id": 21250, "verse_number": "२-५-२३-१२", "content_sanskrit": "नीलोत्पलदलप्रख्यां चन्द्रार्धकृतशेखराम् ।\nअतिवृत्तघनोत्तुंगस्निग्धपीनपयोधराम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001250012, "chapter_id": 21250, "verse_number": "२-५-२३-१३", "content_sanskrit": "तनुमध्यां पृथुश्रोणीं पीतसूक्ष्मवराम्बराम् ।\nसर्वाभरणसंपन्नां ललाटतिलकोज्ज्वलाम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001250013, "chapter_id": 21250, "verse_number": "२-५-२३-१४", "content_sanskrit": "विचित्रपुष्पसंकीर्णकेशपाशोपशोभिताम् ।\nसर्वतो ऽनुगुणाकारां किंचिल्लज्जानताननाम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001250014, "chapter_id": 21250, "verse_number": "२-५-२३-१५", "content_sanskrit": "हेमारविंदं विलसद्दधानां दक्षिणे करे ।\nदंडवच्चापरं हस्ते न्यस्यासीनां महासने॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001250015, "chapter_id": 21250, "verse_number": "२-५-२३-१६", "content_sanskrit": "पाशविच्छेदिकां साक्षात्सच्चिदानंदरूपिणीम् ।\nएवं देवं च देवीं च ध्यात्वासनवरे शुभे॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001250016, "chapter_id": 21250, "verse_number": "२-५-२३-१७", "content_sanskrit": "सर्वोपचारवद्भक्त्या भावपुष्पैस्समर्चयेत् ।\nअथवा परिकल्प्यैवं मूर्तिमन्यतमां विभोः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001250017, "chapter_id": 21250, "verse_number": "२-५-२३-१८", "content_sanskrit": "शैवीं सदाशिवाख्यां वा तथा माहेश्वरीं पराम् ।\nषड्विंशकाभिधानां वा श्रीकंठाख्यामथापि वा॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001250018, "chapter_id": 21250, "verse_number": "२-५-२३-१९", "content_sanskrit": "मन्त्रन्यासादिकां चापि कृत्वा स्वस्यां तनौ यथा ।\nअस्यां मूर्तौ मूर्तिमंतं शिवं सदसतः परम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001250019, "chapter_id": 21250, "verse_number": "२-५-२३-२०", "content_sanskrit": "ध्यात्वा बाह्यक्रमेणैव पूजां निर्वर्तयेद्धिया ।\nसमिदाज्यादिभिः पश्चान्नाभौ होमं च भावयेत्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001250020, "chapter_id": 21250, "verse_number": "२-५-२३-२१", "content_sanskrit": "भ्रूमध्ये च शिवं ध्यायेच्छुद्धदीपशिखाकृतिम् ।\nइत्थमंगे स्वतंत्रे वा योगे ध्यानमये शुभे॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001250021, "chapter_id": 21250, "verse_number": "२-५-२३-२२", "content_sanskrit": "अग्निकार्यावसानं च सर्वत्रैव समो विधिः ।\nअथ चिंतामयं सर्वं समाप्याराधनक्रमम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001250022, "chapter_id": 21250, "verse_number": "२-५-२३-२३", "content_sanskrit": "लिंगे च पूजयेद्देवं स्थंडिले वानले ऽपि वा॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]