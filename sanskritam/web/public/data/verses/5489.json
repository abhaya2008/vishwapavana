[{"id": 2209887, "chapter_id": 5489, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209888, "chapter_id": 5489, "verse_number": "१", "content_sanskrit": "किमागमनकृत्यं ते कौरव्यकुलनन्दिनि ।\nमणलूरपतेर्मातुस्तथैव च रणाजिरे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209889, "chapter_id": 5489, "verse_number": "२", "content_sanskrit": "कच्चित् कुशलकामाऽसि राज्ञोऽस्य भुजगात्मजे ।\nमम वा चञ्चलापाङ्गे कच्चित् त्वं सुखमिच्छसि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209890, "chapter_id": 5489, "verse_number": "३", "content_sanskrit": "कच्चित् ते पृथुलश्रोणि नाप्रियं शुभदर्शने ।\nअकार्षमहमज्ञानाद् अयं वा बभ्रुवाहनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209891, "chapter_id": 5489, "verse_number": "४", "content_sanskrit": "कच्चिच्च राजपुत्री ते सपत्नी चैत्रवाहनी ।\nचित्राङ्गदा वरारोहा नापराध्यति किञ्चन ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209892, "chapter_id": 5489, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209893, "chapter_id": 5489, "verse_number": "५", "content_sanskrit": "तमुवाचोरगपतेर्दुहिता प्रहसन्त्यथ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209894, "chapter_id": 5489, "verse_number": "", "content_sanskrit": "उलूपी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209895, "chapter_id": 5489, "verse_number": "६", "content_sanskrit": "न मे त्वमपराद्धोऽसि न नृपो बभ्रुवाहनः ।\nन जनित्री तथाऽस्येयं मम या प्रेष्यवत् स्थिता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209896, "chapter_id": 5489, "verse_number": "७", "content_sanskrit": "श्रूयतां यद् यथा चेदं मया सर्वं विचेष्टितम् ।\nन मे कोपस्त्वया कार्यः शिरसा त्वां प्रसादये ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209897, "chapter_id": 5489, "verse_number": "८", "content_sanskrit": "त्वत्प्रीत्यर्थं हि कौरव्य कृतमेतन्मयाऽनघ ।\nयत् तच्छृणु महाबाहो निखिलेन धनञ्जय ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209898, "chapter_id": 5489, "verse_number": "९", "content_sanskrit": "महाभारतयुद्धे यत् त्वया शान्तनवो नृपः ।\nअधर्मेण हतः पार्थ तस्यैषा निष्कृतिः कृता ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209899, "chapter_id": 5489, "verse_number": "१०", "content_sanskrit": "न हि भीष्मस्त्वया वीर युद्ध्यमानो निपातितः ।\nशिखण्डिना तु संसक्तस्तमाश्रित्य हतस्त्वया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209900, "chapter_id": 5489, "verse_number": "११", "content_sanskrit": "तस्य शान्तिमकृत्वा तु त्यजेस्त्वं यदि जीवितम् ।\nकर्मणा तेन पापेन पतेथा निरये ध्रुवम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209901, "chapter_id": 5489, "verse_number": "१२", "content_sanskrit": "एषाऽत्र विहिता शान्तिः पुत्रात् त्वं प्राप्तवानसि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209902, "chapter_id": 5489, "verse_number": "१३", "content_sanskrit": "वसुभिर्वसुधापाल गङ्गया च महामते ।\nपुरा हि श्रुतमेतद् वै वसुभिः कथितं मम ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209903, "chapter_id": 5489, "verse_number": "१४", "content_sanskrit": "गङ्गायास्तीरमागम्य हते शान्तनवे नृप ।\nआप्लुत्य देवा वसवः समाप्लुत्य महानदीम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209904, "chapter_id": 5489, "verse_number": "१५", "content_sanskrit": "इदमूचुर्वचो घोरं भागीरथ्या मते तदा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209905, "chapter_id": 5489, "verse_number": "१६", "content_sanskrit": "एष शान्तनवो भीष्मो निहतः सव्यसाचिना ।\nअयुद्ध्यमानः सङ्ग्रामे संसक्तोऽन्येन भामिनि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209906, "chapter_id": 5489, "verse_number": "१७", "content_sanskrit": "तदनेनाभिषङ्गेण वयमप्यर्जुनं शुभे ।\nशापेन योजयामेति तथाऽस्त्विति च साऽब्रवीत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209907, "chapter_id": 5489, "verse_number": "१८", "content_sanskrit": "तदहं पितुरावेद्य भृशं प्रव्यथितेन्द्रिया ।\nअभवं स च तच्छ्रुत्वा विषादमगमत् परम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209908, "chapter_id": 5489, "verse_number": "१९", "content_sanskrit": "पिता तु मे वसून् गत्वा त्वदर्थं समयाचत ।\nपुनः पुनः प्रसाद्यैनान् त एनमिदमब्रुवन् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209909, "chapter_id": 5489, "verse_number": "२०", "content_sanskrit": "‘पुत्रोऽस्य तु महाराजो मणलूरेश्वरो युवा ।\nस एनं रणमध्यस्थं शरैः पातयिता भुवि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209910, "chapter_id": 5489, "verse_number": "२१", "content_sanskrit": "एवं कृते स नागेन्द्र मुक्तशापो भविष्यति ।\nगच्छेति वसुभिश्चोक्तो मम चेदं शशंस सः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209911, "chapter_id": 5489, "verse_number": "२२", "content_sanskrit": "तच्छ्रुत्वा त्वं मया तस्मात् शापादसि विमोक्षितः ।\nन हि त्वां देवराजोऽपि समरेषु पराजयेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209912, "chapter_id": 5489, "verse_number": "२३", "content_sanskrit": "आत्मा पुत्रः स्मृतस्तस्मात् तेनेहासि पराजितः ।\nनात्र दोषो मम मतः कथं वा मन्यसे विभो ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209913, "chapter_id": 5489, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209914, "chapter_id": 5489, "verse_number": "२४", "content_sanskrit": "इत्येवमुक्तो विजयः प्रसन्नात्माऽब्रवीदिदम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209915, "chapter_id": 5489, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209916, "chapter_id": 5489, "verse_number": "२५", "content_sanskrit": "सर्वं मे सुप्रियं देवि यदेतत् कृतवत्यसि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2209917, "chapter_id": 5489, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2209918, "chapter_id": 5489, "verse_number": "२६", "content_sanskrit": "इत्युक्त्वा सोऽब्रवीत् पुत्रं मणलूरेश्वरं जयः ।\nचित्राङ्गदायाः शृण्वन्त्याः कौरव्यदुहितुस्तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2209919, "chapter_id": 5489, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2209920, "chapter_id": 5489, "verse_number": "२७", "content_sanskrit": "युधिष्ठिरस्याश्वमेधः परश्चैत्र्यां भविष्यति ।\nतत्रागच्छेः सहामात्यो मातृभ्यां सहितो नृप ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2209921, "chapter_id": 5489, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2209922, "chapter_id": 5489, "verse_number": "२८", "content_sanskrit": "इत्येवमुक्तः पार्थेन स राजा बभ्रुवाहनः ।\nउवाच पितरं धीमान् इदमस्राविलेक्षणः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2209923, "chapter_id": 5489, "verse_number": "", "content_sanskrit": "बभ्रुवाहनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2209924, "chapter_id": 5489, "verse_number": "२९", "content_sanskrit": "उपयास्यामि धर्मज्ञ भवतः शासनादहम् ।\nअश्वमेधमहायज्ञे द्विजातिपरिवेषकः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2209925, "chapter_id": 5489, "verse_number": "३०", "content_sanskrit": "मम त्वनुग्रहार्थं हि प्रविशस्व पुरं स्वकम् ।\nभार्याभ्यां सह शत्रुघ्न मा भूत् तेऽत्र विचारणा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2209926, "chapter_id": 5489, "verse_number": "३१", "content_sanskrit": "उषित्वा च विशल्यस्त्वं सुखं वेश्मनि च प्रभो ।\nपुनरश्वानुगमनं कर्तासि जयतां वर ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2209927, "chapter_id": 5489, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2209928, "chapter_id": 5489, "verse_number": "३२", "content_sanskrit": "इत्युक्तः स तु पुत्रेण तदा वानरकेतनः ।\nहसन् प्रोवाच कौन्तेयस्तदा चित्राङ्गदासुतम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2209929, "chapter_id": 5489, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2209930, "chapter_id": 5489, "verse_number": "३३", "content_sanskrit": "विदितं ते महाबाहो यथा दीक्षां चराम्यहम् ।\nन हि तावत् प्रवेक्ष्यामि पुरं ते पृथुलोचन ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2209931, "chapter_id": 5489, "verse_number": "३४", "content_sanskrit": "यथाकामं प्रयात्वेष याज्ञियश्च तुरङ्गमः ।\nस्वस्ति तेऽस्तु गमिष्यामि न स्थानं विद्यते मम ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2209932, "chapter_id": 5489, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2209933, "chapter_id": 5489, "verse_number": "३५", "content_sanskrit": "स तत्र विधिवत् तेन पूजितः पाकशासनिः ।\nभार्याभ्यामभ्यनुज्ञातः प्रायाद् भरतसत्तमः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2209934, "chapter_id": 5489, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अश्वसम्भरणे अर्जुनसत्कारो नाम त्र्यशीतितमोऽध्यायः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]