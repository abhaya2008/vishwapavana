[{"id": 900002240, "chapter_id": 8260, "verse_number": "5.1", "content_sanskrit": "असौ वा आदित्यो देवमधु ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900002241, "chapter_id": 8260, "verse_number": "5.2", "content_sanskrit": "तस्य ये प्राञ्चो रश्मयस्ता एवास्य प्राच्यो मधुनाड्य ऋच एव..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900002242, "chapter_id": 8260, "verse_number": "5.3", "content_sanskrit": "अथ येऽस्य दक्षिणा रश्मयस्ता एवास्य दक्षिणा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900002243, "chapter_id": 8260, "verse_number": "5.4", "content_sanskrit": "अथ येऽस्य प्रत्यञ्चो रश्मयस्ता एवास्य प्रतीच्यो मधुनाड्यः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900002244, "chapter_id": 8260, "verse_number": "5.5", "content_sanskrit": "अथ येऽस्य प्रत्यञ्चो रश्मयस्ता एवास्य प्रतीच्यो मधुनाड्यः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900002245, "chapter_id": 8260, "verse_number": "5.6", "content_sanskrit": "अथ येऽस्योर्ध्वा रश्मयस्ता एवास्योर्ध्वा मधुनाड्यो गुह्या ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900002246, "chapter_id": 8260, "verse_number": "5.7", "content_sanskrit": "ऋग्वेदादिस्तु ते देवा अग्याद्याः संव्यचारयन्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900002247, "chapter_id": 8260, "verse_number": "5.8", "content_sanskrit": "संस्थितः सूर्यमण्डले", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900002248, "chapter_id": 8260, "verse_number": "5.9", "content_sanskrit": "न चाचेतनमात्रमुपासितं पुरुषार्थप्रदानशक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900002249, "chapter_id": 8260, "verse_number": "5.10", "content_sanskrit": "यशस्तेजइन्द्रियवीर्यात्राद्यरसत्वं च भगवन्तं विना कस्य मुख्यतो युज्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900002250, "chapter_id": 8260, "verse_number": "5.11", "content_sanskrit": "न चाचेतनस्यैश्वर्यादिरूपत्वं युज्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900002251, "chapter_id": 8260, "verse_number": "5.12", "content_sanskrit": "उपनिषत्त्वाच्च विशेषतो न यत्किञ्चिदुच्यत इति वक्तुं युक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900002252, "chapter_id": 8260, "verse_number": "5.13", "content_sanskrit": "'यस्यां न मे पावनमङ्ग कर्म स्थित्युद्भवत्राणनिरोधमस्य", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900002253, "chapter_id": 8260, "verse_number": "5.14", "content_sanskrit": "तद् यत् प्रथमममृतं तद्वसव उपजीवन्त्यग्निना मुखेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900002254, "chapter_id": 8260, "verse_number": "5.15", "content_sanskrit": "अथ यद्वितीयममृतं तद्रुद्राः उपजीवन्तीन्द्रेण मुखेन", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900002255, "chapter_id": 8260, "verse_number": "5.16", "content_sanskrit": "अथ यत्तृतीयममृतं तदादित्या उपजीवन्ति वरुणेन ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900002256, "chapter_id": 8260, "verse_number": "5.17", "content_sanskrit": "अथ यच्चतुर्थममृतं तन्मरुत उपजीवन्ति सोमेन ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900002257, "chapter_id": 8260, "verse_number": "5.18", "content_sanskrit": "अथ यत्पञ्चमममृतं तत्साध्याः उपजीवन्ति ब्रह्मणा मुखेन ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900002258, "chapter_id": 8260, "verse_number": "5.19", "content_sanskrit": "उदेत्यास्तमयं यावद् याति भानुस्तु पर्वते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900002259, "chapter_id": 8260, "verse_number": "5.20", "content_sanskrit": "एकत्रिंशत्तु घटिकाः साधिका वसुदैवताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900002260, "chapter_id": 8260, "verse_number": "5.21", "content_sanskrit": "'अहः सर्वं वसूनां तु परेषां रात्रिरेव च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900002261, "chapter_id": 8260, "verse_number": "5.22", "content_sanskrit": "एवं पृथिव्यां रुद्राणामन्तरिक्षं प्रकीर्तितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900002262, "chapter_id": 8260, "verse_number": "5.23", "content_sanskrit": "न त्विन्द्राद् यमो द्विगुणकालं तिष्ठति तस्माद् वरुणस्तस्मात् सोम इत्यत्र किञ्चिन्मानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900002263, "chapter_id": 8260, "verse_number": "5.24", "content_sanskrit": "इन्द्रादिपुरीणामुद्वासत्वेनैवमङ्गीकारे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900002264, "chapter_id": 8260, "verse_number": "5.25", "content_sanskrit": "उदेति पूर्वतः सूर्यो निम्लोचति च पश्चिमे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900002265, "chapter_id": 8260, "verse_number": "5.26", "content_sanskrit": "कालान्तरे भाविनं तु दक्षिणाद्युदयं पुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900002266, "chapter_id": 8260, "verse_number": "5.27", "content_sanskrit": "अथ तत ऊर्ध्वं उदेत्य नैवोदेता नास्तमेतैकल एव मध्ये स्थाता तदेष श्लोकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900002267, "chapter_id": 8260, "verse_number": "5.28", "content_sanskrit": "न ह वा अस्मा उदेति न निम्लोचति सकृद्दिवा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900002268, "chapter_id": 8260, "verse_number": "5.29", "content_sanskrit": "गायत्री वा इदं सर्वं भूतं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900002269, "chapter_id": 8260, "verse_number": "5.30", "content_sanskrit": "या वै सा गायत्रीयं वाव सा येयं पृथिव्यस्यां ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900002270, "chapter_id": 8260, "verse_number": "5.31", "content_sanskrit": "या वै सा पृथिवीयं वाव सा यदिदमस्मिन् पुरुषे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900002271, "chapter_id": 8260, "verse_number": "5.32", "content_sanskrit": "यद्वै तत्पुरुषे शरीरमिदं वाव तद्यदिदमस्मिन्नन्तः पुरुषे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900002272, "chapter_id": 8260, "verse_number": "5.33", "content_sanskrit": "सैषा चतुष्पदा षडि्वधा गायत्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900002273, "chapter_id": 8260, "verse_number": "5.34", "content_sanskrit": "तदेतदृचाऽभ्यनूक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900002274, "chapter_id": 8260, "verse_number": "5.35", "content_sanskrit": "यद्वै तद्ब्रह्मेतीदं वाव तद्योऽयं बहिर्धा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900002275, "chapter_id": 8260, "verse_number": "5.36", "content_sanskrit": "ब्रह्मशब्दाच्च भगवानित्यवसीयते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900002276, "chapter_id": 8260, "verse_number": "5.37", "content_sanskrit": "तस्य ह वा एतस्य हृदयस्य पञ्च देवसुषयः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900002277, "chapter_id": 8260, "verse_number": "5.38", "content_sanskrit": "योऽसौ वैकुण्ठगो विष्णुः सप्तलोकोपरिस्थितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 900002278, "chapter_id": 8260, "verse_number": "5.39", "content_sanskrit": "दिक्षु यानाद् यशो व्याप्तं कीर्तिः प्रत्यक्षतः स्तुतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 900002279, "chapter_id": 8260, "verse_number": "5.40", "content_sanskrit": "सर्वं खल्विदं ब्रह्म", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 900002280, "chapter_id": 8260, "verse_number": "5.41", "content_sanskrit": "एष म आत्माऽन्तर्हृदयेऽणीयान् व्रीहेर्वा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 900002281, "chapter_id": 8260, "verse_number": "5.42", "content_sanskrit": "अन्तरिक्षोदरः कोशो भूमिबुध्नो न जीर्यति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 900002282, "chapter_id": 8260, "verse_number": "5.43", "content_sanskrit": "तस्य प्राची दिक् जुहूर्नाम सहमाना नाम दक्षिणा राज्ञी नाम ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 900002283, "chapter_id": 8260, "verse_number": "5.44", "content_sanskrit": "अरिष्टं कोशं प्रपद्येऽमुनाऽमुनाऽमुना प्राणं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 900002284, "chapter_id": 8260, "verse_number": "5.45", "content_sanskrit": "पुरुषो वाव यज्ञस्तस्य यानि चतुर्विंशतिवर्षाणि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 900002285, "chapter_id": 8260, "verse_number": "5.46", "content_sanskrit": "एतद्ध स्म वै तद्विद्वानाह महिदास ऐतरेयः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 900002286, "chapter_id": 8260, "verse_number": "5.47", "content_sanskrit": "स यदशिशिषति यत्पिपासति यन्न रमते ता अस्य दीक्षाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 900002287, "chapter_id": 8260, "verse_number": "5.48", "content_sanskrit": "तत्रैते द्वे ऋचौ भवतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 900002288, "chapter_id": 8260, "verse_number": "5.49", "content_sanskrit": "मनो ब्रह्मेत्युपासीतेत्यध्यात्ममथाधिदैवतमाकाशो ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 900002289, "chapter_id": 8260, "verse_number": "5.50", "content_sanskrit": "आदित्यो ब्रह्मेत्यादेशस्तस्योपव्याख्यानमसदेवेदमग्र आसीत् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]