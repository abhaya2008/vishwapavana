[{"id": 2045184, "chapter_id": 2006, "verse_number": "६-५५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2045185, "chapter_id": 2006, "verse_number": "६-५५-१", "content_sanskrit": "ततोऽपराह्णभूयिष्ठे तस्मिन्नहनि भारत।\nरथनागाश्वपत्तीनां सादिनां च महाक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2045186, "chapter_id": 2006, "verse_number": "६-५५-२", "content_sanskrit": "द्रोणपुत्रेण शल्येन कृपेण च महात्मना ।\nसमसज्जत पाञ्चाल्यस्त्रिभिरैतैर्महारथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2045187, "chapter_id": 2006, "verse_number": "६-५५-३", "content_sanskrit": "स लोकविदितानश्वान्निजघान महाबलः ।\nद्रौणेः पाञ्चालदायादः शितैर्दशभिराशुगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2045188, "chapter_id": 2006, "verse_number": "६-५५-४", "content_sanskrit": "ततः शल्यरथं तूर्णमास्थाय हतवाहनः ।\nद्रौणिः पाञ्चालदायादमभ्यवर्षदथेषुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2045189, "chapter_id": 2006, "verse_number": "६-५५-५", "content_sanskrit": "धृष्टद्युम्नं तु संयुक्तं द्रौणिना वीक्ष्य भारत।\nसौभद्रोऽभ्यपतत्तूर्णं विकिरन्निशिताञ्शरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2045190, "chapter_id": 2006, "verse_number": "६-५५-६", "content_sanskrit": "स शल्यं प़ञ्चविंशत्या कृपं च नवभिः शरैः ।\nअश्वत्थामानमष्टाभिर्विव्याध पुरुषर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2045191, "chapter_id": 2006, "verse_number": "६-५५-७", "content_sanskrit": "आर्जुनिं तु ततस्तूर्णं द्रौणिर्विव्याध पत्रिणा।\nशल्योऽथ दशभिश्चैव कृपश्च निशितैस्त्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2045192, "chapter_id": 2006, "verse_number": "६-५५-८", "content_sanskrit": "लक्ष्मणस्तव पौत्रस्तु सौभद्रं समवस्थितम् ।\nअभ्यवर्तत संहृष्टस्ततो युद्धमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2045193, "chapter_id": 2006, "verse_number": "६-५५-९", "content_sanskrit": "दौर्योधनिः सुसंक्रुद्धः सौभद्रं परवीरहा ।\nविव्याध समरे राजंस्तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2045194, "chapter_id": 2006, "verse_number": "६-५५-१०", "content_sanskrit": "अभिमन्युः सुसंक्रुद्धो भ्रातरं भरतर्षभ ।\nशरैः पञ्चाशतै राजन्क्षिप्रहस्तोऽभ्यविध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2045195, "chapter_id": 2006, "verse_number": "६-५५-११", "content_sanskrit": "लक्ष्मणोऽपि पुनस्तस्य धनुश्चिच्छेद पत्रिणा।\nमुष्टिदेशे महाराज ततस्ते चुक्रुशुर्जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2045196, "chapter_id": 2006, "verse_number": "६-५५-१२", "content_sanskrit": "तद्विहाय धनुश्छिन्नं सौभद्रं परवीरहा।\nअन्यदादत्तवांश्चित्रं कार्मुकं वेगवत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2045197, "chapter_id": 2006, "verse_number": "६-५५-१३", "content_sanskrit": "तौ तत्र समरे युक्तौ कृतप्रतिकृतैषिणौ ।\nअन्योन्यं विशिस्वैस्तीक्ष्णैर्जघ्नतुः पुरुषर्षभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2045198, "chapter_id": 2006, "verse_number": "६-५५-१४", "content_sanskrit": "ततो दुर्योधनो राज दृष्ट्वा पुत्रं महारथम्।\nपीडितं तव पौत्रेण प्रायात्तत्र प्रजेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2045199, "chapter_id": 2006, "verse_number": "६-५५-१५", "content_sanskrit": "सन्निवृत्ते तव सुते सर्व एव जनाधिपाः ।\nआर्जुनिं रथवंशेन समन्तात्पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2045200, "chapter_id": 2006, "verse_number": "६-५५-१६", "content_sanskrit": "स तैः परिवृतः शूरैः शूरो युधि सुदुर्जयैः ।\nन स्म प्रव्यथते राजन्कृष्णतुल्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2045201, "chapter_id": 2006, "verse_number": "६-५५-१७", "content_sanskrit": "सौभद्रमथ संसक्तं दृष्ट्वा तत्र धनंजयः ।\nअभिदुद्राव वेगेन त्रातुकामः स्वमात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2045202, "chapter_id": 2006, "verse_number": "६-५५-१८", "content_sanskrit": "ततः सरथनागाश्वा भीष्मद्रोणपुरोगमाः ।\nअभ्यवर्तन्त राजानः सहिताः सव्यसाचिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2045203, "chapter_id": 2006, "verse_number": "६-५५-१९", "content_sanskrit": "उद्वूतं सहसा भौमं नागाश्वरथपत्तिभिः ।\nदिवाकररथं प्राप्य रजस्तीव्रमदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2045204, "chapter_id": 2006, "verse_number": "६-५५-२०", "content_sanskrit": "तानि नागसहस्राणि भूमिपालशतानि च।\nतस्य बाणपथं प्राप्य नाभ्यवर्तन्त सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2045205, "chapter_id": 2006, "verse_number": "६-५५-२१", "content_sanskrit": "प्रणेदुः सर्वभूतानि बभूवुस्तिमिरा दिशः।\nकुरूणां चानयस्तीव्रः समदृश्यत दारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2045206, "chapter_id": 2006, "verse_number": "६-५५-२२", "content_sanskrit": "नाप्यन्तरिक्षं न दिशो न भूमिर्न च भास्करः ।\nप्रजज्ञे भरतश्रेष्ठ सस्त्रसङ्घैः किरीटिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2045207, "chapter_id": 2006, "verse_number": "६-५५-२३", "content_sanskrit": "सादिता रथनागाश्च हताश्वा रथिनो रणे।\nविप्रद्रुतरथाः केचिद्दृश्यन्ते रथयूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2045208, "chapter_id": 2006, "verse_number": "६-५५-२४", "content_sanskrit": "विरथा रथिनश्चान्ये धावमानाः समन्ततः ।\nतत्रतत्रैव दृश्यन्ते सायुधाः साङ्गदैर्भुजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2045209, "chapter_id": 2006, "verse_number": "६-५५-२५", "content_sanskrit": "हयारोहा हयांस्त्यक्त्वा गजारोहाश्च दन्तिनः ।\nअर्जुनस्य भयाद्राजन्समन्ताद्विप्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2045210, "chapter_id": 2006, "verse_number": "६-५५-२६", "content_sanskrit": "रथेभ्यश्च गजेभ्यश्च हयेभ्यश्च नराधिपाः ।\nपतिताः पात्यमानाश्च दृश्यन्तेऽर्जुनसायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2045211, "chapter_id": 2006, "verse_number": "६-५५-२७", "content_sanskrit": "सगदानुद्यतान्बाहून्सखङ्गांश्च विशांपते ।\nसप्रासांश्च सतूणीरान्सशरान्सशरासनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2045212, "chapter_id": 2006, "verse_number": "६-५५-२८", "content_sanskrit": "साङ्कुशाकन्सपताकांश्च तत्रतत्रार्जुनो नृणाम् ।\nनिचकर्त शरैरुग्रै रौद्रं वपुरधारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2045213, "chapter_id": 2006, "verse_number": "६-५५-२९", "content_sanskrit": "परिघाणां प्रदीप्तानां मुद्गराणां च मारिष ।\nप्रासानां भिन्दिपालानां निस्त्रिशानां च संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2045214, "chapter_id": 2006, "verse_number": "६-५५-३०", "content_sanskrit": "परश्वथानां पीक्ष्णानां तोमराणां च भारत।\nवर्मणां चापविद्धानां काञ्चनानां च भूमिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2045215, "chapter_id": 2006, "verse_number": "६-५५-३१", "content_sanskrit": "ध्वजानां चर्मणां चैव व्यजनानां च सर्वशः ।\nछत्राणां हेमदण्डानां तोमराणां च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2045216, "chapter_id": 2006, "verse_number": "६-५५-३२", "content_sanskrit": "प्रतोदानां च योक्राणां कशानां चैव मारिष ।\nराशयः स्मात्र दृश्यन्ते विनिकीर्णा रणक्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2045217, "chapter_id": 2006, "verse_number": "६-५५-३३", "content_sanskrit": "नासीत्तत्र पुमान्कश्चित्तव सैन्यस्य भारत ।\nयोऽर्जुनं समरे शूरं प्रत्युद्यायात्कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2045218, "chapter_id": 2006, "verse_number": "६-५५-३४", "content_sanskrit": "यो यो हि समरे पार्थं प्रत्युद्याति विशांपते।\nस सङ्ख्ये विशिखैस्तीक्ष्णैः परलोकाय नीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2045219, "chapter_id": 2006, "verse_number": "६-५५-३५", "content_sanskrit": "तेषु विद्रवमाणेषु तव योधेषु सर्वशः।\nअर्जुनो वासुदेवश्च दध्मतुर्वारिजोत्तमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2045220, "chapter_id": 2006, "verse_number": "६-५५-३६", "content_sanskrit": "तत्पभग्नं बलं दृष्ट्वा पिता देवव्रतस्तव।\nअब्रवीत्समरे शूरं भारद्वाजं स्मयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2045221, "chapter_id": 2006, "verse_number": "६-५५-३७", "content_sanskrit": "एष पाण्डुसुतो वीर कृष्णेन सहितो बली ।\nतथा करोति सैन्यानि यथा कुर्याद्धऩञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2045222, "chapter_id": 2006, "verse_number": "६-५५-३८", "content_sanskrit": "न ह्येष समरे शक्यो विजेतुं हि कथंचन ।\nयथास्य दृश्यते रूप कालान्तकयमोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2045223, "chapter_id": 2006, "verse_number": "६-५५-३९", "content_sanskrit": "न निवर्तयितुं चापि शक्येयं महती चमूः ।\nअन्योन्यप्रेया पश्य द्रवतीयं वरूथिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2045224, "chapter_id": 2006, "verse_number": "६-५५-४०", "content_sanskrit": "एष चास्तं गिरिश्रेष्ठं भानुमान्प्रतिपद्यते।\nचक्षूंषि सर्वलोकस्य संहरन्निव सर्वथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2045225, "chapter_id": 2006, "verse_number": "६-५५-४१", "content_sanskrit": "तत्रावहारं संप्राप्तं मन्येऽहं पुरुषर्षभ ।\nश्रान्ता भीताश्च नो योधा न योत्स्यन्ति कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2045226, "chapter_id": 2006, "verse_number": "६-५५-४२", "content_sanskrit": "एवमुक्त्वा ततो भीष्मो द्रोणमाचार्यसत्तमम् ।\nअवहारमथो चक्रे तावकानां महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2045227, "chapter_id": 2006, "verse_number": "६-५५-४३", "content_sanskrit": "`ततः सरथनागाश्वा जंय प्राप्य समोपकाः।\nपाञ्चालाः पाण्डवाश्चैव प्रणेदुश्च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2045228, "chapter_id": 2006, "verse_number": "६-५५-४४", "content_sanskrit": "प्रययुः शिबिरायैव धनञ्जयपुरस्कृताः।\nवादित्रघोषैः संहृष्टा प्रणद्यन्तो महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2045229, "chapter_id": 2006, "verse_number": "६-५५-४५", "content_sanskrit": "ततोऽवहारः सैन्यानां तव तेषां च भारत।\nअस्तं गच्छति सूर्येऽभूत्सन्ध्याकाले च वर्तति ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2045230, "chapter_id": 2006, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि द्वितीयदिवसयुद्धे प़ञ्चपञ्चाशोऽध्यायः ॥ ॥ इति द्वितीयदिवसयुद्धम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]