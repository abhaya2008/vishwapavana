[{"id": 2008038, "chapter_id": 1154, "verse_number": "१-१५५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008039, "chapter_id": 1154, "verse_number": "१-१५५-१", "content_sanskrit": "ततो दुर्योधनो राजा सर्वास्तु प्रकृतीः शनैः।\nअर्थमानप्रदानाभ्यां संजहार सहानुजः।\nयुयुत्सुमपनीयैकं धार्तराष्ट्रं सहोदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008040, "chapter_id": 1154, "verse_number": "१-१५५-२", "content_sanskrit": "धृतराष्ट्रप्रयुक्तास्तु केचित्कुशलमन्त्रिणः।\nकथयाञ्चक्रिरे रम्यं नगरं वारणावतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008041, "chapter_id": 1154, "verse_number": "१-१५५-३", "content_sanskrit": "अयं समाजः सुमहान्रमणीयतमो भुवि।\nउपस्थितः पशुपतेर्नगरे वारणावते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008042, "chapter_id": 1154, "verse_number": "१-१५५-४", "content_sanskrit": "सर्वरत्नसमाकीर्णे पुण्यदेशे मनोरमे।\nइत्येवं धृतराष्ट्रस्य वचनाच्चक्रिरे कथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008043, "chapter_id": 1154, "verse_number": "१-१५५-५", "content_sanskrit": "कथ्यमाने तथा रम्ये नगरे वारणावते।\nगमने पाण्डुपुत्राणां जज्ञे तत्र मतिर्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008044, "chapter_id": 1154, "verse_number": "१-१५५-६", "content_sanskrit": "यदा त्वमन्यत नृपो जातकौतूहला इति।\nउवाचैतानेत्य तदा पाण्डवानम्बिकासुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008045, "chapter_id": 1154, "verse_number": "१-१५५-७", "content_sanskrit": "अधीतानि च शास्त्राणि युष्माभिरिह कृत्स्नशः।\nअस्त्राणि च तथा द्रोणाद्गौतमाच्च शरद्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008046, "chapter_id": 1154, "verse_number": "१-१५५-८", "content_sanskrit": "कृतकृत्या भवन्तस्तु सर्वविद्याविशारदाः।\nसोऽहमेवं गते ताताश्चिन्तयामि समन्ततः।\nरक्षणे व्यवहारे च राज्यस्य सततं हिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008047, "chapter_id": 1154, "verse_number": "१-१५५-९", "content_sanskrit": "ममैते पुरुषा नित्यं कथयन्ति पुनःपुनः।\nरमणीयतमं लोके नगरं वारणावतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008048, "chapter_id": 1154, "verse_number": "१-१५५-१०", "content_sanskrit": "ते ताता यदि मन्यध्वमुत्सवं वारणावते।\nसगणाः सान्वयाश्चैव विहरध्वं यथाऽमराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008049, "chapter_id": 1154, "verse_number": "१-१५५-११", "content_sanskrit": "ब्राह्मणेभ्यश्च रत्नानि गायनेभ्यश्च सर्वशः।\nप्रयच्छध्वं यथाकामं देवा इव सुवर्चसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008050, "chapter_id": 1154, "verse_number": "१-१५५-१२", "content_sanskrit": "कंचित्कालं विहृत्यैवमनुभूय परां मुदम्।\nइदं वै हास्तिनपुरं सुखिनः पुनरेष्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008051, "chapter_id": 1154, "verse_number": "१-१५५-१३", "content_sanskrit": "निवसध्वं च तत्रैव संरक्षणपरायणाः।\nवैलक्षण्यं न वै तत्र भविष्यति परंतपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008052, "chapter_id": 1154, "verse_number": "१-१५५-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008053, "chapter_id": 1154, "verse_number": "१-१५५-१४", "content_sanskrit": "धृतराष्ट्रस्य तं काममनुबुध्य युधिष्ठिरः।\nआत्मनश्चासहायत्वं तथेति प्रत्युवाच तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008054, "chapter_id": 1154, "verse_number": "१-१५५-१५", "content_sanskrit": "ततो भीष्मं शान्तनवं विदुरं च महामतिम्।\nद्रोणं च बाह्लिकं चैव सोमदत्तं च कौरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008055, "chapter_id": 1154, "verse_number": "१-१५५-१६", "content_sanskrit": "कृपमाचार्यपुत्रं च भूरिश्रवसमेव च।\nमान्यानन्यानमात्यांश्च ब्राह्मणांश्च तपोधनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008056, "chapter_id": 1154, "verse_number": "१-१५५-१७", "content_sanskrit": "पुरोहितांश्च पौत्रांश्च गान्धारीं च यशस्विनीम्।\nसर्वा मातॄरुपस्पृष्ट्वा विदुरस्य च योषितः।\nयुधिष्ठिरः शनैर्दीन उवाचेदं वचस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008057, "chapter_id": 1154, "verse_number": "१-१५५-१८", "content_sanskrit": "रमणीये जनाकीर्णे नगरे वारणावते।\nसगणास्तत्र यास्यामो धृतराष्ट्रस्य शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008058, "chapter_id": 1154, "verse_number": "१-१५५-१९", "content_sanskrit": "प्रसन्नमनसः सर्वे पुण्या वाचो विमुञ्चत।\nआशीर्भिर्बृहितानस्मान्न पापं प्रसहिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008059, "chapter_id": 1154, "verse_number": "१-१५५-२०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008060, "chapter_id": 1154, "verse_number": "१-१५५-२०", "content_sanskrit": "एवमुक्तास्तु ते सर्वे पाण्डुपुत्रेण कौरवाः।\nप्रसन्नवदना भूत्वा तेऽन्ववर्तन्त पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008061, "chapter_id": 1154, "verse_number": "१-१५५-२१", "content_sanskrit": "स्वस्त्यस्तु वः पथि सदा भूतेभ्यश्चैव सर्वशः।\nमा च वोस्त्वशुभं किंचित्सर्वशः पाण्डुनन्दनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008062, "chapter_id": 1154, "verse_number": "१-१५५-२२", "content_sanskrit": "ततः कृतस्वस्त्ययना राज्यलाभाय पार्थिवाः।\nकृत्वा सर्वाणि कार्याणि प्रययुर्वारणावतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008063, "chapter_id": 1154, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि जतुगृहपर्वणि पञ्चपञ्चाशदधिकशततमोऽध्यायः॥ १५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]