[{"id": 2020316, "chapter_id": 1424, "verse_number": "३-६२-०x", "content_sanskrit": "बृहृदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020317, "chapter_id": 1424, "verse_number": "३-६२-१", "content_sanskrit": "सा तच्छ्रुत्वाऽनवद्याङ्गी सार्थवाहवचस्तदा।\nजगाम सह तेनैव सार्थेन पतिलालसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020318, "chapter_id": 1424, "verse_number": "३-६२-२", "content_sanskrit": "अथ काले बहुतिथे वने महति दारुणे।\nतटाकं सर्वतोभद्रं पद्मसौगन्धिकायुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020319, "chapter_id": 1424, "verse_number": "३-६२-३", "content_sanskrit": "ददृशुर्वणिजो रम्यं प्रभूतयवसेन्धनम्।\nबहुमूलफलोपेतं नानापक्षिनिषेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020320, "chapter_id": 1424, "verse_number": "३-६२-४", "content_sanskrit": "तं दृष्ट्वा मृष्टसलिलं मनोहारि सुशीतलम्।\nसुपरिश्रान्तवाहास्ते निवेशाय मनो दधुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020321, "chapter_id": 1424, "verse_number": "३-६२-५", "content_sanskrit": "संमते सार्थवाहस्य विविशुर्वनमुत्तमम्।\nउवास सार्थः सुमहान्निशामासाद्य पद्मिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020322, "chapter_id": 1424, "verse_number": "३-६२-६", "content_sanskrit": "अथार्धरात्रसमये निःशब्दे तिमिरे तदा।\nसुप्ते सार्थे परिश्रान्ते हस्तियूथमुपागमत्।\nपानीयार्थं गिरितटान्मदप्रस्रवणाविलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020323, "chapter_id": 1424, "verse_number": "३-६२-७", "content_sanskrit": "[अथापश्यत सार्थं तं सार्थजान्सुबहून्गजान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020324, "chapter_id": 1424, "verse_number": "३-६२-८", "content_sanskrit": "ते तान्ग्राम्यगजान्दृष्ट्वा सर्वे वनगजास्तदा।\nसमाद्रवन्त वेगेन जिघांसन्तो मदोत्कटाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020325, "chapter_id": 1424, "verse_number": "३-६२-९", "content_sanskrit": "तेषामापततां वेगः करिणां दुःसहोऽभवत्।\nनगाग्रादिव शीर्णानां शृङ्गाणां पततां क्षितौ।\nस्पन्दतामपि नागानां मार्गा नष्टा वनोद्भवाः ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020326, "chapter_id": 1424, "verse_number": "३-६२-१०", "content_sanskrit": "मार्गं संरुद्ध्य संसुप्तं पद्मिन्याः सार्थमुत्तमम्।\nते तं ममर्दुः सहसा वेष्टमानं महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020327, "chapter_id": 1424, "verse_number": "३-६२-११", "content_sanskrit": "महारवं प्रमुञ्चतो वद्ध्यन्ते शरणार्थिनः।\nवनगुल्मांश्च धावन्तो निद्रया महतो भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020328, "chapter_id": 1424, "verse_number": "३-६२-१२", "content_sanskrit": "केचिद्दन्तैः करैः केचित्केचित्पद्भ्यां हता गजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020329, "chapter_id": 1424, "verse_number": "३-६२-१३", "content_sanskrit": "निहतोष्ट्राश्वबहुलाः पदातिजसंकुलाः।\nभयादाधावमानाश् परस्परहतास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020330, "chapter_id": 1424, "verse_number": "३-६२-१४", "content_sanskrit": "घोरान्नादान्विमुञ्चन्तो निपेतुर्धरणीतले।\nवृक्षेष्वासज्यसंभग्नाः पतिता विषमेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020331, "chapter_id": 1424, "verse_number": "३-६२-१५", "content_sanskrit": "एवंप्रकारैर्बहुभिर्दैवेनाक्रम्य हस्तिभिः।\nराजन्विनिहतं सर्वं समृद्धं सार्थमण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020332, "chapter_id": 1424, "verse_number": "३-६२-१६", "content_sanskrit": "आरावः सुमहांश्चासीत्रैलोक्यभयकारकः।\nएषोऽग्निरुत्थितः कष्टस्त्रायध्वं धावताऽधुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020333, "chapter_id": 1424, "verse_number": "३-६२-१७", "content_sanskrit": "रत्नराशिर्विशीर्णोऽयं गृह्णीध्वं किं प्रधावत।\nसामान्यमेतद्द्रविणं न मिथ्या वचनं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020334, "chapter_id": 1424, "verse_number": "३-६२-१८", "content_sanskrit": "पुनरेवाभिधास्यामि चिन्तयध्वं सुकातराः।\nएवमेवाभिभाषन्तो विद्रवन्ति भयात्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020335, "chapter_id": 1424, "verse_number": "३-६२-१९", "content_sanskrit": "तस्मिंस्तथा वर्तमाने दारुणे जनसंक्षये।\nदमयन्ती च बुबुधे भयसंत्रस्तमानसा।\nअपश्यद्वैशसं तत्र सर्वलोकभयंकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020336, "chapter_id": 1424, "verse_number": "३-६२-२०", "content_sanskrit": "अदृष्टपूर्वं तद्दृष्ट्वा बाला पद्मनिभेक्षणा।\nसंसक्तवदनाश्वासा उत्तस्थौ भयविह्वला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020337, "chapter_id": 1424, "verse_number": "३-६२-२१", "content_sanskrit": "ये तु तत्र विनिर्मुक्ताः सार्थात्केचिदविक्षताः।\nतेऽब्रुवन्सहिताः सर्वे कस्येदं कर्मणः फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020338, "chapter_id": 1424, "verse_number": "३-६२-२२", "content_sanskrit": "नूनं न पूजितोऽस्माभिर्मणिभद्रो महायशाः।\nतथा यक्षाधिपः श्रीमान्न वै वैश्रवणः प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020339, "chapter_id": 1424, "verse_number": "३-६२-२३", "content_sanskrit": "न पूजा विघ्रकर्तॄणामथवा प्रथमं कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020340, "chapter_id": 1424, "verse_number": "३-६२-२४", "content_sanskrit": "शकुनानां फलं वाऽथ विपरीतिमिदं ध्रुवम्।\nग्रहा न विपरीतास्तु किमन्यदिदमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020341, "chapter_id": 1424, "verse_number": "३-६२-२५", "content_sanskrit": "अपरे त्वब्रुवन्दीना ज्ञातिद्रव्यविनाकृता।\nयाऽसावद्य महासार्थे नारी ह्युन्मत्तदर्शना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020342, "chapter_id": 1424, "verse_number": "३-६२-२६", "content_sanskrit": "प्रविष्टा विकृताकारा कृत्वा रूपममानुषम्।\nतयैवं विहिता पूर्वं माया परमदारुणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020343, "chapter_id": 1424, "verse_number": "३-६२-२७", "content_sanskrit": "राक्षसी वा ध्रुवं यक्षी पिशाची वा भयंकरी।\nतस्याः सर्वमिदं पापं नात्र कार्या विचारणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2020344, "chapter_id": 1424, "verse_number": "३-६२-२८", "content_sanskrit": "यदि पश्याम तां पापां सार्थघ्नीं नैकदुःखदाम्।\nलोष्टभिः पांसुभिश्चैव तृणैः काष्ठैश्च मुष्टिभिः।\nअवश्यमेव हन्यामः सार्थस्य किल कृत्यकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2020345, "chapter_id": 1424, "verse_number": "३-६२-२९", "content_sanskrit": "दमयन्ती तु तच्छ्रुत्वा वाक्यं तेषां सुदारुणम्।\nह्रीता भीता च संविग्रा प्राद्रवद्यत्र काननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2020346, "chapter_id": 1424, "verse_number": "३-६२-३०", "content_sanskrit": "आशङ्कमाना तत्पापमात्मानं पर्यदेवयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2020347, "chapter_id": 1424, "verse_number": "३-६२-३१", "content_sanskrit": "अहो ममोपरि विधेः संरम्भो दारुणो महान्।\nनानुबध्नाति कुशलं कस्येदं कर्मणः फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2020348, "chapter_id": 1424, "verse_number": "३-६२-३२", "content_sanskrit": "न स्मराम्यशुभं किंचित्कृतं कस्यचिदण्वपि।\nकर्मणा मनसा वाचा कस्येदं कर्मणः फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2020349, "chapter_id": 1424, "verse_number": "३-६२-३३", "content_sanskrit": "नूनं जन्मान्तरकृतं पापां माऽऽपतितं महत्।\nअपश्चिमामिमां कष्टामापदं प्राप्तवत्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2020350, "chapter_id": 1424, "verse_number": "३-६२-३४", "content_sanskrit": "भर्तृराज्यापहरणं स्वजनाच्च रपराजयः।\nभर्त्रा सह वियोगश्च तनयाभ्यां च विच्युतिः।\nनिर्नाथता वने वासो बहुव्यालनिषेविते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2020351, "chapter_id": 1424, "verse_number": "३-६२-३५", "content_sanskrit": "अथापरेद्युः संप्राप्ते हतशिष्टा जनास्तदा।\nवनगुल्माद्विनिष्क्रम्य शोचन्ते वैशसं कृतम्।\nभ्रातरं पितरं पुत्रं सखायं च नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2020352, "chapter_id": 1424, "verse_number": "३-६२-३६", "content_sanskrit": "`हन्यमाने तदा सार्थे दमयन्ती शुचिस्मिता।\nब्राह्मणैः सहिता तत्रवने तु न विनाशिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2020353, "chapter_id": 1424, "verse_number": "३-६२-३७", "content_sanskrit": "अशोचत्तत्र वैदर्भी किंनु मे दुष्कतं कृतम्।\nयोपि मे निर्जनेऽरण्ये संप्राप्तोऽयं जनार्णवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2020354, "chapter_id": 1424, "verse_number": "३-६२-३८", "content_sanskrit": "स हतो हस्तियूथेन मन्दभाग्यान्ममैव तत्।\nप्राप्तव्यं सुचिरं दुःखं नूनमद्यापि वै मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2020355, "chapter_id": 1424, "verse_number": "३-६२-३९", "content_sanskrit": "नाप्राप्तकालो म्रियते श्रुतं वृद्धानुशासनम्।\nया नाहमद्य मृदिता हस्तियूथेन दुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2020356, "chapter_id": 1424, "verse_number": "३-६२-४०", "content_sanskrit": "न ह्यदैवकृतंकिंचिन्नराणामिह विद्यते।\nन च मे बालभावेऽपि किंचित्पापकृतं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2020357, "chapter_id": 1424, "verse_number": "३-६२-४१", "content_sanskrit": "कर्मणा मनसा वाचा यदिदं दुःखमागतम्।\nमन्ये स्वयंवरकृतेलोकपाला समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2020358, "chapter_id": 1424, "verse_number": "३-६२-४२", "content_sanskrit": "प्रत्याख्याता मया तत्र नलस्यार्थाय देवताः।\nनूनं तेषां प्रभावेन वियोगं प्राप्तवत्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2020359, "chapter_id": 1424, "verse_number": "३-६२-४३", "content_sanskrit": "एवमादीनि दुःखार्ता सा विलप्य वराङ्गना।\nप्रलापानि तदा तानि दमयन्ती पतिव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2020360, "chapter_id": 1424, "verse_number": "३-६२-४४", "content_sanskrit": "हतशेषैः सह तदा ब्राह्मणैर्वेदपारगैः।\nअगच्छद्राजशार्दूल दुःखशोकपरायणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2020361, "chapter_id": 1424, "verse_number": "३-६२-४५", "content_sanskrit": "गच्छन्ती सा चिराद्बाला पुरमासादयन्महत्।\nसायाह्नि चेदिराजस् सुबाहोः सत्यवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2020362, "chapter_id": 1424, "verse_number": "३-६२-४६", "content_sanskrit": "`सा तु तच्चारुसर्वाङ्गी सुबाहोस्तुङ्गगोपुरम्।\nवस्त्रार्धेन च संवीता प्रविवेश पुरोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2020363, "chapter_id": 1424, "verse_number": "३-६२-४७", "content_sanskrit": "तां विह्वलां कृशां दीनां मुक्तकेशीममार्जिताम्।\nउन्मत्तामिव गच्छन्तीं ददृशुः पुरवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2020364, "chapter_id": 1424, "verse_number": "३-६२-४८", "content_sanskrit": "प्रविशन्तीं तु तां दृष्ट्वा चेदिराजपुरीं तदा।\nअनुजग्मुस्तत्र बाला ग्रामिपुत्राः कुतूहलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2020365, "chapter_id": 1424, "verse_number": "३-६२-४९", "content_sanskrit": "सा तैः परिवृताऽगच्छत्समीपं राजवेश्मनः।\nतां प्रासादगताऽपश्यद्राजमाता जनैर्वृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2020366, "chapter_id": 1424, "verse_number": "३-६२-५०", "content_sanskrit": "धात्रीमुवाच च्छैनामानयेह ममान्तिकम्।\nजनेन क्लिश्यते बाला दुःखिता शरणार्थिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2020367, "chapter_id": 1424, "verse_number": "३-६२-५१", "content_sanskrit": "तादृग्रूपं च पश्यामि विद्योतयति मे गृहम्।\nउन्मत्तवेषा कल्याणी श्रीरिवायतलोचना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2020368, "chapter_id": 1424, "verse_number": "३-६२-५२", "content_sanskrit": "सा जनं वारयित्वा तं प्रासादतलमुत्तमम्।\nआरोप्य विस्मिता राजन्दमयन्तीमपृच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2020369, "chapter_id": 1424, "verse_number": "३-६२-५३", "content_sanskrit": "एवमप्यसुखाविष्टा बिभर्षि परमं वपुः।\nभासि विद्युदिवाभ्रेषु शंस मे काऽसिकस्य वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2020370, "chapter_id": 1424, "verse_number": "३-६२-५४", "content_sanskrit": "न हि ते मानुषं रूपं भूषणैरपि वर्जितम्।\nअसहाया नरेभ्यश्च नोद्विजस्यमरप्रभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2020371, "chapter_id": 1424, "verse_number": "३-६२-५५", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्या भैमी वचनमब्रवीत्।\nमानुषीं मां विजानीहि भर्तारं समनुव्रताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2020372, "chapter_id": 1424, "verse_number": "३-६२-५६", "content_sanskrit": "सैरन्ध्रीं जातिसंपन्नां भुजिष्यां कामवासिनीम्।\nफलमूलाशनामेकां यत्रसायंप्रतिश्रयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2020373, "chapter_id": 1424, "verse_number": "३-६२-५७", "content_sanskrit": "असङ्ख्येयगुणो भर्ता मां च नित्यमनुव्रतः।\nभक्ताऽहमपि तं वीरं छायेवानुगता पथि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2020374, "chapter_id": 1424, "verse_number": "३-६२-५८", "content_sanskrit": "तस्य दैवात्प्रसङ्गोऽभूदतिमात्रं सुदेवने।\nद्यूते स निर्जितश्चैव वनमेक उपेयिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2020375, "chapter_id": 1424, "verse_number": "३-६२-५९", "content_sanskrit": "तमेकवसनच्छन्नमुन्म्तमिव विह्वलम्।\nआश्वासयन्ती भर्तारमहमप्यगमं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2020376, "chapter_id": 1424, "verse_number": "३-६२-६०", "content_sanskrit": "स कदाचिद्वने वीरः कस्मिंश्चित्कारणान्तरे।\nक्षुत्परीतस्तु विमना वासश्चैकं व्यसर्जयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2020377, "chapter_id": 1424, "verse_number": "३-६२-६१", "content_sanskrit": "तमेकवसना नग्नमुन्मत्तवदचेतसम्।\nअनुव्रजन्ती बहुला न स्वपामि निशाः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2020378, "chapter_id": 1424, "verse_number": "३-६२-६२", "content_sanskrit": "ततो बहुतिथे काले सुप्तामुत्सृज्य मां क्वचित्।\nवाससोऽर्धं परिच्छिद्य त्यक्तवान्मामनागसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2020379, "chapter_id": 1424, "verse_number": "३-६२-६३", "content_sanskrit": "तं मार्गमाणा भर्तारं दह्यमाना दिवानिशम्।\nन विन्दाम्यमरप्रख्यं प्रियं प्राणेश्वरं प्रभुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2020380, "chapter_id": 1424, "verse_number": "३-६२-६४", "content_sanskrit": "`इत्युक्त्वा साऽनवद्याङ्गी राजमातरमप्युत।\nस्थिताऽश्रुपरिपूर्णाक्षी वेपमाना सुदुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2020381, "chapter_id": 1424, "verse_number": "३-६२-६५", "content_sanskrit": "तामश्रुपरिपूर्णाक्षीं विलपन्तीं तथा बहु।\nराजमाताऽब्रवीदार्ता भैमीमार्तस्वरां स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2020382, "chapter_id": 1424, "verse_number": "३-६२-६६", "content_sanskrit": "वस त्वमिह कल्याणि प्रीतिर्मे परमा त्वयि।\nमृगयिष्यन्ति ते भद्रे भर्तारं पुरुषा मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2020383, "chapter_id": 1424, "verse_number": "३-६२-६७", "content_sanskrit": "अपि वा स्वयमागच्छेत्परिधावन्नितस्ततः।\nइहैव वसती भद्रे भर्तारमुपलप्स्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2020384, "chapter_id": 1424, "verse_number": "३-६२-६८", "content_sanskrit": "राजमातुर्वचः श्रुत्वा दमयन्ती वचोऽब्रवीत्।\nसमयेनोत्सहे वस्तुं त्वि वीरप्रजायिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2020385, "chapter_id": 1424, "verse_number": "३-६२-६९", "content_sanskrit": "उच्छिष्टं नैव भुञ्जीयां न कुर्यां पादधावनम्।\nन चाहं पुरुषानन्यान्प्रभाषेयं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2020386, "chapter_id": 1424, "verse_number": "३-६२-७०", "content_sanskrit": "प्रार्थयेद्यदि मां कश्चिद्दण्ड्यस्ते स पुमान्भवेत्।\nवध्यश्च ते सकृन्मन्द इतिमे व्रतमाहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2020387, "chapter_id": 1424, "verse_number": "३-६२-७१", "content_sanskrit": "भर्तुरन्वेषणार्थं तु पश्येयं ब्राह्मणानहम्।\nयद्येवमिह वत्स्यामि त्वत्सकाशे न संशयः।\nअतोऽन्यथा न मे वासो वर्तते हृदये क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2020388, "chapter_id": 1424, "verse_number": "३-६२-७२", "content_sanskrit": "इत्युक्ता दमयन्त्या तु राजमातेदमब्रवीत्।\nसर्वमेतत्करिष्यामि दिष्ट्या ते व्रतमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2020389, "chapter_id": 1424, "verse_number": "३-६२-७३", "content_sanskrit": "एवमुक्त्वा ततो भैमीं राजमाता विशांपते।\nउवाचेदं दुहितरं सुनन्दां नाम भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2020390, "chapter_id": 1424, "verse_number": "३-६२-७४", "content_sanskrit": "सैरन्ध्रीमभिजानीष्व सुनन्दे देवरूपिणीम्।\nवयसा तुल्यतां प्राप्ता सखी तव भवत्वियम्।\nएतया सह मोदस्व निरुद्विग्रमना सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2020391, "chapter_id": 1424, "verse_number": "३-६२-७५", "content_sanskrit": "ततः परमसंहृष्टा सुनन्दा गृहणागमत्।\nदमयन्तीमुपादाय सखीभिः परिवारिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2020392, "chapter_id": 1424, "verse_number": "३-६२-७६", "content_sanskrit": "सहसा न्यवसद्राजन्राजपुत्र्या सुनन्दया।\nचिन्तयन्ती नलं वीरमनिशं वामलोचना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2020393, "chapter_id": 1424, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि द्विषष्टितमोऽध्यायः ॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]