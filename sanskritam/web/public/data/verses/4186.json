[{"id": 2147357, "chapter_id": 4186, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147358, "chapter_id": 4186, "verse_number": "१", "content_sanskrit": "तथैव तां श्रियं त्यक्त्वा कन्या भूत्वा यशस्विनी ।\nमाधवी गालवं विप्रमन्वयात् सत्यसङ्गरा\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147359, "chapter_id": 4186, "verse_number": "२", "content_sanskrit": "गालवो विमृशन्नेव स्वकार्यगतमानसः ।\nजगाम भोजनगरं द्रष्टुमौशीनरं नृपम्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147360, "chapter_id": 4186, "verse_number": "३", "content_sanskrit": "तमुवाचाथ गत्वा तु भूपते सत्यविक्रमम्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147361, "chapter_id": 4186, "verse_number": "४", "content_sanskrit": "इयं कन्या सुतौ द्वौ ते जनयिष्यति पार्थिवौ ।\nअस्यां भवानवाप्तार्थो भविता प्रेत्य चेह च\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147362, "chapter_id": 4186, "verse_number": "५", "content_sanskrit": "सोमार्कप्रतिसङ्काशौ जनयित्वा सुतौ नृप\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147363, "chapter_id": 4186, "verse_number": "६", "content_sanskrit": "शुल्कं तु सर्वधर्मज्ञ हयानां चन्द्रवर्चसाम् ।\nएकतः श्यामकर्णानां देयं मह्यं चतुःशतम्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147364, "chapter_id": 4186, "verse_number": "७", "content_sanskrit": "गुर्वर्थोऽयं समारम्भो न हयैः कृत्यमस्ति मे ।\nयदि शक्यं महाराज क्रियतामविचारितम्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147365, "chapter_id": 4186, "verse_number": "८", "content_sanskrit": "अनपत्योऽसि राजर्षे सुतौ जनय पार्थिव ।\nपितॄन् पुत्रप्लवेन त्वमात्मानं चैव तारय\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147366, "chapter_id": 4186, "verse_number": "९", "content_sanskrit": "न पुत्रफलभोक्ता हि राजर्षे पात्यते दिवः ।\nन याति नरकं घोरं यत्र गच्छन्त्यनात्मजाः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147367, "chapter_id": 4186, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147368, "chapter_id": 4186, "verse_number": "१०", "content_sanskrit": "एतच्चान्यच्च विविधं श्रुत्वा गालवभाषितम् ।\nउशीनरः प्रतिवचो ददौ तस्य नराधिपः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147369, "chapter_id": 4186, "verse_number": "११", "content_sanskrit": "श्रुतवानस्मि ते वाक्यं यथा वदसि गालव ।\nविधिस्तु बलवान् ब्रह्मन् प्रवणं हि मनो मम\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147370, "chapter_id": 4186, "verse_number": "१२", "content_sanskrit": "शते द्वे तु मयाऽश्वानामीदृशानां द्विजोत्तम ।\nइतरेषां सहस्राणि सुबहूनि चरन्ति मे\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147371, "chapter_id": 4186, "verse_number": "१३", "content_sanskrit": "अहमप्येकमेवास्यां जनयिष्यामि गालव ।\nद्विज पुत्रगतं मार्गं गमिष्यामि परैरहम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147372, "chapter_id": 4186, "verse_number": "१४", "content_sanskrit": "मूल्येनापि समं कुर्यां तवाहं द्विजसत्तम ।\nपौरजानपदार्थं तु ममार्थो नात्मभोगतः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147373, "chapter_id": 4186, "verse_number": "१५", "content_sanskrit": "कामतो हि धनं राजा पारक्यं यः प्रयच्छति ।\nन स धर्मेण धर्मात्मन् युज्यते यशसाऽपि च\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147374, "chapter_id": 4186, "verse_number": "१६", "content_sanskrit": "सोऽहं प्रतिग्रहीष्यामि ददात्वेतां भवान् मम ।\nकुमारीं देवगर्भाभामेकपुत्रभवाय मे\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147375, "chapter_id": 4186, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147376, "chapter_id": 4186, "verse_number": "१७", "content_sanskrit": "तथा तु बहुकल्याणमुक्तवन्तं नराधिपम् ।\nउशीनरं द्विजश्रेष्ठो गालवः प्रत्यपूजयत्\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147377, "chapter_id": 4186, "verse_number": "१८", "content_sanskrit": "उशीनरं प्रतिग्राह्य गालवः प्रययौ वनम् ।\nरेमे स तां समासाद्य कृतपुण्य इव श्रियम्\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147378, "chapter_id": 4186, "verse_number": "१९", "content_sanskrit": "कन्दरेषु च शैलानां नदीनां निर्झरेषु च ।\nउद्यानेषु विचित्रेषु वनेषूपवनेषु च\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147379, "chapter_id": 4186, "verse_number": "२०", "content_sanskrit": "हर्म्येषु रमणीयेषु प्रासादशिखरेषु च ।\nवातायनविमानेषु तथा गर्भगृहेषु च\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147380, "chapter_id": 4186, "verse_number": "२१", "content_sanskrit": "ततोऽस्य समये जज्ञे पुत्रो बालरविप्रभः ।\nशिबिर्नाम्नाऽतिविख्यातो यः स पार्थिवसत्तमः\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147381, "chapter_id": 4186, "verse_number": "२२", "content_sanskrit": "उपस्थाय स तं विप्रो गालवः प्रतिगृह्य ताम् ।\nकन्यां प्रादाच्च तं राज्ञे दृष्टवान् विनतात्मजम्\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147382, "chapter_id": 4186, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि सप्तदशोत्तरशततमोऽध्यायः ॥११७॥\nभगवद्यानपर्वणि अष्टचत्वारिंशोऽध्यायः ॥४८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]