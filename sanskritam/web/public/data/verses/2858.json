[{"id": 2087649, "chapter_id": 2858, "verse_number": "१२-३६३-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087650, "chapter_id": 2858, "verse_number": "१२-३६३-१", "content_sanskrit": "आसीत्किल नरश्रेष्ठ महापद्मे पुरोत्तमे।\nगङ्गाया दक्षिणे तीरे कश्चिद्विप्रः समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087651, "chapter_id": 2858, "verse_number": "१२-३६३-२", "content_sanskrit": "सौम्यः सोमान्वये जातो जितात्मा गोत्रतो भृगुः।\nधर्मनित्यो जितक्रोधो नित्यतप्तो जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087652, "chapter_id": 2858, "verse_number": "१२-३६३-३", "content_sanskrit": "तपःस्वाध्यायनिरतः सत्यः सज्जनसंमतः।\nन्यायप्राप्तेन वित्तेन स्वेन शीलेन चान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087653, "chapter_id": 2858, "verse_number": "१२-३६३-४", "content_sanskrit": "ज्ञाति संबन्धिविपुले पुत्रपौत्रप्रतिष्ठिते।\nकुले महति विख्याते विशिष्टां वृत्तिमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087654, "chapter_id": 2858, "verse_number": "१२-३६३-५", "content_sanskrit": "स पुत्रान्बहुलाँल्लब्ध्वा विपुले कर्मणि स्थितः।\nकुलधर्माश्रितो राजन्धरर्मचर्यास्थितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087655, "chapter_id": 2858, "verse_number": "१२-३६३-६", "content_sanskrit": "ततः स धर्मं वेदोक्तं तथा शास्त्राक्तमेव च।\nशिष्टाचीर्णं च धर्मं च त्रिविधं चिन्त्य चेतसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087656, "chapter_id": 2858, "verse_number": "१२-३६३-७", "content_sanskrit": "किंनु मे स्याच्छुभं कृत्वा किं कृतं किं परायणम्।\nइत्येवं चिन्तयन्नित्यं न च याति विनिश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087657, "chapter_id": 2858, "verse_number": "१२-३६३-८", "content_sanskrit": "तस्यैवं चिन्त्यमानस्य धर्मं परममास्थितः।\nकदाचिदतिथिः प्राप्तो ब्राह्मणः सुसमाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087658, "chapter_id": 2858, "verse_number": "१२-३६३-९", "content_sanskrit": "स तस्मै सत्क्रियां चक्रे क्रियायुक्तेन हेतुना।\nविश्रान्तं सुसमासीनमिदं वचनमब्रवीत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087659, "chapter_id": 2858, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्रिषष्ट्यधिकत्रिशततमोऽध्यायः॥ ३६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]