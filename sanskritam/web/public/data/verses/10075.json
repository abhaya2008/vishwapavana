[{"id": 6000075000, "chapter_id": 10075, "verse_number": null, "content_sanskrit": "अथ एकादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000075001, "chapter_id": 10075, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.001.m4a", "display_order": 2}, {"id": 6000075002, "chapter_id": 10075, "verse_number": "४-११-१", "content_sanskrit": "प्रजापतेर्दुहितरं शिंशुमारस्य वै ध्रुवः।\nउपयेमे भ्रमिं नाम तत्सुतौ कल्पवत्सरौ॥ ४/११/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.002.m4a", "display_order": 3, "topics": [{"text": "ध्रुवस्य विवाहः पुत्रोत्पत्तिश्च", "range": "१–२"}]}, {"id": 6000075003, "chapter_id": 10075, "verse_number": "४-११-२", "content_sanskrit": "इलायामपि भार्यायां वायोः पुत्र्यां महाबलः।\nपुत्रमुत्कलनामानं योगेश्वरमजीजनत्॥ ४/११/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.003.m4a", "display_order": 4}, {"id": 6000075004, "chapter_id": 10075, "verse_number": "४-११-३", "content_sanskrit": "उत्तमस्त्वकृतोद्वाहो मृगयायां बलीयसा।\nहतः पुण्यजनेनाद्रौ तन्माता तद्गतिं गता॥ ४/११/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.004.m4a", "display_order": 5, "topics": [{"text": "ध्रुवस्य वैमात्रेयभ्रातुरकृतोद्वाहस्य मृगयार्थ वनं गतस्योत्तमनान्नो यक्षैर्वधः", "range": "३"}]}, {"id": 6000075005, "chapter_id": 10075, "verse_number": "४-११-४", "content_sanskrit": "ध्रुवो भ्रातृवधं श्रुत्वा कोपामर्षशुचाऽर्पितः।\nजैत्रं स्यन्दनमास्थाय गतः पुण्यजनालयम्॥ ४/११/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.005.m4a", "display_order": 6, "topics": [{"text": "ध्रुवेण अलकां गत्वा तद्भातृहन्तृणां यक्षाणां वधः", "range": "४–३६"}]}, {"id": 6000075006, "chapter_id": 10075, "verse_number": "४-११-५", "content_sanskrit": "गत्वोदीचीं दिशं राजा रुद्रानुचरसेविताम्।\nददर्श हिमवद्द्रोण्यां पुरीं गुह्यकसङ्कुलाम्॥ ४/११/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.006.m4a", "display_order": 7}, {"id": 6000075007, "chapter_id": 10075, "verse_number": "४-११-६", "content_sanskrit": "दध्मौ शङ्खं महाबाहुः खं दिशश्चानुनादयन्।\nयेनोद्विग्नदृशः क्षत्तरुपदेव्योऽत्रसन् भृशम्॥ ४/११/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.007.m4a", "display_order": 8}, {"id": 6000075008, "chapter_id": 10075, "verse_number": "४-११-७", "content_sanskrit": "ततो निष्क्रम्य बलिन उपदेवमहाभटाः।\nअसहन्तस्तन्निनादमभिपेतुरुदायुधाः॥ ४/११/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.008.m4a", "display_order": 9}, {"id": 6000075009, "chapter_id": 10075, "verse_number": "४-११-८", "content_sanskrit": "स तानापततो वीर उग्रधन्वा महारथः।\nएकैकं युगपत् सर्वानहन् बाणैस्‍त्रिभिस्‍त्रिभिः॥ ४/११/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.009.m4a", "display_order": 10}, {"id": 6000075010, "chapter_id": 10075, "verse_number": "४-११-९", "content_sanskrit": "ते वै ललाटलग्नैस्तैरिषुभिः सर्व एव हि।\nमत्वा निरस्तमात्मानमाशंसन् कर्म तस्य तत्॥ ४/११/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.010.m4a", "display_order": 11}, {"id": 6000075011, "chapter_id": 10075, "verse_number": "४-११-१०", "content_sanskrit": "तेऽपि चामुममृष्यन्तः पादस्पर्शमिवोरगाः।\nशरैरविध्यन् युगपद् द्विगुणं प्रचिकीर्षवः॥ ४/११/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.011.m4a", "display_order": 12}, {"id": 6000075012, "chapter_id": 10075, "verse_number": "४-११-११", "content_sanskrit": "ततः परिघनिस्‍त्रिंशैः प्रासशूलपरश्वधैः।\nशक्त्यृष्टिभिर्भुशुण्डीभिश्चित्रवाजैः शरैरपि॥ ४/११/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.012.m4a", "display_order": 13}, {"id": 6000075013, "chapter_id": 10075, "verse_number": "४-११-१२", "content_sanskrit": "अभ्यवर्षन् प्रकुपिताः सरथं सहसारथिम्।\nइच्छन्तस्तत्प्रतीकर्तुमयुतानां त्रयोदश॥ ४/११/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.013.m4a", "display_order": 14}, {"id": 6000075014, "chapter_id": 10075, "verse_number": "४-११-१३", "content_sanskrit": "औत्तानपादिः स तदा शस्‍त्रवर्षेण भूयसा।\nनोपादृश्यत संछन्न आसारेण यथा गिरिः॥ ४/११/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.014.m4a", "display_order": 15}, {"id": 6000075015, "chapter_id": 10075, "verse_number": "४-११-१४", "content_sanskrit": "हाहाकारस्तदैवासीत् सिद्धानां दिवि पश्यताम्।\nहतोऽयं मानवः सूर्यो मग्नः पुण्यजनार्णवे॥ ४/११/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.015.m4a", "display_order": 16}, {"id": 6000075016, "chapter_id": 10075, "verse_number": "४-११-१५", "content_sanskrit": "नदत्सु यातुधानेषु जयकाशिष्वथो मृधे।\nउदतिष्ठद् रथस्तस्मान्नीहारादिव भास्करः॥ ४/११/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.016.m4a", "display_order": 17}, {"id": 6000075017, "chapter_id": 10075, "verse_number": "४-११-१६", "content_sanskrit": "धनुर्विस्फूर्जयन्नुग्रं द्विषतां खेदमुद्वहन्।\nअस्‍त्रौघं व्यधमद् बाणैर्घनानीकमिवानिलः॥ ४/११/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.017.m4a", "display_order": 18}, {"id": 6000075018, "chapter_id": 10075, "verse_number": "४-११-१७", "content_sanskrit": "तस्य ते चापनिर्मुक्ता भित्त्वा वर्माणि रक्षसाम्।\nकायानाविविशुस्तिग्मा गिरीनशनयो यथा॥ ४/११/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.018.m4a", "display_order": 19}, {"id": 6000075019, "chapter_id": 10075, "verse_number": "४-११-१८", "content_sanskrit": "भल्लैः संछिद्यमानानां शिरोभिश्चारुकुण्डलैः।\nऊरुभिर्हेमतालाभैर्दोर्भिर्वलयवल्गुभिः॥ ४/११/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.019.m4a", "display_order": 20}, {"id": 6000075020, "chapter_id": 10075, "verse_number": "४-११-१९", "content_sanskrit": "हारकेयूरमुकुटैरुष्णीषैश्च महाधनैः।\nआस्तृतास्ता रणभुवो रेजुर्वीरमनोहराः॥ ४/११/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.020.m4a", "display_order": 21}, {"id": 6000075021, "chapter_id": 10075, "verse_number": "४-११-२०", "content_sanskrit": "हतावशिष्टा इतरे रणाजिराद् रक्षोगणाः क्षत्रियवर्यसायकैः।\nप्रायो विकृन्तावयवा विदुद्रुवुर्मृगेन्द्रविक्रीडितयूथपा इव॥ ४/११/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.021.m4a", "display_order": 22}, {"id": 6000075022, "chapter_id": 10075, "verse_number": "४-११-२१", "content_sanskrit": "अपश्यमानः स तदाऽऽततायिनं महामृधे कंचन मानवोत्तमः।\nपुरीं दिदृक्षन्नपि नाविशद् द्विषां न मायिनां वेद चिकीर्षितं जनः॥ ४/११/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.022.m4a", "display_order": 23}, {"id": 6000075023, "chapter_id": 10075, "verse_number": "४-११-२२", "content_sanskrit": "इति ब्रुवंश्चित्ररथः स्वसारथिं यत्तः परेषां प्रतियोगशङ्कितः।\nशुश्राव शब्दं जलधेरिवेरितं नभस्वता दिक्षु रजोऽन्वदृश्यत॥ ४/११/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.023.m4a", "display_order": 24}, {"id": 6000075024, "chapter_id": 10075, "verse_number": "४-११-२३", "content_sanskrit": "क्षणेनाच्छादितं व्योम घनानीकेन सर्वतः।\nविस्फुरत्तडिता दिक्षु त्रासयंस्तनयित्नुना॥ ४/११/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.024.m4a", "display_order": 25}, {"id": 6000075025, "chapter_id": 10075, "verse_number": "४-११-२४", "content_sanskrit": "ववृषू रुधिरौघास्थिपूयविण्मूत्ररेतसः।\nनिपेतुर्गगनादस्य कबन्धान्यग्रतोऽनघ॥ ४/११/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.025.m4a", "display_order": 26}, {"id": 6000075026, "chapter_id": 10075, "verse_number": "४-११-२५", "content_sanskrit": "ततः खेऽदृश्यत गिरेर्निपेतुः सर्वतो दिशम्।\nगदापरिघनिस्‍त्रिंशमुसला अश्मवर्षिणः॥ ४/११/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.026.m4a", "display_order": 27}, {"id": 6000075027, "chapter_id": 10075, "verse_number": "४-११-२६", "content_sanskrit": "अहयोऽशनिनिःश्वासा वमन्तोऽग्निं रुषाऽक्षिभिः।\nअभ्यधावन् गजा मत्ताः सिंहव्याघ्राश्च यूथशः॥ ४/११/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.027.m4a", "display_order": 28}, {"id": 6000075028, "chapter_id": 10075, "verse_number": "४-११-२७", "content_sanskrit": "समुद्र ऊर्मिभिर्भीमः प्लावयन् सर्वतो भुवम्।\nआससाद महाह्रादः कल्पान्त इव भीषणः॥ ४/११/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.028.m4a", "display_order": 29}, {"id": 6000075029, "chapter_id": 10075, "verse_number": "४-११-२८", "content_sanskrit": "एवंविधान्यनेकानि त्रासनान्यमनस्विनाम्।\nससृजुस्तिग्मगतय आसुर्या माययाऽसुराः॥ ४/११/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.029.m4a", "display_order": 30}, {"id": 6000075030, "chapter_id": 10075, "verse_number": "४-११-२९", "content_sanskrit": "ध्रुवे प्रयुक्तामसुरैस्तां मायामतिदुस्तराम्।\nनिशाम्य तस्य मुनयः समाशंसन् समागताः॥ ४/११/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.030.m4a", "display_order": 31}, {"id": 6000075031, "chapter_id": 10075, "verse_number": null, "content_sanskrit": "मुनय ऊचुः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.031.m4a", "display_order": 32}, {"id": 6000075032, "chapter_id": 10075, "verse_number": "४-११-३०", "content_sanskrit": "औत्तानपादे भगवांस्तव शार्ङ्गधन्वा देवः क्षिणोत्ववनतार्तिहरो विपक्षान्।\nयन्नामधेयमभिधाय निशम्य चाद्धा लोकोऽञ्जसा तरति दुस्तरमङ्ग मृत्युम्॥ ४/११/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.032.m4a", "display_order": 33}, {"id": 6000075033, "chapter_id": 10075, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.033.m4a", "display_order": 34}, {"id": 6000075034, "chapter_id": 10075, "verse_number": "४-११-३१", "content_sanskrit": "निशम्य वदतामेवम् ऋषीणां धनुषि ध्रुवः।\nसन्दधेऽस्‍त्रमुपस्पृश्य यन्नारायणनिर्मितम्॥ ४/११/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.034.m4a", "display_order": 35}, {"id": 6000075035, "chapter_id": 10075, "verse_number": "४-११-३२", "content_sanskrit": "सन्धीयमान एतस्मिन् माया गुह्यकनिर्मिताः।\nक्षिप्रं विनेशुर्विदुर क्लेशा ज्ञानोदये यथा॥ ४/११/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.035.m4a", "display_order": 36}, {"id": 6000075036, "chapter_id": 10075, "verse_number": "४-११-३३", "content_sanskrit": "तस्यार्षास्‍त्रं धनुषि प्रयुञ्जतः सुवर्णपुङ्खाः कलहंसवाससः।\nविनिःसृता आविविशुर्द्विषद्बलं वनं यथा भीमरवाः शिखण्डिनः॥ ४/११/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.036.m4a", "display_order": 37}, {"id": 6000075037, "chapter_id": 10075, "verse_number": "४-११-३४", "content_sanskrit": "तैस्तिग्मधारैः प्रधने शिलीमुखैरितस्ततः पुण्यजना उपद्रुताः।\nतमभ्यधावन् कुपिता उदायुधाः सुपर्णमुन्नद्धफणा इवाहयः॥ ४/११/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.037.m4a", "display_order": 38}, {"id": 6000075038, "chapter_id": 10075, "verse_number": "४-११-३५", "content_sanskrit": "स तान् पृषत्कैरभिधावतो मृधे निकृत्तबाहूरुशिरोधरोदरान्।\nनिनाय लोकं परमर्कमण्डलं व्रजन्ति निर्भिद्य यमूर्ध्वरेतसः॥ ४/११/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.038.m4a", "display_order": 39}, {"id": 6000075039, "chapter_id": 10075, "verse_number": "४-११-३६", "content_sanskrit": "तान् हन्यमानानभिवीक्ष्य गुह्यकाननागसश्चित्ररथेन भूरिशः।\nऔत्तानपादिं कृपया पितामहो मनुर्जगादोपगतः सहर्षिभिः॥ ४/११/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.039.m4a", "display_order": 40}, {"id": 6000075040, "chapter_id": 10075, "verse_number": null, "content_sanskrit": "मनुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.040.m4a", "display_order": 41}, {"id": 6000075041, "chapter_id": 10075, "verse_number": "४-११-३७", "content_sanskrit": "अलं वत्सातिरोषेण तमोद्वारेण पाप्मना।\nयेन पुण्यजनानेतानवधीस्त्वमनागसः॥ ४/११/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.041.m4a", "display_order": 42, "topics": [{"text": "मनुना ध्रुवं प्रति युद्धविरामोपदेशः", "range": "३७–६६"}]}, {"id": 6000075042, "chapter_id": 10075, "verse_number": "४-११-३८", "content_sanskrit": "नास्मत्कुलोचितं तात कर्मैतत् सद्विगर्हितम्।\nवधोऽयमुपदेवानामारब्धस्तेऽकृतैनसाम्॥ ४/११/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.042.m4a", "display_order": 43}, {"id": 6000075043, "chapter_id": 10075, "verse_number": "४-११-३९", "content_sanskrit": "नन्वेकस्यापराधेन तत्सङ्गाद् बहवो हताः।\nभ्रातुर्वधाभितप्तेन त्वयाऽङ्ग भ्रातृवत्सल॥ ४/११/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.043.m4a", "display_order": 44}, {"id": 6000075044, "chapter_id": 10075, "verse_number": "४-११-४०", "content_sanskrit": "नायं मार्गो हि साधूनां हृषीकेशानुवर्तिनाम्।\nयदात्मानमसङ्गृह्य पशुवद् भूतवैशसम्॥ ४/११/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.044.m4a", "display_order": 45}, {"id": 6000075045, "chapter_id": 10075, "verse_number": "४-११-४१", "content_sanskrit": "सर्वभूतात्मभावेन भूतावासं हरिं भवान्।\nआराध्याप दुराराध्यं विष्णोस्तत् परमं पदम्॥ ४/११/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.045.m4a", "display_order": 46}, {"id": 6000075046, "chapter_id": 10075, "verse_number": "४-११-४२", "content_sanskrit": "स त्वं हरेरनुध्यातः तत्पुंसामपि संमतः।\nकथं त्ववद्यं कृतवाननुशिक्षन् सतां व्रतम्॥ ४/११/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.046.m4a", "display_order": 47}, {"id": 6000075047, "chapter_id": 10075, "verse_number": "४-११-४३", "content_sanskrit": "तितिक्षया करुणया मैत्र्या चाखिलजन्तुषु।\nसमत्वेन च सर्वात्मा भगवान् संप्रसीदति॥ ४/११/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.047.m4a", "display_order": 48}, {"id": 6000075048, "chapter_id": 10075, "verse_number": "४-११-४४", "content_sanskrit": "संप्रसन्ने भगवति पुरुषः प्राकृतैर्गुणैः।\nविमुक्तो जीवनिर्मुक्तो ब्रह्म निर्वाणमृच्छति॥ ४/११/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.048.m4a", "display_order": 49}, {"id": 6000075049, "chapter_id": 10075, "verse_number": "४-११-४५", "content_sanskrit": "भूतैः पञ्चभिरारब्धो योषित् पुरुष एव हि।\nतयोर्व्यवायात् संभूतिर्योषित्पुरुषयोरिह॥ ४/११/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.049.m4a", "display_order": 50}, {"id": 6000075050, "chapter_id": 10075, "verse_number": "४-११-४६", "content_sanskrit": "एवं प्रवर्तते सर्गः स्थितिः प्रलय एव च।\nगुणव्यतिकराद् राजन् मायया परमात्मनः॥ ४/११/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.050.m4a", "display_order": 51}, {"id": 6000075051, "chapter_id": 10075, "verse_number": "४-११-४७", "content_sanskrit": "निमित्तमात्रं तत्रात्मा निर्गुणः पुरुषर्षभः।\nव्यक्ताव्यक्तमिदं विश्वं यत्र भ्रमति लोहवत्॥ ४/११/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.051.m4a", "display_order": 52}, {"id": 6000075052, "chapter_id": 10075, "verse_number": "४-११-४८", "content_sanskrit": "स खल्विदं भगवान् योगशक्त्या गुणप्रवाहेषु विभक्तवीर्यः।\nकरोत्यकर्तेव निहन्त्यहन्ता चेष्टा विभूम्नः खलु दुर्विभाव्या॥ ४/११/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.052.m4a", "display_order": 53}, {"id": 6000075053, "chapter_id": 10075, "verse_number": "४-११-४९", "content_sanskrit": "सोऽनन्तोऽन्तकरः कालोऽनादिरादिकृदव्ययः।\nजनं जनेन जनयन् मारयन् मृत्युनाऽऽत्मनः॥ ४/११/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.053.m4a", "display_order": 54}, {"id": 6000075054, "chapter_id": 10075, "verse_number": "४-११-५०", "content_sanskrit": "न वै स्वपक्षोऽस्य विपक्ष एव वा परस्य मृत्योर्विशतः समं प्रजाः।\nतं धावमानमनुधावन्त्यनीशा यथा रजांस्यनिलं भूतसङ्घाः॥ ४/११/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.054.m4a", "display_order": 55}, {"id": 6000075055, "chapter_id": 10075, "verse_number": "४-११-५१", "content_sanskrit": "आयुषोऽपचयं जन्तोस्तथैवोपचयं विभुः।\nउभाभ्यां रहितः स्वस्थो दुःस्थस्य विदधात्यसौ॥ ४/११/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.055.m4a", "display_order": 56}, {"id": 6000075056, "chapter_id": 10075, "verse_number": "४-११-५२", "content_sanskrit": "केचित् कर्म वदन्त्येनं स्वभावमपरे नृप।\nएके कालं परे दैवं पुंसः काममुतापरे॥ ४/११/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.056.m4a", "display_order": 57}, {"id": 6000075057, "chapter_id": 10075, "verse_number": "४-११-५३", "content_sanskrit": "अव्यक्तस्याप्रमेयस्य नानाशक्त्युदयस्य च।\nन वै चिकीर्षितं तात को वेदाद्धाऽस्य सम्भवम्॥ ४/११/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.057.m4a", "display_order": 58}, {"id": 6000075058, "chapter_id": 10075, "verse_number": "४-११-५४", "content_sanskrit": "नैवैते पुत्रक भ्रातुर्हन्तारो धनदानुगाः।\nविसर्गादानयोस्तात पुंसो दैवं हि कारणम्॥ ४/११/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.058.m4a", "display_order": 59}, {"id": 6000075059, "chapter_id": 10075, "verse_number": "४-११-५५", "content_sanskrit": "स एव विश्वं सृजति स एवावति हन्ति च।\nअथापि ह्यनहंकारान्नाज्यते गुणकर्मभिः॥ ४/११/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.059.m4a", "display_order": 60}, {"id": 6000075060, "chapter_id": 10075, "verse_number": "४-११-५६", "content_sanskrit": "एष भूतानि भूतात्मा भूतेशो भूतभावनः।\nस्वशक्त्या मायया युक्तः सृजत्यत्ति च पाति च॥ ४/११/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.060.m4a", "display_order": 61}, {"id": 6000075061, "chapter_id": 10075, "verse_number": "४-११-५७", "content_sanskrit": "तमेव मृत्युममृतं तात दैवं सर्वात्मनोपैहि जगत्परायणम्।\nयस्मै बलिं विश्वसृजो हरन्ति गावो यथा वै नसि दामयन्त्रिताः॥ ४/११/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.061.m4a", "display_order": 62}, {"id": 6000075062, "chapter_id": 10075, "verse_number": "४-११-५८", "content_sanskrit": "यः पञ्चवर्षो जननीं त्वं विहाय मातुः सपत्न्या वचसा भिन्नवर्मा।\nवनं गतस्तपसा प्रत्यगक्षमाराध्य लेभे मूर्ध्नि पदं त्रिलोक्याः॥ ४/११/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.062.m4a", "display_order": 63}, {"id": 6000075063, "chapter_id": 10075, "verse_number": "४-११-५९", "content_sanskrit": "तमेवमङ्गात्मनि मुक्तविग्रहैर्व्यपाश्रितं निर्गुणमेकमक्षरम्।\nआत्मानमन्विष्य विमुक्तिमात्मदृग् यस्मिन्निदं भिन्नमसत् प्रतीयते॥ ४/११/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.063.m4a", "display_order": 64}, {"id": 6000075064, "chapter_id": 10075, "verse_number": "४-११-६०", "content_sanskrit": "त्वं प्रत्यगात्मनि सदा भगवत्यनन्त आनन्दमात्र उपपन्नसमस्तशक्तौ।\nभक्तिं विधाय परमां शनकैरविद्याग्रन्थिं विभेत्स्यसि ममाहमिति प्ररूढाम्॥ ४/११/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.064.m4a", "display_order": 65}, {"id": 6000075065, "chapter_id": 10075, "verse_number": "४-११-६१", "content_sanskrit": "संयच्छ रोषं भद्रं ते प्रतीपं श्रेयसां परम्।\nश्रुतेन भूयसा राजन्नगदेन यथाऽऽमयम्॥ ४/११/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.065.m4a", "display_order": 66}, {"id": 6000075066, "chapter_id": 10075, "verse_number": "४-११-६२", "content_sanskrit": "येनोपसृष्टात् पुरुषाल्लोक उद्विजते भृशम्।\nन बुधस्तद्वशं गच्छेदिच्छन्नभयमात्मनः॥ ४/११/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.066.m4a", "display_order": 67}, {"id": 6000075067, "chapter_id": 10075, "verse_number": "४-११-६३", "content_sanskrit": "हेलनं गिरिशभ्रातुर्धनदस्य त्वया कृतम्।\nयज्‍जघ्निवान् पुण्यजनान् भ्रातृघ्नानित्यमर्षितः॥ ४/११/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.067.m4a", "display_order": 68}, {"id": 6000075068, "chapter_id": 10075, "verse_number": "४-११-६४", "content_sanskrit": "तं प्रसादय वत्साशु सन्नत्या प्रश्रयोक्तिभिः।\nन यावन्महतां तेजः कुलं नाभिभविष्यति॥ ४/११/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.068.m4a", "display_order": 69}, {"id": 6000075069, "chapter_id": 10075, "verse_number": "४-११-६५", "content_sanskrit": "इत्युक्तस्तं प्रणम्याह भगवंस्तेऽनुशासनम्।\nआतिष्ठे भ्रातृमात्रोर्मे शोचतः क्षम्यतामिति॥ ४/११/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.069.m4a", "display_order": 70}, {"id": 6000075070, "chapter_id": 10075, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.070.m4a", "display_order": 71}, {"id": 6000075071, "chapter_id": 10075, "verse_number": "४-११-६६", "content_sanskrit": "एवं स्वायम्भुवः पौत्रमनुशास्य मनुर्ध्रुवम्।\nतेनाभिवन्दितः साकमृषिभिः स्वपुरं ययौ॥ ४/११/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_011/BhP_04.011.071.m4a", "display_order": 72}, {"id": 6000075072, "chapter_id": 10075, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे एकादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]