[{"id": 2102157, "chapter_id": 3205, "verse_number": "१४-६१-१", "content_sanskrit": "वैशम्पायन उवाच।\nकथयन्नेव तु तदा वासुदेवः प्रतापवान्।\nमहाभारतयुद्धं तत्कथान्ते पितुरग्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102158, "chapter_id": 3205, "verse_number": "१४-६१-२", "content_sanskrit": "अभिमन्योर्वधं वीरः सोत्यक्रामन्महामतिः।\nअप्रियं वसुदेवस्य माभूदिति महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102159, "chapter_id": 3205, "verse_number": "१४-६१-३", "content_sanskrit": "मा दौहित्रवधं श्रुत्वा वसुदेवो महात्ययम्।\nदुःखशोकाभिसंतप्तो भवेदिति महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102160, "chapter_id": 3205, "verse_number": "१४-६१-४", "content_sanskrit": "सुभद्रा तु तमुत्क्रान्तमात्मजस्य वधं रणे।\nआचक्ष्व कृष्ण सौभद्रवधमित्यपतद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102161, "chapter_id": 3205, "verse_number": "१४-६१-५", "content_sanskrit": "तामपश्यन्निपतितां वसुदेवः क्षितौ तदा।\nदृष्ट्वैव च पपातोर्व्यां सोऽपि दुःखेन मूर्छितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102162, "chapter_id": 3205, "verse_number": "१४-६१-६", "content_sanskrit": "तषः स दौहित्रवदाद्दुःखशोकसमाहतः।\nवसुदेवो महाराज कृष्णं वाक्यमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102163, "chapter_id": 3205, "verse_number": "१४-६१-७", "content_sanskrit": "ननु त्वं पुण्डरीकाक्ष सत्यवाग्भुवि विश्रुतः।\nयद्दौहित्रवधं मेऽद्य न ख्यापयसि शत्रुहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102164, "chapter_id": 3205, "verse_number": "१४-६१-८", "content_sanskrit": "तद्भागिनेयनिधनं तत्त्वेनाचक्ष्व मे प्रभो।\nसदृशाक्षस्तव कथं शत्रुभिर्निहतो रणे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102165, "chapter_id": 3205, "verse_number": "१४-६१-९", "content_sanskrit": "दुर्भरं बत वार्ष्णेय कालेऽप्राप्ते नृभिः सह।\nयत्र मे हृदयं दुःखाच्छतधा न विदीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102166, "chapter_id": 3205, "verse_number": "१४-६१-१०", "content_sanskrit": "किमब्रवीत्त्वां सङ्ग्रामे सुभद्रां मातरं प्रति।\nमां चापि पुण्डरीकाक्षि चपलाक्षः प्रियो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102167, "chapter_id": 3205, "verse_number": "१४-६१-११", "content_sanskrit": "आहवं पृष्ठतः कृत्वा कच्चिन्न निहतः परैः।\nकच्चिन्मुखं न गोविन्द तेनाजौ विकृतं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102168, "chapter_id": 3205, "verse_number": "१४-६१-१२", "content_sanskrit": "स हि कृष्ण महातेजाः श्लाघन्निव ममाग्रतः।\nबालभावेन विजयमात्मनोऽकथयत्प्रभुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102169, "chapter_id": 3205, "verse_number": "१४-६१-१३", "content_sanskrit": "कच्चिन्न निकृतो बालो द्रोणकर्णाकृपादिभिः।\nधरण्यां निहतः शेते तन्ममाचक्ष्वि केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102170, "chapter_id": 3205, "verse_number": "१४-६१-१४", "content_sanskrit": "स हि द्रोणं च भीष्मं च कर्णं च बलीनां वरम्।\nस्पर्धते स्म रणे नित्यं दुहितुः पुत्रको मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102171, "chapter_id": 3205, "verse_number": "१४-६१-१५", "content_sanskrit": "एवंविधं बहु तदा विलपन्तं सुदुःखितम्।\nपितरं दुःखिततरं गोविन्दो वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102172, "chapter_id": 3205, "verse_number": "१४-६१-१६", "content_sanskrit": "न तेनि विकृतं वक्त्रं कृतं सङ्ग्राममूर्धनि।\nन पृष्ठतः कृतश्चापि सङ्ग्रामस्तेन दुस्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102173, "chapter_id": 3205, "verse_number": "१४-६१-१७", "content_sanskrit": "निहत्य पृथिवीपालान्सहस्रशतसङ्घशः।\nखेदितो द्रोणकर्णाभ्यां दौःशासनिवशं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102174, "chapter_id": 3205, "verse_number": "१४-६१-१८", "content_sanskrit": "एको ह्येकेन सततं युध्यमानो यदि प्रभो।\nन स शक्येत सङ्ग्रामे निहन्तुमपि वज्रिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102175, "chapter_id": 3205, "verse_number": "१४-६१-१९", "content_sanskrit": "समाहूते च सङ्ग्रामे पार्थे संशप्तकैस्तदा।\nपर्यवार्यत संक्रुद्धैः स द्रोणादिभिराहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102176, "chapter_id": 3205, "verse_number": "१४-६१-२०", "content_sanskrit": "ततः शत्रुवधं कृत्वा सुमहान्तं रेणे पितः।\nदौहित्रस्तव वार्ष्णेय दौःशासनिवशं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102177, "chapter_id": 3205, "verse_number": "१४-६१-२१", "content_sanskrit": "नूनं च स गतः स्वर्गं जहि शोकं महामते।\nन हि व्यसनमासाद्य सीदन्ति कृतबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102178, "chapter_id": 3205, "verse_number": "१४-६१-२२", "content_sanskrit": "द्रोणकर्णप्रभृतयो येन प्रतिसमासिताः।\nरणे महेन्द्रप्रतिमाः स कथं नाप्नुयाद्दिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102179, "chapter_id": 3205, "verse_number": "१४-६१-२३", "content_sanskrit": "स शोकं जहि जुर्धर्ष मा च मन्युवशं गमः।\nशस्त्रपूतां हि स गतिं गतः परपुरंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102180, "chapter_id": 3205, "verse_number": "१४-६१-२४", "content_sanskrit": "तस्मिंस्तु निहते वीरे सुभद्रेयं स्वसा मम।\nदुःखार्ताऽथो सुतं प्राप्य कुररीव ननाद ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102181, "chapter_id": 3205, "verse_number": "१४-६१-२५", "content_sanskrit": "द्रौपदीं च समासाद्य पर्यतप्यत दुःखिता।\nआर्ये क्व दारकाः सर्वे द्रष्टुमिच्छामि तानहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102182, "chapter_id": 3205, "verse_number": "१४-६१-२६", "content_sanskrit": "अस्यास्तु वचनं श्रुत्वा सर्वास्ताः कुरुयोषितः।\nभुजाभ्यां परिगृह्यैनां चुक्रुशुः परमार्तवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102183, "chapter_id": 3205, "verse_number": "१४-६१-२७", "content_sanskrit": "उत्तरां चाब्रवीद्भद्रे भर्ता स क्व नु ते गतः।\nक्षिप्रमागमनं मह्यं तस्य त्वं वेदयस्व ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2102184, "chapter_id": 3205, "verse_number": "१४-६१-२८", "content_sanskrit": "ननु नामाद्य वैराटि श्रुत्वा मम गिरं सदा।\nभवनान्निष्पतत्याशु कस्मान्नाभ्येति ते पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2102185, "chapter_id": 3205, "verse_number": "१४-६१-२९", "content_sanskrit": "अभिमन्योऽनुशयिनो मातुलास्ते महारथाः।\nकुशलं चाब्रुवन्सर्वे त्वां युयुत्सुमिहागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2102186, "chapter_id": 3205, "verse_number": "१४-६१-३०", "content_sanskrit": "आचक्ष्व मेऽद्य सङ्ग्रामं यथापूर्वमरिन्दम।\nकस्मादेवं विलपतीं नाद्येह प्रतिभाषसे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2102187, "chapter_id": 3205, "verse_number": "१४-६१-३१", "content_sanskrit": "एवमादि तु वार्ष्णेय्यास्तस्यास्तत्परिदेवितम्।\nश्रुत्वा पृथा सुदुःखार्ता शनैर्वाक्यमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2102188, "chapter_id": 3205, "verse_number": "१४-६१-३२", "content_sanskrit": "सुभद्रे वासुदेवेन तथा सात्यकिना रणे।\nपित्रा च लालितो बालः स हतः कालधर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2102189, "chapter_id": 3205, "verse_number": "१४-६१-३३", "content_sanskrit": "ईदृशो मर्त्यधर्मोऽयं मा शुचो यदुनन्दिनि।\nपुत्रो हि तव दुर्धर्षः सम्प्राप्तः परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2102190, "chapter_id": 3205, "verse_number": "१४-६१-३४", "content_sanskrit": "कुले महति जातासि क्षत्रियाणां महात्मनाम्।\nमा शुचश्चपलाक्षं त्वं पद्मपत्रनिभेक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2102191, "chapter_id": 3205, "verse_number": "१४-६१-३५", "content_sanskrit": "उत्तरां त्वमवेक्षस्व गुर्विणीं मा शुचः शुभे।\nपुत्रमेषा हि तस्याशु जनयिष्यति भामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2102192, "chapter_id": 3205, "verse_number": "१४-६१-३६", "content_sanskrit": "एवमाश्वासयित्वैनां कुन्ती यदुकुलोद्वह।\nविहाय शोकं दुर्धर्षं श्राद्धमस्य ह्यकल्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2102193, "chapter_id": 3205, "verse_number": "१४-६१-३७", "content_sanskrit": "समनुज्ञाप्य धर्मज्ञं राजानं भीममेव च।\nयमौ यमोपमौ चैव ददौ दानान्यनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2102194, "chapter_id": 3205, "verse_number": "१४-६१-३८", "content_sanskrit": "ततः प्रदाय बह्वीर्गा ब्राह्मणेभ्यो यदूद्वह।\nसमाहृष्य तु वार्ष्णेयी वैराटीमब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2102195, "chapter_id": 3205, "verse_number": "१४-६१-३९", "content_sanskrit": "वैराटि नेह संतापस्त्वया कार्यो ह्यनिन्दिते।\nभर्तारं प्रति सुश्रोणि गर्भस्थं रक्ष वै शिशुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2102196, "chapter_id": 3205, "verse_number": "१४-६१-४०", "content_sanskrit": "एवमुक्त्वा ततः कुन्ती विरराम महाद्युते।\nतामनुज्ञाप्य चैवेमां सुभद्रां समुपानयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2102197, "chapter_id": 3205, "verse_number": "१४-६१-४१", "content_sanskrit": "एवं स निधनं प्राप्तो दौहित्रस्तव मानद।\nसंतापं त्यज दुर्धर्ष मा च शोके मनः कृथाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2102198, "chapter_id": 3205, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि एकषष्टितमोऽध्यायः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]