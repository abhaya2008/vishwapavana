[{"id": 2085676, "chapter_id": 2822, "verse_number": "१२-३२७-०x", "content_sanskrit": "`कपिल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085677, "chapter_id": 2822, "verse_number": "१२-३२७-१", "content_sanskrit": "यद्भवानाह किं व्यक्तिं किमव्यक्तमिति अत्र ब्रूमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085678, "chapter_id": 2822, "verse_number": "१२-३२७-२", "content_sanskrit": "अव्यक्तमग्राह्यमतर्क्यमपरिमेयमव्यक्तं व्यक्तमुपलक्ष्यते यथर्तवो मूर्तयस्तेषु पुष्पफलैर्व्यक्तिरुपलक्ष्यते तद्वद्व्यक्तगुणैरुपलक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085679, "chapter_id": 2822, "verse_number": "१२-३२७-३", "content_sanskrit": "प्राग्गतं प्रत्यग्गतमूर्ध्वमधस्तिर्यक्च शतश्चानुग्राह्यत्वात्साऽकृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085680, "chapter_id": 2822, "verse_number": "१२-३२७-४", "content_sanskrit": "व्यक्त उत्तमो रजः सत्वं तत्प्रधानं तत्वमक्षमजरमित्येवमादीन्यव्यक्तनामानि भवन्ति।\nएवमाह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085681, "chapter_id": 2822, "verse_number": "१२-३२७-५", "content_sanskrit": "अव्यक्तं बीजधर्माणं महाग्राहमचेतनम्।\nतस्मादेकगुणो जज्ञे तद्व्यक्तं तत्वमीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085682, "chapter_id": 2822, "verse_number": "१२-३२७-६", "content_sanskrit": "तदेतदव्यक्तम्। प्रस्नवा घारणादानस्वभावमापोधारणे प्रजनने दाने गुणानां प्रकृतिः सपराप्रमत्तं तदेतदस्मिन्कार्यकरणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085683, "chapter_id": 2822, "verse_number": "१२-३२७-७", "content_sanskrit": "यदप्युक्तं किमव्यक्तमिति तत्र ब्रूमः। व्यक्तं नामाऽऽसुरे यत्पूर्वमव्यक्तादुत्पन्नतत्वमीश्वरमप्रतिबुद्धगुणस्यगेतत्पुरुषसंज्ञिकं महदित्युक्तं बुद्धिरिति च। सत्ता स्मृतिर्धृतिर्मेधा व्यवसायः समाधिप्राप्तिरित्येवमादीनि व्यक्तपर्याये नामानि वदन्त्येवमाह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085684, "chapter_id": 2822, "verse_number": "१२-३२७-८", "content_sanskrit": "मम व्यक्तादुपात्तासिद्धिरागता संयमश्च महद्यतः।\nपरसर्गश्च दीप्त्यर्थमौत्सुक्यं च परं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085685, "chapter_id": 2822, "verse_number": "१२-३२७-९", "content_sanskrit": "यदेषोर्ध्यस्रोताभिर्महत्वादप्रतिबुद्धत्वाच्चात्मनः यकरोत्यहंकारमव्यक्ताव्यक्ततरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085686, "chapter_id": 2822, "verse_number": "१२-३२७-१०", "content_sanskrit": "यदप्युक्तं किमव्यक्ततरमिति अत्र ब्रूमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085687, "chapter_id": 2822, "verse_number": "१२-३२७-११", "content_sanskrit": "व्यक्ताव्यक्ततरं नाम तृतीयं पुरुषसंज्ञकम्।\nतदेतदुभयोर्विरिञ्चवैरिञ्चयोरेकैक उत्पत्तिः॥\nविरिञ्चोऽभिमानिन्यविवेक ईर्ष्या कामः क्रोधो लोभो मदो दर्पो ममकारश्चैतान्यहंकारपर्यायनामानि भवन्त्येवमाह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085688, "chapter_id": 2822, "verse_number": "१२-३२७-१३", "content_sanskrit": "अहं कर्तेत्यहंकर्ता ससृजे विश्वमीश्वरः।\nतृतीयमेनं पुरुषमभिमानगुणं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085689, "chapter_id": 2822, "verse_number": "१२-३२७-१४", "content_sanskrit": "अहंकाराद्युगपदुन्मादयामास पञ्च महाभूतानि शब्दस्पर्शरूपरसगन्धलक्षणानि। तान्येव बुद्ध्यन्त इत्येवमाह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085690, "chapter_id": 2822, "verse_number": "१२-३२७-१५", "content_sanskrit": "भूतसङ्घमहङ्काराद्यो विद्वानवबुध्यसे।\nअभिमानमतिक्रम्य महान्तं प्रतितिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085691, "chapter_id": 2822, "verse_number": "१२-३२७-१६", "content_sanskrit": "भूतेषु चाप्यहंकारमश्वरूपस्तथोच्यते।\nपुनर्विषयहेत्वर्थे स मनस्संज्ञकः स्मृतः॥\nविखराद्वैखरं युगपदिन्द्रियैः सहोत्पादयति। श्रोत्रं घ्राणं चक्षुर्जिह्वा त्वगित्येतानि शब्दस्पर्शरूपरसगन्धानवबुध्यन्त इति पञ्च बुद्धीन्द्रियाणि वदन्त्येवमाहुराचार्याः॥\nवाग्घस्तौ पादपायुरानन्दश्चेति पञ्चेन्द्रियाणि विशेषमादित्योश्वीनि नक्षत्राणीत्येतानीन्द्रियाणां पर्यायनामानि वदन्त्येवमाह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085692, "chapter_id": 2822, "verse_number": "१२-३२७-१९", "content_sanskrit": "अहंकारात्तथा भूतान्युत्पाद्य महदात्मनोः।\nवैखरत्वं ततो राज्ञा वैखर्यो विषयात्मकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085693, "chapter_id": 2822, "verse_number": "१२-३२७-२०", "content_sanskrit": "विकारस्थमहंकारमवबुध्याथ मानवः।\nमहदैश्वर्यमाप्नोति यावदाचन्द्रतारकम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085694, "chapter_id": 2822, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपरर्वणि मोक्षधर्मपर्वणि सप्तविंशत्यधिकत्रिशततमोऽध्यायः॥ ३२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]