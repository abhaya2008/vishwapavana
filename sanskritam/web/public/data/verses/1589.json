[{"id": 2027378, "chapter_id": 1589, "verse_number": "३-२२७-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027379, "chapter_id": 1589, "verse_number": "३-२२७-१", "content_sanskrit": "शिवा भार्या त्वङ्गिरसः शीलरूपगुणान्विता।\nतस्याः सा प्रथमं रूपं कृत्वादेवी जनाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027380, "chapter_id": 1589, "verse_number": "३-२२७-२", "content_sanskrit": "जगाम पावकाभ्याशं तं चोवाच वराङ्गना।\nमामग्ने कामसंतप्तां त्वं कामयितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027381, "chapter_id": 1589, "verse_number": "३-२२७-३", "content_sanskrit": "करिष्यसि न चेदेवं मृतां मामुपधारय।\n`तवाप्यधर्मः सुमहान्भविता वै हुताशन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027382, "chapter_id": 1589, "verse_number": "३-२२७-४", "content_sanskrit": "अहमङ्गिरसो भार्या शिवा नाम हुताशन।\nसखीभिः सहिता प्राप्ता मन्त्रयित्वा विनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027383, "chapter_id": 1589, "verse_number": "३-२२७-५x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027384, "chapter_id": 1589, "verse_number": "३-२२७-५", "content_sanskrit": "कथं मां त्वं विजानीषे कामार्तमितराः कथम्।\nयास्त्वया कीर्तिताः सर्वाः सप्तर्षीणां प्रियाः स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027385, "chapter_id": 1589, "verse_number": "३-२२७-६x", "content_sanskrit": "शिवोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027386, "chapter_id": 1589, "verse_number": "३-२२७-६", "content_sanskrit": "अस्माकं त्वं प्रियो नित्यं बिभीमस्तु वयं तव।\nत्वच्चित्तमिङ्गितैर्ज्ञात्वा प्रेषिताऽस्मि तवान्तिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027387, "chapter_id": 1589, "verse_number": "३-२२७-७", "content_sanskrit": "मैथुनायेह संप्राप्ता कामाच्चैव द्रुतं च माम्।\n`उपयन्तुं महावीर्य पूर्वमेव त्वमर्हसि।\n[जामयो मां प्रतीक्षन्ते गमिष्यामि हुताशन] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027388, "chapter_id": 1589, "verse_number": "३-२२७-८x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027389, "chapter_id": 1589, "verse_number": "३-२२७-८", "content_sanskrit": "ततोऽग्निरुपयेमे तां शिवां प्रीतिमुदायुतः।\nप्रीत्या देवी समायुक्ता शुक्रं जग्राह पाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027390, "chapter_id": 1589, "verse_number": "३-२२७-९", "content_sanskrit": "साऽचन्तयन्ममेदं ये रूपं द्रक्ष्यन्ति कानने।\nते ब्राह्मणीनामनृतं दोषं वक्ष्यन्ति पावके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027391, "chapter_id": 1589, "verse_number": "३-२२७-१०", "content_sanskrit": "तस्मादेतद्रक्षमाणआ गरुडी संभवाम्यहम्।\nवनान्निर्गमनं चैव सुखं मम भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027392, "chapter_id": 1589, "verse_number": "३-२२७-११x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027393, "chapter_id": 1589, "verse_number": "३-२२७-११", "content_sanskrit": "सुपर्णी सा तदा भूत्वा निर्जगाम महावनात्।\nउपश्यत्पर्वतं श्वेतं शरस्तम्बैः सुसंवृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027394, "chapter_id": 1589, "verse_number": "३-२२७-१२", "content_sanskrit": "दृष्टीविषैः सप्तशीर्षैर्गुप्तं भोगिभिरद्भुतैः।\nरक्षोभिश्च पिशाचैश्च रौद्रैर्भूतगणैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027395, "chapter_id": 1589, "verse_number": "३-२२७-१३", "content_sanskrit": "राक्षसीभिश्च संपूर्णमनेकैश्च मृगद्विजैः।\n`नदीप्रस्रवणोपेतं नानातरुलताचितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027396, "chapter_id": 1589, "verse_number": "३-२२७-१४", "content_sanskrit": "सा तत्र सहसा गत्वा शैलपृष्ठं सुदुर्गमम्।\nप्राक्षिपत्काञ्चने कुण्डे शुक्रं सा त्वरिता शुभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027397, "chapter_id": 1589, "verse_number": "३-२२७-१५", "content_sanskrit": "शिष्टानामपि सा देवी सप्तर्षीणां महात्मनाम्।\nपत्नीसरूपतां कृत्वा रमयामास पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027398, "chapter_id": 1589, "verse_number": "३-२२७-१६", "content_sanskrit": "दिव्यरूपमरुन्धत्याः कर्तुं न शकितं तया।\nतस्यास्तपःप्रभावेण भर्तृशुश्रूषणेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027399, "chapter_id": 1589, "verse_number": "३-२२७-१७", "content_sanskrit": "षट्कृत्वस्तत्तु निक्षिप्तमग्ने रेतः कुरुत्तम।\nतस्मन्कुण्डे प्रतिपदि कामिन्या स्वाहया तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027400, "chapter_id": 1589, "verse_number": "३-२२७-१८", "content_sanskrit": "तत्स्कन्नं तेजसा तत्रसंवृतंजनयत्सुतम्।\nऋषिभिः पूजितं स्कन्नमनयन्स्कन्दतां ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027401, "chapter_id": 1589, "verse_number": "३-२२७-१९", "content_sanskrit": "षट्शिरा द्विगुणश्रोत्रो द्वादशाक्षिभूजक्रमः।\nएकग्रीवस्त्वेककायः कुमारः समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027402, "chapter_id": 1589, "verse_number": "३-२२७-२०", "content_sanskrit": "द्वितीयायामभिव्यक्तस्तृतीयायां शिशुर्बभौ।\nअङ्गप्रत्यङ्गसंभूतश्चतुर्थ्यामभवद्गुहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027403, "chapter_id": 1589, "verse_number": "३-२२७-२१", "content_sanskrit": "लोहिताभ्रेण महता संवृतः सह विद्युता।\nलोहिताभ्रे सुमहति भाति सूर्य इवोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027404, "chapter_id": 1589, "verse_number": "३-२२७-२२", "content_sanskrit": "गृहीतं तु धनुस्तेन विपुलं रोमहर्षणम्।\nन्यस्तं यत्रिपुरघ्नेन सुरारिविनिकृन्तनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2027405, "chapter_id": 1589, "verse_number": "३-२२७-२३", "content_sanskrit": "तद्गृहीत्वा धनुःश्रेष्ठं ननाद बलवांस्तदा।\nसंमोहयन्निमाँल्लोकान्गुहस्त्रीन्सचराचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2027406, "chapter_id": 1589, "verse_number": "३-२२७-२४", "content_sanskrit": "तस् तं निनदं श्रुत्वा महामेघौघनिःस्वनम्।\nउत्पेततुर्महानागौ चित्रश्चैरावतश्च ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2027407, "chapter_id": 1589, "verse_number": "३-२२७-२५", "content_sanskrit": "तावापतन्तौ संप्रेक्ष्यस बालोऽर्कसमद्युतिः।\nद्वाभ्यां गृहीत्वा पाणिभ्यां शक्तिं चान्येन पाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2027408, "chapter_id": 1589, "verse_number": "३-२२७-२६", "content_sanskrit": "अपरेणाग्निदायादस्ताम्रचूडं भुजेन सः।\nमहाकायमुपश्लिष्टं कुक्कुटं बलिनां वरम्।\nगृहीत्वा व्यनदद्भीमं चिक्रीड च महाभुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2027409, "chapter_id": 1589, "verse_number": "३-२२७-२७", "content_sanskrit": "द्वाभ्यां भुजाभ्यां बलवान्गृहीत्वा शङ्खमुत्तमम्।\nप्राध्मापयत् भूतानां त्रासनं बलिनामपि।\nद्वाभ्यां भुजाभ्यामाकाशं बहुशो निजघान ॥ ३-२२७-२८aक्रीडन्भाति महासेनस्त्रींल्लोकान्वदनैः पिवन्।\nपर्वताग्रेऽप्रमेयात्मा रश्मिमानुदये यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2027410, "chapter_id": 1589, "verse_number": "३-२२७-२९", "content_sanskrit": "स तस् पर्वतस्याग्रे निषण्णोऽद्भुतविक्रमः।\nव्यलोकयदमेयात्मा मुखैर्नानाविधैर्दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2027411, "chapter_id": 1589, "verse_number": "३-२२७-३०", "content_sanskrit": "स पश्यन्विविधान्भावांश्चकार निनदं पुनः।\nतस्य तं निनदं श्रुत्वा न्यपतन्बहुधा जनाः।\nभीताश्चोद्विग्रमनसस्तमेव शरणं ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2027412, "chapter_id": 1589, "verse_number": "३-२२७-३१", "content_sanskrit": "ये तुं संश्रिता देवं नानावर्णास्तदा जनाः।\nतानप्याहुः पारिषदान्ब्राह्मणाः सुमहाबलान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2027413, "chapter_id": 1589, "verse_number": "३-२२७-३२", "content_sanskrit": "स तूत्थाय महाबाहुरुपसान्त्व्य च ताञ्जनान्।\nधनुर्विकृष्य व्यसृजद्बाणाञ्श्वेते महागिरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2027414, "chapter_id": 1589, "verse_number": "३-२२७-३३", "content_sanskrit": "विभेद स शरैः शैलं क्रौञ्चं हिमवतः सुतम्।\nतेन हंसाश्च गृध्राश्च मेरुं गच्छन्ति पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2027415, "chapter_id": 1589, "verse_number": "३-२२७-३४", "content_sanskrit": "स विशीर्णोऽपतच्छैलो भृशमार्तस्वराव्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2027416, "chapter_id": 1589, "verse_number": "३-२२७-३५", "content_sanskrit": "तस्मिन्निपतिते त्वन्ये नेदुः शैला भृशं भयात्।\n`घोरमार्तस्वरं चक्रुर्दृष्ट्वा क्रौञ्चं विदारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2027417, "chapter_id": 1589, "verse_number": "३-२२७-३६", "content_sanskrit": "सतं नादं भृशार्तानां श्रुत्वाऽपि बलिनांवरः।\nन प्राव्यधदमेयात्मा शक्तिमुद्यम्य चानदत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2027418, "chapter_id": 1589, "verse_number": "३-२२७-३७", "content_sanskrit": "सा तदा विमला शक्तिः क्षिप्ता तेन महात्मना।\nबिभेद शिखरं घोरं श्वेतस् तरसा गिरेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2027419, "chapter_id": 1589, "verse_number": "३-२२७-३८", "content_sanskrit": "स तेनाभिहतो दीर्णो गिरिः श्वेतोऽचलैः सह।\nपलायत महीं त्यक्त्वा भीतस्तस्मान्महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2027420, "chapter_id": 1589, "verse_number": "३-२२७-३९", "content_sanskrit": "ततः प्रव्यथिता भूमिर्व्यशीर्यत समन्ततः।\nआर्ता स्कन्दं समासाद्य पुनर्बलवती बभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2027421, "chapter_id": 1589, "verse_number": "३-२२७-४०", "content_sanskrit": "पर्वताश्च नमस्कृत्यतमेव पृथिवीं गताः।\nअथैनमभजल्लोकः स्कन्दं शुक्लस्य पञ्चमीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2027422, "chapter_id": 1589, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रमार्कण्डेयसमास्यापर्वणि सप्तविंशत्यधिकद्विशततमोऽध्यायः ॥ २२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]