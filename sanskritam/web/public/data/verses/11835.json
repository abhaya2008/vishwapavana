[{"id": 50024163, "chapter_id": 11835, "verse_number": "1", "content_sanskrit": "॥ मधुच्छन्दा वैश्वामित्रः। इन्द्रः। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024164, "chapter_id": 11835, "verse_number": "2", "content_sanskrit": "सु॒रू॒प॒कृ॒त्नुमू॒तये॑ सु॒दुघा॑मिव गो॒दुहे॑। जु॒हू॒मसि॒ द्यवि॑द्यवि॥ ४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024165, "chapter_id": 11835, "verse_number": "3", "content_sanskrit": "उप॑ न॒ः सव॒ना ग॑हि॒ सोम॑स्य सोमपाः पिब। गो॒दा इद्रे॒वतो॒ मद॑ः॥ ४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024166, "chapter_id": 11835, "verse_number": "4", "content_sanskrit": "अथा॑ ते॒ अन्त॑मानां वि॒द्याम॑ सुमती॒नाम्। मा नो॒ अति॑ ख्य॒ आ ग॑हि॥ ४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024167, "chapter_id": 11835, "verse_number": "5", "content_sanskrit": "परे॑हि॒ विग्र॒मस्तृ॑त॒मिन्द्रं॑ पृच्छा विप॒श्चित॑म्। यस्ते॒ सखि॑भ्य॒ आ वर॑म्॥ ४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024168, "chapter_id": 11835, "verse_number": "6", "content_sanskrit": "उ॒त ब्रु॑वन्तु नो॒ निदो॒ निर॒न्यत॑श्चिदारत। दधा॑ना॒ इन्द्र॒ इद्दुव॑ः॥ ४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024169, "chapter_id": 11835, "verse_number": "7", "content_sanskrit": "उ॒त न॑ः सु॒भगाँ॑ अ॒रिर्वो॒चेयु॑र्दस्म कृ॒ष्टय॑ः। स्यामेदिन्द्र॑स्य॒ शर्म॑णि॥ ४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024170, "chapter_id": 11835, "verse_number": "8", "content_sanskrit": "एमा॒शुमा॒शवे॑ भर यज्ञ॒श्रियं॑ नृ॒माद॑नम्। प॒त॒यन्म॑न्द॒यत्स॑खम्॥ ४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024171, "chapter_id": 11835, "verse_number": "9", "content_sanskrit": "अ॒स्य पी॒त्वा श॑तक्रतो घ॒नो वृ॒त्राणा॑मभवः। प्रावो॒ वाजे॑षु वा॒जिन॑म्॥ ४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024172, "chapter_id": 11835, "verse_number": "10", "content_sanskrit": "तं त्वा॒ वाजे॑षु वा॒जिनं॑ वा॒जया॑मः शतक्रतो। धना॑नामिन्द्र सा॒तये॑॥ ४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024173, "chapter_id": 11835, "verse_number": "11", "content_sanskrit": "यो रा॒यो॒३॒॑ऽवनि॑र्म॒हान्सु॑पा॒रः सु॑न्व॒तः सखा॑। तस्मा॒ इन्द्रा॑य गायत॥ ४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]