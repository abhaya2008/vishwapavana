[{"id": 2006909, "chapter_id": 1135, "verse_number": "१-१३६-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006910, "chapter_id": 1135, "verse_number": "१-१३६-१", "content_sanskrit": "पाण्डोर्विदुर सर्वाणि प्रेतकार्याणि कारय।\nराजवद्राजसिंहस्य माद्र्याश्चैव विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006911, "chapter_id": 1135, "verse_number": "१-१३६-२", "content_sanskrit": "पशून्वासांसि रत्नानि धनानि विविधानि च।\nपाण्डोः प्रयच्छ माद्र्याश्च येभ्यो यावच्च वाञ्छितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006912, "chapter_id": 1135, "verse_number": "१-१३६-३", "content_sanskrit": "यथा च कुन्ती सत्कारं कुर्यान्माद्र्यास्तथा कुरु।\nयथा न वायुर्नादित्यः पश्येतां तां सुसंवृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006913, "chapter_id": 1135, "verse_number": "१-१३६-४", "content_sanskrit": "न शोच्यः पाण्डुरनघः प्रशस्यः स नराधिपः।\nयस्य पञ्च सुता वीरा जाताः सुरसुतोपमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006914, "chapter_id": 1135, "verse_number": "१-१३६-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006915, "chapter_id": 1135, "verse_number": "१-१३६-५", "content_sanskrit": "विदुरस्तं तथेत्युक्त्वा भीष्मेण सह भारत।\nपाण्डुं संस्कारयामास देशे परमपूजिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006916, "chapter_id": 1135, "verse_number": "१-१३६-६", "content_sanskrit": "ततस्तु नगरात्तूर्णमाज्यगन्धपुरस्कृताः।\nनिर्हृताः पावका दीप्ताः पाण्डो राजन्पुरोहितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006917, "chapter_id": 1135, "verse_number": "१-१३६-७", "content_sanskrit": "अथैनामार्तवैः पुष्पैर्गन्धैश्च विविधैर्वरैः।\nशिबिकां तामलङ्कृत्य वाससाऽऽच्छाद्य सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006918, "chapter_id": 1135, "verse_number": "१-१३६-८", "content_sanskrit": "तां तथा शोभितां माल्यैर्वासोभिश्च महाधनैः।\nअमात्या ज्ञातयश्चैनं सुहृदश्चोपतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006919, "chapter_id": 1135, "verse_number": "१-१३६-९", "content_sanskrit": "नृसिंहं नरयुक्तेन परमालङ्कृतेन तम्।\nअवहन् यानमुख्येन सह माद्र्या सुसंवृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006920, "chapter_id": 1135, "verse_number": "१-१३६-१०", "content_sanskrit": "पाण्डुरेणातपत्रेण चामरव्यजनेन च।\nसर्ववादित्रनादैश्च समलञ्चक्रिरे ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006921, "chapter_id": 1135, "verse_number": "१-१३६-११", "content_sanskrit": "रत्नानि चाप्युपादाय बहूनि शतशो नराः।\nप्रददुः काङ्क्षमाणेभ्यः पाण्डोस्तस्यौर्ध्वदेहिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006922, "chapter_id": 1135, "verse_number": "१-१३६-१२", "content_sanskrit": "अथ च्छत्राणि शुभ्राणि चामराणि बृहन्ति च।\nआजह्रुः कौरवस्यार्थे वासांसि रुचिराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006923, "chapter_id": 1135, "verse_number": "१-१३६-१३", "content_sanskrit": "याजकैः शुक्लवासोभिर्हूयमाना हुताशनाः।\nअगच्छन्नग्रतस्तस्य दीप्यमानाः स्वलङ्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006924, "chapter_id": 1135, "verse_number": "१-१३६-१४", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्चैव सहस्रशः।\nरुदन्तः शोकसंतप्ता अनुजग्मुर्नराधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006925, "chapter_id": 1135, "verse_number": "१-१३६-१५", "content_sanskrit": "अयमस्मानपाहाय दुःखे चाधाय शाश्वते।\nकृत्वा चास्माननाथांश्च क्व यास्यति नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006926, "chapter_id": 1135, "verse_number": "१-१३६-१६", "content_sanskrit": "क्रोशन्तः पाण्डवाः सर्वे भीष्मो विदुर एव च।\nबाह्लीकः सोमदत्तश्च तथा भूरिश्रवा नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006927, "chapter_id": 1135, "verse_number": "१-१३६-१७", "content_sanskrit": "अन्योन्यं वै समाश्लिष्य अनुजग्मुः सहस्रशः।\nरमणीये वनोद्देशे गङ्गातीरे समे शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006928, "chapter_id": 1135, "verse_number": "१-१३६-१८", "content_sanskrit": "न्यासयामासुरथं तां शिबिकां सत्यवादिनः।\nसभार्यस्य नृसिंहस्य पाण्डोरक्लिष्टकर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006929, "chapter_id": 1135, "verse_number": "१-१३६-१९", "content_sanskrit": "ततस्तस्य शरीरं तु सर्वगन्धाधिवासितम्।\nशुचिकालीयकादिग्धं दिव्यचन्दनरूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006930, "chapter_id": 1135, "verse_number": "१-१३६-२०", "content_sanskrit": "पर्यषिञ्चञ्जलेनाशु शातकुम्भमयैर्घटैः।\nचन्दनेन च शुक्लेन सर्वतः समलेपयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2006931, "chapter_id": 1135, "verse_number": "१-१३६-२१", "content_sanskrit": "कालागुरुविमिश्रेण तथा तुङ्गरसेन च।\nअथैनं देशजैः शुक्लैर्वासोभिः समयोजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2006932, "chapter_id": 1135, "verse_number": "१-१३६-२२", "content_sanskrit": "संछन्नः स तु वासोभिर्जीवन्निव नराधिपः।\nशुशुभे स नव्याघ्रो महार्हशयनोचितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2006933, "chapter_id": 1135, "verse_number": "१-१३६-२३", "content_sanskrit": "हयमेधाग्निना सर्वे याजकाः सपुरोहिताः।\nवेदोक्तेन विधानेन क्रियांचक्रुः समन्त्रकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2006934, "chapter_id": 1135, "verse_number": "१-१३६-२४", "content_sanskrit": "याजकैरभ्यनुज्ञाते प्रेतकर्मण्यनिष्ठिते।\nघृतावसिक्तं राजानं सह माद्र्या स्वलङ्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2006935, "chapter_id": 1135, "verse_number": "१-१३६-२५", "content_sanskrit": "तुङ्गपद्मकमिश्रेण चन्दनेन सुगन्धिना।\nसरलं देवदारुं च गुग्गुलं लाक्षया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2006936, "chapter_id": 1135, "verse_number": "१-१३६-२६", "content_sanskrit": "हरिचन्दनकाष्ठैश्च हरिबेरैरुशीरकैः।\nअन्यैश्च विविधैर्गन्धैर्विधिना समदाहयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2006937, "chapter_id": 1135, "verse_number": "१-१३६-२७", "content_sanskrit": "ततस्तयोः शरीरे द्वे दृष्ट्वा मोहवशं गता।\nहाहा पुत्रेति कौसल्या पपात सहसा भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2006938, "chapter_id": 1135, "verse_number": "१-१३६-२८", "content_sanskrit": "तां प्रेक्ष्य पतितामार्तां पौरजानपदो जनः।\nरुरोद दुःखसंतप्तो राजभक्त्या कृपाऽन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2006939, "chapter_id": 1135, "verse_number": "१-१३६-२९", "content_sanskrit": "कुन्त्याश्चैवार्तनादेन सर्वाणि च विचुक्रुशुः।\nमानुषैः सह भूतानि तिर्यग्योनिगतान्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2006940, "chapter_id": 1135, "verse_number": "१-१३६-३०", "content_sanskrit": "तथा भीष्मः शान्तनवो विदुरश्च महामतिः।\nसर्वशः कौरवाश्चैव प्राणदन्भृशदुःखिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2006941, "chapter_id": 1135, "verse_number": "१-१३६-३१", "content_sanskrit": "ततो भीष्मोऽथ विदुरो राजा च सह पाण्डवैः।\nउदकं चक्रिरे तस्य सर्वाश्च कुरुयोषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2006942, "chapter_id": 1135, "verse_number": "१-१३६-३२", "content_sanskrit": "चुक्रुशुः पाण्डवाः सर्वे भीष्मः शान्तनवस्तथा।\nविदुरो ज्ञातयश्चैव चक्रुश्चाप्युदकक्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2006943, "chapter_id": 1135, "verse_number": "१-१३६-३३", "content_sanskrit": "कृतोदकांस्तानादाय पाण्डवाञ्छोककर्शितान्।\nसर्वाः प्रकृतयो राजञ्शोचमाना न्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2006944, "chapter_id": 1135, "verse_number": "१-१३६-३४", "content_sanskrit": "यथैव पाण्डवा भूमौ सुषुपुः सह बान्धवैः।\nतथैव नागरा राजञ्शिश्यिरे ब्राह्मणादयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2006945, "chapter_id": 1135, "verse_number": "१-१३६-३५", "content_sanskrit": "तद्गतानन्दमस्वस्थमाकुमारमहृष्टवत्।\nबभूव पाण्डवैः सार्धं नगरं द्वादश क्षपाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2006946, "chapter_id": 1135, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि षट्त्रिंशदधिकशततमोऽध्यायः॥ १३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]