[{"id": 2149809, "chapter_id": 4246, "verse_number": "", "content_sanskrit": "अकृतव्रणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149810, "chapter_id": 4246, "verse_number": "१", "content_sanskrit": "दुःखं द्वयोरिदं भद्रे कतरस्य चिकीर्षसि ।\nप्रतिकर्तव्यमबले तत् त्वं वत्से वदस्व मे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149811, "chapter_id": 4246, "verse_number": "२", "content_sanskrit": "यदि सौभपतिर्भद्रे नियोक्तव्यो मतस्तव ।\nनियोक्ष्यति महात्मा स रामस्त्वद्धितकाम्यया\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149812, "chapter_id": 4246, "verse_number": "३", "content_sanskrit": "अथापगेयं भीष्मं त्वं रामेणेच्छसि धीमता ।\nरणे विनिर्जितं द्रष्टुं कुर्यात् तदपि भार्गवः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149813, "chapter_id": 4246, "verse_number": "४", "content_sanskrit": "सृञ्जयस्य वचः श्रुत्वा तथैव च शुचिस्मिते ।\nयदत्रानन्तरं कार्यं तदत्रैव विचिन्त्यताम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149814, "chapter_id": 4246, "verse_number": "", "content_sanskrit": "अम्बा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149815, "chapter_id": 4246, "verse_number": "५", "content_sanskrit": "अपनीताऽस्मि भीष्मेण भगवन्नविजानता ।\nन हि जानाति मे भीष्मो ब्रह्मन् साल्वगतं मनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149816, "chapter_id": 4246, "verse_number": "६", "content_sanskrit": "एतद् विचार्य मनसा भवानेतद् विनिश्चयम् ।\nविचिनोतु यथान्यायं विधानं क्रियतां तथा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149817, "chapter_id": 4246, "verse_number": "७", "content_sanskrit": "भीष्मे वा कुरुशार्दूले साल्वराजेऽथवा पुनः ।\nउभयोरेव वा ब्रह्मन् युक्तं यत् तत् समाचर\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149818, "chapter_id": 4246, "verse_number": "८", "content_sanskrit": "निवेदितं मया ह्येतद् दुःखमूलं यथातथम् ।\nविधानं तत्र भगवन् कर्तुमर्हति युक्तितः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149819, "chapter_id": 4246, "verse_number": "", "content_sanskrit": "अकृतव्रणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149820, "chapter_id": 4246, "verse_number": "९", "content_sanskrit": "उपपन्नमिदं भद्रे यदेवं वरवर्णिनि ।\nधर्म्यं प्रतिवचो ब्रूयाः शृणु चेदं वचो मम\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149821, "chapter_id": 4246, "verse_number": "१०", "content_sanskrit": "यदि त्वामापगेयो वै न नयेद् गजसाह्वयम् ।\nसाल्वस्त्वां शिरसा भीरु गृह्णीयाद् रामचोदितः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149822, "chapter_id": 4246, "verse_number": "११", "content_sanskrit": "तेन त्वं निर्जिता भद्रे यस्मान्नीताऽसि भामिनि ।\nसंशयः साल्वराजस्य तेन त्वयि सुमध्यमे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149823, "chapter_id": 4246, "verse_number": "१२", "content_sanskrit": "भीष्मः पुरुषमानी च जितकाशी तथैव च ।\nतस्मात् प्रतिक्रिया युक्ता भीष्मे कारयितुं त्वया\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149824, "chapter_id": 4246, "verse_number": "", "content_sanskrit": "अम्बा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149825, "chapter_id": 4246, "verse_number": "१३", "content_sanskrit": "ममाप्येष सदा ब्रह्मन् हृदि कामोऽभिवर्तते ।\nघातयेयं यदि रणे भीष्ममित्येव नित्यदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149826, "chapter_id": 4246, "verse_number": "१४", "content_sanskrit": "भीष्मं वा साल्वराजं वा यं वा दोषेण गच्छसि ।\nप्रशाधि तं महाबाहो यत्कृतेऽहं सुदुःखिता\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149827, "chapter_id": 4246, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149828, "chapter_id": 4246, "verse_number": "१५", "content_sanskrit": "एवं कथयतामेव तेषां स दिवसो गतः ।\nरात्रिश्च भरतश्रेष्ठ सुखशीतोष्णमारुता\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149829, "chapter_id": 4246, "verse_number": "१६", "content_sanskrit": "ततो रामः प्रादुरासीद् प्रज्वलन्निव तेजसा ।\nशिष्यैः परिवृतो राजन् जटाचीरधरो मुनिः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149830, "chapter_id": 4246, "verse_number": "१७", "content_sanskrit": "धनुष्पाणिरदीनात्मा खड्गं बिभ्रत् परश्वधी ।\nविरजा राजशार्दूल सोऽभ्ययात् सृञ्जयं नृपम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149831, "chapter_id": 4246, "verse_number": "१८", "content_sanskrit": "ततस्तं तापसा दृष्ट्वा स च राजा महातपाः ।\nतस्थुः प्राञ्जलयो राजन् सा च कन्या तपस्विनी\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149832, "chapter_id": 4246, "verse_number": "१९", "content_sanskrit": "पूजयामासुरव्यग्रा मधुपर्केण भार्गवम् ।\nपूजितश्च यथान्यायं निषसाद सहैव तैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149833, "chapter_id": 4246, "verse_number": "२०", "content_sanskrit": "ततः पूर्वव्यतीतानि कथयेते स्म तावुभौ ।\nआसातां जामदग्न्यश्च सृञ्जयश्चैव भारत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149834, "chapter_id": 4246, "verse_number": "२१", "content_sanskrit": "तथा कथान्ते राजर्षिर्भृगुश्रेष्ठं महाबलम् ।\nउवाच मधुरं काले रामं वचनमर्थवत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149835, "chapter_id": 4246, "verse_number": "२२", "content_sanskrit": "रामेयं मम दौहित्री काशिराजसुता प्रभो ।\nअस्याः शृणु यथातत्त्वं कार्यं कार्यविशारद\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149836, "chapter_id": 4246, "verse_number": "२३", "content_sanskrit": "परमं कथ्यतां चेति तां रामः प्रत्यभाषत ।\nततः साऽभ्यवदद् रामं ज्वलन्तमिव पावकम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149837, "chapter_id": 4246, "verse_number": "२४", "content_sanskrit": "ततोऽभिवाद्य चरणौ रामस्य शिरसा शुभा ।\nस्पृष्ट्वा पद्मदलाभाभ्यां पाणिभ्यामग्रतः स्थिता\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149838, "chapter_id": 4246, "verse_number": "२५", "content_sanskrit": "प्ररुरोद वरारोहा बाष्पव्याकुललोचना ।\nप्रपेदे शरणं चैव शरण्यं भृगुनन्दनम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149839, "chapter_id": 4246, "verse_number": "", "content_sanskrit": "रामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149840, "chapter_id": 4246, "verse_number": "२६", "content_sanskrit": "यथा त्वं सृञ्जयस्यास्य तथा त्वं मे नृपात्मजे ।\nब्रूहि तत् ते मनोदुःखं करिष्ये वचनं तव\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2149841, "chapter_id": 4246, "verse_number": "", "content_sanskrit": "अम्बा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2149842, "chapter_id": 4246, "verse_number": "२७", "content_sanskrit": "भगवन् शरणं त्वाऽद्य प्रपन्नाऽस्मि महाव्रतम् ।\nशोकपङ्कार्णवे मग्नां घोरादुद्धर मां विभो\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2149843, "chapter_id": 4246, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2149844, "chapter_id": 4246, "verse_number": "२८", "content_sanskrit": "तस्याश्च दृष्ट्वा रूपं स वयश्चाभिनवं पुनः ।\nसौकुमार्यं परं चैव रामश्चिन्तापरोऽभवत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2149845, "chapter_id": 4246, "verse_number": "२९", "content_sanskrit": "किमियं वक्ष्यतीत्येवं विमृशन् भृगुसत्तमः ।\nइति दध्यौ चिरं रामः कृपयाऽभिपरिप्लुतः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2149846, "chapter_id": 4246, "verse_number": "३०", "content_sanskrit": "कथ्यतामिति सा भूयो रामेणोक्ता शुचिस्मिता ।\nसर्वमेव यथातत्त्वं कथयामास भार्गवे\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2149847, "chapter_id": 4246, "verse_number": "३१", "content_sanskrit": "तच्छ्रुत्वा जामदग्न्यस्तु राजपुत्र्या वचस्तदा ।\nउवाच तां वरारोहां निश्चित्यार्थविनिश्चयम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2149848, "chapter_id": 4246, "verse_number": "३२", "content_sanskrit": "प्रेषयिष्यामि भीष्माय कुरुश्रेष्ठाय भामिनि ।\nकरिष्यति वचो मह्यं श्रुत्वा धर्मं नराधिपः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2149849, "chapter_id": 4246, "verse_number": "३३", "content_sanskrit": "न चेत् करिष्यति वचो मयोक्तं जाह्नवीसुतः ।\nधक्ष्याम्येनं रणे भद्रे सामात्यं शस्त्रतेजसा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2149850, "chapter_id": 4246, "verse_number": "३४", "content_sanskrit": "अथवा ते मतिस्तत्र राजपुत्रि न वर्तते ।\nयावत् साल्वपतिं वीरं योजयाम्यत्र कर्मणि\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2149851, "chapter_id": 4246, "verse_number": "", "content_sanskrit": "अम्बा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2149852, "chapter_id": 4246, "verse_number": "३५", "content_sanskrit": "विसर्जिताऽहं भीष्मेण श्रुत्वैव भृगुनन्दन ।\nसाल्वराजगतं भावं मम पूर्वं मनीषितम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2149853, "chapter_id": 4246, "verse_number": "३६", "content_sanskrit": "सौभराजमुपेत्याहमवोचं दुर्वचं वचः ।\nन च मां प्रत्यगृह्णात् स चारित्रपरिशङ्कितः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2149854, "chapter_id": 4246, "verse_number": "३७", "content_sanskrit": "एतत् सर्वं विनिश्चित्य स्वबुद्ध्या भृगुनन्दन ।\nयदत्रौपायिकं कार्यं तच्चिन्तयितुमर्हसि\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2149855, "chapter_id": 4246, "verse_number": "३८", "content_sanskrit": "मम तु व्यसनस्यास्य भीष्मो मूलं महाव्रतः ।\nयेनाहं वशमानीता समुत्थाप्य बलात् तदा\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2149856, "chapter_id": 4246, "verse_number": "३९", "content_sanskrit": "जहि भीष्मं महाबाहो यत्कृते दुःखमीदृशम् ।\nप्राप्ताऽहं भृगुशार्दूल चराम्यप्रियमुत्तमम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2149857, "chapter_id": 4246, "verse_number": "४०", "content_sanskrit": "स हि लुब्धश्च मानी च जितकाशी च भार्गव ।\nतस्मात् प्रतिक्रियां कर्तुं युक्तं तस्मै त्वयाऽनघ\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2149858, "chapter_id": 4246, "verse_number": "४१", "content_sanskrit": "एष मे ह्रियमाणाया भारतेन तदा विभो ।\nअभवद् हृदि सङ्कल्पो घातयेयं महाव्रतम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2149859, "chapter_id": 4246, "verse_number": "४२", "content_sanskrit": "तस्मात् कामं ममाद्येमं राम सम्पादयानघ ।\nजहि भीष्मं महाबाहो यथा वृत्रं पुरन्दरः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2149860, "chapter_id": 4246, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि सप्तसप्तत्युत्तरशततमोऽध्यायः ॥१७७॥\nअम्बोपाख्यानपर्वणि सप्तमोऽध्यायः ॥७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]