[{"id": 6000291000, "chapter_id": 10291, "verse_number": null, "content_sanskrit": "अथ पञ्चनवतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000291001, "chapter_id": 10291, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.001.m4a", "display_order": 2}, {"id": 6000291002, "chapter_id": 10291, "verse_number": "१०-९५-१", "content_sanskrit": "सरस्वत्यास्तटे राजन् ऋषयः सत्रमासत।\nवितर्कः समभूत् तेषां त्रिष्वधीशेषु को महान्॥ १०/९५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.002.m4a", "display_order": 3, "topics": [{"text": "सरस्वतीतटे सत्रमासीनैर्मुनिभिर्भृगुं प्रेष्य हरेः सर्वोत्तमत्वस्य व्यवस्थापनम्", "range": "१–२२"}]}, {"id": 6000291003, "chapter_id": 10291, "verse_number": "१०-९५-२", "content_sanskrit": "तस्य जिज्ञासया ते वै भृगुं ब्रह्मसुतं नृप।\nतज्ज्ञप्त्यै प्रेषयामासुः सोऽभ्यगाद् ब्रह्मणः सभाम्॥ १०/९५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.003.m4a", "display_order": 4}, {"id": 6000291004, "chapter_id": 10291, "verse_number": "१०-९५-३", "content_sanskrit": "न तस्मै ब्रह्मणे स्तोत्रं चक्रे सत्वपरीक्षया।\nतस्मै चुक्रोध भगवान् प्रज्वलन् स्वेन तेजसा॥ १०/९५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.004.m4a", "display_order": 5}, {"id": 6000291005, "chapter_id": 10291, "verse_number": "१०-९५-४", "content_sanskrit": "स आत्मन्युत्थितं मन्युमात्मजायात्मनः प्रभुः।\nअशीशमद् यथा वह्निं शमयेद् वारिणा प्रभुः॥ १०/९५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.005.m4a", "display_order": 6}, {"id": 6000291006, "chapter_id": 10291, "verse_number": "१०-९५-५", "content_sanskrit": "ततः कैलासमगमत् स तं देवो महेश्वरः।\nपरिरब्धुं समारेभे उत्थाय भ्रातरं मुदा॥ १०/९५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.006.m4a", "display_order": 7}, {"id": 6000291007, "chapter_id": 10291, "verse_number": "१०-९५-६", "content_sanskrit": "नैच्छत् तमशुभाचार इति, देवश्चुकोप ह।\nशूलमुद्यम्य तं हन्तुमारेभे तिग्मलोचनः॥ १०/९५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.007.m4a", "display_order": 8}, {"id": 6000291008, "chapter_id": 10291, "verse_number": "१०-९५-७", "content_sanskrit": "पतित्वा पादयोर्देवी शमयामास तं गिरा।\nइति कृच्छ्रात् ततो मुक्तः कैलासाद् रजताचलात्॥ १०/९५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.008.m4a", "display_order": 9}, {"id": 6000291009, "chapter_id": 10291, "verse_number": "१०-९५-८", "content_sanskrit": "मुनिर्जगाम वैकुण्ठं यत्र देवो जनार्दनः।\nशयानं श्रिय उत्सङ्गे पदा वक्षस्यताडयत्॥ १०/९५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.009.m4a", "display_order": 10}, {"id": 6000291010, "chapter_id": 10291, "verse_number": "१०-९५-९", "content_sanskrit": "तत उत्थाय भगवान् सह लक्ष्म्या सतां गतिः।\nस्वतल्पादवरुह्याशु ननाम शिरसा मुनिम्॥ १०/९५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.010.m4a", "display_order": 11}, {"id": 6000291011, "chapter_id": 10291, "verse_number": "१०-९५-१०", "content_sanskrit": "आह ते स्वागतं ब्रह्मन् निषीदात्रासने क्षणम्।\nअजानतामागसं नः क्षन्तुमर्हसि मानद॥ १०/९५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.011.m4a", "display_order": 12}, {"id": 6000291012, "chapter_id": 10291, "verse_number": "१०-९५-११", "content_sanskrit": "पुनीहि सहलोकं मां लोकपालांश्च मद्गतान्।\nपादोदकेन भवतस्तीर्थानां तीर्थकारिणा॥ १०/९५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.012.m4a", "display_order": 13}, {"id": 6000291013, "chapter_id": 10291, "verse_number": "१०-९५-१२", "content_sanskrit": "अद्याहं भगवन् लक्ष्म्या आसमेकान्तभाजनम्।\nवत्स्यत्युरसि नो भूतिर्भवत्पादहतांहसि॥ १०/९५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.013.m4a", "display_order": 14}, {"id": 6000291014, "chapter_id": 10291, "verse_number": "१०-९५-१३", "content_sanskrit": "श्रीवत्समिति नामापि जायतां पादलक्षणम्॥ १०/९५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.014.m4a", "display_order": 15}, {"id": 6000291015, "chapter_id": 10291, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.015.m4a", "display_order": 16}, {"id": 6000291016, "chapter_id": 10291, "verse_number": "१०-९५-१४", "content_sanskrit": "एवं ब्रुवाणे वैकुण्ठे भृगुस्तत्सार्द्रया गिरा।\nनिर्वृतस्तर्पितस्तूष्णीं भक्त्युत्कण्ठोऽश्रुलोचनः॥ १०/९५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.016.m4a", "display_order": 17}, {"id": 6000291017, "chapter_id": 10291, "verse_number": "१०-९५-१५", "content_sanskrit": "पुनः स्वसत्रमासाद्य मुनीनां ब्रह्मवादिनाम्।\nस्वानुभूतमशेषेन राजन् भृगुरवर्णयत्॥ १०/९५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.017.m4a", "display_order": 18}, {"id": 6000291018, "chapter_id": 10291, "verse_number": "१०-९५-१६", "content_sanskrit": "तं निशम्याथ मुनयो विस्मिता मुक्तसंशयाः।\nभूयांसं श्रद्दधुर्विष्णुं यतः शान्तिर्यतोऽभयम्॥ १०/९५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.018.m4a", "display_order": 19}, {"id": 6000291019, "chapter_id": 10291, "verse_number": "१०-९५-१७", "content_sanskrit": "धर्मः साक्षाद् यतो ज्ञानं वैराग्यं च चतुर्विधम्।\nऐश्वर्यं चाष्टधा यस्माद् यशश्चात्ममलापहम्॥ १०/९५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.019.m4a", "display_order": 20}, {"id": 6000291020, "chapter_id": 10291, "verse_number": "१०-९५-१८", "content_sanskrit": "मुनीनां न्यस्तदण्डानां शान्तानां समचेतसाम्।\nअकिञ्चनानां साधूनां यमाहुः परमां गतिम्॥ १०/९५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.020.m4a", "display_order": 21}, {"id": 6000291021, "chapter_id": 10291, "verse_number": "१०-९५-१९", "content_sanskrit": "सत्वं यस्य प्रिया मूर्तिर्ब्राह्मणास्त्विष्टदेवताः।\nभजन्त्यनाशिषः शान्ता यं वा निपुणबुद्धयः॥ १०/९५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.021.m4a", "display_order": 22}, {"id": 6000291022, "chapter_id": 10291, "verse_number": "१०-९५-२०", "content_sanskrit": "त्रिविधा मूर्तयस्तस्य राक्षसा असुराः सुराः।\nगुणास्तन्मायया सृष्टाः सत्वं तत्रार्यदर्शनम्॥ १०/९५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.022.m4a", "display_order": 23}, {"id": 6000291023, "chapter_id": 10291, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.023.m4a", "display_order": 24}, {"id": 6000291024, "chapter_id": 10291, "verse_number": "१०-९५-२१", "content_sanskrit": "इत्थं सारस्वता विप्रा नृणां संशयनुत्तये।\nपुरुषस्य पदाम्भोजसेवया तद्गतिं गताः॥ १०/९५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.024.m4a", "display_order": 25}, {"id": 6000291025, "chapter_id": 10291, "verse_number": "१०-९५-२२", "content_sanskrit": "इत्येतन्मुनितनयस्य पद्मगर्भपीयूषं भवभयभित् परस्य पुंसः।\nसुश्लोकैः श्रवणपुटैः पिबन्नभीक्ष्णं पान्थोऽथ भ्रमणपरिश्रमं जहाति॥ १०/९५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_095/BhP_10.095.025.m4a", "display_order": 26}, {"id": 6000291026, "chapter_id": 10291, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे पञ्चनवतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]