[{"id": 50006692, "chapter_id": 11361, "verse_number": "1", "content_sanskrit": "शौनक उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006693, "chapter_id": 11361, "verse_number": "2", "content_sanskrit": "निर्गते नारदे सूत भगवान् बादरायणः। श्रुतवांस्तदभिप्रेतं ततः किमकरोद् विभुः॥ १/७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006694, "chapter_id": 11361, "verse_number": "3", "content_sanskrit": "सूत उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50006695, "chapter_id": 11361, "verse_number": "4", "content_sanskrit": "ब्रह्मनद्याः सरस्वत्या आश्रमःपश्चिमे तटे। शम्याप्रास इति प्रोक्त ऋषीणां सत्रवर्धनः॥ १/७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50006696, "chapter_id": 11361, "verse_number": "5", "content_sanskrit": "तस्मिन् ऋष्याश्रमे व्यासो बदरीषण्डमण्डिते। आसीनोऽप उपस्पृश्य प्रणिदध्यौ मनश्चिरम्॥ १/७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50006697, "chapter_id": 11361, "verse_number": "6", "content_sanskrit": "भक्तियोगेन मनसि सम्यक् प्रणिहितेऽमले। अपश्यत् पुरुषं पूर्णं मायां च तदपाश्रयाम्॥ १/७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50006698, "chapter_id": 11361, "verse_number": "7", "content_sanskrit": "यया सम्मोहितो जीव आत्मानं त्रिगुणात्मकम्। परोऽपि मनुतेऽनर्थं तत्कृतं चाभिपद्यते॥ १/७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50006699, "chapter_id": 11361, "verse_number": "8", "content_sanskrit": "अनर्थोपशमं साक्षाद्भक्तियोगमधोक्षजे। लोकस्याजानतो विद्वाँश्चक्रे सात्वतसंहिताम्॥ १/७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50006700, "chapter_id": 11361, "verse_number": "9", "content_sanskrit": "यस्यां वै श्रूयमाणायां कृष्णे परमपूरुषे। भक्तिरुत्पद्यते पुंसां शोकमोहभयापहा॥ १/७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50006701, "chapter_id": 11361, "verse_number": "10", "content_sanskrit": "स संहितां भागवतीं कृत्वाऽनुक्रम्य चात्मजम्। शुकमध्यापयामास निवृत्तिनिरतं मुनिम्॥ १/७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50006702, "chapter_id": 11361, "verse_number": "11", "content_sanskrit": "शौनक उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50006703, "chapter_id": 11361, "verse_number": "12", "content_sanskrit": "स वै निवृत्तिनिरतः सर्वत्रोपेक्षको मुनिः। कस्य वा बृहतीमेतामात्मारामः समभ्यसत्॥ १/७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50006704, "chapter_id": 11361, "verse_number": "13", "content_sanskrit": "सूत उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50006705, "chapter_id": 11361, "verse_number": "14", "content_sanskrit": "आत्मारामाश्च मुनयो निर्ग्राह्या अप्युरुक्रमे। कुर्वन्त्यहैतुकीं भक्तिमित्थम्भूतगुणो हरिः॥ १/७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50006706, "chapter_id": 11361, "verse_number": "15", "content_sanskrit": "हरेर्गुणाक्षिप्तमतिर्भगवान् बादरायणिः। अध्यगान्महदाख्यानं नित्यं विष्णुजनप्रियम्॥ १/७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50006707, "chapter_id": 11361, "verse_number": "16", "content_sanskrit": "परीक्षितोऽथ राजर्षेः जन्मकर्मविलापनम्। संस्थां च पाण्डुपुत्राणां वक्ष्ये कृष्णकथोदयाम्॥ १/७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50006708, "chapter_id": 11361, "verse_number": "17", "content_sanskrit": "यदा मृधे कौरवसृञ्जयानां वीरेष्वथो वीरगतिं गतेषु। वृकोदराविद्धगदाभिमर्शभग्नोरुदण्डे धृतराष्ट्रपुत्रे॥ १/७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50006709, "chapter_id": 11361, "verse_number": "18", "content_sanskrit": "भर्तुः प्रियं द्रौणिरिति स्म पश्यन् कृष्णासुतानां स्वपतां शिरांसि। अपाहरद् विप्रियमेतदस्य जुगुप्सितं कर्म विगर्हयन्ती॥ १/७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50006710, "chapter_id": 11361, "verse_number": "19", "content_sanskrit": "माता शिशूनां निधनं सुतानां निशम्य घोरं परितप्यमाना। तदारुदद्बाष्पकळाकुलाक्षी तां सान्त्वयन्नाह किरीटमाली॥ १/७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50006711, "chapter_id": 11361, "verse_number": "20", "content_sanskrit": "तन्मा शुचस्ते प्रमृजाश्रु भद्रे यद्ब्रह्मबन्धोः शिर आततायिनः। गाण्डीवमुक्तैर्विशिखैरुपाहरे (तु)आक्रम्य तत् स्नास्यसि नेत्रजैर्जलैः॥ १/७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50006712, "chapter_id": 11361, "verse_number": "21", "content_sanskrit": "इति प्रियां वल्गुविचित्रजल्पैः स सान्त्वयित्वाऽच्युतमित्रसूतः। अभ्यद्रवद्दंशित उग्रधन्वा कपिध्वजो गुरुपुत्रं रथेन॥ १/७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50006713, "chapter_id": 11361, "verse_number": "22", "content_sanskrit": "तमापतन्तं स विलोक्य दूरात् कुमारहोद्विग्नमना रथेन। पराद्रवत् प्राणपरीप्सुरुर्व्यां यावद्गमं रुद्रभयाद् यथाऽऽर्किः॥ १/७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50006714, "chapter_id": 11361, "verse_number": "23", "content_sanskrit": "यदाऽशरणमात्मानमैक्षत श्रान्तवाहनः। अस्त्रं ब्रह्मशिरो मेन आत्मत्राणं द्विजात्मजः॥ १/७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50006715, "chapter_id": 11361, "verse_number": "24", "content_sanskrit": "अथोपस्पृश्य सलिलं सन्दधे तत् समाहितः। अजानन्नपि संहारं प्राणकृच्छ्र उपस्थिते॥ १/७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50006716, "chapter_id": 11361, "verse_number": "25", "content_sanskrit": "ततः प्रादुष्कृतं तेजः प्रचण्डं सर्वतोदिशम्। प्रापतत्तदभिप्रेक्ष्य विष्णुं जिष्णुरुवाच ह॥ १/७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50006717, "chapter_id": 11361, "verse_number": "26", "content_sanskrit": "अर्जुन उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50006718, "chapter_id": 11361, "verse_number": "27", "content_sanskrit": "कृष्णकृष्ण महाबाहो भक्तानामभयङ्कर। त्वमेको दह्यमानानामपवर्गोऽसि संसृतेः॥ १/७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50006719, "chapter_id": 11361, "verse_number": "28", "content_sanskrit": "त्वमाद्यः पुरुषः साक्षादीश्वरः प्रकृतेः परः। मायां व्युदस्य चिच्छक्त्या कैवल्ये स्थित आत्मनि॥ १/७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50006720, "chapter_id": 11361, "verse_number": "29", "content_sanskrit": "स एव जीवलोकस्य मायामोहितचेतसः। विधित्सुः स्वेन वीर्येण श्रेयो धर्मादिलक्षणम्॥ १/७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50006721, "chapter_id": 11361, "verse_number": "30", "content_sanskrit": "तथाऽयं चावतारस्ते भुवो भारजिहीर्षया। स्वानामनन्यभावानामनुध्यानाय चासकृत्॥ १/७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50006722, "chapter_id": 11361, "verse_number": "31", "content_sanskrit": "किमिदं स्वित् कुतो वेति देवदेव न वेद्म्यहम्। सर्वतोमुखमायाति तेजः परमदारुणम्॥ १/७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50006723, "chapter_id": 11361, "verse_number": "32", "content_sanskrit": "श्रीभगवानुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50006724, "chapter_id": 11361, "verse_number": "33", "content_sanskrit": "वेत्थेदं द्रोणपुत्रस्य ब्राह्ममस्त्रं प्रदर्शितम्। नैवासौ वेद संहारं प्राणबाध उपस्थिते॥ १/७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50006725, "chapter_id": 11361, "verse_number": "34", "content_sanskrit": "न ह्यस्यान्यतमं किञ्चिदस्त्रं प्रत्यवकर्षणम्। जह्यस्त्रतेज उन्नद्धमस्त्रज्ञो ह्यस्त्रतेजसा॥ १/७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50006726, "chapter_id": 11361, "verse_number": "35", "content_sanskrit": "सूत उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50006727, "chapter_id": 11361, "verse_number": "36", "content_sanskrit": "श्रुत्वा भगवता प्रोक्तं फल्गुनः परवीरहा। स्पृष्ट्वाऽऽपस्तं परिक्रम्य ब्राह्मं ब्राह्माय सन्दधे॥ १/७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50006728, "chapter_id": 11361, "verse_number": "37", "content_sanskrit": "संहत्यान्योन्यमुभयोस्तेजसी शरसंवृते। आवृत्य रोदसी खं च ववृधातेऽर्कवह्निवत्॥ १/७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50006729, "chapter_id": 11361, "verse_number": "38", "content_sanskrit": "दृष्ट्वाऽस्त्रतेजस्तु तयोस्त्रींल्लोकान् प्रदहन्महत्। दह्यमानाः प्रजाः सर्वाः सांवर्तकममंसत॥ १/७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50006730, "chapter_id": 11361, "verse_number": "39", "content_sanskrit": "प्रजोपद्रवमालक्ष्य लोकव्यतिकरं च तम्। मतं च वासुदेवस्य सञ्जहारार्जुनो द्वयम्॥ १/७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50006731, "chapter_id": 11361, "verse_number": "40", "content_sanskrit": "तत आसाद्य तरसा दारुणं गौतमीसुतम्। बबन्धामर्षताम्राक्षः पशुं रशनया यथा॥ १/७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50006732, "chapter_id": 11361, "verse_number": "41", "content_sanskrit": "शिबिराय निनीषन्तं रज्ज्वा बद्ध्वा रिपुं बलात्। प्राहार्जुनं प्रकुपितो भगवानम्बुजेक्षणः॥ १/७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50006733, "chapter_id": 11361, "verse_number": "42", "content_sanskrit": "मैनं पार्थार्हसि त्रातुं ब्रह्मबन्धुमिमं जहि। योऽसावनागसः सुप्तानवधीन्निशि बालकान्॥ १/७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50006734, "chapter_id": 11361, "verse_number": "43", "content_sanskrit": "मत्तं प्रमत्तमुन्मत्तं सुप्तं बालं स्त्रियं जडम्। प्रपन्नं विरथं भीतं न रिपुं हन्ति धर्मवित्॥ १/७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50006735, "chapter_id": 11361, "verse_number": "44", "content_sanskrit": "स्वप्राणान् यः परप्राणैः प्रपुष्णात्यघृणः खलः। तद्वधस्तस्य हि श्रेयः यद्दोषाद्यात्यधः पुमान्॥ १/७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50006736, "chapter_id": 11361, "verse_number": "45", "content_sanskrit": "प्रतिश्रुतं च भवता पाञ्चाल्यै शृण्वतो मम। आहरिष्ये शिरस्तस्य यस्ते मानिनि पुत्रहा॥ १/७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50006737, "chapter_id": 11361, "verse_number": "46", "content_sanskrit": "तदसौ वध्यतां पाप आतताय्यात्मबन्धुहा। भर्तुश्च विप्रियं वीर कृतवान् कुलपांसनः॥ १/७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50006738, "chapter_id": 11361, "verse_number": "47", "content_sanskrit": "एवं परीक्षता धर्मं पार्थः कृष्णेन चोदितः। नैच्छद् हन्तुं गुरुसुतं यद्यप्यात्महनं महान्॥ १/७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50006739, "chapter_id": 11361, "verse_number": "48", "content_sanskrit": "अथोपेत्य स्वशिबिरं गोविन्दप्रियसारथिः। न्यवेदयत्तं प्रियायै शोचन्त्या आत्मजान् हतान्॥ १/७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50006740, "chapter_id": 11361, "verse_number": "49", "content_sanskrit": "तथाऽऽहृतं पशुवत् पाशबद्धमवाङ्मुखं कर्मजुगुप्सितेन। निरीक्ष्य कृष्णाऽपकृतं गुरोः सुतं वामस्वभावा कृपया ननाम॥ १/७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50006741, "chapter_id": 11361, "verse_number": "50", "content_sanskrit": "उवाचासहन्त्यस्य बन्धनाऽऽनयनं सती। मुच्यतां मुच्यतामेष ब्राह्मणो नितरां गुरुः॥ १/७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50006742, "chapter_id": 11361, "verse_number": "51", "content_sanskrit": "सरहस्यो धनुर्वेदः सविसर्गोपसंयमः। अस्त्रग्रामश्च भवता शिक्षितो यदनुग्रहात्॥ १/७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50006743, "chapter_id": 11361, "verse_number": "52", "content_sanskrit": "स एष भगवान् द्रोणः प्रजारूपेण वर्तते। तस्यात्मनोऽर्धं पत्न्यास्ते नान्वगाद्वीरसूः कृपी॥ १/७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50006744, "chapter_id": 11361, "verse_number": "53", "content_sanskrit": "तद्धर्मज्ञ महाभाग भवद्भिः कौरवं कुलम्। व्रजिनं नार्हति प्राप्तुं पूज्यं वन्द्यमभीक्ष्णशः॥ १/७/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50006745, "chapter_id": 11361, "verse_number": "54", "content_sanskrit": "मा रोदीदस्य जननी गौतमी पतिदेवता। यथाऽहं मृतवत्साऽऽर्ता रोदिम्यश्रुमुखी मुहुः॥ १/७/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50006746, "chapter_id": 11361, "verse_number": "55", "content_sanskrit": "यैः कोपितं ब्रह्मकुलं राजन्यैरकृतात्मभिः। तत्कुलं प्रदहत्याशु सानुबन्धं शुचार्पितम्॥ १/७/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50006747, "chapter_id": 11361, "verse_number": "56", "content_sanskrit": "सूत उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50006748, "chapter_id": 11361, "verse_number": "57", "content_sanskrit": "धर्म्यं न्याय्यं सकरुणं निर्व्यळीकं समं महत्। राजा धर्मसुतो राज्ञ्याः प्रत्यनन्दद्वचो द्विज॥ १/७/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50006749, "chapter_id": 11361, "verse_number": "58", "content_sanskrit": "नकुलः सहदेवश्च युयुधानो धनञ्जयः। भगवान् देवकीपुत्रो ये चान्ये याश्च योषितः॥ १/७/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50006750, "chapter_id": 11361, "verse_number": "59", "content_sanskrit": "तत्राहामर्षितो भीमः तस्य श्रेयान् वधः स्मृतः। न भर्तुर्नात्मनश्चार्थे योऽहन् सुप्तान् शिशून् वृथा॥ १/७/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 50006751, "chapter_id": 11361, "verse_number": "60", "content_sanskrit": "निशम्य भीमगदितं द्रौपद्याश्च चतुर्भुजः। आलोक्य वदनं सख्युरिदमाह हसन्निव॥ १/७/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 50006752, "chapter_id": 11361, "verse_number": "61", "content_sanskrit": "श्रीभगवानुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 50006753, "chapter_id": 11361, "verse_number": "62", "content_sanskrit": "ब्रह्मबन्धुर्न हन्तव्य आततायी वधार्हणः। मयैवोभयमाम्नातं परिपाह्यनुशासनम्॥ १/७/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 50006754, "chapter_id": 11361, "verse_number": "63", "content_sanskrit": "कुरु प्रतिश्रुतं सत्यं यत्तत् सान्त्वयता प्रियाम्। मतं च भीमसेनस्य पाञ्चाल्यै मह्यमेव च॥ १/७/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 50006755, "chapter_id": 11361, "verse_number": "64", "content_sanskrit": "सूत उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 50006756, "chapter_id": 11361, "verse_number": "65", "content_sanskrit": "अर्जुनः सहसाऽऽज्ञाय हरेर्हार्दमथासिना। मणिं जहार मूर्धन्यं द्विजस्य सहमूर्धजम्॥ १/७/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 50006757, "chapter_id": 11361, "verse_number": "66", "content_sanskrit": "विमुच्य रशनाबद्धं बालहत्याहतप्रभम्। तेजसा मणिना हीनं शिबिरान्निरयापयत्॥ १/७/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 50006758, "chapter_id": 11361, "verse_number": "67", "content_sanskrit": "बन्धनं द्रविणादानं स्थानान्निर्यापणं तथा। एष हि ब्रह्मबन्धूनां वधो नान्योऽस्ति दैहिकः॥ १/७/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 50006759, "chapter_id": 11361, "verse_number": "68", "content_sanskrit": "॥ इति श्रीमद्भागवते प्रथमस्कन्धे सप्तमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]