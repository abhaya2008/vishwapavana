[{"id": 2202944, "chapter_id": 5323, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2202945, "chapter_id": 5323, "verse_number": "१", "content_sanskrit": "सत्स्त्रीणां समुदाचारं सर्वधर्मभृतांवर ।\nश्रोतुमिच्छाम्यहं त्वत्तस्तं मे ब्रूहि पितामह\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2202946, "chapter_id": 5323, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2202947, "chapter_id": 5323, "verse_number": "२", "content_sanskrit": "सर्वज्ञां सर्वधर्मज्ञां देवलोके मनस्विनीम् ।\nकैकेयी सुमना नाम शाण्डिलीं पर्यपृच्छत\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2202948, "chapter_id": 5323, "verse_number": "३", "content_sanskrit": "केन वृत्तेन कल्याणि सदाचारेण केन वा ।\nविधूय सर्वपापानि देवलोकं त्वमागता\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2202949, "chapter_id": 5323, "verse_number": "४", "content_sanskrit": "हुताशनशिखेव त्वं ज्वलमाना स्वतेजसा ।\nसुता ताराधिपस्येव प्रभया दिवमागता\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2202950, "chapter_id": 5323, "verse_number": "५", "content_sanskrit": "अरजांसि च वस्त्राणि धारयन्ती गतक्लमा ।\nविमानस्था शुभे भासि सहस्रगुणमोजसा\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2202951, "chapter_id": 5323, "verse_number": "६", "content_sanskrit": "न त्वमल्पेन तपसा दानेन नियमेन वा ।\nइमं लोकमनुप्राप्ता तस्मात् तत् त्वं वदस्व मे\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2202952, "chapter_id": 5323, "verse_number": "समाप्तिः", "content_sanskrit": "इति पृष्टा सुमनया मधुरं चारुहासिनी ।\nशाण्डिली निभृतं वाक्यं सुमनामिदमब्रवीत्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2202953, "chapter_id": 5323, "verse_number": "८", "content_sanskrit": "नाहं काषायवसना नापि वल्कलधारिणी ।\nन च मुण्डा न जटिला भूत्वा देवत्वमागता\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2202954, "chapter_id": 5323, "verse_number": "९", "content_sanskrit": "अहितानि च वाक्यानि सर्वाणि परुषाणि च ।\nअप्रमत्ता च भर्तारं कदाचिन्नाहमब्रुवम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2202955, "chapter_id": 5323, "verse_number": "१०", "content_sanskrit": "देवतानां पितॄणां च ब्राह्मणानां च पूजने ।\nअप्रमत्ता सदायुक्ता श्वश्रूश्वशुरवर्तिनी\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2202956, "chapter_id": 5323, "verse_number": "११", "content_sanskrit": "पैशुन्ये न प्रवर्तामि न ममैतन्मनोगतम् ।\nप्रद्वारि च न तिष्ठामि चिरं न कथयामि च\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2202957, "chapter_id": 5323, "verse_number": "१२", "content_sanskrit": "असद्वा हसितं किञ्चिदहितं वापि कर्मणा ।\nरहस्यमरहस्यं वा न प्रवर्तामि सर्वथा\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2202958, "chapter_id": 5323, "verse_number": "१३", "content_sanskrit": "कार्यार्थे निर्गतं चापि भर्तारं गृहमागतम् ।\nआसनेनोपसंयोज्य पूजयामि समाहिता\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2202959, "chapter_id": 5323, "verse_number": "१४", "content_sanskrit": "यद्यच्च नाभिजानाति यद्भोज्यं नाभिनन्दति ।\nभक्ष्यं वाप्यथ वा लेह्यं तत्सर्वं वर्जयाम्यहम्\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2202960, "chapter_id": 5323, "verse_number": "१५", "content_sanskrit": "कुटुम्बार्थे समानीतं यत्किञ्चित् कार्यमेव तु ।\nप्रातरुत्थाय तत्सर्वं कारयामि करोमि च\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2202961, "chapter_id": 5323, "verse_number": "१६", "content_sanskrit": "प्रवासं यदि मे भर्ता याति कार्येण केनचित् ।\nमङ्गलैर्बहुभिर्युक्ता भवामि नियतासना\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2202962, "chapter_id": 5323, "verse_number": "१७", "content_sanskrit": "अञ्जनं रोचनां चैव स्नानं माल्यानुलेपनम् ।\nप्रसाधनं च निष्क्रान्ते नाभिनन्दामि भर्तरि\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2202963, "chapter_id": 5323, "verse_number": "१८", "content_sanskrit": "नोत्थापयामि भर्तारं सुखसुप्तमहं सदा ।\nआतुरेष्वपि कार्येषु तेन तुष्यति मे मनः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2202964, "chapter_id": 5323, "verse_number": "१९", "content_sanskrit": "नायासयामि भर्तारं कुटुम्बार्थे च सर्वदा ।\nगुप्तगुह्या सदा चास्मि सुसम्मृष्टनिवेशना\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2202965, "chapter_id": 5323, "verse_number": "२०", "content_sanskrit": "इमं धर्मपथं नारी पालयन्ती समाहिता ।\nअरुन्धतीव नारीणां स्वर्गलोके महीयते\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2202966, "chapter_id": 5323, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2202967, "chapter_id": 5323, "verse_number": "२१", "content_sanskrit": "एतदाख्याय सा देवी सुमनायै तपस्विनी ।\nपतिधर्मं महाभागा जगामादर्शनं तदा\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2202968, "chapter_id": 5323, "verse_number": "२२", "content_sanskrit": "यश्चेदं पाण्डवाख्यानं पठेत् पर्वणि पर्वणि ।\nस देवलोकं सम्प्राप्य नन्दने सुसुखं वसेत्\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2202969, "chapter_id": 5323, "verse_number": "", "content_sanskrit": "॥इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे सुमनाशाण्डिलीसंवादो नाम चतुःसप्तत्युत्तरशततमोऽध्यायः ॥१७४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]