[{"id": 2051964, "chapter_id": 2148, "verse_number": "७-७५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2051965, "chapter_id": 2148, "verse_number": "७-७५-१", "content_sanskrit": "प्रतिज्ञाते तु पार्थेन सिन्धुराजवधे तदा।\nवासुदेवो महाबाहुर्धनञ्जयमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2051966, "chapter_id": 2148, "verse_number": "७-७५-२", "content_sanskrit": "भ्रातॄणां मतमज्ञाय त्वया वाचा प्रतिश्रुतम्।\nसैन्धवं चास्मि हन्तेति तत्साहसमिदं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2051967, "chapter_id": 2148, "verse_number": "७-७५-३", "content_sanskrit": "असम्मन्त्र्य मया सार्धमतिभारोऽयमुद्यतः।\nकथं तु सर्वलोकस्य नावहास्या भवेमहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2051968, "chapter_id": 2148, "verse_number": "७-७५-४", "content_sanskrit": "धार्तराष्ट्रस्य शिबिरे ये तु प्रणिहिताश्चराः।\nत इमे शीघ्रमागम्य प्रवृत्तिं वेदयन्ति नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2051969, "chapter_id": 2148, "verse_number": "७-७५-५", "content_sanskrit": "त्वया वै सम्प्रतिज्ञाते सिन्धुराजवधे प्रभो।\nसिंहनादः सवादित्रः सुमहानिह तैः श्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2051970, "chapter_id": 2148, "verse_number": "७-७५-६", "content_sanskrit": "तेन शब्देन वित्रस्ता धार्तराष्ट्राः ससैन्धवाः।\nनाकस्मात्सिंहनादोऽयमिति मत्वा व्यवस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2051971, "chapter_id": 2148, "verse_number": "७-७५-७", "content_sanskrit": "सुमहाञ्शब्दसम्पातः कौरवाणां महाभुज।\nआसीन्नागाश्वपत्तीनां रथघोषश्च भैरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2051972, "chapter_id": 2148, "verse_number": "७-७५-८", "content_sanskrit": "अभिमन्योर्वधं श्रुत्वा ध्रुवमार्तो धनञ्जयः।\nरात्रौ निर्यास्यति क्रोधातिति मत्त्वा व्यवस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2051973, "chapter_id": 2148, "verse_number": "७-७५-९", "content_sanskrit": "तैश्चारेभ्य इयं कृत्स्ना श्रुता सत्यवतस्तव।\nप्रतिज्ञा सिन्धुराजस्य वधे राजीवलोचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2051974, "chapter_id": 2148, "verse_number": "७-७५-१०", "content_sanskrit": "ततो विमनसः सर्वे त्रस्ताः क्षुद्रमृगा इव।\nआसन्सुयोधनामात्याः स च राजा जयद्रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2051975, "chapter_id": 2148, "verse_number": "७-७५-११", "content_sanskrit": "अथोत्थाय सहामात्यैर्दीनः स्वशिविरात्किल।\nअयात्सौवीरसिन्धूनामीश्वरो राजसंसदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2051976, "chapter_id": 2148, "verse_number": "७-७५-१२", "content_sanskrit": "स मन्त्रकाले संमन्त्र्य सर्वां नैश्रेयसीं क्रियाम्।\nसुयोधनमिदं वाक्यमब्रवीद्राजसंसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2051977, "chapter_id": 2148, "verse_number": "७-७५-१३", "content_sanskrit": "मामसौ पुत्रहन्तेति श्वोऽभियाता धनञ्जयः।\nप्रतिज्ञातो हि सेनाया मध्ये तेन वधो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2051978, "chapter_id": 2148, "verse_number": "७-७५-१४", "content_sanskrit": "तां न देवा न गन्धर्वा नासुरोरगराक्षसाः।\nउत्सहन्तेऽन्यथा कर्तुं प्रतिज्ञां सव्यसाचिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2051979, "chapter_id": 2148, "verse_number": "७-७५-१५", "content_sanskrit": "ते मां रक्षत सङ्ग्रामे मा वो मूर्ध्नि धनञ्जयः।\nपदं कृत्वाऽऽप्नुयाल्लक्ष्यं युक्तं प्रतिविधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2051980, "chapter_id": 2148, "verse_number": "७-७५-१६", "content_sanskrit": "अथ रक्षा न मे सम्यक्क्रियते कुरुनन्दन।\nअनुजानीहि मां राजन्गमिष्यामि गृहान्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2051981, "chapter_id": 2148, "verse_number": "७-७५-१७", "content_sanskrit": "एवमुक्तस्त्ववाक्शीर्षो विमनाः ससुयोधनः।\nश्रुत्वा तं समयं तस्य ध्यानमेवान्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2051982, "chapter_id": 2148, "verse_number": "७-७५-१८", "content_sanskrit": "तमार्तमभिसम्प्रेक्ष्य राजा किल स सैन्धवः।\nमृदु चात्महितं चैव सापेक्षमिदमुक्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2051983, "chapter_id": 2148, "verse_number": "७-७५-१९", "content_sanskrit": "नेह पश्यामि भवतां तथावीर्यं धनुर्धरम्।\nयोऽर्जुनस्यास्त्रमस्त्रेण प्रतिहन्यान्महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2051984, "chapter_id": 2148, "verse_number": "७-७५-२०", "content_sanskrit": "वासुदेवसहायस्य गाण्डीवं धुन्वतो धनुः।\nकोऽर्जुनस्याग्रतस्तिष्ठेत्साक्षादपि शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2051985, "chapter_id": 2148, "verse_number": "७-७५-२१", "content_sanskrit": "महेश्वरोऽपि पार्थेन श्रूयते योधिनः पुरा।\nपदातिना महावीर्यो गिरौ हिमवति प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2051986, "chapter_id": 2148, "verse_number": "७-७५-२२", "content_sanskrit": "दानवानां सहस्राणि हिरण्यपुरवासिनाम्।\nजघानैकरथेनैव देवराजप्रचोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2051987, "chapter_id": 2148, "verse_number": "७-७५-२३", "content_sanskrit": "समायुक्तो हि कौन्तेयो बासुदेवेन धीमता।\nसामरानपि लोकांस्त्रीन्हन्यादिति मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2051988, "chapter_id": 2148, "verse_number": "७-७५-२४", "content_sanskrit": "सोऽहमिच्छाम्यनुज्ञातुं रक्षितुं वा महात्मना।\nद्रोणेन सहपुत्रेण वीरेण यदि मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2051989, "chapter_id": 2148, "verse_number": "७-७५-२५x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2051990, "chapter_id": 2148, "verse_number": "७-७५-२५", "content_sanskrit": "स राज्ञा स्वयमाचार्यो भृशमत्रार्थितोऽर्जुन।\nसंविधानं च विहितं रथाश्च किल सज्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2051991, "chapter_id": 2148, "verse_number": "७-७५-२६", "content_sanskrit": "कर्णो भूरिश्रवा द्रौणिर्वृषसेनश्च दुर्जयः।\nकृपश्च मद्रराजश्च षडेतेऽस्य पुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2051992, "chapter_id": 2148, "verse_number": "७-७५-२७", "content_sanskrit": "शकटः पद्मकश्चार्धो व्यूहो द्रोणेन निर्मितः।\nपद्मकर्णिकमध्यस्थः सूची पार्श्वे जयद्रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2051993, "chapter_id": 2148, "verse_number": "७-७५-२८", "content_sanskrit": "स्थास्यते रक्षिते वीरैः सिन्धुराट् स सुदुर्मदः।\nधनुष्यस्त्रे च वीर्ये च प्राणे चैव तथौरसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2051994, "chapter_id": 2148, "verse_number": "७-७५-२९", "content_sanskrit": "अविषह्यतमा ह्येते निश्चिताः पार्थ षड्रथाः।\nएतानजित्वा सगणान्नैव प्राप्यो जयद्रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2051995, "chapter_id": 2148, "verse_number": "७-७५-३०", "content_sanskrit": "तेषामेकैकशो वीर्यं षण्णां त्वमनुचिन्तय।\nसहिता हि नरव्याघ्र न शक्या जेतुमञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2051996, "chapter_id": 2148, "verse_number": "७-७५-३१", "content_sanskrit": "भूयस्तु मन्त्रयिष्यामि नीतिमात्महिताय वै।\nमन्त्रज्ञैः सचिवैः सार्धं सुहृद्भिः कार्यसिद्धये॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2051997, "chapter_id": 2148, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि प्रतिज्ञापर्वणि पञ्चसप्ततितमोऽध्यायः॥ ७५ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-७५-२ अशब्दो निषेधे। अज्ञात्वेत्यर्थः॥ ५-७५-२५ संविधानं प्रतिविधानम्॥ ५-७५-२७ पद्मव्यूहः पश्चार्धे पश्चाद्भागे यस्य। सूची सूचीमुखो व्यूहः॥ ५-७५-७५ पञ्चसप्ततितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]