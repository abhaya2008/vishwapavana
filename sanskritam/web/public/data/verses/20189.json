[{"id": 7000189000, "chapter_id": 20189, "verse_number": "१८९-१", "content_sanskrit": "अरिष्टवधनिरूपणम् व्यास उवाच गते शक्रे तु गोपालाः कृष्णमक्लिष्टकारिणम् ।\nऊचुः प्रीत्या धृतं दृष्ट्वा तेन गोवर्धनाचलम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000189001, "chapter_id": 20189, "verse_number": "१८९-२", "content_sanskrit": "गोपार ऊचुः वयमस्मान्महाभागा भवता महतो भयात् ।\nगावश्च भवता त्राता गिरिधारणकर्मणा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000189002, "chapter_id": 20189, "verse_number": "१८९-३", "content_sanskrit": "बालक्रीडेयमतुला गोपालत्वं जुगुप्सितम् ।\nदिव्यं च कर्म भवतः किमेतत्तात कथ्यताम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000189003, "chapter_id": 20189, "verse_number": "१८९-४", "content_sanskrit": "कालियो दमितस्तोये प्रलम्बो विनिपातितः ।\nधृतो गोवर्धनश्चायं शङ्कितानि मनांसि नः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000189004, "chapter_id": 20189, "verse_number": "१८९-५", "content_sanskrit": "सत्यं सत्यं हरेः पादौ श्रयामोऽमितविक्रम ।\nयथा त्वद्वीर्यमालोक्य न त्वां मन्यामहे नरम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000189005, "chapter_id": 20189, "verse_number": "१८९-६", "content_sanskrit": "देवो वा दानवो वा त्वं यक्षो गन्धर्व एव वा ।\nकिं चास्माकं विचारेण बान्धवोऽस्ति नमोऽस्तु ते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000189006, "chapter_id": 20189, "verse_number": "१८९-७", "content_sanskrit": "प्रीतिः सस्त्रीकुमारस्य व्रजस्य तव केशव ।\nकर्म चेदमशक्यं यत्समस्तैस्त्रिदशैरपि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000189007, "chapter_id": 20189, "verse_number": "१८९-८", "content_sanskrit": "बालत्वं चातिवीर्यं च जन्म चास्मास्वशोभनम् ।\nचिन्त्यमानममेयात्मञ्शङ्कां कृष्ण प्रयच्छति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000189008, "chapter_id": 20189, "verse_number": "१८९-९", "content_sanskrit": "व्यास उवाच क्षणं भूत्वा त्वसौ तूष्णीं किंचित्प्रणयकोपवान् ।\nइत्येवमुक्तस्तैर्गोपैराह कृष्णो द्विजोत्तमाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000189009, "chapter_id": 20189, "verse_number": "१८९-१०", "content_sanskrit": "श्रीकृष्ण उवाच मत्संबन्धेन वो गोपा यदि लज्जा न जायते ।\nश्लाघ्यो वाऽहं ततः किं वो विचारेण प्रयोजनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000189010, "chapter_id": 20189, "verse_number": "१८९-११", "content_sanskrit": "यदि वोऽस्ति मयि प्रीतिः श्लाघ्योऽहं भवतां यदि ।\nतदर्घा बन्धुसदृशी बान्धवाः क्रियतां मयि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000189011, "chapter_id": 20189, "verse_number": "१८९-१२", "content_sanskrit": "नाहं देवो न गन्धर्वो न यक्षो न च दानवः ।\nअहं वो बान्धवो जातो नातश्चिन्त्यमतोऽन्यथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000189012, "chapter_id": 20189, "verse_number": "१८९-१३", "content_sanskrit": "व्यास उवाच इति श्रुत्वा हरेर्वाक्यं बद्धमोनास्ततो बलम् ।\nययुर्गोपा महाभागास्तस्मिन्प्रणयकोपिनि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000189013, "chapter_id": 20189, "verse_number": "१८९-१४", "content_sanskrit": "कृष्णऽस्तु विमलव्योमशरच्चन्द्रस्य चन्द्रिकाम् ।\nतथा कुमुदिनीं फुल्लामामोदितदिगन्तराम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000189014, "chapter_id": 20189, "verse_number": "१८९-१५", "content_sanskrit": "वनराजीं तथा कूजद्‌भृङ्गमालामनोरमाम् ।\nविलोक्य सह गोपीभिर्मनश्चक्रे रतिं प्रति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000189015, "chapter_id": 20189, "verse_number": "१८९-१६", "content_sanskrit": "सह रामेण मधुरमतीव वनिताप्रियम् ।\nजगौ कमलपादोऽसौ नाम तत्र कृतव्रतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000189016, "chapter_id": 20189, "verse_number": "१८९-१७", "content_sanskrit": "रम्यं गीतध्वनिं श्रुत्वा संत्यज्यावसथांस्तदा ।\nआजग्मुस्त्वरिता गोप्यो यत्राऽऽस्ते मधुसूदनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000189017, "chapter_id": 20189, "verse_number": "१८९-१८", "content_sanskrit": "शनैः शनैर्जगौ गोपी काचित्तस्य पदानुगा ।\nदत्तावधाना काचिच्च तमेव मनसाऽस्मरत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000189018, "chapter_id": 20189, "verse_number": "१८९-१९", "content_sanskrit": "काचित्कृष्णेति कृष्णेति चोक्त्वा लज्जामुपाययौ ।\nययौ च काचित्प्रेमान्धा तत्पार्श्वमविलज्जिता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000189019, "chapter_id": 20189, "verse_number": "१८९-२०", "content_sanskrit": "काचिदावसथस्यान्तझ स्थित्वा दृष्ट्वा बहिर्गुरुम् ।\nतन्मयत्वेन गोविन्दं दध्यौ मीलितलोचना ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000189020, "chapter_id": 20189, "verse_number": "१८९-२१", "content_sanskrit": "गोपीपरिवृतो रात्रिं शरच्छन्द्रमनोरमाम् ।\nमानयामास गोविन्दो रासारम्भरसोत्सुकः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000189021, "chapter_id": 20189, "verse_number": "१८९-२२", "content_sanskrit": "गोप्यश्च वृन्दशः कृष्णचेष्टाभ्यायत्तमूर्तयः ।\nअन्यदेशगते कृष्णे चेरुर्वृन्दावनान्तरम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000189022, "chapter_id": 20189, "verse_number": "१८९-२३", "content_sanskrit": "बभ्रमुस्तास्ततो गोप्यः कृष्णदर्शलालसाः ।\nकृष्णस्य चरणं रात्रौ दृष्ट्वा वृन्दावने द्विजाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000189023, "chapter_id": 20189, "verse_number": "१८९-२४", "content_sanskrit": "एवं नानाप्रकारासु कृष्णचेष्टासु तासु च ।\nगोप्यो व्यग्राः समं चेरू रम्यं वृन्दावनं वनम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000189024, "chapter_id": 20189, "verse_number": "१८९-२५", "content_sanskrit": "निवृत्तास्तास्ततो गोप्यो निराशाः कृष्णदर्शने ।\nयमुनातीरमागम्य जगुस्तच्चरितं द्विजाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000189025, "chapter_id": 20189, "verse_number": "१८९-२६", "content_sanskrit": "ततो ददृशुरायान्तं विकाशि मुखपङ्कजम् ।\nगोप्यस्त्रैलोक्यगोप्तारं कृष्णमक्लिष्टकारिणम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000189026, "chapter_id": 20189, "verse_number": "१८९-२७", "content_sanskrit": "काचिदालोक्य गोवन्दमायान्तमतिहर्षिता ।\nकृष्ण कृष्णेति कृष्णेति प्राहोत्फुल्लविलोचना ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000189027, "chapter_id": 20189, "verse_number": "१८९-२८", "content_sanskrit": "काचिद्‌भ्रूभङ्गुरं कृत्वा ललाटफलकं हरिम् ।\nविलोक्य नेत्रभृङ्गाभ्यां पपौ तनमुखपङ्कजम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000189028, "chapter_id": 20189, "verse_number": "१८९-२९", "content_sanskrit": "काचिदालोक्य गोविन्दं निमीलितविलोचना ।\nतस्यैव रूपं ध्यायन्ती योगारूढेव सा बभौ ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000189029, "chapter_id": 20189, "verse_number": "१८९-३०", "content_sanskrit": "ततः कांचिदालोक्य गोविन्दं निमीलितविलोचना ।\nतस्यैव रूपं ध्यायन्ती योगारूढेव सा बभौ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000189030, "chapter_id": 20189, "verse_number": "१८९-३१", "content_sanskrit": "ताभिः प्रसन्नचित्ताभिर्गोपीभिः सह सादरम् ।\nरराम रासगोष्ठीभिरुदारचरितो हरिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000189031, "chapter_id": 20189, "verse_number": "१८९-३२", "content_sanskrit": "रासमण्डलबद्धोऽपि कृष्णपार्श्वमनूद्‌गता ।\nगोपीजनो न चैवाभूदेकस्थानस्थिरात्मना ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000189032, "chapter_id": 20189, "verse_number": "१८९-३३", "content_sanskrit": "हस्ते प्रगृहस्य चैकैकां गोपिकां रासमण्डमनूद्‌गता ।\nगोपीजनो न चैवाभूदेकस्थानस्थिरात्मना ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000189033, "chapter_id": 20189, "verse_number": "१८९-३४", "content_sanskrit": "ततः प्रगृह्य रम्या चलद्वलयनिस्वनैः ।\nअनुयातशरत्काव्यगेयगीतिरनुक्रमाम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000189034, "chapter_id": 20189, "verse_number": "१८९-३५", "content_sanskrit": "कृष्णः शरच्छन्द्रमसं कौमुदीकुमुदाकरम् ।\nजगौ गोपीजनस्त्वेकं कृष्णनाम पुनः पुनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000189035, "chapter_id": 20189, "verse_number": "१८९-३६", "content_sanskrit": "परिवृत्ता श्रमेणैका चलद्वालयतापिनी ।\nददौ बाहुलतां स्कन्धे गोपी मधुविधातिनः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000189036, "chapter_id": 20189, "verse_number": "१८९-३७", "content_sanskrit": "काचित्प्रविलसद्‌बाहुः परिरभ्य चुचुम्ब तम् ।\nगोपी गीतस्तुतिव्याजनिपुणा मधुसूदनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000189037, "chapter_id": 20189, "verse_number": "१८९-३८", "content_sanskrit": "गोपीकपोलसंश्लेषमभिपद्य हरेर्भुजौ ।\nपुलकोद्‌गमशस्याय स्वेदाम्बुघनतां गतौ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000189038, "chapter_id": 20189, "verse_number": "१८९-३९", "content_sanskrit": "रासगेयं जगौ कृष्णो यावत्तारतरध्वनिः ।\nसाधु कृष्णेति कृष्णेति तावत्ता द्विगुणं जगुः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000189039, "chapter_id": 20189, "verse_number": "१८९-४०", "content_sanskrit": "गतेऽनुगमनं चक्रुर्वलने संमुखं ययुः ।\nप्रतिलोमानुलोमेन भेजुर्गोपाङ्गना हरिम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000189040, "chapter_id": 20189, "verse_number": "१८९-४१", "content_sanskrit": "स तदा सह गोपीभी रराम मधुसूदनः ।\nस वर्षकोटिप्रतिमः क्षणस्तेन विनाऽभवत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000189041, "chapter_id": 20189, "verse_number": "१८९-४२", "content_sanskrit": "ता वार्यमाणाः पितृभिः पतिभिर्भातृभिस्तथा ।\nकृष्णं गोपाङ्गना रात्रौ रमयन्ति रतिप्रियाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000189042, "chapter_id": 20189, "verse_number": "१८९-४३", "content_sanskrit": "सोऽपि कैशोरकवया मानयन्मधुसूदनः ।\nरेमे ताभिरमेयात्मा क्षपासु क्षपिताहितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000189043, "chapter_id": 20189, "verse_number": "१८९-४४", "content_sanskrit": "तद्‌भर्तृषु तथा तासु सर्वभूतेषु चेश्वरः ।\nआत्मस्वरूपरूपोऽसौ व्याप्य सर्वमवस्थितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000189044, "chapter_id": 20189, "verse_number": "१८९-४५", "content_sanskrit": "यथा समस्तभूतेषु नभोऽग्निः पृथिवी जलम् ।\nवायुश्चाऽऽत्मा तथैवासौ व्याप्य सर्वमवस्थितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000189045, "chapter_id": 20189, "verse_number": "१८९-४६", "content_sanskrit": "व्यास उवाच प्रदोषार्धे कदाचित्तु रासासक्ते जनार्दने ।\nत्रासयन्समदो गोष्ठानरिष्टः समुपागतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000189046, "chapter_id": 20189, "verse_number": "१८९-४७", "content_sanskrit": "सतोयतोयदाकारस्तीक्ष्णशृङ्गोऽर्कलोचनः ।\nखुराग्रपातैरत्यर्थं दारयन्धरणीतलम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000189047, "chapter_id": 20189, "verse_number": "१८९-४८", "content_sanskrit": "लेलिहानः सनिष्पेषं जिह्‌वयोषठौ पुनः पुनः ।\nसंरम्भाक्षिप्तलाङ्गूलः कठिनस्कन्धबन्धनः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000189048, "chapter_id": 20189, "verse_number": "१८९-४९", "content_sanskrit": "उदग्रककुदाभोगः प्रमाणाद्‌दुरतिक्रमः ।\nविण्मूत्रालिप्तपृष्ठाङ्गो गवामुद्वेगकारकः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000189049, "chapter_id": 20189, "verse_number": "१८९-५०", "content_sanskrit": "प्रलम्बकण्ठोऽभिमुखस्तरुघाताङ्किताननः ।\nपातयन्स गवां गर्भान्दैत्यो वृषभरूपृधृक् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000189050, "chapter_id": 20189, "verse_number": "१८९-५१", "content_sanskrit": "सूदयंस्तरसा सर्वान्वनान्यटति यः सदा ।\nततस्तमतिघोराक्षमवेक्ष्यातिभयातुराः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000189051, "chapter_id": 20189, "verse_number": "१८९-५२", "content_sanskrit": "गोपा गोपस्त्रियश्चैव कृष्णकृष्णेति चुक्रुशुः ।\nसिंहनादं ततश्चक्रे तलशब्दं च केशवः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000189052, "chapter_id": 20189, "verse_number": "१८९-५३", "content_sanskrit": "तच्छब्दश्रवणाच्चसौ दामोदरमुखं ययौ ।\nअग्रन्यस्तविषाणाग्रः कृष्णकुक्षिकृतेक्षणः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000189053, "chapter_id": 20189, "verse_number": "१८९-५४", "content_sanskrit": "अभ्यधावत दुष्टात्मा दैत्यो वृषभरूपधृक् ।\nआयान्तं दैत्यवृषभं दृष्ट्वा कृष्णो महाबलम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000189054, "chapter_id": 20189, "verse_number": "१८९-५५", "content_sanskrit": "न चचाल ततः स्थानादवज्ञास्मितलीलया ।\nआसन्नं चैव जग्राह ग्राहवन्मधुसूदनः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000189055, "chapter_id": 20189, "verse_number": "१८९-५६", "content_sanskrit": "जघान जानुना कुक्षौ विषाणग्रहणाचलम् ।\nतस्य दर्पबलं हत्वा गृहीतस्य विषाणयोः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000189056, "chapter_id": 20189, "verse_number": "१८९-५७", "content_sanskrit": "आपीडयदरिष्टस्य कण्ठं क्लिन्नमिवाम्बरम् ।\nउत्पाट्य शृङ्गमेकं च तेनैवाताडयत्ततः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000189057, "chapter_id": 20189, "verse_number": "१८९-५८", "content_sanskrit": "ममार स महादैत्यो मुखाच्छोणितमुद्वमन् ।\nतुष्टुर्निहते तस्मिन्गोपा दैत्ये जनार्दनम् ।\nजम्भे हते सहस्राक्षं पुरा देवगणा यथा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]