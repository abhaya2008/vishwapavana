[{"id": 2151053, "chapter_id": 4280, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2151054, "chapter_id": 4280, "verse_number": "१", "content_sanskrit": "जम्बूखण्डस्त्वया प्रोक्तो यथावदिह सञ्जय ।\nविष्कम्भमस्य प्रब्रूहि परिमाणं च तत्त्वतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2151055, "chapter_id": 4280, "verse_number": "२", "content_sanskrit": "समुद्रस्य प्रमाणं च सम्यगच्छिद्रदर्शन ।\nशाकद्वीपं च मे ब्रूहि कुशद्वीपं च सञ्जय ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2151056, "chapter_id": 4280, "verse_number": "३", "content_sanskrit": "शाल्मलं चैव तत्त्वेन क्रौञ्चद्वीपं तथैव च ।\nब्रूहि गावल्गणे सर्वं राहोः सोमार्कयोस्तथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2151057, "chapter_id": 4280, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2151058, "chapter_id": 4280, "verse_number": "४", "content_sanskrit": "राजन् सुबहवो द्वीपा यैरिदं सन्ततं जगत् ।\nसप्त त्वहं प्रवक्ष्यामि चन्द्रादित्यौ ग्रहांस्तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2151059, "chapter_id": 4280, "verse_number": "५", "content_sanskrit": "अष्टादश सहस्राणि योजनानां विशाम्पते ।\nषट्शतानि च पूर्णानि विष्कम्भो जम्बुपर्वतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2151060, "chapter_id": 4280, "verse_number": "६", "content_sanskrit": "लावणस्य समुद्रस्य विष्कम्भो द्विगुणः स्मृतः ।\nनानाजनपदाकीर्णो मणिविद्रुमचित्रितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2151061, "chapter_id": 4280, "verse_number": "७", "content_sanskrit": "नैकधातुविचित्रैश्च पर्वतैरुपशोभितः ।\nसिद्धचारणसङ्कीर्णः सागरः परिमण्डलः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2151062, "chapter_id": 4280, "verse_number": "८", "content_sanskrit": "शाकद्वीपं च वक्ष्यामि यथावदिह पार्थिव ।\nशृणु मे त्वं यथान्यायं ब्रुवतः कुरुनन्दन ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2151063, "chapter_id": 4280, "verse_number": "९", "content_sanskrit": "जम्बूद्वीपप्रमाणेन द्विगुणः स नराधिप ।\nविष्कम्भेण महाराज सागरोऽपि विभागशः ।\nक्षीरोदो भरतश्रेष्ठ येन सम्परिवारितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2151064, "chapter_id": 4280, "verse_number": "१०", "content_sanskrit": "तत्र पुण्या जनपदा न तत्र म्रियते जनः ।\nकुत एव हि दुर्भिक्षं क्षमातेजोयुता हि ते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2151065, "chapter_id": 4280, "verse_number": "११", "content_sanskrit": "शाकद्वीपस्य सङ्क्षेपो यथावद् भरतर्षभ ।\nउक्त एष महाराज किमन्यच्छ्रोतुमिच्छसि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2151066, "chapter_id": 4280, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2151067, "chapter_id": 4280, "verse_number": "१२", "content_sanskrit": "शाकद्वीपस्य सङ्क्षेपो यथावदिह सञ्जय ।\nउक्तस्त्वया महाभाग विस्तरं ब्रूहि तत्त्वतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2151068, "chapter_id": 4280, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2151069, "chapter_id": 4280, "verse_number": "१३", "content_sanskrit": "तथैव पर्वता राजन् सप्तात्र मणिभूषिताः ।\nरत्नाकरास्तथा नद्यस्तेषां नामानि मे शृणु ।\nअतीवगुणवत्सर्वं तत्र पुण्यं जनाधिप ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2151070, "chapter_id": 4280, "verse_number": "१४", "content_sanskrit": "देवर्षिगन्धर्वयुतः परमो मेरुरुच्यते ।\nप्रागायतो महाराज मलयो नाम पर्वतः ।\nयतो मेघाः प्रवर्तन्ते प्रभवन्ति च सर्वशः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2151071, "chapter_id": 4280, "verse_number": "१५", "content_sanskrit": "ततः परेण कौरव्य जलधारो महागिरिः ।\nयत्र नित्यमुपादत्ते वासवः परमं जलम् ।\nयतो वर्षं प्रभवति वर्षाकाले जनेश्वर ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2151072, "chapter_id": 4280, "verse_number": "१६", "content_sanskrit": "उच्चैर्गिरी रैवतको यत्र नित्यं प्रतिष्ठिता ।\nरेवती दिवि नक्षत्रं पितामहकृतो विधिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2151073, "chapter_id": 4280, "verse_number": "१७", "content_sanskrit": "उत्तरेण तु राजेन्द्र श्यामो नाम महागिरिः ।\nयतः श्यामत्वमापन्नाः प्रजा जनपदेश्वर ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2151074, "chapter_id": 4280, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2151075, "chapter_id": 4280, "verse_number": "१८", "content_sanskrit": "सुमहान् संशयो मेऽद्य प्रोक्तं सञ्जय यत् त्वया ।\nप्रजाः कथं सूतपुत्र सम्प्राप्ताः श्यामतामिह ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2151076, "chapter_id": 4280, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2151077, "chapter_id": 4280, "verse_number": "१९", "content_sanskrit": "सर्वेष्वेव महाप्राज्ञ द्वीपेषु कुरुनन्दन ।\nगौरः कृष्णश्च वर्णौ द्वौ तयोर्वर्णान्तरं नृप ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2151078, "chapter_id": 4280, "verse_number": "२०", "content_sanskrit": "श्यामो यस्मात् प्रवृत्तो वै तत् ते वक्ष्यामि भारत ।\nआस्तेऽत्र भगवान् कृष्णस्तत्कान्त्या श्यामतां गतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2151079, "chapter_id": 4280, "verse_number": "", "content_sanskrit": "ततः परं कौरवेन्द्र दुर्गशैलो महोदयः ।\nकेसरी केसरयुतो यतो वातः प्रवायति ॥२१॥क्त्र", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2151080, "chapter_id": 4280, "verse_number": "२२", "content_sanskrit": "तेषां योजनविष्कम्भो द्विगुणः प्रविभागशः ।\nवर्षाणि तेषु कौरव्य सम्प्रोक्तानि मनीषिभिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2151081, "chapter_id": 4280, "verse_number": "२३", "content_sanskrit": "महामेरुर्महाकाशो जलदः कुमुदोत्तरः ।\nजलधारात् परो राजन् सुकुमार इति स्मृतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2151082, "chapter_id": 4280, "verse_number": "२४", "content_sanskrit": "रैवतस्य तु कौमारः श्यामस्य तु मणीचकः ।\nकेसरस्याथ मोदाकी परेण तु महापुमान् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2151083, "chapter_id": 4280, "verse_number": "२५", "content_sanskrit": "परिवार्य तु कौरव्य दैर्घ्यं ह्रस्वत्वमेव च ।\nजम्बूद्वीपेन विख्यातस्तस्य मध्ये महाद्रुमः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2151084, "chapter_id": 4280, "verse_number": "२६", "content_sanskrit": "शाको नाम महाराज तस्य द्वीपस्य मध्यगः ।\nतत्र पुण्या जनपदाः पूज्यते तत्र शङ्करः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2151085, "chapter_id": 4280, "verse_number": "२७", "content_sanskrit": "तत्र गच्छन्ति सिद्धाश्च चारणा दैवतानि च ।\nधार्मिकाश्च प्रजा राजंश्चत्वारोऽतीव भारत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2151086, "chapter_id": 4280, "verse_number": "२८", "content_sanskrit": "वर्णाः स्वकर्मनिरता न च स्तेनोऽत्र दृश्यते ।\nदीर्घायुषो महाराज जरामृत्युविवर्जिताः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2151087, "chapter_id": 4280, "verse_number": "२९", "content_sanskrit": "प्रजास्तत्र विवर्धन्ते वर्षास्विव समुद्रगाः ।\nनद्यः पुण्यजलास्तत्र गङ्गा च बहुधागतिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2151088, "chapter_id": 4280, "verse_number": "३०", "content_sanskrit": "सुकुमारी कुमारी च सीता कावेरका तथा ।\nमहानदी च कौरव्य तथा मणिजला नदी ।\nइक्षुवर्धनिका चैव तथा भरतसत्तम ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2151089, "chapter_id": 4280, "verse_number": "३१", "content_sanskrit": "ततः प्रवृत्ताः पुण्योदा नद्यः कुरुकुलोद्वह ।\nसहस्राणां शतान्येव यतो वर्षति वासवः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2151090, "chapter_id": 4280, "verse_number": "३२", "content_sanskrit": "न तासां नामधेयानि परिमाणं तथैव च ।\nशक्यते परिसङ्ख्यातुं पुण्यास्ता हि सरिद्वराः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2151091, "chapter_id": 4280, "verse_number": "३३", "content_sanskrit": "तत्र पुण्या जनपदाश्चत्वारो लोकसम्मताः ।\nमगाश्च मशकाश्चैव मानसा मन्दगास्तथा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2151092, "chapter_id": 4280, "verse_number": "३४", "content_sanskrit": "मगा ब्राह्मणभूयिष्ठाः स्वकर्मनिरता नृप ।\nमशकेषु तु राजन्या धार्मिकाः सर्वकामदाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2151093, "chapter_id": 4280, "verse_number": "३५", "content_sanskrit": "मानसेषु महाराज वैश्याः कर्मोपजीविनः ।\nसर्वकामसमायुक्ताः शूरा धर्मार्थनिश्चिताः ।\nशूद्रास्तु मन्दगे नित्यं पुरुषा धर्मशीलिनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2151094, "chapter_id": 4280, "verse_number": "३६", "content_sanskrit": "न तत्र राजा राजेन्द्र न दण्डो न च दण्डिकाः ।\nस्वधर्मेणैव धर्मं च ते रक्षन्ति परस्परम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2151095, "chapter_id": 4280, "verse_number": "३७", "content_sanskrit": "एतावदेव शक्यं तु तस्मिन् द्वीपे प्रभाषितुम् ।\nएतावदेव श्रोतव्यं शाकद्वीपे महौजसि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2151096, "chapter_id": 4280, "verse_number": "१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां वैयासिक्यां\nभीष्मपर्वणि द्वादशोऽध्यायः ॥१२॥\n॥ भूमिपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]