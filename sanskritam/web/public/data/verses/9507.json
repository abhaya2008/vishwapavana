[{"id": 5000507000, "chapter_id": 9507, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे शततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000507001, "chapter_id": 9507, "verse_number": "६-१००-१", "content_sanskrit": "तस्मिन् प्रतिहतेऽस्त्रे तु रावणो राक्षसाधिपः।\nक्रोधं च द्विगुणं चक्रे क्रोधाच्चास्त्रमनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000507002, "chapter_id": 9507, "verse_number": "६-१००-२", "content_sanskrit": "मयेन विहितं रौद्रमन्यदस्त्रं महाद्युतिः।\nउत्स्रष्टुं रावणो भीमं राघवाय प्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000507003, "chapter_id": 9507, "verse_number": "६-१००-३", "content_sanskrit": "ततः शूलानि निश्चेरुर्गदाश्च मुसलानि च।\nकार्मुकाद् दीप्यमानानि वज्रसाराणि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000507004, "chapter_id": 9507, "verse_number": "६-१००-४", "content_sanskrit": "मुद‍्गराः कूटपाशाश्च दीप्ताश्चाशनयस्तथा।\nनिष्पेतुर्विविधास्तीक्ष्णा वाता इव युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000507005, "chapter_id": 9507, "verse_number": "६-१००-५", "content_sanskrit": "तदस्त्रं राघवः श्रीमानुत्तमास्त्रविदां वरः।\nजघान परमास्त्रेण गान्धर्वेण महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000507006, "chapter_id": 9507, "verse_number": "६-१००-६", "content_sanskrit": "तस्मिन् प्रतिहतेऽस्त्रे तु राघवेण महात्मना।\nरावणः क्रोधताम्राक्षः सौरमस्त्रमुदीरयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000507007, "chapter_id": 9507, "verse_number": "६-१००-७", "content_sanskrit": "ततश्चक्राणि निष्पेतुर्भास्वराणि महान्ति च।\nकार्मुकाद् भीमवेगस्य दशग्रीवस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000507008, "chapter_id": 9507, "verse_number": "६-१००-८", "content_sanskrit": "तैरासीद् गगनं दीप्तं सम्पतद्भिः समन्ततः।\nपतद्भिश्च दिशो दीप्ताश्चन्द्रसूर्यग्रहैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000507009, "chapter_id": 9507, "verse_number": "६-१००-९", "content_sanskrit": "तानि चिच्छेद बाणौघैश्चक्राणि तु स राघवः।\nआयुधानि च चित्राणि रावणस्य चमूमुखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000507010, "chapter_id": 9507, "verse_number": "६-१००-१०", "content_sanskrit": "तदस्त्रं तु हतं दृष्ट्वा रावणो राक्षसाधिपः।\nविव्याध दशभिर्बाणै रामं सर्वेषु मर्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000507011, "chapter_id": 9507, "verse_number": "६-१००-११", "content_sanskrit": "स विद्धो दशभिर्बाणैर्महाकार्मुकनिःसृतैः।\nरावणेन महातेजा न प्राकम्पत राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000507012, "chapter_id": 9507, "verse_number": "६-१००-१२", "content_sanskrit": "ततो विव्याध गात्रेषु सर्वेषु समितिंजयः।\nराघवस्तु सुसंक्रुद्धो रावणं बहुभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000507013, "chapter_id": 9507, "verse_number": "६-१००-१३", "content_sanskrit": "एतस्मिन्नन्तरे क्रुद्धो राघवस्यानुजो बली।\nलक्ष्मणः सायकान् सप्त जग्राह परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000507014, "chapter_id": 9507, "verse_number": "६-१००-१४", "content_sanskrit": "तैः सायकैर्महावेगै रावणस्य महाद्युतिः।\nध्वजं मनुष्यशीर्षं तु तस्य चिच्छेद नैकधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000507015, "chapter_id": 9507, "verse_number": "६-१००-१५", "content_sanskrit": "सारथेश्चापि बाणेन शिरो ज्वलितकुण्डलम्।\nजहार लक्ष्मणः श्रीमान् नैर्ऋतस्य महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000507016, "chapter_id": 9507, "verse_number": "६-१००-१६", "content_sanskrit": "तस्य बाणैश्च चिच्छेद धनुर्गजकरोपमम्।\nलक्ष्मणो राक्षसेन्द्रस्य पञ्चभिर्निशितैस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000507017, "chapter_id": 9507, "verse_number": "६-१००-१७", "content_sanskrit": "नीलमेघनिभांश्चास्य सदश्वान् पर्वतोपमान्।\nजघानाप्लुत्य गदया रावणस्य विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000507018, "chapter_id": 9507, "verse_number": "६-१००-१८", "content_sanskrit": "हताश्वात् तु तदा वेगादवप्लुत्य महारथात्।\nकोपमाहारयत् तीव्रं भ्रातरं प्रति रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000507019, "chapter_id": 9507, "verse_number": "६-१००-१९", "content_sanskrit": "ततः शक्तिं महाशक्तिः प्रदीप्तामशनीमिव।\nविभीषणाय चिक्षेप राक्षसेन्द्रः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000507020, "chapter_id": 9507, "verse_number": "६-१००-२०", "content_sanskrit": "अप्राप्तामेव तां बाणैस्त्रिभिश्चिच्छेद लक्ष्मणः।\nअथोदतिष्ठत् संनादो वानराणां महारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000507021, "chapter_id": 9507, "verse_number": "६-१००-२१", "content_sanskrit": "सम्पपात त्रिधा छिन्ना शक्तिः काञ्चनमालिनी।\nसविस्फुलिङ्गा ज्वलिता महोल्केव दिवश्च्युता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000507022, "chapter_id": 9507, "verse_number": "६-१००-२२", "content_sanskrit": "ततः सम्भाविततरां कालेनापि दुरासदाम्।\nजग्राह विपुलां शक्तिं दीप्यमानां स्वतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000507023, "chapter_id": 9507, "verse_number": "६-१००-२३", "content_sanskrit": "सा वेगिता बलवता रावणेन दुरात्मना।\nजज्वाल सुमहातेजा दीप्ताशनिसमप्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000507024, "chapter_id": 9507, "verse_number": "६-१००-२४", "content_sanskrit": "एतस्मिन्नन्तरे वीरो लक्ष्मणस्तं विभीषणम्।\nप्राणसंशयमापन्नं तूर्णमभ्यवपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000507025, "chapter_id": 9507, "verse_number": "६-१००-२५", "content_sanskrit": "तं विमोक्षयितुं वीरश्चापमायम्य लक्ष्मणः।\nरावणं शक्तिहस्तं वै शरवर्षैरवाकिरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000507026, "chapter_id": 9507, "verse_number": "६-१००-२६", "content_sanskrit": "कीर्यमाणः शरौघेण विसृष्टेन महात्मना।\nन प्रहर्तुं मनश्चक्रे विमुखीकृतविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000507027, "chapter_id": 9507, "verse_number": "६-१००-२७", "content_sanskrit": "मोक्षितं भ्रातरं दृष्ट्वा लक्ष्मणेन स रावणः।\nलक्ष्मणाभिमुखस्तिष्ठन्निदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000507028, "chapter_id": 9507, "verse_number": "६-१००-२८", "content_sanskrit": "मोक्षितस्ते बलश्लाघिन् यस्मादेवं विभीषणः।\nविमुच्य राक्षसं शक्तिस्त्वयीयं विनिपात्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000507029, "chapter_id": 9507, "verse_number": "६-१००-२९", "content_sanskrit": "एषा ते हृदयं भित्त्वा शक्तिर्लोहितलक्षणा।\nमद‍्बाहुपरिघोत्सृष्टा प्राणानादाय यास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000507030, "chapter_id": 9507, "verse_number": "६-१००-३०", "content_sanskrit": "इत्येवमुक्त्वा तां शक्तिमष्टघण्टां महास्वनाम्।\nमयेन मायाविहिताममोघां शत्रुघातिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000507031, "chapter_id": 9507, "verse_number": "६-१००-३१", "content_sanskrit": "लक्ष्मणाय समुद्दिश्य ज्वलन्तीमिव तेजसा।\nरावणः परमक्रुद्धश्चिक्षेप च ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000507032, "chapter_id": 9507, "verse_number": "६-१००-३२", "content_sanskrit": "सा क्षिप्ता भीमवेगेन वज्राशनिसमस्वना।\nशक्तिरभ्यपतद् वेगाल्लक्ष्मणं रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000507033, "chapter_id": 9507, "verse_number": "६-१००-३३", "content_sanskrit": "तामनुव्याहरच्छक्तिमापतन्तीं स राघवः।\nस्वस्त्यस्तु लक्ष्मणायेति मोघा भव हतोद्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000507034, "chapter_id": 9507, "verse_number": "६-१००-३४", "content_sanskrit": "रावणेन रणे शक्तिः क्रुद्धेनाशीविषोपमा।\nमुक्ताऽऽशूरस्य भीतस्य लक्ष्मणस्य ममज्ज सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000507035, "chapter_id": 9507, "verse_number": "६-१००-३५", "content_sanskrit": "न्यपतत् सा महावेगा लक्ष्मणस्य महोरसि।\nजिह्वेवोरगराजस्य दीप्यमाना महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000507036, "chapter_id": 9507, "verse_number": "६-१००-३६", "content_sanskrit": "ततो रावणवेगेन सुदूरमवगाढया।\nशक्त्या विभिन्नहृदयः पपात भुवि लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000507037, "chapter_id": 9507, "verse_number": "६-१००-३७", "content_sanskrit": "तदवस्थं समीपस्थो लक्ष्मणं प्रेक्ष्य राघवः।\nभ्रातृस्नेहान्महातेजा विषण्णहृदयोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000507038, "chapter_id": 9507, "verse_number": "६-१००-३८", "content_sanskrit": "स मुहूर्तमिव ध्यात्वा बाष्पपर्याकुलेक्षणः।\nबभूव संरब्धतरो युगान्त इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000507039, "chapter_id": 9507, "verse_number": "६-१००-३९", "content_sanskrit": "न विषादस्य कालोऽयमिति संचिन्त्य राघवः।\nचक्रे सुतुमलं युद्धं रावणस्य वधे धृतः।\nसर्वयत्नेन महता लक्ष्मणं परिवीक्ष्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000507040, "chapter_id": 9507, "verse_number": "६-१००-४०", "content_sanskrit": "स ददर्श ततो रामः शक्त्या भिन्नं महाहवे।\nलक्ष्मणं रुधिरादिग्धं सपन्नगमिवाचलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000507041, "chapter_id": 9507, "verse_number": "६-१००-४१", "content_sanskrit": "तामपि प्रहितां शक्तिं रावणेन बलीयसा।\nयत्नतस्ते हरिश्रेष्ठा न शेकुरवमर्दितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000507042, "chapter_id": 9507, "verse_number": "६-१००-४२", "content_sanskrit": "अर्दिताश्चैव बाणौघैस्ते प्रवेकेण रक्षसाम्।\nसौमित्रेः सा विनिर्भिद्य प्रविष्टा धरणीतलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000507043, "chapter_id": 9507, "verse_number": "६-१००-४३", "content_sanskrit": "तां कराभ्यां परामृश्य रामः शक्तिं भयावहाम्।\nबभञ्ज समरे क्रुद्धो बलवान् विचकर्ष च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000507044, "chapter_id": 9507, "verse_number": "६-१००-४४", "content_sanskrit": "तस्य निष्कर्षतः शक्तिं रावणेन बलीयसा।\nशराः सर्वेषु गात्रेषु पातिता मर्मभेदिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000507045, "chapter_id": 9507, "verse_number": "६-१००-४५", "content_sanskrit": "अचिन्तयित्वा तान् बाणान् समाश्लिष्य च लक्ष्मणम्।\nअब्रवीच्च हनूमन्तं सुग्रीवं च महाकपिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000507046, "chapter_id": 9507, "verse_number": "६-१००-४६", "content_sanskrit": "लक्ष्मणं परिवार्यैवं तिष्ठध्वं वानरोत्तमाः।\nपराक्रमस्य कालोऽयं सम्प्राप्तो मे चिरेप्सितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000507047, "chapter_id": 9507, "verse_number": "६-१००-४७", "content_sanskrit": "पापात्मायं दशग्रीवो वध्यतां पापनिश्चयः।\nकांक्षितं चातकस्येव घर्मान्ते मेघदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000507048, "chapter_id": 9507, "verse_number": "६-१००-४८", "content_sanskrit": "अस्मिन् मुहूर्ते नचिरात् सत्यं प्रतिशृणोमि वः।\nअरावणमरामं वा जगद् द्रक्ष्यथ वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000507049, "chapter_id": 9507, "verse_number": "६-१००-४९", "content_sanskrit": "राज्यनाशं वने वासं दण्डके परिधावनम्।\nवैदेह्याश्च परामर्शो रक्षोभिश्च समागमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000507050, "chapter_id": 9507, "verse_number": "६-१००-५०", "content_sanskrit": "प्राप्तं दुःखं महाघोरं क्लेशश्च निरयोपमः।\nअद्य सर्वमहं त्यक्ष्ये निहत्वा रावणं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000507051, "chapter_id": 9507, "verse_number": "६-१००-५१", "content_sanskrit": "यदर्थं वानरं सैन्यं समानीतमिदं मया।\nसुग्रीवश्च कृतो राज्ये निहत्वा वालिनं रणे।\nयदर्थं सागरः क्रान्तः सेतुर्बद्धश्च सागरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000507052, "chapter_id": 9507, "verse_number": "६-१००-५२", "content_sanskrit": "सोऽयमद्य रणे पापश्चक्षुर्विषयमागतः।\nचक्षुर्विषयमागत्य नायं जीवितुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000507053, "chapter_id": 9507, "verse_number": "६-१००-५३", "content_sanskrit": "दृष्टिं दृष्टिविषस्येव सर्पस्य मम रावणः।\nयथा वा वैनतेयस्य दृष्टिं प्राप्तो भुजंगमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000507054, "chapter_id": 9507, "verse_number": "६-१००-५४", "content_sanskrit": "सुखं पश्यत दुर्धर्षा युद्धं वानरपुङ्गवाः।\nआसीनाः पर्वताग्रेषु ममेदं रावणस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000507055, "chapter_id": 9507, "verse_number": "६-१००-५५", "content_sanskrit": "अद्य पश्यन्तु रामस्य रामत्वं मम संयुगे।\nत्रयो लोकाः सगन्धर्वाः सदेवाः सर्षिचारणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000507056, "chapter_id": 9507, "verse_number": "६-१००-५६", "content_sanskrit": "अद्य कर्म करिष्यामि यल्लोकाः सचराचराः।\nसदेवाः कथयिष्यन्ति यावद् भूमिर्धरिष्यति।\nसमागम्य सदा लोके यथा युद्धं प्रवर्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000507057, "chapter_id": 9507, "verse_number": "६-१००-५७", "content_sanskrit": "एवमुक्त्वा शितैर्बाणैस्तप्तकाञ्चनभूषणैः।\nआजघान रणे रामो दशग्रीवं समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000507058, "chapter_id": 9507, "verse_number": "६-१००-५८", "content_sanskrit": "तथा प्रदीप्तैर्नाराचैर्मुसलैश्चापि रावणः।\nअभ्यवर्षत् तदा रामं धाराभिरिव तोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000507059, "chapter_id": 9507, "verse_number": "६-१००-५९", "content_sanskrit": "रामरावणमुक्तानामन्योन्यमभिनिघ्नताम्।\nवराणां च शराणां च बभूव तुमुलः स्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000507060, "chapter_id": 9507, "verse_number": "६-१००-६०", "content_sanskrit": "विच्छिन्नाश्च विकीर्णाश्च रामरावणयोः शराः।\nअन्तरिक्षात् प्रदीप्ताग्रा निपेतुर्धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000507061, "chapter_id": 9507, "verse_number": "६-१००-६१", "content_sanskrit": "तयोर्ज्यातलनिर्घोषो रामरावणयोर्महान्।\nत्रासनः सर्वभूतानां सम्बभूवाद्भुतोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000507062, "chapter_id": 9507, "verse_number": "६-१००-६२", "content_sanskrit": "स कीर्यमाणः शरजालवृष्टिभि-\nर्महात्मना दीप्तधनुष्मतार्दितः।\nभयात् प्रदुद्राव समेत्य रावणो\nयथानिलेनाभिहतो बलाहकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000507063, "chapter_id": 9507, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे शततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]