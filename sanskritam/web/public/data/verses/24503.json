[{"id": 7004503000, "chapter_id": 24503, "verse_number": "५-३-१९७-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nतस्यैवानन्तरं गच्छेत्सूर्यतीर्थमनुत्तमम् ।\nमूलस्थानमिति ख्यातं पद्मजस्थापितं शुभम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004503001, "chapter_id": 24503, "verse_number": "५-३-१९७-२", "content_sanskrit": "मूलश्रीपतिना देवी प्रोक्ता स्थापय भास्करम् ।\nश्रुत्वा देवोदितं देवी स्थापयामास भास्करम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004503002, "chapter_id": 24503, "verse_number": "५-३-१९७-३", "content_sanskrit": "प्रोच्यते नर्मदातीरे मूलस्थानाख्यभास्करः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004503003, "chapter_id": 24503, "verse_number": "५-३-१९७-४", "content_sanskrit": "तत्र तीर्थे नरो यस्तु स्नात्वा नियतमानसः ।\nसंतर्प्य पितृदेवांश्च पिण्डेन सलिलेन च॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004503004, "chapter_id": 24503, "verse_number": "५-३-१९७-५", "content_sanskrit": "मूलस्थानं ततः पश्येत्स गच्छेत्परमां गतिम् ।\nगुह्याद्गुह्यतरस्तत्र विशेषस्तु श्रुतो मया॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004503005, "chapter_id": 24503, "verse_number": "५-३-१९७-६", "content_sanskrit": "समागमे मुनीनां तु शङ्कराच्छशिशेखरात् ।\nसदा वै शुक्लसप्तम्यां मूलमादित्यवासरः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004503006, "chapter_id": 24503, "verse_number": "५-३-१९७-७", "content_sanskrit": "तदा रेवाजलं गत्वा स्नात्वा संतर्प्य देवताः ।\nपित्ःंश्च भरतश्रेष्ठ दत्त्वा दानं स्वशक्तितः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004503007, "chapter_id": 24503, "verse_number": "५-३-१९७-८", "content_sanskrit": "करवीरैस्ततो गत्वा रक्तचन्दनवारिणा ।\nसंस्थाप्य भास्करं भक्त्या सम्पूज्य च यथाविधि॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004503008, "chapter_id": 24503, "verse_number": "५-३-१९७-९", "content_sanskrit": "ततः सागुरुकैर्धूपैः कुन्दरैश्च विशेषतः ।\nधूपयेद्देवदेवेशं दीपान् बोध्य दिशो दश॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004503009, "chapter_id": 24503, "verse_number": "५-३-१९७-१०", "content_sanskrit": "उपोष्य जागरं कुर्याद्गीतवाद्यं विशेषतः ।\nएवं कृते महीपाल न भवेदुग्रदुःखभाक्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004503010, "chapter_id": 24503, "verse_number": "५-३-१९७-११", "content_sanskrit": "सूर्यलोके वसेत्तावद्यावत्कल्पशतत्रयम् ।\nगन्धर्वैरप्सरोभिश्च सेव्यमानो नृपोत्तम॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]