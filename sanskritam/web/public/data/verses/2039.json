[{"id": 2046819, "chapter_id": 2039, "verse_number": "६-८८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2046820, "chapter_id": 2039, "verse_number": "६-८८-१", "content_sanskrit": "भीष्मं तु समरे क्रुद्धं प्रतपन्तं समन्ततः।\nन शेकुः पाण्डवा द्रष्टुं तपन्तमिव भास्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2046821, "chapter_id": 2039, "verse_number": "६-८८-२", "content_sanskrit": "ततः सर्वाणि सैन्यानि धर्मपुत्रस्य शासनात्।\nअभ्यद्रवन्त गाङ्गेयं मर्दयन्तं शितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2046822, "chapter_id": 2039, "verse_number": "६-८८-३", "content_sanskrit": "स तु भीष्मो रणश्लाघी तोमकान्सहसृज्जयान् ।\nपाञ्चालांश्च महेष्वासान्पातयामास सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2046823, "chapter_id": 2039, "verse_number": "६-८८-४", "content_sanskrit": "ते वध्यमाना भीष्मेण पाञ्चालाः पाण्डवैः सह।\nभीष्ममेवाभ्ययुस्तूर्णं त्यक्त्वा मृत्युकृतं भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2046824, "chapter_id": 2039, "verse_number": "६-८८-५", "content_sanskrit": "स तेषां रथिनां वीरो भीष्मः शान्तनवो युधि ।\nचिच्छेद सहसा राजन्बाहूनथ शिरांसि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2046825, "chapter_id": 2039, "verse_number": "६-८८-६", "content_sanskrit": "विरथान्रथिनश्चक्रे पिता देवव्रतस्तव।\nपतितान्युत्तमाङ्गानि हयेभ्यो हयसादिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2046826, "chapter_id": 2039, "verse_number": "६-८८-७", "content_sanskrit": "निर्मनुष्यांश्च मातङ्गाञ्शयानान्पर्वतोपमान् ।\nअपश्याम महाराज भीष्मास्त्रेण प्रमाथितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2046827, "chapter_id": 2039, "verse_number": "६-८८-८", "content_sanskrit": "न तत्रासीत्पुमान्कश्चित्पाण्डवानां विशांपते।\nअन्यत्र रथिनां श्रेष्ठद्भीमसेनान्महाबलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2046828, "chapter_id": 2039, "verse_number": "६-८८-९", "content_sanskrit": "स हि भीष्मं समासाद्य छादयामास सायकैः ।\nततो निष्टानको घोरो भीष्मभीमसमागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2046829, "chapter_id": 2039, "verse_number": "६-८८-१०", "content_sanskrit": "बभूव सर्वसैन्यानां घोररूपो भयानकः ।\nतथैव पाण्डवा हृष्टाः सिंहनादमथानदन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2046830, "chapter_id": 2039, "verse_number": "६-८८-११", "content_sanskrit": "ततो दुर्योधनो राजा सोदर्यैः परिवारितः।\nभीष्मं जुगोप समरे वर्तमाने जनक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2046831, "chapter_id": 2039, "verse_number": "६-८८-१२", "content_sanskrit": "भीमस्तु सारथिं हत्वा भीष्मस्य रथिनां वरः।\nप्रद्रुताश्वे रथे तस्मिन्द्रवमाणे समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2046832, "chapter_id": 2039, "verse_number": "६-८८-१३", "content_sanskrit": "सुनाभस्य शरेणाशु शिरश्चिच्छेद भारत ।\nक्षुरप्रेण सुतीक्ष्णेन स हतो न्यपतद्भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2046833, "chapter_id": 2039, "verse_number": "६-८८-१४", "content_sanskrit": "हते तस्मिन्महाराज तव पुत्रे महारथे ।\nनामृष्यन्त रणे शूराः सोदराः सप्त संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2046834, "chapter_id": 2039, "verse_number": "६-८८-१५", "content_sanskrit": "आदित्यकेतुर्बह्वाशी कुण्डधारो महोदरः ।\nअपराजितः पण्डितको विशालाक्षः सुदुर्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2046835, "chapter_id": 2039, "verse_number": "६-८८-१६", "content_sanskrit": "पाण्डवं चित्रसन्नाहा विचित्रकवचध्वजाः ।\nअभ्यद्रवन्त संग्रामे योद्धुकामारिमर्दनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2046836, "chapter_id": 2039, "verse_number": "६-८८-१७", "content_sanskrit": "महोदरस्तु समरे भीमं विव्याध पत्रिभिः ।\nनवभिर्वद्रसंकाशैर्नमुचिं वृत्रहा यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2046837, "chapter_id": 2039, "verse_number": "६-८८-१८", "content_sanskrit": "आदित्यकेतुः सप्तत्या बह्वाशी चापि पञ्चभिः ।\nनवत्या कुण्डधारश्च विशालाक्षश्च पञ्चभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2046838, "chapter_id": 2039, "verse_number": "६-८८-१९", "content_sanskrit": "अपराजितो महाराज पराजिष्णुर्महारथम् ।\nशरैर्बहुभिरानर्च्छद्भीमसेनं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2046839, "chapter_id": 2039, "verse_number": "६-८८-२०", "content_sanskrit": "रणे पण्डितकश्चैनं त्रिभिर्बाणैः समार्पयत्।\nस तं न ममृषे भीमः शत्रुभिर्वधमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2046840, "chapter_id": 2039, "verse_number": "६-८८-२१", "content_sanskrit": "धनुः प्रपीड्य वामेन करेणामित्रकर्सनः ।\nशिरश्चिच्छेद समरे शरेणानतपर्वणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2046841, "chapter_id": 2039, "verse_number": "६-८८-२२", "content_sanskrit": "अपराजितस्य सुनसं तव पुत्रस्य संयुगे ।\nपराजितस्य भीमेन कृत्तं गामपतच्छिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2046842, "chapter_id": 2039, "verse_number": "६-८८-२३", "content_sanskrit": "अथापरेण भल्लेन कुण्डधारं महारथम् ।\nप्राहिणोन्मृत्युलोकाय सर्वलोकस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2046843, "chapter_id": 2039, "verse_number": "६-८८-२४", "content_sanskrit": "ततः पुनरमेयात्मा प्रसंधाय शिलीमुखम् ।\nप्रेषयामास समरे पण्डितं प्रति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2046844, "chapter_id": 2039, "verse_number": "६-८८-२५", "content_sanskrit": "स शरः पण्डितं हत्वा विवेश धरणीतलम् ।\nयथा नरं निहत्याशु भुजगः कालचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2046845, "chapter_id": 2039, "verse_number": "६-८८-२६", "content_sanskrit": "विशालाक्षशिरश्छित्त्वा पातयामास भूतले।\nत्रिभिः शरैरदीनात्मा स्मरन्क्लेशं पुरातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2046846, "chapter_id": 2039, "verse_number": "६-८८-२७", "content_sanskrit": "महोदरं महेष्वासं नाराचेन स्तनान्तरे ।\nविव्याध समरे राजन्स हतो न्यपतद्भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2046847, "chapter_id": 2039, "verse_number": "६-८८-२८", "content_sanskrit": "आदित्यकेतोः केतुं च च्छित्त्वा बाणेन संयुगे ।\nभल्लेन भृशतीक्ष्णेन शिरश्चिच्छेद भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2046848, "chapter_id": 2039, "verse_number": "६-८८-२९", "content_sanskrit": "बह्वाशिनं तत भीमः शरेणानतर्वणा ।\nप्रेषयामास संक्रुद्धो यमस्य सदनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2046849, "chapter_id": 2039, "verse_number": "६-८८-३०", "content_sanskrit": "प्रदुद्रुवुस्ततस्तेऽन्ये पुत्रास्तव विशांपते ।\nमन्यमाना हि तत्सत्यं सभायां तस्य भाषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2046850, "chapter_id": 2039, "verse_number": "६-८८-३१", "content_sanskrit": "ततो दुर्योधनो राजा भ्रातृव्यसनकर्शितः।\nअब्रवीत्तावकान्योधान्भीमोऽयं वध्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2046851, "chapter_id": 2039, "verse_number": "६-८८-३२", "content_sanskrit": "एवमेते महेष्वासाः पुत्रास्त्व विशांपते ।\nभ्रातॄन्संदृश्य निहतान्प्रस्मरंस्ते हि तद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2046852, "chapter_id": 2039, "verse_number": "६-८८-३३", "content_sanskrit": "यदुक्तवान्महाप्राज्ञः क्षत्ता हितमनामयम् ।\nतदिदं समनुप्राप्तं वचनं दिव्यदर्शिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2046853, "chapter_id": 2039, "verse_number": "६-८८-३४", "content_sanskrit": "लोभमोहसमाविष्टः पुत्रप्रीत्या जनाधिप।\nन बुध्यसे पुरा यत्तत्तथ्यमुक्तं वचो महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2046854, "chapter_id": 2039, "verse_number": "६-८८-३५", "content_sanskrit": "तथैव च वधार्थाय पुत्राणां पाण्डवो बली।\nनूनं जातो महाबाहुर्यथा हन्ति स्म कौरवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2046855, "chapter_id": 2039, "verse_number": "६-८८-३६", "content_sanskrit": "ततो दुरयोधनो राजा भीष्ममासाद्य संयुगे।\nदुःखेन महताऽऽविष्टो विललाप सुदुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2046856, "chapter_id": 2039, "verse_number": "६-८८-३७", "content_sanskrit": "निहता भ्रातरः शूरा भीमसेनेन मे युधि।\nयतमानास्तथान्येऽपि हन्यन्ते सर्वसैनिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2046857, "chapter_id": 2039, "verse_number": "६-८८-३८", "content_sanskrit": "भवांश्च मध्यस्थतया नित्यमस्मानुपेक्षते।\nसोऽहं कुपथमारूढः पश्य दैवमिदं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2046858, "chapter_id": 2039, "verse_number": "६-८८-३९", "content_sanskrit": "एतच्छ्रुत्वा वचः क्रूरं पिता देवव्रतस्तव।\nदुर्योधनमिदं वाक्यमब्रवीत्समाश्रुलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2046859, "chapter_id": 2039, "verse_number": "६-८८-४०", "content_sanskrit": "उक्तमेतन्मया पूर्वं द्रोणेन विदुरेण च ।\nगान्धार्या च यशस्विन्या तत्त्वं तात न बुद्धवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2046860, "chapter_id": 2039, "verse_number": "६-८८-४१", "content_sanskrit": "समयश्च मया पूर्वं कृतो वै शत्रुकर्शन ।\nनाहंयुधि नियोक्तव्यो नाप्याचार्यः कथंचना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2046861, "chapter_id": 2039, "verse_number": "६-८८-४२", "content_sanskrit": "यय हि धर्तराष्ट्राणां भीमो द्रक्ष्यति संयुगे।\nहनिष्यति रणे नित्यं सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2046862, "chapter_id": 2039, "verse_number": "६-८८-४३", "content_sanskrit": "स त्वं राजन्स्थिरो भूत्वा रणे कृत्वा दृढां मतिम् ।\nयोधयस्व रणे पार्थान्स्वर्गं कृत्वा परायणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2046863, "chapter_id": 2039, "verse_number": "६-८८-४४", "content_sanskrit": "न शक्यः पाण्डवा जेतुं सेन्द्रैरपि सुरासुरैः ।\nतस्माद्युद्धे स्थिरां कृत्वा मतिं युद्ध्यस्व भारत ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2046864, "chapter_id": 2039, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभरते भीष्मपर्वणि भीष्मवधपर्वणि अष्टमदिवसयुद्धे अष्टाशीतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]