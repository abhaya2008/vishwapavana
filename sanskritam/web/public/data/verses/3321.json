[{"id": 2106906, "chapter_id": 3321, "verse_number": "१८-६-१", "content_sanskrit": "जनमेजय उवाच।\nभगवन्केन विधिना श्रोतव्यं भारतं बुधैः।\nफलं किं के च देवाश्च पूज्या वै पारणेष्विह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106907, "chapter_id": 3321, "verse_number": "१८-६-२", "content_sanskrit": "देयं समाप्ते भगवन्किं च पर्वणिपर्वणि।\nवाचकः कीदृशश्चात्र एष्टव्यस्तद्ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106908, "chapter_id": 3321, "verse_number": "१८-६-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106909, "chapter_id": 3321, "verse_number": "१८-६-३", "content_sanskrit": "शृणु राजन्विधिमिमं फलं यच्चापि भारतात्।\nश्रुताद्भवति राजेन्द्र यत्त्वं मामनुपृच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106910, "chapter_id": 3321, "verse_number": "१८-६-४", "content_sanskrit": "दिवि देवा महीपाल क्रीडार्थमवनिं गताः।\nकृत्वा कार्यमिदं चैव ततश्च दिवमागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106911, "chapter_id": 3321, "verse_number": "१८-६-५", "content_sanskrit": "हन्त यत्ते प्रवक्ष्यामि तच्छृणुष्व समाहितः।\nऋषीणां देवतानां च सम्भवं वसुधातले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106912, "chapter_id": 3321, "verse_number": "१८-६-६", "content_sanskrit": "अत्र रुद्रास्तथा साध्या विश्वेदेवाश्च शाश्वताः।\nआदित्याश्चाश्विनौ देवौ लोकपाला महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106913, "chapter_id": 3321, "verse_number": "१८-६-७", "content_sanskrit": "गुह्यकाश्च सगन्धर्वा नागा विद्याधरास्तथा।\nसिद्धा धर्मः स्वयंभूश्च मुनिः कात्यायनो वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106914, "chapter_id": 3321, "verse_number": "१८-६-८", "content_sanskrit": "गिरयः सागरा नद्यस्तथैवाप्सरसां गणाः।\nग्रहाः संवत्सराश्चैव अयनान्यृतवस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106915, "chapter_id": 3321, "verse_number": "१८-६-९", "content_sanskrit": "स्थावरं जङ्गमं चैव जगत्सर्वं सुरासुरम्।\nभातरे भरतश्रेष्ठ एकस्थमिह दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106916, "chapter_id": 3321, "verse_number": "१८-६-१०", "content_sanskrit": "तेषां श्रुत्वा प्रतिष्ठानं नामकर्मानुकीर्तनात्।\nकृत्वाऽपि पातकं घोरं सद्यो मुच्येत मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106917, "chapter_id": 3321, "verse_number": "१८-६-११", "content_sanskrit": "इतिहासमिमं श्रुत्वा यथावदनुपूर्वशः।\nसंयतात्मा शुचिर्भूत्वा पारं गत्वा च भारते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106918, "chapter_id": 3321, "verse_number": "१८-६-१२", "content_sanskrit": "तेषां श्राद्धानि देयानि श्रुत्वा भारत भारतम्।\nब्राह्मणेभ्यो यथाशक्त्या भक्त्या च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106919, "chapter_id": 3321, "verse_number": "१८-६-१३", "content_sanskrit": "महादानानि देयानि रत्नानि विविधानि च।\nगावः कांस्योपदोहाश्च कन्याश्चैव स्वलङ्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106920, "chapter_id": 3321, "verse_number": "१८-६-१४", "content_sanskrit": "सर्वकामगुणोपेता यानानि विविधानि च।\nकभवनानि विचित्राणि भूमिर्वासांसि काञ्चनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106921, "chapter_id": 3321, "verse_number": "१८-६-१५", "content_sanskrit": "वाहनानि च देयानि हया मत्ताश्च वारणाः।\nशयनं शिबिकाश्चैव स्यन्दनाश्च स्वलंकृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106922, "chapter_id": 3321, "verse_number": "१८-६-१६", "content_sanskrit": "यद्यद्गृहे वरं किञ्चिद्यद्यदस्ति महद्वसु।\nतत्तद्देयं द्विजातिभ्य आत्मा दाराश्च सूनवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106923, "chapter_id": 3321, "verse_number": "१८-६-१७", "content_sanskrit": "श्रद्धया परया युक्तं क्रमशस्तस्य पारगः।\nशक्तितः सुमना हृष्टः सुश्रूषुरविकल्पकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106924, "chapter_id": 3321, "verse_number": "१८-६-१८", "content_sanskrit": "सत्यार्जवरतो दान्तः शुचिः शौचसमन्वितः।\nश्रद्धधानो जितक्रोधो यथा सिद्ध्यति तच्छृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106925, "chapter_id": 3321, "verse_number": "१८-६-१९", "content_sanskrit": "शुचिः शीलान्विताचारः शुक्लवासा जितेन्द्रियः।\nसंस्कृतः सर्वशास्त्रज्ञः श्रद्दधानोऽनसूयकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106926, "chapter_id": 3321, "verse_number": "१८-६-२०", "content_sanskrit": "रूपवान्सुभगो दान्तः सत्यवादी जितेन्द्रियः।\nदानमानगृहीतश्च कार्यो भवति वाचकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106927, "chapter_id": 3321, "verse_number": "१८-६-२१", "content_sanskrit": "अविलम्बमनायस्तमद्रुतं धीरमुर्जितम्।\nअसंसक्ताक्षरपदं स्वरभावसमन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106928, "chapter_id": 3321, "verse_number": "१८-६-२२", "content_sanskrit": "त्रिषष्टिवर्णसंयुक्तमष्टस्थानसमीरितम्।\nवाचयेद्वाचकः स्वस्थः स्वासीनः सुसमाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2106929, "chapter_id": 3321, "verse_number": "१८-६-२३", "content_sanskrit": "नारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं(व्यासं) चैव ततो जयमुदीरयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2106930, "chapter_id": 3321, "verse_number": "१८-६-२४", "content_sanskrit": "ईदृशाद्वाचकाद्राजञ्श्रुत्वा भारत भारतम्।\nनियमस्थः शुचिः श्रोता शृण्वन्स फलमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2106931, "chapter_id": 3321, "verse_number": "१८-६-२५", "content_sanskrit": "पारणं प्रथमं प्राप्य द्विजान्कामैश्च तर्पयन्।\nआग्निष्टोमस्य यज्ञस्य फलं वै लभते नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2106932, "chapter_id": 3321, "verse_number": "१८-६-२६", "content_sanskrit": "अप्सरोगणसंकीर्णं विमानं लभते महत्।\nप्रहृष्टः स तु देवैश्च दिवं याति समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2106933, "chapter_id": 3321, "verse_number": "१८-६-२७", "content_sanskrit": "द्वितीयं पारणं प्राप्य सोतिरात्रफलं लभेत्।\nसर्वरत्नमयं दिव्यं विमानमधिरोहति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2106934, "chapter_id": 3321, "verse_number": "१८-६-२८", "content_sanskrit": "दिव्यमाल्यांबरधरो दिव्यगन्धविभूषितः।\nदिव्याङ्गदधरो नित्यं देवलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2106935, "chapter_id": 3321, "verse_number": "१८-६-२९", "content_sanskrit": "तृतीयं पारणं प्राप्य द्वादशाहफलं लभेत्।\nवसत्यमरसंकाशो वर्षाण्ययुतशो दिवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2106936, "chapter_id": 3321, "verse_number": "१८-६-३०", "content_sanskrit": "चतुर्थे वाजपेयस्य पञ्चमे द्विगुणं फलम्।\nउदितादित्यसंकाशं ज्वलन्तमनलोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2106937, "chapter_id": 3321, "verse_number": "१८-६-३१", "content_sanskrit": "विमानं विबुधैः सार्धमारुह्य दिवि गच्छति।\nवर्षायुतानि भने शक्रस्य दिवि मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2106938, "chapter_id": 3321, "verse_number": "१८-६-३२", "content_sanskrit": "षष्ठे द्विगुणमस्तीति सप्तमे त्रिगुणं फलम्।\nकैलासशिखराकारं वैदूर्यमणिवेदिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2106939, "chapter_id": 3321, "verse_number": "१८-६-३३", "content_sanskrit": "परिक्षिप्तं च बहुधा मणिविद्रुमभूषितम्।\nविमानं समधिष्ठाय कामगं साप्सरोगणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2106940, "chapter_id": 3321, "verse_number": "१८-६-३४", "content_sanskrit": "सर्वांल्लोकान्विचरते द्वितीय इव भास्करः।\nअष्टमे राजसूयस्य पारणे लभते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2106941, "chapter_id": 3321, "verse_number": "१८-६-३५", "content_sanskrit": "चन्द्रोदयनिभं रम्यं विमानमधिरोहति।\nचन्द्ररश्मिप्रतीकाशैर्हयैर्युक्तं मनोजवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2106942, "chapter_id": 3321, "verse_number": "१८-६-३६", "content_sanskrit": "सेव्यमानो वरस्त्रीणां चन्द्रात्कान्ततरैर्मुखैः।\nमेखलानां निनादेन नूपुराणां च निःस्वनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2106943, "chapter_id": 3321, "verse_number": "१८-६-३७", "content_sanskrit": "अङ्के परमनारीणां सुखसुप्तो विबुध्यते।\nनवमे क्रतुराजस्य वाजिमेधस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2106944, "chapter_id": 3321, "verse_number": "१८-६-३८", "content_sanskrit": "काञ्चनस्तंभनिर्यूहवैदूर्यकृतवेदिकम्।\nजांबूनदमयैर्दिव्यैर्गवाक्षैः सर्वतो वृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2106945, "chapter_id": 3321, "verse_number": "१८-६-३९", "content_sanskrit": "सेवितं चाप्सरःसङ्घैर्गन्धर्वैर्दिविचारिभिः।\nविमानं समधिष्ठाय श्रिया परमया ज्वलन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2106946, "chapter_id": 3321, "verse_number": "१८-६-४०", "content_sanskrit": "दिव्यमाल्यांबरधरो दिव्यचन्दनरूषितः।\nमोदते दैवतैः सार्धं दिवि देव इवापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2106947, "chapter_id": 3321, "verse_number": "१८-६-४१", "content_sanskrit": "दशमं पारणं प्राप्य द्विजातीनभिवन्द्य च।\nकिङ्किणीजालनिर्घोषं पताकाध्वजशोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2106948, "chapter_id": 3321, "verse_number": "१८-६-४२", "content_sanskrit": "रत्नवेदिकसम्बाद्यं वैदूर्यमणितोरणम्।\nहेमजालपरिक्षिप्तं प्रवालवलभीमुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2106949, "chapter_id": 3321, "verse_number": "१८-६-४३", "content_sanskrit": "गन्धर्वैर्गीतकुशलैरप्सरोभिश्च शोभितम्।\nविमानं सुकृतावासं सुखेनैवोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2106950, "chapter_id": 3321, "verse_number": "१८-६-४४", "content_sanskrit": "मुकुटेनाग्निवर्णेन जांबूनदविभूषिणा।\nदिव्यचन्दनदिग्धाङ्गो दिव्यमाल्यविभूषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2106951, "chapter_id": 3321, "verse_number": "१८-६-४५", "content_sanskrit": "दिव्याँल्लोकान्विचरति दिव्यैर्भोगैः समन्वितः।\nविबुधानां प्रसादेन श्रिया परमया युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2106952, "chapter_id": 3321, "verse_number": "१८-६-४६", "content_sanskrit": "अथ वर्षगणानेवं स्वर्गलोके महीयते।\nततो गन्धर्वसहितः सहस्राण्येकविंशतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2106953, "chapter_id": 3321, "verse_number": "१८-६-४७", "content_sanskrit": "पुरंदरपुरे रम्ये शक्रेण सह मोदते।\nदिव्ययानविमानेषु लोकेषु विविधेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2106954, "chapter_id": 3321, "verse_number": "१८-६-४८", "content_sanskrit": "दिव्यनारीगणाकीर्णो निवसत्यमरो यथा।\nततः सूर्यस्य भवने चन्द्रस्य भवने तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2106955, "chapter_id": 3321, "verse_number": "१८-६-४९", "content_sanskrit": "शिवस्य भवने राजन्विष्णोर्याति सलोकताम्।\nएवमेतन्महाराज नात्र कार्या विचारणा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2106956, "chapter_id": 3321, "verse_number": "१८-६-५०", "content_sanskrit": "श्रद्दधानेन वै भाव्यमेवमाह गुरुर्मम।\nवाचकस्य तु दातव्यं मनसा यद्यदिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2106957, "chapter_id": 3321, "verse_number": "१८-६-५१", "content_sanskrit": "हस्त्यश्वरथयानानि वाहनानि विशेषतः।\nकटके कुण्डले चैव ब्रह्मसूत्रं तथा परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2106958, "chapter_id": 3321, "verse_number": "१८-६-५२", "content_sanskrit": "वस्त्रं चैव विचित्रं च गन्धं चैव विशेषतः।\nदेववत्पूजयेत्तं तु विष्णुलोकमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2106959, "chapter_id": 3321, "verse_number": "१८-६-५३", "content_sanskrit": "अतः परं प्रवक्ष्यामि यानि देयानि भारते।\nवाच्यमाने तु विप्रेभ्यो राजन्पर्वणिपर्वणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2106960, "chapter_id": 3321, "verse_number": "१८-६-५४", "content_sanskrit": "जातिं देशं च सत्यं च माहात्म्यं भरतर्षभ।\nधर्मं वृत्तिं च विज्ञाय क्षत्रियाणां नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2106961, "chapter_id": 3321, "verse_number": "१८-६-५५", "content_sanskrit": "स्वस्ति वाच्य द्विजानादौ ततः कार्ये प्रवर्तिते।\nसमाप्ते पर्वणि ततः स्वशक्त्या पूजयेद्द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2106962, "chapter_id": 3321, "verse_number": "१८-६-५६", "content_sanskrit": "आदौ तु वाचकं चैव वस्त्रगन्धसमन्वितम्।\nविधिवद्बोजयेद्राजन्मधुपायसमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2106963, "chapter_id": 3321, "verse_number": "१८-६-५७", "content_sanskrit": "ततो मूलफलप्रायं पायसं मधुसर्पिषा।\nआस्तीके भोजयेद्राजन्दद्याच्चैव गुडौदनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2106964, "chapter_id": 3321, "verse_number": "१८-६-५८", "content_sanskrit": "अपूपैश्चैव पूपैश्च मोदकैश्च समन्वितम्।\nसभापर्वणि राजेन्द्र हविष्यं भोजयेद्द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2106965, "chapter_id": 3321, "verse_number": "१८-६-५९", "content_sanskrit": "आरण्यके मूलफलैस्तर्पयेत्तु द्विजोत्तमान्।\nअरणीपर्व चासाद्य जलकुम्भान्प्रदापयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2106966, "chapter_id": 3321, "verse_number": "१८-६-६०", "content_sanskrit": "तर्पणानि च मुख्यानि वन्यमूलफलानि च।\nसर्वकामगुणोपेतं विप्रेभ्योऽन्नं प्रदापयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2106967, "chapter_id": 3321, "verse_number": "१८-६-६१", "content_sanskrit": "विराटपर्वणि तथा वासांसि विविधानि च।\nउद्योगे भरतश्रेष्ठ सर्वकामगुणान्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2106968, "chapter_id": 3321, "verse_number": "१८-६-६२", "content_sanskrit": "भोजनं भोजयेद्विप्रान्गन्धमाल्यैरलङ्कृतान्।\nभीष्मपर्वणि राजेन्द्र दत्त्वा यानमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2106969, "chapter_id": 3321, "verse_number": "१८-६-६३", "content_sanskrit": "ततः सर्वगुणोपेतमन्नं दद्यात्सुसंस्कृतम्।\nद्रोणपर्वणि विप्रेभ्यो भोजनं परमार्चितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2106970, "chapter_id": 3321, "verse_number": "१८-६-६४", "content_sanskrit": "शराश्च देया राजेन्द्र चापान्यसिवरास्तथा।\nकर्णपर्वण्यपि तथा भोजनं सार्वकामिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2106971, "chapter_id": 3321, "verse_number": "१८-६-६५", "content_sanskrit": "विप्रेभ्यः संस्कृतं सम्यग्दद्यात्संयतमानसः।\nशल्यपर्वणि राजेन्द्र मोदकैः सगुडौदनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2106972, "chapter_id": 3321, "verse_number": "१८-६-६६", "content_sanskrit": "अपूपैस्तर्पणैश्चैव सर्वमन्नं प्रदापयेत्।\nगदापर्वण्यपि तथा मुद्गमिश्रं प्रदापयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2106973, "chapter_id": 3321, "verse_number": "१८-६-६७", "content_sanskrit": "स्त्रीपर्वणि तथा रत्नैस्तर्पयेत्तु द्विजोत्तमान्।\nघृतौदनं पुरस्ताच्च ऐषीके दापयेत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2106974, "chapter_id": 3321, "verse_number": "१८-६-६८", "content_sanskrit": "ततः सर्वगुणोपेतमन्नं दद्यात्सुसंस्कृतम्।\nशान्तिपर्वण्यपि तथा हविष्यं भोजयेद्द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2106975, "chapter_id": 3321, "verse_number": "१८-६-६९", "content_sanskrit": "आश्वमेधिकमासाद्य भोजनं सार्वकामिकम्।\nतथाऽऽश्रमनिवासे तु हविष्यं भोजयेद्द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2106976, "chapter_id": 3321, "verse_number": "१८-६-७०", "content_sanskrit": "मौसले सार्वगुणिकं गन्धमाल्यानुलेपनम्।\nमहाप्रास्थानिके तद्वत्सर्वकामगुणान्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2106977, "chapter_id": 3321, "verse_number": "१८-६-७१", "content_sanskrit": "स्वर्गपर्वण्यपि तथा हविष्यं भोजयेद्द्विजान्।\nहरिवंशसमाप्तौ तु सहस्रं भोजयेद्द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2106978, "chapter_id": 3321, "verse_number": "१८-६-७२", "content_sanskrit": "गामेकां निष्कसंयुक्तां ब्राह्मणाय निवेदयेत्।\nतदर्धेनापि दातव्या दरिद्रेणापि पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2106979, "chapter_id": 3321, "verse_number": "१८-६-७३", "content_sanskrit": "प्रतिपर्वसमाप्तौ तु पुस्तकं वै विचक्षणः।\nसुवर्णेन च संयुक्तं वाचकाय निवेदयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2106980, "chapter_id": 3321, "verse_number": "१८-६-७४", "content_sanskrit": "हरिवंशे पर्वणि च पायसं तत्र भोजयेत्।\nपारणेपारणे राजन्यथावद्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2106981, "chapter_id": 3321, "verse_number": "१८-६-७५", "content_sanskrit": "समाप्य सर्वाः प्रयतः संहिताः शास्त्रकोविदः।\nशुभे देशे निवेश्याथ क्षौमवस्त्राभिसंवृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2106982, "chapter_id": 3321, "verse_number": "१८-६-७६", "content_sanskrit": "शुक्लांबरधरः स्रग्वी सुचिर्भूत्वा स्वलङ्कृतः।\nअर्चयेत् यथान्यायं गन्धमाल्यैः पृथक्पृथक्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2106983, "chapter_id": 3321, "verse_number": "१८-६-७७", "content_sanskrit": "संहितापुस्तकान्राजन्प्रयतः सुसमाहितः।\nभक्ष्यैर्माल्यैस्च पेयैश्च कामैश्च विविधैः शुभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2106984, "chapter_id": 3321, "verse_number": "१८-६-७८", "content_sanskrit": "हिरण्यं च सुवर्णं च दक्षिणामथ दापयेत्।\nसर्वत्र त्रिपलं स्वर्णं दातव्यं प्रयतात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2106985, "chapter_id": 3321, "verse_number": "१८-६-७९", "content_sanskrit": "तदर्धं पादशेषं वा वित्तशाठ्यविवर्जितम्।\nयद्यदेवात्मनोऽभीष्टं तत्तद्देयं द्विजातये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2106986, "chapter_id": 3321, "verse_number": "१८-६-८०", "content_sanskrit": "सर्वथा तोषयेद्भक्त्या वाचकं गुरुमात्मनः।\nदेवताः कीर्तयेत्सर्वा नरनारायणौ तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2106987, "chapter_id": 3321, "verse_number": "१८-६-८१", "content_sanskrit": "ततो गन्धैश्च माल्यैश्च स्वलङ्कृत्य द्विजोत्तमान्।\nतर्पयेद्विविधैः कानैर्दानैश्चोच्चावचैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2106988, "chapter_id": 3321, "verse_number": "१८-६-८२", "content_sanskrit": "अतिरात्रस्य यज्ञस्य फलं प्राप्नोति मानवः।\nप्राप्नुयाच्च क्रतुफलं तथा पर्वणिपर्वणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2106989, "chapter_id": 3321, "verse_number": "१८-६-८३", "content_sanskrit": "वाचको भरतश्रेष्ठ व्यक्ताक्षरपदस्वरः।\nभविष्यं श्रावयेद्विद्वाञ्भारतं भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2106990, "chapter_id": 3321, "verse_number": "१८-६-८४", "content_sanskrit": "भुक्तवत्सु द्विजेन्द्रेषु यथावत्सम्प्रदापयेत्।\nवाचकं भरतश्रेष्ठ भोजयित्वा स्वलंकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2106991, "chapter_id": 3321, "verse_number": "१८-६-८५", "content_sanskrit": "वाचके परितुष्टे तु शुभा प्रीतिरनुत्तमा।\nब्राह्मणेषु तु तुष्टेषु प्रसन्नाः सर्वदेवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2106992, "chapter_id": 3321, "verse_number": "१८-६-८६", "content_sanskrit": "ततो हि वरणं कार्यं द्विजानां भरतर्षभ।\nसर्वकामैर्यथान्यायं साधुभिश्च पृथग्विधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2106993, "chapter_id": 3321, "verse_number": "१८-६-८७", "content_sanskrit": "इत्येषि विधिरुद्दिष्टो मया ते द्विपदांवर।\nश्रद्दधानेन वै भाव्यं यन्मां त्वं परिपृच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2106994, "chapter_id": 3321, "verse_number": "१८-६-८८", "content_sanskrit": "भारश्रवणे राजन्पारणे च नृपोत्तम।\nसदा यत्नवता भाव्यं श्रेयस्तु परमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2106995, "chapter_id": 3321, "verse_number": "१८-६-८९", "content_sanskrit": "भारतं शृणुयान्नित्यं भारतं परिकीर्तयेत्।\nभारतं भवने यस्य तस्य हस्तगतो जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2106996, "chapter_id": 3321, "verse_number": "१८-६-९०", "content_sanskrit": "भारतं परमं पुण्यं भारते विविधाः कथाः।\nभारतं सेव्यते देवैर्भारतं परमं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2106997, "chapter_id": 3321, "verse_number": "१८-६-९१", "content_sanskrit": "भारतं सर्वशास्त्राणामुत्तमं भरतर्षभ।\nभारतात्प्राप्यते मोक्षस्तत्त्वमेतद्ब्रवीमि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2106998, "chapter_id": 3321, "verse_number": "१८-६-९२", "content_sanskrit": "महाभारतमाख्यानं क्षितिं गां च सरस्वतीम्।\nब्राह्मणान्केशवं चैव कीर्तयन्नावसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2106999, "chapter_id": 3321, "verse_number": "१८-६-९३", "content_sanskrit": "वेदे रामायणे पुण्ये भारते भरतर्षभ।\nआदौ चान्ते च मध्ये च हरिः सर्वत्र गीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2107000, "chapter_id": 3321, "verse_number": "१८-६-९४", "content_sanskrit": "यत्र विष्णुकथा दिव्याः श्रुतयश्च सनातनाः।\nतच्छ्रोतव्यं मनुष्येण परं पदमिहेच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2107001, "chapter_id": 3321, "verse_number": "१८-६-९५", "content_sanskrit": "एतत्पवित्रं परममेतद्धर्मनिदर्शनम्।\nएतत्सर्वगुणोपेतं श्रोतव्यं भूतिमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2107002, "chapter_id": 3321, "verse_number": "१८-६-९६", "content_sanskrit": "कायिकं वाचिकं चैव मनसा समुपार्जितम्।\nतत्सर्वं नाशमायाति तमः सूर्योदये यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2107003, "chapter_id": 3321, "verse_number": "१८-६-९७", "content_sanskrit": "अष्टादशपुराणानां श्रवणाद्यत्फलं भवेत्।\nतत्फलं समवाप्नोति वैष्णवो नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2107004, "chapter_id": 3321, "verse_number": "१८-६-९८", "content_sanskrit": "स्त्रियश्च पुरुषाश्चैव वैष्णवं पदमाप्नुयुः।\nस्त्रीभिश्च पुत्रकामाभिः श्रोतव्यं वैष्णवं यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2107005, "chapter_id": 3321, "verse_number": "१८-६-९९", "content_sanskrit": "दक्षिणा चात्र देया वै निष्कपञ्चसुवर्णकम्।\nवाचकाय यथाशक्त्या यथोक्तं फलमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2107006, "chapter_id": 3321, "verse_number": "१८-६-१००", "content_sanskrit": "स्वर्णशृङ्गीं च कपिलां सवत्सां वस्त्रसंवृताम्।\nवाचकाय च दद्याद्धि आत्मनः श्रेय इच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2107007, "chapter_id": 3321, "verse_number": "१८-६-१०१", "content_sanskrit": "अलङ्कारं प्रदद्याच्च पाण्योर्वै भरतर्षभ।\nकर्णस्याभरणं दद्याद्धनं चैव विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2107008, "chapter_id": 3321, "verse_number": "१८-६-१०२", "content_sanskrit": "भूमिदानं समादद्याद्वाचकाय नराधिप।\nभूमिदानसमं दानं न भूतं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2107009, "chapter_id": 3321, "verse_number": "१८-६-१०३", "content_sanskrit": "शृणोति श्रावयेद्वाऽपि सततं चैव यो नरः।\nसर्वपापविनिर्मुक्तो वैष्णवं पदमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2107010, "chapter_id": 3321, "verse_number": "१८-६-१०४", "content_sanskrit": "पितॄनुद्धरते सर्वानेकादशसमुद्धवान्।\nआत्मानं ससुतं चैव स्त्रियं च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2107011, "chapter_id": 3321, "verse_number": "१८-६-१०५", "content_sanskrit": "दशांशश्चैव होमोपि कर्तव्योत्र नराधिप।\nइदं मया तवाग्ने च प्रोक्तं सर्वं नरर्षभ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2107012, "chapter_id": 3321, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसाहस्र्यां संहितायां वैयासिक्यां हरिवंशोक्तभारतश्रवणविधावध्यायः॥ स्वर्गारोहणपर्व सम्पूर्णम्॥ १८ ॥ श्रीमन्महाभारतं सम्पूर्णम्॥\n----------\nइदं स्वर्गारोहणपर्व कुम्भघोणस्थेन टी.आर्.कृष्णाचार्येण टी.आर्.व्यासाचार्येण च मुम्बय्यां निर्णयसागरमुद्रायन्त्रे मुद्रापितम्। शकाब्दाः १८३२ सन १९१०. अनेन मुद्रणेन श्रीमद्धनुमद्भीममध्वान्तर्गतरामकृष्णवेदव्यासात्मकलक्ष्मीहयग्रीवः प्रीयताम्।\n-----------\nMahabharata - SwargarohaNa Parva - Chapter Footnotes\n१८-६-१x यद्यप्ययध्यायो दाक्षिणात्यकोशेषु क्वापि न दृश्यते तथापि \"भगवन्नित्यादिः पलाध्यायो व्यासेन हरिवंशान्ते उक्तः अत्र श्रोतृप्ररोचनार्थमुक्त\" इति नीलकण्ठीयव्याख्यानोक्तप्रयोजनायैवास्माभिरपीह स्थापितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}]