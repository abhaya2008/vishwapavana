[{"id": 7006228000, "chapter_id": 26228, "verse_number": "२-५६-१", "content_sanskrit": "जैमिनिरुवाच एतत्ते चरितं सर्वं सगरस्य महात्मनः ।\nसंक्षेपविस्तराभ्यां तु कथितं पापनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006228001, "chapter_id": 26228, "verse_number": "२-५६-२", "content_sanskrit": "खण्डोंऽयं भारतो नाम दक्षिणोत्तरमायतः ।\nनवयोजनसाहस्रं विस्तारपरिमण्डलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006228002, "chapter_id": 26228, "verse_number": "२-५६-३", "content_sanskrit": "पुत्रैस्तस्य नरेद्रस्य मृगयद्भिस्तुरङ्गमम् ।\nयोजनानां सहस्रं तु खात्वाष्टौ विनिपातिताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006228003, "chapter_id": 26228, "verse_number": "२-५६-४", "content_sanskrit": "सागरस्य सुतैर्यस्माद्वर्द्धितो मकरालयः ।\nततः प्रभृति लोकेषु सागराख्यामवाप्तवान् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006228004, "chapter_id": 26228, "verse_number": "२-५६-५", "content_sanskrit": "ब्रह्मपादावधि महीं सतीर्थक्षेत्रकाननाम् ।\nअब्धिः संक्रमयामास परिक्षिप्य निजांभसा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006228005, "chapter_id": 26228, "verse_number": "२-५६-६", "content_sanskrit": "ततस्तन्निलयाः सर्वे सदेवासुरमानवाः ।\nइतस्ततश्च संजाता दुःखेन महतान्विताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006228006, "chapter_id": 26228, "verse_number": "२-५६-७", "content_sanskrit": "गोकर्णं नाम विख्यातं क्षेत्रं सर्वसुरार्चितम् ।\nसार्द्धयोजनविस्तारं तीरे पश्चिम वारिधेः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006228007, "chapter_id": 26228, "verse_number": "२-५६-८", "content_sanskrit": "तत्रासंख्यानि तीर्थानि मुनिदेवालयाश्च वै ।\nवसंति सिद्धसंघाश्च क्षेत्रे तस्मिन्पुरा नृप ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006228008, "chapter_id": 26228, "verse_number": "२-५६-९", "content_sanskrit": "क्षेत्रं तल्लोकविख्यातं सर्वपापहरं शुभम् ।\nतत्तीर्थमब्धेरपतद्भागे दक्षिणपश्चिमे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006228009, "chapter_id": 26228, "verse_number": "२-५६-१०", "content_sanskrit": "यत्र सर्वे तपस्तप्त्वा मुनयः संशितव्रताः ।\nनिर्वाणं परमं प्राप्ताः पुनरावृत्तिवर्जितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006228010, "chapter_id": 26228, "verse_number": "२-५६-११", "content_sanskrit": "तत्त्रेत्रस्य प्रभावेण प्रीत्या भूतगणैः सह ।\nदेव्या च सकलैर्देवैर्नित्यं वसति शङ्करः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006228011, "chapter_id": 26228, "verse_number": "२-५६-१२", "content_sanskrit": "एनांसि यत्समुद्दिश्य तीर्थयात्रां प्रकुर्वताम् ।\nनृणामाशु प्रणश्यन्ति प्रवाते शुष्कपर्णवत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006228012, "chapter_id": 26228, "verse_number": "२-५६-१३", "content_sanskrit": "तत्क्षेत्रसेवनरतिर्नैव जात्वभिजायते ।\nसमीपे वसमानोनामपि पुंसां दुरात्मनाम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006228013, "chapter_id": 26228, "verse_number": "२-५६-१४", "content_sanskrit": "महाता सुकृतेनैव तत्क्षेत्रगमने रतिः ।\nनृणां संजायते राजन्नान्यथा तु कथञ्चन ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006228014, "chapter_id": 26228, "verse_number": "२-५६-१५", "content_sanskrit": "निर्बन्धेन तु ये तस्मिन्प्राणिनः स्थिरजङ्गमाः ।\nम्रियन्ते नृप सद्यस्ते स्वर्गं प्राप्स्यन्ति शाश्वतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006228015, "chapter_id": 26228, "verse_number": "२-५६-१६", "content_sanskrit": "स्मृत्यापि सकलैः पापैर्यस्य मुच्येत मानवः ।\nक्षेत्राणामुत्तमं क्षेत्रं सर्वतीर्थनिकेतनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006228016, "chapter_id": 26228, "verse_number": "२-५६-१७", "content_sanskrit": "स्नात्वा चैतेषु तीर्थेषु यजन्तश्च सदाशिवम् ।\nसिद्धिकामा वसंति स्म मुनयस्तत्र केचन ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006228017, "chapter_id": 26228, "verse_number": "२-५६-१८", "content_sanskrit": "कामक्रोधविनिर्मुक्ता ये तस्मिन्वीतमत्सराः ।\nनिवसंत्यचिरेणैव तत्सिद्धिंप्राप्नुवन्ति हि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006228018, "chapter_id": 26228, "verse_number": "२-५६-१९", "content_sanskrit": "जपहोमरताः शान्ता निपता ब्रह्मचारिणः ।\nवसंति तस्मिन्ये ते हि सिद्धिं प्राप्स्यन्त्यभीप्सिताम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006228019, "chapter_id": 26228, "verse_number": "२-५६-२०", "content_sanskrit": "दानहोमजपाद्यं वै पितृदेवद्विजार्चनम् ।\nअन्यस्मात्कोटिगुणितं भवेत्तस्मिन्फलं नृप ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006228020, "chapter_id": 26228, "verse_number": "२-५६-२१", "content_sanskrit": "अंभोधिसलिले मग्न तस्मिन् क्षेत्रेऽतिपावने ।\nमहता तपसा युक्ता मुनयस्तन्निवासिनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006228021, "chapter_id": 26228, "verse_number": "२-५६-२२", "content_sanskrit": "सह्यं शिखरिणं श्रेष्ठं निलयार्थं समारुहन् ।\nवसंतस्तत्र ते सर्वे संप्रधार्य परस्परम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006228022, "chapter_id": 26228, "verse_number": "२-५६-२३", "content_sanskrit": "सहेन्द्राद्रौ तपस्यन्तं रामं गन्तुं प्रचक्रमुः ।\nराजोवाच ।\nअगस्त्यपीततोयेऽब्धौ परितो राजनन्दनैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006228023, "chapter_id": 26228, "verse_number": "२-५६-२४", "content_sanskrit": "खात्वाधः पातिते क्षेत्रे सतीर्थाश्रमकानने ।\nभूभागेषु तथान्येषु पुरग्रमाकरादिषु ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006228024, "chapter_id": 26228, "verse_number": "२-५६-२५", "content_sanskrit": "विनाशितेषु देशेषु समुद्रोपान्तवर्त्तिषु ।\nकिमकार्षुर्मुनिश्रेष्ठ जनास्तन्निलयास्ततः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006228025, "chapter_id": 26228, "verse_number": "२-५६-२६", "content_sanskrit": "तत्रैव चावसन्कृच्छ्रात्प्रस्थितान्यत्र वा ततः ।\nकियता चैव कालेन संपूर्णोऽभूदपांनिधिः ।\nकेन वापि प्रकारेण ब्रह्मन्नेतद्वदस्व मे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006228026, "chapter_id": 26228, "verse_number": "२-५६-२७", "content_sanskrit": "जैमिनिरुवाच अनूपेषु प्रदेशेषु नाशितेषु दुरात्मभिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006228027, "chapter_id": 26228, "verse_number": "२-५६-२८", "content_sanskrit": "जनास्तन्निलयाः सर्वे संप्रयाता इतस्ततः ।\nतत्रैव चावसन्कृच्छ्रात्केचित्क्षेत्रनिवासिनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006228028, "chapter_id": 26228, "verse_number": "२-५६-२९", "content_sanskrit": "एतस्मिन्नेव काले तु राजन्नंशुमतः सुतः ।\nबभूव भुविधर्मात्मा दिलीप इति विश्रुतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006228029, "chapter_id": 26228, "verse_number": "२-५६-३०", "content_sanskrit": "राज्येऽभिषिच्य तं सम्यग्भुक्तभोगोंऽशुमान्नृपः ।\nवनं जगाम मेधावी तपसे धृतमानसः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006228030, "chapter_id": 26228, "verse_number": "२-५६-३१", "content_sanskrit": "दिलीपस्तु ततःश्रीमानशेषां पृथिवीमिमाम् ।\nपालयामास धर्मेण विजित्य सकलानरीन् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006228031, "chapter_id": 26228, "verse_number": "२-५६-३२", "content_sanskrit": "भगीरथो नाम सुतस्तस्यासील्लोकविश्रुतः ।\nसर्वधर्मार्थकुशलः श्रीमानमितविक्रमः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006228032, "chapter_id": 26228, "verse_number": "२-५६-३३", "content_sanskrit": "राज्येऽभिषिच्य तं राजा दिलीपोऽपि वनं ययौ ।\nस चापि पालयन्नुर्वीं सम्यग्विहतकण्टकाम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006228033, "chapter_id": 26228, "verse_number": "२-५६-३४", "content_sanskrit": "मुमुदे विविधैर्भोगैर्दिवि देवपतिर्यथा ।\nस शुश्रावात्मनः पूर्वं पूर्वजानां महीपतिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006228034, "chapter_id": 26228, "verse_number": "२-५६-३५", "content_sanskrit": "निरये पतनं घोरं विप्रकोपसमुद्भवम् ।\nब्रह्मदण्डहतान्सर्वान्पितञ्छ्रुत्वातिदुःखितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006228035, "chapter_id": 26228, "verse_number": "२-५६-३६", "content_sanskrit": "राज्ये बन्धुषु भोगे वा निर्वेदं परमं ययौ ।\nस मन्त्रिप्रवरे राज्यं विन्यस्य तपसे वनम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006228036, "chapter_id": 26228, "verse_number": "२-५६-३७", "content_sanskrit": "प्रययौ स्वपितॄन्नाकं निनीषुर्नृपसत्तमः ।\nतपसा महाता पूर्वमायुषे कमलोद्भवम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006228037, "chapter_id": 26228, "verse_number": "२-५६-३८", "content_sanskrit": "आराध्य तस्माल्लेभे च यावदायुर्निजेप्सितम् ।\nततो गङ्गां महाराज समाराध्य प्रसाद्य च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006228038, "chapter_id": 26228, "verse_number": "२-५६-३९", "content_sanskrit": "वरमागमनं वव्रे दिवस्तस्या महींप्रति ।\nततस्तां शिरसा धर्त्तु तपसाऽराधयच्छिवम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006228039, "chapter_id": 26228, "verse_number": "२-५६-४०", "content_sanskrit": "स चापि तद्वरं तस्मै प्रददौ भक्तवत्सलः ।\nमेरोर्मूर्ध्नस्ततो गङ्गां पतं ती शिरसात्मनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006228040, "chapter_id": 26228, "verse_number": "२-५६-४१", "content_sanskrit": "सग्राहनक्रमकरां जग्राह जगतां पतिः ।\nसा तच्छिरः समासाद्य महावेगप्रवाहिनी ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006228041, "chapter_id": 26228, "verse_number": "२-५६-४२", "content_sanskrit": "तज्जटामण्डले शुभ्रे विलिल्ये सातिगह्वरे ।\nचुलकोदकवच्छंभोर्विलीनां शिरसि प्रभोः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006228042, "chapter_id": 26228, "verse_number": "२-५६-४३", "content_sanskrit": "विलोक्य तत्प्रमोक्षाय पुनराराधयद्धरम् ।\nस तां शर्वप्रसादेन लब्ध्वा तु भुवमागताम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006228043, "chapter_id": 26228, "verse_number": "२-५६-४४", "content_sanskrit": "आनिन्ये सागरा दग्धा यत्र तां वै दिशं प्रति ।\nसऽनुव्रजन्ती राजानं राजर्षेर्यजतः पथि ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006228044, "chapter_id": 26228, "verse_number": "२-५६-४५", "content_sanskrit": "तद्यज्ञवाटमखिलं प्लावयामास सर्वतः ।\nस तु राजऋषिः क्रुद्धो यज्ञवाटेऽखिले तया ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006228045, "chapter_id": 26228, "verse_number": "२-५६-४६", "content_sanskrit": "मग्ने गण्डूषजलवत्स पपौ तामशेषतः ।\nअतन्द्रितो वर्षशतं शुश्रूषितवा स तं पुनः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006228046, "chapter_id": 26228, "verse_number": "२-५६-४७", "content_sanskrit": "तस्मात्प्रसन्नान्नृपतिर्लेमे गङ्गां महात्मनः ।\nउषित्वा सुचिरं तस्यनिसृता जठराद्यतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006228047, "chapter_id": 26228, "verse_number": "२-५६-४८", "content_sanskrit": "प्रथितं जाह्नवीत्यस्यास्ततो नामाभवद्भुवि ।\nभगीरथानुगा भूत्वा तत्पितॄणामशेषतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006228048, "chapter_id": 26228, "verse_number": "२-५६-४९", "content_sanskrit": "निजांभसास्थिभस्मानि सिषेच सुरनिम्नगा ।\nततस्तदंभसा सिक्तेष्वस्थिभस्मसु तत्क्षणात् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006228049, "chapter_id": 26228, "verse_number": "२-५६-५०", "content_sanskrit": "निरयात्सागराः सर्वे नष्टपापा दिवं ययुः ।\nएवं सा सागरान्सर्वान्दिवं नीत्वा महान्दी ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006228050, "chapter_id": 26228, "verse_number": "२-५६-५१", "content_sanskrit": "तेनैव मार्गेण जवात्प्रयाता पूर्वसागरम् ।\nसेनोर्मूर्ध्नश्चतुर्भेदा भूत्वा याता चतुर्द्दिशम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006228051, "chapter_id": 26228, "verse_number": "२-५६-५२", "content_sanskrit": "चतुर्भेदतया चाभूत्तस्या नाम्नां चतुष्टयम् ।\nसीता चालकनन्दा च सुचक्षुर्भद्रवत्यपि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006228052, "chapter_id": 26228, "verse_number": "२-५६-५३", "content_sanskrit": "अगस्त्यपीतसलिलाच्चिरं शुष्कोदका अपि ।\nगङ्गांभसा पुनः पूर्णाश्चत्वारोऽम्बुधयोऽभवन् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006228053, "chapter_id": 26228, "verse_number": "२-५६-५४", "content_sanskrit": "पूर्वमाणे समुद्रे तु सागरैः परिवर्द्धिते ।\nअन्तर्हिताभवन्देशा बहवस्तत्समीपगाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006228054, "chapter_id": 26228, "verse_number": "२-५६-५५", "content_sanskrit": "समुद्रोपान्तवर्त्तीनि क्षेत्राणि च समन्ततः ।\nइतस्ततः प्रयाताश्च जनास्तन्निलया नृप ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006228055, "chapter_id": 26228, "verse_number": "२-५६-५६", "content_sanskrit": "गोकर्णमिति च क्षेत्रं पूर्वं प्रोक्तं तु यत्तव ।\nअर्मवोपात्तवर्त्तित्वात्समुद्रेऽतर्द्धिमागमत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006228056, "chapter_id": 26228, "verse_number": "२-५६-५७", "content_sanskrit": "ततस्तन्निलयाः सर्वे तदुद्धाराभिकाङ्क्षिणः ।\nसह्याद्रेर्भृगुशार्दूलं द्रष्टुकामा ययुर्नृप ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]