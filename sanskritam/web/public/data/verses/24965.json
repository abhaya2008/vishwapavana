[{"id": 7004965000, "chapter_id": 24965, "verse_number": "७-१-१४८-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि कूपं कुंडलसंभवम् ।\nतस्यैव चोत्तरे भागे ब्रह्मकुण्डसमीपतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004965001, "chapter_id": 24965, "verse_number": "७-१-१४८-२", "content_sanskrit": "यत्र सिद्धो महादेवि रूपकुंडलहारकः ।\nतत्र स्नात्वा नरो देवि मुच्येत्स्तेयकृतादघात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004965002, "chapter_id": 24965, "verse_number": "७-१-१४८-३", "content_sanskrit": "सप्त जन्मानि देवेशि न तस्यान्वयसंभवः ।\nचौरः कश्चिद्भवेत्क्रूरस्तत्र स्नानप्रभावतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004965003, "chapter_id": 24965, "verse_number": "७-१-१४८-४", "content_sanskrit": "शिवरात्र्यां विशेषेण पिंडदानादिकां क्रियाम् ।\nकुर्याच्छस्त्रहतानां च पापिनां तत्र मुक्तये ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004965004, "chapter_id": 24965, "verse_number": "७-१-१४८-५", "content_sanskrit": "देव्युवाच ।\nकथं कुण्डलरूपं तु पृथिव्यां ख्यातिमागतम् ।\nएतत्कथय मे देव विस्तराद्वदतां वर ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004965005, "chapter_id": 24965, "verse_number": "७-१-१४८-६", "content_sanskrit": "ईश्वर उवाच ।\nशृणु देवि महापुण्यां कथां पापप्रणाशनीम् ।\nयां श्रुत्वा मुच्यते पापान्नरो जन्मशतार्जितात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004965006, "chapter_id": 24965, "verse_number": "७-१-१४८-७", "content_sanskrit": "प्रभासक्षेत्रमाहात्म्याच्छिवरात्र्यामुपोषितः ।\nआसीत्सुदर्शनो राजा पृथिव्यामेकराट् सुधीः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004965007, "chapter_id": 24965, "verse_number": "७-१-१४८-८", "content_sanskrit": "धन्यो हि स धनाढ्यश्च प्रजां यत्नैरपालयत् ।\nराज्यं तस्य सुसंपन्नं ब्राह्मणैरुपशोभितम् ।\nसमृद्धमृद्धिसंयुक्तं विटतस्करवर्जितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004965008, "chapter_id": 24965, "verse_number": "७-१-१४८-९", "content_sanskrit": "तस्मिञ्जनपदे रम्ये पुरी भगवती शुभा ।\nचातुर्वर्ण्यसमायुक्ता पुरप्राकारमंडिता ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004965009, "chapter_id": 24965, "verse_number": "७-१-१४८-१०", "content_sanskrit": "तस्मिन्पुरवरे रम्ये राज्यं निहतकण्टकम् ।\nकरोति बान्धवैः सार्द्धमृद्धियुक्तः सुदर्शनः ।\nहिरण्यदत्तस्य सुतो जातो गांधारकन्यया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004965010, "chapter_id": 24965, "verse_number": "७-१-१४८-११", "content_sanskrit": "तस्य भार्या प्रिया साध्वी भर्तृव्रतपरायणा ।\nसुनंदा नामविख्याता काशिराजसुता शुभा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004965011, "chapter_id": 24965, "verse_number": "७-१-१४८-१२", "content_sanskrit": "तया सार्धं हि राजेन्द्रो भोगान्स बुभुजे सदा ।\nभुंजमानस्य भोगान्वै चिरकालो गतस्तदा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004965012, "chapter_id": 24965, "verse_number": "७-१-१४८-१३", "content_sanskrit": "अकरोत्स महायज्ञान्ददौ दानानि भूरिशः ।\nएवं कालो गतस्तस्य भार्यया सह सुव्रते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004965013, "chapter_id": 24965, "verse_number": "७-१-१४८-१४", "content_sanskrit": "कदाचिन्माघमासे तु शिवरात्र्यां वरानने ।\nसस्मार पूर्वजातिं स भार्यामाहूय चाब्रवीत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004965014, "chapter_id": 24965, "verse_number": "७-१-१४८-१५", "content_sanskrit": "सुदर्शन उवाच ।\nशिवरात्रिव्रतं देवि मया कार्यं वरानने ।\nव्रतस्यास्य प्रभावेन प्राप्तं राज्यं मया किल ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004965015, "chapter_id": 24965, "verse_number": "७-१-१४८-१६", "content_sanskrit": "राज्ञ्युवाच ।\nमहान्प्रभावो राजेन्द्र एवमुक्तं त्वया मम ।\nएतन्मे कारणं ब्रूहि आश्चर्यं हृदि वर्तते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004965016, "chapter_id": 24965, "verse_number": "७-१-१४८-१७", "content_sanskrit": "राजोवाच ।\nशृणु तीर्थस्य माहात्म्यं शिवरात्रिमुपोषणात् ।\nतस्मिञ्छिवपुरे रम्ये स्वर्गद्वारे सुशोभने ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004965017, "chapter_id": 24965, "verse_number": "७-१-१४८-१८", "content_sanskrit": "आदितीर्थे प्रभासे तु कामिके तीर्थ उत्तमे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004965018, "chapter_id": 24965, "verse_number": "७-१-१४८-१९", "content_sanskrit": "ऋद्धियुक्ते पुरे तस्मिन्नित्यं धर्मानुसेविते ।\nशिवरात्र्यां गतो राज्ञि तिथीनामुत्तमा तिथिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004965019, "chapter_id": 24965, "verse_number": "७-१-१४८-२०", "content_sanskrit": "मानवास्तत्र ये केचित्पुरराष्ट्रनि वासिनः ।\nतत्रागता वरारोहे शिवरात्र्यामुपोषितुम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004965020, "chapter_id": 24965, "verse_number": "७-१-१४८-२१", "content_sanskrit": "धननामा वणिक्कश्चित्तत्रैव वसते सदा ।\nधनाढ्यः स तु धर्मात्मा सदा धर्मपरायणः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004965021, "chapter_id": 24965, "verse_number": "७-१-१४८-२२", "content_sanskrit": "स भार्यासहितस्तत्र शिवरात्रिमुपोषितः ।\nतस्य भार्याऽभवत्साध्वी रूपयौवनसंवृता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004965022, "chapter_id": 24965, "verse_number": "७-१-१४८-२३", "content_sanskrit": "प्रचलन्मेखलाहारा सर्वाभरणभूषिता ।\nस तया भार्यया सार्धं कामक्रोधविवर्जितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004965023, "chapter_id": 24965, "verse_number": "७-१-१४८-२४", "content_sanskrit": "प्रभासस्याग्रतो भूत्वा स्नातः शुक्लांबरः शुचिः ।\nयथोक्तेन विधानेन भक्त्या निद्राविवर्जितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004965024, "chapter_id": 24965, "verse_number": "७-१-१४८-२५", "content_sanskrit": "तत्राहं चौररूपेण पापः स्तैन्यं समाश्रितः ।\nसच्छूद्राणां कुले जातो देवब्राह्मणपूजकः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004965025, "chapter_id": 24965, "verse_number": "७-१-१४८-२६", "content_sanskrit": "पूर्वकर्मानुसंयोगाद्विकर्मणि रतः सदा ।\nतस्यां रात्र्यामहं तत्र जनमध्ये तु संस्थितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004965026, "chapter_id": 24965, "verse_number": "७-१-१४८-२७", "content_sanskrit": "कुण्डलीनः स्थितस्तत्र रंध्रापेक्षी वरानने ।\nवणिजस्तस्य भार्यायाश्छिद्रान्वेषणतत्परः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004965027, "chapter_id": 24965, "verse_number": "७-१-१४८-२८", "content_sanskrit": "सा रात्रिर्जाग्रतस्तस्य गता मे विजने तथा ।\nगीतनृत्यादिनिर्घोषैर्वेदमंगलपाटकैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004965028, "chapter_id": 24965, "verse_number": "७-१-१४८-२९", "content_sanskrit": "तालशब्दैस्तथा बन्धैः पुस्तकानां च वाचकैः ।\nएवं रात्र्यां तु शेषायां यावत्तिष्ठति तत्र वै ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004965029, "chapter_id": 24965, "verse_number": "७-१-१४८-३०", "content_sanskrit": "निरोधेन समायुक्ता पीड्यमाना शुचिस्मिता ।\nधनिभार्या निरोधार्ता देवागाराद्बहिर्गता ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004965030, "chapter_id": 24965, "verse_number": "७-१-१४८-३१", "content_sanskrit": "तस्याः कर्णौ त्रोटयित्वा पुप्लुवेऽहं जले स्थितः ।\nततः कोलाहलस्तत्र कृतस्तत्पुरवासिभिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004965031, "chapter_id": 24965, "verse_number": "७-१-१४८-३२", "content_sanskrit": "श्रुत्वा कोलाहलं शब्दं कर्णत्रोटनजं तदा ।\nधाविता रक्षकास्तत्र राजशासनकारकाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004965032, "chapter_id": 24965, "verse_number": "७-१-१४८-३३", "content_sanskrit": "तैरहं शस्त्रहस्तैश्च उल्काहस्तैः समंततः ।\nनिरीक्षितोऽथ न प्राप्तं सुवर्णं मन्मुखे स्थितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004965033, "chapter_id": 24965, "verse_number": "७-१-१४८-३४", "content_sanskrit": "खड्गेन तीक्ष्णधारेण छित्त्वा शीर्षं तदा मम ।\nउल्काहस्ता निरीक्षन्तो नापश्यन्स्वर्णमण्वपि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004965034, "chapter_id": 24965, "verse_number": "७-१-१४८-३५", "content_sanskrit": "हित्वा मां ते गताः सर्वे गत्वा राज्ञे न्यवेदयन् ।\nन किञ्चित्तत्र संप्राप्तं हतोऽस्माभिश्च तत्क्षणात् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004965035, "chapter_id": 24965, "verse_number": "७-१-१४८-३६", "content_sanskrit": "कथयित्वा तु ते सर्वे यथादेशं गताः पुनः ।\nततो वै बन्धुना तत्र भयभीतेन चेतसा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004965036, "chapter_id": 24965, "verse_number": "७-१-१४८-३७", "content_sanskrit": "निखातं मम तत्रैव शिरः कायेन संयुतम् ।\nखातं कृत्वा प्रिये तत्र ब्रह्मतीर्थस्य चोत्तरे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004965037, "chapter_id": 24965, "verse_number": "७-१-१४८-३८", "content_sanskrit": "पिहितोऽहं तु तत्रैव प्रभासे तीर्थ उत्तमे ।\nशिवरात्रिप्रभावेन तज्जातिस्मरतां गतः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004965038, "chapter_id": 24965, "verse_number": "७-१-१४८-३९", "content_sanskrit": "राज्यं निष्कण्टकं प्राप्तं समृद्धं वरवर्णिनि ।\nएतत्प्रभासमाहात्म्यं शिवरात्रेरुपोषणात् ।\nएतत्फलं मया लब्धं गत्वा तस्मादुपोषये ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004965039, "chapter_id": 24965, "verse_number": "७-१-१४८-४०", "content_sanskrit": "राज्ञ्युवाच ।\nगच्छावस्तत्र यत्रैव कपालं पतितं तव ।\nस्फोटिते च कपाले च हिरण्यं दृश्यते यदि ।\nप्रत्ययो मे भवेत्पश्चात्तव वाक्यं न संशयः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004965040, "chapter_id": 24965, "verse_number": "७-१-१४८-४१", "content_sanskrit": "राजोवाच ।\nकल्पं हि तिष्ठते चास्थि यावद्भूमिविपर्ययः ।\nउत्तिष्ठ व्रज भद्रं ते प्रभासं क्षेत्रमुत्तमम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004965041, "chapter_id": 24965, "verse_number": "७-१-१४८-४२", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा यद्राज्ञा समुदीरितम् ।\nगमनाय मतिं चक्रे शिवरात्र्या उपोषणे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004965042, "chapter_id": 24965, "verse_number": "७-१-१४८-४३", "content_sanskrit": "ततोऽश्वैर्जवनैयुर्क्तं रथं हेमविभूषितम् ।\nआस्थाय सह पत्न्या च प्रभासं क्षेत्रमेयिवान् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004965043, "chapter_id": 24965, "verse_number": "७-१-१४८-४४", "content_sanskrit": "व्रतं कृत्वा प्रभासे तु यथोक्तं वरवर्णिनि ।\nब्रह्मतीर्थे समागत्य उद्धृत्य सकलं ततः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004965044, "chapter_id": 24965, "verse_number": "७-१-१४८-४५", "content_sanskrit": "हिरण्यं दर्शयामास स्फोटयित्वा शवं स्वयम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004965045, "chapter_id": 24965, "verse_number": "७-१-१४८-४६", "content_sanskrit": "ईश्वर उवाच ।\nजातसंप्रत्यया भार्या तस्य राज्ञो बभूव ह ।\nजगाम परमं स्थानं यत्र कल्याणमुत्तमम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004965046, "chapter_id": 24965, "verse_number": "७-१-१४८-४७", "content_sanskrit": "जनोऽपि विस्मितः सर्वो दृष्ट्वा चित्रं तदद्भुतम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004965047, "chapter_id": 24965, "verse_number": "७-१-१४८-४८", "content_sanskrit": "नदी चित्रपथानाम तत्रोत्पन्ना वरानने ।\nचित्रादित्यस्य पूर्वेण ब्रह्मतीर्थस्य चोत्तरे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004965048, "chapter_id": 24965, "verse_number": "७-१-१४८-४९", "content_sanskrit": "तस्यां तत्तिष्ठते तत्र सर्वपापप्रणाशनम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004965049, "chapter_id": 24965, "verse_number": "७-१-१४८-५०", "content_sanskrit": "श्रावणे मासि संप्राप्ते तस्मिन्कूपे विधानतः ।\nयः स्नानं कुरुते देवि श्राद्धं तत्र विशेषतः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004965050, "chapter_id": 24965, "verse_number": "७-१-१४८-५१", "content_sanskrit": "चित्रादित्यं तु संपूज्य शिवलोके महीयते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004965051, "chapter_id": 24965, "verse_number": "७-१-१४८-५२", "content_sanskrit": "एतत्ते कथितं सर्वं शिवरात्र्या महत्फलम् ।\nभुक्तिमुक्तिप्रदं पुण्यं सर्वपापप्रणाशनम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004965052, "chapter_id": 24965, "verse_number": "७-१-१४८-५३", "content_sanskrit": "य इदं पठते नित्यं शृणुयाद्वापि मानवः ।\nसर्वपापविनिर्मुक्तो रुद्रलोके महीयते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]