[{"id": 7000612000, "chapter_id": 20612, "verse_number": "५-७१-१", "content_sanskrit": "श्रीदेव्युवाच ।\nभगवन्सर्वभूतेश सर्वात्मन्सर्वसंभव ।\nदेवेश्वर महादेव सर्वज्ञ करुणाकर॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000612001, "chapter_id": 20612, "verse_number": "५-७१-२", "content_sanskrit": "त्वयानुकंपितैवाहं भूयोऽप्याहानुकंपया ।\nत्रैलोक्यमोहना मंत्रास्त्वया मे कथिताः प्रभो॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000612002, "chapter_id": 20612, "verse_number": "५-७१-३", "content_sanskrit": "तेन देवेन गोपीभिर्महामोहनरूपिणा ।\nकेन केन विशेषण चिक्रीडे तद्वदस्व मे॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000612003, "chapter_id": 20612, "verse_number": "५-७१-४", "content_sanskrit": "महादेव उवाच ।\nएकदा वादयन्वीणां नारदो मुनिपुंगवः ।\nकृष्णावतारमाज्ञाय प्रययौ नंदगोकुलम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000612004, "chapter_id": 20612, "verse_number": "५-७१-५", "content_sanskrit": "गत्वा तत्र महायोगमयेशं विभुमच्युतम् ।\nबालनाट्यधरं देवदर्शनं नंदवेश्मनि॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000612005, "chapter_id": 20612, "verse_number": "५-७१-६", "content_sanskrit": "सुकोमलपटास्तीर्णहेमपर्यंकिकोपरि ।\nशयानं गोपकन्याभिः प्रेक्षमाणं सदा मुदम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000612006, "chapter_id": 20612, "verse_number": "५-७१-७", "content_sanskrit": "अतीव सुकुमारांगं मुग्धं मुग्धविलोकनम् ।\nविस्रस्तनीलकुटिलकुंतलावनिमंडलम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000612007, "chapter_id": 20612, "verse_number": "५-७१-८", "content_sanskrit": "किंचित्स्मितांकुरव्यंजदेकद्विरदकुड्मलम् ।\nस्वप्रभाभिर्भासयंतं समंताद्भवनोदरम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000612008, "chapter_id": 20612, "verse_number": "५-७१-९", "content_sanskrit": "दिग्वाससं समालोक्य सोऽतिहर्षमवाप ह ।\nसंभाष्य गोपतिं नंदमाह सर्वप्रभुप्रियः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000612009, "chapter_id": 20612, "verse_number": "५-७१-१०", "content_sanskrit": "नारायणपराणां तु जीवनं ह्यतिदुर्लभम् ।\nअस्य प्रभावमतुलं न जानंतीह केचन॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000612010, "chapter_id": 20612, "verse_number": "५-७१-११", "content_sanskrit": "भव ब्रह्मादयोऽप्यस्मिन्रतिं वांच्छन्ति शाश्वतीम् ।\nचरितं चास्य बालस्य सर्वेषामेव हर्षणम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000612011, "chapter_id": 20612, "verse_number": "५-७१-१२", "content_sanskrit": "मुदा गायंति शृण्वंति चाभिनंदंति तादृशाः ।\nअस्मिंस्तव सुतेऽचिंत्यप्रभावे स्निग्धमानसाः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000612012, "chapter_id": 20612, "verse_number": "५-७१-१३", "content_sanskrit": "नराः संति न तेषां वै भवबाधा भविष्यति ।\nमुंचेह परलोकेच्छाः सर्वा बल्लवसत्तम॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000612013, "chapter_id": 20612, "verse_number": "५-७१-१४", "content_sanskrit": "एकांतेनैकभावेन बालेऽस्मिन्प्रीतिमाचर ।\nइत्युक्त्वा नंदभवनान्निष्क्रांतो मुनिपुंगवः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000612014, "chapter_id": 20612, "verse_number": "५-७१-१५", "content_sanskrit": "तेनार्चितो विष्णुबुद्ध्या प्रणम्य च विसर्जितः ।\nअथासौ चिंतयामास महाभागवतो मुनिः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000612015, "chapter_id": 20612, "verse_number": "५-७१-१६", "content_sanskrit": "अस्य कांता भगवती लक्ष्मीर्नारायणे हरौ ।\nविधाय गोपिकारूपं क्रीडार्थं शार्ङ्गधन्वनः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000612016, "chapter_id": 20612, "verse_number": "५-७१-१७", "content_sanskrit": "अवश्यमवतीर्णा सा भविष्यति न संशयः ।\nतामहं विचिनोम्यद्य गेहेगेहे व्रजौकसाम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000612017, "chapter_id": 20612, "verse_number": "५-७१-१८", "content_sanskrit": "विमृश्यैवं मुनिवरो गेहानि व्रजवासिनाम् ।\nप्रविवेशातिथिर्भूत्वा विष्णुबुद्ध्या सुपूजितः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000612018, "chapter_id": 20612, "verse_number": "५-७१-१९", "content_sanskrit": "सर्वेषां बल्लवादीनां रतिं नंदसुते पराम् ।\nदृष्ट्वा मुनिवरः सर्वान्मनसा प्रणनाम ह॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000612019, "chapter_id": 20612, "verse_number": "५-७१-२०", "content_sanskrit": "गोपालानां गृहे बालां ददर्श श्वेतरूपिणीम् ।\nस दृष्ट्वा तर्कयामास रमा ह्येषा न संशयः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000612020, "chapter_id": 20612, "verse_number": "५-७१-२१", "content_sanskrit": "प्रविवेश ततो धीमान्नंदसख्युर्महात्मनः ।\nकस्यचिद्गोपवर्य्यस्य भानुनाम्नो गृहं महत्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000612021, "chapter_id": 20612, "verse_number": "५-७१-२२", "content_sanskrit": "अर्चितो विधिवत्तेन सोऽप्यपृच्छन्महामनाः ।\nसाधो त्वमसि विख्यातो धर्मनिष्ठतया भुवि॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000612022, "chapter_id": 20612, "verse_number": "५-७१-२३", "content_sanskrit": "तवाहं धनधान्यादि समृद्धिं संविभावये ।\nकच्चित्ते योग्यः पुत्रोऽस्ति कन्या वा शुभलक्षणा॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000612023, "chapter_id": 20612, "verse_number": "५-७१-२४", "content_sanskrit": "यतस्ते कीर्तिरखिलं लोकं व्याप्य भविष्यति ।\nइत्युक्तो मुनिवर्य्येण भानुरानीय पुत्रकम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000612024, "chapter_id": 20612, "verse_number": "५-७१-२५", "content_sanskrit": "महातेजस्विनं दृप्तं नारदायाभ्यवादयत् ।\nदृष्ट्वा मुनिवरस्तं तु रूपेणाप्रतिमं भुवि॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000612025, "chapter_id": 20612, "verse_number": "५-७१-२६", "content_sanskrit": "पद्मपत्रविशालाक्षं सुग्रीवं सुंदरभ्रुवम् ।\nचारुदंतं चारुकर्णं सर्वावयवसुंदरम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000612026, "chapter_id": 20612, "verse_number": "५-७१-२७", "content_sanskrit": "तं समाश्लिष्य बाहुभ्यां स्नेहाश्रूणि विमुच्य च ।\nततः स गद्गद प्राह प्रणयेन महामुनिः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000612027, "chapter_id": 20612, "verse_number": "५-७१-२८", "content_sanskrit": "नारद उवाच ।\nअयं शिशुस्ते भविता सुसखा रामकृष्णयोः ।\nविहरिष्यति ताभ्यां च रात्रिंदिवमतंद्रितः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000612028, "chapter_id": 20612, "verse_number": "५-७१-२९", "content_sanskrit": "तत आभाष्य तं गोपप्रवरं मुनिपुंगवः ।\nयदा गंतुं मनश्चक्रे तत्रैवं भानुरब्रवीत्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000612029, "chapter_id": 20612, "verse_number": "५-७१-३०", "content_sanskrit": "एकास्ति पुत्रिका देव देवपत्न्युपमा मम ।\nकनीयसी शिशोरस्य जडांधबधिराकृतिः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000612030, "chapter_id": 20612, "verse_number": "५-७१-३१", "content_sanskrit": "उत्साहाद्वृद्धये याचे त्वां वरं भगवत्तम ।\nप्रसन्नदृष्टिमात्रेण सुस्थिरां कुरु बालिकाम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000612031, "chapter_id": 20612, "verse_number": "५-७१-३२", "content_sanskrit": "श्रुत्वैवं नारदो वाक्यं कौतुकाकृष्टमानसः ।\nअथ प्रविश्य भवनं लुठंतीं भूतले सुताम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000612032, "chapter_id": 20612, "verse_number": "५-७१-३३", "content_sanskrit": "उत्थाप्यांके निधायातिस्नेहविह्वलमानसः ।\nभानुरप्याययौ भक्तिनम्रो मुनिवरांतिकम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000612033, "chapter_id": 20612, "verse_number": "५-७१-३४", "content_sanskrit": "अथ भागवतश्रेष्ठः कृष्णस्यातिप्रियो मुनिः ।\nदृष्ट्वा तस्याः परं रूपमदृष्टाश्रुतमद्भुतम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000612034, "chapter_id": 20612, "verse_number": "५-७१-३५", "content_sanskrit": "अभूत्पूर्वसमं मुग्धो हरिप्रेमा महामुनिः ।\nविगाह्य परमानंदसिंधुमेकरसायनम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000612035, "chapter_id": 20612, "verse_number": "५-७१-३६", "content_sanskrit": "मुहूर्त्तद्वितयं तत्र मुनिरासीच्छिलोपमः ।\nमुनींद्रः प्रतिबुद्धस्तु शनैरुन्मील्य लोचने॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000612036, "chapter_id": 20612, "verse_number": "५-७१-३७", "content_sanskrit": "महाविस्मयमापन्नस्तूष्णीमेव स्थितोऽभवत् ।\nअंतर्हृदि महाबुद्धिरेवमेवं व्यचिंतयत्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000612037, "chapter_id": 20612, "verse_number": "५-७१-३८", "content_sanskrit": "भ्रांतं सर्वेषु लोकेषु मया स्वच्छंदचारिणा ।\nअस्या रूपेण सदृशी दृष्ट्वा नैव च कुत्रचित्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000612038, "chapter_id": 20612, "verse_number": "५-७१-३९", "content_sanskrit": "ब्रह्मलोके रुद्रलोक इंद्रलोके च मे गतिः ।\nन कोपि शोभाकोट्यंशः कुत्राप्यस्या विलोकितः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000612039, "chapter_id": 20612, "verse_number": "५-७१-४०", "content_sanskrit": "महामाया भगवती दृष्टा शैलेंद्रनंदिनी ।\nयस्या रूपेण सकलं मुह्यते सचराचरम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000612040, "chapter_id": 20612, "verse_number": "५-७१-४१", "content_sanskrit": "साप्यस्याः सुकुमारांगी लक्ष्मीं नाप्नोति कर्हिचित् ।\nलक्ष्मीः सरस्वती कांति विद्याद्याश्च वरस्त्रियः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000612041, "chapter_id": 20612, "verse_number": "५-७१-४२", "content_sanskrit": "छायामपि स्पृशंत्यस्याः कदाचिन्नैव दृश्यते ।\nविष्णोर्यन्मोहिनीरूपं हरो येन विमोहितः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000612042, "chapter_id": 20612, "verse_number": "५-७१-४३", "content_sanskrit": "मया दृष्टं च तदपि कुतोऽस्यासदृशं भवेत् ।\nततोऽस्यास्तत्त्वमाज्ञातुं न मे शक्तिः कथंचन॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000612043, "chapter_id": 20612, "verse_number": "५-७१-४४", "content_sanskrit": "अन्ये चापि न जानंति प्रायेणैनां हरेः प्रियाम् ।\nअस्याः संदर्शनादेव गोविंदचरणांबुजे॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000612044, "chapter_id": 20612, "verse_number": "५-७१-४५", "content_sanskrit": "या प्रेमर्द्धिरभूत्सा मे भूतपूर्वा न कर्हिचित् ।\nएकांते नौमि भवतीं दर्शयित्वातिवैभवम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000612045, "chapter_id": 20612, "verse_number": "५-७१-४६", "content_sanskrit": "कृष्णस्य संभवत्यस्या रूपं परमतुष्टये ।\nविमृश्यैवं मुनिर्गोपप्रवरं प्रेष्य कुत्रचित्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000612046, "chapter_id": 20612, "verse_number": "५-७१-४७", "content_sanskrit": "निभृते परितुष्टाव बालिकां दिव्यरूपिणीम् ।\nअपि देवि महायोगमायेश्वरि महाप्रभे॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000612047, "chapter_id": 20612, "verse_number": "५-७१-४८", "content_sanskrit": "महामोहनदिव्यांगि महामाधुर्यवर्षिणि ।\nमहाद्भुतरसानंदशिथिलीकृतमानसे॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000612048, "chapter_id": 20612, "verse_number": "५-७१-४९", "content_sanskrit": "महाभाग्येन केनापि गतासि मम दृक्पथम् ।\nनित्यमंतर्मुखादृष्टिस्तव देवि विभाव्यते॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000612049, "chapter_id": 20612, "verse_number": "५-७१-५०", "content_sanskrit": "अंतरेव महानंदपरितृप्तैव लक्ष्यसे ।\nप्रसन्नं मधुरं सौम्यमिदं सुमुखमंडनम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000612050, "chapter_id": 20612, "verse_number": "५-७१-५१", "content_sanskrit": "व्यनक्तिपरमाश्चर्यं कमप्यंतः सुखोदयम् ।\nरजः संबंधिकलिका शक्तिस्तत्वातिशोभने॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000612051, "chapter_id": 20612, "verse_number": "५-७१-५२", "content_sanskrit": "सृष्टिस्थितिसमाहाररूपिणी त्वमधिष्ठिता ।\nतत्त्वं विशुद्धसत्वाशु शक्तिर्विद्यात्मिका परा॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000612052, "chapter_id": 20612, "verse_number": "५-७१-५३", "content_sanskrit": "परमानंदसंदोहं दधती वैष्णवं परम् ।\nका त्वयाश्चर्यविभवे ब्रह्मरुद्रादिदुर्गमे॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000612053, "chapter_id": 20612, "verse_number": "५-७१-५४", "content_sanskrit": "योगींद्राणां ध्यानपथं न त्वं स्पृशसि कर्हिचित् ।\nइच्छाशक्तिर्ज्ञानशक्तिः क्रियाशक्तिस्तवेशितुः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000612054, "chapter_id": 20612, "verse_number": "५-७१-५५", "content_sanskrit": "तवांशमात्रमित्येवं मनीषा मे प्रवर्त्तते ।\nमायाविभूतयोऽचिंत्यास्तन्मायार्भकमायिनः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000612055, "chapter_id": 20612, "verse_number": "५-७१-५६", "content_sanskrit": "परेशस्य महाविष्णोस्ताः सर्वास्ते कलाकलाः ।\nआनंदरूपिणी शक्तिस्त्वमीश्वरि न संशयः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000612056, "chapter_id": 20612, "verse_number": "५-७१-५७", "content_sanskrit": "त्वया च क्रीडते कृष्णो नूनं वृंदावने वने ।\nकौमारेणैव रूपेण त्वं विश्वस्य च मोहिनी॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000612057, "chapter_id": 20612, "verse_number": "५-७१-५८", "content_sanskrit": "तारुण्यवयसा स्पृष्टं कीदृक्ते रूपमद्भुतम् ।\nकीदृशं तव लावण्यं लीलाहासेक्षणान्वितम्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000612058, "chapter_id": 20612, "verse_number": "५-७१-५९", "content_sanskrit": "हरि मानुषलोभेन वपुराश्चर्यमंडितम् ।\nद्रष्टुं तदहमिच्छामि रूपं ते हरिवल्लभे॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000612059, "chapter_id": 20612, "verse_number": "५-७१-६०", "content_sanskrit": "येन नंदसुतः कृष्णो मोहं समुपयास्यति ।\nइदानीं मम कारुण्यान्निजं रूपं महेश्वरि॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000612060, "chapter_id": 20612, "verse_number": "५-७१-६१", "content_sanskrit": "प्रणताय प्रपन्नाय प्रकाशयितुमर्हसि ।\nइत्युक्ता मुनिवर्य्येण तदनुव्रतचेतसा॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000612061, "chapter_id": 20612, "verse_number": "५-७१-६२", "content_sanskrit": "महामाहेश्वरीं नत्वा महानंदमयीं पराम् ।\nमहाप्रेमतरोत्कंठा व्याकुलांगीं शुभेक्षणाम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000612062, "chapter_id": 20612, "verse_number": "५-७१-६३", "content_sanskrit": "ईक्षमाणेन गोविंदमेवं वर्णयतास्थितम् ।\nजयकृष्ण मनोहारिञ्जय वृंदावनप्रिय॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000612063, "chapter_id": 20612, "verse_number": "५-७१-६४", "content_sanskrit": "जयभ्रूभंगललित जयवेणुरवाकुल ।\nजय बर्हकृतोत्तंस जयगोपीविमोहन॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000612064, "chapter_id": 20612, "verse_number": "५-७१-६५", "content_sanskrit": "जय कुंकुमलिप्तांग जय रत्नविभूषण ।\nकदाहं त्वत्प्रसादेन अनया दिव्यरूपया॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000612065, "chapter_id": 20612, "verse_number": "५-७१-६६", "content_sanskrit": "सहितं नवतारुण्य मनोहारि वपुःश्रिया ।\nविलोकयिष्ये कैशोरे मोहनं त्वां जगत्पते॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000612066, "chapter_id": 20612, "verse_number": "५-७१-६७", "content_sanskrit": "एवं कीर्त्तयतस्तस्य तत्क्षणादेव सा पुनः ।\nबभूव दधती दिव्यं रूपमत्यंतमोहनम्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000612067, "chapter_id": 20612, "verse_number": "५-७१-६८", "content_sanskrit": "चतुर्दशाब्दवयसा संमितं ललितं परम् ।\nसमानवयसश्चान्यास्तदैव व्रजबालिकाः॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000612068, "chapter_id": 20612, "verse_number": "५-७१-६९", "content_sanskrit": "आगत्य वेष्टयामासुर्दिव्यभूषांबरस्रजः ।\nमुनींद्रः स तु निश्चेष्टो बभूवाश्चर्यमोहितः॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000612069, "chapter_id": 20612, "verse_number": "५-७१-७०", "content_sanskrit": "बालायास्तास्तदा सख्यश्चरणांबुकणैर्मुनिम् ।\nनिषिच्य बोधयामासुरूचुश्च कृपयान्विताः॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000612070, "chapter_id": 20612, "verse_number": "५-७१-७१", "content_sanskrit": "मुनिवर्य महाभाग महायोगेश्वरेश्वर ।\nत्वयैव परया भक्त्या भगवान्हरिरीश्वरः॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000612071, "chapter_id": 20612, "verse_number": "५-७१-७२", "content_sanskrit": "नूनमाराधितो देवो भक्तानां कामपूरकः ।\nयदियंब्रह्मरुद्राद्यैर्देवैः सिद्धमुनीश्वरैः॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000612072, "chapter_id": 20612, "verse_number": "५-७१-७३", "content_sanskrit": "महाभागवतैश्चान्यैर्दुर्दर्शा दुर्गमापि च ।\nअत्यद्भुतवयोरूपमोहिनी हरिवल्लभा॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000612073, "chapter_id": 20612, "verse_number": "५-७१-७४", "content_sanskrit": "केनाप्यचिंत्य भाग्येन तवदृष्टिपथं गता ।\nउत्तिष्ठोत्तिष्ठ विप्रर्षे धैर्यमालंब्य सत्वरम्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000612074, "chapter_id": 20612, "verse_number": "५-७१-७५", "content_sanskrit": "एनां प्रदक्षिणीकृत्य नमस्कुरु पुनःपुनः ।\nकिं न पश्यसि चार्वंगीमत्यंतव्याकुलामिव॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000612075, "chapter_id": 20612, "verse_number": "५-७१-७६", "content_sanskrit": "अस्मिन्नेव क्षणे नूनमंतर्धानं गमिष्यति ।\nनानया सह संलापः कथंचित्ते भविष्यति॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000612076, "chapter_id": 20612, "verse_number": "५-७१-७७", "content_sanskrit": "दर्शनं च पुनर्नास्याः प्राप्स्यसि ब्रह्मवित्तम ।\nकिंतु वृंदावने कापि भात्यशोकलता शुभा॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000612077, "chapter_id": 20612, "verse_number": "५-७१-७८", "content_sanskrit": "सर्वकालेऽपि पुष्पाढ्या सर्वदिग्व्यापि सौरभा ।\nगोवर्द्धनाददूरेण कुसुमाख्यसरस्तटे॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000612078, "chapter_id": 20612, "verse_number": "५-७१-७९", "content_sanskrit": "तन्मूले ह्यर्द्धरात्रे च द्रक्ष्यस्यस्मानशेषतः ।\nश्रुत्वैवं वचनं तासां स्नेहविह्वलचेतसाम्॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000612079, "chapter_id": 20612, "verse_number": "५-७१-८०", "content_sanskrit": "यावत्प्रदक्षिणीकृत्य प्रणमेद्दंडवन्मुनिः ।\nमुहूर्त्तद्वितयं बालां नानानिर्माणशोभनाम्॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000612080, "chapter_id": 20612, "verse_number": "५-७१-८१", "content_sanskrit": "आहूय भानुं प्रोवाच नारदः सर्वशोभनाम् ।\nएवं प्रभावा बालेयं न साध्या दैवतैरपि॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000612081, "chapter_id": 20612, "verse_number": "५-७१-८२", "content_sanskrit": "किंतु यद्गृहमेतस्याः पदचिह्नविभूषितम् ।\nतत्र नारायणो देवः स्वयं वसति माधवः॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000612082, "chapter_id": 20612, "verse_number": "५-७१-८३", "content_sanskrit": "लक्ष्मीश्च वसते नित्यं सर्वाभिः सर्वसिद्धिभिः ।\nअद्य एनां वरारोहां सर्वाभरणभूषणाम्॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000612083, "chapter_id": 20612, "verse_number": "५-७१-८४", "content_sanskrit": "देवीमिव परां गेहे रक्ष यत्नेन सत्तम ।\nइत्युक्त्वा मनसैवैनां महाभागवतोत्तमः॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000612084, "chapter_id": 20612, "verse_number": "५-७१-८५", "content_sanskrit": "तद्रूपमेव संस्मृत्य प्रविष्टो गहनं वनम् ।\nअशोकलतिकामूलमासाद्य मुनिसत्तमः॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000612085, "chapter_id": 20612, "verse_number": "५-७१-८६", "content_sanskrit": "प्रतीक्षमाणो देवीं तां तत्रैवागमनं निशि ।\nस्थितोऽत्र प्रेमविकलश्चिंतयन्कृष्णवल्लभाम्॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000612086, "chapter_id": 20612, "verse_number": "५-७१-८७", "content_sanskrit": "अथ मध्यनिशाभागे युवत्यः परमाद्भुताः ।\nपूर्वं दृष्ट्वास्तथान्याश्च विचित्राभरणस्रजः॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000612087, "chapter_id": 20612, "verse_number": "५-७१-८८", "content_sanskrit": "दृष्ट्वा मनसि संभ्रांतो दंडवत्पतितो भुवि ।\nपरिवार्य मुनिं सर्वास्ताः प्रविविशुः शुभाः॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000612088, "chapter_id": 20612, "verse_number": "५-७१-८९", "content_sanskrit": "प्रष्टुकामोऽपि स मुनिः किंचित्स्वाभिमतं प्रियम् ।\nनाशकत्प्रेमलावण्यप्रियभाषाप्रधर्षितः॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000612089, "chapter_id": 20612, "verse_number": "५-७१-९०", "content_sanskrit": "अथागता मुनिश्रेष्ठं कृतांजलिमवस्थितम् ।\nभक्तिभारानतग्रीवं सविस्मयं ससंभ्रमम्॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000612090, "chapter_id": 20612, "verse_number": "५-७१-९१", "content_sanskrit": "सुविनीततमं प्राह तत्रैव करुणान्विता ।\nअशोकमालिनी नाम्ना अशोकवनदेवता॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000612091, "chapter_id": 20612, "verse_number": "५-७१-९२", "content_sanskrit": "अशोकमालिन्युवाच ।\nअशोककलिकायां तु वसाम्यस्यां महामुने ।\nरक्तांबरधरा नित्यं रक्तमालानुलेपना॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000612092, "chapter_id": 20612, "verse_number": "५-७१-९३", "content_sanskrit": "रक्तसिंदूरकलिका रक्तोत्पलवतंसिनी ।\nरक्तमाणिक्यकेयूर मुकुटादिविभूषिता॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000612093, "chapter_id": 20612, "verse_number": "५-७१-९४", "content_sanskrit": "एकदा प्रियया सार्द्धं विहरंत्यो मधूत्सवे ।\nतत्रैव मिलिता गोपबालिकाश्चित्रवाससः॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000612094, "chapter_id": 20612, "verse_number": "५-७१-९५", "content_sanskrit": "अहं चाशोकमालाभिर्गोपवेषधरं हरिम् ।\nरमारूपाश्च ताः सर्वा भक्त्या सम्यगपूजयम्॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000612095, "chapter_id": 20612, "verse_number": "५-७१-९६", "content_sanskrit": "ततः प्रभृति चैतासां मध्ये तिष्ठामि सर्वदा ।\nभूषाभिर्विविधाभिश्च तोषयित्वा रमापतिम्॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000612096, "chapter_id": 20612, "verse_number": "५-७१-९७", "content_sanskrit": "परात्परमहं सर्वं विजानामीह सर्वतः ।\nगोगोपगोपिकादीनां रहस्यं चापि वेद्म्यहम्॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000612097, "chapter_id": 20612, "verse_number": "५-७१-९८", "content_sanskrit": "तव जिज्ञासितं सर्वं हृदि प्रत्यभिभाषितम् ।\nतां देवीमद्भुताकारामद्भुतानंददायिनीम्॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000612098, "chapter_id": 20612, "verse_number": "५-७१-९९", "content_sanskrit": "हरेः प्रियां हिरण्याभां हीरकोज्ज्वलमुद्रिकाम् ।\nकथं पश्यामि लोलाक्षीं कथं वा तत्पदांबुजम्॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000612099, "chapter_id": 20612, "verse_number": "५-७१-१००", "content_sanskrit": "आराध्यतेऽतिभक्त्येति त्वया ब्रह्मन्विमर्शितम् ।\nतत्र ते कथयिष्यामि वृत्तांतं सुमहात्मनाम्॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000612100, "chapter_id": 20612, "verse_number": "५-७१-१०१", "content_sanskrit": "मानसे सरसि स्थित्वा तपस्तीव्रमुपेयुषाम् ।\nजपतां सिद्धमंत्रांश्च ध्यायतां हरिमीश्वरम्॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000612101, "chapter_id": 20612, "verse_number": "५-७१-१०२", "content_sanskrit": "मुनीनां कांक्षतां नित्यं तस्या एव पदांबुजम् ।\nएकसप्ततिसाहस्रं संख्यातानां महौजसाम्॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000612102, "chapter_id": 20612, "verse_number": "५-७१-१०३", "content_sanskrit": "तत्तेऽहं कथयाम्यद्य तद्रहस्यं परं वने॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}]