[{"id": 7000464000, "chapter_id": 20464, "verse_number": "३-११-१", "content_sanskrit": "वसिष्ठ उवाच ।\nअनेन तव धर्मज्ञ प्रश्रयेण दमेन च ।\nसत्येन च महाभाग तुष्टोस्मि तव सर्वशः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000464001, "chapter_id": 20464, "verse_number": "३-११-२", "content_sanskrit": "यस्येदृशस्ते धर्मोयं पितरस्तारितास्त्वया ।\nतेन पश्यसि मां पुत्र याज्यश्चासि ममानघ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000464002, "chapter_id": 20464, "verse_number": "३-११-३", "content_sanskrit": "प्रीतिर्मे वर्द्धते तेऽद्य ब्रूहि किं करवाणि ते ।\nयद्वक्ष्यसि नरश्रेष्ठ तस्य दातास्मि तेनघ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000464003, "chapter_id": 20464, "verse_number": "३-११-४", "content_sanskrit": "दिलीप उवाच ।\nवेदवेदांगतत्त्वज्ञ सर्वलोकाभिपूजित ।\nकृतमित्येव मन्ये हि यदहं दृष्टवान्प्रभुम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000464004, "chapter_id": 20464, "verse_number": "३-११-५", "content_sanskrit": "यदि त्वहमनुग्राह्यस्तव धर्म्मभृतां वर ।\nप्रक्ष्यामि हृत्स्थं संदेहं तन्मे त्वं वक्तुमर्हसि॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000464005, "chapter_id": 20464, "verse_number": "३-११-६", "content_sanskrit": "अस्ति मे भगवन्कश्चित्तीर्थे यो धर्मसंशयः ।\nतदहं श्रोतुमिच्छामि पृथक्संकीर्तनं त्वया॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000464006, "chapter_id": 20464, "verse_number": "३-११-७", "content_sanskrit": "प्रदक्षिणां यः पृथिवीं करोति द्विजसत्तम ।\nकिं फलं तस्य विप्रर्षे तन्मे ब्रूहि तपोधन॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000464007, "chapter_id": 20464, "verse_number": "३-११-८", "content_sanskrit": "वसिष्ठ उवाच ।\nकथयिष्यामि तदहमृषीणां मत्परायणम् ।\nतदेकाग्रमनास्तात शृणु तीर्थेषु यत्फलम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000464008, "chapter_id": 20464, "verse_number": "३-११-९", "content_sanskrit": "यस्य हस्तौ च पादौ च मनश्चैव सुसंयतम् ।\nविद्या तपश्च कीर्तिश्च स तीर्थफलमश्नुते॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000464009, "chapter_id": 20464, "verse_number": "३-११-१०", "content_sanskrit": "प्रतिग्रहादुपावृत्तः संतुष्टो नियतः शुचिः ।\nअहंकारनिवृत्तश्च स तीर्थफलमश्नुते॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000464010, "chapter_id": 20464, "verse_number": "३-११-११", "content_sanskrit": "अकल्किको निराहारोऽलब्धाहारो जितेंद्रियः ।\nविमुक्तः सर्वदोषैर्यः स तीर्थफलमश्नुते॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000464011, "chapter_id": 20464, "verse_number": "३-११-१२", "content_sanskrit": "अक्रोधनश्च राजेंद्र सत्यशीलो दृढव्रतः ।\nआत्मोपमश्च भूतेषु स तीर्थफलमश्नुते॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000464012, "chapter_id": 20464, "verse_number": "३-११-१३", "content_sanskrit": "ऋषिभिः क्रतवः प्रोक्ता देवेष्वपि यथाक्रमम् ।\nफलं चैव यथातत्त्वं प्रेत्य चेह च सर्वशः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000464013, "chapter_id": 20464, "verse_number": "३-११-१४", "content_sanskrit": "न ते शक्या दरिद्रेण यज्ञाः प्राप्तुं महीपते ।\nबहूपकरणा यज्ञा नानासंभारविस्तराः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000464014, "chapter_id": 20464, "verse_number": "३-११-१५", "content_sanskrit": "प्राप्यंते पार्थिवैरेते समृद्धैर्वा नरैः क्वचित् ।\nन निर्धनैर्नरगणैरेकात्मभिरसाधनैः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000464015, "chapter_id": 20464, "verse_number": "३-११-१६", "content_sanskrit": "यो दरिद्रैरपि विधिः शक्यः प्राप्तुं जनेश्वर ।\nतुल्यो यज्ञफलैः पुण्यैस्तं निबोध महीपते॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000464016, "chapter_id": 20464, "verse_number": "३-११-१७", "content_sanskrit": "ऋषीणां परमं गुह्यमिदं धर्म्मभृतां वर ।\nतीर्थाभिगमनं पुण्यं यज्ञैरपि विशिष्यते॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000464017, "chapter_id": 20464, "verse_number": "३-११-१८", "content_sanskrit": "अनुपोष्य त्रिरात्राणि तीर्थाभिगमनेन च ।\nअदत्वा कांचनं गाश्च दरिद्रो नाम जायते॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000464018, "chapter_id": 20464, "verse_number": "३-११-१९", "content_sanskrit": "अग्निष्टोमादिभिर्यज्ञैरिष्ट्वा विपुलदक्षिणैः ।\nन तत्फलमवाप्नोति तीर्थाभिगमनेन यत्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000464019, "chapter_id": 20464, "verse_number": "३-११-२०", "content_sanskrit": "नृलोके देवलोकस्य तीर्थं त्रैलोक्यविश्रुतम् ।\nपुष्करं तीर्थमासाद्य देवदेवसमो भवेत्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000464020, "chapter_id": 20464, "verse_number": "३-११-२१", "content_sanskrit": "दशकोटिसहस्राणि तीर्थानां वै महीपते ।\nसान्निध्यं पुष्करे येषां त्रिसंध्यं सूर्यवंशज॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000464021, "chapter_id": 20464, "verse_number": "३-११-२२", "content_sanskrit": "आदित्या वसवो रुद्रा साध्याश्च समरुद्गणाः ।\nगंधर्वाप्सरसश्चैव तत्र सन्निहिताः प्रभो॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000464022, "chapter_id": 20464, "verse_number": "३-११-२३", "content_sanskrit": "यत्र देवास्तपस्तप्त्वा दैत्या ब्रह्मर्षयस्तथा ।\nदिव्ययोगा महाराज पुण्येन महता द्विजाः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000464023, "chapter_id": 20464, "verse_number": "३-११-२४", "content_sanskrit": "मनसाप्यभिकामस्य पुष्कराणि मनीषिणः ।\nपूयंते सर्वपापानि नाकपृष्ठे च पूज्यते॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000464024, "chapter_id": 20464, "verse_number": "३-११-२५", "content_sanskrit": "अस्मिंस्तीर्थे महाभाग नित्यमेव पितामहः ।\nउवास परमप्रीतो देवदानवसंमतः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000464025, "chapter_id": 20464, "verse_number": "३-११-२६", "content_sanskrit": "पुष्करेषु महाभाग देवाः सर्षिपुरोगमाः ।\nसिद्धिं परमिकां प्राप्ताः पुण्येन महतान्विताः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000464026, "chapter_id": 20464, "verse_number": "३-११-२७", "content_sanskrit": "तत्राभिषेकं यः कुर्यात्पितृदेवार्चने रतः ।\nअश्वमेधाद्दशगुणं प्रवदंति मनीषिणः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000464027, "chapter_id": 20464, "verse_number": "३-११-२८", "content_sanskrit": "अप्येकं भोजयेद्विप्रं पुष्करारण्यमाश्रितः ।\nतेनैति पूजितांल्लोकान्ब्रह्मणः सदने स्थितान्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000464028, "chapter_id": 20464, "verse_number": "३-११-२९", "content_sanskrit": "सायंप्रातः स्मरेद्यस्तु पुष्कराणि कृतांजलि ।\nउपस्पृष्टं भवेत्तेन सर्वतीर्थेषु पार्थिव॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000464029, "chapter_id": 20464, "verse_number": "३-११-३०", "content_sanskrit": "जन्मप्रभृति यत्पापं स्त्रियो वा पुरुषस्य वा ।\nपुष्करे गतमात्रस्य सर्वमेव प्रणश्यति॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000464030, "chapter_id": 20464, "verse_number": "३-११-३१", "content_sanskrit": "यथा सुराणां सर्वेषामादिस्तु मधुसूदनः ।\nतथैव पुष्करो राजन्तीर्थानामादिरुच्यते॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000464031, "chapter_id": 20464, "verse_number": "३-११-३२", "content_sanskrit": "उष्ट्वा द्वादशवर्षाणि पुष्करे नियतः शुचिः ।\nक्रतून्सर्वानवाप्नोति ब्रह्मलोकं च गच्छति॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000464032, "chapter_id": 20464, "verse_number": "३-११-३३", "content_sanskrit": "यस्तु वर्षशतं पूर्णमग्निहोत्रमुपाश्नुते ।\nकार्तिकीं वा वसेदेकां पुष्करे सममेव तत्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000464033, "chapter_id": 20464, "verse_number": "३-११-३४", "content_sanskrit": "दुष्करं पुष्करे गंतुं दुष्करं पुष्करे तपः ।\nदुष्करं पुष्करे दानं वस्तुं चैव सुदुष्करम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000464034, "chapter_id": 20464, "verse_number": "३-११-३५", "content_sanskrit": "त्रीणि शृंगाणि शुभ्राणि त्रीणि प्रस्रवणानि च ।\nपुष्कराण्यादि तीर्थानि न विद्मस्तत्र कारणम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000464035, "chapter_id": 20464, "verse_number": "३-११-३६", "content_sanskrit": "उष्ट्वा द्वादशवर्षाणि नियतो नियताशनः ।\nस मुक्तः सर्वपापेभ्यो सर्वक्रतुफलं लभेत्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]