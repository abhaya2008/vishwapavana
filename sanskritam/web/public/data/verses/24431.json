[{"id": 7004431000, "chapter_id": 24431, "verse_number": "५-३-१२५-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेन्महीपाल रवितीर्थमनुत्तमम् ।\nयत्र देवः सहस्रांशुस्तपस्तप्त्वा दिवं गतः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004431001, "chapter_id": 24431, "verse_number": "५-३-१२५-२", "content_sanskrit": "युधिष्ठिर उवाच ।\nकथं देवो जगद्धाता सर्वदेवनमस्कृतः ।\nतपस्तपति देवेशस्तापसो भास्करो रविः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004431002, "chapter_id": 24431, "verse_number": "५-३-१२५-३", "content_sanskrit": "आराध्यः सर्वभूतानां सर्वदेवैश्च पूजितः ।\nप्रत्यक्षो दृश्यते लोके सृष्टिसंहारकारकः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004431003, "chapter_id": 24431, "verse_number": "५-३-१२५-४", "content_sanskrit": "आदित्यत्वं कथं प्राप्तः कथं भास्कर उच्यते ।\nसर्वमेतत्समासेन कथयस्व ममानघ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004431004, "chapter_id": 24431, "verse_number": "५-३-१२५-५", "content_sanskrit": "मार्कण्डेय उवाच ।\nमहाप्रश्नो महाराज यस्त्वया परिपृच्छितः ।\nतत्सर्वं सम्प्रवक्ष्यामि नमस्कृत्य स्वयम्भुवम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004431005, "chapter_id": 24431, "verse_number": "५-३-१२५-६", "content_sanskrit": "आसीदिदं तमोभूतमप्रज्ञातमलक्षणम् ।\nअप्रतर्क्यमविज्ञेयं प्रसुप्तमिव सर्वतः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004431006, "chapter_id": 24431, "verse_number": "५-३-१२५-७", "content_sanskrit": "ततस्तेजश्च दिव्यं च तप्तपिण्डमनुत्तमम् ।\nआकाशात्तु यथैवोल्का सृष्टिहेतोरधोमुखी॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004431007, "chapter_id": 24431, "verse_number": "५-३-१२५-८", "content_sanskrit": "तत्तेजसोऽन्तः पुरुषः संजातः सर्वभूषितः ।\nस शिवोऽपाणिपादश्च येन सर्वमिदं ततम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004431008, "chapter_id": 24431, "verse_number": "५-३-१२५-९", "content_sanskrit": "तस्योत्पन्नस्य भूतस्य तेजो रूपस्य भारत ।\nपश्चात्प्रजापतिर्भूयः कालः कालान्तरेण वै॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004431009, "chapter_id": 24431, "verse_number": "५-३-१२५-१०", "content_sanskrit": "अग्निर्जातः स भूतानां मनुष्यासुररक्षसाम् ।\nसर्वदेवाधिदेवश्च आदित्यस्तेन चोच्यते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004431010, "chapter_id": 24431, "verse_number": "५-३-१२५-११", "content_sanskrit": "आदौ तस्य नमस्कारोऽन्येषां च तदनन्तरम् ।\nक्रियते दैवतैः सर्वैस्तेन सर्वैर्महर्षिभिः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004431011, "chapter_id": 24431, "verse_number": "५-३-१२५-१२", "content_sanskrit": "तिस्रः सन्ध्यास्त्रयो देवाः सांनिध्याः सूर्यमण्डले ।\nनमस्कृतेन सूर्येण सर्वे देवा नमस्कृताः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004431012, "chapter_id": 24431, "verse_number": "५-३-१२५-१३", "content_sanskrit": "न दिवा न भवेद्रात्रिः षण्मासा दक्षिणायनम् ।\nअयनं चोत्तरं चापि भास्करेण विना नृप॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004431013, "chapter_id": 24431, "verse_number": "५-३-१२५-१४", "content_sanskrit": "स्नानं दानं जपो होमः स्वाध्यायो देवतार्चनम् ।\nन वर्तते विना सूर्यं तेन पूज्यतमो रविः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004431014, "chapter_id": 24431, "verse_number": "५-३-१२५-१५", "content_sanskrit": "शब्दगाः श्रुतिमुख्याश्च ब्रह्मविष्णुमहेश्वराः ।\nप्रत्यक्षो भगवान्देवो दृश्यते लोकपावनः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004431015, "chapter_id": 24431, "verse_number": "५-३-१२५-१६", "content_sanskrit": "उत्पत्तिः प्रलयस्थानं निधानं बीजमव्ययम् ।\nहेतुरेको जगन्नाथो नान्यो विद्येत भास्करात्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004431016, "chapter_id": 24431, "verse_number": "५-३-१२५-१७", "content_sanskrit": "एवमात्मभवं कृत्वा जगत्स्थावरजङ्गमम् ।\nलोकानां तु हितार्थाय स्थापयेद्धर्मपद्धतिम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004431017, "chapter_id": 24431, "verse_number": "५-३-१२५-१८", "content_sanskrit": "नर्मदातटमाश्रित्य स्थापयित्वात्मनस्तनुम् ।\nसहस्रांशुं निधिं धाम्नां जगामाकाशमव्ययम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004431018, "chapter_id": 24431, "verse_number": "५-३-१२५-१९", "content_sanskrit": "तत्र तीर्थे तु यः स्नात्वा पूजयेत्परमेश्वरम् ।\nसहस्रकिरणं देवं नाममन्त्रविधानतः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004431019, "chapter_id": 24431, "verse_number": "५-३-१२५-२०", "content_sanskrit": "तेन तप्तं हुतं तेन तेन सर्वमनुष्ठितम् ।\nतेन सम्यग्विधानेन सम्प्राप्तं परमं पदम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004431020, "chapter_id": 24431, "verse_number": "५-३-१२५-२१", "content_sanskrit": "ते धन्यास्ते महात्मानस्तेषां जन्म सुजीवितम् ।\nस्नात्वा ये नर्मदातोये देवं पश्यन्ति भास्करम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004431021, "chapter_id": 24431, "verse_number": "५-३-१२५-२२", "content_sanskrit": "तथा देवस्य राजेन्द्र ये कुर्वन्ति प्रदक्षिणम् ।\nअनन्यभक्त्या सततं त्रिरक्षरसमन्विताः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004431022, "chapter_id": 24431, "verse_number": "५-३-१२५-२३", "content_sanskrit": "तेन पूतशरीरास्ते मन्त्रेण गतपातकाः ।\nयत्पुण्यं च भवेत्तेषां तदिहैकमनाः शृणु॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004431023, "chapter_id": 24431, "verse_number": "५-३-१२५-२४", "content_sanskrit": "ससमुद्रगुहा तेन सशैलवनकानना ।\nप्रदक्षिणीकृता सर्वा पृथिवी नात्र संशयः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004431024, "chapter_id": 24431, "verse_number": "५-३-१२५-२५", "content_sanskrit": "मन्त्रमूलमिदं सर्वं त्रैलोक्यं सचराचरम् ।\nतेन मन्त्रविहीनं तु कार्यं लोके न सिध्यति॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004431025, "chapter_id": 24431, "verse_number": "५-३-१२५-२६", "content_sanskrit": "यथा काष्ठमयो हस्ती यथा चर्ममयो मृगः ।\nकार्यार्थं नैव सिध्येत तथा कर्म ह्यमन्त्रकम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004431026, "chapter_id": 24431, "verse_number": "५-३-१२५-२७", "content_sanskrit": "भस्महुतं पार्थ यथा तोयविवर्जितम् ।\nनिष्फलं जायते दानं तथा मन्त्रविवर्जितम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004431027, "chapter_id": 24431, "verse_number": "५-३-१२५-२८", "content_sanskrit": "काष्ठपाषाणलोष्टेषु मृन्मयेषु विशेषतः ।\nमन्त्रेण लोके पूजां तु कुर्वन्ति न ह्यमन्त्रतः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004431028, "chapter_id": 24431, "verse_number": "५-३-१२५-२९", "content_sanskrit": "द्वादशाब्दान्नमस्काराद्भक्त्या यल्लभते फलम् ।\nमन्त्रयुक्तनमस्कारात्सकृत्तल्लभते फलम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004431029, "chapter_id": 24431, "verse_number": "५-३-१२५-३०", "content_sanskrit": "संक्रान्तौ च व्यतीपाते अयने विषुवे तथा ।\nनर्मदाया जले स्नात्वा यस्तु पूजयते रविम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004431030, "chapter_id": 24431, "verse_number": "५-३-१२५-३१", "content_sanskrit": "द्वादशाब्देन यत्पापमज्ञानज्ञानसंचितम् ।\nतत्क्षणान्नश्यते सर्वं वह्निना तु तुषं यथा॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004431031, "chapter_id": 24431, "verse_number": "५-३-१२५-३२", "content_sanskrit": "चन्द्रसूर्यग्रहे स्नात्वा सोपवासो जितेन्द्रियः ।\nतत्रादित्यमुखं दृष्ट्वा मुच्यते सर्वकिल्बिषैः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004431032, "chapter_id": 24431, "verse_number": "५-३-१२५-३३", "content_sanskrit": "माघमासे तु सम्प्राप्ते सप्तम्यां नृपसत्तम ।\nसोपवासो जितक्रोध उषित्वा सूर्यमन्दिरे॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004431033, "chapter_id": 24431, "verse_number": "५-३-१२५-३४", "content_sanskrit": "प्रातः स्नात्वा विधानेन ददात्यर्घं दिवाकरे ।\nविधिना मन्त्रयुक्तेन स लभेत्पुण्यमुत्तमम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004431034, "chapter_id": 24431, "verse_number": "५-३-१२५-३५", "content_sanskrit": "पितृदेवमनुष्याणां कृत्वा ह्युदकतर्पणम् ।\nमन्दिरे देवदेवस्य ततः पूजां समाचरेत्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004431035, "chapter_id": 24431, "verse_number": "५-३-१२५-३६", "content_sanskrit": "गन्धैः पुष्पैस्तथा धूपैर्दीपनैवेद्यशोभनैः ।\nपूजयित्वा जगन्नाथं ततो मन्त्रमुदीरयेत्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004431036, "chapter_id": 24431, "verse_number": "५-३-१२५-३७", "content_sanskrit": "विष्णुः शक्रो यमो धाता मित्रोऽथ वरुणस्तथा ।\nविवस्वान्सविता पूषा चण्डांशुर्भर्ग एव च॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004431037, "chapter_id": 24431, "verse_number": "५-३-१२५-३८", "content_sanskrit": "इति द्वादशनामानि जपन्कृत्वा प्रदक्षिणाम् ।\nयत्फलं लभते पार्थ तदिहैकमनाः शृणु॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004431038, "chapter_id": 24431, "verse_number": "५-३-१२५-३९", "content_sanskrit": "दरिद्रो व्याधितो मूको बधिरो जड एव च ।\nन भवेत्सप्त जन्मानि इत्येवं शङ्करोऽब्रवीत्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004431039, "chapter_id": 24431, "verse_number": "५-३-१२५-४०", "content_sanskrit": "एवं ज्ञात्वा विधानेन जपन्मन्त्रं विचक्षणः ।\nआराधयेद्रविं भक्त्या य इच्छेत्पुण्यमुत्तमम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004431040, "chapter_id": 24431, "verse_number": "५-३-१२५-४१", "content_sanskrit": "मन्त्रहीनां तु यः कुर्याद्भक्तिं देवस्य भारत ।\nस विडम्बति चात्मानं पशुकीटपतङ्गवत्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004431041, "chapter_id": 24431, "verse_number": "५-३-१२५-४२", "content_sanskrit": "तत्र तीर्थे तु यः कश्चित्त्यजते देहमुत्तमम् ।\nस गतस्तत्र देवैस्तु पूज्यमानो महर्षिभिः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004431042, "chapter_id": 24431, "verse_number": "५-३-१२५-४३", "content_sanskrit": "स्वेच्छया सुचिरं कालमिह लोके नृपो भवेत्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004431043, "chapter_id": 24431, "verse_number": "५-३-१२५-४४", "content_sanskrit": "पुत्रपौत्रसमायुक्तो हस्त्यश्वरथसङ्कुलः ।\nदासीदासशतोपेतो जायते विपुले कुले॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]