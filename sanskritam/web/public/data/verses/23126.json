[{"id": 7003126000, "chapter_id": 23126, "verse_number": "४-६२-१", "content_sanskrit": "अथ द्विषष्टितमोऽध्यायः ।\nनारद उवाच ।\nब्रह्मन् केन प्रकारेण रामो दाशरथिः स्वयम् ।\nचकार मोक्षणं कुत्र युगे गौतमयोषितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003126001, "chapter_id": 23126, "verse_number": "४-६२-२", "content_sanskrit": "रामावतारं सुखदं समासेन मनोहरम् ।\nकथायस्व महाभाग श्रोतुं कौतूहलं मम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003126002, "chapter_id": 23126, "verse_number": "४-६२-३", "content_sanskrit": "नारायण उवाच ।\nब्रह्मणा प्रार्थितो विष्णुर्जातो दशरथात्स्वयम् ।\nकौसल्यायां च भगवांस्त्रेतायां च मृदाऽन्वितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003126003, "chapter_id": 23126, "verse_number": "४-६२-४", "content_sanskrit": "कैकेय्यां भरतश्चैव रामतुल्यो गुणेन च ।\nलक्ष्मणश्चापि शत्रुघ्नः सुमित्रायां गुणार्णवः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003126004, "chapter_id": 23126, "verse_number": "४-६२-५", "content_sanskrit": "पिश्वामित्रप्रेषितश्च श्रीरामश्च सलक्ष्मणः ।\nप्रययौ मिथिलां रम्यां सीताग्रहणहेतवे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003126005, "chapter_id": 23126, "verse_number": "४-६२-६", "content_sanskrit": "दृष्ट्वा पाषाणारूपा च रामो वर्त्मनि कामिनीम् ।\nविश्वामित्रं च पप्रच्छ कारणं जगदीश्वरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003126006, "chapter_id": 23126, "verse_number": "४-६२-७", "content_sanskrit": "रामस्य वचनं श्रुत्वा विश्वामित्रो महातपाः ।\nउवाच तत्र धर्मिष्ठो रहस्यं सर्वमेव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003126007, "chapter_id": 23126, "verse_number": "४-६२-८", "content_sanskrit": "कारणं तन्मुखाच्छ्रृत्वा रामो भुवनपावनः ।\nपस्पर्श पादाङ्गुलिना सा बभूव च पद्मिनी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003126008, "chapter_id": 23126, "verse_number": "४-६२-९", "content_sanskrit": "सा राममाशिषं कृत्वा प्रययौ भर्तृ मन्दिरम् ।\nशुभाशिषं ददौ तस्मै भार्या संप्राप्य गौतमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003126009, "chapter_id": 23126, "verse_number": "४-६२-१०", "content_sanskrit": "रामश्च मिथिलां गत्वा धनुर्भङ्गं शिवस्या च ।\nचकार पाणिग्रहणं सीतायाश्चैव नारद ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003126010, "chapter_id": 23126, "verse_number": "४-६२-११", "content_sanskrit": "कृत्वा विवाहं राजेन्द्रो भृगुदर्प निहत्य च ।\nणयोध्यां प्रययौ रम्यां क्रीडाकौतुकमङ्गलैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003126011, "chapter_id": 23126, "verse_number": "४-६२-१२", "content_sanskrit": "राजा पुत्रं नृपं कर्तुमिषेय कृतसादरम् ।\nसप्ततीर्थोदकं तूर्णमानीय मुनिपुंगवान् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003126012, "chapter_id": 23126, "verse_number": "४-६२-१३", "content_sanskrit": "कृताधिवासं श्रीरामं सर्व मङ्गलसंयुतम् ।\nदृष्ट्वा भरतमाता च कैकेयी शोकविह्वला ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003126013, "chapter_id": 23126, "verse_number": "४-६२-१४", "content_sanskrit": "वरयामास राजानं पूर्वमङ्गीकृतं वरम् ।\nरामस्य वनवासं च राजत्वं भरतस्य च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003126014, "chapter_id": 23126, "verse_number": "४-६२-१५", "content_sanskrit": "वरं दातुं महाराजो नेयेष प्रेममोहितः ।\nधर्मसत्यभयेनैवोवाच रामो नृपं सुधी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003126015, "chapter_id": 23126, "verse_number": "४-६२-१६", "content_sanskrit": "श्रीराम उवाच ।\nतडागशतदानेन यत्पुण्यं लभते नरः ।\nततोऽधिकं च लभते वापीदानेन निश्चितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003126016, "chapter_id": 23126, "verse_number": "४-६२-१७", "content_sanskrit": "दशवापीप्रदानेन यत्पुण्यं लभते नरः ।\nततोऽधिकं च लभते पुण्यं कन्याप्रदानतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003126017, "chapter_id": 23126, "verse_number": "४-६२-१८", "content_sanskrit": "दशकन्याप्रदानेन यत्पुण्यं लभते नरः ।\nततोऽधिकं च लभते यज्ञैकेन नराधिप ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003126018, "chapter_id": 23126, "verse_number": "४-६२-१९", "content_sanskrit": "शतयज्ञेन यत्पुण्यं लभते पुण्यकृज्जनः ।\nततोऽधिकं च लभते पुत्रास्यदर्शनेन च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003126019, "chapter_id": 23126, "verse_number": "४-६२-२०", "content_sanskrit": "दर्शने शतपुत्राणां यत्पुण्यं लभते नरः ।\nतत्पुण्यं लभते नूनं पुण्यवान्सत्यबालनात् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003126020, "chapter_id": 23126, "verse_number": "४-६२-२१", "content_sanskrit": "न हि सत्यात्परो धर्मो नानृतात्पातकं परम् ।\nन हि गह्घासमं तीर्यं म देवः केशवात्परः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003126021, "chapter_id": 23126, "verse_number": "४-६२-२२", "content_sanskrit": "नास्ति धर्मात्परो बन्धुर्नास्ति धर्मात्परं धनम् ।\nधर्मात्प्रियः परः को वा स्पधर्मं रक्ष यत्नतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003126022, "chapter_id": 23126, "verse_number": "४-६२-२३", "content_sanskrit": "स्वधर्मे रक्षिते तात शश्वत्सर्वत्र मङ्गलम् ।\nयशस्यं सुप्रतिष्ठा च प्रतापः पूजनं परम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003126023, "chapter_id": 23126, "verse_number": "४-६२-२४", "content_sanskrit": "यतुर्दशाब्दं धर्मेण त्यक्त्वा गृहसुखं म्रमन् ।\nवनवासं करिष्यामि सत्यस्य पालनाय ते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003126024, "chapter_id": 23126, "verse_number": "४-६२-२५", "content_sanskrit": "कृत्वा सत्यं च शपथमिच्छयाऽनिच्छयाऽथवा ।\nन कृर्यात्पालनं यो हि भस्मान्तं तस्य सूतकम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003126025, "chapter_id": 23126, "verse_number": "४-६२-२६", "content_sanskrit": "कुम्भीपाके स पचति यावच्चन्द्रदिवाकरौ ।\nततो मूको भवेत्कुषठी मानवः सप्तजन्मसु ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003126026, "chapter_id": 23126, "verse_number": "४-६२-२७", "content_sanskrit": "इत्योवमुक्त्वा श्रीरामो विधाय कल्कलं जटाम् ।\nप्रययौ च महारण्ये सीतया लक्ष्मणेन च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003126027, "chapter_id": 23126, "verse_number": "४-६२-२८", "content_sanskrit": "पुत्रशोकान्महाराजास्तत्याज स्वतनुं मुने ।\nपालनाय पितुः सत्यं रामो बभ्रामकानन ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003126028, "chapter_id": 23126, "verse_number": "४-६२-२९", "content_sanskrit": "कालान्तरे महारण्ये भगिनी रावणस्य च ।\nभ्रमन्ती कानने घोरे भर्त्रा सार्धं सुगौतुकात् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003126029, "chapter_id": 23126, "verse_number": "४-६२-३०", "content_sanskrit": "ददर्श रामं कुलटा कामार्ता राक्षसी तदा ।\nपुलकाञ्चितसर्वाङ्गी सूर्च्छमाप स्मरेण च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003126030, "chapter_id": 23126, "verse_number": "४-६२-३१", "content_sanskrit": "श्रीरामनिकटं गत्वा सस्मितोवाच कामुकी ।\nशस्वधौवनसंयुक्ताऽतिप्रौढा कामदुर्मदा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003126031, "chapter_id": 23126, "verse_number": "४-६२-३२", "content_sanskrit": "शूर्पणखोवाच ।\nहेराम हे धनश्याम रूपधाम सुणान्वित ।\nमायानुरक्तां वनितां मां गृहाण सुनिर्जने ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003126032, "chapter_id": 23126, "verse_number": "४-६२-३३", "content_sanskrit": "श्रुत्वा शूर्पणखावाक्यं धर्मं संस्मृत्य धार्मिकः ।\nउवाच सधुरें वाक्यं शावभीतश्च नारद ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003126033, "chapter_id": 23126, "verse_number": "४-६२-३४", "content_sanskrit": "श्रीराम उवाच ।\nअम्बमातः सभार्योऽहमभार्यं गच्छ मेऽनुजम् ।\nदुःखं प्रियोऽन्यां प्रभजेदितरं च सुखालयम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003126034, "chapter_id": 23126, "verse_number": "४-६२-३५", "content_sanskrit": "रामस्य वचनं श्रुत्वा प्रययौ लक्ष्मणं मुदा ।\nददर्श लक्षमणं शान्तं कान्तं च लक्षणान्वितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003126035, "chapter_id": 23126, "verse_number": "४-६२-३६", "content_sanskrit": "मां भजस्व महाभागेत्युवाच च पुनः पुनः ।\nलक्ष्मणास्तद्वचः श्रुत्वा तामुवाच कुतूहलात् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003126036, "chapter_id": 23126, "verse_number": "४-६२-३७", "content_sanskrit": "लक्ष्मण उवाच ।\nविहाय रामं सर्वेशं हे मूढे दासमिच्छसि ।\nसीतादासी च मत्पत्नी सीतादासोऽहमेव च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003126037, "chapter_id": 23126, "verse_number": "४-६२-३८", "content_sanskrit": "भव सीतासपत्नी त्वं गच्छ रामं मदीश्वरम् ।\nतव पुत्रो भविष्यामि सीतायाश्चयथा सति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003126038, "chapter_id": 23126, "verse_number": "४-६२-३९", "content_sanskrit": "लक्ष्मणास्य वचः श्रुत्वा कामेन हृतमानसा ।\nउवाच लक्ष्मणं मूढा शुष्ककण्ठेष्ठतालुका ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003126039, "chapter_id": 23126, "verse_number": "४-६२-४०", "content_sanskrit": "शूर्पणखोवाच ।\nयदी त्यजसि मां मूढ कामात्स्वयमुपस्थिताम् ।\nयुवयोश्च विपत्तिश्च भविष्य ति न संशयः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003126040, "chapter_id": 23126, "verse_number": "४-६२-४१", "content_sanskrit": "ब्रह्मा च मोहिनीं त्यक्तवा विश्वेऽपूज्ये बभूव सः ।\nरम्भाशापेन दक्षश्च छागमस्तो बभूव सः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003126041, "chapter_id": 23126, "verse_number": "४-६२-४२", "content_sanskrit": "स्वर्वैद्यश्चोर्वशीशापाद्यज्ञभागविवर्जितः ।\nरूपहीनः कुबेरश्च मेनाशापेन लक्ष्मण ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003126042, "chapter_id": 23126, "verse_number": "४-६२-४३", "content_sanskrit": "कामो घृताचीशापेन बभूव भस्मसाच्छिवात् ।\nबलिर्मदालसाशापाद्भ्रष्टराज्यो बभूव ह ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003126043, "chapter_id": 23126, "verse_number": "४-६२-४४", "content_sanskrit": "शापेन मिश्रकेश्याश्च हृतभार्यो बृहस्पतिः ।\nमम शापात्तथा रामो हृतभार्यो भविष्यति ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003126044, "chapter_id": 23126, "verse_number": "४-६२-४५", "content_sanskrit": "कामातुरां यौवनस्थां भार्या स्वयमुपस्थिताम् ।\nन त्यजेद्धर्मभीतश्च श्रुतं माध्यंदिने पुरा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003126045, "chapter_id": 23126, "verse_number": "४-६२-४६", "content_sanskrit": "इह त्यक्त्वा पिबद्ग्रस्तः परत्र नरकं व्रजेत् ।\nश्रुत्वा शूर्पणखावाक्यमर्धयन्द्रेण लक्ष्मणः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003126046, "chapter_id": 23126, "verse_number": "४-६२-४७", "content_sanskrit": "चिच्छेद नासिकां तस्याः क्षुरधारेण लीलया ।\nतस्या भ्राता च युयुधे बलवान्खरदूषणः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003126047, "chapter_id": 23126, "verse_number": "४-६२-४८", "content_sanskrit": "ससैन्यो लक्ष्मणास्त्रेण स जगाम यमालयम् ।\nचतुर्दशसहस्रं च राक्षसान्खरदूषणम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003126048, "chapter_id": 23126, "verse_number": "४-६२-४९", "content_sanskrit": "मृतान्दृष्ट्वा शूर्पणखा भर्त्सयामास रावणम् ।\nसर्वं निवेदनं कृत्वा जगाम पुष्करं तदा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003126049, "chapter_id": 23126, "verse_number": "४-६२-५०", "content_sanskrit": "ब्रह्मणश्च वरं प्राप कृत्वा च दुष्करं तपः ।\nउवाच तादृशीं दृष्ट्वा निराहारां तपस्विनीम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003126050, "chapter_id": 23126, "verse_number": "४-६२-५१", "content_sanskrit": "सर्वज्ञस्तन्मनो मत्वा कृपासिन्धुश्च नारद ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003126051, "chapter_id": 23126, "verse_number": "४-६२-५२", "content_sanskrit": "ब्रह्मोवाच ।\nअप्राप्य रामं दृष्प्रापं करोषि दुष्करं तपः ।\nजितेन्द्रियाणां प्रवरं लक्ष्मणं धर्मलक्षणम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003126052, "chapter_id": 23126, "verse_number": "४-६२-५३", "content_sanskrit": "ब्रह्मविष्णुशिवादीनामीश्वरं प्रकृतेः परम् ।\nजन्मान्तरे च भर्तारं प्राप्स्यसि त्वं वरानने ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003126053, "chapter_id": 23126, "verse_number": "४-६२-५४", "content_sanskrit": "इत्येवमुक्त्वा ब्रह्म च जगाम स्वालयं मुदा ।\nदेहं तत्याज सा वह्नो सा च कुब्जा बभूव ह ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003126054, "chapter_id": 23126, "verse_number": "४-६२-५५", "content_sanskrit": "अथ शूर्पणखा वाक्यात्कोपात्कम्पितविग्रहः ।\nजहार मायया सीतां मायावी राक्षसेश्वरः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003126055, "chapter_id": 23126, "verse_number": "४-६२-५६", "content_sanskrit": "सीतां न दृष्ट्वा रामश्च मूर्च्छां प्राप चिरं मुने ।\nचेतनां कारयामास भ्राता चऽऽध्यात्मिकेन च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003126056, "chapter_id": 23126, "verse_number": "४-६२-५७", "content_sanskrit": "ततो बभ्राम गहनं शैलं च कंदरं नदम् ।\nअहर्निशं च शोकार्तो मुनीनामाश्रमं मुने ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003126057, "chapter_id": 23126, "verse_number": "४-६२-५८", "content_sanskrit": "चिरमन्वेषणं कृत्वा न दृष्ट्वा जानकीं विभुः ।\nचकार मित्रतां रामः सुग्रीवेण स्वयं प्रभुः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003126058, "chapter_id": 23126, "verse_number": "४-६२-५९", "content_sanskrit": "निहत्य वालिनं बाणैर्ददौ राज्यं च लीलया ।\nसुग्रीवाय च मित्राय स्वीकारपालनाय वै ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003126059, "chapter_id": 23126, "verse_number": "४-६२-६०", "content_sanskrit": "दूतान्प्रस्थापयामास सर्वत्र वानरेश्वाः ।\nतस्थौ सुग्रीवभवने श्रीरामश्च सलक्ष्मणः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003126060, "chapter_id": 23126, "verse_number": "४-६२-६१", "content_sanskrit": "हनूमते वरं दत्तवा रम्यं रत्नाङ्गुलीयकम् ।\nसीतायै शुभसंदेशं प्राणधारणकारणम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003126061, "chapter_id": 23126, "verse_number": "४-६२-६२", "content_sanskrit": "तं च प्रस्थापयामास दक्षिणां दिशमुत्तमाम् ।\nसुप्रीत्याऽऽलिङ्गनं दत्त्वा पादरेणून्सुदुर्लभान् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003126062, "chapter_id": 23126, "verse_number": "४-६२-६३", "content_sanskrit": "हनुमान्पययौ लङ्कां सीतान्वेषणहेतवे ।\nरामादधीतसंदेशो ययौ रुद्रकलोद्भवः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003126063, "chapter_id": 23126, "verse_number": "४-६२-६४", "content_sanskrit": "अशोककानने सीतां ददर्श शोककर्शिताम् ।\nनिराहारामतिकृशां कुह्वां चन्द्रकलामिव ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003126064, "chapter_id": 23126, "verse_number": "४-६२-६५", "content_sanskrit": "सततं राम रामेति जपन्तीं भक्तिबूर्वकम् ।\nबिभ्रतीं च जटाभारं तप्तकाञ्चनसंनिभाम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003126065, "chapter_id": 23126, "verse_number": "४-६२-६६", "content_sanskrit": "ध्यायमानां पदाब्जं च श्रीरामस्य दिपानिशम् ।\nशुद्धाशयां सुशीलां च सुव्रतां च पतिव्रताम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003126066, "chapter_id": 23126, "verse_number": "४-६२-६७", "content_sanskrit": "महालक्ष्मीलक्ष्मयुक्तां प्रज्वलन्तीं स्वतेजसा ।\nपुण्यदां सर्वतीर्थानां दृष्ट्वा भुवनपावतीम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003126067, "chapter_id": 23126, "verse_number": "४-६२-६८", "content_sanskrit": "प्रणम्य मातरं दृष्ट्वा रुदतीं वायुनन्दनः ।\nरत्नाङ्गुलीयं रामस्य ददौ तस्यै मुदाऽन्वितः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003126068, "chapter_id": 23126, "verse_number": "४-६२-६९", "content_sanskrit": "रुरोद धर्मी तां दृष्ट्वा धृत्वा तच्चरणाम्बुजम् ।\nउवाच रामसंदेशं सीताजीवनरक्षणम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003126069, "chapter_id": 23126, "verse_number": "४-६२-७०", "content_sanskrit": "हनुमानुवाच ।\nपारेसमुद्रं श्रीरामः संनद्धश्च सलक्ष्मणः ।\nबभूव राममित्रं च सुग्रीवो बलवान्कपिः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003126070, "chapter_id": 23126, "verse_number": "४-६२-७१", "content_sanskrit": "रामश्च वालिनं हत्वा राज्यं निष्कण्टकं ददौ ।\nसुग्रीवाय च मित्राय तद्भार्यं वालिना हृताम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003126071, "chapter_id": 23126, "verse_number": "४-६२-७२", "content_sanskrit": "सुग्रीवश्च तवोद्धारं स्वीचकार च धर्मतः ।\nवानराश्च ययुः सर्वे तवान्वेषणकारणात् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003126072, "chapter_id": 23126, "verse_number": "४-६२-७३", "content_sanskrit": "प्राप्य मङ्गलवार्तां च मत्तो राजीवलोचनः ।\nगम्भीरं सागरं बद्ध्वा सोऽचिरेणाऽऽगमिष्यति ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003126073, "chapter_id": 23126, "verse_number": "४-६२-७४", "content_sanskrit": "निहत्य रावणं पापं सपुत्रं च सबान्धवम् ।\nकरिष्यत्यचिरेणैव हे मातस्तव मोक्षणम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003126074, "chapter_id": 23126, "verse_number": "४-६२-७५", "content_sanskrit": "अद्य रत्नमयीं लङ्कां निःशङ्कस्त्वतप्रसादतः ।\nभस्मीभूतां करिष्यामि मातः पश्य च सस्मितम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003126075, "chapter_id": 23126, "verse_number": "४-६२-७६", "content_sanskrit": "मर्कटीडिम्भतुल्यां च लङ्कां पश्यामि सुव्रते ।\nमूत्रतुल्यं समुद्रं च शरावमिव भूतलम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003126076, "chapter_id": 23126, "verse_number": "४-६२-७७", "content_sanskrit": "पिपीलिकासंघमिव ससैन्यं रावणं तथा ।\nसंहर्तुं च समर्थोंऽहं मुहूर्तार्धेन लीलया ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003126077, "chapter_id": 23126, "verse_number": "४-६२-७८", "content_sanskrit": "रामप्रतिज्ञारक्षार्थं न हनिष्यामि सांप्रतम् ।\nस्वस्था भव महाभागे त्यज भीतिं मदीश्वरि ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003126078, "chapter_id": 23126, "verse_number": "४-६२-७९", "content_sanskrit": "पानरस्य वचः श्रुत्वा रुरोदोच्चैर्मुहुर्मुहुः ।\nउवाच वचनं भीता रामपतिव्रता ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003126079, "chapter_id": 23126, "verse_number": "४-६२-८०", "content_sanskrit": "सीतोवाच ।\nअये जीवति मे रामो मच्छोकार्णवदारुणात् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003126080, "chapter_id": 23126, "verse_number": "४-६२-८१", "content_sanskrit": "अपि मे कुशली नाथः कौसल्यानन्दनः प्रभु ।\nकीदृशश्च कृशाङ्गश्च जानकीजीवनोऽधुना ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003126081, "chapter_id": 23126, "verse_number": "४-६२-८२", "content_sanskrit": "किमाहारश्च किं भुङ्क्ते मम प्रणाधिकः प्रियः ।\nअपि पारे समुद्रस्य सत्यं सीतापतिः स्वयम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003126082, "chapter_id": 23126, "verse_number": "४-६२-८३", "content_sanskrit": "अपि सत्यं क संनद्धो न शोकेन हतः प्रभुः ।\nअपि स्मरति मां पापां स्वामिनो दुःखरूपिणीम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003126083, "chapter_id": 23126, "verse_number": "४-६२-८४", "content_sanskrit": "मदर्थे कति दुःखं वा संप्राप स मदीश्वरः ।\nहारो नाऽऽरोर्पितः कण्ठे पुरा व्यवहितो रतौ ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003126084, "chapter_id": 23126, "verse_number": "४-६२-८५", "content_sanskrit": "अधुनैवाऽऽवयोर्मध्ये समुद्रः शतयोजनः ।\nअपि द्रक्ष्यामि तं रामं करुणासागरं प्रभुम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003126085, "chapter_id": 23126, "verse_number": "४-६२-८६", "content_sanskrit": "कान्तं शान्तं नितान्तं च धर्मिष्ठं धर्मकर्मणि ।\nअपि सेवां करिष्यामि पादपद्मे पुनः प्रभोः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003126086, "chapter_id": 23126, "verse_number": "४-६२-८७", "content_sanskrit": "पतिसेवाविहीनाया मूढाया जीवनं दृथा ।\nअपि मे धर्मपुत्रश्च सत्यं जीवति लक्ष्मणः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003126087, "chapter_id": 23126, "verse_number": "४-६२-८८", "content_sanskrit": "मच्छोकसागरे मग्नो भग्नदर्पो मया विना ।\nवीराणां प्रवरो धर्मी देवकल्पश्च देवरः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003126088, "chapter_id": 23126, "verse_number": "४-६२-८९", "content_sanskrit": "अपि सत्यं ससंन्नद्धो सत्प्रभोरनुजः सदा ।\nअपि द्रक्ष्यामि सत्यं तं लक्ष्मणं धर्मलक्षणम् ।\nप्राणानामधिकं प्रेम्णा धन्यं पुण्यस्वरूपिणम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003126089, "chapter_id": 23126, "verse_number": "४-६२-९०", "content_sanskrit": "इत्येवं वचनं श्रुत्वा दत्त्वा प्रत्युत्तरं शुभम् ।\nभस्मीभूतां च तां लङ्कां चकार लीलया मुने ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003126090, "chapter_id": 23126, "verse_number": "४-६२-९१", "content_sanskrit": "पुनः प्रबोधं तस्यै च दत्तवा वायुसुतः कपिः ।\nप्रययौ लीलया वेगाद्यत्र राजीवलोचनः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003126091, "chapter_id": 23126, "verse_number": "४-६२-९२", "content_sanskrit": "सर्वं तत्कथायामास वृत्तान्तं मातुरेव च ।\nसीतामङ्गलवृत्तान्तं श्रुत्वा रामो रुरोद च ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003126092, "chapter_id": 23126, "verse_number": "४-६२-९३", "content_sanskrit": "रुतोदोच्चैर्लक्ष्मणश्च सुग्रीवश्चापि नारद ।\nवानरा रुरुदुः सर्वे सहबलपराक्रमाः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003126093, "chapter_id": 23126, "verse_number": "४-६२-९४", "content_sanskrit": "निबध्य सेतुं लङ्कां च प्रययौ रघुनन्दनः ।\nससैन्यः सानुजः शीघ्रं संनद्धश्चापि नारद ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003126094, "chapter_id": 23126, "verse_number": "४-६२-९५", "content_sanskrit": "निहत्य रावणं रामो रणं कृत्वा सबान्धवम् ।\nचकार मोक्षणं ब्रह्मन् सितायश्च शुभेक्षणे ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003126095, "chapter_id": 23126, "verse_number": "४-६२-९६", "content_sanskrit": "कृत्वा पुष्पकयानेन सीतां सत्यपरायणाम् ।\nअयोध्यां प्रययौ शीघ्रं क्रीडाकौतुकमङ्गलैः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003126096, "chapter_id": 23126, "verse_number": "४-६२-९७", "content_sanskrit": "क्रीडां चकार भगवान् सीतां कृत्वा च वक्षसि ।\nविजहौ विरहज्वालां सीता रामश्च तत्क्षणम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003126097, "chapter_id": 23126, "verse_number": "४-६२-९८", "content_sanskrit": "सप्तद्वीपेश्वरो रामो बभूव पृथिवीतले ।\nबभूव निखिला पृथ्वी आधिव्याधिविवर्जिता ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003126098, "chapter_id": 23126, "verse_number": "४-६२-९९", "content_sanskrit": "बभूवतू रामपुत्रौ धार्मिकौ च कुशीलवौ ।\nतयोश्च पुत्रैः पौत्रेश्च सूर्यवंशोद्भवा नृपाः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003126099, "chapter_id": 23126, "verse_number": "४-६२-१००", "content_sanskrit": "इति ते कथितं वत्स श्रीरामचरितं शुभम् ।\nसुखदं मोक्षदं सारं पारपोतं भवार्णवे ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}]