[{"id": 2025559, "chapter_id": 1550, "verse_number": "३-१८८-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2025560, "chapter_id": 1550, "verse_number": "३-१८८-१", "content_sanskrit": "भूय एव तु माहात्म्यं ब्राह्मणआनां निबोध मे।\nवैन्यो नामेह राजर्षिरश्वमेधाय दीक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2025561, "chapter_id": 1550, "verse_number": "३-१८८-२", "content_sanskrit": "तमत्रिर्गन्तुमारेबे वित्तार्थमिति नः श्रुतम्।\nभूयोऽर्थं नानुरुध्यत्स धर्मव्यक्तिनिदर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2025562, "chapter_id": 1550, "verse_number": "३-१८८-३", "content_sanskrit": "स विचिन्त्य महातेजा वनमेवान्वरोचयत्।\nधर्मपत्नीं समाहूय पुत्रांश्चेदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2025563, "chapter_id": 1550, "verse_number": "३-१८८-४", "content_sanskrit": "प्राप्स्यामः फलमत्यन्तं बहुलं निरुपद्रवम्।\nअरण्यगमनं क्षिप्रं रोचतां वो गुणाधिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2025564, "chapter_id": 1550, "verse_number": "३-१८८-५", "content_sanskrit": "तं भार्या प्रत्युवाचाथ धनमेवानुरुन्धती।\nवैन्यं गत्वा महात्मानमर्थयस्व धनं बहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2025565, "chapter_id": 1550, "verse_number": "३-१८८-६", "content_sanskrit": "स ते दास्यति राजर्षिर्यजमानोऽर्थिने धनम्।\nतत आदाय विप्रर्षे प्रतिगृह्य धनं बहु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2025566, "chapter_id": 1550, "verse_number": "३-१८८-७", "content_sanskrit": "भृत्यान्सुतान्संविभज्य ततो व्रज यथेप्सितम्।\nएष वै परमो धर्मो धर्मविद्भिरुदाहृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2025567, "chapter_id": 1550, "verse_number": "३-१८८-८x", "content_sanskrit": "अत्रिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2025568, "chapter_id": 1550, "verse_number": "३-१८८-८", "content_sanskrit": "कथितो मे महाभागे गौतमेन महात्मना।\nवैन्यो धर्मार्थसंयुक्तः सत्यव्रतसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2025569, "chapter_id": 1550, "verse_number": "३-१८८-९", "content_sanskrit": "किंत्वस्ति तत्र द्वेष्टारो निवसन्ति हि मे द्विजाः।\nयथा मे गौतमः प्राह ततो न व्यवसाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2025570, "chapter_id": 1550, "verse_number": "३-१८८-१०", "content_sanskrit": "तत्र स्म वाचं कल्याणीं धर्मकामार्थसंहिताम्।\nमयोक्तामन्यथा ब्रूयुस्ततस्ते वै निरर्थिकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2025571, "chapter_id": 1550, "verse_number": "३-१८८-११", "content_sanskrit": "गमिष्यामि महाप्राज्ञे रोचते मे वचस्तव।\nगाश्च मे दास्यते वैन्यः प्रभूतं चार्थसंचयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2025572, "chapter_id": 1550, "verse_number": "३-१८८-१२", "content_sanskrit": "एवमुक्त्वा जगामाशु वैन्ययज्ञं महातपाः।\nगत्वा च यज्ञायतनमत्रिस्तुष्टाव तं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2025573, "chapter_id": 1550, "verse_number": "३-१८८-१३", "content_sanskrit": "वाक्यैर्मङ्गलसंयुक्तैः पूजयानोऽब्रवीद्वचः।\nराजन्धन्यस्त्वमीशश्च भुवि त्वं प्रथमो नृपः।\nस्तुवन्ति त्वां मुनिगणास्त्वदन्यो नास्ति धर्मवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2025574, "chapter_id": 1550, "verse_number": "३-१८८-१४", "content_sanskrit": "तमब्रवीदृषिः क्रुद्धो वचनं वै महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2025575, "chapter_id": 1550, "verse_number": "३-१८८-१५x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2025576, "chapter_id": 1550, "verse_number": "३-१८८-१५", "content_sanskrit": "मैवमत्रे पुनर्ब्रूया न ते प्रज्ञा समाहिता।\nअत्र नः प्रथमो धाता महेन्द्रो वै प्रजापतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2025577, "chapter_id": 1550, "verse_number": "३-१८८-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2025578, "chapter_id": 1550, "verse_number": "३-१८८-१६", "content_sanskrit": "अथात्रिरपि राजेन्द्र गौतमं प्रत्यभाषत।\nअयमेव विधाता च तथैवेन्द्रः प्रजापतिः।\nत्वमेव मुह्यसे मोहान्न प्रज्ञानं तवास्ति ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2025579, "chapter_id": 1550, "verse_number": "३-१८८-१७x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2025580, "chapter_id": 1550, "verse_number": "३-१८८-१७", "content_sanskrit": "जानामि नाहं मुह्यामि त्वंविवक्षुर्विमुह्यसे।\nस्तौषि त्वं दर्शनप्रेप्सू राजानं जनसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2025581, "chapter_id": 1550, "verse_number": "३-१८८-१८", "content_sanskrit": "न वेत्थ परमं धर्मं न चास्त्यत्र प्रयोजनम्।\nबालस्त्वमसि मूढश्च वृद्धः केनापि हेतुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2025582, "chapter_id": 1550, "verse_number": "३-१८८-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2025583, "chapter_id": 1550, "verse_number": "३-१८८-१९", "content_sanskrit": "विवदन्तौ तथा तौ तु मुनीनां द्रशने स्थितौ।\nये तस्य यज्ञे संवृत्तास्तेऽपृच्छन्त कथं त्विमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2025584, "chapter_id": 1550, "verse_number": "३-१८८-२०", "content_sanskrit": "प्रवेशः केन दत्तोऽयमनयोर्वैन्यसंसदि।\nउच्चैः समभिभाषन्तौ केन कार्येण धिष्ठितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2025585, "chapter_id": 1550, "verse_number": "३-१८८-२१", "content_sanskrit": "ततः परमधर्मात्मा काश्यपः सर्वधऱ्मवित्।\nविवादिनावनुप्राप्तौ तावुभौ प्रत्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2025586, "chapter_id": 1550, "verse_number": "३-१८८-२२", "content_sanskrit": "अथाब्रवीत्सदस्यांस्तु गौतमो मुनिसत्तमान्।\nआवयोर्व्याहृतं प्रश्नं शृणुत द्विजसत्तमाः।\nवैन्यं विधातेत्याहात्रिरत्र नौ संशयो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2025587, "chapter_id": 1550, "verse_number": "३-१८८-२३", "content_sanskrit": "`ततस्तु गौतमेनोक्तं वाक्यं वैन्यस्य संसदि।\nश्रुत्वैव तु महात्मानो मुनयोऽभ्यद्रवन्दुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2025588, "chapter_id": 1550, "verse_number": "३-१८८-२४", "content_sanskrit": "सनत्कुमारं धर्मज्ञं संशयच्छेदनाय वै।\n`पप्रच्छुः प्रणताः सर्वे ब्रह्माणमिव सोमपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2025589, "chapter_id": 1550, "verse_number": "३-१८८-२५", "content_sanskrit": "स च तेषां वचः श्रुत्वा यथातत्त्वं महातपाः।\nप्रत्युवाचाथ तानेवं धर्मार्थसहितं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2025590, "chapter_id": 1550, "verse_number": "३-१८८-२६", "content_sanskrit": "ब्रह्म क्षत्रेण सहितं क्षत्रं च ब्रह्मणा सह।\nसंयुक्तौ दहतः शत्रून्वनानीवाग्निमारुतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2025591, "chapter_id": 1550, "verse_number": "३-१८८-२७", "content_sanskrit": "राजा वै प्रथितो धर्मः प्रजानां पतिरेव च।\nस एव शक्रः शुक्रश्च स धाता च बृहस्पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2025592, "chapter_id": 1550, "verse_number": "३-१८८-२८", "content_sanskrit": "प्रजापतिर्विराट् सम्राट् क्षत्रियो भूपतिर्नृपः।\nय एभिः स्तूयते शब्दैः कस्तं नार्चितुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2025593, "chapter_id": 1550, "verse_number": "३-१८८-२९", "content_sanskrit": "पुरायोनिर्युधाजिच्च अभीष्टानचितो भवः।\nस्वर्णेता सहजिद्बभ्रुरिति राजाऽभिधीयते।\nसत्ययोनिः पुराविच्च सत्यधर्मप्रवर्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2025594, "chapter_id": 1550, "verse_number": "३-१८८-३०", "content_sanskrit": "अधर्मादृषयो भीता बलं क्षत्रे समादधन्।\n`तस्माद्धि ब्रह्मणा क्षत्रं क्षत्रेण ब्रह्म चाव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2025595, "chapter_id": 1550, "verse_number": "३-१८८-३१", "content_sanskrit": "आदित्यो दिवि देवेषु तमो नुदति तेजसा।\nतथैव नृपतिर्भूमावधर्मान्नुदते भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2025596, "chapter_id": 1550, "verse_number": "३-१८८-३२", "content_sanskrit": "ततो राज्ञः प्रधानत्वं शास्त्रप्रामाण्यदर्शनात्।\nउत्तरः सिद्ध्यते पक्षो येन राजेति भाषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2025597, "chapter_id": 1550, "verse_number": "३-१८८-३३x", "content_sanskrit": "मार्कण्डे उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2025598, "chapter_id": 1550, "verse_number": "३-१८८-३३", "content_sanskrit": "ततः स राजा संहृष्टः सिद्धे पक्षे महामनाः।\nतमत्रिमब्रवीत्प्रीतः पूर्वं येनाभिसंस्तुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2025599, "chapter_id": 1550, "verse_number": "३-१८८-३४", "content_sanskrit": "यस्मात्पूर्वं मनुष्येषु ज्यायांसं मामिहाब्रवीः।\nसर्वदेवैश्च विप्रर्षे संमितं श्रेष्ठमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2025600, "chapter_id": 1550, "verse_number": "३-१८८-३५", "content_sanskrit": "तस्मात्तेऽहंप्रदास्यामि विविधं वसु भूरि च।\nदासीसहस्रं श्यामानां सुवस्त्राणामलकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2025601, "chapter_id": 1550, "verse_number": "३-१८८-३६", "content_sanskrit": "दशकोटीर्हिरण्यस्य रुक्मभारांस्तथा दश।\nएतद्ददामि विप्रर्षे सर्वज्ञस्त्वं मतो हि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2025602, "chapter_id": 1550, "verse_number": "३-१८८-३७", "content_sanskrit": "तदत्रिनर्न्यायतः सर्वं प्रतिगृह्याभिसत्कृतः।\nप्रत्युज्जगाम तेजस्वी गृहानेव महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2025603, "chapter_id": 1550, "verse_number": "३-१८८-३८", "content_sanskrit": "प्रदाय च धनं प्रीतः पुत्रेभ्यः प्रयतात्मवान्।\nततः समभिसंधाय वनमेवान्वपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2025604, "chapter_id": 1550, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि अष्टाशीत्यधिकशततमोऽध्यायः ॥ १८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]