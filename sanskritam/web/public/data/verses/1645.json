[{"id": 2029559, "chapter_id": 1645, "verse_number": "३-२८३-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029560, "chapter_id": 1645, "verse_number": "३-२८३-१", "content_sanskrit": "राघवः सहसौमित्रिः सुग्रीवेणाभिपालितः।\nवसनमाल्यवतः पृष्ठे ददर्श विमलं नभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029561, "chapter_id": 1645, "verse_number": "३-२८३-२", "content_sanskrit": "सदृष्ट्वाविमले व्योम्नि निर्मलं शसलक्षणम्।\nग्रहनक्षत्रताराभिरनुयान्तममित्रहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029562, "chapter_id": 1645, "verse_number": "३-२८३-३", "content_sanskrit": "कुमुदोत्पलपद्मानां गन्धमादाय वायुना।\nमहीधरस्थः शीतेन सहसाप्रतिबोधितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029563, "chapter_id": 1645, "verse_number": "३-२८३-४", "content_sanskrit": "प्रभाते लक्ष्मणं वीरमभ्यभाषत दुर्मनाः।\nसीतां संस्मृत् यधर्मात्मा रुद्धां राक्षसवेश्मनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029564, "chapter_id": 1645, "verse_number": "३-२८३-५", "content_sanskrit": "गच्छ लक्ष्मण जानीहि किष्किंदायां कपीश्वरम्।\nप्रमत्तं ग्राम्यधर्मेषु कृतघ्नं स्वार्थपण्डितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029565, "chapter_id": 1645, "verse_number": "३-२८३-६", "content_sanskrit": "योसौ कुलाधमो मूढो मया राज्येऽभिषेचितः।\nसर्ववानरगोपुच्छा यमृक्षाश्च भजन्ति वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029566, "chapter_id": 1645, "verse_number": "३-२८३-७", "content_sanskrit": "यदर्थं निहतो बाली मया रघुकुलोद्वह।\nत्वया सहमहाबाहो किष्किन्धोपवने तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029567, "chapter_id": 1645, "verse_number": "३-२८३-८", "content_sanskrit": "कृतघ्नं तमहं मन्ये वानरापशदं भुवि।\nयो मामेवंगतो मूढो न जानीतेऽद्य लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029568, "chapter_id": 1645, "verse_number": "३-२८३-९", "content_sanskrit": "असौ मन्ये न जानीते समयप्रतिपालनम्।\nकृतोपकारं मां नूनमवमत्याल्पया धिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029569, "chapter_id": 1645, "verse_number": "३-२८३-१०", "content_sanskrit": "यदितावदनुद्युक्तः शेते कामसुखात्मकः।\nनेतव्यो वालिमार्गेण सर्वभूतगतिं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029570, "chapter_id": 1645, "verse_number": "३-२८३-११", "content_sanskrit": "अथापि घटतेऽस्माकमर्ते वानरपुङ्गवः।\nतमादायैव काकुत्स्थ त्वरावान्भव माचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029571, "chapter_id": 1645, "verse_number": "३-२८३-१२", "content_sanskrit": "इत्युक्तो लक्ष्मणो भ्रात्रा गुरुवाक्यहिते रतः।\nप्रतस्थे रुचिरं गृह्य समार्गणगुणं धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029572, "chapter_id": 1645, "verse_number": "३-२८३-१३", "content_sanskrit": "किष्किन्धाद्वारमासाद्यप्रविवेशानिवारितः।\nसक्रोध इतितं मत्वाराजा प्रत्युद्ययौ हरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029573, "chapter_id": 1645, "verse_number": "३-२८३-१४", "content_sanskrit": "तं सदारोविनीतात्मा सुग्रीवः प्लवगाधिपः।\nपूजया प्रतिजग्राह प्रीयमाणस्तदर्हया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029574, "chapter_id": 1645, "verse_number": "३-२८३-१५", "content_sanskrit": "तमब्रवीद्रामवचः सौमित्रिरकुतोभयः।\nस तत्सर्वमशेषेण श्रुत्वा प्रह्वः कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029575, "chapter_id": 1645, "verse_number": "३-२८३-१६", "content_sanskrit": "सभृत्यदारो राजेन्द्रसुग्रीवो वानराधिपः।\nइदमाह वचः प्रीतो लक्ष्मणं नरकुञ्जरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029576, "chapter_id": 1645, "verse_number": "३-२८३-१७", "content_sanskrit": "नास्मि लक्ष्मण दुर्मेधा नाकृतज्ञो न निर्घृणः।\nश्रूयतां यः प्रयत्नो मे सीतापर्येषणे कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029577, "chapter_id": 1645, "verse_number": "३-२८३-१८", "content_sanskrit": "दिशः प्रस्थापिताः सर्वेविनीता हरयो मया।\nसर्वेषां च कृतः कालो मासेऽभ्यागमने पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029578, "chapter_id": 1645, "verse_number": "३-२८३-१९", "content_sanskrit": "यैरियं सवना साद्रिः सपुरा सागराम्बरा।\nविचेतव्या मही वीर सग्रामनगराकरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029579, "chapter_id": 1645, "verse_number": "३-२८३-२०", "content_sanskrit": "स मासः पञ्चरात्रेण पूर्णो भवितुमर्हति।\nततः श्रोष्यसि रामेण सहितः सुमहत्प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2029580, "chapter_id": 1645, "verse_number": "३-२८३-२१", "content_sanskrit": "इत्युक्तो लक्ष्मणत्तेन कवानरेनद्रेण धीमता।\nत्यक्त्वारोषमदीनात्मा सुग्रीवं प्रत्यपूजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2029581, "chapter_id": 1645, "verse_number": "३-२८३-२२", "content_sanskrit": "सरामं सहसुग्रीवो माल्यवत्पुष्ठमास्थितम्।\nभिगम्योदयं तस्य कार्यस्य प्रत्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2029582, "chapter_id": 1645, "verse_number": "३-२८३-२३", "content_sanskrit": "इत्येवंवानरेनद्रास्ते समाजन्मुः सहस्रशः।\nदिशस्तिस्रो विचित्याथ न तु ये दक्षिणां गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2029583, "chapter_id": 1645, "verse_number": "३-२८३-२४", "content_sanskrit": "आचख्युस्तत्र रामाय महीं सागरमेखलाम्।\nविचितां न तु वैदेह्या दर्शनं रावणस् वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2029584, "chapter_id": 1645, "verse_number": "३-२८३-२५", "content_sanskrit": "गतास्तु दक्षिणामाशां ये वै वानरपुङ्गवाः।\nआशावांस्तेषु काकुत्स्थः प्राणानार्तोऽभ्यधारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2029585, "chapter_id": 1645, "verse_number": "३-२८३-२६", "content_sanskrit": "द्विमासोपरमे काले व्यतीते प्लवगास्ततः।\nसुग्रीवमभिगम्येदं त्वरिता वाक्यमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2029586, "chapter_id": 1645, "verse_number": "३-२८३-२७", "content_sanskrit": "रक्षितंवालिना यत्तत्स्फीतं मधुवनं महत्।\nत्वया च प्लवगश्रेष्ठ तद्भुङ्क्ते पवनात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2029587, "chapter_id": 1645, "verse_number": "३-२८३-२८", "content_sanskrit": "वालिपुत्रोऽङ्गदश्चैव ये चान्ये प्लवगर्षभाः।\nविचेतुं दक्षिणामाशां राजन्प्रस्थापितास्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2029588, "chapter_id": 1645, "verse_number": "३-२८३-२९", "content_sanskrit": "तेषामपनयं श्रुत्वा मेने सकृतकृत्यताम्।\nकृतार्थानां हि भृत्यानामेतद्भवति चेष्टितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2029589, "chapter_id": 1645, "verse_number": "३-२८३-३०", "content_sanskrit": "स तद्रामाय मेधावी शशंस प्लवगर्षभः।\nरामश्चाप्यनुमानेन मेने दृष्टां तु मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2029590, "chapter_id": 1645, "verse_number": "३-२८३-३१", "content_sanskrit": "हनुमत्प्रमुखाश्चापि विश्रान्तास्ते प्लवङ्गमाः।\nअभिजग्मुर्हरीन्द्रं तं रामलक्ष्मणसन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2029591, "chapter_id": 1645, "verse_number": "३-२८३-३२", "content_sanskrit": "गतिं च मुखवर्णं च दृष्ट्वारामो हनूमतः।\nअगमत्प्रत्ययं भूयो दृष्टा सीतेति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2029592, "chapter_id": 1645, "verse_number": "३-२८३-३३", "content_sanskrit": "हनूमत्प्रमुखास्ते तु वानराः पूर्णमानसाः।\nप्रणेमुर्विधिवद्रामं सुग्रीवं लक्ष्मणं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2029593, "chapter_id": 1645, "verse_number": "३-२८३-३४", "content_sanskrit": "तानुवाचानतान्रामः प्रगृह्य सशरं धनुः।\nअपि मां जीवयिष्यध्वमपि वः कृतकृत्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2029594, "chapter_id": 1645, "verse_number": "३-२८३-३५", "content_sanskrit": "अपि राज्यमयोध्यायां कारयिष्याम्यहं पुनः।\nनिहत्यसमरे शत्रूनाहृत्यजनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2029595, "chapter_id": 1645, "verse_number": "३-२८३-३६", "content_sanskrit": "अमोक्षयित्वावैदेहीमहत्वा च रणे रिपून्।\nहृतदारोऽवधूतश्चनाहं जीवितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2029596, "chapter_id": 1645, "verse_number": "३-२८३-३७", "content_sanskrit": "इत्युक्तवचनं रामं प्रत्युवाचानिलात्मजः।\nप्रियमाख्यामि ते राम दृष्टा सा जानकी मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2029597, "chapter_id": 1645, "verse_number": "३-२८३-३८", "content_sanskrit": "विचित्य दक्षिणामाशां सपर्वतवनाकराम्।\nश्रान्ताः काले व्यतीते स्म दृष्टवन्तो महागुहां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2029598, "chapter_id": 1645, "verse_number": "३-२८३-३९", "content_sanskrit": "प्रविशामो वयं तां तु बहुयोजनमायताम्।\nअन्धकारां सुविपिनां गहनां कीटसेविताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2029599, "chapter_id": 1645, "verse_number": "३-२८३-४०", "content_sanskrit": "गत्वा सुमहदध्वानमादित्यस् प्रभां ततः।\nदृष्टवन्तः स्म तत्रैवभवनं दिव्यमन्तरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2029600, "chapter_id": 1645, "verse_number": "३-२८३-४१", "content_sanskrit": "गयस् किल दैत्यस् तदा सद्वेश्म राघव।\nतत्रप्रभावती नाम तपोऽतप्यत तापसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2029601, "chapter_id": 1645, "verse_number": "३-२८३-४२", "content_sanskrit": "तया दत्तानि भोज्यानिपानानिविविधानि च।\nभुकत्वा लब्धबलाः सन्तस्तयोक्तेन पथा ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2029602, "chapter_id": 1645, "verse_number": "३-२८३-४३", "content_sanskrit": "निर्याय तस्मादुद्देशात्पश्यामो लवणाम्भसः।\nसमीपे सह्यमलयौ दर्दुरं च महागिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2029603, "chapter_id": 1645, "verse_number": "३-२८३-४४", "content_sanskrit": "ततो मलयमारुह्य पश्यन्तो वरुणालयम्।\nकविषण्णा व्यथिताः खिन्ना निराशा जीविते भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2029604, "chapter_id": 1645, "verse_number": "३-२८३-४५", "content_sanskrit": "अनेकशतविस्तीर्णं योजनानां महोदधिम्।\nतिमिनक्रझषावासं चिन्तयन्तः सुदुःखिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2029605, "chapter_id": 1645, "verse_number": "३-२८३-४६", "content_sanskrit": "तत्रानशनसंकल्पं कृत्वाऽऽसीना वयं तदा।\nततः कथान्ते गृध्रस्य जटायोरभवत्कथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2029606, "chapter_id": 1645, "verse_number": "३-२८३-४७", "content_sanskrit": "ततः पर्वतशृङ्गाभं घोररूपं भयावहम्।\nपक्षिणं दृष्टवन्तः स्म वैनतियेमिवापरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2029607, "chapter_id": 1645, "verse_number": "३-२८३-४८", "content_sanskrit": "सोऽस्मानतर्कयद्भोक्तुमथाभ्येत्य वचोऽब्रवीत्।\nभोः क एष मम भ्रातुर्जटायोः कुरुते कथाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2029608, "chapter_id": 1645, "verse_number": "३-२८३-४९", "content_sanskrit": "संपातिर्नाम तस्याहं ज्येष्ठो भ्राता खगाधिपः।\nअन्योन्यस्पर्धया रूढावावामदित्यसत्पदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2029609, "chapter_id": 1645, "verse_number": "३-२८३-५०", "content_sanskrit": "ततो दग्धाविमौ पक्षौ न दग्धौ तु जटायुषः।\nतस्मान्मे चिरदृष्टः स भ्राता गृध्रपतः प्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2029610, "chapter_id": 1645, "verse_number": "३-२८३-५१", "content_sanskrit": "निर्दग्धपक्षः पतितो ह्यहमस्मिन्महागिरौ।\n`द्रष्टुं वीरं न शक्नोमि भ्रातरं वै जटायुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2029611, "chapter_id": 1645, "verse_number": "३-२८३-५२", "content_sanskrit": "तस्यैवं वदतोऽस्माभिर्हतो भ्राता निवेदितः।\nव्यसनं भवतश्चेदं संक्षेपाद्वै निवेदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2029612, "chapter_id": 1645, "verse_number": "३-२८३-५३", "content_sanskrit": "स सम्पातिस्तदा राजञ्श्रुत्वासुमहदप्रियम्।\nविषण्णचेताः पप्रच्छ पुनरस्मानरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2029613, "chapter_id": 1645, "verse_number": "३-२८३-५४", "content_sanskrit": "कः सरामः कथं सीता जटायुश्च कथं हतः।\nइच्छामि सर्वमेवैतच्छ्रोतुं प्लवगसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2029614, "chapter_id": 1645, "verse_number": "३-२८३-५५", "content_sanskrit": "तस्याहं सर्वमेवैतद्भवतो व्यसनागमम्।\nप्रायोपवेशने चैवहेतुं विस्तरशोऽब्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2029615, "chapter_id": 1645, "verse_number": "३-२८३-५६", "content_sanskrit": "सोऽस्मानाश्वासयामास वाक्येनानेन पक्षिराट्।\nरावणो विदितो मह्यं लङ्का चास्य महापुरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2029616, "chapter_id": 1645, "verse_number": "३-२८३-५७", "content_sanskrit": "दृष्टापारे समुद्रस्य त्रिकूटगिरिकन्दरे।\nभवित्री तत्र वैदेही न रमेऽस्त्यत्रविचारणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2029617, "chapter_id": 1645, "verse_number": "३-२८३-५८", "content_sanskrit": "इतितस्य वचः श्रुत्वा वयमुत्थाय सत्वराः।\nसागरक्रमणे मन्त्रं मन्त्रयामः परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2029618, "chapter_id": 1645, "verse_number": "३-२८३-५९", "content_sanskrit": "नाध्यवास्यद्यदा कश्चित्सागरस्य विलङ्घनम्।\nततः पितरमाविश्य पुप्लुवेऽहंमहार्णवम्।\nशतयोजनविस्तीर्णं निहत्य जलराक्षसीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2029619, "chapter_id": 1645, "verse_number": "३-२८३-६०", "content_sanskrit": "उपवासतपःशीला भर्तृदर्शनलालसा।\nजटिला मलदिग्धाङ्गीकृश दीना तपस्विन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2029620, "chapter_id": 1645, "verse_number": "३-२८३-६१", "content_sanskrit": "निमित्तैस्तामहं सीतामुपलभ्य पृथग्विधैः।\nउपसृत्याब्रवं चार्यामभिगम्य रहोगताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2029621, "chapter_id": 1645, "verse_number": "३-२८३-६२", "content_sanskrit": "सीते रामस्य दूतोऽहंवानरोमारुतात्मजः।\nत्वद्दर्शनमभिप्रप्सुरिह प्राप्तो विहायसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2029622, "chapter_id": 1645, "verse_number": "३-२८३-६३", "content_sanskrit": "राजपुत्रौ कुशलिनौ भ्रातरौ रामलक्ष्मणौ।\nसर्वशाखामृगेन्द्रेण सुग्रीवेणाभिपालितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2029623, "chapter_id": 1645, "verse_number": "३-२८३-६४", "content_sanskrit": "कुशलंत्वाब्रवीद्रामःसीते सौमित्रिणा सह।\nसखिभावाच् सुग्रीवः कुशलं त्वाऽनुपृच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2029624, "chapter_id": 1645, "verse_number": "३-२८३-६५", "content_sanskrit": "क्षिप्रमेष्यति ते भर्ता सर्वशाखामृगैः सह।\nप्रत्ययं कुरु मे देवि वानरोऽस्मि न राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2029625, "chapter_id": 1645, "verse_number": "३-२८३-६६", "content_sanskrit": "मुहूर्तमिवच ध्यात्वा सीता मां प्रत्युवाच ह।\nअवैमि त्वांहनूमन्तमविन्ध्यवचनादहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2029626, "chapter_id": 1645, "verse_number": "३-२८३-६७", "content_sanskrit": "अविन्ध्यो हि महाबाहो राक्षसो वृद्धसंमतः।\nकथितस्तेन सुग्रीवस्त्वद्विधैः सचिवैर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2029627, "chapter_id": 1645, "verse_number": "३-२८३-६८", "content_sanskrit": "गम्यतामिति चोक्त्वा मां सीता पादादिमं मणिम्।\nघारिता येन वैदेही कालमेतमनिन्दिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2029628, "chapter_id": 1645, "verse_number": "३-२८३-६९", "content_sanskrit": "प्रत्ययार्थं कथां चेमां कथयामास जानकी।\nक्षिप्तामिषीकां काकाय चित्रकूटे महागिरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2029629, "chapter_id": 1645, "verse_number": "३-२८३-७०", "content_sanskrit": "भवता पुरुषव्याघ्र प्रत्यभिज्ञानकारणात्।\n`एकाक्षिविकलः काकः सुदुष्टात्मा कृतश्चवै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2029630, "chapter_id": 1645, "verse_number": "३-२८३-७१", "content_sanskrit": "ग्राहयित्वाऽहमात्मानं ततो दग्ध्वाच तां पुरीम्।\nसंप्राप्त इतितं रामः प्रियवादिनमार्चयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2029631, "chapter_id": 1645, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वणि त्र्यशीत्यधिकद्विशततमोऽध्यायः ॥ २८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]