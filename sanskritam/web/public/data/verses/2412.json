[{"id": 2067029, "chapter_id": 2412, "verse_number": "९-३०-०x", "content_sanskrit": "`सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2067030, "chapter_id": 2412, "verse_number": "९-३०-१", "content_sanskrit": "मुहूर्तादिव राजेन्द्र सर्वं शून्यमदृश्यत।\nमत्तवारणसंघुष्टं शिबिरं विद्रुते बले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2067031, "chapter_id": 2412, "verse_number": "९-३०-२", "content_sanskrit": "यत्र शब्देन महता नान्वबुध्यन्महारथाः।\nतत्र शब्दं न शृणुमो मनुष्यस्यापि कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2067032, "chapter_id": 2412, "verse_number": "९-३०-३x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2067033, "chapter_id": 2412, "verse_number": "९-३०-३", "content_sanskrit": "हतेषु सर्वसैन्येषु पाण्डुपुत्रै रणाजिरे।\nमामकाश्चावशिष्टास्ते किमकुर्वत सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2067034, "chapter_id": 2412, "verse_number": "९-३०-४", "content_sanskrit": "कृतवर्मा कृपश्चैव द्रोणपुत्रश्च वीर्यवान्।\nदुर्योधनश्च मन्दात्मा राजा किमकरोत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2067035, "chapter_id": 2412, "verse_number": "९-३०-५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2067036, "chapter_id": 2412, "verse_number": "९-३०-५", "content_sanskrit": "सम्प्राद्रुवत्सु दारेषु क्षत्रियाणां महात्मनाम्।\nविद्रुते शिबिरे शून्ये भृशोद्विग्नास्त्रयो रथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2067037, "chapter_id": 2412, "verse_number": "९-३०-६", "content_sanskrit": "निशम्य पाण्डुपुत्राणां तदा वैजयिनां स्वनम्।\nविद्रुतं शिबिरं दृष्ट्वा सायाह्ने राजगृद्विनः।\nस्थानं नारोचयंस्तत्र ततस्ते हदमभ्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2067038, "chapter_id": 2412, "verse_number": "९-३०-७", "content_sanskrit": "युधिष्ठिरोऽपि धर्मात्मा भ्रातृभिः सहितो रणे।\nहृष्टः पर्यपतद्राजन्दुर्योधनवधेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2067039, "chapter_id": 2412, "verse_number": "९-३०-८", "content_sanskrit": "मार्गमाणास्तु सङ्क्रुद्धास्तव पुत्रं जयैषिणः।\nयत्नतोऽन्वेषमाणास्ते नैवापश्यञ्जनाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2067040, "chapter_id": 2412, "verse_number": "९-३०-९", "content_sanskrit": "यदा दुर्योधनो युद्धं त्यक्त्वा पद्भ्यां पराक्रममत्।\nतं हदं प्राविशच्चापि विष्टभ्यापः स्वमायया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2067041, "chapter_id": 2412, "verse_number": "९-३०-१०", "content_sanskrit": "यदा तु पाण्डवाः सर्वे सुपरिश्रान्तवाहनाः।\nततः स्वशिबिरं प्राप्य व्यतिष्ठन्त ससैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2067042, "chapter_id": 2412, "verse_number": "९-३०-११", "content_sanskrit": "ततः कृपश्च द्रौणिश्च कृतवर्मा च सात्वतः।\nसन्निविष्टेषु पार्थेषु प्रययुस्तं हदं शनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2067043, "chapter_id": 2412, "verse_number": "९-३०-१२", "content_sanskrit": "ते तं हदं समासाद्य यत्र शेते जनाधिपः।\nअभ्यभाषन्त दुर्धर्षं राजानं सुप्तमम्भसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2067044, "chapter_id": 2412, "verse_number": "९-३०-१३", "content_sanskrit": "राजन्नुत्तिष्ठ युध्यस्व सहास्माभिर्युधिष्ठिरम्।\nजित्वा वा पृथिवीं भुङ्क्ष्व हतो वा स्वर्गमाप्नुहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2067045, "chapter_id": 2412, "verse_number": "९-३०-१४", "content_sanskrit": "तेषामपि बलं सर्वं हतं दुर्योधन त्वया।\nप्रतिविद्धाश्च भूयिष्ठं ये शिष्टास्तत्र सैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2067046, "chapter_id": 2412, "verse_number": "९-३०-१५", "content_sanskrit": "न ते वेगं विषहितुं शक्तास्तव विशाम्पते।\nअस्माभिरपि गुप्तस्य तस्मादुत्तिष्ठ भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2067047, "chapter_id": 2412, "verse_number": "९-३०-१६x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2067048, "chapter_id": 2412, "verse_number": "९-३०-१६", "content_sanskrit": "दिष्ट्या पश्यामि वो मुक्तानीदृशात्पुरुषक्षयात्।\nपाण्डुकौरवसम्मर्दाज्जीवमानान्नरर्षभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2067049, "chapter_id": 2412, "verse_number": "९-३०-१७", "content_sanskrit": "विजेष्यामो वयं सर्वे विश्रान्ता विगतक्लमाः।\nभवन्तश्च परिश्रान्ता वयं च भृशविक्षताः।\nउदीर्णं च बलं तेषां तेन युद्धं न रोचये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2067050, "chapter_id": 2412, "verse_number": "९-३०-१८", "content_sanskrit": "न त्वेतदद्भुतं वीरा यद्वो महदिदं मनः।\nअस्मासु च परा शक्तिर्न तु कालः पराक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2067051, "chapter_id": 2412, "verse_number": "९-२८-१९", "content_sanskrit": "विश्रम्यैकां निशामद्य भवद्भिः सहितो रणे।\nप्रतियोत्स्याम्यहं शत्रूञ्श्वो न स्याच्च श्रमो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2067052, "chapter_id": 2412, "verse_number": "९-२८-२०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2067053, "chapter_id": 2412, "verse_number": "९-२८-२०", "content_sanskrit": "एवमुक्तोऽब्रवीद्द्रौणी राजानं युद्धदुर्मदम्।\nउत्तिष्ठ राजन्भद्रं ते विजेष्यामो वयं परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2067054, "chapter_id": 2412, "verse_number": "९-२८-२१", "content_sanskrit": "इष्टापूर्तेन दानेन सत्येन च जपेन च।\nशपे राजन्यथा ह्यद्य निहनिष्यामि सोमकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2067055, "chapter_id": 2412, "verse_number": "९-३०-२२", "content_sanskrit": "मा स्म यज्ञकृतां प्रीतिमाप्नुयां सज्जनोचिताम्।\nयदीमां रजनीं व्युष्टां न हि हन्मि परान्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2067056, "chapter_id": 2412, "verse_number": "९-३०-२३", "content_sanskrit": "नाहत्वा सर्वपाञ्चालान्विमोक्ष्ये कवचं विभो।\nउत्तिष्ठ त्वं ब्रवीम्येतत्तन्मे शृणु जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2067057, "chapter_id": 2412, "verse_number": "९-३०-२४", "content_sanskrit": "तेषु सम्बाषमाणेषु व्याधास्तं देशमाययुः।\nमांसभारपरिश्रान्ताः पानीयार्थं यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2067058, "chapter_id": 2412, "verse_number": "९-३०-२५", "content_sanskrit": "ते हि नित्यं महाराज भीमसेनस्य लुब्धकाः।\nमांसभारानुपाजह्नुर्भक्त्या परमया विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2067059, "chapter_id": 2412, "verse_number": "९-३०-२६", "content_sanskrit": "ते तत्र धिष्ठितास्तेषां सर्वं तद्वचनं रहः।\nदुर्योधनवचश्चैव शुश्रुवुः सङ्गता मिथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2067060, "chapter_id": 2412, "verse_number": "९-३०-२७", "content_sanskrit": "तेऽपि सर्वे महेष्वासा अयुद्धार्थिनि कौरवे।\nनिर्बन्धं परमं चक्रुस्तदा वै युद्धकाङ्क्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2067061, "chapter_id": 2412, "verse_number": "९-३०-२८", "content_sanskrit": "तांस्तथा समुदीक्ष्याथ कौरवाणां महारथान्।\nअयुद्धमनसं चैव राजानं स्थितमम्भसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2067062, "chapter_id": 2412, "verse_number": "९-३०-२९", "content_sanskrit": "तेषां श्रुत्वा च संवादं राज्ञश्च सलिले सतः।\nव्याधा ह्यजानन्राजेन्द्र सलिलस्थं सुयोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2067063, "chapter_id": 2412, "verse_number": "९-३०-३०", "content_sanskrit": "ते पूर्वं पाण्डुपुत्रेण पृष्टा ह्यासन्सुतं तव।\nयदृच्छोपगतास्तत्र राजानं परिमार्गता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2067064, "chapter_id": 2412, "verse_number": "९-३०-३१", "content_sanskrit": "ततस्ते पाण्डुपुत्रस्य स्मृत्वा तद्भाषितं तदा।\nअन्योन्यमब्रुवन्राजन्मृगव्याधाः शनैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2067065, "chapter_id": 2412, "verse_number": "९-३०-३२", "content_sanskrit": "दुर्योधनं ख्यापयामो धनं दास्यति पाण्डवः।\nसुव्यक्तमिह नः ख्यातो हदे दुर्योधनोनृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2067066, "chapter_id": 2412, "verse_number": "९-३०-३३", "content_sanskrit": "तस्माद्गच्छामहे सर्वे यत्र राजा युधिष्ठिरः।\nआख्यातुं सलिले सुप्तं दुर्योधनममर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2067067, "chapter_id": 2412, "verse_number": "९-३०-३४", "content_sanskrit": "धृतराष्ट्रात्मजं तस्मै भीमसेनाय धीमते।\nशयानं सलिले सर्वे कथयामो धनुर्भृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2067068, "chapter_id": 2412, "verse_number": "९-३०-३५", "content_sanskrit": "स नो दास्यति सुप्रीतो धनानि बहुलान्युत।\nकिं नो मांसेन शुष्केण परिक्लिष्टेन शोषिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2067069, "chapter_id": 2412, "verse_number": "९-३०-३६", "content_sanskrit": "एवमुक्त्वा तु ते व्याधाः सम्प्रहृष्टा धनार्थिनः।\nमांसभारानुपादाय प्रययुः शिबिरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2067070, "chapter_id": 2412, "verse_number": "९-३०-३७", "content_sanskrit": "पाण़्डवाश्च महाराज लब्धलक्षाः प्रहारिणः।\nअपश्यमानाः समरे दुर्योधनमवस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2067071, "chapter_id": 2412, "verse_number": "९-३०-३८", "content_sanskrit": "निकृतिज्ञस्य पापस्य तस्याभिगमनेप्सया।\nचारान्सम्प्रेषयामासुः समन्तात्तद्रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2067072, "chapter_id": 2412, "verse_number": "९-३०-३९", "content_sanskrit": "आगम्य तु ततः सर्वे नष्टं दुर्योधनं नृपम्।\nन्यवेदयन्त सहिता धर्मराजस्य सैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2067073, "chapter_id": 2412, "verse_number": "९-३०-४०", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा चाराणां भरतर्षभ।\nचिन्तामभ्यगमत्तीव्रां निशश्वास च पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2067074, "chapter_id": 2412, "verse_number": "९-३०-४१", "content_sanskrit": "`अरिशेषे जीवति तु सन्दिग्धो विजयो भवेत्।\nराज्यं लभे कथं तद्वि पूजितं विजयादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2067075, "chapter_id": 2412, "verse_number": "९-३०-४२", "content_sanskrit": "अथ स्थितानां पाण्डूनां दीनानां भरतर्षभ।\nतस्माद्देशादपक्रम्य त्वरिता लुब्धका विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2067076, "chapter_id": 2412, "verse_number": "९-३०-४३", "content_sanskrit": "आजग्मुः शिबिरं हृष्टा दृष्ट्वा दुर्योधनं नृपम्।\nवार्यमाणाः प्रविष्टाश्च भीमसेनस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2067077, "chapter_id": 2412, "verse_number": "९-३०-४४", "content_sanskrit": "ते तु पाण्डवमासाद्य भीमसेनं महाबलम्।\nतस्मै तत्सर्वमाचख्युर्यद्वृत्तं यच्च वै श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2067078, "chapter_id": 2412, "verse_number": "९-३०-४५", "content_sanskrit": "ततो वृकोदरो राजन्दत्त्वा तेषां धनं बहु।\nधर्मराजाय तत्सर्वमाचचक्षे परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2067079, "chapter_id": 2412, "verse_number": "९-३०-४६", "content_sanskrit": "असौ दुर्योधनो राजन्विज्ञातो मम लुब्धकैः।\nसंस्तभ्य सलिलं शेते यस्यार्थे परितप्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2067080, "chapter_id": 2412, "verse_number": "९-३०-४७", "content_sanskrit": "तद्वचो भीमसेनस्य प्रियं श्रुत्वा विशाम्पते।\nअजातशत्रुः कौन्तेयो हृष्टोऽभूत्सह सोदरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2067081, "chapter_id": 2412, "verse_number": "९-३०-४८", "content_sanskrit": "तं च श्रुत्वा महेष्वासं प्रविष्टं सलिलहदे।\nक्षिप्रमेव ततोऽगच्छन्पुरस्कृत्य जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2067082, "chapter_id": 2412, "verse_number": "९-३०-४९", "content_sanskrit": "ततः किलकिलाशब्दः प्रादुरासीद्विशाम्पते।\nपाण्डवानां प्रहृष्टानां पाञ्चालानां च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2067083, "chapter_id": 2412, "verse_number": "९-३०-५०", "content_sanskrit": "सिंहनादांस्ततश्चक्रुः क्ष्वेडाश्च भरतर्षभ।\nत्वरिताः क्षत्रिया राजन्नुदक्रोशन्परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2067084, "chapter_id": 2412, "verse_number": "९-३०-५१", "content_sanskrit": "ज्ञातः पापो धार्तराष्ट्रो दृष्टश्चेत्यसकृद्रणे।\nप्राक्रोशन्सोमकास्तत्र हृष्टरूपाः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2067085, "chapter_id": 2412, "verse_number": "९-३०-५२", "content_sanskrit": "तेषामाशु प्रयातानां रथानां तत्र वेगिनाम्।\nवभूव तुमुलः शब्दो दिवस्पृक् पृथिवीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2067086, "chapter_id": 2412, "verse_number": "९-३०-५३", "content_sanskrit": "दुर्योधनं परीप्सन्तस्तत्रतत्र युधिष्ठिरम्।\nअन्वयुस्त्वरितास्ते वै राजानं श्रान्तवाहनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2067087, "chapter_id": 2412, "verse_number": "९-३०-५४", "content_sanskrit": "अर्जुनो भीमसेनश्च माद्रीपुत्रौ च पाण्डवौ।\nधृष्टद्युम्नश्च पाञ्चाल्यः शिखण्डी चापराजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2067088, "chapter_id": 2412, "verse_number": "९-३०-५५", "content_sanskrit": "उत्तमौजा युधामन्युः सात्यकिश्च महारथः।\nपाञ्चालानां च ये शिष्टा द्रौपदेयाश्च भारत।\nहयाश्च सर्वे नागाश्च शतशश्च पदातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2067089, "chapter_id": 2412, "verse_number": "९-३०-५६", "content_sanskrit": "ततः प्राप्तो महाराज धर्मराजः प्रतापवान्।\nद्वैपायनहदं घोरं यत्र दुर्योधनोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2067090, "chapter_id": 2412, "verse_number": "९-३०-५७", "content_sanskrit": "शीतामलजलं हृद्यं द्वितीयमिव सागरम्।\nमायया सलिलं स्तभ्य यत्राभूत्ते स्थितः सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2067091, "chapter_id": 2412, "verse_number": "९-३०-५८", "content_sanskrit": "अत्यद्भुतेन विधिना दैवयोगेन भारत।\nसलिलान्तर्गतः शेते दुर्दर्शः कस्यचित्प्रभो।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2067092, "chapter_id": 2412, "verse_number": "९-३०-५९", "content_sanskrit": "मानुषस्य मनुष्येन्द्र गदाहस्तो जनाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2067093, "chapter_id": 2412, "verse_number": "९-३०-५९", "content_sanskrit": "ततो दुर्योधनो राजा सलिलान्तर्गतो वसन्।\nशुश्रुवे तुमुलं शब्दं जलदोपमनिःस्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2067094, "chapter_id": 2412, "verse_number": "९-३०-६०", "content_sanskrit": "युधिष्ठिरश्च राजेन्द्र तं हदं सह सोदरैः।\nआजगाम महाराज तव पुत्रवधाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2067095, "chapter_id": 2412, "verse_number": "९-३०-६१", "content_sanskrit": "महता शङ्खनादेन रथनेमिस्वनेन च।\nऊर्ध्वं धुन्वन्महारेणुं कम्पयंश्चापि मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2067096, "chapter_id": 2412, "verse_number": "९-३०-६२", "content_sanskrit": "यौधिष्ठिरस्य सैन्यस्य श्रुत्वा शब्दं महारथाः।\nकृतवर्मा कृपो द्रौणी राजानमिदमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2067097, "chapter_id": 2412, "verse_number": "९-३०-६३", "content_sanskrit": "इमे ह्यायान्ति संहृष्टाः पाण्डवा जितकाशिनः।\nअपयास्यामहे तावदनुजानातु नो भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2067098, "chapter_id": 2412, "verse_number": "९-३०-६४", "content_sanskrit": "दुर्योधनस्तु तच्छ्रुत्वा तेषां तत्र तरस्विनाम्।\nतथेत्युक्त्वा हदं तं वै माययाऽस्तम्भयत्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2067099, "chapter_id": 2412, "verse_number": "९-३०-६५", "content_sanskrit": "ते त्वनुज्ञाप्य राजानं भृशं शोकपरायणाः।\nजग्मुर्दूरे महाराज कृपप्रभृतयो रथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2067100, "chapter_id": 2412, "verse_number": "९-३०-६६", "content_sanskrit": "ते गत्वा दूरमध्वानं न्यग्रोधं प्रेक्ष्य मारिष।\nन्यविशन्त भृशं श्रान्ताश्चिन्तयन्तो नृपं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2067101, "chapter_id": 2412, "verse_number": "९-३०-६७", "content_sanskrit": "विष्टभ्य सलिलं सुप्तो धार्तराष्ट्रो महाबलः।\nपाण्डवाश्चापि सम्प्राप्तास्तं देशं युद्धमीप्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2067102, "chapter_id": 2412, "verse_number": "९-३०-६८", "content_sanskrit": "कथं नु युद्धं भविता कथं राजा भविष्यति।\nकथं नु पाण्डवा राजन्प्रतिपत्स्यन्ति कौरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2067103, "chapter_id": 2412, "verse_number": "९-३०-६९", "content_sanskrit": "इत्येवं चिन्तयानास्तु रथेभ्योऽश्वान्विमुच्य ते।\nतत्रासाञ्चक्रिरे राजन्कृपप्रभृतयो रथाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2067104, "chapter_id": 2412, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि अष्टादशदिवसयुद्धे त्रिंशोऽध्यायः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]