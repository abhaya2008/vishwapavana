[{"id": 2138459, "chapter_id": 3998, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2138460, "chapter_id": 3998, "verse_number": "१", "content_sanskrit": "ततः पावकमुज्ज्वाल्य मन्त्रहव्यपुरस्कृतम्\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2138461, "chapter_id": 3998, "verse_number": "२", "content_sanskrit": "तेऽग्निं प्रदक्षिणं कृत्वा ब्राह्मणं च पुरोहितम् ।\nअभिवाद्य ततः सर्वे प्राद्रवन् सह कृष्णया\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2138462, "chapter_id": 3998, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2138463, "chapter_id": 3998, "verse_number": "३", "content_sanskrit": "अनुशिष्टोऽस्मि भद्रं ते नैतद् वक्ताऽस्ति कश्चन ।\nकुन्तीमृते मातरं नः विदुरं च महामतिम्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2138464, "chapter_id": 3998, "verse_number": "४", "content_sanskrit": "यदेवानन्तरं कार्यं तद् भवान् कर्तुमर्हति ।\nतारणाय सुदुःखस्य प्रस्थानायाभयाय च\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2138465, "chapter_id": 3998, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2138466, "chapter_id": 3998, "verse_number": "५", "content_sanskrit": "तेषां प्रतिष्ठमानानां धौम्यो मन्त्रानथाजपत् ।\nसर्वविघ्नप्रशमनान् अर्थसिद्धिकरांस्तथा\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2138467, "chapter_id": 3998, "verse_number": "६", "content_sanskrit": "याज्ञसेनीं पुरस्कृत्य सर्व एव महारथाः ।\nप्राद्रवन् सह धौम्येन बद्धशस्त्रा वनाद् वनम्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2138468, "chapter_id": 3998, "verse_number": "७", "content_sanskrit": "ते वीरा बद्धनिस्त्रिंशा धनुर्बाणकलापिनः ।\nअगच्छन् भीमधन्वानः काम्यकाद् यमुनां नदीम्\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2138469, "chapter_id": 3998, "verse_number": "८", "content_sanskrit": "उत्तरेण दशार्णानां पाञ्चालान् दक्षिणेन तु ।\nअन्तरेण यकृल्लोमान् शूरसेनांश्च पाण्डवाः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2138470, "chapter_id": 3998, "verse_number": "९", "content_sanskrit": "काळिन्दीदक्षिणं तीरमन्वगच्छन् पदातयः ।\nततः प्रत्यक्प्रयातास्ते सङ्क्रामन्तो वनाद् वनम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2138471, "chapter_id": 3998, "verse_number": "१०", "content_sanskrit": "वसाना वनदुर्गेषु रमणीयेषु धन्विनः ।\nपल्वलेषु च रम्येषु नदीनां सङ्गमेषु च\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2138472, "chapter_id": 3998, "verse_number": "११", "content_sanskrit": "द्रुमान् नानाविधाकारान् नानाविधलताकुलान् ।\nकुसुमाढ्यान् मनःकान्तान् शुभगन्धान् मनोरमान्\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2138473, "chapter_id": 3998, "verse_number": "१२", "content_sanskrit": "पार्था निरीक्षमाणाश्च तान् द्रुमान् पुष्पशालिनः ।\nजिघ्रन्तः पुष्पगन्धांश्च सुसुगन्धान् मनोरमान्\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2138474, "chapter_id": 3998, "verse_number": "१३", "content_sanskrit": "विध्यन्तो मृगजातानि महेष्वासा महाबलाः ।\nउषित्वा द्वादश समा वने परपुरञ्जयाः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2138475, "chapter_id": 3998, "verse_number": "१४", "content_sanskrit": "लुब्धान् ब्रुवाणा मात्स्यस्य विषयं प्राविशंस्तदा\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2138476, "chapter_id": 3998, "verse_number": "१५", "content_sanskrit": "तत्र धौम्यं महात्मानं पाण्डवेया व्यसर्जयन् ।\nअग्निहोत्रं परिचरन् सोऽबुद्धोऽवसदाश्रये\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2138477, "chapter_id": 3998, "verse_number": "१६", "content_sanskrit": "ततो जनपदं प्राप्य कृष्णा राजानमब्रवीत्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2138478, "chapter_id": 3998, "verse_number": "१७", "content_sanskrit": "पश्यैकपद्यो दृश्यन्ते क्षेत्रे गोष्ठं समावृताः ।\nवृक्षांश्चोपवनोपेतान् ग्रामाणां नगरस्य च\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2138479, "chapter_id": 3998, "verse_number": "१८", "content_sanskrit": "व्यक्तं दूरे विराटस्य राजधानी भविष्यति ।\nवसामेहापरां रात्रिं बलवान् मे परिश्रमः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2138480, "chapter_id": 3998, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2138481, "chapter_id": 3998, "verse_number": "१९", "content_sanskrit": "इमां कमलपत्राक्षीं द्रौपदीं माद्रिनन्दन ।\nबाहुभ्यां नकुलादाय मुहूर्तं द्रौपदीं नय\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2138482, "chapter_id": 3998, "verse_number": "२०", "content_sanskrit": "ततोऽदूरे विराटस्य नगरं भरतर्षभ ।\nराजधान्यां निवत्स्यामः सुमुक्तमिव नो वनम्\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2138483, "chapter_id": 3998, "verse_number": "", "content_sanskrit": "नकुलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2138484, "chapter_id": 3998, "verse_number": "२१", "content_sanskrit": "पूर्वाह्ने मृगयां गत्वा वने विद्धा महामृगाः ।\nअटवी च मया दूरं सृता मृगवधेप्सया\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2138485, "chapter_id": 3998, "verse_number": "२२", "content_sanskrit": "विषमा ह्यतिदुर्गा च वेगवत् परिधावता ।\nसोऽहं घर्माभितप्तो वै नैनामादातुमुत्सहे\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2138486, "chapter_id": 3998, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2138487, "chapter_id": 3998, "verse_number": "२३", "content_sanskrit": "सहदेव त्वमादाय मुहूर्तं द्रौपदीं नय ।\nराजधान्यां निवत्स्यामः सुमुक्तमिव नो वनम्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2138488, "chapter_id": 3998, "verse_number": "", "content_sanskrit": "सहदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2138489, "chapter_id": 3998, "verse_number": "२४", "content_sanskrit": "अहमप्यस्मि तृषितः क्षुधया च प्रपीडितः ।\nपरिश्रान्तश्च भद्रं ते नैनामादातुमुत्सहे\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2138490, "chapter_id": 3998, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2138491, "chapter_id": 3998, "verse_number": "२५", "content_sanskrit": "एहि वीर विशालाक्ष वीरसिंह इवार्जुन\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2138492, "chapter_id": 3998, "verse_number": "२६", "content_sanskrit": "इमां कमलपत्राक्षीं द्रौपदीं द्रुपदात्मजाम् ।\nपरिगृह्य मुहूर्तं त्वं बाहुभ्यां कुशलं व्रज\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2138493, "chapter_id": 3998, "verse_number": "२७", "content_sanskrit": "राजधान्यां निवत्स्यामः सुमुक्तमिव नो वनम्\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2138494, "chapter_id": 3998, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2138495, "chapter_id": 3998, "verse_number": "२८", "content_sanskrit": "गुरोर्वचनमाज्ञाय सम्प्रहृष्टो धनञ्जयः ।\nतामादायार्जुनस्तूर्णं शार्दूलः पृषतीमिव\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2138496, "chapter_id": 3998, "verse_number": "२९", "content_sanskrit": "प्रवव्राज महाबाहुरर्जुनः प्रियदर्शनः ।\nजटिलो वल्कलधरः शरतूणीधनुर्धरः\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2138497, "chapter_id": 3998, "verse_number": "३०", "content_sanskrit": "स्कन्धे कृत्वा वरारोहां बालामायतलोचनाम् ।\nआनीय नगराभ्यामवातारायदर्जुनः\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2138498, "chapter_id": 3998, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां विराटपर्वणि षष्ठोऽध्यायः ॥६॥\nवैराटपर्वणि षष्ठोऽध्यायः ॥६॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]