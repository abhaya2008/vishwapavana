[{"id": 2002683, "chapter_id": 1060, "verse_number": "१-६१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002684, "chapter_id": 1060, "verse_number": "१-६१-१", "content_sanskrit": "शृणु राजन्यथा वीरा भ्रातरः पञ्च पाण्डवाः।\nविरोधमन्वगच्छन्त धार्तराष्ट्रैर्दुरात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002685, "chapter_id": 1060, "verse_number": "१-६१-२", "content_sanskrit": "गुरवे प्राङ्नमस्कृत्य मनोबुद्धिसमाधिभिः।\nसंपूज्य च द्विजान्सर्वांस्तथान्यान्विदुषो जनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002686, "chapter_id": 1060, "verse_number": "१-६१-३", "content_sanskrit": "महर्षेर्विश्रुतस्येह सर्वलोकेषु धीमतः।\nप्रवक्ष्यामि मतं कृत्स्नं व्यासस्यामिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002687, "chapter_id": 1060, "verse_number": "१-६१-४", "content_sanskrit": "श्रोतुं पात्रं च राजंस्त्वं प्राप्येमां भारतीं कथाम्।\nगुरोर्वक्त्रपरिस्पन्दो मनः प्रोत्साहतीव मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002688, "chapter_id": 1060, "verse_number": "१-६१-५", "content_sanskrit": "शृणु राजन्यथा भेदः कुरुपाण्डवयोरभूत्।\nराज्यार्थे द्यूतसंभूतो वनवासस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002689, "chapter_id": 1060, "verse_number": "१-६१-६", "content_sanskrit": "यथा च युद्धमभवत्पृथिवीक्षयकारकम्।\nतत्तेऽहं कथयिष्यामि पृच्छते भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002690, "chapter_id": 1060, "verse_number": "१-६१-७", "content_sanskrit": "मृते पितरि ते वीरा वनादेत्य स्वमन्दिरम्।\nनचिरादेव विद्वांसो वेदे धनुषि चाभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002691, "chapter_id": 1060, "verse_number": "१-६१-८", "content_sanskrit": "तांस्तथा सत्ववीर्यौजःसंपन्नान्पौरसंमतान्।\nनामृष्यन्कुरवो दृष्ट्वा पाण्डवाञ्श्रीयशोभृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002692, "chapter_id": 1060, "verse_number": "१-६१-९", "content_sanskrit": "ततो दुर्योधनः क्रूरः कर्णश्च सहसौबलः।\nतेषां निग्रहनिर्वासान्विविधांस्ते समारभन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002693, "chapter_id": 1060, "verse_number": "१-६१-१०", "content_sanskrit": "ततो दुर्योधनः क्रूरः कुलिङ्गस्य मते स्थितः।\nपाम्डवान्विविधोपायै राज्यहेतोरपीडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002694, "chapter_id": 1060, "verse_number": "१-६१-११", "content_sanskrit": "ददावथ विषं पापो भीमाय धृतराष्ट्रजः।\nजरयामास तद्वीरः सहान्नेन वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002695, "chapter_id": 1060, "verse_number": "१-६१-१२", "content_sanskrit": "प्रमाणकोट्यां संसुप्तं पुनर्बद्ध्वा वृकोदरम्।\nतोयेषु भीमं गङ्गायाः प्रक्षिप्य पुरमाव्रजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002696, "chapter_id": 1060, "verse_number": "१-६१-१३", "content_sanskrit": "यदा विबुद्धः कौन्तेयस्तदा संछिद्य बन्धनम्।\nउदतिष्ठन्महाबाहुर्भीमसेनो गतव्यथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002697, "chapter_id": 1060, "verse_number": "१-६१-१४", "content_sanskrit": "आशीविषैः कृष्णसर्पैः सुप्तं चैनमदंशयत्।\nसर्वेष्वेवाङ्गदेशेषु न ममार स शत्रुहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002698, "chapter_id": 1060, "verse_number": "१-६१-१५", "content_sanskrit": "तेषां तु विप्रकारेषु तेषु तेषु महामतिः।\nमोक्षणे प्रतिकारे च विदुरोऽवहितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002699, "chapter_id": 1060, "verse_number": "१-६१-१६", "content_sanskrit": "स्वर्गस्थो जीवलोकस्य यथा शक्रः सुखावहः।\nपाण्डवानां तथा नित्यं विदुरोऽपि सुखावहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002700, "chapter_id": 1060, "verse_number": "१-६१-१७", "content_sanskrit": "यदा तु विविधोपायैः संवृतैर्विवृतैरपि।\nनाशकद्विनिहन्तुं तान्दैवभाव्यर्थरक्षितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002701, "chapter_id": 1060, "verse_number": "१-६१-१८", "content_sanskrit": "ततः संमन्त्र्य सचिवैर्वृषदुःशासनादिभिः।\nधृतराष्ट्रमनुज्ञाप्य जातुषं गृहमादिशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002702, "chapter_id": 1060, "verse_number": "१-६१-१९", "content_sanskrit": "तत्र तान्वासयामास पाण्डवानमितौजसः।\nसुतप्रियैषी तान्राजा पाण्डवानम्बिकासुतः।\nततो विवासयामास राज्यभोगबुभुक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002703, "chapter_id": 1060, "verse_number": "१-६१-२०", "content_sanskrit": "ते प्रातिष्ठन्त सहिता नगरान्नागसाह्वयात्।\nप्रस्थाने चाभवन्मन्त्री क्षत्ता तेषां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002704, "chapter_id": 1060, "verse_number": "१-६१-२१", "content_sanskrit": "तेन मुक्ता जतुगृहान्निशीथे प्राद्रवन्वनम्।\nततः संप्राप्य कौन्तेया नगरं वारणावतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002705, "chapter_id": 1060, "verse_number": "१-६१-२२", "content_sanskrit": "न्यवसन्त महात्मानो मात्रा सह परन्तपाः।\nधृतराष्ट्रेण चाज्ञप्ता उषिता जातुषे गृहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002706, "chapter_id": 1060, "verse_number": "१-६१-२३", "content_sanskrit": "पुरोचनाद्रक्षमाणाः संवत्सरमतन्द्रिताः।\nसुरुङ्गां कारयित्वा तु विदुरेण प्रचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002707, "chapter_id": 1060, "verse_number": "१-६१-२४", "content_sanskrit": "आदीप्य जातुषं वेश्म दग्ध्वा चैव पुरोचनम्।\nप्राद्रवन्भयसंविग्ना मात्रा सह पन्तपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002708, "chapter_id": 1060, "verse_number": "१-६१-२५", "content_sanskrit": "ददृशुर्दारुमं रक्षो हिडिम्बं वननिर्झरे।\nहत्वा च तं राक्षसेन्द्रं भीताः समवबोधनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002709, "chapter_id": 1060, "verse_number": "१-६१-२६", "content_sanskrit": "निशि संप्राद्रवन्पार्था धार्तराष्ट्रभयार्दिताः।\nप्राप्ता हिडिम्बा भीमेन यत्र जातो घटोत्कचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2002710, "chapter_id": 1060, "verse_number": "१-६१-२७", "content_sanskrit": "एकचक्रां ततो हत्वा पाण्डवाः संशितव्रताः।\nवेदाध्ययनसंपन्नास्तेऽभवन्ब्रह्मचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2002711, "chapter_id": 1060, "verse_number": "१-६१-२८", "content_sanskrit": "ते तत्र नियताः कालं कंचिदूषुर्नरर्षभाः।\nमात्रा सहैकचक्रायां ब्राह्मणस्य निवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2002712, "chapter_id": 1060, "verse_number": "१-६१-२९", "content_sanskrit": "तत्राससाद क्षुधितं पुरुषादं वृकोदरः।\nभीमसेनो महाबाहुर्बकं नाम महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2002713, "chapter_id": 1060, "verse_number": "१-६१-३०", "content_sanskrit": "तं चापि पुरुषव्याघ्रो बाहुवीर्येण पाण्डवः।\nनिहत्य तरसा वीरो नागरान्पर्यसान्त्वयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2002714, "chapter_id": 1060, "verse_number": "१-६१-३१", "content_sanskrit": "ततस्ते शुश्रुवुः कृष्णां पञ्चालेषु स्वयंवराम्।\nश्रुत्वा चैवाभ्यगच्छ्त गत्वा चैवालभन्त ताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2002715, "chapter_id": 1060, "verse_number": "१-६१-३२", "content_sanskrit": "ते तत्र द्रौपदीं लब्ध्वा परिसंवत्सरोषिताः।\nविदिता हास्तिनपुरं प्रत्याजग्मुररिन्दमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2002716, "chapter_id": 1060, "verse_number": "१-६१-३३", "content_sanskrit": "ते उक्ता धृतराष्ट्रेण राज्ञा शान्तनवेन च।\nभ्रातृभिर्विग्रहस्तात कथं वो न भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2002717, "chapter_id": 1060, "verse_number": "१-६१-३४", "content_sanskrit": "अस्माभिः खाण्डवप्रस्थे युष्मद्वासोऽनुचिन्तितः।\nतस्माज्जनपदोपेतं सुविभक्तमहापथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2002718, "chapter_id": 1060, "verse_number": "१-६१-३५", "content_sanskrit": "वासाय स्वाण्डवप्रस्थं व्रजध्वं गतमत्सराः।\nतयोस्ते वचनाज्जग्मुः सह सर्वैः सुहृज्जनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2002719, "chapter_id": 1060, "verse_number": "१-६१-३६", "content_sanskrit": "नगरं खाण्डवप्रस्थं रत्नान्यादाय सर्वशः।\nतत्र ते न्यवसन्पार्थाः संवत्सरगणांन्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2002720, "chapter_id": 1060, "verse_number": "१-६१-३७", "content_sanskrit": "वशे शस्त्रप्रतापेन कुर्वन्तोऽन्यान्महीभृतः।\nएवं धर्मप्रधानास्ते सत्यव्रतपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2002721, "chapter_id": 1060, "verse_number": "१-६१-३८", "content_sanskrit": "अप्रमत्तोत्थिताः क्षान्ताः प्रतपन्तोऽहितान्बहून्।\nअजयद्भीमसेनस्तु दिशं प्राचीं महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2002722, "chapter_id": 1060, "verse_number": "१-६१-३९", "content_sanskrit": "उदीचीमर्जुनो वीरः प्रतीचीं नकुलस्तथा।\nदक्षिणां सहदेवस्तु विजिग्ये परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2002723, "chapter_id": 1060, "verse_number": "१-६१-४०", "content_sanskrit": "एवं चक्रुरिमां सर्वे वशे कृत्स्नां वसुन्धराम्।\nपञ्चभिः सूर्यसङ्काशैः सूर्येण च विराजता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2002724, "chapter_id": 1060, "verse_number": "१-६१-४१", "content_sanskrit": "षट्सूर्येवाभवत्पृथ्वी पाण्डवैः सत्यविक्रमैः।\nततो निमित्ते कस्मिंश्चिद्धर्मराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2002725, "chapter_id": 1060, "verse_number": "१-६१-४२", "content_sanskrit": "वनं प्रस्थापयामास तेजस्वी सत्यविक्रमः।\nप्राणेभ्योऽपि प्रियतरं भ्रातरं सव्यसाचिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2002726, "chapter_id": 1060, "verse_number": "१-६१-४३", "content_sanskrit": "अर्जुनं पुरुषव्याघ्रं स्थिरात्मानं गुणैर्युतम्।\nस वै संवत्सरं पूर्णं मासं चैकं वने वसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2002727, "chapter_id": 1060, "verse_number": "१-६१-४४", "content_sanskrit": "तीर्थयात्रां च कृतवान्नागकन्यामवाप च।\nपाण्ड्यस्य तनयां लब्ध्वा तत्र ताभ्यांसहोषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2002728, "chapter_id": 1060, "verse_number": "१-६१-४५", "content_sanskrit": "ततोऽगच्छद्धृषीकेशं द्वारवत्यां कदाचन।\nलब्धवांस्तत्र बीभत्सुर्भार्यां राजीवलोचनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2002729, "chapter_id": 1060, "verse_number": "१-६१-४६", "content_sanskrit": "अनुजां वासुदेवस्य सुभद्रां भद्रभाषिणीम्।\nसा शचीव महेन्द्रेण श्रीः कृष्णेनेव सङ्गता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2002730, "chapter_id": 1060, "verse_number": "१-६१-४७", "content_sanskrit": "सुभद्रा युयुजे प्रीत्या पाण्डवेनार्जुनेन ह।\nअतर्पयच्च कौन्तेयः खाण्डवे हव्यवाहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2002731, "chapter_id": 1060, "verse_number": "१-६१-४८", "content_sanskrit": "बीभत्सुर्वासुदेवेन सहितो नृपस्तम।\nनातिभारो हि पार्थस्य केशवेन सहाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2002732, "chapter_id": 1060, "verse_number": "१-६१-४९", "content_sanskrit": "व्यवसायसहायस्य विष्णोः शत्रुवधेष्विव।\nपार्थायाग्निर्ददौ चापि गाण्डीवं धनुरुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2002733, "chapter_id": 1060, "verse_number": "१-६१-५०", "content_sanskrit": "इषुधी चाक्षयैर्बाणै रथं च कपिलक्षणम्।\nमोक्षयामास बीभत्सुर्मयं यत्र महासुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2002734, "chapter_id": 1060, "verse_number": "१-६१-५१", "content_sanskrit": "स चकार सभां दिव्यां सर्वरत्नसमाचिताम्।\nतस्यां दुर्योधनो मन्दो लोभं चक्रे सुदुर्मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2002735, "chapter_id": 1060, "verse_number": "१-६१-५२", "content_sanskrit": "ततोऽक्षैर्वञ्चयित्वा च सौबलेन युधिष्ठिरम्।\nवनं प्रस्थापयामास सप्तवर्षाणि पञ्च च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2002736, "chapter_id": 1060, "verse_number": "१-६१-५३", "content_sanskrit": "अज्ञातमेकं राष्ट्रे च ततो वर्षं त्रयोदशम्।\nततश्चतुर्दशे वर्षे याचमानाः स्वकं वसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2002737, "chapter_id": 1060, "verse_number": "१-६१-५४", "content_sanskrit": "नालभन्त महाराज ततो युद्धमवर्तत।\nततस्ते क्षत्रमुत्साद्य हत्वा दुर्योधनं नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2002738, "chapter_id": 1060, "verse_number": "१-६१-५५", "content_sanskrit": "राज्यं विहतभूयिष्ठं प्रत्यपद्यन्त पाण्डवाः।\nइष्ट्वा क्रतूंश्च विविधानश्वमेधादिकान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2002739, "chapter_id": 1060, "verse_number": "१-६१-५६", "content_sanskrit": "धृतराष्ट्रे गते स्वर्गं विदुरे पञ्चतां गते।\nगमयित्वा क्रियां स्वर्ग्यां राज्ञाममिततेजसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2002740, "chapter_id": 1060, "verse_number": "१-६१-५७", "content_sanskrit": "स्वं धाम याते वार्ष्णेये कृष्णदारान्प्ररक्ष्य च।\nमहाप्रस्थानिकं कृत्वा गताः स्वर्गमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2002741, "chapter_id": 1060, "verse_number": "१-६१-५८", "content_sanskrit": "एवमेतत्पुरावृत्तं तेषामक्लिष्टकर्मणाम्।\nभेदो राज्यविनाशश्च जयश्च जयतांवर॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2002742, "chapter_id": 1060, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि अंशावतरणपर्वणि एकषष्टितमोऽध्यायः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]