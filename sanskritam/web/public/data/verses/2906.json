[{"id": 2089058, "chapter_id": 2906, "verse_number": "१३-३६-१", "content_sanskrit": "`युधिष्ठिर उवाच।\nचित्तं मे दूयते तात लोके परमविन्दतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2089059, "chapter_id": 2906, "verse_number": "१३-३६-२", "content_sanskrit": "अशाश्वतमिदं सर्वं जगत्स्थावरजङ्गमम्।\nक्रते नारायणं पुण्यं प्रतिभाति पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2089060, "chapter_id": 2906, "verse_number": "१३-३६-३", "content_sanskrit": "नारायणो हि विश्वात्मा पुरुषः पुष्करेक्षणः।\nतस्यास्य देवकीसूनोः श्रुतं कृत्स्नं त्वयाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2089061, "chapter_id": 2906, "verse_number": "१३-३६-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2089062, "chapter_id": 2906, "verse_number": "१३-३६-४", "content_sanskrit": "युधिष्ठिर महाप्राज्ञ मया दृष्टं च सङ्गरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2089063, "chapter_id": 2906, "verse_number": "१३-३६-५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2089064, "chapter_id": 2906, "verse_number": "१३-३६-५", "content_sanskrit": "त्वत्त एव तु राजेन्द्र राजधर्माश्च पुष्कलाः।\nश्रुतं पुराणमखिलं नारदेन निवेदितम्।\nगुह्यं नारायणाख्यानं त्रिविधक्लेशनाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2089065, "chapter_id": 2906, "verse_number": "१३-३६-६", "content_sanskrit": "एकान्तिधर्मनियमाः समासव्यासकल्पिताः।\nकथिता वै महाभाग त्वया वै मदनुग्रहात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2089066, "chapter_id": 2906, "verse_number": "१३-३६-७", "content_sanskrit": "लोकरक्षणकर्तृत्वं तस्यैव हरिमेधसः।\nआतिथेयविधिश्चैव तपांसि नियमाश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2089067, "chapter_id": 2906, "verse_number": "१३-३६-८", "content_sanskrit": "वेदवादप्रसिद्धाश्च वाजपेयादयो मखाः।\nयज्ञा द्रविणनिष्पाद्या अग्निहोत्रानुपालिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2089068, "chapter_id": 2906, "verse_number": "१३-३६-९", "content_sanskrit": "जपयज्ञाश्च विविधा ब्राह्मणानां तपस्विनाम्।\nएकादशविधाः प्रोक्ता हविर्यज्ञा द्विजातिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2089069, "chapter_id": 2906, "verse_number": "१३-३६-१०", "content_sanskrit": "तेषां फलविशेषाश्च उञ्छधर्मास्तथैव च।\nअहन्यहनि ये प्रोक्ता महायज्ञा द्विजातिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2089070, "chapter_id": 2906, "verse_number": "१३-३६-११", "content_sanskrit": "वेदश्रवणधर्माश्च ब्रह्मयज्ञफलं तथा।\nवेदव्रतविधानं च नियमाश्चैव वैदिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2089071, "chapter_id": 2906, "verse_number": "१३-३६-१२", "content_sanskrit": "स्वाहा स्वधा प्रणीते च इष्टापूर्तफलं तथा।\nउत्तरोत्तरसेवायामाश्रमाणां च यत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2089072, "chapter_id": 2906, "verse_number": "१३-३६-१३", "content_sanskrit": "प्रत्येकशश्च निष्ठायामाश्रमाणां महामते।\nमासपक्षोपवासानां सम्यगुक्तफलं च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2089073, "chapter_id": 2906, "verse_number": "१३-३६-१४", "content_sanskrit": "अनाशितानां ये लोका ये च पञ्चतपा नराः।\nवीराध्वानं प्रपन्नानां या गतिश्चाग्निहोत्रिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2089074, "chapter_id": 2906, "verse_number": "१३-३६-१५", "content_sanskrit": "ग्रीष्मे पञ्चतपानां च शिशिरे जलचारिणाम्।\nवर्षे स्थण्डिलशायीनां फलं यत्परिकीर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2089075, "chapter_id": 2906, "verse_number": "१३-३६-१६", "content_sanskrit": "लोके चक्रचराणां च द्विजानां यत्फलं स्मृतम्।\nअन्नादीनां च दानानां यत्फलं परिकीर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2089076, "chapter_id": 2906, "verse_number": "१३-३६-१७", "content_sanskrit": "सर्वतीर्थाभिषिक्तानां नराणां च फलोदयः।\nराज्ञां धर्माश्च ये लोके सम्यक्पालयतां प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2089077, "chapter_id": 2906, "verse_number": "१३-३६-१८", "content_sanskrit": "ये च सत्यव्रता लोके ये तीर्थे कृतश्रमाः।\nमातापितृपरा ये च गुरुवृत्तीश्च संश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2089078, "chapter_id": 2906, "verse_number": "१३-३६-१९", "content_sanskrit": "गोब्राह्मणपरित्राणे राष्ट्रातिक्रमणे तथा।\nत्यजन्त्यभिमुखाः प्राणान्निर्भयाः सत्वमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2089079, "chapter_id": 2906, "verse_number": "१३-३६-२०", "content_sanskrit": "सहस्रदक्षिणानां च या गतिर्वदनां वर।\nये च संध्यामुपासन्ते सम्यगुक्ता महाव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2089080, "chapter_id": 2906, "verse_number": "१३-३६-२१", "content_sanskrit": "तथा योगविधानं च यद्ग्रन्थेष्वभिशब्दितम्।\nवेदाद्याः श्रुतयश्चापि श्रुता मे गुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2089081, "chapter_id": 2906, "verse_number": "१३-३६-२२", "content_sanskrit": "सिद्धान्तनिर्णयाश्चापि द्वैपायनमुखोद्गताः।\nश्रुताः पञ्च महायज्ञा येषु सर्वं प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2089082, "chapter_id": 2906, "verse_number": "१३-३६-२३", "content_sanskrit": "तत्प्रभेदेषु ये धर्मास्तेऽपि वै कृत्स्नशः श्रुताः।\nन च दूषयितुं शक्याः सद्भिरुक्ता हि ते तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2089083, "chapter_id": 2906, "verse_number": "१३-३६-२४", "content_sanskrit": "एतेषां किल धर्माणामुत्तमो वैष्णवो विधिः।\nरक्षते भगवान्विष्णुर्भक्तमात्मशरीरवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2089084, "chapter_id": 2906, "verse_number": "१३-३६-२५", "content_sanskrit": "कर्मणो हि कृतेस्येह कामितस्य द्विजोत्तम।\nफलं ह्यवश्यं भोक्तव्यमृषिर्द्वैपायनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2089085, "chapter_id": 2906, "verse_number": "१३-३६-२६", "content_sanskrit": "भोगान्ते चापि पतनं गतिः पूर्वं प्रभाषिता।\nन मे प्रीतिकरास्त्वेते विषोदर्का हि मे मताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2089086, "chapter_id": 2906, "verse_number": "१३-३६-२७", "content_sanskrit": "वधात्कृष्टतरं मन्ये गर्भवासं महाद्युते।\nदिष्टान्ते यानि दुःखानि पुरुषो विन्दते विभो।\nततः कष्टतराणीह गर्भवासे हि विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2089087, "chapter_id": 2906, "verse_number": "१३-३६-२८", "content_sanskrit": "ततश्चाभ्याधिकां तीव्रां वेदनां लभते नरः।\nगर्भापक्रमणे तात कर्मणासुपसर्पणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2089088, "chapter_id": 2906, "verse_number": "१३-३६-२९", "content_sanskrit": "तस्मान्मे निश्चयो जातो धर्मेष्वेतेषु भारत।\nतदिच्छामि कुरुश्रेष्ठ त्वत्प्रसादान्महामते।\nतं धर्मं चेह वेत्तुं वै यो जराजन्ममृत्युहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2089089, "chapter_id": 2906, "verse_number": "१३-३६-३०", "content_sanskrit": "येनोष्णदा वैतरणी असिपत्रवनं च तत्।\nकुण्डानि चाग्नितप्तानि क्षुरधारापथस्तथा।\nशाल्मलीं च महाघोरामायसीं घोरकण्टकाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2089090, "chapter_id": 2906, "verse_number": "१३-३६-३१", "content_sanskrit": "मातापितृकते चापि सुहृन्मित्रार्थकारणात्।\nआत्महेतोश्च पापानि कृतानीह नरैश्च यैः।\nतेषां फलोदयं कष्टमृषिर्द्वैपायनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2089091, "chapter_id": 2906, "verse_number": "१३-३६-३२", "content_sanskrit": "कुम्भीपाकप्रदीप्तानां शूलार्तानां च क्रन्दताम्।\nरौरवे क्षिप्यमाणानां प्रहारैर्मथितात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2089092, "chapter_id": 2906, "verse_number": "१३-३६-३३", "content_sanskrit": "स्तनतामपकृत्तानां पिबतामात्मशोणितम्।\nतेषामेव प्रवदतां कारुण्यं नास्ति यन्त्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2089093, "chapter_id": 2906, "verse_number": "१३-३६-३४", "content_sanskrit": "तृष्णाशुष्कोष्ठकण्ठानां विह्वलानामचेतसाम्।\nसर्वदुःखाभिभूतानां रुजार्तानां च क्रोशताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2089094, "chapter_id": 2906, "verse_number": "१३-३६-३५", "content_sanskrit": "वेदनार्ता हि क्रन्दन्ति पूरयन्तो दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2089095, "chapter_id": 2906, "verse_number": "१३-३६-३६", "content_sanskrit": "एकः करोति पापानि सहभोज्यानि बान्धवैः।\nतेषामेकः फलं भुङ्क्ते कष्टं वैवस्वते गृहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2089096, "chapter_id": 2906, "verse_number": "१३-३६-३७", "content_sanskrit": "येन नैतां गतिं गच्छेन्न विण्मूत्रास्थिपिच्छिले।\nविष्ठामूत्रकृमीमध्ये बहुजन्तुनिषेविते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2089097, "chapter_id": 2906, "verse_number": "१३-३६-३८", "content_sanskrit": "को गर्भवासात्परतो नरकोऽन्यो विधीयते।\nयत्र वासकृतो योगः कुक्षौ वासो विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2089098, "chapter_id": 2906, "verse_number": "१३-३६-३९", "content_sanskrit": "जातो विस्तीर्णशोकः स्याद्भवेत विगतज्वरः।\nन चैष लभ्यते कामो जातमात्रं हि मानवम्।\nआविशन्तीह दुःखानि मनोवाक्कायिकानि तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2089099, "chapter_id": 2906, "verse_number": "१३-३६-४०", "content_sanskrit": "तैरस्वतन्त्रो भवति पीड्यमानो भयानकैः।\nतैर्गर्भवासं गच्छति अवशो जायते तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2089100, "chapter_id": 2906, "verse_number": "१३-३६-४१", "content_sanskrit": "अवशश्चेहते जन्तुर्व्रजत्यवश एव हि।\nजरसा रूपविध्वंसं प्राप्नोत्यवश एव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2089101, "chapter_id": 2906, "verse_number": "१३-३६-४२", "content_sanskrit": "शरीरभेदमाप्नोति जीर्यतेऽवश एव तु।\nएवं ह्यनियतो मृत्युर्भवत्येव सदा नृषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2089102, "chapter_id": 2906, "verse_number": "१३-३६-४३", "content_sanskrit": "गर्भेषु म्रियते कश्चिज्जायमानस्तथाऽपरः।\nजाता म्रियन्ते बहवो यौवनस्थास्तथाऽपरे।\nमध्यभावे तु नश्यन्ति स्थविरो मृत एव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2089103, "chapter_id": 2906, "verse_number": "१३-३६-४४", "content_sanskrit": "को जन्मनो नोद्विजते स्वयम्भूरपि यो भवेत्।\nकुतस्त्वस्मद्विधस्तात मरणस्य वशानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2089104, "chapter_id": 2906, "verse_number": "१३-३६-४५", "content_sanskrit": "नित्याविष्टो भयेनाहं मनसा कुरुसत्तम।\nमुहूर्तमप्यहं शर्म न विन्दामि महामते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2089105, "chapter_id": 2906, "verse_number": "१३-३६-४६", "content_sanskrit": "कालात्मनि तिरोभूतो नित्यं तद्गुणवर्जितः।\nअन्नैर्बहुविधैः पुष्टं वस्त्रैर्नानाविधैर्वृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2089106, "chapter_id": 2906, "verse_number": "१३-३६-४७", "content_sanskrit": "चन्दनागरुदिग्धाङ्गं मणिमुक्ताविभूषितम्।\nयानैर्बहुविधैर्यातमेकान्तेनैव लालितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2089107, "chapter_id": 2906, "verse_number": "१३-३६-४८", "content_sanskrit": "यौवनोद्धतरूपाभिर्मन्दविह्वलगामिभिः।\nइष्टिभिरभिरामाभिर्वरस्त्रीभिरयन्त्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2089108, "chapter_id": 2906, "verse_number": "१३-३६-४९", "content_sanskrit": "रमितं सुचिरं कालं शरीरममितप्रभम्।\nअवितृप्ता गमिष्यन्ति हित्वा प्राणांस्तथाऽपरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2089109, "chapter_id": 2906, "verse_number": "१३-३६-५०", "content_sanskrit": "स्वर्गेऽप्यनियता भूतिस्तथैवाकाशसंश्रये।\nदेवाऽप्यधिष्ठानवशास्तस्माद्देवं न कामये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2089110, "chapter_id": 2906, "verse_number": "१३-३६-५१", "content_sanskrit": "कामानां नास्त्यधिष्ठानमकामस्तु निवर्तते।\nलोकसङ्ग्रहधर्मास्तु सर्व एव न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2089111, "chapter_id": 2906, "verse_number": "१३-३६-५२", "content_sanskrit": "डोलासधर्मा धर्मज्ञ ऋषिर्द्वैपायनोऽब्रवीत्।\nअस्मात्को विषमं दुःखमारोहेत विचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2089112, "chapter_id": 2906, "verse_number": "१३-३६-५३", "content_sanskrit": "विद्यमाने समे मार्गे डोलाधर्मविवर्जिते।\nको ह्यात्मानं प्रियं लोके डोलासाधर्म्यतांनयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2089113, "chapter_id": 2906, "verse_number": "१३-३६-५४", "content_sanskrit": "चराचरैः सर्वभूतैर्गन्तव्यमविशङ्कया।\nअस्माल्लोकात्परं लोकमपाथेयमदैशिकम्।\nघोरं तमः प्रवेष्टव्यमत्रातारमबान्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2089114, "chapter_id": 2906, "verse_number": "१३-३६-५५", "content_sanskrit": "ये तु तं किल धर्मज्ञा धर्मं नारायणेरितम्।\nअनन्यमनसो दान्ताः स्मरन्ति नियतव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2089115, "chapter_id": 2906, "verse_number": "१३-३६-५६", "content_sanskrit": "ततस्तेनैव पश्यन्ति प्राप्नुव्ति परं पदम्।\nरक्षते भगवान्विष्णुर्भक्तानात्मशरीरवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2089116, "chapter_id": 2906, "verse_number": "१३-३६-५७", "content_sanskrit": "कुलालचक्रप्रतिमे भ्राम्यमाणेषु जन्तुषु।\nमातापितृसहस्राणि सम्प्राप्तानि मया गुरो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2089117, "chapter_id": 2906, "verse_number": "१३-३६-५८", "content_sanskrit": "स्नेहापन्नेन पीतास्तु मातॄणां विविधाः स्तलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2089118, "chapter_id": 2906, "verse_number": "१३-३६-५९", "content_sanskrit": "पुत्रदारसहस्राणि इष्टानिष्टशतानि च।\nप्राप्तान्यधिष्ठानवशादतीतानि तथैव च।\nन क्वचिन्न सुखं प्राप्तं न क्वचिच्छाश्वती स्थितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2089119, "chapter_id": 2906, "verse_number": "१३-३६-६०", "content_sanskrit": "स्थानैर्महद्भिर्विभ्रंशो दुःखलब्धैः पुनः पुनः।\nधननाशश्च सम्प्राप्तो लब्ध्वा दुःखेन तद्धनम्।\nअध्वगानामिव पथि च्छायामाश्रित्य सङ्गमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2089120, "chapter_id": 2906, "verse_number": "१३-३६-६१", "content_sanskrit": "एवं कर्मवशो लोको ज्ञातीनां हितसङ्गमः।\nविश्रम्य च पुनर्याति कर्मभिर्दर्शितां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2089121, "chapter_id": 2906, "verse_number": "१३-३६-६२", "content_sanskrit": "एतदीदृशकं दृष्ट्वा ज्ञात्वा चैव समागमम्।\nको न बिभ्येत्कुरुश्रेष्ठ विष्ठान्नस्येव भोजनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2089122, "chapter_id": 2906, "verse_number": "१३-३६-६३", "content_sanskrit": "बुद्धिश्च मे समुत्पन्ना वैष्णवे धर्मविस्तरे।\nतदेष शिरसा पादौ गतोऽस्मि भगवंस्तव।\nशरणं च प्रपन्नोऽस्मि गन्तव्ये शरणे ध्रुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2089123, "chapter_id": 2906, "verse_number": "१३-३६-६४", "content_sanskrit": "जन्ममृत्युजराखिन्नस्त्रिभिर्दुःखैर्निपीडितः।\nइच्छामि भवता त्रातुमेभ्यस्त्वत्तो महामते।\nतस्याद्य युगधर्मस्य श्रवणात्कुरुपुङ्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2089124, "chapter_id": 2906, "verse_number": "१३-३६-६५", "content_sanskrit": "एतदाद्ययुगोद्भूतं त्रेतायां तत्तिरोहितम्।\nस एव धर्ममखिलमृषिर्द्वैपायनोऽब्रवीत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2089125, "chapter_id": 2906, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षट्त्रिंशोऽध्यायःठ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]