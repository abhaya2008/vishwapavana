[{"id": 7000184000, "chapter_id": 20184, "verse_number": "१८४-१", "content_sanskrit": "श्रीकृष्णबालचरितवर्णनम् व्यास उवाच विमुक्तो वसुदेवोऽपि नन्दस्य शकटं गतः ।\nप्रहृष्टं दृष्टवान्नन्दं पुत्रो जातो ममेति वै ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000184001, "chapter_id": 20184, "verse_number": "१८४-२", "content_sanskrit": "वसुदेवोऽपि तं प्राह दिष्ट्या दिष्ट्येति सादरम् ।\nवार्धकेऽपि समुत्पन्नस्तनयोऽयं तवाधुना ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000184002, "chapter_id": 20184, "verse_number": "१८४-३", "content_sanskrit": "दत्तो हि वार्षिकः सर्वो भवद्भिर्नृपतेः करः ।\nयदर्थमागतस्तस्मान्नात्र स्थेयं महात्मनाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000184003, "chapter_id": 20184, "verse_number": "१८४-४", "content_sanskrit": "यदर्थमागतः कार्यं तन्निष्पन्नं किमास्यते ।\nभवद्भिर्गम्यतां नन्द तच्छीघ्रं निजगोकुलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000184004, "chapter_id": 20184, "verse_number": "१८४-५", "content_sanskrit": "ममापि बालकस्तत्र रोहिणीप्रसवो हि यः ।\nस रक्षणीयो भवता यथाऽयं तनयो निजः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000184005, "chapter_id": 20184, "verse_number": "१८४-६", "content_sanskrit": "व्यास उवाच इत्युक्ताः प्रययुर्गोपा नन्दगोपपुरोगमाः ।\nशकटारोपितैर्भाण्डैः करं दत्त्वा महाबलाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000184006, "chapter_id": 20184, "verse_number": "१८४-७", "content_sanskrit": "वसतां गोकुले तेषां पूतना बालघातिनी ।\nसुप्तं कृष्णमुपादाय रात्रौ च प्रददौ स्तनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000184007, "chapter_id": 20184, "verse_number": "१८४-८", "content_sanskrit": "यस्मै यस्मै स्तनं रात्रौ पूतना संप्रयच्छति ।\nतस्य तस्य क्षणेनाङ्गं बालकस्योपहन्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000184008, "chapter_id": 20184, "verse_number": "१८४-९", "content_sanskrit": "कृष्णस्तस्याः स्तनं गाढं कराभ्यामतिपीडितम् ।\nगृहीत्वा प्राणसहितं पपौ क्रोधसमन्वितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000184009, "chapter_id": 20184, "verse_number": "१८४-१०", "content_sanskrit": "सा विमुक्तमहारावा विच्छिन्नस्नायुबन्धना ।\nपपात पूतना भूमौ म्रियमाणाऽतिभिषणा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000184010, "chapter_id": 20184, "verse_number": "१८४-११", "content_sanskrit": "तन्नादश्रुतिसंत्रासाद्विबुद्धास्ते व्रजौकसः ।\nददुशुः पूतनोत्सङ्गे कृष्णं तां च निपातिताम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000184011, "chapter_id": 20184, "verse_number": "१८४-१२", "content_sanskrit": "आदाय कृष्णं संत्रस्ता यशोदा च ततो द्विजाः ।\nगोपुच्छभ्रामणाद्यैश्च बालदोषमपाकरोत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000184012, "chapter_id": 20184, "verse_number": "१८४-१३", "content_sanskrit": "गोपुरीषमुपादाय नन्दगोपोऽपि मस्तके ।\nकृष्णस्य प्रददौ रक्षां कुर्वन्निदमुदैरयत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000184013, "chapter_id": 20184, "verse_number": "१८४-१४", "content_sanskrit": "नन्दगोप उवाच रक्षते त्वामशेषाणां भूतानां प्रभवो हरिः ।\nयस्य नाभिसमुद्‌भूतात्पङ्काजादभवज्जगत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000184014, "chapter_id": 20184, "verse_number": "१८४-१५", "content_sanskrit": "येन दंष्ट्राग्रविधृता धारयत्यवनी जगत् ।\nवराहरूपधृग्देवः स त्वां रक्षतु केशवः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000184015, "chapter_id": 20184, "verse_number": "१८४-१६", "content_sanskrit": "गुह्यं स जठरं विष्णुर्जङ्घा पादौ जनार्दनः ।\nवामनो रक्षतु सदा भवन्तं यः क्षणादभूत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000184016, "chapter_id": 20184, "verse_number": "१८४-१७", "content_sanskrit": "त्रिविक्रमक्रमाक्रान्तत्रैलोक्यस्फुरदायुधः ।\nशिरस्ते पातु गोविन्दः कण्ठं रक्षतु केशवः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000184017, "chapter_id": 20184, "verse_number": "१८४-१८", "content_sanskrit": "मुखबाहू प्रबाहू च मनः सर्वेन्द्रियाणि च ।\nरक्षत्वव्याहतैश्वर्यस्तव नारायणोऽव्ययः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000184018, "chapter_id": 20184, "verse_number": "१८४-१९", "content_sanskrit": "त्वां दिक्षु पातु वैकुण्ठो विदिक्षु मदुसूदनः ।\nहृषीकेशोऽम्बरे भूमौ रक्षतु त्वां महीधरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000184019, "chapter_id": 20184, "verse_number": "१८४-२०", "content_sanskrit": "व्यास उवाच एवं कृतस्वस्त्ययनो नन्दगोपेन बालकः ।\nशायितः शकटस्याधो बालपर्यङ्किकातले ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000184020, "chapter_id": 20184, "verse_number": "१८४-२१", "content_sanskrit": "ते चा गोपा महद्‌दृष्ट्वा पूतनायाः कलेवरम् ।\nमृतायाः परमं त्रायं विस्मयं च तदा ययुः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000184021, "chapter_id": 20184, "verse_number": "१८४-२२", "content_sanskrit": "कदाचिच्छकटस्याधः शयानो मधुसुदनः ।\nचिक्षेप चरणावूर्ध्व स्तनार्थो प्ररुरोद च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000184022, "chapter_id": 20184, "verse_number": "१८४-२३", "content_sanskrit": "तस्य पादप्रहारेण शकटं परिवर्तितम् ।\nविध्वस्तभाण्डकुम्भं तद्विपरीतं पपात वै ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000184023, "chapter_id": 20184, "verse_number": "१८४-२४", "content_sanskrit": "ततो हाहाकृतः सर्वो गोपगोपीजनो द्विजाः ।\nआजगाम तदा ज्ञात्वा बालमुत्तानशायिनम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000184024, "chapter_id": 20184, "verse_number": "१८४-२५", "content_sanskrit": "गोपाः केनेति जगदुः शकटं परिवर्तितम् ।\nतत्रैव बालकाः प्रोचुर्बालेनानेन पातितम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000184025, "chapter_id": 20184, "verse_number": "१८४-२६", "content_sanskrit": "रुदता दृष्टमस्माभिः पादविक्षेपताडितम् ।\nशकटं परिवृत्तं वै नैतदन्यस्य चेष्टितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000184026, "chapter_id": 20184, "verse_number": "१८४-२७", "content_sanskrit": "ततः पुनरती वाऽऽसन्गोपा विस्मितचेतसः ।\nनन्दगोपोऽपि जग्राह बालमत्यन्तविस्मितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000184027, "chapter_id": 20184, "verse_number": "१८४-२८", "content_sanskrit": "यशोदा विस्मयारूढा भग्नभाण्डकपालकम् ।\nशकटं चार्चयामास दधिपुष्पफलाक्षतैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000184028, "chapter_id": 20184, "verse_number": "१८४-२९", "content_sanskrit": "गर्गश्च गोकुले तत्र वसुदेवप्रचोदितः ।\nप्रच्छन्न एव गोपानां संस्कारमकरोत्तयोः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000184029, "chapter_id": 20184, "verse_number": "१८४-३०", "content_sanskrit": "ज्येष्ठं च राममित्याह कृष्णं चैव तथाऽपरम् ।\nगर्गो मतिमतां श्रेष्ठो नाम कुर्वन्महामतिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000184030, "chapter_id": 20184, "verse_number": "१८४-३१", "content_sanskrit": "अल्पेनैव हि कालेन विज्ञातौ तौ महाबलौ ।\nघृष्टजानुकरौ विप्रा बभूवतुरुभावपि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000184031, "chapter_id": 20184, "verse_number": "१८४-३२", "content_sanskrit": "करोषभस्मदिग्धाङ्गौ भ्रममाणावितस्ततः ।\nन निवारयितुं शक्ता यशोदा तौ न रोहिणी ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000184032, "chapter_id": 20184, "verse_number": "१८४-३३", "content_sanskrit": "गोवाटमध्ये क्रीडन्तौ वत्सवाटगतौ पुनः ।\nतदहर्जातगोवत्सपुच्छाकर्षणतत्परौ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000184033, "chapter_id": 20184, "verse_number": "१८४-३४", "content_sanskrit": "यदा यशोदा तौ बालावेकस्थानचरावुभौ ।\nशशाक नो वारयितुं क्रीडन्तावतिचञ्चलौ ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000184034, "chapter_id": 20184, "verse_number": "१८४-३५", "content_sanskrit": "दाम्ना बद्‌ध्वा तदा मध्ये निबबन्ध उलूखले ।\nकृष्णमक्लिष्टकर्माणमाह चेदममर्षिता ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000184035, "chapter_id": 20184, "verse_number": "१८४-३६", "content_sanskrit": "यदि शक्तोऽसि गच्छ त्वमतिचञ्चलचेष्टित ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000184036, "chapter_id": 20184, "verse_number": "१८४-३७", "content_sanskrit": "व्साय उवाच इत्युक्त्वा च निजं कर्म सा चकार कुटुम्बिनी ।\nव्यग्रायामथ तस्यां स कर्षमाण उलूखलम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000184037, "chapter_id": 20184, "verse_number": "१८४-३८", "content_sanskrit": "यमलार्जुनयोर्मध्ये जगाम कमलेक्षणः ।\nकर्षता वृक्षयोर्मध्ये तिर्यगेवमुलूखलम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000184038, "chapter_id": 20184, "verse_number": "१८४-३९", "content_sanskrit": "भग्नावुत्तुङ्गशाखाग्रौ तेन तौ यमलार्जुनौ ।\nततः कटकटाशब्दसमाकर्णनकातरः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000184039, "chapter_id": 20184, "verse_number": "१८४-४०", "content_sanskrit": "आजगाम व्रजजनो ददृशे च महाद्रुमौ ।\nभग्नस्कन्धौ निपतितौ भग्नशाखौ महीतले ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000184040, "chapter_id": 20184, "verse_number": "१८४-४१", "content_sanskrit": "ददर्श चाल्पदन्तासमयं स्मितहासं च बालकम् ।\nतोयर्मध्यगतं बद्धं दाम्ना गाढं तथोदरे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000184041, "chapter_id": 20184, "verse_number": "१८४-४२", "content_sanskrit": "ततश्च दामोदरतां स ययौ दामबन्धनात् ।\nगोपवृद्धास्ततः सर्वे नन्दगोपपुरोगमाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000184042, "chapter_id": 20184, "verse_number": "१८४-४३", "content_sanskrit": "मन्त्रयामासुरुद्विग्ना महोत्पातातिभीरवः ।\nस्थानेनेह न नः कार्यं व्रजामोऽन्यन्महावनम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000184043, "chapter_id": 20184, "verse_number": "१८४-४४", "content_sanskrit": "उत्पाता बहवो ह्यत्र दृश्यन्ते नाशहेतवः ।\nपूतनाया विनाशश्च शकटस्य विपर्ययः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000184044, "chapter_id": 20184, "verse_number": "१८४-४५", "content_sanskrit": "विना वातादिदोषेण द्रुमयोः पतनं तथा ।\nवृन्दावनमितः स्तानात्तस्माद्‌गच्छाम मा चिरम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000184045, "chapter_id": 20184, "verse_number": "१८४-४६", "content_sanskrit": "यावद्भौममहोत्पातदोषो नाभिभवेद्‌व्रजम् ।\nइति कृत्वा मतिं सर्वे गमने ते व्रजैकसः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000184046, "chapter_id": 20184, "verse_number": "१८४-४७", "content_sanskrit": "ऊचुः स्वं स्वं कुलं शीघ्रं गम्यतां मा विलम्ब्यताम् ।\nततः क्षणेन प्रययुः शकटैर्गोधनैस्तथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000184047, "chapter_id": 20184, "verse_number": "१८४-४८", "content_sanskrit": "यूथशो वत्सपालीश्च कालयन्तो व्रजौकसः ।\nसर्वावयवनिर्धूतं क्षणमात्रेण तत्तदा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000184048, "chapter_id": 20184, "verse_number": "१८४-४९", "content_sanskrit": "काककाकीसमाकीर्णः व्रजस्थानमभूद्‌ द्विजाः ।\nवृन्दावनं भगवता कृष्णेनाक्लिष्टकर्मणाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000184049, "chapter_id": 20184, "verse_number": "१८४-५०", "content_sanskrit": "शुभेन मनसा ध्यानं गवां वृद्धिमभीप्सता ।\nततस्तत्रातिरुक्षेऽपि घर्मकाले द्विजोत्तमाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000184050, "chapter_id": 20184, "verse_number": "१८४-५१", "content_sanskrit": "प्रावृट्काल इवाभूच्च नवशष्पं समन्ततः ।\nस समावासितः सर्वो व्रजो वृन्दावने ततः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000184051, "chapter_id": 20184, "verse_number": "१८४-५२", "content_sanskrit": "शकटीवाटपर्यनतचन्द्रार्धाकारसंस्थितिः ।\nवत्सबालौ च संवृत्तौ रामदामोदरौ ततः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000184052, "chapter_id": 20184, "verse_number": "१८४-५३", "content_sanskrit": "तत्र स्थितौ तौ गोष्ठे चेरतुर्बाललीलया ।\nबर्हिपत्रकृतापीडौ वन्यपुष्पावतंसकौ ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000184053, "chapter_id": 20184, "verse_number": "१८४-५४", "content_sanskrit": "गोपवेणुकृतातोद्यपत्रवाद्यकृतस्वनौ ।\nकाकपक्षधरौ बालौ कुमाराविव पावकौ ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000184054, "chapter_id": 20184, "verse_number": "१८४-५५", "content_sanskrit": "हसन्तौ च रमन्तौ च चेरतुस्तन्महद्वनम् ।\nक्वचिद्धसन्तावन्योन्यं क्रीडमानौ तथा परैः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000184055, "chapter_id": 20184, "verse_number": "१८४-५६", "content_sanskrit": "गोपपुत्रैः समं वत्सांश्चारयन्तौ विचेरतुः ।\nकालेन गच्छता तौ तु सप्तवर्षौ बभूवतुः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000184056, "chapter_id": 20184, "verse_number": "१८४-५७", "content_sanskrit": "सर्वस्य जगतः पालौ वत्सपालौ महाव्रजे ।\nप्रावृट्कालस्ततोऽतीव मेघौघस्थगिताम्बरः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000184057, "chapter_id": 20184, "verse_number": "१८४-५८", "content_sanskrit": "बभूव वारिधाराभिरैक्यं कुर्वन्दिशामिव ।\nप्ररूढनवपुष्पाढ्या शक्रगोपवृता मही ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000184058, "chapter_id": 20184, "verse_number": "१८४-५९", "content_sanskrit": "यथा मारकते वाऽऽसीत्पद्मरागविभूषिता ।\nऊहुरुन्मार्गगामीनि निम्नगाम्भांसि सर्वतः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000184059, "chapter_id": 20184, "verse_number": "१८४-६०", "content_sanskrit": "मानां सि दुर्विनीतानां प्राप्य लक्ष्मीं नवामिव ।\nविकाले च यथाकामं व्रजमेत्य महाबलौ ।\nगोपैः समानैः सहितौ चिक्रीडातेऽमराविव ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]