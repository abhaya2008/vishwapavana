[{"id": 5000046000, "chapter_id": 9046, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे षट्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000046001, "chapter_id": 9046, "verse_number": "१-४६-१", "content_sanskrit": "हतेषु तेषु पुत्रेषु दितिः परमदुःखिता।\nमारीचं कश्यपं नाम भर्तारमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000046002, "chapter_id": 9046, "verse_number": "१-४६-२", "content_sanskrit": "हतपुत्रास्मि भगवंस्तव पुत्रौर्महाबलैः।\nशक्रहन्तारमिच्छामि पुत्रं दीर्घतपोर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000046003, "chapter_id": 9046, "verse_number": "१-४६-३", "content_sanskrit": "साहं तपश्चरिष्यामि गर्भं मे दातुमर्हसि।\nईश्वरं शक्रहन्तारं त्वमनुज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000046004, "chapter_id": 9046, "verse_number": "१-४६-४", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा मारीचः कश्यपस्तदा।\nप्रत्युवाच महातेजा दितिं परमदुःखिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000046005, "chapter_id": 9046, "verse_number": "१-४६-५", "content_sanskrit": "एवं भवतु भद्रं ते शुचिर्भव तपोधने।\nजनयिष्यसि पुत्रं त्वं शक्रहन्तारमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000046006, "chapter_id": 9046, "verse_number": "१-४६-६", "content_sanskrit": "पूर्णे वर्षसहस्रे तु शुचिर्यदि भविष्यसि।\nपुत्रं त्रैलोक्यहन्तारं मत्तस्त्वं जनयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000046007, "chapter_id": 9046, "verse_number": "१-४६-७", "content_sanskrit": "एवमुक्त्वा महातेजाः पाणिना सम्ममार्ज ताम्।\nतामालभ्य ततः स्वस्ति इत्युक्त्वा तपसे ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000046008, "chapter_id": 9046, "verse_number": "१-४६-८", "content_sanskrit": "गते तस्मिन् नरश्रेष्ठ दितिः परमहर्षिता।\nकुशप्लवं समासाद्य तपस्तेपे सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000046009, "chapter_id": 9046, "verse_number": "१-४६-९", "content_sanskrit": "तपस्तस्यां हि कुर्वत्यां परिचर्यां चकार ह।\nसहस्राक्षो नरश्रेष्ठ परया गुणसम्पदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000046010, "chapter_id": 9046, "verse_number": "१-४६-१०", "content_sanskrit": "अग्निं कुशान् काष्ठमपः फलं मूलं तथैव च।\nन्यवेदयत् सहस्राक्षो यच्चान्यदपि कांक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000046011, "chapter_id": 9046, "verse_number": "१-४६-११", "content_sanskrit": "गात्रसंवाहनैश्चैव श्रमापनयनैस्तथा।\nशक्रः सर्वेषु कालेषु दितिं परिचचार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000046012, "chapter_id": 9046, "verse_number": "१-४६-१२", "content_sanskrit": "पूर्णे वर्षसहस्रे सा दशोने रघुनन्दन।\nदितिः परमसंहृष्टा सहस्राक्षमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000046013, "chapter_id": 9046, "verse_number": "१-४६-१३", "content_sanskrit": "तपश्चरन्त्या वर्षाणि दश वीर्यवतां वर।\nअवशिष्टानि भद्रं ते भ्रातरं द्रक्ष्यसे ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000046014, "chapter_id": 9046, "verse_number": "१-४६-१४", "content_sanskrit": "यमहं त्वत्कृते पुत्र तमाधास्ये जयोत्सुकम्।\nत्रैलोक्यविजयं पुत्र सह भोक्ष्यसि विज्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000046015, "chapter_id": 9046, "verse_number": "१-४६-१५", "content_sanskrit": "याचितेन सुरश्रेष्ठ पित्रा तव महात्मना।\nवरो वर्षसहस्रान्ते मम दत्तः सुतं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000046016, "chapter_id": 9046, "verse_number": "१-४६-१६", "content_sanskrit": "इत्युक्त्वा च दितिस्तत्र प्राप्ते मध्यं दिनेश्वरे।\nनिद्रयापहृता देवी पादौ कृत्वाथ शीर्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000046017, "chapter_id": 9046, "verse_number": "१-४६-१७", "content_sanskrit": "दृष्ट्वा तामशुचिं शक्रः पादयोः कृतमूर्धजाम्।\nशिरःस्थाने कृतौ पादौ जहास च मुमोद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000046018, "chapter_id": 9046, "verse_number": "१-४६-१८", "content_sanskrit": "तस्याः शरीरविवरं प्रविवेश पुरंदरः।\nगर्भं च सप्तधा राम चिच्छेद परमात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000046019, "chapter_id": 9046, "verse_number": "१-४६-१९", "content_sanskrit": "भिद्यमानस्ततो गर्भो वज्रेण शतपर्वणा।\nरुरोद सुस्वरं राम ततो दितिरबुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000046020, "chapter_id": 9046, "verse_number": "१-४६-२०", "content_sanskrit": "मा रुदो मा रुदश्चेति गर्भं शक्रोऽभ्यभाषत।\nबिभेद च महातेजा रुदन्तमपि वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000046021, "chapter_id": 9046, "verse_number": "१-४६-२१", "content_sanskrit": "न हन्तव्यं न हन्तव्यमित्येव दितिरब्रवीत्।\nनिष्पपात ततः शक्रो मातुर्वचनगौरवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000046022, "chapter_id": 9046, "verse_number": "१-४६-२२", "content_sanskrit": "प्राञ्जलिर्वज्रसहितो दितिं शक्रोऽभ्यभाषत।\nअशुचिर्देवि सुप्तासि पादयोः कृतमूर्धजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000046023, "chapter_id": 9046, "verse_number": "१-४६-२३", "content_sanskrit": "तदन्तरमहं लब्ध्वा शक्रहन्तारमाहवे।\nअभिन्दं सप्तधा देवि तन्मे त्वं क्षन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000046024, "chapter_id": 9046, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे षट्चत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]