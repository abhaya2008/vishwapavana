[{"id": 2102117, "chapter_id": 3204, "verse_number": "१४-६०-१", "content_sanskrit": "वसुदेव उवाच।\nश्रुतवानस्मि वार्ष्णेय सङ्ग्रामं परमाद्भुतम्।\nनराणां वदतां पुत्र कथोद्धातेषु नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102118, "chapter_id": 3204, "verse_number": "१४-६०-२", "content_sanskrit": "त्वं तु प्रत्यक्षदर्शी च कार्यज्ञश्च महाभुजः।\nतस्मात्प्रब्रूहि सङ्ग्रामं याथातथ्येन मेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102119, "chapter_id": 3204, "verse_number": "१४-६०-३", "content_sanskrit": "यथा तदभवद्युद्धं पाण्डवानां महात्मनाम्।\nभीष्मकर्णकृपद्रोणशल्यादिभिरनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102120, "chapter_id": 3204, "verse_number": "१४-६०-४", "content_sanskrit": "अन्येषां क्षत्रियाणां च कृतास्त्राणामनेकशः।\nनानावेषाकृतिमतां नानादेशनिवासिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102121, "chapter_id": 3204, "verse_number": "१४-६०-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102122, "chapter_id": 3204, "verse_number": "१४-६०-५", "content_sanskrit": "इत्युक्तः पुण्डरीकाक्षः पित्रा मातुस्तदाऽन्तिके।\nशशंस कुरुवीराणां सङ्ग्रामे निधनं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102123, "chapter_id": 3204, "verse_number": "१४-६०-६x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102124, "chapter_id": 3204, "verse_number": "१४-६०-६", "content_sanskrit": "अत्यद्भुतानि कर्माणि क्षत्रियाणां महात्मनाम्।\nबहुलत्वान्न सङ्ख्यातुं शक्यान्यब्दशतैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102125, "chapter_id": 3204, "verse_number": "१४-६०-७", "content_sanskrit": "प्राधान्यतस्तु गदतः समासेनैव मे शृणु।\nकर्माणि पृथिवीशानां यथावदमरद्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102126, "chapter_id": 3204, "verse_number": "१४-६०-८", "content_sanskrit": "भीष्मः सेनापतिरभूदेकादशचमूपतिः।\nकौरव्यः कौरवेन्द्राणां देवानामिव पावकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102127, "chapter_id": 3204, "verse_number": "१४-६०-९", "content_sanskrit": "शिखण्डी पाण्डुपुत्राणां नेता सप्तचमूपतिः।\nबभूव रक्षितो धीमाञ्श्रीमता सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102128, "chapter_id": 3204, "verse_number": "१४-६०-१०", "content_sanskrit": "तेषां तदभवद्युद्धं दशाहानि महात्मनाम्।\nकुरूणां पाण्डवानां च सुमहद्रोमहर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102129, "chapter_id": 3204, "verse_number": "१४-६०-११", "content_sanskrit": "अयुध्यमानं गाङ्गेयं शिखण्डी तं महाद्युतिम्।\nजघान बहुभिर्बाणैः सह गाण्डीवधन्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102130, "chapter_id": 3204, "verse_number": "१४-६०-१२", "content_sanskrit": "अकरोत्स ततः कालं शरतल्पगतो मुनिः।\nअयनं दक्षिणं हित्वा सम्प्राप्ते चोत्तरायणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102131, "chapter_id": 3204, "verse_number": "१४-६०-१३", "content_sanskrit": "ततः सेनापतिरभूद्द्रोणोऽस्त्रविदुषांवरः।\nप्रवीरः कौरवेन्द्रस्य काव्यो दैत्यपतेरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102132, "chapter_id": 3204, "verse_number": "१४-६०-१४", "content_sanskrit": "अक्षौहिणीभिः शिष्टाभिर्नवभिर्द्विजसत्तमः।\nसंवृतः समरश्लाघी गुप्तः कृपसुतादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102133, "chapter_id": 3204, "verse_number": "१४-६०-१५", "content_sanskrit": "धृष्टद्युम्नस्त्वभून्नेता पाण्डवानां महास्त्रवित्।\nगुप्तो भीमेन मेधावी मित्रेण वरुणो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102134, "chapter_id": 3204, "verse_number": "१४-६०-१६", "content_sanskrit": "स च सेनापरिवृतो द्रोणप्रेप्सुर्महामनाः।\nपितुर्निकारान्संस्मृत्य रणे कर्माकरोन्महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102135, "chapter_id": 3204, "verse_number": "१४-६०-१७", "content_sanskrit": "तस्मिंस्ते पृथिवीपाला द्रोणपार्षतसङ्गरे।\nनानादिगागता वीराः प्रायशो निधनं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102136, "chapter_id": 3204, "verse_number": "१४-६०-१८", "content_sanskrit": "दिनानि पञ्च तद्युद्धमभूत्परमदारुणम्।\nततो द्रोणः परिश्रान्तो धृष्टद्युम्नवशं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102137, "chapter_id": 3204, "verse_number": "१४-६०-१९", "content_sanskrit": "ततः सेनापतिरभूत्कर्णो दौर्योधने बले।\nअक्षौहिणीभिः शिष्टाभिर्वृतः पञ्चभिराहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102138, "chapter_id": 3204, "verse_number": "१४-६०-२०", "content_sanskrit": "तिस्रस्तु पाण्डुपुत्राणां चम्वो बीभत्सुपालिताः।\nहतप्रवीरभूयिष्ठा बभूवुः समवस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102139, "chapter_id": 3204, "verse_number": "१४-६०-२१", "content_sanskrit": "ततः पार्थं समासाद्य पतङ्ग इव पावकम्।\nपञ्चत्वमगमत्सौतिर्द्वितीयेऽहनि दारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102140, "chapter_id": 3204, "verse_number": "१४-६०-२२", "content_sanskrit": "हते कर्णे तु कौरव्या निरुत्साहा हतौजसः।\nअक्षौहिणीभिस्तिसृभिर्मद्रेशं पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102141, "chapter_id": 3204, "verse_number": "१४-६०-२३", "content_sanskrit": "हतिवाहनभूयिष्ठाः पाण्डिवास्तु युधिष्ठिरम्।\nअक्षौहिण्या निरुत्साहाः शिष्टया पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102142, "chapter_id": 3204, "verse_number": "१४-६०-२४", "content_sanskrit": "अवधीन्मद्रराजानं कुरुराजो युधिष्ठिरः।\nतस्मिंस्तदाऽर्धदिवसे कृत्वा कर्म सुदुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102143, "chapter_id": 3204, "verse_number": "१४-६०-२५", "content_sanskrit": "हते शल्ये तु शकुनिं सहदेवो महामनाः।\nआहर्तारं कलेस्तस्य जगानामितविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2102144, "chapter_id": 3204, "verse_number": "१४-६०-२६", "content_sanskrit": "निहते शकुनौ राजा धार्तराष्ट्रः सुदुर्मनाः।\nअपाक्रामद्गदापाणिर्हतभूयिष्ठसैनिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2102145, "chapter_id": 3204, "verse_number": "१४-६०-२७", "content_sanskrit": "तमन्वधावत्संक्रुद्धो भीमसेनः प्रतापवान्।\nह्रदे द्वैपायने चापि सलिलस्थं ददर्श तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2102146, "chapter_id": 3204, "verse_number": "१४-६०-२८", "content_sanskrit": "इतशिष्टेन सैन्येन समन्तात्पर्यवार्य तम्।\nअथोपविविशुर्हृष्टा ह्रदस्थं पञ्च पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2102147, "chapter_id": 3204, "verse_number": "१४-६०-२९", "content_sanskrit": "विगाह्य सलिलं त्वाशु वाग्बाणैर्भृशविक्षतः।\nउत्थाय स गदापाणिर्युद्धाय समुपस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2102148, "chapter_id": 3204, "verse_number": "१४-६०-३०", "content_sanskrit": "ततः स निहतो राजा धार्तराष्ट्रो महारणे।\nभीमसेनेन विक्रम्य पश्यतां पृथिवीक्षिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2102149, "chapter_id": 3204, "verse_number": "१४-६०-३१", "content_sanskrit": "ततस्तत्पाण्डवं सैन्यं प्रसुप्तं शिबिरे निशि।\nनिहतं द्रोणपुत्रेण पितुर्वधममृष्यता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2102150, "chapter_id": 3204, "verse_number": "१४-६०-३२", "content_sanskrit": "हतपुत्रा हतबला हतमित्रा मया सह।\nयुयुधानसहायेन पञ्च शिष्टास्तु पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2102151, "chapter_id": 3204, "verse_number": "१४-६०-३३", "content_sanskrit": "सहैव कृपभोजाभ्यां द्रौणिर्युद्धादमुच्यत।\nयुयुत्सुश्चापि कौरव्यो मुक्तः पाण्डवसंश्रयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2102152, "chapter_id": 3204, "verse_number": "१४-६०-३४", "content_sanskrit": "निहते कौरवेन्द्रे तु सानुबन्धे सुयोधने।\nविदुरः संजयश्चैव धर्मराजमुपस्थितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2102153, "chapter_id": 3204, "verse_number": "१४-६०-३५", "content_sanskrit": "एवं तदभवद्युद्दमहान्यष्टादश प्रभो।\nयत्र ते पृथिवीपाला निहताः स्वर्गमावसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2102154, "chapter_id": 3204, "verse_number": "१४-६०-३६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2102155, "chapter_id": 3204, "verse_number": "१४-६०-३६", "content_sanskrit": "शृण्वतां तु महाराज कथां तां रोमहर्षणीम्।\nदुःखशोकपरिक्लेशा वृष्णीनामभवंस्तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2102156, "chapter_id": 3204, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि षष्टितमोऽध्यायः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]