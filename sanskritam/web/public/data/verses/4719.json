[{"id": 2175401, "chapter_id": 4719, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2175402, "chapter_id": 4719, "verse_number": "१", "content_sanskrit": "ततोऽभिषेकसम्भारान् सर्वान् सम्भृत्य शास्त्रतः ।\nबृहस्पतिः समिद्धेऽग्नौ जुहावाज्यं यथाविधि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2175403, "chapter_id": 4719, "verse_number": "२", "content_sanskrit": "ततो हिमवता दत्ते मणिप्रवरशोभिते ।\nदिव्यरत्नयुते दिव्ये निषण्णः परमासने\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2175404, "chapter_id": 4719, "verse_number": "३", "content_sanskrit": "सर्वमङ्गलसम्भारैर्विधिमन्त्रपुरस्कृतम् ।\nआभिषेचनिकं द्रव्यं गृहीत्वा देवतागणाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2175405, "chapter_id": 4719, "verse_number": "४", "content_sanskrit": "इन्द्राविष्णू महावीर्यौ तथा चन्द्रदिवाकरौ ।\nधाता चैव विधाता च तथोभावनिलानलौ\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2175406, "chapter_id": 4719, "verse_number": "५", "content_sanskrit": "पूष्णा भगेन चार्यम्णा चांशेन च विवस्वता ।\nरुद्रश्च सहितो धीमान् मित्रेण वरुणेन च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2175407, "chapter_id": 4719, "verse_number": "६", "content_sanskrit": "रुद्रैर्वसुभिरादित्यैरश्विभ्यां च वृतः प्रभुः ।\nविश्वैर्देवैर्मरुद्भिश्च साध्यैश्च पितृभिः सह\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2175408, "chapter_id": 4719, "verse_number": "७", "content_sanskrit": "गन्धर्वैरप्सरोभिश्च यक्षराक्षसपन्नगैः ।\nदेवर्षिभिरसङ्खेयैस्तथा ब्रह्मर्षिभिर्वरैः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2175409, "chapter_id": 4719, "verse_number": "८", "content_sanskrit": "वैखानसैर्वालखिल्यैर्वाय्वाहारैर्मरीचिपैः ।\nभृगुभिश्चाङ्गिरोभिश्च यतिभिश्च महात्मभिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2175410, "chapter_id": 4719, "verse_number": "९", "content_sanskrit": "सर्वैर्विद्याधरैः पुण्यैर्योगसिद्धैश्च संवृतः ।\nपितामहः पुलस्त्यश्च पुलहश्च महातपाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2175411, "chapter_id": 4719, "verse_number": "१०", "content_sanskrit": "अङ्गिराः कश्यपोऽत्रिश्च मरीचिर्भृगुरेव च ।\nक्रतुर्हरिः प्रचेताश्च मनुर्दक्षस्तथैव च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2175412, "chapter_id": 4719, "verse_number": "११", "content_sanskrit": "ऋतवश्च ग्रहाश्चैव ज्योतींषि च विशाम्पते ।\nमूर्तिमत्यश्च सरितो नदाश्चैव सनातनाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2175413, "chapter_id": 4719, "verse_number": "१२", "content_sanskrit": "समुद्राश्च ह्रदाश्चैव तीर्थानि विविधानि च ।\nपृथिवी द्यौर्दिशश्चैव पादपाश्च जनाधिप\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2175414, "chapter_id": 4719, "verse_number": "१३", "content_sanskrit": "अदितिर्देवमाता च ह्रीः श्रीः स्वाहा सरस्वती ।\nउमा शची सिनीवाली तथा चानुमतिः कुहूः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2175415, "chapter_id": 4719, "verse_number": "१४", "content_sanskrit": "राका च धिषणा चैव पत्न्यश्चान्या दिवौकसाम् ।\nहिमवांश्चैव विन्ध्यश्च मेरुश्चानेकशृङ्गवान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2175416, "chapter_id": 4719, "verse_number": "१५", "content_sanskrit": "ऐरावतः सानुचरः कलाः काष्ठास्तथैव च ।\nमासार्धमासा ऋतवस्तथा रात्र्यहनी नृप\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2175417, "chapter_id": 4719, "verse_number": "१६", "content_sanskrit": "उच्चैश्रवा हयश्रेष्ठो नागराजश्च वासुकिः ।\nअरुणो गरुडश्चैव वृक्षाश्चौषधिभिः सह\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2175418, "chapter_id": 4719, "verse_number": "१७", "content_sanskrit": "धर्मश्च भगवान् देवः समाजग्मुर्हि सङ्गताः ।\nकालो यमश्च मृत्युश्च यमस्यानुचराश्च ये\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2175419, "chapter_id": 4719, "verse_number": "१८", "content_sanskrit": "बहुलत्वाच्च ये नोक्ता विविधा देवतागणाः ।\nते कुमाराभिषेकार्थं समाजग्मुस्ततस्ततः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2175420, "chapter_id": 4719, "verse_number": "१९", "content_sanskrit": "जगृहुस्ते तदा राजन् सर्व एव दिवौकसः ।\nआभिषेचनिकं भाण्डं मङ्गलानि च सर्वशः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2175421, "chapter_id": 4719, "verse_number": "२०", "content_sanskrit": "दिव्यसम्भारसंयुक्तैः कलशैः काञ्चनैर्नृप ।\nसमिद्भिः पुण्यगन्धाभिरद्भिस्ताभिरलङ्कृतैः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2175422, "chapter_id": 4719, "verse_number": "२१", "content_sanskrit": "अभ्यषिञ्चन् कुमारं वै हृष्टरूपा दिवौकसः ।\nसैनापत्ये महात्मानमसुराणां भयावहम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2175423, "chapter_id": 4719, "verse_number": "२२", "content_sanskrit": "पुरा यथा महाराज वरुणं वै जलेश्वरम् ।\nतथाऽभ्यषिञ्चद् भगवान् ब्रह्मा लोकपितामहः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2175424, "chapter_id": 4719, "verse_number": "२३", "content_sanskrit": "काश्यपश्च महातेजा ये चान्ये नानुकीर्तिताः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2175425, "chapter_id": 4719, "verse_number": "२४", "content_sanskrit": "तस्मै ब्रह्मा ददौ प्रीतो बलिनो वातरंहसः ।\nकामवीर्यधरान् दिव्यान् महापारिषदान् प्रभुः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2175426, "chapter_id": 4719, "verse_number": "२५", "content_sanskrit": "नन्दिसेनं लोहिताक्षं घण्टाकर्णं च सम्मतम् ।\nचतुर्थं चाप्यतिबलं ख्यातं कुमुदमालिनम् ।\nतथा स्थाणुं महादेवं महापारिषदं क्रतुम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2175427, "chapter_id": 4719, "verse_number": "२६", "content_sanskrit": "मायाशतधरं वीरं कामवीर्यबलान्वितम् ।\nददौ स्कन्दाय राजेन्द्र सुरारिविनिबर्हणम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2175428, "chapter_id": 4719, "verse_number": "२७", "content_sanskrit": "स हि देवासुरे युद्धे दैत्यानां भीमकर्मणाम् ।\nजघान दोर्भ्यां सङ्क्रुद्धः प्रयुतानि चतुर्दश\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2175429, "chapter_id": 4719, "verse_number": "२८", "content_sanskrit": "तथा देवा ददुस्तस्मै शक्तिं नैर्ऋतसूदनीम् ।\nदेवशत्रुक्षयकरीमजय्यां विश्वरूपिणीम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2175430, "chapter_id": 4719, "verse_number": "२९", "content_sanskrit": "जयशब्दं तथा चक्रुर्देवाः सर्वे सवासवाः ।\nगन्धर्वयक्षरक्षांसि मुनयः पितरस्तथा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2175431, "chapter_id": 4719, "verse_number": "३०", "content_sanskrit": "ततः प्रादादनुचरौ यमः कालोपमावुभौ ।\nउन्माथं च प्रमाथं च महावीर्यौ महाद्युती\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2175432, "chapter_id": 4719, "verse_number": "३१", "content_sanskrit": "सुभ्राजौ भास्वरौ चैव यौ तौ सूर्यानुयायिनौ ।\nतौ सूर्यः कार्तिकेयाय ददौ प्रीतः प्रतापवान्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2175433, "chapter_id": 4719, "verse_number": "३२", "content_sanskrit": "कैलासशृङ्गसङ्काशौ श्वेतमाल्यानुलेपनौ ।\nसोमोऽप्यनुचरौ प्रादान्मणिं सुमणिमेव च\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2175434, "chapter_id": 4719, "verse_number": "३३", "content_sanskrit": "ज्वालाजिह्वं तथा ज्योतिमात्मजाय हुताशनः ।\nददावनुचरौ शूरौ परसैन्यप्रमाथिनौ\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2175435, "chapter_id": 4719, "verse_number": "३४", "content_sanskrit": "परिघं विकटं चैव भीमं च सुमहाबलम् ।\nदहतिं दहनं चैव प्रचण्डौ वीर्यसम्मतौ\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2175436, "chapter_id": 4719, "verse_number": "३५", "content_sanskrit": "अंशोऽप्यनुचरान् पञ्च ददौ स्कन्दाय धीमते\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2175437, "chapter_id": 4719, "verse_number": "३६", "content_sanskrit": "उत्क्रोशं संस्करं चैव वज्रदण्डधरावुभौ ।\nददावनलपुत्राय वासवः परवीरहा\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2175438, "chapter_id": 4719, "verse_number": "३७", "content_sanskrit": "तौ हि शत्रून् महेन्द्रस्य जघ्नतुः समरे बहून्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2175439, "chapter_id": 4719, "verse_number": "३८", "content_sanskrit": "चक्रं विक्रमकं चैव सङ्क्रमं च महाबलम् ।\nस्कन्दाय त्रीननुचरान् ददौ विष्णुर्महायशाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2175440, "chapter_id": 4719, "verse_number": "३९", "content_sanskrit": "वर्धनं नन्दनं चैव सर्वविद्याविशारदौ ।\nस्कन्दाय ददतुः प्रीतावश्विनौ भिषजां वरौ\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2175441, "chapter_id": 4719, "verse_number": "४०", "content_sanskrit": "कुन्दरं क्रमुकं चैव कुमुदं च महायशाः ।\nडम्बराडम्बरौ चैव ददौ धाता महात्मने\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2175442, "chapter_id": 4719, "verse_number": "४१", "content_sanskrit": "वक्रानुवक्रौ बलिनौ मेषवक्त्रौ बलोत्कटौ ।\nददौ त्वष्टा महामायौ स्कन्दस्यानुचरौ वरौ\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2175443, "chapter_id": 4719, "verse_number": "४२", "content_sanskrit": "सुव्रतं सत्यसन्धं च ददौ मित्रो महात्मने ।\nकुमाराय महात्मानौ ददौ विद्याधरौ प्रभुः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2175444, "chapter_id": 4719, "verse_number": "४३", "content_sanskrit": "सुदर्शनीयौ वरदौ त्रिषु लोकेषु विश्रुतौ ।\nसुप्रभं च महात्मानं शुभकर्माणमेव च\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2175445, "chapter_id": 4719, "verse_number": "४४", "content_sanskrit": "कार्तिकेयाय सम्प्रादाद् विधाता लोकविश्रुतौ\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2175446, "chapter_id": 4719, "verse_number": "४५", "content_sanskrit": "पूषा पारिषदौ प्रादात् कार्तिकेयाय भारत ।\nपालितुङ्गं कलिङ्गञ्च महामायावहावुभौ\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2175447, "chapter_id": 4719, "verse_number": "४६", "content_sanskrit": "सवं चातिसवं चैव तिमिवक्त्रौ महाबलौ ।\nप्रददौ कार्तिकेयाय वरुणः सत्यसङ्गरः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2175448, "chapter_id": 4719, "verse_number": "४७", "content_sanskrit": "बलं चातिबलं चैव महावक्त्रौ महाबलौ ।\nप्रददौ कार्तिकेयाय वायुर्भरतसत्तम\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2175449, "chapter_id": 4719, "verse_number": "४८", "content_sanskrit": "सुवर्चसं महात्मानं तथैवाऽप्यतिवर्चसम् ।\nहिमवान् प्रददौ राजन् हुताशनहुताय वै\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2175450, "chapter_id": 4719, "verse_number": "४९", "content_sanskrit": "काञ्चनं च महात्मानं मेघमालिनमेव च ।\nददावनुचरौ मेरुः अग्निपुत्राय भारत\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2175451, "chapter_id": 4719, "verse_number": "५०", "content_sanskrit": "स्थिरं चातिस्थिरं चैव मेरुरेवापरौ ददौ ।\nमहात्मनेऽग्निपुत्राय महाबलपराक्रमौ\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2175452, "chapter_id": 4719, "verse_number": "५१", "content_sanskrit": "उच्छ्रितं चातिशृङ्गं च मेघमालिनमेव च ।\nप्रददावग्निपुत्राय विन्ध्यः पारिषदान् शुभान्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2175453, "chapter_id": 4719, "verse_number": "५२", "content_sanskrit": "सङ्ग्रहं विग्रहं चैव समुद्रोऽपि गदाधरौ ।\nप्रददावग्निपुत्राय महापारिषदावुभौ\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2175454, "chapter_id": 4719, "verse_number": "५३", "content_sanskrit": "उन्मादं पुष्पदन्तं च शङ्कुकर्णं तथैव च ।\nप्रददावग्निपुत्राय पार्वती शुभदर्शना\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2175455, "chapter_id": 4719, "verse_number": "५४", "content_sanskrit": "जयं महाजयं चैव गङ्गा ज्वलनसूनवे ।\nप्रददौ पुरुषव्याघ्र महाबलपराक्रमौ\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2175456, "chapter_id": 4719, "verse_number": "५५", "content_sanskrit": "एवं साध्याश्च बहवो रुद्राश्च पितरस्तथा ।\nसागराः सरितश्चैव गिरयश्च महाबलान्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2175457, "chapter_id": 4719, "verse_number": "५६", "content_sanskrit": "ददुः सेनागणाध्यक्षान् शूलपट्टसधारिणः ।\nदिव्यप्रहरणोपेतान् नानावेषविभूषितान्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2175458, "chapter_id": 4719, "verse_number": "५७", "content_sanskrit": "शृणु नामानि चाप्येषां ये चान्ये स्कन्दसैनिकाः ।\nविविधायुधसम्पन्नाः चित्रावरणवर्मिणः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2175459, "chapter_id": 4719, "verse_number": "५८", "content_sanskrit": "गजकर्णो निकुम्भश्च पद्मः कुमुद एव च ।\nसुनन्दो द्वादशभुजः तथा कृष्णोपकृष्णकौ\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2175460, "chapter_id": 4719, "verse_number": "५९", "content_sanskrit": "द्रोणश्रवाः कपिस्कन्धः(ध्वजो) काञ्चनाक्षो जलन्धमः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2175461, "chapter_id": 4719, "verse_number": "६०", "content_sanskrit": "अक्षिसन्तर्जनो राजन् कुनदीकस्तथाऽभ्रकृत् ।\nएकाक्षो द्वादशभुजः तथैवैकजटः प्रभुः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2175462, "chapter_id": 4719, "verse_number": "६१", "content_sanskrit": "सहस्रबाहुर्विकचो व्याघ्रास्यः क्षितिकम्पनः ।\nपुण्यनामा सुनामा च सुवक्त्रः प्रियदर्शनः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2175463, "chapter_id": 4719, "verse_number": "६२", "content_sanskrit": "परिस्रावः कोकनदः प्रियमाल्यानुलेपनः ।\nगजोदरो गजशिराः स्कन्धाक्षः शतलोचनः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2175464, "chapter_id": 4719, "verse_number": "६३", "content_sanskrit": "ज्वालाजिह्वः करालश्च वज्रनाभो वसुप्रभः ।\nचतुर्दंष्ट्रोऽष्टजिह्वश्च मेघनादः पृथुश्रवाः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2175465, "chapter_id": 4719, "verse_number": "६४", "content_sanskrit": "विद्युदक्षो धनुर्वक्त्रो जठरो मारुताशनः ।\nउदाराक्षो झषाक्षश्च वज्रनाभो वसुप्रदः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2175466, "chapter_id": 4719, "verse_number": "६५", "content_sanskrit": "समुद्रवेगो राजेन्द्र शैलकम्पी तथैव च ।\nमन्त्रमेषः प्रभावश्च तथा नन्दोपनन्दकौ\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2175467, "chapter_id": 4719, "verse_number": "६६", "content_sanskrit": "धूम्रः श्वेतः कलिङ्गश्च सिद्धार्थो वरदस्तथा ।\nप्रियकश्चैव नन्दश्च गोनन्दश्च प्रतापवान्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2175468, "chapter_id": 4719, "verse_number": "६७", "content_sanskrit": "आनन्दश्च प्रमोदश्च स्वस्तिको ध्रुवकृत् तथा ।\nक्षेमपापः सुजातश्च चित्रयात्रश्च भारत\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2175469, "chapter_id": 4719, "verse_number": "६८", "content_sanskrit": "गोव्रजः कनकापीडो महापारिषदेश्वरः ।\nगायनो हायनश्चैव बाणखड्गश्च वीर्यवान्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2175470, "chapter_id": 4719, "verse_number": "६९", "content_sanskrit": "वैताली चातिताली च तथा कालिकपालिकौ ।\nमांसालीकङ्कदिग्धाङ्गः समुद्रो मानसश्च ह\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2175471, "chapter_id": 4719, "verse_number": "७०", "content_sanskrit": "रणोत्कटः प्रभासश्च श्वेतशीर्षश्च नन्दकः ।\nकालः काण्डशरीरश्च तथा कुम्भाण्डकोऽपरः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2175472, "chapter_id": 4719, "verse_number": "७१", "content_sanskrit": "अलिकान्धिस्थितश्चैव भूतलोन्मादनस्तथा ।\nयज्ञवाहः सुवाहश्च देवयाजी च सोमपः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2175473, "chapter_id": 4719, "verse_number": "७२", "content_sanskrit": "जालकश्च महातेजाः क्रुद्धाक्रुद्धौ च भारत ।\nतुहनश्च तुहानश्च चित्रसेनश्च वीर्यवान्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2175474, "chapter_id": 4719, "verse_number": "७३", "content_sanskrit": "मातुरः सुप्रसादश्च किरीटी च महाबलः ।\nवसानो मधुकर्णश्च कलशोदर एव च\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2175475, "chapter_id": 4719, "verse_number": "७४", "content_sanskrit": "यवन्तो मन्मथकरः सूचीवक्त्रश्च वीर्यवान् ।\nश्वेतवक्त्रोऽश्ववक्त्रश्च पाण्डरः सुमहाबलः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2175476, "chapter_id": 4719, "verse_number": "७५", "content_sanskrit": "कुण्डबाहुः सुबाहुश्च राजन् कोकिलकस्तथा ।\nआढकः कनकाक्षश्च बालो मानाधिकः प्रभुः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2175477, "chapter_id": 4719, "verse_number": "७६", "content_sanskrit": "सञ्चारकः कोकनको गृध्रवक्त्रश्च चुम्बकः ।\nलोपाशवक्त्रोऽजफलः शाखावक्त्रश्च तुण्डकः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2175478, "chapter_id": 4719, "verse_number": "७७", "content_sanskrit": "उग्रग्रीवश्च कृष्णश्च हंसवक्त्रश्च चन्द्रमाः ।\nवाणिकर्मा च मण्डूकः पञ्चवक्त्रश्च शिक्षकः\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2175479, "chapter_id": 4719, "verse_number": "७८", "content_sanskrit": "मेषवक्त्रश्च जम्बूकः शाकवक्त्रश्च तुण्डकः ।\nयोगयुक्तो महात्मा च सततं ब्राह्मणप्रियः\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2175480, "chapter_id": 4719, "verse_number": "७९", "content_sanskrit": "पैतामहो महात्मा च महापारिषदश्च यः ।\nयौवनस्थाश्च बालाश्च वृद्धाश्च जनमेजय\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2175481, "chapter_id": 4719, "verse_number": "८०", "content_sanskrit": "सहस्रशः पारिषदाः कुमारमुपतस्थिरे\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2175482, "chapter_id": 4719, "verse_number": "८१", "content_sanskrit": "वक्त्रैर्नानाविधैर्ये तु शृणु तान् जनमेजय\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2175483, "chapter_id": 4719, "verse_number": "८२", "content_sanskrit": "कूर्मकुक्कुटवक्त्राश्च शशगोधामुखास्तथा ।\nखरोष्ट्रवदनाश्चैव वराहवदनास्तथा\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2175484, "chapter_id": 4719, "verse_number": "८३", "content_sanskrit": "मनुष्यमेषवक्त्राश्च सृगालवदनास्तथा ।\nमार्जारशशवक्त्राश्च दीर्घवक्त्राश्च भारत\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2175485, "chapter_id": 4719, "verse_number": "८४", "content_sanskrit": "नकुलोलूकवक्त्राश्च श्ववक्त्राश्च तथा परे ।\nआखुवक्त्राश्वभ्रवक्त्रा मयूरवदनास्तथा\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2175486, "chapter_id": 4719, "verse_number": "८५", "content_sanskrit": "मत्स्यमेषाननाश्चान्ये अजाविमहिषाननाः ।\nऋक्षशार्दूलवक्त्राश्च द्वीपिसिंहाननास्तथा\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2175487, "chapter_id": 4719, "verse_number": "८६", "content_sanskrit": "भीमा गजाननाश्चैव तरक्षुवदनास्तथा ।\nगरुडाननाः खड्गमुखा वृककाकामुखास्तथा\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2175488, "chapter_id": 4719, "verse_number": "८७", "content_sanskrit": "गोवानरमुखाश्चान्ये पृषदंशमुखास्तथा ।\nमहाजठरपादाङ्गाः काकाक्षाश्चापि भारत\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2175489, "chapter_id": 4719, "verse_number": "८८", "content_sanskrit": "पारावतमुखाश्चान्ये तथा व्यक्तमुखाः परे ।\nकोकिलावदनाश्चैव श्येनतित्तिरिकाननाः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2175490, "chapter_id": 4719, "verse_number": "८९", "content_sanskrit": "आशीविषासक्तकण्ठा गोनासाभरणास्तथा ।\nस्थूलोदराः कृशाङ्गाश्च स्थूलाङ्गाश्च कृशोदराः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2175491, "chapter_id": 4719, "verse_number": "९०", "content_sanskrit": "ह्रस्वग्रीवा महाकण्ठा नानाव्यालविभूषिताः ।\nगजेन्द्रचर्मवसनास्तथा कृष्णाजिनाम्बराः\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2175492, "chapter_id": 4719, "verse_number": "९१", "content_sanskrit": "स्कन्धेमुखा महाराज तथा ह्युदरतोमुखाः ।\nपृष्ठेमुखास्तथा कण्ठेमुखा जङ्घामुखा अपि\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2175493, "chapter_id": 4719, "verse_number": "९२", "content_sanskrit": "पार्श्वाननाश्च बहवो नानादेशमुखाः परे ।\nतथा कीटपतङ्गानां सदृशास्या गणेश्वराः\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2175494, "chapter_id": 4719, "verse_number": "९३", "content_sanskrit": "नानाव्यालमुखाश्चान्ये बहुबाहुशिरोधराः ।\nनानाकृतिमुखाः केचिद् बाहुकर्णाक्षिनासिकाः\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2175495, "chapter_id": 4719, "verse_number": "९४", "content_sanskrit": "भुजङ्गभोगवदना नानागुल्मनिवासिनः ।\nचीरसंवृतगात्राश्च तथा वल्कलवाससः\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2175496, "chapter_id": 4719, "verse_number": "९५", "content_sanskrit": "नानावेषधराश्चान्ये चर्मवासस एव च ।\nउष्णीषिणो मकुटिनः कम्बुग्रीवाः सुवर्चसः\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2175497, "chapter_id": 4719, "verse_number": "९६", "content_sanskrit": "किरीटिनः पञ्चशिखास्तथा कठिनमूर्धजाः ।\nत्रिशिखा द्विशिखाश्चैव तथा सप्तशिखाः परे\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2175498, "chapter_id": 4719, "verse_number": "९७", "content_sanskrit": "शिखण्डिनो मकुटिनो मुण्डाश्चैव जटाधराः ।\nचित्रमालाम्बरधराः केचिद् रोमाननास्तथा\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2175499, "chapter_id": 4719, "verse_number": "९८", "content_sanskrit": "विग्रहैकरसा नित्यमजेयाः सुरसत्तमैः ।\nकृष्णाः निर्मांसवक्त्राश्च दीर्घपृष्ठोदरोरसः\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2175500, "chapter_id": 4719, "verse_number": "९९", "content_sanskrit": "स्थूलपृष्ठा ह्रस्वपृष्ठाः प्रलम्बोदरमेहनाः ।\nमहाभुजा ह्रस्वभुजा ह्रस्वगात्राः प्रबाहवः\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2175501, "chapter_id": 4719, "verse_number": "१००", "content_sanskrit": "कुब्जाश्च दीर्घजिह्वाश्च हस्तिकर्णशिरोधराः ।\nहस्तिनासाः कूर्मनासा वृकव्याघ्रनखास्तथा\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2175502, "chapter_id": 4719, "verse_number": "१०१", "content_sanskrit": "दीर्घोष्ठा दीर्घजिह्वाश्च विकराळा ह्यधोमुखाः ।\nमहादंष्ट्रा ह्रस्वदंष्ट्रा चित्रदंष्ट्रास्तथा परे\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2175503, "chapter_id": 4719, "verse_number": "१०२", "content_sanskrit": "वारणेन्द्रमुखाश्चान्ये भीमा राजन् सहस्रशः ।\nसुविभक्तशरीराश्च दीप्तिमन्तः स्वलङ्कृताः\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2175504, "chapter_id": 4719, "verse_number": "१०३", "content_sanskrit": "पिङ्गलाक्षाः शङ्कुकर्णाश्चक्रपादाश्च भारत ।\nपृथुदंष्ट्रा महादंष्ट्राः स्थूलोष्ठा हरिमूर्द्धजाः\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2175505, "chapter_id": 4719, "verse_number": "१०४", "content_sanskrit": "नानापादोष्ठपृष्ठाश्च नानाहस्तशिरोधराः ।\nनानावर्मभिराच्छन्ना नानाभाषाश्च भारत\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2175506, "chapter_id": 4719, "verse_number": "१०५", "content_sanskrit": "कुशला देशभाषासु जल्पन्तोऽन्योन्यमीश्वरम् ।\nहृष्टाः परिपतन्ति स्म राजन् पारिषदाः स्मृताः\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2175507, "chapter_id": 4719, "verse_number": "१०६", "content_sanskrit": "दीर्घग्रीवा दीर्घनखा दीर्घपादशिरोरुहाः ।\nपिङ्गाक्षा नीलकण्ठाश्च लम्बकर्णाश्च भारत\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2175508, "chapter_id": 4719, "verse_number": "१०७", "content_sanskrit": "शुकोदरनिभाश्चैव केचिदञ्जनसन्निभाः ।\nश्वेताङ्गा लोहितग्रीवाः पिङ्गलाक्षास्तथा परे\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2175509, "chapter_id": 4719, "verse_number": "१०८", "content_sanskrit": "कल्माषबाहवो राजन् चित्रमालाश्च भारत ।\nचामीकरापीडनिभाः श्वेतलोहितराजयः\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2175510, "chapter_id": 4719, "verse_number": "१०९", "content_sanskrit": "नानावर्णाः सुवर्णाश्च मयूरसदृशप्रभाः\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2175511, "chapter_id": 4719, "verse_number": "११०", "content_sanskrit": "पुनः प्रहरणान्येषां कीर्त्यमानानि मे शृणु\t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2175512, "chapter_id": 4719, "verse_number": "१११", "content_sanskrit": "शेषैः कृतः पारिषदैरायुधानां परिग्रहः\t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2175513, "chapter_id": 4719, "verse_number": "११२", "content_sanskrit": "पाशोद्यतकराश्चैव व्यादितास्याः खराननाः ।\nपृथ्वक्षा नीलकण्ठाश्च तथा परिघबाहवः\t॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2175514, "chapter_id": 4719, "verse_number": "११३", "content_sanskrit": "शतघ्नीपाशहस्ताश्च तथा मुसलपाणयः ।\nअसिपट्टसहस्ताश्च दण्डहस्ताश्च भारत\t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2175515, "chapter_id": 4719, "verse_number": "११४", "content_sanskrit": "गदामुसुण्ठीहस्ताश्च तथा मुद्गरपाणयः ।\nतीक्ष्णासिहस्ताश्च तथा दण्डहस्ताश्च भारत\t॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2175516, "chapter_id": 4719, "verse_number": "११५", "content_sanskrit": "आयुधैर्विविधैर्घोरैर्महात्मानो महाजवाः\t॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2175517, "chapter_id": 4719, "verse_number": "११६", "content_sanskrit": "महाजवा महाभागा महापारिषदास्तथा ।\nअभिषेकं कुमारस्य दृष्ट्वा हृष्टा रणप्रियाः\t॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2175518, "chapter_id": 4719, "verse_number": "११७", "content_sanskrit": "घण्टाजालपिनद्धाङ्गा ननृतुस्ते महौजसः\t॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2175519, "chapter_id": 4719, "verse_number": "११८", "content_sanskrit": "एते चान्ये च बहवो महापारिषदा नृप ।\nउपतस्थुर्महात्मानं कार्तिकेयं यशस्विनम्\t॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2175520, "chapter_id": 4719, "verse_number": "११९", "content_sanskrit": "दिव्याश्चाप्यान्तरिक्षाश्च पार्थिवाश्चानलोपमाः ।\nव्यादिष्टा दैवतैः शूरैः स्कन्दस्यानुचरा भवन्\t॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2175521, "chapter_id": 4719, "verse_number": "१२०", "content_sanskrit": "तादृशानां सहस्राणि प्रयुतान्यर्बुदानि च ।\nअभिषिक्तं महात्मानं परिवार्योपतस्थिरे\t॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2175522, "chapter_id": 4719, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि कुमाराभिषेको नाम सप्तदशोऽध्यायः ॥१७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}]