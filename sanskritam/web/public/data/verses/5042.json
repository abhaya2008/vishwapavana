[{"id": 2190013, "chapter_id": 5042, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2190014, "chapter_id": 5042, "verse_number": "१", "content_sanskrit": "य इमे पृथिवीपालाः शेरते पृथिवीतळे ।\nपृतनामध्य एते हि गतसत्त्वा महाबलाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2190015, "chapter_id": 5042, "verse_number": "२", "content_sanskrit": "एकैकशो भीमबला नागायुतबलास्तथा ।\nएते हि निहताः सङ्ख्ये तुल्यतेजोबलैर्नरैः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2190016, "chapter_id": 5042, "verse_number": "३", "content_sanskrit": "नैषां पश्यामि हन्तारं प्राणिनां संयुगे पुरा ।\nविक्रमेणोपसम्पन्नास्तेजोबलसमन्विताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2190017, "chapter_id": 5042, "verse_number": "४", "content_sanskrit": "अथ चेमे महाप्राज्ञ शेरते हि गतासवः ।\nमृता इति च शब्दोऽयं वर्तत्येषु गतासुषु\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2190018, "chapter_id": 5042, "verse_number": "५", "content_sanskrit": "इमे मृता नृपतयः प्रायशो भीमविक्रमाः ।\nतत्र मे संशयो जातः कुतः सञ्ज्ञा मृता इति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2190019, "chapter_id": 5042, "verse_number": "६", "content_sanskrit": "कस्य मृत्युः कुतो मृत्युः केन मृत्युरिह प्रजाः ।\nहरत्यमरसङ्काश तन्मे ब्रूहि पितामह\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2190020, "chapter_id": 5042, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2190021, "chapter_id": 5042, "verse_number": "७", "content_sanskrit": "पुरा कृतयुगे तात राजासीदविकम्पकः ।\nस शत्रुवशमापन्नः सङ्ग्रामे क्षीणवाहनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2190022, "chapter_id": 5042, "verse_number": "८", "content_sanskrit": "तत्र पुत्रो हरिर्नाम नारायणसमो बले ।\nस शत्रुभिर्हतः सङ्ख्ये सबलः सपदानुगः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2190023, "chapter_id": 5042, "verse_number": "९", "content_sanskrit": "स राजा शत्रुवशगः पुत्रशोकसमन्वितः ।\nयदृच्छयाशान्तिपरो ददर्श भुवि नारदम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2190024, "chapter_id": 5042, "verse_number": "१०", "content_sanskrit": "स तस्मै सर्वमाचष्ट यथा वृत्तं जनेश्वरः ।\nशत्रुभिर्ग्रहणं सङ्ख्ये पुत्रस्य मरणं तथा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2190025, "chapter_id": 5042, "verse_number": "११", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा नारदोऽथ तपोधनः ।\nआख्यानमिदमाचष्ट पुत्रशोकापहं तदा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2190026, "chapter_id": 5042, "verse_number": "१२", "content_sanskrit": "राजन् शृणु समाख्यानमद्येदं बहुविस्तरम् ।\nयथा वृत्तं श्रुतं चैव मयापि वसुधाधिप\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2190027, "chapter_id": 5042, "verse_number": "१३", "content_sanskrit": "प्रजाः सृष्ट्वा महातेजाः प्रजासर्गे पितामहः ।\nअतीव वृद्धा बहुला नामृष्यत पुनः प्रजाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2190028, "chapter_id": 5042, "verse_number": "१४", "content_sanskrit": "न ह्यन्तरमभूत् किञ्चित् क्वचिज्जन्तुभिरच्युत ।\nनिरुच्छ्वासमिवोन्नद्धं त्रैलोक्यमभवन्नृप\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2190029, "chapter_id": 5042, "verse_number": "१५", "content_sanskrit": "तस्य चिन्ता समुत्पन्ना संहारं प्रति भूपते ।\nचिन्तयन्नाध्यगच्छच्च संहारे हेतुकारणम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2190030, "chapter_id": 5042, "verse_number": "१६", "content_sanskrit": "तस्य रोषान्महाराज खेभ्योऽग्निरुदतिष्ठत ।\nतेन सर्वा दिशो राजन्ददाह स पितामहः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2190031, "chapter_id": 5042, "verse_number": "१७", "content_sanskrit": "ततो दिवं भुवं खं च जगच्च सचराचरम् ।\nददाह पावको राजन् भगवत्कोपसम्भवः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2190032, "chapter_id": 5042, "verse_number": "१८", "content_sanskrit": "तत्रादह्यन्त भूतानि जङ्गमानि ध्रुवाणि च ।\nमहता कोपवेगेन कुपिते प्रपितामहे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2190033, "chapter_id": 5042, "verse_number": "१९", "content_sanskrit": "ततो हरिजटः स्थाणुर्वेदाध्वरपतिः शिवः ।\nजगाद शरणं देवो ब्रह्माणं परवीरहा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2190034, "chapter_id": 5042, "verse_number": "२०", "content_sanskrit": "तस्मिन्नभिगते स्थाणौ प्रजानां हितकाम्यया ।\nअब्रवीद्वरदो देवो ज्वलन्निव तदा शिवम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2190035, "chapter_id": 5042, "verse_number": "२१", "content_sanskrit": "करवाण्यद्य कं कामं वरार्होऽसि मतो मम ।\nकर्ता ह्यस्मि प्रियं शम्भो तव यद्धृदि वर्तते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2190036, "chapter_id": 5042, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे एकनवतितमोऽध्यायः ॥९१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]