[{"id": 7004204000, "chapter_id": 24204, "verse_number": "५-१-५३-१", "content_sanskrit": "सनत्कुमार उवाच ।\nपृथिव्यां यानि तीर्थानि तानि सर्वाणि सुव्रत ।\nअवंत्यां सुन्दरे तीर्थे तिष्ठंति सर्वदा भुवि॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004204001, "chapter_id": 24204, "verse_number": "५-१-५३-२", "content_sanskrit": "व्यास उवाच ।\nकिमिदं सुन्दरं कुण्डं कदाकालेऽभवत्क्षितौ ।\nनिर्मितं केन को देवः किं वा तस्य फलं स्मृतम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004204002, "chapter_id": 24204, "verse_number": "५-१-५३-३", "content_sanskrit": "सनत्कुमार उवाच ।\nशृणु पुण्यतमे क्षेत्रे सुन्दराख्यं यदा ऽभवत् ।\nसर्वपापप्रशमनं वांछितार्थफलप्रदम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004204003, "chapter_id": 24204, "verse_number": "५-१-५३-४", "content_sanskrit": "यस्य श्रवणमात्रेण ब्रह्महत्या व्यपोहति ।\nअश्वमेधादिकं पुण्यं वाजपेयश ताधिकम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004204004, "chapter_id": 24204, "verse_number": "५-१-५३-५", "content_sanskrit": "पुरा कल्पक्षये व्यास नष्टकल्पा च मेदिनी ।\nप्रचण्डवातवर्षाभ्यां चूर्णितो मेरुपर्वतः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004204005, "chapter_id": 24204, "verse_number": "५-१-५३-६", "content_sanskrit": "तदात्र पतितं व्यास वैकुण्ठशिखरोत्तमम् ।\nमहाकालवने घोरे गुह्ये चाव्ययके ध्रुवे॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004204006, "chapter_id": 24204, "verse_number": "५-१-५३-७", "content_sanskrit": "तत्क्षणात्पतिते शृंगे कुण्डं जातं सुनिश्चितम् ।\nरत्नसोपानमच्छोदं मुक्तासैकतपूरितम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004204007, "chapter_id": 24204, "verse_number": "५-१-५३-८", "content_sanskrit": "जांबूनदकरारोहं हेमपद्मविराजितम् ।\nकल्पद्रुमकृतच्छायं चिंतामणिसमुच्छ्रितम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004204008, "chapter_id": 24204, "verse_number": "५-१-५३-९", "content_sanskrit": "हंसकारंडवाकीर्णं चक्रवाकोपशोभितम् ।\nबीजौषधिगणाकीर्णं सर्वतत्त्वाभिसंयुतम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004204009, "chapter_id": 24204, "verse_number": "५-१-५३-१०", "content_sanskrit": "कल्पक्षये न क्षीयंते यानि तत्त्वानि सर्वशः ।\nतानि तत्र प्रतिष्ठंति मूर्तिमंति पराणि च॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004204010, "chapter_id": 24204, "verse_number": "५-१-५३-११", "content_sanskrit": "वेदशास्त्रपुराणानि गाथागीतिक्षराक्षराः ।\nओंकारश्च वषट्कारो गायत्री त्रिपदा परा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004204011, "chapter_id": 24204, "verse_number": "५-१-५३-१२", "content_sanskrit": "कलाः काष्ठा मुहूर्ताश्च लवत्रुटिपलं घटिः ।\nअहर्निशश्च यामाश्च पक्षमासावृतुस्तथा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004204012, "chapter_id": 24204, "verse_number": "५-१-५३-१३", "content_sanskrit": "संवत्सरयुगाश्चैव कुण्डे तिष्ठंति मूर्तितः ।\nदेवा यक्षाश्च नागाश्च गुह्यकाः किन्नरास्तथा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004204013, "chapter_id": 24204, "verse_number": "५-१-५३-१४", "content_sanskrit": "गंधर्वाप्सरसो यक्षाः सिद्धाः किंपुरुषास्तथा ।\nउपासांचक्रिरे तस्य कल्पदोषभयातुराः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004204014, "chapter_id": 24204, "verse_number": "५-१-५३-१५", "content_sanskrit": "ब्रह्मा रुद्रश्च कालश्च लोकपाला महौजसः ।\nकेचिद्ध्यानपराः सिद्धास्तापसाः शंसितव्रताः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004204015, "chapter_id": 24204, "verse_number": "५-१-५३-१६", "content_sanskrit": "तिष्ठंति बहुयुग व्यास यावत्कल्पः समाप्यते ।\nसुदर्शनसमाकारं पूरितं चामृतांबुभिः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004204016, "chapter_id": 24204, "verse_number": "५-१-५३-१७", "content_sanskrit": "दिव्यपादपसंयुक्तं पारिजातगुणान्वितम् ।\nदिव्यस्त्रीस्नानगंधोदैर्वासितोद्गारिसौरभम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004204017, "chapter_id": 24204, "verse_number": "५-१-५३-१८", "content_sanskrit": "क्वचिन्मयूरा नृत्यंति क्वचित्कूजंति कोकिलाः ।\nक्वचित्केकारवाः क्वापि मेघघोषसमाकुलम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004204018, "chapter_id": 24204, "verse_number": "५-१-५३-१९", "content_sanskrit": "सुन्दरं सुन्दराकारं सुन्दरं तेन चोच्यते ।\nबहुपुण्यकरं व्यास सर्वपापहरं परम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004204019, "chapter_id": 24204, "verse_number": "५-१-५३-२०", "content_sanskrit": "यत्र संनिहितो विष्णुः शिवः शक्त्या युतो वशी ।\nउपासांचक्रिरे शश्वत्सर्वकालेषु सर्वदा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004204020, "chapter_id": 24204, "verse_number": "५-१-५३-२१", "content_sanskrit": "पक्षार्धं पक्षमेकं च सुन्दरकुण्डे नरो वसेत् ।\nवैकुण्ठे नियतं वासो यावत्कल्पशतं भवेत्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004204021, "chapter_id": 24204, "verse_number": "५-१-५३-२२", "content_sanskrit": "पक्षिकीटपतंगाश्च मृता यांति शिवालयम् ।\nकिं पुनर्मानवा लोके स्नानपूताश्च तत्र वै॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004204022, "chapter_id": 24204, "verse_number": "५-१-५३-२३", "content_sanskrit": "ये ददति तिलान्धेनुं गजवा जिरथावनीः ।\nदासीर्दासान्सुवर्णं च रत्नानि विविधानि च॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004204023, "chapter_id": 24204, "verse_number": "५-१-५३-२४", "content_sanskrit": "शय्यादानविमानानि दानानि विविधानि च ।\nन तेषां दानजं वेद्मि कीदृग्व्यास फलं भवेत्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004204024, "chapter_id": 24204, "verse_number": "५-१-५३-२५", "content_sanskrit": "भूयः शृणु परं व्यास सुन्दरकुण्डफलं स्मृतम् ।\nएकदा बहुपापेन पतितः पापयोनिषु॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004204025, "chapter_id": 24204, "verse_number": "५-१-५३-२६", "content_sanskrit": "पिशाचो मोक्षमापन्नः शिव रूपधरो गतः ।\nपिशाचमोचने स्नात्वा दृष्ट्वा देवं महेश्वरम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004204026, "chapter_id": 24204, "verse_number": "५-१-५३-२७", "content_sanskrit": "मुच्यते सर्वपापेभ्यो यद्यपि ब्रह्महा भवेत्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004204027, "chapter_id": 24204, "verse_number": "५-१-५३-२८", "content_sanskrit": "व्यास उवाच ।\nकोऽसौ पिशाच इति ख्यातः किं तेन दुष्कृतं कृतम् ।\nयेन पापप्रसंगेन पिशाचत्वमुपागतः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004204028, "chapter_id": 24204, "verse_number": "५-१-५३-२९", "content_sanskrit": "कथं तीर्थप्रसंगोऽस्य जातो वै द्विज सत्तम ।\nएतद्वेदितुमिच्छामि त्वत्तो ब्रह्मविदांवर॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004204029, "chapter_id": 24204, "verse_number": "५-१-५३-३०", "content_sanskrit": "सनत्कुमार उवाच ।\nशृणु व्यास महाख्यानं तीर्थमाहात्म्यमुत्तमम् ।\nयस्य श्रवणमात्रेण सर्वपापक्षयो भवेत्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004204030, "chapter_id": 24204, "verse_number": "५-१-५३-३१", "content_sanskrit": "ब्राह्मणो देवलो नाम दाक्षिणात्यो द्विजाधमः ।\nसदा पापरतो लोभी कूटसाक्षी च लंपटः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004204031, "chapter_id": 24204, "verse_number": "५-१-५३-३२", "content_sanskrit": "गुरुद्रोही कितवो धूर्तो गुरुहा गुरुतल्पगः ।\nहेमहारी सुरापी च ब्रह्महा स्वामिद्रोहकः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004204032, "chapter_id": 24204, "verse_number": "५-१-५३-३३", "content_sanskrit": "अभक्ष्यभक्षकश्चैव वेदशास्त्रविवर्जितः ।\nअनेकजन्मार्जितपापी सर्वधर्मबहिष्कृतः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004204033, "chapter_id": 24204, "verse_number": "५-१-५३-३४", "content_sanskrit": "विश्वासघातको मानी चोरसंगरतः खलः ।\nदेशांतरगतो मंदश्चौरकार्यार्थसाधकः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004204034, "chapter_id": 24204, "verse_number": "५-१-५३-३५", "content_sanskrit": "बहवो निहता मार्गे पापाचारेण जंतवः ।\nमगधे स गतो दुष्टः प्रसंगात्पापकारिणाम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004204035, "chapter_id": 24204, "verse_number": "५-१-५३-३६", "content_sanskrit": "तत्रैको ब्राह्मणो दांतो वेदवेदांगपारगः ।\nसाग्निकः शुद्धसत्त्वस्थो ब्रह्मकर्मरतः सदा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004204036, "chapter_id": 24204, "verse_number": "५-१-५३-३७", "content_sanskrit": "श्वशुरगृहे स्थिता भार्या तामादाय यशस्विनीम् ।\nचलितो यानमारुह्य तेन पापेन घातितः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004204037, "chapter_id": 24204, "verse_number": "५-१-५३-३८", "content_sanskrit": "तस्य स्त्री च वरारोहा रूपलावण्यशालिनी ।\nपतिव्रता महाभागा दृढचित्ता शुचिस्मिता॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004204038, "chapter_id": 24204, "verse_number": "५-१-५३-३९", "content_sanskrit": "हते भर्तरि दुःखार्ता पतिविरहकातरा ।\nवने घोरे परिभ्रष्टा काष्ठान्यादाय भामिनी॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004204039, "chapter_id": 24204, "verse_number": "५-१-५३-४०", "content_sanskrit": "आरुरोह चितां दीप्तां पतिना हृष्टमानसा ।\nस च दुष्टतरः सर्वं तस्य विप्रस्य जीवनम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004204040, "chapter_id": 24204, "verse_number": "५-१-५३-४१", "content_sanskrit": "गृहीत्वा चलितो मार्गे गृहीतो राजकिंकरैः ।\nबंधयित्वा च तैः सर्वैस्तेन वित्तेन वै सह ।\nनीतोऽसौ राजभवनं निवेदितो राजसंनिधौ॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004204041, "chapter_id": 24204, "verse_number": "५-१-५३-४२", "content_sanskrit": "पातितो वै गले बद्ध्वा रज्जुना वृक्षकोटरे ।\nचांडालैर्घृष्टितो भूमावितस्ततः श्वपाकिभिः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004204042, "chapter_id": 24204, "verse_number": "५-१-५३-४३", "content_sanskrit": "तेन कर्मविपाकेन रौरवं नरकं गतः ।\nषष्टिवर्षसहस्राणि विष्ठायां कृमितां गतः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004204043, "chapter_id": 24204, "verse_number": "५-१-५३-४४", "content_sanskrit": "ततोऽन्यं नरकं प्राप्तो यमशासनकारकैः ।\nअसिपत्रवनं घोरमायसं तप्तसायकम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004204044, "chapter_id": 24204, "verse_number": "५-१-५३-४५", "content_sanskrit": "मुद्गरैस्ताड्यमानो हि शृंखलाभिश्च किंकरैः ।\nकुंभीपाकगतौ रौति वैतरण्यां सुपीडितः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004204045, "chapter_id": 24204, "verse_number": "५-१-५३-४६", "content_sanskrit": "एवं बहुविधान्कुण्डान्भुक्त्वा पापी नवान्नवान् ।\nततः प्रेतत्वमापन्नो युगानां पंचसप्ततिम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004204046, "chapter_id": 24204, "verse_number": "५-१-५३-४७", "content_sanskrit": "महाकायो महारावो महोदरः सूचीमुखः ।\nक्षुत्तृड्भ्यां च पराक्रांतो मरुदेशं समाश्रितः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004204047, "chapter_id": 24204, "verse_number": "५-१-५३-४८", "content_sanskrit": "ततः कष्टतरां प्राप्य पैशाचीं तनुमाश्रितः ।\nकुटिलो दुष्टभावश्च दुष्टचारी दिगंबरः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004204048, "chapter_id": 24204, "verse_number": "५-१-५३-४९", "content_sanskrit": "विण्मूत्रदूषितोच्छिष्टपूतिपर्युष्टभोजनः ।\nश्मशानोच्छिष्टभोजी च कृत्तिवासा विलोचनः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004204049, "chapter_id": 24204, "verse_number": "५-१-५३-५०", "content_sanskrit": "भग्नवापीतडागे च शुष्कवृक्षे निरूदके ।\nप्राकारपरिखागारे शून्यागारे नदीतटे॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004204050, "chapter_id": 24204, "verse_number": "५-१-५३-५१", "content_sanskrit": "निवासो रोचते तस्य सर्वदा सर्वसंधिषु ।\nएवं बहुयुगे याते महाकालवने गतः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004204051, "chapter_id": 24204, "verse_number": "५-१-५३-५२", "content_sanskrit": "यत्र माहेश्वरं लिंगं सुन्दरं कुंडमुत्तमम् ।\nतत्रोषितत्वमात्रेण सिंहेन विनिपातितः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004204052, "chapter_id": 24204, "verse_number": "५-१-५३-५३", "content_sanskrit": "घातयित्वा च तं पापं जलार्थी कुंडमाविशत् ।\nदंष्ट्रांतरगतं चास्थ्यपतत्तस्य मुखाज्जले॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004204053, "chapter_id": 24204, "verse_number": "५-१-५३-५४", "content_sanskrit": "तेन पुण्यप्रभावेन सर्वपापं क्षयं गतम् ।\nमृतमात्रे च लिंगं तन्नेत्रांतरगतं तदा॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004204054, "chapter_id": 24204, "verse_number": "५-१-५३-५५", "content_sanskrit": "हित्वा पैशाचकं देहं ज्योतिस्तल्लिंगमाविशत् ।\nतदारभ्य परं व्यास तीर्थं पैशाचमोचनम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004204055, "chapter_id": 24204, "verse_number": "५-१-५३-५६", "content_sanskrit": "पिशाचमोचनेशेति देवः ख्यातिं ततो गतः ।\nतावद्गर्जंति पापानि मदोन्मत्तगजा यथा॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004204056, "chapter_id": 24204, "verse_number": "५-१-५३-५७", "content_sanskrit": "यावन्नायाति शिप्रायास्तीर्थे पैशाचमो चने ।\nपिशाचमोचने स्नात्वा शुचिर्भूत्वा समाहितः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004204057, "chapter_id": 24204, "verse_number": "५-१-५३-५८", "content_sanskrit": "पिशाचमोचनं देवं पूजयित्वा यथाविधि ।\nसर्वपापविशुद्धात्मा जायते नात्र संशयः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004204058, "chapter_id": 24204, "verse_number": "५-१-५३-५९", "content_sanskrit": "पिशाचमोचने व्यास महादानानि कारयेत् ।\nन तस्य पुनरावृत्तिः शिवलोकात्कदाचन॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004204059, "chapter_id": 24204, "verse_number": "५-१-५३-६०", "content_sanskrit": "पिशाचमोचनकथां पवित्रां पापहारिणीम् ।\nयः पठेच्छणुयाच्चैव हयमेधफलं लभेत्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]