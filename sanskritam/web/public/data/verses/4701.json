[{"id": 2174115, "chapter_id": 4701, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2174116, "chapter_id": 4701, "verse_number": "१", "content_sanskrit": "तस्मिन् प्रवृत्ते सङ्ग्रामे गजवाजिनरक्षये ।\nशकुनिः सौबलो राजन् सहदेवं समभ्ययात्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2174117, "chapter_id": 4701, "verse_number": "२", "content_sanskrit": "ततोऽस्यापततस्तूर्णं सहदेवः प्रतापवान् ।\nशरौघान् प्रेषयामास पतङ्गानिव शीघ्रगान्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2174118, "chapter_id": 4701, "verse_number": "३", "content_sanskrit": "उलूकः समरे भीमं विव्याध दशभिः शरैः ।\nशकुनिस्तु महाराज भीमं विद्ध्वा त्रिभिः शरैः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2174119, "chapter_id": 4701, "verse_number": "४", "content_sanskrit": "सायकानां नवत्या वै सहदेवं समाकिरत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2174120, "chapter_id": 4701, "verse_number": "५", "content_sanskrit": "ते शूराः समरे राजन् समासाद्य परस्परम् ।\nविव्यधुर्निशितैर्बाणैः कङ्कबर्हिणवाजितैः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2174121, "chapter_id": 4701, "verse_number": "६", "content_sanskrit": "स्वर्णपुङ्खैः शिलाधौतैराकर्णात् प्रहितैः शरैः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2174122, "chapter_id": 4701, "verse_number": "७", "content_sanskrit": "तेषां चापभुजोत्सृष्टा शरवृष्टिर्विशाम्पते ।\nप्राच्छादयद् दिशः सर्वा धाराभिरिव तोयदः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2174123, "chapter_id": 4701, "verse_number": "८", "content_sanskrit": "ततः क्रुद्धो रणे भीमः सहदेवश्च भारत ।\nचेरतुः कदनं सङ्खे प्रकुर्वन्तौ महाबलौ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2174124, "chapter_id": 4701, "verse_number": "९", "content_sanskrit": "ताभ्यां शरशतैश्छिन्नं तद्बलं भरतर्षभ ।\nअन्धकारमिवाकाशमभवत् तत्र तत्र ह\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2174125, "chapter_id": 4701, "verse_number": "१०", "content_sanskrit": "अश्वैर्विपरिधावद्भिः शरैश्छिन्नैर्विशाम्पते ।\nतत्र तत्र कृतो मार्गो विकर्षद्भिर्हतान् बहून्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2174126, "chapter_id": 4701, "verse_number": "११", "content_sanskrit": "निहतानां हयानां च सहैव हययोधिभिः ।\nवर्मभिर्विनिकृत्तैश्च प्रासैश्छिन्नैश्च मारिष\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2174127, "chapter_id": 4701, "verse_number": "१२", "content_sanskrit": "असिभिः शक्तिभिश्चैव तोमरैश्च परन्तप ।\nसञ्छन्ना वसुधा तैस्तु कुसुमैः शबला इव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2174128, "chapter_id": 4701, "verse_number": "१३", "content_sanskrit": "योधास्तत्र महाराज समासाद्य परस्परम् ।\nव्यचरन्त रणे क्रुद्धा निनिघ्नतुः परस्परम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2174129, "chapter_id": 4701, "verse_number": "१४", "content_sanskrit": "उद्वृत्तनयनै रोषात् सन्दष्टोष्ठपुटैर्मुखैः ।\nसकुण्डलैर्मही च्छन्ना पद्मकिञ्जल्कसन्निभैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2174130, "chapter_id": 4701, "verse_number": "१५", "content_sanskrit": "भुजैश्छिन्नैर्महाराज नागराजकरौपमैः ।\nस गदैः सतलत्रैश्च सासिप्रासपरश्वथैः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2174131, "chapter_id": 4701, "verse_number": "१६", "content_sanskrit": "कबन्धैरुत्थितैश्चैव नृत्यद्भिश्चापरैर्युधि ।\nक्रव्यादगणसम्पूर्णा घोराऽभूत् पृथिवी विभो\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2174132, "chapter_id": 4701, "verse_number": "१७", "content_sanskrit": "अल्पावशिष्टे सैन्ये तु कौरवेयान् महाहवे ।\nप्रहृष्टाः पाण्डवा भूत्वा निन्यिरे यमसादनम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2174133, "chapter_id": 4701, "verse_number": "१८", "content_sanskrit": "एतस्मिन्नन्तरे शूरः सौबलेयः प्रतापवान् ।\nप्रासेन सहदेवस्य शिरसि प्राहरद् भृशम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2174134, "chapter_id": 4701, "verse_number": "१९", "content_sanskrit": "स विह्वलो महाराज रथोपस्थ उपाविशत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2174135, "chapter_id": 4701, "verse_number": "२०", "content_sanskrit": "सहदेवं तथा दृष्ट्वा भीमसेनः प्रतापवान् ।\nसर्वसैन्यानि सङ्क्रुद्धो वारयामास भारत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2174136, "chapter_id": 4701, "verse_number": "२१", "content_sanskrit": "निर्बिभेद च नाराचैः शतशोऽथ सहस्रशः ।\nस निर्भिद्य रणे चक्रे सिंहनादमथानदत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2174137, "chapter_id": 4701, "verse_number": "२२", "content_sanskrit": "तेन शब्देन वित्रस्ताः सर्वे सहयवारणाः ।\nप्राद्रवन् सहसा भीताः शकुनेश्च पदानुगाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2174138, "chapter_id": 4701, "verse_number": "२३", "content_sanskrit": "प्रभग्नानथ तान् दृष्ट्वा राजा दुर्योधनोऽब्रवीत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2174139, "chapter_id": 4701, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2174140, "chapter_id": 4701, "verse_number": "२४", "content_sanskrit": "निवर्तध्वमधर्मज्ञा युध्यध्वं किं द्रुतेन वः ।\nइह कीर्तिं समाधाय प्रेत्य लोकान् समश्नुते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2174141, "chapter_id": 4701, "verse_number": "२५", "content_sanskrit": "प्राणान् जहाति यो वीरो युधि पृष्ठमदर्शयन्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2174142, "chapter_id": 4701, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2174143, "chapter_id": 4701, "verse_number": "२६", "content_sanskrit": "एवमुक्तास्ततो राज्ञा सौबलस्य पदानुगाः ।\nपाण्डवानभ्यवर्तन्त मृत्युं कृत्वा निवर्तनम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2174144, "chapter_id": 4701, "verse_number": "२७", "content_sanskrit": "द्रवद्भिस्तु ततो राजन् कृतः शब्दोऽतिदारुणः ।\nक्षुब्धसागरसङ्काशः क्षुभितैः सर्वतो दिशम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2174145, "chapter_id": 4701, "verse_number": "२८", "content_sanskrit": "तांस्तथाऽऽपततो दृष्ट्वा सौबलस्य पदानुगान् ।\nप्रत्युद्ययुर्महाराज पाण्डवा विजये धृताः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2174146, "chapter_id": 4701, "verse_number": "२९", "content_sanskrit": "प्रत्याश्वस्य च दुर्धर्षः सहदेवो विशाम्पते ।\nशकुनिं दशभिर्विद्ध्वा हयांश्चास्य त्रिभिः शरैः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2174147, "chapter_id": 4701, "verse_number": "३०", "content_sanskrit": "धनुश्चिच्छेद च शरैः सौबलस्य हसन्निव\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2174148, "chapter_id": 4701, "verse_number": "३१", "content_sanskrit": "अथान्यद्धनुरादाय शकुनिर्युद्धदुर्मदः ।\nविव्याध नकुलं षष्ट्या भीमसेनं च सप्तभिः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2174149, "chapter_id": 4701, "verse_number": "३२", "content_sanskrit": "उलूकस्तु महाराज भीमं विव्याध सप्तभिः ।\nसहदेवं च सप्तत्या परीप्सन् पितरं रणे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2174150, "chapter_id": 4701, "verse_number": "३३", "content_sanskrit": "तं भीमसेनः समरे विव्याध निशितैः शरैः ।\nशकुनिं च चतुष्षष्ट्या पार्श्वपांश्च त्रिभिस्त्रिभिः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2174151, "chapter_id": 4701, "verse_number": "३४", "content_sanskrit": "ते हन्यमाना भीमेन नाराचैस्तैलपायितैः ।\nसहदेवं रणे क्रुद्धः छादयन् शरवृष्टिभिः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2174152, "chapter_id": 4701, "verse_number": "३५", "content_sanskrit": "पर्वतं वारिधाराभिः सविद्युत इवाम्बुदाः ।\nततो ह्यापततस्तूर्णं सहदेवः प्रतापवान्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2174153, "chapter_id": 4701, "verse_number": "३६", "content_sanskrit": "उलूकस्य महाराज भल्लेनापहरच्छिरः ।\nस जगाम रथाद् भूमिं सहदेवेन पातितः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2174154, "chapter_id": 4701, "verse_number": "३७", "content_sanskrit": "रुधिराप्लुतसर्वाङ्गो नन्दयन् पाण्डवान् रणे ।\nपुत्रं तु निहतं दृष्ट्वा शुकुनिस्तत्र भारत\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2174155, "chapter_id": 4701, "verse_number": "३८", "content_sanskrit": "सास्रकण्ठो विनिःश्वस्य क्षत्तुर्वाक्यमनुस्मरन् ।\nचिन्तयित्वा मुहूर्तं तु बाष्पपूर्णेक्षणः श्वसन्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2174156, "chapter_id": 4701, "verse_number": "३९", "content_sanskrit": "सहदेवं समासाद्य विव्याध त्रिभिराशुगैः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2174157, "chapter_id": 4701, "verse_number": "४०", "content_sanskrit": "तानपास्य शरान् मुक्तान् शरसङ्घैः प्रतापवान् ।\nसहदेवो महाराज धनुश्चिच्छेद संयुगे\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2174158, "chapter_id": 4701, "verse_number": "४१", "content_sanskrit": "छिन्ने धनुषि राजेन्द्र शकुनिः सौबलस्तदा ।\nप्रगृह्य विमलं खड्गं सहदेवाय प्राहिणोत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2174159, "chapter_id": 4701, "verse_number": "४२", "content_sanskrit": "तमापतन्तं सहसा घोररूपं विशाम्पते ।\nद्विधा चिच्छेद राजेन्द्र सौबलस्य हसन्निव\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2174160, "chapter_id": 4701, "verse_number": "४३", "content_sanskrit": "असिं दृष्ट्वा द्विधा च्छिन्नं प्रगृह्य महतीं गदाम् ।\nप्राहिणोत् सहदेवाय सा मोघा न्यपतद् भुवि\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2174161, "chapter_id": 4701, "verse_number": "४४", "content_sanskrit": "ततः शक्तिं महाघोरं कालरात्रिमिवोद्यताम् ।\nप्रेषयामास सङ्क्रुद्धः पाण्डवं प्रति सौबलः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2174162, "chapter_id": 4701, "verse_number": "४५", "content_sanskrit": "तामापतन्तीं सहसा शरैः काञ्चनभूषणैः ।\nत्रिधा चिच्छेद समरे सहदेवो हसन्निव\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2174163, "chapter_id": 4701, "verse_number": "४६", "content_sanskrit": "सा पपात त्रिधा छिन्ना भूमौ कनकभूषणा ।\nशीर्यमाणा यथा दीप्ता गगनाद् वै शतह्रदा\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2174164, "chapter_id": 4701, "verse_number": "४७", "content_sanskrit": "शक्तिं विनिहतां दृष्ट्वा सौबलं च भयार्दितम् ।\nदुद्रुवुस्तावकाः सर्वे भये जाते ससौबलाः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2174165, "chapter_id": 4701, "verse_number": "४८", "content_sanskrit": "अथोत्कृष्टं महच्चासीत् पाण्डवैर्जितकाशिभिः ।\nधार्तराष्ट्राः ततः सर्वे प्रायशो विमुखा भवन्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2174166, "chapter_id": 4701, "verse_number": "४९", "content_sanskrit": "तान् वै विमनसो दृष्ट्वा माद्रीपुत्रः प्रतापवान् ।\nशरैरनेकसाहस्रैः वारयामास संयुगे\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2174167, "chapter_id": 4701, "verse_number": "५०", "content_sanskrit": "ततो गान्धारकैर्गुप्तं श्रेष्ठैरश्वैर्जये धृतम् ।\nआससाद रणे यान्तं सहदेवोऽथ सौबलम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2174168, "chapter_id": 4701, "verse_number": "५१", "content_sanskrit": "स्वमंशमवशिष्टं स संस्मृत्य शकुनिं नृप ।\nरथेन काञ्चनाङ्गेन सहदेवः समभ्ययात्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2174169, "chapter_id": 4701, "verse_number": "५२", "content_sanskrit": "अधिज्यं बलवत् कृत्वा व्याक्षिपन् सशरं धनुः ।\nस सौबलमभिद्रुत्य गृध्रपक्षैः शिलासितैः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2174170, "chapter_id": 4701, "verse_number": "५३", "content_sanskrit": "भृशमभ्यहनत् क्रुद्धः तोत्रैरिव महाद्विपम् ।\nउवाच चैनं मेधावी निगृह्य स्मारयन्निव\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2174171, "chapter_id": 4701, "verse_number": "", "content_sanskrit": "सहदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2174172, "chapter_id": 4701, "verse_number": "५४", "content_sanskrit": "क्षत्रधर्मे स्थितो भूत्वा युध्यस्व पुरुषो भव ।\nयत् तदा भाषसे मूढ गृह्णन्नक्षान् सभातळे\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2174173, "chapter_id": 4701, "verse_number": "५५", "content_sanskrit": "फलमद्य प्रपद्यस्व कर्मणस्तस्य दुर्मते ।\nनिहतास्ते दुरात्मानो येऽस्मानप्यहसन् पुरा\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2174174, "chapter_id": 4701, "verse_number": "५६", "content_sanskrit": "दुर्योधनः कुलाङ्गारः शिष्टस्त्वं तस्य मातुलः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2174175, "chapter_id": 4701, "verse_number": "५७", "content_sanskrit": "अद्य ते पातयिष्यामि शरेण ग्रथितं शिरः ।\nवृक्षात् फलमिवोद्धृत्य लगुडेन प्रमाथिना\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2174176, "chapter_id": 4701, "verse_number": "५८", "content_sanskrit": "एवमुक्त्वा महाराज सहदेवो महाबलः ।\nसङ्क्रुद्धो नरशार्दूलो वेगेनाभिजगाम ह\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2174177, "chapter_id": 4701, "verse_number": "५९", "content_sanskrit": "अभिगम्य तु दुर्धर्षः सहदेवो विशाम्पते ।\nविकृष्य बलवच्चापं क्रोधेन प्रदहन्निव\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2174178, "chapter_id": 4701, "verse_number": "६०", "content_sanskrit": "शकुनिं दशभिर्विद्ध्वा चतुर्भिश्चास्य वाजिनः ।\nछत्रं ध्वजं धनुश्चास्य छित्वा सिंह इवानदत्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2174179, "chapter_id": 4701, "verse_number": "६१", "content_sanskrit": "छिन्नध्वजधनुश्च्छत्रः सहदेवेन सौबलः ।\nकृतो विद्धश्च बहुभिः सर्वमर्मसु सायकैः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2174180, "chapter_id": 4701, "verse_number": "६२", "content_sanskrit": "ततो भूयो महाबाहुः सहदेवः प्रतापवान् ।\nशकुनेः प्रेषयामास शरवृष्टिं दुरासदाम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2174181, "chapter_id": 4701, "verse_number": "६३", "content_sanskrit": "ततस्तु क्रुद्धः सुबलस्य पुत्रो\nमाद्रीसुतं सहदेवं विमर्दे ।\nप्रासेन जाम्बूनदभूषणेन\nजिघांसुरेकोऽभिपपात शीघ्रम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2174182, "chapter_id": 4701, "verse_number": "६४", "content_sanskrit": "माद्रीसुतस्तस्य समुद्यतं तं\nप्रासं सुवृत्तौ च भुजौ रणाग्रे ।\nभल्लैस्त्रिभिर्युगपत् सञ्चकर्त\nननाद चोच्चैस्तरसाऽऽजिमध्ये\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2174183, "chapter_id": 4701, "verse_number": "६५", "content_sanskrit": "तस्याशुकारी सुसमाहितेन\nसुवर्णपुङ्खेन दृढायसेन ।\nभल्लेन सर्वावरणातिगेन\nशिरः शरीरात् प्रममाथ भूयः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2174184, "chapter_id": 4701, "verse_number": "६६", "content_sanskrit": "शरेण कार्तस्वरभूषितेन\nदिवाकराभेण सुसंशितेन ।\nहृतोत्तमाङ्गो युधि पाण्डवेन\nपपात भूमौ सुबलस्य पुत्रः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2174185, "chapter_id": 4701, "verse_number": "६७", "content_sanskrit": "शत्रोः शिरो वेगवता शरेण\nसुवर्णपुङ्खेन शिलाशितेन ।\nप्रावेपयत् कुपितः पाण्डुपुत्रो\nयत् तत्कुरूणामनयस्य मूलम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2174186, "chapter_id": 4701, "verse_number": "६८", "content_sanskrit": "मर्मच्छिदा वेगवता शरेण\nतस्योत्तमाङ्गं च भुजौ सुवृत्तौ ।\nशक्तिश्च भूमौ निपपात पूर्वं\nपश्चात् कबन्धं रुधिरावसिक्तम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2174187, "chapter_id": 4701, "verse_number": "६९", "content_sanskrit": "विष्यन्दमानं निपपात घोरं\nरथोत्तमात् पार्थिव पार्थिवस्य ।\nसुवर्णतारागणभूषिताङ्गं\nस सिंह(ह्य)नादं विनदन् महात्मा\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2174188, "chapter_id": 4701, "verse_number": "७०", "content_sanskrit": "निहत्य पापं सुबलस्य पुत्रं\nजातं कुरूणामनयस्य मूलम् ।\nसुवर्णपुङ्खैरिषुभिः पतन्तम्\nप्रावेशयत् कुपितः पाण्डुपुत्रः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2174189, "chapter_id": 4701, "verse_number": "७१", "content_sanskrit": "तं पाण्डुपुत्रं प्रतिपूजयन्तो\nहृष्टा ब्रुवाणाः सहदेवमाजौ ।\nदिष्ट्या हतो नैकृतिको दुरात्मा\nसहात्मजो वीर रणे त्वयेति\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2174190, "chapter_id": 4701, "verse_number": "७२", "content_sanskrit": "हृतोत्तमाङ्गं शकुनिं समीक्ष्य\nभूमौ शयानं रुधिरार्द्रगात्रम् ।\nयोधास्त्वदीया भयनष्टसत्त्वा\nदिशः प्रजग्मुः प्रगृहीतशस्त्राः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2174191, "chapter_id": 4701, "verse_number": "७३", "content_sanskrit": "विप्रद्रुताः शुष्कमुखा विसञ्ज्ञा\nगाण्डीवघोषेण समाहताश्च ।\nइतस्ततो भग्नरथाश्वनागाः\nपदातयश्चैव सधार्तराष्ट्राः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2174192, "chapter_id": 4701, "verse_number": "७४", "content_sanskrit": "ततो रथाच्छकुनिं पातयित्वा\nमुदाऽन्विता भारत पाण्डवेयाः ।\nशङ्खान् प्रदध्मुः समरे प्रहृष्टाः\nसकेशवाः सैनिकान् हर्षयन्तः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2174193, "chapter_id": 4701, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि शकुनिवधो नाम अष्टाविंशोऽध्यायः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2174194, "chapter_id": 4701, "verse_number": "२८", "content_sanskrit": "शल्यवधपर्वणि अष्टाविंशोऽध्यायः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2174195, "chapter_id": 4701, "verse_number": "", "content_sanskrit": "॥ समाप्तं शल्यवधपर्व ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]