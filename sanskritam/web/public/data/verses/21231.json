[{"id": 7001231000, "chapter_id": 21231, "verse_number": "२-५-४-१", "content_sanskrit": "कृष्ण उवाच ।\nभगवन्परमेशस्य शर्वस्यामिततेजसः ।\nमूर्तिभिर्विश्वमेवेदं यथा व्याप्तं तथा श्रुतम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001231001, "chapter_id": 21231, "verse_number": "२-५-४-२", "content_sanskrit": "अथैतज्ज्ञातुमिच्छामि याथात्म्यं पमेशयोः ।\nस्त्रीपुंभावात्मकं चेदं ताभ्यां कथमधिष्ठितम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001231002, "chapter_id": 21231, "verse_number": "२-५-४-३", "content_sanskrit": "उपमन्युरुवाच ।\nश्रीमद्विभूतिं शिवयोर्याथात्म्यं च समासतः ।\nवक्ष्ये तद्विस्तराद्वक्तुं भवेनापि न शक्यते॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001231003, "chapter_id": 21231, "verse_number": "२-५-४-४", "content_sanskrit": "शक्तिः साक्षान्महादेवी महादेवश्च शक्तिमान् ।\nतयोर्विभूतिलेशो वै सर्वमेतच्चराचरम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001231004, "chapter_id": 21231, "verse_number": "२-५-४-५", "content_sanskrit": "वस्तु किंचिदचिद्रूपं किंचिद्वस्तु चिदात्मकम् ।\nद्वयं शुद्धमशुद्धं च परं चापरमेव च॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001231005, "chapter_id": 21231, "verse_number": "२-५-४-६", "content_sanskrit": "यत्संसरति चिच्चक्रमचिच्चक्रसमन्वितम् ।\nतदेवाशुद्धमपरमितरं तु परं शुभम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001231006, "chapter_id": 21231, "verse_number": "२-५-४-७", "content_sanskrit": "अपरं च परं चैव द्वयं चिदचिदात्मकम् ।\nशिवस्य च शिवायाश्च स्वाम्यं चैतत्स्वभावतः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001231007, "chapter_id": 21231, "verse_number": "२-५-४-८", "content_sanskrit": "शिवयोर्वै वशे विश्वं न विश्वस्य वशे शिवौ ।\nईशितव्यमिदं यस्मात्तस्माद्विश्वेश्वरौ शिवौ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001231008, "chapter_id": 21231, "verse_number": "२-५-४-९", "content_sanskrit": "यथा शिवस्तथा देवी यथा देवी तथा शिवः ।\nनानयोरंतरं विद्याच्चंद्रचन्द्रिकयोरिव॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001231009, "chapter_id": 21231, "verse_number": "२-५-४-१०", "content_sanskrit": "चंद्रो न खलु भात्येष यथा चंद्रिकया विना ।\nन भाति विद्यमानो ऽपि तथा शक्त्या विना शिवः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001231010, "chapter_id": 21231, "verse_number": "२-५-४-११", "content_sanskrit": "प्रभया हि विनायद्वद्भानुरेष न विद्यते ।\nप्रभा च भानुना तेन सुतरां तदुपाश्रया॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001231011, "chapter_id": 21231, "verse_number": "२-५-४-१२", "content_sanskrit": "एवं परस्परापेक्षा शक्तिशक्तिमतोः स्थिता ।\nन शिवेन विना शक्तिर्न शक्त्या च विना शिवः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001231012, "chapter_id": 21231, "verse_number": "२-५-४-१३", "content_sanskrit": "शक्तौयया शिवो नित्यं भक्तौ मुक्तौ च देहिनाम् ।\nआद्या सैका परा शक्तिश्चिन्मयी शिवसंश्रया॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001231013, "chapter_id": 21231, "verse_number": "२-५-४-१४", "content_sanskrit": "यामाहुरखिलेशस्य तैस्तैरनुगुणैर्गुणैः ।\nसमानधर्मिणीमेव शिवस्य परमात्मनः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001231014, "chapter_id": 21231, "verse_number": "२-५-४-१५", "content_sanskrit": "सैका परा च चिद्रूपा शक्तिः प्रसवधर्मिणी ।\nविभज्य बहुधा विश्वं विदधाति शिवेच्छया॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001231015, "chapter_id": 21231, "verse_number": "२-५-४-१६", "content_sanskrit": "सा मूलप्रकृतिर्माया त्रिगुणा च त्रिधा स्मृता ।\nशिवया च विपर्यस्तं यया ततमिदं जगत्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001231016, "chapter_id": 21231, "verse_number": "२-५-४-१७", "content_sanskrit": "एकधा च द्विधा चैव तथा शतसहस्रधा ।\nशक्तयः खलु भिद्यंते बहुधा व्यवहारतः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001231017, "chapter_id": 21231, "verse_number": "२-५-४-१८", "content_sanskrit": "शिवेच्छया पराशक्तिः शिवतत्त्वैकतां गता ।\nततः परिस्फुरत्यादौ सर्गे तैलं तिलादिव॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001231018, "chapter_id": 21231, "verse_number": "२-५-४-१९", "content_sanskrit": "ततः क्रियाख्यया शक्त्या शक्तौ शक्तिमदुत्थया ।\nतस्यां विक्षोभ्यमाणायामादौ नादः समुद्बभौ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001231019, "chapter_id": 21231, "verse_number": "२-५-४-२०", "content_sanskrit": "नादाद्विनिःसृतो बिंदुर्बिंदोदेवस्सदाशिवः ।\nतस्मान्महेश्वरो जातः शुद्धविद्या महेश्वरात्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001231020, "chapter_id": 21231, "verse_number": "२-५-४-२१", "content_sanskrit": "सा वाचामीश्वरी शक्तिर्वागीशाख्या हि शूलिनः ।\nया सा वर्णस्वरूपेण मातृकेपि विजृम्भते॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001231021, "chapter_id": 21231, "verse_number": "२-५-४-२२", "content_sanskrit": "अथानंतसमावेशान्माया कालमवासृजत् ।\nनियतिञ्च कलां विद्यां कलातोरागपूरुषौ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001231022, "chapter_id": 21231, "verse_number": "२-५-४-२३", "content_sanskrit": "मायातः पुनरेवाभूदव्यक्तं त्रिगुणात्मकम् ।\nत्रिगुणाच्च ततो व्यक्ताद्विभक्ताः स्युस्त्रयो गुणाः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001231023, "chapter_id": 21231, "verse_number": "२-५-४-२४", "content_sanskrit": "सत्त्वं रजस्तमश्चेति यैर्व्याप्तमखिलं जगत् ।\nगुणेभ्यः क्षोभ्यमाणेभ्यो गुणेशाख्यास्त्रिमूर्तयः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001231024, "chapter_id": 21231, "verse_number": "२-५-४-२५", "content_sanskrit": "अभवन्महदादीनि तत्त्वानि च यथाक्रमम् ।\nतेभ्यस्स्युरण्डपिण्डानि त्वसंख्यानि शिवाज्ञया॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001231025, "chapter_id": 21231, "verse_number": "२-५-४-२६", "content_sanskrit": "अधिष्ठितान्यनन्ताद्यैर्विद्येशैश्चक्रवर्तिभिः ।\nशरीरांतरभेदेन शक्तेर्भेदाः प्रकीर्तिताः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001231026, "chapter_id": 21231, "verse_number": "२-५-४-२७", "content_sanskrit": "नानारूपास्तु विज्ञेयाः स्थूलसूक्ष्मविभेदतः ।\nरुद्रस्य रौद्री सा शक्तिर्विष्णौर्वै वैष्णवी मता॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001231027, "chapter_id": 21231, "verse_number": "२-५-४-२८", "content_sanskrit": "ब्रह्माणी ब्रह्मणः प्रोक्ता चेन्द्रस्यैंद्रीति कथ्यते ।\nकिमत्र बहुनोक्तेन यद्विश्वमिति कीर्तितम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001231028, "chapter_id": 21231, "verse_number": "२-५-४-२९", "content_sanskrit": "शक्यात्मनैव तद्व्याप्तं यथा देहे ऽंतरात्मना ।\nतस्माच्छक्तिमयं सर्वं जगत्स्थावरजंगमम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001231029, "chapter_id": 21231, "verse_number": "२-५-४-३०", "content_sanskrit": "कला या परमा शक्तिः कथिता परमात्मनः ।\nएवमेषा परा शक्तिरीश्वरेच्छानुयायिनी॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001231030, "chapter_id": 21231, "verse_number": "२-५-४-३१", "content_sanskrit": "स्थिरं चरं च यद्विश्वं सृजतीति विनिश्चयः ।\nज्ञानक्रिया चिकीर्षाभिस्तिसृभिस्स्वात्मशक्तिभिः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001231031, "chapter_id": 21231, "verse_number": "२-५-४-३२", "content_sanskrit": "शक्तिमानीश्वरः शश्वद्विश्वं व्याप्याधितिष्ठति ।\nइदमित्थमिदं नेत्थं भवेदित्येवमात्मिका॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001231032, "chapter_id": 21231, "verse_number": "२-५-४-३३", "content_sanskrit": "इच्छाशक्तिर्महेशस्य नित्या कार्यनियामिका ।\nज्ञानशक्तिस्तु तत्कार्यं करणं कारणं तथा॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001231033, "chapter_id": 21231, "verse_number": "२-५-४-३४", "content_sanskrit": "प्रयोजनं च तत्त्वेन बुद्धिरूपाध्यवस्यति ।\nयथेप्सितं क्रियाशक्तिर्यथाध्यवसितं जगत्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001231034, "chapter_id": 21231, "verse_number": "२-५-४-३५", "content_sanskrit": "कल्पयत्यखिलं कार्यं क्षणात्संकल्परूपिणी ।\nयथा शक्तित्रयोत्थानं शक्तिप्रसवधर्मिणी॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001231035, "chapter_id": 21231, "verse_number": "२-५-४-३६", "content_sanskrit": "शक्त्या परमया नुन्ना प्रसूते सकलं जगत् ।\nएवं शक्तिसमायोगाच्छक्तिमानुच्यते शिवः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001231036, "chapter_id": 21231, "verse_number": "२-५-४-३७", "content_sanskrit": "शक्तिशक्तिमदुत्थं तु शाक्तं शैवमिदं जगत् ।\nयथा न जायते पुत्रः पितरं मातरं विना॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001231037, "chapter_id": 21231, "verse_number": "२-५-४-३८", "content_sanskrit": "तथा भवं भवानीं च विना नैतच्चराचरम् ।\nस्त्रीपुंसप्रभवं विश्वं स्त्रीपुंसात्मकमेव च॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001231038, "chapter_id": 21231, "verse_number": "२-५-४-३९", "content_sanskrit": "स्त्रीपुंसयोर्विभूतिश्च स्त्रीपुंसाभ्यामधिष्ठितम् ।\nपरमात्मा शिवः प्रोक्तश्शिवा सा च प्रकीर्तिता॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001231039, "chapter_id": 21231, "verse_number": "२-५-४-४०", "content_sanskrit": "शिवस्सदाशिवः प्रोक्तः शिवा सा च मनोन्मनी ।\nशिवो महेश्वरो ज्ञेयः शिवा मायेति कथ्यते॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001231040, "chapter_id": 21231, "verse_number": "२-५-४-४१", "content_sanskrit": "पुरुषः परमेशानः प्रकृतिः परमेश्वरी ।\nरुद्रो महेश्वरस्साक्षाद्रुद्राणी रुद्रवल्लभा॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001231041, "chapter_id": 21231, "verse_number": "२-५-४-४२", "content_sanskrit": "विष्णुर्विश्वेश्वरो देवो लक्ष्मीर्विश्वेश्वरप्रिया ।\nब्रह्मा शिवो यदा स्रष्टा ब्रह्माणी ब्रह्मणः प्रिया॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001231042, "chapter_id": 21231, "verse_number": "२-५-४-४३", "content_sanskrit": "भास्करो भगवाञ्छंभुः प्रभा भगवती शिवा ।\nमहेंद्रो मन्मथारातिः शची शैलेन्द्रकन्यका॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001231043, "chapter_id": 21231, "verse_number": "२-५-४-४४", "content_sanskrit": "जातवेदा महादेवः स्वाहा शर्वार्धदेहिनी ।\nयमस्त्रियंबको देवस्तत्प्रिया गिरिकन्यका॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001231044, "chapter_id": 21231, "verse_number": "२-५-४-४५", "content_sanskrit": "निरृतिर्भगवानीशो नैरृती नगनंदनी ।\nवरुणो भगवान्रुद्रो वारुणी भूधरात्मजा॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001231045, "chapter_id": 21231, "verse_number": "२-५-४-४६", "content_sanskrit": "बालेंदुशेखरो वायुः शिवा शिवमनोहरा ।\nयक्षो यज्ञशिरोहर्ता ऋद्धिर्हिमगिरीन्द्रजा॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001231046, "chapter_id": 21231, "verse_number": "२-५-४-४७", "content_sanskrit": "चंद्रार्धशेखरश्चंद्रो रोहिणी रुद्रवल्लभा ।\nईशानः परमेशानस्तदार्या परमेश्वरी॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001231047, "chapter_id": 21231, "verse_number": "२-५-४-४८", "content_sanskrit": "अनंतवलयो ऽनंतो ह्यनंतानंतवल्लभा ।\nकालाग्निरुद्रः कालारिः काली कालांतकप्रिया॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001231048, "chapter_id": 21231, "verse_number": "२-५-४-४९", "content_sanskrit": "पुरुषाख्यो मनुश्शंभुः शतरूपा शिवप्रिया ।\nदक्षस्साक्षान्महादेवः प्रसूतिः परमेश्वरी॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001231049, "chapter_id": 21231, "verse_number": "२-५-४-५०", "content_sanskrit": "रुचिर्भवो भवानी च बुधैराकूतिरुच्यते ।\nभृगुर्भगाक्षिहा देवः ख्यातिस्त्रिनयनप्रिया॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001231050, "chapter_id": 21231, "verse_number": "२-५-४-५१", "content_sanskrit": "मरीचिभगवान्रुद्रः संभूतिश्शर्ववल्लभा ।\nगंगाधरो ऽंगिरा ज्ञेयः स्मृतिः साक्षादुमा स्मृता॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001231051, "chapter_id": 21231, "verse_number": "२-५-४-५२", "content_sanskrit": "पुलस्त्यः शशभृन्मौलिः प्रीतिः कांता पिनाकिनः ।\nपुलहस्त्रिपुरध्वंसी तत्प्रिया तु शिवप्रिया॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001231052, "chapter_id": 21231, "verse_number": "२-५-४-५३", "content_sanskrit": "क्रतुध्वंसी क्रतुः प्रोक्तः संनतिर्दयिता विभोः ।\nत्रिनेत्रो ऽत्रिरुमा साक्षादनसूया स्मृता बुधैः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001231053, "chapter_id": 21231, "verse_number": "२-५-४-५४", "content_sanskrit": "कश्यपः कालहा देवो देवमाता महेश्वरी ।\nवसिष्ठो मन्मथारातिर्देवी साक्षादरुंधती॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001231054, "chapter_id": 21231, "verse_number": "२-५-४-५५", "content_sanskrit": "शंकरः पुरुषास्सर्वे स्त्रियस्सर्वा महेश्वरी ।\nसर्वे स्त्रीपुरुषास्तस्मात्तयोरेव विभूतयः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001231055, "chapter_id": 21231, "verse_number": "२-५-४-५६", "content_sanskrit": "विषयी भगवानीशो विषयः परमेश्वरी ।\nश्राव्यं सर्वमुमारूपं श्रोता शूलवरायुधः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001231056, "chapter_id": 21231, "verse_number": "२-५-४-५७", "content_sanskrit": "प्रष्टव्यं वस्तुजातं तु धत्ते शंकरवल्लभा ।\nप्रष्टा स एव विश्वात्मा बालचन्द्रावतंसकः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001231057, "chapter_id": 21231, "verse_number": "२-५-४-५८", "content_sanskrit": "द्रष्टव्यं वस्तुरूपं तु बिभर्ति वक्तवल्लभा ।\nद्रष्टा विश्वेश्वरो देवः शशिखंडशिखामणिः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001231058, "chapter_id": 21231, "verse_number": "२-५-४-५९", "content_sanskrit": "रसजातं महादेवी देवो रसयिता शिवः ।\nप्रेयजातं च गिरिजा प्रेयांश्चैव गराशनः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001231059, "chapter_id": 21231, "verse_number": "२-५-४-६०", "content_sanskrit": "मंतव्यवस्तुतां धत्ते सदा देवी महेश्वरी ।\nमंता स एव विश्वात्मा महादेवो महेश्वरः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001231060, "chapter_id": 21231, "verse_number": "२-५-४-६१", "content_sanskrit": "बोद्धव्यवस्तुरूपं तु बिभर्ति भववल्लभा ।\nदेवस्स एव भगवान्बोद्धा मुग्धेन्दुशेखरः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001231061, "chapter_id": 21231, "verse_number": "२-५-४-६२", "content_sanskrit": "प्राणः पिनाकी सर्वेषां प्राणिनां भगवान्प्रभुः ।\nप्राणस्थितिस्तु सर्वेषामंबिका चांबुरूपिणी॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001231062, "chapter_id": 21231, "verse_number": "२-५-४-६३", "content_sanskrit": "बिभर्ति क्षेत्रतां देवी त्रिपुरांतकवल्लभा ।\nक्षेत्रज्ञत्वं तदा धत्ते भगवानंतकांतकः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001231063, "chapter_id": 21231, "verse_number": "२-५-४-६४", "content_sanskrit": "अहः शूलायुधो देवः शूलपाणिप्रिया निशा ।\nआकाशः शंकरो देवः पृथिवी शंकरप्रिया॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001231064, "chapter_id": 21231, "verse_number": "२-५-४-६५", "content_sanskrit": "समुद्रो भगवानीशो वेला शैलेन्द्रकन्यका ।\nवृक्षो वृषध्वजो देवो लता विश्वेश्वरप्रिया॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001231065, "chapter_id": 21231, "verse_number": "२-५-४-६६", "content_sanskrit": "पुंल्लिंगमखिलं धत्ते भगवान्पुरशासनः ।\nस्त्रिलिंगं चाखिलं धत्ते देवी देवमनोरमा॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001231066, "chapter_id": 21231, "verse_number": "२-५-४-६७", "content_sanskrit": "शब्दजालमशेषं तु धत्ते सर्वस्य वल्लभा ।\nअर्थस्वरूपमखिलं धत्ते मुग्धेन्दुशेखरः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001231067, "chapter_id": 21231, "verse_number": "२-५-४-६८", "content_sanskrit": "यस्य यस्य पदार्थस्य या या शक्तिरुदाहृता ।\nसा सा विश्वेश्वरी देवी स स सर्वो महेश्वरः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001231068, "chapter_id": 21231, "verse_number": "२-५-४-६९", "content_sanskrit": "यत्परं यत्पवित्रं च यत्पुण्यं यच्च मंगलम् ।\nतत्तदाह महाभागास्तयोस्तेजोविजृंभितम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001231069, "chapter_id": 21231, "verse_number": "२-५-४-७०", "content_sanskrit": "यथा दीपस्य दीप्तस्य शिखा दीपयते गृहम् ।\nतथा तेजस्तयोरेतद्व्याप्य दीपयते जगत्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001231070, "chapter_id": 21231, "verse_number": "२-५-४-७१", "content_sanskrit": "तृणादिशिवमूर्त्यंतं विश्वख्यातिशयक्रमः ।\nसन्निकर्षक्रमवशात्तयोरिति परा श्रुतिः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001231071, "chapter_id": 21231, "verse_number": "२-५-४-७२", "content_sanskrit": "सर्वाकारात्मकावेतौ सर्वश्रेयोविधायिनौ ।\nपूजनीयौ नमस्कार्यौ चिंतनीयौ च सर्वदा॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001231072, "chapter_id": 21231, "verse_number": "२-५-४-७३", "content_sanskrit": "यथाप्रज्ञमिदं कृष्ण याथात्म्यं परमेशयोः ।\nकथितं हि मया ते ऽद्य न तु तावदियत्तया॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001231073, "chapter_id": 21231, "verse_number": "२-५-४-७४", "content_sanskrit": "तत्कथं शक्यते वक्तुं याथात्म्यं परमेशयोः ।\nमहतामपि सर्वेषां मनसो ऽपि बहिर्गतम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001231074, "chapter_id": 21231, "verse_number": "२-५-४-७५", "content_sanskrit": "अंतर्गतमनन्यानामीश्वरार्पितचेतसाम् ।\nअन्येषां बुद्ध्यनारूढमारूढं च यथैव तत्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001231075, "chapter_id": 21231, "verse_number": "२-५-४-७६", "content_sanskrit": "येयमुक्ता विभूतिर्वै प्राकृती सा परा मता ।\nअप्राकृतां परामन्यां गुह्यां गुह्यविदो विदुः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001231076, "chapter_id": 21231, "verse_number": "२-५-४-७७", "content_sanskrit": "यतो वाचो निवर्तंते मनसा चेन्द्रियैस्सह ।\nअप्राकृती परा चैषा विभूतिः पारमेश्वरी॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001231077, "chapter_id": 21231, "verse_number": "२-५-४-७८", "content_sanskrit": "सैवेह परमं धाम सैवेह परमा गतिः ।\nसैवेह परमा काष्ठा विभूतिः परमेष्ठिनः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001231078, "chapter_id": 21231, "verse_number": "२-५-४-७९", "content_sanskrit": "तां प्राप्तुं प्रयतंते ऽत्र जितश्वासा जितेंद्रियाः ।\nगर्भकारा गृहद्वारं निश्छिद्रं घटितुं यथा॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001231079, "chapter_id": 21231, "verse_number": "२-५-४-८०", "content_sanskrit": "संसाराशीविषालीढमृतसंजीवनौषधम् ।\nविभूतिं शिवयोर्विद्वान्न बिभेति कुतश्चन॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001231080, "chapter_id": 21231, "verse_number": "२-५-४-८१", "content_sanskrit": "यः परामपरां चैव विभूतिं वेत्ति तत्त्वतः ।\nसो ऽपरो भूतिमुल्लंघ्य परां भूतिं समश्नुते॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001231081, "chapter_id": 21231, "verse_number": "२-५-४-८२", "content_sanskrit": "एतत्ते कथितं कृष्ण याथात्म्यं परमात्मनोः ।\nरहस्यमपि योग्यो ऽसि भर्गभक्तो भवानिति॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001231082, "chapter_id": 21231, "verse_number": "२-५-४-८३", "content_sanskrit": "नाशिष्येभ्यो ऽप्यशैवेभ्यो नाभक्तेभ्यः कदाचन ।\nव्याहरेदीशयोर्भूतिमिति वेदानुशासनम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001231083, "chapter_id": 21231, "verse_number": "२-५-४-८४", "content_sanskrit": "तस्मात्त्वमतिकल्याणपरेभ्यः कथयेन्न हि ।\nत्वादृशेभ्यो ऽनुरूपेभ्यः कथयैतन्न चान्यथा॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001231084, "chapter_id": 21231, "verse_number": "२-५-४-८५", "content_sanskrit": "विभूतिमेतां शिवयोर्योग्येभ्यो यः प्रदापयेत् ।\nसंसारसागरान्मुक्तः शिवसायुज्यमाप्नुयात्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001231085, "chapter_id": 21231, "verse_number": "२-५-४-८६", "content_sanskrit": "कीर्तनादस्य नश्यंति महान्त्यः पापकोटयः ।\nत्रिश्चतुर्धासमभ्यस्तैर्विनश्यंति ततो ऽधिकाः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001231086, "chapter_id": 21231, "verse_number": "२-५-४-८७", "content_sanskrit": "नश्यंत्यनिष्टरिपवो वर्धन्ते सुहृदस्तथा ।\nविद्या च वर्धते शैवी मतिस्सत्ये प्रवर्तते॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001231087, "chapter_id": 21231, "verse_number": "२-५-४-८८", "content_sanskrit": "भक्तिः पराः शिवे साम्बे सानुगे सपरिच्छिदे ।\nयद्यदिष्टतमं चान्यत्तत्तदाप्नोत्यसंशयम्॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001231088, "chapter_id": 21231, "verse_number": "२-५-४-८९", "content_sanskrit": "अन्तःशुचिः शिवे भक्तो विस्रब्धः कीर्तयेद्यदि ।\nप्रबलैः कर्मभिः पूर्वैः फलं चेत्प्रतिबध्यते ।\nपुनः पुनः समभ्यस्येत्तस्य नास्तीह दुर्ल्लभम्॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]