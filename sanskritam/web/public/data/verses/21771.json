[{"id": 7001771000, "chapter_id": 21771, "verse_number": "२-३२-१", "content_sanskrit": "वसिष्ठ उवाच ।\nसंध्यावलीवचः श्रुत्वा मोहिनी दुहिता विधेः ।\nउवाच तत्परा स्वीये कार्ये मोहकरंडिका ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001771001, "chapter_id": 21771, "verse_number": "२-३२-२", "content_sanskrit": "यद्येवं त्वं विजानासि धर्माधर्मगतिं शुभे ।\nभर्तुरर्थे प्रदात्री च धनजीवितयोरपि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001771002, "chapter_id": 21771, "verse_number": "२-३२-३", "content_sanskrit": "तदाहं याचये वित्तं जीवितादधिकं शुभे ।\nदेहि पुत्रशिरों मह्यं यदिष्टटं हृदयाधिकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001771003, "chapter_id": 21771, "verse_number": "२-३२-४", "content_sanskrit": "यदि नो भोजनं कुर्यात्संप्राप्ते हरिवासरे ।\nतदा स्वहस्ते संगृह्य खङगं राजा पतिस्तव ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001771004, "chapter_id": 21771, "verse_number": "२-३२-५", "content_sanskrit": "धर्मांगदशिरश्चारु चंद्रबिंबोपमं शुभम् ।\nअजातश्मश्रुकं चैव कुंडलाभ्यां विभूषितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001771005, "chapter_id": 21771, "verse_number": "२-३२-६", "content_sanskrit": "छित्वा शीघ्रं पातयतु ममोत्संगे सुलोचने ।\nएतद्वा कुरुतद्भद्रे यदान्नं न भुनक्ति च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001771006, "chapter_id": 21771, "verse_number": "२-३२-७", "content_sanskrit": "दिने माधवदेवस्य पापसंघविनाशने ।\nतच्छ्रुत्वा वचनं तस्या मोहिन्याः कटुकाक्षरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001771007, "chapter_id": 21771, "verse_number": "२-३२-८", "content_sanskrit": "प्रचकंपे क्षणं देवी शीतार्ता कदली यथा ।\nसंध्यावली ततो धैर्यमास्थाय वरवार्णिनी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001771008, "chapter_id": 21771, "verse_number": "२-३२-९", "content_sanskrit": "उवाच मोहिनीं वाक्यं सुमुखी प्रहसंत्यपि ।\nश्रूयंते हि पुराणेषु गाथाः सुभ्रु समीरिताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001771009, "chapter_id": 21771, "verse_number": "२-३२-१०", "content_sanskrit": "द्वादशी प्रति संबद्धाः स्वर्गमोक्षप्रदायिकाः ।\nधनं त्यजेत्त्यजेद्दाराञ्जीवितं च गृहं त्यजेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001771010, "chapter_id": 21771, "verse_number": "२-३२-११", "content_sanskrit": "त्यजेद्देशं तथा भूपं स्वर्गं मित्रं गुरुं त्यजेत् ।\nत्यजेत्तीर्थं त्यजेद्धर्मं त्यजेदत्यंतसुप्रियम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001771011, "chapter_id": 21771, "verse_number": "२-३२-१२", "content_sanskrit": "त्यजेद्योगं त्यजेद्दानं ज्ञानं पुण्यक्रिया त्यजेत् ।\nतपस्त्यजेत्त्यजेद्विद्यां सिद्धिं मोक्षं त्यजेच्छुभे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001771012, "chapter_id": 21771, "verse_number": "२-३२-१३", "content_sanskrit": "न त्यजेद्‌द्वादगशीं पुण्यां पक्षयोरुभयोरपि ।\nइह संबंधिनः सर्वे पुत्रभ्रातृसुहृत्प्रियाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001771013, "chapter_id": 21771, "verse_number": "२-३२-१४", "content_sanskrit": "ऐहिकामुष्मिके देवि साधनी द्वादशी स्मृता ।\nद्वादश्यास्तु प्रभावेण सर्वं क्षेमं भविष्यति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001771014, "chapter_id": 21771, "verse_number": "२-३२-१५", "content_sanskrit": "दापये तव तुष्ट्यर्थं धर्मांगदशिरः शुभे ।\nविश्वासं कुरु मे वाक्ये सुखिनी भव शोभने ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001771015, "chapter_id": 21771, "verse_number": "२-३२-१६", "content_sanskrit": "इहार्थं श्रूयते भद्रे इतिहासः पुरातनः ।\nकथयिष्यामि ते भद्रे सावधाना श्रुणुष्व मे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001771016, "chapter_id": 21771, "verse_number": "२-३२-१७", "content_sanskrit": "आसीद्विरोचनः पूर्वं दैत्यो धर्मपरायणः ।\nतस्य भार्या विशालाक्षी द्विजपूजनतत्परा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001771017, "chapter_id": 21771, "verse_number": "२-३२-१८", "content_sanskrit": "नित्यमेकमृषिं प्रातः पूजयित्वा यथाविधि ।\nपादोदकं तस्य सुभ्रु भक्त्या पिबति हृष्टधीः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001771018, "chapter_id": 21771, "verse_number": "२-३२-१९", "content_sanskrit": "प्राह्लादिशंकिता देवा आसन्पूर्वं मृते सति ।\nहिरण्यकशिपौ राज्यं शासति ह्युग्रतेजसि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001771019, "chapter_id": 21771, "verse_number": "२-३२-२०", "content_sanskrit": "प्राह्लादौ ह्लादसंयुक्ते चेरुर्व्यग्रा महीतले ।\nएकदा शक्रमुख्यास्ते देवाः समंत्र्य वाक्पतिम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001771020, "chapter_id": 21771, "verse_number": "२-३२-२१", "content_sanskrit": "प्रोचुः किं कार्यमधुनास्माभिः शत्रु प्रतापितैः ।\nतच्छ्रुत्वा वचनं तेषां देवानां गुरुरब्रवीत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001771021, "chapter_id": 21771, "verse_number": "२-३२-२२", "content_sanskrit": "विष्णुर्विज्ञापनीयोऽद्य दुःखं प्राप्तैः सुरव्रजैः ।\nतच्छ्रुत्वा भाषितं तस्य गुरोरमिततेजसः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001771022, "chapter_id": 21771, "verse_number": "२-३२-२३", "content_sanskrit": "विरोचनप्राणहत्यै जग्मुर्वैकुंठमंतिके ।\nतत्र गत्वा सुरश्रेष्ठं वैकुंठं तुष्टुवुः स्तवैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001771023, "chapter_id": 21771, "verse_number": "२-३२-२४", "content_sanskrit": "देवा ऊचुः ।\nनमो देवाधिदेवाय विष्णवेऽमिततेजसे ।\nभक्तविघ्नविनाशाय वैकुण्ठाय नमो नमः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001771024, "chapter_id": 21771, "verse_number": "२-३२-२५", "content_sanskrit": "हरयेऽद्भुतसिंहाय वामनाय महात्मने ।\nक्रोडरूपाय मत्स्याय प्रलयाब्धिनिवासिने ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001771025, "chapter_id": 21771, "verse_number": "२-३२-२६", "content_sanskrit": "कूर्माय मन्दरधृते भार्गवायाब्धिशायिने ।\nरामायाखिलनाथाय विश्वेशाय च साक्षिणे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001771026, "chapter_id": 21771, "verse_number": "२-३२-२७", "content_sanskrit": "दत्तात्रेयाय शुद्धाय कपिलायार्तिहारिणे ।\nयज्ञाय धृतधर्माय सनकादिस्वरूपिणे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001771027, "chapter_id": 21771, "verse_number": "२-३२-२८", "content_sanskrit": "ध्रुवस्य वरदात्रे च पृथवे भूरिकर्मणे ।\nऋषभाय विशुद्धाय हयशीर्षभृतात्मने ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001771028, "chapter_id": 21771, "verse_number": "२-३२-२९", "content_sanskrit": "हंसायागमरूपायामृतकुम्भविधारिणे ।\nकृष्णांय वासुदेवाय संकर्षणवपुर्धृते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001771029, "chapter_id": 21771, "verse_number": "२-३२-३०", "content_sanskrit": "प्रद्युम्नायानिरुद्धाय ब्रह्मणे शंकराय च ।\nकुमाराय गणेशाय नन्दिने भृंगिणे नमः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001771030, "chapter_id": 21771, "verse_number": "२-३२-३१", "content_sanskrit": "गन्धमादनवासाय नरनारायणाय च ।\nजगन्नाथाय नाथाय नमो रामेश्वराय च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001771031, "chapter_id": 21771, "verse_number": "२-३२-३२", "content_sanskrit": "द्वारकावासिने चैव तुलसी वनवासिने ।\nनमः कमलनाभाय नमस्ते पंकजांघ्रये ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001771032, "chapter_id": 21771, "verse_number": "२-३२-३३", "content_sanskrit": "नमः कमलहस्ताय कमलाक्षाय ते नमः ।\nकमलाप्रतिपालाय केशवाय नमो नमः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001771033, "chapter_id": 21771, "verse_number": "२-३२-३४", "content_sanskrit": "नमो भास्कररूपाय शशिरूपधराय च ।\nलोकपालस्वरूपाय प्रजापतिवपुर्धृते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001771034, "chapter_id": 21771, "verse_number": "२-३२-३५", "content_sanskrit": "भूतग्रामस्वरूपाय जीवरूपाय तेजसे ।\nजयाय जयिने नेत्रे नियमाय क्रियात्मने ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001771035, "chapter_id": 21771, "verse_number": "२-३२-३६", "content_sanskrit": "निर्गुणाय निरीहाय नीतिज्ञायाक्रियात्मने ।\nबुद्धाय कल्किरूपाय क्षेत्रज्ञायाक्षराय च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001771036, "chapter_id": 21771, "verse_number": "२-३२-३७", "content_sanskrit": "गोविंदाय जगद्भर्त्रेऽनन्तायाद्याय शार्ङ्गिणे ।\nशंखिने गदिने चैव नमश्चक्रधराय च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001771037, "chapter_id": 21771, "verse_number": "२-३२-३८", "content_sanskrit": "खड्गिने शूलिने चैव सर्वशस्त्रास्त्रघातिने ।\nशरण्याय वरेण्याय पराय परमात्मने ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001771038, "chapter_id": 21771, "verse_number": "२-३२-३९", "content_sanskrit": "हृषीकेशाय विश्वाय विश्वरूपाय ते नमः ।\nकालनाभाय कालाय शशिसूर्य्यदृशे नमः ।\nपूर्णाय परिसेव्याय परात्परतराय च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001771039, "chapter_id": 21771, "verse_number": "२-३२-४०", "content_sanskrit": "जगत्कर्त्रे जगद्भर्त्रे जगद्धात्रेंऽतकाय च ।\nमोहिने क्षोभिने कामरूपिणेऽजाय सूरिणे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001771040, "chapter_id": 21771, "verse_number": "२-३२-४१", "content_sanskrit": "भगवंस्तव संप्राप्ताः शरणं दैत्यतापिताः ।\nतद्विधत्स्वाखिलाधार यथा हि सुखिनो वयम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001771041, "chapter_id": 21771, "verse_number": "२-३२-४२", "content_sanskrit": "पुत्रमित्रकलत्रादिसंयुता विहरामहे ।\nतच्छ्रुत्वा स्तवनं तेषां वैकुंठः प्रीतमानसः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001771042, "chapter_id": 21771, "verse_number": "२-३२-४३", "content_sanskrit": "प्रददौ दर्शनं तेषां दैत्यसं संतापितात्मनाम् ।\nते दृष्ट्वा देवदेवेशं वैकुंठं स्निग्धमानसम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001771043, "chapter_id": 21771, "verse_number": "२-३२-४४", "content_sanskrit": "विरोचनवधायाशु प्रार्थयामासुरादरात् ।\nतच्छ्रुत्वा शक्रमुख्यानां कार्यं कार्यविदां वरः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001771044, "chapter_id": 21771, "verse_number": "२-३२-४५", "content_sanskrit": "समाश्वास्य सुरान्प्रीत्या विससर्ज मुदान्वितान् ।\nगतेषु देववर्गेषु सर्वोपायविदांवरः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001771045, "chapter_id": 21771, "verse_number": "२-३२-४६", "content_sanskrit": "वृद्धब्राह्मणरूपेण विरोचनगृहं ययौ ।\nद्विजपूजनकाले तु संप्राप्तः कार्यसाधकः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001771046, "chapter_id": 21771, "verse_number": "२-३२-४७", "content_sanskrit": "तं तु दृष्ट्वा विशालाक्षी ब्राह्मणं हृष्टमानसा ।\nअपूर्वं भक्तिभावेन ददौ सत्कृत्य चासनम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001771047, "chapter_id": 21771, "verse_number": "२-३२-४८", "content_sanskrit": "सोऽनंगीकृत्य तद्दत्तमासनं प्राह तां शुभे ।\nनाहं समाददे देवि त्वद्दत्तं परमासनम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001771048, "chapter_id": 21771, "verse_number": "२-३२-४९", "content_sanskrit": "श्रृणु मे कार्यमतुलं यदर्थमहमागतः ।\nयन्मे मनोगतं कार्यं तद्विज्ञाय च मानिनि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001771049, "chapter_id": 21771, "verse_number": "२-३२-५०", "content_sanskrit": "योंऽगीकरोति तत्पूजां ग्रहीष्यामि वरानने ।\nतच्छ्रुत्वा वृद्धविप्रस्य वाक्यं वाक्यविशारदा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001771050, "chapter_id": 21771, "verse_number": "२-३२-५१", "content_sanskrit": "मायया मोहिता विष्णोः स्त्रीत्वाच्चाहातिहर्षिता ।\nविशालाक्ष्युवाच ।\nयत्ते मनोगतं विप्र तद्दास्यामि गृहाणमे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001771051, "chapter_id": 21771, "verse_number": "२-३२-५२", "content_sanskrit": "आसनं पादसलिलं देहि मे वांछितार्थदम् ।\nइत्युक्तः स द्विजः प्राह न प्रत्येमि स्त्रिया वचः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001771052, "chapter_id": 21771, "verse_number": "२-३२-५३", "content_sanskrit": "तव भर्ता यदि वदेत्तदा मे प्रत्ययो भवेत् ।\nतदाकर्ण्य द्विजेनोक्तं विरोचनगृहेश्वरी ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001771053, "chapter_id": 21771, "verse_number": "२-३२-५४", "content_sanskrit": "पतिमाकारयामास तत्रैव द्विजसन्निधौ ।\nस प्राप्तो दूतवाक्येन प्राह्लादिर्हृष्टमानसः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001771054, "chapter_id": 21771, "verse_number": "२-३२-५५", "content_sanskrit": "अंतःपुरं यत्र भार्या विशालाक्षी समास्थिता ।\nतमागतं समालोक्य पतिं धर्मपरायणा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001771055, "chapter_id": 21771, "verse_number": "२-३२-५६", "content_sanskrit": "उत्थाय नत्वा विप्राग्र्यमासनं पुनरर्पयत् ।\nयदा तु जगृहे नैव दत्तमासनमादरात् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001771056, "chapter_id": 21771, "verse_number": "२-३२-५७", "content_sanskrit": "राजानं कथयामास दैत्यानां पतिमात्मनः ।\nतद्दृत्तांतमुपाज्ञाय दैत्यराट् स विरोचनः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001771057, "chapter_id": 21771, "verse_number": "२-३२-५८", "content_sanskrit": "भार्यास्नेहेन मुग्धात्मा तत्तदांगीचकार ह ।\nअंगीकृते तु दैत्येन तद्विज्ञाय च मानसम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001771058, "chapter_id": 21771, "verse_number": "२-३२-५९", "content_sanskrit": "उवाच ब्राह्मणो हृष्टः स्वमायुर्मम कल्पय ।\nततस्तु दंपती तत्र मुग्धौ स्वकृतया शुचा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001771059, "chapter_id": 21771, "verse_number": "२-३२-६०", "content_sanskrit": "मुहूर्तं ध्यानमास्थाय करौ बद्धोचतुर्द्विजम् ।\nगृहाण जीवितं विप्र देहि पादोदकं मम ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001771060, "chapter_id": 21771, "verse_number": "२-३२-६१", "content_sanskrit": "त्वयोक्तं वचनं सत्यं कुर्वः प्रीतिमवाप्नुहि ।\nततस्तु विप्रः प्रोतात्मा तदंगीकृत्य चासनम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001771061, "chapter_id": 21771, "verse_number": "२-३२-६२", "content_sanskrit": "पादोदकं ददौ तस्यै भक्त्या प्रीतो जनार्दनः ।\nप्रक्षाल्य पादौ विप्रस्य विशालाक्षी मुदान्विता ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001771062, "chapter_id": 21771, "verse_number": "२-३२-६३", "content_sanskrit": "पत्या सह दधौ मूर्ध्नि अपः पादावनेजनीः ।\nततस्तु सहसा सुभ्रु दंपती दिव्यरूपिणौ ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001771063, "chapter_id": 21771, "verse_number": "२-३२-६४", "content_sanskrit": "विमानवरमारुह्य जग्मतुर्वैष्णवं पदम् ।\nततः प्रसन्नो भगवान् देवशल्यं विमोच्य सः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001771064, "chapter_id": 21771, "verse_number": "२-३२-६५", "content_sanskrit": "ययौ वैकुंठभवनं सर्वैर्देवगणैः स्तुतः ।\nएवं मयापि दातव्यं तव देवि प्रतिश्रुतम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001771065, "chapter_id": 21771, "verse_number": "२-३२-६६", "content_sanskrit": "न सत्याच्चालये देवि पतिं रुक्मांगदाभिधम् ।\nसत्तयमेव मनुष्याणां गतिदं परिकीर्तितम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001771066, "chapter_id": 21771, "verse_number": "२-३२-६७", "content_sanskrit": "सत्याच्च्चुतं मनुष्यं हि श्वपाकादधमं विदुः । ३२-६७ ।\nइत्येवमुक्त्वा कनकावदाता सा मोहिनीं पंकजजन्मजाताम् ।\nजग्राह भर्तुश्चरणौ सुताम्नौ रक्तांगुली पाणियुगेन सुभ्रूः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]