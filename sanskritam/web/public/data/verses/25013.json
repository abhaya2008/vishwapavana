[{"id": 7005013000, "chapter_id": 25013, "verse_number": "७-१-१९६-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि प्रभासं जलसंस्थितम् ।\nवृद्धप्रभासाद्दक्षिणतो नातिदूरे व्यवस्थितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005013001, "chapter_id": 25013, "verse_number": "७-१-१९६-२", "content_sanskrit": "तस्यैव देवि देवस्य शृणु माहात्म्यमुत्तमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005013002, "chapter_id": 25013, "verse_number": "७-१-१९६-३", "content_sanskrit": "जामदग्न्येन रामेण यदा क्षत्त्रवधः कृतः ।\nतदाऽस्य परमा जाता घृणा मनसि भामिनि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005013003, "chapter_id": 25013, "verse_number": "७-१-१९६-४", "content_sanskrit": "ततस्त्वाराधयामास महादेवं सुरेश्वरम् ।\nउग्रं तपः समास्थाय बहून्वर्ष गणान्प्रिये ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005013004, "chapter_id": 25013, "verse_number": "७-१-१९६-५", "content_sanskrit": "ततस्तुष्टो महादेवस्तस्य प्रत्यक्षतां गतः ।\nअब्रवीद्वरदस्तेऽहं वरं वरय सुव्रत ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005013005, "chapter_id": 25013, "verse_number": "७-१-१९६-६", "content_sanskrit": "राम उवाच ।\nयदि तुष्टोऽसि मे देव यदि देयो वरो मम ।\nदर्शयस्व स्वकं लिंगं यज्ञे वज्रेण छादितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005013006, "chapter_id": 25013, "verse_number": "७-१-१९६-७", "content_sanskrit": "घृणा मे महती जाता हत्वेमान्क्षत्रियान्बहून् ।\nदर्शनात्तव लिंगस्य येन मे नश्यते घृणा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005013007, "chapter_id": 25013, "verse_number": "७-१-१९६-८", "content_sanskrit": "तथा मे पातकं सर्वं प्रसादात्तव शंकर ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005013008, "chapter_id": 25013, "verse_number": "७-१-१९६-९", "content_sanskrit": "शंकर उवाच ।\nमम लिंगं सहस्राक्ष उत्थितं तु पुनःपुनः ।\nवज्रेणाच्छादयत्येव भयेन महता वृतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005013009, "chapter_id": 25013, "verse_number": "७-१-१९६-१०", "content_sanskrit": "न तेऽहं दर्शनं यास्ये लिंगरूपी कदाचन ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005013010, "chapter_id": 25013, "verse_number": "७-१-१९६-११", "content_sanskrit": "यन्मां वदसि घृणया वृतोऽहं पातकेन तु ।\nतत्तेऽहं नाशयिष्यामि स्पर्शनात्तु द्विजोत्तम ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005013011, "chapter_id": 25013, "verse_number": "७-१-१९६-१२", "content_sanskrit": "अस्मिञ्जलाश्रये पुण्ये जलमध्ये महामते ।\nउत्थास्यति महालिंगं तस्य त्वं दर्शनं कुरु ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005013012, "chapter_id": 25013, "verse_number": "७-१-१९६-१३", "content_sanskrit": "गमिष्यति घृणा सर्वा निष्पापस्त्वं भविष्यसि ।\nउक्त्वैवमुदतिष्ठच्च जलमध्याद्वरानने ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005013013, "chapter_id": 25013, "verse_number": "७-१-१९६-१४", "content_sanskrit": "जलप्रभासनामास्य ततो जातं धरातले ।\nतस्यालं स्पर्शनाद्देवि शिवलोकं व्रजेन्नरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005013014, "chapter_id": 25013, "verse_number": "७-१-१९६-१५", "content_sanskrit": "एकं भोजयते योऽत्र ब्राह्मणं शंसितव्रतम् ।\nभोजितोऽहं भवेत्तेन सपत्नीको न संशयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005013015, "chapter_id": 25013, "verse_number": "७-१-१९६-१६", "content_sanskrit": "एषा जलप्रभासस्य संभूतिस्ते मयोदिता ।\nश्रुता पापोपशमनी सर्वकामफलप्रदा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005013016, "chapter_id": 25013, "verse_number": "७-१-१९६-१७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीति साहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये जलप्रभासमाहात्म्यवर्णनंनाम षण्णवत्युत्तरशततमोऽध्यायः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]