[{"id": 2041690, "chapter_id": 1927, "verse_number": "५-१७२-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041691, "chapter_id": 1927, "verse_number": "५-१७२-१", "content_sanskrit": "रोचमानो महाराज पाण्डवानां महारथः।\nयोत्स्यतेऽमरवत्संख्ये परसैन्येषु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041692, "chapter_id": 1927, "verse_number": "५-१७२-२", "content_sanskrit": "पुरुजित्कृन्तिभोजश्च महेष्वासो महाबलः ।\nमातुलो भीमसेनस्य स च मेऽतिरथो मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041693, "chapter_id": 1927, "verse_number": "५-१७२-३", "content_sanskrit": "एष वीरो महेष्वासः कृती च निपुणश्च ह ।\nचित्रयोधी च शक्तश्च मतो मे रथपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041694, "chapter_id": 1927, "verse_number": "५-१७२-४", "content_sanskrit": "स योत्स्यति हि विक्रम्य मघवानिव दानवैः ।\nयोधा ये चास्य विख्याताः सर्वे युद्धविशारदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041695, "chapter_id": 1927, "verse_number": "५-१७२-५", "content_sanskrit": "भागिनेयकृते वीरः स करिष्यति संगरे ।\nसुमहत्कर्म पाण्डूनां स्थितः प्रियहिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041696, "chapter_id": 1927, "verse_number": "५-१७२-६", "content_sanskrit": "भैमसेनिर्महाराज हैडिम्बो राक्षसेश्वरः ।\nमतो मे बहुमायावी रथयूथपयूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041697, "chapter_id": 1927, "verse_number": "५-१७२-७", "content_sanskrit": "योत्स्यते समरे तात मायावी समरप्रियः ।\nये चास्य राक्षसा वीराः सचिवा वशवर्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041698, "chapter_id": 1927, "verse_number": "५-१७२-८", "content_sanskrit": "एते चान्ये च बहवो नानाजनपदेश्वराः ।\nसमेताः पाण्डवस्यार्थे वासुदेवपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041699, "chapter_id": 1927, "verse_number": "५-१७२-९", "content_sanskrit": "एते प्राधान्यतो राजन्पाण्डवस्य महात्मनः ।\nरथाश्चातिरथाश्चैव ये चान्येऽर्धंरथा नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041700, "chapter_id": 1927, "verse_number": "५-१७२-१०", "content_sanskrit": "नेष्यन्ति समरे सेनां भीमां यौधिष्ठिरीं नृप ।\nमहेन्द्रेणेव वीरेण पाल्यमानां किरीटिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041701, "chapter_id": 1927, "verse_number": "५-१७२-११", "content_sanskrit": "तैरहं समरे वीर मायाविद्भिर्जयैषिभिः ।\nयोत्स्यामि जयमाकाङ्क्षन्नथ वा निधनं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041702, "chapter_id": 1927, "verse_number": "५-१७२-१२", "content_sanskrit": "वासुदेवं च पार्थं च चक्रगाण्डीवधारिणौ ।\nसन्ध्यागताविवार्केन्दू सभेष्येते रथोत्तमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041703, "chapter_id": 1927, "verse_number": "५-१७२-१३", "content_sanskrit": "यं चैव ते रथोदाराः पाण्डुपुत्रस्य सैनिकाः ।\nसह सैन्यानहं तांश्च प्रतीयां रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041704, "chapter_id": 1927, "verse_number": "५-१७२-१४", "content_sanskrit": "एते रथाश्चातिरथाश्च तुभ्यं\nयथाप्रधानं नृप कीर्तिता मया।\nतथा परे येऽर्धरथाश्च केचि-\nत्तथैंव तेषामपि कौरवेन्द्र ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041705, "chapter_id": 1927, "verse_number": "५-१७२-१५", "content_sanskrit": "अर्जुनं वासुदेवं च ये चान्ये तत्र पार्थिवाः।\nसर्वांस्तान्वारयिष्यामि यावद्द्रक्ष्यामि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041706, "chapter_id": 1927, "verse_number": "५-१७२-१६", "content_sanskrit": "पाञ्चाल्यं तु महाबाहो नाहं हन्यां शिखण्डिनम् ।\nउद्यतेषमथो दृष्ट्वा प्रतियुध्यन्तमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041707, "chapter_id": 1927, "verse_number": "५-१७२-१७", "content_sanskrit": "लोकस्तं वेद यदहं पितुः प्रियचिकीर्षया ।\nप्राप्तं राज्यं परित्यज्य ब्रह्मचर्यव्रते स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041708, "chapter_id": 1927, "verse_number": "५-१७२-१८", "content_sanskrit": "चित्राङ्गदं कौरवाणामाधिपत्येऽभ्यषेचयम्।\nविचित्रवीर्यं च शिशुं यौवराज्येऽभ्यषेचयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041709, "chapter_id": 1927, "verse_number": "५-१७२-१९", "content_sanskrit": "देवव्रतत्वं विज्ञाप्य पृथिवीं सर्वराजसु ।\nनैव हन्यां स्त्रियं जातु न स्त्रीपूर्वं कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041710, "chapter_id": 1927, "verse_number": "५-१७२-२०", "content_sanskrit": "स हि स्त्रीपूर्वको राजञ्शिखण्डी यदि ते श्रुतः ।\nकन्या भूत्वा पुमाञ्चातो न योत्स्ये तेन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041711, "chapter_id": 1927, "verse_number": "५-१७२-२१", "content_sanskrit": "सर्वांस्त्वन्यान्हनिष्यामि पार्थिवान्भरतर्षभ ।\nयान्समेष्यामि समरे न तु कुन्तीसुतान्नृप ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041712, "chapter_id": 1927, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि रथातिरथसंख्यानपर्वणि द्विसप्तत्यधिकशततमोऽध्यायः ॥ ॥ समाप्तं च रथातिरथसंख्यानपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]