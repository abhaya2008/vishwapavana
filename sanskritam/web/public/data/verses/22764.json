[{"id": 7002764000, "chapter_id": 22764, "verse_number": "९-४९-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nशर्करासप्तमीं वक्ष्ये सर्वकल्मषनाशिनीम् ।\nआयुरारोग्यमैश्वर्यं ययानंतं प्रजायते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002764001, "chapter_id": 22764, "verse_number": "९-४९-२", "content_sanskrit": "माधवस्य सिते पक्षे सप्तम्यां श्रद्धयान्वितः ।\nप्रातः स्नात्वा तिलैः शुद्धैः शुक्लमाल्यानुलेपनैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002764002, "chapter_id": 22764, "verse_number": "९-४९-३", "content_sanskrit": "स्थंडिले पद्ममालिख्य कुंकुमेन सकर्णिकम् ।\nतस्मिन्नमः सवित्रेति गन्धपुष्पं निवेदयेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002764003, "chapter_id": 22764, "verse_number": "९-४९-४", "content_sanskrit": "स्थापयेदुदकुंभं च शर्करापात्रसंयुतम् ।\nरक्तवस्त्रैः स्वलंकृत्य शुक्लमाल्यानुलेपनैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002764004, "chapter_id": 22764, "verse_number": "९-४९-५", "content_sanskrit": "सुवर्णाश्वसमायुक्तं मंत्रेणानेन पूजयेत् ।\nविश्वेदेवमयो यस्माद्वेदवादीति पठ्यते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002764005, "chapter_id": 22764, "verse_number": "९-४९-६", "content_sanskrit": "त्वमेवामृतसर्वस्वमतः पाहि सनातन ।\nसौरसूक्तं जपंस्तिष्ठेत्पुराणश्रवणेन वा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002764006, "chapter_id": 22764, "verse_number": "९-४९-७", "content_sanskrit": "अहोरात्रे गते पश्चादष्टम्यां कृतनित्यकः ।\nसर्वं च वेदविदुषे ब्राह्मणायोपपादयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002764007, "chapter_id": 22764, "verse_number": "९-४९-८", "content_sanskrit": "भोजयेच्छक्तितो विप्राञ्छर्कराघृतपायसैः ।\nभुञ्जीत तैललवणं स्वयमप्यथ वाग्यतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002764008, "chapter_id": 22764, "verse_number": "९-४९-९", "content_sanskrit": "अनेन विधिना सर्वं मासिमासि समाचरेत् ।\nवत्सरांते पुनर्दद्याद्ब्राह्मणाय समाहितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002764009, "chapter_id": 22764, "verse_number": "९-४९-१०", "content_sanskrit": "शयनं वस्त्रसंवीतं शर्कराकलशान्वितम् ।\nसर्वोपस्करसंयुक्तं तथैकां गां पयस्विनीम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002764010, "chapter_id": 22764, "verse_number": "९-४९-११", "content_sanskrit": "गृहं च शक्तितो दद्यात्समस्तोपस्करान्वितम् ।\nसहस्रेणापि निष्काणां कृत्वा दद्याच्छतेन वा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002764011, "chapter_id": 22764, "verse_number": "९-४९-१२", "content_sanskrit": "दशभिर्द्वित्रिभिर्निष्कैस्तदर्धेनापि भक्तितः ।\nसुवर्णाश्वः प्रदातव्यः पूर्ववन्मंत्रवाचनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002764012, "chapter_id": 22764, "verse_number": "९-४९-१३", "content_sanskrit": "वित्तशाठ्यं न कुर्वीत कुर्वन्दोषान्स मश्नुते ।\nअमृतं पिबतो वक्त्रात्सूर्यस्यामृतबिन्दवः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002764013, "chapter_id": 22764, "verse_number": "९-४९-१४", "content_sanskrit": "निपेतुरेत उत्थाय शालिमुद्गेक्षवः स्मृताः ।\nशर्करा च परं तस्मादिक्षुरसोद्भवा मता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002764014, "chapter_id": 22764, "verse_number": "९-४९-१५", "content_sanskrit": "इष्टा रवेरतः पुण्या शर्करा हव्यकव्ययोः ।\nशर्करासप्तमी चैषा वाजिमेधफलप्रदा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002764015, "chapter_id": 22764, "verse_number": "९-४९-१६", "content_sanskrit": "सर्वे ह्युपशमं यांति पुनः संततिवर्द्धिनी ।\nयः कुर्यात्परया भक्त्या स परं ब्रह्म गच्छति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002764016, "chapter_id": 22764, "verse_number": "९-४९-१७", "content_sanskrit": "कल्पमेकं वसेत्स्वर्गे ततो याति परं पदम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002764017, "chapter_id": 22764, "verse_number": "९-४९-१८", "content_sanskrit": "इदमनघ शृणोति यः स्मरेद्वा परिपठतीह सुरेश्वरस्य लोके ।\nमतिमपि च ददाति यो जनानाममरवधूजनकिन्नरैः स पूज्यः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]