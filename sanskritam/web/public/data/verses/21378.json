[{"id": 7001378000, "chapter_id": 21378, "verse_number": "५-२५-१", "content_sanskrit": "व्यास उवाच ।\nसनत्कुमार सर्वज्ञ त्वत्सकाशान्मया मुने ।\nस्त्रीस्वभावः श्रुतः प्रीत्या कालज्ञानं वदस्व मे॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001378001, "chapter_id": 21378, "verse_number": "५-२५-२", "content_sanskrit": "सनत्कुमार उवाच ।\nइदमेव पुराऽपृच्छत्पार्वती परमेश्वरम् ।\nश्रुत्वा नानाकथां दिव्यां प्रसन्ना सुप्रणम्य तम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001378002, "chapter_id": 21378, "verse_number": "५-२५-३", "content_sanskrit": "पार्वत्युवाच ।\nभगवंस्त्वत्प्रसादेन ज्ञातं मे सकलं मतम् ।\nयथार्चनं तु ते देव यैर्मंत्रैश्च यथाविधि॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001378003, "chapter_id": 21378, "verse_number": "५-२५-४", "content_sanskrit": "अद्यापि संशयस्त्वेकः कालचक्रं प्रति प्रभो ।\nमृत्युचिह्नं यथा देव किं प्रमाणं यथायुषः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001378004, "chapter_id": 21378, "verse_number": "५-२५-५", "content_sanskrit": "तथा कथय मे नाथ यद्यहं तव वल्लभा ।\nइति पृष्टस्तया देव्या प्रत्युवाच महेश्वरः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001378005, "chapter_id": 21378, "verse_number": "५-२५-६", "content_sanskrit": "॥ ईश्वर उवाच  ।\nसत्यं ते कथयिष्यामि शास्त्रं सर्वोत्तमं प्रिये ।\nयेन शास्त्रेण देवेशि नरैः कालः प्रबुध्यते॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001378006, "chapter_id": 21378, "verse_number": "५-२५-७", "content_sanskrit": "अहः पक्षं तथा मासमृतुं चायनवत्सरौ ।\nस्थूलसूक्ष्मगतैश्चिह्नैर्बहिरंतर्गतैस्तथा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001378007, "chapter_id": 21378, "verse_number": "५-२५-८", "content_sanskrit": "तत्तेहं सम्प्रवक्ष्यामि शृणु तत्त्वेन सुन्दरि ।\nलोकानामुपकारार्थं वैराग्यार्थमुमेऽधुना॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001378008, "chapter_id": 21378, "verse_number": "५-२५-९", "content_sanskrit": "अकस्मात्पांडुरं देहमूर्द्ध्वरागं समंततः ।\nतदा मृत्युं विजानीयात्षण्मासाभ्यन्तरे प्रिये॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001378009, "chapter_id": 21378, "verse_number": "५-२५-१०", "content_sanskrit": "मुखं कर्णौ तथा चक्षुर्जिह्वास्तम्भो यदा भवेत् ।\nतदा मृत्युं विजानीयात्षण्मासाभ्यन्तरे प्रिये॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001378010, "chapter_id": 21378, "verse_number": "५-२५-११", "content_sanskrit": "रौरवानुगतं भद्र ध्वनिं नाकर्णयेद्द्रुतम् ।\nषण्मासाभ्यंतरे मृत्युर्ज्ञातव्यः कालवेदिभिः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001378011, "chapter_id": 21378, "verse_number": "५-२५-१२", "content_sanskrit": "रविसोमाग्निसंयोगाद्यदोद्योतं न पश्यति ।\nकृष्णं सर्वं समस्तं च षण्मासं जीवितं तथा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001378012, "chapter_id": 21378, "verse_number": "५-२५-१३", "content_sanskrit": "वामहस्तो यदा देवि सप्ताहं स्पंदते प्रिये ।\nजीवितं तु तदा तस्य मासमेकं न संशयः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001378013, "chapter_id": 21378, "verse_number": "५-२५-१४", "content_sanskrit": "उन्मीलयति गात्राणि तालुकं शुष्यते यदा ।\nजीवितं तु तदा तस्य मासमेकं न संशयः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001378014, "chapter_id": 21378, "verse_number": "५-२५-१५", "content_sanskrit": "नासा तु स्रवते यस्य त्रिदोषे पक्षजीवितम् ।\nवक्त्रं कंठं च शुष्येत षण्मासांते गतायुषः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001378015, "chapter_id": 21378, "verse_number": "५-२५-१६", "content_sanskrit": "स्थूलजिह्वा भवेद्यस्य द्विजाः क्लिद्यंति भामिनि ।\nषण्मासाज्जायते मृत्युश्चिह्नैस्तैरुपलक्षयेत्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001378016, "chapter_id": 21378, "verse_number": "५-२५-१७", "content_sanskrit": "अंबुतैलघृतस्थं तु दर्पणे वरवर्णिनि ।\nन पश्यति यदात्मानं विकृतं पलमेव च॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001378017, "chapter_id": 21378, "verse_number": "५-२५-१८", "content_sanskrit": "षण्मासायुस्स विज्ञेयः कालचक्रं विजानता ।\nअन्यच्च शृणु देवेशि येन मृत्युर्विबुद्ध्यते॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001378018, "chapter_id": 21378, "verse_number": "५-२५-१९", "content_sanskrit": "शिरोहीनां यदा छायां स्वकीयामुपलक्षयेत् ।\nअथवा छायया हीनं मासमेकं न जीवति॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001378019, "chapter_id": 21378, "verse_number": "५-२५-२०", "content_sanskrit": "आंगिकानि मयोक्तानि मृत्युचिह्नानि पार्वति ।\nबाह्यस्थानि ब्रुवे भद्रे चिह्नानि शृणु सांप्रतम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001378020, "chapter_id": 21378, "verse_number": "५-२५-२१", "content_sanskrit": "रश्मिहीनं यदा देवि भवेत्सोमार्कमण्डलम् ।\nदृश्यते पाटलाकारं मासार्दे्धेन विपद्यते॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001378021, "chapter_id": 21378, "verse_number": "५-२५-२२", "content_sanskrit": "अरुंधती महायानमिंदुलक्षणवर्जितम् ।\nअदृष्टतारको योऽसौ मासमेकं स जीवति॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001378022, "chapter_id": 21378, "verse_number": "५-२५-२३", "content_sanskrit": "दृष्टे ग्रहे च दिङ्मोहः षण्मासाज्जायते ध्रुवम् ।\nउतथ्यं न ध्रुवं पश्येद्यदि वा रविमण्डलम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001378023, "chapter_id": 21378, "verse_number": "५-२५-२४", "content_sanskrit": "रात्रौ धनुर्यदापश्येन्मध्याह्ने चोल्कपातनम् ।\nवेष्ट्यते गृध्रकाकैश्च षण्मासायुर्न संशयः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001378024, "chapter_id": 21378, "verse_number": "५-२५-२५", "content_sanskrit": "ऋषयस्स्वर्गपंथाश्च दृश्यंते नैव चाम्बरे ।\nषण्मासायुर्विजनीयात्पुरुषैः कालवेदिभिः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001378025, "chapter_id": 21378, "verse_number": "५-२५-२६", "content_sanskrit": "अकस्माद्राहुणा ग्रस्तं सूर्यं वा सोममेव च ।\nदिक्चक्रं भ्रांतवत्पश्येत्षण्मासान्म्रियते स्फुटम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001378026, "chapter_id": 21378, "verse_number": "५-२५-२७", "content_sanskrit": "नीलाभिर्मक्षिकाभिश्च ह्यकस्माद्वेष्ट्यते पुमान् ।\nमासमेकं हि तस्यायुर्ज्ञातव्यं परमार्थतः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001378027, "chapter_id": 21378, "verse_number": "५-२५-२८", "content_sanskrit": "गृध्रः काकः कपोतश्च शिरश्चाक्रम्य तिष्ठति ।\nशीघ्रं तु म्रियते जंतुर्मासैकेन न संशयः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001378028, "chapter_id": 21378, "verse_number": "५-२५-२९", "content_sanskrit": "एवं चारिष्टभेदस्तु बाह्यस्थः समुदाहृतः ।\nमानुषाणां हितार्थाय संक्षेपेण वदाम्यहम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001378029, "chapter_id": 21378, "verse_number": "५-२५-३०", "content_sanskrit": "हस्तयोरुभयोर्देवि यथा कालं विजानते ।\nवामदक्षिणयोर्मध्ये प्रत्यक्षं चेत्युदाहृतम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001378030, "chapter_id": 21378, "verse_number": "५-२५-३१", "content_sanskrit": "एवं पक्षौ स्थितौ द्वौ तु समासात्सुरसुंदरि ।\nशुचिर्भूत्वा स्मरन्देवं सुस्नातस्संयतेन्द्रियः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001378031, "chapter_id": 21378, "verse_number": "५-२५-३२", "content_sanskrit": "हस्तौ प्रक्षाल्य दुग्धेनालक्तकेन विमर्दयेत् ।\nगंधैः पुष्पैः करौ कृत्वा मृगयेच्च शुभाशुभम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001378032, "chapter_id": 21378, "verse_number": "५-२५-३३", "content_sanskrit": "कनिष्ठामादितः कृत्वा यावदंगुष्ठकं प्रिये ।\nपर्वत्रयक्रमेणैव हस्तयोरुभयोरपि॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001378033, "chapter_id": 21378, "verse_number": "५-२५-३४", "content_sanskrit": "प्रतिपदादिविन्यस्य तिथिं प्रतिपदादितः ।\nसंपुटाकारहस्तौ तु पूर्वदिङ्मुखसंस्थितः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001378034, "chapter_id": 21378, "verse_number": "५-२५-३५", "content_sanskrit": "स्मरेन्नवात्मकं मंत्रं यावदष्टोत्तरं शतम् ।\nनिरीक्षयेत्ततो हस्तौ प्रतिपर्वणि यत्नतः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001378035, "chapter_id": 21378, "verse_number": "५-२५-३६", "content_sanskrit": "तस्मिन्पर्वणि सा रेखा दृश्यते भृंगसन्निभा ।\nतत्तिथौ हि मृतिर्ज्ञेया कृष्णे शुक्ले तथा प्रिये॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001378036, "chapter_id": 21378, "verse_number": "५-२५-३७", "content_sanskrit": "अधुना नादजं वक्ष्ये संक्षेपात्काललक्षणम् ।\nगमागमं विदित्वा तु कर्म कुर्याञ्छृणु प्रिये॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001378037, "chapter_id": 21378, "verse_number": "५-२५-३८", "content_sanskrit": "आत्मविज्ञानं सुश्रोणि चारं ज्ञात्वा तु यत्नतः ।\nक्षणं त्रुटिर्लवं चैव निमेषं काष्ठकालिकम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001378038, "chapter_id": 21378, "verse_number": "५-२५-३९", "content_sanskrit": "मुहूर्तकं त्वहोरात्रं पक्षमासर्तुवत्सरम् ।\nअब्दं युगं तथा कल्पं महाकल्पं तथैव च॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001378039, "chapter_id": 21378, "verse_number": "५-२५-४०", "content_sanskrit": "एवं स हरते कालः परिपाट्या सदाशिवः ।\nवामदक्षिणमध्ये तु पथि त्रयमिदं स्मृतम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001378040, "chapter_id": 21378, "verse_number": "५-२५-४१", "content_sanskrit": "दिनानि पंच चारभ्य पंचविंशद्दिनावधि ।\nवामाचारगतौ नादः प्रमाणं कथितं तव॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001378041, "chapter_id": 21378, "verse_number": "५-२५-४२", "content_sanskrit": "भूतरंध्रदिशश्चैव ध्वजश्च वरवर्णिनि ।\nवामचारगतौ नादः प्रमाणं कालवेदिनः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001378042, "chapter_id": 21378, "verse_number": "५-२५-४३", "content_sanskrit": "ऋतोर्विकारभूताश्च गुणास्तत्रैव भामिनि ।\nप्रमाणं दक्षिणं प्रोक्तं ज्ञातव्यं प्राणवेदिभिः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001378043, "chapter_id": 21378, "verse_number": "५-२५-४४", "content_sanskrit": "भूतसंख्या यदा प्राणान्वहंते च इडादयः ।\nवर्षस्याभ्यंतरे तस्य जीवितं हि न संशयः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001378044, "chapter_id": 21378, "verse_number": "५-२५-४५", "content_sanskrit": "दशघस्रप्रवाहेण ह्यब्दमानं स जीवति ।\nपंचदशप्रवाहेण ह्यब्दमेकं गतायुषम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001378045, "chapter_id": 21378, "verse_number": "५-२५-४६", "content_sanskrit": "विंशद्दिनप्रवाहेण षण्मासं लक्षयेत्तदा ।\nपंचविंशद्दिनमितं वहते वामनाडिका॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001378046, "chapter_id": 21378, "verse_number": "५-२५-४७", "content_sanskrit": "जीवितं तु तदा तस्य त्रिमासं हि गतायुषः ।\nषड्विंशद्दिनमानेन मासद्वयमुदाहृतम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001378047, "chapter_id": 21378, "verse_number": "५-२५-४८", "content_sanskrit": "सप्तविंशद्दिनमितं वहतेत्यतिविश्रमा ।\nमासमेकं समाख्यातं जीवितं वामगोचरे॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001378048, "chapter_id": 21378, "verse_number": "५-२५-४९", "content_sanskrit": "एतत्प्रमाणं विज्ञेयं वामवायुप्रमाणतः ।\nसव्येतरे दिनान्येव चत्वारश्चानुपूर्वशः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001378049, "chapter_id": 21378, "verse_number": "५-२५-५०", "content_sanskrit": "चतुस्स्थाने स्थिता देवि षोडशैताः प्रकीर्तिताः ।\nतेषां प्रमाणं वक्ष्यामि साम्प्रतं हि यथार्थतः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001378050, "chapter_id": 21378, "verse_number": "५-२५-५१", "content_sanskrit": "षड्दिनान्यादितः कृत्वा संख्यायाश्च यथाविधि ।\nएतदंतर्गते चैव वामरंध्रे प्रकाशितम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001378051, "chapter_id": 21378, "verse_number": "५-२५-५२", "content_sanskrit": "षड्दिनानि यदा रूढं द्विवर्षं च स जीवति ।\nमासानष्टौ विजानीयाद्दिनान्यष्ट च तानि तु॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001378052, "chapter_id": 21378, "verse_number": "५-२५-५३", "content_sanskrit": "प्राणः सप्तदशे चैव विद्धि वर्षं न संशयः ।\nसप्तमासान्विजानीयाद्दिनैः षड्भिर्न संशयः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001378053, "chapter_id": 21378, "verse_number": "५-२५-५४", "content_sanskrit": "अष्टघस्रप्रभेदेन द्विवर्षं हि स जीवति ।\nचतुर्मासा हि विज्ञेयाश्चतुर्विंशद्दिनावधिः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001378054, "chapter_id": 21378, "verse_number": "५-२५-५५", "content_sanskrit": "यदा नवदिनं प्राणा वहंत्येव त्रिमासकम् ।\nमासद्वयं च द्वे मासे दिना द्वादश कीर्तिताः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001378055, "chapter_id": 21378, "verse_number": "५-२५-५६", "content_sanskrit": "पूर्ववत्कथिता ये तु कालं तेषां तु पूर्वकम् ।\nअवांतरदिना ये तु तेन मासेन कथ्यते॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001378056, "chapter_id": 21378, "verse_number": "५-२५-५७", "content_sanskrit": "एकादश प्रवाहेण वर्षमेकं स जीवति ।\nमासा नव तथा प्रोक्ता दिनान्यष्टमितान्यपि॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001378057, "chapter_id": 21378, "verse_number": "५-२५-५८", "content_sanskrit": "द्वादशेन प्रवाहेण वर्षमेकं स जीवति ।\nमासान् सप्त विजानीयात्षड्घस्रांश्चाप्युदाहरेत्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001378058, "chapter_id": 21378, "verse_number": "५-२५-५९", "content_sanskrit": "नाडी यदा च वहति त्रयोदशदिनावधि ।\nसम्वत्सरं भवेत्तस्य चतुर्मासाः प्रकीर्तिताः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001378059, "chapter_id": 21378, "verse_number": "५-२५-६०", "content_sanskrit": "चतुर्विशद्दिनं शेषं जीवितं च न संशयः ।\nप्राणवाहा यदा वामे चतुर्द्दशदिनानि तु॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001378060, "chapter_id": 21378, "verse_number": "५-२५-६१", "content_sanskrit": "सम्वत्सरं भवेत्तस्य मासाः षट् च प्रकीर्तिताः ।\nचतुर्विंशद्दिनान्येव जीवितं च न संशयः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001378061, "chapter_id": 21378, "verse_number": "५-२५-६२", "content_sanskrit": "पंचदशप्रवाहेण नव मासान्स जीवति ।\nचतुर्विशद्दिनान्येव कथितं कालवेदिभिः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001378062, "chapter_id": 21378, "verse_number": "५-२५-६३", "content_sanskrit": "षोडशाहप्रवाहेण दशमासान्स जीवति ।\nचतुर्विशद्दिनाधिक्यं कथितं कालवेदिभिः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001378063, "chapter_id": 21378, "verse_number": "५-२५-६४", "content_sanskrit": "सप्तदशप्रवाहेण नवमासैर्गतायुषम् ।\nअष्टादशदिनान्यत्र कथितं साधकेश्वरि॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001378064, "chapter_id": 21378, "verse_number": "५-२५-६५", "content_sanskrit": "वामचारं यदा देवि ह्यष्टादशदिनावधिः ।\nजीवितं चाष्टमासं तु घस्रा द्वादश कीर्तिताः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001378065, "chapter_id": 21378, "verse_number": "५-२५-६६", "content_sanskrit": "चतुर्विंशद्दिनान्यत्र निश्चयेनावधारय ।\nप्राणवाहो यदा देवि त्रयोविंशद्दिनावधिः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001378066, "chapter_id": 21378, "verse_number": "५-२५-६७", "content_sanskrit": "चत्वारः कथिता मासाः षड्दिनानि तथोत्तरे ।\nचतुर्विंशप्रवाहेण त्रीन्मासांश्च स जीवति॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001378067, "chapter_id": 21378, "verse_number": "५-२५-६८", "content_sanskrit": "दिनान्यत्र दशाष्टौ च संहरंत्येव चारतः ।\nअवांतरदिने यस्तु संक्षेपात्ते प्रकीर्तितः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001378068, "chapter_id": 21378, "verse_number": "५-२५-६९", "content_sanskrit": "वामचारः समाख्यातो दक्षिणं शृणु सांप्रतम् ।\nअष्टाविंशप्रवाहेण तिथिमानेन जीवति॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001378069, "chapter_id": 21378, "verse_number": "५-२५-७०", "content_sanskrit": "प्रवाहेण दशाहेन तत्संस्थेन विपद्यते ।\nत्रिंशद्धस्रप्रवाहेन पञ्चाहेन विपद्यते॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001378070, "chapter_id": 21378, "verse_number": "५-२५-७१", "content_sanskrit": "एकत्रिंशद्यदा देवि वहते च निरंतरम् ।\nदिनत्रयं तदा तस्य जीवितं हि न संशयः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001378071, "chapter_id": 21378, "verse_number": "५-२५-७२", "content_sanskrit": "द्वात्रिंशत्प्राणसंख्या च यदा हि वहते रविः ।\nतदा तु जीवितं तस्य द्विदिनं हि न संशयः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001378072, "chapter_id": 21378, "verse_number": "५-२५-७३", "content_sanskrit": "दक्षिणः कथितः प्राणो मध्यस्थं कथयामि ते ।\nएकभागगतो वायुप्रवाहो मुखमण्डले॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001378073, "chapter_id": 21378, "verse_number": "५-२५-७४", "content_sanskrit": "धावमानप्रवाहेण दिनमेकं स जीवति ।\nचक्रमे तत्परासोर्हि पुराविद्भिरुदाहृतम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001378074, "chapter_id": 21378, "verse_number": "५-२५-७५", "content_sanskrit": "एतत्ते कथितं देवि कालचक्रं गतायुषः ।\nलोकानां च हितार्थाय किमन्यच्छ्रोतुमिच्छसि॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]