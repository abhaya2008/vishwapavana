[{"id": 7000965000, "chapter_id": 20965, "verse_number": "२-५-१", "content_sanskrit": "श्रीपराशर उवाच  ।\nविस्तार एष कथितः पृथिव्या भवतो मया ।\nसप्ततिस्तु सहस्राणि द्विजोच्छ्रायोपि कथ्यते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000965001, "chapter_id": 20965, "verse_number": "२-५-२", "content_sanskrit": "दशसाहस्रमेकैकं पातालं मुनिसत्तम ।\nअतलं वितलं चैव नितलं च गभस्तिमत् ।\nमहाख्यं सुतलं चाग्र्यं पातालं चापि सप्तमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000965002, "chapter_id": 20965, "verse_number": "२-५-३", "content_sanskrit": "शुक्लाकृष्णारुणाः पीताः शर्कराः शैलकांचनाः ।\nभूमयो यत्र मैत्रेय वरप्रासादमंडिताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000965003, "chapter_id": 20965, "verse_number": "२-५-४", "content_sanskrit": "तेषु दानवदैतेया यक्षाश्च शतशस्तथा ।\nनिवसन्ति महानागजातयश्च महामुने ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000965004, "chapter_id": 20965, "verse_number": "२-५-५", "content_sanskrit": "स्वर्लोकादपि रम्याणि पातालानीति नारदः ।\nप्राह स्वर्गसदां मध्ये पातालाभ्यागतो दिवि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000965005, "chapter_id": 20965, "verse_number": "२-५-६", "content_sanskrit": "आह्लादकारिणः शुभ्रा मणयो यत्र सुप्रभाः ।\nनागाभरणभूषासु पातालं केन तत्समम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000965006, "chapter_id": 20965, "verse_number": "२-५-७", "content_sanskrit": "दैत्यदानवकन्याभिरितश्चेतश्च शोभिते ।\nपाताले कस्य न प्रीतिर्विमुक्तस्यापि जायते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000965007, "chapter_id": 20965, "verse_number": "२-५-८", "content_sanskrit": "दिवार्करश्मयो यत्र प्रभां तन्वन्ति नातपम् ।\nशशिरश्मिर्न शीताय निशि द्योताय केवलम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000965008, "chapter_id": 20965, "verse_number": "२-५-९", "content_sanskrit": "भक्ष्यभोज्यमहापानमुदितैरपि भोगिभिः ।\nयत्र न ज्ञायते कालो गतोपि दनुजादिभिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000965009, "chapter_id": 20965, "verse_number": "२-५-१०", "content_sanskrit": "वनानि नद्यो रम्याणि सरांसि कमलाकराः ।\nपुंस्कोकिलाभिलापाश्च मनोज्ञान्यम्बराणि च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000965010, "chapter_id": 20965, "verse_number": "२-५-११", "content_sanskrit": "भूषणान्यतिशुभ्राणि गन्धाढ्यं चानुलेपनम् ।\nवीणावेणुमृदंगानां स्वनैरापूरितानि च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000965011, "chapter_id": 20965, "verse_number": "२-५-१२", "content_sanskrit": "एतान्यन्यानि चोदारभाग्यभोग्यानि दानवैः ।\nदैत्योरगैश्च भुज्यन्ते पातालान्तरगोचरैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000965012, "chapter_id": 20965, "verse_number": "२-५-१३", "content_sanskrit": "पातालानामधश्चास्ते विष्णोर्या तामसी तनुः ।\nशेषाख्या यद्गुणान्वक्तुं न शक्ता दैत्यदानवाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000965013, "chapter_id": 20965, "verse_number": "२-५-१४", "content_sanskrit": "योनन्तः पठ्यते सिद्धैर्दैवो देवर्षिपूजितः ।\nस सहस्रशिरा व्यक्तस्वस्तिकामलभूषणः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000965014, "chapter_id": 20965, "verse_number": "२-५-१५", "content_sanskrit": "फणामणिसहस्रेण यः स विद्योतयन्दिशः ।\nसर्वान्करोति निर्वीर्यान् हिताय जगतोऽसुरान् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000965015, "chapter_id": 20965, "verse_number": "२-५-१६", "content_sanskrit": "मदाघूर्णितनेत्रोसौ यः सदैवैककुण्डलः ।\nकिरीटी स्रग्धरो भाति साग्निः श्वेत इवाचलः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000965016, "chapter_id": 20965, "verse_number": "२-५-१७", "content_sanskrit": "नीलवासा मदोत्सिक्तः श्वेतहारोपशोभितः ।\nसाभ्रगङ्गाप्रवाहोसौ कैलासाद्रिरिवापरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000965017, "chapter_id": 20965, "verse_number": "२-५-१८", "content_sanskrit": "लाङ्गलासक्तहस्ताग्रो बिभ्रन्मुसलमुत्तमम् ।\nउपास्यते स्वयं कान्त्या यो वारुण्या च मूर्त्तया ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000965018, "chapter_id": 20965, "verse_number": "२-५-१९", "content_sanskrit": "कल्पान्ते यस्य वक्त्रेभ्यो विषानलशिखोज्ज्वलः ।\nसंकर्षणात्मको रुद्रो  निष्क्रम्यात्ति जगत्त्रयम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000965019, "chapter_id": 20965, "verse_number": "२-५-२०", "content_sanskrit": "स बिभ्रच्छेखरीभूतमशेषं क्षितिमण्डलम् ।\nआस्ते पातालमूलस्थः शेषोऽशेषसुरार्चितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000965020, "chapter_id": 20965, "verse_number": "२-५-२१", "content_sanskrit": "तस्य वीर्यं प्रभावश्च स्वरूपं रूपमेव च ।\nन हि वर्णयितुं शक्यं ज्ञातुं च त्रिदशैरपि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000965021, "chapter_id": 20965, "verse_number": "२-५-२२", "content_sanskrit": "यस्यैषा सकला पृथ्वी फणामणिशिखारुणा ।\nआस्ते कुसुममालेव कस्तद्वीर्यं वदिष्यति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000965022, "chapter_id": 20965, "verse_number": "२-५-२३", "content_sanskrit": "यदा विजृम्भतेनन्तो मदाघूर्णितलोचनः ।\nतदा चलति भूरेषा साब्धितोया सकानना ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000965023, "chapter_id": 20965, "verse_number": "२-५-२४", "content_sanskrit": "गन्धर्वाप्सरसः सिद्धाः किन्नरोरगचारणाः ।\nनान्तं गुणानां गच्छन्ति तेनानन्तोयमव्ययः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000965024, "chapter_id": 20965, "verse_number": "२-५-२५", "content_sanskrit": "यस्य नागवधूहस्तैर्लगितं हरिचन्दनम् ।\nमुहुः श्वासानिलापास्तं याति दिक्क्षोदवासताम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000965025, "chapter_id": 20965, "verse_number": "२-५-२६", "content_sanskrit": "यमाराध्य पूराणर्षिर्गर्गो ज्योतींषि तत्त्वतः ।\nज्ञातवान्सकलं चैव निमित्तपठितं फलम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000965026, "chapter_id": 20965, "verse_number": "२-५-२७", "content_sanskrit": "तेनेयं नागवर्येण शिरसा विधृता मही ।\nबिभर्ति मालां लोकानां सदेवासुरमानुषाम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]