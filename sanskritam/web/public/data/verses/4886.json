[{"id": 2183171, "chapter_id": 4886, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2183172, "chapter_id": 4886, "verse_number": "१", "content_sanskrit": "किंशीलाः किंसमुत्थ्आनाः कथंरूपाश्च भारत ।\nकिंसन्नाहाः कथंशस्त्रा जनाः स्युः संयुगे नृप\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2183173, "chapter_id": 4886, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2183174, "chapter_id": 4886, "verse_number": "२", "content_sanskrit": "यथाऽचरितमेवात्र शस्त्रपत्रं विधीयते ।\nआचारादेव पुरुषस्तथा कर्मसु वर्तते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2183175, "chapter_id": 4886, "verse_number": "३", "content_sanskrit": "गान्धाराः सिन्धुसौवीरा नखरप्रासयोधिनः ।\nआभीरवः सुबलिनस्तद्बलं सर्वपारगम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2183176, "chapter_id": 4886, "verse_number": "४", "content_sanskrit": "सर्वशस्त्रेषु कुशलाः सत्त्ववन्तो ह्युशीनराः ।\nप्राच्या मातङ्गयुद्धेषु कुशलाः शठयोधिनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2183177, "chapter_id": 4886, "verse_number": "५", "content_sanskrit": "तथा यवनकाम्भोजा मथुरामभितश्च ये ।\nएते नियुद्धकुशला दाक्षिणात्यासिचर्मिणः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2183178, "chapter_id": 4886, "verse_number": "६", "content_sanskrit": "सर्वत्र शूरा जायन्ते महासत्त्वा महाबलाः ।\nप्राय एष समुद्दिष्टो लक्षणानि तु मे शृणु\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2183179, "chapter_id": 4886, "verse_number": "७", "content_sanskrit": "सिंहशार्दूलवाङ्नेत्राः सिंहशार्दूलगामिनः ।\nपारावतकुळिङ्गाक्षाः सर्वे शूराः प्रमाथिनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2183180, "chapter_id": 4886, "verse_number": "८", "content_sanskrit": "मृगस्वरा द्वीपिनेत्रा ऋषभाक्षास्तथापरे ।\nप्रवादिनः सुचण्डाश्च क्रोधिनः किन्नरीस्वनाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2183181, "chapter_id": 4886, "verse_number": "९", "content_sanskrit": "मेघस्वनाः क्रुद्धमुखाः केचित् कळभनिस्वनाः ।\nजिह्मनासानुजङ्घाश्च दूरगा दूरपातिनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2183182, "chapter_id": 4886, "verse_number": "१०", "content_sanskrit": "बिडालकुब्जास्तनवस्तनुकेशास्तनुत्वचः ।\nशूराश्चपलचित्ताश्च ते भवन्ति दुरासदाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2183183, "chapter_id": 4886, "verse_number": "११", "content_sanskrit": "गोधानिमीलिताः केचिन्मृदुप्रकृतयोऽपि च ।\nतुरङ्गगतिनिर्घोषास्ते नराः पारयिष्णवः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2183184, "chapter_id": 4886, "verse_number": "१२", "content_sanskrit": "सुसंहताः प्रतनवो व्यूढोरस्काः सुसंस्थिताः ।\nप्रवादितेन नृत्यन्ति हृष्यन्ति कलहेषु च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2183185, "chapter_id": 4886, "verse_number": "१३", "content_sanskrit": "गम्भीराक्षा निःसृताक्षाः पिङ्गला भ्रुकुटीमुखाः ।\nनकुलाक्षास्तथा चैव सर्वे शूरास्तनुत्यजः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2183186, "chapter_id": 4886, "verse_number": "१४", "content_sanskrit": "जिह्माक्षाः प्रललाटाश्च निर्मांसहनवोऽपि च ।\nवक्रबाह्वंसनासाक्षाः कृशा धमनिसन्तताः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2183187, "chapter_id": 4886, "verse_number": "१५", "content_sanskrit": "प्रविशन्त्यतिवेगेन सम्परायेऽभ्युपस्थिते ।\nवारणा इव सम्मत्तास्ते भवन्ति दुरासदाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2183188, "chapter_id": 4886, "verse_number": "१६", "content_sanskrit": "दीप्तस्फुटितकेशान्ताः स्थूलपार्श्वहनूमुखाः ।\nउन्नतांसा पृथुग्रीवा विकटाः स्थूलपिण्डिकाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2183189, "chapter_id": 4886, "verse_number": "१७", "content_sanskrit": "उद्वृत्ताश्चैव सुग्रीवा विनता विहगा इव ।\nपिण्डशीर्षाहिवक्त्राश्च वृषदंशमुखा इव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2183190, "chapter_id": 4886, "verse_number": "१८", "content_sanskrit": "उग्रस्वना मन्युमन्तो युद्धेष्वारावसारिणः ।\nअधर्मज्ञावलिप्ताश्च घोरा रौद्रप्रदर्शिनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2183191, "chapter_id": 4886, "verse_number": "१९", "content_sanskrit": "त्यक्तात्मानः सर्व एत उद्वग्रा ह्यनिवर्तिनः ।\nपुरस्कार्याः सदा सैन्ये हन्यन्ते घ्नन्ति चापि ते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2183192, "chapter_id": 4886, "verse_number": "२०", "content_sanskrit": "अधार्मिका भिन्नवृत्ताः साध्वेवैषां पराभवः ।\nएवमेव प्रकुप्य्अन्ति राज्ञोऽप्येते ह्यभीक्ष्णशः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2183193, "chapter_id": 4886, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे त्र्यधिकशततमोऽध्यायः ॥ १०३ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]