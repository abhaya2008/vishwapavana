[{"id": 7000270000, "chapter_id": 20270, "verse_number": "१-२४-१", "content_sanskrit": "ब्रह्मोवाच ।\nभगवन्पुरुषस्येह स्त्रियाश्च वरदायकम् ।\nशोकव्याधिभयं दुःखं न भवेद्येन तद्वद ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000270001, "chapter_id": 20270, "verse_number": "१-२४-२", "content_sanskrit": "शंकर उवाच ।\nश्रावणस्य द्वितीयायां कृष्णायां मधुसूदनः ।\nक्षीरार्णवे सपत्नीकः सदा वसति केशवः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000270002, "chapter_id": 20270, "verse_number": "१-२४-३", "content_sanskrit": "तस्यां संपूज्य गोविंदं सर्वान्कामानवाप्नुयात् ।\nगोभूहिरण्यदानादि सप्तकल्पशतानुगम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000270003, "chapter_id": 20270, "verse_number": "१-२४-४", "content_sanskrit": "आवाहनादिकां पूजां पूर्ववत्परिकल्पयेत् ।\nअशून्यशयना नाम द्वितीयासौ प्रकीर्तिता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000270004, "chapter_id": 20270, "verse_number": "१-२४-५", "content_sanskrit": "तस्यां संपूजयेद्विष्णुमेभिर्मंत्रैर्विधानतः ।\nश्रीवत्सधारिन्श्रीकांत श्रीपते श्रीधराव्यय ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000270005, "chapter_id": 20270, "verse_number": "१-२४-६", "content_sanskrit": "गार्हस्थ्यं मा प्रणाशं मे यातु धर्मार्थकामदं ।\nअग्नयो मा प्रणश्यंतु देवताः पुरुषोत्तम ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000270006, "chapter_id": 20270, "verse_number": "१-२४-७", "content_sanskrit": "पितरो मा प्रणश्यंतु मम दांपत्यभेदतः ।\nलक्ष्म्या वियुज्यते देवो न कदाचिद्यथा हरिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000270007, "chapter_id": 20270, "verse_number": "१-२४-८", "content_sanskrit": "तथा कलत्रसंबंधो देव मा मे वियुज्यतां ।\nलक्ष्म्या न शून्यं वरद यथा ते शयनं सदा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000270008, "chapter_id": 20270, "verse_number": "१-२४-९", "content_sanskrit": "शय्या ममाप्यशून्यास्तु तथैव मधुसूदन ।\nगीतवादित्रनिर्घोषान्देवदेवस्य कारयेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000270009, "chapter_id": 20270, "verse_number": "१-२४-१०", "content_sanskrit": "घंटा भवेदशक्तस्य सर्ववाद्यमयो यतः ।\nएवं संपूज्य गोविंदमश्नीयात्तैलवर्जितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000270010, "chapter_id": 20270, "verse_number": "१-२४-११", "content_sanskrit": "नक्तमक्षारलवणं यावत्तु स्याच्चतुष्टयं ।\nततः प्रभाते संजाते लक्ष्मीपतिसमन्विताम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000270011, "chapter_id": 20270, "verse_number": "१-२४-१२", "content_sanskrit": "दीपान्नभाजनैर्युक्तां शय्यां दद्याद्विलक्षणाम् ।\nपादुकोपानहच्छत्र चामरासन संयुताम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000270012, "chapter_id": 20270, "verse_number": "१-२४-१३", "content_sanskrit": "अभीष्टोपस्करैर्युक्तां शुक्लपुष्पांबरावृताम् ।\nअव्यंगाय च विप्राय वैष्णवाय कुटुंबिने ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000270013, "chapter_id": 20270, "verse_number": "१-२४-१४", "content_sanskrit": "दातव्या वेदविदुषे न वंध्यापतये क्वचित् ।\nतत्रोपवेश्य दांपत्यमलंकृत्य विधानतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000270014, "chapter_id": 20270, "verse_number": "१-२४-१५", "content_sanskrit": "पत्न्यास्तु भाजनं दद्याद्भक्ष्यभोज्यसमन्वितम् ।\nब्राह्मणस्यापि सौवर्णीमुपस्करसमन्विताम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000270015, "chapter_id": 20270, "verse_number": "१-२४-१६", "content_sanskrit": "प्रतिमां देवदेवस्य सोदकुंभां निवेदयेत् ।\nएवं यस्तु पुमान्कुर्यादशून्यशयनं हरेः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000270016, "chapter_id": 20270, "verse_number": "१-२४-१७", "content_sanskrit": "वित्तशाठ्येन रहितो नारायणपरायणः ।\nन तस्य पत्न्या विरहः कदाचिदपि जायते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000270017, "chapter_id": 20270, "verse_number": "१-२४-१८", "content_sanskrit": "नारी वा विधवा ब्रह्मन्यावच्चंद्रार्कतारकं ।\nन विरूपौ न शोकार्तौ दंपती भवतः क्वचित् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000270018, "chapter_id": 20270, "verse_number": "१-२४-१९", "content_sanskrit": "न पुत्रपशुरत्नानि क्षयं यांति पितामह ।\nसप्तकल्पसहस्राणि सप्तकल्पशतानि च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000270019, "chapter_id": 20270, "verse_number": "१-२४-२०", "content_sanskrit": "कुर्वन्नशून्यशयनं विष्णुलोके महीयते ।\nब्रह्मोवाच ।\nकथमारोग्यमैश्वर्यं मतिर्धर्मस्थितिस्सदा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000270020, "chapter_id": 20270, "verse_number": "१-२४-२१", "content_sanskrit": "अव्यंगाथ परे भक्तिर्विष्णौ चापि भवेत्कथम् ।\nईश्वर उवाच ।\nसाधु ब्रह्मंस्त्वया पृष्टमिदानीं कथयामि ते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000270021, "chapter_id": 20270, "verse_number": "१-२४-२२", "content_sanskrit": "विरोचनस्य संवादं भार्गवस्य च धीमतः ।\nप्रह्लादस्य सुतं दृष्ट्वा द्विरष्टपरिवत्सरम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000270022, "chapter_id": 20270, "verse_number": "१-२४-२३", "content_sanskrit": "तस्य रूपमिदं ब्रह्मन्सोहसद्भृगुनंदनः ।\nसाधुसाधु महाबाहो विरोचन शिवं तव ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000270023, "chapter_id": 20270, "verse_number": "१-२४-२४", "content_sanskrit": "तत्तथा हसितं तस्य पप्रच्छ सुरसूदनः ।\nब्रह्मन्किमर्थमेतत्ते हास्यं वै मामकं कृतम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000270024, "chapter_id": 20270, "verse_number": "१-२४-२५", "content_sanskrit": "साधुसाध्विति मामेवमुक्तवांस्त्वं वदस्व मे ।\nतमेवं वादिनं युक्तमुवाच वदतां वरः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000270025, "chapter_id": 20270, "verse_number": "१-२४-२६", "content_sanskrit": "विस्मयाद्व्रतमाहात्म्याद्धास्यमेतत्कृतं मया ।\nपुरा दक्षविनाशाय कुपितस्य त्रिशूलिनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000270026, "chapter_id": 20270, "verse_number": "१-२४-२७", "content_sanskrit": "अपतद्भीमवक्त्रस्य स्वेदबिंदुर्ललाटजः ।\nभित्वा स सप्तपातालानदहत्सप्तसागरान् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000270027, "chapter_id": 20270, "verse_number": "१-२४-२८", "content_sanskrit": "अनेकवक्त्रनयनोज्वलज्ज्वलन भीषणः ।\nवीरभद्र इति ख्यातः करपादायुतैर्युतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000270028, "chapter_id": 20270, "verse_number": "१-२४-२९", "content_sanskrit": "कृत्वा स यज्ञमथनं पुनर्भूतस्य संप्लवः ।\nत्रिजगद्दहनाद्भूयः शिवेन विनिवारितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000270029, "chapter_id": 20270, "verse_number": "१-२४-३०", "content_sanskrit": "कृतं त्वया वीरभद्र दक्षयज्ञविनाशनं ।\nइदानीमलमेतेन लोकदाहेन कर्मणा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000270030, "chapter_id": 20270, "verse_number": "१-२४-३१", "content_sanskrit": "शांतिप्रदानात्सर्वेषां ग्रहणां प्रथमो भव ।\nप्रहृष्टाभिजनाः पूजां करिष्यंति कृतात्मनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000270031, "chapter_id": 20270, "verse_number": "१-२४-३२", "content_sanskrit": "अंगारक इति ख्यातिं गमिष्यसि धरात्मज ।\nदेवलोके द्वितीयं च तव रूपं भविष्यति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000270032, "chapter_id": 20270, "verse_number": "१-२४-३३", "content_sanskrit": "ये च त्वां पूजयिष्यंति चतुर्थ्यां तु दिने नराः ।\nरूपमारोग्यमैश्वर्यं तेष्वनंतं भविष्यति ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000270033, "chapter_id": 20270, "verse_number": "१-२४-३४", "content_sanskrit": "एवमुक्तस्ततः शांतिमगमत्कामरूपधृत् ।\nस जातस्तत्क्षणाद्राजन्ग्रहत्वमगमत्पुनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000270034, "chapter_id": 20270, "verse_number": "१-२४-३५", "content_sanskrit": "स कदाचिद्भवांस्तस्य पूजार्घादिकमुत्तमं ।\nदृष्टवान्क्रियमाणं च शूद्रेण त्वं व्यवस्थितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000270035, "chapter_id": 20270, "verse_number": "१-२४-३६", "content_sanskrit": "तेन त्वं रूपवान्जातो सुरः शत्रुकुलाशनिः ।\nविविधा च रुचिर्जाता यस्मात्तव विदूरगा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000270036, "chapter_id": 20270, "verse_number": "१-२४-३७", "content_sanskrit": "विरोचन इति प्राहुस्तस्मात् त्वां देवदानवाः ।\nशूद्रेण क्रियमाणस्य व्रतस्य तव दर्शनात् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000270037, "chapter_id": 20270, "verse_number": "१-२४-३८", "content_sanskrit": "ईदृशी रूपसंपत्तिरिति विस्मितवानहम् ।\nसाधुसाध्विति तेनोक्तमहो माहात्म्यमुत्तमं ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000270038, "chapter_id": 20270, "verse_number": "१-२४-३९", "content_sanskrit": "पश्यतोपि भवेद्रूपमैश्वर्यं किमु कुर्वतः ।\nयस्माच्च भक्त्या धरणीसुतस्य विनिंद्यमानेन गवादिदानम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000270039, "chapter_id": 20270, "verse_number": "१-२४-४०", "content_sanskrit": "आलोकितं तेन सुरारिगर्भे संभूतिरेषा तव दैत्य जाता ।\nअथ तद्वचनं श्रुत्वा भार्गवस्य महात्मनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000270040, "chapter_id": 20270, "verse_number": "१-२४-४१", "content_sanskrit": "प्रह्लादनंदनो वीरः पुनः पप्रच्छ भार्गवम् ।\nविरोचन उवाच ।\nभगवंस्तद्व्रतं सम्यक्श्रोतुमिच्छामि तत्वतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000270041, "chapter_id": 20270, "verse_number": "१-२४-४२", "content_sanskrit": "दीयमानं तु यद्दानं मया दृष्टं भवांतरे ।\nमाहात्म्यं च विधिं तस्य यथावद्वक्तुमर्हसि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000270042, "chapter_id": 20270, "verse_number": "१-२४-४३", "content_sanskrit": "इति तद्वचनं श्रुत्वा विप्रः प्रोवाच सादरं ।\nचतुर्थ्यंगारकदिने यदा भवति दानव ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000270043, "chapter_id": 20270, "verse_number": "१-२४-४४", "content_sanskrit": "मृदास्नानं तदा कुर्यात्पद्मरागविभूषितः ।\nअग्निर्मूर्द्धादिवो मंत्रं जपेत्स्नात उदङ्मुखः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000270044, "chapter_id": 20270, "verse_number": "१-२४-४५", "content_sanskrit": "शूद्रस्तूष्णीं स्मरन्भौममास्तां भोगविवर्जितः ।\nअथास्तमित आदित्ये गोमयेनानुलेपयेत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000270045, "chapter_id": 20270, "verse_number": "१-२४-४६", "content_sanskrit": "प्रांगणं पुष्पमालाभिरक्षताद्भिः समंततः ।\nतदभ्यर्च्यालिखेत्पद्मं कुंकुमेनाष्टपत्रकम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000270046, "chapter_id": 20270, "verse_number": "१-२४-४७", "content_sanskrit": "कुंकुमस्याप्यभावेन रक्तचंदनमिष्यते ।\nचत्वारः करकाः कार्याः भक्ष्यभोज्यसमन्विताः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000270047, "chapter_id": 20270, "verse_number": "१-२४-४८", "content_sanskrit": "तंडुलै रक्तशालेयैः पद्मरागैश्च संयुताः ।\nचतुःकोणेषु तान्कृत्वा फलानि विविधानि च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000270048, "chapter_id": 20270, "verse_number": "१-२४-४९", "content_sanskrit": "गंधमाल्यादिकं सर्वं तथैव विनिवेशयेत् ।\nसुवर्णशृंगां कपिलामथार्च्य रौप्यैः खुरैः कांस्यदोहां सवस्त्राम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000270049, "chapter_id": 20270, "verse_number": "१-२४-५०", "content_sanskrit": "धुरंधरं रक्तखुरं च सौम्यं धान्यानि सप्तांबरसंयुतानि ।\nअंगुष्ठमात्रं पुरुषं तथैव सौवर्णमप्यायतबाहुदंडम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000270050, "chapter_id": 20270, "verse_number": "१-२४-५१", "content_sanskrit": "चतुर्भुजं हेममयं च ताम्रपात्रे गुडस्योपरि सर्पियुक्तम् ।\nसामस्वरज्ञाय जितेंद्रियाय वाग्रूपशीलान्वयसंयुताय ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000270051, "chapter_id": 20270, "verse_number": "१-२४-५२", "content_sanskrit": "दातव्यमेतत्सकलं द्विजाय कुटुम्बिने नैव तु दंभयुक्ते ।\nभूमिपुत्र महाभाग स्वेदोद्भव पिनाकिनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000270052, "chapter_id": 20270, "verse_number": "१-२४-५३", "content_sanskrit": "रूपार्थी त्वां प्रपन्नोहं गृहाणार्घ्यं नमोऽस्तु ते ।\nमंत्रेणानेन दत्वार्घ्यं रक्तचंदनवारिणा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000270053, "chapter_id": 20270, "verse_number": "१-२४-५४", "content_sanskrit": "ततोर्चयेद्विप्रवरं रक्तमाल्यांबरादिभिः ।\nदद्यात्तेनैव मंत्रेण भौमं गोमिथुनान्वितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000270054, "chapter_id": 20270, "verse_number": "१-२४-५५", "content_sanskrit": "शय्यां च शक्तिमान्दद्यात्सर्वोपस्करसंयुताम् ।\nयद्यदिष्टतमं लोके यच्चास्य दयितं गृहे ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000270055, "chapter_id": 20270, "verse_number": "१-२४-५६", "content_sanskrit": "तत्तद्गुणवते देयं दत्तस्याक्षयमिच्छता ।\nततः प्रदक्षिणं कृत्वा विसृज्य द्विजसत्तमम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000270056, "chapter_id": 20270, "verse_number": "१-२४-५७", "content_sanskrit": "नक्तं क्षीराशनं कुर्यादेवं चांगारकाष्टकम् ।\nचतुरो वाथ वातस्य यत्पुण्यं तद्वदामि ते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000270057, "chapter_id": 20270, "verse_number": "१-२४-५८", "content_sanskrit": "रूपसौभाग्यसंपन्नः पुमान्जन्मनि जन्मनि ।\nविष्णौ वाथ शिवे भक्तः सप्तद्वीपाधिपो भवेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000270058, "chapter_id": 20270, "verse_number": "१-२४-५९", "content_sanskrit": "सप्तकल्पसहस्राणि रुद्रलोके महीयते ।\nतस्मात्वमपि दैत्येंद्र व्रतमेतत्समाचर ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000270059, "chapter_id": 20270, "verse_number": "१-२४-६०", "content_sanskrit": "इत्येवमुक्तो भुगुनंदनेन चकार सर्वं व्रतमेव दैत्यः ।\nत्वं चापि राजन्कुरु सर्वमेतद्यतोक्षयं वेदविदो वदंति ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000270060, "chapter_id": 20270, "verse_number": "१-२४-६१", "content_sanskrit": "शृणोति यश्चैनमनन्यचेतास्तस्यापि सर्वं भगवान्विधत्ते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]