[{"id": 2020445, "chapter_id": 1427, "verse_number": "३-६५-०x", "content_sanskrit": "बृहद्श्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020446, "chapter_id": 1427, "verse_number": "३-६५-१", "content_sanskrit": "हृतराज्ये नले भीमः सभार्येऽदर्शनं गते।\n`चिन्तयामास बहुशः सहामात्यैर्नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020447, "chapter_id": 1427, "verse_number": "३-६५-२", "content_sanskrit": "समाहूय द्विजान्सर्वानिदं वचनमब्रवीत्।\nअग्रहारं च दास्यामिग्रामं नगरसंमितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020448, "chapter_id": 1427, "verse_number": "३-६५-३", "content_sanskrit": "दमयन्तीं नलं चैव पर्यन्वेषति यो द्विजः।\nगवां शतसहस्राणि दाता तस्मै द्विजातये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020449, "chapter_id": 1427, "verse_number": "३-६५-४", "content_sanskrit": "इत्युक्त्वा ब्राह्मणान्सर्वान्समाहूय द्विजोत्तमान्।\nप्रस्थापयामास तदा तयोर्दर्शनकाङ्क्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020450, "chapter_id": 1427, "verse_number": "३-६५-५", "content_sanskrit": "संदिदेश च तान्भीमो वसु दत्ता च पुष्कलम्।\nमृगयध्वं नलं चैव दमयन्तीं च मे सुताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020451, "chapter_id": 1427, "verse_number": "३-६५-६", "content_sanskrit": "अस्मिन्कर्मणि निष्पन्ने विज्ञाते निषधाधिपे।\nगवां सहस्रं दास्यामि यो वस्तावानयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020452, "chapter_id": 1427, "verse_number": "३-६५-७", "content_sanskrit": "अग्रहारांश्च दास्यामि ग्रामं नगरसंमितम्।\nहिरण्यंच सुवर्णं च दासीदासं तथैव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020453, "chapter_id": 1427, "verse_number": "३-६५-८", "content_sanskrit": "न चेच्छक्याविहानेतुं दमयन्ती नलोऽपि वा।\nज्ञातमात्रेऽपि दास्यामि गवां दशशतं धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020454, "chapter_id": 1427, "verse_number": "३-६५-९", "content_sanskrit": "इत्युक्तास्ते ययुर्हृष्टा ब्राह्मणाः सर्वतो दिशम्।\nपुरराष्ट्राणि चिन्वन्तो नैषधं सह भार्यया।\nनैव क्वापि प्रपश्यन्ति नलं वा भीमपुत्रिकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020455, "chapter_id": 1427, "verse_number": "३-६५-१०", "content_sanskrit": "ततश्चेदिपुरीं रम्यां सुदेवो नाम वै द्विजः।\nविचिन्वानोऽथ वैदर्भीमपश्यद्राजवेश्मनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020456, "chapter_id": 1427, "verse_number": "३-६५-११", "content_sanskrit": "तयैव राजमाता च ब्राह्मणान्पर्यवेषयत्।\nभोजनार्थे सुदेवोऽपि तत्रैव प्रविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020457, "chapter_id": 1427, "verse_number": "३-६५-१२", "content_sanskrit": "कृशां विवर्णां मलिनां भर्तृशोकपरायणाम्।\nपुण्याहवाचने राज्ञः सुनन्दासहितां स्थिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020458, "chapter_id": 1427, "verse_number": "३-६५-१३", "content_sanskrit": "मन्दं प्रख्यायमानेन रूपेणाप्रतिमेन ताम्।\nनिबद्धां धूमजालेन प्रभामिव विभावसोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020459, "chapter_id": 1427, "verse_number": "३-६५-१४", "content_sanskrit": "तां समीक्ष्य विशालाक्षीमधिकं मलिनां कृशाम्।\nतर्कयामास भैमीति कारणैरुपपादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020460, "chapter_id": 1427, "verse_number": "३-६५-१५x", "content_sanskrit": "सुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020461, "chapter_id": 1427, "verse_number": "३-६५-१५", "content_sanskrit": "यथेयं मे पुरा दृष्टा तथारूपेयमङ्गना।\nकृतार्थोस्म्यद्य दृष्ट्वेमां लोककान्तामिव श्रियं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020462, "chapter_id": 1427, "verse_number": "३-६५-१६", "content_sanskrit": "पूर्णचन्द्राननां श्यामां चारुवृत्तपयोधराम्।\nकुर्वन्तीं प्रभया देवीं सर्वावितिमिरा दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020463, "chapter_id": 1427, "verse_number": "३-६५-१७", "content_sanskrit": "चारुपद्मविशालाक्षीं मन्मथस्य रतीमिव।\nइष्टां समस्तलोकस्य पूर्णचन्द्रप्रभामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020464, "chapter_id": 1427, "verse_number": "३-६५-१८", "content_sanskrit": "विदर्भसरसस्तस्माद्दैवदोषादिवोद्धृताम्।\nमलपङ्कानुलिप्ताङ्गीं प्रम्लानां नलिनीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020465, "chapter_id": 1427, "verse_number": "३-६५-१९", "content_sanskrit": "पौर्णमासीमिव निशां राहुग्रस्तनिशाकराम्।\nपतिशोकाकुलां दीनां कृशस्त्रोतां नदीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020466, "chapter_id": 1427, "verse_number": "३-६५-२०", "content_sanskrit": "विध्वस्तपर्णकमलां वित्रासितविहंगमाम्।\nहस्तिहस्तपरिक्लिष्टां व्याकुलामिव पद्मिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020467, "chapter_id": 1427, "verse_number": "३-६५-२१", "content_sanskrit": "सुकुमारीं सुजाताङ्गीं रत्नगर्भगृहोचिताम्।\nदह्यमानामिवार्केण मृणालीमिव चोद्धृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020468, "chapter_id": 1427, "verse_number": "३-६५-२२", "content_sanskrit": "रूपौदार्यगुणोपेतां मण्डनार्हाममण्डिताम्।\nचन्द्रलेखामिव नवांव्योम्नि नीलाभ्रसंवृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020469, "chapter_id": 1427, "verse_number": "३-६५-२३", "content_sanskrit": "कामभोगैः प्रियैर्हीनां हीनां बन्धुजनेन च।\nदेहं धारयतीं दीनं भर्तृदर्शनकाङ्क्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020470, "chapter_id": 1427, "verse_number": "३-६५-२४", "content_sanskrit": "भर्ता नाम परं नार्या भूषणं भूषणैर्विना।\nएषा हि रहिता तेन शोभमाना न शोभते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020471, "chapter_id": 1427, "verse_number": "३-६५-२५", "content_sanskrit": "दुष्करं कुरुतेऽत्यन्तं हीनो यदनया नलः।\nधारयत्यात्मनो देहं न शोकेनापि सीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020472, "chapter_id": 1427, "verse_number": "३-६५-२६", "content_sanskrit": "इमामसितकेशान्तां शतपत्रायतेक्षणाम्।\nसुखार्हां दुःखितां दृष्ट्वा ममापि व्यथते मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2020473, "chapter_id": 1427, "verse_number": "३-६५-२७", "content_sanskrit": "कदा नु खलुः दुःखस्य पारं यास्यति वै शुभा।\nभर्तुः समागमात्साध्वीरोहिणी शशिनो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2020474, "chapter_id": 1427, "verse_number": "३-६५-२८", "content_sanskrit": "अस्या नूनं पुनर्लाभान्नैषधः प्रीतिमेष्यति।\nराजा राज्यपरिभ्रष्टः पुनर्लब्ध्वेव मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2020475, "chapter_id": 1427, "verse_number": "३-६५-२९", "content_sanskrit": "तुल्यशीलवयोयुक्तां तुल्याभिजनसंवृतम्।\nनैषधोऽर्हति वैदर्भीं तं चेयमसितेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2020476, "chapter_id": 1427, "verse_number": "३-६५-३०", "content_sanskrit": "युक्तं तस्याप्रमेयस्य वीर्यसत्ववतो मया।\nसमाश्वासयितुं भार्यां पतिदर्शनलालसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2020477, "chapter_id": 1427, "verse_number": "३-६५-३१", "content_sanskrit": "अहमाश्वासयाम्येनां पूर्णचन्द्रनिभाननाम्।\nअदृष्टदुःखां दुःखार्तां ध्यानरोदनतत्पराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2020478, "chapter_id": 1427, "verse_number": "३-६५-३२x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2020479, "chapter_id": 1427, "verse_number": "३-६५-३२", "content_sanskrit": "एवं विमृश्य विविधैः कारणैर्लक्षणैश्च ताम्।\nउपगम्य ततो भैमीं सुदेवो ब्राह्मणोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2020480, "chapter_id": 1427, "verse_number": "३-६५-३३", "content_sanskrit": "अहं सुदेवो वैदर्भि भ्रातुस्ते दयितः सखा।\nभीमस्य वचनाद्राज्ञस्त्वामन्वेष्टुमिहागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2020481, "chapter_id": 1427, "verse_number": "३-६५-३४", "content_sanskrit": "कुशली ते पिता राज्ञि जननी भ्रातरश्च ते।\nआयुष्मन्तौ कुशलिनौ तत्रस्थौ दारकौ च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2020482, "chapter_id": 1427, "verse_number": "३-६५-३५", "content_sanskrit": "त्वत्कृतेबन्धुवर्गाश्च गतसत्वा इवासते।\nअन्वेष्टारो ब्राह्मणाश्च भ्रमन्ति शतशो महीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2020483, "chapter_id": 1427, "verse_number": "३-६५-३६x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2020484, "chapter_id": 1427, "verse_number": "३-६५-३६", "content_sanskrit": "अभिज्ञाय सुदेवं तं दमयन्ती युधिष्ठिर।\nपर्यपृच्छत तान्सर्वान्क्रमेण सुहृदः स्वकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2020485, "chapter_id": 1427, "verse_number": "३-६५-३७", "content_sanskrit": "रुरोद च भृशं राजन्वैदर्भी शोककर्शिता।\nदृष्ट्वा सुदेवं सहसा भ्रातुरिष्टं द्विजोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2020486, "chapter_id": 1427, "verse_number": "३-६५-३८", "content_sanskrit": "ततो रुदन्तीं तां दृष्ट्वा सुनन्दा शोककर्शिता।\nसुदेवेन सहैकान्ते कथयन्तीं च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2020487, "chapter_id": 1427, "verse_number": "३-६५-३९", "content_sanskrit": "जनित्र्याः प्रेषयामास सैरन्ध्री रुदते भृशम्।\nब्राह्मणेन सहागम्य तांविद्धि यदि मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2020488, "chapter_id": 1427, "verse_number": "३-६५-४०", "content_sanskrit": "अथ चेदिपतेर्माता राज्ञश्चान्तःपुरात्तदा।\nजगाम यत्रसा बाला ब्राह्मणेन सहाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2020489, "chapter_id": 1427, "verse_number": "३-६५-४१", "content_sanskrit": "ततः सुदेवमानाय्य राजमाता विशांपते।\nपप्रच्छ भार्या कस्येयं सुता वा कस्य भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2020490, "chapter_id": 1427, "verse_number": "३-६५-४२", "content_sanskrit": "कथं च नष्टा ज्ञातिभ्यो भर्तुर्वा वामलोचना।\nत्वया च विदिता विप्र कथमेवंगता सती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2020491, "chapter_id": 1427, "verse_number": "३-६५-४३", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं त्वत्तः सर्वमशेषतः।\nतत्त्वेन हि ममाचक्ष्व पृच्छन्त्यादेवरूपिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2020492, "chapter_id": 1427, "verse_number": "३-६५-४४", "content_sanskrit": "एवमुक्तस्तया राजन्सुदेवो द्विजसत्तमः।\nसुखोपविष्ट आचष्ट दमयन्त्या यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2020493, "chapter_id": 1427, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि पञ्चषष्टितमोऽध्यायः ॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]