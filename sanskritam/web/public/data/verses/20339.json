[{"id": 7000339000, "chapter_id": 20339, "verse_number": "२-११-१", "content_sanskrit": "ऋषय ऊचुः ।\nसर्वज्ञेन त्वया प्रोक्तं दैत्यदानवसंगरम् ।\nइदानीं श्रोतुमिच्छामः सुव्रतस्य महात्मनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000339001, "chapter_id": 20339, "verse_number": "२-११-२", "content_sanskrit": "कस्य पुत्रो महाप्राज्ञः कस्य गोत्रसमुद्भवः ।\nकिं तपस्तस्य विप्रस्य कथमाराधितो हरिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000339002, "chapter_id": 20339, "verse_number": "२-११-३", "content_sanskrit": "सूत उवाच ।\nकथा प्रज्ञाप्रभावेण पूर्वमेव यथा श्रुता ।\nतथा विप्राः प्रवक्ष्यामि सुव्रतस्य महात्मनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000339003, "chapter_id": 20339, "verse_number": "२-११-४", "content_sanskrit": "चरितं पावनं दिव्यं वैष्णवं श्रेयआवहम् ।\nभवतामग्रतः सर्वं विष्णोश्चैव प्रसादतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000339004, "chapter_id": 20339, "verse_number": "२-११-५", "content_sanskrit": "पूर्वकल्पे महाभागाः सुक्षेत्रे पापनाशने ।\nरेवातीरे सुपुण्ये च तीर्थे वामनसंज्ञके ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000339005, "chapter_id": 20339, "verse_number": "२-११-६", "content_sanskrit": "कौशिकस्य कुले जातः सोमशर्मा द्विजोत्तमः ।\nस तु पुत्रविहीनस्तु बहुदुःखसमन्वितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000339006, "chapter_id": 20339, "verse_number": "२-११-७", "content_sanskrit": "दारिद्रेण स दुःखेन सर्वदैवप्रपीडितः ।\nपुत्रोपायं धनस्यापि दिवारात्रौ प्रचिंतयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000339007, "chapter_id": 20339, "verse_number": "२-११-८", "content_sanskrit": "एकदा तु प्रिया तस्य सुमना नाम सुव्रता ।\nभर्तारं चिंतयोपेतमधोमुखमलक्षयत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000339008, "chapter_id": 20339, "verse_number": "२-११-९", "content_sanskrit": "समालोक्य तदा कांतं तमुवाच तपस्विनी ।\nदुःखजालैरसंख्यैस्तु तव चित्तं प्रधर्षितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000339009, "chapter_id": 20339, "verse_number": "२-११-१०", "content_sanskrit": "व्यामोहेन प्रमूढोसि त्यज चिंतां महामते ।\nमम दुःखं समाचक्ष्व स्वस्थो भव सुखं व्रज ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000339010, "chapter_id": 20339, "verse_number": "२-११-११", "content_sanskrit": "नास्ति चिंतासमं दुःखं कायशोषणमेव हि ।\nयश्चिंतां त्यज्य वर्तेत स सुखेन प्रमोदते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000339011, "chapter_id": 20339, "verse_number": "२-११-१२", "content_sanskrit": "चिंतायाः कारणं विप्र कथयस्व ममाग्रतः ।\nप्रियावाक्यं समाकर्ण्य सोमशर्माब्रवीत्प्रियाम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000339012, "chapter_id": 20339, "verse_number": "२-११-१३", "content_sanskrit": "सोमशर्मोवाच ।\nइच्छया चिंतितं भद्रे चिंता दुःखस्य कारणम् ।\nतत्सर्वं तु प्रवक्ष्यामि श्रुत्वा चैवावधार्यताम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000339013, "chapter_id": 20339, "verse_number": "२-११-१४", "content_sanskrit": "न जाने केन पापेन धनहीनोस्मि सुव्रते ।\nतथा पुत्रविहीनश्च एतद्दुःखस्य कारणम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000339014, "chapter_id": 20339, "verse_number": "२-११-१५", "content_sanskrit": "सुमनोवाच ।\nश्रूयतामभिधास्यामि सर्वसंदेहनाशनम् ।\nस्वरूपमुपदेशस्य सर्वविज्ञानदर्शनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000339015, "chapter_id": 20339, "verse_number": "२-११-१६", "content_sanskrit": "लोभः पापस्य बीजं हि मोहो मूलं च तस्य हि ।\nअसत्यं तस्य वै स्कंधो माया शाखा सुविस्तरा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000339016, "chapter_id": 20339, "verse_number": "२-११-१७", "content_sanskrit": "दंभकौटिल्यपत्राणि कुबुद्ध्या पुष्पितः सदा ।\nअनृतं तस्य सौगंधं फलमज्ञानमेव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000339017, "chapter_id": 20339, "verse_number": "२-११-१८", "content_sanskrit": "छद्मपाखंडशौर्येर्ष्याः क्रूराः कूटाश्च पापिनः ।\nपक्षिणो मोहवृक्षस्य मायाशाखा समाश्रिताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000339018, "chapter_id": 20339, "verse_number": "२-११-१९", "content_sanskrit": "अज्ञानं सुफलं तस्य रसोऽधर्मः फलस्य हि ।\nतृष्णोदकेन संवृद्धाऽश्रद्धा तस्य द्रवः प्रिय ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000339019, "chapter_id": 20339, "verse_number": "२-११-२०", "content_sanskrit": "अधर्मः सुरसस्तस्य उत्कटो मधुरायते ।\nयादृशैश्च फलैश्चैव सुफलो लोभपादपः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000339020, "chapter_id": 20339, "verse_number": "२-११-२१", "content_sanskrit": "अस्यच्छायां समाश्रित्य यो नरः परितुष्यते ।\nफलानि तस्य चाश्नाति सुपक्वानि दिनेदिने ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000339021, "chapter_id": 20339, "verse_number": "२-११-२२", "content_sanskrit": "फलानां तु रसेनापि अधर्मेण तु पालितः ।\nस संतुष्टो भवेन्मर्त्यः पतनायाभिगच्छति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000339022, "chapter_id": 20339, "verse_number": "२-११-२३", "content_sanskrit": "तस्माच्चिंतां परित्यज्य पुमांल्लोभं न कारयेत् ।\nधनपुत्रकलत्राणां चिंतामेकां न कारयेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000339023, "chapter_id": 20339, "verse_number": "२-११-२४", "content_sanskrit": "यो हि विद्वान्भवेत्कांत मूर्खाणां पथमेति हि ।\nमूर्खश्चिंतयते नित्यं कथमर्थं ममैव हि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000339024, "chapter_id": 20339, "verse_number": "२-११-२५", "content_sanskrit": "सुभार्यामिह विंदामि कथं पुत्रानहं लभे ।\nएवं चिंतयते नित्यं दिवारात्रौ विमोहितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000339025, "chapter_id": 20339, "verse_number": "२-११-२६", "content_sanskrit": "क्षणमेकं प्रपश्येत चिंतामध्ये महत्सुखम् ।\nपुनश्चैतन्यमायाति महादुःखेन पीड्यते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000339026, "chapter_id": 20339, "verse_number": "२-११-२७", "content_sanskrit": "चिंतामोहौ परित्यज्य अनुवर्तस्व च द्विज ।\nसंसारे नास्ति संबंधः केन सार्धं महामते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000339027, "chapter_id": 20339, "verse_number": "२-११-२८", "content_sanskrit": "मित्राश्च बांधवाः पुत्राः पितृमातृसभृत्यकाः ।\nसंबंधिनो भवंत्येव कलत्राणि तथैव च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000339028, "chapter_id": 20339, "verse_number": "२-११-२९", "content_sanskrit": "सोमशर्मोवाच ।\nसंबंधः कीदृशो भद्रे तथा विस्तरतो वद ।\nयेन संबंधिनः सर्वे धनपुत्रादिबांधवाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000339029, "chapter_id": 20339, "verse_number": "२-११-३०", "content_sanskrit": "सुमनोवाच ।\nऋणसंबंधिनः केचित्केचिन्न्यासापहारकाः ।\nलाभप्रदा भवंत्येके उदासीनास्तथापरे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000339030, "chapter_id": 20339, "verse_number": "२-११-३१", "content_sanskrit": "भेदैश्चतुर्भिर्जायंते पुत्रमित्रस्त्रियस्तथा ।\nभार्या पिता च माता च भृत्याः स्वजनबांधवाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000339031, "chapter_id": 20339, "verse_number": "२-११-३२", "content_sanskrit": "स्वेनस्वेन हि जायंते संबंधेन महीतले ।\nन्यासापहारभावेन यस्य येन कृतं भुवि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000339032, "chapter_id": 20339, "verse_number": "२-११-३३", "content_sanskrit": "न्यासस्वामी भवेत्पुत्रो गुणवान्रूपवान्भुवि ।\nयेनैवापह्रतं न्यासं तस्य गेहे न संशयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000339033, "chapter_id": 20339, "verse_number": "२-११-३४", "content_sanskrit": "न्यासापहरणाद्दुःखं स दत्वा दारुणं गतः ।\nन्यासस्वामी सुपुत्रोभून्न्यासापहारकस्य च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000339034, "chapter_id": 20339, "verse_number": "२-११-३५", "content_sanskrit": "गुणवान्रूपवांश्चैव सर्वलक्षणसंयुतः ।\nभक्तिं तु दर्शयंस्तस्य पुत्रो भूत्वा दिनेदिने ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000339035, "chapter_id": 20339, "verse_number": "२-११-३६", "content_sanskrit": "प्रियवाङ्मधुरो रोगी बहुस्नेहं विदर्शयन् ।\nस्वीयं द्रव्यं समुद्गृह्य प्रीतिमुत्पाद्य चोत्तमाम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000339036, "chapter_id": 20339, "verse_number": "२-११-३७", "content_sanskrit": "यथा येन प्रदत्तं स्यान्न्यासस्य हरणात्पुरा ।\nदुःखमेव महाभाग दारुणं प्राणनाशनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000339037, "chapter_id": 20339, "verse_number": "२-११-३८", "content_sanskrit": "तादृशं तस्य सौहृद्यात्पुत्रो भूत्वा महागुणैः ।\nअल्पायुषस्तथा भूत्वा मरणं चोपगच्छति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000339038, "chapter_id": 20339, "verse_number": "२-११-३९", "content_sanskrit": "दुःखं दत्वा प्रयात्येवं भूत्वाभूत्वा पुनःपुनः ।\nयदा हा पुत्रपुत्रेति प्रलापं हि करोति सः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000339039, "chapter_id": 20339, "verse_number": "२-११-४०", "content_sanskrit": "तदा हास्यं करोत्येव कस्य पुत्रो हि कः पिता ।\nअनेनापहृतं न्यासं मदीयस्योपकारणम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000339040, "chapter_id": 20339, "verse_number": "२-११-४१", "content_sanskrit": "द्रव्यापहरणेनापि न मे प्राणा गताः किल ।\nदुःखेन महता चैव असह्येन च वै पुरा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000339041, "chapter_id": 20339, "verse_number": "२-११-४२", "content_sanskrit": "तथा दुःखं प्रदत्वाहं द्रव्यमुद्गृह्य चोत्तमम् ।\nगंतास्मि सुभृशं चाद्य कस्याहं सुत ईदृशः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000339042, "chapter_id": 20339, "verse_number": "२-११-४३", "content_sanskrit": "न चैष मे पिता पुत्रः पूर्वमेव न कस्यचित् ।\nपिशाचत्वं मया दत्तमस्यैवेति दुरात्मनः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000339043, "chapter_id": 20339, "verse_number": "२-११-४४", "content_sanskrit": "एवमुक्त्वा प्रयात्येवं तं प्रहस्य पुनःपुनः ।\nप्रयात्यनेन मार्गेण दुःखं दत्वा सुदारुणम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000339044, "chapter_id": 20339, "verse_number": "२-११-४५", "content_sanskrit": "एवं न्यासं समुद्धर्तुः पुत्राः कांत भवंति वै ।\nसंसारे दुःखबहुला दृश्यंते यत्रतत्र च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000339045, "chapter_id": 20339, "verse_number": "२-११-४६", "content_sanskrit": "ऋणसंबंधिनः पुत्रान्प्रवक्ष्यामि तवाग्रतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]