[{"id": 2099944, "chapter_id": 3140, "verse_number": "१३-२७०-१", "content_sanskrit": "भीष्म उवाच।\nकार्यते यच्च क्रियते सच्चासच्च कृताकृतम्।\nतत्राश्वसीत सत्कृत्वा असत्कृत्वा न विश्वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099945, "chapter_id": 3140, "verse_number": "१३-२७०-२", "content_sanskrit": "काल एवान्तराशक्तिर्निग्रहानुग्रहौ ददत्।\nबुद्धिमाविश्य भूतानां धर्माधर्मौ प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099946, "chapter_id": 3140, "verse_number": "१३-२७०-३", "content_sanskrit": "यदा त्वस्य भवेद्बुद्धिर्धर्मार्थस्य प्रदर्शनात्।\nतदाश्वसीत धर्मात्मा दृढबुद्धिर्न विश्वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099947, "chapter_id": 3140, "verse_number": "१३-२७०-४", "content_sanskrit": "एतावन्मात्रमेतद्धि भूतानां प्राज्ञलक्षणम्।\nकालयुक्तोऽप्युभयविच्छेषं युक्तं समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099948, "chapter_id": 3140, "verse_number": "१३-२७०-५", "content_sanskrit": "यथा ह्युपस्थितैश्वर्याः पूजयन्ति नरा जनान्।\nएवमेवात्मनाऽऽत्मानं पूजयन्तीह धार्मिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099949, "chapter_id": 3140, "verse_number": "१३-२७०-६", "content_sanskrit": "`भावशुद्धिस्तु तपसा देवतानां च मूजया।\nसनातनेन शुद्ध्या च श्रुतदानजपैरपि।\nन ह्यशुद्धस्तु तां दद्याद्धर्मकाले कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099950, "chapter_id": 3140, "verse_number": "१३-२७०-७", "content_sanskrit": "न ह्यधर्मतया धर्मं दद्यात्कालः कथञ्चन।\nतस्माद्विशुद्धमात्मानं जानीयाद्धर्मचारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099951, "chapter_id": 3140, "verse_number": "१३-२७०-८", "content_sanskrit": "स्प्रष्टुमप्यसमर्थो हि ज्वलन्तमिव पावकम्।\nअधर्मः सन्ततो धर्मं कालेन परिरक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099952, "chapter_id": 3140, "verse_number": "१३-२७०-९", "content_sanskrit": "कार्यावेतौ हि धर्मोणि धर्मो हि विजयावहः।\nत्रयाणामपि लोकानामालोकः कारणं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099953, "chapter_id": 3140, "verse_number": "१३-२७०-१०", "content_sanskrit": "न तु कश्चिन्नयेत्प्राज्ञो गृहीत्वैव करे नरम्।\nऊह्यमानस्तु धर्मेण प्राप्नुयात्परमच्युतम्।\nविश्वास एव कर्तव्यो बहुधर्मे शुभच्छले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099954, "chapter_id": 3140, "verse_number": "१३-२७०-११", "content_sanskrit": "शूद्रोऽहं नाधिकारो मे चातुराश्रम्यसेवने।\nइति विज्ञानमपरे नात्मन्युपदधत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099955, "chapter_id": 3140, "verse_number": "१३-२७०-१२", "content_sanskrit": "विशेषेण च वक्ष्यामि चातुर्वर्ण्यस्य लिङ्गतः।\nपञ्चभूतशरीराणां सर्वेषां सदृशात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099956, "chapter_id": 3140, "verse_number": "१३-२७०-१३", "content_sanskrit": "लोकधर्मे च धर्मे च विशेषकरणं कृतम्।\nयथैकत्वं पुनर्यान्ति प्राणिनस्तत्र विस्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099957, "chapter_id": 3140, "verse_number": "१३-२७०-१४", "content_sanskrit": "अध्रुवो हि कथं लोकः स्मृतो धर्मः कथं ध्रुवः।\nयत्र कालो ध्रुवस्तात तत्र धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099958, "chapter_id": 3140, "verse_number": "१३-२७०-१५", "content_sanskrit": "सर्वेषां तुल्यदेहानां सर्वेषां सदृशात्मनाम्।\nकालो धर्मेण संयुक्तः शेष एव स्वयं गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099959, "chapter_id": 3140, "verse_number": "१३-२७०-१६", "content_sanskrit": "एवं सति न दोषोऽस्ति भूतानां धर्मसेवने।\nतिर्यग्योनावपि सतां लोक एव मतो गुरुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099960, "chapter_id": 3140, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तत्यधिकद्विशततमोऽध्यायः॥ २७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]