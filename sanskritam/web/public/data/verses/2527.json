[{"id": 2072409, "chapter_id": 2527, "verse_number": "१२-३२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072410, "chapter_id": 2527, "verse_number": "१२-३२-१", "content_sanskrit": "युधिष्ठिरस्य तद्वाक्यं श्रुत्वा द्वैपायनस्तदा।\nपरीक्ष्य निपुणं बुद्ध्या ऋषिः प्रोवाच पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072411, "chapter_id": 2527, "verse_number": "१२-३२-२x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072412, "chapter_id": 2527, "verse_number": "१२-३२-२", "content_sanskrit": "मा विषादं कृथा राजन्क्षत्रधर्ममनुस्मरन्।\nस्वधर्मेण हता ह्येते क्षत्रियाः क्षत्रियर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072413, "chapter_id": 2527, "verse_number": "१२-३२-३", "content_sanskrit": "काङ्क्षमाणाः श्रियं कृत्स्नां पृथिव्यां च मबद्यशः।\nकृतान्तविधिसंयुक्ताः कालेन निधनं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072414, "chapter_id": 2527, "verse_number": "१२-३२-४", "content_sanskrit": "नृ त्वं हन्ता न भीमोऽयं नार्जुनो न यमावपि।\nकालः पर्यायधर्मेण प्राणानादत्त देहिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072415, "chapter_id": 2527, "verse_number": "१२-३२-५", "content_sanskrit": "न तस्य मातापितरौ नानुग्राह्यो हि कश्चन।\nकर्मसाक्षी प्रजानां यस्तेन कालेन संहृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072416, "chapter_id": 2527, "verse_number": "१२-३२-६", "content_sanskrit": "हेतुमात्रमिदं तस्य विहितं भरतर्षभ।\nयद्धन्ति भूतैर्भूतानि तदस्मै रूपमैश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072417, "chapter_id": 2527, "verse_number": "१२-३२-७", "content_sanskrit": "कर्म मूर्त्यात्मकं विद्धि साक्षिणं शुभपापयोः।\nसुखदुःखगुणोदर्कं कालं कालफलप्रदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072418, "chapter_id": 2527, "verse_number": "१२-३२-८", "content_sanskrit": "तेषामपि महाबाहो कर्माणि परिचिन्तय।\nविनाशहेतुकानि त्वं यैस्तै कालवशं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072419, "chapter_id": 2527, "verse_number": "१२-३२-९", "content_sanskrit": "आत्मनश्च विजानीहि नियतव्रतशीलताम्।\nयदा त्वमीदृशं कर्म विधिनाऽऽक्रम्य कारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072420, "chapter_id": 2527, "verse_number": "१२-३२-१०", "content_sanskrit": "त्वष्ट्रेव विहितं यन्त्रं यथा चेष्टयितुर्वशे।\nकर्मणा कालयुक्तेन तथेदं भ्राम्यते जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072421, "chapter_id": 2527, "verse_number": "१२-३२-११", "content_sanskrit": "पुरुषस्य हि दृष्ट्वेमामुत्पत्तिमनिमित्ततः।\nयदृच्छया विनाशं च शोकहर्षावनर्थकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072422, "chapter_id": 2527, "verse_number": "१२-३२-१२", "content_sanskrit": "व्यलीकमपि यत्त्वत्र चित्तवैतंसिकं तव।\nतदर्थमिष्यते राजन्प्रायश्चित्तं तदाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072423, "chapter_id": 2527, "verse_number": "१२-३२-१३", "content_sanskrit": "इदं तु श्रूयते पार्थ युद्धे देवासुरे पुरा।\nअसुरा भ्रातरो ज्येष्ठा देवाश्चापि यवीयसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072424, "chapter_id": 2527, "verse_number": "१२-३२-१४", "content_sanskrit": "तेषामपि श्रीनिमित्तं महानासीत्समुच्छ्रयः।\nयुद्धं वर्षसहस्राणि द्वात्रिंशदभवत्किल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072425, "chapter_id": 2527, "verse_number": "१२-३२-१५", "content_sanskrit": "एकार्णवां महीं कृत्वा रुधिरेण परिप्लुताम्।\nजघ्नुर्दैत्यांस्तथा देवास्त्रिदिवं चाभिलेभिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072426, "chapter_id": 2527, "verse_number": "१२-३२-१६", "content_sanskrit": "तथैव पृथिवीं लब्ध्वा ब्राह्मणा वेदपारगाः।\nसंश्रिता दानवानां वै साह्यार्थं दर्पमोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072427, "chapter_id": 2527, "verse_number": "१२-३२-१७", "content_sanskrit": "शालावृका इति ख्यातास्त्रिषु लोकेषु भारत।\nअष्टाशीतिसहस्राणि ते चापि विबुर्धैर्हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072428, "chapter_id": 2527, "verse_number": "१२-३२-१८", "content_sanskrit": "धर्मव्युच्छित्तिमिच्छतो येऽधर्मस्य प्रवर्तकाः।\nहन्तव्यास्ते दुरात्मानो देवैर्दैत्या इवोल्वणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072429, "chapter_id": 2527, "verse_number": "१२-३२-१९", "content_sanskrit": "एकं हत्वा यदि कुले शिष्टानां स्यादनामयम्।\nकुलं हत्वा च राष्ट्रे च न तद्वृत्तोपघातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2072430, "chapter_id": 2527, "verse_number": "१२-३२-२०", "content_sanskrit": "अधर्मरूपो धर्मो हि कश्चिदस्ति नराधिप।\nधर्मरूपो ह्यधर्मश्च तच्च ज्ञेयं विपश्चिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2072431, "chapter_id": 2527, "verse_number": "१२-३२-२१", "content_sanskrit": "तस्मात्संस्तम्भयात्मानं श्रुतवानसि पाण्डव।\nदेवैः पूर्वगतं मार्गमनुयातोऽसि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2072432, "chapter_id": 2527, "verse_number": "१२-३२-२२", "content_sanskrit": "न हीदृशा गमिष्यन्ति नरकं पाण्डवर्षभ।\nभ्रातॄनाश्वासयैतांस्त्वं सुहृदश्च परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2072433, "chapter_id": 2527, "verse_number": "१२-३२-२३", "content_sanskrit": "यो हि पापसमारम्भे कार्ये तद्भावभावितः।\nकुर्वन्नपि तथैव स्यात्कृत्वा च निरपत्रपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2072434, "chapter_id": 2527, "verse_number": "१२-३२-२४", "content_sanskrit": "तस्मिंस्तत्कलुषं सर्वं समस्तमिति शब्दितम्।\nप्रायश्चित्तं न तस्यास्ति ह्रासो वा पापकर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2072435, "chapter_id": 2527, "verse_number": "१२-३२-२५", "content_sanskrit": "त्वं तु शुक्लाभिजातीयः परदोषेण कारितः।\nअनिच्छमानः कर्मेदं कृत्वा च परितप्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2072436, "chapter_id": 2527, "verse_number": "१२-३२-२६", "content_sanskrit": "अश्वमेधो महायज्ञः प्रायश्चित्तमुदाहृतम्।\nतमाहर महाराज विपाप्मैवं भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2072437, "chapter_id": 2527, "verse_number": "१२-३२-२७", "content_sanskrit": "मरुद्भिः सह जित्वाऽरीन्भगवान्पाकशासनः।\nएकैकं क्रतुमाहृत्य शतकृत्वः शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2072438, "chapter_id": 2527, "verse_number": "१२-३२-२८", "content_sanskrit": "धूतपाप्मा जितस्वर्गो लोकान्प्राप्य सुखोदयान्।\nमरुद्गणैर्वृतः शक्रः शुशुभे भासयन्दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2072439, "chapter_id": 2527, "verse_number": "१२-३२-२९", "content_sanskrit": "स्वर्गे लोके महीयन्तमप्सरोभिः शचीपतिम्।\nऋषयः पर्युपासन्ते देवाश्च विबुधेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2072440, "chapter_id": 2527, "verse_number": "१२-३२-३०", "content_sanskrit": "सेयं त्वामनुसंप्राप्ता विक्रमेण वसुंधरा।\nनिर्जिताश्च महीपाला विक्रमेण त्वयाऽनध॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2072441, "chapter_id": 2527, "verse_number": "१२-३२-३१", "content_sanskrit": "तेषां पुराणि राष्ट्राणि गत्वा राजन्सुहृद्वॄतः।\nभ्रातॄन्पुत्रांश्च पौत्रांश्च स्वेस्वे राज्येऽभिषेचय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2072442, "chapter_id": 2527, "verse_number": "१२-३२-३२", "content_sanskrit": "बालानपि च गर्भस्थान्सांत्वेन समुदाचरन्।\nरञ्जयन्प्रकृतीः सर्वाः परिपाहि वसुंधराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2072443, "chapter_id": 2527, "verse_number": "१२-३२-३३", "content_sanskrit": "कुमारो नास्ति येषां च कन्यास्तत्राभिषेचय।\nकामाशयो हि स्त्रीवर्गः शोकमेवं प्रहास्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2072444, "chapter_id": 2527, "verse_number": "१२-३२-३४", "content_sanskrit": "एवमाश्वासनं कृत्वा सर्वराष्ट्रेषु भारत।\nयजस्व वाजिमेधेन यथेन्द्रो विजयी पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2072445, "chapter_id": 2527, "verse_number": "१२-३२-३५", "content_sanskrit": "अशोच्यास्ते महात्मानः क्षत्रियाः क्षत्रियर्षभ।\nस्वकर्मभिर्गता नाशं कृतान्तबलमोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2072446, "chapter_id": 2527, "verse_number": "१२-३२-३६", "content_sanskrit": "अवाप्तः क्षत्रधर्मस्ते राज्यं प्राप्तमकण्टकम्।\nरक्ष स्वधर्मं कौन्तेय श्रेयान्यः प्रेत्यभाविकः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2072447, "chapter_id": 2527, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि द्वात्रिंशोऽध्यायः॥ ३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]