[{"id": 5000607000, "chapter_id": 9607, "verse_number": "७-७२-१", "content_sanskrit": "तं शयानं नरव्याघ्रं निद्रा नाभ्यागमत्तदा ।\nचिन्तयन्तमनेकार्थं रामगीतमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000607001, "chapter_id": 9607, "verse_number": "७-७२-२", "content_sanskrit": "तस्य शब्दं सुमधुरं तन्त्रीलयसमन्वितम् ।\nश्रुत्वा रात्रिर्जगामाशु शत्रुघ्नस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000607002, "chapter_id": 9607, "verse_number": "७-७२-३", "content_sanskrit": "तस्यां निशायां व्युष्टायां कृत्वा पौर्वाह्णिकं क्रमम् ।\nउवाच प्राञ्जलिर्वाक्यं शत्रुघ्नो मुनिपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000607003, "chapter_id": 9607, "verse_number": "७-७२-४", "content_sanskrit": "भगवन्द्रष्टुमिच्छामि राघवं रघुनन्दनम् ।\nत्वया ऽनुज्ञातुमिच्छामि सहैभिः संशितव्रतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000607004, "chapter_id": 9607, "verse_number": "७-७२-५", "content_sanskrit": "इत्येवंवादिनं तं तु शत्रुघ्नं शत्रुतापनम् ।\nवाल्मीकिः सम्परिष्वज्य विससर्ज च राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000607005, "chapter_id": 9607, "verse_number": "७-७२-६", "content_sanskrit": "सो ऽभिवाद्य मुनिश्रेष्ठं रथमारुह्य सुप्रभम् ।\nअयोध्यामगमत्तूर्णं राघवोत्सुकदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000607006, "chapter_id": 9607, "verse_number": "७-७२-७", "content_sanskrit": "स प्रविष्टः पुरीं रम्यां श्रीमानिक्ष्वाकुनन्दनः ।\nप्रविवेश महाबाहुर्यत्र रामो महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000607007, "chapter_id": 9607, "verse_number": "७-७२-८", "content_sanskrit": "स रामं मन्त्रिमध्यस्थं पूर्णचन्द्रनिभाननम् ।\nपश्यन्नमरमध्यस्थं सहस्रनयनं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000607008, "chapter_id": 9607, "verse_number": "७-७२-९", "content_sanskrit": "सो ऽभिवाद्य महात्मानं ज्वलन्तमिव तेजसा ।\nउवाच प्राञ्जलिर्वाक्यं रामं सत्यपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000607009, "chapter_id": 9607, "verse_number": "७-७२-१०", "content_sanskrit": "यदाज्ञप्तं महाराज सर्वं तत्कृतवानहम् ।\nहतः स लवणः पापः पुरी चास्य निवेशिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000607010, "chapter_id": 9607, "verse_number": "७-७२-११", "content_sanskrit": "द्वादशैते गता वर्षास्त्वां विना रघुनन्दन ।\nनोत्सहेयमहं वस्तुं त्वया विरहितो नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000607011, "chapter_id": 9607, "verse_number": "७-७२-१२", "content_sanskrit": "स मे प्रसादं काकुत्स्थ कुरुष्वामितविक्रम ।\nमातृहीनो यथा वत्सो न चिरं प्रवसाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000607012, "chapter_id": 9607, "verse_number": "७-७२-१३", "content_sanskrit": "एवं ब्रुवाणं शत्रुघ्नं परिष्वज्येदमब्रवीत् ।\nमा विषादं कृथाः शूर नैतत्क्षत्रियचेष्टितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000607013, "chapter_id": 9607, "verse_number": "७-७२-१४", "content_sanskrit": "नावसीदन्ति राजानो विप्रवासेषु राघव ।\nप्रजा नः परिपाल्या हि क्षत्रधर्मेण राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000607014, "chapter_id": 9607, "verse_number": "७-७२-१५", "content_sanskrit": "काले काले तु मां वीर अयोध्यामवलोकितुम् ।\nआगच्छ त्वं नरश्रेष्ठ गन्तासि च पुरं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000607015, "chapter_id": 9607, "verse_number": "७-७२-१६", "content_sanskrit": "ममापि त्वं सुदयितः प्राणैरपि न संशयः ।\nअवश्यं करणीयं च राज्यस्य परिपालनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000607016, "chapter_id": 9607, "verse_number": "७-७२-१७", "content_sanskrit": "तस्मात्त्वं वस काकुत्स्थ सप्तरात्रमिहावस ।\nऊर्ध्वं गन्तासि मधुरां सभृत्यबलवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000607017, "chapter_id": 9607, "verse_number": "७-७२-१८", "content_sanskrit": "रामस्यैतद्वचः श्रुत्वा धर्मयुक्तं मनोगतम् ।\nशत्रुघ्नो दीनया वाचा बाढमित्येव चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000607018, "chapter_id": 9607, "verse_number": "७-७२-१९", "content_sanskrit": "सप्तरात्रं च काकुत्स्थो राघवस्य यथाज्ञया ।\nउष्य तत्र महेष्वासो गमनायोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000607019, "chapter_id": 9607, "verse_number": "७-७२-२०", "content_sanskrit": "आमन्त्र्य तु महात्मानं रामं सत्यपराक्रमम् ।\nभरतं लक्ष्मणं चैव महारथमुपारुहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000607020, "chapter_id": 9607, "verse_number": "७-७२-२१", "content_sanskrit": "दूरमाभ्यामनुगतो लक्ष्मणेन महात्मना ।\nभरतेन च शत्रुघ्नो जगामाशु पुरं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000607021, "chapter_id": 9607, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे द्विसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]