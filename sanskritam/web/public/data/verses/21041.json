[{"id": 7001041000, "chapter_id": 21041, "verse_number": "५-२३-१", "content_sanskrit": "श्रीपराशर उवाच\nगार्ग्यं गोष्ठ्यां द्विजं श्यालष्षंड इत्युक्तवान्द्विज ।\nयदूनां सन्निधौ सर्वे जहसुर्यादवास्तदा  ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001041001, "chapter_id": 21041, "verse_number": "५-२३-२", "content_sanskrit": "ततः कोपपरीतात्मा दक्षिणापथमेत्य सः ।\nसुतमिच्छंस्तपस्तेपे यदुचक्रभयावहम्  ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001041002, "chapter_id": 21041, "verse_number": "५-२३-३", "content_sanskrit": "आराधयन्महादेवं लोहचूर्णमभक्षयत् ।\nददौ वरं च तुष्टोऽस्मै वर्षे तु द्वादशो! हरः  ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001041003, "chapter_id": 21041, "verse_number": "५-२३-४", "content_sanskrit": "संतोषयामास च तं यवनेशो ह्यनात्मजः\nतद्योषित्संगमाच्चास्य पुत्रोऽभूदलिसन्निभः  ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001041004, "chapter_id": 21041, "verse_number": "५-२३-५", "content_sanskrit": "तं कालयवनं नाम राये स्वे यवनेश्वरः ।\nअभिषिच्य वनं यातो वज्राग्रकठिनोरसम्  ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001041005, "chapter_id": 21041, "verse_number": "५-२३-६", "content_sanskrit": "स तु वीर्यमदोन्मत्तः पृथिव्यां बलिनो नृपान् ।\nअपृच्छन्नारदस्तस्मै कथयामास यादवान्  ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001041006, "chapter_id": 21041, "verse_number": "५-२३-७", "content_sanskrit": "म्लेच्छकोटिसहस्राणां सहस्रैस्सोभिसंवृतः ।\nगजाश्वरथसंपन्नैश्चकार परमोद्यमम्  ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001041007, "chapter_id": 21041, "verse_number": "५-२३-८", "content_sanskrit": "प्रययौ स व्यवच्छिन्नं छिन्नयानो दिनेदिने ।\nयादवान्प्रति सामर्षो मैत्रेय मथुरां पुरीम्  ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001041008, "chapter_id": 21041, "verse_number": "५-२३-९", "content_sanskrit": "कृष्णोऽपि चिंतयामास क्षपितं यादवं बलम् ।\nयवनेन रणे गम्यं मागधस्य भविष्यति  ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001041009, "chapter_id": 21041, "verse_number": "५-२३-१०", "content_sanskrit": "मागधस्य बलं क्षीणं स कालयवनो बली ।\nहंतैतदेवमायातं यदूनां व्यसनं द्विधा  ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001041010, "chapter_id": 21041, "verse_number": "५-२३-११", "content_sanskrit": "तस्माद्दुर्गं करिष्यामि यदूनामरिदुर्जयम् ।\nस्त्रियोऽपि यत्र युद्धेयुः किं पुनर्वृष्णिपुंगवाः  ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001041011, "chapter_id": 21041, "verse_number": "५-२३-१२", "content_sanskrit": "मयि मत्ते प्रमत्ते वा सुप्ते प्रवसितेऽपि वा ।\nयादवाभिभवं दुष्टा मा कुर्वंस्त्वरयोधिकाः  ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001041012, "chapter_id": 21041, "verse_number": "५-२३-१३", "content_sanskrit": "इति संचिंत्य गोविंदो योजनानां महोदधिम् ।\nययाचे द्वादशपुरीं द्वारकां तत्र निर्ममे  ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001041013, "chapter_id": 21041, "verse_number": "५-२३-१४", "content_sanskrit": "महोद्यानां महावप्रां तटाकशतशोभिताम् ।\nप्रासादगृहसंबाधामिंद्रस्येवामरावतीम्  ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001041014, "chapter_id": 21041, "verse_number": "५-२३-१५", "content_sanskrit": "मथुरावासिनं लोकं तत्रानीय जनार्दनः ।\nआसन्ने कालयवने मथुरां च स्वयं ययौ  ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001041015, "chapter_id": 21041, "verse_number": "५-२३-१६", "content_sanskrit": "बहिरावासिते सैन्ये मथुराया निरायुधः ।\nनिर्जगाम च गोविंदो ददर्श यवनश्च तम्  ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001041016, "chapter_id": 21041, "verse_number": "५-२३-१७", "content_sanskrit": "स ज्ञात्वा वासुदेवं तं बाहुप्रहरणं नृपः ।\nअनुयातो महायोगी चेतोभिः प्राप्यते न यः  ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001041017, "chapter_id": 21041, "verse_number": "५-२३-१८", "content_sanskrit": "तेनानुयातः कृष्णोऽपि प्रविवेश महागुहाम् ।\nयत्र शेते महावीर्यो मुचुकुंदो नरेश्वरः  ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001041018, "chapter_id": 21041, "verse_number": "५-२३-१९", "content_sanskrit": "सोऽपि प्रविष्टो यवनो दृष्ट्वा शय्यागतं नृपम् ।\nपादेन ताडयामास मत्वा कृष्णं सुदुर्मतिः  ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001041019, "chapter_id": 21041, "verse_number": "५-२३-२०", "content_sanskrit": "उत्थाय मुचुकुंदोऽपि ददर्श यवनं नृपः  ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001041020, "chapter_id": 21041, "verse_number": "५-२३-२१", "content_sanskrit": "दृष्टमात्रश्च तेनाऽसौ जज्वाल यवनोग्निना ।\nतत्क्रोधजेन मैत्रेय भस्मीभूतश्च तत्क्षणात्  ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001041021, "chapter_id": 21041, "verse_number": "५-२३-२२", "content_sanskrit": "स हि देवासुरे युद्धे गतो हत्वा महासुरान् ।\nनिद्रा र्त्तस्सुमहाकालं निद्रा ं! वव्रे वरं सुरान्  ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001041022, "chapter_id": 21041, "verse_number": "५-२३-२३", "content_sanskrit": "प्रोक्तश्च देवैस्संसुप्तं यस्त्वामुत्थापयिष्यति ।\nदेहजेनाग्निना सद्यस्स तु भस्मीभविष्यति  ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001041023, "chapter_id": 21041, "verse_number": "५-२३-२४", "content_sanskrit": "एवं दग्ध्वा स तं पापं दृष्ट्वा च मधुसूदनम् ।\nकस्त्वमित्याह सोऽप्याह जातोहं शशिनः कुले ।\nवसुदेवस्य तनयो यदोर्वंशसमुद्भवः  ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001041024, "chapter_id": 21041, "verse_number": "५-२३-२५", "content_sanskrit": "मुचुकुंदोऽपि तत्राऽसौ वृद्धगार्ग्यवचोऽस्मरत्  ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001041025, "chapter_id": 21041, "verse_number": "५-२३-२६", "content_sanskrit": "संस्मृत्य प्रणिपत्यैनं सर्वं सर्वेश्वरं हरिम् ।\nप्राह ज्ञानो भवान्विष्णोरंशस्त्वं परमेश्वर  ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001041026, "chapter_id": 21041, "verse_number": "५-२३-२७", "content_sanskrit": "पुरा गार्ग्येण कथितमष्टाविंशतिमे युगे\nद्वापरांते हरेर्जन्म यदुवंशो! भविष्यति  ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001041027, "chapter_id": 21041, "verse_number": "५-२३-२८", "content_sanskrit": "स त्वं प्राप्तो न संदेहो मर्त्त्यानामुपकारकृत्  ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001041028, "chapter_id": 21041, "verse_number": "५-२३-२९", "content_sanskrit": "तथाहि सुमहत्तेजो नालं सोढुमहं तव ।\nतथाहि सजलांभोदनादधीरतरं तव ।\nवाक्यं नमति चैवोर्वी युष्मत्पादप्रपीडिता  ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001041029, "chapter_id": 21041, "verse_number": "५-२३-३०", "content_sanskrit": "देवासुरमहायुद्धे दैत्यसैन्यमहाभटाः ।\nन सेहुर्मम तेजस्ते त्वत्तेजो न सहाम्यहम्  ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001041030, "chapter_id": 21041, "verse_number": "५-२३-३१", "content_sanskrit": "संसारपतितस्यैको जंतोस्त्वं शरणं परम् ।\nप्रसीद त्वं प्रपन्नार्त्तिहर नाशय मेऽशुभम्  ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001041031, "chapter_id": 21041, "verse_number": "५-२३-३२", "content_sanskrit": "त्वं पयो निधयश्शैलसरितस्त्वं वनानि च ।\nमेदिनी गगनं वायुरापोग्निस्त्वं तथा मनः  ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001041032, "chapter_id": 21041, "verse_number": "५-२३-३३", "content_sanskrit": "बुद्धिरव्याकृतप्राणाः प्राणेशस्त्वं तथा पुमान् ।\nपुंसः परतरं यच्च व्याप्य जन्म विकारवत्  ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001041033, "chapter_id": 21041, "verse_number": "५-२३-३४", "content_sanskrit": "शब्दादिहीनमजरममेयं क्षयवर्जितम्  ।\nअवृद्धिनाशं तद्ब्रह्म त्वमाद्यंतविवर्जितम्  ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001041034, "chapter_id": 21041, "verse_number": "५-२३-३५", "content_sanskrit": "त्वत्तोऽमरास्सपितरो यक्षगंधर्वकिन्नराः ।\nसिद्धाश्चाप्सरसस्त्वत्तो मनुष्याः पशवः खगाः  ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001041035, "chapter_id": 21041, "verse_number": "५-२३-३६", "content_sanskrit": "सरीसृपा मृगास्सर्वे त्वत्तस्सर्वे महीरुहाः ।\nयच्च भूतं भविष्यं च किंचिदत्र चराचरम्  ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001041036, "chapter_id": 21041, "verse_number": "५-२३-३७", "content_sanskrit": "मूर्त्तामूर्त्तं तथा चापि स्थूलं सूक्ष्मतरं तथा ।\nतत्सर्वं त्वं जगत्कर्त्ता नास्ति किंचित्त्वया विना  ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001041037, "chapter_id": 21041, "verse_number": "५-२३-३८", "content_sanskrit": "मया संसारचक्रेऽस्मिन्भ्रमता भगवंस्तदा ।\nतापत्रयाभिभूतेन न प्राप्ता निर्वृतिः क्वचित्  ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001041038, "chapter_id": 21041, "verse_number": "५-२३-३९", "content_sanskrit": "दुःखान्येव सुखानीति मृगतृष्णाजलाशयाः ।\nमया नाथ गृहीतानि तानि तापाय मेऽभवन्  ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001041039, "chapter_id": 21041, "verse_number": "५-२३-४०", "content_sanskrit": "राज्यमुर्वी बलं कोशो मित्रपक्षस्तथात्मजाः ।\nभार्या भृत्य जनो ये च शब्दाद्या विषयाः प्रभो  ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001041040, "chapter_id": 21041, "verse_number": "५-२३-४१", "content_sanskrit": "सुखबुद्ध्या मया सर्वं गृहीतमिदमव्ययम् ।\nपरिणामे तदेवेश तापात्मकमभून्मम  ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001041041, "chapter_id": 21041, "verse_number": "५-२३-४२", "content_sanskrit": "देवलोकगतिं प्राप्तो नाथ देवगणोऽपि हि ।\nमत्तस्साहाय्यकामोभूच्छाश्वती कुत्र निर्वृतिः  ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001041042, "chapter_id": 21041, "verse_number": "५-२३-४३", "content_sanskrit": "त्वामनाराध्य जगतां सर्वेषां प्रभवास्पदम् ।\nशाश्वती प्राप्यते केन परमेश्वर निर्वृतिः  ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001041043, "chapter_id": 21041, "verse_number": "५-२३-४४", "content_sanskrit": "त्वन्मायामूढमनसो जन्ममृत्युजरादिकान्\nअवाप्य तापान्पश्यंति प्रेतराजमनंतरम्  ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001041044, "chapter_id": 21041, "verse_number": "५-२३-४५", "content_sanskrit": "ततो निजक्रियासूतिनरकेष्वतिदारुणम् ।\nप्राप्नुवंति नरा दुःखमस्वरूपविदस्तव  ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001041045, "chapter_id": 21041, "verse_number": "५-२३-४६", "content_sanskrit": "अहमत्यंतविषयी मोहितस्तव मायया\nममत्वगर्वगर्त्तांतर्भ्रमामि परमेश्वर  ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001041046, "chapter_id": 21041, "verse_number": "५-२३-४७", "content_sanskrit": "सोऽहं त्वां शरणमपारमप्रमेयं संप्राप्तः परमपदं यतो न किंचित् ।\nसंसारभ्रमपरितापतप्तचेतानिर्वाणे परिणतधाम्नि साभिलाषः  ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]