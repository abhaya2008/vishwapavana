[{"id": 7000791000, "chapter_id": 20791, "verse_number": "६-१३४-१", "content_sanskrit": "महादेव उवाच ।\nवेत्रवत्यास्तु माहात्म्यं वक्ष्यामि शृणु सुंदरि ।\nयत्र स्नात्वा विमुच्यंते यावदाभूतसंप्लवम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000791001, "chapter_id": 20791, "verse_number": "६-१३४-२", "content_sanskrit": "वृत्रेण च कृतः कूपो महागंभीरसंज्ञकः ।\nकूपात्सा निःसृता देवी महापापौघनाशिनी॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000791002, "chapter_id": 20791, "verse_number": "६-१३४-३", "content_sanskrit": "यथा गंगा तथेयं च सरिच्छ्रेष्ठा सुरोत्तमे ।\nअस्या दर्शनमात्रेण पापौघाः शमयंति च॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000791003, "chapter_id": 20791, "verse_number": "६-१३४-४", "content_sanskrit": "शृणु देवि प्रवक्ष्यामि इतिहासं पुरातनम् ।\nयच्छ्रुत्वा पापिनो दोषैर्विमुक्ताः कर्मबंधनात्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000791004, "chapter_id": 20791, "verse_number": "६-१३४-५", "content_sanskrit": "चंपके नगरे चैव राजा राज्यं करोति सः ।\nसदा दुष्टो दुष्टरूपो जनानां स प्रपीडकः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000791005, "chapter_id": 20791, "verse_number": "६-१३४-६", "content_sanskrit": "अधर्मो धर्मरूपश्च विष्णुनिंदापरायणः ।\nदेव द्विज निहंता च आश्रमाणां विदूषकः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000791006, "chapter_id": 20791, "verse_number": "६-१३४-७", "content_sanskrit": "वेदनिंदापरः श्रीमान्मूर्खो वा निर्घृणः शठः ।\nअसच्छास्त्रेषु निरतः परदाराभिमर्शकः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000791007, "chapter_id": 20791, "verse_number": "६-१३४-८", "content_sanskrit": "विदारुणेति नामा च संजातो मूर्ख एव च ।\nकदाचिद्दैवयोगेन आगतस्तां नदीं प्रति॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000791008, "chapter_id": 20791, "verse_number": "६-१३४-९", "content_sanskrit": "आखेटकसमायुक्तः स्वयं कुष्ठी सुरेश्वरि ।\nमहापापादयं जातो ब्राह्मणानां च निंदनात्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000791009, "chapter_id": 20791, "verse_number": "६-१३४-१०", "content_sanskrit": "वृथावादी दुरात्मा च शठो वै निर्घृणः पशुः ।\nवेदनिंदारतो नित्यं गोशास्त्राणां प्रदूषकः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000791010, "chapter_id": 20791, "verse_number": "६-१३४-११", "content_sanskrit": "एवंविधो वने भ्राम्यंस्तृषार्तः स सुहृद्वृतः ।\nअश्वादुत्तीर्य राजाऽसौ जलं पीत्वा गृहं गतः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000791011, "chapter_id": 20791, "verse_number": "६-१३४-१२", "content_sanskrit": "तेनैवोदकपानेन गतं कुष्ठं न संशयः ।\nबुद्धिस्तु निर्मला जाता तस्य राज्ञो विशेषतः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000791012, "chapter_id": 20791, "verse_number": "६-१३४-१३", "content_sanskrit": "विष्णौ भक्तिः समुत्पन्ना तदा तस्य सुरेश्वरि ।\nततः प्रभृति कालेन स्नानं वै कृतवान्सदा॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000791013, "chapter_id": 20791, "verse_number": "६-१३४-१४", "content_sanskrit": "निर्मलो बहुरूपाढ्यो जातस्तत्र सुरेश्वरि ।\nइहलोके सुखं भुक्त्वा कृत्वा यज्ञाननेकशः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000791014, "chapter_id": 20791, "verse_number": "६-१३४-१५", "content_sanskrit": "विप्रेभ्यो दक्षिणां दत्वा स गतो वैष्णवं पदम् ।\nइति ज्ञात्वा तु भो देवि वेत्रवत्यां विशेषतः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000791015, "chapter_id": 20791, "verse_number": "६-१३४-१६", "content_sanskrit": "स्नानं कुर्वंति ये विप्रास्ते मुक्ता नगनंदिनि ।\nराजन्यो वाथ वैश्यो वा शूद्रो वा सुरसत्तमे॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000791016, "chapter_id": 20791, "verse_number": "६-१३४-१७", "content_sanskrit": "यत्र स्नानं प्रकुर्वंति ते मुक्ताः पापबंधनात् ।\nकार्तिके वाऽथ माघे वा बाह्यो वा वेदनिंदकः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000791017, "chapter_id": 20791, "verse_number": "६-१३४-१८", "content_sanskrit": "सरितां संगमे स्नात्वा मुच्यते देवि किल्बिषात् ।\nसाभ्रमत्याः समं यत्र तस्याः संगः प्रदृश्यते॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000791018, "chapter_id": 20791, "verse_number": "६-१३४-१९", "content_sanskrit": "तत्र स्नात्वा विशेषेण मुच्यते ब्रह्महा सदा ।\nखेटकं नगरं दिव्यं स्वर्गरूपं तु वाऽनघे॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000791019, "chapter_id": 20791, "verse_number": "६-१३४-२०", "content_sanskrit": "ब्रह्मणा तत्र वै देवि योगाश्च बहवः कृताः ।\nतत्र स्नात्वा च भुक्त्वा च पुनर्जन्म न विद्यते॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000791020, "chapter_id": 20791, "verse_number": "६-१३४-२१", "content_sanskrit": "सा द्वितीया स्मृता गंगा कलौ देवि विशेषतः ।\nये नराः सुखमिच्छंति धनमिच्छंति ये नराः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000791021, "chapter_id": 20791, "verse_number": "६-१३४-२२", "content_sanskrit": "स्वर्गमिच्छंति ये लोकास्ते वै स्नात्वा पुनःपुनः ।\nइहलोके सुखं भुक्त्वा यांति विष्णोः सनातनम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000791022, "chapter_id": 20791, "verse_number": "६-१३४-२३", "content_sanskrit": "सूर्यवंशे च ये जाताः सोमवंशे तथैव च ।\nआगता वेत्रवत्यां तु स्नात्वा निर्वृतिमागताः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000791023, "chapter_id": 20791, "verse_number": "६-१३४-२४", "content_sanskrit": "दर्शनाद्धरते दुःखं स्पर्शनान्मानसं ह्यघम् ।\nस्नात्वा भुक्त्वा तथा देवि मुक्तिभागी न संशयः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000791024, "chapter_id": 20791, "verse_number": "६-१३४-२५", "content_sanskrit": "स्नानाज्जपात्तथाहोमादनंतं फलमश्नुते ।\nगत्वा वाराणसीतीर्थं भक्त्या चांद्रायणं चरेत्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000791025, "chapter_id": 20791, "verse_number": "६-१३४-२६", "content_sanskrit": "तत्र गत्वा महत्पुण्यं तत्पुण्यं सुरसत्तमे ।\nवेत्रवत्यां विशेषेण पंचत्वं यदि गच्छति॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000791026, "chapter_id": 20791, "verse_number": "६-१३४-२७", "content_sanskrit": "स वै चतुर्भुजो भूत्वा याति विष्णोः परं पदम् ।\nपृथिव्यां यानि तीर्थानि ये देवाः पितरस्तथा॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000791027, "chapter_id": 20791, "verse_number": "६-१३४-२८", "content_sanskrit": "ते सर्वे च वसंतीह वेत्रवत्यां सुरेश्वरि ।\nकिमन्यद्बहुनोक्तेन भूयो भूयो वरानने॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000791028, "chapter_id": 20791, "verse_number": "६-१३४-२९", "content_sanskrit": "वेत्रवत्याः समं तीर्थं पृथिव्यां न सनातनि ।\nअहं विष्णुस्तथा ब्रह्मा देवाश्च परमर्षयः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000791029, "chapter_id": 20791, "verse_number": "६-१३४-३०", "content_sanskrit": "तिष्ठंति देवताः सर्वे वेत्रवत्यां महेश्वरि ।\nएककालं द्विकालं वा त्रिकालं च विशेषतः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000791030, "chapter_id": 20791, "verse_number": "६-१३४-३१", "content_sanskrit": "स्नानं कुर्वंति ये तत्र ते वै मुक्ता न संशयः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]