", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003350075, "chapter_id": 23350, "verse_number": "२-४५-७६", "content_sanskrit": "ॐ भुवः स्वाहा  ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003350076, "chapter_id": 23350, "verse_number": "२-४५-७७", "content_sanskrit": "ॐ स्वः स्वाहा  ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003350077, "chapter_id": 23350, "verse_number": "२-४५-७८", "content_sanskrit": "भूर्भूवः स्वः स्वाहा  ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003350078, "chapter_id": 23350, "verse_number": "२-४५-७९", "content_sanskrit": "एवं क्रमेण जुहुयाच्छ्राद्धोक्तं च यताक्रमम्॥सप्तमेऽनि योगींद्राञ्छ्राद्धार्हानपि भोजयेत्  ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003350079, "chapter_id": 23350, "verse_number": "२-४५-८०", "content_sanskrit": "शर्वादीनां च विप्राणां वस्त्राभरणकंबलान्॥वाहनं शयनं यानं कांस्यताम्रादिभाजनम्  ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003350080, "chapter_id": 23350, "verse_number": "२-४५-८१", "content_sanskrit": "हैमं च राजतं धेनुं तिलान् क्षेत्रं च वैभवम्॥दासीदासगणश्चैव दातव्यो दक्षिणामपि  ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003350081, "chapter_id": 23350, "verse_number": "२-४५-८२", "content_sanskrit": "पिंडं च पूर्ववद्दद्यात्पृथगष्टप्रकारतः॥ब्राह्मणानं सहस्रं च भोजयेच्च सदक्षिणम्  ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003350082, "chapter_id": 23350, "verse_number": "२-४५-८३", "content_sanskrit": "एकं वा योगनिरतं भस्मनिष्ठं जितेंद्रियम्॥त्र्यहं चैव तु रुद्रस्य महाचरुनिवेदनम्  ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003350083, "chapter_id": 23350, "verse_number": "२-४५-८४", "content_sanskrit": "विशेष एवं कथित अशेषश्राद्धचोदितः॥मृते कुर्यान्न कुर्याद्वा जीवन्मुक्तो यतः स्वयम्  ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003350084, "chapter_id": 23350, "verse_number": "२-४५-८५", "content_sanskrit": "नित्यनैमित्तिकादीनि कुर्याद्धा संत्त्यजेत्तु वा॥बांधवेऽपि मृते तस्य शौचाशौचं न विद्यते  ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003350085, "chapter_id": 23350, "verse_number": "२-४५-८६", "content_sanskrit": "सूतकं च न संदेहः स्नानमात्रेण शुद्ध्यति॥पश्चाज्जाते कुमारे च स्वे क्षेत्रे चात्मनो यदि  ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003350086, "chapter_id": 23350, "verse_number": "२-४५-८७", "content_sanskrit": "तस्य सर्वं प्रकर्तव्यं पुत्रोऽपि ब्रह्मविद्भिवेत्॥कन्यका यदि रांजाता पश्चात्तस्य महात्मनः  ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003350087, "chapter_id": 23350, "verse_number": "२-४५-८८", "content_sanskrit": "एकपर्णा इव ज्ञेया अपर्णा इव सुव्रता॥भवत्येव न संदेहस्तस्याश्चान्वयजा अपि  ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003350088, "chapter_id": 23350, "verse_number": "२-४५-८९", "content_sanskrit": "मुच्यंते नात्र संदेहः पितरो नरकादपि॥मुच्यंते कर्मणानेन मातृतः पितृतस्तथा  ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003350089, "chapter_id": 23350, "verse_number": "२-४५-९०", "content_sanskrit": "कालं गते द्विजे भूमौ खनेच्चापि दहेत्तु वा॥पुत्रकृत्यमशेषं च कृत्वा दोषो न विद्यते  ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003350090, "chapter_id": 23350, "verse_number": "२-४५-९१", "content_sanskrit": "कर्मणा चोत्तरेणैव गतिरस्य न विद्यते॥ब्रह्मणाकथितं सर्वं मुनीनां भावितात्मनाम्  ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003350091, "chapter_id": 23350, "verse_number": "२-४५-९२", "content_sanskrit": "पुनः सनत्कुमाराय कथितं तेन धीमता॥कृष्णद्वैपायनायैव कथितं ब्रह्मसूनुना  ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003350092, "chapter_id": 23350, "verse_number": "२-४५-९३", "content_sanskrit": "प्रसादात्तस्य देवस्य वेदव्यासस्य धीमतः॥ज्ञातं मया कृतं चैव नियोगादेव तस्य तु  ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003350093, "chapter_id": 23350, "verse_number": "२-४५-९४", "content_sanskrit": "एतद्वः कथितं सर्वं रहस्यं ब्रह्मसिद्धिदम्॥मुनिपुत्राय दातव्यं न चाभक्ताय सुव्रताः  ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]