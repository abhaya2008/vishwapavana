[{"id": 7003350000, "chapter_id": 23350, "verse_number": "२-४५-१", "content_sanskrit": "ऋषय ऊचुः॥\nएवं षोडश दानानि कथितानि शुभानि च॥जीवच्छ्रा द्धक्रमोऽस्माकं वक्तुमर्हसि सांप्रतम्  ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003350001, "chapter_id": 23350, "verse_number": "२-४५-२", "content_sanskrit": "सूत उवाच॥\nजीवच्छ्राद्धविधिं वक्ष्ये समासात्सर्वसंमतम्॥मनवे देवदेवेन कथितं ब्रह्मणा पुरा  ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003350002, "chapter_id": 23350, "verse_number": "२-४५-३", "content_sanskrit": "वसिष्ठास च शिष्टाय भृगवे भार्गवाय च॥श्रृण्वंतु सर्वभावेन सर्वसिद्धिकरं परम्  ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003350003, "chapter_id": 23350, "verse_number": "२-४५-४", "content_sanskrit": "श्राद्धमार्गक्रमं साक्षाच्छ्राद्धार्हाणामपि क्रमम्॥विशेषमपि वक्ष्यामि जीवच्छ्राद्धस्य सुव्रताः  ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003350004, "chapter_id": 23350, "verse_number": "२-४५-५", "content_sanskrit": "पर्वते वा नदीतीरे वने वायतनेऽपि वा॥जीवच्छ्राद्धं प्रकर्तव्यं मृतकाले प्रयत्नतः  ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003350005, "chapter_id": 23350, "verse_number": "२-४५-६", "content_sanskrit": "जीवच्छ्राद्धे कृते जीवो जीवन्नेव विमुच्यते॥कर्म कुर्वन्नकुर्वन्वा ज्ञानी वाज्ञानवानपि  ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003350006, "chapter_id": 23350, "verse_number": "२-४५-७", "content_sanskrit": "श्रोत्रियोऽश्रोत्रियो वापि ब्राह्मणः क्षत्रियोऽपि वा॥वैश्यो वा नात्र संदेहो योगमार्गगतो यता  ॥७॥", "padaccheda": "", 