[{"id": 7000627000, "chapter_id": 20627, "verse_number": "५-८६-१", "content_sanskrit": "सूत उवाच ।\nइति तस्य वचः श्रुत्वा नारदस्य महात्मनः ।\nअंबरीषश्च राजर्षिर्विस्मितो वाक्यमब्रवीत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000627001, "chapter_id": 20627, "verse_number": "५-८६-२", "content_sanskrit": "अंबरीष उवाच ।\nमार्गशीर्षादिकान्मासान्हित्वा पुण्यान्महामुने ।\nसर्वमासाधिकं मासं वैशाखं किं प्रशंससि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000627002, "chapter_id": 20627, "verse_number": "५-८६-३", "content_sanskrit": "सर्वेभ्योऽप्यधिकः कस्मान्माधवो माधवप्रियः ।\nको विधिस्तत्र किं दानं किं तपः का च देवता ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000627003, "chapter_id": 20627, "verse_number": "५-८६-४", "content_sanskrit": "त्वत्पादांभोजरजसा पावितस्य च मे मुने ।\nउपदेशप्रसादेन प्रसादं कर्तुमर्हसि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000627004, "chapter_id": 20627, "verse_number": "५-८६-५", "content_sanskrit": "धर्मज्ञो धर्ममार्गाणामुद्धर्तासि महामुने ।\nत्वमेकोऽखिलतत्त्वार्थवेत्ता धर्मोपदेशकः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000627005, "chapter_id": 20627, "verse_number": "५-८६-६", "content_sanskrit": "कर्तोपदेष्टा मंता वानुमंतापि प्रयोजकः ।\nशास्त्रविद्भिर्मुनिवर स्मर्यंते समभागिनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000627006, "chapter_id": 20627, "verse_number": "५-८६-७", "content_sanskrit": "व्रतसत्रतपोदानैर्यत्फलं समवाप्यते ।\nधर्मोपदेशनेनैव तत्सर्वमुपलभ्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000627007, "chapter_id": 20627, "verse_number": "५-८६-८", "content_sanskrit": "तीर्थस्नानं तपोयज्ञकर्म यत्कुरुते मुने ।\nअपि तत्फलभागीस्याद्यः प्रवर्तयिता भवेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000627008, "chapter_id": 20627, "verse_number": "५-८६-९", "content_sanskrit": "यद्यदाचरति श्रेष्ठस्तत्तदेवेतरो जनः ।\nस यत्प्रमाणं कुरुते लोकस्तदनुवर्तते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000627009, "chapter_id": 20627, "verse_number": "५-८६-१०", "content_sanskrit": "तदर्हति भवान्धर्ममुपदेष्टुं तदद्भुतम् ।\nदुर्ल्लभो गुरुसंबोधो देशकालोपपत्तयः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000627010, "chapter_id": 20627, "verse_number": "५-८६-११", "content_sanskrit": "न केचन तथा भावाश्चेतः शीतलयंतिनः ।\nराज्यलाभादयोऽप्येते यथा तव समागमः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000627011, "chapter_id": 20627, "verse_number": "५-८६-१२", "content_sanskrit": "सूत उवाच ।\nअथ मंदमृदुस्मेरस्फुरद्दंतप्रभानुगः ।\nअंबरीषं प्रत्युवाच नारदो मुनिसत्तमः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000627012, "chapter_id": 20627, "verse_number": "५-८६-१३", "content_sanskrit": "नारद उवाच ।\nशृणु राजन्प्रवक्ष्यामि हिताय जगतस्तव ।\nविधिर्माधवमासस्य यच्छ्रुतो ब्रह्मणः पुरा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000627013, "chapter_id": 20627, "verse_number": "५-८६-१४", "content_sanskrit": "दुर्ल्लभं भारते वर्षे जन्म तस्मान्मनुष्यता ।\nमानुष्ये दुर्ल्लभे लोके स्वस्वधर्मप्रवर्त्तनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000627014, "chapter_id": 20627, "verse_number": "५-८६-१५", "content_sanskrit": "ततोऽपि भक्तिर्भूपाल वासुदेवेऽतिदुर्ल्लभा ।\nतत्रापि दुर्ल्लभो मासो माधवो माधवप्रियः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000627015, "chapter_id": 20627, "verse_number": "५-८६-१६", "content_sanskrit": "तमवाप्य ततो मासं स्नानदानजपादिकम् ।\nकुर्वंति विधिना ये तु धन्यास्ते कृतिनो नराः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000627016, "chapter_id": 20627, "verse_number": "५-८६-१७", "content_sanskrit": "तेषां दर्शनमात्रेण पापिनोऽपि विकिल्बिषाः ।\nभवंति भगवद्भावभाविता धर्मकांक्षिणः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000627017, "chapter_id": 20627, "verse_number": "५-८६-१८", "content_sanskrit": "माधवे मासि यैः स्नातं प्रातर्नियमसंयुतैः ।\nते कोटिवर्षपर्यंतं क्रीडंते नंदने वने ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000627018, "chapter_id": 20627, "verse_number": "५-८६-१९", "content_sanskrit": "यथा न वारिधिसमो लोके कोऽपि जलाशयः ।\nतथा मासो न वैशाखसदृशो माधवप्रियः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000627019, "chapter_id": 20627, "verse_number": "५-८६-२०", "content_sanskrit": "तावत्पापानि तिष्ठंति मनुष्याणां कलेवरे ।\nयावत्किलमलध्वंसी मासो नायाति माधवः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000627020, "chapter_id": 20627, "verse_number": "५-८६-२१", "content_sanskrit": "अवशिष्टदिनान्येव पंचमासस्य तस्य वै ।\nएकादशीं समारभ्य सर्वमाससमानि वै ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000627021, "chapter_id": 20627, "verse_number": "५-८६-२२", "content_sanskrit": "वैशाखे पूजितो देवो माधवो मधुहा तु यैः ।\nनानोपचारै राजेंद्र तैः प्राप्तं जन्मनः फलम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000627022, "chapter_id": 20627, "verse_number": "५-८६-२३", "content_sanskrit": "किं किं न दुर्ल्लभतरं प्राप्यते मासि माधवे ।\nस्नानेन परमेशस्य पूजनेन यथाविधि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000627023, "chapter_id": 20627, "verse_number": "५-८६-२४", "content_sanskrit": "न दत्तं न हुतं जप्तं न तीर्थे मरणं कृतम् ।\nयैर्हि नारायणो नैव ध्यातो निखिलपापहा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000627024, "chapter_id": 20627, "verse_number": "५-८६-२५", "content_sanskrit": "तेषां जन्म नृणां लोके ज्ञातव्यं निष्फलं नृप ।\nद्रव्येषु विद्यमानेषु कृपणो यो भवेन्नरः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000627025, "chapter_id": 20627, "verse_number": "५-८६-२६", "content_sanskrit": "अदत्वा म्रियते यो हि तस्य द्रव्यं निरर्थकम् ।\nतीर्थस्नानादि तपसा सत्कुले जन्म लभ्यते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000627026, "chapter_id": 20627, "verse_number": "५-८६-२७", "content_sanskrit": "न दानेन विना भूप किंचिदप्युपतिष्ठति ।\nवैशाखस्नानमाहात्म्यादपि पंचदिनात्मकात् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000627027, "chapter_id": 20627, "verse_number": "५-८६-२८", "content_sanskrit": "सत्कुले प्राप्यते जन्म वैभवं विविधं तथा ।\nसुपुत्रः सुकुलं भूप धनधान्यं वरस्त्रियः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000627028, "chapter_id": 20627, "verse_number": "५-८६-२९", "content_sanskrit": "सुजन्ममरणं चापि सुभोगाः सुखमेव च ।\nसदा दानेऽधिका प्रीतिरौदार्यं धैर्यमुत्तमम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000627029, "chapter_id": 20627, "verse_number": "५-८६-३०", "content_sanskrit": "प्रसादात्तस्य देवस्य विष्णोश्चैव महात्मनः ।\nनारायणस्य जायंते सिद्धयो भूप वांच्छिताः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000627030, "chapter_id": 20627, "verse_number": "५-८६-३१", "content_sanskrit": "ऊर्जे मासि तपो मासि माधवे माधवप्रिये ।\nस्नात्वा दामोदरं भक्त्या माधवं मधुसूदनम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000627031, "chapter_id": 20627, "verse_number": "५-८६-३२", "content_sanskrit": "विशेषेण समभ्यर्च्य दत्वा दानानि शक्तितः ।\nएहिकं सुखमासाद्य नरो हरिपदं व्रजेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000627032, "chapter_id": 20627, "verse_number": "५-८६-३३", "content_sanskrit": "अनेकजन्मार्जितपातकावली विलीयते माधवमज्जनेन ।\nसूर्योदये भूप यथा तमिस्रं वचः स्वयंभूरिदमादिशन्मे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000627033, "chapter_id": 20627, "verse_number": "५-८६-३४", "content_sanskrit": "चकार विष्णुर्विपुलप्रचारं मासस्य वै माधवसंज्ञकस्य ।\nयमस्य गुप्तं वचसा विचिंत्य मनुष्यलोकं गमितं चकार ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000627034, "chapter_id": 20627, "verse_number": "५-८६-३५", "content_sanskrit": "तस्मादस्मिन्समायाते माधवे मासि वैष्णवैः ।\nस्नात्वा पुण्यजले तीर्थे गंगायाः पावने नृणाम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000627035, "chapter_id": 20627, "verse_number": "५-८६-३६", "content_sanskrit": "रेवाया वा महाराज यामुने शारदेऽथवा ।\nप्रातस्त्वनुदिते भानौ विधानेन नृपोत्तम ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000627036, "chapter_id": 20627, "verse_number": "५-८६-३७", "content_sanskrit": "पूजयित्वा च देवेशं मुकुंदं मधुसूदनम् ।\nपुत्रपौत्रधनैः श्रेयो वांच्छितानि सुखानि च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000627037, "chapter_id": 20627, "verse_number": "५-८६-३८", "content_sanskrit": "अनुभूय तपस्त्वंते स्वर्गमक्षयमाप्नुयात् ।\nएवं ज्ञात्वा महाभाग मधुसूदनमर्चय ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000627038, "chapter_id": 20627, "verse_number": "५-८६-३९", "content_sanskrit": "स्नात्वा सम्यग्विधानेन वैशाखे तु विशेषतः ।\nदेवमाराध्य गोविन्दं नारायणमनामयम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000627039, "chapter_id": 20627, "verse_number": "५-८६-४०", "content_sanskrit": "प्राप्स्यसि त्वं सुखं पुत्रं धनानि च हरेः पदम् ।\nदेवदेवं नमस्कृत्य माधवं पापनाशनम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000627040, "chapter_id": 20627, "verse_number": "५-८६-४१", "content_sanskrit": "प्रारभेत व्रतमिदं पौर्णमास्यां मधोर्नृप ।\nयमैश्च नियमैर्युक्तः शक्त्या किंचित्प्रदाय च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000627041, "chapter_id": 20627, "verse_number": "५-८६-४२", "content_sanskrit": "हविष्यभुग्भूमिशायी ब्रह्मचर्यव्रते स्थितः ।\nकृच्छ्रादितपसा क्षामो ध्यायन्नारायणं हृदि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000627042, "chapter_id": 20627, "verse_number": "५-८६-४३", "content_sanskrit": "एवं प्राप्य च वैशाखीं दद्यान्मधुतिलादिकम् ।\nभोजनं द्विजमुख्येभ्यो भक्त्या धेनुं सदक्षिणाम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000627043, "chapter_id": 20627, "verse_number": "५-८६-४४", "content_sanskrit": "अच्छिद्रं प्रार्थयेच्चापि तस्य स्नानस्य भूसुरान् ।\nयथा लक्ष्मीः प्रिया भूप माधवस्य जगत्पतेः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000627044, "chapter_id": 20627, "verse_number": "५-८६-४५", "content_sanskrit": "तथैव माधवो मासो मधुसूदनवल्लभः ।\nएवं विधियुतो मर्त्यः स्नात्वा द्वादशवत्सरम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000627045, "chapter_id": 20627, "verse_number": "५-८६-४६", "content_sanskrit": "उद्यापनं चरेच्छक्त्या मधुसूदनतुष्टये ।\nइदं माधवमासस्य माहात्म्यं कथितं तव ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000627046, "chapter_id": 20627, "verse_number": "५-८६-४७", "content_sanskrit": "यत्पुरा ब्रह्मणो वक्त्राच्छ्रुतमासीन्मया नृप ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]