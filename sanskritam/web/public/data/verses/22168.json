[{"id": 7002168000, "chapter_id": 22168, "verse_number": "२१३-१", "content_sanskrit": "अग्निरुवाच ।\nपृथ्वीदानं प्रवक्ष्यामि पृथिवी त्रिविधा मता ।\nशतकोटिर्योजनानां सप्तद्वीपा ससागरा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002168001, "chapter_id": 22168, "verse_number": "२१३-२", "content_sanskrit": "जम्बुद्वीपावधिः सा च उत्तमा मेदिनीरिता ।\nउत्तमां पञ्चभिर्भारैः काञ्चनैश्च प्रकल्पयेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002168002, "chapter_id": 22168, "verse_number": "२१३-३", "content_sanskrit": "तदर्धान्तरजं कूर्मं तथा पद्मं समादिशेत् ।\nउत्तमा कथिता पृथ्वी द्व्यंशेनैव तु मध्यमा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002168003, "chapter_id": 22168, "verse_number": "२१३-४", "content_sanskrit": "कन्यसा च त्रिभागेन त्रिहान्या कूर्मपङ्कजे ।\nपलानान्तु सहस्रेण कल्पयेत्कल्पपादपं ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002168004, "chapter_id": 22168, "verse_number": "२१३-५", "content_sanskrit": "मूलदण्डं सपत्रञ्च फलपुष्पसमन्वितं ।\nपञ्चस्कन्धन्तु सङ्कल्प्य पञ्चानान्दापयेत्सुधीः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002168005, "chapter_id": 22168, "verse_number": "२१३-६", "content_sanskrit": "एतद्दाता ब्रह्मलोके पितृभिर्मोदते चिरं ।\nविष्ण्वग्रे कामधेनुन्तु पलानां पञ्चभिः शतैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002168006, "chapter_id": 22168, "verse_number": "२१३-७", "content_sanskrit": "ब्रह्मविष्णुमहेशाद्या देवा धेनौ व्यवस्थिताः ।\nधेनुदानं सर्वदानं सर्वद ब्रह्मलोकदं ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002168007, "chapter_id": 22168, "verse_number": "२१३-८", "content_sanskrit": "विष्ण्वग्रे कपिलां दत्त्वा तारयेत्सकलं कुलं ।\nअलङ्कृत्य स्त्रियं दद्यादश्वमेधफलं लभेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002168008, "chapter_id": 22168, "verse_number": "२१३-९", "content_sanskrit": "भूमिं दत्त्वा सर्वभाक्स्यात्सर्वशस्य प्ररोहिणीम् ।\nग्रामं वाथ पुरं वापि खेटकञ्च दद्त्सुखी ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002168009, "chapter_id": 22168, "verse_number": "२१३-१०", "content_sanskrit": "कार्त्तिक्यादौ वृषोत्सर्गं कुर्वंस्तारयते कुलं ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]