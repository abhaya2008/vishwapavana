[{"id": 2041091, "chapter_id": 1913, "verse_number": "५-१५८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041092, "chapter_id": 1913, "verse_number": "५-१५८-१", "content_sanskrit": "एतस्मिन्नैव काले तु भीष्मकस्य महात्मनः ।\nहिरण्यरोम्णो नृपतेः साक्षादिन्द्रसखस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041093, "chapter_id": 1913, "verse_number": "५-१५८-२", "content_sanskrit": "आकूतीनामधिपतिर्भोजस्यातियशस्विनः ।\nदाक्षिणात्यपतेः पुत्रो दिक्षु रुक्मीति विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041094, "chapter_id": 1913, "verse_number": "५-१५८-३", "content_sanskrit": "यः किंपुरुषसिंहस्य गन्धमादनवासिनः ।\nकृत्स्नं शिष्यो धनुर्वेदं चतुष्पादमवाप्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041095, "chapter_id": 1913, "verse_number": "५-१५८-४", "content_sanskrit": "यो माहेन्द्रं धनुर्लेभे तुल्यं गाण्डीवतेजसा।\nशार्ङ्गेण च महाबाहुः संमितं दिव्यलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041096, "chapter_id": 1913, "verse_number": "५-१५८-५", "content_sanskrit": "त्रीण्येवैतानि दिव्यानि धनूंषि दिविचारिणाम् ।\nवारुणं गाण्डिवं तत्र माहेन्द्रं विजयं धनुः ।\nशार्ङ्ग तु वैष्णवं प्राहुर्दिव्यं तेजोमयं धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041097, "chapter_id": 1913, "verse_number": "५-१५८-६", "content_sanskrit": "धारयामास तत्कृष्णः परसेनाभयावहम्।\nगाण्डीवं पावकाल्लेभे खाण्डवे पाकशासनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041098, "chapter_id": 1913, "verse_number": "५-१५८-७", "content_sanskrit": "द्रुमाद्रुक्मी महातेजा विजयं प्रत्यपद्यत।\nसंछिद्य मौरवान्पाशान्निहत्य मुरमोजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041099, "chapter_id": 1913, "verse_number": "५-१५८-८", "content_sanskrit": "निर्जित्य नरकं भौममाहृत्य मणिकुण्डले ।\nषोडश स्त्रीसहस्राणि रत्नानि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041100, "chapter_id": 1913, "verse_number": "५-१५८-९", "content_sanskrit": "प्रतिपेदे हृषीकेशः शार्ङ्गं च धनुरुत्तमम्।\nरुक्मी तु विजयं लब्ध्वा धनुर्मेघनिभस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041101, "chapter_id": 1913, "verse_number": "५-१५८-१०", "content_sanskrit": "विभीषयन्निव जगत्पाण्डवानभ्यवर्तत।\nनामृष्यत पुरा योऽसौ स्वबाहुलगर्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041102, "chapter_id": 1913, "verse_number": "५-१५८-११", "content_sanskrit": "रुक्मिण्या हरणं वीरो वासुदेवेन धीमता।\nकृत्वा प्रतिज्ञां नाहत्वा निवर्तिष्ये जनार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041103, "chapter_id": 1913, "verse_number": "५-१५८-१२", "content_sanskrit": "ततोऽन्वधावद्वार्ष्णेयं सर्वशस्त्रभृतां वरः।\nसेनया चतुरङ्गिण्या महत्या दूरपातया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041104, "chapter_id": 1913, "verse_number": "५-१५८-१३", "content_sanskrit": "विचित्रायुधवर्मिण्या गङ्ग्येव प्रवृद्धया।\nस समासाद्य वार्ष्णेयं योगानामीश्वरं प्रभुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041105, "chapter_id": 1913, "verse_number": "५-१५८-१४", "content_sanskrit": "व्यंसितो व्रीडितो राजन्नाजगाम स कुण्डिनम्।\nयत्रैव कृष्णेन रणे निर्जितः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041106, "chapter_id": 1913, "verse_number": "५-१५८-१५", "content_sanskrit": "तत्र भोजकटं नाम कृतं नगरमुत्तमम् ।\nसैन्येन महता तेन प्रभूतगजवाजिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041107, "chapter_id": 1913, "verse_number": "५-१५८-१६", "content_sanskrit": "पुरं तद्भुवि विख्यातं नाम्ना भोजकटं नृप ।\nस भोजराजः सैन्येन महता परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041108, "chapter_id": 1913, "verse_number": "५-१५८-१७", "content_sanskrit": "अक्षौहिण्या महावीर्यः पाण्डवान्क्षिप्रमागमत्।\nततः स कवची धन्वी तली खङ्गी शरासनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041109, "chapter_id": 1913, "verse_number": "५-१५८-१८", "content_sanskrit": "रथेनादित्यवर्णेन प्रविवेश महाचमूम् ।\nविदितः पाण्डवेयानां वासुदेवप्रियेप्सया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041110, "chapter_id": 1913, "verse_number": "५-१५८-१९", "content_sanskrit": "युधिष्ठिरस्तु तं राजा प्रत्युद्गम्याभ्यपूजयत्।\nस पूजितः पाण्डुपुत्रैर्यथान्यायं सुसंस्तुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041111, "chapter_id": 1913, "verse_number": "५-१५८-२०", "content_sanskrit": "प्रतिगृह्य तु तान्सर्वान्विश्रान्तः सहसैनिकः ।\nउवाच मध्ये वीराणां कुन्तीपुत्रं धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041112, "chapter_id": 1913, "verse_number": "५-१५८-२१", "content_sanskrit": "सहायोस्मि स्थितो युद्धे यदि भीतोसि पाण्डव ।\nकरिष्यामि रणे साह्यमसह्यं तव शत्रुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041113, "chapter_id": 1913, "verse_number": "५-१५८-२२", "content_sanskrit": "न हि मे विक्रमे तुल्यः पुमानस्तीह कश्चन।\nहनिष्यामिरणे भागं यन्मे दास्यसि पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2041114, "chapter_id": 1913, "verse_number": "५-१५८-२३", "content_sanskrit": "अपि द्रोणकृपौ वीरौ भीष्मकर्णावथो पुनः ।\nअथवा सर्व एवैते तिष्ठन्तु वसुधाधिपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2041115, "chapter_id": 1913, "verse_number": "५-१५८-२४", "content_sanskrit": "निहत्य समरे शत्रूंस्तव दास्यामि मेदिनीम् ।\nइत्युक्तो धर्मराजस्य केशवस्य च संनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2041116, "chapter_id": 1913, "verse_number": "५-१५८-२५", "content_sanskrit": "श्रृण्वतां पार्थिवेन्द्राणामन्येषां चैव सर्वशः ।\nवासुदेवमभिप्रेक्ष्य धर्मराजं च पाण्डवम्।\nउवाच धीमान्कौन्तेयः प्रहस्य सखिपूर्वकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2041117, "chapter_id": 1913, "verse_number": "५-१५८-२६", "content_sanskrit": "युध्यमानस्य मे वीर गन्धर्वैः सुमहाबलैः ।\nसहायो घोषयात्रायां कस्तदासीत्सखा मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2041118, "chapter_id": 1913, "verse_number": "५-१५८-२७", "content_sanskrit": "तथा प्रतिभये तस्मिन्देवदानवसंकुले।\nखाण्डवे युध्यमानस्य कः सहायस्तदावभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2041119, "chapter_id": 1913, "verse_number": "५-१५८-२८", "content_sanskrit": "निवातकवचैर्युद्धे कालकेयैश्च दानवैः ।\nतत्र मे युध्यमानस्य कः सहायस्तदाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2041120, "chapter_id": 1913, "verse_number": "५-१५८-२९", "content_sanskrit": "तथा विराटनगरे कुरुभिः सह सङ्गरे।\nयुध्यतो बहुभिस्तत्र कः सहायोऽभवन्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2041121, "chapter_id": 1913, "verse_number": "५-१५८-३०", "content_sanskrit": "उपजीव्य रणे रुद्रं शक्रं वैश्रवणं यमम्।\nवरुणं पावकं चैव कृपं द्रोणं च माधवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2041122, "chapter_id": 1913, "verse_number": "५-१५८-३१", "content_sanskrit": "धारयन्गाण्डिवं दिव्यं धनुस्तेजोमयं दृढम् ।\nअक्षय्यशरसंयुक्तो दिव्यास्त्रपरिबृंहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2041123, "chapter_id": 1913, "verse_number": "५-१५८-३२", "content_sanskrit": "कौरवामां कुले जातः पाण्डोः पुत्रो विशेषतः ।\nद्रोणं व्यपदिशञ्छिष्यो वासुदेवसहायवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2041124, "chapter_id": 1913, "verse_number": "५-१५८-३३", "content_sanskrit": "कथमस्मद्विधो ब्रूयाद्भीतोऽस्मीति यशोहरम् ।\nवचनं नरशार्दूल वज्रायुधसमस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2041125, "chapter_id": 1913, "verse_number": "५-१५८-३४", "content_sanskrit": "नास्मि भीतो महाबाहो सहायार्थश्च नास्ति मे ।\nयथाकामं यथायोगं गच्छ वात्रैव तिष्ठ वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2041126, "chapter_id": 1913, "verse_number": "५-१५८-३५x", "content_sanskrit": "`वैशम्पायन उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2041127, "chapter_id": 1913, "verse_number": "५-१५८-३५", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य विजयस्य च धीमतः ।\nविनिवर्त्य ततो रुक्मी सेनां सागरसंनिभाम् ।\nदुर्योधनमुपागच्छत्तथैव भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2041128, "chapter_id": 1913, "verse_number": "५-१५८-३६", "content_sanskrit": "तथैव चाभिगम्यैनमुवाच वसुधाधिपः।\nप्रत्याख्यातश्च तेनापि स तदा शूरमानिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2041129, "chapter_id": 1913, "verse_number": "५-१५८-३७", "content_sanskrit": "द्वावेव तु महाराज तस्माद्युद्धादपेयतुः।\nरौहिणेयश्च वार्ष्णेयो रुक्मी च वसुधाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2041130, "chapter_id": 1913, "verse_number": "५-१५८-३८", "content_sanskrit": "गते रामे तीर्थयात्रां भीष्मकस्य सुते तथा।\nउपाविशन्पाण्डवेया मन्त्राय पुनरेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2041131, "chapter_id": 1913, "verse_number": "५-१५८-३९", "content_sanskrit": "समितिर्धर्मराजस्य सा पार्थिवसमाकुला ।\nशुशुभे तारकैश्चित्रा द्यौश्चन्द्रेणेव भारत ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2041132, "chapter_id": 1913, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वमि सैन्यनिर्याणपर्वणि अष्टप़ञ्चाशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]