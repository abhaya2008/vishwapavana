[{"id": 2078068, "chapter_id": 2658, "verse_number": "१२-१६३-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078069, "chapter_id": 2658, "verse_number": "१२-१६३-१", "content_sanskrit": "कृतार्थी यक्ष्यमाणश्च सर्ववेदान्तगश्च यः।\nआचार्यपितृकायार्थं स्वाध्यायार्थमथापि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078070, "chapter_id": 2658, "verse_number": "१२-१६३-२", "content_sanskrit": "एते वै साधवो दृष्टा ब्राह्मणाः धर्मभिक्षवः।\nनिःस्वेभ्यो देयमेतेभ्यो दानं विद्या च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078071, "chapter_id": 2658, "verse_number": "१२-१६३-३", "content_sanskrit": "अन्यत्र दक्षिणादानं देयं भरतसत्तम।\nअन्येभ्योऽपि वहिर्वेदि न कृतान्नं विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078072, "chapter_id": 2658, "verse_number": "१२-१६३-४", "content_sanskrit": "सर्वरत्नानि राजा हि यथार्हं प्रतिपादयेत्।\nब्राह्मणायैव यज्ञाश्च सहान्नाः सहदक्षिणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078073, "chapter_id": 2658, "verse_number": "१२-१६३-५", "content_sanskrit": "अन्येभ्यो विमलाचारा यजन्ते गुणतः सदा।\nयस्य त्रैवार्पिकं भक्तं पर्याप्तं भृत्यवृत्तये।\nअधिकं चापि विद्येत स सोमं पातुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078074, "chapter_id": 2658, "verse_number": "१२-१६३-६", "content_sanskrit": "यज्ञश्चेत्प्रतिरुद्धः स्यादंशेनैकेन यज्वनः।\nब्राह्मणस्य विशेषेण धार्मिके सति राजनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078075, "chapter_id": 2658, "verse_number": "१२-१६३-७", "content_sanskrit": "यो वैश्यः स्याद्बहुपशुर्हीनक्रतुरसोमपः।\nकुटुम्बात्तस्य तद्वित्तं यज्ञार्थं पार्थिवो हरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078076, "chapter_id": 2658, "verse_number": "१२-१६३-८", "content_sanskrit": "आहरेद्द्रुह्यतः किंचित्कामं शूद्रस्य वेश्मनि।\nन हि वेश्मनि शूद्रस्य किंचिदस्ति परिग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078077, "chapter_id": 2658, "verse_number": "१२-१६३-९", "content_sanskrit": "योऽनाहिताग्निः शतगुरयज्वा त्त सहस्रगुः।\nतयोरपि कुटुम्बाभ्यामाहरेदविचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078078, "chapter_id": 2658, "verse_number": "१२-१६३-१०", "content_sanskrit": "अदातृभ्यो हरेद्वित्तं विख्याप्य नृपतिः सदा।\nतथैवाचरतो धर्मो नृपतेः स्यादथाखिलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078079, "chapter_id": 2658, "verse_number": "१२-१६३-११", "content_sanskrit": "तथैव सप्तमे भक्ते भक्तानि पडनश्नतः।\nअश्वस्तनविभागेन हर्तव्यं हीनकर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078080, "chapter_id": 2658, "verse_number": "१२-१६३-१२", "content_sanskrit": "खलात्क्षेत्रात्तथागाराद्यतो वाऽप्युपपद्यते।\nआख्यातव्यं नृपस्यैतत्पृच्छतोऽपृच्छतोपि वा।\nन तस्मै धारयेद्दण्डं राजा धर्मेण धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078081, "chapter_id": 2658, "verse_number": "१२-१६३-१३", "content_sanskrit": "क्षत्रियस्य तु बालिश्याद्ब्राह्मणः क्लिश्यते क्षुधा।\nश्रुतशीले समाज्ञाय वृत्तिमस्य प्रकल्पयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078082, "chapter_id": 2658, "verse_number": "१२-१६३-१४", "content_sanskrit": "अथैनं परिरक्षेत पिता पुत्रमिवौरसम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078083, "chapter_id": 2658, "verse_number": "१२-१६३-१५", "content_sanskrit": "इष्टिं वैश्वानरीं नित्यं निर्वपेदब्दपर्यये।\nअविकल्पः पुरा धर्मो धर्मवादैस्तु केवलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078084, "chapter_id": 2658, "verse_number": "१२-१६३-१६", "content_sanskrit": "विश्वैर्देवैश्च साध्यैश्च ब्राह्मणैश्च महर्षिभिः।\nआपत्सु गरणाद्भीतैर्लिङ्गः प्रतिनिधीकृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078085, "chapter_id": 2658, "verse_number": "१२-१६३-१७", "content_sanskrit": "प्रभुः प्रथमकल्पस्य योऽनुकल्पेन वर्तते।\nस नाप्नोति फलं तस्य प्रेत्य चेह च दुर्मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078086, "chapter_id": 2658, "verse_number": "१२-१६३-१८", "content_sanskrit": "न ब्राह्मणो वेदयीत किंचिद्राजनि धर्मवित्।\nअविद्यावेदनाद्विद्यात्स्ववीर्यं वीर्यवत्तरम्।\nतस्माद्राज्ञः सदा तेजो दुःसहं ब्रह्मवादिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078087, "chapter_id": 2658, "verse_number": "१२-१६३-१९", "content_sanskrit": "मन्ता शास्ता विधाता च ब्राह्मणो देव उच्यते।\nतस्मिन्नाकुशलं ब्रूयान्न शुष्कामीरयेद्गिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078088, "chapter_id": 2658, "verse_number": "१२-१६३-२०", "content_sanskrit": "क्षत्रियो बाहुवीर्येण तरेदापदमात्मनः।\nधनैर्वैश्यश्च शुद्रश्च मन्त्रैर्होमैश्च वै द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078089, "chapter_id": 2658, "verse_number": "१२-१६३-२१", "content_sanskrit": "नैव कन्या न युवतिर्नामन्त्रज्ञो न बालिशः।\nपरिवेष्टाऽग्निहोत्रस्य भवेन्नासंस्कृतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078090, "chapter_id": 2658, "verse_number": "१२-१६३-२२", "content_sanskrit": "नरके निपतन्त्येते जुह्वानाः सवनस्य तत्।\nतस्माद्वैतानकुशलो होता स्याद्वेदपारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078091, "chapter_id": 2658, "verse_number": "१२-१६३-२३", "content_sanskrit": "प्राजापत्यमदत्त्वा च अग्न्याधेयस्य दक्षिणाम्।\nअनाहिताग्निरिति सं प्रोच्यते धर्मदर्शिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078092, "chapter_id": 2658, "verse_number": "१२-१६३-२४", "content_sanskrit": "पुण्यान्यन्यानि कुर्वीत श्रद्दधानो जितेन्द्रियः।\nअनाप्तदक्षिणैर्यज्ञैर्न यजेत कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078093, "chapter_id": 2658, "verse_number": "१२-१६३-२५", "content_sanskrit": "प्रजाः पंशूश्च स्वर्गं च हन्ति यज्ञो ह्यदक्षिणः।\nइन्द्रियाणि यशः कीर्तिभायुश्चाप्यवकृन्तति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2078094, "chapter_id": 2658, "verse_number": "१२-१६३-२६", "content_sanskrit": "उदक्यामासते ये च द्विजाः केचिदनग्नयः।\nकुलं चाश्रोत्रियं येषां सर्वे ते शूद्रकर्मिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2078095, "chapter_id": 2658, "verse_number": "१२-१६३-२७", "content_sanskrit": "उदपानोदके ग्रामे ब्राह्मणो वृपलीयतिः।\nअपित्वा द्वादश समाः शूद्रकर्मैव गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2078096, "chapter_id": 2658, "verse_number": "१२-१६३-२८", "content_sanskrit": "अभार्यी शयने विभ्रच्छूद्रं वृद्धं च वै द्विजः।\nअब्राह्मणं भन्यमानस्तृणेष्वासीत पृष्ठतः।\nतथा संशुध्यते राजञ्शृणु चात्र वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2078097, "chapter_id": 2658, "verse_number": "१२-१६३-२९", "content_sanskrit": "यदेकरात्रेण करोति पापं\nकृष्णं वर्णं ब्राह्मणः सेवमानः।\nस्थानासनाभ्यां विहरन्वती स\nत्रिभिर्वर्षैः शमयेदात्मपापम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2078098, "chapter_id": 2658, "verse_number": "१२-१६३-३०", "content_sanskrit": "न नर्मयुक्तमतृतं हिनस्ति\nन स्त्रीषु राजन्न विवाहकाले।\nप्राणात्यये सर्वधनापहारे\nपञ्चानृतान्याहुरपातकानि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2078099, "chapter_id": 2658, "verse_number": "१२-१६३-३१", "content_sanskrit": "श्रद्दधानः शुभां विद्यां हीनादपि समाप्नुयात्।\nसुवर्णमपि चामेध्यादाददीताविचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2078100, "chapter_id": 2658, "verse_number": "१२-१६३-३२", "content_sanskrit": "स्त्रीरत्नं दुष्कुलाच्चापि विषादप्यमृतं पिबेत्।\nअदूष्या हि स्त्रियो रत्नमाप इत्येव धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2078101, "chapter_id": 2658, "verse_number": "१२-१६३-३३", "content_sanskrit": "गोब्राह्मणहितार्थं च वर्णानां संकरेषु च।\nवैश्यो गृह्णीत शस्त्राणि परित्राणार्थमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2078102, "chapter_id": 2658, "verse_number": "१२-१६३-३४", "content_sanskrit": "सुरापो ब्रह्महा चैव गुरुतल्पगतस्तथा।\nअचिरेण महाराज पतितो वै भवत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2078103, "chapter_id": 2658, "verse_number": "१२-१६३-३५", "content_sanskrit": "सुवर्णहरणं स्तैन्यं विप्रस्वं चेति पातकम्।\nविहारो मद्यपानं च अगम्यागमनं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2078104, "chapter_id": 2658, "verse_number": "१२-१६३-३६", "content_sanskrit": "पतितैः संप्रयोगश्च ब्राह्मणीयोनितस्तथा।\nअनिर्देश्यानि मन्यन्ते प्राणान्तानीति धारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2078105, "chapter_id": 2658, "verse_number": "१२-१६३-३७", "content_sanskrit": "संवत्सरेण पतति पतितेन सहाचरन्।\nयाजनाध्यापनाद्दानान्न तु यानासनाशनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2078106, "chapter_id": 2658, "verse_number": "१२-१६३-३८", "content_sanskrit": "एतानि हित्वातोऽन्यानि निर्देश्यानीति धारणा।\nनिर्देश्यकेन विधिना कालेनाव्यसनी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2078107, "chapter_id": 2658, "verse_number": "१२-१६३-३९", "content_sanskrit": "अनुत्तीर्य न होतव्यं प्रेतकर्मण्युपाश्रिते।\nत्रिषु त्वेतेषु पूर्वेषु न कुर्वीत विचारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2078108, "chapter_id": 2658, "verse_number": "१२-१६३-४०", "content_sanskrit": "अमात्यान्वा गुरून्वापि जह्याद्धर्मेण धार्मिकः।\nप्रायश्चित्तान्यकुर्वाणा नैते कुर्वन्ति संविदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2078109, "chapter_id": 2658, "verse_number": "१२-१६३-४१", "content_sanskrit": "अधर्मकारी धर्मेण तपसा हन्ति किल्विषम्।\nब्राह्मणायावगुर्येत स्पृष्टे गुरुतरं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2078110, "chapter_id": 2658, "verse_number": "१२-१६३-४२", "content_sanskrit": "अस्तेनं स्तेन इत्युक्त्वा द्विगुणं पापमाप्नुयात्।\nत्रिभागं ब्रह्महत्यायाः कन्यां प्राप्नोति दुष्यति।\nयस्तु दूषयिता तस्याः शेषं प्राप्नोति पाप्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2078111, "chapter_id": 2658, "verse_number": "१२-१६३-४३", "content_sanskrit": "ब्राह्मणानवगर्ह्येह स्पृष्ट्वा गुरुतरं भवेत्।\nवर्षाणां हि शतं पापः प्रतिष्ठां नाधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2078112, "chapter_id": 2658, "verse_number": "१२-१६३-४४", "content_sanskrit": "सहस्रं चैव वर्षाणां निपत्य नरकं वसेत्।\nतस्मान्नैवावगुर्याद्धि नैव जातु निपातयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2078113, "chapter_id": 2658, "verse_number": "१२-१६३-४५", "content_sanskrit": "शोणितं यावतः पांसून्संगृह्णीयाद्द्विजक्षतात्।\nतावतीः स समा राजन्नरके प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2078114, "chapter_id": 2658, "verse_number": "१२-१६३-४६", "content_sanskrit": "भ्रूणहाऽऽहवमध्ये तु शुध्यते शस्त्रपाततः।\nआत्मानं जुहुयादग्नौ समिद्धे तेन शुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2078115, "chapter_id": 2658, "verse_number": "१२-१६३-४७", "content_sanskrit": "सुरापो वारुणीमुष्णां पीत्वा पापाद्विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2078116, "chapter_id": 2658, "verse_number": "१२-१६३-४८", "content_sanskrit": "तया स काये निर्दग्धे मृत्युं वा प्राप्य शुध्यति।\nलोकांश्च लभते विप्रो नान्यथा लभते हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2078117, "chapter_id": 2658, "verse_number": "१२-१६३-४९", "content_sanskrit": "गुरुतल्पमधिष्ठाय दुरात्मा पापचेतनः।\nशिलां ज्वलन्तीमासाद्य मृत्युना सोभिशुध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2078118, "chapter_id": 2658, "verse_number": "१२-१६३-५०", "content_sanskrit": "अधवा शिश्नवृषणावादायाञ्जलिना स्वयम्।\nनैर्ऋतीं दिशमास्थाय निपतेत्सत्वजिह्मगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2078119, "chapter_id": 2658, "verse_number": "१२-१६३-५१", "content_sanskrit": "ब्राह्मणार्थेऽपि वा प्राणान्संत्यजंस्तेन शुध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2078120, "chapter_id": 2658, "verse_number": "१२-१६३-५२", "content_sanskrit": "अश्वमेधेन वाऽपीष्ट्वा अथवा गोसवेन वा।\nमरुत्सोमेन वा सम्यगिह प्रेत्य च पूज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2078121, "chapter_id": 2658, "verse_number": "१२-१६३-५३", "content_sanskrit": "तथैव द्वादशसमाः कापोतं धर्ममाचरेत्।\nएककालं चरेद्भैक्षं स्वकर्मोदाहरञ्जने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2078122, "chapter_id": 2658, "verse_number": "१२-१६३-५४", "content_sanskrit": "एवं वा तपसा युक्तो ब्रह्महा सवनी भवेत्।\nएवं गर्भमविज्ञातमात्रेयीं वा निपातयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2078123, "chapter_id": 2658, "verse_number": "१२-१६३-५५", "content_sanskrit": "द्विगुणा ब्रह्महत्या वै आत्रेयीहिंसने भवेत्।\nसुरापी नियताहारो ब्रह्मचारी क्षपाचरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2078124, "chapter_id": 2658, "verse_number": "१२-१६३-५६", "content_sanskrit": "ऊर्ध्वं त्रिभ्योऽपि वर्षेभ्यो यजेताग्निष्टुता परम्।\nऋषभैकसहस्रं वा गा दत्त्वा शौचमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2078125, "chapter_id": 2658, "verse_number": "१२-१६३-५७", "content_sanskrit": "वैश्यं दत्त्वा तु वर्षे द्वे ऋषभैकशतं च गाः।\nशूद्रं हत्वाऽब्दमेवैकमृषभं च शतं च गाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2078126, "chapter_id": 2658, "verse_number": "१२-१६३-५८", "content_sanskrit": "श्ववराहखरान्हत्वा शौद्रमेव व्रतं चरेत्।\nमार्जारचाषमण्डूकान्काकं व्यालं च मूषिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2078127, "chapter_id": 2658, "verse_number": "१२-१६३-५९", "content_sanskrit": "उक्तः पशुवधे दोषो राजन्प्राणिनिपातनात्।\n`अनस्थिकेषु गोमूत्रं पानमेकं प्रचक्षते।\nप्रायश्चित्तान्यथान्यानि प्रवक्ष्याम्यनुपूर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2078128, "chapter_id": 2658, "verse_number": "१२-१६३-६०", "content_sanskrit": "तल्पे वाऽन्यस्य चौर्ये च पृथक् संवत्सरं चरेत्।\nत्रीणि श्रोत्रियभार्यायां परदारे च द्वे स्मृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2078129, "chapter_id": 2658, "verse_number": "१२-१६३-६१", "content_sanskrit": "काले चतुर्थे भुञ्जानो ब्रह्मचारी व्रती भवेत्।\nस्थानासनाभ्यां विहरेत्रिरह्नाऽभ्युपयन्नपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2078130, "chapter_id": 2658, "verse_number": "१२-१६३-६२", "content_sanskrit": "`ऐवमेव चरन्राजंस्तस्मात्पापात्प्रमुच्यते।\nएवमेव निराकर्ता यश्चाग्नीनपविध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2078131, "chapter_id": 2658, "verse_number": "१२-१६३-६३", "content_sanskrit": "त्यजत्यकारणे यश्च पितरं मातरं गुरुम्।\nपतितः स्यात्स कौरव्य यथा धर्मेषु निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2078132, "chapter_id": 2658, "verse_number": "१२-१६३-६४", "content_sanskrit": "ग्रासाच्छादनयानं च शयनं ह्यासनं तथा।\n`ब्रह्मचारी द्विजेभ्यश्च दत्त्वा पापात्प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2078133, "chapter_id": 2658, "verse_number": "१२-१६३-६५", "content_sanskrit": "भार्यायां व्यभिचारिण्यां निरुद्धायां विशेषतः।\nयत्पुंसः परदारेषु तदेनां चारयेद्व्रतम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2078134, "chapter_id": 2658, "verse_number": "१२-१६३-६६", "content_sanskrit": "श्रेयांसं शयने हित्वा पापीयांसं समृच्छति।\nश्वभिस्तमर्दयेद्राजा संस्थाने बहुविस्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2078135, "chapter_id": 2658, "verse_number": "१२-१६३-६७", "content_sanskrit": "पुमांसं बन्धयेत्पाशैः शयने तप्त आयसे।\nअप्यादधीत दारूणि तत्र दह्येत पापकृत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2078136, "chapter_id": 2658, "verse_number": "१२-१६३-६८", "content_sanskrit": "एव दण्डो महाराज स्त्रीणां भर्तृव्यतिक्रमे।\nसंवत्सारोऽभिशस्तस्य दुष्टस्य द्विगुणो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2078137, "chapter_id": 2658, "verse_number": "१२-१६३-६९", "content_sanskrit": "द्वे तस्य त्रीणि वर्षाणि चत्वारि सहसेविनः।\nकुमारः पञ्चवर्षाणि चरेद्भैक्षं मुनिव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2078138, "chapter_id": 2658, "verse_number": "१२-१६३-७०", "content_sanskrit": "परिवित्तिः परिवेत्ता या चैव परिविद्यते।\nपाणिग्राहस्त्वधर्मेण सर्वे ते पतिताः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2078139, "chapter_id": 2658, "verse_number": "१२-१६३-७१", "content_sanskrit": "चरेयुः सर्व एवैते वीरहा यद्व्रतं चरेत्।\nचान्द्रायणं चरेन्मासं कृच्छ्रं वा पापशुद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2078140, "chapter_id": 2658, "verse_number": "१२-१६३-७२", "content_sanskrit": "परिवेत्ता प्रयच्छेता तां स्नुषां परिवित्तये।\nज्येष्ठेन त्वभ्यनुज्ञातो यवीयाप्यनन्तरम्।\nएनसो मोक्षमाप्नोति तौ च सा चैव धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2078141, "chapter_id": 2658, "verse_number": "१२-१६३-७३", "content_sanskrit": "अमानुषीषु गोवर्जमनादिष्टं न दुष्यति।\nअधिष्ठातारमत्तारं पशूनां पुरुषं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2078142, "chapter_id": 2658, "verse_number": "१२-१६३-७४", "content_sanskrit": "परिधायोर्ध्ववालं तु पात्रमादाय मृन्मयम्।\nचरेत्सप्तगृहान्भैक्षं स्वकर्म परिकीर्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2078143, "chapter_id": 2658, "verse_number": "१२-१६३-७५", "content_sanskrit": "तथैव लब्धभोजी स्याद्द्वादशाहात्स शुध्यति।\nचरेत्संवत्सरं चापि तद्व्रतं येन कृन्तति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2078144, "chapter_id": 2658, "verse_number": "१२-१६३-७६", "content_sanskrit": "भवेत्तु मानुषेष्वेवं प्रायश्चिमनुत्तमम्।\nदानं वा दानशक्तेषु सवेर्मतत्प्रकल्पयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2078145, "chapter_id": 2658, "verse_number": "१२-१६३-७७", "content_sanskrit": "अनास्तिकेषु गोमात्रं दानमेकं प्रचक्षते।\nश्ववराहमनुष्याणां कुक्कुटस्य खरस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2078146, "chapter_id": 2658, "verse_number": "१२-१६३-७८", "content_sanskrit": "मांसं मूत्रं पुरीषं च प्राश्य संस्कारमर्हति।\nब्राह्मणस्तु सुरापस्य गन्धमादाय सोमपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2078147, "chapter_id": 2658, "verse_number": "१२-१६३-७९", "content_sanskrit": "अपख्यहं पिबेदुष्णाः संयतात्मा जितेन्द्रियः।\nअपः पीत्वा तु स पुनर्वायुभक्षो भवेन्त्र्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2078148, "chapter_id": 2658, "verse_number": "१२-१६३-८०", "content_sanskrit": "एवमेतत्समुद्दिष्टं प्रायश्चित्तिषेवणम्।\nब्राह्मणस्य विशेषेण यदज्ञानेन जायते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2078149, "chapter_id": 2658, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि त्रिषष्ट्यधिकशततमोऽधअयायः॥ १६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]