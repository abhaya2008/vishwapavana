[{"id": 7002952000, "chapter_id": 22952, "verse_number": "१-२९-१", "content_sanskrit": "सौतिरुवाच ।\nददर्शाश्रममाश्चर्य्यं देवर्षिर्नारदस्तथा ।\nऋषिर्नारायणस्यैव बदरीवनसंयुतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002952001, "chapter_id": 22952, "verse_number": "१-२९-२", "content_sanskrit": "नानावृक्षफलाकीर्णं पुंस्कोकिलरुतश्रुतम् ।\nशरभेन्द्रैः केसरीन्द्रैर्व्याघ्रौघैः परिवेष्टितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002952002, "chapter_id": 22952, "verse_number": "१-२९-३", "content_sanskrit": "ऋषीन्द्रस्य प्रभावेण हिंसाभयविवर्जितम् ।\nमहारण्यमगम्यं च स्वर्गादपि मनोहरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002952003, "chapter_id": 22952, "verse_number": "१-२९-४", "content_sanskrit": "सिद्धेन्द्राणां मुनीन्द्राणामाश्रमाणां त्रिकोटिभिः ।\nआवृतं चन्दनारण्यैः पारिजातवनान्वितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002952004, "chapter_id": 22952, "verse_number": "१-२९-५", "content_sanskrit": "ददर्श तमृषीन्द्रं च सभामध्ये मनोहरम् ।\nरत्नसिंहासनस्थं च वसन्तं योगिनां गुरुम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002952005, "chapter_id": 22952, "verse_number": "१-२९-६", "content_sanskrit": "जपन्तं परमं ब्रह्म कृष्णमात्मानमीश्वरम् ।\nप्रणनाम च तं दृष्ट्वा ब्रह्मपुत्रश्च शौनक ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002952006, "chapter_id": 22952, "verse_number": "१-२९-७", "content_sanskrit": "उत्थाय सहसाऽऽलिङ्ग्य युयुजे परमाशिषम् ।\nपप्रच्छ कुशलं स्नेहाच्चकारातिथिपूजनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002952007, "chapter_id": 22952, "verse_number": "१-२९-८", "content_sanskrit": "रत्नसिंहासने रम्ये वासयामास नारदम् ।\nनिवसन्नासने रम्ये वर्त्मश्रमविवर्जितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002952008, "chapter_id": 22952, "verse_number": "१-२९-९", "content_sanskrit": "उवाच तमृषिश्रेष्ठं भगवन्तं सनातनम् ।\nअधीत्य वेदान्सर्वांश्च पितुः स्थाने सुदुर्गमान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002952009, "chapter_id": 22952, "verse_number": "१-२९-१०", "content_sanskrit": "ज्ञानं सम्प्राप्य योगीन्द्रान्मन्त्रं वै शङ्कराद्विभो ।\nमनो मे न हि तृप्नोति दुर्निवारं च चंचलम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002952010, "chapter_id": 22952, "verse_number": "१-२९-११", "content_sanskrit": "दृष्टं मया त्वत्पदाब्जं मनसा प्रेरितेन च ।\nकिंचिज्ज्ञानविशेषं च लब्धुमिच्छामि साम्प्रतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002952011, "chapter_id": 22952, "verse_number": "१-२९-१२", "content_sanskrit": "यत्र कृष्णगुणाख्यानं जन्ममृत्युजरापहम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002952012, "chapter_id": 22952, "verse_number": "१-२९-१३", "content_sanskrit": "ब्रह्मविष्णुशिवाद्याश्च सुरेन्द्रश्च सुरा विभो ।\nकं चिन्तयन्ति मुनयो मनवश्च विचक्षणाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002952013, "chapter_id": 22952, "verse_number": "१-२९-१४", "content_sanskrit": "कस्मात्सृष्टिश्च भवति कुत्र वा संप्रलीयते॥।\nको वा सर्वेश्वरो विष्णुः सर्वकारणकारकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002952014, "chapter_id": 22952, "verse_number": "१-२९-१५", "content_sanskrit": "तस्येश्वरस्य किं रूपं कर्म वा किं जगत्पते ।\nविचार्य्य मनसा सर्वं तद्भवान्वक्तुमर्हति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002952015, "chapter_id": 22952, "verse_number": "१-२९-१६", "content_sanskrit": "नारदस्य वचः श्रुत्वा प्रहस्य भगवानृषिः ।\nकथां कथितुमारेभे पुण्यां भुवनपावनीम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]