[{"id": 2019675, "chapter_id": 1409, "verse_number": "३-४७-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019676, "chapter_id": 1409, "verse_number": "३-४७-१", "content_sanskrit": "यदिदं शोचितं राज्ञा धृतराष्ट्रेण वै मुने।\nप्रव्राज्यपाण्डवान्वीरान्सर्वमेतन्निर्रथकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019677, "chapter_id": 1409, "verse_number": "३-४७-२", "content_sanskrit": "कथं च राजपुत्रं तमुपेक्षेताल्पचेतसम्।\nदुर्योधनं पाण्डुपुत्रान्कोपयानं महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019678, "chapter_id": 1409, "verse_number": "३-४७-३", "content_sanskrit": "किमासीत्पाण्डुपुत्राणां वने भोजनमुच्यताम्।\nवन्यं वाऽप्यवा कृष्टमेतदाख्यातु नो भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019679, "chapter_id": 1409, "verse_number": "३-४७-४x", "content_sanskrit": "वैंशंपायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019680, "chapter_id": 1409, "verse_number": "३-४७-४", "content_sanskrit": "वानेयं च मृगांश्चैव शुद्धैर्बाणैर्निपातितान्।\nब्राह्मणानां निवेद्याग्रमभुञ्जता महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019681, "chapter_id": 1409, "verse_number": "३-४७-५", "content_sanskrit": "तांस्तु शूरान्महेष्वासांस्तदा निवसतो वने।\nअन्वयुर्ब्राह्मणा राजन्साग्नयोऽनग्नयस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019682, "chapter_id": 1409, "verse_number": "३-४७-६", "content_sanskrit": "ब्राह्मणानां सहस्राणि स्नातकानां महात्मनाम्।\nदश मोक्षविदां तद्वद्यान्बिभर्ति युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019683, "chapter_id": 1409, "verse_number": "३-४७-७", "content_sanskrit": "रुरून्कृष्णमृगांश्चैव मेध्यांश्चान्यान्मनोरमान्।\nबाणैरुन्मथ्य विविधैर्ब्राह्मणेभ्यो न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019684, "chapter_id": 1409, "verse_number": "३-४७-८", "content_sanskrit": "न तत्र कश्चिद्दुर्वर्णो व्याधितो वाऽपि दृश्यते।\nकृशो वा दुर्बलो वाऽपि दीनो भीतोपि वा पुनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019685, "chapter_id": 1409, "verse_number": "३-४७-९", "content_sanskrit": "पुत्रानिव प्रियान्भ्रातॄन्ज्ञातीनिव सहोदरान्।\nपुरोष कौरवश्रेष्ठो धर्मेराजो युधिष्ठिरः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019686, "chapter_id": 1409, "verse_number": "३-४७-१०", "content_sanskrit": "पतीश्च द्रौपदी सर्वाञ्द्विजातीश्च यशस्विनी।\nमातेव भोजयित्वाऽग्रे शिष्टमाहारयत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019687, "chapter_id": 1409, "verse_number": "३-४७-११", "content_sanskrit": "प्राचीं राजा दक्षिणां भीमसेनो\nयमौ प्रतीचीमथवाऽप्युदीचीम्।\nधनुर्धरा मांसहेतोर्मृगाणां\nक्षयं चक्रुर्नित्यमेवोपगम्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019688, "chapter_id": 1409, "verse_number": "३-४७-१२", "content_sanskrit": "तथा तेषां कवसतां काम्यके वै\nविहीनानामर्जुनेनोत्सुकानाम्।\nपञ्चैव वर्षाणि तथा व्यतीयु-\nरथीयतां जपतां जुह्वतां च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019689, "chapter_id": 1409, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि इन्द्रलोकाभिगमनपर्वणि सप्तचत्वारिंशोऽध्यायः ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]