[{"id": 2131133, "chapter_id": 3830, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131134, "chapter_id": 3830, "verse_number": "", "content_sanskrit": "एतस्मिन्नेव काले तु सर्ववादित्रनिस्वनः ।\nबभूव तुमुलः शब्दस्त्वन्तरिक्षे दिवौकसाम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131135, "chapter_id": 3830, "verse_number": "", "content_sanskrit": "ततो रजन्यां व्युष्टायां धर्मराजं युधिष्ठिरम् ।\nभ्रातृभिः सहितः सर्वैरवन्दत धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131136, "chapter_id": 3830, "verse_number": "१", "content_sanskrit": "रथनेमिस्वनश्चैव घण्टाशब्दश्च भारत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131137, "chapter_id": 3830, "verse_number": "२", "content_sanskrit": "पृथग्व्यालमृगाणां च पक्षिणामिव सर्वशः ।\nरवोन्मुखास्ते ददृशुः प्रीयमाणाः कुरूद्वहाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2131138, "chapter_id": 3830, "verse_number": "३", "content_sanskrit": "मरुद्भिरन्वितं शक्रमापतन्तं विहायसा \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2131139, "chapter_id": 3830, "verse_number": "४", "content_sanskrit": "ते समन्तादनुययुर्गन्धर्वाप्सरसां गणाः ।\nविमानैः सूर्यसङ्काशैर्देवराजमरिन्दमम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2131140, "chapter_id": 3830, "verse_number": "५", "content_sanskrit": "ततः स हरिभिर्युक्तं जाम्बूनदपरिष्कृतम् ।\nमेघनादिनमारुह्य श्रिया परमया ज्वलन् ।\nपार्थानभ्याजगामाशु देवराजः पुरन्दरः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2131141, "chapter_id": 3830, "verse_number": "६", "content_sanskrit": "आगत्य च सहस्राक्षो रथादवरुरोह वै\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2131142, "chapter_id": 3830, "verse_number": "७", "content_sanskrit": "तं दृष्ट्वैव महात्मानं धर्मराजो युधिष्ठिरः ।\nभ्रातृभिः सहितः श्रीमान् देवराजमुपागमत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2131143, "chapter_id": 3830, "verse_number": "८", "content_sanskrit": "पूजयामास चैवाथ विधिवद् भूरिदक्षिणः ।\nयथार्हममितात्मानं विधिदृष्टेन कर्मणा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2131144, "chapter_id": 3830, "verse_number": "९", "content_sanskrit": "धनञ्जयश्च तेजस्वी प्रणिपत्य पुरन्दरम् ।\nभ्रातृ(भृत्य)वत् प्रणतस्तस्थौ देवराजसमीपतः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2131145, "chapter_id": 3830, "verse_number": "१०", "content_sanskrit": "आघ्राय तं महातेजाः कुन्तीपुत्रो युधिष्ठिरः ।\nधनञ्जयमभिप्रेक्ष्य विनीतं स्थितमन्तिके \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2131146, "chapter_id": 3830, "verse_number": "११", "content_sanskrit": "जटिलं देवराजस्य तपोयुक्तमकल्मषम् ।\nहर्षेण महताऽऽविष्टः फल्गुनस्याथ दर्शनात्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2131147, "chapter_id": 3830, "verse_number": "", "content_sanskrit": "परया च मुदा युक्तो देवराजस्य दर्शनात् ।\nबभूव परमप्रीतो देवराजं च पूजयन् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2131148, "chapter_id": 3830, "verse_number": "१२", "content_sanskrit": "तं तथाऽदीनमनसं राजानं हर्षसम्प्लुतम् ।\nउवाच वचनं धीमान् देवराजः पुरन्दरः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2131149, "chapter_id": 3830, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2131150, "chapter_id": 3830, "verse_number": "१३", "content_sanskrit": "त्वमिमां पृथिवीं राजन् प्रशासिष्यसि पाण्डव ।\nस्वस्ति प्राप्नुहि कौन्तेय काम्यकं पुनराश्रमम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2131151, "chapter_id": 3830, "verse_number": "१४", "content_sanskrit": "अस्त्राणि लब्धानि च पाण्डवेन\nसर्वाणि मत्तः प्रयतेन राजन् ।\nकृतप्रियश्चास्मि धनञ्जयेन\nजेतुं न शक्यस्त्रिभिरेष लोकैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2131152, "chapter_id": 3830, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2131153, "chapter_id": 3830, "verse_number": "१५", "content_sanskrit": "एवमुक्त्वा सहस्राक्षः कुन्तीपुत्रं युधिष्ठिरम् ।\nजगाम त्रिदिवं हृष्टः स्तूयमानो महर्षिभिः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2131154, "chapter_id": 3830, "verse_number": "१६", "content_sanskrit": "धनेश्वरगृहस्थानां पाण्डवानां समागमम्।\nशक्रेण य इदं विद्वानधीयीत समाहितः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2131155, "chapter_id": 3830, "verse_number": "१७", "content_sanskrit": "संवत्सरं ब्रह्मचारी नियतः संशितव्रतः ।\nस जीवेद्धि निराबाधः स सुखी शरदां शतम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2131156, "chapter_id": 3830, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2131157, "chapter_id": 3830, "verse_number": "१६१", "content_sanskrit": "एकषष्ट्यधिकशततमोऽध्यायः ॥ १६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2131158, "chapter_id": 3830, "verse_number": "", "content_sanskrit": "यक्षयुद्धपर्वणि अष्टमोऽध्यायः ॥८॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]