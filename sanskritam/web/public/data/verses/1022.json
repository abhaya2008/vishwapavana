[{"id": 2001410, "chapter_id": 1022, "verse_number": "१-२३-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001411, "chapter_id": 1022, "verse_number": "१-२३-१", "content_sanskrit": "तं समुद्रमतिक्रम्य कद्रूर्विनतया सह।\nन्यपतत्तुरगाभ्याशे न चिरादिव शीघ्रगा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001412, "chapter_id": 1022, "verse_number": "१-२३-२", "content_sanskrit": "ततस्ते तं हयश्रेष्ठं ददृशाते महाजवम्।\nशशाङ्ककिरणप्रख्यं कालवालमुभे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001413, "chapter_id": 1022, "verse_number": "१-२३-३", "content_sanskrit": "निशाम्य च बहून्वालान्कृष्णान्पुच्छसमाश्रितान्।\nविषण्णरूपां विनतां कद्रूर्दास्ये न्ययोजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001414, "chapter_id": 1022, "verse_number": "१-२३-४", "content_sanskrit": "ततः सा विनता तस्मिन्पणितेन पराजिता।\nअभवद्दुःखसंतप्ता दासीभावं समास्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001415, "chapter_id": 1022, "verse_number": "१-२३-५", "content_sanskrit": "एतस्मिन्नन्तरे चापि गरुडः काल आगते।\nविना मात्रा महातेजा विदार्याण्डमजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001416, "chapter_id": 1022, "verse_number": "१-२३-६", "content_sanskrit": "महासत्त्वबलोपेतः सर्वा विद्योतयन्दिशः।\nकामरूपः कामगमः कामवीर्यो विहंगमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001417, "chapter_id": 1022, "verse_number": "१-२३-७", "content_sanskrit": "अग्निराशिरिवोद्भासन्समिद्धोऽतिभयंकरः।\nविद्युद्विस्पष्टपिङ्गाक्षो युगान्ताग्निसमप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001418, "chapter_id": 1022, "verse_number": "१-२३-८", "content_sanskrit": "प्रवृद्धः सहसा पक्षी महाकायो नभोगतः।\nघोरो घोरस्वनो रौद्रो वह्निरौर्व इवापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001419, "chapter_id": 1022, "verse_number": "१-२३-९", "content_sanskrit": "तं दृष्ट्वा शरणं जग्मुर्देवाः सर्वे विभावसुम्।\nप्रमिपत्याब्रुवंश्चैनमासीनं विश्वरूपिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001420, "chapter_id": 1022, "verse_number": "१-२३-१०", "content_sanskrit": "अग्ने मा त्वं प्रवर्धिष्ठाः कच्चिन्नो न दिधक्षसि।\nअसौ हि राशिः सुमहान्समिद्धस्तव सर्पति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001421, "chapter_id": 1022, "verse_number": "१-२३-११x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001422, "chapter_id": 1022, "verse_number": "१-२३-११", "content_sanskrit": "नैतदेवं यथा यूयं मन्यध्वमसुरार्दनाः।\nगरुडो बलवानेष मम तुल्यश्च तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001423, "chapter_id": 1022, "verse_number": "१-२३-१२", "content_sanskrit": "जातः परमतेजस्वी विनतानन्दवर्धनः।\nतेजोराशिमिमं दृष्ट्वा युष्मान्मोहः समाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001424, "chapter_id": 1022, "verse_number": "१-२३-१३", "content_sanskrit": "नागक्षयकरश्चै काश्यपेयो महाबलः।\nदेवानां च हिते युक्तस्त्वहितो दैत्यरक्षसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001425, "chapter_id": 1022, "verse_number": "१-२३-१४", "content_sanskrit": "न भीः कार्या कथं चात्र पश्यध्वं सहिता मया।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001426, "chapter_id": 1022, "verse_number": "१-२३-१४x", "content_sanskrit": "सौतिरुवाच।\nएवमुक्तास्तदा गत्वा गरुडं वाग्भिरस्तुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001427, "chapter_id": 1022, "verse_number": "१-२३-१५", "content_sanskrit": "ते दूरादभ्युपेत्यैनं देवाः सर्षिगणास्तदा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001428, "chapter_id": 1022, "verse_number": "१-२३-१५x", "content_sanskrit": "देवा ऊचुः।\nत्वमृषिस्त्वं महाभागस्त्वं देवः पतगेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001429, "chapter_id": 1022, "verse_number": "१-२३-१६", "content_sanskrit": "त्वं प्रभुस्तपनः सूर्यः परमेष्ठी प्रजापतिः।\nत्वमिन्द्रस्त्वं हयमुखस्त्वं शर्वस्त्वं जगत्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001430, "chapter_id": 1022, "verse_number": "१-२३-१७", "content_sanskrit": "त्वं मुखं पद्मजी विप्रस्त्वमग्निः पवनस्तथा।\nत्वं हि धाता विधाता च त्वं विष्णुः सुरसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001431, "chapter_id": 1022, "verse_number": "१-२३-१८", "content_sanskrit": "त्वं महानभिभूः शश्वदमृतं त्वं महद्यशः।\nत्वं प्रभास्त्वमभिप्रेतं त्वं नस्त्राणमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001432, "chapter_id": 1022, "verse_number": "१-२३-१९", "content_sanskrit": "त्वं गतिः सततं त्वत्तः कथं नः प्राप्नुयाद्भयम्।\nबलोर्मिमान्साधुरदीनसत्त्वः\nसमृद्धिमान्दुर्विषहस्त्वमेव।\nत्वत्तः सृतं सर्वमहीनकीर्ते\nह्यनागतं चोपगतं च सर्वम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001433, "chapter_id": 1022, "verse_number": "१-२३-२०", "content_sanskrit": "त्वमुत्तमः सर्वमिदं चराचरं\nगभस्तिभिर्भानुरिवावभाससे।\nसमाक्षिपन्भानुमतः प्रभां मुहु-\nस्त्वमन्तकः सर्वमिदं ध्रुवाध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001434, "chapter_id": 1022, "verse_number": "१-२३-२१", "content_sanskrit": "दिवाकरः परिकुपितो यथा दहे-\nत्प्रजास्तथा दहसि हुताशनप्रभ।\nभयंकरः प्रलय इवाग्निरुत्थितो\nविनाशयन्युगपरिवर्तनान्तकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001435, "chapter_id": 1022, "verse_number": "१-२३-२२", "content_sanskrit": "खगेश्वरं शरणमुपागता वयं\nमहौजसं ज्वलनसमानवर्चसम्।\nतडित्प्रभं वितिमिरमभ्रगोचरं\nमहाबलं गरुडमुपेत्य खेचरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001436, "chapter_id": 1022, "verse_number": "१-२३-२३", "content_sanskrit": "परावरं वरदमजय्यविक्रमं\nतवौजस सर्वमिदं प्रतापितम्।\nजगत्प्रभो तप्तसुवर्णवर्चसा\nत्वं पाहि सर्वांश्च सुरान्महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001437, "chapter_id": 1022, "verse_number": "१-२३-२४", "content_sanskrit": "भयान्विता नभसि विमानगामिनो\nविमानिता विपथगतिं प्रयान्ति ते।\nऋषेः सुतस्त्वमसि दयावतः प्रभो\nमहात्मनः खगवर कश्यपस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2001438, "chapter_id": 1022, "verse_number": "१-२३-२५", "content_sanskrit": "स मा क्रुधः कुरु जगतो दयां परां\nत्वमीश्वरः प्रशममुपैहि पाहि नः।\nमहाशनिस्फुरितसमस्वनेन ते\nदिशोऽम्बरं त्रिदिवमियं च मेदिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2001439, "chapter_id": 1022, "verse_number": "१-२३-२६", "content_sanskrit": "चलन्ति नः खग हृदयानि चानिशं\nनिगृह्यतां वपुरिदमग्निसन्निभम्।\nतव द्युतिं कुपितकृतान्तसन्निभां\nनिशाम्य नश्चलति मनोऽव्यवस्थितम्।\nप्रसीद नः पतगते प्रयाचतां\nशिवश्च नो भव भगवन्सुखावहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2001440, "chapter_id": 1022, "verse_number": "१-२३-२७x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2001441, "chapter_id": 1022, "verse_number": "१-२३-२७", "content_sanskrit": "एवं स्तुतः सुपर्णस्तु देवैः सर्षिगणैस्तदा।\nतेजसः प्रतिसंहारमात्मनः स चकार ह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2001442, "chapter_id": 1022, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि त्रयोविंशोऽध्यायः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]