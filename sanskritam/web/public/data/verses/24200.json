[{"id": 7004200000, "chapter_id": 24200, "verse_number": "५-१-४९-१", "content_sanskrit": "सनत्कुमार उवाच ।\nएवं व्यास पुरी रम्या नामभूता सनातनी ।\nयुगेयुगे यथा जाता तथा ख्याता मयाऽनघ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004200001, "chapter_id": 24200, "verse_number": "५-१-४९-२", "content_sanskrit": "व्यास उवाच ।\nभूयोऽहं श्रोतुमिच्छामि त्वत्तो ब्रह्मविदां वर ।\nशिप्रायाश्च कथां पुण्यां पवित्रां पापहारिणीम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004200002, "chapter_id": 24200, "verse_number": "५-१-४९-३", "content_sanskrit": "सुन्दरं कुंडमाख्यातं पिशाचमोचनं तथा ।\nनीलगंगा इति प्रोक्ता कर्कराजमतः परम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004200003, "chapter_id": 24200, "verse_number": "५-१-४९-४", "content_sanskrit": "पुष्कराणि च सर्वाणि गयातीर्थमनुत्तमम् ।\nगोमतीकुण्डमाख्यातं नाम्ना धर्मसरस्तथा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004200004, "chapter_id": 24200, "verse_number": "५-१-४९-५", "content_sanskrit": "ख्यातं संगमजं तीर्थं शनेर्जन्मकथां शुभाम् ।\nच्यवनाश्रमे च या वार्ता तथा नागालये शुभे॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004200005, "chapter_id": 24200, "verse_number": "५-१-४९-६", "content_sanskrit": "पुरुषोत्तममहिमानं काले केन कथं भवेत् ।\nएतद्वेदितुमिच्छामि यत्ते मनसि वर्तते॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004200006, "chapter_id": 24200, "verse_number": "५-१-४९-७", "content_sanskrit": "सनत्कुमार उवाच ।\nशृणु व्यास महाभाग कथां पापहरां पराम् ।\nयस्मिन्काले यदा जाता महाकालवने शुभे॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004200007, "chapter_id": 24200, "verse_number": "५-१-४९-८", "content_sanskrit": "नास्ति वत्स महीपृष्ठे शिप्रायाः सदृशी नदी ।\nयस्यास्तीरे क्षणान्मुक्तिः किं चिरात्सेवनेन वै॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004200008, "chapter_id": 24200, "verse_number": "५-१-४९-९", "content_sanskrit": "वैकुण्ठे जायते शिप्रा ज्वरघ्नी च सुरालये ।\nमहाद्वारे च पापघ्नी पातालेऽमृतसंभवा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004200009, "chapter_id": 24200, "verse_number": "५-१-४९-१०", "content_sanskrit": "वाराहकल्पे वै प्रोक्ता विष्णुदेहेति नामतः ।\nशिप्रावंत्यां समाख्याता कामधेनुसमुद्भवा॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004200010, "chapter_id": 24200, "verse_number": "५-१-४९-११", "content_sanskrit": "व्यास उवाच ।\nविचित्रमिदमाख्यातं भवता ऋषिसत्तम ।\nवक्तुमर्हसि शिप्रायाः समासेन कथां शुभाम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004200011, "chapter_id": 24200, "verse_number": "५-१-४९-१२", "content_sanskrit": "सनत्कुमार उवाच ।\nब्राह्मं कपालमादाय भिक्षार्थं संचरन्महीम् ।\nमहादेवो विशुद्धात्मा सर्वलोकेषु सर्वतः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004200012, "chapter_id": 24200, "verse_number": "५-१-४९-१३", "content_sanskrit": "अप्राप्तभिक्षो भिक्षार्थी वैकुण्ठमगमद्विभुः ।\nगतश्चातिथ्यवेलायां भ्रममाणो यतस्ततः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004200013, "chapter_id": 24200, "verse_number": "५-१-४९-१४", "content_sanskrit": "लोकनिंदापरः क्रुद्धः क्षुधितो बहुवासरैः ।\nभिक्षां देहीति भो ब्रह्मन्क्षुधितोऽहं समाहितः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004200014, "chapter_id": 24200, "verse_number": "५-१-४९-१५", "content_sanskrit": "कपालं च करे कृत्वा इत्यु वाच पुनः पुनः ।\nगृह्यतां हर भिक्षां ते ददामीति हरिस्तदा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004200015, "chapter_id": 24200, "verse_number": "५-१-४९-१६", "content_sanskrit": "इत्युक्त्वा करमुद्यम्य तर्जन्यगुंलिमादधत् ।\nतदा रुद्रः समाध्मातस्त्रिशूलेनाहन द्रुषा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004200016, "chapter_id": 24200, "verse_number": "५-१-४९-१७", "content_sanskrit": "तदांगुलिसमुद्भूतं बहु सुस्रावशोणितम् ।\nतेनाशु पात्रं तत्पूर्णं शंकरस्य करे स्थितम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004200017, "chapter_id": 24200, "verse_number": "५-१-४९-१८", "content_sanskrit": "तदा उद्वेलिता सा वै धारा जाता समं ततः ।\nतत्र स्थाने समुद्भूता शिप्राऽसृग्धारसंभवा॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004200018, "chapter_id": 24200, "verse_number": "५-१-४९-१९", "content_sanskrit": "वैकुंठे चाभवत्सद्यो नदी त्रैलोक्यपावनी ।\nएवं शिप्रा सरिच्छ्रेष्ठा त्रिषु लोकेषु विश्रुता॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004200019, "chapter_id": 24200, "verse_number": "५-१-४९-२०", "content_sanskrit": "ज्वरघ्नी च यथा प्रोक्ता तथा व्यास ब्रवीम्यहम् ।\nयदा बाणासुरो दैत्यः कृष्णेन सह संयुगे॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004200020, "chapter_id": 24200, "verse_number": "५-१-४९-२१", "content_sanskrit": "योधयामास दैत्येंद्रो ह्यनिरुद्धप्र हेलनः ।\nसहस्रबाहुभिर्वीरो नानाप्रहरणोद्यतः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004200021, "chapter_id": 24200, "verse_number": "५-१-४९-२२", "content_sanskrit": "तस्मात्क्रुद्धो वासुदेवश्चक्रमादाय सत्वरः ।\nचिच्छेद बाहुसाहस्रं क्षुरप्रेणाशुगामिना॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004200022, "chapter_id": 24200, "verse_number": "५-१-४९-२३", "content_sanskrit": "स तदा भग्नसंकल्पश्छिन्नदोश्च व्रणार्दितः ।\nपराङ्मुखपरो भूत्वा शंकरं शरणं ययौ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004200023, "chapter_id": 24200, "verse_number": "५-१-४९-२४", "content_sanskrit": "तदागतं महादैत्यं समीपे भयविह्वलम् ।\nविलोक्य कृपयाविष्टो गते संग्राममूर्धनि॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004200024, "chapter_id": 24200, "verse_number": "५-१-४९-२५", "content_sanskrit": "छित्त्वा बाहुसहस्रं वै दैत्यराजस्य चाहवे ।\nक्रुद्धः कृष्णो महाबाहुः परसेनांतको वरः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004200025, "chapter_id": 24200, "verse_number": "५-१-४९-२६", "content_sanskrit": "स्थितो यत्राचलो व्यास तत्रागतो महेश्वरः ।\nवारयामास कृष्णं वै शरोघैश्च समाकिरन्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004200026, "chapter_id": 24200, "verse_number": "५-१-४९-२७", "content_sanskrit": "अन्योन्यं च समासाद्य कृत्वा युद्धं तु दारुणम् ।\nशस्त्रास्त्रैश्च महाघोरैः सर्वप्राणिभयंकरैः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004200027, "chapter_id": 24200, "verse_number": "५-१-४९-२८", "content_sanskrit": "वैष्णवास्त्रं तदा कृष्णः संदधे हरजिघांसया ।\nपाशुपतं च नामास्त्रं सर्वसंहारकारकम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004200028, "chapter_id": 24200, "verse_number": "५-१-४९-२९", "content_sanskrit": "संदधे वै तदा शंभुः कृष्णप्राणहरोत्सुकः ।\nहाहाकारस्तदा जातः सर्वलोकेषु श्रूयते॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004200029, "chapter_id": 24200, "verse_number": "५-१-४९-३०", "content_sanskrit": "मोहनास्त्रं पुनः कृष्णः शिवोपरि मुमोच ह ।\nतेनास्त्रेण तदा शंभुर्मोहितो देवमायया॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004200030, "chapter_id": 24200, "verse_number": "५-१-४९-३१", "content_sanskrit": "जृंभमाणः स्थितः संख्ये किंचित्कालं मुहुर्मुहुः ।\nलब्धसंज्ञः पुनर्जातो यदा रुद्रो महाहवे॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004200031, "chapter_id": 24200, "verse_number": "५-१-४९-३२", "content_sanskrit": "तदा क्रोधाभिभूतेन कृतो माहेश्वरो ज्वरः ।\nललाटफलकात्सद्यो वीरभद्रो महाबलः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004200032, "chapter_id": 24200, "verse_number": "५-१-४९-३३", "content_sanskrit": "त्रिनेत्रस्त्रिशिरा ह्रस्वस्त्रिपादो बर्कराकृतिः ।\nक्षुद्रो जटिलभस्मांगो महाव्याधिर्दुरत्ययः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004200033, "chapter_id": 24200, "verse_number": "५-१-४९-३४", "content_sanskrit": "कृष्णसेनां समासाद्य महादेवेन प्रेरितः ।\nप्राणिनां कदनं चक्रे सर्वेषां कृष्णसंगिनाम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004200034, "chapter_id": 24200, "verse_number": "५-१-४९-३५", "content_sanskrit": "पराङ्मुख्यपरा भग्ना ज्वराभिघातपीडिता ।\nबभूव सहसा व्यास सेना कृष्णेन पालिता॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004200035, "chapter_id": 24200, "verse_number": "५-१-४९-३६", "content_sanskrit": "तथाभूतां समालोक्य जृंभमाणा रुजार्दिताम् ।\nस्वसेनां भग्नसंकल्पां माहेशज्वरपीडिताम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004200036, "chapter_id": 24200, "verse_number": "५-१-४९-३७", "content_sanskrit": "ससर्ज वैष्णवं तापं कृष्णः परमकोपनः ।\nतेन सह वैष्णवेन माहेश्वरेण ज्वरेण च॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004200037, "chapter_id": 24200, "verse_number": "५-१-४९-३८", "content_sanskrit": "अन्योन्यमभवद्युद्धं घोरं घोरतरं महत् ।\nसंग्रामं बहुलं कृत्वा भग्नो माहेश्वरो ज्वरः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004200038, "chapter_id": 24200, "verse_number": "५-१-४९-३९", "content_sanskrit": "सर्वलोकेषु गत्वा वै न शांतिं प्रतिजग्मिवान् ।\nमहाकालवने रम्ये प्राप्तस्तेनाभिपीडितः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004200039, "chapter_id": 24200, "verse_number": "५-१-४९-४०", "content_sanskrit": "निमग्नोऽथ वै शिप्रायां ततः शांतिं परां ययौ ।\nदृष्ट्वा माहेश्वरं शांतं ज्वरं परमकोपनम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004200040, "chapter_id": 24200, "verse_number": "५-१-४९-४१", "content_sanskrit": "वैष्णवो ऽपि समासाद्य तस्यां मज्जनमाचरत् ।\nतस्याः प्रभावसन्नष्टौ ज्वरो हरिहरोद्भवौ॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004200041, "chapter_id": 24200, "verse_number": "५-१-४९-४२", "content_sanskrit": "तस्मात्सर्वेषु कालेषु ज्वरघ्नी साऽभवत्क्षणात् ।\nज्वराभिभूतास्तां प्राप्य जनाः परमदुःखिताः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004200042, "chapter_id": 24200, "verse_number": "५-१-४९-४३", "content_sanskrit": "निमज्जंति च शिप्रायां व्यासोषसि समाहिताः ।\nन तेषां बाधते पीडा ज्वरोद्भूता कदाचन॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004200043, "chapter_id": 24200, "verse_number": "५-१-४९-४४", "content_sanskrit": "सत्यमुक्तं तदा व्यास ब्रह्महरिहरेण च॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004200044, "chapter_id": 24200, "verse_number": "५-१-४९-४५", "content_sanskrit": "ये शृण्वंति कथां दिव्यां नराश्चैकाग्रमानसाः ।\nन तेषां जायते किंचिज्जवरसंतापजं भयम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]