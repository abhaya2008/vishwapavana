[{"id": 6000330000, "chapter_id": 10330, "verse_number": null, "content_sanskrit": "अथ एकोनत्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000330001, "chapter_id": 10330, "verse_number": null, "content_sanskrit": "उद्धव उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.001.m4a", "display_order": 2}, {"id": 6000330002, "chapter_id": 10330, "verse_number": "११-२९-१", "content_sanskrit": "सुदुश्चरामिमां मन्ये योगचर्यामनात्मनः।\nयथाऽञ्जसा पुमान् सिध्येत् तन्मे ब्रूह्यञ्जसाऽच्युत॥ ११/२९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णेनोद्धवं प्रति पूर्वोक्तस्य भक्तियोगस्य पुनरत्र संक्षेपतो निरूपणम्", "range": "१–३४"}]}, {"id": 6000330003, "chapter_id": 10330, "verse_number": "११-२९-२", "content_sanskrit": "प्रायशः पुण्डरीकाक्ष युञ्जतो योगिनो मनः।\nविषीदत्यसमाधानान्मौनसंयमकर्शितम्॥ ११/२९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.003.m4a", "display_order": 4}, {"id": 6000330004, "chapter_id": 10330, "verse_number": "११-२९-३", "content_sanskrit": "अथो त आनन्ददुघं पदाम्बुजं हंसाः श्रयेरन्नरविन्दलोचन।\nसुखं च विश्वेश्वर योगकर्मभिस्त्वन्माययाऽमी विहता न मानिनः॥ ११/२९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.004.m4a", "display_order": 5}, {"id": 6000330005, "chapter_id": 10330, "verse_number": "११-२९-४", "content_sanskrit": "किं चित्रमच्युत तवैतदशेषबन्धोर्दासेष्वनन्यशरणेषु यदात्मदस्त्वम्।\nयोऽरोचयश्च पशुपैः स्वयमीश्वराणां श्रीमत्किरीटमणिघट्टितपादपीठः॥ ११/२९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.005.m4a", "display_order": 6}, {"id": 6000330006, "chapter_id": 10330, "verse_number": "११-२९-५", "content_sanskrit": "तं त्वाऽखिलात्मदयितेश्वरमाश्रितानां सर्वार्थदं सुकृतविद् विसृजेत को नु।\nको वा भजेत् किमपि विस्मृतचित्तवृत्तिः किं वा न वेद तव पादरजोऽमृताम्भः॥ ११/२९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.006.m4a", "display_order": 7}, {"id": 6000330007, "chapter_id": 10330, "verse_number": "११-२९-६", "content_sanskrit": "नैवोपयान्त्यपचितिं कवयस्तवेश ब्रह्मादयोऽपि नतमूर्द्ध सदा स्मरन्तः।\nयोऽन्तर्बहिस्तनुभृतामशुभं विधुन्वन्नाचार्यचैत्यवपुषा स्वगतिं व्यनङ्क्षि॥ ११/२९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.007.m4a", "display_order": 8}, {"id": 6000330008, "chapter_id": 10330, "verse_number": null, "content_sanskrit": "श्री शुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.008.m4a", "display_order": 9}, {"id": 6000330009, "chapter_id": 10330, "verse_number": "११-२९-७", "content_sanskrit": "इत्युद्धवेनात्यनुरक्तचेतसा पृष्टो जगत्क्रीडनकः स्वशक्तिभिः।\nगृहीतमूर्तित्रय ईश्वरेश्वरो जगाद सप्रेम मनोहरस्मितः॥ ११/२९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.009.m4a", "display_order": 10}, {"id": 6000330010, "chapter_id": 10330, "verse_number": null, "content_sanskrit": "श्री भगवानुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.010.m4a", "display_order": 11}, {"id": 6000330011, "chapter_id": 10330, "verse_number": "११-२९-८", "content_sanskrit": "हन्त ते वर्णयिष्यामि मम धर्मान् सुमङ्गलान्।\nयान् शुद्धानाचरन् मर्त्यो मृत्युं जयति दुर्जयम्॥ ११/२९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.011.m4a", "display_order": 12}, {"id": 6000330012, "chapter_id": 10330, "verse_number": "११-२९-९", "content_sanskrit": "कुर्यात् सर्वाणि कर्माणि मदर्थं शनकैः स्मरन्।\nमय्यर्पितमनश्चित्तो मद्धर्मात्ममनोरतिः॥ ११/२९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.012.m4a", "display_order": 13}, {"id": 6000330013, "chapter_id": 10330, "verse_number": "११-२९-१०", "content_sanskrit": "देशान् पुण्यान् संश्रयेत मद्भक्तैः साधुभिः श्रितान्।\nदेवासुरमनुष्येषु मद्भक्ताचरितानि च॥ ११/२९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.013.m4a", "display_order": 14}, {"id": 6000330014, "chapter_id": 10330, "verse_number": "११-२९-११", "content_sanskrit": "पृथक् सत्रेण वा मह्यं मम यात्रामहोत्सवम्।\nकारयेन्नृत्यगीताद्यैर्महाराजविभूतिभिः॥ ११/२९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.014.m4a", "display_order": 15}, {"id": 6000330015, "chapter_id": 10330, "verse_number": "११-२९-१२", "content_sanskrit": "मामेव सर्वभूतेषु बहिरन्तरवस्थितम्।\nईक्षेतात्मनि चात्मानं यथा खममलाशयः॥ ११/२९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.015.m4a", "display_order": 16}, {"id": 6000330016, "chapter_id": 10330, "verse_number": "११-२९-१३", "content_sanskrit": "इति सर्वाणि भूतानि मद्भावेन महाद्युते।\nसभाजयेन्मन्यमानो ज्ञानं केवलमाश्रयन्॥ ११/२९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.016.m4a", "display_order": 17}, {"id": 6000330017, "chapter_id": 10330, "verse_number": "११-२९-१४", "content_sanskrit": "ब्राह्मणे पुल्कसे स्तेने ब्रह्मण्यर्के स्फुलिङ्गके।\nअक्रूरे क्रूरके चैव समदृक् पण्डितो मतः॥ ११/२९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.017.m4a", "display_order": 18}, {"id": 6000330018, "chapter_id": 10330, "verse_number": "११-२९-१५", "content_sanskrit": "नरेष्वभीक्ष्णं मद्भावः पुंसो भावयतोऽचिरात्।\nस्याद्वा माया तिरस्कारं साहंकाराऽपि याति हि॥ ११/२९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.018.m4a", "display_order": 19}, {"id": 6000330019, "chapter_id": 10330, "verse_number": "११-२९-१६", "content_sanskrit": "विसृज्य स्वयमात्मस्थां दृश्यव्रीडां च दैहिकीम्।\nप्रणमेद् दण्डवद् भूमावाश्वचण्डालगोखरम्॥ ११/२९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.019.m4a", "display_order": 20}, {"id": 6000330020, "chapter_id": 10330, "verse_number": "११-२९-१७", "content_sanskrit": "यावत् सर्वेषु भूतेषु मद्भावो नोपयुज्यते।\nतावदेवमुपासीत वाङ्मनःकायवृत्तिभिः॥ ११/२९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.020.m4a", "display_order": 21}, {"id": 6000330021, "chapter_id": 10330, "verse_number": "११-२९-१८", "content_sanskrit": "सर्वं ब्रह्मात्मकं तस्य विद्ययाऽऽत्ममनीषया।\nपरिपश्यन्ति च परं परमात्मानमच्युतम्॥ ११/२९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.021.m4a", "display_order": 22}, {"id": 6000330022, "chapter_id": 10330, "verse_number": "११-२९-१९", "content_sanskrit": "अयं हि सर्वकल्पानां सध्रीचीनो मतो मम।\nमद्भावः सर्वभूतेषु मनोवाक्कायकर्मभिः॥ ११/२९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.022.m4a", "display_order": 23}, {"id": 6000330023, "chapter_id": 10330, "verse_number": "११-२९-२०", "content_sanskrit": "नह्यङ्गोपक्रमे ध्वंसो न धूरस्योद्धवाण्वपि।\nमया व्यवसितं सम्यङ् निर्गुणत्वादनाशिषः॥ ११/२९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.023.m4a", "display_order": 24}, {"id": 6000330024, "chapter_id": 10330, "verse_number": "११-२९-२१", "content_sanskrit": "यो योऽपरो मनोधर्मः कल्पते निष्फलाय ते।\nतदायासो निरर्थः स्यान्नयादेरिव सत्तम॥ ११/२९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.024.m4a", "display_order": 25}, {"id": 6000330025, "chapter_id": 10330, "verse_number": "११-२९-२२", "content_sanskrit": "एषा बुद्धिमतां बुद्धिर्मनीषा च मनीषिणाम्।\nयत् सत्यमनृतेनेह मर्त्येनाप्नोति माऽमृतम्॥ ११/२९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.025.m4a", "display_order": 26}, {"id": 6000330026, "chapter_id": 10330, "verse_number": "११-२९-२३", "content_sanskrit": "एष तेऽभिहितः कृत्स्नो ब्रह्मवादस्य सङ्ग्रहः।\nसमासव्यासविधिना देवानामपि दुर्गमः॥ ११/२९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.026.m4a", "display_order": 27}, {"id": 6000330027, "chapter_id": 10330, "verse_number": "११-२९-२४", "content_sanskrit": "अभीक्ष्णशस्ते गदितं ज्ञानं विस्पष्टयुक्तिमत्।\nएतद् विज्ञाय मुच्येत पुरुषो नष्टसंशयः॥ ११/२९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.027.m4a", "display_order": 28}, {"id": 6000330028, "chapter_id": 10330, "verse_number": "११-२९-२५", "content_sanskrit": "सुविविक्तं तव प्रश्नं मयोक्तमपि धारयन्।\nसनातनं ब्रह्म गुह्यं परब्रह्माधिगच्छति॥ ११/२९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.028.m4a", "display_order": 29}, {"id": 6000330029, "chapter_id": 10330, "verse_number": "११-२९-२६", "content_sanskrit": "य एतन्मम भक्तेषु सम्प्रदद्यात् सुपुष्कलम्।\nतस्याहं ब्रह्मदायस्य ददाम्यात्मानमात्मना॥ ११/२९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.029.m4a", "display_order": 30}, {"id": 6000330030, "chapter_id": 10330, "verse_number": "११-२९-२७", "content_sanskrit": "य एतत् समधीयीत पवित्रं परमं शुचि।\nस पूयेताहरहर्मां ज्ञानदीपेन दर्शयन्॥ ११/२९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.030.m4a", "display_order": 31}, {"id": 6000330031, "chapter_id": 10330, "verse_number": "११-२९-२८", "content_sanskrit": "य एतच्छ्रद्धया नित्यमव्यग्रं शृणुयान्नरः।\nमयि भक्तिं परां कुर्वन् कर्मभिर्न स बध्यते॥ ११/२९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.031.m4a", "display_order": 32}, {"id": 6000330032, "chapter_id": 10330, "verse_number": "११-२९-२९", "content_sanskrit": "अप्युद्धव त्वया ब्रह्म सखे समुपधारितम्।\nअपि ते विगतो मोहः शोकश्चासौ मनोभवः॥ ११/२९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.032.m4a", "display_order": 33}, {"id": 6000330033, "chapter_id": 10330, "verse_number": "११-२९-३०", "content_sanskrit": "नैतत् त्वया दाम्भिकाय नास्तिकाय शठाय च।\nअशुश्रूषोरभक्ताय दुर्विनीताय दीयताम्॥ ११/२९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.033.m4a", "display_order": 34}, {"id": 6000330034, "chapter_id": 10330, "verse_number": "११-२९-३१", "content_sanskrit": "एतैर्दोषैर्विहीनाय ब्रह्मण्याय प्रियाय च।\nसाधवे शुचये ब्रूयाद् भक्तिः स्याच्छूद्रयोषिताम्॥ ११/२९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.034.m4a", "display_order": 35}, {"id": 6000330035, "chapter_id": 10330, "verse_number": "११-२९-३२", "content_sanskrit": "नैतद् विज्ञाय जिज्ञासोर्ज्ञातव्यमवशिष्यते।\nपीत्वा पीयूषममृतं पातव्यं नावशिष्यते॥ ११/२९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.035.m4a", "display_order": 36}, {"id": 6000330036, "chapter_id": 10330, "verse_number": "११-२९-३३", "content_sanskrit": "ज्ञाने कर्मणि योगे च वार्तायां दण्डधारणे।\nयावानर्थो नृणां तात तावान् मोहश्चतुर्विधः॥ ११/२९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.036.m4a", "display_order": 37}, {"id": 6000330037, "chapter_id": 10330, "verse_number": "११-२९-३४", "content_sanskrit": "मर्त्यो यदा त्यक्तसमस्तकर्मा निवेशितात्मा च चिकीर्षितो मे।\nतदाऽमृतत्वं प्रतिपद्यमानो मयाऽऽत्मभूयाय च कल्पतेऽसौ॥ ११/२९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.037.m4a", "display_order": 38}, {"id": 6000330038, "chapter_id": 10330, "verse_number": null, "content_sanskrit": "श्री शुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.038.m4a", "display_order": 39}, {"id": 6000330039, "chapter_id": 10330, "verse_number": "११-२९-३५", "content_sanskrit": "स एवमादर्शितयोगमार्गस्तदोत्तमश्लोकवचो निशम्य।\nबद्धाञ्जलिः प्रीत्युपरुद्धकण्ठो न किञ्चिदूचेऽश्रुपरिप्लुताक्षः॥ ११/२९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.039.m4a", "display_order": 40, "topics": [{"text": "श्रीकृष्णोपदेशेन प्राप्तविज्ञानस्य उद्धवस्य तं स्तुत्वा तदाज्ञया बदरिकाश्रमप्रवेशः", "range": "३५–४५"}]}, {"id": 6000330040, "chapter_id": 10330, "verse_number": "११-२९-३६", "content_sanskrit": "विष्टभ्य चित्तं प्रणयेन पूर्णं धैर्येण राजन् बहुमन्यमानः।\nकृताञ्जलिः प्राह यदुप्रवीरं शीर्ष्णा स्पृशंस्तच्चरणारविन्दम्॥ ११/२९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.040.m4a", "display_order": 41}, {"id": 6000330041, "chapter_id": 10330, "verse_number": null, "content_sanskrit": "उद्धव उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.041.m4a", "display_order": 42}, {"id": 6000330042, "chapter_id": 10330, "verse_number": "११-२९-३७", "content_sanskrit": "विद्रावितो मोहमयोऽन्धकारो य आश्रितो मे तव सन्निधानात्।\nविभावसोः किन्नु समीपगस्य शीतं तमोऽभिप्रभवत्यजाद्य॥ ११/२९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.042.m4a", "display_order": 43}, {"id": 6000330043, "chapter_id": 10330, "verse_number": "११-२९-३८", "content_sanskrit": "प्रवर्धिता मे भवताऽनुकम्पिता दत्तो हि विज्ञानमयः प्रदीपः।\nहित्वा कृतज्ञस्तव पादमूलं कोऽज्ञः समीयाच्छरणं त्वदन्यम्॥ ११/२९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.043.m4a", "display_order": 44}, {"id": 6000330044, "chapter_id": 10330, "verse_number": "११-२९-३९", "content_sanskrit": "वृक्णश्च मे सुदृढः स्नेहपाशो दाशार्हवृष्ण्यन्धकसात्वतेषु।\nप्रसारितः सृष्टिविवृद्धये त्वया स्वमायया ह्यात्मसुबोधहेतिना॥ ११/२९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.044.m4a", "display_order": 45}, {"id": 6000330045, "chapter_id": 10330, "verse_number": "११-२९-४०", "content_sanskrit": "नमोऽस्तु ते महायोगिन् प्रपन्नमनुशाधि माम्।\nयथा त्वच्चरणाम्भोजे रतिः स्यादनपायिनी॥ ११/२९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.045.m4a", "display_order": 46}, {"id": 6000330046, "chapter_id": 10330, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.046.m4a", "display_order": 47}, {"id": 6000330047, "chapter_id": 10330, "verse_number": "११-२९-४१", "content_sanskrit": "गच्छोद्धव मयाऽऽदिष्टो बदर्याख्यं मदाश्रमम्।\nतत्र मत्पादतीर्थोदैः स्नानोपस्पर्शनैः शुचिः॥ ११/२९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.047.m4a", "display_order": 48}, {"id": 6000330048, "chapter_id": 10330, "verse_number": "११-२९-४२", "content_sanskrit": "ईक्षयाऽलकनन्दाया विधूताशेषकल्मषः।\nवसानो वल्कलान्यङ्ग वन्यभुक् सुखनिःस्पृहः॥ ११/२९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.048.m4a", "display_order": 49}, {"id": 6000330049, "chapter_id": 10330, "verse_number": "११-२९-४३", "content_sanskrit": "तितिक्षुर्द्वन्द्वमात्राणां सुशीलः संयतेन्द्रियः।\nशान्तः समाहितधिया ज्ञानविज्ञानसंयुतः॥ ११/२९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.049.m4a", "display_order": 50}, {"id": 6000330050, "chapter_id": 10330, "verse_number": "११-२९-४४", "content_sanskrit": "मत्तोऽनुशिक्षितं यत्ते विविक्तमनुभावयन्।\nमय्यावेशितवाक्चित्तो मद्धर्मनिरतो भव॥ ११/२९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.050.m4a", "display_order": 51}, {"id": 6000330051, "chapter_id": 10330, "verse_number": "११-२९-४५", "content_sanskrit": "अतिव्रज्य गतीस्तिस्रो मामेष्यसि ततः परम्॥ ११/२९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.051.m4a", "display_order": 52}, {"id": 6000330052, "chapter_id": 10330, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.052.m4a", "display_order": 53}, {"id": 6000330053, "chapter_id": 10330, "verse_number": "११-२९-४६", "content_sanskrit": "स एवमुक्तो हरिमेधसोद्धवः प्रदक्षिणं तं परिवृत्य पादयोः।\nशिरो निधायाश्रुकलाभिरार्द्रधीः सिञ्चन् पदद्वन्द्वमथोऽनुचक्रमे॥ ११/२९/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.053.m4a", "display_order": 54}, {"id": 6000330054, "chapter_id": 10330, "verse_number": "११-२९-४७", "content_sanskrit": "सुदुस्त्यजस्नेहवियोगकातरो न शक्नुवंस्तं परिहर्तुमातुरः।\nकृच्छ्रं ययौ मूर्धनि भर्तृपादुके बिभ्रन्नमस्कृत्य ययौ पुनःपुनः॥ ११/२९/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.054.m4a", "display_order": 55}, {"id": 6000330055, "chapter_id": 10330, "verse_number": "११-२९-४८", "content_sanskrit": "ततस्तमन्तर्हृदि सन्निवेश्य गतो महाभागवतो विशालाम्।\nयथोपदिष्टं जगदेकबन्धुना तपः समास्थाय हरेरगाद् गतिम्॥ ११/२९/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.055.m4a", "display_order": 56}, {"id": 6000330056, "chapter_id": 10330, "verse_number": "११-२९-४९", "content_sanskrit": "यदेतदानन्दसमुद्रसम्भृतं ज्ञानामृतं भागवताय भाषितम्।\nकृष्णेन योगेश्वरसेविताङ्घ्रिणा सच्छ्रद्धयाऽऽसेव्य जगद् विमुच्यते॥ ११/२९/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.056.m4a", "display_order": 57}, {"id": 6000330057, "chapter_id": 10330, "verse_number": "११-२९-५०", "content_sanskrit": "भवभयमपहन्तुं ज्ञानविज्ञानसारं निगमकुमुददभ्रं भृङ्गवद् वेद्यसारम्।\nअमृतमुदधिकल्पं पाययन् भृत्यवर्गान् पुरुषऋषभमाद्यं विष्णुसंज्ञं नतोऽस्मि॥ ११/२९/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_029/BhP_11.029.057.m4a", "display_order": 58}, {"id": 6000330058, "chapter_id": 10330, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे एकोनत्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]