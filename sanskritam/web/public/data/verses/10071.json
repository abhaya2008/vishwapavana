[{"id": 6000071000, "chapter_id": 10071, "verse_number": null, "content_sanskrit": "अथ सप्तमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000071001, "chapter_id": 10071, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.001.m4a", "display_order": 2}, {"id": 6000071002, "chapter_id": 10071, "verse_number": "४-७-१", "content_sanskrit": "अथ देवगणाः सर्वे रुद्रानीकैः पराजिताः।\nशूलपट्टिशनिस्‍त्रिंशगदापरिघमुद्गरैः॥ ४/७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.002.m4a", "display_order": 3, "topics": [{"text": "देवैर्विनिवेदितदक्षनाशेन विरिञ्चिना दक्षादिजीवनार्थ रुद्रं सान्‍त्वयितुं देवैः सह कैलासगमनम्", "range": "१–८"}]}, {"id": 6000071003, "chapter_id": 10071, "verse_number": "४-७-२", "content_sanskrit": "संच्छिन्नभिन्नसर्वाङ्गाः सर्त्विक्सभ्याः समाकुलाः।\nस्वयंभुवे नमस्कृत्य कार्त्स्न्येनैतन्न्यवेदयन्॥ ४/७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.003.m4a", "display_order": 4}, {"id": 6000071004, "chapter_id": 10071, "verse_number": "४-७-३", "content_sanskrit": "उपलभ्य पुरैवैतद् भगवानब्जसम्भवः।\nनारायणश्च विश्वात्मा न कस्याध्वरमीयतुः॥ ४/७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.004.m4a", "display_order": 5}, {"id": 6000071005, "chapter_id": 10071, "verse_number": "४-७-४", "content_sanskrit": "तदाकर्ण्य विभुः प्राह तेजीयसि कृतागसाम्।\nक्षेमाय भूयसे भूयान्न प्रायेण बुभूषताम्॥ ४/७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.005.m4a", "display_order": 6}, {"id": 6000071006, "chapter_id": 10071, "verse_number": "४-७-५", "content_sanskrit": "अथापि यूयं कृतकिल्बिषा भवे ये बर्हिषो भागभाजं परादुः।\nप्रसादयध्वं परिशुद्धचेतसा क्षिप्रप्रसादं प्रगृहीताङ्घ्रिपद्माः॥ ४/७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.006.m4a", "display_order": 7}, {"id": 6000071007, "chapter_id": 10071, "verse_number": "४-७-६", "content_sanskrit": "आशासाना जीवितमध्वरस्य लोकः सपालः कुपिते न यस्मिन्।\nतमाशु देवं प्रियया विहीनं क्षमापयध्वं हृदि विद्धं दुरुक्तैः॥ ४/७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.007.m4a", "display_order": 8}, {"id": 6000071008, "chapter_id": 10071, "verse_number": "४-७-७", "content_sanskrit": "नाहं न यज्ञो न च यूयमन्ये ये देहभाजो मुनयश्च तत्त्वम्।\nविदुः प्रमाणं बलवीर्ययोर्वा तस्यात्मतन्त्रस्य क उद्विधित्सेत्॥ ४/७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.008.m4a", "display_order": 9}, {"id": 6000071009, "chapter_id": 10071, "verse_number": "४-७-८", "content_sanskrit": "स इत्थमादिश्य सुरानजस्तु तैः समन्वितः पितृभिः सप्रजेशैः।\nययौ स्वधिष्ण्यान्निलयं पुरद्विषः कैलासमद्रिप्रवरं प्रियं प्रभोः॥ ४/७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.009.m4a", "display_order": 10}, {"id": 6000071010, "chapter_id": 10071, "verse_number": "४-७-९", "content_sanskrit": "जन्मौषधतपोमन्त्रयोगसिद्धैर्नरेतरैः।\nजुष्टं किन्नरगन्धर्वैरप्सरोभिर्वृतं सदा॥ ४/७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.010.m4a", "display_order": 11, "topics": [{"text": "कैलास-वर्णनम्", "range": "९–३३"}]}, {"id": 6000071011, "chapter_id": 10071, "verse_number": "४-७-१०", "content_sanskrit": "नानामणिमयैः शृृङ्गैर्नानाधातुविचित्रितैः।\nनानाद्रुमलतागुल्मैर्नानामृगगणावृतैः॥ ४/७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.011.m4a", "display_order": 12}, {"id": 6000071012, "chapter_id": 10071, "verse_number": "४-७-११", "content_sanskrit": "नानाऽमलप्रस्रवणैर्नानाकन्दरसानुभिः।\nरमणं विहरन्तीनां रमणैः सिद्धयोषिताम्॥ ४/७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.012.m4a", "display_order": 13}, {"id": 6000071013, "chapter_id": 10071, "verse_number": "४-७-१२", "content_sanskrit": "मयूरकेकाभिरुतं मदान्धालिविमूर्च्छितम्।\nप्लावितै रक्तकण्ठानां कूजितैश्च पतत्रिणाम्॥ ४/७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.013.m4a", "display_order": 14}, {"id": 6000071014, "chapter_id": 10071, "verse_number": "४-७-१३", "content_sanskrit": "आह्वयन्तमिवोद्धस्तैर्द्विजैः कामदुघैर्द्रुमैः।\nव्रजन्तमिव मातङ्गैर्गृणन्तमिव निर्झरैः॥ ४/७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.014.m4a", "display_order": 15}, {"id": 6000071015, "chapter_id": 10071, "verse_number": "४-७-१४", "content_sanskrit": "मन्दारैः पारिजातैश्च सरलैश्चोपशोभितम्।\nतमालैः सालतालैश्च कोविदारासनार्जुनैः॥ ४/७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.015.m4a", "display_order": 16}, {"id": 6000071016, "chapter_id": 10071, "verse_number": "४-७-१५", "content_sanskrit": "चूतैः कदम्बनीपैश्च नागपुन्नागचम्पकैः।\nपाटलाशोकबकुलैः कुन्दैः कुरबकैरपि॥ ४/७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.016.m4a", "display_order": 17}, {"id": 6000071017, "chapter_id": 10071, "verse_number": "४-७-१६", "content_sanskrit": "सुवर्णशतपत्रैश्च वीररेणुकजातिभिः।\nकुब्जकैर्मल्लिकाभिश्च माधवीभिश्च मण्डितम्॥ ४/७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.017.m4a", "display_order": 18}, {"id": 6000071018, "chapter_id": 10071, "verse_number": "४-७-१७", "content_sanskrit": "पनसोदुम्बराश्वत्थप्लक्षन्यग्रोधहिङ्गुभिः।\nभूर्जैरोषधिभिः पूगैः राजपूगैश्च जम्बुभिः॥ ४/७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.018.m4a", "display_order": 19}, {"id": 6000071019, "chapter_id": 10071, "verse_number": "४-७-१८", "content_sanskrit": "काश्मर्याम्रातकाम्राद्यैः प्रियालमधुकेङ्गुदैः।\nद्रुमजातिभिरन्यैश्च राजितं वेणुकीचकैः॥ ४/७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.019.m4a", "display_order": 20}, {"id": 6000071020, "chapter_id": 10071, "verse_number": "४-७-१९", "content_sanskrit": "कुमुदोत्पलकह्लारशतपत्रवनर्द्धिभिः।\nनलिनीषु कलं कूजत्खगवृन्दोपशोभितम्॥ ४/७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.020.m4a", "display_order": 21}, {"id": 6000071021, "chapter_id": 10071, "verse_number": "४-७-२०", "content_sanskrit": "मृगैः शाखामृगैः क्रोडैर्मृगेन्द्रैर्ऋक्षशल्यकैः।\nगवयैः शरभैर्व्याघ्रै रुरुभिर्महिषादिभिः॥ ४/७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.021.m4a", "display_order": 22}, {"id": 6000071022, "chapter_id": 10071, "verse_number": "४-७-२१", "content_sanskrit": "कर्णौर्णैकपदाश्वास्यैर्निर्जुष्टं मृगनाभिभिः।\nकदलीखण्डसंरुद्धनलिनीपुलिनश्रियम्॥ ४/७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.022.m4a", "display_order": 23}, {"id": 6000071023, "chapter_id": 10071, "verse_number": "४-७-२२", "content_sanskrit": "पर्यस्तं नन्दया सत्याः स्नानपुण्यतमोदया।\nविलोक्य भूतेशगिरिं विबुधा विस्मयं ययुः॥ ४/७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.023.m4a", "display_order": 24}, {"id": 6000071024, "chapter_id": 10071, "verse_number": "४-७-२३", "content_sanskrit": "ददृशुस्तत्र ते रम्यामलकां नाम वै पुरीम्।\nवनं सौगन्धिकं चापि तत्र तन्नाम पङ्कजम्॥ ४/७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.024.m4a", "display_order": 25}, {"id": 6000071025, "chapter_id": 10071, "verse_number": "४-७-२४", "content_sanskrit": "नन्दा चालकनन्दा च सरितौ बाह्यतः पुरः।\nतीर्थपादपदाम्भोजरजसाऽतीव पावने॥ ४/७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.025.m4a", "display_order": 26}, {"id": 6000071026, "chapter_id": 10071, "verse_number": "४-७-२५", "content_sanskrit": "ययोः सुरस्‍त्रियः क्षत्तरवरुह्य स्वधिष्ण्यतः।\nक्रीडन्ति पुंसः सिञ्चन्त्यो विगाह्य रतिकर्शिताः॥ ४/७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.026.m4a", "display_order": 27}, {"id": 6000071027, "chapter_id": 10071, "verse_number": "४-७-२६", "content_sanskrit": "ययोस्तत्स्नानविभ्रष्टकुचकुङ्कुमपिञ्जरम्।\nवितृषोऽपि पिबन्त्यम्भः पाययन्तो गजा गजीः॥ ४/७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.027.m4a", "display_order": 28}, {"id": 6000071028, "chapter_id": 10071, "verse_number": "४-७-२७", "content_sanskrit": "तारहेममहारत्नविमानशतसङ्कुलाम्।\nजुष्टां पुण्यजनस्‍त्रीर्भियथा खं सतडिद्घनम्॥ ४/७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.028.m4a", "display_order": 29}, {"id": 6000071029, "chapter_id": 10071, "verse_number": "४-७-२८", "content_sanskrit": "हित्वा यक्षेश्वरपुरीं वनं सौगन्धिकं च तत्।\nद्रुमैः कामदुघैर्हृद्यं चित्रमाल्यफलच्छदैः॥ ४/७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.029.m4a", "display_order": 30}, {"id": 6000071030, "chapter_id": 10071, "verse_number": "४-७-२९", "content_sanskrit": "रक्तकण्ठखगानीकस्वरमण्डितषट्पदम्।\nकलहंसकुलप्रेष्ठखरदण्डजलाशयम्॥ ४/७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.030.m4a", "display_order": 31}, {"id": 6000071031, "chapter_id": 10071, "verse_number": "४-७-३०", "content_sanskrit": "वनकुञ्जरसंघृष्टहरिचन्दनवायुना।\nअधि पुण्यजनस्‍त्रीणां मुहुरुन्मथयन्मनः॥ ४/७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.031.m4a", "display_order": 32}, {"id": 6000071032, "chapter_id": 10071, "verse_number": "४-७-३१", "content_sanskrit": "वैडूर्यकृतसोपाना वाप्य उत्पलमालिनीः।\nव्याप्तं किंपुरुषैर्दृष्ट्वा त आराद् ददृशुर्वटम्॥ ४/७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.032.m4a", "display_order": 33}, {"id": 6000071033, "chapter_id": 10071, "verse_number": "४-७-३२", "content_sanskrit": "स योजनशतोत्सेधः पादोनविटपायतः।\nपर्यग्गतामलच्छायो निर्नीडस्तापवर्जितः॥ ४/७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.033.m4a", "display_order": 34}, {"id": 6000071034, "chapter_id": 10071, "verse_number": "४-७-३३", "content_sanskrit": "तस्मिन् महायोगमये मुमुक्षुशरणे सुराः।\nददृशुः शिवमासीनं त्यक्तामर्षमिवान्तकम्॥ ४/७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.034.m4a", "display_order": 35}, {"id": 6000071035, "chapter_id": 10071, "verse_number": "४-७-३४", "content_sanskrit": "सनन्दनादिभिः सिद्धैः शान्तैः संशान्तविग्रहम्।\nउपास्यमानं सख्या च भर्त्रा गुह्यकरक्षसाम्॥ ४/७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.035.m4a", "display_order": 36, "topics": [{"text": "शिववर्णनम्", "range": "३४–४०"}]}, {"id": 6000071036, "chapter_id": 10071, "verse_number": "४-७-३५", "content_sanskrit": "विद्यातपोयोगपथमास्थितं तदधीश्वरम्।\nध्यायन्तं विश्वसुहृदं वात्सल्याल्लोकमङ्गलम्॥ ४/७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.036.m4a", "display_order": 37}, {"id": 6000071037, "chapter_id": 10071, "verse_number": "४-७-३६", "content_sanskrit": "लिङ्गं च तापसाभीष्टं भस्मदण्डजटाजिनम्।\nअङ्गेन सन्ध्याभ्ररुचा चन्द्रलेखां च विभ्रतम्॥ ४/७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.037.m4a", "display_order": 38}, {"id": 6000071038, "chapter_id": 10071, "verse_number": "४-७-३७", "content_sanskrit": "उपविष्टं दर्भमय्यां बृस्यां ब्रह्म सनातनम्।\nनारदाय प्रवोचन्तं पृच्छते शृृण्वतां सताम्॥ ४/७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.038.m4a", "display_order": 39}, {"id": 6000071039, "chapter_id": 10071, "verse_number": "४-७-३८", "content_sanskrit": "कृत्वोरौ दक्षिणे सव्यं पादपद्मं च जानुनि।\nबाहुं प्रकोष्ठेऽक्षमालामासीनं तर्कमुद्रया॥ ४/७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.039.m4a", "display_order": 40}, {"id": 6000071040, "chapter_id": 10071, "verse_number": "४-७-३९", "content_sanskrit": "तं ब्रह्मनिर्वाणसमाधिमास्थितं व्यपाश्रितं गिरिशं योगकक्ष्याम्।\nसलोकपाला मुनयो मनूनामाद्यं मनुं प्राञ्जलयः प्रणेमुः॥ ४/७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.040.m4a", "display_order": 41}, {"id": 6000071041, "chapter_id": 10071, "verse_number": "४-७-४०", "content_sanskrit": "स तूपलभ्यागतमात्मयोनिं सुरासुरेशैरभिवन्दिताङ्घ्रिः।\nउत्थाय चक्रे शिरसाऽभिवन्दनं महत्तमोऽर्कस्य यथैव विष्णोः॥ ४/७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.041.m4a", "display_order": 42}, {"id": 6000071042, "chapter_id": 10071, "verse_number": "४-७-४१", "content_sanskrit": "तथाऽपरे सिद्धगणा महर्षिभिर्ये वै समन्तादनु नीललोहितम्।\nनमस्कृतः प्राह शशाङ्कशेखरं कृतप्रणामं प्रहसन्निवात्मभूः॥ ४/७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.042.m4a", "display_order": 43, "topics": [{"text": "ब्रह्मष्णा रुद्रस्तुतिः", "range": "४१–४९"}]}, {"id": 6000071043, "chapter_id": 10071, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.043.m4a", "display_order": 44}, {"id": 6000071044, "chapter_id": 10071, "verse_number": "४-७-४२", "content_sanskrit": "जाने त्वामीश विश्वस्य जगतो योनिबीजयोः।\nशक्तेः शिवस्य च परं यत् तद् ब्रह्म निरन्तरम्॥ ४/७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.044.m4a", "display_order": 45}, {"id": 6000071045, "chapter_id": 10071, "verse_number": "४-७-४३", "content_sanskrit": "त्वमेव भगवन्नेतच्छिवशक्त्योः स्वरूपयोः।\nविश्वं सृजसि पास्यत्सि क्रीडयोर्णपदो यथा॥ ४/७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.045.m4a", "display_order": 46}, {"id": 6000071046, "chapter_id": 10071, "verse_number": "४-७-४४", "content_sanskrit": "त्वमेव धर्मार्थदुघाऽभिपत्तये दक्षेण सूत्रेण विसर्जिताध्वरः।\nत्वयैव लोकेऽवसिताश्च सेतवो यान् ब्राह्मणाः श्रद्दधते धृतव्रताः॥ ४/७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.046.m4a", "display_order": 47}, {"id": 6000071047, "chapter_id": 10071, "verse_number": "४-७-४५", "content_sanskrit": "त्वं कर्मणां मङ्गल मङ्गलानां कर्तासि लोके तनुषे स्वयं फलम्।\nअमङ्गलानां च तमिस्रमुल्बणं विपर्ययः केनचिदेव कस्यचित्॥ ४/७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.047.m4a", "display_order": 48}, {"id": 6000071048, "chapter_id": 10071, "verse_number": "४-७-४६", "content_sanskrit": "न वै सतां त्वच्चरणार्पितात्मनां भूतेषु सर्वेष्वभिपश्यतां तव।\nभूतानि चात्मन्यपृथग् दिदृक्षतां प्रायेण रोषोऽभिभवेद् यथा पशोः॥ ४/७/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.048.m4a", "display_order": 49}, {"id": 6000071049, "chapter_id": 10071, "verse_number": "४-७-४७", "content_sanskrit": "पृथग्धियः कर्मदृशो दुराशयाः परोदयेनार्पितहृद्रुजोऽनिशम्।\nपरान् दुरुक्तैर्वितुदन्त्यरुंतुदास्तान् मा वधीर्देव भवान् पृथग्विधान्॥ ४/७/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.049.m4a", "display_order": 50}, {"id": 6000071050, "chapter_id": 10071, "verse_number": "४-७-४८", "content_sanskrit": "येऽस्मिन् यदा पुष्करनाभमायया दुर्लङ्घ्यया स्पृष्टधियः पृथग्दृशः।\nकुर्वन्ति तत्र ह्यनुकम्पया कृपां न साधवो दैवबलात्कृताः कथम्॥ ४/७/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.050.m4a", "display_order": 51}, {"id": 6000071051, "chapter_id": 10071, "verse_number": "४-७-४९", "content_sanskrit": "भवान् हि पुंसः परमस्य मायया दुरन्तयाऽस्पृष्टमतिः समस्तदृक्।\nतया हतात्मस्वनुकर्मचेतस्स्वनुग्रहं कर्तुमिहार्हति प्रभो॥ ४/७/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.051.m4a", "display_order": 52}, {"id": 6000071052, "chapter_id": 10071, "verse_number": "४-७-५०", "content_sanskrit": "कुर्वध्वरस्योद्धरणं हतस्य भो त्वयाऽसमाप्तस्य मनोः प्रजापतेः।\nन यत्र भागं तव भागिनो ददुः कुस्पर्धिनो येन मखो निनीयते॥ ४/७/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.052.m4a", "display_order": 53, "topics": [{"text": "दक्षादीनां जीवनप्रार्थना", "range": "५०–५३"}]}, {"id": 6000071053, "chapter_id": 10071, "verse_number": "४-७-५१", "content_sanskrit": "जीवताद् यजमानोऽयं प्रपद्येताक्षिणी भगः।\nभृगोः श्मश्रूणि रोहन्तु पूष्णो दन्ताश्च पूर्ववत्॥ ४/७/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.053.m4a", "display_order": 54}, {"id": 6000071054, "chapter_id": 10071, "verse_number": "४-७-५२", "content_sanskrit": "देवानां भग्नगात्राणामृत्विजां चायुधाश्मभिः।\nभवताऽनुगृहीतानाम् आशु मन्यो त्वनातुरम्॥ ४/७/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.054.m4a", "display_order": 55}, {"id": 6000071055, "chapter_id": 10071, "verse_number": "४-७-५३", "content_sanskrit": "एष ते रुद्र भागोऽस्तु यदुच्छिष्टोऽध्वरस्य वै।\nयज्ञस्ते रुद्र भागेन कल्पतामद्य यज्ञहन्॥ ४/७/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_007/BhP_04.007.055.m4a", "display_order": 56}, {"id": 6000071056, "chapter_id": 10071, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे सप्तमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]