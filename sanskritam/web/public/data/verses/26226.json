[{"id": 7006226000, "chapter_id": 26226, "verse_number": "२-५४-१", "content_sanskrit": "जैमिनिरुवाच क्रोधाग्निमेनं विप्रेन्द्र सद्यः संहर्त्तुमर्हसि ।\nनो चेदकाले लोकोऽयं सकलस्तेन दह्यते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006226001, "chapter_id": 26226, "verse_number": "२-५४-२", "content_sanskrit": "दृष्टस्ते महिमानेन व्याप्तमासीच्चराचरम् ।\nक्षमस्व संहर क्रोधं नमस्ते विप्रपुङ्गव ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006226002, "chapter_id": 26226, "verse_number": "२-५४-३", "content_sanskrit": "एवं संस्तूयमानस्तु भगवान्कपिलो मुनिः ।\nतूर्णमेव क्षयं निन्ये क्रोधाग्निमतिभैरवम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006226003, "chapter_id": 26226, "verse_number": "२-५४-४", "content_sanskrit": "ततः प्रशान्तमभवज्जगत्सर्वं चराचरम् ।\nदेवास्तपस्विनश्चैव बभूवुर्विगतज्वराः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006226004, "chapter_id": 26226, "verse_number": "२-५४-५", "content_sanskrit": "एतस्मिन्नेव काले तु भगवान्नारदो मुनिः ।\nअयोध्या मगमद्राजन्देवलोकाद्यदृच्छया ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006226005, "chapter_id": 26226, "verse_number": "२-५४-६", "content_sanskrit": "तमागतमभिप्रेक्ष्य नारदं सगरस्तदा ।\nअर्घ्यपाद्यादिभिः सम्यक्पूजयामास शास्त्रतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006226006, "chapter_id": 26226, "verse_number": "२-५४-७", "content_sanskrit": "परिगृह्य च तत्पूजामासीनः परमासने ।\nनारदो राजशार्दूलमिदं वचनमब्रवीत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006226007, "chapter_id": 26226, "verse_number": "२-५४-८", "content_sanskrit": "नारद उवाच हयसंचारणार्थाय संप्रयातास्तवात्मजाः ।\nब्रह्मदण्डहताः सर्वे विनष्टा नृपसत्तम ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006226008, "chapter_id": 26226, "verse_number": "२-५४-९", "content_sanskrit": "संरक्ष्यमाणस्तैः सर्वैर्हयस्ते यज्ञियो नृप ।\nकेनाप्य लक्षितः क्वापि नीतो विधिवशाद्दिवि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006226009, "chapter_id": 26226, "verse_number": "२-५४-१०", "content_sanskrit": "ततो विनष्टं तुरगं विचिन्वन्तो महीतले ।\nप्रालभन्त न ते क्वापि तत्प्रवृत्तिं चिरान्नृप ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006226010, "chapter_id": 26226, "verse_number": "२-५४-११", "content_sanskrit": "ततोऽवनेरधस्तेऽश्वं विचेतुं कृतनिश्चयाः ।\nसागरास्ते समारभ्य प्रचख्नुर्वसुधातलम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006226011, "chapter_id": 26226, "verse_number": "२-५४-१२", "content_sanskrit": "खनन्तो वसुधा मश्वं पाताले ददृशुर्नृप ।\nसमीपे तस्य योगीन्द्रं कपिलं चमहामुनिम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006226012, "chapter_id": 26226, "verse_number": "२-५४-१३", "content_sanskrit": "तं दृष्ट्वा पापकर्माणस्ते सर्वे कालचोदिताः ।\nकपिलं कोपयामासुरश्वहर्त्तायमित्यलम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006226013, "chapter_id": 26226, "verse_number": "२-५४-१४", "content_sanskrit": "ततस्तत्क्रोधसंभूतनेत्राग्नेर्दहतो दिशः ।\nइन्धनीभूतदेहास्ते पुत्राः संक्षयमागताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006226014, "chapter_id": 26226, "verse_number": "२-५४-१५", "content_sanskrit": "क्रूराः पापसमाचाराः सर्वलोकोपरोधकाः ।\nयतस्ते तेन राजेन्द्र न शोकं कर्तुमर्हसि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006226015, "chapter_id": 26226, "verse_number": "२-५४-१६", "content_sanskrit": "स त्वं धैर्यधनो भूत्वा भवित व्यतयात्मनः ।\nनष्टं मृतमतीतं च नानुशोचन्ति पण्डिताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006226016, "chapter_id": 26226, "verse_number": "२-५४-१७", "content_sanskrit": "तस्मात्पौत्रमिमं बालमंशुमन्तं महामतिम् ।\nतुरगानयनार्थाय नियुङ्क्ष्व नृपसत्तम ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006226017, "chapter_id": 26226, "verse_number": "२-५४-१८", "content_sanskrit": "इत्यक्त्वा राजशार्दूलं सदस्यर्त्विक्समन्वितम् ।\nक्षणेन पश्यतां तेषां नारदोऽन्तर्दधे मुनिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006226018, "chapter_id": 26226, "verse_number": "२-५४-१९", "content_sanskrit": "तच्छ्रत्वा वचन तस्य नारदस्य नृपोत्तमः ।\nदुःखशोकपरातात्मा दध्यौ चिरमुदारधीः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006226019, "chapter_id": 26226, "verse_number": "२-५४-२०", "content_sanskrit": "तं ध्यानयुक्तं सदसि समासीनमवाङ्मुखम् ।\nवसिष्ठः प्राह राजानं सांत्वयन्देशकालवित् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006226020, "chapter_id": 26226, "verse_number": "२-५४-२१", "content_sanskrit": "किमिदं धैर्यसाराणामवकाशं भवदृशाम् ।\nलभते हृदि चेच्छोकः प्राप्तं धीर तया फलम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006226021, "chapter_id": 26226, "verse_number": "२-५४-२२", "content_sanskrit": "दौर्मनस्यं शिथिलयन्सर्वं दिष्टवशानुगम् ।\nमन्वानोऽनन्तरं कृत्यं कर्तुमर्हस्यसंशयम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006226022, "chapter_id": 26226, "verse_number": "२-५४-२३", "content_sanskrit": "वसिष्ठेनैवमुक्तस्तु राजा कार्यार्थतत्त्ववित् ।\nधृतिं सत्त्वं समालंब्य तथेति प्रत्यभाषत ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006226023, "chapter_id": 26226, "verse_number": "२-५४-२४", "content_sanskrit": "अंशुमन्तं समाहूय पौत्रं विनयशालिनम् ।\nब्रह्मक्षत्त्रसभामध्ये शनैरिदमभाषत ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006226024, "chapter_id": 26226, "verse_number": "२-५४-२५", "content_sanskrit": "ब्रह्मदण्डहताः सर्वे पितरस्तव पुत्रक ।\nपतिताः पापकर्माणो निरये शाश्वतीः समाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006226025, "chapter_id": 26226, "verse_number": "२-५४-२६", "content_sanskrit": "त्वमेव संततिर्मह्यं राज्यस्यास्य च रक्षिता ।\nत्वदायत्तमशेषं मे श्रेयोऽमुत्र परत्र च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006226026, "chapter_id": 26226, "verse_number": "२-५४-२७", "content_sanskrit": "स त्वं गच्छ ममादेशात्पाताले कपिलान्तिकम् ।\nतुरगानयनार्थाय यत्नेन महातान्वितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006226027, "chapter_id": 26226, "verse_number": "२-५४-२८", "content_sanskrit": "तं प्रार्थयित्वा विधिवत्प्रसाद्य च विशेषतः ।\nआदाय तुरगं वत्स शीघ्रमागन्तुमर्हसि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006226028, "chapter_id": 26226, "verse_number": "२-५४-२९", "content_sanskrit": "जैमिनिरुवाच एवमुक्तोंऽशुमांस्तेन प्रणम्य पितरं पितुः ।\nतथेत्युक्त्वा महाबुद्धिः प्रययौ कपिलान्तिकम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006226029, "chapter_id": 26226, "verse_number": "२-५४-३०", "content_sanskrit": "तमुपागम्य विधिवन्नमस्कृत्य यथामति ।\nप्रश्रयावनतो भूत्वा शनैरिदमुवाच ह ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006226030, "chapter_id": 26226, "verse_number": "२-५४-३१", "content_sanskrit": "प्रसीद विप्रशार्दूल त्वामहं शरणं गतः ।\nकोपं च संहर क्षिप्रं लोकप्रक्षयकारकम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006226031, "chapter_id": 26226, "verse_number": "२-५४-३२", "content_sanskrit": "त्वयि क्रुद्धे जगत्सर्वं प्रणाशमुपयास्यति ।\nप्रशान्तिमुपयाह्याशुलोकाः संतु गतव्यथाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006226032, "chapter_id": 26226, "verse_number": "२-५४-३३", "content_sanskrit": "प्रसन्नोऽस्मान्महाभाग पश्य सौम्येन चक्षुषा ।\nये त्वत्क्रोधाग्निनिर्दग्धास्तत्संततिमवेहि माम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006226033, "chapter_id": 26226, "verse_number": "२-५४-३४", "content_sanskrit": "नाम्नांशुमन्तं नप्तारं सगरस्य महीपतेः ।\nसोऽहं तस्य नियोगेन त्वत्प्रसादाभिकाङ्क्षया ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006226034, "chapter_id": 26226, "verse_number": "२-५४-३५", "content_sanskrit": "प्राप्तो दास्यसि चेद्ब्रह्मंस्तुरगानयनाय च ।\nजैमिनिरुवाच इति तद्वचनं श्रुत्वा योगीन्द्रप्रवरो मुनिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006226035, "chapter_id": 26226, "verse_number": "२-५४-३६", "content_sanskrit": "अंशुमन्तं समालोक्य प्रसन्न इदमब्रवीत् ।\nस्वागतं भवतो वत्स दिष्ट्या च त्वमिहागतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006226036, "chapter_id": 26226, "verse_number": "२-५४-३७", "content_sanskrit": "गच्छ शीघ्रं हयश्चायं नीयतां सगरान्तिकम् ।\nअधिक्षिप्तोऽस्य यज्ञोऽपि प्रागतः संप्रवर्त्तताम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006226037, "chapter_id": 26226, "verse_number": "२-५४-३८", "content_sanskrit": "व्रियतां च वरो मत्तस्त्वया यस्ते मनोगतः ।\nदास्ये सुदुर्लभमपि त्वद्भक्तिपरितोषितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006226038, "chapter_id": 26226, "verse_number": "२-५४-३९", "content_sanskrit": "एषां तु संप्रमाशं हि गत्वा वद पितामहम् ।\nपापानां मरणं त्वेषां न च शोचितुमर्हसि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006226039, "chapter_id": 26226, "verse_number": "२-५४-४०", "content_sanskrit": "ततः प्रणाम्य चोगीन्द्रमंशुमानिदमब्रवीत् ।\nवरं ददासि चेन्मह्यं वरये त्वां महामुने ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006226040, "chapter_id": 26226, "verse_number": "२-५४-४१", "content_sanskrit": "वरमर्हामि चेत्त्वत्तः प्रसन्नो दातुमर्हसि ।\nत्वद्रोषपावकप्लुष्टाः पितरो ये ममाखिलाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006226041, "chapter_id": 26226, "verse_number": "२-५४-४२", "content_sanskrit": "संप्रयास्यन्ति ते ब्रह्मन्निरयं शास्वतीः समाः ।\nब्रह्मदण्डहतानां तु न हि पिण्डोदकक्रियाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006226042, "chapter_id": 26226, "verse_number": "२-५४-४३", "content_sanskrit": "पिण्डोदकविहीनानामिह लोके महामुने ।\nविद्यते पितृसालोक्यं न खलु श्रुतिचोदितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006226043, "chapter_id": 26226, "verse_number": "२-५४-४४", "content_sanskrit": "अक्षयः स्वर्गवासोऽस्तु तेषां तु त्वत्प्रसादतः ।\nवरेणानेन भगवन्कृतकृत्यो भावाम्यहम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006226044, "chapter_id": 26226, "verse_number": "२-५४-४५", "content_sanskrit": "तत्प्रसीद त्वमेवैषां स्वर्गतेर्वद कारणम् ।\nयेनोद्धारणमेतेषां वह्नेः कोपस्य वै भवेत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006226045, "chapter_id": 26226, "verse_number": "२-५४-४६", "content_sanskrit": "ततस्तमाह योगीन्द्रःसुप्रसन्नेन चेतसा ।\nनिरयोद्धारणं तेषां त्वया वत्स न शक्यते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006226046, "chapter_id": 26226, "verse_number": "२-५४-४७", "content_sanskrit": "तैश्चापि नरके तावद्वस्तव्यं पापकर्मभिः ।\nकालः प्रतीक्ष्यतां तावद्यावत्त्वत्पौत्रसंभवः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006226047, "chapter_id": 26226, "verse_number": "२-५४-४८", "content_sanskrit": "कालान्ते भविता वत्स पौत्रस्तव महामतिः ।\nराजा भगीरथो नाम सर्वधर्मार्थतत्त्ववित् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006226048, "chapter_id": 26226, "verse_number": "२-५४-४९", "content_sanskrit": "स तु यत्नेन महता पितृगौरवयन्त्रितः ।\nआनेष्यति दिवो गङ्गां तपस्तप्त्वा महाद्ध्रुवम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006226049, "chapter_id": 26226, "verse_number": "२-५४-५०", "content_sanskrit": "तदंभसा पावितेषु तेषां गात्रास्थिभस्मसु ।\nप्राप्नुवन्ति गतिं स्वर्गे भवतः पितरोऽखिलाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006226050, "chapter_id": 26226, "verse_number": "२-५४-५१", "content_sanskrit": "तथेति तस्या माहात्म्यं गङ्गाया नृपनन्दन ।\nभागीरथीति लोकेऽस्मिन्सा विख्यातिमुपैष्यति ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006226051, "chapter_id": 26226, "verse_number": "२-५४-५२", "content_sanskrit": "यत्तोयप्लावितेष्वस्थिभस्मलोमनखेष्वपि ।\nनिरयादपि संयाति देही स्वर्लोकमक्षयम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006226052, "chapter_id": 26226, "verse_number": "२-५४-५३", "content_sanskrit": "तस्मात्त्वं गच्छ भद्रं ते नशोकं कर्त्तुमर्हसि ।\nपितामहाय चैवैनमश्वं संप्रतिपादय ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006226053, "chapter_id": 26226, "verse_number": "२-५४-५४", "content_sanskrit": "जैमिनिरुवाच ततः प्रणम्य तं भक्त्या तथेत्युक्त्वा महामतिः ।\nययौ तेनाभ्यनुज्ञातः साकेतनगरं प्रति ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006226054, "chapter_id": 26226, "verse_number": "२-५४-५५", "content_sanskrit": "सगरं स समासाद्य तं प्रणम्य यथाक्रमम् ।\nन्यवेदयच्च वृत्तान्तं मुनेस्तेषां तथान्मनः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006226055, "chapter_id": 26226, "verse_number": "२-५४-५६", "content_sanskrit": "प्रददौतुरगं चापि समानीतं प्रयत्नतः ।\nअतः परमनुष्ठेयमब्रवीत्किं मयेति च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]