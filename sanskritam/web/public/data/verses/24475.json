[{"id": 7004475000, "chapter_id": 24475, "verse_number": "५-३-१६९-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेत्परं तीर्थं पुण्यं पापप्रणाशनम् ।\nमाण्डव्यो यत्र संसिद्ध ऋषिर्नारायणस्तथा॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004475001, "chapter_id": 24475, "verse_number": "५-३-१६९-२", "content_sanskrit": "नारायणेन शुश्रूषा शूलस्थेन कृता पुरा ।\nतत्र स्नात्वा महाराज मुच्यते पापकञ्चुकात्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004475002, "chapter_id": 24475, "verse_number": "५-३-१६९-३", "content_sanskrit": "युधिष्ठिर उवाच ।\nआश्चर्यमेतल्लोकेषु यत्त्वया कथितं मुने ।\nन दृष्टं न श्रुतं तात शूलस्थेन तपः कृतम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004475003, "chapter_id": 24475, "verse_number": "५-३-१६९-४", "content_sanskrit": "एतत्सर्वं कथय मे ऋषिभिः सहितस्य वै ।\nअस्य तीर्थस्य माहात्म्यं माण्डव्यस्य कुतूहलात्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004475004, "chapter_id": 24475, "verse_number": "५-३-१६९-५", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nशृणु राजन्यथावृत्तपुरा त्रेतायुगे क्षितौ ।\nलोकपालोपमो राजा देवपन्नो महामतिः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004475005, "chapter_id": 24475, "verse_number": "५-३-१६९-६", "content_sanskrit": "धर्मज्ञश्च कृतज्ञश्च यज्वा दानरतः सदा ।\nप्रजा ररक्ष यत्नेन पिता पुत्रानिवौरसान्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004475006, "chapter_id": 24475, "verse_number": "५-३-१६९-७", "content_sanskrit": "दात्यायनी प्रिया भार्या तस्य राज्ञो वशानुगा ।\nहारनूपुरघोषेण झङ्काररवनादिता॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004475007, "chapter_id": 24475, "verse_number": "५-३-१६९-८", "content_sanskrit": "परस्परं तयोः प्रीतिर्वर्धतेऽनुदिनं नृप ।\nवंशस्तम्बे स्थितो राजा संशास्ति पृथिवीमिमाम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004475008, "chapter_id": 24475, "verse_number": "५-३-१६९-९", "content_sanskrit": "हस्त्यश्वरथसम्पूर्णां धनवाहनसंयुताम् ।\nअलंकृतो गुणैः सर्वैरनपत्यो महीपतिः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004475009, "chapter_id": 24475, "verse_number": "५-३-१६९-१०", "content_sanskrit": "दुःखेन महताविष्टः संतप्तः सन्ततिं विना ।\nस्नानहोमरतो नित्यं द्वादशाब्दानि भारत॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004475010, "chapter_id": 24475, "verse_number": "५-३-१६९-११", "content_sanskrit": "व्रतोपवासनियमैः पत्नीभिः सह तस्थिवान् ।\nआराधयद्भगवतीं चामुण्डां मुण्डमर्दिनीम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004475011, "chapter_id": 24475, "verse_number": "५-३-१६९-१२", "content_sanskrit": "स्तोत्रैरनेकैर्भक्त्या च पूजाविधिसमाधिना ।\nजय वाराहि चामुण्डे जय देवि त्रिलोचने॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004475012, "chapter_id": 24475, "verse_number": "५-३-१६९-१३", "content_sanskrit": "ब्राह्मि रौद्रि च कौमारि कात्यायनि नमोऽस्तु ते ।\nप्रचण्डे भैरवे रौद्रि योगिन्याकाशगामिनि॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004475013, "chapter_id": 24475, "verse_number": "५-३-१६९-१४", "content_sanskrit": "नास्ति किंचित्त्वया हीनं त्रैलोक्ये सचराचरे ।\nराज्ञा स्तुता च संतुष्टा देवी वचनमब्रवीत्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004475014, "chapter_id": 24475, "verse_number": "५-३-१६९-१५", "content_sanskrit": "वरयस्व यथाकामं यस्ते मनसि वर्तते ।\nआराधिता त्वया भक्त्या तुष्टा दास्यामि ते वरम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004475015, "chapter_id": 24475, "verse_number": "५-३-१६९-१६", "content_sanskrit": "देवपन्न उवाच ।\nयदि तुष्टासि देवेशि वरार्हो यदि वाप्यहम् ।\nपुत्रसन्तानरहितं संतप्तं मां समुद्धर॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004475016, "chapter_id": 24475, "verse_number": "५-३-१६९-१७", "content_sanskrit": "सन्तानं नय मे वृद्धिं गोत्ररक्षां कुरुष्व मे ।\nअपुत्रिणां गृहाणीह श्मशानसदृशानि हि॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004475017, "chapter_id": 24475, "verse_number": "५-३-१६९-१८", "content_sanskrit": "पितरस्तस्य नाश्नन्ति देवता ऋषिभिः सह ।\nक्रियमाणेऽप्यहरहः श्राद्धे मत्पितरः सदा॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004475018, "chapter_id": 24475, "verse_number": "५-३-१६९-१९", "content_sanskrit": "दर्शयन्ति सदात्मानं स्वप्ने क्षुत्पीडितं मम ।\nइति राज्ञो वचः श्रुत्वा देवी ध्यानमुपागता॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004475019, "chapter_id": 24475, "verse_number": "५-३-१६९-२०", "content_sanskrit": "दिव्येन चक्षुषा दृष्टं त्रैलोक्यं सचराचरम् ।\nप्रसन्नवदना देवी राजानमिदमब्रवीत्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004475020, "chapter_id": 24475, "verse_number": "५-३-१६९-२१", "content_sanskrit": "सन्तानं नास्ति ते राजंस्त्रैलोक्ये सचराचरे ।\nयजस्व यज्ञपुरुषमपत्यं नास्ति तेऽन्यथा॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004475021, "chapter_id": 24475, "verse_number": "५-३-१६९-२२", "content_sanskrit": "मया दृष्टं महीपाल त्रैलोक्यं दिव्यचक्षुषा ।\nएवमुक्त्वा गता देवी राजा स्वगृहमागमत्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004475022, "chapter_id": 24475, "verse_number": "५-३-१६९-२३", "content_sanskrit": "इयाज यज्ञपुरुषं संजाता कन्यका ततः ।\nतेजस्विनी रूपवती सर्वलोकमनोहरा॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004475023, "chapter_id": 24475, "verse_number": "५-३-१६९-२४", "content_sanskrit": "देवगन्धर्वलोकेऽपि तादृशी नास्ति कामिनी ।\nतस्या नाम कृतं पित्रा हर्षात्कामप्रमोदिनी॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004475024, "chapter_id": 24475, "verse_number": "५-३-१६९-२५", "content_sanskrit": "ततः कालेन ववृधे रूपेणास्तम्भयज्जगत् ।\nहंसलीलागतिः सुभ्रूः स्तनभारावनामिता॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004475025, "chapter_id": 24475, "verse_number": "५-३-१६९-२६", "content_sanskrit": "रक्तमाल्याम्बरधरा कुण्डलाभरणोज्ज्वला ।\nदिव्यानुलेपनवती सखीभिः सा सुरक्षिता॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004475026, "chapter_id": 24475, "verse_number": "५-३-१६९-२७", "content_sanskrit": "कुचमध्यगतो हारो विद्युन्मालेव राजते ।\nभ्रमराञ्चितकेशी सा बिम्बोष्ठी चारुहासिनी॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004475027, "chapter_id": 24475, "verse_number": "५-३-१६९-२८", "content_sanskrit": "कर्णान्तप्राप्तनेत्राभ्यां पिबन्तीवाथ कामिनः ।\nचन्द्रताम्बूलसौरभ्यैराकर्षन्तीव मन्मथम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004475028, "chapter_id": 24475, "verse_number": "५-३-१६९-२९", "content_sanskrit": "कम्बुग्रीवा चारुमध्या ताम्रपादाङ्गुलीनखा ।\nनिम्ननाभिः सुजघना रम्भोरू सुदती शुभा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004475029, "chapter_id": 24475, "verse_number": "५-३-१६९-३०", "content_sanskrit": "मातापितृसुहृद्वर्गे क्रीडानन्दविवर्धिनी ।\nएकस्मिन्दिवसे बाला सखीवृन्दसमन्विता॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004475030, "chapter_id": 24475, "verse_number": "५-३-१६९-३१", "content_sanskrit": "चन्दनागरुतांबूलधूपसौमनसाञ्चिता ।\nगृहीत्वा पुष्पधूपादि गता देवीप्रपूजने॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004475031, "chapter_id": 24475, "verse_number": "५-३-१६९-३२", "content_sanskrit": "तडागतट उत्सृज्य भूषणान्यङ्गवेष्टकान् ।\nचक्रुः सरसिताः क्रीडां जलमध्यगतास्तदा॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004475032, "chapter_id": 24475, "verse_number": "५-३-१६९-३३", "content_sanskrit": "क्रीडन्तीं तामवेक्ष्याथ ससखीं विमले जले ।\nराक्षसः शम्बरो नाम श्येनरूपेण चागमत्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004475033, "chapter_id": 24475, "verse_number": "५-३-१६९-३४", "content_sanskrit": "गृहीता जलमध्यस्था तेन सा काममोदिनी ।\nखमुत्पपात दुष्टात्मा गृहीत्वाभरणान्यपि॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004475034, "chapter_id": 24475, "verse_number": "५-३-१६९-३५", "content_sanskrit": "वायुमार्गं गतः सोऽथ कामिन्या सह भारत ।\nअपतन्कुण्डलादीनि यत्र तोये महामुनिः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004475035, "chapter_id": 24475, "verse_number": "५-३-१६९-३६", "content_sanskrit": "माण्डव्यो नर्मदातीरे काष्ठवत्संजितेन्द्रियः ।\nलीनो माहेश्वरे स्थाने नारायणपदे परे॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004475036, "chapter_id": 24475, "verse_number": "५-३-१६९-३७", "content_sanskrit": "तस्य चानुचरो भ्राता भ्रातुः शुश्रूषणे रतः ।\nतपोजपकृशीभूतो दध्यौ देवं जनार्दनम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]