[{"id": 7001163000, "chapter_id": 21163, "verse_number": "२-३-११-१", "content_sanskrit": "ब्रह्मोवाच ।\nवर्द्धमाना गिरेः पुत्री सा शक्ति लोकपूजिता ।\nअष्टवर्षा यदा जाता हिमालयगृहे सती॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001163001, "chapter_id": 21163, "verse_number": "२-३-११-२", "content_sanskrit": "तज्जन्म गिरिशो ज्ञात्वा सतीविरहकातरः ।\nकृत्वा तामद्भुतामन्तर्मुमोदातीव नारद॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001163002, "chapter_id": 21163, "verse_number": "२-३-११-३", "content_sanskrit": "तस्मिन्नेवान्तरे शम्भुर्लौकिकीं गतिमाश्रितः ।\nसमाधातुं मनस्सम्यक्तपः कर्त्तुं समैच्छत॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001163003, "chapter_id": 21163, "verse_number": "२-३-११-४", "content_sanskrit": "कांश्चिद्गणवराञ्छान्तान्नंद्यादीनवगृह्य च ।\nगङ्गावतारमगमद्धिमवत्प्रस्थमुत्तमम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001163004, "chapter_id": 21163, "verse_number": "२-३-११-५", "content_sanskrit": "यत्र गंगा निपतिता पुरा ब्रह्मपुरात्स्रुता ।\nसर्वाघौघविनाशाय पावनी परमा मुने॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001163005, "chapter_id": 21163, "verse_number": "२-३-११-६", "content_sanskrit": "तपःप्रारम्भमकरोत्स्थित्वा तत्र वशी हरः ।\nएकाग्रं चिंतयामास स्वमात्मानमतन्द्रितः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001163006, "chapter_id": 21163, "verse_number": "२-३-११-७", "content_sanskrit": "चेतो ज्ञानभवं नित्यं ज्योतीरूपं निरामयम् ।\nजगन्मयं चिदानन्दं द्वैतहीनं निराश्रयम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001163007, "chapter_id": 21163, "verse_number": "२-३-११-८", "content_sanskrit": "हरे ध्यानपरे तिस्मिन्प्रमथा ध्यानतत्पराः ।\nअभवन्केचिदपरे नन्दिभृंग्यादयो गणाः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001163008, "chapter_id": 21163, "verse_number": "२-३-११-९", "content_sanskrit": "सेवां चक्रुस्तदा केचिद्गणाः शम्भोः परात्मनः ।\nनैवाकूजंस्तु मौना हि द्वरपाः केचनाभवन्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001163009, "chapter_id": 21163, "verse_number": "२-३-११-१०", "content_sanskrit": "एतस्मिन्नन्तरे तत्र जगाम हिमभूधरः ।\nशङ्करस्यौषधिप्रस्थं श्रुत्वागमनमादरात्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001163010, "chapter_id": 21163, "verse_number": "२-३-११-११", "content_sanskrit": "प्रणनाम प्रभुं रुद्रं सगणो भूधरेश्वरः ।\nसमानर्च च सुप्रीतस्तुष्टाव स कृताञ्जलिः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001163011, "chapter_id": 21163, "verse_number": "२-३-११-१२", "content_sanskrit": "हिमालय उवाच ।\nदेवदेव महादेव कपर्दिच्छंकर प्रभो ।\nत्वयैव लोकनाथेन पालितं भुवनत्रयम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001163012, "chapter_id": 21163, "verse_number": "२-३-११-१३", "content_sanskrit": "नमस्ते देवदेवेश योगिरूपधराय च ।\nनिर्गुणाय नमस्तुभ्यं सगुणाय विहारिणे॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001163013, "chapter_id": 21163, "verse_number": "२-३-११-१४", "content_sanskrit": "कैलासवासिने शम्भो सर्वलोकाटनाय च ।\nनमस्ते परमेशाय लीलाकाराय शूलिने॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001163014, "chapter_id": 21163, "verse_number": "२-३-११-१५", "content_sanskrit": "परिपूर्णगुणाधानविकाररहितायते ।\nनमोऽनीहाय वीहाय धीराय परमात्मने॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001163015, "chapter_id": 21163, "verse_number": "२-३-११-१६", "content_sanskrit": "अबहिर्भोगकाराय जनवत्सलते नमः ।\nत्रिगुणाधीश मायेश ब्रह्मणे परमात्मने॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001163016, "chapter_id": 21163, "verse_number": "२-३-११-१७", "content_sanskrit": "विष्णुब्रह्मादिसेव्याय विष्णुब्रह्मस्वरूपिणे ।\nविष्णुब्रह्मकदात्रे ते भक्तप्रिय नमोऽस्तु ते॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001163017, "chapter_id": 21163, "verse_number": "२-३-११-१८", "content_sanskrit": "तपोरत तपस्थानसुतपः फलदायिने ।\nतपःप्रियाय शान्ताय नमस्ते ब्रह्मरूपिणे॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001163018, "chapter_id": 21163, "verse_number": "२-३-११-१९", "content_sanskrit": "व्यवहारकरायैव लोकाचारकराय ते ।\nसगुणाय परेशाय नमोस्तु परमात्मने॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001163019, "chapter_id": 21163, "verse_number": "२-३-११-२०", "content_sanskrit": "लीला तव महेशानावेद्या साधुसुखप्रदा ।\nभक्ताधीनस्वरूपोऽसि भक्तवश्यो हि कर्मकृत्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001163020, "chapter_id": 21163, "verse_number": "२-३-११-२१", "content_sanskrit": "मम भाग्योदयादत्र त्वमागत इह प्रभो ।\nसनाथ कृतवान्मां त्वं वर्णितो दानवत्सलः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001163021, "chapter_id": 21163, "verse_number": "२-३-११-२२", "content_sanskrit": "अद्य मे सफलं जन्म सफलं जीवनं मम ।\nअद्य मे सफलं सर्वं यदत्र त्वं समागतः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001163022, "chapter_id": 21163, "verse_number": "२-३-११-२३", "content_sanskrit": "ज्ञात्वा मां दासमव्यग्रमाज्ञान्देहि महेश्वर ।\nत्वत्सेवां च महाप्रीत्या कुर्यामहमनन्यधीः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001163023, "chapter_id": 21163, "verse_number": "२-३-११-२४", "content_sanskrit": "ब्रह्मोवाच ।\nइत्याकर्ण्य वचस्तस्य गिरीशस्य महेश्वरः ।\nकिंचिदुन्मील्य नेत्रे च ददर्श सगणं गिरिम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001163024, "chapter_id": 21163, "verse_number": "२-३-११-२५", "content_sanskrit": "सगणं तन्तथा दृष्ट्वा गिरिराजं वृषध्वजः ।\nउवाच ध्यानयोगस्थः स्मयन्निव जगत्पतिः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001163025, "chapter_id": 21163, "verse_number": "२-३-११-२६", "content_sanskrit": "महेश्वर उवाच ।\nतव पृष्ठे तपस्तप्तुं रहस्यमहमागतः ।\nयथा न कोपि निकटं समायातु तथा कुरु॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001163026, "chapter_id": 21163, "verse_number": "२-३-११-२७", "content_sanskrit": "त्वं महात्मा तपोधामा मुनीनां च सदाश्रयः ।\nदेवानां राक्षसानां च परेषां च महात्मनाम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001163027, "chapter_id": 21163, "verse_number": "२-३-११-२८", "content_sanskrit": "सदा वासो द्विजादीनां गंगापूतश्च नित्यदा ।\nपरोपकारी सर्वेषां गिरीणामधिपः प्रभुः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001163028, "chapter_id": 21163, "verse_number": "२-३-११-२९", "content_sanskrit": "अहं तपश्चराम्यत्र गंगावतरणे स्थले ।\nआश्रितस्तव सुप्रीतो गिरिराज यतात्मवान्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001163029, "chapter_id": 21163, "verse_number": "२-३-११-३०", "content_sanskrit": "निर्विघ्नं मे तपश्चात्र हेतुना येन शैलप ।\nसर्वथा हि गिरिश्रेष्ठ सुयत्नं कुरु साम्प्रतम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001163030, "chapter_id": 21163, "verse_number": "२-३-११-३१", "content_sanskrit": "ममेदमेव परमं सेवनं पर्वतोत्तम ।\nस्वगृहं गच्छ सत्प्रीत्या तत्संपादय यत्नतः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001163031, "chapter_id": 21163, "verse_number": "२-३-११-३२", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइत्युक्त्वा जगतां नाथस्तूष्णीमास स सूतिकृत् ।\nगिरिराजस्तदा शम्भुं प्रणयादिदमब्रवीत्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001163032, "chapter_id": 21163, "verse_number": "२-३-११-३३", "content_sanskrit": "॥ हिमालय उवाच  ।\nपूजितोऽसि जगन्नाथ मया त्वम्परमेश्वर ।\nस्वागतेनाद्य विषये स्थितं त्वाम्प्रार्थयामि किम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001163033, "chapter_id": 21163, "verse_number": "२-३-११-३४", "content_sanskrit": "महता तपसा त्वं हि देवैर्यत्नपराश्रितैः ।\nन प्राप्यसे महेशान स त्वं स्वयमुपस्थितः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001163034, "chapter_id": 21163, "verse_number": "२-३-११-३५", "content_sanskrit": "मत्तोप्यन्यतमो नास्ति न मत्तोऽन्योऽस्ति पुण्यवान् ।\nभवानिति च मत्पृष्ठे तपसे समुपस्थितः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001163035, "chapter_id": 21163, "verse_number": "२-३-११-३६", "content_sanskrit": "देवेन्द्रादधिकम्मन्ये स्वात्मानम्परमेश्वर ।\nसगणेन त्वयागत्य कृतोऽनुग्रहभागहम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001163036, "chapter_id": 21163, "verse_number": "२-३-११-३७", "content_sanskrit": "निर्विघ्नं कुरु देवेश स्वतन्त्रः परमन्तपः ।\nकरिष्येऽहन्तथा सेवां दासोऽहन्ते सदा प्रभो॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001163037, "chapter_id": 21163, "verse_number": "२-३-११-३८", "content_sanskrit": "ब्रह्मोवाच ।\nइत्युक्त्वा गिरिराजोऽसौ स्वं वेश्म द्रुतमागतः ।\nवृत्तांत्तं तं समाचख्यौ प्रियायै च समादरात्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001163038, "chapter_id": 21163, "verse_number": "२-३-११-३९", "content_sanskrit": "नीयमानान्परीवारान्स्वगणानपि नारद ।\nसमाहूयाखिलाञ्छैलपतिः प्रोवाच तत्त्वतः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001163039, "chapter_id": 21163, "verse_number": "२-३-११-४०", "content_sanskrit": "हिमालय उवाच ।\nअद्य प्रभृति नो यातु कोपि गंगावतारणम् ।\nमच्छासनेन मत्प्रस्थं सत्यमेतद्ब्रवीम्यहम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001163040, "chapter_id": 21163, "verse_number": "२-३-११-४१", "content_sanskrit": "गमिष्यति जनः कश्चित्तत्र चेत्तं महाखलम् ।\nदण्डयिष्ये विशेषेण सत्यमेतन्मयोदितम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001163041, "chapter_id": 21163, "verse_number": "२-३-११-४२", "content_sanskrit": "इति तान्स नियम्याशु स्वगणान्निखिलान्मुने ।\nसुयत्नं कृतवाञ्छैलस्तं शृणु त्वं वदामि ते॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]