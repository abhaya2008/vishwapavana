[{"id": 2040118, "chapter_id": 1887, "verse_number": "५-१३२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040119, "chapter_id": 1887, "verse_number": "५-१३२-१", "content_sanskrit": "प्रविश्याथ गृहं तस्याश्चरणावभिवाद्य च।\nआचख्यौ तत्समासेन यद्वृत्तं कुरुसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040120, "chapter_id": 1887, "verse_number": "५-१३२-२x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040121, "chapter_id": 1887, "verse_number": "५-१३२-२", "content_sanskrit": "उक्तं बहुविधं वाक्यं ग्रहणीयं सहेतुकम्।\nऋषिभिश्चैव च मया न चासौ तद्गृहीतवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040122, "chapter_id": 1887, "verse_number": "५-१३२-३", "content_sanskrit": "कालपक्वमिदं सर्वं सुयोधनवशानुगम्।\n` सर्वक्षत्रं क्षणेनैव दह्यते पार्थवह्निना ।\nआपृच्छे भवतीं शीघ्रं प्रयास्ये पाण्डवान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040123, "chapter_id": 1887, "verse_number": "५-१३२-४", "content_sanskrit": "किं वाच्याः पाण्डवेयास्ते भवत्या वचनान्मया ।\nतद्ब्रूहि त्वं महाप्रज्ञे शुश्रूषे वचनं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040124, "chapter_id": 1887, "verse_number": "५-१३२-५x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040125, "chapter_id": 1887, "verse_number": "५-१३२-५", "content_sanskrit": "ब्रूयाः केशव राजानं धर्मात्मानं युधिष्ठिरम् ।\nभूयांस्ते हीयते धर्मो मा पुत्रक वृथा कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040126, "chapter_id": 1887, "verse_number": "५-१३२-६", "content_sanskrit": "श्रोत्रियस्येव ते राजन्मन्दकस्याविपश्चितः ।\nअनुवाकहता बुद्धिर्धर्ममेवैकमीक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040127, "chapter_id": 1887, "verse_number": "५-१३२-७", "content_sanskrit": "अङ्गावेक्षस्व धर्मं त्वं यथा सृष्टः स्वयंभुवा ।\nबाहुभ्यां क्षत्रियाः सृष्टा बाहुवीर्योपजीविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040128, "chapter_id": 1887, "verse_number": "५-१३२-८", "content_sanskrit": "क्रूराय कर्मणे नित्यं प्रजानां परिपालने।\nश्रृणु चात्रोपमामेकां या वृद्धेभ्यः श्रुता मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040129, "chapter_id": 1887, "verse_number": "५-१३२-९", "content_sanskrit": "मुचुकुन्दस्य राजर्षेरददत्पृथिवीमिमाम्।\nपुरा वैश्रवणः प्रीतो न चासौ तद्गृहीतवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040130, "chapter_id": 1887, "verse_number": "५-१३२-१०", "content_sanskrit": "बाहुवीर्यार्जितं राज्यमश्रीयामिति कामये।\nततो वैश्रवणः प्रीतो विस्मितः समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040131, "chapter_id": 1887, "verse_number": "५-१३२-११", "content_sanskrit": "मुचुकुन्दस्ततो राजा सोऽन्वशासद्वसुन्धराम् ।\nबाहुवीर्यार्जितां सम्यक् क्षत्रधर्ममनुव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040132, "chapter_id": 1887, "verse_number": "५-१३२-१२", "content_sanskrit": "यं हि धर्मं चरन्तीह प्रजा राज्ञा सुरक्षिताः ।\nचतुर्थं तस्य धर्मस्य राजा विन्देन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040133, "chapter_id": 1887, "verse_number": "५-१३२-१३", "content_sanskrit": "राजा चरति चेद्धर्मं देवत्वायैव कल्पते।\nस चेदधर्मं चरति नरकायैव गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040134, "chapter_id": 1887, "verse_number": "५-१३२-१४", "content_sanskrit": "दण्डनीतिः स्वधर्मेण चातुर्वर्ण्यं नियच्छति।\nप्रयुक्तास्वामिना सम्यगधर्मेभ्यो नियच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040135, "chapter_id": 1887, "verse_number": "५-१३२-१५", "content_sanskrit": "दण्डनीत्यां यदा राजा सम्यक्कार्त्स्न्येन वर्तते।\nतदा कृतयुं नाम कालः श्रेष्ठः प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040136, "chapter_id": 1887, "verse_number": "५-१३२-१६", "content_sanskrit": "कालो वा कारणं राज्ञो राजा वा कालकारणम् ।\nइति ते संशयो मा भूद्राजा कालस्य कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040137, "chapter_id": 1887, "verse_number": "५-१३२-१७", "content_sanskrit": "राजा कृतयुगस्रष्टा त्रेताया द्वापरस्य च।\nयुगस्य च चतुर्थस्य राजा भवति कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040138, "chapter_id": 1887, "verse_number": "५-१३२-१८", "content_sanskrit": "कृतस्य करणाद्राजा स्वर्गमत्यन्तमश्रुते ।\nत्रेतायाः करणाद्राजा स्वर्गं नात्यन्तमश्रुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040139, "chapter_id": 1887, "verse_number": "५-१३२-१९", "content_sanskrit": "प्रवर्तनाद्द्वापरस्य यथाभागमुपाश्रुते ।\nकलेः प्रवर्तनाद्राजा पापमत्यन्तमश्रुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040140, "chapter_id": 1887, "verse_number": "५-१३२-२०", "content_sanskrit": "ततो वसति दुष्कर्मा नरके शाश्वतीः समाः ।\nराजदोषेण हि जगत्स्पृश्यते जगतः स च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040141, "chapter_id": 1887, "verse_number": "५-१३२-२१", "content_sanskrit": "राजधर्मानवेक्षस्व पितृपैतामहोचितान्।\nनैतद्राजर्षिवृत्तं हि यत्र त्वं स्थातुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040142, "chapter_id": 1887, "verse_number": "५-१३२-२२", "content_sanskrit": "न हि वैक्लब्यसंसृष्ट आनृशंस्ये व्यवस्थितः ।\nप्रजापालनसंभूतं फलं किंचन लब्धवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040143, "chapter_id": 1887, "verse_number": "५-१३२-२३", "content_sanskrit": "न ह्येतामाशिषं पाण्डुर्न चाहं न पितामहः ।\nप्रयुक्तवन्तः पूर्वं ते यया चरसि मेधया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040144, "chapter_id": 1887, "verse_number": "५-१३२-२४", "content_sanskrit": "यज्ञो दानं तपः शौर्यं प्रज्ञा सन्तानमेव च ।\nमाहात्म्यं बलमोजश्च नित्यमाशंसितं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040145, "chapter_id": 1887, "verse_number": "५-१३२-२५", "content_sanskrit": "नित्यं स्वाहा स्वधा नित्यं दद्युर्मानुषदेवताः ।\nदीर्घमायुर्धनं पुत्रान्सम्यगाराधिताः शुभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040146, "chapter_id": 1887, "verse_number": "५-१३२-२६", "content_sanskrit": "पुत्रेष्वाशासते नित्यं पितरो दैवतानि च।\nदानमध्ययनं यज्ञः प्रजानां परिपालनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040147, "chapter_id": 1887, "verse_number": "५-१३२-२७", "content_sanskrit": "एतद्धर्ममधर्मं वा जन्मनैवाभ्यजायथाः ।\nते तु वैद्याः कुले जाता अवृत्त्या तात पीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2040148, "chapter_id": 1887, "verse_number": "५-१३२-२८", "content_sanskrit": "यत्र दानपतिं शूरं क्षुधिताः पृथिवीचराः ।\nप्राप्य तुष्टाः प्रतिष्ठन्ते धर्मः कोऽभ्यधिकस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2040149, "chapter_id": 1887, "verse_number": "५-१३२-२९", "content_sanskrit": "दानेनान्यं बलेनान्यं तथा सूनृतयाऽपरम्।\nसर्वतः प्रतिगृह्णीयाद्राज्यं प्राप्येह धार्मिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2040150, "chapter_id": 1887, "verse_number": "५-१३२-३०", "content_sanskrit": "ब्राह्मणः प्रचरेद्भैक्षं क्षत्रियः परिपालयेत्।\nवैश्यो धनार्जनं कुर्याच्छूद्रः परिचरेच्च तान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2040151, "chapter_id": 1887, "verse_number": "५-१३२-३१", "content_sanskrit": "भैक्षं विप्रतिषिद्धं ते कृषिर्नैवोपपद्यते ।\nक्षत्रियोऽसि क्षतात्राता बाहुवीर्योपजीविता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2040152, "chapter_id": 1887, "verse_number": "५-१३२-३२", "content_sanskrit": "पित्र्यमंशं महाबाहो निमग्नं पुनरुद्धर ।\nसाम्ना भेदेन दानेन दण्डेनाथ नयेन वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2040153, "chapter_id": 1887, "verse_number": "५-१३२-३३", "content_sanskrit": "इतो दुःखतरं किं नु यदहं दीनबान्धवा।\nपरपिण्डमुदीक्षे वै त्वां सूत्वा मित्रनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2040154, "chapter_id": 1887, "verse_number": "५-१३२-३४", "content_sanskrit": "युध्यस्व राजधर्मेण मा निमञ्जीः पितामहान् ।\nमा गमः क्षीणपुण्यस्त्वं सानुजः पापिकां गतिं ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2040155, "chapter_id": 1887, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि द्वात्रिंशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]