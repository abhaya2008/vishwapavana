[{"id": 2014076, "chapter_id": 1291, "verse_number": "२-३२-१", "content_sanskrit": "वैशम्पाय उवाच॥\nतथैव सहदेवोऽपि धर्मराजेन पूजितः।\nमहत्या सेनया राजन्प्रययौ दक्षिणां दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014077, "chapter_id": 1291, "verse_number": "२-३२-२", "content_sanskrit": "स शूरसेनान्कार्त्स्न्येन पूर्वमेवाजयत्प्रभुः।\nमत्स्यराजं च कौरव्यो वशे चक्रे बलाद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014078, "chapter_id": 1291, "verse_number": "२-३२-३", "content_sanskrit": "अधिराजाधिपं चैव दन्तवक्रं महाबलम्।\nजिगाय करदं चैव कृत्वा राज्ये न्यवेशयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014079, "chapter_id": 1291, "verse_number": "२-३२-४", "content_sanskrit": "सुकुमारं वशे चक्रे सुमित्रं च नराधिपम्।\nतथैवापरमत्स्यांश्च व्यजयत्स पटच्चरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014080, "chapter_id": 1291, "verse_number": "२-३२-५", "content_sanskrit": "निषादभूमिं गोशृङ्गं पर्वतप्रवरं तथा।\nतरसैवाजयद्धीमाञ्श्रेणिमन्तं च पार्थिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014081, "chapter_id": 1291, "verse_number": "२-३२-६", "content_sanskrit": "नरराष्ट्रं च निर्जित्य कुन्तिभोजमुपाद्रवत्।\nप्रीतिपूर्वं च तस्यासौ प्रतिजग्राह शासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014082, "chapter_id": 1291, "verse_number": "२-३२-७", "content_sanskrit": "ततश्चर्मण्वतीकूले जम्भकस्यात्मजं नृपम्।\nददर्श वासुदेवेन शेषितं पूर्ववैरिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014083, "chapter_id": 1291, "verse_number": "२-३२-८", "content_sanskrit": "चक्रे तेन स सङ्ग्रामं सहदेवेन भारत।\nस तमाजौ विनिर्जित्य दक्षिणाभिमुखो ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014084, "chapter_id": 1291, "verse_number": "२-३२-९", "content_sanskrit": "सेकानपरसेकांश्च रत्नानि विविधानि च॥\nततस्तेनैव सहितो नर्मदामभितो ययौ। २-३२-१०aभगदत्तं महाबाहुं क्षत्रियं नरकात्मजम्।\nअर्जुनाय करं दत्तं श्रुत्वा तत्र न्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014085, "chapter_id": 1291, "verse_number": "२-३२-११", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ सैन्येन महतावृतौ।\nजिगाय समरे वीरावाश्विनेयः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014086, "chapter_id": 1291, "verse_number": "२-३२-१२", "content_sanskrit": "ततो रत्नान्युपादाय पुरं भोजकटं ययौ।\nतत्र युद्धमभूद्राजन्दिवसद्वयमच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014087, "chapter_id": 1291, "verse_number": "२-३२-१३", "content_sanskrit": "स विजित्य दुराधर्षं भीष्मकं माद्रिनन्दनः।\nकोसलाधिपतिं चैव तथा वेणातटाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014088, "chapter_id": 1291, "verse_number": "२-३२-१४", "content_sanskrit": "कान्तारकांश्च समर तथा प्राकोटकान्नृपान्।\nनाटकेयांश्च समरे तथा हेरम्बकान्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014089, "chapter_id": 1291, "verse_number": "२-३२-१५", "content_sanskrit": "मारुधं च विनिर्जित्य रम्यग्राममथो बलात्।\nनाचीनानर्बुकांश्चैव राजानश्च महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014090, "chapter_id": 1291, "verse_number": "२-३२-१६", "content_sanskrit": "तांस्तानाटविकान्सर्वानजयत्पाण्डुनन्दनः।\nनाताधिपं च नृपतिं वशे चक्रे महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014091, "chapter_id": 1291, "verse_number": "२-३२-१७", "content_sanskrit": "पुलिन्दांश्च रणे जित्वा ययौ दक्षिणतः पुरः।\nयुयुधे पाण्ड्यराजेन दिवसं नकुलानुजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014092, "chapter_id": 1291, "verse_number": "२-३२-१८", "content_sanskrit": "तं जित्वा स महाबाहुः प्रययौ दक्षिणापथम्।\nगुहामासादयामास किष्किन्धां लोकविश्रुताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014093, "chapter_id": 1291, "verse_number": "२-३२-१९", "content_sanskrit": "पुरा वानरराजेन वालिना चाभिरक्षिताम्।\nततः कोसलराजस्य रामस्यैवानुगेन च।\nसुग्रीवेणाभिगुप्तां तां प्रविष्टस्तमथाह्वयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014094, "chapter_id": 1291, "verse_number": "२-३२-२०", "content_sanskrit": "तत्र वानरराजाभ्यां मैन्देन द्विविदेन च।\nयुयुधे दिवसान्सप्त न च तौ विकृतिं गतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014095, "chapter_id": 1291, "verse_number": "२-३२-२१", "content_sanskrit": "ततस्तुष्टौ महात्मानौ सहदेवाय वानरौ।\nऊचतुश्चैव संहृष्टौ प्रीतिपूर्वमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014096, "chapter_id": 1291, "verse_number": "२-३२-२२", "content_sanskrit": "गच्छ पाण्डवशार्दूल रत्नान्यादाय सर्वशः।\nअविघ्नमस्त कार्याय धर्मराजाय धीमते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014097, "chapter_id": 1291, "verse_number": "२-३२-२३", "content_sanskrit": "ततो रत्नान्युपादाय पुरीं माहिष्मतीं ययौ॥\nतत्र नीलेन राज्ञा स चक्रे युद्धं नरर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014098, "chapter_id": 1291, "verse_number": "२-३२-२४", "content_sanskrit": "पाण्डवः परवीरघ्नः सहदेवः प्रतापवान्॥\nततोऽस्य सुमहद्युद्धमासीद्भीरुभयङ्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014099, "chapter_id": 1291, "verse_number": "२-३२-२५", "content_sanskrit": "सैन्यक्षयकरं चैव प्राणानां संशयावहम्।\nचक्रे तस्य हि साहाय्यं भगवान्हव्यवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014100, "chapter_id": 1291, "verse_number": "२-३२-२६", "content_sanskrit": "ततो रथा हया नागाः पुरुषाः कवचानि च।\nप्रतीप्तानि व्यदृश्यन्त सहदेवबले तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014101, "chapter_id": 1291, "verse_number": "२-३२-२७", "content_sanskrit": "ततः सुसंभ्रान्तमना बभूव कुरुनन्दनः।\nनोत्तरं प्रतिवक्तुं च शक्तोऽभूज्जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014102, "chapter_id": 1291, "verse_number": "२-३२-२८x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014103, "chapter_id": 1291, "verse_number": "२-३२-२८", "content_sanskrit": "किमर्थं भगवान्वह्निः प्रत्यमित्रोऽभवद्युधि।\nसहदेवस्य यज्ञार्थं घटमानस्य वै द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014104, "chapter_id": 1291, "verse_number": "२-३२-२९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2014105, "chapter_id": 1291, "verse_number": "२-३२-२९", "content_sanskrit": "तत्र माहिष्मतीवासी भगवान्हव्यवाहनः।\nश्रूयते हि गृहीतो वै पुरस्तात्पारदारिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2014106, "chapter_id": 1291, "verse_number": "२-३२-३०", "content_sanskrit": "नीलस्य राज्ञो दुहिता बभूवतातीव शोभना।\nसाऽग्निहोत्रमुपातिष्ठद्बोधनाय पितुः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2014107, "chapter_id": 1291, "verse_number": "२-३२-३१", "content_sanskrit": "व्यजनैर्धूयमानोऽपि तावत्प्रज्वलते न सः॥\nयावच्चारुपुटौष्ठेन वायुना न विधूयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2014108, "chapter_id": 1291, "verse_number": "२-३२-३२", "content_sanskrit": "ततः स भगवानग्निश्चकमे तां सुदर्शनाम्।\nनीलस्य राज्ञः सर्वेषामुपनीतश्च सोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2014109, "chapter_id": 1291, "verse_number": "२-३२-३३", "content_sanskrit": "ततो ब्रह्मणरूपेण रममाणो यदृच्छया॥\nचकमे तां वरारोहां कन्यामुत्पललोचनाम्॥\nतं तु राजा यथाशास्त्रमशासद्धार्मिकस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2014110, "chapter_id": 1291, "verse_number": "२-३२-३४", "content_sanskrit": "प्रजज्वाल ततः कोपाद्भगवान्हव्यवाहनः।\nतं दृष्ट्वा विस्मितो राजा जगाम शिरसाऽवनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2014111, "chapter_id": 1291, "verse_number": "२-३२-३५", "content_sanskrit": "ततः कालेन तां कन्यां तथैव हि तदा नृपः।\nप्रददौ विप्ररूपाय वह्रये शिरसा नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2014112, "chapter_id": 1291, "verse_number": "२-३२-३६", "content_sanskrit": "प्रतिगृह्य च तां सुभ्रुं नीलराज्ञः सुतां तदा।\nचक्रे प्रसादं भगवांस्तस्य राज्ञो विभावसुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2014113, "chapter_id": 1291, "verse_number": "२-३२-३७", "content_sanskrit": "वरेण च्छन्दयामास तं नृपं स्विष्टकृत्तमः।\nअभयं च स जग्राह स्वसैन्ये वै महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2014114, "chapter_id": 1291, "verse_number": "२-३२-३८", "content_sanskrit": "ततः प्रभृति ये केचिदज्ञानात्तां पुरीं नृपाः।\nजिगीषन्ति बलाद्राजंस्ते दह्यन्ते स्म वह्निना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2014115, "chapter_id": 1291, "verse_number": "२-३२-३९", "content_sanskrit": "तस्यां पुर्यां तदा चैव माहिष्मत्यां कुरूद्वह।\nबभूवुरनतिग्राह्य योषितश्छन्दतः किल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2014116, "chapter_id": 1291, "verse_number": "२-३२-४०", "content_sanskrit": "एवमग्निर्वरं प्रादात्स्त्रीणामप्रतिवारणे।\nस्वैरिण्यस्तत्र च राजानस्तत्पुरं भरतर्षभ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2014117, "chapter_id": 1291, "verse_number": "२-३२-४१", "content_sanskrit": "वर्जयन्ति च राजानस्तत्पुरं भरतर्षभ।\nभयादग्नेर्महाराज तदाप्रभृति सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2014118, "chapter_id": 1291, "verse_number": "२-३२-४२", "content_sanskrit": "सहदेवस्तु धर्मात्मा सैन्यं दृष्ट्वा भयार्दितम्।\nपरीतमग्निना राजन्नाकम्पत यथाऽचलः।\nउपस्पृश्य शुचिर्भूत्वा सोऽब्रवीत्पावकं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2014119, "chapter_id": 1291, "verse_number": "२-३२-४३x", "content_sanskrit": "सहदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2014120, "chapter_id": 1291, "verse_number": "२-३२-४३", "content_sanskrit": "त्वदर्थोऽयं समारम्भः कृष्णवर्त्मन्नमोस्तु ते।\nमुखं त्वमसि देवानां यज्ञस्त्वमसि पावक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2014121, "chapter_id": 1291, "verse_number": "२-३२-४४", "content_sanskrit": "पावनात्पावकश्चासि वहनाद्धव्यवाहनः।\nवेदास्त्वदर्थं जाता वै जातवेदास्ततो ह्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2014122, "chapter_id": 1291, "verse_number": "२-३२-४५", "content_sanskrit": "चित्रभानुः सुरेशश्च अनलस्त्वं विभावसो।\nस्वर्गद्वारस्पृशश्चासि हुताशो ज्वलनः शिखी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2014123, "chapter_id": 1291, "verse_number": "२-३२-४६", "content_sanskrit": "वैश्वानरस्त्वं पिङ्गेशः प्लवङ्गो भूरितेजसः।\nकुमारसूस्त्वं भगवान्रुद्रगर्भो हिरण्यकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2014124, "chapter_id": 1291, "verse_number": "२-३२-४७", "content_sanskrit": "अग्निर्ददातु मे तेजो वायुः प्राणं ददातु मे।\nपृथिवी बलमादध्याच्छिवं चापो दिशन्तु मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2014125, "chapter_id": 1291, "verse_number": "२-३२-४८", "content_sanskrit": "अपां गर्भ महासत्व जातवेदः सुरेश्वर।\nदेवानां मुखमग्ने त्वं सत्येन विपुनीहि माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2014126, "chapter_id": 1291, "verse_number": "२-३२-४९", "content_sanskrit": "ऋषिभिर्ब्राह्मणैश्चैव दैवतैरसुरैरपि।\nनित्यं सुहुत यज्ञेषु सत्येन विपुनीहि माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2014127, "chapter_id": 1291, "verse_number": "२-३२-५०", "content_sanskrit": "धूमकेतुः शिखी च त्वं पापहाऽनिसम्भवः।\nसर्वप्राणिषु नित्यस्थः सत्येन विपुनीहि माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2014128, "chapter_id": 1291, "verse_number": "२-३२-५१", "content_sanskrit": "एवं स्तुतोऽसि भगवन्प्रीतेन शिचिना मया।\nतुष्टिं पुष्टिं श्रुतं चैव प्रीति चाग्ने प्रयच्छ मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2014129, "chapter_id": 1291, "verse_number": "२-३२-५२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2014130, "chapter_id": 1291, "verse_number": "२-३२-५२", "content_sanskrit": "इत्येवं मन्त्रमाग्नेयं पठन्यो जुहुयाद्विभुम्।\nऋद्धिमान्सततं दान्तः सर्वपापैः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2014131, "chapter_id": 1291, "verse_number": "२-३२-५३x", "content_sanskrit": "सहदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2014132, "chapter_id": 1291, "verse_number": "२-३२-५३", "content_sanskrit": "यज्ञविघ्नमिमं कर्तुं नार्हस्त्वं यज्ञवाहन।\nएवमुक्त्वा तु माद्रेयः कुशैरास्तीर्य मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2014133, "chapter_id": 1291, "verse_number": "२-३२-५४", "content_sanskrit": "विधिवत्पुरुषव्याघ्रः पावकं प्रत्युपाविशत्।\nप्रमुखे तस्य सैन्यस्य भीतोद्विग्रस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2014134, "chapter_id": 1291, "verse_number": "२-३२-५५", "content_sanskrit": "न चैनमत्यगाद्वह्निरुवाच महोदधिः।\nतमुपेत्य शनैर्वह्निरुवाच कुरुनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2014135, "chapter_id": 1291, "verse_number": "२-३२-५६", "content_sanskrit": "सहदेवं नृणां देवं सान्त्वपूर्वमिदं वचः।\nउत्तिष्ठोत्तिष्ठ कौरव्य जिज्ञासेयं कृता मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2014136, "chapter_id": 1291, "verse_number": "२-३२-५७", "content_sanskrit": "वेद्मि सर्वमभिप्रायं तव धर्मसुतस्य च।\nमया तु रक्षितव्या पूरियं भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2014137, "chapter_id": 1291, "verse_number": "२-३२-५८", "content_sanskrit": "यावद्राज्ञो हि नीलस्य कुले वंशधरा इति।\nईप्सितं तु करिष्यामि मनसस्तव पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2014138, "chapter_id": 1291, "verse_number": "२-३२-५९", "content_sanskrit": "तत उत्थाय हृष्टात्मा प्राञ्जलिः शिरसा नतः।\nपूजयामास माद्रेयटः पावकं भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2014139, "chapter_id": 1291, "verse_number": "२-३२-६०", "content_sanskrit": "पावके विनिवृत्ते तु नीलो राजाऽभ्यगात्तदा।\nपावकस्याज्ञया चैनमर्चयामास पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2014140, "chapter_id": 1291, "verse_number": "२-३२-६१", "content_sanskrit": "सत्कारेण नरव्याघ्रं सहदेवं युधां पतिम्।\nप्रतिगृह्य च तां पूजां करे च विनिवेश्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2014141, "chapter_id": 1291, "verse_number": "२-३२-६२", "content_sanskrit": "माद्रीसुतस्ततः प्रायाद्विजयी दक्षिणां दिशम्।\nत्रैपुरं स वशे कृत्वा राजानममितौजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2014142, "chapter_id": 1291, "verse_number": "२-३२-६३", "content_sanskrit": "निजग्राह महाबाहुस्तरसा पौरवेश्वरम्।\nआकृतिं कौशिकाचार्यं यत्ने महता ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2014143, "chapter_id": 1291, "verse_number": "२-३२-६४", "content_sanskrit": "वशे चक्रे महाबाहुः सुराष्ट्राधिपतिं तदा।\nसुराष्ट्रविषयस्थश्च प्रेषयामास रुक्मिणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2014144, "chapter_id": 1291, "verse_number": "२-३२-६५", "content_sanskrit": "राज्ञे भोजकटस्थाय महामात्राय धीमते।\nभीष्मकायस धर्मात्मा साक्षादिन्द्रसखाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2014145, "chapter_id": 1291, "verse_number": "२-३२-६६", "content_sanskrit": "च चास्य प्रतिजग्राह ससुतः शासनं तदा।\nप्रीतिपूर्वं महाराज वासुदेवमवेक्ष्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2014146, "chapter_id": 1291, "verse_number": "२-३२-६७", "content_sanskrit": "ततः स रत्नान्यादाय पुनः प्रायाद्युधां पतिः।\nततः शूर्पारकं चैव तालाकटमथापि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2014147, "chapter_id": 1291, "verse_number": "२-३२-६८", "content_sanskrit": "वशे चक्रे महातेजा दण्डकांश्च महाबलः।\nसागरद्वीपवासांश्च नृपतीन्म्लेच्छयोनिजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2014148, "chapter_id": 1291, "verse_number": "२-३२-६९", "content_sanskrit": "निषादान्पुरुषादांश्च कर्णप्रावरणानपि।\nये च कालमुखा नाम नरराक्षसयोनयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2014149, "chapter_id": 1291, "verse_number": "२-३२-७०", "content_sanskrit": "कृत्स्नं कोलगिरिं चैव सुरभीपट्टनं तथा।\nद्वीपं ताम्राह्वयं चैव पर्वतं रामकं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2014150, "chapter_id": 1291, "verse_number": "२-३२-७१", "content_sanskrit": "तिमिङ्गिलं च स नृपं वशे कृत्वा महामतिः।\nएकपादांश्च पुरुषान्केरलान्वनवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2014151, "chapter_id": 1291, "verse_number": "२-३२-७२", "content_sanskrit": "नगरीं सञ्जयन्तीं च पाषण्डं करहाटकम्।\nदूतैरेव वशे चक्रे करं चैनानदापयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2014152, "chapter_id": 1291, "verse_number": "२-३२-७३", "content_sanskrit": "पाण्ड्यांश्च द्रविडांश्चैव सहितांश्चोड्रकेरलैः।\nअन्ध्रांस्तावनांश्चैव कलिङ्गानुष्ट्रकर्णिकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2014153, "chapter_id": 1291, "verse_number": "२-३२-७४", "content_sanskrit": "आटवीं च पुरीं रम्यां यवनानां पुरं तथा।\nदूतैरेव वशे चक्रे करं चैनानदापयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2014154, "chapter_id": 1291, "verse_number": "२-३२-७५", "content_sanskrit": "तात्रपर्णी ततो गत्वा कन्यातीर्थमतीत्य च।\nदक्षिणां च दिशं सर्वा विजित्य कुरुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2014155, "chapter_id": 1291, "verse_number": "२-३२-७६", "content_sanskrit": "उत्तरं तीरमासाद्य सागरस्योर्मिमालिनः।\nचिन्तयामास कौन्तेयो भ्रातुः पुत्रं घटोत्कचम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2014156, "chapter_id": 1291, "verse_number": "२-३२-७७", "content_sanskrit": "ततश्चिन्तितमात्रस्तु राक्षसः प्रत्यदृश्यत।\nतं मेरुशिखराकारमागतं पाण्डुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2014157, "chapter_id": 1291, "verse_number": "२-३२-७८", "content_sanskrit": "भृगुकच्छात्ततो धीमान्साम्नैवामित्रकर्शनः।\nआगम्यतामिति प्राह धर्मराजस्य शसनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2014158, "chapter_id": 1291, "verse_number": "२-३२-७९", "content_sanskrit": "स राक्षसपरीवारस्तं प्रणम्याशु संस्थितः।\nघटोत्कचं महात्मानं राक्षसं घोरदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2014159, "chapter_id": 1291, "verse_number": "२-३२-८०", "content_sanskrit": "तत्रस्थः प्रेषयामास पौलस्त्याय महात्मने।\nबिभीषणाय धर्मात्मा प्रीतिपूर्वमरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2014160, "chapter_id": 1291, "verse_number": "२-३२-८१", "content_sanskrit": "स चास्य प्रतिजग्राह शासनं प्रीतिपूर्वकम्।\nतच्च कृष्णकृतं धीमानभ्यमन्यत स प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2014161, "chapter_id": 1291, "verse_number": "२-३२-८२", "content_sanskrit": "ततः सम्प्रेषयामास रत्नानि विविधानि च।\nचन्दनागुरुकाष्ठानि दिव्यान्याभरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2014162, "chapter_id": 1291, "verse_number": "२-३२-८२x", "content_sanskrit": "वासांसि च महार्हाणि मणींश्चैव महाधनान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2014163, "chapter_id": 1291, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि दिग्विजयपर्वणि द्वात्रिंशोऽध्यायः॥ ३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]