[{"id": 40005024, "chapter_id": 8932, "verse_number": "1", "content_sanskrit": "सश्रूत्वा तु पितरं वृत्तं भ्रातरौ च विवासितौ। भरतो दुःखसन्तप्त इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40005025, "chapter_id": 8932, "verse_number": "2", "content_sanskrit": "किं नु कार्यं हतस्येह मम राज्येन शोचतः। विहीनस्याथ पित्रा च भ्रात्रा पितृसमेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40005026, "chapter_id": 8932, "verse_number": "3", "content_sanskrit": "दुःखे मे दुःखमकरोर्व्रणे क्षारमिवादधाः। राजानं प्रेतभावस्थं कृत्वा रामं च तापसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40005027, "chapter_id": 8932, "verse_number": "4", "content_sanskrit": "कुलस्य त्वमभावाय कालरात्रिरिवाऽगता। अङ्गारमुपगूह्य स्म पिता मे नावबुद्धवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40005028, "chapter_id": 8932, "verse_number": "5", "content_sanskrit": "मृत्युमापादितो पिता त्वया मे पापदर्शिनि। सुखं परिहृतं मोहात्कुलेऽस्मिन्कुलपांसनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40005029, "chapter_id": 8932, "verse_number": "6", "content_sanskrit": "त्वां प्राप्य हि पिता मेऽद्य सत्यसन्धो महायशाः। तीव्रदुःखाभिसन्तप्तो वृत्तो दशरथो नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40005030, "chapter_id": 8932, "verse_number": "7", "content_sanskrit": "विनाशितो महाराजः पिता मे धर्मवत्सलः। कस्मात्प्रव्राजितो रामः कस्मादेव वनं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40005031, "chapter_id": 8932, "verse_number": "8", "content_sanskrit": "कौसल्या च सुमित्रा च पुत्रशोकाभिपीडिते। दुष्करं यदि जीवेतां प्राप्य त्वां जननीं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40005032, "chapter_id": 8932, "verse_number": "9", "content_sanskrit": "ननुत्वार्योऽपि धर्मात्मा त्वयि वृतिमनुत्तमाम्। वर्तते गुरुवृत्तिज्ञो यथा मातरि वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40005033, "chapter_id": 8932, "verse_number": "10", "content_sanskrit": "तथा ज्येष्ठा हि मे माता कौसल्या दीर्घदर्शिनी। त्वयि धर्मं समास्थाय भगिन्यामिव वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40005034, "chapter_id": 8932, "verse_number": "11", "content_sanskrit": "तस्याः पुत्रं कृताऽत्मानं चीरवल्कलवाससम्। प्रस्थाप्य वनवासाय कथं पापे न शोचसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40005035, "chapter_id": 8932, "verse_number": "12", "content_sanskrit": "अपापदर्शनं शूरं कृतात्मानं यशस्विनम्। प्रव्राज्य चीरवसनं किन्नु पश्यसि कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40005036, "chapter_id": 8932, "verse_number": "13", "content_sanskrit": "﻿लुब्धाया विदितो मन्ये न तेऽहं राघवं प्रति। तथाह्यनर्धो राज्यार्थं त्वयाऽनीतो महानयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40005037, "chapter_id": 8932, "verse_number": "14", "content_sanskrit": "अहं हि पुरुषव्याघ्रावपश्यन्रामलक्ष्मणौ। केन शक्तिप्रभावेन राज्यं रक्षितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40005038, "chapter_id": 8932, "verse_number": "15", "content_sanskrit": "तं हि नित्यं महाराजो बलवन्तं महाबलः। उपाश्रितोऽभूद्धर्मात्मा मेरुर्मेरुवनं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40005039, "chapter_id": 8932, "verse_number": "16", "content_sanskrit": "सोऽहं कथमिमं भारं महाधुर्यसमुद्धृतम्। दम्योधुरमिवाऽऽसाद्य वहेयं केनचौजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40005040, "chapter_id": 8932, "verse_number": "17", "content_sanskrit": "अथवा मे भवेच्छक्तिर्योगैर्बुद्धिबलेन वा। सकामां न करिष्यामि त्वामहं पुत्रगर्धिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40005041, "chapter_id": 8932, "verse_number": "18", "content_sanskrit": "न मे विकाङ्क्षा जायेत त्यक्तुं त्वां पापनिश्चयाम्। यदि रामस्य नावेक्षा त्वयि स्यान्मातृवत्सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40005042, "chapter_id": 8932, "verse_number": "19", "content_sanskrit": "उत्पन्नातु कथं बुद्धिस्तवेयं पापदर्शिनि। साधुचारित्रविभ्रष्टे पूर्वेषां नो विगर्हिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40005043, "chapter_id": 8932, "verse_number": "20", "content_sanskrit": "अस्मिन्कुले हि पूर्वेषां ज्येष्ठो राज्येऽभिषिच्यते। अपरे भ्रातरस्तस्मिन्प्रवर्तन्ते समाहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40005044, "chapter_id": 8932, "verse_number": "21", "content_sanskrit": "न हि मन्ये नृशंसे त्वं राजधर्ममवेक्षसे। गतिं वा न विजानासि राजवृत्तस्य शाश्वतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40005045, "chapter_id": 8932, "verse_number": "22", "content_sanskrit": "﻿सततं राजवृत्ते हि ज्येष्ठो राज्येऽभिषिच्यते। राज्ञामेतत्समं तत्स्यादिक्ष्वाकूणां विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40005046, "chapter_id": 8932, "verse_number": "23", "content_sanskrit": "तेषां धर्मैकरक्षाणां कुलचारित्रशोभिनाम्। अद्य चारित्रशौण्डीर्यं त्वां प्राप्य विनिवर्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40005047, "chapter_id": 8932, "verse_number": "24", "content_sanskrit": "तवापि सुमहाभागा जनेन्द्राः कुलपूर्वगाः। बुद्धेर्मोहः कथमयं सम्भूतस्त्वयि गर्हितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40005048, "chapter_id": 8932, "verse_number": "25", "content_sanskrit": "न तु कामं करिष्यामि तवाऽहं पापनिश्चये। त्वया व्यसनमारब्धं जीवितान्तकरं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40005049, "chapter_id": 8932, "verse_number": "26", "content_sanskrit": "एषत्विदानीमेवाहमप्रियार्थं तवानघम्। निवर्तयिष्यामि वनाद्भ्रातरं स्वजनप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40005050, "chapter_id": 8932, "verse_number": "27", "content_sanskrit": "निवर्तयित्वा रामं च तस्याहं दीप्ततेजसः। दासभूतो भविष्यामि सुस्थिरेणान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40005051, "chapter_id": 8932, "verse_number": "28", "content_sanskrit": "इत्येवमुक्त्वा भरतो महात्मा प्रियेतरैर्वाक्यगणैस्तुदंस्ताम्। शोकातुरश्चापि ननाद भूयः सिंहो यथा पर्वतगह्वरस्थः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]