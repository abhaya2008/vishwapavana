[{"id": 7006190000, "chapter_id": 26190, "verse_number": "२-१८-१", "content_sanskrit": "बृहस्पतिरुवाच यमस्तु यानि श्राद्धानि प्रोवाच शशबिन्दवे ।\nतानि मे शृणु कार्याणि नक्षत्रेषु पृथक्पृथक् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006190001, "chapter_id": 26190, "verse_number": "२-१८-२", "content_sanskrit": "श्राद्धं यः कृत्तिकायोगं कुरुते सततं नरः ।\nअग्नीनाधाय स स्वर्गे राजते सुदृढव्रतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006190002, "chapter_id": 26190, "verse_number": "२-१८-३", "content_sanskrit": "अपत्यकामो रोहिण्यां सौम्ये तेजस्विना भवेत् ।\nप्रायशः क्रूरकर्माणि आर्द्रायां श्राद्धमाचरन् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006190003, "chapter_id": 26190, "verse_number": "२-१८-४", "content_sanskrit": "क्षेत्रभागी भवेत्पुत्री श्राद्धं कृत्वा पुनर्वसौ ।\nपुष्टिकामः पुनस्तिष्ये श्राद्धं कुर्वीत मानवः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006190004, "chapter_id": 26190, "verse_number": "२-१८-५", "content_sanskrit": "आश्लेषासु पितॄनर्चन्वीरान्पुत्रानवाप्नुयात् ।\nजातीनां भवति श्रेष्ठो मघासु श्राद्धमाचरन् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006190005, "chapter_id": 26190, "verse_number": "२-१८-६", "content_sanskrit": "फाल्गुनीषु पितॄनर्चन्सौभाग्यं लभते नरः ।\nप्रदानशीलः सापत्य उत्तरासु करोति यः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006190006, "chapter_id": 26190, "verse_number": "२-१८-७", "content_sanskrit": "संसत्सु मुख्यो भवति हस्तेऽभ्यर्च्य पितॄनपि ।\nचित्रायां चैव यः कुर्यात्पश्येद्रूपवतः सुतान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006190007, "chapter_id": 26190, "verse_number": "२-१८-८", "content_sanskrit": "स्वातिना चैव यः कुर्याद्वाणिज्ये लाभमाप्नुयात् ।\nपुत्रार्थी तु विशाखासु श्राद्धमीहेत मालवः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006190008, "chapter_id": 26190, "verse_number": "२-१८-९", "content_sanskrit": "अनुराधासु कुर्वाणो नरश्चक्रं प्रवर्त्तयेत् ।\nआधिपत्यं भवेच्छ्रेष्ठं ज्येष्ठायां सततं तु यः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006190009, "chapter_id": 26190, "verse_number": "२-१८-१०", "content_sanskrit": "मूलेनारोग्यमिच्छन्ति ह्याषाढासु महद्यशः ।\nउत्तरासु तु कुर्वाणो वीतशोको भवेन्नरः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006190010, "chapter_id": 26190, "verse_number": "२-१८-११", "content_sanskrit": "श्रवणेन तु लोकेषु प्राप्नुयात्परमां गतिम् ।\nराज्यभागी धनिष्ठासु प्राप्नुया द्विपुलं धनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006190011, "chapter_id": 26190, "verse_number": "२-१८-१२", "content_sanskrit": "श्राद्धनिर्जितलोकश्च वेदान् सांगानवाप्नुयात् ।\nनक्षत्रैर्वारुणैः कुर्वन्भिषक्सिद्धिमवाप्नुयात् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006190012, "chapter_id": 26190, "verse_number": "२-१८-१३", "content_sanskrit": "पूर्वप्रौष्ठ पदे कुर्वन्विन्देताजीविकान्बहून् ।\nउत्तरास्वनतिक्रम्य विन्देद्गा वै सहस्रशः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006190013, "chapter_id": 26190, "verse_number": "२-१८-१४", "content_sanskrit": "बहुकुप्यकृतं द्रव्यं विन्देत्कुर्वन्सुरेवतीम् ।\nअश्वानश्वयुजा भक्तो भरण्यां साधुसत्तमः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006190014, "chapter_id": 26190, "verse_number": "२-१८-१५", "content_sanskrit": "इमं श्राद्धविधिं कुर्वञ्छशबिन्दुर्महीमिमाम् ।\nकृत्स्नां बलेन सोऽक्लिष्ठो लभ्ध्वा च प्रशशास ह ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]