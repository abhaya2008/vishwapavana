[{"id": 2042026, "chapter_id": 1934, "verse_number": "५-१७९-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042027, "chapter_id": 1934, "verse_number": "५-१७९-१", "content_sanskrit": "तमहं स्मयन्निव रणे प्रत्यभाषं व्यवस्थितम्।\nभूमिष्ठं नोत्सहे योद्धुं भवन्तं रथमास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042028, "chapter_id": 1934, "verse_number": "५-१७९-२", "content_sanskrit": "आरोह स्यन्दनं वीर कवचं च महाभुज ।\nबधान समरे राम यदि योद्धुं मयेच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042029, "chapter_id": 1934, "verse_number": "५-१७९-३", "content_sanskrit": "ततो मामब्रवीद्रामः स्मयमानो रणाजिरे ।\nरथो मे मेदिनी भीष्म वाहा वेदाः सदश्ववत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042030, "chapter_id": 1934, "verse_number": "५-१७९-४", "content_sanskrit": "सूतश्च मातरिश्वा वै कवचं वेदमातरः ।\nसुसंवीतो रणे ताभिर्योत्स्येऽहं कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042031, "chapter_id": 1934, "verse_number": "५-१७९-५", "content_sanskrit": "एवं ब्रुवाणो गान्धारे रामो मां सत्यविक्रमः।\nशरव्रातेन महता सर्वतः प्रत्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042032, "chapter_id": 1934, "verse_number": "५-१७९-६", "content_sanskrit": "ततोऽपश्यं जामदग्न्यं रथमध्ये व्यवस्थितम् ।\nसर्वायुधवरे श्रीमत्यद्भुतोपमदर्शने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042033, "chapter_id": 1934, "verse_number": "५-१७९-७", "content_sanskrit": "मनसा विहिते पुण्ये विस्तीर्णे नगरोपभे ।\nदिव्याश्वयुजि सन्नद्वे काञ्चनेन विभूषिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042034, "chapter_id": 1934, "verse_number": "५-१७९-८", "content_sanskrit": "कवचेन महाबाहो सोमार्ककृतलक्ष्मणा।\nधनुर्धरो बद्धतूणो बद्धगोधाङ्गुलित्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042035, "chapter_id": 1934, "verse_number": "५-१७९-९", "content_sanskrit": "सारथ्यं कृतवांस्तत्र युयुत्सोरकुतव्रणः ।\nसखा वेदविदत्यन्तं दयितो भार्गवस्य ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042036, "chapter_id": 1934, "verse_number": "५-१७९-१०", "content_sanskrit": "आह्वयानः स मां युद्धे मनो हर्षयतीव मे ।\nपुनः पुनरभिक्रोशन्नभियाहीति भार्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042037, "chapter_id": 1934, "verse_number": "५-१७९-११", "content_sanskrit": "तमादित्यमिवोद्यन्तमनाधृष्यं महाबलम् ।\nक्षत्रियान्तकरं राममेकमेकः समासदूम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042038, "chapter_id": 1934, "verse_number": "५-१७९-१२", "content_sanskrit": "ततोऽहं बाणपातेषु त्रिषु वाहान्निगृह्य वै ।\nअवतीर्य धनुर्न्यस्य पदातिर्ऋषिसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042039, "chapter_id": 1934, "verse_number": "५-१७९-१३", "content_sanskrit": "अभ्यागच्छं तदा राममर्चिष्यन्द्विजसत्तमम् ।\nअभिवाद्य चैनं विधिवदब्रुवं वाक्यमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042040, "chapter_id": 1934, "verse_number": "५-१७९-१४", "content_sanskrit": "योत्स्ये त्वया रणे राम सदृशेनाधिकेन वा ।\nगुरुणा धर्मशीलेन जयमाशास्व मे विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042041, "chapter_id": 1934, "verse_number": "५-१७९-१५x", "content_sanskrit": "राम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042042, "chapter_id": 1934, "verse_number": "५-१७९-१५", "content_sanskrit": "एवमेतत्कुरुश्रेष्ठ कर्तव्यं भूतिमिच्छता।\nधर्मो ह्येष महाबाहो विशिष्टैः सह युध्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042043, "chapter_id": 1934, "verse_number": "५-१७९-१६", "content_sanskrit": "शपेयं त्वां नचेदेवमागच्छेथा विशांपते ।\nयुध्यस्व त्वं रणे यत्तो धैर्यमालम्ब्य कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042044, "chapter_id": 1934, "verse_number": "५-१७९-१७", "content_sanskrit": "न तु ते जयमाशासे त्वां विजेतुमहं स्थितः ।\nगच्छ युध्यस्व धर्मेण प्रीतोऽस्मि चरितेन ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042045, "chapter_id": 1934, "verse_number": "५-१७९-१८", "content_sanskrit": "ततोऽहं तं नमस्कृत्य रथमारुह्य सत्वरः ।\nप्राध्मापयं रणे शङ्खं पुनर्हेमपरिष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042046, "chapter_id": 1934, "verse_number": "५-१७९-१९", "content_sanskrit": "ततो युद्धं समभवन्मम तस्य च भारत ।\nदिवसान्सुबहून्राजन्परस्परजिगीषया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042047, "chapter_id": 1934, "verse_number": "५-१७९-२०", "content_sanskrit": "स मे तस्मिन्रणे पूर्वं प्राहरत्कङ्खपत्रिभिः ।\nवष्ट्या शतैश्च नवभिः शराणां नतषर्वणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042048, "chapter_id": 1934, "verse_number": "५-१७९-२१", "content_sanskrit": "चत्वारस्तेन मे वाहाः सूतश्चैव विशांपते ।\nप्रतिरुद्धास्तथैवाहं समरे दंशितः स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042049, "chapter_id": 1934, "verse_number": "५-१७९-२२", "content_sanskrit": "नमस्कृत्य च देवेभ्यो ब्राह्मणेभ्यो विशेषतः ।\nतमहं स्मयन्निव रणे प्रत्यभाषं व्यवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042050, "chapter_id": 1934, "verse_number": "५-१७९-२३", "content_sanskrit": "आचार्यता मानिता मे निर्मर्यादे ह्यपि त्वयि ।\nभूयश्च शृणु मे ब्रह्मन्संपदं धर्मसंग्रहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2042051, "chapter_id": 1934, "verse_number": "५-१७९-२४", "content_sanskrit": "ये ते वेदाः शरीरस्था .... यच्च ते महत् ।\nतपश्च ते महत्तप्तं न तेभ्यः प्रहराम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2042052, "chapter_id": 1934, "verse_number": "५-१७९-२५", "content_sanskrit": "प्रहरे क्षत्रधर्मस्य यं त्वं राम समाश्रितः ।\nब्राह्मणः क्षत्रियत्वं हि याति शस्त्रसमुद्यमात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2042053, "chapter_id": 1934, "verse_number": "५-१७९-२६", "content_sanskrit": "पश्य मे धनुषो वीर्यं पश्य बाह्वोर्बलं मम।\nएष ते कार्मुक वीर छिनद्मि निशितेषुणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2042054, "chapter_id": 1934, "verse_number": "५-१७९-२७", "content_sanskrit": "तस्याहं निशितं भल्लं चिक्षेप भरतर्षभ ।\nतेनास्य धनुषः कोटिं छित्वा भूमावपातयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2042055, "chapter_id": 1934, "verse_number": "५-१७९-२८", "content_sanskrit": "तथैव च पृषत्कानां शतानि नतपर्वणाम् ।\nचिक्षेप कङ्कपत्राणां जामदग्न्यरथं प्रति ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2042056, "chapter_id": 1934, "verse_number": "५-१७९-२९", "content_sanskrit": "काये विषक्तास्तु तदा वायुना समुदीरिताः।\nचेलुः क्षरन्तो रुधिरं नागा इव च ते शराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2042057, "chapter_id": 1934, "verse_number": "५-१७९-३०", "content_sanskrit": "क्षतजोक्षितसर्वाङ्गः क्षरन्स रुधिरं रणे।\nबभौ रामस्तथा राजन्प्रफुल्ल इव किंशुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2042058, "chapter_id": 1934, "verse_number": "५-१७९-३१", "content_sanskrit": "हेमन्तान्तेऽशोक इव रक्तस्तबकमण्डितः।\nबभौ रामस्तथा राजन्प्रफुल्ल इव किंशुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2042059, "chapter_id": 1934, "verse_number": "५-१७९-३२", "content_sanskrit": "ततोऽन्यद्धनुरादाय रामः क्रोधसमन्वितः ।\nहेमपुङ्खान्सुनिशिताञ्शरांस्तान्हि ववर्ष सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2042060, "chapter_id": 1934, "verse_number": "५-१७९-३३", "content_sanskrit": "ते समासाद्य मां रौद्रा बहुधा मर्मभेदिनः ।\nअकम्पयन्महावेगाः सर्पानलविषोपमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2042061, "chapter_id": 1934, "verse_number": "५-१७९-३४", "content_sanskrit": "तमहं समवष्टभ्य पुनरात्मानमाहवे ।\nशतसंख्यैः शरैः क्रुद्धस्तदा राममवाकिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2042062, "chapter_id": 1934, "verse_number": "५-१७९-३५", "content_sanskrit": "स तैरग्न्यर्कसङ्काशैः शरैराशीविषोपमैः ।\nशितैरभ्यर्दितो रामो मन्दचेता इवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2042063, "chapter_id": 1934, "verse_number": "५-१७९-३६", "content_sanskrit": "ततोऽहं कृपयाऽऽविष्टो विनिन्द्यात्मानमात्मना ।\nधिग्धिगित्यब्रुवं युद्धं क्षत्रधर्मं च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2042064, "chapter_id": 1934, "verse_number": "५-१७९-३७", "content_sanskrit": "असकृच्चाब्रुवं राजञ्शोकवेगपरिप्लुतः ।\nअहो बत कृतं पापं मयेदं क्षत्रधर्मं च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2042065, "chapter_id": 1934, "verse_number": "५-१७९-३८", "content_sanskrit": "गुरुर्द्विजातिर्धर्मात्मा यदेवं पीडितः शरैः।\nततो न प्राहरं भूयो जामदग्न्याय भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2042066, "chapter_id": 1934, "verse_number": "५-१७९-३९", "content_sanskrit": "अथावताप्य पृथिवीं पूषा दिवसमंक्षये।\nजगामास्तं सहस्रांशुस्ततो युद्धमुपारमत् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2042067, "chapter_id": 1934, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वणि एकोनाशीत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]