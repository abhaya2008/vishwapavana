[{"id": 2022275, "chapter_id": 1466, "verse_number": "३-१०४-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022276, "chapter_id": 1466, "verse_number": "३-१०४-१", "content_sanskrit": "समुद्रं स समासाद्य वारुणिर्भगवानृषिः।\nउवाच सहितान्देवानृषींश्चैव समागतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022277, "chapter_id": 1466, "verse_number": "३-१०४-२", "content_sanskrit": "एष लोकहितार्थं वै पिबामि वरुणालयम्।\nभवद्भिर्यदनुष्ठेयं तच्छीघ्रं संविधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022278, "chapter_id": 1466, "verse_number": "३-१०४-३", "content_sanskrit": "एतावदुक्त्वा वचनं मैत्रावरुणिरच्युतः।\nसमुद्रमपिबत्क्रुद्धः सर्वलोकस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022279, "chapter_id": 1466, "verse_number": "३-१०४-४", "content_sanskrit": "पीयमानं समुद्रं तं दृष्ट्वा सेन्द्रास्तदाऽमराः।\nविस्मयं परमं जग्मुः स्तुतिभिश्चाप्यपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022280, "chapter_id": 1466, "verse_number": "३-१०४-५", "content_sanskrit": "त्वं नस्त्राता विधाता च लोकानां लोकभावन।\nत्वत्प्रसादात्समुच्छेदं न गच्छेत्सामरं जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022281, "chapter_id": 1466, "verse_number": "३-१०४-६", "content_sanskrit": "स पूज्यमानस्त्रिदशैर्महात्मा\nगन्धर्वतूर्येषु नदत्सु सर्वशः।\nदिव्यैश्च पुष्पैरवकीर्यमाणो\nमहार्णवं निःसलिलं चकार ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022282, "chapter_id": 1466, "verse_number": "३-१०४-७", "content_sanskrit": "दृष्ट्वा कृतंनिःसलिलं महार्णवं\nसुराः समस्ताः परमप्रहृष्टाः। ३-१०४-७cप्रगृह्य दिव्यानिवरायुधानि\nतान्दानवाञ्जघ्रुरदीनसत्वाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022283, "chapter_id": 1466, "verse_number": "३-१०४-८", "content_sanskrit": "ते वध्यमानास्त्रिदशैर्महात्मभि-\nर्महाबलैर्वेगिभिरुन्नदद्भिः।\nन सेहिरेवेगवतां महात्मनां\nवेगं तदा धारयितुं दिवौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022284, "chapter_id": 1466, "verse_number": "३-१०४-९", "content_sanskrit": "ते वध्यमानास्त्रिदशैर्दानवा भीमनिःस्वनाः।\nरचक्रु सुतुमुलं युद्धं मुहूर्तमिव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022285, "chapter_id": 1466, "verse_number": "३-१०४-१०", "content_sanskrit": "ते पूर्वं तपसा दग्धा मुनिभिर्भावितात्मभिः।\nयतमानाः परं शक्त्या त्रिदशैर्विनिषूदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022286, "chapter_id": 1466, "verse_number": "३-१०४-११", "content_sanskrit": "तेहेमनिष्काभरणाः कुण्डलाङ्गदधारिणः।\nनिहता बह्वशोभन्त पुष्पिता इव किंशुकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022287, "chapter_id": 1466, "verse_number": "३-१०४-१२", "content_sanskrit": "हतशेषास्ततः केचित्कालेया मनुजोत्तम।\nविदार्य वसुधां देवीं पातालतलमास्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022288, "chapter_id": 1466, "verse_number": "३-१०४-१३", "content_sanskrit": "निहतान्दानवान्दृष्ट्वा त्रिदशा मुनिपुह्गवम्।\nतुष्टुवुर्विविधैर्वाक्यैरिदं वचनमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022289, "chapter_id": 1466, "verse_number": "३-१०४-१४", "content_sanskrit": "त्वत्प्रसादान्महाबाहो लोकैः प्राप्तं महत्सुखम्।\nत्वत्तेजसा च निहताः कालेयाः क्रूरविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022290, "chapter_id": 1466, "verse_number": "३-१०४-१५", "content_sanskrit": "पूरस्व महाबाहो समुद्रं लोकभावन।\nयत्त्वया सलिलं पीतं तदस्मिन्पुनरुत्सृज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022291, "chapter_id": 1466, "verse_number": "३-१०४-१६", "content_sanskrit": "एवमुक्तः प्रत्युवाच भगवान्मुनिपुङ्गवः।\n`तांस्तदा सहितान्देवानगस्त्यःसपुरन्दरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022292, "chapter_id": 1466, "verse_number": "३-१०४-१७", "content_sanskrit": "जीर्णं तद्धि मया तोयमुपायोऽन्यः प्रचिन्त्यताम्।\nपूरणार्थं समुद्रस्य भवद्भिर्यत्नमास्थितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022293, "chapter_id": 1466, "verse_number": "३-१०४-१८", "content_sanskrit": "केतच्छ्रुत्वा तु वचनं महर्षेर्भावितात्मनः।\nविस्मिताश्च विषण्णाश्च बभूवुः सहिताः सुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022294, "chapter_id": 1466, "verse_number": "३-१०४-१९", "content_sanskrit": "परस्परमनुज्ञाप्यप्रणम्य मुनिपुङ्गवम्।\nप्रजाः सर्वा महाराज विप्रजग्मुर्यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022295, "chapter_id": 1466, "verse_number": "३-१०४-२०", "content_sanskrit": "त्रिदशा विष्णुना सार्धमुपजग्मुः पितामहम्।\nपूरणार्थं समुद्रस्य मन्त्रयित्वा पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022296, "chapter_id": 1466, "verse_number": "३-१०४-२१", "content_sanskrit": "ते धातारमुपागम्य त्रिदशाः सह विष्णुना।\nऊचुः प्राञ्जलयः सर्वे सागरस्याभिपूरणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022297, "chapter_id": 1466, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि चतुरधिकशततमोऽध्यायः ॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]