[{"id": 2037897, "chapter_id": 1822, "verse_number": "५-६७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037898, "chapter_id": 1822, "verse_number": "५-६७-१", "content_sanskrit": "अर्जुनो वासुदेवश्च धन्विनौ परमार्थितौ।\nकामादन्यत्र संभूतौ सर्वभावाय संमितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037899, "chapter_id": 1822, "verse_number": "५-६७-२", "content_sanskrit": "व्यामान्तरं समास्थय यथामुक्तं मनस्विनः ।\nचक्रं तद्वासुदेवस्य मायया वर्तते विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037900, "chapter_id": 1822, "verse_number": "५-६७-३", "content_sanskrit": "सापह्नवं कौरवेषु पाण्डवानां सुसंमतम्।\nसारासारबलं ज्ञातुं तेजःपुञ्जावभासितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037901, "chapter_id": 1822, "verse_number": "५-६७-४", "content_sanskrit": "नरकं शम्बरं चैव कंसं चैद्यं च माधवः।\nजितवान्घोरसङ्काशान्क्रीडन्निव महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037902, "chapter_id": 1822, "verse_number": "५-६७-५", "content_sanskrit": "पृथिवीं चान्तरिक्षं च द्यां चैव पुरुषोत्तमः ।\nमनसैव विशिष्टात्मा नयत्यात्मवशं वशी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037903, "chapter_id": 1822, "verse_number": "५-६७-६", "content_sanskrit": "भूयो भूयो हि यद्राजन्पृच्छसे पाण्डवान्प्रति ।\nसारासारबलं ज्ञातुं तत्समासेन मे शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037904, "chapter_id": 1822, "verse_number": "५-६७-७", "content_sanskrit": "एकतो वा जगत्कृत्स्नमेकतो वा जनार्दनः।\nसारतो जगतः कृत्स्नादतिरिक्तो जनार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037905, "chapter_id": 1822, "verse_number": "५-६७-८", "content_sanskrit": "भस्म कुर्याञ्जगदिदं मनसैव जनार्दनः ।\nन तु कृत्स्नं जगच्छक्तं किञ्चित्कर्तुं जनार्दने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037906, "chapter_id": 1822, "verse_number": "५-६७-९", "content_sanskrit": "यतः सत्यं यतो धर्मो यतो ह्रीरार्जवं यतः।\nततो भवति गोविन्दो यतः कृष्णस्ततो जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037907, "chapter_id": 1822, "verse_number": "५-६७-१०", "content_sanskrit": "पृथिवीं चान्तरिक्षं च दिवं च पुरुषोत्तमः।\nविचेष्टयति भूतात्मा क्रीडन्निव जनार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037908, "chapter_id": 1822, "verse_number": "५-६७-११", "content_sanskrit": "स कृत्वा पाण्डवान्सत्रं लोकं संमोहयन्निव ।\nअधर्मनिरतान्मूढान्दग्धुमिच्छति ते सुतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037909, "chapter_id": 1822, "verse_number": "५-६७-१२", "content_sanskrit": "कालचक्रं जगच्चक्रं युगचक्रं च केशवः।\nआत्मयोगेन भगवान्परिवर्तयतेऽनिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037910, "chapter_id": 1822, "verse_number": "५-६७-१३", "content_sanskrit": "कालस्य च हि मृत्योश्च जङ्गमस्थावरस्य च ।\nईष्टे हि भगवानेकः सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037911, "chapter_id": 1822, "verse_number": "५-६७-१४", "content_sanskrit": "ईशन्नपि महायोगी सर्वस्य जगतो हरिः।\nकर्माण्यारभते कर्तुं कीनाश इव दुर्बलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037912, "chapter_id": 1822, "verse_number": "५-६७-१५", "content_sanskrit": "तेन वञ्चयते लोकान्मायायोगेन केशवः ।\nये तमेव प्रपद्यन्ते न ते मुह्यन्ति मानवाः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037913, "chapter_id": 1822, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि सप्तषष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]