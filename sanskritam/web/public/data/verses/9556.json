[{"id": 5000556000, "chapter_id": 9556, "verse_number": "७-२१-१", "content_sanskrit": "एवं सञ्चिन्त्य विप्रेन्दो जगाम लघुविक्रमः ।\nआख्यातुं तद्यथावृत्तं यमस्य सदनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000556001, "chapter_id": 9556, "verse_number": "७-२१-२", "content_sanskrit": "अपश्यत्स यमं तत्र देवमग्निपुरस्कृतम् ।\nविधानमुपतिष्ठन्तं प्राणिनो यस्य यादृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000556002, "chapter_id": 9556, "verse_number": "७-२१-३", "content_sanskrit": "स तु दृष्ट्वा यमः प्राप्तं महर्षिं तत्र नारदम् ।\nअब्रवीत्सुखमासीनमर्घ्यमावेद्य धर्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000556003, "chapter_id": 9556, "verse_number": "७-२१-४", "content_sanskrit": "कच्चित्क्षेमं तु देवर्षे कच्चिद्धर्मो न नश्यति ।\nकिमागमनकृत्यं ते देवगन्धर्वसेवित ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000556004, "chapter_id": 9556, "verse_number": "७-२१-५", "content_sanskrit": "अब्रवीत्तु तदा वाक्यं नारदो भगवानृषिः ।\nश्रूयतामभिधास्यामि विधानं च विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000556005, "chapter_id": 9556, "verse_number": "७-२१-६", "content_sanskrit": "एष नाम्नो दशग्रीवः पितृराज निशाचरः ।\nउपयाति वशं नेतुं विक्रमैस्त्वां सुदुर्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000556006, "chapter_id": 9556, "verse_number": "७-२१-७", "content_sanskrit": "एतेन कारणेनाहं त्वरितो ह्यागतः प्रभो ।\nदण्डप्रहरणस्याद्य तव किं नु भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000556007, "chapter_id": 9556, "verse_number": "७-२१-८", "content_sanskrit": "एतस्मिन्नन्तरे दुरादंशुमन्तमिवोदितम् ।\nददृशुर्दीप्तमायान्तं विमानं तस्य रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000556008, "chapter_id": 9556, "verse_number": "७-२१-९", "content_sanskrit": "तं देशं प्रभया तस्य पुष्पकस्य महाबलः ।\nकृत्वा वितिमिरं सर्वं समीपं सो ऽभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000556009, "chapter_id": 9556, "verse_number": "७-२१-१०", "content_sanskrit": "सो ऽपश्यत्स महाबाहुर्दशग्रीवस्ततस्ततः ।\nप्राणिनः सुकृतं कर्म भुञ्जानांश्चैव दुष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000556010, "chapter_id": 9556, "verse_number": "७-२१-११", "content_sanskrit": "अपश्यत्सैनिकांश्चास्य यमस्यानुचरैः सह ।\nयमस्य पुरुषैरुग्रैर्घोररूपैर्भयानकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000556011, "chapter_id": 9556, "verse_number": "७-२१-१२", "content_sanskrit": "ददर्श वध्यमानांश्च क्लिश्यमानांश्च देहिनः ।\nक्रोशतश्च महानादं तीव्रनिष्टनतत्परान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000556012, "chapter_id": 9556, "verse_number": "७-२१-१३", "content_sanskrit": "कृमिभिर्भक्ष्यमाणांश्च सारमेयैश्च दारुणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000556013, "chapter_id": 9556, "verse_number": "७-२१-१४", "content_sanskrit": "क्षोत्रायासकरा वाचो वदतश्च भयावहाः ।\nसन्तार्यमाणान्वैतरणीं बहुशः शोणितोदकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000556014, "chapter_id": 9556, "verse_number": "७-२१-१५", "content_sanskrit": "वालुकासु च तप्तासु तप्यमानान्मुहूर्मुहुः ।\nअसिपत्रवने चैव भिद्यमानानधार्मिकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000556015, "chapter_id": 9556, "verse_number": "७-२१-१६", "content_sanskrit": "रौरवे क्षारनद्यां च क्षुरधारासु चैव हि ।\nपानीयं याचमानांश्च तृषितान्क्षुधितानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000556016, "chapter_id": 9556, "verse_number": "७-२१-१७", "content_sanskrit": "शवभूतान्कृशान्दीनान्विवर्णान्मुक्तमूर्धजान् ।\nमलपङ्कधरान्दीनान्रूक्षांश्च परिधावतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000556017, "chapter_id": 9556, "verse_number": "७-२१-१८", "content_sanskrit": "ददर्श रावणो मार्गे शतशो ऽथ सहस्रशः ।\nकांश्चिच्च गृहमुख्येषु गीतवादित्रनिःस्वनैः ।\nप्रमोदमानानद्राक्षीद्रावणः सुकृतैः स्वकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000556018, "chapter_id": 9556, "verse_number": "७-२१-१९", "content_sanskrit": "गौरसं गोप्रदातारो ह्यन्नं चैवान्नदायिनः ।\nगृहांश्च गृहदातारः स्वकर्मफलमश्नतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000556019, "chapter_id": 9556, "verse_number": "७-२१-२०", "content_sanskrit": "सुवर्णमणिमुक्ताभिः प्रमदाभिरलङ्कृतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000556020, "chapter_id": 9556, "verse_number": "७-२१-२१", "content_sanskrit": "धार्मिकानपरांस्तत्र दीप्यमानान्स्वतेजसा ।\nददर्श सुमहाबाहू रावणो राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000556021, "chapter_id": 9556, "verse_number": "७-२१-२२", "content_sanskrit": "ततस्तान्भिद्यमानांश्च कर्मभिर्दुष्कृतैः स्वकैः ।\nरावणो मोचयामास विक्रमेण बलाद्बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000556022, "chapter_id": 9556, "verse_number": "७-२१-२३", "content_sanskrit": "प्राणिनो मोचितास्तेन दशग्रीवेण रक्षसा ।\nसुखमापुर्मुहूर्तं ते ह्यतर्कितमचिन्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000556023, "chapter_id": 9556, "verse_number": "७-२१-२४", "content_sanskrit": "प्रेतेषु मुच्यमानेषु राक्षसेन महीयसा ।\nप्रेतगोपाः सुसङ्क्रुद्धा राक्षसेन्द्रमभिद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000556024, "chapter_id": 9556, "verse_number": "७-२१-२५", "content_sanskrit": "ततो हलहलाशब्दः सर्वदिग्भ्यः समुत्थितः ।\nधर्मराजस्य योधानां शूराणां सम्प्रधावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000556025, "chapter_id": 9556, "verse_number": "७-२१-२६", "content_sanskrit": "ते प्रासैः परिघैः शूलैर्मुसलैः शक्तितोमरैः ।\nपुष्पकं समवर्षन्त शूराः शतसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000556026, "chapter_id": 9556, "verse_number": "७-२१-२७", "content_sanskrit": "तस्यासनानि प्रासादान्वेदिकास्तोरणानि च ।\nपुष्पकस्य बभञ्जुस्ते शीघ्रं मधुकरा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000556027, "chapter_id": 9556, "verse_number": "७-२१-२८", "content_sanskrit": "देवनिष्ठानभूतं तद्विमानं पुष्पकं मृधे ।\nभज्यमानं तथैवासीदक्षयं ब्रह्मतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000556028, "chapter_id": 9556, "verse_number": "७-२१-२९", "content_sanskrit": "असङ्ख्या सुमहत्यासीत्तस्य सेना महात्मनः ।\nशूराणामग्रयातऽणां सहस्राणि शतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000556029, "chapter_id": 9556, "verse_number": "७-२१-३०", "content_sanskrit": "ततो वृक्षैश्च शैलैश्च प्रासादानां शतैस्तथा ।\nततस्ते सचिवास्तस्य यथाकामं यथाबलम् ।\nअयुध्यन्त महावीराः स च राजा दशाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000556030, "chapter_id": 9556, "verse_number": "७-२१-३१", "content_sanskrit": "ते तु शोणितदिग्धाङ्गाः सर्वशस्त्रसमाहताः ।\nअमात्या राक्षसेन्द्रस्य चक्रुरायोधनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000556031, "chapter_id": 9556, "verse_number": "७-२१-३२", "content_sanskrit": "अन्योन्यं ते महाभागा जघ्नुः प्रहरणैर्भृशम् ।\nयमस्य च महाबाहो रावणस्य च मन्त्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000556032, "chapter_id": 9556, "verse_number": "७-२१-३३", "content_sanskrit": "अमात्यांस्तांस्तु सन्त्यज्य यमयोधा महाबलाः ।\nतमेव चाभ्यधावन्त शूलवर्षैर्दशाननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000556033, "chapter_id": 9556, "verse_number": "७-२१-३४", "content_sanskrit": "ततः शोणितदिग्धाङ्गः प्रहारैर्जर्जरीकृतः ।\nफुल्लाशोक इवाभाति पुष्पके राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000556034, "chapter_id": 9556, "verse_number": "७-२१-३५", "content_sanskrit": "स तु शूलगदापासाञ्छक्तितोमरसायकान् ।\nमुसलानि शिलावृक्षान्मुमोचास्त्रबलाद्बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000556035, "chapter_id": 9556, "verse_number": "७-२१-३६", "content_sanskrit": "तरूणां च शिलानां च शस्त्राणां चातिदारुणम् ।\nयमसैन्येषु तद्वर्षं पपात धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000556036, "chapter_id": 9556, "verse_number": "७-२१-३७", "content_sanskrit": "तांस्तु सर्वान्विनिर्भिद्य तदस्त्रमपहत्य च ।\nजघ्नुस्ते राक्षसं घोरमेकं शतसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000556037, "chapter_id": 9556, "verse_number": "७-२१-३८", "content_sanskrit": "परिवार्य च तं सर्वे शैलं मोघोत्करा इव ।\nभिन्दिपालैश्च शूलैश्च निरुच्छ्वासमपोथयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000556038, "chapter_id": 9556, "verse_number": "७-२१-३९", "content_sanskrit": "विमुक्तकवचः क्रुद्धः सिक्तः शोणितविस्रवैः ।\nततः स पुष्पकं त्यक्त्वा पृथिव्यामवतिष्ठत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000556039, "chapter_id": 9556, "verse_number": "७-२१-४०", "content_sanskrit": "ततः स कार्मुकी वाणी समरे चाभिवर्तत ।\nलब्धसञ्ज्ञो मुहूर्तेन क्रुद्धस्तस्थौ यथान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000556040, "chapter_id": 9556, "verse_number": "७-२१-४१", "content_sanskrit": "ततः पाशुपतं दिव्यमस्त्रं सन्धाय कार्मुके ।\nतिष्ठ तिष्ठेति तानुक्त्वा तच्चापं विचकर्ष स ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000556041, "chapter_id": 9556, "verse_number": "७-२१-४२", "content_sanskrit": "आकर्णात्स विकृष्याथ चापमिन्द्रारिराहवे ।\nमुमोच तं शरं क्रुद्धस्त्रिपुरे शङ्करो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000556042, "chapter_id": 9556, "verse_number": "७-२१-४३", "content_sanskrit": "तस्य रूपं शरस्यासीत्विधूमज्वालमण्डलम् ।\nवनं दहिष्यतो घर्मे दावाग्नेरिव मूर्च्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000556043, "chapter_id": 9556, "verse_number": "७-२१-४४", "content_sanskrit": "ज्वालामाली स तु शरः क्रव्यादानुगतो रणे ।\nमुक्तो गुल्मान्द्रुमांश्चापि भस्म कृत्वा प्रधावति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000556044, "chapter_id": 9556, "verse_number": "७-२१-४५", "content_sanskrit": "ते तस्य तेजसा दग्धाः सैन्या वैवस्वतस्य तु ।\nरणे तस्मिन्निपतिता दावदग्धा नगा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000556045, "chapter_id": 9556, "verse_number": "७-२१-४६", "content_sanskrit": "ततस्तु सिचवैः सार्धं राक्षसो भीमविक्रमः ।\nननाद सुमहानादं कम्पयन्निव मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000556046, "chapter_id": 9556, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे एकविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]