[{"id": 7001049000, "chapter_id": 21049, "verse_number": "५-३१-१", "content_sanskrit": "संस्तुतो भगवानित्थं देवराजेन केशवः ।\nप्रहंस्य भावगम्भीरमुवाचेदं द्रिजोत्तम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001049001, "chapter_id": 21049, "verse_number": "५-३१-२", "content_sanskrit": "देवराजो भवानिन्द्रो वयं मर्त्त्या जगत्पते!\nक्षन्तव्यं भवता चदमपराधकृत मम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001049002, "chapter_id": 21049, "verse_number": "५-३१-३", "content_sanskrit": "पारिजाततरुश्वायं नीयतामुचितास्पदम ।\nगृहीतोऽयं मया शक्र!सत्यावचनकारणात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001049003, "chapter_id": 21049, "verse_number": "५-३१-४", "content_sanskrit": "वज्रञ्चेदं गृहाण त्वं यत्त्वया प्रहितं मयि ।\nतवैवैतत् प्रहरणां शक्र!वैरिविदारणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001049004, "chapter_id": 21049, "verse_number": "५-३१-५", "content_sanskrit": "विमोहयसि मामीश!मर्त्त्योऽहमिति किं वदन् ।\nजानीमस्त्वां भगवतो न तु सूक्ष्मविदो वयम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001049005, "chapter_id": 21049, "verse_number": "५-३१-६", "content_sanskrit": "योऽसि सोऽसि जगत्त्रण!प्रवृत्तौ नाथ!संस्थितः ।\nजगतः शल्यनिष्कर्षं करोष्यसुरसूदन ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001049006, "chapter_id": 21049, "verse_number": "५-३१-७", "content_sanskrit": "नीयतां पारिजातोऽयं कृष्ण!द्रारवतीं पुरीम् ।\nमर्त्त्यलोके त्वया त्यक्ते नायं संस्थास्यते भुवि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001049007, "chapter_id": 21049, "verse_number": "५-३१-८", "content_sanskrit": "तथेत्युक्त्वा च देवेन्द्रमाजगाम भुवं हरिः ।\nप्रसक्तैः सिद्ध-गन्धर्व्वैः स्तूयमानस्तथषिंभिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001049008, "chapter_id": 21049, "verse_number": "५-३१-९", "content_sanskrit": "ततः शङ्खमुपाध्माय द्रारकोपरि संस्थितः ।\nहर्षमुत्पादयामास द्रारकावासिनां द्रिज ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001049009, "chapter_id": 21049, "verse_number": "५-३१-१०", "content_sanskrit": "अवतीर्य्यथ गरुड़ात् सत्यभामासहायवान् ।\nनिष्कुटे स्थापयामास पारिजातं महातरुम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001049010, "chapter_id": 21049, "verse_number": "५-३१-११", "content_sanskrit": "यमभ्येत्य जनः सर्व्वो जातिं स्मरति पौर्व्विकीम् ।\nवास्यते सादराः सर्व्वे देहबन्धानमानुषान् ।\nददृशुः पादपे तस्मिन् कुर्व्वन्तो सुखदर्शनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001049011, "chapter_id": 21049, "verse_number": "५-३१-१२", "content_sanskrit": "ततस्ते सादराः सर्व्वे देहबन्धानमानुषान् ।\nददृशुः पादपे तस्मिन् कुर्व्वन्तो मुखदर्शनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001049012, "chapter_id": 21049, "verse_number": "५-३१-१३", "content_sanskrit": "किङ्करैः समुपानीतं हस्त्यश्वादि ततो धनम ।\nस्त्रियश्व कृष्णो जग्राह नरकस्य परिग्रहान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001049013, "chapter_id": 21049, "verse_number": "५-३१-१४", "content_sanskrit": "ततः काले शुभे प्राप्त उपयेमे जनार्द्दनः ।\nताः कन्या नरकेणासन् सर्व्वतो याः समाह्टताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001049014, "chapter_id": 21049, "verse_number": "५-३१-१५", "content_sanskrit": "एकस्मिन्नेव गोविन्दः काले तासां महामते!\nजग्राह विधिवत् पाणीन् पृथगूगेहेषु धर्म्मतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001049015, "chapter_id": 21049, "verse_number": "५-३१-१६", "content_sanskrit": "षोड़शस्त्रीसहस्त्राणि शतमेकं तथाधिकम् ।\nतावन्ति चक्र रूपाणि भगवान् मधुसूदनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001049016, "chapter_id": 21049, "verse_number": "५-३१-१७", "content_sanskrit": "एकैकश्येन ताः कन्या मेनिरे मधुसूदनम् ।\nममैव पाणिग्रहणं भगवान् कृतवानिति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001049017, "chapter_id": 21049, "verse_number": "५-३१-१८", "content_sanskrit": "निशासु च जगतस्त्रष्टा तासां गुहेषु केशवः ।\nउवास विप्र! सर्व्वासां विश्वरूपधरो हरिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]