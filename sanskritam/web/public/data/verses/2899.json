[{"id": 2088790, "chapter_id": 2899, "verse_number": "१३-२९-१", "content_sanskrit": "`भीष्म उवाच।\nततो व्रज्रं सहस्राक्षो दृष्ट्वा सक्तं वरायुधम्।\nऋषींश्च दृष्ट्वा सहसा सुपर्णमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088791, "chapter_id": 2899, "verse_number": "१३-२९-२", "content_sanskrit": "न ते सुपर्ण पश्यामि प्रभावं तेन योधये।\nइत्युक्ते न मया रक्षा शक्या कर्तुमतोऽन्यथा।\nइदं वज्रं मया सार्धं निवृत्तं हि यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088792, "chapter_id": 2899, "verse_number": "१३-२९-३", "content_sanskrit": "ततः सहस्रनयने निवृत्ते गरुडस्तथा।\nकद्रूमभ्यगमत्तूर्णममृतं गृह्य भारतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088793, "chapter_id": 2899, "verse_number": "१३-२९-४x", "content_sanskrit": "गरुड उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088794, "chapter_id": 2899, "verse_number": "१३-२९-४", "content_sanskrit": "तदाहृतं मया शीघ्रममृतं जननीकृते।\nअदासी सा भवत्वद्य विनता धर्मिचारिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088795, "chapter_id": 2899, "verse_number": "१३-२९-५x", "content_sanskrit": "कद्रूरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088796, "chapter_id": 2899, "verse_number": "१३-२९-५", "content_sanskrit": "स्वागतं स्वाहृतं चेदममृतं विनतात्मज।\nअदासी जननी तेऽद्य पुत्र कामवशा शुभा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088797, "chapter_id": 2899, "verse_number": "१३-२९-६", "content_sanskrit": "एवमुक्ते तदा सा च सम्प्राप्ता विनता गृहम्॥\nउपनीय यथान्यायं विहगो बलिनांवरः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088798, "chapter_id": 2899, "verse_number": "१३-२९-७", "content_sanskrit": "स्मृत्वा निकृत्या विजयं मातुः सम्प्रतिपद्य च॥\nवधं च भुजगेन्द्राणां ये वालास्तस्य वाजिनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088799, "chapter_id": 2899, "verse_number": "१३-२९-८", "content_sanskrit": "बभूवुरसितप्रख्या निकृत्या वै जितं त्वया॥\nतामुवाच ततो न्याय्यं विहगो बलिनांवरः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088800, "chapter_id": 2899, "verse_number": "१३-२९-९", "content_sanskrit": "उञ्जहारामृतं तूर्णमुत्पपात च रंहसा॥\nतद्गृहीत्वाऽमृतं तूर्णं प्रयान्तमपराजितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088801, "chapter_id": 2899, "verse_number": "१३-२९-१०", "content_sanskrit": "किमर्थं वैनतेय त्वमाहृत्यामृतमुत्तमम्।\nपुनर्हरति दुर्बुद्धे मा जातु वृजितं कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088802, "chapter_id": 2899, "verse_number": "१३-२९-११x", "content_sanskrit": "सुपर्णि उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088803, "chapter_id": 2899, "verse_number": "१३-२९-११", "content_sanskrit": "अमृताहरणं मेऽद्य यत्कृतं जननीकृते।\nभवत्या वचनादेतदाहरामृतमित्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088804, "chapter_id": 2899, "verse_number": "१३-२९-१२", "content_sanskrit": "आहृतं तदिदं शीघ्रं मुक्ता च जननी मम।\nहराम्येष पुनस्तत्र यत एतन्मयाऽऽहृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088805, "chapter_id": 2899, "verse_number": "१३-२९-१३", "content_sanskrit": "यदि मां भवती ब्रूयादमृतं मे च दीयताम्।\nतथा कुर्यां न वा कुर्यां न हि त्वममृतक्षमा।\nमया धर्मेण सत्येन विनता च समुद्धृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088806, "chapter_id": 2899, "verse_number": "१३-२९-१४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088807, "chapter_id": 2899, "verse_number": "१३-२९-१४", "content_sanskrit": "ततो गत्वाऽथ गरुडः पुरन्दरमुवाच ह।\nइदं मया वृत्रहन्तर्हृतं तेऽमृतमुत्तमम्।\nमात्रर्थे हि तथैवेदं गृहाणामृतमाहृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088808, "chapter_id": 2899, "verse_number": "१३-२९-१५", "content_sanskrit": "माता च मम देवेश दासीत्वमुपजग्मुषी।\nभुजङ्गमानां मातुर्वै सा मुक्ताऽमृतदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088809, "chapter_id": 2899, "verse_number": "१३-२९-१६", "content_sanskrit": "एतच्छ्रुत्वा सहस्राक्षः सुपर्णमनुमन्यते।\nउवाच च मुदा युक्तो दिष्ट्यादिष्ट्येति वासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088810, "chapter_id": 2899, "verse_number": "१३-२९-१७", "content_sanskrit": "क्रषयो ये सहस्राक्षमुपासन्ति सुरैः सह।\nते सर्वे च मुदा युक्ता विश्वेदेवास्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088811, "chapter_id": 2899, "verse_number": "१३-२९-१८", "content_sanskrit": "ततस्तमृषयः सर्वे देवाश्च भरतर्षभ।\nऊचुः पुरन्दरं दृष्टा गरुडो लभतां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088812, "chapter_id": 2899, "verse_number": "१३-२९-१९", "content_sanskrit": "ततः शचीपतिर्वाक्यमुवाच प्रहसन्निव।\nजनिष्यति हृषीकेशः स्वयमेवैष पक्षिराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2088813, "chapter_id": 2899, "verse_number": "१३-२९-२०", "content_sanskrit": "केशवः पुण्डरीकाक्षः शूरपुत्रस्य वेश्मनि।\nस्वयं धर्मस्य रक्षार्थं विभज्य भुजगाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2088814, "chapter_id": 2899, "verse_number": "१३-२९-२१", "content_sanskrit": "एष ते पाण्डवश्रेष्ठ गरुडोऽथ पतत्रिराट्।\nसुपर्णो वैनतेयश्च कीर्तितो भद्रमस्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2088815, "chapter_id": 2899, "verse_number": "१३-२९-२२", "content_sanskrit": "तदेतद्भरतश्रेष्ठ मयाऽऽख्यानं प्रकीर्तितम्।\nसुपर्णस्य महाबाहो किं भूयः कथयामि ते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2088816, "chapter_id": 2899, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनविंशोऽध्यायः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]