[{"id": 2059591, "chapter_id": 2277, "verse_number": "८-१-०x", "content_sanskrit": "श्रीवेदव्यासाय नमः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2059592, "chapter_id": 2277, "verse_number": "८-१-१", "content_sanskrit": "नारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं व्यासं ततो जयमुदीरयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2059593, "chapter_id": 2277, "verse_number": "८-१-१x", "content_sanskrit": "`वैशम्पायन उवाच।\nशिबिराद्धास्तिनपुरं प्राप्य भारत सञ्जयः।\nप्रविवेश महाबाहुर्धृतराष्ट्रनिवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2059594, "chapter_id": 2277, "verse_number": "८-१-२", "content_sanskrit": "शोकेनापहतः सूतो विलपन्भृशदुःखितः।\nचिन्तयन्निधनं घोरं सूतपुत्रस्य पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2059595, "chapter_id": 2277, "verse_number": "८-१-३", "content_sanskrit": "अन्तःपुरं प्रविश्यैव सञ्जयो राजसत्तमम्।\nअश्रुपूर्णो भृशं त्रस्तो राजानमुपजग्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2059596, "chapter_id": 2277, "verse_number": "८-१-४", "content_sanskrit": "उपस्थाय च राजानं विनिश्वस्य च सूतजः।\nनातिहृष्टमना राजन्निदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2059597, "chapter_id": 2277, "verse_number": "८-१-५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2059598, "chapter_id": 2277, "verse_number": "८-१-५", "content_sanskrit": "सञ्चयोऽहं महाराज नमस्ते भरतर्षभ।\nहतो वैकर्तनः कर्णः कृत्वा कर्म सुदुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2059599, "chapter_id": 2277, "verse_number": "८-१-६", "content_sanskrit": "चेदिकाशिकरूशानां मत्स्यानां सोमकैः सह।\nकृत्वाऽसौ कदनं शेते वातनुन्न इव द्रुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2059600, "chapter_id": 2277, "verse_number": "८-१-७", "content_sanskrit": "गोष्ठमध्येव ऋषभो गोव्रजैः परिवारितः।\nव्यालेन निहतो यद्वत्तथाऽसौ निहतः परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2059601, "chapter_id": 2277, "verse_number": "८-१-८", "content_sanskrit": "निराशान्पाण्डवान्कृत्वा दृढं राजन्ससात्यकान्।\nपाञ्चालानां रथांश्चैव विनिहत्य सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2059602, "chapter_id": 2277, "verse_number": "८-१-९", "content_sanskrit": "जित्वा शूरान्महेष्वासान्विद्राव्य च दिशोदश।\nहतो वैकर्तनः कर्णः पाण्डवेन किरीटिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2059603, "chapter_id": 2277, "verse_number": "८-१-१०", "content_sanskrit": "वैरस्य गत आनृण्यं दुर्गमस्य दुरात्मभिः।\nहत्वा कर्णं महाराज विशल्यः पाण्डवोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2059604, "chapter_id": 2277, "verse_number": "८-१-११", "content_sanskrit": "शोषणं सागराणां वा पतनं वा विवस्वतः।\nविशीर्णत्वं यथा मेरोस्तथा कर्णस्य पातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2059605, "chapter_id": 2277, "verse_number": "८-१-१२", "content_sanskrit": "योधाश्च बहवो राजन्हतास्तत्र जयैषिणः।\nराजानो राजपुत्राश्च शूराः परिघबाहवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2059606, "chapter_id": 2277, "verse_number": "८-१-१३", "content_sanskrit": "रथौघाश्च नरौघाश्च हता राजन्सहस्रशः।\nवारणा निहतास्तत्र वाजिनश्च महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2059607, "chapter_id": 2277, "verse_number": "८-१-१४", "content_sanskrit": "क्षत्रियाश्च महाराज सेनयोरुभयोर्हताः।\nपरस्परं वै वीक्ष्यात्र परस्परकृतागसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2059608, "chapter_id": 2277, "verse_number": "८-१-१५", "content_sanskrit": "किञ्चिच्छेषान्परान्कृत्वा तीर्त्वा पाण्डववाहिनीम्।\nपार्थवेलां समासाद्य हतो वैकर्तनो वृषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2059609, "chapter_id": 2277, "verse_number": "८-१-१६", "content_sanskrit": "जयाशा धार्तराष्ट्राणां वैरस्य च मुखं नृप।\nतीर्णं तत्पाण्डवै राजन्यत्पुरा नावबुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2059610, "chapter_id": 2277, "verse_number": "८-१-१७", "content_sanskrit": "प्रोच्यमानं महाराज बन्धुभिर्हितबुद्धिभिः।\nतदिदं समनुप्राप्तं व्यसनं त्वां महाभयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2059611, "chapter_id": 2277, "verse_number": "८-१-१८", "content_sanskrit": "पुत्राणां राज्यकामेन त्वया राजन्हितैषिणा।\nचरितान्यहितान्येव तेषां ते फलमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2059612, "chapter_id": 2277, "verse_number": "८-१-१९", "content_sanskrit": "हतो दुःशासनो राजन्यथोक्तं पाण्डवेन तु।\nप्रतिज्ञा भीमसेनेन निस्तीर्णा सा चमूमुखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2059613, "chapter_id": 2277, "verse_number": "८-१-२०", "content_sanskrit": "पीतं च क्षतजं तस्य धार्तराष्ट्रस्य संयुगे।\nपाण्डवेन महाराज कर्म कृत्वा सुदुष्करम्*॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2059614, "chapter_id": 2277, "verse_number": "८-१-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2059615, "chapter_id": 2277, "verse_number": "८-१-२१", "content_sanskrit": "एतच्छ्रुत्वा महाराज धृतराष्ट्रोऽम्बिकासुतः।\nशोकस्यान्तमपश्यन्वै हतं मत्वा सुयोधनम्।\nविह्वलः पतितो भूमौ नष्टचेता इव द्विपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2059616, "chapter_id": 2277, "verse_number": "८-१-२२", "content_sanskrit": "तस्मिन्निपतिते भूमौ विह्वले राजसत्तमे।\nआर्तनादो महानासीत्स्त्रीणां भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2059617, "chapter_id": 2277, "verse_number": "८-१-२३", "content_sanskrit": "श शब्दः पृथिवीं कृत्स्नां पूरयामास सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2059618, "chapter_id": 2277, "verse_number": "८-१-२४", "content_sanskrit": "शोकार्णवे महाघोरे निमग्ना भरतस्त्रियः।\nरुरुदुर्दुःखशोकार्ता भृशमुद्विग्नचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2059619, "chapter_id": 2277, "verse_number": "८-१-२५", "content_sanskrit": "राजानं च समासाद्य गान्धारी भरतर्षभ।\nनिःसंज्ञा पतिता भूमौ सर्वाण्यन्तः पुराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2059620, "chapter_id": 2277, "verse_number": "८-१-२६", "content_sanskrit": "ततस्ताः स़ञ्जयो राजन्समाश्वासयदातुराः।\nमुह्यामानाः सुबहुशो मुञ्चन्तीर्वारि नेत्रजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2059621, "chapter_id": 2277, "verse_number": "८-१-२७", "content_sanskrit": "समाश्वस्ताः स्त्रियस्तास्तु वेपमाना मुहुर्मुहुः।\nकदल्य इव वातेन धूयमानाः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2059622, "chapter_id": 2277, "verse_number": "८-१-२८", "content_sanskrit": "राजानं विदुरश्चापि प्रज्ञाचक्षुषमीश्वरम्।\nआश्वासयामास तदा सिञ्चंस्तोयेन कौरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2059623, "chapter_id": 2277, "verse_number": "८-१-२९", "content_sanskrit": "स लब्ध्वा सनकैः संज्ञां ताश्च दृष्ट्वा स्त्रियो नृपः।\nउन्मत्त इव राजेन्द्र स्थितस्तूष्णीं विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2059624, "chapter_id": 2277, "verse_number": "८-१-३०", "content_sanskrit": "ततो ध्यात्वा चिरं कालं निःश्वस्य च पुनःपुनः।\nस्वान्पुत्रान्गर्हयामास बहुमेने च पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2059625, "chapter_id": 2277, "verse_number": "८-१-३१", "content_sanskrit": "गर्हयंश्चात्मनो बुद्धिं शकुनेः सौबलस्य च।\nध्यात्वा तु सुचिरं कालं वेपमानो मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2059626, "chapter_id": 2277, "verse_number": "८-१-३२", "content_sanskrit": "संस्तभ्य च मनो भूयो राजा धैर्यसमन्वितः।\nपुनर्गावल्गणिं सूतं पर्यपृच्छत सञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2059627, "chapter_id": 2277, "verse_number": "८-१-३३", "content_sanskrit": "न त्वया कथितं वाक्यं श्रुतं सञ्जय तन्मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2059628, "chapter_id": 2277, "verse_number": "८-१-३४", "content_sanskrit": "कच्चिद्दुर्योधनः सूत न गतो वै यमक्षयम्।\nजये निराशः पुत्रो मे सततं जयकामुकः।\nब्रूहि सञ्जय तत्त्वेन पुनरुक्तां कथामिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2059629, "chapter_id": 2277, "verse_number": "८-१-३५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2059630, "chapter_id": 2277, "verse_number": "८-१-३५", "content_sanskrit": "एवमुक्तोऽब्रवीत्सूतो राजानं जनमेजय।\nहतो वैकर्तनो राजन्सहपुत्रैर्महारथः।\nभ्रातृभिश्च महेष्वासैः सूतपुत्रैस्तनुत्यजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2059631, "chapter_id": 2277, "verse_number": "८-१-३६", "content_sanskrit": "दुःशासनश्च निहतः पाण्डवेन यशस्विना।\nपीतं च रुधिरं कोपाद्भीमसेनेन संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2059632, "chapter_id": 2277, "verse_number": "८-१-३७x", "content_sanskrit": "`वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2059633, "chapter_id": 2277, "verse_number": "८-१-३७", "content_sanskrit": "एतच्छ्रुत्वा महाराज धृतराष्ट्रोऽम्बिकासुतः।\nदह्यमानोऽब्रवीत्सूतं मुहूर्तं तिष्ठ सञ्जय।\nव्याकुलं मे मनस्तात मा तावत्किंचिदुच्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2059634, "chapter_id": 2277, "verse_number": "८-१-३८", "content_sanskrit": "राजापि नाब्रवीत्किञ्चित्सञ्जयो विदुरस्तथा।\nतूष्णीम्भूतस्तदा सोऽथ बभूव जगतीपतिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2059635, "chapter_id": 2277, "verse_number": "८-१-०", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि प्रथमोऽध्यायः॥ १ ॥\nकर्णपर्व - अध्याय ००१*\nMahabharata - Karna Parva - Chapter Topics\nदुर्योधनादिभिः कर्णस्य सैनापत्येऽभिषेचनपूर्वकं युद्धाय निर्याणम्॥ १ ॥ जनमेजयेन वैशम्पायनम्प्रति कर्णमरणश्राविणो धृतराष्ट्रस्य प्रवृत्तिप्रश्नः॥ २ ॥\nMahabharata - Karna Parva - Chapter Text", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2059636, "chapter_id": 2277, "verse_number": "८-१-०x", "content_sanskrit": "श्रीकृष्णाय नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2059637, "chapter_id": 2277, "verse_number": "८-१-१", "content_sanskrit": "[नारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं चैव ततो जयमुदीरयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2059638, "chapter_id": 2277, "verse_number": "८-१-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2059639, "chapter_id": 2277, "verse_number": "८-१-२", "content_sanskrit": "ततो द्रोणे हते राजन्दुर्योधनमुखा नृपाः।\nभृशमुद्विग्नमनसो द्रोणपुत्रमुपागमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2059640, "chapter_id": 2277, "verse_number": "८-१-३", "content_sanskrit": "ते द्रोणमनुशोचन्तः कश्मलाभिहतौजसः।\nपर्युपासन्त शोकार्तास्ततः शारद्वतीसुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2059641, "chapter_id": 2277, "verse_number": "८-१-४", "content_sanskrit": "ते मुहूर्तं समाश्वस्य हेतुभिः शास्त्रसम्मितैः।\nरात्र्यागमे महीपालाः स्वानि वेश्मानि भेजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2059642, "chapter_id": 2277, "verse_number": "८-१-५", "content_sanskrit": "ते वेश्मस्वपि कौरव्य पृथ्वीशा नाप्नुवन्सुखम्।\nचिन्तयन्तः क्षयं तीव्रं दुःखशोकसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2059643, "chapter_id": 2277, "verse_number": "८-१-६", "content_sanskrit": "विशेषतः सूतपुत्रो राजा चैव सुयोधनः।\nदुःशासनश्च शकुनिः सौबलश्च महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2059644, "chapter_id": 2277, "verse_number": "८-१-७", "content_sanskrit": "उषितास्ते निशां तां तु दुर्योधननिवेशने।\nचिन्तयन्तः परिक्लेशान्पाण्डवानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2059645, "chapter_id": 2277, "verse_number": "८-१-८", "content_sanskrit": "यत्तद्द्यूते परिक्लिष्टा कृष्णा चानायिता सभाम्।\nतत्स्मरन्तोऽनुशोचन्तो भृशमुद्विग्नचतेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2059646, "chapter_id": 2277, "verse_number": "८-१-९", "content_sanskrit": "तथा तु सञ्चिन्तयतां तान्क्लेशान्द्यूतकारितान्।\nदुःखेन क्षणदा राजञ्जगामाब्दशतोपमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2059647, "chapter_id": 2277, "verse_number": "८-१-१०", "content_sanskrit": "ततः प्रभाते विमले स्थिता दिष्टस्य शासने।\nचक्रुरावश्यकं सर्वे विधिदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2059648, "chapter_id": 2277, "verse_number": "८-१-११", "content_sanskrit": "ते कृत्वाऽवश्यकार्याणि समाश्वस्य च भारत।\nयोगमाज्ञापयामासुर्युद्वाय च विनिर्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2059649, "chapter_id": 2277, "verse_number": "८-१-१२", "content_sanskrit": "कर्णं सेनापतिं कृत्वा कृतकौतुकमङ्गलाः।\nपूजयित्वा द्विजश्रेष्ठान्दधिपात्रघृताक्षतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2059650, "chapter_id": 2277, "verse_number": "८-१-१३", "content_sanskrit": "गोभिरश्वैश्च निष्कैश्च वासोभिश्च महाधनैः।\nवन्द्यमाना जयाशीर्भिः सूतमागधबन्दिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2059651, "chapter_id": 2277, "verse_number": "८-१-१४", "content_sanskrit": "तथैव पाण्डवा राजन्कृतपूर्वाह्णिकक्रियाः।\nशिबिरान्निर्ययुस्तूर्णं युद्वाय कृतनिश्चयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2059652, "chapter_id": 2277, "verse_number": "८-१-१५", "content_sanskrit": "ततः प्रववृते युद्वं तुमुलं रोमहर्षणम्।\nकुरूणां पाण्डवानां च परस्परजयैषिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2059653, "chapter_id": 2277, "verse_number": "८-१-१६", "content_sanskrit": "तयोर्द्वौ दिवसौ युद्वं कुरुपाण्डवसेनयोः।\nकर्णे सेनापतौ राजन्बभूवाद्भुतदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2059654, "chapter_id": 2277, "verse_number": "८-१-१७", "content_sanskrit": "ततः शत्रुक्षयं कृत्वा सुमहान्तं रणे वृषः।\nपश्यतां धार्तराष्ट्राणां फल्गुनेन निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2059655, "chapter_id": 2277, "verse_number": "८-१-१८", "content_sanskrit": "ततस्तु सञ्जयः सर्वं गत्वा नागपुरं द्रुतम्।\nआचष्ट धृतराष्ट्राय यद्वृत्तं कुरुजाङ्गले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2059656, "chapter_id": 2277, "verse_number": "८-१-१९x", "content_sanskrit": "जनमयेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2059657, "chapter_id": 2277, "verse_number": "८-१-१९", "content_sanskrit": "आपगेयं हतं श्रुत्वा द्रोणं चापि महारथम्।\nआजगाम परामार्तिं वृद्वो राजाऽम्बिकासुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2059658, "chapter_id": 2277, "verse_number": "८-१-२०", "content_sanskrit": "स श्रुत्वा निहतं कर्णं दुर्योधनहितैषिणम्।\nकथं द्विजवर प्राणानधारयत दुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2059659, "chapter_id": 2277, "verse_number": "८-१-२१", "content_sanskrit": "यस्मिञ्जयाशां पुत्राणां सममन्यत पार्थिवः।\nतस्मिन्हते स कौरव्यः कथं प्राणानधारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2059660, "chapter_id": 2277, "verse_number": "८-१-२२", "content_sanskrit": "दुर्मरं तदहं मन्ये नृणां कृच्छ्रेऽपि वर्तताम्।\nयत्र कर्णं हतं श्रुत्वा नात्यजज्जीवितं नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2059661, "chapter_id": 2277, "verse_number": "८-१-२३", "content_sanskrit": "तथा शान्तनवं वृद्वं ब्रह्मन्बाह्लीकमेव च।\nद्रोणं च सोमदत्तं च भूरिश्रवसमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2059662, "chapter_id": 2277, "verse_number": "८-१-२४", "content_sanskrit": "तथैव चान्यान्सुहृदः पुत्रान्पौत्रांश्च पातितान्।\nश्रुत्वा यन्नाजहात्प्राणांस्तन्मन्ये दुष्करं द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2059663, "chapter_id": 2277, "verse_number": "८-१-२५", "content_sanskrit": "एतन्मे सर्वमाचक्ष्व विस्तरेण महामुने।\nन हि तृप्यामि पूर्वेषां शृण्वानश्चरितं महत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2059664, "chapter_id": 2277, "verse_number": "८-१-०", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि षोडशदिवसयुद्धारम्भे प्रथमोऽध्यायः॥ १ ॥\nकर्णपर्व - अध्याय ००१**\nMahabharata - Karna Parva - Chapter Topics\nधृतराष्ट्रेण भीष्मद्रोणौ प्रत्यनुशोचनपूर्वकं सञ्जयम्प्रति दुर्योधनादिप्रवृत्तिप्रश्नः॥ १ ॥\nMahabharata - Karna Parva - Chapter Text", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2059665, "chapter_id": 2277, "verse_number": "८-१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2059666, "chapter_id": 2277, "verse_number": "८-१-१", "content_sanskrit": "हते कर्णे महाराज निशि गावल्गणिस्तदा।\nदीनो ययौ नागपुरमश्वैर्वातसमैर्जवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2059667, "chapter_id": 2277, "verse_number": "८-१-२", "content_sanskrit": "स हास्तिनपुरं गत्वा भृशमुद्विग्नचेतनः।\nजगाम धृतराष्ट्रस्य क्षयं प्रक्षीणबान्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2059668, "chapter_id": 2277, "verse_number": "८-१-३", "content_sanskrit": "स तमुद्वीक्ष्य राजानं कश्मलाभिहतौजसम्।\nववन्दे प्राञ्जलिर्भूत्वा मूर्ध्ना पादौ नृपस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2059669, "chapter_id": 2277, "verse_number": "८-१-४", "content_sanskrit": "सम्पूज्य च यथान्यायं धृतराष्ट्रं महीपतिम्।\nहा कष्टमिति चोक्त्वा स ततो वचनमाददे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2059670, "chapter_id": 2277, "verse_number": "८-१-५", "content_sanskrit": "सञ्जयोऽहं क्षितिपते कच्चिदास्ते सुखं भवान्।\nस्वदोषैरापदं प्राप्य कच्चिन्नाद्य विमुह्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2059671, "chapter_id": 2277, "verse_number": "८-१-६", "content_sanskrit": "हितान्युक्तानि विदुरद्रोणगाङ्गेयकेशवैः।\nअगृहीतान्यनुस्मृत्य कच्चिन्न कुरुषे व्यथाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2059672, "chapter_id": 2277, "verse_number": "८-१-७", "content_sanskrit": "रामनारदकण्वाद्यैर्हितमुक्तं सभातले।\nन गृहीतमनुस्मृत्य कच्चिन्न कुरुषे व्यथाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2059673, "chapter_id": 2277, "verse_number": "८-१-८", "content_sanskrit": "सुहृदस्त्वद्विते युक्तान्भीष्मद्रोणमुखान्परैः।\nनिहतान्युधि संस्मृत्य कच्चिन्न कुरुषे व्यथाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2059674, "chapter_id": 2277, "verse_number": "८-१-९", "content_sanskrit": "तमेवंवादिनं राजा सूतपुत्रं कृताजलिम्।\nसुदीर्घमथ निःश्वस्य दुःखार्त इदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2059675, "chapter_id": 2277, "verse_number": "८-१-१०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2059676, "chapter_id": 2277, "verse_number": "८-१-१०", "content_sanskrit": "आपगेये हते शूरे दिव्यास्त्रवति सञ्जय।\nद्रोणे च परमेष्वासे भृशं मे व्यथितं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2059677, "chapter_id": 2277, "verse_number": "८-१-११", "content_sanskrit": "यो रथानां सहस्राणि दंशितानां दशैव तु।\nअहन्यहनि तेजस्वी निजघ्ने वसुसम्भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2059678, "chapter_id": 2277, "verse_number": "८-१-१२", "content_sanskrit": "तं हतं यज्ञसेनस्य पुत्रेणेह शिखण्डिना।\nपाण्डवेयाभिगुप्तेन श्रुत्वा मे व्यथितं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2059679, "chapter_id": 2277, "verse_number": "८-१-१३", "content_sanskrit": "भार्गवः प्रददौ यस्मै परमास्त्रं महाहवे।\nसाक्षाद्रामणे यो बाल्ये धनुर्वेद उपाकृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2059680, "chapter_id": 2277, "verse_number": "८-१-१४", "content_sanskrit": "यस्य प्रसादात्कौन्तेया राजपुत्रा महारथाः।\nमहारथत्वं सम्प्राप्तास्तथाऽन्ये वसुधाधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2059681, "chapter_id": 2277, "verse_number": "८-१-१५", "content_sanskrit": "तं द्रोणं निहतं श्रुत्वा धृष्टद्युम्नेन संयुगे।\nसत्यसन्धं महेष्वासं भृशं मे व्यथितं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2059682, "chapter_id": 2277, "verse_number": "८-१-१६", "content_sanskrit": "ययोर्लोके पुमानस्त्रे न समोऽस्ति चतुर्विधे।\nतौ द्रोणभीष्मौ श्रुत्वा तु हतौ मे व्यथितं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2059683, "chapter_id": 2277, "verse_number": "८-१-१७", "content_sanskrit": "त्रैलोक्ये यस्य चास्त्रेषु न पुमान्विद्यते समः।\nतं द्रोणं निहतं श्रुत्वा किमकुर्वत मामकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2059684, "chapter_id": 2277, "verse_number": "८-१-१८", "content_sanskrit": "संशप्तकानां च बले पाण्डवेन महात्मना।\nधनञ्जयेन विक्रम्य गमिते यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2059685, "chapter_id": 2277, "verse_number": "८-१-१९", "content_sanskrit": "नारायणास्त्रे च हते द्रोणपुत्रस्य धीमतः।\nविप्रद्रुतानहं मन्येनिमग्नाञ्शोकसागरे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2059686, "chapter_id": 2277, "verse_number": "८-१-२०", "content_sanskrit": "प्लवमानान्हते द्रोणे सन्ननौकानिवार्णवे॥\nदुर्योधनस्य कर्णस्य भोजस्य कृतवर्मणः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2059687, "chapter_id": 2277, "verse_number": "८-१-२१", "content_sanskrit": "मद्रराजस्य शल्यस्य द्रौणेश्चैव कृपस्य च॥\nमत्पुत्रस्य च शेषस्य तथाऽन्येषां च सञ्जय।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2059688, "chapter_id": 2277, "verse_number": "८-१-२२", "content_sanskrit": "विप्रद्रुतेष्वनीकेषु मुखवर्णोऽभवत्कथम्॥\nएतत्सर्वं यथावृत्तं तथा गावल्गणे मम।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2059689, "chapter_id": 2277, "verse_number": "८-१-२३", "content_sanskrit": "आचक्ष्व पाण्डवेयानां मामकानां च विक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2059690, "chapter_id": 2277, "verse_number": "८-१-२३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2059691, "chapter_id": 2277, "verse_number": "८-१-२४", "content_sanskrit": "तवापराधाद्यद्वृत्तं कौरवेयेषु मारिष।\nतच्छ्रुत्वा मा व्यथां कार्षीर्दिष्टे न व्यथते बुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2059692, "chapter_id": 2277, "verse_number": "८-१-२५", "content_sanskrit": "यस्मादभावी भावी वा भवेदर्थो नरं प्रति।\nअप्राप्तौ तस्य वा प्राप्तौ न कश्चिद्यथते बुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2059693, "chapter_id": 2277, "verse_number": "८-१-२६x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2059694, "chapter_id": 2277, "verse_number": "८-१-२६", "content_sanskrit": "न व्यथाऽभ्यधिका काचिद्विद्यते मम सञ्जय।\nदिष्टमेतत्पुरा मन्ये कथयस्य यथेच्छकम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2059695, "chapter_id": 2277, "verse_number": "८-१-०", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि द्वितीयोऽध्यायः॥ २ ॥\nकर्णपर्व - अध्याय ००१***\nMahabharata - Karna Parva - Chapter Topics\nदुर्योधनेन द्रोणमरणनिर्विण्णानां सैनिकानां कर्णगुणानुवर्णनेन प्रोत्साहनम्॥ १ ॥ सञ्जयेन धृतराष्ट्रम्प्रति कर्णपराक मप्रशंसनपूर्वकं तन्निधनकथनम्॥ २ ॥\nMahabharata - Karna Parva - Chapter Text", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2059696, "chapter_id": 2277, "verse_number": "८-१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2059697, "chapter_id": 2277, "verse_number": "८-१-१", "content_sanskrit": "हते द्रोणे महेष्वासे तव पुत्रा महारथाः।\nबभूवुरस्वस्थमुखा विषण्णा गतचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2059698, "chapter_id": 2277, "verse_number": "८-१-२", "content_sanskrit": "अवाङ्मुखाः शस्त्रभृतः सर्व एव विशाम्पते।\nअवेक्षमाणाः शोकार्ता नाभ्यभाषन्परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2059699, "chapter_id": 2277, "verse_number": "८-१-३", "content_sanskrit": "तान्दृष्ट्वा व्यथिताकारान्सैन्यानि तव भारत।\nऊर्ध्वमेव निरैक्षन्त दुःखत्रस्तान्यनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2059700, "chapter_id": 2277, "verse_number": "८-१-४", "content_sanskrit": "शस्त्राण्येषां तु राजेन्द्र शोणिताक्तानि सर्वशः।\nप्राभ्रश्यन्त कराग्रेभ्यो दृष्ट्वा द्रोणं हतं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2059701, "chapter_id": 2277, "verse_number": "८-१-५", "content_sanskrit": "तानि बद्वान्यरिष्टानि लम्बमानानि भारत।\nअदृश्यन्त महाराज नक्षत्राणि यथा दिवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2059702, "chapter_id": 2277, "verse_number": "८-१-६", "content_sanskrit": "तथा तु स्तिमितं दृष्ट्वा गतसत्वमवस्थितम्।\nबलं तव महाराज राजा दुर्योधनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2059703, "chapter_id": 2277, "verse_number": "८-१-७", "content_sanskrit": "भवतां बाहुवीर्यं हि समाश्रित्य मया युधि।\nपाण्डवेयाः समाहूता युद्वं चेदं प्रवर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2059704, "chapter_id": 2277, "verse_number": "८-१-८", "content_sanskrit": "तदिदं निहते द्रोणे विषण्णमिव लक्ष्यते।\nयुध्यमानाश्च समरे योधा वध्यन्ति सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2059705, "chapter_id": 2277, "verse_number": "८-१-९", "content_sanskrit": "जयो वाऽपि वधो वाऽपि युध्यमानस्य संयुगे।\nभवेत्किमत्र चित्रं वै युध्यध्वं सर्वतोमुखाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2059706, "chapter_id": 2277, "verse_number": "८-१-१०", "content_sanskrit": "पश्यध्वं च महात्मानं कर्णं वैकर्तनं युधि।\nप्रचरन्तं महेष्वासं दिव्यैरस्त्रैर्महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2059707, "chapter_id": 2277, "verse_number": "८-१-११", "content_sanskrit": "यस्य वै युधि सन्त्रासात्कुन्तीपुत्रो धनञ्जयः।\nनिवर्तते सदा मन्दः सिंहात्क्षुद्रमृगो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2059708, "chapter_id": 2277, "verse_number": "८-१-१२", "content_sanskrit": "येन नागायुतप्राणो भीमसेनो महाबलः।\nमानुषेणैव युद्धेन तामवस्थां प्रवेशितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2059709, "chapter_id": 2277, "verse_number": "८-१-१३", "content_sanskrit": "येन दिव्यास्त्रविच्छूरो मायावी स घटोत्कचः।\nअमोघया रणे शक्त्या निहतो भैरवं नदन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2059710, "chapter_id": 2277, "verse_number": "८-१-१४", "content_sanskrit": "तस्य दुर्वारवीर्यस्य सत्यसन्धस्य धीमतः।\nबाह्वोर्द्रविणमक्षय्यमद्य द्रक्ष्यथ संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2059711, "chapter_id": 2277, "verse_number": "८-१-१५", "content_sanskrit": "द्रोणपुत्रस्य विक्रान्तं राधेयस्यैव चोभयोः।\nपश्यन्तु पाण्डुपुत्रास्ते विष्णुवासवयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2059712, "chapter_id": 2277, "verse_number": "८-१-१६", "content_sanskrit": "सर्व एव भवन्तश्च शक्ताः प्रत्येकशोऽपि वा।\nपाण्डुपुत्रान्रणे हन्तुं ससैन्यान्किसु संहताः।\nवीर्यवन्तः कृतास्त्राश्च द्रक्ष्यथाद्य परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2059713, "chapter_id": 2277, "verse_number": "८-१-१७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2059714, "chapter_id": 2277, "verse_number": "८-१-१७", "content_sanskrit": "एवमुक्त्वा ततः कर्णं चक्रे सेनापतिं तदा।\nतव पुत्रो महावीर्यो भ्रातृभिः सहितोऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2059715, "chapter_id": 2277, "verse_number": "८-१-१८", "content_sanskrit": "सैनापत्यमथावाप्य कर्णो राजन्महारथः।\nसिंहनादं विनद्योच्चैः प्रायुध्यत रणोत्कटः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2059716, "chapter_id": 2277, "verse_number": "८-१-१९", "content_sanskrit": "ससृञ्जयानां सर्वेषां पाञ्चालानां च मारिष।\nकेकयानां विदेहानां चकार कदनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2059717, "chapter_id": 2277, "verse_number": "८-१-२०", "content_sanskrit": "तस्येषुधाराः शतशः प्रादुरासञ्छरासनात्।\nअग्रे पुङ्खेषु संसक्ता यथा भ्रमरपङ्क्तयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2059718, "chapter_id": 2277, "verse_number": "८-१-२१", "content_sanskrit": "स पीडयित्वा पाञ्चालान्पाण्डवांश्च तरस्विनः।\nहत्वा सहस्रशो योधानर्जुनेन निपातितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2059719, "chapter_id": 2277, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि तृतीयोऽध्यायः॥ ३ ॥\nMahabharata - Karna Parva - Chapter Footnotes\n८-१-२१ विह्वलः चलनासमर्थः काष्ठवत्पतितः॥ ८-१-२५ अन्तःपुराणि स्त्रियः॥ ८-१-२७ कदल्यइव वेपमाना आसन्निति शेषः॥ ८-१-२९ दृष्ट्वा मनसैवात्मप्रत्ययेन दुःखवतीर्ज्ञत्वा॥ ८-१-३४ इष्टवियोगमात्रेण दशरथादिर्मृतः। अस्यतु जये नैराश्यमधिकं मरणकारणमस्तीति भावः॥ ८-१-१ प्रथमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}]