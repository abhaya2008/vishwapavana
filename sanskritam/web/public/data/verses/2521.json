[{"id": 2072008, "chapter_id": 2521, "verse_number": "१२-२६-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072009, "chapter_id": 2521, "verse_number": "१२-२६-१", "content_sanskrit": "अभिमन्यौ हते बाले द्रौपद्यास्तनयेषु च।\nधृष्टद्युम्ने विराटे च द्रुपदे च महीपतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072010, "chapter_id": 2521, "verse_number": "१२-२६-२", "content_sanskrit": "वृषसेने च धर्मज्ञे धृष्टकेतौ तु पार्थिवे।\nतथाऽन्येषु नरेन्द्रेषु नानादेश्येषु संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072011, "chapter_id": 2521, "verse_number": "१२-२६-३", "content_sanskrit": "न च मुञ्चति मां शोको ज्ञातिघातिनमातुरम्।\nराज्यकामुकमत्युग्रं स्ववंशोच्छेदकारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072012, "chapter_id": 2521, "verse_number": "१२-२६-४", "content_sanskrit": "यस्याङ्के क्रीडमानेन मया विपरिवर्तितम्।\nस मया राज्यलुब्धेन गाङ्गेयो युधि पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072013, "chapter_id": 2521, "verse_number": "१२-२६-५", "content_sanskrit": "यदा ह्येनं विघूर्णन्तं मदर्थं पार्थसायकैः।\nतक्ष्यमाणं यथा वज्रैः प्रेक्षमाणं शिखण्डिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072014, "chapter_id": 2521, "verse_number": "१२-२६-६", "content_sanskrit": "जीर्णसिंहमिव प्राज्ञं नरसिंहं पितामहम्।\nकीर्यमाणं शरैर्दीप्तैर्दृष्ट्वा मे व्यथितं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072015, "chapter_id": 2521, "verse_number": "१२-२६-७", "content_sanskrit": "प्राड्भुखं सीदमानं च रथात्पररथारुजम्।\nघूर्णमानं यथा शैलं तदा मे कश्मलोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072016, "chapter_id": 2521, "verse_number": "१२-२६-८", "content_sanskrit": "यः सवाणधनुष्पाणिर्योधयामास भार्गवम्।\nबहून्यहानि कौरव्यः कुरुक्षेत्रे महामृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072017, "chapter_id": 2521, "verse_number": "१२-२६-९", "content_sanskrit": "समेतं पार्थिवं क्षत्रं वाराणस्यां नदीसुतः।\nकन्यार्थमाह्वयद्वीरो रथेनैकेन संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072018, "chapter_id": 2521, "verse_number": "१२-२६-१०", "content_sanskrit": "येन चोग्रायुधो राजा चक्रवर्ती दुरासदः।\nदग्धश्चास्त्रप्रतापेन स मया युधि पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072019, "chapter_id": 2521, "verse_number": "१२-२६-११", "content_sanskrit": "स्वयं मृत्युं रक्षमाणः पाञ्चाल्यं यः शिखण्डिनम्।\nन बाणैः पातयामास सोऽर्जुनेन निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072020, "chapter_id": 2521, "verse_number": "१२-२६-१२", "content_sanskrit": "यदैनं पतितं भूमावपश्यं रुधिरोक्षितम्।\nतदैवाविशदन्युग्रो ज्वरो मां मुनिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072021, "chapter_id": 2521, "verse_number": "१२-२६-१३", "content_sanskrit": "येन संवर्धिता बाला येन स्म परिरक्षिताः।\nस मया राज्यलुब्धेन पापेन गुरुधातिना।\nअल्पकालस्य राज्यस्य कृते मूढेन पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072022, "chapter_id": 2521, "verse_number": "१२-२६-१४", "content_sanskrit": "आचार्यश्च महेष्वासः सर्वपार्थिवपूजितः।\nअभिगम्य रणे मिथ्या पापेनोक्तः सुतं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072023, "chapter_id": 2521, "verse_number": "१२-२६-१५", "content_sanskrit": "तन्मे दहति गात्राणि यन्मां गुरुरभाषत।\nसत्यमाख्याहि राजंस्त्वं यदि जीवति मे सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072024, "chapter_id": 2521, "verse_number": "१२-२६-१६", "content_sanskrit": "सत्यमामर्शयन्विप्रो मयि तत्परिपृष्टवान्।\nकुञ्जरं चान्तरं कृत्वा मिथ्योपचरितो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072025, "chapter_id": 2521, "verse_number": "१२-२६-१७", "content_sanskrit": "सुभृशं राज्यलुब्धेन पापेन गुरुघातिना।\nसत्यकञ्चुकमुन्मुच्य मया स गुरुराहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072026, "chapter_id": 2521, "verse_number": "१२-२६-१८", "content_sanskrit": "अश्वत्थामा हत इति निरुक्तः कुञ्जरे हते।\nकाँल्लोकांस्तु गमिष्यामि कृत्वा कर्म सुदुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072027, "chapter_id": 2521, "verse_number": "१२-२६-१९", "content_sanskrit": "अघातयं च यत्कर्णं समरेष्वपलायिनम्।\nज्येष्ठभ्रातरमत्युग्रः को मत्तः पापकृत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072028, "chapter_id": 2521, "verse_number": "१२-२६-२०", "content_sanskrit": "अभिमन्युं च यद्वालं जातं सिंहमिवाद्रिषु।\nप्रावेशयमहं लुब्धो वाहिनीं द्रोणपालिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2072029, "chapter_id": 2521, "verse_number": "१२-२६-२१", "content_sanskrit": "तदाप्रभृति वीभत्सुं न शक्नोमि निरीक्षितुम्।\nकृष्णं च पुण्डरीकाक्षं किल्विषी भ्रूणहा यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2072030, "chapter_id": 2521, "verse_number": "१२-२६-२२", "content_sanskrit": "द्रौपदीं चाप्यदुःखार्हां पञ्चपुत्रैर्विनाकृताम्।\nशोचामि पृथिवीं हीनां पञ्चभिः पर्वतैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2072031, "chapter_id": 2521, "verse_number": "१२-२६-२३", "content_sanskrit": "सोऽहमागस्करः पापः पृथिवीनाशकारकः।\nआसीन एवमेवेदं शोषयिष्ये कलेवरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2072032, "chapter_id": 2521, "verse_number": "१२-२६-२४", "content_sanskrit": "प्रायोपविष्टं जानीध्वमथ मां गुरुघातिनम्।\nजातिष्वन्यास्वपि यथा न भवेयं कुलान्तकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2072033, "chapter_id": 2521, "verse_number": "१२-२६-२५", "content_sanskrit": "न भोक्ष्ये न च पानीयमुपयोक्ष्ये कथंचन।\nशोषयिष्ये प्रियान्प्राणानिहस्थोऽहं तपोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2072034, "chapter_id": 2521, "verse_number": "१२-२६-२६", "content_sanskrit": "यथेष्टं गम्यतां काममनुजाने प्रसाद्य वः।\nसर्वे मामनुजानीत त्यक्ष्यामीदं कलेवरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2072035, "chapter_id": 2521, "verse_number": "१२-२६-२७x", "content_sanskrit": "वैशम्पायन उवचा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2072036, "chapter_id": 2521, "verse_number": "१२-२६-२७", "content_sanskrit": "तमेवंवादिनं पार्थं बन्धुशोकेन विह्वलम्।\nमैवमित्यब्रवीद्व्यासो निगृह्य मुनिसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2072037, "chapter_id": 2521, "verse_number": "१२-२६-२८x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2072038, "chapter_id": 2521, "verse_number": "१२-२६-२८", "content_sanskrit": "अतिवेलं महाराज न शोकं कर्तुमर्हसि।\nपुनरुक्तं तु वक्ष्यामि दिष्टमेतदिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2072039, "chapter_id": 2521, "verse_number": "१२-२६-२९", "content_sanskrit": "संयोगा विप्रयोगाश्च जातानां प्राणिनां ध्रुवम्।\nबुद्धुदा इव तोयेषु भवन्ति न भवन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2072040, "chapter_id": 2521, "verse_number": "१२-२६-३०", "content_sanskrit": "सर्वे क्षयान्ता निचयाः पतनान्ताः समुच्छ्रयाः।\nसंयोगा विप्रयोगान्ता मरणान्तं हि जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2072041, "chapter_id": 2521, "verse_number": "१२-२६-३१", "content_sanskrit": "सुखं दुःखान्तमालस्यं दाक्ष्यं दुःखं सुखोदयम्।\nभूतिः श्रीर्ह्रीर्धृतिः कीर्तिर्दक्षे वसति नालसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2072042, "chapter_id": 2521, "verse_number": "१२-२६-३२", "content_sanskrit": "नालं सुखाय सुहृदो नाले दुःखाय शत्रवः।\nन च प्रज्ञालमर्थेभ्यो न सुखेभ्योऽप्यलं धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2072043, "chapter_id": 2521, "verse_number": "१२-२६-३३", "content_sanskrit": "यथा सृष्टोऽसि कौन्तेय धात्रा कर्मसु तत्क्ररु।\nअत एव हि सिद्धिस्ते नेशस्त्वं ह्यात्मनो नृप॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2072044, "chapter_id": 2521, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि षङ्विशोऽध्यायः॥ २६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]