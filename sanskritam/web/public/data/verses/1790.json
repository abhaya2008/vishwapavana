[{"id": 2036413, "chapter_id": 1790, "verse_number": "५-३५-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2036414, "chapter_id": 1790, "verse_number": "५-३५-१", "content_sanskrit": "ब्रूहि भूयो महाबुद्धे धर्मार्थसहितं वचः।\nश्रृण्वतो नास्ति मे तृप्तिर्विचित्राणीह भाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2036415, "chapter_id": 1790, "verse_number": "५-३५-२x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2036416, "chapter_id": 1790, "verse_number": "५-३५-२", "content_sanskrit": "सर्वतीर्थेषु वा स्नानं सर्वभूतेषु चार्जवम्।\nउभे त्वेते समे स्यातामार्जवं वा विशिष्यते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2036417, "chapter_id": 1790, "verse_number": "५-३५-३", "content_sanskrit": "आर्जवं प्रतिपद्यस्व पुत्रेषु सततं विभो।\nइह कीर्ति परां प्राप्य प्रेत्य स्वर्गमवाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2036418, "chapter_id": 1790, "verse_number": "५-३५-४", "content_sanskrit": "यावत्कीर्तिर्मनुष्यस्य पुण्या लोके प्रगीयते।\nतावत्स पुरुषव्याघ्र स्वर्गलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2036419, "chapter_id": 1790, "verse_number": "५-३५-५", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nविरोचनस्य संवादं केशिन्यर्थे सुधन्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2036420, "chapter_id": 1790, "verse_number": "५-३५-६", "content_sanskrit": "स्वयंवरे स्थिता कन्या केशिनी नाम नामतः।\nरूपेणाप्रतिमा राजन्विशिष्टपतिकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2036421, "chapter_id": 1790, "verse_number": "५-३५-७", "content_sanskrit": "विरोचनोऽथ दैतेयस्तदा तत्राजगाम ह।\nप्राप्तुमिच्छंस्ततस्तत्र दैत्येन्द्रं प्राह केशिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2036422, "chapter_id": 1790, "verse_number": "५-३५-८x", "content_sanskrit": "केशिन्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2036423, "chapter_id": 1790, "verse_number": "५-३५-८", "content_sanskrit": "किं ब्राह्मणाः स्विच्छ्रेयांसो दितिजाः स्विद्विरोचन\nअथ केन स्म पर्यङ्कं सुधन्वा नाधिरोहति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2036424, "chapter_id": 1790, "verse_number": "५-३५-९x", "content_sanskrit": "विरोचन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2036425, "chapter_id": 1790, "verse_number": "५-३५-९", "content_sanskrit": "प्राजापत्यास्तु वै श्रेष्ठा वयं केशिनि सत्तमाः।\nअस्माकं खल्विमे लोकाः के देवाः के द्विजातयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2036426, "chapter_id": 1790, "verse_number": "५-३५-१०x", "content_sanskrit": "केशिन्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2036427, "chapter_id": 1790, "verse_number": "५-३५-१०", "content_sanskrit": "इहैवावां प्रतीक्षाव उपस्थाने विरोचन।\nसुधन्वा प्रातरागन्ता पश्येयं वां समागतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2036428, "chapter_id": 1790, "verse_number": "५-३५-११x", "content_sanskrit": "विरोचन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2036429, "chapter_id": 1790, "verse_number": "५-३५-११", "content_sanskrit": "तथा भद्रे करिष्यामि यथा त्वं भीरु भाषसे।\nसुधन्वानं च मां चैव प्रातर्द्रष्टासि सङ्गतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2036430, "chapter_id": 1790, "verse_number": "५-३५-१२x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2036431, "chapter_id": 1790, "verse_number": "५-३५-१२", "content_sanskrit": "अतीतायां च शर्वर्यामुदिते सूर्यमण्डले।\nअथाजगाम तं देशं सुधन्वा राजसत्तम।\nविरोचनो यत्र विभो केशिन्या सहितः स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2036432, "chapter_id": 1790, "verse_number": "५-३५-१३", "content_sanskrit": "सुधन्वा च समागच्छत्प्राह्लादिं केशिनीं तथा।\nसमागतं द्विजं दृष्ट्वा केशिनी भरतर्षभ।\nप्रत्युत्थायासनं तस्मै पाद्यमर्घ्यं ददौ पुनः ॥ ५-३५-१४a` इति होवाच वचनं विरोचनमनुत्तमम्।\nआस्स्व तल्पे हि सौवर्णे प्राह्लादे ब्राह्मणस्त्वहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2036433, "chapter_id": 1790, "verse_number": "५-३५-१५", "content_sanskrit": "अन्वालभे हिरण्मयं प्राह्लादे ते वरासनम्।\nएकत्वमुपसंपन्नो नत्वासोऽहं त्वया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2036434, "chapter_id": 1790, "verse_number": "५-३५-१६x", "content_sanskrit": "विरोचन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2036435, "chapter_id": 1790, "verse_number": "५-३५-१६", "content_sanskrit": "तवार्हते तु फलकं कूर्चं वाप्यथवा बृसी।\nसुधन्वन्न त्वमर्होऽसि मया सह समासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2036436, "chapter_id": 1790, "verse_number": "५-३५-१७x", "content_sanskrit": "सुधन्वोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2036437, "chapter_id": 1790, "verse_number": "५-३५-१७", "content_sanskrit": "पितापुत्रौ सहासीतां द्वौ विप्रौ क्षत्रियावपि।\nवृद्धौ वैश्यौ च शूद्रौ च न त्वन्यावितरेतरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2036438, "chapter_id": 1790, "verse_number": "५-३५-१८", "content_sanskrit": "पिता हि ते समासीनमुपासीतैव मामधः।\nबालः सुखैधितो गेहे न त्वं किञ्चन बुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2036439, "chapter_id": 1790, "verse_number": "५-३५-१९x", "content_sanskrit": "विरोचन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2036440, "chapter_id": 1790, "verse_number": "५-३५-१९", "content_sanskrit": "हिरण्यं च गवाश्वं च यद्वित्तमसुरेषु नः।\nसुधन्वन्विपणे तेन प्रश्नं पृच्छाव ये वुदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2036441, "chapter_id": 1790, "verse_number": "५-३५-२०x", "content_sanskrit": "सुधन्वोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2036442, "chapter_id": 1790, "verse_number": "५-३५-२०", "content_sanskrit": "हिरण्यं च गवाश्वं च तवैवास्तु विरोचन।\nप्राणयोस्तु पणं कृत्वा प्रश्नं पृच्छाव ये विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2036443, "chapter_id": 1790, "verse_number": "५-३५-२१x", "content_sanskrit": "विरोचन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2036444, "chapter_id": 1790, "verse_number": "५-३५-२१", "content_sanskrit": "आवां कुत्र गमिष्यावः प्राणयोर्विपणे कृते।\nन तु देवेष्वहं स्थाता न मनुष्येषु कर्हिचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2036445, "chapter_id": 1790, "verse_number": "५-३५-२२x", "content_sanskrit": "सुधन्वोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2036446, "chapter_id": 1790, "verse_number": "५-३५-२२", "content_sanskrit": "पितरं ते गमिष्यावः प्राणयोर्विपणे कृपे।\nपुत्रस्यापि स हेतोर्हि प्रह्लादो नानृतं वदेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2036447, "chapter_id": 1790, "verse_number": "५-३५-२३x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2036448, "chapter_id": 1790, "verse_number": "५-३५-२३", "content_sanskrit": "एवं कृतपणौ क्रुद्धौ तत्राभिजग्मतुस्तदा।\nविरोचनसुधन्वानौ प्रह्लादौ यत्र तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2036449, "chapter_id": 1790, "verse_number": "५-३५-२४x", "content_sanskrit": "प्रह्लाद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2036450, "chapter_id": 1790, "verse_number": "५-३५-२४", "content_sanskrit": "इमौ तौ संप्रदृश्येते याभ्यां न चरितं सह।\nआशीविषाविव क्रुद्धावेकमार्गाविहागतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2036451, "chapter_id": 1790, "verse_number": "५-३५-२५", "content_sanskrit": "किं वै सहैवं चरथो न पुरा चरथः सह।\nविरोचनैतत्पृच्छामि किं ते सख्यं सुधन्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2036452, "chapter_id": 1790, "verse_number": "५-३५-२६x", "content_sanskrit": "विरोचन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2036453, "chapter_id": 1790, "verse_number": "५-३५-२६", "content_sanskrit": "न मे सुधन्वना सख्यं प्राणयोर्विपणावहे।\nप्रह्लाद तत्त्वं पृच्छामि मा प्रश्नमनृतं वदेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2036454, "chapter_id": 1790, "verse_number": "५-३५-२७x", "content_sanskrit": "प्रह्लाद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2036455, "chapter_id": 1790, "verse_number": "५-३५-२७", "content_sanskrit": "उदकं मधुपर्कं चाप्यानयन्तु सुधन्वने।\nब्रह्मन्नभ्यर्चनीयोऽसि श्वेता गौः पीवरी कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2036456, "chapter_id": 1790, "verse_number": "५-३५-२८x", "content_sanskrit": "सुधन्वोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2036457, "chapter_id": 1790, "verse_number": "५-३५-२८", "content_sanskrit": "उदकं मधुपर्कं च प्रश्नवाचार्पितं मम।\nप्रह्लद त्वं तु मे तथ्यं प्रश्नं प्रब्रूहि पृच्छतः।\nकिं ब्राह्मणाः स्विच्छ्रेयांस उताहो स्विद्विरोचनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2036458, "chapter_id": 1790, "verse_number": "५-३५-२९x", "content_sanskrit": "प्रह्लाद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2036459, "chapter_id": 1790, "verse_number": "५-३५-२९", "content_sanskrit": "` न कल्माषो न कपिलो न कृष्णो न च लोहितः।\nअणीयान्क्षुरधारायाः को धर्मं वक्तुमर्हिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2036460, "chapter_id": 1790, "verse_number": "५-३५-३०", "content_sanskrit": "अभिवाद्यो भवान्ब्रह्मन्साक्ष्ये चैव नियोजितः ।\nपुत्र एको मम ब्रह्मंस्त्वं च साक्षादिहास्थितः ।\nतयोर्विवदतोः प्रश्नं कथमस्मद्विधो वदेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2036461, "chapter_id": 1790, "verse_number": "५-३५-३१x", "content_sanskrit": "सुधन्वोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2036462, "chapter_id": 1790, "verse_number": "५-३५-३१", "content_sanskrit": "` यदेतत्त्वं न वक्ष्यसि यदि वापि विवक्ष्यसि।\nप्रह्लाद प्रश्नमतुलं मूर्धा ते विफलिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2036463, "chapter_id": 1790, "verse_number": "५-३५-३२x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2036464, "chapter_id": 1790, "verse_number": "५-३५-३२", "content_sanskrit": "आदित्येन सहायान्तं प्रह्लादो हंसमब्रवीत्।\nधृतराष्ट्र महाप्राज्ञ सर्वज्ञं सर्वदर्शिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2036465, "chapter_id": 1790, "verse_number": "५-३५-३३x", "content_sanskrit": "प्रह्लाद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2036466, "chapter_id": 1790, "verse_number": "५-३५-३३", "content_sanskrit": "पुत्रो वाऽन्यो भवेद्ब्रह्मन्साक्ष्ये चापि भवेत्स्थितः।\nतयोर्विवदतोर्हंस कथं धर्मः प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2036467, "chapter_id": 1790, "verse_number": "५-३५-३४x", "content_sanskrit": "हंस उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2036468, "chapter_id": 1790, "verse_number": "५-३५-३४", "content_sanskrit": "गां प्रदद्यादौरसाय यद्वान्यत्स्यात्प्रियं धनम्।\nद्वयोर्विवदतो राजन्प्रश्नं सत्यं यथा वदेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2036469, "chapter_id": 1790, "verse_number": "५-३५-३५x", "content_sanskrit": "प्रह्लाद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2036470, "chapter_id": 1790, "verse_number": "५-३५-३५", "content_sanskrit": "अथ यो नैव प्रब्रूयात्सत्यं वा यदि वाऽनृतम्।\nहंस तत्वं च पृच्छामि कियदेनः करोति सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2036471, "chapter_id": 1790, "verse_number": "५-३५-३६x", "content_sanskrit": "`हंस उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2036472, "chapter_id": 1790, "verse_number": "५-३५-३६", "content_sanskrit": "पृष्टो धर्मं न विब्रूयाद्गोकर्णशिथिलं चरन्।\nधर्माद्भ्रश्यति राजंस्तु नास्य लोकोऽस्ति न प्रजाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2036473, "chapter_id": 1790, "verse_number": "५-३५-३७", "content_sanskrit": "धर्म एतान्संरुजति यथा नद्यस्तु कूलजान्।\nये धर्ममनुपश्यन्तस्तूष्णीं ध्यायन्त आसते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2036474, "chapter_id": 1790, "verse_number": "५-३५-३८", "content_sanskrit": "श्रेष्ठोऽर्धं तु हरेत्तत्र भवेत्पादश्च कर्तरि।\nपादस्तेषु सभासत्सु यत्र निन्द्यो न निन्द्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2036475, "chapter_id": 1790, "verse_number": "५-३५-३९", "content_sanskrit": "अनेना भवति श्रेष्ठो मुच्यन्तेऽपि सभासदः।\nकर्तारमेनो गच्छेद्वा निन्द्यो यत्र हि निन्द्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2036476, "chapter_id": 1790, "verse_number": "५-३५-४०x", "content_sanskrit": "प्रह्लाद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2036477, "chapter_id": 1790, "verse_number": "५-३५-४०", "content_sanskrit": "मोहाद्वा चैव कामाद्वा मिथ्यावादं यदि ब्रुवन्।\nधृतराष्ट्र तत्वं पृच्छामि दुर्विवक्ता तु किं वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2036478, "chapter_id": 1790, "verse_number": "५-३५-४१x", "content_sanskrit": "हंस उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2036479, "chapter_id": 1790, "verse_number": "५-३५-४१", "content_sanskrit": "यां रात्रिमधिविन्ना स्त्री यां चैवाक्षपराजितः।\nयां च भाराभितप्ताङ्गो दुर्विवक्ता तु तां वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2036480, "chapter_id": 1790, "verse_number": "५-३५-४२", "content_sanskrit": "नगरे प्रतिरुद्धः सन्बहिर्द्वारे बुभुक्षितः।\nअमित्रान्भूयसः पश्यन्दुर्विवक्ता तु तां वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2036481, "chapter_id": 1790, "verse_number": "५-३५-४३", "content_sanskrit": "यां च रात्रिमभिद्रुग्धो यां च मित्रे प्रियेऽनृते।\nसर्वस्वेन च हीनो यो दुर्विवक्ता तु तां वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2036482, "chapter_id": 1790, "verse_number": "५-३५-४४", "content_sanskrit": "पञ्च पश्वनृते हन्ति दश हन्ति गवानृते।\nशतमश्वानृते हन्ति सहस्रं पुरुषानृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2036483, "chapter_id": 1790, "verse_number": "५-३५-४५", "content_sanskrit": "हन्ति जातानजातांश्च हिरण्यार्थेऽनृतं वदन्।\nसर्वं भूम्यनृते हन्ति मा स्म भूम्यनृतं वदेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2036484, "chapter_id": 1790, "verse_number": "५-३५-४६x", "content_sanskrit": "प्रह्लाद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2036485, "chapter_id": 1790, "verse_number": "५-३५-४६", "content_sanskrit": "मत्तः श्रेयानङ्गिरा वै सुधन्वा त्विद्वरोचन।\nमातास्य श्रेयसी मातुस्तस्मात्त्वं तेन वै जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2036486, "chapter_id": 1790, "verse_number": "५-३५-४७", "content_sanskrit": "विरोचन सुधन्वाऽयं प्राणानामीश्वरस्तव।\nसुधन्वन्पुनरिच्छामि त्वया दत्तं विरोचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2036487, "chapter_id": 1790, "verse_number": "५-३५-४८x", "content_sanskrit": "सुधन्वोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2036488, "chapter_id": 1790, "verse_number": "५-३५-४८", "content_sanskrit": "यद्धर्ममवृणीथास्त्वं न कामादनृतं वदीः।\nपुनर्ददामि ते पुत्रं तस्मात्प्रह्लाद दुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2036489, "chapter_id": 1790, "verse_number": "५-३५-४९", "content_sanskrit": "एष प्रह्लाद पुत्रस्ते मया दत्तो विरोचनः।\nपादप्रक्षालनं कुर्यात्कुमार्याः सन्निधौ मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2036490, "chapter_id": 1790, "verse_number": "५-३५-५०x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2036491, "chapter_id": 1790, "verse_number": "५-३५-५०", "content_sanskrit": "तस्माद्राजेन्द्र भूम्यर्थे नानृतं वक्तुमर्हसि।\nमा गमः ससुतामात्यो नाशं पुत्रार्थमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2036492, "chapter_id": 1790, "verse_number": "५-३५-५१", "content_sanskrit": "न देवा यष्टिमादाय रक्षन्ति पशुपालवत्।\nयं तु रक्षितुमिच्छन्ति बुद्ध्या संयोजयन्ति तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2036493, "chapter_id": 1790, "verse_number": "५-३५-५२", "content_sanskrit": "यथायथा हि पुरुषः कल्याणे कुरुते मनः।\nतथातथाऽस्य सर्वार्थाः सिद्ध्यन्ते नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2036494, "chapter_id": 1790, "verse_number": "५-३५-५३", "content_sanskrit": "नैनं छन्दांसि वृजिनात्तारयन्ति\nमायाविनं मायया वर्तमानम्।\nनीडं शकुन्ता इव जातपक्षा-\nश्छन्दांस्येनं प्रजहत्यन्तकाले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2036495, "chapter_id": 1790, "verse_number": "५-३५-५४", "content_sanskrit": "मद्यपानं कलहं पूगवैरं\nभार्यापत्योरन्तरं ज्ञातिभेदम्।\nराजद्विष्टं स्त्रीपुंसयोर्विवादं\nवर्ज्यान्याहुर्यश्च पन्थाः प्रदुष्टः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2036496, "chapter_id": 1790, "verse_number": "५-३५-५५", "content_sanskrit": "सामुद्रिकं वणिजं चोरपूर्वं\nशलाकधूर्तं च चिकित्सकं च।\nअरिं च मित्रं च कुशीलवं च\nनैतान्साक्ष्ये त्वधिकृर्वीत सप्त ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2036497, "chapter_id": 1790, "verse_number": "५-३५-५६", "content_sanskrit": "मानाग्निहोत्रमुत मानमौनं\nमानेनाधीतमुत मानयज्ञः।\nएतानि चत्वार्यभयङ्कराणि\nभयं प्रयच्छन्त्ययथाकृतानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2036498, "chapter_id": 1790, "verse_number": "५-३५-५७", "content_sanskrit": "अगारदाही गरदः कुण्डाशी सोमविक्रयी।\nपर्वकारश्च सूची च मित्रध्रुक्पारदारिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2036499, "chapter_id": 1790, "verse_number": "५-३५-५८", "content_sanskrit": "भ्रूणहा गुरुतल्पी च यश्च स्यात्पानपो द्विजः।\nअतितीक्ष्णश्च कारुश्च नास्तिको वेदनिन्दकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2036500, "chapter_id": 1790, "verse_number": "५-३५-५९", "content_sanskrit": "स्रुवप्रग्रहणो व्रात्यः कीनाशश्चात्मवानपि ।\nरक्षेत्युक्तश्च यो हिंस्यात्सर्वे ब्रह्महभिः समाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2036501, "chapter_id": 1790, "verse_number": "५-३५-६०", "content_sanskrit": "तृणोल्कया ज्ञायते जातरूपं\nवृत्तेन भद्रो व्यवहारेण साधुः।\nशूरो भयेष्वर्थकृच्छ्रेषु धीरः\nकृच्छ्रेष्वापत्सु सुहृदश्चारयश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2036502, "chapter_id": 1790, "verse_number": "५-३५-६१", "content_sanskrit": "जरा रूपं हरति हि धैर्यमाशा\nमृत्युः प्राणान्धर्मचर्यामसूया।\nक्रोधः श्रियं शीलमनार्यसेवा\nह्रियं कामः सर्वमेवाभिमानः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2036503, "chapter_id": 1790, "verse_number": "५-३५-६२", "content_sanskrit": "न क्रोधिनोऽर्थो न नृशंमस्य मित्रं\nक्रृगस्य न स्त्री सुखिनो न विद्या ।\nन कामिनो ह्रीरलसस्य न श्रीः\nसर्वं तु न स्यादनवस्थितस्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2036504, "chapter_id": 1790, "verse_number": "५-३५-६३", "content_sanskrit": "श्रीर्मङ्गलान्प्रभवति प्रागल्भ्यात्संप्रवर्धते।\nदाक्ष्यात्तु कुरुते मूलं संयमान्प्रतितिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2036505, "chapter_id": 1790, "verse_number": "५-३५-६४", "content_sanskrit": "अष्टौ गुणाः पुरुषं दीपयन्ति\nप्रज्ञा च कौल्यं च दमः श्रुतं च।\nपराक्रमश्चाबहुभाषिता च\nदानं यथाशक्ति कृतज्ञता च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2036506, "chapter_id": 1790, "verse_number": "५-३५-६५", "content_sanskrit": "एतान्गुणांस्तत महानुभावा-\nनेको गुणः संश्रयते प्रसह्य\nराजा यदा सत्कुरुते मनुष्यं\nसर्वान्गुणानेप गुणोतिभाति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2036507, "chapter_id": 1790, "verse_number": "५-३५-६६", "content_sanskrit": "अष्टौ नृपेमानि मनुष्यलोके\nस्वर्गस्य लोकस्य निदर्शनानि।\nचत्वार्येपामन्ववेतानि सद्भि-\nश्चत्वारि चैपामनुयान्ति सन्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2036508, "chapter_id": 1790, "verse_number": "५-३५-६७", "content_sanskrit": "यज्ञो दानमध्ययनं तपश्च\nचत्वार्येतान्यन्ववेतानि सद्भिः।\nदमः सत्यमार्जवमानृशंस्यं\nचत्वार्येतान्यनुयान्ति सन्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2036509, "chapter_id": 1790, "verse_number": "५-३५-६८", "content_sanskrit": "इज्याध्ययनदानानि तपः सत्यं क्षमा घृणा।\nअलोभ इति मार्गोऽयं धर्मस्याष्टविधः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2036510, "chapter_id": 1790, "verse_number": "५-३५-६९", "content_sanskrit": "तत्र पूर्वचतुर्वर्गो दम्भार्थमपि सेव्यते।\nउत्तरश्च चतुर्वर्गो नामहात्मसु तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2036511, "chapter_id": 1790, "verse_number": "५-३५-७०", "content_sanskrit": "न सा सभा यत्र न सन्ति वृद्धा\nन ते वृद्धा ये न वदन्ति धर्मम्।\nनासौ धर्मो यत्र न सत्यमस्ति\nन तत्सत्यं यच्छलेनानुविद्धम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2036512, "chapter_id": 1790, "verse_number": "५-३५-७१", "content_sanskrit": "सत्यं रूपं श्रुतं विद्या कौल्यं शीलं बलं धनम्।\nशौर्यं च चित्रभाष्यं च दशेमे स्वर्गयोनयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2036513, "chapter_id": 1790, "verse_number": "५-३५-७२", "content_sanskrit": "पापं कुर्वन्पापकीर्तिः पापमेवाश्रुते फलम्।\nपुण्यं कुर्वन्पापकीर्तिः पुण्यमत्यन्तमश्रुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2036514, "chapter_id": 1790, "verse_number": "५-३५-७३", "content_sanskrit": "तस्मात्पापं न कुर्वीत पुरुषः शंसितव्रतः।\nपापं प्रज्ञां नाशयति क्रियमाणं पुःन पुःनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2036515, "chapter_id": 1790, "verse_number": "५-३५-७४", "content_sanskrit": "वृद्धप्रज्ञः पापमेव नित्यमारभते नरः।\nपुण्यं प्रज्ञां वर्धयति क्रियमाणं पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2036516, "chapter_id": 1790, "verse_number": "५-३५-७५", "content_sanskrit": "वृद्धप्रज्ञः पुण्यमेव नित्यमारभते नरः।\nपुण्यं कुर्वन्पुण्यकीर्तिः पुण्यं स्थानं स्म गच्छति।\nतस्मात्पुण्यं निषेवेत पुरुषः सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2036517, "chapter_id": 1790, "verse_number": "५-३५-७६", "content_sanskrit": "असूयको दन्दशूको निष्ठुरो वैरकृच्छठः।\nस कृच्छ्रं महदाप्नोति नचिरात्पापमाचरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2036518, "chapter_id": 1790, "verse_number": "५-३५-७७", "content_sanskrit": "अनसूयुः कृतप्रज्ञः शोभनान्याचरन्सदा।\nनकृच्छ्रं महदाप्नोति सर्वत्र च विरोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2036519, "chapter_id": 1790, "verse_number": "५-३५-७८", "content_sanskrit": "प्रज्ञामेवागमयति यः प्राज्ञेभ्यः स पण्डितः।\nप्राज्ञो ह्यवाप्य धर्मार्थौ शक्नोति सुखमेधितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2036520, "chapter_id": 1790, "verse_number": "५-३५-७९", "content_sanskrit": "दिवसेनैव तत्कुर्याद्येन रात्रौ सुखं वसेत्।\nअष्टमासेन तत्कुर्याद्येन वर्षाः सुखं वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2036521, "chapter_id": 1790, "verse_number": "५-३५-८०", "content_sanskrit": "पूर्वे वयसि तत्कुर्याद्येन वृद्धः सुखं वसेत्।\nयावज्जीवं तु तत्कुर्याद्येन प्रेत्य सुखं वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2036522, "chapter_id": 1790, "verse_number": "५-३५-८१", "content_sanskrit": "जीर्णमन्नं प्रशंसन्ति भार्यां च गतयौवनाम्।\nशूरं विजितसङ्ग्रामं गतपारं तपस्विनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2036523, "chapter_id": 1790, "verse_number": "५-३५-८२", "content_sanskrit": "धनेनाधर्मलब्धेन यच्छिद्रमपिधीयते।\nअसंवृतं तद्भवति ततोऽन्यदवदीर्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2036524, "chapter_id": 1790, "verse_number": "५-३५-८३", "content_sanskrit": "गुरुरात्मवतां शास्ता शास्ता राजा दुरात्मनाम्।\nअन्तः प्रच्छन्नपापानां शास्ता वैवस्वतो यमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2036525, "chapter_id": 1790, "verse_number": "५-३५-८४", "content_sanskrit": "ऋषीणां च नदीनां च कुलानां च महात्मनाम्।\nप्रभवो नाधिगन्तव्यः स्त्रीणां दुश्चरितस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2036526, "chapter_id": 1790, "verse_number": "५-३५-८५", "content_sanskrit": "द्विजातिपूजाभिरतो दाता ज्ञातिषु चार्जवी ।\nक्षत्रियः शीलभाग्राजंश्चिरं पालयते महीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2036527, "chapter_id": 1790, "verse_number": "५-३५-८६", "content_sanskrit": "सुवर्णपुष्पां पृथिवीं चिन्वन्ति पुरुषास्त्रयः।\nशूरश्च कृतविद्यश्च यश्च जानाति सेवितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2036528, "chapter_id": 1790, "verse_number": "५-३५-८७", "content_sanskrit": "बुद्धिश्रेष्ठानि कर्माणि बाहुमध्यानि भारत।\nतानि जङ्घाजघन्यानि भारप्रत्यवराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2036529, "chapter_id": 1790, "verse_number": "५-३५-८८", "content_sanskrit": "दुर्योधनेऽथ शकुनौ मूढे दुःशासने तथा।\nकर्मे चैश्वर्यमाधाय कथं त्वं भूतिमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2036530, "chapter_id": 1790, "verse_number": "५-३५-८९", "content_sanskrit": "सर्वैर्गुणैरुपेतास्तु पाण्डवा भरतर्षभ ।\nपितृवत्त्वयि वर्तन्ते तेषु वर्तस्व पुत्रवत् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2036531, "chapter_id": 1790, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि प्रजागरपर्वणि पञ्चत्रिंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}]