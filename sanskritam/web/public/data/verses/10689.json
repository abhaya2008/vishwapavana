[{"id": 50003300, "chapter_id": 10689, "verse_number": "1", "content_sanskrit": "इन्द्रियाणि पराण्याहुरिन्द्रियेभ्यः परं मनः। मनसस्तु परा बुद्धिर्यो बुद्धेः परतस्तु सः॥ ३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50003301, "chapter_id": 10689, "verse_number": "2", "content_sanskrit": "एवं बुद्धेः परं बुद्ध्वा संस्तभ्यात्मानमात्मना। जहि शत्रुं महाबाहो कामरूपं दुरासदम्॥ ३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50003302, "chapter_id": 10689, "verse_number": "3", "content_sanskrit": "॥ ओन्तत्सत्॥ इति श्रीमद्भगवद्गीतासूपनिषत्सु ब्रह्मविद्यायां योगशास्त्रे श्रीकृष्णार्जुनसंवादे कर्मयोगो नाम तृतीयोऽध्यायः॥ ४३ श्लोकाः॥ आदितः १६२ श्लोकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50003303, "chapter_id": 10689, "verse_number": "4", "content_sanskrit": "॥ ज्ञानयोगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50003304, "chapter_id": 10689, "verse_number": "5", "content_sanskrit": "॥ गीतोक्तधर्मस्य पारम्परिकत्वनिरूपणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50003305, "chapter_id": 10689, "verse_number": "6", "content_sanskrit": "श्रीभगवानुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50003306, "chapter_id": 10689, "verse_number": "7", "content_sanskrit": "इमं विवस्वते योगं प्रोक्तवानहमव्ययम्। विवस्वान् मनवे प्राह मनुरिक्ष्वाकवेऽब्रवीत्॥ ४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50003307, "chapter_id": 10689, "verse_number": "8", "content_sanskrit": "एवं परम्पराप्राप्तमिमं राजर्षयो विदुः। स कालेनेह महता योगो नष्टः परन्तप॥ ४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50003308, "chapter_id": 10689, "verse_number": "9", "content_sanskrit": "स एवायं मया तेऽद्य योगः प्रोक्तः पुरातनः। भक्तोऽसि मे सखा चेति रहस्यं ह्येतदुत्तमम्॥ ४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50003309, "chapter_id": 10689, "verse_number": "10", "content_sanskrit": "॥ जीवेश्वरभेदपुरःसरं विष्णुमाहात्म्यप्रतिपादनप्रकरणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]