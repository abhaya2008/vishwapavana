[{"id": 40016171, "chapter_id": 9243, "verse_number": "1", "content_sanskrit": "वज्रदंष्ट्रंहतंश्रुत्वावालिपुत्रेणरावणः । बलाध्यक्षमुवाचेदंकृताञ्जलिमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40016172, "chapter_id": 9243, "verse_number": "2", "content_sanskrit": "शीघ्रंनिर्यान्तुदुर्धर्षाराक्षसाभीमविक्रमाः । अकम्पनंपुरस्कृत्यसर्वशस्त्रप्रकोविदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40016173, "chapter_id": 9243, "verse_number": "3", "content_sanskrit": "एषशास्ताचगोप्ताचनेताचयुधिसत्तमः । भूतिकामश्चमेनित्यंनित्यंचसमरप्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40016174, "chapter_id": 9243, "verse_number": "4", "content_sanskrit": "एषजेष्यतिकाकत्स्थौसुग्रीवंचमहाबलम् । वानरांश्चापरान् घोरान् हनिष्यतिपरन्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40016175, "chapter_id": 9243, "verse_number": "5", "content_sanskrit": "परिगृह्यसःताम् I ज्ञाम् रावणस्यमहाबल । बलम् सम्प्रेरयामासःतदालघुपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40016176, "chapter_id": 9243, "verse_number": "6", "content_sanskrit": "ततोनानाप्रहरणाभीमाक्षाभीमदर्शनाः । निष्पेतूराक्षसामुख्याबलाध्यक्षप्रचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40016177, "chapter_id": 9243, "verse_number": "7", "content_sanskrit": "रथमास्थायविपुलंतप्तकाञ्चनभूषणम् । मेघाभोमेघवर्णश्चमेघस्वनमहास्वनः ॥ राक्षसैःसम्वृतोघोरैस्तदानिर्यात्यकम्पनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40016178, "ch