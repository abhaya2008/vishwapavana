[{"id": 5000243000, "chapter_id": 9243, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे सप्तचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000243001, "chapter_id": 9243, "verse_number": "३-४७-१", "content_sanskrit": "रावणेन तु वैदेही तदा पृष्टा जिहीर्षुणा।\nपरिव्राजकरूपेण शशंसात्मानमात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000243002, "chapter_id": 9243, "verse_number": "३-४७-२", "content_sanskrit": "ब्राह्मणश्चातिथिश्चैष अनुक्तो हि शपेत माम्।\nइति ध्यात्वा मुहूर्तं तु सीता वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000243003, "chapter_id": 9243, "verse_number": "३-४७-३", "content_sanskrit": "दुहिता जनकस्याहं मैथिलस्य महात्मनः।\nसीता नाम्नास्मि भद्रं ते रामस्य महिषी प्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000243004, "chapter_id": 9243, "verse_number": "३-४७-४", "content_sanskrit": "उषित्वा द्वादश समा इक्ष्वाकूणां निवेशने।\nभुञ्जाना मानुषान् भोगान् सर्वकामसमृद्धिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000243005, "chapter_id": 9243, "verse_number": "३-४७-५", "content_sanskrit": "तत्र त्रयोदशे वर्षे राजाऽमन्त्रयत प्रभुः।\nअभिषेचयितुं रामं समेतो राजमन्त्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000243006, "chapter_id": 9243, "verse_number": "३-४७-६", "content_sanskrit": "तस्मिन् सम्भ्रियमाणे तु राघवस्याभिषेचने।\nकैकेयी नाम भर्तारं ममार्या याचते वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000243007, "chapter_id": 9243, "verse_number": "३-४७-७", "content_sanskrit": "परिगृह्य तु कैकेयी श्वशुरं सुकृतेन मे।\nमम प्रव्राजनं भर्तुर्भरतस्याभिषेचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000243008, "chapter_id": 9243, "verse_number": "३-४७-८", "content_sanskrit": "द्वावयाचत भर्तारं सत्यसंधं नृपोत्तमम्।\nनाद्य भोक्ष्ये न च स्वप्स्ये न पास्ये न कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000243009, "chapter_id": 9243, "verse_number": "३-४७-९", "content_sanskrit": "एष मे जीवितस्यान्तो रामो यदभिषिच्यते।\nइति ब्रुवाणां कैकेयीं श्वशुरो मे स पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000243010, "chapter_id": 9243, "verse_number": "३-४७-१०", "content_sanskrit": "अयाचतार्थैरन्वर्थैर्न च याच्ञां चकार सा।\nमम भर्ता महातेजा वयसा पञ्चविंशकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000243011, "chapter_id": 9243, "verse_number": "३-४७-११", "content_sanskrit": "अष्टादश हि वर्षाणि मम जन्मनि गण्यते।\nरामेति प्रथितो लोके सत्यवान् शीलवान् शुचिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000243012, "chapter_id": 9243, "verse_number": "३-४७-१२", "content_sanskrit": "विशालाक्षो महाबाहुः सर्वभूतहिते रतः।\nकामार्तश्च महाराजः पिता दशरथः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000243013, "chapter_id": 9243, "verse_number": "३-४७-१३", "content_sanskrit": "कैकेय्याः प्रियकामार्थं तं रामं नाभ्यषेचयत्।\nअभिषेकाय तु पितुः समीपं राममागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000243014, "chapter_id": 9243, "verse_number": "३-४७-१४", "content_sanskrit": "कैकेयी मम भर्तारमित्युवाच द्रुतं वचः।\nतव पित्रा समाज्ञप्तं ममेदं शृणु राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000243015, "chapter_id": 9243, "verse_number": "३-४७-१५", "content_sanskrit": "भरताय प्रदातव्यमिदं राज्यमकण्टकम्।\nत्वया तु खलु वस्तव्यं नव वर्षाणि पञ्च च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000243016, "chapter_id": 9243, "verse_number": "३-४७-१६", "content_sanskrit": "वने प्रव्रज काकुत्स्थ पितरं मोचयानृतात् ।\nतथेत्युवाच तां रामः कैकेयीमकुतोभयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000243017, "chapter_id": 9243, "verse_number": "३-४७-१७", "content_sanskrit": "चकार तद्वचः श्रुत्वा भर्ता मम दृढव्रतः।\nदद्यान्न प्रतिगृह्णीयात् सत्यं ब्रूयान्न चानृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000243018, "chapter_id": 9243, "verse_number": "३-४७-१८", "content_sanskrit": "एतद् ब्राह्मण रामस्य व्रतं धृतमनुत्तमम्।\nतस्य भ्राता तु वैमात्रो लक्ष्मणो नाम वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000243019, "chapter_id": 9243, "verse_number": "३-४७-१९", "content_sanskrit": "रामस्य पुरुषव्याघ्रः सहायः समरेऽरिहा।\nस भ्राता लक्ष्मणो नाम ब्रह्मचारी दृढव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000243020, "chapter_id": 9243, "verse_number": "३-४७-२०", "content_sanskrit": "अन्वगच्छद् धनुष्पाणिः प्रव्रजन्तं मया सह।\nजटी तापसरूपेण मया सह सहानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000243021, "chapter_id": 9243, "verse_number": "३-४७-२१", "content_sanskrit": "प्रविष्टो दण्डकारण्यं धर्मनित्यो दृढव्रतः।\nते वयं प्रच्युता राज्यात् कैकेय्यास्तु कृते त्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000243022, "chapter_id": 9243, "verse_number": "३-४७-२२", "content_sanskrit": "विचराम द्विजश्रेष्ठ वनं गम्भीरमोजसा।\nसमाश्वस मुहूर्तं तु शक्यं वस्तुमिह त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000243023, "chapter_id": 9243, "verse_number": "३-४७-२३", "content_sanskrit": "आगमिष्यति मे भर्ता वन्यमादाय पुष्कलम्।\nरुरून् गोधान् वराहांश्च हत्वाऽऽदायामिषं बहु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000243024, "chapter_id": 9243, "verse_number": "३-४७-२४", "content_sanskrit": "स त्वं नाम च गोत्रं च कुलमाचक्ष्व तत्त्वतः।\nएकश्च दण्डकारण्ये किमर्थं चरसि द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000243025, "chapter_id": 9243, "verse_number": "३-४७-२५", "content_sanskrit": "एवं ब्रुवत्यां सीतायां रामपत्न्यां महाबलः।\nप्रत्युवाचोत्तरं तीव्रं रावणो राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000243026, "chapter_id": 9243, "verse_number": "३-४७-२६", "content_sanskrit": "येन वित्रासिता लोकाः सदेवासुरमानुषाः।\nअहं स रावणो नाम सीते रक्षोगणेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000243027, "chapter_id": 9243, "verse_number": "३-४७-२७", "content_sanskrit": "त्वां तु काञ्चनवर्णाभां दृष्ट्वा कौशेयवासिनीम्।\nरतिं स्वकेषु दारेषु नाधिगच्छाम्यनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000243028, "chapter_id": 9243, "verse_number": "३-४७-२८", "content_sanskrit": "बह्वीनामुत्तमस्त्रीणामाहृतानामितस्ततः।\nसर्वासामेव भद्रं ते ममाग्रमहिषी भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000243029, "chapter_id": 9243, "verse_number": "३-४७-२९", "content_sanskrit": "लङ्का नाम समुद्रस्य मध्ये मम महापुरी।\nसागरेण परिक्षिप्ता निविष्टा गिरिमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000243030, "chapter_id": 9243, "verse_number": "३-४७-३०", "content_sanskrit": "तत्र सीते मया सार्धं वनेषु विचरिष्यसि।\nन चास्य वनवासस्य स्पृहयिष्यसि भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000243031, "chapter_id": 9243, "verse_number": "३-४७-३१", "content_sanskrit": "पञ्च दास्यः सहस्राणि सर्वाभरणभूषिताः।\nसीते परिचरिष्यन्ति भार्या भवसि मे यदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000243032, "chapter_id": 9243, "verse_number": "३-४७-३२", "content_sanskrit": "रावणेनैवमुक्ता तु कुपिता जनकात्मजा।\nप्रत्युवाचानवद्याङ्गी तमनादृत्य राक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000243033, "chapter_id": 9243, "verse_number": "३-४७-३३", "content_sanskrit": "महागिरिमिवाकम्प्यं महेन्द्रसदृशं पतिम्।\nमहोदधिमिवाक्षोभ्यमहं राममनुव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000243034, "chapter_id": 9243, "verse_number": "३-४७-३४", "content_sanskrit": "सर्वलक्षणसम्पन्नं न्यग्रोधपरिमण्डलम्।\nसत्यसंधं महाभागमहं राममनुव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000243035, "chapter_id": 9243, "verse_number": "३-४७-३५", "content_sanskrit": "महाबाहुं महोरस्कं सिंहविक्रान्तगामिनम्।\nनृसिंहं सिंहसंकाशमहं राममनुव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000243036, "chapter_id": 9243, "verse_number": "३-४७-३६", "content_sanskrit": "पूर्णचन्द्राननं रामं राजवत्सं जितेन्द्रियम्।\nपृथुकीर्तिं महाबाहुमहं राममनुव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000243037, "chapter_id": 9243, "verse_number": "३-४७-३७", "content_sanskrit": "त्वं पुनर्जम्बुकः सिंहीं मामिहेच्छसि दुर्लभाम्।\nनाहं शक्या त्वया स्प्रष्टुमादित्यस्य प्रभा यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000243038, "chapter_id": 9243, "verse_number": "३-४७-३८", "content_sanskrit": "पादपान् काञ्चनान् नूनं बहून् पश्यसि मन्दभाक्।\nराघवस्य प्रियां भार्यां यस्त्वमिच्छसि राक्षस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000243039, "chapter_id": 9243, "verse_number": "३-४७-३९", "content_sanskrit": "क्षुधितस्य च सिंहस्य मृगशत्रोस्तरस्विनः।\nआशीविषस्य वदनाद् दंष्ट्रामादातुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000243040, "chapter_id": 9243, "verse_number": "३-४७-४०", "content_sanskrit": "मन्दरं पर्वतश्रेष्ठं पाणिना हर्तुमिच्छसि।\nकालकूटं विषं पीत्वा स्वस्तिमान् गन्तुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000243041, "chapter_id": 9243, "verse_number": "३-४७-४१", "content_sanskrit": "अक्षि सूच्या प्रमृजसि जिह्वया लेढि च क्षुरम्।\nराघवस्य प्रियां भार्यामधिगन्तुं त्वमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000243042, "chapter_id": 9243, "verse_number": "३-४७-४२", "content_sanskrit": "अवसज्य शिलां कण्ठे समुद्रं तर्तुमिच्छसि।\nसूर्याचन्द्रमसौ चोभौ पाणिभ्यां हर्तुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000243043, "chapter_id": 9243, "verse_number": "३-४७-४३", "content_sanskrit": "यो रामस्य प्रियां भार्यां प्रधर्षयितुमिच्छसि।\nअग्निं प्रज्वलितं दृष्ट्वा वस्त्रेणाहर्तुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000243044, "chapter_id": 9243, "verse_number": "३-४७-४४", "content_sanskrit": "कल्याणवृत्तां यो भार्यां रामस्याहर्तुमिच्छसि।\nअयोमुखानां शूलानामग्रे चरितुमिच्छसि।\nरामस्य सदृशीं भार्यां योऽधिगन्तुं त्वमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000243045, "chapter_id": 9243, "verse_number": "३-४७-४५", "content_sanskrit": "यदन्तरं सिंहसृगालयोर्वने\nयदन्तरं स्यन्दनिकासमुद्रयोः।\nसुराग्र्यसौवीरकयोर्यदन्तरं\nतदन्तरं दाशरथेस्तवैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000243046, "chapter_id": 9243, "verse_number": "३-४७-४६", "content_sanskrit": "यदन्तरं काञ्चनसीसलोहयो-\nर्यदन्तरं चन्दनवारिपङ्कयोः।\nयदन्तरं हस्तिबिडालयोर्वने\nतदन्तरं दाशरथेस्तवैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000243047, "chapter_id": 9243, "verse_number": "३-४७-४७", "content_sanskrit": "यदन्तरं वायसवैनतेययो-\nर्यदन्तरं मद्गुमयूरयोरपि।\nयदन्तरं हंसकगृध्रयोर्वने\nतदन्तरं दाशरथेस्तवैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000243048, "chapter_id": 9243, "verse_number": "३-४७-४८", "content_sanskrit": "तस्मिन् सहस्राक्षसमप्रभावे\nरामे स्थिते कार्मुकबाणपाणौ।\nहृतापि तेऽहं न जरां गमिष्ये\nआज्यं यथा मक्षिकयावगीर्णम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000243049, "chapter_id": 9243, "verse_number": "३-४७-४९", "content_sanskrit": "इतीव तद्वाक्यमदुष्टभावा\nसुदुष्टमुक्त्वा रजनीचरं तम्।\nगात्रप्रकम्पाद् व्यथिता बभूव\nवातोद्धता सा कदलीव तन्वी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000243050, "chapter_id": 9243, "verse_number": "३-४७-५०", "content_sanskrit": "तां वेपमानामुपलक्ष्य सीतां\nस रावणो मृत्युसमप्रभावः।\nकुलं बलं नाम च कर्म चात्मनः\nसमाचचक्षे भयकारणार्थम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000243051, "chapter_id": 9243, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे सप्तचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]