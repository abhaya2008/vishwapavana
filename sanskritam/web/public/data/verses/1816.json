[{"id": 2037746, "chapter_id": 1816, "verse_number": "५-६१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037747, "chapter_id": 1816, "verse_number": "५-६१-१", "content_sanskrit": "पितुरेतद्वचः श्रुत्वा धार्तराष्ट्रोऽत्यमर्षणः।\nआधाय विपुलं क्रोधं पुनरेवेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037748, "chapter_id": 1816, "verse_number": "५-६१-२", "content_sanskrit": "अशक्या देवसचिवाः पार्थाः स्युरिति यद्भवान्।\nमन्यते तद्भयं व्येतु भवतो राजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037749, "chapter_id": 1816, "verse_number": "५-६१-३", "content_sanskrit": "अकामद्वेषसंयोगाल्लोभद्रोहाच्च भारत ।\nउपेक्षया च भावानां देवा देवत्वमाप्नुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037750, "chapter_id": 1816, "verse_number": "५-६१-४", "content_sanskrit": "इति द्वैपायेनो व्यासो नारदश्च महातपाः ।\nजामदग्न्यश्च रामो नः कथामकथयत्पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037751, "chapter_id": 1816, "verse_number": "५-६१-५", "content_sanskrit": "नैव मानुषवद्देवाः प्रवर्तन्ते कदाचन ।\nकामात्क्रोधात्तथा लोभाद्द्वेषाच्च भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037752, "chapter_id": 1816, "verse_number": "५-६१-६", "content_sanskrit": "यदा ह्यग्निश्च वायुश्च धर्म इन्द्रोऽश्विनावपि।\nकामयोगात्प्रवर्तेरन्न पार्था दुःखमाप्नुयुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037753, "chapter_id": 1816, "verse_number": "५-६१-७", "content_sanskrit": "तस्मान्न भवता चिन्ता कार्यैषा स्यात्कथंचन ।\nदैवेष्वपेक्षका ह्येते शश्वद्भावेषु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037754, "chapter_id": 1816, "verse_number": "५-६१-८", "content_sanskrit": "अथ चेत्कामसंयोगाद्द्वेषो लोभश्च लक्ष्यते।\nदेवेषु दैवप्रामाण्यान्नैषां तद्विक्रमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037755, "chapter_id": 1816, "verse_number": "५-६१-९", "content_sanskrit": "मयाऽभिमन्त्रतः शश्वञ्जातवेदाः प्रशाम्यति।\nदिधक्षुः सकलाँल्लोकान्परिक्षिप्य समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037756, "chapter_id": 1816, "verse_number": "५-६१-१०", "content_sanskrit": "यद्वा परमकं तेजो येन युक्ता दिवौकसः।\nममाप्यनुपमं भूयो देवेभ्यो विद्धि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037757, "chapter_id": 1816, "verse_number": "५-६१-११", "content_sanskrit": "विदीर्यमाणां वसुधां गिरीणां शिखराणि च।\nलोकस्य पश्यतो राजन्स्थापयाम्यभिमन्त्रणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037758, "chapter_id": 1816, "verse_number": "५-६१-१२", "content_sanskrit": "चेतनाचेतनस्यास्य जङ्गमस्थावरस्य च।\nविनाशाय समुत्पन्नमहं घोरं महास्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037759, "chapter_id": 1816, "verse_number": "५-६१-१३", "content_sanskrit": "अश्मवर्षं च वायुं च शमयामीह नित्यशः ।\nजगतः पश्यतोऽभीक्ष्णं भूतानामनुकम्पया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037760, "chapter_id": 1816, "verse_number": "५-६१-१४", "content_sanskrit": "स्तम्भितास्वप्सु गच्छन्ति मया रथपदातयः।\nदेवासुराणां भावानामहमेकः प्रवर्तिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037761, "chapter_id": 1816, "verse_number": "५-६१-१५", "content_sanskrit": "अक्षौहिणीभिर्यान्देशान्यामि कार्येण केनचित् ।\nतत्रापो मे प्रवर्तन्ते यत्र यत्राभिकामये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037762, "chapter_id": 1816, "verse_number": "५-६१-१६", "content_sanskrit": "भयानकानि विषये व्यालादीनि न सन्ति मे ।\nमन्त्रगुप्तानि भूतानि न हिंसन्ति यंकराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037763, "chapter_id": 1816, "verse_number": "५-६१-१७", "content_sanskrit": "निकामवर्षी पर्जन्यो राजन्विषयवासिनाम्।\nधर्मिष्ठाश्च प्रजाः सर्वा ईतयश्च न सन्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2037764, "chapter_id": 1816, "verse_number": "५-६१-१८", "content_sanskrit": "अश्विनावथ वाय्वग्नी मरुद्भिः सह वृत्रहा।\nधर्मश्चैव मया द्विष्टान्नोत्सहन्तेऽभिरक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2037765, "chapter_id": 1816, "verse_number": "५-६१-१९", "content_sanskrit": "यदि ह्येते समर्थाः स्युर्मद्द्विषस्त्रातुमञ्जसा।\nन स्म त्रयोदश समाः पार्था दुःखभवाप्नुयुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2037766, "chapter_id": 1816, "verse_number": "५-६१-२०", "content_sanskrit": "नैव देवा न गन्धर्वा नासुरा न च राक्षसाः।\nशक्तास्त्रातुं मया द्विष्टं सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2037767, "chapter_id": 1816, "verse_number": "५-६१-२१", "content_sanskrit": "दयभिध्याम्यहं शश्वच्छुभं वा यदि वाऽशुभम् ।\nनैतद्विपन्नपूर्वं मे मित्रेष्वरिषु चोभयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2037768, "chapter_id": 1816, "verse_number": "५-६१-२२", "content_sanskrit": "भविष्यतीदमिति वा यद्ब्रवीमि परन्तप ।\nनान्यथा भूतपूर्वं च सत्यवागिति मां विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2037769, "chapter_id": 1816, "verse_number": "५-६१-२३", "content_sanskrit": "लोकसाक्षिकमेतन्मे माहात्म्यं दिक्षु विश्रुतम् ।\nआश्वासनार्थं भवतः प्रोक्तं न श्लाघया नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2037770, "chapter_id": 1816, "verse_number": "५-६१-२४", "content_sanskrit": "न ह्यहं श्लाघनो राजन्भूतपूर्वः कदाचन ।\nअसदाचरितं ह्येतद्यदात्मानं प्रशंसति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2037771, "chapter_id": 1816, "verse_number": "५-६१-२५", "content_sanskrit": "पाण्डवांश्चैव मत्स्यांश्च पाञ्चालान्केकयैः सह ।\nसात्यकिं वासुदेवं च श्रोतासि विजितान्मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2037772, "chapter_id": 1816, "verse_number": "५-६१-२६", "content_sanskrit": "सरितः सागरं प्राप्य यथा नश्यन्ति सर्वशः ।\nतथैव ते विनङ्क्ष्यन्ति मामासाद्य सहान्वयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2037773, "chapter_id": 1816, "verse_number": "५-६१-२७", "content_sanskrit": "परा बुद्धिः परं तेजो वीर्यं च परमं मम।\nपरा विद्या परो योगो मम तेभ्यो विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2037774, "chapter_id": 1816, "verse_number": "५-६१-२८", "content_sanskrit": "पितामहश्च द्रोणश्च कृपः शल्यः शलस्तथा।\nअस्त्रेषु यत्प्रजानन्ति सर्वं तन्मयि विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2037775, "chapter_id": 1816, "verse_number": "५-६१-२९", "content_sanskrit": "इत्युक्ते सञ्जयं भूयः पर्यपृच्छत भारत ।\nज्ञात्वा युयुत्सोः कार्याणि प्राप्तकालमरिन्दमः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2037776, "chapter_id": 1816, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि एकषष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]