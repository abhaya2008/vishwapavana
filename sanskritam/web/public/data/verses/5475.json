[{"id": 2209393, "chapter_id": 5475, "verse_number": "", "content_sanskrit": "कृष्णेन सशपथं संस्पर्शनेन परीक्षितः समुज्जीवनम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209394, "chapter_id": 5475, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209395, "chapter_id": 5475, "verse_number": "१", "content_sanskrit": "एवं विलप्य करुणं सोन्मादेव तपस्विनी ।\nउत्तरा न्यपतद् भूमौ कृपणा पुत्रगर्द्धिनी ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209396, "chapter_id": 5475, "verse_number": "२", "content_sanskrit": "तां तु दृष्ट्वा निपततां हतबन्धुपरिच्छदाम् ।\nचुक्रोश कुन्ती दुःखार्ता सर्वाश्च भरतस्त्रियः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209397, "chapter_id": 5475, "verse_number": "३", "content_sanskrit": "मुहूर्तमिव तद् राजन् पाण्डवानां निवेशनम् ।\nअप्रेक्षणीयमभवद् आर्तस्वरविनादितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209398, "chapter_id": 5475, "verse_number": "४", "content_sanskrit": "सा मुहूर्तं च राजेन्द्र पुत्रशोकाभिपीडिता ।\nकश्मलाभिहता वीर वैराटी त्वभवत् तदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209399, "chapter_id": 5475, "verse_number": "५", "content_sanskrit": "प्रतिलभ्य तु सा सञ्ज्ञामुत्तरा भरतर्षभ ।\nअङ्कमारोप्य तं पुत्रमिदं वचनमब्रवीत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209400, "chapter_id": 5475, "verse_number": "", "content_sanskrit": "उत्तरा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209401, "chapter_id": 5475, "verse_number": "६", "content_sanskrit": "धर्मज्ञस्य सुतः संस्त्वं न धर्ममवबुध्यसे ।\nयस्त्वं वृष्णिप्रवीरस्य कुरुषे नाभिवादनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209402, "chapter_id": 5475, "verse_number": "७", "content_sanskrit": "पुत्र गत्वा मम वचो ब्रूयास्त्वं पितरं तव ।\nदुर्मरं प्राणिनां वीर कालेऽप्राप्ते कथञ्चन ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209403, "chapter_id": 5475, "verse_number": "८", "content_sanskrit": "याऽहं त्वया विहीनाऽद्य हीना पुत्रेण चैव ह ।\nमरणं नाधिगच्छामि तव स्वस्ति न किञ्चन ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209404, "chapter_id": 5475, "verse_number": "९", "content_sanskrit": "अथवा धर्मराज्ञाऽहमनुज्ञाता महाभुज ।\nखादयिष्ये विषं तीक्ष्णं प्रवेक्ष्याम्यथवाऽनलम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209405, "chapter_id": 5475, "verse_number": "१०", "content_sanskrit": "अथवा दुर्मरं तात यदिदं मे सहस्रधा ।\nपतिपुत्रविहीनाया हृदयं नावदीर्यते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209406, "chapter_id": 5475, "verse_number": "११", "content_sanskrit": "उत्तिष्ठ पुत्र पश्येमां दुःखितां प्रपितामहीम् ।\nआर्तामुपप्लुतां दीनां निमग्नां शोकसागरे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209407, "chapter_id": 5475, "verse_number": "१२", "content_sanskrit": "आर्यां च पश्य पाञ्चालीं सात्वतीं च तपस्विनीम् ।\nमां च पश्य सुदुःखार्तां व्याधविद्धां मृगीमिव ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209408, "chapter_id": 5475, "verse_number": "१३", "content_sanskrit": "उत्तिष्ठ पश्य वदनं लोकनाथस्य पश्यतः ।\nपुण्डरीकविशालाक्षं पुरेव चपलेक्षणम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209409, "chapter_id": 5475, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209410, "chapter_id": 5475, "verse_number": "१४", "content_sanskrit": "एवं विलपतीं तां तु दृष्ट्वा निपतितां पुनः ।\nउत्तरां तां स्त्रियः सर्वाः पुनरुत्थापयन्त्युत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209411, "chapter_id": 5475, "verse_number": "१५", "content_sanskrit": "उत्थाय च पुनर्धैर्यात् तदा मत्स्यपतेः सुता ।\nप्राञ्चलिः पुण्डरीकाक्षं भूमावेवाभ्यवन्दत ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209412, "chapter_id": 5475, "verse_number": "१६", "content_sanskrit": "श्रुत्वा तस्यापि विपुलं विलापं पुरुषर्षभः ।\nउपस्पृश्य ततः कृष्णो ब्रह्मास्त्रं सञ्जहार तत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209413, "chapter_id": 5475, "verse_number": "१७", "content_sanskrit": "प्रतिजज्ञे स दाशार्हस्तस्य जीवितमच्युतः ।\nअब्रवीच्च विशुद्धात्मा सर्वं विश्रावयन् जगत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209414, "chapter_id": 5475, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209415, "chapter_id": 5475, "verse_number": "१८", "content_sanskrit": "न ब्रवीम्युत्तरे मिथ्या सत्यमेतद् भविष्यति ।\nएष सञ्जीवयाम्येनं पश्यतां सर्वदेहिनाम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209416, "chapter_id": 5475, "verse_number": "१९", "content_sanskrit": "नोक्तपूर्वं मया मिथ्या स्वैरेष्वपि कदाचन ।\nन च युद्धात् परावृत्तस्तथा सञ्जीवयाम्यहम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209417, "chapter_id": 5475, "verse_number": "२०", "content_sanskrit": "यथा मे दयितो धर्मो ब्राह्मणाश्च विशेषतः ।\nअभिमन्योः सुतो जातो मृतो जीवत्वयं तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209418, "chapter_id": 5475, "verse_number": "२१", "content_sanskrit": "यथाऽहं नाभिजानामि विजये न कदाचन ।\nविरोधं तेन सत्येन मृतो जीवत्वयं शिशुः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209419, "chapter_id": 5475, "verse_number": "२२", "content_sanskrit": "तथा सत्यं च धर्मश्च मया नित्यं प्रतिष्ठितौ ।\nतथा मृतः शिशुरयं जीवत्वद्याभिमन्युजः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209420, "chapter_id": 5475, "verse_number": "२३", "content_sanskrit": "यथा कंसश्च केशी च धर्मेण निहतौ मया ।\nतेन सत्येन बालयोऽयं पुनरुज्जीवयामि ह ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209421, "chapter_id": 5475, "verse_number": "२४", "content_sanskrit": "यदि मे ब्रह्मचर्यं स्यात् य त्वं च मयि तिष्ठति ।\nअव्याहतं ममैश्वर्यं तेन जीवतु बालकः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209422, "chapter_id": 5475, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2209423, "chapter_id": 5475, "verse_number": "२५", "content_sanskrit": "इत्युक्त्वा वासुदेवोऽथ तं बालं भरतर्षभ ।\nहस्तेन कमलाभेन ब्रह्मरुद्रार्चितेन च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2209424, "chapter_id": 5475, "verse_number": "२६", "content_sanskrit": "पस्पर्श पुण्डरीकाक्ष आपादतलमस्तकम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2209425, "chapter_id": 5475, "verse_number": "२७", "content_sanskrit": "स्पृष्टमात्रस्तु कृष्णेन स बाल अभिमन्युजः ।\nशनैः शनैर्महाराज प्रापद्यत स चेतनाम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2209426, "chapter_id": 5475, "verse_number": "२८", "content_sanskrit": "शनैः शनैर्महाराज प्रास्पन्दत सचेतनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2209427, "chapter_id": 5475, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि मृतपरीक्षित् सञ्जीवनप्रकारकथनं नाम एकोनसप्ततितमोऽध्यायः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]