[{"id": 40001679, "chapter_id": 8840, "verse_number": "1", "content_sanskrit": "ततस्त्रिशङ्कोर्वचनं श्रुत्वा क्रोधसमन्वितम् । ऋषिपुत्रशतं राम राजानमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40001680, "chapter_id": 8840, "verse_number": "2", "content_sanskrit": "प्रत्याख्यातो हि दुर्बुद्धे गुरुणा सत्यवादिना। तं कथं समतिक्रम्य शाखान्तरमुपेयिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40001681, "chapter_id": 8840, "verse_number": "3", "content_sanskrit": "इक्ष्वाकूणां हि सर्वेषां पुरोधा: परमो गुरु:। न चातिक्रमितुं शक्यं वचनं सत्यवादिन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40001682, "chapter_id": 8840, "verse_number": "4", "content_sanskrit": "अशक्यमिति चोवाच वसिष्ठो भगवानृषि:। तं वयं वै समाहर्तुं क्रतुं शक्ता:कथं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40001683, "chapter_id": 8840, "verse_number": "5", "content_sanskrit": "बालिशस्त्वं नरश्रेष्ठ गम्यतां स्वपुरं पुन:। याजने भगवाञ्छक्तस्त्रैलोक्यस्यापि पार्थिव ॥ अवमानं च तत्कर्तुं तस्य शक्ष्यामहे कथम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40001684, "chapter_id": 8840, "verse_number": "6", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा क्रोधपर्याकुलाक्षरम् ॥ स राजा पुनरेवैतानिदं वचनमब्रवीत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40001685, "chapter_id": 8840, "verse_number": "7", "content_sanskrit": "प्रत्याख्यातोऽस्मि गुरुणा गुरुपुत्रैस्तथैव च ॥ अन्यां गतिं गमिष्यामि स्वस्ति वोऽस्तु तपोधना:।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40001686, "chapter_id": 8840, "verse_number": "8", "content_sanskrit": "ऋषिपुत्रास्तु तच्छ्रुत्वा वाक्यं घोराभिसंहितम् ॥ शेपु: परमसङ्कृद्धाश्चण्डालत्वं गमिष्यसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40001687, "chapter_id": 8840, "verse_number": "9", "content_sanskrit": "एवमुक्त्वा महात्मनो विविशुस्ते स्वमाश्रमम् ॥ अथ रात्र्यां व्यतीतायां राजा चण्डालतां गत:।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40001688, "chapter_id": 8840, "verse_number": "10", "content_sanskrit": "नीलवस्त्रधरो नील: पुरुषो ध्वस्तमूर्धज: ॥ चित्यमाल्यानुलेपश्च आयसाभरणोऽभवत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40001689, "chapter_id": 8840, "verse_number": "11", "content_sanskrit": "तं दृष्टवा मन्त्रिणस्सर्वे त्यज्य चण्डालरूपिणम् ॥ प्राद्रवन् सहिता राम पौरा येऽस्यानुगामिन:।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40001690, "chapter_id": 8840, "verse_number": "12", "content_sanskrit": "एको हि राजा काकुत्स्थ जगाम परमात्मवान् ॥ दह्यमानो दिवारात्रं विश्वामित्रं तपोनिधिम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40001691, "chapter_id": 8840, "verse_number": "13", "content_sanskrit": "विश्वामित्रस्तु तं दृष्ट्वा राजानं विफलीकृतम्। चण्डालरूपिणं राम मुनि: कारुण्यमागत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40001692, "chapter_id": 8840, "verse_number": "14", "content_sanskrit": "कारुण्यात्स महातेजा वाक्यं परमधार्मिक:। इदं जगाद भद्रं ते राजानं घोररूपिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40001693, "chapter_id": 8840, "verse_number": "15", "content_sanskrit": "किमागमनकार्यं ते राजपुत्र महाबल। अयोध्याधिपते वीर शापाच्चण्डालतां गत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40001694, "chapter_id": 8840, "verse_number": "16", "content_sanskrit": "अथ तद्वाक्यमाज्ञाय राजा चण्डालतां गत:। अब्रवीत्प्राञ्जलिर्वाक्यं वाक्यज्ञो वाक्यकोविदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40001695, "chapter_id": 8840, "verse_number": "17", "content_sanskrit": "प्रत्याख्यातोऽस्मि गुरुणा गुरुपुत्रैस्तथैव च। अनवाप्यैव तं कामं मया प्राप्तो विपर्यय: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40001696, "chapter_id": 8840, "verse_number": "18", "content_sanskrit": "सशरीरो दिवं यायामिति मे सौम्यदर्शनम्। मया चेष्टं क्रतुशतं तच्च नाऽवाप्यते फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40001697, "chapter_id": 8840, "verse_number": "19", "content_sanskrit": "अनृतं नोक्तपूर्वं मे न च वक्ष्ये कदाचन। कृच्छ्रेष्वपि गत स्सौम्य क्षत्रधर्मेण ते शपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40001698, "chapter_id": 8840, "verse_number": "20", "content_sanskrit": "यज्ञैर्बहुविधैरिष्टं प्रजा धर्मेण पालिता: ॥ गुरवश्च महात्मान श्शीलवृत्तेन तोषिता:।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40001699, "chapter_id": 8840, "verse_number": "21", "content_sanskrit": "धर्मे प्रयतमानस्य यज्ञं चाहर्तुमिच्छत: ॥ परितोषं न गच्छन्ति गुरवो मुनिपुङ्गव ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40001700, "chapter_id": 8840, "verse_number": "22", "content_sanskrit": "दैवमेव परं मन्ये पौरुषं तु निरर्थकम् ॥ दैवेनाक्रम्यते सर्वं दैवं हि परमा गति:।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40001701, "chapter_id": 8840, "verse_number": "23", "content_sanskrit": "तस्य मे परमार्तस्य प्रसादमभिकाङ्क्षत: ॥ कर्तुमर्हसि भद्रं ते दैवोपहतकर्मण:।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40001702, "chapter_id": 8840, "verse_number": "24", "content_sanskrit": "नान्यां गतिं गमिष्यामि नान्यश्शरणमस्ति मे ॥ दैवं पुरुषकारेण निवर्तयितुमर्हसि।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]