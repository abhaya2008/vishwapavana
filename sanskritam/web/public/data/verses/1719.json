[{"id": 2033393, "chapter_id": 1719, "verse_number": "४-४२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033394, "chapter_id": 1719, "verse_number": "४-४२-१", "content_sanskrit": "अत्तरेणैवमुक्तस्तु पार्थो वैराटिमब्रवीत्।\nमृद्व्या प्रत्याययन्वाचा भीतं शङ्कावशं गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033395, "chapter_id": 1719, "verse_number": "४-४२-२x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033396, "chapter_id": 1719, "verse_number": "४-४२-२", "content_sanskrit": "अत्त्वया प्रथमं पृष्टं शत्रुसेनाङ्गमर्दनम्।\nपार्थस्येदं धनुर्दिव्यं गाण्डीवमिति विश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033397, "chapter_id": 1719, "verse_number": "४-४२-३", "content_sanskrit": "अभेद्यमभयं श्रीमद्दिव्यमच्छेद्यमव्रणम्।\nसर्वायुधमहामात्रं शातकुम्भमयं धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033398, "chapter_id": 1719, "verse_number": "४-४२-४", "content_sanskrit": "एतच्छतसहस्रेण संमितं राष्ट्रवर्धनम् ।\nदेवदानवगन्धर्वैः पूजितं शाश्वतीः समाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033399, "chapter_id": 1719, "verse_number": "४-४२-५", "content_sanskrit": "येन देवासुरान्पार्थः सर्वान्विषहते रणे।\nएतद्वर्षसहस्रं तु ब्रह्मा पूर्वमधारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033400, "chapter_id": 1719, "verse_number": "४-४२-६", "content_sanskrit": "उमापतिश्चतुःषष्टिं शक्रोऽशीतिं च पञ्च च ।\nसोमः पञ्चसहस्राणि तथा च वरुणः शतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033401, "chapter_id": 1719, "verse_number": "४-४२-७", "content_sanskrit": "तस्माच्च वरुणादग्निः प्रेम्णा प्राहृत्य तच्छुभम्।\nअग्निना प्रातिभाव्येन दत्तं पार्थाय गाण्डिवम् ।\nपञ्चषष्टिं च वर्षाणि कौन्तेयो धारयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033402, "chapter_id": 1719, "verse_number": "४-४२-८", "content_sanskrit": "एवंवीर्यं महावेतेतच्च धनुरुत्तमम् ।\nनीलोत्पलसमं राज्ञः कौरव्यस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033403, "chapter_id": 1719, "verse_number": "४-४२-९", "content_sanskrit": "बिन्दवश्चात्र सौवर्णाः पृष्ठे साधुनियोजिताः ।\nविश्रुतं भीमसेनस्य जातरूपग्रहं दृढम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033404, "chapter_id": 1719, "verse_number": "४-४२-१०", "content_sanskrit": "सहस्रगोधाः सौवर्णा द्वीपिनश्च चतुर्दश ।\nऋषभा यत्र सौवर्णाः पृष्ठे तिष्ठन्ति शृङ्गिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033405, "chapter_id": 1719, "verse_number": "४-४२-११", "content_sanskrit": "येन भीमोऽजयत्कृत्स्नां दिशं प्राचीं परंतपः।\nपृष्ठे विभक्ताः शोभन्ते कुशाग्निप्रतिदीपिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033406, "chapter_id": 1719, "verse_number": "४-४२-१२", "content_sanskrit": "पूजितं सुरमर्त्येषु प्रथितं धनुरुत्तमम्।\nतालप्रमाणं भीमस्य रत्नरुक्मविभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033407, "chapter_id": 1719, "verse_number": "४-४२-१३", "content_sanskrit": "दुरानमं महद्दीर्घं सुरूपं दुष्प्रधर्षणम् ।\nबर्हिणश्चात्र सौवर्णाः शतचन्द्रकभूषणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033408, "chapter_id": 1719, "verse_number": "४-४२-१४", "content_sanskrit": "नकुलस्य धनुस्त्वेतन्माद्रीपुत्रस्य धीमतः।\nएतेन सदृशं चित्रं धनुरेतद्यवीयसः।\nहारिद्रवर्णं राज्ञस्तु कौरव्यस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033409, "chapter_id": 1719, "verse_number": "४-४२-१५", "content_sanskrit": "विपाठा भीमसेनस्य गिरीणामपि दारणाः ।\nसुप्रभाः सुमहाकायास्तीक्ष्णाग्राः सुतरां दृढाः ।\nभीमेन प्रहिता ह्येते वारणानां निवारणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033410, "chapter_id": 1719, "verse_number": "४-४२-१६", "content_sanskrit": "सुवर्णदण्डरुचिराः कालदण्डोपमाः शुभाः ।\nनकुलस्य शरा ह्येते वज्राशनिसमप्रभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033411, "chapter_id": 1719, "verse_number": "४-४२-१७", "content_sanskrit": "यांश्च त्वं पृच्छसे दीप्तान्समधारान्समाहितान्।\nवराहकर्णास्तीक्ष्णाग्राः सहदेवस्य ते शराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033412, "chapter_id": 1719, "verse_number": "४-४२-१८", "content_sanskrit": "यस्त्वयं सायको दीर्घो गव्ये कोशे च दंशितः।\nपार्थस्यायं महाघोरः सर्वभारसहो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033413, "chapter_id": 1719, "verse_number": "४-४२-१९", "content_sanskrit": "यस्त्वयं निर्मलः खङ्गो द्वीपिचर्मणि दंशितः।\nराज्ञो युधिष्ठिरस्यायं कुन्तीपुत्रस्य धीमतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033414, "chapter_id": 1719, "verse_number": "४-४२-२०", "content_sanskrit": "वैयाघकोशो भीमस्य पञ्चशार्दूललक्षणः ।\nवारणानां सुदृप्तानां शिक्षितः स्कन्धशातने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033415, "chapter_id": 1719, "verse_number": "४-४२-२१", "content_sanskrit": "नीलोत्पलसवर्णाभः खङ्गः पार्थस्य धीमतः।\nमृगेन्द्रचर्मपिहितस्तीक्ष्णधारः सुनिर्मलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033416, "chapter_id": 1719, "verse_number": "४-४२-२२", "content_sanskrit": "दर्शनीयः सुतीक्ष्णाग्रः कुन्तीपुत्रस्य धीमतः ।\nअर्जुनस्यैष निस्त्रिंशः परसैन्याग्रदूषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033417, "chapter_id": 1719, "verse_number": "४-४२-२३", "content_sanskrit": "यस्त्वयं पार्षते कोशे निक्षिप्तो रुचिरत्सरुः ॥\nनकुलस्यैष निस्त्रिंशो वैश्वानरसमप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2033418, "chapter_id": 1719, "verse_number": "४-४२-२४", "content_sanskrit": "यस्त्वयं पिङ्गलः खङ्गश्चित्रो मणिमयत्सरुः।\nसहदेवस्य खङ्गोऽयं भारसाहोऽतिदंशितःक ।\nभीमस्यायं महादण्डः सर्वामित्रविनाशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2033419, "chapter_id": 1719, "verse_number": "४-४२-२४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2033420, "chapter_id": 1719, "verse_number": "४-४२-२५", "content_sanskrit": "भेदतो ह्यर्जुनस्तूर्णं कथयामास तत्त्वतः ।\nआयुधानि कलापांश्च निस्त्रिंशांश्चातुलप्रभान् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2033421, "chapter_id": 1719, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि द्विचत्वारिंशोऽध्यायः ॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]