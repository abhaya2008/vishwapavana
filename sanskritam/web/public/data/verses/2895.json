[{"id": 2088678, "chapter_id": 2895, "verse_number": "१३-२५-१", "content_sanskrit": "`भीष्म उवाच।\nतथेत्युक्त्वा तु विहगः प्रतिज्ञाय महाद्युतिः।\nअमृताहरणे वाचं ततः पितरमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088679, "chapter_id": 2895, "verse_number": "१३-२५-२", "content_sanskrit": "कामं वै सूनृता वाचो विसृज्य च मुहुर्मुहुः।\nयच्चाप्यनुज्ञां मातुर्वै न च सा ह्यनुमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088680, "chapter_id": 2895, "verse_number": "१३-२५-३", "content_sanskrit": "सा मा बहुविधा वाचो वज्रकल्पा विसृज्य वै।\nभगवन्विनता दासी मम माता महाद्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088681, "chapter_id": 2895, "verse_number": "१३-२५-४", "content_sanskrit": "कद्रूः प्रेषयते चैव दासीयमिति चाब्रवीत्।\nआहरामृतमित्येव मोक्ष्यते विनता ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088682, "chapter_id": 2895, "verse_number": "१३-२५-५", "content_sanskrit": "सोहं मातृविमोक्षार्थमाहरिष्य इति ब्रुवन्।\nअमृतं प्रार्थितस्तूर्णमाहर्तुं प्रतिनन्द्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088683, "chapter_id": 2895, "verse_number": "१३-२५-६x", "content_sanskrit": "पितोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088684, "chapter_id": 2895, "verse_number": "१३-२५-६", "content_sanskrit": "अमृतं तात दुष्प्रापं देवैरपि कुतस्त्वया।\nरक्ष्यते हि भृशं पुत्र रक्षिभिस्तन्निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088685, "chapter_id": 2895, "verse_number": "१३-२५-७", "content_sanskrit": "गुप्तमद्भिर्भृशं साधु सर्वतः परिवारितम्।\nअनन्तरमथो गुप्तं ज्वलता जातवेदसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088686, "chapter_id": 2895, "verse_number": "१३-२५-८", "content_sanskrit": "ततः शतसहस्राणि अयुतान्यर्बुदानि च।\nरक्षन्त्यमृतमत्यन्तं किङ्करा नाम राक्षसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088687, "chapter_id": 2895, "verse_number": "१३-२५-९", "content_sanskrit": "तेषां शक्त्यृष्टिशूलांश्च शतघ्न्यः पट्टसास्तथा।\nआयुधा रक्षिणां तात वज्रकल्पाः शिलास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088688, "chapter_id": 2895, "verse_number": "१३-२५-१०", "content_sanskrit": "ततो जालेन महता अवनद्धं समन्ततः।\nअयस्मयेन वै तात वृत्रहन्तुः स्म शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088689, "chapter_id": 2895, "verse_number": "१३-२५-११", "content_sanskrit": "तत्त्वमेवंविधं तात कथं प्रार्थयसेऽमृतम्।\nसुरक्षितं वज्रभृतां वैनतेय विहङ्गम।\nइन्द्रेण देवैर्नागैश्च खड्गैर्गिरिजलादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088690, "chapter_id": 2895, "verse_number": "१३-२५-१३x", "content_sanskrit": "गरुड उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088691, "chapter_id": 2895, "verse_number": "१३-२५-१२", "content_sanskrit": "पुत्रगृद्ध्या ब्रवीष्येतच्छृणु तात विनिश्चयम्।\nबलवानुपायवानस्मि भूयः किं करवाणि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088692, "chapter_id": 2895, "verse_number": "१३-२५-१३", "content_sanskrit": "तमब्रवीत्पिता हृष्टः प्रहसन्वै पुनः पुनः।\nयदि तौ भक्षयेस्तात क्रूरौ कच्छपवारणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088693, "chapter_id": 2895, "verse_number": "१३-२५-१४", "content_sanskrit": "तथा बलममेयं ते भविता तन्न संशयः।\nअमृतस्यैव चाहर्ता भविष्यसि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088694, "chapter_id": 2895, "verse_number": "१३-२५-१५x", "content_sanskrit": "गरुड उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088695, "chapter_id": 2895, "verse_number": "१३-२५-१५", "content_sanskrit": "क्व तौ क्रूरौ महाभाग वर्तेते हस्तिकच्छपौ।\nभक्षयिष्याम्यहं तात बलस्याप्यायनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088696, "chapter_id": 2895, "verse_number": "१३-२५-१६x", "content_sanskrit": "कश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088697, "chapter_id": 2895, "verse_number": "१३-२५-१६", "content_sanskrit": "पर्वतो वै समुद्रान्ते नभः स्तब्ध्वेव तिष्ठति।\nउरगो नाम दुष्प्रापः पुरा देवगणैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088698, "chapter_id": 2895, "verse_number": "१३-२५-१७", "content_sanskrit": "गोरुतानि स विस्तीर्णः पुष्पितद्रुमसानुमान्।\nतत्र पन्थाः कृतस्तात कुञ्जरेण बलीयसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088699, "chapter_id": 2895, "verse_number": "१३-२५-१८", "content_sanskrit": "गोरुतान्युच्छ्रयस्तस्य नव सप्त च पुत्रक।\nगच्छताऽगच्छता चैव क्षपितः स महागिरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088700, "chapter_id": 2895, "verse_number": "१३-२५-१९", "content_sanskrit": "तावान्भूमिसमस्तात कृतः पन्थाः समुत्थितः।\nतेन गत्वा स मातङ्गः पिपासुर्युद्धमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2088701, "chapter_id": 2895, "verse_number": "१३-२५-२०", "content_sanskrit": "तमतीत्य तु शैलेन्द्रं ह्रदः कोकनदायुतः।\nकनकेति च विख्यातस्तत्र कूर्मो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2088702, "chapter_id": 2895, "verse_number": "१३-२५-२१", "content_sanskrit": "गोरुतानि स विस्तीर्णः कच्छपः कुञ्जरश्च सः।\nआयामतश्चापि समौ तेजोबलसमन्वितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2088703, "chapter_id": 2895, "verse_number": "१३-२५-२२", "content_sanskrit": "पुनरावृत्तिमापन्नौ तावेतौ मधुकैटभौ।\nजन्मान्तरे विप्रमूढौ परस्परवधैषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2088704, "chapter_id": 2895, "verse_number": "१३-२५-२३", "content_sanskrit": "यदा स नागो व्रजति पिपासुस्तं जलाशयम्।\nतदैनं कच्छपो रोषात्प्रतियाति महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2088705, "chapter_id": 2895, "verse_number": "१३-२५-२४", "content_sanskrit": "नखैश्च दशनैश्चापि निमज्योन्मज्य वाऽसकृत्।\nविददाराग्रहस्तेन कुञ्जरं तं जलेचरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2088706, "chapter_id": 2895, "verse_number": "१३-२५-२५", "content_sanskrit": "नागराडपि तोयार्थी पिपासुश्चरणैरपि।\nअग्रहस्तेन दन्ताभ्यां निवारयति वारिजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2088707, "chapter_id": 2895, "verse_number": "१३-२५-२६", "content_sanskrit": "स तु तोयादनुत्तिष्ठन्वारिजो गजयूथपम्।\nनखैश्च दशनैश्चैव द्विरदं प्रतिषेधति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2088708, "chapter_id": 2895, "verse_number": "१३-२५-२७", "content_sanskrit": "निवारितो गजश्रेष्ठः पुनर्गच्छति स्वं वनम्।\nपिपासुः क्लिन्नहस्ताग्रो रुधिरेण समुक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2088709, "chapter_id": 2895, "verse_number": "१३-२५-२८", "content_sanskrit": "तौ गच्छ सहितौ पुत्र यदि शक्नोषि भक्षय।\nन तौ पृथक्तया शक्यावप्रमत्तौ बले स्थितौ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2088710, "chapter_id": 2895, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चविंशोऽध्यायः॥ २५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]