[{"id": 6000019000, "chapter_id": 10019, "verse_number": null, "content_sanskrit": "अथ एकोनविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000019001, "chapter_id": 10019, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.001.m4a", "display_order": 2}, {"id": 6000019002, "chapter_id": 10019, "verse_number": "१-१९-१", "content_sanskrit": "महीपतिस्त्वथ तत्कर्म गर्ह्यं विचिन्तयन्नात्मकृतं सुदुर्मनाः।\nअहो मया नीचमनार्यवत्कृतं निरागसि ब्रह्मणि गूढतेजसि॥ १/१९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.002.m4a", "display_order": 3, "topics": [{"text": "स्वनगरीं प्राप्‍तवतः परीक्षितः स्वकृतं ब्राह्मणापमानं स्मृत्वा पश्‍चात्तापः", "range": "१–३"}]}, {"id": 6000019003, "chapter_id": 10019, "verse_number": "१-१९-२", "content_sanskrit": "ध्रुवं ततो मे कृतदेवहेलनाद् दुरत्ययं व्यसनं नातिदीर्घात्।\nतदस्तु काममघनिष्कृताय मे यथा न कुर्यां पुनरेवमद्धा॥ १/१९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.003.m4a", "display_order": 4}, {"id": 6000019004, "chapter_id": 10019, "verse_number": "१-१९-३", "content_sanskrit": "अद्यैव राज्यं बलमृद्धकोशं प्रकोपितब्रह्मकुलानलो मे।\nदहत्वभद्रस्य पुनर्न मेऽभूत् पापीयसी धीर्द्विजदेवतासु॥ १/१९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.004.m4a", "display_order": 5}, {"id": 6000019005, "chapter_id": 10019, "verse_number": "१-१९-४", "content_sanskrit": "स चिन्तयन्नित्थमथाशृणोद्यथा मुनेः सुतोक्‍तान्निकृतिं तक्षकाख्यात्।\nस साधु मेने न चिरेण तक्षकादलंप्रसक्‍तस्य विरक्‍तिकारणम्॥ १/१९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.005.m4a", "display_order": 6, "topics": [{"text": "ऋषिपुत्रस्य शापं ऋषेः शिष्यमुखात् ज्ञातवता परीक्षिता गङ्गातीरे प्रायोपवेशः", "range": "४–७"}]}, {"id": 6000019006, "chapter_id": 10019, "verse_number": "१-१९-५", "content_sanskrit": "अथो विहायेमममुं ‍च लोकं विमृश्य तौ हेयतया पुरस्तात्।\nकृष्णाङ्घ्रिसेवामभिमन्यमान उपाविशत्प्रायममर्त्यनद्याम्॥ १/१९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.006.m4a", "display_order": 7}, {"id": 6000019007, "chapter_id": 10019, "verse_number": "१-१९-६", "content_sanskrit": "या वै लसच्छ्रीतुलसीविमिश्रकृष्णाङ्घ्रिरेण्वभ्यधिकाम्बुनेत्री।\nपुनात्यशेषानुभयत्र लोकान् कस्तां न सेवेत मरिष्यमाणः॥ १/१९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.007.m4a", "display_order": 8}, {"id": 6000019008, "chapter_id": 10019, "verse_number": "१-१९-७", "content_sanskrit": "इति व्यवस्थाय च पाण्डवेयः प्रायोपवेशं प्रति विष्णुपद्याम्।\nदध्यौ मुकुन्दाङ्घ्रिमनन्यभावो मुनिव्रतो मुक्‍तसमस्तसङ्गः॥ १/१९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.008.m4a", "display_order": 9}, {"id": 6000019009, "chapter_id": 10019, "verse_number": "१-१९-८", "content_sanskrit": "तत्रोपजग्मुर्भुवनं पुनाना महानुभावा मुनयः सशिष्याः।\nप्रायेण तीर्थाधिगमापदेशैः स्वयं हि तीर्थानि पुनन्ति सन्तः॥ १/१९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.009.m4a", "display_order": 10, "topics": [{"text": "तत्र समागतानेकदेवर्ष्यादीनां पूजनपूर्वकं हरिकथागानप्रार्थना", "range": "८–२५"}]}, {"id": 6000019010, "chapter_id": 10019, "verse_number": "१-१९-९", "content_sanskrit": "अत्रिर्वसिष्‍ठश्‍च्यवनः शरद्वान् अरिष्‍टनेमिर्भृगुरङ्गिराश्‍च।\nपराशरो गाधिसुतोऽथ राम उचथ्य इन्द्रप्रमतीध्मवाहौ॥ १/१९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.010.m4a", "display_order": 11}, {"id": 6000019011, "chapter_id": 10019, "verse_number": "१-१९-१०", "content_sanskrit": "मेधातिथिर्देवल आर्ष्‍टिषेणो भरद्वाजो गौतमः पिप्‍पलादः।\nमैत्रेय और्वः कवयः कुम्भयोनिः द्वैपायनो भगवान्नारदश्‍च॥ १/१९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.011.m4a", "display_order": 12}, {"id": 6000019012, "chapter_id": 10019, "verse_number": "१-१९-११", "content_sanskrit": "अन्ये च देवर्षिब्रह्मर्षिवर्या राजर्षिवर्या अरुणादयश्‍च।\nनानार्षेयप्रवरान्समेतान् अभ्यर्च्य राजा शिरसा ववन्दे॥ १/१९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.012.m4a", "display_order": 13}, {"id": 6000019013, "chapter_id": 10019, "verse_number": "१-१९-१२", "content_sanskrit": "सुखोपविष्‍टेष्वथ तेषु भूयः कृतप्रणामः स्वचिकीर्षितं यत्।\nविज्ञापयामास विविक्‍तचेता उपस्थितोऽग्रेऽर्घ्यगृहीतपाणिः॥ १/१९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.013.m4a", "display_order": 14}, {"id": 6000019014, "chapter_id": 10019, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.014.m4a", "display_order": 15}, {"id": 6000019015, "chapter_id": 10019, "verse_number": "१-१९-१३", "content_sanskrit": "अहो वयं धन्यतमा नृपाणां महत्तमानुग्रहणीयशीलाः।\nराज्ञां कुलं ब्राह्मणपादशौचम्आराद्विसृष्‍टं बत गर्ह्यकर्म॥ १/१९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.015.m4a", "display_order": 16}, {"id": 6000019016, "chapter_id": 10019, "verse_number": "१-१९-१४", "content_sanskrit": "तस्यैव मेऽस्त्वद्य परावरेशे व्यासक्‍तचित्तस्य गृहेष्वभीक्ष्णम्।\nनिर्वेदमूलो द्विजशापरूपो यत्र प्रसक्‍तोऽभयमेव धत्ते॥ १/१९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.016.m4a", "display_order": 17}, {"id": 6000019017, "chapter_id": 10019, "verse_number": "१-१९-१५", "content_sanskrit": "तं मोपविष्‍टं प्रतियान्तु विप्रा गङ्गा च देवी धृतचित्तमीशे।\nद्विजोपसृष्‍टः कुहकस्तक्षको वा दशत्वलं गायत विष्णुगाथाः॥ १/१९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.017.m4a", "display_order": 18}, {"id": 6000019018, "chapter_id": 10019, "verse_number": "१-१९-१६", "content_sanskrit": "पुनश्‍च भूयाद्भगवत्यनन्ते रतिः प्रसङ्गश्‍च तदाश्रयेषु।\nमहत्सु यां याम् उपयामि सृष्‍टिं मैत्र्यस्तु सर्वत्र नमो द्विजेभ्यः॥ १/१९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.018.m4a", "display_order": 19}, {"id": 6000019019, "chapter_id": 10019, "verse_number": "१-१९-१७", "content_sanskrit": "इति स्म राजा व्यवसाययुक्‍तः प्राचीनकाग्रेषु कुशेषु धीरः।\nउदङ्मुखो दक्षिणकूल आस्ते समुद्रपत्न्यास्स्वसुते न्यस्तभारः॥ १/१९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.019.m4a", "display_order": 20}, {"id": 6000019020, "chapter_id": 10019, "verse_number": "१-१९-१८", "content_sanskrit": "विहाय सर्वं नरदेवचिह्नं केयूरहाराङ्गदमौलिरत्नान्।\nरत्नाङ्गुलीयान् विमलान् निरस्य पवित्रपाणिर्मुनिवेष आस्ते॥ १/१९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.020.m4a", "display_order": 21}, {"id": 6000019021, "chapter_id": 10019, "verse_number": "१-१९-१९", "content_sanskrit": "एवं च तस्मिन्नरदेवदेवे प्रायोपविष्‍टे दिवि देवसङ्घाः।\nप्रशस्य भूमौ व्यकिरन्प्रसूनैर्मुदा मुहुर्दुन्दुभयश्‍च नेदुः॥ १/१९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.021.m4a", "display_order": 22}, {"id": 6000019022, "chapter_id": 10019, "verse_number": "१-१९-२०", "content_sanskrit": "महर्षयो वै समुपागता ये प्रशस्य साध्वित्यनुमोदमानाः।\nऊचुः प्रजानुग्रहशीलसारा यदुत्तमश्लोकगुणानुरूपम्॥ १/१९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.022.m4a", "display_order": 23}, {"id": 6000019023, "chapter_id": 10019, "verse_number": "१-१९-२१", "content_sanskrit": "न वा इदं राजर्षिवर्य चित्रं भवत्सु कृष्णं समनुव्रतेषु।\nयेऽध्यासनं राजकिरीटजुष्‍टं सद्यो जहुर्भगवत्पार्श्‍वकामाः॥ १/१९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.023.m4a", "display_order": 24}, {"id": 6000019024, "chapter_id": 10019, "verse_number": "१-१९-२२", "content_sanskrit": "सर्वे वयं तावदिहास्महेऽथ कलेवरं यावदसौ विहाय।\nअजं परं विरजस्कं विशोकं यास्यत्ययं भागवतप्रधानः॥ १/१९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.024.m4a", "display_order": 25}, {"id": 6000019025, "chapter_id": 10019, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.025.m4a", "display_order": 26}, {"id": 6000019026, "chapter_id": 10019, "verse_number": "१-१९-२३", "content_sanskrit": "आश्रुत्य तदृषिगणवचः परीक्षित्समं मधुश्‍च्युत् गुरुशापव्यलीकम्।\nआभाषतैनानभिवन्द्य युक्‍तः शुश्रूषमाणश्‍चरितानि विष्णोः॥ १/१९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.026.m4a", "display_order": 27}, {"id": 6000019027, "chapter_id": 10019, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.027.m4a", "display_order": 28}, {"id": 6000019028, "chapter_id": 10019, "verse_number": "१-१९-२४", "content_sanskrit": "समागताः सर्वत एव सर्वे वेदा यथा मूर्तिधरास्‍त्रिपृष्‍ठे।\nनेहाथवाऽमुत्र च कश्‍चनार्थ ऋते परानुग्रहमात्मशीलाः॥ १/१९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.028.m4a", "display_order": 29}, {"id": 6000019029, "chapter_id": 10019, "verse_number": "१-१९-२५", "content_sanskrit": "ततश्‍च वः प्रश्नमिमं विपृच्छे विश्रभ्य विप्रा इतिकृत्यतायाम्।\nसर्वात्मना म्रियमाणैस्तु कृत्यं शुद्धं च तत्रामृशताभियुक्‍ताः॥ १/१९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_019/BhP_01.019.029.m4a", "display_order": 30}, {"id": 6000019030, "chapter_id": 10019, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे एकोनविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]