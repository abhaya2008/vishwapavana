[{"id": 900002184, "chapter_id": 8258, "verse_number": "3.1", "content_sanskrit": "ओमित्येतदक्षरमुद्गीथमुपासीत", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900002185, "chapter_id": 8258, "verse_number": "3.2", "content_sanskrit": "तदेतत् परमत्वं तु यथाक्रममुदीर्यते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900002186, "chapter_id": 8258, "verse_number": "3.3", "content_sanskrit": "पृथिव्याः सोमवरुणयोश्वौषध्यब्देवतात्वेन रुद्रस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900002187, "chapter_id": 8258, "verse_number": "3.4", "content_sanskrit": "तस्मादोमित्यनुज्ञानं कुर्वन्त्येते जनाः सदा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900002188, "chapter_id": 8258, "verse_number": "3.5", "content_sanskrit": "वाक्प्राणौ दम्पती चापि संसृज्येते जनार्दने ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900002189, "chapter_id": 8258, "verse_number": "3.6", "content_sanskrit": "तेनैव विष्णुनेयं च त्रयीविद्या प्रवर्तते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900002190, "chapter_id": 8258, "verse_number": "3.7", "content_sanskrit": "नाज्ञस्य मुक्तिस्य भवेत्तु सा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900002191, "chapter_id": 8258, "verse_number": "3.8", "content_sanskrit": "देवासुरा ह वै यत्र संयेतिर उभये प्राजापत्यास्तद्ध देवा उद्गीथमाजह्रुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900002192, "chapter_id": 8258, "verse_number": "3.9", "content_sanskrit": "अथाधिदैवतं य एवासौ तपति तमुद्गीथमुपासीत", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900002193, "chapter_id": 8258, "verse_number": "3.10", "content_sanskrit": "ओमित्येतदक्षरमुद्गीथमुपासीतोमिति ह्युद्गायति तस्योपव्याख्यानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900002194, "chapter_id": 8258, "verse_number": "3.11", "content_sanskrit": "अथ खलु य उद्गीथः स प्रणवो यः प्रणवः स उद्गीथ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900002195, "chapter_id": 8258, "verse_number": "3.12", "content_sanskrit": "इयमेवर्गग्निः साम तदेतदेतस्यामृच्यध्यूढं साम..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900002196, "chapter_id": 8258, "verse_number": "3.13", "content_sanskrit": "अथाध्यात्मं वागेवकः प्राणः साम तदेतदेस्यामृच्यध्यूढं साम ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900002197, "chapter_id": 8258, "verse_number": "3.14", "content_sanskrit": "त्रयो होद्गीथे कुशला बभूवुः शिलकः शालावत्यः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900002198, "chapter_id": 8258, "verse_number": "3.15", "content_sanskrit": "अस्य लोकस्य का गतिरित्याकाश इति होवाच सर्वाणि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900002199, "chapter_id": 8258, "verse_number": "3.16", "content_sanskrit": "मटचीहतेषु कुरुष्वाटक्या सह जाययोषस्तिर्ह चाक्रायण ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900002200, "chapter_id": 8258, "verse_number": "3.17", "content_sanskrit": "अथ हैनं यजमान उवाच भगवन्तं वा अहं विविदिषाणीत्युषस्तिरस्मि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900002201, "chapter_id": 8258, "verse_number": "3.18", "content_sanskrit": "अथातः शौव उद्गीथस्तद्ध बको दाल्भ्यो ग्लावो वा मैत्रेयः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900002202, "chapter_id": 8258, "verse_number": "3.19", "content_sanskrit": "अयं वाव लोको हावुकारो वायुर्हायिकारश्चन्द्रमा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]