[{"id": 2126975, "chapter_id": 3722, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2126976, "chapter_id": 3722, "verse_number": "१", "content_sanskrit": "अथ दीर्घस्य कालस्य पर्णादो नाम वै द्विजः ।\nप्रत्येत्य नगरं भैमीमिदं वचनमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2126977, "chapter_id": 3722, "verse_number": "२", "content_sanskrit": "नैषधं मृगयानेन दमयन्ति दिवानिशम् ।\nअयोध्यां नगरीं गत्वा भार्गस्वरिरुपस्थितः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2126978, "chapter_id": 3722, "verse_number": "३", "content_sanskrit": "श्रावितं च मया वाक्यं त्वदीयं भीमनन्दिनि ।\nसभायामृतुपर्णस्य चातुर्वर्ण्यसमागमे ।\nश्रावितं च मया वाक्यं त्वदीयं च महाजने\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2126979, "chapter_id": 3722, "verse_number": "४", "content_sanskrit": "तच्छ्रुत्वा नाब्रवीत् किञ्चिद् ऋतुपर्णो नराधिपः ।\nन च पारिषदः कश्चिद् भाष्यमाणो मयाऽसकृत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2126980, "chapter_id": 3722, "verse_number": "५", "content_sanskrit": "अनुज्ञातं तु मां राज्ञा विजने कश्चिदब्रवीत् ।\nऋतुपर्णस्य पुरुषो बाहुको नाम नामतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2126981, "chapter_id": 3722, "verse_number": "६", "content_sanskrit": "सूतस्तस्य नरेन्द्रस्य विरूपो ह्रस्वबाहुकः ।\nदीर्घयाने सुकुशलो मृष्टकर्ता च भोजने\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2126982, "chapter_id": 3722, "verse_number": "७", "content_sanskrit": "स विनिःश्चस्य बहुशो रुदित्वा च मुहुर्मुहुः ।\nकुशलं स च मां पृष्ट्वा पश्चादिदमभाषत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2126983, "chapter_id": 3722, "verse_number": "८", "content_sanskrit": "वैषम्यमपि सम्प्राप्ता गोपायन्ति कुलस्त्रियः ।\nआत्मानमात्मना सत्यो जितःस्वर्गो न संशयः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2126984, "chapter_id": 3722, "verse_number": "९", "content_sanskrit": "रहिता भर्तृभिः साध्व्यो न क्रुद्ध्यन्ति कदाचन ।\nप्राणाश्चारित्रकवचा धारयन्तीह सत्स्त्रियः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2126985, "chapter_id": 3722, "verse_number": "१०", "content_sanskrit": "विषमस्थेन मूढेन परिभ्रष्टसुखेन च ।\nयत् सा तेन परित्यक्ता तत्र न क्रोद्धुमर्हति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2126986, "chapter_id": 3722, "verse_number": "११", "content_sanskrit": "प्राणयात्रां परिप्रेप्सोः शकुनैर्हृतवाससः ।\nआधिभिर्दह्यमानस्य श्यामा न क्रोद्धुमर्हति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2126987, "chapter_id": 3722, "verse_number": "१२", "content_sanskrit": "सत्कृताऽसत्कृता वाऽपि पतिं दृष्ट्वा तथागतम् ।\nभ्रष्टराज्यं श्रियं हीनं श्यामा न क्रोद्धुमर्हति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2126988, "chapter_id": 3722, "verse_number": "१३", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा त्वरितोऽहमिहागतः ।\nश्रुत्वा प्रमाणं भवती राज्ञश्चैव निवेदय\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2126989, "chapter_id": 3722, "verse_number": "१४", "content_sanskrit": "एवं श्रुत्वाऽश्रुपूर्णाक्षी पर्णादस्य वचस्तदा ।\nदमयन्ती रहोऽभ्येत्य मातरं प्रत्यभाषत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2126990, "chapter_id": 3722, "verse_number": "", "content_sanskrit": "दमयन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2126991, "chapter_id": 3722, "verse_number": "१५", "content_sanskrit": "अयमर्थो न संवेद्यः पित्रे मातः कथञ्चन ।\nत्वत्सन्निधौ समादेक्ष्ये सुदेवं द्विजसत्तमम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2126992, "chapter_id": 3722, "verse_number": "१६", "content_sanskrit": "यथा न नृपतिर्भीमः प्रतिपद्येत मे मतम् ।\nतथा त्वया च कर्तव्यं मम चेदिच्छसि प्रियम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2126993, "chapter_id": 3722, "verse_number": "१७", "content_sanskrit": "यथा चाहं समानीता सुदेवेनेह बान्धवात् ।\nतेनैव मङ्गलेन श्वः सुदेवो यातु माचिरम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2126994, "chapter_id": 3722, "verse_number": "१८", "content_sanskrit": "समानेतुं नळं मातरयोध्यां नगरीं प्रति ।\nऋतुपर्णस्य भवने निवसन्तमरिन्दमम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2126995, "chapter_id": 3722, "verse_number": "१९", "content_sanskrit": "विश्रान्तं तु ततः पश्चात् पर्णादं द्विजसत्तमम् ।\nअर्चयामास वैदर्भी धनेनातीव भामिनी \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2126996, "chapter_id": 3722, "verse_number": "२०", "content_sanskrit": "नळे चेहागते विप्र भूयो दास्यामि ते वसु ।\nत्वया हि मे बहुकृतं यथा नान्यः करिष्यति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2126997, "chapter_id": 3722, "verse_number": "२१", "content_sanskrit": "यद्भर्त्राऽहं समेष्यामि शीघ्रमेव द्विजोत्तम\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2126998, "chapter_id": 3722, "verse_number": "२२", "content_sanskrit": "स एवमुक्तश्चाश्वास्य ह्याशीर्वादैः समङ्गळैः ।\nगृहानथ ययौ सोऽपि कृतार्थश्च महामनाः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2126999, "chapter_id": 3722, "verse_number": "२३", "content_sanskrit": "ततः सुदेवमानाय्य दमयन्ती युधिष्ठिर ।\nअब्रवीत् सन्निधौ मातुर्दुःखशोकसमन्विता\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2127000, "chapter_id": 3722, "verse_number": "२४", "content_sanskrit": "गत्वा सुदेव नगरीमयोध्यावासिनं नृपम् ।\nऋतुपर्णं वचो ब्रूहि पतिमन्यं चिकीर्षती\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2127001, "chapter_id": 3722, "verse_number": "२५", "content_sanskrit": "आस्थास्यति पुनर्भैमी दमयन्ती स्वयंवरम् ।\nतत्र गच्छन्ति राजानो राजपुत्राश्च सर्वशः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2127002, "chapter_id": 3722, "verse_number": "२६", "content_sanskrit": "तथा च गणितः कालः श्वोभूते स भविष्यति ।\nयदि सम्भावनीया ते गच्छ शीघ्रमरिन्दम\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2127003, "chapter_id": 3722, "verse_number": "२७", "content_sanskrit": "सूर्योदये द्वितीयं सा भर्तारं वरयिष्यति ।\nन हि स ज्ञायते वीरो नळो जीवन्मृतोऽपि वा \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2127004, "chapter_id": 3722, "verse_number": "२८", "content_sanskrit": "एवं तया यथोक्तं वै गत्वा राजानमब्रवीत् ।\nऋतुपर्णं महाराज सुदेवो ब्राह्मणस्तदा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2127005, "chapter_id": 3722, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि चतुःषष्टितमोऽध्यायः ॥६४॥\n॥ तीर्थयात्रापर्वणि विंशोऽध्यायः ॥२०॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]