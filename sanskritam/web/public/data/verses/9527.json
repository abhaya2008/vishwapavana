[{"id": 5000527000, "chapter_id": 9527, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे विंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000527001, "chapter_id": 9527, "verse_number": "६-१२०-१", "content_sanskrit": "प्रतिप्रयाते काकुत्स्थे महेन्द्रः पाकशासनः।\nअब्रवीत् परमप्रीतो राघवं प्राञ्जलिं स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000527002, "chapter_id": 9527, "verse_number": "६-१२०-२", "content_sanskrit": "अमोघं दर्शनं राम तवास्माकं नरर्षभ।\nप्रीतियुक्ताः स्म तेन त्वं ब्रूहि यन्मनसेप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000527003, "chapter_id": 9527, "verse_number": "६-१२०-३", "content_sanskrit": "एवमुक्तो महेन्द्रेण प्रसन्नेन महात्मना।\nसुप्रसन्नमना हृष्टो वचनं प्राह राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000527004, "chapter_id": 9527, "verse_number": "६-१२०-४", "content_sanskrit": "यदि प्रीतिः समुत्पन्ना मयि ते विबुधेश्वर।\nवक्ष्यामि कुरु मे सत्यं वचनं वदतां वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000527005, "chapter_id": 9527, "verse_number": "६-१२०-५", "content_sanskrit": "मम हेतोः पराक्रान्ता ये गता यमसादनम्।\nते सर्वे जीवितं प्राप्य समुत्तिष्ठन्तु वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000527006, "chapter_id": 9527, "verse_number": "६-१२०-६", "content_sanskrit": "मत्कृते विप्रयुक्ता ये पुत्रैर्दारैश्च वानराः।\nतान् प्रीतमनसः सर्वान् द्रष्टुमिच्छामि मानद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000527007, "chapter_id": 9527, "verse_number": "६-१२०-७", "content_sanskrit": "विक्रान्ताश्चापि शूराश्च न मृत्युं गणयन्ति च।\nकृतयत्ना विपन्नाश्च जीवयैतान् पुरंदर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000527008, "chapter_id": 9527, "verse_number": "६-१२०-८", "content_sanskrit": "मत्प्रियेष्वभिरक्ताश्च न मृत्युं गणयन्ति ये।\nत्वत्प्रसादात् समेयुस्ते वरमेतमहं वृणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000527009, "chapter_id": 9527, "verse_number": "६-१२०-९", "content_sanskrit": "नीरुजो निर्व्रणांश्चैव सम्पन्नबलपौरुषान्।\nगोलाङ्गूलांस्तथर्क्षांश्च द्रष्टुमिच्छामि मानद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000527010, "chapter_id": 9527, "verse_number": "६-१२०-१०", "content_sanskrit": "अकाले चापि पुष्पाणि मूलानि च फलानि च।\nनद्यश्च विमलास्तत्र तिष्ठेयुर्यत्र वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000527011, "chapter_id": 9527, "verse_number": "६-१२०-११", "content_sanskrit": "श्रुत्वा तु वचनं तस्य राघवस्य महात्मनः।\nमहेन्द्रः प्रत्युवाचेदं वचनं प्रीतिसंयुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000527012, "chapter_id": 9527, "verse_number": "६-१२०-१२", "content_sanskrit": "महानयं वरस्तात यस्त्वयोक्तो रघूत्तम।\nद्विर्मया नोक्तपूर्वं च तस्मादेतद् भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000527013, "chapter_id": 9527, "verse_number": "६-१२०-१३", "content_sanskrit": "समुत्तिष्ठन्तु ते सर्वे हता ये युधि राक्षसैः।\nऋक्षाश्च सह गोपुच्छैर्निकृत्ताननबाहवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000527014, "chapter_id": 9527, "verse_number": "६-१२०-१४", "content_sanskrit": "नीरुजो निर्व्रणाश्चैव सम्पन्नबलपौरुषाः।\nसमुत्थास्यन्ति हरयः सुप्ता निद्राक्षये यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000527015, "chapter_id": 9527, "verse_number": "६-१२०-१५", "content_sanskrit": "सुहृद्भिर्बान्धवैश्चैव ज्ञातिभिः स्वजनेन च।\nसर्व एव समेष्यन्ति संयुक्ताः परया मुदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000527016, "chapter_id": 9527, "verse_number": "६-१२०-१६", "content_sanskrit": "अकाले पुष्पशबलाः फलवन्तश्च पादपाः।\nभविष्यन्ति महेष्वास नद्यश्च सलिलायुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000527017, "chapter_id": 9527, "verse_number": "६-१२०-१७", "content_sanskrit": "सव्रणैः प्रथमं गात्रैरिदानीं निर्व्रणैः समैः।\nततः समुत्थिताः सर्वे सुप्त्वेव हरिसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000527018, "chapter_id": 9527, "verse_number": "६-१२०-१८", "content_sanskrit": "बभूवुर्वानराः सर्वे किं त्वेतदिति विस्मिताः।\nकाकुत्स्थं परिपूर्णार्थं दृष्ट्वा सर्वे सुरोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000527019, "chapter_id": 9527, "verse_number": "६-१२०-१९", "content_sanskrit": "अब्रुवन् परमप्रीताः स्तुत्वा रामं सलक्ष्मणम्।\nगच्छायोध्यामितो राजन् विसर्जय च वानरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000527020, "chapter_id": 9527, "verse_number": "६-१२०-२०", "content_sanskrit": "मैथिलीं सान्त्वयस्वैनामनुरक्तां यशस्विनीम्।\nभ्रातरं भरतं पश्य त्वच्छोकाद् व्रतचारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000527021, "chapter_id": 9527, "verse_number": "६-१२०-२१", "content_sanskrit": "शत्रुघ्नं च महात्मानं मातॄः सर्वाः परंतप।\nअभिषेचय चात्मानं पौरान् गत्वा प्रहर्षय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000527022, "chapter_id": 9527, "verse_number": "६-१२०-२२", "content_sanskrit": "एवमुक्त्वा सहस्राक्षो रामं सौमित्रिणा सह।\nविमानैः सूर्यसंकाशैर्ययौ हृष्टः सुरैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000527023, "chapter_id": 9527, "verse_number": "६-१२०-२३", "content_sanskrit": "अभिवाद्य च काकुत्स्थः सर्वांस्तांस्त्रिदशोत्तमान्।\nलक्ष्मणेन सह भ्रात्रा वासमाज्ञापयत् तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000527024, "chapter_id": 9527, "verse_number": "६-१२०-२४", "content_sanskrit": "ततस्तु सा लक्ष्मणरामपालिता\nमहाचमूर्हृष्टजना यशस्विनी।\nश्रिया ज्वलन्ती विरराज सर्वतो\nनिशा प्रणीतेव हि शीतरश्मिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000527025, "chapter_id": 9527, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे विंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]