[{"id": 7006354000, "chapter_id": 26354, "verse_number": "२-१०-१", "content_sanskrit": "वैशम्पायन उवाच\nतौ तु वृन्दावनं प्राप्तौ वसुदेवसुतावुभौ ।\nचेरतुर्वत्सयूथानि चारयन्तौ सुरूपिणौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006354001, "chapter_id": 26354, "verse_number": "२-१०-२", "content_sanskrit": "पूर्णस्तु घर्मसमयस्तयोस्तत्र वने सुखम् ।\nक्रीडतोः सह गोपालैर्यमुनां चावगाहतोः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006354002, "chapter_id": 26354, "verse_number": "२-१०-३", "content_sanskrit": "ततः प्रावृडनुप्राप्ता मनसः कामदीपिनी ।\nप्रववर्षुर्महामेघाः शक्रचापाङ्कितोदराः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006354003, "chapter_id": 26354, "verse_number": "२-१०-४", "content_sanskrit": "बभूवादर्शनः सूर्यो भूमिश्चादर्शना तृणैः ।\nपतता मेघवातेन नवतोयानुकर्षिणा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006354004, "chapter_id": 26354, "verse_number": "२-१०-५", "content_sanskrit": "सम्मार्जिततला भूमिर्यौवनस्थेव लक्ष्यते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006354005, "chapter_id": 26354, "verse_number": "२-१०-६", "content_sanskrit": "नववर्षावसिक्तानि शक्रगोपकुलानि च ।\nनष्टदावाग्निधूमानि वनानि प्रचकाशिरे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006354006, "chapter_id": 26354, "verse_number": "२-१०-७", "content_sanskrit": "नृत्यव्यापारकालश्च मयूराणां कलापिनाम् ।\nमदरक्ताः प्रवृत्ताश्च केकाः पटुरवास्तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006354007, "chapter_id": 26354, "verse_number": "२-१०-८", "content_sanskrit": "नवप्रावृषि कान्तानां षट्पदाहारदायिनाम् ।\nयौवनस्थकदम्बानां नवाभ्रैर्भ्राजते वपुः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006354008, "chapter_id": 26354, "verse_number": "२-१०-९", "content_sanskrit": "हासितं कुटजैर्वृक्षैः कदम्बैर्वासितं वनम् ।\nनाशितं जलदैरुष्णं तोषिता वसुधा जलैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006354009, "chapter_id": 26354, "verse_number": "२-१०-१०", "content_sanskrit": "संतप्ता भास्करकरैरभितप्ता दवाग्निभिः ।\nजलैर्बलाहकोत्सृष्टैरुच्छ्वसन्तीव पर्वताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006354010, "chapter_id": 26354, "verse_number": "२-१०-११", "content_sanskrit": "महावातसमुद्भूतं महामेघगणार्पितम् ।\nमहीमहाराजपुरैस्तुल्यमापद्यते नभः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006354011, "chapter_id": 26354, "verse_number": "२-१०-१२", "content_sanskrit": "क्वचित्कदम्बहासाख्यं शिलीन्ध्राभरणं क्वचित् ।\nसम्प्रदीप्तमिवाभाति फुल्लनीपद्रुमं वनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006354012, "chapter_id": 26354, "verse_number": "२-१०-१३", "content_sanskrit": "ऐन्द्रेण पयसा सिक्तं मारुतेन च विस्मृतम् ।\nपार्थिवं गन्धमाघ्राय लोकः क्षुभितमानसः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006354013, "chapter_id": 26354, "verse_number": "२-१०-१४", "content_sanskrit": "दृप्तसारङ्गनादेन दर्दुरव्याहृतेन च ।\nनवैश्च शिखिविक्रुष्टैरवकीर्णा वसुन्धरा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006354014, "chapter_id": 26354, "verse_number": "२-१०-१५", "content_sanskrit": "भ्रमत्तूर्णमहावर्ता वर्षप्राप्तमहारयाः ।\nहरन्त्यस्तीरजान् वृक्षान्विस्तारं यान्ति निम्नगाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006354015, "chapter_id": 26354, "verse_number": "२-१०-१६", "content_sanskrit": "संततासारनिर्यत्नाः क्लिन्नयत्नोत्तरच्छदाः ।\nन त्यजन्ति नगाग्राणि श्रान्ता इव पतत्त्रिणः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006354016, "chapter_id": 26354, "verse_number": "२-१०-१७", "content_sanskrit": "तोयगम्भीरलम्बेषु स्रवत्सु च नदत्सु च ।\nउदरेषु नवाभ्राणां मज्जतीव दिवाकरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006354017, "chapter_id": 26354, "verse_number": "२-१०-१८", "content_sanskrit": "महीरुहैरुत्पतितैः सलिलोत्पीडसंकुला ।\nअन्विष्यमार्गा वसुधा भाति शाद्वलमालिनी ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006354018, "chapter_id": 26354, "verse_number": "२-१०-१९", "content_sanskrit": "वज्रेणेवावरुग्णानां नगानां नगशालिनाम् ।\nस्रोतोभिः परिकृत्तानि पतन्ति शिखराण्यधः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006354019, "chapter_id": 26354, "verse_number": "२-१०-२०", "content_sanskrit": "पतता मेघवर्षेण यथा निम्नानुसारिणा ।\nपल्वलोत्कीर्णमुक्तेन पूर्यन्ते वनराजयः ॥ २०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006354020, "chapter_id": 26354, "verse_number": "२-१०-२१", "content_sanskrit": "हस्तोच्छ्रितमुखा वन्या मेघनादानुसारिणः ।\nभ्रान्तातिवृष्ट्या मातङ्गा गां गता इव तोयदाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006354021, "chapter_id": 26354, "verse_number": "२-१०-२२", "content_sanskrit": "प्रावृट्प्रवृत्तिं संदृश्य दृष्ट्वा चाम्बुधरान् घनान् ।\nरौहिणेयो मिथः काले कृष्णं वचनमब्रवीत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006354022, "chapter_id": 26354, "verse_number": "२-१०-२३", "content_sanskrit": "पश्य कृष्ण घनान् कृष्णान् बलाकोज्ज्वलभूषणान् ।\nगगने तव गात्रस्य वर्णचोरान् समुच्छ्रितान् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006354023, "chapter_id": 26354, "verse_number": "२-१०-२४", "content_sanskrit": "तव निद्राकरः कालस्तव गात्रोपमं नभः ।\nत्वमिवाज्ञातवसतिं चन्द्रो वसति वार्षिकीम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006354024, "chapter_id": 26354, "verse_number": "२-१०-२५", "content_sanskrit": "एतन्नीलाम्बुदश्यामं नीलोत्पदलप्रभम् ।\nसम्प्राप्ते दुर्दिने काले दुर्दिनं भाति वै नभः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006354025, "chapter_id": 26354, "verse_number": "२-१०-२६", "content_sanskrit": "पश्य कृष्ण जलोदग्रैः कृष्णैरुद्ग्रथितैर्घनैः ।\nगोवर्धनो यथा रम्यो भाति गोवर्धनो गिरिः ॥ २६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006354026, "chapter_id": 26354, "verse_number": "२-१०-२७", "content_sanskrit": "पतितेनाम्भसा ह्येते समन्तान्मददर्पिताः ।\nभ्राजन्ते कृष्णसारङ्गाः काननेषु मुदान्विताः ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006354027, "chapter_id": 26354, "verse_number": "२-१०-२८", "content_sanskrit": "एतान्यम्बुप्रहृष्टानि हरितानि मृदूनि च ।\nतृणानि शतपत्राक्ष पत्रैर्गूहन्ति मेदिनीम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006354028, "chapter_id": 26354, "verse_number": "२-१०-२९", "content_sanskrit": "क्षरज्जलानां शैलानां वनानां जलदागमे ।\nससस्यानां च सीमानां न लक्ष्मीर्व्यतिरिच्यते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006354029, "chapter_id": 26354, "verse_number": "२-१०-३०", "content_sanskrit": "शीघ्रवातसमुद्भूताः प्रोषितौत्सुक्यकारिणः ।\nदामोदरोद्दामरवाः प्रागल्भ्यं यान्ति तोयदाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006354030, "chapter_id": 26354, "verse_number": "२-१०-३१", "content_sanskrit": "हरे हर्यश्वचापेन त्रिवर्णेन त्रिविक्रम ।\nविबाणज्येन रचितं तवेदं मध्यमं पदम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006354031, "chapter_id": 26354, "verse_number": "२-१०-३२", "content_sanskrit": "नभस्येष नभश्चक्षुर्न भात्येव चरन्नभः ।\nमेघैः शीतातपकरो विरश्मिरिव रश्मिवान् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006354032, "chapter_id": 26354, "verse_number": "२-१०-३३", "content_sanskrit": "द्यावापृथिव्योः संसर्गः सततं विततैः कृतः ।\nअव्यवच्छिन्नधारौघैः समुद्रौघसमैर्घनैः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006354033, "chapter_id": 26354, "verse_number": "२-१०-३४", "content_sanskrit": "नीपार्जुनकदम्बानां पृथिव्यां चातिवृष्टिभिः ।\nगन्धैः कोलाहला वान्ति वाता मदनदीपनाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006354034, "chapter_id": 26354, "verse_number": "२-१०-३५", "content_sanskrit": "सम्प्रवृत्तमहावर्षं लम्बमानमहाम्बुदम् ।\nभात्यगाधमपर्यन्तं ससागरमिवाम्बरम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006354035, "chapter_id": 26354, "verse_number": "२-१०-३६", "content_sanskrit": "धारानिर्मलनाराचं विद्युत्कवचवर्मिणम् ।\nशक्रचापायुधधरं युद्धसज्जमिवाम्बरम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006354036, "chapter_id": 26354, "verse_number": "२-१०-३७", "content_sanskrit": "शैलानां च वनानां च द्रुमाणां च वरानन ।\nप्रतिच्छन्नानि भासन्ते शिखराणि घनैर्घनैः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006354037, "chapter_id": 26354, "verse_number": "२-१०-३८", "content_sanskrit": "गजानीकैरिवाकीर्णं सलिलोद्गारिभिर्घनैः ।\nवर्णसारूप्यतां याति गगनं सागरस्य च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006354038, "chapter_id": 26354, "verse_number": "२-१०-३९", "content_sanskrit": "समुद्रोद्धूतजनिता लोलशाद्वलकम्पिनः ।\nशीताः सपृषतोद्दामाः कर्कशा वान्ति मारुताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006354039, "chapter_id": 26354, "verse_number": "२-१०-४०", "content_sanskrit": "निशासु सुप्तचन्द्रासु मुक्ततोयासु तोयदैः ।\nमग्नसूर्यस्य नभसो न विभान्ति दिशो दश ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006354040, "chapter_id": 26354, "verse_number": "२-१०-४१", "content_sanskrit": "चेतनं पुष्करं कोशैः क्षुधाध्मातैः समन्ततः ।\nन घृणीनां न रम्याणां विवेकं यान्ति कृष्टयः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006354041, "chapter_id": 26354, "verse_number": "२-१०-४२", "content_sanskrit": "घर्मदोषपरित्यक्तं मेघतोयविभूषितम् ।\nपश्य वृन्दावनं कृष्ण वनं चैत्ररथं यथा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006354042, "chapter_id": 26354, "verse_number": "२-१०-४३", "content_sanskrit": "एवं प्रावृड्गुणान् सर्वाञ्छ्रीमान् कृष्णस्य पूर्वजः ।\nकथयन्नेव बलवान् व्रजमेव जगाम ह ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006354043, "chapter_id": 26354, "verse_number": "२-१०-४४", "content_sanskrit": "अन्योन्यं रममाणौ तु कृष्णसंकर्षणावुभौ ।\nतत्कालज्ञातिभिः सार्द्धं चेरतुस्तद् वनं महत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]