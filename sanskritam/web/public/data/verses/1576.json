[{"id": 2026919, "chapter_id": 1576, "verse_number": "३-२१४-०x", "content_sanskrit": "मार्कण्येय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026920, "chapter_id": 1576, "verse_number": "३-२१४-१", "content_sanskrit": "एवमुक्तस्तु विप्रेण धर्मव्याधो युधिष्ठिर।\nप्रत्युवाच यथा विप्रं तच्छृणुष्व नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026921, "chapter_id": 1576, "verse_number": "३-२१४-२x", "content_sanskrit": "व्याध उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026922, "chapter_id": 1576, "verse_number": "३-२१४-२", "content_sanskrit": "विज्ञानार्थं मनुष्याणां मनः पूर्वं प्रवर्तते।\nतत्प्राप्य कामं भजतेक्रोधं च द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026923, "chapter_id": 1576, "verse_number": "३-२१४-३", "content_sanskrit": "ततस्तदर्थं यतते कर्म चारभते महत्।\nइष्टानां रूपगन्धानामभ्यासं च निषेवते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026924, "chapter_id": 1576, "verse_number": "३-२१४-४", "content_sanskrit": "ततो रागः प्रभवति द्वेषश्च तदनन्तरम्।\nततो लोभः प्रभवति मोहश्च तदनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026925, "chapter_id": 1576, "verse_number": "३-२१४-५", "content_sanskrit": "तस् लोभाभिभूतस्य रागद्वेषहतस्य च।\nन धर्मे जायते बुद्धिर्व्याजाद्धर्मं करोति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026926, "chapter_id": 1576, "verse_number": "३-२१४-६", "content_sanskrit": "व्याजेन चरते धर्ममर्थं व्याजेन रोचते।\nव्याजेन सिध्यमानेषु धनेषु द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026927, "chapter_id": 1576, "verse_number": "३-२१४-७", "content_sanskrit": "तत्रैव रमते बुद्धिस्ततः पापं चिकीर्षति।\nसुहृद्भिर्वार्यमाणश्च पण्डितैश्च द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026928, "chapter_id": 1576, "verse_number": "३-२१४-८", "content_sanskrit": "उत्तरं श्रुतिसंबद्धं ब्रवीत्यश्रुतियोजितम्।\nअधर्मस्त्रिविधस्तस्य वर्तते रागदोषजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026929, "chapter_id": 1576, "verse_number": "३-२१४-९", "content_sanskrit": "पापं चिन्तयते चैव ब्रवीति च करोति च।\nतस्याधर्मप्रवृत्तस्य गुणा नश्यन्ति साधवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026930, "chapter_id": 1576, "verse_number": "३-२१४-१०", "content_sanskrit": "एकशीलाश्च मित्रत्वं भजन्ते पापकर्मिणः।\nस तेन दुःखमाप्नोति परत्र च विपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026931, "chapter_id": 1576, "verse_number": "३-२१४-११", "content_sanskrit": "पापात्मा भवति ह्येवं धर्मलाभं तु मे शृणु।\nयस्त्वेतान्प्रज्ञाया दोषान्पूर्वमेवानुपश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026932, "chapter_id": 1576, "verse_number": "३-२१४-१२", "content_sanskrit": "कुशलः सुखदुःखेषु सांधूंश्चाप्युपसेवते।\nतस्य साधुसमारम्भाद्बुद्ध्रिधर्मेषु राजते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026933, "chapter_id": 1576, "verse_number": "३-२१४-१३x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2026934, "chapter_id": 1576, "verse_number": "३-२१४-१३", "content_sanskrit": "ब्रवीषि सूनृतंधर्मं यस्य वक्ता न विद्यते।\nदिव्यप्रभावः सुमहानृषिरेव मतोसि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2026935, "chapter_id": 1576, "verse_number": "३-२१४-१४x", "content_sanskrit": "व्याध उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2026936, "chapter_id": 1576, "verse_number": "३-२१४-१४", "content_sanskrit": "ब्राह्मणा वै महाभागाः पितरोऽग्रभुजः सदा।\nतेषां सर्वात्मना कार्यं प्रियं लोके मनीषिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2026937, "chapter_id": 1576, "verse_number": "३-२१४-१५", "content_sanskrit": "यत्तेषां च प्रियं तत्ते वक्ष्यामि द्विजसत्तम।\nनमस्कृत्वा ब्राह्मणेभ्यो ब्राह्मीं विद्यां निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2026938, "chapter_id": 1576, "verse_number": "३-२१४-१६", "content_sanskrit": "इदं विश्वं जगत्सर्वमजगच्चापि सर्वशः।\nमहाभूतात्मकं ब्रह्मन्नातः परतरं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2026939, "chapter_id": 1576, "verse_number": "३-२१४-१७", "content_sanskrit": "महाभूतानि खं वायुरग्निरापस्तथा च भूः।\nशब्दः स्पर्शश्च रूपं च रसो गन्धश् तद्गुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2026940, "chapter_id": 1576, "verse_number": "३-२१४-१८", "content_sanskrit": "तेषामपि गुणाः सर्वे गुणवृत्तिः परस्परम्।\nपूर्वपूर्वगुणाः सर्वे क्रमशो गुणिषु त्रिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2026941, "chapter_id": 1576, "verse_number": "३-२१४-१९", "content_sanskrit": "षष्ठी तु चेतना नाम मन इत्यभिधीयते।\nसप्तमी तु भवेद्बुद्धिरहंकारस्ततः परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2026942, "chapter_id": 1576, "verse_number": "३-२१४-२०", "content_sanskrit": "इन्द्रियाणि च पञ्चात्मा रजः सत्वं तमस्तथा।\nइत्येष सप्तदशको राशिरव्यक्तसंज्ञकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2026943, "chapter_id": 1576, "verse_number": "३-२१४-२१", "content_sanskrit": "सर्वैरिहेन्द्रियार्थैस्तु व्यक्ताव्यक्तैः सुसंवृतैः।\nचतुर्विंसक इत्येष व्यकत्वाव्यक्तमयो गुणः।\nएतत्ते सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2026944, "chapter_id": 1576, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि चतुर्दशाधिकद्विशततमोऽध्यायः ॥ २१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]