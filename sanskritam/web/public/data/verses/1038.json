[{"id": 2001950, "chapter_id": 1038, "verse_number": "१-३९-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001951, "chapter_id": 1038, "verse_number": "१-३९-१", "content_sanskrit": "एलापत्रवचः श्रुत्वा ते नागा द्विजसत्तम।\nसर्वे प्रहृष्टमनसः साधुसाध्वित्यपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001952, "chapter_id": 1038, "verse_number": "१-३९-२", "content_sanskrit": "ततःप्रभृति तां कन्यां वासुकिः पर्यरक्षत।\nजरत्कारुं स्वसारं वै परं हर्षमवाप च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001953, "chapter_id": 1038, "verse_number": "१-३९-३", "content_sanskrit": "ततो नातिमहान्कालः समतीत इवाभवत्।\nअथ देवासुराः सर्वे ममन्थुर्वरुणालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001954, "chapter_id": 1038, "verse_number": "१-३९-४", "content_sanskrit": "तत्र नेत्रमभून्नागो वासुकिर्बलिनां वरः।\nसमाप्यैव च तत्कर्म पितामहमुपागमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001955, "chapter_id": 1038, "verse_number": "१-३९-५", "content_sanskrit": "देवा वासुकिना सार्धं पितामहमथाव्रुवन्।\nभगवञ्शापभीतोऽयं वासुकिस्तप्यते भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001956, "chapter_id": 1038, "verse_number": "१-३९-६", "content_sanskrit": "अस्यैतन्मानसं शल्यं समुद्धर्तुं त्वमर्हसि।\nजनन्याः शापजं देव ज्ञातीनां हितमिच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001957, "chapter_id": 1038, "verse_number": "१-३९-७", "content_sanskrit": "हितो ह्ययं सदास्मकं प्रियकारी च नागराट्।\nप्रसादं कुरु देवेश शमयास्य मनोज्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001958, "chapter_id": 1038, "verse_number": "१-३९-८x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001959, "chapter_id": 1038, "verse_number": "१-३९-८", "content_sanskrit": "मयैव तद्वितीर्णं वै वचनं मनसाऽमराः।\nएलापत्रेण नागेन यदस्याभिहितं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001960, "chapter_id": 1038, "verse_number": "१-३९-९", "content_sanskrit": "तत्करोत्वेष नागेन्द्रः प्राप्तकालं वचः स्वयम्।\nविनशिष्यन्ति ये पापा न तु ये धर्मचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001961, "chapter_id": 1038, "verse_number": "१-३९-१०", "content_sanskrit": "उत्पन्नः स जरत्कारुस्तपस्युग्रे रतो द्विजः।\nतस्यैष भगिनीं काले जरत्कारुं प्रयच्छतु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001962, "chapter_id": 1038, "verse_number": "१-३९-११", "content_sanskrit": "एलापत्रेण यत्प्रोक्तं वचनं भुजगेन ह।\nपन्नगानां हितं देवास्तत्तथा न तदन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001963, "chapter_id": 1038, "verse_number": "१-३९-१२x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001964, "chapter_id": 1038, "verse_number": "१-३९-१२", "content_sanskrit": "एतच्छ्रुत्वा तु नागेन्द्रः पितामहवचस्तदा।\nसंदिश्य पन्नगान्सर्वान्वासुकिः शापमोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001965, "chapter_id": 1038, "verse_number": "१-३९-१३", "content_sanskrit": "स्वसारमुद्यम्य तदा जरत्कारुमृषिं प्रति।\nसर्पान्बहूञ्जरत्कारौ नित्ययुक्तान्समादधत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001966, "chapter_id": 1038, "verse_number": "१-३९-१४", "content_sanskrit": "जरत्कारुर्यदा भार्यामिच्छेद्वरयितुं प्रभुः।\nशीघ्रमेत्य तदाऽऽख्येयं तन्नः श्रेयो भविष्यति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001967, "chapter_id": 1038, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमनमहाभारते आदिपर्वणि आस्तीकपर्वणि एकोनचत्वारिंशोऽध्यायः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]