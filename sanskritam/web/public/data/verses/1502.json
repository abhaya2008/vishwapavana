[{"id": 2023481, "chapter_id": 1502, "verse_number": "३-१४०-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023482, "chapter_id": 1502, "verse_number": "३-१४०-१", "content_sanskrit": "एतस्मिन्नेव काले तु बृहद्द्युम्नो महीपतिः।\nसत्रं तेने महाभागो रैभ्ययाज्यः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023483, "chapter_id": 1502, "verse_number": "३-१४०-२", "content_sanskrit": "तेन रैभ्यस्य वै पुत्रावर्वावसुपरासू।\nवृतौ सहायौ सत्रार्थं बृहद्द्युम्नेन धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023484, "chapter_id": 1502, "verse_number": "३-१४०-३", "content_sanskrit": "तत्र तौ समनुज्ञातौ पित्रा कौन्तेय जग्मतुः।\nआश्रमे त्वभवद्रैभ्यो भार्या चैव परावसोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023485, "chapter_id": 1502, "verse_number": "३-१४०-४", "content_sanskrit": "अथावलोककोऽगच्छद्गृहानकः परावसुः।\nकृष्णाजिनेन संवीतं ददर्श पितरं वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023486, "chapter_id": 1502, "verse_number": "३-१४०-५", "content_sanskrit": "जघन्यरात्रे निद्रान्धः सावशेषे तमस्यापि।\nचरन्तं गहनेऽरण्ये मेने स पितरं मृगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023487, "chapter_id": 1502, "verse_number": "३-१४०-६", "content_sanskrit": "मृगं तु मन्यमानेन पिता वै तेन हिंसितः।\nअकामयानेन तदा शरीरत्राणमिच्छता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023488, "chapter_id": 1502, "verse_number": "३-१४०-७", "content_sanskrit": "तस्य स प्रेतकार्याणि कृत्वा सर्वाणि भारत।\nपुनरागम्य तत्सत्रमब्रवीद्धातरं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023489, "chapter_id": 1502, "verse_number": "३-१४०-८", "content_sanskrit": "इदं कर्म न शक्तस्त्वं वोढुमेकः कथंचन।\nमया च हिंसितस्तातो मन्यमानेन वै मृगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023490, "chapter_id": 1502, "verse_number": "३-१४०-९", "content_sanskrit": "सोऽस्मदर्थे व्रतं तात चर त्वं ब्रह्मघातिनाम्।\nसमर्थो ह्यहमेकाकी कर्म कर्तुमिदं मुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023491, "chapter_id": 1502, "verse_number": "३-१४०-१०x", "content_sanskrit": "अर्वावसुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023492, "chapter_id": 1502, "verse_number": "३-१४०-१०", "content_sanskrit": "करोतु वै भवान्सत्रं बृहद्द्युम्नस्य धीमतः।\nब्रह्महत्यां चरिष्येऽहं त्वदर्थं नियतेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023493, "chapter_id": 1502, "verse_number": "३-१४०-११x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023494, "chapter_id": 1502, "verse_number": "३-१४०-११", "content_sanskrit": "स तस्यब्रह्महत्यायाः पारं गत्वा युधिष्ठिर।\nअर्वावसुस्तदा सत्रमाजगाम पुनर्मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023495, "chapter_id": 1502, "verse_number": "३-१४०-१२", "content_sanskrit": "ततः परावसुर्दृष्ट्वा भ्रातरं समुपस्थितम्।\nबृहद्द्युम्नमुवाचेदं वचनं हर्षगद्गदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023496, "chapter_id": 1502, "verse_number": "३-१४०-१३", "content_sanskrit": "एष ते ब्रह्महा यज्ञं मा द्रष्टुं प्रविशेदिति।\nब्रह्महा प्रेक्षितेनापि पीडयेत्त्वामसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023497, "chapter_id": 1502, "verse_number": "३-१४०-१४x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023498, "chapter_id": 1502, "verse_number": "३-१४०-१४", "content_sanskrit": "तच्छ्रुत्वैव तदा राजा प्रेष्यानाह स विट्पते।\nप्रेष्यैरुत्सार्यमाणस्तु राजन्नर्वावसुस्तदा।\nन मया ब्रह्महत्येयं कृतेत्याह पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023499, "chapter_id": 1502, "verse_number": "३-१४०-१५", "content_sanskrit": "उच्यमानोऽसकृत्प्रेष्यैर्ब्रह्महा इति भारत।\nनैवस्म प्रतिजानामि ब्र्हमहत्यां स्वयंकृताम्।\nमम भ्रात्रा कृतमिदं मया स परिमोक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023500, "chapter_id": 1502, "verse_number": "३-१४०-१६", "content_sanskrit": "स तथा प्रवदन्क्रोधात्तैश्च प्रेष्यैः प्रभाषितः।\nतूष्णीं जगाम ब्रह्मर्षिर्वनमेव महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023501, "chapter_id": 1502, "verse_number": "३-१४०-१७", "content_sanskrit": "उग्रं तपः समास्थाय दिवाकरमथाश्रितः।\nरहस्यवेदं कृतवान्सूर्यस्य द्विजसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023502, "chapter_id": 1502, "verse_number": "३-१४०-१८", "content_sanskrit": "मूर्तिमांस्तं ददर्शाथ स्वयमग्रभुगव्ययः ॥ ३-१४०-१९aप्रीतास्तस्याभवन्देवाः कर्मणाऽर्वावसोर्नृप।\nतं ते प्रवरयामासुर्निरासुश्च परावसुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023503, "chapter_id": 1502, "verse_number": "३-१४०-२०", "content_sanskrit": "ततो देवा वरं तस्मै ददुरग्निपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023504, "chapter_id": 1502, "verse_number": "३-१४०-२१", "content_sanskrit": "स चापि वरयामास पितुरुत्थानमात्मनः।\nअनागस्त्वं ततो भ्रातुः पितुश्चास्मरणं वधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023505, "chapter_id": 1502, "verse_number": "३-१४०-२२", "content_sanskrit": "भरद्वाजस्य चोत्थानं यवक्रीतस्य चोभयोः।\nप्रतिष्ठां चापि वेदस्य सौरस्य द्विजसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023506, "chapter_id": 1502, "verse_number": "३-१४०-२३", "content_sanskrit": "एवमस्त्विति तं देवाः प्रोचुश्चापि वरान्ददुः।\nततः प्रादुर्बभूवुस्ते सर्व एव युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2023507, "chapter_id": 1502, "verse_number": "३-१४०-२४", "content_sanskrit": "अथाब्रवीद्यवक्रीतो देवानग्निपुरोगमान्।\nसमधीतं मया ब्रह्म व्रतानि चरितानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2023508, "chapter_id": 1502, "verse_number": "३-१४०-२५", "content_sanskrit": "कथं च रैभ्यः शक्तो मामदीयानं तपस्विनम्।\nतथायुक्तेन विधिना निहन्तुममरोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2023509, "chapter_id": 1502, "verse_number": "३-१४०-२६x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2023510, "chapter_id": 1502, "verse_number": "३-१४०-२६", "content_sanskrit": "मैवं कृथा यवक्रीत यथा वदसि वै मुने।\nऋते गुरुमधीता हि स्वयं वेदास्त्वया पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2023511, "chapter_id": 1502, "verse_number": "३-१४०-२७", "content_sanskrit": "अनन तु गुरूनदुःखात्तोषयित्वाऽऽत्मक्रमणा।\nकालेन महता क्लेशाद्ब्रह्माधिगतमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2023512, "chapter_id": 1502, "verse_number": "३-१४०-२८x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2023513, "chapter_id": 1502, "verse_number": "३-१४०-२८", "content_sanskrit": "यवक्रीतमथोक्त्वैवं देवाः साग्निपुरोगमाः।\nसंजीवयित्वा तान्सर्वान्पुनर्जग्मुस्त्रिविष्टपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2023514, "chapter_id": 1502, "verse_number": "३-१४०-२९", "content_sanskrit": "`ततो वै स यवक्रीतो ब्रह्मचर्यं चचार ह।\nअष्टादश च वर्षाणि त्रिंशतं च युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2023515, "chapter_id": 1502, "verse_number": "३-१४०-३०", "content_sanskrit": "आस्रमस्तस्य पुण्योऽयं सदापुष्पफलद्रुमः।\nअत्रोष्य राजशार्दूल सर्वपापैः प्रभोक्ष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2023516, "chapter_id": 1502, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि चत्वारिंशदधिकशततमोऽध्यायः ॥ १४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]