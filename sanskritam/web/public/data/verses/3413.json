[{"id": 2111734, "chapter_id": 3413, "verse_number": "", "content_sanskrit": "शकुन्तला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2111735, "chapter_id": 3413, "verse_number": "१", "content_sanskrit": "राजन् सर्षपमात्राणि परच्छिद्राणि पश्यसि ।\nआत्मनो मेरुमात्राणि पश्यन्नपि न पश्यसि \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2111736, "chapter_id": 3413, "verse_number": "२", "content_sanskrit": "मेनका त्रिदशांश्चानु त्रिदशाश्चानु मेनकाम् ।\nममैवोद्रिच्यते जन्म दुष्षन्त तव जन्मतः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2111737, "chapter_id": 3413, "verse_number": "३", "content_sanskrit": "क्षितौ चरसि राजंस्त्वमन्तरिक्षे चराम्यहम् ।\nआवयोरन्तरं पश्य मेरुसर्षपयोरिव\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2111738, "chapter_id": 3413, "verse_number": "४", "content_sanskrit": "महेन्द्रस्य कुबेरस्य यमस्य वरुणस्य च ।\nभवनान्यनुसंयामि प्रभावं पश्य मे नृप \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2111739, "chapter_id": 3413, "verse_number": "५", "content_sanskrit": "पुरा नरवरः पुत्र उर्वश्यां जनितस्तदा ।\nआयुर्नाम महातेजा तव पूर्वपितामहः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2111740, "chapter_id": 3413, "verse_number": "६", "content_sanskrit": "महर्षयश्च बहवः क्षत्रियाश्च परन्तप ।\nअप्सरस्सु व्यजायन्त मातृदोषो न विद्यते \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2111741, "chapter_id": 3413, "verse_number": "७", "content_sanskrit": "सत्यश्चापि प्रवादोऽयं सम्प्रवक्ष्यामि तेऽनघ ।\nनिदर्शनार्थं न द्वेषाच्छ्रुत्वा तं क्षन्तुमर्हसि \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2111742, "chapter_id": 3413, "verse_number": "८", "content_sanskrit": "विरूपो यावदादर्शे नात्मनो वीक्षते मुखम् ।\nमन्यते तावदात्मानमन्येभ्यो रूपवत्तरम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2111743, "chapter_id": 3413, "verse_number": "९", "content_sanskrit": "यदा तु मुखमादर्शे विरूपं सोऽभिवीक्षते ।\nतदा विरूपं जानीयादात्मानं नेतरं जनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2111744, "chapter_id": 3413, "verse_number": "१०", "content_sanskrit": "अतीव रूपसम्पन्नो न किं चिदवमन्यते ।\nअतीव जल्पन् दुर्वाचो भवतीह विपोदकः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2111745, "chapter_id": 3413, "verse_number": "११", "content_sanskrit": "साधुलोकप्रवादोऽयं तव वक्ष्यामि चानघ ।\nनिदर्शानार्थं न द्वेषात् तच्छ्रुत्वा क्षन्तुमर्हसि \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2111746, "chapter_id": 3413, "verse_number": "१२", "content_sanskrit": "पांसुपातेन तुष्यन्ति कुञ्जरा मदशालिनः ।\nतथा परिवदन्नन्यान् तुष्टो भवति दुर्जनः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2111747, "chapter_id": 3413, "verse_number": "१३", "content_sanskrit": "सत्यधर्मच्युतात् पुंसः क्रुद्धादाशीविषादिव ।\nनास्तिकोऽप्युद्विजत्येव जनः किं पुनरास्तिकः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2111748, "chapter_id": 3413, "verse_number": "१४", "content_sanskrit": "स्वयमुत्पाद्य पुत्रं वै सदृशं योऽवमन्यते ।\nतस्य देवाः श्रियं घ्नन्ति तत्रैनं कलिराविशेत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2111749, "chapter_id": 3413, "verse_number": "१५", "content_sanskrit": "अभव्ये ह्यनृतेऽशुद्धे नास्तिके पापकर्मणि ।\nदुराचारे कलिस्तिष्ठेन्न कलिर्धर्मचारिषु \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2111750, "chapter_id": 3413, "verse_number": "१६", "content_sanskrit": "नीचो हि जल्पतां पुंसां श्रुत्वा वाचः शुभाशुभाः ।\nअशुभं वाक्यमादत्ते पुरीषमिव सूकरः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2111751, "chapter_id": 3413, "verse_number": "१७", "content_sanskrit": "प्राज्ञस्तु जल्पतां पुंसां श्रुत्वा वाचः शुभाशुभाः ।\nगुणवद्वाक्यमादत्ते हंसः क्षीरमिवाम्भसि \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2111752, "chapter_id": 3413, "verse_number": "१८", "content_sanskrit": "आत्मनो दुष्टभावत्वं ज्ञानी नीचोऽप्रसन्नघीः ।\nपरेषामपि जानाति स्वकर्मसदृशान् गुणान् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2111753, "chapter_id": 3413, "verse_number": "१९", "content_sanskrit": "दह्यमानाः सुतीव्रेण नीचाः परयशोऽग्निना ।\nअशक्तास्तत्पदं गन्तुमतो निन्दां प्रकुर्वते \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2111754, "chapter_id": 3413, "verse_number": "२०", "content_sanskrit": "अन्यान् परिवदन् साधुर्यथा हि परितप्यते ।\nतथा परिवदन्नन्यं हृष्टो भवति दुर्जनः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2111755, "chapter_id": 3413, "verse_number": "२१", "content_sanskrit": "अपवादरता मूर्खा भवन्तीह विशेषतः ।\nनापवादरताः सन्तो भवन्ति स्म विशेषतः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2111756, "chapter_id": 3413, "verse_number": "२२", "content_sanskrit": "अभिवाद्य च वृद्धान् हि साधुर्गच्छति निर्वृतिम् ।\nएवं सज्जनमाक्रुश्य हृष्टो भवति दुर्जनः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2111757, "chapter_id": 3413, "verse_number": "२३", "content_sanskrit": "सुखं जीवन्त्यदोषज्ञा मूर्खा दोषानुदर्शिनः ।\nये तु वाच्याः परैः सन्तः परानाहुस्तथाविधान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2111758, "chapter_id": 3413, "verse_number": "२४", "content_sanskrit": "अतो हास्यतरं लोके किंचिदन्यन्न विद्यते ।\nयत्र दुर्जन इत्याह सज्जनं दुर्जनः स्वयम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2111759, "chapter_id": 3413, "verse_number": "२५", "content_sanskrit": "दारुणाल्लोकसङ्क्लेशाद् दुःखमाप्नोत्यसंशयम् ।\nकुलवंशप्रतिष्ठां हि पितरः पुत्रमब्रुवन् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2111760, "chapter_id": 3413, "verse_number": "२६", "content_sanskrit": "उत्तमं सर्वधर्माणां तस्मात् पुत्रं नतु त्यजेत् ।\nस्वपत्नीप्रभवाँल्लब्धान् क्रीतान् सर्वविवर्जितान्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2111761, "chapter_id": 3413, "verse_number": "२७", "content_sanskrit": "कृतानन्यासु चोत्पन्नान् पुत्रान् वै मनुरव्रवीत् ।\nतत्र षड् बन्धुदायादाः षडदायादबान्धवाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2111762, "chapter_id": 3413, "verse_number": "२८", "content_sanskrit": "धर्माकृतिवहा नॄणां मनसः प्रीतिवर्धनाः ।\nत्रायन्ति जनकाज्जाताः पुत्रा धर्मप्लवाः पितॄन्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2111763, "chapter_id": 3413, "verse_number": "२९", "content_sanskrit": "तस्मात् नृपतिशार्दूल न पुत्रं त्यक्तुमर्हसि ।\nस त्वं पुत्रं च सत्यं च पालयस्व महीपते \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2111764, "chapter_id": 3413, "verse_number": "३०", "content_sanskrit": "उभयं पालयन् नित्यं नानृतं कर्तुमर्हसि ।\nआत्मानं सत्यधर्मौ च पालयेथा महीपते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2111765, "chapter_id": 3413, "verse_number": "३१", "content_sanskrit": "नरेन्द्रसिंह कपटं न हि वक्तुमिहार्हसि ।\nवरं कूपशताद् वापी वरं वापीशतात् क्रतुः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2111766, "chapter_id": 3413, "verse_number": "३२", "content_sanskrit": "वरः क्रतुशतात् पुत्रः सत्यं पुत्रशताद् वरम् ।\nअश्वमेधसहस्रं च सत्यं च तुलया धृतम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2111767, "chapter_id": 3413, "verse_number": "३३", "content_sanskrit": "अश्चमेधसहस्राद्धि सत्यमेव विशिष्यते ।\nसर्ववेदाधिगमनं सर्वतीर्थावगाहनम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2111768, "chapter_id": 3413, "verse_number": "३४", "content_sanskrit": "सत्यं च वदतो राजन् समं वा स्यान्न वा समम् ।\nनास्ति सत्यात् परो धर्मो न सत्याद् विद्यते परम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2111769, "chapter_id": 3413, "verse_number": "३५", "content_sanskrit": "न हि तीव्रतरं पापमनृतादिह विद्यते ।\nराजन् सत्यं परं व्रह्म सत्यं च समयः परः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2111770, "chapter_id": 3413, "verse_number": "३६", "content_sanskrit": "मा त्याक्षीः समयं राजन् सत्यं सङ्गतमस्तु ते ।\nयः पापं न विजानाति कर्म कृत्वा नराधिप \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2111771, "chapter_id": 3413, "verse_number": "३७", "content_sanskrit": "न हि तादृक् परं पापमनृतादिह विद्यते ।\nयस्य ते हृदयं वेद सत्यस्यैवानृतस्य च \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2111772, "chapter_id": 3413, "verse_number": "३८", "content_sanskrit": "कल्याणं साक्षिणं तस्मात् कर्तुमर्हसि धर्मतः ।\nयो न कामान्न च क्रोधान्न द्रोहादतिवर्तते\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2111773, "chapter_id": 3413, "verse_number": "३९", "content_sanskrit": "अमित्रं वापि मित्रं वा स वा उत्तमपूरुषः ।\nअनृते चेत् प्रसङ्गस्ते श्रद्दधासि न चेत् स्वयम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2111774, "chapter_id": 3413, "verse_number": "४०", "content_sanskrit": "आत्मनमवगच्छाशु तादृशेनास्ति सङ्गतम् ।\nपुत्रत्वे शङ्कमानस्य बुद्धिर्ज्ञापकदीपिका\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2111775, "chapter_id": 3413, "verse_number": "४१", "content_sanskrit": "गतिः स्वरः स्मृतिः सत्वं शीलविज्ञानविक्रमाः ।\nधृष्णुः प्रकृतिभावौ च आवर्ता रोमजातयः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2111776, "chapter_id": 3413, "verse_number": "४३", "content_sanskrit": "समा यस्य यतः स्युस्ते तस्य पुत्रो न संशयः ।\nसादृश्येनोद्गतं बिम्बं तव देहाद् विशांपते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2111777, "chapter_id": 3413, "verse_number": "४४", "content_sanskrit": "त्रातेति भाषमाणं वै मा स्म राजन् वृथा कृथाः ।\nऋतेऽपि गर्दभीक्षीरात् पयः पास्यति मे सुतः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2111778, "chapter_id": 3413, "verse_number": "४५", "content_sanskrit": "ऋतेऽपि त्वां तु दुष्षन्त शैलराजावतंसिकाम् ।\nचतुरन्तामिमामुर्वीं पुत्रो मे पालयिप्यति \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2111779, "chapter_id": 3413, "verse_number": "४६", "content_sanskrit": "शकुन्तले तव सुतश्चक्रवर्ती भविप्यति ।\nएवमुक्तो महेन्द्रेण भविष्यति न चान्यथा \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2111780, "chapter_id": 3413, "verse_number": "४७", "content_sanskrit": "साक्षित्वे बहवोऽप्युक्ता देवदूतादयो मताः ।\nन ब्रुवन्ति यथा सत्यमुताहो त्वनृतं किल ।\nअसाक्षिणी मन्दभाग्या गमिष्यामि यथागतम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2111781, "chapter_id": 3413, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2111782, "chapter_id": 3413, "verse_number": "४८", "content_sanskrit": "एतावदुक्त्वा वचनं प्रातिष्ठत शकुन्तला ।\nतस्याः कोधसमुत्थोऽग्निः सधूमो मूर्ध्न्यदृश्यत \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2111783, "chapter_id": 3413, "verse_number": "४९", "content_sanskrit": "तं नियम्यात्मनोऽङ्गेषु ततः क्रोधाग्निमात्मजम् ।\nप्रस्थितैवानवद्याङ्गी सह पुत्रेण वै वनम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2111784, "chapter_id": 3413, "verse_number": "९२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nद्विनवतितमोऽध्यायः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2111785, "chapter_id": 3413, "verse_number": "४०", "content_sanskrit": "॥ इति सम्भवपर्वणि चत्वारिंशोऽध्यायः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2111786, "chapter_id": 3413, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]