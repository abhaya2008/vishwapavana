[{"id": 2094353, "chapter_id": 3016, "verse_number": "१३-१४६-१", "content_sanskrit": "*युधिष्ठिर उवाच।\nशूद्राणामिह शुश्रूषा नित्यमेवानुवर्णिता।\nकैः कारणैः कतिविधा शुश्रूषा समुदाहृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094354, "chapter_id": 3016, "verse_number": "१३-१४६-२", "content_sanskrit": "के च शुश्रूषया लोका विहिता भरतर्षभ।\nशुद्राणां भरतश्रेष्ठ ब्रूहि मे धर्मलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094355, "chapter_id": 3016, "verse_number": "१३-१४६-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094356, "chapter_id": 3016, "verse_number": "१३-१४६-३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nशूद्राणामनुकम्पार्थं यदुक्तं ब्रह्मवादिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094357, "chapter_id": 3016, "verse_number": "१३-१४६-४", "content_sanskrit": "वृद्धः पराशरः प्राह धर्मं शुभ्रमनामयम्।\nअनुग्रहार्थं वर्णानां शौचाचारसमन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094358, "chapter_id": 3016, "verse_number": "१३-१४६-५", "content_sanskrit": "धर्मोपदेशमकिलं यथावदनुपूर्वशः।\nशिष्यानध्यापयामास शास्त्रमर्थवदर्थवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094359, "chapter_id": 3016, "verse_number": "१३-१४६-६", "content_sanskrit": "क्षान्तेन्द्रियेण मानेन शुचिनाऽचापलेन वै।\nअदुर्बलेन धीरेण शान्तेनोत्तरवादिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094360, "chapter_id": 3016, "verse_number": "१३-१४६-७", "content_sanskrit": "अलुब्धेनानृशंसेन ऋजुना ब्रह्मवादिना।\nचारित्रतत्परेणैव सर्वभूतहितात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094361, "chapter_id": 3016, "verse_number": "१३-१४६-८", "content_sanskrit": "अरयः षड्विजेतव्या नित्यं स्वं देहमाश्रिताः।\nकामक्रोधौ च लोभश्च मानमोहौ मदस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094362, "chapter_id": 3016, "verse_number": "१३-१४६-९", "content_sanskrit": "विधिना धृतिमास्थाय शुश्रूषुरनहंकृतः।\nवर्णत्रयस्यानुमतो यथाशक्ति यथाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094363, "chapter_id": 3016, "verse_number": "१३-१४६-१०", "content_sanskrit": "कर्मणा मनसा वाचा चक्षुषा च चतुर्विधम्।\nआस्थाय नियमं धीमाञ्शान्तो दान्तो जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094364, "chapter_id": 3016, "verse_number": "१३-१४६-११", "content_sanskrit": "रक्षोयक्षजनद्वेषी शेषान्नकृतभोजनः।\nवर्णत्रयान्मधु यथा भ्रमरो धर्ममाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094365, "chapter_id": 3016, "verse_number": "१३-१४६-१२", "content_sanskrit": "यदि शूद्रस्तपः कुर्याद्वेददृष्टेन कर्मणा॥\nइह चास्य परिक्लेशः प्रेत्य चास्यासुभागतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094366, "chapter_id": 3016, "verse_number": "१३-१४६-१३", "content_sanskrit": "अधर्म्यमयशस्यं च तपः शूद्रे प्रतिष्ठितम्।\nअमार्गेण तपस्तप्त्वा म्लेच्छेषु फलमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094367, "chapter_id": 3016, "verse_number": "१३-१४६-१४", "content_sanskrit": "अन्यथा वर्तमानो हि न शूद्रो धर्ममर्हति।\nअमार्गेणि प्रयातानां प्रत्यक्षादुपलभ्यते।\nचातुर्वर्ण्यव्यपेतानां जातिमूर्तिपरिग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2094368, "chapter_id": 3016, "verse_number": "१३-१४६-१५", "content_sanskrit": "तथा ते हि शकाश्चीनाः काम्भोजाः पारदास्तथा।\nशबराः पप्लवाश्चैव तुषारयवनास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2094369, "chapter_id": 3016, "verse_number": "१३-१४६-१६", "content_sanskrit": "दार्वाश्च दरदाश्चैव उज्जिहानास्तथेतराः।\nवेणाश्च कङ्कणाश्चैव सिम्हला मद्रकास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2094370, "chapter_id": 3016, "verse_number": "१३-१४६-१७", "content_sanskrit": "किष्किन्धकाः पुलिन्दाश्च कह्वाश्चान्ध्राः सनीरगाः।\nगन्धिका द्रमिडाश्चैव बर्बराश्चूचुकास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2094371, "chapter_id": 3016, "verse_number": "१३-१४६-१८", "content_sanskrit": "किराताः पार्वतेयाश्च कोलाश्चोलाः सकाषकाः।\nआरूकाश्चैव दोहाश्च याश्चान्याम्लेच्छजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2094372, "chapter_id": 3016, "verse_number": "१३-१४६-१९", "content_sanskrit": "विकृता विकृताचारा दृश्यन्ते क्रूरबुद्धयः।\nअमार्गेणाश्रिता धर्मं ततो जात्यन्तरं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2094373, "chapter_id": 3016, "verse_number": "१३-१४६-२०", "content_sanskrit": "अमार्गोपार्जितस्यैतत्तपसो विदितं फलम्।\nन नश्यति कृतं कर्म शुभं वा यदि वाऽशुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2094374, "chapter_id": 3016, "verse_number": "१३-१४६-२१", "content_sanskrit": "अत्राप्येते वसु प्राप्य विकर्म तपसार्जितम्।\nपाषण्डानर्चयिष्यन्ति धर्मकामा वृथा श्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2094375, "chapter_id": 3016, "verse_number": "१३-१४६-२२", "content_sanskrit": "एवं चतुर्णां वर्णानामाश्रमाणां च पार्थिव।\nविपरीतं वर्तमाना म्लेच्छा जायन्त्यबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2094376, "chapter_id": 3016, "verse_number": "१३-१४६-२३", "content_sanskrit": "अध्यायधनिनो विप्राः क्षत्रियाणां बलं धनम्।\nवणिक्कृषिश्च वैश्यानां शूद्राणां परिचारिका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2094377, "chapter_id": 3016, "verse_number": "१३-१४६-२४", "content_sanskrit": "व्युच्छेदात्तस्य धर्मस्य निरयायोपपद्यते।\nततो म्लेच्छा भवन्त्येते निर्घृणा धर्मवर्जिताः।\nपुनश्च निरयं तेषां तिर्यग्योनिश्च शाश्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2094378, "chapter_id": 3016, "verse_number": "१३-१४६-२५", "content_sanskrit": "ये तु सत्यथमास्थाय वर्णाश्रमकृतं पुरा।\nसर्वान्विमार्गानुत्सृज्य स्वधर्मविधिमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2094379, "chapter_id": 3016, "verse_number": "१३-१४६-२६", "content_sanskrit": "सर्वभूतदयावन्तो दैवतद्विजपूजकाः।\nशास्त्रदृष्टेन विधिना श्रद्धया जितमन्यवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2094380, "chapter_id": 3016, "verse_number": "१३-१४६-२७", "content_sanskrit": "तेषां विधिं प्रवक्ष्यामि यथावदनुपूर्वशः।\nउपादानविधइं कृत्स्नं शुश्रूषाधिगमं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2094381, "chapter_id": 3016, "verse_number": "१३-१४६-२८", "content_sanskrit": "शिष्टोपनयनं चैव मन्त्राणि विविधानि च।\nतथा शिष्यपरीक्षां च शास्त्रप्रामाण्यदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2094382, "chapter_id": 3016, "verse_number": "१३-१४६-२९", "content_sanskrit": "प्रवक्ष्यामि यथातत्वं यथावदनुपूर्वशः।\nशौचकृत्यस्य शौचार्थान्सर्वानेव विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2094383, "chapter_id": 3016, "verse_number": "१३-१४६-३०", "content_sanskrit": "महाशौचप्रभृतयो दृष्टास्तत्वार्थदर्शिभिः।\nतत्रापि शूद्रो भिक्षूणामिदं शेष च कल्पयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2094384, "chapter_id": 3016, "verse_number": "१३-१४६-३१", "content_sanskrit": "भिक्षुभिः सुकृतप्रज्ञैः केवलं दर्ममाश्रितैः।\nसम्यद्गर्शनसम्पन्नैर्गताध्वनि हितार्थिभिः।\nअवकाशमिमं मेध्यं निर्मितं तामवीरुधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2094385, "chapter_id": 3016, "verse_number": "१३-१४६-३२", "content_sanskrit": "निर्जनं संवृतं बुद्ध्वा नियतात्मा जितेन्द्रियः।\nसजलं भाजनं स्थाप्य मृत्तिकां च परीक्षिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2094386, "chapter_id": 3016, "verse_number": "१३-१४६-३३", "content_sanskrit": "परीक्ष्य भूमिं मूत्रार्थी तत आसीत वाग्यतः।\nउदङ्मुखो दिवा कुर्याद्रात्रौ चेद्दक्षिणामुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2094387, "chapter_id": 3016, "verse_number": "१३-१४६-३४", "content_sanskrit": "अन्तर्हितायां भूमौ तु अन्तर्हितशिरास्तथा।\nअसमाप्ते तथा शौचे न वाचं किञ्चिदीरयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2094388, "chapter_id": 3016, "verse_number": "१३-१४६-३५", "content_sanskrit": "कृतकृत्यस्तथाऽऽचम्य गच्छन्नोदीरयेद्वचः।\nशौचार्थमुपविष्टस्तु मृद्गाजनपुरस्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2094389, "chapter_id": 3016, "verse_number": "१३-१४६-३६", "content_sanskrit": "स्थाप्यं कमण्डलुं गृह्यि पार्श्वोरुभ्यामथान्तरे।\nशौचं कुर्याच्छनैर्वीरो बुद्धिपूर्वमसङ्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2094390, "chapter_id": 3016, "verse_number": "१३-१४६-३७", "content_sanskrit": "पाणिना शुद्धमुदकं सङ्गृह्य विधिपूर्वकम्।\nविप्रुषश्च यता न स्युर्यथा चोरू न संस्पृशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2094391, "chapter_id": 3016, "verse_number": "१३-१४६-३८", "content_sanskrit": "अपाने मृत्तिकास्तिस्रः प्रदेयास्त्वनुपूर्वशः।\nहस्ताभ्यां च तथा विप्रो हस्तं हस्तेन संस्पृशेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2094392, "chapter_id": 3016, "verse_number": "१३-१४६-३९", "content_sanskrit": "अपाने नव देयाः स्युरिति वृद्धानुशासनम्।\nमृत्तिका दीयमाना हि शोधयेद्देशमञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2094393, "chapter_id": 3016, "verse_number": "१३-१४६-४०", "content_sanskrit": "तस्मात्पाणितले देया मृत्तिकास्तु पुनः पुनः।\nबृद्धिपूर्वं प्रयत्नेन यथा नैव स्पृशेत्स्फिजौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2094394, "chapter_id": 3016, "verse_number": "१३-१४६-४१", "content_sanskrit": "यथा घातो हि न भवेत्क्लेदजः परिधानके।\nतथा गुदं प्रमार्जेत शौचार्थं तु पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2094395, "chapter_id": 3016, "verse_number": "१३-१४६-४२", "content_sanskrit": "प्रतिपादं ततस्त्यक्त्वा शौचमुत्थाय कारयेत्।\nसव्ये द्वादश देयाः स्युस्तिस्रस्तिस्रः पुनः पुनः।\nदेया कूर्परके हस्ते पृष्ठे बन्धे पुनः पनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2094396, "chapter_id": 3016, "verse_number": "१३-१४६-४३", "content_sanskrit": "तथैवादर्शके दद्याच्चतस्रस्तूभयोरपि।\nउभयोर्हस्तयोरेवं सप्तसप्त प्रदापयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2094397, "chapter_id": 3016, "verse_number": "१३-१४६-४४", "content_sanskrit": "ततोऽन्यां मृत्तिकां गृह्य कार्यं शौचं पुनस्तयोः।\nहस्तयोरेवमेतद्धि महाशौच विधीयते।\nततोऽन्यथा न कुर्वीत विधिरेष सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2094398, "chapter_id": 3016, "verse_number": "१३-१४६-४५", "content_sanskrit": "उपस्थे मूत्रशौचं स्यादत ऊर्ध्वं विधीयते।\nअतोऽन्यथा तु यः सुर्यात्प्रायश्चित्तीयते तु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2094399, "chapter_id": 3016, "verse_number": "१३-१४६-४६", "content_sanskrit": "मलोपहतचेलस्य द्विगुणं तु विधीयते।\nसहपादमथोरुभ्यां हस्तशौचमसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2094400, "chapter_id": 3016, "verse_number": "१३-१४६-४७", "content_sanskrit": "अवधीरयमाणस्य सन्देह उपजायते।\nयथायथा विशुद्ध्येत तत्तथा तदुपक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2094401, "chapter_id": 3016, "verse_number": "१३-१४६-४८", "content_sanskrit": "सकर्दमं तु वर्षासु गृहमाविश्य सङ्कटम्।\nहस्तयोर्मृत्तिकास्तिस्रः पादयोः षट् प्रदापयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2094402, "chapter_id": 3016, "verse_number": "१३-१४६-४९", "content_sanskrit": "कामं दत्त्वा गुदे दद्यात्तिस्रः पद्भ्यां तथैव च।\nहस्तशौचं प्रकर्तव्यं मूत्रशौचविधेस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2094403, "chapter_id": 3016, "verse_number": "१३-१४६-५०", "content_sanskrit": "मूत्रशौचे तथा हस्तौ पादाभ्यां चानुपूर्वशः।\nनैष्ठिके स्थानशौचे तु महाशौचं विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2094404, "chapter_id": 3016, "verse_number": "१३-१४६-५१", "content_sanskrit": "क्षारौषराभ्यां वस्त्रस्य कुर्याच्छौचं मृदा सह।\nलेपगन्धापनयनममेध्यस्य विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2094405, "chapter_id": 3016, "verse_number": "१३-१४६-५२", "content_sanskrit": "स्नानशाट्यां मृदस्तिस्रो हस्ताभ्यां चानुपूर्वशः।\nशौचं प्रयत्नतः कृत्वा कम्पमानः समुद्धरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2094406, "chapter_id": 3016, "verse_number": "१३-१४६-५३", "content_sanskrit": "देयाश्चतस्रस्तिस्रो वा द्वे वाऽप्येकां तथाऽऽपदि।\nकालमासाद्य देशं च शौचस्य गुरुलाघवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2094407, "chapter_id": 3016, "verse_number": "१३-१४६-५४", "content_sanskrit": "विधिनाऽनेन शौचं तु नित्यं कुर्यादतन्द्रितः।\nअविप्रेक्षन्नसम्भ्रान्तः पादौ प्रक्षाल्य तत्परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2094408, "chapter_id": 3016, "verse_number": "१३-१४६-५५", "content_sanskrit": "अप्रक्षालितपादस्तु पाणिमामणिबन्धनात्।\nअधस्तादुपरिष्टाच्च ततः पाणिमुपस्पृशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2094409, "chapter_id": 3016, "verse_number": "१३-१४६-५६", "content_sanskrit": "मनोगतास्तु निश्शब्दा निश्शब्दं त्रिरपः पिबेत्।\nद्विर्मुखं परिमृज्याच्च खानि चोपस्पृशेद्बुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2094410, "chapter_id": 3016, "verse_number": "१३-१४६-५७", "content_sanskrit": "ऋग्वेदं तेन प्रीणाति प्रथमं यः पिबेदपः।\nद्वितीयं तु यजुर्वेदं तृतीयं साम एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2094411, "chapter_id": 3016, "verse_number": "१३-१४६-५८", "content_sanskrit": "मृज्यते प्रथमं तेन अथर्वा प्रीतिमाप्नुयात्।\nद्वितीयेनेतिहासं च पुराणस्मृतिदेवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2094412, "chapter_id": 3016, "verse_number": "१३-१४६-५९", "content_sanskrit": "यच्चक्षुषि समाधत्ते तेनादित्यं तु प्रीणयेत्।\nप्रीणाति वायुं घ्राणं च दिशश्चाप्यथ श्रोत्रयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2094413, "chapter_id": 3016, "verse_number": "१३-१४६-६०", "content_sanskrit": "ब्रह्माणं तेन प्रीणाति यन्मूर्धनि समापयेत्।\nसमुत्क्षिपति चापोर्ध्वमाकाशं तेन प्रीणयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2094414, "chapter_id": 3016, "verse_number": "१३-१४६-६१", "content_sanskrit": "प्रीणाति विष्णुः पद्भ्यां तु सलिलं वै समादधत्॥\nप्राङ्मुखोदङ्मुखो वाऽपि अन्तर्जानुरुपस्पृशेत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2094415, "chapter_id": 3016, "verse_number": "१३-१४६-६२", "content_sanskrit": "सर्वत्र विधिरित्येष भोजनादिषु नित्यशः॥\nअन्नेषु दन्तलग्नेषु उच्छिष्टः पुनराचमेत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2094416, "chapter_id": 3016, "verse_number": "१३-१४६-६३", "content_sanskrit": "विधिरेष समुद्दिष्टः शौचे चाभ्युक्षणं स्मृतम्॥\nशूद्रस्यैव विधिर्दृष्टो गृहान्निष्क्रमतस्ततः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2094417, "chapter_id": 3016, "verse_number": "१३-१४६-६४", "content_sanskrit": "नित्यं त्वलुप्तशौचेन वर्तितव्यं कृतात्मना।\nयशस्कामेन भिक्षुभ्यः शुद्रेणात्महितार्थिना॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2094418, "chapter_id": 3016, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षट्चत्वारिंशदधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]