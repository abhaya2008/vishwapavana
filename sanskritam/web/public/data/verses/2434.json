[{"id": 2068358, "chapter_id": 2434, "verse_number": "९-५२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2068359, "chapter_id": 2434, "verse_number": "९-५२-१", "content_sanskrit": "यत्रेजिवानुडुपती राजसूयेन भारत।\nयस्मिन्वृत्ते महानासीत्सङ्ग्रामस्तारकामयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2068360, "chapter_id": 2434, "verse_number": "९-५२-२", "content_sanskrit": "तत्राप्युपस्पृश्य बलो दत्त्वा दानानि चात्मवान्।\nसारस्वतस्य धर्मात्मा मुनेस्तीर्थं जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2068361, "chapter_id": 2434, "verse_number": "९-५२-३", "content_sanskrit": "यत्र द्वादशवार्षिक्यामनावृष्ट्यां द्विजोत्तमान्।\nवेदानध्यापयामास पुरा सारस्वतो मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2068362, "chapter_id": 2434, "verse_number": "९-५२-४x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2068363, "chapter_id": 2434, "verse_number": "९-५२-४", "content_sanskrit": "कथं द्वादशवार्षिक्यामनावृष्ट्यां द्विजोत्तमान्।\nवेदानध्यापयामास पुरा सारस्वतो मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2068364, "chapter_id": 2434, "verse_number": "९-५२-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2068365, "chapter_id": 2434, "verse_number": "९-५२-५", "content_sanskrit": "आसीत्पूर्वं महाराज मुनिर्धीमान्महातपाः।\nदधीचिरिति विख्यातो ब्रह्मचारी जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2068366, "chapter_id": 2434, "verse_number": "९-५२-६", "content_sanskrit": "तस्यातितपसः शक्रो बिभेति सततं विभो।\nन स लोभयितुं शक्यः फलैर्बहुविधैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2068367, "chapter_id": 2434, "verse_number": "९-५२-७", "content_sanskrit": "प्रलोभनार्थं तस्याथ प्राहिणोत्पाकशासनः।\nदिव्यामप्सरसं पुण्यां दर्शनीयामलम्बुसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2068368, "chapter_id": 2434, "verse_number": "९-५२-८", "content_sanskrit": "तस्य तर्पयतो देवान्सरस्वत्यां महात्मनः।\nसमीपतो महाराज सोपातिष्ठत भामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2068369, "chapter_id": 2434, "verse_number": "९-५२-९", "content_sanskrit": "तां दिव्यवपुषं दृष्ट्वा तस्यर्षेर्भावितात्मनः।\nरेतः स्कन्नं सरस्वत्यां तस्मा जग्राह निम्नगा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2068370, "chapter_id": 2434, "verse_number": "९-५२-१०", "content_sanskrit": "कुक्षौ चाप्यदधद्वृष्टा तद्रेतः पुरुषर्षभ।\nसा दधार च तं गर्भं पुत्रहेतोर्महात्मनः॥थ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2068371, "chapter_id": 2434, "verse_number": "९-५२-११", "content_sanskrit": "सुषुवे चापि समये पुत्रं सारस्वतं वरम्।\nजगाम पुत्रमादाय तमृषिं प्रति च प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2068372, "chapter_id": 2434, "verse_number": "९-५२-१२", "content_sanskrit": "ऋषिसंसदि तं दृष्ट्वा सा नदी मुनिसत्तमम्।\nततः प्रोवाच राजेन्द्र ददती पुत्रमस्य तम्।\nब्रह्मर्षे तव पुत्रोऽयं त्वद्भक्त्या धारितो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2068373, "chapter_id": 2434, "verse_number": "९-५२-१३", "content_sanskrit": "दृष्ट्वा तेऽप्सरसं रेतो यत्स्कन्नं प्रागलम्बुसाम्।\nतत्कुक्षिणाऽहं ब्रह्मर्षे त्वद्भक्त्या धृतवत्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2068374, "chapter_id": 2434, "verse_number": "९-५२-१४", "content_sanskrit": "न विनाशमिदं गच्छेत्त्वत्तेज इति निश्चयात्।\nप्रतिगृह्णीष्व पुत्रं स्वं मया दत्तमनिन्दितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2068375, "chapter_id": 2434, "verse_number": "९-५२-१५", "content_sanskrit": "इत्युक्तः प्रतिजग्राह प्रीतिं चावाप पुष्कलाम्।\nपितृवच्चोपजिघ्रत्तं मूर्ध्नि प्रेम्णा द्विजोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2068376, "chapter_id": 2434, "verse_number": "९-५२-१६", "content_sanskrit": "परिष्वज्य चिरं कालं तदा भरतसत्तम।\nसरस्वत्यै वरं प्रादात्प्रीयमाणो महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2068377, "chapter_id": 2434, "verse_number": "९-५२-१७", "content_sanskrit": "विश्वेदेवाः सपितरो गन्धर्वाप्सरसां गणाः।\nतृप्तिं यास्यन्ति सुभगे तर्प्यमाणास्तवाम्भसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2068378, "chapter_id": 2434, "verse_number": "९-५२-१८", "content_sanskrit": "इत्युक्त्वा स तु तुष्टाव वचोभिर्वै महानदीम्।\nप्रीतः परमहृष्टात्मा यथावच्छृणु पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2068379, "chapter_id": 2434, "verse_number": "९-५२-१९x", "content_sanskrit": "दधीचिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2068380, "chapter_id": 2434, "verse_number": "९-५२-१९", "content_sanskrit": "प्रस्रुताऽसि महाभागे सरसो ब्रह्मणः पुरा।\nजानन्ति त्वां सरिच्छ्रेष्ठे मुनयः संशितव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2068381, "chapter_id": 2434, "verse_number": "९-५२-२०", "content_sanskrit": "मम प्रियकरी चापि सततं प्रियदर्शने।\nतस्मात्सारस्वतं पुत्रमदधा वरवर्णिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2068382, "chapter_id": 2434, "verse_number": "९-५२-२१", "content_sanskrit": "तवैव नाम्ना प्रथितः पुत्रस्ते लोकभावनः।\nसारस्वत इति ख्यातो भविष्यति महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2068383, "chapter_id": 2434, "verse_number": "९-५२-२२", "content_sanskrit": "एष द्वादशवार्षिक्यामनावृष्ट्यां द्विजर्षभान्।\nसारस्वतो महाभागे वेदानध्यापयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2068384, "chapter_id": 2434, "verse_number": "९-५२-२३", "content_sanskrit": "पुण्याभ्यश्च सरिद्भ्यस्त्वं सदा पुण्यतमा शुभे।\nभविष्यसि महाभागे मत्प्रसादात्सरस्वति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2068385, "chapter_id": 2434, "verse_number": "९-५२-२४", "content_sanskrit": "एवं स्त संस्तुता तेन वरं लब्ध्वा महानदी।\nपुत्रमादाय मुदिता जगाम भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2068386, "chapter_id": 2434, "verse_number": "९-५२-२५", "content_sanskrit": "एतस्मिन्नेव काले तु विरोधे देवदानवैः।\nशक्रः प्रहरणान्विषी लोकांस्त्रीन्विचचार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2068387, "chapter_id": 2434, "verse_number": "९-५२-२६", "content_sanskrit": "न चोपलेभे भगवाञ्शक्रः प्रहरणं तदा।\nयद्वै तेषां भवेद्योग्यं वधाय विबुधद्विषाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2068388, "chapter_id": 2434, "verse_number": "९-५२-२७", "content_sanskrit": "ततोऽब्रवीत्सुराञ्शक्रो न मे शक्याः सुरारयः।\nऋतेऽस्थिभिर्दधीचस्य निहन्तुं त्रिदशद्विषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2068389, "chapter_id": 2434, "verse_number": "९-५२-२८", "content_sanskrit": "तस्माद्यत्नादृषिश्रेष्ठो याच्यतां कार्यसिद्धये।\nदधीचास्थीनि देहीति तैर्वधिष्यामहे रिपून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2068390, "chapter_id": 2434, "verse_number": "९-५२-२९", "content_sanskrit": "स च तैर्याचितोऽस्थीनि यत्नादृषिवरस्तदा।\nसाहाय्यं नः कुरुष्वेति चकारैवाविचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2068391, "chapter_id": 2434, "verse_number": "९-५२-३०", "content_sanskrit": "स लोकानक्षयान्प्राप्तो देवप्रियकरस्तदा।\nतस्यास्थिभिरथो शक्रः सम्प्रहृष्टमनास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2068392, "chapter_id": 2434, "verse_number": "९-५२-३१", "content_sanskrit": "कारयामास दिव्यानि नानाप्रहरणान्युत।\nगदा वज्राणि चक्राणि गुरून्दण्डांश्च पुष्कलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2068393, "chapter_id": 2434, "verse_number": "९-५२-३२", "content_sanskrit": "स हि तीव्रेण तपसा सम्भृतः परमर्षिणा।\nप्रजापतिसुतेनाथ भृगुणा लोकभावनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2068394, "chapter_id": 2434, "verse_number": "९-५२-३३", "content_sanskrit": "अतिकायः स तेजस्वी लोकसारो विनिर्मितः।\nजज्ञे शैलगुरुः प्रांशुर्महिम्ना प्रथितः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2068395, "chapter_id": 2434, "verse_number": "९-५२-३४", "content_sanskrit": "नित्यमुद्विजते चास्य तेजसः पाकशासनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2068396, "chapter_id": 2434, "verse_number": "९-५२-३५", "content_sanskrit": "तेन वज्रेण भगवान्मन्त्रयुक्तेन भारत।\nभृशं क्रोधविसृष्टेन ब्रह्मतेजोद्भवेन च।\nदैत्यदानववीराणां जघान नवतीर्नव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2068397, "chapter_id": 2434, "verse_number": "९-५२-३६", "content_sanskrit": "अथ काले व्यतिक्रान्ते महत्यतिभयङ्करी।\nअनावृष्टिरनुप्राप्ता राजन्द्वादशवार्षिकी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2068398, "chapter_id": 2434, "verse_number": "९-५२-३७", "content_sanskrit": "तस्यां द्वादशवार्षिक्यामनावृष्ट्यां महर्षयः।\nवृत्त्यर्थं प्राद्रवन्राजन्क्षुधार्ताः सर्वतोदिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2068399, "chapter_id": 2434, "verse_number": "९-५२-३८", "content_sanskrit": "दिग्भ्यस्तान्प्रद्रुतान्दृष्ट्वा मुनिः सारस्वतस्तदा।\nगमनाय मतिं चक्रे तं प्रोवाच सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2068400, "chapter_id": 2434, "verse_number": "९-५२-३९", "content_sanskrit": "न गन्तव्यमितः पुत्र तवाहारमहं सदा।\nदास्यामि मत्स्यप्रवरानुष्यतामिह भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2068401, "chapter_id": 2434, "verse_number": "९-५२-४०", "content_sanskrit": "इत्युक्तस्तर्पयामास स पितॄन्देवतास्तथा।\nआहारमकरोन्नित्यं प्राणान्वेदांश्च धारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2068402, "chapter_id": 2434, "verse_number": "९-५२-४१", "content_sanskrit": "अथ तस्यामनावृष्ट्यामतीतायां महर्षयः।\nअन्योन्यं परिपप्रच्छुः पुनः स्वाध्यायकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2068403, "chapter_id": 2434, "verse_number": "९-५२-४२", "content_sanskrit": "तेषां क्षुधापरीतानां नष्टा देवा विधावताम्।\nसर्वेषामेव राजेन्द्र न किचित्प्रतिभाति ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2068404, "chapter_id": 2434, "verse_number": "९-५२-४३", "content_sanskrit": "अथ कश्चिदृषिस्तेषां सारस्वतमुपेयिवान्।\nकुर्वाणं संशितात्मानं स्वाध्यायमृषिसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2068405, "chapter_id": 2434, "verse_number": "९-५२-४४", "content_sanskrit": "स गत्वाऽचष्ट तेभ्यश्च सारस्वतमृषिं प्रभुम्।\nस्वाध्यायममरप्रख्यं कुर्वाणं विजने वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2068406, "chapter_id": 2434, "verse_number": "९-५२-४५", "content_sanskrit": "ततः सर्वे समाजग्मुस्तत्र राजन्महर्षयः।\nसारस्वतं मुनिश्रेष्ठमिदमूचुः समागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2068407, "chapter_id": 2434, "verse_number": "९-५२-४६", "content_sanskrit": "अस्मानध्यापयस्वेति तानुवाच ततो मुनिः।\nशिष्यत्वमुपागच्छध्वं विधिना च ममेत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2068408, "chapter_id": 2434, "verse_number": "९-५२-४७", "content_sanskrit": "तत्राब्रुवन्मुनिगणा बालस्त्वमसि पुत्रक।\nस तानाह न मे धर्मो नश्येदिति पुनर्मुनीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2068409, "chapter_id": 2434, "verse_number": "९-५२-४८", "content_sanskrit": "यो ह्यधर्मेण वै ब्रूयाद्गृह्णीयाद्योऽप्यधर्मतः।\nम्रियेतां तावुभौ क्षिप्रं स्यातां वा वैरिणावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2068410, "chapter_id": 2434, "verse_number": "९-५२-४९", "content_sanskrit": "न हायनैर्न पलितैर्न वित्तेन न बन्धुभिः।\nऋषयश्चक्रिरे धर्मं योऽनूचानः स नो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2068411, "chapter_id": 2434, "verse_number": "९-५२-५०", "content_sanskrit": "एतच्छ्रुत्वा वचस्तस्य मनुयस्ते विधानतः।\nतस्माद्वेदाननुप्राप्य पुनर्धर्मं प्रचक्रिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2068412, "chapter_id": 2434, "verse_number": "९-५२-५१", "content_sanskrit": "षष्टिर्मुनिसहस्राणि शिष्यत्वं प्रतिपेदिरे।\nसारस्वतस्य विप्रर्षेर्वेदस्वाध्यायकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2068413, "chapter_id": 2434, "verse_number": "९-५२-५२", "content_sanskrit": "मुष्टिं मुष्टिं ततः सर्वे दर्भाणां ते ह्युपाहरन्।\nतस्यासनार्थं विप्रर्षेर्बालस्यापि वशे स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2068414, "chapter_id": 2434, "verse_number": "९-५२-५३", "content_sanskrit": "तत्रापि दत्त्वा वसु रौहिणेयो\nमहाबलः केशवपूर्वजोऽथ\nजगाम तीर्थं मुदितः क्रमेण\nतं वृद्धकन्याश्रममे व वीरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2068415, "chapter_id": 2434, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि द्विपञ्चाशत्तमोऽध्यायः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]