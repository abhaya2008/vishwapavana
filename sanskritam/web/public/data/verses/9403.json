[{"id": 40022651, "chapter_id": 9403, "verse_number": "1", "content_sanskrit": "तथोक्तवति रामे तु भरते च महात्मनि । लक्ष्मणो ऽथ शुभं वाक्यमुवाच रघुनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022652, "chapter_id": 9403, "verse_number": "2", "content_sanskrit": "अश्वमेधो महायज्ञः पावनः सर्वपाप्मनाम् । पावनस्तव दुर्धर्षो रोचतां रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022653, "chapter_id": 9403, "verse_number": "3", "content_sanskrit": "श्रूयते हि पुरावृत्तं वासवे सुमहात्मनि । ब्रह्महत्यावृतः शक्रो हयमेधेन पावितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022654, "chapter_id": 9403, "verse_number": "4", "content_sanskrit": "पुरा किल महाबाहो देवासुरसमागमे । वृत्रो नाम महानासीद्दैतेयो लोकसम्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022655, "chapter_id": 9403, "verse_number": "5", "content_sanskrit": "विस्तीर्णो योजनशतमुच्छ्रितस्त्रिगुणं ततः । अनुरागेण लोकांस्त्रीन्स्नेहात्पश्यति सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022656, "chapter_id": 9403, "verse_number": "6", "content_sanskrit": "धर्मज्ञश्च कृतज्ञश्च बुद्ध्या च परिनिष्ठितः । शशास पृथिवीं स्फीतां धर्मेण सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022657, "chapter_id": 9403, "verse_number": "7", "content_sanskrit": "तस्मिन्प्रशासति तदा सर्वकामदुघा मही । रसवन्ति प्रभूनानि मूलानि च फलानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022658, "chapter_id": 9403, "verse_number": "8", "content_sanskrit": "अकृष्टपच्या पृथिवी सुसम्पन्ना महात्मनः । स राज्यं तादृशं भुङ्क्ते स्फीतमद्भुतदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022659, "chapter_id": 9403, "verse_number": "9", "content_sanskrit": "तस्य बुद्धिः समुप्तन्ना तपः कुर्यामनुत्तमम् । तपो हि परमं श्रेयः सम्मोहमितरत्सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022660, "chapter_id": 9403, "verse_number": "10", "content_sanskrit": "स निक्षिप्य सुतं ज्येष्ठं पौरेषु मधुरेश्वरम् । तप उग्रं समातिष्ठत्तापयन्सर्वदेवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022661, "chapter_id": 9403, "verse_number": "11", "content_sanskrit": "तपस्तप्यति वृत्रे तु वासवः परमार्तवत् । विष्णुं समुपसङ्क्रम्य वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022662, "chapter_id": 9403, "verse_number": "12", "content_sanskrit": "तपस्यता महाबाहो लोकाः वृत्रेण निर्जिताः । बलवान्स हि धर्मात्मा नैनं शक्ष्यामि शासितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022663, "chapter_id": 9403, "verse_number": "13", "content_sanskrit": "यद्यसौ तप आतिष्ठेद्भूय एवासुरेश्वर । यावल्लोका धरिष्यन्ति तावदस्य वशानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022664, "chapter_id": 9403, "verse_number": "14", "content_sanskrit": "तं चैनं परमोदारमुपेक्षसि महाबलम् । क्षणं हि न भवेद्वृत्रः क्रुद्धे त्वयि सुरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022665, "chapter_id": 9403, "verse_number": "15", "content_sanskrit": "यदा हि प्रीतिसंयोगं त्वया विष्णो समागतः । तदाप्रभृति लोकानां नाथत्वमुपलब्धवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022666, "chapter_id": 9403, "verse_number": "16", "content_sanskrit": "स त्वं प्रसादं लोकानां कुरुष्व सुसमाहितः । त्वत्कृतेन हि सर्वं स्याप्रशान्तमरुजं जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022667, "chapter_id": 9403, "verse_number": "17", "content_sanskrit": "इमे हि सर्वे विष्णो त्वां निरीक्षन्ते दिवौकसः । वृत्रघातेन महता तेषां साह्यं कुरुष्व ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022668, "chapter_id": 9403, "verse_number": "18", "content_sanskrit": "त्वया हि नित्यशः साह्यं कृतमेषां महात्मनाम् । असह्यमिदमन्येषामगतीनां गतिर्भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]