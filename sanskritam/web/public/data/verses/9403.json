[{"id": 5000403000, "chapter_id": 9403, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे चतुःषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000403001, "chapter_id": 9403, "verse_number": "५-६४-१", "content_sanskrit": "सुग्रीवेणैवमुक्तस्तु हृष्टो दधिमुखः कपिः।\nराघवं लक्ष्मणं चैव सुग्रीवं चाभ्यवादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000403002, "chapter_id": 9403, "verse_number": "५-६४-२", "content_sanskrit": "स प्रणम्य च सुग्रीवं राघवौ च महाबलौ।\nवानरैः सहितः शूरैर्दिवमेवोत्पपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000403003, "chapter_id": 9403, "verse_number": "५-६४-३", "content_sanskrit": "स यथैवागतः पूर्वं तथैव त्वरितं गतः।\nनिपत्य गगनाद् भूमौ तद् वनं प्रविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000403004, "chapter_id": 9403, "verse_number": "५-६४-४", "content_sanskrit": "स प्रविष्टो मधुवनं ददर्श हरियूथपान्।\nविमदानुद्धतान् सर्वान् मेहमानान् मधूदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000403005, "chapter_id": 9403, "verse_number": "५-६४-५", "content_sanskrit": "स तानुपागमद् वीरो बद्‍ध्वा करपुटाञ्जलिम्।\nउवाच वचनं श्लक्ष्णमिदं हृष्टवदङ्गदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000403006, "chapter_id": 9403, "verse_number": "५-६४-६", "content_sanskrit": "सौम्य रोषो न कर्तव्यो यदेभिः परिवारणम्।\nअज्ञानाद् रक्षिभिः क्रोधाद् भवन्तः प्रतिषेधिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000403007, "chapter_id": 9403, "verse_number": "५-६४-७", "content_sanskrit": "श्रान्तो दूरादनुप्राप्तो भक्षयस्व स्वकं मधु।\nयुवराजस्त्वमीशश्च वनस्यास्य महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000403008, "chapter_id": 9403, "verse_number": "५-६४-८", "content_sanskrit": "मौर्ख्यात् पूर्वं कृतो रोषस्तद् भवान् क्षन्तुमर्हति।\nयथैव हि पिता तेऽभूत् पूर्वं हरिगणेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000403009, "chapter_id": 9403, "verse_number": "५-६४-९", "content_sanskrit": "तथा त्वमपि सुग्रीवो नान्यस्तु हरिसत्तम।\nआख्यातं हि मया गत्वा पितृव्यस्य तवानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000403010, "chapter_id": 9403, "verse_number": "५-६४-१०", "content_sanskrit": "इहोपयानं सर्वेषामेतेषां वनचारिणाम्।\nभवदागमनं श्रुत्वा सहैभिर्वनचारिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000403011, "chapter_id": 9403, "verse_number": "५-६४-११", "content_sanskrit": "प्रहृष्टो न तु रुष्टोऽसौ वनं श्रुत्वा प्रधर्षितम्।\nप्रहृष्टो मां पितृव्यस्ते सुग्रीवो वानरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000403012, "chapter_id": 9403, "verse_number": "५-६४-१२", "content_sanskrit": "शीघ्रं प्रेषय सर्वांस्तानिति होवाच पार्थिवः।\nश्रुत्वा दधिमुखस्यैतद् वचनं श्लक्ष्णमङ्गदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000403013, "chapter_id": 9403, "verse_number": "५-६४-१३", "content_sanskrit": "अब्रवीत् तान् हरिश्रेष्ठो वाक्यं वाक्यविशारदः।\nशङ्के श्रुतोऽयं वृत्तान्तो रामेण हरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000403014, "chapter_id": 9403, "verse_number": "५-६४-१४", "content_sanskrit": "अयं च हर्षादाख्याति तेन जानामि हेतुना।\nतत् क्षमं नेह नः स्थातुं कृते कार्ये परंतपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000403015, "chapter_id": 9403, "verse_number": "५-६४-१५", "content_sanskrit": "पीत्वा मधु यथाकामं विक्रान्ता वनचारिणः।\nकिं शेषं गमनं तत्र सुग्रीवो यत्र वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000403016, "chapter_id": 9403, "verse_number": "५-६४-१६", "content_sanskrit": "सर्वे यथा मां वक्ष्यन्ति समेत्य हरिपुङ्गवाः।\nतथास्मि कर्ता कर्तव्ये भवद्भिः परवानहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000403017, "chapter_id": 9403, "verse_number": "५-६४-१७", "content_sanskrit": "नाज्ञापयितुमीशोऽहं युवराजोऽस्मि यद्यपि।\nअयुक्तं कृतकर्माणो यूयं धर्षयितुं बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000403018, "chapter_id": 9403, "verse_number": "५-६४-१८", "content_sanskrit": "ब्रुवतश्चाङ्गदस्यैवं श्रुत्वा वचनमुत्तमम्।\nप्रहृष्टमनसो वाक्यमिदमूचुर्वनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000403019, "chapter_id": 9403, "verse_number": "५-६४-१९", "content_sanskrit": "एवं वक्ष्यति को राजन् प्रभुः सन् वानरर्षभ।\nऐश्वर्यमदमत्तो हि सर्वोऽहमिति मन्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000403020, "chapter_id": 9403, "verse_number": "५-६४-२०", "content_sanskrit": "तव चेदं सुसदृशं वाक्यं नान्यस्य कस्यचित्।\nसन्नतिर्हि तवाख्याति भविष्यच्छुभयोग्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000403021, "chapter_id": 9403, "verse_number": "५-६४-२१", "content_sanskrit": "सर्वे वयमपि प्राप्तास्तत्र गन्तुं कृतक्षणाः।\nस यत्र हरिवीराणां सुग्रीवः पतिरव्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000403022, "chapter_id": 9403, "verse_number": "५-६४-२२", "content_sanskrit": "त्वया ह्यनुक्तैर्हरिभिर्नैव शक्यं पदात् पदम्।\nक्वचिद् गन्तुं हरिश्रेष्ठ ब्रूमः सत्यमिदं तु ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000403023, "chapter_id": 9403, "verse_number": "५-६४-२३", "content_sanskrit": "एवं तु वदतां तेषामङ्गदः प्रत्यभाषत।\nसाधु गच्छाम इत्युक्त्वा खमुत्पेतुर्महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000403024, "chapter_id": 9403, "verse_number": "५-६४-२४", "content_sanskrit": "उत्पतन्तमनूत्पेतुः सर्वे ते हरियूथपाः।\nकृत्वाऽऽकाशं निराकाशं यन्त्रोत्क्षिप्ता इवोपलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000403025, "chapter_id": 9403, "verse_number": "५-६४-२५", "content_sanskrit": "अङ्गदं पुरतः कृत्वा हनूमन्तं च वानरम्।\nतेऽम्बरं सहसोत्पत्य वेगवन्तः प्लवङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000403026, "chapter_id": 9403, "verse_number": "५-६४-२६", "content_sanskrit": "विनदन्तो महानादं घना वातेरिता यथा।\nअङ्गदे समनुप्राप्ते सुग्रीवो वानरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000403027, "chapter_id": 9403, "verse_number": "५-६४-२७", "content_sanskrit": "उवाच शोकसंतप्तं रामं कमललोचनम्।\nसमाश्वसिहि भद्रं ते दृष्टा देवी न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000403028, "chapter_id": 9403, "verse_number": "५-६४-२८", "content_sanskrit": "नागन्तुमिह शक्यं तैरतीतसमयैरिह।\nअङ्गदस्य प्रहर्षाच्च जानामि शुभदर्शन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000403029, "chapter_id": 9403, "verse_number": "५-६४-२९", "content_sanskrit": "न मत्सकाशमागच्छेत् कृत्ये हि विनिपातिते।\nयुवराजो महाबाहुः प्लवतामङ्गदो वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000403030, "chapter_id": 9403, "verse_number": "५-६४-३०", "content_sanskrit": "यद्यप्यकृतकृत्यानामीदृशः स्यादुपक्रमः।\nभवेत् तु दीनवदनो भ्रान्तविप्लुतमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000403031, "chapter_id": 9403, "verse_number": "५-६४-३१", "content_sanskrit": "पितृपैतामहं चैतत् पूर्वकैरभिरक्षितम्।\nन मे मधुवनं हन्याददृष्ट्वा जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000403032, "chapter_id": 9403, "verse_number": "५-६४-३२", "content_sanskrit": "कौसल्या सुप्रजा राम समाश्वसिहि सुव्रत।\nदृष्टा देवी न संदेहो न चान्येन हनूमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000403033, "chapter_id": 9403, "verse_number": "५-६४-३३", "content_sanskrit": "नह्यन्यः कर्मणो हेतुः साधनेऽस्य हनूमतः।\nहनूमतीह सिद्धिश्च मतिश्च मतिसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000403034, "chapter_id": 9403, "verse_number": "५-६४-३४", "content_sanskrit": "व्यवसायश्च शौर्यं च श्रुतं चापि प्रतिष्ठितम्।\nजाम्बवान् यत्र नेता स्यादङ्गदश्च हरीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000403035, "chapter_id": 9403, "verse_number": "५-६४-३५", "content_sanskrit": "हनूमांश्चाप्यधिष्ठाता न तत्र गतिरन्यथा।\nमा भूश्चिन्तासमायुक्तः सम्प्रत्यमितविक्रम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000403036, "chapter_id": 9403, "verse_number": "५-६४-३६", "content_sanskrit": "यदा हि दर्पितोदग्राः संगताः काननौकसः।\nनैषामकृतकार्याणामीदृशः स्यादुपक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000403037, "chapter_id": 9403, "verse_number": "५-६४-३७", "content_sanskrit": "वनभङ्गेन जानामि मधूनां भक्षणेन च।\nततः किलकिलाशब्दं शुश्रावासन्नमम्बरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000403038, "chapter_id": 9403, "verse_number": "५-६४-३८", "content_sanskrit": "हनूमत्कर्मदृप्तानां नदतां काननौकसाम्।\nकिष्किन्धामुपयातानां सिद्धिं कथयतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000403039, "chapter_id": 9403, "verse_number": "५-६४-३९", "content_sanskrit": "ततः श्रुत्वा निनादं तं कपीनां कपिसत्तमः।\nआयताञ्चितलाङ्गूलः सोऽभवद्हृष्टमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000403040, "chapter_id": 9403, "verse_number": "५-६४-४०", "content_sanskrit": "आजग्मुस्तेऽपि हरयो रामदर्शनकाङ्क्षिणः।\nअङ्गदं पुरतः कृत्वा हनूमन्तं च वानरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000403041, "chapter_id": 9403, "verse_number": "५-६४-४१", "content_sanskrit": "तेऽङ्गदप्रमुखा वीराः प्रहृष्टाश्च मुदान्विताः।\nनिपेतुर्हरिराजस्य समीपे राघवस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000403042, "chapter_id": 9403, "verse_number": "५-६४-४२", "content_sanskrit": "हनूमांश्च महाबाहुः प्रणम्य शिरसा ततः।\nनियतामक्षतां देवीं राघवाय न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000403043, "chapter_id": 9403, "verse_number": "५-६४-४३", "content_sanskrit": "दृष्टा देवीति हनुमद्वदनादमृतोपमम्।\nआकर्ण्य वचनं रामो हर्षमाप सलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000403044, "chapter_id": 9403, "verse_number": "५-६४-४४", "content_sanskrit": "निश्चितार्थं ततस्तस्मिन् सुग्रीवं पवनात्मजे।\nलक्ष्मणः प्रीतिमान् प्रीतं बहुमानादवैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000403045, "chapter_id": 9403, "verse_number": "५-६४-४५", "content_sanskrit": "प्रीत्या च परयोपेतो राघवः परवीरहा।\nबहुमानेन महता हनूमन्तमवैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000403046, "chapter_id": 9403, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे चतुःषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]