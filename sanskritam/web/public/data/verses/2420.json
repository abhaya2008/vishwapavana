[{"id": 2067512, "chapter_id": 2420, "verse_number": "९-३८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2067513, "chapter_id": 2420, "verse_number": "९-३८-१", "content_sanskrit": "ततो विनशनं राजन्नाजगाम हलायुधः।\nशूद्राभीरान्प्रति द्वेषाद्यत्र नष्टा सरस्वती।\nतस्मात्तामृषयो नित्यं प्राहुर्विनशनेति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2067514, "chapter_id": 2420, "verse_number": "९-३८-२", "content_sanskrit": "तत्राप्युपस्पृश्य बलः सरस्वत्यां महाबलः।\nसुभूमिकं ततोऽगच्छत्सरस्वत्यास्तटे वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2067515, "chapter_id": 2420, "verse_number": "९-३८-३", "content_sanskrit": "तत्र चाप्सरसः शुभ्रा नित्यकालमतन्द्रिताः।\nक्रीडाभिर्विमलाभिश्च क्रीडन्ति विमलाननाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2067516, "chapter_id": 2420, "verse_number": "९-३८-४", "content_sanskrit": "तत्र देवाः सगन्धर्वा मासिमासि जनेश्वर।\nअभिगच्छन्ति तत्तीर्थं पुण्यं ब्राह्मणसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2067517, "chapter_id": 2420, "verse_number": "९-३८-५", "content_sanskrit": "तत्र नृत्यन्ति गन्धर्वास्तथैवाप्सरसां गणाः।\nसमेत्य सहिता राजन्यथाप्राप्तं यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2067518, "chapter_id": 2420, "verse_number": "९-३८-६", "content_sanskrit": "तत्र मोदन्ति देवाश्च पितरश्च सवीरुधः।\nपुण्यैः पुष्पैः सदा दिव्यैः कीर्यमाणाः पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2067519, "chapter_id": 2420, "verse_number": "९-३८-७", "content_sanskrit": "आक्रीडभूमिः सा राजंस्तासामप्सरसां शुभा।\nसुभूमिकेति विख्याता सरस्वत्यास्तटे वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2067520, "chapter_id": 2420, "verse_number": "९-३८-८", "content_sanskrit": "तत्र स्नात्वा च दत्त्वा च वसु विप्रेषु माधवः।\nश्रुत्वा गीतं च तद्दिव्यं वादित्राणां च निःस्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2067521, "chapter_id": 2420, "verse_number": "९-३८-९", "content_sanskrit": "शय्याश्च विपुला दृष्ट्वा देवगन्धर्वरक्षसाम्।\nगन्धर्वाणां ततस्तीर्थमागच्छद्रोहिणीसुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2067522, "chapter_id": 2420, "verse_number": "९-३८-१०", "content_sanskrit": "विश्वावसुमुखास्तत्र गन्धर्वाप्सरसां गणाः।\nनृत्तवादित्रगीतं च कुर्न्वति सुमनोरमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2067523, "chapter_id": 2420, "verse_number": "९-३८-११", "content_sanskrit": "तत्र दत्त्वा हलधरो विप्रेभ्यो विविधं वसु।\nअजाविकं गोखरोष्ट्रं सुवर्णं रजतं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2067524, "chapter_id": 2420, "verse_number": "९-३८-१२", "content_sanskrit": "भोजयित्वा द्विजान्कामैः सन्तर्प्य च महाधनैः।\nप्रययौ सहितो विप्रैः स्तूयमानश्च माधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2067525, "chapter_id": 2420, "verse_number": "९-३८-१३", "content_sanskrit": "तस्माद्गन्धर्वतीर्थाच्च महाबाहुररिन्दमः।\nगर्गस्रोतो महातीर्थमाजगामैककुण्डली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2067526, "chapter_id": 2420, "verse_number": "९-३८-१४", "content_sanskrit": "तत्र गर्गेण वृद्धेन तपसा भावितात्मना।\nकालज्ञानगतिश्चैव ज्योतिषां च व्यतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2067527, "chapter_id": 2420, "verse_number": "९-३८-१५", "content_sanskrit": "उत्पाता दारुणाश्चैक शुभाश्च जनमेजय।\nसरस्वत्याः शुभे तीर्थे विदिता वै महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2067528, "chapter_id": 2420, "verse_number": "९-३८-१६", "content_sanskrit": "तस्य नाम्ना च तत्तीर्थं गर्गस्रोत इति स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2067529, "chapter_id": 2420, "verse_number": "९-३८-१७", "content_sanskrit": "तत्र गर्गं महाभागमृषयः सुव्रता नृप।\nउपासाञ्चक्रिरे नित्यं कालज्ञानं प्रति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2067530, "chapter_id": 2420, "verse_number": "९-३८-१८", "content_sanskrit": "तत्र गत्वा महाराज बलः श्वेतानुलेपनः।\nविधिवद्वि धनं दत्त्वा मुनीनां भावितात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2067531, "chapter_id": 2420, "verse_number": "९-३८-१९", "content_sanskrit": "उच्चावचांस्तथा भक्ष्यान्विप्रेभ्यो विप्रदाय सः।\nनीलवासास्तदाऽगच्छच्छङ्घतीर्थं महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2067532, "chapter_id": 2420, "verse_number": "९-३८-२०", "content_sanskrit": "तत्रापश्यन्महाशङ्खं महामेरुमिवोच्छ्रितम्।\nश्वेतपर्वतसङ्काशमृषिसङ्घैर्निषेवितम्।\nसरस्वत्यास्तटे जातं नगं तालध्वजो बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2067533, "chapter_id": 2420, "verse_number": "९-३८-२१", "content_sanskrit": "यक्षा विद्याधराश्चैव राक्षसाश्चामितौजसः।\nपिशाचाश्चामितबला यत्र सिद्धाः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2067534, "chapter_id": 2420, "verse_number": "९-३८-२२", "content_sanskrit": "ते सर्वे ह्यशनं त्यक्त्वा फलं तस्य वनस्पतेः।\nव्रतैश्च नियमैश्चैव कालेकाले स्म भुञ्जते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2067535, "chapter_id": 2420, "verse_number": "९-३८-२३", "content_sanskrit": "प्राप्तैश्च नियमैस्तैस्तैर्विचरन्तः पृथक्पृथक्।\nअदृश्यमाना मनुजैर्व्यचरन्पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2067536, "chapter_id": 2420, "verse_number": "९-३८-२४", "content_sanskrit": "एवं ख्यातो नरव्याघ्र लोकेऽस्मिन्स वनस्पतिः।\nतत्र तीर्थं सरस्वत्याः पावनं लोकविश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2067537, "chapter_id": 2420, "verse_number": "९-३८-२५", "content_sanskrit": "तस्मिंश्च यदुशार्दूलो दत्त्वा तीर्थे पयस्विनीः।\nताम्रायसानि भाण्डानि वस्त्राणि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2067538, "chapter_id": 2420, "verse_number": "९-३८-२६", "content_sanskrit": "पूजयित्वा द्विजांश्चैव पूजितश्च तपोधनैः।\nपुण्यं नैसर्गिकं राजन्नाजगाम हलायुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2067539, "chapter_id": 2420, "verse_number": "९-३८-२७", "content_sanskrit": "तत्र गत्वा मुनीन्दृष्ट्वा नानावेषधरान्बलः।\nआप्लुत्य सलिले चापि पूजयामास वै द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2067540, "chapter_id": 2420, "verse_number": "९-३८-२८", "content_sanskrit": "तथैव दत्त्वा विप्रेभ्यः परिभोगान्सुपुष्कलान्।\nततः प्रायाद्बलो राजन्दक्षिणेन सरस्वतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2067541, "chapter_id": 2420, "verse_number": "९-३८-२९", "content_sanskrit": "गत्वा चैवं महाबाहुर्नातिदूरे महायशाः।\nधर्मात्मा नागधन्वानं तीर्थमागमदच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2067542, "chapter_id": 2420, "verse_number": "९-३८-३०", "content_sanskrit": "यत्र पन्नगराजस्य वासुकेः सन्निवेशनम्।\nमहाद्युतेर्महाराज बहुभिः पन्नगैर्वृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2067543, "chapter_id": 2420, "verse_number": "९-३८-३१", "content_sanskrit": "ऋषिणां हि सहस्राणि तत्र नित्यं चतुर्दश।\nयत्र देवाः समागम्य वासुकिं पन्नगोत्तमम्।\nसर्वपन्नगराजानमभ्यषिञ्चन्यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2067544, "chapter_id": 2420, "verse_number": "९-३८-३२", "content_sanskrit": "पन्नगेभ्यो भयं तत्र विद्यते न स्म पौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2067545, "chapter_id": 2420, "verse_number": "९-३८-३३", "content_sanskrit": "तत्रापि विधिवद्दत्वा विप्रेभ्यो रत्नसञ्चयान्।\nप्रायात्प्राचीं दिशं राजंस्तत्र तीर्थान्यनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2067546, "chapter_id": 2420, "verse_number": "९-३८-३४", "content_sanskrit": "सहस्रशतसङ्ख्यानि प्रथितानि पदेपदे।\nआप्लुत्य तत्र तीर्थेषु यथोक्तं तत्र चर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2067547, "chapter_id": 2420, "verse_number": "९-३८-३५", "content_sanskrit": "दत्त्वा वसु द्विजाग्र्येभ्यो निर्जगाम महाबलः।\nतत्रस्थानृषिसङ्घांस्तानभिवाद्य हलायुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2067548, "chapter_id": 2420, "verse_number": "९-३८-३६", "content_sanskrit": "ततो रामोऽगमत्तीर्थमृषिभिः सेक्तिं महत्।\nयत्र भूयो निववृते प्राङ्मुखा वै सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2067549, "chapter_id": 2420, "verse_number": "९-३८-३७", "content_sanskrit": "ऋषीणां नैमिषेयाणावमेक्षार्थं महात्मनाम्।\nनिवृत्तां तां सरिच्छ्रेष्ठां तत्र दृष्ट्वा तु लाङ्गली।\nवभूव विस्मितो राजन्बलः श्वेतानुलेपनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2067550, "chapter_id": 2420, "verse_number": "९-३८-३८x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2067551, "chapter_id": 2420, "verse_number": "९-३८-३८", "content_sanskrit": "कस्मात्सरस्वती ब्रह्मन्निवृत्ता कप्राङ्मुखी भवत्।\nव्याख्यातमेतदिच्छामि सर्वमध्वर्युसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2067552, "chapter_id": 2420, "verse_number": "९-३८-३९", "content_sanskrit": "कस्मिंश्चित्कारणे तत्र विस्मितो यदुनन्दनः।\nनिवृत्ता हेतुना केन कथमेव सरिद्वरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2067553, "chapter_id": 2420, "verse_number": "९-३८-४०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2067554, "chapter_id": 2420, "verse_number": "९-३८-४०", "content_sanskrit": "पूर्वं कृतयुगे राजन्नैमिषेयास्तपस्विनः।\nवर्तमाने सुविपुले सत्रे द्वादशवार्षिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2067555, "chapter_id": 2420, "verse_number": "९-३८-४१", "content_sanskrit": "ऋषयो बहवो राजंस्तत्सत्रमभिपेदिरे।\nउषित्वा च महाभागास्तस्मिन्सत्रे यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2067556, "chapter_id": 2420, "verse_number": "९-३८-४२", "content_sanskrit": "निवृत्ते नैमिषे ये वै सत्रे द्वादशवार्षिके।\nआजग्मुर्ऋषयस्तत्र बहवस्तीर्थकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2067557, "chapter_id": 2420, "verse_number": "९-३८-४३", "content_sanskrit": "ऋषीणां बहुलत्वात्तु सरस्वत्या विशाम्पते।\nतीर्थानि नगरायन्ते कूले वै दक्षिणोत्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2067558, "chapter_id": 2420, "verse_number": "९-३८-४४", "content_sanskrit": "समन्तपञ्चकं यावत्तावत्ते द्विजसत्तमाः।\nतीर्थलोभान्नरव्याघ्र नद्यास्तीरं समाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2067559, "chapter_id": 2420, "verse_number": "९-३८-४५", "content_sanskrit": "जुह्वतां तत्र तेषां तु मुनीनां भावितात्मनाम्।\nस्वाध्यायेनातिमहता बभूवुः पूरिता दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2067560, "chapter_id": 2420, "verse_number": "९-३८-४६", "content_sanskrit": "अग्निहोत्रैस्ततस्तेषां हूयमानैर्महात्मनाम्।\nअशोभत सरिच्छ्रेष्ठा दीप्यमानैः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2067561, "chapter_id": 2420, "verse_number": "९-३८-४७", "content_sanskrit": "वालखिल्या महाराज अश्मकुट्टाश्च तापसाः।\nदन्तोलूखलिनश्चान्ये सम्प्रक्षालास्तथा परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2067562, "chapter_id": 2420, "verse_number": "९-३८-४८", "content_sanskrit": "वायुभक्षा जलाहाराः पर्णभक्षाश्च तापसाः।\nनानानियमयुक्ताश्च तथा स्थण्डिलशायिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2067563, "chapter_id": 2420, "verse_number": "९-३८-४९", "content_sanskrit": "आसन्वै मुनयस्तवत्र सरस्वत्याः समीपतः।\nशोभयन्तः सरिच्छ्रेष्ठां गङ्गामिव दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2067564, "chapter_id": 2420, "verse_number": "९-३८-५०", "content_sanskrit": "शतशश्च समापेतुर्ऋषयः सत्रयाजिनः।\nतेऽवकाशं न ददृशुः सरस्वत्या महाव्रताः।\nतेऽवकाशं च ददृशुः कुरुक्षेत्रं (त्रे) महाव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2067565, "chapter_id": 2420, "verse_number": "९-३८-५१", "content_sanskrit": "ततो यज्ञोपवीतैः स्वैस्तत्र कृत्वा सरस्वतीम्।\nजुहुवुश्चाग्निहोत्रांश्च चक्रुश्च विविधाः क्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2067566, "chapter_id": 2420, "verse_number": "९-३८-५२", "content_sanskrit": "ततस्तमृपिसङ्घातं निराशं चिन्तयान्वितम्।\nदर्शयामास राजेन्द्र तेषामर्थे सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2067567, "chapter_id": 2420, "verse_number": "९-३८-५३", "content_sanskrit": "ततः कुञ्जान्बहून्कृत्वा सन्निवृत्ता सरस्वती।\nऋषीणां पुण्यतपसां कारुण्याज्जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2067568, "chapter_id": 2420, "verse_number": "९-३८-५४", "content_sanskrit": "ततो निवृत्त्य राजेन्द्र तेषामर्थे सरस्वती।\nभूयः प्रतीच्यभिमुखी प्रसुस्राव सरिद्वरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2067569, "chapter_id": 2420, "verse_number": "९-३८-५५", "content_sanskrit": "अमोघा गमनं कृत्वा तेषां भूयो जगाम ह।\nअत्यद्भुतं महच्चक्रे तदा राजन्महानदी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2067570, "chapter_id": 2420, "verse_number": "९-३८-५६", "content_sanskrit": "एवं स कुञ्जो राजन्वै नैमिषीय इति स्मृतः।\nकुरुश्रेष्ठ कुरुक्षेत्रे कुरुष्व महतीं क्रियाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2067571, "chapter_id": 2420, "verse_number": "९-३८-५७", "content_sanskrit": "तत्र कुञ्जान्बहून्दृष्ट्वा निवृत्तां च सरस्वतीम्।\nबभूव विस्मयस्तत्र रामस्याथ महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2067572, "chapter_id": 2420, "verse_number": "९-३८-५८", "content_sanskrit": "उपस्पृश्य तु तत्रापि विधिवद्यदुनन्दनः।\nदत्त्वा देयान्द्विजातिभ्यो भाण्डानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2067573, "chapter_id": 2420, "verse_number": "९-३८-५९", "content_sanskrit": "भक्ष्यं भोज्यं कच विविधं ब्राह्मणेभ्यः प्रदाय च।\nततः प्रायाद्बलो राजन्पूज्यमानो द्विजातिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2067574, "chapter_id": 2420, "verse_number": "९-३८-६०", "content_sanskrit": "सरस्वतीतीर्थवरं नानाद्विजगणायुतम्।\nबदरेङ्गुदश्यामाकाप्लुक्षाश्वत्थबिभीतकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2067575, "chapter_id": 2420, "verse_number": "९-३८-६१", "content_sanskrit": "कङ्कोलैश्च पलाश्चैश्च करीरैः पीलुभिस्तथा।\nसरस्वतीतीर्थरुहैस्तरुभिर्विविधैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2067576, "chapter_id": 2420, "verse_number": "९-३८-६२", "content_sanskrit": "करुषकवरैश्चैव बिल्वैराम्रातकैस्तथा।\nअतिमुक्तकषण्डैश्च पारिजातैश्च शोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2067577, "chapter_id": 2420, "verse_number": "९-३८-६३", "content_sanskrit": "कदलीवनभूयिष्ठं दृष्टिकान्तं मनोहरम्।\nवाय्वम्बुफलपर्णादैर्दन्तोलूखलिकैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2067578, "chapter_id": 2420, "verse_number": "९-३८-६४", "content_sanskrit": "तथाऽश्मकुट्टैर्वातेयैर्मुनिभिर्बहुभिर्वृतम्।\nस्वाध्यायघोषसङ्घुष्टं मृगयूथशताकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2067579, "chapter_id": 2420, "verse_number": "९-३८-६५", "content_sanskrit": "अहिंस्रैर्धर्मपरमैर्नृभिरत्यर्थरोवितम्।\nसप्तसारस्वतं तीर्थमाजगाम हलायुधः।\nयत्र मङ्कणकः सिद्धस्तपस्तेपे महामुनिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2067580, "chapter_id": 2420, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि अष्टविंशोऽध्यायः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]