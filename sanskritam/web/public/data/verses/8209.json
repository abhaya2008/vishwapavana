[{"id": 900001077, "chapter_id": 8209, "verse_number": "8.1", "content_sanskrit": "स वेदैतत् परमं ब्रह्मधाम यत्र विश्वं निहितं भाति शुभ्रम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001078, "chapter_id": 8209, "verse_number": "8.2", "content_sanskrit": "कामान् यः कामयते मन्यमानः स कामभिर्जायते तत्रतत्र", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001079, "chapter_id": 8209, "verse_number": "8.3", "content_sanskrit": "नायमात्मा प्रवचनेन लभ्यो न मेधया न बहुना श्रुतेन", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001080, "chapter_id": 8209, "verse_number": "8.4", "content_sanskrit": "नायमात्मा बलहीनेन लभ्यो न च प्रमादात् तपसो वाऽप्यलिङ्गात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001081, "chapter_id": 8209, "verse_number": "8.5", "content_sanskrit": "सम्प्राप्यैनमृषयो ज्ञानतृप्ताः कृतात्मानो वीतरागाः प्रशान्ताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001082, "chapter_id": 8209, "verse_number": "8.6", "content_sanskrit": "वेदान्तविज्ञानसुनिश्चितार्थाः सन्यासयोगाद् यतयः शुद्धसत्वाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001083, "chapter_id": 8209, "verse_number": "8.7", "content_sanskrit": "गताः कलाः पञ्चदश प्रतिष्ठा देवाश्च सर्वे प्रतिदेवतासु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900001084, "chapter_id": 8209, "verse_number": "8.8", "content_sanskrit": "गताः मुक्ताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900001085, "chapter_id": 8209, "verse_number": "8.9", "content_sanskrit": "कलाभ्यश्चान्यदेवेभ्यः कर्म प्रत्यवरं यतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900001086, "chapter_id": 8209, "verse_number": "8.10", "content_sanskrit": "यथा नद्यः स्यन्दमानाः समुद्रायणाः समुद्रं प्राप्यास्तं गच्छन्ति नामरूपेऽविहाय", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900001087, "chapter_id": 8209, "verse_number": "8.11", "content_sanskrit": "स यो ह वै तत् परमं ब्रह्म वेद ब्रह्मैव भवति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900001088, "chapter_id": 8209, "verse_number": "8.12", "content_sanskrit": "'यत्रामृतः स पुरुषो ह्यव्ययात्मा'", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900001089, "chapter_id": 8209, "verse_number": "8.13", "content_sanskrit": "मुक्तभ्योऽपि मनुष्येभ्यो देवा एव गुणाधिकाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900001090, "chapter_id": 8209, "verse_number": "8.14", "content_sanskrit": "क्रियावन्तः श्रोत्रिया ब्रह्मनिष्ठाः स्वयं जुह्वत एकर्षीन् श्रद्धयन्तः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900001091, "chapter_id": 8209, "verse_number": "8.15", "content_sanskrit": "तदेतत् सत्यमृषिरङ्गिराः प्रोवाच नैतदचीर्णव्रतोऽधीते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900001092, "chapter_id": 8209, "verse_number": "8.16", "content_sanskrit": "प्रीयतां भगवान् मह्यं प्रेष्ठप्रेष्ठतमः सदा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]