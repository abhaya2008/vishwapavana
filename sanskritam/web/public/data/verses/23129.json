[{"id": 7003129000, "chapter_id": 23129, "verse_number": "४-६५-१", "content_sanskrit": "अथ पञ्चषष्टितमोऽध्यायः ।\nनारायम उवाच ।\nकंसस्य वचनं श्रुत्वा सोऽक्रूरो धर्मिणां वरः ।\nउवाच चौद्धवं शान्तं शान्तः प्रहृष्टमानसः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003129001, "chapter_id": 23129, "verse_number": "४-६५-२", "content_sanskrit": "अक्रूर उवाच ।\nसुप्रभाताऽद्य रजनी बभूव मे शुभं दिनम् ।\nतुष्टाश्च गुरवो विब्रा देवा मामिति निश्चितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003129002, "chapter_id": 23129, "verse_number": "४-६५-३", "content_sanskrit": "कोटिजन्मार्जितं पुण्यं मम स्वयमुपस्थितम् ।\nबभूव मे समुत्पन्नं यद्यत्कर्म शुभाशुभम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003129003, "chapter_id": 23129, "verse_number": "४-६५-४", "content_sanskrit": "चिच्छेद बन्धनिगडं मम बद्धस्य कर्मणा ।\nकारागाराश्च संसारान्मुक्तो यामि हरेःपदम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003129004, "chapter_id": 23129, "verse_number": "४-६५-५", "content_sanskrit": "सुहृदर्थो कृतोऽहं च कंसेन विदुषा रुषा ।\nवरेण तुल्यो देवस्य क्रोधो मम बभूव ह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003129005, "chapter_id": 23129, "verse_number": "४-६५-६", "content_sanskrit": "व्रजराज समाहर्तुं व्रजं यास्यामि सांप्रतम् ।\nद्रक्ष्यामि परमं पूज्यं भुक्तिमुक्तिप्रदायिनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003129006, "chapter_id": 23129, "verse_number": "४-६५-७", "content_sanskrit": "नवीनजलदश्यामं नीलेन्दीवरनोचनम् ।\nपीतवस्त्रसमायुक्तकटिदेशविराजितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003129007, "chapter_id": 23129, "verse_number": "४-६५-८", "content_sanskrit": "धूलिधूसरिताङ्गं च किंवा चन्दनचर्चितम् ।\nअथाव नवनीताक्तमङ्गं द्रक्ष्यामि सस्मितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003129008, "chapter_id": 23129, "verse_number": "४-६५-९", "content_sanskrit": "किंवा विनोदमुरलीं वादयन्तं मनोहरम् ।\nकिंवा गवां समूहं च चारजन्तमितस्ततः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003129009, "chapter_id": 23129, "verse_number": "४-६५-१०", "content_sanskrit": "किंवा वसन्तं गच्छन्तं शयानं वा सुनिश्चितम् ।\nनिद्रेशं कीदृशं चाद्य सुदृष्ट्वा च शुभे क्षणो ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003129010, "chapter_id": 23129, "verse_number": "४-६५-११", "content_sanskrit": "यत्पादपद्मं ध्यायन्ते ब्रह्मविष्णुशिवादयः ।\nन हि जानाति यस्यान्तमनन्तोऽनन्तविग्रहः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003129011, "chapter_id": 23129, "verse_number": "४-६५-१२", "content_sanskrit": "यत्प्रभावं न जानन्ति देवाः सन्तश्च संततम् ।\nस्य स्तोत्रे जडीभूता भीता देवी सरस्वती ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003129012, "chapter_id": 23129, "verse_number": "४-६५-१३", "content_sanskrit": "दासीनियुक्ता यद्दास्यो महालक्षमीश्च लक्षीता ।\nगङ्मा यस्य पदाम्भोजान्निःसृता सत्तव रूमिणी ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003129013, "chapter_id": 23129, "verse_number": "४-६५-१४", "content_sanskrit": "जन्ममृत्युजराव्याधिहरा त्रिभुवनात्परा ।\nदर्शनस्पर्शनाभ्यां च नृणां पातकनाशिनी ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003129014, "chapter_id": 23129, "verse_number": "४-६५-१५", "content_sanskrit": "ध्यायते यत्पदाम्भोजं दुर्गा दुर्गविनाशिनी ।\nत्रेलोक्यजननी देवी मुलप्रकृतिरीश्वरी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003129015, "chapter_id": 23129, "verse_number": "४-६५-१६", "content_sanskrit": "लोम्नां कूपेषु विश्वानि महाविष्णोश्च यस्य च ।\nअसंख्यानि विचित्राणि स्थूलात्स्थूलतरस्य च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003129016, "chapter_id": 23129, "verse_number": "४-६५-१७", "content_sanskrit": "स च यत्षोडशांशश्च यस्य सर्वेश्वरस्य च ।\nतं द्रष्टुं यामि हे बन्धो मायामानुषरूपिणम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003129017, "chapter_id": 23129, "verse_number": "४-६५-१८", "content_sanskrit": "सर्व सर्वान्तरात्मानं सर्वज्ञं प्रकृतेः परम् ।\nब्रह्मज्योतिःस्वरूपं च भक्तानुग्रहविग्रहम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003129018, "chapter_id": 23129, "verse_number": "४-६५-१९", "content_sanskrit": "निर्गुणं च निरीहं च निरानन्दं निराश्रयम् ।\nपरमं परमानन्दं सानन्दं नन्दनन्दनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003129019, "chapter_id": 23129, "verse_number": "४-६५-२०", "content_sanskrit": "स्वेच्छामयं सर्वपरं सर्वबीजं सनातनम् ।\nवदन्ति योगिनः शश्वद्ध्यायन्तेऽहर्निशं शिशुम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003129020, "chapter_id": 23129, "verse_number": "४-६५-२१", "content_sanskrit": "मन्वन्तरसहस्रं च निराहारः कृशोदरः ।\nपद्मे पाद्मस्तपस्तेपे पुरा पाद्मं तु यत्कृते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003129021, "chapter_id": 23129, "verse_number": "४-६५-२२", "content_sanskrit": "पुनः कुरु तपस्यां च तदा द्रक्ष्यसि मामिति ।\nसकृच्छब्दं च शुश्राव न ददर्श तथाऽपि तम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003129022, "chapter_id": 23129, "verse_number": "४-६५-२३", "content_sanskrit": "तावत्कालं पुनस्तप्त्वा वरं प्राप ददर्श तम् ।\nईदृशं परमेशं च द्रक्ष्याम्यद्य तमुद्धव ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003129023, "chapter_id": 23129, "verse_number": "४-६५-२४", "content_sanskrit": "पुरा शंभुस्तपस्तेपे यावद्वै ब्रह्मणो वयः ।\nज्योतिर्मण्डलमध्ये च गोलोके तं ददर्श सः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003129024, "chapter_id": 23129, "verse_number": "४-६५-२५", "content_sanskrit": "सर्वतत्तवं सर्वसिद्धं ममतत्वं परं वरम् ।\nसंप्राप तत्पदाम्भोजे भक्तिं च निर्मलां पराम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003129025, "chapter_id": 23129, "verse_number": "४-६५-२६", "content_sanskrit": "चकाराऽत्मसमं तं च यो भक्तो(क्तं)भक्तवत्सलः ।\nईदृशं परमेशं च द्रक्ष्याम्यद्य तमुद्धव ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003129026, "chapter_id": 23129, "verse_number": "४-६५-२७", "content_sanskrit": "सहस्रशक्रपातान्तं निराहारः कृशोदरः ।\nयस्यानन्तस्तपस्तेपे भक्त्या च परमात्मनः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003129027, "chapter_id": 23129, "verse_number": "४-६५-२८", "content_sanskrit": "तदा चाऽऽत्मसमं ज्ञानंददौ तस्मै य ईश्वाः ।\nईदृशं परमेशं च द्रक्ष्या ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003129028, "chapter_id": 23129, "verse_number": "४-६५-२९", "content_sanskrit": "सहस्रशक्रपातान्तं धर्मस्तेपे च यत्तपः ।\nतदा बभूव साक्षी स धर्मिणां सर्वकर्मिणाम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003129029, "chapter_id": 23129, "verse_number": "४-६५-३०", "content_sanskrit": "शास्ता च फलदाता च यत्प्रसादान्नृणामिह ।\nसर्वेशमीदृशमहो द्रक्ष्या ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003129030, "chapter_id": 23129, "verse_number": "४-६५-३१", "content_sanskrit": "अष्टाविंशतिरिन्द्राणां पतने यद्दिवानिशम् ।\nएवं क्रमेण मासाब्दैः शताब्दं ब्रह्मणो वयः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003129031, "chapter_id": 23129, "verse_number": "४-६५-३२", "content_sanskrit": "अहो यस्य निमेषेण ब्रह्मणः पतनं भवेत् ।\nईदृशं परमात्मानं द्रक्ष्या ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003129032, "chapter_id": 23129, "verse_number": "४-६५-३३", "content_sanskrit": "नास्ति भूरजसा संख्या यथैव ब्रह्मणां तथा ।\nतथैव बन्धो विश्वानां तदाधारो महाविराट् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003129033, "chapter_id": 23129, "verse_number": "४-६५-३४", "content_sanskrit": "विशवे विश्वे च प्रत्येकं ब्रह्म विष्णुशिवादयः ।\nमुनयो मनवः मिद्धा मानवाद्याश्चराचराः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003129034, "chapter_id": 23129, "verse_number": "४-६५-३५", "content_sanskrit": "यत्षोडशांशः स विराट् सृष्टो नष्टश्च लीलया ।\nईदृशं सर्वशास्तारं द्रक्ष्या ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003129035, "chapter_id": 23129, "verse_number": "४-६५-३६", "content_sanskrit": "इत्योवमुक्त्वाऽक्रूरश्च पुलकाञ्चितविग्रहः ।\nमूर्च्छां प्राप साश्रुनेत्रोदध्यो तच्चरणाम्बुजम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003129036, "chapter_id": 23129, "verse_number": "४-६५-३७", "content_sanskrit": "बभूव भक्तिपूर्णश्च स्मारं स्मारं पदाम्बुजम् ।\nकृत्वा प्रदक्षिणं वाऽपि कृष्णस्य परमात्मनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003129037, "chapter_id": 23129, "verse_number": "४-६५-३८", "content_sanskrit": "उद्धवश्च तमाश्लिष्य प्रशशंक पुनः पुनः ।\nस च शीघ्रं ययौ गेहमकूरोऽपि स्वमन्दिरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]