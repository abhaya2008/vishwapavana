[{"id": 2150657, "chapter_id": 4270, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150658, "chapter_id": 4270, "verse_number": "१", "content_sanskrit": "ततः पूर्वापरे सन्ध्ये समीक्ष्य भगवानृषिः ।\nसर्ववेदविदां श्रेष्ठो व्यासः सत्यवतीसुतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150659, "chapter_id": 4270, "verse_number": "२", "content_sanskrit": "भविष्यति रणे घोरे भरतानां पितामहः ।\nप्रत्यक्षदर्शी भगवान् भूतभव्यभविष्यवित्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150660, "chapter_id": 4270, "verse_number": "३", "content_sanskrit": "वैचित्रवीर्यं राजानं स रहस्यं ब्रवीदिदम् ।\nशोचन्तमार्तं ध्यायन्तं पुत्राणामनयं तदा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150661, "chapter_id": 4270, "verse_number": "", "content_sanskrit": "श्रीव्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150662, "chapter_id": 4270, "verse_number": "४", "content_sanskrit": "राजन् परीतकालास्ते पुत्राश्चान्ये च भूमिपाः ।\nते हनिष्यन्ति सङ्ग्रामे समासाद्येतरेतरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150663, "chapter_id": 4270, "verse_number": "५", "content_sanskrit": "तेषु कालपरीतेषु विनश्यत्सु च भारत ।\nकालपर्यायमाज्ञाय मा स्म शोके मनः कृथाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150664, "chapter_id": 4270, "verse_number": "६", "content_sanskrit": "यदि त्विच्छसि सङ्ग्रामे द्रष्टुमेनं विशाम्पते ।\nचक्षुर्ददानि ते हन्त युद्धमेतन्निशामय\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150665, "chapter_id": 4270, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150666, "chapter_id": 4270, "verse_number": "७", "content_sanskrit": "न रोचये ज्ञातिवधं द्रष्टुं ब्रह्मर्षिसत्तम ।\nयुद्धमेतत्त्वशेषेण शृणुयां तव तेजसा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150667, "chapter_id": 4270, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150668, "chapter_id": 4270, "verse_number": "८", "content_sanskrit": "तस्मिन्ननिच्छति द्रष्टुं सङ्ग्रामं श्रोतुमिच्छति ।\nवराणामीश्वरो दाता सञ्जयाय वरं ददौ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150669, "chapter_id": 4270, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150670, "chapter_id": 4270, "verse_number": "९", "content_sanskrit": "एष ते सञ्जयो राजन् युद्धमेतद् वदिष्यति ।\nएतस्य सर्वं सङ्ग्रामे नपरोक्षं भविष्यति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150671, "chapter_id": 4270, "verse_number": "१०", "content_sanskrit": "चक्षुषा सञ्जयो राजन् दिव्येनैष समन्वितः ।\nकथयिष्यति ते युद्धं सर्वज्ञश्च भविष्यति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150672, "chapter_id": 4270, "verse_number": "११", "content_sanskrit": "प्रकाशं वा रहस्यं वा रात्रौ वा यदि वा दिवा ।\nमनसा चिन्तितमपि सर्वं वेत्स्यति सञ्जयः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150673, "chapter_id": 4270, "verse_number": "१२", "content_sanskrit": "नैनं शस्त्राणि भेत्स्यन्ति नैनं बाधिष्यते श्रमः ।\nगावल्गणिरयं जीवन् युद्धादस्माद् विमोक्ष्यते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150674, "chapter_id": 4270, "verse_number": "१३", "content_sanskrit": "अहं च कीर्तिमेतेषां कुरूणां भरतर्षभ ।\nपाण्डवानां च सर्वेषां प्रथयिष्यामि मा शुचः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150675, "chapter_id": 4270, "verse_number": "१४", "content_sanskrit": "दिष्टमेतत् पुरा चैव नात्र शोचितुमर्हसि ।\nन चैव शक्यं संयन्तुं यतो धर्मस्ततो जयः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150676, "chapter_id": 4270, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150677, "chapter_id": 4270, "verse_number": "१५", "content_sanskrit": "एवमुक्त्वा स भगवान् कुरूणां प्रपितामहः ।\nपुनरेव महाबाहो धृतराष्ट्रमुवाच ह\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150678, "chapter_id": 4270, "verse_number": "१६", "content_sanskrit": "इह युद्धे महाराज भविष्यति महान् क्षयः ।\nयथेमानि निमित्तानि भयायाद्योपलक्षये\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150679, "chapter_id": 4270, "verse_number": "१७", "content_sanskrit": "श्येना गृध्राश्च काकाश्च कङ्काश्च सहिता बलैः ।\nसम्पतन्ति वनान्तेषु समवायांश्च कुर्वते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150680, "chapter_id": 4270, "verse_number": "१८", "content_sanskrit": "अत्युग्रं च प्रपश्यन्ति युद्धमानन्दिनो द्विजाः ।\nक्रव्यादा भक्षयिष्यन्ति मांसानि गजवाजिनाम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150681, "chapter_id": 4270, "verse_number": "१९", "content_sanskrit": "खेटा हाहेति वाशन्तो भैरवं भयवेदिनः ।\nकह्वाः प्रयान्ति मध्येन दक्षिणामभितो दिशम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2150682, "chapter_id": 4270, "verse_number": "२०", "content_sanskrit": "उभे पूर्वापरे सन्ध्ये नित्यं पश्यामि भारत ।\nउदयास्तमने सूर्यं कबन्धैः परिवारितम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2150683, "chapter_id": 4270, "verse_number": "२१", "content_sanskrit": "श्वेतलोहितपर्यन्ताः कृष्णग्रीवाः सविद्युतः ।\nत्रिवर्णाः परिघाः सन्धौ भानुमावारयन्त्युत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2150684, "chapter_id": 4270, "verse_number": "२२", "content_sanskrit": "ज्वलितार्केन्दुनक्षत्रं निर्विशेषदिनक्षपम् ।\nअहोरात्रं मया दृष्टं तत्क्षयाय भविष्यति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2150685, "chapter_id": 4270, "verse_number": "२३", "content_sanskrit": "अलक्ष्यः प्रभया हीनः पौर्णमासीं च कार्त्तिकीम् ।\nचन्द्रोऽभूदग्निवर्णश्च समवर्णे नभस्तळे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2150686, "chapter_id": 4270, "verse_number": "२४", "content_sanskrit": "स्वप्स्यन्ति निहता वीरा भूमिमावृत्य पार्थिवाः ।\nराजानो राजपुत्राश्च शूराः परिघबाहवः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2150687, "chapter_id": 4270, "verse_number": "२५", "content_sanskrit": "अन्तरिक्षे वराहस्य वृषदंशस्य चोभयोः ।\nप्रणादं युध्यतो रात्रौ रौद्रं नित्यं प्रलक्षये\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2150688, "chapter_id": 4270, "verse_number": "२६", "content_sanskrit": "देवताप्रतिमाश्चापि कम्पन्ति च हसन्ति च ।\nवमन्ति रुधिरं चास्यैः स्विद्यन्ति प्रपतन्ति च\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2150689, "chapter_id": 4270, "verse_number": "२७", "content_sanskrit": "अनाहता दुन्दुभयः प्रणदन्ति विशाम्पते ।\nअयुक्ताश्च प्रवर्तन्ते क्षत्रियाणां महारथाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2150690, "chapter_id": 4270, "verse_number": "२८", "content_sanskrit": "कोकिलाः शतपत्राश्च चाषा भासाः शुकास्तथा ।\nसारसाश्च मयूराश्च वाचो मुञ्चन्ति दक्षिणाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2150691, "chapter_id": 4270, "verse_number": "२९", "content_sanskrit": "गृहीतशस्त्रावरणा वर्मिणो वाजिपृष्ठगाः ।\nअरुणोदयेषु दृश्यन्ते शतशः शलभव्रजाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2150692, "chapter_id": 4270, "verse_number": "३०", "content_sanskrit": "उभे सन्ध्ये प्रकाशेते दिशां दाहसमन्विते ।\nअसीद् रुधिरवर्षं च अस्थिवर्षं च भारत\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2150693, "chapter_id": 4270, "verse_number": "३१", "content_sanskrit": "या चैषा विश्रुता राजंस्त्रैलोक्ये साधुसम्मता ।\nअरुन्धती तयाप्येष वसिष्ठः पृष्ठतः कृतः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2150694, "chapter_id": 4270, "verse_number": "३२", "content_sanskrit": "रोहिणीं पीडयन्नेष स्थितो राजन् शनैश्चरः ।\nव्यावृत्तं लक्ष्म सोमस्य भविष्यति महद् भयम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2150695, "chapter_id": 4270, "verse_number": "३३", "content_sanskrit": "अनभ्रे च महाघोरं स्तनितं श्रूयतेऽनिशम् ।\nवाहनानां च रुदतां प्रपतन्त्यश्रुबिन्दवः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2150696, "chapter_id": 4270, "verse_number": "२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां भीष्मपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2150697, "chapter_id": 4270, "verse_number": "", "content_sanskrit": "॥ इति जम्बूखण्डनिर्माणपर्वणि द्वितीयोऽध्यायः ॥२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]