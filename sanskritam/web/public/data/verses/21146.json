[{"id": 7001146000, "chapter_id": 21146, "verse_number": "२-२-३७-१", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nवीरभद्रोथ युद्धे वै विष्णुना स महाबलः ।\nसंस्मृत्य शंकरं चित्ते सर्वापद्विनिवारणम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001146001, "chapter_id": 21146, "verse_number": "२-२-३७-२", "content_sanskrit": "आरुह्य स्यंदनं दिव्यं सर्ववैरिविमर्दनः ।\nगृहीत्वा परमास्त्राणि सिंहनादं जगर्ज ह॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001146002, "chapter_id": 21146, "verse_number": "२-२-३७-३", "content_sanskrit": "विष्णुश्चापि महाघोषं पांचजन्या भिधन्निजम् ।\nदध्मौ बली महाशंखं स्वकीयान् हर्षयन्निव॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001146003, "chapter_id": 21146, "verse_number": "२-२-३७-४", "content_sanskrit": "तच्छ्रुत्वा शंखनिर्ह्रादं देवा ये च पलायिताः ।\nरणं हित्वा गताः पूर्वं ते द्रुतं पुनराययुः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001146004, "chapter_id": 21146, "verse_number": "२-२-३७-५", "content_sanskrit": "वीरभद्र गणैस्तेषां लोकपालास्सवासवाः ।\nयुद्धञ्चक्रुस्तथा सिंहनादं कृत्वा बलान्विताः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001146005, "chapter_id": 21146, "verse_number": "२-२-३७-६", "content_sanskrit": "गणानां लोकपालानां द्वन्द्वयुद्धं भयावहम् ।\nअभवत्तत्र तुमुलं गर्जतां सिंहनादतः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001146006, "chapter_id": 21146, "verse_number": "२-२-३७-७", "content_sanskrit": "नन्दिना युयुधे शक्रोऽनलो वै वैष्णवास्तथा ।\nकुबेरोपि हि कूष्माण्डपतिश्च युयुधे बली॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001146007, "chapter_id": 21146, "verse_number": "२-२-३७-८", "content_sanskrit": "तदेन्द्रेण हतो नन्दी वज्रेण शतपर्वणा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001146008, "chapter_id": 21146, "verse_number": "२-२-३७-९", "content_sanskrit": "नन्दिना च हतश्शक्रस्त्रिशूलेन स्तनांतरे॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001146009, "chapter_id": 21146, "verse_number": "२-२-३७-१०", "content_sanskrit": "बलिनौ द्वावपि प्रीत्या युयुधाते परस्परम् ।\nनानाघातांश्च कुर्वंतौ नन्दिशक्रौ जिगीषया॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001146010, "chapter_id": 21146, "verse_number": "२-२-३७-११", "content_sanskrit": "शक्त्या जघान चाश्मानं शुचिः परमकोपनः ।\nसोपि शूलेन तं वेगाच्छितधारेण पावकम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001146011, "chapter_id": 21146, "verse_number": "२-२-३७-१२", "content_sanskrit": "यमेन सह संग्रामं महालोको गणाग्रणीः ।\nचकार तुमुलं वीरो महादेवं स्मरन्मुदा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001146012, "chapter_id": 21146, "verse_number": "२-२-३७-१३", "content_sanskrit": "नैरृतेन समागम्य चंडश्च बलवत्तरः ।\nयुयुधे परमास्त्रैश्च नैरृतिं निबिडं वयन्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001146013, "chapter_id": 21146, "verse_number": "२-२-३७-१४", "content_sanskrit": "वरुणेन समं वीरो मुंडश्चैव महाबलः ।\nयुयुधे परया शक्त्या त्रिलोकीं विस्मयन्निव॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001146014, "chapter_id": 21146, "verse_number": "२-२-३७-१५", "content_sanskrit": "वायुना च हतो भृंगी स्वास्त्रेण परमोजसा ।\nभृंगिणा च हतो वायुस्त्रिशूलेन प्रतापिना॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001146015, "chapter_id": 21146, "verse_number": "२-२-३७-१६", "content_sanskrit": "कुबेरेणैव संगम्य कूष्मांडपतिरादरात् ।\nयुयुधे बलवान् वीरो ध्यात्वा हृदि महेश्वरम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001146016, "chapter_id": 21146, "verse_number": "२-२-३७-१७", "content_sanskrit": "योगिनीचक्रसंयुक्तो भैरवीनायको महान् ।\nविदीर्य्य देवानखिलान्पपौ शोणितमद्भुतम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001146017, "chapter_id": 21146, "verse_number": "२-२-३७-१८", "content_sanskrit": "क्षेत्रपालास्तथा तत्र बुभुक्षुः सुरपुंगवान् ।\nकाली चापि विदार्यैव तान्पपौ रुधिरं बहु॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001146018, "chapter_id": 21146, "verse_number": "२-२-३७-१९", "content_sanskrit": "अथ विष्णुर्महातेजा युयुधे तैश्च शत्रुहा ।\nचक्रं चिक्षेप वेगेन दहन्निव दिशो दश॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001146019, "chapter_id": 21146, "verse_number": "२-२-३७-२०", "content_sanskrit": "क्षेत्रपालस्समायांतं चक्रमालोक्य वेगतः ।\nतत्रागत्यागतो वीरश्चाग्रसत्सहसा बली॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001146020, "chapter_id": 21146, "verse_number": "२-२-३७-२१", "content_sanskrit": "चक्रं ग्रसितमालोक्य विष्णुः परपुरंजयः ।\nमुखं तस्य परामृज्य तमुद्गालितवानरिम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001146021, "chapter_id": 21146, "verse_number": "२-२-३७-२२", "content_sanskrit": "स्वचक्रमादाय महानुभावश्चुकोप चातीव भवैकभर्त्ता ।\nमहाबली तैर्युयुधे प्रवीरैस्सक्रुद्धनानायुधधारकोस्त्रैः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001146022, "chapter_id": 21146, "verse_number": "२-२-३७-२३", "content_sanskrit": "चक्रे महारणं विष्णुस्तैस्सार्द्धं युयुधे मुदा ।\nनानायुधानि संक्षिप्य तुमुलं भीमविक्रमम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001146023, "chapter_id": 21146, "verse_number": "२-२-३७-२४", "content_sanskrit": "अथ ते भैरवाद्याश्च युयुधुस्तेन भूरिशः ।\nनानास्त्राणि विमुंचंतस्संकुद्धाः परमोजसा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001146024, "chapter_id": 21146, "verse_number": "२-२-३७-२५", "content_sanskrit": "इत्थं तेषां रणं दृष्ट्वा हरिणातुलतेजसा ।\nविनिवृत्य समागम्य तान्स्वयं युयुधे बली॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001146025, "chapter_id": 21146, "verse_number": "२-२-३७-२६", "content_sanskrit": "अथ विष्णुर्महातेजाश्चक्रमुद्यम्य मूर्च्छितः ।\nयुयुधे भगवांस्तेन वीरभद्रेण माधवः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001146026, "chapter_id": 21146, "verse_number": "२-२-३७-२७", "content_sanskrit": "तयोः समभवद्युद्धं सुघोरं रोमहर्षणम् ।\nमहावीराधिपत्योस्तु नानास्त्रधरयोर्मुने॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001146027, "chapter_id": 21146, "verse_number": "२-२-३७-२८", "content_sanskrit": "विष्णोर्योगबलात्तस्य देवदेव सुदारुणाः ।\nशङ्खचक्रगदाहस्ता असंख्याताश्च जज्ञिरे॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001146028, "chapter_id": 21146, "verse_number": "२-२-३७-२९", "content_sanskrit": "ते चापि युयुधुस्तेन वीरभद्रेण भाषता ।\nविष्णुवत् बलवंतो हि नानायुधधरा गणाः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001146029, "chapter_id": 21146, "verse_number": "२-२-३७-३०", "content_sanskrit": "तान्सर्वानपि वीरोसौ नारायणसमप्रभान् ।\nभस्मीचकार शूलेन हत्वा स्मृत्वा शिवं प्रभुम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001146030, "chapter_id": 21146, "verse_number": "२-२-३७-३१", "content_sanskrit": "ततश्चोरसि तं विष्णुं लीलयैव रणाजिरे ।\nजघान वीरभद्रो हि त्रिशूलेन महाबली॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001146031, "chapter_id": 21146, "verse_number": "२-२-३७-३२", "content_sanskrit": "तेन घातेन सहसा विहतः पुरुषोत्तमः ।\nपपात च तदा भूमौ विसंज्ञोभून्मुने हरिः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001146032, "chapter_id": 21146, "verse_number": "२-२-३७-३३", "content_sanskrit": "ततो यज्ञोद्भुतं तेजः प्रलयानलसन्निभम् ।\nत्रैलोक्यदाहकं तीव्रं वीराणामपि भीकरम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001146033, "chapter_id": 21146, "verse_number": "२-२-३७-३४", "content_sanskrit": "क्रोधरक्तेक्षणः श्रीमान् पुनरुत्थाय स प्रभुः ।\nप्रहर्तुं चक्रमुद्यम्य ह्यतिष्ठत्पुरुषर्षभः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001146034, "chapter_id": 21146, "verse_number": "२-२-३७-३५", "content_sanskrit": "तस्य चक्रं महारौद्रं काला दित्यसमप्रभम् ।\nव्यष्टंभयददीनात्मा वीरभद्रश्शिवः प्रभुः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001146035, "chapter_id": 21146, "verse_number": "२-२-३७-३६", "content_sanskrit": "मुने शंभोः प्रभावात्तु मायेशस्य महाप्रभोः ।\nन चचाल हरेश्चक्रं करस्थं स्तंभितं ध्रुवम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001146036, "chapter_id": 21146, "verse_number": "२-२-३७-३७", "content_sanskrit": "अथ विष्णुर्गणेशेन वीरभद्रेण भाषता ।\nअतिष्ठत्स्तंभितस्तेन शृंगवानिव निश्चलः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001146037, "chapter_id": 21146, "verse_number": "२-२-३७-३८", "content_sanskrit": "ततो विष्णुः स्तंभितो हि वीरभद्रेण नारद ।\nयज्वोपमंत्रणमना नीरस्तंभनकारकम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001146038, "chapter_id": 21146, "verse_number": "२-२-३७-३९", "content_sanskrit": "ततस्स्तंभननिर्मुक्तः शार्ङ्गधन्वा रमेश्वरः ।\nशार्ङ्गं जग्राह स क्रुद्धः स्वधनुस्सशरं मुने॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001146039, "chapter_id": 21146, "verse_number": "२-२-३७-४०", "content_sanskrit": "त्रिभिश्च धर्षितो बाणैस्तेन शार्ङ्गं धनुर्हरेः ।\nवीरभद्रेण तत्तात त्रिधाभूत्तत्क्षणान्मुने॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001146040, "chapter_id": 21146, "verse_number": "२-२-३७-४१", "content_sanskrit": "अथ विष्णुर्मया वाण्या बोधितस्तं महागणम् ।\nअसह्यवर्चसं ज्ञात्वा ह्यंतर्धातुं मनो दधे॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001146041, "chapter_id": 21146, "verse_number": "२-२-३७-४२", "content_sanskrit": "ज्ञात्वा च तत्सर्वमिदं भविष्यं सतीकृतं दुष्प्रसहं परेषाम् ।\nगताः स्वलोकं स्वगणान्वितास्तु स्मृत्वा शिवं सर्वपतिं स्वतंत्रम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001146042, "chapter_id": 21146, "verse_number": "२-२-३७-४३", "content_sanskrit": "सत्यलोकगतश्चाहं पुत्र शोकेन पीडितः ।\nअचिंतयं सुदुःखार्तो मया किं कार्यमद्य वै॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001146043, "chapter_id": 21146, "verse_number": "२-२-३७-४४", "content_sanskrit": "विष्णौ मयि गते चैव देवाश्च मुनिभिस्सह ।\nविनिर्जिता गणैस्सर्वे ये ते यज्ञोपजीविनः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001146044, "chapter_id": 21146, "verse_number": "२-२-३७-४५", "content_sanskrit": "समुपद्रवमालक्ष्य विध्वस्तं च महामखम् ।\nमृगस्वरूपो यज्ञो हि महाभीतोऽपि दुद्रुवे॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001146045, "chapter_id": 21146, "verse_number": "२-२-३७-४६", "content_sanskrit": "तं तदा मृगरूपेण धावंतं गगनं प्रति ।\nवीरभद्रस्समादाय विशिरस्कमथाकरोत्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001146046, "chapter_id": 21146, "verse_number": "२-२-३७-४७", "content_sanskrit": "ततः प्रजापतिं धर्मं कश्यपं च प्रगृह्य सः ।\nअरिष्टनेमिनं वीरो बहुपत्रमुनीश्वरम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001146047, "chapter_id": 21146, "verse_number": "२-२-३७-४८", "content_sanskrit": "मुनिमांगिरसं चैव कृशाश्वं च महागणः ।\nजघान मूर्ध्नि पादेन दत्तं च मुनिपुंगवम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001146048, "chapter_id": 21146, "verse_number": "२-२-३७-४९", "content_sanskrit": "सरस्वत्याश्च नासाग्रं देवमास्तु तथैव च ।\nचिच्छेद करजाग्रेण वीर भद्रः प्रतापवान्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001146049, "chapter_id": 21146, "verse_number": "२-२-३७-५०", "content_sanskrit": "ततोन्यानपि देवादीन् विदार्य पृथिवीतले ।\nपातयामास सोयं वै क्रोधाक्रांतातिलोचनः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001146050, "chapter_id": 21146, "verse_number": "२-२-३७-५१", "content_sanskrit": "वीरभद्रो विदार्य्यापि देवान्मुख्यान्मुनीनपि ।\nनाभूच्छांतो द्रुतक्रोधः फणिराडिव मंडितः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001146051, "chapter_id": 21146, "verse_number": "२-२-३७-५२", "content_sanskrit": "वीरभद्रोद्धृतारातिः केसरीव वनद्विपान् ।\nदिशो विलोकयामास कः कुत्रास्तीत्यनुक्षणम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001146052, "chapter_id": 21146, "verse_number": "२-२-३७-५३", "content_sanskrit": "व्यपोथयद्भृगुं यावन्मणिभद्रः प्रतापवान् ।\nपदाक्रम्योरसि तदाऽकार्षीत्तच्छ्मश्रुलुंचनम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001146053, "chapter_id": 21146, "verse_number": "२-२-३७-५४", "content_sanskrit": "चंडश्चोत्पाटयामास पूष्णो दंतान् प्रवेगतः ।\nशप्यमाने हरे पूर्वं योऽहसद्दर्शयन्दतः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001146054, "chapter_id": 21146, "verse_number": "२-२-३७-५५", "content_sanskrit": "नन्दी भगस्य नेत्रे हि पातितस्य रुषा भुवि ।\nउज्जहार स दक्षोक्ष्णा यश्शपंतमसूसुचत्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001146055, "chapter_id": 21146, "verse_number": "२-२-३७-५६", "content_sanskrit": "विडंबिता स्वधा तत्र सा स्वाहा दक्षिणा तथा ।\nमंत्रास्तंत्रास्तथा चान्ये तत्रस्था गणनायकैः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001146056, "chapter_id": 21146, "verse_number": "२-२-३७-५७", "content_sanskrit": "ववृषुस्ते पुरीषाणि वितानाऽग्नौ रुषा गणाः ।\nअनिर्वाच्यं तदा चक्रुर्गणा वीरास्तमध्वरम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001146057, "chapter_id": 21146, "verse_number": "२-२-३७-५८", "content_sanskrit": "अंतर्वेद्यंतरगतं निलीनं तद्भयाद्बलात् ।\nआनिनाय समाज्ञाय वीरभद्रेः स्वभूश्चुतम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001146058, "chapter_id": 21146, "verse_number": "२-२-३७-५९", "content_sanskrit": "कपोलेऽस्य गृहीत्वा तु खड्गेनोपहृतं शिरः ।\nअभेद्यमभवत्तस्य तच्च योगप्रभावतः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001146059, "chapter_id": 21146, "verse_number": "२-२-३७-६०", "content_sanskrit": "अभेद्यं तच्छिरो मत्वा शस्त्रास्त्रैश्च तु सर्वशः ।\nकरेण त्रोटयामास पद्भ्यामाक्रम्य चोरसि॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001146060, "chapter_id": 21146, "verse_number": "२-२-३७-६१", "content_sanskrit": "तच्छिरस्तस्य दुष्टस्य दक्षस्य हरवैरिणः ।\nअग्निकुंडे प्रचिक्षेप वीरभद्रो गणाग्रणीः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001146061, "chapter_id": 21146, "verse_number": "२-२-३७-६२", "content_sanskrit": "रेजे तदा वीरभद्रस्त्रिशूलं भ्रामयन्करे ।\nक्रुद्धा रणाक्षसंवर्ताः प्रज्वाल्य पर्वतोपमाः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001146062, "chapter_id": 21146, "verse_number": "२-२-३७-६३", "content_sanskrit": "अनायासेन हत्वैतान् वीरभद्रस्ततोऽग्निना ।\nज्वालयामास सक्रोधो दीप्ताग्निश्शलभानिव॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001146063, "chapter_id": 21146, "verse_number": "२-२-३७-६४", "content_sanskrit": "वीरभद्रस्ततो दग्धान्दृष्ट्वा दक्षपुरोगमान् ।\nअट्टाट्टहासमकरोत्पूरयंश्च जगत्त्रयम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001146064, "chapter_id": 21146, "verse_number": "२-२-३७-६५", "content_sanskrit": "वीरश्रिया वृतस्तत्र ततो नन्दनसंभवा ।\nपुष्पवृष्टिरभूद्दिव्या वीरभद्रे गणान्विते॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001146065, "chapter_id": 21146, "verse_number": "२-२-३७-६६", "content_sanskrit": "ववुर्गंधवहाश्शीतास्सुगन्धास्सुखदाः शनैः ।\nदेवदुंदुभयो नेदुस्सममेव ततः परम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001146066, "chapter_id": 21146, "verse_number": "२-२-३७-६७", "content_sanskrit": "कैलासं स ययौ वीरः कृतकार्य्यस्ततः परम् ।\nविनाशितदृढध्वांतो भानुमानिव सत्वरम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001146067, "chapter_id": 21146, "verse_number": "२-२-३७-६८", "content_sanskrit": "कृतकार्यं वीरभद्रं दृष्ट्वा संतुष्टमा नसः ।\nशंभुर्वीरगणाध्यक्षं चकार परमेश्वरः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]