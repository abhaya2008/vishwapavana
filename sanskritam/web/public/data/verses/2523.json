[{"id": 2072109, "chapter_id": 2523, "verse_number": "१२-२८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072110, "chapter_id": 2523, "verse_number": "१२-२८-१", "content_sanskrit": "अव्याहरति राजेन्द्रे धर्मपुत्रे युधिष्ठिरे।\nगुडाकेशो हृषीकेशमभ्यभाषत पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072111, "chapter_id": 2523, "verse_number": "१२-२८-२x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072112, "chapter_id": 2523, "verse_number": "१२-२८-२", "content_sanskrit": "ज्ञातिशोकाभिसंतप्तो धर्मपुत्रः परंतपः।\nएष शोकार्णवे मग्नस्तमाश्वासय माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072113, "chapter_id": 2523, "verse_number": "१२-२८-३", "content_sanskrit": "सर्वे स्म ते संशयिताः पुनरेव जनार्दन।\nअस्य शोकं महाप्राज्ञ प्रणाशयितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072114, "chapter_id": 2523, "verse_number": "१२-२८-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072115, "chapter_id": 2523, "verse_number": "१२-२८-४", "content_sanskrit": "एवमुक्तस्तु गोविन्दो विजयेन महात्मना।\nपर्यवर्तत राजानं पुण्डरीकेक्षणोऽच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072116, "chapter_id": 2523, "verse_number": "१२-२८-५", "content_sanskrit": "अनतिक्रमणीयो हि धर्मराजस्य केशवः।\nबाल्यात्प्रभृति गोविंदः प्रीत्या चाभ्यधिकोर्जुनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072117, "chapter_id": 2523, "verse_number": "१२-२८-६", "content_sanskrit": "संप्रगृह्य महाबाहुर्भुजं चन्दनभूषितम्।\nशैलस्तम्भोपमं शौरिरुवाचाभिविनोदयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072118, "chapter_id": 2523, "verse_number": "१२-२८-७", "content_sanskrit": "शुशुभे वदनं तस्य सुदंष्ट्रं चारुलोचनम्।\nव्याकोचमिव विस्पष्टं पझं सूर्यविबोधितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072119, "chapter_id": 2523, "verse_number": "१२-२८-८x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072120, "chapter_id": 2523, "verse_number": "१२-२८-८", "content_sanskrit": "मा कृथाः पुरुषव्याघ्र शोकं त्वं गात्रशोषणम्।\nन हि ते सुलभा भूयो ये हताऽस्मिन्रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072121, "chapter_id": 2523, "verse_number": "१२-२८-९", "content_sanskrit": "स्वप्नलब्धा यथा लाभा वितथाः प्रतिबोधने।\nतथा ते क्षत्रिया राजन्ये व्यतीता महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072122, "chapter_id": 2523, "verse_number": "१२-२८-१०", "content_sanskrit": "सर्वे ह्यभिमुखाः शूरा निहता रणशोभिनः।\nनैषां कश्चित्पृष्ठतो वा पलायन्वा निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072123, "chapter_id": 2523, "verse_number": "१२-२८-११", "content_sanskrit": "सर्वे त्यक्त्वाऽऽत्मनः प्राणान्युद्ध्वा वीरा महामृधे।\nशस्त्रपूता दिवं प्राप्ता न ताञ्छोचितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072124, "chapter_id": 2523, "verse_number": "१२-२८-१२", "content_sanskrit": "क्षत्रधर्मरताः शूरा वेदवेदाङ्गपारगाः।\nप्राप्ता वीरगतिं पुण्यां तान्न शोचितुमर्हसि।\nमृतान्महानुभावांस्त्वं श्रुत्वैव पृथिवीपतीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072125, "chapter_id": 2523, "verse_number": "१२-२८-१३", "content_sanskrit": "अत्रैवोदाहरन्तीममितिहासं पुरातनम्।\nसृञ्जयं पुत्रशोकार्तं यथाऽयं नारदोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072126, "chapter_id": 2523, "verse_number": "१२-२८-१४x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072127, "chapter_id": 2523, "verse_number": "१२-२८-१४", "content_sanskrit": "सुखदुःखैरहं त्वं च प्रजाः सर्वाश्च सृञ्जय।\nअविमुक्ता मरिष्यामस्तत्र का परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072128, "chapter_id": 2523, "verse_number": "१२-२८-१५", "content_sanskrit": "महाभाग्यं पुरा राज्ञां कीर्त्यमानं मया शृणु।\nगच्छावधानं नृपते ततो दुःखं प्रहास्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072129, "chapter_id": 2523, "verse_number": "१२-२८-१६", "content_sanskrit": "मृतान्महानुभावांस्त्वं श्रुत्वैव पृथिवीपतीन्।\nशममानय संतापं शृणु विस्तरशश्च मे।\nक्रूरग्रहाभिशमनमायुर्वर्धनमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2072130, "chapter_id": 2523, "verse_number": "१२-२८-१७", "content_sanskrit": "अग्रिमाणां क्षितिभुजामुदारं च मनोहरम्।\nआविक्षितं मरुत्तं च मृतं सृञ्जय शुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2072131, "chapter_id": 2523, "verse_number": "१२-२८-१८", "content_sanskrit": "यस्य सेन्द्राः सवरुणा बृहस्पतिपुरोगमाः।\nदेवा विश्वसृजो राज्ञो यज्ञमीयुर्महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2072132, "chapter_id": 2523, "verse_number": "१२-२८-१९", "content_sanskrit": "यः स्पर्धामानयच्छक्रं देवराजं पुरंदरम्।\nशक्रप्रियैषी यं विद्वान्प्रत्याचष्ट बृहस्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2072133, "chapter_id": 2523, "verse_number": "१२-२८-२०", "content_sanskrit": "संवर्तो याजयामास यं पीडार्थं बृहस्पतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2072134, "chapter_id": 2523, "verse_number": "१२-२८-२१", "content_sanskrit": "यस्मिन्प्रशासति महीं नृपतौ राजसत्तम।\nअकृष्टपच्या पृथिवी विबभौ सस्यमालिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2072135, "chapter_id": 2523, "verse_number": "१२-२८-२२", "content_sanskrit": "आविक्षितस्य वै सत्रे विश्वेदेवाः सभासदः।\nमरुतः परिवेष्टारः साध्याश्चासन्महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2072136, "chapter_id": 2523, "verse_number": "१२-२८-२३", "content_sanskrit": "मरुद्गण मरुत्तस्य यत्सोममपिबंस्ततः।\nदेवान्मनुष्यान्गन्धर्वानत्यरिच्यन्त दक्षिणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2072137, "chapter_id": 2523, "verse_number": "१२-२८-२४", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरश्चैव मा पुत्रमनुतप्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2072138, "chapter_id": 2523, "verse_number": "१२-२८-२५", "content_sanskrit": "सुहोत्रं च द्वतिथिनं मृतं सृञ्जय शुश्रुम।\nयस्मे हिरण्यं ववृषे मघवा परिवत्सरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2072139, "chapter_id": 2523, "verse_number": "१२-२८-२६", "content_sanskrit": "सत्यनामा वसुमती यं प्राप्यासीञ्जनाधिपम्।\nहिरण्यमवहन्नद्यस्तस्मिञ्जनपदेश्वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2072140, "chapter_id": 2523, "verse_number": "१२-२८-२७", "content_sanskrit": "मत्स्यान्कर्कटकान्नक्रान्मकराञ्छिंशुकानपि।\nनदीष्ववासृजद्राजन्मघवा लोकपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2072141, "chapter_id": 2523, "verse_number": "१२-२८-२८", "content_sanskrit": "हैरण्यान्पातितान्दृष्ट्वा मत्स्यान्मकरकच्छपान्।\nसहस्रशोऽथ शतशस्ततोऽस्मयत वैतिथिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2072142, "chapter_id": 2523, "verse_number": "१२-२८-२९", "content_sanskrit": "तद्धिरण्यमपर्यन्तमावृतं कुरुजाङ्गले।\nईजानो वितते यज्ञे ब्राह्मणेभ्यः समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2072143, "chapter_id": 2523, "verse_number": "१२-२८-३०", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरश्चैव मा पुत्रमनुतप्यथाः।\nअदक्षिणमयज्वानं श्वैत्य संशाम्य माशुचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2072144, "chapter_id": 2523, "verse_number": "१२-२८-३१", "content_sanskrit": "अङ्गं बृहद्रथं चैव मृतं सृञ्जय शुश्रुम।\nयः सहस्रं सहस्राणां श्वेतानश्वानवासृजात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2072145, "chapter_id": 2523, "verse_number": "१२-२८-३२", "content_sanskrit": "सहस्रं च सहस्राणां कन्या हमपरिष्कृताः।\nईजानो वितते यज्ञे दक्षिणामत्यकालयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2072146, "chapter_id": 2523, "verse_number": "१२-२८-३३", "content_sanskrit": "यः सहस्रं सहस्राणां गजानां पझमालिनाम्।\nईजानो वितते यज्ञे दक्षिणामत्यकालयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2072147, "chapter_id": 2523, "verse_number": "१२-२८-३४", "content_sanskrit": "शतं शतसहस्राणि वृषाणां हेममालिनाम्।\nगवां सहस्रानुचरं दक्षिणामत्यकालयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2072148, "chapter_id": 2523, "verse_number": "१२-२८-३५", "content_sanskrit": "अङ्गस्य यजमानस्य तदा विष्णुपदे गिरौ।\nअमाद्यदिन्द्रः सोमेन दक्षिणाभिर्द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2072149, "chapter_id": 2523, "verse_number": "१२-२८-३६", "content_sanskrit": "यस्य यज्ञेषु राजेन्द्र शतसङ्ख्येषु वै पुरा।\nदेवान्मनुष्यान्गन्धर्वानत्यरिच्यन्त दक्षिणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2072150, "chapter_id": 2523, "verse_number": "१२-२८-३७", "content_sanskrit": "न जातो जनिता नान्यः पुमान्यः संप्रदास्यति।\nयदङ्गः प्रददौ वित्तं सोमसंस्थासु सप्तसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2072151, "chapter_id": 2523, "verse_number": "१२-२८-३८", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरश्चैव मा पुत्रमनुतप्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2072152, "chapter_id": 2523, "verse_number": "१२-२८-३९", "content_sanskrit": "शिबिमौशीनरं चैव मृतं सृञ्जय शुश्रुम।\nय इमां पृथिवीं सर्वां चर्मवत्समवेष्टयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2072153, "chapter_id": 2523, "verse_number": "१२-२८-४०", "content_sanskrit": "महता रथघोषेण पृथिवीमनुनादयन्।\nएकच्छत्रां महीं चक्रे जैत्रेणैकरथेन यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2072154, "chapter_id": 2523, "verse_number": "१२-२८-४१", "content_sanskrit": "यावदस्य गवाश्वं स्यादारण्यैः पशुभिः सह।\nतावतीः प्रददौ गाः स शिबिरौशीनरोऽध्वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2072155, "chapter_id": 2523, "verse_number": "१२-२८-४२", "content_sanskrit": "न वोढारं धुरं तस्य कंचिन्मेने प्रजापतिः।\nन भूतं न भविष्यं च सर्वराजसु सृञ्जय।\nअन्यत्रौशीनराच्छैब्याद्राजर्षेरिन्द्रविक्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2072156, "chapter_id": 2523, "verse_number": "१२-२८-४३", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरश्चैव मा पुत्रमनुतप्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2072157, "chapter_id": 2523, "verse_number": "१२-२८-४४", "content_sanskrit": "अदक्षिणमयज्वानं पुत्रं संस्मृत्य मा शुचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2072158, "chapter_id": 2523, "verse_number": "१२-२८-४५", "content_sanskrit": "भरतं चैव दौष्यन्तिं मृतं सृञ्जय शुश्रुम।\nशाकुन्तलं महात्मानं भूरिद्रविणतेजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2072159, "chapter_id": 2523, "verse_number": "१२-२८-४६", "content_sanskrit": "योऽबध्नात्रिशतं चाश्वान्देवेभ्यो यमुनामनु।\nसरस्वतीं विंशतिं च गङ्गामनु चतुर्दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2072160, "chapter_id": 2523, "verse_number": "१२-२८-४७", "content_sanskrit": "अश्वमेधसहस्रेण राजसूयशतेन च।\nइष्टवान्स महातेजा दौष्यन्तिर्भरतः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2072161, "chapter_id": 2523, "verse_number": "१२-२८-४८", "content_sanskrit": "भरतस्य महत्कर्म सवराजसु पार्थिवाः।\nस्वं मर्त्या इव बाहुभ्यां नानुगन्तुमशक्नुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2072162, "chapter_id": 2523, "verse_number": "१२-२८-४९", "content_sanskrit": "परं सहस्राद्योऽबध्नाद्धयान्वेदीर्वितत्य च।\nसहस्रं यत्र पझानां कण्वाय भरतो ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2072163, "chapter_id": 2523, "verse_number": "१२-२८-५०", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरश्चैव मा पुत्रमनुतप्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2072164, "chapter_id": 2523, "verse_number": "१२-२८-५१", "content_sanskrit": "रामं दाशरथिं चैव मृतं सृञ्जय शुश्रुम।\nयोऽन्वकम्पत वै नित्यं प्रजाः पुत्रानिवौरसान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2072165, "chapter_id": 2523, "verse_number": "१२-२८-५२", "content_sanskrit": "नाधनो यस्य विषये नानर्थः कस्यचिद्भवेत्।\nसर्वस्यासीत्पितृसमो रामो राज्यं यदन्वशात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2072166, "chapter_id": 2523, "verse_number": "१२-२८-५३", "content_sanskrit": "कालवर्षी च पर्जन्यः सस्यानि समपादयत्।\nनित्यं सुभिक्षमेवासीद्रामे राज्यं प्रशासति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2072167, "chapter_id": 2523, "verse_number": "१२-२८-५४", "content_sanskrit": "प्राणिनो नाप्सु मञ्जन्ति नानर्थे पावकोऽदहत्।\nन व्यालतो भयं चासीद्रामे राज्यं प्रशासति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2072168, "chapter_id": 2523, "verse_number": "१२-२८-५५", "content_sanskrit": "आसन्वर्षसहस्रिण्यस्तथा वर्षसहस्रकाः।\nअरोगाः सर्वसिद्धार्था रामे राज्यं प्रशासति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2072169, "chapter_id": 2523, "verse_number": "१२-२८-५६", "content_sanskrit": "नान्योन्येन विवादोऽभूत्स्त्रीणामपि कुतो नृणाम्।\nधर्मनित्याः प्रजाश्चासन्रामे राज्यं प्रशासति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2072170, "chapter_id": 2523, "verse_number": "१२-२८-५७", "content_sanskrit": "संतुष्टाः सर्वसिद्धार्था निर्भयाः स्वैरचारिणः।\nनराः सत्यव्रताश्चासन्रामे राज्यं प्रशासति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2072171, "chapter_id": 2523, "verse_number": "१२-२८-५८", "content_sanskrit": "नित्यपुष्पफलाश्चैव पादपा निरुपद्रवाः।\nसर्वा द्रोणदुघा गावो रामे राज्यं प्रशासति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2072172, "chapter_id": 2523, "verse_number": "१२-२८-५९", "content_sanskrit": "स चतुर्दश वर्षाणि वने प्रोष्य महातपाः।\nदशाश्वमेधाञ्जारूथ्यानाजहार निरर्गलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2072173, "chapter_id": 2523, "verse_number": "१२-२८-६०", "content_sanskrit": "युवा श्यामो लोहिताक्षो मातङ्ग इव यूथपः।\nआजानुबाहुः सुमुखः सिंहस्कन्धो महाभुजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2072174, "chapter_id": 2523, "verse_number": "१२-२८-६१", "content_sanskrit": "दशवर्षसहस्राणि दशवर्षशतानि च।\nअयोध्याधिपतिर्भूत्वा रामो राज्यमकारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2072175, "chapter_id": 2523, "verse_number": "१२-२८-६२", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरश्चैव मा पुत्रमनुतप्यथाः।\nअयज्वानमदक्षिण्यं मा पुत्रमनुतप्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2072176, "chapter_id": 2523, "verse_number": "१२-२८-६३", "content_sanskrit": "भगीरथं च राजानं मृतं सृञ्जय शुश्रुम्।\nयस्येन्द्रो वितते यज्ञे सोमं पीत्वा मदोत्कटः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2072177, "chapter_id": 2523, "verse_number": "१२-२८-६४", "content_sanskrit": "असुराणां सहस्राणि बहूनि सुरसत्तमः।\nअजयद्वाहुवीर्येण भगवान्पाकशासनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2072178, "chapter_id": 2523, "verse_number": "१२-२८-६५", "content_sanskrit": "यः सहस्रं सहस्राणां कन्या हेमविभूषिताः।\nईजानो वितते यज्ञे दक्षिणामत्यकालयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2072179, "chapter_id": 2523, "verse_number": "१२-२८-६६", "content_sanskrit": "सर्वा रथगताः कन्या रथाः सर्वे चतुर्युजः।\nशतंशतं रथे नागाः पझिनो हेममालिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2072180, "chapter_id": 2523, "verse_number": "१२-२८-६७", "content_sanskrit": "सहस्रमश्वा एकैकं हस्तिनं पृष्ठतोऽन्वयुः।\nगवां सहस्रमश्वेऽश्वे सहस्रं गव्यजाविकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2072181, "chapter_id": 2523, "verse_number": "१२-२८-६८", "content_sanskrit": "उपह्वरे निवसतो यस्याङ्के निषसाद ह।\nगङ्गा भागीरथी तस्मादुर्वशी चाभवत्पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2072182, "chapter_id": 2523, "verse_number": "१२-२८-६९", "content_sanskrit": "भूरिदक्षिणमिक्ष्वाकुं यजमानं भगीरथम्।\nत्रिलोकपथगा गङ्गा दुहितृत्वमुपेयुषी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2072183, "chapter_id": 2523, "verse_number": "१२-२८-७०", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरश्चैव मा पुत्रमनुतप्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2072184, "chapter_id": 2523, "verse_number": "१२-२८-७१", "content_sanskrit": "दिलीपं च महात्मानं मृतं सृञ्जय शुश्रुम।\nप्रस्य कर्माणि भूरीणि कथयन्ति द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2072185, "chapter_id": 2523, "verse_number": "१२-२८-७२", "content_sanskrit": "य इमां वसुसंपूर्णां वसुधां वसुधाधिपः।\nददौ तस्मिन्महायज्ञे ब्राह्मणेभ्यः समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2072186, "chapter_id": 2523, "verse_number": "१२-२८-७३", "content_sanskrit": "यस्येह यजमानस्य यज्ञेयज्ञे पुरोहितः।\nसहस्रं वारणान्हैमान्दक्षिणामत्यकालयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2072187, "chapter_id": 2523, "verse_number": "१२-२८-७४", "content_sanskrit": "यस्य यज्ञे महानासीद्यूपः श्रीमान्हिरण्मयः।\nते देवां कर्म कुर्वाणाः शक्रज्येष्ठा उपासत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2072188, "chapter_id": 2523, "verse_number": "१२-२८-७५", "content_sanskrit": "चषाले यस्य सौवर्णे तस्मिन्यूपे हिरण्मये।\nननृतुर्देवगन्धर्वाः षट्सहस्राणि सप्तधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2072189, "chapter_id": 2523, "verse_number": "१२-२८-७६", "content_sanskrit": "अवादयत्तत्र वीणां मध्ये विश्वावसुः स्वयम्।\nसर्वभूतान्यमन्यन्त मम वादयतीत्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2072190, "chapter_id": 2523, "verse_number": "१२-२८-७७", "content_sanskrit": "एतद्राज्ञो दिलीपस्य राजानो नानुचक्रिरे।\nयस्येभा हेमसंछन्नाः पथि मत्ताः स्म शेरते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2072191, "chapter_id": 2523, "verse_number": "१२-२८-७८", "content_sanskrit": "राजानं शतधन्वानं दिलीपं सत्यवादिनम्।\nयेऽपश्यन्सुमहात्मानं तेऽपि स्वर्गजितो नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2072192, "chapter_id": 2523, "verse_number": "१२-२८-७९", "content_sanskrit": "त्रयः शब्दा न जीर्यन्ते दिलीपस्य निवेशने।\nस्वाध्यायशब्दः ज्याशब्दः शब्दो वै दीयतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2072193, "chapter_id": 2523, "verse_number": "१२-२८-८०", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरश्चैव मा पुत्रमनुतप्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2072194, "chapter_id": 2523, "verse_number": "१२-२८-८१", "content_sanskrit": "मान्धातारं यौवनाश्वं मृतं सृञ्जय शुश्रुम।\nयं देवा मरुतो गर्भं पितुः पार्श्वादपाहरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2072195, "chapter_id": 2523, "verse_number": "१२-२८-८२", "content_sanskrit": "समृद्धो युवनाश्वस्य जठरे यो महात्मनः।\nपृषदाज्योद्भवः श्रीमांस्त्रिलोकविजयी नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2072196, "chapter_id": 2523, "verse_number": "१२-२८-८३", "content_sanskrit": "यं दृष्ट्वा पितुरुत्सङ्गे शयानं देवरूपिणम्।\nअन्योन्यमब्रुवन्देवाः कमयं धास्यतीति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2072197, "chapter_id": 2523, "verse_number": "१२-२८-८४", "content_sanskrit": "मामेव धास्यतीत्येवमिन्द्रोऽथाभ्युपपद्यत।\nमांधातेति ततस्तस्य नाम चक्रे शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2072198, "chapter_id": 2523, "verse_number": "१२-२८-८५", "content_sanskrit": "ततस्तु पयसो धारां पुष्टिहेतोर्महात्मनः।\nतस्यास्ये यौवनाश्वस्य पाणिरिन्द्रस्य चास्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2072199, "chapter_id": 2523, "verse_number": "१२-२८-८६", "content_sanskrit": "तं पिवन्पाणिमिन्द्रस्य शतमह्ना व्यवर्धत।\nस आसीद्द्वादशसमो द्वादशाहेन पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2072200, "chapter_id": 2523, "verse_number": "१२-२८-८७", "content_sanskrit": "तमिमं पृथिवी सर्वा एकाह्ना समपद्यत।\nधर्मात्मानं महात्मानं शूरमिन्द्रसमं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2072201, "chapter_id": 2523, "verse_number": "१२-२८-८८", "content_sanskrit": "यश्चाङ्गारं तु नृपतिं मरुत्तमसितं गयम्।\nअङ्गं बृहद्रथं चैव मान्धाता समरेऽजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2072202, "chapter_id": 2523, "verse_number": "१२-२८-८९", "content_sanskrit": "यौवनाश्वो यदाङ्गारं समरे प्रत्ययुध्यत।\nविस्फारैर्धनुषो देवा द्यौरभेदीति मेनिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2072203, "chapter_id": 2523, "verse_number": "१२-२८-९०", "content_sanskrit": "यत्र सूर्य उदेति स्म यत्र च प्रतितिष्ठति।\nसर्वं तद्यौवनाश्वस्य मान्धातुः क्षेत्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2072204, "chapter_id": 2523, "verse_number": "१२-२८-९१", "content_sanskrit": "अश्वमेधशतेनेष्ट्वा राजसूयशतेन च।\nअददद्रोहितान्मत्स्यान्ब्राह्मणेभ्यो विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2072205, "chapter_id": 2523, "verse_number": "१२-२८-९२", "content_sanskrit": "हैरण्यान्यो जनोत्सेधानायतान्दशयोजनम्।\nअतिरिक्तान्द्विजातिभ्यो व्यभजंस्त्वितरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2072206, "chapter_id": 2523, "verse_number": "१२-२८-९३", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरश्चैव मा पुत्रमनुतप्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2072207, "chapter_id": 2523, "verse_number": "१२-२८-९४", "content_sanskrit": "ययातिं नाहुषं चैव मृतं सृञ्जय शुश्रुम।\nय इमां पृथिवीं कृत्स्नां विजित्य सहसागराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2072208, "chapter_id": 2523, "verse_number": "१२-२८-९५", "content_sanskrit": "शम्यापातेनाभ्यतीयाद्वेदीभिश्चित्रयन्महीम्।\nईजानः क्रतुभिर्मुख्यैः पर्यगच्छद्वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2072209, "chapter_id": 2523, "verse_number": "१२-२८-९६", "content_sanskrit": "इष्ट्वा क्रतुसहस्रेण वाजपेयशतेन च।\nतर्पयामास विप्रेन्द्रांस्त्रिभिः काञ्चनपर्वतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2072210, "chapter_id": 2523, "verse_number": "१२-२८-९७", "content_sanskrit": "व्यूढेनासुरयुद्धेन हत्वा दैतेयदानवान्।\nव्यभजत्पृथिवीं कृत्स्नां ययातिर्नहुषात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2072211, "chapter_id": 2523, "verse_number": "१२-२८-९८", "content_sanskrit": "अन्त्येषु पुत्रान्निक्षिप्य यदुद्रुह्युपुरोगमान्।\nपुरुं राज्येऽभिषिच्याथ सदारः प्राविशद्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2072212, "chapter_id": 2523, "verse_number": "१२-२८-९९", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरश्चैव मा पुत्रमनुतप्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2072213, "chapter_id": 2523, "verse_number": "१२-२८-१००", "content_sanskrit": "अम्बरीषं च नाभागं मृतं सृञ्जय शुश्रुम।\nयं प्रजा वव्रिरे पुण्यं गोप्तारं नृपसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2072214, "chapter_id": 2523, "verse_number": "१२-२८-१०१", "content_sanskrit": "यः सहस्रं सहस्राणां राज्ञामयुतयाजिनाम्।\nईजानो वितते यज्ञे ब्राह्मणेभ्यस्त्वमन्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2072215, "chapter_id": 2523, "verse_number": "१२-२८-१०२", "content_sanskrit": "नैतत्पूर्वे जनाश्चक्रुर्न करिष्यन्ति चापरे।\nइत्यम्बरीषं नाभागिमन्वमोदन्त दक्षिणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2072216, "chapter_id": 2523, "verse_number": "१२-२८-१०३", "content_sanskrit": "शतं राजसहस्राणि शतं राजशतानि च।\nसर्वेऽश्वमेधैरीजानास्तेऽन्वयुर्दक्षिणायनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2072217, "chapter_id": 2523, "verse_number": "१२-२८-१०४", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरश्चैव मा पुत्रमनुतप्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2072218, "chapter_id": 2523, "verse_number": "१२-२८-१०५", "content_sanskrit": "शशबिन्दुं चैत्ररथं मृतं शुश्रुम सृञ्जय।\nयस्य भार्यासहस्राणां शतमासीन्महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2072219, "chapter_id": 2523, "verse_number": "१२-२८-१०६", "content_sanskrit": "सहस्रं तु सहस्राणां यस्यासञ्शाशबिन्दवाः।\nहिरण्यकवचाः सर्वे सर्वे चोत्तमधन्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2072220, "chapter_id": 2523, "verse_number": "१२-२८-१०७", "content_sanskrit": "शतं कन्या राजपुत्रमेकैकं पृथगन्वयुः।\nकन्यांकन्यां शतं नागा नागंनागं शतं रथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2072221, "chapter_id": 2523, "verse_number": "१२-२८-१०८", "content_sanskrit": "रथेरथे शतं चाश्वा देशजा हेममालिनः।\nअश्वेअश्वे शतं गावो गांगां तद्वदजाविकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2072222, "chapter_id": 2523, "verse_number": "१२-२८-१०९", "content_sanskrit": "एतद्धनमपर्यन्तमश्वमेधे महामखे।\nशशबिन्दुर्महाराज ब्राह्मणेभ्यो ह्यमन्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2072223, "chapter_id": 2523, "verse_number": "१२-२८-११०", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरश्चैव मा पुत्रमनुतप्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2072224, "chapter_id": 2523, "verse_number": "१२-२८-१११", "content_sanskrit": "गयं चाधूर्तरजसं मृतं शुश्रुम सृञ्जय।\nयः स वर्षशतं राजा हुतशिष्टाशनोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2072225, "chapter_id": 2523, "verse_number": "१२-२८-११२", "content_sanskrit": "यस्मै वह्निर्वरान्प्रादात्ततो वव्रे वरान्गयः।\nददतो मे क्षयो मा भूद्धर्मे श्रद्धा च वर्धताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2072226, "chapter_id": 2523, "verse_number": "१२-२८-११३", "content_sanskrit": "मनो मे रभतां सत्ये त्वत्प्रसादाद्धुताशन।\nलेभे च कामांस्तान्सर्वान्पावकादिति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2072227, "chapter_id": 2523, "verse_number": "१२-२८-११४", "content_sanskrit": "दर्शेन पूर्णमासेन चातुर्मास्यैः पुनः पुनः।\nअयजद्धयमेधेन सहस्रं परिवत्सरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2072228, "chapter_id": 2523, "verse_number": "१२-२८-११५", "content_sanskrit": "शतं गवां सहस्राणि शतमश्वशतानि च।\nउत्थायोत्थाय वै प्रादात्सहस्रं परिवत्सरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2072229, "chapter_id": 2523, "verse_number": "१२-२८-११६", "content_sanskrit": "तर्पयामास सोमेन देवान्वित्तैर्द्विजानपि।\nपितॄन्स्वधाभिः कामैश्च स्त्रियः स्वाः पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2072230, "chapter_id": 2523, "verse_number": "१२-२८-११७", "content_sanskrit": "सौवर्णां पृथिवीं कृत्वा दशव्यामां द्विरायताम्।\nदक्षिणामददद्राजा वाजिमेधे महाक्रतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2072231, "chapter_id": 2523, "verse_number": "१२-२८-११८", "content_sanskrit": "यावत्यः सिकता राजन्गङ्गायां पुरुषर्षभ।\nतावतीरेव गाः प्रादादाधूर्तरजसो गयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2072232, "chapter_id": 2523, "verse_number": "१२-२८-११९", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरश्चैव मा पुत्रमनुतप्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2072233, "chapter_id": 2523, "verse_number": "१२-२८-१२०", "content_sanskrit": "रन्तिदेवं च सांकृत्यं मृतं सृञ्जय शुश्रुम।\nसम्यगाराध्य यः शक्राद्वरं लेभे महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2072234, "chapter_id": 2523, "verse_number": "१२-२८-१२१", "content_sanskrit": "अन्नं च नो बहु भवेदतिथींश्च लभेमहि।\nश्रद्धा च नो मा व्यगमन्मा च याचिष्म कंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2072235, "chapter_id": 2523, "verse_number": "१२-२८-१२२", "content_sanskrit": "उपातिष्ठन्त पशवः स्वयं तं संशितव्रतम्।\nग्राम्यारण्या महात्मानं रन्तिदेवं यशस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2072236, "chapter_id": 2523, "verse_number": "१२-२८-१२३", "content_sanskrit": "महानदी चर्मराशेरुत्क्लेदात्ससृजे यतः।\nततश्चर्मण्वतीत्येवं विख्याता सा महानदी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2072237, "chapter_id": 2523, "verse_number": "१२-२८-१२४", "content_sanskrit": "ब्राह्मणेभ्यो ददौ निष्कान्सदसि प्रतते नृपः।\nतुभ्यंतुभ्यं निष्कमिति यदा क्रोशन्ति वै द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2072238, "chapter_id": 2523, "verse_number": "१२-२८-१२५", "content_sanskrit": "सहस्रं तुभ्यमित्युक्त्वा ब्राह्मणान्संप्रपद्य ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2072239, "chapter_id": 2523, "verse_number": "१२-२८-१२६", "content_sanskrit": "अन्वाहार्योपकरणं द्रव्योपकरणं च यत्।\nघटाः पात्र्यः कटाहानि स्थाल्यश्च पिठराणि च।\nनासीत्किंचिदसौवर्णं रन्तिदेवस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2072240, "chapter_id": 2523, "verse_number": "१२-२८-१२७", "content_sanskrit": "सांकृते रन्तिदेवस्य यां रात्रिमवसन्गृहे।\nआलभ्यन्त शतं गावः सहस्राणि च विंशतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2072241, "chapter_id": 2523, "verse_number": "१२-२८-१२८", "content_sanskrit": "तत्र स्म सूदाः क्रोशन्ति सुमृष्टमणिकुण्डलाः।\nसूपं भूयिष्ठमश्नीध्वं नाद्य मांसं यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2072242, "chapter_id": 2523, "verse_number": "१२-२८-१२९", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरश्चैव मा पुत्रमनुतप्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2072243, "chapter_id": 2523, "verse_number": "१२-२८-१३०", "content_sanskrit": "सगरं च महात्मानं मृतं शुश्रुम सृञ्जय।\nऐक्ष्वाकं पुरुषव्याघ्रमतिमानुषविक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2072244, "chapter_id": 2523, "verse_number": "१२-२८-१३१", "content_sanskrit": "षष्टिः पुत्रसहस्राणि यं यान्तमनुजग्मिरे।\nनक्षत्रराजं वर्षान्ते व्यभ्रे ज्योतिर्गणा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2072245, "chapter_id": 2523, "verse_number": "१२-२८-१३२", "content_sanskrit": "एकच्छत्रा मही यस्य प्रतापादभवत्पुरा।\nयोऽश्वमेधसहस्रेण तर्पयामास देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2072246, "chapter_id": 2523, "verse_number": "१२-२८-१३३", "content_sanskrit": "यः प्रादात्कनकस्तम्भं प्रासादं सर्वकाञ्चनम्।\nपूर्णं पझदलाक्षीणां स्त्रीणां शयनसंकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2072247, "chapter_id": 2523, "verse_number": "१२-२८-१३४", "content_sanskrit": "द्विजातिभ्योऽनुरूपेभ्यः कामांश्च विविधान्बहून्।\nयस्यादेशेन तद्वित्तं व्यभजन्त द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2072248, "chapter_id": 2523, "verse_number": "१२-२८-१३५", "content_sanskrit": "खानयामास यः कोपात्पृथिवीं सागराङ्किताम्।\nयस्य नाम्ना समुद्रश्च सागरत्वमुपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2072249, "chapter_id": 2523, "verse_number": "१२-२८-१३६", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरश्चैव मा पुत्रमनुतप्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2072250, "chapter_id": 2523, "verse_number": "१२-२८-१३७", "content_sanskrit": "राजानं च पृथुं वैन्यं मृतं शुश्रुम सृञ्जय।\nयमभ्यषिञ्चन्संभूयः महारण्ये महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2072251, "chapter_id": 2523, "verse_number": "१२-२८-१३८", "content_sanskrit": "प्रथयिष्यति वै लोकान्पृथुरित्येव शब्दितः।\nक्षताद्यो वै त्रायतीति स तस्मात्क्षत्रियः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2072252, "chapter_id": 2523, "verse_number": "१२-२८-१३९", "content_sanskrit": "पृथुं वैन्यं प्रजा दृष्ट्वा रक्तास्मेति यदब्रुवन्।\nततो राजेति नामास्य अनुरागादजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2072253, "chapter_id": 2523, "verse_number": "१२-२८-१४०", "content_sanskrit": "अकृष्टपच्या पृथिवी पुटकेपुटके मधु।\nसर्वा द्रोणदुघा गावो वैन्यस्यासन्प्रशासतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2072254, "chapter_id": 2523, "verse_number": "१२-२८-१४१", "content_sanskrit": "अरोगाः सर्वसिद्धार्था मनुष्या अकुतोभयाः।\nयथाऽभिकाममवसन्क्षेत्रेषु च गृहेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2072255, "chapter_id": 2523, "verse_number": "१२-२८-१४२", "content_sanskrit": "आपस्तस्तम्भिरे चास्य समुद्रमभियास्यतः।\nशैलाश्चापाद्व्यदीर्यन्त ध्वजभङ्गश्च नाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 2072256, "chapter_id": 2523, "verse_number": "१२-२८-१४३", "content_sanskrit": "हैरण्यांस्त्रिनरोत्सेधान्पर्वतानेकविंशतिम्।\nब्राह्मणेभ्यो ददौ राजा योश्वमेधे महामखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 2072257, "chapter_id": 2523, "verse_number": "१२-२८-१४४", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया।\nपुत्रात्पुण्यतरश्चैव मा पुत्रमनुतप्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 2072258, "chapter_id": 2523, "verse_number": "१२-२८-१४५", "content_sanskrit": "किं वा तूष्णीं ध्यायसे सृञ्जय त्वं\nन मे राजन्वाचिममां शृणोपि।\nन चेन्मोघं विप्रलप्तं ममेदं\nपथ्यं मुमूर्षोरिव सुप्रयुक्तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 2072259, "chapter_id": 2523, "verse_number": "१२-२८-१४६x", "content_sanskrit": "सृञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 2072260, "chapter_id": 2523, "verse_number": "१२-२८-१४६", "content_sanskrit": "शृणोमि ते नारद वाचमेनां\nविचित्रार्थां स्रजमिव पुण्यगन्धाम्।\nराजर्षीणां पुण्यकृतां महात्मनां\nकीर्त्या युक्तानां शोकनिर्नाशनार्थाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 2072261, "chapter_id": 2523, "verse_number": "१२-२८-१४७", "content_sanskrit": "न ते मोघं विप्रलप्तं महर्षे\nदृष्ट्वैवाहं नारद त्वां विशोकः।\nशुश्रूषे ते वचनं ब्रह्मवादि\nन्न ते तृप्याम्यमृतस्येव पानात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 2072262, "chapter_id": 2523, "verse_number": "१२-२८-१४८", "content_sanskrit": "अमोघदर्शिन्मम चेत्प्रसादं\nसंतापदग्धस्य विभो प्रकुर्याः।\nसुतस्य संजीवनमद्य मे स्या\nत्तव प्रसादात्सुतसङ्गमाप्नुयाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 2072263, "chapter_id": 2523, "verse_number": "१२-२८-१४९x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 2072264, "chapter_id": 2523, "verse_number": "१२-२८-१४९", "content_sanskrit": "यस्ते पुत्रः शयितोयं विजातः\nस्वर्णष्ठीवी यमदात्पर्वतस्ते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 2072265, "chapter_id": 2523, "verse_number": "१२-२८-१४९", "content_sanskrit": "पुनस्तं ते पुत्रमहं ददामि\nहिरण्यनाभं वर्षसबस्रिणं च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 2072266, "chapter_id": 2523, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि अष्टाविंशोऽध्यायः॥ २८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}]