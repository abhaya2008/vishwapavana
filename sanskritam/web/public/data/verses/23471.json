[{"id": 7003471000, "chapter_id": 23471, "verse_number": "१११-१", "content_sanskrit": "अथ कपिलाधेनुदानमाहात्म्यम् ।\nहोतोवाच ।\nअथातः सम्प्रवक्ष्यामि कपिलां धेनुमुत्तमाम् ।\nयत्प्रदानान्नरो याति विष्णुलोकमनुत्तमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003471001, "chapter_id": 23471, "verse_number": "१११-२", "content_sanskrit": "पूर्वोक्तेन विधानेन दद्याद्धेनुं सवत्सकाम् ।\nसर्वालङ्कारसंयुक्तां सर्वरत्नसमन्विताम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003471002, "chapter_id": 23471, "verse_number": "१११-३", "content_sanskrit": "कपिलायाः शिरो ग्रीवा सर्वतीर्थानि भामिनि ।\nपितामहनियोगाच्च निवसन्ति हि निश्चयः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003471003, "chapter_id": 23471, "verse_number": "१११-४", "content_sanskrit": "प्रातरुत्थाय यो मर्त्यः कपिलागलमस्तकात् ।\nच्युतं तु भक्त्या पानीयं शिरसा वन्दते शुचिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003471004, "chapter_id": 23471, "verse_number": "१११-५", "content_sanskrit": "स तेन पुण्यतोयेन तत्क्षणाद्दग्धकिल्बिषः ।\nत्रिंशद्वर्षकृतं पापं दहत्यग्निरिवेन्धनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003471005, "chapter_id": 23471, "verse_number": "१११-६", "content_sanskrit": "कल्यमुत्थाय यो मर्त्यः कुर्यात्तासां प्रदक्षिणम् ।\nप्रदक्षिणी कृता तेन पृथिवी स्याद्वसुन्धरे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003471006, "chapter_id": 23471, "verse_number": "१११-७", "content_sanskrit": "प्रदक्षिणेन चैकेन श्रद्धायुक्तेन तत्क्षणात् ।\nदशजन्मकृतं पापं तस्य नश्यत्यसंशयम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003471007, "chapter_id": 23471, "verse_number": "१११-८", "content_sanskrit": "कपिलायास्तु मूत्रेण स्नायाच्चैव शुचिव्रतः।\nस गङ्गादिषु तीर्थेषु स्नातो भवति मानवः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003471008, "chapter_id": 23471, "verse_number": "१११-९", "content_sanskrit": "तेन स्नानेन चैकेन भावयुक्तेन वै नरः ।\nयावज्जीवकृतात्पापान्मुच्यते नात्र संशयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003471009, "chapter_id": 23471, "verse_number": "१११-१०", "content_sanskrit": "गोसहस्रं च यो दद्यादेकां वा कपिलां नरः ।\nसममेतत्पुरा प्राह ब्रह्मा लोकपितामहः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003471010, "chapter_id": 23471, "verse_number": "१११-११", "content_sanskrit": "गवामस्थि ततोऽप्येतन्मृतगन्धेन दूषयेत् ।\nयावज्जिघ्रति तं गन्धं तावत्पुण्यैस्तु पूर्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003471011, "chapter_id": 23471, "verse_number": "१११-१२", "content_sanskrit": "गवां कण्डूयनं श्रेष्ठं तथा च परिपालनम् ।\nतुल्यं गोशतदानस्य भयरोगादिपालने ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003471012, "chapter_id": 23471, "verse_number": "१११-१३", "content_sanskrit": "तृणादिकानि यो दद्यात्क्षुधितेन गवाह्निकम् ।\nगोमेधस्य फलं दिव्यं लभते मानवोत्तमः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003471013, "chapter_id": 23471, "verse_number": "१११-१४", "content_sanskrit": "विमानैर्विविधैर्दिव्यैः कन्याभिरभितोऽर्पितैः ।\nसेव्यमानः सुगन्धैर्वै दीप्यमान इवाग्नयः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003471014, "chapter_id": 23471, "verse_number": "१११-१५", "content_sanskrit": "सुवर्णकपिला पूर्वं द्वितीया गौरपिङ्गला ।\nतृतीया चैव रक्ताक्षी चतुर्थी गुडपिंगला ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003471015, "chapter_id": 23471, "verse_number": "१११-१६", "content_sanskrit": "पंचमी बहुवर्णा स्यात्षष्ठी च श्वेतपिङ्गला।\nसप्तमी श्वेतपिंगाक्षी त्वष्टमी कृष्णपिंगला ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003471016, "chapter_id": 23471, "verse_number": "१११-१७", "content_sanskrit": "नवमी पाटला ज्ञेया दशमी पुच्छपिंगला ।\nएकादशी खुरश्वेता त्वेतासां सर्वलक्षणाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003471017, "chapter_id": 23471, "verse_number": "१११-१८", "content_sanskrit": "सर्वलक्षणसंयुक्ता सर्वालंकृतसुन्दरी ।\nब्राह्मणाय प्रदातव्या भुक्तिमुक्तिप्रदायिनी ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003471018, "chapter_id": 23471, "verse_number": "१११-१९", "content_sanskrit": "भुक्तिमुक्तिप्रदा तेषां विष्णुमार्गप्रदायिनी ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]