[{"id": 2001090, "chapter_id": 1009, "verse_number": "१-१०-०x", "content_sanskrit": "रुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001091, "chapter_id": 1009, "verse_number": "१-१०-१", "content_sanskrit": "मम प्राणसमा भार्या दष्टासीद्भुजगेन ह।\nतत्र मे समयो घोर आत्मनोरग वै कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001092, "chapter_id": 1009, "verse_number": "१-१०-२", "content_sanskrit": "भुजंगं वै सदा हन्यां यं यं पश्येयमित्युत।\nततोऽहं त्वां जिघांसामि जीवितेनाद्य मोक्ष्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001093, "chapter_id": 1009, "verse_number": "१-१०-३x", "content_sanskrit": "डुण्डुभ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001094, "chapter_id": 1009, "verse_number": "१-१०-३", "content_sanskrit": "अन्ये ते भुजगा ब्रह्मन्ये दश्तीह मानवान्।\nडुण्डुभानहिगन्धेन न त्वं हिंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001095, "chapter_id": 1009, "verse_number": "१-१०-४", "content_sanskrit": "एकानर्थान्पृथग्धर्मानेकदुःखान्पृथक्सुखान्।\nडुण्डुभान्धर्मविद्भूत्वा न त्वं हिंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001096, "chapter_id": 1009, "verse_number": "१-१०-५x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001097, "chapter_id": 1009, "verse_number": "१-१०-५", "content_sanskrit": "इति श्रुत्वा वचस्तस्य डुण्डुभस्य रुरुस्तदा।\nनावधीद्भयसंविग्नमृषिं मत्त्वाऽथ डुण्डुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001098, "chapter_id": 1009, "verse_number": "१-१०-६", "content_sanskrit": "उवाच चैनं भगवान्रुरुः संशमयन्निव।\nकेन त्वं भुजग ब्रूहि कोऽसीमां विक्रियां गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001099, "chapter_id": 1009, "verse_number": "१-१०-७x", "content_sanskrit": "डुण्डुभ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001100, "chapter_id": 1009, "verse_number": "१-१०-७", "content_sanskrit": "अहं पुरा रुरो नाम्ना ऋषिरासं सहस्रपात्।\nसोऽहं शापेन विप्रस्य भुजगत्वमुपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001101, "chapter_id": 1009, "verse_number": "१-१०-८x", "content_sanskrit": "रुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001102, "chapter_id": 1009, "verse_number": "१-१०-८", "content_sanskrit": "किमर्थं शप्तवान्कुद्धो द्विजस्त्वां भुजगोत्तम।\nकियन्तं चैव कालं ते वपुरेतद्भविष्यसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001103, "chapter_id": 1009, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि पौलोमपर्वणि दशमोऽध्यायः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]