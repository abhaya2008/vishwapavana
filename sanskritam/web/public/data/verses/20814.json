[{"id": 7000814000, "chapter_id": 20814, "verse_number": "६-१५७-१", "content_sanskrit": "महादेव उवाच ।\nदुग्धेश्वरसमीपे तु तीर्थं चातीवपावनम् ।\nरम्यं तत्पिप्पलादस्य नाम्ना वै प्रथितं भुवि॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000814001, "chapter_id": 20814, "verse_number": "६-१५७-२", "content_sanskrit": "यत्र कृत्वा तपः पूर्वं मातुर्वचनतो मुनिः ।\nउत्पादयामास कृत्यां वडवानलसम्मिताम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000814002, "chapter_id": 20814, "verse_number": "६-१५७-३", "content_sanskrit": "पितुरानृण्यमन्विच्छन्दधीचस्य महात्मनः ।\nतत्र स्नात्वा च पीत्वा च ब्रह्महत्यां व्यपोहति॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000814003, "chapter_id": 20814, "verse_number": "६-१५७-४", "content_sanskrit": "साभ्रमत्यास्तटे गुप्तं पिप्पलादं सुरेश्वरम् ।\nतत्र स्नात्वा तु भो देवि मुक्तिभागी भवेन्नरः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000814004, "chapter_id": 20814, "verse_number": "६-१५७-५", "content_sanskrit": "आरोपणं पिप्पलानां कर्त्तव्यं विधिपूर्वकम् ।\nकृते सति महादेवि मुच्यते कर्मबंधनात्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000814005, "chapter_id": 20814, "verse_number": "६-१५७-६", "content_sanskrit": "पार्वत्युउवाच ।\nकिमर्थं सा तु कृत्या वै उत्पन्ना तां निबोधय ।\nतया वै कृत्यया पूर्वं किं कृतं वद मे प्रभो॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000814006, "chapter_id": 20814, "verse_number": "६-१५७-७", "content_sanskrit": "येन पुत्रेण सा नीता पितुरानृण्यकारणात्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000814007, "chapter_id": 20814, "verse_number": "६-१५७-८", "content_sanskrit": "महादेव उवाच ।\nदाधीचो ऋषिवर्योऽसौ ह्यागतस्तपकारणात् ।\nअत्र तेन महत्तप्तमृषिणा परमात्मना॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000814008, "chapter_id": 20814, "verse_number": "६-१५७-९", "content_sanskrit": "तत्र कोलासुरो नाम विघ्नार्थं वै समागतः ।\nतेन विघ्नं बहुतरं कृतं वै नात्र संशयः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000814009, "chapter_id": 20814, "verse_number": "६-१५७-१०", "content_sanskrit": "तद्दृष्टं तु सुपुत्रेण कहोडेन च धीमता ।\nकृत्या ह्युत्पादिता तत्र हननार्थं सुरेश्वरि॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000814010, "chapter_id": 20814, "verse_number": "६-१५७-११", "content_sanskrit": "तया वै निहतो दैत्यः कोलो नाम महासुरः ।\nतस्मात्तीर्थं महज्जातं कलौ गुप्तं तु पार्वति॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]