[{"id": 50026143, "chapter_id": 12079, "verse_number": "1", "content_sanskrit": "मन्त्राश्च लोकपालानां नमोन्ताः सर्वकामदाः। नीलरक्तासितश्वेतरक्तशुक्लाश्च वर्णतः॥ ८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50026144, "chapter_id": 12079, "verse_number": "2", "content_sanskrit": "सप्रियाः साभया वज्रशक्तिदण्डासिपाशिनः। गदाकुमुदशूलेष्टखड्गिनो भूषणोज्वलाः॥ ८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}]