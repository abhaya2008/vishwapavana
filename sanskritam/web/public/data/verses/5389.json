[{"id": 2206194, "chapter_id": 5389, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2206195, "chapter_id": 5389, "verse_number": "१", "content_sanskrit": "के पूज्याः के नमस्कार्याः कथं वर्तेत केषु च ।\nकिमाचारः कीदृशेषु पितामह न रिष्यते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2206196, "chapter_id": 5389, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2206197, "chapter_id": 5389, "verse_number": "२", "content_sanskrit": "ब्राह्मणानां परिभवः सादयेदपि देवताः ।\nब्राह्मणानां नमस्कर्ता युधिष्ठिर न रिष्यते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2206198, "chapter_id": 5389, "verse_number": "३", "content_sanskrit": "ते पूज्यास्ते नमस्कार्या वर्तेथास्तेषु पुत्रवत् ।\nते हि लोकानिमान् सर्वान् धारयन्ति मनीषिणः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2206199, "chapter_id": 5389, "verse_number": "४", "content_sanskrit": "ब्राह्मणाः सर्वलोकानां महान्तो धर्मसेतवः ।\nधनत्यागाभिरामाश्च वाक्संयमरताश्च ये\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2206200, "chapter_id": 5389, "verse_number": "५", "content_sanskrit": "रमणीयाश्च भूतानां निधानं च धृतव्रताः ।\nप्रणेतारश्च लोकानां शास्त्राणां च यशस्विनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2206201, "chapter_id": 5389, "verse_number": "६", "content_sanskrit": "तपो येषां धनं नित्यं वाक् चैव विपुलं बलम् ।\nप्रभवश्चापि धर्माणां धर्मज्ञाः सूक्ष्मदर्शिनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2206202, "chapter_id": 5389, "verse_number": "७", "content_sanskrit": "धर्मकामाः स्थिता धर्मे सुकृतैर्धर्मसेतवः ।\nयानुपाश्रित्य जीवन्ति प्रजाः सर्वाश्चतुर्विधाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2206203, "chapter_id": 5389, "verse_number": "८", "content_sanskrit": "पन्थानः सर्वनेतारो यज्ञवाहाः सनातनाः ।\nपितृपैतामहीं गुर्वीमुद्वहन्ति धुरं सदा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2206204, "chapter_id": 5389, "verse_number": "९", "content_sanskrit": "धुरि ये नावसीदन्ति विषमे सद्गवा इव ।\nपितृदेवातिथिमुखा हव्यकव्याग्रभोजिनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2206205, "chapter_id": 5389, "verse_number": "१०", "content_sanskrit": "भोजनादेव ये लोकान् त्रायन्ते महतो भयात् ।\nदीपाः सर्वस्य लोकस्य चक्षुश्चक्षुष्मतामपि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2206206, "chapter_id": 5389, "verse_number": "११", "content_sanskrit": "सर्वशिल्पादिनिधयो निपुणाः सूक्ष्मदर्शिनः ।\nगतिज्ञाः सर्वभूतानामध्यात्मगतिचिन्तकाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2206207, "chapter_id": 5389, "verse_number": "१२", "content_sanskrit": "आदिमध्यावसानानां ज्ञातारश्छिन्नसंशयाः ।\nपरावरविशेषज्ञा गन्तारः परमां गतिम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2206208, "chapter_id": 5389, "verse_number": "१३", "content_sanskrit": "विमुक्ता धूतपाप्मानो निर्द्वन्द्वा निष्परिग्रहाः ।\nमानार्हा मानिता नित्यं ज्ञानविद्भिर्महात्मभिः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2206209, "chapter_id": 5389, "verse_number": "१४", "content_sanskrit": "चन्दने मलपङ्के च भोजनेऽभोजने समाः ।\nसमं येषां दुकूलं च शाणक्षौमाजिनानि च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2206210, "chapter_id": 5389, "verse_number": "१५", "content_sanskrit": "तिष्ठेयुरप्यभुञ्जाना बहूनि दिवसान्यपि ।\nशोषयेयुश्च गात्राणि स्वाध्यायैः संयतेन्द्रियाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2206211, "chapter_id": 5389, "verse_number": "१६", "content_sanskrit": "अदैवं दैवतं कुर्युर्दैवतं चाप्यदैवतम् ।\nलोकानन्यान् सृजेयुश्च लोकपालांश्च कोपिताः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2206212, "chapter_id": 5389, "verse_number": "१७", "content_sanskrit": "अपेयः सागरो येषामभिशापान्महात्मनाम् ।\nयेषां कोपाग्निरद्यापि दण्डके नोपशाम्यति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2206213, "chapter_id": 5389, "verse_number": "१८", "content_sanskrit": "देवानामपि ये देवाः कारणं कारणस्य च ।\nप्रमाणस्य प्रमाणं च कस्तानभिभवेद् बुधः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2206214, "chapter_id": 5389, "verse_number": "१९", "content_sanskrit": "येषां वृद्धश्च बालश्च सर्वः सम्मानमर्हति ।\nतपोविद्याविशेषात् तु मानयन्ति परस्परम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2206215, "chapter_id": 5389, "verse_number": "२०", "content_sanskrit": "अविद्वान् ब्राह्मणो देवः पात्रं वै पावनं महत् ।\nविद्वान् भूयस्तरो देवः पूर्णसागरसन्निभः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2206216, "chapter_id": 5389, "verse_number": "२१", "content_sanskrit": "अविद्वांश्चैव विद्वांश्च ब्राह्मणो दैवतं महत् ।\nप्रणीतश्चाप्रणीतश्च यथाग्निर्दैवतं महत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2206217, "chapter_id": 5389, "verse_number": "२२", "content_sanskrit": "श्मशाने ह्यपि तेजस्वी पावको नैव दुष्यति ।\nहविर्यज्ञेषु च वहन् भूय एवाभिशोभते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2206218, "chapter_id": 5389, "verse_number": "२३", "content_sanskrit": "एवं यद्यप्यनिष्टेषु वर्तते सर्वकर्मसु ।\nसर्वथा ब्राह्मणो मान्यो दैवतं विद्धि तत् परम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2206219, "chapter_id": 5389, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे ब्राह्मणमाहात्म्यकथनं नाम चत्वारिंशोत्तरद्विशततमोऽध्यायः ॥१४०॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]