[{"id": 2105662, "chapter_id": 3282, "verse_number": "१६-११-१", "content_sanskrit": "वैशम्पायन उवाच।\nएवमुक्तास्तु ते तेन पौरजानपदा जनाः।\nवृद्धेन राज्ञा कौरव्य नष्टसंज्ञा इवाभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105663, "chapter_id": 3282, "verse_number": "१६-११-२", "content_sanskrit": "तूष्णींभूतांस्ततस्तांस्तु वाष्पकण्ठान्महीपतिः।\nधृतराष्ट्रो महीपालः पुनरेवाभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105664, "chapter_id": 3282, "verse_number": "१६-११-३", "content_sanskrit": "वृद्धं च हतपुत्रं च धर्मपत्न्या सहानया।\nविलपन्तं बहुविधं कृपणं चैव सत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105665, "chapter_id": 3282, "verse_number": "१६-११-४", "content_sanskrit": "पित्रा स्वयमनुज्ञातं कृष्णद्वैपायनेन वै।\nवनवासाय धर्मज्ञा धर्मजेन नृपेण ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105666, "chapter_id": 3282, "verse_number": "१६-११-५", "content_sanskrit": "सोहं पुनःपुनर्याचे शिरसाऽवनतोऽनघाः।\nगान्धार्या सहितं तन्मां समनुज्ञातुमर्हथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105667, "chapter_id": 3282, "verse_number": "१६-११-६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105668, "chapter_id": 3282, "verse_number": "१६-११-६", "content_sanskrit": "तच्छ्रुत्वा कुरुराजस्य वाक्यानि करुणानि ते।\nरुरुदुः सर्वशो राजन्समेताः कुरुजाङ्गलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105669, "chapter_id": 3282, "verse_number": "१६-११-७", "content_sanskrit": "उत्तरीयैः करैश्चापि संछाद्य वदनानि ते।\nरुरुदुः शोकसंतप्ता मुहूर्तं पितृमातृवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105670, "chapter_id": 3282, "verse_number": "१६-११-८", "content_sanskrit": "हृदयैः शून्यभूतैस्ते धृतराष्ट्रप्रवासजम्।\nदुःखं संधारयन्तो हि नष्टसंज्ञा हवाभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105671, "chapter_id": 3282, "verse_number": "१६-११-९", "content_sanskrit": "ते विनीय तमायासं धृतराष्ट्रवियोगजम्।\nशनैः शनैस्तदाऽन्योन्यमब्रुवन्स्वमतान्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105672, "chapter_id": 3282, "verse_number": "१६-११-१०", "content_sanskrit": "ततः सञ्चिन्त्य ते सर्वे वाक्यान्यथ समासतः।\nएकस्मिन्ब्राह्मणे कार्यमावेस्योचुर्नराधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105673, "chapter_id": 3282, "verse_number": "१६-११-११", "content_sanskrit": "ततः स्वाचरणो विप्रः सम्मतोऽर्थविशारदः।\nसम्भाव्यो बह्वृचो राजन्वक्तुं समुपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105674, "chapter_id": 3282, "verse_number": "१६-११-१२", "content_sanskrit": "अनुमान्य महाराजं सदः समनुभाष्य च।\nविप्रः प्रगल्भो मेधावी स राजानमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105675, "chapter_id": 3282, "verse_number": "१६-११-१३", "content_sanskrit": "राजन्वाक्यं जनस्यास्य मयि सर्वं समर्पितम्।\nवक्ष्यामि तदहं वीर तज्जुषस्व नपाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105676, "chapter_id": 3282, "verse_number": "१६-११-१४", "content_sanskrit": "यथा वदसि राजेन्द्र सर्वमेतत्तथा विभो।\nनात्र मिथ्या वचः किञ्चित्सुहृत्त्वं नः परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105677, "chapter_id": 3282, "verse_number": "१६-११-१५", "content_sanskrit": "न जात्वस्य च वंशस्य राज्ञां कश्चित्कदाचन।\nराजाऽऽसीद्यः प्रजापालः प्रजानामप्रियोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105678, "chapter_id": 3282, "verse_number": "१६-११-१६", "content_sanskrit": "पितृवन्मातृवच्चैव भवन्तः पालयन्ति नः।\nन च दुर्योधनः किञ्चिदयुक्तं कृतवान्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105679, "chapter_id": 3282, "verse_number": "१६-११-१७", "content_sanskrit": "`प्रियाणि कुर्वन्सर्वेषामनुवृत्त्यर्थमुद्यतः।\nयथा ब्रवीति धर्मात्मा मुनिः सत्यवतीसुतः।\nतथा कुरु महाराज स हि नः परमो गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105680, "chapter_id": 3282, "verse_number": "१६-११-१८", "content_sanskrit": "त्यक्ता वयं तु भवता दुःखशोकपरायणाः।\nभविष्यामश्चिरं राजन्भवद्गुणशतैर्हृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105681, "chapter_id": 3282, "verse_number": "१६-११-१९", "content_sanskrit": "यथा शन्तनुना गुप्ता राज्ञा चित्राङ्गदेन च।\nभीष्मवीर्योपगूढेन पित्रा तव च पार्थिव।\nभवद्बुद्धियुजा चैवि पाण्डुना पृथिवीक्षिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105682, "chapter_id": 3282, "verse_number": "१६-११-२०", "content_sanskrit": "तथा दुर्योधनेनापि राज्ञा सुपरिपालिताः।\nन स्वल्पमपि पुत्रस्ते व्यलीकं कृतवान्नृप।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105683, "chapter_id": 3282, "verse_number": "१६-११-२१", "content_sanskrit": "पितरीव सुविश्वस्तास्तस्मिन्नपि नराधिपे।\nवयसा स्म यथा सम्यग्भवतो विदितं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105684, "chapter_id": 3282, "verse_number": "१६-११-२२", "content_sanskrit": "तथा वर्षसहस्राणि कुन्तीपुत्रेण धीमता।\nपाल्यमाना धृतिमता सुखं विन्दामहे नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105685, "chapter_id": 3282, "verse_number": "१६-११-२३", "content_sanskrit": "राजर्षीणां पुराणानां भवतां पुण्यकर्मणाम्।\nकुरुसंवरणादीनां भरतस्य च धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2105686, "chapter_id": 3282, "verse_number": "१६-११-२४", "content_sanskrit": "वृत्तं समनुयात्येष धर्मात्मा भूरिदक्षिणः।\nनात्र वाच्यं महाराज सुसूक्ष्ममपि विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2105687, "chapter_id": 3282, "verse_number": "१६-११-२५", "content_sanskrit": "उषिताः स्म सुखं नित्यं भवता परिपालिताः।\nसुसूक्ष्मं च व्यलीकं ते सपुत्रस्य न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2105688, "chapter_id": 3282, "verse_number": "१६-११-२६", "content_sanskrit": "यत्तु ज्ञातिविमर्देऽस्मिन्नात्थ दुर्योधनं प्रति।\nभन्तमनुनेष्यामि तत्रापि कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2105689, "chapter_id": 3282, "verse_number": "१६-११-२७", "content_sanskrit": "न तद्दुर्योधनकृतं न च तद्भवता कृतम्।\nन कर्णसौबलाभ्यां च कुरवो यत्क्षयं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2105690, "chapter_id": 3282, "verse_number": "१६-११-२८", "content_sanskrit": "दैवं तत्तु विजानीमो यन्न शक्यं प्रबाधितुम्।\nदैवं पुरुषकारेणि न शक्यमपि बाधितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2105691, "chapter_id": 3282, "verse_number": "१६-११-२९", "content_sanskrit": "अक्षौहिण्यो महाराज दशाष्टौ च समागताः।\nअष्टादशाहेन हताः कुरुभिर्योधपुङ्गवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2105692, "chapter_id": 3282, "verse_number": "१६-११-३०", "content_sanskrit": "भीष्मद्रोणकृपाद्यैश्च कर्णेन च महात्मना।\nयुयुधानेन वीरेण धृष्टद्युम्नेन चाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2105693, "chapter_id": 3282, "verse_number": "१६-११-३१", "content_sanskrit": "चतुर्भिः पाण्डुपुत्रैश्च भीमार्जुनयमैस्तथा।\nन च क्षयोऽयं नृपते क्रते दैवबलादभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2105694, "chapter_id": 3282, "verse_number": "१६-११-३२", "content_sanskrit": "अवश्यमेव सङ्ग्रामे क्षत्रियेण विशेषतः।\nकर्तव्यं निधनं काले मर्तव्यं क्षत्रबन्धुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2105695, "chapter_id": 3282, "verse_number": "१६-११-३३", "content_sanskrit": "तैरियं पुरुषव्याघ्रैर्विद्याबाहुबलान्वितैः।\nपृथिवी निहता सर्वा सहया सरथद्विपा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2105696, "chapter_id": 3282, "verse_number": "१६-११-३४", "content_sanskrit": "न स राज्ञां वधे सूनुः कारणं ते महात्मनाम्।\nन भवान्न च ते भृत्या न कर्णो न च सौबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2105697, "chapter_id": 3282, "verse_number": "१६-११-३५", "content_sanskrit": "यद्विशस्ताः कुरुश्रेष्ठ राजानश्च सहस्रशः।\nसर्वं दैवकृतं विद्धि कोत्र किं वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2105698, "chapter_id": 3282, "verse_number": "१६-११-३६", "content_sanskrit": "गुरुर्मतो भवानस्य कृत्स्नस्य जगतः प्रभुः।\nधर्मात्मानमतस्तुभ्यमनुजानीमहे सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2105699, "chapter_id": 3282, "verse_number": "१६-११-३७", "content_sanskrit": "लभतां वीरलोकं स ससहायो नराधिपः।\nद्विजाग्र्यैः समनुज्ञातस्त्रिदिवे मोदतां सुखम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2105700, "chapter_id": 3282, "verse_number": "१६-११-३८", "content_sanskrit": "प्राप्स्यते च भवान्पुण्यं धर्मे च सततं स्थितः।\nवेद धर्मं महाबाहो लौक्यं वैदिकमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2105701, "chapter_id": 3282, "verse_number": "१६-११-३९", "content_sanskrit": "दृष्टापदानाश्चास्माभिः पाण्डवाः पुरुषर्षभाः।\nसमर्थास्त्रिदिवस्यापि पालने किं पुनः क्षितेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2105702, "chapter_id": 3282, "verse_number": "१६-११-४०", "content_sanskrit": "अनुवर्त्स्यन्ति वा धीमन्समेषु विषमेषु च।\nप्रजाः कुरुकुलश्रेष्ठ पाण्डवाञ्शीलभूषणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2105703, "chapter_id": 3282, "verse_number": "१६-११-४१", "content_sanskrit": "ब्रह्मदेयाग्रहारांश्च पारिबर्हांश्च पार्थिवः।\nपूर्वराजातिसर्गांश्च पालयत्येव पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2105704, "chapter_id": 3282, "verse_number": "१६-११-४२", "content_sanskrit": "दीर्घदर्शीं मृदुर्दान्तः सदा वैश्रवणो यथा।\nअक्षुद्रसचिवश्चायं कुन्तीपुत्रो महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2105705, "chapter_id": 3282, "verse_number": "१६-११-४३", "content_sanskrit": "अप्यमित्रे दयावांश्च शुचिश्च भरतर्षभः।\nऋजु पश्यति मेधावी पुत्रवत्पाति नः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2105706, "chapter_id": 3282, "verse_number": "१६-११-४४", "content_sanskrit": "विप्रियं च जनस्यास्य संसर्गाद्धर्मजस्य वै।\nन करिष्यन्ति राजर्षे तथा भीमार्जुनादयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2105707, "chapter_id": 3282, "verse_number": "१६-११-४५", "content_sanskrit": "मन्दा मृदुषु कौरव्य तीक्ष्णेष्वाशीविषोपमाः।\nवीर्यवन्तो महात्मानः पौराणां च हिते रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2105708, "chapter_id": 3282, "verse_number": "१६-११-४६", "content_sanskrit": "न कुन्ती न च पाञ्चाली न चोलूपी न सात्वती।\nअस्मिञ्जने करिष्यन्ति प्रतिकूलानि कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2105709, "chapter_id": 3282, "verse_number": "१६-११-४७", "content_sanskrit": "भवत्कृतमिमं स्नेहं युधिष्ठिरविवर्धितम्।\nन पृष्ठतः करिष्यन्ति पौरा जानपदा जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2105710, "chapter_id": 3282, "verse_number": "१६-११-४८", "content_sanskrit": "अधर्मिष्ठानपि सतः कुन्तीपुत्रा महारथाः।\nमानवान्पालयिष्यन्ति भूत्वा धर्मपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2105711, "chapter_id": 3282, "verse_number": "१६-११-४९", "content_sanskrit": "स राजन्मानसं दुःखमपनीय युधिष्ठिरात्।\nकुरु कार्याणि धर्म्याणि नमस्ते पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2105712, "chapter_id": 3282, "verse_number": "१६-११-५०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2105713, "chapter_id": 3282, "verse_number": "१६-११-५०", "content_sanskrit": "तस्य तद्वचनं धर्म्यमनुमान्य गुणोत्तरम्।\nसाधुसाध्विति सर्वः स जनः प्रतिगृहीतवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2105714, "chapter_id": 3282, "verse_number": "१६-११-५१", "content_sanskrit": "धृतराष्ट्राश्च तद्वाक्यमभिपूज्य पुनःपुनः।\nविसर्जयामास तदा प्रकृतीस्तु शनैःशनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2105715, "chapter_id": 3282, "verse_number": "१६-११-५२", "content_sanskrit": "स तैः सम्पूजितो राजा शिवेनावेक्षितस्तथा।\nप्राञ्जलिः पूजयामास तं जनं भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2105716, "chapter_id": 3282, "verse_number": "१६-११-५३", "content_sanskrit": "ततो विवेश भवनं गान्धार्या सहितो निजम्।\nआगतायां च शर्वर्यां सुखं शेते नराधिपः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2105717, "chapter_id": 3282, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आमश्रवासिकपर्वणि आश्रमवासपर्वणि एकादशोऽध्यायः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]