[{"id": 2006019, "chapter_id": 1119, "verse_number": "१-१२०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006020, "chapter_id": 1119, "verse_number": "१-१२०-१", "content_sanskrit": "शूरो नाम यदुश्रेष्ठो वसुदेवपिताऽभवत्।\nतस्य कन्या पृथा नाम रूपेणाप्रतिमा भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006021, "chapter_id": 1119, "verse_number": "१-१२०-२", "content_sanskrit": "पितृष्वस्रीयाय स तामनपत्याय भारत।\nअग्र्यमग्रे प्रतिज्ञाय स्वस्यापत्यं स सत्यवाक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006022, "chapter_id": 1119, "verse_number": "१-१२०-३", "content_sanskrit": "अग्रजामथ तां कन्यां शूरोऽनुग्रहकाङ्क्षिणे।\nप्रददौ कुन्तिभोजाय सखा सख्ये महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006023, "chapter_id": 1119, "verse_number": "१-१२०-४", "content_sanskrit": "नियुक्ता सा पितुर्गेहे ब्राह्मणातिथिपूजने।\nउग्रं पर्यचरत्तत्र ब्राह्मणं संशितब्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006024, "chapter_id": 1119, "verse_number": "१-१२०-५", "content_sanskrit": "निगूढनिश्चयं धर्मे यं तं दुर्वाससं विदुः।\nतमुग्रं संशितात्मानं सर्वयत्नैरतोषयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006025, "chapter_id": 1119, "verse_number": "१-१२०-६", "content_sanskrit": "दध्याज्यकादिभिर्नित्यं व्यञ्जनैः प्रत्यहं शुभा।\nसहस्रसङ्ख्यैर्योगीन्द्रमुपचारदनुत्तमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006026, "chapter_id": 1119, "verse_number": "१-१२०-७", "content_sanskrit": "दुर्वासा वत्सरस्यान्ते ददौ मन्त्रमनुत्तमम्।\nयशस्विन्यै पृथायै तदापद्धर्मान्ववेक्षया।\nअभिचाराभिसंयुक्तमब्रवीच्चैव तां मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006027, "chapter_id": 1119, "verse_number": "१-१२०-८", "content_sanskrit": "यं यं देवं त्वमेतेन मन्त्रेणावाहयिष्यसि।\nतस्य तस्य प्रभावेण तव पुत्रो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006028, "chapter_id": 1119, "verse_number": "१-१२०-९", "content_sanskrit": "तथोक्ता सा तु विप्रेण कुन्ती कौतूहलान्विता।\nकन्या सती देवमर्कमाजुहाव यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006029, "chapter_id": 1119, "verse_number": "१-१२०-१०", "content_sanskrit": "ततो घनान्तरं कृत्वा स्वमार्गं तपनस्तदा।\nउपतस्थे स तां कन्यां पृथां पृथुललोचनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006030, "chapter_id": 1119, "verse_number": "१-१२०-११", "content_sanskrit": "सा ददर्श तमायान्तं भास्करं लोकभावनम्।\nविस्मिता चानवद्याङ्गी दृष्ट्वा तन्महदद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006031, "chapter_id": 1119, "verse_number": "१-१२०-१२", "content_sanskrit": "साब्रवीद्भगवन्कस्त्वमाविर्भूतो ममाग्रतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006032, "chapter_id": 1119, "verse_number": "१-१२०-१२x", "content_sanskrit": "आदित्य उवाच।\nआहूतोपस्थितं भद्रे ऋषिमन्त्रेण चोदितम्।\nविद्धि मां पुत्रलाभाय देवमर्कं शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006033, "chapter_id": 1119, "verse_number": "१-१२०-१३", "content_sanskrit": "पुत्रस्ते निर्मितः सुभ्रु शृणु महादृक्छुभानने।\nआदित्ये कुण्डले बिभ्रत्कवचं चैव मामकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006034, "chapter_id": 1119, "verse_number": "१-१२०-१४", "content_sanskrit": "शस्त्रास्त्राणामभेद्यश्च भविष्यति शुचिस्मिते।\nनास्य किंचिददेयं च ब्राह्मणेभ्यो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006035, "chapter_id": 1119, "verse_number": "१-१२०-१५", "content_sanskrit": "चोद्यमानो मया चापि न क्षमं चिन्तयिष्यति।\nदास्यत्येव हि विप्रेभ्यो मानी चैव भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006036, "chapter_id": 1119, "verse_number": "१-१२०-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006037, "chapter_id": 1119, "verse_number": "१-१२०-१६", "content_sanskrit": "एवमुक्ता ततः कुन्ती गोपतिं प्रत्युवाच ह।\nकन्या पितृसा चाहं पुरुषार्थो न चैव मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006038, "chapter_id": 1119, "verse_number": "१-१२०-१७", "content_sanskrit": "कश्चिन्मे ब्राह्मणः प्रादाद्वरं विद्यां च शत्रुहन्।\nतद्विजिज्ञासयाऽऽह्वानं कृतवत्यस्मि ते विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006039, "chapter_id": 1119, "verse_number": "१-१२०-१८", "content_sanskrit": "एतस्मिन्नपराधे त्वां शिरसाऽहं प्रसादये।\nयोषितो हि सदा रक्ष्यास्त्वपराधेऽपि नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006040, "chapter_id": 1119, "verse_number": "१-१२०-१९x", "content_sanskrit": "सूर्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2006041, "chapter_id": 1119, "verse_number": "१-१२०-१९", "content_sanskrit": "वेदाहं सर्वमेवैतद्यद्दुर्वासा वरं ददौ।\nसंत्यज्य भयमेवेह क्रियतां सङ्गमो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2006042, "chapter_id": 1119, "verse_number": "१-१२०-२०", "content_sanskrit": "अमोघं दर्शनं मह्यमाहूतश्चास्मि ते शुभे।\nवृथाऽऽह्वानेऽपि ते भीरु दोषः स्यान्नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2006043, "chapter_id": 1119, "verse_number": "१-१२०-२१", "content_sanskrit": "यद्येवं मन्यसे भीरु किमाह्वयसि भास्करम्।\nयदि मामवजानासि ऋषिः स न भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2006044, "chapter_id": 1119, "verse_number": "१-१२०-२२", "content_sanskrit": "मन्त्रदानेन यस्मात्त्वमवलेपेन दर्पिता।\nकुलं च तेऽद्य धक्ष्यामि क्रोधदीप्तेन चक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2006045, "chapter_id": 1119, "verse_number": "१-१२०-२३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2006046, "chapter_id": 1119, "verse_number": "१-१२०-२३", "content_sanskrit": "एवमुक्ता बहुविधं सान्त्वपूर्वं विवस्वता।\nसा तु नैच्छद्वरारोहा कन्याहमिति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2006047, "chapter_id": 1119, "verse_number": "१-१२०-२४", "content_sanskrit": "बन्धुपक्षभयाद्भीता लज्जया च यशस्विनी।\nतामर्कः पुनरेवेदब्रवीद्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2006048, "chapter_id": 1119, "verse_number": "१-१२०-२५", "content_sanskrit": "मत्प्रसादान्न ते राज्ञि भविता दोष इत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2006049, "chapter_id": 1119, "verse_number": "१-१२०-२६x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2006050, "chapter_id": 1119, "verse_number": "१-१२०-२६", "content_sanskrit": "प्रसीद भगवन्मह्यमवलेपो हि नास्ति मे।\nत्वयैव परिहार्यं स्यात्कन्याभावस्य दूषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2006051, "chapter_id": 1119, "verse_number": "१-१२०-२७x", "content_sanskrit": "आदित्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2006052, "chapter_id": 1119, "verse_number": "१-१२०-२७", "content_sanskrit": "व्यपयातु भयं तेऽद्य कुमारं प्रसमीक्षसे।\nमया त्वं चाप्यनुज्ञाता पुनः कन्या भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2006053, "chapter_id": 1119, "verse_number": "१-१२०-२८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2006054, "chapter_id": 1119, "verse_number": "१-१२०-२८", "content_sanskrit": "एवमुक्ता ततः कुन्ती संप्रहृष्टतनूरुहा।\nसङ्गताऽभूत्तदा सुभ्रूरादित्येन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2006055, "chapter_id": 1119, "verse_number": "१-१२०-२९", "content_sanskrit": "प्रकाशकर्मा तपनः कन्यागर्भं ददौ पुनः।\nतत्र वीरः समभवत्सर्वशस्त्रभृतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2006056, "chapter_id": 1119, "verse_number": "१-१२०-३०", "content_sanskrit": "आमुक्तकवचः श्रीमान्देवगर्भः श्रियान्वितः।\nसहजं कवचं बिभ्रत्कुण्डलोद्द्योतिताननः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2006057, "chapter_id": 1119, "verse_number": "१-१२०-३१", "content_sanskrit": "अजायत सुतः कर्णः सर्वलोकेषु विश्रुतः।\nप्रादाच्च तस्यै कन्यात्वं पुनः स परमद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2006058, "chapter_id": 1119, "verse_number": "१-१२०-३२", "content_sanskrit": "दत्त्वा च तपतां श्रेष्ठो दिवमाचक्रमे ततः।\nदृष्ट्वा कुमारं जातं सा वार्ष्णेयी दीनमानसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2006059, "chapter_id": 1119, "verse_number": "१-१२०-३३", "content_sanskrit": "एकाग्रं चिन्तयामास किं कृत्वा सुकृतं भवेत्।\nगूहमानापचारं सा बन्धुपक्षभयात्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2006060, "chapter_id": 1119, "verse_number": "१-१२०-३४", "content_sanskrit": "मञ्जूषां रत्नसंपूर्णां कृत्वा बालसमाश्रिताम्।\nउत्ससर्ज कुमारं तं जले कुन्ती महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2006061, "chapter_id": 1119, "verse_number": "१-१२०-३५", "content_sanskrit": "तमुत्सृष्टं जले गर्भं राधाभर्ता महायशाः।\nपुत्रत्वे कल्पयामास सभार्यः सूतनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2006062, "chapter_id": 1119, "verse_number": "१-१२०-३६", "content_sanskrit": "नामधेयं च चक्राते तस्य बालस्य तावुभौ।\nवसुना सह जातोऽयं वसुषेणो भवत्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2006063, "chapter_id": 1119, "verse_number": "१-१२०-३७", "content_sanskrit": "स वर्धमानो बलवान्सर्वास्त्रेषूद्यतोऽभवत्।\nआपृष्ठतापादादित्यमुपातिष्ठत वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2006064, "chapter_id": 1119, "verse_number": "१-१२०-३८", "content_sanskrit": "तस्मिन्काले तु जपतस्तस्य वीरस्य धीमतः।\nनादेयं ब्राह्मणेष्वासीत्किंचिद्वसु महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2006065, "chapter_id": 1119, "verse_number": "१-१२०-३९", "content_sanskrit": "ततः काले तु कस्मिंश्चित्स्वप्नान्ते कर्णमब्रवीत्।\nआदित्यो ब्राह्मणो भूत्वा शृणु वीर वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2006066, "chapter_id": 1119, "verse_number": "१-१२०-४०", "content_sanskrit": "प्रभातायां रजन्यां त्वामागमिष्यति वासवः।\nन तस्य भिक्षा दातव्या विप्ररूपी भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2006067, "chapter_id": 1119, "verse_number": "१-१२०-४१", "content_sanskrit": "निश्चयोऽस्यापहर्तुं ते कवचं कुण्डले तथा।\nअतस्त्वां बोधयाम्येष स्मर्तासि वचनं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2006068, "chapter_id": 1119, "verse_number": "१-१२०-४२x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2006069, "chapter_id": 1119, "verse_number": "१-१२०-४२", "content_sanskrit": "शक्रो मां विप्ररूपेण यदि वै याचते द्विज।\nकथं तस्मै न दास्यामि यथा चास्म्यवबोधितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2006070, "chapter_id": 1119, "verse_number": "१-१२०-४३", "content_sanskrit": "विप्राः पूज्यास्तु देवानां सततं प्रियमिच्छताम्।\nतं देवदेवं जानन्वै न शक्तोऽस्म्यवमन्त्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2006071, "chapter_id": 1119, "verse_number": "१-१२०-४४x", "content_sanskrit": "सूर्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2006072, "chapter_id": 1119, "verse_number": "१-१२०-४४", "content_sanskrit": "यद्येवं शृणु मे वीर वरं ते सोऽपि दास्यति।\nशक्तिं त्वमपि याचेथाः सर्वशत्रुविबाधिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2006073, "chapter_id": 1119, "verse_number": "१-१२०-४५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2006074, "chapter_id": 1119, "verse_number": "१-१२०-४५", "content_sanskrit": "एवमुक्त्वा द्विजः स्वप्ने तत्रैवान्तरधीयत।\nकर्णः प्रबुद्धस्तं स्वप्नं चिन्तयानोऽभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2006075, "chapter_id": 1119, "verse_number": "१-१२०-४६", "content_sanskrit": "तमिन्द्रो ब्राह्मणो भूत्वा पुत्रार्थं भूतभावनः।\nकुण्डले प्रार्थयामास कवचं च महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2006076, "chapter_id": 1119, "verse_number": "१-१२०-४७", "content_sanskrit": "उत्कृत्याविमनाः स्वाङ्गात्कवचं रुधिरस्रवम्।\nकर्णौ पार्श्वे च द्वे छित्त्वा प्रायच्छत्स कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2006077, "chapter_id": 1119, "verse_number": "१-१२०-४८", "content_sanskrit": "प्रतिगृह्य तु देवेशस्तुष्टस्तेनास्य कर्मणा।\nअहो साहसमित्याह मनसा वासवो हसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2006078, "chapter_id": 1119, "verse_number": "१-१२०-४९", "content_sanskrit": "देवदानवयक्षाणां गन्धर्वोरगरक्षसाम्।\nन तं पश्यामि यो ह्येतत्कर्म कर्ता भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2006079, "chapter_id": 1119, "verse_number": "१-१२०-५०", "content_sanskrit": "प्रीतोऽस्मि कर्मणा तेन वरं ब्रूहि यदिच्छसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2006080, "chapter_id": 1119, "verse_number": "१-१२०-५०x", "content_sanskrit": "कर्ण उवाच।\nइच्छामि भगवद्दत्तां शक्तिं शत्रुनिबर्हणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2006081, "chapter_id": 1119, "verse_number": "१-१२०-५१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2006082, "chapter_id": 1119, "verse_number": "१-१२०-५१", "content_sanskrit": "शक्तिं तस्मै ददौ शक्रो विस्मयाद्वाक्यमब्रवीत्।\nदेवदानवयक्षाणां गन्धर्वोरगरक्षसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2006083, "chapter_id": 1119, "verse_number": "१-१२०-५२", "content_sanskrit": "यस्मै क्षेप्स्यसि रुष्टः सन्सोऽनया न भविष्यति।\nहत्वैकं समरे शत्रुं ततो मामागमिष्यति।\nइत्युक्त्वान्तर्दधे शक्रो वरं दत्त्वा तु तस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2006084, "chapter_id": 1119, "verse_number": "१-१२०-५३", "content_sanskrit": "प्राङ्नाम तस्य कथितं वसुषेण इति क्षितौ।\nकर्णो वैकर्तनश्चैव कर्मणा तेन सोऽभवत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2006085, "chapter_id": 1119, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि विंशत्यधिकशततमोऽध्यायः॥ १२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]