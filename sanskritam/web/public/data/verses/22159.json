[{"id": 7002159000, "chapter_id": 22159, "verse_number": "२०४-१", "content_sanskrit": "अग्निरुवाच ।\nव्रतं मासोपवासञ्च सर्वोत्कृष्टं वदामि ते ।\nकृत्वा तु वैष्णवं यज्ञं गुरोराज्ञामवाप्य च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002159001, "chapter_id": 22159, "verse_number": "२०४-२", "content_sanskrit": "कृच्छ्राद्यैः स्वबलं बुद्ध्वा कुर्यान्मासोपवासकं ।\nवानप्रस्थो यतिर्वाथ नारी वा विधवा मुने ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002159002, "chapter_id": 22159, "verse_number": "२०४-३", "content_sanskrit": "आश्विनस्यामले पक्षे एकादश्यामुपोषितः ।\nव्रतमेतत्तु गृह्णीयाद्यावत्त्रिंशद्दिनानि तु ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002159003, "chapter_id": 22159, "verse_number": "२०४-४", "content_sanskrit": "अद्यप्रभृत्यहं विष्णो यावदुत्थानकन्तव ।\nअर्चये त्वामनश्नन् हि यावत्त्रिंशद्दिनानि तु ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002159004, "chapter_id": 22159, "verse_number": "२०४-५", "content_sanskrit": "कार्त्तिकाश्विनयोर्विष्णोर्यावदुत्थानकन्तव ।\nम्रिये यद्यन्तरालेऽहं व्रतभङ्गो न मे भवेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002159005, "chapter_id": 22159, "verse_number": "२०४-६", "content_sanskrit": "त्रिकालं पूजयेद्विष्णुं त्रिःस्नातो गन्धपुष्पकैः ।\nविष्णोर्गीतादिकं जप्यन्ध्यानं कुर्याद्व्रती नरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002159006, "chapter_id": 22159, "verse_number": "२०४-७", "content_sanskrit": "वृथावादम्परिहरेदर्थाकाङ्क्षां विवर्जयेत् ।\nनाव्रतस्थं स्पृशेत्कञ्चिद्विकर्मस्थान्न चालयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002159007, "chapter_id": 22159, "verse_number": "२०४-८", "content_sanskrit": "द्वादश्यां पूजयित्वा तु भोजयित्वा द्विजान्व्रती ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002159008, "chapter_id": 22159, "verse_number": "२०४-९", "content_sanskrit": "समाप्य दक्षिणां दत्त्वा पारणन्तु समाचरेत् ।\nभुक्तिमुक्तिमवाप्नोति कल्पांश्चैव त्रयोदश ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002159009, "chapter_id": 22159, "verse_number": "२०४-१०", "content_sanskrit": "कारयेद्वैष्णवं यज्ञं यजेद्विप्रांस्त्रयोदश ।\nतावन्ति वस्त्रयुग्मानि भाजनान्यासनानि च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002159010, "chapter_id": 22159, "verse_number": "२०४-११", "content_sanskrit": "छत्राणि सपवित्राणि तथोपानद्युगानि च ।\nयोगपट्टोपवीतानि दद्याद्विप्राय तैर्मतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002159011, "chapter_id": 22159, "verse_number": "२०४-१२", "content_sanskrit": "अन्यविप्राय शय्यायां हैमं विष्णुं प्रपूज्य च ।\nआत्मनश्च तथामूर्तिं वस्त्राद्यैश्च प्रपूजयेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002159012, "chapter_id": 22159, "verse_number": "२०४-१३", "content_sanskrit": "सर्वपापविनिर्मुक्तो विप्रो विष्णुप्रसादतः ।\nविष्णुलोकं गमिष्यामि विष्णुरेव भवाम्यहं ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002159013, "chapter_id": 22159, "verse_number": "२०४-१४", "content_sanskrit": "व्रज व्रज देवबुद्धे विष्णोः स्थानमनामयं ।\nविमानेनामलस्तत्र तिष्ठेद्विष्णुस्वरूपधृक् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002159014, "chapter_id": 22159, "verse_number": "२०४-१५", "content_sanskrit": "द्विजानुक्त्वाथ तां शय्यां गुरवेऽथ निवेदयेत् ।\nकुलानां शतमुद्धृत्य विष्णुलोकन्नयेद्व्रती ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002159015, "chapter_id": 22159, "verse_number": "२०४-१६", "content_sanskrit": "मासोपवासी यद्देशे स देशो निर्मलो भवेत् ।\nकिं पुनस्तत्कुलं सर्वं यत्र मासोपवासकृत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002159016, "chapter_id": 22159, "verse_number": "२०४-१७", "content_sanskrit": "व्रतस्थं मूर्छितं दृष्ट्वा क्षीराज्यञ्चैव पाययेत् ।\nनैते व्रतं विनिघ्रन्ति हविर्विप्रानुमोदितं ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002159017, "chapter_id": 22159, "verse_number": "२०४-१८", "content_sanskrit": "क्षीरं गुरोर्हितौषध्य आपो मूलफलानि च ।\nविष्णुर्महौषधं कर्ता व्रतमस्मात्समुद्धरेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]