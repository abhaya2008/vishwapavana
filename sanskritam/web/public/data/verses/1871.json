[{"id": 2039511, "chapter_id": 1871, "verse_number": "५-११६-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039512, "chapter_id": 1871, "verse_number": "५-११६-१", "content_sanskrit": "हर्यश्वस्त्वब्रवीद्राजा विचिन्त्य बहुधा ततः।\nदीर्घमुष्णं च निश्वस्य प्रजाहेतोर्नृपोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039513, "chapter_id": 1871, "verse_number": "५-११६-२", "content_sanskrit": "उन्नतेषून्नता षट्सु सूक्ष्मा सूक्ष्मेषु पञ्चसु।\nगम्भीरा त्रिषु चाङ्गेषु इयं रक्ता च पञ्चसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039514, "chapter_id": 1871, "verse_number": "५-११६-३", "content_sanskrit": "`श्रोण्यौ ललाटमूरू च घ्राणं चेति षडुन्नतम्।\nसूक्ष्माण्यङ्गुलिपर्वाणि केशरोमनस्वत्वचः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039515, "chapter_id": 1871, "verse_number": "५-११६-४", "content_sanskrit": "स्वरः सत्वं च नाभिश्च त्रिगम्भीरं प्रचक्षते ।\nपाणिपादतले रक्ते नेत्रान्तौ च नखानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039516, "chapter_id": 1871, "verse_number": "५-११६-५", "content_sanskrit": "पञ्चदीर्घं चतुर्ह्रस्वं पञ्चसूक्ष्मं षडुन्नतम्।\nसप्तरक्तं त्रिविस्तीर्णं त्रिगम्भीरं प्रशकस्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039517, "chapter_id": 1871, "verse_number": "५-११६-६", "content_sanskrit": "पञ्चैव दीर्घा हनुलोचनानि\nबाहूरुनासाश्च सुखप्रदानि ।\nह्रस्वानि चत्वारि च लिङ्गपृष्ठे\nग्रीवा च जङ्घे च हितप्रदानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039518, "chapter_id": 1871, "verse_number": "५-११६-७", "content_sanskrit": "सूक्ष्माणि चत्वारि च लिङ्गपृष्ठे\nग्रीवा च जङ्घे च हितप्रदानि ॥\nसूक्ष्माणि पञ्च दशनाङ्गुलिपर्वकेशा\nस्त्वक्वैव वै कररुहाश्च न दुःखितानाम्।\nवक्षोऽथ कक्षो नखनासिकास्यु-\nरंसत्रिकं चेति षडुन्नतानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039519, "chapter_id": 1871, "verse_number": "५-११६-८", "content_sanskrit": "नेत्रान्तपादकरताल्वधरोष्ठजिह्वा\nरक्ता नखाश्च खलु सर्वसुखावहानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039520, "chapter_id": 1871, "verse_number": "५-११६-९", "content_sanskrit": "बहुदेवासुरालोका बहुगन्धर्वदर्शना।\nबहुलक्षणसंपन्ना बहुकल्याणधारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039521, "chapter_id": 1871, "verse_number": "५-११६-१०", "content_sanskrit": "समर्थेयं जनयितुं चक्रवर्तिनमात्मजम् ।\nब्रूहि शुल्कं द्विजश्रेष्ठ समीक्ष्य विभवं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039522, "chapter_id": 1871, "verse_number": "५-११६-११x", "content_sanskrit": "गालव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039523, "chapter_id": 1871, "verse_number": "५-११६-११", "content_sanskrit": "एकतःश्यामकर्णानां शतान्यष्टौ प्रयच्छ मे।\nहयानां चन्द्रशुभ्राणां देशजानां वपुष्मताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039524, "chapter_id": 1871, "verse_number": "५-११६-१२", "content_sanskrit": "ततस्तव भवित्रीयं पुत्राणां जननी शुभा ।\nअरणीव हुताशानां योनिरायतलोचना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039525, "chapter_id": 1871, "verse_number": "५-११६-१३x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039526, "chapter_id": 1871, "verse_number": "५-११६-१३", "content_sanskrit": "एतच्छ्रुत्वा वचो राजा हर्यश्वः काममोहितः ।\nउवाच गालवं दीनो राजर्षिर्ऋषिसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039527, "chapter_id": 1871, "verse_number": "५-११६-१४", "content_sanskrit": "द्वे मे शते संनिहिते हयानां यद्विधास्तव।\nएष्टव्याः शतशस्त्वन्ये चरन्ति मम वाजिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039528, "chapter_id": 1871, "verse_number": "५-११६-१५", "content_sanskrit": "सोऽहमेकमपत्यं वै जनयिष्यामि गालव।\nअस्यामेतं भवान्कामं संपादयतु मे वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039529, "chapter_id": 1871, "verse_number": "५-११६-१६", "content_sanskrit": "एतच्छ्रुत्वा तु सा कन्या गालवं वाक्यमब्रवीत् ।\nमम दत्तो वरः कश्चित्केनचिद्ब्रह्मवादिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039530, "chapter_id": 1871, "verse_number": "५-११६-१७", "content_sanskrit": "प्रसूत्यन्ते प्रसूत्यन्ते कन्यैव त्वं भविष्यसि।\nस त्वं ददस्व मां राज्ञे प्रतिगृह्य हयोत्तमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039531, "chapter_id": 1871, "verse_number": "५-११६-१८", "content_sanskrit": "नृपेभ्यो हि चतुर्भ्यस्ते पूर्णान्यष्टौ शतानि वै ।\nभविष्यन्ति तथा पुत्रा मम चत्वार एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039532, "chapter_id": 1871, "verse_number": "५-११६-१९", "content_sanskrit": "क्रियतामुपसंहारो गुर्वर्थं द्विजसत्तम।\nएषा तावन्मम प्रज्ञा यथा वा मन्यसे द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039533, "chapter_id": 1871, "verse_number": "५-११६-२०", "content_sanskrit": "एवमुक्तस्तु स मुनिः कन्यया गालवस्तदा ।\nहर्यश्वं पृथिवीपालमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039534, "chapter_id": 1871, "verse_number": "५-११६-२१", "content_sanskrit": "इयं कन्या नरश्रेष्ठ हर्यश्व प्रतिगृह्यताम् ।\nचतुर्भागेन शुल्कस्य जनयस्वैकमात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039535, "chapter_id": 1871, "verse_number": "५-११६-२२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039536, "chapter_id": 1871, "verse_number": "५-११६-२२", "content_sanskrit": "प्रतिगृह्य स तां कन्यां गालवं प्रतिनन्द्य च।\nसमये देशकाले च लब्धवान्सुतमीप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039537, "chapter_id": 1871, "verse_number": "५-११६-२३", "content_sanskrit": "ततो वसुमना नाम वसुभ्यो वसुमत्तरः ।\nवसुप्रख्यो नरपतिः स बभूव वसुप्रदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2039538, "chapter_id": 1871, "verse_number": "५-११६-२४", "content_sanskrit": "अथ काले पुनर्धीमान्गालवः प्रत्युपस्थितः ।\nउपसङ्गम्य चोवाच हर्यश्वं प्रीतमानसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2039539, "chapter_id": 1871, "verse_number": "५-११६-२५", "content_sanskrit": "जातो नृप सुतस्तेऽयं बालो भास्करसंनिभः ।\nकालो गन्तुं नरश्रेष्ठ शुल्कार्थमपरं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2039540, "chapter_id": 1871, "verse_number": "५-११६-२६x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2039541, "chapter_id": 1871, "verse_number": "५-११६-२६", "content_sanskrit": "हर्यश्वः सत्यवचने स्थितः स्थित्वा च पौरुषे।\nदुर्लभत्वाद्धयानां च प्रददौ माधवीं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2039542, "chapter_id": 1871, "verse_number": "५-११६-२७", "content_sanskrit": "माधवी च पुनर्दीप्तां परित्यज्यनृपश्रियम्।\nकुमारी कामतो भूत्वा गालवं पृष्ठतोऽन्वगात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2039543, "chapter_id": 1871, "verse_number": "५-११६-२८", "content_sanskrit": "त्वय्येव तावत्तिष्ठन्तु हया इत्युक्तवान्द्विजः ।\nप्रययौ कन्यया सार्धं दिवोदासं प्रजेश्वरम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2039544, "chapter_id": 1871, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि षोडशाधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]