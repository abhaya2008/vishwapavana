[{"id": 2084108, "chapter_id": 2789, "verse_number": "१२-२९४-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084109, "chapter_id": 2789, "verse_number": "१२-२९४-१", "content_sanskrit": "कथं नु युक्तः पृथिवीं चरेदस्मद्विधो नृपः।\nनित्यं कैश्च गुणैर्युक्तः सङ्गपाशाद्विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084110, "chapter_id": 2789, "verse_number": "१२-२९४-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084111, "chapter_id": 2789, "verse_number": "१२-२९४-२", "content_sanskrit": "अत्र ते वर्तयिष्येऽहमितिहासं पुरातनम्।\nअरिष्टनेमिना प्रोक्तं सगरायानुपृच्छते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084112, "chapter_id": 2789, "verse_number": "१२-२९४-३x", "content_sanskrit": "सगर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084113, "chapter_id": 2789, "verse_number": "१२-२९४-३", "content_sanskrit": "किं श्रेयः परमं ब्रह्मन्कृत्वेह सुखमश्नुते।\nकथं न शोचेन्न क्षुभ्येदेतदिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084114, "chapter_id": 2789, "verse_number": "१२-२९४-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084115, "chapter_id": 2789, "verse_number": "१२-२९४-४", "content_sanskrit": "एवमुक्तस्तदा तार्क्ष्यः सर्वशास्त्रविदां वरः।\nविबुध्य संपदं चाग्र्यां सद्वाक्यमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084116, "chapter_id": 2789, "verse_number": "१२-२९४-५", "content_sanskrit": "सुखं मोक्षसुखं लोके न च मूढोऽवगच्छति।\nप्रसक्तः पुत्रपशुषु धनधान्यसमाकुलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084117, "chapter_id": 2789, "verse_number": "१२-२९४-६", "content_sanskrit": "सक्तबुद्धिरशान्तात्मा स न शक्यश्चिकित्सितुम्।\nस्नेहपाशसितो मूढो न स मोक्षाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084118, "chapter_id": 2789, "verse_number": "१२-२९४-७", "content_sanskrit": "स्नेहजानिह ते पाशान्वक्ष्यामि शृणु तान्मम।\nसकर्णकेन शिरसा शक्याश्छेत्तुं विजानता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084119, "chapter_id": 2789, "verse_number": "१२-२९४-८", "content_sanskrit": "संभाव्य पुत्रान्कालेन यौवनस्थान्निवेश्य च।\nसमर्थाज्जीवने ज्ञात्वा मुक्तश्चर यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084120, "chapter_id": 2789, "verse_number": "१२-२९४-९", "content_sanskrit": "भार्यां पुत्रवतीं वृद्धां लालितां पुत्रवत्सलाम्।\nज्ञात्वा प्रजहि कालेन परार्थमनुदृश्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084121, "chapter_id": 2789, "verse_number": "१२-२९४-१०", "content_sanskrit": "सापत्यो निरपत्यो वा मुक्तश्चर यथासुखम्।\nइन्द्रियैरिन्द्रियार्थांस्त्वमनुभूय यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084122, "chapter_id": 2789, "verse_number": "१२-२९४-११", "content_sanskrit": "कृतकौन्तूहलस्तेषु मुक्तश्चर यथासुखम्।\nउपपत्त्योपलब्धेषु लोकेषु च समो भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084123, "chapter_id": 2789, "verse_number": "१२-२९४-१२", "content_sanskrit": "एष तावत्समासेन तव संकीर्तितो मया।\nमोक्षार्थो विस्तरेणाथ भूयो वक्ष्यामि तच्छृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084124, "chapter_id": 2789, "verse_number": "१२-२९४-१३", "content_sanskrit": "मुक्ता वीतभया लोके चरन्ति सुखिनो नराः।\nसक्तभावा विनश्यन्ति नरास्तत्र न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084125, "chapter_id": 2789, "verse_number": "१२-२९४-१४", "content_sanskrit": "आहारसंचये सक्ता यथा कीटपिपीलिकाः।\nअसक्ताः सुखिनो लोके सक्ताश्चैव विनाशिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084126, "chapter_id": 2789, "verse_number": "१२-२९४-१५", "content_sanskrit": "स्वजने न च ते चिन्ता कर्तव्या मोक्षबुद्धिना।\nइमे मया विनाभूता भविष्यन्ति कथं त्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084127, "chapter_id": 2789, "verse_number": "१२-२९४-१६", "content_sanskrit": "स्वयमुत्पद्यते जन्तुः स्वयमेव विवर्धते।\nसुखदुःखे तथा मृत्युं स्वयमेवाधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084128, "chapter_id": 2789, "verse_number": "१२-२९४-१७", "content_sanskrit": "भोजनाच्छादने चैव मात्रा पित्रा च संग्रहम्।\nस्वकृते नाधिगच्छन्ति लोके नास्त्यकृतं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084129, "chapter_id": 2789, "verse_number": "१२-२९४-१८", "content_sanskrit": "धात्रा विहितभक्ष्याणि सर्वभूतानि मेदिनीम्।\nलोके विपरिधावन्ति रक्षितानि स्वकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084130, "chapter_id": 2789, "verse_number": "१२-२९४-१९", "content_sanskrit": "स्वयं मृत्पिण्डभूतस्य परतन्त्रस्य सर्वदा।\nको हेतुः स्वजनं द्वेष्टुं रक्षितं वाऽदृढात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084131, "chapter_id": 2789, "verse_number": "१२-२९४-२०", "content_sanskrit": "स्वजनं हि यदा मृत्युर्हन्त्येव भुवि पश्यतः।\nकृतेऽपि यत्ने महति तत्र बोद्धव्यमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084132, "chapter_id": 2789, "verse_number": "१२-२९४-२१", "content_sanskrit": "जीवन्तमपि चैवैनं भरणे रक्षणे तथा।\nअसमाप्ते परित्यज्य पश्चादपि मरिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2084133, "chapter_id": 2789, "verse_number": "१२-२९४-२२", "content_sanskrit": "यदा मृतं च स्वजनं न ज्ञास्यसि कथंचन।\nसुखितं दुःखितं वाऽपि ननु बोद्धव्यमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2084134, "chapter_id": 2789, "verse_number": "१२-२९४-२३", "content_sanskrit": "मृते वा त्वयि जीवे वा यदा भोक्ष्यति वै जनः।\nस्वकृतं ननु बुद्ध्वैवं कर्तव्यं हितमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2084135, "chapter_id": 2789, "verse_number": "१२-२९४-२४", "content_sanskrit": "एवं विजानँल्लोकेऽस्मिन्कः कस्येत्यभिनिश्चितः।\nमोक्षे निवेशय मनो भूयश्चाप्युपधारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2084136, "chapter_id": 2789, "verse_number": "१२-२९४-२५", "content_sanskrit": "क्षुत्पिपासादयो भावा जिता यस्येह देहिनः।\nक्रोधो लोभस्तथा मोहः सत्ववान्मुक्त एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2084137, "chapter_id": 2789, "verse_number": "१२-२९४-२६", "content_sanskrit": "द्यूते पाने तथा स्त्रीषु मृगयायां च यो नरः।\nन प्रमाद्यति संमोहात्सततं मुक्त एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2084138, "chapter_id": 2789, "verse_number": "१२-२९४-२७", "content_sanskrit": "दिवसेदिवसे नाम रात्रौरात्रौ पुमान्सदा।\nभोक्तव्यमिति यः स्विन्नो दोषबुद्धिः स उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2084139, "chapter_id": 2789, "verse_number": "१२-२९४-२८", "content_sanskrit": "आत्मभावं तथा स्त्रीषु सक्तमेव पुनः पुनः।\nयः पश्यति सदा युक्तो यथावन्मुक्त एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2084140, "chapter_id": 2789, "verse_number": "१२-२९४-२९", "content_sanskrit": "संभवं च विनाशं च भूतानां चेष्टितं तथा।\nयस्तत्त्वतो विजानाति लोकेऽस्मिन्मुक्त एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2084141, "chapter_id": 2789, "verse_number": "१२-२९४-३०", "content_sanskrit": "प्रस्थं वाहसहस्रेषु यात्रार्थं चैव कोटिषु।\nप्रासादे मञ्चकं स्थानं यः पश्यति स मुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2084142, "chapter_id": 2789, "verse_number": "१२-२९४-३१", "content_sanskrit": "मृत्युनाऽभ्याहतं लोकं व्याधिभिश्चोपपीडितम्।\nअवृत्तिकर्शितं चैव यः पश्यति स मुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2084143, "chapter_id": 2789, "verse_number": "१२-२९४-३२", "content_sanskrit": "यः पश्यति स संतुष्टो नपश्यंश्च विहन्यते।\nयश्चाप्यल्पेन संतुष्टो लोकेऽस्मिन्मुक्त एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2084144, "chapter_id": 2789, "verse_number": "१२-२९४-३३", "content_sanskrit": "अग्नीषोमाविदं सर्वमिति यश्चानुपश्यति।\nन च संस्पृश्यते भावैरद्भुतैर्मुक्त एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2084145, "chapter_id": 2789, "verse_number": "१२-२९४-३४", "content_sanskrit": "पर्यङ्कशय्या भूमिश्च सामने यस्य देहिनः।\nशाल्यन्नं च कदन्नं च यस्य स्यान्मुक्त एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2084146, "chapter_id": 2789, "verse_number": "१२-२९४-३५", "content_sanskrit": "क्षौमं च कुशचीरं च कौशेयं वल्कलानि च।\nआविकं चर्म च समं यस्य स्यान्मुक्त एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2084147, "chapter_id": 2789, "verse_number": "१२-२९४-३६", "content_sanskrit": "पञ्चभूतसमुद्भूतं लोकं यश्चानुपश्यति।\nतथाच वर्तते दृष्ट्वा लोकेऽस्मिन्मुक्त एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2084148, "chapter_id": 2789, "verse_number": "१२-२९४-३७", "content_sanskrit": "सुखदुःखे समे यस्य लाभालाभौ जयाजयौ।\nइच्छाद्वेषौ भयोद्वेगौ सर्वथा मुक्त एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2084149, "chapter_id": 2789, "verse_number": "१२-२९४-३८", "content_sanskrit": "रक्तमूत्रपुरीषाणां दोषाणां संचयांस्तथा।\nशरीरं दोषबहुलं दृष्ट्वा चैव विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2084150, "chapter_id": 2789, "verse_number": "१२-२९४-३९", "content_sanskrit": "वलीपलितसंयोगं कार्श्यं वैवर्ण्यमेव च।\nकुजभावं च जरयाः यः पश्यति स मुच्यतेत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2084151, "chapter_id": 2789, "verse_number": "१२-२९४-४०", "content_sanskrit": "पुंस्त्वोपघातं कालेन दर्शनोपरमं तथा।\nबाधिर्यं प्राणमन्दत्वं यः पश्यति स मुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2084152, "chapter_id": 2789, "verse_number": "१२-२९४-४१", "content_sanskrit": "गतानृषींस्तथा देवानसुरांश्च तथा गतान्।\nलोकादस्मात्परं लोकं यः पश्यति स मुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2084153, "chapter_id": 2789, "verse_number": "१२-२९४-४२", "content_sanskrit": "प्रभावैरन्वितास्तैस्तैः पार्थिवेन्द्राः सहस्रशः।\nये गताः पृथिवीं त्यक्त्वा इति ज्ञात्वा विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2084154, "chapter_id": 2789, "verse_number": "१२-२९४-४३", "content_sanskrit": "अर्थांश्च दुर्लभाँल्लोके क्लेशांश्च सुलभांस्तथा।\nदुःखं चैव कुटुम्बार्थे यः पश्यति स मुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2084155, "chapter_id": 2789, "verse_number": "१२-२९४-४४", "content_sanskrit": "अपत्यानां च वैगुण्यं जनं विगुणमेव च।\nपश्यन्भूयिष्ठशो लोके को मोक्षं नाभिपूजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2084156, "chapter_id": 2789, "verse_number": "१२-२९४-४५", "content_sanskrit": "शास्त्राल्लोकाच्च यो बुद्धः सर्वं पश्यति मानवः।\nअसारमिव मानुष्यं सर्वथा मुक्ता एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2084157, "chapter_id": 2789, "verse_number": "१२-२९४-४६", "content_sanskrit": "एतच्छ्रुत्वा मम वचो भवांश्चरतु मुक्तवत्।\nगार्हस्थ्याद्यदि ते मोक्षे कृता बुद्धिरविक्लवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2084158, "chapter_id": 2789, "verse_number": "१२-२९४-४७", "content_sanskrit": "तत्तस्य वचनं श्रुत्वा सम्यक्स पृथिवीपतिः।\nमोक्षजैश्च गुणैर्युक्तः पालयामास च प्रजाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2084159, "chapter_id": 2789, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चतुर्नवत्यधिकद्विशततमोऽध्यायः॥ २९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]