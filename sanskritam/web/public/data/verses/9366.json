[{"id": 5000366000, "chapter_id": 9366, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे सप्तविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000366001, "chapter_id": 9366, "verse_number": "५-२७-१", "content_sanskrit": "इत्युक्ताः सीतया घोरं राक्षस्यः क्रोधमूर्च्छिताः।\nकाश्चिज्जग्मुस्तदाख्यातुं रावणस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000366002, "chapter_id": 9366, "verse_number": "५-२७-२", "content_sanskrit": "ततः सीतामुपागम्य राक्षस्यो भीमदर्शनाः।\nपुनः परुषमेकार्थमनर्थार्थमथाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000366003, "chapter_id": 9366, "verse_number": "५-२७-३", "content_sanskrit": "अद्येदानीं तवानार्ये सीते पापविनिश्चये।\nराक्षस्यो भक्षयिष्यन्ति मांसमेतद् यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000366004, "chapter_id": 9366, "verse_number": "५-२७-४", "content_sanskrit": "सीतां ताभिरनार्याभिर्दृष्ट्वा संतर्जितां तदा।\nराक्षसी त्रिजटा वृद्धा प्रबुद्धा वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000366005, "chapter_id": 9366, "verse_number": "५-२७-५", "content_sanskrit": "आत्मानं खादतानार्या न सीतां भक्षयिष्यथ।\nजनकस्य सुतामिष्टां स्नुषां दशरथस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000366006, "chapter_id": 9366, "verse_number": "५-२७-६", "content_sanskrit": "स्वप्नो ह्यद्य मया दृष्टो दारुणो रोमहर्षणः।\nराक्षसानामभावाय भर्तुरस्या भवाय च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000366007, "chapter_id": 9366, "verse_number": "५-२७-७", "content_sanskrit": "एवमुक्तास्त्रिजटया राक्षस्यः क्रोधमूर्च्छिताः।\nसर्वा एवाब्रुवन् भीतास्त्रिजटां तामिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000366008, "chapter_id": 9366, "verse_number": "५-२७-८", "content_sanskrit": "कथयस्व त्वया दृष्टः स्वप्नोऽयं कीदृशो निशि।\nतासां श्रुत्वा तु वचनं राक्षसीनां मुखोद‍्गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000366009, "chapter_id": 9366, "verse_number": "५-२७-९", "content_sanskrit": "उवाच वचनं काले त्रिजटा स्वप्नसंश्रितम्।\nगजदन्तमयीं दिव्यां शिबिकामन्तरिक्षगाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000366010, "chapter_id": 9366, "verse_number": "५-२७-१०", "content_sanskrit": "युक्तां वाजिसहस्रेण स्वयमास्थाय राघवः।\nशुक्लमाल्याम्बरधरो लक्ष्मणेन समागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000366011, "chapter_id": 9366, "verse_number": "५-२७-११", "content_sanskrit": "स्वप्ने चाद्य मया दृष्टा सीता शुक्लाम्बरावृता।\nसागरेण परिक्षिप्तं श्वेतपर्वतमास्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000366012, "chapter_id": 9366, "verse_number": "५-२७-१२", "content_sanskrit": "रामेण संगता सीता भास्करेण प्रभा यथा।\nराघवश्च पुनर्दृष्टश्चतुर्दन्तं महागजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000366013, "chapter_id": 9366, "verse_number": "५-२७-१३", "content_sanskrit": "आरूढः शैलसंकाशं चकास सहलक्ष्मणः।\nततस्तु सूर्यसंकाशौ दीप्यमानौ स्वतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000366014, "chapter_id": 9366, "verse_number": "५-२७-१४", "content_sanskrit": "शुक्लमाल्याम्बरधरौ जानकीं पर्युपस्थितौ।\nततस्तस्य नगस्याग्रे ह्याकाशस्थस्य दन्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000366015, "chapter_id": 9366, "verse_number": "५-२७-१५", "content_sanskrit": "भर्त्रा परिगृहीतस्य जानकी स्कन्धमाश्रिता।\nभर्तुरङ्कात् समुत्पत्य ततः कमललोचना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000366016, "chapter_id": 9366, "verse_number": "५-२७-१६", "content_sanskrit": "चन्द्रसूर्यौ मया दृष्टा पाणिभ्यां परिमार्जती।\nततस्ताभ्यां कुमाराभ्यामास्थितः स गजोत्तमः।\nसीतया च विशालाक्ष्या लङ्काया उपरि स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000366017, "chapter_id": 9366, "verse_number": "५-२७-१७", "content_sanskrit": "पाण्डुरर्षभयुक्तेन रथेनाष्टयुजा स्वयम्।\nइहोपयातः काकुत्स्थः सीतया सह भार्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000366018, "chapter_id": 9366, "verse_number": "५-२७-१८", "content_sanskrit": "शुक्लमाल्याम्बरधरो लक्ष्मणेन सहागतः।\nततोऽन्यत्र मया दृष्टो रामः सत्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000366019, "chapter_id": 9366, "verse_number": "५-२७-१९", "content_sanskrit": "लक्ष्मणेन सह भ्रात्रा सीतया सह वीर्यवान्।\nआरुह्य पुष्पकं दिव्यं विमानं सूर्यसंनिभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000366020, "chapter_id": 9366, "verse_number": "५-२७-२०", "content_sanskrit": "उत्तरां दिशमालोच्य प्रस्थितः पुरुषोत्तमः।\nएवं स्वप्ने मया दृष्टो रामो विष्णुपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000366021, "chapter_id": 9366, "verse_number": "५-२७-२१", "content_sanskrit": "लक्ष्मणेन सह भ्रात्रा सीतया सह भार्यया।\nन हि रामो महातेजाः शक्यो जेतुं सुरासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000366022, "chapter_id": 9366, "verse_number": "५-२७-२२", "content_sanskrit": "राक्षसैर्वापि चान्यैर्वा स्वर्गः पापजनैरिव।\nरावणश्च मया दृष्टो मुण्डस्तैलसमुक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000366023, "chapter_id": 9366, "verse_number": "५-२७-२३", "content_sanskrit": "रक्तवासाः पिबन्मत्तः करवीरकृतस्रजः।\nविमानात् पुष्पकादद्य रावणः पतितः क्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000366024, "chapter_id": 9366, "verse_number": "५-२७-२४", "content_sanskrit": "कृष्यमाणः स्त्रिया मुण्डो दृष्टः कृष्णाम्बरः पुनः।\nरथेन खरयुक्तेन रक्तमाल्यानुलेपनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000366025, "chapter_id": 9366, "verse_number": "५-२७-२५", "content_sanskrit": "पिबंस्तैलं हसन्नृत्यन् भ्रान्तचित्ताकुलेन्द्रियः।\nगर्दभेन ययौ शीघ्रं दक्षिणां दिशमास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000366026, "chapter_id": 9366, "verse_number": "५-२७-२६", "content_sanskrit": "पुनरेव मया दृष्टो रावणो राक्षसेश्वरः।\nपतितोऽवाक्शिरा भूमौ गर्दभाद् भयमोहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000366027, "chapter_id": 9366, "verse_number": "५-२७-२७", "content_sanskrit": "सहसोत्थाय सम्भ्रान्तो भयार्तो मदविह्वलः।\nउन्मत्तरूपो दिग्वासा दुर्वाक्यं प्रलपन् बहु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000366028, "chapter_id": 9366, "verse_number": "५-२७-२८", "content_sanskrit": "दुर्गन्धं दुःसहं घोरं तिमिरं नरकोपमम्।\nमलपङ्कं प्रविश्याशु मग्नस्तत्र स रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000366029, "chapter_id": 9366, "verse_number": "५-२७-२९", "content_sanskrit": "प्रस्थितो दक्षिणामाशां प्रविष्टोऽकर्दमं ह्रदम्।\nकण्ठे बद्‍ध्वा दशग्रीवं प्रमदा रक्तवासिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000366030, "chapter_id": 9366, "verse_number": "५-२७-३०", "content_sanskrit": "काली कर्दमलिप्तांगी दिशं याम्यां प्रकर्षति।\nएवं तत्र मया दृष्टः कुम्भकर्णो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000366031, "chapter_id": 9366, "verse_number": "५-२७-३१", "content_sanskrit": "रावणस्य सुताः सर्वे मुण्डास्तैलसमुक्षिताः।\nवराहेण दशग्रीवः शिशुमारेण चेन्द्रजित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000366032, "chapter_id": 9366, "verse_number": "५-२७-३२", "content_sanskrit": "उष्ट्रेण कुम्भकर्णश्च प्रयातो दक्षिणां दिशम्।\nएकस्तत्र मया दृष्टः श्वेतच्छत्रो विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000366033, "chapter_id": 9366, "verse_number": "५-२७-३३", "content_sanskrit": "शुक्लमाल्याम्बरधरः शुक्लगन्धानुलेपनः।\nशङ्खदुन्दुभिनिर्घोषैर्नृत्तगीतैरलंकृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000366034, "chapter_id": 9366, "verse_number": "५-२७-३४", "content_sanskrit": "आरुह्य शैलसंकाशं मेघस्तनितनिःस्वनम्।\nचतुर्दन्तं गजं दिव्यमास्ते तत्र विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000366035, "chapter_id": 9366, "verse_number": "५-२७-३५", "content_sanskrit": "चतुर्भिः सचिवैः सार्धं वैहायसमुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000366036, "chapter_id": 9366, "verse_number": "५-२७-३६", "content_sanskrit": "समाजश्च महान् वृत्तो गीतवादित्रनिःस्वनः।\nपिबतां रक्तमाल्यानां रक्षसां रक्तवाससाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000366037, "chapter_id": 9366, "verse_number": "५-२७-३७", "content_sanskrit": "लङ्का चेयं पुरी रम्या सवाजिरथकुञ्जरा।\nसागरे पतिता दृष्टा भग्नगोपुरतोरणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000366038, "chapter_id": 9366, "verse_number": "५-२७-३८", "content_sanskrit": "लङ्का दृष्टा मया स्वप्ने रावणेनाभिरक्षिता।\nदग्धा रामस्य दूतेन वानरेण तरस्विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000366039, "chapter_id": 9366, "verse_number": "५-२७-३९", "content_sanskrit": "पीत्वा तैलं प्रमत्ताश्च प्रहसन्त्यो महास्वनाः।\nलङ्कायां भस्मरूक्षायां सर्वा राक्षसयोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000366040, "chapter_id": 9366, "verse_number": "५-२७-४०", "content_sanskrit": "कुम्भकर्णादयश्चेमे सर्वे राक्षसपुंगवाः।\nरक्तं निवसनं गृह्य प्रविष्टा गोमयह्रदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000366041, "chapter_id": 9366, "verse_number": "५-२७-४१", "content_sanskrit": "अपगच्छत पश्यध्वं सीतामाप्नोति राघवः।\nघातयेत् परमामर्षी युष्मान् सार्धं हि राक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000366042, "chapter_id": 9366, "verse_number": "५-२७-४२", "content_sanskrit": "प्रियां बहुमतां भार्यां वनवासमनुव्रताम्।\nभर्त्सितां तर्जितां वापि नानुमंस्यति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000366043, "chapter_id": 9366, "verse_number": "५-२७-४३", "content_sanskrit": "तदलं क्रूरवाक्यैश्च सान्त्वमेवाभिधीयताम्।\nअभियाचाम वैदेहीमेतद्धि मम रोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000366044, "chapter_id": 9366, "verse_number": "५-२७-४४", "content_sanskrit": "यस्या ह्येवंविधः स्वप्नो दुःखितायाः प्रदृश्यते।\nसा दुःखैर्बहुभिर्मुक्ता प्रियं प्राप्नोत्यनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000366045, "chapter_id": 9366, "verse_number": "५-२७-४५", "content_sanskrit": "भर्त्सितामपि याचध्वं राक्षस्यः किं विवक्षया।\nराघवाद्धि भयं घोरं राक्षसानामुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000366046, "chapter_id": 9366, "verse_number": "५-२७-४६", "content_sanskrit": "प्रणिपातप्रसन्ना हि मैथिली जनकात्मजा।\nअलमेषा परित्रातुं राक्षस्यो महतो भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000366047, "chapter_id": 9366, "verse_number": "५-२७-४७", "content_sanskrit": "अपि चास्या विशालाक्ष्या न किंचिदुपलक्षये।\nविरूपमपि चांगेषु सुसूक्ष्ममपि लक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000366048, "chapter_id": 9366, "verse_number": "५-२७-४८", "content_sanskrit": "छायावैगुण्यमात्रं तु शङ्के दुःखमुपस्थितम्।\nअदुःखार्हामिमां देवीं वैहायसमुपस्थिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000366049, "chapter_id": 9366, "verse_number": "५-२७-४९", "content_sanskrit": "अर्थसिद्धिं तु वैदेह्याः पश्याम्यहमुपस्थिताम्।\nराक्षसेन्द्रविनाशं च विजयं राघवस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000366050, "chapter_id": 9366, "verse_number": "५-२७-५०", "content_sanskrit": "निमित्तभूतमेतत् तु श्रोतुमस्या महत् प्रियम्।\nदृश्यते च स्फुरच्चक्षुः पद्मपत्रमिवायतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000366051, "chapter_id": 9366, "verse_number": "५-२७-५१", "content_sanskrit": "ईषद्धि हृषितो वास्या दक्षिणाया ह्यदक्षिणः।\nअकस्मादेव वैदेह्या बाहुरेकः प्रकम्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000366052, "chapter_id": 9366, "verse_number": "५-२७-५२", "content_sanskrit": "करेणुहस्तप्रतिमः सव्यश्चोरुरनुत्तमः।\nवेपन् कथयतीवास्या राघवं पुरतः स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000366053, "chapter_id": 9366, "verse_number": "५-२७-५३", "content_sanskrit": "पक्षी च शाखानिलयं प्रविष्टः\nपुनः पुनश्चोत्तमसान्त्ववादी।\nसुस्वागतां वाचमुदीरयाणः\nपुनः पुनश्चोदयतीव हृष्टः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000366054, "chapter_id": 9366, "verse_number": "५-२७-५४", "content_sanskrit": "ततः सा ह्रीमती बाला भर्तुर्विजयहर्षिता।\nअवोचद् यदि तत् तथ्यं भवेयं शरणं हि वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000366055, "chapter_id": 9366, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे सप्तविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]