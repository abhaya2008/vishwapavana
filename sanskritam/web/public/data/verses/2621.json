[{"id": 2076502, "chapter_id": 2621, "verse_number": "१२-१२६-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076503, "chapter_id": 2621, "verse_number": "१२-१२६-१", "content_sanskrit": "प्रविश्य च महारण्यं तापसानामथाश्रमम्।\nआससाद ततो राजा श्रान्तश्चोपाविशत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076504, "chapter_id": 2621, "verse_number": "१२-१२६-२", "content_sanskrit": "तं कार्मुकधरं दृष्ट्वा श्रमार्तं क्षुधितं तदा।\nसमेत्य ऋषयस्तस्मै पूजां चक्रुर्यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076505, "chapter_id": 2621, "verse_number": "१२-१२६-३", "content_sanskrit": "स पूजामृषिभिर्दत्तां प्रतिगृह्य नराधिपः।\nअपृच्छत्तापसान्सर्वांस्तपोवृद्धिमनुत्तमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076506, "chapter_id": 2621, "verse_number": "१२-१२६-४", "content_sanskrit": "ते तस्य राज्ञो वचनं प्रतिगृह्य तपोधनाः।\nऋषयो राजशार्दूलमपृच्छंस्तत्प्रयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076507, "chapter_id": 2621, "verse_number": "१२-१२६-५", "content_sanskrit": "केन भद्रमुखार्थेन तपोवनमुपागतः।\nपदातिर्बद्धनिस्त्रिंशो धन्वी बाणी नरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076508, "chapter_id": 2621, "verse_number": "१२-१२६-६", "content_sanskrit": "एतदिच्छामहे श्रोतुं कुतः प्राप्तोऽसि मानद।\nकस्मिन्कुले तु जातस्त्वं किंनामा चासि ब्रूहि नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076509, "chapter_id": 2621, "verse_number": "१२-१२६-७", "content_sanskrit": "ततः स राजा सर्वेभ्यो द्विजेभ्यः पुरुषर्षभ।\nआचख्यौ तद्यथावृत्तं परिचर्यां च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076510, "chapter_id": 2621, "verse_number": "१२-१२६-८", "content_sanskrit": "हैहयानां कुले जातः सुमित्रोऽमित्रकर्शनः।\nचरामि मृगयूथानि निघ्रन्बाणैः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076511, "chapter_id": 2621, "verse_number": "१२-१२६-९", "content_sanskrit": "बलेन महता ब्रह्मन्सामात्यः सावरोधकः।\nमृगस्तु विद्धो बाणेन मया सरति शल्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076512, "chapter_id": 2621, "verse_number": "१२-१२६-१०", "content_sanskrit": "तं द्रवन्तमनुप्राप्तो वनमेतद्यदृच्छया।\nभवत्सकाशं नष्टश्रीर्हताशः श्रमकर्शितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076513, "chapter_id": 2621, "verse_number": "१२-१२६-११", "content_sanskrit": "किंनु दुःखमतोऽन्यद्वै यदहं श्रमकर्शितः।\nभवतामाश्रमं प्राप्तो हताशो भ्रष्टलक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076514, "chapter_id": 2621, "verse_number": "१२-१२६-१२", "content_sanskrit": "न राजलक्षणत्यागः पुनरस्य तपोधनाः।\nदुःखं करोति मे तीव्रं यथाऽऽशा विहता मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076515, "chapter_id": 2621, "verse_number": "१२-१२६-१३", "content_sanskrit": "हिमवान्वा महाशैलः समुद्रो वा महोदधिः।\nमहत्त्वान्नान्वपद्येतां रोदस्योरन्तरं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076516, "chapter_id": 2621, "verse_number": "१२-१२६-१४", "content_sanskrit": "आशायास्तपसि श्रेष्ठास्तथा नान्तमहं गतः।\nभवतां विदितं सर्वं सर्वज्ञा हि तपोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076517, "chapter_id": 2621, "verse_number": "१२-१२६-१५", "content_sanskrit": "भवन्तः सुमहाभागास्तस्मात्पृच्छामि संशयम्।\nआशावान्पुरुषो यः स्यादन्तरिक्षमथापि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076518, "chapter_id": 2621, "verse_number": "१२-१२६-१६", "content_sanskrit": "किंनु ज्यायस्तरं लोके महत्त्वे प्रतिभाति वः।\nएतदिच्छामि तत्त्वेन श्रोतुं किमिह दुर्लभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076519, "chapter_id": 2621, "verse_number": "१२-१२६-१७", "content_sanskrit": "यदि गुह्यं न वो नित्यं तदा प्रब्रूत मा चिरम्।\nन हि गुह्यतमं श्रोतुमिच्छामि द्विजपुङ्गवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076520, "chapter_id": 2621, "verse_number": "१२-१२६-१८", "content_sanskrit": "भवत्तपोविघातो वा येन स्याद्विरमे ततः।\nयदि वाऽस्ति कथायोगो योऽयं प्रश्नो मयेरितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076521, "chapter_id": 2621, "verse_number": "१२-१२६-१९", "content_sanskrit": "एतत्कारणसामर्थ्यं श्रोतुमिच्छामि तत्त्वतः।\nभवन्तोऽपि तपोनित्या ब्रूयुरेतत्समाहिताः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076522, "chapter_id": 2621, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि षङ्विंशत्यधिकशततमोऽध्यायः॥ १२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]