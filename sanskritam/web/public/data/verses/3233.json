[{"id": 2102960, "chapter_id": 3233, "verse_number": "१४-८९-१", "content_sanskrit": "वैशम्पायन उवाच।\nएतस्मिन्नेव काले तु स राजा बभ्रुवाहनः।\nमातृभ्यां सहितो धीमान्कुरूनभ्याजगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102961, "chapter_id": 3233, "verse_number": "१४-८९-२", "content_sanskrit": "तत्र वृद्धान्यथावत्स कुरूनन्यांश्च पार्थिवान्।\nअभिवाद्य महाबाहुस्तैश्चापि प्रतिनन्दितः।\nप्रविवेश पितामह्याः कुन्त्या भवनमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102962, "chapter_id": 3233, "verse_number": "१४-८९-३", "content_sanskrit": "स प्रविश्य महाबाहुः पाण्डवानां निवेशनम्।\nपितामहीमभ्यवन्दत्साम्ना परमवल्गुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102963, "chapter_id": 3233, "verse_number": "१४-८९-४", "content_sanskrit": "तथा चित्राङ्गदा देवी कौरवस्यात्मजाऽपि च।\nपृथां कृष्णां च सहिते विनयेनोपजग्मतुः।\nसुभद्रां च यथान्यायं याश्चान्याः कुरुयोषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102964, "chapter_id": 3233, "verse_number": "१४-८९-५", "content_sanskrit": "ददौ कुन्ती ततस्ताभ्यां रत्नानि विविधानि च।\nद्रौपदी च सुभद्रा च याश्चाप्यन्या यदुस्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102965, "chapter_id": 3233, "verse_number": "१४-८९-६", "content_sanskrit": "ऊषतुस्तत्र ते देव्यौ महार्ङशयनासने।\nसुपूजिते स्वयं कुन्त्या पार्थस्य हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102966, "chapter_id": 3233, "verse_number": "१४-८९-७", "content_sanskrit": "स च राजा महातेजाः पूजितो बभ्रुवाहनः।\nधूतराष्ट्रं महीपालमुपतस्थे यताविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102967, "chapter_id": 3233, "verse_number": "१४-८९-८", "content_sanskrit": "युधिष्ठिरं च राजानं भीमदींश्चापि पाण्डवान्।\nउपागम्य महातेजा विनयेनाभ्यवादयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102968, "chapter_id": 3233, "verse_number": "१४-८९-९", "content_sanskrit": "स तैः प्रेम्या परिष्वक्तः पूजितश्च यथाविधि।\nधनं चास्मै ददुर्भूरि प्रीयमाणा महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102969, "chapter_id": 3233, "verse_number": "१४-८९-१०", "content_sanskrit": "तथैव च महीपालः कृष्णं चक्रगदाधरम्।\nप्रद्युम्न इव गोविन्दं विनयेनोपतस्थिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102970, "chapter_id": 3233, "verse_number": "१४-८९-११", "content_sanskrit": "तस्मै कृष्णो ददौ राज्ञे महार्हमतिपूजितम्।\nरथं हेमपरिष्कारं दिव्याश्वयुजमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102971, "chapter_id": 3233, "verse_number": "१४-८९-१२", "content_sanskrit": "धर्मराजश्च भीमश्च फल्गुनश्च यमौ तथा।\nपृथक्पृथक् च ते चैनं मानार्थाभ्यामयोजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102972, "chapter_id": 3233, "verse_number": "१४-८९-१३", "content_sanskrit": "ततस्तृतीये दिवसे सत्यवत्यात्मजो मुनिः।\nयुधिष्ठिरं समभ्येत्य वाग्मी वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102973, "chapter_id": 3233, "verse_number": "१४-८९-१४", "content_sanskrit": "अद्यप्रभृति कौन्तेय यज्ञस्य समयो हि ते।\nमुहूर्तो यज्ञियः प्राप्तश्चोदयन्तीह याजकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102974, "chapter_id": 3233, "verse_number": "१४-८९-१५", "content_sanskrit": "अहीनो नाम राजेन्द्र क्रतुस्तेऽयं विकल्पवान्।\nबहुत्वात्काञ्चनस्यास्य ख्यातो बहुसुवर्णकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102975, "chapter_id": 3233, "verse_number": "१४-८९-१६", "content_sanskrit": "एवमत्र महाराज दक्षिणाभिर्गुणीकुर।\nश्रीस्त्वां व्रजतु ते राजन्ब्राह्मणा ह्यत्र कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102976, "chapter_id": 3233, "verse_number": "१४-८९-१७", "content_sanskrit": "त्रीनश्वमेधानत्र त्वं सम्प्राप्य बहुदक्षिणान्।\nज्ञातिवध्याकृतं पापं प्रहास्यति नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102977, "chapter_id": 3233, "verse_number": "१४-८९-१८", "content_sanskrit": "पवित्रं परमं चैतत्पावनानां च पावनम्।\nयदश्वमेधावभृथं प्राप्स्यसे कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102978, "chapter_id": 3233, "verse_number": "१४-८९-१९", "content_sanskrit": "इत्युक्तः स तु तेजस्वी व्यासेनामितबुद्धिना।\nदीक्षां विवेश धर्मात्मा वाजिमेधाप्तये ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102979, "chapter_id": 3233, "verse_number": "१४-८९-२०", "content_sanskrit": "ततो यज्ञं महाबाहुर्वाजिमेधं महाक्रतुम्।\nबह्वन्नदक्षिणं राजा सर्वकामगुणान्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102980, "chapter_id": 3233, "verse_number": "१४-८९-२१", "content_sanskrit": "तत्र वेदविदो राजंश्चक्रुः कर्माणि याजकाः।\nपरिक्रामन्ति शास्त्रज्ञा यतावद्द्विजसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102981, "chapter_id": 3233, "verse_number": "१४-८९-२२", "content_sanskrit": "न तेषां स्खलितं किञ्चिदासीदपहुतं तथा।\nक्रमयुक्तं च युक्तं च चक्रुस्तत्र द्विजर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102982, "chapter_id": 3233, "verse_number": "१४-८९-२३", "content_sanskrit": "कृत्वा प्रवर्ग्यं धर्मज्ञा यथावद्द्विजसत्तमाः।\nचक्रस्ते विधिवद्राजंस्तथैवाभिषवं द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102983, "chapter_id": 3233, "verse_number": "१४-८९-२४", "content_sanskrit": "अभिषूय ततो राजन्सोमं सोमपसत्तमाः।\nसवनान्यानुपूर्व्येण चक्रुः सास्त्रानुसारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102984, "chapter_id": 3233, "verse_number": "१४-८९-२५", "content_sanskrit": "न तत्र कृपणः कश्चिन्न दरिद्रो बभूव ह।\nक्षुधितो दुःखितो वाऽपि प्राकृतो वाऽपि मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102985, "chapter_id": 3233, "verse_number": "१४-८९-२६", "content_sanskrit": "भोजनं भोजनार्थिभ्यो दापयामास शत्रुहा।\nभीमसेनो महातेजाः सततं राजशासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102986, "chapter_id": 3233, "verse_number": "१४-८९-२७", "content_sanskrit": "संस्तरे कुशलाश्चापि सर्वकार्याणि याजकाः।\nदिवसेदिवसे चक्रुर्यथाशास्त्रानुदर्शात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2102987, "chapter_id": 3233, "verse_number": "१४-८९-२८", "content_sanskrit": "नाषडङ्गविदत्रासीत्सदस्यस्तस्य धीमतः।\nनाव्रतो नानुपाध्यायो न च वादाविचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2102988, "chapter_id": 3233, "verse_number": "१४-८९-२९", "content_sanskrit": "ततो यूपोच्छ्रये प्राप्ते षड् बैल्वान्भरतर्षभ।\nखादिरान्बिल्वसमितांस्तावतः सर्ववर्णिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2102989, "chapter_id": 3233, "verse_number": "१४-८९-३०", "content_sanskrit": "देवदारुमयौ द्वौ तु यूपौ कुरुपतेर्मखे।\nश्लेष्मातकमयं चैकं याजकाः समकल्पयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2102990, "chapter_id": 3233, "verse_number": "१४-८९-३१", "content_sanskrit": "`सर्वानेतान्यथाशास्त्रं याजकाः समकारयन्।\nशोभार्थं चापरान्यूपान्काञ्चनान्भरतर्षभ।\nस भीमः कारयामास धर्मराजस्य शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2102991, "chapter_id": 3233, "verse_number": "१४-८९-३२", "content_sanskrit": "ते व्यराजन्त राजर्षे वासोभिरुपशोभिताः।\nमहेन्द्रानुगता देवा यथा सप्तर्षिभिर्दिवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2102992, "chapter_id": 3233, "verse_number": "१४-८९-३३", "content_sanskrit": "इष्टकाः काञ्चनीश्चात्र चयनार्तं कृता विभो।\nशुशुभे चयनं तच्च दक्षस्येव प्रजापतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2102993, "chapter_id": 3233, "verse_number": "१४-८९-३४", "content_sanskrit": "चतुश्चित्यश्च तस्यासीदष्टादशकरात्मकः।\nस रुक्मपक्षो निचितस्त्रिकोणो गरुडाकृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2102994, "chapter_id": 3233, "verse_number": "१४-८९-३५", "content_sanskrit": "ततो नियुक्ताः पशवो यथाशास्त्रं मनीषिभिः।\nतं तं देवं समुद्दिश्य पक्षिणः पशवश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2102995, "chapter_id": 3233, "verse_number": "१४-८९-३६", "content_sanskrit": "ऋषभाः शास्त्रपठितास्तथा जलचराश्च ये।\nसर्वांस्तानभ्ययुञ्जंस्ते तत्राग्निचयकर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2102996, "chapter_id": 3233, "verse_number": "१४-८९-३७", "content_sanskrit": "यूपेषु नियता चासीत्पशूनां त्रिशती तथा।\nअश्वरत्नोत्तरा यज्ञे कौन्तेयस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2102997, "chapter_id": 3233, "verse_number": "१४-८९-३८", "content_sanskrit": "स यज्ञः शुशुभे तस्य साक्षाद्देवर्षिसंकुलः।\nगन्धर्वगणसंकीर्णः शोभितोऽप्सरसां गणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2102998, "chapter_id": 3233, "verse_number": "१४-८९-३९", "content_sanskrit": "स किंपुरुषसंकीर्णः किंनरैश्चोपशोभितः।\nसिद्धविप्रनिवासैश्च समन्तादभिसंवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2102999, "chapter_id": 3233, "verse_number": "१४-८९-४०", "content_sanskrit": "तस्मिन्सदसि नित्यास्तु व्यासशिष्या द्विजर्षभाः।\nसर्वशास्त्रप्रणेतारः कुशला यज्ञकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2103000, "chapter_id": 3233, "verse_number": "१४-८९-४१", "content_sanskrit": "नारदश्च बभूवात्र तुंबुरुश्च महाद्युतिः।\nविश्वावसुश्चित्रसेनस्तथाऽन्ये गीतकोविदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2103001, "chapter_id": 3233, "verse_number": "१४-८९-४२", "content_sanskrit": "गन्धर्वा गीतकुशला नृत्येषु च विशारदाः।\nरमयन्ति स्म तान्विप्रान्यज्ञकर्मान्तरेषु वै॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2103002, "chapter_id": 3233, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि एकोननवतितमोऽध्यायः॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]