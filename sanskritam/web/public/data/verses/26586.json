[{"id": 7006586000, "chapter_id": 26586, "verse_number": "३-१२५-१", "content_sanskrit": "सात्यकिडिम्भकयोः युद्धम् वैशम्पायन उवाच युद्धं चक्रतुरत्यर्थं ततो डिम्भकसात्यकी ।\nतावुभौ बलिनौ वीरौ विख्यातौ क्षत्रियेषु च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006586001, "chapter_id": 26586, "verse_number": "३-१२५-२", "content_sanskrit": "कृतश्रमौ महायुद्धे सततं वृद्धसेविनौ ।\nसात्यकिर्दशभिर्वीरो डिम्भकं वेदपारगम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006586002, "chapter_id": 26586, "verse_number": "३-१२५-३", "content_sanskrit": "अविध्यन्निशितैर्बाणैः स्तने वक्त्रे तथोरसि ।\nस तेन विद्धो बलिना डिम्भकः क्षत्रियोत्तमः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006586003, "chapter_id": 26586, "verse_number": "३-१२५-४", "content_sanskrit": "नाराचैः पञ्चसाहस्रैर्विव्याध युधि गर्वितः ।\nतानन्तरे वृष्णिवीरो निषिद्धन् निनदन् ब्रुवन् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006586004, "chapter_id": 26586, "verse_number": "३-१२५-५", "content_sanskrit": "अथ क्रुद्धो नृपवरो विद्धः सप्तभिराशुगैः ।\nपुनः शतसहस्रेण प्रत्यविध्यत सात्यकिम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006586005, "chapter_id": 26586, "verse_number": "३-१२५-६", "content_sanskrit": "सात्यकिस्त्वथ विक्रान्तो धनुश्चिच्छेद तस्य तत् ।\nअर्धचन्द्रेण तीक्ष्णेन डिम्भकस्य स यादवः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006586006, "chapter_id": 26586, "verse_number": "३-१२५-७", "content_sanskrit": "आजघ्ने डिम्भको वीरश्चापमादाय चापरम् ।\nक्षुरप्रेणाथ रौद्रेण तैलधौतेन विक्रमी ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006586007, "chapter_id": 26586, "verse_number": "३-१२५-८", "content_sanskrit": "स तेन विद्धो बाणेन वमञ्छोणितकं नृप ।\nअतीव शुशुभे राजन् वसन्ते किंशुको यथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006586008, "chapter_id": 26586, "verse_number": "३-१२५-९", "content_sanskrit": "धनुश्चिच्छेद भूयस्तु गृहीतं यत्पुनर्महत् ।\nततोऽन्यद् धनुरादाय डिम्भको यादवेश्वरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006586009, "chapter_id": 26586, "verse_number": "३-१२५-१०", "content_sanskrit": "जघान निशितैर्बाणैः सर्वक्षत्रस्य पश्यतः ।\nस धनुः पुनरत्युग्रं चिच्छेद युधि सात्यकिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006586010, "chapter_id": 26586, "verse_number": "३-१२५-११", "content_sanskrit": "शरेण तीक्ष्णपुङ्खेन डिम्भकस्य दुरात्मनः ।\nततोऽन्यद् धनुरादाय सत्वरं स नृपोत्तमः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006586011, "chapter_id": 26586, "verse_number": "३-१२५-१२", "content_sanskrit": "धनुषा तेन राजेन्द्र सात्यकिं विव्यधे पुनः ।\nएवं धनूंषि राजेन्द्र शतं पञ्च च पञ्च च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006586012, "chapter_id": 26586, "verse_number": "३-१२५-१३", "content_sanskrit": "छित्त्वा ननाद शैनेयः सर्वक्षत्रस्य पश्यतः ।\nधनुषी तौ परित्यज्य वीरौ डिम्भकसात्यकी ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006586013, "chapter_id": 26586, "verse_number": "३-१२५-१४", "content_sanskrit": "खड्गौ प्रगृह्य चात्युग्रौ युद्धाय समुपस्थितौ ।\nतौ हि खङ्गविदां श्रेष्ठौ वीरौ डिम्भकसात्यकी ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006586014, "chapter_id": 26586, "verse_number": "३-१२५-१५", "content_sanskrit": "दौःशासनिर्महाभागः सौमदत्तिस्तथैव च ।\nअभिमन्युश्च विक्रान्तो नकुलश्च तथैव च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006586015, "chapter_id": 26586, "verse_number": "३-१२५-१६", "content_sanskrit": "एते खङ्गविदां श्रेष्ठाः कीर्तिता युधि सत्तमाः ।\nएतेष्वेतौ नृपश्रेष्ठौ षट्सु वै नृपसत्तम ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006586016, "chapter_id": 26586, "verse_number": "३-१२५-१७", "content_sanskrit": "तावेतावसिना युद्धं चक्रतुर्युद्धलालसौ ।\nभ्रान्तमुद्भ्रान्तमाविद्धं प्रविद्धं बाहुनिःसृतम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006586017, "chapter_id": 26586, "verse_number": "३-१२५-१८", "content_sanskrit": "आकरं विकरं भिन्नं निर्मर्यादममानुषम् ।\nसंकोचितं कुलचितं सव्यजानु विजानु च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006586018, "chapter_id": 26586, "verse_number": "३-१२५-१९", "content_sanskrit": "आहिकं चित्रकं क्षिप्तं कुसुम्बं लम्बनं धृतम् ।\nसर्वबाहु विनिर्बाहु सव्येतरमथोत्तरम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006586019, "chapter_id": 26586, "verse_number": "३-१२५-२०", "content_sanskrit": "त्रिबाहु तुङ्गबाहुत्वं सव्योन्नतमुदासि च ।\nपट्टिकं मौष्टिकं चैव यौधिकं प्रथितं तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006586020, "chapter_id": 26586, "verse_number": "३-१२५-२१", "content_sanskrit": "इति प्रकारान् द्वात्रिंशच्चक्रतुः खड्गयोधिनौ ।\nपुनः पुनः प्रहरन्तौ न च श्रममुपेयतुः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006586021, "chapter_id": 26586, "verse_number": "३-१२५-२२", "content_sanskrit": "पुष्करस्थौ महाराज युद्धाय कृतनिश्चयौ ।\nततो देवाः सगन्धर्वाः सिद्धाश्च परमर्षयः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006586022, "chapter_id": 26586, "verse_number": "३-१२५-२३", "content_sanskrit": "तुष्टुवुस्तौ महाराज जये कृतपरिश्रमौ ।\nअहो वीर्यमहो धैर्यमनयोर्बाहुशालिनोः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006586023, "chapter_id": 26586, "verse_number": "३-१२५-२४", "content_sanskrit": "एतावेव रणे शक्तौ खड्गे धनुषि पारगौ ।\nएकः शिष्यो गिरीशस्य द्रोणस्यान्यो हि धीमतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006586024, "chapter_id": 26586, "verse_number": "३-१२५-२५", "content_sanskrit": "अर्जुनः सात्यकिश्चैव वासुदेवो जगत्पतिः ।\nत्रय एते महावीराः प्रथिताः सङ्गरे सदा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006586025, "chapter_id": 26586, "verse_number": "३-१२५-२६", "content_sanskrit": "डिम्भकः शक्तिभृच्छर्वस्त्रय एते महारथाः ।\nप्रसिद्धाः सर्व एवैते वीर्येषु च बलेषु च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006586026, "chapter_id": 26586, "verse_number": "३-१२५-२७", "content_sanskrit": "इति ते देवगन्धर्वाः सिद्धा यक्षा महोरगाः ।\nदिविस्थिताः समं ब्रूयुर्युद्धदर्शनलालसाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]