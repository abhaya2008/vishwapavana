[{"id": 2034843, "chapter_id": 1751, "verse_number": "४-७४-१", "content_sanskrit": "वैशम्पायन उवाच।\nततो द्वितीये दिवसे भ्रातरः पञ्च पाण्डवाः।\nस्नाताः शुक्लाम्बरधराः सर्वे सुचरितव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2034844, "chapter_id": 1751, "verse_number": "४-७४-२", "content_sanskrit": "युधिष्ठिरं पुरस्कृत्य सर्वाभरणभूषिताः।\nअभिपन्ना महाभागा भ्राजमाना महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2034845, "chapter_id": 1751, "verse_number": "४-७४-३", "content_sanskrit": "विराटस्य सभां प्राप्य भूमिपालासनेषु ते ।\nनिषेदुः पावकप्रख्याः सत्रे धिष्ण्येष्विवाग्नयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2034846, "chapter_id": 1751, "verse_number": "४-७४-४", "content_sanskrit": "तेषु तत्रोपविष्टेषु विराटः पृथिवीपतिः।\nतस्यां रात्र्यां व्यतीतायां प्रातःकृत्यं समाप्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2034847, "chapter_id": 1751, "verse_number": "४-७४-५", "content_sanskrit": "गोसुवर्णादिकं दत्त्वा ब्राह्मणेभ्यो यथाविधि ।\nआजगाम सभां राजा उत्तरेण सह प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2034848, "chapter_id": 1751, "verse_number": "४-७४-६", "content_sanskrit": "स तान्दृष्ट्वा महासत्वाञ्ज्वलतः पावकानिव।\nराजवेषानुपादाय पार्थिवो विस्मितोऽभवत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2034849, "chapter_id": 1751, "verse_number": "४-७४-७", "content_sanskrit": "किमिदं को विधिस्त्वेष भयार्त इव पार्थिवः।\nपुरुषप्रवरान्दृष्ट्वा विषादमगमन्नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2034850, "chapter_id": 1751, "verse_number": "४-७४-८", "content_sanskrit": "अथ मात्स्योऽब्रवीत्कङ्खं देवराजमिव स्थितम् ।\nमरुद्गणैरुपासीनं त्रिदशानामिवेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2034851, "chapter_id": 1751, "verse_number": "४-७४-९", "content_sanskrit": "स किलाक्षनिवापस्त्वं सभास्तारो मया कृतः।\nअथ राजासने कस्मादुपविष्टोऽस्यलंकृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2034852, "chapter_id": 1751, "verse_number": "४-७४-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2034853, "chapter_id": 1751, "verse_number": "४-७४-१०", "content_sanskrit": "परिहासेच्छया राज्ञो विराटस्य निशम्य तत्।\nस्मयमानोऽब्रवीद्वाक्यमर्जुनः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2034854, "chapter_id": 1751, "verse_number": "४-७४-११", "content_sanskrit": "इन्द्रस्यार्धासनं राजन्नयमारोढुमर्हति।\nब्रह्मण्यः श्रुतवांस्त्यागी सर्वलोकाभिपूजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2034855, "chapter_id": 1751, "verse_number": "४-७४-१२", "content_sanskrit": "एष विग्रहवान्धर्म एष वीर्यवतां वरः।\nएष बुद्ध्याधिको लोके तपसां च परायणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2034856, "chapter_id": 1751, "verse_number": "४-७४-१३", "content_sanskrit": "एषोऽस्त्रं विविधं वेत्ति त्रैलोक्ये सचराचरे।\nन चैवान्यः पुमान्वेत्ति न वेत्स्यति कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2034857, "chapter_id": 1751, "verse_number": "४-७४-१४", "content_sanskrit": "न देवा नासुराः केचिन्न मनुष्या न राक्षसाः।\nगन्धर्वयक्षप्रवराः सकिन्नरमहोरगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2034858, "chapter_id": 1751, "verse_number": "४-७४-१५", "content_sanskrit": "दीर्घदर्शी महातेजाः पारैजानपदप्रियः।\nपाण्डवानामतिरथो यज्ञधर्मपरो वशी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2034859, "chapter_id": 1751, "verse_number": "४-७४-१६", "content_sanskrit": "महर्षिकल्पो राजर्षिः सर्वलोकेषु विश्रुतः ।\nबलवान्धृतिमान्दक्षः सत्यवादी जितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2034860, "chapter_id": 1751, "verse_number": "४-७४-१७", "content_sanskrit": "धनैश्च संचयैश्चैव शक्रवैश्रवणोपमः ।\nयथा मनुर्महातेजा लोकानां परिरक्षिता ।\nएवमेव महातेजाः प्रजानुग्रहकारकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2034861, "chapter_id": 1751, "verse_number": "४-७४-१८", "content_sanskrit": "अयं कुरूणामृषभः कुन्तीपुत्रो युधिष्ठिरः ।\nयस्य कीर्तिः स्थिता लोके सूर्यस्येवोद्यतः प्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2034862, "chapter_id": 1751, "verse_number": "४-७४-१९", "content_sanskrit": "संसरन्ति दिशः सर्वा यशसोस्य गभस्तयः ।\nउदितस्येव सूर्यस्य तेजसोऽनुगभस्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2034863, "chapter_id": 1751, "verse_number": "४-७४-२०", "content_sanskrit": "एनं त्रिंशत्सहस्राणि कुञ्जराणां तरस्विनाम् ।\nअन्वयुः पृष्ठतो राजन्यावदध्यावसत्कुरून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2034864, "chapter_id": 1751, "verse_number": "४-७४-२१", "content_sanskrit": "त्रिंशच्चैव सहस्राणि रथानां रथिनां वरम्।\nसदश्वैरुपसंपन्नाः पृष्ठतोऽनुययुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2034865, "chapter_id": 1751, "verse_number": "४-७४-२२", "content_sanskrit": "वाजिनां च शतं राजन्त्सहस्राण्ययुतानि च।\nइममष्टशतं सूताः सुमृष्टमणिकुण्डलाः।\nतुष्टुवुर्मागधैः सार्धं पुरा शक्रमिवर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2034866, "chapter_id": 1751, "verse_number": "४-७४-२३", "content_sanskrit": "इमं नित्यपुमातिष्ठन्कुरवः किंकरास्तदा।\nसर्वे च नृप राजानं धनेश्वरमिवामराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2034867, "chapter_id": 1751, "verse_number": "४-७४-२४", "content_sanskrit": "एष सर्वान्महीपालान्करमाहारयत्तदा।\nवैश्यानिव महाराज विवशान्स्ववशानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2034868, "chapter_id": 1751, "verse_number": "४-७४-२५", "content_sanskrit": "अष्टाशीतिसहस्राणि स्नातकानां महात्मनाम्।\nउपजीवन्ति राजानमेनं सुचरितव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2034869, "chapter_id": 1751, "verse_number": "४-७४-२६", "content_sanskrit": "एष वृद्धाननाथांश्च व्यङ्गान्पङ्गूश्चं वामनान् ।\nपुत्रवत्पालयामास प्रजाधर्मेण चाभिभूः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2034870, "chapter_id": 1751, "verse_number": "४-७४-२७", "content_sanskrit": "एष धर्मे दमे चैव दाने सत्ये रतः सदा।\nमहाप्रसादो ब्रह्मण्यः सत्यवादी च पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2034871, "chapter_id": 1751, "verse_number": "४-७४-२८", "content_sanskrit": "श्रीमत्संपत्प्रभावेन तप्यते यस्य कौरवः ।\nरगणः सह कर्णेन सौबलेन च वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2034872, "chapter_id": 1751, "verse_number": "४-७४-२९", "content_sanskrit": "गुणा न शक्याः संख्यातुमेतस्यैव नरेश्वर।\nएष धर्मपरो नित्यमनृशंसः सुशीलवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2034873, "chapter_id": 1751, "verse_number": "४-७४-३०", "content_sanskrit": "एवं युक्तो महाराजा पाण्डवः पुरुषर्षभः ।\nकथं नार्हति राजार्हमासनं पृथिवीपतिः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2034874, "chapter_id": 1751, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि वैवाहिकपर्वणि चतुःसप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]