[{"id": 6000271000, "chapter_id": 10271, "verse_number": null, "content_sanskrit": "अथ पञ्चसप्ततितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000271001, "chapter_id": 10271, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.001.m4a", "display_order": 2}, {"id": 6000271002, "chapter_id": 10271, "verse_number": "१०-७५-१", "content_sanskrit": "सर्वासां महिषीणां तु गोविन्दासक्तचेतसाम्।\nमय्येव प्रेमवान् विष्णुरिति निश्चितचेतसाम्॥ १०/७५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.002.m4a", "display_order": 3, "topics": [{"text": "कृष्णरुग्मिण्योः प्रणयकलहः", "range": "१–३५"}]}, {"id": 6000271003, "chapter_id": 10271, "verse_number": "१०-७५-२", "content_sanskrit": "समः सर्वासु वा कृष्ण एकस्यां प्रेमवानुत।\nतन्मेऽनुशंस तच्छ्रोतुं रतिरस्ति मम प्रभो॥ १०/७५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.003.m4a", "display_order": 4}, {"id": 6000271004, "chapter_id": 10271, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.004.m4a", "display_order": 5}, {"id": 6000271005, "chapter_id": 10271, "verse_number": "१०-७५-३", "content_sanskrit": "महिषीणां तु सर्वासां प्रथमा भीष्मनन्दना।\nप्रेमवानधिकं तस्यामिति प्रख्यातिरूर्जिता॥ १०/७५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.005.m4a", "display_order": 6}, {"id": 6000271006, "chapter_id": 10271, "verse_number": "१०-७५-४", "content_sanskrit": "कदाचित् प्रेमकलहः केशवेन तया समम्।\nकृतस्तच्छृणु कौरव्य कार्त्स्न्येन कथयामि ते॥ १०/७५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.006.m4a", "display_order": 7}, {"id": 6000271007, "chapter_id": 10271, "verse_number": "१०-७५-५", "content_sanskrit": "कर्हिचित् सुखमासीनं स्वतल्पस्थं जगद्गुरुम्।\nपतिं पर्यचरद् भैष्मी व्यजनेन सखीजनैः॥ १०/७५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.007.m4a", "display_order": 8}, {"id": 6000271008, "chapter_id": 10271, "verse_number": "१०-७५-६", "content_sanskrit": "य एतल्लीलया विश्वं सृजत्यत्त्यवतीश्वरः।\nस हि जातः स्वसेतूनां गोपीथाय यदुष्वजः॥ १०/७५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.008.m4a", "display_order": 9}, {"id": 6000271009, "chapter_id": 10271, "verse_number": "१०-७५-७", "content_sanskrit": "तस्मिन्नन्तर्गृहे भ्राजन्मुक्तादामविलम्बिना।\nविराजिते वितानेन दीपैर्मणिमयैरपि॥ १०/७५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.009.m4a", "display_order": 10}, {"id": 6000271010, "chapter_id": 10271, "verse_number": "१०-७५-८", "content_sanskrit": "मल्लिकादामभिर्दिव्यैर्द्विरेफकुलनादितैः।\nजालरन्ध्रप्रविष्टैश्च गोभिश्चन्द्रमसोऽरुणैः॥ १०/७५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.010.m4a", "display_order": 11}, {"id": 6000271011, "chapter_id": 10271, "verse_number": "१०-७५-९", "content_sanskrit": "पारिजातवनामोदवायुनोद्यानशालिना।\nधूपैरागरवै राजन् जालरन्ध्रविनिर्गतैः॥ १०/७५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.011.m4a", "display_order": 12}, {"id": 6000271012, "chapter_id": 10271, "verse_number": "१०-७५-१०", "content_sanskrit": "पयःफेननिभे शुभ्रे पर्यङ्के कशिपूत्तमे।\nउपतस्थे सुखासीनं जगतामीश्वरं पतिम्॥ १०/७५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.012.m4a", "display_order": 13}, {"id": 6000271013, "chapter_id": 10271, "verse_number": "१०-७५-११", "content_sanskrit": "बालव्यजनमादाय रत्नदण्डं सखीकरात्।\nतेन वीजयती देवी उपासाञ्चक्र ईश्वरम्॥ १०/७५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.013.m4a", "display_order": 14}, {"id": 6000271014, "chapter_id": 10271, "verse_number": "१०-७५-१२", "content_sanskrit": "सोऽपाच्युतं क्‍वणयती मणिनूपुराभ्यां रेजेऽङ्गुलीयवलयव्यजनाग्रहस्ता।\nवस्‍त्रान्तगूढकुचकुङ्कुमशोणहारभासा नितम्बधृतया च परार्घ्यकाञ्च्या॥ १०/७५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.014.m4a", "display_order": 15}, {"id": 6000271015, "chapter_id": 10271, "verse_number": "१०-७५-१३", "content_sanskrit": "तां रुग्मिणीं श्रियमनन्यगतिं निरीक्ष्य या लीलया धृततनोरनुरूपरूपा।\nप्रीतः स्मयन्नलककुण्डलनिष्ककण्ठवक्त्रोल्लसत्स्मितसुधां हरिराबभाषे॥ १०/७५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.015.m4a", "display_order": 16}, {"id": 6000271016, "chapter_id": 10271, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.016.m4a", "display_order": 17}, {"id": 6000271017, "chapter_id": 10271, "verse_number": "१०-७५-१४", "content_sanskrit": "राजपुत्रीप्सिता भूपैर्लोकपालविभूतिभिः।\nमहानुभावैः श्रीमद्भी रूपौदार्यबलोर्जितैः॥ १०/७५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.017.m4a", "display_order": 18}, {"id": 6000271018, "chapter_id": 10271, "verse_number": "१०-७५-१५", "content_sanskrit": "तान् प्राप्तानर्थिनो हित्वा चैद्यादीन् स्मरदुर्मदान्।\nदत्ता भ्रात्रा स्वपित्रा च कस्माद् देववृषोपमान्॥ १०/७५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.018.m4a", "display_order": 19}, {"id": 6000271019, "chapter_id": 10271, "verse_number": "१०-७५-१६", "content_sanskrit": "राजभ्यो बिभ्यतः सुभ्रु समुद्रं शरणं गतान्।\nबलवद्भिः कृतद्वेषान् प्रायस्त्यक्तनृपासनान्॥ १०/७५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.019.m4a", "display_order": 20}, {"id": 6000271020, "chapter_id": 10271, "verse_number": "१०-७५-१७", "content_sanskrit": "अस्पष्टवर्त्मनां पुंसामलोकपथमीयुषाम्।\nआस्थिताः पदवीं सुभ्रु प्रायः सीदन्ति योषितः॥ १०/७५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.020.m4a", "display_order": 21}, {"id": 6000271021, "chapter_id": 10271, "verse_number": "१०-७५-१८", "content_sanskrit": "निष्किञ्चना वयं शश्वन्निष्किञ्चनजनप्रियाः।\nतस्मात् प्रायेण नो ह्याढ्या न भजन्ति सुमध्यमे॥ १०/७५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.021.m4a", "display_order": 22}, {"id": 6000271022, "chapter_id": 10271, "verse_number": "१०-७५-१९", "content_sanskrit": "ययोरात्मसमं वित्तं जन्मैश्वर्याकृतिर्भवः।\nतयोर्विवाहो मैत्री च नोत्तमाधमयोः क्‍वचित्॥ १०/७५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.022.m4a", "display_order": 23}, {"id": 6000271023, "chapter_id": 10271, "verse_number": "१०-७५-२०", "content_sanskrit": "वैदर्भ्येतदविज्ञाय त्वयाऽदीर्घसमीक्षया।\nवृता वयं गुणैर्हीना भिक्षुभिः श्लाघिता मुधा॥ १०/७५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.023.m4a", "display_order": 24}, {"id": 6000271024, "chapter_id": 10271, "verse_number": "१०-७५-२१", "content_sanskrit": "अथात्मनोऽनुरूपं वै भजस्व क्षत्रियर्षभम्।\nयेन त्वमाशिषः सत्या इहामुत्र च लप्स्यसे॥ १०/७५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.024.m4a", "display_order": 25}, {"id": 6000271025, "chapter_id": 10271, "verse_number": "१०-७५-२२", "content_sanskrit": "चैद्यसाल्वजरासन्धदन्तवक्रादयो नृपाः।\nद्विषन्ति मां वरारोहे रुग्मी चापि तवाग्रजः॥ १०/७५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.025.m4a", "display_order": 26}, {"id": 6000271026, "chapter_id": 10271, "verse_number": "१०-७५-२३", "content_sanskrit": "तेषां वीर्यमदान्धानां दृप्तानां स्मयनुत्तये।\nआनीताऽसि मया स्वद्धातेजोऽपहरताऽसताम्॥ १०/७५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.026.m4a", "display_order": 27}, {"id": 6000271027, "chapter_id": 10271, "verse_number": "१०-७५-२४", "content_sanskrit": "उदासीना वयं नूनं न स्‍त्र्यपत्यार्थकामुकाः।\nआत्मलब्ध्याऽऽस्महे पूर्णा नेहात्मसदृशाः क्रियाः॥ १०/७५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.027.m4a", "display_order": 28}, {"id": 6000271028, "chapter_id": 10271, "verse_number": "१०-७५-२५", "content_sanskrit": "एतावदुक्त्वा भगवानात्मानं वल्लभामिव।\nमन्यमानामविश्लेषात् तद्दर्पघ्न उपारमत्॥ १०/७५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.028.m4a", "display_order": 29}, {"id": 6000271029, "chapter_id": 10271, "verse_number": "१०-७५-२६", "content_sanskrit": "इति त्रिलोकेशपतेस्तदात्मनः प्रियस्य देव्यश्रुतपूर्वमप्रियम्।\nआश्रुत्य भीता हृदि जातवेपथुश्चिन्तां दुरन्तां रुदती जगाम ह॥ १०/७५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.029.m4a", "display_order": 30}, {"id": 6000271030, "chapter_id": 10271, "verse_number": "१०-७५-२७", "content_sanskrit": "पदा सुजातेन नखारुणश्रिया भुवं लिखन्त्यश्रुभिरञ्जनासितैः।\nआसिञ्चती कुङ्कुमरूषितौ स्तनौ तस्थावधोमुख्यतिदुःखरुद्धवाक्॥ १०/७५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.030.m4a", "display_order": 31}, {"id": 6000271031, "chapter_id": 10271, "verse_number": "१०-७५-२८", "content_sanskrit": "तस्याः सुदुःखभयशोकविनष्टबुद्धेर्हस्ताच्छ्लथद्वलयतो व्यजनं पपात।\nदेहश्च विक्लवधियः सहसैव बिभ्यद् रम्भेव वातविहता प्रविकीर्य केशान्॥ १०/७५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.031.m4a", "display_order": 32}, {"id": 6000271032, "chapter_id": 10271, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.032.m4a", "display_order": 33}, {"id": 6000271033, "chapter_id": 10271, "verse_number": "१०-७५-२९", "content_sanskrit": "तद् दृष्ट्वा भगवान् कृष्णः प्रियायाः प्रेमबन्धनम्।\nहास्यप्रौढिमजानन्त्याः करुणः सोऽन्वकम्पत॥ १०/७५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.033.m4a", "display_order": 34}, {"id": 6000271034, "chapter_id": 10271, "verse_number": "१०-७५-३०", "content_sanskrit": "पर्यङ्कादवरुह्याशु तामुत्थाप्य चतुर्भुजः।\nकेशान् समूह्य तद्वक्त्रं प्रामृजत् पद्मपाणिना॥ १०/७५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.034.m4a", "display_order": 35}, {"id": 6000271035, "chapter_id": 10271, "verse_number": "१०-७५-३१", "content_sanskrit": "प्रमृज्याश्रुकले नेत्रे स्तनौ चोपहतौ शुचा।\nआश्लिष्य बाहुना राजन्ननन्यविषयां सतीम्॥ १०/७५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.035.m4a", "display_order": 36}, {"id": 6000271036, "chapter_id": 10271, "verse_number": "१०-७५-३२", "content_sanskrit": "सान्त्वयामास सान्त्वज्ञः कृपया कृपणां प्रभुः।\nहास्यप्रौढेर्भ्रमच्चित्तामतदर्हां सतां गतिः॥ १०/७५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.036.m4a", "display_order": 37}, {"id": 6000271037, "chapter_id": 10271, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.037.m4a", "display_order": 38}, {"id": 6000271038, "chapter_id": 10271, "verse_number": "१०-७५-३३", "content_sanskrit": "मा मा वैदर्भ्यसूयेथा जाने त्वां मत्परायणाम्।\nत्वद्वचः श्रोतुकामेन क्ष्वेलाचरितमङ्गने॥ १०/७५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.038.m4a", "display_order": 39}, {"id": 6000271039, "chapter_id": 10271, "verse_number": "१०-७५-३४", "content_sanskrit": "मुखं च प्रेमसंरम्भस्फुरिताधरमीक्षितुम्।\nकटाक्षेणारुणापाङ्गसुन्दरभ्रुकुटीतटम्॥ १०/७५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.039.m4a", "display_order": 40}, {"id": 6000271040, "chapter_id": 10271, "verse_number": "१०-७५-३५", "content_sanskrit": "अयं हि परमो लाभो गृहेषु गृहमेधिनाम्।\nयन्नर्मैर्नीयते यामः प्रियया भीरुभाषिणि॥ १०/७५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.040.m4a", "display_order": 41}, {"id": 6000271041, "chapter_id": 10271, "verse_number": "१०-७५-३६", "content_sanskrit": "सैवं भगवता राजन् वैदर्भी परिसान्त्विता।\nज्ञात्वा तां परिहासोक्तिं प्रियत्यागभयं जहौ॥ १०/७५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.041.m4a", "display_order": 42}, {"id": 6000271042, "chapter_id": 10271, "verse_number": "१०-७५-३७", "content_sanskrit": "बभाषे ऋषभं पंुसामीक्षती भगवन् मुखम्।\nसव्रीडहासरुचिरस्निग्धापाङ्गेन भारत॥ १०/७५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.042.m4a", "display_order": 43}, {"id": 6000271043, "chapter_id": 10271, "verse_number": null, "content_sanskrit": "रुग्मिण्युवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.043.m4a", "display_order": 44}, {"id": 6000271044, "chapter_id": 10271, "verse_number": "१०-७५-३८", "content_sanskrit": "नन्वेतदेवमरविन्दविलोचनाह यद् वै भवान् न भवतः सदृशो विभूम्नः।\nक्‍व स्वे महिम्न्यभिरतो भगवांस्‍त्र्यधीशः क्‍वाहं गुणप्रकृतिरन्यगृहीतपादा॥ १०/७५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.044.m4a", "display_order": 45, "topics": [{"text": "कृष्णवचसां रुग्मिणीकृतव्याख्यानम्", "range": "३८–५२"}]}, {"id": 6000271045, "chapter_id": 10271, "verse_number": "१०-७५-३९", "content_sanskrit": "सत्यं भयादिव गुणेभ्य उरुक्रमान्तः शेते समुद्र उपलम्भनमात्र आत्मा।\nयोऽनित्यकेन्द्रियगणैः कृतविग्रहस्त्वं, त्वत्सेवया नृपपदं विधुतं तमोऽन्धम्॥ १०/७५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.045.m4a", "display_order": 46}, {"id": 6000271046, "chapter_id": 10271, "verse_number": "१०-७५-४०", "content_sanskrit": "त्वत्पादपद्ममकरन्दजुषां मुनीनां वर्त्म स्फुटं, नृपशुभिर्ननु दुर्विभाव्यम्।\nयस्मादलौकिकमिवेहितमीश्वरस्य भूमंस्तवेहितमथो अनु मे भवन्ति॥ १०/७५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.046.m4a", "display_order": 47}, {"id": 6000271047, "chapter_id": 10271, "verse_number": "१०-७५-४१", "content_sanskrit": "निष्किञ्चनो ननु भवान्, न यतोऽस्ति किञ्चिद्, यस्मै बलिं बलिभुजोऽपि हरन्त्यजाद्याः।\nन त्वा विदन्त्यसुतृपोऽन्तिकमाढ्यतान्धाः प्रेष्ठः सतां बलिभुजामपि योऽन्तरास्ते॥ १०/७५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.047.m4a", "display_order": 48}, {"id": 6000271048, "chapter_id": 10271, "verse_number": "१०-७५-४२", "content_sanskrit": "त्वं वै समस्तपुरुषार्थमयः फलात्मा यद्वाञ्छया सुमतयो विसृजन्ति कृत्स्नम्।\nतेषां विभो समुदितो भवतः प्रसादस्‍त्रय्यां च यश्च रतयोः सुखदुःखिनोर्न॥ १०/७५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.048.m4a", "display_order": 49}, {"id": 6000271049, "chapter_id": 10271, "verse_number": "१०-७५-४३", "content_sanskrit": "त्वं न्यस्तदण्डमुनिभिर्गदितानुभाव आत्माऽऽत्मदश्च जगतामिति मे वृतोऽसि।\nमुक्त्वा भवद्भवदुदीरितकालगन्धध्वस्ताशिषोऽब्जभवनाकपतीन् कुतोऽन्यान्॥ १०/७५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.049.m4a", "display_order": 50}, {"id": 6000271050, "chapter_id": 10271, "verse_number": "१०-७५-४४", "content_sanskrit": "सत्यं वचस्तव गदाग्रज यश्च भूपान् विद्राव्य शार्ङ्गनिनदेन जहर्थ मां त्वम्।\nसिंहो यथा स्वबलिमीश पशुं स्वभागं तेभ्यो भयाद् यदुदधिं शरणं प्रपन्नः॥ १०/७५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.050.m4a", "display_order": 51}, {"id": 6000271051, "chapter_id": 10271, "verse_number": "१०-७५-४५", "content_sanskrit": "यद्वाञ्छया नृपशिखामणयोऽङ्गवैन्यजायन्तनाहुषगयादय ऐकपत्यम्।\nराज्यं विसृज्य विविशुर्वनमम्बुजाक्ष सीदन्ति नानुपदवीं त इहास्थिताः किम्॥ १०/७५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.051.m4a", "display_order": 52}, {"id": 6000271052, "chapter_id": 10271, "verse_number": "१०-७५-४६", "content_sanskrit": "का स्‍त्री वृणीत तव पादसरोजगन्धमाघ्राय सन्मुखरितं जनतापवर्गम्।\nलक्ष्म्यालयं त्वविगणय्य गुणालयाढ्यं मर्त्याशिषोरुभयमर्थविविक्तदृष्टिः॥ १०/७५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.052.m4a", "display_order": 53}, {"id": 6000271053, "chapter_id": 10271, "verse_number": "१०-७५-४७", "content_sanskrit": "तं त्वाऽनुरूपमभजं जगतामधीशमात्मानमत्र च परत्र च कामरूपम्।\nस्यान्मे तवाङ्घ्रिशरणं श्रुतिभिर्भ्रमत्या ये वै भजन्ति त उ यान्त्यनृतापवर्गम्॥ १०/७५/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.053.m4a", "display_order": 54}, {"id": 6000271054, "chapter_id": 10271, "verse_number": "१०-७५-४८", "content_sanskrit": "कस्याः स्युरच्युत नृपा भवतोपदिष्टाः स्‍त्रीणां गृहेषु खरगोश्वबिडालभृत्याः।\nयत्कर्णमूलमरिकर्शन नोपयायाद् युष्मत्कथा मृडविरिञ्चसभासु गीता॥ १०/७५/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.054.m4a", "display_order": 55}, {"id": 6000271055, "chapter_id": 10271, "verse_number": "१०-७५-४९", "content_sanskrit": "त्वक्श्मश्रुरोमनखकेशपिनद्धमन्तर्मांसास्थिरक्तकृमिविड्भरितान्त्रवीतम्।\nजीवच्छवं भजति काममतिर्विमूढा या ते पदाब्जमकरन्दमजिघ्रती स्‍त्री॥ १०/७५/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.055.m4a", "display_order": 56}, {"id": 6000271056, "chapter_id": 10271, "verse_number": "१०-७५-५०", "content_sanskrit": "अस्त्यम्बुजाक्ष मम ते चरणानुराग आत्मन् रतस्य मयि चानतिरिक्तदृष्टेः।\nयर्ह्यस्य वृद्धय उपात्तरजोऽतिमात्रो मामीक्षसे तदु ह नः परमानुकम्पा॥ १०/७५/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.056.m4a", "display_order": 57}, {"id": 6000271057, "chapter_id": 10271, "verse_number": "१०-७५-५१", "content_sanskrit": "नैवालीकं भवत्येव वचस्ते मधुसूदन।\nअम्बाया इव हि प्रायः कन्यावादरतिः क्‍वचित्॥ १०/७५/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.057.m4a", "display_order": 58}, {"id": 6000271058, "chapter_id": 10271, "verse_number": "१०-७५-५२", "content_sanskrit": "मुग्धायाश्चापि पुंश्चल्या मनोऽभ्येति नवं नवम्।\nबुधोऽसतीं न बिभृयात् तां बिभ्रदुभयच्युतः॥ १०/७५/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.058.m4a", "display_order": 59}, {"id": 6000271059, "chapter_id": 10271, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.059.m4a", "display_order": 60}, {"id": 6000271060, "chapter_id": 10271, "verse_number": "१०-७५-५३", "content_sanskrit": "साध्व्येतच्छ्रोतुकामैस्त्वं राजपुत्रि प्रलम्भिता।\nममोदितं यदन्वर्थं सर्वं तत् सत्यमेव हि॥ १०/७५/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.060.m4a", "display_order": 61, "topics": [{"text": "रुग्मिणीवचसां कृष्णानुमोदनम्", "range": "५३–६२"}]}, {"id": 6000271061, "chapter_id": 10271, "verse_number": "१०-७५-५४", "content_sanskrit": "यं यं कामयसे कामं मयि कामय कामिनि।\nसन्ति ह्येकान्तभक्तायास्तव कल्याणि नित्यदा॥ १०/७५/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.061.m4a", "display_order": 62}, {"id": 6000271062, "chapter_id": 10271, "verse_number": "१०-७५-५५", "content_sanskrit": "उपलब्धं पतिप्रेम पातिव्रत्यं च तेऽनघे।\nयद् वाक्यैश्चोद्यमानाया न धीर्मय्यपकर्षिता॥ १०/७५/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.062.m4a", "display_order": 63}, {"id": 6000271063, "chapter_id": 10271, "verse_number": "१०-७५-५६", "content_sanskrit": "ये मां भजन्ति दाम्पत्ये तपसा व्रतचर्यया।\nकामात्मानोऽपवर्गेशं मोहिता मम मायया॥ १०/७५/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.063.m4a", "display_order": 64}, {"id": 6000271064, "chapter_id": 10271, "verse_number": "१०-७५-५७", "content_sanskrit": "मां प्राप्य मानिन्यपवर्गसम्पदं वाञ्छन्ति ये सम्पद एव सत्पतिम्।\nते मन्दभाग्या, निरयेऽपि ये स्युर्मात्रात्मकत्वान्निरये सुसङ्गमः॥ १०/७५/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.064.m4a", "display_order": 65}, {"id": 6000271065, "chapter_id": 10271, "verse_number": "१०-७५-५८", "content_sanskrit": "दिष्ट्या गृहैश्वर्ययुते मयि त्वया कृताऽनुवृत्तिर्भवमोचिनी खलैः।\nसुदुष्कराऽसौ सुतरां दुराशिषो ह्यसुम्भराया विकृतिञ्जुषः स्‍त्रियः॥ १०/७५/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.065.m4a", "display_order": 66}, {"id": 6000271066, "chapter_id": 10271, "verse_number": "१०-७५-५९", "content_sanskrit": "न त्वादृशीं प्रणयिनीं गृहिणीं गृहेषु पश्यामि मानिनि यया स्वविवाहकाले।\nप्राप्तान् नृपानविगणय्य रहो रहो मे प्रस्थापितो द्विज उपस्थितसत्कथस्य॥ १०/७५/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.066.m4a", "display_order": 67}, {"id": 6000271067, "chapter_id": 10271, "verse_number": "१०-७५-६०", "content_sanskrit": "भ्रातुर्विरूपकरणं युधि निर्जितस्य प्रोद्वाहपर्वणि च तद्वधमक्षगोष्ठ्याम्।\nदुःखं समुत्थमसहोऽस्मदयोगभीत्या नैवाब्रवीः किमपि तेन वयं जितास्ते॥ १०/७५/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.067.m4a", "display_order": 68}, {"id": 6000271068, "chapter_id": 10271, "verse_number": "१०-७५-६१", "content_sanskrit": "दूतस्त्वयाऽऽत्मलभने सुविविक्तमन्त्रः प्रस्थापितो मयि चिरायति शून्यमेतत्।\nमत्वा जिहासुरिदमङ्गमनन्ययोग्यं तिष्ठेस्ततस्त्वयि वयं प्रतिनन्दयामः॥ १०/७५/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.068.m4a", "display_order": 69}, {"id": 6000271069, "chapter_id": 10271, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.069.m4a", "display_order": 70}, {"id": 6000271070, "chapter_id": 10271, "verse_number": "१०-७५-६२", "content_sanskrit": "एवं सौरतसल्लापैर्भगवान् देवकीसुतः।\nस्वरतो रमया रेमे नरलोकं विडम्बयन्॥ १०/७५/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.070.m4a", "display_order": 71}, {"id": 6000271071, "chapter_id": 10271, "verse_number": "१०-७५-६३", "content_sanskrit": "तथान्यासामपि स्‍त्रीणां गृहेषु गृहवानिव।\nआस्थितो गृहमेधीयान् धर्मांल्लोकगुरुर्जुषन्॥ १०/७५/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_075/BhP_10.075.071.m4a", "display_order": 72, "topics": [{"text": "कृष्णेन नैकगृहेषु गृहस्थधर्मपरिपालनम्", "range": "६३"}]}, {"id": 6000271072, "chapter_id": 10271, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे पञ्चसप्ततितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]