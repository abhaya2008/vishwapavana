[{"id": 2082459, "chapter_id": 2756, "verse_number": "१२-२६१-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082460, "chapter_id": 2756, "verse_number": "१२-२६१-१", "content_sanskrit": "भूतानां गुणसङ्ख्यानं भूयः पुत्र निशामय।\nद्वैपायनमुखाद्धष्टं श्लाघया परयाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082461, "chapter_id": 2756, "verse_number": "१२-२६१-२", "content_sanskrit": "दीप्तानलनिभः प्राह भगवान्धूमवत्सलः।\nततोऽहमपि वक्ष्यामि भूयः पुत्र निदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082462, "chapter_id": 2756, "verse_number": "१२-२६१-३", "content_sanskrit": "भूमेः स्थैर्यं गुरुत्वं च काठिन्यं प्रसवात्मता।\nगन्धो भारश्च शक्तिश्च संघातः स्थापना धृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082463, "chapter_id": 2756, "verse_number": "१२-२६१-४", "content_sanskrit": "अपां शैत्यं रसः क्लेदो द्रवत्वं स्नेहसौम्यता।\nजिह्वाविस्यन्दनं चापि भौमानां श्रपणं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082464, "chapter_id": 2756, "verse_number": "१२-२६१-५", "content_sanskrit": "अग्नेर्दुर्धर्षता ज्योतिस्तापः पाकः प्रकाशनम्।\nशौचं रागो लघुस्तैक्ष्ण्यं सततं चोर्ध्वभागिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082465, "chapter_id": 2756, "verse_number": "१२-२६१-६", "content_sanskrit": "वायोरनियमस्पर्शो वादस्थानं स्वतन्त्रता।\nबलं शैध्यं च मोक्षं च कर्म चेष्टात्मता भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082466, "chapter_id": 2756, "verse_number": "१२-२६१-७", "content_sanskrit": "आकाशस्य गुणः शब्दो व्यापित्वं छिद्रताऽपि च।\nअनाश्रयमनालम्बमव्यक्तमविकारिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082467, "chapter_id": 2756, "verse_number": "१२-२६१-८", "content_sanskrit": "अप्रतीघातिता चैव श्रोतत्वं विवराणि च।\nगुणाः पञ्चाशतं प्रोक्ताः पञ्चभूतविभाविताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082468, "chapter_id": 2756, "verse_number": "१२-२६१-९", "content_sanskrit": "फलोपपत्तिर्व्यक्तिश्च विसर्गः कल्पना क्षमा।\nसदसच्चाशुता चैव मनसो नव वै गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082469, "chapter_id": 2756, "verse_number": "१२-२६१-१०", "content_sanskrit": "इष्टानिष्टविपत्तिश्च व्यवसायः समाधिता।\nसंशयः प्रतिपत्तिश्च बुद्धेः पञ्च गुणान्विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082470, "chapter_id": 2756, "verse_number": "१२-२६१-११x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082471, "chapter_id": 2756, "verse_number": "१२-२६१-११", "content_sanskrit": "कथं पञ्चगुणा बुद्धिः कथं पञ्चेन्द्रिया गुणाः।\nएतन्मे सर्वमाचक्ष्व सूक्ष्मज्ञानं पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082472, "chapter_id": 2756, "verse_number": "१२-२६१-१२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082473, "chapter_id": 2756, "verse_number": "१२-२६१-१२", "content_sanskrit": "आहुः षष्टिं भूतगुणान्वै\nभूतविषक्तान्प्रकृतिविसृष्टान्।\nनित्यविषक्तांश्चाक्षरसृष्टा\nन्पुत्र न नित्यं तदिह वदन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082474, "chapter_id": 2756, "verse_number": "१२-२६१-१३", "content_sanskrit": "तत्पुत्रचिन्ताकलिलं तदुक्त\nमनागतं वै तव संप्रतीह।\nभूतार्थवत्त्वं तदवाप्य सर्वं\nभूतप्रभावाद्भव शान्तबुद्धिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082475, "chapter_id": 2756, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वँणि एकषष्ट्यधिकद्विशततमोऽध्यायः॥ २६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]