[{"id": 7002421000, "chapter_id": 22421, "verse_number": "१-८३-१", "content_sanskrit": "ब्रह्मोवाच ।\nमासि भाद्रपदे वीर शुक्ते पक्षे तु यो भवेत् ।\nषष्ठ्यां गणकुलश्रेष्ठ स भद्रः परिकीर्तितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002421001, "chapter_id": 22421, "verse_number": "१-८३-२", "content_sanskrit": "तत्र नक्तं तु यः कुर्यादुपवासमथापि वा ।\nहंसयानसमारूढो याति हंससलोकताम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002421002, "chapter_id": 22421, "verse_number": "१-८३-३", "content_sanskrit": "मालतीकुसुमानीह तथा श्वेतं च चन्दनम् ।\nविजयं च तथा धूपं नैवेद्यं पायसं परम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002421003, "chapter_id": 22421, "verse_number": "१-८३-४", "content_sanskrit": "पूजायां भास्करस्येह कुर्यात्त्रिपुरसूदनम् ।\nइत्थं सम्पूज्य देवेशं मध्याह्ने च दिनाधिपम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002421004, "chapter_id": 22421, "verse_number": "१-८३-५", "content_sanskrit": "दत्त्वा तु दक्षिणां शक्त्या ततो भुञ्जीत वाग्यतः ।\nपायसं गणशार्दूल सगुडं सर्पिषा सह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002421005, "chapter_id": 22421, "verse_number": "१-८३-६", "content_sanskrit": "य एवं पूजयेद्भक्त्या मानवस्तिमिरापहम् ।\nसर्वकामानवाप्नोति पुत्रदारधनादिकान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002421006, "chapter_id": 22421, "verse_number": "१-८३-७", "content_sanskrit": "विमुक्तः सर्वपापेभ्यो व्रजद्भानुसलोकताम् ।\nएष भद्रा विधिः प्रोक्तो मया यस्ते गणाधिप ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002421007, "chapter_id": 22421, "verse_number": "१-८३-८", "content_sanskrit": "श्रुत्वा कृत्वा च यत्पापान्मुच्यते मानवो भुवि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]