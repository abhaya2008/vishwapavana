[{"id": 7006164000, "chapter_id": 26164, "verse_number": "१-२-२५-१", "content_sanskrit": "शांशापायनिरुवाच ।\nकथं त्रेतायुगमुखे यज्ञस्य स्यात्प्रवर्त्तनम् ।\nपूर्वं स्वायंभुवे सर्गे यथावत्तच्च ब्रूहि मे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006164001, "chapter_id": 26164, "verse_number": "१-२-२५-२", "content_sanskrit": "अंतर्हितायां संध्यायां सार्द्धं कृतयुगेन वै ।\nकालाख्यायां प्रवृत्तायां प्राप्ते त्रेतायुगे तदा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006164002, "chapter_id": 26164, "verse_number": "१-२-२५-३", "content_sanskrit": "औषधीषु च जातासु प्रवृत्ते वृष्टिसर्जने ।\nप्रतिष्ठितायां वार्त्तायां गृहाश्रमपरे पुनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006164003, "chapter_id": 26164, "verse_number": "१-२-२५-४", "content_sanskrit": "वर्णाश्रमव्यवस्थानं कृतवंतश्च संख्यया ।\nसंभारांस्तांस्तु मंभृत्य कथं यज्ञः प्रवर्त्तितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006164004, "chapter_id": 26164, "verse_number": "१-२-२५-५", "content_sanskrit": "एतच्छुत्वाऽब्रवीत्सूतः श्रूयतां शांशपायने ।\nयथा त्रेतायुगमुखे यज्ञस्य स्यात्प्रवर्तनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006164005, "chapter_id": 26164, "verse_number": "१-२-२५-६", "content_sanskrit": "पूर्वं स्वायंभुवे सर्गे तद्वक्ष्याम्यानुपूर्व्यतः ।\nअंतर्हितायां संध्यायां सार्द्धं कृतयुगेन तु ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006164006, "chapter_id": 26164, "verse_number": "१-२-२५-७", "content_sanskrit": "कालाख्यायां प्रवृत्तायां प्रप्ते त्रेतायुगे तदा ।\nऔषधीषु च जातासु प्रवृत्ते वृष्टिसर्जने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006164007, "chapter_id": 26164, "verse_number": "१-२-२५-८", "content_sanskrit": "प्रतिष्ठितायां वार्त्तायां गृहश्रमपरेषु च ।\nवर्णाश्रमव्यवस्थानं कृत्वा मंत्रांस्तु संहतान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006164008, "chapter_id": 26164, "verse_number": "१-२-२५-९", "content_sanskrit": "मंत्रांस्तान्योजयित्वाथ इहामुत्र च कर्मसु ।\nतदा विश्वभुगिंद्रश्च यज्ञं प्रावर्त्तयत्प्रभुः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006164009, "chapter_id": 26164, "verse_number": "१-२-२५-१०", "content_sanskrit": "दैवतैः सहितैः सर्वैः सर्वसंभारसंभृतैः ।\nतस्याश्वमेधे वितते समाजग्मुर्महर्षयः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006164010, "chapter_id": 26164, "verse_number": "१-२-२५-११", "content_sanskrit": "यजंतं पशुभिर्मे ध्यैरूचुः सर्वे समागताः ।\nकर्मव्यग्रेषु ऋत्विक्षु संतते यज्ञकर्मणि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006164011, "chapter_id": 26164, "verse_number": "१-२-२५-१२", "content_sanskrit": "संप्रगीथेषु सर्वेषु सामगेष्वथ सुस्वग्म् ।\nपरिक्रांतेषु लघुषु ह्यध्वर्युवृषभेषु च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006164012, "chapter_id": 26164, "verse_number": "१-२-२५-१३", "content_sanskrit": "आलब्धेषु च मेध्येषु तथा पशुगणेषु च ।\nहविष्यग्नौ हूयमाने ब्राह्मणैश्चाग्निहोत्रिभिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006164013, "chapter_id": 26164, "verse_number": "१-२-२५-१४", "content_sanskrit": "आहूतेषु च सर्वेषु यज्ञभाक्षु क्रमात्तदा ।\nय इंद्रियात्मका देवास्तदा ते यज्ञभागिनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006164014, "chapter_id": 26164, "verse_number": "१-२-२५-१५", "content_sanskrit": "तद्यचन्ते तदा देवान्कल्पादिषु भवंति ये ।\nअध्वर्यवः प्रैषकाले व्यत्थिता वै महर्षयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006164015, "chapter_id": 26164, "verse_number": "१-२-२५-१६", "content_sanskrit": "महर्षयस्तु तान्दृष्ट्वा दीनान्पशुगणांस्तदा ।\nप्रपच्छुरिद्रं संभूय कोऽयं यज्ञ विधिस्तव ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006164016, "chapter_id": 26164, "verse_number": "१-२-२५-१७", "content_sanskrit": "अधर्मो बलवानेष हिंसाधर्मेप्सया ततः ।\nततः पशुवधश्चैष तव यज्ञे सुरोत्तम ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006164017, "chapter_id": 26164, "verse_number": "१-२-२५-१८", "content_sanskrit": "अधर्मो धर्मघाताय प्रारब्धः पशुहिसया ।\nनायं धर्मो ह्यधर्मोऽयं न हिंसा धर्म उच्यते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006164018, "chapter_id": 26164, "verse_number": "१-२-२५-१९", "content_sanskrit": "आगमेन भवान्यज्ञं करोतु यदिहेच्छति ।\nविधिदृष्टेन यज्ञेन धर्मेणाव्यपसेतुना ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006164019, "chapter_id": 26164, "verse_number": "१-२-२५-२०", "content_sanskrit": "यज्ञबीचैः सुरेश्रष्ठ येषु हिंसा न विद्यते ।\nत्रिवर्षं परमं कालमुषितैरप्ररोहिभिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006164020, "chapter_id": 26164, "verse_number": "१-२-२५-२१", "content_sanskrit": "एष धर्मो महाप्राज्ञ विरंचिविहितः पुरा ।\nएवं विश्वभुगिंद्रस्तु ऋषिभिस्तत्त्वदर्शिभिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006164021, "chapter_id": 26164, "verse_number": "१-२-२५-२२", "content_sanskrit": "तदा विवादः सुमहानिंद्रस्यासीन्महर्षिभिः ।\nजंगमस्थावरैः कैर्हि यष्टव्यमिति चोच्यते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006164022, "chapter_id": 26164, "verse_number": "१-२-२५-२३", "content_sanskrit": "ते तु खिन्ना विवादेन तत्त्वमुत्त्वा महर्षयः ।\nसन्धाय वाक्यमिंद्रेण पप्रच्छुः खेचरं वसुम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006164023, "chapter_id": 26164, "verse_number": "१-२-२५-२४", "content_sanskrit": "सहाप्राज्ञ कथं दृष्टस्त्वया यज्ञविधिर्नृप ।\nऔत्तानपादे प्रब्रूहि संशयं नो नुद प्रभो ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006164024, "chapter_id": 26164, "verse_number": "१-२-२५-२५", "content_sanskrit": "श्रुत्वा वाक्यं वसुस्तेषाम विचार्य बलाबलम् ।\nवेदशास्त्रमनुस्मृत्य यज्ञतत्त्वमुवाच ह ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006164025, "chapter_id": 26164, "verse_number": "१-२-२५-२६", "content_sanskrit": "यथोपनीर्तैर्यष्टव्यमिति होवाच पार्थिवः ।\nयष्टव्यं पशुभिर्मे ध्यैरथ बीजैः फलैरपि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006164026, "chapter_id": 26164, "verse_number": "१-२-२५-२७", "content_sanskrit": "हिंसास्वभावो यज्ञस्य इति मे दर्शनागमौ ।\nयथेह देवता मंत्रा हिंसालिंगा महर्षिभिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006164027, "chapter_id": 26164, "verse_number": "१-२-२५-२८", "content_sanskrit": "दीर्घेण तपसा युक्तैर्दर्शनैस्तारकादिभिः ।\nतत्प्रामाण्यान्मया चोक्तं तस्मात्स प्राप्तुमर्हथ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006164028, "chapter_id": 26164, "verse_number": "१-२-२५-२९", "content_sanskrit": "यदि प्रमाणं तान्येव मंत्रवाक्यानि वै द्विजाः ।\nतथा प्रवततां यज्ञो ह्यन्यथा वोऽनृतं वचः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006164029, "chapter_id": 26164, "verse_number": "१-२-२५-३०", "content_sanskrit": "एवं कृतोत्तरास्ते वै युक्तात्मानस्तपोधनाः ।\nअवश्यभावितं दृष्ट्वा तमथो वाग्यताऽभवन् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006164030, "chapter_id": 26164, "verse_number": "१-२-२५-३१", "content_sanskrit": "इत्युक्तमात्रे नृपतिः प्रविवेश रसातलम् ।\nऊर्ध्वचारी वसुर्भूत्वा रसातलचरोऽभवत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006164031, "chapter_id": 26164, "verse_number": "१-२-२५-३२", "content_sanskrit": "वसुधा तलवासी तु तेन वाक्येन सोऽभवत् ।\nधर्माणां संशयच्छेत्ता राजा वसुरधोगतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006164032, "chapter_id": 26164, "verse_number": "१-२-२५-३३", "content_sanskrit": "तस्मान्न वाच्यमेकेन बहुज्ञेनापि संशये ।\nबहुद्वारस्य धर्मस्य सूक्ष्मा दूरतरा गतिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006164033, "chapter_id": 26164, "verse_number": "१-२-२५-३४", "content_sanskrit": "तस्मान्न निश्चयाद्वक्तुं धर्मः शक्यस्तु केनचित् ।\nदेवानृषीनुपादाय स्वायंभुवमृते मनुम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006164034, "chapter_id": 26164, "verse_number": "१-२-२५-३५", "content_sanskrit": "तस्मादहिंसा धर्मस्य द्वारमुक्तं महर्षिभिः ।\nऋषिकोटिसहस्राणि स्वतपोभिर्दिवं ययुः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006164035, "chapter_id": 26164, "verse_number": "१-२-२५-३६", "content_sanskrit": "तस्मान्न दानं यज्ञं वा प्रशंसंति महर्षयः ।\nउञ्छमूलफलं शाकमुदपात्रं तपोधनाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006164036, "chapter_id": 26164, "verse_number": "१-२-२५-३७", "content_sanskrit": "एतद्दत्वा विभवतः स्वर्गे लोके प्रतिष्ठिताः ।\nअद्रोहश्चाप्य लोभश्च तपो भुतदया दमः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006164037, "chapter_id": 26164, "verse_number": "१-२-२५-३८", "content_sanskrit": "ब्रह्मचर्यं तथा सत्यमनुक्रोशः क्षमा धृतिः ।\nसनातनस्य धर्मस्य मूलमेतद्दुरासदम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006164038, "chapter_id": 26164, "verse_number": "१-२-२५-३९", "content_sanskrit": "श्रूयंते हि तपःसिद्धा ब्रह्मक्षत्रादयोऽनघाः ।\nप्रियव्रतोत्तानपादौ ध्रुवो मेधातिथिर्वसुः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006164039, "chapter_id": 26164, "verse_number": "१-२-२५-४०", "content_sanskrit": "सुधामा विरजाश्चैव शंखः पांड्यज एव च ।\nप्राजीनबर्हिः पर्जन्यो हविर्धानादयो नृपः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006164040, "chapter_id": 26164, "verse_number": "१-२-२५-४१", "content_sanskrit": "एते चान्ये च बहवः स्वैस्तपोभिर्दिवं गताः ।\nराजर्षयो महासत्त्वा येषां कीर्त्तिः प्रतिष्ठिता ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006164041, "chapter_id": 26164, "verse_number": "१-२-२५-४२", "content_sanskrit": "तस्माद्विशिष्यते यज्ञात्तपः सर्वैस्तु कारणः ।\nब्रह्मणा तपसा सृष्टं जगद्विश्वमिदं पुरा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006164042, "chapter_id": 26164, "verse_number": "१-२-२५-४३", "content_sanskrit": "तस्मान्नान्वेति तद्यज्ञस्तपोमूलमिदं स्मृतम् ।\nद्रव्यमंत्रात्मको यज्ञस्तपस्त्वनशनात्मकम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006164043, "chapter_id": 26164, "verse_number": "१-२-२५-४४", "content_sanskrit": "यज्ञेन देवानाप्नोति वैराजं तपसा पुनः ।\nब्राह्मं तु कर्म संन्यासाद्वैराग्यात्प्रकृतेर्जयम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006164044, "chapter_id": 26164, "verse_number": "१-२-२५-४५", "content_sanskrit": "ज्ञानात्प्राप्नोति कैवल्यं पंचैतागतयः स्मृताः ।\nएवं विवादः सुमहान्य ज्ञस्यासीत्प्रवर्त्तने ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006164045, "chapter_id": 26164, "verse_number": "१-२-२५-४६", "content_sanskrit": "देवतानामृषीणां च पूर्व स्वायंभुवेऽन्तरे ।\nततस्तमृषयो दृष्ट्वा हतं धर्मबलेन तु ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006164046, "chapter_id": 26164, "verse_number": "१-२-२५-४७", "content_sanskrit": "वसोर्वाक्यमना दृत्य जगमुः सर्वे यथागतम् ।\nगतेषु मुनिसंघेषु देवा यज्ञं समाप्नुवन् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006164047, "chapter_id": 26164, "verse_number": "१-२-२५-४८", "content_sanskrit": "यज्ञप्रवर्त्तनं ह्येवमासीत्स्वायंभुवेऽन्तरे ।\nततः प्रभृति यज्ञोऽयं युगैः सह विवर्त्तितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]