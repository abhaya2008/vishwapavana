[{"id": 2114515, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114516, "chapter_id": 3463, "verse_number": "१", "content_sanskrit": "दुर्योधनोऽथ शकुनिः कर्णो दुश्शासनस्तथा ।\nकणिङ्कमुपसङ्क्रम्य मन्त्रिणं सौबलस्य च ।\nपप्रच्छ भरतश्रेष्ठ पाण्डवान् प्रति नैकधा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114517, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114518, "chapter_id": 3463, "verse_number": "३", "content_sanskrit": "प्रवृद्धाः पाण्डवा ह्येते नित्यं तेभ्यस्त्रसाम्यहम् ।\nतत्र मेऽपि सपक्षस्य यद् भवेत् क्षेमकारकम् ।\nभारद्वाज तदाचक्ष्व करिष्यामः कथं वयम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114519, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114520, "chapter_id": 3463, "verse_number": "४", "content_sanskrit": "सम्प्रपन्नाय तस्मै स परिमृश्यार्थचिन्तया ।\nउवाच वचनं तीक्ष्णं राजशास्त्रनिदर्शनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114521, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "कणिङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114522, "chapter_id": 3463, "verse_number": "५", "content_sanskrit": "नित्यमुद्यतदण्डः स्यान्नित्यं विवृतपौरुषः ।\nअच्छिद्रः छिद्रदर्शी स्यात् परेषां विवरानुगः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114523, "chapter_id": 3463, "verse_number": "६", "content_sanskrit": "नित्यमुद्यतदण्डाद्धि भृशमुद्विजते जनः ।\nतस्मात् सर्वाणि भूतानि दण्डेनैवानुपालयेत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114524, "chapter_id": 3463, "verse_number": "७", "content_sanskrit": "नास्य च्छिद्रं परः पश्येत् च्छिद्रेण परमन्वियात् ।\nगूहेत् कूर्म इवाङ्गानि रक्षेद् विवृतमात्मनः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114525, "chapter_id": 3463, "verse_number": "८", "content_sanskrit": "न शत्रुरक्षापतितो न मोक्तव्यः कथञ्चन ।\nकण्टको हि दुरुच्छिन्न आस्रावं जनयेच्चिरम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114526, "chapter_id": 3463, "verse_number": "९", "content_sanskrit": "वधमेव प्रशंसन्ति शत्रूणामपकारिणाम् ।\nनिरुद्विग्नो हि भवति हत्वा च रिपुमोजसा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114527, "chapter_id": 3463, "verse_number": "१०", "content_sanskrit": "हन्यादमित्रं दण्डेन हन्यात् पूर्वापकारिणम् ।\nहन्यात् त्रीन् पञ्च सप्तेति परपक्षस्य सर्वशः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114528, "chapter_id": 3463, "verse_number": "११", "content_sanskrit": "मूलमेवादितश्छिन्द्यात् परपक्षस्य नित्यशः ।\nततोऽन्यानन्तरान् पक्षान् छिन्द्यात् सर्वानशेषतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114529, "chapter_id": 3463, "verse_number": "१२", "content_sanskrit": "छिन्नमूले ह्यधिष्ठाने सर्वे तज्जीविनो हताः ।\nकथं नु शाखा जीवेयुश्छिन्नमूले वनस्पतौ\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114530, "chapter_id": 3463, "verse_number": "१३", "content_sanskrit": "सुविक्रान्तं सुविस्तीर्णं सुयुद्धमपलायिनम् ।\nआपदामथ कालेषु कार्या नात्र विचारणा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114531, "chapter_id": 3463, "verse_number": "१४", "content_sanskrit": "बकवच्चिन्तयेदर्थान् सिंहवच्च पराक्रमेत् ।\nवृकवच्चावलुन्वीत शरवच्च विनिष्पतेत् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114532, "chapter_id": 3463, "verse_number": "१५", "content_sanskrit": "निस्त्रिंशं हृदयं कृत्वा वाचमिक्षुरसोपमाम् ।\nगृह्णीयाद् द्विषतः पादौ हार्यमुन्नाय तच्छिरः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114533, "chapter_id": 3463, "verse_number": "१६", "content_sanskrit": "कथं नु परियास्यामो न ज्ञायामहे वयम् ।\nदातृत्वेन ग्रहीष्यामो भेदतो दण्डतोऽपिवा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114534, "chapter_id": 3463, "verse_number": "१७", "content_sanskrit": "अन्धः स्यादन्धवेलायां बाधिर्यमपि संश्रयेत् ।\nकुणात् तृणमयं चाशु शयीत मृतशायिकाम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114535, "chapter_id": 3463, "verse_number": "१८", "content_sanskrit": "एकाग्राच्चापि वसतो नित्यं विवरदर्शकः ।\nराजन् क्षत्रसपत्नात् तु नित्योद्विग्नः समाचरेत् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114536, "chapter_id": 3463, "verse_number": "१९", "content_sanskrit": "अग्न्याधानेन यज्ञेन काषायेण जटाजिनैः ।\nलोकं प्रस्तावयित्वैवं ततो लुम्पेद् यथा वृकः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114537, "chapter_id": 3463, "verse_number": "२०", "content_sanskrit": "अङ्कुशं शौचमित्याहुरर्थानामुपधारणे ।\nआनाम्य फलिनीं शाखां पक्वं पक्वं प्रशातयेत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114538, "chapter_id": 3463, "verse_number": "२१", "content_sanskrit": "वहेदमित्नं स्कन्धेन यावत् कालस्य पर्ययः ।\nततः सारमुपादाय भिन्द्याद् घटमिवाश्मनि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114539, "chapter_id": 3463, "verse_number": "२२", "content_sanskrit": "अमित्रस्तु न मोक्तव्यः कृपणं बह्वपि ब्रुवन् ।\nदुःखमस्मिन् न कर्तव्यं विध्यादेवापकारिणम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114540, "chapter_id": 3463, "verse_number": "२३", "content_sanskrit": "हन्यादमित्रं सान्त्वेन सामभेदनदण्डनैः ।\nतथा भेदेन दण्डेन भेदैर्दण्डैरथापि वा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2114541, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2114542, "chapter_id": 3463, "verse_number": "२४", "content_sanskrit": "कथं सान्त्वेन दानेन भेदैर्दण्डैरथापि च ।\nअमित्रः शक्यते हन्तुं तन्मे ब्रूहि यथातथम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2114543, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "कणिङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2114544, "chapter_id": 3463, "verse_number": "२५", "content_sanskrit": "शृणु राजन् यथा वृत्तं वने वसति जम्बुकः ।\nसखायस्तस्य व्याघ्रश्च वृको नकुलमूषिकौ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2114545, "chapter_id": 3463, "verse_number": "२६", "content_sanskrit": "ते पश्यन्ति वने तस्मिन् बलिनं मृगयूथपम् ।\nअशक्ता ग्रहणे तस्य ततो मन्त्रमकुर्वत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2114546, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "जम्बुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2114547, "chapter_id": 3463, "verse_number": "२७", "content_sanskrit": "असकृद् यतितो ह्येष हन्तुं व्याघ्र त्वयाऽनघ ।\nअसौ वै जवसम्पन्नो बुद्धिशाली न शक्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2114548, "chapter_id": 3463, "verse_number": "२८", "content_sanskrit": "मूषिकोऽस्य शयानस्य चरणौ भक्षयत्वयम् ।\nअथैनं भक्षिते पादे मृगं व्याघ्रो हनेत् तदा ।\nततस्तं भक्षयिष्यामः सर्वे मुदितमानसाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2114549, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "कणिङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2114550, "chapter_id": 3463, "verse_number": "२९", "content_sanskrit": "जम्बुकस्य तु ते वाक्यं तथा चक्रुः समाहिताः ।\nमूषिकाभक्षितैः पादैर्मृगं व्याघ्रोऽहनत् तदा \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2114551, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "जम्बुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2114552, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "स्नात्वाऽगच्छत भद्रं वो रक्षामि मृगयूथपम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2114553, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "कणिङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2114554, "chapter_id": 3463, "verse_number": "३०", "content_sanskrit": "शृगालवचनाच्चापि गताः सर्वे नदीं ततः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2114555, "chapter_id": 3463, "verse_number": "३१", "content_sanskrit": "सञ्चिन्तयन्तो मनसा मांसतृप्तिं पुनःपुनः ।\nअथागच्छत् पूर्वमेव स्नात्वा व्याघ्रो महाबलः ।\nजम्बुकश्चाभवत् तत्र तदा चिन्तापरो भृशम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2114556, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "व्याघ्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2114557, "chapter_id": 3463, "verse_number": "३२", "content_sanskrit": "किं शोचसि महाप्राज्ञ त्वं नो बुद्धिमतां वरः ।\nपिशितस्याशितारोऽद्य विहरिष्यामहे सुखम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2114558, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "जम्बुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2114559, "chapter_id": 3463, "verse_number": "३३", "content_sanskrit": "अवमत्य महाप्राज्ञ मूषिकस्त्वां वचोऽब्रवीत् ।\nधिग्बलं मृगराजस्य मयाऽद्यायं मृगो हतः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2114560, "chapter_id": 3463, "verse_number": "३४", "content_sanskrit": "मद्बाहुबलमाश्रित्य तृप्तिर्यस्य भविष्यति ।\nतस्यैवं गदतस्त्वद्य ततो भक्ष्यं न रोचये\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2114561, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "व्याघ्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2114562, "chapter_id": 3463, "verse_number": "३५", "content_sanskrit": "यद्येवमब्रवीत् सोऽस्मान् काले चास्म्यवबोधितः ।\nस्वबाहुबलमाश्रित्य हनिष्यामि वनेचरान् ।\nखादिष्यामि च मांसानीत्युक्त्वा स प्राद्रवद् वनम् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2114563, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "कणिङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2114564, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "एतस्मिन्नेव काले तु मूषिकोऽप्याजगाम ह ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2114565, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "जम्बुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2114566, "chapter_id": 3463, "verse_number": "३५", "content_sanskrit": "शृणु मूषिक भद्रं ते अब्रवीन्नकुलो यथा \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2114567, "chapter_id": 3463, "verse_number": "३६", "content_sanskrit": "मृगमांसं न खादेयं परमस्मद्विधस्य तत् ।\nमूषिकं भक्षयिष्यामि तद् भवाननुमन्यताम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2114568, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "कणिङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2114569, "chapter_id": 3463, "verse_number": "३७", "content_sanskrit": "तच्छ्रुत्वा मूषिको वाक्यं सन्त्रस्तः प्राद्रवद् भयात् ।\nततः स्नात्वा च तं देशमाजगाम वृको नृप\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2114570, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "जम्बुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2114571, "chapter_id": 3463, "verse_number": "३८", "content_sanskrit": "मृगराजो हि सङ्क्रुद्धो न नः साधु भविष्यति ।\nसकलत्रः समायाति कुरुष्व यदनन्तरम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2114572, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "कणिङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2114573, "chapter_id": 3463, "verse_number": "३९", "content_sanskrit": "एवं सञ्चोदितस्तेन जम्बुकेन तदा वृकः ।\nव्याघ्रोद्विग्नमना भूत्वा प्रयातः पिशिताशनः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2114574, "chapter_id": 3463, "verse_number": "४०", "content_sanskrit": "एतस्मिन्नेव काले तु नकुलोऽप्याजगाम ह ।\nतमुवाच महाराज नकुलं जम्बुको वने\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2114575, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "जम्बुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2114576, "chapter_id": 3463, "verse_number": "४१", "content_sanskrit": "स्वबाहुबलमाश्रित्य निर्जितास्ते मया गताः ।\nमम दत्वा नियुद्धं स्वं भुङ्क्ष्व मांसं यथेप्सितम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2114577, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "नकुलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2114578, "chapter_id": 3463, "verse_number": "४२", "content_sanskrit": "मृगराजो वृकश्चैव बुद्धिमांश्चैव मूषिकः ।\nनिर्जिताश्च त्वया वीर तस्माद् वीरतरो भवान् ।\nनाहमप्युत्सहे योद्धुमित्युक्त्वा गां विवेश ह\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2114579, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "कणिङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2114580, "chapter_id": 3463, "verse_number": "४३", "content_sanskrit": "एवं तेष्वपयातेषु जम्बुको हृष्टमानसः ।\nखादति स्म तदा मांसमित्येवं मन्त्रनिश्चयात्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2114581, "chapter_id": 3463, "verse_number": "४४", "content_sanskrit": "एवं ते कथितं राजन् शृणु चाप्यपरं नृप ।\nपुत्रः सखा वा भ्राता वा पिता वा यदि वा गुरुः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2114582, "chapter_id": 3463, "verse_number": "४५", "content_sanskrit": "अर्थे पर्यवतिष्ठेरन् कर्तव्या भूतिवर्धनाः ।\nशपथेनाप्यरिं हन्यान्न दोष इति भार्गवः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2114583, "chapter_id": 3463, "verse_number": "४६", "content_sanskrit": "विषेण मायया वाऽपि नोपेक्षेत कथञ्चन ।\nउभौ यदि शपेयातां श्रद्दधानस्तु वध्यते \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2114584, "chapter_id": 3463, "verse_number": "४७", "content_sanskrit": "गुरोरप्यवलिप्तस्य कार्याकार्यमजानतः ।\nउत्पथं प्रतिपन्नस्य दण्डो भवति शासनम् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2114585, "chapter_id": 3463, "verse_number": "४८", "content_sanskrit": "क्रुद्धोऽप्यक्रुद्धरूपः स्याच्छुक्लः पूर्वाभिभाषिता ।\nन चैनं क्रोधसन्दीप्तं विद्यात् कश्चित् कथञ्चन\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2114586, "chapter_id": 3463, "verse_number": "४९", "content_sanskrit": "प्रहरिष्यन् प्रियं ब्रूयात् प्रहरन्नपि भारत ।\nप्रहृत्य च प्रियं ब्रूयाच्छोचन्निव रुदन्निव\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2114587, "chapter_id": 3463, "verse_number": "५०", "content_sanskrit": "विश्वासयेच्चैव परं सामदानार्यवृत्तिभिः ।\nअथ तं प्रहरेत् काले यदा विचलितः पथि\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2114588, "chapter_id": 3463, "verse_number": "५१", "content_sanskrit": "अपि घोरापराधस्य धर्ममाश्रित्य तिष्ठतः ।\nस हि प्रच्छाद्यते दोषः शैलो मेघैरिवासितैः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2114589, "chapter_id": 3463, "verse_number": "५२", "content_sanskrit": "यस्य स्यात्तु वधः प्राप्तः तस्यागारावदाहने ।\nअधनान् भिक्षुकांश्चोरान् विषकर्मसु योजयेत्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2114590, "chapter_id": 3463, "verse_number": "५३", "content_sanskrit": "प्रत्युत्थानासनाद्येन सम्प्रदानेन केनचित् ।\nप्रतिप्रच्छन्नधाती स्यात् तीक्ष्णदंष्ट्र इवोरगः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2114591, "chapter_id": 3463, "verse_number": "५४", "content_sanskrit": "अशङ्कितेभ्यः शङ्केत शङ्कितेभ्यश्च सर्वदा ।\nअशङ्क्याद् भयमुत्पन्नमपि मूलान्निकृन्तति \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2114592, "chapter_id": 3463, "verse_number": "५५", "content_sanskrit": "न विश्वसेदविश्वस्ते विश्वस्ते नातिविश्वसेत् ।\nविश्वासाद् भयमाप्नोति तस्मात् सर्वं न विश्वसेत् \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2114593, "chapter_id": 3463, "verse_number": "५६", "content_sanskrit": "चाराः सुविहिताः कार्या आत्मनश्च चरस्य च ।\nपाषण्डान् ब्राह्मणादींश्च परराष्टेषु योजयेत्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2114594, "chapter_id": 3463, "verse_number": "५७", "content_sanskrit": "उद्यानेषु विहारेषु देवतायतनेषु च ।\nपानागारेषु वेशेषु चत्वरेषु सभासु च\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2114595, "chapter_id": 3463, "verse_number": "५८", "content_sanskrit": "ब्राह्मणायतने द्यूते पर्वतेषु वनेषु च ।\nसमवायेषु सर्वेषु सरित्सु च विचारयेत्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2114596, "chapter_id": 3463, "verse_number": "५९", "content_sanskrit": "वाचा भृशं विनीतः स्याद् हृदयेषु तथा क्षुरः ।\nमृदुपूर्वाभिभाषी स्यात् सृष्टो रौद्राय कर्मणे\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2114597, "chapter_id": 3463, "verse_number": "६०", "content_sanskrit": "अञ्जलिः शपथः सान्त्वं शिरसा पादवन्दनम् ।\nआशाकरणमित्येतत् कर्तव्यं भूतिमिच्छता\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2114598, "chapter_id": 3463, "verse_number": "६१", "content_sanskrit": "सुपुष्पितः स्यादफलो दुरारोहः फलान्वितः ।\nआमः स्यात् पक्वसङ्काशो न च जीर्येत कस्य चित् \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2114599, "chapter_id": 3463, "verse_number": "६२", "content_sanskrit": "त्रिवर्गे त्रिविधा पीडा अनुबन्धास्तथैव च ।\nअनुबन्धांस्तु सेवेत पीडास्तु परिवर्जयेत्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2114600, "chapter_id": 3463, "verse_number": "६३", "content_sanskrit": "धर्मोऽतिचरितः पीडां सह द्वाभ्यां प्रयच्छति ।\nअर्थश्चाप्यर्थलुब्धस्य कामश्चातिप्रसङ्गिनः \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2114601, "chapter_id": 3463, "verse_number": "६४", "content_sanskrit": "अगर्वितात्मा युक्तश्च सान्त्वयुक्तो न चेर्ष्यितः ।\nअवेक्षितार्थं शुद्धात्मा मन्त्रयेत द्विजैः सह\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2114602, "chapter_id": 3463, "verse_number": "६५", "content_sanskrit": "मृदुना केनचिद् राजन् कर्मणा दारुणेन वा ।\nउद्धरेद् दीनमात्मानं समर्थो धर्ममाचरेत् \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2114603, "chapter_id": 3463, "verse_number": "६६", "content_sanskrit": "न संशयमनारुह्य नरो भद्राणि पश्यति ।\nसंशयं तु समारुह्य गदी जीवति पश्यति\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2114604, "chapter_id": 3463, "verse_number": "६७", "content_sanskrit": "यस्य बुद्धिः परिभवेत् तमतीतेन सान्त्वयेत् ।\nअनागतेन दुर्बुद्धिं प्रत्युत्पन्नेन पण्डितम् \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2114605, "chapter_id": 3463, "verse_number": "६८", "content_sanskrit": "वैरिणा सन्धिमास्थाय शयीत कृतकृत्यवत् ।\nस वृक्षाग्रे यथा सुप्तः पतत्येव न बुध्यते \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2114606, "chapter_id": 3463, "verse_number": "६९", "content_sanskrit": "मन्त्रसंवरणे यत्नः सदा कार्योऽनसूयता ।\nआकारश्चात्मनो रक्ष्यः चारः प्राप्यश्च सर्वदा\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2114607, "chapter_id": 3463, "verse_number": "७०", "content_sanskrit": "नाच्छित्वा परमर्माणि नाकृत्वा कर्म दुष्करम् ।\nनाहत्वा मत्स्यघातीव प्राप्नोति परमां श्रियम् \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2114608, "chapter_id": 3463, "verse_number": "७१", "content_sanskrit": "कर्शितं व्याधितं श्रान्तमपनीतमनायकम् ।\nपरिविश्वस्तमल्पं च प्रहर्तव्यं रिपोर्बलम् \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2114609, "chapter_id": 3463, "verse_number": "७२", "content_sanskrit": "नानर्थकेऽर्थबन्धोऽस्ति कृतार्थे नास्ति सङ्गतम् ।\nतस्मात् सर्वाणि कार्याणि सावशेषाणि कारयेत्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2114610, "chapter_id": 3463, "verse_number": "७३", "content_sanskrit": "सङ्ग्रहे निग्रहे चैव यत्नः कार्योऽनसूयता ।\nविग्रहः कालयुक्तश्च कर्तव्यो भूतिमिच्छता\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2114611, "chapter_id": 3463, "verse_number": "७४", "content_sanskrit": "नास्य कृत्यानि पश्येयुर्मित्राणि रिपवस्तथा ।\nआरब्धान्येव पश्येयुः सुपर्यवसितानि च\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2114612, "chapter_id": 3463, "verse_number": "७५", "content_sanskrit": "भीतवत् संविधातव्यं यावद् भयमनागतम् ।\nआगतं तु भयं दृष्ट्वा प्रहर्तव्यमभीतवत् \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2114613, "chapter_id": 3463, "verse_number": "७६", "content_sanskrit": "दैवेनोपहतं शत्रुं प्रगृह्णाति च यो नृपः ।\nस मृत्युमुपगृह्णाति गर्भमश्वतरी यथा\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2114614, "chapter_id": 3463, "verse_number": "७७", "content_sanskrit": "अनागतं च बुध्येत यच्च कार्यमुपस्थितम् ।\nन तु बुद्धिक्षयात् किञ्चिदतिक्रान्तमवेक्ष्यते\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2114615, "chapter_id": 3463, "verse_number": "७८", "content_sanskrit": "उत्साहश्चापि यत्नेन कर्तव्यो भूतिमिच्छता ।\nविभज्य देशकालौ तु सेव्या धर्मादयस्त्रयः \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2114616, "chapter_id": 3463, "verse_number": "७९", "content_sanskrit": "निःश्रेयसाय ते ज्ञेया इह चामुत्र च स्थिताः ।\nबलवत् कुरुते रूपं बाल्याच्छत्रुरुपेक्षितः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2114617, "chapter_id": 3463, "verse_number": "८०", "content_sanskrit": "गहनेऽग्निरिवोत्सृष्टः क्षिप्रं सञ्जायते महान् ।\nअग्निस्तोकमिवात्मानं सन्धुक्षयति पण्डितः \t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2114618, "chapter_id": 3463, "verse_number": "८१", "content_sanskrit": "स वर्धमानो ग्रसते महान्तमपि सञ्चयम् ।\nआदावेव ददानीति प्रियं ब्रूयान्निरर्थकम् \t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2114619, "chapter_id": 3463, "verse_number": "८२", "content_sanskrit": "आशां कालवतीं कुर्यात् कालं विघ्नेन योजयेत् ।\nविघ्नं निमित्ततो ब्रूयान्निमित्तानि च हेतुतः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2114620, "chapter_id": 3463, "verse_number": "८३", "content_sanskrit": "क्षुरो भूत्वा दहन्नेव निशितः कालचारतः ।\nप्रच्छन्नो मूलवापी स्याद् द्विषतां चावकर्तनः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2114621, "chapter_id": 3463, "verse_number": "८४", "content_sanskrit": "पाण्डवांश्च तथा राजन् अन्यांश्चापि गुरून् प्रति ।\nवर्तमानो न मज्जेस्त्वं तथा कृत्यं समाचर\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2114622, "chapter_id": 3463, "verse_number": "८५", "content_sanskrit": "न हि कुर्यात् समुत्सन्नान् विनष्टा इति निश्चयम् ।\nतस्मात् त्वं पाण्डुपुत्रेभ्यो रक्षाऽऽत्मानं नराधिप \t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2114623, "chapter_id": 3463, "verse_number": "८६", "content_sanskrit": "भ्रातृव्या बलवन्तस्ते पाण्डुपुत्रा नराधिप ।\nब्रवीमि तस्माद् विस्पष्टं यत् कर्तव्यमरिन्दम\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2114624, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2114625, "chapter_id": 3463, "verse_number": "८७", "content_sanskrit": "एवमुक्त्वा सम्प्रतस्थे कणिङ्कः स्वगृहं ततः \t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2114626, "chapter_id": 3463, "verse_number": "१४३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि त्रयश्च- त्वारिंशत्यधिकशततमोऽध्यायः ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2114627, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "॥ इति सम्भवपर्वणि नवतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2114628, "chapter_id": 3463, "verse_number": "", "content_sanskrit": "॥ सम्भवपर्व समाप्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}]