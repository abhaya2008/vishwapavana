[{"id": 6000245000, "chapter_id": 10245, "verse_number": null, "content_sanskrit": "अथ एकोनपञ्चाशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000245001, "chapter_id": 10245, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.001.m4a", "display_order": 2}, {"id": 6000245002, "chapter_id": 10245, "verse_number": "१०-४९-१", "content_sanskrit": "अस्तिप्रास्तीति कंसस्य महिष्यौ भरतर्षभ।\nहते भर्तरि दुःखार्ते ईयतुः स्वपितुर्गृहान्॥ १०/४९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.002.m4a", "display_order": 3, "topics": [{"text": "कंसभार्याभ्यां स्वपितरं जरासन्धं प्रति कृष्णकृतस्वभर्तृवधकथनम्", "range": "१–२"}]}, {"id": 6000245003, "chapter_id": 10245, "verse_number": "१०-४९-२", "content_sanskrit": "पित्रे मगधराजाय जरासन्धाय दुःखिते।\nवेदयाञ्चक्रतुः सर्वमात्मवैरूप्यकारणम्॥ १०/४९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.003.m4a", "display_order": 4}, {"id": 6000245004, "chapter_id": 10245, "verse_number": "१०-४९-३", "content_sanskrit": "स तदप्रियमाकर्ण्य शोकामर्षयुतो नृपः।\nअयादवीं महीं कर्तुं चक्रे परममुद्यमम्॥ १०/४९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.004.m4a", "display_order": 5, "topics": [{"text": "क्रुद्धस्य जरासन्धस्य सर्वयादव-संहारार्थं विंशत्यक्षौहिण्या सह मथुरागमनम्", "range": "३–४"}]}, {"id": 6000245005, "chapter_id": 10245, "verse_number": "१०-४९-४", "content_sanskrit": "अक्षौहिणीभिर्विंशद्भिस्तिसृभिश्चापि संवृतः।\nयदुराजधानीं मधुरां न्यरुणत् सर्वतोदिशम्॥ १०/४९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.005.m4a", "display_order": 6}, {"id": 6000245006, "chapter_id": 10245, "verse_number": "१०-४९-५", "content_sanskrit": "निरीक्ष्य तद्बलं कृष्ण उद्वेलमिव सागरम्।\nस्वपुरं तेन संरुद्धं स्वकुलं च भयाकुलम्॥ १०/४९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.006.m4a", "display_order": 7, "topics": [{"text": "तद्दृष्ट्वा ‘इदानीमस्य वधो नोचितः अयं त्वागतः किमस्माभिः करणीयम्’ इति कृष्णस्य चिन्ता", "range": "४–१०"}]}, {"id": 6000245007, "chapter_id": 10245, "verse_number": "१०-४९-६", "content_sanskrit": "चिन्तयामास भगवान् हरिः कारणमानुषः।\nतद्देशकालानुगुणं स्वावतारप्रयोजनम्॥ १०/४९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.007.m4a", "display_order": 8}, {"id": 6000245008, "chapter_id": 10245, "verse_number": "१०-४९-७", "content_sanskrit": "हनिष्यामि बलं ह्येतद् भुवि भारं समाहितम्।\nमागधेन समानीतं वंश्यानां सर्वभूभृताम्॥ १०/४९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.008.m4a", "display_order": 9}, {"id": 6000245009, "chapter_id": 10245, "verse_number": "१०-४९-८", "content_sanskrit": "अक्षौहिणीभिः सङ्ख्यातं भटाश्वरथकुञ्जरैः।\nमागधोऽपि न हन्तव्यो भूयः कर्ता बलोद्यमम्॥ १०/४९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.009.m4a", "display_order": 10}, {"id": 6000245010, "chapter_id": 10245, "verse_number": "१०-४९-९", "content_sanskrit": "एतदर्थोऽवतारोऽयं भूभारहरणाय मे।\nसंरक्षणाय साधूनां कृतोऽन्येषां वधाय च॥ १०/४९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.010.m4a", "display_order": 11}, {"id": 6000245011, "chapter_id": 10245, "verse_number": "१०-४९-१०", "content_sanskrit": "अन्योऽपि धर्मरक्षायै देहः सम्भ्रियते मया।\nविरामायाप्यधर्मस्य काले प्रभवतः क्‍वचित्॥ १०/४९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.011.m4a", "display_order": 12}, {"id": 6000245012, "chapter_id": 10245, "verse_number": "१०-४९-११", "content_sanskrit": "एवं ध्यायति गोविन्दे मगधाधिपतिर्बली।\nमधुरां सवनोद्यानां रुरोध बहुसैनिकः॥ १०/४९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.012.m4a", "display_order": 13, "topics": [{"text": "एवं ध्यायति गोविन्दे जरासन्धपक्षीयैः मधुरायाः सर्वद्वार-निरोधः", "range": "११–२१"}]}, {"id": 6000245013, "chapter_id": 10245, "verse_number": "१०-४९-१२", "content_sanskrit": "कलिङ्गश्चेकितानश्च दन्तवक्रविडूरथौ।\nउल्मुखो वेणुदारी च साल्वश्चैद्यश्च दुर्मतिः॥ १०/४९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.013.m4a", "display_order": 14}, {"id": 6000245014, "chapter_id": 10245, "verse_number": "१०-४९-१३", "content_sanskrit": "पूर्वद्वारं समासाद्य रुरुधुर्मागधाज्ञया।\nविन्दानुविन्दावावन्त्यौ विराटो दरदस्तथा॥ १०/४९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.014.m4a", "display_order": 15}, {"id": 6000245015, "chapter_id": 10245, "verse_number": "१०-४९-१४", "content_sanskrit": "एकलव्यो बाह्लिकश्च तथा पञ्चजनेश्वरः।\nरुरुधुर्दक्षिणद्वारं पौण्ड्रकश्च महाबलः॥ १०/४९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.015.m4a", "display_order": 16}, {"id": 6000245016, "chapter_id": 10245, "verse_number": "१०-४९-१५", "content_sanskrit": "युधामन्युर्बृहत्क्षत्रः शल्यो भूरिश्रवास्तथा।\nउत्तमौजाश्च रुग्मी च द्रुमश्चैव सुदक्षिणः॥ १०/४९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.016.m4a", "display_order": 17}, {"id": 6000245017, "chapter_id": 10245, "verse_number": "१०-४९-१६", "content_sanskrit": "एते नियुक्ता राजानो जरासन्धेन भारत।\nपश्चिमद्वारमासाद्य रुरुधुर्मधुरां पुरीम्॥ १०/४९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.017.m4a", "display_order": 18}, {"id": 6000245018, "chapter_id": 10245, "verse_number": "१०-४९-१७", "content_sanskrit": "द्रुपदः शिशुपालश्च त्रिगर्तोऽथ जयद्रथः।\nशकुनिः सोमदत्तश्च कुलिन्दश्च महाबलः॥ १०/४९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.018.m4a", "display_order": 19}, {"id": 6000245019, "chapter_id": 10245, "verse_number": "१०-४९-१८", "content_sanskrit": "जरासन्धेन सहिताः सर्वे मदबलान्विताः।\nउत्तरद्वारमासाद्य रुरुधुर्भरतर्षभ॥ १०/४९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.019.m4a", "display_order": 20}, {"id": 6000245020, "chapter_id": 10245, "verse_number": "१०-४९-१९", "content_sanskrit": "ते निरुध्य चतुर्द्वाराण्युद्वेलाम्भोधिसन्निभाः।\nसिंहनादं प्रकुर्वन्तो दध्मुः शङ्खाननेकशः॥ १०/४९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.020.m4a", "display_order": 21}, {"id": 6000245021, "chapter_id": 10245, "verse_number": "१०-४९-२०", "content_sanskrit": "क्ष्वेलन्तो युद्धसन्नद्धा जघ्नुर्भेरीः सहस्रशः॥ १०/४९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.021.m4a", "display_order": 22}, {"id": 6000245022, "chapter_id": 10245, "verse_number": "१०-४९-२१", "content_sanskrit": "तद् वीरभूपालकदम्बजृम्भितं युगावसानार्णवघूर्णितोपमम्।\nनिशम्य कृष्णो न चचाल चेतसा सृगालघोषं मृगराडिवोद्धतः॥ १०/४९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.022.m4a", "display_order": 23}, {"id": 6000245023, "chapter_id": 10245, "verse_number": "१०-४९-२२", "content_sanskrit": "एतस्मिन्नेव काले तु गगनात् सूर्यवर्चसौ।\nरथावुपस्थितौ सद्यः ससूतौ सपरिच्छदौ॥ १०/४९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.023.m4a", "display_order": 24, "topics": [{"text": "तदानीमाकाशात् रथद्वयस्य स्वायुधानां चोपस्थानम्", "range": "२२"}]}, {"id": 6000245024, "chapter_id": 10245, "verse_number": "१०-४९-२३", "content_sanskrit": "आयुधानि च दिव्यानि पुराणानि यदृच्छया।\nचक्रं सुदर्शनं घोरं सहस्रारं मनोरमम्॥ १०/४९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.024.m4a", "display_order": 25, "topics": [{"text": "श्रीकृष्णरामयोः जरासन्धसैन्येन युद्धम्", "range": "२३–७०"}]}, {"id": 6000245025, "chapter_id": 10245, "verse_number": "१०-४९-२४", "content_sanskrit": "गदा कौमोदकी गुर्वी नाम्ना कौमोदकी शुभा।\nत्रिनतं कार्मुकश्रेष्ठं शार्ङ्गसञ्ज्ञं गुणान्वितम्॥ १०/४९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.025.m4a", "display_order": 26}, {"id": 6000245026, "chapter_id": 10245, "verse_number": "१०-४९-२५", "content_sanskrit": "तीक्ष्णधारः शितमुखः खड्गो नन्दकसञ्ज्ञितः।\nलघू शरचितौ रम्यौ तूणी चाक्षयसायकौ॥ १०/४९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.026.m4a", "display_order": 27}, {"id": 6000245027, "chapter_id": 10245, "verse_number": "१०-४९-२६", "content_sanskrit": "तुरगाः शैब्यसुग्रीवमेघपुष्पबलाहकाः।\nहलं च बलभद्रस्य मुसलं च दृढं गुरु॥ १०/४९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.027.m4a", "display_order": 28}, {"id": 6000245028, "chapter_id": 10245, "verse_number": "१०-४९-२७", "content_sanskrit": "इत्येतान्यायुधान्याजौ गगनादागतानि सः।\nदृष्ट्वा राजन् हृषीकेशः सङ्कर्षणमथाब्रवीत्॥ १०/४९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.028.m4a", "display_order": 29}, {"id": 6000245029, "chapter_id": 10245, "verse_number": "१०-४९-२८", "content_sanskrit": "पश्याऽर्य व्यसनं प्राप्तं यदूनां त्वावतां प्रभो।\nएष ते रथ आयातो दयितान्यायुधानि च॥ १०/४९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.029.m4a", "display_order": 30}, {"id": 6000245030, "chapter_id": 10245, "verse_number": "१०-४९-२९", "content_sanskrit": "यानमास्थाय जह्येतद् व्यसनात् स्वान् समुद्धर।\nएतदर्थं हि नौ जन्म साधूनामीश सत्कृतम्॥ १०/४९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.030.m4a", "display_order": 31}, {"id": 6000245031, "chapter_id": 10245, "verse_number": "१०-४९-३०", "content_sanskrit": "त्रयोविंशत्यनीकानां भूमेर्भारमपाकुरु।\nएवं सम्मन्त्र्य दाशार्हौ दंशितौ रथिनां वरौ॥ १०/४९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.031.m4a", "display_order": 32}, {"id": 6000245032, "chapter_id": 10245, "verse_number": "१०-४९-३१", "content_sanskrit": "दंशितैश्च यदुश्रेष्ठैर्बहुभिश्च समन्वितौ।\nनिर्जग्मतुः पुरवराद् बलेनाल्पीयसा नृप॥ १०/४९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.032.m4a", "display_order": 33}, {"id": 6000245033, "chapter_id": 10245, "verse_number": "१०-४९-३२", "content_sanskrit": "निर्गत्य सदनात् कृष्णो वृष्णीनाहूय सर्वशः।\nआज्ञापयामास तूर्णं चतुर्द्वारस्य पालने॥ १०/४९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.033.m4a", "display_order": 34}, {"id": 6000245034, "chapter_id": 10245, "verse_number": "१०-४९-३३", "content_sanskrit": "वसुदेवं च निशठं कृतवर्माणमुद्धवम्।\nकृष्णो निर्यातयामास पूर्वद्वारेण भारत॥ १०/४९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.034.m4a", "display_order": 35}, {"id": 6000245035, "chapter_id": 10245, "verse_number": "१०-४९-३४", "content_sanskrit": "उग्रसेनं सुदामानं पृथुं विपृथुमेव च।\nहरिर्निर्यातयामास द्वारेणानुत्तरेण वै॥ १०/४९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.035.m4a", "display_order": 36}, {"id": 6000245036, "chapter_id": 10245, "verse_number": "१०-४९-३५", "content_sanskrit": "सात्यकिं च गदं चैव प्रसेनं गान्दिनीसुतम्।\nहरिः प्रतीचीद्वारेण प्रेषयामास दुर्मदान्॥ १०/४९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.036.m4a", "display_order": 37}, {"id": 6000245037, "chapter_id": 10245, "verse_number": "१०-४९-३६", "content_sanskrit": "गोविन्दस्तु महातेजाः स्वयं दारुकसारथिः।\nआत्ताभीष्टप्रहरणः सङ्कर्षणसहायवान्॥ १०/४९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.037.m4a", "display_order": 38}, {"id": 6000245038, "chapter_id": 10245, "verse_number": "१०-४९-३७", "content_sanskrit": "उत्तरेण विनिर्गम्य द्वारेण जगदीश्वरः। शङ्खं दध्मौ महाप्राणं दैत्यदानवभीषणम्।\nआह दारुकमासीनं रथाग्रे माधवः स्मयन्॥ १०/४९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.038.m4a", "display_order": 39}, {"id": 6000245039, "chapter_id": 10245, "verse_number": "१०-४९-३८", "content_sanskrit": "रथं वाहय धर्मज्ञ यत्र तौ चैद्यमागधौ।\nतर्पयामि नृपान् सर्वान् सायकैर्युद्धदुर्मदान्॥ १०/४९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.039.m4a", "display_order": 40}, {"id": 6000245040, "chapter_id": 10245, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.040.m4a", "display_order": 41}, {"id": 6000245041, "chapter_id": 10245, "verse_number": "१०-४९-३९", "content_sanskrit": "इत्युक्तो दारुकस्तेन हयांस्तूर्णमचोदयत्।\nव्यनदत् सिंहनादं च गोविन्दः परवीरहा॥ १०/४९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.041.m4a", "display_order": 42}, {"id": 6000245042, "chapter_id": 10245, "verse_number": "१०-४९-४०", "content_sanskrit": "शङ्खमाध्माय रामोऽपि सिंहनादं व्यनीनदत्।\nततोऽभूत् परसैन्यानां हृदि चिन्ता सवेपथुः॥ १०/४९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.042.m4a", "display_order": 43}, {"id": 6000245043, "chapter_id": 10245, "verse_number": "१०-४९-४१", "content_sanskrit": "पूर्वद्वारि नृपैः सार्द्धं यदूनां कदनं महत्।\nआसीच्चतुर्भिरष्टानां तदद्भुतमिवाभवत्॥ १०/४९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.043.m4a", "display_order": 44}, {"id": 6000245044, "chapter_id": 10245, "verse_number": "१०-४९-४२", "content_sanskrit": "दक्षिणद्वार्यपि तथा गोविन्दाध्मातचेतसाम्।\nआसीद् यदूनां कदनं राजन्यकटकेन वै॥ १०/४९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.044.m4a", "display_order": 45}, {"id": 6000245045, "chapter_id": 10245, "verse_number": "१०-४९-४३", "content_sanskrit": "अपरद्वार्यपि तथा यदूनां दृढधन्विनाम्।\nआसीद् राजसमाजेन सङ्ग्रामो रोमहर्षणः॥ १०/४९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.045.m4a", "display_order": 46}, {"id": 6000245046, "chapter_id": 10245, "verse_number": "१०-४९-४४", "content_sanskrit": "ते हन्यमाना यदवो राजभिः शक्रविक्रमैः।\nन चेलुः सङ्गराद् राजन् लोकद्वयजिगीषवः॥ १०/४९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.046.m4a", "display_order": 47}, {"id": 6000245047, "chapter_id": 10245, "verse_number": "१०-४९-४५", "content_sanskrit": "तत्र यादवशार्दूलो विष्णुस्‍त्रैलोक्यवल्लभः।\nआससाद महाघोरौ यत्र तौ चैद्यमागधौ॥ १०/४९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.047.m4a", "display_order": 48}, {"id": 6000245048, "chapter_id": 10245, "verse_number": "१०-४९-४६", "content_sanskrit": "जरासुतस्तावभिवीक्ष्य माधवौ महाबलौघेन बलीयसाऽऽवृणोत्।\nससैन्ययानध्वजवाजिसारथी सूर्यानलौ वायुरिवाभ्ररेणुभिः॥ १०/४९/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.048.m4a", "display_order": 49}, {"id": 6000245049, "chapter_id": 10245, "verse_number": "१०-४९-४७", "content_sanskrit": "सुपर्णतालध्वजचिह्नितौ रथौ विलक्षयन्त्यो हरिरामयोर्मृधे।\nस्‍त्रियः पुराट्टालकहर्म्यगोपुरं समाश्रिताः सम्मुमुहुः शुचार्दिताः॥ १०/४९/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.049.m4a", "display_order": 50}, {"id": 6000245050, "chapter_id": 10245, "verse_number": "१०-४९-४८", "content_sanskrit": "हरिः परानीकपयोमुचां मुहुः शिलीमुखात्युल्बणवर्षपीडितम्।\nस्वसैन्यमालोक्य सुरासुरार्चितं व्यघूर्णयच्छार्ङ्गशरासनोत्तमम्॥ १०/४९/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.050.m4a", "display_order": 51}, {"id": 6000245051, "chapter_id": 10245, "verse_number": "१०-४९-४९", "content_sanskrit": "गृह्णन् निषङ्गादथ सन्दधच्छरान् विकृष्य मुञ्चञ्छितबाणसञ्चयम्।\nनिघ्नन् रथान् कुञ्जरवजियूथपान् निरन्तरं यद्वदलातचक्रम्॥ १०/४९/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.051.m4a", "display_order": 52}, {"id": 6000245052, "chapter_id": 10245, "verse_number": "१०-४९-५०", "content_sanskrit": "ततः शशाङ्काकृतिपाञ्चजन्यं महारवं दैत्यकुलापचारम्।\nमुखे निधायाशु पुपूर यादवानाश्वासयन् क्षत्रियकूटघट्टितान्॥ १०/४९/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.052.m4a", "display_order": 53}, {"id": 6000245053, "chapter_id": 10245, "verse_number": "१०-४९-५१", "content_sanskrit": "नृपास्तदाकर्ण्य तु कर्णनिष्ठुरं क्रमेण निर्भिण्णहृदो बभूविरे।\nयदुप्रवीराश्च समुद्यतायुधा रणे नृपान् जघ्नुरनीकसंयुताः॥ १०/४९/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.053.m4a", "display_order": 54}, {"id": 6000245054, "chapter_id": 10245, "verse_number": "१०-४९-५२", "content_sanskrit": "ततश्चतुर्द्वारगतान् महीपतीन् यदुप्रवीराः परिभूय सर्वशः।\nचक्रुः शरौघैः सहसैकवाहिन आप्यायिताः शार्ङ्गरवेण शौरिणा॥ १०/४९/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.054.m4a", "display_order": 55}, {"id": 6000245055, "chapter_id": 10245, "verse_number": "१०-४९-५३", "content_sanskrit": "ततो हरिं चैद्यपतिर्मण्डलीकृतकार्मुकः।\nभर्त्सयन् कृष्ण कृष्णेति तिष्ठ तिष्ठेति चाब्रवीत्॥ १०/४९/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.055.m4a", "display_order": 56}, {"id": 6000245056, "chapter_id": 10245, "verse_number": "१०-४९-५४", "content_sanskrit": "तमभ्यधावद् गोविन्दो विमुञ्चन् सायकान् बहून्।\nमण्डलीकृतकोदण्डस्तैलधौताञ्छितान् शरान्॥ १०/४९/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.056.m4a", "display_order": 57}, {"id": 6000245057, "chapter_id": 10245, "verse_number": "१०-४९-५५", "content_sanskrit": "ततः पञ्च शरान् घोरानादाय दमघोषजः।\nचतुर्भिस्तुरगानाशु विव्याधैकेन सारथिम्॥ १०/४९/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.057.m4a", "display_order": 58}, {"id": 6000245058, "chapter_id": 10245, "verse_number": "१०-४९-५६", "content_sanskrit": "भूयो दशाशु सन्धाय विव्याध मधुसूदनम्।\nव्यनदत् सिंहनादं च तदद्भुतमिवाभवत्॥ १०/४९/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.058.m4a", "display_order": 59}, {"id": 6000245059, "chapter_id": 10245, "verse_number": "१०-४९-५७", "content_sanskrit": "ततस्तमाह गोविन्दः साधु साध्विति पूजयन्।\nभो भो चैद्य महेष्वास वीरोऽसि बलवानसि॥ १०/४९/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.059.m4a", "display_order": 60}, {"id": 6000245060, "chapter_id": 10245, "verse_number": "१०-४९-५८", "content_sanskrit": "अतो मे पश्य दुर्बुद्धे धानुष्मत्त्वं स्वयं रणे।\nइति ब्रुवति गोविन्दे राजानः सर्व एव ते॥ १०/४९/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.060.m4a", "display_order": 61}, {"id": 6000245061, "chapter_id": 10245, "verse_number": "१०-४९-५९", "content_sanskrit": "विव्यधुर्निशितैर्बाणैर्यौगपद्येन माधवम्।\nतांस्तान् प्रत्येकशः कृष्णो विद्ध्वा पञ्चभिराशुगैः॥ १०/४९/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.061.m4a", "display_order": 62}, {"id": 6000245062, "chapter_id": 10245, "verse_number": "१०-४९-६०", "content_sanskrit": "सारथिं चतुरो वाहाननयत् यमसादनम्।\nत्रिभिस्‍त्रिभिः शरैर्भूयोऽप्येकैकं नृपतीन् रणे॥ १०/४९/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.062.m4a", "display_order": 63}, {"id": 6000245063, "chapter_id": 10245, "verse_number": "१०-४९-६१", "content_sanskrit": "वक्षस्यास्ये ललाटे च विव्याध यदुनन्दनः।\nततश्च त्रिंशतां राज्ञां त्रिंशत्कार्मुकमाहवे॥ १०/४९/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.063.m4a", "display_order": 64}, {"id": 6000245064, "chapter_id": 10245, "verse_number": "१०-४९-६२", "content_sanskrit": "त्रिंशद्भिः सायकैराशु चिच्छेद यदुपुङ्गवः।\nदमघोषसुतस्यापि धनुश्छित्त्वा त्रिभिः शरैः॥ १०/४९/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.064.m4a", "display_order": 65}, {"id": 6000245065, "chapter_id": 10245, "verse_number": "१०-४९-६३", "content_sanskrit": "ध्वजं च मुकुटच्छत्रे चकर्त प्रहसन्निव।\nततो दश हरिर्भल्लान् शार्ङ्गे सन्धाय माधवः॥ १०/४९/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.065.m4a", "display_order": 66}, {"id": 6000245066, "chapter_id": 10245, "verse_number": "१०-४९-६४", "content_sanskrit": "आकर्णान्तं समाकृष्य चैद्यं विव्याध सङ्गरे।\nतेन राजन्यकटकं विभ्रान्तं शरताडितम्॥ १०/४९/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.066.m4a", "display_order": 67}, {"id": 6000245067, "chapter_id": 10245, "verse_number": "१०-४९-६५", "content_sanskrit": "कालान्तमारुतोद्धूतशैलद्रुमलतोपमम्।\nत्रातारं नाध्यगच्छद् वै हताश्वरथसारथिः॥ १०/४९/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.067.m4a", "display_order": 68}, {"id": 6000245068, "chapter_id": 10245, "verse_number": "१०-४९-६६", "content_sanskrit": "शरान् विमुञ्चन् जलजं च पूरयन् विष्फूर्जयन् कार्मुकमुग्रपौरुषः।\nविलोलयन् मागधसैन्यमाहवे निरन्तरं यद्वदलातचक्रम्॥ १०/४९/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.068.m4a", "display_order": 69}, {"id": 6000245069, "chapter_id": 10245, "verse_number": "१०-४९-६७", "content_sanskrit": "निर्भिन्नकुम्भाः करिणो निपेतुरनीकशोऽश्वाः शररुग्णकन्धराः।\nरथा हताश्वध्वजसूतनायकाः पदातयश्छिन्नभुजोरुकन्धराः॥ १०/४९/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.069.m4a", "display_order": 70}, {"id": 6000245070, "chapter_id": 10245, "verse_number": "१०-४९-६८", "content_sanskrit": "सञ्छिद्यमानद्विपदेभवाजिनामङ्गप्रसूताः शतशोऽसृगापगाः।\nभुजाहयः पूरुषशीर्षकच्छपा हतद्विपद्वीपहयग्रहाकुलाः॥ १०/४९/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.070.m4a", "display_order": 71}, {"id": 6000245071, "chapter_id": 10245, "verse_number": "१०-४९-६९", "content_sanskrit": "करोरुमीना नरकेशशैवला धनुस्तरङ्गायुधगुल्मसङ्कुलाः।\nआस्फूर्जितावृत्तभयानका महामणिप्रवेकाभरणाश्मशर्कराः॥ १०/४९/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.071.m4a", "display_order": 72}, {"id": 6000245072, "chapter_id": 10245, "verse_number": "१०-४९-७०", "content_sanskrit": "प्रवर्तिता भीरुभयावहा मृधे मनस्विनां हर्षवहाः परस्परम्।\nविनिघ्नताऽरीन् मुसलेन दुर्मदान् सङ्कर्षणेनापरिमेयतेजसा॥ १०/४९/७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.072.m4a", "display_order": 73}, {"id": 6000245073, "chapter_id": 10245, "verse_number": "१०-४९-७१", "content_sanskrit": "बलं तदङ्गार्णवदुर्गभैरवं दुरन्तपारं मगधेन्द्रपालितम्।\nक्षयं प्रणीतं वसुदेवपुत्रयोर्विक्रीडितं तज्जगदीशयोः परम्॥ १०/४९/७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.073.m4a", "display_order": 74, "topics": [{"text": "बलरामे जरासन्धं जीवग्राहं गृहीत्वा पोथयितुमारब्धे ‘इदानीं तस्य वधो मास्तु’ इति कृष्णेन निवारणम्", "range": "७१–८०"}]}, {"id": 6000245074, "chapter_id": 10245, "verse_number": "१०-४९-७२", "content_sanskrit": "स्थित्युद्भवान्तं भुवनत्रयस्य यः समीहतेऽनन्तगुणः स्वलीलया।\nन तस्य चित्रं परपक्षनिग्रहस्तथापि मर्त्यानुविधस्य वर्ण्यते॥ १०/४९/७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.074.m4a", "display_order": 75}, {"id": 6000245075, "chapter_id": 10245, "verse_number": "१०-४९-७३", "content_sanskrit": "हतेषु सर्वसैन्येषु जरासन्धो महाबलः।\nविद्रुतेष्ववशिष्टेषु रथेनैकेन सीरिणम्॥ १०/४९/७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.075.m4a", "display_order": 76}, {"id": 6000245076, "chapter_id": 10245, "verse_number": "१०-४९-७४", "content_sanskrit": "तावुभौ गिरिसङ्काशौ मत्ताविव महागजौ।\nपरस्परमयुध्येतां सामर्षौ बलशालिनौ॥ १०/४९/७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.076.m4a", "display_order": 77}, {"id": 6000245077, "chapter_id": 10245, "verse_number": "१०-४९-७५", "content_sanskrit": "मागधस्तु गदां गुर्वीमादायामर्षविह्वलः।\nभ्रामयित्वा शतगुणं चिक्षेप बलवक्षसि॥ १०/४९/७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.077.m4a", "display_order": 78}, {"id": 6000245078, "chapter_id": 10245, "verse_number": "१०-४९-७६", "content_sanskrit": "तामापतन्तीं तरसा गदां शृृृङ्गोपमां गिरेः।\nव्यंसयित्वा हलधरो मुधा चक्रे स्मयन्निव॥ १०/४९/७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.078.m4a", "display_order": 79}, {"id": 6000245079, "chapter_id": 10245, "verse_number": "१०-४९-७७", "content_sanskrit": "व्यर्थीकृत्य गदां तस्य मुसलेन हलायुधः।\nपोथयित्वा रथे क्षुब्धो निहत्य रथसारथी॥ १०/४९/७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.079.m4a", "display_order": 80}, {"id": 6000245080, "chapter_id": 10245, "verse_number": "१०-४९-७८", "content_sanskrit": "जग्राह विरथं रामो जरासन्धं महाबलम्।\nहतानीकावशिष्टासुं सिंहः सिंहमिवौजसा॥ १०/४९/७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.080.m4a", "display_order": 81}, {"id": 6000245081, "chapter_id": 10245, "verse_number": "१०-४९-७९", "content_sanskrit": "बध्यमानं हतानीकं पाशैर्वारुणमानुषैः।\nवारयामास गोविन्दस्तेन कार्यचिकीर्षया॥ १०/४९/७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.081.m4a", "display_order": 82}, {"id": 6000245082, "chapter_id": 10245, "verse_number": "१०-४९-८०", "content_sanskrit": "स मुक्तो लोकनाथाभ्यां व्रीडितो वीरसम्मतः।\nवनं विविक्षुस्तपसे वारितः पथि राजभिः॥ १०/४९/८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.082.m4a", "display_order": 83}, {"id": 6000245083, "chapter_id": 10245, "verse_number": "१०-४९-८१", "content_sanskrit": "मुकुन्दोऽप्यक्षतबलो निस्तीर्णारिबलार्णवः।\nगृहीत्वा मागधेन्द्रस्य धनं स्‍त्रीकोशवाहनम्॥ १०/४९/८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.083.m4a", "display_order": 84, "topics": [{"text": "मगधेन्द्रस्य आयोधनगतं कोशवाहनादि वित्तं गृहीत्वा रामकृष्णाभ्यां यदुराजायोग्रसेनाय समर्पणम्", "range": "८१–८७"}]}, {"id": 6000245084, "chapter_id": 10245, "verse_number": "१०-४९-८२", "content_sanskrit": "विकीर्यमाणः कुसुमैस्‍त्रिदशैरनुमोदितः। माधुरैरभिसङ्गम्य विज्वरैर्मुदितात्मभिः।\nउपगीयमानविजयः सूतमागधबन्दिभिः॥ १०/४९/८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.084.m4a", "display_order": 85}, {"id": 6000245085, "chapter_id": 10245, "verse_number": "१०-४९-८३", "content_sanskrit": "शङ्खदुन्दुभयो नेदुर्भेरीतूर्याण्यनेकशः।\nवीणावेणुमृदङ्गानि पुरं प्रविशति प्रभौ॥ १०/४९/८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.085.m4a", "display_order": 86}, {"id": 6000245086, "chapter_id": 10245, "verse_number": "१०-४९-८४", "content_sanskrit": "सिक्तमार्गां हृष्टजनां पताकाभिरलङ्कृताम्।\nनिर्घुष्टां ब्रह्मघोषेण कौतुकाबद्धतोरणाम्॥ १०/४९/८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.086.m4a", "display_order": 87}, {"id": 6000245087, "chapter_id": 10245, "verse_number": "१०-४९-८५", "content_sanskrit": "निचीयमानो नारीभिर्माल्यदध्यक्षताङ्कुरैः।\nनिरीक्ष्यमाणः सस्नेहं प्रीत्युत्कलितलोचनैः॥ १०/४९/८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.087.m4a", "display_order": 88}, {"id": 6000245088, "chapter_id": 10245, "verse_number": "१०-४९-८६", "content_sanskrit": "आयोधनागतं वित्तमनन्तं वीरभूषणम्।\nयदुराजाय तत्सर्वमाहृतं प्रादिशत् प्रभुः॥ १०/४९/८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_049/BhP_10.049.088.m4a", "display_order": 89}, {"id": 6000245089, "chapter_id": 10245, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्ध एकोनपञ्चाशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]