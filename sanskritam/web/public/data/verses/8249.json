[{"id": 900001693, "chapter_id": 8249, "verse_number": "6.1", "content_sanskrit": "यो ह वै ज्येष्ठं च श्रेष्ठं च वेद ज्येष्ठश्च श्रेष्ठश्च ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001694, "chapter_id": 8249, "verse_number": "6.2", "content_sanskrit": "श्वेतकेतुर्ह वा आरुणेयः पञ्चालानां परिषदमाजगाम", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001695, "chapter_id": 8249, "verse_number": "6.3", "content_sanskrit": "स यः कामयेत महत्प्राप्नुयामित्युदगयन ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001696, "chapter_id": 8249, "verse_number": "6.4", "content_sanskrit": "एषां वै भूतानां पृथिवी रसः पृथिव्या आपोऽपामोषधयः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001697, "chapter_id": 8249, "verse_number": "6.5", "content_sanskrit": "अथ वंशः पौतिमाषीपुत्रः कात्यायनीपुत्रात्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]