[{"id": 7000845000, "chapter_id": 20845, "verse_number": "६-१८८-१", "content_sanskrit": "ईश्वर उवाच ।\nअतः परं प्रवक्ष्यामि भवानि भवमुक्तये ।\nगीताचतुर्दशाध्यायमवधारय सुस्मिते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000845001, "chapter_id": 20845, "verse_number": "६-१८८-२", "content_sanskrit": "मेदिन्यां यत्किलस्थूलमस्ति काश्मीरमंडलम् ।\nराजधानी सरस्वत्या आस्ते चैव मनोहरा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000845002, "chapter_id": 20845, "verse_number": "६-१८८-३", "content_sanskrit": "यामधिष्ठाय वाग्देवी ब्रह्मलोकं प्रयच्छति ।\nहंसमारुह्यमानापि सावित्रीप्रहतैरपि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000845003, "chapter_id": 20845, "verse_number": "६-१८८-४", "content_sanskrit": "सरस्वतीपदांभोज सेवामाश्रित्य कुंकुमैः ।\nयत्र गौरवयंत्याशा हंसपक्षपुटोद्भवैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000845004, "chapter_id": 20845, "verse_number": "६-१८८-५", "content_sanskrit": "निरंतरं तया चैव नृणां संस्कृतभाषिणाम् ।\nसुपर्वाणमयी भाषा निमेषेणोपलभ्यते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000845005, "chapter_id": 20845, "verse_number": "६-१८८-६", "content_sanskrit": "प्रातर्गृहांगणोद्भूतै र्यत्रकुंकुमपांसुलैः ।\nसर्वतोरुणितच्छाय शशांकरविमंडलम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000845006, "chapter_id": 20845, "verse_number": "६-१८८-७", "content_sanskrit": "तत्रासीत्तेजसां राशिः शौर्यवर्मा नरेश्वरः ।\nउद्यदुज्ज्वलबाणौघ खंडितारातिमंडलः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000845007, "chapter_id": 20845, "verse_number": "६-१८८-८", "content_sanskrit": "अभूच्च सिंहलद्वीपे राजा सिंहपराक्रमः ।\nनाम्ना विक्रमवेतालः कलानामपि शेवधिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000845008, "chapter_id": 20845, "verse_number": "६-१८८-९", "content_sanskrit": "उभौ परस्परं मैत्रीं वर्द्धयांचक्रतुः क्रमात् ।\nतत्तद्देशसमुत्पन्नैरपूर्वैः प्रचुरोत्करैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000845009, "chapter_id": 20845, "verse_number": "६-१८८-१०", "content_sanskrit": "एकदा प्रहितं प्रेम्णा प्रभूतं शौर्यवर्मणा ।\nराजा विक्रमवेतालो विलोक्य शुनकीद्वयम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000845010, "chapter_id": 20845, "verse_number": "६-१८८-११", "content_sanskrit": "मत्तमातंगतुरग मणिभूषणचामरम् ।\nप्रेषयामास मित्राय प्रभूतं शौर्यवर्मणे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000845011, "chapter_id": 20845, "verse_number": "६-१८८-१२", "content_sanskrit": "एकदा शिबिकारूढश्चारु चामरवीजितः ।\nसुवर्णशृंखलारूढं वाद्यडिंडिमडंबरम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000845012, "chapter_id": 20845, "verse_number": "६-१८८-१३", "content_sanskrit": "शुनीयुगलमादाय मृगया कौतुकोत्सुकः ।\nराजा जगाम बाह्यालीं समं राजकुमारकैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000845013, "chapter_id": 20845, "verse_number": "६-१८८-१४", "content_sanskrit": "पणबंधविधानेन समुपेतं शशामिषम् ।\nतत्र राजकुमाराणां महान्कोलाहलोऽभवत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000845014, "chapter_id": 20845, "verse_number": "६-१८८-१५", "content_sanskrit": "ततः समानवयसा केनचिद्राजसूनुना ।\nबहुमूल्यं पणं कृत्वा राजाचिक्रीडकौतुकी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000845015, "chapter_id": 20845, "verse_number": "६-१८८-१६", "content_sanskrit": "ततोवतार्य दोलाया विरुदावलिगर्विताम् ।\nधावतः शशकस्योच्चैः पृष्ठे मुंचन्नृपं शुनीम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000845016, "chapter_id": 20845, "verse_number": "६-१८८-१७", "content_sanskrit": "मुमोच राजपुत्रोऽपि प्रेमपात्रं महाभुजः ।\nविरराम शुनीमुच्चैः संकीर्त्य विरुदावलीम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000845017, "chapter_id": 20845, "verse_number": "६-१८८-१८", "content_sanskrit": "अलक्ष्यमाणवेगेऽस्मिन्शुनीयुगलकेभृशम् ।\nधावत्युत्थितमेवासीत्पश्यतां सर्वभूभृताम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000845018, "chapter_id": 20845, "verse_number": "६-१८८-१९", "content_sanskrit": "पपात गर्ते महति शशकोऽतिश्रमादसौ ।\nपतितोऽपि शुनी वश्यो नाभवच्छशशावकः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000845019, "chapter_id": 20845, "verse_number": "६-१८८-२०", "content_sanskrit": "ततः शनैः समुत्थाय धावन्नाक्रम्यरोषतः ।\nजगृहे राजशुन्याऽसौ शशकः फेनमुद्वमन् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000845020, "chapter_id": 20845, "verse_number": "६-१८८-२१", "content_sanskrit": "ततः कथंचिदुप्लुत्य गच्छन्विस्खलयञ्छशः ।\nराजपुत्रशुनक्यासौ गृहीतः कंधरातटे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000845021, "chapter_id": 20845, "verse_number": "६-१८८-२२", "content_sanskrit": "जितमस्माभिरत्यर्थमिति संजल्पतां नृणाम् ।\nकोलाहले शंकिताया शुन्या निर्गतवान्मुखात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000845022, "chapter_id": 20845, "verse_number": "६-१८८-२३", "content_sanskrit": "ततो दंष्ट्राव्रणश्रेणी क्षरद्रुधिरधारकः ।\nक्वापि र्ममरभूभागे निलीयस्थितवाञ्छशः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000845023, "chapter_id": 20845, "verse_number": "६-१८८-२४", "content_sanskrit": "जिघ्रंत्या राजशुन्याऽसौ भूभागं धनरोषया ।\nदृष्टमात्रः परित्रस्तो हस्तमात्रं ततोऽगमत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000845024, "chapter_id": 20845, "verse_number": "६-१८८-२५", "content_sanskrit": "यत्र कर्पूरकदली क्रोडव्याघ्रदरीतलः ।\nचोली कपोलफलकान्चुबन्वाति समीरणः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000845025, "chapter_id": 20845, "verse_number": "६-१८८-२६", "content_sanskrit": "उद्भिन्न केतकीकोशरजोमुकुलितेक्षणः ।\nविस्रब्धाहरणा यत्रच्छायां तां परितन्वतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000845026, "chapter_id": 20845, "verse_number": "६-१८८-२७", "content_sanskrit": "नारिकेलफलैर्यत्र स्वयं निपतितैरधः ।\nअपि चूतफलैस्तृप्ताः पक्वैः शाखामृगा अपि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000845027, "chapter_id": 20845, "verse_number": "६-१८८-२८", "content_sanskrit": "अपि केसरिणो यत्र खेलंति कलभैः समम् ।\nफणिनः केकिबर्हेषु निर्विशंकं विशंति च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000845028, "chapter_id": 20845, "verse_number": "६-१८८-२९", "content_sanskrit": "यत्राश्रमांतरे विप्रो वत्सनामा जितेंद्रियः ।\nशांतश्चतुर्दशाध्यायं जपन्नास्ते निरंतरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000845029, "chapter_id": 20845, "verse_number": "६-१८८-३०", "content_sanskrit": "तत्र तच्छिष्यपादाब्ज प्रक्षालनजलैः कृते ।\nकर्दमे न्यपतद्गत्वा जीवशेषो मुहुः श्वसन् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000845030, "chapter_id": 20845, "verse_number": "६-१८८-३१", "content_sanskrit": "ततः कर्दमसंस्पर्शमात्रनिस्तीर्ण संसृतिः ।\nदिव्यं विमानमारुह्य निर्ययौ शशको दिवम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000845031, "chapter_id": 20845, "verse_number": "६-१८८-३२", "content_sanskrit": "ततः शुन्यपि लिप्तांगीस्तोकैः कर्दमबिंदुभिः ।\nक्षुत्पिपासार्तिरहिता शुनीरूपं विहाय सा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000845032, "chapter_id": 20845, "verse_number": "६-१८८-३३", "content_sanskrit": "ततो दिव्यांगनारम्यं गंधर्वैरुपशोभितम् ।\nदिव्यं विमानमारुह्य शुन्यपि त्रिदिवं ययौ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000845033, "chapter_id": 20845, "verse_number": "६-१८८-३४", "content_sanskrit": "ततो जहास मेधावी शिष्यो नाम्ना स्वकंधरः ।\nविचार्य विस्मितः पूर्वजन्मवैरस्य कारणम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000845034, "chapter_id": 20845, "verse_number": "६-१८८-३५", "content_sanskrit": "राजापि पर्यपृच्छत्तं विस्मयस्मेरलोचनः ।\nप्रणम्य परया भक्त्या विनयैकपयोनिधिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000845035, "chapter_id": 20845, "verse_number": "६-१८८-३६", "content_sanskrit": "कथां कथय मे विप्र हीनयोनि निषेवितौ ।\nअज्ञौयौ जग्मतुः स्वर्गे शुनी शशकशावकौ ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000845036, "chapter_id": 20845, "verse_number": "६-१८८-३७", "content_sanskrit": "शिष्य उवाच ।\nवत्सनामा द्विजन्मास्ते वनेऽमुष्मिन्जितेंद्रियः ।\nचतुर्दशं तु ह्यध्यायं गीतानां सर्वदा जपन् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000845037, "chapter_id": 20845, "verse_number": "६-१८८-३८", "content_sanskrit": "शिष्योऽहं तस्य भूपाल ब्रह्मविद्याविशारदः ।\nचतुर्दश तु अध्यायं जपामि प्रत्यहं नृप ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000845038, "chapter_id": 20845, "verse_number": "६-१८८-३९", "content_sanskrit": "मदीयचरणांभोजप्रक्षालनजले लुठन् ।\nशशस्त्रिदिवमापन्नः शुनक्या सह भूपते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000845039, "chapter_id": 20845, "verse_number": "६-१८८-४०", "content_sanskrit": "राजोवाच ।\nहेतुना केन कथय हसितं च द्विजोत्तम ।\nअतः किमपि साकूतं मन्यमानेन सादरम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000845040, "chapter_id": 20845, "verse_number": "६-१८८-४१", "content_sanskrit": "शिष्य उवाच ।\nमहाराष्ट्रेति नगरं नाम्ना प्रत्युदकं महत् ।\nतत्रासीद्ब्राह्मणो नाम्ना केशवः कितवाग्रणीः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000845041, "chapter_id": 20845, "verse_number": "६-१८८-४२", "content_sanskrit": "विलोभनाभवत्तस्य जाया स्वैरविहारिणी ।\nतेन सा हन्यते क्रोधाद्वैरं संचिंत्य जन्मनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000845042, "chapter_id": 20845, "verse_number": "६-१८८-४३", "content_sanskrit": "ततः स्त्रीवधपापेन शशको जायते द्विजः ।\nकिल्बिषाच्छुनकी सापि जाता वंचनजन्मनः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000845043, "chapter_id": 20845, "verse_number": "६-१८८-४४", "content_sanskrit": "पूर्वेण जन्मनाभ्यस्तं वैरं विस्मरतो नहि ।\nआसेदिवद्भ्यां बहुधा योन्यंतरमपि क्वचित् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000845044, "chapter_id": 20845, "verse_number": "६-१८८-४५", "content_sanskrit": "इत्याकलय्य सकलं भूपालः श्रद्धयान्वितः ।\nगीतामभ्यस्य सकलामवाप परमां गतिम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]