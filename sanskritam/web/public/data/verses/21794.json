[{"id": 7001794000, "chapter_id": 21794, "verse_number": "२-५५-१", "content_sanskrit": "मोहिन्युवाच ।\nकस्मिन्कालें द्विजश्रेष्ठ गंतव्यं पुरुषोत्तमे ।\nविधिना केन कर्तव्या पंचतीर्थ्यपि मानद ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001794001, "chapter_id": 21794, "verse_number": "२-५५-२", "content_sanskrit": "एकैकस्य च तीर्थस्य स्नाने दाने च यत्फलम् ।\nदेवताप्रेक्षणे चैव ब्रूहि सर्वं पृथक् पृथक् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001794002, "chapter_id": 21794, "verse_number": "२-५५-३", "content_sanskrit": "वसुरुवाच ।\nनिराहारः कुरुक्षेत्रे पादेनैकेन यस्तपेत् ।\nजितेंद्रियो जितक्रोधः सप्तसंवत्सरायुतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001794003, "chapter_id": 21794, "verse_number": "२-५५-४", "content_sanskrit": "दृष्ट्वा सकृज्ज्येष्ठशुक्लद्वादश्यां पुरुषोत्तमम् ।\nकृतोपवासः प्राप्नोति ततोऽधिकतरं फलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001794004, "chapter_id": 21794, "verse_number": "२-५५-५", "content_sanskrit": "तस्माज्ज्येष्ठे तु सुभगे प्रयत्नेन सुसंयतैः ।\nस्वर्गलोकेप्सुभिर्मर्त्यैर्द्रष्टव्यः पुरुषोत्तमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001794005, "chapter_id": 21794, "verse_number": "२-५५-६", "content_sanskrit": "पंचतीर्थीं च विधिवत्कृत्वा ज्येष्ठे नरोत्तमः ।\nद्वादश्यां शुक्लपक्षस्य पश्येत्तं पुरुषोत्तमम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001794006, "chapter_id": 21794, "verse_number": "२-५५-७", "content_sanskrit": "ये पश्यंत्यव्ययं देवं द्वादश्यां पुरुषोत्तमम् ।\nते विष्णुलोकमासाद्य न च्यवंते कदाचन ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001794007, "chapter_id": 21794, "verse_number": "२-५५-८", "content_sanskrit": "तस्माज्ज्येष्ठे प्रयत्नेन गंतव्यं विधिनंदिनि ।\nकृत्वा सम्यक्पंचतीर्थीं द्रष्टव्यः पुरुषोत्तमः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001794008, "chapter_id": 21794, "verse_number": "२-५५-९", "content_sanskrit": "सुदूरस्थोऽपि प्रीतात्मा कीर्तयेत्पुरुषोत्तमम् ।\nअहन्यहनि शुद्धात्मा सोऽपि विष्णुपुरं व्रजेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001794009, "chapter_id": 21794, "verse_number": "२-५५-१०", "content_sanskrit": "यात्रां करोति कृष्णस्य श्रद्धया यः समाहितः ।\nसर्वपापविनिर्मुक्तो विष्णुलोकं व्रजेन्नरः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001794010, "chapter_id": 21794, "verse_number": "२-५५-११", "content_sanskrit": "चक्रं दृष्ट्वा हरेर्दूरात्प्रासादोपरि संस्थितम् ।\nसहसा मुच्यते पापान्नरो भक्त्या प्रणम्य तम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001794011, "chapter_id": 21794, "verse_number": "२-५५-१२", "content_sanskrit": "पंचतीर्थीविधिं वक्ष्ये श्रृणु मोहिनि सांप्रतम् ।\nयस्यां कृतायां मनुजो माधवस्य प्रियो भवेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001794012, "chapter_id": 21794, "verse_number": "२-५५-१३", "content_sanskrit": "मार्गंडेयह्रदं गत्वा स्नात्वा चोदङ्मुखः शुचिः ।\nनिमज्जेत्तत्र त्रीन्वारानिमं मंत्रमुदीरयेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001794013, "chapter_id": 21794, "verse_number": "२-५५-१४", "content_sanskrit": "\"संसारसागरे मग्नि पापग्रस्तमचेतनम् ।\nत्राहि मां भगनेत्रघ्न त्रिपुरारे नमोऽस्तु ते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001794014, "chapter_id": 21794, "verse_number": "२-५५-१५", "content_sanskrit": "नमः शिवाय शांताय सर्वपापहराय च ।\nस्नानं करोमि देवेश मम नश्यतु पातकम्\" ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001794015, "chapter_id": 21794, "verse_number": "२-५५-१६", "content_sanskrit": "नाभिमात्रे जले स्थित्वा विधिवद्देवता ऋषीन् ।\nतिलोदकेन मतिमान्पितॄनन्यांश्च तर्पयेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001794016, "chapter_id": 21794, "verse_number": "२-५५-१७", "content_sanskrit": "स्नात्वैवं च तथाचम्य ततो गच्छेच्छिवालयम् ।\nप्रविश्य देवतागारं कृत्वा तं त्रिः प्रदक्षिणम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001794017, "chapter_id": 21794, "verse_number": "२-५५-१८", "content_sanskrit": "मूलमंत्रेण संपूज्य मार्कंडेयेशमादरात् ।\nअघोरेण तु मंत्रेण प्रणिपत्य क्षमापयेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001794018, "chapter_id": 21794, "verse_number": "२-५५-१९", "content_sanskrit": "\"त्रिलोचन नमस्तेऽस्तु नमस्ते शशिभूषण ।\nत्राहि मां पुंडरीकाक्ष महादेव नमोऽस्तुते\" ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001794019, "chapter_id": 21794, "verse_number": "२-५५-२०", "content_sanskrit": "मार्कण्डेयह्रदे त्वेवं स्नात्वा दृष्ट्वा च शंकरम् ।\nदशानामश्वमेधानां फलं प्राप्नोति मानवः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001794020, "chapter_id": 21794, "verse_number": "२-५५-२१", "content_sanskrit": "पापैः सर्वैर्विनिर्मुक्तः शिवलोकं स गच्छति ।\nतत्र भुक्त्वा वरान्भोगान्यावदाभूतसंप्लवम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001794021, "chapter_id": 21794, "verse_number": "२-५५-२२", "content_sanskrit": "इह लोकं समासाद्य भवेद्विप्रो बहुश्रुतः ।\nशांकरंयोगमासाद्य ततो मोक्षमवाप्नुयात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001794022, "chapter_id": 21794, "verse_number": "२-५५-२३", "content_sanskrit": "कल्पवृक्षं ततो गत्वा कृत्वा तं त्रिः प्रदक्षिणम् ।\nपूजयेत्परया भक्त्या मंत्रेणानेन तं वटम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001794023, "chapter_id": 21794, "verse_number": "२-५५-२४", "content_sanskrit": "\"ॐ नमोऽव्यक्तरूपाय महते नतपालिने ।\nमहोदकोपविष्टाय न्यग्रोधाय नमोऽस्तु ते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001794024, "chapter_id": 21794, "verse_number": "२-५५-२५", "content_sanskrit": "अवसस्त्वं सदा कल्पे हरेश्चायतने वटे ।\nन्यग्रोध हर मे पापं कल्पवृक्ष नमोऽस्तु ते\" ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001794025, "chapter_id": 21794, "verse_number": "२-५५-२६", "content_sanskrit": "भक्त्या प्रदक्षिणं कृत्वा गत्वा कल्पवटं नरः ।\nसहसोज्झति पापौघं जीर्णां त्वचमिवोरगः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001794026, "chapter_id": 21794, "verse_number": "२-५५-२७", "content_sanskrit": "छायां तस्य समाक्रम्य कल्पवृक्षस्य मोहिनि ।\nब्रह्मह्त्यां नरो जह्यात्पापेष्वन्येषु का कथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001794027, "chapter_id": 21794, "verse_number": "२-५५-२८", "content_sanskrit": "दृष्ट्वा कृष्णांगसंभूते ब्रह्मतेजोमयं परम् ।\nन्यग्रोधाकृतिकं विष्णुं प्रणिपत्य च वैधसि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001794028, "chapter_id": 21794, "verse_number": "२-५५-२९", "content_sanskrit": "राजसूयाश्वमेधाभ्यां फल प्राप्नोति चाधिकम् ।\nतथा कुलं समुद्धृत्य विष्णुलोकं स गच्छति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001794029, "chapter_id": 21794, "verse_number": "२-५५-३०", "content_sanskrit": "वैनतेयं नमस्कृत्य कृष्णस्य पुरतः स्थितम् ।\nसर्वपापविनिर्मुक्तस्ततो विष्णुपुरं व्रजेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001794030, "chapter_id": 21794, "verse_number": "२-५५-३१", "content_sanskrit": "दृष्ट्वा वटं वैनतेयं यः पश्येत्पुरुषोत्तमम् ।\nसंकर्षणं सुभद्रां च स याति परमां गतिम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001794031, "chapter_id": 21794, "verse_number": "२-५५-३२", "content_sanskrit": "प्रविश्यायतनं विष्णोः कृत्वा तं त्रिः प्रदक्षिणम् ।\nसंकर्षणं सुभद्रां च भक्त्या पूज्य प्रसादयेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001794032, "chapter_id": 21794, "verse_number": "२-५५-३३", "content_sanskrit": "नमस्ते हलधृङ्नाम्ने नमस्ते मुसलायुध ।\nनमस्ते रेवतीकांत नमस्ते भक्तवत्सल ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001794033, "chapter_id": 21794, "verse_number": "२-५५-३४", "content_sanskrit": "नमस्ते बलिनां श्रेष्ठ नमस्ते धरणीधर ।\nप्रलंबारे नमस्तेऽस्तु त्रीहि मां कृष्णपूर्वज ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001794034, "chapter_id": 21794, "verse_number": "२-५५-३५", "content_sanskrit": "एवं प्रसाद्य चानंतमजेयं त्रिदशार्चितम् ।\nकैलासशिखराकारं चंद्रकांतवराननम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001794035, "chapter_id": 21794, "verse_number": "२-५५-३६", "content_sanskrit": "नीलवस्त्रधरं देवं फणाविकटमस्तकम् ।\nमहाबलं हलधरं कुंडलैकविभूषितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001794036, "chapter_id": 21794, "verse_number": "२-५५-३७", "content_sanskrit": "रौहिणेयं नरो भक्त्या लभेदभिमतं फलम् ।\nसर्वपापैर्विनिर्मुक्तो विष्णुलोकं च गच्छति ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001794037, "chapter_id": 21794, "verse_number": "२-५५-३८", "content_sanskrit": "आभूतसंप्लवं यावद्भुक्त्वा तत्र स्वयं बुधः ।\nपुण्यक्षयादिहागत्य प्रवरो योगिनां कुले ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001794038, "chapter_id": 21794, "verse_number": "२-५५-३९", "content_sanskrit": "ब्राह्मणप्रवरो भूत्वा सर्वशास्त्रार्थपारगः ।\nज्ञानं तत्र समासाद्य मुक्तिं प्राप्नोति दुर्लभाम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001794039, "chapter_id": 21794, "verse_number": "२-५५-४०", "content_sanskrit": "एवमभ्यर्च्य हलिनं ततः कृष्णं विचक्षणः ।\nद्वादशाक्षरमंत्रेण पूजयेत्सुसमाहितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001794040, "chapter_id": 21794, "verse_number": "२-५५-४१", "content_sanskrit": "द्विषट्कवर्णमंत्रेण भक्त्या ये पुरुषोत्तमम् ।\nपूजयंति सदा धीरास्ते मोक्षं प्राप्नुवन्ति वै ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001794041, "chapter_id": 21794, "verse_number": "२-५५-४२", "content_sanskrit": "न तां गतिं सुरा यांति योगिनो नैव सोमपाः ।\nयां गतिं यांति विधिजे द्वादशाक्षरतत्पराः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001794042, "chapter_id": 21794, "verse_number": "२-५५-४३", "content_sanskrit": "तस्मात्तेनैव मंत्रेण भक्त्या कृष्णं जगद्गुरुम् ।\nसंपूज्य गंधपुष्पाद्यैः प्रणिपत्य प्रसादयेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001794043, "chapter_id": 21794, "verse_number": "२-५५-४४", "content_sanskrit": "जय कृष्ण जगन्नाथ जय सर्वाघनाशन ।\nजय चाणूरकेशिघ्नजय कंसनिषूदन ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001794044, "chapter_id": 21794, "verse_number": "२-५५-४५", "content_sanskrit": "जय पद्मपलाशाक्ष जय चक्रगदाधर ।\nजय नीलांबुदश्याम जय सर्वसुखप्रद ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001794045, "chapter_id": 21794, "verse_number": "२-५५-४६", "content_sanskrit": "जय देव जगत्पूज्य जय संसारनाशन ।\nजय लोकपते नाथ जय वांछाफलप्रद ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001794046, "chapter_id": 21794, "verse_number": "२-५५-४७", "content_sanskrit": "संसारसागरे घोरे निःसारे दुःखफेनिले ।\nक्रोधग्राहाकुले रौद्रे विषयोदकसंप्लवे ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001794047, "chapter_id": 21794, "verse_number": "२-५५-४८", "content_sanskrit": "नानारोगोर्मिकलिले मोहावर्तसुदुस्तरे ।\nनिमग्नोऽहं सुरश्रेष्ठ त्राहि मां पुरुषोत्तम ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001794048, "chapter_id": 21794, "verse_number": "२-५५-४९", "content_sanskrit": "एवं प्रसाद्य देवेशं वरदं भक्तवत्सलम् ।\nसर्वपापहरं देवं सर्वकामफलप्रदम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001794049, "chapter_id": 21794, "verse_number": "२-५५-५०", "content_sanskrit": "पीनांसं द्विभुजं कृष्णं पद्मपत्रायतेक्षणम् ।\nमहोरस्कं महाबाहुं पीतवस्त्रं शुभाननम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001794050, "chapter_id": 21794, "verse_number": "२-५५-५१", "content_sanskrit": "शंखचक्रगदापाणिं मुकुटांगदभूषणम् ।\nसर्वलक्षणसंयुक्तं वनमालाविभूषितम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001794051, "chapter_id": 21794, "verse_number": "२-५५-५२", "content_sanskrit": "दृष्ट्वा नरोंऽजलिं कृत्वा दंडवत्प्रणिपत्‌य च ।\nअश्वमेधसहस्राणां फलं प्राप्नोति मोहिनि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001794052, "chapter_id": 21794, "verse_number": "२-५५-५३", "content_sanskrit": "यत्फलं सर्वतीर्थेषु स्नाने दाने प्रकीर्तितम् ।\nनरस्तत्फलमाप्नोति दृष्ट्वा कृष्णं प्रणम्य च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001794053, "chapter_id": 21794, "verse_number": "२-५५-५४", "content_sanskrit": "यत्फलं सर्ववेदेषु सर्वयज्ञेषु यत्फलम् ।\nतत्फलं समवाप्नोति नरः कृष्णं प्रणम्य च ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001794054, "chapter_id": 21794, "verse_number": "२-५५-५५", "content_sanskrit": "यत्फलं सर्वदानेषु व्रतेषु नियमेषु च ।\nनरस्तत्फलमाप्नोति दृष्ट्वा कृष्णं प्रणम्य च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001794055, "chapter_id": 21794, "verse_number": "२-५५-५६", "content_sanskrit": "यत्फलं ब्रह्मचर्येण सम्यक् चीर्णेन कीर्तितम् ।\nनरस्तत्फलमाप्नोति दृष्ट्वा कृष्णं प्रणम्य च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001794056, "chapter_id": 21794, "verse_number": "२-५५-५७", "content_sanskrit": "गार्हस्थ्येन यथोक्तेन यत्फलं समुदाहृतम् ।\nनरस्त्फलमाप्नोति दृष्ट्वा चीर्णेन कीर्तितम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001794057, "chapter_id": 21794, "verse_number": "२-५५-५८", "content_sanskrit": "यत्फलं वनवासेन वानप्रस्थस्य कीर्तितम् ।\nनरस्तत्फलमाप्नोति दृष्ट्वा चीर्णेन कीर्तितम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001794058, "chapter_id": 21794, "verse_number": "२-५५-५९", "content_sanskrit": "सन्यासेन यथोक्तेन यत्फलं समुदाहृतम् ।\nनरस्तत्फलमाप्नोति दृष्ट्वा चीर्णेन कीर्तितम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001794059, "chapter_id": 21794, "verse_number": "२-५५-६०", "content_sanskrit": "किं चात्र बहुनोक्तेन माहात्म्यं तस्य भामिनि ।\nदृष्ट्वा कृष्णं नरोभक्त्या मोक्षं प्राप्नोति दुर्लभम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001794060, "chapter_id": 21794, "verse_number": "२-५५-६१", "content_sanskrit": "पापैर्विमुक्तः शुद्धात्मा कल्पकोटिसमुद्भवैः ।\nश्रिया परमया युक्तः सर्वैः समुदितो गुणैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001794061, "chapter_id": 21794, "verse_number": "२-५५-६२", "content_sanskrit": "सर्वकामसमृद्धेन विमानेन सुवर्चसा ।\nत्रिःसप्तकुलमृद्धृत्य नरो विष्णुपुरं व्रजेत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001794062, "chapter_id": 21794, "verse_number": "२-५५-६३", "content_sanskrit": "ततः कल्पशतं यावद्बुक्त्वा भोगान्मनोरमान् ।\nगंधर्वाप्सरसैः सार्धं यथा विष्णुश्चतुर्भुजः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001794063, "chapter_id": 21794, "verse_number": "२-५५-६४", "content_sanskrit": "च्युतस्तस्मादिहायातो विप्राणां प्रवरे कुले ।\nसर्वज्ञः सर्ववेदी च जायते गतमत्सरः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001794064, "chapter_id": 21794, "verse_number": "२-५५-६५", "content_sanskrit": "स्वधर्मनिरतः शांतो दाता भूतहिते रतः ।\nआसाद्य वैष्णवं ज्ञानं ततो मुक्तिमवाप्नुयात् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001794065, "chapter_id": 21794, "verse_number": "२-५५-६६", "content_sanskrit": "ततः संपूज्य मंत्रेण सुभद्रां भक्तवत्सलाम् ।\nप्रसादयेच्च विधिजेप्रणिपत्य कृतांजलिः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001794066, "chapter_id": 21794, "verse_number": "२-५५-६७", "content_sanskrit": "\"नमस्ते सर्वगे देवि नमस्ते शुभसौख्यदे ।\nत्राहि मां पद्मपत्राक्षि कात्यायनि नमोऽस्तु ते\" ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001794067, "chapter_id": 21794, "verse_number": "२-५५-६८", "content_sanskrit": "एवं प्रसाद्य तां देवीं जगद्धात्रीं जगद्धिताम् ।\nबलदेवस्य भगिनीं सुभद्रां वरदां शिवाम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001794068, "chapter_id": 21794, "verse_number": "२-५५-६९", "content_sanskrit": "कामगेन विमानेन नरो विष्णुपुरं व्रजेत् ।\nआभूतसंप्लवं यावत्क्रीडित्वा तत्र देववत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001794069, "chapter_id": 21794, "verse_number": "२-५५-७०", "content_sanskrit": "इह मानुषतां प्राप्तो ब्राह्मणो वेदविद्भवेत् ।\nप्राप्य योगं हरेस्तत्र मोक्षं च लभते ध्रुवम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001794070, "chapter_id": 21794, "verse_number": "२-५५-७१", "content_sanskrit": "निष्क्रम्य देवतागारात्कृतकृत्यो भवेन्नरः ।\nप्रणम्यायतने पश्चाद्व्रजेत्तत्र समाहितः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001794071, "chapter_id": 21794, "verse_number": "२-५५-७२", "content_sanskrit": "इंद्रनीलमयो विष्णुर्यत्रास्ते वालुकावृतः ।\nअंतर्धानेऽपि तं नत्वा ततो विष्णुपुरं व्रजेत् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001794072, "chapter_id": 21794, "verse_number": "२-५५-७३", "content_sanskrit": "सर्वदेवमयो देवो हिरण्यकशिपूद्धरः ।\nयत्रास्ते नित्यदा देवि सिंहार्द्धकृतविग्रहः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001794073, "chapter_id": 21794, "verse_number": "२-५५-७४", "content_sanskrit": "भक्त्या दृष्ट्वा तु तं देवं प्रणम्य नृहरिं शुभे ।\nमुच्यते पातकैर्मर्त्यः समस्तैर्नात्र संशयः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001794074, "chapter_id": 21794, "verse_number": "२-५५-७५", "content_sanskrit": "नरसिंहस्य ये भक्त्या भवंति भुवि मानवाः ।\nन तेषां दुष्कृतं किंचित्फलं च स्याद्यदीप्सितम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001794075, "chapter_id": 21794, "verse_number": "२-५५-७६", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन नरसिंहं समाश्रयेत् ।\nधर्मार्थकाममोक्षाणां फलं यस्मात्प्रयच्छति ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001794076, "chapter_id": 21794, "verse_number": "२-५५-७७", "content_sanskrit": "तस्मात्तं ब्रह्मतनये भक्त्या संपूजयेत्सदा ।\nमृगराजं महावीर्यं सर्वकामफलप्रदम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001794077, "chapter_id": 21794, "verse_number": "२-५५-७८", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः स्त्रियः शूद्रांत्यजादयः ।\nसंपूज्य तु सुरश्रेष्ठं भक्ताः सिंहवपुर्द्धरम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001794078, "chapter_id": 21794, "verse_number": "२-५५-७९", "content_sanskrit": "मुच्यंते चाशुभाहुःखाज्जन्मकोटिसमुद्भवात् ।\nसंपूज्य तं सुरश्रेष्ठं प्राप्नुवंत्यभिवांछितम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001794079, "chapter_id": 21794, "verse_number": "२-५५-८०", "content_sanskrit": "देवत्वममरेशत्वं धनेशत्वं च भामिनि ।\nयक्षविद्याधरत्वं च तथान्यच्च प्रयच्छति ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001794080, "chapter_id": 21794, "verse_number": "२-५५-८१", "content_sanskrit": "श्रृणुष्व नरसिंहस्य प्रभावं विधिनंदिनि ।\nअजितस्याप्रमेयस्य भुक्तिमुक्तिप्रदस्य च ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001794081, "chapter_id": 21794, "verse_number": "२-५५-८२", "content_sanskrit": "कः शक्नोति गुणान्वक्तुं समस्तांस्तस्य सुव्रते ।\nसिंहार्द्धकृतदेहस्य प्रवक्ष्यामि समासतः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001794082, "chapter_id": 21794, "verse_number": "२-५५-८३", "content_sanskrit": "याः काश्चित्सिद्धयश्चात्र श्रूयंते दैवमानुषाः ।\nप्रसादात्तस्य ताः सर्वाः सिद्ध्यंते नात्र संशयः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001794083, "chapter_id": 21794, "verse_number": "२-५५-८४", "content_sanskrit": "स्वर्गे मर्त्ये च पाताले दिवितोये सुरे नगे ।\nप्रसादात्तस्य देवस्य भवत्यव्याहता गतिः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001794084, "chapter_id": 21794, "verse_number": "२-५५-८५", "content_sanskrit": "असाध्यं तस्य देवस्य नास्त्यत्र सचराचरे ।\nनरसिंहस्य सुभगे सदा भक्तानुकंपिन ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001794085, "chapter_id": 21794, "verse_number": "२-५५-८६", "content_sanskrit": "विधानं तस्य वक्ष्यामि भक्तानामुपकारकम् ।\nयेन प्रसीदते चासौ सिंहार्द्धकृतविग्रहः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001794086, "chapter_id": 21794, "verse_number": "२-५५-८७", "content_sanskrit": "यत्तत्वं तस्य देवस्य तदज्ञातं सुरासुरैः ।\nशाकयावकमूलैस्तु फलपिण्याकसक्तुभिः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001794087, "chapter_id": 21794, "verse_number": "२-५५-८८", "content_sanskrit": "पयोभक्ष्येण वा भद्रे वर्तते साधकेश्वरः ।\nकासकौपीनवासाश्च ध्यानयुक्तो जितेन्द्रियः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001794088, "chapter_id": 21794, "verse_number": "२-५५-८९", "content_sanskrit": "अरण्ये विजने देशे नदीसंगमपर्वते ।\nसिद्धक्षेत्रे चोषरे च नरसिंहाश्रमे तथा ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001794089, "chapter_id": 21794, "verse_number": "२-५५-९०", "content_sanskrit": "प्रतिष्ठाप्य स्वयं चापि पूजांकृत्वा विधानतः ।\nउपपातकवान्देवि महापातकवानपि ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001794090, "chapter_id": 21794, "verse_number": "२-५५-९१", "content_sanskrit": "मुक्तो भवेत्पातकेभ्यः साधको नात्र संशयः ।\nकृत्वा प्रदक्षिणं तत्र नरसिंहं प्रपूजयेत् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001794091, "chapter_id": 21794, "verse_number": "२-५५-९२", "content_sanskrit": "गंधपुष्पादिभिर्धूपैः प्रणम्य शिरसा प्रभुम् ।\nकर्पूरचंदनाक्तानि जातीपुष्पाणि मस्तके ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001794092, "chapter_id": 21794, "verse_number": "२-५५-९३", "content_sanskrit": "प्रदद्यान्नरसिंहस्य ततः सिद्धिः प्रजायते ।\nभगवान्सर्वकार्येषु न क्वचित्प्रतिदूयते ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001794093, "chapter_id": 21794, "verse_number": "२-५५-९४", "content_sanskrit": "न शक्तास्तं समाक्रांतुं ब्रह्मरुद्रादयः सुराः ।\nकिं पुनर्दानवा लोके सिद्धगंधर्वमानुषाः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001794094, "chapter_id": 21794, "verse_number": "२-५५-९५", "content_sanskrit": "विद्याधरां यक्षगणाः सकिन्नरमहोरगाः ।\nते सर्वे प्रलयं यांति दिव्या दिव्याग्नितेजसा ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001794095, "chapter_id": 21794, "verse_number": "२-५५-९६", "content_sanskrit": "सकृज्जप्त्वाग्निशिखया हन्यात्सर्वानुपद्रवान् ।\nत्रिर्जप्त्वा कवचं दिव्यं संरक्षेद्दैत्यदानवात् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001794096, "chapter_id": 21794, "verse_number": "२-५५-९७", "content_sanskrit": "भूतात्पिशाचाद्रक्षोभ्यो ये चान्ये परिपंथिनः ।\nत्रिर्जप्तं कवचं दिव्यमभेद्यं च सुरासुरैः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001794097, "chapter_id": 21794, "verse_number": "२-५५-९८", "content_sanskrit": "योजनद्वादशांतस्तु देवो रक्षति सर्वदा ।\nनरसिंहो महाभागे महाबलपराक्रमः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001794098, "chapter_id": 21794, "verse_number": "२-५५-९९", "content_sanskrit": "ततो गत्वा बिलद्वारमुपोष्य रजनत्रयम् ।\nपलाशकाष्ठैः प्रज्वाल्य भगवज्जातवेदसम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001794099, "chapter_id": 21794, "verse_number": "२-५५-१००", "content_sanskrit": "पालाशसमिधं तत्र जुहुयात्त्रिमधुप्लुताम् ।\nद्वेऽयुते कंजनयने शकटश्चैव साधकः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001794100, "chapter_id": 21794, "verse_number": "२-५५-१०१", "content_sanskrit": "ततः कवल्लीविवरं प्रकटं जायते क्षणात् ।\nततो विशेत्तु निःशंकः कवल्लीविवरं बुधः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001794101, "chapter_id": 21794, "verse_number": "२-५५-१०२", "content_sanskrit": "गच्छतः शकटस्याथ तमो मोहश्च नश्यति ।\nराजमार्गस्तु विस्तीर्णो दृश्यते तत्र मोहिनि ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001794102, "chapter_id": 21794, "verse_number": "२-५५-१०३", "content_sanskrit": "नरसिंहं स्मरंस्तत्र पातालं विशते तदा ।\nगत्वा तत्र जपेच्छुद्धो नरसिंहं तमव्ययम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7001794103, "chapter_id": 21794, "verse_number": "२-५५-१०४", "content_sanskrit": "ततः स्त्रीणां सहस्राणि वीणाचामरकर्मणाम् ।\nनिर्गच्छँति पुराच्चैव स्वागतं ता वदंति च ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7001794104, "chapter_id": 21794, "verse_number": "२-५५-१०५", "content_sanskrit": "प्रवेशयंति तं हस्ते गृहीत्वा साधकेश्वरम् ।\nततो रसायनं दिव्यं पाययंति सुलोचने ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7001794105, "chapter_id": 21794, "verse_number": "२-५५-१०६", "content_sanskrit": "पीतमात्रे दिव्यदेहो जायते सुमहाबलः ।\nक्रीडते दिव्यकन्याभिर्यावदाभूतसंप्लवम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7001794106, "chapter_id": 21794, "verse_number": "२-५५-१०७", "content_sanskrit": "भिन्नदेहो वासुदेवं नीयते नात्र संशयः ।\nयदा न रोचयन्त्येतास्ततो निर्गच्छते पुनः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7001794107, "chapter_id": 21794, "verse_number": "२-५५-१०८", "content_sanskrit": "पट्टं शूलं च खङ्गं च रोचनां च मणिं तथा ।\nरसं रसायनं चैव पादुकांजनमेव च ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7001794108, "chapter_id": 21794, "verse_number": "२-५५-१०९", "content_sanskrit": "कृष्णांजलिं च सुभगे गुटिकां च मनःशिलाम् ।\nमुंडलां चाक्षसूत्रं च षष्ठीं संजीवनीं तथा ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7001794109, "chapter_id": 21794, "verse_number": "२-५५-११०", "content_sanskrit": "सिद्धां विद्यां च शास्त्राणि गृहीत्वा साधकोत्तमः ।\nज्वलद्वह्निस्फुलिंगोर्मिवेष्टितं त्रिदशं हृदि ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7001794110, "chapter_id": 21794, "verse_number": "२-५५-१११", "content_sanskrit": "सकृन्न्यस्तं दहेत्सर्वं वृजिनं जन्मकोटिकम् ।\nविषेन्यस्तं विषं हन्यात्कुष्ठं हन्यात्तनौ स्थितम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7001794111, "chapter_id": 21794, "verse_number": "२-५५-११२", "content_sanskrit": "सुदेहभ्रूणहत्यादि कृत्वा दिव्येन शुध्यति ।\nमहाग्रहगृहीतेषु ज्वलमानं विचिंतयेत् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7001794112, "chapter_id": 21794, "verse_number": "२-५५-११३", "content_sanskrit": "रुदंतिं वै ततः शीघ्रं नश्येयुर्दारुणा ग्रहाः ।\nबालानां कंठके बद्ध्वा रक्षा भवति नित्यशः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7001794113, "chapter_id": 21794, "verse_number": "२-५५-११४", "content_sanskrit": "गंडपिंडककृत्यानां नाशनं कुरुते ध्रुवम् ।\nव्याधिघाते समिद्भिश्च घृतं क्षीरेण होभयेत् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7001794114, "chapter_id": 21794, "verse_number": "२-५५-११५", "content_sanskrit": "त्रिसंध्यं मासमेकं तु सर्वरोगान्विनाशयेत् ।\nअसाध्यं नास्य पश्यामि तत्वस्य सचराचरे ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7001794115, "chapter_id": 21794, "verse_number": "२-५५-११६", "content_sanskrit": "यां यां कामयते सिद्धिं तां तां प्राप्नोत्यपि ध्रुवम् ।\nअष्टोत्तरशतं त्वेकं पूजयित्वा मृगाधिपम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7001794116, "chapter_id": 21794, "verse_number": "२-५५-११७", "content_sanskrit": "मृत्तिकां सप्त वल्मीके श्मशाने च चतुष्पथे ।\nरक्तचंदनसंमिश्रां गवां क्षीरेण लेपयेत् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7001794117, "chapter_id": 21794, "verse_number": "२-५५-११८", "content_sanskrit": "सिंहस्य प्रतिमां कृत्वा प्रमाणेन षडंगुलाम् ।\nभूर्जपत्रे विशेषेण लिखेद्रोचनया तथा ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7001794118, "chapter_id": 21794, "verse_number": "२-५५-११९", "content_sanskrit": "नरसिंहस्य कंठे तु बद्ध्वा चैव समंत्रवत् ।\nजपेत्संख्याविहीनं तु पूजयित्वा जलाशये ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7001794119, "chapter_id": 21794, "verse_number": "२-५५-१२०", "content_sanskrit": "यावन्मंत्रं तु जपति सप्ताहं संयतेन्द्रियः ।\nजलाकीर्णा मुहूर्तेन जायते सर्वमेदिनी ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7001794120, "chapter_id": 21794, "verse_number": "२-५५-१२१", "content_sanskrit": "अथवा शुद्धवृक्षाग्रे नरसिंहं तु पूजयेत् ।\nजप्त्वा चाष्टशतं तत्त्वं वर्षं तद्विनिवारयेत् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7001794121, "chapter_id": 21794, "verse_number": "२-५५-१२२", "content_sanskrit": "तमेव पिंजके बद्ध्वा भ्रामयेत्साधकोत्तमः ।\nमहावातो मुहूर्तेन आगच्छेन्नात्र संशयः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7001794122, "chapter_id": 21794, "verse_number": "२-५५-१२३", "content_sanskrit": "पुनश्च वारयन्सिक्तां सप्तजप्तेन वारिणा ।\nअथ तां प्रतिमां द्वारे निखनेद्यस्य साधकः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7001794123, "chapter_id": 21794, "verse_number": "२-५५-१२४", "content_sanskrit": "गोत्रोत्सादो भवेत्तस्य उद्धृते चैव शांतिदः ।\nतस्माद्वै ब्रह्मतनये पूजयेद्भक्तितः सदा ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7001794124, "chapter_id": 21794, "verse_number": "२-५५-१२५", "content_sanskrit": "मृगराजं महावीर्यं सर्वकामफलप्रदम् ।\nदृष्ट्वा स्तुत्वा नमस्कृत्य संपूज्य नृहरिं शुभे ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7001794125, "chapter_id": 21794, "verse_number": "२-५५-१२६", "content_sanskrit": "प्राप्नुवंति नरा राज्यं स्वर्गं मोक्षं च दुर्लभम् ।\nनरसिंहं नरो दृष्ट्वा लभेदभिमतं फलम् ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7001794126, "chapter_id": 21794, "verse_number": "२-५५-१२७", "content_sanskrit": "विमुक्तः सर्वपापेभ्यो विष्णु लोकं च गच्छति ।\nसकृद्दृष्‌टवा तु तं देवं भक्त्या सिंहवपुर्द्धरम् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7001794127, "chapter_id": 21794, "verse_number": "२-५५-१२८", "content_sanskrit": "मुच्यते पातकैः सर्वैः कायवाक्चित्तसंभवैः ।\nसंग्रामे संकटे दुर्गे चौख्याघ्रादिपीडिते ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7001794128, "chapter_id": 21794, "verse_number": "२-५५-१२९", "content_sanskrit": "कांतारे प्राणसंदेहे विषवह्निजलेषु च ।\nराजादिभीषु संग्रामे ग्रहरोगादिपीडिते ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7001794129, "chapter_id": 21794, "verse_number": "२-५५-१३०", "content_sanskrit": "स्मृत्वा तं यो हि पुरुषः संकटैर्विप्रमुच्यते ।\nसूर्योदये यथा नाशं तमोऽभ्येति महत्तरम् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7001794130, "chapter_id": 21794, "verse_number": "२-५५-१३१", "content_sanskrit": "तथा संदर्शने तस्य विनाशं यांत्युपद्रवाः ।\nगुटिकां जनपाताले पादलेपरसायनम् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7001794131, "chapter_id": 21794, "verse_number": "२-५५-१३२", "content_sanskrit": "नरसिंहे प्रसन्ने तु प्राप्नोत्यन्यांश्च वांछितान् ।\nयान्यान्कामानभिध्यायन्भजेत नृहरिं नरः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7001794132, "chapter_id": 21794, "verse_number": "२-५५-१३३", "content_sanskrit": "तांस्तान्कामानवाप्नोति नरो नास्त्यत्र संशयः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}]