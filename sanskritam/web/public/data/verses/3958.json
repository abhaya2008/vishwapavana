[{"id": 2136501, "chapter_id": 3958, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136502, "chapter_id": 3958, "verse_number": "१", "content_sanskrit": "ततो निविशमानांस्तान् सैनिकान् रावणानुगाः ।\nअभिजग्मुर्गणानेके पिशाचक्षुद्ररक्षसाम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136503, "chapter_id": 3958, "verse_number": "२", "content_sanskrit": "पर्वतः(णः) पतनो जम्भः खरः क्रोधवशो हरिः ।\nप्ररुजश्चारुजश्चैव प्रघसश्चैवमादयः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136504, "chapter_id": 3958, "verse_number": "३", "content_sanskrit": "ततोऽभिपततां तेषामदृश्यानां दुरात्मनाम् ।\nअन्तर्धानवधं तज्ज्ञश्चकार स विभीषणः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136505, "chapter_id": 3958, "verse_number": "४", "content_sanskrit": "ते दृश्यमाना हरिभिर्बलिभिर्दूरपातिभिः ।\nनिहताः सर्वशो राजन् महीं जग्मुर्गतासवः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136506, "chapter_id": 3958, "verse_number": "६", "content_sanskrit": "अमृष्यमाणः सबलो रावणो निर्ययावथ ।\nव्यूह्य चौशनसं व्यूहं हरीनभ्यवहारयत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136507, "chapter_id": 3958, "verse_number": "", "content_sanskrit": "राक्षसानां बलैर्घोरैः पिशाचानां च संवृतः ।\nयुद्धशास्त्रविधानज्ञ उशना इव चापरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136508, "chapter_id": 3958, "verse_number": "७", "content_sanskrit": "राघवस्तु विनिर्यान्तं व्यूढानीकं दशाननम् ।\nबार्हस्पत्यं विधिं कृत्वा प्रत्यव्यूहन्निशाचरम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136509, "chapter_id": 3958, "verse_number": "८", "content_sanskrit": "समेत्य युयुधे तत्र ततो रामेण रावणः ।\nयुयुधे लक्ष्मणश्चापि तथैवेन्द्रजिता सह \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136510, "chapter_id": 3958, "verse_number": "९", "content_sanskrit": "विरूपाक्षेण सुग्रीवस्तारेण च निखर्वणः ।\nतुण्डेन च नलस्तत्र पटुशः पनसेन च \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136511, "chapter_id": 3958, "verse_number": "१०", "content_sanskrit": "विषह्यं यं हि यो मेने स स तेन समेयिवान् ।\nयुयुधे युद्धवेलायां स्वबाहुबलमाश्रितः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136512, "chapter_id": 3958, "verse_number": "११", "content_sanskrit": "स सम्प्रहारो ववृधे भीरूणां भयवर्धनः ।\nलोमसंहर्षणो घोरः पुरा देवासुरे यथा \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136513, "chapter_id": 3958, "verse_number": "१२", "content_sanskrit": "रावणो राममानर्छच्छक्तिशूलासिवृष्टिभिः ।\nनिशितैरायसैस्तीक्ष्णै रावणं चापि राघवः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136514, "chapter_id": 3958, "verse_number": "१३", "content_sanskrit": "तथैवेन्द्रजितं यत्तं लक्ष्मणो मर्मभेदिभिः ।\nइन्द्रजिच्चापि सौमित्रिं बिभेद बहुभिः शरैः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136515, "chapter_id": 3958, "verse_number": "१४", "content_sanskrit": "विभीषणः प्रहस्तं च प्रहस्तश्च विभीषणम् ।\nखगपत्रैः शरैस्तीक्ष्णैरभ्यवर्षद् गतव्यथः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136516, "chapter_id": 3958, "verse_number": "१५", "content_sanskrit": "तेषां बलवतामासीन्महास्त्राणां समागमः ।\nविव्यथुः सकला येन त्रयो लोकाश्चराचराः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136517, "chapter_id": 3958, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि चतुःसप्तत्यधिकद्विशततमोऽध्यायः ॥२७४॥\nरामोपाख्यानपर्वणि रामरावणयुद्धे चतुर्दशोऽध्यायः ॥१४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]