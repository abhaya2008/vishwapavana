[{"id": 2101341, "chapter_id": 3183, "verse_number": "१४-३९-१", "content_sanskrit": "ब्रह्मोवाच।\nअतः परं प्रवक्ष्यामि तृतीयं गुणमुत्तमम्।\nसर्वभूतहितं लोके सतां धर्ममनिन्दितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101342, "chapter_id": 3183, "verse_number": "१४-३९-२", "content_sanskrit": "आनन्दः प्रीतिरुद्रेकः प्राकाश्यं सुखमेव च।\nअकार्पण्यमसंरम्भः संतोषः श्रद्दधानता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101343, "chapter_id": 3183, "verse_number": "१४-३९-३", "content_sanskrit": "क्षमा धृतिरहिंसा च समता सत्यमार्जवम्।\nअक्रोधश्चानसूया च शौचं दाक्ष्यं पराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101344, "chapter_id": 3183, "verse_number": "१४-३९-४", "content_sanskrit": "मुधाज्ञानं मुधावृत्तं मुधासेवा मुदाश्रमः।\nएवं यो युक्तधर्मः स्यात्सोमुत्रात्यन्तमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101345, "chapter_id": 3183, "verse_number": "१४-३९-५", "content_sanskrit": "निर्ममो निरहङ्कारो निराशीः सर्वतः समः।\nअकामहत इत्येव सतां धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101346, "chapter_id": 3183, "verse_number": "१४-३९-६", "content_sanskrit": "विश्रंभो ह्रीस्तितिक्षा च त्यागः शौचमतन्द्रिता।\nआनृशंस्यमसंमोहो दया भूतेष्वपैशुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101347, "chapter_id": 3183, "verse_number": "१४-३९-७", "content_sanskrit": "हर्षस्तुष्टिर्विस्मयश्च विनयः साधुवृत्तिता।\nशान्तिकर्मविशुद्धिश्च भावशुद्धिर्विमोचनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101348, "chapter_id": 3183, "verse_number": "१४-३९-८", "content_sanskrit": "उपेक्षा ब्रह्मचर्यं च परित्यागश्च सर्वशः।\nनिर्ममत्वमनाशीष्ट्वमपरिक्षतधर्मता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101349, "chapter_id": 3183, "verse_number": "१४-३९-९", "content_sanskrit": "मुधादानं मुधायज्ञो मुधाधीतं मुधाव्रतम्।\nमुधाप्रतिग्रहश्चैव मधाध्रमो मुधातपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101350, "chapter_id": 3183, "verse_number": "१४-३९-१०", "content_sanskrit": "एवंवृत्तास्तु ये केचिल्लोकेऽस्मिन्सत्वसंश्रयाः।\nब्राह्मणा ब्रह्मयोनिस्थास्ते धीराः साधुदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101351, "chapter_id": 3183, "verse_number": "१४-३९-११", "content_sanskrit": "हित्वा सर्वाणि पापानि निःशोका ह्यजरामराः।\nदिव्यं प्राप्य तु ते धीराः कुर्वते वै ततस्तनूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101352, "chapter_id": 3183, "verse_number": "१४-३९-१२", "content_sanskrit": "ईशित्वं च वशित्वं च लघुत्वं चाणुता तथा।\nविकुर्वते महात्मानो देवास्त्रिदिवगा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101353, "chapter_id": 3183, "verse_number": "१४-३९-१३", "content_sanskrit": "ऊर्ध्वस्रोतस इत्येते देवा वैकारिकाः स्मृताः।\nविकुर्वन्तः प्रकृत्या वै दिवं प्राप्तास्ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101354, "chapter_id": 3183, "verse_number": "१४-३९-१४", "content_sanskrit": "यद्यदिच्छन्ति तत्सर्वं भजन्ते विभजन्ति च।\nइत्येतत्सात्विकं वृत्तं कथितं वो द्विजर्षभाः।\nएतद्विज्ञाय लभते विधिवद्यद्यदिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101355, "chapter_id": 3183, "verse_number": "१४-३९-१५", "content_sanskrit": "प्रकीर्तिताः सत्त्वगुणा विशेषतो\nयथावदुक्तं गुणवृत्तमेव च।\nनरस्तु यो वेद गुणानिमान्सदा\nगुणान्स भुङ्क्ते न गुणैः स युज्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101356, "chapter_id": 3183, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि एकोनचत्वारिंशोऽध्यायः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]