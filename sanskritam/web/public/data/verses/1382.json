[{"id": 2018360, "chapter_id": 1382, "verse_number": "३-२०-०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018361, "chapter_id": 1382, "verse_number": "३-२०-१", "content_sanskrit": "आनर्तनगरं मुक्तं ततोऽहमगमं तदा।\nमहाक्रतौ राजसूये निवृत्ते नृपते तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018362, "chapter_id": 1382, "verse_number": "३-२०-२", "content_sanskrit": "अपश्यं द्वारकां चाहं महाराज हतत्विषम्।\nनिःस्वाध्यायवषट्कारां निर्भूषणवरस्त्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018363, "chapter_id": 1382, "verse_number": "३-२०-३", "content_sanskrit": "अनभिज्ञेयरूपाणि द्वारकोपवनानि च।\nदृष्ट्वा शङ्कोपपन्नोऽहमपृच्छं हृदिकात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018364, "chapter_id": 1382, "verse_number": "३-२०-४", "content_sanskrit": "अस्वस्थनरनारीकमिदं वृष्णिकुलं भृशम्।\nकिमिदं नरशार्दूल श्रोतुमिच्छामि तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018365, "chapter_id": 1382, "verse_number": "३-२०-५", "content_sanskrit": "एवमुक्तः स तु मया विस्तरेणेदमब्रवीत्।\nरोधं मोक्षं च साल्वेन हार्दिक्यो राजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018366, "chapter_id": 1382, "verse_number": "३-२०-६", "content_sanskrit": "ततोऽहं भरतश्रेष्ठ श्रुत्वा सर्वमशेषतः।\nविनाशे साल्वराजस्य तदैवाकरवं मतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018367, "chapter_id": 1382, "verse_number": "३-२०-७", "content_sanskrit": "ततोऽहं भरतश्रेष्ठ समाश्वास्य पुरे जनम् ॥\nराजानमाहुकं चैव तथैवाकनदुन्दुभिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018368, "chapter_id": 1382, "verse_number": "३-२०-८", "content_sanskrit": "सर्वान्वृष्णिप्रवीरांश्च हर्षयन्नब्रुवं तदा।\nअप्रमादः सदा कार्यो नगरे यादवर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018369, "chapter_id": 1382, "verse_number": "३-२०-९", "content_sanskrit": "साल्वराजविनाशाय प्रयातं मां निबोधत।\nनाहत्वा तं निवर्तिष्ये पुरीं द्वारवतीं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018370, "chapter_id": 1382, "verse_number": "३-२०-१०", "content_sanskrit": "ससाल्वं सौभनगरं हत्वा द्रष्टास्मि वः पुनः।\nत्रिःसामा हन्यतामेषा दुन्दुभिः शत्रुभीषणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018371, "chapter_id": 1382, "verse_number": "३-२०-११", "content_sanskrit": "ते मयाऽऽश्वासिता वीरा यथावद्भरतर्षभ।\nसर्वे मामब्रुवन्हृष्टाः प्रयाहि जहिशात्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018372, "chapter_id": 1382, "verse_number": "३-२०-१२", "content_sanskrit": "तैः प्रहृष्टात्मभिर्वीरैराशीर्भिरभिनन्दितः।\nवाचयित्वा द्विजश्रेष्ठान्प्रणम्य शिरसा भवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018373, "chapter_id": 1382, "verse_number": "३-२०-१३", "content_sanskrit": "शैब्यसुग्रीवयुक्तेन रथेनानादयन्दिशः।\nप्रध्माय शङ्खप्रवरं पाञ्चजन्यमहं नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018374, "chapter_id": 1382, "verse_number": "३-२०-१४", "content_sanskrit": "प्रयातोस्मि नरव्याघ्र बलेन महता वृतः।\nक्लृप्तेन चतुरङ्गेण यत्तेन जितकाशिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018375, "chapter_id": 1382, "verse_number": "३-२०-१५", "content_sanskrit": "समतीत्य बहून्देशान्गिरींश्च बहुपादपान्।\nसरांसि सरितश्चैव मार्तिकावतमासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018376, "chapter_id": 1382, "verse_number": "३-२०-१६", "content_sanskrit": "तत्राश्रौषं नरव्याघ्र साल्वं सागरमन्तिकात्।\nप्रयान्तं सौभमास्थाय तमहं पृष्ठतोऽन्वगाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018377, "chapter_id": 1382, "verse_number": "३-२०-१७", "content_sanskrit": "`दृष्टवानस्मि राजेन्द्र साल्वराजमथान्तिके।\nततः सागरमासाद्य कुक्षौ तस्य महोर्मिणः।\nसमुद्रनाभ्यां साल्वोऽभूत्सौभमास्थाय शत्रुहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018378, "chapter_id": 1382, "verse_number": "३-२०-१८", "content_sanskrit": "`स मामालोक्य सहसा सेनां स्वां प्राहिणोन्मृधे।\nमद्बाहुना च सेनायां शिष्टायां किंचिदेव च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018379, "chapter_id": 1382, "verse_number": "३-२०-१९", "content_sanskrit": "स समालोक्य सहसा स्मयन्निव युधिष्ठिर।\nआह्वयामास दुष्टात्मा युद्धायैव मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018380, "chapter_id": 1382, "verse_number": "३-२०-२०", "content_sanskrit": "तस्य शार्ङ्गविनिर्मुक्तैर्बहुभिर्मर्मभेदिभिः।\nपुरं नासाद्यत शरैस्ततो मां रोष आविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018381, "chapter_id": 1382, "verse_number": "३-२०-२१", "content_sanskrit": "स चापि पापप्रकृतिर्दैतेयापशदो नृप।\nमय्यवर्षत दुर्धर्षः शरधाराः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018382, "chapter_id": 1382, "verse_number": "३-२०-२२", "content_sanskrit": "सैनिकान्मम सूतं च हयांश्च स समाकिरत्।\nअचिन्तयन्तस्तु शरान्वयं युध्याम भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018383, "chapter_id": 1382, "verse_number": "३-२०-२३", "content_sanskrit": "ततः शतसहस्राणि शराणां नतपर्वणाम्।\nचिक्षिपुः समरे वीरा मयि साल्वपदानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018384, "chapter_id": 1382, "verse_number": "३-२०-२४", "content_sanskrit": "ते हयांश्च रथं चैव ध्वजं दारुकमेव च।\nछादयामासुरसुरास्तैर्बाणैर्मर्मभेदिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2018385, "chapter_id": 1382, "verse_number": "३-२०-२५", "content_sanskrit": "न हया न रथो वीर न ध्वजो न च दारुकः।\nअदृश्यन्त शरैश्छन्नास्तथाऽहं सैनिकाश्च मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2018386, "chapter_id": 1382, "verse_number": "३-२०-२६", "content_sanskrit": "ततोऽहमपि कौन्तेय शराणामयुतान्बहून्।\nआमन्त्रितानां धनुषा दिव्येन विधिनाऽक्षिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2018387, "chapter_id": 1382, "verse_number": "३-२०-२७", "content_sanskrit": "न तत्रविषयस्त्वासीन्मम सैन्यस्य भारत।\nखे विषक्तं हि तत्सौभं क्रोशमात्र इवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2018388, "chapter_id": 1382, "verse_number": "३-२०-२८", "content_sanskrit": "ततस्ते प्रेक्षकाः सर्वे देवा वै दिवमास्थिताः।\nहर्षयामासुरुच्चैर्मां सिंहनादतलस्वनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2018389, "chapter_id": 1382, "verse_number": "३-२०-२९", "content_sanskrit": "मत्कार्मुकविनिर्मुक्ता दानवानां महारणे।\nअङ्गेषु रुधिराक्तास्ते विविशुः शलभा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2018390, "chapter_id": 1382, "verse_number": "३-२०-३०", "content_sanskrit": "ततो हलहलाशब्दः सौभमध्ये व्यवर्धत।\nवध्यतां विशिखैस्तीक्ष्णैः पततां च महार्णवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2018391, "chapter_id": 1382, "verse_number": "३-२०-३१", "content_sanskrit": "ते निकृत्तभुजस्कन्धाः कबन्धाकृतिदर्शनाः।\nनदन्तो भैरवान्नादान्निपतन्ति स्म दानवाः।\nपतितास्तेऽपि भक्ष्यन्ते समुद्रांभोनिवासिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2018392, "chapter_id": 1382, "verse_number": "३-२०-३२", "content_sanskrit": "ततो गोक्षीरकुन्देन्दुमृणालरजतप्रभम्।\nजलजं पाञ्चजन्यं वै प्राणेनाहमपूरयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2018393, "chapter_id": 1382, "verse_number": "३-२०-३३", "content_sanskrit": "तान्दृष्ट्वा पतितांस्तत्र साल्वः सौभपतिस्ततः।\nमायायुद्धेन महता योधयामास मां युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2018394, "chapter_id": 1382, "verse_number": "३-२०-३४", "content_sanskrit": "ततो गदा हलाः प्रासाः शूलशक्तिपरश्चथाः।\nअसयः शक्तिकुलिशपाशर्ष्टिकनपाः शराः।\nपट्टसाश्च भुशुण्ड्यश्च प्रपतन्त्यनिशं मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2018395, "chapter_id": 1382, "verse_number": "३-२०-३५", "content_sanskrit": "तामहं माययैवाशु प्रतिगृह्य व्यनाशयम्।\nतस्यां हतायां मायायां गिरिशृङ्गैरयोधयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2018396, "chapter_id": 1382, "verse_number": "३-२०-३६", "content_sanskrit": "ततोऽभवत्तम इव प्रकाश इव चाभवत्।\nदुर्दिनं सुदिनं चैव शीतमुष्णं च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2018397, "chapter_id": 1382, "verse_number": "३-२०-३७", "content_sanskrit": "अङ्गारपांसुवर्षं च शस्त्रवर्षं च भारत।\nएवं मायां प्रकुर्वाणो योधयामास मां रिपुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2018398, "chapter_id": 1382, "verse_number": "३-२०-३८", "content_sanskrit": "विज्ञाय तदहं सर्वं माययैव व्यनाशयम्।\nयथाकालं तु युद्धेन व्यधमं सर्वतः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2018399, "chapter_id": 1382, "verse_number": "३-२०-३९", "content_sanskrit": "`ततो हतायां च मया मायायां युधि दानवः।\nमायामन्यां महाराज चकार मतिमोहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2018400, "chapter_id": 1382, "verse_number": "३-२०-४०", "content_sanskrit": "ततो व्योम महाराज शतसूर्यमिवाभवत्।\nशतचन्द्रं च कौन्तेय सहस्रायुततारकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2018401, "chapter_id": 1382, "verse_number": "३-२०-४१", "content_sanskrit": "ततो नाज्ञायत तदा दिवारात्रं तथा दिशः।\nततोऽहं मोहमापन्नः प्रज्ञास्त्रं समयोजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2018402, "chapter_id": 1382, "verse_number": "३-२०-४२", "content_sanskrit": "तदस्त्रमस्तमस्त्रेण विधूतं शरतूलवत्।\nतथा तदभवद्युद्धं तुमुलं रोमहर्षणम्।\nलब्धालोकस्तु राजेन्द्र पुनः शत्रुमयोधयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2018403, "chapter_id": 1382, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि विंशोऽध्यायः ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]