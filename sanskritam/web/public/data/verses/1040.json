[{"id": 2002006, "chapter_id": 1040, "verse_number": "१-४१-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002007, "chapter_id": 1040, "verse_number": "१-४१-१", "content_sanskrit": "एवमुक्तः स तेजस्वी शृङ्गी कोपसमन्वितः।\nमृतधारं गुरुं श्रुत्वा पर्यतप्यत मन्युना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002008, "chapter_id": 1040, "verse_number": "१-४१-२", "content_sanskrit": "स त कृशमक्षिप्रेक्ष्य सूनृतां वाचमुत्सृजन्।\nअपृच्छत्तं कथं तातः सर्वभूतहिते रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002009, "chapter_id": 1040, "verse_number": "१-४१-३", "content_sanskrit": "अनन्यचेताः सततं विष्णुं दवेमतोषयत्।\nवन्यान्नभोजी सततं मुनिर्मौनव्रते स्थितः।\nएवंभूतः स तेजस्वी स मेऽद्य मृतधारकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002010, "chapter_id": 1040, "verse_number": "१-४१-४x", "content_sanskrit": "कृश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002011, "chapter_id": 1040, "verse_number": "१-४१-४", "content_sanskrit": "राज्ञा परिक्षिता तात मृगयां परिधावता।\nअवसक्तः पितुस्तेऽद्य मृतः स्कन्धे भुजङ्गमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002012, "chapter_id": 1040, "verse_number": "१-४१-५x", "content_sanskrit": "शृङ्ग्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002013, "chapter_id": 1040, "verse_number": "१-४१-५", "content_sanskrit": "किं मे पित्रा कृतं तस्य राज्ञोऽनिष्टं दुरात्मनः।\nब्रूहि तत्कृश तत्त्वेन पश्य मे तपसो बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002014, "chapter_id": 1040, "verse_number": "१-४१-६x", "content_sanskrit": "कृश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002015, "chapter_id": 1040, "verse_number": "१-४१-६", "content_sanskrit": "स राजा मृगयां यातः परिक्षिदभिमन्युजः।\nससार मृगमेकाकी विद्ध्वा बाणेन शीघ्रगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002016, "chapter_id": 1040, "verse_number": "१-४१-७", "content_sanskrit": "न चापश्यन्मृगं राजा चरंस्तस्मिन्महावने।\nपितरं ते स दृष्ट्वैव पप्रच्छानभिभाषिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002017, "chapter_id": 1040, "verse_number": "१-४१-८", "content_sanskrit": "तं स्थाणुभूतं तिष्ठन्तं क्षुत्पिपासाश्रमातुरः।\nपुनःपुनर्मृगं नष्टं प्रपच्छ पितरं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002018, "chapter_id": 1040, "verse_number": "१-४१-९", "content_sanskrit": "स च मौनव्रतोपेतो नैव तं प्रत्यभाषत।\nतस्य राजा धनुष्कोट्या सर्पं स्कन्धे समासजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002019, "chapter_id": 1040, "verse_number": "१-४१-१०", "content_sanskrit": "शृङ्गिंस्तव पिता सोऽपि तथैवास्ते यतव्रतः।\nसोऽपि राजा स्वनगरं प्रस्थितो गजसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002020, "chapter_id": 1040, "verse_number": "१-४१-११x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002021, "chapter_id": 1040, "verse_number": "१-४१-११", "content_sanskrit": "श्रुत्वैवमृषिपुत्रस्तु शवं स्कन्धे प्रतिष्ठितम्।\nकोपसंरक्तनयनः प्रज्वलन्निव मन्युना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002022, "chapter_id": 1040, "verse_number": "१-४१-१२", "content_sanskrit": "आविष्टः स हि कोपेन शशाप नृपतिं तदा।\nवार्युपस्पृश्य तेजस्वी क्रोधवेगबलात्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002023, "chapter_id": 1040, "verse_number": "१-४१-१३x", "content_sanskrit": "शृङ्ग्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002024, "chapter_id": 1040, "verse_number": "१-४१-१३", "content_sanskrit": "योऽसौ वृद्धस्य तातस्य तथा कृच्छ्रगतस्य ह।\nस्कन्धे मृतं समास्राक्षीत्पन्नगं राजकिल्विषी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002025, "chapter_id": 1040, "verse_number": "१-४१-१४", "content_sanskrit": "तं पापमतिसंक्रुद्धस्तक्षकः पन्नगेश्वरः।\nआशीविषस्तिग्मतेजा मद्वाक्यबलचोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002026, "chapter_id": 1040, "verse_number": "१-४१-१५", "content_sanskrit": "सप्तरात्रादितो नेता यमस्य सदनं प्रति।\nद्विजानामवमन्तारं कुरूणामयशस्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002027, "chapter_id": 1040, "verse_number": "१-४१-१६x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002028, "chapter_id": 1040, "verse_number": "१-४१-१६", "content_sanskrit": "इति शप्त्वातिसंक्रुद्धः शृङ्गी पितरमभ्यगात्।\nआसीनं ग्रोव्रजे तस्मिन्वहन्तं शवपन्नगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002029, "chapter_id": 1040, "verse_number": "१-४१-१७", "content_sanskrit": "स तमलक्ष्य पितरं शृङ्गी स्कन्धगतेन वै।\nशवेन भुजगेनासीद्भूयः क्रोधसमाकुलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002030, "chapter_id": 1040, "verse_number": "१-४१-१८", "content_sanskrit": "दुःखाच्चाश्रूणि मुमुचे पितरं चेदमब्रवीत्।\nश्रुत्वेमां धर्षणां तात तव तेन दुरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002031, "chapter_id": 1040, "verse_number": "१-४१-१९", "content_sanskrit": "राज्ञा परिक्षिता कोपादशपं तमहं नृपम्।\nयथार्हति स एवोग्रं शापं कुरुकुलाधमः।\nसप्तमेऽहनि तं पापं तक्षकः पन्नगोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002032, "chapter_id": 1040, "verse_number": "१-४१-२०", "content_sanskrit": "वैवस्वतस्य सदनं नेता परमदारुणम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2002033, "chapter_id": 1040, "verse_number": "१-४१-२०x", "content_sanskrit": "सौतिरुवाच।\nतमब्रवीत्पिता ब्रह्मंस्तथा कोपसमन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2002034, "chapter_id": 1040, "verse_number": "१-४१-२१x", "content_sanskrit": "शमीक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2002035, "chapter_id": 1040, "verse_number": "१-४१-२१", "content_sanskrit": "न मे प्रियं कृतं तात नैष धर्मस्तपस्विनाम्।\nवयं तस्य नरेन्द्रस्य विषये निवसामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2002036, "chapter_id": 1040, "verse_number": "१-४१-२२", "content_sanskrit": "न्यायतो रक्षितास्तेन तस्य पापं न रोचये।\nसर्वथा वर्तमानस्य राज्ञो ह्यस्मद्विधैः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2002037, "chapter_id": 1040, "verse_number": "१-४१-२३", "content_sanskrit": "क्षन्तव्यं पुत्र धर्मो हि हतो हन्ति न संशयः।\nयदि राजा न संरक्षेत्पीडा नः परमा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2002038, "chapter_id": 1040, "verse_number": "१-४१-२४", "content_sanskrit": "न शक्नुयाम चरितुं धर्मं पुत्र यथासुखम्।\nरक्षमाणा वयं तात राजभिर्धर्मदृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2002039, "chapter_id": 1040, "verse_number": "१-४१-२५", "content_sanskrit": "चरामो विपुलं धर्मं तेषां भागोऽस्ति धर्मतः।\nसर्वथा वर्तमानस्य राज्ञः क्षन्तव्यमेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2002040, "chapter_id": 1040, "verse_number": "१-४१-२६", "content_sanskrit": "परिक्षित्तु विशेषेण यथाऽस्य प्रपितामहः।\nरक्षत्यस्मांस्तथा राज्ञा रक्षितव्याः प्रजा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2002041, "chapter_id": 1040, "verse_number": "१-४१-२७", "content_sanskrit": "अराजके जनपदे दोषा जायन्ति वै सदा।\nउद्वृत्तं सततं लोकं राजा दण्डेन शास्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2002042, "chapter_id": 1040, "verse_number": "१-४१-२८", "content_sanskrit": "दण्डात्प्रतिभयं भूयः शान्तिरुत्पद्यते तदा।\nनोद्विग्नश्चरते धर्मं नोद्विग्नश्चरते क्रियाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2002043, "chapter_id": 1040, "verse_number": "१-४१-२९", "content_sanskrit": "राज्ञा प्रतिष्ठितो धर्मो धर्मात्स्वर्गः प्रतिष्ठितः।\nराज्ञो यज्ञक्रियाः सर्वा यज्ञाद्देवाः प्रतिष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2002044, "chapter_id": 1040, "verse_number": "१-४१-३०", "content_sanskrit": "देवाद्वृष्टिः प्रवर्तेत वृष्टेरोषधयः स्मृताः।\nओषधिभ्यो मनुष्याणां धारयन्सततं हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2002045, "chapter_id": 1040, "verse_number": "१-४१-३१", "content_sanskrit": "मनुष्याणां च यो धाता राजा राज्यकरः पुनः।\nदशश्रोत्रियसमो राजा इत्येवं मनुरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2002046, "chapter_id": 1040, "verse_number": "१-४१-३२", "content_sanskrit": "तेनेह क्षुधितेनैत्य श्रान्तेन मृगलिप्सुना।\nअजानता कृतं मन्ये व्रतमेतदिदं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2002047, "chapter_id": 1040, "verse_number": "१-४१-३३", "content_sanskrit": "कस्मादिदं त्वया बाल्यात्सहसा दुष्कृतं कृतम्।\nन ह्यर्हति नृपः शापमस्मत्तः पुत्र सर्वथा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2002048, "chapter_id": 1040, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि एकचत्वारिंशोऽध्यायः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]