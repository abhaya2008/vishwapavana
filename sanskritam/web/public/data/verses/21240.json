[{"id": 7001240000, "chapter_id": 21240, "verse_number": "२-५-१३-१", "content_sanskrit": "देव्युवाच ।\nकलौ कलुषिते काले दुर्जये दुरतिक्रमे ।\nअपुण्यतमसाच्छन्ने लोके धर्मपराङ्मुखे॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001240001, "chapter_id": 21240, "verse_number": "२-५-१३-२", "content_sanskrit": "क्षीणे वर्णाश्रमाचारे संकटे समुपस्थिते ।\nसर्वाधिकारे संदिग्धे निश्चिते वापि पर्यये॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001240002, "chapter_id": 21240, "verse_number": "२-५-१३-३", "content_sanskrit": "तदोपदेशे विहते गुरुशिष्यक्रमे गते ।\nकेनोपायेन मुच्यंते भक्तास्तव महेश्वर॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001240003, "chapter_id": 21240, "verse_number": "२-५-१३-४", "content_sanskrit": "ईश्वर उवाच ।\nआश्रित्य परमां विद्यां हृद्यां पञ्चाक्षरीं मम ।\nभक्त्या च भावितात्मानो मुच्यंते कलिजा नराः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001240004, "chapter_id": 21240, "verse_number": "२-५-१३-५", "content_sanskrit": "मनोवाक्कायजैर्दोषैर्वक्तुं स्मर्तुमगोचरैः ।\nदूषितानां कृतघ्नानां निंदकानां छलात्मनाम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001240005, "chapter_id": 21240, "verse_number": "२-५-१३-६", "content_sanskrit": "लुब्धानां वक्रमनसामपि मत्प्रवणात्मनाम् ।\nमम पञ्चाक्षरी विद्या संसारभयतारिणी॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001240006, "chapter_id": 21240, "verse_number": "२-५-१३-७", "content_sanskrit": "मयैवमसकृद्देवि प्रतिज्ञातं धरातले ।\nपतितो ऽपि विमुच्येत मद्भक्तो विद्ययानया॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001240007, "chapter_id": 21240, "verse_number": "२-५-१३-८", "content_sanskrit": "देव्युवाच ।\nकर्मायोग्यो भवेन्मर्त्यः पतितो यदि सर्वथा ।\nकर्मायोगेन यत्कर्म कृतं च नरकाय हि॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001240008, "chapter_id": 21240, "verse_number": "२-५-१३-९", "content_sanskrit": "ततः कथं विमुच्येत पतितो विद्यया ऽनया ।\nईश्वर उवाच ।\nतथ्यमेतत्त्वया प्रोक्तं तथा हि शृणु सुन्दरि॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001240009, "chapter_id": 21240, "verse_number": "२-५-१३-१०", "content_sanskrit": "रहस्यमिति मत्वैतद्गोपितं यन्मया पुरा ।\nसमंत्रकं मां पतितः पूजयेद्यदि मोहितः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001240010, "chapter_id": 21240, "verse_number": "२-५-१३-११", "content_sanskrit": "नारकी स्यान्न सन्देहो मम पञ्चाक्षरं विना ।\nअब्भक्षा वायुभक्षाश्च ये चान्ये व्रतकर्शिताः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001240011, "chapter_id": 21240, "verse_number": "२-५-१३-१२", "content_sanskrit": "तेषामेतैर्व्रतैर्नास्ति मम लोकसमागमः ।\nभक्त्या पञ्चाक्षरेणैव यो हि मां सकृदर्चयेत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001240012, "chapter_id": 21240, "verse_number": "२-५-१३-१३", "content_sanskrit": "सो ऽपि गच्छेन्मम स्थानं मन्त्रस्यास्यैव गौरवात् ।\nतस्मात्तपांसि यज्ञाश्च व्रतानि नियमास्तथा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001240013, "chapter_id": 21240, "verse_number": "२-५-१३-१४", "content_sanskrit": "पञ्चाक्षरार्चनस्यैते कोट्यंशेनापि नो समः ।\nबद्धो वाप्यथ मुक्तो वा पाशात्पञ्चाक्षरेण यः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001240014, "chapter_id": 21240, "verse_number": "२-५-१३-१५", "content_sanskrit": "पूजयेन्मां स मुच्येत नात्र कार्या विचारणा ।\nअरुद्रो वा सरुद्रो वा सकृत्पञ्चाक्षरेण यः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001240015, "chapter_id": 21240, "verse_number": "२-५-१३-१६", "content_sanskrit": "पूजयेत्पतितो वापि मूढो वा मुच्यते नरः ।\nषडक्षरेण वा देवि तथा पञ्चाक्षरेण वा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001240016, "chapter_id": 21240, "verse_number": "२-५-१३-१७", "content_sanskrit": "स ब्रह्मांगेन मां भक्त्या पूजयेद्यदि मुच्यते ।\nपतितो ऽपतितो वापि मन्त्रेणानेन पूजयेत्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001240017, "chapter_id": 21240, "verse_number": "२-५-१३-१८", "content_sanskrit": "मम भक्तो जितक्रोधो सलब्धो ऽलब्ध एव वा ।\nअलब्धालब्ध एवेह कोटिकोटिगुणाधिकः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001240018, "chapter_id": 21240, "verse_number": "२-५-१३-१९", "content_sanskrit": "तस्माल्लब्ध्वैव मां देवि मन्त्रेणानेन पूजयेत् ।\nलब्ध्वा संपूजयेद्यस्तु मैत्र्यादिगुणसंयुतः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001240019, "chapter_id": 21240, "verse_number": "२-५-१३-२०", "content_sanskrit": "ब्रह्मचर्यरतो भक्त्या मत्सादृश्यमवाप्नुयात् ।\nकिमत्र बहुनोक्तेन भक्तास्सर्वेधिकारिणः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001240020, "chapter_id": 21240, "verse_number": "२-५-१३-२१", "content_sanskrit": "मम पञ्चाक्षरे मंत्रे तस्माच्छ्रेष्ठतरो हि सः ।\nपञ्चाक्षरप्रभावेण लोकवेदमहर्षयः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001240021, "chapter_id": 21240, "verse_number": "२-५-१३-२२", "content_sanskrit": "तिष्ठंति शाश्वता धर्मा देवास्सर्वमिदं जगत् ।\nप्रलये समनुप्राप्ते नष्टे स्थावरजंगमे॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001240022, "chapter_id": 21240, "verse_number": "२-५-१३-२३", "content_sanskrit": "सर्वं प्रकृतिमापन्नं तत्र संलयमेष्यति ।\nएको ऽहं संस्थितो देवि न द्वितीयो ऽस्ति कुत्रचित्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001240023, "chapter_id": 21240, "verse_number": "२-५-१३-२४", "content_sanskrit": "तदा वेदाश्च शास्त्राणि सर्वे पञ्चाक्षरे स्थिताः ।\nते नाशं नैव संप्राप्ता मच्छक्त्या ह्यनुपालिताः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001240024, "chapter_id": 21240, "verse_number": "२-५-१३-२५", "content_sanskrit": "ततस्सृष्टिरभून्मत्तः प्रकृत्यात्मप्रभेदतः ।\nगुणमूर्त्यात्मनां चैव ततोवांतरसंहृतिः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001240025, "chapter_id": 21240, "verse_number": "२-५-१३-२६", "content_sanskrit": "तदा नारायणश्शेते देवो मायामयीं तनुम् ।\nआस्थाय भोगिपर्यंकशयने तोयमध्यगः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001240026, "chapter_id": 21240, "verse_number": "२-५-१३-२७", "content_sanskrit": "तन्नाभिपंकजाज्जातः पञ्चवक्त्रः पितामहः ।\nसिसृक्षमाणो लोकांस्त्रीन्न सक्तो ह्यसहायवान्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001240027, "chapter_id": 21240, "verse_number": "२-५-१३-२८", "content_sanskrit": "मुनीन्दश ससर्जादौ मानसानमितौजसः ।\nतेषां सिद्धिविवृद्ध्यर्थं मां प्रोवाच पितामहः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001240028, "chapter_id": 21240, "verse_number": "२-५-१३-२९", "content_sanskrit": "मत्पुत्राणां महादेव शक्तिं देहि महेश्वर ।\nइत्येवं प्रार्थितस्तेन पञ्चवक्त्रधरो ह्यहम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001240029, "chapter_id": 21240, "verse_number": "२-५-१३-३०", "content_sanskrit": "पञ्चाक्षराणि क्रमशः प्रोक्तवान्पद्मयोनये ।\nस पञ्चवदनैस्तानि गृह्णंल्लोकपितामहः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001240030, "chapter_id": 21240, "verse_number": "२-५-१३-३१", "content_sanskrit": "वाच्यवाचकभावेन ज्ञातवान्मां महेश्वरम् ।\nज्ञात्वा प्रयोगं विविधं सिद्धमंत्रः प्रजापतिः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001240031, "chapter_id": 21240, "verse_number": "२-५-१३-३२", "content_sanskrit": "पुत्रेभ्यः प्रददौ मंत्रं मंत्रार्थं च यथातथम् ।\nते च लब्ध्वा मंत्ररत्नं साक्षाल्लोकपितामहात्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001240032, "chapter_id": 21240, "verse_number": "२-५-१३-३३", "content_sanskrit": "तदाज्ञप्तेन मार्गेण मदाराधनकांक्षिणः ।\nमेरोस्तु शिखरे रम्ये मुंजवान्नाम पर्वतः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001240033, "chapter_id": 21240, "verse_number": "२-५-१३-३४", "content_sanskrit": "मत्प्रियः सततं श्रीमान्मद्भक्तै रक्षितस्सदा ।\nतस्याभ्याशे तपस्तीव्रं लोकं स्रष्टुं समुत्सुकाः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001240034, "chapter_id": 21240, "verse_number": "२-५-१३-३५", "content_sanskrit": "दिव्यं वर्षसहस्रं तु वायुभक्षास्समाचरन् ।\nतेषां भक्तिमहं दृष्ट्वा सद्यः प्रत्यक्षतामियाम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001240035, "chapter_id": 21240, "verse_number": "२-५-१३-३६", "content_sanskrit": "ऋषिं छंदश्च कीलं च बीजशक्तिं च दैवतम् ।\nन्यासं षडंगं दिग्बंधं विनियोगमशेषतः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001240036, "chapter_id": 21240, "verse_number": "२-५-१३-३७", "content_sanskrit": "प्रोक्तवानहमार्याणां जगत्सृष्टिविवृद्धये ।\nततस्ते मंत्रमाहात्म्यादृषयस्तपसेधिताः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001240037, "chapter_id": 21240, "verse_number": "२-५-१३-३८", "content_sanskrit": "सृष्टिं वितन्वते सम्यक्सदेवासुरमानुषीम् ।\nअस्याः परमविद्यायास्स्वरूपमधुनोच्यते॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001240038, "chapter_id": 21240, "verse_number": "२-५-१३-३९", "content_sanskrit": "आदौ नमः प्रयोक्तव्यं शिवाय तु ततः परम् ।\nसैषा पञ्चाक्षरी विद्या सर्वश्रुतिशिरोगता॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001240039, "chapter_id": 21240, "verse_number": "२-५-१३-४०", "content_sanskrit": "सर्वजातस्य सर्वस्य बीजभूता सनातनी ।\nप्रथमं मन्मुखोद्गीर्णा सा ममैवास्ति वाचिका॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001240040, "chapter_id": 21240, "verse_number": "२-५-१३-४१", "content_sanskrit": "तप्तचामीकरप्रख्या पीनोन्नतपयोधरा ।\nचतुर्भुजा त्रिनयना बालेंदुकृतशेखरा॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001240041, "chapter_id": 21240, "verse_number": "२-५-१३-४२", "content_sanskrit": "पद्मोत्पलकरा सौम्या वरदाभयपाणिका ।\nसर्वलक्षणसंपन्ना सर्वाभरणभूषिता॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001240042, "chapter_id": 21240, "verse_number": "२-५-१३-४३", "content_sanskrit": "सितपद्मासनासीना नीलकुंचितमूर्धजा ।\nअस्याः पञ्चविधा वर्णाः प्रस्फुरद्रश्मिमंडलाः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001240043, "chapter_id": 21240, "verse_number": "२-५-१३-४४", "content_sanskrit": "पीतः कृष्णस्तथा धूम्रः स्वर्णाभो रक्त एव च ।\nपृथक्प्रयोज्या यद्येते बिंदुनादविभूषिताः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001240044, "chapter_id": 21240, "verse_number": "२-५-१३-४५", "content_sanskrit": "अर्धचन्द्रनिभो बिंदुर्नादो दीपशिखाकृतिः ।\nबीजं द्वितीयं बीजेषु मंत्रस्यास्य वरानने॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001240045, "chapter_id": 21240, "verse_number": "२-५-१३-४६", "content_sanskrit": "दीर्घपूर्वं तुरीयस्य पञ्चमं शक्तिमादिशेत् ।\nवामदेवो नाम ऋषिः पंक्तिश्छन्द उदाहृतम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001240046, "chapter_id": 21240, "verse_number": "२-५-१३-४७", "content_sanskrit": "देवता शिव एवाहं मन्त्रस्यास्य वरानने ।\nगौतमो ऽत्रिर्वरारोहे विश्वामित्रस्तथांगिराः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001240047, "chapter_id": 21240, "verse_number": "२-५-१३-४८", "content_sanskrit": "भरद्वाजश्च वर्णानां क्रमशश्चर्षयः स्मृताः ।\nगायत्र्यनुष्टुप्त्रिष्टुप्च छंदांसि बृहती विराट्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001240048, "chapter_id": 21240, "verse_number": "२-५-१३-४९", "content_sanskrit": "इन्द्रो रुद्रो हरिर्ब्रह्मा स्कंदस्तेषां च देवताः ।\nमम पञ्चमुखान्याहुः स्थाने तेषां वरानने॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001240049, "chapter_id": 21240, "verse_number": "२-५-१३-५०", "content_sanskrit": "पूर्वादेश्चोर्ध्वपर्यंतं नकारादि यथाक्रमम् ।\nअदात्तः प्रथमो वर्णश्चतुर्थश्च द्वितीयकः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001240050, "chapter_id": 21240, "verse_number": "२-५-१३-५१", "content_sanskrit": "पञ्चमः स्वरितश्चैव तृतीयो निहतः स्मृतः ।\nमूलविद्या शिवं शैवं सूत्रं पञ्चाक्षरं तथा॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001240051, "chapter_id": 21240, "verse_number": "२-५-१३-५२", "content_sanskrit": "नामान्यस्य विजानीयाच्छैवं मे हृदयं महत् ।\nनकारश्शिर उच्येत मकारस्तु शिखोच्यते॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001240052, "chapter_id": 21240, "verse_number": "२-५-१३-५३", "content_sanskrit": "शिकारः कवचं तद्वद्वकारो नेत्रमुच्यते ।\nयकारो ऽस्त्रं नमस्स्वाहा वषठुंवौषडित्यपि॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001240053, "chapter_id": 21240, "verse_number": "२-५-१३-५४", "content_sanskrit": "फडित्यपि च वर्णानामन्ते ऽङ्गत्वं यदा तदा ।\nतत्रापि मूलमंत्रो ऽयं किंचिद्भेदसमन्वयात्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001240054, "chapter_id": 21240, "verse_number": "२-५-१३-५५", "content_sanskrit": "तत्रापि पञ्चमो वर्णो द्वादशस्वरभूषितः ।\nतास्मादनेन मंत्रेण मनोवाक्कायभेदतः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001240055, "chapter_id": 21240, "verse_number": "२-५-१३-५६", "content_sanskrit": "आवयोरर्चनं कुर्याज्जपहोमादिकं तथा ।\nयथाप्रज्ञं यथाकालं यथाशास्त्रं यथामति॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001240056, "chapter_id": 21240, "verse_number": "२-५-१३-५७", "content_sanskrit": "यथाशक्ति यथासंपद्यथायोगं यथारति ।\nयदा कदापि वा भक्त्या यत्र कुत्रापि वा कृता॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001240057, "chapter_id": 21240, "verse_number": "२-५-१३-५८", "content_sanskrit": "येन केनापि वा देवि पूजा मुक्तिं नयिष्यते ।\nमय्यासक्तेन मनसा यत्कृतं मम सुन्दरि॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001240058, "chapter_id": 21240, "verse_number": "२-५-१३-५९", "content_sanskrit": "मत्प्रियं च शिवं चैव क्रमेणाप्यक्रमेण वा ।\nतथापि मम भक्ता ये नात्यंतविवशाः पुनः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001240059, "chapter_id": 21240, "verse_number": "२-५-१३-६०", "content_sanskrit": "तेषां सर्वेषु शास्त्रेषु मयेव नियमः कृतः ।\nतत्रादौ संप्रवक्ष्यामि मन्त्रसंग्रहणं शुभम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001240060, "chapter_id": 21240, "verse_number": "२-५-१३-६१", "content_sanskrit": "यं विना निष्फलं जाप्यं येन वा सफलं भवेत्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]