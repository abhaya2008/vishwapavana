[{"id": 2105521, "chapter_id": 3277, "verse_number": "१६-६-१", "content_sanskrit": "वैशम्पायन उवाच।\nततो राज्ञाऽभ्यनुज्ञातो धृतराष्ट्रो महामनाः।\nययौ स्वभवनं राजा गान्धार्याऽनुगतस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105522, "chapter_id": 3277, "verse_number": "१६-६-२", "content_sanskrit": "मन्दप्राणगतिर्धामान्कृच्छ्रादिव समुद्वहन्।\nपदानि स महीपालो जीर्णो गजपतिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105523, "chapter_id": 3277, "verse_number": "१६-६-३", "content_sanskrit": "तमन्वगच्छद्विदुरो विद्वान्सूतश्च संजयः।\nस चापि परमेष्वासः कृपः सारद्वतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105524, "chapter_id": 3277, "verse_number": "१६-६-४", "content_sanskrit": "स प्रविश्य गृहं राजा कृतपूर्वाह्णिकक्रियः।\nतर्पयित्वा द्विजश्रेष्ठानाहारमकरोत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105525, "chapter_id": 3277, "verse_number": "१६-६-५", "content_sanskrit": "गान्धारी चैव धर्मज्ञा कुन्त्या सह मनस्विनी।\nवधूभिरुपचारेणि पूजिताऽभुङ्क्त भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105526, "chapter_id": 3277, "verse_number": "१६-६-६", "content_sanskrit": "कृताहारं कृताहाराः सर्वे ते विदुरादयः।\nपाण्डवाश्च कुरुश्रेष्ठमुपातिष्ठन्त तं नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105527, "chapter_id": 3277, "verse_number": "१६-६-७", "content_sanskrit": "ततोऽब्रवीन्महाराजः कुन्तीपुत्रमुपह्वरे।\nनिषण्णं पाणिना पृष्ठे संस्पृशन्नंबिकासुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105528, "chapter_id": 3277, "verse_number": "१६-६-८", "content_sanskrit": "अप्रमादस्त्वया कार्यः सर्वथा कुरुनन्दन।\nअष्टाङ्गे राजशार्दूल राज्ये धर्मपुरस्कृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105529, "chapter_id": 3277, "verse_number": "१६-६-९", "content_sanskrit": "तत्तु शक्यं महाराज रक्षितुं पाण्डुनन्दन।\nराज्यं धर्मेण कौन्तेय विद्वानसि निबोध तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105530, "chapter_id": 3277, "verse_number": "१६-६-१०", "content_sanskrit": "विद्यावृद्धान्सदैव त्वमुपासीथा युधिष्ठिर।\nशृणुयास्ते च यद्ब्रूयुः कुर्याश्चैवाविचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105531, "chapter_id": 3277, "verse_number": "१६-६-११", "content_sanskrit": "प्रातरुस्थाय तान्राजन्पूजयित्वा यथाविधि।\nकृत्यकाले समुत्पन्ने पृच्छेथाः कार्यमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105532, "chapter_id": 3277, "verse_number": "१६-६-१२", "content_sanskrit": "ते तु सम्मानिता राजंस्त्वया लोकहितार्थिना।\nप्रवक्ष्यन्ति हितं तात सर्वथा तव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105533, "chapter_id": 3277, "verse_number": "१६-६-१३", "content_sanskrit": "इन्द्रियाणि च सर्वाणि वाजिवत्परिपालय।\nहितायैव भविष्यन्ति रक्षितं द्रविणं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105534, "chapter_id": 3277, "verse_number": "१६-६-१४", "content_sanskrit": "अमात्यानुपधातीतान्पितृपैतामहाञ्शुचीन्।\nदान्तान्कर्मसु सर्वेषु मुख्यान्मुख्येषु योजयेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105535, "chapter_id": 3277, "verse_number": "१६-६-१५", "content_sanskrit": "चारयेथाश्च सततं चारैरविदितः परैः।\nपरीक्षितैर्बहुविधैः स्वराष्ट्रेषु परेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105536, "chapter_id": 3277, "verse_number": "१६-६-१६", "content_sanskrit": "पुरं च ते सुगुप्तं स्याद्दृढप्राकारतोरणम्।\nअट्टाट्टालकसम्बाधं षट्पदं सर्वतो दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105537, "chapter_id": 3277, "verse_number": "१६-६-१७", "content_sanskrit": "तस्य द्वाराणि सर्वाणि पर्याप्तानि बृहन्ति च।\nसर्वतः सुविभक्तानि यन्त्रैरारक्षितानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105538, "chapter_id": 3277, "verse_number": "१६-६-१८", "content_sanskrit": "पुरुषैरलमर्थस्ते विदितैः कुलशीलतः।\nआत्मा च रक्ष्यः सततं भोजनादिषु भारत।\nविहाराहारकालेषु माल्यशय्यासनेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105539, "chapter_id": 3277, "verse_number": "१६-६-१९", "content_sanskrit": "स्त्रियश्च ते सुगुप्ताः स्युर्वृद्धैराप्तैरधिष्ठिताः।\nशीलवद्भिः कुलीनैश्च विद्वद्भिश्च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105540, "chapter_id": 3277, "verse_number": "१६-६-२०", "content_sanskrit": "मन्त्रिणिश्चैव कुर्वीथा द्विजान्विद्याविशारदान्।\nविनीतांश्च कुलीनांश्च धर्मार्थकुशलानृजून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105541, "chapter_id": 3277, "verse_number": "१६-६-२१", "content_sanskrit": "तैः सार्धं मन्त्रयेथास्त्वं नात्यर्थं बहुभिःक सह।\nसमस्तैरपि च व्यस्तैर्व्यपदेशेन केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105542, "chapter_id": 3277, "verse_number": "१६-६-२२", "content_sanskrit": "सुसंवृतं मन्त्रगृहं स्थलं चारुह्य मन्त्रयेः।\nअरण्ये निःशलाके वा न च रात्रौ कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105543, "chapter_id": 3277, "verse_number": "१६-६-२३", "content_sanskrit": "वानराः पक्षिणश्चैव ये मनुष्यानुकारिणः।\nसर्वे मन्त्रगृहे वर्ज्या ये चापि जडपङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105544, "chapter_id": 3277, "verse_number": "१६-६-२४", "content_sanskrit": "मन्त्रभेदे हि ये दोषा भन्ति पृथिवीक्षिताम्।\nन ते शक्याः समाधातुं कथञ्चिदिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2105545, "chapter_id": 3277, "verse_number": "१६-६-२५", "content_sanskrit": "दोषांश्च मन्त्रभेदस्य ब्रूयास्त्वं मन्त्रिमण्डले।\nअभेदे च गुणा राजन्पुनःपुनररिंदम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2105546, "chapter_id": 3277, "verse_number": "१६-६-२६", "content_sanskrit": "पौरजानपदानां च शौचशौचे युधिष्ठिर।\nयथा स्याद्विदितं राजंस्तथा कार्यं कुरूद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2105547, "chapter_id": 3277, "verse_number": "१६-६-२७", "content_sanskrit": "व्यवहारश्च ते राजन्नित्यमाप्तैरधिष्ठितः।\nयोज्यस्तुष्टैर्हितै राजन्नित्यं चारैरनुष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2105548, "chapter_id": 3277, "verse_number": "१६-६-२८", "content_sanskrit": "परिमाणं विदित्वा च दण्डं दण्ड्येषु भारत।\nप्रणयेयुर्यथान्यायं पुरुषास्ते युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2105549, "chapter_id": 3277, "verse_number": "१६-६-२९", "content_sanskrit": "आदानरुचयश्चैव परदाराभिमर्शिनः।\nउग्रदण्डिप्रधानाश्च मिथ्याव्याहारिणस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2105550, "chapter_id": 3277, "verse_number": "१६-६-३०", "content_sanskrit": "आक्रोष्टारश्च लुब्धाश्च हर्तारः साहसप्रियाः।\nसभाविहारभेत्तारो वर्णानां च प्रदूषकाः।\nहिरण्यदण्ड्या वध्याश्च कर्तव्या देशकालतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2105551, "chapter_id": 3277, "verse_number": "१६-६-३१", "content_sanskrit": "`अवरोधभूमौ भृत्यैश्च पानं सह विवर्जयेत्।\nआक्रोशन्त्यनुमत्तास्ते कलत्रं वाऽपि गृह्णते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2105552, "chapter_id": 3277, "verse_number": "१६-६-३२", "content_sanskrit": "जिघांसन्त्यपि शस्त्रेण नष्टाः क्रीडन्ति चोत्कटाः।\nनानाक्षेपा व्याहरन्ति गम्यागम्यं न जानते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2105553, "chapter_id": 3277, "verse_number": "१६-६-३३", "content_sanskrit": "अतिपानेनि राजाऽपि सर्वं कोशं विनाशयेत्।\nवितरेद्गायकेभ्यश्च वृथा च द्रव्यसञ्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2105554, "chapter_id": 3277, "verse_number": "१६-६-३४", "content_sanskrit": "शब्दमात्मनि दोषांश्च पिबेदेकश्च जायया।\nयुक्त्या प्रकाशमयति सुवीर्यस्यि विवृद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2105555, "chapter_id": 3277, "verse_number": "१६-६-३५", "content_sanskrit": "प्रातरेव हि पश्यथा ये कुर्युः प्रियकर्म ते।\nअलङ्कारमथो भोज्यमत ऊर्ध्वं समाचरेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2105556, "chapter_id": 3277, "verse_number": "१६-६-३६", "content_sanskrit": "पश्येथाश्चि ततो योधान्सदा त्वं प्रतिहर्षयन्।\nदूतानां च चराणां च प्रदोषस्ते सदा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2105557, "chapter_id": 3277, "verse_number": "१६-६-३७", "content_sanskrit": "सदा चापररात्रान्ते भवेत्कार्यार्थनिर्णयः।\nमध्यरात्रे विहारस्ते मध्याह्ने च सदा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2105558, "chapter_id": 3277, "verse_number": "१६-६-३८", "content_sanskrit": "सर्वे त्वौपयिकाः कालाः कार्याणां भरतर्षभ।\nतथैवालङ्कृतः काले तिष्ठिथा भूरिदक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2105559, "chapter_id": 3277, "verse_number": "१६-६-३९", "content_sanskrit": "`न विद्राव्य च तिष्ठेत परिहार्य विभूषणम्।\nप्रयोज्यं सर्वदैवेह मङ्गल्यं पापनाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2105560, "chapter_id": 3277, "verse_number": "१६-६-४०", "content_sanskrit": "चक्रवत्तात कार्याणां पर्यायो दृश्यते सदा।\nकोशस्य निचये यत्नं कुर्वीथा न्यायतः सदा।\nविविधस्य महाराज विपरीतं विवर्जयेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2105561, "chapter_id": 3277, "verse_number": "१६-६-४१", "content_sanskrit": "चारैर्विदित्वा शत्रूंश्च ये राज्ञामन्तरैषिणः।\nतानाप्तैः पुरुषैर्दूराद्धातयेथा नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2105562, "chapter_id": 3277, "verse_number": "१६-६-४२", "content_sanskrit": "कर्म दृष्ट्वाऽथ भृत्यांस्त्वं वरयेथाः कुरूद्वह।\nकारयेथाश्च कर्माणि युक्तायुक्तैरधिष्ठितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2105563, "chapter_id": 3277, "verse_number": "१६-६-४३", "content_sanskrit": "सेनाप्राणेता च भवेत्तव तात दृढव्रतः।\nशूरः क्लेशसहश्चैव हितो भक्तश्च पूरुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2105564, "chapter_id": 3277, "verse_number": "१६-६-४४", "content_sanskrit": "सर्वे जनपदाश्चैव तव कर्माणि पाण्डव।\nगोवद्रासभवच्चैव कुर्युर्ये व्यवहारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2105565, "chapter_id": 3277, "verse_number": "१६-६-४५", "content_sanskrit": "स्वरन्ध्रं पररन्ध्रं च स्वेषु चैव परेषु च।\nउपलक्षयितव्यं ते नित्यमेव युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2105566, "chapter_id": 3277, "verse_number": "१६-६-४६", "content_sanskrit": "देशजाश्चैव पुरुषा विक्रान्ताः स्वेषु कर्मसु।\nयात्राभिरनुरूपाभिरनुग्राह्या हितास्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2105567, "chapter_id": 3277, "verse_number": "१६-६-४७", "content_sanskrit": "गुणार्थिनां गुणः कार्यो विदुषा वै जनाधिप।\nअविचार्याश्च ते ते स्युरचला इव नित्यशः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2105568, "chapter_id": 3277, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि षष्ठोऽध्यायः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]