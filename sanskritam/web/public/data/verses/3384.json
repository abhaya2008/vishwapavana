[{"id": 2110175, "chapter_id": 3384, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2110176, "chapter_id": 3384, "verse_number": "१", "content_sanskrit": "पुत्रं ययातेः प्रब्रूहि पूरुं धर्मभृतां वरम् ।\nआनुपूर्व्येण ये चान्ये पूरुवंशविवर्धनाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2110177, "chapter_id": 3384, "verse_number": "२", "content_sanskrit": "विस्तरेण पुनर्ब्रूहि दौष्यन्तेर्जनमेजयात् ।\nसम्बभूव यथा राजा भरतो द्विजसत्तमः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2110178, "chapter_id": 3384, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2110179, "chapter_id": 3384, "verse_number": "३", "content_sanskrit": "पूरुर्नृपतिशार्दूलो यथैवास्य पिता नृप ।\nधर्मनित्यः स्थितो राज्ये शक्रतुल्यपराक्रमः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2110180, "chapter_id": 3384, "verse_number": "४", "content_sanskrit": "प्रवीरः शतरुज्यौ च त्रयः पुत्रा महाबलाः ।\nपूरोः पौष्यामजायन्त प्रवीरस्तत्र वंशभाक्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2110181, "chapter_id": 3384, "verse_number": "५", "content_sanskrit": "नमस्युरभवत् तस्माद् धुरः शैव्यः सुतस्ततः ।\nपृथिव्यां सागरान्तायां राजा राजीवलोचनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2110182, "chapter_id": 3384, "verse_number": "६", "content_sanskrit": "सुभ्रुश्चोभयदो वीरः सौवीरतनयास्त्रयः ।\nनमस्योरभवन् पुत्राः शूराः सर्वे महारथाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2110183, "chapter_id": 3384, "verse_number": "७", "content_sanskrit": "सुन्वन्तं वसुनाभं च गर्गरम्यौ यशस्विनौ ।\nशूरानुभयदो राजा जनयामास वीर्यवान् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2110184, "chapter_id": 3384, "verse_number": "८", "content_sanskrit": "यवीयान् सुन्वतः पुत्रो रथन्तर्यामजायत ।\nशूरश्च दृढधन्वा च वपुष्मांश्च नृपोत्तमः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2110185, "chapter_id": 3384, "verse_number": "९", "content_sanskrit": "रुद्राश्वं पृषदश्वं च रथदश्वं गयं मनुम् ।\nयवीयान् जनयामास गन्धर्वान् भीमविक्रमान् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2110186, "chapter_id": 3384, "verse_number": "१०", "content_sanskrit": "रुद्राश्वस्य महाबाहोर्दशाप्सरसि सूनवः ।\nऋचेयुरथ कक्षेयुः कृपणेयुश्च वीर्यवान् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2110187, "chapter_id": 3384, "verse_number": "११", "content_sanskrit": "स्थण्डिलेयुर्जलेयुश्च स्थलेयुश्च महाबलः ।\nतेजोयुर्बलवान् वीरः रथेयुश्चेन्द्रविक्रमः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2110188, "chapter_id": 3384, "verse_number": "१२", "content_sanskrit": "धर्मेयुः सन्ततेयुश्च दशमो देवविक्रमः ।\nअनाधृष्याः सुतास्ते तु राजसूयाश्वमेधिनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2110189, "chapter_id": 3384, "verse_number": "१३", "content_sanskrit": "अन्तिनारस्ततो राजन् विद्वांश्चर्चेयुतोऽभवत् ।\nत्रस्नुं मोद्यं प्रतिरथं द्रुमं चाप्रतिमं युधि \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2110190, "chapter_id": 3384, "verse_number": "१४", "content_sanskrit": "एतान् वै सुषुवे साध्वी ह्यन्तिनाराद् यशस्विनी ।\nतेषां त्रस्नुर्महावीर्यः पौरवं वंशमुद्वहन् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2110191, "chapter_id": 3384, "verse_number": "१५", "content_sanskrit": "आजहार यशो दीप्तं जिगायैनां वसुन्धराम् ।\nइलिलं सुषुवे त्रस्नोर्यमुना च यशस्विनी\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2110192, "chapter_id": 3384, "verse_number": "१६", "content_sanskrit": "सोऽपि कृत्स्नामिमां भूमिं विजिग्ये जयतां वरः ।\nरथन्तर्यामृषीन् पञ्च पञ्चभूतोपमांस्ततः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2110193, "chapter_id": 3384, "verse_number": "१७", "content_sanskrit": "इलिलो जनयामास दुष्षन्तप्रमुखांस्तथा ।\nदुष्षन्तमनघं शूरं प्रशूरं चापि पञ्चमम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2110194, "chapter_id": 3384, "verse_number": "१८", "content_sanskrit": "तेषां ज्येष्ठो महाराज दुष्षन्तो दुर्जयो युधि ।\nदुष्षन्ताल्लक्षणायां तु जज्ञे वै जनमेजयः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2110195, "chapter_id": 3384, "verse_number": "१९", "content_sanskrit": "शकुन्तलायां भरतो दौष्षन्तिरभवत् सुतः ।\nतस्माद् भरतवंशस्य विप्रतस्थे महद्यशः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2110196, "chapter_id": 3384, "verse_number": "११", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि त्रिषष्टितमोऽध्यायः ॥६३॥ ॥ इति सम्भवे एकादशोऽध्यायः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]