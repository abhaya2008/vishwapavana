[{"id": 2185653, "chapter_id": 4941, "verse_number": "", "content_sanskrit": "लोभादिनिरूपणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2185654, "chapter_id": 4941, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2185655, "chapter_id": 4941, "verse_number": "१", "content_sanskrit": "यतः प्रभवति क्रोधः कामश्च भरतर्षभ ।\nशोकमोहौ विवित्सा च पराभूतिस्तथा मदः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2185656, "chapter_id": 4941, "verse_number": "२", "content_sanskrit": "लोभो मात्सर्यमीर्ष्या च कुत्सासूया कृपा तथा ।\nएतत्सर्वं महाप्राज्ञ याथातथ्येन मे वद\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2185657, "chapter_id": 4941, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2185658, "chapter_id": 4941, "verse_number": "३", "content_sanskrit": "त्रयोदशैतेऽतिबलाः शत्रवः प्राणिनां स्मृताः ।\nउपासते महाराज समस्ताः पुरुषानिह\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2185659, "chapter_id": 4941, "verse_number": "४", "content_sanskrit": "एते प्रमत्तं पुरुषमप्रमत्तास्तुदन्ति हि ।\nवृका इव विलुम्पन्ति दृष्ट्वैव पुरुषेतरान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2185660, "chapter_id": 4941, "verse_number": "५", "content_sanskrit": "एभ्यः प्रवर्तते दुःखमेभ्यः पापं प्रवर्तते ।\nइति मर्त्यो विजानीयात् सततं भरतर्षभ\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2185661, "chapter_id": 4941, "verse_number": "६", "content_sanskrit": "एतेषामुदयं स्थानं क्षयं च पुरुषोत्तम ।\nहन्त ते वर्णयिष्यामि तन्मे निगदतः शृणु\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2185662, "chapter_id": 4941, "verse_number": "७", "content_sanskrit": "लोभात् क्रोधः प्रभवति परदोषैरुदीर्यते ।\nक्षमया तिष्ठते राजन् क्षमया विनिवर्तते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2185663, "chapter_id": 4941, "verse_number": "८", "content_sanskrit": "सङ्कल्पाज्जायते कामः सेव्यमानो विवर्धते ।\nअवद्यदर्शनाद्व्येति तत्त्वज्ञानाच्च धीमताम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2185664, "chapter_id": 4941, "verse_number": "९", "content_sanskrit": "विरुद्धानि हि शास्त्राणि पश्यन्तीहाल्पबुद्धयः ।\nविवित्सा जायते यस्य तस्यैव विनिवर्तते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2185665, "chapter_id": 4941, "verse_number": "१०", "content_sanskrit": "प्रीतेः शोकः प्रभवति वियोगात्तस्य देहिनः ।\nयदा निरर्थकं वेत्ति तदा सद्यः प्रणश्यति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2185666, "chapter_id": 4941, "verse_number": "११", "content_sanskrit": "पराभूते क्रोधलोभ अभ्यासाच्च प्रवर्धते ।\nदयया सर्वभूतानां निर्वेदात् स निवर्तते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2185667, "chapter_id": 4941, "verse_number": "१२", "content_sanskrit": "सत्त्वत्यागात् तु मात्सर्यमहितानां च सेवया ।\nएतत् तु क्षीयते तात साधूनामुपसेवनात्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2185668, "chapter_id": 4941, "verse_number": "१३", "content_sanskrit": "कुलाज्ज्ञानात् तथैश्वर्यान्मदो भवति देहिनाम् ।\nएभिरेव यथा ज्ञातैर्मदः सद्यः प्रणश्यति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2185669, "chapter_id": 4941, "verse_number": "१४", "content_sanskrit": "ईर्ष्या कामात् प्रभवति सङ्घर्षाच्चैव भारत ।\nइतरेषां तु मर्त्यानां प्रज्ञया सा प्रणश्यति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2185670, "chapter_id": 4941, "verse_number": "१५", "content_sanskrit": "विभ्रमाल्लोकबाह्यानां द्वेष्यैर्वाक्यैरसङ्गतैः ।\nकुत्सा सञ्जायते राजन् निषेवाभिः प्रशाम्यति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2185671, "chapter_id": 4941, "verse_number": "१६", "content_sanskrit": "प्रतिकर्तुमशक्याय बलस्थायापकारिणे ।\nअसूया जायते तीव्रा कारुण्याद् विनिवर्तते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2185672, "chapter_id": 4941, "verse_number": "१७", "content_sanskrit": "कृपणान् सततं दृष्ट्वा ततः सञ्जायते कृपा ।\nधर्मनिष्ठां यदा वेत्ति तदा शाम्यति सा कृपा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2185673, "chapter_id": 4941, "verse_number": "१८", "content_sanskrit": "एतान्येव जितान्याहुः प्रशमेच्च त्रयोदश ।\nएते हि धार्तराष्ट्राणां सर्वे दोषास्त्रयोदश ।\nत्वया सत्यार्थिना नित्यं विजिता जेष्यसे च तान्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2185674, "chapter_id": 4941, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे एकोनत्रिंशोऽध्यायः ॥ २९ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]