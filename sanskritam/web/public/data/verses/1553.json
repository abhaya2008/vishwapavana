[{"id": 2025706, "chapter_id": 1553, "verse_number": "३-१९१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2025707, "chapter_id": 1553, "verse_number": "३-१९१-१", "content_sanskrit": "ततः स पुनरेवाथ मार्कण्डेयं तपस्विनम्।\nपप्रच्छ विनयोपेतो धर्मराजो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2025708, "chapter_id": 1553, "verse_number": "३-१९१-२", "content_sanskrit": "नैके युगसहस्रान्तास्त्वया दृष्टा महामुने।\nन चापीह समः कश्चिदायुष्मान्दृश्यते तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2025709, "chapter_id": 1553, "verse_number": "३-१९१-३", "content_sanskrit": "वर्जयित्वा महात्मानं ब्रह्माणं परमेष्ठिनम्।\nन तेऽस्ति सदृशः कश्चिदायुषा ब्रह्मसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2025710, "chapter_id": 1553, "verse_number": "३-१९१-४", "content_sanskrit": "अथाऽन्तरिक्षे लोकेऽस्मिन्देवदानववर्जिते।\nत्वमेव प्रलये विप्र ब्रह्माणमुपतिष्ठसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2025711, "chapter_id": 1553, "verse_number": "३-१९१-५", "content_sanskrit": "प्रलये चापि निर्वृत्ते प्रबुद्धे च पितामहे।\nत्वमेकः सृज्यमानानि भूतानीह प्रपश्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2025712, "chapter_id": 1553, "verse_number": "३-१९१-६", "content_sanskrit": "चतुर्विधानि विप्रर्षे यथावत्परमेष्ठिना।\nवायुभूता दिशः कृत्वा विक्षिप्यापस्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2025713, "chapter_id": 1553, "verse_number": "३-१९१-७", "content_sanskrit": "त्वया लोकगुरुः साक्षात्सर्वलोकपितामहः।\nआराधितो द्विजश्रेष्ठ तत्परेण समाधिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2025714, "chapter_id": 1553, "verse_number": "३-१९१-८", "content_sanskrit": "स्वप्रमाणमथो विप्र त्वया कृतमनेकशः।\nघोरेणाविश्य तपसा वेधसो निर्जितास्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2025715, "chapter_id": 1553, "verse_number": "३-१९१-९", "content_sanskrit": "नारायणाङ्कप्रख्यस्त्वं सांपरायेऽतिपठ्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2025716, "chapter_id": 1553, "verse_number": "३-१९१-१०", "content_sanskrit": "भगवाननेकशः कृत्वा त्वया विष्णोश्च विश्वकृत्।\nकर्णिकोद्धरणं दिव्यं ब्रह्मणः कामरूपिणः।\nरत्नालंकारयोगाभ्यां दृग्भ्यां दृष्टस्त्वया पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2025717, "chapter_id": 1553, "verse_number": "३-१९१-११", "content_sanskrit": "तस्मात्तवान्तको मृत्युर्जरा वा देहनाशिनी।\nन त्वां विशति विप्रर्षे प्रसादात्परमेष्ठिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2025718, "chapter_id": 1553, "verse_number": "३-१९१-१२", "content_sanskrit": "यदा नैव रविर्नाग्निर्न वायुर्न च चन्द्रमाः।\nनैवान्तरिक्षं नैवोर्वी शेषं भवति किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2025719, "chapter_id": 1553, "verse_number": "३-१९१-१३", "content_sanskrit": "तस्मिन्नेकार्णवे लोके नष्टे स्थावरजङ्गमे।\nनष्टे देवासुरगणे समुत्सन्नमहोरगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2025720, "chapter_id": 1553, "verse_number": "३-१९१-१४", "content_sanskrit": "शयानममितात्मानं पद्मे पद्मनिकेतनम्।\nत्वमेकः सर्वभूतेशं ब्रह्माणमुपतिष्ठसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2025721, "chapter_id": 1553, "verse_number": "३-१९१-१५", "content_sanskrit": "एतत्प्रत्यक्षतः सर्वं पूर्वं वृत्तं द्विजोत्तम।\nतस्मादिच्छाम्यहं श्रोतुं सर्वांहेत्वात्मिकां कथां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2025722, "chapter_id": 1553, "verse_number": "३-१९१-१६", "content_sanskrit": "अनुभूतं हि बहुशस्त्वयैकेन द्विजोत्तम।\nन तेऽस्त्यविदितं किंचित्सर्वलोकेषु नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2025723, "chapter_id": 1553, "verse_number": "३-१९१-१७x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2025724, "chapter_id": 1553, "verse_number": "३-१९१-१७", "content_sanskrit": "हन्त ते कथयिष्यामि नमस्कृत्वा स्वयंभुवे।\nपुरुषाय पुराणाय शाश्वतायाव्ययाय च।\nअव्यक्ताय सुसूक्ष्माय निर्गुणाय गुणात्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2025725, "chapter_id": 1553, "verse_number": "३-१९१-१८", "content_sanskrit": "य एष पृथुदीर्घाक्षः पीतवासा जनार्दनः।\nएष कर्ता विकर्ता च भूतात्मा भूतकृत्प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2025726, "chapter_id": 1553, "verse_number": "३-१९१-१९", "content_sanskrit": "अचिन्त्यं महदाश्चर्यं पवित्रमिति चोच्यते।\nअनादिनिधनं भूतं विश्वमव्ययमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2025727, "chapter_id": 1553, "verse_number": "३-१९१-२०", "content_sanskrit": "एष कर्ता न क्रियते कारणं चापि पौरुषे।\nको ह्येनं परुषं वेत्ति देवा अपि न तं पौरषे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2025728, "chapter_id": 1553, "verse_number": "३-१९१-२१", "content_sanskrit": "सर्वमाश्चर्यमेवैतन्निर्वृत्तं राजसत्तम।\nआदितो मनुजव्याघ्र कृत्स्नस्य जगतः क्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2025729, "chapter_id": 1553, "verse_number": "३-१९१-२२", "content_sanskrit": "चत्वार्याहुः सहस्राणि वर्षाणां तत्कृतं युगम्।\nतस्य तावच्छती सन्ध्या सन्ध्यांशश्च तथाविधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2025730, "chapter_id": 1553, "verse_number": "३-१९१-२३", "content_sanskrit": "वीणि वर्षसहस्राणि त्रेतायुगमिहोच्यते।\nतस्य तावच्छती सन्ध्या सन्ध्यांशश्च ततः परं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2025731, "chapter_id": 1553, "verse_number": "३-१९१-२४", "content_sanskrit": "तथा वर्षसहस्रे द्वे द्वापरं परिमाणतः।\nतस्यापि द्विशती सन्ध्या सन्ध्यांशश्च तथाविधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2025732, "chapter_id": 1553, "verse_number": "३-१९१-२५", "content_sanskrit": "सहस्रमेकं वर्षाणां ततः कलियुगं स्मृतम्।\nतस्य वर्षशतं सन्ध्या सन्ध्यांशश्च ततः परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2025733, "chapter_id": 1553, "verse_number": "३-१९१-२६", "content_sanskrit": "सन्ध्यासंध्यांशयोस्तुल्यं प्रमाणमुपधारय।\nक्षीणे कलियुगे चैव प्रवर्तति कृतं युगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2025734, "chapter_id": 1553, "verse_number": "३-१९१-२७", "content_sanskrit": "एषा द्वादशसाहस्री युगाख्या परिकीर्तिता।\nएतत्सहस्रपर्यन्तमहो ब्राह्ममुदाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2025735, "chapter_id": 1553, "verse_number": "३-१९१-२८", "content_sanskrit": "विश्वं हि ब्रह्मभवने सर्वतः परिवर्तते।\nलोकानां मनुजवन्याघ्र प्रलयं तं विदुर्बुधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2025736, "chapter_id": 1553, "verse_number": "३-१९१-२९", "content_sanskrit": "अल्पावशिष्टे तु तदा युगान्ते भरतर्षभ।\nसहस्रान्ते नराः सर्वे प्रायशोऽनृतवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2025737, "chapter_id": 1553, "verse_number": "३-१९१-३०", "content_sanskrit": "यज्ञप्रतिनिधिः पार्थ दानप्रतिनिधिस्तथा।\nव्रतप्रतिनिधिश्चैव तस्मिन्काले प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2025738, "chapter_id": 1553, "verse_number": "३-१९१-३१", "content_sanskrit": "ब्राह्मणाः शूद्रकर्माणस्तथा शूद्रा धनार्जकाः।\nक्षत्रधर्मेण वाऽप्यत्र वर्तयन्ति युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2025739, "chapter_id": 1553, "verse_number": "३-१९१-३२", "content_sanskrit": "निवृत्तयज्ञस्वाध्याया दण्डाजिनविवर्जिताः।\nब्राह्मणा सर्वभक्षाश्च भविष्यन्ति कलौ युगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2025740, "chapter_id": 1553, "verse_number": "३-१९१-३३", "content_sanskrit": "अजपा ब्राह्मणास्तात शूद्रा जपपरायणाः।\nविपरीते तदा लोके पूर्वरूपं क्षयस्य तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2025741, "chapter_id": 1553, "verse_number": "३-१९१-३४", "content_sanskrit": "बहवो म्लेच्छराजानः पृथिव्यां मनुजाधिप।\nमृषानुशासिनः पापा मृषावादपरायणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2025742, "chapter_id": 1553, "verse_number": "३-१९१-३५", "content_sanskrit": "आन्ध्राः शकाः पुलिन्दाश्च यवनाश्च नराधिपाः।\nकाम्भोजा बाह्लिकाः शूरास्तथाऽऽभीरा नरोत्तमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2025743, "chapter_id": 1553, "verse_number": "३-१९१-३६", "content_sanskrit": "न तदा ब्राह्मणः कश्चित्स्वधर्ममुपजीवति।\nक्षत्रियाश्चापि वैश्याश्च विकर्मस्था नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2025744, "chapter_id": 1553, "verse_number": "३-१९१-३७", "content_sanskrit": "अल्पायुषः स्वल्पबलाः स्वल्पवीर्यपराक्रमाः।\nअल्पसाराल्पदेहाश्च तथा सत्याल्पभाषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2025745, "chapter_id": 1553, "verse_number": "३-१९१-३८", "content_sanskrit": "बहुशून्या जनपदा मृगव्यालावृता दिशः।\nयुगान्ते समनुप्राप्ते वृथा च ब्रह्मवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2025746, "chapter_id": 1553, "verse_number": "३-१९१-३९", "content_sanskrit": "भोवादिनस्तथा शूद्रा ब्राह्मणाश्चार्यवादिनः।\nयुगान्ते मनुजव्याघ्र भवन्ति बहुजन्तवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2025747, "chapter_id": 1553, "verse_number": "३-१९१-४०", "content_sanskrit": "न तथा घ्राणयुक्ताश्च सर्वगन्धा विशांपते।\nरसाश्च मनुजव्याघ्र न तथा स्वादुयोगिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2025748, "chapter_id": 1553, "verse_number": "३-१९१-४१", "content_sanskrit": "बहुप्रजा ह्रस्वदेहा शीलाचारविवर्जिताः।\nमुखेभगाः स्त्रियो राजन्भविष्यन्ति युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2025749, "chapter_id": 1553, "verse_number": "३-१९१-४२", "content_sanskrit": "अट्टशूला जनपदाः शिवशूलाश्चतुष्पथाः।\nकेशशूलाः स्त्रियो राजन्भविष्यन्ति युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2025750, "chapter_id": 1553, "verse_number": "३-१९१-४३", "content_sanskrit": "अल्पक्षीरास्तथा गावो भविष्यन्ति जनाधिप।\nअल्पपुष्पफलाश्चापि पादपा बहुवायसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2025751, "chapter_id": 1553, "verse_number": "३-१९१-४४", "content_sanskrit": "ब्रह्मवध्यानुलिप्तानां तथा मिथ्याभिशंसिनाम्।\nनृपाणां पृथिवीपाल प्रतिगृह्णन्ति वै द्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2025752, "chapter_id": 1553, "verse_number": "३-१९१-४५", "content_sanskrit": "लोभमोहपरीताश्च मिथ्याधर्मध्वजावृताः।\nभिक्षार्थं पृथिवीपाल चञ्चूर्यन्ते द्विजैर्दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2025753, "chapter_id": 1553, "verse_number": "३-१९१-४६", "content_sanskrit": "कराभारभयाद्भीता गृहस्थाः परिमोषकाः।\nमुनिच्छद्माकृतिच्छन्ना वाणिज्यमुपभुञ्जते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2025754, "chapter_id": 1553, "verse_number": "३-१९१-४७", "content_sanskrit": "मित्या च नखरोमाणि धारयन्ति तदा द्विजाः।\nअर्थलोभान्नरव्याघ्र वृथा च ब्रह्मचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2025755, "chapter_id": 1553, "verse_number": "३-१९१-४८", "content_sanskrit": "आश्रमेषु वृथाचार पारपा गुरुतल्पगाः।\nऐहलौकिकमीहन्ते मांसशोणितवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2025756, "chapter_id": 1553, "verse_number": "३-१९१-४९", "content_sanskrit": "`पारलौकिककार्येषु प्रमत्ता भृशनास्तिकाः।\nबहुपाषण्डसंकीर्णाः परान्नगुणवादिनः।\nआश्रमा मनुजव्याघ्र न भवन्ति युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2025757, "chapter_id": 1553, "verse_number": "३-१९१-५०", "content_sanskrit": "यथर्तुवर्षी भगवान्न तथा पाकशासनः।\nन चापि सर्वभीजानि सम्यग्रोहन्ति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2025758, "chapter_id": 1553, "verse_number": "३-१९१-५१", "content_sanskrit": "फलं धर्मस्य राजेन्द्र सर्वत्र परिहीयते।\nहिंसाभिरामश्च जनस्तथा संपद्यतेऽशुचिः।\nअधर्मफलमत्यर्थं तदा भवति चानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2025759, "chapter_id": 1553, "verse_number": "३-१९१-५२", "content_sanskrit": "तदा च पृथिवीपाल यो भवेद्धर्मसंयुतः।\nअल्पायुः स हि मन्तव्यो न हि धर्मोस्ति कश्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2025760, "chapter_id": 1553, "verse_number": "३-१९१-५३", "content_sanskrit": "भूयिष्ठं कूटमानैश्च पण्यं विक्रीणते जनाः।\nवणिजश्च नरव्याघ्र बहुमाया भवन्त्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2025761, "chapter_id": 1553, "verse_number": "३-१९१-५४", "content_sanskrit": "धर्मिष्ठाः परिहीयन्ते पापीयान्वर्धते जनः।\nधर्मस्य बलहानिः स्यादधर्मश्च बलायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2025762, "chapter_id": 1553, "verse_number": "३-१९१-५५", "content_sanskrit": "अल्पायुषो दरिद्राश्च धर्मिष्ठा मानवास्तथा।\nदीर्घायुषः समृद्धाश्च विधर्माणो युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2025763, "chapter_id": 1553, "verse_number": "३-१९१-५६", "content_sanskrit": "नगराणआं विहारेषु विधर्माणो युगक्षये।\nअधर्मिष्ठैरुपायैश् प्रजा व्यवहरन्त्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2025764, "chapter_id": 1553, "verse_number": "३-१९१-५७", "content_sanskrit": "संचयेन तथाऽल्पेन भवन्त्याढ्यमदान्विताः।\nधनं विश्वासतो न्यस्तं मिथो भूयिष्ठशो नराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2025765, "chapter_id": 1553, "verse_number": "३-१९१-५८", "content_sanskrit": "हर्तुं व्यवसिता राजन्पापाचारसमनविताः।\nनैतदस्तीति मनुजा वर्तन्ते निरपत्रपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2025766, "chapter_id": 1553, "verse_number": "३-१९१-५९", "content_sanskrit": "पुरुषादानि सत्वानि पक्षिणोऽथ मृगास्तथा।\nनगराणां विहारेषु चैत्येष्वपि च शेरते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2025767, "chapter_id": 1553, "verse_number": "३-१९१-६०", "content_sanskrit": "सप्तवर्षाष्टवर्षाश्च स्त्रियो गर्भधरा नृप।\nदशद्वादशवर्षाणां पुंसां पुत्रः प्रजायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2025768, "chapter_id": 1553, "verse_number": "३-१९१-६१", "content_sanskrit": "भवन्ति षोडशे वर्षे नराः पलितिनस्तथा।\nआयुःक्षयो मनुष्याणां क्षिप्रमेव प्रपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2025769, "chapter_id": 1553, "verse_number": "३-१९१-६२", "content_sanskrit": "क्षीणायुषो महाराज तरुणा वृद्धशीलिनः।\nतरुणानां च यच्छीलं तद्वृद्धेषु प्रजायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2025770, "chapter_id": 1553, "verse_number": "३-१९१-६३", "content_sanskrit": "विपरीतास्तदा नार्यो वञ्चयित्वाऽर्हतः पतीन्।\nव्युच्चरन्त्यपि दुःशीला दासैः पशुभिरेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2025771, "chapter_id": 1553, "verse_number": "३-१९१-६४", "content_sanskrit": "वीरपत्न्यस्तथा नार्यः संश्रयन्ति नरान्नृप।\nभर्तारमपि जीवन्तमन्यान्व्यभिचरन्त्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2025772, "chapter_id": 1553, "verse_number": "३-१९१-६५", "content_sanskrit": "तस्मिन्युगसहस्रान्ते संप्राप्ते चायुषः क्षये।\nअनावृष्टिर्महाराज जायते बहुवार्षिकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2025773, "chapter_id": 1553, "verse_number": "३-१९१-६६", "content_sanskrit": "ततस्तान्यल्पसाराणि सत्वानि क्षुधितानि वै।\nप्रलयं यान्ति भूयिष्ठं पृथिव्यां पृथिवीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2025774, "chapter_id": 1553, "verse_number": "३-१९१-६७", "content_sanskrit": "ततो दिनकरैर्दीप्तैः सप्तभिर्मनुजाधिप।\nपीयते सलिलं सर्वं समुद्रेषु सरित्सु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2025775, "chapter_id": 1553, "verse_number": "३-१९१-६८", "content_sanskrit": "यच्च रकाष्ठं तृणं चापि शुष्कं चार्द्रं च भारत।\nसर्वं तद्भस्मसाद्भूतं दृश्यते भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2025776, "chapter_id": 1553, "verse_number": "३-१९१-६९", "content_sanskrit": "ततः संवर्तको वह्निर्वायुना सह भारत।\nलोकमाविशते पूर्वमादित्यैरुपशोषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2025777, "chapter_id": 1553, "verse_number": "३-१९१-७०", "content_sanskrit": "ततः स पृथिवीं भित्त्वा प्रविश्य च रसातलम्।\nरदेवदानवयक्षाणां भयं जनयते महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2025778, "chapter_id": 1553, "verse_number": "३-१९१-७१", "content_sanskrit": "निरदहन्नागलोकं च यच्च किंचित्क्षिताविह।\nअधस्तात्पृथिवीपाल सर्वं नाशयते क्षणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2025779, "chapter_id": 1553, "verse_number": "३-१९१-७२", "content_sanskrit": "ततो योजनविंशानां सहस्राणि शतानि च।\nनिर्दहत्यशिवो वायुः स च संवर्तकोऽनलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2025780, "chapter_id": 1553, "verse_number": "३-१९१-७३", "content_sanskrit": "सदेवासुरगन्धर्वं सयक्षोरगराक्षसम्।\nततो दहति दीप्तः स सर्वमेव जगद्विभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2025781, "chapter_id": 1553, "verse_number": "३-१९१-७४", "content_sanskrit": "ततो गजकुलप्रख्यास्तजिन्मालाविभूषिताः।\nउत्तिष्ठन्ति महामेघा नभस्यद्भुतदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2025782, "chapter_id": 1553, "verse_number": "३-१९१-७५", "content_sanskrit": "केचिन्नीलोत्पलश्यामाः केचित्कुमुदसन्निभाः।\nकेचित्किञ्जल्कसंकाशाः केचित्पीताः पयोधराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2025783, "chapter_id": 1553, "verse_number": "३-१९१-७६", "content_sanskrit": "केचिद्धारिद्रसंकाशाः कारण्डवनिभास्तथा।\nकेचित्कमलपत्राभाः केचिद्धिङ्गुलसप्रभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2025784, "chapter_id": 1553, "verse_number": "३-१९१-७७", "content_sanskrit": "केचित्पुरवराकाराः केचिद्गजकुलोपमाः।\nकेचिदञ्जनसंकाशाः केचिन्मकरसन्निभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2025785, "chapter_id": 1553, "verse_number": "३-१९१-७८", "content_sanskrit": "विद्युन्मालापिनद्धाङ्गाः समुत्तिष्ठन्ति वै घनाः।\nघोररूपा महाराज घोरस्वननिनादिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2025786, "chapter_id": 1553, "verse_number": "३-१९१-७९", "content_sanskrit": "ततो जलघराः सर्वं व्याप्नुवनति नभस्तलम्।\n`गर्जन्तः पृथिवीपाल पृथिवीधरसन्निभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2025787, "chapter_id": 1553, "verse_number": "३-१९१-८०", "content_sanskrit": "तैरियं पृथिवी सर्वा सपर्वतवनाकरा।\nआपूर्यते महाराज सलिलौघपरिप्लुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2025788, "chapter_id": 1553, "verse_number": "३-१९१-८१", "content_sanskrit": "ततस्ते जलदा घोरा राविणः पुरुषर्षभ।\nपर्वतान्प्लावयन्त्याशु चोदिताः परमेष्ठिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2025789, "chapter_id": 1553, "verse_number": "३-१९१-८२", "content_sanskrit": "वर्षमाणा महत्तोयं पूरयन्तो वसुंधराम्।\nसुघोरमशिवं रौद्रं नाशयनति च पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2025790, "chapter_id": 1553, "verse_number": "३-१९१-८३", "content_sanskrit": "ततो द्वादशवर्षाणि पयोदास्त उपप्लवे।\nधाराभिः पूरयन्तो वै चोद्यमाना महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2025791, "chapter_id": 1553, "verse_number": "३-१९१-८४", "content_sanskrit": "ततः समुद्रः स्वां वेलामतिक्रामति भारत।\nपर्वताश्च विदीर्यन्ते मही चापि विदीर्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2025792, "chapter_id": 1553, "verse_number": "३-१९१-८५", "content_sanskrit": "सर्वतः सहसा भ्रान्तास्ते पयोदा नभस्तलम्।\nसंवेष्टयित्वा नश्यन्ति वायुवेगपराहताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2025793, "chapter_id": 1553, "verse_number": "३-१९१-८६", "content_sanskrit": "कततस्तं मारुतं घोरं स्वयंभूर्मनुजाधिप।\nआदिः पद्मालयो देवः पीत्वा स्वपिति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2025794, "chapter_id": 1553, "verse_number": "३-१९१-८७", "content_sanskrit": "तस्मिन्नेकार्णवे घोरे नष्टे स्थावरजङ्गमे।\nनष्टे देवासुरगणए यक्षराक्षसवर्जिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2025795, "chapter_id": 1553, "verse_number": "३-१९१-८८", "content_sanskrit": "निर्मनुष्ये महीपाल निःश्वापदमहीरुहे।\nअनन्तरिक्षे लोकेऽस्मिन्भ्रमाम्येकोऽहमातुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2025796, "chapter_id": 1553, "verse_number": "३-१९१-८९", "content_sanskrit": "एकार्णवे जले घोरे विचरन्पार्थिवोत्तम।\nअपश्यन्सर्वभूतानि वैक्लब्यमगमं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2025797, "chapter_id": 1553, "verse_number": "३-१९१-९०", "content_sanskrit": "ततः सुदीर्घं गत्वाऽहं प्लवमानो धराधिप।\nश्रान्तः क्वचिन्न शरणं लब्धवानस्म्यतन्द्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2025798, "chapter_id": 1553, "verse_number": "३-१९१-९१", "content_sanskrit": "ततः कदाचित्पश्यामि तस्मिन्सलिलसंनिघौ।\nन्यग्रोधं सुमहान्तं वै विशालं पृथिवीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2025799, "chapter_id": 1553, "verse_number": "३-१९१-९२", "content_sanskrit": "शाखायां तस्य वृक्षस्य विस्तीर्णायां नराधिप।\nपर्यङ्के पृथिवीपाल दिव्यास्तरणसंस्तृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2025800, "chapter_id": 1553, "verse_number": "३-१९१-९३", "content_sanskrit": "उपविष्टं महाराज पद्मेन्दुसदृशाननम्।\nफुल्लपद्मविशालाक्षं बालं पश्यामि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2025801, "chapter_id": 1553, "verse_number": "३-१९१-९४", "content_sanskrit": "ततो मे पृतिवीपाल विस्मयः सुमहाभूत्।\nकथं त्वयं शिशुः शेते लोके नाशमुपागते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2025802, "chapter_id": 1553, "verse_number": "३-१९१-९५", "content_sanskrit": "तपसा चिन्तयंश्चापि तं शिशुं नोपलक्षये।\nभूतं भव्यं भविष्यं च जानन्नपि नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2025803, "chapter_id": 1553, "verse_number": "३-१९१-९६", "content_sanskrit": "अतसीपुष्पवर्णाभः श्रीवत्सकृतभूषणः।\nसाक्षाल्लक्ष्म्या इवावास स तदा प्रतिभाति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2025804, "chapter_id": 1553, "verse_number": "३-१९१-९७", "content_sanskrit": "ततो मामब्रवीद्बालः स पद्मनिभलोचनः।\nश्रीवत्सधारी द्युतिमान्वाक्यं श्रुतिसुखावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2025805, "chapter_id": 1553, "verse_number": "३-१९१-९८", "content_sanskrit": "जानामि त्वां परिश्रान्तं तात विश्रामकाङ्क्षिणम्।\nमार्कण्डेय महासत्वं यावदिच्छसि भार्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2025806, "chapter_id": 1553, "verse_number": "३-१९१-९९", "content_sanskrit": "अभ्यन्तरं शरीरं मे प्रविश्य मुनिसत्तम।\nआस्खेह विहितो वासः प्रसादस्ते कृतो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2025807, "chapter_id": 1553, "verse_number": "३-१९१-१००", "content_sanskrit": "ततो बालेन तेनैव मुक्तस्यासीत्तदा मम।\nनिर्वेदो जीविते दीर्घे मनुष्यत्वे च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2025808, "chapter_id": 1553, "verse_number": "३-१९१-१०१", "content_sanskrit": "ततो बालेन तेनास्यं सहसा विवृतं कृतम्।\nतस्याहमवशो वक्रे दैवयोगात्प्रवेशितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2025809, "chapter_id": 1553, "verse_number": "३-१९१-१०२", "content_sanskrit": "ततः प्रविष्टस्तत्कुक्षिं सहसा मनुजाधिप।\nसराष्ट्रनगराकीर्णां कृत्स्नां पश्यामि मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2025810, "chapter_id": 1553, "verse_number": "३-१९१-१०३", "content_sanskrit": "गङ्गां शतद्रुं सीतां च यमुनामथ कौशिकीम्।\nचर्मण्वतींवेत्रवतीं चन्द्रभागां सरस्वतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2025811, "chapter_id": 1553, "verse_number": "३-१९१-१०४", "content_sanskrit": "सिन्धुं चैव विपाशां च नदीं गोदावरीमपि।\nवस्वोकसारां नलिनीं नर्मदां चैव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2025812, "chapter_id": 1553, "verse_number": "३-१९१-१०५", "content_sanskrit": "नदीं ताम्रां च वेणां च पुण्यतोयां शुभावहाम्।\nसुवेणां कृष्णवेणां च इरामां च महानदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2025813, "chapter_id": 1553, "verse_number": "३-१९१-१०६", "content_sanskrit": "वितस्तां च महाराज कावेरीं च महानदीम्।\n`तुङ्गभद्रां कृष्णवेणीं कमलां च महानदीम्।\nशोणं च पुरुषव्याघ्र विशल्यां किंपुनामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2025814, "chapter_id": 1553, "verse_number": "३-१९१-१०७", "content_sanskrit": "एताश्चान्याश्च नद्योऽहं पृथिव्यां या नरोत्तम।\nपरिक्रामन्प्रपश्यामि तस्य कुक्षौ महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2025815, "chapter_id": 1553, "verse_number": "३-१९१-१०८", "content_sanskrit": "ततः समुद्रं पश्मामि यादोगणनिषेवितम्।\nरत्नाकरममित्रघ्न पयसोनिधिमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2025816, "chapter_id": 1553, "verse_number": "३-१९१-१०९", "content_sanskrit": "ततः पश्यामि गगनं चन्द्रसूर्यविराजितम्।\nजाज्वल्यमानं तेजोभिः पावकार्कसमप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2025817, "chapter_id": 1553, "verse_number": "३-१९१-११०", "content_sanskrit": "पश्यामि च महीं राजन्काननैरुपशोभिताम्।\n`सपर्वतवनद्वीपां निम्नगाशतसंकुलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2025818, "chapter_id": 1553, "verse_number": "३-१९१-१११", "content_sanskrit": "यजन्ते हि ततो राजन्ब्राह्मणा बहुभिर्मखैः।\nक्षत्रियाश् प्रवर्तन्ते सर्ववर्णानुरञ्जनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2025819, "chapter_id": 1553, "verse_number": "३-१९१-११२", "content_sanskrit": "वैश्याः कृषिं यथान्यायं कारयन्ति नराधिप।\nशुश्रूषायां च निरता द्विजानां वृषलास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2025820, "chapter_id": 1553, "verse_number": "३-१९१-११३", "content_sanskrit": "ततः परिपतन्राजंस्तस्य कुक्षौ महात्मनः।\nहिमवन्तं च पश्यामि हेमकूटं च पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2025821, "chapter_id": 1553, "verse_number": "३-१९१-११४", "content_sanskrit": "निषधं चापि पश्यामि श्वेतं च रजतान्वितम्।\nपश्यामि च महीपाल पर्वतं गन्धमादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2025822, "chapter_id": 1553, "verse_number": "३-१९१-११५", "content_sanskrit": "मन्दरं मनुजव्याघ्र नीलं चापि महागिरिम्।\nपश्यामि च महाराज मेरु कनकपर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2025823, "chapter_id": 1553, "verse_number": "३-१९१-११६", "content_sanskrit": "महेन्द्रं चैव पश्यामि विन्ध्यं च गिरिमुत्तमम्।\nमलयं चापि पश्यामि पारियात्रं च पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2025824, "chapter_id": 1553, "verse_number": "३-१९१-११७", "content_sanskrit": "एते चान्ये च बहवो यावन्तः पृथिवीधराः।\nतस्योदरे मया दृष्टाः सर्वे रत्नविभूषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2025825, "chapter_id": 1553, "verse_number": "३-१९१-११८", "content_sanskrit": "सिंहान्व्याघ्रान्वराहांश्च पश्यामि मनुजाधिप।\nपृथिव्यां यानि चान्यानि सत्त्वानि जगतीपते।\nतानि सर्वाण्यहं तत्र पश्यन्पर्यचरं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2025826, "chapter_id": 1553, "verse_number": "३-१९१-११९", "content_sanskrit": "कुक्षौ तस् नरव्याघ्र प्रविष्टः संचरन्दिशः।\nशक्रादींश्चापि पश्यामि कृत्स्नान्देवगणानहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2025827, "chapter_id": 1553, "verse_number": "३-१९१-१२०", "content_sanskrit": "साध्यान्रुद्रांस्तथाऽऽदित्यान्गुह्यकान्पितरस्तथा।\nसर्पान्नागान्सुपर्णांश्च वसूनप्यश्विनावपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2025828, "chapter_id": 1553, "verse_number": "३-१९१-१२१", "content_sanskrit": "गन्धर्वाप्सरसो यक्षानृषींश्चैव महीपते।\nदैत्यदानवसङ्घांश्च नागांश्च मनुजाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2025829, "chapter_id": 1553, "verse_number": "३-१९१-१२२", "content_sanskrit": "सिंहिकातनयांश्चापि ये चान्ये सुरशत्रवः।\nयच्च किंचिन्मया लोके दृष्टं स्थावरजङ्गमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2025830, "chapter_id": 1553, "verse_number": "३-१९१-१२३", "content_sanskrit": "सर्वं पश्याम्यहं राजंस्तस्य कुक्षौ महात्मनः।\nत्वरमाणः फलाहारः कृत्स्नं जगदिदं विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2025831, "chapter_id": 1553, "verse_number": "३-१९१-१२४", "content_sanskrit": "अन्तःशरीरे तस्याहं वर्षाणामधिकं शतम्। ३-१९१-b१२४ न च पश्यामि यस्याहं देहस्यान्तं कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2025832, "chapter_id": 1553, "verse_number": "३-१९१-१२५", "content_sanskrit": "सततं धावमानश्च चिन्तयानो विशांपते।\n`भ्रमंस्तत्र महीपाल यदा वर्षगणान्बहून्।\nआसादयामि नैवान्तं तस्य राजन्महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2025833, "chapter_id": 1553, "verse_number": "३-१९१-१२६", "content_sanskrit": "ततस्तमेव शरणं गतोस्मि विधिवत्तदा।\nवरेण्यं वरदं देवं मनसा कर्मणैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2025834, "chapter_id": 1553, "verse_number": "३-१९१-१२७", "content_sanskrit": "ततोऽहं सहसा राजन्वायुवेगेन निःसृतः।\nमहात्मनो मुखात्तस्य विवृतात्पुरुषोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2025835, "chapter_id": 1553, "verse_number": "३-१९१-१२८", "content_sanskrit": "ततस्तस्यैव शाखायां न्यग्रोधस्य विशांपते।\nआस्ते मनुजशार्दूल कृत्स्नमादाय वै जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2025836, "chapter_id": 1553, "verse_number": "३-१९१-१२९", "content_sanskrit": "ते नैव बालवेषेण श्रीवत्सकृतलक्षणम्।\nआसीनं तं नरव्याघ्र पश्याम्यमिततेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2025837, "chapter_id": 1553, "verse_number": "३-१९१-१३०", "content_sanskrit": "ततो मामब्रवीद्बालः स प्रीतः प्रहसन्निव।\nश्रीवत्सधारी द्युतिमान्पीतवासा महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2025838, "chapter_id": 1553, "verse_number": "३-१९१-१३१", "content_sanskrit": "अपीदानीं शरीरेऽस्मिन्मामके मुनिसत्तम।\nउषितस्त्वं परिश्रान्तो मार्कण्डेय ब्रवीहि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2025839, "chapter_id": 1553, "verse_number": "३-१९१-१३२", "content_sanskrit": "मुहूर्तादथ मे दृष्टिः प्रादुर्भूता पुनर्नवा।\nमायानिर्मुक्तमात्मनमपश्यं लब्धचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2025840, "chapter_id": 1553, "verse_number": "३-१९१-१३३", "content_sanskrit": "तस्य ताम्रतलौ तात चरणौ सुप्रतिष्ठितौ।\nसुजातौ मृदुरक्ताभिरङ्गुलीभिर्विराजितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2025841, "chapter_id": 1553, "verse_number": "३-१९१-१३४", "content_sanskrit": "प्रयत्नेन मया मूर्ध्ना गृहीत्वा ह्यभिवनदितौ।\nदृष्ट्वाऽपरिमितं तस् प्रभावममितौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2025842, "chapter_id": 1553, "verse_number": "३-१९१-१३५", "content_sanskrit": "विनयेनाञ्जलिं कृत्वाप्रयत्नेनोपगम्य ह।\nदृष्टो मया स भूतात्मा देवः कमललोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2025843, "chapter_id": 1553, "verse_number": "३-१९१-१३६", "content_sanskrit": "तमहं प्राञ्जलिर्भूत्वा नमस्कृत्येदमब्रवम्।\nज्ञातुमिच्छामि देव त्वां मायां चैतां तवोत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2025844, "chapter_id": 1553, "verse_number": "३-१९१-१३७", "content_sanskrit": "आस्येनानुप्रविष्टोऽहं शरीरे भगवंस्तव।\nदृष्टवानखिलाँल्लोकान्समस्तान्जठरे हि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2025845, "chapter_id": 1553, "verse_number": "३-१९१-१३८", "content_sanskrit": "तव देव शरीरस्था देवदानवराक्षसाः।\nयक्षगन्धर्वनागाश्च जगत्स्थावरजङ्गमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2025846, "chapter_id": 1553, "verse_number": "३-१९१-१३९", "content_sanskrit": "त्वत्प्रसादाच्च मे देव स्मृतिर्न परिहीयते।\nद्रुतमन्तःशरीरे ते सततं परिवर्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2025847, "chapter_id": 1553, "verse_number": "३-१९१-१४०", "content_sanskrit": "निर्गतोऽहमकामस्तु इच्छया ते महाप्रभो।\nयतिष्ये पुण्डरीकाक्ष ज्ञातुं त्वाऽहमनिन्दितं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2025848, "chapter_id": 1553, "verse_number": "३-१९१-१४१", "content_sanskrit": "इह भूत्वा शिशुः साक्षात्किं भवानवतिष्ठते।\nपीत्वा जगदिदं सर्वमेतदाख्यातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2025849, "chapter_id": 1553, "verse_number": "३-१९१-१४२", "content_sanskrit": "किमर्थं च जगत्सर्वं शरीरस्थं तवानघ।\nकियन्तं च त्वया कालमिह स्थेयमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2025850, "chapter_id": 1553, "verse_number": "३-१९१-१४३", "content_sanskrit": "एतदिच्छामि देवेश श्रोतुं ब्राह्मणकाम्यया।\nत्वत्तः कमलपत्राक्षं विस्तरेण यथातथम्।\nमहद्ध्येतदचिन्त्यं च यदहं दृष्टवान्प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2025851, "chapter_id": 1553, "verse_number": "३-१९१-१४४", "content_sanskrit": "इत्युक्तः स मया श्रीमान्देवदेवो महाद्युतिः।\nसान्त्वयन्मामिदं वाक्यमुवाच वदतांवरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2025852, "chapter_id": 1553, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मर्कण्डेयसमास्यापर्वणि एकनवत्यधिकशततमोऽध्यायः ॥ १९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}]