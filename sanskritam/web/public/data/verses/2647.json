[{"id": 2077660, "chapter_id": 2647, "verse_number": "१२-१५२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077661, "chapter_id": 2647, "verse_number": "१२-१५२-१", "content_sanskrit": "कच्चित्पितामहेनासीच्छ्रुवं वा दृष्टमेव च।\nकच्चिन्मर्त्यो मृतो राजन्पुनरुज्जीवितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077662, "chapter_id": 2647, "verse_number": "१२-१५२-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077663, "chapter_id": 2647, "verse_number": "१२-१५२-२", "content_sanskrit": "शृणु पार्थ यथावृत्तमितिहासं पुरातनम्।\nगृध्रजम्बुकसंवादं यो वृत्तो वैदिशे पुरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077664, "chapter_id": 2647, "verse_number": "१२-१५२-३", "content_sanskrit": "कस्यचिद्ब्राह्मणस्यासीद्दुःखलब्धः सुतो मृतः।\nबाल एव विशालाक्षो बालग्रहनिपीडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077665, "chapter_id": 2647, "verse_number": "१२-१५२-४", "content_sanskrit": "दुःखिताः केचिदादाय बालमप्राप्तयोवनम्।\nकुलसर्वस्वभूतं वै रुदन्तः शोककर्शिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077666, "chapter_id": 2647, "verse_number": "१२-१५२-५", "content_sanskrit": "बालं मृतं गृहीत्वाऽथ श्मशानाभिमुखाः स्थिताः।\nअङ्गेनाङ्गं समाक्रस्य रुरुदुर्भृशदुःखिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077667, "chapter_id": 2647, "verse_number": "१२-१५२-६", "content_sanskrit": "शोचन्तस्तस्य पूर्वोक्तान्भाषितांश्चासकृत्पुनः।\nतं बालं भूतले क्षिप्य प्रतिगन्तुं न शक्नुयुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077668, "chapter_id": 2647, "verse_number": "१२-१५२-७", "content_sanskrit": "तेषां रुदितशब्देन गृध्रोऽभ्येत्य वचोऽब्रवीत्।\nप्रेतात्मकमिमंकाले त्यक्त्वा गच्छत माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077669, "chapter_id": 2647, "verse_number": "१२-१५२-८", "content_sanskrit": "इह पुंसां सहस्राणि स्त्रीसहस्राणि चैव ह।\nसमानीतानि कालेन हित्वा वै यान्ति बान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077670, "chapter_id": 2647, "verse_number": "१२-१५२-९", "content_sanskrit": "संपश्यत जगत्सर्वं सुखदुःखैरधिष्ठितम्।\nसंयोगो विप्रयोगश्च पर्यायेणोपलभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077671, "chapter_id": 2647, "verse_number": "१२-१५२-१०", "content_sanskrit": "गृहीत्वा ये च गच्छन्ति येऽनुयान्ति च तान्मृतान्।\nतेऽप्यायुषः प्रमाणेन स्वेन गच्छन्ति जन्तवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077672, "chapter_id": 2647, "verse_number": "१२-१५२-११", "content_sanskrit": "अलं स्थित्वा श्मशानेऽस्मिन्गृध्रगोमायुसंकुले।\nकङ्कालबहुले घोरे सर्वप्राणिभयंकरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077673, "chapter_id": 2647, "verse_number": "१२-१५२-१२", "content_sanskrit": "न पुनर्जीवितः कश्चित्कालधर्ममुपागतः।\nप्रियो वा यदि वा द्वेष्यः प्राणिनां गतिरीदृशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077674, "chapter_id": 2647, "verse_number": "१२-१५२-१३", "content_sanskrit": "सर्वेण खलु मर्तव्यं मर्त्यलोके प्रसूयता।\nकृतान्तविहिते मार्गे मृतं को जीवयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077675, "chapter_id": 2647, "verse_number": "१२-१५२-१४", "content_sanskrit": "दिशान्तोपचितो यावदस्तं गच्छति भास्करः।\nगम्यतां स्वमधिष्ठानं सुतस्नेहं विसृज्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077676, "chapter_id": 2647, "verse_number": "१२-१५२-१५", "content_sanskrit": "ततो गृध्रवचः श्रुत्वा विक्रोशन्तस्तदा नृप।\nबान्धवास्तेऽभ्यगच्छन्त पुत्रमुत्सृज्य भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077677, "chapter_id": 2647, "verse_number": "१२-१५२-१६", "content_sanskrit": "विनिश्चित्याथ च तदा विक्रोशन्तस्ततस्ततः।\n[मृत इत्येव गच्छन्तो निराशास्तस्य दर्शने॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077678, "chapter_id": 2647, "verse_number": "१२-१५२-१७", "content_sanskrit": "निश्चितार्थाश्च ते सर्वे संत्यजन्तः स्वमात्मजम्।\nनिराशा जीविते तस्य मार्गमावृत्य धिष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2077679, "chapter_id": 2647, "verse_number": "१२-१५२-१८", "content_sanskrit": "ध्वाङ्क्षपक्षसवर्णस्तु बिलान्निःसृत्य जम्बुकः।\nगच्छमानान्स्म तानाह निर्घृणाः खलु मानुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2077680, "chapter_id": 2647, "verse_number": "१२-१५२-१९", "content_sanskrit": "आदित्योऽयं स्थितो मूढाः स्नेहं कुरुत मा भयम्।\nबहुरूपो मुहूर्ताच्च जीवेदपि च बालकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2077681, "chapter_id": 2647, "verse_number": "१२-१५२-२०", "content_sanskrit": "दर्भान्भूमौ विनिक्षिप्य पुत्रस्नेहविनाकृताः।\nश्मशाने सुतमुत्सृज्य कस्माद्गच्छत निर्घृणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2077682, "chapter_id": 2647, "verse_number": "१२-१५२-२१", "content_sanskrit": "न वोऽस्त्यस्मिन्सुते स्नेहो बाले मधुरभाषिणि।\nयस्य भाषितमात्रेण प्रसादमधिगच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2077683, "chapter_id": 2647, "verse_number": "१२-१५२-२२", "content_sanskrit": "न पश्यध्वं सुतस्नेहो यादृशः पशुपक्षिणाम्।\nन तेषां धारयित्वा तान्कश्चिदस्ति फलागमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2077684, "chapter_id": 2647, "verse_number": "१२-१५२-२३", "content_sanskrit": "चतुष्पात्पक्षिकीटानां प्राणिनां स्नेहसङ्गिनाम्।\nपरलोकगतिस्थानां मुनियज्ञक्रियामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2077685, "chapter_id": 2647, "verse_number": "१२-१५२-२४", "content_sanskrit": "तेषां पुत्राभिरामाणामिह लोके परत्र च।\nन गुणो दृश्यते कश्चित्प्रजाः संधारयन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2077686, "chapter_id": 2647, "verse_number": "१२-१५२-२५", "content_sanskrit": "अपश्यतां प्रियान्पुत्रान्येषां शोको न तिष्ठति।\nन ते पोषणसंप्रीता मातापितर एव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2077687, "chapter_id": 2647, "verse_number": "१२-१५२-२६", "content_sanskrit": "मानुषाणां कुतः स्नेहो येषां शोको न विद्यते।\nइमं कुलकरं पुत्रं त्यक्त्वा क्व नु गमिष्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2077688, "chapter_id": 2647, "verse_number": "१२-१५२-२७", "content_sanskrit": "चिरं मुञ्चत बाष्पं च चिरं स्नेहेनन पश्यत।\nएवंविधानि हीष्टानि दुस्त्यजानि विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2077689, "chapter_id": 2647, "verse_number": "१२-१५२-२८", "content_sanskrit": "क्षीणस्याथामिशस्तस्य श्मशानाभिमुखस्य च।\nबान्धवा यत्र तिष्ठति तत्रान्यो नाधितिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2077690, "chapter_id": 2647, "verse_number": "१२-१५२-२९", "content_sanskrit": "सर्वस्य दयिताः प्राणाः सर्वः स्नेहं च विन्दति।\nतिर्यग्योनिष्वपि संतां स्नेहं पश्यत यादृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2077691, "chapter_id": 2647, "verse_number": "१२-१५२-३०", "content_sanskrit": "त्यक्त्वा कथं गच्छथेमं पद्मलोलायतेक्षणम्।\nयथा नवोद्वाहकृतं स्नानमाल्यविभूषितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2077692, "chapter_id": 2647, "verse_number": "१२-१५२-३१", "content_sanskrit": "जम्बुकस्य वचः श्रुत्वा कृपणं परिदेवतः।\nन्यवर्तन्त तदा सर्वे बालार्थं ते स्म मानुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2077693, "chapter_id": 2647, "verse_number": "१२-१५२-३२x", "content_sanskrit": "गृध्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2077694, "chapter_id": 2647, "verse_number": "१२-१५२-३२", "content_sanskrit": "अहो बत नृशंसेन जम्बुकेनाल्पमेधसा।\nक्षुद्रेणोक्ता हीनसत्वा मानुषाः किं निवर्तथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2077695, "chapter_id": 2647, "verse_number": "१२-१५२-३३", "content_sanskrit": "पञ्चभूतपरित्यक्तं शुष्कं काष्ठत्वमागतम्।\nकस्माच्छोचथ निश्चेष्टमात्मानं किं न शोचथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2077696, "chapter_id": 2647, "verse_number": "१२-१५२-३४", "content_sanskrit": "तपः कुरुत वै तीव्रं मुच्यध्वं येन किल्बिषात्।\nतपसा लभ्यते सर्वं विलापः किं करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2077697, "chapter_id": 2647, "verse_number": "१२-१५२-३५", "content_sanskrit": "अनिष्टानि न भाग्यानि जानीत स्वंस्वमात्मना।\nयेन गच्छति बालोऽयं दत्त्वा शोकमनन्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2077698, "chapter_id": 2647, "verse_number": "१२-१५२-३६", "content_sanskrit": "धनं गावः सुवर्णं च मणिरत्नमथापि च।\nअपत्यं च तपोमूलं तपो योगाच्च लभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2077699, "chapter_id": 2647, "verse_number": "१२-१५२-३७", "content_sanskrit": "यथा कृता च भूतेषु प्राप्यते सुखदुःखिता।\nगृहीत्वा जायते जन्तुर्दुःखानि च सुखानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2077700, "chapter_id": 2647, "verse_number": "१२-१५२-३८", "content_sanskrit": "न कर्मणा पितुः पुत्रः पिता व्रा पुत्रकर्मणा।\nमार्गेणान्येन गच्छन्ति बद्धाः सुकृतदुष्कृतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2077701, "chapter_id": 2647, "verse_number": "१२-१५२-३९", "content_sanskrit": "धर्मं चरत यत्नेन तथाऽधर्मान्निवर्तत।\nवर्तध्वं च यथाकालं दैवतेषु द्विजेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2077702, "chapter_id": 2647, "verse_number": "१२-१५२-४०", "content_sanskrit": "शोकं त्यजत दैन्यं च सुतस्नेहान्निवर्तत।\nत्यज्यतामयमाक्रोशस्ततः शीघ्रं निवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2077703, "chapter_id": 2647, "verse_number": "१२-१५२-४१", "content_sanskrit": "यत्करोति शुभं कर्म तथा कर्म सुदारुणम्।\nतत्कर्तैव समश्नाति बान्धवानां किमत्र ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2077704, "chapter_id": 2647, "verse_number": "१२-१५२-४२", "content_sanskrit": "इह त्यक्त्वा न तिष्ठन्ति बान्धवा बान्धवं प्रियम्।\nस्नेहमुत्सृज्य गच्छन्ति बाष्पपूर्णाविलेक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2077705, "chapter_id": 2647, "verse_number": "१२-१५२-४३", "content_sanskrit": "प्राज्ञो वा यदि वा मूर्खः सधनो निर्धनोऽपि वा।\nसर्वः कालवशं याति शुभाशुभसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2077706, "chapter_id": 2647, "verse_number": "१२-१५२-४४", "content_sanskrit": "किं करिष्यथ शोचित्वा मृतं किमनुशोचथ।\nसर्वस्य हि प्रभुः कालो धर्मतः समदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2077707, "chapter_id": 2647, "verse_number": "१२-१५२-४५", "content_sanskrit": "यौवनस्थांश्च बालांश्च बृद्धान्गर्भगतानपि।\nसर्वानाविशते मृत्युरेवंभूतमिदं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2077708, "chapter_id": 2647, "verse_number": "१२-१५२-४६x", "content_sanskrit": "जम्बुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2077709, "chapter_id": 2647, "verse_number": "१२-१५२-४६", "content_sanskrit": "अहो मन्दीकृतः स्नेहो गृध्रेणेहाल्पबुद्धिना।\nपुत्रस्नेहाभिभूतानां युष्माकं शोचतां भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2077710, "chapter_id": 2647, "verse_number": "१२-१५२-४७", "content_sanskrit": "समैः सम्यक्प्रयुक्तैश्च वचनैर्हेतुदर्शनैः।\n`सर्वमेतत्प्रपद्याशु कुरुध्वं वा विचारणां।\nयद्गच्छथ जलस्थानं स्नेहमुत्सृज्य दुस्त्यजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2077711, "chapter_id": 2647, "verse_number": "१२-१५२-४८", "content_sanskrit": "अहो पुत्रवियोगेन मृतशून्योपसेवनात्।\nक्रोशतां वा भृशं दुःखं विवत्सानां गवामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2077712, "chapter_id": 2647, "verse_number": "१२-१५२-४९", "content_sanskrit": "अद्य शोकं विजानामि मानुषाणां महीतले।\nस्नेहं हि कारणं कृत्वा ममाप्यश्रूण्यथापतन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2077713, "chapter_id": 2647, "verse_number": "१२-१५२-५०", "content_sanskrit": "यत्नो हि सततं कार्यस्ततो दैवेन सिद्ध्यति।\nदैवं पुरुषकारश्च कृतान्तेनोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2077714, "chapter_id": 2647, "verse_number": "१२-१५२-५१", "content_sanskrit": "अनिर्वेदः सदा कार्यो निर्वेदाद्धि कुतः सुखम्।\nप्रयत्नात्प्राप्यते ह्यर्थः कस्माद्गच्छथ निर्दयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2077715, "chapter_id": 2647, "verse_number": "१२-१५२-५२", "content_sanskrit": "आत्ममांसोपवृत्तं च शरीरार्धमर्यी तनुम्।\nपितॄणां वंशकर्तारं वने त्यक्त्वा क्व यास्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2077716, "chapter_id": 2647, "verse_number": "१२-१५२-५३", "content_sanskrit": "अथवाऽस्तं गते सूर्ये संध्याकाल उपस्थिते।\nततो नेष्यश्च वा पुत्रमिहस्था वा भविष्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2077717, "chapter_id": 2647, "verse_number": "१२-१५२-५४x", "content_sanskrit": "गृध्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2077718, "chapter_id": 2647, "verse_number": "१२-१५२-५४", "content_sanskrit": "अद्य वर्षसहस्रं मे साग्रं जातस्य मानुषाः।\nन च पश्यामि जीवन्तं मृतं स्त्रीपुंनपुंसकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2077719, "chapter_id": 2647, "verse_number": "१२-१५२-५५", "content_sanskrit": "मृता गर्भेषु जायन्ते जातमात्रा म्रियन्ति च।\nचंक्रमन्तो म्रियन्ते च यौवनस्थास्तथा परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2077720, "chapter_id": 2647, "verse_number": "१२-१५२-५६", "content_sanskrit": "अनित्यानीह भाग्यानि चतुष्पात्पक्षिणामपि।\nजङ्गमाजङ्गमानां च ह्यायुरग्रेऽवतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2077721, "chapter_id": 2647, "verse_number": "१२-१५२-५७", "content_sanskrit": "इष्टदारवियुक्ताश्च पुत्रशोकान्वितास्तथा।\nदह्यमानाः स्म शोकेन गृहं गच्छन्ति नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2077722, "chapter_id": 2647, "verse_number": "१२-१५२-५८", "content_sanskrit": "अनिष्टानां सहस्राणि तथेष्टानां शतानि च।\nउत्सृज्येह प्रयाता वै बान्धवा भृशदुःखिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2077723, "chapter_id": 2647, "verse_number": "१२-१५२-५९", "content_sanskrit": "त्यज्यतामेष निस्तेजाः शून्यः काष्ठत्वमागतः।\nअन्यदेहविषक्तं हि शिशुं काष्ठमुपासथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2077724, "chapter_id": 2647, "verse_number": "१२-१५२-६०", "content_sanskrit": "त्यक्तजीवस्य वै बाष्पं कस्माद्धित्वा न गच्छत।\nनिरर्थको ह्ययं स्नेहो निष्फलश्च परिश्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2077725, "chapter_id": 2647, "verse_number": "१२-१५२-६१", "content_sanskrit": "न च क्षुर्भ्यां न कर्णाभ्यां च शृणोति स पश्यति।\nकस्मादेनं सप्नुत्सृज्य न गृहान्गच्छताशु वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2077726, "chapter_id": 2647, "verse_number": "१२-१५२-६२", "content_sanskrit": "मोक्षधर्माश्रितैर्वाक्यैर्हेतुमद्भिः सुनिष्ठुरैः।\nभयोक्ता गच्छत क्षिप्रं स्वं स्वमेव निवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2077727, "chapter_id": 2647, "verse_number": "१२-१५२-६३", "content_sanskrit": "प्रज्ञाविज्ञानयुक्तेन बुद्धिसंज्ञाप्रदायिना।\nवच्चं श्राविता नूनं मानुषाः संनिवर्तथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2077728, "chapter_id": 2647, "verse_number": "१२-१५२-६४", "content_sanskrit": "[शोको द्विगुणतां याति दृष्ट्वा स्मृत्वा च चेष्टितम्।\nइत्येतद्वचनं श्रुत्वा सन्निवृत्तास्तु मानुषाः।\nअपश्यत्तं तदा सुप्तं द्रुतमागत्य जम्बुकः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2077729, "chapter_id": 2647, "verse_number": "१२-१५२-६५x", "content_sanskrit": "जम्बुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2077730, "chapter_id": 2647, "verse_number": "१२-१५२-६५", "content_sanskrit": "इमं कनकवर्णाभं भूषणैः समलंकृतम्।\nगृध्रवाक्यात्कथं पुत्रं त्यक्ष्यध्वं पितृपिण्डदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2077731, "chapter_id": 2647, "verse_number": "१२-१५२-६६", "content_sanskrit": "न स्नेहस्य च विच्छेदो विलापरुदितस्य च।\nमृतस्यास्य परित्यागात्तापो वै भविता ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2077732, "chapter_id": 2647, "verse_number": "१२-१५२-६७", "content_sanskrit": "श्रूयते शम्बुके शूद्रे हते ब्राह्मणदारकः।\nजीवितो धर्ममासाद्य रामात्सत्यपराक्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2077733, "chapter_id": 2647, "verse_number": "१२-१५२-६८", "content_sanskrit": "तथा श्वैत्यस्य राजर्षेर्बालो दिष्टान्तमागतः।\nमुनिना धर्मनिष्ठेन मृतः संजीवितः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2077734, "chapter_id": 2647, "verse_number": "१२-१५२-६९", "content_sanskrit": "तथा कश्चिद्भवेत्सिद्धो मुनिर्वा देवतापि वा।\nकृपणानामनुक्रोशं कुर्याद्वो रुदतामिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2077735, "chapter_id": 2647, "verse_number": "१२-१५२-७०", "content_sanskrit": "इत्युक्तास्ते न्यवर्तन्त शोकार्ताः पुत्रवत्सलाः।\nअङ्के शिरः समाधाय रुरुदुर्बहुविस्तरम्।\nतेषां रुदितशब्देन गृध्रोऽभ्येत्य वचोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2077736, "chapter_id": 2647, "verse_number": "१२-१५२-७१", "content_sanskrit": "अश्रुपातपरिक्लिन्नः पाणिस्पर्शप्रपीडितः।\nधर्मराजप्रयोगाच्च दीर्घनिद्रां प्रवेशितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2077737, "chapter_id": 2647, "verse_number": "१२-१५२-७२", "content_sanskrit": "`तपसाऽपि हि संयुक्तो जनः कालेन हन्यते।\nसर्वस्नेहावसक्तानामिदं हि स्नेहवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2077738, "chapter_id": 2647, "verse_number": "१२-१५२-७३", "content_sanskrit": "बालवृद्धसहस्राणि सदा संत्यज्य बान्धवाः।\nदिनानि चैव रात्रीश्च दुःखं तिष्ठन्ति भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2077739, "chapter_id": 2647, "verse_number": "१२-१५२-७४", "content_sanskrit": "अलं निर्बन्धमागत्य शोकस्य परिवारणम्।\nअप्रत्ययं कुतो ह्यस्य पुनरद्येह जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2077740, "chapter_id": 2647, "verse_number": "१२-१५२-७५", "content_sanskrit": "`नैष जम्बुकवाक्येन पुनः प्राप्स्यति जीवितम्।\nमृतस्योत्सृष्टदेहस्य पुनर्देहो न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2077741, "chapter_id": 2647, "verse_number": "१२-१५२-७६", "content_sanskrit": "नैव मूर्तिप्रदानेन जम्बुकस्य शतैरपि।\nन स जीवयितुं शक्यो बालो वर्षशतैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2077742, "chapter_id": 2647, "verse_number": "१२-१५२-७७", "content_sanskrit": "अथ रुद्रः कुमारो वा ब्रह्मा वा विष्णुरेव च।\nवरमस्मै प्रयच्छन्ति ततो जीवेदयं शिशुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2077743, "chapter_id": 2647, "verse_number": "१२-१५२-७८", "content_sanskrit": "नैव बाष्पविमोक्षेण न वा श्वासकृतेन च।\nन दीर्घरुदितेनायं पुनर्जीवं गमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2077744, "chapter_id": 2647, "verse_number": "१२-१५२-७९", "content_sanskrit": "अहं च क्रोष्टुकश्चैव यूयं ये चास्य बान्धवाः।\nधर्माधर्मौ गृहीत्वेह सर्वे वर्तामहेऽध्वनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2077745, "chapter_id": 2647, "verse_number": "१२-१५२-८०", "content_sanskrit": "अप्रियं परुषं चापि परद्रोहं परस्त्रियम्।\nअधर्ममनृतं चैव दूरात्प्राज्ञो विवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2077746, "chapter_id": 2647, "verse_number": "१२-१५२-८१", "content_sanskrit": "धर्मं सत्यं श्रुतं न्याय्यं महतीं प्राणिनां दयाम्।\nअजिह्नत्वमशाठ्यं च यत्नतः परिमार्गत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2077747, "chapter_id": 2647, "verse_number": "१२-१५२-८२", "content_sanskrit": "मातरं पितरं वाऽपि बान्धवान्सुहृदस्तथा।\nजीवतो ये न पश्यति तेषां धर्मविपर्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2077748, "chapter_id": 2647, "verse_number": "१२-१५२-८३", "content_sanskrit": "यो न पश्यति चक्षुर्भ्यां नेङ्गते च कथंचन।\nतस्य निष्ठावसानान्ते रुदन्ताः किं करिष्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2077749, "chapter_id": 2647, "verse_number": "१२-१५२-८४", "content_sanskrit": "इत्युक्तास्ते सुतं त्यक्त्वा भूमौ शोकपरिप्लुताः।\nदह्यमानाः सुतस्नेहात्प्रययुर्बान्धवा गृहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2077750, "chapter_id": 2647, "verse_number": "१२-१५२-८५x", "content_sanskrit": "जम्बुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2077751, "chapter_id": 2647, "verse_number": "१२-१५२-८५", "content_sanskrit": "दारुणो मर्त्यलोकोऽयं सर्वप्राणिविनाशनः।\nइष्टबन्धुवियोगश्च तथेहाल्पं च जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2077752, "chapter_id": 2647, "verse_number": "१२-१५२-८६", "content_sanskrit": "बह्वलीकमसत्यं चाप्यतिवादाप्रियंवदम्।\nइमं प्रेक्ष्य पुनर्भावं दुःखशोकविवर्धनम्।\nन मे मानुषलोकोऽयं मुहूर्तमपि रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2077753, "chapter_id": 2647, "verse_number": "१२-१५२-८७", "content_sanskrit": "अहो धिग्गृध्रवाक्येन यथैवाबुद्धयस्तथा।\nकथं गच्छथ निःस्नेहाः सुतस्नेहं विसृज्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2077754, "chapter_id": 2647, "verse_number": "१२-१५२-८८", "content_sanskrit": "प्रदीप्ताः पुत्रशोकेन सन्निवर्तथ मानुषाः।\nश्रुत्वा गृध्रस्य वचनं पापस्येहाकृतात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2077755, "chapter_id": 2647, "verse_number": "१२-१५२-८९", "content_sanskrit": "सुखस्यानन्तरं दुःखं दुःखस्यानन्तरं सुखम्।\nसुखदुःखावृते लोके नास्ति सौख्यमनन्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2077756, "chapter_id": 2647, "verse_number": "१२-१५२-९०", "content_sanskrit": "इमं क्षितितले त्यक्त्वा बालं रूपसमन्वितम्।\nकुलशोभाकरं मूढाः पुत्रं त्यक्त्वा क्व यास्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2077757, "chapter_id": 2647, "verse_number": "१२-१५२-९१", "content_sanskrit": "रूपयौवनसंपन्नं द्योतमानमिव श्रिया।\nजीवन्तमेव पश्यामि मनसा नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2077758, "chapter_id": 2647, "verse_number": "१२-१५२-९२", "content_sanskrit": "विनाशेनास्य न हि वै सुखं प्राप्स्यथ मानुषाः।\nपुत्रशोकाभितप्तानां मृतमप्यद्य वः क्षमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2077759, "chapter_id": 2647, "verse_number": "१२-१५२-९३", "content_sanskrit": "दुःखसंभावनं कृत्वा धारयित्वा सुखं स्वयम्।\nत्यक्त्वा गमिष्यथ क्वाद्य समुत्सृज्याल्पबुद्धिवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2077760, "chapter_id": 2647, "verse_number": "१२-१५२-९४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2077761, "chapter_id": 2647, "verse_number": "१२-१५२-९४", "content_sanskrit": "तथा धर्मविरोधेन प्रियमिथ्याभिधायिनाम्।\nश्मशानवासिना नित्यं रात्रिं मृगयता नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2077762, "chapter_id": 2647, "verse_number": "१२-१५२-९५", "content_sanskrit": "ततो मध्यस्थतां नीता वचनैरमृतोपमैः।\nजम्बुकेन स्वकार्यार्थं बान्धवास्तत्र वारिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2077763, "chapter_id": 2647, "verse_number": "१२-१५२-९६x", "content_sanskrit": "गृध्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2077764, "chapter_id": 2647, "verse_number": "१२-१५२-९६", "content_sanskrit": "अयं प्रेतसमाकीर्णो यक्षराक्षससेवितः।\nदारुणः काननोद्देशः कौशिकैरभिनादितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2077765, "chapter_id": 2647, "verse_number": "१२-१५२-९७", "content_sanskrit": "भीमः सुघोरश्च तथा नीलमेघसमप्रभः।\nअस्मिञ्शवं परित्यज्य प्रेतकार्याण्युपासत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2077766, "chapter_id": 2647, "verse_number": "१२-१५२-९८", "content_sanskrit": "भानुर्यावन्न यात्यस्तं यावच्च विमला दिशः।\nतावदेनं परित्यज्य प्रेतकार्याण्युपासत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2077767, "chapter_id": 2647, "verse_number": "१२-१५२-९९", "content_sanskrit": "नदन्ति परुषं श्येनाः शिवाः क्रोशन्ति दारुणम्।\nमृगेन्द्राः प्रतिनर्दन्ति रविरस्तं च गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2077768, "chapter_id": 2647, "verse_number": "१२-१५२-१००", "content_sanskrit": "चिता धूमेन नीलेन संरज्यन्ते च पादपाः।\nश्मशाने च निराहाराः प्रतिनर्दन्ति देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2077769, "chapter_id": 2647, "verse_number": "१२-१५२-१०१", "content_sanskrit": "सर्वे विकृतदेहाश्चाप्यस्मिन्देशे सुदारुणे।\nयुष्मान्प्रधर्षयिष्यन्ति विकृता मांसभोजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2077770, "chapter_id": 2647, "verse_number": "१२-१५२-१०२", "content_sanskrit": "क्रूरश्चायं वनोद्देशो भयमद्य भविष्यति।\nत्यज्यतां काष्ठभूतोऽयं मुच्यतां जाम्बुकं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2077771, "chapter_id": 2647, "verse_number": "१२-१५२-१०३", "content_sanskrit": "यदि जम्बुकवाक्यानि निष्फलान्यनृतानि च।\nश्रोष्यथ भ्रष्टविज्ञानास्ततः सर्वे विनङ्क्ष्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2077772, "chapter_id": 2647, "verse_number": "१२-१५२-१०४x", "content_sanskrit": "जम्बुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2077773, "chapter_id": 2647, "verse_number": "१२-१५२-१०४", "content_sanskrit": "स्थीयतां वो न भेतव्यं यावत्तपति भास्करः।\nतावदस्मिन्सुते स्नेहादनिर्वेदेन वर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2077774, "chapter_id": 2647, "verse_number": "१२-१५२-१०५", "content_sanskrit": "स्वैरं रुदन्तो विस्रब्धाश्चिरं स्नेहेन पश्यत।\n`दारुणेऽस्मिन्वनोद्देशे भयं वो न भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2077775, "chapter_id": 2647, "verse_number": "१२-१५२-१०६", "content_sanskrit": "अयं सौम्यो वनोद्देशः पितृणां निधनाकरः।\nस्थीयतां यावदादित्यः किंवः क्रव्यादभाषितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2077776, "chapter_id": 2647, "verse_number": "१२-१५२-१०७", "content_sanskrit": "यदि गृध्रस्य वाक्यानि तीव्राणि रभसानि च।\nगृह्णीत मोहितात्मानः सुतो वो न भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2077777, "chapter_id": 2647, "verse_number": "१२-१५२-१०८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2077778, "chapter_id": 2647, "verse_number": "१२-१५२-१०८", "content_sanskrit": "गृध्रो नास्तमितेऽभ्येति तिष्ठेन्नक्तं च जम्बुकः।\nमृतस्य तं परिजनमूचतुस्तौ क्षुधान्वितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2077779, "chapter_id": 2647, "verse_number": "१२-१५२-१०९", "content_sanskrit": "स्वकार्यबद्धकक्षौ तौ राजन्गृध्रोऽथ जम्बुकः।\nक्षुत्पिपासापरिश्रान्तौ शास्त्रमालम्ब्य जल्पतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2077780, "chapter_id": 2647, "verse_number": "१२-१५२-११०", "content_sanskrit": "तयोर्विज्ञानविदुषोर्द्वयोर्मृगपतत्रिणोः।\nवाक्यैरमृतकल्पैस्तैः प्रतिष्ठन्ते व्रजन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2077781, "chapter_id": 2647, "verse_number": "१२-१५२-१११", "content_sanskrit": "शोकदैन्यसमाविष्टा रुदन्तस्तस्थिरे तदा।\nस्वकार्यकुशलाभ्यां ते संभ्राम्यन्ते ह नैपुणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2077782, "chapter_id": 2647, "verse_number": "१२-१५२-११२", "content_sanskrit": "तथा तयोर्विवदतोर्विज्ञानविदुषोर्द्वयोः।\nबान्धवानां स्थितानां चाप्युपातिष्ठत शंकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2077783, "chapter_id": 2647, "verse_number": "१२-१५२-११३", "content_sanskrit": "देव्या प्रणोदितो देवः कारुण्यार्द्रीकृतेक्षणः।\nततस्तानाह मनुजान्वरदोऽस्मीति शंकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2077784, "chapter_id": 2647, "verse_number": "१२-१५२-११४", "content_sanskrit": "ते प्रत्यूचुरिदं वाक्य दुःखिताः प्रणताः स्थिताः।\nएकपुत्रविहीनानां सर्वेष्नां जीवितार्थिनाम्।\nपुत्रस्य नो जीवदानाज्जीवितं दातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2077785, "chapter_id": 2647, "verse_number": "१२-१५२-११५", "content_sanskrit": "एवमुक्तः स भगवान्वारिपूर्णेन पाणिना।\nजीवं तस्मै कुमाराय प्रादाद्वर्षशतानि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2077786, "chapter_id": 2647, "verse_number": "१२-१५२-११६", "content_sanskrit": "तथा गोमायुगृध्राभ्यां प्राददत्क्षुद्विनाशनम्।\nवरं पिनाकी भगवान्सर्वभूतहिते रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2077787, "chapter_id": 2647, "verse_number": "१२-१५२-११७", "content_sanskrit": "ततः प्रणम्य ते देवं श्रेयोहर्षसमन्विताः।\nकृतकृत्याः सुसंहृष्टाः प्रातिष्ठन्त तदा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2077788, "chapter_id": 2647, "verse_number": "१२-१५२-११८", "content_sanskrit": "अनिर्वेदेन दीर्घेण निश्चयेन ध्रुवेण च।\nदेवदेवप्रसादाच्च क्षिप्रं फलमवाप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2077789, "chapter_id": 2647, "verse_number": "१२-१५२-११९", "content_sanskrit": "पश्य दैवस्य संयोगं बान्धवाना च निश्चयम्।\nकृपणानां तु रुदतां कृतमश्रुप्रमार्जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2077790, "chapter_id": 2647, "verse_number": "१२-१५२-१२०", "content_sanskrit": "पश्य चाल्पेन कालेन निश्चयाध्वेषणेन च।\nप्रसादं शंकरात्प्राप्य दुःखिताः सुखमाप्नुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2077791, "chapter_id": 2647, "verse_number": "१२-१५२-१२१", "content_sanskrit": "ते विस्मिताः प्रहृष्टाश्च पुत्रसंजीवनात्पुनः।\nबभूवुर्भरतश्रेष्ठ प्रसादाच्छंकरस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2077792, "chapter_id": 2647, "verse_number": "१२-१५२-१२२", "content_sanskrit": "ततस्ते त्वरिता राजंस्त्यक्त्वा शोकं शिशूद्भवम्।\nविविशुः पुत्रमादाय नगरं हृष्टमानसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2077793, "chapter_id": 2647, "verse_number": "१२-१५२-१२३", "content_sanskrit": "एषा बुद्धिः समस्तानां चातुर्वर्ण्येन दर्शिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2077794, "chapter_id": 2647, "verse_number": "१२-१५२-१२४", "content_sanskrit": "धर्मार्थमोक्षसंयुक्तमितिहासं पुरातनम्।\nश्रुत्वा मनुष्यः सततमिहामुत्र प्रमोदते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2077795, "chapter_id": 2647, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि द्विपञ्चाशदधिकशततमोऽध्यायः॥ १५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}]