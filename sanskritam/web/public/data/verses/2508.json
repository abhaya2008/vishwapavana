[{"id": 2071462, "chapter_id": 2508, "verse_number": "१२-१३-०x", "content_sanskrit": "सहदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071463, "chapter_id": 2508, "verse_number": "१२-१३-१", "content_sanskrit": "न बाह्यं द्रव्यमुत्सृज्य सिद्धिर्भवति भारत।\nशारीरं द्रव्यमुत्सृज्य सिद्धिर्भवति वा न वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071464, "chapter_id": 2508, "verse_number": "१२-१३-२", "content_sanskrit": "बाह्यद्रव्यविमुक्तस्य शारीरेष्वनुगृध्यतः।\nयो धर्मो यत्सुखं वा स्याद्द्विषतां तत्तथाऽस्तु नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071465, "chapter_id": 2508, "verse_number": "१२-१३-३", "content_sanskrit": "शारीरंद्रव्यमुत्सृज्य पृथिवीमनुशासतः।\nयो धर्मो यत्सुखं वा स्यात्सुहृदां तत्तथाऽस्तु नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071466, "chapter_id": 2508, "verse_number": "१२-१३-४", "content_sanskrit": "द्व्यक्षरस्तु भवेन्मृत्युरुयक्षरं ब्रह्म शाश्वतम्।\nममेति द्व्यक्षरो मृत्युर्न ममेति च शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071467, "chapter_id": 2508, "verse_number": "१२-१३-५", "content_sanskrit": "ब्रह्ममृत्यू ततो राजन्नात्मन्येव समाश्रितौ।\nअदृश्यमानौ भूतानि योजयेतामसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071468, "chapter_id": 2508, "verse_number": "१२-१३-६", "content_sanskrit": "अविनाशोऽस्य सत्वस्य नियतो यदि भारत।\nहित्वा शरीरं भूतानां न हिंसा प्रतिपत्स्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071469, "chapter_id": 2508, "verse_number": "१२-१३-७", "content_sanskrit": "अथापि च सहोत्पत्तिः सत्वस्य प्रलयस्तथा।\nनष्टे शरीरे नष्टः स्याद्वृथा च स्यात्क्रियापथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071470, "chapter_id": 2508, "verse_number": "१२-१३-८", "content_sanskrit": "तस्मादेकान्तमुत्सृज्य पूर्वैः पूर्वतरैश्च यः।\nपन्था निषेवितः सद्भिः स निषेव्यो विजानता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071471, "chapter_id": 2508, "verse_number": "१२-१३-९", "content_sanskrit": "`स्वायंभुवेन मनुना तथाऽन्यैश्तक्रवर्तिभिः।\nयद्ययं ह्यधमः पन्थाः कस्मात्तैस्तैर्निषेवितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071472, "chapter_id": 2508, "verse_number": "१२-१३-१०", "content_sanskrit": "कृतत्रेतादियुक्तानि गुणवन्ति च भारत।\nयुगानि बहुशस्तैश्च भुक्तेयमवनी नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071473, "chapter_id": 2508, "verse_number": "१२-१३-११", "content_sanskrit": "लब्ध्वाऽपि पृथिवीं कृत्स्नां सहस्थावरजङ्गमाम्।\nन भुङ्क्ते यो नृपः सम्यक्किंफलं तस्य जीविते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071474, "chapter_id": 2508, "verse_number": "१२-१३-१२", "content_sanskrit": "अथवा वसतो राजन्वने वन्येन जीवतः।\nद्रव्येषु यस्य ममता मृत्योरास्ये स वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071475, "chapter_id": 2508, "verse_number": "१२-१३-१३", "content_sanskrit": "बाह्यान्तराणां भूतानां स्वभावं पश्य भारत।\nये तु पश्यन्ति तद्भूतं मुच्यन्ते ते महाभयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071476, "chapter_id": 2508, "verse_number": "१२-१३-१४", "content_sanskrit": "भवान्पिता भवान्माता भवान्भ्राता भवान्गुरुः।\nदुःखप्रलापानार्तस्य तन्मे त्वं क्षन्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071477, "chapter_id": 2508, "verse_number": "१२-१३-१५", "content_sanskrit": "तथ्यं वा यदि वाऽतथ्यं यन्मयैतत्प्रभाषितम्।\nतद्विद्वि पृथिवीपाल भक्त्या भरतसत्तम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071478, "chapter_id": 2508, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि त्रयोदशोऽध्यायः॥ १३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]