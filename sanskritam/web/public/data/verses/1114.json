[{"id": 2005856, "chapter_id": 1114, "verse_number": "१-११५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005857, "chapter_id": 1114, "verse_number": "१-११५-१", "content_sanskrit": "ततः सत्यवती काले वधूं स्नातामृतौ तदा।\nसंवेशयन्ती शयने शनैर्वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005858, "chapter_id": 1114, "verse_number": "१-११५-२", "content_sanskrit": "कौसल्ये देवरस्तेऽस्ति सोऽद्य त्वाऽनुप्रवेक्ष्यति।\nअप्रमत्ता प्रतीक्षैनं निशीथे ह्यागमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005859, "chapter_id": 1114, "verse_number": "१-११५-३", "content_sanskrit": "श्वश्र्वास्तद्वचनं श्रुत्वा शयाना शयने शुभे।\nसाऽचिन्तयत्तदा भीष्ममन्यांश्च कुरुपुङ्गवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005860, "chapter_id": 1114, "verse_number": "१-११५-४", "content_sanskrit": "ततः सुप्तजनप्रायेऽर्धरात्रे भगवानृषिः।\nदीप्यमानेषु दीपेषु शरणं प्रविवेश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005861, "chapter_id": 1114, "verse_number": "१-११५-५", "content_sanskrit": "ततोऽम्बिकायां प्रथमं नियुक्तः सत्यवागृषिः।\nजगाम तस्याः शयनं विपुले तपसि स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005862, "chapter_id": 1114, "verse_number": "१-११५-६", "content_sanskrit": "तं समीक्ष्य तु कौसल्या दुष्प्रेक्षमतथोचिता।\nविरूप इति वित्रस्ता संकुच्यासीन्निमीलिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005863, "chapter_id": 1114, "verse_number": "१-११५-७", "content_sanskrit": "विरूपो हि जटी चापि दुर्वर्णः परुषः कृशः।\nसुगन्धेतरगन्धश्च सर्वथा दुष्प्रधर्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005864, "chapter_id": 1114, "verse_number": "१-११५-८", "content_sanskrit": "तस्य कृष्णस्य कपिलां जटां दीप्ते च लोचने।\nबब्रूणि चैव श्मश्रूमि दृष्ट्वा देवी न्यमीलयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005865, "chapter_id": 1114, "verse_number": "१-११५-९", "content_sanskrit": "संभूव तया सार्धं मातुः प्रियचिकीर्षया।\nभयात्काशिसुता तं तु नाशक्नोदभिवीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005866, "chapter_id": 1114, "verse_number": "१-११५-१०", "content_sanskrit": "ततो निष्क्रान्तमागम्य माता पुत्रमुवाच ह।\nअप्यस्यां गुणवान्पुत्र राजपुत्रो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005867, "chapter_id": 1114, "verse_number": "१-११५-११", "content_sanskrit": "निशम्य तद्वचो मातुर्व्यासः सत्यवतीसुतः।\nप्रोवाचातीन्द्रियज्ञानो विधिना संप्रचोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005868, "chapter_id": 1114, "verse_number": "१-११५-१२", "content_sanskrit": "नागायुतसमप्राणो विद्वान्राजर्षिसत्तमः।\nमहाभागो महावीर्यो महाबुद्धिर्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005869, "chapter_id": 1114, "verse_number": "१-११५-१३", "content_sanskrit": "तस्य चापि शतं पुत्रा भविष्यन्ति महात्मनः।\nकिंतु मातुः स वैगुण्यादन्ध एव भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005870, "chapter_id": 1114, "verse_number": "१-११५-१४", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा माता पुत्रमथाऽब्रवीत्।\nनान्धः कुरूणां नृपतिरनुरूपस्तपोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005871, "chapter_id": 1114, "verse_number": "१-११५-१५", "content_sanskrit": "ज्ञातिवंशस्य गोप्तारं पितॄणां वंशवर्धनम्।\nअपरस्यामपि पुनर्मम शोकविनाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005872, "chapter_id": 1114, "verse_number": "१-११५-१६", "content_sanskrit": "तस्मादवरजं पुत्रं जनयान्यं नराधिपम्।\nभ्रातुर्भार्याऽवरा चेयं रूपयौवनशालिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005873, "chapter_id": 1114, "verse_number": "१-११५-१७", "content_sanskrit": "अस्यामुत्पादयाऽपत्यं मन्नियोगाद्गुणाधिकम्।\nद्वितीयं कुरुवंशस्य राजानं दातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005874, "chapter_id": 1114, "verse_number": "१-११५-१८", "content_sanskrit": "स तथेति प्रतिज्ञाय निश्चक्राम महायशाः।\nसाऽपि कालेन कौसल्या सुषुवेऽन्धं तमात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005875, "chapter_id": 1114, "verse_number": "१-११५-१९", "content_sanskrit": "पुनरेव तु सा देवी परिभाष्य स्नुषां ततः।\nऋषिमावाहयत्सत्या यथापूर्वमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005876, "chapter_id": 1114, "verse_number": "१-११५-२०", "content_sanskrit": "अम्बालिकां समाहूय तस्यां सत्यवती सुतम्।\nभूयो नियोजयामास सन्तानाय कुलस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2005877, "chapter_id": 1114, "verse_number": "१-११५-२१", "content_sanskrit": "विषण्णाम्बालिका साध्वी निषण्णा शयनोत्तमे।\nकोन्वेष्यतीति ध्यायन्ती नियतां संप्रतीक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2005878, "chapter_id": 1114, "verse_number": "१-११५-२२", "content_sanskrit": "ततस्तेनैव विधिना महर्षिस्तामपद्यत।\nअम्बालिकामथाऽभ्यागादृषिं दृष्ट्वा च साऽपि तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2005879, "chapter_id": 1114, "verse_number": "१-११५-२३", "content_sanskrit": "विवर्णा पाण्डुसंकाशा समपद्यत भारत।\nतां भीतां पाण्डुसंकाशां विषण्णां प्रेक्ष्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2005880, "chapter_id": 1114, "verse_number": "१-११५-२४", "content_sanskrit": "व्यासः सत्यवतीपुत्र इदं वचनमब्रवीत्।\nयस्मात्पाण्डुत्वमापन्ना विरूपं प्रेक्ष्य मामिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2005881, "chapter_id": 1114, "verse_number": "१-११५-२५", "content_sanskrit": "तस्मादेष सुतस्ते वै पाण्डुरेव भविष्यति।\nनाम चास्यैतदेवेह भविष्यति शुभानने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2005882, "chapter_id": 1114, "verse_number": "१-११५-२६", "content_sanskrit": "इत्युक्त्वा स निराक्रामद्भगवानृषिसत्तमः।\nततो निष्क्रान्तमालोक्य सत्या पुत्रमथाऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2005883, "chapter_id": 1114, "verse_number": "१-११५-२७", "content_sanskrit": "कुमारो ब्रूहि मे पुत्र अप्यत्र भविता शुभः।\nशशंस स पुनर्मात्रे तस्य बालस्य पाण्डुताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2005884, "chapter_id": 1114, "verse_number": "१-११५-२८", "content_sanskrit": "भविष्यति सुविक्रान्तः कुमारो दिक्षु विश्रुतः।\nपाण्डुत्वं वर्णतस्तस्य मातृदोषाद्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2005885, "chapter_id": 1114, "verse_number": "१-११५-२९", "content_sanskrit": "तस्य पुत्रा महेष्वासा भविष्यन्तीह पञ्च वै।\nइत्युक्त्वा मातरं तत्र सोऽभिवाद्य जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2005886, "chapter_id": 1114, "verse_number": "१-११५-३०", "content_sanskrit": "तं माता पुनरेवान्यमेकं पुत्रमयाचत।\nतथेति च महर्षिस्तां मातरं प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2005887, "chapter_id": 1114, "verse_number": "१-११५-३१", "content_sanskrit": "ततः कुमारं सा देवी प्राप्तकालमजीजनत्।\nपाण्डुलक्षणसंपन्नं दीप्यमानमिव श्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2005888, "chapter_id": 1114, "verse_number": "१-११५-३२", "content_sanskrit": "यस्य पुत्रा महेष्वासा जज्ञिरे पञ्च पाण्डवाः।\nतयोर्जन्मक्रियाः सर्वा यथावदनुपूर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2005889, "chapter_id": 1114, "verse_number": "१-११५-३३", "content_sanskrit": "कारयामास वै भीष्मो ब्राह्मणैर्वेदपारगैः।\nअन्धं दृष्ट्वाऽम्बिकापुत्रं जातं सत्यवती सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2005890, "chapter_id": 1114, "verse_number": "१-११५-३४", "content_sanskrit": "कौसल्यार्थे समाहूय पुत्रमन्यमयाचत।\nअन्धोयमन्यमिच्छामि कौसल्यातनयं शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2005891, "chapter_id": 1114, "verse_number": "१-११५-३५", "content_sanskrit": "एवमुक्तो महर्षिस्तां मातरं प्रत्यभाषत।\nनियता यदि कौसल्या भविष्यति पुनःशुभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2005892, "chapter_id": 1114, "verse_number": "१-११५-३६", "content_sanskrit": "भविष्यति कुमारोऽस्या धर्मशास्त्रार्थतत्ववित्।\nतां समाधाय वै भूयः स्नुषां सत्यवती पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2005893, "chapter_id": 1114, "verse_number": "१-११५-३७", "content_sanskrit": "ऋतुकाले ततो ज्येष्ठां वधूं तस्मै न्ययोजयत्।\nसा तु रूपं च गन्धं च महर्षेः प्रविचिन्त्य तं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2005894, "chapter_id": 1114, "verse_number": "१-११५-३८", "content_sanskrit": "नाकरोद्वचनं देव्या भयात्सुरसुतोपमा।\nततःस्वैर्भूषणैर्दासीं भूषयित्वाऽप्सरोपमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2005895, "chapter_id": 1114, "verse_number": "१-११५-३९", "content_sanskrit": "प्रेषयामास कृष्णाय ततः काशिपतेः सुता।\nसा तं त्वृषिमनुप्राप्तं प्रत्युद्गम्याभिवाद्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2005896, "chapter_id": 1114, "verse_number": "१-११५-४०", "content_sanskrit": "संविवेशाभ्यनुज्ञाता सत्कृत्योपचचार ह।\nवाग्भावोपप्रदानेन गात्रसंस्पर्शनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2005897, "chapter_id": 1114, "verse_number": "१-११५-४१", "content_sanskrit": "कामोपभोगेन रहस्तस्यां तुष्टिमगादृषिः।\nतया सहोषितो राजन्महर्षिः संशितव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2005898, "chapter_id": 1114, "verse_number": "१-११५-४२", "content_sanskrit": "उत्तिष्ठन्नब्रवीदेनामभुजिष्या भविष्यसि।\nअयं च ते शुभे गर्भः श्रेयानुदरमागतः।\nधर्मात्मा भविता लोके सर्वबुद्धिमतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2005899, "chapter_id": 1114, "verse_number": "१-११५-४३", "content_sanskrit": "स जज्ञे विदुरो नाम कृष्णद्वैपायनात्मजः।\nधृतराष्ट्रस्य वै भ्राता पाण्डोश्चैव महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2005900, "chapter_id": 1114, "verse_number": "१-११५-४४", "content_sanskrit": "धर्मो विदुररूपेण शापात्तस्य महात्मनः।\nमाण्डव्यस्यार्थतत्त्वज्ञः कामक्रोधविवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2005901, "chapter_id": 1114, "verse_number": "१-११५-४५", "content_sanskrit": "कृष्णद्वैपायनोऽप्येतत्सत्यवत्यै न्यवेदयत्।\nप्रलम्भमात्मनश्चैव शूद्रायाः पुत्रजन्म च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2005902, "chapter_id": 1114, "verse_number": "१-११५-४६", "content_sanskrit": "स धर्मस्यानृणो भूत्वा पुनर्मात्रा समेत्य च।\nतस्यै गर्भं समावेद्य तत्रैवान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2005903, "chapter_id": 1114, "verse_number": "१-११५-४७", "content_sanskrit": "एते विचित्रवीर्यस्य क्षेत्रे द्वैपायनादपि।\nजज्ञिरे देवगर्भाभाः कुरुवंशविवर्धनाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2005904, "chapter_id": 1114, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि पञ्चादशाधिकशततमोऽध्यायः॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]