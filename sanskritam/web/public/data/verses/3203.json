[{"id": 2102091, "chapter_id": 3203, "verse_number": "१४-५९-१", "content_sanskrit": "जनमेजय उवाच।\nउदङ्कस्य वरं दत्त्वा गोविन्दो द्विजत्तम।\nअत ऊर्ध्वं महाबाहुः किं चकार महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102092, "chapter_id": 3203, "verse_number": "१४-५९-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102093, "chapter_id": 3203, "verse_number": "१४-५९-२", "content_sanskrit": "उदङ्काय वरं दत्त्वा प्रायात्सात्यकिना सह।\nद्वारकामेव गोविन्दः शीघ्रवेगैर्महाहयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102094, "chapter_id": 3203, "verse_number": "१४-५९-३", "content_sanskrit": "सरांसि सरितश्चैव वनानि च गिरींस्तथा।\nअतिक्रम्याससादाथ रम्यां द्वारवतीं पुरीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102095, "chapter_id": 3203, "verse_number": "१४-५९-४", "content_sanskrit": "वर्तमाने महाराज महे रैवतकस्य च।\nउपायात्पुण्डरीकाक्षो युयुधानानुगस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102096, "chapter_id": 3203, "verse_number": "१४-५९-५", "content_sanskrit": "अलङ्कृतस्तु स गिरिर्नानारूपैर्विचित्रितैः।\nबभौ रत्नमयैः कोशैः संवृतः पुरुर्षर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102097, "chapter_id": 3203, "verse_number": "१४-५९-६", "content_sanskrit": "काञ्चनस्रग्भिरग्र्याभिः सुमनोभिस्तथैव च।\nवासोभिश्च महाशैलः कल्पवृक्षैस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102098, "chapter_id": 3203, "verse_number": "१४-५९-७", "content_sanskrit": "दीपवृक्षैश्च सौवर्णैरभीक्ष्णमुपशोभितः।\nगुहानिर्झरदेशेषु दिवाभूतो बभूव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102099, "chapter_id": 3203, "verse_number": "१४-५९-८", "content_sanskrit": "एताकाभिर्विचित्राभिः सघण्टाभिः समन्ततः।\nपुंभिः स्त्रीभिश्च संघुष्टः प्रगीत इव चाभवत्।\nअतीव प्रेक्षणीयोऽभून्मेरुर्मुनिगणैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102100, "chapter_id": 3203, "verse_number": "१४-५९-९", "content_sanskrit": "मत्तानां हृष्टरूपाणां स्त्रीणां पुंसां च भारत।\nगायतां पर्वतेन्द्रस्य दिविस्पृगिव निःस्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102101, "chapter_id": 3203, "verse_number": "१४-५९-१०", "content_sanskrit": "प्रमत्तमत्तसम्मत्तक्ष्वेडितोद्धुष्टसंकुलः।\nतथा किलकिलाशब्दैर्भूधरोऽभून्मनोहरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102102, "chapter_id": 3203, "verse_number": "१४-५९-११", "content_sanskrit": "विपणापणवान्रम्यो भक्ष्यभोज्यविहारवान्।\nवस्त्रमाल्योत्करयुतो वीणावेणुमृदङ्गवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102103, "chapter_id": 3203, "verse_number": "१४-५९-१२", "content_sanskrit": "सुरामैरेयमिश्रेण भक्ष्यभोज्येन चैव ह।\nदीनान्धकृपणादिभ्यो दीयमानेन चानिशम्।\nबभौ परमकल्याणो महस्तस्य महागिरेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102104, "chapter_id": 3203, "verse_number": "१४-५९-१३", "content_sanskrit": "पुण्यावसथवान्वीरैः पुण्यकृद्भिर्निषेवितः।\nविहारो वृष्णिवीराणां महे रैवतस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102105, "chapter_id": 3203, "verse_number": "१४-५९-१४", "content_sanskrit": "स नानावेश्मसंकीर्णो देवलोक इवाबभौ।\nतदा च कृष्णसान्निध्यान्मुदा देवगणैर्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102106, "chapter_id": 3203, "verse_number": "१४-५९-१५", "content_sanskrit": "`स्तुवन्त्यन्तर्हिता देवा गन्धर्वाश्च सहर्षिभिः।\nसाधकः सर्वधर्माणामसुराणां विनाशकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102107, "chapter_id": 3203, "verse_number": "१४-५९-१६", "content_sanskrit": "त्वं स्रष्टा सृज्यमाधारं कारणं धर्मवेदवित्।\nत्वया सत्क्रियते देव ज जानीमोऽत्र मायया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102108, "chapter_id": 3203, "verse_number": "१४-५९-१७", "content_sanskrit": "केवलं त्वाऽभिजानीमः शरणं परमेश्वरम्।\nब्रह्मादीनां च गोविन्द सान्निध्वं शरणं नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102109, "chapter_id": 3203, "verse_number": "१४-५९-१८", "content_sanskrit": "इति स्तुते मानुषैश्च पूजिते देवकीसुते।\nशक्रसद्मप्रतीकाशो बभूव स हि शैलराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102110, "chapter_id": 3203, "verse_number": "१४-५९-१९", "content_sanskrit": "ततः सम्पूज्यमानः स विवेश भवनं शुभम्।\nगोविन्दः सात्यकिश्चैव जग्मतुर्भवनं स्वकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102111, "chapter_id": 3203, "verse_number": "१४-५९-२०", "content_sanskrit": "विवेश च प्रहृष्टात्मा चिरकालप्रवासतः।\nकृत्वा नसुकरं कर्म दानवेष्विव वासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102112, "chapter_id": 3203, "verse_number": "१४-५९-२१", "content_sanskrit": "उपायान्तं तु वार्ष्णेयं भोजवृष्ण्यन्धकास्तथा।\nअभ्यगच्चन्महात्मानं देवा इव शतक्रतुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102113, "chapter_id": 3203, "verse_number": "१४-५९-२२", "content_sanskrit": "स तानभ्यर्च्य मेधावी पृष्ट्वा च कुशलं तदा।\nअभ्यवादयत प्रीतः पितरं मातरं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102114, "chapter_id": 3203, "verse_number": "१४-५९-२३", "content_sanskrit": "ताभ्यां स सम्परिष्वक्तः सान्त्वितश्च महाभुजः।\nउपोपविष्टैः सर्वैस्तैर्वृष्णिभिः परिवारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102115, "chapter_id": 3203, "verse_number": "१४-५९-२४", "content_sanskrit": "स विश्रान्तो महातेजाः कृतपादावनेजनः।\nकथयामास तत्सर्वं पृष्टः पित्रा महाहवम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102116, "chapter_id": 3203, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि एकोनषष्टितमोऽध्यायः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]