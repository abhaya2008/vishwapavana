[{"id": 5000248000, "chapter_id": 9248, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे द्विपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000248001, "chapter_id": 9248, "verse_number": "३-५२-१", "content_sanskrit": "सा तु ताराधिपमुखी रावणेन निरीक्ष्य तम्।\nगृध्रराजं विनिहतं विललाप सुदुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000248002, "chapter_id": 9248, "verse_number": "३-५२-२", "content_sanskrit": "निमित्तं लक्षणं स्वप्नं शकुनिस्वरदर्शनम्।\nअवश्यं सुखदुःखेषु नराणां परिदृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000248003, "chapter_id": 9248, "verse_number": "३-५२-३", "content_sanskrit": "न नूनं राम जानासि महद्‍व्यसनमात्मनः।\nधावन्ति नूनं काकुत्स्थ मदर्थं मृगपक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000248004, "chapter_id": 9248, "verse_number": "३-५२-४", "content_sanskrit": "अयं हि कृपया राम मां त्रातुमिह संगतः।\nशेते विनिहतो भूमौ ममाभाग्याद् विहंगमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000248005, "chapter_id": 9248, "verse_number": "३-५२-५", "content_sanskrit": "त्राहि मामद्य काकुत्स्थ लक्ष्मणेति वराङ्गना।\nसुसंत्रस्ता समाक्रन्दच्छृण्वतां तु यथान्तिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000248006, "chapter_id": 9248, "verse_number": "३-५२-६", "content_sanskrit": "तां क्लिष्टमाल्याभरणां विलपन्तीमनाथवत्।\nअभ्यधावत वैदेहीं रावणो राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000248007, "chapter_id": 9248, "verse_number": "३-५२-७", "content_sanskrit": "तां लतामिव वेष्टन्तीमालिङ्गन्तीं महाद्रुमान्।\nमुञ्च मुञ्चेति बहुशः प्राप तां राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000248008, "chapter_id": 9248, "verse_number": "३-५२-८", "content_sanskrit": "क्रोशन्तीं राम रामेति रामेण रहितां वने।\nजीवितान्ताय केशेषु जग्राहान्तकसंनिभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000248009, "chapter_id": 9248, "verse_number": "३-५२-९", "content_sanskrit": "प्रधर्षितायां वैदेह्यां बभूव सचराचरम्।\nजगत् सर्वममर्यादं तमसान्धेन संवृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000248010, "chapter_id": 9248, "verse_number": "३-५२-१०", "content_sanskrit": "न वाति मारुतस्तत्र निष्प्रभोऽभूद् दिवाकरः।\nदृष्ट्वा सीतां परामृष्टां देवो दिव्येन चक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000248011, "chapter_id": 9248, "verse_number": "३-५२-११", "content_sanskrit": "कृतं कार्यमिति श्रीमान् व्याजहार पितामहः।\nप्रहृष्टा व्यथिताश्चासन् सर्वे ते परमर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000248012, "chapter_id": 9248, "verse_number": "३-५२-१२", "content_sanskrit": "दृष्ट्वा सीतां परामृष्टां दण्डकारण्यवासिनः।\nरावणस्य विनाशं च प्राप्तं बुद्‍ध्वा यदृच्छया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000248013, "chapter_id": 9248, "verse_number": "३-५२-१३", "content_sanskrit": "स तु तां राम रामेति रुदतीं लक्ष्मणेति च।\nजगामादाय चाकाशं रावणो राक्षसेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000248014, "chapter_id": 9248, "verse_number": "३-५२-१४", "content_sanskrit": "तप्ताभरणवर्णाङ्गी पीतकौशेयवासिनी।\nरराज राजपुत्री तु विद्युत्सौदामनी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000248015, "chapter_id": 9248, "verse_number": "३-५२-१५", "content_sanskrit": "उद‍्धूतेन च वस्त्रेण तस्याः पीतेन रावणः।\nअधिकं परिबभ्राज गिरिर्दीप्त इवाग्निना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000248016, "chapter_id": 9248, "verse_number": "३-५२-१६", "content_sanskrit": "तस्याः परमकल्याण्यास्ताम्राणि सुरभीणि च।\nपद्मपत्राणि वैदेह्या अभ्यकीर्यन्त रावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000248017, "chapter_id": 9248, "verse_number": "३-५२-१७", "content_sanskrit": "तस्याः कौशेयमुद‍्धूतमाकाशे कनकप्रभम्।\nबभौ चादित्यरागेण ताम्रमभ्रमिवातपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000248018, "chapter_id": 9248, "verse_number": "३-५२-१८", "content_sanskrit": "तस्यास्तद् विमलं वक्त्रमाकाशे रावणाङ्कगम्।\nन रराज विना रामं विनालमिव पङ्कजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000248019, "chapter_id": 9248, "verse_number": "३-५२-१९", "content_sanskrit": "बभूव जलदं नीलं भित्त्वा चन्द्र इवोदितः।\nसुललाटं सुकेशान्तं पद्मगर्भाभमव्रणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000248020, "chapter_id": 9248, "verse_number": "३-५२-२०", "content_sanskrit": "शुक्लैः सुविमलैर्दन्तैः प्रभावद्भिरलंकृतम्।\nतस्याः सुनयनं वक्त्रमाकाशे रावणाङ्कगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000248021, "chapter_id": 9248, "verse_number": "३-५२-२१", "content_sanskrit": "रुदितं व्यपमृष्टास्रं चन्द्रवत् प्रियदर्शनम्।\nसुनासं चारुताम्रोष्ठमाकाशे हाटकप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000248022, "chapter_id": 9248, "verse_number": "३-५२-२२", "content_sanskrit": "राक्षसेन्द्रसमाधूतं तस्यास्तद् वदनं शुभम्।\nशुशुभे न विना रामं दिवा चन्द्र इवोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000248023, "chapter_id": 9248, "verse_number": "३-५२-२३", "content_sanskrit": "सा हेमवर्णा नीलाङ्गं मैथिली राक्षसाधिपम्।\nशुशुभे काञ्चनी काञ्ची नीलं गजमिवाश्रिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000248024, "chapter_id": 9248, "verse_number": "३-५२-२४", "content_sanskrit": "सा पद्मपीता हेमाभा रावणं जनकात्मजा।\nविद्युद् घनमिवाविश्य शुशुभे तप्तभूषणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000248025, "chapter_id": 9248, "verse_number": "३-५२-२५", "content_sanskrit": "तस्या भूषणघोषेण वैदेह्या राक्षसेश्वरः।\nबभूव विमलो नीलः सघोष इव तोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000248026, "chapter_id": 9248, "verse_number": "३-५२-२६", "content_sanskrit": "उत्तमाङ्गच्युता तस्याः पुष्पवृष्टिः समन्ततः।\nसीताया ह्रियमाणायाः पपात धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000248027, "chapter_id": 9248, "verse_number": "३-५२-२७", "content_sanskrit": "सा तु रावणवेगेन पुष्पवृष्टिः समन्ततः।\nसमाधूता दशग्रीवं पुनरेवाभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000248028, "chapter_id": 9248, "verse_number": "३-५२-२८", "content_sanskrit": "अभ्यवर्तत पुष्पाणां धारा वैश्रवणानुजम्।\nनक्षत्रमाला विमला मेरुं नगमिवोन्नतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000248029, "chapter_id": 9248, "verse_number": "३-५२-२९", "content_sanskrit": "चरणान्नूपुरं भ्रष्टं वैदेह्या रत्नभूषितम्।\nविद्युन्मण्डलसंकाशं पपात धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000248030, "chapter_id": 9248, "verse_number": "३-५२-३०", "content_sanskrit": "तरुप्रवालरक्ता सा नीलाङ्गं राक्षसेश्वरम्।\nप्रशोभयत वैदेही गजं कक्ष्येव काञ्चनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000248031, "chapter_id": 9248, "verse_number": "३-५२-३१", "content_sanskrit": "तां महोल्कामिवाकाशे दीप्यमानां स्वतेजसा।\nजहाराकाशमाविश्य सीतां वैश्रवणानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000248032, "chapter_id": 9248, "verse_number": "३-५२-३२", "content_sanskrit": "तस्यास्तान्यग्निवर्णानि भूषणानि महीतले।\nसघोषाण्यवशीर्यन्त क्षीणास्तारा इवाम्बरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000248033, "chapter_id": 9248, "verse_number": "३-५२-३३", "content_sanskrit": "तस्याः स्तनान्तराद् भ्रष्टो हारस्ताराधिपद्युतिः।\nवैदेह्या निपतन् भाति गङ्गेव गगनच्युता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000248034, "chapter_id": 9248, "verse_number": "३-५२-३४", "content_sanskrit": "उत्पातवाताभिरता नानाद्विजगणायुताः।\nमा भैरिति विधूताग्रा व्याजह्रुरिव पादपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000248035, "chapter_id": 9248, "verse_number": "३-५२-३५", "content_sanskrit": "नलिन्यो ध्वस्तकमलास्त्रस्तमीनजलेचराः।\nसखीमिव गतोत्साहां शोचन्तीव स्म मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000248036, "chapter_id": 9248, "verse_number": "३-५२-३६", "content_sanskrit": "समन्तादभिसम्पत्य सिंहव्याघ्रमृगद्विजाः।\nअन्वधावंस्तदा रोषात् सीताच्छायानुगामिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000248037, "chapter_id": 9248, "verse_number": "३-५२-३७", "content_sanskrit": "जलप्रपातास्रमुखाः शृङ्गैरुच्छ्रितबाहुभिः।\nसीतायां ह्रियमाणायां विक्रोशन्तीव पर्वताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000248038, "chapter_id": 9248, "verse_number": "३-५२-३८", "content_sanskrit": "ह्रियमाणां तु वैदेहीं दृष्ट्वा दीनो दिवाकरः।\nप्रविध्वस्तप्रभः श्रीमानासीत् पाण्डुरमण्डलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000248039, "chapter_id": 9248, "verse_number": "३-५२-३९", "content_sanskrit": "नास्ति धर्मः कुतः सत्यं नार्जवं नानृशंसता।\nयत्र रामस्य वैदेहीं सीतां हरति रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000248040, "chapter_id": 9248, "verse_number": "३-५२-४०", "content_sanskrit": "इति भूतानि सर्वाणि गणशः पर्यदेवयन्।\nवित्रस्तका दीनमुखा रुरुदुर्मृगपोतकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000248041, "chapter_id": 9248, "verse_number": "३-५२-४१", "content_sanskrit": "उद्वीक्ष्योद्वीक्ष्य नयनैर्भयादिव विलक्षणैः।\nसुप्रवेपितगात्राश्च बभूवुर्वनदेवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000248042, "chapter_id": 9248, "verse_number": "३-५२-४२", "content_sanskrit": "विक्रोशन्तीं दृढं सीतां दृष्ट्वा दुःखं तथा गताम्।\nतां तु लक्ष्मण रामेति क्रोशन्तीं मधुरस्वराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000248043, "chapter_id": 9248, "verse_number": "३-५२-४३", "content_sanskrit": "अवेक्षमाणां बहुशो वैदेहीं धरणीतलम्।\nस तामाकुलकेशान्तां विप्रमृष्टविशेषकाम्।\nजहारात्मविनाशाय दशग्रीवो मनस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000248044, "chapter_id": 9248, "verse_number": "३-५२-४४", "content_sanskrit": "ततस्तु सा चारुदती शुचिस्मिता\nविनाकृता बन्धुजनेन मैथिली।\nअपश्यती राघवलक्ष्मणावुभौ\nविवर्णवक्त्रा भयभारपीडिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000248045, "chapter_id": 9248, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे द्विपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]