[{"id": 2139938, "chapter_id": 4021, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2139939, "chapter_id": 4021, "verse_number": "१", "content_sanskrit": "ततो दुर्योधनो राजा श्रुत्वा तेषां वचस्तदा ।\nचिरमन्तर्मना भूत्वा प्रत्युवाच सभासदः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2139940, "chapter_id": 4021, "verse_number": "२", "content_sanskrit": "अशक्या खलु कार्याणां गतिर्ज्ञातुं हि तत्वतः ।\nतस्मात् सर्वे परीक्षध्वं क्व नु स्युः पाण्डवा गताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2139941, "chapter_id": 4021, "verse_number": "३", "content_sanskrit": "अल्पावशिष्टः कालस्तु गतभूयिष्ठ एव च ।\nतेषामज्ञातचर्यायामस्मिन् वर्षे त्रयोदशे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2139942, "chapter_id": 4021, "verse_number": "४", "content_sanskrit": "अपि वर्षं च शेषं चेद् व्यतीयुरिह पाण्डवाः ।\nनिवृत्तसमयास्ते हि सत्यव्रतपरायणाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2139943, "chapter_id": 4021, "verse_number": "५", "content_sanskrit": "क्षरन्त इव नागेन्द्राः सर्वे ह्याशीविषोपमाः ।\nदुःखाद् भवेयुः संरब्धाः कौरवान् प्रति ते ध्रुवम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2139944, "chapter_id": 4021, "verse_number": "६", "content_sanskrit": "विज्ञातव्या मनुष्येन्द्रास्तर्कया सुप्रणीतया ।\nनिपुणैश्चारपुरुषैः प्राज्ञैर्दक्षैः सुसम्मतैः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2139945, "chapter_id": 4021, "verse_number": "७", "content_sanskrit": "अज्ञातसमये ज्ञाताः कृच्छ्ररूपधराः पुनः ।\nप्रविशेयुर्जितक्रोधाः तावदेव पुनर्वनम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2139946, "chapter_id": 4021, "verse_number": "८", "content_sanskrit": "तस्मादाशु परीक्षध्वं यथा चात्यन्तमव्ययम् ।\nराज्यं निर्द्वन्द्वमव्यग्रमसपत्नं स्थिरं भवेत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2139947, "chapter_id": 4021, "verse_number": "९", "content_sanskrit": "ततः कर्णोऽब्रवीद् वाक्यं क्षिप्रं गच्छन्तु भारत ।\nशीघ्रवृत्ता नरा योग्या निपुणाश्छन्नचारिणः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2139948, "chapter_id": 4021, "verse_number": "१०", "content_sanskrit": "चरन्तु देशान् विविधान् स्फीतान् जनपदाकुलान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2139949, "chapter_id": 4021, "verse_number": "११", "content_sanskrit": "तत्र गोष्ठेष्वरण्येषु सिद्धा ब्राह्मणरूपिणः ।\nपरिवाहेषु तीर्थेषु विविधेष्वाकरेषु च\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2139950, "chapter_id": 4021, "verse_number": "१२", "content_sanskrit": "अन्वेष्टव्या मनुष्येन्द्र पाण्डवाश्छन्नचारिणः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2139951, "chapter_id": 4021, "verse_number": "१३", "content_sanskrit": "नदीकूलेषु तीर्थेषु ग्रामेषु नगरेषु च ।\nआश्रमेषु च रम्येषु पर्वतेषु वनेषु च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2139952, "chapter_id": 4021, "verse_number": "१४", "content_sanskrit": "विज्ञातव्या मनुष्येन्द्र तर्कया सुविनीतया ।\nविविधैस्तत्परैः सम्यङ् निपुणैस्तच्च सम्मतैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2139953, "chapter_id": 4021, "verse_number": "१५", "content_sanskrit": "अथाग्रजादवरजो पापभावः सुदुर्मतिः ।\nज्येष्ठं दुःशासनस्तत्र भ्राता भ्रातरमब्रवीत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2139954, "chapter_id": 4021, "verse_number": "१६", "content_sanskrit": "यदाह कर्णो राजेन्द्र सर्वमेतदवेक्ष्यताम् ।\nयेषु नः प्रत्ययो राजन् चारेषु मनुजाधिप\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2139955, "chapter_id": 4021, "verse_number": "१७", "content_sanskrit": "ते यान्तु दत्तदेया वै भूयस्तान् परिमार्गितुम् ।\nयथोद्दिष्टचराः सर्वे मृगयन्तु ततस्ततः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2139956, "chapter_id": 4021, "verse_number": "१८", "content_sanskrit": "घ्राणैः पश्यन्ति पशवो वेदैरेव द्विजोत्तमाः ।\nचारैः पश्यन्ति राजानः चक्षुर्भ्यामितरे जनाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2139957, "chapter_id": 4021, "verse_number": "१९", "content_sanskrit": "यथोक्ताश्चारपुरुषाः मृगयन्तु पुनः पुनः ।\nएतांश्चान्यांश्च सुबहून् देशान् जनपदांस्तथा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2139958, "chapter_id": 4021, "verse_number": "२०", "content_sanskrit": "न च तेषां गतिर्वासः प्रवृत्तिश्चोपलक्ष्यते ।\nप्रत्यागता वा गूढास्ते परमूर्तगुणा इव\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2139959, "chapter_id": 4021, "verse_number": "२१", "content_sanskrit": "व्यालैर्वाऽपि महारण्ये निहताः शूरमानिनः ।\nद्वीपं वा परमं प्राप्ता गिरिदुर्गवनेष्वपि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2139960, "chapter_id": 4021, "verse_number": "२२", "content_sanskrit": "हीनदर्पा निराशास्ते भक्षिता वाऽपि राक्षसैः ।\nअथवा विषमं प्राप्य विनष्टाः शाश्वतीः समाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2139961, "chapter_id": 4021, "verse_number": "२३", "content_sanskrit": "यथोद्दिष्टाश्चराः केचिद् देशान् गच्छन्तु संवृताः ।\nएते चान्ये च भूयोऽपि देशाद् देशं यथाविधि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2139962, "chapter_id": 4021, "verse_number": "समाप्तिः", "content_sanskrit": "इति तेषां गतिर्वासः प्रवृत्तिश्चोपलभ्यते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2139963, "chapter_id": 4021, "verse_number": "२५", "content_sanskrit": "तस्मान्मानसमव्यग्रं कृत्वाऽऽत्मानं नियम्य च ।\nकुरु कार्यं यथोत्साहं यन्मन्यसि नराधिप\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2139964, "chapter_id": 4021, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि एकोनत्रिंशोऽध्यायः ॥२९॥\nगोग्रहणपर्वणि द्वितीयोऽध्यायः ॥२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]