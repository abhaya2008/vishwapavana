[{"id": 900004178, "chapter_id": 8324, "verse_number": "2.1", "content_sanskrit": "प्रणम्य रमणं लक्ष्म्याः पूर्णबोधान्गुरूनपि । व्याख्यां तत्वविवेकस्य करिष्यामो यथामति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004179, "chapter_id": 8324, "verse_number": "2.2", "content_sanskrit": "ननु परमपुरुषादितत्वानां विवेकः शास्त्र एव कृतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004180, "chapter_id": 8324, "verse_number": "2.3", "content_sanskrit": "स्वतन्त्रं परतन्त्रं च प्रमेयं द्विविधं मतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004181, "chapter_id": 8324, "verse_number": "2.4", "content_sanskrit": "तत्र प्रमेयमित्यनुवादेनैव तत्वसामान्यलक्षणं चोक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004182, "chapter_id": 8324, "verse_number": "2.5", "content_sanskrit": "यथार्थज्ञानं प्रमा । तद्विषयः प्रमेयम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900004183, "chapter_id": 8324, "verse_number": "2.6", "content_sanskrit": "तत्प्रमेयं द्विविधम् ।। स्वतन्त्रं परतन्त्रं चेतीतिशब्दोऽध्याहार्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900004184, "chapter_id": 8324, "verse_number": "2.7", "content_sanskrit": "यत् स्वसत्तादौ स्वाधीनं न तु परापेक्षं तत् स्वतन्त्रम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900004185, "chapter_id": 8324, "verse_number": "2.8", "content_sanskrit": "एके तु एकमेव तत्वमिति मन्यन्ते । तदसत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900004186, "chapter_id": 8324, "verse_number": "2.9", "content_sanskrit": "स्वतन्त्रो भगवान्विष्णुर्निर्दोषाखिलसद्गुणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900004187, "chapter_id": 8324, "verse_number": "2.10", "content_sanskrit": "द्विविधं परतन्त्रञ्च भावोऽभाव इतीरितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900004188, "chapter_id": 8324, "verse_number": "2.11", "content_sanskrit": "पूर्वापरसदात्वेन त्रिविधोऽभाव इष्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900004189, "chapter_id": 8324, "verse_number": "2.12", "content_sanskrit": "भावाभावस्वरूपत्वान्नान्योन्याभावता पृथक्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900004190, "chapter_id": 8324, "verse_number": "2.13", "content_sanskrit": "चेतनोऽचेतनश्चेति भावश्च द्विविधः स्मृतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900004191, "chapter_id": 8324, "verse_number": "2.14", "content_sanskrit": "नित्यमुक्तश्च सृतियुक् परतन्त्रोऽपि चेतनः । द्विधैव..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900004192, "chapter_id": 8324, "verse_number": "2.15", "content_sanskrit": "श्रीर्नित्यमुक्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900004193, "chapter_id": 8324, "verse_number": "2.16", "content_sanskrit": "सृतियुक् च द्विधा मतः ..मुक्तोऽमुक्त इति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900004194, "chapter_id": 8324, "verse_number": "2.17", "content_sanskrit": "ह्यत्र ब्रह्मान्ता उत्तरोत्तरम् । मुक्ताः शतगुणाः प्रोक्ताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900004195, "chapter_id": 8324, "verse_number": "2.18", "content_sanskrit": "रमा तेभ्योऽखिलैर्गुणैः नित्यं बहुगुणोद्रिक्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900004196, "chapter_id": 8324, "verse_number": "2.19", "content_sanskrit": "ततोऽनन्तगुणो हरिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900004197, "chapter_id": 8324, "verse_number": "2.20", "content_sanskrit": "अमुक्तास्त्रिविधास्तत्र नीचमध्योच्चभेदतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900004198, "chapter_id": 8324, "verse_number": "2.21", "content_sanskrit": "तुशब्दोऽवधारणे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900004199, "chapter_id": 8324, "verse_number": "2.22", "content_sanskrit": "दुःखसंस्था मुक्तियोग्या इत्यादिविभागोऽप्यनेन सङ्गृहीतो भवति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900004200, "chapter_id": 8324, "verse_number": "2.23", "content_sanskrit": "द्विधैवाचेतनं मतम् नित्यानित्यत्वभेदेन", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900004201, "chapter_id": 8324, "verse_number": "2.24", "content_sanskrit": "सर्वानित्यत्वे चोपादानाद्यभावेन सृष्ट्यनुपपत्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900004202, "chapter_id": 8324, "verse_number": "2.25", "content_sanskrit": "नित्यानित्यत्वं नाम विधान्तरं तत्वसङ्ख्याने कथितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900004203, "chapter_id": 8324, "verse_number": "2.26", "content_sanskrit": "देशः कालः श्रुतिस्तथा । भूतेन्द्रियप्राणगुणसूक्ष्मरूपं च नित्यकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900004204, "chapter_id": 8324, "verse_number": "2.27", "content_sanskrit": "एषां विकारोऽनित्यः स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900004205, "chapter_id": 8324, "verse_number": "2.28", "content_sanskrit": "गुणक्रियाजातिपूर्वा धर्माः सर्वेऽपि वस्तुनः रूपमेव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900004206, "chapter_id": 8324, "verse_number": "2.29", "content_sanskrit": "द्विधं तच्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900004207, "chapter_id": 8324, "verse_number": "2.30", "content_sanskrit": "खण्डितं रूपमेवात्र विकारोऽपि विकारिणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900004208, "chapter_id": 8324, "verse_number": "2.31", "content_sanskrit": "कार्यकारणयोश्चैव तथैव गुणतद्वतोः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900004209, "chapter_id": 8324, "verse_number": "2.32", "content_sanskrit": "क्रियाक्रियावतोरपि गुणगुणिवद्भेदाभेदौ अत्यन्ताभेदश्च ज्ञातव्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900004210, "chapter_id": 8324, "verse_number": "2.33", "content_sanskrit": "जातिविशेषयोर्जातिव्यक्तयोरपि भेदाभेदावभेदश्च यथासम्भवं ज्ञातव्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900004211, "chapter_id": 8324, "verse_number": "2.34", "content_sanskrit": "तथाशब्द उपमायाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900004212, "chapter_id": 8324, "verse_number": "2.35", "content_sanskrit": "किञ्चाकाशस्य तावदंशाः सन्तीत्यङ्गीकार्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900004213, "chapter_id": 8324, "verse_number": "2.36", "content_sanskrit": "अनेन कार्यकारणादीनां समवायो नास्तीत्युक्तं भवति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900004214, "chapter_id": 8324, "verse_number": "2.37", "content_sanskrit": "य एतत्परतन्त्रं तु सर्वमेव हरेः सदा । वशमित्येव जानाति संसारान्मुच्यते हि सः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]