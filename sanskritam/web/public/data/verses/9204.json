[{"id": 5000204000, "chapter_id": 9204, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे अष्टमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000204001, "chapter_id": 9204, "verse_number": "३-८-१", "content_sanskrit": "रामस्तु सहसौमित्रिः सुतीक्ष्णेनाभिपूजितः।\nपरिणाम्य निशां तत्र प्रभाते प्रत्यबुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000204002, "chapter_id": 9204, "verse_number": "३-८-२", "content_sanskrit": "उत्थाय च यथाकालं राघवः सह सीतया।\nउपस्पृश्य सुशीतेन तोयेनोत्पलगन्धिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000204003, "chapter_id": 9204, "verse_number": "३-८-३", "content_sanskrit": "अथ तेऽग्निं सुरांश्चैव वैदेही रामलक्ष्मणौ।\nकाल्यं विधिवदभ्यर्च्य तपस्विशरणे वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000204004, "chapter_id": 9204, "verse_number": "३-८-४", "content_sanskrit": "उदयन्तं दिनकरं दृष्ट्वा विगतकल्मषाः।\nसुतीक्ष्णमभिगम्येदं श्लक्ष्णं वचनमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000204005, "chapter_id": 9204, "verse_number": "३-८-५", "content_sanskrit": "सुखोषिताः स्म भगवंस्त्वया पूज्येन पूजिताः।\nआपृच्छामः प्रयास्यामो मुनयस्त्वरयन्ति नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000204006, "chapter_id": 9204, "verse_number": "३-८-६", "content_sanskrit": "त्वरामहे वयं द्रष्टुं कृत्स्नमाश्रममण्डलम्।\nऋषीणां पुण्यशीलानां दण्डकारण्यवासिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000204007, "chapter_id": 9204, "verse_number": "३-८-७", "content_sanskrit": "अभ्यनुज्ञातुमिच्छामः सहैभिर्मुनिपुंगवैः।\nधर्मनित्यैस्तपोदान्तैर्विशिखैरिव पावकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000204008, "chapter_id": 9204, "verse_number": "३-८-८", "content_sanskrit": "अविषह्यातपो यावत् सूर्यो नातिविराजते।\nअमार्गेणागतां लक्ष्मीं प्राप्येवान्वयवर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000204009, "chapter_id": 9204, "verse_number": "३-८-९", "content_sanskrit": "तावदिच्छामहे गन्तुमित्युक्त्वा चरणौ मुनेः।\nववन्दे सहसौमित्रिः सीतया सह राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000204010, "chapter_id": 9204, "verse_number": "३-८-१०", "content_sanskrit": "तौ संस्पृशन्तौ चरणावुत्थाप्य मुनिपुंगवः।\nगाढमाश्लिष्य सस्नेहमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000204011, "chapter_id": 9204, "verse_number": "३-८-११", "content_sanskrit": "अरिष्टं गच्छ पन्थानं राम सौमित्रिणा सह।\nसीतया चानया सार्धं छाययेवानुवृत्तया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000204012, "chapter_id": 9204, "verse_number": "३-८-१२", "content_sanskrit": "पश्याश्रमपदं रम्यं दण्डकारण्यवासिनाम्।\nएषां तपस्विनां वीर तपसा भावितात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000204013, "chapter_id": 9204, "verse_number": "३-८-१३", "content_sanskrit": "सुप्राज्यफलमूलानि पुष्पितानि वनानि च।\nप्रशस्तमृगयूथानि शान्तपक्षिगणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000204014, "chapter_id": 9204, "verse_number": "३-८-१४", "content_sanskrit": "फुल्लपङ्कजखण्डानि प्रसन्नसलिलानि च।\nकारण्डवविकीर्णानि तटाकानि सरांसि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000204015, "chapter_id": 9204, "verse_number": "३-८-१५", "content_sanskrit": "द्रक्ष्यसे दृष्टिरम्याणि गिरिप्रस्रवणानि च।\nरमणीयान्यरण्यानि मयूराभिरुतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000204016, "chapter_id": 9204, "verse_number": "३-८-१६", "content_sanskrit": "गम्यतां वत्स सौमित्रे भवानपि च गच्छतु।\nआगन्तव्यं च ते दृष्ट्वा पुनरेवाश्रमं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000204017, "chapter_id": 9204, "verse_number": "३-८-१७", "content_sanskrit": "एवमुक्तस्तथेत्युक्त्वा काकुत्स्थः सहलक्ष्मणः।\nप्रदक्षिणं मुनिं कृत्वा प्रस्थातुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000204018, "chapter_id": 9204, "verse_number": "३-८-१८", "content_sanskrit": "ततः शुभतरे तूणी धनुषी चायतेक्षणा।\nददौ सीता तयोर्भ्रात्रोः खड्गौ च विमलौ ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000204019, "chapter_id": 9204, "verse_number": "३-८-१९", "content_sanskrit": "आबध्य च शुभे तूणी चापे चादाय सस्वने।\nनिष्क्रान्तावाश्रमाद् गन्तुमुभौ तौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000204020, "chapter_id": 9204, "verse_number": "३-८-२०", "content_sanskrit": "शीघ्रं तौ रूपसम्पन्नावनुज्ञातौ महर्षिणा।\nप्रस्थितौ धृतचापासी सीतया सह राघवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000204021, "chapter_id": 9204, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे अष्टमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]