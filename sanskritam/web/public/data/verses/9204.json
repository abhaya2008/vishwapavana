[{"id": 40014608, "chapter_id": 9204, "verse_number": "1", "content_sanskrit": "सुनिविष्टंहितंवाक्यमुक्तवन्तंविभीषणम् । अब्रवीत्परुषंवाक्यंरावणःकालचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014609, "chapter_id": 9204, "verse_number": "2", "content_sanskrit": "वसेत्सहसपत्नेनक्रुद्धेऽनाशीविषेणवा । नतुमित्रप्रवादेनसंवसेच्छत्रुसेविना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014610, "chapter_id": 9204, "verse_number": "3", "content_sanskrit": "जानामिशीलंज्ञातीनांसर्वलोकेषुराक्षस: । हृष्यन्तिव्यसनेष्वेतेज्ञातीनाज्ञातयस्सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014611, "chapter_id": 9204, "verse_number": "4", "content_sanskrit": "प्रथानंसाधनंवैद्यंधर्मशीलंचराक्षस: । ज्ञातयोह्यवमन्यन्तेशूरंपरिभवन्तिच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014612, "chapter_id": 9204, "verse_number": "5", "content_sanskrit": "नित्यमन्योन्यसम्हृष्टाव्यसनेष्वाततायिनः । प्रच्छन्नहृदयाघोराज्ञातयस्तुभयावहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014613, "chapter_id": 9204, "verse_number": "6", "content_sanskrit": "श्रूयन्तेहस्तिभिर्गीताश्श्लोकाःपद्मवनेक्वचित् । पाशहस्तान्नरान्द्रुष्टवाशृणुतान्गदतोमम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014614, "chapter_id": 9204, "verse_number": "7", "content_sanskrit": "नाग्निर्नान्यानिशस्त्राणिननःपाशाभयावहाः । घोरास्स्वार्थप्रयुक्तास्तुज्ञातयोनोभयावहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014615, "chapter_id": 9204, "verse_number": "8", "content_sanskrit": "उपायमेतेवक्ष्यन्तिग्रहणेनात्रसंशयः । कृत्स्नाद्भयाद् ज्ञातिभयंसुकष्टंविदितंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014616, "chapter_id": 9204, "verse_number": "9", "content_sanskrit": "विद्यतेगोषुसम्पन्नंविद्यतेब्राह्मणेदमः । विद्यतेस्त्रीषुचापल्यंविद्यतेज्ञातितोभयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014617, "chapter_id": 9204, "verse_number": "10", "content_sanskrit": "ततोनेष्टमिदंसौम्ययदहंलोकसत्कृतः । ऐश्वर्यमभिजातश्चज्ञातीनांमूर्ध्न्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014618, "chapter_id": 9204, "verse_number": "11", "content_sanskrit": "यथापुष्करपत्रेषुपतितास्तोयबिन्दवः । नश्लेषमभिगच्छन्तितथाऽनार्येषुसङ्गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014619, "chapter_id": 9204, "verse_number": "12", "content_sanskrit": "यथामधुकरस्तर्षाद्रसंविन्दन्नविद्यते । तथात्वमपितत्रैवतथानार्येषुसौहृदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014620, "chapter_id": 9204, "verse_number": "13", "content_sanskrit": "यथापूर्वंगजस्स्नात्वागृह्यहस्तेनवैरजः । दूषयत्यात्मनोदेहंतथानार्येषुसङ्गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014621, "chapter_id": 9204, "verse_number": "14", "content_sanskrit": "यथाशरदिमेघानांसिञ्चतामपिगर्जताम् । नभवत्यम्बुसंक्लेदस्तथाऽनार्येषुसौहृदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014622, "chapter_id": 9204, "verse_number": "15", "content_sanskrit": "यथामधुकरस्तर्षात्काशपुष्पंपिबन्नपि । रसमत्रनविन्देततथानार्वेषुसौहृदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40014623, "chapter_id": 9204, "verse_number": "16", "content_sanskrit": "अन्यस्त्वेवंविधंब्रूयाद्वाक्यमेतन्निशाचर: । अस्मिन्मुहूर्तेनभवेत्त्वांतुधिक्कुलपांसन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40014624, "chapter_id": 9204, "verse_number": "17", "content_sanskrit": "इत्युक्तःपरुषंवाक्यंन्यायवादीविभीषणः । उत्पपातगदापाणिश्चतुर्भिस्सहराक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40014625, "chapter_id": 9204, "verse_number": "18", "content_sanskrit": "अब्रवीच्चतदावाक्यंजातक्रोधोविभीषणः । अन्तरिक्षगत्शीमान्भ्रातरंराक्षसाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40014626, "chapter_id": 9204, "verse_number": "19", "content_sanskrit": "सत्वंभ्राताऽसिमेराजन्ब्रूहिमांयद्यदिच्छसि । ज्येष्टोमान्यःपितृसमोनचधर्मपथेस्थितः ॥ इदंतुपरुषंवाक्यंनक्षमाम्यग्रजस्यते ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40014627, "chapter_id": 9204, "verse_number": "20", "content_sanskrit": "सुनीतंहितकामेनवाक्यमुक्तंदशानन: । नगृह्णन्त्यकृतात्मानःकालस्यवशमागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40014628, "chapter_id": 9204, "verse_number": "21", "content_sanskrit": "सुलभाःपुरुषराजन् सततंप्रियवादिनः । अप्रियस्यचपथ्यस्यवक्ताश्रोताचदुर्लभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40014629, "chapter_id": 9204, "verse_number": "22", "content_sanskrit": "बद्धंकालस्यपाशेनसर्वभूतापहारिणा । ननश्यन्तमुपेक्षेत्वांप्रदीप्तंशरणंयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40014630, "chapter_id": 9204, "verse_number": "23", "content_sanskrit": "दीप्तपावकसङ्काशैश्शितैःकाञ्चनभूषणैः । नत्वामिच्छाम्यहंद्रष्टुंरामेणनिहतंशरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40014631, "chapter_id": 9204, "verse_number": "24", "content_sanskrit": "शूराश्चबलवन्तश्चकृतास्त्राश्चरणाजिरे । कालाभिपन्नास्सीदन्तियथावालुकसेतव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40014632, "chapter_id": 9204, "verse_number": "25", "content_sanskrit": "तन्मर्षयतुयच्चोक्तंगुरुत्वाद्धितमिच्छता ॥ अत्मानंसर्वथारक्षपुरींचेमांसराक्षसाम् । स्वस्तितेऽस्तुगमिष्यामिसुखीभवमयाविना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40014633, "chapter_id": 9204, "verse_number": "26", "content_sanskrit": "तन्मर्षयतुयच्चोक्तंगुरुत्वाद्धितमिच्छता ॥ अत्मानंसर्वथारक्षपुरींचेमांसराक्षसाम् । स्वस्तितेऽस्तुगमिष्यामिसुखीभवमयाविना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40014634, "chapter_id": 9204, "verse_number": "27", "content_sanskrit": "निवार्यमाणस्यमयाहितैषिणानरोचतेतेवचनंनिशाचर: । परीतकालाहिगतायुषोनराहितंनगृह्णन्तिसुहृद्भिरीरितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]