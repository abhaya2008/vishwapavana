[{"id": 2114131, "chapter_id": 3456, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114132, "chapter_id": 3456, "verse_number": "१", "content_sanskrit": "एतस्मिन्नेव काले तु तस्मिन् जनसमागमे ।\nदत्तेऽवकाशे पुरुषैर्विस्मयोत्फुल्ललोचनैः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114133, "chapter_id": 3456, "verse_number": "२", "content_sanskrit": "विवेश रङ्गं विस्तीर्णं कर्णः परपुरञ्जयः ।\nसहजं कवचं बिभ्रत् कुण्डलोद्योतिताननः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114134, "chapter_id": 3456, "verse_number": "३", "content_sanskrit": "सधनुर्बद्धनिस्त्रिंशः साक्षादिव दिवाकरः ।\nस कानीनः पृथुयशाः पृथायाः पृथुलोचनः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114135, "chapter_id": 3456, "verse_number": "४", "content_sanskrit": "तीक्ष्णांशोर्भास्करस्यांशः कर्णोऽरिगणनाशनः ।\nसिंहर्षभगजेन्द्राणां तुल्यवीर्यपराक्रमः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114136, "chapter_id": 3456, "verse_number": "५", "content_sanskrit": "दीप्तिकान्तिद्युतिगुणैः सूर्येन्दुज्वलनोपमः ।\nप्रांशुः कनकतालाभः सिंहसंहननो युवा \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114137, "chapter_id": 3456, "verse_number": "६", "content_sanskrit": "प्रसङ्ख्येयगुणः श्रीमान् भास्करस्यात्मसम्भवः ।\nस समीक्ष्य महाबाहुः सर्वतो रङ्गमण्डपम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114138, "chapter_id": 3456, "verse_number": "७", "content_sanskrit": "प्रणामं द्रोणकृपयोर्नामपूर्वमथाकरोत् ।\nस समाजे जनः सर्वो निश्चलः स्थिरलोचनः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114139, "chapter_id": 3456, "verse_number": "८", "content_sanskrit": "कोऽयमित्यागतक्षोभः कौतूहलपरोऽभवत् ।\nसोऽब्रवीन्मेघधीरेण स्वरेण वदतां वरः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114140, "chapter_id": 3456, "verse_number": "९", "content_sanskrit": "भ्राता भ्रातरमज्ञातं सावित्रः पाकशासनिम् ।\nपार्थ यत् ते कृतं कर्म विशेषवदहं ततः ।\nकरिष्ये पश्यतां नॄणां मा भूदात्मनि विस्मयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114141, "chapter_id": 3456, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114142, "chapter_id": 3456, "verse_number": "१०", "content_sanskrit": "असमाप्ते ततस्तस्य वचने वदतां वर ।\nयन्त्रक्षिप्त इव क्षिप्रमुत्थितः सर्वतो जनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114143, "chapter_id": 3456, "verse_number": "११", "content_sanskrit": "प्रीतिश्च पुरुषव्याघ्र दुर्योधनमुपास्पृशत् ।\nह्रीश्च क्रोधश्च बीभत्सुं क्षणेन त्वाविवेश ह\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114144, "chapter_id": 3456, "verse_number": "१२", "content_sanskrit": "ततो द्रोणाभ्यनुज्ञातः कर्णः प्रियतरस्तदा ।\nयत् कृतं कर्म पार्थेन न्यक्चकार महाबलः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114145, "chapter_id": 3456, "verse_number": "१३", "content_sanskrit": "अथ दुर्योधनस्तत्र भ्रातृभिः सह भारत ।\nकर्णं परिष्वज्य मुदा तत्र वचनमब्रवीत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114146, "chapter_id": 3456, "verse_number": "१४", "content_sanskrit": "स्वागतं ते महाबाहो दिष्ट्या प्राप्तोऽसि मानद ।\nअहं च कुरुराष्ट्रं च यथेष्टमुपभुज्यताम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114147, "chapter_id": 3456, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114148, "chapter_id": 3456, "verse_number": "१५", "content_sanskrit": "कृतं सर्वेण मे राजन् सखित्वं भवता वृणे ।\nद्वन्द्वयुद्धं च पार्थेन कर्तुमिच्छामि भारत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114149, "chapter_id": 3456, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114150, "chapter_id": 3456, "verse_number": "१६", "content_sanskrit": "ततः क्षिप्तमिवात्मानं मत्वा पार्थोऽभ्यभाषत ।\nकर्णं भ्रातृसमूहस्य मध्येऽचलमिव स्थितम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114151, "chapter_id": 3456, "verse_number": "१७", "content_sanskrit": "अनाहूतोपसृष्टानामनाहूतोपजल्पताम् ।\nये लोकास्तान् हतः कर्ण मया त्वं प्रतिपत्स्यसे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114152, "chapter_id": 3456, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114153, "chapter_id": 3456, "verse_number": "१८", "content_sanskrit": "रङ्गोऽयं सर्वसामान्यः किमत्र तव फल्गुन ।\nवीर्यश्रेष्ठाश्च राजन्या बलं धर्मोऽनुवर्तते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114154, "chapter_id": 3456, "verse_number": "१९", "content_sanskrit": "किं क्षेपैः दुर्बलायासैः शरैः कथय भारत ।\nगुरोः समक्षं यावत् ते हराम्यद्य शिरः शरैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114155, "chapter_id": 3456, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114156, "chapter_id": 3456, "verse_number": "२०", "content_sanskrit": "ततो द्रोणाभ्यनुज्ञातः पार्थः परपुरञ्जयः ।\nभ्रातृभिस्त्वरयाऽऽश्लिष्टो रणायोपजगाम तम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2114157, "chapter_id": 3456, "verse_number": "२१", "content_sanskrit": "ततो दुर्योधनेनापि सभ्रात्रा समरोद्यतः ।\nपरिष्वक्तः स्थितः कर्णः प्रगृह्य सशरं धनुः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2114158, "chapter_id": 3456, "verse_number": "२२", "content_sanskrit": "ततः सविद्युत्स्तनितैः सेन्द्रायुधपुरोजलैः ।\nआवृतं गगनं मेघैर्बलाकापङ्क्तिभासिभिः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2114159, "chapter_id": 3456, "verse_number": "२३", "content_sanskrit": "ततः स्नेहाद्धरिहयं दृष्ट्वा रङ्गावलोकनम् ।\nभास्करोऽप्यनयन्नाशं समीपोपगतान् घनान् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2114160, "chapter_id": 3456, "verse_number": "२४", "content_sanskrit": "मेघच्छायोपगूढश्च ततोऽदृश्यत पाण्डवः ।\nसूर्यातपपरिष्वक्तः कर्णोऽपि समदृश्यत \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2114161, "chapter_id": 3456, "verse_number": "२५", "content_sanskrit": "धार्तराष्ट्रा यतः कर्णस्तस्मिन् देशे व्यवस्थिताः ।\nभारद्वाजः कृपो भीष्मो यतः पार्थस्ततोऽभवन्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2114162, "chapter_id": 3456, "verse_number": "२६", "content_sanskrit": "द्विधा रङ्गः समभवत् स्त्रीणां द्वैधमजायत ।\nकुन्तिभोजसुता मोहं विज्ञातार्था जगाम ह\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2114163, "chapter_id": 3456, "verse_number": "२७", "content_sanskrit": "तां तथा मोहमापन्नां विदुरः सर्वधर्मवित् ।\nकुन्तीमाश्वासयामास प्रोक्ष्य चन्दनवारिभिः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2114164, "chapter_id": 3456, "verse_number": "२८", "content_sanskrit": "ततः प्रत्यागतप्राणा तावुभावपि दंसितौ ।\nपुत्रौ दृष्ट्वा सुसन्तप्ता नान्वपद्यत किञ्चन\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2114165, "chapter_id": 3456, "verse_number": "२९", "content_sanskrit": "तावुद्यतमहाचापौ कृपः शारद्वतोऽब्रवीत् ।\nद्वन्द्वयुद्धसमाचारे कुशलः सर्वधर्मवित् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2114166, "chapter_id": 3456, "verse_number": "३०", "content_sanskrit": "अयं पृथायास्तनयः कनीयान् पाण्डुनन्दनः ।\nकौरवो भवता सार्धं द्वन्द्वयुद्धं करिष्यति\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2114167, "chapter_id": 3456, "verse_number": "३१", "content_sanskrit": "त्वमप्येवं महाबाहो मातरं पितरं कुलम् ।\nकथयस्व नरेन्द्राणां किं च त्वं भूषयेः कुलम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2114168, "chapter_id": 3456, "verse_number": "३२", "content_sanskrit": "ततो विदित्वा पार्थश्च प्रतियोत्स्यति वा नवा ।\nवृथाकुलसमाचारैर्न युध्यन्ते नृपात्मजाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2114169, "chapter_id": 3456, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2114170, "chapter_id": 3456, "verse_number": "३३", "content_sanskrit": "एवमुक्तस्य कर्णस्य व्रीडावनतमाननम् ।\nबभौ वर्षाम्बुदक्लिन्नं पद्ममागलितं यथा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2114171, "chapter_id": 3456, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2114172, "chapter_id": 3456, "verse_number": "३४", "content_sanskrit": "आचार्य त्रिविधा योनी राज्ञां धर्मविनिश्चये ।\nसत्कुलीनश्च शूरश्च यश्च सेनां विकर्षति\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2114173, "chapter_id": 3456, "verse_number": "३५", "content_sanskrit": "अद्भ्योऽग्निर्ब्रह्मतः क्षत्रमश्मनो लोहमुत्थितम् ।\nतेषां सर्वत्रगं तेजः स्वासु योनिषु शाम्यति\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2114174, "chapter_id": 3456, "verse_number": "३६", "content_sanskrit": "यद्ययं फल्गुनो युद्धे नाराज्ञा योद्धुमिच्छति ।\nतस्मादेषोङ्गविषये मया राज्येऽभिषिच्यते\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2114175, "chapter_id": 3456, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2114176, "chapter_id": 3456, "verse_number": "३७", "content_sanskrit": "ततो राजानमामन्त्र्य गाङ्गेयं च पितामहम् ।\nअभिषेकस्य सम्भारान् समानीय द्विजातिभिः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2114177, "chapter_id": 3456, "verse_number": "३८", "content_sanskrit": "गोसहस्रायुतं दत्त्वा युक्तानां पुण्यकर्मणाम् ।\nअर्होऽयमङ्गराज्यस्य इति वाच्य द्विजातिभिः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2114178, "chapter_id": 3456, "verse_number": "३९", "content_sanskrit": "ततस्तस्मिन् क्षणे कर्णः सलाजकुसुमैर्घटैः ।\nकाञ्चनैः काञ्चने पीठे मन्त्रविद्भिर्द्विजातिभिः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2114179, "chapter_id": 3456, "verse_number": "४०", "content_sanskrit": "अभिषिक्तोऽङ्गराज्ये स्म श्रिया युक्तो महाबलः ।\nस मौलिहारकेयूरैः सहस्ताभरणाङ्गदैः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2114180, "chapter_id": 3456, "verse_number": "४१", "content_sanskrit": "राजलिङ्गैस्तथाऽन्यैश्च भूषितो भूषणैः शुभैः ।\nसच्छत्रवालव्यजनैः जयशब्दोत्तरेण च\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2114181, "chapter_id": 3456, "verse_number": "४२", "content_sanskrit": "सभाज्यमानो विप्रैश्च प्रदत्त्वा ह्यमितं वसु ।\nउवाच वचनं राजा राज्ञां मध्ये वृषस्तदा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2114182, "chapter_id": 3456, "verse_number": "४३", "content_sanskrit": "अस्य राज्यप्रदानस्य सदृशं किं ददामि ते ।\nतद् ब्रूहि राजशार्दूल कर्तव्यं हि तवानघ \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2114183, "chapter_id": 3456, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2114184, "chapter_id": 3456, "verse_number": "", "content_sanskrit": "अत्यन्तं सख्यमिच्छामि त्वया सह महाबल ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2114185, "chapter_id": 3456, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2114186, "chapter_id": 3456, "verse_number": "४४", "content_sanskrit": "एवमुक्तस्ततः कर्णः तथेति प्रत्यभाषत \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2114187, "chapter_id": 3456, "verse_number": "४५", "content_sanskrit": "अङ्गराज्यस्य युक्तानि दत्वा राजपरिच्छदान् ।\nहर्षाच्चैनं परिष्वज्य परां मुदमवाप ह \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2114188, "chapter_id": 3456, "verse_number": "१३५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nपञ्चत्रिंशत्यधिकशततमोऽध्यायः ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2114189, "chapter_id": 3456, "verse_number": "८३", "content_sanskrit": "॥ इति सम्भवपर्वणि त्र्यशीतितमोऽध्यायः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2114190, "chapter_id": 3456, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]