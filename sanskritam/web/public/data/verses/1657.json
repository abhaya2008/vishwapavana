[{"id": 2030057, "chapter_id": 1657, "verse_number": "३-२९५-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030058, "chapter_id": 1657, "verse_number": "३-२९५-१", "content_sanskrit": "अथ मद्राधिपो राजा नारदेन समागतः।\nउपविष्टः सभामध्ये कथायोगेन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030059, "chapter_id": 1657, "verse_number": "३-२९५-२", "content_sanskrit": "ततोऽभिगम्य तीर्थानि सर्वाण्येवाश्रमांस्तथा।\nआजगाम पितुर्वेश्म सावित्री सह मन्त्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030060, "chapter_id": 1657, "verse_number": "३-२९५-३", "content_sanskrit": "नारदेन सहासीनं सा दृष्ट्वा पितरं शुभा।\nउभयोरेव शिरसा चक्रे पादाभिवादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030061, "chapter_id": 1657, "verse_number": "३-२९५-४x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030062, "chapter_id": 1657, "verse_number": "३-२९५-४", "content_sanskrit": "क्व गताऽभूत्सुतेयं ते कुतश्चैवागता नृप।\nकिमर्थं युवतीं भद्र न चैनां संप्रयच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030063, "chapter_id": 1657, "verse_number": "३-२९५-५x", "content_sanskrit": "अश्वपतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030064, "chapter_id": 1657, "verse_number": "३-२९५-५", "content_sanskrit": "कार्येण खल्वनेनैव प्रेषिताद्यैव चागता।\nएतस्याः शृणु देवर्षे भर्तारं योऽनया वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030065, "chapter_id": 1657, "verse_number": "३-२९५-६x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030066, "chapter_id": 1657, "verse_number": "३-२९५-६", "content_sanskrit": "सा ब्रूहि विस्तरेणेति पित्रा संयोदिता शुभा।\nतदैव तस्य वचनं प्रतिगृह्येदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030067, "chapter_id": 1657, "verse_number": "३-२९५-७", "content_sanskrit": "आसीत्साल्वेषु धर्मात्मा क्षत्रियः पृथिवीपतिः।\nद्युमत्सेन इति ख्यातः पश्चाच्चान्धो बभूव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030068, "chapter_id": 1657, "verse_number": "३-२९५-८", "content_sanskrit": "विनष्टचक्षुषस्तस्य बालपुत्रस्य धीमतः।\nसामीप्येन हृतं राज्यं छिद्रेऽस्मिन्पूर्ववैरिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030069, "chapter_id": 1657, "verse_number": "३-२९५-९", "content_sanskrit": "स बालवत्सया सार्धं भार्यया प्रस्थितो वनम्।\nमहारण्यं गतश्चापि पस्तेषे महाव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030070, "chapter_id": 1657, "verse_number": "३-२९५-१०", "content_sanskrit": "तस्य पुत्रः पुरे जातः संवृद्धश्च तपोवने।\nसत्यवाननुरूपो मे भर्तेति मनसा वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030071, "chapter_id": 1657, "verse_number": "३-२९५-११x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030072, "chapter_id": 1657, "verse_number": "३-२९५-११", "content_sanskrit": "अहो वत महत्पापं सावित्र्या नृपते कृतम्।\nअजानन्त्या यदनया गुणवान्सत्यवान्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030073, "chapter_id": 1657, "verse_number": "३-२९५-१२", "content_sanskrit": "सत्यं वदत्यस्य पिता सत्यं माता प्रभाषते।\nतथाऽस् ब्राह्मणाश्चक्रुर्नामैतत्सत्यवानिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030074, "chapter_id": 1657, "verse_number": "३-२९५-१३", "content_sanskrit": "बालस्याश्वाः प्रियाश्चास्य करोत्यश्वांश्च मृन्मयान्।\nचित्रेऽपि विलिखत्यश्वांश्चित्राश्व इति चोच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030075, "chapter_id": 1657, "verse_number": "३-२९५-१४x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030076, "chapter_id": 1657, "verse_number": "३-२९५-१४", "content_sanskrit": "अपीदानीं स तेजस्वी बुद्धिमान्वा नृपात्मजः।\nक्षमावानपि वा शृरः सत्यवान्पितृवत्सलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030077, "chapter_id": 1657, "verse_number": "३-२९५-१५x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030078, "chapter_id": 1657, "verse_number": "३-२९५-१५", "content_sanskrit": "विवस्वानिव तेजस्वी वृहस्पतिसमो मतौ।\nमहेन्द्र इवन वीरश्च वसुधेव क्षमान्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2030079, "chapter_id": 1657, "verse_number": "३-२९५-१६x", "content_sanskrit": "अश्वपतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2030080, "chapter_id": 1657, "verse_number": "३-२९५-१६", "content_sanskrit": "अपि राजात्मजो दाता ब्रह्मण्यश्चापि सत्यवान्।\nरूपवानप्युदारो वाऽप्यथवा प्रियदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2030081, "chapter_id": 1657, "verse_number": "३-२९५-१७x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2030082, "chapter_id": 1657, "verse_number": "३-२९५-१७", "content_sanskrit": "सांकृते रन्तिदेवस् स्वशक्त्या दानतः समः।\nब्रह्मण्यः सत्यवादी च शिबिरौशीनरो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2030083, "chapter_id": 1657, "verse_number": "३-२९५-१८", "content_sanskrit": "ययातिरिव चोदारः सोमवत्प्रियदर्शनः।\nरूपेणान्यतमोऽश्विभ्यां द्युमत्सेनसुतो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2030084, "chapter_id": 1657, "verse_number": "३-२९५-१९", "content_sanskrit": "`स वदान्यः स तेजस्वीधीमांश्चैव क्षमान्वितः।\nस दान्तः स मृदुः शूरः स सत्यः संयतेन्द्रियः।\nसन्मैत्रः सोनसूयश्च स ह्रीमान्द्युतिमांश्च सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2030085, "chapter_id": 1657, "verse_number": "३-२९५-२०", "content_sanskrit": "नित्यशश्चार्जवं तस्मिन्धृतिस्तत्रैव च ध्रुवा।\nसंक्षेपतस्तपोवृद्धैः शीलवृद्धैश्च कथ्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2030086, "chapter_id": 1657, "verse_number": "३-२९५-२१x", "content_sanskrit": "अश्वपतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2030087, "chapter_id": 1657, "verse_number": "३-२९५-२१", "content_sanskrit": "गुणैरुपेतं सर्वैस्तं भगवन्प्रब्रवीषि मे।\nदोषानप्यस्य मे ब्रूहि यदि सन्तीह केचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2030088, "chapter_id": 1657, "verse_number": "३-२९५-२२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2030089, "chapter_id": 1657, "verse_number": "३-२९५-२२", "content_sanskrit": "एक एवास्य दोषो हि गुणानाक्रम्य तिष्ठति।\nस च दोषः प्रयत्नेन न शक्यमतिवर्तितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2030090, "chapter_id": 1657, "verse_number": "३-२९५-२३", "content_sanskrit": "एको दोषोऽस्ति नान्योऽस्य सोद्यप्रभृति सत्यवान्।\nसंवत्सरेण क्षीणायुर्देहन्यासं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2030091, "chapter_id": 1657, "verse_number": "३-२९५-२४x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2030092, "chapter_id": 1657, "verse_number": "३-२९५-२४", "content_sanskrit": "एहि सावित्रि गच्छस्व अन्यं वरय शोभने।\nतस्य दोषो महानेको गुणानाक्रम्य च स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2030093, "chapter_id": 1657, "verse_number": "३-२९५-२५", "content_sanskrit": "यथा मे भगवानाह नारदो देवसत्कृतः।\nसंवत्सरेण सोऽल्पायुर्देहन्यासं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2030094, "chapter_id": 1657, "verse_number": "३-२९५-२६x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2030095, "chapter_id": 1657, "verse_number": "३-२९५-२६", "content_sanskrit": "सकृदंशो निपतति सकृत्कन्या प्रदीयते।\nस कृदाह ददानीति त्रीण्येतानि सकृत्सकृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2030096, "chapter_id": 1657, "verse_number": "३-२९५-२७", "content_sanskrit": "दीर्घायुरथवाऽल्पायुः सगुणो निर्गुणोऽपि वा।\nसकृद्वृतो मया भर्ता न द्वितीयं वृणोम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2030097, "chapter_id": 1657, "verse_number": "३-२९५-२८", "content_sanskrit": "मनसा निश्चयं कृत्वाततो वाचाऽभिधीयते।\nक्रियते कर्मणा पश्चात्प्रमाणं मे मनस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2030098, "chapter_id": 1657, "verse_number": "३-२९५-२९x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2030099, "chapter_id": 1657, "verse_number": "३-२९५-२९", "content_sanskrit": "स्थिरा बुद्धिर्नरश्रेष्ठ सावित्र्या दुहितुस्तव।\nनैषा वारयितुं शक्या धर्मादस्मात्कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2030100, "chapter_id": 1657, "verse_number": "३-२९५-३०", "content_sanskrit": "नान्यस्मिन्पुरुषे सन्ति ये सत्यवति वै गुणाः।\nप्रदानमेव तस्मान्मे रोचते दुहितुस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2030101, "chapter_id": 1657, "verse_number": "३-२९५-३१x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2030102, "chapter_id": 1657, "verse_number": "३-२९५-३१", "content_sanskrit": "अविचाल्यमेतदुक्तं तथ्यं च भवता वचः।\nकरिष्याम्येतदेवं च गुरुर्हि भगवान्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2030103, "chapter_id": 1657, "verse_number": "३-२९५-३२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2030104, "chapter_id": 1657, "verse_number": "३-२९५-३२", "content_sanskrit": "अविघ्नमस्तु सावित्र्याः प्रदाने दुहितुस्तव।\nसाधयिष्याम्यहं तावत्सर्वेषां भद्रमस्तु वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2030105, "chapter_id": 1657, "verse_number": "३-२९५-३३x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2030106, "chapter_id": 1657, "verse_number": "३-२९५-३३", "content_sanskrit": "एवमुक्त्वा स्वमुत्पत्य नारदस्त्रिदिवं गतः।\nराजाऽपि दुहितुः सज्जं वैवाहिकमकारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2030107, "chapter_id": 1657, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि पतिव्रतामाहात्म्यपर्वणि पञ्चनवत्यधिकद्विशततमोऽध्यायः ॥ २९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]