[{"id": 2102792, "chapter_id": 3227, "verse_number": "१४-८३-१", "content_sanskrit": "वैशम्पायन उवाच।\nस तु वाजी समुद्रान्तां पर्येत्य वसुधामिमाम्।\nनिवृत्तोऽभिमुखो राजन्येन वारणसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102793, "chapter_id": 3227, "verse_number": "१४-८३-२", "content_sanskrit": "अनुगच्छंश्च तुरगं निवृत्तोऽथ किरीटभृत्।\nयदृच्छया समापेदे पुरं राजगृहं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102794, "chapter_id": 3227, "verse_number": "१४-८३-३", "content_sanskrit": "तमभ्याशगतं दृष्ट्वा सहदेवात्मजः प्रभो।\nक्षत्रधर्मे स्थितो वीरः समरायाजुहाव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102795, "chapter_id": 3227, "verse_number": "१४-८३-४", "content_sanskrit": "ततः पुरात्स निष्क्रम्य रथी धन्वी शरी तली।\nमेघसन्धिः पदातिं तं धनंजयमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102796, "chapter_id": 3227, "verse_number": "१४-८३-५", "content_sanskrit": "आसाद्य च महातेजा मेघसन्धिर्धनंजयम्।\nबालभावान्महाराज प्रोवाचेदं न कौशलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102797, "chapter_id": 3227, "verse_number": "१४-८३-६", "content_sanskrit": "किमयं चार्यते वाजी स्इत्रीमध्य इव भारत।\nहयमेनं हरिष्यामि प्रयतस्व विमोक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102798, "chapter_id": 3227, "verse_number": "१४-८३-७", "content_sanskrit": "अदत्तानुनयो युद्धे यदि त्वं पितृभिर्मम।\nकरिष्यामि तवातिथ्यं प्रहर प्रहरामि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102799, "chapter_id": 3227, "verse_number": "१४-८३-८", "content_sanskrit": "इत्युक्तः प्रत्युवाचैनं प्रहसन्निव पाण्डवः।\nविघ्नकर्ता मया वार्य इति मे व्रतमाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102800, "chapter_id": 3227, "verse_number": "१४-८३-९", "content_sanskrit": "भ्रात्रा ज्येष्ठेन नृपते तवापि विदितं ध्रुवम्।\nप्रहरस्व यथाशक्ति न मन्युर्विद्यते मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102801, "chapter_id": 3227, "verse_number": "१४-८३-१०", "content_sanskrit": "इत्युक्तः प्राहरत्पूर्वं पाण्डवं मगधेस्वरः।\nकिरञ्शरसहस्राणि वर्षाणीव सहस्रदृक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102802, "chapter_id": 3227, "verse_number": "१४-८३-११", "content_sanskrit": "ततो गाण्डीवभृच्छूरो गाण्डीवप्रहितैः शरैः।\nचकार मोघांस्तान्बाणान्सयत्नान्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102803, "chapter_id": 3227, "verse_number": "१४-८३-१२", "content_sanskrit": "स मोघं तस्य बाणौघं कृत्वा वानरकेतनः।\nशरात्मुमोच ज्वलितान्दीप्तास्यानिव पन्नगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102804, "chapter_id": 3227, "verse_number": "१४-८३-१३", "content_sanskrit": "ध्वजे पताकादण्डेषु रथे यन्त्रे हयेषु च।\nअन्येषु च रथाङ्गेषु न शरीरे न सारथौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102805, "chapter_id": 3227, "verse_number": "१४-८३-१४", "content_sanskrit": "संरक्ष्यमाणः पार्थेन शरीरे सव्यसाचिना।\nमन्यमानः स्ववीर्यं तन्मागधः प्राहिणोच्छरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102806, "chapter_id": 3227, "verse_number": "१४-८३-१५", "content_sanskrit": "ततो गाण्डीवधन्वा तु मागधेन भृशाहतः।\nबभौ वसन्तसमये पलासः पुष्पितो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102807, "chapter_id": 3227, "verse_number": "१४-८३-१६", "content_sanskrit": "अवध्यमानः सोऽभ्यघ्नन्मागधः पाण्डवर्षभम्।\nतेन तस्थौ स कौरव्य लोकवीरस्य दर्शने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102808, "chapter_id": 3227, "verse_number": "१४-८३-१७", "content_sanskrit": "सव्यसाची तु संक्रुद्धो विकृष्य बलवद्धनुः।\nहयांश्चकार निर्जीवान्सारथेश्च शिरोऽहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102809, "chapter_id": 3227, "verse_number": "१४-८३-१८", "content_sanskrit": "धनुश्चास्य महच्चित्रं क्षुरेण प्रचकर्त ह।\nहस्तावापं पताकां च ध्वजं चास्यन्यपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102810, "chapter_id": 3227, "verse_number": "१४-८३-१९", "content_sanskrit": "स राजा व्यथितो व्यश्वो विधनुर्हतसारथिः।\nगदामादाय कौन्तेयमभिद्रद्राव वेगवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102811, "chapter_id": 3227, "verse_number": "१४-८३-२०", "content_sanskrit": "तस्यापतत एवाशु गदां हेमपरिष्कृताम्।\nशरैश्चकर्त बहुधा बहुभिर्गृध्रवाजितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102812, "chapter_id": 3227, "verse_number": "१४-८३-२१", "content_sanskrit": "सा गदा शकलीभूता विशीर्णिमणिबन्धना।\nव्याली विमुच्यमानेन पपात धरणीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102813, "chapter_id": 3227, "verse_number": "१४-८३-२२", "content_sanskrit": "विरथं विधनुष्कं च गदया परिवर्जितम्।\n`नैच्छत्ताडयितुं धीमानर्जुनः समराग्रणीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102814, "chapter_id": 3227, "verse_number": "१४-८३-२३", "content_sanskrit": "तत एनं विमनसं क्षत्रधर्मे व्यवस्थितम्॥\nसान्त्वपूर्वमिदं वाक्यमब्रवीत्कपिकेतनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102815, "chapter_id": 3227, "verse_number": "१४-८३-२४", "content_sanskrit": "पर्याप्तः क्षत्रधर्मोऽयं दर्शितः पुत्र गम्यताम्।\nबह्वेतत्समरे कर्म तव बालस्य पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102816, "chapter_id": 3227, "verse_number": "१४-८३-२५", "content_sanskrit": "युधिष्ठिरस्य संदेशो न हन्तव्या नृपा इति।\nतेन जीवसि राजंस्त्वमपराद्धोऽपि मे रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102817, "chapter_id": 3227, "verse_number": "१४-८३-२६", "content_sanskrit": "इति मत्वा तदाऽऽत्मानं प्रत्यादिष्टं स्म मागधः।\nतथ्यमित्यभिगम्यैनं प्राञ्जलिः प्रत्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102818, "chapter_id": 3227, "verse_number": "१४-८३-२७", "content_sanskrit": "परिजितोस्मि भद्रं ते नाहं योद्धुमिहोत्सहे।\nयद्यत्कृत्यं मया तेऽद्य तद्ब्रूहि कृतमेव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2102819, "chapter_id": 3227, "verse_number": "१४-८३-२८", "content_sanskrit": "तमर्जुनः समाश्वास्य पुनरेवेदमब्रवीत्।\nआगन्तव्यं परां चैत्रीमश्वमेधे नृपस्य नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2102820, "chapter_id": 3227, "verse_number": "१४-८३-२९", "content_sanskrit": "इत्युक्तः स तथेत्युक्त्वा पूजयमास तं हयम्।\nफल्गुनं च युधिश्रेष्ठं विदिवत्सहदेवजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2102821, "chapter_id": 3227, "verse_number": "१४-८३-३०", "content_sanskrit": "ततो यथेष्टमगमत्पुनरेव स कौरवः।\nततः समुद्रतीरेण वङ्गान्पुण्ड्रान्सकेरलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2102822, "chapter_id": 3227, "verse_number": "१४-८३-३१", "content_sanskrit": "तत्रतत्र च भूरीणि म्लेच्छसैन्यान्यनेकशः।\nविजिग्ये धनुषा राजन्गाण्डीवेन धनंजयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2102823, "chapter_id": 3227, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि त्र्यशीतितमोऽध्यायः॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]