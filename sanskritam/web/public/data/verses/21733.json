[{"id": 7001733000, "chapter_id": 21733, "verse_number": "१-११९-१", "content_sanskrit": "सनातन उवाच ।\nअथ तेऽहं प्रवक्ष्यामि दशम्या वै व्रतानि च ।\nयानि कृत्वा नरो भक्त्या धर्मराजप्रियो भवेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001733001, "chapter_id": 21733, "verse_number": "१-११९-२", "content_sanskrit": "चैत्रशुक्लदशम्यां तु धर्मराजं प्रपूजयेत् ।\nतत्कालसंभवैः पुष्पैः फलैर्गंधादिभिस्तथा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001733002, "chapter_id": 21733, "verse_number": "१-११९-३", "content_sanskrit": "सोपवासो वैकभक्तो भोजयित्वा द्विजोत्तमान् ।\nचतुर्द्दशततस्तेभ्यः शक्त्या दद्याच्च दक्षिणाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001733003, "chapter_id": 21733, "verse_number": "१-११९-४", "content_sanskrit": "एवं यः कुरुते विप्र धर्मराजप्रपूजनम् ।\nस धर्मस्याज्ञयागच्छेद्देवैः साधर्म्यमच्युतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001733004, "chapter_id": 21733, "verse_number": "१-११९-५", "content_sanskrit": "दशम्यां माधवे शुक्ले विष्णुमभ्यर्च्य मानवः ।\nगंधाद्यैरुपचारैश्च श्वेतपुष्पैः सुगंधिभिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001733005, "chapter_id": 21733, "verse_number": "१-११९-६", "content_sanskrit": "शतं प्रदक्षिणाः कृत्वा विप्रन्संभोज्य यत्नतः ।\nलभते वैष्णवं लोकं नात्र कार्या विचारणा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001733006, "chapter_id": 21733, "verse_number": "१-११९-७", "content_sanskrit": "ज्येष्ठे शुक्लदशम्यां तु जाह्नवी सरितां वरा ।\nसमायाता धरां स्वर्गात्तस्मात्सा पुण्यदा स्मृता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001733007, "chapter_id": 21733, "verse_number": "१-११९-८", "content_sanskrit": "ज्येष्ठः शुक्लदलं हस्तो बुधश्च दशमीः तिथिः ।\nगरानन्दव्यतीपाताः कन्येंदुवृषभास्कराः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001733008, "chapter_id": 21733, "verse_number": "१-११९-९", "content_sanskrit": "दशयोगः समाख्यातो महापुण्यतमो द्विज ।\nहरते दश पापानि तस्माद्दशहरः स्मृतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001733009, "chapter_id": 21733, "verse_number": "१-११९-१०", "content_sanskrit": "अस्यां यो जाह्नवीं प्राप्य स्नाति संप्रीतमानसः ।\nविधिना जाह्नवीतोये स याति हरिमन्दिरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001733010, "chapter_id": 21733, "verse_number": "१-११९-११", "content_sanskrit": "आषाढशुक्लदशमी पुण्या मन्वादिकैः स्मृता ।\nतस्यां स्नानं जपो दानं होमो वा स्वर्गतिप्रदाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001733011, "chapter_id": 21733, "verse_number": "१-११९-१२", "content_sanskrit": "श्रावणे शुक्लदशमी सर्वाशापरिपूर्तिदा ।\nअस्यां शिवार्चनं शस्तं गन्धाद्यै रुपचारकैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001733012, "chapter_id": 21733, "verse_number": "१-११९-१३", "content_sanskrit": "तत्रोपवासो नक्तं वा द्विजानां भोजनं जपः ।\nहेम्नो दान च धेन्वादेः सर्वपापप्रणाशनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001733013, "chapter_id": 21733, "verse_number": "१-११९-१४", "content_sanskrit": "अथो नभस्यशुक्लायां दशम्यां द्विजसत्तम ।\nव्रतं दशावताराख्यं तत्र स्नानं जलाशये ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001733014, "chapter_id": 21733, "verse_number": "१-११९-१५", "content_sanskrit": "कृत्वा संध्यादिनियमं देवर्षिपितृतर्पणम् ।\nततो दशावताराणि समभ्यर्चेत्समाहितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001733015, "chapter_id": 21733, "verse_number": "१-११९-१६", "content_sanskrit": "मत्स्यं कूर्मं वराहं च नरसिंहं त्रिविक्रमम् ।\nरामं रामं च कृष्णं च बौद्धं कल्किनमेव च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001733016, "chapter_id": 21733, "verse_number": "१-११९-१७", "content_sanskrit": "दशमूर्तिस्तु सौवर्णीः पूजयित्वा विधानतः ।\nदशभ्यो विप्रवर्येभ्यो दद्यात्सत्कृत्य नारद ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001733017, "chapter_id": 21733, "verse_number": "१-११९-१८", "content_sanskrit": "उपवासं चैकभक्तं कृत्वा संभोज्य वाडवान् ।\nविसृज्य पश्चाद्भुंजीत स्वयं स्वेष्टैः समाहितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001733018, "chapter_id": 21733, "verse_number": "१-११९-१९", "content_sanskrit": "भक्त्या कृत्वा व्रतं त्वेतद्भुक्त्वा भोगानिहोत्तमान् ।\nविमानेन व्रजेदंते विष्णुलोकं सनातनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001733019, "chapter_id": 21733, "verse_number": "१-११९-२०", "content_sanskrit": "आश्विने शुक्लदशमी विजया सा प्रकीर्तिता ।\nचतुर्गोमयपिंडानि प्रातर्न्यस्य गृहांगणे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001733020, "chapter_id": 21733, "verse_number": "१-११९-२१", "content_sanskrit": "चक्रवालस्वरूपेण तन्मध्ये रामलक्ष्मणौ ।\nतथा भरतशत्रुघ्नौ पूजयेच्चतुरोऽपि हि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001733021, "chapter_id": 21733, "verse_number": "१-११९-२२", "content_sanskrit": "सपिधानासु पात्रीषु गोमयीषु चतसृष्ट ।\nकिन्नं धान्यं सरौप्यं तु धृत्वा धौतांशुकावृतम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001733022, "chapter_id": 21733, "verse_number": "१-११९-२३", "content_sanskrit": "पितृमातृभ्रातृपुत्रजाया भृत्यसमन्वितम् ।\nसंपूज्यं गन्धपुष्पाद्यैर्नैवेद्यैश्च विधानतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001733023, "chapter_id": 21733, "verse_number": "१-११९-२४", "content_sanskrit": "नमस्कृत्याथ भुंजीत द्विजान्संभोज्य पूजितान् ।\nएवं कृत्वा विधानं तु नरो वर्षं सुरवान्वितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001733024, "chapter_id": 21733, "verse_number": "१-११९-२५", "content_sanskrit": "धनधान्यसमृद्धश्च निश्चितं जायते द्विज ।\nअथापाराह्णसमये नवम्यां संनिमंत्रिताम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001733025, "chapter_id": 21733, "verse_number": "१-११९-२६", "content_sanskrit": "पूर्वदिक्षु शमीं विप्र गत्वा तन्मूलजां मृदम् ।\nगृहीत्वा स्वगृहं प्राप्य गीतवादित्रनिःस्वनैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001733026, "chapter_id": 21733, "verse_number": "१-११९-२७", "content_sanskrit": "संपूज्य तां विधानेन सज्जीकृत्य स्वकं बलम् ।\nनिर्गत्य पूर्वद्वारेण ग्रामाद्ब्रहिरनाकुलः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001733027, "chapter_id": 21733, "verse_number": "१-११९-२८", "content_sanskrit": "ततः शत्रुप्रतिकृतिं निर्मितां पत्रकादिभिः ।\nमनसा कल्पितां वापि स्वर्णं पुंरवंशरेण वै ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001733028, "chapter_id": 21733, "verse_number": "१-११९-२९", "content_sanskrit": "विध्येदिति भृशं प्रीतः प्राप्नुयात्स्वगृहं निशि ।\nएवं कृतविधिर्वापि गच्छेद्वा शत्रुनिग्रहे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001733029, "chapter_id": 21733, "verse_number": "१-११९-३०", "content_sanskrit": "एषैवं दशमी विप्र विधिनाऽऽचरिता सदा ।\nधनं जयं सुतान् गाश्च गजाश्वं वाप्यजाविकम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001733030, "chapter_id": 21733, "verse_number": "१-११९-३१", "content_sanskrit": "दद्यादिह शरीरांते स्वर्गतिं चापि नारद ।\nदशम्यां कार्तिके शुक्ले सार्वभौमव्रतं चरेत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001733031, "chapter_id": 21733, "verse_number": "१-११९-३२", "content_sanskrit": "कृतोपवासो वैकाशी निशीथेऽपूपकादिभिः ।\nदशदिक्षु बलिं दद्याद् गृहद्वापि पुराद्ब्रहिः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001733032, "chapter_id": 21733, "verse_number": "१-११९-३३", "content_sanskrit": "मंडलेऽष्टदले क्लृप्ते गोविड्लिप्तधरातले ।\nमन्त्रैरेभिर्द्विजश्रेष्ठ गणेशादिकृतार्चनः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001733033, "chapter_id": 21733, "verse_number": "१-११९-३४", "content_sanskrit": "यो मे पूर्वगतः पाप्मा पापकेनेह कर्मणा ।\nतमिंद्रो देवरा जोऽद्य नाशयत्वखिलेष्टदः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001733034, "chapter_id": 21733, "verse_number": "१-११९-३५", "content_sanskrit": "यो मे वह्निगतः पाप्मा पापकेनेह कर्मणा ।\nतेजोराजोऽथ वह्निस्तं नाशयत्वखिलेष्टदः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001733035, "chapter_id": 21733, "verse_number": "१-११९-३६", "content_sanskrit": "यो मे दक्षगतः पाप्मा पापकेनेह कर्मणा ।\nतं यमः प्रेतराजो वै नाशयत्वखिलेष्टदः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001733036, "chapter_id": 21733, "verse_number": "१-११९-३७", "content_sanskrit": "यो मे नैर्ऋतिगः पाप्मा पापकेनेह कर्मणा ।\nरक्षोराजो नैर्ऋतिस्तं नाशयत्वखिलेष्टदः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001733037, "chapter_id": 21733, "verse_number": "१-११९-३८", "content_sanskrit": "यो मे पश्चिमगः पाप्मा पापकेनेहकर्मणा ।\nयादः पतिस्तं वरुणो नाशयत्वखिलेष्टदः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001733038, "chapter_id": 21733, "verse_number": "१-११९-३९", "content_sanskrit": "यो मे वायुगतः पाप्मा पापकेनेह कर्मणा ।\nवायुस्तं मरुतां राजो नाशयत्वखिलेष्टदः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001733039, "chapter_id": 21733, "verse_number": "१-११९-४०", "content_sanskrit": "यो मे सौम्यगतः पाप्मा पापकेनेह कर्मणा ।\nसोमस्तमृक्षयक्षेशो नाशयत्वखिलेष्टदः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001733040, "chapter_id": 21733, "verse_number": "१-११९-४१", "content_sanskrit": "यो म ईशगतः पाप्मा पापकेनेह कर्मणा ।\nईशानो भूतनाथस्तं नाशयत्वखिलेष्टदः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001733041, "chapter_id": 21733, "verse_number": "१-११९-४२", "content_sanskrit": "यो मं ऊर्द्ध्वगतः पाप्मा पापकेनेह कर्मणा ।\nब्रह्मा प्रजापतीशस्तं नाशयत्वखिलेष्टदः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001733042, "chapter_id": 21733, "verse_number": "१-११९-४३", "content_sanskrit": "यो मेऽधःसंस्थितः पाप्मा पापकेनेह कर्मणा ।\nअनंतो नागराजस्तं नाशयत्वखिलेष्टदः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001733043, "chapter_id": 21733, "verse_number": "१-११९-४४", "content_sanskrit": "इत्येवं दिक्षु दशसु बलिं दत्वा समाहितः ।\nक्षेत्रपालाय तद्बाह्ये क्षिपेद्बलिमतंद्रितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001733044, "chapter_id": 21733, "verse_number": "१-११९-४५", "content_sanskrit": "एवं कृतविधिः शेषं निशायां निनयेत्सुधीः ।\nगीतैः सुमंगलप्रायैः स्तवपाठैर्जपादिभिः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001733045, "chapter_id": 21733, "verse_number": "१-११९-४६", "content_sanskrit": "प्रातः स्नात्वा समभ्यर्च्य लोकपालान् द्विजोत्तमान् ।\nद्वादशाभ्यर्च्य संभोज्य शक्तितो दक्षिणां ददेत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001733046, "chapter_id": 21733, "verse_number": "१-११९-४७", "content_sanskrit": "इत्थं कृत्वा व्रतं विप्र भोगान्भुक्तैहिकाञ्छुभान् ।\nयुगं स्वर्गसुखं भुक्त्वा सार्वभौमो नृपो भवेत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001733047, "chapter_id": 21733, "verse_number": "१-११९-४८", "content_sanskrit": "मार्गशुक्लदशम्यां तु चरेदारोग्यकं व्रतम् ।\nगंधाद्यैरर्चयेद्विप्रान् दश तच्चरणोदकम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001733048, "chapter_id": 21733, "verse_number": "१-११९-४९", "content_sanskrit": "पीत्वाऽथ दक्षिणां दत्वा विसूजेदेकभोजनं ।\nएतत्कृत्वा व्रतं विप्र ह्यारोग्यं प्राप्य भूतले ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001733049, "chapter_id": 21733, "verse_number": "१-११९-५०", "content_sanskrit": "धर्मराजप्रसादेन मोदते दिवि देववत् ।\nपौषे दशम्यां शुक्लायां विश्वेदेवान् समर्चयेत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001733050, "chapter_id": 21733, "verse_number": "१-११९-५१", "content_sanskrit": "ऋतुं दक्षं वसून्सत्यं कालं कामं मुनिं गुरुम् ।\nविप्रं रामं च दशधा केशवस्तान्समास्थितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001733051, "chapter_id": 21733, "verse_number": "१-११९-५२", "content_sanskrit": "स्वापयित्वा दर्भमयानासनेषु च संस्थितान् ।\nगंधैर्धूपैस्तथा दीपैर्नैवेद्यैश्चापि नारद ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001733052, "chapter_id": 21733, "verse_number": "१-११९-५३", "content_sanskrit": "प्रत्येकं दक्षिणां दत्वा प्रणियत्य विसर्जयेत् ।\nदक्षिणां तां द्विजाग्र्येभ्यो गुरवे वा समर्पयेत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001733053, "chapter_id": 21733, "verse_number": "१-११९-५४", "content_sanskrit": "एवं कृतविधि श्चैकभक्तो भोगी व्रती भवेत् ।\nलोकद्वयस्य विप्रर्षे नात्र कार्या विचारणा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001733054, "chapter_id": 21733, "verse_number": "१-११९-५५", "content_sanskrit": "माघशुक्लदशम्यां तु सोपवासो जितेंद्रियः ।\nदेवांनगिरसो नाम दश सम्यक्समर्चयेत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001733055, "chapter_id": 21733, "verse_number": "१-११९-५६", "content_sanskrit": "कृत्वा स्वर्णमयान्विप्र गंधाद्यैरुपचारकैः ।\nआत्मा ह्यायुर्मनो दक्षो मदः प्राणस्तथैव च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001733056, "chapter_id": 21733, "verse_number": "१-११९-५७", "content_sanskrit": "बर्हिष्मांश्च गविष्ठश्च दत्तः सत्यश्च ते दश ।\nदश विप्रान्भोजयित्वा मधुरान्नेन नारद ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001733057, "chapter_id": 21733, "verse_number": "१-११९-५८", "content_sanskrit": "मूर्तीस्तेभ्यः प्रदद्यात्ताः स्वर्गलोकाप्तये क्रमात् ।\nअंत्यशुक्लदशम्यां तु चतुर्दशं यमान्यजेत्  ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001733058, "chapter_id": 21733, "verse_number": "१-११९-५९", "content_sanskrit": "यमश्च धर्मराजश्च मृत्युश्चैवांतकस्तथा ।\nवैवस्वतश्च कालश्च सर्वभूतक्षयस्तथा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001733059, "chapter_id": 21733, "verse_number": "१-११९-६०", "content_sanskrit": "औदुम्बरश्च दघ्नश्च द्वौ नीलपरमेष्ठिनौ ।\nवृकोदरश्चचित्रश्च चित्रगुप्तश्चतुर्दश ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001733060, "chapter_id": 21733, "verse_number": "१-११९-६१", "content_sanskrit": "गन्धाद्यैरुपचारैश्च समभ्यर्च्याथतर्पयेत् ।\nतिलांबुमिश्रांजलिभिर्दर्भैः प्रत्येकशस्त्रिभिः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001733061, "chapter_id": 21733, "verse_number": "१-११९-६२", "content_sanskrit": "ततश्च दद्यात्सूर्यार्घं ताम्रपात्रेण नारद ।\nरक्तचंदनसंदनसंमिश्रतिलाक्षतयवांबुभिः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001733062, "chapter_id": 21733, "verse_number": "१-११९-६३", "content_sanskrit": "एहि सूर्यसहस्रांशो तेजोराशे जगत्पते ।\nगृहाणार्घ्यं मया दत्तं भक्त्या मामनुकंपय ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001733063, "chapter_id": 21733, "verse_number": "१-११९-६४", "content_sanskrit": "इति मंत्रेण दत्वाऽर्घ्यं विप्रान्भोज्य चतुर्द्दश ।\nरौप्यां सुदक्षिणां दत्वा विसृज्याश्नीत च स्वयम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001733064, "chapter_id": 21733, "verse_number": "१-११९-६५", "content_sanskrit": "एवं कृतविधिर्विप्र धर्मराजप्रसादतः ।\nभुक्त्वा भोगांश्च पुत्रार्थानैहिकान्देवदुर्लभान् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001733065, "chapter_id": 21733, "verse_number": "१-११९-६६", "content_sanskrit": "विमानवरमास्थाय देहांते विष्णुलोकभाक् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]