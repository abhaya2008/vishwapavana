[{"id": 2085695, "chapter_id": 2823, "verse_number": "१२-३२८-०x", "content_sanskrit": "कपिल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085696, "chapter_id": 2823, "verse_number": "१२-३२८-१", "content_sanskrit": "यदप्युक्तं कति तत्वानि भवन्ति तत्वमेतानि।\nयमानुपूर्व्यशः प्रोक्तान्येवमाह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085697, "chapter_id": 2823, "verse_number": "१२-३२८-२", "content_sanskrit": "तत्वान्यथोक्तानि। तथाविद्यो निबुद्ध्यते।\nन स पापेन लिप्येत निर्मुक्तः सर्वसंकरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085698, "chapter_id": 2823, "verse_number": "१२-३२८-३", "content_sanskrit": "यदप्युक्तं इहाद्यं मध्यमं च तत्वानामित्यत्र ब्रूमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085699, "chapter_id": 2823, "verse_number": "१२-३२८-४", "content_sanskrit": "एवमाद्यं मध्यमं चोक्तं बुद्ध्यादीनि त्रयोविंशतितत्वानि विशेषपर्यवसानानि ज्ञातव्यानि भवन्तीत्येव मामकेनेत्यत्रोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085700, "chapter_id": 2823, "verse_number": "१२-३२८-५", "content_sanskrit": "तदेव तद्यदा दत्तब्राह्मणक्षत्रियवैश्यशूद्रचण्डालपुल्कसादिरेतानि ज्ञातव्यानि बुद्ध्यादीनि विशेषपर्यवसानानि मन्तव्यानि प्रत्येतव्याभ्युक्तानि एतदाद्यं मध्यमं च। एतस्मात्तत्वानामुत्पत्तिर्भवति अत्र प्रलीयन्ते। केचिदाहुराचार्याः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085701, "chapter_id": 2823, "verse_number": "१२-३२८-६", "content_sanskrit": "अहमित्येतदात्मकं सशीरसङ्घातं त्रिषु लोकेषु व्यक्तमव्यक्ताधिष्ठितमेतद्देवदत्तसंज्ञकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085702, "chapter_id": 2823, "verse_number": "१२-३२८-७", "content_sanskrit": "योगदशमपुरुषदर्शनानां तु पञ्चविंशतितत्वानां प्रतिबुध्यमानयोर्व्यतिरिक्तं शुचिव्यभ्रमित्याहुराचार्याः। एवमाह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085703, "chapter_id": 2823, "verse_number": "१२-३२८-८", "content_sanskrit": "चतुर्विशतितत्वज्ञस्त्वव्यक्ते प्रतितिष्ठति।\nपञ्चविंशतितत्वज्ञोऽप्यव्यक्तमधितिष्ठति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085704, "chapter_id": 2823, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अष्टाविंशत्यधिकत्रिशततमोऽध्यायः॥ ३२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]