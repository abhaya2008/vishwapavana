[{"id": 5000053000, "chapter_id": 9053, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे त्रिपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000053001, "chapter_id": 9053, "verse_number": "१-५३-१", "content_sanskrit": "एवमुक्ता वसिष्ठेन शबला शत्रुसूदन।\nविदधे कामधुक् कामान् यस्य यस्येप्सितं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000053002, "chapter_id": 9053, "verse_number": "१-५३-२", "content_sanskrit": "इक्षून् मधूंस्तथा लाजान् मैरेयांश्च वरासवान्।\nपानानि च महार्हाणि भक्ष्यांश्चोच्चावचानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000053003, "chapter_id": 9053, "verse_number": "१-५३-३", "content_sanskrit": "उष्णाढ्यस्यौदनस्यात्र राशयः पर्वतोपमाः।\nमृष्टान्यन्नानि सूपांश्च दधिकुल्यास्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000053004, "chapter_id": 9053, "verse_number": "१-५३-४", "content_sanskrit": "नानास्वादुरसानां च खाण्डवानां तथैव च।\nभोजनानि सुपूर्णानि गौडानि च सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000053005, "chapter_id": 9053, "verse_number": "१-५३-५", "content_sanskrit": "सर्वमासीत् सुसंतुष्टं हृष्टपुष्टजनायुतम्।\nविश्वामित्रबलं राम वसिष्ठेन सुतर्पितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000053006, "chapter_id": 9053, "verse_number": "१-५३-६", "content_sanskrit": "विश्वामित्रो हि राजर्षिर्हृष्टपुष्टस्तदाभवत्।\nसान्तःपुरवरो राजा सब्राह्मणपुरोहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000053007, "chapter_id": 9053, "verse_number": "१-५३-७", "content_sanskrit": "सामात्यो मन्त्रिसहितः सभृत्यः पूजितस्तदा।\nयुक्तः परमहर्षेण वसिष्ठमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000053008, "chapter_id": 9053, "verse_number": "१-५३-८", "content_sanskrit": "पूजितोऽहं त्वया ब्रह्मन् पूजार्हेण सुसत्कृतः।\nश्रूयतामभिधास्यामि वाक्यं वाक्यविशारद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000053009, "chapter_id": 9053, "verse_number": "१-५३-९", "content_sanskrit": "गवां शतसहस्रेण दीयतां शबला मम।\nरत्नं हि भगवन्नेतद् रत्नहारी च पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000053010, "chapter_id": 9053, "verse_number": "१-५३-१०", "content_sanskrit": "तस्मान्मे शबलां देहि ममैषा धर्मतो द्विज।\nएवमुक्तस्तु भगवान् वसिष्ठो मुनिपुंगवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000053011, "chapter_id": 9053, "verse_number": "१-५३-११", "content_sanskrit": "विश्वामित्रेण धर्मात्मा प्रत्युवाच महीपतिम्।\nनाहं शतसहस्रेण नापि कोटिशतैर्गवाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000053012, "chapter_id": 9053, "verse_number": "१-५३-१२", "content_sanskrit": "राजन् दास्यामि शबलां राशिभी रजतस्य वा।\nन परित्यागमर्हेयं मत्सकाशादरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000053013, "chapter_id": 9053, "verse_number": "१-५३-१३", "content_sanskrit": "शाश्वती शबला मह्यं कीर्तिरात्मवतो यथा।\nअस्यां हव्यं च कव्यं च प्राणयात्रा तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000053014, "chapter_id": 9053, "verse_number": "१-५३-१४", "content_sanskrit": "आयत्तमग्निहोत्रं च बलिर्होमस्तथैव च।\nस्वाहाकारवषट्कारौ विद्याश्च विविधास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000053015, "chapter_id": 9053, "verse_number": "१-५३-१५", "content_sanskrit": "आयत्तमत्र राजर्षे सर्वमेतन्न संशयः।\nसर्वस्वमेतत् सत्येन मम तुष्टिकरी तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000053016, "chapter_id": 9053, "verse_number": "१-५३-१६", "content_sanskrit": "कारणैर्बहुभी राजन् न दास्ये शबलां तव।\nवसिष्ठेनैवमुक्तस्तु विश्वामित्रोऽब्रवीत् तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000053017, "chapter_id": 9053, "verse_number": "१-५३-१७", "content_sanskrit": "संरब्धतरमत्यर्थं वाक्यं वाक्यविशारदः।\nहैरण्यकक्षग्रैवेयान् सुवर्णाङ्कुशभूषितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000053018, "chapter_id": 9053, "verse_number": "१-५३-१८", "content_sanskrit": "ददामि कुञ्जराणां ते सहस्राणि चतुर्दश।\nहैरण्यानां रथानां च श्वेताश्वानां चतुर्युजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000053019, "chapter_id": 9053, "verse_number": "१-५३-१९", "content_sanskrit": "ददामि ते शतान्यष्टौ किंकिणीकविभूषितान्।\nहयानां देशजातानां कुलजानां महौजसाम्।\nसहस्रमेकं दश च ददामि तव सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000053020, "chapter_id": 9053, "verse_number": "१-५३-२०", "content_sanskrit": "नानावर्णविभक्तानां वयःस्थानां तथैव च।\nददाम्येकां गवां कोटिं शबला दीयतां मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000053021, "chapter_id": 9053, "verse_number": "१-५३-२१", "content_sanskrit": "यावदिच्छसि रत्नानि हिरण्यं वा द्विजोत्तम।\nतावद् ददामि ते सर्वं दीयतां शबला मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000053022, "chapter_id": 9053, "verse_number": "१-५३-२२", "content_sanskrit": "एवमुक्तस्तु भगवान् विश्वामित्रेण धीमता।\nन दास्यामीति शबलां प्राह राजन् कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000053023, "chapter_id": 9053, "verse_number": "१-५३-२३", "content_sanskrit": "एतदेव हि मे रत्नमेतदेव हि मे धनम्।\nएतदेव हि सर्वस्वमेतदेव हि जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000053024, "chapter_id": 9053, "verse_number": "१-५३-२४", "content_sanskrit": "दर्शश्च पौर्णमासश्च यज्ञाश्चैवाप्तदक्षिणाः।\nएतदेव हि मे राजन् विविधाश्च क्रियास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000053025, "chapter_id": 9053, "verse_number": "१-५३-२५", "content_sanskrit": "अतोमूलाः क्रियाः सर्वा मम राजन् न संशयः।\nबहुना किं प्रलापेन न दास्ये कामदोहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000053026, "chapter_id": 9053, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे त्रिपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]