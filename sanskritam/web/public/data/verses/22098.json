[{"id": 7002098000, "chapter_id": 22098, "verse_number": "१४३-१", "content_sanskrit": "ईश्वर उवाच ।\nकुब्जिकाक्रमपूजाञ्च वक्ष्ये सर्वार्थसाधनीं ।\nयया जिताः सुरा देवैः शस्त्राद्यैराज्यसंयुतैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002098001, "chapter_id": 22098, "verse_number": "१४३-२", "content_sanskrit": "मायाबीजं च गुह्याङ्गे षट्कमस्त्रं करे न्यसेत् ।\nकाली कालीति हृदयं दुष्टचाण्डालिका शिरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002098002, "chapter_id": 22098, "verse_number": "१४३-३", "content_sanskrit": "ह्रौं स्फें ह स ख क छ ड ॐ कारो भैरवः शिखा ।\nभेलखी कवचं दूती नेत्राख्या रक्तचण्डिका ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002098003, "chapter_id": 22098, "verse_number": "१४३-४", "content_sanskrit": "ततो गुह्यक्रुञ्जिकास्त्रं मण्डले स्थानके यजेत् ।\nअग्नौ कूर्चशिरो रुद्रे नैरृत्येऽथ शिखानिले ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002098004, "chapter_id": 22098, "verse_number": "१४३-५", "content_sanskrit": "कवचम्मध्यतो नेत्रं अस्त्रन्दिक्षु च मण्डले ।\nद्वात्रिंशता कर्णिकायां स्रों हसक्षमलनववषडसचात्ममन्त्रवीजकं ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002098005, "chapter_id": 22098, "verse_number": "१४३-६", "content_sanskrit": "ब्रह्माणी चैव माहेशो कौमारी वैष्णवी तथा ।\nवाराही चैव माहेन्द्री चामुण्डा चण्डिकेन्द्रकात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002098006, "chapter_id": 22098, "verse_number": "१४३-७", "content_sanskrit": "यजेद्रवलकसहान् शिवेन्दाग्नियमेऽद्निपे ।\nजले तु कुसुममालामद्रिकाणां च पञ्चकं ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002098007, "chapter_id": 22098, "verse_number": "१४३-८", "content_sanskrit": "जालन्धरं पूर्णगिरिं कामरूपं क्रमाद्यजेत् ।\nमरुदेशाग्निनैरृत्ये मध्ये वै वज्रकुब्जिकां ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002098008, "chapter_id": 22098, "verse_number": "१४३-९", "content_sanskrit": "अनादिविमलः पूज्यः सर्वज्ञविमलस्तुतः ।\nप्रसिद्धविमलश्चाथ संयोगविमलस्तुतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002098009, "chapter_id": 22098, "verse_number": "१४३-१०", "content_sanskrit": "समयाख्योऽथ विमल एतद्विमलपञ्चकं ।\nमरुदीशाननैरृत्ये वह्नौ चोत्तरशृङ्गके ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002098010, "chapter_id": 22098, "verse_number": "१४३-११", "content_sanskrit": "कुब्जार्थं खिंखिनी षष्ठा सोपन्ना सुस्थिरा तथा ।\nरत्नसुन्दरी चैशाने शृङ्गे चाष्टादिनाथकाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002098011, "chapter_id": 22098, "verse_number": "१४३-१२", "content_sanskrit": "मित्र ओडीशषष्ठ्याख्यौ वर्षा अग्न्यम्बुपेऽनिले ।\nभवेद्गगनरत्नं स्याच्चाप्ये कवचरत्नकं ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002098012, "chapter_id": 22098, "verse_number": "१४३-१३", "content_sanskrit": "ब्रुं मर्त्यः पञ्चनामाख्यो मरुदीशानवह्निगः ।\nयाम्याग्नेये पञ्चरत्नं ज्येष्ठा रौद्री तथान्तिका ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002098013, "chapter_id": 22098, "verse_number": "१४३-१४", "content_sanskrit": "तिस्रो ह्यासां महावृद्धाः पञ्चप्रणवतोऽखिलाः ।\nसप्तविंशत्यष्टविंशभेदात्सम्पूजनं द्विधा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002098014, "chapter_id": 22098, "verse_number": "१४३-१५", "content_sanskrit": "ॐ ऐं गूं क्रमगणपतिं प्रणवं वटुकं यजेत् ।\nचतुरस्रे मण्डले च दक्षिणे गणपं यजेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002098015, "chapter_id": 22098, "verse_number": "१४३-१६", "content_sanskrit": "वामे च वटुकं कोणे गुरून् सोडशनाथकान् ।\nवायव्यादौ चाष्ट दश प्रतिषट्कोणके ततः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002098016, "chapter_id": 22098, "verse_number": "१४३-१७", "content_sanskrit": "ब्रह्माद्याश्चाष्ट परितस्तन्मध्ये च नवात्मकः ।\nकुब्जिका कुलटा चैव क्रमपूजा तु सर्वदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]