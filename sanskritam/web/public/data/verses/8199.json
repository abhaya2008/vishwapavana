[{"id": 900000978, "chapter_id": 8199, "verse_number": "7.1", "content_sanskrit": "पुरमेकादशद्वारमजस्यावक्रचेतसः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900000979, "chapter_id": 8199, "verse_number": "7.2", "content_sanskrit": "हंसः शुचिषद् वसुरन्तरिक्षसद्धोता वेदिष- दतिथिर्दुरोणसत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900000980, "chapter_id": 8199, "verse_number": "7.3", "content_sanskrit": "ऊर्ध्वं प्राणमुन्नमयत्यपानं प्रत्यगस्यति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900000981, "chapter_id": 8199, "verse_number": "7.4", "content_sanskrit": "अस्य विस्रंसमानस्य शरीरस्थस्य देहिनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900000982, "chapter_id": 8199, "verse_number": "7.5", "content_sanskrit": "न प्राणेन नापानेन मर्त्यो जीवति कश्चन", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900000983, "chapter_id": 8199, "verse_number": "7.6", "content_sanskrit": "हन्त त इदं प्रवक्ष्यामि गुह्यं ब्रह्म सनातनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900000984, "chapter_id": 8199, "verse_number": "7.7", "content_sanskrit": "योनिमन्ये प्रपद्यन्ते शरीरत्वाय देहिनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900000985, "chapter_id": 8199, "verse_number": "7.8", "content_sanskrit": "य एषु सुप्तेषु जागर्ति कामं कामं पुरुषो निर्ममाणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900000986, "chapter_id": 8199, "verse_number": "7.9", "content_sanskrit": "अग्निर्यथैको भुवनं प्रविष्टो रूपं रूपं प्रतिरूपो बभूव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900000987, "chapter_id": 8199, "verse_number": "7.10", "content_sanskrit": "एको बशी सर्वभूतान्तरात्मा एकं रूपं बहुधा यः करोति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900000988, "chapter_id": 8199, "verse_number": "7.11", "content_sanskrit": "न तत्र सूर्यो भाति न चन्द्रतारकं नेमा विद्युतो भान्ति कुतोऽयमग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]