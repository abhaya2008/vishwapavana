[{"id": 2097677, "chapter_id": 3091, "verse_number": "१३-२२१-१", "content_sanskrit": "उमोवाच।\nभगवन्देवदेवेश भूतपाल नमोस्तु ते।\nह्रस्वाङ्गाश्चैव वक्राङ्गाः कुब्जा वामनकास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2097678, "chapter_id": 3091, "verse_number": "१३-२२१-२", "content_sanskrit": "अपरे मानुषा देव दृश्यन्ते कुणिबाहवः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2097679, "chapter_id": 3091, "verse_number": "१३-२२१-३x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2097680, "chapter_id": 3091, "verse_number": "१३-२२१-३", "content_sanskrit": "ये पुरा मनुजा देवि लोभमोहसमन्विताः।\nधान्यमानान्विकुर्वन्ति क्रयविक्रयकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2097681, "chapter_id": 3091, "verse_number": "१३-२२१-४", "content_sanskrit": "कुलदोषं तदा देवि धृतमानेषु नित्यशः।\nअर्धापकर्षणं चैव सर्वेषां क्रयविक्रये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2097682, "chapter_id": 3091, "verse_number": "१३-२२१-५", "content_sanskrit": "अङ्गदोषकरा ये तु परेषां कोपकारणात्।\nमांसादाश्चैव ये मूर्खा अयथावत्प्रथाः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2097683, "chapter_id": 3091, "verse_number": "१३-२२१-६", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने।\nह्रस्वाङ्गा वामनाश्चैव कुब्जाश्चैव भवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2097684, "chapter_id": 3091, "verse_number": "१३-२२१-७x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2097685, "chapter_id": 3091, "verse_number": "१३-२२१-७", "content_sanskrit": "भगवन्मानुषाः केचिद्दृश्यन्ते मानुषेषु वै।\nउन्मत्ताश्च पिशाचाश्च पर्यटन्तो यतस्ततः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2097686, "chapter_id": 3091, "verse_number": "१३-२२१-८x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2097687, "chapter_id": 3091, "verse_number": "१३-२२१-८", "content_sanskrit": "ये पुरा मनुजा देवि दर्पाहंकारसंयुताः।\nबहुधा प्रलपन्त्येव हसन्ति च परान्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2097688, "chapter_id": 3091, "verse_number": "१३-२२१-९", "content_sanskrit": "मोहयन्ति परान्भोगैर्मदनैर्लोभकारणात्।\nवृद्धान्गुरूंश्च ये मूर्खा वृथैवापहसन्ति च।\nशौण्डा विदग्धाः शास्त्रेषु सदैवानृतवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2097689, "chapter_id": 3091, "verse_number": "१३-२२१-१०", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने।\nउन्मत्ताश्च पिशाचाश्च भवन्त्येव न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2097690, "chapter_id": 3091, "verse_number": "१३-२२१-११x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2097691, "chapter_id": 3091, "verse_number": "१३-२२१-११", "content_sanskrit": "भगवन्मानुषाः केचिन्निरपत्याः सुदुःखिताः।\nयतन्तो न लभन्त्येव अपत्यानि यतस्ततः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2097692, "chapter_id": 3091, "verse_number": "१३-२२१-१२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2097693, "chapter_id": 3091, "verse_number": "१३-२२१-१२", "content_sanskrit": "ये पुरा मनुजा देवि सर्वप्राणिषु निर्दयाः।\nघ्नन्ति बालांश्च भुञ्जन्ते मृगाणां पक्षिणामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2097694, "chapter_id": 3091, "verse_number": "१३-२२१-१३", "content_sanskrit": "गुरुविद्वेषिणश्चैव परपुत्राभ्यसूयकाः।\nपितृपूजां न कुर्वन्ति यथोक्तां चाष्टकादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2097695, "chapter_id": 3091, "verse_number": "१३-२२१-१४", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने।\nमानुष्यं वा चिरात्प्राप्य निरपत्या भवन्ति ते।\nपुत्रशोकयुताश्चापि नास्ति तत्र विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2097696, "chapter_id": 3091, "verse_number": "१३-२२१-१५x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2097697, "chapter_id": 3091, "verse_number": "१३-२२१-१५", "content_sanskrit": "भगवन्मानुषाः केचित्प्रदृश्यन्ते सुदुःखिताः।\nउद्वेगवासनिरताः सोद्वेगाश्च यतव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2097698, "chapter_id": 3091, "verse_number": "१३-२२१-१६", "content_sanskrit": "नित्यं शोकसमाविष्टा दुर्गताश्च तथैव च।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2097699, "chapter_id": 3091, "verse_number": "१३-२२१-१७x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2097700, "chapter_id": 3091, "verse_number": "१३-२२१-१७", "content_sanskrit": "ये पुरा मनुजा नित्यमुत्क्रोशनपरायणाः।\nभीषयन्ति परानित्यं विकुर्वन्ति तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2097701, "chapter_id": 3091, "verse_number": "१३-२२१-१८", "content_sanskrit": "ऋणवृद्धिकराश्चैव दरिद्रेभ्यो यथेष्टतः।\nऋणार्थमभिगच्छन्ति सततं वृद्धिरूपकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2097702, "chapter_id": 3091, "verse_number": "१३-२२१-१९", "content_sanskrit": "उद्विजन्ते हि तान्दृष्ट्वा धारकाः स्वार्थकारणात्।\nअतिवृद्धिर्न कर्तव्या दरिद्रेभ्यो यथेष्टतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2097703, "chapter_id": 3091, "verse_number": "१३-२२१-२०", "content_sanskrit": "ये श्वभिः क्रीडमानाश्च त्रासयन्ति वने मृगान्।\nप्राणिहिंसां तथा देवि कुर्वन्ति च यतस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2097704, "chapter_id": 3091, "verse_number": "१३-२२१-२१", "content_sanskrit": "येषां गृहेषु वै श्वानस्त्रासयन्ति वृथा नरान्।\nएवंयुक्तसमाचाराः कालधर्मगताः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2097705, "chapter_id": 3091, "verse_number": "१३-२२१-२२", "content_sanskrit": "पीडिता यमदण्डेन निरयस्थाश्चिरं प्रिये।\nकथञ्चित्प्राप्य मानुष्यं तत्र ते दुःखसंयुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2097706, "chapter_id": 3091, "verse_number": "१३-२२१-२३", "content_sanskrit": "कुदेशे दुःखभूयिष्ठे व्याघातशतसङ्कुले।\nजायन्ते तत्र शोचन्तः सोद्वेगाश्च यतस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2097707, "chapter_id": 3091, "verse_number": "१३-२२१-२४x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2097708, "chapter_id": 3091, "verse_number": "१३-२२१-२४", "content_sanskrit": "भगवन्मानुषाः केचिदैश्वर्यज्ञानसंयुताः।\nम्लेच्छभूमिषु दृश्यन्ते म्लेच्छैश्वर्यसमन्विताः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2097709, "chapter_id": 3091, "verse_number": "१३-२२१-२५x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2097710, "chapter_id": 3091, "verse_number": "१३-२२१-२५", "content_sanskrit": "ये पुरा मनुजा देवि धनधान्यसमन्विताः।\nअयथावत्प्रयच्छन्ति श्रद्धावर्जितमेव वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2097711, "chapter_id": 3091, "verse_number": "१३-२२१-२६", "content_sanskrit": "अपात्रेभ्यश्च ये दानं शौचमङ्गलवर्जिताः।\nददत्येव च ये मूर्खाः श्लाघयाऽवज्ञयाऽपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2097712, "chapter_id": 3091, "verse_number": "१३-२२१-२७", "content_sanskrit": "एवंयुक्तसमाचाराः पुनर्जन्मनि शोभने।\nकुदेशे म्लेच्छभूयिष्ठे दुर्गमे वनसंकटे।\nम्लेच्छाधिपत्यं सम्प्राप्य जायन्ते तत्रतत्र वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2097713, "chapter_id": 3091, "verse_number": "१३-२२१-२८x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2097714, "chapter_id": 3091, "verse_number": "१३-२२१-२८", "content_sanskrit": "भगवन्भगनेत्रघ्न मानुषेषु च केचन।\nक्लीबा नपुंसकाश्चैव दृश्यन्ते षण्डकास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2097715, "chapter_id": 3091, "verse_number": "१३-२२१-२९", "content_sanskrit": "नीचकर्मरता नीचा नीचसक्यास्तथा भुवि।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2097716, "chapter_id": 3091, "verse_number": "१३-२२१-३०x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2097717, "chapter_id": 3091, "verse_number": "१३-२२१-३०", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु कल्याणि कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2097718, "chapter_id": 3091, "verse_number": "१३-२२१-३१", "content_sanskrit": "ये पुरा मनुजा भूत्वा घोरकर्मरतास्तथा।\nपशुपंस्त्वोपगातेन जीवन्ति च रमन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2097719, "chapter_id": 3091, "verse_number": "१३-२२१-३२", "content_sanskrit": "पुंस्त्वोपघातिनश्चैव नराणां कोपकारणात्।\nये धूर्ताः स्त्रीषु गच्छन्ति अयथावद्यथेष्टतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2097720, "chapter_id": 3091, "verse_number": "१३-२२१-३३", "content_sanskrit": "कामविघ्नकरा ये तु द्वेषपैशुन्यकारणात्।\nएवंयुक्तसमाचाराः कालधर्मं गतास्तु ते।\nदण्डिता यमदण्डेन निरयस्थाश्चिरं प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2097721, "chapter_id": 3091, "verse_number": "१३-२२१-३४", "content_sanskrit": "यदि चेन्मानुषं जन्म लभेरंस्ते तथाविधाः।\nक्लीबा वर्षवराश्चैव षण्डकाश्च भवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2097722, "chapter_id": 3091, "verse_number": "१३-२२१-३५", "content_sanskrit": "नीचकर्मपरा लोके निर्लज्जा वीतसम्भ्रमाः।\nपरान्दीनान्बहिष्कृत्य ते भवन्ति स्वकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2097723, "chapter_id": 3091, "verse_number": "१३-२२१-३६", "content_sanskrit": "यदि चेत्सम्प्रपश्येरंस्ते मुच्यन्ते हि कल्मषात्।\nअत्रापि ते प्रमाद्येयुः पतन्ति नरकालये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2097724, "chapter_id": 3091, "verse_number": "१३-२२१-३७", "content_sanskrit": "स्त्रीणामपि तथा देवि यथा पुंसां तु कर्मजम्।\nइति ते कथितं देवि भूयः श्रोतुं किमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2097725, "chapter_id": 3091, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकविंशत्यधिकद्विशततमोऽध्यायः॥ २२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]