[{"id": 7003789000, "chapter_id": 23789, "verse_number": "२-२-३३-१", "content_sanskrit": "जैमिनिरुवाच ।\nअत ऊर्ध्वं प्रवक्ष्यामि महावेदीमहोत्सवम् ।\nअज्ञानतिमिरांधोऽपि येन भास्वत्पदं व्रजेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003789001, "chapter_id": 23789, "verse_number": "२-२-३३-२", "content_sanskrit": "वैशाखस्यामले पक्षे तृतीया पापनाशिनी ।\nस्वयमाविष्कृता चैषा प्राजापत्यर्क्षसंयुता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003789002, "chapter_id": 23789, "verse_number": "२-२-३३-३", "content_sanskrit": "तस्यां संकल्प्य नृपतिराचार्यं वरयेच्छुचिः ।\nएकं त्रीनथ तक्षाणं दृष्टकर्माणमादरात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003789003, "chapter_id": 23789, "verse_number": "२-२-३३-४", "content_sanskrit": "वृणुयाद्वनयागाय वस्त्रालंकरणादिभिः ।\nतक्ष्णा सार्द्धं वनं गत्वा साधुवृक्षगणाकुलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003789004, "chapter_id": 23789, "verse_number": "२-२-३३-५", "content_sanskrit": "तन्मध्ये वह्निमाधाय मंत्रराजेन मंत्रवित् ।\nअष्टोत्तरशतं हुत्वा संपाताज्यविमिश्रितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003789005, "chapter_id": 23789, "verse_number": "२-२-३३-६", "content_sanskrit": "आज्यं तरूणां मूले तु प्रत्येकमभिघारयेत् ।\nदिक्पालेभ्यो बलिं दत्त्वा क्षेत्रपालपशूंस्तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003789006, "chapter_id": 23789, "verse_number": "२-२-३३-७", "content_sanskrit": "वनस्पतये जुहुयात्क्षीरोदनशताहुतिम् ।\nततः परशुमादाय वृक्षमूलेषु दिक्षु वै ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003789007, "chapter_id": 23789, "verse_number": "२-२-३३-८", "content_sanskrit": "आज्यसंस्कृतिदेशेषु आचार्यो मंत्रमुच्चरन् ।\nकिंचित्किंचिच्छेदयेद्वै चिंतयन्गरुडध्वजम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003789008, "chapter_id": 23789, "verse_number": "२-२-३३-९", "content_sanskrit": "नदत्सु तूर्यघोषेषु गीतमंगलवादिषु ।\nनियोज्य वर्द्धकिं तत्र आचार्यः स्वगृहं व्रजेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003789009, "chapter_id": 23789, "verse_number": "२-२-३३-१०", "content_sanskrit": "अथवा स्थान लब्धानि दारूणि रथकर्मणि ।\nउक्तसंस्कारविधिना संस्कुर्यात्कल्पितेनले ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003789010, "chapter_id": 23789, "verse_number": "२-२-३३-११", "content_sanskrit": "आरभेत रथं कृत्वा विघ्रराजमहोत्सवम् ।\nषोडशारैः षोडशभिश्चक्रैर्लोहमयैर्दृढैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003789011, "chapter_id": 23789, "verse_number": "२-२-३३-१२", "content_sanskrit": "युक्तं विष्णो रथं कुर्याद्दृढाक्षं दृढकूबरम् ।\nविचित्रघटनाकक्षपुत्तलीपरिवेष्टितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003789012, "chapter_id": 23789, "verse_number": "२-२-३३-१३", "content_sanskrit": "नानाविचित्रबहुलमिक्षुखण्डविराजितम् ।\nचतुस्तोरणसंयुक्तं चतुर्द्वारं सुशोभनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003789013, "chapter_id": 23789, "verse_number": "२-२-३३-१४", "content_sanskrit": "नानाविचित्रबहुलं हेमपट्टविराजितम् ।\nद्वाविंशतिकरोच्छ्रायं पताकाभिरलंकृतम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003789014, "chapter_id": 23789, "verse_number": "२-२-३३-१५", "content_sanskrit": "गारुडं च ध्वजं कुर्याद्रक्तचंदननिर्मितम् ।\nदीर्घनासं स्थूलदेहं कुण्डलाभ्यां विभूषितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003789015, "chapter_id": 23789, "verse_number": "२-२-३३-१६", "content_sanskrit": "चंच्वग्रदष्टभुजगं सर्वालंकारभूषितम् ।\nवितत्य पक्षती व्योम्नि उड्डीयंतमिवोदितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003789016, "chapter_id": 23789, "verse_number": "२-२-३३-१७", "content_sanskrit": "दैत्यदानवसंघस्य बलदर्पविनाशनम् ।\nसर्वांगं तस्य कनकैराच्छाद्य परिशोभयेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003789017, "chapter_id": 23789, "verse_number": "२-२-३३-१८", "content_sanskrit": "रथमेव हरेः कुर्यात्स्वासनं सुपरिष्कृतम् ।\nचतुर्दशरथांगैस्तं रथं कुर्याच्च सीरिणः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003789018, "chapter_id": 23789, "verse_number": "२-२-३३-१९", "content_sanskrit": "चक्रैर्द्वादशभिः कुर्यात्सुभद्राया रथोत्तमम् ।\nसप्तच्छदमयं कुर्यात्सीरिणो लांगलध्वजम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003789019, "chapter_id": 23789, "verse_number": "२-२-३३-२०", "content_sanskrit": "देव्याः पद्मध्वजं कुर्यात्पद्मकाष्ठविनिर्मितम् ।\nविरचय्य रथान्राजा प्रतिष्ठां पूर्ववच्चरेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003789020, "chapter_id": 23789, "verse_number": "२-२-३३-२१", "content_sanskrit": "यथामन्त्रं यथाशास्त्रं विश्वसेद्ब्राह्मणेषु च ।\nब्राह्मणा जगदीशस्य जंगमास्तनवः स्मृताः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003789021, "chapter_id": 23789, "verse_number": "२-२-३३-२२", "content_sanskrit": "इत्थं सुघटितं चक्रित्रयं देवत्रयस्य वै ।\nआषाढस्य सिते पक्षे दिने विष्णोः शुभप्रदे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003789022, "chapter_id": 23789, "verse_number": "२-२-३३-२३", "content_sanskrit": "प्रतिष्ठाप्य समृद्धेन विधिना पूर्ववद्विजाः ।\nरक्षणीयं तथा तत्र नारोहेत्कश्चनाशुभः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003789023, "chapter_id": 23789, "verse_number": "२-२-३३-२४", "content_sanskrit": "पक्षी वा मानुषो वापि मार्जारनकुलादयः ।\nततो दिनत्रयादर्वाग्रथानामुत्तरे कृते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003789024, "chapter_id": 23789, "verse_number": "२-२-३३-२५", "content_sanskrit": "मण्डपे उत्सवांगे वा प्रकुर्यादंकुरार्पणम् ।\nअद्भुतेष्वथ जातेषु शांतिं कुर्यात्पुरोदिताम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003789025, "chapter_id": 23789, "verse_number": "२-२-३३-२६", "content_sanskrit": "रथ्या सुसंस्कृता कार्या महावेदीं यथा व्रजेत् ।\nपार्श्वयोर्मंडलं कुर्यात्पथि गुल्मादिभिः फलैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003789026, "chapter_id": 23789, "verse_number": "२-२-३३-२७", "content_sanskrit": "सुमनस्तबकैर्माल्यैर्दुकूलैश्चामरैस्तथा ।\nयथा सुपुष्पितारण्यराजी तत्र विराजते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003789027, "chapter_id": 23789, "verse_number": "२-२-३३-२८", "content_sanskrit": "भूमिः समा च कार्या वै निष्पंका सुखचारणा ।\nनिर्मला च सुगन्धा च सुदूराद्वर्जितोत्करा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003789028, "chapter_id": 23789, "verse_number": "२-२-३३-२९", "content_sanskrit": "धूपपात्राण्यनुपदं दिगामोदकराणि च ।\nचंदनांभः परिक्षेपो यंत्रपातोत्करस्तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003789029, "chapter_id": 23789, "verse_number": "२-२-३३-३०", "content_sanskrit": "बहूनि ऋतुपुष्पाणि पुष्पवृष्ट्यर्थमेव हि ।\nनटनर्त्तकमुख्याश्च गायना बहवस्तथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003789030, "chapter_id": 23789, "verse_number": "२-२-३३-३१", "content_sanskrit": "वेश्या यौवनगर्वाढ्याः रूपालंकारभूषिताः ।\nमृदंगा पणवाश्चैव भेरीढक्कादयस्तथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003789031, "chapter_id": 23789, "verse_number": "२-२-३३-३२", "content_sanskrit": "बहवो बहुधा तत्र पताकाश्चित्रितांतराः ।\nध्वजाश्च बहवस्तत्र स्वर्णराजतनिर्मिताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003789032, "chapter_id": 23789, "verse_number": "२-२-३३-३३", "content_sanskrit": "वैजयंत्यो बहुविधा भूमिगा वाहनास्तथा ।\nहस्तिनश्च हयाश्चैव सुसन्नद्धाः स्वलंकृताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003789033, "chapter_id": 23789, "verse_number": "२-२-३३-३४", "content_sanskrit": "एवं संभृतसंभारः क्षितिपालः शुचिव्रतः ।\nमुदा भक्त्या च परया युक्तः कुर्यान्महोत्सवम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003789034, "chapter_id": 23789, "verse_number": "२-२-३३-३५", "content_sanskrit": "आषाढस्य सिते पक्षे द्वितीया पुष्यसंयुता ।\nअरुणोदयवेलायां तस्यां देवं प्रपूजयेत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003789035, "chapter_id": 23789, "verse_number": "२-२-३३-३६", "content_sanskrit": "ब्राह्मणैर्वैष्णवैः सार्द्धं यतिभिश्च तपस्विभिः ।\nविज्ञापयेद्देवदेवं यात्रायै संस्कृतांजलिः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003789036, "chapter_id": 23789, "verse_number": "२-२-३३-३७", "content_sanskrit": "इन्द्रद्युम्नं क्षितिभुजं यथाज्ञासीः पुरा विभो ।\nविजयस्व रथे नाथ गुंडिचामण्डपं प्रति ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003789037, "chapter_id": 23789, "verse_number": "२-२-३३-३८", "content_sanskrit": "तवापांगविलोकेन प्रपुनंतु दिशो दश ।\nनिःश्रेयसपदं यांतु स्थावराणि चराणि च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003789038, "chapter_id": 23789, "verse_number": "२-२-३३-३९", "content_sanskrit": "अवतारः कृतो ह्येष लोकानुग्रहकाम्यया ।\nतदेहि भगवन्प्रीत्या चरणं न्यस्य भूतले ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003789039, "chapter_id": 23789, "verse_number": "२-२-३३-४०", "content_sanskrit": "ततः कर्पूरचूर्णैश्च सुमनोभिरवाकिरेत् ।\nपथि शाकुनसूक्तानि प्रपठंति द्विजातयः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003789040, "chapter_id": 23789, "verse_number": "२-२-३३-४१", "content_sanskrit": "केचिन्मंगलगाथाश्च केचिज्जय जयेति च ।\nजितं त इति मन्त्रं वै केचिदुच्चैर्जपंति च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003789041, "chapter_id": 23789, "verse_number": "२-२-३३-४२", "content_sanskrit": "सूतमागधमुख्याश्च कीर्तिं पुण्यां मुदा जगुः ।\nस्वर्णदंडप्रकीर्णानां श्रेणी चोभयपार्श्वयोः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003789042, "chapter_id": 23789, "verse_number": "२-२-३३-४३", "content_sanskrit": "लीलयांदोलयंति स्म रणत्कंकणमंजुलम् ।\nस्वर्णपात्रपरिक्षिप्तकृष्णागुरुसुधूपितैः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003789043, "chapter_id": 23789, "verse_number": "२-२-३३-४४", "content_sanskrit": "सुरभीकृतसर्वाशा मुखे व्योमांगणे तथा ।\nचर्चरीझर्झरीवेणुवीणामाधुरिकादयः ।\nशब्दायंते सुमधुरं गोविंदविजयांतरे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003789044, "chapter_id": 23789, "verse_number": "२-२-३३-४५", "content_sanskrit": "एवं प्रवृत्ते समये कृष्णं रामपुरःसरम् ।\nनयंति विप्रा भद्रां च क्षत्रियाश्च विशस्तथा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003789045, "chapter_id": 23789, "verse_number": "२-२-३३-४६", "content_sanskrit": "छत्रमाला समुदिता मुक्तास्रक्चीनतोरणा ।\nरत्नध्वजा हेमदंडाः पार्श्वयोर्मुरवैरिणः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003789046, "chapter_id": 23789, "verse_number": "२-२-३३-४७", "content_sanskrit": "राजा चतुर्विधा वर्णा अन्ये ये च पृथग्जनाः ।\nदीना महांतश्च तदा समानास्तत्र भांति वै ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003789047, "chapter_id": 23789, "verse_number": "२-२-३३-४८", "content_sanskrit": "सलीलचरणन्यासं तूलिकास्तरणेषु तान् ।\nवासयंतः क्वचित्छांता देवांस्ते रथमन्वियुः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003789048, "chapter_id": 23789, "verse_number": "२-२-३३-४९", "content_sanskrit": "महोत्सवं समासाद्य गीतकोलाहलानि च ।\nकरे कृत्वा जगन्नाथं भ्रामयित्वा रथोत्तमम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003789049, "chapter_id": 23789, "verse_number": "२-२-३३-५०", "content_sanskrit": "रामं कृष्णं सुभद्रां च रथमध्ये निवेशयेत् ।\nचारुचंद्रातपाढ्येन मंडपेन विराजिते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003789050, "chapter_id": 23789, "verse_number": "२-२-३३-५१", "content_sanskrit": "किंकिणीमालिकाभिश्च माल्यचामरभूषिते ।\nससारकृष्णागुरुजधूपपूरितगर्भके ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003789051, "chapter_id": 23789, "verse_number": "२-२-३३-५२", "content_sanskrit": "ततस्तान्वासयित्वा तु तूलिकासु सुरोत्तमान् ।\nभूषयेद्विविधैर्भक्त्या वस्त्रालंकार माल्यकैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003789052, "chapter_id": 23789, "verse_number": "२-२-३३-५३", "content_sanskrit": "पूजयेदुपचारैस्तैः समृद्धैर्भक्तिभावितैः ।\nनातः परतरं विष्णोर्यात्रांतरमवेक्ष्यते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003789053, "chapter_id": 23789, "verse_number": "२-२-३३-५४", "content_sanskrit": "यत्र स्वयं त्रिलोकेशः स्यंदनेन कुतूहलात् ।\nमानयन्पूर्वमाज्ञां तां वर्षे वर्षे व्रजेदसौ ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003789054, "chapter_id": 23789, "verse_number": "२-२-३३-५५", "content_sanskrit": "रथस्थितं व्रजंतं तं महावेदीमहोत्सवे ।\nये पश्यंति मुदा भक्त्या वासस्तेषां हरेः पदे ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003789055, "chapter_id": 23789, "verse_number": "२-२-३३-५६", "content_sanskrit": "सत्यं सत्यं पुनः सत्यं प्रतिजाने द्विजोत्तमाः ।\nनातः श्रेयः परं विष्णोरुत्सवः शास्त्रसंमतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003789056, "chapter_id": 23789, "verse_number": "२-२-३३-५७", "content_sanskrit": "यथा रथविहारोऽयं महावेदीमहोत्सवः ।\nयत्रागत्य दिवो देवाः स्वर्गं यांत्यधिकारिणः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003789057, "chapter_id": 23789, "verse_number": "२-२-३३-५८", "content_sanskrit": "किं वच्मि तस्य माहात्म्यमुत्सवस्य मुरद्विषः ।\nयस्य संकीर्तनात्पापं नश्येज्जन्म शतोद्भवम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003789058, "chapter_id": 23789, "verse_number": "२-२-३३-५९", "content_sanskrit": "महावेदीं व्रजंतं तं रथस्थं पुरुषोत्तमम् ।\nबलभद्रं सुभद्रां च जन्मकोटिसमुद्भवम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003789059, "chapter_id": 23789, "verse_number": "२-२-३३-६०", "content_sanskrit": "दृष्ट्वा पापं नाशयति नात्र कार्या विचारणा ।\nरथच्छायां समाक्रम्य ब्रह्महत्या व्यपोहति ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003789060, "chapter_id": 23789, "verse_number": "२-२-३३-६१", "content_sanskrit": "तद्रेणुसंसक्तवपुस्त्रिविधां पापसंहतिम् ।\nनाशयेत्स्वर्गगंगायाः स्नानजं फलमाप्नुयात् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003789061, "chapter_id": 23789, "verse_number": "२-२-३३-६२", "content_sanskrit": "घनांबुवृष्टियोगेन रथमार्गे तु पंकिले ।\nदिव्यदृष्ट्या च कृष्णस्य समस्तमलहारिणि ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003789062, "chapter_id": 23789, "verse_number": "२-२-३३-६३", "content_sanskrit": "तत्र ये प्रणिपातांस्तु कुर्वते वैष्णवोत्तमाः ।\nअनादिव्यूढपंकांस्ते हित्वा मोक्षमवाप्नुयुः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003789063, "chapter_id": 23789, "verse_number": "२-२-३३-६४", "content_sanskrit": "गवां कोटिप्रदानस्य कन्यानामयुतस्य च ।\nवाजिमेधसहस्रस्य फलं प्राप्नोत्यसंशयः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003789064, "chapter_id": 23789, "verse_number": "२-२-३३-६५", "content_sanskrit": "अनुगच्छंति कृष्णं ये यात्राकौतूहलादपि ।\nअनुव्रजंति नित्यं वै देवाः शक्रपुरोगमाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003789065, "chapter_id": 23789, "verse_number": "२-२-३३-६६", "content_sanskrit": "पश्यंति ये रथं यांतं दारुब्रह्म सनातनम् ।\nपदे पदेऽश्वमेधस्य फलं तेषां प्रकीर्तितम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003789066, "chapter_id": 23789, "verse_number": "२-२-३३-६७", "content_sanskrit": "वेदैः स्तुवंति वेदानां वक्तारो मोक्षदायिनम् ।\nइतिहासपुराणाद्यैः स्तोत्रैर्वापि स्वयंकृतैः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003789067, "chapter_id": 23789, "verse_number": "२-२-३३-६८", "content_sanskrit": "स्तुवंति पुंडरीकाक्षं ये वै विगतकल्मषाः ।\nवैष्णवं योगमास्थाय मोदंते नारदादिभिः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003789068, "chapter_id": 23789, "verse_number": "२-२-३३-६९", "content_sanskrit": "कुर्वंति वासुदेवाग्रे जयशब्देन वा स्तुतिम् ।\nते वै जयंति पापानि विविधानि न संशयः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003789069, "chapter_id": 23789, "verse_number": "२-२-३३-७०", "content_sanskrit": "लयतालानभिज्ञोपि गीतमाधुर्यवर्जितः ।\nनर्त्तनं कुरुते वापि गायत्यथ नरोत्तमः ।\nवैष्णवोत्तमसंसर्गान्मुक्तिं प्राप्नोत्यसंशयः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003789070, "chapter_id": 23789, "verse_number": "२-२-३३-७१", "content_sanskrit": "नामानि कीर्तयन्नस्य तेन याति सहैव यः ।\nअनुव्रज्यात्तत्फलं वै प्राप्नोत्यत्र न संशयः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003789071, "chapter_id": 23789, "verse_number": "२-२-३३-७२", "content_sanskrit": "जय कृष्ण जय कृष्ण जय कृष्णेति यो वदेत् ।\nगुंडिचानगरं यांतं कृष्णं भक्तिसमन्वितः ।\nन मातृगर्भवासस्य स च दुःखमवाप्नुयात् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003789072, "chapter_id": 23789, "verse_number": "२-२-३३-७३", "content_sanskrit": "चामरैर्व्यजनैः पुष्पस्तबकैर्नीलचोलकैः ।\nरथस्याग्रस्थितो यो वै वीजयेत्पुरुषोत्तमम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003789073, "chapter_id": 23789, "verse_number": "२-२-३३-७४", "content_sanskrit": "स वीज्यमानोप्सरोभिर्गंधर्वैरुपशोभितः ।\nअनुव्रजद्भिस्त्रिदशैर्महेंद्रासनसंस्थितः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003789074, "chapter_id": 23789, "verse_number": "२-२-३३-७५", "content_sanskrit": "भुनक्ति भोगानतुलान्यावदाभूतसंप्लवम् ।\nतदंते च ब्रह्मलोकं प्राप्य मुक्तिमवाप्नुयात् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003789075, "chapter_id": 23789, "verse_number": "२-२-३३-७६", "content_sanskrit": "कृष्णस्य पुरतो ये वै पुष्पवृष्टिं प्रकुर्वते ।\nते वै मनोगतान्सर्वान्प्राप्नुवंति मनोरथान् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003789076, "chapter_id": 23789, "verse_number": "२-२-३३-७७", "content_sanskrit": "सहस्रनामभिः पुण्यैः पर्यटंति रथं तु ये ।\nतेषां प्रदक्षिणं कुर्युस्त्रिदशानतकंधराः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003789077, "chapter_id": 23789, "verse_number": "२-२-३३-७८", "content_sanskrit": "वसंति वैकुण्ठगृहे विष्णुतुल्यपराक्रमाः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003789078, "chapter_id": 23789, "verse_number": "२-२-३३-७९", "content_sanskrit": "तस्मिन्काले महापुण्ये देवर्षिपितृसेविते ।\nएकं ब्रह्म त्रिधाभूतं माययानुगतं स्वया ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003789079, "chapter_id": 23789, "verse_number": "२-२-३३-८०", "content_sanskrit": "साक्षाद्दारुस्वरूपेण महावेदीमहोत्सवम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003789080, "chapter_id": 23789, "verse_number": "२-२-३३-८१", "content_sanskrit": "रथारूढः कौतुकवान्यत्रयाति जगत्प्रभुः ।\nतस्मिन्काले पृथिव्यां तु चरेत्तत्र महोत्सवम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003789081, "chapter_id": 23789, "verse_number": "२-२-३३-८२", "content_sanskrit": "देवा अप्युत्सवे तस्मिन्पुरुहूतपुरोगमाः ।\nअभिमानं परित्यज्य श्रेणीभूता हि पार्श्वयोः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003789082, "chapter_id": 23789, "verse_number": "२-२-३३-८३", "content_sanskrit": "प्रकुर्वते महायात्रां तैस्तैर्दिव्यैः परिच्छदैः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003789083, "chapter_id": 23789, "verse_number": "२-२-३३-८४", "content_sanskrit": "तेषामग्रेसरस्तत्र देवोपि प्रपितामहः ।\nचतुर्दशानां जगतां कर्त्ता यः परमेश्वरः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003789084, "chapter_id": 23789, "verse_number": "२-२-३३-८५", "content_sanskrit": "सोऽपि तत्र जगन्नाथं रथे यांतं महोत्सवे ।\nब्रह्मलोकात्परावृत्य स्तुवन्वेदमयैः स्तवैः ।\nपदे पदे प्रणमति भगवंतं सनातनम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003789085, "chapter_id": 23789, "verse_number": "२-२-३३-८६", "content_sanskrit": "यद्यप्यब्जनिधेः कृष्णान्न भेदोऽस्ति तथाप्ययम् ।\nमहोत्सवस्य महिमा यत्र सर्वेऽनुयायिनः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003789086, "chapter_id": 23789, "verse_number": "२-२-३३-८७", "content_sanskrit": "नातः परतरो लोके महावेदीमहोत्सवात् ।\nसर्वपापहरो योगः सर्वतीर्थफलप्रदः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003789087, "chapter_id": 23789, "verse_number": "२-२-३३-८८", "content_sanskrit": "कृष्णमुद्दिश्य यस्तत्र दानं ददाति वै नरः ।\nयत्किंचिदक्षयफलं मेरुदानेन तत्समम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003789088, "chapter_id": 23789, "verse_number": "२-२-३३-८९", "content_sanskrit": "तस्याग्रे देवदेवस्य व्रजतो गुंडिचालयम् ।\nयत्किंचित्कुरुते कर्म तत्तदक्षयमश्नुते ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003789089, "chapter_id": 23789, "verse_number": "२-२-३३-९०", "content_sanskrit": "उपायनानि नाना वै भक्ष्यभोज्यानि चैव हि ।\nसमर्पयंति देवाय तत्प्रीत्यै वा द्विजन्मने ।\nतेषामक्षयपुण्यानि सर्वकामप्रदानि च ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003789090, "chapter_id": 23789, "verse_number": "२-२-३३-९१", "content_sanskrit": "हरेरग्रेसरा ये वै पश्यंतस्तन्मुखांबुजम् ।\nपदे पदे नमंतश्च पंकधूलिपरिप्लुताः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003789091, "chapter_id": 23789, "verse_number": "२-२-३३-९२", "content_sanskrit": "विहाय पाप कवचमभेद्यं कोटिजन्मभिः ।\nक्षणान्मुक्तिफलं प्राप्य यांति विष्णोः शुभालयम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003789092, "chapter_id": 23789, "verse_number": "२-२-३३-९३", "content_sanskrit": "सर्वक्रतूनां तीर्थानां दानानां यांति ते फलम् ।\nभगवद्भक्तिभावानां नातः पुण्यतमो महः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003789093, "chapter_id": 23789, "verse_number": "२-२-३३-९४", "content_sanskrit": "एवं स भगवान्कृष्णः सुभद्रारामसंगतः ।\nव्रजन्स्यंदनश्रेष्ठस्थो द्योतयंश्च चतुर्दिशः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003789094, "chapter_id": 23789, "verse_number": "२-२-३३-९५", "content_sanskrit": "श्रीमदंगोपसृष्टेन मरुता सर्वदेहिनाम् ।\nपापानि नाशयञ्छ्रीमान्दयालुर्भक्तभावनः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003789095, "chapter_id": 23789, "verse_number": "२-२-३३-९६", "content_sanskrit": "अज्ञानामप्यविश्वासभाजां विश्वासहेतवे ।\nनिसर्गमुक्तिदोऽप्येष यात्रारंभान्करोति वै ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003789096, "chapter_id": 23789, "verse_number": "२-२-३३-९७", "content_sanskrit": "व्रजन्समृद्ध्या देवानां मर्त्यानां च जनार्दनः ।\nसूर्ये ललाटं तपति मध्याह्ने मार्गमध्यतः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003789097, "chapter_id": 23789, "verse_number": "२-२-३३-९८", "content_sanskrit": "श्रांता कर्षजनस्तस्थौ म्लायन्वै तद्रजोवृतः ।\nतत्रातपस्य शांत्यर्थं दर्पणेष्वभिषेचयेत् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003789098, "chapter_id": 23789, "verse_number": "२-२-३३-९९", "content_sanskrit": "पंचामृतैः शीततोयैः पुष्पकर्पूरवासितैः ।\nचामरैश्च जलार्द्रांतैः शीतलैर्व्यजनैस्तथा ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003789099, "chapter_id": 23789, "verse_number": "२-२-३३-१००", "content_sanskrit": "वीजयेत्पुण्डरीकाक्षं सुभद्रां राममेव च ।\nशीतैश्च पानकैर्हद्यैस्तथा खण्डविकारकैः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003789100, "chapter_id": 23789, "verse_number": "२-२-३३-१०१", "content_sanskrit": "खर्जूरैर्नारिकेलैश्च नानारंभाफलैस्तथा ।\nतथा क्षीरविकारैश्च पनसैस्तृणराजकैः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003789101, "chapter_id": 23789, "verse_number": "२-२-३३-१०२", "content_sanskrit": "इक्षुभिः स्वादुहृद्यैश्च फलैर्नानाविधैस्तथा ।\nवासितैः शीततोयैश्च पक्वतांबूलपत्रकैः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003789102, "chapter_id": 23789, "verse_number": "२-२-३३-१०३", "content_sanskrit": "सकर्पूरलवंगाद्यैः पूजयेत्पुरुषोत्तमम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003789103, "chapter_id": 23789, "verse_number": "२-२-३३-१०४", "content_sanskrit": "तस्मिन्काले द्विजश्रेष्ठा ये पश्यंति जनार्दनम् ।\nपूजयंति यथाशक्ति न ते संसारजं श्रमम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003789104, "chapter_id": 23789, "verse_number": "२-२-३३-१०५", "content_sanskrit": "प्राप्नुवंति द्विजश्रेष्ठा ब्रह्मलोकनिवासिनः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003789105, "chapter_id": 23789, "verse_number": "२-२-३३-१०६", "content_sanskrit": "रथत्रयस्थितं देवत्रयं ये पुरुषर्षभाः ।\nप्रदक्षिणं प्रकुर्वंति त्रिश्चतुः सप्त एव वा ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003789106, "chapter_id": 23789, "verse_number": "२-२-३३-१०७", "content_sanskrit": "दशप्रणामान्कृत्वांते स्थिताः प्रांजलयोऽग्रतः ।\nपुरारथस्थितान्ब्रह्मा स्तुतिभिर्याभिरब्जभूः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003789107, "chapter_id": 23789, "verse_number": "२-२-३३-१०८", "content_sanskrit": "तुष्टाव ताभिर्देवेशं स्तुवंति परमेश्वरम् ।\nये नरा ब्रह्मलोकं ते प्रयांति नियतं द्विजाः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003789108, "chapter_id": 23789, "verse_number": "२-२-३३-१०९", "content_sanskrit": "ततोऽपराह्णे देवेशं दक्षिणानिलवीजितम् ।\nशनैः शनैर्नयेद्गीतैवेंणुवीणादिनादितैः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003789109, "chapter_id": 23789, "verse_number": "२-२-३३-११०", "content_sanskrit": "बंदिनः स्तुतिपाठैश्च कलैर्मधुरिकास्वनैः ।\nनिरंतरैः पुष्पवर्षैश्चामरांदोलनैस्तथा ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003789110, "chapter_id": 23789, "verse_number": "२-२-३३-१११", "content_sanskrit": "एवं व्रजति देवेशे सूर्यश्चास्तंगतो भवेत् ।\nदीपिकानां सहस्राणि ज्वालितानि सहस्रशः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003789111, "chapter_id": 23789, "verse_number": "२-२-३३-११२", "content_sanskrit": "तदालोकप्रकाशेन मार्गशेषश्च नीयते ।\nरथावरोहणेनैषां मण्डपारोहणेन च ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003789112, "chapter_id": 23789, "verse_number": "२-२-३३-११३", "content_sanskrit": "संमर्दः सुमहांस्तत्र दिदृक्षूणां कुतूहलात् ।\nमण्डपे वासयेद्देवं गुण्डिचाख्ये मनोहरे ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003789113, "chapter_id": 23789, "verse_number": "२-२-३३-११४", "content_sanskrit": "चारुचंद्रातपे चारुमाल्यचामरभूषिते ।\nरत्नस्तंभमये स्वर्णवेदिकोपस्कृतांतरे ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003789114, "chapter_id": 23789, "verse_number": "२-२-३३-११५", "content_sanskrit": "प्राचीरवलयावीते सुधालेपसमुज्ज्वले ।\nसाधुसोपानघटिते चतुर्द्वारोपशोभिते ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003789115, "chapter_id": 23789, "verse_number": "२-२-३३-११६", "content_sanskrit": "त्रैलोक्यांडबरयुते महावेद्यां महाक्रतोः ।\nप्रादुर्भावो महेशस्य यत्राभूद्दारुवर्ष्मणः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003789116, "chapter_id": 23789, "verse_number": "२-२-३३-११७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णव खण्डे पुरुषोत्तमक्षेत्रमाहात्म्ये गुंडिचायात्राकथनंनाम त्रयस्त्रिंशोऽध्यायः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}]