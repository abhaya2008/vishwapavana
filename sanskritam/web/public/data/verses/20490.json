[{"id": 7000490000, "chapter_id": 20490, "verse_number": "३-३७-१", "content_sanskrit": "नारद उवाच ।\nअन्यानि च महाराज तीर्थानि पावनानि तु ।\nवाराणस्यां स्थितानीह संशृणुष्व युधिष्ठिर॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000490001, "chapter_id": 20490, "verse_number": "३-३७-२", "content_sanskrit": "प्रयागादधिकं तीर्थं प्रयागं परमं शुभम् ।\nविश्वरूपं तथा तीर्थं तालतीर्थमनुत्तमम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000490002, "chapter_id": 20490, "verse_number": "३-३७-३", "content_sanskrit": "आकाशाख्यं महातीर्थं तीर्थं चैवार्षभं परम् ।\nसुनीलं च महातीर्थं गौरीतीर्थमनुत्तमम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000490003, "chapter_id": 20490, "verse_number": "३-३७-४", "content_sanskrit": "प्राजापत्यं तथा तीर्थं स्वर्गद्वारं तथैव च ।\nजंबुकेश्वरमित्युक्तं धर्माख्यं तीर्थमुत्तमम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000490004, "chapter_id": 20490, "verse_number": "३-३७-५", "content_sanskrit": "गयातीर्थं परं तीर्थं तीर्थं चैव महानदी ।\nनारायणपरं तीर्थं वायुतीर्थमनुत्तमम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000490005, "chapter_id": 20490, "verse_number": "३-३७-६", "content_sanskrit": "ज्ञानतीर्थं परं गुह्यं वाराहं तीर्थमुत्तमम् ।\nयमतीर्थं यथापुण्यं तीर्थं संमूर्तिकं शुभम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000490006, "chapter_id": 20490, "verse_number": "३-३७-७", "content_sanskrit": "अग्नितीर्थं महाराज कलशेश्वरमुत्तमम् ।\nनागतीर्थं सोमतीर्थं सूर्यतीर्थं तथैव च॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000490007, "chapter_id": 20490, "verse_number": "३-३७-८", "content_sanskrit": "पर्वताख्यं महागुह्यं मणिकर्ण्यमनुत्तमम् ।\nघटोत्कचं तीर्थवरं श्रीतीर्थं च पितामहम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000490008, "chapter_id": 20490, "verse_number": "३-३७-९", "content_sanskrit": "गंगातीर्थं तु देवेशं ययातेस्तीर्थमुत्तमम् ।\nकापिलं चैव सोमेशं ब्रह्मतीर्थमनुत्तमम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000490009, "chapter_id": 20490, "verse_number": "३-३७-१०", "content_sanskrit": "तत्र लिंगं पुराणीयं स्थातुं ब्रह्मा यथागतः ।\nतदानीं स्थापयामास विष्णुस्तल्लिंगमैश्वरम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000490010, "chapter_id": 20490, "verse_number": "३-३७-११", "content_sanskrit": "तत्र स्नात्वा समागम्य ब्रह्मा प्रोवाच तं हरिम् ।\nमयानीतमिदं लिंगं कस्मात्स्थापितवानसि॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000490011, "chapter_id": 20490, "verse_number": "३-३७-१२", "content_sanskrit": "तमाह विष्णुस्त्वत्तोऽपि रुद्रे भक्तिर्दृढा मम ।\nतस्मात्प्रतिष्ठितं लिगं नाम्ना तव भविष्यति॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000490012, "chapter_id": 20490, "verse_number": "३-३७-१३", "content_sanskrit": "भूतेश्वरं तथा तीर्थं तीर्थं धर्मसमुद्भवम् ।\nगंधर्वतीर्थं सुशुभं वाह्नेयं तीर्थमुत्तमम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000490013, "chapter_id": 20490, "verse_number": "३-३७-१४", "content_sanskrit": "दौर्वासिकं व्योमतीर्थं चंद्रतीर्थं युधिष्ठिर ।\nचिंतांगदेश्वरं तीर्थं पुण्यं विद्याधरेश्वरम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000490014, "chapter_id": 20490, "verse_number": "३-३७-१५", "content_sanskrit": "केदारतीर्थमुग्राख्यं कालंजरमनुत्तमम् ।\nसारस्वतं प्रभासं च रुद्रकर्णह्रदं शुभम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000490015, "chapter_id": 20490, "verse_number": "३-३७-१६", "content_sanskrit": "कोकिलाख्यं महातीर्थं तीर्थं चैव महालयम् ।\nहिरण्यगर्भं गोप्रेक्षं तीर्थं चैवमनुत्तमम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000490016, "chapter_id": 20490, "verse_number": "३-३७-१७", "content_sanskrit": "उपशांतं शिवं चैव व्याघ्रेश्वरमनुत्तमम् ।\nत्रिलोचनं महातीर्थं लोकार्कं चोत्तराह्वयम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000490017, "chapter_id": 20490, "verse_number": "३-३७-१८", "content_sanskrit": "कपालमोचनं तीर्थं ब्रह्महत्याविनाशनम् ।\nशुक्रेश्वरं महापुण्यमानंदपुरमुत्तमम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000490018, "chapter_id": 20490, "verse_number": "३-३७-१९", "content_sanskrit": "एवमादीनि तीर्थानि वाराणस्यां स्थितानि वै ।\nन शक्यं विस्तराद्वक्तुं कल्पकोटिशतैरपि॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]