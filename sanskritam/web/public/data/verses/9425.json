[{"id": 5000425000, "chapter_id": 9425, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे अष्टादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000425001, "chapter_id": 9425, "verse_number": "६-१८-१", "content_sanskrit": "अथ रामः प्रसन्नात्मा श्रुत्वा वायुसुतस्य ह।\nप्रत्यभाषत दुर्धर्षः श्रुतवानात्मनि स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000425002, "chapter_id": 9425, "verse_number": "६-१८-२", "content_sanskrit": "ममापि च विवक्षास्ति काचित् प्रति विभीषणम्।\nश्रोतुमिच्छामि तत् सर्वं भवद्भिः श्रेयसि स्थितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000425003, "chapter_id": 9425, "verse_number": "६-१८-३", "content_sanskrit": "मित्रभावेन सम्प्राप्तं न त्यजेयं कथंचन।\nदोषो यद्यपि तस्य स्यात् सतामेतदगर्हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000425004, "chapter_id": 9425, "verse_number": "६-१८-४", "content_sanskrit": "सुग्रीवस्त्वथ तद्वाक्यमाभाष्य च विमृश्य च।\nततः शुभतरं वाक्यमुवाच हरिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000425005, "chapter_id": 9425, "verse_number": "६-१८-५", "content_sanskrit": "स दुष्टो वाप्यदुष्टो वा किमेष रजनीचरः।\nईदृशं व्यसनं प्राप्तं भ्रातरं यः परित्यजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000425006, "chapter_id": 9425, "verse_number": "६-१८-६", "content_sanskrit": "को नाम स भवेत् तस्य यमेष न परित्यजेत्।\nवानराधिपतेर्वाक्यं श्रुत्वा सर्वानुदीक्ष्य तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000425007, "chapter_id": 9425, "verse_number": "६-१८-७", "content_sanskrit": "ईषदुत्स्मयमानस्तु लक्ष्मणं पुण्यलक्षणम्।\nइति होवाच काकुत्स्थो वाक्यं सत्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000425008, "chapter_id": 9425, "verse_number": "६-१८-८", "content_sanskrit": "अनधीत्य च शास्त्राणि वृद्धाननुपसेव्य च।\nन शक्यमीदृशं वक्तुं यदुवाच हरीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000425009, "chapter_id": 9425, "verse_number": "६-१८-९", "content_sanskrit": "अस्ति सूक्ष्मतरं किंचिद् यथात्र प्रतिभाति मा।\nप्रत्यक्षं लौकिकं चापि वर्तते सर्वराजसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000425010, "chapter_id": 9425, "verse_number": "६-१८-१०", "content_sanskrit": "अमित्रास्तत्कुलीनाश्च प्रातिदेश्याश्च कीर्तिताः।\nव्यसनेषु प्रहर्तारस्तस्मादयमिहागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000425011, "chapter_id": 9425, "verse_number": "६-१८-११", "content_sanskrit": "अपापास्तत्कुलीनाश्च मानयन्ति स्वकान् हितान्।\nएष प्रायो नरेन्द्राणां शङ्कनीयस्तु शोभनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000425012, "chapter_id": 9425, "verse_number": "६-१८-१२", "content_sanskrit": "यस्तु दोषस्त्वया प्रोक्तो ह्यादानेऽरिबलस्य च।\nतत्र ते कीर्तयिष्यामि यथाशास्त्रमिदं शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000425013, "chapter_id": 9425, "verse_number": "६-१८-१३", "content_sanskrit": "न वयं तत्कुलीनाश्च राज्यकाङ्क्षी च राक्षसः।\nपण्डिता हि भविष्यन्ति तस्माद् ग्राह्यो विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000425014, "chapter_id": 9425, "verse_number": "६-१८-१४", "content_sanskrit": "अव्यग्राश्च प्रहृष्टाश्च ते भविष्यन्ति संगताः।\nप्रणादश्च महानेषोऽन्योन्यस्य भयमागतम्।\nइति भेदं गमिष्यन्ति तस्माद् ग्राह्यो विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000425015, "chapter_id": 9425, "verse_number": "६-१८-१५", "content_sanskrit": "न सर्वे भ्रातरस्तात भवन्ति भरतोपमाः।\nमद्विधा वा पितुः पुत्राः सुहृदो वा भवद्विधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000425016, "chapter_id": 9425, "verse_number": "६-१८-१६", "content_sanskrit": "एवमुक्तस्तु रामेण सुग्रीवः सहलक्ष्मणः।\nउत्थायेदं महाप्राज्ञः प्रणतो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000425017, "chapter_id": 9425, "verse_number": "६-१८-१७", "content_sanskrit": "रावणेन प्रणिहितं तमवेहि निशाचरम्।\nतस्याहं निग्रहं मन्ये क्षमं क्षमवतां वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000425018, "chapter_id": 9425, "verse_number": "६-१८-१८", "content_sanskrit": "राक्षसो जिह्मया बुद्ध्या संदिष्टोऽयमिहागतः।\nप्रहर्तुं त्वयि विश्वस्ते विश्वस्ते मयि वानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000425019, "chapter_id": 9425, "verse_number": "६-१८-१९", "content_sanskrit": "लक्ष्मणे वा महाबाहो स वध्यः सचिवैः सह।\nरावणस्य नृशंसस्य भ्राता ह्येष विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000425020, "chapter_id": 9425, "verse_number": "६-१८-२०", "content_sanskrit": "एवमुक्त्वा रघुश्रेष्ठं सुग्रीवो वाहिनीपतिः।\nवाक्यज्ञो वाक्यकुशलं ततो मौनमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000425021, "chapter_id": 9425, "verse_number": "६-१८-२१", "content_sanskrit": "स सुग्रीवस्य तद् वाक्यं रामः श्रुत्वा विमृश्य च।\nततः शुभतरं वाक्यमुवाच हरिपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000425022, "chapter_id": 9425, "verse_number": "६-१८-२२", "content_sanskrit": "स दुष्टो वाप्यदुष्टो वा किमेष रजनीचरः।\nसूक्ष्ममप्यहितं कर्तुं मम शक्तः कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000425023, "chapter_id": 9425, "verse_number": "६-१८-२३", "content_sanskrit": "पिशाचान् दानवान् यक्षान् पृथिव्यां चैव राक्षसान्।\nअङ्गुल्यग्रेण तान् हन्यामिच्छन् हरिगणेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000425024, "chapter_id": 9425, "verse_number": "६-१८-२४", "content_sanskrit": "श्रूयते हि कपोतेन शत्रुः शरणमागतः।\nअर्चितश्च यथान्यायं स्वैश्च मांसैर्निमन्त्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000425025, "chapter_id": 9425, "verse_number": "६-१८-२५", "content_sanskrit": "स हि तं प्रतिजग्राह भार्याहर्तारमागतम्।\nकपोतो वानरश्रेष्ठ किं पुनर्मद्विधो जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000425026, "chapter_id": 9425, "verse_number": "६-१८-२६", "content_sanskrit": "ऋषेः कण्वस्य पुत्रोण कण्डुना परमर्षिणा।\nशृणु गाथा पुरा गीता धर्मिष्ठा सत्यवादिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000425027, "chapter_id": 9425, "verse_number": "६-१८-२७", "content_sanskrit": "बद्धाञ्जलिपुटं दीनं याचन्तं शरणागतम्।\nन हन्यादानृशंस्यार्थमपि शत्रुं परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000425028, "chapter_id": 9425, "verse_number": "६-१८-२८", "content_sanskrit": "आर्तो वा यदि वा दृप्तः परेषां शरणं गतः।\nअरिः प्राणान् परित्यज्य रक्षितव्यः कृतात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000425029, "chapter_id": 9425, "verse_number": "६-१८-२९", "content_sanskrit": "स चेद् भयाद् वा मोहाद् वा कामाद् वापि न रक्षति।\nस्वया शक्त्या यथान्यायं तत् पापं लोकगर्हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000425030, "chapter_id": 9425, "verse_number": "६-१८-३०", "content_sanskrit": "विनष्टः पश्यतस्तस्य रक्षिणः शरणं गतः।\nआनाय सुकृतं तस्य सर्वं गच्छेदरक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000425031, "chapter_id": 9425, "verse_number": "६-१८-३१", "content_sanskrit": "एवं दोषो महानत्र प्रपन्नानामरक्षणे।\nअस्वर्ग्यं चायशस्यं च बलवीर्यविनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000425032, "chapter_id": 9425, "verse_number": "६-१८-३२", "content_sanskrit": "करिष्यामि यथार्थं तु कण्डोर्वचनमुत्तमम्।\nधर्मिष्ठं च यशस्यं च स्वर्ग्यं स्यात् तु फलोदये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000425033, "chapter_id": 9425, "verse_number": "६-१८-३३", "content_sanskrit": "सकृदेव प्रपन्नाय तवास्मीति च याचते।\nअभयं सर्वभूतेभ्यो ददाम्येतद् व्रतं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000425034, "chapter_id": 9425, "verse_number": "६-१८-३४", "content_sanskrit": "आनयैनं हरिश्रेष्ठ दत्तमस्याभयं मया।\nविभीषणो वा सुग्रीव यदि वा रावणः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000425035, "chapter_id": 9425, "verse_number": "६-१८-३५", "content_sanskrit": "रामस्य तु वचः श्रुत्वा सुग्रीवः प्लवगेश्वरः।\nप्रत्यभाषत काकुत्स्थं सौहार्देनाभिपूरितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000425036, "chapter_id": 9425, "verse_number": "६-१८-३६", "content_sanskrit": "किमत्र चित्रं धर्मज्ञ लोकनाथशिखामणे।\nयत् त्वमार्यं प्रभाषेथाः सत्त्ववान् सत्पथे स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000425037, "chapter_id": 9425, "verse_number": "६-१८-३७", "content_sanskrit": "मम चाप्यन्तरात्मायं शुद्धं वेत्ति विभीषणम्।\nअनुमानाच्च भावाच्च सर्वतः सुपरीक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000425038, "chapter_id": 9425, "verse_number": "६-१८-३८", "content_sanskrit": "तस्मात् क्षिप्रं सहास्माभिस्तुल्यो भवतु राघव।\nविभीषणो महाप्राज्ञः सखित्वं चाभ्युपैतु नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000425039, "chapter_id": 9425, "verse_number": "६-१८-३९", "content_sanskrit": "ततस्तु सुग्रीववचो निशम्य त-\nद्धरीश्वरेणाभिहितं नरेश्वरः।\nविभीषणेनाशु जगाम संगमं\nपतत्त्रिराजेन यथा पुरंदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000425040, "chapter_id": 9425, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे अष्टादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]