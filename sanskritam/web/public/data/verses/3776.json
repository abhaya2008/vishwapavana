[{"id": 2129091, "chapter_id": 3776, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129092, "chapter_id": 3776, "verse_number": "१", "content_sanskrit": "गयेन यजमानेन सोमेनेह पुरन्दरः ।\nतर्पितः श्रूयते राजन् स तृप्तो मुदमभ्यगात् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129093, "chapter_id": 3776, "verse_number": "२", "content_sanskrit": "इह देवैः सहेन्द्रैस्तु प्रजापतिभिरेव च ।\nइष्टं बहुविधैर्यज्ञैर्महद्भिर्भूरिदक्षिणैः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129094, "chapter_id": 3776, "verse_number": "३", "content_sanskrit": "आधूर्तरयसश्चेह राजा वज्रधरं प्रभुः ।\nतर्पयामास सोमेन हयमेधेषु सप्तसु \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129095, "chapter_id": 3776, "verse_number": "४", "content_sanskrit": "तस्य सप्तसु यज्ञेषु सर्वमासीद्धिरण्मयम् ।\nवानस्पत्यं च भौमं च यद् द्रव्यं नियतं मखे \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129096, "chapter_id": 3776, "verse_number": "५", "content_sanskrit": "तेष्वेव चास्य यज्ञेषु प्रयोगाः सप्त विश्रुताः ।\nसप्तैकैकस्य यूपस्य चषालाश्च प्रतिष्ठिताः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129097, "chapter_id": 3776, "verse_number": "६", "content_sanskrit": "तस्य स्म यूपान् यज्ञेषु भ्राजमानान् हिरण्मयान् ।\nस्वयमुत्थापयामासुर्देवाः सेन्द्रा युधिष्ठिर\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129098, "chapter_id": 3776, "verse_number": "७", "content_sanskrit": "तेषु तस्य मखाग्र्येषु गयस्य पृथिवीपतेः ।\nअमाद्यदिन्द्रः सोमेन दक्षिणाभिर्द्विजातयः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129099, "chapter_id": 3776, "verse_number": "८", "content_sanskrit": "सिकता वा यथा लोके यथा वा दिवि तारकाः ।\nयथा वा वर्षतो धारा असङ्ख्येयाश्च केनचित्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129100, "chapter_id": 3776, "verse_number": "९", "content_sanskrit": "तथैव तदसङ्ख्येयं धनं यत् प्रददौ गयः ।\nसदस्येभ्यो महाराज तेषु यज्ञेषु सप्तसु\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129101, "chapter_id": 3776, "verse_number": "१०", "content_sanskrit": "भवेत् सङ्ख्येयमेतद्वै यदेतत् परिकीर्तितम् ।\nन सा शक्या तु सङ्ख्यातुं दक्षिणा दक्षिणावतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129102, "chapter_id": 3776, "verse_number": "११", "content_sanskrit": "हिरण्मयीभिर्गोभिश्च स यज्ञेषु विशांपते ।\nब्राह्मणांस्तर्पयामास नानादिग्भ्यः समागतान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129103, "chapter_id": 3776, "verse_number": "१२", "content_sanskrit": "अल्पावशेषा पृथिवी चैत्यैरासीत् समाचिता ।\nगयस्य यजमानस्य तत्रतत्र विशांपते \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129104, "chapter_id": 3776, "verse_number": "१३", "content_sanskrit": "स लोकान् प्राप्तवानैन्द्रान् कर्मणा तेन भारत ।\nसलोकतां तस्य गच्छेत् पयोष्ण्यां य उपस्पृशेत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129105, "chapter_id": 3776, "verse_number": "१४", "content_sanskrit": "तस्मात्त्वमस्यां राजेन्द्र भ्रातृभिः सहितोऽच्युत ।\nउपस्पृश्य महीपाल धूतपाप्मा भविष्यसि \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129106, "chapter_id": 3776, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129107, "chapter_id": 3776, "verse_number": "१५", "content_sanskrit": "स पयोष्ण्यां नरश्रेष्ठः स्नात्वा वै भ्रातृभिः सह ।\nवैडूर्यपर्वतं चैव नर्मदां च महानदीम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129108, "chapter_id": 3776, "verse_number": "१६", "content_sanskrit": "उद्दिश्य पाण्डवश्रेष्ठः स प्रतस्थे महीपतिः ।\nसमानवेषैस्तेजस्वी भ्रातृभिः सहितोऽनघः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129109, "chapter_id": 3776, "verse_number": "१७", "content_sanskrit": "ततोऽस्य सर्वाण्याचख्यौ लोमशो भगवानृषिः ।\nतीर्थानि रमणीयानि तत्रतत्र विशाम्पते \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129110, "chapter_id": 3776, "verse_number": "१८", "content_sanskrit": "यथायोगं यथाप्रीति स ययौ भ्रातृभिः सह ।\nसन्ददानोऽसकृद् वित्तं ब्राह्मणेभ्यः सहस्रशः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129111, "chapter_id": 3776, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129112, "chapter_id": 3776, "verse_number": "१९", "content_sanskrit": "देवानामेति कौन्तेय तथा राज्ञां सलोकताम् ।\nवैडूर्यपर्वतं दृष्ट्वा नर्मदामवतीर्य च \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129113, "chapter_id": 3776, "verse_number": "२०", "content_sanskrit": "सन्धिरेष नरश्रेष्ठ त्रेताया द्वापरस्य च ।\nएनमासाद्य कौन्तेय सर्वपापैः प्रमुच्यते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129114, "chapter_id": 3776, "verse_number": "२१", "content_sanskrit": "एष शर्य्यातियज्ञस्य देशस्तात प्रकाशते ।\nसाक्षाद्यत्रापिबत् सोममश्विभ्यां सह वासवः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2129115, "chapter_id": 3776, "verse_number": "२२", "content_sanskrit": "चुकोप भार्गवश्चापि महेन्द्राय महातपाः ।\nसंस्तम्भयामास च तं वासवं च्यवनः प्रभुः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2129116, "chapter_id": 3776, "verse_number": "२३", "content_sanskrit": "सुकन्यां चापि भार्यां स राजपुत्रीमवाप्तवान् ।\nनासत्यौ च महाराज कृतवान् सोमपीथिनौ\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2129117, "chapter_id": 3776, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2129118, "chapter_id": 3776, "verse_number": "२४", "content_sanskrit": "कथं विष्टम्भितस्तेन भगवान् पाकशासनः ।\nकिमर्थं भार्गवश्चपि कोपं चक्रे महातपाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2129119, "chapter_id": 3776, "verse_number": "२५", "content_sanskrit": "नासत्यौ च कथं ब्रह्मन् कृतवान् सोमपीथिनौ ।\nएतत् सर्वं यथावृत्तमाख्यातु भगवान् मम\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2129120, "chapter_id": 3776, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि अष्टादशोत्तरशततमोऽध्यायः ॥११८॥\n॥ तीर्थयात्रापर्वणि चतुःसप्ततितमोऽध्यायः ॥७४॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]