[{"id": 2017287, "chapter_id": 1360, "verse_number": "२-१०१-१", "content_sanskrit": "वैशम्पायन उवाच॥\nततः सम्प्रस्थिते तत्र धर्मराजे तदा नृप।\nजनाः समन्ताद्द्रष्टुं तं समारुरुहुरातुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2017288, "chapter_id": 1360, "verse_number": "२-१०१-२", "content_sanskrit": "ततः प्रासादवर्याणि विमानशिखराणि च।\nगोपुराणि च सर्वाणि वृक्षानन्यांश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2017289, "chapter_id": 1360, "verse_number": "२-१०१-३", "content_sanskrit": "अथाधिरुह्य सस्त्रीका उदासीना व्यलोकयन्।\nन हि रथ्यास्तदा शक्या गन्तुं ताश्च जनाकुलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2017290, "chapter_id": 1360, "verse_number": "२-१०१-४", "content_sanskrit": "आरुह्य स्मानतास्तत्र दीनाः पश्यन्ति पाण्डवान्।\nपदातिं वर्जितच्छत्रं चेलभूषणवर्जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2017291, "chapter_id": 1360, "verse_number": "२-१०१-५", "content_sanskrit": "वल्कलाजिनसंवीतं पार्थं दृष्ट्वा जनास्तदा।\nऊचुर्बहुविधा वाचो भृशोपहतचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2017292, "chapter_id": 1360, "verse_number": "२-१०१-६x", "content_sanskrit": "जना ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2017293, "chapter_id": 1360, "verse_number": "२-१०१-६", "content_sanskrit": "यं यान्तमनुयाति स्म चतुरङ्गबलं महत्।\nतमेकं कृष्णया सार्धमनुगच्छन्ति पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2017294, "chapter_id": 1360, "verse_number": "२-१०१-७", "content_sanskrit": "चत्वारो भ्रातरश्चैव धौम्यश्चैव पुरोहितः।\nभीमार्जुनौ वारयित्वा निकृत्या बद्धकार्मुकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2017295, "chapter_id": 1360, "verse_number": "२-१०१-८", "content_sanskrit": "धर्म एवास्थितो येन त्यक्त्वा राज्यं महात्मना।\nया न शक्या पुरा द्रष्टुं भूतैराकाशगैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2017296, "chapter_id": 1360, "verse_number": "२-१०१-९", "content_sanskrit": "तामद्य कृष्णां पश्यन्ति राजमार्गगता जनाः।\nअङ्गरागोचितां कृष्णां रक्तचन्दनसेविनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2017297, "chapter_id": 1360, "verse_number": "२-१०१-१०", "content_sanskrit": "वर्षमुष्णं च शीतं च नेष्यत्याशु विवर्णताम्।\nअद्य नूनं पृथा देवी सत्यमाविश्य भाषते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2017298, "chapter_id": 1360, "verse_number": "२-१०१-११", "content_sanskrit": "पुत्रान्स्नुषां च देवी तु द्रष्टुमद्याथ नार्हति।\nनिर्गुणस्यापि पुत्रस्य कथं स्याहुः स्वदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2017299, "chapter_id": 1360, "verse_number": "२-१०१-१२", "content_sanskrit": "किम्पुनर्यस्य लोकोऽयं जितो वृत्तेन केवलम्।\nआनृशंस्यमनुक्रोशो धृतिः शीलं दमः शमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2017300, "chapter_id": 1360, "verse_number": "२-१०१-१३", "content_sanskrit": "पाण्डवं शोभयन्त्येते षड्गुणाः पुरुषोत्तमम्।\nतस्मादस्योपघातेन प्रजाः परमपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2017301, "chapter_id": 1360, "verse_number": "२-१०१-१४", "content_sanskrit": "औदकानीव सत्वानि ग्रीष्मे सलिलसङ्क्षयात्।\nपीडया पीडितं सर्वं जगदस्य जगत्पतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2017302, "chapter_id": 1360, "verse_number": "२-१०१-१५", "content_sanskrit": "मूलस्यैवोपघातेन वृक्षः पुष्पफलोपगः।\nमूलं ह्येष मनुष्याणां धर्मराजो महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2017303, "chapter_id": 1360, "verse_number": "२-१०१-१६", "content_sanskrit": "पुष्पं फलं च पत्रं च शाखास्तस्येतरे जनाः।\nते भ्रातर इव क्षिप्रं सपुत्राः सहबान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2017304, "chapter_id": 1360, "verse_number": "२-१०१-१७", "content_sanskrit": "गच्छन्तमनुगच्छामो येन गच्छति पाण्डवः।\nउद्यानानि परित्यज्य क्षेत्राणि च गृहाणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2017305, "chapter_id": 1360, "verse_number": "२-१०१-१८", "content_sanskrit": "एकदुःखसुखाः पार्थमनुयाम सुधार्मिकम्।\nसमुच्छ्रितपताकानि परिध्वस्ताजिराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2017306, "chapter_id": 1360, "verse_number": "२-१०१-१९", "content_sanskrit": "उपात्तधनधान्यानि हृतसाराणि सर्वशः।\nरजसाऽप्यवकीर्णानि परित्यक्तानि दैवतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2017307, "chapter_id": 1360, "verse_number": "२-१०१-२०", "content_sanskrit": "मूषकैः परिधावद्भिरुद्बलैरावृतानि च।\nअपेतोदकधूमानि हीनसंमार्जनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2017308, "chapter_id": 1360, "verse_number": "२-१०१-२१", "content_sanskrit": "प्रनष्टबलिकर्मेज्यामन्त्रहोमजपानि च।\nदुष्कालेनेव भग्नानि भिन्नभाजनवन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2017309, "chapter_id": 1360, "verse_number": "२-१०१-२२", "content_sanskrit": "अस्मत्त्यक्तानि वेश्मानि सौबलः प्रतिपद्यताम्।\nवनं नगरमेवास्तु येन गच्छन्ति पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2017310, "chapter_id": 1360, "verse_number": "२-१०१-२३", "content_sanskrit": "अस्माभिश्च परित्यक्तं पुरं सम्पद्यतां वनम्।\nबिलानि दंष्ट्रिणः सर्वे वानि मृगपक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2017311, "chapter_id": 1360, "verse_number": "२-१०१-२४", "content_sanskrit": "त्यजन्त्वस्मद्भयाद्भीता गजाः सिंहा वनान्यपि।\nअनाक्रान्तं प्रपद्यन्तः सेवमानं त्यजन्तु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2017312, "chapter_id": 1360, "verse_number": "२-१०१-२५", "content_sanskrit": "तृणमांसफलादानां देशांस्त्यक्त्वा मृगद्विजाः।\nवयं पार्थैर्वने सम्यक्सह वत्स्याम निर्वृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2017313, "chapter_id": 1360, "verse_number": "२-१०१-२६", "content_sanskrit": "इत्येवं विविधा वाचो नानाजनसमीरिताः।\nशुश्राव पार्थः श्रुत्वा च न विचक्रेऽस्य मानसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2017314, "chapter_id": 1360, "verse_number": "२-१०१-२७", "content_sanskrit": "ततः प्रासादसंस्थास्तु समन्ताद्वै गृहे गृहे।\nब्राह्मणक्षत्रियविशां शूद्राणां चैव योषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2017315, "chapter_id": 1360, "verse_number": "२-१०१-२८", "content_sanskrit": "गत्वा स्वगृहजालानि उत्पाट्यावरणानि च।\nददृशुः पाण्डवान्दीनान्वल्कलाजिनवाससः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2017316, "chapter_id": 1360, "verse_number": "२-१०१-२९", "content_sanskrit": "कृष्णां त्वदृष्टपूर्वां तां व्रजन्तीं पद्भिरेव च।\nएकवस्त्रां रुदन्तीं तां मुक्तकेशीं रजस्वलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2017317, "chapter_id": 1360, "verse_number": "२-१०१-३०", "content_sanskrit": "दृष्ट्वा तदा स्त्रियः सर्वा विवर्णवदना भृशम्।\nविलप्य बहुधा मोहाद्दुःखशोकेन पीडिताः।\nहाहा धिग्धिग्धिगित्युक्त्वा नेत्रैरश्रूण्यवर्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2017318, "chapter_id": 1360, "verse_number": "२-१०१-३१", "content_sanskrit": "जनस्याथ वजः श्रुत्वा स राजा भ्रातृभिः सह।\nउद्दिश्य वनावासाय प्रतस्थे कृतनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2017319, "chapter_id": 1360, "verse_number": "२-१०१-३२x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2017320, "chapter_id": 1360, "verse_number": "२-१०१-३२", "content_sanskrit": "तस्मिन्सम्प्रस्थिते कृष्णा पृथां प्राप्य यशस्विनीम्।\nअपृच्छद्भृशदुःखार्ता याश्चान्यास्तत्र योषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2017321, "chapter_id": 1360, "verse_number": "२-१०१-३३", "content_sanskrit": "ततो निनादः सुमहान्पाण्डवान्तः पुरेऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2017322, "chapter_id": 1360, "verse_number": "२-१०१-३४", "content_sanskrit": "कुन्ती च भृशशन्तप्ता द्रौपदीं प्रेक्ष्य गच्छतीम्।\nशोकविह्वलया वाचा कृच्छ्राद्वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2017323, "chapter_id": 1360, "verse_number": "२-१०१-३५", "content_sanskrit": "वत्से शोको न ते कार्यः प्राप्येदं व्यसनं महत्।\nस्त्रीधर्माणामभिज्ञाऽसि शीलाचारवती तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2017324, "chapter_id": 1360, "verse_number": "२-१०१-३६", "content_sanskrit": "न त्वां शन्देष्टुमर्हामि भर्तॄन्प्रति शुचिस्मिते।\nसाध्वी गुणसमापन्ना भूषितं ते कुलद्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2017325, "chapter_id": 1360, "verse_number": "२-१०१-३७", "content_sanskrit": "सभाग्याः कुरवश्चेमे ये न दग्धास्त्वयाऽनघे।\nअरिष्टं व्रज पन्थानं मदनुध्यानबृंहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2017326, "chapter_id": 1360, "verse_number": "२-१०१-३८", "content_sanskrit": "भाविन्यर्थे हि सत्स्त्रीणां वैकृतं नोपजायते।\nगुरुधर्माभिगुप्ता च श्रेयः क्षिप्रमवप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2017327, "chapter_id": 1360, "verse_number": "२-१०१-३९", "content_sanskrit": "सहदेवश्च मे पुत्रः सदाऽवेक्ष्यो वने वसन्।\nयथेदं व्यसनं प्राप्य नायं सीदेन्महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2017328, "chapter_id": 1360, "verse_number": "२-१०१-४०x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2017329, "chapter_id": 1360, "verse_number": "२-१०१-४०", "content_sanskrit": "तथेन्युक्त्वा तु सा देवी स्रवन्नेत्रजलाविला।\nशोणिताक्तैकवसना मुक्तकेशी विनिर्ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2017330, "chapter_id": 1360, "verse_number": "२-१०१-४१", "content_sanskrit": "तां क्रोशन्तीं पृथा दुःखादनुवव्राज गच्छतीम्।\nअथापश्यन्सुतान्सर्वान्हृताभरणवाससः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2017331, "chapter_id": 1360, "verse_number": "२-१०१-४२", "content_sanskrit": "रुरुचर्मावृततनून्ह्रिया किञ्चिदवाह्मुखान्।\nपरैः परीतान्संहृष्टैः सुहृद्भिश्चानुशोचितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2017332, "chapter_id": 1360, "verse_number": "२-१०१-४३", "content_sanskrit": "तदवस्थान्सुतान्सर्वानुपसृत्यातिवत्सला।\nस्वजमानाऽवदच्छेकात्तत्तद्विलपती बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2017333, "chapter_id": 1360, "verse_number": "२-१०१-४४x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2017334, "chapter_id": 1360, "verse_number": "२-१०१-४४", "content_sanskrit": "कथं सद्धर्मचारित्रान्वृत्तस्थितिविभूषितान्।\nअक्षुद्रान्दृढभक्तांश्च दैवतेज्यापरान्सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2017335, "chapter_id": 1360, "verse_number": "२-१०१-४५", "content_sanskrit": "व्यसनं वः समभ्यागात्कोऽयं विधिविपर्ययः।\nकस्यापध्यानजं चेदमागः पश्यामि वो धिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2017336, "chapter_id": 1360, "verse_number": "२-१०१-४६", "content_sanskrit": "स्यात्तु मद्भाग्यदोषोऽयं याऽहं युष्मानजीजनम्।\nदुःखायासभुजोऽत्यर्थं युक्तानप्युत्तमैर्गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2017337, "chapter_id": 1360, "verse_number": "२-१०१-४७", "content_sanskrit": "कथं वत्स्यथ दुर्गेषु वने ऋद्धिविनाकृताः।\nवीर्यसत्वबलोत्साहतेजोभिरकृशाः कृशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2017338, "chapter_id": 1360, "verse_number": "२-१०१-४८", "content_sanskrit": "यद्येवमहमज्ञास्यं वने वासं हि वो ध्रुवम्।\nशतशृङ्गान्मृते पाण्डौ नागमिष्यं गजाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2017339, "chapter_id": 1360, "verse_number": "२-१०१-४९", "content_sanskrit": "धन्यं वः पितरं मन्ये तपोमेधान्वितं तथा।\nयः पुत्राधिमसम्प्राप्य स्वर्गेच्छामकरोत्प्रियाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2017340, "chapter_id": 1360, "verse_number": "२-१०१-५०", "content_sanskrit": "धन्यां चातीन्द्रियज्ञानामिमां प्राप्तां परां गतिम्।\nमन्ये तु माद्रीं धर्मज्ञां कल्याणीं सर्वथैव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2017341, "chapter_id": 1360, "verse_number": "२-१०१-५१", "content_sanskrit": "रत्या मत्या च गत्या च ययाऽहमभिसन्धिता।\nजीवितप्रियतां मह्यं धिङ्मां सङ्क्लेशभागिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2017342, "chapter_id": 1360, "verse_number": "२-१०१-५२", "content_sanskrit": "पुत्रका न विहास्ये वः कृच्छ्रलब्धान्प्रियान्सतः।\nसाऽहं यास्यामि हि वनं हा कृष्णे किं जहासि माम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2017343, "chapter_id": 1360, "verse_number": "२-१०१-५३", "content_sanskrit": "अन्तवत्यसुधर्मेऽस्मिन्धात्रा किं नु प्रमादतः।\nममान्तो नैव विहितस्तेनायुर्न जहाति माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2017344, "chapter_id": 1360, "verse_number": "२-१०१-५४", "content_sanskrit": "हा कृष्ण द्वारकावासिन्क्वासि सङ्कर्षणानुज।\nकस्मान्न त्रायसे दुःखान्मां चेमांश्च नरोत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2017345, "chapter_id": 1360, "verse_number": "२-१०१-५५", "content_sanskrit": "अनादिनिधनं ये त्वामनुध्यायन्ति वै नराः।\nतांस्त्वं पासीत्ययं वादः स गतो व्यर्थतां कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2017346, "chapter_id": 1360, "verse_number": "२-१०१-५६", "content_sanskrit": "इमे सद्धर्ममाहात्म्ययशोवीर्यानुवर्तिनः।\nनार्हन्ति व्यसनं भोक्तुं नन्वेषां क्रियतां दया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2017347, "chapter_id": 1360, "verse_number": "२-१०१-५७", "content_sanskrit": "सेयं नीत्यर्थविज्ञेषु कथमापदुपागता॥\nस्थितेषु कुलनाथेषु कथमापदुपागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2017348, "chapter_id": 1360, "verse_number": "२-१०१-५८", "content_sanskrit": "हा पाण्डो हा महाराज क्वासि किं समुपेक्षसे।\nपुत्रान्विवास्यतः साधूनरिभिर्द्यूतनिर्जितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2017349, "chapter_id": 1360, "verse_number": "२-१०१-५९", "content_sanskrit": "सहदेव निवर्तस्व ननु त्वमसि मे प्रियः।\nशरीरादपि माद्रेय मां मा त्याक्षीः कुपुत्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2017350, "chapter_id": 1360, "verse_number": "२-१०१-६०", "content_sanskrit": "व्रजन्तु ब्रातरस्तेऽमी यदि सत्याभिसन्धिनः।\nमत्परित्राणजं धर्ममिहैव त्वमवाप्नुहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2017351, "chapter_id": 1360, "verse_number": "२-१०१-६१x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2017352, "chapter_id": 1360, "verse_number": "२-१०१-६१", "content_sanskrit": "एवं विपलतीं कुन्तीमभिवाद्य प्रणम्य च।\nपाण्डवा विगतानन्दा वनायैव प्रवव्रजुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2017353, "chapter_id": 1360, "verse_number": "२-१०१-६२", "content_sanskrit": "विदुरश्चापि तामार्तां कुन्तीमाश्वास्य हेतुभिः।\nप्रावेशयद्गृहं क्षत्ता स्वयमार्ततरः शनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2017354, "chapter_id": 1360, "verse_number": "२-१०१-६३", "content_sanskrit": "धार्तराष्ट्रस्त्रिस्ताश्च निखिलेनोपलभ्य तत्।\nगमनं परिकर्षं च कृष्णाया द्यूतमण्डले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2017355, "chapter_id": 1360, "verse_number": "२-१०१-६४", "content_sanskrit": "रुरुदुः सुस्वनं सर्वा विनिन्दन्त्यः कुरून्भृशम्।\nदध्युश्च सुचिरं कालं करासक्तमुखाम्बुजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2017356, "chapter_id": 1360, "verse_number": "२-१०१-६५", "content_sanskrit": "राजा च धृतराष्ट्रस्तु पुत्राणामनयं तदा।\nध्यायन्नुद्विग्नहृदयो न शान्तिमधिजग्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2017357, "chapter_id": 1360, "verse_number": "२-१०१-६६", "content_sanskrit": "स चिन्तयन्ननेकाग्रः शोकव्याकुलचेतनः।\nक्षत्तुः सम्प्रेषयामास शीघ्रमागम्यतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2017358, "chapter_id": 1360, "verse_number": "२-१०१-६७", "content_sanskrit": "ततो जगाम विदुरो धृतराष्ट्रनिवेशनम्।\nतं पर्यपृच्छत्संविग्नो धृतराष्ट्रो जनाधिपः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2017359, "chapter_id": 1360, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अनुद्यूतपर्वणि एकोत्तरशततमोऽध्यायः॥ १०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]