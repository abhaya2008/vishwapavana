[{"id": 50024444, "chapter_id": 11857, "verse_number": "1", "content_sanskrit": "॥ आजीगर्तिः शुनःशेपः। अग्निः। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024445, "chapter_id": 11857, "verse_number": "2", "content_sanskrit": "वसि॑ष्वा॒ हि मि॑येध्य॒ वस्त्रा॑ण्यूर्जां पते। सेमं नो॑ अध्व॒रं य॑ज॥ २६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024446, "chapter_id": 11857, "verse_number": "3", "content_sanskrit": "नि नो॒ होता॒ वरे॑ण्य॒ः सदा॑ यविष्ठ॒ मन्म॑भिः। अग्ने॑ दि॒वित्म॑ता॒ वच॑ः॥ २६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024447, "chapter_id": 11857, "verse_number": "4", "content_sanskrit": "आ हि ष्मा॑ सू॒नवे॑ पि॒तापिर्यज॑त्या॒पये॑। सखा॒ सख्ये॒ वरे॑ण्यः॥ २६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024448, "chapter_id": 11857, "verse_number": "5", "content_sanskrit": "आ नो॑ ब॒र्ही रि॒शाद॑सो॒ वरु॑णो मि॒त्रो अ॑र्य॒मा। सीद॑न्तु॒ मनु॑षो यथा॥ २६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024449, "chapter_id": 11857, "verse_number": "6", "content_sanskrit": "पूर्व्य॑ होतर॒स्य नो॒ मन्द॑स्व स॒ख्यस्य॑ च। इ॒मा उ॒ षु श्रु॑धी॒ गिर॑ः॥ २६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024450, "chapter_id": 11857, "verse_number": "7", "content_sanskrit": "यच्चि॒द्धि शश्व॑ता॒ तना॑ दे॒वंदे॑वं॒ यजा॑महे। त्वे इद्धू॑यते ह॒विः॥ २६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024451, "chapter_id": 11857, "verse_number": "8", "content_sanskrit": "प्रि॒यो नो॑ अस्तु वि॒श्पति॒र्होता॑ म॒न्द्रो वरे॑ण्यः। प्रि॒याः स्व॒ग्नयो॑ व॒यम्॥ २६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024452, "chapter_id": 11857, "verse_number": "9", "content_sanskrit": "स्व॒ग्नयो॒ हि वार्यं॑ दे॒वासो॑ दधि॒रे च॑ नः। स्व॒ग्नयो॑ मनामहे॥ २६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024453, "chapter_id": 11857, "verse_number": "10", "content_sanskrit": "अथा॑ न उ॒भये॑षा॒ममृ॑त॒ मर्त्या॑नाम्। मि॒थः स॑न्तु॒ प्रश॑स्तयः॥ २६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024454, "chapter_id": 11857, "verse_number": "11", "content_sanskrit": "विश्वे॑भिरग्ने अ॒ग्निभि॑रि॒मं य॒ज्ञमि॒दं वच॑ः। चनो॑ धाः सहसो यहो॥ २६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]