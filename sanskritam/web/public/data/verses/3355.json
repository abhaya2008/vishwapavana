[{"id": 2108677, "chapter_id": 3355, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108678, "chapter_id": 3355, "verse_number": "१", "content_sanskrit": "एलापत्रस्य तु वचः श्रुत्वा नागा द्विजोत्तम ।\nसर्वे ते हृष्टमनसः साधु साध्वित्यपूजयन् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108679, "chapter_id": 3355, "verse_number": "२", "content_sanskrit": "ततः प्रभृति तां कन्यां वासुकिः पर्यरक्षत ।\nजरत्कारुं स्वसारं वै महद् हर्षमवाप सः\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108680, "chapter_id": 3355, "verse_number": "३", "content_sanskrit": "ततोऽतीवमहान् कालः समतीत इवाभवत् ।\nततो देवासुराः सर्वे ममन्थुर्वरुणालयम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108681, "chapter_id": 3355, "verse_number": "४", "content_sanskrit": "तत्र नेत्रमभून्नागो वासुकिर्बलिनां वरः ।\nसुसंस्थाप्य च तत्कर्म  पितामहमथाब्रुवन् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108682, "chapter_id": 3355, "verse_number": "५", "content_sanskrit": "भगवन् शापभीतोऽयं वासुकिस्तप्यते भृशम् ।\nतस्येदं मनसः शल्यं समुद्धर्तुं त्वमर्हसि \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108683, "chapter_id": 3355, "verse_number": "६", "content_sanskrit": "जनन्याः शापजं देव ज्ञातीनां हितकाङ्क्षिणः ।\nभीतो ह्ययं सदाऽस्माकं प्रियकारी च नागराट् ।\nकुरु प्रसादं देवेश शमयास्य मनोज्वरम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108684, "chapter_id": 3355, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108685, "chapter_id": 3355, "verse_number": "७", "content_sanskrit": "मयैव तद् वितीर्णं वै वचनं मनसाऽमराः ।\nएलापत्रेण नागेन यदत्राभिहितं पुरा \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108686, "chapter_id": 3355, "verse_number": "८", "content_sanskrit": "तत् करोत्वेष नागेन्द्रः काले प्राप्ते वचस्तदा ।\nविनशिष्यन्ति ये पापा न तु ते धर्मचारिणः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108687, "chapter_id": 3355, "verse_number": "९", "content_sanskrit": "उत्पन्नः स जरत्कारुस्तपस्युग्रे रतो द्विजः ।\nतस्यैतां भगिनीं काले जरत्कारुं प्रयच्छतु \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108688, "chapter_id": 3355, "verse_number": "१०", "content_sanskrit": "एलापत्रेण च वचस्तदोक्तं भुजगोत्तम ।\nपन्नगानां हितं देवास्तथा तन्न तदन्यथा \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108689, "chapter_id": 3355, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108690, "chapter_id": 3355, "verse_number": "११", "content_sanskrit": "एतच्छ्रुत्वा स नागेन्द्रः पितामहवचस्तदा ।\nसर्पान् बहून् जरत्कारोर्नित्ययुक्तः समादधात् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108691, "chapter_id": 3355, "verse_number": "१२", "content_sanskrit": "जरत्कारुर्यदा भार्यामिच्छेद् वरयितुं प्रभुः ।\nशीघ्रमेत्य ममाऽऽख्येयं तन्नः श्रेयो भविष्यति \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108692, "chapter_id": 3355, "verse_number": "३४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि चतुःस्त्रिंशोऽध्यायः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108693, "chapter_id": 3355, "verse_number": "२२", "content_sanskrit": "॥ आस्तीकपर्वणि द्वाविंशोऽध्यायः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]