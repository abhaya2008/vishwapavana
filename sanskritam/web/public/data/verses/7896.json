[{"id": 33000308, "chapter_id": 7896, "verse_number": "1", "content_sanskrit": "कृषते कृषतीत्येते कृषौ क्षुरति कर्षति । रदत्येवं विलिखति हलति स्युः खनत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 33000309, "chapter_id": 7896, "verse_number": "2", "content_sanskrit": "बीजाकरोत्युप्तकृष्टौ स्याद्‌ द्वितीयाकरोति च । शम्बाकरोति द्विगुणाकरोति द्विःकृषौ त्रयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 33000310, "chapter_id": 7896, "verse_number": "3", "content_sanskrit": "तृतीया त्रिगुणाभ्यां च करोति त्रिःकृषौ मतम्‌ । आख्यातानि खनत्यादीन्यूहनीयानि चाऽऽत्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 33000311, "chapter_id": 7896, "verse_number": "4", "content_sanskrit": "हलिग्रहे हलयति हलिरुक्तो महद्धलम्‌ । वपत्युप्तौ प्रकिरति वपतेऽप्यथ रोपणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 33000312, "chapter_id": 7896, "verse_number": "5", "content_sanskrit": "शूलयत्यपि संरोहयति संरोपयत्यपि । ध्रुवति ध्रवति स्थैर्ये स्थिरीभवति खायति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 33000313, "chapter_id": 7896, "verse_number": "6", "content_sanskrit": "बदत्येते च खदति मूलति प्रतितिष्ठति । पायत्येते वायति च शोषे शुष्यति शुण्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 33000314, "chapter_id": 7896, "verse_number": "7", "content_sanskrit": "आश्यायते शुण्ठयति लङ्घतेऽप्यथ वर्षति । उनत्ति शीकते शर्धत्यपि मर्धति सिञ्चति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 33000315, "chapter_id": 7896, "verse_number": "8", "content_sanskrit": "आर्द्रीकरोति च ज्ञेयम्‌ आत्मनेऽपि चतुष्टयम्‌ । सीकयति तेमयतीत्यादि जेषति सूदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 33000316, "chapter_id": 7896, "verse_number": "9", "content_sanskrit": "सचते पर्षति गरत्यपि मेषति मर्षति । घरत्युक्षति सेके स्युर्नेषत्यपि च शिम्प्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 33000317, "chapter_id": 7896, "verse_number": "10", "content_sanskrit": "गडत्येवं मेहति च तथा मिन्वति निन्वति । क्लिद्यति स्तिम्यति स्तीम्यत्यार्द्रीभावे च तिम्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 33000318, "chapter_id": 7896, "verse_number": "11", "content_sanskrit": "स्युः पुंसयति पुष्णाति दृहत्यादि च वर्धने । सञ्चये सम्विभर्तीति सम्भरत्यात्मने त्रयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 33000319, "chapter_id": 7896, "verse_number": "12", "content_sanskrit": "सञ्चिनोति खलत्येवं सम्भाण्डयत इत्यपि । राशीकरोत्यात्मने द्वौ समूहति समूहते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 33000320, "chapter_id": 7896, "verse_number": "13", "content_sanskrit": "उच्चिनोति शिलत्युञ्छे सिलत्युच्चिनुते तथा । उञ्छति ध्रासयति च ध्रस्नात्यपि तथेषति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}, {"id": 33000321, "chapter_id": 7896, "verse_number": "14", "content_sanskrit": "अवहन्तीति वैतुष्यकरणे कण्डयत्यपि । फलीकरोति वितुषीकरोतीत्यात्मने द्वयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14, "avatarnika": ""}, {"id": 33000322, "chapter_id": 7896, "verse_number": "15", "content_sanskrit": "परापुनात्यात्मनेऽपि प्रस्फोटयति तत्समम्‌ । मिमीते मायते माने माहते मस्यतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15, "avatarnika": ""}, {"id": 33000323, "chapter_id": 7896, "verse_number": "16", "content_sanskrit": "शुल्बयत्यपि सम्माति सम्भवे सम्भवत्यपि । पणते दीव्यति तथाऽऽत्मने व्यवहरत्यदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16, "avatarnika": ""}, {"id": 33000324, "chapter_id": 7896, "verse_number": "17", "content_sanskrit": "व्यवहारे च पनते परिवर्तयतीत्यपि । क्रीणाति चैवं क्रीणीते विसारयति च क्रये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17, "avatarnika": ""}, {"id": 33000325, "chapter_id": 7896, "verse_number": "18", "content_sanskrit": "विक्रीणीते निमयतेऽवक्रीणीते च विक्रये । सत्याकरोत्यात्मनेऽपि तुल्यौ सत्यापयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18, "avatarnika": ""}, {"id": 33000326, "chapter_id": 7896, "verse_number": "19", "content_sanskrit": "निष्णाति दक्षते चाऽपि नैपुण्ये निपुणत्यपि । अर्जने त्वर्जयति च तथैवाऽर्जति सर्जति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19, "avatarnika": ""}, {"id": 33000327, "chapter_id": 7896, "verse_number": "20", "content_sanskrit": "कलयत्यपि सङ्ख्याति सङ्ख्याने गणयत्यपि । सञ्चष्टे कलते तुल्यौ त्वाहन्ति गुणयत्यमू ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20, "avatarnika": ""}, {"id": 33000328, "chapter_id": 7896, "verse_number": "21", "content_sanskrit": "उत्पंसयति तु प्रोञ्छे प्रोञ्छत्युत्सारयत्यपि । वण्डति व्युष्यति तथा विभजत्यात्मनेऽप्ययम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21, "avatarnika": ""}, {"id": 33000329, "chapter_id": 7896, "verse_number": "22", "content_sanskrit": "विभागे वण्टयति च विभाजयत्यवमाति च । न्यासे निक्षिप्यति न्यस्यत्येवं परिदधाति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22, "avatarnika": ""}, {"id": 33000330, "chapter_id": 7896, "verse_number": "23", "content_sanskrit": "निक्षिपत्यात्मने चोपनिदधाति चतुष्टयम् । तिरोदधात्यपिदधात्यन्तर्धो पिदधाति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23, "avatarnika": ""}, {"id": 33000331, "chapter_id": 7896, "verse_number": "24", "content_sanskrit": "तिरस्करोति व्यस्यति च्छन्दत्यपवरत्यपि । आवृणोति व्यवदधात्यूर्णोत्यतिदधाति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24, "avatarnika": ""}, {"id": 33000332, "chapter_id": 7896, "verse_number": "25", "content_sanskrit": "संवृणोति स्तृणात्येतान्यात्मनेऽपि त्रयोदश । अपवारयति च्छादयति स्थगयतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25, "avatarnika": ""}, {"id": 33000333, "chapter_id": 7896, "verse_number": "26", "content_sanskrit": "कूलति त्वचतीत्येवं कुम्बयत्यपि कुम्बति । ह्रगति ह्लगतीत्येते थुडति स्थुडतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26, "avatarnika": ""}, {"id": 33000334, "chapter_id": 7896, "verse_number": "27", "content_sanskrit": "स्तृणोति तिरयत्येवं स्तृणुते गोपयत्यपि । अपोर्णुते त्वपार्णोति विवृतौ विवृणोति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27, "avatarnika": ""}, {"id": 33000335, "chapter_id": 7896, "verse_number": "28", "content_sanskrit": "तथैवाऽपवृणोति द्वावात्मने निरिणाति च । अपेक्षतेऽभ्यर्थयते भिक्षतेऽर्दति नाथति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28, "avatarnika": ""}, {"id": 33000336, "chapter_id": 7896, "verse_number": "29", "content_sanskrit": "याञ्चायां वनुते मार्गस्यमी चतति याचति । चदतीत्यात्मनेऽपि स्युर्वथते मार्गयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29, "avatarnika": ""}, {"id": 33000337, "chapter_id": 7896, "verse_number": "30", "content_sanskrit": "मार्गत्यप्यञ्चति गवेषयत्यन्वीक्षतेऽपि च । अन्वेषते च पयति चिनोतीत्यात्मनेऽप्यदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30, "avatarnika": ""}, {"id": 33000338, "chapter_id": 7896, "verse_number": "31", "content_sanskrit": "अन्वेषणे मृगयते मृग्यतीत्यपि केचन । प्रतिदत्ते विनयते निर्यातयति तत्समम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31, "avatarnika": ""}, {"id": 33000339, "chapter_id": 7896, "verse_number": "32", "content_sanskrit": "वित्तोत्सर्गे व्यययति व्ययति व्ययतेऽपि च । दोहानुकूल्ये दुग्धे गौः प्रस्नुते प्रस्नवे स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32, "avatarnika": ""}, {"id": 33000340, "chapter_id": 7896, "verse_number": "33", "content_sanskrit": "रिणक्ति दोग्ध्यात्मनेऽपि प्रपूरयति दोहने । क्षरणे स्तेपते श्चोतस्यपि क्षरति तेपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33, "avatarnika": ""}, {"id": 33000341, "chapter_id": 7896, "verse_number": "34", "content_sanskrit": "रीयते स्यन्दते चैव स्रवति स्नौति तु स्रवे। विष्णाति रेचयति च विप्रयुङ्क्ते च रेचति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34, "avatarnika": ""}, {"id": 33000342, "chapter_id": 7896, "verse_number": "35", "content_sanskrit": "विश्लेषणे स्युर्विश्लेषयति यौति वियौति च । मिश्रयत्यपि संयौति सम्पृक्ते सम्पृणक्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35, "avatarnika": ""}, {"id": 33000343, "chapter_id": 7896, "verse_number": "36", "content_sanskrit": "मिश्रणे संसृजति च श्रीणातीत्यात्मनेऽप्यदः । सङ्गतौ समियर्तीति सङ्गच्छति समृच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36, "avatarnika": ""}, {"id": 33000344, "chapter_id": 7896, "verse_number": "37", "content_sanskrit": "अकर्मकास्त्वात्मनेऽमी सम्बध्नाति मिलत्यपि । समवैति व्यतिसृजत्येवं सचत उच्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37, "avatarnika": ""}, {"id": 33000345, "chapter_id": 7896, "verse_number": "38", "content_sanskrit": "आतञ्चत्यातञ्चने चाऽलम्बयत्यासजत्यपि । आलम्बनेऽथ शैथिल्ये श्रन्थते चिल्लतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38, "avatarnika": ""}, {"id": 33000346, "chapter_id": 7896, "verse_number": "39", "content_sanskrit": "ओलण्डयत्युन्नयत उत्क्षिपत्यात्मनेऽप्यदः । उलण्डयति चोत्तभ्नात्युत्तभ्नोत्युत्तरत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39, "avatarnika": ""}, {"id": 33000347, "chapter_id": 7896, "verse_number": "40", "content_sanskrit": "उत्तम्भयति चोत्क्षिप्यत्युतक्षेपे दोलयत्यपि । आनीतावानयत्येतावात्मनेऽप्याहरत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40, "avatarnika": ""}, {"id": 33000348, "chapter_id": 7896, "verse_number": "41", "content_sanskrit": "सम्मार्जयति सम्मार्ष्टि तथा परिसमूहति । समूहते च सम्मार्ग उपदेग्ध्युपलिम्पति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41, "avatarnika": ""}, {"id": 33000349, "chapter_id": 7896, "verse_number": "42", "content_sanskrit": "पदद्वयं चात्मनेऽपि गोमयत्युपलेपने । सन्धुक्षयति सन्दीपयतीन्धे ज्वालयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42, "avatarnika": ""}, {"id": 33000350, "chapter_id": 7896, "verse_number": "43", "content_sanskrit": "सन्धुक्षणे ज्वलयति च्छर्दते च्छर्दयत्यपि । पाके श्रीणाति पचतीत्यात्मने श्रपयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43, "avatarnika": ""}, {"id": 33000351, "chapter_id": 7896, "verse_number": "44", "content_sanskrit": "रन्धयत्यपि विक्लेदयति साधयतीति च । श्राति श्रायति विक्लिद्यत्यपि राध्यति रध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44, "avatarnika": ""}, {"id": 33000352, "chapter_id": 7896, "verse_number": "45", "content_sanskrit": "पच्यते क्वथ्यते चैते पाके स्युः कर्मकर्तृके । ऋञ्जते भर्जते भ्राष्ट्रे तूपभृज्जति भृज्जते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45, "avatarnika": ""}, {"id": 33000353, "chapter_id": 7896, "verse_number": "46", "content_sanskrit": "शूलाकरोत्यात्मनेऽपि शूलपाके पदं मतम्‌ । द्रवीकृतौ लीनयति लयति द्रावयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46, "avatarnika": ""}, {"id": 33000354, "chapter_id": 7896, "verse_number": "47", "content_sanskrit": "लालयत्यपि लाययत्यपि लापयतीत्यमी । द्वौ सन्दधात्यभिषुणोत्यात्मने द्वौ च शुच्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47, "avatarnika": ""}, {"id": 33000355, "chapter_id": 7896, "verse_number": "48", "content_sanskrit": "आत्मने प्रतियत्ने तु स्यादुपस्कुरुते पदम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48, "avatarnika": ""}, {"id": 33000356, "chapter_id": 7896, "verse_number": "49", "content_sanskrit": "स्वादते स्वर्दते रुच्यां स्वदते रोचतेऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49, "avatarnika": ""}]