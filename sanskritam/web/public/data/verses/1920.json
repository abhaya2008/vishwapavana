[{"id": 2041465, "chapter_id": 1920, "verse_number": "५-१६५-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041466, "chapter_id": 1920, "verse_number": "५-१६५-१", "content_sanskrit": "प्रतिज्ञाते फाल्गुनेन वधे भीष्मस्य संयुगे।\nकिमकुर्वत मे मन्दाः पुत्रा दुर्योधनादयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041467, "chapter_id": 1920, "verse_number": "५-१६५-२", "content_sanskrit": "हतमेव हि पश्यामि गाङ्गेयं पितरं रणे।\nवासुदेवसहायेन पार्थेन दृढधन्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041468, "chapter_id": 1920, "verse_number": "५-१६५-३", "content_sanskrit": "स चापरिमितप्रज्ञस्तच्छ्रुत्वा पार्थभाषितम् ।\nकिमुक्तवान्महेष्वासो भीष्मः प्रहरतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041469, "chapter_id": 1920, "verse_number": "५-१६५-४", "content_sanskrit": "सैनापत्यं च संप्राप्य कौरवाणां धुरंधरः ।\nकिमचेष्टत गाङ्गेयो महाबुद्धिपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041470, "chapter_id": 1920, "verse_number": "५-१६५-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041471, "chapter_id": 1920, "verse_number": "५-१६५-५", "content_sanskrit": "ततस्तत्सञ्जयस्तस्मै सर्वमेव न्यवेदयत्।\nयथोक्तं कुरुवृद्धेन भीष्मेणामिततेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041472, "chapter_id": 1920, "verse_number": "५-१६५-६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041473, "chapter_id": 1920, "verse_number": "५-१६५-६", "content_sanskrit": "सैनापत्यमनुप्राप्य भीष्मः शान्तनवो नृप।\nदुर्योधनमुवाचेदं वचनं हर्षयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041474, "chapter_id": 1920, "verse_number": "५-१६५-७", "content_sanskrit": "नमस्कृत्य कुमाराय सेनान्ये शक्तिपाणये ।\nअहं सेनापतिस्तेऽद्य भविष्यामि न संशयः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041475, "chapter_id": 1920, "verse_number": "५-१६५-८", "content_sanskrit": "सेनाकर्मण्यिज्ञोऽस्मि व्यूहेषु विविधेषु च।\nकर्म कारयितुं चैव भृतानप्यभृतांस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041476, "chapter_id": 1920, "verse_number": "५-१६५-९", "content_sanskrit": "यात्रायाने च युद्धे च तथा प्रशमनेषु च ।\nभृशं वेद महाराज यथा वेद बृहस्पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041477, "chapter_id": 1920, "verse_number": "५-१६५-१०", "content_sanskrit": "व्यूहानां च समारम्भान्दैवगान्धर्वमानुषान्।\nतैरहं मोहयिष्यामि पाण्डवान्व्येतु ते ज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041478, "chapter_id": 1920, "verse_number": "५-१६५-११", "content_sanskrit": "सोऽहं योत्स्यामि तत्त्वेन पालयंस्तव वाहिनीम् ।\nयथावच्छास्त्रतो राजन्व्येतु ते मानसो ज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041479, "chapter_id": 1920, "verse_number": "५-१६५-१२x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041480, "chapter_id": 1920, "verse_number": "५-१६५-१२", "content_sanskrit": "विद्यते मे न गाङ्गेय भयं देवासुरेष्वपि ।\nसमस्तेषु महाबाहो सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041481, "chapter_id": 1920, "verse_number": "५-१६५-१३", "content_sanskrit": "किं पुनस्त्वयि दुर्धर्पे सैनापत्ये व्यवस्थिते।\nद्रोणे च पुरुषव्याघ्रे स्थिते युद्धाभिनन्दिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041482, "chapter_id": 1920, "verse_number": "५-१६५-१४", "content_sanskrit": "भवद्र्यां पुरुषाग्र्याभ्यां स्थिताभ्यां विजयो मम।\nन दुर्लभं कुरुश्रेष्ठ देवराज्यमपि ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041483, "chapter_id": 1920, "verse_number": "५-१६५-१५", "content_sanskrit": "रथसङ्ख्यां तु कार्त्स्न्येन परेषामात्मनस्तथा ।\nतथैवातिरथानां च वेत्तुमिच्छामि कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041484, "chapter_id": 1920, "verse_number": "५-१६५-१६", "content_sanskrit": "पितामहो हि कुशलः परेषामात्मनस्तथा ।\nश्रोतुमिच्छाम्यहं सर्वैः सहैभिर्वसुधाधिपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041485, "chapter_id": 1920, "verse_number": "५-१६५-१७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041486, "chapter_id": 1920, "verse_number": "५-१६५-१७", "content_sanskrit": "गान्धारे श्रृणु राजेन्द्र रथसंख्यां स्वके बले।\nये रथाः पृथिवीपाल तथैवातिरथाश्च ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041487, "chapter_id": 1920, "verse_number": "५-१६५-१८", "content_sanskrit": "बहूनीह सहस्राणि प्रयुतान्यर्बुदानि च।\nरथानां तव सेनायां यथामुख्यं तु मे श्रुणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2041488, "chapter_id": 1920, "verse_number": "५-१६५-१९", "content_sanskrit": "भवानग्रे रथोदारः सह सर्वैः सहोदरैः ।\nदुःशासनप्रभृतिभिर्भ्रातृभिः शतसंमितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2041489, "chapter_id": 1920, "verse_number": "५-१६५-२०", "content_sanskrit": "सर्वे कृतप्रहरणाश्छेदभेदविशारदाः ।\nरथोपस्थे गजस्कन्धे गदाप्रासासिचर्मणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2041490, "chapter_id": 1920, "verse_number": "५-१६५-२१", "content_sanskrit": "संयन्तारः प्रहर्तारः कृतास्त्रा भारसाधनाः ।\nइष्वस्त्रे द्रोणशिष्याश्च कृपस्य च शरद्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2041491, "chapter_id": 1920, "verse_number": "५-१६५-२२", "content_sanskrit": "एते हनिष्यन्ति रणे पाञ्चालान्युद्धदुर्मदान् ।\nकृतकिल्बिषाः पाण्डवेयैर्धार्तराष्ट्रा मनस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2041492, "chapter_id": 1920, "verse_number": "५-१६५-२३", "content_sanskrit": "तथाऽहं भरतश्रेष्ठ सर्वसेनापतिस्तव।\nशत्रून्विध्वंसयिष्यामि कदर्थीकृत्य पाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2041493, "chapter_id": 1920, "verse_number": "५-१६५-२४", "content_sanskrit": "न त्वात्मनो गुणान्वक्तुमर्हामि विदितोऽस्मि ते।\nकृतवर्मा त्वयिरथो भोजः शस्त्रभृतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2041494, "chapter_id": 1920, "verse_number": "५-१६५-२५", "content_sanskrit": "अर्थसिद्धिं तव रणे करिष्यति न संशयः।\nशस्त्रविद्भिरनाधृष्यो दूरपाती दृढायुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2041495, "chapter_id": 1920, "verse_number": "५-१६५-२६", "content_sanskrit": "हनिष्यति चमूं तेषां महेन्द्रो दानवानिव ।\nमद्रराजो महेष्वासः शल्यो मेऽतिरथो मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2041496, "chapter_id": 1920, "verse_number": "५-१६५-२७", "content_sanskrit": "स्पर्धते वासुदेवेन नित्यं यो वै रणेरणे।\nभागिनेयान्निजांस्त्यक्त्वा शल्यस्तेऽतिरथो मतः।\nएष योत्स्यति संग्रामे पाण्डवांश्च महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2041497, "chapter_id": 1920, "verse_number": "५-१६५-२८", "content_sanskrit": "सागरोर्मिसमैर्बाणैः प्लावयन्निव शातवान् ।\nभूरिश्रवाः कृतास्रश्च तव चापि हितः सुहृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2041498, "chapter_id": 1920, "verse_number": "५-१६५-२९", "content_sanskrit": "सौमदत्तिर्महेष्वासो रथयूथपयूथपः।\nवलक्षयममित्राणां सुमहान्तं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2041499, "chapter_id": 1920, "verse_number": "५-१६५-३०", "content_sanskrit": "सिन्धुराजो महाराज मतो मे द्विगुणो रथाः।\nयोत्स्यते समरे राजन्विक्रान्तो रथसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2041500, "chapter_id": 1920, "verse_number": "५-१६५-३१", "content_sanskrit": "द्रौपदीहरणे राजन्परिक्लिष्टश्च पाण्डवैः ।\nसंस्मरंस्तं परिक्लेशं योत्स्यते परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2041501, "chapter_id": 1920, "verse_number": "५-१६५-३२", "content_sanskrit": "एतेन हि तदा राजंस्तप आस्थाय दारुणम् ।\nसुदुर्लभो वरो लब्धः पाण्डवान्योद्ध्रुमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2041502, "chapter_id": 1920, "verse_number": "५-१६५-३३", "content_sanskrit": "स एष रथशार्दूलस्तद्वैरं संस्मरन्रणे।\nयोत्स्यते पाण्डवैस्तात प्राणांस्त्यक्त्वा सुदुस्त्यजान् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2041503, "chapter_id": 1920, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि रथातिरथसंख्यानपर्वणि पञ्चषष्ट्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]