[{"id": 7001885000, "chapter_id": 21885, "verse_number": "६४-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nएवं विमुक्तरोगा तु कन्यका तं मुदान्विता ।\nस्वरोचिषमुवाचेदं शृणुष्व वचनं प्रभो ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001885001, "chapter_id": 21885, "verse_number": "६४-२", "content_sanskrit": "मन्दारविद्याधरजा नाम्ना ख्याता विभावरी ।\nउपकारिन्! स्वमात्मानं प्रयच्छामि प्रतीच्छ माम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001885002, "chapter_id": 21885, "verse_number": "६४-३", "content_sanskrit": "विद्याञ्च तुभ्यं दास्यामि सर्वबूतरुतानि ते ।\nययाभिव्यक्तिमेष्यन्ति प्रसादपुरगो भव ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001885003, "chapter_id": 21885, "verse_number": "६४-४", "content_sanskrit": "मार्कण्डेय उवाच ।\nएवमस्त्विति तेनोक्ते धर्मज्ञेन स्वरोचिषा ।\nद्वितीया तु तदा कन्या इदं वचनमब्रवीत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001885004, "chapter_id": 21885, "verse_number": "६४-५", "content_sanskrit": "कुमारब्रह्मचार्यासीत् पारो नाम पिता मम ।\nब्रह्मर्षिः सुमहाभागो वेदवेदाङ्गपारगः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001885005, "chapter_id": 21885, "verse_number": "६४-६", "content_sanskrit": "तस्य पुंस्कोकिलालापरमणीये मधौ पुरा ।\nआजगामाप्सराभ्यासं प्रख्याता पुञ्जिकास्तना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001885006, "chapter_id": 21885, "verse_number": "६४-७", "content_sanskrit": "कामवक्तव्यतां नीतः स तदा मुनिपुङ्गवः ।\nतत्संयोगेऽहमुत्पन्ना तस्यामत्र महाचले ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001885007, "chapter_id": 21885, "verse_number": "६४-८", "content_sanskrit": "विहाय मां गता सा च मातास्मिन्निर्जने वने ।\nबालामेकां महीपृष्ठे व्यालश्वापदसंकुले ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001885008, "chapter_id": 21885, "verse_number": "६४-९", "content_sanskrit": "ततः कलाभिः सोमस्य वर्धन्तीभिरहः क्षये ।\nआप्याय्यमानाहरहो वृद्धिं यातास्मि सत्तम ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001885009, "chapter_id": 21885, "verse_number": "६४-१०", "content_sanskrit": "ततः कलावतीत्येतन्मम नाम महात्मना ।\nगृहीतायः कृतं पित्रा गन्धर्वेण शुभानना ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001885010, "chapter_id": 21885, "verse_number": "६४-११", "content_sanskrit": "न दत्ताहं तदा तेन याचितेन महात्मना ।\nदेवारिणालिना सुप्तस्ततो मे घातितः पिता ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001885011, "chapter_id": 21885, "verse_number": "६४-१२", "content_sanskrit": "ततोऽहमतिनिर्वेदादात्मव्यापादनोद्यता ।\nनिवारिता शम्भुपत्न्या सत्या सत्यप्रतिश्रवा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001885012, "chapter_id": 21885, "verse_number": "६४-१३", "content_sanskrit": "मा शुचः सुभ्रु! भर्ता ते महाभागो भविष्यति ।\nस्वरोचिर्नाम पुत्रश्च मनुस्तस्य भविष्यति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001885013, "chapter_id": 21885, "verse_number": "६४-१४", "content_sanskrit": "आज्ञाञ्च निधयः सर्वे करिष्यन्ति तवादृताः ।\nयथाभिलषितं वित्तं प्रदास्यन्ति च ते शुभे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001885014, "chapter_id": 21885, "verse_number": "६४-१५", "content_sanskrit": "यस्या वत्से प्रभावेण विद्यायास्तां गृहाण मे ।\nपद्मिनी नाम विद्येयं महापद्माभिपूजिता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001885015, "chapter_id": 21885, "verse_number": "६४-१६", "content_sanskrit": "इत्याह मां दक्षसुता सती सत्यपरायणा ।\nस्वरोचिस्त्वं ध्रुवं देवी नान्यथा सा वदिष्यति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001885016, "chapter_id": 21885, "verse_number": "६४-१७", "content_sanskrit": "साहं प्राणप्रदायाद्य तां विद्यां स्वं तथा वपुः ।\nप्रयच्छामि प्रतीच्छ त्वं प्रसादसुमुखो मम ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001885017, "chapter_id": 21885, "verse_number": "६४-१८", "content_sanskrit": "मार्कण्डेय उवाच ।\nएवमस्त्विति तामाह स तु कन्यां कलावतीम् ।\nविभावर्याः कलावत्याः स्निग्धदृष्ट्यानुमोदितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001885018, "chapter_id": 21885, "verse_number": "६४-१९", "content_sanskrit": "जग्राह च ततः पाणी स तयोरमरद्युतिः ।\nनदत्सु देवतूर्येषु नृत्यन्तीष्वप्सरः सु च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]