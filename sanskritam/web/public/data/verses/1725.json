[{"id": 2033639, "chapter_id": 1725, "verse_number": "४-४८-०x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033640, "chapter_id": 1725, "verse_number": "४-४८-१", "content_sanskrit": "सर्वानायुष्मतो भीतान्संत्रस्तानिव लक्षये।\nअयुद्धमनसश्चैव सर्वांश्चैवानवस्थितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033641, "chapter_id": 1725, "verse_number": "४-४८-२", "content_sanskrit": "यद्येष जामदग्न्यो वा यदि वेन्द्रः पुरंदरः ।\nवासुदेवेन सहितो यदि बीभत्सुरागतः।\nअहमेनं निरोत्स्यामि वेलेव वरुणालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033642, "chapter_id": 1725, "verse_number": "४-४८-३", "content_sanskrit": "रुक्मपुङ्खाः प्रसन्नाग्रा मुक्ता हस्तवता मया।\nछादयन्तु शारः सूर्यं पार्थस्यायुर्निरोधकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033643, "chapter_id": 1725, "verse_number": "४-४८-४", "content_sanskrit": "मम चापप्रमुक्तानां शराणां नतपर्वणाम् ।\nनिवृत्तिर्गच्छतां नास्ति सर्पाणां श्वसतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033644, "chapter_id": 1725, "verse_number": "४-४८-५", "content_sanskrit": "शराणां पुङ्खसक्तानां मौर्व्याऽभिहतयोर्भृशम् ।\nश्रूयते तलयोः शब्दो भेर्योराहतयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033645, "chapter_id": 1725, "verse_number": "४-४८-६", "content_sanskrit": "एकैकं चतुरः पञ्च क्वचित्पष्टिं क्वचिच्छतम्।\nहतान्पश्यत मात्स्यानामिषुभिर्निहतान्रथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033646, "chapter_id": 1725, "verse_number": "४-४८-७", "content_sanskrit": "मद्बाहुमुक्तैरिषुभिस्तैलधौतैः पतत्रिभिः ।\nखद्योतैरिव संपृक्तमन्तरिक्षं विराजताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033647, "chapter_id": 1725, "verse_number": "४-४८-८", "content_sanskrit": "ध्वजाग्राद्वानरस्तस्य भल्लेनाभिहतो मया।\nअद्यैव पततां भूमौ विनदन्भैरवान्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033648, "chapter_id": 1725, "verse_number": "४-४८-९", "content_sanskrit": "शत्रोर्मयाभिपन्नानां भूतानां ध्वजवासिनाम् ।\nदिशः प्रतिष्ठमानानामस्तु शब्दो दिवं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033649, "chapter_id": 1725, "verse_number": "४-४८-१०", "content_sanskrit": "क्रुद्धेनास्त्रं मया मुक्तं निर्दहेत्पृथिवीमिमाम् ।\nस्थितं संग्रामशिरसि पार्थमेकाकिनं किमु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033650, "chapter_id": 1725, "verse_number": "४-४८-११", "content_sanskrit": "समाहितश्च बीभत्सुर्वर्षाण्यष्टौ च पञ्च च ।\nजातस्नेहश्च युद्धस्य मयि संदर्शयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033651, "chapter_id": 1725, "verse_number": "४-४८-१२", "content_sanskrit": "पात्रीभूतस्तु कौन्तेयो ब्राह्मणो गुणवानिव ।\nशरमालां स गृह्णातु मत्प्रसृष्टां स्वधामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033652, "chapter_id": 1725, "verse_number": "४-४८-१३", "content_sanskrit": "एष चापि महेष्वासस्त्रिषु लोकेषु विश्रुतः ।\nअहं चापि नरश्रेष्ठादर्जुनान्नावमः क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033653, "chapter_id": 1725, "verse_number": "४-४८-१४", "content_sanskrit": "मम हस्तप्रमुक्तानां शराणां नतपर्वणाम्।\nनिवृत्तिर्गच्छतां नास्ति वैश्वानरशिखार्चिषाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033654, "chapter_id": 1725, "verse_number": "४-४८-१५", "content_sanskrit": "इतश्चेतश्च मुक्तानां शराणां नतपर्वणाम् ।\nतुगुलः श्रूयतां नादः षट्पदां गायतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033655, "chapter_id": 1725, "verse_number": "४-४८-१६", "content_sanskrit": "अन्तरा संपतद्भिस्तु गृध्रपत्रैः शिलाशितैः ।\nशलभानामिवाकाशे छाया संप्रति दृश्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033656, "chapter_id": 1725, "verse_number": "४-४८-१७", "content_sanskrit": "अद्य मत्कार्मुकोत्सृष्टाः शिताः पार्थस्य मर्मगाः।\nशरीरमुपसर्पन्तु वल्मीकमिव पन्नगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033657, "chapter_id": 1725, "verse_number": "४-४८-१८", "content_sanskrit": "बर्हिबर्हिणराजानां बर्हिणां बर्हिणामिव ।\nपततां पततां घोषः पततां पततामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033658, "chapter_id": 1725, "verse_number": "४-४८-१९", "content_sanskrit": "अद्य त्वहमृणान्मोक्ष्ये यन्मया तत्प्रतिश्रुतम् ।\nधार्तराष्ट्रस्य तत्काले निहत्य समरेऽर्जुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033659, "chapter_id": 1725, "verse_number": "४-४८-२०", "content_sanskrit": "इन्द्राशनिसमस्पर्शं महेन्द्रसमविक्रमम्।\nअर्दयिष्याम्यहं पार्थमुल्काभिरिव कुञ्जरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033660, "chapter_id": 1725, "verse_number": "४-४८-२१", "content_sanskrit": "शरजालमहाज्वालमसिशक्तिगदेन्धनम् ।\nनिर्दहन्तमनीकानि शमयिष्येऽर्जुनानलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033661, "chapter_id": 1725, "verse_number": "४-४८-२२", "content_sanskrit": "रथादतिरथं लोके सर्वशस्त्रभृतांवरम् ।\nविवशं पार्थमादास्ये गरुत्मानिव पन्नगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033662, "chapter_id": 1725, "verse_number": "४-४८-२३", "content_sanskrit": "क्षुद्रकैर्विविधैर्भल्लैर्निपतद्भिश्च मामकैः ।\nसंमूढचेताः कौन्तेयः कर्तव्यं नाभिपद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033663, "chapter_id": 1725, "verse_number": "४-४८-२४", "content_sanskrit": "अद्य दुर्योधनस्याहं शोकं हृदि चिरं स्थितम् ।\nसमूलमपनेष्यामि हरन्पार्थशिरः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2033664, "chapter_id": 1725, "verse_number": "४-४८-२५", "content_sanskrit": "अद्य मत्कार्मुकोत्सृष्टैर्भल्लैश्च नतपर्वभिः।\nहताश्वं विरथं पार्थं पौरुषे पर्यवस्थितम् ।\nनिश्वसन्तं यथा नागमद्य पश्यन्तु कौरवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2033665, "chapter_id": 1725, "verse_number": "४-४८-२६", "content_sanskrit": "जामदग्न्यान्मया लब्धं दिव्यास्रमृषिसत्तमात्।\nतदुपाश्रित्य वीर्यं च युध्येयमपि वासवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2033666, "chapter_id": 1725, "verse_number": "४-४८-२७", "content_sanskrit": "ध्वजाग्रे वानरस्तिष्ठन्भल्लेन निहतो मया।\nअद्यैव पततां भूमौ विनदन्भैरवान्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2033667, "chapter_id": 1725, "verse_number": "४-४८-२८", "content_sanskrit": "कामं गच्छन्तु कुरवो गाः प्रगृह्य परंतपाः ।\nरथेषु वाऽपि तिष्ठन्तो युद्धं पश्यन्तु मामकम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2033668, "chapter_id": 1725, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्माहाभारते विराटपर्वणि गोग्रहणपर्वणि अष्टचत्वारिंशोऽध्यायः ॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]