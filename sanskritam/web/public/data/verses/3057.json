[{"id": 2096215, "chapter_id": 3057, "verse_number": "१३-१८७-१", "content_sanskrit": "युधिष्ठिर उवाच।\nसाम्नि चापि प्रदानेन च ज्यायः किं भवतो मतम्।\nप्रब्रूहि भरतश्रेष्ठ यदत्र व्यतिरिच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096216, "chapter_id": 3057, "verse_number": "१३-१८७-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096217, "chapter_id": 3057, "verse_number": "१३-१८७-२", "content_sanskrit": "साम्ना प्रसाद्यते कश्चिद्दानेन च तथाऽपरः।\nपौरुषीं प्रकृतिं ज्ञात्वा तयोरेकतरं भजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096218, "chapter_id": 3057, "verse_number": "१३-१८७-३", "content_sanskrit": "गुणांस्तु शृणु वैराजन्त्सान्त्वस्य पुरुषर्षभ।\nदारुणान्यपि भूतानि सान्त्वेनाराधयेद्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096219, "chapter_id": 3057, "verse_number": "१३-१८७-४", "content_sanskrit": "अत्राप्युदाहरन्तीममिदिहासं पुरातनम्।\nगृहीत्वा रक्षसा मुक्तो द्विजातिः कानने यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096220, "chapter_id": 3057, "verse_number": "१३-१८७-५", "content_sanskrit": "कश्चित्तु बुद्धिसम्पन्नो ब्राह्मणो विजने वने।\nगृहीतः कृच्छ्रमापन्नो रक्षसा भक्षयिष्यता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096221, "chapter_id": 3057, "verse_number": "१३-१८७-६", "content_sanskrit": "सुबुद्धिः श्रुतिसम्पन्नो दृष्ट्वा तमतिभीषणम्।\nसामैवास्मै प्रयुञ्जानो न मुमोह न विव्यधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096222, "chapter_id": 3057, "verse_number": "१३-१८७-७", "content_sanskrit": "रक्षस्तु वाचा सम्पूज्य प्रश्नं पप्रच्छ तं द्विजम्।\nमोक्ष्यसे ब्रूहि मे प्रश्नं केनास्मि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096223, "chapter_id": 3057, "verse_number": "१३-१८७-८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096224, "chapter_id": 3057, "verse_number": "१३-१८७-८", "content_sanskrit": "मुहूर्तमथ सञ्चिन्त्य ब्राह्मणिस्तं निरीक्ष्य सः।\nअभीतवदथाव्यग्रः प्रश्नं प्रतिजगाद ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096225, "chapter_id": 3057, "verse_number": "१३-१८७-९", "content_sanskrit": "विदेशस्थो विलोकस्थो विना नूनं सुहृज्जनैः।\nविषयानतुलान्भुङ्क्षे तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096226, "chapter_id": 3057, "verse_number": "१३-१८७-१०", "content_sanskrit": "नूनं मित्राणि ते रक्षः साधूपचरितान्यपि।\nस्वदोषात्तु परित्यज्य तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096227, "chapter_id": 3057, "verse_number": "१३-१८७-११", "content_sanskrit": "अवृत्त्या पीड्यमानोऽपि वृत्त्युपायान्विगर्हयन्।\nमहार्थान्ध्यायसे नूनं तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096228, "chapter_id": 3057, "verse_number": "१३-१८७-१२", "content_sanskrit": "परकार्याधिकारस्थाः सद्गुणैरधमा नराः।\nअवजानन्ति नूनं त्वां तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096229, "chapter_id": 3057, "verse_number": "१३-१८७-१३", "content_sanskrit": "गुणवान्निर्गुणानन्यान्नूनं पश्यसि तत्कृतान्।\nप्राज्ञैरपि विनीतात्मा तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096230, "chapter_id": 3057, "verse_number": "१३-१८७-१४", "content_sanskrit": "सम्पीड्यात्मानमार्यत्वात्त्वया कश्चिदुपस्कृतः।\nजितं त्वां मन्यते साधो तेनासि हरिमः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096231, "chapter_id": 3057, "verse_number": "१३-१८७-१५", "content_sanskrit": "क्लिश्यमानान्विमार्गेषु कामक्रोधावृतात्मनः।\nमन्येऽनुध्यायसि जनांस्तेनासि हरिमः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096232, "chapter_id": 3057, "verse_number": "१३-१८७-१६", "content_sanskrit": "प्राज्ञैरपुजितो नूनं प्राज्ञैरप्यभिनिन्दितः।\nह्रीमानमर्षी दुर्वृत्तस्तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096233, "chapter_id": 3057, "verse_number": "१३-१८७-१७", "content_sanskrit": "नूनं मित्रमुखः शत्रुः कश्चिदार्यवदाचरन्।\nवञ्चयित्वा गतस्त्वां वै तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096234, "chapter_id": 3057, "verse_number": "१३-१८७-१८", "content_sanskrit": "नूनमद्य सतां मध्ये तव वाक्यमनुत्तमम्।\nन भाति कालेऽभिहितं तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096235, "chapter_id": 3057, "verse_number": "१३-१८७-१९", "content_sanskrit": "दृष्टपूर्वाञ्श्रुतपूर्वान्कुपितान्हृदयप्रियान्।\nअनुनेतुं न शक्रोषि तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096236, "chapter_id": 3057, "verse_number": "१३-१८७-२०", "content_sanskrit": "नूनमासञ्जयित्वा त्वा कृत्ये कस्मिंश्चिदीप्सिते।\nकच्चिदर्थयते नित्यं तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096237, "chapter_id": 3057, "verse_number": "१३-१८७-२१", "content_sanskrit": "परोक्षवादिभिर्मिथ्यादोषस्ते सम्प्रदर्शितः।\nतज्ज्ञैर्न पूज्यसे व्यक्तं तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096238, "chapter_id": 3057, "verse_number": "१३-१८७-२२", "content_sanskrit": "नूनं त्वां सद्गुणापेक्षं पूजयानं सुहृत्प्रजाः।\nमायावीति च जानन्ति तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2096239, "chapter_id": 3057, "verse_number": "१३-१८७-२३", "content_sanskrit": "अन्तर्गतमभिप्रायंन न नूनं लज्जयेच्छसि।\nविवक्तुं प्राप्य शैथिल्यात्तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2096240, "chapter_id": 3057, "verse_number": "१३-१८७-२४", "content_sanskrit": "नानाबुद्धिरुचीँल्लोके मानुषान्नूनमिच्छसि।\nग्रहीतुं स्वैर्गुणैः सर्वांस्तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2096241, "chapter_id": 3057, "verse_number": "१३-१८७-२५", "content_sanskrit": "असत्सु विनिविष्टेषु न गुणान्वदतः स्वयम्।\nगुणास्ते न विराजन्ते तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2096242, "chapter_id": 3057, "verse_number": "१३-१८७-२६", "content_sanskrit": "धर्मवृत्तः श्रुतैर्हीनः पदं त्वं रजसान्वितः।\nमहत्प्रार्थयसे नूनं तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2096243, "chapter_id": 3057, "verse_number": "१३-१८७-२७", "content_sanskrit": "तपःप्रणिहितात्मानं मन्ये त्वारण्यकाङ्क्षिणम्।\nबन्धुवर्गो निगृह्णाति तेनासि हरिमः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2096244, "chapter_id": 3057, "verse_number": "१३-१८७-२८", "content_sanskrit": "इष्टभार्यस्य ते नूनं प्रातिवेश्यो महाधनः।\nयुवा सुललितः कामी तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2096245, "chapter_id": 3057, "verse_number": "१३-१८७-२९", "content_sanskrit": "दुर्विनीतहतः पुत्रो जामाता वाऽप्रमार्जकः।\nदारा वा प्रतिकूलास्ते तेनासि हरिमः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2096246, "chapter_id": 3057, "verse_number": "१३-१८७-३०", "content_sanskrit": "भ्रातरोऽतीव विषमाः पिता वा क्षुत्क्षतो मृतः।\nमाता ज्योष्ठो गुरुर्वाऽपि तेनासि हरिमः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2096247, "chapter_id": 3057, "verse_number": "१३-१८७-३१", "content_sanskrit": "ब्राह्मणो वा हतो गौर्वा ब्रह्मस्वं वापहृतं पुरा।\nदेवस्यं वा हृतं काले तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2096248, "chapter_id": 3057, "verse_number": "१३-१८७-३२", "content_sanskrit": "हृतदारोऽथ वृद्धो वा लोके द्विष्टोऽथवा नरैः।\nअविज्ञानेन वा वृद्धस्तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2096249, "chapter_id": 3057, "verse_number": "१३-१८७-३३", "content_sanskrit": "वार्धकार्थं धनं दृष्ट्वा स्वा श्रीर्वाऽपि परैर्हृता।\nवृत्तिर्वा दुर्जनापेक्षा तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2096250, "chapter_id": 3057, "verse_number": "१३-१८७-३४", "content_sanskrit": "सम्पत्कालेन ते धर्मः क्षीणस्तात सुहृद्बुवैः।\nअसंन्यासमतिस्तत्र तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2096251, "chapter_id": 3057, "verse_number": "१३-१८७-३५", "content_sanskrit": "अविद्वान्भीरुरल्पार्थे विद्याविक्रमदानजम्।\nयशः प्रार्थयसे नित्यं तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2096252, "chapter_id": 3057, "verse_number": "१३-१८७-३६", "content_sanskrit": "चिरहाभिलषितं किञ्चित्फलमप्राप्तमेव ते।\nकृतमन्यैरपहृतं तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2096253, "chapter_id": 3057, "verse_number": "१३-१८७-३७", "content_sanskrit": "नूनमात्मगतं दोषमपश्यन्किंचिदात्मनि।\nअकारणेऽभिशस्तो हि तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2096254, "chapter_id": 3057, "verse_number": "१३-१८७-३८", "content_sanskrit": "सुहृदां दुःखमार्तानां न प्रमोक्ष्यसि हानिजम्।\nअलमर्थगुणैर्हीनं तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2096255, "chapter_id": 3057, "verse_number": "१३-१८७-३९", "content_sanskrit": "साधून्गृहस्थान्दृष्ट्वा च तथा साधून्वनेचरान्।\nमुक्तांश्चावसथे सक्तांस्तेनासि हरिमः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2096256, "chapter_id": 3057, "verse_number": "१३-१८७-४०", "content_sanskrit": "धर्म्यमर्थ्यं च काम्यं च देशे च रहितं वचः।\nन प्रसिद्ध्यति ते नूनं तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2096257, "chapter_id": 3057, "verse_number": "१३-१८७-४१", "content_sanskrit": "दत्तानकुशलैरर्थान्मनीषी संजिजीविषुः।\nप्राप्य वर्तयसे नूनं तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2096258, "chapter_id": 3057, "verse_number": "१३-१८७-४२", "content_sanskrit": "परस्परविरुद्धानां प्रियं नूनं चिकीर्षसि।\nसुहृदामुपरोधेन तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2096259, "chapter_id": 3057, "verse_number": "१३-१८७-४३", "content_sanskrit": "पापान्विवर्धितान्दृष्ट्वा कल्याणांश्चावसीदतः।\nध्रुवं गर्हयसे नूनं तेनासि हरिणः कृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2096260, "chapter_id": 3057, "verse_number": "१३-१८७-४४", "content_sanskrit": "एवं सम्पूजितं रक्षो विप्रं तं प्रत्यपूजयत्।\nसहायमकरोच्चैनं सम्पूज्यामुं मुमोच ह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2096261, "chapter_id": 3057, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्ताशीत्यधिकशततमोऽध्यायः॥ १८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]