[{"id": 5000096000, "chapter_id": 9096, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे एकोनविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000096001, "chapter_id": 9096, "verse_number": "२-१९-१", "content_sanskrit": "तदप्रियममित्रघ्नो वचनं मरणोपमम्।\nश्रुत्वा न विव्यथे रामः कैकेयीं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000096002, "chapter_id": 9096, "verse_number": "२-१९-२", "content_sanskrit": "एवमस्तु गमिष्यामि वनं वस्तुमहं त्वितः।\nजटाचीरधरो राज्ञः प्रतिज्ञामनुपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000096003, "chapter_id": 9096, "verse_number": "२-१९-३", "content_sanskrit": "इदं तु ज्ञातुमिच्छामि किमर्थं मां महीपतिः।\nनाभिनन्दति दुर्धर्षो यथापूर्वमरिंदमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000096004, "chapter_id": 9096, "verse_number": "२-१९-४", "content_sanskrit": "मन्युर्न च त्वया कार्यो देवि ब्रूमि तवाग्रतः।\nयास्यामि भव सुप्रीता वनं चीरजटाधरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000096005, "chapter_id": 9096, "verse_number": "२-१९-५", "content_sanskrit": "हितेन गुरुणा पित्रा कृतज्ञेन नृपेण च।\nनियुज्यमानो विस्रब्धः किं न कुर्यामहं प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000096006, "chapter_id": 9096, "verse_number": "२-१९-६", "content_sanskrit": "अलीकं मानसं त्वेकं हृदयं दहते मम।\nस्वयं यन्नाह मां राजा भरतस्याभिषेचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000096007, "chapter_id": 9096, "verse_number": "२-१९-७", "content_sanskrit": "अहं हि सीतां राज्यं च प्राणानिष्टान् धनानि च।\nहृष्टो भ्रात्रे स्वयं दद्यां भरतायाप्रचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000096008, "chapter_id": 9096, "verse_number": "२-१९-८", "content_sanskrit": "किं पुनर्मनुजेन्द्रेण स्वयं पित्रा प्रचोदितः।\nतव च प्रियकामार्थं प्रतिज्ञामनुपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000096009, "chapter_id": 9096, "verse_number": "२-१९-९", "content_sanskrit": "तथाश्वासय ह्रीमन्तं किं त्विदं यन्महीपतिः।\nवसुधासक्तनयनो मन्दमश्रूणि मुञ्चति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000096010, "chapter_id": 9096, "verse_number": "२-१९-१०", "content_sanskrit": "गच्छन्तु चैवानयितुं दूताः शीघ्रजवैर्हयैः।\nभरतं मातुलकुलादद्यैव नृपशासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000096011, "chapter_id": 9096, "verse_number": "२-१९-११", "content_sanskrit": "दण्डकारण्यमेषोऽहं गच्छाम्येव हि सत्वरः।\nअविचार्य पितुर्वाक्यं समा वस्तुं चतुर्दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000096012, "chapter_id": 9096, "verse_number": "२-१९-१२", "content_sanskrit": "सा हृष्टा तस्य तद् वाक्यं श्रुत्वा रामस्य कैकयी।\nप्रस्थानं श्रद्दधाना सा त्वरयामास राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000096013, "chapter_id": 9096, "verse_number": "२-१९-१३", "content_sanskrit": "एवं भवतु यास्यन्ति दूताः शीघ्रजवैर्हयैः।\nभरतं मातुलकुलादिहावर्तयितुं नराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000096014, "chapter_id": 9096, "verse_number": "२-१९-१४", "content_sanskrit": "तव त्वहं क्षमं मन्ये नोत्सुकस्य विलम्बनम्।\nराम तस्मादितः शीघ्रं वनं त्वं गन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000096015, "chapter_id": 9096, "verse_number": "२-१९-१५", "content_sanskrit": "व्रीडान्वितः स्वयं यच्च नृपस्त्वां नाभिभाषते।\nनैतत् किंचिन्नरश्रेष्ठ मन्युरेषोऽपनीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000096016, "chapter_id": 9096, "verse_number": "२-१९-१६", "content_sanskrit": "यावत्त्वं न वनं यातः पुरादस्मादतित्वरम्।\nपिता तावन्न ते राम स्नास्यते भोक्ष्यतेऽपि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000096017, "chapter_id": 9096, "verse_number": "२-१९-१७", "content_sanskrit": "धिक्कष्टमिति निःश्वस्य राजा शोकपरिप्लुतः।\nमूर्च्छितो न्यपतत् तस्मिन् पर्यङ्के हेमभूषिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000096018, "chapter_id": 9096, "verse_number": "२-१९-१८", "content_sanskrit": "रामोऽप्युत्थाप्य राजानं कैकेय्याभिप्रचोदितः।\nकशयेव हतो वाजी वनं गन्तुं कृतत्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000096019, "chapter_id": 9096, "verse_number": "२-१९-१९", "content_sanskrit": "तदप्रियमनार्याया वचनं दारुणोदयम्।\nश्रुत्वा गतव्यथो रामः कैकेयीं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000096020, "chapter_id": 9096, "verse_number": "२-१९-२०", "content_sanskrit": "नाहमर्थपरो देवि लोकमावस्तुमुत्सहे।\nविद्धि मामृषिभिस्तुल्यं विमलं धर्ममास्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000096021, "chapter_id": 9096, "verse_number": "२-१९-२१", "content_sanskrit": "यत् तत्रभवतः किंचिच्छक्यं कर्तुं प्रियं मया।\nप्राणानपि परित्यज्य सर्वथा कृतमेव तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000096022, "chapter_id": 9096, "verse_number": "२-१९-२२", "content_sanskrit": "न ह्यतो धर्मचरणं किंचिदस्ति महत्तरम्।\nयथा पितरि शुश्रूषा तस्य वा वचनक्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000096023, "chapter_id": 9096, "verse_number": "२-१९-२३", "content_sanskrit": "अनुक्तोऽप्यत्रभवता भवत्या वचनादहम्।\nवने वत्स्यामि विजने वर्षाणीह चतुर्दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000096024, "chapter_id": 9096, "verse_number": "२-१९-२४", "content_sanskrit": "न नूनं मयि कैकेयि किंचिदाशंससे गुणान्।\nयद् राजानमवोचस्त्वं ममेश्वरतरा सती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000096025, "chapter_id": 9096, "verse_number": "२-१९-२५", "content_sanskrit": "यावन्मातरमापृच्छे सीतां चानुनयाम्यहम्।\nततोऽद्यैव गमिष्यामि दण्डकानां महद् वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000096026, "chapter_id": 9096, "verse_number": "२-१९-२६", "content_sanskrit": "भरतः पालयेद् राज्यं शुश्रूषेच्च पितुर्यथा।\nतथा भवत्या कर्तव्यं स हि धर्मः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000096027, "chapter_id": 9096, "verse_number": "२-१९-२७", "content_sanskrit": "रामस्य तु वचः श्रुत्वा भृशं दुःखगतः पिता।\nशोकादशक्नुवन् वक्तुं प्ररुरोद महास्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000096028, "chapter_id": 9096, "verse_number": "२-१९-२८", "content_sanskrit": "वन्दित्वा चरणौ राज्ञो विसंज्ञस्य पितुस्तदा।\nकैकेय्याश्चाप्यनार्याया निष्पपात महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000096029, "chapter_id": 9096, "verse_number": "२-१९-२९", "content_sanskrit": "स रामः पितरं कृत्वा कैकेयीं च प्रदक्षिणम्।\nनिष्क्रम्यान्तःपुरात् तस्मात् स्वं ददर्श सुहृज्जनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000096030, "chapter_id": 9096, "verse_number": "२-१९-३०", "content_sanskrit": "तं बाष्पपरिपूर्णाक्षः पृष्ठतोऽनुजगाम ह।\nलक्ष्मणः परमक्रुद्धः सुमित्रानन्दवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000096031, "chapter_id": 9096, "verse_number": "२-१९-३१", "content_sanskrit": "आभिषेचनिकं भाण्डं कृत्वा रामः प्रदक्षिणम्।\nशनैर्जगाम सापेक्षो दृष्टिं तत्राविचालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000096032, "chapter_id": 9096, "verse_number": "२-१९-३२", "content_sanskrit": "न चास्य महतीं लक्ष्मीं राज्यनाशोऽपकर्षति।\nलोककान्तस्य कान्तत्वाच्छीतरश्मेरिव क्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000096033, "chapter_id": 9096, "verse_number": "२-१९-३३", "content_sanskrit": "न वनं गन्तुकामस्य त्यजतश्च वसुंधराम्।\nसर्वलोकातिगस्येव लक्ष्यते चित्तविक्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000096034, "chapter_id": 9096, "verse_number": "२-१९-३४", "content_sanskrit": "प्रतिषिध्य शुभं छत्रं व्यजने च स्वलंकृते।\nविसर्जयित्वा स्वजनं रथं पौरांस्तथा जनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000096035, "chapter_id": 9096, "verse_number": "२-१९-३५", "content_sanskrit": "धारयन् मनसा दुःखमिन्द्रियाणि निगृह्य च।\nप्रविवेशात्मवान् वेश्म मातुरप्रियशंसिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000096036, "chapter_id": 9096, "verse_number": "२-१९-३६", "content_sanskrit": "सर्वोऽप्यभिजनः श्रीमान् श्रीमतः सत्यवादिनः।\nनालक्षयत रामस्य कंचिदाकारमानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000096037, "chapter_id": 9096, "verse_number": "२-१९-३७", "content_sanskrit": "उचितं च महाबाहुर्न जहौ हर्षमात्मवान्।\nशारदः समुदीर्णांशुश्चन्द्रस्तेज इवात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000096038, "chapter_id": 9096, "verse_number": "२-१९-३८", "content_sanskrit": "वाचा मधुरया रामः सर्वं सम्मानयञ्जनम्।\nमातुः समीपं धर्मात्मा प्रविवेश महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000096039, "chapter_id": 9096, "verse_number": "२-१९-३९", "content_sanskrit": "तं गुणैः समतां प्राप्तो भ्राता विपुलविक्रमः।\nसौमित्रिरनुवव्राज धारयन् दुःखमात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000096040, "chapter_id": 9096, "verse_number": "२-१९-४०", "content_sanskrit": "प्रविश्य वेश्मातिभृशं मुदा युतं\nसमीक्ष्य तां चार्थविपत्तिमागताम्।\nन चैव रामोऽत्र जगाम विक्रियां\nसुहृज्जनस्यात्मविपत्तिशङ्कया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000096041, "chapter_id": 9096, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे एकोनविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]