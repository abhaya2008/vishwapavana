[{"id": 2115448, "chapter_id": 3485, "verse_number": "", "content_sanskrit": "कुन्त्या बकं प्रति स्वैकतमपुत्रप्रेषणाभिप्रायकथनं ब्राह्मणेन\nतस्य निराकरणं । कुन्त्या भीमप्रतापकथनेन ब्राह्मणस्य समाश्वासनं च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115449, "chapter_id": 3485, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115450, "chapter_id": 3485, "verse_number": "१", "content_sanskrit": "न विषादस्त्वया कार्यो भयादस्मात् कथञ्चन ।\nउपायः परिदृष्टोऽत्र तस्मान्मोक्षाय राक्षसात् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115451, "chapter_id": 3485, "verse_number": "२", "content_sanskrit": "नैव स्वयं सपुत्रस्य गमनं तत्र रोचये ।\nएकस्तव सुतो बालः कन्या चैका तपस्विनी \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115452, "chapter_id": 3485, "verse_number": "३", "content_sanskrit": "न चैतयोस्तथा पत्न्या गमनं तत्र रोचये ।\nमम पञ्च सुता ब्रह्मंस्तेषामेको गमिष्यति ।\nत्वदर्थं बलिमादाय तस्य पापस्य रक्षसः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115453, "chapter_id": 3485, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115454, "chapter_id": 3485, "verse_number": "४", "content_sanskrit": "नाहमेतद् वरिष्यामि जीवितार्थं कथञ्चन ।\nब्राह्मणस्यातिथेश्चैव स्वार्थे प्राणैर्वियोजनम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115455, "chapter_id": 3485, "verse_number": "५", "content_sanskrit": "नन्वेतद्धर्मनित्यानां कुलीनानां सुदुष्करम् ।\nयद् ब्राह्मणार्थं विसृजेदात्मानं चैव वाऽऽत्मजम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115456, "chapter_id": 3485, "verse_number": "६", "content_sanskrit": "आत्मनस्तु मम श्रेयो योक्तव्यमिति रोचये ।\nब्रह्मवध्यात्मवध्याभ्यां श्रेयानात्मवधो मम \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115457, "chapter_id": 3485, "verse_number": "७", "content_sanskrit": "ब्रह्मवध्या परं पापं निष्कृतिर्नात्र विद्यते ।\nअबुद्धिपूर्वं कृत्वाऽपि प्रत्यवायो न बुध्यते \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115458, "chapter_id": 3485, "verse_number": "८", "content_sanskrit": "न त्वहं वधमाकाङ्क्षे स्वयमेवात्मनः शुभे ।\nपरैः कृते वधे पापं न किञ्चिन्मम विद्यते \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115459, "chapter_id": 3485, "verse_number": "९", "content_sanskrit": "अभिसन्धिकृते तस्मिन् ब्राह्मणस्य वधे मया ।\nनिष्कृतिं न हि पश्यामि भृशं सन्तर्तुमेव च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115460, "chapter_id": 3485, "verse_number": "१०", "content_sanskrit": "आगतस्य गृहाभ्याशे तथैव शरणार्थिनः ।\nयाचमानस्य च वधो नृशंसं परमं मतम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115461, "chapter_id": 3485, "verse_number": "११", "content_sanskrit": "कुर्याच्च विहितं कर्म न नृशंसं कथञ्चन ।\nइति पूर्वे महात्मानः प्राहुर्धर्मविदो जनाः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115462, "chapter_id": 3485, "verse_number": "१२", "content_sanskrit": "श्रेयसे सह दारेण विनाशोऽद्य मम स्वयम् ।\nब्राह्मणस्य वधं नाहमनुमंस्ये कथञ्चन \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115463, "chapter_id": 3485, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115464, "chapter_id": 3485, "verse_number": "१३", "content_sanskrit": "ममाप्येषा मतिर्ब्रह्मन् विप्रा रक्ष्या इति स्थिता ।\nन चाप्यनिष्टः पुत्रो मे यदि पुत्रशतं भवेत् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115465, "chapter_id": 3485, "verse_number": "१४", "content_sanskrit": "न चासौ राक्षसः शक्तो मम पुत्रविनाशने ।\nवीर्यवान् मन्त्रसिद्धश्च तेजस्वी च सुतो मम \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115466, "chapter_id": 3485, "verse_number": "१५", "content_sanskrit": "राक्षसाय च तत्सर्वं प्रापयिष्यति भोजनम् ।\nमोक्षयिष्यति चात्मानमिति मे निश्चिता मतिः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115467, "chapter_id": 3485, "verse_number": "१६", "content_sanskrit": "समागताश्च वीर्येण दृष्टपूर्वाश्च राक्षसाः ।\nबलवन्तो महाकाया निहताश्चाप्यनेकशः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115468, "chapter_id": 3485, "verse_number": "१७", "content_sanskrit": "न त्विदं केषुचिद् ब्रह्मन् व्याहर्तव्यं कथञ्चन ।\nविद्यार्थिनो हि मे पुत्रान् विप्रकुर्युः कुतूहलात् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115469, "chapter_id": 3485, "verse_number": "१८", "content_sanskrit": "गुरुणा चाननुज्ञातो ग्राहयेद् यः सुतो मम ।\nन स कुर्यात् तथा कार्यं विद्ययेति सतां मतम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115470, "chapter_id": 3485, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115471, "chapter_id": 3485, "verse_number": "१९", "content_sanskrit": "एवमुक्तस्तु पृथया स विप्रः भार्यया सह ।\nहृष्टः सम्पूजयामास तद्वक्यममृतोपमम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115472, "chapter_id": 3485, "verse_number": "२०", "content_sanskrit": "ततः कुन्ती च विप्रश्च सहितावनिलात्मजम् ।\nतमब्रूतां कुरुष्वेति प्रतिजज्ञे तथेति सः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115473, "chapter_id": 3485, "verse_number": "१६४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचतुःषष्ठ्यधिकशततमोऽध्यायः ॥१६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2115474, "chapter_id": 3485, "verse_number": "५", "content_sanskrit": "॥ इति बकवधपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2115475, "chapter_id": 3485, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]