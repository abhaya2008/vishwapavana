[{"id": 2177399, "chapter_id": 4746, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177400, "chapter_id": 4746, "verse_number": "१", "content_sanskrit": "ते हत्वा सर्वपाञ्चालान् द्रौपदेयांश्च सर्वशः ।\nआगच्छन् सहिताः सर्वे यत्र दुर्योधनो हतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177401, "chapter_id": 4746, "verse_number": "२", "content_sanskrit": "गत्वा चैनमपश्यन्त किञ्चित्प्राणं नराधिपम् ।\nततो रथेभ्यः प्रस्कन्द्य परिवव्रुः तवात्मजम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177402, "chapter_id": 4746, "verse_number": "३", "content_sanskrit": "तं भग्नसक्थं राजानं कृच्छ्रप्राणमचेतसम् ।\nवमन्तं रुधिरं वक्त्राद् अपश्यन् वसुधातळे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177403, "chapter_id": 4746, "verse_number": "४", "content_sanskrit": "वृतं समन्ताद् बहुभिः श्वापदैर्घोररूपिभिः ।\nसालावृकगणैश्चैव भक्षयिष्यद्भिरन्तिकात्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177404, "chapter_id": 4746, "verse_number": "५", "content_sanskrit": "निवारयन्तं तान् कृच्छ्रात् श्वापदान् सञ्चिखादिषून् ।\nविवेष्टमानमूरुभ्यां सुभृशं गाढवेदनम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177405, "chapter_id": 4746, "verse_number": "६", "content_sanskrit": "तं शयानं तथा दृष्ट्वा भूमौ स्वरुधिरोक्षितम् ।\nहतशिष्टास्त्रयो राजन् शोकार्ताः पर्यवारयन्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177406, "chapter_id": 4746, "verse_number": "", "content_sanskrit": "(तैस्त्रिभिः शोणितादिग्धैर्निःश्वसद्भिर्महारथैः ।\nशुशुभे संवृतो राजा वेदिस्त्रिभिरिवाग्निभिः\t॥७॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177407, "chapter_id": 4746, "verse_number": "८", "content_sanskrit": "ते तं शयानं सम्प्रेक्ष्य राजानमतथोचितम् ।\nअविषह्येन दुःखेन सर्वे प्ररुरुदुस्त्रियः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177408, "chapter_id": 4746, "verse_number": "९", "content_sanskrit": "ततस्ते रुधिरं हस्तैर्मुखान्निर्मृज्य तस्य ह ।\nरणे राज्ञः शयानस्य कृपणं पर्यदेवयन्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177409, "chapter_id": 4746, "verse_number": "", "content_sanskrit": "कृपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177410, "chapter_id": 4746, "verse_number": "१०", "content_sanskrit": "न दैवस्यातिभारोऽस्ति यदयं रुधिरोक्षितः ।\nएकादशचमूभर्ता शेते दुर्योधनो हतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177411, "chapter_id": 4746, "verse_number": "११", "content_sanskrit": "(पश्य चामीकराभस्य चामीकरविभूषिताम् ।)\nगदां गदाप्रियस्येमां समीपे पतितां भुवि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177412, "chapter_id": 4746, "verse_number": "१२", "content_sanskrit": "इयमेनं सदा शूरं न जहाति रणे रणे ।\nस्वर्गामपि व्रजन्तं हि न जहाति यशस्विनम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177413, "chapter_id": 4746, "verse_number": "१३", "content_sanskrit": "पश्येमां सह वीरेण जाम्बूनदविभूषिताम् ।\nशयानां शयने धर्म्यां भार्यां प्रीतिमतीमिव\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177414, "chapter_id": 4746, "verse_number": "", "content_sanskrit": "यो वै मूर्धाभिषिक्तानामग्रे याति परन्तपः ।\n(स हतो ग्रसते पांसुं पश्य कालस्य पर्ययम्\t॥१४॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177415, "chapter_id": 4746, "verse_number": "१५", "content_sanskrit": "येन स्म निहता भूमौ शेरते क्षत्रियर्षभाः ।\nस भूमौ निहतः शेते कुरुराजः परैरयम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177416, "chapter_id": 4746, "verse_number": "१६", "content_sanskrit": "भयान्नमन्तो राजानो यस्याथ शतसङ्घशः ।\nस वीरशयने शेते क्रव्यादैः परिवारितः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177417, "chapter_id": 4746, "verse_number": "१७", "content_sanskrit": "यमुपासन्नृपाः पूर्वमर्थहेतोर्महीपतिम् ।\nतमुपासन्त कौरव्यं क्रव्यादा मांसगर्द्धिनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177418, "chapter_id": 4746, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2177419, "chapter_id": 4746, "verse_number": "१८", "content_sanskrit": "तं शयानं कुरुश्रेष्ठं भूमौ भरतसत्तमम् ।\nअश्वत्थामा समालिङ्ग्य कृपणं पर्यदेवयत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2177420, "chapter_id": 4746, "verse_number": "", "content_sanskrit": "द्रौणिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2177421, "chapter_id": 4746, "verse_number": "१९", "content_sanskrit": "आहुस्त्वा नरशार्दूल मुख्यं सर्वधनुष्मताम् ।\nधनाध्यक्षोपमं युद्धे शिष्यं सङ्कर्षणस्य ह\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2177422, "chapter_id": 4746, "verse_number": "२०", "content_sanskrit": "कथं विवरमद्राक्षीद् भीमसेनस्तवानघ ।\nबलिनः कृतिनो नित्यं सूदः पापात्मवान् नृप\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2177423, "chapter_id": 4746, "verse_number": "२१", "content_sanskrit": "कालो नूनं महाराज लोकेऽस्मिन् बलवत्तरः ।\nत्वां चेत् पश्याम निहतं भीमसेनेन संयुगे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2177424, "chapter_id": 4746, "verse_number": "२२", "content_sanskrit": "कथं त्वां सर्वधर्मज्ञं क्षुद्रः पापो वृकोदरः ।\nनिकृत्या हतवान् मन्दो नूनं कालो दुरत्ययः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2177425, "chapter_id": 4746, "verse_number": "२३", "content_sanskrit": "धर्मयुद्धे ह्यधर्मेण समाहूयौजसा मृधे ।\nगदया भीमसेनेन सक्थिनी ते विनाशिते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2177426, "chapter_id": 4746, "verse_number": "२४", "content_sanskrit": "अधर्मेण हतस्याजौ मृद्यमानं पदा शिरः ।\nयदुपेक्षितवान् क्षुद्रो धिक् तमस्तु युधिष्ठिरम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2177427, "chapter_id": 4746, "verse_number": "२५", "content_sanskrit": "युद्धेष्वपवदिष्यन्ति योधा नूनं वृकोदरम् ।\nयावत् स्थास्यन्ति भूतानि निकृत्या ह्यसि पातितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2177428, "chapter_id": 4746, "verse_number": "२६", "content_sanskrit": "ननु रामोऽब्रवीद् राजन् त्वां सदा यदुनन्दनः ।\nदुर्योधनसमो नास्ति गदायामिति वीर्यवान्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2177429, "chapter_id": 4746, "verse_number": "२७", "content_sanskrit": "श्लाघते त्वां हि वार्ष्णेयो राजन् संसत्सु भारत ।\nस शिष्यो मम कौरव्यो गदायुद्ध इति प्रभो\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2177430, "chapter_id": 4746, "verse_number": "२८", "content_sanskrit": "यां गतिं क्षत्रियस्याहुः प्रशस्तां परमर्षयः ।\nहतस्याभिमुखस्याजौ प्राप्तस्त्वमसि तां गतिम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2177431, "chapter_id": 4746, "verse_number": "२९", "content_sanskrit": "दुर्योधन न शोचामि त्वामहं भरतर्षभ ।\nहतपुत्रौ तु शोचामि गान्धारीं पितरं च ते\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2177432, "chapter_id": 4746, "verse_number": "३०", "content_sanskrit": "(द्वावनाथौ कृतौ वीर त्वया नाथेन वर्धितौ ।)\nभिक्षां तौ विचरिष्येते शोचन्तौ पृथिवीमिमाम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2177433, "chapter_id": 4746, "verse_number": "३१", "content_sanskrit": "धिगस्तु कृष्णं वार्ष्णेयमर्जुनं चापि दुर्मतिम् ।\nधर्मज्ञमानिनौ यौ त्वा वध्यमानमुपेक्षताम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2177434, "chapter_id": 4746, "verse_number": "३२", "content_sanskrit": "पाण्डवाश्चापि ते सर्वे किं वक्ष्यन्ति नराधिपान् ।\nकथं दुर्योधनोऽस्माभिर्हत इत्यनपत्रपाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2177435, "chapter_id": 4746, "verse_number": "३३", "content_sanskrit": "धन्यस्त्वमसि गान्धारे यस्त्वामायोधने हतः ।\nप्रयातोऽभिमुखः शत्रून् धर्मेण भरतर्षभ\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2177436, "chapter_id": 4746, "verse_number": "३४", "content_sanskrit": "हतपुत्रा हि गान्धारी निहतज्ञातिबान्धवा ।\nप्रज्ञाचक्षुश्च दुर्धर्षः कां दशां प्रतिपत्स्यते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2177437, "chapter_id": 4746, "verse_number": "३५", "content_sanskrit": "धिगस्तु कृतवर्माणं मां कृपं च महारथम् ।\nये वयं न गताः स्वर्गं त्वां पुरस्कृत्य भारत\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2177438, "chapter_id": 4746, "verse_number": "३६", "content_sanskrit": "दातारं सर्वकामानां रक्षितारं प्रजाहितम् ।\nयद्वयं नाधिगच्छाम त्वां धिगस्मान् नराधमान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2177439, "chapter_id": 4746, "verse_number": "३७", "content_sanskrit": "कृपस्य तव वीर्येण मम चैव पितुश्च मे ।\nसभृत्यानां नरव्याघ्र रत्नवन्ति गृहाणि नः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2177440, "chapter_id": 4746, "verse_number": "३८", "content_sanskrit": "तव प्रसादादस्माभिः सहपुत्रैः सबान्धवैः ।\nअवाप्ताः क्रतवो मुख्या बहवो भूरिदक्षिणाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2177441, "chapter_id": 4746, "verse_number": "३९", "content_sanskrit": "कुतश्चापीदृशं सौख्यमुपलप्स्यामहे वयम् ।\nयादृशं तु गता सौख्यं त्वां पुरस्कृत्य भूमिप\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2177442, "chapter_id": 4746, "verse_number": "४०", "content_sanskrit": "वयमेव त्रयो राजन् गच्छन्तं परमां गतिम् ।\nयद्वै त्वां नानुगच्छाम तेन तप्स्यामहे वयम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2177443, "chapter_id": 4746, "verse_number": "४१", "content_sanskrit": "यादृशा नो गताः स्वर्गं त्वां पुरस्कृत्य भूमिप ।\nतत्स्वर्गहीना हीनार्थाः स्मरन्तः सुकृतानि च\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2177444, "chapter_id": 4746, "verse_number": "४२", "content_sanskrit": "किं नाम तद्भवेत् कर्म येन त्वाऽनु व्रजामहे\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2177445, "chapter_id": 4746, "verse_number": "४३", "content_sanskrit": "दुःखं नूनं कुरुश्रेष्ठ चरिष्याम महीमिमाम् ।\nत्वद्धीनानां हि नो राजन् कुतः शान्तिः कुतः सुखम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2177446, "chapter_id": 4746, "verse_number": "४४", "content_sanskrit": "गत्वैनांस्तु महाराज समेत्य त्वं महारथान् ।\nयथाश्रेष्ठं यथाज्येष्ठं सम्पूज्य वचनान्मम\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2177447, "chapter_id": 4746, "verse_number": "४५", "content_sanskrit": "आचार्यं पूजयित्वा च केतुं सर्वधनुर्भृताम् ।\nहतं मया त्वं शंसेथा धृष्टद्युम्नं महारथम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2177448, "chapter_id": 4746, "verse_number": "४६", "content_sanskrit": "परिष्वजेथा राजानं बाह्लिकं च महारथम् ।\nसैन्धवं सोमदत्तं च भूरिश्रवसमेव च\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2177449, "chapter_id": 4746, "verse_number": "४७", "content_sanskrit": "तथा पूर्वगतान् सर्वान् स्वर्गे पार्थिवसत्तमान् ।\nअस्माद्वाक्यात् परिष्वज्य पृच्छेथास्ताननामयम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2177450, "chapter_id": 4746, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2177451, "chapter_id": 4746, "verse_number": "४८", "content_sanskrit": "इत्येवमुक्त्वा राजानं भग्नसक्थमचेतसम् ।\nअश्वत्थामा लघुप्राणम् इदं वचनमब्रवीत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2177452, "chapter_id": 4746, "verse_number": "", "content_sanskrit": "द्रौणिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2177453, "chapter_id": 4746, "verse_number": "४९", "content_sanskrit": "दुर्योधन जीवसि चेद् वाचः कर्णसुखाः शृणु ।\nसप्त पाण्डवतः शिष्टा धार्तराष्ट्रास्त्रयो वयम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2177454, "chapter_id": 4746, "verse_number": "५०", "content_sanskrit": "ते चैव भ्रातरः पञ्च वासुदेवोऽथ सात्यकिः ।\nअहं च कृतवर्मा च कृपः शारद्वतस्तथा\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2177455, "chapter_id": 4746, "verse_number": "५१", "content_sanskrit": "द्रौपदेया हताः सर्वे धृष्टद्युम्नश्च चात्मजाः ।\nपाञ्चालैः सहिता राजन् मत्स्यशेषाश्च भारत\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2177456, "chapter_id": 4746, "verse_number": "५२", "content_sanskrit": "कृतप्रतिकृतं पश्य हतपुत्राश्च पाण्डवाः ।\nसौप्तिके शिबिरं राजन् हतं सनरवाहनम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2177457, "chapter_id": 4746, "verse_number": "५३", "content_sanskrit": "मया च पापकर्माऽसौ धृष्टद्युम्नो महीपते ।\nप्रविश्य शिबिरं रात्रौ पशुमारेण मारितः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2177458, "chapter_id": 4746, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2177459, "chapter_id": 4746, "verse_number": "५४", "content_sanskrit": "दुर्योधनस्तु ता वाचो निशम्य मनसः प्रियाः ।\nप्रतिलभ्य ततश्चेत इदं वचनमब्रवीत्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2177460, "chapter_id": 4746, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2177461, "chapter_id": 4746, "verse_number": "५५", "content_sanskrit": "न मेऽकरोत् तद् गाङ्गेयो न मे कर्णो न ते पिता ।\nयत् त्वया कृपभोजाभ्यां सहितेन कृतं मम\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2177462, "chapter_id": 4746, "verse_number": "५६", "content_sanskrit": "स चेत् सेनापतिः क्षुद्रो हतः सार्धं शिखण्डिना ।\nतेन मन्ये मघवता सममात्मानमद्य वै\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2177463, "chapter_id": 4746, "verse_number": "५७", "content_sanskrit": "स्वस्ति प्राप्नुत भद्रं वः स्वर्गे नः सङ्गमः पुनः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2177464, "chapter_id": 4746, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2177465, "chapter_id": 4746, "verse_number": "५८", "content_sanskrit": "इत्येवमुक्त्वा पुत्रस्ते कुरुराजो महामनाः ।\nप्राणानवासृजद् वीरः सुहृदां दुःखमादधत्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2177466, "chapter_id": 4746, "verse_number": "५९", "content_sanskrit": "ततस्ते सम्परिष्वज्य परिमृज्य च तं भृशम् ।\nपुनः पुनः प्रेक्षमाणाः स्वकानारुरुहू रथान्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2177467, "chapter_id": 4746, "verse_number": "६०", "content_sanskrit": "इत्येवं द्रोणपुत्रस्य निशम्य करुणा गिरः ।\nप्रत्यूषकाले शोकार्ताः प्राद्रवन् नगरं प्रति\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2177468, "chapter_id": 4746, "verse_number": "६१", "content_sanskrit": "एवमेष क्षयो वृत्तः कुरुपाण्डवसेनयोः ।\nघोरो विशसनो रौद्रो राजन् दुर्मन्त्रिते तव\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2177469, "chapter_id": 4746, "verse_number": "६२", "content_sanskrit": "तव पुत्रे गते स्वर्गं भारते भरतर्षभ ।\nऋषिदत्तं प्रनष्टं तद् दिव्यदर्शित्वमद्य वै\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2177470, "chapter_id": 4746, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2177471, "chapter_id": 4746, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रुत्वा स नृपतिः ज्ञातिपुत्रवधं तदा ।\nनिःश्वस्य दीर्घमुष्णं च ततश्चिन्तापरोऽभवत्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2177472, "chapter_id": 4746, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसौप्तिकपर्वणि दुर्योधनमरणो नाम नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2177473, "chapter_id": 4746, "verse_number": "", "content_sanskrit": "॥ समाप्तं सौप्तिकपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2177474, "chapter_id": 4746, "verse_number": "", "content_sanskrit": "––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]