[{"id": 7002454000, "chapter_id": 22454, "verse_number": "१-११६-१", "content_sanskrit": "ब्रह्मोवाच ।\nकृष्ण राजा महानासीद्ययातिकुलसम्भवः ।\nसत्राजिदिति विख्यातश्चक्रवर्ती महाबलः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002454001, "chapter_id": 22454, "verse_number": "१-११६-२", "content_sanskrit": "प्रभावैस्तेजसा कान्त्या क्षान्त्या बलसमन्वितः ।\nधैर्यगम्भीर्यसम्पन्नो वदान्यो यशसान्वितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002454002, "chapter_id": 22454, "verse_number": "१-११६-३", "content_sanskrit": "बुद्ध्या विक्रमदक्षश्च सम्पन्नो ब्राह्मणायतः ।\nकृती कविस्तथा शूरः षट्पदाख्यैर्न निर्जितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002454003, "chapter_id": 22454, "verse_number": "१-११६-४", "content_sanskrit": "सदा पञ्चसु रक्तश्च वसुमद्भिर्न निर्जितः ।\nरुद्रता वसुभिर्जातैः सत्त्वश्रद्धासमन्वितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002454004, "chapter_id": 22454, "verse_number": "१-११६-५", "content_sanskrit": "अम्बुजस्याण्डजस्येव आत्रेयस्य तथाच्युत ।\nअम्बुजायास्तथा कृष्ण वार्यपात्रं स वै विभो ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002454005, "chapter_id": 22454, "verse_number": "१-११६-६", "content_sanskrit": "गाङ्गेयेन बले तुल्यः पौलस्त्यार्चाश्रमो यथा ।\nगाङ्गेयस्य तथा कृष्ण धिषणस्य हरेर्यथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002454006, "chapter_id": 22454, "verse_number": "१-११६-७", "content_sanskrit": "काम्यश्च द्विजभक्तस्तु तथा वाल्मीकिवत्सदा ।\nव्यासस्य देवशार्दूल जामदग्न्यस्य वा विभोः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002454007, "chapter_id": 22454, "verse_number": "१-११६-८", "content_sanskrit": "एषां नैकैर्गुणैर्युक्तः स राजा क्ष्मातले विभो ।\nशशास स महाबाहुः सप्तद्वीपां वसुन्धराम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002454008, "chapter_id": 22454, "verse_number": "१-११६-९", "content_sanskrit": "यस्मिन्गाथां प्रगायन्ति ये पुराणविदो जनाः ।\nसत्राजिते महाबाहौ कृष्ण धात्रीं समाश्रिते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002454009, "chapter_id": 22454, "verse_number": "१-११६-१०", "content_sanskrit": "यावत्सूर्य उदेति स्म यावच्च प्रतितिष्ठति ।\nसत्राजितं तु तत्सर्वं क्षेत्रमित्यमिधीयते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002454010, "chapter_id": 22454, "verse_number": "१-११६-११", "content_sanskrit": "स सर्वरत्नसंयुक्तां सप्तद्वीपवतीं महीम् ।\nशशास धर्मेण पुरा चक्रवर्ती महाबलः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002454011, "chapter_id": 22454, "verse_number": "१-११६-१२", "content_sanskrit": "नान्यायकृन्न चाशक्तो वदान्यो बलवत्तरः ।\nतस्याभूत्पुरुषा राज्ञः सम्यग्धर्मानुशासिनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002454012, "chapter_id": 22454, "verse_number": "१-११६-१३", "content_sanskrit": "चत्वारः सचिवास्तस्य राज्ञः सत्राजितस्य तु ।\nबभूवुरप्रतिहताः सदा वाति बलस्य वै ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002454013, "chapter_id": 22454, "verse_number": "१-११६-१४", "content_sanskrit": "तस्य भक्तिरतीवासीन्निसर्गादेव भूपतेः ।\nदिवाकरे जगद्भानौ रक्तचन्दनमालिनि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002454014, "chapter_id": 22454, "verse_number": "१-११६-१५", "content_sanskrit": "तस्योर्ध्वमहिमानं च विलोक्य पृथिवीपतेः ।\nन केवलं जनस्यापि ह्यभवत्तस्य विस्मयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002454015, "chapter_id": 22454, "verse_number": "१-११६-१६", "content_sanskrit": "सञ्चिन्तयामास नृपः समृद्ध्या विस्मितस्तथा ।\nकथं स्यात् सम्पदेषा मे पुनरप्यन्यजन्मनि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002454016, "chapter_id": 22454, "verse_number": "१-११६-१७", "content_sanskrit": "एवं स बहुशो राजा तदा कृष्ण महायशाः ।\nचिन्तयन्नपि तन्मूलं नासदन्निश्चयान्वितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002454017, "chapter_id": 22454, "verse_number": "१-११६-१८", "content_sanskrit": "यदा न निश्चयं राजा स ययौ भार्गवीप्रियः ।\nतदा पप्रच्छ धर्मज्ञान्स विप्रान्समुपागतान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002454018, "chapter_id": 22454, "verse_number": "१-११६-१९", "content_sanskrit": "सर्वाश्च ससुखान्वीर विविक्तान्तः पुरस्थितः ।\nप्रणिपत्य महाबाहुर्ग्रहीतुं शासनक्रियाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002454019, "chapter_id": 22454, "verse_number": "१-११६-२०", "content_sanskrit": "विश्वासानुग्रहा बुद्धिर्भवतां मयि सत्तमाः ।\nतदहं प्रष्टुमिच्छामि किञ्चित्तद्वक्तुमर्हथ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002454020, "chapter_id": 22454, "verse_number": "१-११६-२१", "content_sanskrit": "सद्विद्याखिलविज्ञानसम्यग्धौतान्तरात्मभिः ।\nभवद्भिर्यद्यनुग्राह्यः स्यामहं वेदवित्तमाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002454021, "chapter_id": 22454, "verse_number": "१-११६-२२", "content_sanskrit": "तद्यथावन्मया पृष्टा भवन्तो मत्प्रसादिनः ।\nवक्तुमर्हथ विद्वांसः सर्वस्यैवोपकारिणः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002454022, "chapter_id": 22454, "verse_number": "१-११६-२३", "content_sanskrit": "ब्रह्मोवाच ।\nयस्ते मनसि सन्देहस्तं पृच्छाद्य महीपते ।\nवदिष्यामो यथान्यायं यत्ते१ मनसि वर्त्तते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002454023, "chapter_id": 22454, "verse_number": "१-११६-२४", "content_sanskrit": "वयं हि नृपशार्दूल भवता पारितोषिताः ।\nसम्यक्प्रजां पालयित्रा ददता भोजनं सदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002454024, "chapter_id": 22454, "verse_number": "१-११६-२५", "content_sanskrit": "सन्तुष्टो ब्राह्मणोऽश्नीयाच्छिंद्याद्वा धर्मसंशयम् ।\nहितं चोपदिशेद्वर्त्म अहिताद्वा निवर्तयेत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002454025, "chapter_id": 22454, "verse_number": "१-११६-२६", "content_sanskrit": "विवक्षुमथ भूपालं भार्या तस्यैव धीमतः ।\nप्रणिपातेन चाहेदं विनयात्प्रणयान्वितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002454026, "chapter_id": 22454, "verse_number": "१-११६-२७", "content_sanskrit": "न स्त्रीणामवनीपाल वक्तुमीदृगिहेष्यते ।\nतथापि भूपते वक्ष्ये सम्पदीदृक्सुदुर्लभा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002454027, "chapter_id": 22454, "verse_number": "१-११६-२८", "content_sanskrit": "भूयोऽपि संशयान्प्रष्टुमलमीशो भवानृषीन् ।\nनन्वहं पुरषव्याघ्र सदान्तः पुरचारिणी ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002454028, "chapter_id": 22454, "verse_number": "१-११६-२९", "content_sanskrit": "तत्प्रसादं यदि भवान्करोति मम पार्थिव ।\nतन्मदीयमृषीन्प्रष्टुं सन्देहं पार्थिवार्हसि ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002454029, "chapter_id": 22454, "verse_number": "१-११६-३०", "content_sanskrit": "सत्राजित उवाच ।\nब्रूहि सुभ्रूर्मतं यत्ते प्रष्टव्या यन्मया द्विजाः ।\nभूयोऽहमात्मसन्देहं प्रक्ष्याम्येतद्द्विजोत्तमान् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002454030, "chapter_id": 22454, "verse_number": "१-११६-३१", "content_sanskrit": "विमलवत्युवाच ।\nश्रूयन्ते पृथिवीपाल नृपा ये तु चिरन्तनाः ।\nयेषां च सम्पद्भूपाल यथा तेऽद्य किलाभवत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002454031, "chapter_id": 22454, "verse_number": "१-११६-३२", "content_sanskrit": "तदीदृक्सम्पदो धाम तवाशेषं क्षितीश्वर ।\nयेन कर्मविपाकेन तद्वदन्तु महर्षयः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002454032, "chapter_id": 22454, "verse_number": "१-११६-३३", "content_sanskrit": "अहं च भवतो भार्या सर्वसीमन्तिनीवरा ।\nअतीव कर्मणा येन तद्विज्ञाने कुतूहलम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002454033, "chapter_id": 22454, "verse_number": "१-११६-३४", "content_sanskrit": "तथा सम्पत्समृद्धत्वमन्येष्वपि हि विद्यते ।\nनिरस्तातिशयत्वेन नूनं नाल्पेन कर्मणा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002454034, "chapter_id": 22454, "verse_number": "१-११६-३५", "content_sanskrit": "तदन्यजन्मचरितं नरनाथ निजं भवान् ।\nमुनीन्पृच्छ त्वया चाहं यन्मया च पुरा कृतम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002454035, "chapter_id": 22454, "verse_number": "१-११६-३६", "content_sanskrit": "ब्रह्मोवाच ।\nस तथोक्तस्तया राजा पत्न्या विस्मितमानसः ।\nमुनीनां पुरतो मायां प्रशंसन्वाक्यमब्रवीत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002454036, "chapter_id": 22454, "verse_number": "१-११६-३७", "content_sanskrit": "साधु देवि मतं यन्मे त्वया यदिदमीरितम् ।\nसत्यं मुनिवचः पुंसां स्याद्ध वै गृहिणी तथा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002454037, "chapter_id": 22454, "verse_number": "१-११६-३८", "content_sanskrit": "सोऽहमेतन्महाभागे पृच्छाम्येतान्महामुनीन् ।\nतेषामविदितं किञ्चित्त्रिषु लोकेषु न विद्यते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002454038, "chapter_id": 22454, "verse_number": "१-११६-३९", "content_sanskrit": "एवमुक्त्वा प्रियां राजा प्रणिपत्य च तानृषीन् ।\nयथावदेतदखिलं पप्रच्छ धरणीधरः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002454039, "chapter_id": 22454, "verse_number": "१-११६-४०", "content_sanskrit": "राजोवाच ।\nभगवन्तो ममाशेषं प्रसादावृतचेतसः ।\nकथयन्तु यथावृत्तं यन्मया सुकृतं कृतम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002454040, "chapter_id": 22454, "verse_number": "१-११६-४१", "content_sanskrit": "कोऽहमासं पुरा विप्राः किंस्वित्कर्म मया कृतम् ।\nकिं वानया तु चार्वंग्या मम पत्न्या कृतं द्विजाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002454041, "chapter_id": 22454, "verse_number": "१-११६-४२", "content_sanskrit": "येनावयोरियं लक्ष्मीर्मर्त्यलोके सुदुर्लभा ।\nचत्वारश्चाप्रतिहता अमात्या मम गच्छतः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002454042, "chapter_id": 22454, "verse_number": "१-११६-४३", "content_sanskrit": "अशेषा भूभृतो वश्या धनस्यान्तो न विद्यते ।\nबलं चैवाप्रतिहतं शरीरारोग्यमेव च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002454043, "chapter_id": 22454, "verse_number": "१-११६-४४", "content_sanskrit": "प्रतिभाति च मे कान्त्या भार्यायामखिलं जगत् ।\nममापि वपुषस्तेजो न कश्चित्सहते द्विजाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002454044, "chapter_id": 22454, "verse_number": "१-११६-४५", "content_sanskrit": "सोऽहमिच्छामि तज्ज्ञातुं तथैवेयमनिन्दिता ।\nनिजानुष्ठानमखिलं यस्याशेषमिदं फलम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002454045, "chapter_id": 22454, "verse_number": "१-११६-४६", "content_sanskrit": "ब्रह्मोवाच ।\nइति पृष्टा नरेन्द्रेण समस्तास्ते तपोधनाः ।\nपरावसुमथोचुस्ते कथ्यतामस्य भूभृतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002454046, "chapter_id": 22454, "verse_number": "१-११६-४७", "content_sanskrit": "चोदितः सोऽपि धर्मज्ञैर्महाशूरा महामतिः ।\nयोगमास्थाय सुचिरं यथावद्यतमानसः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002454047, "chapter_id": 22454, "verse_number": "१-११६-४८", "content_sanskrit": "ज्ञातवान्नृपतेस्तस्य पूर्वदेहविचेष्टितम् ।\nस तमाह मुनिर्भूपं विज्ञानेच्छं महामतिम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002454048, "chapter_id": 22454, "verse_number": "१-११६-४९", "content_sanskrit": "सत्राजितं महात्मानं जितशत्रुं मनस्विनम् ।\nसपत्नीकं महाबुद्धिं ब्राह्मणान्सत्यवादिनः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002454049, "chapter_id": 22454, "verse_number": "१-११६-५०", "content_sanskrit": "परावसुरुवाच ।\nशृणु भूपाल सकलं यस्येदं कर्मणः फलम् ।\nतव राज्यादिकं सुभ्रूर्येयं चासीन्महीपते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002454050, "chapter_id": 22454, "verse_number": "१-११६-५१", "content_sanskrit": "त्वमासीः शूद्रजातीयः परहिंसापरायणः ।\nकुष्ठार्तो दण्डपारुष्ये निःस्नेहः सर्वजन्तुषु ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002454051, "chapter_id": 22454, "verse_number": "१-११६-५२", "content_sanskrit": "द्वयं च भवतो भार्या पूर्वमप्यायतेक्षणा ।\nनित्यं बभूव त्वच्चित्ता भवच्छुश्रूषणे रता ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002454052, "chapter_id": 22454, "verse_number": "१-११६-५३", "content_sanskrit": "पतिव्रता महाभागा भर्त्स्यमानापि निष्ठुरम् ।\nत्वद्वाक्येषु च सर्वेषु वीर कर्मसु चोद्यता ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002454053, "chapter_id": 22454, "verse_number": "१-११६-५४", "content_sanskrit": "नैश्वर्यादसहायस्य त्यज्यमानस्य बन्धुभिः ।\nक्षयं जगाम योर्थोऽभूत्सञ्चितः प्रपितामहैः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002454054, "chapter_id": 22454, "verse_number": "१-११६-५५", "content_sanskrit": "तस्मिन्क्षीणे कृषिपरस्त्वमासीः पृथिवीपते ।\nसापि कर्मविपाकेन कृषिर्विफलतां गता ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002454055, "chapter_id": 22454, "verse_number": "१-११६-५६", "content_sanskrit": "ततो निःस्वं परिक्षीणं परेषां भृत्यतां गतम् ।\nतत्याज साध्वी नेयं त्वां त्यज्यमानापि पार्थिव ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002454056, "chapter_id": 22454, "verse_number": "१-११६-५७", "content_sanskrit": "अनया तु समं साध्व्या भानोरावसथे त्वया ।\nकृतं शुश्रूषणं वृत्त्या भक्त्या सम्मार्जनादिकम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002454057, "chapter_id": 22454, "verse_number": "१-११६-५८", "content_sanskrit": "निःस्नेहः सर्वकामेभ्यस्तन्मयस्त्वं तदर्पणः ।\nअहन्यहनि विस्रम्भात्तस्मिन्नावसथे रवेः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002454058, "chapter_id": 22454, "verse_number": "१-११६-५९", "content_sanskrit": "कान्यकुब्जपुरे वीर महाशुश्रूषितं त्वया ।\nदिवाकरालये नित्यं कृतं तन्मार्जनं त्वया ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002454059, "chapter_id": 22454, "verse_number": "१-११६-६०", "content_sanskrit": "तथैवाभ्युक्षणं भूप नित्यं चैवानुलेपनम् ।\nपत्न्यानया नृप तथा युष्मच्चित्तानुवृत्तया ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002454060, "chapter_id": 22454, "verse_number": "१-११६-६१", "content_sanskrit": "कारितं श्रवणं पुण्यमितिहासपुराणयोः ।\nदत्त्वाङ्गुलीयकं राजन्पितृदत्तं तु वाचके ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002454061, "chapter_id": 22454, "verse_number": "१-११६-६२", "content_sanskrit": "अहन्यहनि यत्कर्म युवयोर्नृपकुर्वतोः ।\nतत्रैव तन्मयत्वेन पापहानिरजायत ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002454062, "chapter_id": 22454, "verse_number": "१-११६-६३", "content_sanskrit": "भानोः कार्यं मया कार्यं परं शुश्रूषणं तथा ।\nनाप्रभातं प्रभातं वा चिन्तेयमभवन्निशि ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002454063, "chapter_id": 22454, "verse_number": "१-११६-६४", "content_sanskrit": "एवमायतनं रम्यमित्येवं च सुखावहम् ।\nसूर्यवच्चैवमेतत्स्यादित्यासीत्ते मनस्तदा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002454064, "chapter_id": 22454, "verse_number": "१-११६-६५", "content_sanskrit": "योगिनां सुखदं कर्म तथैव सुखमित्यपि ।\nभवच्चित्तमभूत्तत्र योगकर्मण्यहर्निशम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002454065, "chapter_id": 22454, "verse_number": "१-११६-६६", "content_sanskrit": "एवं तन्मनसस्तत्र कृतोद्योगस्य पार्थिव ।\nभूतानुमानिनः सम्यग्यथोक्ताधिककारिणः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002454066, "chapter_id": 22454, "verse_number": "१-११६-६७", "content_sanskrit": "स्मरतो गोपतिं नित्यं चित्तेनापि दृढात्मनः ।\nनिःशेषमुपशांतं ते पापं सूर्यनिषेवणात् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002454067, "chapter_id": 22454, "verse_number": "१-११६-६८", "content_sanskrit": "ततोऽधिकं पुरस्तस्मादगारस्यानुलेपनम् ।\nसंमार्जनं च बहुशः सपत्नीकेन यत्कृतम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002454068, "chapter_id": 22454, "verse_number": "१-११६-६९", "content_sanskrit": "केवलं धर्ममाश्रित्य त्यक्त्वा वृत्तिमशेषतः ।\nअनया श्रवणं पुण्यं कारितं वाचकात्सदा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002454069, "chapter_id": 22454, "verse_number": "१-११६-७०", "content_sanskrit": "नानाधातुविकारैस्तु गोमयेन मृदा तथा ।\nउपलेपनं कृतं भक्त्या त्वया पूर्वं सुरालये ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002454070, "chapter_id": 22454, "verse_number": "१-११६-७१", "content_sanskrit": "अथाजगाम वै तत्र कुवलाश्वो महीपतिः ।\nमहासैन्यपरीवारः प्रभूतगजवाहनः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002454071, "chapter_id": 22454, "verse_number": "१-११६-७२", "content_sanskrit": "सर्वसम्पदुपेतं तं सर्वाभरणभूषितम् ।\nवृतं भार्यासहस्रेण दृष्ट्वा संक्रन्दनोद्बलम् ।\nस्पृहा कृता त्वया तत्र चारुमौलिनि पार्थिवे ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002454072, "chapter_id": 22454, "verse_number": "१-११६-७३", "content_sanskrit": "सर्वकामप्रदं कर्म क्रियते भास्काराश्रितम् ।\nतेनैतदखिलं राज्यमशेषं चाप्तवान्महीम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002454073, "chapter_id": 22454, "verse_number": "१-११६-७४", "content_sanskrit": "तेजश्चैवाधिकं यत्ते तथैव शृणु पार्थिव ।\nयोगप्रभावतो लब्धं कथयाम्यखिलं तव ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002454074, "chapter_id": 22454, "verse_number": "१-११६-७५", "content_sanskrit": "तत्रैवावसथे दीपः प्रशान्तः स्नेहसंक्षयात् ।\nनिजभोजनतैलेन पुनः प्रज्वलितस्त्वया ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002454075, "chapter_id": 22454, "verse_number": "१-११६-७६", "content_sanskrit": "अन्या चोत्तरीयेण वीर वर्त्योपबृंहितः ।\nतव पत्न्या स्वयं ज्वाल्य कान्तिरस्यास्ततोऽधिका ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002454076, "chapter_id": 22454, "verse_number": "१-११६-७७", "content_sanskrit": "तवाप्यखिलभूपालमनः क्षोभकरं पुनः ।\nतेजो नरेन्द्र एतस्मात्किमुताराध्य भास्करम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002454077, "chapter_id": 22454, "verse_number": "१-११६-७८", "content_sanskrit": "एवं नरेन्द्रः शूद्रत्वाद्भानुकर्मपरायणः ।\nतन्मयत्वेन सम्प्राप्तो महिमानमनुत्तमम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002454078, "chapter_id": 22454, "verse_number": "१-११६-७९", "content_sanskrit": "किं पुनर्यो नरो भक्त्या नित्यं शुश्रूषणावृतः ।\nकरोति सततं पूजां निष्कामो नान्यमानसः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002454079, "chapter_id": 22454, "verse_number": "१-११६-८०", "content_sanskrit": "सर्वामृद्धिमिमां लब्ध्वा सर्वलोकमहेश्वरः ।\nपूजयित्वार्कमीशेशं तमाराध्य न सीदति ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002454080, "chapter_id": 22454, "verse_number": "१-११६-८१", "content_sanskrit": "पुष्पै धूपैस्तथा वान्यैर्दीपैर्वस्त्रानुलेपनैः ।\nआराधयार्कं तद्वेश्म सदा सम्मार्जनादिना ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002454081, "chapter_id": 22454, "verse_number": "१-११६-८२", "content_sanskrit": "यद्यदिष्टतमं किञ्चिद्यद्यन्यत्तु दुर्लभम् ।\nतद्दत्वा च जगद्धात्रे भास्कराय न सीदति ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002454082, "chapter_id": 22454, "verse_number": "१-११६-८३", "content_sanskrit": "सुगन्धागुरुकर्पूरचन्दनागुरुकुंकुमैः ।\nवासोभिर्विविधैर्धूपैः पुष्पैः स्रक्चामरध्वजैः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002454083, "chapter_id": 22454, "verse_number": "१-११६-८४", "content_sanskrit": "अन्योपहारैर्विविधैः कृतक्षीराभिषेचनैः ।\nगीतवादित्रनृत्याद्यैस्तोषयस्वार्कमादरात् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002454084, "chapter_id": 22454, "verse_number": "१-११६-८५", "content_sanskrit": "पुण्यरात्रिषु मार्तण्डं नृत्यगीतैरथोज्ज्वलम् ।\nभूप जागरणैर्भक्त्या होमः कार्यः सदा शुचिः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002454085, "chapter_id": 22454, "verse_number": "१-११६-८६", "content_sanskrit": "इतिहासपुराणानां श्रवणेन  ।\nविशेषतः ।\nतथा वेदस्वनैः पुण्यैरृक्सामयजुभिर्नृप ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002454086, "chapter_id": 22454, "verse_number": "१-११६-८७", "content_sanskrit": "एवं सन्तोष्यते भक्त्या भगवान्भवभङ्गकृत् ।\nभूयो वैवस्वतो भूत्वा भवहृद्भास्करो नरैः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002454087, "chapter_id": 22454, "verse_number": "१-११६-८८", "content_sanskrit": "तोषितो भगवान्भानुर्ददात्यभिमतं फलम् ।\nदैवकर्मसमर्थानां प्राणिनां स्मृतिसम्भवैः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002454088, "chapter_id": 22454, "verse_number": "१-११६-८९", "content_sanskrit": "तोषितो भगवान्कामान्प्रयच्छति दिवाकरः ।\nनैष वृत्तैर्न रत्नौघैः पुष्पैर्धूपानुलेपनैः ।\nसद्भावेनैव मार्तण्डस्तोषमायाति संस्मृतः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002454089, "chapter_id": 22454, "verse_number": "१-११६-९०", "content_sanskrit": "त्वयैकाग्रमनस्केन गृहसम्मार्जनादिकम् ।\nकृत्वाल्पमीदृशं प्राप्तं राज्यमन्येन दुर्लभम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002454090, "chapter_id": 22454, "verse_number": "१-११६-९१", "content_sanskrit": "अनया श्रवणं पुण्यं कारयित्वा गृहे रवेः ।\nईदृक्प्राप्ता सम्पदियं पूजां कृत्वा तु वाचके ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7002454091, "chapter_id": 22454, "verse_number": "१-११६-९२", "content_sanskrit": "प्राप्तोपकरणैर्यस्तमेकाग्रमतिरण्डजम् ।\nसन्तोषयति नेन्द्रोऽपि भवता वै समः क्वचित् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7002454092, "chapter_id": 22454, "verse_number": "१-११६-९३", "content_sanskrit": "तस्मात्त्वमनया देव्या सहात्यन्तविनीतया ।\nभास्कराराधने यत्नं कुरु धर्मभृतां वर ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7002454093, "chapter_id": 22454, "verse_number": "१-११६-९४", "content_sanskrit": "ब्रह्मोवाच ।\nएतन्मुनेर्वचो वीर निशम्य स नराधिपः ।\nभार्यासहायः स तदा संप्रहृष्टतनूरुहः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7002454094, "chapter_id": 22454, "verse_number": "१-११६-९५", "content_sanskrit": "कृतकार्यमिवात्मानं मन्यमानस्तदाभवत् ।\nउवाच प्रणतो भूत्वा राजा सत्राजितोऽच्युत ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7002454095, "chapter_id": 22454, "verse_number": "१-११६-९६", "content_sanskrit": "सत्राजित उवाच ।\nयथामरत्वं सम्प्राप्य यथा वायुर्बलं परम् ।\nपरं निर्वाणमाप्नोति तथाहं वचसा तव ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7002454096, "chapter_id": 22454, "verse_number": "१-११६-९७", "content_sanskrit": "कृतकृत्यः सुखासीनो निर्वृतिं परमां गतः ।\nअज्ञानतमसाच्छन्ने यत्प्रदीपस्त्वया धृतः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7002454097, "chapter_id": 22454, "verse_number": "१-११६-९८", "content_sanskrit": "अहमेषा च तन्वङ्गी विभूतिभ्रंशभीरुकः ।\nद्रव्यमापादितं ब्रह्मन्निहाद्य वचसा तव ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7002454098, "chapter_id": 22454, "verse_number": "१-११६-९९", "content_sanskrit": "सम्पदः कथितं बीजमावयोर्भवता मुने ।\nत्वद्वक्त्रादुद्यता वाचो विज्ञाता हि द्विजोत्तम ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7002454099, "chapter_id": 22454, "verse_number": "१-११६-१००", "content_sanskrit": "न रत्नैर्न च वित्तौघैर्न च पुष्पानुलेपनैः ।\nआराध्यश्च जगन्नाथो भावशून्यैर्दिवाकरः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7002454100, "chapter_id": 22454, "verse_number": "१-११६-१०१", "content_sanskrit": "बाह्यार्थनिरपेक्षैश्च मनसैव मनोगतिः ।\nनिःस्वैराराध्यते देवो भानुः सर्वेश्वरेश्वरः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7002454101, "chapter_id": 22454, "verse_number": "१-११६-१०२", "content_sanskrit": "सर्वमेतन्मया ज्ञातं यत्त्वमात्थ महामुने ।\nयच्च पृच्छामि तन्मे त्वं प्रसादसुमुखो वद ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7002454102, "chapter_id": 22454, "verse_number": "१-११६-१०३", "content_sanskrit": "कथमाराधितो देवो नरैः स्त्रीभिश्च भास्करः ।\nतोषमायाति विप्रेन्द्र तद्वदस्व महामुने ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7002454103, "chapter_id": 22454, "verse_number": "१-११६-१०४", "content_sanskrit": "रहस्यानि च देवस्य प्रीतये या तिथिः सदा ।\nचान्यशेषाणि मे ब्रूहि अर्काराधनकांक्षिणः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7002454104, "chapter_id": 22454, "verse_number": "१-११६-१०५", "content_sanskrit": "परावसुरुवाच ।\nशृणु भूपाल यैर्भानुर्गृहेष्याराध्यते जनैः ।\nनारीभिश्चातिघोरेऽस्मिन्पतिताभिर्भवार्णवे ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7002454105, "chapter_id": 22454, "verse_number": "१-११६-१०६", "content_sanskrit": "समभ्यर्च्य जगन्नाथं देवमकं समाधिना ।\nएकमश्नाति यो भक्तं द्वितीयं ब्राह्मणार्पणम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7002454106, "chapter_id": 22454, "verse_number": "१-११६-१०७", "content_sanskrit": "करोति भास्करप्रीत्यै कार्त्तिकं मासमात्मना ।\nपूर्वे वयसि यत्नेन जानताऽजानतापि वा ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7002454107, "chapter_id": 22454, "verse_number": "१-११६-१०८", "content_sanskrit": "पापमाचरितं तस्माद्भिद्यते नात्र संशयः ।\nअनेनैव विधानेन मासि मार्गशिरे पुनः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7002454108, "chapter_id": 22454, "verse_number": "१-११६-१०९", "content_sanskrit": "समभ्यर्च्य मरकतं विप्रेभ्यो यः प्रयच्छति ।\nभगवत्प्रीणनार्थाय फलं तस्य शृणुष्व मे ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7002454109, "chapter_id": 22454, "verse_number": "१-११६-११०", "content_sanskrit": "मध्ये वयसि यत्पापं योषिता पुरुषेण वा ।\nकृतमस्माच्च तेनेक्तो विमोक्षः परमात्मना ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7002454110, "chapter_id": 22454, "verse_number": "१-११६-१११", "content_sanskrit": "तथा चैवेकभक्तं तु यस्तु विप्राय यच्छति ।\nदिवाकरं समभ्यर्च्य पौषे मासि महीपते ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7002454111, "chapter_id": 22454, "verse_number": "१-११६-११२", "content_sanskrit": "तत्तच्च प्रीणयत्यर्कं वार्धिकेनैव यत्कृतम् ।\nस तस्मान्मुच्यते राजन्पुमान्योषिदथापि वा ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7002454112, "chapter_id": 22454, "verse_number": "१-११६-११३", "content_sanskrit": "त्रिमासिकं व्रतमिदं यः करोति नरेश्वर ।\nस भानुप्रीणनात्पापैर्लघुभिः परिमुच्यते ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7002454113, "chapter_id": 22454, "verse_number": "१-११६-११४", "content_sanskrit": "द्वितीये वत्सरे राजन्मुच्यते चोपपातकैः ।\nतद्वत्तृतीयेऽपि कृतं महापातकनाशनम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7002454114, "chapter_id": 22454, "verse_number": "१-११६-११५", "content_sanskrit": "व्रतमेतन्नरैः स्त्रीभिस्त्रिभिर्मासैरनुष्ठितम् ।\nत्रिभिः संवत्सरैश्चैव प्रददाति फलं नृणाम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7002454115, "chapter_id": 22454, "verse_number": "१-११६-११६", "content_sanskrit": "त्रिभिर्मासैरनुष्ठानात्त्रिविधात्पातकान्नृप ।\nत्रीणि नामानि देवस्य मोचयन्ति च वार्षिकैः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7002454116, "chapter_id": 22454, "verse_number": "१-११६-११७", "content_sanskrit": "यतस्ततो व्रतमिदं विविधं समुदाहृतम् ।\nसर्वपापप्रशमनं भास्कराराधने परम् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7002454117, "chapter_id": 22454, "verse_number": "१-११६-११८", "content_sanskrit": "सत्राजित उवाच ।\nकतमाय तु विप्राय दातव्यं भक्तितो मुने ।\nद्वितीये द्विजशार्दूल कथयस्वाखिलं मम ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7002454118, "chapter_id": 22454, "verse_number": "१-११६-११९", "content_sanskrit": "परावसुरुवाच ।\nदेये पुराणविदुषे वस्त्रे विप्रोत्तमाय च ।\nश्रूयतां चापि वचनं यदुक्तं भास्करेण च ।\nअरुणाय महाबाहो पृच्छते यत्पुरा नृप ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7002454119, "chapter_id": 22454, "verse_number": "१-११६-१२०", "content_sanskrit": "उदयाचलमारूढं भास्करं तिमिरापहम् ।\nप्रणम्य शिरसा नूनमिदं वचनमब्रवीत् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7002454120, "chapter_id": 22454, "verse_number": "१-११६-१२१", "content_sanskrit": "कानि प्रियाणि ते देव पूजने सन्ति सर्वदा ।\nपुष्पादीनां समस्तानामाराधनविधौ सदा ।\nउपरागादिवस्त्रादौ ब्राह्मणानां तथा रवे ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7002454121, "chapter_id": 22454, "verse_number": "१-११६-१२२", "content_sanskrit": "भास्कर उवाच ।\nपुष्पाणां करवीराणि तथा रक्तं च चन्दनम् ।\nगुग्गुलञ्चापि धूपानां नैवेद्ये मोदकाः प्रियाः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7002454122, "chapter_id": 22454, "verse_number": "१-११६-१२३", "content_sanskrit": "पूजाकरो भोजकस्तु घृतदीपस्तथा प्रियः ।\nदानं प्रियं खगश्रेष्ठ वाचकाय प्रदीयते ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7002454123, "chapter_id": 22454, "verse_number": "१-११६-१२४", "content_sanskrit": "मामुद्दिश्य च यद्दानं दीयते मानवैर्भुवि ।\nवाचकाय१ तु दातव्यं तन्मम प्रीतये खग ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7002454124, "chapter_id": 22454, "verse_number": "१-११६-१२५", "content_sanskrit": "इतिहासपुराणाम्यामभिज्ञो यस्तु वाचकः ।\nब्राह्मणो वै खगश्रेष्ठ सम्पूज्यः प्रीतये मम ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7002454125, "chapter_id": 22454, "verse_number": "१-११६-१२६", "content_sanskrit": "पूजितेऽस्मिन्सदा विप्रे पूजितोहं न संशयः ।\nभवामि खगशार्दूल यतस्त्विष्टः स मे सदा ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7002454126, "chapter_id": 22454, "verse_number": "१-११६-१२७", "content_sanskrit": "वेदवीणामृदङ्गैश्च नातिगन्धविलेपनैः ।\nतथा मे जायते प्रीतिर्यथा श्रुत्वा खगोत्तम ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7002454127, "chapter_id": 22454, "verse_number": "१-११६-१२८", "content_sanskrit": "इतिहासपुराणानि वाच्यमानानि वाचकैः ।\nअतः प्रियो वाचको मे पूजाकर्ता च भोजकः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}]