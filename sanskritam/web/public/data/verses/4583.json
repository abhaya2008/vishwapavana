[{"id": 2166812, "chapter_id": 4583, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2166813, "chapter_id": 4583, "verse_number": "१", "content_sanskrit": "हते द्रोणे महेष्वासे तव पुत्रा महारथाः ।\nबभूवुरस्वस्थमुखा विषण्णा गतचेतसः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2166814, "chapter_id": 4583, "verse_number": "२", "content_sanskrit": "अवाङ्मुखाः शस्त्रभृतः सर्व एव विशाम्पते ।\nअवेक्षमाणाः शोकार्ता नाभ्यभाषन् परस्परम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2166815, "chapter_id": 4583, "verse_number": "३", "content_sanskrit": "तान् दृष्ट्वा व्यथिताकारान् सैन्यानि तव भारत ।\nऊर्ध्वमेव निरैक्षन्त दुःखतप्तान्यनेकशः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2166816, "chapter_id": 4583, "verse_number": "४", "content_sanskrit": "शस्त्राण्येषां तु राजेन्द्र शोणिताक्तानि सर्वशः ।\nप्राभ्रश्यन्त कराग्रेभ्यो दृष्ट्वा द्रोणं हतं युधि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2166817, "chapter_id": 4583, "verse_number": "५", "content_sanskrit": "तानि बद्धान्यरिष्टानि लम्बमानानि भारत ।\nअदृश्यन्त महाराज नक्षत्राणि यथा दिवि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2166818, "chapter_id": 4583, "verse_number": "६", "content_sanskrit": "तथा तु स्तिमितं दृष्ट्वा गतसत्वमवस्थितम् ।\nबलं तव महाराज राजा दुर्योधनोऽब्रवीत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2166819, "chapter_id": 4583, "verse_number": "७", "content_sanskrit": "भवतां बाहुवीर्यं हि समाश्रित्य मया युधि ।\nपाण्डवेयाः समाहूता युद्धं चेदं प्रवर्तितम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2166820, "chapter_id": 4583, "verse_number": "८", "content_sanskrit": "तदिदं निहते द्रोणे विषण्णमिव लक्ष्यते ।\nयुध्यमानाश्च समरे योधा वध्यन्ति सर्वशः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2166821, "chapter_id": 4583, "verse_number": "९", "content_sanskrit": "जयो वाऽपि वधो वाऽपि युध्यमानस्य संयुगे ।\nभवेत्किमत्र चित्रं वै युध्यध्वं सर्वतोमुखाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2166822, "chapter_id": 4583, "verse_number": "१०", "content_sanskrit": "पश्यध्वं च महात्मानं कर्णं वैकर्तनं युधि ।\nप्रचरन्तं महेष्वासं दिव्यैरस्त्रैर्महाबलम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2166823, "chapter_id": 4583, "verse_number": "११", "content_sanskrit": "यस्य वै युधि सन्त्रासात् कुन्तीपुत्रो धनञ्जयः ।\nनिवर्तते सदा मन्दः सिंहात् क्षुद्रमृगो यथा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2166824, "chapter_id": 4583, "verse_number": "१२", "content_sanskrit": "येन नागायुतप्राणो भीमसेनो महाबलः ।\nमानुषेणैव युद्धेन तामवस्थां प्रवेशितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2166825, "chapter_id": 4583, "verse_number": "१३", "content_sanskrit": "येन दिव्यास्त्रविच्छूरो मायावी स घटोत्कचः ।\nअमोघया रणे शक्त्या निहतो भैरवं नदन्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2166826, "chapter_id": 4583, "verse_number": "१४", "content_sanskrit": "तस्य दुर्वारवीर्यस्य सत्यसन्धस्य धीमतः ।\nबाह्वोर्द्रविणमक्षय्यमद्य द्रक्ष्यथ संयुगे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2166827, "chapter_id": 4583, "verse_number": "१५", "content_sanskrit": "द्रोणपुत्रस्य विक्रान्तं राधेयस्यैव चोभयोः ।\nपश्यन्तु पाण्डुपुत्रास्ते विष्णुवासवयोरिव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2166828, "chapter_id": 4583, "verse_number": "१६", "content_sanskrit": "सर्व एव भवन्तश्च शक्ताः प्रत्येकशोऽपि वा ।\nपाण्डुपुत्रान् रणे हन्तुं ससैन्यान् किमु संहताः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2166829, "chapter_id": 4583, "verse_number": "१७", "content_sanskrit": "वीर्यवन्तः कृतास्त्राश्च द्रक्ष्यथाद्य परस्परम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2166830, "chapter_id": 4583, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2166831, "chapter_id": 4583, "verse_number": "१८", "content_sanskrit": "एवमुक्त्वा ततः कर्णं चक्रे सेनापतिं तदा ।\nतव पुत्रो महावीर्यो भ्रातृभिः सहितोऽनघ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2166832, "chapter_id": 4583, "verse_number": "१९", "content_sanskrit": "सैनापत्यमथावाप्य कर्णो राजन् महारथः ।\nसिंहनादं विनद्योच्चैः प्रायुध्यत रणोत्कटः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2166833, "chapter_id": 4583, "verse_number": "२०", "content_sanskrit": "ससृञ्जयानां सर्वेषां पाञ्चालानां च पश्यताम् ।\nकेकयानां विदेहानां चकार कदनं महत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2166834, "chapter_id": 4583, "verse_number": "२१", "content_sanskrit": "तस्येषुधाराः शतशः प्रादुरासञ्छरासनात् ।\nअग्रे पुङ्खेषु संसक्ता यथा भ्रमरपङ्क्तयः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2166835, "chapter_id": 4583, "verse_number": "२२", "content_sanskrit": "स पीडयित्वा पाञ्चालान् पाण्डवांश्च तरस्विनः ।\nहत्वा सहस्रशो योधानर्जुनेन निपातितः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2166836, "chapter_id": 4583, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nतृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]