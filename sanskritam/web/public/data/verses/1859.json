[{"id": 2039175, "chapter_id": 1859, "verse_number": "५-१०४-०x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039176, "chapter_id": 1859, "verse_number": "५-१०४-१", "content_sanskrit": "मातलेर्वचनं श्रुत्वा नारदो मुनिसत्तमः।\nअब्रवीद्देवराजं तमार्यकं कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039177, "chapter_id": 1859, "verse_number": "५-१०४-२", "content_sanskrit": "सूतोऽयं मातलिर्नाम शक्रस्य दयितः सुहृत्।\nशुचिः शीलगुणोपेतस्तेजस्वी वीर्यवान्बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039178, "chapter_id": 1859, "verse_number": "५-१०४-३", "content_sanskrit": "शक्रस्यायं सखा चैव मन्त्री सारथिरेव च ।\nअल्पान्तरप्रभावश्च वासवेन रणे रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039179, "chapter_id": 1859, "verse_number": "५-१०४-४", "content_sanskrit": "अयं हरिसहस्रेण युक्तं जैत्रं रथोत्तमम् ।\nदेवासुरेषु युद्धेषु मनसैव नियच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039180, "chapter_id": 1859, "verse_number": "५-१०४-५", "content_sanskrit": "अनेन विजितानश्वैर्दोर्भ्यां जयति वासवः ।\nअनेन बलभित्पूर्वं प्रहृते प्रहरत्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039181, "chapter_id": 1859, "verse_number": "५-१०४-६", "content_sanskrit": "अस्य कन्या वरारोहा रूपेणासदृशी भुवि ।\nसत्यशीलगुणोपेता गुणकेशीति विश्रुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039182, "chapter_id": 1859, "verse_number": "५-१०४-७", "content_sanskrit": "तस्यास्य यत्नाच्चरतस्त्रैलोक्यममरद्युते।\nसुमुखो भवतः पौत्रो रोचते दुहितुः पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039183, "chapter_id": 1859, "verse_number": "५-१०४-८", "content_sanskrit": "यदि ते रोचते सम्यग्भुजगोत्तम मा चिरम् ।\nक्रियतामार्यक क्षिप्रं बुद्धिः कन्यापरिग्रहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039184, "chapter_id": 1859, "verse_number": "५-१०४-९", "content_sanskrit": "यथा विष्णुकुले लक्ष्मीर्यथा स्वाहा विभावसोः ।\nकुले तव तथैवास्तु गुणकेशी सुमध्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039185, "chapter_id": 1859, "verse_number": "५-१०४-१०", "content_sanskrit": "पौत्रस्यार्थे भवांस्तस्माद्गुणकेशीं प्रतीच्छतु ।\nसदृशीं प्रतिरूपस्य वासवस्य शचीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039186, "chapter_id": 1859, "verse_number": "५-१०४-११", "content_sanskrit": "पितृहीनमपि ह्येनं गुणतो वरयामहे।\nबहुमानाच्च भवतस्तथैवैरावतस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039187, "chapter_id": 1859, "verse_number": "५-१०४-१२", "content_sanskrit": "सुमुखस्य गुणैश्चैव शीलशौचदमादिभिः ।\nअभिगम्य स्वयं कन्यामयं दातुं समुद्यतः ।\nमातलिस्तस्य संमानं कर्तुमर्हो भवानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039188, "chapter_id": 1859, "verse_number": "५-१०४-१३x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039189, "chapter_id": 1859, "verse_number": "५-१०४-१३", "content_sanskrit": "स तु दीनः प्रहृष्टश्च प्राह नारदमार्यकः ।\nव्रियमाणे तथा पौत्रे पुत्रे च निधनं गते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039190, "chapter_id": 1859, "verse_number": "५-१०४-१४x", "content_sanskrit": "आर्यक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039191, "chapter_id": 1859, "verse_number": "५-१०४-१४", "content_sanskrit": "मन्ये नैतद्बहुमतं महर्षे वचनं तव।\nसखा शक्रस्य संयुक्तः कस्यायं नेप्सितो भवेत्।\nकारणस्य तु दौर्बल्याच्चिन्तयामि महामुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039192, "chapter_id": 1859, "verse_number": "५-१०४-१५", "content_sanskrit": "अस्य देहकरस्तात मम पुत्रो महाद्युते।\nभक्षितो वैनतेयेन दुःखार्तास्तेन वै वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039193, "chapter_id": 1859, "verse_number": "५-१०४-१६", "content_sanskrit": "पुनरेव च तेनोक्तं वैनतेयेन गच्छता ।\nमासेनान्येन सुमुखं भक्षयिष्य इति प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039194, "chapter_id": 1859, "verse_number": "५-१०४-१७", "content_sanskrit": "ध्रुवं तथा तद्भविता जानीमस्तस्य निश्चयम्।\nतेन हर्षः प्रनष्टो मे सुपर्णवचनेन वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039195, "chapter_id": 1859, "verse_number": "५-१०४-१८x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039196, "chapter_id": 1859, "verse_number": "५-१०४-१८", "content_sanskrit": "मातलिस्त्वब्रवीदेनं बुद्धिरत्र कृता मया।\nजामातृभावेन वृतः सुमुखस्तव पुत्रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039197, "chapter_id": 1859, "verse_number": "५-१०४-१९", "content_sanskrit": "सोऽयं मया च सहितो नारदेन च पन्नगः।\nत्रिलोकेशं सुरपतिं गत्वा पश्यतु वासवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039198, "chapter_id": 1859, "verse_number": "५-१०४-२०", "content_sanskrit": "शेषेणैवास्य कार्येण प्रज्ञास्वाम्यहमायुषः ।\nसुपर्णस्य विघाते च प्रयतिष्यामि सत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039199, "chapter_id": 1859, "verse_number": "५-१०४-२१", "content_sanskrit": "सुमुखश्च मया सार्धं देवेशमिगच्छतु।\nकार्यसंसाधनार्थाय स्वस्ति तेऽस्तु भुजङ्गम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039200, "chapter_id": 1859, "verse_number": "५-१०४-२२x", "content_sanskrit": "`कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039201, "chapter_id": 1859, "verse_number": "५-१०४-२२", "content_sanskrit": "आर्यकेणाभ्यनुज्ञाता गम्यतामिति भारत।\nततस्ते सुमुखं गृह्य सर्व एव महौजसः।\nददृशुः शक्रमासीनं देवराजं महाद्युतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2039202, "chapter_id": 1859, "verse_number": "५-१०४-२३", "content_sanskrit": "सङ्गत्या तत्र भगवान्विष्णुरासीच्चतुर्भुजः ।\nततस्तत्सर्वमाचख्यौ नारदो मातलिं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2039203, "chapter_id": 1859, "verse_number": "५-१०४-२४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2039204, "chapter_id": 1859, "verse_number": "५-१०४-२४", "content_sanskrit": "ततः पुरन्दरं विष्णुरुवाच भुवनेश्वरम्।\nअमृतं दीयतामस्मै क्रियताममरैः समः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2039205, "chapter_id": 1859, "verse_number": "५-१०४-२५", "content_sanskrit": "मातलिर्नारदश्चैव सुमुखश्चैव वासव।\nलभन्तां भवतः कामात्काममेतं यथेप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2039206, "chapter_id": 1859, "verse_number": "५-१०४-२६", "content_sanskrit": "पुरन्दरोऽथ संचिन्त्य वैनतेयपराक्रमम् ।\nविष्णुमेवाब्रवीदेनं भवानेव ददात्विति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2039207, "chapter_id": 1859, "verse_number": "५-१०४-२७x", "content_sanskrit": "विष्णुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2039208, "chapter_id": 1859, "verse_number": "५-१०४-२७", "content_sanskrit": "ईशस्त्वं सर्वलोकानां चराणामचराश्च ये।\nत्वया दत्तमदत्तं कः कर्तुमुत्सहते विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2039209, "chapter_id": 1859, "verse_number": "५-१०४-२८", "content_sanskrit": "प्रादाच्छक्रस्ततस्तस्मै पन्नगायायुरुत्तमम्।\nन त्वेनममृतप्राशं चकार बलवृत्रहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2039210, "chapter_id": 1859, "verse_number": "५-१०४-२९", "content_sanskrit": "लब्ध्वा वरं तु सुमुखः सुमुखः संबभूव ह।\nकृतदारो यथाकामं जगाम च गृहान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2039211, "chapter_id": 1859, "verse_number": "५-१०४-३०", "content_sanskrit": "नारदस्त्वार्यकश्चैव कृतकार्यौ मुदा युतौ ।\nअभिजग्मतुरभ्यर्च्य देवराजं महाद्युतिम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2039212, "chapter_id": 1859, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि चतुरधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]