[{"id": 7003873000, "chapter_id": 23873, "verse_number": "२-७-३-१", "content_sanskrit": "नारद उवाच ।\nयो मर्त्यो द्विजवर्याय पर्यंकं तु ददाति हि ।\nयत्र स्वस्थः सुखं शेते शीतानिलनिषेवितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003873001, "chapter_id": 23873, "verse_number": "२-७-३-२", "content_sanskrit": "धर्मसाधनभूते हि देहे नैरुज्यमाप्नुते ।\nतं दत्त्वा सकलं तापं निरस्य गतकल्मषः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003873002, "chapter_id": 23873, "verse_number": "२-७-३-३", "content_sanskrit": "अखण्डपदवीं याति योगिनामपि दुर्लभाम् ।\nवैशाखे घर्मतप्तानां श्रान्तानां तु द्विजन्मनाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003873003, "chapter_id": 23873, "verse_number": "२-७-३-४", "content_sanskrit": "दत्त्वा श्रमापहं दिव्यं पर्यंकं मनुजेश्वर ।\nन जातु सीदते लोके जन्ममृत्युजरादिभिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003873004, "chapter_id": 23873, "verse_number": "२-७-३-५", "content_sanskrit": "गृहीत्वा ब्राह्मणो यत्र शेते चाजीवमास्थितः ।\nआसीने सकलं पापं ज्ञानतोऽज्ञानतः कृतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003873005, "chapter_id": 23873, "verse_number": "२-७-३-६", "content_sanskrit": "विलयं याति राजेंद्र कर्पूर इव चाग्निना ।\nशयने ब्रह्मनिर्वाणं स नरो याति निश्चितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003873006, "chapter_id": 23873, "verse_number": "२-७-३-७", "content_sanskrit": "यो दद्यात्कशिपुं मासे वैशाखे स्नानवल्लभे ।\nसर्वभोगसमायुक्तस्तस्मिन्नेव हि जन्मनि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003873007, "chapter_id": 23873, "verse_number": "२-७-३-८", "content_sanskrit": "सान्वयो वर्तते नूनं रोगादिभिरनाहतः ।\nआयुष्यं परमारोग्यं यशो धैर्यं च विंदति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003873008, "chapter_id": 23873, "verse_number": "२-७-३-९", "content_sanskrit": "नाधार्मिकः कुले तस्य जायते शतपौरुषम् ।\nभुक्त्वा तु सकलान्भोगांस्ततः पञ्चत्वमेष्यति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003873009, "chapter_id": 23873, "verse_number": "२-७-३-१०", "content_sanskrit": "निर्धूताखिलपापस्तु ब्रह्मनिर्वाणमृच्छति॥ श्रो  ।\nत्रियाय द्विजेंद्राय यो दद्यादुपबर्हणम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003873010, "chapter_id": 23873, "verse_number": "२-७-३-११", "content_sanskrit": "सुखं निद्रा विना येन न नृणां जायते क्वचित् ।\nसर्वेषामाश्रयो भूत्वा भुवि साम्राज्यमश्नुते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003873011, "chapter_id": 23873, "verse_number": "२-७-३-१२", "content_sanskrit": "पुनः सुखी पुनर्भोगी पुनर्धर्मपरायणः ।\nआसप्तजन्म राजेंद्र जायते सर्वतो जयी ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003873012, "chapter_id": 23873, "verse_number": "२-७-३-१३", "content_sanskrit": "पश्चात्सप्तकुलैर्युक्तो ब्रह्मभूयाय कल्पते ।\nतार्णं कटं तु यो दद्यात्कटमन्यदथापि वा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003873013, "chapter_id": 23873, "verse_number": "२-७-३-१४", "content_sanskrit": "तत्र शेते स्वयं विष्णुर्यत्रस्थः परमेश्वरः ।\nयथा जलगता चोर्णा न जलैर्भिद्यते क्वचित् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003873014, "chapter_id": 23873, "verse_number": "२-७-३-१५", "content_sanskrit": "तथा संसारगो जन्तुः संसारे न च बध्यते ।\nआसने शयने सक्तः कटदः सर्वतः सुखी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003873015, "chapter_id": 23873, "verse_number": "२-७-३-१६", "content_sanskrit": "प्रश्रये शयनार्थाय यो दद्यात्कटकंबलम् ।\nतावन्मात्रेण मुक्तः स्यान्नात्र कार्या विचारणा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003873016, "chapter_id": 23873, "verse_number": "२-७-३-१७", "content_sanskrit": "निद्रया हीयते दुःखं निद्रया हीयते श्रमः ।\nसा निद्रा कटसंस्थस्य सुखं संजायते धुवम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003873017, "chapter_id": 23873, "verse_number": "२-७-३-१८", "content_sanskrit": "यो दयात्कंबलं राजन्वैशाखे माधवाऽगमे ।\nअपमृत्योः कालमृत्योर्मुक्तो जीवति वै शतम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003873018, "chapter_id": 23873, "verse_number": "२-७-३-१९", "content_sanskrit": "दद्याद्वस्त्रं सूक्ष्मतरं द्विजेंद्रे घर्मकर्शिते ।\nपूर्णमायुः समाप्नोति परत्र च परां गतिम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003873019, "chapter_id": 23873, "verse_number": "२-७-३-२०", "content_sanskrit": "अतस्तापहरं दिव्यं कर्पूरं तु द्विजातये ।\nदत्त्वा मोक्षमवाप्नोति दुःखशांतिं च विंदति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003873020, "chapter_id": 23873, "verse_number": "२-७-३-२१", "content_sanskrit": "कुसुमानि च यो दद्यात्कुकुमं च द्विजातये ।\nसार्वभौमो भवेद्राजा सर्वलोकवशंकरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003873021, "chapter_id": 23873, "verse_number": "२-७-३-२२", "content_sanskrit": "पुत्रपौत्रादिभोगांश्च भुक्त्वा मोक्षमवाप्नुयात् ।\nत्वगस्थिगतसंतापं सद्यो हरति चन्दनम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003873022, "chapter_id": 23873, "verse_number": "२-७-३-२३", "content_sanskrit": "तापत्रयविनिर्मुक्तस्तद्दत्त्वा मोक्षमाप्नुयात् ।\nऔशीरं चाषकं कौशं यो दद्याज्जलवासितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003873023, "chapter_id": 23873, "verse_number": "२-७-३-२४", "content_sanskrit": "सर्वभोगेषु राजेंद्र स तु देवसहायवान् ।\nपापहानिं दुःखहानिं प्राप्य निर्वृतिमाप्नुयात् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003873024, "chapter_id": 23873, "verse_number": "२-७-३-२५", "content_sanskrit": "गोरोचं मृगनाभिं च दद्याद्वैशाखधर्मवित् ।\nतापत्रयविनिर्मुक्तः परं निर्वाणमृच्छति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003873025, "chapter_id": 23873, "verse_number": "२-७-३-२६", "content_sanskrit": "तांबूलं च सकर्पूरं यो दद्यान्मेषगे रवौ ।\nसार्वभौमसुखं भुक्त्वा परं निर्वाणमृच्छति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003873026, "chapter_id": 23873, "verse_number": "२-७-३-२७", "content_sanskrit": "शतपत्रीं च यूथीं च मेषमासे ददन्नरः ।\nस सार्वभौमो भवति पश्चान्मोक्षं च विंदति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003873027, "chapter_id": 23873, "verse_number": "२-७-३-२८", "content_sanskrit": "केतकीं मल्लिकां वाऽपि यो दद्यान्माधवाऽगमे ।\nस तु मोक्षमवाप्नोति मधुशासनशासनात् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003873028, "chapter_id": 23873, "verse_number": "२-७-३-२९", "content_sanskrit": "पूगीफलं तु यो दद्यात्सुगन्धं तु द्विजातये ।\nनारिकेलफलं राजंस्तस्य पुण्यफलं शृणु ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003873029, "chapter_id": 23873, "verse_number": "२-७-३-३०", "content_sanskrit": "सप्त जन्म भवेद्विप्रो धनाढ्यो वेदपारगः ।\nपश्चात्सप्तकुलैर्युक्तो विष्णुलोकं स गच्छति ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003873030, "chapter_id": 23873, "verse_number": "२-७-३-३१", "content_sanskrit": "विश्राममण्डपं यस्तु कृत्वा दद्याद्द्विजन्मने ।\nतस्य पुण्यफलं वक्तुं नाहं शक्नोमि भूपते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003873031, "chapter_id": 23873, "verse_number": "२-७-३-३२", "content_sanskrit": "सुच्छायामण्डपं यस्तु सिकताऽकीर्णमञ्जसा ।\nसप्रपं कारयेद्यस्तु स तु लोकाधिपो भवेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003873032, "chapter_id": 23873, "verse_number": "२-७-३-३३", "content_sanskrit": "मार्गोद्यानं तडागं वा कूपं मण्डपमेव च ।\nयः करोति स धर्मात्मा तस्य पुत्रैस्तु किं फलम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003873033, "chapter_id": 23873, "verse_number": "२-७-३-३४", "content_sanskrit": "कूपस्तडागमुद्यानं मण्डपं च प्रपा तथा ।\nसद्धर्मकरणं पुत्रः संतानं सप्तधोच्यते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003873034, "chapter_id": 23873, "verse_number": "२-७-३-३५", "content_sanskrit": "एतेष्वन्यतमाभावे नोर्ध्वं गच्छंति मानवाः ।\nसच्छास्त्र श्रवणं तीर्थयात्रा सजनसंगतिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003873035, "chapter_id": 23873, "verse_number": "२-७-३-३६", "content_sanskrit": "जलदानं चान्नदानमश्वत्थारोपणं तथा ।\nपुत्रश्चेति च संतानं सप्तेमेऽतिविदो विदुः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003873036, "chapter_id": 23873, "verse_number": "२-७-३-३७", "content_sanskrit": "नासंततिर्लभेल्लोकान्कृत्वा धर्मशतान्यपि ।\nतस्मात्संतानमन्विच्छेत्संतानेष्वेकतो व्रजेत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003873037, "chapter_id": 23873, "verse_number": "२-७-३-३८", "content_sanskrit": "पशूनां पक्षिणां चैव मृगाणां चैव भूरुहाम् ।\nनोर्ध्वलोकं सुखं याति मनुष्याणां तु का कथा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003873038, "chapter_id": 23873, "verse_number": "२-७-३-३९", "content_sanskrit": "पूगीफलसमायुक्तं नागवल्लीदलैर्युतम् ।\nकपूरागुरुसंयुक्तं ददत्तांबूलमुत्तमम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003873039, "chapter_id": 23873, "verse_number": "२-७-३-४०", "content_sanskrit": "शारीरैः सकलैः पापैर्मुच्यते नात्र संशयः ।\nतांबूलदो यशो धैर्यं श्रियमाप्नोति निश्चितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003873040, "chapter_id": 23873, "verse_number": "२-७-३-४१", "content_sanskrit": "रोगी दत्त्वा विरोगः स्यादरोगी मोक्षमाप्नुयात् ।\nवैशाखे मासि यो दद्यात्तक्रं तापविनाशनम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003873041, "chapter_id": 23873, "verse_number": "२-७-३-४२", "content_sanskrit": "विद्यावान्धनवान्भूमौ जायते नात्र संशयः ।\nन तक्रसदृशं दानं घर्मकालेषु विद्यते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003873042, "chapter_id": 23873, "verse_number": "२-७-३-४३", "content_sanskrit": "तस्मात्तक्रं प्रदातव्यमध्वश्रांतद्विजातये ।\nजंबीरसुरसोपेतं लसल्लवणमिश्रितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003873043, "chapter_id": 23873, "verse_number": "२-७-३-४४", "content_sanskrit": "यस्तक्रमरुचिघ्नं तु दत्त्वा मोक्षमवाप्नुयात् ।\nयो दद्याद्दधिखंडं तु वैशाखे घर्मशांतये ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003873044, "chapter_id": 23873, "verse_number": "२-७-३-४५", "content_sanskrit": "तस्य पुण्यफलं वक्तुं नाहं शक्नोमि भूमिप ।\nयो दद्यात्तंडुलान्दिव्यान्मधुसूदनवल्लभे ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003873045, "chapter_id": 23873, "verse_number": "२-७-३-४६", "content_sanskrit": "स लभेत्पूर्णमायुष्यं सर्वयज्ञफलं लभेत् ।\nयो घृतं तेजसो रूपं गव्यं दद्याद्द्विजातये ।\nसोऽश्वमेधफलं प्राप्य मोदते विष्णुमंदिरे ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003873046, "chapter_id": 23873, "verse_number": "२-७-३-४७", "content_sanskrit": "उर्वारुगुडसंमिश्रं वैशाखे मेषगे रवौ ।\nसर्वपापविनिर्मुक्तः श्वेतद्वीपे वसेद्ध्रुवम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003873047, "chapter_id": 23873, "verse_number": "२-७-३-४८", "content_sanskrit": "यश्चेक्षुदंडं सायाह्ने दिवा तापोपशान्तये ।\nब्राह्मणाय च यो दद्यात्तस्य पुण्यमनंतकम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003873048, "chapter_id": 23873, "verse_number": "२-७-३-४९", "content_sanskrit": "वैशाखे पानकं दत्त्वा सायाह्ने श्रमशान्तये ।\nसर्वपापविनिर्मुक्तो विष्णोः सायुज्यमाप्नुयात् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003873049, "chapter_id": 23873, "verse_number": "२-७-३-५०", "content_sanskrit": "सफलं पानकं मेषमासे सायं द्विजातये ।\nदद्यात्तेन पितॄणां तु सुधापानं न संशयः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003873050, "chapter_id": 23873, "verse_number": "२-७-३-५१", "content_sanskrit": "वैशाखे पानकं चूतसुपक्वफलसंयुतम् ।\nतस्य सर्वाणि पापानि विनाशं यांति निश्चितम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003873051, "chapter_id": 23873, "verse_number": "२-७-३-५२", "content_sanskrit": "यो दद्याच्चैत्रदर्शे तु कुम्भं पूर्णं तु पानकैः ।\nगयाश्राद्धशतं तेन कृतमेव न संशयः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003873052, "chapter_id": 23873, "verse_number": "२-७-३-५३", "content_sanskrit": "कस्तूरी कर्पुरोपेतं मल्लिकोशीरसंयुतम् ।\nकलशं पानकैः पूर्णं चैत्रदर्शे तु मानवः ।\nदद्यात्पितॄन्समुद्दिश्य स षण्णवतिदो भवेत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]