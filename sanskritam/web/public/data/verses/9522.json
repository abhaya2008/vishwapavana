[{"id": 5000522000, "chapter_id": 9522, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे पञ्चदशाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000522001, "chapter_id": 9522, "verse_number": "६-११५-१", "content_sanskrit": "तां तु पार्श्वे स्थितां प्रह्वां रामः सम्प्रेक्ष्य मैथिलीम्।\nहृदयान्तर्गतं भावं व्याहर्तुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000522002, "chapter_id": 9522, "verse_number": "६-११५-२", "content_sanskrit": "एषासि निर्जिता भद्रे शत्रुं जित्वा रणाजिरे।\nपौरुषाद् यदनुष्ठेयं मयैतदुपपादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000522003, "chapter_id": 9522, "verse_number": "६-११५-३", "content_sanskrit": "गतोऽस्म्यन्तममर्षस्य धर्षणा सम्प्रमार्जिता।\nअवमानश्च शत्रुश्च युगपन्निहतौ मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000522004, "chapter_id": 9522, "verse_number": "६-११५-४", "content_sanskrit": "अद्य मे पौरुषं दृष्टमद्य मे सफलः श्रमः।\nअद्य तीर्णप्रतिज्ञोऽहं प्रभवाम्यद्य चात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000522005, "chapter_id": 9522, "verse_number": "६-११५-५", "content_sanskrit": "या त्वं विरहिता नीता चलचित्तेन रक्षसा।\nदैवसम्पादितो दोषो मानुषेण मया जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000522006, "chapter_id": 9522, "verse_number": "६-११५-६", "content_sanskrit": "सम्प्राप्तमवमानं यस्तेजसा न प्रमार्जति।\nकस्तस्य पौरुषेणार्थो महताप्यल्पचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000522007, "chapter_id": 9522, "verse_number": "६-११५-७", "content_sanskrit": "लङ्घनं च समुद्रस्य लङ्कायाश्चापि मर्दनम्।\nसफलं तस्य च श्लाघ्यमद्य कर्म हनूमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000522008, "chapter_id": 9522, "verse_number": "६-११५-८", "content_sanskrit": "युद्धे विक्रमतश्चैव हितं मन्त्रयतस्तथा।\nसुग्रीवस्य ससैन्यस्य सफलोऽद्य परिश्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000522009, "chapter_id": 9522, "verse_number": "६-११५-९", "content_sanskrit": "विभीषणस्य च तथा सफलोऽद्य परिश्रमः।\nविगुणं भ्रातरं त्यक्त्वा यो मां स्वयमुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000522010, "chapter_id": 9522, "verse_number": "६-११५-१०", "content_sanskrit": "इत्येवं वदतः श्रुत्वा सीता रामस्य तद् वचः।\nमृगीवोत्फुल्लनयना बभूवाश्रुपरिप्लुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000522011, "chapter_id": 9522, "verse_number": "६-११५-११", "content_sanskrit": "पश्यतस्तां तु रामस्य समीपे हृदयप्रियाम्।\nजनवादभयाद् राज्ञो बभूव हृदयं द्विधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000522012, "chapter_id": 9522, "verse_number": "६-११५-१२", "content_sanskrit": "सीतामुत्पलपत्राक्षीं नीलकुञ्चितमूर्धजाम्।\nअवदद् वै वरारोहां मध्ये वानररक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000522013, "chapter_id": 9522, "verse_number": "६-११५-१३", "content_sanskrit": "यत् कर्तव्यं मनुष्येण धर्षणां प्रतिमार्जता।\nतत् कृतं रावणं हत्वा मयेदं मानकांक्षिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000522014, "chapter_id": 9522, "verse_number": "६-११५-१४", "content_sanskrit": "निर्जिता जीवलोकस्य तपसा भावितात्मना।\nअगस्त्येन दुराधर्षा मुनिना दक्षिणेव दिक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000522015, "chapter_id": 9522, "verse_number": "६-११५-१५", "content_sanskrit": "विदितश्चास्तु भद्रं ते योऽयं रणपरिश्रमः।\nसुतीर्णः सुहृदां वीर्यान्न त्वदर्थं मया कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000522016, "chapter_id": 9522, "verse_number": "६-११५-१६", "content_sanskrit": "रक्षता तु मया वृत्तमपवादं च सर्वतः।\nप्रख्यातस्यात्मवंशस्य न्यङ्गं च परिमार्जता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000522017, "chapter_id": 9522, "verse_number": "६-११५-१७", "content_sanskrit": "प्राप्तचारित्रसंदेहा मम प्रतिमुखे स्थिता।\nदीपो नेत्रातुरस्येव प्रतिकूलासि मे दृढा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000522018, "chapter_id": 9522, "verse_number": "६-११५-१८", "content_sanskrit": "तद् गच्छ त्वानुजानेऽद्य यथेष्टं जनकात्मजे।\nएता दश दिशो भद्रे कार्यमस्ति न मे त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000522019, "chapter_id": 9522, "verse_number": "६-११५-१९", "content_sanskrit": "कः पुमांस्तु कुले जातः स्त्रियं परगृहोषिताम्।\nतेजस्वी पुनरादद्यात् सुहृल्लोभेन चेतसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000522020, "chapter_id": 9522, "verse_number": "६-११५-२०", "content_sanskrit": "रावणाङ्कपरिक्लिष्टां दृष्टां दुष्टेन चक्षुषा।\nकथं त्वां पुनरादद्यां कुलं व्यपदिशन्महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000522021, "chapter_id": 9522, "verse_number": "६-११५-२१", "content_sanskrit": "यदर्थं निर्जिता मे त्वं सोऽयमासादितो मया।\nनास्ति मे त्वय्यभिष्वङ्गो यथेष्टं गम्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000522022, "chapter_id": 9522, "verse_number": "६-११५-२२", "content_sanskrit": "तदद्य व्याहृतं भद्रे मयैतत् कृतबुद्धिना।\nलक्ष्मणे वाथ भरते कुरु बुद्धिं यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000522023, "chapter_id": 9522, "verse_number": "६-११५-२३", "content_sanskrit": "शत्रुघ्ने वाथ सुग्रीवे राक्षसे वा विभीषणे।\nनिवेशय मनः सीते यथा वा सुखमात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000522024, "chapter_id": 9522, "verse_number": "६-११५-२४", "content_sanskrit": "नहि त्वां रावणो दृष्ट्वा दिव्यरूपां मनोरमाम्।\nमर्षयेत चिरं सीते स्वगृहे पर्यवस्थिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000522025, "chapter_id": 9522, "verse_number": "६-११५-२५", "content_sanskrit": "ततः प्रियार्हश्रवणा तदप्रियं\nप्रियादुपश्रुत्य चिरस्य मानिनी।\nमुमोच बाष्पं रुदती तदा भृशं\nगजेन्द्रहस्ताभिहतेव वल्लरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000522026, "chapter_id": 9522, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे पञ्चदशाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]