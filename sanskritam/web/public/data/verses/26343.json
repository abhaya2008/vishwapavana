[{"id": 7006343000, "chapter_id": 26343, "verse_number": "१-५३-१", "content_sanskrit": "वैशम्पायन उवाच ते श्रुत्वा पृथिवीवाक्यं सर्व एव दिवौकसः ।\nतदर्थकृत्यं संचिन्त्य पितामहमथाब्रुवन् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006343001, "chapter_id": 26343, "verse_number": "१-५३-२", "content_sanskrit": "भगवन् ह्रियतामस्या धरण्या भारसंततिः ।\nशरीरकर्ता लोकानां त्वं हि लोकस्य चेश्वरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006343002, "chapter_id": 26343, "verse_number": "१-५३-३", "content_sanskrit": "यत् कर्तव्यं महेन्द्रेण यमेन वरुणेन च ।\nयद् वा कार्यं धनेशेन स्वयं नारायणेन वा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006343003, "chapter_id": 26343, "verse_number": "१-५३-४", "content_sanskrit": "यद् वा चन्द्रमसा कार्यं भास्करेणानिलेन वा ।\nआदित्यैर्वसुभिर्वापि रुद्रैर्वा लोकभावनैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006343004, "chapter_id": 26343, "verse_number": "१-५३-५", "content_sanskrit": "अश्विभ्यां देववैद्याभ्यां साध्यैर्वा त्रिदशालयैः ।\nबृहस्पत्युशनोभ्यां वा कालेन कलिनापि वा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006343005, "chapter_id": 26343, "verse_number": "१-५३-६", "content_sanskrit": "महेश्वरेण वा ब्रह्मन् विशाखेन गुहेन वा ।\nयक्षराक्षसगन्धर्वैश्चारणैर्वा महोरगैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006343006, "chapter_id": 26343, "verse_number": "१-५३-७", "content_sanskrit": "पतङ्गैः पर्वतैश्चापि सागरैर्वा महोर्मिभिः ।\nगङ्गामुखाभिर्दिव्याभिः सरिद्भिर्वा सुरेश्वर ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006343007, "chapter_id": 26343, "verse_number": "१-५३-८", "content_sanskrit": "शीघ्रमाज्ञापय विभो कथमंशः प्रयुज्यताम् ।\nयदि ते पार्थिवं कार्यं कार्यं पार्थिवविग्रहे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006343008, "chapter_id": 26343, "verse_number": "१-५३-९", "content_sanskrit": "कथमंशावतरणं कुर्मः सर्वे पितामह ।\nअन्तरिक्षगता ये च पृथिव्यां पार्थिवाश्च ये ॥९", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006343009, "chapter_id": 26343, "verse_number": "१-५३-१०", "content_sanskrit": "सदस्यानां च विप्राणां पार्थिवानां कुलेषु च ।\nअयोनिजाश्चैव तनूः सृजामो जगतीतले ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006343010, "chapter_id": 26343, "verse_number": "१-५३-११", "content_sanskrit": "सुराणामेककार्याणां श्रुत्वैतन्तिश्चितं मतम् ।\nदेवैः परिवृतः प्राह वाक्यं लोकपितामहः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006343011, "chapter_id": 26343, "verse_number": "१-५३-१२", "content_sanskrit": "रोचते मे सुरश्रेष्ठा युष्माकमपि निश्चयः ।\nसृजध्वं स्वशरीरांशांस्तेजसाऽऽत्मसमान्भुवि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006343012, "chapter_id": 26343, "verse_number": "१-५३-१३", "content_sanskrit": "सर्व एव सुरश्रेष्ठास्तेजोभिरवरोहत ।\nभावयन्तो भुवं देवीं लब्ध्वा त्रिभुवनश्रियम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006343013, "chapter_id": 26343, "verse_number": "१-५३-१४", "content_sanskrit": "पार्थिवे भारते वंशे पूर्वमेव विजानता ।\nपृथिव्यां सम्भ्रममिमं श्रूयतां यन्मया कृतम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006343014, "chapter_id": 26343, "verse_number": "१-५३-१५", "content_sanskrit": "समुद्रेऽहं पुरा पूर्वे वेलामासाद्य पश्चिमाम् ।\nआसं सार्धं तनूजेन कश्यपेन महात्मना ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006343015, "chapter_id": 26343, "verse_number": "१-५३-१६", "content_sanskrit": "कथाभिः पूर्ववृत्ताभिर्लोकवेदानुगामिभिः ।\nइतिवृत्तैश्च बहुभिः पुराणप्रभवैर्गुणैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006343016, "chapter_id": 26343, "verse_number": "१-५३-१७", "content_sanskrit": "कुर्वतस्तु कथास्तास्ताः समुद्रः सह गङ्गया ।\nसमीपमाजगामाशु युक्तस्तोयदमारुतैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006343017, "chapter_id": 26343, "verse_number": "१-५३-१८", "content_sanskrit": "स वीचिविषमा कुर्वन् गतिं वेगतरङ्गिणीम् ।\nयादोगणविचित्रेण सच्छन्नस्तोयवाससा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006343018, "chapter_id": 26343, "verse_number": "१-५३-१९", "content_sanskrit": "शङ्खमुक्तामलतनुः प्रवालमणिभूषणः ।\nयुक्तश्चन्द्रमसा पूर्णः साभ्रगम्भीरनिःस्वनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006343019, "chapter_id": 26343, "verse_number": "१-५३-२०", "content_sanskrit": "स मां परिभवन्नेव स्वां वेलां समतिक्रमन् ।\nक्लेदयामास चपलैर्लावणैरम्बुविस्रवैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006343020, "chapter_id": 26343, "verse_number": "१-५३-२१", "content_sanskrit": "तं च देशं व्यवसितः समुद्रोऽद्भिर्विमर्दितुम् ।\nउक्तः संरब्धया वाचा शान्तोऽसीति मया तदा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006343021, "chapter_id": 26343, "verse_number": "१-५३-२२", "content_sanskrit": "शान्तोऽसीत्युक्तमात्रस्तु तनुत्वं सागरो गतः ।\nसंहतोर्मितरङ्गौघः स्थितो राजश्रिया ज्वलन् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006343022, "chapter_id": 26343, "verse_number": "१-५३-२३", "content_sanskrit": "भूयश्चैव मया शप्तः समुद्रः सह गङ्गया ।\nसकारणां मतिं कृत्वा युष्माकं हितकाम्यया ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006343023, "chapter_id": 26343, "verse_number": "१-५३-२४", "content_sanskrit": "यस्मात् त्वं राजतुल्येन वपुषा समुपस्थितः ।\nगच्छार्णव महीपालो राजेव त्वं भविष्यसि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006343024, "chapter_id": 26343, "verse_number": "१-५३-२५", "content_sanskrit": "तत्रापि सहजां लीलां धारयन् स्वेन तेजसा ।\nभविष्यसि नृणां भर्ता भारतानां कुलोद्वहः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006343025, "chapter_id": 26343, "verse_number": "१-५३-२६", "content_sanskrit": "शान्तोऽसीति मयोक्तस्त्वं यच्चासि तनुतां गतः ।\nसुतनुर्यशसा लोके शान्तनुस्त्वं भविष्यसि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006343026, "chapter_id": 26343, "verse_number": "१-५३-२७", "content_sanskrit": "इयमप्यायतापाङ्गी गङ्गा सर्वाङ्गशोभना ।\nरूपिणी च सरिच्छ्रेष्ठा तत्र त्वामुपयास्यति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006343027, "chapter_id": 26343, "verse_number": "१-५३-२८", "content_sanskrit": "एवमुक्तस्तु मां क्षुब्धः सोऽभिवीक्ष्यार्णवोऽब्रवीत् ।\nमां प्रभो देवदेवानां किमर्थं शप्तवानसि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006343028, "chapter_id": 26343, "verse_number": "१-५३-२९", "content_sanskrit": "अहं तव विधेयात्मा त्वत्कृतस्त्वत्परायणः ।\nअशपोऽसदृशैर्वाक्यैरात्मजं मां किमात्मना ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006343029, "chapter_id": 26343, "verse_number": "१-५३-३०", "content_sanskrit": "भगवंस्त्वत्प्रसादेन वेगात् पर्वणि वर्धितः ।\nयद्यहं चलितो ब्रह्मन् कोऽत्र दोषो ममात्मनः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006343030, "chapter_id": 26343, "verse_number": "१-५३-३१", "content_sanskrit": "क्षिप्ताभिः पवनैरद्भिः स्पृष्टो यद्यसि पर्वणि ।\nअत्र मे किं नु भगवन् विद्यते शापकारणम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006343031, "chapter_id": 26343, "verse_number": "१-५३-३२", "content_sanskrit": "उद्धतैश्च महावातैः प्रवृद्धैश्च बलाहकैः ।\nपर्वणा चेन्दुयुक्तेन त्रिभिः क्षुब्धोऽस्मि कारणैः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006343032, "chapter_id": 26343, "verse_number": "१-५३-३३", "content_sanskrit": "एवं यद्यपराद्धोऽहं कारणैस्त्वत्प्रकल्पितैः ।\nक्षन्तुमर्हसि मे ब्रह्मञ्छापोऽयं विनिवर्त्यताम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006343033, "chapter_id": 26343, "verse_number": "१-५३-३४", "content_sanskrit": "एवं मयि निरालम्बे शापाच्छिथिलतां गते ।\nकारुण्यं कुरु देवेश प्रमाणं यद्यवेक्षसे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006343034, "chapter_id": 26343, "verse_number": "१-५३-३५", "content_sanskrit": "अस्यास्तु देवगङ्गाया गां गतायास्त्वदाज्ञया ।\nमम दोषात्  सदोषायाः प्रसादं कर्तुमर्हसि ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006343035, "chapter_id": 26343, "verse_number": "१-५३-३६", "content_sanskrit": "तमहं श्लक्ष्णया वाचा महार्णवमथाब्रवम् ।\nअकारणज्ञं देवानां त्रस्तं शापानलेन तम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006343036, "chapter_id": 26343, "verse_number": "१-५३-३७", "content_sanskrit": "शान्तिं व्रज न भेतव्यं प्रसन्नो ऽस्मि महोदधे ।\nशापेऽस्मिन् सरितां नाथ भविष्यं शृणु कारणम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006343037, "chapter_id": 26343, "verse_number": "१-५३-३८", "content_sanskrit": "त्वं गच्छ भारते वंशे स्वं देहं स्वेन तेजसा ।\nआधत्स्व सरितां नाथ त्यक्त्वेमां सागरीं तनुम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006343038, "chapter_id": 26343, "verse_number": "१-५३-३९", "content_sanskrit": "महोदधे महीपालस्तत्र राजश्रिया वृतः ।\nपालयंश्चतुरो वर्णान् रंस्यसे सलिलेश्वर ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006343039, "chapter_id": 26343, "verse_number": "१-५३-४०", "content_sanskrit": "इयं च ते सरिच्छ्रेष्ठा बिभ्रती रूपमुत्तमम् ।\nतत्कालं रमणीयाङ्गी गङ्गा परिचरिष्यति ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006343040, "chapter_id": 26343, "verse_number": "१-५३-४१", "content_sanskrit": "अनया सह जाह्नव्या मोदमानो ममाऽऽज्ञया ।\nइमं सलिलसंक्लंदं   विस्मरिष्यसि सागर ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006343041, "chapter_id": 26343, "verse_number": "१-५३-४२", "content_sanskrit": "त्वरता चैव कर्तव्यं त्वयेदं मम शासनम् ।\nप्राजापत्येन विधिना गङ्गया सह सागर ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006343042, "chapter_id": 26343, "verse_number": "१-५३-४३", "content_sanskrit": "वसवः प्रच्युताः स्वर्गात् प्रविष्टाश्च रसातलम् ।\nतेषामुत्पादनार्थाय त्वं मया विनियोजितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006343043, "chapter_id": 26343, "verse_number": "१-५३-४४", "content_sanskrit": "अष्टौ ताञ्जाह्नवी गर्भानपत्यार्थं दधात्वियम् ।\nविभावसोस्तुल्यगुणान्सुराणां प्रीतिवर्धनान् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006343044, "chapter_id": 26343, "verse_number": "१-५३-४५", "content_sanskrit": "उत्पाद्य त्वं वसूञ्छीघ्रं कृत्वा कुरुकुलं महत् ।\nप्रवेष्टासि तनुं त्यक्त्वा पुनः सागर सागरीम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006343045, "chapter_id": 26343, "verse_number": "१-५३-४६", "content_sanskrit": "एवमेतन्मया पूर्वं हितार्थं वः सुरोत्तमाः ।\nभविष्यं पश्यता भारं पृथिव्याः पार्थिवात्मकम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006343046, "chapter_id": 26343, "verse_number": "१-५३-४७", "content_sanskrit": "तदेष शान्तनोर्वंशः पृथिव्यां रोपितो मया ।\nवसवो ये च गङ्गायामुत्पन्नास्त्रिदिवौकसः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006343047, "chapter_id": 26343, "verse_number": "१-५३-४८", "content_sanskrit": "अद्यापि भुवि गाङ्गेयस्तत्रैव वसुरष्टमः ।\nसप्तेमे वसवः प्राप्ताः स एकः परिलम्बते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006343048, "chapter_id": 26343, "verse_number": "१-५३-४९", "content_sanskrit": "द्वितीयायां स सृष्टायां द्वितीया शान्तनोस्तनुः ।\nविचित्रवीर्यो द्युतिमानासीद् राजा प्रतापवान् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006343049, "chapter_id": 26343, "verse_number": "१-५३-५०", "content_sanskrit": "वैचित्रवीर्यौ द्वावेव पार्थिवौ भुवि साम्प्रतम् ।\nधृतराष्ट्रश्च पाण्डुश्च विख्यातौ पुरुषर्षभौ ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006343050, "chapter_id": 26343, "verse_number": "१-५३-५१", "content_sanskrit": "तत्र पाण्डोः श्रिया जुष्टे द्वे भार्ये सम्बभूवतुः ।\nशुभे कुन्ती च माद्री च देवयोषोपमे तु ते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006343051, "chapter_id": 26343, "verse_number": "१-५३-५२", "content_sanskrit": "धृतराष्ट्रस्य राज्ञस्तु भार्यैका तुल्यचारिणी ।\nगान्धारी भुवि विख्याता भर्तुर्नित्यं व्रते स्थिता॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006343052, "chapter_id": 26343, "verse_number": "१-५३-५३", "content_sanskrit": "तत्र वंशा विभज्यन्तां विपक्षाः पक्ष एव च ।\nपुत्राणां हि तयो राज्ञोर्भविता विग्रहो महान् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006343053, "chapter_id": 26343, "verse_number": "१-५३-५४", "content_sanskrit": "तेषां विमर्दे दायाद्ये नृपाणां भविता क्षयः ।\nयुगान्तप्रतिमं चैव भविष्यति महद् भयम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006343054, "chapter_id": 26343, "verse_number": "१-५३-५५", "content_sanskrit": "सबलेषु नरेन्द्रेषु शान्तयत्स्वितरेतरम् ।\nविविक्तपुरराष्ट्रौघा क्षितिः शैथिल्यमेष्यति ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006343055, "chapter_id": 26343, "verse_number": "१-५३-५६", "content_sanskrit": "द्वापरस्य युगस्यान्ते मया दृष्टं पुरातनम् ।\nक्षयं यास्यन्ति शस्त्रेण मानवैः सह पार्थिवाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006343056, "chapter_id": 26343, "verse_number": "१-५३-५७", "content_sanskrit": "तत्रावशिष्टान् मनुजान् सुप्तान् निशि  विचेतसः ।\nधक्ष्यते शङ्करस्यांशः पावकेनास्त्रतेजसा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006343057, "chapter_id": 26343, "verse_number": "१-५३-५८", "content_sanskrit": "अन्तकप्रतिमे तस्मिन् निवृत्ते क्रूरकर्मणि ।\nसमाप्तमिदमाख्यास्ये तृतीयं द्वापरं युगम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006343058, "chapter_id": 26343, "verse_number": "१-५३-५९", "content_sanskrit": "महेश्वरांशेऽपसृते ततो माहेश्वरं युगम् ।\nशिष्यं प्रवर्तते पश्चाद् युगं दारुणदर्शनम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006343059, "chapter_id": 26343, "verse_number": "१-५३-६०", "content_sanskrit": "अधर्मप्रायपुरुषं स्वल्पधर्मप्रतिग्रहम् ।\nउत्सन्नसत्यसंयोगं वर्धितानृतसंचयम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006343060, "chapter_id": 26343, "verse_number": "१-५३-६१", "content_sanskrit": "महेश्वरं कुमारं च द्वौ च देवौ समाश्रिताः ।\nभविष्यन्ति नराः सर्वे लोके न स्थविरायुषः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006343061, "chapter_id": 26343, "verse_number": "१-५३-६२", "content_sanskrit": "तदेष निर्णयः श्रेष्ठः पृथिव्यां पार्थिवान्तकः ।\nअंशावतरणं सर्वे सुराः कुरुत मा चिरम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006343062, "chapter_id": 26343, "verse_number": "१-५३-६३", "content_sanskrit": "धर्मस्यांशस्तु कुन्त्यां वै माद्रयां च विनियुज्यताम् ।\nविग्रहस्य कलिर्मूलं गान्धार्यां विनियुज्यताम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006343063, "chapter_id": 26343, "verse_number": "१-५३-६४", "content_sanskrit": "एतौ पक्षौ भविष्यन्ति राजानः कालचोदिताः ।\nजातरागाः पृथिव्यर्थे सर्वे संग्रामलालसाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006343064, "chapter_id": 26343, "verse_number": "१-५३-६५", "content_sanskrit": "गच्छत्वियं वसुमती स्वां योनिं लोकधारिणी ।\nसृष्टोऽयं नैष्ठिको राज्ञामुपायो लोकविश्रुतः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006343065, "chapter_id": 26343, "verse_number": "१-५३-६६", "content_sanskrit": "श्रुत्वा पितामहवचः सा जगाम यथागतम् ।\nपृथिवी सह कालेन वधाय पृथिवीक्षिताम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006343066, "chapter_id": 26343, "verse_number": "१-५३-६७", "content_sanskrit": "देवानचोदयद् ब्रह्मा निग्रहार्थे सुरद्विषाम् ।\nनरं चैव पुराणर्षि शेषं च धरणीधरम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006343067, "chapter_id": 26343, "verse_number": "१-५३-६८", "content_sanskrit": "सनत्कुमारं साध्यांश्च सुरांश्चाग्निपुरोगमान् ।\nवरुणं च यमं चैव सूर्याचन्द्रमसौ तदा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006343068, "chapter_id": 26343, "verse_number": "१-५३-६९", "content_sanskrit": "गन्धर्वाप्सरसश्चैव रुद्रादित्यांस्तथाश्विनौ ।\nततोंऽशानवनिं देवाः सर्व एवावतारयन् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006343069, "chapter_id": 26343, "verse_number": "१-५३-७०", "content_sanskrit": "यथा ते कथितं पूर्वमंशावतरणं मया ।\nअयोनिजा योनिजाश्च ते देवाः पृथिवीतले ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006343070, "chapter_id": 26343, "verse_number": "१-५३-७१", "content_sanskrit": "दैत्यदानवहन्तारः सम्भूताः पुरुषेश्वराः ।\nक्षीरिकावृक्षसंकाशा वज्रसंहननास्तथा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006343071, "chapter_id": 26343, "verse_number": "१-५३-७२", "content_sanskrit": "नागायुतबलाः केचित्केचिदोघबलान्विताः ।\nगदापरिघशक्तीनां सहाः परिघबाहवः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006343072, "chapter_id": 26343, "verse_number": "१-५३-७३", "content_sanskrit": "गिरिशृङ्गप्रहर्तारः सर्वे परिघयोधिनः ।\nवृष्णिवंशसमुत्पन्नाः शतशोऽथ सहस्रशः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006343073, "chapter_id": 26343, "verse_number": "१-५३-७४", "content_sanskrit": "कुरुवंशे च ते देवाः पञ्चालेषु च पार्थिवाः ।\nयाज्ञिकानां समृद्धानां ब्राह्मणानां च योनिषु ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006343074, "chapter_id": 26343, "verse_number": "१-५३-७५", "content_sanskrit": "सर्वास्त्रज्ञा महेष्वासा वेदव्रतपरायणाः ।\nसर्वर्द्धिगुणसम्पन्ना यज्वानः पुण्यकर्मिणः ॥।७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006343075, "chapter_id": 26343, "verse_number": "१-५३-७६", "content_sanskrit": "आचालयेयुर्ये शैलान् क्रुद्धा भिन्द्युर्महीतलम् ।\nउत्पतेयुरथाकाशं क्षोभयेयुर्महोदधिम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006343076, "chapter_id": 26343, "verse_number": "१-५३-७७", "content_sanskrit": "एवमादिश्य तान् सर्वान् भूतभव्यभवत्प्रभुः ।\nनारायणे समावेश्य लोकाञ्छान्तिमुपागमत्॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006343077, "chapter_id": 26343, "verse_number": "१-५३-७८", "content_sanskrit": "भूयः शृणु यथा विष्णुरवतीर्णो महीतले ।\nप्रजानां वै हितार्थाय प्रभुः प्राणिहितेश्वरः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006343078, "chapter_id": 26343, "verse_number": "१-५३-७९", "content_sanskrit": "ययातिवंशजस्याथ वसुदेवस्य धीमतः ।\nकुले पूज्ये यशस्कर्मा जज्ञे नारायणः प्रभुः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]