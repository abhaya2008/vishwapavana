[{"id": 2111787, "chapter_id": 3414, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2111788, "chapter_id": 3414, "verse_number": "१", "content_sanskrit": "अथान्तरिक्षे दुष्षन्तं वागुवाचाशरीरिणी ।\nऋत्विक्पुरोहिताचार्यैर्मन्त्रिभिश्चाभिसंवृतम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2111789, "chapter_id": 3414, "verse_number": "२", "content_sanskrit": "माता भस्त्रा पितुः पुत्रो यस्माज्जातः स एव सः ।\nभरस्व पुत्रं दुष्षन्त सत्यमाह शकुन्तला \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2111790, "chapter_id": 3414, "verse_number": "३", "content_sanskrit": "सर्वेभ्यो ह्मङ्गमङ्गेभ्यः साक्षादुत्पद्यते सुतः ।\nआत्मा चैष सुतो नाम तथैष तव पौरव \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2111791, "chapter_id": 3414, "verse_number": "४", "content_sanskrit": "आहितं ह्यात्मनाऽऽत्मानं परिरक्ष स्वमात्मजम् ।\nअनन्यां स्वां प्रतीक्षस्व मावमंस्थाः शकुन्तलाम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2111792, "chapter_id": 3414, "verse_number": "५", "content_sanskrit": "स्त्रियः पवित्रमतुलमेतद्दुष्षन्त धर्मतः ।\nमासि मासि रजो ह्यासां दुष्कृतान्यपकर्षति ।\nततः सर्वाणि भूतानि व्याजह्रुस्तं समन्ततः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2111793, "chapter_id": 3414, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2111794, "chapter_id": 3414, "verse_number": "६", "content_sanskrit": "आहितः स्वतनोरेष मावमंस्थाः शकुन्तलाम् ।\nरेतोधाः पुत्रं नयति नरदेव यमक्षयम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2111795, "chapter_id": 3414, "verse_number": "७", "content_sanskrit": "त्वं चास्य धाता गर्भस्य सत्यमाह शकुन्तला ।\nपतिर्जायां प्रविशति स तस्यां जायते पुनः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2111796, "chapter_id": 3414, "verse_number": "८", "content_sanskrit": "अन्योन्यप्रकृतिर्ह्येष मावमंस्थाः शकुन्तलाम् ।\nजाया जनयते पुत्रमात्मनोऽङ्गाद् द्विधा कृतम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2111797, "chapter_id": 3414, "verse_number": "९", "content_sanskrit": "तस्माद् भरस्व दुष्षन्त पुत्रं शाकुन्तलं नृप ।\nअभूतिरेषा न त्यजेत् जीवं जीवन्तमात्मजम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2111798, "chapter_id": 3414, "verse_number": "१०", "content_sanskrit": "शाकुन्तलं महात्मानं दुष्षन्त भर पौरव ।\nभर्तव्योऽयं त्वया यस्मादस्माकं वचनादपि \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2111799, "chapter_id": 3414, "verse_number": "११", "content_sanskrit": "तस्माद् भवत्वयं नाम्ना भरतो नाम ते सुतः ।\nभरताद् भारती कीर्तिर्येनेदं भारतं कुलम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2111800, "chapter_id": 3414, "verse_number": "१२", "content_sanskrit": "अपरे ये च पूर्वे च भारता इति ते स्मृताः ।\nएवमुक्त्वा ततो देवा ऋषयश्च तपोधनाः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2111801, "chapter_id": 3414, "verse_number": "१३", "content_sanskrit": "पतिव्रतेति संहृष्टाः पुष्पवर्षं ववर्षिरे ।\nतच्छ्रुत्वा पौरवो वाक्यं व्याहृतं वै दिवौकसाम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2111802, "chapter_id": 3414, "verse_number": "१४", "content_sanskrit": "सिंहासनात् समुत्थाय प्रणम्य च दिवौकसः ।\nपुरोहितममात्यांश्च सम्प्रहृष्टोऽब्रवीदिदम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2111803, "chapter_id": 3414, "verse_number": "१५", "content_sanskrit": "शृण्वन्त्वेतद् भवन्तोऽद्य देवदूतस्य भाषितम् ।\nशृण्वन्तु देवतानां च महर्षीणां च भाषितम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2111804, "chapter_id": 3414, "verse_number": "१६", "content_sanskrit": "अहमप्येवमेवैनं जानामि सुतमात्मजम् ।\nयद्यस्य वचनादेव गृह्णीयामिममात्मजम् ।\nभवेद्धि शङ्का लोकस्य नैवं शुद्धो भवेदयम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2111805, "chapter_id": 3414, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2111806, "chapter_id": 3414, "verse_number": "१७", "content_sanskrit": "तं विशोध्य महाराजा दैवतैः समहर्षिभिः ।\nहृष्टः प्रमुदितश्चापि प्रतिजग्राह तं सुतम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2111807, "chapter_id": 3414, "verse_number": "१९", "content_sanskrit": "मूर्ध्नि चैनं समाघ्राय सस्नेहं परिषस्वजे ।\nसभाज्यमानो विप्रैश्च स्तूयमानश्च बन्दिभिः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2111808, "chapter_id": 3414, "verse_number": "२०", "content_sanskrit": "मुदं स परमां लेभे पुत्रस्पर्शनजां नृपः ।\nतां चैव भार्यां धर्मज्ञः पूजयामास धर्मतः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2111809, "chapter_id": 3414, "verse_number": "२१", "content_sanskrit": "अब्रवीच्चैव तां राजा सान्त्वपूर्वमिदं वचः ।\nलोकस्यायं परोक्षस्तु सम्बन्धो नौ पुराऽभवत् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2111810, "chapter_id": 3414, "verse_number": "२२", "content_sanskrit": "कृतो लोकसमक्षोऽद्य सम्बन्धो वै पुरा कृतः ।\nतस्मादेतन्मया त्वद्य तन्निमित्तं प्रभाषितम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2111811, "chapter_id": 3414, "verse_number": "२३", "content_sanskrit": "शङ्केत वाऽथ लोकोऽयं स्त्रीभावान्मयि सङ्गताम् ।\nतस्मादेतन्मया देवि तच्छुद्ध्यर्थं विचारितम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2111812, "chapter_id": 3414, "verse_number": "२४", "content_sanskrit": "व्राह्मणाः क्षत्रिया वैश्याः शूद्राश्चैव पृथग्विधाः ।\nत्वां देवि पूजयिष्यन्ति निर्विशङ्कं पतिव्रताम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2111813, "chapter_id": 3414, "verse_number": "२५", "content_sanskrit": "पुत्रश्चायं वृतो राज्ये त्वमग्रमहिषी मम ।\nयच्च कोपितयाऽत्यर्थं त्वयोक्तोऽस्म्यप्रियं प्रिये \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2111814, "chapter_id": 3414, "verse_number": "२६", "content_sanskrit": "प्रणयिन्या विशालाक्षि तत् क्षन्तव्यं मया शुभे ।\nअनृतं वाप्यनिष्टं वा दुरुक्तं वापि दुष्कृतम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2111815, "chapter_id": 3414, "verse_number": "२७", "content_sanskrit": "त्वयाप्येवं विशालाक्षि क्षन्तव्यं मम दुर्वचः ।\nक्षम्याः पतिकृते नार्यः पातिव्रत्यं व्रजन्ति ताः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2111816, "chapter_id": 3414, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2111817, "chapter_id": 3414, "verse_number": "२८", "content_sanskrit": "तामेवमुक्त्वा राजर्षिस्तामनिन्दितगामिनीम् ।\nअन्तःपुरं प्रवेश्यैव दुष्षन्तो महिषीं प्रियाम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2111818, "chapter_id": 3414, "verse_number": "२९", "content_sanskrit": "वासोभिरन्नपानैश्च पूजयित्वा तु भारत ।\nस मातरमुपस्थाय रथन्तर्यामुवाच ह\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2111819, "chapter_id": 3414, "verse_number": "३०", "content_sanskrit": "मम पुत्रो वने जातस्तव शोकप्रणाशनः ।\nऋणादद्य विमुक्तोऽहमस्मि पौत्रेण ते शुभे \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2111820, "chapter_id": 3414, "verse_number": "३१", "content_sanskrit": "विश्वामित्रसुता चेयं कण्वेन च विवर्धिता ।\nस्नुषा तव महाभागे प्रसीदस्व शकुन्तलाम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2111821, "chapter_id": 3414, "verse_number": "३२", "content_sanskrit": "पुत्रस्य वचनं श्रुत्वा पौत्रं सा परिषस्वजे ।\nपादयोः पतितां तत्र रथन्तर्या शकुन्तलाम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2111822, "chapter_id": 3414, "verse_number": "३३", "content_sanskrit": "परिष्वज्य च बाहुभ्यां हर्षादश्रूण्यवर्तयत् ।\nउवाच वचनं सत्यं लक्षयन् लक्षणानि च\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2111823, "chapter_id": 3414, "verse_number": "३४", "content_sanskrit": "तव पुत्रो विशालाक्षि चक्रवर्ती भविष्यति ।\nभर्ता ते च महाभागे त्रैलोक्यविजयी भवेत्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2111824, "chapter_id": 3414, "verse_number": "३५", "content_sanskrit": "दिव्यान् भोगाननुप्राप्ता भव त्वं वरवर्णिनि ।\nएवमुक्ता रथन्तर्या परं र्ह्षमवाप सा \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2111825, "chapter_id": 3414, "verse_number": "३६", "content_sanskrit": "शकुन्तलां तदा राजा शास्त्रोक्तेनैव कर्मणा ।\nततोऽग्रमहिषीं कृत्वा सर्वाभरणभूषिताम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2111826, "chapter_id": 3414, "verse_number": "३७", "content_sanskrit": "ब्राह्मणेभ्यो धनं दत्त्वा सैनिकानां च भूमिपः ।\nदौष्षन्तिं च ततो राजा पुत्रं शाकुन्तलं तदा \t॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2111827, "chapter_id": 3414, "verse_number": "३८", "content_sanskrit": "भरतं नामतः कृत्वा यौवराज्येऽभ्यषेचयत् ।\nभरते भारमावेश्य कृतकृत्योऽभवन्नृपः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2111828, "chapter_id": 3414, "verse_number": "३९", "content_sanskrit": "ततो वर्षशतं पूर्णं राज्यं कृत्वा नराघिपः ।\nदत्वा दानानि दुष्षन्तः स्वर्गलोकमुपेयिवान्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2111829, "chapter_id": 3414, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2111830, "chapter_id": 3414, "verse_number": "४०", "content_sanskrit": "दुष्षन्ताद् भरतो राज्यं यथान्यायमवाप सः ।\nतस्य तत्प्रथितं चक्रं प्रावर्तत महात्मनः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2111831, "chapter_id": 3414, "verse_number": "४१", "content_sanskrit": "भास्वरं दिव्यमजितं लोकसन्नादनं महत् ।\nस विजित्य महीपालांश्चकार वशवर्तिनः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2111832, "chapter_id": 3414, "verse_number": "४२", "content_sanskrit": "स चचार सतां धर्मं प्राप्य चानुत्तमं यशः ।\nस राजा चक्रवर्त्यासीत् सार्वभौमः प्रतापवान्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2111833, "chapter_id": 3414, "verse_number": "४३", "content_sanskrit": "ईजे च बहुभिर्यज्ञैर्यथा शक्रो मरुत्पतिः ।\nयाजयामास तं कण्वो दक्षवद् भूरिदक्षिणम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2111834, "chapter_id": 3414, "verse_number": "४४", "content_sanskrit": "श्रीमान् गोविततं नाम वाजिमेधमवाप सः ।\nयस्मिन् सहस्रं पद्मानां कण्वाय भरतो ददौ \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2111835, "chapter_id": 3414, "verse_number": "४५", "content_sanskrit": "सोऽश्वमेधशतैरीजे यमुनामनु तीरगः ।\nत्रिशतैश्च च सरस्वत्यां गङ्गायामयजच्छतैः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2111836, "chapter_id": 3414, "verse_number": "४६", "content_sanskrit": "दौष्षन्तिर्भरतो विद्वान् यज्ञैः शाकुन्तलो नृपः ।\nतस्माद् भरतवंशस्य विप्रतस्थे महद्यशः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2111837, "chapter_id": 3414, "verse_number": "४७", "content_sanskrit": "भरतस्य वरस्रीषु पुत्राः सञ्जज्ञिरे पृथक् ।\nनाभ्यनन्दत् तदा राजा नानुरूपा ममेति तान्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2111838, "chapter_id": 3414, "verse_number": "४८", "content_sanskrit": "ततो महद्भिः क्रतुभिरीजानो भरतस्तदा ।\nलेभे पुत्रं भरद्वाजाद् भुमन्युं नाम भारत \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2111839, "chapter_id": 3414, "verse_number": "४९", "content_sanskrit": "धर्मे प्रणिहितात्मानं मत्वा तं पुरुषोत्तमम् ।\nततः पुत्रिणमात्मानं मत्वा स कुरुपुङ्गव \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2111840, "chapter_id": 3414, "verse_number": "५०", "content_sanskrit": "भुमन्युं भरतः प्रीतो यौवराज्येऽभ्यषेचयत् ।\nततस्तस्य महीन्द्रस्य वितथं पुत्रतोऽभवत् \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2111841, "chapter_id": 3414, "verse_number": "५१", "content_sanskrit": "ततः स वितथो नाम भुमन्योरभवत् तदा ।\nसुहोत्रश्रुतहोतारौ सुहविः सुयजुस्तथा\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2111842, "chapter_id": 3414, "verse_number": "५२", "content_sanskrit": "पुष्करिण्यामुचथ्यायां भुमन्योरभवन् सुताः ।\nचत्वारो भारते वंशे सुहोत्रस्तस्य वंशभाक्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2111843, "chapter_id": 3414, "verse_number": "५३", "content_sanskrit": "तेषां ज्येष्ठः सुहोत्रस्तु राज्यं प्राप्य महीक्षिताम् ।\nराजसूयाश्वमेधाद्यैरीजे च विविधैर्मखैः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2111844, "chapter_id": 3414, "verse_number": "५४", "content_sanskrit": "सुहोत्रः पृथिवीं चेमां बुभुजे सागारम्बराम् ।\nसुहोत्रे तु महीपाले महीं धर्मेण शासति\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2111845, "chapter_id": 3414, "verse_number": "५५", "content_sanskrit": "चैत्ययूपाङ्किता भूमिर्बभूवाथ समन्ततः ।\nपूर्णा हस्तिगवां चैव नानारत्नसमाकुला \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2111846, "chapter_id": 3414, "verse_number": "५६", "content_sanskrit": "सा ममज्जेव पृथिवी भूरिभारावपीडिता ।\nहस्त्यश्वरथसम्पूर्णा मनुष्यकलिला भृशम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2111847, "chapter_id": 3414, "verse_number": "५७", "content_sanskrit": "समृद्धसस्यसम्पूर्णा सहदेवा व्यरोचत ।\nऐक्ष्वाक्यां जनयामास सुहोत्रस्त्रीन् सुतान् नृप \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2111848, "chapter_id": 3414, "verse_number": "५८", "content_sanskrit": "अजमीढं सदामीढं पुरुमीढं च भारत ।\nअजमीढो वरस्तेषां तस्मिन् वंशः प्रतिष्ठितः \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2111849, "chapter_id": 3414, "verse_number": "५९", "content_sanskrit": "षट् पुत्रान् सोऽप्यजनयत् तिसृषु स्त्रीषु भारत ।\nऋक्षं धूमिन्यथो नीली दुष्षन्तपरमेष्ठिनौ \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2111850, "chapter_id": 3414, "verse_number": "६०", "content_sanskrit": "केशिन्यजनयज्जह्नुमुभौ च जन रूषणम् ।\nविदुः संवरणं शूरमृक्षाद् राथन्तरीसुतम् \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2111851, "chapter_id": 3414, "verse_number": "६१", "content_sanskrit": "तथेमे सर्वपाञ्चाला दुष्षन्तपरमेष्ठिनोः ।\nअन्वयाः कौशिकाः सर्वे जन्होरपि महात्मनः \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2111852, "chapter_id": 3414, "verse_number": "६२", "content_sanskrit": "जन्हुरूषणयोर्ज्येष्ठमृक्षमाहुर्जनाधिपम् ।\nऋक्षात् संवरणो जज्ञे राजन् वंशकरस्तव \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2111853, "chapter_id": 3414, "verse_number": "६३", "content_sanskrit": "आर्क्षे संवरणे राज्यं प्रशासति महात्मनि ।\nसङ्क्षयः सुमहानासीत् प्रजानामिति शुश्रुमः \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2111854, "chapter_id": 3414, "verse_number": "६४", "content_sanskrit": "व्यशीर्यत ततो राष्ट्रं दुर्भिक्षेणार्दितं तदा ।\nक्षुन्मृत्युभ्यामनावृष्ट्या व्याधिभिश्च महाबलैः \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2111855, "chapter_id": 3414, "verse_number": "६५", "content_sanskrit": "अभ्ययुर्भरताश्चैव सपत्नानां बलानि च ।\nचालयन्तो धृतिं भीमां जनयन्तो भृशं भयम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2111856, "chapter_id": 3414, "verse_number": "६६", "content_sanskrit": "अभ्ययुस्तं च पाञ्चाला विवृण्वन्तो बलैर्महीम् ।\nअक्षोहिणीभिर्दशभिस्तदा तं तरसाऽजयन्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2111857, "chapter_id": 3414, "verse_number": "६७", "content_sanskrit": "ततः सदारः सामात्यः सपुत्रः ससुहृज्जनः ।\nराजा संवरणस्तस्मात् पलायनपरोऽभवत्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2111858, "chapter_id": 3414, "verse_number": "६८", "content_sanskrit": "तां प्रतीचीं दिशं भीताः प्रयाताः भरताः किल ।\nसिन्धोर्नदस्य महतो गुहायां प्राविशंस्तदा\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2111859, "chapter_id": 3414, "verse_number": "६९", "content_sanskrit": "शिवे विषयपर्यन्ते पर्वतस्य समीपतः ।\nतत्रावसन् प्रतिच्छन्ना भरताश्च भयाच्चिरम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2111860, "chapter_id": 3414, "verse_number": "७०", "content_sanskrit": "तेषां निवसतां तत्र सहस्रं परिवत्सरान् ।\nआगच्छद् भगवांस्तत्र वसिष्ठो भरतान् प्रति \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2111861, "chapter_id": 3414, "verse_number": "७१", "content_sanskrit": "तमागतं प्रयत्नेन अभ्युत्थायाभिवाद्य च ।\nअर्घ्यमस्यानयन् प्रीत्या अजमीढपुरोगमाः \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2111862, "chapter_id": 3414, "verse_number": "७२", "content_sanskrit": "निवेद्य सर्वं भरताः सत्कृत्यैनमुपासत ।\nततः संवरणश्चेष्टं वरं वव्रे स्वयं तदा\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2111863, "chapter_id": 3414, "verse_number": "७३", "content_sanskrit": "पुरोहितो भवान् नोऽस्तु राज्याय प्रयतामहे ।\nएवमस्त्विति तं विप्रो भारतं प्रत्युवाच ह \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2111864, "chapter_id": 3414, "verse_number": "७४", "content_sanskrit": "तमभ्यषिञ्चत् साम्राज्ये सर्वक्षत्रस्य पौरवम् ।\nविषाणभूतं सर्वस्य पृथिव्यामिति नः श्रुतम्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2111865, "chapter_id": 3414, "verse_number": "७५", "content_sanskrit": "स पुत्रैर्भारतैर्जुष्टमध्यतिष्ठत् पुरातनम् ।\nपुनश्चक्रे बलिभृतः पृथिव्यां सर्वपार्थिवान् \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2111866, "chapter_id": 3414, "verse_number": "७६", "content_sanskrit": "अजमीढो महायज्ञैर्बहुभिर्भूरिदक्षिणैः ।\nभारतः पृथिवीं प्राप्य पुनरीजे महाबलः \t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2111867, "chapter_id": 3414, "verse_number": "७७", "content_sanskrit": "ततः संवरणात् सौरी तपती सुषुवे कुरुम् ।\nराजत्वे तं प्रजाः सर्वा धर्मज्ञ इति वव्रिरे \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2111868, "chapter_id": 3414, "verse_number": "७८", "content_sanskrit": "महिम्ना तस्य कुरवो लेभिरे प्रत्ययं भृशम् ।\nतस्य नाम्ना च विख्यातमभूत्तत् कुरुजाङ्गलम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2111869, "chapter_id": 3414, "verse_number": "७९", "content_sanskrit": "कुरुक्षेत्रं च तपसा पुण्यं चक्रे महातपाः ।\nअश्ववन्तमभीष्वन्तं दान्तं चित्ररथं मुनिम् \t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2111870, "chapter_id": 3414, "verse_number": "८०", "content_sanskrit": "जनमेजयं स विख्यातं पुत्रांश्चास्यानुशुश्रुमः ।\nपञ्चैतान् महिषी पुत्रान् व्यजायत मनस्विनी \t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2111871, "chapter_id": 3414, "verse_number": "८१", "content_sanskrit": "अभीश्वतः परीक्षिच्च शबलाश्वश्च वीर्यवान् ।\nअधिराजो विराजश्च बलवांश्च महाबलः \t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2111872, "chapter_id": 3414, "verse_number": "८२", "content_sanskrit": "चित्रश्रवा धर्मकरो दित्वाष्टिश्चाष्टमः स्मृतः ।\nशबलाश्वादयः सप्त तथैवान्ये महाबलाः \t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2111873, "chapter_id": 3414, "verse_number": "८३", "content_sanskrit": "न तेषामन्वयः ख्यातः सर्वेषां नामतो गुणैः ।\nजनमेजयादयः सप्त तथैवान्ये महारथाः \t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2111874, "chapter_id": 3414, "verse_number": "८४", "content_sanskrit": "परीक्षितोऽभवन् पुत्राः सर्वे धर्मार्थकोविदाः ।\nकक्षसेनोग्रसेनौ तु चित्रसेनस्तथा शिशुः \t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2111875, "chapter_id": 3414, "verse_number": "८५", "content_sanskrit": "इन्द्रसेनः सुषेणश्च भीमसेनश्च नामतः ।\nजनमेजयस्य तनयास्तथा चाष्टौ महाबलाः \t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2111876, "chapter_id": 3414, "verse_number": "८६", "content_sanskrit": "धृतराष्ट्रश्च धर्मात्मा तथोभौ पाण्डुबाह्लिकौ ।\nनिषधश्च महातेजास्तथा जाम्बूनदो बली \t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2111877, "chapter_id": 3414, "verse_number": "८७", "content_sanskrit": "कुण्डोदरः पदातिश्च वसतिश्चाष्टमः स्मृतः ।\nसर्वे धर्मार्थकुशलाः सर्वभूतहिते रताः \t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2111878, "chapter_id": 3414, "verse_number": "८८", "content_sanskrit": "धृतराष्ट्रोऽधि राजाऽभूत् तस्य पुत्रोऽथ शुण्डिकः ।\nहस्ती विकत्थनः क्रथः कुण्डलश्चापि पञ्चमः \t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2111879, "chapter_id": 3414, "verse_number": "८९", "content_sanskrit": "पर्यश्रवसमिन्द्राभं शरभं वाजिनं युधि ।\nअतिनारश्च नहुषः तथा शुकपुरञ्चयौ \t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2111880, "chapter_id": 3414, "verse_number": "९०", "content_sanskrit": "ततो धर्मभृतां श्रेष्ठः पर्यश्रवस उच्यते ।\nऋषिं पुण्यकृतां श्रेष्ठं तमेव परमं विदुः \t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2111881, "chapter_id": 3414, "verse_number": "९१", "content_sanskrit": "भीमसेनान्महेष्वासात् प्रतीपः समपद्यत ।\nप्रतीपस्य त्रयः पुत्रा जज्ञिरे भरतर्षम ।\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2111882, "chapter_id": 3414, "verse_number": "९२", "content_sanskrit": "देवापिः शन्तनुश्चैव बाह्लीकश्च महायशाः ।\nदेवापिस्तु प्रवव्राज तेषां धर्मपरायणः \t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2111883, "chapter_id": 3414, "verse_number": "९३", "content_sanskrit": "शन्तनुश्च महीं लेभे बाह्लीकश्च महाबलः ।\nभरतस्यान्वये राजन् सत्त्ववन्तो महारथाः \t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2111884, "chapter_id": 3414, "verse_number": "९४", "content_sanskrit": "बभूवुर्ब्रह्मकल्पाश्च बहवो राजसत्तमाः ।\nएवंविधाऽश्चाप्यपरे देवकल्पा महारथाः\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2111885, "chapter_id": 3414, "verse_number": "९५", "content_sanskrit": "अन्ववाये महाराज ऐलवंशविवर्धनाः ।\nगङ्गाद्वारं समासाद्य दीक्षितो जनमेजय\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2111886, "chapter_id": 3414, "verse_number": "९६", "content_sanskrit": "अश्वमेधसहस्राणि वाजपेयशतानि च ।\nपुनरीजे महायज्ञैः समाप्तवरदक्षिणैः \t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2111887, "chapter_id": 3414, "verse_number": "९७", "content_sanskrit": "अग्निष्टोमातिरात्राणां मुख्यानां सोऽयजत् पुनः ।\nबाजपेयेष्टिसत्राणां सहस्रैश्च सुसम्भृतैः\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2111888, "chapter_id": 3414, "verse_number": "९८", "content_sanskrit": "इष्ट्वा शाकुन्तलो राजा तर्पयित्वा द्विजान् धनैः ।\nपुनः सहस्रं पद्मानां कण्वाय भरतो ददौ \t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2111889, "chapter_id": 3414, "verse_number": "९९", "content_sanskrit": "जाम्बूनदस्य शुद्धस्य कनकस्य महायशाः ।\nयस्य यूपाः शतव्यामाः परिणाहेऽथ काञ्चनाः \t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2111890, "chapter_id": 3414, "verse_number": "१००", "content_sanskrit": "सहस्रव्याममुद्विद्धाः सेन्द्रैर्देवैः समुच्छ्रिताः ।\nस्वलङ्कृता भ्राजमानाः सर्वरत्नैर्मनोरमैः \t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2111891, "chapter_id": 3414, "verse_number": "१०१", "content_sanskrit": "हिरण्यं द्विरदानश्वान् महिषोष्ट्रगजाविकम् ।\nदासीदासं धनं धान्यं सवत्सां गां पयस्विनीम्\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2111892, "chapter_id": 3414, "verse_number": "१०२", "content_sanskrit": "भूमिं यूपसहस्राङ्कां ददौ कण्वाय दक्षिणाम् ।\nबहूनां ब्रह्मकल्पानां दक्षिणाममितां ददौ \t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2111893, "chapter_id": 3414, "verse_number": "१०३", "content_sanskrit": "ग्रामान् गृहाणि क्षेत्राणि कोटिशः शतशस्तथा ।\nभरताद् भारती कीर्तिर्येनेदं भारतं कुलम् \t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2111894, "chapter_id": 3414, "verse_number": "१०४", "content_sanskrit": "भरतस्यान्वये जाता देवकल्पा महारथाः ।\nबहवो ब्रह्मकल्पाश्च बहवो राजसत्तमाः \t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2111895, "chapter_id": 3414, "verse_number": "१०५", "content_sanskrit": "तेषामपरिमेयानि नामधेयानि सर्वशः ।\nतेषां कुले यथा मुख्यान् कीर्तयिष्यामि भारत ।\nमहाभागान् देवकल्पान् सत्यार्जवपरायणान्\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2111896, "chapter_id": 3414, "verse_number": "९३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nत्रिनवतितमोऽध्यायः॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2111897, "chapter_id": 3414, "verse_number": "३९", "content_sanskrit": "॥ इति सम्भवपर्वणि एकचत्वारिंशोऽध्यायः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}]