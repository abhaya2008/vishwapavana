[{"id": 7005439000, "chapter_id": 25439, "verse_number": "१-९-१", "content_sanskrit": "सूत उवाच एतच्छ्रुत्वा तु वचनं नारदाद्या महर्षयः ।\nप्रणम्य वरदं विष्णुं पप्रच्छुः संशयान्विता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005439001, "chapter_id": 25439, "verse_number": "१-९-२", "content_sanskrit": "मुनयः ऊचुः कथितो भवता सर्गो मुख्यादीनां जनार्दन ।\nइदानीं संशयं चेममस्माकं छेत्तुमर्हसि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005439002, "chapter_id": 25439, "verse_number": "१-९-३", "content_sanskrit": "कथं स भगवानीशः पूर्वजोऽपि पिनाकधृक् ।\nपुत्रत्वमगच्छंभुर्ब्रह्मणोऽव्यक्तजन्मनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005439003, "chapter_id": 25439, "verse_number": "१-९-४", "content_sanskrit": "कथं च भगवाञ्जज्ञे ब्रह्मा लोकपितामहः ।\nअण्डजो जगतामीशस्तन्नो वक्तुमिहार्हसि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005439004, "chapter_id": 25439, "verse_number": "१-९-५", "content_sanskrit": "श्रीकूर्म उवाच ।\nश्रृणुध्वमृषयः सर्वे शंकरस्यामितौजसः ।\nपुत्रत्वं ब्रह्मणस्तस्य पद्मयोनित्वमेव च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005439005, "chapter_id": 25439, "verse_number": "१-९-६", "content_sanskrit": "अतीतकल्पावसाने तमोभूतं जगत्त्रयम् ।\nआसीदेकार्णवं सर्वं न देवाद्या न चर्षयः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005439006, "chapter_id": 25439, "verse_number": "१-९-७", "content_sanskrit": "तत्र नारायणो देवो निर्जने निरुपप्लवे ।\nआश्रित्य शेषशयनं सुष्वाप पुरुषोत्तमः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005439007, "chapter_id": 25439, "verse_number": "१-९-८", "content_sanskrit": "सहस्रशीर्षा भूत्वा स सहस्राक्षः सहस्रपात् ।\nसहस्रबाहुः सर्वज्ञश्चिन्त्यमानो मनीषिभिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005439008, "chapter_id": 25439, "verse_number": "१-९-९", "content_sanskrit": "पीतवासा विशालाक्षो नीलजीमूतसन्निभः ।\nमहाविभूतिर्योगात्मा योगिनां हृदयालयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005439009, "chapter_id": 25439, "verse_number": "१-९-१०", "content_sanskrit": "कदाचित् तस्य सुप्तस्य लीलार्थं दिव्यमद्‌भुतम् ।\nत्रैलोक्यसारं विमलं नाभ्यां पङ्कजमुद्वभौ ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005439010, "chapter_id": 25439, "verse_number": "१-९-११", "content_sanskrit": "शतयोजनविस्तीर्णं तरुणादित्यसन्निभम् ।\nदिव्यगन्धमयं पुण्यं कर्णिकाकेसरान्वितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005439011, "chapter_id": 25439, "verse_number": "१-९-१२", "content_sanskrit": "तस्यैवं सुचिरं कालं वर्तमानस्य शार्ङ्गिणः ।\nहिरण्यगर्भो भगवांस्तं देशमुपचक्रमे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005439012, "chapter_id": 25439, "verse_number": "१-९-१३", "content_sanskrit": "स तं करेण विश्वात्मा समुत्थाप्य सनातनम् ।\nप्रोवाच मधुरं वाक्यं मायया तस्य मोहितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005439013, "chapter_id": 25439, "verse_number": "१-९-१४", "content_sanskrit": "अस्मिन्नेकार्णवे घोरे निर्जने तमसावृते ।\nएकाकी को भवाञ्छेते ब्रूहि मे पुरुषर्षभ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005439014, "chapter_id": 25439, "verse_number": "१-९-१५", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा विहस्य गरुडध्वजः ।\nउवाच देवं ब्रह्माणं मेघगम्भीरनिःस्वनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005439015, "chapter_id": 25439, "verse_number": "१-९-१६", "content_sanskrit": "भो भो नारायणं देवं लोकानां प्रभवाव्ययम् ।\nमहायोगीश्वरं मां त्वं जानीहि पुरुषोत्तमम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005439016, "chapter_id": 25439, "verse_number": "१-९-१७", "content_sanskrit": "मयि पश्य जगत् कृत्स्नं त्वां च लोकपितामहम् ।\nसपर्वतमहाद्वीपं समुद्रैः सप्तभिर्वृतम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005439017, "chapter_id": 25439, "verse_number": "१-९-१८", "content_sanskrit": "एवमाभाष्य विश्चात्मा प्रोवाच पुरुषं हरिः ।\nजानन्नपि महायोगी को भवानिति वेधसम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005439018, "chapter_id": 25439, "verse_number": "१-९-१९", "content_sanskrit": "ततः प्रहस्य भगवान् ब्रह्मा वेदनिधिः प्रभुः ।\nप्रत्युवाचाम्बुजाभाक्षं सस्मितं श्लक्ष्णया गिरा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005439019, "chapter_id": 25439, "verse_number": "१-९-२०", "content_sanskrit": "अहं धाता विधाता च स्वयंभूः प्रपितामहः ।\nमय्येव संस्थितं विश्वं ब्रह्माऽहं विश्वतोमुखः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005439020, "chapter_id": 25439, "verse_number": "१-९-२१", "content_sanskrit": "श्रुत्वा वाचं स भगवान् विष्णुः सत्यपराक्रमः ।\nअनुज्ञाप्याथ योगेन प्रविष्टो ब्रह्मणस्तनुम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005439021, "chapter_id": 25439, "verse_number": "१-९-२२", "content_sanskrit": "त्रलोक्यमेतत् सकलं सदेवासुरमानुषम् ।\nउदरे तस्य देवस्य दृष्ट्वा विस्मयमागतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005439022, "chapter_id": 25439, "verse_number": "१-९-२३", "content_sanskrit": "तदास्य वक्त्रान्निष्क्रम्य पन्नगेन्द्रनिकेतनः ।\nअजातश्मश्रुर्भगवान् पितामहमथाब्रवीत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005439023, "chapter_id": 25439, "verse_number": "१-९-२४", "content_sanskrit": "भवानप्येवमेवाद्य शाश्वतं हि ममोदरम् ।\nप्रविश्य लोकान् पश्यैतान् विचित्रान् पुरुषर्षभ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005439024, "chapter_id": 25439, "verse_number": "१-९-२५", "content_sanskrit": "ततः प्रह्लादनीं वाणी श्रुत्वा तस्याभिनन्द्य च ।\nश्रीपतेरुदरं भूयः प्रविवेश कुशध्वजः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005439025, "chapter_id": 25439, "verse_number": "१-९-२६", "content_sanskrit": "तानेव लोकान् गर्भस्थानपश्यत् सत्यविक्रमः ।\nपर्यटित्वाथ देवस्य ददृशेऽन्तं न वै हरेः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005439026, "chapter_id": 25439, "verse_number": "१-९-२७", "content_sanskrit": "ततो द्वाराणि सर्वाणि पिहितानि महात्मना ।\nजनार्दनेन ब्रह्माऽसौ नाभ्यां द्वारमविन्दत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005439027, "chapter_id": 25439, "verse_number": "१-९-२८", "content_sanskrit": "तत्र योगबलेनासौ प्रविश्य कनकाण्डजः ।\nउज्जहारात्मनो रूपं पुष्कराच्चतुराननः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005439028, "chapter_id": 25439, "verse_number": "१-९-२९", "content_sanskrit": "विरराजारविन्दस्थः पद्मगर्भसमद्युतिः ।\nब्रह्मा स्वयंभूर्भगवान् जगद्योनिः पितामहः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005439029, "chapter_id": 25439, "verse_number": "१-९-३०", "content_sanskrit": "समन्यमानो विश्वेशमात्मानं परमं पदम् ।\nप्रोवाच पुरुषं विष्णुं मेघगम्भीरया गिरा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005439030, "chapter_id": 25439, "verse_number": "१-९-३१", "content_sanskrit": "कृतं किं भवतेदानीमात्मनो जयकाङ्‌क्षया ।\nएकोऽहं प्रबलो नान्यो मां वै कोऽभिभविष्यति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005439031, "chapter_id": 25439, "verse_number": "१-९-३२", "content_sanskrit": "श्रुत्वा नारायणो वाक्यं ब्रह्मणो लोकमन्त्रिणः ।\nसान्त्वपूर्वमिदं वाक्यं बभाषे मधुरं हरिः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005439032, "chapter_id": 25439, "verse_number": "१-९-३३", "content_sanskrit": "भवान् धाता विधाता च स्वयंभूः प्रपितामहः ।\nन मात्सर्याभियोगेन द्वाराणि पिहितानि मे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005439033, "chapter_id": 25439, "verse_number": "१-९-३४", "content_sanskrit": "किन्तु लीलार्थमेवैतन्न त्वां बाधितुमिच्छया ।\nको हि बाधितुमन्विच्छेद्‌ देवदेवं पितामहम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005439034, "chapter_id": 25439, "verse_number": "१-९-३५", "content_sanskrit": "न तेऽन्यथाऽवमन्तव्यं मान्यो मे सर्वथा भवान् ।\nसर्वमन्वय कल्याणं यन्मयाऽपहृतं तव ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005439035, "chapter_id": 25439, "verse_number": "१-९-३६", "content_sanskrit": "अस्माच्च कारणाद्‌ ब्रह्मन् पुत्रो भवतु मे भवान् ।\nपद्मयोनिरिति ख्यातो मत्प्रियार्थं जगन्मय ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005439036, "chapter_id": 25439, "verse_number": "१-९-३७", "content_sanskrit": "ततः स भगवान् देवो वरं दत्त्वा किरीटिने ।\nप्रहर्षमतुलं गत्वा पुनर्विष्णुमभाषत ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005439037, "chapter_id": 25439, "verse_number": "१-९-३८", "content_sanskrit": "भवान् सर्वात्मकोऽनन्तः सर्वेषां परमेश्वरः ।\nसर्वभूतान्तरात्मा वै परं बह्म सनातनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005439038, "chapter_id": 25439, "verse_number": "१-९-३९", "content_sanskrit": "अहं वै सर्वलोकानामात्मा लोकोमहेश्वरः ।\nमन्मयं सर्वमेवेदं ब्रह्माऽहं पुरुषः परः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005439039, "chapter_id": 25439, "verse_number": "१-९-४०", "content_sanskrit": "नावाभ्यां विद्यते ह्यन्यो लोकानां परमेश्वरः ।\nएका मूर्तिर्द्विधा भिन्ना नारायणपितामहौ ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005439040, "chapter_id": 25439, "verse_number": "१-९-४१", "content_sanskrit": "तेनैवमुक्तो ब्रह्माणं वासुदेवोऽब्रवीदिदम् ।\nइयं प्रतिज्ञा भवतो विनाशाय भविष्यति ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005439041, "chapter_id": 25439, "verse_number": "१-९-४२", "content_sanskrit": "किं न पश्यसि योगेशं ब्रह्माधिपतिमव्ययम् ।\nप्रधानपुरुषेशानं वेदाहं परमेश्वरम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005439042, "chapter_id": 25439, "verse_number": "१-९-४३", "content_sanskrit": "यं न पश्यन्ति योगीन्द्राः सांख्या अपि महेश्वरम् ।\nअनादिनिधनं ब्रह्म तमेव शरणं व्रज ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005439043, "chapter_id": 25439, "verse_number": "१-९-४४", "content_sanskrit": "ततः क्रुद्धोऽम्बुजाभाक्षं ब्रह्मा प्रोवाच केशवम् ।\nभवान्न नूनमात्मानं वेद्मि तत्परमाक्षरम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005439044, "chapter_id": 25439, "verse_number": "१-९-४५", "content_sanskrit": "ब्रह्माणं जगतामेकमात्मानं परमं पदम् ।\nनावाभ्यां विद्यते ह्यन्यो लोकानां परमेश्वरः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005439045, "chapter_id": 25439, "verse_number": "१-९-४६", "content_sanskrit": "संत्यज्य निद्रां विपुलां स्वमात्मानं विलोकय ।\nतस्य तत्क्रोधजं वाक्यं श्रुत्वा विष्णुरभाषत ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005439046, "chapter_id": 25439, "verse_number": "१-९-४७", "content_sanskrit": "मामैवं वद कल्याण परिवादं महात्मनः ।\nन मेह्‌यविदितं ब्रह्मन् नान्यथाऽहं वदामि ते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005439047, "chapter_id": 25439, "verse_number": "१-९-४८", "content_sanskrit": "किन्तु मोहयति ब्रह्मन् भवन्तं पारमेश्वरी ।\nमायाशेषविशेषाणां हेतुरात्मसमुद्भवा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005439048, "chapter_id": 25439, "verse_number": "१-९-४९", "content_sanskrit": "एतावदुक्त्वा भगवान् विष्णुस्तूष्णीं बभूव ह ।\nज्ञात्वा तत् परमं तत्त्वं स्वमात्मानं महेश्वरम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005439049, "chapter_id": 25439, "verse_number": "१-९-५०", "content_sanskrit": "कुतोह्‌यपरिमेयात्मा भूतानां परमेश्वरः ।\nप्रसादं ब्रह्मणे कर्तुं प्रादुरासीत्ततो हरः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005439050, "chapter_id": 25439, "verse_number": "१-९-५१", "content_sanskrit": "ललाटनयनोऽनन्तो जटामण्डलमण्डितः ।\nत्रिशूलपाणिर्भगवांस्तेजसां परमो निधिः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005439051, "chapter_id": 25439, "verse_number": "१-९-५२", "content_sanskrit": "दिव्यां विशालां ग्रथितां ग्रहैः सार्केन्दुतारकैः ।\nमालामत्यद्‌भुताकारां धारयन्पादलम्बिनीम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005439052, "chapter_id": 25439, "verse_number": "१-९-५३", "content_sanskrit": "तं दृष्ट्वा देवमीशानं ब्रह्मा लोकपितामहः ।\nमोहितो माययात्यर्थं पीतवासलमब्रवीत्‌ ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005439053, "chapter_id": 25439, "verse_number": "१-९-५४", "content_sanskrit": "क एष पुरुषोऽनन्तः शूलपाणिस्त्रिलोचनः ।\nतेजोराशिरमेयात्मा समायाति जनार्दन ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005439054, "chapter_id": 25439, "verse_number": "१-९-५५", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा विष्णुर्दानवमर्दनः ।\nअपश्यदीश्वरं देवं ज्वलन्तं विमलेऽम्भसि ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005439055, "chapter_id": 25439, "verse_number": "१-९-५६", "content_sanskrit": "ज्ञात्वा तं परमं भावमैश्वरं ब्रह्मभावनम् ।\nप्रोवाचोत्थाय भगवान् देवदेवं पितामहम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005439056, "chapter_id": 25439, "verse_number": "१-९-५७", "content_sanskrit": "अयं देवो महादेवः स्वयंज्योतिः सनातनः ।\nअनादिनिधनोऽचिन्त्यो लोकानामीश्वरो महान् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005439057, "chapter_id": 25439, "verse_number": "१-९-५८", "content_sanskrit": "शंकरः शंभुरीशानः सर्वात्मा परमेश्वरः ।\nभूतानामधिपो योगी महेशो विमलः शिवः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005439058, "chapter_id": 25439, "verse_number": "१-९-५९", "content_sanskrit": "एष धाता विधाता च प्रधानपुरुषेश्वरः ।\nयं प्रपश्यन्ति यतयो ब्रह्मभावेन भाविताः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005439059, "chapter_id": 25439, "verse_number": "१-९-६०", "content_sanskrit": "सृजत्येष जगत् कृत्स्नं पाति संहरते तथा ।\nकालो भूत्वा महादेवः केवलो निष्कलः शिवः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005439060, "chapter_id": 25439, "verse_number": "१-९-६१", "content_sanskrit": "ब्रह्माणं विदधे पूर्वं भवन्तं यः सनातनः ।\nवेदांश्च प्रददौ तुभ्यं सोऽयमायाति शंकरः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005439061, "chapter_id": 25439, "verse_number": "१-९-६२", "content_sanskrit": "अस्यैव चापरां मूर्ति विश्वयोनिं सनातनीम् ।\nवासुदेवाभिधानां मामवेहि प्रपितामह ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005439062, "chapter_id": 25439, "verse_number": "१-९-६३", "content_sanskrit": "किं न पश्यसि योगेशं ब्रह्माधिपतिमव्ययम् ।\nदिव्यं भवतु ते चक्षुर्येन द्रक्ष्यसि तत्परम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005439063, "chapter_id": 25439, "verse_number": "१-९-६४", "content_sanskrit": "लब्ध्वा शैवं तदा चक्षुर्विष्णोर्लोकपितामहः ।\nबुबुधे परमेशानं पुरतः समवस्थितम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005439064, "chapter_id": 25439, "verse_number": "१-९-६५", "content_sanskrit": "स लब्ध्वा परमं ज्ञानमैश्वरं प्रपितामहः ।\nप्रपेदे शरणं देवं तमेव पितरं शिवम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005439065, "chapter_id": 25439, "verse_number": "१-९-६६", "content_sanskrit": "ओंकारं समनुस्मृत्य संस्तभ्यात्मानमात्मना ।\nअथर्वशिरसा देवं तुष्टाव च कृताञ्जलिः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005439066, "chapter_id": 25439, "verse_number": "१-९-६७", "content_sanskrit": "संस्तुतस्तेन। भगवान् ब्रह्मणा परमेश्वरः ।\nअवाप परमां प्रीतिं व्याजहार स्मयन्निव ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005439067, "chapter_id": 25439, "verse_number": "१-९-६८", "content_sanskrit": "मत्समस्त्वं न संदेहो मद्भक्तश्च यतो भवान् ।\nमयैवोत्पादितः पूर्वं लोकसृष्ट्यर्थमव्ययम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005439068, "chapter_id": 25439, "verse_number": "१-९-६९", "content_sanskrit": "त्वमात्मा ह्यादिपुरुषो मम देहसमुद्भवः ।\nवरं वरय विश्वात्मन् वरदोऽहं तवानघ ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005439069, "chapter_id": 25439, "verse_number": "१-९-७०", "content_sanskrit": "स देवदेववचनं निशम्य कमलोद्भवः ।\nनिरीक्ष्य विष्णुं पुरुषं प्रणम्याह वृषध्वजम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005439070, "chapter_id": 25439, "verse_number": "१-९-७१", "content_sanskrit": "भगवन् भूतभव्येश महादेवाम्बिकापते ।\nत्वामेव पुत्रमिच्छामि त्वया वा सदृशं सतम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005439071, "chapter_id": 25439, "verse_number": "१-९-७२", "content_sanskrit": "मोहितोऽस्मि महादेव मायया सूक्ष्मया त्वया ।\nन जाने परमं भावं याथातथ्येन ते शिव ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005439072, "chapter_id": 25439, "verse_number": "१-९-७३", "content_sanskrit": "त्वमेव देव भक्तानां भ्राता माता पिता सुहृत् ।\nप्रसीद तव पादाब्जं नमामि शरणागतः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005439073, "chapter_id": 25439, "verse_number": "१-९-७४", "content_sanskrit": "स तस्य वचनं श्रुत्वा जगन्नाथो वृषध्वजः ।\nव्याजहार तदा पुत्रं समालोक्य जनार्दनम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005439074, "chapter_id": 25439, "verse_number": "१-९-७५", "content_sanskrit": "यदर्थितं भगवता तत्करिष्यामि पुत्रक ।\nविज्ञानमैश्वरं दिव्यमुत्पत्स्यति तवानघ ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005439075, "chapter_id": 25439, "verse_number": "१-९-७६", "content_sanskrit": "त्वमेव सर्वभूतानामादिकर्ता नियोजितः ।\nतथा कुरुष्व देवेश मयां लोकपितामह ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005439076, "chapter_id": 25439, "verse_number": "१-९-७७", "content_sanskrit": "एष नारायणोऽनन्तो ममैव परमा तनुः ।\nभविष्यति तवेशानो योगक्षेमवहो हरिः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005439077, "chapter_id": 25439, "verse_number": "१-९-७८", "content_sanskrit": "एवं व्याहृत्य हस्ताभ्यां प्रीतात्मा परमेश्वरः ।\nसंस्पृश्य देवं ब्रह्माणं हरिं वचनमब्रवीत् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005439078, "chapter_id": 25439, "verse_number": "१-९-७९", "content_sanskrit": "तृष्टोऽस्मि सर्वथाऽहंते भक्त्या तव जगन्मय ।\nवरं वृणीष्वं न ह्यावां विभिन्नौ परमार्थतः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7005439079, "chapter_id": 25439, "verse_number": "१-९-८०", "content_sanskrit": "श्रुत्वाऽथ देववचनं विष्णुर्विश्वजगन्मयः ।\nप्राह प्रसन्नया वाचा समालोक्य चतुर्मुखम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7005439080, "chapter_id": 25439, "verse_number": "१-९-८१", "content_sanskrit": "एष एव वरः श्लाघ्यो यदहं परमेश्वरम् ।\nपश्यामि परमात्मानं भक्तिर्भवतु मे त्वयि ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7005439081, "chapter_id": 25439, "verse_number": "१-९-८२", "content_sanskrit": "तथेत्युक्त्वा महादेवः पुनर्विष्णुमभाषत ।\nभवान् सर्वस्य कार्यस्य कर्ताह़मधिदैवतम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7005439082, "chapter_id": 25439, "verse_number": "१-९-८३", "content_sanskrit": "त्वन्मयं मन्मयं चैव सर्वमेतन्न संशयः ।\nभवान् सोमस्त्वहं सूर्यो भवान् रात्रिरहं दिनम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7005439083, "chapter_id": 25439, "verse_number": "१-९-८४", "content_sanskrit": "भवान् प्रकृतिरव्यक्तमहं पुरुष एव च ।\nभवान् ज्ञानमहं ज्ञाता भवान् मायाहमीश्वरः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7005439084, "chapter_id": 25439, "verse_number": "१-९-८५", "content_sanskrit": "भवान् विद्यात्मिका शक्तिः शक्तिमानहमीश्वरः ।\nयोऽहं सनिष्कलो देवः सोऽपि नारायणः परः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7005439085, "chapter_id": 25439, "verse_number": "१-९-८६", "content_sanskrit": "एकीभावेन पश्यन्ति योगिनो ब्रह्मवादिनः ।\nत्वामनाश्रित्य विश्वात्मन् न योगी मामुपैष्यति ।\nपालयैतज्जगत् कृत्स्नं सदेवासुरमानुषम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7005439086, "chapter_id": 25439, "verse_number": "१-९-८७", "content_sanskrit": "इतीदमुक्त्वा भगवाननादिः ।\nस्वमायया मोहितभूतभेदः ।\nजगाम जन्मर्द्धिविनाशहीन ।\nधामैकमव्यक्तमनन्तशक्तिः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]