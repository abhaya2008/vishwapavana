[{"id": 6000285000, "chapter_id": 10285, "verse_number": null, "content_sanskrit": "अथ एकोननवतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000285001, "chapter_id": 10285, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.001.m4a", "display_order": 2}, {"id": 6000285002, "chapter_id": 10285, "verse_number": "१०-८९-१", "content_sanskrit": "उपविष्टं सुधर्मायां कदाचित् क्षत्रियैर्वृतम्।\nव्यज्ञापयद् वेत्रपाणिर्द्वाःस्थोऽभ्येत्य जनार्दनम्॥ १०/८९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.002.m4a", "display_order": 3, "topics": [{"text": "कृष्णस्य द्यूते पाण्डवपराजयस्य वनगमनस्य च वार्ताप्राप्तिः", "range": "१–५"}]}, {"id": 6000285003, "chapter_id": 10285, "verse_number": "१०-८९-२", "content_sanskrit": "शक्रप्रस्थाद् द्विजः कश्चिदागत्य द्वारि तिष्ठति।\nप्रवेशितव्यो वा देव न वेति यदुसत्तम॥ १०/८९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.003.m4a", "display_order": 4}, {"id": 6000285004, "chapter_id": 10285, "verse_number": "१०-८९-३", "content_sanskrit": "प्रवेशयेति कृष्णेन द्वाःस्थेनोक्तेन सत्वरम्।\nप्रवेशितः प्रणम्याऽह ब्राह्मणः पुरुषोत्तमम्॥ १०/८९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.004.m4a", "display_order": 5}, {"id": 6000285005, "chapter_id": 10285, "verse_number": "१०-८९-४", "content_sanskrit": "धर्मजो धार्तराष्ट्रेण मूढेनाधर्मचारिणा।\nअक्षैः पराजितो यातः सभार्यः सानुजो वनम्॥ १०/८९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.005.m4a", "display_order": 6}, {"id": 6000285006, "chapter_id": 10285, "verse_number": "१०-८९-५", "content_sanskrit": "ब्राह्मणेनोदितां वाणीमित्याकर्ण्य सुदुःश्रवाम्।\nक्रोधोद्विग्नमनास्तूर्णमुत्तस्थे हरिरासनात्॥ १०/८९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.006.m4a", "display_order": 7}, {"id": 6000285007, "chapter_id": 10285, "verse_number": "१०-८९-६", "content_sanskrit": "स रथं दारुकानीतमारुह्य सह सत्यया।\nमहत्या सेनया सार्धं ययौ यत्र पृथासुताः॥ १०/८९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.007.m4a", "display_order": 8, "topics": [{"text": "वने पाण्डवानां दर्शनं सान्‍त्वनं च", "range": "६–१२"}]}, {"id": 6000285008, "chapter_id": 10285, "verse_number": "१०-८९-७", "content_sanskrit": "वने वसन्तं राजानं ब्राह्मणैः परिवारितम्।\nदृष्ट्वाऽनुशोचत् सुभृशं सानुजं यदुनन्दनः॥ १०/८९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.008.m4a", "display_order": 9}, {"id": 6000285009, "chapter_id": 10285, "verse_number": "१०-८९-८", "content_sanskrit": "व्यसनान्यनुभुक्तानि वर्णयित्वा परस्परम्।\nउषित्वा तत्र तां रात्रिं पाण्डवैः सह केशवः॥ १०/८९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.009.m4a", "display_order": 10}, {"id": 6000285010, "chapter_id": 10285, "verse_number": "१०-८९-९", "content_sanskrit": "हेतुवाक्यैः समाश्वास्य धर्मराजं युधिष्ठिरम्।\nभीमसेनार्जुनौ चैव यमौ च यदुनन्दनः॥ १०/८९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.010.m4a", "display_order": 11}, {"id": 6000285011, "chapter_id": 10285, "verse_number": "१०-८९-१०", "content_sanskrit": "पाञ्चालीं द्रौपदीं साध्वीं सत्यभामासमन्वितः।\nआश्वास्य तामनुज्ञाप्य ब्राह्मणांश्च सहस्रशः॥ १०/८९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.011.m4a", "display_order": 12}, {"id": 6000285012, "chapter_id": 10285, "verse_number": "१०-८९-११", "content_sanskrit": "सुभद्रामभिमन्युं च रथमारोप्य केशवः।\nआजगाम वनाद् राजन् पुरीं द्वारवतीं प्रभुः॥ १०/८९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.012.m4a", "display_order": 13}, {"id": 6000285013, "chapter_id": 10285, "verse_number": "१०-८९-१२", "content_sanskrit": "स प्रविश्य पुरीं दिव्यां पार्थविश्लेषदुर्मनाः।\nउवास पालयन् पृथ्वीं धर्मेणान्यांश्च कालयन्॥ १०/८९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.013.m4a", "display_order": 14}, {"id": 6000285014, "chapter_id": 10285, "verse_number": "१०-८९-१३", "content_sanskrit": "एकदोपवनं राजन् जग्मुर्यदुकुमारकाः।\nविहर्तुं साम्बप्रद्युम्नचारुभानुगदादयः॥ १०/८९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.014.m4a", "display_order": 15, "topics": [{"text": "कृकलासप्रसङ्गः", "range": "१३–२१"}]}, {"id": 6000285015, "chapter_id": 10285, "verse_number": "१०-८९-१४", "content_sanskrit": "क्रीडित्वा सुचिरं तत्र विचिन्वन्तः पिपासिताः।\nजलं निरुदके कूपे ददृशुः सत्त्वमद्भुतम्॥ १०/८९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.015.m4a", "display_order": 16}, {"id": 6000285016, "chapter_id": 10285, "verse_number": "१०-८९-१५", "content_sanskrit": "कृकलासं गिरिनिभं वीक्ष्य विस्मितचेतसः।\nतस्य चोद्धरणे यत्नं चक्रुस्ते कृपयाऽन्विताः॥ १०/८९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.016.m4a", "display_order": 17}, {"id": 6000285017, "chapter_id": 10285, "verse_number": "१०-८९-१६", "content_sanskrit": "चर्मभिस्तं तथा पाशैर्बद्ध्वा पतितमर्भकाः।\nनाशक्नुवन् समुद्धर्र्तुं कृष्णायाचख्युरुत्सुकाः॥ १०/८९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.017.m4a", "display_order": 18}, {"id": 6000285018, "chapter_id": 10285, "verse_number": "१०-८९-१७", "content_sanskrit": "तत्र गत्वाऽरविन्दाक्षो भगवान् विश्वभावनः।\nवीक्ष्योज्जहार वामेन तं करेण स लीलया॥ १०/८९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.018.m4a", "display_order": 19}, {"id": 6000285019, "chapter_id": 10285, "verse_number": "१०-८९-१८", "content_sanskrit": "स उत्तमश्लोककराभिमृष्टो विहाय सद्यः कृकलासरूपम्।\nसन्तप्तचामीकरचारुवर्णः स्वर्गोचितालङ्करणाम्बरस्रक्॥ १०/८९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.019.m4a", "display_order": 20}, {"id": 6000285020, "chapter_id": 10285, "verse_number": "१०-८९-१९", "content_sanskrit": "भूत्वा मुकुन्दस्य पदारविन्दं ननाम मूर्ध्ना पतितो धरण्याम्।\nपप्रच्छ विद्वानपि तस्य कर्म जनेषु विख्यापयितुं मुकुन्दः॥ १०/८९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.020.m4a", "display_order": 21}, {"id": 6000285021, "chapter_id": 10285, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.021.m4a", "display_order": 22}, {"id": 6000285022, "chapter_id": 10285, "verse_number": "१०-८९-२०", "content_sanskrit": "कस्त्वं महाभाग वरेण्यरूपो देवोत्तमं त्वां गणयामि नूनम्।\nदशामिमां त्वं कतमेन कर्मणा सम्प्रापितो ह्यतदर्हः सुभद्रः॥ १०/८९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.022.m4a", "display_order": 23}, {"id": 6000285023, "chapter_id": 10285, "verse_number": "१०-८९-२१", "content_sanskrit": "आत्मानमाख्याहि विवित्सतां नो यन्मन्यसेऽङ्ग क्षममत्र वक्तुम्॥ १०/८९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.023.m4a", "display_order": 24}, {"id": 6000285024, "chapter_id": 10285, "verse_number": "१०-८९-२२", "content_sanskrit": "इति राजन् सुसम्पृष्टः कृष्णेनानन्तमूर्तिना।\nप्रतीतः प्रणिपत्याह किरीटेनार्कवर्चसा॥ १०/८९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.024.m4a", "display_order": 25, "topics": [{"text": "स्ववृत्तान्तं कथयित्वा नृगस्य स्वगमनं च", "range": "२२–४३"}]}, {"id": 6000285025, "chapter_id": 10285, "verse_number": null, "content_sanskrit": "नृग उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.025.m4a", "display_order": 26}, {"id": 6000285026, "chapter_id": 10285, "verse_number": "१०-८९-२३", "content_sanskrit": "नृगो नाम नरेन्द्रोऽहमिक्ष्वाकुतनयः प्रभो।\nदानिषु ख्यायमानेषु यदि ते कर्णमस्पृशम्॥ १०/८९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.026.m4a", "display_order": 27}, {"id": 6000285027, "chapter_id": 10285, "verse_number": "१०-८९-२४", "content_sanskrit": "किन्नु तेऽविदितं नाथ सर्वभूतात्मसाक्षिणः।\nकालेनाव्याहतदृशो वक्ष्येऽथापि तवाज्ञया॥ १०/८९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.027.m4a", "display_order": 28}, {"id": 6000285028, "chapter_id": 10285, "verse_number": "१०-८९-२५", "content_sanskrit": "यावन्त्यः सिकता भूमेर्यावन्त्यो दिवि तारकाः।\nयावन्त्यो वर्षधाराश्च तावतीरददा स्म गाः॥ १०/८९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.028.m4a", "display_order": 29}, {"id": 6000285029, "chapter_id": 10285, "verse_number": "१०-८९-२६", "content_sanskrit": "पयस्विनीस्तरुणीः शीलरूपगुणोपपन्ना कपिला हेमशृङ्गाः।\nन्यायार्जिता रूप्यखुराः सवत्सा दुकूलमालाभरणा ददावहम्॥ १०/८९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.029.m4a", "display_order": 30}, {"id": 6000285030, "chapter_id": 10285, "verse_number": "१०-८९-२७", "content_sanskrit": "स्वलङ्कृतेभ्यो गुणशीलवद्भ्यः सीदत्कुटुम्बेभ्य ऋतव्रतेभ्यः।\nतपःश्रुतब्रह्मवदान्यवद्भ्यः प्रादां युवभ्यो द्विजपुङ्गवेभ्यः॥ १०/८९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.030.m4a", "display_order": 31}, {"id": 6000285031, "chapter_id": 10285, "verse_number": "१०-८९-२८", "content_sanskrit": "गोभूहिरण्यायतनाश्वहस्तिनः कन्याः सदासीस्तिलरूप्यशय्याः।\nवासांसि रत्नानि परिच्छदान् रथानिष्टं च यज्ञैश्चरितं च पूर्तैः॥ १०/८९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.031.m4a", "display_order": 32}, {"id": 6000285032, "chapter_id": 10285, "verse_number": "१०-८९-२९", "content_sanskrit": "कस्यचिद् द्विजमुख्यस्य भ्रष्टा गौर्मम गोधने।\nसंसृष्टाऽविदुषा सा च मया दत्ता द्विजातये॥ १०/८९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.032.m4a", "display_order": 33}, {"id": 6000285033, "chapter_id": 10285, "verse_number": "१०-८९-३०", "content_sanskrit": "तां नीयमानां तत्स्वामी दृष्ट्वोवाच ममेति तम्।\nममेति प्रतिगृह्याह नृगो मे दत्तवानिति॥ १०/८९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.033.m4a", "display_order": 34}, {"id": 6000285034, "chapter_id": 10285, "verse_number": "१०-८९-३१", "content_sanskrit": "विप्रौ विवदमानौ मामूचतुः स्वार्थसाधकौ।\nभवान् दाताऽपहर्तेति तच्छ्रुत्वा मेऽभवद् भ्रमः॥ १०/८९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.034.m4a", "display_order": 35}, {"id": 6000285035, "chapter_id": 10285, "verse_number": "१०-८९-३२", "content_sanskrit": "अनुनीतावुभौ विप्रौ धर्मकृच्छ्रं गतेन मे।\nगवां लक्षं प्रगृह्णीतां दास्याम्येषा प्रदीयताम्॥ १०/८९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.035.m4a", "display_order": 36}, {"id": 6000285036, "chapter_id": 10285, "verse_number": "१०-८९-३३", "content_sanskrit": "भवन्तावनुगृह्णीतां किङ्करस्याविजानतः।\nसमुद्धरत मां कृच्छ्रात् पतन्तं निरयेऽशुचौ॥ १०/८९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.036.m4a", "display_order": 37}, {"id": 6000285037, "chapter_id": 10285, "verse_number": "१०-८९-३४", "content_sanskrit": "नान्यां प्रतीच्छे वै राजन्नित्युक्त्वा स्वाम्यपाक्रमत्।\nनान्यद्गवामप्ययुतमिच्छामीत्यपरो ययौ॥ १०/८९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.037.m4a", "display_order": 38}, {"id": 6000285038, "chapter_id": 10285, "verse_number": "१०-८९-३५", "content_sanskrit": "ततोऽहं कालयोगेन मृतः परममायया।\nएतस्मिन्नन्तरे याम्यैर्दूतैर्नीतो यमक्षयम्॥ १०/८९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.038.m4a", "display_order": 39}, {"id": 6000285039, "chapter_id": 10285, "verse_number": "१०-८९-३६", "content_sanskrit": "यमेन पृष्टस्तत्राहं देवदेव जगत्पते।\nत्वं पूर्वमशुभं भुङ्‍क्ष्वउताहो नृपते शुभम्॥ १०/८९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.039.m4a", "display_order": 40}, {"id": 6000285040, "chapter_id": 10285, "verse_number": "१०-८९-३७", "content_sanskrit": "नान्तं दानस्य धर्मस्य पश्य लोकांश्च भास्वतः।\nपूर्वमेवाशुभं भुञ्ज इति प्राह पतेति सः॥ १०/८९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.040.m4a", "display_order": 41}, {"id": 6000285041, "chapter_id": 10285, "verse_number": "१०-८९-३८", "content_sanskrit": "तावदद्राक्षमात्मानं कृकलासं पतन् प्रभो।\nब्रह्मण्यस्य वदान्यस्य तव दासस्य केशव॥ १०/८९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.041.m4a", "display_order": 42}, {"id": 6000285042, "chapter_id": 10285, "verse_number": "१०-८९-३९", "content_sanskrit": "स्मृतिर्नाद्यापि विध्वस्ता तव सन्दर्शनार्थिनः।\nदेवदेव जगन्नाथ गोविन्द पुरुषोत्तम॥ १०/८९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.042.m4a", "display_order": 43}, {"id": 6000285043, "chapter_id": 10285, "verse_number": "१०-८९-४०", "content_sanskrit": "नारायण हृषीकेश पुण्यश्लोकाच्युताव्यय।\nअनुजानीहि मां कृष्ण यातुं देवगतिं प्रभो॥ १०/८९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.043.m4a", "display_order": 44}, {"id": 6000285044, "chapter_id": 10285, "verse_number": "१०-८९-४१", "content_sanskrit": "यत्र क्‍वापि सतश्चेतो भूयान्मे त्वत्पदास्पदम्॥ १०/८९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.044.m4a", "display_order": 45}, {"id": 6000285045, "chapter_id": 10285, "verse_number": "१०-८९-४२", "content_sanskrit": "नमस्ते सर्वभावाय ब्रह्मणेऽनन्तशक्तये।\nकृष्णाय वासुदेवाय गोपानां पतये नमः॥ १०/८९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.045.m4a", "display_order": 46}, {"id": 6000285046, "chapter_id": 10285, "verse_number": "१०-८९-४३", "content_sanskrit": "इत्युक्त्वा तं परिक्रम्य पादौ स्पृष्ट्वा स्वमौलिना।\nअनुज्ञातो विमानाग्य्रमारुहत् पश्यतां नृणाम्॥ १०/८९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.046.m4a", "display_order": 47}, {"id": 6000285047, "chapter_id": 10285, "verse_number": "१०-८९-४४", "content_sanskrit": "कृष्णः परिजनं प्राह भगवान् देवकीसुतः।\nब्रह्मण्यदेवो धर्मात्मा राजन्याननुशिक्षयन्॥ १०/८९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.047.m4a", "display_order": 48, "topics": [{"text": "क्षत्रियाणां कृष्णोपदेशः", "range": "४४–६६"}]}, {"id": 6000285048, "chapter_id": 10285, "verse_number": "१०-८९-४५", "content_sanskrit": "दुर्जरं बत ब्रह्मस्वं भुक्तमग्नेर्मनागपि।\nतेजीयसोऽपि किमुत राज्ञामीश्वरमानिनाम्॥ १०/८९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.048.m4a", "display_order": 49}, {"id": 6000285049, "chapter_id": 10285, "verse_number": "१०-८९-४६", "content_sanskrit": "नाहं हालाहलं मन्ये विषं यस्य प्रतिक्रिया।\nब्रह्मस्वं हि विषं प्रोक्तं नास्य प्रतिविधिर्भुवि॥ १०/८९/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.049.m4a", "display_order": 50}, {"id": 6000285050, "chapter_id": 10285, "verse_number": "१०-८९-४७", "content_sanskrit": "हिनस्ति विषमत्तारमग्निरद्भिः प्रशाम्यति।\nकुलं समूलं दहति ब्रह्मस्वारणिपावकः॥ १०/८९/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.050.m4a", "display_order": 51}, {"id": 6000285051, "chapter_id": 10285, "verse_number": "१०-८९-४८", "content_sanskrit": "ब्रह्मस्वं दुरनुज्ञातं भुक्तं हन्ति त्रिपूरुषम्।\nप्रसह्य तु बलाद् भुक्तं दश पूर्वान् दशावरान्॥ १०/८९/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.051.m4a", "display_order": 52}, {"id": 6000285052, "chapter_id": 10285, "verse_number": "१०-८९-४९", "content_sanskrit": "राजानो राजलक्ष्म्याश्च नात्मपातं प्रचक्षते।\nनिरये येऽभिमन्यन्ते ब्रह्मस्वं साधु बालिशाः॥ १०/८९/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.052.m4a", "display_order": 53}, {"id": 6000285053, "chapter_id": 10285, "verse_number": "१०-८९-५२", "content_sanskrit": "स्वदत्तां परदत्तां वा ब्रह्मवृत्तिं हरेत यः।\nषष्टिवर्षसहस्राणि विष्ठायां जायते कृमिः॥ १०/८९/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.053.m4a", "display_order": 54}, {"id": 6000285054, "chapter_id": 10285, "verse_number": "१०-८९-५३", "content_sanskrit": "न मे ब्रह्मधनं भूयाद् यज्जग्ध्वाऽल्पायुषो नृपाः।\nपराजिताश्च्युताः स्थानाद् भवन्त्युद्वेजिता नृपाः॥ १०/८९/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.054.m4a", "display_order": 55}, {"id": 6000285055, "chapter_id": 10285, "verse_number": "१०-८९-५४", "content_sanskrit": "विप्रं कृतागसमपि नैव द्रुह्यत मामकाः।\nघ्नन्तं बहु शपन्तं वा नमस्कुरुत नित्यशः॥ १०/८९/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.055.m4a", "display_order": 56}, {"id": 6000285056, "chapter_id": 10285, "verse_number": "१०-८९-५५", "content_sanskrit": "यथाऽहं प्रणमे विप्रान् सर्वकालं समाहितः।\nतथा नमत यूयं च योऽन्यथा मे स दण्डभाक्॥ १०/८९/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.056.m4a", "display_order": 57}, {"id": 6000285057, "chapter_id": 10285, "verse_number": "१०-८९-५६", "content_sanskrit": "ब्राह्मणार्थो ह्यपहृतो हर्तारं पातयत्यधः।\nअजानन्तमपि ह्येनं नृगं ब्राह्मणगौरिव॥ १०/८९/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.057.m4a", "display_order": 58}, {"id": 6000285058, "chapter_id": 10285, "verse_number": "१०-८९-५७", "content_sanskrit": "एवं विश्राव्य भगवान् मुकुन्दो द्वारकौकसः।\nपावनः सर्वलोकानां विवेश निजमन्दिरम्॥ १०/८९/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.058.m4a", "display_order": 59}, {"id": 6000285059, "chapter_id": 10285, "verse_number": "१०-८९-५८", "content_sanskrit": "सद्भिः समागमो राजन् कदाचिन्नाफलो भवेत्।\nविमुक्तो नरकाद् राजा नृगः साधुसमागमात्॥ १०/८९/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.059.m4a", "display_order": 60}, {"id": 6000285060, "chapter_id": 10285, "verse_number": "१०-८९-५९", "content_sanskrit": "साधूनां दर्शनं स्पर्शः कीर्तनं स्मरणं तथा।\nतीर्थानामिव पुण्यानां सर्वमेव हि पावनम्॥ १०/८९/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.060.m4a", "display_order": 61}, {"id": 6000285061, "chapter_id": 10285, "verse_number": "१०-८९-६०", "content_sanskrit": "एतत् श्रुत्वा त्वया सन्तः सदोपास्याः परन्तप।\nब्रह्मस्वं नैव हर्तव्यं यदीच्छसि परां गतिम्॥ १०/८९/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_089/BhP_10.089.061.m4a", "display_order": 62}, {"id": 6000285062, "chapter_id": 10285, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्ध एकोननवतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]