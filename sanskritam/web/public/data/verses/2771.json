[{"id": 2083094, "chapter_id": 2771, "verse_number": "१२-२७६-०x", "content_sanskrit": "कपिल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2083095, "chapter_id": 2771, "verse_number": "१२-२७६-१", "content_sanskrit": "वेदाः प्रमाणं लोकानां न वेदाः पृष्ठतः कृताः।\nद्वे ब्रह्मणी वेदितव्ये शब्दब्रह्म परं च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2083096, "chapter_id": 2771, "verse_number": "१२-२७६-२", "content_sanskrit": "शब्दब्रह्मणि निष्णातः परं ब्रह्माधिगच्छति।\nशरीरमेतत्कुरुते यद्वेदे कुरुते तनुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2083097, "chapter_id": 2771, "verse_number": "१२-२७६-३", "content_sanskrit": "कृतशुद्धशरीरो हि पात्रं भवति ब्राह्मणः।\nआनन्त्यमनुचिन्त्येदं कर्मणां तद्ब्रबीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2083098, "chapter_id": 2771, "verse_number": "१२-२७६-४", "content_sanskrit": "निरागममनैतिह्यमत्यक्षं लोकसाक्षिकम्।\nधर्म इत्येव ये यज्ञान्वितन्वन्ति निराशिषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2083099, "chapter_id": 2771, "verse_number": "१२-२७६-५", "content_sanskrit": "उत्पन्नत्यागिनो लुब्धाः कृपासूयाविवर्जिताः।\nधनिनामेष वै पन्थास्तीर्थेषु प्रतिपादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2083100, "chapter_id": 2771, "verse_number": "१२-२७६-६", "content_sanskrit": "अनाश्रिताः पापकृत्याः कदाचित्कर्मयोगिनः।\nमनः संकल्पसंसिद्धा विशुद्धज्ञाननिश्चयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2083101, "chapter_id": 2771, "verse_number": "१२-२७६-७", "content_sanskrit": "अक्रुध्यन्तोऽनसूयन्तो निरहंकारमत्सराः।\nज्ञाननिष्ठास्त्रिशुक्लाश्च सर्वभूतहिते रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2083102, "chapter_id": 2771, "verse_number": "१२-२७६-८", "content_sanskrit": "आसन्गृहस्था भूयिष्ठा अपक्रान्ताः स्वकर्मसु।\nराजानश्च तथा युक्ता ब्राह्मणाश्च यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2083103, "chapter_id": 2771, "verse_number": "१२-२७६-९", "content_sanskrit": "समा ह्यार्जवसंपन्नाः संतुष्टा ज्ञाननिश्चयाः।\nप्रत्यक्षधर्माः शुचयः श्रद्दधानाः परावरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2083104, "chapter_id": 2771, "verse_number": "१२-२७६-१०", "content_sanskrit": "पुरस्ताद्भावितात्मानो यथावच्चरितव्रताः।\nचरन्ति धर्मं कृच्छ्रेऽपि दुर्गे चैवापि संहताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2083105, "chapter_id": 2771, "verse_number": "१२-२७६-११", "content_sanskrit": "संहत्य धर्मं चरतां पुराऽऽसीत्सुखमेव तत्।\nतेषां नासीद्विधातव्यं प्रायश्चित्तं कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2083106, "chapter_id": 2771, "verse_number": "१२-२७६-१२", "content_sanskrit": "सत्यं हि धर्ममास्थाय दुराधर्षतमा मताः।\nन मात्रामनुरुध्यन्ते न धर्मच्छलमन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2083107, "chapter_id": 2771, "verse_number": "१२-२७६-१३", "content_sanskrit": "य एव प्रथमः कल्पस्तमेवात्र चरन्महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2083108, "chapter_id": 2771, "verse_number": "१२-२७६-१४", "content_sanskrit": "अस्यां स्थितौ स्थितानां हि प्रायश्चित्तं न विद्यते।\nयदा तु दुर्बलात्मानः प्रायश्चित्तं तदा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2083109, "chapter_id": 2771, "verse_number": "१२-२७६-१५", "content_sanskrit": "एत एवंविधाः प्राहुः पुराणा यज्ञवाहनाः।\nत्रैविद्यवृद्धाः शुचयो वृत्तवन्तो यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2083110, "chapter_id": 2771, "verse_number": "१२-२७६-१६", "content_sanskrit": "यजन्तोऽहरहर्यज्ञैर्निराशीर्बन्धना बुधाः।\nतेषा यज्ञाश्च वेदाश्च कर्माणि च यथागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2083111, "chapter_id": 2771, "verse_number": "१२-२७६-१७", "content_sanskrit": "आगमाश्च यथाकामं संकल्पाश्च यथाव्रतम्।\nअपेतकामक्रोधानां दुश्चराचारकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2083112, "chapter_id": 2771, "verse_number": "१२-२७६-१८", "content_sanskrit": "स्वकर्मभिः शंसितानां प्रकृत्या शंसितात्मनाम्।\nऋजूनां शमनित्यानां स्वेषु कर्मसु वर्तताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2083113, "chapter_id": 2771, "verse_number": "१२-२७६-१९", "content_sanskrit": "सर्वमानन्त्यमेवासीदिति नः शाश्वताश्चुतिः।\nतेषामदीनसत्वानां दुश्चराचारकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2083114, "chapter_id": 2771, "verse_number": "१२-२७६-२०", "content_sanskrit": "स्वकर्मभिः संसितानां तपो घोरत्वमागतम्।\nसं सदाचारमाश्चर्यं पुराणं शाश्वतं ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2083115, "chapter_id": 2771, "verse_number": "१२-२७६-२१", "content_sanskrit": "अशक्नुवद्भिश्चरितुं किंचिद्धर्मेषु सूचितम्।\nनिरापद्धर्म आचारो ह्यप्रमादोऽपराभवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2083116, "chapter_id": 2771, "verse_number": "१२-२७६-२२", "content_sanskrit": "सर्ववर्णेषु यत्तेषु नासीत्कश्चिद्व्यतिक्रमः।\nधर्ममेकं चतुष्पादमाश्रितास्ते नरा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2083117, "chapter_id": 2771, "verse_number": "१२-२७६-२३", "content_sanskrit": "तं सन्तो विधिवत्प्राप्य गच्छन्ति परमां गतिम्।\nगृहेभ्य एव निष्क्रम्य वनमन्ये समाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2083118, "chapter_id": 2771, "verse_number": "१२-२७६-२४", "content_sanskrit": "गृहमेवाभिसंश्रित्य ततोऽन्ये ब्रह्मचारिणः।\n`व्यस्तमेकं चतुर्धा तु ब्राह्मणा आश्रमं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2083119, "chapter_id": 2771, "verse_number": "१२-२७६-२५", "content_sanskrit": "सर्वे सर्वत्र तिष्ठन्तो गच्छन्ति परमां गतिम्।\nएव एवंविधाः प्राहुः पुराणा ब्रह्मचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2083120, "chapter_id": 2771, "verse_number": "१२-२७६-२६", "content_sanskrit": "त एते दिवि दृश्यन्ते ज्योतिर्भूता द्विजातयः।\nनक्षत्राणीव धिष्ण्येषु बहवस्तारकागणाः।\nआनन्त्यमुपसंप्राप्ताः संतोषादिति वैदिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2083121, "chapter_id": 2771, "verse_number": "१२-२७६-२७", "content_sanskrit": "यद्यागच्छन्ति संसारं पुनर्योनिषु तादृशाः।\nन लिप्यन्ते पारकृत्यैः कदाचित्कर्मयोनितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2083122, "chapter_id": 2771, "verse_number": "१२-२७६-२८", "content_sanskrit": "एवमेव ब्रह्मचारी शुश्रूषुर्घोरनिश्चयः।\nएवंयुक्तो ब्राह्मणः स्यादन्यो ब्राह्मणको भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2083123, "chapter_id": 2771, "verse_number": "१२-२७६-२९", "content_sanskrit": "कर्मैव पुरुषस्याह शुभं वा यदि वाऽशुभम्।\nएवं पक्वकषायाणामानन्त्येन श्रुतेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2083124, "chapter_id": 2771, "verse_number": "१२-२७६-३०", "content_sanskrit": "सर्वमानन्त्यमेवासीदिति नः शाश्वती श्रुतिः।\nतेषामपेततृष्णानां निर्णिक्तानां शुभात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2083125, "chapter_id": 2771, "verse_number": "१२-२७६-३१", "content_sanskrit": "चतुर्थ औपनिषदो धर्मः साधारणः स्मृतः।\nसंसिद्धैः सेव्यते नित्यं ब्राह्मणैर्नियतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2083126, "chapter_id": 2771, "verse_number": "१२-२७६-३२", "content_sanskrit": "संतोषमूलस्त्यागात्मा ज्ञानाधिष्ठानमुच्यते।\nअपवर्गमतिर्नित्यो यतिधर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2083127, "chapter_id": 2771, "verse_number": "१२-२७६-३३", "content_sanskrit": "साधारणः केवलो वा यथाबलमुपास्यते।\nगच्छन्ते बलिनः क्षेमं दुर्बलोऽत्रावसीदति।\nब्राह्मणः पदमन्विच्छन्संसारान्मुच्यते शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2083128, "chapter_id": 2771, "verse_number": "१२-२७६-३४x", "content_sanskrit": "स्यूमरश्मिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2083129, "chapter_id": 2771, "verse_number": "१२-२७६-३४", "content_sanskrit": "ये भुञ्जते ये ददते यजन्तेऽधीयते च ये।\nमात्राभिर्धर्मलुब्धाभिर्ये वा त्यागं समाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2083130, "chapter_id": 2771, "verse_number": "१२-२७६-३५", "content_sanskrit": "एतेषां प्रेत्यभावे तु कतमः स्वर्गजित्तमः।\nएतदाचक्ष्व मे ब्रह्मन्याथातथ्येन पृच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2083131, "chapter_id": 2771, "verse_number": "१२-२७६-३६x", "content_sanskrit": "कपिल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2083132, "chapter_id": 2771, "verse_number": "१२-२७६-३६", "content_sanskrit": "परिग्रहाः शुभाः सर्वे गुणतोऽभ्युदयाश्च ते।\nन तु त्यागसुखं प्राप्ता एतत्त्वमपि पश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2083133, "chapter_id": 2771, "verse_number": "१२-२७६-३७x", "content_sanskrit": "स्यूमरश्मिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2083134, "chapter_id": 2771, "verse_number": "१२-२७६-३७", "content_sanskrit": "भवन्तो ज्ञाननिष्ठा वै गृहस्थाः कर्मनिश्चयाः।\nआश्रमाणां च सर्वेषां निष्ठायामैक्यमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2083135, "chapter_id": 2771, "verse_number": "१२-२७६-३८", "content_sanskrit": "एकत्वेन पृथक्त्वेन विशेषो नान्य उच्यते।\nतद्यथावद्यथान्यायं भगवान्प्रब्रवीतु मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2083136, "chapter_id": 2771, "verse_number": "१२-२७६-३९x", "content_sanskrit": "कपिल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2083137, "chapter_id": 2771, "verse_number": "१२-२७६-३९", "content_sanskrit": "शरीरपक्तिः कर्माणि ज्ञानं तु परमा गतिः।\nपक्वे कषायविज्ञानं यथा ज्ञानं च तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2083138, "chapter_id": 2771, "verse_number": "१२-२७६-४०", "content_sanskrit": "आनृशंस्यं क्षमा शान्तिरहिंसा सत्यमार्जवम्।\nअद्रोहोऽनभिमानश्च ह्रीस्तितिक्षा शमस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2083139, "chapter_id": 2771, "verse_number": "१२-२७६-४१", "content_sanskrit": "पन्थानो ब्रह्मणस्त्वेत एतैः प्राप्नोति यत्परम्।\nतद्विद्वाननुबुद्ध्येत मनसा कर्मनिश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2083140, "chapter_id": 2771, "verse_number": "१२-२७६-४२", "content_sanskrit": "यां विप्राः सर्वतः शान्ता विशुद्धा ज्ञाननिश्चयाः।\nगतिं गच्छन्ति संतुष्टास्तामाहुः परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2083141, "chapter_id": 2771, "verse_number": "१२-२७६-४३", "content_sanskrit": "वेदांश्च वेदितव्यं च विदित्वा च यथास्थितिम्।\nएवं वेदविदित्याहुरतोऽन्यो वातरेचकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2083142, "chapter_id": 2771, "verse_number": "१२-२७६-४४", "content_sanskrit": "सर्वं विदुर्वेदविदो वेदे सर्वं प्रतिष्ठितम्।\nवेदे हि निष्ठा सर्वस्य यद्यदस्ति च नास्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2083143, "chapter_id": 2771, "verse_number": "१२-२७६-४५", "content_sanskrit": "एषैव निष्ठा सर्वत्र यत्तदस्ति च नास्ति च।\nएतदन्तं च मध्यं च सच्चाऽसच्च विजानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2083144, "chapter_id": 2771, "verse_number": "१२-२७६-४६", "content_sanskrit": "समाप्तं त्याग इत्येव शम इत्येव निश्चितम्।\nसंतोष इत्यनुगतमपवर्गे प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2083145, "chapter_id": 2771, "verse_number": "१२-२७६-४७", "content_sanskrit": "ऋतं सत्यं विदितं वेदितव्यं\nसर्वस्यात्मा स्थावरं जङ्गमं च।\nसर्वं सुखं यच्छिवमुत्तरं च\nब्रह्माव्यक्तं प्रभवश्चाव्ययं च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2083146, "chapter_id": 2771, "verse_number": "१२-२७६-४८", "content_sanskrit": "तेजः क्षमा शान्तिरनामयं शुभं\nतथाविधं व्योम सनातनं ध्रुवम्।\nएतैः शब्दैर्गम्यते बुद्धिनेत्रै\nस्तस्मै नमो ब्रह्मणे ब्राह्मणाय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2083147, "chapter_id": 2771, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि षट्सप्तत्यधिकद्विशततमोऽध्यायः॥ २७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]