[{"id": 7002579000, "chapter_id": 22579, "verse_number": "३-४-१", "content_sanskrit": "सूत उवाच ।\nपूर्णपात्रमथो वक्ष्ये यज्ञे साधारणेऽपि च ।\nकामहोमे भवेन्मुष्टिर्मुष्टयोष्टौ तु कुञ्चिका ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002579001, "chapter_id": 22579, "verse_number": "३-४-२", "content_sanskrit": "एकैक कुञ्चिमानेन कुर्यात्पात्राणि वै सदा ।\nपात्राणि च पृथक्कृत्वा स्थापयेद्द्वारदेशतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002579002, "chapter_id": 22579, "verse_number": "३-४-३", "content_sanskrit": "सिद्धानां खड्गधाराणां प्रत्येकस्य दिनक्रमात् ।\nतत्रैव दद्या न्नान्यत्र न कुर्याद्व्यत्ययं क्वचित् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002579003, "chapter_id": 22579, "verse_number": "३-४-४", "content_sanskrit": "कुण्डानां कुड्मलानां च वेदनं यादृशं शृणु ।\nचतुरस्रपदस्यापि रौप्यार्धं च कलौ युगे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002579004, "chapter_id": 22579, "verse_number": "३-४-५", "content_sanskrit": "द्वे रौप्ये सर्वतोभद्रे क्रौञ्चघ्राणे चतुर्थकम् ।\nमहासिंहासने पञ्च दशपात्रे तदर्धकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002579005, "chapter_id": 22579, "verse_number": "३-४-६", "content_sanskrit": "सहस्रारे मेरुपृष्ठे तुर्यरौप्यवृषाधिकम् ।\nवृषे गले च वृषभं शेषे रौप्यसहस्रकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002579006, "chapter_id": 22579, "verse_number": "३-४-७", "content_sanskrit": "चतुरस्रस्य निर्माणे स्वर्णपादः कलौ युगे ।\nमहाकुण्डे तु द्विगुणं वृत्ते रौप्यं निवेदयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002579007, "chapter_id": 22579, "verse_number": "३-४-८", "content_sanskrit": "पद्मकुण्डे तु वृषभमर्ध चन्द्रे तु रौप्यकम् ।\nयोनिकुण्डे ददेद्धेनुमष्टार्धस्वर्णमाषकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002579008, "chapter_id": 22579, "verse_number": "३-४-९", "content_sanskrit": "षडस्रे तु तदर्धं स्याद्यागे माषद्वयं भवेत् ।\nशैवे चोद्यापने चैव प्रत्यह्ना स्वर्णमाषकम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002579009, "chapter_id": 22579, "verse_number": "३-४-१०", "content_sanskrit": "दारणे हस्तमात्रं स्यात्स्वर्णकृष्णकलं भवेत् ।\nइष्टिकाकरणे चैव प्रत्यह्ना स्यात्पणद्वयम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002579010, "chapter_id": 22579, "verse_number": "३-४-११", "content_sanskrit": "खण्डे दशवराटं स्याद्बृ हन्माने तु काकिणी ।\nतडागे पुष्करिण्यां च खनने प्रथमांगके ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002579011, "chapter_id": 22579, "verse_number": "३-४-१२", "content_sanskrit": "सप्तहस्तमिते कुण्डे निष्ठे आबद्धमात्रकम् ।\nपुराणस्य च एकांशं वेतनं परिकीर्तितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002579012, "chapter_id": 22579, "verse_number": "३-४-१३", "content_sanskrit": "वर्धयेत्पणमात्रेण निम्ने पत्रे च प्रक्रमात् ।\nबृहत्कूपस्य निर्माणे प्रत्यहं च पणद्वयम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002579013, "chapter_id": 22579, "verse_number": "३-४-१४", "content_sanskrit": "शैले ज्ञेयं काञ्चनस्य रत्तिका गृहकर्मणि ।\nकोष्ठे ज्ञेयं सार्द्धपणं रंगादिरचिते पणम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002579014, "chapter_id": 22579, "verse_number": "३-४-१५", "content_sanskrit": "वृक्षाणां रोपणे दद्यात्प्रत्यह्ना सार्धमाषकम् ।\nसेतुबंधे च पंकिले च पणद्वयं च काकिणी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002579015, "chapter_id": 22579, "verse_number": "३-४-१६", "content_sanskrit": "पणेपणे तु ताम्रस्य दद्यात्पणचतुष्टयम् ।\nघटने कांस्यसीसानां पणत्रयमुदाहृतम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002579016, "chapter_id": 22579, "verse_number": "३-४-१७", "content_sanskrit": "अथ वा दिनसंख्यानं पणैकं च सकाकिणि ।\nसुवर्णस्य पणैके तु पुराणं रत्नकुट्टिमे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002579017, "chapter_id": 22579, "verse_number": "३-४-१८", "content_sanskrit": "रजते तु तदर्धं स्यात्स्फटिकस्य च दारणे ।\nदिनसंख्यापणद्वंद्वं रत्नानामथ कुड्मलम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002579018, "chapter_id": 22579, "verse_number": "३-४-१९", "content_sanskrit": "मणिवेधे मणौ ज्ञेयं काकिणी परिकीर्तिता ।\nचतुर्वराटमधिकं स्फाटिके मणिवेधने ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002579019, "chapter_id": 22579, "verse_number": "३-४-२०", "content_sanskrit": "कांस्यतालस्य निर्माणे धमने तु पणत्रयम् ।\nलाक्षानिर्माणके कार्ये तदर्धमपि कीर्तितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002579020, "chapter_id": 22579, "verse_number": "३-४-२१", "content_sanskrit": "गवां च दोहने चैव वराटे तुर्यवेतनम् ।\nवेतने वस्त्रनिर्माणे पत्रे हस्तपणत्रयम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002579021, "chapter_id": 22579, "verse_number": "३-४-२२", "content_sanskrit": "अविवस्त्रस्य निर्माणे स्यंदनं दशकाकिणी ।\nपिधानवस्त्रनिर्माणे त्रिपणं परिकीर्तितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002579022, "chapter_id": 22579, "verse_number": "३-४-२३", "content_sanskrit": "दश काकिणी ऊर्ध्वाधस्तद्व्यये पण्यवेतनम् ।\nवंशाजीवस्य प्रत्यह्ना पणस्यार्धे सकाकिणि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002579023, "chapter_id": 22579, "verse_number": "३-४-२४", "content_sanskrit": "लोहकारस्य च तथा नापितस्य च वेतनम् ।\nशिरसा तस्य वपने विज्ञेया दश काकिणी ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002579024, "chapter_id": 22579, "verse_number": "३-४-२५", "content_sanskrit": "सश्मश्रुनखमाने तु प्रदद्यात्काकिणीद्वयम् ।\nनारीणामथ संस्कारे नखचित्रादिरञ्जने ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002579025, "chapter_id": 22579, "verse_number": "३-४-२६", "content_sanskrit": "सकाकिणि पणं तच्च सवित्रे च पयोधरे ।\nपणानां तुर्यकं दद्यात्सीमंतस्यालके तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002579026, "chapter_id": 22579, "verse_number": "३-४-२७", "content_sanskrit": "पदचित्रे तु सार्द्धं स्याद्ग्रीवाणां गुह्यधारणे ।\nधान्यानां रोपणे चैव दिनैके पण वेतनम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002579027, "chapter_id": 22579, "verse_number": "३-४-२८", "content_sanskrit": "लवणे तु तथा देया गुवाकानां च रोपणे ।\nदण्डपत्रस्य संस्कारे मरिचानां तथैव च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002579028, "chapter_id": 22579, "verse_number": "३-४-२९", "content_sanskrit": "पणद्वयं वराटानामधिकं दशमेव तु ।\nहलेहले पणैकं स्यात्काकिण्यधिकमेव च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002579029, "chapter_id": 22579, "verse_number": "३-४-३०", "content_sanskrit": "पणत्रयं चक्रपणे महिषाणां पणाधिकम् ।\nनराणां वाहने चैव पणैकं दश काकिणी ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002579030, "chapter_id": 22579, "verse_number": "३-४-३१", "content_sanskrit": "दासीनां गर्दभानां च अधिकं काकिणीद्वयात् ।\nक्षालने चापि वस्त्रस्य तैलक्षारविवर्जिते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002579031, "chapter_id": 22579, "verse_number": "३-४-३२", "content_sanskrit": "वस्त्रे प्रतिपणं दद्याद्दीर्घे प्रस्थेऽपि वर्धयेत् ।\nसद्यः प्रक्षालनेऽप्यर्धं दिनादावधिकं भवेद् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002579032, "chapter_id": 22579, "verse_number": "३-४-३३", "content_sanskrit": "श्वेतवस्त्रे भवेन्न्यूनं पदे सूक्ष्मे च वर्द्धयेत् ।\nमृत्तिकानां समुद्धारं कुद्दाले चेक्षुपीडने ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002579033, "chapter_id": 22579, "verse_number": "३-४-३४", "content_sanskrit": "वेतनं पुष्पसंस्कारे सहस्रं दशकाकिणी ।\nकाकिणी स्रङ्निबद्धे च द्विगुणं कण्ठमालिका ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002579034, "chapter_id": 22579, "verse_number": "३-४-३५", "content_sanskrit": "अबद्धे द्व्यंगुलं यावन्मुण्डमाला प्रकीर्तिता ।\nहस्तत्रये कण्ठमाला आनाभि कमलावधि ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002579035, "chapter_id": 22579, "verse_number": "३-४-३६", "content_sanskrit": "काकिणीकत्रयं चैव निर्माणे द्विजसत्तमाः ।\nमालत्याश्च तुलस्याश्च जातियूथ्योश्च सत्तमाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002579036, "chapter_id": 22579, "verse_number": "३-४-३७", "content_sanskrit": "तदर्धार्धं मारुतेन दमने बकुलस्य च ।\nवेतनं दीपतैले च आज्यस्य परिवर्धयेत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002579037, "chapter_id": 22579, "verse_number": "३-४-३८", "content_sanskrit": "यामेयामे रौप्यमाषं स्नेहे चैव तु काकिणी ।\nसार्धांगुलप्रमाणेन वस्त्रवर्तिं विदुर्बुधाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002579038, "chapter_id": 22579, "verse_number": "३-४-३९", "content_sanskrit": "षडंगुलेन दैर्घ्यं च न न्यूनं नाधिकं भवेत् ।\nपञ्चविंशतिभिः संख्या तंतुभिर्द्विजसत्तमाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002579039, "chapter_id": 22579, "verse_number": "३-४-४०", "content_sanskrit": "पञ्चाङ्गुलेन मानेन कर्तव्यः सुसमाहितः ।\nहस्तोच्छ्राये प्रदद्यात्तु मुष्टिहस्ते तु मध्यमम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002579040, "chapter_id": 22579, "verse_number": "३-४-४१", "content_sanskrit": "त्रिहस्ते चतुर्हस्ते वा उत्तमं मानमीरितम् ।\nस्वर्णधारे हतो राजा रजते सर्वकामदः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002579041, "chapter_id": 22579, "verse_number": "३-४-४२", "content_sanskrit": "ताम्रे चायुःक्षयकरमायसे दुर्गतिप्रदः ।\nशस्तस्य करमर्दस्य प्रशस्तोत्तर उच्यते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002579042, "chapter_id": 22579, "verse_number": "३-४-४३", "content_sanskrit": "दीपाधारं कांस्यमयं तथारीतिमयस्य च ।\nअभावे मृन्मयस्यैव मृन्मये मानवर्जितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002579043, "chapter_id": 22579, "verse_number": "३-४-४४", "content_sanskrit": "दशाङ्गधूपके मूल्यं विंशके तु पणत्रयम् ।\nद्वादशकांगुलेऽप्यर्धवर्तिं धूपाय वर्तयेत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002579044, "chapter_id": 22579, "verse_number": "३-४-४५", "content_sanskrit": "हस्ते पंचप्रमाणं च वस्त्रैः कुर्याच्च वर्तिकाम् ।\nपञ्चविंशतिभिर्वा यः स महावर्तिरुच्यते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]