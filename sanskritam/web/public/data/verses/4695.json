[{"id": 2173684, "chapter_id": 4695, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2173685, "chapter_id": 4695, "verse_number": "१", "content_sanskrit": "पुत्रस्तु ते महाराज रथस्थो रथिनां वरः ।\nदुराधर्षो बभौ युद्धे यथा रुद्रः प्रतापवान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2173686, "chapter_id": 4695, "verse_number": "२", "content_sanskrit": "तस्य बाणसहस्रैस्तु प्रच्छन्ना ह्यभवन्मही ।\nपरांश्च सिषिचे बाणैर्धाराभिरिव पर्वतान्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2173687, "chapter_id": 4695, "verse_number": "३", "content_sanskrit": "न च सोऽस्ति पुमान् कश्चित् पाण्डवानां बलार्णवे ।\nहतो गजो रथो वाऽपि योऽस्य बाणैरविक्षतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2173688, "chapter_id": 4695, "verse_number": "४", "content_sanskrit": "यं यं हि समरे योधं प्रपश्यामि विशाम्पते ।\nस स बाणैश्चितोऽभूद्वै तव पुत्रेण भारत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2173689, "chapter_id": 4695, "verse_number": "५", "content_sanskrit": "यथा सैन्येन रजसा समुद्धूतेन वाहिनी ।\nप्रत्यदृश्यत सञ्छन्ना तथा बाणैर्महात्मनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2173690, "chapter_id": 4695, "verse_number": "६", "content_sanskrit": "बाणभूतामपश्याम पृथिवीं पृथिवीपते ।\nदुर्योधनेनापतता क्षिप्रहस्तेन धन्विना\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2173691, "chapter_id": 4695, "verse_number": "७", "content_sanskrit": "तेषु योधसहस्रेषु तावकेषु परेषु च ।\nएको दुर्योधनश्चासीत् तत्र तत्र मतिर्मम\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2173692, "chapter_id": 4695, "verse_number": "८", "content_sanskrit": "अत्राद्भुतमपश्याम तव पुत्रस्य विक्रमम् ।\nयदेकं सहिताः पार्था नात्यवर्तन्त भारत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2173693, "chapter_id": 4695, "verse_number": "९", "content_sanskrit": "युधिष्ठिरं शतेनाजौ विव्याध भरतर्षभ ।\nभीमसेनं त्रिसप्तत्या सहदेवं च पञ्चभिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2173694, "chapter_id": 4695, "verse_number": "१०", "content_sanskrit": "नकुलं च चतुःषष्ट्या धृष्टद्युम्नं च पञ्चभिः ।\nसप्तभिर्द्रौपदेयांश्च त्रिभिर्विव्याध सात्यकिम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2173695, "chapter_id": 4695, "verse_number": "११", "content_sanskrit": "धनुश्चिच्छेद भल्लेन सहदेवस्य भारत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2173696, "chapter_id": 4695, "verse_number": "१२", "content_sanskrit": "तदपास्य धनुश्छिन्नं माद्रीपुत्रः प्रतापवान् ।\nअभ्यधावत राजानं प्रगृह्य सुमहद्धनुः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2173697, "chapter_id": 4695, "verse_number": "१३", "content_sanskrit": "ततो दुर्योधनं सङ्खे विव्याध दशभिः शरैः ।\nनकुलश्च ततो वीरो राजानं नवभिः पुनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2173698, "chapter_id": 4695, "verse_number": "१४", "content_sanskrit": "घोररूपैर्महेष्वासो विव्याध च ननाद च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2173699, "chapter_id": 4695, "verse_number": "१५", "content_sanskrit": "सात्यकिश्चापि राजानं शरेण नतपर्वणा ।\nद्रौपदेयास्त्रिसप्तत्या धर्मराजश्च पञ्चभिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2173700, "chapter_id": 4695, "verse_number": "१६", "content_sanskrit": "अशीत्या भीमसेनश्च शरैः राजानमर्दयन्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2173701, "chapter_id": 4695, "verse_number": "१७", "content_sanskrit": "समन्तात् कीर्यमाणस्तु बाणसङ्घैर्महात्मभिः ।\nन चचाल महाराज सर्वसैन्यस्य पश्यतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2173702, "chapter_id": 4695, "verse_number": "१८", "content_sanskrit": "लाघवात् सौष्ठवाच्चापि वीर्याच्चापि महात्मनः ।\nअति सर्वाणि भूतानि ददृशुः सर्वमानवाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2173703, "chapter_id": 4695, "verse_number": "१९", "content_sanskrit": "धार्तराष्ट्रस्य राजेन्द्र यात्वा हि स्वल्पमन्तरम् ।\nअपश्यमाना राजानं पर्यधावन्त दंसिताः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2173704, "chapter_id": 4695, "verse_number": "२०", "content_sanskrit": "तेषामापततां घोषः तुमुलः समजायत ।\nक्षुब्धस्य हि समुद्रस्य प्रावृट्काले यथा निशि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2173705, "chapter_id": 4695, "verse_number": "२१", "content_sanskrit": "समासाद्य रणे ते तु राजानमपराजितम् ।\nप्रत्युद्ययुर्महेष्वासाः पाण्डवानाततायिनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2173706, "chapter_id": 4695, "verse_number": "२२", "content_sanskrit": "भीमसेनं रणे क्रुद्धं द्रोणपुत्रो न्यवारयत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2173707, "chapter_id": 4695, "verse_number": "२३", "content_sanskrit": "ततो बाणैर्महाराज प्रमुक्तैः सर्वतो दिशम् ।\nनाज्ञायन्त रणे वीरा न दिशः प्रदिशस्तथा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2173708, "chapter_id": 4695, "verse_number": "२४", "content_sanskrit": "तावुभौ कृतकर्माणावुभौ भारत दुःसहौ ।\nघोररूपमयुध्येतां कृतप्रतिकृतैषिणौ\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2173709, "chapter_id": 4695, "verse_number": "२५", "content_sanskrit": "त्रासयन्तौ जगत् सर्वं ज्याक्षेपविहतत्वचौ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2173710, "chapter_id": 4695, "verse_number": "२६", "content_sanskrit": "शकुनिश्च धनुश्छित्वा युधिष्ठिरमपीडयत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2173711, "chapter_id": 4695, "verse_number": "२७", "content_sanskrit": "तस्यांश्वांश्चतुरो हत्वा सुबलस्य सुतो विभुः ।\nनादं चकार बलवान् सर्वसैन्यानि कम्पयन्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2173712, "chapter_id": 4695, "verse_number": "२८", "content_sanskrit": "एतस्मिन्नन्तरे वीरो राजानमपराजितम् ।\nअपोवाह रथेनाजौ सहदेवः प्रतापवान्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2173713, "chapter_id": 4695, "verse_number": "२९", "content_sanskrit": "अथान्यं रथमास्थाय धर्मराजो युधिष्ठिरः ।\nशकुनिं नवभिर्विद्ध्वा पुनर्विव्याध पञ्चभिः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2173714, "chapter_id": 4695, "verse_number": "३०", "content_sanskrit": "ननाद च महानादं प्रवरः सर्वधन्विनाम् ।\nतद् युद्धमभवच्चित्रं घोररूपं च मारिष\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2173715, "chapter_id": 4695, "verse_number": "३१", "content_sanskrit": "ईक्षितृप्रीतिजननं सिद्धचारणसेवितम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2173716, "chapter_id": 4695, "verse_number": "३२", "content_sanskrit": "उलूकस्तु महेष्वासो नकुलं युद्धदुर्मदम् ।\nअभ्यद्रवदमेयात्मा शरवर्षैः समन्ततः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2173717, "chapter_id": 4695, "verse_number": "३३", "content_sanskrit": "तथैव नकुलः शूरः सौबलस्य सुतं रणे ।\nशरवर्षेण महता समन्तात् पर्यवारयत्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2173718, "chapter_id": 4695, "verse_number": "३४", "content_sanskrit": "तौ तत्र समरे वीरौ कुलपुत्रौ महारथौ ।\nयोधयन्तावदृश्येतां परस्परकृतागसौ\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2173719, "chapter_id": 4695, "verse_number": "३५", "content_sanskrit": "तथैव कृतवर्मा तु शैनेयं शत्रुतापनम् ।\nयोधयन् शुशुभे राजन् बलिः शक्रमिवाहवे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2173720, "chapter_id": 4695, "verse_number": "३६", "content_sanskrit": "दुर्योधनो धनुश्छित्वा धृष्टद्युम्नश्च संयुगे ।\nअथैनं छिन्नधन्वानं विव्याध निशितैः शरैः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2173721, "chapter_id": 4695, "verse_number": "३७", "content_sanskrit": "धृष्टद्युम्नोऽपि समरे प्रगृह्य सुमहायुधम् ।\nराजानं योधयामास पश्यतां सर्वधन्विनाम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2173722, "chapter_id": 4695, "verse_number": "३८", "content_sanskrit": "तयोर्युद्धं महच्चासीत् सङ्क्रन्दे भरतर्षभ ।\nप्रभिन्नयोर्यथा सक्तं मत्तयोर्वनहस्तिनोः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2173723, "chapter_id": 4695, "verse_number": "३९", "content_sanskrit": "गौतमस्तु रणे क्रुद्धो द्रौपदेयान् महाबलान् ।\nविव्याध बहुभिर्घोरैः शरैः सन्नतपर्वभिः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2173724, "chapter_id": 4695, "verse_number": "४०", "content_sanskrit": "तस्य तैरभवद् युद्धमिन्द्रियैरिव देहिनः ।\nघोररूपमसंहार्यं निर्मर्यादमतीव च\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2173725, "chapter_id": 4695, "verse_number": "४१", "content_sanskrit": "ते च तं पीडयामासुरिन्द्रियाणीव बालिशम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2173726, "chapter_id": 4695, "verse_number": "४२", "content_sanskrit": "स च तान् प्रतिसंरब्धः प्रत्ययोधयदाहवे ।\nएवं चित्रमभूद् युद्धं तस्य तैः सह भारत\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2173727, "chapter_id": 4695, "verse_number": "४३", "content_sanskrit": "उत्थायोत्थाय हि यथा देहिनामिन्द्रियैर्विभो ।\nनराश्चैव नरैः सार्धं दन्तिनो दन्तिभिस्तथा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2173728, "chapter_id": 4695, "verse_number": "४४", "content_sanskrit": "हया हयैः समासक्ता रथिनो रथिभिस्तथा ।\nसङ्कुलं चाभवद् भूयो घोररूपं विशाम्पते\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2173729, "chapter_id": 4695, "verse_number": "४५", "content_sanskrit": "इदं चित्रमिदं घोरमिदं रौद्रमिति प्रभो ।\nयुद्धान्यासन् महाराज घोराणि च बहूनि च\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2173730, "chapter_id": 4695, "verse_number": "४६", "content_sanskrit": "ते समासाद्य समरे परस्परमरिन्दमाः ।\nविव्यधुश्चैव जघ्नुश्च समाभाष्य महाबलाः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2173731, "chapter_id": 4695, "verse_number": "४७", "content_sanskrit": "तेषां रथसमुद्भूतं रजस्तीव्रमदृश्यत ।\nप्रवातेनोद्धतं राजन् धावद्भिश्चाश्वसादिभिः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2173732, "chapter_id": 4695, "verse_number": "४८", "content_sanskrit": "रथनेमिसमुद्भूतं निरश्वासैश्चापि दन्तिनाम् ।\nरजःसन्ध्याभ्रकलिलं दिवाकरपथं ययौ\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2173733, "chapter_id": 4695, "verse_number": "४९", "content_sanskrit": "रजसा तेन सम्पृक्ते भास्करे निष्प्रभीकृते ।\nसञ्छादिताऽभवद् भूमिस्ते च शूरा महारथाः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2173734, "chapter_id": 4695, "verse_number": "५०", "content_sanskrit": "मुहूर्तमिव सम्पृक्तं विरजस्कं समन्ततः ।\nवीरशोणितसिक्तायां भूमौ भरतसत्तम\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2173735, "chapter_id": 4695, "verse_number": "५१", "content_sanskrit": "उपाशाम्यत् ततस्तीव्रं तद्रजो घोरदर्शनम् ।\nततोऽपश्यं महाराज द्वन्द्वयुद्धानि भारत\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2173736, "chapter_id": 4695, "verse_number": "५२", "content_sanskrit": "प्रग्रहं च यथा श्रेष्ठं मध्याह्ने वै सुदारुणे ।\nवर्मणां तत्र राजेन्द्र व्यदृश्यन्तोज्ज्वलत्प्रभाः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2173737, "chapter_id": 4695, "verse_number": "५३", "content_sanskrit": "शब्दस्तु तुमुलःसङ्खे शराणां पततामभूत् ।\nमहावेणुवनस्येव दह्यमानस्य पर्वते\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2173738, "chapter_id": 4695, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि द्वाविंशोऽध्यायः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2173739, "chapter_id": 4695, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि द्वाविंशोऽध्यायः ॥२२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]