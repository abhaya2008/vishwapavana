[{"id": 50012893, "chapter_id": 11501, "verse_number": "1", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50012894, "chapter_id": 11501, "verse_number": "2", "content_sanskrit": "हिरण्यकशिपू राजन्नजेयमजरामरम्। आत्मानमप्रतिद्वन्द्वमेकराजं व्यधित्सत॥ ७/३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50012895, "chapter_id": 11501, "verse_number": "3", "content_sanskrit": "स तेपे मन्दरद्रोण्यां तपः परमदारुणम्। ऊर्ध्वबाहुर्नभोदृष्टिः पादाङ्गुष्ठाश्रितावनिः॥ ७/३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50012896, "chapter_id": 11501, "verse_number": "4", "content_sanskrit": "जटादीधितिभी रेजे संवर्तार्क इवांशुभिः। तस्मिंस्तपस्तप्यमाने देवाः स्थानानि भेजिरे॥ ७/३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50012897, "chapter_id": 11501, "verse_number": "5", "content_sanskrit": "तस्य मूर्ध्नः समुद्भूतः सधूम्रोऽग्निस्तपोमयः। तिर्यगूर्ध्वमधोलोकानतपद् विष्वगीरितः॥ ७/३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50012898, "chapter_id": 11501, "verse_number": "6", "content_sanskrit": "चुक्षुभुर्नद्युदन्वन्तः सद्वीपाद्रिश्चचाल भूः। निपेतुः सग्रहास्तारा जज्वलुश्च दिशो दश॥ ७/३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50012899, "chapter_id": 11501, "verse_number": "7", "content_sanskrit": "तेन तप्ता दिवं त्यक्त्वा ब्रह्मलोकं ययुः सुराः। धात्रे विज्ञापयामासुर्देवदेव जगत्पते॥ ७/३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50012900, "chapter_id": 11501, "verse_number": "8", "content_sanskrit": "दैत्येन्द्रतपसा तप्ता दिवि स्थातुं न शक्नुमः। तस्य चोपशमं भूमन् विधेहि यदि मन्यसे॥ ७/३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50012901, "chapter_id": 11501, "verse_number": "9", "content_sanskrit": "लोका न यावन्नङ्क्ष्यन्ति बलिहारास्तवापि भो। तस्यायं किल सङ्कल्पश्चरतो दुश्चरं तपः॥ ७/३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50012902, "chapter_id": 11501, "verse_number": "10", "content_sanskrit": "श्रूयतां किन्न्वविदितं तथापि स निवेद्यते। सृष्ट्वा चराचरमिदं तपोयोगसमाधिना॥ ७/३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50012903, "chapter_id": 11501, "verse_number": "11", "content_sanskrit": "अध्यास्ते सर्वधिष्ण्येभ्यः परमेष्ठी निजासनम्। तदहं वर्धमानेन तपोयज्ञसमाधिना॥ ७/३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50012904, "chapter_id": 11501, "verse_number": "12", "content_sanskrit": "कालात्मनोश्च नित्यत्वात् साधयिष्ये तथाऽऽत्मनः॥ ७/३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50012905, "chapter_id": 11501, "verse_number": "13", "content_sanskrit": "अन्यथेदं विधास्येऽहमयथापूर्वमोजसा। किमन्यैः कालनिर्धूतैः कल्पान्तैर्वैष्णवादिभिः॥ ७/३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50012906, "chapter_id": 11501, "verse_number": "14", "content_sanskrit": "इति शुश्रुम निर्बन्धं तपः परममास्थितः। विधत्स्वानन्तरं युक्तं स्वयं त्रिभुवनेश्वर॥ ७/३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50012907, "chapter_id": 11501, "verse_number": "15", "content_sanskrit": "तवासनं हि जगतां पारमेष्ठ्यं जगत्पते। भवाय श्रेयसे भूत्यै क्षेमाय विजयाय च॥ ७/३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50012908, "chapter_id": 11501, "verse_number": "16", "content_sanskrit": "इति विज्ञापितो देवैर्भगवानात्मभूर्नृप। परीतो भृगुदक्षाद्यैर्ययौ दैत्येश्वराश्रमम्॥ ७/३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50012909, "chapter_id": 11501, "verse_number": "17", "content_sanskrit": "तं ददर्श प्रतिच्छन्नं वल्मीकतृणकाचकैः। पिपीलिकाभिराकीर्णं मेदत्वङ्मांसशोणितम्॥ ७/३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50012910, "chapter_id": 11501, "verse_number": "18", "content_sanskrit": "तपन्तं तपसा लोकान् यथा भाविततं रविम्। विलक्ष्य विस्मितः प्राह हसंस्तं हंसवाहनः॥ ७/३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50012911, "chapter_id": 11501, "verse_number": "19", "content_sanskrit": "ब्रह्मोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50012912, "chapter_id": 11501, "verse_number": "20", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ भद्रं ते तपास्स्द्धोऽसि काश्यप। वरदोऽहमनुप्राप्तो व्रियतामीप्सितो वरः॥ ७/३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50012913, "chapter_id": 11501, "verse_number": "21", "content_sanskrit": "अद्राक्षमहमेतत् ते हृत्सारं महदद्भुतम्। दंशभक्षितदेहस्य प्राणा ह्यस्थिषु शेरते॥ ७/३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50012914, "chapter_id": 11501, "verse_number": "22", "content_sanskrit": "नैतत् पूर्वर्षयश्चक्रुर्न करिष्यन्ति चापरे। निरम्बुर्धारयेत् प्राणान् को वै दिव्यसमाः शतम्॥ ७/३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50012915, "chapter_id": 11501, "verse_number": "23", "content_sanskrit": "व्यवसायेन तेऽनेन दुष्करेणामनस्विभिः। तपोनिष्ठेन भवता जितोऽहं दितिनन्दन॥ ७/३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50012916, "chapter_id": 11501, "verse_number": "24", "content_sanskrit": "ततस्त आशिषः सर्वा ददान्यसुरपुङ्गव। मर्त्यस्य ते ह्यमर्त्यस्य दर्शनं न च निष्फलम्॥ ७/३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50012917, "chapter_id": 11501, "verse_number": "25", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50012918, "chapter_id": 11501, "verse_number": "26", "content_sanskrit": "इत्युक्त्वाऽऽदिभवो देवो भक्षिताङ्गं पिपीलिकैः। कमण्डलुजलेनौक्षद् दिव्येनामोघराधसा॥ ७/३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50012919, "chapter_id": 11501, "verse_number": "27", "content_sanskrit": "ततः कीचकवल्मीकात् सहओजोबलान्वितः। सर्वावयवसम्पन्नो वज्रसंहननो युवा। उत्थितस्तप्तहेमाभो विभावसुरिवैधसः॥ ७/३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50012920, "chapter_id": 11501, "verse_number": "28", "content_sanskrit": "स निरीक्ष्याम्बरे देवं हंसवाहमवस्थितम्। ननाम शिरसा भूमौ तद्दर्शनमहोत्सवः॥ ७/३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50012921, "chapter_id": 11501, "verse_number": "29", "content_sanskrit": "उत्थाय प्राञ्जलिः प्रह्व ईक्षमाणो दृशा विभुम्। हर्षाश्रुपुळकोद्भेदो गिरा गद्गदयाऽगृणत्॥ ७/३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50012922, "chapter_id": 11501, "verse_number": "30", "content_sanskrit": "हिरण्यकशिपुरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50012923, "chapter_id": 11501, "verse_number": "31", "content_sanskrit": "कल्पान्ते कालसृष्टेन योऽन्धेन तमसाऽऽवृतम्। अभिव्यनग् जगदिदं स्वयञ्ज्योतिः स्वरोचिषा॥ ७/३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50012924, "chapter_id": 11501, "verse_number": "32", "content_sanskrit": "आत्मना त्रिवृता चेदं सृजत्यवति लुम्पति। रजःसत्वतमोधाम्ने पराय महते नमः॥ ७/३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50012925, "chapter_id": 11501, "verse_number": "33", "content_sanskrit": "नम आद्याय बीजाय ज्ञानविज्ञानमूर्तये। प्राणेन्द्रियमनोबुद्धिविकारैर्व्यक्तिमीयुषे॥ ७/३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50012926, "chapter_id": 11501, "verse_number": "34", "content_sanskrit": "त्वमीशिषे जगतस्तस्थुषश्च प्राणेन मुख्येन पतिः प्रजानाम्। चित्तस्य चित्तिर्मन इन्द्रियाणां पतिर्महाभूतगुणाशयेशः॥ ७/३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50012927, "chapter_id": 11501, "verse_number": "35", "content_sanskrit": "त्वं सप्ततन्तून् वितनोषि तन्वा त्रय्या चतुर्होत्रकविद्यया च। त्वमेक आत्माऽऽत्मवतामनादिरनन्तपारः कविरव्ययात्मा॥ ७/३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50012928, "chapter_id": 11501, "verse_number": "36", "content_sanskrit": "त्वमेव कालोऽनिमिषो जनानामायुः कलाद्यावयवैः क्षिणोषि। कूटस्थ आत्मा परमेष्ठ्यजो महान् त्वं जीवलोकस्य च जीव आत्मा॥ ७/३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50012929, "chapter_id": 11501, "verse_number": "37", "content_sanskrit": "त्वत्तः परं नापरमप्यनेजदेजच्च किञ्चिद् व्यतिरिक्तमस्ति। विद्याकलास्ते तनवश्च सर्वा हिरण्यगर्भोऽसि बृहत् त्रिपृष्ठः॥ ७/३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50012930, "chapter_id": 11501, "verse_number": "38", "content_sanskrit": "व्यक्तं विभो स्थूलमिदं शरीरं येनेन्द्रियप्राणमनोगुणांस्त्वम्। भुङ्क्षे स्थितो धामनि पारमेष्ठ्ये अव्यक्त आत्मा पुरुषः पुराणः॥ ७/३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50012931, "chapter_id": 11501, "verse_number": "39", "content_sanskrit": "अनन्ताव्यक्तरूपेण येनेदमखिलं ततम्। चिदचिच्छक्तियुक्ताय तस्मै भगवते नमः॥ ७/३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50012932, "chapter_id": 11501, "verse_number": "40", "content_sanskrit": "यदि दास्यस्यभिमतान् वरान् मे वरदोत्तम। भूतेभ्यस्त्वद्विसृष्टेभ्यो मृत्युर्मा भून्मम प्रभो॥ ७/३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50012933, "chapter_id": 11501, "verse_number": "41", "content_sanskrit": "नान्तर्बहिर्दिवानक्तमन्यस्मादपि चायुधैः। न भूमौ नाम्बरे मृत्युर्न नरैर्न मृगैरपि॥ ७/३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50012934, "chapter_id": 11501, "verse_number": "42", "content_sanskrit": "व्यसुभिर्वाऽसुमद्भिर्वा सुरासुरमहोरगैः। अप्रतिद्वन्द्वतां युद्धे ऐकपत्यं च देहिनाम्॥ ७/३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50012935, "chapter_id": 11501, "verse_number": "43", "content_sanskrit": "सर्वेषां लोकपालानां महिमानं तथाऽऽत्मनः। तपोयोगप्रभावेन यो न रिष्यति कर्हिचित्॥ ७/३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50012936, "chapter_id": 11501, "verse_number": "44", "content_sanskrit": "इति श्रीमद्भागवते सप्तमस्कन्धे तृतीयोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]