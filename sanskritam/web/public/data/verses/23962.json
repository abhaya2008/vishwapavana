[{"id": 7003962000, "chapter_id": 23962, "verse_number": "३-१-२५-१", "content_sanskrit": "श्रीसूत उवाच ।\nशिवतीर्थे नरः स्नात्वा ब्रह्महत्याविमोक्षणे ।\nस्वपापजालशांत्यर्थं शंखतीर्थं ततो व्रजेत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003962001, "chapter_id": 23962, "verse_number": "३-१-२५-२", "content_sanskrit": "यत्र मज्जनमात्रेण कृतघ्नोऽपि विमुच्यते ।\nमातॄः पितॄन्गुरूंश्चापि ये न मन्यंति मोहिताः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003962002, "chapter_id": 23962, "verse_number": "३-१-२५-३", "content_sanskrit": "ये चाप्यन्ये दुरात्मानः कृतघ्ना निरपत्रपाः ।\nते सर्वे शंखतीर्थे स्मिञ्छुद्ध्यंति स्नानमात्रतः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003962003, "chapter_id": 23962, "verse_number": "३-१-२५-४", "content_sanskrit": "शंखनामा मुनिः पूर्वं गंधमादनपर्वते ।\nअवर्तत तपः कुर्वन्विष्णुं ध्यायन्समाहितः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003962004, "chapter_id": 23962, "verse_number": "३-१-२५-५", "content_sanskrit": "स तत्र कल्पयामास स्नानार्थं तीर्थमुत्तमम् ।\nशंखेन निर्मितं तीर्थं शंखतीर्थमितीर्यते॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003962005, "chapter_id": 23962, "verse_number": "३-१-२५-६", "content_sanskrit": "तत्र स्नात्वा सकृन्मर्त्यः कृतघ्नोऽपिविमुच्यते अत्रेतिहासं वक्ष्यामि पुराणं पापनाशनम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003962006, "chapter_id": 23962, "verse_number": "३-१-२५-७", "content_sanskrit": "यस्य श्रवणमात्रेण नरो मुक्तिमवाप्नुयात् ।\nपुरा बभूव विप्रेंद्रो वत्सनाभो महामुनिः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003962007, "chapter_id": 23962, "verse_number": "३-१-२५-८", "content_sanskrit": "सत्यवाञ्छीलवान्वाग्मी सर्वभूतदयापरः ।\nशत्रुमित्रसमो दांतस्तपस्वी विजितेंद्रियः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003962008, "chapter_id": 23962, "verse_number": "३-१-२५-९", "content_sanskrit": "परब्रह्मणि निष्णातस्तत्त्वब्रह्मैकसंश्रयः ।\nएवं प्रभावः स मुनिस्तपस्तेपे निजाश्रमे॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003962009, "chapter_id": 23962, "verse_number": "३-१-२५-१०", "content_sanskrit": "स वै निश्चलसर्वांगस्तिष्ठंस्तत्रैव भूतले ।\nपरमाण्वंतरं वापि न स्वस्थानाच्चचाल सः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003962010, "chapter_id": 23962, "verse_number": "३-१-२५-११", "content_sanskrit": "स्थित्वैकत्र तपस्यंतमनेकशतवत्सरान् ।\nतमाचकाम वल्मीकं छादितांगं चकार च॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003962011, "chapter_id": 23962, "verse_number": "३-१-२५-१२", "content_sanskrit": "वल्मीकाक्रांतदेहोपि वत्सनाभो महामुनिः ।\nअकरोत्तप एवासौ वल्मीकं न त्वबुद्ध्यत॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003962012, "chapter_id": 23962, "verse_number": "३-१-२५-१३", "content_sanskrit": "तस्मिंश्च तप्यति तपो वासवो मुनिपुंगवाः ।\nविसृज्य मेघजालानि वर्षयामास वेगवान्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003962013, "chapter_id": 23962, "verse_number": "३-१-२५-१४", "content_sanskrit": "एवं दिनानि सप्तायं स ववर्ष निरं तरम् ।\nआसारेणातिमहता वृष्यमाणोपि वै मुनिः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003962014, "chapter_id": 23962, "verse_number": "३-१-२५-१५", "content_sanskrit": "तं वर्षं प्रतिजग्राह निमीलितविलोचनः ।\nमहता स्तनितेनाशु तदा बधिरयञ्छ्रुती॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003962015, "chapter_id": 23962, "verse_number": "३-१-२५-१६", "content_sanskrit": "वल्मीकस्योपरिष्टाद्वै निपपात महाशनिः ।\nतस्मिन्वर्षति पर्जन्ये शीतवातातिदुःसहे॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003962016, "chapter_id": 23962, "verse_number": "३-१-२५-१७", "content_sanskrit": "वल्मीकशिखरं ध्वस्तं बभूवाशनिताडि तम् ।\nविशीर्णशिखरे तस्मिन्वल्मीकेऽशनिताडिते॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003962017, "chapter_id": 23962, "verse_number": "३-१-२५-१८", "content_sanskrit": "सेहेतिदुःसहां वृष्टिं वत्सनाभो विचिंतयन् ।\nमहर्षौ वर्षधाराभिः पीड्यमाने दिवानि शम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003962018, "chapter_id": 23962, "verse_number": "३-१-२५-१९", "content_sanskrit": "धर्मस्य चेतसि कृपा संबभूवातिभूयसी ।\nस धर्मश्चिंतयामास वत्सनाभे तपस्यति॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003962019, "chapter_id": 23962, "verse_number": "३-१-२५-२०", "content_sanskrit": "पतत्यप्यतिवर्षेऽयं तपसो न निवर्तते ।\nअहोऽस्य वत्सनाभस्य धर्मैकायत्तचित्तता॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003962020, "chapter_id": 23962, "verse_number": "३-१-२५-२१", "content_sanskrit": "इति चिंतयतस्तस्य मातिरेवमजायत ।\nअहं वै माहिषं रूपं सुमहांतं मनोहरम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003962021, "chapter_id": 23962, "verse_number": "३-१-२५-२२", "content_sanskrit": "वर्षधारानिपातानां सोढारं कठिनत्वचम् ।\nस्वीकृत्य माहिषं रूपं स्थास्याम्युपरि योगिनः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003962022, "chapter_id": 23962, "verse_number": "३-१-२५-२३", "content_sanskrit": "न हि बाधिष्यते वर्षं महावेगयुतं त्वपि ।\nधर्म एवं विनिश्चित्य धाराः पृष्ठेन धारयन्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003962023, "chapter_id": 23962, "verse_number": "३-१-२५-२४", "content_sanskrit": "वत्सनाभोपरि तदा गात्रमाच्छाद्य तस्थिवान् ।\nततः सप्तदिनांते तु तद्वै वर्षमुपारमत्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003962024, "chapter_id": 23962, "verse_number": "३-१-२५-२५", "content_sanskrit": "ततो महिषरूपी स धर्मोऽतिकृपया युतः ।\nतद्वै वल्मीकमुत्सृज्य नातिदूरे ह्यवर्त्तत॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003962025, "chapter_id": 23962, "verse_number": "३-१-२५-२६", "content_sanskrit": "ततो निवृते वर्षे तु वत्सनाभो महामुनिः ।\nनिवृत्तस्तपसस्तू र्णं दिशः सर्वा व्यलोकयन्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003962026, "chapter_id": 23962, "verse_number": "३-१-२५-२७", "content_sanskrit": "स्थितोऽहं वृष्टिसंपाते कुर्वन्नद्य महत्तपः ।\nपृथिवी सलिलाक्लिन्ना दृश्यते सर्वतोदिशम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003962027, "chapter_id": 23962, "verse_number": "३-१-२५-२८", "content_sanskrit": "शिखराणि गिरीणां च वना न्युपवनानि च ।\nआश्रमाणि महर्षीणामाप्लुतानि जलैर्नवैः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003962028, "chapter_id": 23962, "verse_number": "३-१-२५-२९", "content_sanskrit": "एवमादीनि सर्वाणि दृष्ट्वा प्रमुदितोऽभवत् ।\nचिंतयामास धर्मात्मा वत्सना भो महामुनिः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003962029, "chapter_id": 23962, "verse_number": "३-१-२५-३०", "content_sanskrit": "अहमस्मिन्महावर्षे नूनं केनापि रक्षितः ।\nवर्षत्यस्मिन्महावर्षे जीवितं त्वन्यथा कुतः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003962030, "chapter_id": 23962, "verse_number": "३-१-२५-३१", "content_sanskrit": "विचिंत्यैवं मुनिश्रेष्ठः सर्वत्र समलोकयत् ।\nततोऽपश्यन्महाकायमदूरादग्रतः स्थितम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003962031, "chapter_id": 23962, "verse_number": "३-१-२५-३२", "content_sanskrit": "महिषं नीलवर्णं च वत्सनाभस्तपोधनः ।\nमहिषं तं समुद्दिश्य मनसा समचिंतयत्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003962032, "chapter_id": 23962, "verse_number": "३-१-२५-३३", "content_sanskrit": "तिर्यग्योनिष्वपि कथं दृश्यते धर्मशीलता ।\nयतो ह्यहं महावर्षान्महिषेणाभिरक्षितः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003962033, "chapter_id": 23962, "verse_number": "३-१-२५-३४", "content_sanskrit": "दीर्घमायुरमुष्यास्तु यन्मां रक्षितवानिह ।\nइत्यादि स विचिंत्यैवं तपसे पुनरुद्ययौ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003962034, "chapter_id": 23962, "verse_number": "३-१-२५-३५", "content_sanskrit": "तं पुनश्च तपस्यंतं दृष्ट्वा महिषरूपधृक् ।\nरोमांचावृतसर्वांगः प्रमोदमगमद्भृशम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003962035, "chapter_id": 23962, "verse_number": "३-१-२५-३६", "content_sanskrit": "वत्सनाभस्य हि मुनेः पुनश्चैव तपस्यतः ।\nमनः पूर्ववदेकाग्रं परब्रह्मणि नाभवत्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003962036, "chapter_id": 23962, "verse_number": "३-१-२५-३७", "content_sanskrit": "स विषण्णमना भूत्वा वत्सनाभो व्यचिंतयत् ।\nन भवेद्यदि नैर्मल्यं तदा स्याच्चंचलं मनः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003962037, "chapter_id": 23962, "verse_number": "३-१-२५-३८", "content_sanskrit": "मनश्च पापबाहुल्ये निर्मलं नैव जायते ।\nपापलेशोपि मे नास्ति कथं लोला यते मनः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003962038, "chapter_id": 23962, "verse_number": "३-१-२५-३९", "content_sanskrit": "अचिंतयद्दोषहेतुं वत्सनाभः पुनःपुनः ।\nस विचिंत्य विनिश्चित्य निनिंदात्मानमंजसा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003962039, "chapter_id": 23962, "verse_number": "३-१-२५-४०", "content_sanskrit": "धिङ्मामद्य दुरात्मानमहो मूढोस्म्यहं भृशम् ।\nकृतघ्नता महादोषो मामद्य समुपागतः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003962040, "chapter_id": 23962, "verse_number": "३-१-२५-४१", "content_sanskrit": "यदीदृशान्महावर्षात्त्रातारं महिषोत्तमम् ।\nतिष्ठाम्यपूजयन्नेव ततो मे भूत्कृतघ्नता॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003962041, "chapter_id": 23962, "verse_number": "३-१-२५-४२", "content_sanskrit": "कृतघ्नता महान्दोषः कृतघ्ने नास्ति निष्कृतिः ।\nकृतघ्नस्य न वै लोकाः कृतघ्नस्य न बांधवाः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003962042, "chapter_id": 23962, "verse_number": "३-१-२५-४३", "content_sanskrit": "कृतघ्नतादोष वलान्मम चित्तं मलीमसम् ।\nकृतघ्ना नरकं यांति ये च विश्वस्तघातिनः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003962043, "chapter_id": 23962, "verse_number": "३-१-२५-४४", "content_sanskrit": "निष्कृतिं नैव पश्यामि कृतघ्नानां कथंचन ।\nऋते प्राणपरित्यागाद्धर्मज्ञानां वचो यथा॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003962044, "chapter_id": 23962, "verse_number": "३-१-२५-४५", "content_sanskrit": "पित्रोरभरणं कृत्वा ह्यदत्त्वा गुरुदक्षिणाम् ।\nकृतघ्नतां च संप्राप्य मरणांता हि निष्कृतिः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003962045, "chapter_id": 23962, "verse_number": "३-१-२५-४६", "content_sanskrit": "तस्मात्प्राणान्परित्यज्य प्रायश्चित्तं चराम्यहम् ।\nइति निश्चित्य मनसा वत्सनाभो महामुनिः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003962046, "chapter_id": 23962, "verse_number": "३-१-२५-४७", "content_sanskrit": "तृणीकृत्य निजान्प्राणान्निःसंगेनांतरा त्मना ।\nमेरोः शिखरमारूढः प्रायश्चित्तचिकीर्षया॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003962047, "chapter_id": 23962, "verse_number": "३-१-२५-४८", "content_sanskrit": "सुमेरुशिखरात्तस्मादियेष पतितुं मुनिः ।\nतस्मिन्पतितुमारब्धे मा त्वरिष्ठा इति ब्रुवन् ।\nत्यक्तमाहिषरूपः सन्धर्म एव न्यवारयत्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003962048, "chapter_id": 23962, "verse_number": "३-१-२५-४९", "content_sanskrit": "धर्म उवाच ।\nवत्सनाभ महाप्राज्ञ जीवस्व बहुवत्सरान्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003962049, "chapter_id": 23962, "verse_number": "३-१-२५-५०", "content_sanskrit": "परितुष्टोऽस्मि भद्रं ते देहत्यागचिकीर्षया ।\nन हि त्वद्धर्मकक्षायां लोके कश्चित्समोऽस्ति वै॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003962050, "chapter_id": 23962, "verse_number": "३-१-२५-५१", "content_sanskrit": "यद्यपि प्राणसंत्यागः कृतघ्ने निष्कृतिर्भवेत् ।\nतथापि धर्मशीलत्वात्तवान्यां निष्कृतिं वदे॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003962051, "chapter_id": 23962, "verse_number": "३-१-२५-५२", "content_sanskrit": "शंखतीर्थाभिधं तीर्थमस्ति वै गंधमादने ।\nशांत्यर्थमस्य पापस्य तत्र स्नाहि समाहितः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003962052, "chapter_id": 23962, "verse_number": "३-१-२५-५३", "content_sanskrit": "प्राप्स्यसे चित्तशुद्धिं त्वमतो विगतकल्मषः ।\nततश्च लब्धविज्ञानः प्राप्स्यसे शाश्वतं पदम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003962053, "chapter_id": 23962, "verse_number": "३-१-२५-५४", "content_sanskrit": "अहं धर्मोस्मि योगीन्द्र सत्यमेव ब्रवीमि ते ।\nइति धर्मवचः श्रुत्वा वत्सनाभो महामुनिः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003962054, "chapter_id": 23962, "verse_number": "३-१-२५-५५", "content_sanskrit": "स्नातुकामः शंखतीर्थे गंधमादनमन्वगात् ।\nशंखतीर्थं च संप्राप्य तत्र सस्नौ महामुनिः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003962055, "chapter_id": 23962, "verse_number": "३-१-२५-५६", "content_sanskrit": "ततो विगतपापस्य मनो निर्मलतां गतम् ।\nततोऽचिरेण कालेन ब्रह्मभूयमगान्मुनिः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003962056, "chapter_id": 23962, "verse_number": "३-१-२५-५७", "content_sanskrit": "एवं वः कथितं विप्राः शंखतीर्थस्य वैभवम् ।\nयत्र हि स्नानमात्रेण कृतघ्नोऽपि विमुच्यते॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003962057, "chapter_id": 23962, "verse_number": "३-१-२५-५८", "content_sanskrit": "मातृद्रोही पितृद्रोही गुरुद्रोही तथैव च ।\nअन्ये कृतघ्ननिवहा मुच्यंतेऽत्र निमज्जनात्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003962058, "chapter_id": 23962, "verse_number": "३-१-२५-५९", "content_sanskrit": "अतः कृतघ्नैर्मनुजैः सेवनीयमिदं सदा ।\nअहो तीर्थस्य माहात्म्यं यत्कृतघ्नोपि मुच्यते॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003962059, "chapter_id": 23962, "verse_number": "३-१-२५-६०", "content_sanskrit": "अकृत्वा भरणं पित्रोरदत्त्वा गुरुदक्षिणाम् ।\nकृतघ्नतां च संप्राप्य मरणांता हि निष्कृतिः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003962060, "chapter_id": 23962, "verse_number": "३-१-२५-६१", "content_sanskrit": "इह तु स्नानमात्रेण कृतघ्नस्यापि निष्कृतिः ।\nकृतघ्नतापि तत्तीर्थे स्नानमात्राद्विनश्यति॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003962061, "chapter_id": 23962, "verse_number": "३-१-२५-६२", "content_sanskrit": "अन्येषां तुच्छपापानां सर्वेषां किमुताधुना॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003962062, "chapter_id": 23962, "verse_number": "३-१-२५-६३", "content_sanskrit": "अध्यायमेनं पठेद्भक्तियुक्तः कृतघ्नोपि मर्त्याः स पापाद्विमुक्तः ।\nविशुद्धांतरात्मा गतः सत्यलोकं समं ब्रह्मणा मोक्षमप्याशु गच्छेत्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]