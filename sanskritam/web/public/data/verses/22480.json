[{"id": 7002480000, "chapter_id": 22480, "verse_number": "१-१४२-१", "content_sanskrit": "व्यास उवाच ।\nदेवता ऋषयो नागा गन्धर्वाप्सरसां गणाः ।\nयक्षरक्षांसि वै भानौ निवसन्ति ऋतुक्रमात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002480001, "chapter_id": 22480, "verse_number": "१-१४२-२", "content_sanskrit": "तत्र तु वासुकिर्ह्यब्दमुद्यत्सूर्यरथं जवात् ।\nस्वस्थानमाजगामाशु नमस्कृत्य दिवाकरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002480002, "chapter_id": 22480, "verse_number": "१-१४२-३", "content_sanskrit": "अव्यङ्गमेव सूर्याय प्रीत्यर्थं वै समर्पयत् ।\nगाङ्गेयभूषितं दिव्यं नातिरक्तसितं शुभम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002480003, "chapter_id": 22480, "verse_number": "१-१४२-४", "content_sanskrit": "बबन्ध तं च तत्प्रीत्यै मध्यभागे तमात्मनः ।\nनागराजाङ्गसम्भूतो धृतो यस्माच्च भानुना ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002480004, "chapter_id": 22480, "verse_number": "१-१४२-५", "content_sanskrit": "तत्तस्माद्धार्यते सूर्यप्रीत्यै तद्भक्तिमिच्छता ।\nविधानेन च तत्त्वेन शुचिर्भवति भोजकः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002480005, "chapter_id": 22480, "verse_number": "१-१४२-६", "content_sanskrit": "नित्यं च धारणात्तस्य भवेत्प्रीतो दिवाकरः ।\nन धारयन्ति ये त्वेवं भोजकाः पूजकाः रवेः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002480006, "chapter_id": 22480, "verse_number": "१-१४२-७", "content_sanskrit": "सौरहीना न ते याज्या उच्छिष्टा नात्र संशयः ।\nस्मृत्याचारे ते हि भग्ना रविं नार्हन्ति पूजितुम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002480007, "chapter_id": 22480, "verse_number": "१-१४२-८", "content_sanskrit": "पूजयन्तो रविं ते हि नरकं यान्ति रौरवम् ।\nन वै हसेन्न उत्तिष्ठेद्यावदर्चा लभन्ति ते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002480008, "chapter_id": 22480, "verse_number": "१-१४२-९", "content_sanskrit": "इत्थं ज्ञात्वा न सन्देहो ह्यव्यङ्गेन विना रविः ।\nनागराजस्य संस्पृष्टो ह्यारसुस्तेन संस्मृतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002480009, "chapter_id": 22480, "verse_number": "१-१४२-१०", "content_sanskrit": "एकवर्णः स कर्तव्यः कार्यसिद्धिकरस्तथा ।\nप्रमाणेनाङ्गुलानां तु शताद्धि शतमुत्तरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002480010, "chapter_id": 22480, "verse_number": "१-१४२-११", "content_sanskrit": "उत्कृष्टोऽयं प्रमाणेन मध्यमो विंशदुत्तरः ।\nशतमष्टोत्तरं ह्रस्वो न तु ह्रस्वतरस्ततः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002480011, "chapter_id": 22480, "verse_number": "१-१४२-१२", "content_sanskrit": "तदाकृतिः कृतश्चैष निर्मितो विश्वकर्मणा ।\nमध्यमे भोजकानां तु परः शत उदाहृतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002480012, "chapter_id": 22480, "verse_number": "१-१४२-१३", "content_sanskrit": "संस्कृतोऽपि विना तेन शुचिर्नैव भवत्युत ।\nतेनास्य धारणाद्वीर शुचिरेव तदा भवेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002480013, "chapter_id": 22480, "verse_number": "१-१४२-१४", "content_sanskrit": "हविर्होमादिकाः सर्वा भवन्त्यस्य क्रियाः शुभाः ।\nअव्यङ्गः पतिताङ्गश्च अव्यङ्गोऽथ महीपते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002480014, "chapter_id": 22480, "verse_number": "१-१४२-१५", "content_sanskrit": "एष सारश्च सा रम्या वै ज्ञेया जयनामभिः ।\nअहेरङ्गात्समुत्पन्नो ह्यव्यङ्गस्तु ततः स्मृतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002480015, "chapter_id": 22480, "verse_number": "१-१४२-१६", "content_sanskrit": "यस्मादस्मादहेरङ्गमव्यङ्गस्तेन चोच्यते ।\nअर्हेति पूजायां धातोः प्रत्ययो ण्वुल्ततः स्मृतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002480016, "chapter_id": 22480, "verse_number": "१-१४२-१७", "content_sanskrit": "पूजितश्च पवित्रश्च यस्मात्तेनार्हकः स्मृतः ।\nसारसार्तः स्मृतं रूपं प्रधानं सार उच्यते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002480017, "chapter_id": 22480, "verse_number": "१-१४२-१८", "content_sanskrit": "षण भक्तौ स्मृतौ धातुस्तस्मात्सारसनः स्मृतः ।\nयस्मादर्चितमेवं तु सुवर्णमणिमौक्तिकैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002480018, "chapter_id": 22480, "verse_number": "१-१४२-१९", "content_sanskrit": "स ज्ञेयः पतिताङ्गस्तु नित्ययज्ञैरुपाहृतः ।\nइत्येते कथिता वीर अव्यङ्गा व्यङ्गभोजकाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002480019, "chapter_id": 22480, "verse_number": "१-१४२-२०", "content_sanskrit": "ऋद्धिवृद्धिकरो नित्यं कायशुद्धिकरस्तथा ।\nसर्ववेदमयश्चायं सर्वदेवमयस्तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002480020, "chapter_id": 22480, "verse_number": "१-१४२-२१", "content_sanskrit": "सर्वभूतमयः साम्ब सर्वलोकमयस्तथा ।\nमध्येऽस्य संस्थितो ब्रह्मा मूले विष्णुर्महामते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002480021, "chapter_id": 22480, "verse_number": "१-१४२-२२", "content_sanskrit": "शशाङ्कमौलिरन्त्ये तु संस्थितो यदुनंदन ।\nऋग्वेदोऽस्य स्थितो मूले यजुर्वेदोऽस्य मध्यगः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002480022, "chapter_id": 22480, "verse_number": "१-१४२-२३", "content_sanskrit": "अग्रे स्थितः सामवेदो ग्रन्थिराङ्गिरसोनघ ।\nपृथ्वी मूलमाश्रित्य स्थिता च यदुसत्तम ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002480023, "chapter_id": 22480, "verse_number": "१-१४२-२४", "content_sanskrit": "मूलाशनास्त्वपः साम्ब मध्ये देवो विभावसुः ।\nतासामनन्तरं वात आकाशोऽग्रे समास्थितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002480024, "chapter_id": 22480, "verse_number": "१-१४२-२५", "content_sanskrit": "मूले स्थितस्तु भूर्लोको भुवर्लोकस्तु मध्यगः ।\nस्वर्लोकश्चाग्रमाश्रित्य स्थितो व्यङ्गस्य यावता ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002480025, "chapter_id": 22480, "verse_number": "१-१४२-२६", "content_sanskrit": "एवं देवमयः सांब एवं लोकमयस्तथा ।\nधारणीयो महान्भक्त्या पूजकः प्रीतये रवेः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002480026, "chapter_id": 22480, "verse_number": "१-१४२-२७", "content_sanskrit": "पूजयन्ति रविं ये वै विनानेन यदूत्तम ।\nपूजाफलं न तेषां स्यान्नरकं च व्रजन्ति हि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002480027, "chapter_id": 22480, "verse_number": "१-१४२-२८", "content_sanskrit": "तथा तेषां भवेन्नित्यमव्यङ्गो भोजकः सदा ।\nअन्यकाले यदुश्रेष्ठ इत्येतत्कथितं तव ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002480028, "chapter_id": 22480, "verse_number": "१-१४२-२९", "content_sanskrit": "बन्धने कारणं वीर भूषणानि च सुव्रत ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]