[{"id": 2077984, "chapter_id": 2654, "verse_number": "१२-१५९-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077985, "chapter_id": 2654, "verse_number": "१२-१५९-१", "content_sanskrit": "सर्वमेतत्तपोमूलं कवयः परिचक्षते।\nन ह्यतप्ततपा मूढः क्रियाफलमवाप्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077986, "chapter_id": 2654, "verse_number": "१२-१५९-२", "content_sanskrit": "प्रजापतिरिदं सर्वं तपसैवासृजत्प्रभुः।\nतथैव वेदानृपयस्तपसा प्रतिपेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077987, "chapter_id": 2654, "verse_number": "१२-१५९-३", "content_sanskrit": "तपसैव ससर्जान्नं फलमूलानि यानि च।\nत्रीँल्लोकांस्तपसा सिद्धाः पश्यन्ति सुसमाहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077988, "chapter_id": 2654, "verse_number": "१२-१५९-४", "content_sanskrit": "औषधान्यगदादीनि तिस्त्रो विद्याश्च संस्कृताः।\nतषसैव हि सिद्ध्यन्ति तपोमूलं हि साधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077989, "chapter_id": 2654, "verse_number": "१२-१५९-५", "content_sanskrit": "यद्दुरापं दुराराध्यं दुराधर्षं दुरुत्सहम्।\nतत्सर्वं तपसा शक्यं तपो हि दुरतिक्रमम्।\nऐश्वर्यमृषयः प्राप्तास्तपसैव न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077990, "chapter_id": 2654, "verse_number": "१२-१५९-६", "content_sanskrit": "सुरापोऽसंमतादायी भ्रूणहा गुरुतल्पगः।\nतपसैव सुतप्तेन नरः पापात्प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077991, "chapter_id": 2654, "verse_number": "१२-१५९-७", "content_sanskrit": "तपसो बहुरूपस्य तैस्तैर्द्वारैः प्रवर्ततः।\nनिवृत्त्या वर्तमानस्य तपो नानशनात्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077992, "chapter_id": 2654, "verse_number": "१२-१५९-८", "content_sanskrit": "अहिंसा सत्यवचनं दानमिन्द्रियनिग्रहः।\nएतेभ्यो हि महाराज तपो नानशनात्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077993, "chapter_id": 2654, "verse_number": "१२-१५९-९", "content_sanskrit": "न दुष्करतरं दानान्नाति मातरमाश्रमः।\nत्रैविद्येभ्यः परं नास्ति संन्यासान्नापरं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077994, "chapter_id": 2654, "verse_number": "१२-१५९-१०", "content_sanskrit": "इन्द्रियाणीह रक्षन्ति विप्रर्षिपितृदेवताः।\nतस्मादर्थे च धर्मे च तपो नानशनात्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077995, "chapter_id": 2654, "verse_number": "१२-१५९-११", "content_sanskrit": "ऋषयः पितरो देवा मनुष्या मृगपक्षिणः।\nयानि चान्यानि भूतानि स्यावराणि चराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077996, "chapter_id": 2654, "verse_number": "१२-१५९-१२", "content_sanskrit": "तपः परायणाः सर्वे सिध्यन्ति तपसा च ते।\nइत्येवं तपसा देवा महत्त्वं प्रतिपेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077997, "chapter_id": 2654, "verse_number": "१२-१५९-१३", "content_sanskrit": "इमानीष्टविभागानि फलानि तपसः सदा।\nतपसा शक्यते प्राप्नुं देवत्वमपि निश्चयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077998, "chapter_id": 2654, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि एकोनषष्ट्यधिकशततमोऽध्यायः॥ १५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]