[{"id": 2039738, "chapter_id": 1879, "verse_number": "५-१२४-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039739, "chapter_id": 1879, "verse_number": "५-१२४-१", "content_sanskrit": "भगवन्नेवमेवैतद्यथा वदसि नारद।\nइच्छामि चाहमप्येवं न त्वीशो भगवन्नहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039740, "chapter_id": 1879, "verse_number": "५-१२४-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039741, "chapter_id": 1879, "verse_number": "५-१२४-२", "content_sanskrit": "एवमुक्त्वा ततः कृष्णमभ्यभाषत कौरवः ।\nस्वर्ग्यं लोक्यं च मामात्थ धर्म्यं न्याय्यं च केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039742, "chapter_id": 1879, "verse_number": "५-१२४-३", "content_sanskrit": "न त्वहं स्ववशस्तात क्रियमाणं न मे प्रियम् ।\n`न मंस्यन्ते दुरात्मानः पुत्रा मम जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039743, "chapter_id": 1879, "verse_number": "५-१२४-४", "content_sanskrit": "अङ्ग दुर्योधनं कृष्ण मन्दं शास्त्रातिगं मम।\nअनुनेतुं महाबाहो यतस्व पुरुषोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039744, "chapter_id": 1879, "verse_number": "५-१२४-५", "content_sanskrit": "न श्रृणोति महाबाहो वचनं साधु भाषितम् ।\nगान्धार्याश्च हृषीकेश विदुरस्य च धीमतः ।\nअन्येषां चैव सुहृदां भीष्मादीनां हितैषिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039745, "chapter_id": 1879, "verse_number": "५-१२४-६", "content_sanskrit": "स त्वं पापमतिं क्रूरं पापचित्तमचेतनम् ।\nअनुशाधि दुरात्मानं स्वयं दुर्योधनं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039746, "chapter_id": 1879, "verse_number": "५-१२४-७", "content_sanskrit": "सुहृत्कार्यं तु सुमहत्कृतं ते स्याञ्जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039747, "chapter_id": 1879, "verse_number": "५-१२४-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039748, "chapter_id": 1879, "verse_number": "५-१२४-८", "content_sanskrit": "ततोऽभ्यावृत्य वार्ष्णेयो दुर्योधनममर्षणम् ।\nअब्रवीन्मधुरां वाचं सर्वधर्मार्थतत्त्ववित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039749, "chapter_id": 1879, "verse_number": "५-१२४-९", "content_sanskrit": "दुर्योधन निबोधेदं मद्वाक्यं कुरुसत्तम।\nशर्मार्थं ते विशेषेण सानुबन्धस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039750, "chapter_id": 1879, "verse_number": "५-१२४-१०", "content_sanskrit": "महाप्रज्ञकुले जातः साध्वेतत्कर्तुमर्हसि ।\nश्रुतवृत्तोपसंपन्नः सर्वैः समुदितो गुणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039751, "chapter_id": 1879, "verse_number": "५-१२४-११", "content_sanskrit": "दौष्कुलेया दुरात्मानो नृशंसा निरपत्रपाः ।\nत एतदीदृशं कुर्युर्यथा त्वं तात मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039752, "chapter_id": 1879, "verse_number": "५-१२४-१२", "content_sanskrit": "धर्मार्थयुक्ता लोकेऽस्मिन्प्रवृत्तिर्लक्ष्यते सताम्।\nअसतां विपरीता तु लक्ष्यते भरतर्षभ ।\nविपरीता त्वियं वृत्तिरसकृल्लक्ष्यते त्वयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039753, "chapter_id": 1879, "verse_number": "५-१२४-१३", "content_sanskrit": "अधर्मश्चानुबन्धोऽत्र घोरः प्राणहरो महान् ।\nअनिष्टश्चानिमित्तश्च न च शक्यश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039754, "chapter_id": 1879, "verse_number": "५-१२४-१४", "content_sanskrit": "तमनर्थं परिहरन्नात्मश्रेयः करिष्यसि।\nभ्रातॄणामथ भृत्यानां मित्राणां च परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039755, "chapter_id": 1879, "verse_number": "५-१२४-१५", "content_sanskrit": "अधर्म्यादयशस्याच्च कर्मणस्त्वं प्रमोक्ष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039756, "chapter_id": 1879, "verse_number": "५-१२४-१६", "content_sanskrit": "प्राज्ञैः शूरैर्महोत्साहैरात्मवद्भिर्बहुश्रुतैः।\nसन्धत्स्व पुरुषव्याघ्र पाण्डवैर्भरतर्षभ।\nतद्धितं च प्रियं चैव धृतराष्ट्रस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039757, "chapter_id": 1879, "verse_number": "५-१२४-१७", "content_sanskrit": "पितामहस्य द्रोणस्य विदुरस्य महामतेः ।\nकृपस्य सोमदत्तस्य बाह्लीकस्य च धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039758, "chapter_id": 1879, "verse_number": "५-१२४-१८", "content_sanskrit": "अश्वत्थाम्नो विकर्णस्य सञ्जयस्य विविंशतेः।\nज्ञातीनां चैव भूयिष्ठं मित्राणां च परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039759, "chapter_id": 1879, "verse_number": "५-१२४-१९", "content_sanskrit": "शमे शर्म भवेत्तात सर्वस्य जगतस्तथा।\nह्रीमानसि कुले जातः श्रुतवानानृशंस्यवान् ।\nतिष्ठ तात पितुः शास्त्रे मातुश्च भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039760, "chapter_id": 1879, "verse_number": "५-१२४-२०", "content_sanskrit": "एतच्छ्रेयो हि मन्यन्ते पिता यच्छास्ति भारत ।\nउक्तमापद्गतः पूर्वं पितुः स्मरसि शासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039761, "chapter_id": 1879, "verse_number": "५-१२४-२१", "content_sanskrit": "रोचते ते पितुस्तात पाण्डवैः सह सङ्गमः।\nसामात्यस्य कुरुश्रेष्ठ तत्तुभ्यां तात रोचताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039762, "chapter_id": 1879, "verse_number": "५-१२४-२२", "content_sanskrit": "श्रुत्वा यः सुहृदां शास्त्रं मर्त्यो न प्रतिपद्यते ।\nविपाकान्ते दहत्येनं किंपाकमिव भक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039763, "chapter_id": 1879, "verse_number": "५-१२४-२३", "content_sanskrit": "यस्तु निःश्रेयसं वाक्यं मोहान्न प्रतिपद्यते।\nस दीर्घसूत्रो हीनार्थः पश्चात्तापेन युज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039764, "chapter_id": 1879, "verse_number": "५-१२४-२४", "content_sanskrit": "यस्तु न्निःश्रेयसं श्रुत्वा प्राक्तदेवाभिपद्यते।\nआत्मनो मतमुत्सृज्य स लोके सुखमेधते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2039765, "chapter_id": 1879, "verse_number": "५-१२४-२५", "content_sanskrit": "योऽर्थकामस्य वचनं प्रातिकूल्यान्न मृष्यते।\nशृणोति प्रतिकूलानि द्विषतां वशमेति सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2039766, "chapter_id": 1879, "verse_number": "५-१२४-२६", "content_sanskrit": "सतां मतमतिक्रम्य योऽसतां वर्तते मते।\nशोचन्ते व्यसने तस्य सुहृदो नचिरादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2039767, "chapter_id": 1879, "verse_number": "५-१२४-२७", "content_sanskrit": "मुख्यानमात्यानुत्सृज्य यो निहीनान्निषेवते ।\nस घोरामापदं प्राप्य नोत्तारमधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2039768, "chapter_id": 1879, "verse_number": "५-१२४-२८", "content_sanskrit": "योऽसत्सेवी वृथाचारो न श्रोता सुहृदां सताम्।\nपरान्वृणीति स्वान्द्वेष्टि तं गौस्त्यजति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2039769, "chapter_id": 1879, "verse_number": "५-१२४-२९", "content_sanskrit": "तत्वं विरुद्धा तैर्वीरैस्येतत्राणमिच्छसि ।\nअशिष्टेभ्योऽसमर्थेभ्यो मूढेभ्यो भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2039770, "chapter_id": 1879, "verse_number": "५-१२४-३०", "content_sanskrit": "को हि शक्रसमाञ्ज्ञातीनतिक्रम्य महारथान् ।\nअन्येभ्यस्त्राणमाशंसेत्त्वदन्यो भुवि मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2039771, "chapter_id": 1879, "verse_number": "५-१२४-३१", "content_sanskrit": "जन्मप्रभृति कौन्तेया नित्यं विनिकृतास्त्वया ।\nन च ते जातु कुप्यन्ति धर्मात्मानो हि पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2039772, "chapter_id": 1879, "verse_number": "५-१२४-३२", "content_sanskrit": "मिथ्योपचरितास्तात जन्मप्रभृति बान्धवाः ।\nत्वयि सम्यङ्भहाबाहो प्रतिपन्ना यशस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2039773, "chapter_id": 1879, "verse_number": "५-१२४-३३", "content_sanskrit": "त्वयाऽपि प्रतिपत्तव्यं तथैव भरतर्षभ ।\nस्वेषु बन्धुषु मुख्येषु मा मन्युवशमन्वगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2039774, "chapter_id": 1879, "verse_number": "५-१२४-३४", "content_sanskrit": "त्रिवर्गयुक्तः प्राज्ञानामारम्भो भरतर्षभ ।\nधर्मार्थावनुरुद्ध्यन्ते त्रिवर्गासंभवे नराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2039775, "chapter_id": 1879, "verse_number": "५-१२४-३५", "content_sanskrit": "पृथक्व विनिविष्टानां धर्मं धीरोऽनुरुध्यते।\nमध्यमोऽर्थं कलिं बालः काममेवानुरुद्ध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2039776, "chapter_id": 1879, "verse_number": "५-१२४-३६", "content_sanskrit": "इन्द्रियैः प्राकृतो लोभाद्धर्मं विप्रजहाति यः ।\nकामार्थावनुपायेन लिप्समानो विनश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2039777, "chapter_id": 1879, "verse_number": "५-१२४-३७", "content_sanskrit": "कामार्थौ लिप्समानस्तु धर्ममेवादितश्चरेत्।\nन हि धर्मादपैत्यर्थः कामो वाऽपि कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2039778, "chapter_id": 1879, "verse_number": "५-१२४-३८", "content_sanskrit": "उपायं धर्ममेवाहुस्त्रिवर्गस्य विशांपते ।\nलिप्समानो हि तेनाशु कक्षेऽग्निरिव वर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2039779, "chapter_id": 1879, "verse_number": "५-१२४-३९", "content_sanskrit": "स त्वं तातानुपायेन लिप्ससे भरतर्षभ ।\nआधिराज्यं महद्दीप्तं प्रथितं सर्वराजसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2039780, "chapter_id": 1879, "verse_number": "५-१२४-४०", "content_sanskrit": "आत्मानं तक्षति ह्येष वनं परशुना यथा।\nयः सम्यग्वर्तमानेषु मिथ्या राजन्प्रवर्तते ।\nन तस्य हि मतिं छिन्द्याद्यस्य नेच्छेत्पराभवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2039781, "chapter_id": 1879, "verse_number": "५-१२४-४१", "content_sanskrit": "अविच्छिन्नमतेरस्य कल्याणे धीयते मतिः।\nआत्मवान्नावमन्येत त्रिषु लोकेषु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2039782, "chapter_id": 1879, "verse_number": "५-१२४-४२", "content_sanskrit": "अप्यन्यं प्राकृतं कञ्चित्किमु तान्पाण्डवर्षभान्।\nअमर्षवशमापन्नो न किंचिद्बुद्व्यते जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2039783, "chapter_id": 1879, "verse_number": "५-१२४-४३", "content_sanskrit": "छिद्यते ह्याततं सर्वं प्रमाणं पश्य भारत ।\nश्रेयस्ते दुर्जनात्तात पाण्डवैः सह सङ्गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2039784, "chapter_id": 1879, "verse_number": "५-१२४-४४", "content_sanskrit": "तैर्हि संप्रीपमाणस्त्वं सर्वान्कामानवाप्स्यसि।\nपाण्डवैर्निर्मितां भूमिं भुञ्जानो राजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2039785, "chapter_id": 1879, "verse_number": "५-१२४-४५", "content_sanskrit": "पाण्डवान्पृष्ठतः कृत्वा त्राणमाशससऽन्वतः ।\nदुःशासने दुर्विषहे कर्णे चापि ससौबले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2039786, "chapter_id": 1879, "verse_number": "५-१२४-४६", "content_sanskrit": "एतेष्वैश्वर्यमाधाय भूतिमिच्छसि भारत ।\nन चैते तव पर्याप्ता ज्ञाने धर्मार्थयोस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2039787, "chapter_id": 1879, "verse_number": "५-१२४-४७", "content_sanskrit": "विक्रमे चाप्यपर्याप्तः पाण्डवान्प्रति भारत।\nन हीमे सर्वराजानः पर्याप्ताः सहितास्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2039788, "chapter_id": 1879, "verse_number": "५-१२४-४८", "content_sanskrit": "क्रुद्धस्य भीमसेनस्य प्रेक्षितुं मुखमाहवे।\nइदं सनिहितं तात समग्रं पार्थिवं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2039789, "chapter_id": 1879, "verse_number": "५-१२४-४९", "content_sanskrit": "अयं भीष्मस्तथा द्रोणः कर्णश्चायं तथा कृपः ।\nभूरिश्रवाः सौमदत्तिरश्वत्थामा जयद्रथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2039790, "chapter_id": 1879, "verse_number": "५-१२४-५०", "content_sanskrit": "अशक्ताः सर्व एवैते प्रतियोद्धुं धनञ्जयम् ।\nअजेयो ह्यर्जुनः सङ्ख्ये सर्वैरपि सुरासुरैः ।\nमानुषैरपि गन्धर्वैर्मा युद्धे चेत आधिथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2039791, "chapter_id": 1879, "verse_number": "५-१२४-५१", "content_sanskrit": "दृश्यतां वा पुमान्कश्चित्समग्रे पार्थिवे बले।\nयोऽर्जुनं समरे प्राप्य स्वस्तिमानाव्रजेद्गृहान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2039792, "chapter_id": 1879, "verse_number": "५-१२४-५२", "content_sanskrit": "किं ते जनक्षयेणेह कृतेन भरतर्षभ ।\nयस्मिञ्चिते जितं ते स्यात्पुमानेकः स दृश्यतां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2039793, "chapter_id": 1879, "verse_number": "५-१२४-५३", "content_sanskrit": "यः सदेवान्सगन्धर्वान्सयक्षासुरपन्नगान् ।\nअजयत्खाण्डवप्रस्थे कस्तं युद्धेय मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2039794, "chapter_id": 1879, "verse_number": "५-१२४-५४", "content_sanskrit": "तथा विराटनगरे श्रूयते महदद्भुतम्।\nएकस्य च बहूनां च पर्याप्तं तन्निदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2039795, "chapter_id": 1879, "verse_number": "५-१२४-५५", "content_sanskrit": "युद्धे येन महादेवः साक्षात्सन्तोषितः शिवः ।\nतमजेयमनाधृष्यं विजेतुं जिष्णुमच्युतम् ।\nआशंससीह समरे वीरमर्जुनमूर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2039796, "chapter_id": 1879, "verse_number": "५-१२४-५६", "content_sanskrit": "मद्द्वितीयं पुनः पार्थं कः प्रार्थयितुमर्हति ।\nयुद्धे प्रतीपमायान्तमपि साक्षात्पुरन्दरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2039797, "chapter_id": 1879, "verse_number": "५-१२४-५७", "content_sanskrit": "बाहुभ्यामुद्वहेद्भूमिं दहेत्क्रुद्ध इमाः प्रजाः ।\nपातयेत्रिदिवाद्देवान्योऽर्जुनं समरे जयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2039798, "chapter_id": 1879, "verse_number": "५-१२४-५८", "content_sanskrit": "पश्य पुत्रांस्तथा भ्रातॄञ्ज्ञातीन्संबन्धिनस्तथा।\nत्वत्कृते न विनश्येयुरिमे भरतसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2039799, "chapter_id": 1879, "verse_number": "५-१२४-५९", "content_sanskrit": "अस्तु शेषं कौरवाणां मा पराभूदिदं कुलम् ।\nकुलघ्न इति नोच्येथा नष्टकीर्तिर्नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2039800, "chapter_id": 1879, "verse_number": "५-१२४-६०", "content_sanskrit": "त्वामेव स्थापयिष्यन्ति यौवराज्ये महारथाः ।\nमहाराज्येऽपि पितरं धृतराष्ट्रं जनेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2039801, "chapter_id": 1879, "verse_number": "५-१२४-६१", "content_sanskrit": "मा तात श्रियमायान्तीमवमंस्थाः समुद्यताम् ।\nअर्धं प्रदाय पार्थेभ्यो महतीं श्रियमाप्नुहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2039802, "chapter_id": 1879, "verse_number": "५-१२४-६२", "content_sanskrit": "पाण्डवैः संशमं कृत्वा कृत्वा च सुहृदां वचः ।\nसंप्रीयमाणो मित्रैश्च चिरं भद्राण्यवाप्स्यसि ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2039803, "chapter_id": 1879, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि चतुर्विंशत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]