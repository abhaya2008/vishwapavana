[{"id": 7003954000, "chapter_id": 23954, "verse_number": "३-१-१७-१", "content_sanskrit": "श्रीसूत उवाच ।\nपुनरित्याह कक्षीवान्पितरं तं मुनीश्वराः ।\nयथोदंकेन गुरुणा प्रेषितोऽहमिहा धुना॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003954001, "chapter_id": 23954, "verse_number": "३-१-१७-२", "content_sanskrit": "समागतोस्मि तीर्थेऽस्मिन्नागस्त्ये मुनिसत्तम ।\nस्वनयस्य सुतोद्वाहसिद्ध्यर्थं गुरुचोदितः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003954002, "chapter_id": 23954, "verse_number": "३-१-१७-३", "content_sanskrit": "उपायं तन्निगदितमत्र कुर्व न्न्यवर्तिषम् ।\nवर्षत्रयावसाने मामुद्वाहोपायसंयुतम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003954003, "chapter_id": 23954, "verse_number": "३-१-१७-४", "content_sanskrit": "स्वनयोत्रैव तिष्ठन्तमाससाद यदृच्छया ।\nस च मामेत्य कन्यां ते दास्यामीति वचोऽब्रवीत्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003954004, "chapter_id": 23954, "verse_number": "३-१-१७-५", "content_sanskrit": "ततोस्मदनुरोधेन त्वामाह्वयदयं नृपः ।\nइतीरयित्वा पितरं कक्षीवान्विरराम सः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003954005, "chapter_id": 23954, "verse_number": "३-१-१७-६", "content_sanskrit": "सुदर्शनोऽथ विप्रेंद्रः पुरोधाः स्वन यस्य सः ।\nप्रययौ राजसविधं स्वनयाय निवेदितुम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003954006, "chapter_id": 23954, "verse_number": "३-१-१७-७", "content_sanskrit": "राजानं तं समासाद्य स्वनयं स सुदर्शनः ।\nप्राप्तं निवेदयामास तं दीर्घतमसं मुनिम्॥ ७ ॥  ।\nततः स राजा स्वनयो मुनिं प्राप्तं पुरोहितात् ।\nश्रुत्वा विनिर्ययौ द्रष्टुं महसा पटमण्डपात्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003954007, "chapter_id": 23954, "verse_number": "३-१-१७-८", "content_sanskrit": "अगस्त्यतीर्थतीरे तं सपुत्रमृषि सत्तमम् ।\nददर्श राजा स्वनयो ब्रह्माणमिव देवराट्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003954008, "chapter_id": 23954, "verse_number": "३-१-१७-९", "content_sanskrit": "ववंदे दीर्घतमसश्चरणौ लोकमंगलौ ।\nउत्थाप्य नृपतिं विप्रास्तदा दीर्घतमा मुनिः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003954009, "chapter_id": 23954, "verse_number": "३-१-१७-१०", "content_sanskrit": "आशिषं प्रयुयोजाथ स्वनयाय नृपाय सः ।\nअत्रांतरे समायात उदंकोऽपि महानृषिः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003954010, "chapter_id": 23954, "verse_number": "३-१-१७-११", "content_sanskrit": "रामसेतौ धनुष्कोटौ स्नातुं शिष्यगणैर्वृतः ।\nलक्षसंख्यो मुनिगणस्तेन साकं मुनीश्वरः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003954011, "chapter_id": 23954, "verse_number": "३-१-१७-१२", "content_sanskrit": "उदंकोऽगस्त्यतीर्थेस्मिन्स्नातुं संप्राप्तवान्मुनिः ।\nउदंकमागतं दृष्ट्वा कक्षीवान्प्रणनाम तम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003954012, "chapter_id": 23954, "verse_number": "३-१-१७-१३", "content_sanskrit": "अकरोदाशिषं विप्रः शिष्यायाथ गुरुस्तदा ।\nअथ दीर्घतमा विप्रस्तमुदंकं महामुनिम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003954013, "chapter_id": 23954, "verse_number": "३-१-१७-१४", "content_sanskrit": "कुशलं परिपप्रच्छ सोऽपि तं मुनि पुंगमम् ।\nउभौ तौ मुनिशार्दूलौ सर्वलोकेषु विश्रुतौ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003954014, "chapter_id": 23954, "verse_number": "३-१-१७-१५", "content_sanskrit": "कथयामासतुस्तत्र कथाः पापप्रणाशिनीः ।\nअथ राजाप्युदंकं तं प्रणनाम मुनीश्व रम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003954015, "chapter_id": 23954, "verse_number": "३-१-१७-१६", "content_sanskrit": "उदंकोप्याशिषं तस्मै प्रायुंक्त स्वनयाय वै ।\nराजाथ स्वनयः प्रीतस्तत्र वाक्यमभाषत॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003954016, "chapter_id": 23954, "verse_number": "३-१-१७-१७", "content_sanskrit": "मुनिं तं दीर्घतमसं विवाहः क्रिय तामिति ।\nतथास्त्वित्यवदत्सोऽपि तदा दीर्घतमा मुनिः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003954017, "chapter_id": 23954, "verse_number": "३-१-१७-१८", "content_sanskrit": "श्व एव क्रियतां राजन्सुमुहूर्ते महामते ।\nअत्रैव पाणिग्रहणं क्रियतां गन्धमा दने॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003954018, "chapter_id": 23954, "verse_number": "३-१-१७-१९", "content_sanskrit": "तस्मादिहानय क्षिप्रं कन्यामंतःपुरं तथा ।\nइत्युक्तः स्वनयो राजा गत्वा स्वपटमण्डपम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003954019, "chapter_id": 23954, "verse_number": "३-१-१७-२०", "content_sanskrit": "आहूय शतसंख्याकान्वृद्धान्वर्ष वरांस्तदा ।\nआनेतुं प्रेषयामास कन्यामंतःपुरं तथा॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003954020, "chapter_id": 23954, "verse_number": "३-१-१७-२१", "content_sanskrit": "ते वर्षवरमुख्यास्तु स्वनयेन प्रचोदिताः ।\nमनोजवान्समारुह्य वाजिनो मधुरां ययुः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003954021, "chapter_id": 23954, "verse_number": "३-१-१७-२२", "content_sanskrit": "गत्वा चांतःपुरं तूर्णं वृत्तं सर्वं निवेद्यच ।\nकन्ययांतःपुरेणापि सहिताः पुनराययुः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003954022, "chapter_id": 23954, "verse_number": "३-१-१७-२३", "content_sanskrit": "ततः परस्मिन्दिवसे शुभे दीर्घतमा ऋषिः ।\nगोदानादीनि पुत्रस्य विधिवन्निरवर्तयत्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003954023, "chapter_id": 23954, "verse_number": "३-१-१७-२४", "content_sanskrit": "निर्वृत्तेष्वथ कक्षीवान्गोदानादिषु कर्मसु ।\nउद्वोढुं राजतनयां पित्रा च गुरुणा सह॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003954024, "chapter_id": 23954, "verse_number": "३-१-१७-२५", "content_sanskrit": "चतुर्दंतं महाकायं गजं सर्वांगपांडुरम् ।\nआरुह्य हर्षसंयुक्तो द्वितीय इव देवराट्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003954025, "chapter_id": 23954, "verse_number": "३-१-१७-२६", "content_sanskrit": "मनोरमायाः कन्यायाः पूरयंश्च मनोरथम् ।\nब्राह्मणैर्बहुसाहस्रैः सहितः स्वस्तिवाचकैः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003954026, "chapter_id": 23954, "verse_number": "३-१-१७-२७", "content_sanskrit": "तोरणालंकृतद्वारं राजर्षे पटमण्डपम् ।\nकृतमंगलकृत्योऽसौ कक्षीवान्मुदितो ययौ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003954027, "chapter_id": 23954, "verse_number": "३-१-१७-२८", "content_sanskrit": "ततः स्वनयकन्या सा कृतमंगलभूषणा ।\nचतुर्दंतमहाकायश्वेतदंतावलस्थितम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003954028, "chapter_id": 23954, "verse_number": "३-१-१७-२९", "content_sanskrit": "कक्षीवंतं समायांतं दृष्ट्वा स्वोद्वाहनोत्सुकम् ।\nप्रतिज्ञा मत्कृते दानीं निर्वृत्तेति मुदं ययौ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003954029, "chapter_id": 23954, "verse_number": "३-१-१७-३०", "content_sanskrit": "कक्षीवान्दीर्घतमसा तथोदंकेन संयुतः ।\nपटाकारबहिर्द्वारं क्रमाद्राज्ञः समाययौ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003954030, "chapter_id": 23954, "verse_number": "३-१-१७-३१", "content_sanskrit": "स्वनयस्तु ततो दृष्ट्वा कक्षीवंतं समागतम् ।\nप्रत्युज्जगाम सहितः सुदर्शनपुरोधसा॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003954031, "chapter_id": 23954, "verse_number": "३-१-१७-३२", "content_sanskrit": "कक्षीवतो वरस्याथ कन्यकापरिचारिकाः ।\nराजतैः स्वर्णपात्रैश्च चक्रु र्नीराजनाविधिम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003954032, "chapter_id": 23954, "verse_number": "३-१-१७-३३", "content_sanskrit": "स्वनयेन समाहूतो ब्राह्मणैः परिवारितः ।\nप्रविवेशाथ लक्ष्मीवान्कक्षीवान्राजमंदिरम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003954033, "chapter_id": 23954, "verse_number": "३-१-१७-३४", "content_sanskrit": "ततो वरेण सहितं तं दीर्घतमसं मुनिम् ।\nसोदंकमनयद्राजा स्वगृहं विनयान्वितः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003954034, "chapter_id": 23954, "verse_number": "३-१-१७-३५", "content_sanskrit": "उदंकदीर्घतमसोरर्घ्यं च प्रददौ नृपः ।\nअलंकृते प्रपामध्ये वस्त्रचामरतोरणैः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003954035, "chapter_id": 23954, "verse_number": "३-१-१७-३६", "content_sanskrit": "वरो दीर्घतमाश्चान्ये सोदंका मुनयस्तदा ।\nन्यषीदन्स्वनयश्चापि सामात्यः सपुरोहितः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003954036, "chapter_id": 23954, "verse_number": "३-१-१७-३७", "content_sanskrit": "ततो दुहितरं कन्यां सुकेशीं तां मनो रमाम् ।\nभूषणालंकृतां गात्रे दिव्यवस्त्रधरां शुभाम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003954037, "chapter_id": 23954, "verse_number": "३-१-१७-३८", "content_sanskrit": "बिंबोष्ठीं चारुसर्वांगीं पीनोन्नतपयोधराम् ।\nप्रपायामध्यमनयन्महाजनसमाकुलम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003954038, "chapter_id": 23954, "verse_number": "३-१-१७-३९", "content_sanskrit": "ततो वरस्य कंठे सा मालां चंपकनिर्मिताम् ।\nनिवेशयामास शुभा जनमध्ये मनोरमा॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003954039, "chapter_id": 23954, "verse_number": "३-१-१७-४०", "content_sanskrit": "उदंकस्तत आगत्य प्रतिष्ठाप्यानलं स्थले ।\nकृत्वाग्निमुखपर्यंतं लाजाहोमादिकं तथा॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003954040, "chapter_id": 23954, "verse_number": "३-१-१७-४१", "content_sanskrit": "पाणिमग्राहयत्तस्याः कन्यायाश्च वरेण तु ।\nउदंकः सर्वकर्माणि कारयामास तत्र वै॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003954041, "chapter_id": 23954, "verse_number": "३-१-१७-४२", "content_sanskrit": "वरवध्वोस्तदा विप्राः प्रायुंजत तदाशिषः ।\nततः स राजा स्वनयो वरं दीर्घतमोमुनिम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003954042, "chapter_id": 23954, "verse_number": "३-१-१७-४३", "content_sanskrit": "उदंकं वरपक्षीयान्स्वपक्षीयांस्तथाद्विजाः ।\nत्रिलक्षं ब्राह्मणानन्नैर्भोजयामास षड्रसैः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003954043, "chapter_id": 23954, "verse_number": "३-१-१७-४४", "content_sanskrit": "ततः संभावयामास तांबूलाद्यैरनेकधा ।\nअथामंत्र्य मुनिश्रेष्ठमुदंकः स्वाश्रमं ययौ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003954044, "chapter_id": 23954, "verse_number": "३-१-१७-४५", "content_sanskrit": "अन्ये च ब्राह्मणाः सर्वे स्वदेशान्प्रययुस्तदा ।\nएवं विवाहे निर्वृत्ते कक्षीवद्राजकन्ययोः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003954045, "chapter_id": 23954, "verse_number": "३-१-१७-४६", "content_sanskrit": "प्रविश्यागस्त्यतीर्थं स तिरोधत्त गजोत्तमः ।\nततो दीर्घतमा विप्राः पुत्रेण स्नुषया सह॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003954046, "chapter_id": 23954, "verse_number": "३-१-१७-४७", "content_sanskrit": "अगस्त्यस्य महातीर्थे स्नानं कृत्वेष्टदायिनि ।\nश्लाघमानश्च तत्तीर्थं सर्वलोकेषु विश्रुतम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003954047, "chapter_id": 23954, "verse_number": "३-१-१७-४८", "content_sanskrit": "प्रयातुं स्वा श्रमं पुण्यं वेदारण्यं मनो दधे ।\nराजानं च तमागंतुमापृच्छन्मुनिसत्तमः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003954048, "chapter_id": 23954, "verse_number": "३-१-१७-४९", "content_sanskrit": "स्वनयोऽपि तदा राजा स्वदुहित्रे मुदान्वितः ।\nददौ शतसहस्राणि स्वर्णानि स्त्रीधनं तदा॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003954049, "chapter_id": 23954, "verse_number": "३-१-१७-५०", "content_sanskrit": "गवां सहस्रं प्रददौ दासीनां च सहस्रकम् ।\nग्रामं पंचशतं चापि ददौ दुहितृवत्सलः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003954050, "chapter_id": 23954, "verse_number": "३-१-१७-५१", "content_sanskrit": "दिव्यवस्त्रा युतं चापि शतं भूषणपेटिकाः ।\nहारमालासहस्रं च ददौ दुहितृसौहृदात्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003954051, "chapter_id": 23954, "verse_number": "३-१-१७-५२", "content_sanskrit": "एतत्सर्वं समादाय स पुत्रः सस्नुषो मुनिः ।\nराज्ञा च समनुज्ञातः प्रययौ वेदकाननम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003954052, "chapter_id": 23954, "verse_number": "३-१-१७-५३", "content_sanskrit": "वेदारण्यं समासाद्य तदा दीर्घतमा मुनिः ।\nउवास ससुखं विप्राः पुत्रेण स्नुषया सह॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003954053, "chapter_id": 23954, "verse_number": "३-१-१७-५४", "content_sanskrit": "सेवन्वेदाटवीनाथं भुक्तिमुक्तिफलप्रदम् ।\nन्यवसत्तु चिरं कालं कक्षीवानपि भार्यया॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003954054, "chapter_id": 23954, "verse_number": "३-१-१७-५५", "content_sanskrit": "स्वनयोपि स राजर्षिः स्नात्वा कुंभजनिर्मिते ।\nतत्र तीर्थे महापुण्ये सहितः सर्वसैनिकैः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003954055, "chapter_id": 23954, "verse_number": "३-१-१७-५६", "content_sanskrit": "अतःपुरं समादाय मुदितः स्वपुरं ययौ ।\nअगस्त्यतीर्थमाहात्म्यादेवं कक्षीवतो मुनेः ।\nअनन्यसुलभो विप्रा विवाहः समजायत॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003954056, "chapter_id": 23954, "verse_number": "३-१-१७-५७", "content_sanskrit": "श्रीसूत उवाच ।\nइतिहासस्त्वयं पुण्यो वेदसिद्धो मुनीश्वराः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003954057, "chapter_id": 23954, "verse_number": "३-१-१७-५८", "content_sanskrit": "धन्यो यशस्य आयुष्यः कीर्तिसौभाग्य वर्द्धनः ।\nश्रोतव्यः पठितव्योऽयं सर्वथा मानवैर्द्विजाः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003954058, "chapter_id": 23954, "verse_number": "३-१-१७-५९", "content_sanskrit": "पठतां शृण्वतां चेममितिहासं पुरातनम् ।\nनेहामुत्रापि वा क्लेशो दारिद्यं चापि नो भवेत्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]