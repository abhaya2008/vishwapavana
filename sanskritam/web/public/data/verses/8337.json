id": 8337, "verse_number": "13.9", "content_sanskrit": "तस्य साक्षिसिद्धत्वं चेत् जगत्सत्यत्वमपि साक्षिसिद्धम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900004366, "chapter_id": 8337, "verse_number": "13.10", "content_sanskrit": "व्यभिचारश्चेदागमार्थानुमानिर्दोषत्वाध्यवसाये च समः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900004367, "chapter_id": 8337, "verse_number": "13.11", "content_sanskrit": "अत उत्तरदिवसे अभेदवाक्यस्य भेदोऽर्थः स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900004368, "chapter_id": 8337, "verse_number": "13.12", "content_sanskrit": "निर्दोषानुमायाः सदोषत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900004369, "chapter_id": 8337, "verse_number": "13.13", "content_sanskrit": "आश्रयसाध्यव्यधिकरणासिद्धयो न दूषणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900004370, "chapter_id": 8337, "verse_number": "13.14", "content_sanskrit": "अतिप्रसङ्गाभावात् अतिप्रसङ्गेन हि दोषत्वादोषत्वे कल्प्ये", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900004371, "chapter_id": 8337, "verse_number": "13.15", "content_sanskrit": "व्याप्तिरेव हि प्रयोजिका", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900004372, "chapter_id": 8337, "verse_number": "13.16", "content_sanskrit": "असत्यपि व्याप्तिरस्त्येव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900004373, "chapter_id": 8337, "verse_number": "13.17",