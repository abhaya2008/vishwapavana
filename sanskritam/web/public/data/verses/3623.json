[{"id": 2122205, "chapter_id": 3623, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2122206, "chapter_id": 3623, "verse_number": "१", "content_sanskrit": "एतानि च निमित्तानि यानि चान्यानि भारत ।\nकेशवाद् देवकीपुत्राज्जायन्ते वै खगानि च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2122207, "chapter_id": 3623, "verse_number": "२", "content_sanskrit": "चन्द्रादित्यौ ग्रहाश्चैव नक्षत्राणि च भारत ।\nवायुरग्निस्तथैवापः पृथिवी च जनार्दनात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2122208, "chapter_id": 3623, "verse_number": "३", "content_sanskrit": "यस्य देशस्य हानिं वा वृद्धिं वा कर्तुमिच्छति ।\nतस्मिन् देशे निमित्तानि तानि तानि करोत्ययम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2122209, "chapter_id": 3623, "verse_number": "४", "content_sanskrit": "योऽसौ चेदिपतेस्तात विनाशः समुपस्थितः ।\nनिवेदयति गोविन्दस्तदुपायैर्न संशयः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2122210, "chapter_id": 3623, "verse_number": "५", "content_sanskrit": "इयं प्रचलिता भूमिरशिवं वान्ति मारुताः ।\nराहुश्चाभ्यपतत् सोममपर्वणि विशाम्पते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2122211, "chapter_id": 3623, "verse_number": "६", "content_sanskrit": "सनिर्घाताः पतन्त्युल्कास्तमः सञ्जायते भृशम् ।\nचेदिराजविनाशाय हरिरेष विजृम्भते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2122212, "chapter_id": 3623, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2122213, "chapter_id": 3623, "verse_number": "७", "content_sanskrit": "एवमुक्त्वा तु भगवान् नारदो विरराम ह ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2122214, "chapter_id": 3623, "verse_number": "८", "content_sanskrit": "सभायां पुरुषसिंहाभ्यां तस्मिन् युद्ध उपस्थिते ।\nददृशुर्भूमिपालास्ते घोरानुत्पातकान् बहून् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2122215, "chapter_id": 3623, "verse_number": "९", "content_sanskrit": "तत्र तैर्दृश्यमानानां दिक्षु सर्वासु भारत ।\nअश्रूयन्त तदा राजन् शिवानामशिवा गिरः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2122216, "chapter_id": 3623, "verse_number": "१०", "content_sanskrit": "ररास च मही कृत्स्ना सवृक्षपुरपर्वता ।\nअपर्वणि च मध्याह्ने सूर्यं स्वर्भानुरग्रसत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2122217, "chapter_id": 3623, "verse_number": "११", "content_sanskrit": "ध्वजाग्रे चेदिराजस्य सर्वरत्नपरिष्कृते ।\nअपतत् खाच्च्युतो गृध्रस्तीक्ष्णतुण्डः परन्तप ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2122218, "chapter_id": 3623, "verse_number": "१२", "content_sanskrit": "आरण्यैः सह संहृष्टा ग्राम्याश्च मृगपक्षिणः ।\nचुक्रुशुर्भैरवं तत्र तस्मिन् युद्ध उपस्थिते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2122219, "chapter_id": 3623, "verse_number": "१३", "content_sanskrit": "एवमादीनि घोराणि भौमानि च खगानि च ।\nऔत्पातिकान्यदृश्यन्त सङ्क्रुद्धे शार्ङ्गधन्वनि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2122220, "chapter_id": 3623, "verse_number": "७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि पञ्चषष्टितमोऽध्यायः ॥६५॥\n॥ शिशुपालवधपर्वणि सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2122221, "chapter_id": 3623, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]