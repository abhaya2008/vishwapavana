[{"id": 2011293, "chapter_id": 1230, "verse_number": "१-२३१-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011294, "chapter_id": 1230, "verse_number": "१-२३१-१", "content_sanskrit": "ततो देवर्षयः सर्वे सिद्धाश्च परमर्षयः।\nजग्मुस्तदा परमार्तिं दृष्ट्वा तत्कदनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011295, "chapter_id": 1230, "verse_number": "१-२३१-२", "content_sanskrit": "तेऽभिजग्मुर्जितक्रोधा जितात्मानो जितेन्द्रियाः।\nपितामहस्य भनं जगतः कृपया तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011296, "chapter_id": 1230, "verse_number": "१-२३१-३", "content_sanskrit": "ततो ददृशुरासीनं सह देवैः पितामहम्।\nसिद्धैर्ब्रह्मर्षिभिश्चैव समन्तात्परिवारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011297, "chapter_id": 1230, "verse_number": "१-२३१-४", "content_sanskrit": "तत्र देवो महादेवस्तत्राग्निर्वायुना सह।\nचन्द्रादित्यौ च शक्रश्च पारमेष्ठ्यास्तथर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011298, "chapter_id": 1230, "verse_number": "१-२३१-५", "content_sanskrit": "वैखानसा वालखिल्या वानप्रस्था मरीचिपाः।\nअजाश्चैवाविमूढाश्च तेजोगर्भास्तपस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011299, "chapter_id": 1230, "verse_number": "१-२३१-६", "content_sanskrit": "ऋषयः सर्व एवैते पितामहमुपागमन्।\nततोऽभिगम्य ते दीनाः सर्व एव महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011300, "chapter_id": 1230, "verse_number": "१-२३१-७", "content_sanskrit": "सुन्दोपसुन्दयौः कर्म सर्वमेव शशंसिरे।\nयथा हृतं यथा चैव कृतं येन क्रमेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011301, "chapter_id": 1230, "verse_number": "१-२३१-८", "content_sanskrit": "न्यवेदयंस्ततः सर्वमखिलेन पितामहे।\nततो देवगणाः सर्वे ते चैव परमर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011302, "chapter_id": 1230, "verse_number": "१-२३१-९", "content_sanskrit": "तमेवार्थं पुरस्कृत्य पितामहमचोदयन्।\nततः पितामहः श्रुत्वा सर्वेषां तद्वचस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011303, "chapter_id": 1230, "verse_number": "१-२३१-१०", "content_sanskrit": "मुहूर्तमिव संचिन्त्य कर्तव्यस्य च निश्चयम्।\nतयोर्वधं समुद्दिश्य विश्वकर्माणमाह्वयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011304, "chapter_id": 1230, "verse_number": "१-२३१-११", "content_sanskrit": "दृष्ट्वा च विश्वकर्माणं व्यादिदेश पितामहः।\nसृज्यतां प्रार्थनीयैका प्रमदेति महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011305, "chapter_id": 1230, "verse_number": "१-२३१-१२", "content_sanskrit": "पितामहं नमस्कृत्य तद्वाक्यमभिनन्द्य च।\nनिर्ममे योषितं दिव्यां चिन्तयित्वा पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011306, "chapter_id": 1230, "verse_number": "१-२३१-१३", "content_sanskrit": "त्रिषु लोकेषु यत्किंचिद्भूतं स्थावरजङ्गमम्।\nसमानयद्दर्शनीयं तत्तदत्र स विश्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011307, "chapter_id": 1230, "verse_number": "१-२३१-१४", "content_sanskrit": "कोटिशश्चैव रत्नानि तस्या गात्रे न्यवेशत्।\nतां रत्नसङ्घातमयीमसृजद्देवरूपिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011308, "chapter_id": 1230, "verse_number": "१-२३१-१५", "content_sanskrit": "सा प्रयत्नेन महता निर्मिता विश्वकर्मणा।\nत्रिषु लोकेषु नारीणां रूपेणाप्रतिमाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011309, "chapter_id": 1230, "verse_number": "१-२३१-१६", "content_sanskrit": "न तस्याः सूक्ष्ममप्यस्ति यद्गात्रे रूपसंपदा।\nनियुक्ता यत्र वा दृष्टिर्न सज्जति निरीक्षताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011310, "chapter_id": 1230, "verse_number": "१-२३१-१७", "content_sanskrit": "सा विग्रहवतीव श्रीः कामरूपा वपुष्मती।\nपितामहमुपातिष्ठत्किं करोमीति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011311, "chapter_id": 1230, "verse_number": "१-२३१-१८", "content_sanskrit": "प्रीतो भूत्वा स दृष्ट्वैव प्रीत्या चास्यै वरं ददौ।\nकान्तत्वं सर्वभूतानां साश्रियानुत्तमं वपुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011312, "chapter_id": 1230, "verse_number": "१-२३१-१९", "content_sanskrit": "सा तेन वरदानेन कर्तुश्च क्रियया तदा।\nजहार सर्वभूतानां चक्षूंषि च मनांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011313, "chapter_id": 1230, "verse_number": "१-२३१-२०", "content_sanskrit": "तिलंतिलं समानीय रत्नानां यद्विनिर्मिता।\nतिलोत्तमेति तत्तस्या नाम चक्रे पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011314, "chapter_id": 1230, "verse_number": "१-२३१-२१", "content_sanskrit": "ब्रह्माणं सा नमस्कृत्य प्राञ्जलिर्वाक्यमब्रवीत्।\nकिं कार्यं मयि भूतेश येनास्म्यद्येह निर्मिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011315, "chapter_id": 1230, "verse_number": "१-२३१-२२x", "content_sanskrit": "पितामह उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011316, "chapter_id": 1230, "verse_number": "१-२३१-२२", "content_sanskrit": "गच्छ सुन्दोपसुन्दाभ्यामसुराभ्यां तिलोत्तमे।\nप्रार्थनीयेन रूपेण कुरु भद्रे प्रलोभनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011317, "chapter_id": 1230, "verse_number": "१-२३१-२३", "content_sanskrit": "त्वत्कृते दर्शादेव रूपसंपत्कृतेन वै।\nविरोधः स्याद्यथा ताभ्यामन्योन्येन तथा कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011318, "chapter_id": 1230, "verse_number": "१-२३१-२४x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011319, "chapter_id": 1230, "verse_number": "१-२३१-२४", "content_sanskrit": "सा तथेति प्रतिज्ञाय नमस्कृत्य पितामहम्।\nचकार मण्डलं तत्र विबुधानां प्रदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011320, "chapter_id": 1230, "verse_number": "१-२३१-२५", "content_sanskrit": "प्राङ्मुखो भगवानास्ते दक्षिणेन महेश्वरः।\nदेवाश्चैवोत्तरेणासन्सर्वतस्त्वृषयोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011321, "chapter_id": 1230, "verse_number": "१-२३१-२६", "content_sanskrit": "कुर्वन्त्यां तु तदा तत्र मण्डलं तत्प्रदक्षिणम्।\nइन्द्रः स्थाणुश्च भगवान्धैर्येण तु परिच्युतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011322, "chapter_id": 1230, "verse_number": "१-२३१-२७", "content_sanskrit": "द्रष्टुकामस्य चात्यर्थं गतायां पार्श्वतस्तथा।\nअन्यदञ्चितपद्माक्षं दक्षिणं निःसृतं मुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011323, "chapter_id": 1230, "verse_number": "१-२३१-२८", "content_sanskrit": "पृष्ठतः परिवर्तन्त्यां पश्चिमं निःसृतं मुखम्।\nगतायां चोत्तरं पार्श्वमुत्तरं निःसृतं मुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011324, "chapter_id": 1230, "verse_number": "१-२३१-२९", "content_sanskrit": "महेन्द्रस्यापि नेत्राणां पृष्ठतः पार्श्वतोग्रतः।\nरक्तान्तानां विशालानां सहस्रं सर्वतोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011325, "chapter_id": 1230, "verse_number": "१-२३१-३०", "content_sanskrit": "एवं चतुर्मुखः स्थाणुर्महादेवोऽभवत्पुरा।\nतथा सहस्रनेत्रश्च बभूव बलसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2011326, "chapter_id": 1230, "verse_number": "१-२३१-३१", "content_sanskrit": "तथा देवनिकायानां महर्षीणां च सर्वशः।\nमुखानि चाभ्यवर्तन्त येन याति तिलोत्तमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2011327, "chapter_id": 1230, "verse_number": "१-२३१-३२", "content_sanskrit": "तस्या गात्रे निपतिता दृष्टिस्तेषां महात्मनाम्।\nसर्वेषामेव भूयिष्ठमृते देवं पितामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2011328, "chapter_id": 1230, "verse_number": "१-२३१-३३", "content_sanskrit": "गच्छन्त्यां तु तया सर्वे देवाश्च परमर्षयः।\nकृतमित्येव तत्कार्यं मेनिरे रूपसंपदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2011329, "chapter_id": 1230, "verse_number": "१-२३१-३४", "content_sanskrit": "तिलोत्तमायां तस्यां तु गतायां लोकभावनः।\nकृतं कार्यमिति श्रीमानब्रवीच्च पितामहः।\nसर्वान्विसर्जयामास देवानृषिगणांश्च तान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2011330, "chapter_id": 1230, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि विदुरागमनराज्यलाभपर्वणि एकत्रिंशदधिकद्विशततमोऽध्यायः॥ २३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]