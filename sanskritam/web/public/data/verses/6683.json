  {
    "id": 20011540,
    "chapter_id": 6683,
    "verse_number": "11.117",
    "content_sanskrit": "वेवीयमानाश्शिथिलं दुकूलं सेसिम्यमाना वदनग्रहेषु । सोषुप्यमाणास्सुरतश्रमेषु वावश्यते स्म व्रजयोषितोऽयम् ॥",
    "padaccheda": "",
    "anvaya": "",
