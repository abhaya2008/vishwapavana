  {
    "id": 20011539,
    "chapter_id": 6683,
    "verse_number": "11.116",
    "content_sanskrit": "जहर्ति स्म नवं दुग्धं जरिहर्ति पुरा घृतम् । जरीहर्ति स्म चाऽपूपान् गोपीनामेष शैशवे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
