  {
    "id": 20011538,
    "chapter_id": 6683,
    "verse_number": "11.115",
    "content_sanskrit": "स्माऽङ्के नरीनृत्यत एष मातुर्ननर्ति मूर्ध्नि स्म च कालियस्य । स्म वल्लवीनां नरिनर्ति मध्ये चित्ते नरीनर्ति च योगभाजाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
