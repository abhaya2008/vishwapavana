  {
    "id": 20011544,
    "chapter_id": 6683,
    "verse_number": "11.121",
    "content_sanskrit": "निघ्नन्नसौ सम्प्रति सर्वचोरान् करोति वर्णाश्रमधर्मरक्षाम् । अन्यत्तु गोपालविलासिनीनां घृतादिमन्ति प्रविशन् गृहाणि ॥",
    "padaccheda": "",
