[
  {
    "id": 20011424,
    "chapter_id": 6683,
    "verse_number": "11.1",
    "content_sanskrit": "अथैति स्म गुडाकेशः ककुभं पश्चिमोत्तराम् । अपारमञ्जनश्याममकूपारं विलोकयन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20011425,
    "chapter_id": 6683,
    "verse_number": "11.2",
    "content_sanskrit": "वातास्तैः कर्मसंयुक्तविभक्तैरुदकाणुभिः । सृज्यमानमिवैकत्र भज्यमानमिवान्यतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20011426,
    "chapter_id": 6683,
    "verse_number": "11.3",
    "content_sanskrit": "अनुष्णाशीतलस्पर्शैरपि शीतैरिवानिलैः । शीतांभःकणसंभिन्नैर्विलोलितमितस्ततः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20011427,
    "chapter_id": 6683,
    "verse_number": "11.4",
    "content_sanskrit": "विसर्पता समीरेण क्षिप्यमाणमितस्ततः । वियन्महातमालस्य पर्णराशिमिव च्युतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20011428,
    "chapter_id": 6683,
    "verse_number": "11.5",
    "content_sanskrit": "वातभूतोर्मिशाखास्तफेनपुष्पकदम्बकम् । तमालनीलं बिभ्राणं वाचालं वनमण्डलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20011429,
    "chapter_id": 6683,
    "verse_number": "11.6",
    "content_sanskrit": "रविदावाग्निदग्धस्य रेणुं व्योमगिरेरिव । सहडिण्डीरभस्मानं पवमानेन पातितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20011430,
    "chapter_id": 6683,
    "verse_number": "11.7",
    "content_sanskrit": "विभृतफेननिर्मोकान् कवलीकृतसन्मणीन् । कलयन्तं महाकालं कल्लोलानुरगानिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20011431,
    "chapter_id": 6683,
    "verse_number": "11.8",
    "content_sanskrit": "परिपीतपयःपूरमुद्यदुद्दामतेजसः । कृपाणमिव कालस्य जगत्संहारसाधनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20011432,
    "chapter_id": 6683,
    "verse_number": "11.9",
    "content_sanskrit": "प्रियामिव द्यामुल्लोलैरालिङ्गन्तं भुजैरिव । किञ्चिदुन्नम्य वार्वक्षःश्लिष्टपीनपयोधराम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20011433,
    "chapter_id": 6683,
    "verse_number": "11.10",
    "content_sanskrit": "घनदेहगतैर्नभ्रैर्मुक्तैर्व्योमपथश्रितैः । गम्यमानं चिरात्तोयैर्महात्मानमिवात्मभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20011434,
    "chapter_id": 6683,
    "verse_number": "11.11",
    "content_sanskrit": "सदापि गृह्यमाणानां वणिग्भिर्जलदैरपि । राशिभिस्सर्वदा पूर्णं रत्नानामम्भसामपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20011435,
    "chapter_id": 6683,
    "verse_number": "11.12",
    "content_sanskrit": "सर्वीयतरत्सम्पूर्णं गम्भीरं वाहिनीभृतम् । पूरयन्तं जगद्वन्धून्महतो जलदाञ्जलैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20011436,
    "chapter_id": 6683,
    "verse_number": "11.13",
    "content_sanskrit": "उदूर्मिबाहुं वाचालं कुपितं भानुमालिने । योद्धुकाममिव ध्वान्तमुदीराणं रसातलात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20011437,
    "chapter_id": 6683,
    "verse_number": "11.14",
    "content_sanskrit": "उदीरितसहस्रावं बलं दनुभुवामिव । अनन्तशयनाद्भीतं परापतदनारतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20011438,
    "chapter_id": 6683,
    "verse_number": "11.15",
    "content_sanskrit": "ज्वालाभिवडबस्याग्नेर्दह्यमानमिवानिशम् । चोक्रुश्यमानमत्यार्त्या विधुतोर्मिभुजावलिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20011439,
    "chapter_id": 6683,
    "verse_number": "11.16",
    "content_sanskrit": "ऊर्मिहस्तैरुदस्ताभिर्मुक्तावलिभिरापगाः । भूषयन्तं प्रियाः प्राप्ता रत्नमालापरिष्कृतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20011440,
    "chapter_id": 6683,
    "verse_number": "11.17",
    "content_sanskrit": "वीचिबाहुभिराश्लिष्टान् फेनधौताम्बरोज्ज्वले । उत्सङ्गे लुठतो मेघानर्भकानिव बिभ्रतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20011441,
    "chapter_id": 6683,
    "verse_number": "11.18",
    "content_sanskrit": "कवलीकृतनिःशेषभुवनाप्यायितोदरम् । तिरस्कृतसुरारातिलोकमञ्जनसन्निभम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20011442,
    "chapter_id": 6683,
    "verse_number": "11.19",
    "content_sanskrit": "मध्यन्दधानमौर्वाग्निप्रभापीताम्बरोज्वलम् । ऊर्मिदोश्शिखरोदस्तशङ्खचक्रविभूषितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20011443,
    "chapter_id": 6683,
    "verse_number": "11.20",
    "content_sanskrit": "शयानं भुवमालिङ्ग्य श्रीमन्तं समहामणिम् । अनन्तभोगिपर्यङ्कं नारायणमिवापरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20011444,
    "chapter_id": 6683,
    "verse_number": "11.21",
    "content_sanskrit": "तमालोक्य हरेः स्मृत्वा द्वारकां स्मैति फल्गुनः । सादृश्यदर्शनोद्बुद्धप्राक्तनज्ञानभावनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20011445,
    "chapter_id": 6683,
    "verse_number": "11.22",
    "content_sanskrit": "दृष्ट्वा द्वारवतीं पार्थः प्रीतिकौतूहलाकुलः । दूरादेवेति वक्ति स्म सुहृदो द्विजपुङ्गवान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20011446,
    "chapter_id": 6683,
    "verse_number": "11.23",
    "content_sanskrit": "दृश्या पुरीयं युष्माभिर्द्वारका द्विजपुङ्गवाः । क्रियते स्म स्वयं त्वष्ट्रा कृष्णसंचोदितेन या ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20011447,
    "chapter_id": 6683,
    "verse_number": "11.24",
    "content_sanskrit": "अस्माभिर्या स्म दृश्यन्ते पृथिव्यामुत्तमाः पुरः । महेन्द्रप्रस्थमुख्यास्तास्सौधैः प्रहसतीव या ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20011448,
    "chapter_id": 6683,
    "verse_number": "11.25",
    "content_sanskrit": "यस्य पुंसः पुराणस्य वसति स्मोदरे जगत् । प्रलये विभृतेयातमुदरेणोरुविग्रहम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20011449,
    "chapter_id": 6683,
    "verse_number": "11.26",
    "content_sanskrit": "किं वेश्म संस्कृतं कृत्स्नमिति पृष्टाः प्रगेतराम् । दास्यो दाशार्हपत्नीभिर्यस्यां प्रतिवदन्ति ताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20011450,
    "chapter_id": 6683,
    "verse_number": "11.27",
    "content_sanskrit": "ननु संस्क्रयते सर्वं गृहमित्येव पेशलाः' । न तु संस्क्रयते नेति कदाचन निवेशनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20011451,
    "chapter_id": 6683,
    "verse_number": "11.28",
    "content_sanskrit": "तथा किमन्नसम्पन्नमिति पृष्टाः स्वभर्तृभिः । काले वदन्ति गेहिन्यो यस्यां सम्पद्यते न्विति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20011452,
    "chapter_id": 6683,
    "verse_number": "11.29",
    "content_sanskrit": "अद्य नास्ति पुरा नास्ति नास्ति चास्या पुरः पुरी । समा विश्वंभरध्यात्विश्वकर्ममनोभुवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20011453,
    "chapter_id": 6683,
    "verse_number": "11.30",
    "content_sanskrit": "प्रविश्यतामिमां तूर्णं यावदीक्षामहे वयम् । रत्नैर्विरचितां त्वष्ट्रा नाकलोकादुपाहुतैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20011454,
    "chapter_id": 6683,
    "verse_number": "11.31",
    "content_sanskrit": "कदाऽऽलोकामहे कृष्णं कर्हि वीक्षामहे बलम् । इत्थं द्वाःस्थैर्नृपा रुद्धा वदन्त्यस्यां बहिः स्थिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20011455,
    "chapter_id": 6683,
    "verse_number": "11.32",
    "content_sanskrit": "प्रयच्छत्यतिथिभ्योऽन्नमत्र कोधनवानिति । ददते योऽतिथिभ्योऽन्नं स स्वर्गं गच्छतीति च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20011456,
    "chapter_id": 6683,
    "verse_number": "11.33",
    "content_sanskrit": "वदतो ब्राह्मणान्न भोजयन्ति कुटुम्बिनः । दयाद्रविणसम्पन्नमानसोत्तममन्दिराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20011457,
    "chapter_id": 6683,
    "verse_number": "11.34",
    "content_sanskrit": "दृष्ट्वेह युष्मानभ्येत्य नमन्ति यदि नागराः । तान् समृद्धयथाशीर्भिस्सवीर्या हि द्विजातयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20011458,
    "chapter_id": 6683,
    "verse_number": "11.35",
    "content_sanskrit": "ऊर्ध्वं मुहूर्तादृत्व्यं गत्वा पश्यत चेद्धरिम् । नम्यं जगद्भिस्स्तुत्यञ्च नमथ स्तुथ चादरात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20011459,
    "chapter_id": 6683,
    "verse_number": "11.36",
    "content_sanskrit": "अस्माद्वसुमतीभागादध्वा योऽस्माभिरीयते । तद्भूश्रमो न श्रीभर्तुर्दर्शनेनाद्य शाम्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20011460,
    "chapter_id": 6683,
    "verse_number": "11.37",
    "content_sanskrit": "नूनमत्रास्ति कृष्णश्च महान् यत्राऽयमुत्सवः । विशामस्तदिमां तूर्णं विष्टरश्रवसः पुरीम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20011461,
    "chapter_id": 6683,
    "verse_number": "11.38",
    "content_sanskrit": "वनमालाभृतं नीलं पीताम्बरमहं प्रियम् । पश्यामि पुण्डरीकाक्षं यदि गाढं परिष्वजे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20011462,
    "chapter_id": 6683,
    "verse_number": "11.39",
    "content_sanskrit": "अपि श्लिष्यसि गोपींस्त्वं कुब्जां जातु स्पृशस्यपि । स्त्रीष्वित्थमविशेषेण कथं नामासि चञ्चलः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20011463,
    "chapter_id": 6683,
    "verse_number": "11.40",
    "content_sanskrit": "बहुप्रियस्सकोपाभिः प्रियाभिरिति गर्हितः । नमयत्याननेन्दुं यो मन्दाक्षलवसुन्दरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20011464,
    "chapter_id": 6683,
    "verse_number": "11.41",
    "content_sanskrit": "जगत्सु जीयते येन क्षीयते मूर्धसु द्विषाम् । शय्यते सौधशृङ्गेषु कान्ताभिस्सह रम्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20011465,
    "chapter_id": 6683,
    "verse_number": "11.42",
    "content_sanskrit": "हन्यन्ते दानवा देवाः पाल्यन्ते शरणं गताः । पूज्यन्ते च द्विजा येन सर्वेण सह गोगणाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20011466,
    "chapter_id": 6683,
    "verse_number": "11.43",
    "content_sanskrit": "इति पार्थो वदन्नेव पुरीं प्रविशति स्म तम् । अतियाति स्म कक्ष्याञ्च सह तैर्द्विजपुङ्गवैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20011467,
    "chapter_id": 6683,
    "verse_number": "11.44",
    "content_sanskrit": "विज्ञापितो विभोर्वाचा प्रतिहारैः प्रवेशितः । कक्ष्यां क्रमेण सोऽतीत्य पुरा प्राप्नोति संसदम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20011468,
    "chapter_id": 6683,
    "verse_number": "11.45",
    "content_sanskrit": "स संहतर्कचन्द्यस्तशिखण्डं पीतवाससम् । पुरारिकन्धराश्यामं पश्यति श्रीधरं पुरा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20011469,
    "chapter_id": 6683,
    "verse_number": "11.46",
    "content_sanskrit": "प्रीतिपूर्णमुखच्छायं रत्नाभरणभासुरम् । ताराशारमिवाकाशं शरत्पूर्णशशिश्रियम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20011470,
    "chapter_id": 6683,
    "verse_number": "11.47",
    "content_sanskrit": "सवक्त्रकमलं पाणिपादकोकनदान्वितम् । समन्दहासकल्हारं यमुनाया इव ह्रदम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20011471,
    "chapter_id": 6683,
    "verse_number": "11.48",
    "content_sanskrit": "आसीनं मेरुसङ्काशे काञ्चने परमासने । ऊढसार्वकृपातोयं नवाम्बुदविडम्बिनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20011472,
    "chapter_id": 6683,
    "verse_number": "11.49",
    "content_sanskrit": "सुधर्माया मणिस्तम्भभित्त्यादिप्रतिमाच्छलात् । दर्शयन्तमिव प्रीत्या तदानीं विश्वरूपताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20011473,
    "chapter_id": 6683,
    "verse_number": "11.50",
    "content_sanskrit": "क्षीरीदेनेव नम्रेण वितानेन प्रथीयसा । धवलेन सरतेन श्रीमता परिसेवितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20011474,
    "chapter_id": 6683,
    "verse_number": "11.51",
    "content_sanskrit": "प्रेमविस्रस्तहस्ताग्रसुन्दरीमन्दधूनितैः । विचलत्केशकौशेयं व्यजनैः पेलवानिलैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20011475,
    "chapter_id": 6683,
    "verse_number": "11.52",
    "content_sanskrit": "सुहृद्भिरुद्धवप्रष्ठैर्वद्धगोष्ठीरसं सह । सहर्षं हरिणाक्षीषु डोलायितदृशं मुहुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20011476,
    "chapter_id": 6683,
    "verse_number": "11.53",
    "content_sanskrit": "अथ प्रेयांसमालोक्य सहसा माधवोऽर्जुनम् । तथा स्म मोदते दृष्ट्वा यथा माधवमर्जुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20011477,
    "chapter_id": 6683,
    "verse_number": "11.54",
    "content_sanskrit": "वयसा किञ्चिदप्यूनं दृष्ट्वा स्वगृहमागतम् । सौहार्देन गरीयांसं पार्थं प्रत्युत्थितो हरिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20011478,
    "chapter_id": 6683,
    "verse_number": "11.55",
    "content_sanskrit": "किमाचरसि मामेवं पुरातनपुमन्नवम् । इत्युक्तः प्राञ्जलिः पार्थः पतितस्तस्य पादयोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20011479,
    "chapter_id": 6683,
    "verse_number": "11.56",
    "content_sanskrit": "स्वमूर्त्यन्तरमालिङ्ग्य प्रेम्णा नारायणो नरम् । विनीत्याऽसिसिषुं भूमौ नयति स्मासनं निजम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20011480,
    "chapter_id": 6683,
    "verse_number": "11.57",
    "content_sanskrit": "'पार्थस्य पाणिना कृष्णः प्रणामात् क्षितिरेणुमत् । स्विन्नं पुलकितेनाङ्गं मार्ष्टि स्माऽम्भोजबन्धुना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20011481,
    "chapter_id": 6683,
    "verse_number": "11.58",
    "content_sanskrit": "अथ सत्कृत्य गोविन्दो जिष्णोस्सहचरान् द्विजान् । स्माऽऽभाषते स्मितज्योत्स्नास्नपितेन मुखेन्दुना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20011482,
    "chapter_id": 6683,
    "verse_number": "11.59",
    "content_sanskrit": "दृष्ट्वा नम्रं जगन्नाथं हर्षाश्रुभरितेक्षणाः । निबद्धाञ्जलयो मूर्ध्नि स्तुवते स्म तदा द्विजाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20011483,
    "chapter_id": 6683,
    "verse_number": "11.60",
    "content_sanskrit": "नमस्सत्याय सूक्ष्माय दिकालव्यापकाय ते । आनन्दाय प्रकाशाय प्रतीचे परमात्मने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20011484,
    "chapter_id": 6683,
    "verse_number": "11.61",
    "content_sanskrit": "सन्तं त्वां जगदन्वस्ति नन्दन्तमनुनन्दति । अनुभाति तथा भान्तं सूक्ष्मं सूक्ष्मभिदात्यजम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20011485,
    "chapter_id": 6683,
    "verse_number": "11.62",
    "content_sanskrit": "बिभर्षि भुवनानि त्वं कुसुमानि यथा गुणः । सूक्ष्मत्वादरविन्दाक्ष तथापि स्पृश्यसे न तैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20011486,
    "chapter_id": 6683,
    "verse_number": "11.63",
    "content_sanskrit": "न जायसे त्वं नाऽसि त्वं न त्वं परिणमस्यज ! न वर्धसे तथा नाऽपक्षीयसे न विनश्यसि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20011487,
    "chapter_id": 6683,
    "verse_number": "11.64",
    "content_sanskrit": "कृष्ण जात्यादिहीनोऽपि प्रतिभास्यविपश्चितः ! जात्याद्युपाधिमदेहं श्रितो जात्यादिमानिति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20011488,
    "chapter_id": 6683,
    "verse_number": "11.65",
    "content_sanskrit": "सत्त्वयैकोऽप्यनेकस्त्वं 'तत्त्वावस्थाभिरच्युत । हेम हेमतयाऽप्येकमनेकं कटकादिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20011489,
    "chapter_id": 6683,
    "verse_number": "11.66",
    "content_sanskrit": "त्वयीदं जायते सर्वं जगत्तिष्ठति लीयते । अब्धाविवाब्धिपर्यङ्कफेनकल्लोलबुद्बुदम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20011490,
    "chapter_id": 6683,
    "verse_number": "11.67",
    "content_sanskrit": "व्यक्तीस्समानजातीया या या व्यक्तिरतीयते । स स त्वदंशो धर्मस्य गोप्ता क्षेप्ता च पाप्मनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20011491,
    "chapter_id": 6683,
    "verse_number": "11.68",
    "content_sanskrit": "यदा यदैधते पापं लोके पुण्यञ्च सीदति । दैत्याश्च घ्नन्ति भूतानि सुरानप्यतिशेरते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20011492,
    "chapter_id": 6683,
    "verse_number": "11.69",
    "content_sanskrit": "तदा तदा बिभर्षि त्वं किञ्चिन्मायामयं वपुः । विधत्से चासतां ध्वंसं सताञ्च त्राणमच्युत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20011493,
    "chapter_id": 6683,
    "verse_number": "11.70",
    "content_sanskrit": "हरता सर्वभूतानां 'नेत्राणि दुरितानि च । अद्यत्वे वासुदेव त्वं रूपेणाऽनेन दीप्यसे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20011494,
    "chapter_id": 6683,
    "verse_number": "11.71",
    "content_sanskrit": "दीव्यसि त्वं हरे दीव्यन् सुहृद्भिस्सह दीव्यसि । द्विषो दीव्यसि देवित्वाऽजनैर्दीव्यैश्च दीव्यसि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20011495,
    "chapter_id": 6683,
    "verse_number": "11.72",
    "content_sanskrit": "सितमंशुकमाशानां सीव्यसि त्वं गुणैर्यशः । वीर्येण चातिसर्वेण पूर्यसे पुरुषोत्तम ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20011496,
    "chapter_id": 6683,
    "verse_number": "11.73",
    "content_sanskrit": "भ्राशसे कौस्तुभेन त्वं भ्राश्यसे पीतवाससा । मौलिस्रैर्भ्लाशसे बैंर्ह्रभ्लाश्यसे वनमालया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20011497,
    "chapter_id": 6683,
    "verse_number": "11.74",
    "content_sanskrit": "भ्राम्यन्त्यपाङ्गभृङ्गास्ते मुखपद्मेषु सुभ्रुवाम् । कटाक्षमीना भ्राम्यन्ति तासां कान्तिह्रदे च ते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20011498,
    "chapter_id": 6683,
    "verse_number": "11.75",
    "content_sanskrit": "दोर्वल्लीभिर्धनस्तन्यः सिन्वन्ति त्वां प्रिया हरे । दन्ताग्रैरधरांस्तासामश्नुषे त्वं जितामृतान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20011499,
    "chapter_id": 6683,
    "verse_number": "11.76",
    "content_sanskrit": "तुदन्नसुरसङ्घास्त्वं सकलं प्रणुदन् कलिम् । गोदेवभूमिदेवेभ्यश्शौरे दिशसि मङ्गलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20011500,
    "chapter_id": 6683,
    "verse_number": "11.77",
    "content_sanskrit": "तवाऽऽज्ञयैव गोविन्द भृज्जत्यन्नानि पावकः । भूतानि जुषते वायुस्तमः क्षिपति चांशुमान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20011501,
    "chapter_id": 6683,
    "verse_number": "11.78",
    "content_sanskrit": "ध्रियते भूर्जगच्चापस्सिञ्चन्ति सचराचरम् । नभो भिनत्ति द्रव्याणि कार्याणि च तवाज्ञया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20011502,
    "chapter_id": 6683,
    "verse_number": "11.79",
    "content_sanskrit": "प्रयुङ्क्ते मघवा मेघांस्तनोति भुवनस्थितिम् । वन्वानेभ्यश्च यज्वभ्यस्सनोत्यर्थांस्तवाज्ञया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20011503,
    "chapter_id": 6683,
    "verse_number": "11.80",
    "content_sanskrit": "पुष्णाति परमैश्वर्यमिन्द्रशब्दस्य कारणम् । निगृह्णानोऽसुरानिन्द्र उपेन्द्र त्वदनुग्रहात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20011504,
    "chapter_id": 6683,
    "verse_number": "11.81",
    "content_sanskrit": "को वर्णयति कृष्ण त्वां लोकनाथाऽर्यवत्सल । वेदान्तैर्मृगयन्ते यं सन्तोऽपि न पुनविँदुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20011505,
    "chapter_id": 6683,
    "verse_number": "11.82",
    "content_sanskrit": "इति स्तुतवतां तेषां भक्तानां मधुसूदनः । छित्त्वैनांसि तनोति स्म पुण्यानीति किमुच्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20011506,
    "chapter_id": 6683,
    "verse_number": "11.83",
    "content_sanskrit": "अंशुकाभरणालेपकुसुमादिभिरुत्तमैः । प्रणयी पुण्डरीकाक्षः पाण्डुपुत्रीयति स्म तान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20011507,
    "chapter_id": 6683,
    "verse_number": "11.84",
    "content_sanskrit": "गत्वाऽथ मातुलं पार्थो वसुदेवं स्म वन्दते । देवकीं मातुलानीञ्च वृद्धानस्याहुकादिकान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20011508,
    "chapter_id": 6683,
    "verse_number": "11.85",
    "content_sanskrit": "मूर्ध्नि चाघ्रायते तैस्स्म प्रीतिबाष्पार्द्रितोऽर्जुनः । विनयोत्कर्षसन्तुष्टैस्स्माशीर्भिश्शानुगृह्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20011509,
    "chapter_id": 6683,
    "verse_number": "11.86",
    "content_sanskrit": "गदसात्यकिकामादीन् कृतपादाभिवन्दनान् । उक्ताकारप्लुतो मूर्ध्नि जिघ्रति स्म धनञ्जयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20011510,
    "chapter_id": 6683,
    "verse_number": "11.87",
    "content_sanskrit": "स्फुटत्फलायारण्यानी कालकौशेयवाससम् । हिमानीधवलं दृष्ट्वा हलिनं हृष्यति स्म सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20011511,
    "chapter_id": 6683,
    "verse_number": "11.88",
    "content_sanskrit": "इन्द्राणीवरुणानीभ्यां भवान्या च समा मुहुः । अर्याण्यः क्षत्रियाण्यस्तं प्रेक्षन्ते स्म स्फुटादराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20011512,
    "chapter_id": 6683,
    "verse_number": "11.89",
    "content_sanskrit": "करस्यूतकरेणाऽथ सह कृष्णः किरीटिना । शुद्धान्तं विशति स्माऽमुं महिषीभ्यः प्रदर्शयन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20011513,
    "chapter_id": 6683,
    "verse_number": "11.90",
    "content_sanskrit": "अथाऽऽहूयातिहार्देन सच्चिकीर्षुर्धनञ्जयम् । रुक्मिणीसत्यभामाद्या महिषीस्स्माह माधवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20011514,
    "chapter_id": 6683,
    "verse_number": "11.91",
    "content_sanskrit": "सोऽयं पैतृष्वसेयो मे पार्थः प्राणा बहिश्चराः । अदृष्टपूर्वं तं यूयं द्रष्टव्यं द्रष्टुमर्हथ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20011515,
    "chapter_id": 6683,
    "verse_number": "11.92",
    "content_sanskrit": "युष्मान् दिदृक्षते चाऽयं बालांश्चोपजिघृक्षते । मन्दं विधाय मन्दाक्षं युज्यध्वे तमुपाजितुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20011516,
    "chapter_id": 6683,
    "verse_number": "11.93",
    "content_sanskrit": "मुमुखायिषतेऽस्येन्दुर्नेत्रितायिषतेऽम्बुजम् । दन्तायियिषते मुक्ता केशायियिषतेऽप्यलिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20011517,
    "chapter_id": 6683,
    "verse_number": "11.94",
    "content_sanskrit": "मित्सतेऽस्याधरच्छाया पद्मरागमणिश्रियम् । स्कन्धाभिख्या च हर्यक्षस्कन्धशोभं प्रमित्सते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20011518,
    "chapter_id": 6683,
    "verse_number": "11.95",
    "content_sanskrit": "महातमालयुग्माभां धित्सतेऽस्य भुजद्वयम् । रागं युवतिवृन्देभ्यो रोमराजिश्च दित्सते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20011519,
    "chapter_id": 6683,
    "verse_number": "11.96",
    "content_sanskrit": "वक्षो गिरिशिलादेश्यं पद्माऽस्य परिरिप्सते । लिप्सते च मुखाम्भोजे सदाऽऽवासं सरस्वती ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20011520,
    "chapter_id": 6683,
    "verse_number": "11.97",
    "content_sanskrit": "शिक्षतोऽस्य भुजौ जेतुर्जगत्ससुरमानुषम् । आजानुलम्बिनौ रक्तरेखामत्स्यादिमत्तलौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20011521,
    "chapter_id": 6683,
    "verse_number": "11.98",
    "content_sanskrit": "आपिप्समानान् विजयं समित्यां पित्सतो रिपून् । ईत्सन्नीप्सन् परां कीर्तिं झीप्सन्नेव तृणेढ्यसौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20011522,
    "chapter_id": 6683,
    "verse_number": "11.99",
    "content_sanskrit": "यथा तमांसि'धिप्सन्तं मोक्षन्ते वीक्ष्य तीक्ष्णगुम् । दृष्ट्वा तथैनं धीप्सन्तं मुमुक्षन्तेऽरयो रणात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20011523,
    "chapter_id": 6683,
    "verse_number": "11.100",
    "content_sanskrit": "दिदम्भिषन्तं दम्भोलिकरं जम्भमिदं यथा । दृष्ट्वैनं धन्विनं नाडङ्घ्यो द्विषः पिपतिषन्ति के ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20011524,
    "chapter_id": 6683,
    "verse_number": "11.101",
    "content_sanskrit": "दिद्योतिषमाणोऽयं सुष्वापयिषतीषुभिः । शितैर्द्विषन् द्विषत्सेनाः करजैरिव कामिनीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20011525,
    "chapter_id": 6683,
    "verse_number": "11.102",
    "content_sanskrit": "पिपृन्मनोरथान् सर्वान् प्रजास्सर्वा पिपर्ति यत् । पितॄंस्तेनैष नेनिक्ते ग्लौबुधैलपुरस्सरान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20011526,
    "chapter_id": 6683,
    "verse_number": "11.103",
    "content_sanskrit": "इति प्रत्यक्षया स्तुत्या जिष्णुः कृष्णस्य जिह्रियत् । मुखानि पश्यन् देवीनामिदमाह स्म सस्मितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20011527,
    "chapter_id": 6683,
    "verse_number": "11.104",
    "content_sanskrit": "यन्नोनवीति मामेष ध्रुवं तां जाहसीति माम् । जाहस्यते नचेद्गीर्न गुणैर्नोनूयते कथम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 104,
    "avatarnika": ""
  },
  {
    "id": 20011528,
    "chapter_id": 6683,
    "verse_number": "11.105",
    "content_sanskrit": "यथैप मां तथा नौमि हसन्नारोपितैर्गुणैः । निर्गुणं तत्वतो हास्यं विद्वद्भिरहमप्यमुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 105,
    "avatarnika": ""
  },
  {
    "id": 20011529,
    "chapter_id": 6683,
    "verse_number": "11.106",
    "content_sanskrit": "विभावयति मिथ्यैव प्रविभावयिषन् प्रजाः । अवत्यविविपंश्चायमश्नात्यशिशिषन्नपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 106,
    "avatarnika": ""
  },
  {
    "id": 20011530,
    "chapter_id": 6683,
    "verse_number": "11.107",
    "content_sanskrit": "यत्स्त्वं यियविषन्यौति रूपादिभिरसौ गुणैः । कर्ममिश्रारिघाताद्यैर्मायैवामुष्य साऽतुला ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 107,
    "avatarnika": ""
  },
  {
    "id": 20011531,
    "chapter_id": 6683,
    "verse_number": "11.108",
    "content_sanskrit": "सुस्रावयिषति प्राणानसुराणामयं यदा । तदा तान् पाञ्चजन्यस्य शिश्रावयिषति ध्वनिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 108,
    "avatarnika": ""
  },
  {
    "id": 20011532,
    "chapter_id": 6683,
    "verse_number": "11.109",
    "content_sanskrit": "यदैष शार्ङ्ग्ज्याशब्दं शुश्रावयिषति द्विषः । तदाऽमुं वैनतेयस्तान् पुप्रावयिषति द्रुतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 109,
    "avatarnika": ""
  },
  {
    "id": 20011533,
    "chapter_id": 6683,
    "verse_number": "11.110",
    "content_sanskrit": "विलोलूयिषमाणोऽसावसुरान्न्दकासिना । तार्क्ष्येण क्षिप्तपक्षेण पनीपतिषते युधि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 110,
    "avatarnika": ""
  },
  {
    "id": 20011534,
    "chapter_id": 6683,
    "verse_number": "11.111",
    "content_sanskrit": "देध्मीयते महाशङ्खं तथा जेघ्नीयते सुरान् । जेघ्रीयते च तच्छ्रीणां मुखाब्जान्येष भृङ्गवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 111,
    "avatarnika": ""
  },
  {
    "id": 20011535,
    "chapter_id": 6683,
    "verse_number": "11.112",
    "content_sanskrit": "यंयम्यमानो दुर्वृत्तानेष रंरम्यते विभुः । पाल्यमानस्सदाऽनेन रंरमीति च सज्जनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 112,
    "avatarnika": ""
  },
  {
    "id": 20011536,
    "chapter_id": 6683,
    "verse_number": "11.113",
    "content_sanskrit": "बम्भज्यते स्म पादाभ्यां डिम्भोऽसौ शकटासुरम् । पेपीयते स्म च स्तन्यं पूतनायास्सहासुभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 113,
    "avatarnika": ""
  },
  {
    "id": 20011537,
    "chapter_id": 6683,
    "verse_number": "11.114",
    "content_sanskrit": "पुण्यानि पंफुल्यन्ते स्म गोपा लोकस्य तद्ध्रुवम् । गोपवेषधरो गोष्ठे यदेषोऽरार्यते पुरा ॥",
    "padaccheda": "",
