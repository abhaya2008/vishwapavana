  {
    "id": 20011542,
    "chapter_id": 6683,
    "verse_number": "11.119",
    "content_sanskrit": "शुशावयिषति स्माऽसौ खपार्श्वं वंशनिस्वनैः । शेश्रीयमानं गोवृन्दं वृन्दावनतृणै'स्ततम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
