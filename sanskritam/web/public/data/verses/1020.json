[{"id": 2001376, "chapter_id": 1020, "verse_number": "१-२१-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001377, "chapter_id": 1020, "verse_number": "१-२१-१", "content_sanskrit": "ततो रजन्यां व्युष्टायां प्रभातेऽभ्युदिते रवौ।\nकद्रूश्च विनता चैव भगिन्यौ ते तपोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001378, "chapter_id": 1020, "verse_number": "१-२१-२", "content_sanskrit": "अमर्षिते सुसंरब्धे दास्ये कृतपणे तदा।\nस्मगरस्य परं पारं वेलावनविभूषितम्।\nजग्मतुस्तुरगं द्रष्टुमुच्चैःश्रवसमन्तिकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001379, "chapter_id": 1020, "verse_number": "१-२१-३", "content_sanskrit": "ददृशातेऽथ ते तत्र समुद्रं निधिमम्भसाम्।\nमहान्तमुदकागाधं क्षोभ्यमाणं महास्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001380, "chapter_id": 1020, "verse_number": "१-२१-४", "content_sanskrit": "तिमिंगिलझषाकीर्णं मकरैरावृतं तथा।\nसत्वैश्च बहुसाहस्रैर्नानारूपैः समावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001381, "chapter_id": 1020, "verse_number": "१-२१-५", "content_sanskrit": "भीषणैर्विकृतैरन्यैर्घोरैर्जलचरैस्तथा।\nउग्रैर्नित्यमनाधृष्यं कूर्मग्राहसमाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001382, "chapter_id": 1020, "verse_number": "१-२१-६", "content_sanskrit": "आकरं सर्वरत्नानामालयं वरुणस्य च।\nनागानामालयं रम्यमुत्तमं सरितां पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001383, "chapter_id": 1020, "verse_number": "१-२१-७", "content_sanskrit": "पातालज्वलनावासमसुराणां च बान्धवम्।\nभयंकरं च सत्त्वानां पयसां निधिमर्णवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001384, "chapter_id": 1020, "verse_number": "१-२१-८", "content_sanskrit": "शुभं दिव्यममर्त्यानाममृतस्याकरं परम्।\nअप्रमेयमचिन्त्यं च सुपुण्यजलमद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001385, "chapter_id": 1020, "verse_number": "१-२१-९", "content_sanskrit": "घोरं जलचरारावरौद्रं भैरवनिःस्वनम्।\nगम्भीरावर्तकलिलं सर्वभूतभयंकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001386, "chapter_id": 1020, "verse_number": "१-२१-१०", "content_sanskrit": "वेलादोलानिलचलं क्षोभोद्वेगसमुच्छ्रितम्।\nवीचीहस्तैः प्रचलितैर्नृत्यन्तमिव सर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001387, "chapter_id": 1020, "verse_number": "१-२१-११", "content_sanskrit": "चन्द्रवृद्धिक्षयवशादुद्वृत्तोर्मिसमाकुलम्।\nपाञ्चजन्यस्य जननं रत्नाकरमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001388, "chapter_id": 1020, "verse_number": "१-२१-१२", "content_sanskrit": "गां विन्दता भगवता गोविन्देनामितौजसा।\nवराहरूपिणा चान्तर्विक्षोभितजलाविलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001389, "chapter_id": 1020, "verse_number": "१-२१-१३", "content_sanskrit": "ब्रह्मर्षिणा व्रतवता वर्षाणां शतमत्रिणा।\nअनासादितगाधं च पातालतलमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001390, "chapter_id": 1020, "verse_number": "१-२१-१४", "content_sanskrit": "अध्यात्मयोगनिद्रां च पद्मनाभस्य सेवतः।\nयुगादिकालशयनं विष्णोरमिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001391, "chapter_id": 1020, "verse_number": "१-२१-१५", "content_sanskrit": "वज्रपातनसंत्रस्तमैनाकस्याभयप्रदम्।\nडिम्बाहवार्दितानां च असुराणां परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001392, "chapter_id": 1020, "verse_number": "१-२१-१६", "content_sanskrit": "बडवामुखदीप्ताग्नेस्तोयहव्यप्रदं शिवम्।\nअगाधपारं विस्तीर्णमप्रमेयं सरित्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001393, "chapter_id": 1020, "verse_number": "१-२१-१७", "content_sanskrit": "महानदीभिर्बह्वीभिः स्पर्धयेव सहस्रशः।\nअभिसार्यमाणमनिशं ददृशाते महार्णवम्।\nआपूर्यमाणमत्यर्थं नृत्यमानमिवोर्मिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001394, "chapter_id": 1020, "verse_number": "१-२१-१८", "content_sanskrit": "गम्भीरं तिमिमकरोग्रसंकुलं तं\nगर्जन्तं जलचररावरौद्रनादैः।\nविस्तीर्णं ददृशतुरम्बरप्रकाशं\nतेऽगाधं निधिमुरुमम्भसामनन्तम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001395, "chapter_id": 1020, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि एकविंशतितमोऽध्यायः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]