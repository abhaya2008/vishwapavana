[{"id": 2070515, "chapter_id": 2481, "verse_number": "११-१३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070516, "chapter_id": 2481, "verse_number": "११-१३-१", "content_sanskrit": "धृतराष्ट्राभ्यनुज्ञातास्ततस्ते कुरुपुङ्गवाः।\nअभ्ययुर्भ्रातरः सर्वे गान्धारीं सहकेशवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070517, "chapter_id": 2481, "verse_number": "११-१३-२", "content_sanskrit": "ततो ज्ञात्वा हतामित्रं धर्मराजं युधिष्ठिरम्।\nगान्धारी पुत्रशोकार्ता शप्तुमैच्छदनिन्दिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070518, "chapter_id": 2481, "verse_number": "११-१३-३", "content_sanskrit": "तस्याः पापमभिप्रायं विदित्वा पाण्डवान्प्रति।\nऋषिर्गन्धवतीपुत्रः प्रागेव समबुध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070519, "chapter_id": 2481, "verse_number": "११-१३-४", "content_sanskrit": "स गङ्गायामुपस्पृश्य ब्रह्मर्षिः प्रयतः शुचिः।\nतं देशमुपसंपेदे पाराशर्यो मनोजवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070520, "chapter_id": 2481, "verse_number": "११-१३-५", "content_sanskrit": "दिव्येन चक्षुषा ज्ञात्वा मनसाऽनुद्धतेन च।\nसर्वप्राणभृतां भावं सततं स तु बृध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070521, "chapter_id": 2481, "verse_number": "११-१३-६", "content_sanskrit": "स स्नुषामब्रवीत्काले कल्याणानि महातपाः।\nशापकालमवाक्षिप्य शमकालमुदीरयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070522, "chapter_id": 2481, "verse_number": "११-१३-७", "content_sanskrit": "न कोपः पाण्डवे कार्यो गान्धारि शममाप्नुहि।\nरजो निगृह्यतां चैव शृणु चेदं वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070523, "chapter_id": 2481, "verse_number": "११-१३-८", "content_sanskrit": "पुरोक्ता युद्धकाले त्वं पुत्रेण जयमिच्छता।\nजयमाशास्व मे मातर्युध्यमानस्य शत्रुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070524, "chapter_id": 2481, "verse_number": "११-१३-९", "content_sanskrit": "सा तथा याच्यमाना त्वं युद्धकाले जयैषिणा।\nउक्तवत्यसि कल्याणि यतो धर्मस्ततो जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070525, "chapter_id": 2481, "verse_number": "११-१३-१०", "content_sanskrit": "वाचाऽप्यतीते मा क्रोधे मनः कुरु यशस्विनि।\nस्मरामि भाषमाणां हि त्वामहं सत्यवादिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070526, "chapter_id": 2481, "verse_number": "११-१३-११", "content_sanskrit": "विग्रहे तुमुले राज्ञां गत्वा परमसंशयम्।\nजितं पाण्डुसुतैर्युद्धे नूनं धर्मस्ततोऽधिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070527, "chapter_id": 2481, "verse_number": "११-१३-१२", "content_sanskrit": "क्षमाशीला पुरा भूत्वा साऽद्य न क्षमसे कथम्।\nअधर्मे जहि धर्मज्ञे यतो धर्मस्ततो जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070528, "chapter_id": 2481, "verse_number": "११-१३-१३", "content_sanskrit": "सा त्वं धर्मं परिस्मृत्य वाचं चोक्तां मनस्विनी।\nकोपं संयच्छ गान्धारि पाण्डवेषु सुतेषु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070529, "chapter_id": 2481, "verse_number": "११-१३-१४x", "content_sanskrit": "गान्धार्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070530, "chapter_id": 2481, "verse_number": "११-१३-१४", "content_sanskrit": "भगवन्नाभ्यसूयामि नैतानिच्छामि नश्यतः।\nपुत्रशोकेन तु बलान्मनो विह्वलतीव मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070531, "chapter_id": 2481, "verse_number": "११-१३-१५", "content_sanskrit": "यथैव कुन्त्या कौन्तेया रक्षितव्यास्तथा मया।\nतथैव धृतराष्ट्रेण रक्षितव्या यथा त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070532, "chapter_id": 2481, "verse_number": "११-१३-१६", "content_sanskrit": "दुःशासनापराधेन शकुनेः सौबलस्य च।\nकर्णदुर्योधनाभ्यां च कृतोऽयं कृरुसंक्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070533, "chapter_id": 2481, "verse_number": "११-१३-१७", "content_sanskrit": "नापराध्यति बीभत्सुर्न च पार्थो वृकोदरः।\nनकुलः सदेवश्च नैव राजा युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070534, "chapter_id": 2481, "verse_number": "११-१३-१८", "content_sanskrit": "युध्यमाना हि कौरव्याः कृतमामाः परस्परम्।\nनिहताः सहिताश्चान्यैस्तत्र नास्त्यप्रियं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070535, "chapter_id": 2481, "verse_number": "११-१३-१९", "content_sanskrit": "किं तु कर्माकरोद्भीमो वासुदेवस्य पश्यतः।\nदुर्योधनं समाहूय गदायुर्द्ध महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070536, "chapter_id": 2481, "verse_number": "११-१३-२०", "content_sanskrit": "शिक्षयाऽभ्यधिकं ज्ञात्वा चरन्तं बहुधा रणे।\nअधो नाभ्याः प्रहृतवांस्तन्मे कोपमवर्धयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070537, "chapter_id": 2481, "verse_number": "११-१३-२१", "content_sanskrit": "कथं नु धर्मं धर्मज्ञाः समुद्दिष्टं महात्मभिः।\nत्यजेयुराहवे शूराः प्राणहेतोः कथञ्चनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070538, "chapter_id": 2481, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि जलप्रदानिकपर्वणि त्रयोदशोऽध्यायः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]