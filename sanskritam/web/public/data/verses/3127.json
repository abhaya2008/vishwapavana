[{"id": 2099478, "chapter_id": 3127, "verse_number": "१३-२५७-१", "content_sanskrit": "युधिष्ठिर उवाच।\nकां तु ब्राह्मणपूजायां व्युष्टिं दृष्ट्वा जनाधिप।\nकं वा धर्मोदयं मत्वा तानर्चसि महामते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099479, "chapter_id": 3127, "verse_number": "१३-२५७-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099480, "chapter_id": 3127, "verse_number": "१३-२५७-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nपवनस्य च संवादमर्जुनस्य च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099481, "chapter_id": 3127, "verse_number": "१३-२५७-३", "content_sanskrit": "सहस्रभुजभृच्छ्रीमान्कार्तवीर्योऽभवत्प्रभुः।\nअस्य लोकस्य सर्वस्य माहिष्मत्यां महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099482, "chapter_id": 3127, "verse_number": "१३-२५७-४", "content_sanskrit": "स तु रत्नाकरवतीं सप्तद्वीपां ससागराम्।\nशशास पृथिवीं सर्वां हैहयः सत्यविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099483, "chapter_id": 3127, "verse_number": "१३-२५७-५", "content_sanskrit": "स्ववित्तं तेन दत्तं तु दत्तात्रेयाय कर्मणे।\nक्षत्रधर्मं पुरस्कृत्य विनयं श्रुतमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099484, "chapter_id": 3127, "verse_number": "१३-२५७-६", "content_sanskrit": "आराधयामास च तं कृतवीर्यात्मजो मुनिम्।\nन्यमन्त्रयत संतुष्टो द्विजश्चैनं वरैस्त्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099485, "chapter_id": 3127, "verse_number": "१३-२५७-७", "content_sanskrit": "स वरैश्छन्दितस्तेन नृपो वचनमब्रवीत्।\nसहस्रबाहुता मेऽस्तु यूपमध्ये ग्रहो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099486, "chapter_id": 3127, "verse_number": "१३-२५७-८", "content_sanskrit": "मम बाहुसहस्रं तु पश्यन्तां सैनिका रणे।\nविक्रमेणि महीं कृत्स्नां जयेयं संशितव्रत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099487, "chapter_id": 3127, "verse_number": "१३-२५७-९", "content_sanskrit": "तां च धर्मेण सम्प्राप्य पालयेयमतन्द्रितः।\nचतुर्थं तु वरं याचे त्वामहं द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099488, "chapter_id": 3127, "verse_number": "१३-२५७-१०", "content_sanskrit": "तं ममानुग्रहकृते दातुमर्हस्यनिन्दित।\nअनुशाशन्तु मां सन्तो मिथ्यावृत्तं त्वदाश्रयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099489, "chapter_id": 3127, "verse_number": "१३-२५७-११", "content_sanskrit": "इत्युक्तः स द्विजः प्राह तथास्त्विति नराधिपम्।\nएवं समभवंस्तस्य वरास्ते दीप्ततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099490, "chapter_id": 3127, "verse_number": "१३-२५७-१२", "content_sanskrit": "गतः स रथमास्थाय ज्वलनार्कसमद्युतिम्।\nअब्रवीद्वीर्यसंमोहात्को वाऽस्ति सदृशो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099491, "chapter_id": 3127, "verse_number": "१३-२५७-१३", "content_sanskrit": "धैर्यैर्वीर्यैर्यशःशौर्यौर्विक्रमेणौजसाऽपि वा।\nतद्वाक्यान्ते चान्तरिक्षे वागुवाचाशरीरिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099492, "chapter_id": 3127, "verse_number": "१३-२५७-१४", "content_sanskrit": "न त्वं मूढ विजानीषे ब्राह्मणं क्षत्रियाद्वरम्।\nसहितो ब्राह्मणेनेह क्षत्रियः शास्ति वै प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099493, "chapter_id": 3127, "verse_number": "१३-२५७-१५x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099494, "chapter_id": 3127, "verse_number": "१३-२५७-१५", "content_sanskrit": "कुर्यां भूतानि तुष्टोऽहं क्रुद्धो नाशं तथा नये।\nकर्म्णा मनसा वाचा न मत्तोस्ति वरो द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099495, "chapter_id": 3127, "verse_number": "१३-२५७-१६", "content_sanskrit": "पूर्वो ब्रह्मोत्तरो वादो द्वितीयः क्षत्रियोत्तरः।\nत्वयोक्तौ हेतुयुक्तौ तौ विशेषस्तत्र दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099496, "chapter_id": 3127, "verse_number": "१३-२५७-१७", "content_sanskrit": "ब्राह्मणाः संश्रिताः क्षत्रं न क्षत्रं ब्राह्मणाश्रितम्।\nश्रिता ब्रह्मोपधा विप्राः खादन्ति क्षत्रियान्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099497, "chapter_id": 3127, "verse_number": "१३-२५७-१८", "content_sanskrit": "क्षत्रियेष्वाश्रितो धर्मः प्रजानां परिपालनम्।\nक्षत्राद्वृत्तिर्ब्राह्मणानां तैः कथं ब्राह्मणो वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2099498, "chapter_id": 3127, "verse_number": "१३-२५७-१९", "content_sanskrit": "सर्वभूतप्रधानांस्तान्भैक्षवृत्तीनहं सदा।\nआत्मसम्भावितान्विप्रान्स्थापयाम्यात्मनो वशे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2099499, "chapter_id": 3127, "verse_number": "१३-२५७-२०", "content_sanskrit": "कथितं त्वनयाऽसत्यं गायन्त्या कन्यया दिवि।\nविजेष्याम्यवशान्सर्वान्ब्राह्मणांश्चर्मवाससः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2099500, "chapter_id": 3127, "verse_number": "१३-२५७-२१", "content_sanskrit": "न च मां च्यावयेद्राष्ट्रात्त्रिषु लोकेषु कश्चन।\nदेवो वा मानुषो वाऽपि तस्माज्ज्येष्ये द्विजानहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2099501, "chapter_id": 3127, "verse_number": "१३-२५७-२२", "content_sanskrit": "अद्य ब्रह्मोत्तरं लोकं करिष्ये क्षत्रियोत्तरम्।\nनहि मे संयुगे कश्चित्सोढुमुत्सहते बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2099502, "chapter_id": 3127, "verse_number": "१३-२५७-२३", "content_sanskrit": "अर्जुनस्य वचः श्रुत्वा वित्रस्ताऽभून्निशाचरी।\nअथैनमन्तरिक्षस्थस्ततो वायुरभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2099503, "chapter_id": 3127, "verse_number": "१३-२५७-२४", "content_sanskrit": "त्यजैनं कलुषं भावं ब्राह्मणेभ्यो नमस्कुरु।\nएतेषां कुर्वतः पापं राष्ट्रक्षोभो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2099504, "chapter_id": 3127, "verse_number": "१३-२५७-२५", "content_sanskrit": "अथ च त्वां महीपाल शमयिष्यन्ति वै द्विजाः।\nनिरसिष्यन्ति ते राष्ट्राद्धतोत्साहा महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2099505, "chapter_id": 3127, "verse_number": "१३-२५७-२६", "content_sanskrit": "तं राजा कस्त्वमित्याह ततस्तं प्राह मारुतः।\nवायुर्वै देवदूतोस्मि हितं त्वां प्रब्रवीम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2099506, "chapter_id": 3127, "verse_number": "१३-२५७-२७x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2099507, "chapter_id": 3127, "verse_number": "१३-२५७-२७", "content_sanskrit": "अहो त्वयाऽयं विप्रेषु भक्तिरागः प्रदर्शितः।\nयादृशं पृथिवीभूतं तादृशं ब्रूहि मे द्विजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2099508, "chapter_id": 3127, "verse_number": "१३-२५७-२८", "content_sanskrit": "वायोर्वा सदृशं किञ्चिद्ब्रूहि त्वं ब्राह्मणोत्तमम्।\nअपां वै सदृशं वह्नेः सूर्यस्य नभसोऽपि वा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2099509, "chapter_id": 3127, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तपञ्चाशदधिकद्विशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]