[{"id": 2143614, "chapter_id": 4098, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2143615, "chapter_id": 4098, "verse_number": "१", "content_sanskrit": "उत सन्तमसन्तं वा जडं वीरं च सञ्जय ।\nउताबलं बलीयांसं धाता प्रकुरुते वशे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2143616, "chapter_id": 4098, "verse_number": "२", "content_sanskrit": "उत बालाय पाण्डित्यं पण्डितायोत बालताम् ।\nददाति सर्वमीशानः पुरस्ताच्छुक्रमुच्चरन्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2143617, "chapter_id": 4098, "verse_number": "३", "content_sanskrit": "अलं विज्ञापनायाद्य आचक्षीथा यथातथम् ।\nअथोपमन्त्रयेथास्त्वम् अन्योन्येनातिहृष्टवत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2143618, "chapter_id": 4098, "verse_number": "४", "content_sanskrit": "गावल्गणे कुरून् गत्वा धृतराष्ट्रं महाबलम् ।\nअभिवाद्योपसङ्गृह्य ततः पृच्छेरनामयम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2143619, "chapter_id": 4098, "verse_number": "५", "content_sanskrit": "ब्रूयाश्चैनं समासीनं कुरुभिः परिवारितम् ।\nतवैव राजन् वीर्येण सुखं जीवन्ति पाण्डवाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2143620, "chapter_id": 4098, "verse_number": "६", "content_sanskrit": "तव प्रसादाद् बालास्ते प्राप्ता राज्यमरिन्दम ।\nराज्ये तान् स्थापयित्वाऽग्रे नोपेक्षेथा विनश्यतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2143621, "chapter_id": 4098, "verse_number": "७", "content_sanskrit": "सर्वं राज्यं तदेकस्य नालं भर्तुं हि कस्यचित् ।\nतस्मात् सङ्गत्य जीवामो द्विषतां मा वशं गमः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2143622, "chapter_id": 4098, "verse_number": "८", "content_sanskrit": "तथा भीष्मं शान्तनवं भारतानाममद्यपम् ।\nशिरसा चाभिवन्देथा मम नाम प्रकीर्तयन्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2143623, "chapter_id": 4098, "verse_number": "९", "content_sanskrit": "अभिवाद्य च वक्तव्यः ततोऽस्माकं पितामहः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2143624, "chapter_id": 4098, "verse_number": "१०", "content_sanskrit": "भवता शन्तनोर्वंशो निमग्नः पुनरुद्धृतः ।\nस त्वं कुरु तथा तात स्वमतेन पितामह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2143625, "chapter_id": 4098, "verse_number": "११", "content_sanskrit": "यथा जीवन्ति ते पौत्राः प्रीतियुक्ताः परस्परम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2143626, "chapter_id": 4098, "verse_number": "१२", "content_sanskrit": "तथैव विदुरं ब्रूयाः कुरूणां मन्त्रधारिणम् ।\nअयुद्धं सौम्य भाषेथाः शमकामो युधिष्ठिरः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2143627, "chapter_id": 4098, "verse_number": "१३", "content_sanskrit": "अथ दुर्योधनं ब्रूया राजपुत्रममर्षणम् ।\nमध्ये कुरूणामासीनम् अनुनीय पुनः पुनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2143628, "chapter_id": 4098, "verse_number": "१४", "content_sanskrit": "अपापां यदुपैक्षन्त कृष्णामेतां सभागताम् ।\nतद् दुःखं च तितिक्षाम मा वधीस्त्वं कुरूनिति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2143629, "chapter_id": 4098, "verse_number": "१५", "content_sanskrit": "एवं पूर्वापरान् क्लेशान् अतितिक्षन्त पाण्डवाः ।\nयथाऽबलीयसः सन्तो यत् तत् सर्वं कुरवो विदुः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2143630, "chapter_id": 4098, "verse_number": "१६", "content_sanskrit": "यन्नः प्राव्राजयः सौम्यान् अजिनैः प्रतिवासितान् ।\nतद् दुःखमतितिक्षाम मा वधीष्म कुरूनिति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2143631, "chapter_id": 4098, "verse_number": "१७", "content_sanskrit": "यत् कुन्तीं समतिक्रम्य कृष्णां केशेष्वधर्षयत् ।\nदुःशासनस्तेऽनुमते तच्चास्माभिरुपेक्षितम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2143632, "chapter_id": 4098, "verse_number": "१८", "content_sanskrit": "यथोचितं स्वकं भागं लभेमहि परन्तप ।\nनिवर्तय परद्रव्ये बुद्धिं गृद्धां नरर्षभ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2143633, "chapter_id": 4098, "verse_number": "१९", "content_sanskrit": "शान्तिरेव भवेद् राजन् प्रीतिरेव परस्परम् ।\nराज्यैकदेशमपि नः प्रयच्छ शममिच्छताम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2143634, "chapter_id": 4098, "verse_number": "२०", "content_sanskrit": "कुशस्थलं वृकस्थलम् अवन्तीं वारणावतम् ।\nअवसानं भवेदत्र किञ्चिदेकं च पञ्चमम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2143635, "chapter_id": 4098, "verse_number": "२१", "content_sanskrit": "भ्रातॄणां देहि पञ्चानां पञ्च ग्रामान् सुयोधन ।\nशान्तिर्नोऽस्तु महाप्राज्ञ भ्रातृभिः सह भारत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2143636, "chapter_id": 4098, "verse_number": "२२", "content_sanskrit": "भ्राता भ्रातरमन्वेतु पिता पुत्रेण युज्यताम् ।\nस्मयमानाः समायान्तु पाञ्चालाः कुरुभिः सह\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2143637, "chapter_id": 4098, "verse_number": "२३", "content_sanskrit": "हर्षितान् कुरुपाञ्चालान् पश्येयमिति कामये ।\nसर्वे सुमनसस्तात शाम्याम भरतर्षभाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2143638, "chapter_id": 4098, "verse_number": "२४", "content_sanskrit": "अलमेव शमं यामि तथा युद्धाय सञ्जय ।\nधर्मान्वयो बलं चाहं मृदवे दारुणाय च\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2143639, "chapter_id": 4098, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि त्रिंशोऽध्यायः ॥३०॥ सञ्जययानपर्वणि एकादशोऽध्यायः ॥११॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]