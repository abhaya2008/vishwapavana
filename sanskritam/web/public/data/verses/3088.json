[{"id": 2097500, "chapter_id": 3088, "verse_number": "१३-२१८-१", "content_sanskrit": "उमोवाच।\nभगवन्देवदेवेश त्र्यक्ष भो वृषभध्वज।\nमानुषास्त्रिविधा देव दृश्यन्ते सततं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2097501, "chapter_id": 3088, "verse_number": "१३-२१८-२", "content_sanskrit": "आसीना एव भुञ्जन्ते स्थानैश्वर्यपरिग्रहैः।\nअपरे यत्नपूर्वं तु लभन्ते भोगसङ्ग्रहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2097502, "chapter_id": 3088, "verse_number": "१३-२१८-३", "content_sanskrit": "अपरे यतमानाश्च न लभन्ते तु किञ्चन।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2097503, "chapter_id": 3088, "verse_number": "१३-२१८-४x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2097504, "chapter_id": 3088, "verse_number": "१३-२१८-४", "content_sanskrit": "न्यायतस्त्वं महाभागे श्रोतुकामाऽसि भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2097505, "chapter_id": 3088, "verse_number": "१३-२१८-५", "content_sanskrit": "ये लोके मानुषा देवि दानधर्मपरायणाः।\nपात्राणि विधिवज्ज्ञात्वा दूरतोप्यनुमानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2097506, "chapter_id": 3088, "verse_number": "१३-२१८-६", "content_sanskrit": "अभिगम्य स्वयं तत्र ग्राहयन्ति प्रसाद्य च।\nदानादि चेङ्गितैरेव तैरविज्ञातमेव वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2097507, "chapter_id": 3088, "verse_number": "१३-२१८-७", "content_sanskrit": "पुनर्जन्मनि ते देवि तादृशाः शोभना नराः।\nअयत्नतस्तु तान्येव फलानि प्राप्नुवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2097508, "chapter_id": 3088, "verse_number": "१३-२१८-८", "content_sanskrit": "आसीना एव भुञ्जन्ते भोगान्सुकृतभोगिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2097509, "chapter_id": 3088, "verse_number": "१३-२१८-९", "content_sanskrit": "अपरे ये च दानानि ददत्येव प्रयाचिताः।\nयदायदाऽर्थिने दत्त्वा पुनर्दानं च याचिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2097510, "chapter_id": 3088, "verse_number": "१३-२१८-१०", "content_sanskrit": "तावत्कालं ततो देवि पुनर्जन्मनि ते नराः।\nयत्नतः श्रमसंयुक्ताः पुनस्तान्प्राप्नुवन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2097511, "chapter_id": 3088, "verse_number": "१३-२१८-११", "content_sanskrit": "याचिता अपि केचित्तु अदत्त्वैव कथञ्चन।\nअभ्यसूयापरा मर्त्या लोभोपहतचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2097512, "chapter_id": 3088, "verse_number": "१३-२१८-१२", "content_sanskrit": "ते पुनर्जन्मनि शुभे यतन्तो बहुधा नराः।\nन प्राप्नुवन्ति मनुजा मार्गन्तस्तेऽपि किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2097513, "chapter_id": 3088, "verse_number": "१३-२१८-१३", "content_sanskrit": "नानुप्तं रोहते सस्यं तद्वद्दानफलं विदुः।\nयद्यद्ददाति पुरुषस्तत्तत्प्राप्नोति केवलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2097514, "chapter_id": 3088, "verse_number": "१३-२१८-१४", "content_sanskrit": "इति ते कथितं देवि भूयः श्रोतुं किमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2097515, "chapter_id": 3088, "verse_number": "१३-२१८-१५x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2097516, "chapter_id": 3088, "verse_number": "१३-२१८-१५", "content_sanskrit": "भगवन्भगनेत्रघ्न केचिद्वार्धकसंयुताः।\nअभोगयोग्यकाले तु भोगांश्चैव धनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2097517, "chapter_id": 3088, "verse_number": "१३-२१८-१६", "content_sanskrit": "लभन्ते स्थविरा भूता भोगैश्वर्यं यतस्ततः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2097518, "chapter_id": 3088, "verse_number": "१३-२१८-१७x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2097519, "chapter_id": 3088, "verse_number": "१३-२१८-१७", "content_sanskrit": "हन्त ते कथयिष्यामि शृणु तत्वं समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2097520, "chapter_id": 3088, "verse_number": "१३-२१८-१८", "content_sanskrit": "धर्मकार्यं चिरं कालं विस्मृत्य धनसंयुताः।\nप्राणान्तकाले सम्प्राप्ते व्याधिभिश्च निपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2097521, "chapter_id": 3088, "verse_number": "१३-२१८-१९", "content_sanskrit": "आरभन्ते पुनर्धर्मं दातुं दानानि वा नराः।\nते पुनर्जन्मनि शुभे भूत्वा दुःखपरिप्लुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2097522, "chapter_id": 3088, "verse_number": "१३-२१८-२०", "content_sanskrit": "अतीतयौवने काले स्थविरत्वमुपागताः।\nलभन्ते पूर्वदत्तानां फलानि शुभलक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2097523, "chapter_id": 3088, "verse_number": "१३-२१८-२१", "content_sanskrit": "एतत्कर्मफलं देवि कालयोगाद्भवत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2097524, "chapter_id": 3088, "verse_number": "१३-२१८-२२x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2097525, "chapter_id": 3088, "verse_number": "१३-२१८-२२", "content_sanskrit": "भोगयुक्ता महादेव केचिद्व्याधिपरिप्लुताः।\nअसमर्थाश्च तान्भोक्तं भवन्ति किमु कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2097526, "chapter_id": 3088, "verse_number": "१३-२१८-२३x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2097527, "chapter_id": 3088, "verse_number": "१३-२१८-२३", "content_sanskrit": "व्याधियोगपरिक्लिष्टा ये निराशाः स्वजविते।\nआरभन्ते तदा कर्तुं दानानि शुभलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2097528, "chapter_id": 3088, "verse_number": "१३-२१८-२४", "content_sanskrit": "ते पुनर्जन्मनि शुभे प्राप्य तानि फलान्युत।\nअसमर्थाश्च तान्भोक्तुं व्याधितास्ते भवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2097529, "chapter_id": 3088, "verse_number": "१३-२१८-२५x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2097530, "chapter_id": 3088, "verse_number": "१३-२१८-२५", "content_sanskrit": "भगवन्देवदेवेश मानुषेष्वेव केचन।\nरूपयुक्ताः प्रदृश्यन्ते शुभाङ्गा प्रियदर्शनाः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2097531, "chapter_id": 3088, "verse_number": "१३-२१८-२६x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2097532, "chapter_id": 3088, "verse_number": "१३-२१८-२६", "content_sanskrit": "हन्त ते कथयिष्यामि शृणु तत्वं समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2097533, "chapter_id": 3088, "verse_number": "१३-२१८-२७", "content_sanskrit": "ये पुरा मनुजा देवि लज्जायुक्ताः प्रियंवदाः।\nशक्ताः सुमधुरा नित्यं भूत्वा चैव स्वभावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2097534, "chapter_id": 3088, "verse_number": "१३-२१८-२८", "content_sanskrit": "अमांसभोजिनश्चैव सदा प्राणिदयायुताः।\nप्रतिकर्मप्रदा वाऽपि वस्त्रदा धर्मकारणात्।\nभूमिशुद्धिकरा वाऽपि कारणादग्निपूजकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2097535, "chapter_id": 3088, "verse_number": "१३-२१८-२९", "content_sanskrit": "एवं युक्तसमाचाराः पुनर्जन्मनि ते नराः।\nरूपेण स्पृहणीयास्तु भवन्त्येव न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2097536, "chapter_id": 3088, "verse_number": "१३-२१८-३०x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2097537, "chapter_id": 3088, "verse_number": "१३-२१८-३०", "content_sanskrit": "विरूपाश्च प्रदृश्यन्ते मानुषेष्वेव केचन।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2097538, "chapter_id": 3088, "verse_number": "१३-२१८-३१x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2097539, "chapter_id": 3088, "verse_number": "१३-२१८-३१", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु कल्याणि कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2097540, "chapter_id": 3088, "verse_number": "१३-२१८-३२", "content_sanskrit": "रूपयोगात्पुरा मर्त्या दर्पाहंकारसंयुताः।\nविरूपहासकास्चैव स्तुतिनिन्दादिभिर्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2097541, "chapter_id": 3088, "verse_number": "१३-२१८-३३", "content_sanskrit": "परोपतापनाश्चैव मांसादाश्च तथैव च।\nअभ्यसूयापराश्चैव अशुद्धाश्च तथा नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2097542, "chapter_id": 3088, "verse_number": "१३-२१८-३४", "content_sanskrit": "एवं युक्तसमाचारा यमलोके सुदण्डिताः।\nकथंचित्प्राप्य मानुष्यं तत्र ते रूपवर्जिताः।\nविरूपाः सम्भवन्त्येव नास्ति तत्र विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2097543, "chapter_id": 3088, "verse_number": "१३-२१८-३५x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2097544, "chapter_id": 3088, "verse_number": "१३-२१८-३५", "content_sanskrit": "भगवन्देवदेवेश केचित्सौभाग्यसंयुताः।\nरूपभोग्यविहीनाश्च दृश्यन्ते प्रमदाप्रियाः।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2097545, "chapter_id": 3088, "verse_number": "१३-२१८-३६x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2097546, "chapter_id": 3088, "verse_number": "१३-२१८-३६", "content_sanskrit": "ये पुरा मनुजा देवि सौम्यशीलाः प्रियंवदाः।\nस्वदारैरेव संतुष्टा दारेषु समवृत्तयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2097547, "chapter_id": 3088, "verse_number": "१३-२१८-३७", "content_sanskrit": "दाक्षिण्येनैव वर्तन्ते प्रमदास्वप्रियास्वपि।\nन तु प्रत्यादिशन्त्येव स्त्रीदोषान्गुणसंश्रितान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2097548, "chapter_id": 3088, "verse_number": "१३-२१८-३८", "content_sanskrit": "अन्नपानीयदाः काले नृणां स्वादुप्रदाश्च ये।\nस्वदारवर्तिनश्चैव धृतिमन्तो निरत्ययाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2097549, "chapter_id": 3088, "verse_number": "१३-२१८-३९", "content_sanskrit": "एवं युक्तसमाचाराः पुनर्जन्मनि शोभने।\nमानुषास्ते भवन्त्येव सततं सुभगा भृशम्।\nअर्थादृतेऽपि ते देवि भवन्ति प्रमदाप्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2097550, "chapter_id": 3088, "verse_number": "१३-२१८-४०x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2097551, "chapter_id": 3088, "verse_number": "१३-२१८-४०", "content_sanskrit": "दुर्भगाः सम्प्रदृश्यन्ते आढ्या भोगयुता अपि।\nकेन कर्मविपाकेन तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2097552, "chapter_id": 3088, "verse_number": "१३-२१८-४१x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2097553, "chapter_id": 3088, "verse_number": "१३-२१८-४१", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु सर्वं समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2097554, "chapter_id": 3088, "verse_number": "१३-२१८-४२", "content_sanskrit": "ये पुरा मनुजा देवि स्वदारेष्वनपेक्षया।\nयथेष्टवृत्तयश्चैव निर्लज्जा वीतसम्भ्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2097555, "chapter_id": 3088, "verse_number": "१३-२१८-४३", "content_sanskrit": "परेषां विप्रियकरा वाङ्मनःकायकर्मभिः।\nनिराश्रया निरानन्दाः स्त्रीणां हृदयकोपनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2097556, "chapter_id": 3088, "verse_number": "१३-२१८-४४", "content_sanskrit": "एवं युक्तसमाचाराः पनर्जन्मनि ते नराः।\nदुर्भगास्तु भवन्त्येव स्त्रीणां हृदयविप्रियाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2097557, "chapter_id": 3088, "verse_number": "१३-२१८-४५", "content_sanskrit": "नास्ति तेषां रतिसुखं स्वदारेष्वपि किञ्चन॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2097558, "chapter_id": 3088, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टादशाधिकद्विशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]