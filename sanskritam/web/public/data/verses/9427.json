[{"id": 40023178, "chapter_id": 9427, "verse_number": "1", "content_sanskrit": "ते दूता रामवाक्येन चोदिता लघुविक्रमाः । प्रजग्मुर्मधुरां शीघ्रं चक्रुर्वासं न चाध्वनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40023179, "chapter_id": 9427, "verse_number": "2", "content_sanskrit": "ते तु त्रिभिरहोरात्रैः सम्प्राप्य मधुरामथ । शत्रुघ्नाय यथातत्त्वमाचख्युः सर्वमेव तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40023180, "chapter_id": 9427, "verse_number": "3", "content_sanskrit": "लक्ष्मणस्य परित्यागं प्रतिज्ञां राघवस्य च । पुत्रयोरभिषेकं च पौरानुगमनं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40023181, "chapter_id": 9427, "verse_number": "4", "content_sanskrit": "कुशस्य नगरी रम्या विन्ध्यपर्वतरोधसि । कुशावतीति नाम्ना सा कृता रामेण धीमता । श्रावस्तीति पुरी रम्या श्राविता च लवस्य ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40023182, "chapter_id": 9427, "verse_number": "5", "content_sanskrit": "अयोध्यां विजनां कृत्वा राघवो भरतस्तथा । स्वर्गस्य गमनोद्योगं कृतवन्तौ महारथौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40023183, "chapter_id": 9427, "verse_number": "6", "content_sanskrit": "एवं सर्वं निवेद्याशु शत्रुघ्नाय महात्मने । विरेमुस्ते ततो दूतास्त्वर राजेति चाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40023184, "chapter_id": 9427, "verse_number": "7", "content_sanskrit": "तच्छ्रुत्वा घोरसङ्काशं कुलक्षयमुपस्थितम् । प्रकृतीस्तु समानीय काञ्चनं च पुरोधसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40023185, "chapter_id": 9427, "verse_number": "8", "content_sanskrit": "तेषां सर्वं यथावृत्तमब्रवीद्रघनन्दनः । आत्मनश्च विपर्यासं भविष्यं भ्रातृभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40023186, "chapter_id": 9427, "verse_number": "9", "content_sanskrit": "ततः पुत्रद्वयं वीरः सो ऽभ्यषिञ्चन्नराधिपः । सुबाहुर्मधुरां लेभे शत्रुघाती च वैदिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40023187, "chapter_id": 9427, "verse_number": "10", "content_sanskrit": "द्विधा कृत्वा तु तां सेनां माधुरीं पुत्रयोर्द्वयोः । धनं च युक्तं कृत्वा वै स्थापयामास पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40023188, "chapter_id": 9427, "verse_number": "11", "content_sanskrit": "सुबाहुं मधुरायां च वैदेशे शत्रुघातिनम् । ययौ स्थाप्य तदा ऽयोध्यां रथेनैकेन राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40023189, "chapter_id": 9427, "verse_number": "12", "content_sanskrit": "स ददर्श महात्मानं ज्वलन्तमिव पावकम् । सूक्ष्मक्षौमाम्बरधरं मुनिभिः सार्धमक्षयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40023190, "chapter_id": 9427, "verse_number": "13", "content_sanskrit": "सो ऽभिवाद्य ततो रामं प्राञ्जलिः प्रयतेन्द्रियः । उवाच वाक्यं धर्मज्ञं धर्ममेवानुचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40023191, "chapter_id": 9427, "verse_number": "14", "content_sanskrit": "कृत्वाभिषेकं सुतयोर्द्वयो राघवनन्दन । तवानुगमने राजन्विद्धि मां कृतनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40023192, "chapter_id": 9427, "verse_number": "15", "content_sanskrit": "न चान्यदपि वक्तव्यमतो वीर न शासनम् । विलोक्यमानमिच्छामि मद्विधेन विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40023193, "chapter_id": 9427, "verse_number": "16", "content_sanskrit": "तस्य तां बुद्धिमक्लीबां विज्ञाय रघुनन्दनः । बाढमित्येव शत्रुघ्नं रामो वाक्यमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40023194, "chapter_id": 9427, "verse_number": "17", "content_sanskrit": "तस्य वाक्यस्य वाक्यान्ते वानराः कामरूपिणः । ऋक्षराक्षससङ्घाश्च समापेतुरनेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40023195, "chapter_id": 9427, "verse_number": "18", "content_sanskrit": "सुग्रीवं ते पुरस्कृत्य सर्व एव समागताः । तं रामं द्रष्टुमनसः स्वर्गायाभिमुखं स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40023196, "chapter_id": 9427, "verse_number": "19", "content_sanskrit": "देवपुत्रा ऋषिसुता गन्धर्वाणां सुतास्तथा । रामक्षयं विदित्वा ते सर्व एव समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40023197, "chapter_id": 9427, "verse_number": "20", "content_sanskrit": "ते राममभिवाद्योचुः सर्वे वानरराक्षसाः । तवानुगमने राजन्सम्प्राप्ताः कृतनिश्चयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40023198, "chapter_id": 9427, "verse_number": "21", "content_sanskrit": "यदि राम विनास्माभिर्गच्छेस्त्वं पुरुषोत्तम । यमदण्डमिवोद्यम्य त्वया स्म विनिपातिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40023199, "chapter_id": 9427, "verse_number": "22", "content_sanskrit": "तैरेवमुक्तः काकुत्स्थो बाढमित्यब्रवीत् स्मयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40023200, "chapter_id": 9427, "verse_number": "23", "content_sanskrit": "एतस्मिन्नन्तरे रामं सुग्रीवो ऽपि महाबलः । प्रणम्य विधिवद्वीरं विज्ञापयितुमुद्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40023201, "chapter_id": 9427, "verse_number": "24", "content_sanskrit": "अभिषिच्याङ्गदं वीरमागतो ऽस्मि नरेश्वर । तवानुगमने राजन्विद्धि मां कृतनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40023202, "chapter_id": 9427, "verse_number": "25", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा रामो रमयतां वरः । वानरेन्द्रमथोवाचं मैत्रं तस्यानुचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40023203, "chapter_id": 9427, "verse_number": "26", "content_sanskrit": "सखे शृणुष्व सुग्रीव न त्वया ऽहं विनाकृतः । गच्छेयं देवलोकं वा परमं वा पदं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40023204, "chapter_id": 9427, "verse_number": "27", "content_sanskrit": "बिभीषणमथोवाच राक्षसेन्द्रं महायशाः । यावत्प्रजा धरिष्यन्ति तावत्त्वं वै बिभीषण । राक्षसेन्द्र महावीर्य लङ्कास्थस्त्वं धरिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40023205, "chapter_id": 9427, "verse_number": "28", "content_sanskrit": "यावच्चन्द्रश्च सूर्यश्च यावत्तिष्ठति मेदिनी । यावच्च मत्कथा लोके तावद्राज्यं तवास्त्विह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40023206, "chapter_id": 9427, "verse_number": "29", "content_sanskrit": "शासितस्त्वं सखित्वेन कार्यं ते मम शासनम् । प्रजाः संरक्ष धर्मेण नोत्तरं वक्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40023207, "chapter_id": 9427, "verse_number": "30", "content_sanskrit": "किञ्चान्यद्वक्तुमिच्छामि राक्षसेन्द्र महामते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40023208, "chapter_id": 9427, "verse_number": "31", "content_sanskrit": "आराधय जगन्नाथमिक्ष्वाकुकुलदैवतम् । आराधनीयमनिशं सर्वैर्दैवैः सवासवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40023209, "chapter_id": 9427, "verse_number": "32", "content_sanskrit": "तथेति प्रतिजग्राह रामवाक्यं विभीषणः । राजा राक्षसमुख्यानां राघवाज्ञामनुस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40023210, "chapter_id": 9427, "verse_number": "33", "content_sanskrit": "तमेवमुक्त्वा काकुत्स्थो हनूमन्तमथाब्रवीत् । जीविते कृतबुद्धिस्त्वं मा प्रतिज्ञां विलोपय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40023211, "chapter_id": 9427, "verse_number": "34", "content_sanskrit": "मत्कथाः प्रचरिष्यन्ति यावल्लोके हरीश्वर । तावद्रमस्व सुप्रीतो मद्वाक्यमनुपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40023212, "chapter_id": 9427, "verse_number": "35", "content_sanskrit": "एवमुक्तस्तु हनुमान्राघवेण महात्मना । वाक्यं विज्ञापयामास परं हर्षमवाप्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40023213, "chapter_id": 9427, "verse_number": "36", "content_sanskrit": "यावत्तव कथा लोके विचरिष्यति पावनी । तावत्स्थास्यामि मेदिन्यां तवाज्ञामनुपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40023214, "chapter_id": 9427, "verse_number": "37", "content_sanskrit": "जाम्बवन्तं तथोक्त्वा तु वृद्धं ब्रह्मसुतं तथा । मैन्दं च द्विविदं चैव पञ्च जाम्बवता सह ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40023215, "chapter_id": 9427, "verse_number": "38", "content_sanskrit": "तानेवमुक्त्वा काकुत्स्थः सर्वांस्तानृक्षवानरान् । उवाच बाढं गच्छध्वं मया सार्धं यथेप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]