[{"id": 7003299000, "chapter_id": 23299, "verse_number": "१-१०२-१", "content_sanskrit": "सूत उवाच  ।\nतपसा च महादेव्याः पार्वत्या वृषभध्वजः  ।\nप्रीतश्च भगवाच्छर्वो वचनाद्ब्रह्मणस्तदा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003299001, "chapter_id": 23299, "verse_number": "१-१०२-२", "content_sanskrit": "हिताय चाश्रमाणां च क्रीडार्थं भगवान्भवः  ।\nतदा हैमवतीं देवीमुपयेमे यथाविधि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003299002, "chapter_id": 23299, "verse_number": "१-१०२-३", "content_sanskrit": "जगाम स स्वयं ब्रह्मा मरीच्याद्यैर्महर्षिभिः  ।\nतपोवनं महादेव्याः पार्वत्याः पद्मसंभवः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003299003, "chapter_id": 23299, "verse_number": "१-१०२-४", "content_sanskrit": "प्रदक्षिणीकृत्य च तां देवीं स जगतोरणीम्  ।\nकीमर्थं तपसा लोकान्संतापयसि शैलजे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003299004, "chapter_id": 23299, "verse_number": "१-१०२-५", "content_sanskrit": "त्वया सृष्टं जगत्सर्वं मातस्त्वं मा विमाशय  ।\nत्वं हि संधारये लोकानिमान्सर्वान्स्वतेजसा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003299005, "chapter_id": 23299, "verse_number": "१-१०२-६", "content_sanskrit": "सर्वदेवेश्वरः श्रीमान्सर्वलोकपतिर्भवः  ।\nयस्य वै देवदेवस्य वयं किंकरवादिनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003299006, "chapter_id": 23299, "verse_number": "१-१०२-७", "content_sanskrit": "स एवं परमेशानः स्वयं च वरयिष्यति  ।\nवरदे येन सृष्टासि न विना यस्त्वयांबिके ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003299007, "chapter_id": 23299, "verse_number": "१-१०२-८", "content_sanskrit": "वर्त्तते नात्र संदेहस्तव भर्त्ता भविष्यति  ।\nइत्युक्त्वा तां नमस्कृत्य मुहुः संप्रेक्ष्य पार्वतीम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003299008, "chapter_id": 23299, "verse_number": "१-१०२-९", "content_sanskrit": "गते पितामहे देवो भगवान् परमेश्वरः  ।\nजगामानुग्रहं कर्त्तुं द्विजरूपेण चाश्रमम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003299009, "chapter_id": 23299, "verse_number": "१-१०२-१०", "content_sanskrit": "सा च दृष्ट्वा माहदेवं द्विजरूपेण संस्थितम्  ।\nप्रतिभाद्यौः प्रभुं ज्ञात्वा ननाम वृषभध्वजम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003299010, "chapter_id": 23299, "verse_number": "१-१०२-११", "content_sanskrit": "संपूज्य वरदं देवं ब्राह्मणच्छद्मनागतम्  ।\nतुष्टाव परमेशानं पार्वती परमेश्वरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003299011, "chapter_id": 23299, "verse_number": "१-१०२-१२", "content_sanskrit": "अनुगृह्य तदा देवीमुवाच प्रहसन्निव  ।\nकुलधर्माश्रयं रक्षन् भूधरस्य महात्मनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003299012, "chapter_id": 23299, "verse_number": "१-१०२-१३", "content_sanskrit": "क्रीडार्थं च संतां मध्ये सर्वदेवपतिर्भवः  ।\nस्वयंवरे महादेवी तव दिव्यसुशोभने ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003299013, "chapter_id": 23299, "verse_number": "१-१०२-१४", "content_sanskrit": "आस्थाय रूपं यत्सौम्यं समेष्येहं सह त्वया  ।\nइत्युक्त्वा तां समालोक्य देवो दिव्येन चक्षुषा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003299014, "chapter_id": 23299, "verse_number": "१-१०२-१५", "content_sanskrit": "जगामेष्टं तदा दिव्यं स्वपुरं प्रययौच सा  ।\nदृष्ट्वा हृष्टस्तदा देवीं मेनया तुहिनाचलः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003299015, "chapter_id": 23299, "verse_number": "१-१०२-१६", "content_sanskrit": "आलिंग्याघ्राय संपूज्य पुत्रीं साक्षात्तपस्विनीम्  ।\nदुहितुर्देवदेवेन न जानन्नभिमंत्रितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003299016, "chapter_id": 23299, "verse_number": "१-१०२-१७", "content_sanskrit": "स्वयंवरं तदा देव्याः सर्वलोकेष्वघोषयत्  ।\nअथ ब्रह्मा च भगवान् विष्णुः साक्षाज्जनार्दनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003299017, "chapter_id": 23299, "verse_number": "१-१०२-१८", "content_sanskrit": "शक्रश्च भगवान् वह्निर्भास्करो भग एव च  ।\nत्वष्टार्यमा विवस्वांश्च यमो वरुण एव च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003299018, "chapter_id": 23299, "verse_number": "१-१०२-१९", "content_sanskrit": "वायुः सोमस्तथेशानो रुद्राश्च मुनयस्तथा  ।\nअश्विनौ द्वादशादित्या गंधर्वा गरुडस्तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003299019, "chapter_id": 23299, "verse_number": "१-१०२-२०", "content_sanskrit": "यक्षाः सिद्धास्तता साध्या दैत्याः किंपुरुषोरगाः  ।\nसमुद्राश्च नदा वेदा मंत्राः स्तोत्रादयः क्षणाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003299020, "chapter_id": 23299, "verse_number": "१-१०२-२१", "content_sanskrit": "नागाश्च पर्वताः सर्वे यज्ञाः सूर्यादयो ग्रहाः  ।\nत्रयस्त्रिंशच्च देवानां त्रयश्च त्रिशतं तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003299021, "chapter_id": 23299, "verse_number": "१-१०२-२२", "content_sanskrit": "त्रयश्च त्रिसहस्रं च तथान्ये बहवः सुरा  ।\nजग्मुर्गिरिंद्रपुत्र्यास्तु स्वयंवरमनुत्तमम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003299022, "chapter_id": 23299, "verse_number": "१-१०२-२३", "content_sanskrit": "अथ शैलसुता देवी हैममारुह्य शोभनम्  ।\nविमानं सर्वतोभद्रं सर्वरत्नैरलंकृतम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003299023, "chapter_id": 23299, "verse_number": "१-१०२-२४", "content_sanskrit": "अप्सरोभिः प्रनृत्ताभिः सर्वाभरणभूषितैः  ।\nगंधर्वसिद्धैर्विविधैः किन्नरैश्च सुशोभनैः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003299024, "chapter_id": 23299, "verse_number": "१-१०२-२५", "content_sanskrit": "बंदिभिः स्तूयमाना च स्थिता शैलसुता तदा  ।\nसितातपत्रं रत्नांशुमिश्रितं चावहत्तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003299025, "chapter_id": 23299, "verse_number": "१-१०२-२६", "content_sanskrit": "मालिनी गिरिपुत्र्यास्तु संध्यापूर्णेन्दुमंडलम्  ।\nचामरासक्तहस्ताभिर्दिव्यस्त्रीभिश्च संवृता ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003299026, "chapter_id": 23299, "verse_number": "१-१०२-२७", "content_sanskrit": "मालां गृह्य जया तस्थौ सुरद्रुमसमुद्भवाम्  ।\nविजया व्यजनं गृह्य स्थिता देव्याः समीपगा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003299027, "chapter_id": 23299, "verse_number": "१-१०२-२८", "content_sanskrit": "मालां प्रहृह्य देव्यां तु स्थितायां देवसंसदि  ।\nशिशुर्भूत्वा महादेवः क्रीडार्थं वृषभध्वजः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003299028, "chapter_id": 23299, "verse_number": "१-१०२-२९", "content_sanskrit": "उत्संगतलसंसुप्तो बभूव भगवान्‌भवः  ।\nअथ दृष्ट्वा शिशुं देवास्तस्या उत्संगवर्त्तिनम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003299029, "chapter_id": 23299, "verse_number": "१-१०२-३०", "content_sanskrit": "कोयमत्रेति संमंत्र्य चुक्षुभुश्च समागताः  ।\nवज्रमाहारयत्तस्य बाहुमुद्युम्य वृत्रहा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003299030, "chapter_id": 23299, "verse_number": "१-१०२-३१", "content_sanskrit": "स बाहुरुद्यमस्तस्य तथैव समुपस्थितः  ।\nस्तंभितः शिशुरूपेण देवदेवेन लीलया ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003299031, "chapter_id": 23299, "verse_number": "१-१०२-३२", "content_sanskrit": "वज्रं क्षेप्तुं न शशाक बाहुं चालयितुं तथा  ।\nवह्निं शक्तिं तथा क्षेप्तं न शशाक तथा स्थितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003299032, "chapter_id": 23299, "verse_number": "१-१०२-३३", "content_sanskrit": "यमोपि दंडं खड्गं च निर्ऋतिर्मुनिपुंगवाः  ।\nवरुणो नागपाशं च ध्वजयष्टिं समीरणः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003299033, "chapter_id": 23299, "verse_number": "१-१०२-३४", "content_sanskrit": "सोमो गदां धनेशश्च दंडं दंडभृतां वरः  ।\nईशानश्च तथा शूलं तीव्रमुद्यम्य संस्थितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003299034, "chapter_id": 23299, "verse_number": "१-१०२-३५", "content_sanskrit": "रुद्राश्च शूलमादित्या मुशलं वसवस्तथा  ।\nमुद्गरं स्तंभिताः सर्वे देवेनाशु दिवौकसः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003299035, "chapter_id": 23299, "verse_number": "१-१०२-३६", "content_sanskrit": "स्तंभिता देवदेवेन तथान्ये च दिवौकसः  ।\nशिरःप्रकंपयन्विष्णुश्चक्रमुद्यम्य संस्थितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003299036, "chapter_id": 23299, "verse_number": "१-१०२-३७", "content_sanskrit": "तस्यापि शिरसो बालः स्थिरत्वं प्रचकार ह  ।\nचक्रं क्षेप्तुं न शशाक बाहूंश्चालयितुं न च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003299037, "chapter_id": 23299, "verse_number": "१-१०२-३८", "content_sanskrit": "पूषा दंतान्दशन्दंतैर्बालमैक्षत मोहितः  ।\nतस्यापि दशनाः पेतुर्दृष्टमात्रस्य शंभुना ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003299038, "chapter_id": 23299, "verse_number": "१-१०२-३९", "content_sanskrit": "बलं तेजश्च योगं च तथैवास्तंभयद्विभुः  ।\nअथ तेषु स्थितेष्वेव मन्युमत्सु सुरेष्वपि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003299039, "chapter_id": 23299, "verse_number": "१-१०२-४०", "content_sanskrit": "ब्रह्मा परमसंविग्नो ध्यानमास्थाय शंकरम्  ।\nबुबुधे देवमीशानमुमोत्संगे तमास्थितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003299040, "chapter_id": 23299, "verse_number": "१-१०२-४१", "content_sanskrit": "स बुद्ध्वा देवमीशानं शीघ्रमुत्थाय विस्मितः  ।\nववंदे चरणौ शंभोरस्तुवच्च पितामहः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003299041, "chapter_id": 23299, "verse_number": "१-१०२-४२", "content_sanskrit": "स बुद्ध्वा देवमीशानं शीघ्रमुत्थाय विस्मितः  ।\nववंदे चरणौ शंभोरस्तुवच्च पितामहः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003299042, "chapter_id": 23299, "verse_number": "१-१०२-४३", "content_sanskrit": "बुद्धिस्त्वं सर्वलोकानामहंकारस्त्वमीश्वरः  ।\nभूतानामिंद्रियाणां च त्वमेवेश प्रवर्त्तकः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003299043, "chapter_id": 23299, "verse_number": "१-१०२-४४", "content_sanskrit": "तवाहं दक्षिणाद्धस्तात्सृष्टः पूर्वं पुरातनः  ।\nवामहस्तान्महा बाहो देवो नारायणः प्रभुः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003299044, "chapter_id": 23299, "verse_number": "१-१०२-४५", "content_sanskrit": "इयं च प्रकृतिर्देवी सदा ते सृष्टिकारण  ।\nपत्नीरूपं समास्थाय जगत्कारणमागता ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003299045, "chapter_id": 23299, "verse_number": "१-१०२-४६", "content_sanskrit": "नमस्तुभ्यं महादेव महादेव्यै नमोनमः  ।\nप्रसादात्तव देवेश नियोगाच्च मया प्रजाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003299046, "chapter_id": 23299, "verse_number": "१-१०२-४७", "content_sanskrit": "देवाद्यास्तु इमाः सृष्टा मूढास्त्वद्योगमोहिताः  ।\nकुरु प्रसादमेतेषां यथापूर्वं भवंत्विमे ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003299047, "chapter_id": 23299, "verse_number": "१-१०२-४८", "content_sanskrit": "सूत उवाच  ।\nविज्ञाप्यैवं तदा ब्रह्मा देवदेवं महेश्वरम्  ।\nसंस्तंतितांस्तदा तेन भगवानाहपद्मजः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003299048, "chapter_id": 23299, "verse_number": "१-१०२-४९", "content_sanskrit": "मूढास्थ देवताः सर्वा नैव बुध्यत शंकरम्  ।\nदेवदेवमिहायांतं सर्वदेवनमस्कृतम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003299049, "chapter_id": 23299, "verse_number": "१-१०२-५०", "content_sanskrit": "गच्छध्वं शरणं शीघ्रं देवाः शक्रपुरोगमाः  ।\nसनारायणकाः सर्वे मुनिभिः शंकरं प्रभुम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003299050, "chapter_id": 23299, "verse_number": "१-१०२-५१", "content_sanskrit": "सार्धं मयैव देवेशं परमात्मानमीश्वरम्  ।\nअनया हैमवत्या च प्रकृत्या सह सत्तमम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003299051, "chapter_id": 23299, "verse_number": "१-१०२-५२", "content_sanskrit": "तत्र ते स्तंभितास्तेन तथैव सुरसत्तमाः  ।\nप्रणेमुर्मनसा सर्वे सनारायणकाः प्रभुम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003299052, "chapter_id": 23299, "verse_number": "१-१०२-५३", "content_sanskrit": "अथ तेषां प्रसन्नो भूद्देवदेवस्त्रियंबकः  ।\nयथापूर्वं चकाराशु वचनाद्ब्रह्मणः प्रभुः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003299053, "chapter_id": 23299, "verse_number": "१-१०२-५४", "content_sanskrit": "तत एवं प्रसन्ने तु सर्वदेवनिवारणम् ।\nवपुश्चकार देवेशो दिव्यं परममद्भुतम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003299054, "chapter_id": 23299, "verse_number": "१-१०२-५५", "content_sanskrit": "तेजसा तस्य देवास्ते सेंद्रचंद्रदिवाकराः  ।\nसब्रह्मकाः ससाध्याश्च सनारायणकास्तथा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003299055, "chapter_id": 23299, "verse_number": "१-१०२-५६", "content_sanskrit": "सयमाश्च सरुद्राश्च चक्षुर प्राथयन्विभुम्  ।\nतेभ्यश्च परमं चक्षुः सर्वदृष्टौ च शक्तिमत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003299056, "chapter_id": 23299, "verse_number": "१-१०२-५७", "content_sanskrit": "ददावंबापतिः शर्वो भवान्याश्च चलस्य च  ।\nलब्ध्वा चक्षुस्तदा देवा इंद्रविष्णुपुरोगमाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003299057, "chapter_id": 23299, "verse_number": "१-१०२-५८", "content_sanskrit": "सब्रह्मकाः सशक्राश्च तमपश्यन्महेश्वरम्  ।\nब्रह्माद्या नेमिरे तूर्णं भवानी च गिरीश्वरः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003299058, "chapter_id": 23299, "verse_number": "१-१०२-५९", "content_sanskrit": "मुनयश्च महादेवं गणेशाः शिवसंमताः  ।\nससर्जुः पुष्पवृष्टिं च खेचराः सिद्धचारणाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003299059, "chapter_id": 23299, "verse_number": "१-१०२-६०", "content_sanskrit": "देवदुंदुभयो नेदुस्तुष्टुवुर्मुनयः प्रभुम्  ।\nजगुर्गंधर्वमुख्याश्च ननृतुश्चाप्सरोगणाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003299060, "chapter_id": 23299, "verse_number": "१-१०२-६१", "content_sanskrit": "मुमुहुर्गणपाः सर्वं मुमोदांबा च पार्वती  ।\nतस्य देवी तदा हृष्टा समक्षं त्रिदिवौकसाम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003299061, "chapter_id": 23299, "verse_number": "१-१०२-६२", "content_sanskrit": "पादयोः स्तापयामास मालां दिव्यां सुगंधिनीम्  ।\nसाधुसाध्विति संप्रोच्य तया तत्रैव चार्चितम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003299062, "chapter_id": 23299, "verse_number": "१-१०२-६३", "content_sanskrit": "सह देव्या नमश्चक्रुः शिरोभिर्भूतलाश्रितैः  ।\nसर्वे सब्रह्मका देवाः सयक्षोरगराक्षसाः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]