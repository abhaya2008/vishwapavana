[{"id": 2142625, "chapter_id": 4076, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142626, "chapter_id": 4076, "verse_number": "१", "content_sanskrit": "शल्यः श्रुत्वा तु दूतानां सैन्येन महता धृतः ।\nअभ्ययात् पाण्डवान् राजन् सह पुत्रैर्महारथैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142627, "chapter_id": 4076, "verse_number": "२", "content_sanskrit": "तस्य सेनानिवेशोऽभूद् अध्यर्धमिव योजनम् ।\nतथा हि विपुलां सेनां बिभर्ति स नरर्षभः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142628, "chapter_id": 4076, "verse_number": "३", "content_sanskrit": "विचित्रकवचाः शूरा विचित्रध्वजकार्मुकाः ।\nविचित्राभरणाः सर्वे विचित्ररथवाहनाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2142629, "chapter_id": 4076, "verse_number": "४", "content_sanskrit": "स्वदेशवेषाभरणा वीराः शतसहस्रशः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2142630, "chapter_id": 4076, "verse_number": "५", "content_sanskrit": "तस्य सेनाप्रणेतारो बभूवुः क्षत्रियर्षभाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2142631, "chapter_id": 4076, "verse_number": "६", "content_sanskrit": "व्यथयन्निव भूतानि कम्पयन्निव मेदिनीम् ।\nशनैर्विश्रामयन् सेनां स ययौ यत्र पाण्डवाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2142632, "chapter_id": 4076, "verse_number": "७", "content_sanskrit": "ततो दुर्योधनः श्रुत्वा महासेनं महारथम् ।\nउपायान्तमभिद्रुत्य स्वयमानर्च भारत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2142633, "chapter_id": 4076, "verse_number": "८", "content_sanskrit": "शल्यस्य मन्त्रिभिः सर्वैर्दुर्योधनवशानुगैः ।\nअज्ञातं चैव शल्यस्य कौरव्यः कृतवान् प्रियम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2142634, "chapter_id": 4076, "verse_number": "९", "content_sanskrit": "कारयामास पूजार्थं तस्य दुर्योधनः सभाः ।\nरमणीयेषु देशेषु रत्नचित्राः स्वलङ्कृताः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2142635, "chapter_id": 4076, "verse_number": "१०", "content_sanskrit": "शिल्पिभिर्विविधैश्चैव क्रीडास्तत्र प्रयोजिताः ।\nतत्र माल्यानि मांसानि भक्ष्यं पेयं च संस्कृतम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2142636, "chapter_id": 4076, "verse_number": "११", "content_sanskrit": "कूपाश्च विविधाकारा मनोहर्षविवर्धनाः ।\nवाप्यश्च विविधाकारा औदनानि गृहाणि च\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2142637, "chapter_id": 4076, "verse_number": "१२", "content_sanskrit": "स ताः सभाः समासाद्य पूज्यमानो यथाऽमरः ।\nदुर्योधनस्य सचिवैर्देशे देशे यथाविधि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2142638, "chapter_id": 4076, "verse_number": "१३", "content_sanskrit": "आजगाम सभामन्यां देवावसथवर्चसम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2142639, "chapter_id": 4076, "verse_number": "१४", "content_sanskrit": "स तत्र विभवैर्युक्तः कल्याणैरतिमानुषैः ।\nमेनेऽभ्यधिकमात्मानमवमेने पुरन्दरम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2142640, "chapter_id": 4076, "verse_number": "१५", "content_sanskrit": "पप्रच्छ स ततः प्रेष्यान् प्रहृष्टः क्षत्रियर्षभः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2142641, "chapter_id": 4076, "verse_number": "१६", "content_sanskrit": "युधिष्ठिरस्य पुरुषाः केऽत्र चक्रुः सभा इमाः ।\nआनीयन्तां सभाकाराः प्रदेयार्हा हि मे मताः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2142642, "chapter_id": 4076, "verse_number": "१७", "content_sanskrit": "प्रदेयमेभ्यो दास्यामि कुन्तीपुत्रप्रियेप्सया\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2142643, "chapter_id": 4076, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2142644, "chapter_id": 4076, "verse_number": "१८", "content_sanskrit": "ततः प्रहृष्टं राजानं ज्ञात्वा ते सचिवास्तदा ।\nदुर्योधनाय तत् सर्वं कथयन्ति स्म विस्मिताः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2142645, "chapter_id": 4076, "verse_number": "१९", "content_sanskrit": "सम्प्रहृष्टो यदा शल्यो दिदित्सुरपि जीवितम् ।\nगूढो दुर्योधनस्तत्र दर्शयामास मातुलम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2142646, "chapter_id": 4076, "verse_number": "२०", "content_sanskrit": "दृष्ट्वा दुर्योधनं राजा विस्मितः स नरोत्तमम् ।\nमन्त्रिणश्चापि शंसन्ति मद्रराजं सुविस्मितम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2142647, "chapter_id": 4076, "verse_number": "२१", "content_sanskrit": "दुर्योधनेन ते राजन् शुश्रूषितमिदं प्रभो ।\nप्रियं प्रियस्यास्य ततः कर्तुमर्हति भूमिप\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2142648, "chapter_id": 4076, "verse_number": "२२", "content_sanskrit": "तं दृष्ट्वा मद्रराजस्तु ज्ञात्वा यत्नं च तस्य तम् ।\nपरिष्वज्याब्रवीत् प्रीत इष्टोऽर्थो व्रियतामिति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2142649, "chapter_id": 4076, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2142650, "chapter_id": 4076, "verse_number": "२३", "content_sanskrit": "सत्यवाग् भव कल्याण वरो वै मम दीयताम् ।\nसर्वसेनाप्रणेता मे भवान् भवितुमर्हति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2142651, "chapter_id": 4076, "verse_number": "२४", "content_sanskrit": "यथैव पाण्डवास्तुभ्यं तथैव भवते ह्यहम् ।\nअनुमान्यं च पाल्यं च भक्तं च भज मां विभो\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2142652, "chapter_id": 4076, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2142653, "chapter_id": 4076, "verse_number": "२५", "content_sanskrit": "कृतमित्यब्रवीच्छल्यः किमन्यद् व्रियतामिति ।\nकृतमित्येव गान्धारिः प्रत्युवाच पुनः पुनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2142654, "chapter_id": 4076, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2142655, "chapter_id": 4076, "verse_number": "२६", "content_sanskrit": "गच्छ दुर्योधन पुरं स्वकमेव नरर्षभ ।\nअहं गमिष्ये द्रष्टुं वै युधिष्ठिरमरिन्दमम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2142656, "chapter_id": 4076, "verse_number": "२७", "content_sanskrit": "दृष्ट्वा युधिष्ठिरं राजन् पुनरेष्ये नराधिप ।\nअवश्यं चापि द्रष्टव्यः पाण्डवः पुरुषर्षभ\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2142657, "chapter_id": 4076, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2142658, "chapter_id": 4076, "verse_number": "२८", "content_sanskrit": "क्षिप्रमागम्यतां राजन् पाण्डवं वीक्ष्य पार्थिव ।\nत्वदधीनाः स्म राजेन्द्र वरदानं स्मरस्व नः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2142659, "chapter_id": 4076, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2142660, "chapter_id": 4076, "verse_number": "२९", "content_sanskrit": "क्षिप्रमेष्यामि भद्रं ते गच्छ त्वं स्वपुरं नृप ।\nदृष्ट्वा तु पाण्डवान् राजन् न मिथ्या कर्तुमुत्सहे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2142661, "chapter_id": 4076, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2142662, "chapter_id": 4076, "verse_number": "३०", "content_sanskrit": "परिष्वज्य तथाऽन्योन्यं शल्यदुर्योधनावुभौ ।\nस तदा शल्यमामन्त्र्य पुनरायात् स्वकं पुरम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2142663, "chapter_id": 4076, "verse_number": "३१", "content_sanskrit": "शल्यो जगाम कौन्तेयानाख्यातुं कर्म तस्य तत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2142664, "chapter_id": 4076, "verse_number": "३२", "content_sanskrit": "उपप्लाव्यं स गत्वा तु स्कन्धावारं प्रविश्य च ।\nपाण्डवानथ तान् सर्वान् शल्यस्तत्र ददर्श ह\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2142665, "chapter_id": 4076, "verse_number": "३३", "content_sanskrit": "चिरात्तु दृष्ट्वा राजानं मातुलं समितिञ्जयम् ।\nआसनेभ्यः समुत्पेतुः सर्वे सहयुधिष्ठिराः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2142666, "chapter_id": 4076, "verse_number": "३४", "content_sanskrit": "तथा भीमार्जुनौ हृष्टौ स्वस्रीयौ च यमावुभौ ।\nद्रौपदी च सुभद्रा च अभिमन्युश्च भारत\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2142667, "chapter_id": 4076, "verse_number": "३५", "content_sanskrit": "समेत्य च महाबाहुं शल्यं पाण्डुसुतस्तदा ।\nकृताञ्जलिरदीनात्मा धर्मात्मा शल्यमब्रवीत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2142668, "chapter_id": 4076, "verse_number": "३६", "content_sanskrit": "स्वागतं तेऽस्तु वै राजन्नेतदासनमास्यताम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2142669, "chapter_id": 4076, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2142670, "chapter_id": 4076, "verse_number": "३७", "content_sanskrit": "ततो न्यषीदच्छल्यश्च काञ्चने परमासने ।\nतत्र पाद्यमथार्घ्यं च न्यवेदयत पाण्डवः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2142671, "chapter_id": 4076, "verse_number": "३८", "content_sanskrit": "निवेद्य चार्घ्यं विधिवन्मद्रराजाय भारत ।\nकुशलं पाण्डवोऽपृच्छत् शल्यं सर्वसुखावहम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2142672, "chapter_id": 4076, "verse_number": "३९", "content_sanskrit": "स तैः परिवृतः सर्वैः पाण्डवैर्धर्मचारिभिः ।\nआसने चोपविष्टः स शल्यः पार्थमथाब्रवीत्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2142673, "chapter_id": 4076, "verse_number": "४०", "content_sanskrit": "प्रीत्या परमया युक्तः समाश्लिष्य युधिष्ठिरम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2142674, "chapter_id": 4076, "verse_number": "४१", "content_sanskrit": "कुशलं राजशार्दूल कच्चित् ते कुरुनन्दन ।\nअरण्यवासाद् दिष्ट्याऽसि विमुक्तो जयतां वर\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2142675, "chapter_id": 4076, "verse_number": "४२", "content_sanskrit": "सुदुष्करं कृतं राजन् निर्जने वसता वने ।\nभ्रातृभिः सह राजेन्द्र कृष्णया चानयाऽनघ\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2142676, "chapter_id": 4076, "verse_number": "४३", "content_sanskrit": "अज्ञातवासं घोरं च वसता दुष्कृतं कृतम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2142677, "chapter_id": 4076, "verse_number": "४४", "content_sanskrit": "दुःखमेव कृतं सौख्यं राज्यभ्रष्टस्य भारत\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2142678, "chapter_id": 4076, "verse_number": "४५", "content_sanskrit": "दुःखस्यैतस्य महतो धार्तराष्ट्रकृतस्य वै ।\nअवाप्स्यसि फलं राजन् हत्वा शत्रून् परन्तप\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2142679, "chapter_id": 4076, "verse_number": "४६", "content_sanskrit": "विदितं ते महाराज लोकतन्त्रं नराधिप ।\nतस्माल्लोककृतं किञ्चित् तव तात न विद्यते\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2142680, "chapter_id": 4076, "verse_number": "४७", "content_sanskrit": "राजर्षीणां पुराणानां मार्गमन्विच्छ भारत\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2142681, "chapter_id": 4076, "verse_number": "४८", "content_sanskrit": "दाने सत्ये तपसि च तव बुद्धिर्युधिष्ठिर ।\nक्षमा दमश्च सत्यं च अहिंसा च नृपोत्तम\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2142682, "chapter_id": 4076, "verse_number": "४९", "content_sanskrit": "उत्साहः संयमो दाक्ष्यमप्रमादो द्युतिः स्मृतिः ।\nमृदुर्वदान्यो ब्रह्मण्यो दाता धर्मपरायणः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2142683, "chapter_id": 4076, "verse_number": "५०", "content_sanskrit": "धर्मास्ते विदिता राजन् बहवो लोकसाक्षिकाः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2142684, "chapter_id": 4076, "verse_number": "५१", "content_sanskrit": "सर्वं जगदिदं तात व्यथितं ते परन्तप\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2142685, "chapter_id": 4076, "verse_number": "५२", "content_sanskrit": "मुदितश्च पुनर्लोकः त्वयि राजन् प्रतिष्ठिते ।\nदिष्ट्या कृच्छ्रमिदं राजन् पारितं भरतर्षभ\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2142686, "chapter_id": 4076, "verse_number": "५३", "content_sanskrit": "दिष्ट्या पश्यामि राजेन्द्र धर्मात्मानं सहानुगम् ।\nनिस्तीर्णदुष्कृतं राजन् त्वां धर्मनिश्चयं प्रभो\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2142687, "chapter_id": 4076, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2142688, "chapter_id": 4076, "verse_number": "५४", "content_sanskrit": "ततोऽस्याकथयद् राजन् दुर्योधनसमागमम् ।\nतच्च सुश्रावितं सर्वं वरदानं च भारत\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2142689, "chapter_id": 4076, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2142690, "chapter_id": 4076, "verse_number": "५५", "content_sanskrit": "सुकृतं ते कृतं राजन् प्रहृष्टेनान्तरात्मना ।\nदुर्योधनस्य यद् वीर त्वया वाचा प्रतिश्रुतम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2142691, "chapter_id": 4076, "verse_number": "५६", "content_sanskrit": "एकं त्विच्छामि भद्रं ते क्रियमाणं महीपते ।\nराजन्नकर्तव्यमपि कर्तुमर्हसि सत्तम\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2142692, "chapter_id": 4076, "verse_number": "५७", "content_sanskrit": "मम त्ववेक्षया वीर शृणु विज्ञापयामि ते ।\nस्पर्धते हि सदा कर्णः पार्थेन रणमूर्धनि\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2142693, "chapter_id": 4076, "verse_number": "५८", "content_sanskrit": "कर्णार्जुनाभ्यां सम्प्राप्ते द्वैरथे राजसत्तम ।\nवासुदेवेन सारथ्यं कार्यं पार्थस्य मातुल ।\nभवानिह महाराज वासुदेवसमो युधि\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2142694, "chapter_id": 4076, "verse_number": "५९", "content_sanskrit": "कर्णस्य भवता कार्यं सारथ्यं नात्र संशयः ।\nतत्र पाल्योऽर्जुनो राजन् यदि मे प्रियमिच्छसि\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2142695, "chapter_id": 4076, "verse_number": "६०", "content_sanskrit": "तेजोवधश्च ते कार्यः सौतेरस्मज्जयावहः ।\nअकर्तव्यमपि ह्येतत् कर्तुमर्हसि मातुल\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2142696, "chapter_id": 4076, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2142697, "chapter_id": 4076, "verse_number": "६१", "content_sanskrit": "शृणु पाण्डव भद्रं ते वधोपायं दुरात्मनः ।\nकर्णस्य सूतपुत्रस्य नित्यं युद्धाभिनन्दिनः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2142698, "chapter_id": 4076, "verse_number": "६२", "content_sanskrit": "तेजोवधनिमित्तं हि सूतपुत्रस्य संयुगे ।\nअहं तस्य भविष्यामि सङ्ग्रामे सारथिर्ध्रुवम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2142699, "chapter_id": 4076, "verse_number": "६३", "content_sanskrit": "वासुदेवेन हि समं नित्यं मां स हि मन्यते\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2142700, "chapter_id": 4076, "verse_number": "६४", "content_sanskrit": "तस्याहं कुरुशार्दूल प्रतीपमहितं वचः ।\nध्रुवं सङ्कथयिष्यामि योद्धुकामस्य संयुगे\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2142701, "chapter_id": 4076, "verse_number": "६५", "content_sanskrit": "अहं तथा करिष्यामि सारथी रणमूर्धनि ।\nयथा स हतदर्पश्च गततेजाश्च पाण्डव\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2142702, "chapter_id": 4076, "verse_number": "६६", "content_sanskrit": "भविष्यति सुखं हन्तुं सत्यमेतद् ब्रवीमि ते ।\nएवमेतत् करिष्यामि यथा तात त्वमात्थ माम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2142703, "chapter_id": 4076, "verse_number": "६७", "content_sanskrit": "यच्चान्यदपि शक्ष्यामि तत् करिष्यामि ते हितम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2142704, "chapter_id": 4076, "verse_number": "६८", "content_sanskrit": "यच्च दुःखं त्वया प्राप्तं द्यूते वै कृष्णया सह ।\nपरुषाणि च वाक्यानि सूतपुत्रकृतानि वै\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2142705, "chapter_id": 4076, "verse_number": "६९", "content_sanskrit": "जटासुरात् परिक्लेशः कीचकाच्च महाद्युते ।\nद्रौपद्याऽधिगतं सर्वं दमयन्त्या यथाऽशुभम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2142706, "chapter_id": 4076, "verse_number": "७०", "content_sanskrit": "सर्वं दुःखमिदं वीर सुखोदर्कं भविष्यति ।\nनात्र मन्युस्त्वया कार्यो विधिर्हि बलवत्तरः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2142707, "chapter_id": 4076, "verse_number": "७१", "content_sanskrit": "दुःखानि हि महात्मानः प्राप्नुवन्ति युधिष्ठिर ।\nदेवैरपि हि दुःखानि प्राप्तानि जगतीपते\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2142708, "chapter_id": 4076, "verse_number": "७२", "content_sanskrit": "इन्द्रेण श्रूयते राजन् सभार्येण महात्मना ।\nअनुभूतं महद्दुःखं देवराजेन भारत\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2142709, "chapter_id": 4076, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि अष्टमोऽध्यायः ॥८॥ सेनोद्योगपर्वणि अष्टमोऽध्यायः ॥८॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]