[{"id": 2015816, "chapter_id": 1333, "verse_number": "२-७४-१", "content_sanskrit": "वैशम्पायन उवाच॥\nवसन्दुर्योधनस्तस्यां सभायां पुरुषर्षभ।\nशनैर्ददर्श तां सर्वां सभां शकुनिना सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015817, "chapter_id": 1333, "verse_number": "२-७४-२", "content_sanskrit": "तस्यां दिव्यानभिप्रायान्ददर्श कुरुनन्दनः।\nन दृष्टपूर्वा ये तेन नगरे नागसाह्वये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015818, "chapter_id": 1333, "verse_number": "२-७४-३", "content_sanskrit": "स कदाचित्सभामध्ये धार्तराष्ट्रो महीपतिः।\nस्फाटिकं स्थलमासाद्य जलमित्यभिशङ्कया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015819, "chapter_id": 1333, "verse_number": "२-७४-४", "content_sanskrit": "स्ववस्त्रोत्कर्षणं राजा कृतवान्बुद्धिमोहितः।\nदुर्मना विमुखश्चैव परिचक्राम तां सभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015820, "chapter_id": 1333, "verse_number": "२-७४-५", "content_sanskrit": "ततः स्थले निपतितो दुर्मना व्रीडितो नृपः।\nनिः श्वसन्विमुखश्चापि परिचक्राम तां सभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015821, "chapter_id": 1333, "verse_number": "२-७४-६", "content_sanskrit": "ततः स्फाटिकतोयां वै स्फाटिकाम्बुजशोभिताम्।\nवापीं मत्वा स्थलमिव सवासाः प्रापतञ्जले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015822, "chapter_id": 1333, "verse_number": "२-७४-७", "content_sanskrit": "जले निपतितं दृष्ट्वा भीमसेनो महाबलः।\nजहास जहसुश्चैव किङ्कराश्च सुयोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015823, "chapter_id": 1333, "verse_number": "२-७४-८", "content_sanskrit": "वासांसि च शुभान्यस्मै प्रददू राजशासनात्।\nतथागतं तु तं दृष्ट्वा भीमसेनो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015824, "chapter_id": 1333, "verse_number": "२-७४-९", "content_sanskrit": "अर्जुनश्च यमौ चोभौ सर्वे ते प्राहसंस्तदा।\nनामर्षयत्ततस्तेषामवहासममर्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015825, "chapter_id": 1333, "verse_number": "२-७४-१०", "content_sanskrit": "आकारं रक्षमाणस्तु न स तान्समुदैक्षत।\nपुनर्वसनमुत्क्षिप्य प्रतिरिष्यन्निव स्थलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015826, "chapter_id": 1333, "verse_number": "२-७४-११", "content_sanskrit": "आरुरोह ततः सर्वे जहसुश्च पुनर्जनाः।\nद्वारं तु पिहिताकारं स्फाटिकं प्रेक्ष्य भूमिपः।\nप्रविशन्नाहतो मूर्ध्नि व्याघूर्णित इव स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015827, "chapter_id": 1333, "verse_number": "२-७४-१२", "content_sanskrit": "तादृशं च परं द्वारं स्फाटिकोरुकवाटकम्।\nविघट्टयन्कराभ्यां तु निष्क्रम्याग्रे पपात हा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015828, "chapter_id": 1333, "verse_number": "२-७४-१३", "content_sanskrit": "द्वारं तु वितताकारं समापेदे पुनश्च सः।\nतद्वृत्तं चेति मन्वानो द्वारस्थानादुपारमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015829, "chapter_id": 1333, "verse_number": "२-७४-१४", "content_sanskrit": "एवं प्रलम्भान्विविधान्प्राप्य तत्र विशाम्पते।\nपाण्डवेयाभ्यनुज्ञातस्ततो दुर्योधनो नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015830, "chapter_id": 1333, "verse_number": "२-७४-१५", "content_sanskrit": "अपहृष्टेन मनसा राजसूये महाक्रतौ।\nप्रेक्ष्य तामद्भुतामृद्धिं जगाम गजसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015831, "chapter_id": 1333, "verse_number": "२-७४-१६", "content_sanskrit": "पाण्डवश्रीप्रतप्तस्य ध्यायमानस्य गच्छतः।\nदुर्योधनस्य नृपतेः पापा मतिरजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015832, "chapter_id": 1333, "verse_number": "२-७४-१७", "content_sanskrit": "पार्थान्सुमनसो दृष्ट्वा पार्थिवांश्च वशानुगान्।\nकृत्स्नं चापि हितं लोकमाकुमारं कुरूद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015833, "chapter_id": 1333, "verse_number": "२-७४-१८", "content_sanskrit": "महिमानं परं चापि पाण्डवानां महात्मनाम्।\nदूर्योधनो धार्तराष्ट्रो विवर्णः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015834, "chapter_id": 1333, "verse_number": "२-७४-१९", "content_sanskrit": "स तु गच्छन्ननेकाग्नः सभामेकोऽन्वचिन्तयत्।\nश्रियं च तामनुपमां धर्मराजस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015835, "chapter_id": 1333, "verse_number": "२-७४-२०", "content_sanskrit": "प्रमत्तो धृतराष्ट्रस्य पुत्रो दुर्योधनस्तदा।\nनाभ्यभाषत्सुबलजं भाषमाणं पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015836, "chapter_id": 1333, "verse_number": "२-७४-२१", "content_sanskrit": "अनेकाग्रं तु तं दृष्ट्वा शकुनिः प्रत्यभाषत।\nदुर्योधन कृतोमूलं निःश्वसन्निव गच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015837, "chapter_id": 1333, "verse_number": "२-७४-२२x", "content_sanskrit": "दुर्योधन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015838, "chapter_id": 1333, "verse_number": "२-७४-२२", "content_sanskrit": "दृष्ट्वेमां पृथिवीं कृत्स्नां युधिष्ठिरवशानुगाम्।\nजितामस्त्रप्रतापेन श्वेताश्वस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015839, "chapter_id": 1333, "verse_number": "२-७४-२३", "content_sanskrit": "तं च यज्ञं तथाभूतं दृष्ट्वा पार्थस्य मातुल।\nयथा शक्रस्य देवेषु तथाभूतं महाद्युतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015840, "chapter_id": 1333, "verse_number": "२-७४-२४", "content_sanskrit": "अमर्षेण तु सम्पूर्णो दह्यमानो दिवानिशम्।\nशुचिशुक्रागमे काले शुष्ये तोयमिवाल्पकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015841, "chapter_id": 1333, "verse_number": "२-७४-२५", "content_sanskrit": "पश्य सात्वतमुख्येन शिशुपालो निपातितः।\nन च तत्र पुमानासीत्कश्चित्तस्य पदानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015842, "chapter_id": 1333, "verse_number": "२-७४-२६", "content_sanskrit": "दह्यमाना हि राजानः पाण्डवोत्थेन वह्निना।\nक्षान्तवन्तोऽपराधं ते को हि तत्क्षन्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015843, "chapter_id": 1333, "verse_number": "२-७४-२७", "content_sanskrit": "वासुदेवेन तत्कर्म यथाऽयुक्तं महत्कृतम्।\nसिद्धं च पाण्डुपुत्राणां प्रतापेन महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015844, "chapter_id": 1333, "verse_number": "२-७४-२८", "content_sanskrit": "तथाहि रत्नन्यादाय विविधानि नृपा नृपम्।\nउपातिष्ठन्त कौन्येयं वैश्या इव करप्रदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015845, "chapter_id": 1333, "verse_number": "२-७४-२९", "content_sanskrit": "श्रियं तथागतं दृष्ट्वा ज्वलन्तीमिव पाण्डवे।\nअमर्षवशमापन्नो दह्यामि न तथोचितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015846, "chapter_id": 1333, "verse_number": "२-७४-३०", "content_sanskrit": "वह्निमेव प्रवेक्ष्यामि भक्षयिष्यामि वा विषम्।\nअपो वापि प्रवेक्ष्यामिन हि शक्ष्यामि जीवितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2015847, "chapter_id": 1333, "verse_number": "२-७४-३१", "content_sanskrit": "को हि नाम पुमांल्लोके मर्षयिष्यति सत्ववान्।\nसपत्नानृद्ध्यतो दृष्ट्वा हीनमात्मानमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2015848, "chapter_id": 1333, "verse_number": "२-७४-३२", "content_sanskrit": "सोऽहं न स्त्री न चाप्यस्त्री न पुमान्नापुमानपि।\nयोऽहं तां मर्षयाम्यद्य तादृशीं श्रियमागताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2015849, "chapter_id": 1333, "verse_number": "२-७४-३३", "content_sanskrit": "ईश्वरत्वं पृथिव्याश्च वसुमत्तां च तादृशीम्।\nयज्ञं च तादृशं दृष्ट्वा मादृशः को न संञ्ज्वरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2015850, "chapter_id": 1333, "verse_number": "२-७४-३४", "content_sanskrit": "अशक्तश्चैक एवाहं तामाहर्तुं नृपश्रियम्।\nसहायांश्च न पश्यामि तेन मृत्युं विचिन्तये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2015851, "chapter_id": 1333, "verse_number": "२-७४-३५", "content_sanskrit": "दैवमेव परं मन्ये पौरुषं च निरर्थकम्।\nदृष्ट्वा कुन्तीसुते शुद्धां श्रियं तामहतां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2015852, "chapter_id": 1333, "verse_number": "२-७४-३६", "content_sanskrit": "कृतो यत्नो मया पूर्वं विनाशे तस्य सौबल।\nतच्च सर्वमतिक्रम्य संवृद्धोऽप्स्विव पङ्गजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2015853, "chapter_id": 1333, "verse_number": "२-७४-३७", "content_sanskrit": "तेन दैवं परं मन्ये पौरुषं च निरर्थकम्।\nधार्तराष्ट्राश्च हीयन्ते पार्था वर्धन्ति नित्यशः। २-७४-३८cकृष्णस्तु सुमनास्तेषां विवर्धयति सम्पदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2015854, "chapter_id": 1333, "verse_number": "२-७४-३८", "content_sanskrit": "सोऽहं श्रियं च तां दृष्ट्वा सभां तां च तथाविधाम्।\nरक्षिभिश्चावहासं तं परितप्ये यथाऽग्निना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2015855, "chapter_id": 1333, "verse_number": "२-७४-३९", "content_sanskrit": "अमर्षं च समाविष्टं धृतराष्ट्रे निवेदय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2015856, "chapter_id": 1333, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि चतुःसप्ततितमोऽध्यायः॥ ७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]