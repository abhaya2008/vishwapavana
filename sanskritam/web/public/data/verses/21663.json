[{"id": 7001663000, "chapter_id": 21663, "verse_number": "१-४९-१", "content_sanskrit": "सनंदन उवाच ।\nनिशम्य तस्येति वचः परमार्थसमन्वितम् ।\nप्रश्रयावनतो भूत्वा तमाह नृपतिर्द्विजम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001663001, "chapter_id": 21663, "verse_number": "१-४९-२", "content_sanskrit": "राजोवाच ।\nभगवन्यत्त्वया प्रोक्त परमार्थमयं वचः ।\nश्रुते तस्मिन्भ्रमंतीव मनसो मम वृत्तयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001663002, "chapter_id": 21663, "verse_number": "१-४९-३", "content_sanskrit": "एतद्विवेकविज्ञानं यदि शेषेषु जंतुषु ।\nभवता दर्शितं विप्र तत्परं प्रकृतेर्महत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001663003, "chapter_id": 21663, "verse_number": "१-४९-४", "content_sanskrit": "नाहं वहामि शिबिकां शिबिका मयि न स्थिता ।\nशरीरमन्यदस्मत्तो येनेयं शिबिका धृता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001663004, "chapter_id": 21663, "verse_number": "१-४९-५", "content_sanskrit": "गुण प्रवृत्तिर्भूतानां प्रवृत्तिः कर्मचोदिता ।\nप्रवर्तंते गुणाश्चैते किं ममेति त्वयोदितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001663005, "chapter_id": 21663, "verse_number": "१-४९-६", "content_sanskrit": "एतस्मिन्परमार्थज्ञ मम श्रोत्रपथं गते ।\nमनो विह्वलतामेति परमार्थार्थतां गतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001663006, "chapter_id": 21663, "verse_number": "१-४९-७", "content_sanskrit": "पूर्वमेव महाभाग कपिलर्षिमहं द्विज ।\nप्रष्टुमभ्युद्यतो गत्वा श्रेयः किंत्वत्र संशये ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001663007, "chapter_id": 21663, "verse_number": "१-४९-८", "content_sanskrit": "तदंतरे च भवता यदिदं वाक्यमीरितम् ।\nतेनैव परमार्थार्थं त्वयि चेतः प्रधावति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001663008, "chapter_id": 21663, "verse_number": "१-४९-९", "content_sanskrit": "कपिलर्षिर्भगवतः सर्वभूतस्य वै किल ।\nविष्णोरंशो जगन्मोहनाशाय समुपागतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001663009, "chapter_id": 21663, "verse_number": "१-४९-१०", "content_sanskrit": "स एव भगवान्नूनमस्माकं हितकाम्यया ।\nप्रत्यक्षतामनुगतस्तथैतद्भवतोच्यते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001663010, "chapter_id": 21663, "verse_number": "१-४९-११", "content_sanskrit": "तन्मह्यं मोहनाशाय यच्छ्रेयः परमं द्विज ।\nतद्वदाखिल विज्ञानजलवीच्युजधिर्भवान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001663011, "chapter_id": 21663, "verse_number": "१-४९-१२", "content_sanskrit": "ब्राह्मण उवाच ।\nभूयः पृच्छसि किं श्रेयः परमार्थेन पृच्छसि ।\nश्रेयांसि परमार्थानि ह्यशेषाण्येन भूपते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001663012, "chapter_id": 21663, "verse_number": "१-४९-१३", "content_sanskrit": "देवताराधनं कृत्वा धनसंपदमिच्छति ।\nपुत्रानिच्छति राज्यं च श्रेयस्तस्यैव तन्नृप ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001663013, "chapter_id": 21663, "verse_number": "१-४९-१४", "content_sanskrit": "विवकिनस्तु संयोगः श्रेयोऽसौ परमात्मना ।\nकर्मयज्ञादिकं श्रेयः स्वर्लोकपलदायि यत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001663014, "chapter_id": 21663, "verse_number": "१-४९-१५", "content_sanskrit": "श्रेयः प्रधानं च फले तदेवानभिसंहिते ।\nआत्मा ध्येयः सदा भूप योगयुक्तैस्तथा परैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001663015, "chapter_id": 21663, "verse_number": "१-४९-१६", "content_sanskrit": "श्रेय स्तस्यैव संयोगः श्रेयो यः परमात्मनः ।\nश्रेयांस्येवमनेकानि शतशोऽथ सहस्त्रशः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001663016, "chapter_id": 21663, "verse_number": "१-४९-१७", "content_sanskrit": "संत्यत्र परमार्थास्तु न त्वेते श्रूयतां च मे ।\nधर्मोऽयं त्यजते किं तु परमार्थो धनं यदि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001663017, "chapter_id": 21663, "verse_number": "१-४९-१८", "content_sanskrit": "व्ययश्चक्रियत कस्मात्कामप्राप्त्युपलक्षणः ।\nमुत्रश्चेत्परमार्थाख्यः सोऽप्यन्यस्य नरेश्वर ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001663018, "chapter_id": 21663, "verse_number": "१-४९-१९", "content_sanskrit": "परमार्थभूतः सोऽन्यस्य परमार्थो हि नः पिता ।\nएवं न परमार्थोऽस्ति जगत्यत्र चराचरे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001663019, "chapter_id": 21663, "verse_number": "१-४९-२०", "content_sanskrit": "परमार्थो हि कार्याणि करणानामशेषतः ।\nराज्यादिप्राप्तिरत्रोक्ता परमार्थतया यदि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001663020, "chapter_id": 21663, "verse_number": "१-४९-२१", "content_sanskrit": "परमार्था भवंत्यत्र न भवंति च वै ततः ।\nऋग्यजुःसामनिष्पाद्यं यज्ञकर्म मतं तव ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001663021, "chapter_id": 21663, "verse_number": "१-४९-२२", "content_sanskrit": "परमार्थभूतं तत्रापि श्रूयतां गदतो मम ।\nयत्तु निष्पाद्यते कार्यं मृदा कारणभूतया ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001663022, "chapter_id": 21663, "verse_number": "१-४९-२३", "content_sanskrit": "तत्कारणानुगमनाज्जायते नृप मृन्मयम् ।\nएवं विनाशिभिर्द्रव्यैः समिदाज्यकुशादिभिः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001663023, "chapter_id": 21663, "verse_number": "१-४९-२४", "content_sanskrit": "निष्पाद्यते क्रिया या तु सा भवित्री विनाशिनी ।\nअनाशी परमार्थस्तु प्राज्ञैरभ्युपगम्यते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001663024, "chapter_id": 21663, "verse_number": "१-४९-२५", "content_sanskrit": "यत्तुं नाशि न संदेहो नाशिद्रव्योपपादितम् ।\nतदेवापलदं कर्म परमार्थो मतो मम ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001663025, "chapter_id": 21663, "verse_number": "१-४९-२६", "content_sanskrit": "मुक्तिसाधनभूतत्वात्परमार्थो न साधनम् ।\nध्यानमेवात्मनो भूपपरमार्थार्थशब्दितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001663026, "chapter_id": 21663, "verse_number": "१-४९-२७", "content_sanskrit": "भेदकारि परेभ्यस्तु परमार्थो न भेदवान् ।\nपरमार्थात्मनोर्योगः परमार्थ इतीष्यते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001663027, "chapter_id": 21663, "verse_number": "१-४९-२८", "content_sanskrit": "मिथ्यैतदन्यद्द्रव्यं हि नैतद्द्रव्यमयं यतः ।\nतस्माच्छ्रेयांस्यशेषाणि नृपैतानि न संशयः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001663028, "chapter_id": 21663, "verse_number": "१-४९-२९", "content_sanskrit": "परमार्थस्तु भूपाल संक्षेपाच्छ्रूयतां मम ।\nएको व्यापी समः शुद्धो निर्गुण प्रकृतेः परः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001663029, "chapter_id": 21663, "verse_number": "१-४९-३०", "content_sanskrit": "जन्मवृद्ध्यादिरहित आत्मा सर्वगतो नृप ।\nपरिज्ञानमयो सद्भिर्नामजात्यादिभिविभुः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001663030, "chapter_id": 21663, "verse_number": "१-४९-३१", "content_sanskrit": "न योगवान्न युक्तोऽभून्नैव पार्थिवः योक्ष्यति ।\nतस्यात्मपरदेहेषु सतोऽप्येकमयं हि तत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001663031, "chapter_id": 21663, "verse_number": "१-४९-३२", "content_sanskrit": "विज्ञानं परमार्थोऽसौ वेत्ति नोऽतथ्यदर्शनः ।\nवेणुरंघ्रविभेदेन भेदः षङ्जादिसंज्ञितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001663032, "chapter_id": 21663, "verse_number": "१-४९-३३", "content_sanskrit": "अभेदो व्यापिनो वायोस्तथा तस्य महात्मनः ।\nएकत्वं रूपभेदश्च वाह्यकर्मप्रवृत्तिजः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001663033, "chapter_id": 21663, "verse_number": "१-४९-३४", "content_sanskrit": "देवादिभेदमध्यास्ते नास्त्येवाचरणो हि सः ।\nश्रृण्वत्र भूप प्राग्वृत्तं यद्गीतमृभुणा भवेत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001663034, "chapter_id": 21663, "verse_number": "१-४९-३५", "content_sanskrit": "अवबोधं जनयतो निदाधस्य द्विजन्मनः ।\nऋभुर्नामाऽबवत्पुत्रो ब्रह्मणः परमेष्टिनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001663035, "chapter_id": 21663, "verse_number": "१-४९-३६", "content_sanskrit": "विज्ञात तत्त्वसद्भावो निसर्गादेव भूपते ।\nतस्य शिष्यो निदाघोऽभूत्पुलस्त्यतनयः पुरा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001663036, "chapter_id": 21663, "verse_number": "१-४९-३७", "content_sanskrit": "प्रादादशेषविज्ञानं स तस्मै परया मुदा ।\nअवाप्तज्ञान तत्त्वस्य न तस्याद्वैतवासना ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001663037, "chapter_id": 21663, "verse_number": "१-४९-३८", "content_sanskrit": "स ऋभुस्तर्कयामास निदाघस्य नरेश्वर ।\nदेविकायास्तटे वीर नागरं नाम वै पुरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001663038, "chapter_id": 21663, "verse_number": "१-४९-३९", "content_sanskrit": "समृद्धमतिरम्यं च पुलस्त्येन निवेशितम् ।\nरम्योपवनपर्यंतं स तस्मिन्पार्थवोत्तम ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001663039, "chapter_id": 21663, "verse_number": "१-४९-४०", "content_sanskrit": "निदाधनामायोगज्ञस्तस्य शिष्योऽभवत्पुरा ।\nदिव्ये वर्षसहस्त्रे तु समतीतेऽस्य तत्पुरम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001663040, "chapter_id": 21663, "verse_number": "१-४९-४१", "content_sanskrit": "जगाम स ऋभुः शिष्यं निदाघमवलोकितुम् ।\nस तस्य वैश्वदेवंति द्वारालोकनगोचरः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001663041, "chapter_id": 21663, "verse_number": "१-४९-४२", "content_sanskrit": "स्थित स्तेन गृहीतार्थो निजवेश्म प्रवेशितः ।\nप्रक्षालितांघ्रिपाणिं च कृतासनपरिग्रहम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001663042, "chapter_id": 21663, "verse_number": "१-४९-४३", "content_sanskrit": "उवाच स द्विजश्रेष्टो भुज्यतामिति सादरम् ।\nऋभुरुवाच ।\nभो विप्रवर्य भोक्तव्यं यदत्र भवतो गृहे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001663043, "chapter_id": 21663, "verse_number": "१-४९-४४", "content_sanskrit": "तत्कथ्यतां कदन्नेषु न प्रीतिः सततं मम ।\nनिदाघ उवाच ।\nसक्तुयावकव्रीहीनामपूपानां च मे गृहे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001663044, "chapter_id": 21663, "verse_number": "१-४९-४५", "content_sanskrit": "यद्रोचते द्विजश्रेष्ट तावद्भुंक्ष्व यथेच्छया ।\nऋभुरुवाच ।\nकदन्नानि दिजैतानि मिष्टमन्नं प्रयच्छ मे ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001663045, "chapter_id": 21663, "verse_number": "१-४९-४६", "content_sanskrit": "संयावपायसादीनि चेक्षुका रसवंति च ।\nनिदाघ उवाच ।\nगृहे शालिनि मद्गेहे यत्किंचिदति शोभनम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001663046, "chapter_id": 21663, "verse_number": "१-४९-४७", "content_sanskrit": "भोज्येषु साधनं मिष्टं तेनास्यान्नं प्रसाधय ।\nइत्युक्ता तेन सा पत्नी मिष्टमन्नं द्विजस्य तत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001663047, "chapter_id": 21663, "verse_number": "१-४९-४८", "content_sanskrit": "प्रसाधितवती तद्वै भर्तुर्वचनगौरवात् ।\nन भुक्तवंतमिच्छातो मिष्टमन्नं महामुनिम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001663048, "chapter_id": 21663, "verse_number": "१-४९-४९", "content_sanskrit": "निदाघः प्राहभूपाल प्रश्रयावनतः स्थितः ।\nनिदाघ उवाच ।\nअपि ते परमा तृप्तिरुत्पन्ना पुष्टिरेव ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001663049, "chapter_id": 21663, "verse_number": "१-४९-५०", "content_sanskrit": "अपि ते मानसं स्वस्थमाहारेण कृतं द्विज ।\nक्व निवासी भवान्विप्र क्व वा गंतुं समुद्यतः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001663050, "chapter_id": 21663, "verse_number": "१-४९-५१", "content_sanskrit": "आगम्यते च भवता यतस्तश्च निवेद्यताम् ।\nऋमुरुवाच ।\nक्षुधितस्य च भुक्तेऽन्ने तृप्तिर्ब्रह्मन्विजायते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001663051, "chapter_id": 21663, "verse_number": "१-४९-५२", "content_sanskrit": "न मे क्षुधा भवेत्तॄप्तिः कस्मान्मां द्विज पृच्छति ।\nवह्निना पार्थिवेनादौ दग्धे वै क्षुरापीश्वः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001663052, "chapter_id": 21663, "verse_number": "१-४९-५३", "content_sanskrit": "भवत्यंभसि च क्षीणे नृणां तृष्णासमुद्भवः ।\nक्षुत्तृष्णे देहधर्माख्ये न ममैते यतो द्विज ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001663053, "chapter_id": 21663, "verse_number": "१-४९-५४", "content_sanskrit": "ततः क्षुत्संभवाभावात्तृप्तिरस्त्येव मे सदा ।\nमनसः स्वस्थता तुष्टिश्चित्तधर्माविमौ द्विज ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001663054, "chapter_id": 21663, "verse_number": "१-४९-५५", "content_sanskrit": "चेतसो यस्य यत्पृष्टं पुमानेभिर्न युज्यते ।\nक्व निवासस्तवेत्युक्तं क्व गंतासि च यत्त्वया ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001663055, "chapter_id": 21663, "verse_number": "१-४९-५६", "content_sanskrit": "कुतश्चागम्यते त्वेतात्र्रितयेऽपि निबोध मे ।\nपुमान्सवर्गतो व्यापीत्याकाशवदयं यतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001663056, "chapter_id": 21663, "verse_number": "१-४९-५७", "content_sanskrit": "कुतः कुत्र क्व गंतासीत्येतदप्यर्थवत्कथम् ।\nसोऽहं गंता न चागंता नैकदेशनिकेतनः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001663057, "chapter_id": 21663, "verse_number": "१-४९-५८", "content_sanskrit": "त्वं चान्ये च न च त्वं त्वं नान्ये नैवाहमप्यहम् ।\nमिष्टन्ने मिष्टमित्येषा जिह्वा सा मे कृता तव ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001663058, "chapter_id": 21663, "verse_number": "१-४९-५९", "content_sanskrit": "किं वक्ष्यतीति तत्रापि श्रूयतां द्विजसत्तमा ।\nमिष्टमेव यदामिष्टं तदेवोद्वेगकारणम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001663059, "chapter_id": 21663, "verse_number": "१-४९-६०", "content_sanskrit": "अमिष्टं जायते मिष्टं मिष्टादुद्विजते जनः ।\nआदिमध्यावसानेषु किमन्नं रुचिकारणम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001663060, "chapter_id": 21663, "verse_number": "१-४९-६१", "content_sanskrit": "मृण्मयं हि मृदा यद्वद्गृहं लिप्तं स्थिरीभवेत् ।\nपार्थिवोऽयं तथा देहः पार्थिवैः परमाणुभिः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001663061, "chapter_id": 21663, "verse_number": "१-४९-६२", "content_sanskrit": "यवगोधूममुद्गादि र्घृतं तैलं पयो दधि ।\nगुडः फलानीति तथा पार्थिवाः परमाणवः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001663062, "chapter_id": 21663, "verse_number": "१-४९-६३", "content_sanskrit": "तदेतद्भवता ज्ञात्वा मिष्टामिष्टविचारि यत् ।\nतन्मनः शमनालबि कार्यं प्राप्यं हि मुक्तये ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001663063, "chapter_id": 21663, "verse_number": "१-४९-६४", "content_sanskrit": "इत्याकर्ण्य वचस्तस्य परमार्थाश्रितं नृप ।\nप्रणिपत्य महाभागो निदाघो वाक्यमब्रवीत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001663064, "chapter_id": 21663, "verse_number": "१-४९-६५", "content_sanskrit": "प्रसीद मद्धितार्थाय कथ्यतां यस्त्वमागतः ।\nनष्टो मोहस्तवाकर्ण्य वचांस्येतानि मे द्विज ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001663065, "chapter_id": 21663, "verse_number": "१-४९-६६", "content_sanskrit": "ऋभुरुवाच ।\nऋभुरस्मि तवाचार्यः प्रज्ञादानाय ते द्विज ।\nइहागतोऽहं दास्यामि परमार्थं सुबोधितम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001663066, "chapter_id": 21663, "verse_number": "१-४९-६७", "content_sanskrit": "एक एवमिदं विद्धि न भेदि सकलं जगत् ।\nवासुदेवाभिधेयस्य स्वरुपं परात्मनः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001663067, "chapter_id": 21663, "verse_number": "१-४९-६८", "content_sanskrit": "ब्रह्मण उवाच ।\nतथेत्युक्त्वा निदाधेन प्रणिपातपुरः सरम् ।\nपूजितः परया भक्त्यानिच्छितः प्रययौ विभुः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001663068, "chapter_id": 21663, "verse_number": "१-४९-६९", "content_sanskrit": "पुनवर्षसहस्त्रंते समायातो नरेश्वर ।\nनिदाघज्ञानदानाय तदेव नगरं गुरुः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001663069, "chapter_id": 21663, "verse_number": "१-४९-७०", "content_sanskrit": "नगरस्य बहिः सोऽथ निदाघं दृष्टवान् मुनिम् ।\nमहाबलपरीवारे पुरं विशति पार्थिवे ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001663070, "chapter_id": 21663, "verse_number": "१-४९-७१", "content_sanskrit": "दूरस्थितं महाभागे जनसंमर्दवर्जकम् ।\nक्षुत्क्षामकण्ठमायांतमरण्यात्ससमित्कुशम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001663071, "chapter_id": 21663, "verse_number": "१-४९-७२", "content_sanskrit": "दृष्ट्वा निदाघं स ऋभुरुपागत्याभिवाद्य च ।\nउवाच कस्मादेकांतं स्थीयत भवता द्विज ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001663072, "chapter_id": 21663, "verse_number": "१-४९-७३", "content_sanskrit": "निदाघ उवाच ।\nभो विप्र जनसंमर्द्दो महानेष जनेश्वरे ।\nप्रविवक्षौ पुरे रम्ये तेनात्र स्थीयते मया ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001663073, "chapter_id": 21663, "verse_number": "१-४९-७४", "content_sanskrit": "ऋभुरुवाच ।\nनराधिपोऽत्र कतमः कतमश्चेतरो जनः ।\nकथ्यतां मे द्विजश्रेष्ट त्वमभिज्ञो मतो मम ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001663074, "chapter_id": 21663, "verse_number": "१-४९-७५", "content_sanskrit": "निदाघ उवाच ।\nयोऽयं गजेंद्रमुन्मत्तमद्रिश्रृंगसमुच्छ्रयम् ।\nअधिरुढो नरेन्द्रोऽयं परितो यस्तथेतरः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001663075, "chapter_id": 21663, "verse_number": "१-४९-७६", "content_sanskrit": "ऋभुरुवाच ।\nएतौ हि गजराजानौ दृष्टौ हि युगपन्मया ।\nभवता निर्विशेषेण पृथग्वेदोपलक्षितौ ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001663076, "chapter_id": 21663, "verse_number": "१-४९-७७", "content_sanskrit": "तत्कथ्यतां महाभाग विशेषो भवतानयोः ।\nज्ञातुमिच्छाम्यहं कोऽत्र गजः को वा नराधिपः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001663077, "chapter_id": 21663, "verse_number": "१-४९-७८", "content_sanskrit": "निदाध उवाच ।\nगजोयोऽयमधो ब्रह्मन्नुपर्यस्यैष भूपतिः ।\nवाह्यवाहकसंबंधं को न जानाति वै द्विज ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001663078, "chapter_id": 21663, "verse_number": "१-४९-७९", "content_sanskrit": "ऋभुरुवाच ।\nब्रह्मन्यथाहं जानीयां तथा मामवबोधय ।\nअधः सत्त्वविभागं किं किं चोर्द्धमभिधीयते ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001663079, "chapter_id": 21663, "verse_number": "१-४९-८०", "content_sanskrit": "ब्राह्मण उवाच ।\nइत्युक्त्वा सहसारुह्य निदाघः प्राह तं ऋभुम् ।\nश्रयतां कथयाम्येष यन्मां त्वं परिपृच्छसि ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001663080, "chapter_id": 21663, "verse_number": "१-४९-८१", "content_sanskrit": "उपर्यहं यथा राजा त्वमधःकुंजरो यथा ।\nअवबोधाय ते ब्रह्मन्दृष्टांतो दर्शितो मया ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001663081, "chapter_id": 21663, "verse_number": "१-४९-८२", "content_sanskrit": "ऋभुरुवाच ।\nत्वं राजेव द्विजश्रेष्ट स्थितोऽहं गजवद्यदि ।\nतदेवं त्वं समाचक्ष्व कतमस्त्वमहं तथा ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001663082, "chapter_id": 21663, "verse_number": "१-४९-८३", "content_sanskrit": "ब्राह्मण उवाच ।\nइत्युक्तः सत्वरस्तस्य चरणावभिवंद्य सः ।\nनिदाधः प्राह भगवन्नाचार्यस्त्वमृभुर्मम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001663083, "chapter_id": 21663, "verse_number": "१-४९-८४", "content_sanskrit": "नान्यस्याद्वैतसंस्कारसंस्कृतं मानसं तथा ।\nयथाचार्यस्य तेन त्वां मन्ये प्राप्तमहं गुरुम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001663084, "chapter_id": 21663, "verse_number": "१-४९-८५", "content_sanskrit": "ऋभुरुवाच ।\nतवोपदेशदानाय पूर्वशुश्रूषणात्तव ।\nगुरुस्नेहादृभुर्नामनिदाघं समुपागतः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001663085, "chapter_id": 21663, "verse_number": "१-४९-८६", "content_sanskrit": "तदेतदुपदिष्टं ते संक्षेपेण महामते ।\nपरमार्थसारभूतं यत्तदद्वैतमशेषतः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001663086, "chapter_id": 21663, "verse_number": "१-४९-८७", "content_sanskrit": "ब्राह्मण उवाच ।\nएवमुक्त्वा ददौ विद्यां निदाघं स ऋभुर्गुरुः ।\nनिदाघोऽप्युपदेशेन तेनाद्वैतपरोऽभवत् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001663087, "chapter_id": 21663, "verse_number": "१-४९-८८", "content_sanskrit": "सर्वभूतान्यभेदेन ददृशे स तदात्मनः ।\nतथा ब्रह्मतनौ मुक्तिमवाच परमाद्विजः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001663088, "chapter_id": 21663, "verse_number": "१-४९-८९", "content_sanskrit": "तथा त्वमपि धर्मज्ञ तुल्यात्मरिपुबांधवः ।\nभव सर्वगतं ज्ञानमात्मानमवनीपते ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001663089, "chapter_id": 21663, "verse_number": "१-४९-९०", "content_sanskrit": "सितनीलादिभेदेन यथैकं दृश्यते नभः ।\nभ्रांतदृष्टिभिरात्मापि तथैकः सन्पृथक् पृथक् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001663090, "chapter_id": 21663, "verse_number": "१-४९-९१", "content_sanskrit": "एकः समस्तं यदिहास्ति किंचित्तदच्युतो नास्ति परं ततोऽन्यत् ।\nसोऽहं स च त्वं स च सर्वमेतदात्मांस्वयं भात्यपभेदमोहः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001663091, "chapter_id": 21663, "verse_number": "१-४९-९२", "content_sanskrit": "सनंदन उवाच ।\nइतीरितस्तेन स राजवर्यस्तत्याज भेदं परमार्थदृष्टिः ।\nस चापि जातिस्मरणावबोदस्तत्रैव जन्मन्यपवर्गमाप ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001663092, "chapter_id": 21663, "verse_number": "१-४९-९३", "content_sanskrit": "परमार्थाध्यात्ममेतत्तुभ्यमुक्तं मुनीश्वर ।\nब्राह्मणक्षत्रियविशां श्रोर्तॄणां चापि मुक्तिदम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001663093, "chapter_id": 21663, "verse_number": "१-४९-९४", "content_sanskrit": "यथा पृष्टं त्वया ब्रह्मंस्तथा ते गदितं मया ।\nब्रह्मज्ञानमिदं शुद्धं किमन्यत्कथयामि वै ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]