[{"id": 2020580, "chapter_id": 1431, "verse_number": "३-६९-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020581, "chapter_id": 1431, "verse_number": "३-६९-१", "content_sanskrit": "श्रुत्वा वचः सुदेवस्य ऋतुपर्णो नराधिपः।\n`सारथीन्स समानीय वार्ष्णेयप्रभृतीन्नृपः।\nकथयामास यद्वृत्तं ब्राह्मणेन श्रुतं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020582, "chapter_id": 1431, "verse_number": "३-६९-२", "content_sanskrit": "बाहुकं च समाहूय दमयन्त्याः स्वयंवरम्।\nसान्त्यञ्श्र्लक्ष्णया वाचा बाहुकं प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020583, "chapter_id": 1431, "verse_number": "३-६९-३", "content_sanskrit": "विदर्भान्यातुमिच्छामि दमयन्त्याः स्वयंवरम्।\nएकाह्ना हयतत्त्वज्ञ मन्यसे यदि बाहुक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020584, "chapter_id": 1431, "verse_number": "३-६९-४", "content_sanskrit": "एवमुक्तस्य कौन्तेय तेन राज्ञा नलस्य ह।\nव्यदीर्यत मनो दुःखात्प्रदध्यौ च महामनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020585, "chapter_id": 1431, "verse_number": "३-६९-५", "content_sanskrit": "दमयन्ती भवेदेवं किंनु दुःखेन मोहिता।\nअस्मदर्थे भवेद्बाऽयमुपायश्चिन्तितो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020586, "chapter_id": 1431, "verse_number": "३-६९-६", "content_sanskrit": "नृशंसं बत वैदर्भी कर्तुकामा तपस्विनी।\nयया क्षुद्रेण निकृताकृपणा पापबुद्धिना।\nस्त्रीस्वभावश्चलो लोके मम दोषश्च दारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020587, "chapter_id": 1431, "verse_number": "३-६९-७", "content_sanskrit": "मम शोकेन संविग्ना नैराश्यात्तनुमध्यमा।\nनैवं सा कर्हिचित्कुर्यात्सापत्या च विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020588, "chapter_id": 1431, "verse_number": "३-६९-८", "content_sanskrit": "यदत्र सत्यं वाऽसत्यं गत्वा वेत्स्यामि निश्चयम्।\nऋतुपर्णस्य वै काममात्मार्थं च करोम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020589, "chapter_id": 1431, "verse_number": "३-६९-९", "content_sanskrit": "इति निश्चित्य मनसा बाहुको दीनमानसः।\nकृतालुरुवाचेदमृतुपर्णं जनाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020590, "chapter_id": 1431, "verse_number": "३-६९-१०", "content_sanskrit": "प्रतिजानामि ते वाक्यं गमिष्यामि नराधिप।\nएकाह्ना पुरुषव्याघ्र विदर्भनगरीं नृप।\n`तत्रादित्योदये काले श्वो विदर्भान्गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020591, "chapter_id": 1431, "verse_number": "३-६९-११", "content_sanskrit": "एवमुक्तोऽब्रवीद्राजा बाहुकं प्रहसन्निव।\nकिं ते कामं करोम्यद्य तुष्टोऽस्मि तव बाहुक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020592, "chapter_id": 1431, "verse_number": "३-६९-१२x", "content_sanskrit": "बाहुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020593, "chapter_id": 1431, "verse_number": "३-६९-१२", "content_sanskrit": "यावद्यानमिदं सज्जमृतुपर्ण करोम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020594, "chapter_id": 1431, "verse_number": "३-६९-१३", "content_sanskrit": "ततः परीक्षामश्वानां चक्रे राजन्स बाहुकः।\nअश्वशालामुपागम्य भागस्वरिनृपाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020595, "chapter_id": 1431, "verse_number": "३-६९-१४", "content_sanskrit": "स त्वर्यमाणो बहुश ऋतुपर्णन बाहुकः।\nअश्वाञ्जिज्ञासमानो वै विचार्य च पुनःपुनः।\nअध्यगच्छत्कृशानश्वान्समर्थानध्वनि क्षमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020596, "chapter_id": 1431, "verse_number": "३-६९-१५", "content_sanskrit": "तेजोबलसमायुक्तान्कुलशीलसमन्वितान्।\nवर्जिताँल्लक्षणैर्हीनैः पृथुप्रोथान्महाहनून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020597, "chapter_id": 1431, "verse_number": "३-६९-१६", "content_sanskrit": "शुद्धान्दशभिरावर्तैः सिन्धुजान्वातरंहसः।\n`दृश्यमानान्कृशानङ्गैर्जवेनाप्रतिमान्पथि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020598, "chapter_id": 1431, "verse_number": "३-६९-१७", "content_sanskrit": "तान्दृष्ट्वा दुर्बलान्नाजा प्राह कोपसमन्वितः।\nकिमिदं प्रार्थितं कर्तुं प्रलब्धव्या न ते वचम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020599, "chapter_id": 1431, "verse_number": "३-६९-१८", "content_sanskrit": "कथमल्पबलप्राणा वक्ष्यन्तीमे हया रथम्।\nमहानध्वा स चैकाह्ना गन्तव्यः कथमीदृशैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020600, "chapter_id": 1431, "verse_number": "३-६९-१९x", "content_sanskrit": "बाहुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020601, "chapter_id": 1431, "verse_number": "३-६९-१९", "content_sanskrit": "[एको ललाटे द्वे मूर्ध्नि द्वौद्वौ पार्श्वोपपार्श्वयोः।\nद्वौद्वौ वक्षसि विज्ञैर्यौ प्रयाणे चैक एव तु ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020602, "chapter_id": 1431, "verse_number": "३-६९-२०", "content_sanskrit": "एते हया गमिष्यन्ति विदर्भान्नात्र संशयः।\nयानन्यान्मन्यसे राजन्ब्रूहि तान्योजयामिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020603, "chapter_id": 1431, "verse_number": "३-६९-२१x", "content_sanskrit": "ऋतुपर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020604, "chapter_id": 1431, "verse_number": "३-६९-२१", "content_sanskrit": "त्वमेव हयतत्त्वज्ञः कुशलो ह्यसि बाहुक।\nयान्मन्यसे समर्थास्त्वं क्षिप्रं तानेव योजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020605, "chapter_id": 1431, "verse_number": "३-६९-२२", "content_sanskrit": "ततः सदश्वांश्चतुरः कुलशीलसमन्वितान्।\nयोजयामास कुशलो जवयुक्तान्रथे नलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020606, "chapter_id": 1431, "verse_number": "३-६९-२३", "content_sanskrit": "ततो युक्तं रथं राजा समारोहत्त्वरान्वितः।\nअथ पर्यपतन्भूमौ जानुभिस्ते हयोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020607, "chapter_id": 1431, "verse_number": "३-६९-२४", "content_sanskrit": "ततो नरवरः श्रीमान्नलो राजा विशांपते।\nसान्त्वयामास तानश्वांस्तेजोबलसमन्वितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2020608, "chapter_id": 1431, "verse_number": "३-६९-२५", "content_sanskrit": "रश्मिभिश्च समुद्यम्य नलो यातुमियेष सः।\nसूतमारोप्य वार्ष्णेयं जवमास्थाय वै परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2020609, "chapter_id": 1431, "verse_number": "३-६९-२६", "content_sanskrit": "ते चोद्यमाना विधिवद्बाहुकेन हयोत्तमाः।\nसमुत्पेतुरिवाकाशं रथिनं मोहयन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2020610, "chapter_id": 1431, "verse_number": "३-६९-२७", "content_sanskrit": "तथा तु दृष्ट्वा तानश्वान्वहतो वातरंहसः।\nअयोध्याधिपतिः श्रीमान्विस्मयं परमं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2020611, "chapter_id": 1431, "verse_number": "३-६९-२८", "content_sanskrit": "रथघोषं तु तं श्रुत्वा हयसंग्रहणं च तत्।\nवार्ष्णेयश्चिन्तयामास बाहुकस्य हयज्ञताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2020612, "chapter_id": 1431, "verse_number": "३-६९-२९", "content_sanskrit": "किंनु स्यान्मातलिरयं देवराजस्य सारथिः।\nतथा तल्लक्षणं वीरे बाहुके दृश्यते महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2020613, "chapter_id": 1431, "verse_number": "३-६९-३०", "content_sanskrit": "शालिहोत्रोऽथ किंतु स्याद्धयानां कुलतत्त्ववित्।\nमानुपं समनुप्राप्तो वपुः परमशोभनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2020614, "chapter_id": 1431, "verse_number": "३-६९-३१", "content_sanskrit": "उताहोस्विद्भवेद्राजा नलः परपुरंजयः।\nसोयं नृपतिरायात इत्येवं समचिन्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2020615, "chapter_id": 1431, "verse_number": "३-६९-३२", "content_sanskrit": "अथवाऽयंनलात्प्राप्तो विद्यां तामेव बाहुकः।\nतुल्यं हि लक्षये ज्ञानं बाहुकस्य नलस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2020616, "chapter_id": 1431, "verse_number": "३-६९-३३", "content_sanskrit": "अपिचेदं वयस्तुल्यं बाहुकस्य नलस्य च।\nनायं नलो महावीर्यस्तद्विद्यश्च भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2020617, "chapter_id": 1431, "verse_number": "३-६९-३४", "content_sanskrit": "प्रच्छन्ना हि महात्मानश्चरन्ति पृथिवीमिमाम्।\nदैवेन विधिना युक्ताः शास्त्रोक्तैश्च निरूपणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2020618, "chapter_id": 1431, "verse_number": "३-६९-३५", "content_sanskrit": "भवेन्न मतिभेदो मे गात्रवैरूप्यता प्रति।\nप्रमाणात्परिहीनस्तु भवेदिति मतिर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2020619, "chapter_id": 1431, "verse_number": "३-६९-३६", "content_sanskrit": "वयःप्रमाणं तत्तुल्यं रूपेण तु विपर्ययः।\nनलं सर्वगुणैर्युक्तं मन्ये बाहुकमन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2020620, "chapter_id": 1431, "verse_number": "३-६९-३७", "content_sanskrit": "एवं विचार्य बहुशो वार्ष्णोयः पर्यचिन्तयत्।\nहृदयेन महाराज पुण्यश्लोकस्य सारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2020621, "chapter_id": 1431, "verse_number": "३-६९-३८", "content_sanskrit": "ऋतुपर्णश्च राजेनद्रो बाहुकस्य हयज्ञताम्।\nचिन्तयन्मुमुदे राजा सहवार्ष्णेयसारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2020622, "chapter_id": 1431, "verse_number": "३-६९-३९", "content_sanskrit": "ऐकाग्र्यं च तथोत्साहं हयसंग्रहणं च तत्।\nकौशलं चापि संप्रेक्ष्य परां सुदमवाप ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2020623, "chapter_id": 1431, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि एकोनसप्ततितमोऽध्यायः ॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]