[{"id": 2030010, "chapter_id": 1656, "verse_number": "३-२९४-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030011, "chapter_id": 1656, "verse_number": "३-२९४-१", "content_sanskrit": "नात्मानमनुशोचामि नेमान्भ्रातॄन्महामुने।\nहरणं चापि राज्यस् यथेमां द्रुपदात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030012, "chapter_id": 1656, "verse_number": "३-२९४-२", "content_sanskrit": "द्यूते दुरात्मभिः क्लिष्टाः कृष्णया तारिता वयम्।\nजयद्रथेन चपुनर्वनाच्चापि हृता बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030013, "chapter_id": 1656, "verse_number": "३-२९४-३", "content_sanskrit": "अस्ति सीमन्तिनी काचिद्दृष्टपूर्वाऽपिवा श्रुता।\nपतिव्रता महाभागा यथेयं द्रुपदात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030014, "chapter_id": 1656, "verse_number": "३-२९४-४x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030015, "chapter_id": 1656, "verse_number": "३-२९४-४", "content_sanskrit": "शृणु राजन्कुलस्त्रीणां महाभाग्यं युधिष्ठिर।\nसर्वमेतद्यथाप्राप्तं सावित्र्या राजकन्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030016, "chapter_id": 1656, "verse_number": "३-२९४-५", "content_sanskrit": "आसीन्मद्रेषु धर्मात्मा राजा परमधार्मिकः।\nब्रह्मण्यश्चमहात्मा च सत्यसन्धो जितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030017, "chapter_id": 1656, "verse_number": "३-२९४-६", "content_sanskrit": "यज्वा दानपतिर्दक्षः पौरजानपदप्रियः।\nपार्थिवोऽश्वपतिर्नाम सर्वभूतहिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030018, "chapter_id": 1656, "verse_number": "३-२९४-७", "content_sanskrit": "क्षमावाननपत्यश्च सत्यवाग्विजितेन्द्रियः।\nअतिक्रान्तेन वयसा संतापमुपजग्मिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030019, "chapter_id": 1656, "verse_number": "३-२९४-८", "content_sanskrit": "अपत्योत्पादनार्थं च तीव्रं नियममास्थितः।\nकाले परिमिताहारो ब्रहमचारी जितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030020, "chapter_id": 1656, "verse_number": "३-२९४-९", "content_sanskrit": "हुत्वा शतसहस्रं स सावित्र्या राजसत्तम।\nषष्ठेषष्ठे तदाकाले बभूव मितमोजनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030021, "chapter_id": 1656, "verse_number": "३-२९४-१०", "content_sanskrit": "एतेन नियमेनासीद्वर्षाण्यष्टादशैव तु।\nपूर्णे त्वष्टादशे वर्षे सावित्री तुष्टिमभ्यगात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030022, "chapter_id": 1656, "verse_number": "३-२९४-११", "content_sanskrit": "रूपिणी तु तदा राजन्दर्शयामास तं नृपम्।\nअग्निहोत्रात्समुत्थाय हर्षेण महताऽन्विता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030023, "chapter_id": 1656, "verse_number": "३-२९४-१२", "content_sanskrit": "उवाच चैनं वरदा वचनं पार्थिवं तदा।\nसा तमश्वपतिं राजन्सावित्री नियमे स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030024, "chapter_id": 1656, "verse_number": "३-२९४-१३", "content_sanskrit": "ब्रह्मचर्येण शुद्धेन दमेन नियमेन रच।\nसर्वात्मना च भक्त्या च तुष्टाऽस्मि तव पार्थिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030025, "chapter_id": 1656, "verse_number": "३-२९४-१४", "content_sanskrit": "वरं वृणीष्वाश्वपते मद्रराज यदीप्सितम्।\nन प्रामादश्च धर्मेषु कर्तव्यस्ते कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030026, "chapter_id": 1656, "verse_number": "३-२९४-१५x", "content_sanskrit": "अश्वपतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030027, "chapter_id": 1656, "verse_number": "३-२९४-१५", "content_sanskrit": "अपत्यार्थः समारम्भः कृतो धर्मेप्सया मया।\nपुत्रा मे बहवो देवि भवेयुः कुलभावनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030028, "chapter_id": 1656, "verse_number": "३-२९४-१६", "content_sanskrit": "तुष्टाऽसि यदि मे देवि वरमेतं वृणोम्यहम्।\nसंतां परमो धर्म इत्याहुर्मां द्विजातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030029, "chapter_id": 1656, "verse_number": "३-२९४-१७x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030030, "chapter_id": 1656, "verse_number": "३-२९४-१७", "content_sanskrit": "पूर्वमेव मया राजन्नभिप्रायमिमं तव।\nज्ञात्वा पुत्रार्थमुक्तो वै भगवांस्ते पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030031, "chapter_id": 1656, "verse_number": "३-२९४-१८", "content_sanskrit": "प्रसादाच्चैव तस्मात्ते स्वयं विहितवत्यहम्।\nकन्या तेजस्विनी सौम्य क्षिप्रमेव भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2030032, "chapter_id": 1656, "verse_number": "३-२९४-१९", "content_sanskrit": "उत्तरं च न ते किंचिद्व्याहर्तव्यं कथंचन।\nपितामहनियोगेन तुष्टा ह्येतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2030033, "chapter_id": 1656, "verse_number": "३-२९४-२०", "content_sanskrit": "स तथेति प्रतिज्ञाय सावित्र्या वचनं नृपः।\nप्रसादयामास पुनः क्षिप्रमेतद्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2030034, "chapter_id": 1656, "verse_number": "३-२९४-२१", "content_sanskrit": "अन्तर्हितायां सावित्र्यां जगाम स्वपुरं नृपः।\nस्वराज्ये चावसद्बीरः प्रजा धर्मेण पालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2030035, "chapter_id": 1656, "verse_number": "३-२९४-२२", "content_sanskrit": "कस्मिंश्चित्तु गते काले स राजा नियतब्रतः।\nज्येष्ठायां धर्मचारिण्यां महिष्यां कगर्भमादधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2030036, "chapter_id": 1656, "verse_number": "३-२९४-२३", "content_sanskrit": "राजपुत्र्यास्तु गर्भः स मानव्या भरतर्षभ।\nव्यर्धतं तदा शुक्ले तारापतिरिवाम्बरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2030037, "chapter_id": 1656, "verse_number": "३-२९४-२४", "content_sanskrit": "प्राप्ते काले तु सुषुवे कन्यां राजीवलोचनाम्।\nक्रियाश्च तस्या मुदितश्चक्रे च नृपसत्तमः ॥ ३-२९४-२५aसावित्र्या प्रीतया दत्ता साव्त्र्या द्दुतया ह्यपि।\nसावित्रीत्येव नामास्याश्चक्रुर्विप्रास्तथा पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2030038, "chapter_id": 1656, "verse_number": "३-२९४-२६", "content_sanskrit": "सा विग्रहवतीव श्रीव्यवर्धत नृपात्मजा।\nकालेन चापि सा कन्या यौवनस्ता बभूव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2030039, "chapter_id": 1656, "verse_number": "३-२९४-२७", "content_sanskrit": "तां सुमध्यां पृथुश्रोणीं प्रतिमां काञ्चनीमिव।\nप्राप्तेयं रदेवकन्येति दृष्ट्वा संमेनिरे जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2030040, "chapter_id": 1656, "verse_number": "३-२९४-२८", "content_sanskrit": "तां तु पद्मपलाशाक्षीं ज्वलन्तीमिव तेजसा।\nन कश्चिद्वरयामास तेजसा प्रतिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2030041, "chapter_id": 1656, "verse_number": "३-२९४-२९", "content_sanskrit": "अथोपोष्य शिरःस्नाता देवतामभिगम्य सा।\nहुत्वाग्निं विधिवद्विप्रान्वाचयामास पर्वणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2030042, "chapter_id": 1656, "verse_number": "३-२९४-२०", "content_sanskrit": "ततः सुमनसः शेषाः प्रतिगृह्य महात्मनः।\nपितुः समीपमगमद्देवी श्रीरिव रूपिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2030043, "chapter_id": 1656, "verse_number": "३-२९४-३१", "content_sanskrit": "साऽभिवाद्य पितुः पादौ शेषाः पूर्वं निवेद्य च।\nकृताञ्जलिर्वरारोहा नृपतेः पार्श्वमास्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2030044, "chapter_id": 1656, "verse_number": "३-२९४-३२", "content_sanskrit": "यौवनस्थां तु तां दृष्ट्वा स्वां सुतां देवरूपिणीम्।\nअयाच्यमानां च वरैर्नृपतिर्दुःखितोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2030045, "chapter_id": 1656, "verse_number": "३-२९४-३३x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2030046, "chapter_id": 1656, "verse_number": "३-२९४-३३", "content_sanskrit": "पुत्रि प्रदानकालस्ते न च कश्चिद्वृणोति माम्।\nस्वयमन्विच्छ भर्तारं गुणैः सदृशमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2030047, "chapter_id": 1656, "verse_number": "३-२९४-३४", "content_sanskrit": "प्रार्थितः पुरुषो यश्च स निवेद्यस्त्वया मम।\nविमृश्याहं प्रदास्यामि वरय त्वं यथेप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2030048, "chapter_id": 1656, "verse_number": "३-२९४-३५", "content_sanskrit": "श्रुतं हि धर्मशास्त्रेषु पठ्यमानं द्विजातिभिः।\nतथा त्वमपिकल्याणि गदतो मे वचः शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2030049, "chapter_id": 1656, "verse_number": "३-२९४-३६", "content_sanskrit": "अप्रदाता पिता वाच्यो वाच्यश्चानुपयन्पतिः।\nमृते पितरि पुत्रश्च वाच्यो मातुररक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2030050, "chapter_id": 1656, "verse_number": "३-२९४-३७", "content_sanskrit": "इदं मे वचनं क्षुत्वा भर्तुरन्वेषणे न्वर।\nदेवतानां यथा याच्यो न भवेयं तथा कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2030051, "chapter_id": 1656, "verse_number": "३-२९४-३८", "content_sanskrit": "एवमुक्त्वा दुहितरं तथा वृद्धांश्च मन्त्रिणः।\nव्यादिदेशानुयात्रं च गम्यतां चेत्यचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2030052, "chapter_id": 1656, "verse_number": "३-२९४-३९", "content_sanskrit": "साऽभिवाद्य पितुः पादौ व्रीडितेव मनस्विनी।\nपितुर्वचनमाज्ञाय निर्जगामाविचारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2030053, "chapter_id": 1656, "verse_number": "३-२९४-४०", "content_sanskrit": "सा हैमं रथमास्थाय स्थविरैः सचिवैर्वृता।\nतपोवनानिरम्याणि राजर्षीणां जगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2030054, "chapter_id": 1656, "verse_number": "३-२९४-४१", "content_sanskrit": "मान्यानां तत्र वृद्धानां कृत्वा पादाभिवादनम्।\nवनानि क्रमशस्तात सर्वाण्येवाभ्यगच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2030055, "chapter_id": 1656, "verse_number": "३-२९४-४२", "content_sanskrit": "एवं तीर्थेषु सर्वेषु धनोत्सर्गं नृपात्मजा।\nकुर्वी द्विजमुख्यानां तंतं देशं जगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2030056, "chapter_id": 1656, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि पतिव्रतामाहात्म्यपर्वणि चतुर्नवत्यधिकद्विशततमोऽध्यायः ॥ २९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]