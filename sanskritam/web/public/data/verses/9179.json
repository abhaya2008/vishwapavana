[{"id": 5000179000, "chapter_id": 9179, "verse_number": "२-१०२-१", "content_sanskrit": "तां श्रुत्वा करुणां वाचं पितुर्मरणसंहिताम् ।\nराघवो भरतेनोक्तां बभूव गतचेतन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000179001, "chapter_id": 9179, "verse_number": "२-१०२-२", "content_sanskrit": "तं तु वज्रमिवोत्सृष्टमाहवे दानवारिणा ।\nवाग्वज्रं भरतेनोक्तममनोज्ञं परन्तप: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000179002, "chapter_id": 9179, "verse_number": "२-१०२-३", "content_sanskrit": "प्रगृह्य बाहू रामो वै पुष्पिताग्रो यथा द्रुम: ।\nवने परशुना कृत्तस्तथा भुवि पपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000179003, "chapter_id": 9179, "verse_number": "२-१०२-४", "content_sanskrit": "तथा निपतितं रामं जगत्यां जगतीपतिम् ।\nकूलघातपरिश्रान्तं प्रसुप्तमिव कुञ्जरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000179004, "chapter_id": 9179, "verse_number": "२-१०२-५", "content_sanskrit": "भ्रातरस्ते महेष्वासं सर्वत: शोककर्शितम् ।\nरुदन्त: सह वैदेह्या सिषिचु: सलिलेन वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000179005, "chapter_id": 9179, "verse_number": "२-१०२-६", "content_sanskrit": "स तु संज्ञां पुनर्लब्ध्वा नेत्राभ्यामास्रमुत्सृजन् ।\nउपाक्रामत काकुत्स्थ: कृपणं बहु भाषितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000179006, "chapter_id": 9179, "verse_number": "२-१०२-७", "content_sanskrit": "स राम: स्वर्गतं श्रुत्वा पितरं पृथिवीपतिम् ।\nउवाच भरतं वाक्यं धर्मात्मा धर्मसंहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000179007, "chapter_id": 9179, "verse_number": "२-१०२-८", "content_sanskrit": "किं करिष्याम्ययोध्यायां ताते दिष्टां गतिं गते ।\nकस्तां राजवराद्धीनामयोध्यां पालयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000179008, "chapter_id": 9179, "verse_number": "२-१०२-९", "content_sanskrit": "किं नु तस्य मया कार्य्यं दुर्जातेन महात्मन: ।\nयो मृतो मम शोकेन मया चापि न संस्कृत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000179009, "chapter_id": 9179, "verse_number": "२-१०२-१०", "content_sanskrit": "अहो भरत सिद्धार्थो येन राजा त्वया ऽनघ ।\nशत्रुघ्नेन च सर्वेषु प्रेतकृत्येषु सत्कृत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000179010, "chapter_id": 9179, "verse_number": "२-१०२-११", "content_sanskrit": "निष्प्रधानामनेकाग्रां नरेन्द्रेण विना कृताम् ।\nनिवृत्तवनवासोपि नायोध्यां गन्तुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000179011, "chapter_id": 9179, "verse_number": "२-१०२-१२", "content_sanskrit": "समाप्तवनवासं मामयोध्यायां परन्तप ।\nको नु शासिष्यति पुनस्ताते लोकान्तरं गते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000179012, "chapter_id": 9179, "verse_number": "२-१०२-१३", "content_sanskrit": "पुरा प्रेक्ष्य सुवृत्तं मां पिता यान्याह सान्त्वयन् ।\nवाक्यानि तानि श्रोष्यामि कुत: कर्णसुखान्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000179013, "chapter_id": 9179, "verse_number": "२-१०२-१४", "content_sanskrit": "एवमुक्त्वा स भरतं भार्यामभ्येत्य राघव: ।\nउवाच शोकसन्तप्त: पूर्णचन्द्रनिभाननाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000179014, "chapter_id": 9179, "verse_number": "२-१०२-१५", "content_sanskrit": "सीते मृतस्ते श्वशुर: पित्रा हीनो ऽसि लक्ष्मण ।\nभरतो दु:खमाचष्टे स्वर्गतं पृथिवीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000179015, "chapter_id": 9179, "verse_number": "२-१०२-१६", "content_sanskrit": "ततो बहुगुणं तेषां बाष्पं नेत्रेष्वजायत ।\nतथा ब्रुवति काकुत्स्थे कुमाराणां यशस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000179016, "chapter_id": 9179, "verse_number": "२-१०२-१७", "content_sanskrit": "ततस्ते भ्रातर: सर्वे भृशमाश्वास्य राघवम् ।\nअब्रुवन् जगतीभर्त्तु: क्रियतामुदकं पितु: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000179017, "chapter_id": 9179, "verse_number": "२-१०२-१८", "content_sanskrit": "सा सीता श्वशुरं श्रुत्वा स्वर्गलोकगतं नृपम् ।\nनेत्राभ्यामश्रुपूर्णाभ्यामशकन्नेक्षितुं पतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000179018, "chapter_id": 9179, "verse_number": "२-१०२-१९", "content_sanskrit": "सान्त्वयित्वा तु तां रामो रुदन्तीं जनकात्मजाम् ।\nउवाच लक्ष्मणं तत्र दु:खितो दु:खितं वच: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000179019, "chapter_id": 9179, "verse_number": "२-१०२-२०", "content_sanskrit": "आनयेङ्गुदिपिण्याकं चीरमाहर चोत्तरम् ।\nजलक्रियार्थं तातस्य गमिष्यामि महात्मन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000179020, "chapter_id": 9179, "verse_number": "२-१०२-२१", "content_sanskrit": "सीता पुरस्ताद्व्रजतुत्वमेनामभितो व्रज ।\nअहं पश्चाद्गमिष्यामि गतिर्ह्येषा सुदारुणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000179021, "chapter_id": 9179, "verse_number": "२-१०२-२२", "content_sanskrit": "ततो नित्यानुगस्तेषां विदितात्मा महामति: ।\nमृदुर्दान्तश्च शान्तश्च रामे च दृढभक्तिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000179022, "chapter_id": 9179, "verse_number": "२-१०२-२३", "content_sanskrit": "सुमन्त्रस्तैर्नृपसुतै: सार्द्धमाश्वास्य राघवम् ।\nअवातारयदालम्ब्य नदीं मन्दाकिनीं शिवाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000179023, "chapter_id": 9179, "verse_number": "२-१०२-२४", "content_sanskrit": "ते सुतीर्थां तत: कृच्छ्रादुपागम्य यशस्विन: ।\nनदीं मन्दाकिनीं रम्यां सदा पुष्पितकाननाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000179024, "chapter_id": 9179, "verse_number": "२-१०२-२५", "content_sanskrit": "शीघ्रस्रोतसमासाद्य तीर्थं शिवमकर्द्दमम् ।\nसिषिचुस्तूदकं राज्ञे तत्रैतत्ते भवत्विति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000179025, "chapter_id": 9179, "verse_number": "२-१०२-२६", "content_sanskrit": "प्रगृह्य च महीपालो जलपूरितमञ्जलिम् ।\nदिशं याम्यामभिमुखो रुदन् वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000179026, "chapter_id": 9179, "verse_number": "२-१०२-२७", "content_sanskrit": "एतत्ते राजशार्दूल विमलं तोयमक्षयम् ।\nपितृलोकगतस्याद्य मद्दत्तमुपतिष्ठतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000179027, "chapter_id": 9179, "verse_number": "२-१०२-२८", "content_sanskrit": "ततो मन्दाकिनीतीरात् प्रत्युत्तीर्य्य स राघव: ।\nपितुश्चकार तेजस्वी निवापं भ्रातृभि: सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000179028, "chapter_id": 9179, "verse_number": "२-१०२-२९", "content_sanskrit": "ऐङ्गुदं बदरीमिश्रं पिण्याकं दर्भसंस्तरे ।\nन्यस्य राम: सुदु:खार्त्तो रुदन् वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000179029, "chapter_id": 9179, "verse_number": "२-१०२-३०", "content_sanskrit": "इदं भुङ्क्ष्व महाराज प्रीतो यदशना वयम् ।\nयदन्न: पुरुषो भवति तदन्नास्तस्य देवता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000179030, "chapter_id": 9179, "verse_number": "२-१०२-३१", "content_sanskrit": "ततस्तेनैव मार्गेण प्रत्युत्तीर्य्य नदीतटात् ।\nआरुरोह नरव्याघ्रो रम्यसानुं महीधरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000179031, "chapter_id": 9179, "verse_number": "२-१०२-३२", "content_sanskrit": "तत: पर्णकुटीद्वारमासाद्य जगतीपति: ।\nपरिजग्राह बाहुभ्यामुभौ भरतलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000179032, "chapter_id": 9179, "verse_number": "२-१०२-३३", "content_sanskrit": "तेषां तु रुदतां शब्दात् प्रतिश्रुत्को ऽभवद्गिरौ ।\nभ्रातऽणां सह वैदेह्या: सिंहानामिव नर्दताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000179033, "chapter_id": 9179, "verse_number": "२-१०२-३४", "content_sanskrit": "महाबलानां रुदतां कुर्वतामुदकं पितु: ।\nविज्ञाय तुमुलं शब्दं त्रस्ता भरतसैनिका: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000179034, "chapter_id": 9179, "verse_number": "२-१०२-३५", "content_sanskrit": "अब्रुवंश्चापि रामेण भरत: सङ्गतो ध्रुवम् ।\nतेषामेव महाञ्छब्द: शोचतां पितरं मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000179035, "chapter_id": 9179, "verse_number": "२-१०२-३६", "content_sanskrit": "अथ वासान् परित्यज्य तं सर्वे ऽभिमुखा: स्वनम् ।\nअप्येकमनसो जग्मुर्यथास्थानं प्रधाविता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000179036, "chapter_id": 9179, "verse_number": "२-१०२-३७", "content_sanskrit": "हयैरन्ये गजैरन्ये रथैरन्ये स्वलङ्कृतै: ।\nसुकुमारास्तथैवान्ये पद्भिरेव नरा ययु: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000179037, "chapter_id": 9179, "verse_number": "२-१०२-३८", "content_sanskrit": "अचिरप्रोषितं रामं चिरविप्रोषितं यथा ।\nद्रष्टुकामो जन: सर्वो जगाम सहसाश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000179038, "chapter_id": 9179, "verse_number": "२-१०२-३९", "content_sanskrit": "भ्रातऽणां त्वरितास्तत्र द्रष्टुकामा: समागमम् ।\nययुर्बहुविधैर्यानै: खुरनेमिस्वनाकुलै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000179039, "chapter_id": 9179, "verse_number": "२-१०२-४०", "content_sanskrit": "सा भूमिर्बहुभिर्यानै: खुरनेमिसमाहता ।\nमुमोच तुमुलं शब्दं द्यौरिवाभ्रसमागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000179040, "chapter_id": 9179, "verse_number": "२-१०२-४१", "content_sanskrit": "तेन वित्रासिता नागा: करेणुपरिवारिता: ।\nआवासयन्तो गन्धेन जग्मुरन्यद्वनं तत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000179041, "chapter_id": 9179, "verse_number": "२-१०२-४२", "content_sanskrit": "वराहवृकसङ्घाश्च महिषा: सर्प्पवानरा: ।\nव्याघ्रगोकर्णगवया: वित्रेसु: पृषतैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000179042, "chapter_id": 9179, "verse_number": "२-१०२-४३", "content_sanskrit": "रथाङ्गसाह्वा नत्यूहा: हंसा: कारण्डवा: प्लवा: ।\nतथा पुंस्कोकिला: क्रौञ्चा विसंज्ञा भेजिरे दिश: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000179043, "chapter_id": 9179, "verse_number": "२-१०२-४४", "content_sanskrit": "तेन शब्देन वित्रस्तैराकाशं पक्षिभिर्वृतम् ।\nमनुष्यैरावृता भूमिरुभयं प्रबभौ तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000179044, "chapter_id": 9179, "verse_number": "२-१०२-४५", "content_sanskrit": "ततस्तं पुरुषव्याघ्रं यशस्विनमरिन्दमम् ।\nआसीनं स्थण्डिले रामं ददर्श सहसा जन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000179045, "chapter_id": 9179, "verse_number": "२-१०२-४६", "content_sanskrit": "विगर्हमाण: कैकेयीं सहितो मन्थरामपि ।\nअभिगम्य जनो रामं बाष्पपूर्णमुखो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000179046, "chapter_id": 9179, "verse_number": "२-१०२-४७", "content_sanskrit": "तान्नरान् बाष्पपूर्णाक्षान् समीक्ष्याथ सुदु:खितान् ।\nपर्य्यष्वजत धर्मज्ञ: पितृवन्मातृवच्च स: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000179047, "chapter_id": 9179, "verse_number": "२-१०२-४८", "content_sanskrit": "स तत्र कांच्चित् परिषस्वजे नरान्नराश्च केचित्तु तमभ्यवादयन् ।\nचकार सर्वान् सवयस्य बान्धवान् यथार्हमासाद्य तदा नृपात्मज: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000179048, "chapter_id": 9179, "verse_number": "२-१०२-४९", "content_sanskrit": "स तत्र तेषां रुदतां महात्मनां भुवं च खं चानुनिनादयन् स्वन: ।\nगुहा गिरीणां च दिशश्च सन्ततं मृदङ्गघोषप्रतिम: प्रशुश्रुवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000179049, "chapter_id": 9179, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे द्व्युत्तरशततम:सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]