[{"id": 7003513000, "chapter_id": 23513, "verse_number": "१५३-१", "content_sanskrit": "अथ मथुरातीर्थमाहात्म्यम् ।\nश्रीवराह उवाच ।\nउत्तरे शिवकुण्डाच्च तीर्थानां नवकं स्मृतम् ।\nनवतीर्थात्परं तीर्थं न भूतं न भविष्यति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003513001, "chapter_id": 23513, "verse_number": "१५३-२", "content_sanskrit": "तत्रैव स्नानमात्रेण सौभाग्यं जायते परम्।\nरूपवन्तः प्रजायंते स्वर्गलोके न सशंयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003513002, "chapter_id": 23513, "verse_number": "१५३-३", "content_sanskrit": "तस्मिन् स्नातो नरो देवि मम लोके प्रपद्यते ।\nतत्र संयमनं नाम तीर्थं त्रैलोक्यविश्रुतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003513003, "chapter_id": 23513, "verse_number": "१५३-४", "content_sanskrit": "तत्र स्नातो मृतो वापि मम लोकं स गच्छति ।\nपुनरन्यत्प्रवक्ष्यामि तच्छृणुष्व वसुन्धरे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003513004, "chapter_id": 23513, "verse_number": "१५३-५", "content_sanskrit": "तस्मिन् संयमने तीर्थे यद्यद्वृत्तं पुरातनम् ।\nकश्चित्पापसमाचारो निषादो दुष्टमानसः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003513005, "chapter_id": 23513, "verse_number": "१५३-६", "content_sanskrit": "वसते नैमिषारण्ये सुप्रतीतेऽतिपापकृत्।\nकेनचित्त्वथ कालेन सोऽगच्छन्मथुरां प्रति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003513006, "chapter_id": 23513, "verse_number": "१५३-७", "content_sanskrit": "तत्र प्राप्य च कालिन्दीं कृष्णपक्षे चतुर्दशीम् ।\nस निषादस्तर्त्तुकामस्तस्यां चैव तिथौ ततः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003513007, "chapter_id": 23513, "verse_number": "१५३-८", "content_sanskrit": "ततार यमुनां सोऽथ प्राप्य संयमनं शुभे ।\nममज्जासौ ततः पापस्तस्मिंस्तीर्थे वरे शुभे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003513008, "chapter_id": 23513, "verse_number": "१५३-९", "content_sanskrit": "मग्नमात्रस्ततः पापः सद्यः प्राणैर्व्ययुज्यत ।\nतत्तीर्थस्य प्रभावेण जातोऽसौ पृथवीपतिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003513009, "chapter_id": 23513, "verse_number": "१५३-१०", "content_sanskrit": "सौराष्ट्रविषये देवि क्षत्रियोऽभूद्धनुर्द्धरः ।\nनाम्ना यक्ष्मधनुर्नाम सोऽभवत्प्रियदर्शनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003513010, "chapter_id": 23513, "verse_number": "१५३-११", "content_sanskrit": "पालयामास वसुधां क्षत्रधर्मं समाश्रितः ।\nतेनोढा काशिराजस्य पीवरी नामतः शुभा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003513011, "chapter_id": 23513, "verse_number": "१५३-१२", "content_sanskrit": "पत्नी शतानां मुख्यानां प्रवरा सा वसुन्घरे।\nतां चैव रमयामास उद्यानेषु वनेषु च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003513012, "chapter_id": 23513, "verse_number": "१५३-१३", "content_sanskrit": "प्रासादेषु च रम्येषु नदीनां पुलिनेषु च ।\nप्रजाः पालयतस्तस्य दानानि ददतस्तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003513013, "chapter_id": 23513, "verse_number": "१५३-१४", "content_sanskrit": "कालो गच्छति राजा तु भोगासक्तिं च विंदति।\nभोगासक्तस्य वसुधे वर्षाणि सप्तसप्ततिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003513014, "chapter_id": 23513, "verse_number": "१५३-१५", "content_sanskrit": "पुत्राः सप्त तथा जाताः कन्याः पंच सुशोभनाः ।\nराज्ञां पंचसुता दत्ताः कन्याः कमललोचनाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003513015, "chapter_id": 23513, "verse_number": "१५३-१६", "content_sanskrit": "पुत्रान्संस्थापयामास स्थानेषु वसुधाधिपान् ।\nपीवर्या सह सुप्तः स रात्रौ च वसुधाधिपः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003513016, "chapter_id": 23513, "verse_number": "१५३-१७", "content_sanskrit": "तत्र प्रबुद्धो नृपतिर्हाहेति वदते मुहुः  ।\nस्मृत्त्वा तु मथुरां देवि स्मृत्वा संयमनं परम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003513017, "chapter_id": 23513, "verse_number": "१५३-१८", "content_sanskrit": "तत सा पीवरी प्राह किमेवं भाषसे नृप ।\nप्रियाया वचनं श्रुत्वा राजा वचनमब्रवीत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003513018, "chapter_id": 23513, "verse_number": "१५३-१९", "content_sanskrit": "मत्तः सुप्तः प्रमत्तश्च असम्बद्धं प्रभाषते ।\nनिद्रावशस्य वचनं न सम्प्रष्टुं त्वमर्हसि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003513019, "chapter_id": 23513, "verse_number": "१५३-२०", "content_sanskrit": "पीवर्युवाच ।\nकथयस्व ममाद्य त्वं यद्यहं वल्लभा तव ।\nप्राणांस्त्यक्ष्याम्यहं देव गोपयिष्यसि मे यदि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003513020, "chapter_id": 23513, "verse_number": "१५३-२१", "content_sanskrit": "प्रियाया वचनं श्रुत्वा प्रत्युवाच नराधिपः ।\nअवश्यं यदि वक्तव्यं गच्छावो मथुरां पुरीम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003513021, "chapter_id": 23513, "verse_number": "१५३-२२", "content_sanskrit": "तत्र गत्वा  यथातत्त्वं वदिष्यामि शुभानने ।\nददस्व विपुलं दानं ब्राह्मणेभ्यः सुलोचने ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003513022, "chapter_id": 23513, "verse_number": "१५३-२३", "content_sanskrit": "पुत्रान्संस्थाप्य दौहित्रान्स्वे स्थाने शुभान्प्रिये ।\nग्रामांश्च कोशं रत्नानि पुत्रान्वीक्ष्य पुनः पुनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003513023, "chapter_id": 23513, "verse_number": "१५३-२४", "content_sanskrit": "ततः सम्मानयामास जनं पुरनिवासिनम् ।\nपितृपैतामहं राज्यं पालनीयं यथाक्रमम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003513024, "chapter_id": 23513, "verse_number": "१५३-२५", "content_sanskrit": "राज्ये पुत्रान्नियोक्ष्यामि यदि वो रोचतेऽनघाः ।\nराज्यपुत्रकलत्राणि बन्धुवर्गं तथैव च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003513025, "chapter_id": 23513, "verse_number": "१५३-२६", "content_sanskrit": "नित्यमिच्छन्ति वै लोको यमस्येच्छन्ति नान्यथा ।\nएवं ज्ञात्वा प्रसन्नेन कर्त्तव्यं चात्मनो हितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003513026, "chapter_id": 23513, "verse_number": "१५३-२७", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन गच्छावो मथुरां पुरीम् ।\nअहो कष्टं यदस्माभिः पुरा राज्यमनुष्ठितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003513027, "chapter_id": 23513, "verse_number": "१५३-२८", "content_sanskrit": "इदानीं तु मया ज्ञातं त्यागान्नास्ति परं सुखम् ।\nनास्ति विद्यासमं चक्षुर्नास्ति चक्षुस्समं बलम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003513028, "chapter_id": 23513, "verse_number": "१५३-२९", "content_sanskrit": "नास्ति रागसमं दुःखं नास्ति त्यागात्परं सुखम् ।\nयः कामान्कुरुते सर्वान्यश्चैतान्केवलांस्त्यजेत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003513029, "chapter_id": 23513, "verse_number": "१५३-३०", "content_sanskrit": "प्रायेण सर्वकामानां परित्यागो विशिष्यते।\nअभिषिच्य सुतं ज्येष्ठमनुयोज्य परान्बहून् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003513030, "chapter_id": 23513, "verse_number": "१५३-३१", "content_sanskrit": "ततः पौरजनं दृष्ट्वा चतुरङ्गबलान्वितः ।\nततः कालेन महता सम्प्राप्तो मथुरां पुरीम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003513031, "chapter_id": 23513, "verse_number": "१५३-३२", "content_sanskrit": "तेन दृष्टा पुरी रम्या वासवस्य पुरी यथा ।\nतीर्थैर्द्वादशभिर्युक्ता पुण्या पापहरा शुभा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003513032, "chapter_id": 23513, "verse_number": "१५३-३३", "content_sanskrit": "रम्यं मधुवनं नाम विष्णुस्थानमनुत्तमम् ।\nतं दृष्ट्वा मनुजो देवि कृतकृत्यो हि जायते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003513033, "chapter_id": 23513, "verse_number": "१५३-३४", "content_sanskrit": "एकादशी शुक्लपक्षे मासि भाद्रपदे तथा ।\nतस्यां स्नातो नरो देवि कृतकृत्यो हि जायते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003513034, "chapter_id": 23513, "verse_number": "१५३-३५", "content_sanskrit": "वनं कुन्दवनं नाम तृतीयं चैवमुत्तमम् ।\nतत्र गत्वा नरो देवि कृतकृत्यो हि जायते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003513035, "chapter_id": 23513, "verse_number": "१५३-३६", "content_sanskrit": "एकादशी कृष्णपक्षे मासि भाद्रपदे हि वा ।\nतत्र स्नातो नरो देवि रुद्रलोके महीयते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003513036, "chapter_id": 23513, "verse_number": "१५३-३७", "content_sanskrit": "चतुर्थं काम्यकवनं वनानां वनमुत्तमम्।\nतत्र गत्वा नरो देवि मम लोके महीयते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003513037, "chapter_id": 23513, "verse_number": "१५३-३८", "content_sanskrit": "विमलस्य च कुण्डे तु सर्वपापैः प्रमुच्यते।\nयस्तत्र मुंचते प्राणान्मम लोकं स गच्छति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003513038, "chapter_id": 23513, "verse_number": "१५३-३९", "content_sanskrit": "पंचमं बकुलं नाम वनानामुत्तमं वनम् ।\nतत्र गत्वा नरो देवि अग्निस्थानं स गच्छति ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003513039, "chapter_id": 23513, "verse_number": "१५३-४०", "content_sanskrit": "यमुनायाः परे पारे देवानामपि दुर्ल्लभम् ।\nअस्ति भद्रवनं नाम षष्ठं वनमनुत्तमम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003513040, "chapter_id": 23513, "verse_number": "१५३-४१", "content_sanskrit": "तत्र गत्वा तु वसुधे मद्भक्तो मत्परायणः ।\nतद्वनस्य प्रभावेण नागलोकं स गच्छति ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003513041, "chapter_id": 23513, "verse_number": "१५३-४२", "content_sanskrit": "सप्तमं तु वनं भूमे खादिरं लोकविश्रुतम् ।\nतत्र गत्वा नरो भद्रे मम लोकं स गच्छति ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003513042, "chapter_id": 23513, "verse_number": "१५३-४३", "content_sanskrit": "महावनं चाष्टमं तु सदैव तु मम प्रियम् ।\nयत्र गत्वा तु मनुज इन्द्रलोके महीयते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003513043, "chapter_id": 23513, "verse_number": "१५३-४४", "content_sanskrit": "लोहजङ्घवनं नाम लोहजङ्घेन रक्षितम् ।\nनवमं तु वनं नाम सर्वपातकनाशनम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003513044, "chapter_id": 23513, "verse_number": "१५३-४५", "content_sanskrit": "वनं बिल्ववनं नाम दशमं देवपूजितम् ।\nतत्र गत्वा तु मनुजो ब्रह्मलोके महीयते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003513045, "chapter_id": 23513, "verse_number": "१५३-४६", "content_sanskrit": "एकादशं तु भाण्डीरं योगिनः प्रियमुत्तमम् ।\nतस्य दर्शनमात्रेण नरो गर्भं न गच्छति ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003513046, "chapter_id": 23513, "verse_number": "१५३-४७", "content_sanskrit": "भाण्डीरं तमनुप्राप्य वनानां वनमुत्तमम् ।\nवासुदेवं ततो दृष्ट्वा पुनर्जन्म न विद्यते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003513047, "chapter_id": 23513, "verse_number": "१५३-४८", "content_sanskrit": "वृन्दावनं द्वादशकं वृन्दया परिरक्षितम् ।\nमम चैव प्रियं भूमे महापातकनाशनम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003513048, "chapter_id": 23513, "verse_number": "१५३-४९", "content_sanskrit": "वृन्दावनं च गोविन्दं ये पश्यन्ति वसुन्धरे ।\nन ते यमपुरं यान्ति यान्ति पुण्यकृतां गतिम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]