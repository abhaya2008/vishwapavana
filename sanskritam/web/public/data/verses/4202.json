[{"id": 2148023, "chapter_id": 4202, "verse_number": "", "content_sanskrit": "विदुला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148024, "chapter_id": 4202, "verse_number": "१", "content_sanskrit": "अथैतस्यामवस्थायां पौरुषं हातुमिच्छसि ।\nनिहीनसेवितं मार्गं गमिष्यस्यचिरादिव\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148025, "chapter_id": 4202, "verse_number": "२", "content_sanskrit": "यो हि तेजो यथाशक्ति न दर्शयति विक्रमात् ।\nक्षत्रियो जीविताकाङ्क्षी स्तेन इत्येव तं विदुः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148026, "chapter_id": 4202, "verse_number": "३", "content_sanskrit": "अर्थवन्त्युपपन्नानि वाक्यानि गुणवन्ति च ।\nनैव सम्प्राप्नुवन्ति त्वां मुमूर्षुमिव भेषजम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148027, "chapter_id": 4202, "verse_number": "४", "content_sanskrit": "सन्ति वै सिन्धुराजस्य सन्तुष्टा बहवो जनाः ।\nदौर्बल्यादासते गूढा व्यसनौघप्रतीक्षिणः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148028, "chapter_id": 4202, "verse_number": "५", "content_sanskrit": "सहायोपचयं दृष्ट्वा आगच्छेयुस्ततस्ततः ।\nअनुतुष्येयुरपरे पश्यन्तस्तव पौरुषम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148029, "chapter_id": 4202, "verse_number": "६", "content_sanskrit": "तैः कृत्वा सहसा यात्रां गिरिदुर्गालयैश्चर ।\nकाले व्यसनमाकाङ्क्षन् नैवायमजरामरः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148030, "chapter_id": 4202, "verse_number": "७", "content_sanskrit": "सृञ्जयो नामतश्च त्वं न च पश्याम तत् त्वयि ।\nअन्वर्थनामा भव मे पुत्र मा व्यर्थनामकः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148031, "chapter_id": 4202, "verse_number": "८", "content_sanskrit": "सम्यग्दृष्टिर्महाप्राज्ञो बालं त्वां ब्राह्मणोऽब्रवीत् ।\nअयं प्राप्य महत् कृच्छ्रं पुनर्वृद्धिं गमिष्यति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148032, "chapter_id": 4202, "verse_number": "९", "content_sanskrit": "तस्य स्मरन्ती वचनमाशंसे विजयं तव ।\nतस्मात् तात ब्रवीमि त्वां वक्ष्यामि च पुनः पुनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148033, "chapter_id": 4202, "verse_number": "१०", "content_sanskrit": "यस्य युद्धार्थमुद्युक्ता भवत्यवहिता मतिः ।\nतस्यार्थसिद्धिर्नियता नयेष्वर्थानुसारिणः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148034, "chapter_id": 4202, "verse_number": "११", "content_sanskrit": "समृद्धिरसमृद्धिर्वा पूर्वेषां मम सृञ्जय ।\nएवं विद्वान् युद्धमना भव मा प्रत्युपाहर\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148035, "chapter_id": 4202, "verse_number": "१२", "content_sanskrit": "नातः पापीयसीं काञ्चिदवस्थां शम्बरोऽब्रवीत् ।\nयस्य नैवोद्यतः प्रातर्भोजनं प्रतिदृश्यते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148036, "chapter_id": 4202, "verse_number": "१३", "content_sanskrit": "पतिपुत्रवधादेतत् परमं दुःखमब्रवीत् ।\nदारिद्र्यमिति यत् प्रोक्तं पर्यायमरणं हि तत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148037, "chapter_id": 4202, "verse_number": "१४", "content_sanskrit": "अहं महाकुले जाता ह्रदाद् ह्रदमिवागता ।\nईश्वरी सर्वकल्याणी भर्त्रा परमपूजिता\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148038, "chapter_id": 4202, "verse_number": "१५", "content_sanskrit": "महार्हमाल्याभरणां सुमृष्टाम्बरवासिनीम् ।\nपुरा दृष्ट्वा सुहृद्वर्गो मामपश्यत् सुदुःखिताम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148039, "chapter_id": 4202, "verse_number": "१६", "content_sanskrit": "यदा मां चैव भार्यां च द्रष्टासि भृशदुर्बले ।\nन तदा जीवितेनार्थो भविता तव सृञ्जय\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148040, "chapter_id": 4202, "verse_number": "१७", "content_sanskrit": "दासकर्मकरान् भृत्यान् आचार्यर्त्विक्पुरोहितान् ।\nअभृत्याऽस्मान् प्रजहतो दृष्ट्वा किं जीवितेन ते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148041, "chapter_id": 4202, "verse_number": "१८", "content_sanskrit": "यदि कृत्यं न पश्यामि तवाद्याहं यथा पुरा ।\nश्लाघनीयं यशस्यं च का शान्तिर्हृदयस्य मे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148042, "chapter_id": 4202, "verse_number": "१९", "content_sanskrit": "नेति चेद् ब्राह्मणान् ब्रूयां दीर्येत हृदयं मम ।\nन ह्यहं न च मे भर्ता नेति ब्राह्मणमुक्तवान्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148043, "chapter_id": 4202, "verse_number": "२०", "content_sanskrit": "वयमाश्रयणीयाः स्म नाश्रितारः परस्य च ।\nअन्यानाश्रित्य जीवन्ती परित्यक्ष्यामि जीवितम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148044, "chapter_id": 4202, "verse_number": "२१", "content_sanskrit": "अपारे भव नः पारम् अप्लवे भव नः प्लवः ।\nकुरुष्व स्थानमस्थाने मृतान् सञ्जीवयस्व नः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148045, "chapter_id": 4202, "verse_number": "२२", "content_sanskrit": "सर्वे ते शत्रवः सह्या नो चेज्जीवितुमिच्छसि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2148046, "chapter_id": 4202, "verse_number": "२३", "content_sanskrit": "अथ चेदीदृशीं वृत्तिं क्लीबामभ्यवपद्यसे ।\nनिर्विण्णात्मा हतमना मुञ्चेमां जीविकां पुनः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2148047, "chapter_id": 4202, "verse_number": "२४", "content_sanskrit": "एकशत्रुवधेनैव शूरो गच्छति विश्रुतिम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2148048, "chapter_id": 4202, "verse_number": "२५", "content_sanskrit": "इन्द्रो वृत्रवधेनैव महेन्द्रः समपद्यत ।\nमाहेन्द्रं च ग्रहं लेभे लोकानां चेश्वरोऽभवत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2148049, "chapter_id": 4202, "verse_number": "२६", "content_sanskrit": "नाम विश्राव्य सङ्खे वै शत्रूनाहूय दंसितान् ।\nसेनाग्रं चापि विद्राव्य हत्वा शत्रुं परन्तपः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2148050, "chapter_id": 4202, "verse_number": "२७", "content_sanskrit": "यदैव लभते वीरः सुयुद्धेन महद्यशः ।\nतदैव प्रव्यथन्तेऽस्य शत्रवो विनमन्ति च\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2148051, "chapter_id": 4202, "verse_number": "२८", "content_sanskrit": "त्यक्तात्मानं रणे दक्षं शूरं पुरुषमानिनम् ।\nअवशाः पूजयन्ति स्म सर्वकामसमृद्धिभिः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2148052, "chapter_id": 4202, "verse_number": "२९", "content_sanskrit": "राज्यस्याप्यस्य विभ्रंशः संशयो जीवितस्य वा ।\nप्रलब्धस्य हि शत्रोर्निर्वेशं कुर्वन्ति साधवः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2148053, "chapter_id": 4202, "verse_number": "३०", "content_sanskrit": "स्वर्गद्वारोपमं राज्यमथवाऽप्यमृतोपमम् ।\nभुङ्क्ष्व युद्धेन ते शत्रून् जित्वा तु रणमूर्धनि\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2148054, "chapter_id": 4202, "verse_number": "३१", "content_sanskrit": "नियच्छन्नितरान् वर्णान् विनयन् सर्वदुष्कृतान् ।\nरुद्धमेकायने मत्वा पतोल्मुक इवारिषु\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2148055, "chapter_id": 4202, "verse_number": "३२", "content_sanskrit": "जहि शत्रून् रणे राजन् स्वधर्ममनुपालय ।\nमा त्वा पश्येत् सुकृपणं शत्रुः श्रीमान् कदाचन\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2148056, "chapter_id": 4202, "verse_number": "३३", "content_sanskrit": "अस्मदीयैश्च शोचद्भिः नन्दद्भिश्च परैर्भृशम् ।\nअपि त्वां नानुपश्येयं दीनदीनमिव स्थितम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2148057, "chapter_id": 4202, "verse_number": "३४", "content_sanskrit": "उष्य सौवीरकन्याभिः श्लाघ्यः स्वार्थैर्यथा पुरा ।\nमा च सैन्धवकन्यानामपहासवशं गमः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2148058, "chapter_id": 4202, "verse_number": "३५", "content_sanskrit": "युवा रूपेण सम्पन्नो विद्ययाऽभिजनेन च ।\nकस्त्वादृशो विकुर्वीत यशस्वी लोकविश्रुतः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2148059, "chapter_id": 4202, "verse_number": "३६", "content_sanskrit": "वोढव्ये धुर्यनडुवन्मन्ये मरणमेव तत्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2148060, "chapter_id": 4202, "verse_number": "३७", "content_sanskrit": "यदि त्वामत्र पश्यामि परस्य प्रियवादिनम् ।\nपृष्ठतोऽनुव्रजन्तं वा का शान्तिर्हृदयस्य मे\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2148061, "chapter_id": 4202, "verse_number": "३८", "content_sanskrit": "नास्मिन् जातु कुले जातो गच्छेद् योऽन्यस्य पृष्ठतः ।\nन त्वं परस्यानुचरस्तात जीवितुमर्हसि\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2148062, "chapter_id": 4202, "verse_number": "३९", "content_sanskrit": "अहं हि क्षत्रहृदयं वेद यद् भूरि शाश्वतम् ।\nपूर्वैः पूर्वतरैः प्रोक्तं परैः परतरैरपि\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2148063, "chapter_id": 4202, "verse_number": "४०", "content_sanskrit": "शाश्वतं चाव्ययं चैव प्रजापतिविनिर्मितम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2148064, "chapter_id": 4202, "verse_number": "४१", "content_sanskrit": "यो वै कश्चित् कुले जातः क्षत्रियः क्षत्रधर्मवित् ।\nभयाद् वृत्तिसमीक्षो वा न नमेदिह कस्यचित्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2148065, "chapter_id": 4202, "verse_number": "४२", "content_sanskrit": "उद्यच्छेदेव न नमेद् उद्यमो ह्येव पौरुषम् ।\nअप्यपर्वणि भज्येत न नमेदिह कस्यचित्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2148066, "chapter_id": 4202, "verse_number": "४३", "content_sanskrit": "मातङ्गो मत्त इव च परीयात् स महामनाः ।\nब्राह्मणेभ्यो नमेन्नित्यं धर्मायैव च सृञ्जय\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2148067, "chapter_id": 4202, "verse_number": "४४", "content_sanskrit": "नियच्छन्नितरान् वर्णान् विमर्शन् सर्वमुन्नतः ।\nससहायोऽसहायो वा यावज्जीवं तथा भवेत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2148068, "chapter_id": 4202, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि त्रयस्त्रिंशोत्तरशततमोऽध्यायः ॥१३३॥\nभगवद्यानपर्वणि चतुःषष्टितमोऽध्यायः ॥६४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]