[{"id": 5000635000, "chapter_id": 9635, "verse_number": "७-१००-१", "content_sanskrit": "कस्यचित्त्वथ कालस्य युधाजित्केकयो नृपः ।\nस्वगुरुं प्रेषयामास राघवाय महात्मने ।\nगार्ग्यमङ्गिरसः पुत्रं ब्रह्मर्षिममितप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000635001, "chapter_id": 9635, "verse_number": "७-१००-२", "content_sanskrit": "दश चाश्वसहस्राणि प्रीतिदानमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000635002, "chapter_id": 9635, "verse_number": "७-१००-३", "content_sanskrit": "कम्बलानि च रत्नानि चित्रवस्त्रमथोत्तमम् ।\nरामाय प्रददौ राजा शुभान्याभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000635003, "chapter_id": 9635, "verse_number": "७-१००-४", "content_sanskrit": "श्रुत्वा तु राघवो धीमान्महर्षिं गार्ग्यमागतम् ।\nमातुलस्याश्वपतिनः प्रहितं तन्महाधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000635004, "chapter_id": 9635, "verse_number": "७-१००-५", "content_sanskrit": "प्रत्युद्गम्य च काकुत्स्थः क्रोशमात्रं सहानुजः ।\nगार्ग्यं सम्पूजयामास यथा शक्रो बृहस्पतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000635005, "chapter_id": 9635, "verse_number": "७-१००-६", "content_sanskrit": "तथा सम्पूज्य तमृषिं तद्धनं प्रतिगृह्य च ।\nपृष्ट्वा प्रतिपदं सर्वं कुशलं मातुलस्य च ।\nउपविष्टं महाभागं रामः प्रष्टुं प्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000635006, "chapter_id": 9635, "verse_number": "७-१००-७", "content_sanskrit": "किमाह मातुलो वाक्यं यदर्थं भगवानिह ।\nप्राप्तो वाक्यविदां श्रेष्ठः साक्षादिव बृहस्पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000635007, "chapter_id": 9635, "verse_number": "७-१००-८", "content_sanskrit": "रामस्य भाषितं श्रुत्वा महर्षिः कार्यविस्तरम् ।\nवक्तुमद्भुतसङ्काशं राघवायोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000635008, "chapter_id": 9635, "verse_number": "७-१००-९", "content_sanskrit": "मातुलस्ते महाबाहो वाक्यमाह नरर्षभः ।\nयुधाजित्प्रीतिसंयुक्तं श्रूयतां यदि रोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000635009, "chapter_id": 9635, "verse_number": "७-१००-१०", "content_sanskrit": "अयं गन्धर्वविषयः फलमूलोपशोभितः ।\nसिन्धोरुभयतः पार्श्वे देशः परमशोभनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000635010, "chapter_id": 9635, "verse_number": "७-१००-११", "content_sanskrit": "तं च रक्षन्ति गन्धर्वाः सायुधा युद्धकोविदाः ।\nशैलूषस्य सुता वीर त्रिकोट्यो वै महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000635011, "chapter_id": 9635, "verse_number": "७-१००-१२", "content_sanskrit": "तान्विनिर्जित्य काकुत्स्थ गन्धर्वनगरं शुभम् ।\nनिवेशय महाबोहो स्वे पुरे सुसमाहिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000635012, "chapter_id": 9635, "verse_number": "७-१००-१३", "content_sanskrit": "अन्यस्य न गतिस्तत्र देशः परमशोभनः ।\nरोचतां ते महाबाहो नाहं त्वामहितं वदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000635013, "chapter_id": 9635, "verse_number": "७-१००-१४", "content_sanskrit": "तच्छ्रुत्वा राघवः प्रीतो महर्षेर्मातुलस्य च ।\nउवाच बाढमित्येव भरतं चान्ववैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000635014, "chapter_id": 9635, "verse_number": "७-१००-१५", "content_sanskrit": "सो ऽब्रवीद्राघवः प्रीतः साञ्जलिप्रग्रहो द्विजम् ।\nइमौ कुमारौ तं देशं ब्रह्मर्षे विचरिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000635015, "chapter_id": 9635, "verse_number": "७-१००-१६", "content_sanskrit": "भरतस्यात्मजौ वीरौ तक्षः पुष्कल एव च ।\nमातुलेन सुगुप्तौ तु धर्मेण सुसमाहितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000635016, "chapter_id": 9635, "verse_number": "७-१००-१७", "content_sanskrit": "भरतं चाग्रतः कृत्वा कुमारौ सबलानुगौ ।\nनिहत्य गन्धर्वसुतान्द्वे पुरे विभजिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000635017, "chapter_id": 9635, "verse_number": "७-१००-१८", "content_sanskrit": "निवेश्य ते पुरवरे आत्मजौ सन्निवेश्य च ।\nआगमिष्यति मे भूयः सकाशमतिधार्मिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000635018, "chapter_id": 9635, "verse_number": "७-१००-१९", "content_sanskrit": "ब्रह्मर्षिमेवमुक्त्वा तु भरतं सबलानुगम् ।\nआज्ञापयामास तदा कुमारौ चाभ्यषेचयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000635019, "chapter_id": 9635, "verse_number": "७-१००-२०", "content_sanskrit": "नक्षत्रेण च सौम्येन पुरस्कृत्याङ्गिरस्सुतम् ।\nभरतः सह सैन्येन कुमाराभ्यां विनिर्ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000635020, "chapter_id": 9635, "verse_number": "७-१००-२१", "content_sanskrit": "सा सेना शक्रयुक्तेव नगरान्निर्ययावथ ।\nराघवानुगता दूरं दुराधर्षा सुरैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000635021, "chapter_id": 9635, "verse_number": "७-१००-२२", "content_sanskrit": "मांसादानि च सत्त्वानि रक्षांसि सुमहान्ति च ।\nअनुजग्मुर्हि भरतं रुधिरस्य पिपासया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000635022, "chapter_id": 9635, "verse_number": "७-१००-२३", "content_sanskrit": "भूतग्रामाश्च बहवो मांसभक्षाः सुदारुणाः ।\nगन्धर्वपुत्रमांसानि भोक्तुकामाः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000635023, "chapter_id": 9635, "verse_number": "७-१००-२४", "content_sanskrit": "सिंहव्याघ्रवराहाणां खेचराणां च पक्षिणाम् ।\nबहूनि वै सहस्राणि सेनाया ययुरग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000635024, "chapter_id": 9635, "verse_number": "७-१००-२५", "content_sanskrit": "अध्यर्धमासमुषिता पथि सेना निरामया ।\nहृष्टपुष्टजनाकीर्णा केकयं समुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000635025, "chapter_id": 9635, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे शततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]