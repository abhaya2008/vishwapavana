[{"id": 2016929, "chapter_id": 1353, "verse_number": "२-९४-१", "content_sanskrit": "कर्ण उवाच॥\nया नः श्रुता मनुष्येषु स्त्रियो रूपेण संमताः।\nतासामेतादृशं कर्म न कस्याश्चन शुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2016930, "chapter_id": 1353, "verse_number": "२-९४-२", "content_sanskrit": "क्रोधाविष्टेषु पार्थेषु धार्तराष्ट्रेषु चाप्यति।\nद्रौपदी पाण्डुपुत्राणां कृष्णा शान्तिरिहाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2016931, "chapter_id": 1353, "verse_number": "२-९४-३", "content_sanskrit": "अप्लवेऽम्भसि मग्नानामप्रतिष्ठे निमज्जताम्।\nपाञ्चाली पाण्डुपुत्राणां नौरेषां पारगाऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2016932, "chapter_id": 1353, "verse_number": "२-९४-४x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2016933, "chapter_id": 1353, "verse_number": "२-९४-४", "content_sanskrit": "तद्वै श्रुत्वा भीमसेनः कुरुमध्येऽत्यमर्षणः।\nस्त्री गतिः पाण्डुपुत्राणामित्युवाच सुदुर्मनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2016934, "chapter_id": 1353, "verse_number": "२-९४-५x", "content_sanskrit": "भीम उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2016935, "chapter_id": 1353, "verse_number": "२-९४-५", "content_sanskrit": "त्रीणि ज्योतींषि पुरुष इति वै देवलोऽब्रवीत्।\nअपत्यं कर्म विद्या च यतः सृष्टाः प्रजास्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2016936, "chapter_id": 1353, "verse_number": "२-९४-६", "content_sanskrit": "अमेध्ये वै गतप्रामे शून्ये ज्ञातिभिरुज्झिते।\nदेहे त्रितयमेवैतत्पुरुषस्योपयुज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2016937, "chapter_id": 1353, "verse_number": "२-९४-७", "content_sanskrit": "तन्नो ज्योतिरभिहतं दाराणामभिमर्शनात्।\nधनञ्जय कथं स्वित्स्यादपत्यमभिमृष्टजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2016938, "chapter_id": 1353, "verse_number": "२-९४-८x", "content_sanskrit": "अर्जुन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2016939, "chapter_id": 1353, "verse_number": "२-९४-८", "content_sanskrit": "न चैवोक्ता न चानुक्ता हीनतः परुषा गिरः।\nभारत प्रतिजल्पन्ति सदा तूत्तमपूरुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2016940, "chapter_id": 1353, "verse_number": "२-९४-९", "content_sanskrit": "स्मरन्ति सुकृतान्येव न वैराणि कृतान्यपि।\nसन्तः प्रतिविजानन्तो लब्धसम्भावनाः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2016941, "chapter_id": 1353, "verse_number": "२-९४-१०x", "content_sanskrit": "भीम उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2016942, "chapter_id": 1353, "verse_number": "२-९४-१०", "content_sanskrit": "इहैवैतानहं सर्वान्हन्मि शत्रून्समागतान्।\nअथ निष्क्रम्य राजेन्द्र समूलान्हन्मि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2016943, "chapter_id": 1353, "verse_number": "२-९४-११", "content_sanskrit": "किं नो विवदितेनेह किमुक्तेन च भारत।\nअद्यैवैतान्निहन्मीह प्रशाधि पृथिवीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2016944, "chapter_id": 1353, "verse_number": "२-९४-१२", "content_sanskrit": "इत्युक्त्वा भीमसेनस्तु कनिष्ठैर्भ्रातृभिः सह।\nमृगमध्ये यथा सिंहो मुहुर्मुहुरुदैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2016945, "chapter_id": 1353, "verse_number": "२-९४-१३", "content_sanskrit": "सान्त्व्यमानो वीक्षमाणः पार्थेनाक्लिष्टकर्मणा।\nखिद्यत्येव महाबाहुरन्तर्दाहेन वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2016946, "chapter_id": 1353, "verse_number": "२-९४-१४", "content_sanskrit": "क्रुद्धस्य तस्य स्रोतोभ्यः कर्णादिभ्यो नराधिप।\nसधूमः सस्फुलिङ्गार्चिः पावकः समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2016947, "chapter_id": 1353, "verse_number": "२-९४-१५", "content_sanskrit": "भ्रुकुटीकृतदुष्प्रेक्ष्यमभवत्तस्य तन्मुखम्।\nयुगान्तकाले सम्प्राप्ते कृतान्तस्येव रूपिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2016948, "chapter_id": 1353, "verse_number": "२-९४-१६", "content_sanskrit": "युधिष्ठिरस्तमावार्य बाहुना बाहुशालिनम्।\nमैवमित्यब्रवीच्चैनं जोषमास्वेति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2016949, "chapter_id": 1353, "verse_number": "२-९४-१७", "content_sanskrit": "निवार्य च महाबाहुं कोपसंरक्तलोचनम्।\nपितरं समुपातिष्ठद्धृतराष्ट्रं कृताञ्जलिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2016950, "chapter_id": 1353, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि चतुर्नवतितमोऽध्यायः॥९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]