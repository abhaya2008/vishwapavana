[{"id": 5000062000, "chapter_id": 9062, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे द्विषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000062001, "chapter_id": 9062, "verse_number": "१-६२-१", "content_sanskrit": "शुनःशेपं नरश्रेष्ठ गृहीत्वा तु महायशाः।\nव्यश्रमत् पुष्करे राजा मध्याह्ने रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000062002, "chapter_id": 9062, "verse_number": "१-६२-२", "content_sanskrit": "तस्य विश्रममाणस्य शुनःशेपो महायशाः।\nपुष्करं ज्येष्ठमागम्य विश्वामित्रं ददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000062003, "chapter_id": 9062, "verse_number": "१-६२-३", "content_sanskrit": "तप्यन्तमृषिभिः सार्धं मातुलं परमातुरः।\nविषण्णवदनो दीनस्तृष्णया च श्रमेण च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000062004, "chapter_id": 9062, "verse_number": "१-६२-४", "content_sanskrit": "पपाताङ्के मुने राम वाक्यं चेदमुवाच ह।\nन मेऽस्ति माता न पिता ज्ञातयो बान्धवाः कुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000062005, "chapter_id": 9062, "verse_number": "१-६२-५", "content_sanskrit": "त्रातुमर्हसि मां सौम्य धर्मेण मुनिपुंगव।\nत्राता त्वं हि नरश्रेष्ठ सर्वेषां त्वं हि भावनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000062006, "chapter_id": 9062, "verse_number": "१-६२-६", "content_sanskrit": "राजा च कृतकार्यः स्यादहं दीर्घायुरव्ययः।\nस्वर्गलोकमुपाश्नीयां तपस्तप्त्वा ह्यनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000062007, "chapter_id": 9062, "verse_number": "१-६२-७", "content_sanskrit": "स मे नाथो ह्यनाथस्य भव भव्येन चेतसा।\nपितेव पुत्रं धर्मात्मंस्त्रातुमर्हसि किल्बिषात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000062008, "chapter_id": 9062, "verse_number": "१-६२-८", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा विश्वामित्रो महातपाः।\nसान्त्वयित्वा बहुविधं पुत्रानिदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000062009, "chapter_id": 9062, "verse_number": "१-६२-९", "content_sanskrit": "यत्कृते पितरः पुत्राञ्जनयन्ति शुभार्थिनः।\nपरलोकहितार्थाय तस्य कालोऽयमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000062010, "chapter_id": 9062, "verse_number": "१-६२-१०", "content_sanskrit": "अयं मुनिसुतो बालो मत्तः शरणमिच्छति।\nअस्य जीवितमात्रेण प्रियं कुरुत पुत्रकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000062011, "chapter_id": 9062, "verse_number": "१-६२-११", "content_sanskrit": "सर्वे सुकृतकर्माणः सर्वे धर्मपरायणाः।\nपशुभूता नरेन्द्रस्य तृप्तिमग्नेः प्रयच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000062012, "chapter_id": 9062, "verse_number": "१-६२-१२", "content_sanskrit": "नाथवांश्च शुनःशेपो यज्ञश्चाविघ्नतो भवेत्।\nदेवतास्तर्पिताश्च स्युर्मम चापि कृतं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000062013, "chapter_id": 9062, "verse_number": "१-६२-१३", "content_sanskrit": "मुनेस्तद् वचनं श्रुत्वा मधुच्छन्दादयः सुताः।\nसाभिमानं नरश्रेष्ठ सलीलमिदमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000062014, "chapter_id": 9062, "verse_number": "१-६२-१४", "content_sanskrit": "कथमात्मसुतान् हित्वा त्रायसेऽन्यसुतं विभो।\nअकार्यमिव पश्यामः श्वमांसमिव भोजने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000062015, "chapter_id": 9062, "verse_number": "१-६२-१५", "content_sanskrit": "तेषां तद् वचनं श्रुत्वा पुत्राणां मुनिपुंगवः।\nक्रोधसंरक्तनयनो व्याहर्तुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000062016, "chapter_id": 9062, "verse_number": "१-६२-१६", "content_sanskrit": "निःसाध्वसमिदं प्रोक्तं धर्मादपि विगर्हितम्।\nअतिक्रम्य तु मद्वाक्यं दारुणं रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000062017, "chapter_id": 9062, "verse_number": "१-६२-१७", "content_sanskrit": "श्वमांसभोजिनः सर्वे वासिष्ठा इव जातिषु।\nपूर्णं वर्षसहस्रं तु पृथिव्यामनुवत्स्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000062018, "chapter_id": 9062, "verse_number": "१-६२-१८", "content_sanskrit": "कृत्वा शापसमायुक्तान् पुत्रान् मुनिवरस्तदा।\nशुनःशेपमुवाचार्तं कृत्वा रक्षां निरामयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000062019, "chapter_id": 9062, "verse_number": "१-६२-१९", "content_sanskrit": "पवित्रपाशैराबद्धो रक्तमाल्यानुलेपनः।\nवैष्णवं यूपमासाद्य वाग्भिरग्निमुदाहर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000062020, "chapter_id": 9062, "verse_number": "१-६२-२०", "content_sanskrit": "इमे च गाथे द्वे दिव्ये गायेथा मुनिपुत्रक।\nअम्बरीषस्य यज्ञेऽस्मिंस्ततः सिद्धिमवाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000062021, "chapter_id": 9062, "verse_number": "१-६२-२१", "content_sanskrit": "शुनःशेपो गृहीत्वा ते द्वे गाथे सुसमाहितः।\nत्वरया राजसिंहं तमम्बरीषमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000062022, "chapter_id": 9062, "verse_number": "१-६२-२२", "content_sanskrit": "राजसिंह महाबुद्धे शीघ्रं गच्छावहे वयम्।\nनिवर्तयस्व राजेन्द्र दीक्षां च समुदाहर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000062023, "chapter_id": 9062, "verse_number": "१-६२-२३", "content_sanskrit": "तद् वाक्यमृषिपुत्रस्य श्रुत्वा हर्षसमन्वितः।\nजगाम नृपतिः शीघ्रं यज्ञवाटमतन्द्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000062024, "chapter_id": 9062, "verse_number": "१-६२-२४", "content_sanskrit": "सदस्यानुमते राजा पवित्रकृतलक्षणम्।\nपशुं रक्ताम्बरं कृत्वा यूपे तं समबन्धयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000062025, "chapter_id": 9062, "verse_number": "१-६२-२५", "content_sanskrit": "स बद्धो वाग्भिरग्र्याभिरभितुष्टाव वै सुरौ।\nइन्द्रमिन्द्रानुजं चैव यथावन्मुनिपुत्रकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000062026, "chapter_id": 9062, "verse_number": "१-६२-२६", "content_sanskrit": "ततः प्रीतः सहस्राक्षो रहस्यस्तुतितोषितः।\nदीर्घमायुस्तदा प्रादाच्छुनःशेपाय वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000062027, "chapter_id": 9062, "verse_number": "१-६२-२७", "content_sanskrit": "स च राजा नरश्रेष्ठ यज्ञस्य च समाप्तवान्।\nफलं बहुगुणं राम सहस्राक्षप्रसादजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000062028, "chapter_id": 9062, "verse_number": "१-६२-२८", "content_sanskrit": "विश्वामित्रोऽपि धर्मात्मा भूयस्तेपे महातपाः।\nपुष्करेषु नरश्रेष्ठ दशवर्षशतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000062029, "chapter_id": 9062, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे द्विषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]