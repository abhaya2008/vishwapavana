[{"id": 7003069000, "chapter_id": 23069, "verse_number": "४-३-१", "content_sanskrit": "श्रीनारायण उवाच ।\nराधा रतिगृहं गत्वा न ददर्श हरिं मुने ।\nविरजां च सरिदूपां दृष्ट्वा गेहं जगाम सा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003069001, "chapter_id": 23069, "verse_number": "४-३-२", "content_sanskrit": "श्रीकृष्णो विरजां दृष्ट्वा सरिद्रूपां प्रियां सतीम् ।\nउच्चै रुरोद विरजातीरे नीरमनोहरे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003069002, "chapter_id": 23069, "verse_number": "४-३-३", "content_sanskrit": "ममांतिकं समागच्छ प्रेयसीनां परे वरे ।\nत्वया विनाऽहं सुभगे कथं जीवामि सुंदरि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003069003, "chapter_id": 23069, "verse_number": "४-३-४", "content_sanskrit": "नद्यधिष्ठात्रि देवि त्वं भव मूर्तिमती सती ।\nममाशिषा रूपवती सुंदरी योषिता वरा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003069004, "chapter_id": 23069, "verse_number": "४-३-५", "content_sanskrit": "पूर्वरूपाच्च सौभाग्यादिदानीं सुभगा भव ।\nपुरातनं शरीरं ते सरिदूपमभूत्सति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003069005, "chapter_id": 23069, "verse_number": "४-३-६", "content_sanskrit": "जलादुत्थाय चागच्छ विधाय तनुमुत्तमाम्।\nअष्टौ सिद्धीर्मया दत्ताः सुरसुंदरि सत्वरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003069006, "chapter_id": 23069, "verse_number": "४-३-७", "content_sanskrit": "कृष्णाज्ञया च विरजा विधाय तनुमुत्तमाम् ।\nआजगाम हरेरग्रे साक्षाद्राधेव सुंदरी ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003069007, "chapter_id": 23069, "verse_number": "४-३-८", "content_sanskrit": "पीतवस्त्रपरीधाना स्मेराननसरोरुहा ।\nपश्यंतं प्राणनाथं च पश्यंती वक्रचक्षुषा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003069008, "chapter_id": 23069, "verse_number": "४-३-९", "content_sanskrit": "नितंबश्रोणिभारार्ता पीनोन्नतपयोधरा ।\nमानिनी मानिनीनां च गजेंद्रमंदगामिनी ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003069009, "chapter_id": 23069, "verse_number": "४-३-१०", "content_sanskrit": "सुंदरी सुदरीणां च धन्या मान्या च योषिताम् ।\nचारुचंपकवर्णाभा पक्वबिंबाधरा वरा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003069010, "chapter_id": 23069, "verse_number": "४-३-११", "content_sanskrit": "पक्व दाडिमबीजाभदंतपंक्तिमनोहरा ।\nशरत्पार्वणचंद्रास्या फुल्लेंदीवरलोचना ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003069011, "chapter_id": 23069, "verse_number": "४-३-१२", "content_sanskrit": "कस्तूरीबिंदुना सार्धं सिंदूरबिंदुभूषिता ।\nचारुपत्रक शोभाढ्या सुचारुकबरीयुता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003069012, "chapter_id": 23069, "verse_number": "४-३-१३", "content_sanskrit": "रत्नकुंडलगंडस्था भूषिता रत्नमालया ।\nगजमौक्तिकनासाग्रा मुक्ताहारविराजिता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003069013, "chapter_id": 23069, "verse_number": "४-३-१४", "content_sanskrit": "रत्नकंकणकेयूरचारुशंखकरोज्ज्वला ।\nकिंकिणीजालशब्दाढ्या रत्नमंजीररंजिता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003069014, "chapter_id": 23069, "verse_number": "४-३-१५", "content_sanskrit": "तां च रूपवतीं दृष्ट्वा प्रेमोद्रेका जगत्पतिः ।\nचकारालिंगनं तूर्णं चुचुंब च मुहुर्मुहुः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003069015, "chapter_id": 23069, "verse_number": "४-३-१६", "content_sanskrit": "नानाप्रकारशृंगारं विपरीतादिकं विभुः ।\nरहसि प्रेयसीं प्राप्य चकार च पुनः पुनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003069016, "chapter_id": 23069, "verse_number": "४-३-१७", "content_sanskrit": "विरजा सा रजोयुक्ता धृत्वा वीर्यममोघकम् ।\nसद्यो बभूव तत्रैव धन्या गर्भवती स ती ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003069017, "chapter_id": 23069, "verse_number": "४-३-१८", "content_sanskrit": "दधार गर्भमीशस्य दिव्यं वर्षशतं च सा ।\nततः सुषाव तत्रैव पुत्रान्सप्त मनोहरान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003069018, "chapter_id": 23069, "verse_number": "४-३-१९", "content_sanskrit": "माता सा सप्तपुत्राणां श्रीकृष्णस्य प्रिया सती ।\nतस्थौ तत्र सुखासीना सार्द्धं पुत्रैश्च सप्तभिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003069019, "chapter_id": 23069, "verse_number": "४-३-२०", "content_sanskrit": "एकदा हरिणा सार्द्धं वृंदारण्ये च निर्जने ।\nविजहार पुनः साध्वी शृंगारासक्तमानसा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003069020, "chapter_id": 23069, "verse_number": "४-३-२१", "content_sanskrit": "एतस्मिन्नंतरे तत्र मातुः क्रोडं जगाम ह ।\nकनिष्ठपुत्रस्तस्याश्च भ्रातृभिः पीडितो भिया ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003069021, "chapter_id": 23069, "verse_number": "४-३-२२", "content_sanskrit": "भीतं स्वतनयं दृष्ट्वा तत्याज तां कृपानिधिः ।\nक्रोडे चकार बालं सा कृष्णो राधागृहं ययौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003069022, "chapter_id": 23069, "verse_number": "४-३-२३", "content_sanskrit": "प्रबोध्य बालं सा साध्वी न ददर्शांतिके प्रियम् ।\nविललाप भृशं तत्र शृंगारातृप्तमानसा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003069023, "chapter_id": 23069, "verse_number": "४-३-२४", "content_sanskrit": "शशाप स्वसुतं कोपाल्लवणोदो भविष्यसि।\nकदाऽपि ते जलं केचिन्न खादिष्यंति जीविनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003069024, "chapter_id": 23069, "verse_number": "४-३-२५", "content_sanskrit": "शशाप बालान्सर्वांश्च यांतु मूढा महीतलम् ।\nगच्छध्वं च महीं मूढा जंबुद्वीपं मनोहरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003069025, "chapter_id": 23069, "verse_number": "४-३-२६", "content_sanskrit": "स्थितिर्नैकत्र युष्माकं भविष्यति पृथक्पृथक् ।\nद्वीपे द्वीपे स्थितिं कृत्वा तिष्ठंतु सुखिनः सदा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003069026, "chapter_id": 23069, "verse_number": "४-३-२७", "content_sanskrit": "द्वीपस्थाभिर्नदीभिश्च सह क्रीडंतु निर्जने ।\nकनिष्ठो मातृशापाच्च लवणोदो बभूव ह ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003069027, "chapter_id": 23069, "verse_number": "४-३-२८", "content_sanskrit": "कनिष्ठः कथयामास मातृशापं च बालकान् ।\nआजग्मुर्दुःखिताः सर्वे मातृस्थाने च बालकाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003069028, "chapter_id": 23069, "verse_number": "४-३-२९", "content_sanskrit": "श्रुत्वा विवरणं सर्वे प्रजग्मुर्धरणीतलम् ।\nप्रणम्य चरणं मातुर्भक्तिनम्रात्ममूर्तयः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003069029, "chapter_id": 23069, "verse_number": "४-३-३०", "content_sanskrit": "सप्तद्वीपसमुद्राश्च सप्त तस्थुर्विभागशः ।\nकनिष्ठाद्वृद्धपर्यंतं द्विगुणं द्विगुणं मुने ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003069030, "chapter_id": 23069, "verse_number": "४-३-३१", "content_sanskrit": "लवणेक्षुसुरा सर्पिर्दधिदुग्धजलार्णवाः ।\nएतेषां च जलं पृथ्व्यां सस्यार्थं च भविष्यति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003069031, "chapter_id": 23069, "verse_number": "४-३-३२", "content_sanskrit": "व्याप्ताः समुद्राः सप्तैव सप्तद्वीपां वसुंधराम् ।\nरुरुदुर्बालकाः सर्वे मातृभ्रातृशुचाऽन्विताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003069032, "chapter_id": 23069, "verse_number": "४-३-३३", "content_sanskrit": "रुरोद च भृशं साध्वी पुत्रविच्छेदकातरा ।\nमूर्च्छामवाप शोकेन पुत्राणां भर्तुरेव च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003069033, "chapter_id": 23069, "verse_number": "४-३-३४", "content_sanskrit": "तां शोकसागरे मग्नां विज्ञाय राधिकापतिः ।\nआजगाम पुनस्तस्याः स्मेराननसरोरुहः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003069034, "chapter_id": 23069, "verse_number": "४-३-३५", "content_sanskrit": "दृष्ट्वा हरिं सा तत्याज शोकं रोदनमेव च ।\nआनन्दसागरे मग्ना दृष्ट्वा कांतं बभूव ह ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003069035, "chapter_id": 23069, "verse_number": "४-३-३६", "content_sanskrit": "चकार श्रीहरिं क्रोडे विजहार स्मरातुरा ।\nतां च पुत्र परित्यक्तां हरिस्तुष्टो बभूव  ह३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003069036, "chapter_id": 23069, "verse_number": "४-३-३७", "content_sanskrit": "वरं तस्यै ददौ प्रीत्या प्रसन्नवदनेक्षणः ।\nकांते नित्यं तव स्थानमागमिष्यामि निश्चितम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003069037, "chapter_id": 23069, "verse_number": "४-३-३८", "content_sanskrit": "यथा राधा तत्समा त्वं भविष्यसि प्रिया मम ।\nपुत्रान्द्रक्ष्यसि नित्यं त्वं मद्वरस्य प्रसादतः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003069038, "chapter_id": 23069, "verse_number": "४-३-३९", "content_sanskrit": "इत्युक्तवंतं श्रीकृष्णं वसंतं विरजांतिके ।\nदृष्ट्वा राधावयस्याश्च कथयामासुरीश्वरीम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003069039, "chapter_id": 23069, "verse_number": "४-३-४०", "content_sanskrit": "श्रुत्वा रुरोष सा देवी सुष्वाप क्रोधमंदिरे ।\nएतस्मिन्नंतरे कृष्णो जगाम राधिकांतिकम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003069040, "chapter_id": 23069, "verse_number": "४-३-४१", "content_sanskrit": "स तस्थौ राधिकाद्वारे श्रीदाम्ना सह नारद ।\nरासेश्वरी हरिं दृष्ट्वा रुष्टोवाच प्रियं पुरः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003069041, "chapter_id": 23069, "verse_number": "४-३-४२", "content_sanskrit": "मत्तो बहुतराः कांता गोलोके संति ते हरे ।\nयाहि तासां सन्निधानं मया ते किं प्रयोजनम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003069042, "chapter_id": 23069, "verse_number": "४-३-४३", "content_sanskrit": "विरजा प्रेयसी कांता सरिद्रूपा बभूव ह ।\nदेहं त्यक्त्वा मम भयात्तथाऽपि याहि तां प्रति ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003069043, "chapter_id": 23069, "verse_number": "४-३-४४", "content_sanskrit": "तत्तीरे मंदिरं कृत्वा तिष्ठ तिष्ठ च याहि ताम्।\nनदी बभूव सा त्वं च नदो भवितुमर्हसि ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003069044, "chapter_id": 23069, "verse_number": "४-३-४५", "content_sanskrit": "नदस्य नद्या सार्द्धं च संगमो गुणवान्भवेत् ।\nस्वजातौ परमा प्रीतिः शयने भोजने सुखात् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003069045, "chapter_id": 23069, "verse_number": "४-३-४६", "content_sanskrit": "देवचूडामणेः क्रीडा नद्या सार्द्धमहो बत ।\nमहाजनः स्मेरमुखः श्रुत्वा सद्यो भविष्यति ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003069046, "chapter_id": 23069, "verse_number": "४-३-४७", "content_sanskrit": "ये त्वां वदंति सर्वेशं ते किं जानंति तत्त्वतः ।\nभगवान्सर्वभूतात्मा नदीं संभोक्तुमिच्छति ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003069047, "chapter_id": 23069, "verse_number": "४-३-४८", "content_sanskrit": "इत्युक्त्वा राधिका देवी विरराम रुषाऽन्विता ।\nनोत्तस्थौ भूमिशयनाद्गोपीलक्षसमन्विता ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003069048, "chapter_id": 23069, "verse_number": "४-३-४९", "content_sanskrit": "काश्चिच्चामरहस्ताश्च काश्चित्सूक्ष्मांशुकांबराः ।\nकाश्चित्तांबूलहस्ताश्च काश्चिन्मालाकरा वराः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003069049, "chapter_id": 23069, "verse_number": "४-३-५०", "content_sanskrit": "वासितोदकराः काश्चित्काश्चित्पद्मकरा वराः ।\nकाश्चित्सिंदूरहस्ताश्च पानहस्ताश्च काश्चन ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003069050, "chapter_id": 23069, "verse_number": "४-३-५१", "content_sanskrit": "रत्नालंकारहस्ताश्च काश्चित्कज्जलवाहिकाः ।\nवेणुवीणाकराः काश्चित्काश्चित्कंकतिकाकराः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003069051, "chapter_id": 23069, "verse_number": "४-३-५२", "content_sanskrit": "काश्चिदावीरहस्ताश्च यंत्रहस्ताश्च काश्चन ।\nसुगंधितैलहस्ताश्च काश्चन प्रमदोत्तमाः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003069052, "chapter_id": 23069, "verse_number": "४-३-५३", "content_sanskrit": "करतालकराः काश्चिद्गेंदुहस्ताश्च काश्चन ।\nकाश्चिन्मृदंगमुरजमुरलीतानकारिकाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003069053, "chapter_id": 23069, "verse_number": "४-३-५४", "content_sanskrit": "संगीतनिपुणाः काश्चित्काश्चिन्नर्तनतत्पराः ।\nक्रीडावस्तुकराः काश्चिन्मधुहस्ताश्च काश्चन ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003069054, "chapter_id": 23069, "verse_number": "४-३-५५", "content_sanskrit": "सुधापात्रकराः काश्चिदंघ्रिपीठकराः पराः ।\nवेषवस्तुकराः काश्चित्काश्चिच्चरणसेविकाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003069055, "chapter_id": 23069, "verse_number": "४-३-५६", "content_sanskrit": "पुटांजलिकराः काश्चित्काश्चित्स्तुतिपरा वराः ।\nएवं कतिविधाः संति राधिकापुरतो मुने ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003069056, "chapter_id": 23069, "verse_number": "४-३-५७", "content_sanskrit": "बहिर्देशस्थिताः काश्चित्कोटिशः कोटिशः सदा ।\nकाश्चिद्द्वारनियुक्ताश्च वयस्या वेत्रधारिकाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003069057, "chapter_id": 23069, "verse_number": "४-३-५८", "content_sanskrit": "कृष्णमभ्यंतरं गंतुं न ददुर्द्वारसंस्थिताः ।\nपुरःस्थितं तं प्राणेशं राधा पुनरुवाच सा ।\nनानुरूपमत्यकथ्ययमयोग्यमतिकर्कशम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003069058, "chapter_id": 23069, "verse_number": "४-३-५९", "content_sanskrit": "राधिकोवाच ।\nहे कृष्ण विरजाकांत गच्छ मत्पुरतो हरे ।\nकथं दुनोषि मां लोल रतिचौरातिलंपट ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003069059, "chapter_id": 23069, "verse_number": "४-३-६०", "content_sanskrit": "शीघ्रं पद्मावतीं गच्छ रत्नमालां मनोरमाम् ।\nअथवा वनमालां वा रूपेणाप्रतिमां व्रज ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003069060, "chapter_id": 23069, "verse_number": "४-३-६१", "content_sanskrit": "हे नदीकांत देवेश देवानां च गुरोर्गुरो ।\nमया ज्ञातोऽसि भद्रं ते गच्छ गच्छ ममाश्रमात् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003069061, "chapter_id": 23069, "verse_number": "४-३-६२", "content_sanskrit": "शश्वत्ते मानुषाणां च व्यवहारस्य लंपट ।\nलभतां मानुषीं योनिं गोलोकाद्व्रज भारतम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003069062, "chapter_id": 23069, "verse_number": "४-३-६३", "content_sanskrit": "हे सुशीले शशिकले हे पद्मावति माधवि ।\nनिवार्यतां च धूर्तोऽयं किंमस्यात्र प्रयोजनम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003069063, "chapter_id": 23069, "verse_number": "४-३-६४", "content_sanskrit": "राधिकावचनं श्रुत्वा तमूचुर्गोपिका हरिम् ।\nहितं तथ्यं च विनयं सारं यत्समयोचितम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003069064, "chapter_id": 23069, "verse_number": "४-३-६५", "content_sanskrit": "काश्चिदूचुरिति हरे गच्छ स्थानांतरं क्षणम् ।\nराधाकोपापनयने ह्यागमिष्यामहे वयम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003069065, "chapter_id": 23069, "verse_number": "४-३-६६", "content_sanskrit": "काश्चिदूचुरिति प्रीत्या क्षणं गच्छ गृहांतरम् ।\nत्वयैव वर्धिता राधा त्वां विना कं च वक्ष्यति ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003069066, "chapter_id": 23069, "verse_number": "४-३-६७", "content_sanskrit": "काश्चिदूचुरिति प्रेम्णा राधिकायां हरिं मुने ।\nक्षणं वृंदावनं गच्छ मानापनयनावधि ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003069067, "chapter_id": 23069, "verse_number": "४-३-६८", "content_sanskrit": "काश्चिदित्यूचुरीशं च परिहासपरं वचः ।\nमानापनयनं भक्त्या मानिन्याः कुरु कामुक ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003069068, "chapter_id": 23069, "verse_number": "४-३-६९", "content_sanskrit": "काश्चनोचुरितीशं तं याहि जायांतरं तव ।\nलोलुपस्य कथं नाथ करिष्यामो यथोचितम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003069069, "chapter_id": 23069, "verse_number": "४-३-७०", "content_sanskrit": "काश्चनोचुरिति हरिं सस्मितं पुरतः स्थितम् ।\nगत्वा समीपमुत्थाय मानापनयनं कुरु ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003069070, "chapter_id": 23069, "verse_number": "४-३-७१", "content_sanskrit": "काश्चनोचुरिति प्राणनाथं गोप्यो दुरक्षरम् ।\nकः क्षमः सांप्रतं द्रष्टं राधिकामुखपंकजम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003069071, "chapter_id": 23069, "verse_number": "४-३-७२", "content_sanskrit": "काश्चनोचुरिति विभुं व्रज स्थानांतरं हरे ।\nकोपापनयने काले पुनरागमनं तव ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003069072, "chapter_id": 23069, "verse_number": "४-३-७३", "content_sanskrit": "काश्चनोचुरितीदं तं प्रगल्भाः प्रमदोत्तमाः ।\nवयं त्वां दारयिष्यामो न चेद्याहि गृहांतरम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003069073, "chapter_id": 23069, "verse_number": "४-३-७४", "content_sanskrit": "काश्चिन्निवारयामासुर्माधवं प्रमदोत्तमाः ।\nस्मितवक्त्रं च सर्वेशं स्वस्थमक्रोधमीश्वरम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003069074, "chapter_id": 23069, "verse_number": "४-३-७५", "content_sanskrit": "गोपीर्भिर्वार्यमाणे च जगत्कारणकारणे ।\nसद्यश्चुकोप श्रीदामा हरौ गेहांतरं गते ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003069075, "chapter_id": 23069, "verse_number": "४-३-७६", "content_sanskrit": "कोपादुवाच श्रीदामा राधिकां परमेश्वरीम् ।\nरक्तपद्मेक्षणां रुष्टां रक्तपंकजलोचनाम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003069076, "chapter_id": 23069, "verse_number": "४-३-७७", "content_sanskrit": "श्रीदामोवाच ।\nकथं वदसि मातस्त्वं कटुवाक्यं मदीश्वरम् ।\nविचारणां विना देवि करोषि भर्त्सनं वृथा ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003069077, "chapter_id": 23069, "verse_number": "४-३-७८", "content_sanskrit": "ब्रह्मानंतेशदेवेशं जगत्कारणकारणम् ।\nवाणीपद्मालयामायाप्रकृतीशं च निर्गुणम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003069078, "chapter_id": 23069, "verse_number": "४-३-७९", "content_sanskrit": "स्वात्मारामं पूर्णकामं करोषि त्वं विडंबनम् ।\nदेवीनां प्रवरा त्वं च निबोध यस्य सेवया ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003069079, "chapter_id": 23069, "verse_number": "४-३-८०", "content_sanskrit": "यस्य पादार्चनेनैव सर्वेषामीश्वरी परा ।\nतन्न जानासि कल्याणि किमहं वक्तुमीश्वरः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003069080, "chapter_id": 23069, "verse_number": "४-३-८१", "content_sanskrit": "भ्रूभंगलीलया कृष्णः स्रष्टुं शक्तश्च त्वद्विधाः ।\nकोटिशः कोटिशो देव्यस्तं न जानासि निर्गुणम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003069081, "chapter_id": 23069, "verse_number": "४-३-८२", "content_sanskrit": "वैकुंठे श्रीहरेरस्य चरणांबुजमार्जनम् ।\nकरोति केशैः शश्वच्छ्रीः सेवनं भक्तिपूर्वकम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003069082, "chapter_id": 23069, "verse_number": "४-३-८३", "content_sanskrit": "सरस्वती च स्तवनैः कर्णपीयूषसुंदरैः ।\nसततं स्तौति यं भक्त्या न जानासि तमीश्वरम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003069083, "chapter_id": 23069, "verse_number": "४-३-८४", "content_sanskrit": "भीता च प्रकृतिर्माया सर्वेषां बीजरूपिणी ।\nसततं स्तौति यं भक्त्या तं न जानासि मानिनि ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003069084, "chapter_id": 23069, "verse_number": "४-३-८५", "content_sanskrit": "स्तुवंति सततं वेदा महिम्नः षोडशीं कलाम् ।\nकदापि न विजानंति तं न जानासि भामिनि ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003069085, "chapter_id": 23069, "verse_number": "४-३-८६", "content_sanskrit": "वक्त्रैश्चतुर्भिर्यं ब्रह्मा वेदानां जनको विभुः ।\nस्तौति सेवां च कुरुते चरणांबुजमीश्वरि ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003069086, "chapter_id": 23069, "verse_number": "४-३-८७", "content_sanskrit": "शंकरः पंचभिर्वक्त्रैः स्तौति यं योगिनां गुरुः ।\nसाश्रुपूर्णः सपुलकः सेवते चरणांबुजम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003069087, "chapter_id": 23069, "verse_number": "४-३-८८", "content_sanskrit": "शेषः सहस्रवदनैः परमात्मानमीश्वरम् ।\nसततं स्तौति यं भक्त्या सेवते चरणांबुजम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003069088, "chapter_id": 23069, "verse_number": "४-३-८९", "content_sanskrit": "धर्मःपाता च सर्वेषां साक्षी च जगतां पतिः ।\nभक्त्या च चरणांभोजं सेवते सततं मुदा ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003069089, "chapter_id": 23069, "verse_number": "४-३-९०", "content_sanskrit": "श्वेतद्वीपनिवासी यः पाता विष्णुः स्वयं विभुः ।\nतस्यांशश्च तथा यं यं धार्यतेऽप्यक्षरं परम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003069090, "chapter_id": 23069, "verse_number": "४-३-९१", "content_sanskrit": "सुरासुरमुनींद्राश्च मनवो मानवा बुधाः ।\nसेवंते न हि पश्यंति स्वप्नेऽपि चरणांबुजम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003069091, "chapter_id": 23069, "verse_number": "४-३-९२", "content_sanskrit": "क्षिप्रं रोषं परित्यज्य भज पादांबुजं हरेः। ।\nभ्रूभंगलीलामात्रेण सृष्टिसंहर्तुरेव च ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003069092, "chapter_id": 23069, "verse_number": "४-३-९३", "content_sanskrit": "निमेषमात्रादस्यैव ब्रह्मणः पतनं भवेत् ।\nयस्यैकदिवसेऽप्यष्टाविंशतींद्राः पतंत्यपि ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003069093, "chapter_id": 23069, "verse_number": "४-३-९४", "content_sanskrit": "एवमष्टोत्तरशतमायुर्यस्य जगद्विधेः ।\nत्वं वा काऽन्याश्च वा राधे मदीश्वरवशेऽखिलम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003069094, "chapter_id": 23069, "verse_number": "४-३-९५", "content_sanskrit": "श्रीदाम्नो वचनं श्रुत्वा केवलं कटुमुज्ज्वलम् ।\nसद्यश्चुकोप सा ब्रह्मन्सद्यः प्राणेश्वरी हरेः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003069095, "chapter_id": 23069, "verse_number": "४-३-९६", "content_sanskrit": "रासेश्वरी बहिर्गत्वा तमुवाच ह निष्ठुरम् ।\nस्फुरदोष्ठी मुक्तकेशी रक्तांभोरुहलोचना ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003069096, "chapter_id": 23069, "verse_number": "४-३-९७", "content_sanskrit": "राधिकोवाच ।\nरेरे जाल्म महामूढ शृणु लॆपटकिंकर ।\nत्वं च जानासि सर्वार्थं न जानामि त्वदीश्वरम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003069097, "chapter_id": 23069, "verse_number": "४-३-९८", "content_sanskrit": "त्वदीश्वरश्च श्रीकृष्णो न ह्यस्माकं व्रजाधम ।\nजानामि जनकं स्तौषि सदा निंदसि मातरम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003069098, "chapter_id": 23069, "verse_number": "४-३-९९", "content_sanskrit": "यथाऽसुराश्च त्रिदशा नित्यं निंदंति संततम् ।\nतथा निंदसि मां मूढ तस्मात्त्वमसुरो भव ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003069099, "chapter_id": 23069, "verse_number": "४-३-१००", "content_sanskrit": "गोप व्रजासुरीं योनिं गोलोकाच्च बहिर्भव ।\nमयाऽद्य शप्तो मूढस्त्वं कस्त्वां रक्षितुमीश्वरः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003069100, "chapter_id": 23069, "verse_number": "४-३-१०१", "content_sanskrit": "रासेश्वरी तमित्युक्त्वा सुष्वाप विरराम च ।\nवयस्याः सेवयामासुश्चामरै रत्नमुष्टिभिः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003069101, "chapter_id": 23069, "verse_number": "४-३-१०२", "content_sanskrit": "श्रुत्वा च वचनं तस्याः कोपेन स्फुरिताधरः ।\nशशाप तां च श्रीदामा व्रज योनिं च मानुषीम् ।\nश्रीदामोवाच॥।\nमानुष्या इव कोपस्ते तस्मात्त्वं मानुषी भुवि ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003069102, "chapter_id": 23069, "verse_number": "४-३-१०३", "content_sanskrit": "भविष्यसि न संदेहो मया शप्ता त्वमंबिके ।\nछायया कलया वाऽपि परशक्त्या कलंकिना ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003069103, "chapter_id": 23069, "verse_number": "४-३-१०४", "content_sanskrit": "मूढा रापाणपत्नी त्वां वक्ष्यति जगतीतले ।\nरापाणः श्रीहरेरंशो वैश्यो वृंदावने वने ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003069104, "chapter_id": 23069, "verse_number": "४-३-१०५", "content_sanskrit": "भविष्यति महायोगी  राधाशापेन गर्भजः ।\nगोकुले प्राप्य तं कृष्णं विहरिष्यसि कानने ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003069105, "chapter_id": 23069, "verse_number": "४-३-१०६", "content_sanskrit": "भविता ते वर्षशतं विच्छेदो हरिणा सह ।\nपुनः प्राप्य तमीशं च गोलोकमागमिष्य सि१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003069106, "chapter_id": 23069, "verse_number": "४-३-१०७", "content_sanskrit": "तामित्युक्त्वा च नत्वा च स जगाम हरेः पुरः ।\nगत्वा प्रणम्य श्रीकृष्णं शापाख्यानमुवाच ह ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003069107, "chapter_id": 23069, "verse_number": "४-३-१०८", "content_sanskrit": "आनुपूर्व्यात्तु तत्सर्वं रुरोद च भृशं पुनः ।\nउवाच तं रुदंतं च गच्छध्वं धरणीतलम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003069108, "chapter_id": 23069, "verse_number": "४-३-१०९", "content_sanskrit": "न जेता ते त्रिभुवने ह्यसुरेंद्रो भविष्यसि ।\nकाले शंकरशूलेन देहं त्यक्त्वा ममांतिक म्१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003069109, "chapter_id": 23069, "verse_number": "४-३-११०", "content_sanskrit": "आगमिष्यसि पंचाशद्युगांते तु ममाशिषा ।\nश्रीकृष्णस्य वचः श्रुत्वा तमुवाच शुचाऽन्वितः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003069110, "chapter_id": 23069, "verse_number": "४-३-१११", "content_sanskrit": "त्वद्भक्तिरहितं मां च कदाचिन्न करिष्यसि ।\nइत्युक्त्वा श्रीहरिं नत्वा जगाम स्वाश्रमाद्बहिः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003069111, "chapter_id": 23069, "verse_number": "४-३-११२", "content_sanskrit": "पश्चाज्जगाम सा देवी रुरोद च पुनःपुनः ।\nक्व यासि वत्सेत्युच्चार्य विललाप भृशं सती ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003069112, "chapter_id": 23069, "verse_number": "४-३-११३", "content_sanskrit": "श्रीदामाऽपि च तां नत्वा रुरोद प्रेमविह्वलः ।\nस एव शंखचूडश्च बभूव तुलसीप तिः११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003069113, "chapter_id": 23069, "verse_number": "४-३-११४", "content_sanskrit": "गते श्रीदाम्नि सा देवी जगामेश्वरसन्निधिम् ।\nसर्वं निवेदयामास हरिः प्रत्युत्तरं ददौ ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003069114, "chapter_id": 23069, "verse_number": "४-३-११५", "content_sanskrit": "शोकातुरां च तां कृष्णो बोधयामास प्रेयसीम् ।\nशंखचूडश्च कालेन संप्राप पुनरीश्वरम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003069115, "chapter_id": 23069, "verse_number": "४-३-११६", "content_sanskrit": "राधा जगाम धरणीं वाराहे हरिणा सह ।\nवृषभानुगृहे जन्म ललाभ गोकुले मुने ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003069116, "chapter_id": 23069, "verse_number": "४-३-११७", "content_sanskrit": "इत्येवं कथितं सर्वं श्रीकृष्णाख्यानमंगलम् ।\nसर्वेषां वांछितं सारं किं भूयः श्रोतुमिच्छसि ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}]