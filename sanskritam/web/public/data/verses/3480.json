[{"id": 2115262, "chapter_id": 3480, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115263, "chapter_id": 3480, "verse_number": "१", "content_sanskrit": "स तैः प्राञ्जलिभिः सर्वैः तथेत्युक्तो जनाधिप ।\nजगाम भगवान् व्यासो यथागतमृषिः प्रभुः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115264, "chapter_id": 3480, "verse_number": "२", "content_sanskrit": "गते भगवति व्यासे पाण्डवाः विगतज्वराः ।\nऊषुस्तत्र चिरं कालं वटवृक्षे यथासुखम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115265, "chapter_id": 3480, "verse_number": "३", "content_sanskrit": "शाकमूलफलाहारास्तपः कुर्वन्ति पाण्डवाः ।\nततः परं महाराज तदा कमलमालिका \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115266, "chapter_id": 3480, "verse_number": "४", "content_sanskrit": "रमयन्ती सदा भीमं तत्रतत्र मनोजवा ।\nदिव्याभरणवस्त्राङ्गी दिव्यस्रगनुलेपना \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115267, "chapter_id": 3480, "verse_number": "५", "content_sanskrit": "एवं भ्रातॄन् सप्त मासान् हिडिम्बाऽवासयद् वने ।\nपाण्डवान् भीमसेनार्थं राक्षसी कामरूपिणी\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115268, "chapter_id": 3480, "verse_number": "६", "content_sanskrit": "अतृप्ता भीमसेनस्य सप्तमासोपसङ्गता ।\nसुखं स विहरन् भीमस्तं कालं परिणामयत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115269, "chapter_id": 3480, "verse_number": "७", "content_sanskrit": "ततोऽलभत सा गर्भं राक्षसी कामरूपिणी ।\nप्रजज्ञे राक्षसी पुत्रं भीमसेनान्महाबलात् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115270, "chapter_id": 3480, "verse_number": "८", "content_sanskrit": "विरूपाक्षं महावक्त्रं शङ्कुकर्णं विभीषणम् ।\nभीमरूपं सुताम्राक्षं तीक्ष्णदंष्ट्रं महारवम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115271, "chapter_id": 3480, "verse_number": "९", "content_sanskrit": "महेष्वासं महावीर्यं महासत्वं महाजवम् ।\nमहाकायं महाकालं महापादं महाभुजम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115272, "chapter_id": 3480, "verse_number": "१०", "content_sanskrit": "अमानुषं मानुषजं भीमवेगमरिन्दमम् ।\nबालोऽपि विक्रमं प्राप्तो मानुषेषु विशाम्पते \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115273, "chapter_id": 3480, "verse_number": "११", "content_sanskrit": "सर्वास्त्रेषु परं वीरः प्रकर्षमगमद् बली ।\nसद्यो हि गर्भं राक्षस्यो लभन्ते प्रसवन्ति च \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115274, "chapter_id": 3480, "verse_number": "१२", "content_sanskrit": "कामरूपधराश्चैव भवन्ति बहुरूपिणः ।\nप्रणम्य विकचः पादावगृह्णात् स पितुस्तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115275, "chapter_id": 3480, "verse_number": "१३", "content_sanskrit": "मातुश्च परमेष्वासः तौ च नामास्य चक्रतुः ।\nघटोऽहमुत्कचोऽस्मीति मातरं सोऽभ्यभाषत \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115276, "chapter_id": 3480, "verse_number": "१४", "content_sanskrit": "अभवत् तेन नामास्य घटोत्कच इति स्म ह ।\nअनुरक्तश्च तानासीत् पाण्डवान् स घटोत्कचः ।\nतेषां च दयितो नित्यमात्मभूतो बभूव ह \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115277, "chapter_id": 3480, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकोनषष्ठ्यधिकशततमोऽध्यायः ॥१५०॥ इति हिडिम्बवधपर्वणि सप्तमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115278, "chapter_id": 3480, "verse_number": "", "content_sanskrit": "॥ हिडिम्बवधपर्व समाप्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115279, "chapter_id": 3480, "verse_number": "", "content_sanskrit": "॥ आदिपर्वणि द्वितीयसम्पुटं समाप्तम् ॥\n॥ श्रीमध्वेशार्पणमस्तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]