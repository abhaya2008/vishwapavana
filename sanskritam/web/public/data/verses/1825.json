[{"id": 2037965, "chapter_id": 1825, "verse_number": "५-७०-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037966, "chapter_id": 1825, "verse_number": "५-७०-१", "content_sanskrit": "चक्षुष्मतां वै स्पृहयामि सञ्जय\nद्रक्ष्यन्ति ये वासुदेवं समीपे।\nविभ्राजमानं वपुषा परेण\nप्रकाशयन्तं प्रदिशो दिशश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037967, "chapter_id": 1825, "verse_number": "५-७०-२", "content_sanskrit": "ईरयन्तं भारतीं भारताना-\nमभ्यर्चनीयां शङ्करीं सृञ्जयानाम्।\nबुभूषद्भिर्गर्हणीयामनिन्द्यां\nपरासूनामग्रहणीयरूपाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037968, "chapter_id": 1825, "verse_number": "५-७०-३", "content_sanskrit": "समुद्यन्तं सात्वतमेकवीरं\nप्रणेतारमृषभं यादवानाम्।\nनिहन्तारं क्षोभणं शात्रवाणां\nमुञ्चन्तं च द्विषतां वै यशांसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037969, "chapter_id": 1825, "verse_number": "५-७०-४", "content_sanskrit": "द्रष्टारो हि कुरवस्तं समेता\nमहात्मानं शब्रुहणं वरेण्यम् ।\nब्रुवन्तं वाचमनृशंसरूपां\nवृष्णिश्रेष्ठं मोहयन्तं मदीयान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037970, "chapter_id": 1825, "verse_number": "५-७०-५", "content_sanskrit": "ऋषिं सनातनतभं विपश्चितं\nवाचःसमुद्रं कलशं यतीनाम्।\nअरिष्टनेमिं गरुडं सुपर्णं\nहरिं प्रजानां भुवनस्य धाम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037971, "chapter_id": 1825, "verse_number": "५-७०-६", "content_sanskrit": "सहस्रशीर्षं पुरुषं पुराण-\nमनादिमध्यान्तमनन्तकीर्तिम्।\nशुक्रस्य धातारमजं च नित्यं\nपरं परेषां शरणं प्रपद्ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037972, "chapter_id": 1825, "verse_number": "५-७०-७", "content_sanskrit": "त्रैलोक्यनिर्माणकरं जनित्रं\nदेवासुराणामथ नागरक्षसाम्।\nनराधिपानां विदुषां प्रधान-\nमिन्द्रानुजं तं शरणं प्रपद्ये ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037973, "chapter_id": 1825, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि सप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]