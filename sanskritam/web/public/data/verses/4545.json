[{"id": 2164526, "chapter_id": 4545, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2164527, "chapter_id": 4545, "verse_number": "१", "content_sanskrit": "प्रकाशिते तथा लोके रजसा च समावृते ।\nसमाजग्मुरथो वीराः परस्परवधैषिणः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2164528, "chapter_id": 4545, "verse_number": "२", "content_sanskrit": "ते समेत्य रणे राजन् शस्त्रप्रासासिधारिणः ।\nपरस्परमुदैक्षन्त परस्परकृतागसः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2164529, "chapter_id": 4545, "verse_number": "३", "content_sanskrit": "प्रदीपानां सहस्रैश्च दीप्यमानैः समन्ततः ।\nविरराज तदा भूमिर्द्यौर्ग्रहैरिव भारत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2164530, "chapter_id": 4545, "verse_number": "४", "content_sanskrit": "उल्काशतैः प्रज्वलितै रणभूमिर्व्यराजत ।\nदह्यमानेव लोकानामभावे वै वसुन्धरा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2164531, "chapter_id": 4545, "verse_number": "५", "content_sanskrit": "प्रादीप्यन्त दिशः सर्वाः प्रदीपैस्तैः समन्ततः ।\nवर्षाप्रदोषे खद्योतैर्वृता वृक्षा इवाबभुः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2164532, "chapter_id": 4545, "verse_number": "६", "content_sanskrit": "असज्जन्त ततो वीरा वीरेष्वेव पृथक् पृथक् ।\nनागा नागैः समाजग्मुस्तुरगाः सह वाजिभिः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2164533, "chapter_id": 4545, "verse_number": "७", "content_sanskrit": "रथा रथवरैरेव समाजग्मुर्मुदान्विताः ।\nतस्मिन् रात्रिमुखे घोरे पुत्रस्य तव शासनात्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2164534, "chapter_id": 4545, "verse_number": "८", "content_sanskrit": "ततोऽर्जुनो महाराज कौरवाणामनीकिनीम् ।\nव्यधमत् त्वरया युक्तः क्षपयन् सर्वपार्थिवान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2164535, "chapter_id": 4545, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2164536, "chapter_id": 4545, "verse_number": "९", "content_sanskrit": "तस्मिन् प्रविष्टे संरब्धे मम पुत्रस्य वाहिनीम् ।\nअमृष्यमाणे दुर्धर्षे किं व आसीन्मनस्तदा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2164537, "chapter_id": 4545, "verse_number": "१०", "content_sanskrit": "किममन्यन्त सैन्यानि प्रविष्टे शत्रुतापने ।\nदुर्योधनश्च किं कृत्यं प्राप्तकालममन्यत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2164538, "chapter_id": 4545, "verse_number": "११", "content_sanskrit": "के चैनं समरे वीरं प्रत्युद्ययुररिन्दमम् ।\nकेऽरक्षन् दक्षिणं चक्रं के च द्रोणस्य सव्यतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2164539, "chapter_id": 4545, "verse_number": "१२", "content_sanskrit": "के पृष्ठतोऽस्य ह्यभवन् वीरा वीरस्य युद्ध्यतः ।\nके पुरस्तादगच्छन्त निघ्नतः शात्रवान् रणे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2164540, "chapter_id": 4545, "verse_number": "१३", "content_sanskrit": "यत् प्राविशन् महेष्वासः पाञ्चालानपराजितः ।\nनृत्यन्निव नरव्याघ्रो रथमार्गेषु वीर्यवान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2164541, "chapter_id": 4545, "verse_number": "१४", "content_sanskrit": "ददाह च शरैर्द्रोणः पाञ्चालानां रथव्रजान् ।\nधूमकेतुरिव क्रुद्धः स कथं मृत्युमीयिवान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2164542, "chapter_id": 4545, "verse_number": "१५", "content_sanskrit": "अव्यग्रानेव हि परान् कथयस्यपराजितान् ।\nहतांश्चैव विषण्णांश्च विप्रकीर्णांश्च शंससि ।\nरथिनो विरथांश्चैव कृतान् युद्धेषु मामकान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2164543, "chapter_id": 4545, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2164544, "chapter_id": 4545, "verse_number": "१६", "content_sanskrit": "द्रोणस्य मतमाज्ञाय योद्धुकामस्य तां निशाम् ।\nदुर्योधनो महाराज वश्यान् भ्रातॄनभाषत\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2164545, "chapter_id": 4545, "verse_number": "१७", "content_sanskrit": "विकर्णं चित्रसेनं च महाबाहुं च कौरवम् ।\nदुर्धर्षं दीर्घबाहुं च ये च तेषां पदानुगाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2164546, "chapter_id": 4545, "verse_number": "१८", "content_sanskrit": "द्रोणं यत्ताः पराक्रान्ताः सर्वे रक्षत पृष्ठतः ।\nहार्दिक्यो दक्षिणं चक्रं शल्यश्चैवोत्तरं तथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2164547, "chapter_id": 4545, "verse_number": "१९", "content_sanskrit": "त्रिगर्तानां च ये शूरा हतशिष्टा महारथाः ।\nतांश्चैव सर्वान् पुत्रस्ते समचोदयदग्रतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2164548, "chapter_id": 4545, "verse_number": "२०", "content_sanskrit": "आचार्यो हि सुसंयत्तो भृशं यत्ताश्च पाण्डवाः ।\nतं रक्षत सुसंयत्ता निघ्नन्तं शात्रवान् रणे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2164549, "chapter_id": 4545, "verse_number": "२१", "content_sanskrit": "द्रोणो हि बलवान् युद्धे क्षिप्रहस्तः पराक्रमी ।\nनिर्जयेत् त्रिदशान् युद्धे किमु पार्थान् ससोमकान्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2164550, "chapter_id": 4545, "verse_number": "२२", "content_sanskrit": "ते यूयं सहिताः सर्वे भृशं यत्ता महारथाः ।\nद्रोणं रक्षत पाञ्चाल्याद् धृष्टद्युम्नान्महारथात्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2164551, "chapter_id": 4545, "verse_number": "२३", "content_sanskrit": "पाण्डवेयेषु सैन्येषु योधं पश्याम्यहं न तम् ।\nयो जयेत रणे द्रोणं धृष्टद्युम्नादृते नृपाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2164552, "chapter_id": 4545, "verse_number": "", "content_sanskrit": "तस्य सर्वात्मना मन्ये भारद्वाजस्य रक्षणम् ।\nस गुप्तः सोमकान् हन्यात् सृञ्जयांश्च सराजकान्॥२४।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2164553, "chapter_id": 4545, "verse_number": "२५", "content_sanskrit": "सृञ्जयेष्वथ सर्वेषु निहतेषु चमूमुखे ।\nधृष्टद्युम्नं रणे द्रौणिर्नाशयिष्यत्यसंशयम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2164554, "chapter_id": 4545, "verse_number": "२६", "content_sanskrit": "तथार्जुनं रणे कर्णो विजेष्यति महारथः ।\nभीमसेनमहं चापि युद्धे जेष्यामि दंसितः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2164555, "chapter_id": 4545, "verse_number": "२७", "content_sanskrit": "सोऽयं मम जयो व्यक्तं दीर्घकालं भविष्यति ।\nतस्माद् रक्षत सङ्ग्रामे द्रोणमेव महारथाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2164556, "chapter_id": 4545, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2164557, "chapter_id": 4545, "verse_number": "२८", "content_sanskrit": "इत्युक्त्वा भरतश्रेष्ठ पुत्रो दुर्योधनस्तव ।\nव्यादिदेश ततः सैन्यं तस्मिंस्तमसि दारुणे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2164558, "chapter_id": 4545, "verse_number": "२९", "content_sanskrit": "ततः प्रववृते युद्धं रात्रौ तद् भरतर्षभ ।\nउभयोः सेनयोर्घोरं विजयं प्रति काङ्क्षिणोः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2164559, "chapter_id": 4545, "verse_number": "३०", "content_sanskrit": "अर्जुनः कौरवं सैन्यमर्जुनं चापि कौरवाः ।\nनानाशस्त्रसमावापैरन्योन्यं पर्यपीडयन्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2164560, "chapter_id": 4545, "verse_number": "३१", "content_sanskrit": "द्रौणिः पाञ्चालराजानं भारद्वाजश्च सृञ्जयान् ।\nछादयामासतुः सङ्खे शरैः सन्नतपर्वभिः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2164561, "chapter_id": 4545, "verse_number": "३२", "content_sanskrit": "पाण्डुपाञ्चालसेनानां कौरवाणां च मारिष ।\nआसीन्निष्टानको घोरो निघ्नतामितरेतरम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2164562, "chapter_id": 4545, "verse_number": "३३", "content_sanskrit": "नैवास्माभिर्न पूर्वैर्नो दृष्टपूर्वं तथाविधम् ।\nयुद्धं यादृशमेवासीत् तां रात्रिं सुमहाभयम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2164563, "chapter_id": 4545, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि पञ्चाशदधिकशततमोऽध्यायः ॥ १५० ॥\nघटोत्कचवधपर्वणि सप्तदशोऽध्यायः ॥ १७ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]