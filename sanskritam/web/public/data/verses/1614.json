[{"id": 2028334, "chapter_id": 1614, "verse_number": "३-२५२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028335, "chapter_id": 1614, "verse_number": "३-२५२-१", "content_sanskrit": "प्रायोपविष्टं राजानं दुर्योधनममर्षणम्।\nउवाच सान्त्वयन्राजञ्शकुनिः सौबलस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028336, "chapter_id": 1614, "verse_number": "३-२५२-२", "content_sanskrit": "सम्यगुक्तं हि कर्णेन तच्छ्रुतं कौरव त्वया।\nमया हृतां श्रियं स्फीतां तां मोहादपहासि किम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028337, "chapter_id": 1614, "verse_number": "३-२५२-३", "content_sanskrit": "त्वमबुद्ध्या नृपवर प्राणानुत्स्रष्टुमिच्छसि।\nअद्य वाऽप्यवगन्छामि न वृद्धाः सेवितास्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028338, "chapter_id": 1614, "verse_number": "३-२५२-४", "content_sanskrit": "यः समुत्पतितं हर्षं दैन्यं वा न नियच्छति।\nस नश्यति श्रियं प्राप्य पात्रमाममिवाम्भसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028339, "chapter_id": 1614, "verse_number": "३-२५२-५", "content_sanskrit": "अतिभीरुं मृदुं क्लीबं दीर्घसूत्रं प्रमादिनम्।\nव्यसनाद्विषयाक्रान्तं न भजन्ति नृपं श्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028340, "chapter_id": 1614, "verse_number": "३-२५२-६", "content_sanskrit": "सत्कृतस्य हि ते शोको विपरीते कथं भवेत्।\nमा कृतं शोभनं पार्थैः शोकमालम्ब्य नाशय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028341, "chapter_id": 1614, "verse_number": "३-२५२-७", "content_sanskrit": "यत्र हर्षस्त्वया कार्यः सत्कर्तव्याश्च पाण्डवाः।\nतत्र शोचसि राजेन्द्रविपरीतमिदं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028342, "chapter_id": 1614, "verse_number": "३-२५२-८", "content_sanskrit": "प्रसीदमा त्यजात्मानं तुष्टश्च सुकृतं स्मर।\nकप्रयच्छ राज्यं पार्थानां यशो धर्ममवाप्नुहि।\nक्रियामेतां समाज्ञाय कृतघ्नो न भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028343, "chapter_id": 1614, "verse_number": "३-२५२-९", "content_sanskrit": "सौभ्रात्रं पाण्डवैः कृत्वा समवस्ताप्य चैव तान्।\nपित्र्यं राज्यं प्रयच्छैषां ततः सुखमवाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028344, "chapter_id": 1614, "verse_number": "३-२५२-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028345, "chapter_id": 1614, "verse_number": "३-२५२-१०", "content_sanskrit": "शकुनेस्तु वचः श्रुत्वा दुःशासनमवेक्ष्य च।\nपादयोः पतितं वीरं विकृतं भ्रातृसौहृदात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028346, "chapter_id": 1614, "verse_number": "३-२५२-११", "content_sanskrit": "बाहुभ्यां साधुजाताभ्यां दुःशासनमरिंदमम्।\nउत्थाप्य संपरिष्वज्य प्रीत्याऽजिघ्रत मूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028347, "chapter_id": 1614, "verse_number": "३-२५२-१२", "content_sanskrit": "कर्णसौबलयोश्चापि संश्रुत्य वचनान्यसौ।\nनिर्वेदं परमं गत्वा राजा दुर्योधनस्तदा।\nव्रीडयाऽभिपरीतात्मा नैराश्यमगमत्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028348, "chapter_id": 1614, "verse_number": "३-२५२-१३", "content_sanskrit": "सुहृदां चैव तच्छ्रुत्वा समन्युरिदमब्रवीत्।\nन धर्मधनसौख्येन नैश्वर्येण न चाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028349, "chapter_id": 1614, "verse_number": "३-२५२-१४", "content_sanskrit": "नैव भोगैश्च मे कार्यं मा विहन्यत गच्छत।\nनिश्चितेयं मम मतिः स्थिता प्रायोपवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028350, "chapter_id": 1614, "verse_number": "३-२५२-१५", "content_sanskrit": "गच्छध्वं नगरं सर्वे पूज्याश्च गुरवो मम।\nत एवमुक्ताः प्रत्यूच् राजानमरिमर्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028351, "chapter_id": 1614, "verse_number": "३-२५२-१६", "content_sanskrit": "या गतिस्तव राजेन्द्र साऽस्माकमपि भारत।\nकथं वा संप्रवेक्ष्यामस्त्वद्विहीनाः पुरं वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028352, "chapter_id": 1614, "verse_number": "३-२५२-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028353, "chapter_id": 1614, "verse_number": "३-२५२-१७", "content_sanskrit": "स सुहृद्भिरमात्यैश्च भातृभिः स्वजनेन च।\nबहुप्रकारमप्युक्तो निश्चयान्न व्यचाल्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028354, "chapter_id": 1614, "verse_number": "३-२५२-१८", "content_sanskrit": "दर्भास्तरणमास्तीर्य निश्चयाद्धृतराष्ट्रजः।\nसंस्पृश्यापः शुचिर्भूत्वा भूतले समुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028355, "chapter_id": 1614, "verse_number": "३-२५२-१९", "content_sanskrit": "कुशचीराम्बरधरः परं नियममास्थितः।\nवाग्यतो राजशार्दूलः स स्वर्गगतिकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028356, "chapter_id": 1614, "verse_number": "३-२५२-२०", "content_sanskrit": "मनसोपचितिं कृत्वा निरस् च बहिःक्रियाः।\n`तस्थौप्रायोपवेशेऽथमतिं कृत्वा सुनिश्चयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028357, "chapter_id": 1614, "verse_number": "३-२५२-२१", "content_sanskrit": "अथ तं निश्चयं तस्य बुद्ध्वा दैतेयदानवाः।\nपातालवासिनो रौद्राः पूर्वं देवैर्विनिर्जिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028358, "chapter_id": 1614, "verse_number": "३-२५२-२२", "content_sanskrit": "ते स्वपक्षक्षयं तं तु ज्ञात्वा दुर्योधनस्य वै।\nआह्वानाय तदा चक्रुः कर्म वैतानसंभवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028359, "chapter_id": 1614, "verse_number": "३-२५२-२३", "content_sanskrit": "बृहस्पत्युशनोक्तैश्च मन्त्रैर्मन्त्रविशारदाः।\nअथर्ववेदप्रोक्तैश्च याश्चौपनिषदाः क्रियाः।\nमन्त्रजप्यसमायुक्तास्तास्तदा समवर्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028360, "chapter_id": 1614, "verse_number": "३-२५२-२४", "content_sanskrit": "जुह्वत्यग्नौ हविः क्षीरं मन्त्रवत्सुसमाहिताः।\nब्राह्मणा वेदवेदाङ्गपारगाः सुदृढव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028361, "chapter_id": 1614, "verse_number": "३-२५२-२५", "content_sanskrit": "`अध्वर्यवो दानवानां कर्म प्रावर्तयंस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028362, "chapter_id": 1614, "verse_number": "३-२५२-२६", "content_sanskrit": "कर्मसिद्धौ तदा तत्र जृम्भमाणा महाद्भुता।\nकृत्या समुत्थिता राजन्किं करोमीति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2028363, "chapter_id": 1614, "verse_number": "३-२५२-२७", "content_sanskrit": "आहुर्दैत्याश्च तां तत्र सुप्रीतेनान्तरात्मना।\nप्रायोपविष्टं राजानं धार्तराष्ट्रमिहानय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2028364, "chapter_id": 1614, "verse_number": "३-२५२-२८", "content_sanskrit": "तथेति च प्रतिश्रुत्य सा कृत्या प्रययौ तदा।\nनिमेषादगमच्चापि यत्र राजा सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2028365, "chapter_id": 1614, "verse_number": "३-२५२-२९", "content_sanskrit": "समादाय च राजानं प्रविवेश रसातलम्।\nदानवानां मुहूर्ताच्च पुरतस्तं न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2028366, "chapter_id": 1614, "verse_number": "३-२५२-३०", "content_sanskrit": "तमानीतं नृपं दृष्ट्वा रात्रौ संगत्य दानवाः।\nप्रहृष्टमनसः सर्वे किंचिदुत्फुल्ललोचनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2028367, "chapter_id": 1614, "verse_number": "३-२५२-३१", "content_sanskrit": "`दृढमेनं परिष्यज्य दृष्ट्वा च कुशलं तदा।\nसाभिमानमिदं वाक्यं दुर्योधनमथाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2028368, "chapter_id": 1614, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि द्विपञ्चाशदधिकद्विशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]