[{"id": 2172290, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2172291, "chapter_id": 4673, "verse_number": "१", "content_sanskrit": "तथा निपातिते कर्णे तव सैन्ये च विद्रुते ।\nआश्लिष्य पार्थं दाशार्हो हर्षाद् वचनमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2172292, "chapter_id": 4673, "verse_number": "२", "content_sanskrit": "हतो बलभिदा वृत्रस्त्वया कर्णो धनञ्जय ।\nवृत्रकर्णवधं घोरं कथयिष्यन्ति मानवाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2172293, "chapter_id": 4673, "verse_number": "३", "content_sanskrit": "वज्रेण निहतो वृत्रः संयुगे भूरितेजसा ।\nत्वया तु निहतः कर्णो धनुषा निशितैः शरैः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2172294, "chapter_id": 4673, "verse_number": "४", "content_sanskrit": "तमिमं विक्रमं लोके प्रथितं ते यशोवहम् ।\nनिवेदयावः कौन्तेय धर्मराजाय धीमते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2172295, "chapter_id": 4673, "verse_number": "५", "content_sanskrit": "वधं कर्णस्य सङ्ग्रामे दीर्घकालचिकीर्षितम् ।\nनिवेद्य धर्मराजस्य त्वमानृण्यं गमिष्यसि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2172296, "chapter_id": 4673, "verse_number": "६", "content_sanskrit": "वर्तमाने तु युद्धे वै तव कर्णस्य चोभयोः ।\nद्रष्टुमायोधनं पूर्वमागतो धर्मनन्दनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2172297, "chapter_id": 4673, "verse_number": "७", "content_sanskrit": "सुभृशं गाढविद्धत्वान्नाशकत् स्थातुमाहवे ।\nततः स्वशिबिरं यातः स राजा पुरुषर्षभ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2172298, "chapter_id": 4673, "verse_number": "८", "content_sanskrit": "तथेत्युक्ते केशवस्तु पार्थेन यदुपुङ्गवः ।\nपर्यवर्तयदव्यग्रो रथं रथवरस्य तम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2172299, "chapter_id": 4673, "verse_number": "९", "content_sanskrit": "धृष्टद्युम्नं युधामन्युं माद्रीपुत्रौ वृकोदरम् ।\nयुयुधानं च गोविन्द इदं वचनमब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2172300, "chapter_id": 4673, "verse_number": "१०", "content_sanskrit": "धर्मराजस्य पार्श्वं वै यावद् गच्छाम्यहं त्वरन्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2172301, "chapter_id": 4673, "verse_number": "११", "content_sanskrit": "परानभिमुखा यत्तास्तिष्ठध्वं भद्रमस्तु वः ।\nनिवेद्ये धर्मराजाय हतः कर्णोर्ऽजुनेन वै ।\nतावद्भवद्भिर्यत्तैस्तु भवितव्यं नराधिपैः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2172302, "chapter_id": 4673, "verse_number": "१२", "content_sanskrit": "स तैः शूरैरनुज्ञातो ययौ राजनिवेशनम् ।\nपार्थमादाय गोविन्दो ददर्श च युधिष्ठिरम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2172303, "chapter_id": 4673, "verse_number": "१३", "content_sanskrit": "शयानं राजशार्दूलं काञ्चने शयनोत्तमे ।\nअगृह्णीतां च चरणौ मुदितौ पार्थिवस्य तौ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2172304, "chapter_id": 4673, "verse_number": "१४", "content_sanskrit": "तयोः प्रहर्षमालक्ष्य प्रहारांश्चातिमानुषान् ।\nराधेयं निहतं मत्वा समुत्तस्थौ युधिष्ठिरः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2172305, "chapter_id": 4673, "verse_number": "१५", "content_sanskrit": "उत्थाय स महाबाहुः पुनः पुनररिन्दम ।\nवासुदेवार्जुनौ प्रेम्णा तावुभौ परिषस्वजे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2172306, "chapter_id": 4673, "verse_number": "१६", "content_sanskrit": "ततोऽस्मै तद्यथावृत्तं वासुदेवः प्रियंवदः ।\nकथयामास कर्णस्य निधनं यदुनन्दनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2172307, "chapter_id": 4673, "verse_number": "१७", "content_sanskrit": "ईषदुत्स्मयमानस्तु कृष्णो राजानमब्रवीत् ।\nयुधिष्ठिरं हतामित्रं कृताञ्जलिरथाच्युतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2172308, "chapter_id": 4673, "verse_number": "१८", "content_sanskrit": "दिष्ट्या गाण्डीवधन्वा च पाण्डवश्च वृकोदरः ।\nत्वं चापि कुशली राजन् माद्रीपुत्रौ च पाण्डवौ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2172309, "chapter_id": 4673, "verse_number": "१९", "content_sanskrit": "मुक्ता वीरक्षयादस्मात् सङ्ग्रामाल्लोमहर्षणात् ।\nक्षिप्रमुत्तरकालानि कुरु कार्याणि पार्थिव\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2172310, "chapter_id": 4673, "verse_number": "२०", "content_sanskrit": "हतो वैकर्तनः क्रूरः सूतपुत्रो महाबलः ।\nदिष्ट्या जयसि राजेन्द्र दिष्ट्या वर्धसि पाण्डव\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2172311, "chapter_id": 4673, "verse_number": "२१", "content_sanskrit": "यः स द्यूतजितां कृष्णां प्राहसत् पुरुषाधमः ।\nतस्याद्य सूतपुत्रस्य भूमिः पिबति शोणितम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2172312, "chapter_id": 4673, "verse_number": "२२", "content_sanskrit": "शेतेऽसौ शरदीर्णाङ्गः शत्रुस्ते कुरुपुङ्गव ।\nतं पश्य पुरुषव्याघ्र विभिन्नं बहुधा शरैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2172313, "chapter_id": 4673, "verse_number": "२३", "content_sanskrit": "युधिष्ठिरस्तु दाशार्हं प्रहृष्टः प्रत्यपूजयत् ।\nदिष्ट्या दिष्ट्येति राजेन्द्र प्रीत्या चेदमुवाच ह\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2172314, "chapter_id": 4673, "verse_number": "२४", "content_sanskrit": "नैतच्चित्रं महाबाहो त्वयि देवकिनन्दन ।\nत्वया सारथिना पार्थो यत्कुर्यादद्य पौरुषम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2172315, "chapter_id": 4673, "verse_number": "२५", "content_sanskrit": "पस्पर्श च कुरुश्रेष्ठः सानन्दं दक्षिणं भुजम् ।\nउवाच धर्मभृत् पार्थ उभौ तौ केशवार्जुनौ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2172316, "chapter_id": 4673, "verse_number": "२६", "content_sanskrit": "नरनारायणौ देवौ कथितौ नारदेन ह ।\nधर्मसंस्थापने युक्तौ पुराणौ पुरुषोत्तमौ\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2172317, "chapter_id": 4673, "verse_number": "२७", "content_sanskrit": "असकृच्चापि मेधावी कृष्णद्वैपायनो मम ।\nकथामेतां महाबाहो दिव्यामकथयत् प्रभुः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2172318, "chapter_id": 4673, "verse_number": "२८", "content_sanskrit": "तव कृष्ण प्रभावेण गाण्डीवेन धनञ्जयः ।\nजयत्यभिमुखान् शत्रून्न चासीद्विमुखः क्वचित्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2172319, "chapter_id": 4673, "verse_number": "२९", "content_sanskrit": "जयश्चैव ध्रुवोऽस्माकं न त्वस्माकं पराजयः ।\nयदा त्वं युधि पार्थस्य सारथ्यमुपजग्मिवान्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2172320, "chapter_id": 4673, "verse_number": "३०", "content_sanskrit": "एवमुक्त्वा महाराज तं रथं हेमभूषितम् ।\nदन्तवर्णैर्हयैर्युक्तं कालवालैर्महारथः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2172321, "chapter_id": 4673, "verse_number": "३१", "content_sanskrit": "आस्थाय पुरुषव्याघ्रः स्वबलेनाभिसंवृतः ।\nकृष्णार्जुनाभ्यां वीराभ्यामनुयातं ततः प्रियम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2172322, "chapter_id": 4673, "verse_number": "३२", "content_sanskrit": "प्रययौ बहुवृत्तान्तं द्रष्टुमायोधनं तदा ।\nआभाषमाणस्तौ वीरावुभौ माधवफल्गुनौ\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2172323, "chapter_id": 4673, "verse_number": "३३", "content_sanskrit": "स ददर्श रणे कर्णं शयानं पुरुषर्षभम् ।\nगाण्डीवमुक्तैर्विशिखैः सर्वतः शकलीकृतम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2172324, "chapter_id": 4673, "verse_number": "३४", "content_sanskrit": "सपुत्रं निहतं दृष्ट्वा कर्णं राजा युधिष्ठिरः ।\nप्रशशंस नरव्याघ्रावुभौ माधवपाण्डवौ\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2172325, "chapter_id": 4673, "verse_number": "३५", "content_sanskrit": "अद्य राजास्मि गोविन्द पृथिव्यां भ्रातृभिः सह ।\nत्वया नाथेन वीरेण विदुषा परिपालितः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2172326, "chapter_id": 4673, "verse_number": "३६", "content_sanskrit": "हतं दृष्ट्वा नरव्याघ्रं राधेयमभिमानिनम् ।\nनिराशोऽद्य दुरात्मासौ धार्तराष्ट्रो भविष्यति ।\nजीविताच्चापि राज्याच्च हते कर्णे महारथे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2172327, "chapter_id": 4673, "verse_number": "३७", "content_sanskrit": "त्वत्प्रसादाद् वयं चैव कृतार्थाः पुरुषर्षभः ।\nत्वं च गाण्डीवधन्वा च विजयी यदुनन्दन ।\nदिष्ट्या जयसि गोविन्द दिष्ट्या कर्णो निपातितः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2172328, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2172329, "chapter_id": 4673, "verse_number": "३८", "content_sanskrit": "एवं स बहुशो हृष्टः प्रशसंस जनार्दनम् ।\nअर्जुनं चापि राजेन्द्र धर्मराजो युधिष्ठिरः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2172330, "chapter_id": 4673, "verse_number": "३९", "content_sanskrit": "दृष्ट्वा च कर्णं निहतं सपुत्रं पार्थसायकैः ।\nपुनर्जातमिवात्मानं मेने कुरुकुलोद्वहः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2172331, "chapter_id": 4673, "verse_number": "४०", "content_sanskrit": "ततो भीमप्रभृतिभिः सर्वैश्च भ्रातृभिर्वृतम् ।\nवर्धयन्ति स्म राजानं हर्षयुक्ता महारथाः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2172332, "chapter_id": 4673, "verse_number": "४१", "content_sanskrit": "नकुलः सहदेवश्च पाण्डवश्च वृकोदरः ।\nसात्यकिश्च महाराज वृष्णीनां प्रवरो रथः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2172333, "chapter_id": 4673, "verse_number": "४२", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च पाण्डुपाञ्चालसृञ्जयाः ।\nपूजयन्ति स्म कौन्तेयं निहते सूतनन्दने\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2172334, "chapter_id": 4673, "verse_number": "४३", "content_sanskrit": "ते वर्धयित्वा नृपतिं पाण्डुपुत्रं युधिष्ठिरम् ।\nजितकाशिनो लब्धलक्ष्या युद्धशौण्डाः प्रहारिणः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2172335, "chapter_id": 4673, "verse_number": "४४", "content_sanskrit": "स्तुवन्तः स्तवयुक्ताभिर्वाग्भिः कृष्णौ परन्तपौ ।\nजग्मुः स्वशिबिरायैव मुदा युक्ता महारथाः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2172336, "chapter_id": 4673, "verse_number": "४५", "content_sanskrit": "एवमेष क्षयो वृत्तः सुमहान् लोमहर्षणः ।\nतव दुर्मन्त्रिते राजन्नतीतं किं नु शोचसि\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2172337, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2172338, "chapter_id": 4673, "verse_number": "४६", "content_sanskrit": "श्रुत्वा तदप्रियं राजन् धृतराष्ट्रो महीपतिः ।\nपपात भूमौ निश्चेष्टः कौरव्यः परमार्तिवान्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2172339, "chapter_id": 4673, "verse_number": "४७", "content_sanskrit": "तथा सत्यव्रता देवी गान्धारी धर्मदर्शिनी ।\nतं प्रत्यगृह्णाद् विदुरो नृपतिं सञ्जयस्तदा ।\nपर्याश्वासयतश्चैवं तावुभावेव भूमिपम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2172340, "chapter_id": 4673, "verse_number": "४८", "content_sanskrit": "तथैवोत्थापयामासुर्गान्धारीं राजयोषितः ।\nताभ्यामाश्वासितो राजा तूष्णीमासीद् विचेतनः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2172341, "chapter_id": 4673, "verse_number": "४९", "content_sanskrit": "इदं महायुद्धमखं महात्मनो-\nर्धनञ्जयस्याधिरथेश्च यः पठेत् ।\nस सम्यगिष्टस्य मखस्य यत्फलं\nतदाप्नुयात् संश्रवणाच्च भारत\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2172342, "chapter_id": 4673, "verse_number": "५०", "content_sanskrit": "मखो हि विष्णुर्भगवान् सनातनो\nवहन्ति तं चाग्न्यनिलेन्दुभानवः ।\nअतोऽनसूयुः शृणुते पठेच्च यः\nस सर्वलोकांश्च जयेत्सुखी भवेत्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2172343, "chapter_id": 4673, "verse_number": "५१", "content_sanskrit": "मखो हि विष्णुर्भगवान् सनातनः\nस चात्र देवः परिकीर्त्यते यतः ।\nततः स कामाल्लँभते सुखी नरो\nमहामुनेस्तस्य वचोऽमितं यथा\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2172344, "chapter_id": 4673, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nत्रिनवतितमोऽध्यायः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2172345, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "॥ समाप्तं कर्णपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2172346, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "यादृशं पुस्तकं दृष्ट्वा तादृशं लिखितं मया ।\nअबद्धं वा सुबद्धं वा मम दोषो न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2172347, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "॥ श्रीकृष्णार्पणमस्तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2172348, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "श्रीवेदव्यासाय नमः ॥ ताळपत्रिकायामन्तिमभागे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2172349, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2172350, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "एवं निपातिते कर्णे समरे सव्यसाचिना ।\nअल्पावशिष्टाः कुरवः किमकुर्वत वै द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2172351, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "विदीर्यमाणं च बलं दृष्ट्वा राजा सुयोधनः ।\nपाण्डवैः प्राप्तकालञ्च किं प्रापद्यत कौरवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2172352, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं तदाचक्ष्व द्विजोत्तम ।\nन हि तृप्यामि पूर्वेषां शृण्वानश्चरितं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2172353, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "वैशम्पायनः –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2172354, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "ततः कर्णे हते राजन् धार्तराष्ट्रः सुयोधनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2172355, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "अस्मिन् पर्वणि अमी वृत्तान्ताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2172356, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "कर्णाभिषेकः । त्रिपुरवधोपाख्यानं मद्रराजसारथ्यम् । कर्णशल्यसंवादः । हंसकाकोपाख्यानम् । युधिष्ठिरपराजयः । युधिष्ठिरकिरीटिनो क्रोधः । युधिष्ठिरप्रसादनम् । दुःशासनवधः । वृषसेनवधः । कर्णवधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2172357, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "कर्णपर्व त्विदं श्रुत्वा स्वर्णदानं समाचरेत् ।\nरथं स्वर्णमयं दत्वा सर्वपापैः प्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2172358, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "यज्ञस्य फलमाप्नोति तीर्थस्नानफलं तथा ।\nआधिव्याधिविनिर्मुक्तः परमं पदमाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2172359, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "वाचको यत्तु गां दत्वा सुशीलां स्वर्णभूषिताम् ।\nवस्त्राणि तद्वद् दत्वा तु दीर्घमायुरवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2172360, "chapter_id": 4673, "verse_number": "", "content_sanskrit": "॥ श्रीमध्वेशार्पणमस्तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]