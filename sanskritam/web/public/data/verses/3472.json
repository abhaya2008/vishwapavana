[{"id": 2114942, "chapter_id": 3472, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114943, "chapter_id": 3472, "verse_number": "१", "content_sanskrit": "अथाम्बिकेयः सामात्यः सकर्णश्च ससौबलः ।\nसात्मजः पार्थनाशस्य स्मरंस्तथ्यं जहर्ष च \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114944, "chapter_id": 3472, "verse_number": "२", "content_sanskrit": "भीष्मस्तु राजन् दुर्धर्षो विदुरश्च महामतिः ।\nजहृषाते स्मरन्तौ तौ जातुषाग्नेर्विमोचनम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114945, "chapter_id": 3472, "verse_number": "३", "content_sanskrit": "सत्यशीलगुणाचारै रागैर्जनपदोद्भवैः ।\nद्रोणादयश्च धर्मैश्च तेषां तन्मोचितं विदुः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114946, "chapter_id": 3472, "verse_number": "४", "content_sanskrit": "शौर्यलावण्यमाहात्म्यरूपैः प्राणबलैरपि ।\nस्वस्थान् पार्थानमन्यन्त पौरजानपदास्तदा \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114947, "chapter_id": 3472, "verse_number": "५", "content_sanskrit": "अन्ये जनाः प्राकृताश्च स्त्रियश्च बहुधा तथा ।\nशङ्कमाना वदन्ति स्म दग्धा जीवन्ति वा नवा\t॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114948, "chapter_id": 3472, "verse_number": "६", "content_sanskrit": "पाण्डवाश्च विनिर्गम्य नगराद्वारणावतात् ।\nनदीं गङ्गामनुप्राप्ता सह मात्रा परन्तपाः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114949, "chapter_id": 3472, "verse_number": "७", "content_sanskrit": "दाशेनाद्भुतवेगेन नदीस्रोतोबलेन च ।\nवायुना चानुकूलेन शीघ्रं प्राप्तास्ततस्तु ते \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114950, "chapter_id": 3472, "verse_number": "८", "content_sanskrit": "गुल्मं नळवनं नाम नानाद्रुमवतानि च ।\nअसकृच्चापि सन्तीर्य परम्पारं भुजप्लवाः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114951, "chapter_id": 3472, "verse_number": "९", "content_sanskrit": "अवतीर्णास्ततो नावमुत्सृज्य भरतर्षभाः ।\nजवेन प्र्रययू राजन् दक्षिणां दिशमास्थिताः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114952, "chapter_id": 3472, "verse_number": "१०", "content_sanskrit": "विज्ञाय निशि पन्थानं नक्षत्रैर्दक्षिणामुखाः ।\nयतमाना वनं राजन् गहनं प्रतिपेदिरे \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114953, "chapter_id": 3472, "verse_number": "११", "content_sanskrit": "ततः श्रान्ताः पिपासार्ता निद्रान्धाः पाण्डुनन्दनाः ।\nपुनरूचुर्महावीर्यं भीमसेनमिदं वचः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114954, "chapter_id": 3472, "verse_number": "१२", "content_sanskrit": "इतः कष्टतरं किन्नु यद् वयं गहने वने ।\nदिशश्च न प्रजानीमो गन्तुं चैव नरर्षभाः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114955, "chapter_id": 3472, "verse_number": "१३", "content_sanskrit": "तं च पापं न जानीमो यद्यदग्धः पुरोचनः ।\nकथं नु विप्रमुच्येम भयादस्मादलक्षिताः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114956, "chapter_id": 3472, "verse_number": "१४", "content_sanskrit": "पुनरस्मानुपादाय तथैव व्रज भारत ।\nत्वं हि नो बलवानेको यथा सततगस्तथा \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114957, "chapter_id": 3472, "verse_number": "१५", "content_sanskrit": "इत्युक्तो धर्मराजेन भीमसेनो महाबलः ।\nआदाय कुन्तीं भ्रातॄंश्च जगाम सुमहाबलः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114958, "chapter_id": 3472, "verse_number": "१५१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकपञ्चाशदधिकशततमोऽध्यायः ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114959, "chapter_id": 3472, "verse_number": "९", "content_sanskrit": "॥ इति जतुगृहदाहपर्वणि नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114960, "chapter_id": 3472, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]