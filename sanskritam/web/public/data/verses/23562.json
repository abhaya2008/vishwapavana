[{"id": 7003562000, "chapter_id": 23562, "verse_number": "२०२-१", "content_sanskrit": "अथ नारकिदण्डनकर्मविपाकवर्णनम् ।\nऋषिरुवाच ।\nविस्मयस्तु मया दृष्टस्तस्मिन्नद्भुतदर्शनः ।\nचित्रगुप्तस्य सन्देशो धर्मराजेन धीमतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003562001, "chapter_id": 23562, "verse_number": "२०२-२", "content_sanskrit": "प्राप्नुवन्ति फलं ते वै ये च क्षिप्ताः पुरा जनाः ।\nअग्निना वै प्रतप्तास्ते बद्धा बन्धैः सुदारुणैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003562002, "chapter_id": 23562, "verse_number": "२०२-३", "content_sanskrit": "सन्तप्ता बहवो ये ते तैस्तैः कर्मभिरुल्बणैः ।\nश्यामाश्च दशनाभिर्ये त्विमं शीघ्रं प्रमापय ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003562003, "chapter_id": 23562, "verse_number": "२०२-४", "content_sanskrit": "दुराचारं पापरतं निर्घृणं पापचेतसम् ।\nश्वानस्तु हिंसका ये च भक्षयन्तु दुरात्मकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003562004, "chapter_id": 23562, "verse_number": "२०२-५", "content_sanskrit": "पितृघ्नो मातृगोघ्नस्तु सर्वदोषसमन्वितः ।\nआरोप्य शाल्मलीं घोरां कण्टकैस्तैर्विपाटय ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003562005, "chapter_id": 23562, "verse_number": "२०२-६", "content_sanskrit": "एनं पाचय तैलस्य घृतक्षौद्रस्य वा पुनः ।\nतप्तद्रोण्यां ततो मुंच ताम्रतप्तखले पुनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003562006, "chapter_id": 23562, "verse_number": "२०२-७", "content_sanskrit": "नराधममिमं क्षिप्त्वा प्रदीप्ते हव्यवाहने ।\nततो मनुष्यतां प्राप्य ऋणैस्तत्र प्रदीप्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003562007, "chapter_id": 23562, "verse_number": "२०२-८", "content_sanskrit": "शयनासनहर्त्तारमग्निदायी च यो नरः ।\nवैतरण्यामयं चैव क्षिप्यतामचिरं पुनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003562008, "chapter_id": 23562, "verse_number": "२०२-९", "content_sanskrit": "पापकर्मायमत्यर्थं सर्व तीर्थविनाशकः ।\nतस्य प्रदीप्तः कीलोऽयं वह्नितप्तोऽतिदुःस्पृशः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003562009, "chapter_id": 23562, "verse_number": "२०२-१०", "content_sanskrit": "आदेश्य चोभयोरस्य कर्णयोः कूटसाक्षिकः ।\nयो नरः पिशुनः कूटसाक्षी चालीकजल्पकः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003562010, "chapter_id": 23562, "verse_number": "२०२-११", "content_sanskrit": "ग्रामयाजनकं विप्रमध्रुवं दांभिकं शठम्।\nबद्ध्वा तु बन्धने घोरे दीयतां तु न किंचन ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003562011, "chapter_id": 23562, "verse_number": "२०२-१२", "content_sanskrit": "जिह्वाऽस्य छिद्यतां शीघ्रं वाचा दुष्टस्य पापिनः ।\nगम्यागम्यं पुरा येन विज्ञातं न दुरात्मना ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003562012, "chapter_id": 23562, "verse_number": "२०२-१३", "content_sanskrit": "कृतं लोभाभिभूतेन कामसम्मोहितेन च ।\nतस्य च्छित्वा ततो लिंगं क्षारमग्निं च दीपय ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003562013, "chapter_id": 23562, "verse_number": "२०२-१४", "content_sanskrit": "इमं तु खलकं कृत्वा दुरात्मा पापकारिणम् ।\nदायादा बहवो येन स्वार्थहेतोर्विनाशिताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003562014, "chapter_id": 23562, "verse_number": "२०२-१५", "content_sanskrit": "इमं वार्धुषिकं विप्रं सर्वत्रांगेषु भेदय ।\nतथायं यातनां यातु पापं बहु समाचरन् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003562015, "chapter_id": 23562, "verse_number": "२०२-१६", "content_sanskrit": "सुवर्णस्तेयिनं पापं कृतघ्नं च तथा नरम् ।\nक्रूरं पितृहणं चैनं ब्रह्मघ्नेषु समीकुरु ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003562016, "chapter_id": 23562, "verse_number": "२०२-१७", "content_sanskrit": "अस्थि च्छित्वा ततः क्षिप्रं क्षारमग्निं च दापय ।\nइमं तु विप्रं खादन्तु तीक्ष्णदंष्ट्राः सुदारुणाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003562017, "chapter_id": 23562, "verse_number": "२०२-१८", "content_sanskrit": "पिशुनं हि महाव्याघ्राः पंच घोराः सुदारुणाः ।\nइमं पचत पाकेषु बहुधा मर्मभेदिनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003562018, "chapter_id": 23562, "verse_number": "२०२-१९", "content_sanskrit": "येनाग्निरुज्झितः पूर्वं गृहीत्वा च न पूजितः ।\nइमं पापसमाचारं वीरघ्नमतिपापिनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003562019, "chapter_id": 23562, "verse_number": "२०२-२०", "content_sanskrit": "कर्कटस्य तु घोरस्य नित्यक्रुद्धस्य मोचय ।\nइमं घोरे ह्रदे क्षिप्तं सर्वयाजनयाजकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003562020, "chapter_id": 23562, "verse_number": "२०२-२१", "content_sanskrit": "सर्वेषां तु पशूनां यो नित्यं धारयते जलम् ।\nन त्राता न च दाता च पापस्यास्य दुरात्मनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003562021, "chapter_id": 23562, "verse_number": "२०२-२२", "content_sanskrit": "अदानव्रतिनो विप्रा वेदविक्रयिणस्तथा ।\nसर्वकर्माणि कुर्युर्ये दीयते न च किंचन ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003562022, "chapter_id": 23562, "verse_number": "२०२-२३", "content_sanskrit": "तोयभाजनहर्त्तारं भोजनं योऽनिवारयन् ।\nहन्यतां सुदृढैर्दण्डैर्यमदूतैर्महाबलैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003562023, "chapter_id": 23562, "verse_number": "२०२-२४", "content_sanskrit": "वेणुदण्डकशाभिश्च लोहदण्डैस्तथैव च ।\nजलमस्मै न दातव्यं भोजनं च कथंचन ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003562024, "chapter_id": 23562, "verse_number": "२०२-२५", "content_sanskrit": "तस्मा अन्नं च पानं च न दातव्यं कदाचन ।\nहत विश्वास्य हन्तारं वह्नौ शीघ्रं प्रपाचय ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003562025, "chapter_id": 23562, "verse_number": "२०२-२६", "content_sanskrit": "ब्रह्मदेयं हृतं येन तं वै शीघ्रं विपाचय ।\nबहुवर्षसहस्राणि पातये कर्म विस्तरे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003562026, "chapter_id": 23562, "verse_number": "२०२-२७", "content_sanskrit": "समुत्तीर्णं ततः पश्चात्तिर्यग्योनौ प्रपातये ।\nसूक्ष्मदेहविपाकेषु कीटपक्षिविजातिषु ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003562027, "chapter_id": 23562, "verse_number": "२०२-२८", "content_sanskrit": "क्लिष्टो जातिसहस्रैस्तु जायते मानुषस्ततः ।\nतत्र जातो दुरात्मा च कुलेषु विविधेषु च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003562028, "chapter_id": 23562, "verse_number": "२०२-२९", "content_sanskrit": "हिंसारूपेण घोरेण ब्रह्मवध्यां प्रदापयेत् ।\nराज्ञस्तु मारकं घोरं ब्रह्मघ्नं दुष्कृतं तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003562029, "chapter_id": 23562, "verse_number": "२०२-३०", "content_sanskrit": "सुवर्णस्तेयिनं चैव सुरापं चैव कारयेत् ।\nअनुभूय ततः काले ततो यक्ष्म प्रयोजयेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003562030, "chapter_id": 23562, "verse_number": "२०२-३१", "content_sanskrit": "गोघातको ह्ययं पापः कूटशाल्मलिमारुहेत् ।\nकृष्यते विविधैर्घोरै राक्षसैर्घोरदर्शनैः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003562031, "chapter_id": 23562, "verse_number": "२०२-३२", "content_sanskrit": "पूतिपाकेषु पच्येत जन्तुभिः संप्रयोजितः ।\nब्रह्मवध्याच्चतुर्भागैर्मृगत्वं पशुतां गतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003562032, "chapter_id": 23562, "verse_number": "२०२-३३", "content_sanskrit": "उद्विग्नवासं पतितं यत्र यत्रोपपद्यते ।\nपापकर्मसमुद्विग्नो जातो जातः पुनःपुनः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003562033, "chapter_id": 23562, "verse_number": "२०२-३४", "content_sanskrit": "अयं तिष्ठति किं पापः पितृघाती दुरात्मवान् ।\nते तु वर्षशतं साग्रं भक्षयन्तु विचेतसः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003562034, "chapter_id": 23562, "verse_number": "२०२-३५", "content_sanskrit": "ततः पाकेषु घोरेषु पच्यतां च नराधमः ।\nततो मानुषतां प्राप्य गर्भस्थो प्रियतां पुनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003562035, "chapter_id": 23562, "verse_number": "२०२-३६", "content_sanskrit": "व्यापन्नो दशगर्भेषु ततः पश्चाद्विमुच्यताम् ।\nतत्रापि लब्ध्वा मानुष्यं क्लेशभागी च जायताम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003562036, "chapter_id": 23562, "verse_number": "२०२-३७", "content_sanskrit": "बुभुक्षारुग्विकारैश्च सततं तत्र पीड्यताम् ।\nपापाचारमिमं घोरं मित्रविश्वासघातकम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003562037, "chapter_id": 23562, "verse_number": "२०२-३८", "content_sanskrit": "यन्त्रेण पीड्यतां क्षिप्रं ततः पश्चाद्विमुच्यताम् ।\nदीप्यतां ज्वलने घोरे वर्षाणां च शतद्वयम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003562038, "chapter_id": 23562, "verse_number": "२०२-३९", "content_sanskrit": "जायतां च ततः पश्चाच्छूनां योनौ दुरात्मवान् ।\nभ्रष्टोऽपि जायतां तस्मान्मानुषः क्लेश भाजनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003562039, "chapter_id": 23562, "verse_number": "२०२-४०", "content_sanskrit": "प्राप्तवान्विविधान्रोगान्संसारे चैव दारुणान् ।\nब्रह्मस्वहारी पापोऽयं नरो लवणतस्करः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003562040, "chapter_id": 23562, "verse_number": "२०२-४१", "content_sanskrit": "वर्षाणां तु शतं पंच तत्र क्लिष्टो दुरात्मवान् ।\nकृमिको जायते पश्चाद्विष्ठायां कृमिकोऽपरः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003562041, "chapter_id": 23562, "verse_number": "२०२-४२", "content_sanskrit": "शकुन्तो जायते घोरस्तत्र पश्चाद्वृको भवेत् ।\nइममग्निप्रदं घोरं काष्ठाग्नौ सम्प्रतापय ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003562042, "chapter_id": 23562, "verse_number": "२०२-४३", "content_sanskrit": "स्वकर्मसु विहीनेषु पश्चाल्लब्धगतिस्तथा ।\nततश्चाथ मृगो वापि ततो मानुषतां व्रजेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003562043, "chapter_id": 23562, "verse_number": "२०२-४४", "content_sanskrit": "तत्रापि दारुणं दुःखमुपभुंक्ते दुरात्मवान् ।\nसर्वदुष्कृतकार्येषु सह संघातचिन्तकैः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003562044, "chapter_id": 23562, "verse_number": "२०२-४५", "content_sanskrit": "एवं कर्मसमायुक्तास्ते भवन्तु सहस्रशः ।\nपरद्रव्यापहाराश्च रौरवे पतितास्तथा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003562045, "chapter_id": 23562, "verse_number": "२०२-४६", "content_sanskrit": "कुम्भीपाकेषु निर्दग्धः पश्चाद्गर्दभतां गतः ।\nततो जातस्त्वसौ पापः शूकरो मलभुक्तथा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003562046, "chapter_id": 23562, "verse_number": "२०२-४७", "content_sanskrit": "प्राप्नोतु विविधांस्तापान्यथा हृतधनश्च सन् ।\nक्षुधातृष्णापराक्रान्तो गर्दभो दशजन्मसु ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003562047, "chapter_id": 23562, "verse_number": "२०२-४८", "content_sanskrit": "मानुष्यं समनुप्राप्य चौरो भवति पापकृत् ।\nपरोपघाती निर्लज्जः सर्वेदोषसमन्वितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003562048, "chapter_id": 23562, "verse_number": "२०२-४९", "content_sanskrit": "वृक्षशाखावलम्बोऽत्र ह्यधःशीर्षः प्रजायते ।\nअग्निना पच्यतां पश्चाल्लुब्धो वै पुरुषाधमः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003562049, "chapter_id": 23562, "verse_number": "२०२-५०", "content_sanskrit": "ततो वर्षशते पूर्णे मुच्यते स पुनः पुनः ।\nअजितात्मा तथा पापः पिशुनश्च दुरात्मवान् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003562050, "chapter_id": 23562, "verse_number": "२०२-५१", "content_sanskrit": "पूर्वैश्च सूकरो भूत्वा नकुलो जायते पुनः ।\nविमुक्तश्च ततः पश्चान्मानुष्यं लभते चिरात् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003562051, "chapter_id": 23562, "verse_number": "२०२-५२", "content_sanskrit": "धिक्कृतः सर्वलोकेन कूटसाक्ष्यनृतव्रतः ।\nन शर्म लभते क्वापि कर्मणा स्वेन गर्हितः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003562052, "chapter_id": 23562, "verse_number": "२०२-५३", "content_sanskrit": "इमं ह्यानृतिकं दुष्टं क्षेत्रहारकमेव च ।\nस्वकर्म दुष्कृतं यावत्तावदुःखं भुनक्त्वसौ ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003562053, "chapter_id": 23562, "verse_number": "२०२-५४", "content_sanskrit": "कर्मण्येकैकशश्चायं स तु तिष्ठत्वयं पुनः ।\nवर्षलक्षं न सन्देहस्ततस्तिष्ठत्वयं पुनः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003562054, "chapter_id": 23562, "verse_number": "२०२-५५", "content_sanskrit": "ततो जातीः स्मरेत्सर्वास्तिर्यग्योनिं समाश्रितः ।\nजायतां मानुषः पश्चात्क्षुधया परिपीडितः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003562055, "chapter_id": 23562, "verse_number": "२०२-५६", "content_sanskrit": "सर्वकामविमुक्तस्तु सर्वदोषसमन्वितः ।\nक्वचिज्जात्यां भवेदन्धः क्वचिद्बधिर एव च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003562056, "chapter_id": 23562, "verse_number": "२०२-५७", "content_sanskrit": "क्वचिन्मूकश्च काणश्च क्वचिद्व्याधिसमन्वितः ।\nएवं हि प्राप्नुयाद्दुःखं न च सौख्यमवाप्नुयात् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003562057, "chapter_id": 23562, "verse_number": "२०२-५८", "content_sanskrit": "जात्यन्तरसहस्राणि प्रयुतान्यर्बुदानि च ।\nशान्तिं न लभते चैव भूमे क्षेत्रहरो नरः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003562058, "chapter_id": 23562, "verse_number": "२०२-५९", "content_sanskrit": "तीव्रैरन्तर्गतैर्दुःखैर्भूमिहर्त्ता नराधमः ।\nइमं बन्धैर्दृढैर्बद्ध्वा   विपाचय तथाचिरम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003562059, "chapter_id": 23562, "verse_number": "२०२-६०", "content_sanskrit": "प्रबद्धः सुचिरं कालं मम लोकं गतो नरः ।\nजायतां स चिरं पापो मार्जारस्तेन कर्मणा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003562060, "chapter_id": 23562, "verse_number": "२०२-६१", "content_sanskrit": "तीव्रक्षुधापरिक्लिष्टो बद्धो बन्धनयन्त्रितः ।\nदुःखान्यनुभवंस्तत्र पापकर्मा नराधमः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003562061, "chapter_id": 23562, "verse_number": "२०२-६२", "content_sanskrit": "सप्तधा सप्त चैकां च जातिं गत्वा स पच्यते ।\nइमं शाकुनिकं पापं श्वभिर्गृध्रैश्च घातय ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003562062, "chapter_id": 23562, "verse_number": "२०२-६३", "content_sanskrit": "ततः कुक्कुटतां यातु विड्भक्षश्च दुरात्मवान् ।\nदंशश्च मशकश्चैव ततः पश्चाद्भवेत्तु सः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003562063, "chapter_id": 23562, "verse_number": "२०२-६४", "content_sanskrit": "जातिकर्म सहस्रं तु ततो मानुषतां व्रजेत् ।\nइमं सौकरिकं पापं महिषा घातयन्तु तम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003562064, "chapter_id": 23562, "verse_number": "२०२-६५", "content_sanskrit": "वर्षाणां च सहस्रं तु धावमानं ततस्ततः।\nविभिन्नं च प्रभिन्नं च शृंगाभ्यां पद्भिरेव च ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003562065, "chapter_id": 23562, "verse_number": "२०२-६६", "content_sanskrit": "तस्माद्देशात्ततो मुक्तस्ततः सूकरतां व्रजेत् ।\nमहिषः कुक्कुटश्चैव शशो जम्बूक एव च ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003562066, "chapter_id": 23562, "verse_number": "२०२-६७", "content_sanskrit": "यां यां याति पुनर्जातिं तत्र भक्ष्यो भवेत्तु सः ।\nकर्मक्षयोऽन्यथा नास्ति मया पूर्वं विनिर्मितम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003562067, "chapter_id": 23562, "verse_number": "२०२-६८", "content_sanskrit": "प्राप्य मानुषतां पश्चात्पुनर्व्याधो भविष्यति ।\nअन्यथा निष्कृतिर्नास्ति जातिजन्मशतैरपि ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003562068, "chapter_id": 23562, "verse_number": "२०२-६९", "content_sanskrit": "उच्छिष्टान्नप्रदातारं पापाचारमधार्मिकम् ।\nअङ्गारैः पचतां चैनं त्रीणि वर्षशतानि च ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003562069, "chapter_id": 23562, "verse_number": "२०२-७०", "content_sanskrit": "भिन्नचारित्रदुःशीला भर्त्तुर्व्यलीककारिणी ।\nआयसान्पुरुषान्सप्त ह्यालिङ्गतु समन्ततः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003562070, "chapter_id": 23562, "verse_number": "२०२-७१", "content_sanskrit": "ततः शुनी भवेत्पश्चात्सूकरी च ततः परम् ।\nकर्मक्षये ततः पश्चान्मानुषी दुःखिता भवेत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003562071, "chapter_id": 23562, "verse_number": "२०२-७२", "content_sanskrit": "न च सौख्यमवाप्नोति तेन दुःखेन दुखिता ।\nअनेन भृत्या बहवः श्रांताः शांताः प्रवाहिताः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003562072, "chapter_id": 23562, "verse_number": "२०२-७३", "content_sanskrit": "भक्ष्यं भोज्यं च पानं च न तेषामुपपादितम् ।\nअनुमोदे प्रजा दृष्ट्वा लिप्समानो दुरात्मवान् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003562073, "chapter_id": 23562, "verse_number": "२०२-७४", "content_sanskrit": "एवं कुरुत भद्रं वो मम पार्श्वे तु दुर्मतिः ।\nरौरवे नरके घोरे सर्वदोषसमन्विते ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003562074, "chapter_id": 23562, "verse_number": "२०२-७५", "content_sanskrit": "सर्वकर्माणि कुर्वाणं क्षपयध्वं दुरासदम् ।\nवर्षाणां तु सहस्राणि तैस्तैः कर्मभिरावृतम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003562075, "chapter_id": 23562, "verse_number": "२०२-७६", "content_sanskrit": "प्रक्षिप्यतामयं पश्चाद्दस्युजातौ दुरात्मवान् ।\nजायतामुरगः पश्चात्ततः कर्म समाश्रयेत् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003562076, "chapter_id": 23562, "verse_number": "२०२-७७", "content_sanskrit": "ततः पश्चाद्भवेत्पापश्चेतरः सर्वपापकृत् ।\nसूकरस्तु भवेत्पश्चान्मेषः संजायते पुनः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003562077, "chapter_id": 23562, "verse_number": "२०२-७८", "content_sanskrit": "हस्त्यश्वश्च शृगालश्च सूकरो बक एव च ।\nततो जातस्तु सर्वेषु संसारेषु पुनः पुनः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003562078, "chapter_id": 23562, "verse_number": "२०२-७९", "content_sanskrit": "वर्षाणामयुतं साग्रं ततो मानुषतां व्रजेत् ।\nपंचगर्भेषु सापत्सु पंच जातो म्रियेत सः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003562079, "chapter_id": 23562, "verse_number": "२०२-८०", "content_sanskrit": "अपौगण्डो म्रियेत्पंच कर्मशेषक्षये तु सः ।\nततो मानुषतां याति चैष कर्माविनिर्णयः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003562080, "chapter_id": 23562, "verse_number": "२०२-८१", "content_sanskrit": "पापस्य सुकृतस्याथ प्रजानां विनिपातने ।\nभूतानां चाप्यसंमानं दुष्प्रहारश्च सर्वशः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003562081, "chapter_id": 23562, "verse_number": "२०२-८२", "content_sanskrit": "अतः स्वयम्भुवा पूर्वं कर्मपाको यथार्थवत् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]