[{"id": 5000083000, "chapter_id": 9083, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे षष्ठः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000083001, "chapter_id": 9083, "verse_number": "२-६-१", "content_sanskrit": "गते पुरोहिते रामः स्नातो नियतमानसः।\nसह पत्न्या विशालाक्ष्या नारायणमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000083002, "chapter_id": 9083, "verse_number": "२-६-२", "content_sanskrit": "प्रगृह्य शिरसा पात्रीं हविषो विधिवत् ततः।\nमहते दैवतायाज्यं जुहाव ज्वलितानले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000083003, "chapter_id": 9083, "verse_number": "२-६-३", "content_sanskrit": "शेषं च हविषस्तस्य प्राश्याशास्यात्मनः प्रियम्।\nध्यायन्नारायणं देवं स्वास्तीर्णे कुशसंस्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000083004, "chapter_id": 9083, "verse_number": "२-६-४", "content_sanskrit": "वाग्यतः सह वैदेह्या भूत्वा नियतमानसः।\nश्रीमत्यायतने विष्णोः शिश्ये नरवरात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000083005, "chapter_id": 9083, "verse_number": "२-६-५", "content_sanskrit": "एकयामावशिष्टायां रात्र्यां प्रतिविबुध्य सः।\nअलंकारविधिं सम्यक् कारयामास वेश्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000083006, "chapter_id": 9083, "verse_number": "२-६-६", "content_sanskrit": "तत्र शृण्वन् सुखा वाचः सूतमागधवन्दिनाम्।\nपूर्वां संध्यामुपासीनो जजाप सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000083007, "chapter_id": 9083, "verse_number": "२-६-७", "content_sanskrit": "तुष्टाव प्रणतश्चैव शिरसा मधुसूदनम्।\nविमलक्षौमसंवीतो वाचयामास स द्विजान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000083008, "chapter_id": 9083, "verse_number": "२-६-८", "content_sanskrit": "तेषां पुण्याहघोषोऽथ गम्भीरमधुरस्तथा।\nअयोध्यां पूरयामास तूर्यघोषानुनादितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000083009, "chapter_id": 9083, "verse_number": "२-६-९", "content_sanskrit": "कृतोपवासं तु तदा वैदेह्या सह राघवम्।\nअयोध्यानिलयः श्रुत्वा सर्वः प्रमुदितो जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000083010, "chapter_id": 9083, "verse_number": "२-६-१०", "content_sanskrit": "ततः पौरजनः सर्वः श्रुत्वा रामाभिषेचनम्।\nप्रभातां रजनीं दृष्ट्वा चक्रे शोभयितुं पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000083011, "chapter_id": 9083, "verse_number": "२-६-११", "content_sanskrit": "सिताभ्रशिखराभेषु देवतायतनेषु च।\nचतुष्पथेषु रथ्यासु चैत्येष्वट्टालकेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000083012, "chapter_id": 9083, "verse_number": "२-६-१२", "content_sanskrit": "नानापण्यसमृद्धेषु वणिजामापणेषु च।\nकुटुम्बिनां समृद्धेषु श्रीमत्सु भवनेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000083013, "chapter_id": 9083, "verse_number": "२-६-१३", "content_sanskrit": "सभासु चैव सर्वासु वृक्षेष्वालक्षितेषु च।\nध्वजाः समुच्छ्रिताः साधु पताकाश्चाभवंस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000083014, "chapter_id": 9083, "verse_number": "२-६-१४", "content_sanskrit": "नटनर्तकसङ्घानां गायकानां च गायताम्।\nमनःकर्णसुखा वाचः शुश्राव जनता ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000083015, "chapter_id": 9083, "verse_number": "२-६-१५", "content_sanskrit": "रामाभिषेकयुक्ताश्च कथाश्चक्रुर्मिथो जनाः।\nरामाभिषेके सम्प्राप्ते चत्वरेषु गृहेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000083016, "chapter_id": 9083, "verse_number": "२-६-१६", "content_sanskrit": "बाला अपि क्रीडमाना गृहद्वारेषु सङ्घशः।\nरामाभिषवसंयुक्ताश्चक्रुरेव कथा मिथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000083017, "chapter_id": 9083, "verse_number": "२-६-१७", "content_sanskrit": "कृतपुष्पोपहारश्च धूपगन्धाधिवासितः।\nराजमार्गः कृतः श्रीमान् पौरै रामाभिषेचने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000083018, "chapter_id": 9083, "verse_number": "२-६-१८", "content_sanskrit": "प्रकाशकरणार्थं च निशागमनशङ्कया।\nदीपवृक्षांस्तथा चक्रुरनुरथ्यासु सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000083019, "chapter_id": 9083, "verse_number": "२-६-१९", "content_sanskrit": "अलंकारं पुरस्यैवं कृत्वा तत् पुरवासिनः।\nआकांक्षमाणा रामस्य यौवराज्याभिषेचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000083020, "chapter_id": 9083, "verse_number": "२-६-२०", "content_sanskrit": "समेत्य सङ्घशः सर्वे चत्वरेषु सभासु च।\nकथयन्तो मिथस्तत्र प्रशशंसुर्जनाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000083021, "chapter_id": 9083, "verse_number": "२-६-२१", "content_sanskrit": "अहो महात्मा राजायमिक्ष्वाकुकुलनन्दनः।\nज्ञात्वा वृद्धं स्वमात्मानं रामं राज्येऽभिषेक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000083022, "chapter_id": 9083, "verse_number": "२-६-२२", "content_sanskrit": "सर्वे ह्यनुगृहीताः स्म यन्नो रामो महीपतिः।\nचिराय भविता गोप्ता दृष्टलोकपरावरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000083023, "chapter_id": 9083, "verse_number": "२-६-२३", "content_sanskrit": "अनुद्धतमना विद्वान् धर्मात्मा भ्रातृवत्सलः।\nयथा च भ्रातृषु स्निग्धस्तथास्मास्वपि राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000083024, "chapter_id": 9083, "verse_number": "२-६-२४", "content_sanskrit": "चिरं जीवतु धर्मात्मा राजा दशरथोऽनघः।\nयत्प्रसादेनाभिषिक्तं रामं द्रक्ष्यामहे वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000083025, "chapter_id": 9083, "verse_number": "२-६-२५", "content_sanskrit": "एवंविधं कथयतां पौराणां शुश्रुवुः परे।\nदिग्भ्यो विश्रुतवृत्तान्ताः प्राप्ता जानपदा जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000083026, "chapter_id": 9083, "verse_number": "२-६-२६", "content_sanskrit": "ते तु दिग्भ्यः पुरीं प्राप्ता द्रष्टुं रामाभिषेचनम्।\nरामस्य पूरयामासुः पुरीं जानपदा जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000083027, "chapter_id": 9083, "verse_number": "२-६-२७", "content_sanskrit": "जनौघैस्तैर्विसर्पद्भिः शुश्रुवे तत्र निःस्वनः।\nपर्वसूदीर्णवेगस्य सागरस्येव निःस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000083028, "chapter_id": 9083, "verse_number": "२-६-२८", "content_sanskrit": "ततस्तदिन्द्रक्षयसंनिभं पुरं\nदिदृक्षुभिर्जानपदैरुपाहितैः।\nसमन्ततः सस्वनमाकुलं बभौ\nसमुद्रयादोभिरिवार्णवोदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000083029, "chapter_id": 9083, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे षष्ठः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]