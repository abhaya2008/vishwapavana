[
  {
    "id": 20011249,
    "chapter_id": 6681,
    "verse_number": "9.1",
    "content_sanskrit": "अथेङ्गिताकारमयैर्वचोभिर्विज्ञाय राजा विजयस्य भावम् । महोर्मिमालीव नवैर्मयूखैः कलानिधेर्मण्डलमुलल्लास ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20011250,
    "chapter_id": 6681,
    "verse_number": "9.2",
    "content_sanskrit": "सहासफेनश्वलवीचिबाहुर्विलोलमुक्तावलिरुत्थितीयन् । समुद्रकल्पोथ नृपश्शयानश्चचाल किञ्चित् प्रतिपार्थचन्द्रम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20011251,
    "chapter_id": 6681,
    "verse_number": "9.3",
    "content_sanskrit": "स्मितप्रभाभिर्वलितानि पुष्णन् सनीलमङ्गं वलिभन्दधानः । कल्लोलितं फेनिलमम्बुराशिं विडम्बयन्नित्थमुवाच पार्थम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20011252,
    "chapter_id": 6681,
    "verse_number": "9.4",
    "content_sanskrit": "यथाविधोहं भवताद्य नूये तथाविधोहं विशयोत्र नास्ति । सर्वेषु कार्येषु सदैव जिष्णो जागर्षि मे यस्य सुहृत्तमस्त्वम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20011253,
    "chapter_id": 6681,
    "verse_number": "9.5",
    "content_sanskrit": "यथाधुना भारत नौषि मां त्वं स्तोतुं तथा नाहमुपक्रमे त्वाम् । गुणा ह्यसन्तो नृषु कीर्तनीया स्सत्त्वाय सन्तस्तु न वर्णनीयाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20011254,
    "chapter_id": 6681,
    "verse_number": "9.6",
    "content_sanskrit": "यदि त्विदानीं मम वक्षि साधो जनिश्च सूनोर्दुहितुश्च दानम् । एकेन यत्नेन यथोभयं स्यात् प्रसीद मे मक्षु तथाजमीड ! ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20011255,
    "chapter_id": 6681,
    "verse_number": "9.7",
    "content_sanskrit": "महीपतीनां मम पूर्वजानांमेकैकमीशःप्रदिदेश पुत्रम् । एकान्तु मे वंशकरीं कुमारीं गृहाण तां सन्ततये च मे स्याः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20011256,
    "chapter_id": 6681,
    "verse_number": "9.8",
    "content_sanskrit": "करस्थपद्मां कररत्नपद्मस्फुरद्गदापुष्करशङ्खचक्रः । पाणौ कुरुष्व त्वमिमां कुमारीं पयोधिकन्यामिव पङ्कजाक्षः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20011257,
    "chapter_id": 6681,
    "verse_number": "9.9",
    "content_sanskrit": "भक्तानुकम्पी भव एव नूनं दारीचिकीर्षुस्तव दारिकां मे । वसन्नितो वासवजोत्तराहि त्वमत्र देशे कथमन्यथा स्याः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20011258,
    "chapter_id": 6681,
    "verse_number": "9.10",
    "content_sanskrit": "परूत्परायैषम उत्तराब्दे य उत्तरा तिष्ठति दक्षिणा च । पश्चात् पुरस्ताच्च विभुस्सदेह नुदन्प्रजाः कर्मसु विश्वसाक्षी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20011259,
    "chapter_id": 6681,
    "verse_number": "9.11",
    "content_sanskrit": "क्व फल्गुन त्वं गुणरत्नसिन्धुः क्व सर्वसामान्यगुणा वयञ्च । तथापि जातस्सदयो यदि त्वं तर्हि प्रसन्नः परमेश्वरो नः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20011260,
    "chapter_id": 6681,
    "verse_number": "9.12",
    "content_sanskrit": "इति ब्रुवाणं मणलूरनाथं संबन्धमुच्चं तनयश्च लिप्सुः । जिघृक्षमाणः परिदातुकामं तत्कन्यकारत्नमुवाच पार्थः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20011261,
    "chapter_id": 6681,
    "verse_number": "9.13",
    "content_sanskrit": "यद्येष कामस्तव भूपकन्यां गृह्णामि दास्यामि सुतञ्च जातम् । अप्यप्रियं त्वद्वचसा विद्ध्यां प्रियन्तु कुर्यां न कुतस्त्वयोक्तः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20011262,
    "chapter_id": 6681,
    "verse_number": "9.14",
    "content_sanskrit": "अद्याहमुद्यानमितोऽतिहृद्यं सुतामदर्शन्तव दर्शनीयाम् । सुदर्शनां कामशरैश्च लक्ष्यः कटाक्षलक्ष्येण कृतस्तदानीम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20011263,
    "chapter_id": 6681,
    "verse_number": "9.15",
    "content_sanskrit": "इत्युक्तवन्तं विजयं विसृज्य क्षमाभृद्दृढप्रमदातिभारः । शिवे मुहूर्ते गणकोपदिष्टे दातुं कुमारीमपरेद्युरैच्छत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20011264,
    "chapter_id": 6681,
    "verse_number": "9.16",
    "content_sanskrit": "पुरः पुरो दक्षिणतश्च पश्चातथोत्तरादास्यभुवोऽभिजग्मुः । बुभुक्षवोन्नानि जिघृक्षवोऽर्थान् दिदृक्षवश्चार्जुनमुत्सवञ्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20011265,
    "chapter_id": 6681,
    "verse_number": "9.17",
    "content_sanskrit": "बभावधस्तात् कुसुमोपहारैस्सुसिक्तसम्मृष्टमहीतलस्थैः । तथोपरिष्टाद् ध्वजपादपानां समीरधूतांशुकपल्लवालिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20011266,
    "chapter_id": 6681,
    "verse_number": "9.18",
    "content_sanskrit": "प्रागेव पाणिग्रहमङ्गलाहात् सम्भृत्य सर्वाण्यपि साधनानि । अध्यावसन्नुन्मनसः पुरन्तत् पुरोधसस्तं प्रतिपालयन्तः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20011267,
    "chapter_id": 6681,
    "verse_number": "9.19",
    "content_sanskrit": "पुरं ततोऽपूर्यत दक्षिणेन तदुत्तरेणापि महाजनौघः । कोलाहलेनापि दधद्दिगन्तान् पश्चात् पुरस्तादपि तस्य संयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20011268,
    "chapter_id": 6681,
    "verse_number": "9.20",
    "content_sanskrit": "स्थातुं धराऽशक्नुवती पतद्भिः क्षुण्णा जनानां चरणैरवस्तात् । अगच्छदाकाशमिवापरस्तादुदीर्णरेणुप्रचयच्छलेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20011269,
    "chapter_id": 6681,
    "verse_number": "9.21",
    "content_sanskrit": "तत्र द्वयोर्द्वावपरावभूतां निरुद्धनिश्शेषदिशौ समुद्रौ । अवस्सशब्दो जनसञ्चयाख्यः परागनामोपरि नीरवश्च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20011270,
    "chapter_id": 6681,
    "verse_number": "9.22",
    "content_sanskrit": "खवायुतेजस्सलिलानि तत्र व्याप्य स्थिते भूयसि भूपरागे । प्रारब्धमुर्वीपरमाणुपुञ्जैर्विचक्षणैरैहिजगत्समस्तम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20011271,
    "chapter_id": 6681,
    "verse_number": "9.23",
    "content_sanskrit": "सप्रेमकोपा बहुधानुनीय प्रिया युवानो विजनेषु तत्र । द्विधाकृतानि प्रददुर्नखाग्रैर्गौराणि ताम्बूलदलानि ताभ्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20011272,
    "chapter_id": 6681,
    "verse_number": "9.24",
    "content_sanskrit": "कृत्वैकध्यं कुन्तलान् विप्रकीर्णान् बाहूत्क्षेपव्यक्तपीनस्तनश्रीः । लीलापाङ्गैरुल्लसद्भूषणाङ्गी बालैकध्यं काचिदैक्षिष्ट कान्तम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20011273,
    "chapter_id": 6681,
    "verse_number": "9.25",
    "content_sanskrit": "कृत्वैकध्यं तण्डुलान् भाजनेषु क्षिप्त्वा सूदास्तत्र धौतानपाक्षुः । द्वेधा भिन्नैस्त्रैधमप्येधयन्तः काष्ठैरग्निं भोजनाय द्विजानाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20011274,
    "chapter_id": 6681,
    "verse_number": "9.26",
    "content_sanskrit": "आसीत्कश्चित्तत्र न ब्रह्मपाशस्सर्वे तत्र ब्रह्मरूपा बभूवुः । प्राप्यैकाकी निर्धनस्तत्ततोऽगाद्दत्तार्थाढ्यस्सद्वितीयो द्विजातिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20011275,
    "chapter_id": 6681,
    "verse_number": "9.27",
    "content_sanskrit": "जुष्टः श्रिया शत्रुमहीशचर्यां भूषा दधानो रिपुराजरूप्याः । आसादितोद्वाहदिनोऽथ पार्थो विवेश रथ्यां नगरं विविक्षुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20011276,
    "chapter_id": 6681,
    "verse_number": "9.28",
    "content_sanskrit": "दोर्दण्डयुग्मेन महारथोऽसावाढ्यानरीनाढ्यचरान् करोति । श्रीमत्तमश्शूरतरो वरिष्ठैः स्थेयोभिरप्यात्मगुणैरुपेतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20011277,
    "chapter_id": 6681,
    "verse_number": "9.29",
    "content_sanskrit": "नूनमधःकृतदानवचक्राश्चक्रधरादपि शूरतरोऽयम् । अद्‌भुतरूपतयैष वरीयान् पञ्चशरादपि चाञ्चितनेत्रः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20011278,
    "chapter_id": 6681,
    "verse_number": "9.30",
    "content_sanskrit": "ज्येष्ठानर्चन् ज्यायसश्चैष लोकान् श्रेष्ठो देवैः कीर्त्यते मानुषैश्च । साधिष्ठालं कर्णनेदिष्ठदृष्टेराशामाशां व्यश्नुते कीर्तिरस्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20011279,
    "chapter_id": 6681,
    "verse_number": "9.31",
    "content_sanskrit": "कनिष्ठोऽकनिष्ठैर्गुणैरेष तुष्टो करोत्यग्रजौ मातरं ताञ्च नूनम् । यविष्ठौ यमौ नन्दतोऽल्पिष्ठमध्या प्रिया चाकनीयस्तनी सात्र कृष्णा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20011280,
    "chapter_id": 6681,
    "verse_number": "9.32",
    "content_sanskrit": "स्वस्मादावासाद्राजवेश्म व्रजन्तं दृष्ट्वा नेदिष्ठं पौरलोकस्तमस्तौत् । साधीयो जल्पन्नित्थमुच्चैः प्रहृष्टो भासिष्ठाकल्पं वाससीयान् स्रजिष्ठः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20011281,
    "chapter_id": 6681,
    "verse_number": "9.33",
    "content_sanskrit": "विदग्धजातीयमवेक्षमाणाः पौराः प्रवीणास्ततृपुस्तमान्तम् । उवाचरूपं स समागतन्तं दिदेशकल्पं हृदयं सुहृद्भ्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20011282,
    "chapter_id": 6681,
    "verse_number": "9.34",
    "content_sanskrit": "द्विजातिकान् पामरकांश्च तोषयन् मृदुस्मितालङ्कृतया गिरार्जुनः । कुमारकांश्च प्रययावुपस्थितान् दिदृक्षया साङ्घ्रिकपाणिकाङ्क्षकान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20011283,
    "chapter_id": 6681,
    "verse_number": "9.35",
    "content_sanskrit": "आलोकयन्त्या पृथका किमास्यते त्वयार्जुनं भूमिभृतोऽन्यकेयम् । इतीरिता काचिदयात् कयाचन स्त्रिया तमालोकयितुं विभूषिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20011284,
    "chapter_id": 6681,
    "verse_number": "9.36",
    "content_sanskrit": "अनंशुकाभ्यां पुरतोऽर्जुनस्य किमत्र वा तिष्ठसि किं स्तनाभ्याम् । इत्यब्रवीत् कापि सखीं स्वयन्तु तथा न तस्थे किल फल्गुनाय ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20011285,
    "chapter_id": 6681,
    "verse_number": "9.37",
    "content_sanskrit": "तूष्णीकां कस्मादास्यते युष्मकाभिः प्राप्तोऽसौ पार्थः प्राप्त उद्वाहकालः । भूत्वा तूष्णीकाः कर्म सर्वं कुरुध्वं शुद्धान्तेऽत्र स्त्रैणमित्थं जजल्प ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20011286,
    "chapter_id": 6681,
    "verse_number": "9.38",
    "content_sanskrit": "प्रासादशृङ्गेषु पुराङ्गनाभिस्सापाङ्गभृङ्गैरवकीर्यमाणः । नवाभ्रनीलो नवलाजपुष्पै रेजेऽर्जुनो राजपथेन गच्छन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20011287,
    "chapter_id": 6681,
    "verse_number": "9.39",
    "content_sanskrit": "स्निग्धैरपाङ्गनिकरैरवलोकयन्ती विस्रंसमानवसनस्फुटरोमराजिः । विभ्राजमानकुचमण्डलबाहूमूला बाला बबन्ध कबरीं पुरतोऽस्यकाचित् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20011288,
    "chapter_id": 6681,
    "verse_number": "9.40",
    "content_sanskrit": "आचारविद्भिस्तुलिताप्सरोभिः परिष्कृतं पौरविलासिनीभिः । क्रीडाचणैस्सार्धमथो वयस्यैर्वधूगृहं वासविराससाद ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20011289,
    "chapter_id": 6681,
    "verse_number": "9.41",
    "content_sanskrit": "प्राचीनां बृहतिकयावगुण्ठिताङ्गीं मन्दाक्षस्तिमितमुखांबुजां तनूजाम् । आदाय क्षितिपतिरास्त होमकाले हर्षाश्रुस्नपितमुखो वरस्य पार्श्वे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20011290,
    "chapter_id": 6681,
    "verse_number": "9.42",
    "content_sanskrit": "उत्तानमुल्लसितवेपथुमीहमानं व्रीलावशादिव निवारयितुं हुतेऽग्नौ । लक्ष्म्या मुकुन्द इव पार्थिवनन्दनाया जग्राह पाणिसरसीरुहमाजमीढः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20011291,
    "chapter_id": 6681,
    "verse_number": "9.43",
    "content_sanskrit": "खेदाम्बुभिर्भिन्नविशेषकश्रीर्जुहाव भद्रार्चिषि चित्रभानौ । पत्युक्तमन्त्रा करपल्लवाभ्यां लाजाञ्जलिं सा च शमीपलाशम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20011292,
    "chapter_id": 6681,
    "verse_number": "9.44",
    "content_sanskrit": "भ्रूचापमुक्तान्निशितानिवेषूनुत्कम्पयन्तौ सकलाङ्गलक्षम् । वधूवरौ पुष्पशरप्रयुक्तौ परस्परं प्राहिणुतामपाङ्गान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20011293,
    "chapter_id": 6681,
    "verse_number": "9.45",
    "content_sanskrit": "दश्मोदकिकां प्रभूतमन्नं वसनान्याभरणानि गा हिरण्यम् । प्रददावपरञ्च भूरि वित्तं विजयो वेदविदे द्विजव्रजाय ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20011294,
    "chapter_id": 6681,
    "verse_number": "9.46",
    "content_sanskrit": "स्वं मन्यमानस्तनयं गुणाढ्यं जामातरं वंशकरं नृपस्तम् । राष्ट्रं विशालं तदधीनमृद्धं चकार साधारणसर्वभोगम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20011295,
    "chapter_id": 6681,
    "verse_number": "9.47",
    "content_sanskrit": "विलासिनीभिस्सहिता विजह्रुः पौरा विवाहोत्सववासरेषु । सरस्सु वैसारिणसङ्कुलेषु प्रफुल्लपुष्पेषु च निष्कुटेषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20011296,
    "chapter_id": 6681,
    "verse_number": "9.48",
    "content_sanskrit": "सकृन्नाभुङ्क्त कोऽप्यह्नस्सर्वे द्वित्रिरभुञ्जत । बहुकृत्वो विभावर्याः प्रापुर्नारीनरा रतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20011297,
    "chapter_id": 6681,
    "verse_number": "9.49",
    "content_sanskrit": "बहुधा रमयामासुर्युवानो युवती रसात् । बहुकृत्वस्तरुण्यश्च तरुणान् पर्यरीरमन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20011298,
    "chapter_id": 6681,
    "verse_number": "9.50",
    "content_sanskrit": "मांसौदनमयं भुक्त्वा पीत्वा च मदिरामयीम् । मुदिता रमयामासुरन्योन्यं तत्र नागराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20011299,
    "chapter_id": 6681,
    "verse_number": "9.51",
    "content_sanskrit": "क्वचिदापूपिकोऽन्यत्र ववृते शष्कुलीमयः । क्वचिदन्नमयोऽन्यत्र स नृत्तमय उत्सवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20011300,
    "chapter_id": 6681,
    "verse_number": "9.52",
    "content_sanskrit": "केशजाग्रहोत्तानमुखीनामभिकैः पपे । कामेषृज्ज्वरभैषज्यं कान्तानामधरामृतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20011301,
    "chapter_id": 6681,
    "verse_number": "9.53",
    "content_sanskrit": "हविभिस्सर्वदैवत्यैः प्रीणन्तौ सर्वदेवताः । आवसथ्ये ततश्श्राद्धौ दम्पती तावतिष्ठताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20011302,
    "chapter_id": 6681,
    "verse_number": "9.54",
    "content_sanskrit": "पाद्यार्घ्यादिभिरातिथ्यैरतिथीन् गृहमागतान् । अभ्याराधयतां नित्यं तौ वैनयिकशालिनौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20011303,
    "chapter_id": 6681,
    "verse_number": "9.55",
    "content_sanskrit": "गवाविकादिकान् गेहे पशूंस्तौ पर्यक्षताम् । आश्रितञ्च जनं सर्वमस्यन्तौ रोगमौषधैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20011304,
    "chapter_id": 6681,
    "verse_number": "9.56",
    "content_sanskrit": "तद्गृहे यावकरसन्यासलौहितकांशुकाः । देहैर्वभुर्लौहितकद्युतिलोहितकैः स्त्रियः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20011305,
    "chapter_id": 6681,
    "verse_number": "9.57",
    "content_sanskrit": "जितास्तद्गृहदासीनां नेत्रैरञ्जनकालकैः । नीलिमानं दधुर्भृङ्गास्तत्र ह्रीकालका इव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20011306,
    "chapter_id": 6681,
    "verse_number": "9.58",
    "content_sanskrit": "निशम्य कान्तदूतानां वाचिकं तद्गृहेऽङ्गनाः । कान्तानानन्दयामासुः कार्मणैस्तदगारगाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20011307,
    "chapter_id": 6681,
    "verse_number": "9.59",
    "content_sanskrit": "तद्गृहे मृत्स्नया लिप्ता मृत्तिकाभित्तयो बभुः । प्राज्ञचित्रकरन्यस्तैश्चित्रैरुच्चावचैश्शुभैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20011308,
    "chapter_id": 6681,
    "verse_number": "9.60",
    "content_sanskrit": "शिवकर्मसु पाथोऽर्थान् जनाय बहुशो ददौ । अल्पशो वितरन्त्यर्थानापद्यपि न तादृशाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20011309,
    "chapter_id": 6681,
    "verse_number": "9.61",
    "content_sanskrit": "विप्रेभ्यः प्रददौ स्वर्णं भारशस्स दिने दिने । सहस्रशश्च माहेयीर्घटोघ्नीश्शीलशालिनीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20011310,
    "chapter_id": 6681,
    "verse_number": "9.62",
    "content_sanskrit": "कामतः प्रतिबीभत्सू रतेश्चित्राङ्गदां प्रति । अथवा मधुजिच्चेयं प्रतीयञ्च श्रियं प्रति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20011311,
    "chapter_id": 6681,
    "verse_number": "9.63",
    "content_sanskrit": "इति तत्रावदन् दृष्ट्वा पार्थचित्राङ्गदे जनः । शीलादिगुणसम्पत्तेस्तयोर्जातकुतूहलः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20011312,
    "chapter_id": 6681,
    "verse_number": "9.64",
    "content_sanskrit": "तौ वृत्ततोऽत्यगृह्येतां तत्रत्यैरखिलैर्जनैः । वृत्ततो व्यथमानौ न क्षिप्तैर्युक्तौ न वृत्ततः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20011313,
    "chapter_id": 6681,
    "verse_number": "9.65",
    "content_sanskrit": "'सम्पृक्ता वृत्ततः पापैर्हीयन्ते वृत्ततो यतः । सुवृत्तैरेव तौ तस्माद्वृत्तैर्नतुसङ्गतौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20011314,
    "chapter_id": 6681,
    "verse_number": "9.66",
    "content_sanskrit": "आश्रितानामनर्थानां रोगिणातौ शरीरिणाम् । प्रवाहिकातोकुरुतां क्षयतः कुष्ठतस्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20011315,
    "chapter_id": 6681,
    "verse_number": "9.67",
    "content_sanskrit": "नीरजीकुर्वती वेश्म निररुभूत् भूतलम् । उच्चक्षू सम्मुखं पार्थं सुमनीकुरुते स्म सा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20011316,
    "chapter_id": 6681,
    "verse_number": "9.68",
    "content_sanskrit": "कोपेन भस्मसाद्भूतं भवस्योत्पादितं पुनः । भवान्या करुणादृष्ट्या कामं साऽमन्यत प्रियम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20011317,
    "chapter_id": 6681,
    "verse_number": "9.69",
    "content_sanskrit": "स्वेदीभूतां पुलकसात्सम्पन्नां दधती तनुम् । सतां विस्रम्भयामास मुग्धां मुग्धै रतैः क्रमात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20011318,
    "chapter_id": 6681,
    "verse_number": "9.70",
    "content_sanskrit": "क्रमेण रूढविस्रंभा कान्तसात्कृतविग्रहा । सालिलिङ्ग स्वयं कान्तं निरन्तरपयोधरा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20011319,
    "chapter_id": 6681,
    "verse_number": "9.71",
    "content_sanskrit": "उपार्जितानि सर्वाणि वल्लभत्राचकार सा । रत्नानि 'तस्मा अधरप्रवालं न कुतो दिशेत् ? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20011320,
    "chapter_id": 6681,
    "verse_number": "9.72",
    "content_sanskrit": "मर्त्यता पालयन् पार्थो मर्त्यता स्म महीयते । देवता पालयन् देवो देवता वृत्रहा यथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20011321,
    "chapter_id": 6681,
    "verse_number": "9.73",
    "content_sanskrit": "स्वैरं शलशलाभूतनूपुराङ्घ्रिसरोजया । चिक्रीड कान्तया सार्धमुद्यानेषु धनञ्जयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20011322,
    "chapter_id": 6681,
    "verse_number": "9.74",
    "content_sanskrit": "पर्जन्योऽसमयाकुर्वन् क्षेत्रं बीजाकृतं जनैः । सिषेच धनतोयेन भृशं देशेऽर्जुनः श्रिते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20011323,
    "chapter_id": 6681,
    "verse_number": "9.75",
    "content_sanskrit": "मृगयासु मृगाक्षीं तां सव्यसाची विचिन्तयन् । न सपत्राचकारैणान् का निष्पत्राकृतौ कथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20011324,
    "chapter_id": 6681,
    "verse_number": "9.76",
    "content_sanskrit": "दुःखाकुर्वन्नरेन्द्रा ये निष्कुलाकृतगोगणाः । पाण्ड्यराजं प्रियाकुर्वन् स दस्यून्निजघान तान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20011325,
    "chapter_id": 6681,
    "verse_number": "9.77",
    "content_sanskrit": "सत्याकुर्वन् बृहद्भानौ जुह्वञ्छूलाकृता वपाः । मद्राकृतवपुर्यज्ञे तत्रे तेन द्विजव्रजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20011326,
    "chapter_id": 6681,
    "verse_number": "9.78",
    "content_sanskrit": "तत्रैवं वसतस्तस्य गणरात्रे गते वधूः । अन्तर्वत्नी बभूवाङ्गैः कठोरशरधूसरैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20011327,
    "chapter_id": 6681,
    "verse_number": "9.79",
    "content_sanskrit": "पार्थेनान्तरपत्यायाः प्रियाया ददृशे मुखम् । अनाविरिन्दुबिंबाया रजनेरिव धूसरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20011328,
    "chapter_id": 6681,
    "verse_number": "9.80",
    "content_sanskrit": "किंराज्ञो युधि कर्तारमराज्ञो धारयत्यसौ । सुराजानमिति प्राज्ञैः पृष्टेरूचे पृथासुतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20011329,
    "chapter_id": 6681,
    "verse_number": "9.81",
    "content_sanskrit": "अपन्थानमगन्तारमवतिष्णुर्नृपोऽपथे । जहर्ष पुत्रमाकर्ण्य पृष्ट्वा पण्डितमण्डलम्' ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20011330,
    "chapter_id": 6681,
    "verse_number": "9.82",
    "content_sanskrit": "गर्भस्स ववृधे तस्याः प्रतियत्नैः पुरोधसः । शरद्वलक्षपक्षस्य क्षणैरिन्दुरिव द्यवि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20011331,
    "chapter_id": 6681,
    "verse_number": "9.83",
    "content_sanskrit": "पुत्रं चित्राङ्गदा काले पूर्णे प्रादुरभावयत् । सवितारमिव प्राची गर्भासृक्सन्ध्ययारुणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20011332,
    "chapter_id": 6681,
    "verse_number": "9.84",
    "content_sanskrit": "अधीतर्ग्यजुषस्सामान् शुद्धवाङ्मनसान् द्विजान् । अप्रीणतां धनव्रातैर्नृपपार्थौ सुतर्द्धये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20011333,
    "chapter_id": 6681,
    "verse_number": "9.85",
    "content_sanskrit": "अपाययत तं जातं पयोधररसं प्रसूः । सौरभेयीव जातोक्षं चुम्बन्ती चपला च तम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20011334,
    "chapter_id": 6681,
    "verse_number": "9.86",
    "content_sanskrit": "धृतावतंसं सन्न धृतसन्तमसा दिशः । ध्वस्तान्धतमसं चित्तं पितुर्दीप्तं चकार सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20011335,
    "chapter_id": 6681,
    "verse_number": "9.87",
    "content_sanskrit": "कुब्रह्मणोपि बीभत्सुरार्चत्पुत्रोदयोत्सवे । चोलब्रह्मादिकान् प्राप्तान् महाब्रह्मांस्तु किं पुनः? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20011336,
    "chapter_id": 6681,
    "verse_number": "9.88",
    "content_sanskrit": "छत्रोपानहमार्येभ्यो भक्तं वित्तञ्च पुष्कलम् । विलेभे भूपतिर्भूत्यै कुमारस्यातिवत्सलः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20011337,
    "chapter_id": 6681,
    "verse_number": "9.89",
    "content_sanskrit": "प्रतिवेश्मासृजद्भूमिं प्रतिसद्म भुवोऽचरन् । सानन्दाः पुरसुन्दर्यस्सिन्दूरछुरिताननाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20011338,
    "chapter_id": 6681,
    "verse_number": "9.90",
    "content_sanskrit": "मालाविभूषितस्कन्धास्सर्वाङ्गीणार्द्रचन्दनाः । सकामिनीकास्सर्वत्र विलेसुः पुरिकामिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20011339,
    "chapter_id": 6681,
    "verse_number": "9.91",
    "content_sanskrit": "बभ्रुवाहन इत्यस्य समये नाम चक्रतुः । स्वनामसदृशं चित्रवाहन–श्वेतवाहनौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20011340,
    "chapter_id": 6681,
    "verse_number": "9.92",
    "content_sanskrit": "संस्कृतो जातकर्मार्द्यैः कर्मभिस्स पुरोधसा । प्रचकाशे भृशं शाणे महामणिरिव क्ष्णुतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20011341,
    "chapter_id": 6681,
    "verse_number": "9.93",
    "content_sanskrit": "पयोधररसं मातू रसयन् नृपनन्दनः । ववृधे यमुनातीरे तमालतरुपोतवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20011342,
    "chapter_id": 6681,
    "verse_number": "9.94",
    "content_sanskrit": "इत्थं कुमारे परिवर्धमाने कदाचन स्वं नगरं यियासुः । आसाद्य पार्थः श्वशुरं नरेन्द्रं विचक्षणो वाचमिमामुवाच ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20011343,
    "chapter_id": 6681,
    "verse_number": "9.95",
    "content_sanskrit": "नरेन्द्र राष्ट्रे तव नाककल्पे सुखायमानोऽधिवसन्निहाहम् । सबान्धवाया निजजन्मभूमेः स्मरन् यियासापरवान् भवामि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20011344,
    "chapter_id": 6681,
    "verse_number": "9.96",
    "content_sanskrit": "बद्धो गुणैशीलमयैस्त्वदीयैस्त्वदीयपार्श्वान्न च पारयामि । प्रयातुमस्माद्यदहं करिष्याम्येवं स्थिते तत्तव शास्तु वाणी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20011345,
    "chapter_id": 6681,
    "verse_number": "9.97",
    "content_sanskrit": "इतीरितः पाण्डुसुतेन पाण्ड्यस्समुद्रनाभीधृतरत्नराशिः । फेनावदातस्मितकान्तिपूर्णमुक्तावलीदीधितिराबभाषे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20011346,
    "chapter_id": 6681,
    "verse_number": "9.98",
    "content_sanskrit": "मा गा इति स्वार्थपरायणत्वं गच्छेति हार्दप्रसरं रुणद्धि । तदत्र किं वच्मि सुखेषु पुंसां कार्येषु चान्योन्यपराङ्मुखेषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20011347,
    "chapter_id": 6681,
    "verse_number": "9.99",
    "content_sanskrit": "आश्वास्य'जायां त्वतिबालपुत्रां यदीशिषे पाण्डव गच्छ गन्तुम् । सबान्धवानामवलोकनाय क्षेमाय शीघ्रं पुनरागमाय ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20011348,
    "chapter_id": 6681,
    "verse_number": "9.100",
    "content_sanskrit": "महीभृतेत्थं वदता विसृष्टः प्रविश्य पार्थो भवनं प्रियायाः । तमाबभाषे परिरंभरुद्धप्रत्युत्थितः पार्श्वगतां विनम्राम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20011349,
    "chapter_id": 6681,
    "verse_number": "9.101",
    "content_sanskrit": "प्रिये पृथां मातरमीक्षितुं तां चिरेक्षितां सम्प्रति कामयेऽहम् । युधिष्ठिरादींस्तव तांश्च देवॄन् ददस्व तन्मे गमनाभ्यनुज्ञाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20011350,
    "chapter_id": 6681,
    "verse_number": "9.102",
    "content_sanskrit": "इतीरिता राजसुताब्रवीत्तं त्वया विना जीवितुमक्षमाहम् । तन्मा स्म गा यानमवश्यकार्यं यदि व्रजादाय सहात्मजां माम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20011351,
    "chapter_id": 6681,
    "verse_number": "9.103",
    "content_sanskrit": "इति ब्रुवाणामवदत्स कान्तां गत्वागमिष्याम्यचिरादिवाहम् । यथा सहेऽहं विरहं भवत्यास्तथा मम त्वं विरहं सहस्व ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20011352,
    "chapter_id": 6681,
    "verse_number": "9.104",
    "content_sanskrit": "धीरा वसास्मिन् पितुरालये त्वं कुमारमेतं परिपालयन्ती । महत्सु कृच्छ्रेष्वपि बुद्धिमत्यो न क्षत्रिया विक्लवतां व्रजन्ति ॥",
