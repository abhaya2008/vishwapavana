[{"id": 7001698000, "chapter_id": 21698, "verse_number": "१-८४-१", "content_sanskrit": "सनत्कुमार उवाच ।\nकलिकल्पांतरे ब्रह्मन् ब्रह्मणोऽव्यक्तजन्मनः ।\nलोकपद्मे तपस्थस्य सृष्ट्यर्थं संबभूवतुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001698001, "chapter_id": 21698, "verse_number": "१-८४-२", "content_sanskrit": "विष्णुकर्णमलोद्भूतावसुरौ मधुकैटभौ ।\nतौ जातमात्रौ पयसि लोकप्रलयलक्षणे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001698002, "chapter_id": 21698, "verse_number": "१-८४-३", "content_sanskrit": "जानुमात्रे स्थितौ दृष्ट्वा ब्रह्मणं कमलस्थितम् ।\nप्रवृत्तावत्तुमालक्ष्य तुष्टाव जगदंबिकाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001698003, "chapter_id": 21698, "verse_number": "१-८४-४", "content_sanskrit": "ततो देवी जगत्कर्त्री शैवी शक्तिरनुत्तमा ।\nनारायणाक्षिसंस्थाना निद्रा प्रीता बभूव ह ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001698004, "chapter_id": 21698, "verse_number": "१-८४-५", "content_sanskrit": "तस्या मंत्रादिकं सर्वं कथयिष्यामि तच्छृणु ।\nसारुणा क्रोधनी शांतिश्चंद्रालंकृतशेखरा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001698005, "chapter_id": 21698, "verse_number": "१-८४-६", "content_sanskrit": "एकाक्षरीबीज मन्त्रऋषिः शक्तिरुदाहृता ।\nगायत्री च भवेच्छन्दो देवता भुवनेश्वरी ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001698006, "chapter_id": 21698, "verse_number": "१-८४-७", "content_sanskrit": "षड्दीर्घयुक्तबीजेन कुर्यादंगानि षट् क्रमात् ।\nसंहारसृष्टिमार्गेण मातृकान्यस्तविग्रहः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001698007, "chapter_id": 21698, "verse_number": "१-८४-८", "content_sanskrit": "मन्त्रन्यासं ततः कुर्याद्देवताभावसिद्धये ।\nहृल्लेखां मूर्ध्नि वदने गगनां हृदयांबुजे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001698008, "chapter_id": 21698, "verse_number": "१-८४-९", "content_sanskrit": "रक्तां करालिकां गुह्ये महोच्छुष्मां पदद्वये ।\nऊर्द्ध्वप्राग्दक्षिणोदीच्यपश्चिमेषूत्तरेऽपि च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001698009, "chapter_id": 21698, "verse_number": "१-८४-१०", "content_sanskrit": "सद्यादिह्रस्वबीजाद्यान्वस्तव्या भूतसप्रभाः ।\nअंगानि विन्यसेत्पश्चाज्जातियुक्तानि षट् क्रमात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001698010, "chapter_id": 21698, "verse_number": "१-८४-११", "content_sanskrit": "ब्रह्माणं विन्यसेद्भाले गायत्र्या सह संयुतम् ।\nसावित्र्या सहितं विष्णुं कपोले दक्षिणे न्यसेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001698011, "chapter_id": 21698, "verse_number": "१-८४-१२", "content_sanskrit": "वागीश्वर्या समायुक्तं वामगंडे महेश्वरम् ।\nश्रिया धनपतिं न्यस्य वामकर्णाग्रके पुनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001698012, "chapter_id": 21698, "verse_number": "१-८४-१३", "content_sanskrit": "रत्या स्मरं मुखे न्यस्य पुण्यागणपतिं न्यसेत् ।\nसव्यकर्णोपरि निधाकर्णगंडांतरालयोः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001698013, "chapter_id": 21698, "verse_number": "१-८४-१४", "content_sanskrit": "न्यस्तव्यं वदने मूलं भूपश्चैत्रांस्ततो न्यसेत् ।\nकण्ठमूले स्तनद्वंद्वे वामांसे हृदयांबुजे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001698014, "chapter_id": 21698, "verse_number": "१-८४-१५", "content_sanskrit": "सव्यांसे पार्श्वयुगले नाभिदेशे च देशिकः ।\nभालांश्च पार्श्वजठरे पार्श्वांसापरके हृदि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001698015, "chapter_id": 21698, "verse_number": "१-८४-१६", "content_sanskrit": "ब्रह्माण्याद्यास्तनौ न्यस्य विधिना प्रोक्तलक्षणाः ।\nमूलेन व्यापकं देहे न्यस्य देवीं विचिंतयेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001698016, "chapter_id": 21698, "verse_number": "१-८४-१७", "content_sanskrit": "उद्यद्दिवाकरनिभां तुंगोरोजां त्रिलोचनाम् ।   ।\nस्मरास्यामिंदुमुकुटां वरपाशांकुशाभयाम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001698017, "chapter_id": 21698, "verse_number": "१-८४-१८", "content_sanskrit": "रदलक्षं जपेन्मंत्रं त्रिमध्वक्तैर्हुनेत्ततः ।\nअष्टद्रव्यैर्दशांशेन ब्रह्मवृक्षसमिद्वरैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001698018, "chapter_id": 21698, "verse_number": "१-८४-१९", "content_sanskrit": "द्राक्षाखर्जूरवातादशर्करानालिकेरकम् ।\nतन्दुलाज्यतिलं विप्र द्रव्याष्टकमुदाहृतम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001698019, "chapter_id": 21698, "verse_number": "१-८४-२०", "content_sanskrit": "दद्यादर्ध्यं दिनेशाय तत्र संचिन्त्य पार्वतीम् ।\nपद्ममष्टदलं बाह्ये वृत्तं षोडशभिर्द्दलैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001698020, "chapter_id": 21698, "verse_number": "१-८४-२१", "content_sanskrit": "विलिखेत्कर्णिकामध्ये षट्कोणमतिसुन्दरम् ।\nततः संपूजयेत्पीठं नवशक्तिसमन्वितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001698021, "chapter_id": 21698, "verse_number": "१-८४-२२", "content_sanskrit": "जयाख्या विजया पश्चादजिताह्वापराजिता ।\nनित्या विलासिनी गोग्धीत्यघोरा मंगला नव ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001698022, "chapter_id": 21698, "verse_number": "१-८४-२३", "content_sanskrit": "बीजाढ्यमासनं दत्त्वा मूर्तिं तेनैव कल्पयेत् ।\nतस्यां संपूजयेद्देवीमावाह्यावरणैः क्रमात् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001698023, "chapter_id": 21698, "verse_number": "१-८४-२४", "content_sanskrit": "मध्यपाग्याम्यसौम्येषु पूजयेदंगदेवताः ।\nषट्कोणेषु यजेन्मंत्री पश्चान्मिथुनदेवताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001698024, "chapter_id": 21698, "verse_number": "१-८४-२५", "content_sanskrit": "इन्द्रकोणं लसद्दंडकुंडिकाक्षगुणाभयाम् ।\nगायत्रीं पूजयेन्मन्त्री ब्रह्माणमपि तादृशम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001698025, "chapter_id": 21698, "verse_number": "१-८४-२६", "content_sanskrit": "रक्षः कोणे शंखचक्रगदापंकजधारिणीम् ।\nसावित्रीं पीतवसनां यजेद्विणुं च तादृशम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001698026, "chapter_id": 21698, "verse_number": "१-८४-२७", "content_sanskrit": "वायुकोणे परश्वक्षमाला भयवरान्विताम् ।\nयजेत्सरस्वतीमच्छां रुद्रं तादृशलक्षणम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001698027, "chapter_id": 21698, "verse_number": "१-८४-२८", "content_sanskrit": "वह्निकोणे यजेद्रत्नकुंभं मणिकरंडकम् ।\nकराभ्यां बिभ्रतीं पीतां तुंदिलं धनदायकम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001698028, "chapter_id": 21698, "verse_number": "१-८४-२९", "content_sanskrit": "आलिंग्य सव्यहस्तेन वामे तांबूलधारिणीम् ।\nधनदांकसमारूढां महालक्ष्मीं प्रपूजयेत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001698029, "chapter_id": 21698, "verse_number": "१-८४-३०", "content_sanskrit": "पश्चिमे मदनं बाणपाशांकुशशरासनाम् ।\nधारयंतं जपारक्तं पूजयेद्रक्तभूषणम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001698030, "chapter_id": 21698, "verse_number": "१-८४-३१", "content_sanskrit": "सव्येन पतिमाश्लिष्य वामेनोत्पलधारिणीम् ।\nपाणिना रमणांकस्थां रतिं सम्यक्समर्चयेत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001698031, "chapter_id": 21698, "verse_number": "१-८४-३२", "content_sanskrit": "ऐशान्ये पूजयेत्सम्यक् विघ्नराजं प्रियान्वितम् ।\nसृणिपाशधरं कांतं वरांगासृक्कलांगुलिम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001698032, "chapter_id": 21698, "verse_number": "१-८४-३३", "content_sanskrit": "माध्वीपूर्णकपालाढ्यं विघ्नराजं दिगंबरम् ।\nपुष्करे विगलद्रत्नस्फुरच्चषकधारिणम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001698033, "chapter_id": 21698, "verse_number": "१-८४-३४", "content_sanskrit": "सिंदूरसदृशाकारामुद्दाममदविभ्रमाम् ।\nधृतरक्तोत्पलामन्यपाणिना तु ध्वजस्पृशाम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001698034, "chapter_id": 21698, "verse_number": "१-८४-३५", "content_sanskrit": "आश्लिष्टकांतामरुणां पुष्टिमर्चेद्दिगंबराम् ।\nकर्णिकायां निधी पूज्यौ षट्कोणस्याथ पार्श्वयोः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001698035, "chapter_id": 21698, "verse_number": "१-८४-३६", "content_sanskrit": "अंगानि केसरेष्वेताः पश्चात्पत्रेषु पूजयेत् ।\nअनंगकुसुमा पश्चाद्द्वितीयानंगमेखला ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001698036, "chapter_id": 21698, "verse_number": "१-८४-३७", "content_sanskrit": "अनंगगमना तद्वदनंगमदनातुरा ।\nभुवनपाला गगनवेगा षष्ठी चैव ततः परम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001698037, "chapter_id": 21698, "verse_number": "१-८४-३८", "content_sanskrit": "शशिलेखा गगनलेखा चेत्यष्टौ यत्र शक्तयः ।\nखङ्गखेटकधारिण्यः श्यामाः पूज्याश्च मातरः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001698038, "chapter_id": 21698, "verse_number": "१-८४-३९", "content_sanskrit": "पद्माद्बहिः समभ्यर्च्याः शक्तयः परिचारिकाः ।\nप्रथमानंगद्वयास्यादनंगमदना ततः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001698039, "chapter_id": 21698, "verse_number": "१-८४-४०", "content_sanskrit": "मदनातुरा भवनवेगा ततो भुवनपालिका ।\nस्यात्सर्वशिशिरानंगवेदनानंगमेखला ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001698040, "chapter_id": 21698, "verse_number": "१-८४-४१", "content_sanskrit": "चषकं तालवृंतं च तांबूलं छत्रमुज्ज्वलम् ।\nचामरे चांशुकं पुष्पं बिभ्राणाः करपंकजैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001698041, "chapter_id": 21698, "verse_number": "१-८४-४२", "content_sanskrit": "सर्वाभरणसंदीप्तान् लोकपालान्बहिर्यजेत् ।\nवज्रादीन्यपि तद्बाह्ये देवीमित्थं प्रपूजयेत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001698042, "chapter_id": 21698, "verse_number": "१-८४-४३", "content_sanskrit": "मंत्री त्रिमधुरोपेतैर्हुत्वाश्वत्थसमिद्वरैः ।\nब्राह्मणान्वशयेच्छीघ्रं पार्थिवान्पद्महोमतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001698043, "chapter_id": 21698, "verse_number": "१-८४-४४", "content_sanskrit": "पलाशपुष्पैस्तत्पत्नीं मंत्रिणः कुसुदैरपि ।\nपंचविंशतिधा जप्तैर्जलैः स्नानं दिने दिने ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001698044, "chapter_id": 21698, "verse_number": "१-८४-४५", "content_sanskrit": "आत्मानमभिषिंचेद्यः सर्वसौभाग्यवान्भवेत् ।\nपंचविंशतिधा जप्तं जलं प्रातः पिबेन्नरः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001698045, "chapter_id": 21698, "verse_number": "१-८४-४६", "content_sanskrit": "अवाप्य महतीं प्रज्ञां कवीनामग्रणीर्भवेत् ।\nकर्पूरागरुसंयुक्तकुंकुमं साधु साधितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001698046, "chapter_id": 21698, "verse_number": "१-८४-४७", "content_sanskrit": "गृहीत्वा तिलकं कुर्याद्राजवश्यमनुत्तमम् ।\nशालिपिष्टमयीं कृत्वा पुत्तलीं मधुरान्विताम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001698047, "chapter_id": 21698, "verse_number": "१-८४-४८", "content_sanskrit": "जप्तां प्रतिष्ठितप्राणां भक्षयेद्रविवासरे ।\nवशं नयति राजानं नारीं वा नरमेव च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001698048, "chapter_id": 21698, "verse_number": "१-८४-४९", "content_sanskrit": "कण्ठमात्रोदके स्थित्वा वीक्ष्य तोयोद्गतं रविम् ।\nत्रिसहस्रं जपेन्मंत्रं कन्यामिष्टां लभेत्ततः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001698049, "chapter_id": 21698, "verse_number": "१-८४-५०", "content_sanskrit": "अन्नं तन्मंत्रितं मंत्री भुंजीत श्रीप्रसिद्धये ।\nलिखितां भस्मना मायां ससाध्यां फलकादिषु ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001698050, "chapter_id": 21698, "verse_number": "१-८४-५१", "content_sanskrit": "तत्कालं दर्शयेद्यंत्रं सुखं सूयेत गर्भिणी ।\nभुवनेशीयमाख्याता सहस्रभुजसंभवा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001698051, "chapter_id": 21698, "verse_number": "१-८४-५२", "content_sanskrit": "भुक्तिमुक्तिप्रदा नॄणां स्मर्तॄणां द्विजसत्तम ।\nततः कल्पांतरे विप्र कदाचिन्महिषासुरः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001698052, "chapter_id": 21698, "verse_number": "१-८४-५३", "content_sanskrit": "बभूव लोकपालांस्तु जित्वा भुंक्ते जगत्त्रयम् ।\nततस्त्पीडिता देवा वैकुंठं शरणं ययुः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001698053, "chapter_id": 21698, "verse_number": "१-८४-५४", "content_sanskrit": "ततो देवी महालक्ष्मीश्चक्राद्यांगोत्थतेजसा ।\nश्रीर्बभूवमुनिश्रेष्ठ मूर्ता व्याप्तजगत्त्रया ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001698054, "chapter_id": 21698, "verse_number": "१-८४-५५", "content_sanskrit": "स्वयं सा महिषादींस्तु निहत्य जगदीश्वरी ।\nअरविंदवनं प्राप्ता भजतामिष्टदायिनी ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001698055, "chapter_id": 21698, "verse_number": "१-८४-५६", "content_sanskrit": "तस्याः समर्चनं वक्ष्ये संक्षेपेण श्रृणु द्विज ।\nमृत्युक्रोधेन गुरुणा बिंदुभूषितमस्तका ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001698056, "chapter_id": 21698, "verse_number": "१-८४-५७", "content_sanskrit": "बीजमन्त्रः श्रियः प्रोक्तो भजतामिष्टदायकः ।\nऋषिर्भृगुर्निवृच्छंदो देवता श्रीः समीरिता ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]