[{"id": 7002515000, "chapter_id": 22515, "verse_number": "१-१७७-१", "content_sanskrit": "अरुण उवाच ।\nपद्मरागप्रभा देवी चतुर्वदनपंकजा ।\nअक्षमालार्पितकरा कमंडलुधरा शुभा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002515001, "chapter_id": 22515, "verse_number": "१-१७७-२", "content_sanskrit": "ब्रह्माणी सौम्यवदना आदित्याराधने रता ।\nशांतिं करोतु सुप्रीता आशीर्वादपरा खग ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002515002, "chapter_id": 22515, "verse_number": "१-१७७-३", "content_sanskrit": "महाश्वेतेति विख्याता आदि त्यदयिता सदा ।\nहिमकुंदेंदुसदृशा महावृषभवाहिनी ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002515003, "chapter_id": 22515, "verse_number": "१-१७७-४", "content_sanskrit": "त्रिशूलहस्तावरणा विश्रुताभरणा सती ।\nचतुर्भुजा चतुर्वक्त्रा त्रिनेत्रा पापनाशिनी ।\nवृषध्वजार्चनरता रुद्राणी शांतिदा भवेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002515004, "chapter_id": 22515, "verse_number": "१-१७७-५", "content_sanskrit": "मयूरवाहना देवी सिंदूरारुणविग्रहा ।\nशक्तिहस्ता महाकाया सर्वालंकारभूषिता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002515005, "chapter_id": 22515, "verse_number": "१-१७७-६", "content_sanskrit": "सूर्यभक्ता महावीर्या सूर्यार्चनरता सदा ।\nकौमारी वरदा देवी शांतिमाशु करोतु ते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002515006, "chapter_id": 22515, "verse_number": "१-१७७-७", "content_sanskrit": "गदाचक्रधरा श्यामा पीतांबरधरा खग ।\nचतुर्भुजा हि सा देवी वैष्णवी सुरपूजिता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002515007, "chapter_id": 22515, "verse_number": "१-१७७-८", "content_sanskrit": "सूर्यार्चनपरा नित्यं सूर्यैकगतमानसा ।\nशांतिं करोतु ते नित्यं सर्वासुरविमर्दिनी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002515008, "chapter_id": 22515, "verse_number": "१-१७७-९", "content_sanskrit": "ऐरावतगजारूढा वज्रहस्ता महा बला ।\nसर्वत्रलोचना देवी वर्णतः कर्बुरारुणा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002515009, "chapter_id": 22515, "verse_number": "१-१७७-१०", "content_sanskrit": "सिद्धगंधर्वनमिता सर्वालंकारभूषिता ।\nइंद्राणी ते सदा देवी शांतिमाशु करोतु वै ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002515010, "chapter_id": 22515, "verse_number": "१-१७७-११", "content_sanskrit": "वराहघोणा विकटा वराहवरवाहिनी ।\nश्यामावदाता या देवी शंखचक्रगदाधरा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002515011, "chapter_id": 22515, "verse_number": "१-१७७-१२", "content_sanskrit": "तेजयंतीति निमिषान्पूजयंती सदा रविम् ।\nवाराही वरदा देवी तव शांतिं करोतु वै ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002515012, "chapter_id": 22515, "verse_number": "१-१७७-१३", "content_sanskrit": "अर्धकोशा कटीक्षामा निर्मांसा स्नायुबंधनात् ।\nकरालवना घोरा खड्गघंटोद्गता सती ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002515013, "chapter_id": 22515, "verse_number": "१-१७७-१४", "content_sanskrit": "कपालमालिनी क्रूरा खट्वांगवरधारिणी ।\nआरक्ता पिंगनयना गजचर्मावगुंठिता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002515014, "chapter_id": 22515, "verse_number": "१-१७७-१५", "content_sanskrit": "गोश्रुताभरणा देवी प्रेतस्थाननिवासिनी ।\nशिवारूपेण घोरेण शिवरूपभयंकरी ।\nचामुंडा चंडरूपेण सदा शांतिं करोतु ते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002515015, "chapter_id": 22515, "verse_number": "१-१७७-१६", "content_sanskrit": "चंडमुंडकरा देवी मुंडदेहगता सती ।\nकपालमालिनी क्रूरा खद्वांगवरधा रिणी ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002515016, "chapter_id": 22515, "verse_number": "१-१७७-१७", "content_sanskrit": "आकाशमातरो देव्यस्तथान्या लोकमातरः ।\nभूतानां मातरः सर्वास्तथान्याः पितृमातरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002515017, "chapter_id": 22515, "verse_number": "१-१७७-१८", "content_sanskrit": "वृद्धिश्राद्धेषु पूज्यंते यास्तु देव्यो मनीषिभिः ।\nमात्रे प्रमात्रे तन्मात्रे इति मातृमुखास्तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002515018, "chapter_id": 22515, "verse_number": "१-१७७-१९", "content_sanskrit": "पितामही तु तन्माता वृद्धा या च पितामही ।\nइत्येतास्तु पितामह्यः शांतिं ते पितृमातरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002515019, "chapter_id": 22515, "verse_number": "१-१७७-२०", "content_sanskrit": "सर्वा मातृमहादेव्यः स्वायुधाव्यग्रपाणयः ।\nजगद्व्याप्य प्रतिष्ठंत्यो बलिकामा महोदयाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002515020, "chapter_id": 22515, "verse_number": "१-१७७-२१", "content_sanskrit": "शांतिं कुर्वंतु ता नित्यमादित्याराधने रताः ।\nशांतेन चेतसा शांत्यः शांतये तव शांतिदा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002515021, "chapter_id": 22515, "verse_number": "१-१७७-२२", "content_sanskrit": "सर्वावयवमुख्येन गात्रेण च सुमध्यमा ।\nपीतश्यामाति सौम्येन स्निग्धवर्णेन शोभना ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002515022, "chapter_id": 22515, "verse_number": "१-१७७-२३", "content_sanskrit": "ललाटतिलकोपेता चंद्ररेखार्धधारिणी ।\nचित्रांबरधरा देवी सर्वाभरणभूषिता ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002515023, "chapter_id": 22515, "verse_number": "१-१७७-२४", "content_sanskrit": "वरा स्त्रीमयरूपाणां शोभा गुणसुसम्पदा ।\nभावनामात्रसंतुष्टा उमा देवी वरप्रदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002515024, "chapter_id": 22515, "verse_number": "१-१७७-२५", "content_sanskrit": "साक्षादागत्य रूपेण शांतेनामिततेजसा ।\nशांतिं करोतु ते प्रीता आदित्या राधने रता ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]