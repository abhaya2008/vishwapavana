[{"id": 7000155000, "chapter_id": 20155, "verse_number": "१५५-१", "content_sanskrit": "कपिलातीर्थवर्णनम् ब्रह्मोवाच कपिलातीर्थमाक्यातं तदेवाऽऽङ्गिरसं स्मृतम् ।\nतदेवाऽऽदित्यमाख्यातं सैंहिकेयं तदुच्यते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000155001, "chapter_id": 20155, "verse_number": "१५५-२", "content_sanskrit": "गौतम्या दक्षिमे पारे आदित्यान्मुनिसत्तम ।\nअयाजयन्नङ्गिरसो दक्षिणां ते भुवं ददुः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000155002, "chapter_id": 20155, "verse_number": "१५५-३", "content_sanskrit": "अङ्गिरोभ्यस्तदाऽऽदित्यास्तपसेऽङ्गिरसो ययुः ।\nसा भूमिः सैंहिका भूत्वा जनान्सर्वानभक्षयत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000155003, "chapter_id": 20155, "verse_number": "१५५-४", "content_sanskrit": "तत्रसुस्ते जनाः सर्वे अङ्गिरोभ्यो न्यवेदयन् ।\nविभीता ज्ञानतो ज्ञात्वा भुवं तां सैहिकीमिति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000155004, "chapter_id": 20155, "verse_number": "१५५-५", "content_sanskrit": "आदित्याननुगत्वाऽथ वाचमङ्गिरसोऽब्रुवन् ।\nभुवं गृह्णान्तु या दत्ता नेत्यादित्यास्तदाऽब्रुवन् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000155005, "chapter_id": 20155, "verse_number": "१५५-६", "content_sanskrit": "निवृत्तां दक्षिणां नैव प्रतिगृह्णान्ति सूरयः ।\nस्वदत्तां परदत्तां वा यो हरेत वसुंधराम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000155006, "chapter_id": 20155, "verse_number": "१५५-७", "content_sanskrit": "षष्टिर्वर्षसहस्राणि विष्ठायां जायते कृमिः ।\nभूमेः स्वपरदत्ताया हरणान्नाधिकं क्वचित् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000155007, "chapter_id": 20155, "verse_number": "१५५-८", "content_sanskrit": "पापमस्ति महारौद्रं न स्वीकुर्मः पुनस्तु ताम् ।\nएवं यदा स्वदत्ताया हरणे किं तदा भवेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000155008, "chapter_id": 20155, "verse_number": "१५५-९", "content_sanskrit": "तथाऽपि क्रयरूपेण गृह्णीमो दक्षिणां भुवम् ।\nतथेत्युक्ते तु ते देवाः कपिलां शुभलक्षणाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000155009, "chapter_id": 20155, "verse_number": "१५५-१०", "content_sanskrit": "गङ्गाया दक्षिणे पारे भुवः स्थाने तु तां ददुः ।\nभुक्तिमुक्तिप्रदः साक्षाद्विष्णुस्तिष्ठति मूर्तिमान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000155010, "chapter_id": 20155, "verse_number": "१५५-११", "content_sanskrit": "कपिलासंगमं तच्च सर्वाघौघविनाशनम् ।\nतत्राभवद्दानतोयादापगा कपिलाभिधा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000155011, "chapter_id": 20155, "verse_number": "१५५-१२", "content_sanskrit": "सस्यवत्या अपि भुवो दानाद्‌गोदानमुत्तमम् ।\nलोकरक्षां चकारासौ कृत्वा विनिमयं मुनिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000155012, "chapter_id": 20155, "verse_number": "१५५-१३", "content_sanskrit": "यत्र तीर्थे च तद्‌वृत्तं गोतीर्थं तदुदाहृतम् ।\nपुण्यदं तत्र तीर्थानां शतमुक्तं मनीषिभिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000155013, "chapter_id": 20155, "verse_number": "१५५-१४", "content_sanskrit": "तत्र स्नानेन दानेन भूमिदानफलं लभेत् ।\nसंगता गङ्गया तच्च कपिलासंगमं विदुः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]