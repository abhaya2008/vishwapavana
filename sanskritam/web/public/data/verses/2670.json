[{"id": 2078639, "chapter_id": 2670, "verse_number": "१२-१७५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078640, "chapter_id": 2670, "verse_number": "१२-१७५-१", "content_sanskrit": "धनिनश्चाधना ये च वर्तयन्ति स्वतन्त्रिणः।\nसुखदुःखागमस्तेषां कः कथं वा पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078641, "chapter_id": 2670, "verse_number": "१२-१७५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078642, "chapter_id": 2670, "verse_number": "१२-१७५-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nशम्याकेन विमुक्तेन गीतं शान्तिगतेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078643, "chapter_id": 2670, "verse_number": "१२-१७५-३", "content_sanskrit": "अब्रवीन्मां पुरा कश्चिद्ब्राह्मणस्त्यागमाश्रितः।\nक्लिश्यमानः कुदारेण कुचेलेन बुभुक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078644, "chapter_id": 2670, "verse_number": "१२-१७५-४", "content_sanskrit": "उत्पन्नमिह लोके वै जन्मप्रभृति मानवम्।\nविविधान्युपवर्तन्ते दुःखानि च सुखानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078645, "chapter_id": 2670, "verse_number": "१२-१७५-५", "content_sanskrit": "तयोरेकतरो मार्गो यदेनमुपसन्नयेत्।\nन सुखं प्राप्य संहृष्येन्नासुखं प्राप्य संज्वरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078646, "chapter_id": 2670, "verse_number": "१२-१७५-६", "content_sanskrit": "न वै चरसि यच्छ्रेय आत्मनो वा न रंस्यसे।\nअकामात्माऽपि हि सदा धुरमुद्यम्य चैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078647, "chapter_id": 2670, "verse_number": "१२-१७५-७", "content_sanskrit": "अकिञ्चनः परिपतन्सुखमास्वादयिष्यसि।\nअकिञ्चनः सुखं शेते समुत्तिष्ठति चैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078648, "chapter_id": 2670, "verse_number": "१२-१७५-८", "content_sanskrit": "आकिञ्चन्यं सुखं लोके पथ्यं शिवमनामयम्।\nअनमित्रपथो ह्येष दुर्लभः सुलभः सताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078649, "chapter_id": 2670, "verse_number": "१२-१७५-९", "content_sanskrit": "अकिञ्चनस्य शुद्धस्य उपपन्नस्य सर्वतः।\nअवेक्षमाणस्त्रील्लोँकान्न तुल्यमिह लक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078650, "chapter_id": 2670, "verse_number": "१२-१७५-१०", "content_sanskrit": "आकिञ्चन्यं च राज्यं च तुलया समतोलयम्।\nअत्यरिच्यत दारिद्र्यं राज्यादपि गुणाधिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078651, "chapter_id": 2670, "verse_number": "१२-१७५-११", "content_sanskrit": "आकिञ्चन्ये च राज्ये च विशेषः सुमहानयम्।\nनित्योद्विग्नो हि धनवान्मृत्योरास्यगतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078652, "chapter_id": 2670, "verse_number": "१२-१७५-१२", "content_sanskrit": "नैवास्याग्निर्न चादित्यो न मृत्युर्न च दस्यवः।\nप्रभवन्ति धनं हर्तुमितरे स्युः कुतः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078653, "chapter_id": 2670, "verse_number": "१२-१७५-१३", "content_sanskrit": "तं वै सदा कामचरमनुपस्तीर्णशायिनम्।\nबाहूपधानं शाम्यन्तं प्रशंसन्ति दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078654, "chapter_id": 2670, "verse_number": "१२-१७५-१४", "content_sanskrit": "धनवान्क्रोधलोभाभ्यामाविष्टो नष्टचेतनः।\nतिर्यग्दृष्टिः शुष्कमुखः पापको भ्रुकुटीमुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078655, "chapter_id": 2670, "verse_number": "१२-१७५-१५", "content_sanskrit": "निर्दशन्नधरोष्ठं च क्रुद्धो दारुणभाषिता।\nकस्तमिच्छेत्परिद्रष्टुं दातुमिच्छति चेन्महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078656, "chapter_id": 2670, "verse_number": "१२-१७५-१६", "content_sanskrit": "श्रिया ह्यभीक्ष्णं संवासो मोहयत्यविचक्षणम्।\nसा तस्य चित्तं हरति शारदाभ्रमिवानिलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078657, "chapter_id": 2670, "verse_number": "१२-१७५-१७", "content_sanskrit": "अथैनं रूपमानश्च धनपानश्च विन्दति।\nअभिजातोऽस्मि सिद्धोऽस्मि नास्मि केवलमानुषः।\nइत्येभिः कारणैस्तस्य त्रिभिश्चित्तं प्रमाद्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078658, "chapter_id": 2670, "verse_number": "१२-१७५-१८", "content_sanskrit": "संप्रसक्तमना भोगान्विसृज्य पितृसंचितान्।\nपरिक्षीणः परस्वानामादानं साधु मन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078659, "chapter_id": 2670, "verse_number": "१२-१७५-१९", "content_sanskrit": "तमतिक्रान्तमर्यादमाददानं ततस्ततः।\nप्रतिषेधन्ति राजानो लुब्धा मृगमिवेषुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078660, "chapter_id": 2670, "verse_number": "१२-१७५-२०", "content_sanskrit": "एवमेतानि दुःखानि तानि तानीह मानवम्।\nविविधान्युपवर्तन्ते गात्रसंस्पर्शजान्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078661, "chapter_id": 2670, "verse_number": "१२-१७५-२१", "content_sanskrit": "तेषां परमदुःखानां बुद्ध्या भैषज्यमाचरेत्।\nलोकधर्मं समाज्ञाय ध्रुवाणामध्रुवैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078662, "chapter_id": 2670, "verse_number": "१२-१७५-२२", "content_sanskrit": "नात्यक्त्वा सुखमाप्नोति नात्यक्त्वा विन्दते परम्।\nनात्यक्त्वा चाभयः शेते त्यक्त्वा सर्वं सुखी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078663, "chapter_id": 2670, "verse_number": "१२-१७५-२३", "content_sanskrit": "इत्येतद्धास्तिनपुरे ब्राह्मणेनोपवर्णितम्।\nशम्याकेन पुरा मह्यं तस्मात्त्यागः परो मतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078664, "chapter_id": 2670, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि पञ्चसप्तत्यधिकशततमोऽध्यायः॥ १७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]