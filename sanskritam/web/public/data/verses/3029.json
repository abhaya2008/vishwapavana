[{"id": 2094835, "chapter_id": 3029, "verse_number": "१३-१५९-१", "content_sanskrit": "युधिष्ठिर उवाच।\nएको लोकस्तु कृतिनां स्वर्गे लोके पितामह।\nउत तत्रापि नानात्वं सर्वं ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094836, "chapter_id": 3029, "verse_number": "१३-१५९-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094837, "chapter_id": 3029, "verse_number": "१३-१५९-२", "content_sanskrit": "कर्मभिः पार्थ नानात्वं लोकानां यान्ति मानवाः।\nपुण्यान्पुण्यकृतो यान्ति पापान्पापकृतो नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094838, "chapter_id": 3029, "verse_number": "१३-१५९-३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nगौतमस्य मुनेस्तात संवादं वासवस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094839, "chapter_id": 3029, "verse_number": "१३-१५९-४", "content_sanskrit": "ब्राह्मणो गौतमः कश्चिन्मृदुर्दान्तो जितेन्द्रियः।\nमहावने हस्तिशिशुं परिद्यूनममातृकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094840, "chapter_id": 3029, "verse_number": "१३-१५९-५", "content_sanskrit": "तं दृष्ट्वा जीवयामास सानुक्रोशो धृतव्रतः।\nस तु दीर्घेण कालेनि बभूवातिबलो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094841, "chapter_id": 3029, "verse_number": "१३-१५९-६", "content_sanskrit": "तं प्रपन्नं महादीर्घं प्रभूतं सर्वतोमदम्।\nधृतराष्ट्रस्वरूपेण शक्रो जग्राह हस्तिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094842, "chapter_id": 3029, "verse_number": "१३-१५९-७", "content_sanskrit": "ह्रियमाणं तु तं दृष्ट्वा गौतमः संशितव्रतः।\nअभ्यभाषत राजानं धृतराष्ट्रं महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094843, "chapter_id": 3029, "verse_number": "१३-१५९-८", "content_sanskrit": "मामाहार्षीर्हस्तिनं पुत्रमेनं\nदुःखात्पुष्टं धृतराष्ट्रात्कृतज्ञ।\nमैत्रं सतां सप्तपदं वदन्ति\nमित्रद्रोहो नेह राजन्स्पृसेत्त्वाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094844, "chapter_id": 3029, "verse_number": "१३-१५९-९", "content_sanskrit": "इध्मोदकप्रदातारं शून्यपालं ममाश्रमे।\nविनीतमाचार्यकुले सुयुक्तं गुरुकर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094845, "chapter_id": 3029, "verse_number": "१३-१५९-१०", "content_sanskrit": "शिष्टं दान्तं कृतज्ञं च प्रियं च सततं मम।\nन मे विक्रोशतो राजन्हर्तुमर्हसि कुञ्जरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094846, "chapter_id": 3029, "verse_number": "१३-१५९-११x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094847, "chapter_id": 3029, "verse_number": "१३-१५९-११", "content_sanskrit": "गवां सहस्रं भवते ददानि\nशतानि निष्कस्य ददानि पञ्च।\nअन्यच्च वित्तं विविधं महर्षे\nकिं ब्राह्मणस्येह गजेन कृत्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094848, "chapter_id": 3029, "verse_number": "१३-१५९-१२x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094849, "chapter_id": 3029, "verse_number": "१३-१५९-१२", "content_sanskrit": "तवैव गावो हि भवन्तु राज-\nन्दास्यः सनिष्का विविधं च रत्नम्।\nअन्यच्च वित्तं विविधं नरेन्द्र\nकिं ब्राह्मणस्येह धनेन कृत्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2094850, "chapter_id": 3029, "verse_number": "१३-१५९-१३x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2094851, "chapter_id": 3029, "verse_number": "१३-१५९-१३", "content_sanskrit": "ब्राह्मणानां हस्तिभिर्नास्ति कृत्यं\nराजन्यानां नागकुलानि विप्र।\nस्वं वाहनं नयतो नास्त्यधर्मो\nनागश्रेष्ठं गौतमास्मान्निवर्त॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2094852, "chapter_id": 3029, "verse_number": "१३-१५९-१४x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2094853, "chapter_id": 3029, "verse_number": "१३-१५९-१४", "content_sanskrit": "यत्र प्रेतो नन्दति पुण्यकर्मा\nयत्र प्रेतः शोचते पापकर्मा।\nवैवस्वतस्य सदने महात्मन-\nस्तत्र त्वाऽहं हस्तिनं यातयिष्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2094854, "chapter_id": 3029, "verse_number": "१३-१५९-१५x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2094855, "chapter_id": 3029, "verse_number": "१३-१५९-१५", "content_sanskrit": "ये निष्क्रिया नास्तिकाः श्रद्धधानाः\nपापात्मान इन्द्रियार्थे निसृष्टाः।\nयमस्य ते यातनां प्राप्नुवन्ति\nपरं गन्ता धृतराष्ट्रो न तत्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2094856, "chapter_id": 3029, "verse_number": "१३-१५९-१६x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2094857, "chapter_id": 3029, "verse_number": "१३-१५९-१६", "content_sanskrit": "वैवस्वती संयमनी जनानां\nयत्रानृतं नोच्यते यत्र सत्यम्।\nयत्रांबलान्बलिनो घातयन्ति\nतत्र त्वाऽहं हस्तिनं यातयिष्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2094858, "chapter_id": 3029, "verse_number": "१३-१५९-१७x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2094859, "chapter_id": 3029, "verse_number": "१३-१५९-१७", "content_sanskrit": "ज्येष्ठां स्वसारं पितरं मातरं च\nगुरून्यथाऽमानयन्तश्चरन्ति।\nतथाविधानामेष लोको महर्षे\nपरं गन्ता धृतराष्ट्रो न तत्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2094860, "chapter_id": 3029, "verse_number": "१३-१५९-१८x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2094861, "chapter_id": 3029, "verse_number": "१३-१५९-१८", "content_sanskrit": "मन्दाकिनी वैश्रवणस् राज्ञो\nमहाभागा भोगिजनप्रवेश्या।\nगन्धर्वयक्षैरप्सरोभिश्च जुष्टा\nतत्र त्वाऽहं हस्तिनं यातयिष्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2094862, "chapter_id": 3029, "verse_number": "१३-१५९-१९x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2094863, "chapter_id": 3029, "verse_number": "१३-१५९-१९", "content_sanskrit": "अतिथिव्रताः सुव्रता ये जना वै\nप्रतिश्रयं ददति ब्राह्मणेभ्यः।\nशिष्टाशिनः संविभज्याश्रितेभ्यो\nमन्दाकिनीं तेऽपि हि भूषयन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2094864, "chapter_id": 3029, "verse_number": "१३-१५९-२०x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2094865, "chapter_id": 3029, "verse_number": "१३-१५९-२०", "content_sanskrit": "मेरोरग्रे यद्वनं भाति रम्यं\nसुपुष्पितं किन्नरीगीतजुष्टम्।\nसुदर्शना यत्र जम्बूर्विशाला\nतत्र त्वाऽहं हस्तिनं यातयिष्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2094866, "chapter_id": 3029, "verse_number": "१३-१५९-२१x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2094867, "chapter_id": 3029, "verse_number": "१३-१५९-२१", "content_sanskrit": "ये ब्राह्मणा मृदवः सत्यशीला\nबहुश्रुताः सर्वभूताभिरामाः।\nयेऽधीयते सेतिहासं पुराणं\nमध्वाहुत्या जुह्वति वै द्विजेभ्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2094868, "chapter_id": 3029, "verse_number": "१३-१५९-२२", "content_sanskrit": "तथाविधानामेष लोको महर्षे\nपरं गन्ता धृतराष्ट्रो न तत्र।\nयदन्यत्ते विदितं स्थानमस्ति\nतद्ब्रूहि त्वं त्वरितो ह्येष यामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2094869, "chapter_id": 3029, "verse_number": "१३-१५९-२३x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2094870, "chapter_id": 3029, "verse_number": "१३-१५९-२३", "content_sanskrit": "सुपुष्पितं किंनरराजजुष्टं\nप्रियं वनं नन्दनं नारदस्य।\nगन्धर्वाणामप्सरसां च सद्म\nतत्र त्वाऽहं हस्तिनं यातयिष्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2094871, "chapter_id": 3029, "verse_number": "१३-१५४-२४x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2094872, "chapter_id": 3029, "verse_number": "१३-१५९-२४", "content_sanskrit": "ये नृत्यगीते कुशला जनाः सदा\nदेवात्मानः प्रियकामाश्चरन्ति।\nतथाविधानामेष लोको महर्षे\nपरं गन्ता धृतराष्ट्रो न तत्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2094873, "chapter_id": 3029, "verse_number": "१३-१५९-२५x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2094874, "chapter_id": 3029, "verse_number": "१३-१५९-२५", "content_sanskrit": "यत्रोत्तराः कुरवो भान्ति रम्या\nदेवैः सार्धं मोदमाना नरेन्द्रः।\nयत्राग्नियौनाश्च वसन्ति विप्रा\nअब्योनयः पर्वतयोनयश्च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2094875, "chapter_id": 3029, "verse_number": "१३-१५९-२६", "content_sanskrit": "यत्र शक्रो वर्षति सर्वकामा-\nन्यत्र स्त्रियः कामचारा भवन्ति।\nयत्र चेर्ष्या नास्ति नारीनराणां\nतत्र त्वाऽहं हस्तिनं यातयिष्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2094876, "chapter_id": 3029, "verse_number": "१३-१५९-२७x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2094877, "chapter_id": 3029, "verse_number": "१३-१५९-२७", "content_sanskrit": "ये सर्वभूतेषु निवृत्तकामा\nअमांसादा न्यस्तदण्डाश्चरन्ति।\nन हिंसन्ति स्थावरं जङ्गमानि\nभूतानां ये सर्वभूतात्मभूताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2094878, "chapter_id": 3029, "verse_number": "१३-१५९-२८", "content_sanskrit": "निराशिषो निर्ममा वीतरागा\nलाभालाभे तुल्यनिन्दाप्रशंसाः।\nतथाविधानामेष लोको महर्षे\nपरं गन्ता धृतराष्ट्रो न तत्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2094879, "chapter_id": 3029, "verse_number": "१३-१५९-२९x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2094880, "chapter_id": 3029, "verse_number": "१३-१५९-२९", "content_sanskrit": "ततोऽपरे भान्ति लोकाः सनातनाः\nसुपुण्यगन्धा विरजा वीतशोकाः।\nसोमस्य राज्ञः सदने महात्मन-\nस्तत्र त्वाऽहं हस्तिनं यातयिष्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2094881, "chapter_id": 3029, "verse_number": "१३-१५९-३०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2094882, "chapter_id": 3029, "verse_number": "१३-१५९-३०", "content_sanskrit": "ये दानशीला न प्रतिगृह्णते सदा\nन चाप्यर्थांश्चाददते परेभ्यः।\nयेषामदेयमर्हते नास्ति किञ्चि-\nत्सर्वातिथ्याः सुप्रजना जनाश्च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2094883, "chapter_id": 3029, "verse_number": "१३-१५९-३१", "content_sanskrit": "ये क्षन्तारो नाभिजल्पन्ति चान्या-\nञ्शक्ता भूत्वा सततं पुण्यशीलाः।\nतथाविधानामेष लोको महर्षे\nपरं गन्ता धृतराष्ट्रो न तत्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2094884, "chapter_id": 3029, "verse_number": "१३-१५९-३२x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2094885, "chapter_id": 3029, "verse_number": "१३-१५९-३२", "content_sanskrit": "ततोऽपरे भान्ति लोकाः सनातना\nविराजसा वितमस्का विशोकाः।\nआदित्यदेवस्य पदं महात्मन-\nस्तत्र त्वाऽहं हस्तिनं यातयिष्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2094886, "chapter_id": 3029, "verse_number": "१३-१५९-३३x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2094887, "chapter_id": 3029, "verse_number": "१३-१५९-३३", "content_sanskrit": "स्वाध्यायशीला गुरुशुश्रूषकाश्च\nतपस्विनः सुव्रताः सत्यसन्धाः।\nआचार्याणामप्रतिकूलभाषिणो\nनित्योत्थिता गुरुकर्मस्वचोद्याः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2094888, "chapter_id": 3029, "verse_number": "१३-१५९-३४", "content_sanskrit": "तथाविधानामेष लोको महर्षे\nविशुद्धानां भावितो वाग्यतानाम्।\nसत्ये स्थितानां वेदविदां महात्मनां\nपरं गन्ता धृतराष्ट्रो न तत्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2094889, "chapter_id": 3029, "verse_number": "१३-१५९-३५x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2094890, "chapter_id": 3029, "verse_number": "१३-१५९-३५", "content_sanskrit": "ततोऽपरे भान्ति लोकाः सनातनाः\nसुपुण्यगन्धा विरजा विशोकाः।\nवरुणस्य राज्ञः सदने महात्मन-\nस्तत्र त्वाऽहं हस्तिनं यातयिष्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2094891, "chapter_id": 3029, "verse_number": "१३-१५९-३६x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2094892, "chapter_id": 3029, "verse_number": "१३-१५९-३६", "content_sanskrit": "चातुर्मास्यैर्ये यजन्ते जनाः सदा\nतथेष्टीनां दशशतं प्राप्नुवन्ति।\nये चाग्निहोत्रं जुह्वति श्रद्दधाना\nयथान्यायं त्रीणि वर्षाणि विप्राः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2094893, "chapter_id": 3029, "verse_number": "१३-१५९-३७", "content_sanskrit": "स्वदारगाणां धर्मकृतां महात्मनां\nयथोदिते वर्त्मनि सुस्थितानाम्।\nधर्मान्मनामुद्वहतां गतिं तां\nपरं गन्ता धृतराष्ट्रो न तत्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2094894, "chapter_id": 3029, "verse_number": "१३-१५९-३८x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2094895, "chapter_id": 3029, "verse_number": "१३-१५९-३८", "content_sanskrit": "इन्द्रस्य लोका विरजा विशोका\nदुरन्वयाः काङ्क्षिता मानवानाम्।\nतस्याहं ते भवने भूरितेजसो\nराजन्निमं हस्तिनं यातयिष्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2094896, "chapter_id": 3029, "verse_number": "१३-१५९-३९x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2094897, "chapter_id": 3029, "verse_number": "१३-१५९-३९", "content_sanskrit": "शतवर्षजीवी यश्च शूरो मनुष्यो\nवेदाध्यायी यश्च यज्वाऽप्रमत्तः।\nएते सर्वे शक्रलोकं व्रजन्ति\nपरं गन्ता धृतराष्ट्रो न तत्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2094898, "chapter_id": 3029, "verse_number": "१३-१५९-४०x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2094899, "chapter_id": 3029, "verse_number": "१३-१५९-४०", "content_sanskrit": "प्राजापत्याः सन्ति लोका महान्तो\nनाकस्य पृष्ठे पुष्कला वीतशोकाः।\nमनीषिणां सर्वलोकाभयानां\nतत्र त्वाऽहं हस्तिनं यातयिष्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2094900, "chapter_id": 3029, "verse_number": "१३-१५९-४१x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2094901, "chapter_id": 3029, "verse_number": "१३-१५९-४१", "content_sanskrit": "ये राजानो राजसूयाभिषिक्ता\nधर्मात्मानो रक्षितारः प्रजानाम्।\nये चाश्वमेधावभृथे प्लुताङ्गा-\nस्तेषां लोका धृतराष्ट्रो न तत्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2094902, "chapter_id": 3029, "verse_number": "१३-१५९-४२x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2094903, "chapter_id": 3029, "verse_number": "१३-१५९-४२", "content_sanskrit": "ततःपरं भान्ति लोकाः सनातनाः\nसुपुण्यगन्धा विरजा वीतशोकाः।\nतस्मिन्नहं दुर्लभे चाप्यधृष्ये\nगवां लोके हस्तिनं यातयिष्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2094904, "chapter_id": 3029, "verse_number": "१३-१५९-४३x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2094905, "chapter_id": 3029, "verse_number": "१३-१५९-४३", "content_sanskrit": "यो गोसहस्री शतदो महात्मा\nयो गोशती दश दद्याच्च शक्त्या।\nतथा दशभ्यो यश्च दद्यादिहैकां\nपञ्चभ्यो वा दानशीलस्तथैकाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2094906, "chapter_id": 3029, "verse_number": "१३-१५९-४४", "content_sanskrit": "ये जीर्यन्ते ब्रह्मचर्येणि विप्रा\nब्राह्मीं वाचं परिरक्षन्ति चैव।\nमनस्विनस्तीर्थयात्रापरा ये\nते तत्र मोदन्ति ततो विमानैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2094907, "chapter_id": 3029, "verse_number": "१३-१५९-४५", "content_sanskrit": "प्रभासं मानसं तीर्थ पुष्कराणि महत्सरः।\nपुण्यं च नैमिषं तीर्थं बाहुदां करतोयिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2094908, "chapter_id": 3029, "verse_number": "१३-१५९-४६", "content_sanskrit": "गां हयशिरश्चैव विपाशां स्थूलवालुकाम्।\nतूष्णीं गङ्गां शनैर्गङ्गां महाह्रदमथापि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2094909, "chapter_id": 3029, "verse_number": "१३-१५९-४७", "content_sanskrit": "गोमतीं कौशिकीं पंपां महात्मानो धृतव्रताः।\nसरस्वतीदृषद्वत्यौ यमुनां ये तु यान्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2094910, "chapter_id": 3029, "verse_number": "१३-१५९-४८", "content_sanskrit": "तत ते दिव्यसंस्थाना दिव्यमाल्यधराः शिवाः।\nप्रयान्ति पुण्यगन्धाढ्या धृतराष्ट्रो न तत्र वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2094911, "chapter_id": 3029, "verse_number": "१३-१५९-४९x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2094912, "chapter_id": 3029, "verse_number": "१३-१५९-४९", "content_sanskrit": "यत्र शीतभयं नास्ति न चोष्णभयमण्वपि।\nन क्षुत्पिपासे न ग्लानिर्न दुःखं न सुखं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2094913, "chapter_id": 3029, "verse_number": "१३-१५९-५०", "content_sanskrit": "न द्वेष्यो न प्रियः कश्चिन्न बन्धुर्न रिपुस्तथा।\nन जरामरणे तत्र न पुण्यं न च पातकम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2094914, "chapter_id": 3029, "verse_number": "१३-१५९-५१", "content_sanskrit": "तस्मिन्विरजसि स्फीते प्रज्ञासत्वव्यवस्थिते।\nस्वयम्भुभवने पुण्ये हस्तिनं यातयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2094915, "chapter_id": 3029, "verse_number": "१३-१५९-५२x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2094916, "chapter_id": 3029, "verse_number": "१३-१५९-५२", "content_sanskrit": "निर्मुक्ताः सर्वसङ्गैर्ये कृतात्मानो यतव्रताः।\nअध्यात्मयोगसंस्तानैर्युक्ताः स्वर्गगतिं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2094917, "chapter_id": 3029, "verse_number": "१३-१५९-५३", "content_sanskrit": "ते ब्रह्मभवनं पुण्यं प्राप्नुवन्तीह सात्विकाः।\nन तत्र धृतराष्ट्रस्ते शक्यो द्रष्टुं महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2094918, "chapter_id": 3029, "verse_number": "१३-१५९-५४x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2094919, "chapter_id": 3029, "verse_number": "१३-१५९-५४", "content_sanskrit": "रथन्तरं यत्र बृहच्च गीयते\nयत्र वेदिः पुण्यजनैर्वृता च।\nयत्रोपयाति हरिभिः सोमपीथी\nतत्र त्वाऽहं हस्तिनं यातयिष्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2094920, "chapter_id": 3029, "verse_number": "१३-१५९-५५", "content_sanskrit": "बुध्यामि त्वां वृत्रहणं शतक्रतुं\nव्यतिक्रमन्तं भुवनानि विश्वा।\nकच्चिन्न वाचा वृजिनं कदाचि-\nदकार्षं ते मनसोऽभिषङ्कात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2094921, "chapter_id": 3029, "verse_number": "१३-१५९-५६x", "content_sanskrit": "शतक्रतुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2094922, "chapter_id": 3029, "verse_number": "१३-१५९-५६", "content_sanskrit": "मघवाऽहं लोकपथं प्रजाना-\nमन्वागमं परिवादे गजस्य।\nतस्माद्भवान्प्रणतं माऽनुशास्तु\nब्रवीषि यत्तत्करवाणि सर्वम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2094923, "chapter_id": 3029, "verse_number": "१३-१५९-५७x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2094924, "chapter_id": 3029, "verse_number": "१३-१५९-५७", "content_sanskrit": "श्वेतं करेणुं मम पुत्रं हि नागं\nप्रियं तु मे षष्टिवर्षं तु बालम्।\nयो मे वने वसतोऽभूद्द्वितीय-\nस्तमेव मे देहि सुरेन्द्र नागम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2094925, "chapter_id": 3029, "verse_number": "१३-१५९-५८x", "content_sanskrit": "शतक्रतुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2094926, "chapter_id": 3029, "verse_number": "१३-१५९-५८", "content_sanskrit": "अयं सुतस्ते द्विजमुख्यनाग\nआघ्रायते त्वामभिवीक्षमाणः।\nपादौ च ते नासिकयोपजिघ्रते\nश्रेयो ममाध्याहि नमश्च तेऽस्तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2094927, "chapter_id": 3029, "verse_number": "१३-१५९-५९x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2094928, "chapter_id": 3029, "verse_number": "१३-१५९-५९", "content_sanskrit": "शिवं सदैवेह सुरेन्द्र तुभ्यं\nध्यायामि पूजां च सदा प्रयुञ्जे।\nममापि त्वं शक्र शिवं ददस्व\nत्वया दत्तं प्रतिगृह्णामि नागम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2094929, "chapter_id": 3029, "verse_number": "१३-१५९-६०x", "content_sanskrit": "शतक्रतुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2094930, "chapter_id": 3029, "verse_number": "१३-१५९-६०", "content_sanskrit": "येषां वेदा निहिता वै गुहायां\nमनीषिणां सत्यवतां महात्मनाम्।\nतेषां त्वयैकेन महात्मनाऽस्मि\nबुद्धस्तस्मात्प्रीतिमांस्तेऽहतद्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2094931, "chapter_id": 3029, "verse_number": "१३-१५९-६१", "content_sanskrit": "हन्तैहि ब्राह्मणि क्षिप्रं सह पुत्रेण हस्तिना।\nत्वं हि प्राप्तुं शुभाँल्लोकानह्नाय च चिराय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2094932, "chapter_id": 3029, "verse_number": "१३-१५९-६२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2094933, "chapter_id": 3029, "verse_number": "१३-१५९-६२", "content_sanskrit": "स गौतमं पुरुस्कृत्य सह पुत्रेण हस्तिना।\nदिवमाचक्रमे वज्री सद्भिः सह दुरासदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2094934, "chapter_id": 3029, "verse_number": "१३-१५९-६३", "content_sanskrit": "इदं यः शृणुयान्नित्यं यः पठेद्वा जितेन्द्रियः।\nस याति ब्रह्मणो लोकं ब्राह्मणो गौतमो यथा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2094935, "chapter_id": 3029, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनषष्ट्यधिकशततमोऽध्यायः॥ १५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}]