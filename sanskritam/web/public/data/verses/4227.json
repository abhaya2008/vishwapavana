[{"id": 2149046, "chapter_id": 4227, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149047, "chapter_id": 4227, "verse_number": "१", "content_sanskrit": "हिरण्वत्यां निविष्टेषु पाण्डवेषु महात्मसु\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149048, "chapter_id": 4227, "verse_number": "२", "content_sanskrit": "न्यविशन्त महाराज कौरवेया यथाविधि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149049, "chapter_id": 4227, "verse_number": "३", "content_sanskrit": "तत्र दुर्योधनो राजा निवेश्य बलमोजसा ।\nसम्मानयित्वा नृपतीन् न्यस्य गुल्मांस्तथैव च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149050, "chapter_id": 4227, "verse_number": "४", "content_sanskrit": "आरक्षस्य विधिं कृत्वा योधानां तत्र भारत ।\nकर्णं दुःशासनं चैव शकुनिं चापि सौबलम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149051, "chapter_id": 4227, "verse_number": "५", "content_sanskrit": "आनाय्य नृपतींस्तत्र मन्त्रयामास भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149052, "chapter_id": 4227, "verse_number": "६", "content_sanskrit": "दुर्योधनो महाराज कर्णेन सह भारत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149053, "chapter_id": 4227, "verse_number": "७", "content_sanskrit": "सम्भाषित्वा च कर्णेन भ्रात्रा दुःशासनेन च ।\nसौबलेन च राजेन्द्र मन्त्रयित्वा नरर्षभ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149054, "chapter_id": 4227, "verse_number": "८", "content_sanskrit": "आहूयोपह्वरे राजन्नुलूकमिदमब्रवीत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149055, "chapter_id": 4227, "verse_number": "९", "content_sanskrit": "उलूक गच्छ कैतव्य पाण्डवान् सहसोमकान् ।\nगत्वा मम वचो ब्रूहि वासुदेवस्य शृण्वतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149056, "chapter_id": 4227, "verse_number": "१०", "content_sanskrit": "इदं तत् समनुप्राप्तं वर्षपूगाभिचिन्तितम् ।\nपाण्डवानां कुरूणां च युद्धं लोकभयङ्करम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149057, "chapter_id": 4227, "verse_number": "११", "content_sanskrit": "यदेतत् कथ्यते वाक्यं सञ्जयो मां यदब्रवीत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149058, "chapter_id": 4227, "verse_number": "१२", "content_sanskrit": "मध्ये कुरूणां कौन्तेय तस्य कालः समागतः ।\nयथा वः सम्प्रतिज्ञातं तत् सर्वं क्रियतामिति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149059, "chapter_id": 4227, "verse_number": "१३", "content_sanskrit": "ज्येष्ठं तथैव कौन्तेयं ब्रूयास्त्वं वचनान्मम ।\nभ्रातृभिः सहितं सर्वैः सोमकैश्च सकेकयैः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149060, "chapter_id": 4227, "verse_number": "१४", "content_sanskrit": "कथं वा धार्मिको भूत्वा त्वमधर्मे मनः कृथाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149061, "chapter_id": 4227, "verse_number": "१५", "content_sanskrit": "यदिच्छसि जगत्सर्वं नश्यमानं नृशंसवत् ।\nअभयं सर्वभूतेभ्यो दाता त्वमिति मे मतिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149062, "chapter_id": 4227, "verse_number": "१६", "content_sanskrit": "श्रूयते हि पुरा गीतः श्लोकोऽयं भरतर्षभ ।\nप्रह्लादेनाथ भद्रं ते हृते राज्ये तु दैवतैः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149063, "chapter_id": 4227, "verse_number": "१७", "content_sanskrit": "यस्य धर्मध्वजो नित्यं सुरध्वज इवोच्छ्रितः ।\nप्रच्छन्नानि च पापानि बैडालं नाम तद् व्रतम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149064, "chapter_id": 4227, "verse_number": "१८", "content_sanskrit": "अत्र ते वर्तयिष्यामि आख्यानमिदमुत्तमम् ।\nकथितं नारदेनेह पितुर्मम नराधिप\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149065, "chapter_id": 4227, "verse_number": "१९", "content_sanskrit": "मार्जारः किल दुष्टात्मा निश्चेष्टः सर्वकर्मसु ।\nऊर्ध्वबाहुः स्थितो राजन् गङ्गातीरे कदाचन\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149066, "chapter_id": 4227, "verse_number": "२०", "content_sanskrit": "स वै कृत्वा मनःशुद्धिं प्रत्ययार्थं शरीरिणाम् ।\nकरोमि धर्ममित्याह सर्वानेव शरीरिणः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149067, "chapter_id": 4227, "verse_number": "२१", "content_sanskrit": "तस्य कालेन महता विस्रम्भं जग्मुरण्डजाः ।\nसमेत्य च प्रशंसन्ति मार्जारं तं विशाम्पते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149068, "chapter_id": 4227, "verse_number": "२२", "content_sanskrit": "पूज्यमानस्तु तैः सर्वैः पक्षिभिः पक्षिभोजनः ।\nआत्मकार्यं कृतं मेने चर्यायाश्च कृतं फलम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149069, "chapter_id": 4227, "verse_number": "२३", "content_sanskrit": "अथ दीर्घस्य कालस्य तं देशं मूषिका ययुः ।\nददृशुस्तं च ते तत्र धार्मिकं व्रतचारिणम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149070, "chapter_id": 4227, "verse_number": "२४", "content_sanskrit": "कार्येण महता युक्तं डम्भयुक्तेन भारत ।\nतेषां मतिरियं राजन्नासीत् तत्र विनिश्चये\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149071, "chapter_id": 4227, "verse_number": "२५", "content_sanskrit": "बह्वमित्रा वयं सर्वे तेषां नो मातुलो ह्ययम् ।\nरक्षां करोतु सततं वृद्धबालस्य सर्वतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149072, "chapter_id": 4227, "verse_number": "२६", "content_sanskrit": "उपगम्य तु ते सर्वे बिडालमिदमब्रुवन्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149073, "chapter_id": 4227, "verse_number": "२७", "content_sanskrit": "भवत्प्रसादादिच्छामः चर्तुं चैव यथासुखम् ।\nभवान् नो गतिरव्यग्रा भवान् नः परमः सुहृत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149074, "chapter_id": 4227, "verse_number": "२८", "content_sanskrit": "ते वयं सहिताः सर्वे भवन्तं शरणं गताः ।\nभवान् धर्मपरो नित्यं भवान् धर्मे व्यवस्थितः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149075, "chapter_id": 4227, "verse_number": "२९", "content_sanskrit": "तद् रक्ष नो महाप्राज्ञ त्रिदशानिव वज्रभृत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149076, "chapter_id": 4227, "verse_number": "३०", "content_sanskrit": "एवमुक्तस्तु तैः सर्वैर्मूषिकैः स विशाम्पते ।\nप्रत्युवाच ततः सर्वान् मूषिकान् मूषिकान्तकृत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149077, "chapter_id": 4227, "verse_number": "३१", "content_sanskrit": "द्वयोर्योगं न पश्यामि तपसो रक्षणस्य च ।\nअवश्यं तु मया कार्यं वचनं भवतां हितम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2149078, "chapter_id": 4227, "verse_number": "३२", "content_sanskrit": "युष्माभिरपि कर्तव्यं वचनं मम नित्यशः ।\nतपसाऽस्मि परिश्रान्तो दृढं नियममास्थितः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2149079, "chapter_id": 4227, "verse_number": "३३", "content_sanskrit": "न चापि गमने शक्तिं काञ्चित् पश्यामि चिन्तयन् ।\nसोऽस्मि नेयः सदा त्राता नदीकूलमितः सुखम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2149080, "chapter_id": 4227, "verse_number": "३४", "content_sanskrit": "तथेति तत् प्रतिज्ञाय मूषिका भरतर्षभ ।\nवृद्धबालमथो सर्वे मार्जाराय न्यवेदयन्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2149081, "chapter_id": 4227, "verse_number": "३५", "content_sanskrit": "ततः स पापो दुष्टात्मा मूषिकानथ भक्षयन् ।\nपीवरश्च सुवर्णश्च दृढबन्धो व्यजायत\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2149082, "chapter_id": 4227, "verse_number": "३६", "content_sanskrit": "मूषिकाणां गणश्चात्र भृशं सङ्क्षीयतेऽथ सः ।\nमार्जारो वर्धते चापि तेजोबलसमन्वितः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2149083, "chapter_id": 4227, "verse_number": "३७", "content_sanskrit": "ततस्ते मूषिकाः सर्वे समेत्यान्योन्यमब्रुवन् ।\nमातुलो वर्धते नित्यं वयं क्षीयामहे भृशम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2149084, "chapter_id": 4227, "verse_number": "३८", "content_sanskrit": "तत्र प्राज्ञतमः कश्चित् डिण्डिको नाम मूषिकः ।\nअब्रवीद् वचनं राजन् मूषिकाणां महागणम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2149085, "chapter_id": 4227, "verse_number": "३९", "content_sanskrit": "गच्छतां वो नदीतीरं सहितानां विशेषतः ।\nपृष्ठतोऽहं गमिष्यामि मातुलेन सहैव तु\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2149086, "chapter_id": 4227, "verse_number": "४०", "content_sanskrit": "साधु साध्विति ते सर्वे पूजयाञ्चक्रिरे तदा ।\nचक्रुश्चैव यथान्यायं डिण्डिकस्य वचोऽर्थवत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2149087, "chapter_id": 4227, "verse_number": "४१", "content_sanskrit": "अविज्ञानात् ततः सोऽथ डिण्डिकं ह्युपभुक्तवान् ।\nततस्ते सहिताः सर्वे मन्त्रयामासुरञ्जसा\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2149088, "chapter_id": 4227, "verse_number": "४२", "content_sanskrit": "तत्र वृद्धतमः कश्चित् कोलिको नाम मूषिकः ।\nअब्रवीद् वचनं राजन् ज्ञातिमध्ये यथातथम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2149089, "chapter_id": 4227, "verse_number": "४३", "content_sanskrit": "न मातुलो धर्मकामः छद्ममात्रं कृता शिखा ।\nन मूलफलभक्षस्य विष्टा भवति लोमशा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2149090, "chapter_id": 4227, "verse_number": "४४", "content_sanskrit": "अस्य गात्राणि वर्धन्ते गणश्च परिहीयते ।\nअद्य सप्ताष्टदिवसात् डिण्डिकोऽपि न दृश्यते\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2149091, "chapter_id": 4227, "verse_number": "४५", "content_sanskrit": "एतच्छ्रुत्वा वचः सर्वे मूषिका विप्रदुद्रुवुः ।\nबिडालोऽपि स दुष्टात्मा जगामैव यथागतम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2149092, "chapter_id": 4227, "verse_number": "४६", "content_sanskrit": "तथा त्वमपि दुष्टात्मन् बैडालव्रतमास्थितः ।\nचरसि ज्ञातिषु सदा बिडालो मूषिकेष्विव\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2149093, "chapter_id": 4227, "verse_number": "४७", "content_sanskrit": "अन्यथा किल ते वाक्यमन्यथा कर्म दृश्यते ।\nडम्भनार्थाय लोकस्य वेदाश्चोपशमश्च ते\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2149094, "chapter_id": 4227, "verse_number": "४८", "content_sanskrit": "त्यक्त्वा च्छद्म त्विदं राजन् क्षत्रधर्मं समास्थितः ।\nकुरु कार्याणि सर्वाणि धर्मिष्ठोऽसि नरर्षभ\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2149095, "chapter_id": 4227, "verse_number": "४९", "content_sanskrit": "बाहुवीर्येण पृथिवीं लब्ध्वा भरतसत्तम ।\nदेहि दानं द्विजातिभ्यः पितृभ्यश्च यथोचितम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2149096, "chapter_id": 4227, "verse_number": "५०", "content_sanskrit": "क्लिष्टाया वर्षपूगांश्च मातुर्मातृहिते स्थितः ।\nप्रमृज्याश्रु रणे जित्वा सम्मानं परमावह\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2149097, "chapter_id": 4227, "verse_number": "५१", "content_sanskrit": "पञ्च ग्रामा वृता यत्नान्नास्माभिरपवर्जिताः ।\nयुध्यामहे कथं सङ्खे कोपयेम च पाण्डवान्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2149098, "chapter_id": 4227, "verse_number": "५२", "content_sanskrit": "त्वत्कृते दुष्टभावस्य सन्त्यागो विदुरस्य च ।\nजातुषे च गृहे दाहं स्मर तं पुरुषो भव\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2149099, "chapter_id": 4227, "verse_number": "५३", "content_sanskrit": "यच्च कृष्णमवोचस्त्वमायान्तं कुरुसंसदि ।\nअयमस्मि स्थितो राजन् शमाय समराय च\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2149100, "chapter_id": 4227, "verse_number": "५४", "content_sanskrit": "तस्यायमागतः कालः समरस्य नराधिप\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2149101, "chapter_id": 4227, "verse_number": "५५", "content_sanskrit": "एतदर्थं मया सार्धं कृतमेतद् युधिष्ठिर ।\nकिं नु युद्धात् परं लाभं क्षत्रियो बहु मन्यते\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2149102, "chapter_id": 4227, "verse_number": "५६", "content_sanskrit": "किञ्च त्वं क्षत्रियकुले जातः सम्प्रथितो भुवि ।\nद्रोणादस्त्राणि सम्प्राप्य कृपाच्च भरतर्षभ\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2149103, "chapter_id": 4227, "verse_number": "५७", "content_sanskrit": "तुल्ययोनौ समबले वासुदेवं समाश्रितः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2149104, "chapter_id": 4227, "verse_number": "५८", "content_sanskrit": "ब्रूयास्त्वं वासुदेवं च पाण्डवानां समीपतः ।\nआत्मार्थे पाण्डवार्थं च यत्तो मां प्रतियोधय\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2149105, "chapter_id": 4227, "verse_number": "५९", "content_sanskrit": "सभामध्ये च यद्रूपं मायया कृतवानसि ।\nतत् तथैव पुनः कृत्वा सार्जुनो मामभिद्रव\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2149106, "chapter_id": 4227, "verse_number": "६०", "content_sanskrit": "इन्द्रजालं न माया वै कुहका वा विभीषणा ।\nआत्तशस्त्रस्य सङ्ग्रामे वहन्ति प्रतिगर्जनाः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2149107, "chapter_id": 4227, "verse_number": "६१", "content_sanskrit": "वयमप्युत्सहेम द्यां खं च गच्छेम मायया ।\nरसातळं विशामोऽपि ऐन्द्रं वा पुरमेव तु\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2149108, "chapter_id": 4227, "verse_number": "६२", "content_sanskrit": "दर्शयेम च रूपाणि स्वशरीरे बहून्यपि ।\nन तु पर्यायतः सिद्धिर्बुद्धिमाप्नोति मानुषीम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2149109, "chapter_id": 4227, "verse_number": "६३", "content_sanskrit": "मनसैव हि भूतानि धातैव कुरुते वशे\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2149110, "chapter_id": 4227, "verse_number": "६४", "content_sanskrit": "यदर्थं क्षत्रिया सूते सर्वं तदिदमागतम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2149111, "chapter_id": 4227, "verse_number": "६५", "content_sanskrit": "बलं वीर्यं च शौर्यं च परं चाप्यस्त्रलाघवम् ।\nपौरुषं दर्शयन् युद्धे कोपस्य कुरु निष्कृतिम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2149112, "chapter_id": 4227, "verse_number": "६६", "content_sanskrit": "यद् ब्रवीषि च वार्ष्णेय धार्तराष्ट्रानहं रणे ।\nघातयित्वा प्रदास्यामि पार्थेभ्यो राज्यमुत्तमम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2149113, "chapter_id": 4227, "verse_number": "६७", "content_sanskrit": "आचचक्षे च मे सर्वं सञ्जयस्तव भाषितम् ।\nमद्द्वितीयेन पार्थेन कौरव्यो द्वेष्यते ध्रुवम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2149114, "chapter_id": 4227, "verse_number": "६८", "content_sanskrit": "स सत्यसङ्गरो भूत्वा पाण्डवार्थे पराक्रमी ।\nयुध्यस्वाद्य रणे यत्तः पश्यामः पुरुषो भव\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2149115, "chapter_id": 4227, "verse_number": "६९", "content_sanskrit": "यस्तु शत्रुमभिज्ञाय शुद्धं पौरुषमाश्रितः ।\nकरोति द्विषतां शोकं स जीवति सुजीवितम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2149116, "chapter_id": 4227, "verse_number": "७०", "content_sanskrit": "अकस्माच्चैव ते कृष्ण ख्यातं लोके महद्यशः ।\nअद्येदानीं विजानीमः सन्ति षण्डाः सशृङ्गकाः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2149117, "chapter_id": 4227, "verse_number": "७१", "content_sanskrit": "मद्विधो नापि नृपतिः त्वयि युक्तः कथञ्चन ।\nसन्नाहं संयुगे कर्तुं कंसभृत्ये विशेषतः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2149118, "chapter_id": 4227, "verse_number": "७२", "content_sanskrit": "त्वं च तूबरकं बालं बह्वाशिनमविद्यकम् ।\nउलूक मद्वचो ब्रूहि असकृद् भीमसेनकम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2149119, "chapter_id": 4227, "verse_number": "७३", "content_sanskrit": "विराटनगरे पार्थ त्वं सूदो ह्यभवः पुरा ।\nवललो नाम विख्यातः तन्ममैव हि पौरुषम्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2149120, "chapter_id": 4227, "verse_number": "७४", "content_sanskrit": "प्रतिज्ञातं सभामध्ये न तन्मिथ्या त्वया पुरा\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2149121, "chapter_id": 4227, "verse_number": "७५", "content_sanskrit": "अशक्तेनैव यच्चोक्तं सभामध्ये वृकोदर\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2149122, "chapter_id": 4227, "verse_number": "७६", "content_sanskrit": "दुःशासनस्य रुधिरं पीयतां यदि शक्यते\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2149123, "chapter_id": 4227, "verse_number": "७७", "content_sanskrit": "यदर्थं क्षत्रिया सूते सर्वं तदिदमागतम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2149124, "chapter_id": 4227, "verse_number": "७८", "content_sanskrit": "बलं वीर्यं च शौर्यं च परं चाप्यस्त्रलाघवम् ।\nपौरुषं दर्शयन् युद्धे कोपस्य कुरु निष्कृतिम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2149125, "chapter_id": 4227, "verse_number": "७९", "content_sanskrit": "यद् ब्रवीषि च कौन्तेय धार्तराष्ट्रानहं रणे ।\nनिहनिष्यामि तरसा तस्य कालोऽयमागतः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2149126, "chapter_id": 4227, "verse_number": "८०", "content_sanskrit": "त्वं हि भोज्ये पुरस्कार्यो भक्ष्ये पेये च भारत ।\nक्व युद्धं क्व च भोक्तव्यं युध्यस्व पुरुषो भव\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2149127, "chapter_id": 4227, "verse_number": "८१", "content_sanskrit": "शयिष्यसे हतो भूमौ गदामालिङ्ग्य भारत ।\nतत् तथा च सभामध्ये वल्गितं ते वृकोदर\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2149128, "chapter_id": 4227, "verse_number": "८२", "content_sanskrit": "उलूक नकुलं ब्रूहि वचनान्मम भारतम् ।\nयुध्यस्वाद्य स्थिरो भूत्वा पश्यामस्तव पौरुषम्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2149129, "chapter_id": 4227, "verse_number": "८३", "content_sanskrit": "युधिष्ठिरानुरागं च द्वेषं च मयि भारत ।\nकृष्णायाश्च परिक्लेशं स्मरेदानीं यथातथम्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2149130, "chapter_id": 4227, "verse_number": "८४", "content_sanskrit": "विराटद्रुपदौ चोभौ ब्रूयास्त्वं वचनान्मम\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2149131, "chapter_id": 4227, "verse_number": "८५", "content_sanskrit": "न दृष्टपूर्वा भर्तारो भृत्यैरपि महागुणैः ।\nतथाऽर्थपतिभिर्भृत्या यतः सृष्टाः प्रजास्ततः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2149132, "chapter_id": 4227, "verse_number": "८६", "content_sanskrit": "अश्लाघ्योऽयं नरपतिः युवयोरिति चागतम्\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2149133, "chapter_id": 4227, "verse_number": "८७", "content_sanskrit": "ते यूयं सहिता भूत्वा तद् वधार्थं ममापि च ।\nआत्मार्थं पाण्डवार्थं च प्रयुध्यध्वं मया सह\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2149134, "chapter_id": 4227, "verse_number": "८८", "content_sanskrit": "धृष्टद्युम्नं च पाञ्चाल्यं ब्रूयास्त्वं वचनान्मम ।\nएष ते समयो लब्धो लब्धव्यश्च त्वयाऽपि सः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2149135, "chapter_id": 4227, "verse_number": "८९", "content_sanskrit": "द्रोणमासाद्य समरे ज्ञास्यसे हितमुत्तमम् ।\nयुध्यस्व ससुहृद्वर्गः कुरु कर्म सुदुष्करम्\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2149136, "chapter_id": 4227, "verse_number": "९०", "content_sanskrit": "शिखण्डिनमथो ब्रूहि उलूक वचनान्मम ।\nस्त्रीति मत्वा महाबाहुर्न हनिष्यति कौरवः\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2149137, "chapter_id": 4227, "verse_number": "९१", "content_sanskrit": "गाङ्गेयं युद्ध्यतां श्रेष्ठं युध्यस्वेह सुनिर्भयः ।\nकुरु कर्म रणे यत्तः पश्यामः पौरुषं तव\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2149138, "chapter_id": 4227, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2149139, "chapter_id": 4227, "verse_number": "९२", "content_sanskrit": "एवमुक्त्वा ततो राजा प्रहस्योलूकमब्रवीत्\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2149140, "chapter_id": 4227, "verse_number": "९३", "content_sanskrit": "धनञ्जयं पुनर्ब्रूहि वासुदेवस्य शृण्वतः\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2149141, "chapter_id": 4227, "verse_number": "९४", "content_sanskrit": "अस्मान् वाऽपि पराजित्य प्रशाधि पृथिवीमिमाम् ।\nअथवा निर्जितोऽस्माभी रणे वीर शयिष्यसि\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2149142, "chapter_id": 4227, "verse_number": "९५", "content_sanskrit": "अमर्षं राज्यहरणं वनवासं च पाण्डव ।\nकृष्णायाश्च परिक्लेशं संस्मरन् पुरुषो भव\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2149143, "chapter_id": 4227, "verse_number": "९६", "content_sanskrit": "परिक्लिष्टस्य दीनस्य दीर्घकालोषितस्य च ।\nहृदयं न स्फुटेत् कस्य ऐश्वर्याद् भ्रंशितस्य च\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2149144, "chapter_id": 4227, "verse_number": "९७", "content_sanskrit": "कुले जातस्य शूरस्य परवित्तेषु गृध्यतः ।\nअच्छिन्नं राज्यमाक्रम्य कोपं कस्य न दीपयेत्\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2149145, "chapter_id": 4227, "verse_number": "९८", "content_sanskrit": "यत्तदुक्तं महद्वाक्यं कर्मणा तद् विधीयताम् ।\nअकर्मणा कत्थितेन सन्तः कुपुरुषं विदुः\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2149146, "chapter_id": 4227, "verse_number": "९९", "content_sanskrit": "अमित्राणां वशे स्थानं राज्यं च पुनरुद्धर ।\nद्वावर्थौ युद्धकामस्य तस्मात् कुरुत पौरुषम्\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2149147, "chapter_id": 4227, "verse_number": "१००", "content_sanskrit": "अस्मान् वा त्वमथो जित्वा प्रशाधि पृथिवीमिमाम् ।\nअथवा निहतोऽस्माभिर्देवलोकं गमिष्यसि\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2149148, "chapter_id": 4227, "verse_number": "१०१", "content_sanskrit": "पराजितोऽसि द्यूतेन कृष्णा चानायिता सभाम् ।\nशक्योऽमर्षो मनुष्येण कर्तुं पुरुषमानिना\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2149149, "chapter_id": 4227, "verse_number": "१०२", "content_sanskrit": "द्वादशैव तु वर्षाणि वने धिष्ण्याद् विवासितः ।\nसंवत्सरं विराटस्य दास्यमास्थाय चोषितः\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2149150, "chapter_id": 4227, "verse_number": "१०३", "content_sanskrit": "अप्रियाणां तु वचने संस्मरंश्च पुनः पुनः ।\nअमर्षं दर्शयस्व त्वममर्षो ह्येव पौरुषम्\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2149151, "chapter_id": 4227, "verse_number": "१०४", "content_sanskrit": "क्रोधो बलं तथा वीर्यं ज्ञानयोगोऽस्त्रलाघवम् ।\nइह ते दर्श्यतां पार्थ युध्यस्व पुरुषो भव\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2149152, "chapter_id": 4227, "verse_number": "१०५", "content_sanskrit": "इत्युक्तो धार्तराष्ट्रेण उलूको दुष्टचेतनः ।\nअभिनिर्याय नगरात् पाण्डवान् प्रति सोऽभ्यगात्\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2149153, "chapter_id": 4227, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि अष्टपञ्चाशोत्तरशततमोऽध्यायः ॥१५८॥\nउलूकदूतागमनपर्वणि प्रथमोऽध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}]