[{"id": 2067333, "chapter_id": 2416, "verse_number": "९-१६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2067334, "chapter_id": 2416, "verse_number": "९-१६-१", "content_sanskrit": "xxxxxxxxxxxसुसंवृत्ते सुदारुणे।\nxxxxxxxxxxx पाण्डवेषु महात्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2067335, "chapter_id": 2416, "verse_number": "९-१६-२", "content_sanskrit": "ततस्तालध्वजके रामस्तयोर्युद्ध उपस्थिते।\nश्रुत्वा तच्छिष्ययो राजन्नाजगाम हलायुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2067336, "chapter_id": 2416, "verse_number": "९-१६-३", "content_sanskrit": "तं दृष्ट्वा परमप्रीताः पाण्डवाः सहकेशवाः।\nउपगम्योपसङ्गृह्य विधिवत्प्रत्यपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2067337, "chapter_id": 2416, "verse_number": "९-१६-४", "content_sanskrit": "पूजयित्वा ततः पश्चादिदं वचनमब्रुवन्।\nशिष्ययोः कौशलं युद्धे पश्य रामेति पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2067338, "chapter_id": 2416, "verse_number": "९-१६-५", "content_sanskrit": "अब्रवीच्च तदा रामो दृष्ट्वा कृष्णं सपाण्डवम्।\nदुर्योधनं च कौरव्यं गदापाणिमवस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2067339, "chapter_id": 2416, "verse_number": "९-१६-६x", "content_sanskrit": "राम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2067340, "chapter_id": 2416, "verse_number": "९-१६-६", "content_sanskrit": "चत्वारिंशदहान्यद्य द्वे च मे निःसृतस्य वै।\nपुष्येण सम्प्रयातोऽस्मि श्रवणे पुनरागतः।\nशिष्ययोर्वै गदायुद्धं द्रुष्टुकामोऽस्मि माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2067341, "chapter_id": 2416, "verse_number": "९-१६-७", "content_sanskrit": "ततो युधिष्ठिरो राजा परिष्वज्य हलायुधम्।\nस्वागतं कुशलं चास्मै पर्यपृच्छद्यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2067342, "chapter_id": 2416, "verse_number": "९-१६-८", "content_sanskrit": "कृष्णौ चापि महेष्वासावभिवाद्य हलायुधम्।\nसस्वजाते परिप्रीतौ प्रीयमाणौ यशस्विनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2067343, "chapter_id": 2416, "verse_number": "९-१६-९", "content_sanskrit": "माद्रीपुत्रौ तथा शूरौ द्रौपद्याः पञ्च चात्मजाः।\nअभिवाद्य स्थिता राजन्रौहिणेयं महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2067344, "chapter_id": 2416, "verse_number": "९-१६-१०", "content_sanskrit": "भीमसेनोऽथ बलवान्पुत्रस्तव जनाधिप।\nतथैव चोद्यतगदौ पूजयामासतुर्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2067345, "chapter_id": 2416, "verse_number": "९-१६-११", "content_sanskrit": "स्वागतेन च ते तत्र प्रतिपूज्य पुनःपुनः।\nपश्य युद्धं महाबाहो इति ते राममब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2067346, "chapter_id": 2416, "verse_number": "९-१६-१२", "content_sanskrit": "एवमुचुर्महात्मानं रौहिणेयं नराधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2067347, "chapter_id": 2416, "verse_number": "९-१६-१३", "content_sanskrit": "परिष्वज्य तदा रामः पाण्डवान्सह सृञ्जयान्।\nअपृच्छत्कुशलं सर्वान्पार्थिवांश्चामितौजसः।\nतथैव ते समासाद्य पप्रच्छुस्तमनामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2067348, "chapter_id": 2416, "verse_number": "९-१६-१४", "content_sanskrit": "प्रत्यभ्यर्च्य हली सर्वान्क्षत्रियांश्च महात्मनः।\nकृत्वा कुशलसम्प्रश्नं संविदं च यथावयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2067349, "chapter_id": 2416, "verse_number": "९-१६-१५", "content_sanskrit": "जनार्दनं सात्यकिं च प्रेम्णा सम्परिषस्वजे।\nमूर्ध्नि चैतावुपाघ्राय कुशलं पर्यपृच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2067350, "chapter_id": 2416, "verse_number": "९-१६-१६", "content_sanskrit": "तौ च तं विधिवद्राजन्पूजयामासतुर्गुरुम्।\nब्रह्माणामिव देवेशमिन्द्रोपेन्द्रौ मुदान्वितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2067351, "chapter_id": 2416, "verse_number": "९-१६-१७", "content_sanskrit": "ततोऽब्रवीद्धर्मसुतो रौहिणेयमरिन्दमम्।\nइदं भ्रात्रोर्महायुद्धं पश्य रामेति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2067352, "chapter_id": 2416, "verse_number": "९-१६-१८", "content_sanskrit": "तेषां मध्ये महाबाहुः श्रीमान्केशवपूर्वजः।\nन्यविशत्परमप्रीतः पूज्यमानो महारथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2067353, "chapter_id": 2416, "verse_number": "९-१६-१९", "content_sanskrit": "स बभौ राजमध्यस्थो नीलवासाः सितप्रभः।\nदिवीव नक्षत्रगणैः परिवीतो निशाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2067354, "chapter_id": 2416, "verse_number": "९-१६-२०", "content_sanskrit": "ततस्तयोः सन्निपातस्तुमुलो रोमहर्षणः।\nआसीदन्तकरो राजन्वैरस्यान्तं विधित्सतोः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2067355, "chapter_id": 2416, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवशपर्वणि अष्टादशदिवसयुद्धे चतुस्त्रिंशोऽध्यायः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]