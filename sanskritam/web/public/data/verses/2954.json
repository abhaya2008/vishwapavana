[{"id": 2091825, "chapter_id": 2954, "verse_number": "१३-८४-१", "content_sanskrit": "युधिष्ठिर उवाच।\nब्रूहि तात कुरुश्रेष्ठ वर्णानां त्वं पृथक् पृथक्।\nकीदृश्यां कीदृशाश्चापि पुत्राः कस्य च के च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091826, "chapter_id": 2954, "verse_number": "१३-८४-२", "content_sanskrit": "विप्रवादाः सुबहवः श्रूयन्ते पुत्रकारिणाम्।\nअत्र नो मुह्यतां राजन्संशयं छेत्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091827, "chapter_id": 2954, "verse_number": "१३-८४-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091828, "chapter_id": 2954, "verse_number": "१३-८४-३", "content_sanskrit": "`आत्मा पुत्रस्तु विज्ञेयः प्रथमो बहुधा परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091829, "chapter_id": 2954, "verse_number": "१३-८४-४", "content_sanskrit": "स्वे क्षेत्रे संस्कृते यस्तु पुत्रमुत्पादयेत्स्वयम्।\nतमौरसं विजानीयात्पुत्रं प्रथमकल्पितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091830, "chapter_id": 2954, "verse_number": "१३-८४-५", "content_sanskrit": "अग्निं प्रजापतिं चेष्ट्वा वराय प्रतिपादिता।\nपुत्रिका स्याद्दुहितरि सङ्कल्पे वाऽपि वा सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091831, "chapter_id": 2954, "verse_number": "१३-८४-६", "content_sanskrit": "तल्पे जातः प्रमीतस्य क्लीबस्य पतितस्य वा।\nस्वधर्मेण नियुक्तो यः स पुत्रः क्षेत्रजः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091832, "chapter_id": 2954, "verse_number": "१३-८४-७", "content_sanskrit": "माता पिता च दद्यातां यमद्भिः पुत्रमापदि।\nसदृशप्रीतिसंयुक्तो विज्ञेयो दत्रिमः सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091833, "chapter_id": 2954, "verse_number": "१३-८४-८", "content_sanskrit": "सदृशं तु प्रकुर्याद्यं गुणदोषविचक्षणम्।\nपुत्रं पुत्रगुणैर्युक्तं विज्ञेयः स तु कृत्रिमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091834, "chapter_id": 2954, "verse_number": "१३-८४-९", "content_sanskrit": "उत्पद्यते यस्य गूढं न च ज्ञायेत कस्यचित्।\nस भवेद्गूढजो नाम तस्य स्याद्यस्य तल्पतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091835, "chapter_id": 2954, "verse_number": "१३-८४-१०", "content_sanskrit": "मातापितृभ्यामुत्सृष्टस्तयोरन्यतरेण वा।\nयं पुत्रं प्रतिगृह्णीयादपविद्धः स उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091836, "chapter_id": 2954, "verse_number": "१३-८४-११", "content_sanskrit": "पितृवेश्मनि कन्या तु यं पुत्रं जनयेद्रहः।\nतं कानीनं वदन्नाम्ना वोढुः कन्यासमुद्भवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091837, "chapter_id": 2954, "verse_number": "१३-८४-१२", "content_sanskrit": "या गर्भिणी संस्क्रियते ज्ञाताऽज्ञातापि वा सती।\nवोढुः स गर्भो भवति सहोढ इति उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091838, "chapter_id": 2954, "verse_number": "१३-८४-१३", "content_sanskrit": "क्रीणीयाद्यस्त्वपर्यार्थं मातापित्रोर्यमन्तिकात्।\nस क्रीतकः सुतस्तस्य सदृशोऽसदृशोपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091839, "chapter_id": 2954, "verse_number": "१३-८४-१४", "content_sanskrit": "या पत्या वा परित्यक्ता विधवा वा स्वकेच्छया।\nउत्पादयति पुनर्भूत्वा स पौनर्भव उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091840, "chapter_id": 2954, "verse_number": "१३-८४-१५", "content_sanskrit": "सा चेदक्षतयोनिः स्याद्गतप्रत्याङ्गताऽपि वा।\nपौनर्भवेन भर्त्रा सा पुनसंस्कारमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091841, "chapter_id": 2954, "verse_number": "१३-८४-१६", "content_sanskrit": "मातापितृहनो यः स्यात्त्यक्तो वा स्यादकारणम्।\nआत्मानं स्पर्शयेद्यस्तु स्वयंदत्तस्तु स स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091842, "chapter_id": 2954, "verse_number": "१३-८४-१७", "content_sanskrit": "यं ब्राह्मणस्तु शूद्रायां कामादुत्पादयेत्सुतम्।\nस पावयन्नेव शवस्तस्मात्पारशवः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091843, "chapter_id": 2954, "verse_number": "१३-८४-१८", "content_sanskrit": "दास्यां वा दासदास्यां वा यः शूद्रस्य सुतो भवेत्।\nसोऽनुज्ञातो हरेदंशमिति धर्मो व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091844, "chapter_id": 2954, "verse_number": "१३-८४-१९", "content_sanskrit": "क्षेत्रजादीन्सुतानेतानेकादश यथोदितान्।\nपुत्रप्रतिनिधीनाहुः क्रियालोपान्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091845, "chapter_id": 2954, "verse_number": "१३-८४-२०", "content_sanskrit": "प्रातॄणामेकजातानामेकश्चेत्पुत्रवान्भवेत्।\nसर्वांस्तांस्तेन पुत्रेण पुत्रिणो मनुरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091846, "chapter_id": 2954, "verse_number": "१३-८४-२१", "content_sanskrit": "सर्वासामेकपत्नीनामेका चेत्पुत्रिणी भवेत्।\nसर्वास्तास्तेन पुत्रेण प्राह पुत्रवतीर्मनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091847, "chapter_id": 2954, "verse_number": "१३-८४-२२", "content_sanskrit": "आत्मा पुत्रश्च विज्ञेयस्तस्यानन्तरजश्च यः।\nनिरुक्तजश्च विज्ञेयः सुतः प्रसृतजस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2091848, "chapter_id": 2954, "verse_number": "१३-८४-२३", "content_sanskrit": "पतितस्य तु भार्याया भर्त्रा सुसमवेतया।\nतथा दत्तकृतौ पुत्रावध्यूढश्च तथाऽपरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2091849, "chapter_id": 2954, "verse_number": "१३-८४-२४", "content_sanskrit": "षडपध्वंसजाश्चापि कानीनापसदास्तथा।\nइत्येते वै समाख्यातास्तान्विजानीहि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2091850, "chapter_id": 2954, "verse_number": "१३-८४-२५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2091851, "chapter_id": 2954, "verse_number": "१३-८४-२५", "content_sanskrit": "षडपध्वंसजाः के स्युः के वाऽप्यपसदास्तथा।\nएतत्सर्वं यथातत्त्वं व्याख्यातुं मे त्वमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2091852, "chapter_id": 2954, "verse_number": "१३-८४-२६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2091853, "chapter_id": 2954, "verse_number": "१३-८४-२६", "content_sanskrit": "त्रिषु वर्णेषु ये पुत्रा ब्राह्मणस्य युधिष्ठिर।\nवर्णयोश्च द्वयोः स्यातां यौ राजन्यस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2091854, "chapter_id": 2954, "verse_number": "१३-८४-२७", "content_sanskrit": "एको द्विवर्ण एवाथ तथाऽत्रैवोपलक्षितः।\nषडपध्वंसजास्ते हि तथैवापसदाञ्शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2091855, "chapter_id": 2954, "verse_number": "१३-८४-२८", "content_sanskrit": "चाण्डालो व्रात्यवर्णौ तु ब्राह्मण्यां क्षत्रियासु च।\nवैश्यायां चैव शूद्रस्य लक्ष्यास्तेऽपसदास्त्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2091856, "chapter_id": 2954, "verse_number": "१३-८४-२९", "content_sanskrit": "मागधो वामकश्चैव द्वौ वैश्यस्योपलक्षितौ।\nब्राह्मण्यां क्षत्रियायां च क्षत्रियस्यैक एव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2091857, "chapter_id": 2954, "verse_number": "१३-८४-३०", "content_sanskrit": "ब्राह्मण्यां लक्ष्यते सूत इत्येतेऽपसदाः स्मृताः।\nपुत्रा ह्येते न शक्यन्ते मिथ्या कर्तुं नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2091858, "chapter_id": 2954, "verse_number": "१३-८४-३१x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2091859, "chapter_id": 2954, "verse_number": "१३-८४-३१", "content_sanskrit": "क्षेत्रजं केचिदेवाहुः सुतं केचित्तु शुक्रजम्।\nतुल्यावेतौ सुतौ कस्य तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2091860, "chapter_id": 2954, "verse_number": "१३-८४-३२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2091861, "chapter_id": 2954, "verse_number": "१३-८४-३२", "content_sanskrit": "रेतजो वा भवेत्पुत्रः पुत्रो वा क्षत्रेजो भवेत्।\nअध्यूढः समयं भित्त्वेत्येतदेव निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2091862, "chapter_id": 2954, "verse_number": "१३-८४-३३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2091863, "chapter_id": 2954, "verse_number": "१३-८४-३३", "content_sanskrit": "रेतजं विद्म वै पुत्रं क्षत्रेजस्यागमः कथम्।\nअध्यूढं विद्म वै पुत्रं भित्त्वा तु समयं कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2091864, "chapter_id": 2954, "verse_number": "१३-८४-३४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2091865, "chapter_id": 2954, "verse_number": "१३-८४-३४", "content_sanskrit": "आत्मजं पुत्रमुत्पाद्य यस्त्यजेत्कारणान्तरे।\nन तत्र कारणं रेतः स क्षेत्रस्वामिनो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2091866, "chapter_id": 2954, "verse_number": "१३-८४-३५", "content_sanskrit": "पुत्रकामो हि पुत्रार्थे यां वृणीते विशाम्पते।\nतत्र क्षेत्रं प्रमाणं स्यान्न वै तत्रात्मजः सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2091867, "chapter_id": 2954, "verse_number": "१३-८४-३६", "content_sanskrit": "अन्यत्र क्षेत्रजः पुत्रो लक्ष्यते भरतर्षभ।\nन ह्यात्मा शक्यते हन्तुं दृष्टान्तोपगतो ह्यसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2091868, "chapter_id": 2954, "verse_number": "१३-८४-३७", "content_sanskrit": "क्वचिच्च कुतकः पुत्रः सङ्ग्रहादेव लक्ष्यते।\nन तत्र रेतः क्षेत्रं वा प्रमाणं स्याद्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2091869, "chapter_id": 2954, "verse_number": "१३-८४-३८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2091870, "chapter_id": 2954, "verse_number": "१३-८४-३८", "content_sanskrit": "कीदृशः कृतकः पुत्रः सङ्ग्रहादेव लक्ष्यते।\nशुक्रं क्षेत्रं प्रमाणं वा यत्र लक्ष्यं न भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2091871, "chapter_id": 2954, "verse_number": "१३-८४-३९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2091872, "chapter_id": 2954, "verse_number": "१३-८४-३९", "content_sanskrit": "मातापितृभ्यां यस्त्यक्तः पथि यस्तं प्रकल्पयेत्।\nन चास्य मातापितरौ ज्ञायेतां स हि कृत्रिमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2091873, "chapter_id": 2954, "verse_number": "१३-८४-४०", "content_sanskrit": "अस्वामिकस्य स्वामित्वं यस्मिन्सम्प्रतिलक्ष्यते।\nयो वर्णः पोषयेत्तं च तद्वर्णस्तस्य जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2091874, "chapter_id": 2954, "verse_number": "१३-८४-४१x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2091875, "chapter_id": 2954, "verse_number": "१३-८४-४१", "content_sanskrit": "कथमस्य प्रयोक्तव्यः संस्कारः कस्य वा कथम्।\nदेया कन्या कथं चेति तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2091876, "chapter_id": 2954, "verse_number": "१३-८४-४२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2091877, "chapter_id": 2954, "verse_number": "१३-८४-४२", "content_sanskrit": "आत्मवत्तस्य कुर्वीत संस्कारं स्वामिवत्तथा।\nत्यक्तो मातापितृभ्यां यः सवर्णं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2091878, "chapter_id": 2954, "verse_number": "१३-८४-४३", "content_sanskrit": "तद्गोत्रबन्धुजं तस्य कुर्यात्संस्कारमच्युत।\nअथ देया तु कन्या स्यात्तद्वर्णस्य युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2091879, "chapter_id": 2954, "verse_number": "१३-८४-४४", "content_sanskrit": "संस्कर्तुं वर्णगोत्रं च मातृवर्णविनिश्चये।\nकानीनाध्यूढजौ वाऽपि विज्ञेयौ पुत्रकिल्बिषौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2091880, "chapter_id": 2954, "verse_number": "१३-८४-४५", "content_sanskrit": "कानीनाध्यूढजौ वाऽपि विज्ञेयौ पुत्रकिल्बिषौ॥\nतावपि स्वाविव सुतौ संस्कार्याविति निश्चयः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2091881, "chapter_id": 2954, "verse_number": "१३-८४-४६", "content_sanskrit": "क्षेत्रजो वाऽप्यपसदो येऽध्यूढास्तेषु चाप्युत॥\nआत्मवद्वै प्रयुञ्जीरन्संस्कारान्ब्राह्मणादयः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2091882, "chapter_id": 2954, "verse_number": "१३-८४-४७", "content_sanskrit": "`स्वं जन्मे मातृगोत्रेण संस्कारं ब्राह्मणादयः॥\nधर्मशास्त्रेषु वर्णानां निश्चयोऽयं पदृश्यते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2091883, "chapter_id": 2954, "verse_number": "१३-८४-४८", "content_sanskrit": "एतत्ते सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2091884, "chapter_id": 2954, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुरशीतितमोऽध्यायः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]