e_number": "16", "content_sanskrit": "एतावदेवशेषंवोजेतव्यमिहवानराः । हतास्सर्वेसमागम्यराक्षसाबलदर्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40018074, "chapter_id": 9278, "verse_number": "17", "content_sanskrit": "अयुक्तंनिधनंकर्तुंपुत्रस्यजनितुर्मम । घृणामपास्यरामार्थेनिहन्यांभ्रातुरात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40018075, "chapter_id": 9278, "verse_number": "18", "content_sanskrit": "हन्तुकामस्यमेबाष्पंचक्षुश्चैवनिरुध्यति । तमेवैषमहाबाहुर्लक्ष्मणश्शमयिष्यति ॥ वानराघ्नतसम्भूयभृत्यानस्यसमीपगान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018076, "chapter_id": 9278, "verse_number": "19", "content_sanskrit": "इतितेनातियशसाराक्षसेनाभिचोदिताः ॥ वानरेन्द्राजहृषिरेलाङ्गूलानि च विव्यधुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018077, "chapter_id": 9278, "verse_number": "20", "content_sanskrit": "ततस्तुकपिशार्दूलाःश्रवेन्तःश्चपुनःपुनः ॥ मुमुचुर्विविधान्नादान्मेघान् दृष्टवेवबर्हिणः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018078, "chapter_id": 9278, "verse_number": "21", "content_sanskrit": "जाम्बवानपितैःसर्वैःसयूथ्यैरभिसम्वृतः ॥ तेऽश्मभिस्ताडयामासुर्नखैर्धन्स्सैश्चराक्षसान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40018079, "chapter_id": 9278, "verse_number": "22", "content_sanskrit": "निघ्नन्तमृक्षाधिपतिंराक्षसास्तेमहाबलाः ॥ परिवव्रुर्भयंत्यक्त्वातमनेकविधायुथाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40018080, "chapter_id": 9278, "verse_number": "23", "content_sanskrit": "शरैःपरशुभिस्तीक्ष्णैःपट्टिशैर्यष्टितोमरैः ॥ जाम्बवन्तंमृधेजघ्नुर्निघ्नन्तंराक्षसींचमूम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40018081, "chapter_id": 9278, "verse_number": "24", "content_sanskrit": "स सम्प्रहारस्तुमुलःसञ्जज्ञेकपिरक्षसाम् ॥ देवासुराणांक्रुद्धानांयथाभीमोमहास्वनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40018082, "chapter_id": 9278, "verse_number": "25", "content_sanskrit": "हनुमानपिसङ्क्रुद्धःसानुमुत्पाट्यपर्वतात् ॥ स लक्ष्मणंस्वयंपृष्ठादवरोप्यमहामनाः । रक्षसांकदनंचक्रेसमासाद्यसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40018083, "chapter_id": 9278, "verse_number": "26", "content_sanskrit": "हनुमानपिसङ्क्रुद्धःसानुमुत्पाट्यपर्वतात् ॥ स लक्ष्मणंस्वयंपृष्ठादवरोप्यमहामनाः । रक्षसांकदनंचक्रेसमासाद्यसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40018084, "chapter_id": 9278, "verse_number": "27", "content_sanskrit": "स दत्त्वातुमुलंयुद्धंपितृव्यस्येन्द्रजत् बली । लक्ष्मणंपरवीरघ्नःपुनरेवाभ्यधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40018085, "chapter_id": 9278, "verse_number": "28", "content_sanskrit": "तौप्रयुद्दौतदावीरौमृधेलक्ष्मणराक्षसौ । शरौघानभिवर्षन्तौजघ्नतुस्तौपरस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40018086, "chapter_id": 9278, "verse_number": "29", "content_sanskrit": "अभीक्षणमन्तर्धदतुश्शरजालैर्महाबलौ । चन्द्रादित्याविवोष्णान्तेयथामेघैस्तरस्विनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40018087, "chapter_id": 9278, "verse_number": "30", "content_sanskrit": "न ह्यादानं न सन्धानंधनुषोवापरिग्रहः । न विप्रमोक्षोबाणानां न विकर्षो न विग्रहः ॥ न मुष्टिप्रतिसन्धानं न लक्ष्यप्रतिपादनम् । अदृश्यततयोस्तत्रयुध्यतोःपाणिलाघवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40018088, "chapter_id": 9278, "verse_number": "31", "content_sanskrit": "न ह्यादानं न सन्धानंधनुषोवापरिग्रहः । न विप्रमोक्षोबाणानां न विकर्षो न विग्रहः ॥ न मुष्टिप्रतिसन्धानं न लक्ष्यप्रतिपादनम् । अदृश्यततयोस्तत्रयुध्यतोःपाणिलाघवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40018089, "chapter_id": 9278, "verse_number": "32", "content_sanskrit": "चापवेगप्रयुक्स्सैश्चबाणजालैःसमन्ततः । अन्तरिकेऽभिसम्पन्ने न रूपाणिचकाशिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40018090, "chapter_id": 9278, "verse_number": "33", "content_sanskrit": "लक्ष्मणोरावणिंप्राप्यरावणिश्चापिलक्ष्मणम् । अव्यवस्थाभवत्युग्राताभ्यामन्योन्यविग्रहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40018091, "chapter_id": 9278, "verse_number": "34", "content_sanskrit": "ताभामुभाभ्यांतरसाप्रसृष्टैर्विशिखैःशितैः । निरन्तरमिवाकाशंबभूवतमसावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40018092, "chapter_id": 9278, "verse_number": "35", "content_sanskrit": "तैःपतभदिश्चबहुभिस्तयोःशरशतैःशितैः । दिशश्चप्रदिशश्चैवबभूवुःशरसङ्कुलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40018093, "chapter_id": 9278, "verse_number": "36", "content_sanskrit": "तमसापिहितंसर्वमासीत्प्रतिभयंमहत् । अस्तंगतेसहस्रांशेसम्वृतेतमसा च वै ॥ रुधिरौघामहानद्यःप्रावर्तन्तसहस्रशः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40018094, "chapter_id": 9278, "verse_number": "37", "content_sanskrit": "क्रव्यादादारुणावाग्भिश्चिक्षिपुर्भीमनिःस्वनान् ॥ न तदानींवनौवायुर्न च जज्वालपावकः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40018095, "chapter_id": 9278, "verse_number": "38", "content_sanskrit": "स्व्स्त्वस्तुलोकेभ्यइतिजजल्पुस्तेमहर्षयः ॥ सम्पेतुश्चात्रसन्तप्तागन्धर्वाःसहचारणैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40018096, "chapter_id": 9278, "verse_number": "39", "content_sanskrit": "अथराक्षससिंहस्यकृष्णान् कनकभूषणान् ॥ शरैश्चतुर्भिःसौमित्रिद्विव्याधचतुरोहयान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40018097, "chapter_id": 9278, "verse_number": "40", "content_sanskrit": "ततोऽपरेणभल्लेनपीतेननिशितेन च ॥ सम्पूर्णायतमुक्तेनसुपत्रेणसुवर्चसा । महेन्द्राशनिकल्पेनसूतस्यविचरिष्यतः ॥ स तेनबाणाशनिनातलशब्दानुवादिना । लाघवाद्राघवःश्रीमान् शिरःकायादपाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40018098, "chapter_id": 9278, "verse_number": "41", "content_sanskrit": "ततोऽपरेणभल्लेनपीतेननिशितेन च ॥ सम्पूर्णायतमुक्तेनसुपत्रेणसुवर्चसा । महेन्द्राशनिकल्पेनसूतस्यविचरिष्यतः ॥ स तेनबाणाशनिनातलशब्दानुवादिना । लाघवाद्राघवःश्रीमान् शिरःकायादपाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40018099, "chapter_id": 9278, "verse_number": "42", "content_sanskrit": "ततोऽपरेणभल्लेनपीतेननिशितेन च ॥ सम्पूर्णायतमुक्तेनसुपत्रेणसुवर्चसा । महेन्द्राशनिकल्पेनसूतस्यविचरिष्यतः ॥ स तेनबाणाशनिनातलशब्दानुवादिना । लाघवाद्राघवःश्रीमान् शिरःकायादपाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40018100, "chapter_id": 9278, "verse_number": "43", "content_sanskrit": "स यन्तरिमहातेजाहतेमन्दोदरीसुतः । स्वयंसारथ्यमकरोत्सुनश्चधनुरस्प ृशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40018101, "chapter_id": 9278, "verse_number": "44", "content_sanskrit": "तदद्भुतमभूत्तत्रसामर्थ्यंपश्यतांयुधि । हयेषुव्यग्रहस्तं त विव्याधनिशितैःशरैः ॥ धनुष्यथपुनर्व्यग्रेहयेषुमुमुचेशरान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40018102, "chapter_id": 9278, "verse_number": "45", "content_sanskrit": "छिद्रेषुतेषुबाणौघैर्विचरन्तमभीतवत् ॥ अर्धयामाससमरेसौमित्रिःशीघ्रकृत्तमः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40018103, "chapter_id": 9278, "verse_number": "46", "content_sanskrit": "निहतंसारथिंदृष्टवासमरेरावणात्मजः ॥ प्रजहौसमरोद्धर्षंविषण्णः स बभूव ह ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40018104, "chapter_id": 9278, "verse_number": "47", "content_sanskrit": "विषण्णवदनंदृष्टवाराक्षसंहरियूथपाः ॥ ततःपरमसम्हृष्टालक्ष्मणंचाभ्यपूजयन् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40018105, "chapter_id": 9278, "verse_number": "48", "content_sanskrit": "ततःप्रमाथीरभसःशरभोगन्धमादनः ॥ अमृष्यमाणाश्चत्वारश्चक्रुर्वेगंहरीश्वराः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40018106, "chapter_id": 9278, "verse_number": "49", "content_sanskrit": "तेचास्यहयमुख्येषुतूर्णमुत्पत्यवानराः ॥ चतुर्षुसुमहावीर्यानिपेतुर्भीमविक्रमाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40018107, "chapter_id": 9278, "verse_number": "50", "content_sanskrit": "तेषामधिष्ठितानांतैर्वानरैःपर्वतोपमैः ॥ मुखेभ्योरुधिरंरक्तंहयानांसमवर्तत ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40018108, "chapter_id": 9278, "verse_number": "51", "content_sanskrit": "तेहयामथिताभग्नाव्यसवोधरणींगताः ॥ तेनिहत्यहयांस्तस्यप्रमथ्य च महारथम् । पुनरुत्पत्यवेगेनतस्थुर्लक्ष्मणपार्श्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40018109, "chapter_id": 9278, "verse_number": "52", "content_sanskrit": "तेहयामथिताभग्नाव्यसवोधरणींगताः ॥ तेनिहत्यहयांस्तस्यप्रमथ्य च महारथम् । पुनरुत्पत्यवेगेनतस्थुर्लक्ष्मणपार्श्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 40018110, "chapter_id": 9278, "verse_number": "53", "content_sanskrit": "स हताश्वादवप्लुत्यरथान्मथितसारथिः । शरवर्षेणसौमित्रिमभ्यधावतरावणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]