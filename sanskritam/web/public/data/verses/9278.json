[{"id": 5000278000, "chapter_id": 9278, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे षष्ठः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000278001, "chapter_id": 9278, "verse_number": "४-६-१", "content_sanskrit": "पुनरेवाब्रवीत् प्रीतो राघवं रघुनन्दनम्।\nअयमाख्याति ते राम सचिवो मन्त्रिसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000278002, "chapter_id": 9278, "verse_number": "४-६-२", "content_sanskrit": "हनुमान् यन्निमित्तं त्वं निर्जनं वनमागतः।\nलक्ष्मणेन सह भ्रात्रा वसतश्च वने तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000278003, "chapter_id": 9278, "verse_number": "४-६-३", "content_sanskrit": "रक्षसापहृता भार्या मैथिली जनकात्मजा।\nत्वया वियुक्ता रुदती लक्ष्मणेन च धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000278004, "chapter_id": 9278, "verse_number": "४-६-४", "content_sanskrit": "अन्तरं प्रेप्सुना तेन हत्वा गृध्रं जटायुषम्।\nभार्यावियोगजं दुःखं प्रापितस्तेन रक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000278005, "chapter_id": 9278, "verse_number": "४-६-५", "content_sanskrit": "भार्यावियोगजं दुःखं नचिरात् त्वं विमोक्ष्यसे।\nअहं तामानयिष्यामि नष्टां वेदश्रुतीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000278006, "chapter_id": 9278, "verse_number": "४-६-६", "content_sanskrit": "रसातले वा वर्तन्तीं वर्तन्तीं वा नभस्तले।\nअहमानीय दास्यामि तव भार्यामरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000278007, "chapter_id": 9278, "verse_number": "४-६-७", "content_sanskrit": "इदं तथ्यं मम वचस्त्वमवेहि च राघव।\nन शक्या सा जरयितुमपि सेन्द्रैः सुरासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000278008, "chapter_id": 9278, "verse_number": "४-६-८", "content_sanskrit": "तव भार्या महाबाहो भक्ष्यं विषकृतं यथा।\nत्यज शोकं महाबाहो तां कान्तामानयामि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000278009, "chapter_id": 9278, "verse_number": "४-६-९", "content_sanskrit": "अनुमानात् तु जानामि मैथिली सा न संशयः।\nह्रियमाणा मया दृष्टा रक्षसा रौद्रकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000278010, "chapter_id": 9278, "verse_number": "४-६-१०", "content_sanskrit": "क्रोशन्ती रामरामेति लक्ष्मणेति च विस्वरम्।\nस्फुरन्ती रावणस्याङ्के पन्नगेन्द्रवधूर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000278011, "chapter_id": 9278, "verse_number": "४-६-११", "content_sanskrit": "आत्मना पञ्चमं मां हि दृष्ट्वा शैलतले स्थितम्।\nउत्तरीयं तया त्यक्तं शुभान्याभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000278012, "chapter_id": 9278, "verse_number": "४-६-१२", "content_sanskrit": "तान्यस्माभिर्गृहीतानि निहितानि च राघव।\nआनयिष्याम्यहं तानि प्रत्यभिज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000278013, "chapter_id": 9278, "verse_number": "४-६-१३", "content_sanskrit": "तमब्रवीत् ततो रामः सुग्रीवं प्रियवादिनम्।\nआनयस्व सखे शीघ्रं किमर्थं प्रविलम्बसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000278014, "chapter_id": 9278, "verse_number": "४-६-१४", "content_sanskrit": "एवमुक्तस्तु सुग्रीवः शैलस्य गहनां गुहाम्।\nप्रविवेश ततः शीघ्रं राघवप्रियकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000278015, "chapter_id": 9278, "verse_number": "४-६-१५", "content_sanskrit": "उत्तरीयं गृहीत्वा तु स तान्याभरणानि च।\nइदं पश्येति रामाय दर्शयामास वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000278016, "chapter_id": 9278, "verse_number": "४-६-१६", "content_sanskrit": "ततो गृहीत्वा वासस्तु शुभान्याभरणानि च।\nअभवद् बाष्पसंरुद्धो नीहारेणेव चन्द्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000278017, "chapter_id": 9278, "verse_number": "४-६-१७", "content_sanskrit": "सीतास्नेहप्रवृत्तेन स तु बाष्पेण दूषितः।\nहा प्रियेति रुदन् धैर्यमुत्सृज्य न्यपतत् क्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000278018, "chapter_id": 9278, "verse_number": "४-६-१८", "content_sanskrit": "हृदि कृत्वा स बहुशस्तमलंकारमुत्तमम्।\nनिशश्वास भृशं सर्पो बिलस्थ इव रोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000278019, "chapter_id": 9278, "verse_number": "४-६-१९", "content_sanskrit": "अविच्छिन्नाश्रुवेगस्तु सौमित्रिं प्रेक्ष्य पार्श्वतः।\nपरिदेवयितुं दीनं रामः समुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000278020, "chapter_id": 9278, "verse_number": "४-६-२०", "content_sanskrit": "पश्य लक्ष्मण वैदेह्या संत्यक्तं ह्रियमाणया।\nउत्तरीयमिदं भूमौ शरीराद् भूषणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000278021, "chapter_id": 9278, "verse_number": "४-६-२१", "content_sanskrit": "शाद्वलिन्यां ध्रुवं भूम्यां सीतया ह्रियमाणया।\nउत्सृष्टं भूषणमिदं तथा रूपं हि दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000278022, "chapter_id": 9278, "verse_number": "४-६-२२", "content_sanskrit": "एवमुक्तस्तु रामेण लक्ष्मणो वाक्यमब्रवीत्।\nनाहं जानामि केयूरे नाहं जानामि कुण्डले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000278023, "chapter_id": 9278, "verse_number": "४-६-२३", "content_sanskrit": "नूपुरे त्वभिजानामि नित्यं पादाभिवन्दनात्।\nततस्तु राघवो वाक्यं सुग्रीवमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000278024, "chapter_id": 9278, "verse_number": "४-६-२४", "content_sanskrit": "ब्रूहि सुग्रीव कं देशं ह्रियन्ती लक्षिता त्वया।\nरक्षसा रौद्ररूपेण मम प्राणप्रिया हृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000278025, "chapter_id": 9278, "verse_number": "४-६-२५", "content_sanskrit": "क्व वा वसति तद् रक्षो महद् व्यसनदं मम।\nयन्निमित्तमहं सर्वान् नाशयिष्यामि राक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000278026, "chapter_id": 9278, "verse_number": "४-६-२६", "content_sanskrit": "हरता मैथिलीं येन मां च रोषयता ध्रुवम्।\nआत्मनो जीवितान्ताय मृत्युद्वारमपावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000278027, "chapter_id": 9278, "verse_number": "४-६-२७", "content_sanskrit": "मम दयिततमा हृता वनाद्\nरजनिचरेण विमथ्य येन सा।\nकथय मम रिपुं तमद्य वै\nप्लवगपते यमसंनिधिं नयामि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000278028, "chapter_id": 9278, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे षष्ठः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]