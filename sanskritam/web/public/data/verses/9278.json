[{"id": 40018058, "chapter_id": 9278, "verse_number": "1", "content_sanskrit": "युध्यमानौतुतौदृष्टवाप्रसक्तौनरराक्षसौ । प्रभिन्नाविवमातङ्गौपरस्परवधैषिणौ ॥ तौद्रष्टुकामस्सङ्ग्रामेपरस्परगतौबली । शूरस्सरावणभ्रातातस्थौसङ्ग्राममूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018059, "chapter_id": 9278, "verse_number": "2", "content_sanskrit": "युध्यमानौतुतौदृष्टवाप्रसक्तौनरराक्षसौ । प्रभिन्नाविवमातङ्गौपरस्परवधैषिणौ ॥ तौद्रष्टुकामस्सङ्ग्रामेपरस्परगतौबली । शूरस्सरावणभ्रातातस्थौसङ्ग्राममूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018060, "chapter_id": 9278, "verse_number": "3", "content_sanskrit": "ततोविष्फारयामासमहद्धनुरवस्थितः । उत्ससर्ज च तीक्ष्णाग्रान् राक्षसेषुमहाशरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018061, "chapter_id": 9278, "verse_number": "4", "content_sanskrit": "तेशराःशिखिसम्पर्शानिपतन्तस्समाहिताः । राक्षसान् दारयामासुर्वज्राणीवमहागिरीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018062, "chapter_id": 9278, "verse_number": "5", "content_sanskrit": "विभीषणस्यानुचरास्तेपिशूलासिपट्टसै: । चिच्छिदुःसमरेवीरान्राक्षसान्राक्षसोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018063, "chapter_id": 9278, "verse_number": "6", "content_sanskrit": "राक्षसैस्स्सैःपरिवृतस्सतदातुविभीषणः । बभौमध्येप्रहृष्टानामाकलभानामिवद्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018064, "chapter_id": 9278, "verse_number": "7", "content_sanskrit": "ततस्स्संञ्चोदयानोवैहरीन्रक्षोरणप्रियान् । उवाचवचनंकालेकालज्ञोरक्षसांवरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018065, "chapter_id": 9278, "verse_number": "8", "content_sanskrit": "एकोऽयंराक्षसेन्द्रस्यपरायणमवस्थितः । एतच्छेषंबलंतस्यकिंतिष्ठतहरीश्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018066, "chapter_id": 9278, "verse_number": "9", "content_sanskrit": "अस्मिंन्विनिहतेपापेराक्षसेरणमूर्थनि । रावणंवर्जयित्वातुशेषमस्यबलंहतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018067, "chapter_id": 9278, "verse_number": "10", "content_sanskrit": "प्रहस्तोनिहतोवीरोनिकुम्भश्चमहाबल. । कुम्भकर्णश्चकुम्भश्चधूम्राक्षश्चनिशाचरः ॥ जम्बुमालीमहामालीतीक्ष्णवेगोऽशनिप्रभः । सुप्तघ्नोयज्ञकोपश्चवज्रदंष्ट्रश्चराक्षसः ॥ सम्ह्रादीविकटोऽरिघ्नस्तपनोदमएव च । प्रघासःप्रघसश्चैवप्रजङ्घोजङ्घएव च ॥ अग्निकेतुश्चदुर्धर्षोरश्मिकेतुश्चवीर्यवान् । विद्युज्जिह्वाद्विजिह्वश्चसूर्यशत्रुश्चराक्षसः ॥ अकम्पनःसुपार्श्वश्चचक्रमाली च राक्षसः । कम्पनस्सत्त्ववन्तौतौदेवान्तकनरान्तकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018068, "chapter_id": 9278, "verse_number": "11", "content_sanskrit": "प्रहस्तोनिहतोवीरोनिकुम्भश्चमहाबल. । कुम्भकर्णश्चकुम्भश्चधूम्राक्षश्चनिशाचरः ॥ जम्बुमालीमहामालीतीक्ष्णवेगोऽशनिप्रभः । सुप्तघ्नोयज्ञकोपश्चवज्रदंष्ट्रश्चराक्षसः ॥ सम्ह्रादीविकटोऽरिघ्नस्तपनोदमएव च । प्रघासःप्रघसश्चैवप्रजङ्घोजङ्घएव च ॥ अग्निकेतुश्चदुर्धर्षोरश्मिकेतुश्चवीर्यवान् । विद्युज्जिह्वाद्विजिह्वश्चसूर्यशत्रुश्चराक्षसः ॥ अकम्पनःसुपार्श्वश्चचक्रमाली च राक्षसः । कम्पनस्सत्त्ववन्तौतौदेवान्तकनरान्तकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018069, "chapter_id": 9278, "verse_number": "12", "content_sanskrit": "प्रहस्तोनिहतोवीरोनिकुम्भश्चमहाबल. । कुम्भकर्णश्चकुम्भश्चधूम्राक्षश्च