"", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018719, "chapter_id": 9292, "verse_number": "19", "content_sanskrit": "रक्षसामद्यशूराणांनिहतानांचमूमुखे । त्वांनिहत्यरणश्लाघीकरोमितरसासमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018720, "chapter_id": 9292, "verse_number": "20", "content_sanskrit": "तिष्ठेदानींनिहमनित्वामेषशूलेनराघव । एवमुक्त्वा स चिक्षेपतच्छूलंराक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018721, "chapter_id": 9292, "verse_number": "21", "content_sanskrit": "तद्रावणकरान्मुक्तंविद्युन्मालासमावृतम् । अष्टघण्टंमहानादंवियद्गतमशोभत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40018722, "chapter_id": 9292, "verse_number": "22", "content_sanskrit": "तच्छूलंराघवोदृष्टवाज्वलन्तंघोरदर्शनम् । ससर्जविशिखान्रामश्चापमायम्यवीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40018723, "chapter_id": 9292, "verse_number": "23", "content_sanskrit": "आपतन्तंशरौघेणवारयामासराघवः । उत्पतन्तंयुगान्तानगिंजलौघैरिववासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40018724, "chapter_id": 9292, "verse_number": "24", "content_sanskrit": "निर्ददाह स तान्बाणान्रामकार्मुकनिःसृतान् । रावणस्यमहान् शूलःपतङ्गानिवपावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40018725, "chapter_id": 9292, "verse_number": "25", "content_sanskrit": "तान्दृष्टवाभस्मसाद्भूतान्शूलसम्स्पर्शचूर्णितान् । सायकानन्तरिक्षस्थान् राघवःक्रोधमाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40018726, "chapter_id": 9292, "verse_number": "26", "content_sanskrit": "स तांमातलिनानीतांशक्तिंवासवसम्मताम् । जग्राहपरमक्रुद्धोराघवोरघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40018727, "chapter_id": 9292, "verse_number": "27", "content_sanskrit": "सातोलिताबलवताशक्तिर्घण्टाकृतस्वना । नभःप्रज्वालयामासयुगान्तोल्केवसप्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40018728, "chapter_id": 9292, "verse_number": "28", "content_sanskrit": "साक्षिप्ताराक्षसेन्द्रस्यतस्मिन्कूलेपपात ह । भिन्नःशक्त्यामहान् शूलोनिपपातहतद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40018729, "chapter_id": 9292, "verse_number": "29", "content_sanskrit": "निर्भिभेदततोबाणैर्हयानस्यमहाजवान् । रामस्त्रीक्ष्णैर्महावेगैर्भाणवद्भिरजिह्मगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40018730, "chapter_id": 9292, "verse_number": "30", "content_sanskrit": "निर्बिभेदोरपितदारावणंनिशितैश्शरैः । राघवःपरमायत्तोललाटेपत्रतिभिस्त्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40018731, "chapter_id": 9292, "verse_number": "31", "content_sanskrit": "स शरैर्भिन्नसर्वाङ्गोगात्रप्रसृतशोणितः । राक्षसेन्द्रस्समूहस्थःफुल्लाशोकइवाबभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]