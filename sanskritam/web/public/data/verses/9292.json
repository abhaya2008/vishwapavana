[{"id": 40018701, "chapter_id": 9292, "verse_number": "1", "content_sanskrit": "तस्यक्रुद्धस्यवदनंदृष्टवारामस्यधीमतः ॥ सर्वभूतानिवित्रेसुःप्राकम्पत च मेदिनी ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018702, "chapter_id": 9292, "verse_number": "2", "content_sanskrit": "सिंहशार्दूलान्शैलस्सञ्चचालचलद्द्रुमः । बभूवचापिक्षुभितःसमुद्रःसरिताम्पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018703, "chapter_id": 9292, "verse_number": "3", "content_sanskrit": "खराश्चखरनिर्घोषागगनेपरुषाघनाः । औत्पातिकानिनर्दन्तस्समन्तात्परिचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018704, "chapter_id": 9292, "verse_number": "4", "content_sanskrit": "रामंदृष्टवासुसङ्क्रुद्धमुत्पातांश्चैवसुदारुणान् । वित्रेसुस्सर्वभूतानिरावणस्याभवद्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018705, "chapter_id": 9292, "verse_number": "5", "content_sanskrit": "विमानस्थास्तदादेवागन्धर्वाश्चमहोरगाः । ऋषिदावनदैत्याश्चगरुत्मन्तश्चखेचराः ॥ ददृशुस्तेतदायुद्धंलोकसम्वर्तसंस्थितम् । नानाप्रहरणैर्भीमैश्शूरयोस्सम्प्रयुध्यतोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018706, "chapter_id": 9292, "verse_number": "6", "content_sanskrit": "विमानस्थास्तदादेवागन्धर्वाश्चमहोरगाः । ऋषिदावनदैत्याश्चगरुत्मन्तश्चखेचराः ॥ ददृशुस्तेतदायुद्धंलोकसम्वर्तसंस्थितम् । नानाप्रहरणैर्भीमैश्शूरयोस्सम्प्रयुध्यतोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018707, "chapter_id": 9292, "verse_number": "7", "content_sanskrit": "ऊचुस्सुरासुरास्सर्वेतदाविग्रहमागताः । प्रेक्षमाणामहर्युद्धंवाक्यंभक्त्याप्रहृष्टवत् ॥