[{"id": 5000292000, "chapter_id": 9292, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000292001, "chapter_id": 9292, "verse_number": "४-२०-१", "content_sanskrit": "रामचापविसृष्टेन शरेणान्तकरेण तम्।\nदृष्ट्वा विनिहतं भूमौ तारा ताराधिपानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000292002, "chapter_id": 9292, "verse_number": "४-२०-२", "content_sanskrit": "सा समासाद्य भर्तारं पर्यष्वजत भामिनी।\nइषुणाभिहतं दृष्ट्वा वालिनं कुञ्जरोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000292003, "chapter_id": 9292, "verse_number": "४-२०-३", "content_sanskrit": "वानरं पर्वतेन्द्राभं शोकसंतप्तमानसा।\nतारा तरुमिवोन्मूलं पर्यदेवयतातुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000292004, "chapter_id": 9292, "verse_number": "४-२०-४", "content_sanskrit": "रणे दारुणविक्रान्त प्रवीर प्लवतां वर।\nकिमिदानीं पुरोभागामद्य त्वं नाभिभाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000292005, "chapter_id": 9292, "verse_number": "४-२०-५", "content_sanskrit": "उत्तिष्ठ हरिशार्दूल भजस्व शयनोत्तमम्।\nनैवंविधाः शेरते हि भूमौ नृपतिसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000292006, "chapter_id": 9292, "verse_number": "४-२०-६", "content_sanskrit": "अतीव खलु ते कान्ता वसुधा वसुधाधिप।\nगतासुरपि तां गात्रैर्मां विहाय निषेवसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000292007, "chapter_id": 9292, "verse_number": "४-२०-७", "content_sanskrit": "व्यक्तमद्य त्वया वीर धर्मतः सम्प्रवर्तता।\nकिष्किन्धेव पुरी रम्या स्वर्गमार्गे विनिर्मिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000292008, "chapter_id": 9292, "verse_number": "४-२०-८", "content_sanskrit": "यान्यस्माभिस्त्वया सार्धं वनेषु मधुगन्धिषु।\nविहृतानि त्वया काले तेषामुपरमः कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000292009, "chapter_id": 9292, "verse_number": "४-२०-९", "content_sanskrit": "निरानन्दा निराशाहं निमग्ना शोकसागरे।\nत्वयि पञ्चत्वमापन्ने महायूथपयूथपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000292010, "chapter_id": 9292, "verse_number": "४-२०-१०", "content_sanskrit": "हृदयं सुस्थितं मह्यं दृष्ट्वा निपतितं भुवि।\nयन्न शोकाभिसंतप्तं स्फुटतेऽद्य सहस्रधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000292011, "chapter_id": 9292, "verse_number": "४-२०-११", "content_sanskrit": "सुग्रीवस्य त्वया भार्या हृता स च विवासितः।\nयत् तत् तस्य त्वया व्युष्टिः प्राप्तेयं प्लवगाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000292012, "chapter_id": 9292, "verse_number": "४-२०-१२", "content_sanskrit": "निःश्रेयसपरा मोहात् त्वया चाहं विगर्हिता।\nयैषाब्रुवं हितं वाक्यं वानरेन्द्र हितैषिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000292013, "chapter_id": 9292, "verse_number": "४-२०-१३", "content_sanskrit": "रूपयौवनदृप्तानां दक्षिणानां च मानद।\nनूनमप्सरसामार्य चित्तानि प्रमथिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000292014, "chapter_id": 9292, "verse_number": "४-२०-१४", "content_sanskrit": "कालो निःसंशयो नूनं जीवितान्तकरस्तव।\nबलाद् येनावपन्नोऽसि सुग्रीवस्यावशो वशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000292015, "chapter_id": 9292, "verse_number": "४-२०-१५", "content_sanskrit": "अस्थाने वालिनं हत्वा युध्यमानं परेण च।\nन संतप्यति काकुत्स्थः कृत्वा कर्मसुगर्हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000292016, "chapter_id": 9292, "verse_number": "४-२०-१६", "content_sanskrit": "वैधव्यं शोकसंतापं कृपणाकृपणा सती।\nअदुःखोपचिता पूर्वं वर्तयिष्याम्यनाथवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000292017, "chapter_id": 9292, "verse_number": "४-२०-१७", "content_sanskrit": "लालितश्चाङ्गदो वीरः सुकुमारः सुखोचितः।\nवत्स्यते कामवस्थां मे पितृव्ये क्रोधमूर्च्छिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000292018, "chapter_id": 9292, "verse_number": "४-२०-१८", "content_sanskrit": "कुरुष्व पितरं पुत्र सुदृष्टं धर्मवत्सलम्।\nदुर्लभं दर्शनं तस्य तव वत्स भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000292019, "chapter_id": 9292, "verse_number": "४-२०-१९", "content_sanskrit": "समाश्वासय पुत्रं त्वं संदेशं संदिशस्व मे।\nमूर्ध्न्नि चैनं समाघ्राय प्रवासं प्रस्थितो ह्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000292020, "chapter_id": 9292, "verse_number": "४-२०-२०", "content_sanskrit": "रामेण हि महत् कर्म कृतं त्वामभिनिघ्नता।\nआनृण्यं तु गतं तस्य सुग्रीवस्य प्रतिश्रवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000292021, "chapter_id": 9292, "verse_number": "४-२०-२१", "content_sanskrit": "सकामो भव सुग्रीव रुमां त्वं प्रतिपत्स्यसे।\nभुङ्क्ष्व राज्यमनुद्विग्नः शस्तो भ्राता रिपुस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000292022, "chapter_id": 9292, "verse_number": "४-२०-२२", "content_sanskrit": "किं मामेवं प्रलपतीं प्रियां त्वं नाभिभाषसे।\nइमाः पश्य वरा बाह्व्यो भार्यास्ते वानरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000292023, "chapter_id": 9292, "verse_number": "४-२०-२३", "content_sanskrit": "तस्या विलपितं श्रुत्वा वानर्यः सर्वतश्च ताः।\nपरिगृह्याङ्गदं दीना दुःखार्ताः प्रतिचुक्रुशुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000292024, "chapter_id": 9292, "verse_number": "४-२०-२४", "content_sanskrit": "किमङ्गदं साङ्गदवीरबाहो\nविहाय यातोऽसि चिरं प्रवासम्।\nन युक्तमेवं गुणसंनिकृष्टं\nविहाय पुत्रं प्रियचारुवेषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000292025, "chapter_id": 9292, "verse_number": "४-२०-२५", "content_sanskrit": "यद्यप्रियं किंचिदसम्प्रधार्य\nकृतं मया स्यात् तव दीर्घबाहो।\nक्षमस्व मे तद्धरिवंशनाथ\nव्रजामि मूर्ध्ना तव वीर पादौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000292026, "chapter_id": 9292, "verse_number": "४-२०-२६", "content_sanskrit": "तथा तु तारा करुणं रुदन्ती\nभर्तुः समीपे सह वानरीभिः।\nव्यवस्यत प्रायमनिन्द्यवर्णा\nउपोपवेष्टुं भुवि यत्र वाली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000292027, "chapter_id": 9292, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]