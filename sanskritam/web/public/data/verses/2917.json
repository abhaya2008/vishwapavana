[{"id": 2089968, "chapter_id": 2917, "verse_number": "१३-४७-१", "content_sanskrit": "उपमन्युरुवाच।\nऋषिरासीत्कृते तात तण्डिरित्येव विश्रुतः।\nदशवर्षसहस्राणि तेन देवः समाधिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2089969, "chapter_id": 2917, "verse_number": "१३-४७-२", "content_sanskrit": "आराधितोऽभूद्भक्तेन तस्योदर्कं निशामय।\nस दृष्टवान्महादेवमस्तौषीच्च स्तवैर्विभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2089970, "chapter_id": 2917, "verse_number": "१३-४७-३", "content_sanskrit": "[इति तण्डिस्तपोयोगात्परमात्मानमव्ययम्।\nचिन्तयित्वा महात्मानमिदमाह सुविस्मितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2089971, "chapter_id": 2917, "verse_number": "१३-४७-४", "content_sanskrit": "यं पठन्ति सदा साङ्ख्याश्चिन्तयन्ति च योगिनः।\nपरं प्रधानं पुरुषमधिष्ठातारमीश्वरम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2089972, "chapter_id": 2917, "verse_number": "१३-४७-५", "content_sanskrit": "उत्पत्तौ च विनाशे च कारणं यं विदुर्बुधाः।\nदेवासुरमुनीनां च परं यस्मान्न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2089973, "chapter_id": 2917, "verse_number": "१३-४७-६", "content_sanskrit": "अजं तमहमीशानमनादिनिधनं प्रभुम्।\nअत्यन्तसुखिनं देवमनघं शरणं व्रजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2089974, "chapter_id": 2917, "verse_number": "१३-४७-७", "content_sanskrit": "एवं ब्रुवन्नेव तदा ददर्श तपसान्निधिम्।\nतमव्ययमनौपम्यमचिन्त्यं शाश्वतं ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2089975, "chapter_id": 2917, "verse_number": "१३-४७-८", "content_sanskrit": "निष्कलं सकलं ब्रह्म निर्गुणं गुणगोचरम्।\nयोगिनां परमानन्दमक्षरं मोक्षसंज्ञितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2089976, "chapter_id": 2917, "verse_number": "१३-४७-९", "content_sanskrit": "मनोरिन्द्राग्निमरुतां विश्वस्य ब्रह्मणो गतिम्।\nअग्राह्यमचलं शुद्धं बुद्धिग्राह्यं मनोमयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2089977, "chapter_id": 2917, "verse_number": "१३-४७-१०", "content_sanskrit": "दुर्विज्ञेयमसङ्ख्ये दुष्प्रापमकृतात्मभिः।\nयोनि विश्वस्य जगतस्तमसः परतः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2089978, "chapter_id": 2917, "verse_number": "१३-४७-११", "content_sanskrit": "यः प्राणवन्तमात्मानं ज्योतिर्जीवस्थितं मनः।\nतं देवं दर्शनाकाङ्क्षी बहून्वर्षगणानृषिः।\nतपस्युग्रे स्थितो भूत्वा दृष्ट्वा तुष्टाव चेश्वरम्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2089979, "chapter_id": 2917, "verse_number": "१३-४७-१२x", "content_sanskrit": "तण्डिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2089980, "chapter_id": 2917, "verse_number": "१३-४७-१२", "content_sanskrit": "पवित्राणां पवित्रस्त्वं गतिर्गतिमतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2089981, "chapter_id": 2917, "verse_number": "१३-४७-१३", "content_sanskrit": "अत्युग्रं तेजसां तेजस्तपसां परमं तपः।\nविश्वावसुहिरण्याक्षपुरुहूतनमस्तृत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2089982, "chapter_id": 2917, "verse_number": "१३-४७-१४", "content_sanskrit": "भूरिकल्याणद विभो परं सत्यं नमोस्तु ते।\nजातीमरणभीरूणां यतीनां यततां विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2089983, "chapter_id": 2917, "verse_number": "१३-४७-१५", "content_sanskrit": "निर्वाणद सहस्रांशो नमस्तेऽस्तु सुखाश्रय।\nब्रह्मा शतक्रतुर्विष्णुर्विश्वेदेवा महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2089984, "chapter_id": 2917, "verse_number": "१३-४७-१६", "content_sanskrit": "न विदुस्त्वां तु तत्त्वेन कुतो वेत्स्यामहे वयम्।\nत्वत्तः प्रवर्तते सर्वं त्वयि सर्वं प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2089985, "chapter_id": 2917, "verse_number": "१३-४७-१७", "content_sanskrit": "कालाख्यः पुरुषाख्यश्च ब्रह्माख्यश्च त्वमेव हि।\nतनवस्ते स्मृतास्तिस्रः पुराणज्ञैः सुरर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2089986, "chapter_id": 2917, "verse_number": "१३-४७-१८", "content_sanskrit": "अधिपौरुषमध्यात्ममधिभूताधिदैवतम्।\nअधिलोकाधिविज्ञानमधियज्ञस्त्वमेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2089987, "chapter_id": 2917, "verse_number": "१३-४७-१९", "content_sanskrit": "त्वां विदित्वाऽऽत्मदेवस्थं दुर्विदं दैवतैरपि।\nविद्वांसो यान्ति निर्मुक्ताः परं भावमनामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2089988, "chapter_id": 2917, "verse_number": "१३-४७-२०", "content_sanskrit": "अनिच्छतस्तव विभो जन्ममृत्युरनेकतः।\nद्वारं तु स्वर्गमोक्षाणामाक्षेप्ता त्वं ददासि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2089989, "chapter_id": 2917, "verse_number": "१३-४७-२१", "content_sanskrit": "त्वं वै स्वर्गश्च मोक्षश्च कामः क्रोधस्त्वमेव च।\nसत्वं रजस्ममश्चैव अधश्चोर्ध्वं त्वमेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2089990, "chapter_id": 2917, "verse_number": "१३-४७-२२", "content_sanskrit": "ब्रह्मा भवश्च विष्णुश्च स्कन्देन्द्रौ सविता यमः।\nवरुणेन्दू मनुर्धाता विधाता त्वं धनेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2089991, "chapter_id": 2917, "verse_number": "१३-४७-२३", "content_sanskrit": "भूर्वायुः सलिलाग्निश्च खं वाग्बुद्धिः स्थितिर्मतिः।\nकर्म सत्यानृते चोभे त्वमेवास्ति च नास्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2089992, "chapter_id": 2917, "verse_number": "१३-४७-२४", "content_sanskrit": "इन्द्रियाणीन्द्रियार्थाश्च प्रकृतिभ्यः परं ध्रुवम्।\nविश्वाविश्वपरो भावश्चिन्त्याचिन्त्यस्त्वमेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2089993, "chapter_id": 2917, "verse_number": "१३-४७-२५", "content_sanskrit": "यच्चैतत्परमं ब्रह्म यच्च तत्परमं पदम्।\nया गतिः साङ्ख्ययोगानां स भवान्नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2089994, "chapter_id": 2917, "verse_number": "१३-४७-२६", "content_sanskrit": "नूनमद्य कृतार्थाः स्म नूनं प्राप्ताः सतां गतिम्।\nयां गतिं प्रार्तयन्तीह ज्ञाननिर्मलबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2089995, "chapter_id": 2917, "verse_number": "१३-४७-२७", "content_sanskrit": "अयो मूढाः स्म सुचिरमिमं कालमचेतसा।\nयन्न विद्मः परं देवं शाश्वतं यं विदुर्बुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2089996, "chapter_id": 2917, "verse_number": "१३-४७-२८", "content_sanskrit": "सेयमासादिता साक्षात्त्वद्भक्तिर्जन्मभिर्मया।\nभक्तानुग्रहकृद्देवो यं ज्ञात्वाऽमृतमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2089997, "chapter_id": 2917, "verse_number": "१३-४७-२९", "content_sanskrit": "देवासुरमुनीनां तु यच्च गुह्यं सनातनम्।\nगुहायां निहितं ब्रह्मि दुर्विज्ञेयं मुनेरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2089998, "chapter_id": 2917, "verse_number": "१३-४७-३०", "content_sanskrit": "स एष भगवान्देवः सर्वकृत्सर्वतोमुखः।\nसर्वात्मा सर्वदर्शी च सर्वगः सर्ववेदिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2089999, "chapter_id": 2917, "verse_number": "१३-४७-३१", "content_sanskrit": "देहकृद्देहभृद्देही देहभुग्देहिनां गतिः।\nप्राणकृत्प्राणभृत्प्राणी प्राणदः प्राणिनां गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2090000, "chapter_id": 2917, "verse_number": "१३-४७-३२", "content_sanskrit": "अध्यात्मगतिरिष्टानां ध्यायिनामात्मवेदिनाम्।\nअपुनर्भवकामानां या गतिः सोऽयमीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2090001, "chapter_id": 2917, "verse_number": "१३-४७-३३", "content_sanskrit": "अयं च सर्वभूतानां शुभाशुभगतिप्रदः।\nअयं च जन्ममरणे विदध्यात्सर्वजन्तुषु।\nअयं संसिद्धिकामानां या गतिः सोयमीस्वरः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2090002, "chapter_id": 2917, "verse_number": "१३-४७-३४", "content_sanskrit": "भूराद्यान्सर्वभुवनानुत्पाद्य सदिवौकसः।\nदधाति देवस्तनुभिरष्टाभिर्यो बिभर्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2090003, "chapter_id": 2917, "verse_number": "१३-४७-३५", "content_sanskrit": "अतः प्रवर्तते सर्वमस्मिन्सर्वं प्रतिष्ठितम्।\nअस्मिंश्च प्रलयं याति अयमेकः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2090004, "chapter_id": 2917, "verse_number": "१३-४७-३६", "content_sanskrit": "अयं स सत्यकामानां सत्यलोकः परं सताम्।\nअपवर्गश्च मुक्तानां कैवल्यं चात्मवेदिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2090005, "chapter_id": 2917, "verse_number": "१३-४७-३७", "content_sanskrit": "अयं ब्रह्मादिभिः सिद्धैर्गुहायां गोपितः प्रुभुः।\nदेवासुरमनुष्याणामप्रकाशो भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2090006, "chapter_id": 2917, "verse_number": "१३-४७-३८", "content_sanskrit": "तं त्वां देवासुरनरास्तत्त्वेन न विदुर्भवम्।\nमोहिताः खल्वनेनैव हृदिस्थेनाप्रकाशिना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2090007, "chapter_id": 2917, "verse_number": "१३-४७-३९", "content_sanskrit": "ये चैनं प्रतिपद्यन्ते भक्तियोगेन भाविताः।\nतेषामेवात्मनात्मानं दर्शयत्येष हृच्छयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2090008, "chapter_id": 2917, "verse_number": "१३-४७-४०", "content_sanskrit": "यं ज्ञात्वा न पुनर्जन्म मरणं चापि विद्यते।\nयं विदित्वा परं वेद्यं वेदितव्यं न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2090009, "chapter_id": 2917, "verse_number": "१३-४७-४१", "content_sanskrit": "यं लब्ध्वा परमं लाभं नाधिकं मन्यते बुधः।\nयां सूक्ष्मां परमां प्राप्तिं गच्छन्नव्ययमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2090010, "chapter_id": 2917, "verse_number": "१३-४७-४२", "content_sanskrit": "यं साङ्ख्या गुणतत्त्वज्ञाः साङ्ख्यशास्त्रविशारदाः।\nसूक्ष्मज्ञानतराः सूक्ष्मं ज्ञात्वा मुच्यन्ति बन्धनैः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2090011, "chapter_id": 2917, "verse_number": "१३-४७-४३", "content_sanskrit": "यं च वेदविदो वेद्यं वेदान्ते च प्रतिष्ठितम्।\nप्राणायामपरा नित्यं यं विशन्ति जपन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2090012, "chapter_id": 2917, "verse_number": "१३-४७-४४", "content_sanskrit": "ओंकाररथमारुह्य ते विशन्ति महेश्वरम्।\nअयं स देवयानानामादित्यो द्वारमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2090013, "chapter_id": 2917, "verse_number": "१३-४७-४५", "content_sanskrit": "अयं च पितृयानानां चन्द्रमा द्वारमुच्यते।\nएष काष्ठा दिशश्चैव संवत्सरयुगादि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2090014, "chapter_id": 2917, "verse_number": "१३-४७-४६", "content_sanskrit": "दिव्यादिव्यः परो लाभ अयने दक्षिणोत्तरे।\nएनं प्रजापतिः पूर्वमाराध्य बहुभिः स्तवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2090015, "chapter_id": 2917, "verse_number": "१३-४७-४७", "content_sanskrit": "प्रजार्थं वरयामास नीललोहितसंज्ञितम्।\nक्रग्भिर्यमनुशासन्ति तत्त्वे कर्मणि बह्वृचाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2090016, "chapter_id": 2917, "verse_number": "१३-४७-४८", "content_sanskrit": "यजुर्भिर्यत्त्रिधा वेद्यं जुह्वत्यध्वर्यवोऽध्वरे।\nसामभिर्यं च गायन्ति सामगाः शुद्धबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2090017, "chapter_id": 2917, "verse_number": "१३-४७-४९", "content_sanskrit": "ऋतं सत्यं परं ब्रह्म स्तुवन्त्याथर्वणा द्विजाः।\nयज्ञस्य परमा योनिः परिश्चायं परः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2090018, "chapter_id": 2917, "verse_number": "१३-४७-५०", "content_sanskrit": "रात्र्यहः श्रोत्रनयनः पक्षमासशिरोभुजः।\nऋतुवीर्यस्तपोधैर्यो ह्यब्दगुह्योरुपादवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2090019, "chapter_id": 2917, "verse_number": "१३-४७-५१", "content_sanskrit": "मृत्युर्यमो हुताशश्च कालः संहारवेगवान्।\nकालस्य परमा योनिः कालश्चायं सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2090020, "chapter_id": 2917, "verse_number": "१३-४७-५२", "content_sanskrit": "चन्द्रादित्यौ सनक्षत्रौ ग्रहाश्च सह वायुना।\nध्रुवः सप्तर्षयश्चैव भुवनाः सप्त एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2090021, "chapter_id": 2917, "verse_number": "१३-४७-५३", "content_sanskrit": "प्रधानं महदव्यक्तं विशेषान्तं सवैकृतम्।\nब्रह्मादिस्तम्बपर्यन्तं भूतादि सदसच्च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2090022, "chapter_id": 2917, "verse_number": "१३-४७-५४", "content_sanskrit": "अष्टौ प्रकृतयश्चैव प्रकृतिभ्यश्च यः परः।\nअस्य देवस्य यद्भागं कृत्स्नं सम्परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2090023, "chapter_id": 2917, "verse_number": "१३-४७-५५", "content_sanskrit": "एतत्परममानन्दं यत्तच्छाश्वतमेव च।\nएषा गतिर्विरक्तानामेष भावः परः सताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2090024, "chapter_id": 2917, "verse_number": "१३-४७-५६", "content_sanskrit": "एतत्पदमनुद्विग्नमेतद्ब्रह्म सनातनम्।\nशास्त्रवेदाङ्गविदुषामेतद्ध्यानं परं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2090025, "chapter_id": 2917, "verse_number": "१३-४७-५७", "content_sanskrit": "इयं सा परमा काष्ठा इयं सा परमा कला।\nइयं सा परमा सिद्धिरियं सा परमा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2090026, "chapter_id": 2917, "verse_number": "१३-४७-५८", "content_sanskrit": "इयं सा परमा शान्तिरियं सा निर्वृतिः परा।\nयं प्राप्य कृतकृत्याः स्म इत्यमन्यन्त योगिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2090027, "chapter_id": 2917, "verse_number": "१३-४७-५९", "content_sanskrit": "इयं तुष्टिरियं सिद्धिरियं श्रुतिरियं स्मृतिः।\nअध्यात्मगतिरिष्टानां विदुषां प्राप्तिरव्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2090028, "chapter_id": 2917, "verse_number": "१३-४७-६०", "content_sanskrit": "यजतां कामयानानां मखैर्विपुलदक्षिणैः।\nया गतिर्यज्ञशीलानां सा गतिस्त्वं न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2090029, "chapter_id": 2917, "verse_number": "१३-४७-६१", "content_sanskrit": "सम्यग्योगजपैः शान्तिर्नियमैर्देहतापनैः।\nतप्यतां या गतिर्देव परमा सा गतिर्भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2090030, "chapter_id": 2917, "verse_number": "१३-४७-६२", "content_sanskrit": "कर्मन्यासकृतानां च विरक्तानां ततस्ततः।\nया गतिर्ब्रह्मिसदने सा गतिस्त्वं सनातन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2090031, "chapter_id": 2917, "verse_number": "१३-४७-६३", "content_sanskrit": "अपुनर्भवकामानां वैराग्ये वर्ततां च या।\nप्रकृतीनां लयानां च सा गतिस्त्वं सनातन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2090032, "chapter_id": 2917, "verse_number": "१३-४७-६४", "content_sanskrit": "ज्ञानविज्ञानयुक्तानां निरुपाख्या निरञ्जना।\nकैवल्या या गतिर्देव परमा सा गतिर्भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2090033, "chapter_id": 2917, "verse_number": "१३-४७-६५", "content_sanskrit": "वेदशास्त्रपुराणोक्ताः पञ्च ता गतयः स्मृताः।\nत्वत्प्रसादाद्धि लभ्यन्ते न लभ्यन्तेऽन्यथा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2090034, "chapter_id": 2917, "verse_number": "१३-४७-६६", "content_sanskrit": "इति तण्डिस्तपोराशिस्तुष्टावेसानमात्मना।\nजगौ च परमं ब्रह्म यत्पुरा लोककृज्जगौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2090035, "chapter_id": 2917, "verse_number": "१३-४७-६७x", "content_sanskrit": "उपमन्युरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2090036, "chapter_id": 2917, "verse_number": "१३-४७-६७", "content_sanskrit": "एवं स्तुतो महादेवस्तण्डिना ब्रह्मवादिना।\nउवाच भगवान्देव उमया सहितः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2090037, "chapter_id": 2917, "verse_number": "१३-४७-६८", "content_sanskrit": "ब्रह्मा शतक्रतुर्विष्णुर्विश्वेदेवा महर्षयः।\nन विदुस्त्वामिति ततस्तुष्टः प्रोवाच तं शिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2090038, "chapter_id": 2917, "verse_number": "१३-४७-६९", "content_sanskrit": "अक्षयश्चाव्ययश्चैव भविता दुःखवर्जितः।\nयशस्वी तेजसा युक्तो दिव्यज्ञानसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2090039, "chapter_id": 2917, "verse_number": "१३-४७-७०", "content_sanskrit": "ऋषीणामभिगम्यश्च सूत्रकर्ता सुतस्तव।\nमत्प्रसादाद्द्विजश्रेष्ठ भविष्यति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2090040, "chapter_id": 2917, "verse_number": "१३-४७-७१", "content_sanskrit": "कं वा कामं ददाम्यद्य ब्रूहि यद्वत्स काङ्क्षसे।\nप्राञ्जलिः स उवाचेदं त्वयि भक्तिर्दृढाऽस्तु मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2090041, "chapter_id": 2917, "verse_number": "१३-४७-७२x", "content_sanskrit": "उपमन्युरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2090042, "chapter_id": 2917, "verse_number": "१३-४७-७२", "content_sanskrit": "एतान्दत्त्वा वरान्देवो वन्द्यमानः सुरर्षिभिः।\nस्तूयमानश्च विबुधैस्तत्रैवान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2090043, "chapter_id": 2917, "verse_number": "१३-४७-७३", "content_sanskrit": "अन्तर्हिते भगवति सानुगे यादवेश्वर।\nऋषिराश्रममागम्य ममैतत्प्रोक्तवानिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2090044, "chapter_id": 2917, "verse_number": "१३-४७-७४", "content_sanskrit": "यानि च प्रथितान्यादौ तण्डिराख्यातवान्मम\nमानानि मानवश्रेष्ठ तानि त्वं शृणु सिद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2090045, "chapter_id": 2917, "verse_number": "१३-४७-७५", "content_sanskrit": "दश नामसहस्राणि देवेष्वाह पितामहः।\nसर्वस्य शास्त्रेषु तथा दश नामशतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2090046, "chapter_id": 2917, "verse_number": "१३-४७-७६", "content_sanskrit": "गुह्यानीमानि नामानि तण्डिर्भगवतोऽच्युत।\nदेवप्रसादाद्देवेशः पुरा प्राह महात्मने॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2090047, "chapter_id": 2917, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तचत्वारिंशोऽध्यायः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]