[{"id": 5000606000, "chapter_id": 9606, "verse_number": "७-७१-१", "content_sanskrit": "ततो द्वादशमे वर्षे शत्रघ्नो रामपालिताम् ।\nअयोध्यां चकमे गन्तुमल्पभृत्यबलानुगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000606001, "chapter_id": 9606, "verse_number": "७-७१-२", "content_sanskrit": "ततो मन्त्रिपुरोगांश्च बलमुख्यान्निवर्त्य च ।\nजगाम हयमुख्यैश्च रथानां च शतेन सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000606002, "chapter_id": 9606, "verse_number": "७-७१-३", "content_sanskrit": "स गत्वा गणितान्वासान्सप्ताष्टौ रघुनन्दनः ।\nवाल्मीक्याश्रममागत्य वासं चक्रे महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000606003, "chapter_id": 9606, "verse_number": "७-७१-४", "content_sanskrit": "सो ऽभिवाद्य ततः पादौ वाल्मीकेः पुरुषर्षभः ।\nपाद्यमर्ध्यं तथातिथ्यं जग्राह मुनिहस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000606004, "chapter_id": 9606, "verse_number": "७-७१-५", "content_sanskrit": "बहुरूपाः सुमधुराः कथास्तत्र सहस्रशः ।\nकथयामास स मुनिः शत्रुघ्नाय महात्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000606005, "chapter_id": 9606, "verse_number": "७-७१-६", "content_sanskrit": "उवाच च मुनिर्वाक्यं लवणस्य वधाश्रितम् ।\nसुदुष्करं कृतं कर्म लवणं निघ्नता त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000606006, "chapter_id": 9606, "verse_number": "७-७१-७", "content_sanskrit": "बहवः पार्थिवाः सौम्य हताः सबलवाहनाः ।\nलवणेन महाबाहो युध्यमाना महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000606007, "chapter_id": 9606, "verse_number": "७-७१-८", "content_sanskrit": "स त्वया निहतः पापो लीलया पुरुषर्षभ ।\nजगतश्च भयं तत्र प्रशान्तं तव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000606008, "chapter_id": 9606, "verse_number": "७-७१-९", "content_sanskrit": "रावणस्य वधो घोरो यत्नेन महता कृतः ।\nइदं तु सुमहत्कर्म त्वया कृतमयत्नतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000606009, "chapter_id": 9606, "verse_number": "७-७१-१०", "content_sanskrit": "प्रीतिश्चास्मिन्परा जाता देवानां लवणे हते ।\nभूतानां चैव सर्वेषां जगतश्च प्रियं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000606010, "chapter_id": 9606, "verse_number": "७-७१-११", "content_sanskrit": "तच्च युद्धं मया दृष्टं यथावत्पुरुषर्षभ ।\nसभायां वासवस्याथ उपविष्टेन राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000606011, "chapter_id": 9606, "verse_number": "७-७१-१२", "content_sanskrit": "ममापि परमा प्रीतिर्हृदि शत्रुघ्न वर्तते ।\nउपाघ्रास्यामि ते मूर्ध्नि स्नेहस्यैषा परा गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000606012, "chapter_id": 9606, "verse_number": "७-७१-१३", "content_sanskrit": "इत्युक्त्वा मूर्ध्नि शत्रुघ्नमुपाघ्राय महामुनिः ।\nआतिथ्यमकरोत्तस्य ये च तस्य पदानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000606013, "chapter_id": 9606, "verse_number": "७-७१-१४", "content_sanskrit": "स भुक्तवान्नरश्रेष्ठो गीतमाधुर्यमुत्तमम् ।\nशुश्राव रामचरितं तस्मिन्काले यथाकृमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000606014, "chapter_id": 9606, "verse_number": "७-७१-१५", "content_sanskrit": "तन्त्रीलयसमायुक्तं त्रिस्थानकरणान्वितम् ।\nसंस्कृतं लक्षणोपेतं समतालसमन्वितम् ।\nशुश्राव रामचरितं तस्मिन्काले पुरा कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000606015, "chapter_id": 9606, "verse_number": "७-७१-१६", "content_sanskrit": "तान्यक्षराणि सत्यानि यथावृत्तानि पूर्वशः ।\nश्रुत्वा पुरुषशार्दूलो विसञ्ज्ञो बाष्पलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000606016, "chapter_id": 9606, "verse_number": "७-७१-१७", "content_sanskrit": "स मुहूर्तमिवासञ्ज्ञो विनिःश्वस्य मुहुर्मुहुः ।\nतस्मिन् गीते यथावृत्तं वर्तमानमिवाशृणोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000606017, "chapter_id": 9606, "verse_number": "७-७१-१८", "content_sanskrit": "पदानुगाश्च ये राज्ञस्तां श्रुत्वा गीतिसम्पदम् ।\nअवाङ्मुखाश्च दीनाश्च ह्याश्चर्यमिति चाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000606018, "chapter_id": 9606, "verse_number": "७-७१-१९", "content_sanskrit": "परस्परं च ये तत्र सैनिकाः सम्बभाषिरे ।\nकिमिदं क्व च वर्तामः किमेतत्स्वप्नदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000606019, "chapter_id": 9606, "verse_number": "७-७१-२०", "content_sanskrit": "अर्थो यो नः पुरा दृष्टस्तमाश्रमपदे पुनः ।\nशृणुमः किमिदं स्वप्नो गीतबन्धं श्रियो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000606020, "chapter_id": 9606, "verse_number": "७-७१-२१", "content_sanskrit": "विस्मयं ते परं गत्वा शत्रुघ्नमिदमब्रुवन् ।\nसाधु पृच्छ नरश्रेष्ठ वाल्मीकिं मुनिपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000606021, "chapter_id": 9606, "verse_number": "७-७१-२२", "content_sanskrit": "शत्रुघ्नस्त्वब्रवीत्सर्वान्कौतूहलसमन्वितान् ।\nसैनिका न क्षमो ऽस्माकं परिप्रष्टुमिहेदृशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000606022, "chapter_id": 9606, "verse_number": "७-७१-२३", "content_sanskrit": "आश्चर्याणि बहूनीह भवन्त्यस्याश्रमे मुनेः ।\nन तु कौतूहलाद्युक्तमन्वेष्टुं तं महामुनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000606023, "chapter_id": 9606, "verse_number": "७-७१-२४", "content_sanskrit": "एवं तद्वाक्यमुक्त्वा च सैनिकान्रघुनन्दनः ।\nअभिवाद्य महर्षिं तं स्वं निवेशं ययौ तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000606024, "chapter_id": 9606, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे एकसप्ततिमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]