[{"id": 7005812000, "chapter_id": 25812, "verse_number": "२८६-१", "content_sanskrit": "महाकल्पलताख्यमहादानविधिवर्णनम् ।\nमत्स्य उवाच ।\nअथातः सप्रवक्ष्यामि महादानमनुत्तमम् ।\nमहाकल्पलता नाम महापातकनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005812001, "chapter_id": 25812, "verse_number": "२८६-२", "content_sanskrit": "पुण्यां तिथिमथासाद्य कृत्वा ब्राह्मण वाचनम् ।\nऋत्विग्मण्डपसम्भार-भूषणाच्छादनादिकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005812002, "chapter_id": 25812, "verse_number": "२८६-३", "content_sanskrit": "तुला पुरुषवत् कुर्यात् लोकेशावाहनं बुधः ।\nचामीकरमयीः कुर्याद्दशकल्पलताः समाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005812003, "chapter_id": 25812, "verse_number": "२८६-४", "content_sanskrit": "नानापुष्पफलोपेता नानांशुक विभूषिताः ।\nविद्याधरसुपर्णानां मिथुनैरुपशोभिताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005812004, "chapter_id": 25812, "verse_number": "२८६-५", "content_sanskrit": "हारानादित्सुभिः सिद्धैः फलानि च विहङ्गमै ।\nलोकपालानुकारिण्यः कर्तव्यास्तासु देवताः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005812005, "chapter_id": 25812, "verse_number": "२८६-६", "content_sanskrit": "ब्राह्मीमनन्तशक्तिञ्च लवणस्योपरि न्यसेत् ।\nअधस्ताल्लतयोर्मध्ये पद्मशङ्खकरे शुभे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005812006, "chapter_id": 25812, "verse_number": "२८६-७", "content_sanskrit": "इभासनस्था तु गुड़े पूर्वतः कुलिशायुधा ।\nरजनी संस्थिताग्नायी श्रुवपाणिरथानले ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005812007, "chapter_id": 25812, "verse_number": "२८६-८", "content_sanskrit": "याम्ये च महिषारूढा गदिनी तण्डुलोपरि ।\nघृते तु नैर्ऋती स्थाप्या सखङ्गा दक्षिणापरे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005812008, "chapter_id": 25812, "verse_number": "२८६-९", "content_sanskrit": "वारुणे वारुणी क्षीरे झषस्था नागपाशिनी ।\nपताकिनी च वायव्ये मृगस्था शर्करोपरि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005812009, "chapter_id": 25812, "verse_number": "२८६-१०", "content_sanskrit": "सौम्या तिलेषु संस्थाप्या शङ्खिनी निधिसंस्थिता ।\nमाहेश्वरी वृषारूढा नवनीते त्रिशूलिनी ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005812010, "chapter_id": 25812, "verse_number": "२८६-११", "content_sanskrit": "मौलिन्यो वरदा तद्वत् कर्तव्या बालकान्विताः ।\nशक्त्या पञ्चपलादूर्ध्वमासहस्रात् प्रकल्पयेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005812011, "chapter_id": 25812, "verse_number": "२८६-१२", "content_sanskrit": "सर्वासामुपरि स्थाप्यं पञ्चवर्णं वितानकम् ।\nधेनवो दशकुम्भाश्च वस्त्रयुग्मानि चैव हि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005812012, "chapter_id": 25812, "verse_number": "२८६-१३", "content_sanskrit": "मध्यमे द्वे तु गुरवे ऋत्विग्भ्योऽन्यास्तथैव च ।\nततो मङ्गलशब्देन स्नातः शुक्लाम्बरो बुधः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005812013, "chapter_id": 25812, "verse_number": "२८६-१४", "content_sanskrit": "नमो नमः पापविनाशिनीभ्यो ब्रह्माण्डलोकेश्वरपालिनीभ्यः ।\nआशंसिताधिक्य फलप्रदाभ्यो दिग्भ्यस्तथा कल्पलतावधूभ्यः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005812014, "chapter_id": 25812, "verse_number": "२८६-१५", "content_sanskrit": "इति सकलदिगङ्गना प्रदानं भवभयसूदनकारि यः करोति ।\nअभिमतफलदे स नागलोके वसति पितामहवत्सराणि त्रिंशत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005812015, "chapter_id": 25812, "verse_number": "२८६-१६", "content_sanskrit": "पितृशतमथ तारयेद् भवाब्धेर्भवदुरितौघ विघात शुद्ध देहः ।\nसुर पति वनिता सहस्र संख्यैः परिवृतमम्बुज संसदाभिवन्द्यः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005812016, "chapter_id": 25812, "verse_number": "२८६-१७", "content_sanskrit": "इति विधानमिदं दिगङ्गनानां कनककल्पलता-विनिवेदकम् ।\nपठति यः स्मरतीह तथेक्षते स पदमेति पुरन्दरसेवितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]