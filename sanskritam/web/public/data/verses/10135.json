[{"id": 6000135000, "chapter_id": 10135, "verse_number": null, "content_sanskrit": "अथ षोडशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000135001, "chapter_id": 10135, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.001.m4a", "display_order": 2}, {"id": 6000135002, "chapter_id": 10135, "verse_number": "६-१६-१", "content_sanskrit": "अथ देवऋषी राजन् सम्परेतं नृपात्मजम्।\nदर्शयित्वेति होवाच ज्ञातीनामनुशोचताम्॥ ६/१६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.002.m4a", "display_order": 3, "topics": [{"text": "नारदाङ्गिरोभ्यां मृतपुत्रजीवमाहूय तन्मुखेनापि राज्ञो ज्ञानोत्पादनं शेषदेवतोषकरविद्योपदेशश्च", "range": "१–२७"}]}, {"id": 6000135003, "chapter_id": 10135, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.003.m4a", "display_order": 4}, {"id": 6000135004, "chapter_id": 10135, "verse_number": "६-१६-२", "content_sanskrit": "जीवात्मन् पश्य भद्रं ते मातरं पितरं च ते।\nसुहृदो बान्धवांस्तप्तान् शुचा त्वत्कृतया भृशम्॥ ६/१६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.004.m4a", "display_order": 5}, {"id": 6000135005, "chapter_id": 10135, "verse_number": "६-१६-३", "content_sanskrit": "कलेवरं स्वमाविश्य शेषमायुः सुहृद्वृतः।\nभुङ्क्ष्व भोगान् पितृप्राप्तानधितिष्ठ नृपासनम्॥ ६/१६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.005.m4a", "display_order": 6}, {"id": 6000135006, "chapter_id": 10135, "verse_number": null, "content_sanskrit": "जीव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.006.m4a", "display_order": 7}, {"id": 6000135007, "chapter_id": 10135, "verse_number": "६-१६-४", "content_sanskrit": "कस्मिन् जन्मन्यमी ब्रह्मन् पितरो मातरोऽभवन्।\nकर्मभिर्भ्राम्यमाणस्य देवतिर्यङ्‌नृयोनिषु॥ ६/१६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.007.m4a", "display_order": 8}, {"id": 6000135008, "chapter_id": 10135, "verse_number": "६-१६-५", "content_sanskrit": "बन्धुज्ञात्यरिमध्यस्थमित्रोदासीनविद्विषः।\nसर्व एव हि सर्वेषां भवन्ति क्रमशो मिथः॥ ६/१६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.008.m4a", "display_order": 9}, {"id": 6000135009, "chapter_id": 10135, "verse_number": "६-१६-६", "content_sanskrit": "यथा वस्तूनि पण्यानि हेमादीनि ततस्ततः।\nपर्यटन्ति नरेष्वेवं जीवो योनिषु कर्तृषु॥ ६/१६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.009.m4a", "display_order": 10}, {"id": 6000135010, "chapter_id": 10135, "verse_number": "६-१६-७", "content_sanskrit": "नित्यस्यार्थस्य सम्बन्धो ह्यनित्यो दृश्यते नृषु।\nयावद् यस्य हि सम्बन्धो ममत्वं तावदेव हि॥ ६/१६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.010.m4a", "display_order": 11}, {"id": 6000135011, "chapter_id": 10135, "verse_number": "६-१६-८", "content_sanskrit": "एवं योनिगतो जीवः स नित्यो निरहङ्कृतः।\nयावद् यत्रोपलभ्येत तावत् स्वत्वं हि तस्य तत्॥ ६/१६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.011.m4a", "display_order": 12}, {"id": 6000135012, "chapter_id": 10135, "verse_number": "६-१६-९", "content_sanskrit": "एष नित्योऽव्ययः सूक्ष्म एकः सर्वाश्रयः स्वदृक्।\nआत्ममायागुणैर्विश्वमात्मानं सृजते प्रभुः॥ ६/१६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.012.m4a", "display_order": 13}, {"id": 6000135013, "chapter_id": 10135, "verse_number": "६-१६-१०", "content_sanskrit": "न ह्यस्यातिप्रियः कश्चिन्नाप्रियः स्वः परोऽपि वा।\nएकः सर्वधियां द्रष्टा कर्तॄणां गुणदोषयोः॥ ६/१६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.013.m4a", "display_order": 14}, {"id": 6000135014, "chapter_id": 10135, "verse_number": "६-१६-११", "content_sanskrit": "नादत्त आत्मा हि गुणं न दोषं न क्रियाफलम्।\nउदासीन इवासीनः परावरदृगीश्वरः॥ ६/१६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.014.m4a", "display_order": 15}, {"id": 6000135015, "chapter_id": 10135, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.015.m4a", "display_order": 16}, {"id": 6000135016, "chapter_id": 10135, "verse_number": "६-१६-१२", "content_sanskrit": "इत्युदीर्य गतो जीवो ज्ञातयस्तस्य ते तदा।\nविस्मिता मुमुचुः शोकं छित्वाऽऽत्मस्नेहशृृङ्खलाम्॥ ६/१६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.016.m4a", "display_order": 17}, {"id": 6000135017, "chapter_id": 10135, "verse_number": "६-१६-१३", "content_sanskrit": "निर्हृत्य ज्ञातयो ज्ञातेर्देहं कृत्वोचिताः क्रियाः।\nतत्यजुर्दुस्त्यजं स्नेहं शोकमोहभयार्तिदम्॥ ६/१६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.017.m4a", "display_order": 18}, {"id": 6000135018, "chapter_id": 10135, "verse_number": "६-१६-१४", "content_sanskrit": "बालघ्न्यो व्रीडितास्तत्र बालहत्याहतप्रभाः। बालहत्याव्रतं चेरुर्ब्राह्मणैर्यन्निरूपितम्।\nयमुनायां महाराज स्मरन्त्यो द्विजभाषितम्॥ ६/१६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.018.m4a", "display_order": 19}, {"id": 6000135019, "chapter_id": 10135, "verse_number": "६-१६-१५", "content_sanskrit": "स इत्थं प्रतिबुद्धात्मा चित्रकेतुर्द्विजोक्तिभिः।\nगृहान्धकूपान्निष्क्रान्तः सरःपङ्कादिव द्विपः॥ ६/१६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.019.m4a", "display_order": 20}, {"id": 6000135020, "chapter_id": 10135, "verse_number": "६-१६-१६", "content_sanskrit": "कालिन्द्यां विधिवत् स्नात्वा कृतपुण्यजलक्रियः।\nमौनेन संयतप्राणो ब्रह्मपुत्राववन्दत॥ ६/१६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.020.m4a", "display_order": 21}, {"id": 6000135021, "chapter_id": 10135, "verse_number": "६-१६-१७", "content_sanskrit": "अथ तस्मै प्रपन्नाय भक्ताय प्रयतात्मने।\nभगवान् नारदः प्रीतो विद्यामेतामुवाच ह॥ ६/१६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.021.m4a", "display_order": 22}, {"id": 6000135022, "chapter_id": 10135, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.022.m4a", "display_order": 23}, {"id": 6000135023, "chapter_id": 10135, "verse_number": "६-१६-१८", "content_sanskrit": "नमस्तुभ्यं भगवते वासुदेवाय धीमहि।\nप्रद्युम्नायानिरुद्धाय नमः सङ्कर्षणाय च॥ ६/१६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.023.m4a", "display_order": 24}, {"id": 6000135024, "chapter_id": 10135, "verse_number": "६-१६-१९", "content_sanskrit": "नमो विज्ञानमात्राय परमानन्दरूपिणे।\nआत्मारामाय शान्ताय निवृत्तद्वैतदृष्टये॥ ६/१६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.024.m4a", "display_order": 25}, {"id": 6000135025, "chapter_id": 10135, "verse_number": "६-१६-२०", "content_sanskrit": "आत्मानन्दानुभूत्यैव सम्यक्त्यक्तोर्मये नमः।\nहृषीकेशाय महते नमस्तेऽनन्तमूर्तये॥ ६/१६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.025.m4a", "display_order": 26}, {"id": 6000135026, "chapter_id": 10135, "verse_number": "६-१६-२१", "content_sanskrit": "मनस्युपरते प्राप्य य एको मनसा सह।\nअनामरूपचिन्मात्रः सोऽव्ययः सदसत्परः॥ ६/१६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.026.m4a", "display_order": 27}, {"id": 6000135027, "chapter_id": 10135, "verse_number": "६-१६-२२", "content_sanskrit": "यस्मिन्निदं यतश्चेदं तिष्ठत्यप्येति जायते।\nमृन्मयेष्विव मृज्जातिस्तस्मै ते ब्रह्मणे नमः॥ ६/१६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.027.m4a", "display_order": 28}, {"id": 6000135028, "chapter_id": 10135, "verse_number": "६-१६-२३", "content_sanskrit": "यन्न स्पृशन्ति न विदुर्मनोबुद्धीन्द्रियासवः।\nअन्तर्बहिश्च विततं व्योमवत् तं नतोऽस्म्यहम्॥ ६/१६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.028.m4a", "display_order": 29}, {"id": 6000135029, "chapter_id": 10135, "verse_number": "६-१६-२४", "content_sanskrit": "देहेन्द्रियप्राणमनोधियोऽमी यदंशविद्धाः प्रचरन्ति कर्मसु।\nनैवान्यदा लोहमिव प्रतप्तं स्थानेषु तद् द्रष्ट्रपदेशमेमि॥ ६/१६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.029.m4a", "display_order": 30}, {"id": 6000135030, "chapter_id": 10135, "verse_number": "६-१६-२५", "content_sanskrit": "ओं नमो भगवते महापुरुषाय महानुभावाय महाविभूतये सकलसात्वतपरिवृढनिकरकरकमल-कुड्मलोपलालितचरणारविन्दयुगल परम परमेष्ठिन् नमस्ते॥ ६/१६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.030.m4a", "display_order": 31}, {"id": 6000135031, "chapter_id": 10135, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.031.m4a", "display_order": 32}, {"id": 6000135032, "chapter_id": 10135, "verse_number": "६-१६-२६", "content_sanskrit": "भक्तायैतां प्रपन्नाय विद्यामादिश्य नारदः।\nययावङ्गिरसा साकं धाम स्वायम्भुवं विभो॥ ६/१६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.032.m4a", "display_order": 33}, {"id": 6000135033, "chapter_id": 10135, "verse_number": "६-१६-२७", "content_sanskrit": "चित्रकेतुस्तु विद्यां तां यथा नारदभाषिताम्।\nधारयामास सप्ताहमब्भक्षः सुसमाहितः॥ ६/१६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.033.m4a", "display_order": 34}, {"id": 6000135034, "chapter_id": 10135, "verse_number": "६-१६-२८", "content_sanskrit": "ततश्च सप्तरात्रान्ते विद्यया धार्यमाणया।\nविद्याधराधिपत्यं स लेभेऽप्रतिहतं नृपः॥ ६/१६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.034.m4a", "display_order": 35, "topics": [{"text": "सप्तरात्रं तस्या विद्याया जपात् शेषदेवस्य दर्शनम् विद्याधरपदप्राप्तिश्च", "range": "२८–३१"}]}, {"id": 6000135035, "chapter_id": 10135, "verse_number": "६-१६-२९", "content_sanskrit": "ततः कतिपयाहोभिर्विद्ययेद्धमनोगतिः।\nजगाम देवदेवस्य शेषस्य चरणान्तिकम्॥ ६/१६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.035.m4a", "display_order": 36}, {"id": 6000135036, "chapter_id": 10135, "verse_number": "६-१६-३०", "content_sanskrit": "मृणालगौरं शितिवाससं स्फुरत्किरीटकेयूरकटित्रकङ्कणम्।\nप्रसन्नवक्त्रारुणलोचनं वृतं ददर्श सिद्धेश्वरमण्डलैः प्रभुम्॥ ६/१६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.036.m4a", "display_order": 37}, {"id": 6000135037, "chapter_id": 10135, "verse_number": "६-१६-३१", "content_sanskrit": "तद्दर्शनध्वस्तसमस्तकिल्बिषः स्वच्छामलान्तःकरणोऽभ्ययान्मुहुः।\nप्रवृद्धभक्त्याप्रणयाश्रुलोचनः प्रहृष्टरोमा तमनादिपूरुषम्॥ ६/१६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.037.m4a", "display_order": 38}, {"id": 6000135038, "chapter_id": 10135, "verse_number": "६-१६-३२", "content_sanskrit": "स उत्तमश्लोकपदाब्जविष्टरं प्रेमाश्रुलेशैरुपसेचयन् मुहुः।\nप्रेमोपरुद्धाखिलवर्णनिर्गमो नैवाशकत् तं प्रसमीडितुं चिरम्॥ ६/१६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.038.m4a", "display_order": 39, "topics": [{"text": "भगवत्स्तुतिः", "range": "३२–४९"}]}, {"id": 6000135039, "chapter_id": 10135, "verse_number": "६-१६-३३", "content_sanskrit": "ततः समाधाय मनो मनीषया बभाष एतत् प्रतिलब्धवाग्रसः।\nनियम्य सर्वेन्द्रियबाह्यवर्तनं जगद्गुरुं सात्वतशास्‍त्रविग्रहम्॥ ६/१६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.039.m4a", "display_order": 40}, {"id": 6000135040, "chapter_id": 10135, "verse_number": null, "content_sanskrit": "चित्रकेतुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.040.m4a", "display_order": 41}, {"id": 6000135041, "chapter_id": 10135, "verse_number": "६-१६-३४", "content_sanskrit": "अजित जितः सममतिभिः साधुभिर्भवान् जितात्मभिर्भवता।\nविजितास्तेऽपि च भजतामकामानां य आत्मदोऽतिकरुणः॥ ६/१६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.041.m4a", "display_order": 42}, {"id": 6000135042, "chapter_id": 10135, "verse_number": "६-१६-३५", "content_sanskrit": "तव विभवः खलु भगवन् जगदुदयस्थितिलयावनादीनि।\nविश्वसृजस्तेंऽशांशास्तत्र मृषा स्पर्धन्ति पृथगभिमत्या॥ ६/१६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.042.m4a", "display_order": 43}, {"id": 6000135043, "chapter_id": 10135, "verse_number": "६-१६-३६", "content_sanskrit": "परमाणुपरममहतोस्त्वमाद्यन्तान्तरवर्ती त्रयविधुरः।\nआदावन्ते च सत्त्वानां यद् ध्रुवं तदेवान्तरकालेऽपि॥ ६/१६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.043.m4a", "display_order": 44}, {"id": 6000135044, "chapter_id": 10135, "verse_number": "६-१६-३७", "content_sanskrit": "क्षित्यादिभिरेष किलावृतः सप्तभिर्दशगुणोत्तरैराण्डकोशः।\nयत्र भगवत्यणुभ्योऽणुकल्पः सहाण्डकोटिभिस्तदनन्तम्॥ ६/१६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.044.m4a", "display_order": 45}, {"id": 6000135045, "chapter_id": 10135, "verse_number": "६-१६-३८", "content_sanskrit": "विषयतृषो नरपशवो य उपासते विभूतीर्न परं त्वाम्।\nतेषामाशिष ईश तदनु विनश्यन्ति यथाऽराजकुलम्॥ ६/१६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.045.m4a", "display_order": 46}, {"id": 6000135046, "chapter_id": 10135, "verse_number": "६-१६-३९", "content_sanskrit": "कामधियस्त्वयीश रचिता न पुनरारोहन्ति यथा करम्भबीजानि।\nज्ञानात्मन्यगुणमये गुणगणतोऽस्य द्वन्द्वजालानि॥ ६/१६/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.046.m4a", "display_order": 47}, {"id": 6000135047, "chapter_id": 10135, "verse_number": "६-१६-४०", "content_sanskrit": "जितमजित तदा भवता यदाऽऽह भागवतं धर्ममनवद्यम्।\nनिष्किञ्चना ये मुनय आत्मारामा यमुपासतेऽपवर्गाय॥ ६/१६/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.047.m4a", "display_order": 48}, {"id": 6000135048, "chapter_id": 10135, "verse_number": "६-१६-४१", "content_sanskrit": "विषममतिर्न यत्र नृणां त्वमहमिति मम तवेति च योऽन्यत्र।\nविषमधिया रचितः स ह्यशुद्धः क्षयिष्णुरधर्मबहुलः॥ ६/१६/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.048.m4a", "display_order": 49}, {"id": 6000135049, "chapter_id": 10135, "verse_number": "६-१६-४२", "content_sanskrit": "कः क्षेमो निजपरयोः कियानर्थः स्वपरद्रुहा धर्मेण।\nस्वद्रोहात् तव कोपः परसम्पीडया च तथाऽधर्मः॥ ६/१६/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.049.m4a", "display_order": 50}, {"id": 6000135050, "chapter_id": 10135, "verse_number": "६-१६-४३", "content_sanskrit": "न व्यभिचरति तवेक्षा यया ह्यभिहितो भागवतो धर्मः।\nस्थिरचरसत्वकदम्बेष्वपृथग्धियो य उपासते त्वार्याः॥ ६/१६/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.050.m4a", "display_order": 51}, {"id": 6000135051, "chapter_id": 10135, "verse_number": "६-१६-४४", "content_sanskrit": "न हि भगवन्नघटितमिदं त्वद्दर्शनान्नृणामखिलपापक्षयः।\nयन्नामसकृच्छ्रवणात् पुल्कसकोऽपि विमुच्यते संसारात्॥ ६/१६/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.051.m4a", "display_order": 52}, {"id": 6000135052, "chapter_id": 10135, "verse_number": "६-१६-४५", "content_sanskrit": "अथ भगवन् वयमधुना त्वदवलोकपरिमृष्टाशयमलाः।\nसुरऋषिणा यदुदितं तावकेन कथमन्यथा भवति॥ ६/१६/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.052.m4a", "display_order": 53}, {"id": 6000135053, "chapter_id": 10135, "verse_number": "६-१६-४६", "content_sanskrit": "विदितमनन्त समस्तं तव जगदात्मनो जनैरिहाचरितम्।\nविज्ञाप्यं परमगुरोः कियदिह सवितुरिव खद्योतैः॥ ६/१६/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.053.m4a", "display_order": 54}, {"id": 6000135054, "chapter_id": 10135, "verse_number": "६-१६-४७", "content_sanskrit": "नमस्तुभ्यं भगवते सकलजगत्स्थितिलयोदयेशाय।\nदुरवसितात्मगतये कुयोगिनां नमः परमहंसाय॥ ६/१६/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.054.m4a", "display_order": 55}, {"id": 6000135055, "chapter_id": 10135, "verse_number": "६-१६-४८", "content_sanskrit": "यं वै श्वसन्तमनु विश्वसृजः श्वसन्ति यं चेकितानमनुवृत्तय उच्चकन्ति।\nभूमण्डलं सर्षपायति यस्य मूर्ध्नि तस्मै नमो भगवतेऽस्तु सहस्रमूर्ध्ने॥ ६/१६/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.055.m4a", "display_order": 56}, {"id": 6000135056, "chapter_id": 10135, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.056.m4a", "display_order": 57}, {"id": 6000135057, "chapter_id": 10135, "verse_number": "६-१६-४९", "content_sanskrit": "संस्तुतो भगवानेवमनन्तस्तमभाषत।\nविद्याधरपतिं प्रीतश्चित्रकेतुं कुरूद्वह॥ ६/१६/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.057.m4a", "display_order": 58}, {"id": 6000135058, "chapter_id": 10135, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.058.m4a", "display_order": 59}, {"id": 6000135059, "chapter_id": 10135, "verse_number": "६-१६-५०", "content_sanskrit": "यन्नारदाङ्गिरोभ्यां ते व्याहृतं मम शासनम्।\nसंसिद्धोऽसि तया राजन् विद्यया दर्शनाच्च मे॥ ६/१६/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.059.m4a", "display_order": 60, "topics": [{"text": "भगवदुपदेशः", "range": "५०–६५"}]}, {"id": 6000135060, "chapter_id": 10135, "verse_number": "६-१६-५१", "content_sanskrit": "अहं वै सर्वभूतानि भूतात्मा भूतभावनः।\nशब्दब्रह्म परं ब्रह्म ममोभे शाश्वती तनू॥ ६/१६/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.060.m4a", "display_order": 61}, {"id": 6000135061, "chapter_id": 10135, "verse_number": "६-१६-५२", "content_sanskrit": "लोकेऽविततमात्मानं लोकं चात्मनि सन्ततम्।\nउभयं च मया व्याप्तं मयि चैवोभयं कृतम्॥ ६/१६/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.061.m4a", "display_order": 62}, {"id": 6000135062, "chapter_id": 10135, "verse_number": "६-१६-५३", "content_sanskrit": "यथा सुषुप्तः पुरुषो विश्वं पश्यति चात्मनि।\nआत्मानमेकदेशस्थं मन्यते स्वप्न उत्थितः॥ ६/१६/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.062.m4a", "display_order": 63}, {"id": 6000135063, "chapter_id": 10135, "verse_number": "६-१६-५४", "content_sanskrit": "एवं जागरणादीनि जीवस्थानानि चात्मनः।\nमायामात्राणि विज्ञाय तद्द्रष्टारं परं स्मरेत्॥ ६/१६/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.063.m4a", "display_order": 64}, {"id": 6000135064, "chapter_id": 10135, "verse_number": "६-१६-५५", "content_sanskrit": "येन प्रसुप्तः पुरुषः स्वापं वेदात्मनस्तदा।\nसुखं च निर्गुणं ब्रह्म तमात्मानमवैहि माम्॥ ६/१६/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.064.m4a", "display_order": 65}, {"id": 6000135065, "chapter_id": 10135, "verse_number": "६-१६-५६", "content_sanskrit": "उभयं स्मरतः पुंसः प्रस्वापप्रतिबोधयोः।\nअन्वेति व्यतिरिच्येत तज्ज्ञानं ब्रह्म तत् परम्॥ ६/१६/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.065.m4a", "display_order": 66}, {"id": 6000135066, "chapter_id": 10135, "verse_number": "६-१६-५७", "content_sanskrit": "यद्येष विस्मृतः पुंसो मद्भावो भिन्न आत्मनः।\nततः संसार एकस्य देहाद् देहो मृतेर्मृतिः॥ ६/१६/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.066.m4a", "display_order": 67}, {"id": 6000135067, "chapter_id": 10135, "verse_number": "६-१६-५८", "content_sanskrit": "लब्ध्वेह मानुषीं योनिं ज्ञानविज्ञानसम्भवाम्।\nआत्मानं यो न बुध्द्येत नक्‍वचित् क्षेममाप्नुयात्॥ ६/१६/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.067.m4a", "display_order": 68}, {"id": 6000135068, "chapter_id": 10135, "verse_number": "६-१६-५९", "content_sanskrit": "स्मृत्वेहायां परिक्लेशं ततः फलविपर्ययम्।\nनोभयं चाप्यनीहायां पश्यंस्तद् विरमेत् कविः॥ ६/१६/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.068.m4a", "display_order": 69}, {"id": 6000135069, "chapter_id": 10135, "verse_number": "६-१६-६०", "content_sanskrit": "सुखाय दुःखमोक्षाय कुर्वाते दम्पती क्रियाः।\nततोऽनिवृत्तिरप्राप्तिर्दुःखस्य च सुखस्य च॥ ६/१६/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.069.m4a", "display_order": 70}, {"id": 6000135070, "chapter_id": 10135, "verse_number": "६-१६-६१", "content_sanskrit": "एवं विपर्ययं बुद्‌ध्वा नृणां विद्याभिमानिनाम्।\nआत्मनश्च गतिं सूक्ष्मां स्थानत्रयविलक्षणाम्॥ ६/१६/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.070.m4a", "display_order": 71}, {"id": 6000135071, "chapter_id": 10135, "verse_number": "६-१६-६२", "content_sanskrit": "दृष्टश्रुताभिर्मात्राभिः विमुक्तः स्वेन तेजसा।\nज्ञानविज्ञानसन्तृप्तो मद्भक्तः पुरुषो भवेत्॥ ६/१६/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.071.m4a", "display_order": 72}, {"id": 6000135072, "chapter_id": 10135, "verse_number": "६-१६-६३", "content_sanskrit": "एतावानेव मनुजैर्योगनैपुण्यबुद्धिभिः।\nस्वार्थः सर्वात्मना ज्ञेयो यत् परात्मैकदर्शनम्॥ ६/१६/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.072.m4a", "display_order": 73}, {"id": 6000135073, "chapter_id": 10135, "verse_number": "६-१६-६४", "content_sanskrit": "त्वमेतच्छ्रद्धया राजन्नप्रमत्तो वचो मम।\nज्ञानविज्ञानसम्पन्नो धारयन्नाशु शुध्यति॥ ६/१६/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.073.m4a", "display_order": 74}, {"id": 6000135074, "chapter_id": 10135, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.074.m4a", "display_order": 75}, {"id": 6000135075, "chapter_id": 10135, "verse_number": "६-१६-६५", "content_sanskrit": "आश्वास्य भगवानित्थं चित्रकेतुं जगद्गुरुः।\nपश्यतस्तस्य विश्वात्मा ततश्चान्तर्दधे हरिः॥ ६/१६/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_016/BhP_06.016.075.m4a", "display_order": 76}, {"id": 6000135076, "chapter_id": 10135, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे षोडशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]