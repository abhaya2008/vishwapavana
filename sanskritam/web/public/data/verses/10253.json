[{"id": 6000253000, "chapter_id": 10253, "verse_number": null, "content_sanskrit": "अथ सप्तपञ्चाशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000253001, "chapter_id": 10253, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.001.m4a", "display_order": 2}, {"id": 6000253002, "chapter_id": 10253, "verse_number": "१०-५७-१", "content_sanskrit": "आनर्ताधिपतिः श्रीमान् रेवतो रेवतीं सुताम्।\nब्रह्मणा चोदितः प्रादाद् बलायेति पुरोदितम्॥ १०/५७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.002.m4a", "display_order": 3, "topics": [{"text": "बलरामरेवत्योः विवाहप्रसङ्गः", "range": "१–१३"}]}, {"id": 6000253003, "chapter_id": 10253, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.003.m4a", "display_order": 4}, {"id": 6000253004, "chapter_id": 10253, "verse_number": "१०-५७-२", "content_sanskrit": "रेवतो नाम राजाऽसौ ब्रह्मणा चोदितः कथम्।\nतदहं श्रोतुमिच्छामि विस्तरेण महामुने॥ १०/५७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.004.m4a", "display_order": 5}, {"id": 6000253005, "chapter_id": 10253, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.005.m4a", "display_order": 6}, {"id": 6000253006, "chapter_id": 10253, "verse_number": "१०-५७-३", "content_sanskrit": "रेवतो नाम राजाऽऽसीत् पुरा धर्मार्थतत्त्ववित्।\nरेवती नाम तस्यैका जज्ञे कन्या यशस्विनी॥ १०/५७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.006.m4a", "display_order": 7}, {"id": 6000253007, "chapter_id": 10253, "verse_number": "१०-५७-४", "content_sanskrit": "स ब्रह्माणं ययौ प्रष्टुं कस्मै दास्यामि तामिति।\nअदत्वा याच्यमानोऽपि नानाजनपदेश्वरैः॥ १०/५७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.007.m4a", "display_order": 8}, {"id": 6000253008, "chapter_id": 10253, "verse_number": "१०-५७-५", "content_sanskrit": "सभायां ब्रह्मणस्तत्र गन्धर्वौ द्वौ हहाहुहू।\nतस्मिन्नगायतां काले ग्राममूर्च्छाविचक्षणौ॥ १०/५७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.008.m4a", "display_order": 9}, {"id": 6000253009, "chapter_id": 10253, "verse_number": "१०-५७-६", "content_sanskrit": "राजाऽतिष्ठद् बहिः किञ्चित् तद्विरामप्रतीक्षया।\nगीतावसाने पप्रच्छ प्रणिपत्य पितामहम्॥ १०/५७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.009.m4a", "display_order": 10}, {"id": 6000253010, "chapter_id": 10253, "verse_number": "१०-५७-७", "content_sanskrit": "एषा मे भगवन् कन्या कस्मै दास्य इमामिति।\nतं प्राह पद्मभूः कस्ते राजपुत्रो विरोचते॥ १०/५७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.010.m4a", "display_order": 11}, {"id": 6000253011, "chapter_id": 10253, "verse_number": "१०-५७-८", "content_sanskrit": "तं चान्यांश्च महीपालानाचक्ष्वेति कुरूद्वह।\nततस्तान् रेवतः प्राह भूपालान् विषयेश्वरान्॥ १०/५७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.011.m4a", "display_order": 12}, {"id": 6000253012, "chapter_id": 10253, "verse_number": "१०-५७-९", "content_sanskrit": "स तानाकर्ण्य नृपतीन् प्रहस्योवाच रेवतम्।\nयुगानि सुबहून्यत्र गतानि तव भूपते॥ १०/५७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.012.m4a", "display_order": 13}, {"id": 6000253013, "chapter_id": 10253, "verse_number": "१०-५७-१०", "content_sanskrit": "क्षणमात्रमिवाश्राव्यं शृण्वतो गीतमेतयोः।\nक्‍वेदानीं तव ते भूपाः सुतायाः सदृशा वराः॥ १०/५७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.013.m4a", "display_order": 14}, {"id": 6000253014, "chapter_id": 10253, "verse_number": "१०-५७-११", "content_sanskrit": "इदानीं राजशार्दूल यदुवंशविवर्द्धनौ।\nवसुदेवगृहे जातौ रामकृष्णाह्वयौ प्रभू॥ १०/५७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.014.m4a", "display_order": 15}, {"id": 6000253015, "chapter_id": 10253, "verse_number": "१०-५७-१२", "content_sanskrit": "तत्र सङ्कर्षणायेमां कन्यां यच्छस्व भूपते। इत्युक्तस्तेन भूपालस्तं प्रणम्य पुरं गतः।\nरामाय प्रददौ कन्यां रूपिणीं बाहुशालिने॥ १०/५७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.015.m4a", "display_order": 16}, {"id": 6000253016, "chapter_id": 10253, "verse_number": "१०-५७-१३", "content_sanskrit": "तामादियुगसम्भूतां दीर्घदेहां महाभुजः।\nआकृष्य लाङ्गलेनांसे समां चक्रे हलायुधः॥ १०/५७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.016.m4a", "display_order": 17}, {"id": 6000253017, "chapter_id": 10253, "verse_number": "१०-५७-१४", "content_sanskrit": "भगवानपि गोविन्द उपयेमे कुरूद्वह।\nवैदर्भीं भीष्मकसुतामिन्दिरांशां स्वयंवरे॥ १०/५७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.017.m4a", "display_order": 18}, {"id": 6000253018, "chapter_id": 10253, "verse_number": "१०-५७-१५", "content_sanskrit": "प्रमथ्य तरसा राज्ञः साल्वादींश्चैद्यपक्षगान्।\nपश्यतां सर्वभूतानां तार्क्ष्यपुत्रः सुधामिव॥ १०/५७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.018.m4a", "display_order": 19, "topics": [{"text": "रुग्मिण्या ब्राह्मणेन पत्रप्रषणम्", "range": "१५–४४"}]}, {"id": 6000253019, "chapter_id": 10253, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.019.m4a", "display_order": 20}, {"id": 6000253020, "chapter_id": 10253, "verse_number": "१०-५७-१६", "content_sanskrit": "भगवान् भीष्मकसुतां रुग्मिणीं रुचिराननाम्।\nराक्षसेन विवाहेन उपयेम इति श्रुतम्॥ १०/५७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.020.m4a", "display_order": 21}, {"id": 6000253021, "chapter_id": 10253, "verse_number": "१०-५७-१७", "content_sanskrit": "भगवन् श्रोतुमिच्छामि कृष्णस्यामिततेजसः।\nयथा मागधसाल्वादीन् जित्वा तत्पारमागमत्॥ १०/५७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.021.m4a", "display_order": 22}, {"id": 6000253022, "chapter_id": 10253, "verse_number": "१०-५७-१८", "content_sanskrit": "ब्रह्मन् विष्णुकथाः पुण्या माध्वीर्लोकमलापहाः।\nको नु तृप्येत शृण्वानः श्रुतज्ञो नित्यनूतनाः॥ १०/५७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.022.m4a", "display_order": 23}, {"id": 6000253023, "chapter_id": 10253, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.023.m4a", "display_order": 24}, {"id": 6000253024, "chapter_id": 10253, "verse_number": "१०-५७-१९", "content_sanskrit": "राजाऽऽसीद् भीष्मको नाम विदर्भाधिपतिर्महान्।\nतस्य पञ्चाभवन् पुत्राः कन्यैका च वरानना॥ १०/५७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.024.m4a", "display_order": 25}, {"id": 6000253025, "chapter_id": 10253, "verse_number": "१०-५७-२०", "content_sanskrit": "रुग्म्यग्रजो रुग्मरथो रुग्मबाहुरनन्तरः।\nरुग्मकेशो रुग्ममाली रुग्मिण्येषां स्वसा सती॥ १०/५७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.025.m4a", "display_order": 26}, {"id": 6000253026, "chapter_id": 10253, "verse_number": "१०-५७-२१", "content_sanskrit": "सोेपश्रुत्य मुकुन्दस्य रूपवीर्यगुणश्रियः।\nगृहागतैर्गीयमानास्तं मेने सदृशं पतिम्॥ १०/५७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.026.m4a", "display_order": 27}, {"id": 6000253027, "chapter_id": 10253, "verse_number": "१०-५७-२२", "content_sanskrit": "तां बुद्धिलक्षणौदार्यरूपशीलगुणाश्रयाम्।\nकृष्णश्च सदृशीं भार्यां समुद्वोढुं मनो दधे॥ १०/५७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.027.m4a", "display_order": 28}, {"id": 6000253028, "chapter_id": 10253, "verse_number": "१०-५७-२३", "content_sanskrit": "बन्धूनामिच्छतां दातुं कृष्णाय भगिनीं नृप।\nरुग्मी निवार्य कृष्णद्विट्‍चैद्याय समकल्पयत्॥ १०/५७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.028.m4a", "display_order": 29}, {"id": 6000253029, "chapter_id": 10253, "verse_number": "१०-५७-२४", "content_sanskrit": "तदवेत्यासितापाङ्गी वैदर्भी दुर्मना भृशम्।\nविचिन्त्याप्तं द्विजं कञ्चित् कृष्णाय प्राहिणोद् द्रुतम्॥ १०/५७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.029.m4a", "display_order": 30}, {"id": 6000253030, "chapter_id": 10253, "verse_number": "१०-५७-२५", "content_sanskrit": "द्वारकां स समभ्येत्य प्रतीहारैः प्रवेशितः।\nअपश्यदाद्यं पुरुषमासीनं काञ्चनासने॥ १०/५७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.030.m4a", "display_order": 31}, {"id": 6000253031, "chapter_id": 10253, "verse_number": "१०-५७-२६", "content_sanskrit": "दृष्ट्वा ब्रह्मण्यदेवस्तमवरुह्य निजासने।\nउपवेश्यार्हयाञ्चक्रे यथाऽऽत्मानं दिवौकसः॥ १०/५७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.031.m4a", "display_order": 32}, {"id": 6000253032, "chapter_id": 10253, "verse_number": "१०-५७-२७", "content_sanskrit": "तं भुक्तवन्तं विश्रान्तमुपगम्य सतां गतिः।\nपाणिनाऽभिमृशन् पाणावव्यग्रस्तमपृच्छत॥ १०/५७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.032.m4a", "display_order": 33}, {"id": 6000253033, "chapter_id": 10253, "verse_number": "१०-५७-२८", "content_sanskrit": "कच्चिद् द्विजकुलश्रेष्ठ धर्मस्ते वृद्धसम्मतः।\nवर्तते नातिकृच्छ्रेण सन्तुष्टमनसः सदा॥ १०/५७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.033.m4a", "display_order": 34}, {"id": 6000253034, "chapter_id": 10253, "verse_number": "१०-५७-२९", "content_sanskrit": "सन्तुष्टो यदि वर्तेत ब्राह्मणो येन केनचित्।\nअहीयमानः स्वाद् धर्मात् स ह्यस्याखिलकामधुक्॥ १०/५७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.034.m4a", "display_order": 35}, {"id": 6000253035, "chapter_id": 10253, "verse_number": "१०-५७-३०", "content_sanskrit": "असन्तुष्टः सुखं विप्र नाप्नोत्यपि सुरेश्वरः।\nअकिञ्चनोऽपि सन्तुष्टः शेते सर्वाङ्गविज्वरः॥ १०/५७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.035.m4a", "display_order": 36}, {"id": 6000253036, "chapter_id": 10253, "verse_number": "१०-५७-३१", "content_sanskrit": "विप्रान् स्वलाभसन्तुष्टान् साधून् भूतसुहृत्तमान्।\nनिरहङ्कारिणः शान्तान् नमस्ये शिरसाऽसकृत्॥ १०/५७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.036.m4a", "display_order": 37}, {"id": 6000253037, "chapter_id": 10253, "verse_number": "१०-५७-३२", "content_sanskrit": "कच्चिद् वः कुशलं ब्रह्मन् राजतो यस्य हि प्रजाः।\nसुखं वसन्ति विषये पाल्यमानाः स मे प्रियः॥ १०/५७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.037.m4a", "display_order": 38}, {"id": 6000253038, "chapter_id": 10253, "verse_number": "१०-५७-३३", "content_sanskrit": "यतस्त्वमागतो दुर्गं निस्तीर्येह यदृच्छया।\nसर्वं नो ब्रूह्यगुह्यं चेत् किं कार्यं करवाम ते॥ १०/५७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.038.m4a", "display_order": 39}, {"id": 6000253039, "chapter_id": 10253, "verse_number": "१०-५७-३४", "content_sanskrit": "एवं सम्पृष्टसम्प्रश्नो ब्राह्मणः परमेष्ठिना।\nनिधाय लिखितं पत्रं पादयोः प्रणनाम तम्॥ १०/५७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.039.m4a", "display_order": 40}, {"id": 6000253040, "chapter_id": 10253, "verse_number": "१०-५७-३५", "content_sanskrit": "तदादाय जगन्नाथः स्मितसुन्दरलोचनः।\nवाचयामास धर्मात्मा सादरं स्पृहयन्निव॥ १०/५७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.040.m4a", "display_order": 41}, {"id": 6000253041, "chapter_id": 10253, "verse_number": null, "content_sanskrit": "रुग्मिण्युवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.041.m4a", "display_order": 42}, {"id": 6000253042, "chapter_id": 10253, "verse_number": "१०-५७-३६", "content_sanskrit": "श्रुत्वा गुणान् भुवनसुन्दर सङ्गमांस्ते निर्विश्य कर्णविवरं हरतोऽङ्गतापम्।\nरूपं परं भुवनमङ्गलमङ्गलंते त्वय्यच्युताविशति चित्तमपत्रपं मे॥ १०/५७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.042.m4a", "display_order": 43}, {"id": 6000253043, "chapter_id": 10253, "verse_number": "१०-५७-३७", "content_sanskrit": "का त्वा मुकुन्द महती गुणशीलरूपविद्यावयोद्रविणधामभिरात्मतुल्यम्।\nव्रीडावती कुलवती न वृणीत कन्या काले नृसिंह नरलोकमनोभिरामम्॥ १०/५७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.043.m4a", "display_order": 44}, {"id": 6000253044, "chapter_id": 10253, "verse_number": "१०-५७-३८", "content_sanskrit": "स त्वं मयाऽप्यभिवृतः पतिरिन्दिराया भक्तप्रियः कृपणलोकशरण्य ईशः।\nमत्वैतदङ्ग तव पादसरोजदास्याः कामं कुरु प्रियतम प्रणताऽस्मि तेऽङ्घ्रिम्॥ १०/५७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.044.m4a", "display_order": 45}, {"id": 6000253045, "chapter_id": 10253, "verse_number": "१०-५७-३९", "content_sanskrit": "तन्मे भवान् खलु वृतः पतिरङ्ग जायामात्माऽर्पितश्च भवतोऽत्र विभो विधेहि।\nमा वीरभागमभिमर्शतु चैद्य आराद् गोमायुवन्मृगपतेर्बलिमम्बुजाक्ष॥ १०/५७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.045.m4a", "display_order": 46}, {"id": 6000253046, "chapter_id": 10253, "verse_number": "१०-५७-४०", "content_sanskrit": "पूर्तेष्टदत्तनियमव्रतदेवविप्रगुर्वर्चनादिभिरलं भगवान् परेशः।\nआराधितो यदि गदाग्रज एत्य पाणिं गृह्णातु मे, न दमघोषसुतादयोऽन्ये॥ १०/५७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.046.m4a", "display_order": 47}, {"id": 6000253047, "chapter_id": 10253, "verse_number": "१०-५७-४१", "content_sanskrit": "श्वोभाविनि त्वमजितोद्वहने विदर्भान् गुप्तान् समेत्य पृतनापतिभिः समेतैः।\nनिर्मथ्य चैद्यमगधेन्द्रबलं प्रसह्य मां राक्षसेन विधिनोद्वह वीर्यशुल्काम्॥ १०/५७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.047.m4a", "display_order": 48}, {"id": 6000253048, "chapter_id": 10253, "verse_number": "१०-५७-४२", "content_sanskrit": "अन्तःपुरान्तरचरानविहत्य बन्धूंस्त्वामुद्वहे कथमिति प्रवदाम्युपायम्।\nपूर्वेद्युरस्ति महती कुलदेवियात्रा यस्यां बहिर्नववधूर्गिरिजामुपेयात्॥ १०/५७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.048.m4a", "display_order": 49}, {"id": 6000253049, "chapter_id": 10253, "verse_number": "१०-५७-४३", "content_sanskrit": "तत्रैत्य मां रथपदातिगजाश्वयुक्तः सम्मथ्य साल्वमगधान् सहचेदिभूपान्।\nआदाय मां सहचरीभिरथो रमेशो गृह्णातु पाणिमुपनीय पुरीं स्वकीयाम्॥ १०/५७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.049.m4a", "display_order": 50}, {"id": 6000253050, "chapter_id": 10253, "verse_number": "१०-५७-४४", "content_sanskrit": "यस्याङ्घ्रिपङ्कजरजःस्तवनं महान्तो वाञ्छन्त्युमापतिरिवात्मतमोपहत्यै।\nयद्यम्बुजाक्ष न लभेय भवत्प्रसादं जह्यामसून् व्रतकृशा शतजन्मभिः स्याम्॥ १०/५७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.050.m4a", "display_order": 51}, {"id": 6000253051, "chapter_id": 10253, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.051.m4a", "display_order": 52}, {"id": 6000253052, "chapter_id": 10253, "verse_number": "१०-५७-४५", "content_sanskrit": "इति पत्रगतं विश्वं विमृश्य मधुसूदनः।\nसन्देशं राजकन्यायास्तं ब्राह्मणमवैक्षत॥ १०/५७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.052.m4a", "display_order": 53}, {"id": 6000253053, "chapter_id": 10253, "verse_number": null, "content_sanskrit": "ब्राह्मण उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.053.m4a", "display_order": 54}, {"id": 6000253054, "chapter_id": 10253, "verse_number": "१०-५७-४६", "content_sanskrit": "इत्येते गुह्यसन्देशा यदुदेव मयाऽऽहृताः।\nविमृश्य युक्तं यच्चात्र क्रियतां तदनन्तरम्॥ १०/५७/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_057/BhP_10.057.054.m4a", "display_order": 55}, {"id": 6000253055, "chapter_id": 10253, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे सप्तपञ्चाशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]