[{"id": 2118948, "chapter_id": 3556, "verse_number": "", "content_sanskrit": "जरिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2118949, "chapter_id": 3556, "verse_number": "१", "content_sanskrit": "अस्माद् बिलान्निष्पतितमाखुं श्येनो जहार तम् ।\nक्षुद्रं गृहीत्वा पादाभ्यां भयं न भविता ततः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2118950, "chapter_id": 3556, "verse_number": "", "content_sanskrit": "शार्ङ्गकाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2118951, "chapter_id": 3556, "verse_number": "२", "content_sanskrit": "न विद्महे हृतं मातः श्येनेनाखुं कथञ्चन ।\nअन्येऽपि भवितारोऽत्र तेभ्योऽपि भयमेव नः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2118952, "chapter_id": 3556, "verse_number": "३", "content_sanskrit": "संशयं ह्यग्निरागच्छेद् दृष्टं वायोर्निवर्तनम्\nमृत्युर्नो बिलवासिभ्यो भवेन्मातरसंशयः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2118953, "chapter_id": 3556, "verse_number": "४", "content_sanskrit": "निःसंशयात् संशयितो मृत्युर्मातर्विशिष्यते ।\nचर खे त्वं यथान्यायं पुत्रानाप्स्यसि शोभनान् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2118954, "chapter_id": 3556, "verse_number": "", "content_sanskrit": "जरिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2118955, "chapter_id": 3556, "verse_number": "५", "content_sanskrit": "अहं वै श्येनमायान्तमद्राक्षं बिलमन्तिकात् ।\nसञ्चरन्तं समादाय जहाराखुं बिलाद् बली \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2118956, "chapter_id": 3556, "verse_number": "६", "content_sanskrit": "तं पतन्तमहं श्येनं त्वरिता पृष्ठमन्वगाम् ।\nआशिषोऽस्य प्रयुञ्जाना हरन्तं मूषिकं बिलात् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2118957, "chapter_id": 3556, "verse_number": "७", "content_sanskrit": "यो नो द्वेष्टारमादाय श्येनराज विधावसि ।\nभव त्वं दिवमास्थाय निरमित्रो हिरण्मयः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2118958, "chapter_id": 3556, "verse_number": "८", "content_sanskrit": "स यदा भक्षितस्तेन क्षुधितेन पतत्रिणा ।\nतदाऽहं तमनुज्ञाप्य प्रत्युपायां गृहान् प्रति \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2118959, "chapter_id": 3556, "verse_number": "९", "content_sanskrit": "प्रविशध्वं बिलं पुत्रा विस्रब्धा नास्ति वो भयम् ।\nश्येनेन मम पश्यन्त्या हृत आखुर्न संशयः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2118960, "chapter_id": 3556, "verse_number": "", "content_sanskrit": "शार्ङ्गकाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2118961, "chapter_id": 3556, "verse_number": "१०", "content_sanskrit": "न विद्महे वयं मातर्हृतमाखुमितः पुरा ।\nअविज्ञाय न शक्ष्यामः बिलमावेशितुं वयम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2118962, "chapter_id": 3556, "verse_number": "", "content_sanskrit": "जरिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2118963, "chapter_id": 3556, "verse_number": "११", "content_sanskrit": "अहं हि तं विजानामि हृतं श्येनेन मूषिकम् ।\nअत एव भयं नास्ति क्रियतां वचनं मम \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2118964, "chapter_id": 3556, "verse_number": "", "content_sanskrit": "शार्ङ्गकाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2118965, "chapter_id": 3556, "verse_number": "१२", "content_sanskrit": "न त्वं मिथ्योपचारेण मोक्षयेथा भयं महत् ।\nसमाकुलेषु ज्ञानेषु न बुद्धिकृतमेव तत् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2118966, "chapter_id": 3556, "verse_number": "१३", "content_sanskrit": "न चोपकृतमस्माभिर्न चास्मान् वेत्थ ये वयम् ।\nपीड्यमानान् भरस्यस्मान् का सती के वयं तव \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2118967, "chapter_id": 3556, "verse_number": "१४", "content_sanskrit": "तरुणी दर्शनीयाऽसि समर्था भर्तुरेषणे ।\nअनुगच्छस्व भर्तारं पुत्राँल्लप्स्यसि शोभने \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2118968, "chapter_id": 3556, "verse_number": "१५", "content_sanskrit": "वयमग्निं समाविश्य लोकान् प्राप्स्यामहे शुभे ।\nअथास्मान् न दहेदग्निरम्बायाः पुनरेव नः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2118969, "chapter_id": 3556, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2118970, "chapter_id": 3556, "verse_number": "१६", "content_sanskrit": "एवमुक्ता ततः शार्ङ्गी पुत्रानुत्सृज्य खाण्डवे ।\nजगाम त्वरिता देशं क्षेममग्नेरनाश्रयम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2118971, "chapter_id": 3556, "verse_number": "१७", "content_sanskrit": "ततस्तीक्ष्णार्चिरभ्यागाज्ज्वलितो हव्यवाहनः ।\nयत्र शार्ङ्गा बभूवुस्ते मन्दपालस्य पुत्रकाः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2118972, "chapter_id": 3556, "verse_number": "१८", "content_sanskrit": "ततस्तं ज्वलितं दृष्ट्वा ज्वलनं ते विहङ्गमाः ।\nव्यथिताः करुणा वाचः श्रावयामासुरन्तिकात् ।\nजरितारिस्ततो वाक्यं श्रावयामास पावकम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2118973, "chapter_id": 3556, "verse_number": "२३५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nपञ्चत्रिंशत्यधिकद्विशततमोऽध्यायः ॥२३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2118974, "chapter_id": 3556, "verse_number": "४", "content_sanskrit": "॥ इति मयदर्शनपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2118975, "chapter_id": 3556, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]