  },
  {
    "id": 20200354,
    "chapter_id": 7753,
    "verse_number": "२.१.४",
    "content_sanskrit": "सह सुपा",
    "padaccheda": "सह । सुपा",
    "anvaya": "सुपा सह समासः ",
    "meaning_sanskrit": "सुबन्तस्य समर्थसुबन्तेन सह समासः भवति । ",
    "meaning_english": "A समास is formed when one सुबन्त combines with another related सुबन्त. ",
