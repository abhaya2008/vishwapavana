[{"id": 2138086, "chapter_id": 3991, "verse_number": "१", "content_sanskrit": "वसत्स्वेवं वने तेषु पाण्डवेषु महात्मसु ।\nरममाणेषु चित्राभिः कथाभिः मुनिभिः सह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2138087, "chapter_id": 3991, "verse_number": "२", "content_sanskrit": "सूर्यदत्ताक्षयान्नेन कृष्णाया भोजनावधि ।\nब्राह्मणांस्तर्पमाणेषु ये चान्नार्थमुपागताः ।\nअरण्यानां मृगाणां च मांसैर्नानाविधैरपि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2138088, "chapter_id": 3991, "verse_number": "३", "content_sanskrit": "धार्तराष्ट्रा दुरात्मानः सर्वे दुर्योधनादयः ।\nकथं तेष्वन्ववर्तन्त पापाचारा महामुने\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2138089, "chapter_id": 3991, "verse_number": "४", "content_sanskrit": "दुःशासनस्य कर्णस्य शकुनेश्च मते स्थिताः ।\nएतदाचक्ष्व भगवन् वैशम्पायन पृच्छतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2138090, "chapter_id": 3991, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2138091, "chapter_id": 3991, "verse_number": "५", "content_sanskrit": "श्रुत्वा शेषां तथा वृत्तिं नगरे वसतामिव ।\nदुर्योधनो महाराज तेषु चिन्तयत्सु दुरात्मसु\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2138092, "chapter_id": 3991, "verse_number": "६", "content_sanskrit": "तथा तैर्निकृतिप्रज्ञैः कर्णदुश्शासनादिभिः ।\nनानोपायैरघं तेषु चिन्तयत्सु दुरात्मसु\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2138093, "chapter_id": 3991, "verse_number": "७", "content_sanskrit": "अभ्यगच्छत् स धर्मात्मा दुर्वासा नाम कामतः ।\nशिष्यायुतसमोपेतो तपस्वी सुमहायशाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2138094, "chapter_id": 3991, "verse_number": "८", "content_sanskrit": "तमागतमभिप्रेक्ष्य मुनिं परमकोपनम् ।\nदुर्योधनो विनीतात्मा प्रश्रयणेन दमेन च ।\nसहितो भ्रातृभिः श्रीमानाथित्येन न्यमन्त्रयत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2138095, "chapter_id": 3991, "verse_number": "९", "content_sanskrit": "विधिवत् पूजयामास स्वयं किङ्करवत् स्थितः ।\nअहानि कतिचित् तत्र तस्थौ स मुनिसत्तमः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2138096, "chapter_id": 3991, "verse_number": "१०", "content_sanskrit": "तं च पर्यचरद् राजा दिवारात्रमतन्द्रितः ।\nदुर्योधनो महाराज शापात् तस्य विशङ्कितः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2138097, "chapter_id": 3991, "verse_number": "११", "content_sanskrit": "क्षुधितोऽस्मि ददस्वान्नं शीघ्रं मम नराधिप ।\nइत्युक्त्वा गच्छति स्नातुं प्रत्यागच्छति वै चिरात्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2138098, "chapter_id": 3991, "verse_number": "१२", "content_sanskrit": "न भोक्ष्याम्यद्य मे नास्ति क्षुधेत्युक्त्वैत्यदर्शनम् ।\nअकस्मादेत्य च ब्रूते भोजयास्मांस्त्वरान्वितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2138099, "chapter_id": 3991, "verse_number": "१३", "content_sanskrit": "कदाचिच्च निशीथे स उत्थाय निकृतौ स्थितः ।\nपूर्ववत् कारयित्वाऽन्नं न भुङ्क्ते गर्हयन् स्म सः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2138100, "chapter_id": 3991, "verse_number": "१४", "content_sanskrit": "वर्तमाने तथा तस्मिन् यदा दुर्योधनो नृपः ।\nनिकृतिं नैति न क्रोधं तदा तुष्टोऽभवन्मुनिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2138101, "chapter_id": 3991, "verse_number": "१५", "content_sanskrit": "आह चैनं दुराधर्षो वरदोऽस्मीति भारत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2138102, "chapter_id": 3991, "verse_number": "१६", "content_sanskrit": "वरं वरय भद्रं ते यत्ते मनसि वर्तते ।\nमयि प्रीते तु यद्धर्म्यं नालभ्यं विद्यते तव\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2138103, "chapter_id": 3991, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2138104, "chapter_id": 3991, "verse_number": "१७", "content_sanskrit": "एतच्छ्रुत्वा वचस्तस्य महर्षेर्भावितात्मनः ।\nअमन्यत पुनर्जातमात्मानं स सुयोधनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2138105, "chapter_id": 3991, "verse_number": "१८", "content_sanskrit": "प्रागेव मन्त्रितं चासीत् कर्णदुःशासनादिभिः ।\nयाचनीयं मुनेस्तुष्टादिति निश्चित्य दुर्मतिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2138106, "chapter_id": 3991, "verse_number": "१९", "content_sanskrit": "अतिहर्षान्वितो राजन् वरमेनमयाचत ।\nशिष्यैः सह मम ब्रह्मन् यथा जातोऽतिथिर्भवान्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2138107, "chapter_id": 3991, "verse_number": "२०", "content_sanskrit": "अस्मत्कुले महाराजो ज्येष्ठः श्रेष्ठो युधिष्ठिरः ।\nवने वसति धर्मात्मा भ्रातृभिः परिवारितः ।\nगुणवान् शीलसम्पन्नस्तस्य त्वमतिथिर्भव\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2138108, "chapter_id": 3991, "verse_number": "२१", "content_sanskrit": "यदा च राजपुत्री सा सुकुमारी यशस्विनी ।\nभोजयित्वा द्विजान् सर्वान् पतींश्च वरवर्णिनी\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2138109, "chapter_id": 3991, "verse_number": "२२", "content_sanskrit": "विश्रान्ता च स्वयं भुक्त्वा सुखासीना भवेद् यदा ।\nतदा त्वं तत्र गच्छेथा यद्यनुग्राह्यता मयि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2138110, "chapter_id": 3991, "verse_number": "२३", "content_sanskrit": "तथा करिष्ये त्वत्प्रीत्येत्येवमुक्त्वा सुयोधनम् ।\nदुर्वासा अपि विप्रेन्द्रो यथागतमगात् ततः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2138111, "chapter_id": 3991, "verse_number": "२४", "content_sanskrit": "कृतार्थमपि चात्मानं तदा मेने सुयोधनः ।\nकरेण च करं गृह्य कर्णस्य मुदितो भृशम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2138112, "chapter_id": 3991, "verse_number": "२५", "content_sanskrit": "कर्णोऽपि भ्रातृसहितमित्युवाच नृपं मुदा ।\nदिष्ट्या कामः सुसंवृत्तो दिष्ट्या कौरव वर्धसे ।\nदिष्ट्या ते शत्रवो मग्ना दुस्तरे व्यसनार्णवे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2138113, "chapter_id": 3991, "verse_number": "२६", "content_sanskrit": "दुर्वासःक्रोधजे वह्नौ पातिताः पाण्डुनन्दनाः ।\nस्वैरेव ते महापापैर्गता वै दुस्तरं तमः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2138114, "chapter_id": 3991, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2138115, "chapter_id": 3991, "verse_number": "२७", "content_sanskrit": "इत्थं ते निकृतिप्रज्ञा राजन् दुर्योधनादयः ।\nहसन्तः प्रीतिमनसो जग्मुः स्वंस्वं निकेतनम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2138116, "chapter_id": 3991, "verse_number": "", "content_sanskrit": "॥ इति प्रथमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]