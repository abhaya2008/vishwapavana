[{"id": 2103508, "chapter_id": 3243, "verse_number": "१४-९९-१", "content_sanskrit": "वैशम्पायन उवाच।\nश्रुत्वैवं सात्विकं दानं राजसं तामसं तथा।\nपृथक्पृथक्त्वेन गतिं फलं चापि पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2103509, "chapter_id": 3243, "verse_number": "१४-९९-२", "content_sanskrit": "अवितृप्तः प्रहृष्टात्मा पुण्यं धर्मामृतं पुनः।\nयुधिष्ठिरो धर्मरतः केशवं पुनरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2103510, "chapter_id": 3243, "verse_number": "१४-९९-३", "content_sanskrit": "बीजयोनिविशुद्धानां लक्षणानि वदस्व मे।\nबीजदोषेण लोकेश जायन्ते च कथं नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2103511, "chapter_id": 3243, "verse_number": "१४-९९-४", "content_sanskrit": "आचारदोषं देवेशं वक्तुगर्हस्यशेषतः॥\nब्राह्मणानां विशेषं च गुणदोषौ च केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2103512, "chapter_id": 3243, "verse_number": "१४-९९-५", "content_sanskrit": "चातुर्वर्ण्यस्य कुत्स्नस्य वर्तमानाः प्रतिग्रहे।\nकेन विप्रा विशेषेण तरन्ते तारयन्ति च।\nएतान्कथय देवेश त्वद्भक्तस्य नमोस्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2103513, "chapter_id": 3243, "verse_number": "१४-९९-६x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2103514, "chapter_id": 3243, "verse_number": "१४-९९-६", "content_sanskrit": "शृणु राजन्यथावृत्तं बीजयोनिं शुभाशुभम्।\nयेन तिष्ठति लोकोयं विनश्यति च पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2103515, "chapter_id": 3243, "verse_number": "१४-९९-७", "content_sanskrit": "अविप्लुतब्रह्मचर्यो यस्तु विप्रो यथाविधि।\nस बीजं नाम विज्ञेयं तस्य बीजं शुभं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2103516, "chapter_id": 3243, "verse_number": "१४-९९-८", "content_sanskrit": "कन्या चाक्षतयोनिः स्यात्कुलीना पितृमातृतः।\nब्राह्मणादिषु विवाहेषु परिणीता यथाविधि।\nसा प्रशस्ता वरारोहा तस्या योनिः प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2103517, "chapter_id": 3243, "verse_number": "१४-९९-९", "content_sanskrit": "मनसा कर्मणा वाचा या गच्छेत्परपूरुषम्।\nयोनिस्तस्या नरश्रेष्ठ गर्भाधानं न चार्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2103518, "chapter_id": 3243, "verse_number": "१४-९९-१०", "content_sanskrit": "स्वैरिण्या यस्तु पापात्मा संतानार्थमिहेच्छति।\nस कुलान्पातयत्याशु दशपूर्वान्दशापरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2103519, "chapter_id": 3243, "verse_number": "१४-९९-११", "content_sanskrit": "दुष्टयोनौ तु यो मोहाद्रेतः सिञ्चति मूढधीः।\nतद्रेतसा समुत्पन्नः षडङ्गविदपि द्विजः।\nसाधुभिः स बहिष्कार्यः श्वापाक इव पार्थिवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2103520, "chapter_id": 3243, "verse_number": "१४-९९-१२", "content_sanskrit": "कर्मणा मनसा वाचा या भवेत्स्वैरचारिणी।\nसा कुलघ्रीति विज्ञेया तस्यां जातः श्वपाचकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2103521, "chapter_id": 3243, "verse_number": "१४-९९-१३", "content_sanskrit": "दैवे पित्र्ये तथा दाने भोजने सहभाषणे।\nशयने सहसंबन्धे न योग्या दृष्टयोनिजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2103522, "chapter_id": 3243, "verse_number": "१४-९९-१४", "content_sanskrit": "न तस्माद्दुष्टयोन्यां तु गर्भमुत्पादयेद्बुधः।\nमोहेन कुरुते यस्तु कुलं हन्ति त्रिपूरुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2103523, "chapter_id": 3243, "verse_number": "१४-९९-१५", "content_sanskrit": "कानीकनश्च सहोञश्च तथोभौ कुण्डगोलकै।\nआरूढपतिताज्जातः परितस्यापि यः सुतः।\nषडेते विप्रचण्डाला निकृष्टाः श्वपचादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2103524, "chapter_id": 3243, "verse_number": "१४-९९-१६", "content_sanskrit": "यो यत्र तत्र वा रेतः सिक्त्वा शूद्रासु वा चरेत्।\nकामचारी स पापात्मा बीजं तस्याशुभं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2103525, "chapter_id": 3243, "verse_number": "१४-९९-१७", "content_sanskrit": "अशुद्धं तद्भवेद्बीजं शुद्धां योनि न चार्हति।\nदूषयत्यपि तां योनिं शुना लीढं हविर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2103526, "chapter_id": 3243, "verse_number": "१४-९९-१८", "content_sanskrit": "शूद्रयोनौ पतेद्बीजं हाहाशब्दं द्विजन्मनः।\nकुर्यात्पुरीषगर्तेषु पतितोऽस्मीति दुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2103527, "chapter_id": 3243, "verse_number": "१४-९९-१९", "content_sanskrit": "मामधःपातयन्नेष पापात्मा काममोहितः।\nअधोगतिं प्रजोत्क्षिप्रमिति शप्त्वा पतेत्तु तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2103528, "chapter_id": 3243, "verse_number": "१४-९९-२०", "content_sanskrit": "आत्मा हि शुक्लमुद्दिष्टं दैवतं परमं महत्।\nतस्मात्सर्वप्रयत्नेन निरुन्ध्याच्छुक्लमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2103529, "chapter_id": 3243, "verse_number": "१४-९९-२१", "content_sanskrit": "आयुस्तेजो बलं वीर्यं प्रज्ञा श्रीश्च महद्यशः।\nपुण्यं च मत्प्रियत्वं च लभते ब्रह्मचर्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2103530, "chapter_id": 3243, "verse_number": "१४-९९-२२", "content_sanskrit": "अविप्लुतब्रह्मचर्यैर्गृहस्थश्रममाश्रितैः।\nपञ्चयज्ञपरैर्धर्मः स्थाप्यते पृथिवीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2103531, "chapter_id": 3243, "verse_number": "१४-९९-२३", "content_sanskrit": "सायंप्रातस्तु ये सन्ध्यां सम्यङ्नित्यमुपासते।\nनावं वेदमयीं कृत्वा तरन्ते तारयन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2103532, "chapter_id": 3243, "verse_number": "१४-९९-२४", "content_sanskrit": "यो जपेत्पावनीं देवीं गायत्रीं वेदमातरम्।\nन सीदेत्प्रतिगृह्णानः पृथिवीं च ससागराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2103533, "chapter_id": 3243, "verse_number": "१४-९९-२५", "content_sanskrit": "ये चास्य दुःस्थिताः केचिद्ग्रहाः सूर्यादयो दिवि।\nते चास्य सौम्या जायन्ते शिवाः शुभकरास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2103534, "chapter_id": 3243, "verse_number": "१४-९९-२६", "content_sanskrit": "यत्र यत्र स्थिताश्चैव दारुणाः पिशिताशनाः।\nघोररूपा महाकाया धर्षयन्ति न तं द्विजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2103535, "chapter_id": 3243, "verse_number": "१४-९९-२७", "content_sanskrit": "पुनन्तीह पृथिव्यां च चीर्णवेदव्रता नराः।\nचतुर्णामपि वेदानां सा हि राजन्गरीयसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2103536, "chapter_id": 3243, "verse_number": "१४-९९-२८", "content_sanskrit": "अचीर्णिव्रतवेदा ये विकर्मफलमाश्रिताः।\nब्राह्ममा नाममात्रेण तेऽपि पूज्या युधिष्ठिर।\nकिं पुनर्यस्तु सन्ध्ये द्वे नित्यमेवोपतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2103537, "chapter_id": 3243, "verse_number": "१४-९९-२९", "content_sanskrit": "शीलमध्ययनं दानं शौचं मार्दवमार्जवम्।\nतस्माद्वेदाद्विशिष्टानि मनुराह प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2103538, "chapter_id": 3243, "verse_number": "१४-९९-३०", "content_sanskrit": "भूर्भुवस्स्वरिति ब्रह्म यो वेदनिरतो द्विजः।\nस्वदारनिरतो दान्तः स विद्वान्स च भूसुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2103539, "chapter_id": 3243, "verse_number": "१४-९९-३१", "content_sanskrit": "सन्ध्यामुपासते ये वै नित्यमेव द्विजोत्तमाः।\nते यान्ति नरशार्दूल ब्रह्मलोकं न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2103540, "chapter_id": 3243, "verse_number": "१४-९९-३२", "content_sanskrit": "सावित्रीमात्रसारोपि वरो विप्रः सुयन्त्रितः।\nनायन्त्रितश्चतुर्वेदी सर्वाशी सर्वविक्रयी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2103541, "chapter_id": 3243, "verse_number": "१४-९९-३३", "content_sanskrit": "सावित्रीं चैव वेदांश्च तुलयाऽतोलयन्पुरा।\nसदेवर्षिगणाश्चैव सर्वे ब्रह्मपुरस्सराः।\nचतुर्णामपि वेदानां सा हि राजन्गरीयसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2103542, "chapter_id": 3243, "verse_number": "१४-९९-३४", "content_sanskrit": "यथा विकसिते पुष्पे मधु गृह्णन्ति षट्पदाः।\nएवं गृहीता सावित्री सर्ववेदे च पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2103543, "chapter_id": 3243, "verse_number": "१४-९९-३५", "content_sanskrit": "तस्मात्तु सर्ववेदानां सावित्री प्राण उच्यते।\nनिर्जीवा हीतरे वेदा विना सावित्रिया नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2103544, "chapter_id": 3243, "verse_number": "१४-९९-३६", "content_sanskrit": "नायन्त्रितश्चतुर्वेदी शीलभ्रष्टः स कुत्सितः।\nशीलवृत्तसमायुक्तः सावित्रीपाठको वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2103545, "chapter_id": 3243, "verse_number": "१४-९९-३७", "content_sanskrit": "सहस्रपरमां देवीं शतमध्यां दशावराम्।\nसावित्रीं जप कौतेय सर्वपापप्रणाशिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2103546, "chapter_id": 3243, "verse_number": "१४-९९-३८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2103547, "chapter_id": 3243, "verse_number": "१४-९९-३८", "content_sanskrit": "त्रैलोक्यनाथ हे कृष्ण सर्वभूतात्मको ह्यसि।\nनानायोगपर श्रेष्ठ तुष्यसे केन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2103548, "chapter_id": 3243, "verse_number": "१४-९९-३९x", "content_sanskrit": "भागवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2103549, "chapter_id": 3243, "verse_number": "१४-९९-३९", "content_sanskrit": "यदि भारसहस्रं तु गुग्गुल्वादि प्रधूपयेत्।\nकरोति चेन्नमस्कारमुपहारं च कारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2103550, "chapter_id": 3243, "verse_number": "१४-९९-४०", "content_sanskrit": "स्तौति यः स्तुतिभिर्मां च ऋग्यजुस्सामभिः सदा।\nन तोषयति चेद्धिप्रान्नाहं तुष्यामि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2103551, "chapter_id": 3243, "verse_number": "१४-९९-४१", "content_sanskrit": "ब्राह्मणे पूजिते नित्यं पूजितोस्मि न संशयः।\nआक्रुष्टे चाहमाक्रुष्टो भवामि भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2103552, "chapter_id": 3243, "verse_number": "१४-९९-४२", "content_sanskrit": "परा मयि गतिस्तेषां पूजयन्ति द्विजं हि ये।\nयदहं द्विजरूपेण वसामि वसुधातले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2103553, "chapter_id": 3243, "verse_number": "१४-९९-४३", "content_sanskrit": "यस्तान्पूजयति प्राज्ञो मद्गतेनान्तरात्मना।\nतमहं स्वेन रूपेण पश्यामि नरपुङ्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2103554, "chapter_id": 3243, "verse_number": "१४-९९-४४", "content_sanskrit": "कुब्जाः काणा वामनाश्च दरिद्रा व्याधितास्तथा।\nनावमान्या द्विजाः प्राज्ञैर्मम रूपा हि ते द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2103555, "chapter_id": 3243, "verse_number": "१४-९९-४५", "content_sanskrit": "ये केचित्सागरान्तायां पृथिव्यां द्विजसत्तमाः।\nमम रूपं हि तेष्वेवमर्चितेष्वर्चितोऽस्म्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2103556, "chapter_id": 3243, "verse_number": "१४-९९-४६", "content_sanskrit": "बहवस्तु न जानन्ति नरा ज्ञानबहिष्कृताः।\nयदहं द्विजरूपेण वसामि वसुधातले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2103557, "chapter_id": 3243, "verse_number": "१४-९९-४७", "content_sanskrit": "अवमन्यन्ति ये विप्रान्स्वधर्मान्पातयन्ति ते।\nप्रेषणैः प्रेषयन्ते च शुश्रूषां कारयन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2103558, "chapter_id": 3243, "verse_number": "१४-९९-४८", "content_sanskrit": "मृतांश्चात्र परत्रेमान्यमदूता महाबलाः।\nनिकृन्तन्ति यथाकामं सूत्रमार्गेण शिल्पिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2103559, "chapter_id": 3243, "verse_number": "१४-९९-४९", "content_sanskrit": "आक्रोशपरिवादाभ्यां ये रमन्ते द्विजातिषु।\nतान्मृतान्यमलोकस्थान्निपात्य पृथिवीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2103560, "chapter_id": 3243, "verse_number": "१४-९९-५०", "content_sanskrit": "आक्रम्योरसि पादेन क्रूरः संरक्तलोचनः।\nअग्निवर्णैस्तु संदंशैर्यमो जिह्वां समुद्धरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2103561, "chapter_id": 3243, "verse_number": "१४-९९-५१", "content_sanskrit": "ये च विप्रान्निरीक्षन्ते पापाः पापेन चक्षुषा।\nअब्रह्मण्याः श्रुतेर्बाह्या नित्यं ब्रह्मद्विषो नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2103562, "chapter_id": 3243, "verse_number": "१४-९९-५२", "content_sanskrit": "तेषां घोरा महाकाया वक्रतुण्डा महाबलाः।\nउद्धरन्ति मुहूर्तेन स्वगाश्चक्षुर्यमाज्ञया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2103563, "chapter_id": 3243, "verse_number": "१४-९९-५३", "content_sanskrit": "यः प्रहारं द्विजेन्द्राय दद्यात्कुर्याच्च शोणितम्।\nअस्थिभङ्गं च यः कुर्यात्प्राणैर्वा विप्रयोजयेत्।\nसोनुपूर्व्येण यातीमान्नरकानेकविंशतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2103564, "chapter_id": 3243, "verse_number": "१४-९९-५४", "content_sanskrit": "शूलमारोप्यते पश्चाज्ज्वलने परिपच्यते।\nबहुवर्षसहस्राणि पच्यमानस्त्ववाक्छिराः।\nनावमुच्येत दुर्मेदा न तस्य क्षीयते गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2103565, "chapter_id": 3243, "verse_number": "१४-९९-५५", "content_sanskrit": "ब्राह्मणान्वा विचार्यैव व्रजन्तै वधकाङ्क्षया।\nशतर्वषसहस्राणि तामिस्रे परिपच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2103566, "chapter_id": 3243, "verse_number": "१४-९९-५६", "content_sanskrit": "उत्पाद्य शोणितं गात्रात्संरंभमतिपूर्वकम्।\nसपर्ययेण यातीमान्नरकानेकविंशतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2103567, "chapter_id": 3243, "verse_number": "१४-९९-५७", "content_sanskrit": "तस्मान्नाकुशलं ब्रूयान्न शुष्कां गतिमीरयेत्।\nन ब्रूयात्परुषां वाणीं न चैवैनानतिक्रमेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2103568, "chapter_id": 3243, "verse_number": "१४-९९-५८", "content_sanskrit": "ये विप्राञ्श्लक्ष्णया वाचा पूजयन्ति नरोत्तमाः।\nअर्चितश्च स्तुतश्चैव तैर्भवामि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2103569, "chapter_id": 3243, "verse_number": "१४-९९-५९", "content_sanskrit": "तर्जयन्ति च ये विप्रान्क्रोशयन्ति च भारत।\nआक्रुष्टस्तर्जितश्चाहं तैर्भवामि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2103570, "chapter_id": 3243, "verse_number": "१४-९९-६०", "content_sanskrit": "यश्चन्दनैश्चागरुधूपदीपै-\nरभ्यर्चयेत्काष्ठमयीं ममार्चाम्।\nतेनार्चितो नैव भवामि सम्य-\nग्विप्रार्चनादस्मि समर्चितोऽहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2103571, "chapter_id": 3243, "verse_number": "१४-९९-६१", "content_sanskrit": "विप्रप्रसादाद्धरणीधरोऽहं\nविप्रप्रसादादसुराञ्जयामि।\nविप्रप्रसादाच्च सदक्षिणोऽहं\nविप्रप्रसादादजितोऽहमस्मि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2103572, "chapter_id": 3243, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि एकोनशततमोऽध्यायः॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]