[{"id": 2186184, "chapter_id": 4953, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2186185, "chapter_id": 4953, "verse_number": "१", "content_sanskrit": "अतिक्रामति कालेऽस्मिन् सर्वभूतक्षयावहे ।\nकिं श्रेयः प्रतिपद्येत तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2186186, "chapter_id": 4953, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2186187, "chapter_id": 4953, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nपितुः पुत्रेण संवादं तन्निबोध युधिष्ठिर\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2186188, "chapter_id": 4953, "verse_number": "३", "content_sanskrit": "द्विजातेः कस्यचित् पार्थ स्वाध्यायनिरतस्य वै ।\nबभूव पुत्रो मेधावी मेधावी नाम नामतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2186189, "chapter_id": 4953, "verse_number": "४", "content_sanskrit": "सोऽब्रवीत् पितरं पुत्रः स्वाध्यायकरणे रतम् ।\nमोक्षधर्मार्थकुशलो लोकतत्त्वविचक्षणः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2186190, "chapter_id": 4953, "verse_number": "५", "content_sanskrit": "धीरः किं स्वित्तात कुर्यात् प्रजानन्\nक्षिप्रं ह्यायुर्भ्रश्यते मानवानाम् ।\nपितस्तदाचक्ष्व यथार्थयोगं\nममानुपूर्व्या येन धर्मं चरेयम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2186191, "chapter_id": 4953, "verse_number": "", "content_sanskrit": "पिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2186192, "chapter_id": 4953, "verse_number": "६", "content_sanskrit": "वेदानधीत्य ब्रह्मचर्येण पुत्र\nपुत्रानिच्छेत् पावनार्थं पितॄणाम् ।\nअग्नीनाधाय विधिवच्चेष्टयज्ञो\nवनं प्रविश्याथ मुनिर्बुभूषेत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2186193, "chapter_id": 4953, "verse_number": "", "content_sanskrit": "पुत्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2186194, "chapter_id": 4953, "verse_number": "७", "content_sanskrit": "एवमभ्याहते लोके समन्तात् परिवारिते ।\nअमोघासु पतन्तीषु किं धीर इव भाषसे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2186195, "chapter_id": 4953, "verse_number": "", "content_sanskrit": "पिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2186196, "chapter_id": 4953, "verse_number": "८", "content_sanskrit": "कथमभ्याहतो लोकः केन वा परिवारितः ।\nअमोघाः काः पतन्तीह किं नु भीषयसीव माम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2186197, "chapter_id": 4953, "verse_number": "", "content_sanskrit": "पुत्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2186198, "chapter_id": 4953, "verse_number": "९", "content_sanskrit": "मृत्युनाभ्याहतो लोको जरया परिवारितः ।\nअहोरात्राः पतन्त्येते ननु कस्मान्न बुध्यसे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2186199, "chapter_id": 4953, "verse_number": "१०", "content_sanskrit": "यदाहमेतज्जानामि न मृत्युस्तिष्ठतीति ह ।\nसोऽहं कथं प्रतीक्षिष्ये जालेनापिहितश्चरन्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2186200, "chapter_id": 4953, "verse_number": "११", "content_sanskrit": "रात्र्यां रात्र्यां व्यतीतायामायुरल्पतरं यदा ।\nगाधोदके मत्स्य इव सुखं विन्देत कस्तदा ।\nतदैव वन्ध्यं दिवसमिति विद्याद् विचक्षणः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2186201, "chapter_id": 4953, "verse_number": "१२", "content_sanskrit": "यामेव रात्रिं प्रथमां गर्भो भजति मातरम् ।\nतामेव रात्रिं प्रस्थाति मरणाय निवर्तते ।\nयस्यां रात्र्यां व्यतीतायां न किञ्चिच्छुभमाचरेत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2186202, "chapter_id": 4953, "verse_number": "१३", "content_sanskrit": "अनवाप्तेषु कामेषु मृत्युरभ्येति मानवम् ।\nपुष्पाणीव विचिन्वन्तमन्यत्रगतमानसम् ।\nवृकीवोरणमासाद्य मृत्युरादाय गच्छति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2186203, "chapter_id": 4953, "verse_number": "", "content_sanskrit": "नियतो देहिनां मृत्युरनिमित्तं हि जीवितम् \t॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2186204, "chapter_id": 4953, "verse_number": "१४", "content_sanskrit": "अद्यैव कुरु यच्छ्रेयो मा त्वा कालोऽत्यगादयम् ।\nअकृतेष्वेव कार्येषु मृत्युर्वै सम्प्रकर्षति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2186205, "chapter_id": 4953, "verse_number": "१५", "content_sanskrit": "श्वःकार्यमद्य कुर्वीत पूर्वाह्णे चापराह्णिकम् ।\nन हि प्रतीक्षते मृत्युः कृतं वास्य न वा कृतम् ।\nको हि जानाति कस्याद्य मृत्युसेना निवेक्ष्यते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2186206, "chapter_id": 4953, "verse_number": "१६", "content_sanskrit": "युवैव धर्मशीलः स्यादनिमित्तं हि जीवितम् ।\nकृते धर्मे भवेत् कीर्तिरिह प्रेत्य च वै सुखम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2186207, "chapter_id": 4953, "verse_number": "१७", "content_sanskrit": "मोहेन हि समाविष्टः पुत्रदारार्थमुद्यतः ।\nकृत्वा कार्यमकार्यं वा पुष्टिमेषां प्रयच्छति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2186208, "chapter_id": 4953, "verse_number": "१८", "content_sanskrit": "तं पुत्रपशुसम्मत्तं व्यासक्तमनसं नरम् ।\nसुप्तं व्याघ्रं महौघो वा मृत्युरादाय गच्छति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2186209, "chapter_id": 4953, "verse_number": "१९", "content_sanskrit": "सञ्चिन्वानकमेवैकं कामानामवितृप्तकम् ।\nव्याघ्रः पशुमिवादाय मृत्युरादाय गच्छति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2186210, "chapter_id": 4953, "verse_number": "२०", "content_sanskrit": "इदं कृतमिदं कार्यमिदमन्यत्कृताकृतम् ।\nएवमीहासुखासक्तं कृतान्तः कुरुते वशे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2186211, "chapter_id": 4953, "verse_number": "२१", "content_sanskrit": "कृतानां फलमप्राप्तं कर्मणां फलसङ्गिनम् ।\nक्षेत्रापणगृहासक्तं मृत्युरादाय गच्छति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2186212, "chapter_id": 4953, "verse_number": "२२", "content_sanskrit": "दुर्बलं बलवन्तं च शूरं भीरुं जडं कविम् ।\nअप्राप्तसर्वकामार्थं मृत्युरादाय गच्छति \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2186213, "chapter_id": 4953, "verse_number": "२३", "content_sanskrit": "मृत्युर्जरा च व्याधिश्च दुःखं चानेककारणम् ।\nअनुषक्तं यदा देहे किं स्वस्थ इव तिष्ठसि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2186214, "chapter_id": 4953, "verse_number": "२४", "content_sanskrit": "इदं मे स्यादिदं मे स्यादित्येवंमनसो नरान् ।\nअनवाप्तेषु कामेषु कृतान्तः कुरुते वशे \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2186215, "chapter_id": 4953, "verse_number": "२५", "content_sanskrit": "जातमेवान्तकोऽन्ताय जरा चान्वेति देहिनम् ।\nअनुषक्ता द्वयेनैते भावाः स्थावरजङ्गमाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2186216, "chapter_id": 4953, "verse_number": "२६", "content_sanskrit": "मृत्योर्वा गृहमेवैतद्या ग्रामे वसतो रतिः ।\nदेवानामेष वै गोष्ठो यदरण्यमिति श्रुतिः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2186217, "chapter_id": 4953, "verse_number": "२७", "content_sanskrit": "निबन्धनी रज्जुरेषा या ग्रामे वसतो रतिः ।\nछित्त्वैनां सुकृतो यान्ति नैनां छिन्दन्ति दुष्कृतः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2186218, "chapter_id": 4953, "verse_number": "२८", "content_sanskrit": "न हिंसयति यः प्राणान्मनोवाक्कायहेतुभिः ।\nजीवितार्थापनयनैः कर्मभिर्न स बध्यते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2186219, "chapter_id": 4953, "verse_number": "२९", "content_sanskrit": "न मृत्युसेनामायान्तीं जातु कश्चित् प्रबाधते ।\nऋते सत्यमसन्त्याज्यं सत्ये ह्यमृतमाश्रितम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2186220, "chapter_id": 4953, "verse_number": "३०", "content_sanskrit": "तस्मात् सत्यव्रताचारः सत्ययोगपरायणः ।\nसत्यारामः समो दान्तः सत्येनैवान्तकं जयेत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2186221, "chapter_id": 4953, "verse_number": "३१", "content_sanskrit": "अमृतं चैव मृत्युश्च द्वयं देहे प्रतिष्ठितम् ।\nमृत्युमापद्यते मोहात् सत्येनापद्यतेऽमृतम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2186222, "chapter_id": 4953, "verse_number": "३२", "content_sanskrit": "सोऽहं ह्यहिंस्रः सत्यार्थी कामक्रोधबहिष्कृतः ।\nसमदुःखसुखः क्षेमी मृत्युं हास्याम्यमर्षवत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2186223, "chapter_id": 4953, "verse_number": "३३", "content_sanskrit": "शान्तियज्ञरतो दान्तो ब्रह्मयज्ञे स्थितो मुनिः ।\nवाङ्मनःकर्मयज्ञश्च भविष्याम्युदगायने\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2186224, "chapter_id": 4953, "verse_number": "३४", "content_sanskrit": "पशुयज्ञैः कथं हिंस्रैर्मादृशो यष्टुमर्हति ।\nअन्तवद्भिरुत प्राज्ञः क्षत्रयज्ञैः पिशाचवत्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2186225, "chapter_id": 4953, "verse_number": "३५", "content_sanskrit": "यस्य वाङ्मनसी स्यातां सम्यक्प्रणिहिते सदा ।\nतपस्त्यागश्च योगश्च स वै सर्वमवाप्नुयात्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2186226, "chapter_id": 4953, "verse_number": "३६", "content_sanskrit": "नास्ति विद्यासमं चक्षुर्नास्ति विद्यासमं बलम् ।\nनास्ति रागसमं दुःखं नास्ति त्यागसमं सुखम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2186227, "chapter_id": 4953, "verse_number": "३७", "content_sanskrit": "आत्मन्येवात्मना जात आत्मनिष्ठोऽप्रजोऽपि वा ।\nआत्मन्येव भविष्यामि न मां तारयति प्रजा\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2186228, "chapter_id": 4953, "verse_number": "३८", "content_sanskrit": "नैतादृशं ब्राह्मणस्यास्ति वित्तं\nयथैकता समता सत्यता च ।\nशीले स्थितिर्दण्डनिधानमार्जवं\nततस्ततश्चोपरमः क्रियाभ्यः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2186229, "chapter_id": 4953, "verse_number": "३९", "content_sanskrit": "किं ते धनैर्बान्धवैर्वापि किं ते\nकिं ते दारैर्ब्राह्मण यो मरिष्यसि ।\nआत्मानमन्विच्छ गुहां प्रविष्टं\nपितामहस्ते क्व गतः पिता च\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2186230, "chapter_id": 4953, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2186231, "chapter_id": 4953, "verse_number": "४०", "content_sanskrit": "पुत्रस्यैतद्वचः श्रुत्वा तथाकार्षीत् पिता नृप ।\nतथा त्वमपि वर्तस्व सत्यधर्मपरायणः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2186232, "chapter_id": 4953, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे द्वितीयोऽध्यायः ॥२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]