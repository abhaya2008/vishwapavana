[{"id": 7000713000, "chapter_id": 20713, "verse_number": "६-५६-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nभाद्रस्य कृष्णपक्षे तु किंनामैकादशीभवेत् ।\nएतदिच्छाम्यहं श्रोतुं कथयस्व जनार्दन ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000713001, "chapter_id": 20713, "verse_number": "६-५६-२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nशृणुष्वैकमना राजन्कथयिष्यामि विस्तरात् ।\nअजेति नामतः प्रोक्ता सर्वपापप्रणाशिनी ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000713002, "chapter_id": 20713, "verse_number": "६-५६-३", "content_sanskrit": "पूजयित्वा हृषीकेशं व्रतमस्यां करोति यः ।\nपापानि तस्य नश्यंति व्रतस्य श्रवणादपि ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000713003, "chapter_id": 20713, "verse_number": "६-५६-४", "content_sanskrit": "नातः परतरा राजन्लोकद्वयहिताय वै ।\nसत्यमुक्तं मया ह्येतन्नासत्यं मम भाषितम् ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000713004, "chapter_id": 20713, "verse_number": "६-५६-५", "content_sanskrit": "हरिश्चन्द्र इति ख्यातो बभूव नृपतिः पुरा ।\nचक्रवर्ती सत्यसंधः समस्ताया भुवः पतिः ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000713005, "chapter_id": 20713, "verse_number": "६-५६-६", "content_sanskrit": "कस्यापि कर्मणः प्राप्तौ राज्यभ्रष्टो बभूव सः ।\nविक्रीतौ वनितापुत्रौ स चकारात्मविक्रयम् ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000713006, "chapter_id": 20713, "verse_number": "६-५६-७", "content_sanskrit": "पुल्कसस्य च दासत्वं गतो राजा स पुण्यकृत् ।\nसत्यमालंब्य राजेंद्र मृतचैलापहारकः ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000713007, "chapter_id": 20713, "verse_number": "६-५६-८", "content_sanskrit": "सोऽभवन्नृपतिश्रेष्ठो न सत्याच्चलितस्तथा ।\nएवं च तस्य नृपतेर्बहवो वत्सरा गताः ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000713008, "chapter_id": 20713, "verse_number": "६-५६-९", "content_sanskrit": "ततश्चिंतापरो राजा स बभूवातिदुःखितः ।\nकिं करोमि क्व गच्छामि निष्कृतिर्मे कथं भवेत् ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000713009, "chapter_id": 20713, "verse_number": "६-५६-१०", "content_sanskrit": "इति चिंतयतस्तस्य मग्नस्य वृजिनार्णवे ।\nआजगाम मुनिः कश्चिज्ज्ञात्वा राजानमातुरम् ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000713010, "chapter_id": 20713, "verse_number": "६-५६-११", "content_sanskrit": "परोपकारणार्थाय निर्मिता ब्रह्मणा द्विजाः ।\nस तं दृष्ट्वा द्विजवरं ननाम नृपसत्तमः ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000713011, "chapter_id": 20713, "verse_number": "६-५६-१२", "content_sanskrit": "कृतांजलिपुटो भूत्वा गौतमस्याग्रतः स्थितः ।\nकथयामास वृत्तांतमात्मनो दुःखसंयुतम् ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000713012, "chapter_id": 20713, "verse_number": "६-५६-१३", "content_sanskrit": "श्रुत्वा नृपतिवाक्यानि गौतमो विस्मयान्वितः ।\nउपदेशं नृपतये व्रतस्यास्य ददौ मुनिः ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000713013, "chapter_id": 20713, "verse_number": "६-५६-१४", "content_sanskrit": "मासि भाद्रपदे राजन्कृष्णपक्षेति शोभना ।\nएकादशी समायाता अजा नामेति पुण्यदा ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000713014, "chapter_id": 20713, "verse_number": "६-५६-१५", "content_sanskrit": "अस्याः कुरु व्रतं राजन्पापस्यांतो भविष्यति ।\nतव भाग्यवशादेषा सप्तमेऽह्नि समागता ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000713015, "chapter_id": 20713, "verse_number": "६-५६-१६", "content_sanskrit": "उपवासपरो भूत्वा रात्रौ जागरणं कुरु ।\nएवमस्या व्रते चीर्णे तव पापक्षयो ध्रुवम् ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000713016, "chapter_id": 20713, "verse_number": "६-५६-१७", "content_sanskrit": "तव पुण्यप्रभावेण चागतोऽहं नृपोत्तम ।\nइत्येवं कथयित्वा च मुनिरंतरधीयत ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000713017, "chapter_id": 20713, "verse_number": "६-५६-१८", "content_sanskrit": "मुनिवाक्यं नृपः श्रुत्वा चकार व्रतमुत्तमम् ।\nकृते तस्मिन्व्रते राज्ञः पापस्यांतोऽभवत्क्षणात् ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000713018, "chapter_id": 20713, "verse_number": "६-५६-१९", "content_sanskrit": "श्रूयतां राजशार्दूल प्रभावोऽस्य व्रतस्य च ।\nयद्दुःखंबहुभिर्वर्षैर्भोक्तव्यंतत्क्षयोभवेत् ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000713019, "chapter_id": 20713, "verse_number": "६-५६-२०", "content_sanskrit": "निस्तीर्णदुःखो राजासीद्व्रतस्यास्य प्रभावतः ।\nपत्न्या सह समायोगं पुत्रजीवनमाप सः ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000713020, "chapter_id": 20713, "verse_number": "६-५६-२१", "content_sanskrit": "दिवि दुंदुभयो नेदुः पुष्पवर्षमभूद्दिवः ।\nएकादश्याः प्रभावेन प्राप्यराज्यमकंटकम् ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000713021, "chapter_id": 20713, "verse_number": "६-५६-२२", "content_sanskrit": "स्वर्गं लेभे हरिश्चंद्रः सपुरः सपरिच्छदः ।\nईदृग्विधं व्रतंराजन्ये कुर्वंति च मानवाः ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000713022, "chapter_id": 20713, "verse_number": "६-५६-२३", "content_sanskrit": "सर्वपापविनिर्मुक्तास्त्रिदिवं यांति ते नृप ।\nपठनाच्छ्रवणाद्वापि अश्वमेधफलं लभेत् ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]