[{"id": 7003783000, "chapter_id": 23783, "verse_number": "२-२-२७-१", "content_sanskrit": "जैमिनिरुवाच ।\nअथांतरिक्षान्निःश्रेणी रत्नकांचननिर्मिता ।\nसंलग्ना पादसंपीठे पद्मयोनेर्विमानगा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003783001, "chapter_id": 23783, "verse_number": "२-२-२७-२", "content_sanskrit": "सा क्षितिस्पृष्टमूला वै विधातुरवरोहणे ।\nचतुर्व्यायामतापीन सोपानश्रेणिसंयुता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003783002, "chapter_id": 23783, "verse_number": "२-२-२७-३", "content_sanskrit": "रथप्रासादयोर्मध्ये शक्रचाप इवांशुमान् ।\nआविर्बभूव सहसा साद्भुतं वीक्षितो जनैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003783003, "chapter_id": 23783, "verse_number": "२-२-२७-४", "content_sanskrit": "ततो गंधर्वराजैस्तु रत्नवेत्रकरैर्द्विजाः ।\nएष पंथाः प्रभो ह्येहि इत्यादेशितमार्गकैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003783004, "chapter_id": 23783, "verse_number": "२-२-२७-५", "content_sanskrit": "दुर्वाससो नारदस्य करयोर्दत्तहस्तकः ।\nसोपानैरवतीर्णोऽथ पुनानश्चक्षुषा जगत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003783005, "chapter_id": 23783, "verse_number": "२-२-२७-६", "content_sanskrit": "स्मयमानो रथान्दृष्ट्वा प्रासादं समलंकृतम् ।\nदिगंतव्यापिनीं शालां रत्नस्तंभोपशोभिताम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003783006, "chapter_id": 23783, "verse_number": "२-२-२७-७", "content_sanskrit": "शक्रस्याप्यद्भुतकरी सर्वसंभारसंभृताम् ।\nअवातरद्विमानात्स देवब्रह्मर्षिराजभिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003783007, "chapter_id": 23783, "verse_number": "२-२-२७-८", "content_sanskrit": "किरीटदत्तांजलिभिः स्तूयमानः समंततः ।\nकटाक्षेणानुगृह्णाति यां दिशं स पितामहः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003783008, "chapter_id": 23783, "verse_number": "२-२-२७-९", "content_sanskrit": "तत्रांजलीनां संमर्दाः कोटयः शिरसा धृताः ।\nपादाब्ज प्रणतं दृष्ट्वा इंद्रद्युम्नं प्रजापतिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003783009, "chapter_id": 23783, "verse_number": "२-२-२७-१०", "content_sanskrit": "उवाच प्रश्रयगिरा स्मितभिन्नोष्ठसंपुटः ।\nअंगुल्या निर्दिशन्देवान्पितॄन्ब्रह्मर्षितापसान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003783010, "chapter_id": 23783, "verse_number": "२-२-२७-११", "content_sanskrit": "सिद्धविद्याधरान्यक्षगंधर्वाप्सरसस्तथा ।\nएकत्र मिलितान्सर्वान्युगपन्मोदनिर्भरान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003783011, "chapter_id": 23783, "verse_number": "२-२-२७-१२", "content_sanskrit": "पश्येंद्रद्युम्न भाग्यं ते सर्वलोकवशीकरम् ।\nत्वदर्थमेकदा सर्वे मां पुरस्कृत्य संगताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003783012, "chapter_id": 23783, "verse_number": "२-२-२७-१३", "content_sanskrit": "इत्युक्त्वा प्रययौ शीघ्रं नारायणरथं ततः ।\nप्रणिपत्य जगन्नाथं त्रिः परीत्य पितामहः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003783013, "chapter_id": 23783, "verse_number": "२-२-२७-१४", "content_sanskrit": "आनंदसिंधुसंमग्नः सरोमांचवपुः स्वयम् ।\nस्वमात्मानं नुनावाथ प्रत्यक्षं स्वरगद्गदम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003783014, "chapter_id": 23783, "verse_number": "२-२-२७-१५", "content_sanskrit": "ब्रह्मोवाच ।\nनमस्तुभ्यं नमो मह्यं तुभ्यं मह्यं नमोनमः ।\nअहं त्वं त्वमहं सर्वं जगदेतच्चराचरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003783015, "chapter_id": 23783, "verse_number": "२-२-२७-१६", "content_sanskrit": "महदादि जगत्सर्वं मायाविलसितं तव ।\nअध्यस्तं त्वयि विश्वात्मंस्त्वयैव परिणामितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003783016, "chapter_id": 23783, "verse_number": "२-२-२७-१७", "content_sanskrit": "यदेतदखिलाभासं तत्त्वदज्ञानसंभवम् ।\nज्ञाते त्वयि विलीयेत रज्जुसर्पादिबोधवत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003783017, "chapter_id": 23783, "verse_number": "२-२-२७-१८", "content_sanskrit": "अनिर्वक्तव्यमेवेदं सत्त्वात्सत्त्वविवेकतः ।\nअद्वितीय जगद्भास स्वप्रकाश नमोऽस्तु ते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003783018, "chapter_id": 23783, "verse_number": "२-२-२७-१९", "content_sanskrit": "विषयानंदमखिलं सहजानंदरूपिणः ।\nअंशं तवोपजीवंति येन जीवंति जंतवः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003783019, "chapter_id": 23783, "verse_number": "२-२-२७-२०", "content_sanskrit": "निष्प्रपंच निराकार निर्विकार निराश्रय ।\nस्थूलसूक्ष्माणुमहिमन्स्थौल्यसूक्ष्मविवर्जित ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003783020, "chapter_id": 23783, "verse_number": "२-२-२७-२१", "content_sanskrit": "गुणातीत गुणाधार त्रिगुणात्मन्नमोऽस्तु ते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003783021, "chapter_id": 23783, "verse_number": "२-२-२७-२२", "content_sanskrit": "त्वन्मायया मोहितोऽहं सृष्टिमात्रपरायणः ।\nअद्यापि न लभे शर्म अंतर्य्यामिन्नमोस्तु ते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003783022, "chapter_id": 23783, "verse_number": "२-२-२७-२३", "content_sanskrit": "त्वन्नाभिपंकजाज्जातो नित्यं तत्रैव संस्तुवन् ।\nनातिक्रमितुमीशोऽस्मि मायां ते कोऽन्य ईश्वरः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003783023, "chapter_id": 23783, "verse_number": "२-२-२७-२४", "content_sanskrit": "अहं यथांडमध्येऽस्मिन्रचितः सृष्टिकर्मणि ।\nतथानुलोमकलिता ब्रह्मांडे ब्रह्मकोटयः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003783024, "chapter_id": 23783, "verse_number": "२-२-२७-२५", "content_sanskrit": "सार्द्धत्रिकोटिसंख्यानां विरिंचीनामपि प्रभो ।\nनैकोऽपि तत्त्वतो वेत्ति यथाहं त्वत्पुरः स्थितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003783025, "chapter_id": 23783, "verse_number": "२-२-२७-२६", "content_sanskrit": "नमोचिंत्यमहिम्ने ते चिद्रूपाय नमोनमः ।\nनमो देवाधिदेवाय देवदेवाय ते नमः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003783026, "chapter_id": 23783, "verse_number": "२-२-२७-२७", "content_sanskrit": "दिव्यादिव्यस्वरूपाय दिव्यरूपाय ते नमः ।\nजरामृत्युविहीनाय मृत्युरूपाय ते नमः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003783027, "chapter_id": 23783, "verse_number": "२-२-२७-२८", "content_sanskrit": "ज्वलदग्निस्वरूपाय मृत्योरपि च मृत्यवे ।\nप्रपन्नमृत्युन शाय सहजानंदरूपिणे ।\nभक्तिप्रियाय जगतां मात्रे पित्रे नमो नमः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003783028, "chapter_id": 23783, "verse_number": "२-२-२७-२९", "content_sanskrit": "प्रणतार्तिविनाशाय नित्योद्योगिन्नमोऽस्तु ते ।\nनमोनमस्ते दीनानां कृपासहजसिंधवे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003783029, "chapter_id": 23783, "verse_number": "२-२-२७-३०", "content_sanskrit": "पराय पररूपाय परंपाराय ते नमः ।\nअपारपारभूताय ब्रह्मरूपाय ते नमः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003783030, "chapter_id": 23783, "verse_number": "२-२-२७-३१", "content_sanskrit": "परमार्थस्वरूपाय नमस्ते परहेतवे ।\nपरंपरा परिव्याप्त परतत्त्वपराय ते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003783031, "chapter_id": 23783, "verse_number": "२-२-२७-३२", "content_sanskrit": "प्रणतार्तिविनाशाय नमः स्वात्मैकभानवे ।\nपुरा यत्प्रार्थितं स्वास्मिन्सृष्टिभारावतारणे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003783032, "chapter_id": 23783, "verse_number": "२-२-२७-३३", "content_sanskrit": "तत्कुरुष्व जगन्नाथ सहजाक्तदरूपभाक् ।\nत्वयि प्रसन्ने किं नाथ दुर्लभं मयि विद्यते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003783033, "chapter_id": 23783, "verse_number": "२-२-२७-३४", "content_sanskrit": "त्वयैवाहं पृथग्लीलाभेदाद्भिन्नः कृपांबुधे ।\nअज्ञानतिमिरच्छन्ने जगत्कारागृहांतरे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003783034, "chapter_id": 23783, "verse_number": "२-२-२७-३५", "content_sanskrit": "भ्राम्यन्न द्वारमाप्नोति त्वामृते मुक्तिहेतवे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003783035, "chapter_id": 23783, "verse_number": "२-२-२७-३६", "content_sanskrit": "नमोनमस्ते जगदेकवन्द्य सुरासुराभ्यर्चितपादपद्म ।\nनमोनमस्तापहरैकचंद्र नमोनमः शर्मसुबोधसांद्र ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003783036, "chapter_id": 23783, "verse_number": "२-२-२७-३७", "content_sanskrit": "नमो नमः कल्पकदूरभूत दुष्प्राप्यकामप्रद कल्पवृक्ष ।\nदीनाशरण्यप्रणतैकदुःखसंघोद्धृतौ नित्यसुबद्धपक्ष ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003783037, "chapter_id": 23783, "verse_number": "२-२-२७-३८", "content_sanskrit": "प्रसीद जगतां नाथ मग्नानां दुःखसागरे ।\nकटाक्षलीलापातेन त्रायस्व करुणाकर ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003783038, "chapter_id": 23783, "verse_number": "२-२-२७-३९", "content_sanskrit": "स्तुत्वेत्थं श्रीजगन्नाथं वेदार्थः स पितामहः ।\nजगाम सीरिणं द्रष्टुमवतीर्णं धराधरम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003783039, "chapter_id": 23783, "verse_number": "२-२-२७-४०", "content_sanskrit": "प्रणम्य परया भक्त्या तुष्टाव बलिनं मुदा ।\nनभः शिरस्ते देवेश आपस्ते विग्रहः प्रभो ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003783040, "chapter_id": 23783, "verse_number": "२-२-२७-४१", "content_sanskrit": "पादौ क्षितिर्मुखं वह्निः श्वसितानि समीरणः ।\nमनस्ते ह्योषधीनाथश्चक्षुषी ते दिवाकरः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003783041, "chapter_id": 23783, "verse_number": "२-२-२७-४२", "content_sanskrit": "बाहवः ककुभो नाथ नमस्ते ज्ञानदर्पण ।\nचतुर्दशानां लोकानां मूलस्तंभाय सीरिणे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003783042, "chapter_id": 23783, "verse_number": "२-२-२७-४३", "content_sanskrit": "पदांभोजप्रपन्नानां नमः पापौघदारिणे ।\nअनन्तवक्त्रनयनश्रोत्रपादाक्षिबाहवे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003783043, "chapter_id": 23783, "verse_number": "२-२-२७-४४", "content_sanskrit": "नमो नादिमहामूलतमःस्तोमौघभानवे ।\nत्रयीमय त्रिधादोषनाशाय त्र्यवतारिणे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003783044, "chapter_id": 23783, "verse_number": "२-२-२७-४५", "content_sanskrit": "फणामणिफणाकार क्षितिमण्डलधारिणे ।\nनमः कालाग्निरुद्राय महारुद्राय ते नमः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003783045, "chapter_id": 23783, "verse_number": "२-२-२७-४६", "content_sanskrit": "भोगतल्पफणाच्छत्रमध्यसुप्ताय ते नमः ।\nमहार्णवजले वृद्ध एकीभूते जगत्त्रये ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003783046, "chapter_id": 23783, "verse_number": "२-२-२७-४७", "content_sanskrit": "त्वमेव शेषो भगवन्सहस्रफणमंडितः ।\nफणामणिगणव्याजसंभृताखिलभौतिकः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003783047, "chapter_id": 23783, "verse_number": "२-२-२७-४८", "content_sanskrit": "त्वमेव नाथः सर्वेषां स्रष्टा पालयिता विभो ।\nअत्ता धारयिता नित्यं मदाद्यास्त्वन्निमित्तकाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003783048, "chapter_id": 23783, "verse_number": "२-२-२७-४९", "content_sanskrit": "एष नारायणो देवो वेदांतेषूपगीयते ।\nत्वत्तो न भिन्नो भगवन्कारणाद्भेदभागसि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003783049, "chapter_id": 23783, "verse_number": "२-२-२७-५०", "content_sanskrit": "शय्या त्वं शयिता ह्येष छाद्यः संछादको भवान् ।\nयो वै विष्णुः स वै रामो यो रामः कृष्ण एव सः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003783050, "chapter_id": 23783, "verse_number": "२-२-२७-५१", "content_sanskrit": "युवयोरंतरं नास्ति प्रसीद त्वं जगन्मय ।\nइति स्तवांते बलिनं प्रणम्य परमेश्वरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003783051, "chapter_id": 23783, "verse_number": "२-२-२७-५२", "content_sanskrit": "ईश्वरीं जगतां द्रष्टुं सुभद्रास्यन्दनं ययौ ।\nजय देवि जगन्मातः प्रसीद परमेश्वरि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003783052, "chapter_id": 23783, "verse_number": "२-२-२७-५३", "content_sanskrit": "कार्यकारणकर्त्री त्वं सर्वशक्त्यै नमोऽस्तु ते ।\nसर्वस्य हृदि संविष्टे ज्ञानमोहात्मिके सदा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003783053, "chapter_id": 23783, "verse_number": "२-२-२७-५४", "content_sanskrit": "कैवल्यमुक्तिदे भद्रे त्वां नमामि सुरारणिम् ।\nदेवि त्वं विष्णुमायासि मोहयन्ती चराचरम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003783054, "chapter_id": 23783, "verse_number": "२-२-२७-५५", "content_sanskrit": "हृत्पद्मासनसंस्थासि विष्णुभावानुसारिणी ।\nत्वमेव लक्ष्मीर्गौरी च शची कात्यायनी तथा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003783055, "chapter_id": 23783, "verse_number": "२-२-२७-५६", "content_sanskrit": "यच्च किंचित्क्वचिद्वस्तु सदसद्वाखिलात्मिके ।\nतस्य सर्वस्य शक्तिस्त्वं स्तोतुं त्वां कस्तु शक्तिमान् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003783056, "chapter_id": 23783, "verse_number": "२-२-२७-५७", "content_sanskrit": "जय भद्रे सुभद्रे त्वं सर्वेषां भद्रदायिनि ।\nभद्राभद्रस्वरूपे त्वं भद्रकालि नमोऽस्तु ते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003783057, "chapter_id": 23783, "verse_number": "२-२-२७-५८", "content_sanskrit": "त्वं माता जगतां देवि पिता नारायणो हि सः ।\nस्त्रीरूपं त्वं सर्वमेव पुंरूपो जगदीश्वरः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003783058, "chapter_id": 23783, "verse_number": "२-२-२७-५९", "content_sanskrit": "युवयोर्न हि भेदोऽस्ति नास्त्यन्यत्परमेव हि ।\nयथा वयं नियुक्ता हि त्वया वै विष्णुमायया ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003783059, "chapter_id": 23783, "verse_number": "२-२-२७-६०", "content_sanskrit": "निदेशकारिणो नित्यं भ्रमामः परमेश्वरि ।\nवृत्तिः प्रवृत्तिः परमा क्षुधा निद्रा त्वमेव च ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003783060, "chapter_id": 23783, "verse_number": "२-२-२७-६१", "content_sanskrit": "आशा त्वमाशापूर्णा च सर्वाशा परिपूरिका ।\nमुक्तिहेतुस्त्वमेवेशि बंधहेतुस्त्वमेह हि ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003783061, "chapter_id": 23783, "verse_number": "२-२-२७-६२", "content_sanskrit": "सर्वज्ञानप्रदे नित्ये भक्तानां कल्पवल्लरी ।\nत्राहि पादाब्जनम्रं मां कृपापांगविलोकनैः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003783062, "chapter_id": 23783, "verse_number": "२-२-२७-६३", "content_sanskrit": "स्तुत्वेत्थं भद्ररूपां तां तत्समीपस्थितं रथे ।\nचक्रं सुदर्शनं विष्णोश्चतुर्थं वपुरास्थितम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003783063, "chapter_id": 23783, "verse_number": "२-२-२७-६४", "content_sanskrit": "प्रणम्य परया भक्त्या इमां स्तुतिमुदाहरत् ।\nसुदर्शन महाज्वाल कोटिसूर्यसमप्रभ ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003783064, "chapter_id": 23783, "verse_number": "२-२-२७-६५", "content_sanskrit": "अज्ञानतिमिरांधानां वैकुण्ठाध्वप्रदर्शकः ।\nनमस्ते नित्यविलसद्वैष्णवस्वनिकेतन ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003783065, "chapter_id": 23783, "verse_number": "२-२-२७-६६", "content_sanskrit": "अवार्यवीर्यं यद्रूपं विष्णोस्तत्प्रणमाम्यहम् ।\nप्रणम्य स्तुत्वा देवान्स रथेभ्यः परिवृत्य च ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003783066, "chapter_id": 23783, "verse_number": "२-२-२७-६७", "content_sanskrit": "इन्द्रद्युम्ननारदाभ्यामादिष्टपदपद्धतिः ।\nनीलाचलमथारोहत्प्रासादं द्रष्टुमुत्सुकः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003783067, "chapter_id": 23783, "verse_number": "२-२-२७-६८", "content_sanskrit": "ततः स गत्वा प्रासादसमीपं दैवतैः सह ।\nददर्श शालांरुचिरां स्वचित्ताभिमता द्विजाः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003783068, "chapter_id": 23783, "verse_number": "२-२-२७-६९", "content_sanskrit": "तन्मध्ये स्थापयामास दैवतोरगभूपतीन् ।\nब्रह्मर्षीन्योगिनो विप्रान्वैष्णवांश्च तपस्विनः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003783069, "chapter_id": 23783, "verse_number": "२-२-२७-७०", "content_sanskrit": "दिव्यसिंहासनवरे नृपेण प्रतिपादिते ।\nस पादपीठे भगवानुपविष्टः स्वयं विभुः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003783070, "chapter_id": 23783, "verse_number": "२-२-२७-७१", "content_sanskrit": "शांतिकं पौष्टिकं कर्तुं भारद्वाजं महामुनिम् ।\nपितामहाज्ञया भूपो वरयामास ऋद्धिमत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003783071, "chapter_id": 23783, "verse_number": "२-२-२७-७२", "content_sanskrit": "प्रतिष्ठायां तु ये देवा बलिपूजाविधौ मताः ।\nहोमेषु च तथा ते वै ध्यानरूपमुपाश्रिताः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003783072, "chapter_id": 23783, "verse_number": "२-२-२७-७३", "content_sanskrit": "आज्ञया पद्मयोनेस्तु चतुर्दिग्भागमाश्रिताः ।\nसुपूजिता गंधपुष्पमालालंकारभूषणैः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003783073, "chapter_id": 23783, "verse_number": "२-२-२७-७४", "content_sanskrit": "ततः कर्म प्रववृते भारद्वाजेन धीमता ।\nप्रत्यक्षं देवदेवस्य सर्वेषां च दिवौकसाम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003783074, "chapter_id": 23783, "verse_number": "२-२-२७-७५", "content_sanskrit": "त्रैलोक्यवासिनां पूजां चकार नृपतिर्मुदा ।\nसांगोपांगं समभ्यर्च्य जगत्स्रष्टारमग्रतः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003783075, "chapter_id": 23783, "verse_number": "२-२-२७-७६", "content_sanskrit": "ततः संपूजिताः सर्वे तेन त्रैलोक्यवासिनः ।\nपश्यन्तोऽवस्थितं मध्ये साक्षाद्ब्रह्माणमव्ययम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003783076, "chapter_id": 23783, "verse_number": "२-२-२७-७७", "content_sanskrit": "वपुष्मंतं जगन्नाथं प्रत्यक्षं ब्रह्मरूपिणम् ।\nइन्द्रद्युम्नप्रसादेन जीवन्मुक्तत्वमाप्नुवन् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003783077, "chapter_id": 23783, "verse_number": "२-२-२७-७८", "content_sanskrit": "कलेवरं भगवतः प्रासादं सुमनोहरम् ।\nप्रतिष्ठाय भरद्वाजः समुच्छ्रितमहाध्वजम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003783078, "chapter_id": 23783, "verse_number": "२-२-२७-७९", "content_sanskrit": "व्यज्ञापयतत्प्रतिष्ठायै जीवस्याथ पितामहम् ।\nसमुत्तस्थौ ततो ब्रह्मा कृतस्वस्त्ययनः स्वयम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003783079, "chapter_id": 23783, "verse_number": "२-२-२७-८०", "content_sanskrit": "ऋषिभिर्नारदाद्यैश्च विद्वद्भिर्ब्राह्मणैस्तथा ।\nराजभिः क्षत्रियैर्नागैः सहितः परमर्षिभिः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003783080, "chapter_id": 23783, "verse_number": "२-२-२७-८१", "content_sanskrit": "गन्धर्वैर्गायमानेषु दिव्यगानेषु सुस्वरम् ।\nमांगल्योचितरागेषु नृत्यन्तीष्वप्सरःसु च ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003783081, "chapter_id": 23783, "verse_number": "२-२-२७-८२", "content_sanskrit": "शाकुनेषु च सूक्तेषु पठ्यमानेषु च द्विजैः ।\nशंखकाहालमुरजभेरीवादित्रवैणवे ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003783082, "chapter_id": 23783, "verse_number": "२-२-२७-८३", "content_sanskrit": "शब्दे प्रमूर्च्छति ततः सर्वे ते स्यन्दनोपरि ।\nगत्वावतारयामासू रथात्सोपानवर्त्मनि ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003783083, "chapter_id": 23783, "verse_number": "२-२-२७-८४", "content_sanskrit": "सावधानाः समाधिस्था भक्त्या संयमितात्मकाः ।\nपार्श्वयोर्भुजयोर्मूर्ध्नि पादयोर्न्यस्तपाणयः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003783084, "chapter_id": 23783, "verse_number": "२-२-२७-८५", "content_sanskrit": "शनैः शनैः सलीलं ते नारायणमनामयम् ।\nवासं वासं तूलिकासु निन्युः प्रासादसन्निधिम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003783085, "chapter_id": 23783, "verse_number": "२-२-२७-८६", "content_sanskrit": "उपर्युपरि संतानवृष्टिपूत्पतितासु च ।\nजय कृष्ण जगन्नाथ जय सर्वाऽघनाशन ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003783086, "chapter_id": 23783, "verse_number": "२-२-२७-८७", "content_sanskrit": "जय लीलादारुतनो जय वांछाफलप्रद ।\nजय संसारसंमग्नलीलोद्धार जयाव्यय ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003783087, "chapter_id": 23783, "verse_number": "२-२-२७-८८", "content_sanskrit": "जयानुकंपापाथोधे जय दीनपरायण ।\nजयाच्युत जयानन्त जयेशान नमोऽस्तु ते ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003783088, "chapter_id": 23783, "verse_number": "२-२-२७-८९", "content_sanskrit": "एभिः स्तवैः स्तूयमानो ब्रह्मणा च स्वयंभुवा ।\nतुष्टाव स मुदा युक्तो नारदश्चोपवीणयन् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003783089, "chapter_id": 23783, "verse_number": "२-२-२७-९०", "content_sanskrit": "रत्नच्छत्रयुगे मूर्ध्नि धार्यमाणेऽथ पृष्ठतः ।\nशशिना भास्वता भक्त्या दिव्यधूपेन धूपिता ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003783090, "chapter_id": 23783, "verse_number": "२-२-२७-९१", "content_sanskrit": "श्रेणीकृता ह्युभयतः पार्श्वयोश्चामरग्रहाः ।\nसलीलांदोलनव्यग्रा यौवनालंकृतास्तथा ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003783091, "chapter_id": 23783, "verse_number": "२-२-२७-९२", "content_sanskrit": "एवं च सहिताः सर्वे कौतूहलसमन्विताः ।\nसुदर्शनं सुभद्रां च बलभद्रमनैषिषुः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003783092, "chapter_id": 23783, "verse_number": "२-२-२७-९३", "content_sanskrit": "प्रासादद्वारि रचिते रत्नस्तंभेऽथ मण्डपे ।\nवासयित्वाभिषेकाय संमुखादर्शमण्डले ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003783093, "chapter_id": 23783, "verse_number": "२-२-२७-९४", "content_sanskrit": "अधिवासितै रत्नकुंभैस्तीर्थवार्युपसंभृतैः ।\nसूक्ताभ्यां श्रीपुरुषयोरभिषेकं पितामहः ।\nचकार भगवांल्लोकसंग्रहार्थं द्विजोत्तमाः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003783094, "chapter_id": 23783, "verse_number": "२-२-२७-९५", "content_sanskrit": "ततो ह्यलंकृतान्देवान्गंधमाल्योपशोभितान् ।\nनीराजयित्वा भगवान्स स्वयं लोकभावनः ।\nरत्नसिंहासने रम्ये स्थापयामास मन्त्रतः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003783095, "chapter_id": 23783, "verse_number": "२-२-२७-९६", "content_sanskrit": "ब्रह्मोवाच ।\nअशेषजगदाधार सर्वलोकप्रतिष्ठित ।\nसुप्रतिष्ठाखिलव्यापिन्प्रासादे सुस्थिरो भव ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003783096, "chapter_id": 23783, "verse_number": "२-२-२७-९७", "content_sanskrit": "त्वयि प्रतिष्ठिते नाथ वयं सर्वे प्रतिष्ठिताः ।\nत्वदाज्ञया प्रतिष्ठेयं पूर्णाऽस्तां त्वत्प्रसादतः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003783097, "chapter_id": 23783, "verse_number": "२-२-२७-९८", "content_sanskrit": "स्थापयित्वा जगन्नाथं स्पृष्ट्वा तस्य हृदंबुजम् ।\nआनुष्टुभं मंत्रराजं सहस्रं स जजाप ह ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003783098, "chapter_id": 23783, "verse_number": "२-२-२७-९९", "content_sanskrit": "वैशाखस्यामले पक्षे अष्टम्यां पुष्ययोगतः ।\nकृता प्रतिष्ठा भो विप्राः शोभने गुरुवासरे ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003783099, "chapter_id": 23783, "verse_number": "२-२-२७-१००", "content_sanskrit": "तद्दिनं सुमहत्पुण्यं सर्वपापप्रणाशनम् ।\nस्नानं दानं तपो होमः सर्वमक्षय्यमश्नुते ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003783100, "chapter_id": 23783, "verse_number": "२-२-२७-१०१", "content_sanskrit": "तस्मिन्दिने ये पश्यंति मानवा भक्तिभाविताः ।\nकृष्णं रामं सुभद्रां च मुक्तिभाजो न संशयः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003783101, "chapter_id": 23783, "verse_number": "२-२-२७-१०२", "content_sanskrit": "शुक्लाष्टमी या वैशाखे गुरुपुष्ययुता यदा ।\nतस्यामभ्यर्चनं विष्णोः कोटिजन्माघनाशनम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003783102, "chapter_id": 23783, "verse_number": "२-२-२७-१०३", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे पुरुषोत्तमक्षेत्रमाहात्म्ये सप्तविंशोऽध्यायः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}]