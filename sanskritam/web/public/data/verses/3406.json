[{"id": 2111189, "chapter_id": 3406, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2111190, "chapter_id": 3406, "verse_number": "१", "content_sanskrit": "स कदाचिन्महाबाहुः प्रभूतबलवाहनः ।\nवनं जगाम गहनं हयनागशतैर्वृतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2111191, "chapter_id": 3406, "verse_number": "२", "content_sanskrit": "खड्गचापधरैर्वीरैर्गदामुसलपाणिभिः ।\nप्रासतोमरहस्तैश्च ययौ योधगणैर्वृतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2111192, "chapter_id": 3406, "verse_number": "३", "content_sanskrit": "सिंहनादैश्च योधानां शङ्खदुन्दुभिनिस्वनैः ।\nरथनेमिनिनादैश्च सनागवरबृंहितैः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2111193, "chapter_id": 3406, "verse_number": "४", "content_sanskrit": "ह्रेषितस्वनमिश्रैश्च क्ष्वेडितास्फोटनिस्वनैः ।\nआसीत् किलकिलाशब्दः तस्मिन् गच्छति पार्थिवे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2111194, "chapter_id": 3406, "verse_number": "५", "content_sanskrit": "प्रासादवरशृङ्गस्था परया नृपशोभया ।\nददृशुस्तं स्त्रियस्तत्र नृपमात्मयशस्करम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2111195, "chapter_id": 3406, "verse_number": "६", "content_sanskrit": "शक्रोपमममित्रघ्नं परवारणवारणम् ।\nपश्यन्तः स्त्रीगणास्तत्र शक्तिपाणिं स्म मेनिरे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2111196, "chapter_id": 3406, "verse_number": "७", "content_sanskrit": "अयं स पुरुषव्याघ्रो रणेऽद्भुतपराक्रमः ।\nयस्य बाहुबलं प्राप्य न भवन्त्यसुहृद्गणाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2111197, "chapter_id": 3406, "verse_number": "समाप्तिः", "content_sanskrit": "इति वाचो ब्रुवन्त्यस्ताः स्त्रियः प्रेम्णा नराधिपम् ।\nतुष्टुवुः पुष्पवृष्टीश्च ससृजुस्तस्य मूर्धनि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2111198, "chapter_id": 3406, "verse_number": "९", "content_sanskrit": "स तत्र तत्र विप्रेन्द्रैः स्तूयमानः समन्ततः ।\nनिर्ययौ परया प्रीत्या वनं मृगजिघांसया\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2111199, "chapter_id": 3406, "verse_number": "१०", "content_sanskrit": "अदूरमनुजग्मुस्तं पौरजानपदास्तदा ।\nन्यवर्तन्त ततः पश्चादनुज्ञाता नृपेण ह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2111200, "chapter_id": 3406, "verse_number": "११", "content_sanskrit": "सौवर्णप्रतिमेनाथ रथेन वसुधाधिपः ।\nमहीमापूरयामास घोषेणेन्द्रो यथा दिवम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2111201, "chapter_id": 3406, "verse_number": "१२", "content_sanskrit": "स गच्छन् ददृशे श्रीमान् नन्दनप्रतिमं वनम् ।\nबिल्वार्कखदिराकीर्णं कपित्थवटसङ्कुलम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2111202, "chapter_id": 3406, "verse_number": "१३", "content_sanskrit": "विषमं पर्वतस्रस्तैरश्मभिश्च समावृतम् ।\nनिर्जरं निर्मनुष्यं च बहुयोजनमायतम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2111203, "chapter_id": 3406, "verse_number": "१४", "content_sanskrit": "मृगसङ्घैर्वृतं घोरैरन्यैश्चापि वनेचरैः ।\nतद् वनं मनुजव्याघ्रः सामात्यबलवाहनः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2111204, "chapter_id": 3406, "verse_number": "१५", "content_sanskrit": "लोळयामास दुष्षन्तः सूदयन् विविधान् मृगान् ।\nबाणगोचरसम्प्राप्तांस्तत्र व्याघ्रगणान् बहून् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2111205, "chapter_id": 3406, "verse_number": "१६", "content_sanskrit": "पातयामास दुष्षन्तो निर्बिभेद च सायकैः ।\nदूरस्थान् सायकैः कांश्चिदभिनत् स नराधिपः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2111206, "chapter_id": 3406, "verse_number": "१७", "content_sanskrit": "अभ्याशमागतांश्चान्यान् खड्गेन निरकृन्तत ।\nकांश्चिदेतान् स निर्जघ्ने शक्त्या शक्तिमतां वरः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2111207, "chapter_id": 3406, "verse_number": "१८", "content_sanskrit": "गदामण्डलतत्त्वज्ञश्चचारामितविक्रमः ।\nतोमरैरसिभिश्चापि गदामुसलकर्पणैः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2111208, "chapter_id": 3406, "verse_number": "१९", "content_sanskrit": "चचार निघ्नन् वन्यान् वै स्वैरचारान् वनद्विपान् ।\nराज्ञा चाद्भुतवीर्येण यौधैश्च समरप्रियैः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2111209, "chapter_id": 3406, "verse_number": "२०", "content_sanskrit": "लोड्यमानं महारण्यं तत्यजुश्च महामृगाः ।\nतत्र विद्रुतयूथानि हतयूथपतीनि च \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2111210, "chapter_id": 3406, "verse_number": "२१", "content_sanskrit": "मृगयूथान्यथौत्सुक्यात् शब्दं चक्रुरनेकशः ।\nशुष्कां चापि नदीं गत्वा जलनैराश्यदुःखिताः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2111211, "chapter_id": 3406, "verse_number": "२२", "content_sanskrit": "व्यायामक्लान्तहृदयाः पतन्ति स्म विचेतनाः ।\nक्षुत्पिपासापरीताश्च श्रान्ताश्च पतिता भुवि \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2111212, "chapter_id": 3406, "verse_number": "२३", "content_sanskrit": "केचित् तत्र नरव्याघ्रैरभक्ष्यन्त बुभुक्षितैः ।\nकेचिदग्निमथोत्पाद्य संसाध्य च वनेचराः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2111213, "chapter_id": 3406, "verse_number": "२४", "content_sanskrit": "भक्षयन्ति स्म मांसानि प्रकुट्य विधिवत् तदा ।\nतत्र केचिद् गजा मत्ता बलिनः शस्त्रविक्षताः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2111214, "chapter_id": 3406, "verse_number": "२५", "content_sanskrit": "सङ्कोच्याग्रकरान् भीताः प्राद्रवन्ति स्म वेगिताः।\nशकृन्मूत्रं सृजन्तश्च क्षरन्तः शोणितं बहु \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2111215, "chapter_id": 3406, "verse_number": "२६", "content_sanskrit": "वन्या गजवरास्तत्र ममृदुर्मनुजान् बहून् ।\nतद्वनं बलमेघेन शरधारेण संवृतम् ।\nव्यरोचत मृगाकीर्णं राज्ञा हतमृगाधिपम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2111216, "chapter_id": 3406, "verse_number": "३३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nपञ्चाशीतितमोऽध्यायः ॥८५॥ ॥ सम्भवपर्वणि त्रयस्त्रिंशोऽध्यायः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2111217, "chapter_id": 3406, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]