[{"id": 7000806000, "chapter_id": 20806, "verse_number": "६-१४९-१", "content_sanskrit": "महादेव उवाच ।\nतीर्थादस्मात्परं तीर्थं मालार्कांतरतः स्थितम् ।\nचंदनेश्वरमागच्छेदामोदस्थानमुत्तमम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000806001, "chapter_id": 20806, "verse_number": "६-१४९-२", "content_sanskrit": "दुःशासनस्य रुधिरं पीत्वा भीमो महाबलः ।\nप्रतिज्ञामात्मनः सर्वां पूरयित्वा सुदारुणाम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000806002, "chapter_id": 20806, "verse_number": "६-१४९-३", "content_sanskrit": "कराभ्यां रुधिराक्ताभ्यां द्रौपद्याः केशबंधनम् ।\nकृत्वा दत्त्वा द्विजातिभ्यो तीर्थयात्रां ततोऽगमत्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000806003, "chapter_id": 20806, "verse_number": "६-१४९-४", "content_sanskrit": "साभ्रमत्यास्तटे रम्ये गतो वै भ्रातृभिः सह ।\nआनीतः साभ्रमत्यां यः स्वर्गाच्चंदनपादपः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000806004, "chapter_id": 20806, "verse_number": "६-१४९-५", "content_sanskrit": "स तु लिंगतया जातः पुण्यतीर्थप्रभावतः ।\nतत्र स्नात्वा च पीत्वा च कृत्वा वै पितृतर्पणम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000806005, "chapter_id": 20806, "verse_number": "६-१४९-६", "content_sanskrit": "न नरो निरयं गच्छेद्रुद्रलोकमवाप्नुयात् ।\nचंदनेशं ततो दृष्ट्वा विश्वेशं लोकशंकरम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000806006, "chapter_id": 20806, "verse_number": "६-१४९-७", "content_sanskrit": "पूजयेच्च यथाशक्त्या यत्र गत्वा न शोचति ।\nयत्र कैवर्तको राजा पूजां कृत्वा ह्यनेकशः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000806007, "chapter_id": 20806, "verse_number": "६-१४९-८", "content_sanskrit": "स गतः शिवलोकं तं यत्र गत्वा न शोचति ।\nमज्जंति ऋषयो यत्र यत्र देवः सनातनः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000806008, "chapter_id": 20806, "verse_number": "६-१४९-९", "content_sanskrit": "साक्षाद्विष्णुः परमात्मा नित्यं तिष्ठति भूतिदः ।\nइयं साभ्रमती धन्या धन्यो विश्वेश्वरः प्रभुः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000806009, "chapter_id": 20806, "verse_number": "६-१४९-१०", "content_sanskrit": "यत्र तीर्थान्यनेकानि जातानि भुवि पार्वति ।\nअत्र चामर्दकीपुण्यैः फलैर्नानाविधैः शुभैः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000806010, "chapter_id": 20806, "verse_number": "६-१४९-११", "content_sanskrit": "कर्त्तव्यमर्घदानं च विधिना तत्र सुंदरि॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]