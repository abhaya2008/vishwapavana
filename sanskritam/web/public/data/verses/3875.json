[{"id": 2133329, "chapter_id": 3875, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2133330, "chapter_id": 3875, "verse_number": "१", "content_sanskrit": "धर्मव्याधस्तु निपुणं पुनरेव युधिष्ठिर ।\nविप्रर्षभमुवाचेदं सर्वधर्मभृतां वर \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2133331, "chapter_id": 3875, "verse_number": "२", "content_sanskrit": "श्रुतिप्रमाणो धर्मोऽयमिति वृद्धानुशासनम् ।\nसूक्ष्मा गतिर्हि धर्मस्य बहुशाखा ह्यनन्तिका ।\nप्राणान्तिके विवाहे च वक्तव्यमनृतं भवेत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2133332, "chapter_id": 3875, "verse_number": "३", "content_sanskrit": "अनृतेन भवेत् सत्यं सत्येनैवानृतं भवेत् ।\nयद् भूतहितमत्यन्तं तत्सत्यमिति धारणा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2133333, "chapter_id": 3875, "verse_number": "४", "content_sanskrit": "विपर्ययकृतोऽधर्मः पश्य धर्मस्य सूक्ष्मताम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2133334, "chapter_id": 3875, "verse_number": "५", "content_sanskrit": "यत् करोत्यशुभं कर्म शुभं वा यदि सत्तम ।\nअवश्यं तत् समाप्नोति पुरुषो नात्र संशयः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2133335, "chapter_id": 3875, "verse_number": "६", "content_sanskrit": "विषमां च दशां प्राप्तो देवान् गर्हति वै भृशम् ।\nआत्मनः कर्मदोषाणि न विजानात्यपण्डितः ।\nमूढो नैकृतिकश्चापि चपलश्च द्विजोत्तम \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2133336, "chapter_id": 3875, "verse_number": "७", "content_sanskrit": "न शुभं कर्म बध्नाति पुरुषं पापनिश्चयम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2133337, "chapter_id": 3875, "verse_number": "८", "content_sanskrit": "सुखदुःखविपर्यासो यदा समुपपद्यते ।\nनैनं प्रज्ञा सुनीतं वा त्रायते नैव पौरुषम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2133338, "chapter_id": 3875, "verse_number": "९", "content_sanskrit": "योऽयमिच्छेद् यथाकामं तं तं कामं स आप्नुयात् ।\nयदि स्यादपराधीनं पौरुषस्य क्रियाफलम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2133339, "chapter_id": 3875, "verse_number": "१०", "content_sanskrit": "संयताश्चापि दक्षाश्च मतिमन्तश्च मानवाः ।\nदृश्यन्ते निष्क(ष्फ)लाः सन्तः प्रहीणाः सर्वकर्मभिः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2133340, "chapter_id": 3875, "verse_number": "११", "content_sanskrit": "भूतानामपरः कश्चिद्धिंसायां सततोत्थितः ।\nवञ्चनायां च लोकस्य स सुखेनैव युज्यते \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2133341, "chapter_id": 3875, "verse_number": "१२", "content_sanskrit": "अचेष्टमपि चासीनं श्रीः कञ्चिदुपतिष्ठति ।\nकश्चित् कर्माणि कुर्वन् हि न प्राप्यमधिगच्छति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2133342, "chapter_id": 3875, "verse_number": "१३", "content_sanskrit": "देवानिष्ट्वा तपस्तप्त्वा कृपणैः पुत्रगृध्नुभिः ।\nदशमासधृता गर्भे जायन्ते कुलपांसनाः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2133343, "chapter_id": 3875, "verse_number": "१४", "content_sanskrit": "अपरे धनधान्यैश्च भोगैश्च पितृसञ्चितैः ।\nविपुलैरभिजायन्ते लब्धास्तैरेव मङ्गलैः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2133344, "chapter_id": 3875, "verse_number": "१५", "content_sanskrit": "न देहजा मनुष्याणां व्याधयो द्विजसत्तम ।\nकर्मजा हि मनुष्याणां रोगा नास्त्यत्र संशयः \t॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2133345, "chapter_id": 3875, "verse_number": "१६", "content_sanskrit": "आधिभिश्चैव बाध्यन्ते व्याधैः क्षुद्रमृगा इव ।\nते चापि कुशलैर्वैद्यैर्निपुणैः सम्भृतौषधैः ।\nव्याधयो विनिवार्यन्ते मृगा व्याधैरिव द्विज\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2133346, "chapter_id": 3875, "verse_number": "१७", "content_sanskrit": "येषामस्ति च भोक्तव्यं ग्रहणीरोगपीडिताः ।\nन शक्नुवन्ति ते भोक्तुं चेष्टितुं पूर्वकर्मणा \t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2133347, "chapter_id": 3875, "verse_number": "१८", "content_sanskrit": "अपरे बाहुबलिनः क्लिश्यन्ते बहवो जनाः ।\nदुःखेन चाधिगच्छन्ति भोजनं द्विजसत्तम\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2133348, "chapter_id": 3875, "verse_number": "समाप्तिः", "content_sanskrit": "इति लोकमनाक्रन्दं देहशङ्कापरिप्लुतम् ।\nस्रोतसाऽसकृदाक्षिप्तं ह्रियमाणं बलीयसा \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2133349, "chapter_id": 3875, "verse_number": "२०", "content_sanskrit": "न म्रियेयुर्न जीर्येयुः सर्वे स्युः सर्वकामिकाः ।\nनाप्रियं प्रतिपश्येयुर्वशं च यदि वै भवेत् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2133350, "chapter_id": 3875, "verse_number": "२१", "content_sanskrit": "उपर्युपरि लोकस्य सर्वो गन्तुं समीहते ।\nयतते च यथाशक्ति न च तद् वर्तते तथा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2133351, "chapter_id": 3875, "verse_number": "२२", "content_sanskrit": "बहवः सम्प्रदृश्यन्ते तुल्यनक्षत्रमङ्गलाः ।\nमहच्च फलवैषम्यं दृश्यते कर्मसन्धिषु\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2133352, "chapter_id": 3875, "verse_number": "", "content_sanskrit": "वहन्ति शिबिकामन्ये यान्त्यन्ये शिबिकागताः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2133353, "chapter_id": 3875, "verse_number": "२३", "content_sanskrit": "न केचिदीशते ब्रह्मन् स्वयं ग्राह्यस्य सत्तम ।\nकर्मणां प्रकृतानां वा इह सिद्धिः प्रदृश्यते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2133354, "chapter_id": 3875, "verse_number": "२४", "content_sanskrit": "यथा श्रुतिरियं नित्या जीवः किल सनातनः ।\nशरीरमध्रुवं लोके सर्वेषां प्राणिनामिह \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2133355, "chapter_id": 3875, "verse_number": "२५", "content_sanskrit": "वध्यमाने शरीरे तु देहनाशो भवत्युत ।\nजीवः सङ्क्रमतेऽन्यत्र कर्मबन्धनिबन्धनः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2133356, "chapter_id": 3875, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2133357, "chapter_id": 3875, "verse_number": "२६", "content_sanskrit": "कथं धर्मविदां श्रेष्ठ जीवो भवति शाश्वतः ।\nएतदिच्छाम्यहं ज्ञातुं तत्त्वेन वदतां वर \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2133358, "chapter_id": 3875, "verse_number": "", "content_sanskrit": "व्याधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2133359, "chapter_id": 3875, "verse_number": "२७", "content_sanskrit": "न जीवनाशोऽस्ति हि देहभेदे\nमिथ्यैतदाहुर्म्रियतीति मूढाः ।\nजीवस्तु देहान्तरितः प्रयाति\nदशार्धतस्तस्य शरीरभेदः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2133360, "chapter_id": 3875, "verse_number": "२८", "content_sanskrit": "अन्यो हि नाश्नाति कृतं हि कर्म\nमनुष्यलोके मनुजस्य कश्चित् ।\nयत्तेन किञ्चिद्धि कृतं हि कर्म\nतदश्नुते नात्र कृतस्य नाशः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2133361, "chapter_id": 3875, "verse_number": "२९", "content_sanskrit": "अपुण्यशीला हि भवन्ति पुण्या\nनराधमाः पापकृतो भवन्ति ।\nनरोऽनुयातस्त्विह कर्मभिः स्वै-\nस्ततः समुत्पत्स्यति भावितस्तैः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2133362, "chapter_id": 3875, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2133363, "chapter_id": 3875, "verse_number": "३०", "content_sanskrit": "कथं सम्भवते योनौ कथं वा पुण्यपापयोः ।\nजातीः पुण्या ह्यपुण्याश्च कथं गच्छति सत्तम\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2133364, "chapter_id": 3875, "verse_number": "", "content_sanskrit": "व्याधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2133365, "chapter_id": 3875, "verse_number": "३१", "content_sanskrit": "गर्भाधानसमायुक्तं कर्मेदं सम्प्रदृश्यते ।\nसमासेन तु ते क्षिप्रं प्रवक्ष्यामि द्विजोत्तम\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2133366, "chapter_id": 3875, "verse_number": "३२", "content_sanskrit": "यथा सम्भृतसम्भारः पुनरेव प्रजायते ।\nशुभकृच्छुभयोनीषु पापकृत् पापयोनिषु\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2133367, "chapter_id": 3875, "verse_number": "३३", "content_sanskrit": "शुभैः प्रयोगैर्देवत्वं व्यामिश्रैर्मानुषो भवेत्।\nमोहनीयैर्वियोनीषु त्वधोगामी च किल्बिषी \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2133368, "chapter_id": 3875, "verse_number": "३४", "content_sanskrit": "जातिमृत्युजरादुःखैः सततं समभिद्रुतः ।\nसंसारे पच्यमानश्च दौषैरात्मकृतैर्नरः\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2133369, "chapter_id": 3875, "verse_number": "३५", "content_sanskrit": "तिर्यग्योनिसहस्राणि गत्वा नरकमेव च ।\nजीवाः सम्परिवर्तन्ते कर्मबन्धनिबन्धनाः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2133370, "chapter_id": 3875, "verse_number": "३६", "content_sanskrit": "जन्तुस्तु कर्मभिस्तैस्तैः स्वकृतैः प्रेत्य दुःखितः ।\nतद् दुःखप्रतिघातार्थमपुण्यां योनिमाप्नुते\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2133371, "chapter_id": 3875, "verse_number": "३७", "content_sanskrit": "ततः कर्म समादत्ते पुनरन्यं नवं बहु ।\nपच्यते तु पुनस्तेन भुक्त्वापथ्यमिवातुरः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2133372, "chapter_id": 3875, "verse_number": "३८", "content_sanskrit": "अजस्रमेव दुःखार्तोऽदुःखितः सुखसञ्ज्ञितः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2133373, "chapter_id": 3875, "verse_number": "३९", "content_sanskrit": "ततोऽनिवृत्तबन्धत्वात् कर्मणामुदयादपि ।\nपरिक्रामति संसारे चक्रवद् बहुवेदनः ।\nस चेन्निवृत्तबन्धस्तु विशुद्धश्चापि कर्मभिः \t॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2133374, "chapter_id": 3875, "verse_number": "४०", "content_sanskrit": "तपोयोगसमारम्भं कुरुते द्विजसत्तम\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2133375, "chapter_id": 3875, "verse_number": "४१", "content_sanskrit": "कर्मभिर्बहुभिश्चापि लोकानश्नाति मानवः ।\nप्राप्नोति सुकृताँल्लोकान् यत्र गत्वा न शोचति\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2133376, "chapter_id": 3875, "verse_number": "४२", "content_sanskrit": "पापकर्मा पापवृत्तः पापस्यान्तं न गच्छति ।\nपुण्यं कुर्वन् पुण्यव्रतः पुण्यस्यान्तं न गच्छति ।\nतत् कर्म यदि चेत् कर्तुः वर्जयीत च पापकम्\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2133377, "chapter_id": 3875, "verse_number": "४३", "content_sanskrit": "अनसूयुः कृतज्ञश्च कल्याणानि च सेवते ।\nसुखानि धर्ममर्थं च स्वर्गं च लभते नरः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2133378, "chapter_id": 3875, "verse_number": "४४", "content_sanskrit": "संस्कृतस्य च दान्तस्य नियतस्य यतात्मनः ।\nप्रज्ञस्यानन्तरा वृत्तिरिह लोके परत्र च \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2133379, "chapter_id": 3875, "verse_number": "४५", "content_sanskrit": "सतां धर्मेण वर्तेत क्रियां शिष्टवदाचरेत् ।\nअसङ्क्लेशेन लोकस्य वृत्ति लिप्सेत वै द्विज \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2133380, "chapter_id": 3875, "verse_number": "४६", "content_sanskrit": "सन्ति ह्यागमविज्ञानाः शिष्टाः शास्त्रे विचक्षणाः ।\nस्वधर्मेण क्रिया लोके कर्मणः सोऽप्यसङ्करः ।\nप्राज्ञो धर्मेण रमते धर्मं चैवोपजीवति\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2133381, "chapter_id": 3875, "verse_number": "४७", "content_sanskrit": "तस्माद् धर्मादवाप्तेन धनेन द्विजसत्तम ।\nतस्यैव सञ्चिते मूलं गुणान् पश्यति तत्र वै\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2133382, "chapter_id": 3875, "verse_number": "४८", "content_sanskrit": "धर्मेण वृत्तिं कुरुते धर्मं चैव प्रशंसति ।\nधर्मात्मा भवति ह्येवं चित्तं चास्य प्रसीदति ।\nस मित्रजनसन्तुष्ट इह प्रेत्य च नन्दति\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2133383, "chapter_id": 3875, "verse_number": "४९", "content_sanskrit": "शब्दं स्पर्शं तथा रूपं गन्धानिष्टांश्च सत्तम ।\nप्रभुत्वं लभते चापि धर्मस्यैतत् फलं विदुः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2133384, "chapter_id": 3875, "verse_number": "५०", "content_sanskrit": "धर्मस्य च फलं लब्ध्वा न तृप्यति महाद्विज ।\nअतृप्यमाणो निर्वेदमापेदे ज्ञानचक्षुषा\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2133385, "chapter_id": 3875, "verse_number": "५१", "content_sanskrit": "प्रज्ञाचक्षुर्नर इह दोषं नैवानुरुध्यते ।\nविरज्यति यथाकामं न च धर्मं विमुञ्चति \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2133386, "chapter_id": 3875, "verse_number": "५२", "content_sanskrit": "फलत्यागे च यतते दृष्ट्वा लोकं श्रियात्मकम् ।\nततो मोक्षे प्रयतते नानोपायादुपायतः \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2133387, "chapter_id": 3875, "verse_number": "५३", "content_sanskrit": "एवं निर्वेदमादत्ते पापं कर्म जहाति च ।\nधार्मिकश्चापि भवति मोक्षं च लभते परम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2133388, "chapter_id": 3875, "verse_number": "५४", "content_sanskrit": "तपो निश्रेयसं जन्तोस्तस्य मूलं शमो दमः ।\nतेन सर्वानवाप्नोति कामान् यान् मनसेच्छति \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2133389, "chapter_id": 3875, "verse_number": "५५", "content_sanskrit": "इन्द्रियाणां निरोधेन सत्येन च दमेन च ।\nब्रह्मणः पदमाप्नोति यत् परं द्विजसत्तम\t ॥ ५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2133390, "chapter_id": 3875, "verse_number": "", "content_sanskrit": "कौशिकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2133391, "chapter_id": 3875, "verse_number": "५६", "content_sanskrit": "इन्द्रियाणि तु यान्याहुः कानि तानि यतव्रत ।\nनिग्रहश्च कथं कार्यो निग्रहस्य च किं फलम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2133392, "chapter_id": 3875, "verse_number": "५७", "content_sanskrit": "कथं च फलमाप्नोति तेषां धर्मभृतां वर ।\nएतदिच्छामि तत्त्वेन धर्मं ज्ञातुं निबोध मे\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2133393, "chapter_id": 3875, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि मार्कण्डेयसमास्यापर्वणि ब्राह्मणव्याधसंवादे षण्णवत्यधिकशततमोऽध्यायः ॥१९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2133394, "chapter_id": 3875, "verse_number": "२१", "content_sanskrit": "॥ मार्कण्डेयसमस्यापर्वणि एकविंशोऽध्यायः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]