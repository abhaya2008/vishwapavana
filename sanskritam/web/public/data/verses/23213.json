[{"id": 7003213000, "chapter_id": 23213, "verse_number": "१-१६-१", "content_sanskrit": "सूत उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003213001, "chapter_id": 23213, "verse_number": "१-१६-२", "content_sanskrit": "अथान्यो ब्रह्मणः कल्पो वर्तते मुनिपुंगवाः  ।\nविश्वरूप इति ख्यातो नामतः परमाद्भुतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003213002, "chapter_id": 23213, "verse_number": "१-१६-३", "content_sanskrit": "विनिवृत्ते तु संहारे पुनः सृष्टे चराचरे ।\nब्रह्मणः पुत्रकामस्य ध्यायतः परमेष्ठिनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003213003, "chapter_id": 23213, "verse_number": "१-१६-४", "content_sanskrit": "प्रादुर्भूता महानादा विश्वरूपा सरस्वती  ।\nविश्वमाल्यांबरधरा विश्वयज्ञोपवीतिनी ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003213004, "chapter_id": 23213, "verse_number": "१-१६-५", "content_sanskrit": "विश्वोष्णीषा विश्वगंधा विश्वमाता महोष्ठिका ।\nतथाविधं स भगवानीशानं परमेश्वरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003213005, "chapter_id": 23213, "verse_number": "१-१६-६", "content_sanskrit": "शुद्धस्फटिकसंकाशं सर्वाभरणभूषितम् ।\nअथ तं मनसा ध्यात्वा युक्तात्मा वै पितामहः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003213006, "chapter_id": 23213, "verse_number": "१-१६-७", "content_sanskrit": "ववंदे देवमीशानं सर्वेशं सर्वगं प्रभुम्  ।\nओमीशान नमस्तेऽस्तु महादेव नमोस्तु ते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003213007, "chapter_id": 23213, "verse_number": "१-१६-८", "content_sanskrit": "नमोस्तु सर्वविद्यानामीशान परमेश्वर ।\nनमोस्तु सर्वभूतानामीशान वृषवाहन ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003213008, "chapter_id": 23213, "verse_number": "१-१६-९", "content_sanskrit": "ब्रह्मणोधिपते तुभ्यं ब्रह्मणे ब्रह्मरूपिणे  ।\nनमो ब्रह्माधिपतये शिवं मेऽस्तु सदाशिव ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003213009, "chapter_id": 23213, "verse_number": "१-१६-१०", "content_sanskrit": "ओंकारमूर्ते देवेश सद्योजात नमोनमः ।\nप्रपद्ये त्वां प्रपन्नोऽस्मि सद्योजाताय वै नमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003213010, "chapter_id": 23213, "verse_number": "१-१६-११", "content_sanskrit": "अभवे च भवे तुभ्यं तथा नातिभवे नमः  ।\nभवोद्भव भवेशान मां भजस्व महाद्युते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003213011, "chapter_id": 23213, "verse_number": "१-१६-१२", "content_sanskrit": "वामदेव नमस्तुभ्यं ज्येष्ठाय वरदाय च  ।\nनमो रुद्राय कालाय कलनाय नमो नमः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003213012, "chapter_id": 23213, "verse_number": "१-१६-१३", "content_sanskrit": "नमो विकरणायैव कालवर्णाय वर्णिने  ।\nबलाय बलिनां नित्यं सदा विकरणाय ते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003213013, "chapter_id": 23213, "verse_number": "१-१६-१४", "content_sanskrit": "बलप्रमथनायैव बलिने ब्रह्मरूपिणे  ।\nसर्वभूतेश्वरेशाय भूतानां दमनाय च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003213014, "chapter_id": 23213, "verse_number": "१-१६-१५", "content_sanskrit": "मनोन्मनाय देवाय नमस्तुभ्यं महाद्युते  ।\nवामदेवाय वामाय नमस्तुभ्यं महात्मने ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003213015, "chapter_id": 23213, "verse_number": "१-१६-१६", "content_sanskrit": "ज्येष्ठाय चैव श्रेष्ठाय रुद्राय वरदाय च  ।\nकालहंत्रे नमस्तुभ्यं नमस्तुभ्यं महात्मने ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003213016, "chapter_id": 23213, "verse_number": "१-१६-१७", "content_sanskrit": "इति स्तवेन देवेशं ननाम वृषभध्वजम्  ।\nयः पठेत् सकृदेवेह ब्रह्मलोकं गमिष्यति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003213017, "chapter_id": 23213, "verse_number": "१-१६-१८", "content_sanskrit": "श्रावयेद्वा द्विजान् श्राद्धे स याति परमां गतिम् ।\nएवं ध्यानगतं तत्र प्रणमंतं पितामहम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003213018, "chapter_id": 23213, "verse_number": "१-१६-१९", "content_sanskrit": "उवाच भगवानीशः प्रीतोहं ते किमिच्छसि  ।\nततस्तु प्रणतो भूत्वा वाग्विशुद्धं महेश्वरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003213019, "chapter_id": 23213, "verse_number": "१-१६-२०", "content_sanskrit": "उवाच भगवान् रुद्रं प्रीतं प्रीतेन चेतसा ।\nयदिदं विश्वरूपं ते विश्वगौः श्रेयसीश्वरी ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003213020, "chapter_id": 23213, "verse_number": "१-१६-२१", "content_sanskrit": "एतद्वेदितुमिच्छामि यथेयं परमेश्वर  ।\nकैषा भगवती देवी चतुष्पादा चतुर्मुखी ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003213021, "chapter_id": 23213, "verse_number": "१-१६-२२", "content_sanskrit": "चतुःश्रृंगी चतुर्वक्रा चतुर्दंष्ट्रा चतुःस्तनी ।\nचतुर्हस्ता चतुर्नेत्रा विश्वरूपा कथं स्मृता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003213022, "chapter_id": 23213, "verse_number": "१-१६-२३", "content_sanskrit": "किंनामगोत्रा कस्येयं किंवीर्या चापि कर्मतः  ।\nतस्य तद्वचनं श्रुत्वा देवदेवो वृषध्वजः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003213023, "chapter_id": 23213, "verse_number": "१-१६-२४", "content_sanskrit": "प्राह देववृषं ब्रह्मा ब्रह्माणं चात्मसंभवम् ।\nरहस्यं सर्वमंत्राणां पावनं पुष्टिवर्धनम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003213024, "chapter_id": 23213, "verse_number": "१-१६-२५", "content_sanskrit": "श्रृणुष्वैतत्परं गुह्यमादिसर्गे यथा तथा ।\nएवं यो वर्तते कल्पो विश्वरूपस्त्वसौ मतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003213025, "chapter_id": 23213, "verse_number": "१-१६-२६", "content_sanskrit": "ब्रह्मस्थानमिदं चापि यत्र प्राप्तं त्वया प्रभो  ।\nत्वत्तः परतरं देव विष्णुना तत्पदं शुभम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003213026, "chapter_id": 23213, "verse_number": "१-१६-२७", "content_sanskrit": "वैकुंठेन विशुद्धेन मम वामांगजेन वा  ।\nतदाप्रभृति कल्पश्च त्रयस्त्रिंशत्तमो ह्ययम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003213027, "chapter_id": 23213, "verse_number": "१-१६-२८", "content_sanskrit": "शतं शतसहस्राणामतीता ये स्वयंभुवः ।\nपुरस्तात्तव देवेश तच्छृणुष्व महामते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003213028, "chapter_id": 23213, "verse_number": "१-१६-२९", "content_sanskrit": "आनंदस्तु स विज्ञेय आनंदत्वे व्यवस्थितः  ।\nमांडव्यगोत्रस्तपसा मम पुत्रत्वमागतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003213029, "chapter_id": 23213, "verse_number": "१-१६-३०", "content_sanskrit": "त्वयि योगं च सांख्यं च तपोविद्याविधिक्रियाः  ।\nऋतं सत्यं दया ब्रह्म अहिंसा सन्मतिः क्षमा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003213030, "chapter_id": 23213, "verse_number": "१-१६-३१", "content_sanskrit": "ध्यानं ध्येयं दमः शांतिर्विद्याऽविद्या मतिर्धृतिः  ।\nकांतिर्नीतिः प्रथा मेधा लज्जा दृष्टिः सरस्वती ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003213031, "chapter_id": 23213, "verse_number": "१-१६-३२", "content_sanskrit": "तुष्टिः पुष्टिः क्रिया चैव प्रसादश्च प्रतिष्ठिताः  ।\nद्वात्रिंशत्सुगुणा ह्येषा द्वात्रिंशाक्षरसंज्ञया ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003213032, "chapter_id": 23213, "verse_number": "१-१६-३३", "content_sanskrit": "प्रकृतिर्विहिता ब्रह्मंस्त्वत्प्रसूतिर्महेश्वरी  ।\nविष्णोर्भगवतश्चापि तथान्येषामपि प्रभो ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003213033, "chapter_id": 23213, "verse_number": "१-१६-३४", "content_sanskrit": "सैषा भगवती देवी मत्प्रसूतिः प्रतिष्ठिता  ।\nचतुर्मुखी जगद्योनिः प्रकृतिर्गौः प्रतिष्ठिता ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003213034, "chapter_id": 23213, "verse_number": "१-१६-३५", "content_sanskrit": "गौरी माया च विद्या च कृष्णा हैमवतीति च  ।\nप्रधानं प्रकृतिश्चैव यामाहुस्तत्त्वचिंतकाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003213035, "chapter_id": 23213, "verse_number": "१-१६-३६", "content_sanskrit": "अजामेकां लोहितां शुक्लकृष्णां विश्वप्रजां सृजमानां सरूपाम्  ।\nअजोहं मां विद्धि तां विश्वरूपं गायत्रीं गां विश्वरूपां हि बुद्ध्या ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003213036, "chapter_id": 23213, "verse_number": "१-१६-३७", "content_sanskrit": "एवमुक्त्वा महादेवः ससर्ज परमेश्वरः  ।\nततश्च पार्श्वगा देव्याः सर्वरूपकुमारकाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003213037, "chapter_id": 23213, "verse_number": "१-१६-३८", "content_sanskrit": "जटी मुंडी शिखंडी च अर्धमुंडश्च जज्ञिरे  ।\nततस्तेन यथोक्तेन योगेन सुमहौजसः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003213038, "chapter_id": 23213, "verse_number": "१-१६-३९", "content_sanskrit": "दिव्यवर्षसहस्रांते उपासित्वा महेश्वरम्  ।\nधर्मोपदेशमखिलं कृत्वा योगमयं दृढम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003213039, "chapter_id": 23213, "verse_number": "१-१६-४०", "content_sanskrit": "शिष्टाश्च नियतात्मानः प्रविष्टा रुद्रमीश्वरम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]