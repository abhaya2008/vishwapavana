[{"id": 2140602, "chapter_id": 4032, "verse_number": "", "content_sanskrit": "उत्तरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2140603, "chapter_id": 4032, "verse_number": "१", "content_sanskrit": "सारथे किमिदं दिव्यं नागो वा यदि वा धनुः ।\nसौवर्णान्यत्र पद्मानि शतपत्राणि भागशः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2140604, "chapter_id": 4032, "verse_number": "२", "content_sanskrit": "कुशाग्निप्रतितप्तानि भानुमन्ति बृहन्ति च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2140605, "chapter_id": 4032, "verse_number": "३", "content_sanskrit": "बिन्दवश्चात्र सौवर्णा मणिप्रोताः समन्ततः ।\nशशिसूर्यप्रभाः पृष्ठे भान्ति रुग्मविभूषिताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2140606, "chapter_id": 4032, "verse_number": "४", "content_sanskrit": "पुष्पाण्यत्र सुवर्णस्य शतपत्राणि भागशः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2140607, "chapter_id": 4032, "verse_number": "५", "content_sanskrit": "विस्मापनीयरूपं च भीमं भीमप्रदर्शनम् ।\nनीलोत्पलनिभं कस्य शातकुम्भपरिष्कृतम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2140608, "chapter_id": 4032, "verse_number": "६", "content_sanskrit": "ऋषभा यस्य सौवर्णाः पृष्ठे तिष्ठन्ति शृङ्गिणः ।\nताळप्रमाणं कस्येदं मणिरुग्मविभूषितम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2140609, "chapter_id": 4032, "verse_number": "७", "content_sanskrit": "हाटकस्य सुवर्णस्य यस्मिन् शाखामृगा दश ।\nदुरानमं महादीर्घं सुरूपं दुष्प्रधर्षणम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2140610, "chapter_id": 4032, "verse_number": "८", "content_sanskrit": "कस्येदमीदृशं चित्रं धनुः सर्वे च दंसिताः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2140611, "chapter_id": 4032, "verse_number": "९", "content_sanskrit": "चन्द्रार्कविमलाभासाः सुरूपाः सुप्रदर्शनाः ।\nहंसाः पृष्ठाश्रिता यस्य कुशाग्निप्रतिमार्चिषः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2140612, "chapter_id": 4032, "verse_number": "१०", "content_sanskrit": "शार्ङ्गगाण्डीवसदृशं कस्येदं सारथे धनुः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2140613, "chapter_id": 4032, "verse_number": "११", "content_sanskrit": "चतुर्थं काञ्चनवपुर्भाति विद्युद्गणोपमम् ।\nनीलोपलिप्तमच्छिद्रं जातरूपमयं धनुः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2140614, "chapter_id": 4032, "verse_number": "१२", "content_sanskrit": "मत्स्याश्चास्य हिरण्यस्य पृष्ठे तिष्ठन्ति दंसिताः ।\nशक्रचापोपमं दिव्यं कस्येदं सारथे धनुः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2140615, "chapter_id": 4032, "verse_number": "१३", "content_sanskrit": "उच्छ्रितं फणिवद् दीर्घं सारवत्त्वाद् दुरानमम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2140616, "chapter_id": 4032, "verse_number": "१४", "content_sanskrit": "सहस्रगोधाः सौवर्णा द्वीपिनश्च चतुर्दश ।\nबर्हिणश्चात्र सौवर्णाः शतचन्द्रविभूषिताः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2140617, "chapter_id": 4032, "verse_number": "१५", "content_sanskrit": "जाम्बूनदविचित्राङ्गं कस्येदं पञ्चमं धनुः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2140618, "chapter_id": 4032, "verse_number": "१६", "content_sanskrit": "कस्येमे क्षुरनाराचाः सहस्रं लोमवाहिनः ।\nप्रत्यक्तास्तीक्ष्णतुण्डाग्रा उपासङ्गे हिरण्मये\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2140619, "chapter_id": 4032, "verse_number": "१७", "content_sanskrit": "हारिद्रवर्णाः कस्येमे शिताः पञ्चशतं शराः ।\nआशीविषसमस्पर्शाः शिताश्चाजिह्मगा दृढाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2140620, "chapter_id": 4032, "verse_number": "१८", "content_sanskrit": "विपाठाः पृथवः कस्य गृध्रपत्रार्धवाजिताः ।\nवराहकर्णास्तीक्ष्णाग्रा कस्येमे रुचिराः समाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2140621, "chapter_id": 4032, "verse_number": "१९", "content_sanskrit": "वज्राशनिसमस्पर्शा वैश्वानरशिखोपमाः ।\nसुवर्णपुङ्खास्तीक्ष्णाग्राः कस्य सप्तशतं शराः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2140622, "chapter_id": 4032, "verse_number": "२०", "content_sanskrit": "कस्यायं सायको दीर्घो गव्ये कोशे च दंसितः ।\nकस्य दण्डो दृढः श्लक्ष्णो रुचिरोऽयं प्रकाशते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2140623, "chapter_id": 4032, "verse_number": "२१", "content_sanskrit": "वैयाघ्रकोशः कस्यायं दिव्यशाखो महाप्रभः ।\nकस्यायमसिरावासः पञ्चशार्दूललक्षणः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2140624, "chapter_id": 4032, "verse_number": "२२", "content_sanskrit": "कस्यायं निर्मलः खड्गो द्वीपिचर्मनिवासितः ।\nनीलोत्पलसवर्णोऽयं कस्य खड्गः पृथुर्महान्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2140625, "chapter_id": 4032, "verse_number": "२३", "content_sanskrit": "मृगेन्द्रचर्मावसितस्तीक्ष्णधारः सुनिर्मलः ।\nऋषभाजिनकोशस्तु कस्य खड्गो महानयम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2140626, "chapter_id": 4032, "verse_number": "२४", "content_sanskrit": "यस्यापिधाने दृश्यन्ते सूर्याः पञ्च परिष्कृताः ।\nकस्यायं विपुलः खड्गः शृङ्गत्सरुमनोहरः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2140627, "chapter_id": 4032, "verse_number": "२५", "content_sanskrit": "निहितः पार्षते कोशे तैलधौतः समाहितः ।\nप्रमाणवर्णयुक्तश्च कस्य खड्गो महानयम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2140628, "chapter_id": 4032, "verse_number": "२६", "content_sanskrit": "एतेन प्रतिविद्धः सन् जीवेत् कश्च न कुञ्जरः ।\nनिर्दिशस्व यथामार्गं मया पृष्ठा बृहन्नळे ।\nविस्मयो मे परो जातो दृष्ट्वा सर्वमिदं महत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2140629, "chapter_id": 4032, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां विराटपर्वणि चत्वारिंशोऽध्यायः ॥४०॥\nगोग्रहणपर्वणि त्रयोदशोऽध्यायः ॥१३॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]