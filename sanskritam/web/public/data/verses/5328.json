[{"id": 2203186, "chapter_id": 5328, "verse_number": "", "content_sanskrit": "विभावसुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2203187, "chapter_id": 5328, "verse_number": "१", "content_sanskrit": "सलिलस्याञ्जलिं पूर्णमक्षताश्च धृतोत्तराः ।\nसोमस्योत्तिष्ठमानस्य तज्जलं चाक्षतांश्च तान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2203188, "chapter_id": 5328, "verse_number": "२", "content_sanskrit": "स्थितो ह्यभिमुखो मर्त्यः पौर्णमास्यां बलिं हरेत् ।\nअग्निकार्यं कृतं तेन हुताश्चास्याग्नयस्त्रयः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2203189, "chapter_id": 5328, "verse_number": "३", "content_sanskrit": "वनस्पतिं च यो हन्यादमावास्यामबुद्धिमान् ।\nअपि ह्येकेन पत्रेण लिप्यते ब्रह्महत्यया\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2203190, "chapter_id": 5328, "verse_number": "४", "content_sanskrit": "दन्तकाष्ठं तु यः खादेदमावास्यामबुद्धिमान् ।\nहिंसितश्चन्द्रमास्तेन पितरश्चोद्विजन्ति च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2203191, "chapter_id": 5328, "verse_number": "५", "content_sanskrit": "हव्यं न तस्य देवाश्च प्रतिगृह्णन्ति पर्वसु ।\nकुप्यन्ते पितरश्चास्य कुले वंशोऽस्य हीयते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2203192, "chapter_id": 5328, "verse_number": "", "content_sanskrit": "श्रीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2203193, "chapter_id": 5328, "verse_number": "६", "content_sanskrit": "प्रकीर्णं भाजनं यत्र पानभाण्डमथासनम् ।\nयोषितश्चैव हन्यन्ते कश्मलोपहते गृहे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2203194, "chapter_id": 5328, "verse_number": "७", "content_sanskrit": "देवताः पितरश्चैव उत्सवे पर्वणीषु वा ।\nनिराशाः प्रतिगच्छन्ति कश्मलोपहताद् गृहात्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2203195, "chapter_id": 5328, "verse_number": "", "content_sanskrit": "अङ्गिराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2203196, "chapter_id": 5328, "verse_number": "८", "content_sanskrit": "यस्तु संवत्सरं पूर्णं दद्याद् दीपं करञ्जके ।\nसुवर्चलामूलहस्तः प्रजा तस्य विवर्धते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2203197, "chapter_id": 5328, "verse_number": "", "content_sanskrit": "गार्ग्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2203198, "chapter_id": 5328, "verse_number": "९", "content_sanskrit": "आतिथ्यं सततं कुर्याद् दीपं दद्यात् प्रतिश्रये ।\nवर्जयानो दिवास्वापं न च मांसानि भक्षयेत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2203199, "chapter_id": 5328, "verse_number": "१०", "content_sanskrit": "गोब्राह्मणं न हिंस्याच्च पुष्कराणि च कीर्तयेत् ।\nएष श्रेष्ठतमो धर्मः सरहस्यो महाफलः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2203200, "chapter_id": 5328, "verse_number": "११", "content_sanskrit": "अपि क्रतुशतैरिष्ट्वा क्षयं गच्छति तद्धविः ।\nन तु क्षीयन्ति ते धर्माः श्रद्दधानैः प्रयोजिताः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2203201, "chapter_id": 5328, "verse_number": "१२", "content_sanskrit": "इदं च परमं गुह्यं सरहस्यं निबोधत ।\nश्राद्धकल्पे च दैवे च तैर्थिके पर्वणीषु च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2203202, "chapter_id": 5328, "verse_number": "१३", "content_sanskrit": "रजस्वला च या नारी श्वित्रिकाऽपुत्रिका च या ।\nएताभिश्चक्षुषा दृष्टं हविर्नाश्नन्ति देवताः ।\nपितरश्च न तुष्यन्ति वर्षाण्यस्य त्रयोदश\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2203203, "chapter_id": 5328, "verse_number": "१४", "content_sanskrit": "शुक्लवासाः शुचिर्भूत्वा ब्राह्मणान् स्वस्ति वाचयेत् ।\nकीर्तयेद् भारतं चैव तथा स्यादक्षयं हविः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2203204, "chapter_id": 5328, "verse_number": "", "content_sanskrit": "धौम्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2203205, "chapter_id": 5328, "verse_number": "१५", "content_sanskrit": "भिन्नभाण्डं च खट्वां च कुक्कुटं शुनकं तथा ।\nअप्रशस्तानि सर्वाणि यश्च वृक्षो गृहेरुहः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2203206, "chapter_id": 5328, "verse_number": "१६", "content_sanskrit": "भिन्नभाण्डे कलिं प्राहुः खट्वायां तु धनक्षयः ।\nकुक्कुटे शुनके चैव हविर्नाश्नन्ति देवताः ।\nवृक्षमूले ध्रुवं सत्वं तस्माद् वृक्षं न रोपयेत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2203207, "chapter_id": 5328, "verse_number": "", "content_sanskrit": "जमदग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2203208, "chapter_id": 5328, "verse_number": "१७", "content_sanskrit": "यो यजेदश्वमेधेन वाजपेयशतेन ह ।\nअवाक्शिरा वा लम्बेत सत्रं वा स्फीतमाहरेत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2203209, "chapter_id": 5328, "verse_number": "१८", "content_sanskrit": "न यस्य हृदयं शुद्धं नरकं स ध्रुवं व्रजेत् ।\nतुल्यं यज्ञश्च सत्यं च हृदयस्य च शुद्धता\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2203210, "chapter_id": 5328, "verse_number": "१९", "content_sanskrit": "शुद्धेन मनसा दत्त्वा सक्तुप्रस्थं द्विजातये ।\nब्रह्मलोकमनुप्राप्तः पर्याप्तं तन्निदर्शनम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2203211, "chapter_id": 5328, "verse_number": "", "content_sanskrit": "वायुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2203212, "chapter_id": 5328, "verse_number": "२०", "content_sanskrit": "किञ्चिद्धर्मं प्रवक्ष्यामि मानुषाणां सुखावहम् ।\nसरहस्याश्च ये दोषास्तान् शृणुध्वं समाहिताः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2203213, "chapter_id": 5328, "verse_number": "२१", "content_sanskrit": "अग्निकार्यं च कर्तव्यं परमान्नेन भोजनम् ।\nदीपकश्चापि कर्तव्यः पितॄणां सतिलोदकः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2203214, "chapter_id": 5328, "verse_number": "२२", "content_sanskrit": "एतेन विधिना मर्त्यः श्रद्दधानः समाहितः ।\nचतुरो वार्षिकान् मासान् यो ददाति तिलोदकम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2203215, "chapter_id": 5328, "verse_number": "२३", "content_sanskrit": "भोजनं च यथाशक्त्या ब्राह्मणे वेदपारगे ।\nपशुबन्धशतस्येह फलं प्राप्नोति पुष्कळम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2203216, "chapter_id": 5328, "verse_number": "२४", "content_sanskrit": "इदं चैवापरं गुह्यमप्रशस्तं निबोधत ।\nअग्नेस्तु वृषलो नेता हविर्मूढाश्च योषितः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2203217, "chapter_id": 5328, "verse_number": "२५", "content_sanskrit": "मन्यते धर्म एवेति स चाधर्मेण लिप्यते ।\nअग्नयस्तस्य कुप्यन्ति शूद्रयोनिं स गच्छति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2203218, "chapter_id": 5328, "verse_number": "२६", "content_sanskrit": "पितरश्च न तुष्यन्ति सहदेवैर्विशेषतः ।\nप्रायश्चित्तं तु यत् तत्र ब्रुवतस्तन्निबोध मे ।\nयत्कृत्वा तु नरः सम्यक्सुखी भवति विज्वरः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2203219, "chapter_id": 5328, "verse_number": "२७", "content_sanskrit": "गवां मूत्रपुरीषेण पयसा च घृतेन च ।\nअग्निकार्यं त्र्यहं कुर्यान्निराहारः समाहितः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2203220, "chapter_id": 5328, "verse_number": "२८", "content_sanskrit": "ततः संवत्सरे पूर्णे प्रतिगृह्णन्ति देवताः ।\nहृष्यन्ति पितरश्चास्य श्राद्धकाल उपस्थिते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2203221, "chapter_id": 5328, "verse_number": "२९", "content_sanskrit": "एष ह्यधर्मो धर्मश्च रहस्यः सम्प्रकीर्तितः ।\nमर्त्यानां स्वर्गकामानां प्रेत्य स्वर्गसुखावहः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2203222, "chapter_id": 5328, "verse_number": "", "content_sanskrit": "॥इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे श्राद्धरहस्यं नाम एकोनाशीत्युत्तरशततमोऽध्यायः ॥१७९॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]