[{"id": 2060419, "chapter_id": 2294, "verse_number": "८-१५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060420, "chapter_id": 2294, "verse_number": "८-१५-१", "content_sanskrit": "नकुलं रभसं युद्धे द्रावयन्तं वरूथिनीम्।\nकर्णो वैकर्तनो राजन्वारयामास वै रुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060421, "chapter_id": 2294, "verse_number": "८-१५-२", "content_sanskrit": "नकुलस्तु ततः कर्णं प्रहसन्निदमब्रवीत्॥\nचिरस्य बत दृष्टोऽहं दैवतैः सौम्यचक्षुषा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060422, "chapter_id": 2294, "verse_number": "८-१५-३", "content_sanskrit": "यस्य मे त्वं रणे पाप चक्षुर्विषयमागतः॥\nत्वं हि मूलमनर्थानां वैरस्य कलहस्य च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060423, "chapter_id": 2294, "verse_number": "८-१५-४", "content_sanskrit": "त्वद्दोषात्कुरवः क्षीणाः समासाद्य परस्परम्।\nत्वामद्य समरे हत्वा कृतकृत्योऽस्मि विज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060424, "chapter_id": 2294, "verse_number": "८-१५-५", "content_sanskrit": "एवमुक्तः प्रत्युवाच नकुलं सूतनन्दनः।\nसदृशं राजपुत्रस्य धन्विनश्च विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060425, "chapter_id": 2294, "verse_number": "८-१५-६", "content_sanskrit": "प्रहरस्व च मे वीर पश्यामस्तव पौरुषम्।\nकर्म कृत्वा रमे शूर ततः कत्थितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060426, "chapter_id": 2294, "verse_number": "८-१५-७", "content_sanskrit": "अनुक्त्वा समरे तात शूरा युध्यन्ति शक्तितः।\nप्रयुध्यस्व मया शक्त्या हनिष्ये दर्पमेव ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060427, "chapter_id": 2294, "verse_number": "८-१५-८", "content_sanskrit": "इत्युक्त्वा प्राहरत्तूर्णं पाण्डुपुत्राय सूतजः।\nविव्याध चैनं समरे त्रिसप्तत्या शिलीमुखैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060428, "chapter_id": 2294, "verse_number": "८-१५-९", "content_sanskrit": "नकुलस्तु ततो विद्वः सूतपुत्रेण भारत।\nअशीत्याऽऽशीविषप्रख्यैः सूतपुत्रमविध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060429, "chapter_id": 2294, "verse_number": "८-१५-१०", "content_sanskrit": "तस्य कर्णो धनुश्छित्त्वा स्वर्णपुङ्खैः शिलाशितैः।\nत्रिंशता परमेष्वासः शरैः पाण्डवमर्दयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060430, "chapter_id": 2294, "verse_number": "८-१५-११", "content_sanskrit": "ते तस्य कवचं भित्त्वा पपुः शोणितमाहवे।\nआशीविषा यथा नागा भित्त्वा गां सलिलं पपुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060431, "chapter_id": 2294, "verse_number": "८-१५-१२", "content_sanskrit": "अथान्यद्वनुरादाय हेमपृष्ठं दुरासदम्।\nकर्णं विव्याध सप्तत्या सारथिञ्च त्रिभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060432, "chapter_id": 2294, "verse_number": "८-१५-१३", "content_sanskrit": "ततः क्रुद्धो महाराज नकुलः परवीहा।\nक्षुरप्रेण सुतीक्ष्णेन कर्णस्य धनुराच्छिनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060433, "chapter_id": 2294, "verse_number": "८-१५-१४", "content_sanskrit": "अथैनं छिन्नधन्वानं सायकानां शतैस्त्रिभिः।\nआजघ्ने प्रहसन्वीरः सर्वलोकमहारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060434, "chapter_id": 2294, "verse_number": "८-१५-१५", "content_sanskrit": "कर्णमभ्यर्दितं दृष्ट्वा पाण्डुपुत्रेण मारिष।\nविस्मयं परमं जग्मुर्ऋषयः सह दैवतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060435, "chapter_id": 2294, "verse_number": "८-१५-१६", "content_sanskrit": "अथान्यद्वनुरादाय कर्णो वैकर्तनस्तदा।\nनकुलं पञ्छभिर्बाणैर्जत्रुदेशे समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060436, "chapter_id": 2294, "verse_number": "८-१५-१७", "content_sanskrit": "उरस्थैरथ तैर्बाणैर्माद्रीपुत्रो व्यरोचत।\nस्वरश्मिभिरिवादित्यो भुवने विसृजन्प्रभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060437, "chapter_id": 2294, "verse_number": "८-१५-१८", "content_sanskrit": "नकुलस्तु ततः कर्णं विद्व्वा सप्तभिराशुगैः।\nअथास्य धनुषः कोटिं पुनश्चिच्छेद मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060438, "chapter_id": 2294, "verse_number": "८-१५-१९", "content_sanskrit": "सोऽन्यत्कार्मुकमादाय समरे वेगवत्तरम्।\nनकुलस्य ततो बैणैः समन्ताच्छादयद्दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060439, "chapter_id": 2294, "verse_number": "८-१५-२०", "content_sanskrit": "सञ्छाद्यमानः सहसा कर्णचाप्युतैः सरैः।\nचिच्छेद स शरांस्तूर्णं शरैरेव महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060440, "chapter_id": 2294, "verse_number": "८-१५-२१", "content_sanskrit": "ततो बाणमयं जालं विततं व्योम्न्यदृश्यत।\nखद्योतानामिव व्रातैः सम्पतद्भिर्यथा नभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060441, "chapter_id": 2294, "verse_number": "८-१५-२२", "content_sanskrit": "तैर्विमुक्तैः शरशतैश्छादितं गगनं तदा।\nशलभानां यथा व्रातैस्तद्वदासीद्विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060442, "chapter_id": 2294, "verse_number": "८-१५-२३", "content_sanskrit": "ते शरा हेमविकृताः सम्पन्तौ मुहुर्मुहुः।\nश्रेणीकृता व्यकाशान्त क्रौञ्चाः श्रेणीकृता इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2060443, "chapter_id": 2294, "verse_number": "८-१५-२४", "content_sanskrit": "बाणजालवृते व्योम्नि च्छादिते च दिवाकरे।\nन स्म सम्पतते भूतं किञ्चिदप्यन्तरिक्षगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2060444, "chapter_id": 2294, "verse_number": "८-१५-२५", "content_sanskrit": "निरुद्वे तत्र मार्गे च शरसङ्घैः समन्ततः।\nव्यरोचेतां महात्मानौ कालसूर्याविवोदितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2060445, "chapter_id": 2294, "verse_number": "८-१५-२६", "content_sanskrit": "कर्णचापच्युतैर्बाणैर्वध्यमानास्तु सोमकाः।\nअवालीयन्त राजेन्द्र वेदनार्ता भूशार्दिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2060446, "chapter_id": 2294, "verse_number": "८-१५-२७", "content_sanskrit": "नकुलस्य तथा बाणैर्हन्यमाना चमूस्तव।\nव्यशीर्यत दिशो राजन्वातनुन्ना इवाम्बुदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2060447, "chapter_id": 2294, "verse_number": "८-१५-२८", "content_sanskrit": "ते सेने हन्यमाने तु ताभ्यां दिव्यैर्महाशरैः।\nशरपातमपाक्रम्य तस्थतुः प्रेक्षिके तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2060448, "chapter_id": 2294, "verse_number": "८-१५-२९", "content_sanskrit": "प्रोत्सारितजने तस्मिन्कर्णपाण्डवयोः शरैः।\nअविध्येतां महात्मानावन्योन्यं शरवृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2060449, "chapter_id": 2294, "verse_number": "८-१५-३०", "content_sanskrit": "विदर्शयन्तौ दिव्यानि शस्त्राणि रणमूर्धनि।\nछादयन्तौ च सहसा परस्परवधैषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2060450, "chapter_id": 2294, "verse_number": "८-१५-३१", "content_sanskrit": "नकुलेन शरा मुक्ता कङ्कबर्हिणवाससः।\nसूतपुत्रमवच्छाद्य व्यतिष्ठन्त यथाऽम्बरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2060451, "chapter_id": 2294, "verse_number": "८-१५-३२", "content_sanskrit": "तथैव सूतपुत्रेण प्रेषिताः परमाहवे।\nपाण्डुपुत्रमवच्छाद्य व्यतिष्ठन्ताम्बरे शराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2060452, "chapter_id": 2294, "verse_number": "८-१५-३३", "content_sanskrit": "शरवेश्मप्रविष्टौ तौ ददृशाते न कैश्चन।\nसूर्याचन्द्रमसौ राजञ्छाद्यमानौ घनैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2060453, "chapter_id": 2294, "verse_number": "८-१५-३४", "content_sanskrit": "ततः क्रुद्धो रणे कर्णः कृत्वा घोरतरं वपुः।\nपाण्डवं छादयामास समन्ताच्छरवृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2060454, "chapter_id": 2294, "verse_number": "८-१५-३५", "content_sanskrit": "सोऽतिच्छन्नो महाराज सूतपुत्रेण पाण्डवः।\nन चकार व्यथां राजन्भास्करो जलदैर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2060455, "chapter_id": 2294, "verse_number": "८-१५-३६", "content_sanskrit": "ततः प्रहस्याधिरथिः शरजालानि मारिष।\nप्रेषयामास समरे शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2060456, "chapter_id": 2294, "verse_number": "८-१५-३७", "content_sanskrit": "एकच्छायमभूत्सर्वं तस्य बाणैर्महात्मनः॥\nअभ्रच्छायेव सञ्जज्ञे सम्पतद्भिः शरोत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2060457, "chapter_id": 2294, "verse_number": "८-१५-३८", "content_sanskrit": "ततः कर्णो महाराज धनुश्छित्त्वा महात्मनः।\nसारथिं पातयामास रथनीडाद्वसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2060458, "chapter_id": 2294, "verse_number": "८-१५-३९", "content_sanskrit": "ततोऽश्वांश्छतुरश्चास्य चतुर्भिर्निशितैः शरैः।\nयमस्य भवनं तूर्णं प्रेषयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2060459, "chapter_id": 2294, "verse_number": "८-१५-४०", "content_sanskrit": "अथास्य तं रथं दिव्यं तिलशो व्यधमच्छरैः।\nपताकां चक्ररक्षांश्च गदां खङ्गं च मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2060460, "chapter_id": 2294, "verse_number": "८-१५-४१", "content_sanskrit": "शतचन्द्रं च तच्चर्म सर्वापकरणानि च।\n`सुवर्णविकृतं तच्च धनुः शरमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2060461, "chapter_id": 2294, "verse_number": "८-१५-४२", "content_sanskrit": "हताश्वो विरथश्चैव विवर्मा च विशाम्पते।\nअवतीर्य रथात्तूर्णं परिघं गृह्य धिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2060462, "chapter_id": 2294, "verse_number": "८-१५-४३", "content_sanskrit": "तमुद्यतं महारघोरं परिघं तस्य सूतजः।\nव्यहनत्सायकै राजन्सुतीक्ष्णैर्भारसाधनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2060463, "chapter_id": 2294, "verse_number": "८-१५-४४", "content_sanskrit": "व्यायुधं चैनमालक्ष्य शरैः सन्नतपर्वभिः।\nआर्पयद्बहुभिः कर्णो न चैनं समपीडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2060464, "chapter_id": 2294, "verse_number": "८-१५-४५", "content_sanskrit": "स हन्यमानः समरे कृतास्त्रेण बलीयसा।\nप्राद्रवत्सहसा राजन्नकुलो व्याकुलेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2060465, "chapter_id": 2294, "verse_number": "८-१५-४६", "content_sanskrit": "तमभिद्रुत्य राधेयः प्रहसन्वै पुनःपुनः।\nसज्यमस्य धनुः कण्ठे व्यवासृजत भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2060466, "chapter_id": 2294, "verse_number": "८-१५-४७", "content_sanskrit": "ततः स शुशुभे राजन्कण्ठासक्तमहाधनुः।\nपरिवेषमनुप्राप्तो यथा स्याद्व्योम्नि चन्द्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2060467, "chapter_id": 2294, "verse_number": "८-१५-४८", "content_sanskrit": "यथैव चासितो मेघः शक्रचापेन शोभितः।\n`अशोभत महाराज पाण्डुपुत्रस्तथा रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2060468, "chapter_id": 2294, "verse_number": "८-१५-४९", "content_sanskrit": "तमब्रवीत्ततः कर्णो व्यर्थं व्याहृतवानसि।\nवदेदानीं पुनर्हृष्टो वध्यमानः पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2060469, "chapter_id": 2294, "verse_number": "८-१५-५०", "content_sanskrit": "मा योत्सीः कुरुभिः सार्धं बलवद्भिश्च पाण्डव।\nसदृशैस्तात युध्यस्व व्रीडां मा कुरु पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2060470, "chapter_id": 2294, "verse_number": "८-१५-५१", "content_sanskrit": "गृहं वा गच्छ माद्रेय यत्र वा कृष्णफल्गुनौ।\nएवमुक्त्वा महाराज विससर्ज स तं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2060471, "chapter_id": 2294, "verse_number": "८-१५-५२", "content_sanskrit": "वधप्राप्तं तु तं शूरो नाहनद्वर्मवित्तदा।\nस्मृत्वा कुन्त्या वचो राजंस्तत एनं व्यसर्जयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2060472, "chapter_id": 2294, "verse_number": "८-१५-५३", "content_sanskrit": "विसृष्टः पाण्डवो राजन्सूतपुत्रेण धन्विना।\nव्रीडन्निव जगामाथ युधिष्ठिररथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2060473, "chapter_id": 2294, "verse_number": "८-१५-५४", "content_sanskrit": "आरुरोह रथं चापि सूतपुत्रप्रतापितः।\nनिःश्वसन्दुःखसन्तप्तः कुम्भक्षिप्त इवोरगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2060474, "chapter_id": 2294, "verse_number": "८-१५-५५", "content_sanskrit": "तं विजित्याथ कर्णोऽपि पाञ्चालांस्त्वरितो ययौ।\nरथेनातिपताकेन चन्द्रवर्णहयेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2060475, "chapter_id": 2294, "verse_number": "८-१५-५६", "content_sanskrit": "तत्राक्रन्दो महानासीत्पाण्डवानां विशाम्पते।\nदृष्ट्वा सेनापतिं यान्तं पाञ्चालानां रथव्रजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2060476, "chapter_id": 2294, "verse_number": "८-१५-५७", "content_sanskrit": "तत्राकरोन्महाराज कदनं सूतनन्दनः।\nमध्यं प्राप्ते दिनकरे चक्रवद्विचरन्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2060477, "chapter_id": 2294, "verse_number": "८-१५-५८", "content_sanskrit": "भग्नचक्रै रथैः कैश्चिच्छिन्नध्यवजपताकिभिः।\nहताश्वैर्हतसूतैश्च भग्नाक्षैश्चैव मारिष।\nहियमाणानपश्याम पाञ्चालानां रथव्रजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2060478, "chapter_id": 2294, "verse_number": "८-१५-५९", "content_sanskrit": "तत्रतत्र च सम्भ्रान्ता विचेरुरथ कुञ्जराः।\nदावाग्न्यभिपरीताङ्गा यथैव स्युर्महावने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2060479, "chapter_id": 2294, "verse_number": "८-१५-६०", "content_sanskrit": "भिन्नकुम्भाः सरुधिराश्छिन्नहस्ताश्च वारणाः।\nछिन्नगात्रावराश्चैव च्छिन्नवालधयोऽपरे।\nछिन्नाभ्राणीव सम्पेतुर्हन्यमाना महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2060480, "chapter_id": 2294, "verse_number": "८-१५-६१", "content_sanskrit": "अपरे त्रासिता नागा नाराचशरतोमरैः।\nतमेवाभिमुखं जग्मुः शलभा इव पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2060481, "chapter_id": 2294, "verse_number": "८-१५-६२", "content_sanskrit": "अपरे निष्टनन्तश्च व्यदृश्यन्त महाद्विपाः।\nक्षरन्तः शोणितं गात्रैर्नगा इव जलस्रवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2060482, "chapter_id": 2294, "verse_number": "८-१५-६३", "content_sanskrit": "उरश्छदैर्वियुक्तांश्च वालबन्धैश्च वाजिनः।\nराजतैश्च तथा कांस्यैः सौवर्णैश्चैव भूषणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2060483, "chapter_id": 2294, "verse_number": "८-१५-६४", "content_sanskrit": "हीनांश्चाभरणैश्चैव खलीनैश्च विवर्जितान्।\nचामरैश्च कुथाभिश्च तूणीरैः पतितैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2060484, "chapter_id": 2294, "verse_number": "८-१५-६५", "content_sanskrit": "निहतैः सादिभिश्चैव शूरैराहवशोभितैः।\nअपश्याम रणे तत्र भ्राम्यमाणान्हयोत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2060485, "chapter_id": 2294, "verse_number": "८-१५-६६", "content_sanskrit": "प्रासैः खङ्गैश्च रहितानृष्टिभिश्चापि भारत।\nहयसादीनपश्याम कञ्चुकोष्णीषधारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2060486, "chapter_id": 2294, "verse_number": "८-१५-६७", "content_sanskrit": "निहतान्वध्यमानांश्च वेपमानांश्च भारत।\nनागाङ्गावयवैर्हीनांस्तत्रतत्रैव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2060487, "chapter_id": 2294, "verse_number": "८-१५-६८", "content_sanskrit": "रथान्हेमपरिष्कारान्संयुक्ताञ्जवनैर्हयैः।\nभ्राम्यमाणानपश्याम हतेषु रथिषु द्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2060488, "chapter_id": 2294, "verse_number": "८-१५-६९", "content_sanskrit": "भग्नाक्षकूबरान्कांश्चिद्भग्नचक्रांश्च भारत।\nविपताकध्वजांश्चान्याञ्छिन्नेषादण्डबन्धुरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2060489, "chapter_id": 2294, "verse_number": "८-१५-७०", "content_sanskrit": "विहीनान्रथिनस्तत्र धावमानांस्ततस्ततः।\nसूतपुत्रशरैस्तीक्ष्णैर्हन्यमानान्विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2060490, "chapter_id": 2294, "verse_number": "८-१५-७१", "content_sanskrit": "विशस्त्रांश्च तथैवान्यान्सशस्त्रांश्च हतान्बहून्।\nतारकाजालसञ्छन्नान्वरघण्टाविशोभितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2060491, "chapter_id": 2294, "verse_number": "८-१५-७२", "content_sanskrit": "नानावर्णविचित्राभिः पताकाभिरलङ्कृतान्।\nवारमआननुपश्याम धावमानान्समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2060492, "chapter_id": 2294, "verse_number": "८-१५-७३", "content_sanskrit": "शिरांसि बाहूनूरूंश्च च्छिन्नानन्यांस्तथैव च।\nकर्णचापच्युतैर्बाणैरपश्याम समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2060493, "chapter_id": 2294, "verse_number": "८-१५-७४", "content_sanskrit": "महान्व्यतिकरो रौद्रो योधानामन्वपद्यत।\nकर्णसायकनुन्नानां युध्यतां च शितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2060494, "chapter_id": 2294, "verse_number": "८-१५-७५", "content_sanskrit": "ते वध्यमानाः समरे सूतपुत्रेण सृञ्जयाः।\nतमेवाभिमुखं यान्ति पतङ्गा इव पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2060495, "chapter_id": 2294, "verse_number": "८-१५-७६", "content_sanskrit": "तं दहन्तमनीकानि तत्रतत्र महारथम्।\nक्षत्रिया वर्जयामासुर्युगान्ताग्निमिवोल्बणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2060496, "chapter_id": 2294, "verse_number": "८-१५-७७", "content_sanskrit": "हतशेषास्तु ये वीराः पाञ्चालानां महारथाः।\nतान्प्रभग्रान्दुतान्वीरः पृष्ठो विकिऱञ्छरैः।\nअभ्यधावत तेजस्वी विशीर्णवचनध्वजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2060497, "chapter_id": 2294, "verse_number": "८-१५-७८", "content_sanskrit": "तापयामास तान्बाणैः सूतपुत्रो महाबलः।\nमध्यन्दिनमनुप्राप्तो भूतानीव तमोनुदः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2060498, "chapter_id": 2294, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि षोडशदिवसयुद्धे पञ्चदशोऽध्यायः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]