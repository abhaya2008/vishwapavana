[{"id": 50002563, "chapter_id": 10621, "verse_number": "1", "content_sanskrit": "तस्मादज्ञानसम्भूतं हृत्स्थं ज्ञानासिनाऽऽत्मनः। छित्त्वैनं संशयं योगमातिष्ठोत्तिष्ठ भारत॥ ४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50002564, "chapter_id": 10621, "verse_number": "2", "content_sanskrit": "॥ ओन्तत्सत्॥ इति श्रीमद्भगवद्गीतासूपनिषत्सु ब्रह्मविद्यायां योगशास्त्रे श्रीकृष्णार्जुनसंवादे ज्ञानयोगो नाम चतुर्थोऽध्यायः॥ ४२ श्लोकाः॥ आदितः २०४ श्लोकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50002565, "chapter_id": 10621, "verse_number": "3", "content_sanskrit": "॥ कर्मसन्न्यासयोगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50002566, "chapter_id": 10621, "verse_number": "4", "content_sanskrit": "॥ योगसन्न्यासयोराधिक्यविषयकः प्रश्नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50002567, "chapter_id": 10621, "verse_number": "5", "content_sanskrit": "अर्जुन उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50002568, "chapter_id": 10621, "verse_number": "6", "content_sanskrit": "सन्न्यासं कर्मणां कृष्ण पुनर्योगं च शंससि। यच्छ्रेय एतयोरेकं तन्मे ब्रूहि सुनिश्चितम्॥ ५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50002569, "chapter_id": 10621, "verse_number": "7", "content_sanskrit": "॥ सन्न्यासाद् योगस्याधिक्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50002570, "chapter_id": 10621, "verse_number": "8", "content_sanskrit": "श्रीभगवानुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50002571, "chapter_id": 10621, "verse_number": "9", "content_sanskrit": "सन्न्यासः कर्मयोगश्च निःश्रेयसकरावुभौ। तयोस्तु कर्मसन्न्यासात् कर्मयोगो विशिष्यते॥ ५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]