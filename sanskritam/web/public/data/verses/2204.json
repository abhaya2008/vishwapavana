[{"id": 2055013, "chapter_id": 2204, "verse_number": "७-१३१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2055014, "chapter_id": 2204, "verse_number": "७-१३१-१", "content_sanskrit": "वर्तमाने महाराज सङ्ग्रामे रोमहर्षणे।\nव्याकुलेषु च सर्वेषु पीड्यमानेषु सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2055015, "chapter_id": 2204, "verse_number": "७-१३१-२", "content_sanskrit": "राधेयो भीममानर्च्छ युद्धाय भरतर्षभ।\nयथा नागो वने नागं मत्तो मत्तमभिद्रवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2055016, "chapter_id": 2204, "verse_number": "७-१३१-३", "content_sanskrit": "`ततो व्यायच्छतामस्त्रैः पृथक्पृथगरिन्दमौ।\nमृदुपूर्वं च राधेयो दृढपूर्वं च पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2055017, "chapter_id": 2204, "verse_number": "७-१३१-४x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2055018, "chapter_id": 2204, "verse_number": "७-१३१-४", "content_sanskrit": "यौ तौ कर्णश्च भीमश्च सम्प्रयुद्धौ महाबलौ।\nअर्जुनस्य रथोपान्ते कीदृशः सोऽभवद्रणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2055019, "chapter_id": 2204, "verse_number": "७-१३१-५", "content_sanskrit": "पूर्वं हि निर्जितः कर्णो भीमसेनेन संयुगे।\nकथं भूयः स राधेयो भीममागान्महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2055020, "chapter_id": 2204, "verse_number": "७-१३१-६", "content_sanskrit": "भीमो वा सूततनयं प्रत्युद्यातः कथं रणे।\nमहारथसमाख्यातं पृथिव्यां प्रवरं रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2055021, "chapter_id": 2204, "verse_number": "७-१३१-७", "content_sanskrit": "भीष्मद्रोणावतिक्रम्य धर्मराजो युधिष्ठिरः।\nनान्यतो भयमादत्त विना कर्णान्महारथात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2055022, "chapter_id": 2204, "verse_number": "७-१३१-८", "content_sanskrit": "भयाद्यस्य महाबाहो न शेते बहुलाः समाः।\nचिन्तयन्नित्यशो वीर्यं राधेयस्य महात्मनः।\nतं कथं सूतपुत्रं तु भीमोऽयोधयताहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2055023, "chapter_id": 2204, "verse_number": "७-१३१-९", "content_sanskrit": "ब्रह्मण्यं वीर्यसम्पन्नं समरेष्वनिवर्तिनम्।\nकथं कर्णं युधां श्रेष्ठं योधयामास पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2055024, "chapter_id": 2204, "verse_number": "७-१३१-१०", "content_sanskrit": "यौ तौ समीयतुर्वीरौ वैकर्तनवृकोदरौ।\nकथं तावत्र युध्येतां महाबलपराक्रमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2055025, "chapter_id": 2204, "verse_number": "७-१३१-११", "content_sanskrit": "भ्रातृत्वं दर्शितं पूर्वं घृणी चापि स सूतजः।\nकथं भीमेन युयुधे कुन्त्या वाक्यमनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2055026, "chapter_id": 2204, "verse_number": "७-१३१-१२", "content_sanskrit": "भीमो वा सूतपुत्रेण स्मरन्वैरं पुरा कृतम्।\nअयुध्यत कथं शूरः कर्णेन सह संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2055027, "chapter_id": 2204, "verse_number": "७-१३१-१३", "content_sanskrit": "आशास्ते च सदा सूतपुत्रे दुर्योधनो मम।\nकर्णो जेष्यति सङ्ग्रामे समस्तान्पाण्डवानिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2055028, "chapter_id": 2204, "verse_number": "७-१३१-१४", "content_sanskrit": "जयाशा यत्र पुत्रस्य मम मन्दस्य संयुगे।\nस कथं भीमकर्माणं भीमसेनमयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2055029, "chapter_id": 2204, "verse_number": "७-१३१-१५", "content_sanskrit": "यं समासाद्य पुत्रैर्मे कृतं वैरं महारथैः।\nतं सूततनयं तात कथं भीमो ह्ययोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2055030, "chapter_id": 2204, "verse_number": "७-१३१-१६", "content_sanskrit": "अनेकान्विप्रकारांश्च सूतपुत्रसमुद्भवान्।\nस्मरमाणः कथं भीमो युयुधे सूतसूनुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2055031, "chapter_id": 2204, "verse_number": "७-१३१-१७", "content_sanskrit": "योऽजयत्पृथिवीं सर्वां रथेनैकेन वीर्यवान्।\nतं सूततनयं युद्धे कथं भीमो ह्ययोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2055032, "chapter_id": 2204, "verse_number": "७-१३१-१८", "content_sanskrit": "यो जातः कुण्डलाभ्यां च कवचेन सहैव च।\nतं सूतपुत्रं समरे भीमः कथमयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2055033, "chapter_id": 2204, "verse_number": "७-१३१-१९", "content_sanskrit": "`अस्त्रहेतोः पुरा तात भार्गवं समपूजयत्।\nतस्य प्रसादाद्ब्रह्मास्त्रं लब्धवांश्च भृगूत्तमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2055034, "chapter_id": 2204, "verse_number": "७-१३१-२०", "content_sanskrit": "यथा तयोर्युद्धमभूद्यश्चासीद्विजयी तयोः।\nतन्ममाचक्ष्व तत्त्वेन कुशलो ह्यसि सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2055035, "chapter_id": 2204, "verse_number": "७-१३१-२१x", "content_sanskrit": "सञ्चय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2055036, "chapter_id": 2204, "verse_number": "७-१३१-२१", "content_sanskrit": "भीमसेनस्तु राधेयमुत्सृज्य रथिनां वरम्।\nइयेष गन्तुं यत्रास्तां वीरौ कृष्णधनञ्चयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2055037, "chapter_id": 2204, "verse_number": "७-१३१-२२", "content_sanskrit": "तं प्रयान्तमभिद्रुत्य राधेयः कङ्कपत्रिभिः।\nअभ्यवर्षन्महाराज मेघो वृष्ट्येव पर्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2055038, "chapter_id": 2204, "verse_number": "७-१३१-२३", "content_sanskrit": "फुल्लता पङ्कजेनेव वक्त्रेण विहसन्बली।\nआजुहाव रणे यान्तं भीममाधिरथिस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2055039, "chapter_id": 2204, "verse_number": "७-१३१-२४", "content_sanskrit": "कर्ण उवाच।\nभीमाहितैस्तव रणः स्वप्नेऽपि न विभावितः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2055040, "chapter_id": 2204, "verse_number": "७-१३१-२५", "content_sanskrit": "तद्दर्शयसि कस्मान्मे पृष्ठं पार्थदिदृक्षया॥\nकुन्त्याः पुत्रस्य सदृशं नेदं पाण्डवनन्दन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2055041, "chapter_id": 2204, "verse_number": "७-१३१-२६", "content_sanskrit": "तेन मामभितः स्थित्वा शरवर्षैरवाकिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2055042, "chapter_id": 2204, "verse_number": "७-१३१-२६x", "content_sanskrit": "सञ्जय उवाच।\nभीमसेनस्तदाह्वानं कर्णान्नामर्षयद्युधि।\nअर्धमण्डलमावृत्य सूतपुत्रमयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2055043, "chapter_id": 2204, "verse_number": "७-१३१-२७", "content_sanskrit": "अवक्रगामिभिर्बाणैरभ्यवर्षन्महायशाः।\nदंशितं द्वैरथे यत्तं सर्वशस्त्रविशारदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2055044, "chapter_id": 2204, "verse_number": "७-१३१-२८", "content_sanskrit": "विधित्सुः कलहस्यान्तं जिघांसुः कर्णमक्षिणोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2055045, "chapter_id": 2204, "verse_number": "७-१३१-२९", "content_sanskrit": "हत्वा तस्यानुगांस्तं च हन्तुकामो महाबलः।\nतस्मै व्यसृजदुग्राणि विविधानि परन्तपः।\nअमर्षात्पाण्डवः क्रुद्धः शरवर्षाणि मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2055046, "chapter_id": 2204, "verse_number": "७-१३१-३०", "content_sanskrit": "तस्य तानीषुवर्षाणि मत्तद्विरदगामिनः।\nसूतपुत्रोऽस्त्रमायाभिरग्रसत्परमास्त्रवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2055047, "chapter_id": 2204, "verse_number": "७-१३१-३१", "content_sanskrit": "स यथावन्महाबाहुर्विद्यया वै सुपूजितः।\nआचार्यवन्महेष्वासः कर्णः पर्यचरद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2055048, "chapter_id": 2204, "verse_number": "७-१३१-३२", "content_sanskrit": "युध्यमानं तु संरम्भाद्भीमसेनं हसन्निव।\nअभ्यपद्यत कौन्तेयं कर्णो राजन्वृकोदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2055049, "chapter_id": 2204, "verse_number": "७-१३१-३३", "content_sanskrit": "तन्नामृष्यत कौन्तेयः कर्णस्य स्मितमाहवे।\nयुध्यमानेषु वीरेषु पश्यत्सु च समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2055050, "chapter_id": 2204, "verse_number": "७-१३१-३४", "content_sanskrit": "तं भीमसेनः सङ्ग्राप्तं वत्सदन्तैः स्तनान्तरे।\nविव्याध बलवान्क्रुद्धस्तोत्रैरिव महाद्विपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2055051, "chapter_id": 2204, "verse_number": "७-१३१-३५", "content_sanskrit": "पुनश्च सूतपुत्रं तु स्वर्णपुङ्खैः शिलाशितैः।\nसुमुक्तैश्चित्रवर्माणं निर्बिभेद त्रिसप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2055052, "chapter_id": 2204, "verse_number": "७-१३१-३६", "content_sanskrit": "कर्णो जाम्बूनदैर्जालैः सञ्छन्नान्वातरंहसः।\nहयान्विव्याध भीमस्य पञ्चभिः पञ्चभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2055053, "chapter_id": 2204, "verse_number": "७-१३१-३७", "content_sanskrit": "ततो बाणमयं जलं भीमसेनरथं प्रति।\nकर्णेन विहितं राजन्निमेषार्धाददृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2055054, "chapter_id": 2204, "verse_number": "७-१३१-३८", "content_sanskrit": "सरथः सध्वजस्तत्र ससूतः पाण्डवस्तदा।\nप्राच्छाद्यत महाराज कर्णचापच्युतैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2055055, "chapter_id": 2204, "verse_number": "७-१३१-३९", "content_sanskrit": "तस्य कर्णश्चतुःषष्ट्या व्यधमत्कवचं दृढम्।\nक्रुद्धश्चाप्यहनत्पार्थं नाराचैर्मर्मभेदिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2055056, "chapter_id": 2204, "verse_number": "७-१३१-४०", "content_sanskrit": "ततोऽचिन्त्य महाबाहुः कर्णकार्मुकनिःसृतान्।\nसमाश्लिष्यदसम्भ्रान्तः सूतपुत्रं वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2055057, "chapter_id": 2204, "verse_number": "७-१३१-४१", "content_sanskrit": "स कर्णचापप्रभवानिषूनाशीविषोपमान्।\nबिभ्रद्भीमो महाराज न जगाम व्यथां रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2055058, "chapter_id": 2204, "verse_number": "७-१३१-४२", "content_sanskrit": "ततो द्वात्रिंशता भल्लैर्निशितैस्तिग्मतेजनैः।\nविव्याध समरे कर्णं भीमसेनः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2055059, "chapter_id": 2204, "verse_number": "७-१३१-४३", "content_sanskrit": "अयत्नेनैव तं कर्णः शरैर्भृशमवाकिरत्।\nभीमसेनं महाबाहुं सैन्धवस्य वधैषिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2055060, "chapter_id": 2204, "verse_number": "७-१३१-४४", "content_sanskrit": "मृदुपूर्वं तु राधेयो भीममाजावयोधयत्।\nक्रोधपूर्वं तथा भीमः पूर्ववैरमनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2055061, "chapter_id": 2204, "verse_number": "७-१३१-४५", "content_sanskrit": "तं भीमसेनो नामृष्यदवमानममर्षणः।\nस तस्मै व्यसृजत्तूर्णं शरवर्षममित्रहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2055062, "chapter_id": 2204, "verse_number": "७-१३१-४६", "content_sanskrit": "ते शराः प्रेषितास्तेन भीमसेनेन संयुगे।\nनिपेतुः सर्वतो वीरे कूजन्त इव पक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2055063, "chapter_id": 2204, "verse_number": "७-१३१-४७", "content_sanskrit": "हेमपुङ्खा महावेगा भीमसेनधनुश्च्युताः।\nप्राच्छादयंस्ते राधेयं शलभा इव पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2055064, "chapter_id": 2204, "verse_number": "७-१३१-४८", "content_sanskrit": "कर्णस्तु रथिनां श्रेष्ठश्छाद्यमानः समन्ततः।\nराजन्व्यसृजदुग्राणि शरवर्षाणि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2055065, "chapter_id": 2204, "verse_number": "७-१३१-४९", "content_sanskrit": "तस्य तानशनिप्रख्यानिषून्समरशोभिनः।\nचिच्छेद बहुभिर्भल्लैरसम्प्राप्तान्वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2055066, "chapter_id": 2204, "verse_number": "७-१३१-५०", "content_sanskrit": "पुनश्च शरवर्षेण च्छादयामास भारत।\nकर्णो वैकर्तनो युद्धे भीमसेनमरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2055067, "chapter_id": 2204, "verse_number": "७-१३१-५१", "content_sanskrit": "तत्र भारत भीमं तु दृष्टवन्तः स्म सायकैः।\nसमाचिततनुं सङ्ख्ये श्वाविधं शललैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2055068, "chapter_id": 2204, "verse_number": "७-१३१-५२", "content_sanskrit": "हेमपुङ्खाञ्छिलाधौतान्कर्णचापच्युताञ्छरान्।\nदधार समरे वीरः स्वरश्मीनिव रश्मिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2055069, "chapter_id": 2204, "verse_number": "७-१३१-५३", "content_sanskrit": "रुधिरोक्षितसर्वाङ्गो भीमसेनो व्यराजत।\nसमृद्धकुसुमापीडो वसन्तेऽशोकवृक्षवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2055070, "chapter_id": 2204, "verse_number": "७-१३१-५४", "content_sanskrit": "तत्तु भीमो महाबाहोः कर्णस्य चरितं रणे।\nनामृष्यत महाबाहुः क्रोधादुद्वृत्तलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2055071, "chapter_id": 2204, "verse_number": "७-१३१-५५", "content_sanskrit": "स कर्णं पञ्चविंशत्या नाराचानां समार्पयत्।\nमहीधरमिव श्वेतं गूढपादैर्विषोल्बणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2055072, "chapter_id": 2204, "verse_number": "७-१३१-५६", "content_sanskrit": "पुनरेव च विव्याध षङ्भिरष्टाभिरेव च।\nमर्मस्वमरविक्रान्तः सूतपुत्रं तनुत्यजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2055073, "chapter_id": 2204, "verse_number": "७-१३१-५७", "content_sanskrit": "पुनरन्येन बाणेन भीमसेनः प्रतापवान्।\nचिच्छेद कार्मुकं तूर्णं कर्णस्य प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2055074, "chapter_id": 2204, "verse_number": "७-१३१-५८", "content_sanskrit": "जघान चतुरश्चाश्वान्सूतं च त्वरितः शरैः।\nनाराचैरर्करश्म्याभैः कर्णं विव्याध चोरसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2055075, "chapter_id": 2204, "verse_number": "७-१३१-५९", "content_sanskrit": "ते जग्मुर्धरणीमाशु कर्णं निर्भिद्य पत्रिणः।\nयथा जलधरं भित्त्वा दिवाकरमरीचयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2055076, "chapter_id": 2204, "verse_number": "७-१३१-६०", "content_sanskrit": "स वैक्लव्यं महत्प्राप्य च्छिन्नधन्वा शराहतः।\nतथा पुरुषमानी स लज्जामुत्सृज्य भारत।\nभीमसेनभयात्कर्णः प्रत्यपायाद्रथान्तरम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2055077, "chapter_id": 2204, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे एकत्रिंशदधिकशततमोऽध्यायः॥ १३१ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१३१-११ पूर्वमुद्योगे दर्शितमुद्भाविवं भ्रातूत्वं कुन्त्या वाक्यं च चतुर्णमवध्यत्वलक्षणं चानुस्मरन्नित्यन्वयः॥ ५-१३१-२५ अभितः सम्मुखे॥ ५-१३१-१३१ एकत्रिंशदधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]