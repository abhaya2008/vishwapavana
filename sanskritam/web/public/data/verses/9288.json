[{"id": 40018519, "chapter_id": 9288, "verse_number": "1", "content_sanskrit": "महोदरमहापार्श्वौहतौदृष्टवातुराक्ष । तस्मिंश्चनिहतेवीरेविरूपाक्षेमहाबले ॥ आविवेशमहान् क्रोधोरावणंतुमहामृधे । सूतं सञ्चोदयामास वाक्यं चेदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018520, "chapter_id": 9288, "verse_number": "2", "content_sanskrit": "महोदरमहापार्श्वौहतौदृष्टवातुराक्ष । तस्मिंश्चनिहतेवीरेविरूपाक्षेमहाबले ॥ आविवेशमहान् क्रोधोरावणंतुमहामृधे । सूतं सञ्चोदयामास वाक्यं चेदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018521, "chapter_id": 9288, "verse_number": "3", "content_sanskrit": "निहतानाममात्यानांरुद्धस्यनगरस्य च । दुःखमेवापनेष्यामि हत्या तौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018522, "chapter_id": 9288, "verse_number": "4", "content_sanskrit": "रामवृक्षंरणेहमनिसीतापुष्पफलप्रदम् । प्रशाखायस्यसुग्रीवोजाम्बवान्कुमुदोनलः ॥ दिविदश्चैवमैन्दश्चअङ्गदोगन्दमादनः । हनुमांश्चसुषेणव्चसर्वे च हरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018523, "chapter_id": 9288, "verse_number": "5", "content_sanskrit": "रामवृक्षंरणेहमनिसीतापुष्पफलप्रदम् । प्रशाखायस्यसुग्रीवोजाम्बवान्कुमुदोनलः ॥ दिविदश्चैवमैन्दश्चअङ्गदोगन्दमादनः । हनुमांश्चसुषेणव्चसर्वे च हरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018524, "chapter_id": 9288, "verse_number": "6", "content_sanskrit": "स दिशोदशघोषेणरथस्यातिरथोमहान् । नादयन् प्रययौतूर्णंराघवंचाभ्यधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018525, "chapter_id": 9288, "verse_number": "7", "content_sanskrit": "पूरितातेनशब्देनसनदीगिरिकानना । सञ्चचाल मही सर्वा त्रस्तसिंहमृगद्विजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018526, "chapter_id": 9288, "verse_number": "8", "content_sanskrit": "तामसंसुमहाघोरंचकारास्त्रंसुदारुणम् । निर्ददाहकपीन् सर्वांस्तेप्रपेतुःसमन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018527, "chapter_id": 9288, "verse_number": "9", "content_sanskrit": "उत्पपातरजोभूमौतैर्भग्नैःसम्प्रधावितैः । न हितत्सहितुंशेकुर्भ्रह्मणानिर्मितंस्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018528, "chapter_id": 9288, "verse_number": "10", "content_sanskrit": "तान्यनीकान्यनेकानि रावणस्य शरोत्तमैः । दृष्टवाभग्नानि शतशो राघवः पर्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018529, "chapter_id": 9288, "verse_number": "11", "content_sanskrit": "ततोराक्षसशार्दूलोविद्राव्यहरिवाहिनीम् । स ददर्शततोरामंतिष्ठन्तमपराजितम् ॥ लक्ष्मणेनसहभ्रात्राविष्णुनावासवंयथा । अलिखन्तमिवाकाशमवष्टभ्यमहद्धनुः ॥ पद्मपत्रविशालाक्षंदीर्घबाहुमरिन्दमम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018530, "chapter_id": 9288, "verse_number": "12", "content_sanskrit": "ततोराक्षसशार्दूलोविद्राव्यहरिवाहिनीम् । स ददर्शततोरामंतिष्ठन्तमपराजितम् ॥ लक्ष्मणेनसहभ्रात्राविष्णुनावासवंयथा । अलिखन्तमिवाकाशमवष्टभ्यमहद्धनुः ॥ पद्मपत्रविशालाक्षंदीर्घबाहुमरिन्दमम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018531, "chapter_id": 9288, "verse_number": "13", "content_sanskrit": "ततोरामोमहातेजाःसौमित्रिसहितोबली ॥ वानरांश्चरणेभग्नानापतन्तं च रावणम् । समीक्ष्यराघवोहृष्टोमध्येजग्राहकार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018532, "chapter_id": 9288, "verse_number": "14", "content_sanskrit": "ततोरामोमहातेजाःसौमित्रिसहितोबली ॥ वानरांश्चरणेभग्नानापतन्तं च रावणम् । समीक्ष्यराघवोहृष्टोमध्येजग्राहकार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018533, "chapter_id": 9288, "verse_number": "15", "content_sanskrit": "विस्फारयितुमारेभेततः स धनुरुत्तमम् । महावेगंमहानादंनिर्भन्दन्निवमेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40018534, "chapter_id": 9288, "verse_number": "16", "content_sanskrit": "रावणस्य च बाणौघैरामविस्फारितेन च । शब्देनराक्षसास्तेन पेतुश्च शतशस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40018535, "chapter_id": 9288, "verse_number": "17", "content_sanskrit": "तयोःशरपथंप्राप्यरावणोराजपुत्रयोः । स बभौ च यथाराहुःसमीपशशिसूर्ययोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40018536, "chapter_id": 9288, "verse_number": "18", "content_sanskrit": "तमिच्छन् प्रधमम् योद्धुंलक्ष्मणोनिशितैःशरैः । मुमोचधनुरायम्यशरानग्निशिखोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018537, "chapter_id": 9288, "verse_number": "19", "content_sanskrit": "तान्मुक्तमात्रानाकाशे लक्ष्मणेन धनुष्मता । बाणान् बाणैर्महातेजा रावणः प्रत्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018538, "chapter_id": 9288, "verse_number": "20", "content_sanskrit": "एकमेकेनबाणेनत्रिभिस्त्रीन् दशभिर्दश । लक्ष्मणस्य प्रचिच्छेद दर्शयन् पाणिलाघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018539, "chapter_id": 9288, "verse_number": "21", "content_sanskrit": "अभ्यतिक्रम्यसौमित्रिंरावणःसमितिञ्जयः । आससादरणेरामंस्थितंशैलमिवापरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40018540, "chapter_id": 9288, "verse_number": "22", "content_sanskrit": "स राघवंसमासाद्यक्रोधसंरक्तलोचनः । व्यसृजच्छरवर्षाणिरावणो राक्षसेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40018541, "chapter_id": 9288, "verse_number": "23", "content_sanskrit": "शराधारास्ततोरामोरावणस्यधनुश्च्युताः । दृष्टवैवापतिताःशीघ्रंभल्लान् जग्राहसत्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40018542, "chapter_id": 9288, "verse_number": "24", "content_sanskrit": "तान् शरौघांस्ततोभल्लैस्तीक्ष्णैश्चिच्छेदराघवः । दीप्यमानान् महाघोरान्क्रुद्धानाशीविषानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40018543, "chapter_id": 9288, "verse_number": "25", "content_sanskrit": "राघवोरावणंतूर्णंरावणोराघवंतथा । अन्योन्यंविविधैस्तीक्ष्णैःशरवर्षैर्ववर्षतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40018544, "chapter_id": 9288, "verse_number": "26", "content_sanskrit": "चेरतुश्चचिरंचित्रंमण्डलंसव्यदक्षिणम् । बाणवेगात्समुत्क्षिप्तावन्योन्यमपराजितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40018545, "chapter_id": 9288, "verse_number": "27", "content_sanskrit": "तयोर्भूतानिवित्रेसुर्युगपत्सम्प्रयुध्यतोः । रौद्रयोःसायकमुचोर्यमान्तकनिकाशयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40018546, "chapter_id": 9288, "verse_number": "28", "content_sanskrit": "सततंविविधैर्बाणैर्बभूवगगनंतदा । घनैरिवातपापायेविद्युन्मालाससमाकुलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40018547, "chapter_id": 9288, "verse_number": "29", "content_sanskrit": "गवाक्षितमिवाकाशंबभूवशरवृष्टिभिः । महावेगैस्सुतीक्ष्णैग्रैर्गृध्रपत्रैःसुवाजितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40018548, "chapter_id": 9288, "verse_number": "30", "content_sanskrit": "शरान्धकारमाकाशंचक्रतुःप्रथमंतदा । गतेऽस्तं तपने चापि महामेघाविवोथतितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40018549, "chapter_id": 9288, "verse_number": "31", "content_sanskrit": "तयोरभून्महद्युद्धमन्योन्यवथकाङ्क्षिणोः । अनासाद्यमच्नित्यं च वृत्रवासवयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40018550, "chapter_id": 9288, "verse_number": "32", "content_sanskrit": "उभौहिपरमेष्वासावुभौयुद्धविशारदौ । उभावस्त्रविदां मुख्यावुभौ युद्धेविचेरतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40018551, "chapter_id": 9288, "verse_number": "33", "content_sanskrit": "उभौहियेनव्रजतस्तेनतेनशरोर्मयः । ऊर्मयोवायुनाविद्धा जग्मुः सागरयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40018552, "chapter_id": 9288, "verse_number": "34", "content_sanskrit": "ततःसंसक्तहस्तस्तुरावणोलोकरावणः । नराचमालांरामस्यललाटेप्रत्यमुञ्चत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40018553, "chapter_id": 9288, "verse_number": "35", "content_sanskrit": "रौद्रचापप्रयुक्तांतांनीलोत्पलदलप्रभाम् । शिरसाधारयद्रामो न व्यथमभ्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40018554, "chapter_id": 9288, "verse_number": "36", "content_sanskrit": "अथमन्त्रानभिजपन्रौद्रमस्तमुदीरयन् । शरान् भूयःसमादाय रामः क्रोधसमन्वितः ॥ मुमोच च महातेजाश्चापमायम्यवीर्यवान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40018555, "chapter_id": 9288, "verse_number": "37", "content_sanskrit": "तेमहामेघसङ्काशेकवचेपतिताःशराः ॥ अवध्येराक्षसेन्द्रस्य न व्यथांजनयंस्तदा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40018556, "chapter_id": 9288, "verse_number": "38", "content_sanskrit": "पुनरेवाधतंरामोरथस्थंराक्षसाधिपम् ॥ ललाटेपरमास्त्रणसर्वास्त्रकुशलोऽभिनत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40018557, "chapter_id": 9288, "verse_number": "39", "content_sanskrit": "तेभित्त्वाबाणरूपाणिपञ्चशीर्षाइवोरगाः ॥ श्वसन्तोविविशुर्भूमिंरावणप्रतिकूलिताः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40018558, "chapter_id": 9288, "verse_number": "40", "content_sanskrit": "निहत्यराघवस्यास्त्रंरावणःक्रोधमूर्छितः ॥ असुरंसुमहाघोरमन्यदस्त्रं चकारसः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40018559, "chapter_id": 9288, "verse_number": "41", "content_sanskrit": "सिंहव्याघ्रमुखांश्चापिकङ्ककाकमुखानपि ॥ गृध्रश्येनमुखांश्चापिशृगाववदनांस्तथा । ईहामृगमुखांश्चापिव्यादितास्यान् भयावहान् ॥ पञ्चास्यान् लेलिहानांश्चससर्जनिशितान् शरान् ।", "padaccheda": "", "anvay