[{"id": 5000288000, "chapter_id": 9288, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे षोडशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000288001, "chapter_id": 9288, "verse_number": "४-१६-१", "content_sanskrit": "तामेवं ब्रुवतीं तारां ताराधिपनिभाननाम्।\nवाली निर्भर्त्सयामास वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000288002, "chapter_id": 9288, "verse_number": "४-१६-२", "content_sanskrit": "गर्जतोऽस्य सुसंरब्धं भ्रातुः शत्रोर्विशेषतः।\nमर्षयिष्यामि केनापि कारणेन वरानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000288003, "chapter_id": 9288, "verse_number": "४-१६-३", "content_sanskrit": "अधर्षितानां शूराणां समरेष्वनिवर्तिनाम्।\nधर्षणामर्षणं भीरु मरणादतिरिच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000288004, "chapter_id": 9288, "verse_number": "४-१६-४", "content_sanskrit": "सोढुं न च समर्थोऽहं युद्धकामस्य संयुगे।\nसुग्रीवस्य च संरम्भं हीनग्रीवस्य गर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000288005, "chapter_id": 9288, "verse_number": "४-१६-५", "content_sanskrit": "न च कार्यो विषादस्ते राघवं प्रति मत्कृते।\nधर्मज्ञश्च कृतज्ञश्च कथं पापं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000288006, "chapter_id": 9288, "verse_number": "४-१६-६", "content_sanskrit": "निवर्तस्व सह स्त्रीभिः कथं भूयोऽनुगच्छसि।\nसौहृदं दर्शितं तावन्मयि भक्तिस्त्वया कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000288007, "chapter_id": 9288, "verse_number": "४-१६-७", "content_sanskrit": "प्रतियोत्स्याम्यहं गत्वा सुग्रीवं जहि सम्भ्रमम्।\nदर्पं चास्य विनेष्यामि न च प्राणैर्वियोक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000288008, "chapter_id": 9288, "verse_number": "४-१६-८", "content_sanskrit": "अहं ह्याजिस्थितस्यास्य करिष्यामि यदीप्सितम्।\nवृक्षैर्मुष्टिप्रहारैश्च पीडितः प्रतियास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000288009, "chapter_id": 9288, "verse_number": "४-१६-९", "content_sanskrit": "न मे गर्वितमायस्तं सहिष्यति दुरात्मवान्।\nकृतं तारे सहायत्वं दर्शितं सौहृदं मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000288010, "chapter_id": 9288, "verse_number": "४-१६-१०", "content_sanskrit": "शापितासि मम प्राणैर्निवर्तस्व जनेन च।\nअलं जित्वा निवर्तिष्ये तमहं भ्रातरं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000288011, "chapter_id": 9288, "verse_number": "४-१६-११", "content_sanskrit": "तं तु तारा परिष्वज्य वालिनं प्रियवादिनी।\nचकार रुदती मन्दं दक्षिणा सा प्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000288012, "chapter_id": 9288, "verse_number": "४-१६-१२", "content_sanskrit": "ततः स्वस्त्ययनं कृत्वा मन्त्रविद् विजयैषिणी।\nअन्तःपुरं सह स्त्रीभिः प्रविष्टा शोकमोहिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000288013, "chapter_id": 9288, "verse_number": "४-१६-१३", "content_sanskrit": "प्रविष्टायां तु तारायां सह स्त्रीभिः स्वमालयम्।\nनगर्या निर्ययौ क्रुद्धो महासर्प इव श्वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000288014, "chapter_id": 9288, "verse_number": "४-१६-१४", "content_sanskrit": "स निःश्वस्य महारोषो वाली परमवेगवान्।\nसर्वतश्चारयन् दृष्टिं शत्रुदर्शनकांक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000288015, "chapter_id": 9288, "verse_number": "४-१६-१५", "content_sanskrit": "स ददर्श ततः श्रीमान् सुग्रीवं हेमपिङ्गलम्।\nसुसंवीतमवष्टब्धं दीप्यमानमिवानलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000288016, "chapter_id": 9288, "verse_number": "४-१६-१६", "content_sanskrit": "तं स दृष्ट्वा महाबाहुः सुग्रीवं पर्यवस्थितम्।\nगाढं परिदधे वासो वाली परमकोपनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000288017, "chapter_id": 9288, "verse_number": "४-१६-१७", "content_sanskrit": "स वाली गाढसंवीतो मुष्टिमुद्यम्य वीर्यवान्।\nसुग्रीवमेवाभिमुखो ययौ योद्धुं कृतक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000288018, "chapter_id": 9288, "verse_number": "४-१६-१८", "content_sanskrit": "श्लिष्टं मुष्टिं समुद्यम्य संरब्धतरमागतः।\nसुग्रीवोऽपि समुद्दिश्य वालिनं हेममालिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000288019, "chapter_id": 9288, "verse_number": "४-१६-१९", "content_sanskrit": "तं वाली क्रोधताम्राक्षः सुग्रीवं रणकोविदम्।\nआपतन्तं महावेगमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000288020, "chapter_id": 9288, "verse_number": "४-१६-२०", "content_sanskrit": "एष मुष्टिर्महान् बद्धो गाढः सुनियताङ्गुलिः।\nमया वेगविमुक्तस्ते प्राणानादाय यास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000288021, "chapter_id": 9288, "verse_number": "४-१६-२१", "content_sanskrit": "एवमुक्तस्तु सुग्रीवः क्रुद्धो वालिनमब्रवीत्।\nतव चैष हरन् प्राणान् मुष्टिः पततु मूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000288022, "chapter_id": 9288, "verse_number": "४-१६-२२", "content_sanskrit": "ताडितस्तेन तं क्रुद्धः समभिक्रम्य वेगतः।\nअभवच्छोणितोद‍्गारी सापीड इव पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000288023, "chapter_id": 9288, "verse_number": "४-१६-२३", "content_sanskrit": "सुग्रीवेण तु निःशङ्कं सालमुत्पाट्य तेजसा।\nगात्रेष्वभिहतो वाली वज्रेणेव महागिरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000288024, "chapter_id": 9288, "verse_number": "४-१६-२४", "content_sanskrit": "स तु वृक्षेण निर्भग्नः सालताडनविह्वलः।\nगुरुभारभराक्रान्ता नौः ससार्थेव सागरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000288025, "chapter_id": 9288, "verse_number": "४-१६-२५", "content_sanskrit": "तौ भीमबलविक्रान्तौ सुपर्णसमवेगितौ।\nप्रवृद्धौ घोरवपुषौ चन्द्रसूर्याविवाम्बरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000288026, "chapter_id": 9288, "verse_number": "४-१६-२६", "content_sanskrit": "परस्परममित्रघ्नौ छिद्रान्वेषणतत्परौ।\nततोऽवर्धत वाली तु बलवीर्यसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000288027, "chapter_id": 9288, "verse_number": "४-१६-२७", "content_sanskrit": "सूर्यपुत्रो महावीर्यः सुग्रीवः परिहीयत।\nवालिना भग्नदर्पस्तु सुग्रीवो मन्दविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000288028, "chapter_id": 9288, "verse_number": "४-१६-२८", "content_sanskrit": "वालिनं प्रति सामर्षो दर्शयामास राघवम्।\nवृक्षैः सशाखैः शिखरैर्वज्रकोटिनिभैर्नखैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000288029, "chapter_id": 9288, "verse_number": "४-१६-२९", "content_sanskrit": "मुष्टिभिर्जानुभिः पद्भिर्बाहुभिश्च पुनः पुनः।\nतयोर्युद्धमभूद‍्घोरं वृत्रवासवयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000288030, "chapter_id": 9288, "verse_number": "४-१६-३०", "content_sanskrit": "तौ शोणिताक्तौ युध्येतां वानरौ वनचारिणौ।\nमेघाविव महाशब्दैस्तर्जमानौ परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000288031, "chapter_id": 9288, "verse_number": "४-१६-३१", "content_sanskrit": "हीयमानमथापश्यत् सुग्रीवं वानरेश्वरम्।\nप्रेक्षमाणं दिशश्चैव राघवः स मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000288032, "chapter_id": 9288, "verse_number": "४-१६-३२", "content_sanskrit": "ततो रामो महातेजा आर्तं दृष्ट्वा हरीश्वरम्।\nस शरं वीक्षते वीरो वालिनो वधकांक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000288033, "chapter_id": 9288, "verse_number": "४-१६-३३", "content_sanskrit": "ततो धनुषि संधाय शरमाशीविषोपमम्।\nपूरयामास तच्चापं कालचक्रमिवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000288034, "chapter_id": 9288, "verse_number": "४-१६-३४", "content_sanskrit": "तस्य ज्यातलघोषेण त्रस्ताः पत्ररथेश्वराः।\nप्रदुद्रुवुर्मृगाश्चैव युगान्त इव मोहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000288035, "chapter_id": 9288, "verse_number": "४-१६-३५", "content_sanskrit": "मुक्तस्तु वज्रनिर्घोषः प्रदीप्ताशनिसंनिभः।\nराघवेण महाबाणो वालिवक्षसि पातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000288036, "chapter_id": 9288, "verse_number": "४-१६-३६", "content_sanskrit": "ततस्तेन महातेजा वीर्ययुक्तः कपीश्वरः।\nवेगेनाभिहतो वाली निपपात महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000288037, "chapter_id": 9288, "verse_number": "४-१६-३७", "content_sanskrit": "इन्द्रध्वज इवोद‍्धूतः पौर्णमास्यां महीतले।\nआश्वयुक्समये मासि गतश्रीको विचेतनः।\nबाष्पसंरुद्धकण्ठस्तु वाली चार्तस्वरः शनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000288038, "chapter_id": 9288, "verse_number": "४-१६-३८", "content_sanskrit": "नरोत्तमः कालयुगान्तकोपमं\nशरोत्तमं काञ्चनरूप्यभूषितम्।\nससर्ज दीप्तं तममित्रमर्दनं\nसधूममग्निं मुखतो यथा हरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000288039, "chapter_id": 9288, "verse_number": "४-१६-३९", "content_sanskrit": "अथोक्षितः शोणिततोयविस्रवैः\nसुपुष्पिताशोक इवानिलोद्धतः।\nविचेतनो वासवसूनुराहवे\nप्रभ्रंशितेन्द्रध्वजवत् क्षितिं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000288040, "chapter_id": 9288, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे षोडशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]