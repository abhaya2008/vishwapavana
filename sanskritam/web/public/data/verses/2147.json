[{"id": 2051923, "chapter_id": 2147, "verse_number": "७-७४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2051924, "chapter_id": 2147, "verse_number": "७-७४-१", "content_sanskrit": "श्रुत्वा तु तं महाशब्दं पाण्डूनां पुत्रगृद्धिनाम्।\nचारैः प्रवेदितस्त्रस्तः समुत्थाय जयद्रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2051925, "chapter_id": 2147, "verse_number": "७-७४-२", "content_sanskrit": "शोकसम्मूढहृदयो दुःखेनाभ्याहतो भृशम्।\nमज्जमान इवागाधे विपुले शोकसागरे।\nजगाम समितिं राज्ञां सैन्धवो विमृशन्बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2051926, "chapter_id": 2147, "verse_number": "७-७४-३", "content_sanskrit": "स तेषां नरदेवानां सकाशे पर्यदेवयत्।\nअभिमन्युपितुर्भीतः सव्रीडो वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2051927, "chapter_id": 2147, "verse_number": "७-७४-४", "content_sanskrit": "योऽसौ पाण्डोः किल क्षेत्रे जातः शक्रेण कामिना।\nस निनीषति दुर्बुद्धिर्मां किलैकं यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2051928, "chapter_id": 2147, "verse_number": "७-७४-५", "content_sanskrit": "स्वस्ति वोऽस्तु गमिष्यामि स्वगृहं जीवितेप्सया।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2051929, "chapter_id": 2147, "verse_number": "७-७४-६", "content_sanskrit": "अथवास्त्रप्रतिबलास्त्रात मां क्षत्रियर्षभाः।\nपार्थेन प्रार्थितं वीरास्ते सन्दत्त ममाभयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2051930, "chapter_id": 2147, "verse_number": "७-७४-७", "content_sanskrit": "द्रोणदुर्योधनकृपाः कर्णमद्रेशबाह्लिकाः।\nदुःशासनादयः शक्तास्त्रातुमप्यन्तकार्दितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2051931, "chapter_id": 2147, "verse_number": "७-७४-८", "content_sanskrit": "किमङ्ग पुनरेकेन फल्गुनेन जिघांसता।\nन त्रास्यन्ति भवन्तो मां समस्ताः पतयः क्षितेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2051932, "chapter_id": 2147, "verse_number": "७-७४-९", "content_sanskrit": "प्रतिज्ञां पाण्डवेयानां श्रुत्वा मम महद्भयम्।\nसीदन्ति मम गात्राणि मुमूर्षोरिव पार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2051933, "chapter_id": 2147, "verse_number": "७-७४-१०", "content_sanskrit": "वधो नूनं प्रतिज्ञातो मम गाण्डीवधन्वना।\nतथाहि हृष्टाः क्रोशन्ति शोककालेऽपि पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2051934, "chapter_id": 2147, "verse_number": "७-७४-११", "content_sanskrit": "तन्न देवा न गन्धर्वा नासुरोरगराक्षसाः।\nउत्सहन्तेऽन्यथा कर्तुं कुत एव नराधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2051935, "chapter_id": 2147, "verse_number": "७-७४-१२", "content_sanskrit": "तस्मान्मामनुजानीत भद्रं वोऽस्तु नरर्षभाः।\nअदर्शनं गमिष्यामि न मां द्रक्ष्यन्ति पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2051936, "chapter_id": 2147, "verse_number": "७-७४-१३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2051937, "chapter_id": 2147, "verse_number": "७-७४-१३", "content_sanskrit": "एवं विलपमानं तं भयाद्व्याकुलचेतसम्।\nआत्मकार्यगरीयस्त्वाद्राजा दुर्योधनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2051938, "chapter_id": 2147, "verse_number": "७-७४-१४", "content_sanskrit": "न भेतव्यं नरव्याघ्र को हि त्वां पुरुषर्षभ।\nमध्ये क्षत्रियवीराणां तिष्ठन्तं प्रार्थयेद्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2051939, "chapter_id": 2147, "verse_number": "७-७४-१५", "content_sanskrit": "`एतेषां नरदेवानां मत्तमातङ्गगामिनाम्।\nसङ्घातमुपयातानामपि विभ्येत्पुरन्दरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2051940, "chapter_id": 2147, "verse_number": "७-७४-१६", "content_sanskrit": "अहं वैकर्तनः कर्णश्चित्रसेनो विविंशतिः।\nभूरिश्रवाः शलः शल्यो वृषसेनो दुरासदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2051941, "chapter_id": 2147, "verse_number": "७-७४-१७", "content_sanskrit": "पुरुमित्रो जयो भोजः काम्भोजश्च सुदक्षिणः।\nसत्यव्रतो महाबाहुर्विकर्णो दुर्मुखश्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2051942, "chapter_id": 2147, "verse_number": "७-७४-१८", "content_sanskrit": "दुःशासनः सुबाहुश्च कालिङ्गश्चाप्युदायुधः।\nविन्दानुविन्दावावन्त्यौ द्रोणो द्रौणिश्च सौबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2051943, "chapter_id": 2147, "verse_number": "७-७४-१९", "content_sanskrit": "`मायावी बलवाञ्छूरो राक्षसश्चाप्यलम्बुसः।\nएते चान्ये च बहवो नानाजनपदेश्वराः।\nससैन्यास्त्वाभिगोप्स्यन्ति व्येतु ते मानसो ज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2051944, "chapter_id": 2147, "verse_number": "७-७४-२०", "content_sanskrit": "त्वं चापि रथिनां श्रेष्ठः स्वयं शूरोऽमितद्युते।\nस कथं पाण्डवेयेभ्यो भयं पश्यसि वैन्धव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2051945, "chapter_id": 2147, "verse_number": "७-७४-२१", "content_sanskrit": "अक्षौहिण्यो महावीर्य मदीयास्तव रक्षणे।\nयत्ता योत्स्यन्ति माभैस्त्वं सैन्धव व्येतु ते भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2051946, "chapter_id": 2147, "verse_number": "७-७४-२२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2051947, "chapter_id": 2147, "verse_number": "७-७४-२२", "content_sanskrit": "एवमाश्वासितो राजन्पुत्रेण तव सैन्धवः।\nदुर्योधनेन सहितो द्रोणं रात्रावुपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2051948, "chapter_id": 2147, "verse_number": "७-७४-२३", "content_sanskrit": "उपसङ्गृह्य चरणौ द्रोणाय स विशाम्पतिः।\nउपोपविश्य प्रणतः पर्यपृच्छदिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2051949, "chapter_id": 2147, "verse_number": "७-७४-२४", "content_sanskrit": "निमित्ते दूरपातित्वे लघुत्वे दृढवेधने।\nमम ब्रवीतु भगवान्विशेषं फल्गुनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2051950, "chapter_id": 2147, "verse_number": "७-७४-२५", "content_sanskrit": "विद्याविशेषमिच्छामि ज्ञातुमाचार्य तत्त्वतः।\nअर्जुनस्यात्मनश्चैव याथातथ्यं प्रचक्ष्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2051951, "chapter_id": 2147, "verse_number": "७-७४-२६x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2051952, "chapter_id": 2147, "verse_number": "७-७४-२६", "content_sanskrit": "सममाचार्यकं तात तव चैवार्जुनस्य च।\nयोगाद्दुःखोषितत्वाच्च तस्मात्त्वत्तोऽधिकोऽर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2051953, "chapter_id": 2147, "verse_number": "७-७४-२७", "content_sanskrit": "न तु ते युधि सन्त्रासः कार्यः पार्थात्कथञ्चन।\nअहं हि रक्षिता तात भयात्त्वां नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2051954, "chapter_id": 2147, "verse_number": "७-७४-२८", "content_sanskrit": "न हि मद्बाहुगुप्तस्य प्रभवन्त्यमरा अपि।\nव्यूहयिष्यामि तं व्यूहं यं पार्थो न तरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2051955, "chapter_id": 2147, "verse_number": "७-७४-२९", "content_sanskrit": "तस्माद्युध्यस्व माभैस्त्वं स्वधर्ममनुपालय।\nपितृपैतामहं मार्गमनुयाहि महारथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2051956, "chapter_id": 2147, "verse_number": "७-७४-३०", "content_sanskrit": "अधीता विधिवद्वेदा अग्नयः सुहुतास्त्वया।\nइष्टं च बहुभिर्यज्ञैर्न ते मृत्युर्भयङ्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2051957, "chapter_id": 2147, "verse_number": "७-७४-३१", "content_sanskrit": "दुर्लभं मानुषैर्मन्दैर्महाभाग्यमवाप्य तु।\nभुजवीर्यार्जिताँल्लोकान्दिव्यान्प्राप्स्यस्यनुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2051958, "chapter_id": 2147, "verse_number": "७-७४-३२", "content_sanskrit": "कुरवः पाण्डवाश्चैव वृष्णयोऽन्ये च मानवाः।\nअहं च सहपुत्रेण अध्रुवा इति चिन्त्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2051959, "chapter_id": 2147, "verse_number": "७-७४-३३", "content_sanskrit": "पर्यायेण वयं सर्वे कालेन बलिना हताः।\nपरलोकं गमिष्यामः स्वैःस्वैः कर्मभिरन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2051960, "chapter_id": 2147, "verse_number": "७-७४-३४", "content_sanskrit": "तपस्तप्त्वा तु याँल्लोकान्प्राप्नुवन्ति तपस्विनः।\nक्षत्रधर्माश्रिताः वीराः क्षत्रियाः प्राप्नुवन्ति तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2051961, "chapter_id": 2147, "verse_number": "७-७४-३५", "content_sanskrit": "एवमाश्वासितो राजा भारद्वाजेन सैन्धवः।\nअपानुदद्भयं पार्थाद्युद्धाय च मनो दधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2051962, "chapter_id": 2147, "verse_number": "७-७४-३६", "content_sanskrit": "ततः प्रहर्षः सैन्यानां तस्य चासीद्विशाम्पते।\nवादित्राणां ध्वनिश्चोग्रः सिंहनादरवैः सह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2051963, "chapter_id": 2147, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि प्रतिज्ञापर्वणि चतुःसप्ततितमोऽध्यायः॥ ७४ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-७४-४ किलेत्यरुचौ॥ ५-७४-५ स्वगृहाज्जीवितेप्सया इति ङ. पाठः॥ ५-७४-६ पार्थेन पार्थिवा वीरास्तंद्ददध्वं ममाभयम् इति क.ट.पाठः॥ ५-७४-२४ निमित्ते लक्ष्यभेदने॥ ५-७४-२६ योगादभ्यासात्। दुःखोचितत्वाच्च इति क.ट.ङ.पाठः॥ ५-७४-३० मृत्युभवं भयम् इति क.पाठः॥ ५-७४-७४ चतुःसप्ततितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]