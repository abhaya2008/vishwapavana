[{"id": 2137380, "chapter_id": 3978, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2137381, "chapter_id": 3978, "verse_number": "१", "content_sanskrit": "ब्राह्मणं यन्त्रिता राजन्नुपस्थास्यामि पूजया ।\nयथाप्रतिज्ञं राजेन्द्र न च मिथ्या ब्रवीम्यहम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2137382, "chapter_id": 3978, "verse_number": "२", "content_sanskrit": "एष चैव स्वभावो मे पूजयेयं द्विजानिति ।\nतव चैव प्रियं कार्यं श्रेयश्च परमं मम \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2137383, "chapter_id": 3978, "verse_number": "३", "content_sanskrit": "यद्येवैष्यति सायाह्ने यदि प्रातरथो निशि ।\nयद्यर्धरात्रे भगवान्न मे कोपं करिष्यति \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2137384, "chapter_id": 3978, "verse_number": "४", "content_sanskrit": "लाभो ममैष राजेन्द्र यद्वै पूजयती द्विजान् ।\nआदेशे तव तिष्ठन्ती हितं कुर्यां नरोत्तम \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2137385, "chapter_id": 3978, "verse_number": "५", "content_sanskrit": "विस्रब्धो भव राजेन्द्र न व्यलीकं द्विजोत्तमः ।\nवसन् प्राप्स्यति ते गेहे सत्यमेतद् ब्रवीमि ते \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2137386, "chapter_id": 3978, "verse_number": "६", "content_sanskrit": "यत् प्रियं च द्विजस्यास्य हितं चैव तवानघ ।\nयतिष्यामि तथा राजन् व्येतु ते मानसो ज्वरः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2137387, "chapter_id": 3978, "verse_number": "७", "content_sanskrit": "ब्राह्मणा हि महाभागाः पूजिताः पृथिवीपते ।\nतारणाय समर्थाः स्युर्विपरीते वधाय च \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2137388, "chapter_id": 3978, "verse_number": "८", "content_sanskrit": "साहमेतद् विजानन्ती तोषयिष्ये द्विजोत्तमम् ।\nन मत्कृते व्यथां राजन् प्राप्स्यसि द्विजसत्तमात् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2137389, "chapter_id": 3978, "verse_number": "९", "content_sanskrit": "अपराधेऽपि राजेन्द्र राज्ञामश्रेयसे द्विजाः ।\nभवन्ति च्यवनो यद्वत् सुकन्यायाः कृते पुरा \t ॥ ९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2137390, "chapter_id": 3978, "verse_number": "१०", "content_sanskrit": "नियमेन परेणाहमुपस्थास्ये द्विजोत्तमम् ।\nयथा त्वया नरेन्द्रेदं भाषितं ब्राह्मणं प्रति \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2137391, "chapter_id": 3978, "verse_number": "", "content_sanskrit": "एवं ब्रुवन्तीं बहुशः परिष्वज्य समर्थ्य च ।\nइति चेति च कर्तव्यं राजा सर्वमथादिशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2137392, "chapter_id": 3978, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2137393, "chapter_id": 3978, "verse_number": "११", "content_sanskrit": "एवमेतत् त्वया भद्रे कर्तव्यमविशङ्कया ।\nमद्धितार्थं तथाऽऽत्मार्थं कुलार्थं चाप्यनिन्दिते \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2137394, "chapter_id": 3978, "verse_number": "१२", "content_sanskrit": "एवमुक्त्त्वा तु तां कन्यां कुन्तिभोजो महायशाः ।\nपृथां परिददौ तस्मै द्विजाय द्विजवत्सलः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2137395, "chapter_id": 3978, "verse_number": "", "content_sanskrit": "कुन्तिभोजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2137396, "chapter_id": 3978, "verse_number": "१३", "content_sanskrit": "इयं ब्रह्मन् मम सुता बाला सुखविवर्धिता ।\nअपराध्येत यत्किञ्चिन्न कार्यं हृदि तत्त्वया \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2137397, "chapter_id": 3978, "verse_number": "१४", "content_sanskrit": "द्विजातयो महाभागा वृद्धबालतपस्विषु ।\nभवन्त्यक्रोधनाः प्रायो ह्यपराद्धेषु नित्यदा \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2137398, "chapter_id": 3978, "verse_number": "१५", "content_sanskrit": "सुमहत्यपराधेऽपि क्षान्तिः कार्या द्विजातिभिः ।\nयथाशक्ति यथोत्साहं पूजा ग्राह्या द्विजोत्तम \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2137399, "chapter_id": 3978, "verse_number": "", "content_sanskrit": "वैश्म्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2137400, "chapter_id": 3978, "verse_number": "१६", "content_sanskrit": "तथेति ब्राह्मणेनोक्तं स राजा प्रीतमानसः ।\nहंसचन्द्रांशुसङ्काशं गृहमस्मै न्यवेदयत् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2137401, "chapter_id": 3978, "verse_number": "१७", "content_sanskrit": "तत्राग्निशरणे कॢप्तमासनं तस्य भानुमत् ।\nआहारादि च सर्वं तत्तथैव प्रत्यवेदयत् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2137402, "chapter_id": 3978, "verse_number": "१८", "content_sanskrit": "निक्षिप्य राजपुत्री तु तन्द्रीं मानं तथैव च ।\nआतस्थे परमं यत्नं ब्राह्मणस्याभिराधने \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2137403, "chapter_id": 3978, "verse_number": "१९", "content_sanskrit": "तत्र सा ब्राह्मणं गत्वा पृथा शौचपरा सती ।\nविधिवत् परिचारार्हं देववत् पर्यतोषयत् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2137404, "chapter_id": 3978, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि त्रिनवत्यधिकद्विशततमोऽध्यायः ॥२९३॥\nकुण्डलाहरणपर्वणि पृथाद्विजपरिचर्यायां पञ्चमोऽध्यायः ॥५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]