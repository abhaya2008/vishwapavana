[{"id": 7004450000, "chapter_id": 24450, "verse_number": "५-३-१४४-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेन्महाराज द्वादशीतीर्थमुत्तमम् ।\nक्षरन्ति सर्वदानानि जपहोमबलिक्रियाः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004450001, "chapter_id": 24450, "verse_number": "५-३-१४४-२", "content_sanskrit": "न क्षीयते तु राजेन्द्र चक्रतीर्थे तु यत्कृतम् ।\nयद्भूतं यद्भविष्यच्च तीर्थमाहात्म्यमुत्तमम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004450002, "chapter_id": 24450, "verse_number": "५-३-१४४-३", "content_sanskrit": "कथितं तन्मया सर्वं पृथग्भावेन भारत॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]