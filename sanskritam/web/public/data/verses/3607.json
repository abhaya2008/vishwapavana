[{"id": 2121617, "chapter_id": 3607, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2121618, "chapter_id": 3607, "verse_number": "१", "content_sanskrit": "अदित्या चोदितः कृष्ण तव मात्राऽहमागतः ।\nकुण्डलेऽपहृते तात भौमेन नरकेण च\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2121619, "chapter_id": 3607, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2121620, "chapter_id": 3607, "verse_number": "२", "content_sanskrit": "तमुवाच महाबाहुः प्रीयमाणो जनार्दनः ।\nनिहत्य नरकं भौममाहरिष्यामि कुण्डले\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2121621, "chapter_id": 3607, "verse_number": "३", "content_sanskrit": "एवमुक्त्वा तु गोविन्दो राममेवाभ्यभाषत ।\nप्रद्युम्नमनिरुद्धं च साम्बं चाप्रतिमं बले\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2121622, "chapter_id": 3607, "verse_number": "४", "content_sanskrit": "एतांश्चोक्त्वा तदा तत्र वासुदेवो महायशाः ।\nअथारुह्य सुपर्णं वै शङ्कचक्रगदासिधृत् ।\nययौ तदा हृषीकेशो देवानां हितकाम्यया\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2121623, "chapter_id": 3607, "verse_number": "५", "content_sanskrit": "तं प्रयान्तममित्रघ्नं देवाः सहपुरन्दराः ।\nपृष्ठतोऽनुययुः प्रीताः स्तुवन्तो विष्णुमच्युतम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2121624, "chapter_id": 3607, "verse_number": "६", "content_sanskrit": "उग्रान् रक्षोगणान् तत्र नरकस्य महासुरान् ।\nक्षुरान्तान् मौरवान् पाशान् षट्सहस्रान् ददर्श सः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2121625, "chapter_id": 3607, "verse_number": "७", "content_sanskrit": "सञ्छिद्य पाशांस्त्वस्त्रेण मुरं हत्वा सहान्वयम् ।\nशिलासङ्घानतिक्रम्य निसुम्भमवपोथयत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2121626, "chapter_id": 3607, "verse_number": "८", "content_sanskrit": "यः सहस्रसमास्त्वेकः सर्वान् देवानयोधयत् ।\nतं जघान महावीर्यं हयग्रीवं महाबलम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2121627, "chapter_id": 3607, "verse_number": "९", "content_sanskrit": "अपारतेजा दुर्धर्षः सर्वयादवनन्दनः ।\nमध्ये लोहितगङ्गायां भगवान् देवकीसुतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2121628, "chapter_id": 3607, "verse_number": "१०", "content_sanskrit": "औदकायां विरूपाक्षं जघान मधुसूदनः ।\nपञ्च पञ्चजनान् घोरान् नरकस्य महासुरान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2121629, "chapter_id": 3607, "verse_number": "११", "content_sanskrit": "ततः प्राग्ज्योतिषं नाम दीप्यमानमिव श्रिया ।\nपुरमासादयामास तत्र युद्धमवर्तत \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2121630, "chapter_id": 3607, "verse_number": "१२", "content_sanskrit": "महद् दैवासुरं युद्धं यद् वृत्तं भरतर्षभ ।\nयुद्धं तत् स्यात् समं तेन लोकविस्मयकारकम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2121631, "chapter_id": 3607, "verse_number": "१३", "content_sanskrit": "चक्रलाङ्गलसञ्छिन्नाः शक्तिखङ्गहतास्तदा ।\nविनेशुर्दानवास्तत्र समासाद्य जनार्दनम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2121632, "chapter_id": 3607, "verse_number": "१४", "content_sanskrit": "अष्टौ शतसहस्राणि दानवानां परन्तप ।\nनिहत्य पुरुषव्याघ्रः पाताळविवरं ययौ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2121633, "chapter_id": 3607, "verse_number": "१५", "content_sanskrit": "त्रासनं सुरसङ्घानां नरकं पुरुषोत्तमः ।\nयोधयत्यतितेजस्वी मधुवन्मधुसूदनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2121634, "chapter_id": 3607, "verse_number": "१६", "content_sanskrit": "तद्युद्धमभवद् घोरं तेन भौमेन भारत ।\nकुण्डलार्थे सुरेशस्य नरकेण महात्मनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2121635, "chapter_id": 3607, "verse_number": "१७", "content_sanskrit": "मुहूर्तं लाळयित्वाऽथ नरकं मधुसूदनः ।\nप्रवृत्तचक्रं चक्रेण प्रममाथ बलाद् बली\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2121636, "chapter_id": 3607, "verse_number": "१८", "content_sanskrit": "चक्रप्रमथितं तस्य पपात सहसा भुवि ।\nउत्तमाङ्गं हताङ्गस्य वृत्रे वज्रहते यथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2121637, "chapter_id": 3607, "verse_number": "१९", "content_sanskrit": "भूमिस्तु पतितं दृष्ट्वा सुतं प्रादाच्च कुण्डले ।\nप्रदाय च महाबाहुमिदं वचनमब्रवीत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2121638, "chapter_id": 3607, "verse_number": "", "content_sanskrit": "भूमिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2121639, "chapter_id": 3607, "verse_number": "२०", "content_sanskrit": "सृष्टस्त्वयैव मधुमन् त्वयैव निहतः सुतः ।\nयथेच्छसि तथा क्रीडन् प्रजास्तस्यानुपालय\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2121640, "chapter_id": 3607, "verse_number": "", "content_sanskrit": "श्रीवासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2121641, "chapter_id": 3607, "verse_number": "२१", "content_sanskrit": "देवानां च मुनीनां च पितॄणां च महात्मनाम् ।\nउद्वेजनीयो भूतानां ब्रह्मद्विट् पुरुषाधमः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2121642, "chapter_id": 3607, "verse_number": "२२", "content_sanskrit": "लोकद्विष्टः सुतस्तुभ्यं देवारिर्लोककण्टकः ।\nसर्वलोकनमस्कार्यामदितिं बाधयद् बली ।\nकुण्डले दर्पसम्पूर्णः ततो मे निहतः सुतः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2121643, "chapter_id": 3607, "verse_number": "२३", "content_sanskrit": "नैव मन्युस्त्वया कार्यो यत् कृतं मयि भामिनि ।\nमत्प्रभावाच्च ते पुत्रो लब्धवान् गतिमुत्तमाम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2121644, "chapter_id": 3607, "verse_number": "२४", "content_sanskrit": "तस्माद् गच्छ महाभागे भारावतरणं कृतम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2121645, "chapter_id": 3607, "verse_number": "१८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि एकोनपञ्चाशोऽध्यायः ॥४९॥\n॥ अर्घाभिहरणपर्वणि अष्टादशोऽध्यायः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2121646, "chapter_id": 3607, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]