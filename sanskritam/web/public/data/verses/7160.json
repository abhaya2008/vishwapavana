[
  {
    "id": 20169903,
    "chapter_id": 7160,
    "verse_number": "86.1",
    "content_sanskrit": "श्रीराम उवाच ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20169904,
    "chapter_id": 7160,
    "verse_number": "86.2",
    "content_sanskrit": "भगवन्युद्धमेतन्मे समासेन मनाग्वद । श्रुतिराह्लाद्यते श्रोतुर्यस्मादेताभिरुक्तिमिः",
    "padaccheda": "भगवन् । युद्धम् । एतत् । मे । समासेन । मनाक् । वद । श्रुतिः । आह्लाद्यते । श्रोतुः । यस्मात् । एताभिः । उक्तिमिः",
    "anvaya": "भगवन् (त्वम्) मे एतत् युद्धम् समासेन मनाक् वद यस्मात् एताभिः उक्तिमिः श्रोतुः श्रुतिः आह्लाद्यते",
    "meaning_sanskrit": "",
    "meaning_english": "O Holy One! Please describe this battle to me briefly and concisely, for the ears of the listener are delighted by such narrations.",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20169905,
    "chapter_id": 7160,
    "verse_number": "86.3",
    "content_sanskrit": "श्रीवसिष्ठ उवाच ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20169906,
    "chapter_id": 7160,
    "verse_number": "86.4",
    "content_sanskrit": "अथ तत्रैव ते देव्यौ संग्रामं तमवेक्षितुम् । विमाने कल्पिते कान्ते रुद्धे रुरुहतुः स्थिरे",
    "padaccheda": "अथ । तत्र । एव । ते । देव्यौ । संग्रामम् । तम् । अवेक्षितुम् । विमाने । कल्पिते । कान्ते । रुद्धे । रुरुहतुः । स्थिरे",
    "anvaya": "अथ तत्र एव ते देव्यौ तम् संग्रामम् अवेक्षितुम् कल्पिते कान्ते रुद्धे स्थिरे विमाने रुरुहतुः",
    "meaning_sanskrit": "",
    "meaning_english": "Then, in that very place, those two goddesses ascended a beautifully fashioned, stable, and steady celestial chariot to observe the unfolding battle.",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20169907,
    "chapter_id": 7160,
    "verse_number": "86.5",
    "content_sanskrit": "एतस्मिन्नन्तरे तत्र लीलेशः प्रतिपक्षतः । तमुत्सोढुमशक्तः सन्मुखव्यतिकरे रणे",
    "padaccheda": "एतस्मिन् । अन्तरे । तत्र । लीलेशः । प्रतिपक्षतः । तम् । उत्सोढुम् । अशक्तः । सन् । मुखव्यतिकरे । रणे",
    "anvaya": "एतस्मिन् अन्तरे तत्र प्रतिपक्षतः लीलेशः मुख-व्यतिकरे रणे तम् उत्सोढुम् अशक्तः सन् (बभूव)",
    "meaning_sanskrit": "",
    "meaning_english": "In the meantime, Līlā's husband, the king, finding himself unable to withstand the opponent in the head-on clash of the battlefield, reacted.",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20169908,
    "chapter_id": 7160,
    "verse_number": "86.6",
    "content_sanskrit": "प्रलयार्णवकल्लोल इवोत्पत्त्योद्भये भटे । जहौ सानाविव शिलां भटस्योरसि मुद्गरम्",
    "padaccheda": "प्रलयार्णवकल्लोलः । इव । उत्पत्त्य । उद्भये । भटे । जहौ । सानौ । इव । शिलाम् । भटस्य । उरसि । मुद्गरम्",
    "anvaya": "भटे उद्भये (सति) प्रलय-अर्णव-कल्लोलः इव उत्पत्त्य (सः) भटस्य उरसि सानौ शिलाम् इव मुद्गरम् जहौ",
    "meaning_sanskrit": "",
    "meaning_english": "Just as a wave of the cosmic ocean of dissolution rises, he sprang up and struck the soldier’s chest with a mallet, like a boulder crashing onto a mountain ridge.",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20169909,
    "chapter_id": 7160,
    "verse_number": "86.7",
    "content_sanskrit": "अथ प्रवृत्तः प्रसभं प्रलयार्णवरंहसा । सेनयोः शस्त्रसंपातः किरन्ननलविद्युतः",
    "padaccheda": "अथ । प्रवृत्तः । प्रसभम् । प्रलयार्णवरंहसा । सेनयोः । शस्त्रसंपातः । किरन् । अनलविद्युतः",
    "anvaya": "अथ प्रलय-अर्णव-रंहसा प्रसभम् अनल-विद्युतः किरन् सेनयोः शस्त्र-संपातः प्रवृत्तः",
    "meaning_sanskrit": "",
    "meaning_english": "Then, with the violent speed of the dissolution ocean, a shower of weapons between the two armies began, scattering sparks of fire and lightning.",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20169910,
    "chapter_id": 7160,
    "verse_number": "86.8",
    "content_sanskrit": "तरत्तरलधाराग्ररेखाङ्कितनभस्तलः । ध्वनत्कणकणाशब्दमध्यलक्षितटांकृतिः",
    "padaccheda": "तरत्तरलधाराग्ररेखाङ्कितनभस्तलः । ध्वनत्कणकणाशब्दमध्यलक्षितटांकृतिः",
    "anvaya": "(सः शस्त्र-संपातः) तरत्-तरल-धारा-अग्र-रेखा-अङ्कित-नभः-तलः ध्वनत्-कण-कणा-शब्द-मध्य-लक्षित-टांकृतिः (आसीत्)",
    "meaning_sanskrit": "",
    "meaning_english": "The sky was marked by the lines of the tips of flowing and shimmering blades, while the clanging of metal resounded amidst the constant crackling noise of the weapons.",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20169911,
    "chapter_id": 7160,
    "verse_number": "86.9",
    "content_sanskrit": "धीरहुंकारमिश्रोष्मघर्घरारवघस्मरः । प्रवृत्तशरधाराग्रभास्करार्चिर्वितानकः",
    "padaccheda": "धीरहुंकारमिश्रोष्मघर्घरारवघस्मरः । प्रवृत्तशरधाराग्रभास्करार्चिर्वितानकः",
    "anvaya": "(सः शस्त्र-संपातः) धीर-हुंकार-मिश्र-उष्म-घर्घर-आरव-घस्मरः प्रवृत्त-शर-धारा-अग्र-भास्कर-अर्चिः-वितानकः (आसीत्)",
    "meaning_sanskrit": "",
    "meaning_english": "The clash consumed the air with the fierce roars of warriors mixed with hot, gurgling sounds, as the tips of the streaming arrows formed a canopy like the rays of the sun.",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20169912,
    "chapter_id": 7160,
    "verse_number": "86.10",
    "content_sanskrit": "नदत्कङ्कटटङ्कारप्रोड्डीनकणपावकः । परस्पराहतिच्छिन्नहेतिखण्डखगाम्बरः",
    "padaccheda": "नदत्कङ्कटटङ्कारप्रोड्डीनकणपावकः । परस्पराहतिच्छिन्नहेतिखण्डखगाम्बरः",
    "anvaya": "(सः शस्त्र-संपातः) नदत्-कङ्कट-टङ्कार-प्रोड्डीन-कण-पावकः परस्पर-आहति-छिन्न-हेति-खण्ड-खग-अम्बरः (आसीत्)",
    "meaning_sanskrit": "",
    "meaning_english": "The clanging of armor produced flying sparks of fire, while the sky was filled with fragments of weapons broken by mutual impact, looking like birds in flight.",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20169913,
    "chapter_id": 7160,
    "verse_number": "86.11",
    "content_sanskrit": "वीरदोर्द्रुमसंचारवहद्वननभस्थलः । कोदण्डचक्रक्रेङ्कारद्रवद्वैमानिकाङ्गनः",
    "padaccheda": "वीरदोर्द्रुमसंचारवहद्वननभस्थलः । कोदण्डचक्रक्रेङ्कारद्रवद्वैमानिकाङ्गनः",
    "anvaya": "(सः शस्त्र-संपातः) वीर-दोः-द्रुम-संचार-वहत्-वन-नभः-स्थलः कोदण्ड-चक्र-क्रेङ्कार-द्रवत्-वैमानिक-अङ्गनः (आसीत्)",
    "meaning_sanskrit": "",
    "meaning_english": "The sky appeared like a forest moving with the tree-like arms of heroes, and the twanging of the circular bows caused the celestial nymphs in their chariots to flee in fear.",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20169914,
    "chapter_id": 7160,
    "verse_number": "86.12",
    "content_sanskrit": "महाहलहलारावभृङ्गीकृतघनध्वनिः । निर्विकल्पसमाधिस्थ इवैकघनतावशात्",
    "padaccheda": "महाहलहलारावभृङ्गीकृतघनध्वनिः । निर्विकल्पसमाधिस्थः । इव । एकघनतावशात्",
    "anvaya": "(सः शस्त्र-संपातः) महा-हलहला-राव-भृङ्गी-कृत-घन-ध्वनिः एक-घनता-वशात् निर्विकल्प-समाधि-स्थः इव (आसीत्)",
    "meaning_sanskrit": "",
    "meaning_english": "The massive chaotic roar made the thunder of clouds seem like the humming of bees; due to its dense, continuous intensity, the battle seemed as if fixed in a state of unwavering concentration (nirvikalpa-samādhi).",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20169915,
    "chapter_id": 7160,
    "verse_number": "86.13",
    "content_sanskrit": "नाराचासारधाराग्रलूनशूरशिरस्करः । परस्परांससंघट्टरणत्कङ्कटसंकटः",
    "padaccheda": "नाराचासारधाराग्रलूनशूरशिरस्करः । परस्परांससंघट्टरणत्कङ्कटसंकटः",
    "anvaya": "नाराच-आसार-धारा-अग्र-लून-शूर-शिरस्करः (अभवत्), परस्पर-अंस-संघट्ट-रणत्-कङ्कट-संकटः (च अभवत्) ।",
    "meaning_sanskrit": "",
    "meaning_english": "The battlefield was filled with the severed heads of warriors, cut by the tips of torrential showers of iron arrows. It became crowded with the clanging of armors resulting from the mutual clashing of shoulders.",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20169916,
    "chapter_id": 7160,
    "verse_number": "86.14",
    "content_sanskrit": "हुंकारहतहेत्युग्रसंघट्टकटुटांकृतः । तरद्धारातरङ्गाभ्रदन्तुराशेषदिङ्मुखः ।। १२",
    "padaccheda": "हुंकारहतहेत्युग्रसंघट्टकटुटांकृतः । तरद्धारातरङ्गाभ्रदन्तुराशेषदिङ्मुखः",
    "anvaya": "(सः सङ्ग्रामः) हुंकार-हत-हेति-उग्र-संघट्ट-कटु-टाङ्कृतः (आसीत्), तरत्-धारा-तरङ्ग-अभ्र-दन्तुर-अशेष-दिक्-मुखः (च आसीत्) ।",
    "meaning_sanskrit": "",
    "meaning_english": "The battle resounded with the harsh clanging of weapons struck with 'huṃkāra' cries. All quarters of the sky were jagged with clouds of arrows, resembling undulating waves of flowing water.",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20169917,
    "chapter_id": 7160,
    "verse_number": "86.15",
    "content_sanskrit": "हेतिसंघट्टविक्षोभमुष्टिग्राह्यझणज्झणः । चिरमास्फोटकास्फोटलुठच्चटचटारवः ।। १३",
    "padaccheda": "हेतिसंघट्टविक्षोभमुष्टिग्राह्यझणज्झणः । चिरम् । आस्फोटकास्फोटलुठच्चटचटारवः",
    "anvaya": "(सः) हेति-संघट्ट-विक्षोभ-मुष्टि-ग्राह्य-झणज्झणः (अभवत्), चिरम् आस्फोटक-आस्फोट-लुठत्-चटचट-आरवः (च अभवत्) ।",
    "meaning_sanskrit": "",
    "meaning_english": "The jingling sound produced by the collision of weapons was so dense it seemed graspable by the fist. For a long time, there was the crackling sound of bodies being struck and falling in the struggle.",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20169918,
    "chapter_id": 7160,
    "verse_number": "86.16",
    "content_sanskrit": "प्रवहत्खड्गसीत्कारज्वलत्कणसणध्वनिः । सरच्छरभराध्वान्तशरत्खरखरारवः ।। १४",
    "padaccheda": "प्रवहत्खड्गसीत्कारज्वलत्कणसणध्वनिः । सरच्छरभराध्वान्तशरत्खरखरारवः",
    "anvaya": "(तत्र) प्रवहत्-खड्ग-सीत्कार-ज्वलत्-कण-सण-ध्वनिः (आसीत्), सरत्-शर-भरा-ध्वान्त-शरत्-खर-खर-आरवः (च आसीत्) ।",
    "meaning_sanskrit": "",
    "meaning_english": "There was the 'si' sound of whistling swords and the 'saṇa' sound of sparks flying. A harsh 'khara-khara' noise arose amidst the darkness created by the weight of streaming arrows.",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20169919,
    "chapter_id": 7160,
    "verse_number": "86.17",
    "content_sanskrit": "धगद्धगितिविच्छिन्नकण्ठोत्थप्राणलोहितः । छिन्नबाहुशिरःखड्गखण्डनिर्विवराम्बरः ।। १५",
    "padaccheda": "धगद्धगिति । विच्छिन्नकण्ठोत्थप्राणलोहितः । छिन्नबाहुशिरःखड्गखण्डनिर्विवराम्बरः",
    "anvaya": "(तत्र) धगत्-धगत् इति विच्छिन्न-कण्ठ-उत्थ-प्राण-लोहितः (आसीत्), छिन्न-बाहु-शिरः-खड्ग-खण्ड-निर्विवर-अम्बरः (च आसीत्) ।",
    "meaning_sanskrit": "",
    "meaning_english": "Vital blood spurted 'dhagat-dhagat' from severed necks. The sky became solid, without any gaps, filled with severed arms, heads, and broken fragments of swords.",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20169920,
    "chapter_id": 7160,
    "verse_number": "86.18",
    "content_sanskrit": "कङ्कटोत्थस्फुरद्वह्निसटास्पृष्टशिरोरुहः । रणत्पतदसिव्रातमत्तपीनझणज्झणः ।। १६",
    "padaccheda": "कङ्कटोत्थस्फुरद्वह्निसटास्पृष्टशिरोरुहः । रणत्पतदसिव्रातमत्तपीनझणज्झणः",
    "anvaya": "(तत्र) कङ्कट-उत्थ-स्फुरत्-वह्नि-सटा-स्पृष्ट-शिरोरुहः (आसीत्), रणत्-पतत्-असि-व्रात-मत्त-पीन-झणज्झणः (च आसीत्) ।",
    "meaning_sanskrit": "",
    "meaning_english": "The hair of warriors was singed by the sparks of fire rising from their armor. A heavy, intoxicating jingling sound rose from the mass of clashing and falling swords.",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20169921,
    "chapter_id": 7160,
    "verse_number": "86.19",
    "content_sanskrit": "कुन्तकुण्ठितमातङ्गतरङ्गोत्तुङ्गलोहितः । दन्तिदन्तविनिष्पेषतारचीत्कारकर्कशः ।। १७",
    "padaccheda": "कुन्तकुण्ठितमातङ्गतरङ्गोत्तुङ्गलोहितः । दन्तिदन्तविनिष्पेषतारचीत्कारकर्कशः",
    "anvaya": "(तत्र) कुन्त-कुण्ठित-मातङ्ग-तरङ्ग-उत्तुङ्ग-लोहितः (आसीत्), दन्ति-दन्त-विनिष्पेष-तार-चीत्कार-कर्कशः (च अभवत्) ।",
    "meaning_sanskrit": "",
    "meaning_english": "High waves of blood flowed from elephants wounded by spears. The atmosphere was harsh with the shrill trumpeting of elephants as their tusks crashed against each other.",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20169922,
    "chapter_id": 7160,
    "verse_number": "86.20",
