[{"id": 900000848, "chapter_id": 8186, "verse_number": "2.1", "content_sanskrit": "अनन्तगुणपूर्णत्वादगम्याय सुरैरपि । सर्वेष्टदात्रे देवानां नमो नारायणाय ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900000849, "chapter_id": 8186, "verse_number": "2.2", "content_sanskrit": "केनेषितं पतति प्रेषितं मनः केन प्राणः प्रथमः प्रैति युक्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900000850, "chapter_id": 8186, "verse_number": "2.3", "content_sanskrit": "श्रोत्रस्य श्रोत्रं मनसो मनो यद्वाचो ह वाचं स उ प्राणस्य प्राणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900000851, "chapter_id": 8186, "verse_number": "2.4", "content_sanskrit": "न तत्र चक्षुर्गच्छति न वाग् गच्छति नो मनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900000852, "chapter_id": 8186, "verse_number": "2.5", "content_sanskrit": "अन्यदेव तद् विदितादथो अविदितादधि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900000853, "chapter_id": 8186, "verse_number": "2.6", "content_sanskrit": "यद् वाचाऽनभ्युदितं येन वागभ्युद्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]