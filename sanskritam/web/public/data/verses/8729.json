[{"id": 900009130, "chapter_id": 8729, "verse_number": "19.1", "content_sanskrit": "ननु त्वन्मते सर्वगोव्यक्तिसङ्ग्राहकस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009131, "chapter_id": 8729, "verse_number": "19.2", "content_sanskrit": "किं च क्रियावत्त्वं न द्रव्यलक्षणम् अव्याप्तेः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009132, "chapter_id": 8729, "verse_number": "19.3", "content_sanskrit": "ननु त्वन्मते सादृश्येनातीतादेः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009133, "chapter_id": 8729, "verse_number": "19.4", "content_sanskrit": "ननु पुरोवर्तिगोव्यक्तौ मन्मते गोत्वमिव ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009134, "chapter_id": 8729, "verse_number": "19.5", "content_sanskrit": "अपि च सादृश्येञ्जनादिवत्सहकारित्वमात्रेण प्रत्यासत्तिशब्दः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009135, "chapter_id": 8729, "verse_number": "19.6", "content_sanskrit": "ननु तथाऽपि गवयोपि गोसादृश्यप्रतियोगीति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009136, "chapter_id": 8729, "verse_number": "19.7", "content_sanskrit": "इयांस्तु विशेषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009137, "chapter_id": 8729, "verse_number": "19.8", "content_sanskrit": "यद्वा तवेव ममापि पुरोवर्तिगोवर्तिगोत्वं ज्ञातमेव प्रत्यासत्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900009138, "chapter_id": 8729, "verse_number": "19.9", "content_sanskrit": "नन्वेवं सादृश्यस्यैकत्वेऽपि तस्य शक्तिग्रहे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900009139, "chapter_id": 8729, "verse_number": "19.10", "content_sanskrit": "तस्मास्त्वरूपसत्सादृश्योपस्थापितपरस्परसदृशनानागोत्वावच्छिन्नव्यक्तिषु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900009140, "chapter_id": 8729, "verse_number": "19.11", "content_sanskrit": "यद्वा यथा प्राभाकरमते धेनुशब्दस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900009141, "chapter_id": 8729, "verse_number": "19.12", "content_sanskrit": "यद्वाऽऽदौ स्वरूपसत्सादृश्यमुक्तरीत्याऽतीतादिकमुपस्थाप्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900009142, "chapter_id": 8729, "verse_number": "19.13", "content_sanskrit": "इयांस्तु भेदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900009143, "chapter_id": 8729, "verse_number": "19.14", "content_sanskrit": "न चानवस्था", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900009144, "chapter_id": 8729, "verse_number": "19.15", "content_sanskrit": "सुधायां त्वयं गौरित्युपदेशो व्याप्तिग्राहकः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900009145, "chapter_id": 8729, "verse_number": "19.16", "content_sanskrit": "अत्र च वर्तमानसन्निकृष्टमात्रग्राहीति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900009146, "chapter_id": 8729, "verse_number": "19.17", "content_sanskrit": "यत्तु– सुधायामतीतानागतार्थेष्वित्यनुव्याख्यानस्यानागतादि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]