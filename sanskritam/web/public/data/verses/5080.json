[{"id": 2191773, "chapter_id": 5080, "verse_number": "", "content_sanskrit": "जनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2191774, "chapter_id": 5080, "verse_number": "१", "content_sanskrit": "वर्णो विशेषवर्णानांमहर्षे केन जायते ।\nएतदिच्छाम्यहं श्रोतुंतद् ब्रूहि वदतां वर\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2191775, "chapter_id": 5080, "verse_number": "२", "content_sanskrit": "यदेतज्जायतेऽपत्यंस एवायमिति श्रुतिः ।\nकथं ब्राह्मणतो जातो विशेषग्रहणं गतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2191776, "chapter_id": 5080, "verse_number": "", "content_sanskrit": "पराशरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2191777, "chapter_id": 5080, "verse_number": "३", "content_sanskrit": "एवमेतन्महाराज येन जातः स एव सः ।\nतपसस्त्वपकर्षेणजातिग्रहणतां गतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2191778, "chapter_id": 5080, "verse_number": "४", "content_sanskrit": "सुक्षेत्राच्च सुबीजाच्च पुण्यो भवति सम्भवः ।\nअतोऽन्यतरतो हीनादवरो नाम जायते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2191779, "chapter_id": 5080, "verse_number": "५", "content_sanskrit": "वक्त्राद् भुजाभ्यामूरुभ्यां पद्भ्यां चैवाथ जज्ञिरे ।\nसृजतः प्रजापतेर्लोकानितिधर्मविदो विदुः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2191780, "chapter_id": 5080, "verse_number": "६", "content_sanskrit": "मुखजा ब्राह्मणास्तात बाहुजाः क्षत्रबन्धवः।\nऊरुजा धनिनोराजन् पादजाः परिचारकाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2191781, "chapter_id": 5080, "verse_number": "७", "content_sanskrit": "चतुर्णामेव वर्णानामागमः पुरुषर्षभ ।\nअतोऽन्ये त्वतिरिक्ता ये ते वै सङ्करजाःस्मृताः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2191782, "chapter_id": 5080, "verse_number": "८", "content_sanskrit": "क्षत्रजातिरथाम्बष्ठा उग्रा वैदेहकास्तथा ।\nश्वपाकाः पुल्कसाः स्तेना निषादाः सूतमागधाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2191783, "chapter_id": 5080, "verse_number": "९", "content_sanskrit": "आयोगाः करणाव्रात्याश्चण्डालाश्च नराधिप ।\nएते चतुर्भ्यो वर्णेभ्यो जायन्ते वै परस्परम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2191784, "chapter_id": 5080, "verse_number": "", "content_sanskrit": "जनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2191785, "chapter_id": 5080, "verse_number": "१०", "content_sanskrit": "ब्रह्मणैकेन जातानांनानात्वं गोत्रतः कथम् ।\nबहूनीह हि लोके वै गोत्राणि मुनिसत्तम\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2191786, "chapter_id": 5080, "verse_number": "११", "content_sanskrit": "यत्र तत्र कथं जाताः स्वयोनिं मुनयो गताः ।\nशूद्रयोनौ समुत्पन्ना वियोनौ च तथापरे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2191787, "chapter_id": 5080, "verse_number": "", "content_sanskrit": "पराशरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2191788, "chapter_id": 5080, "verse_number": "१२", "content_sanskrit": "राजन्नैतद् भवेद् ग्राह्यमपकृष्टेन जन्मना ।\nमहात्मनां समुत्पत्तिस्तपसा भावितात्मनाम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2191789, "chapter_id": 5080, "verse_number": "१३", "content_sanskrit": "उत्पाद्य पुत्रान्मुनयो नृपतेयत्र तत्र ह ।\nस्वेनैव तपसा तेषामृषित्वं विदधुः पुनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2191790, "chapter_id": 5080, "verse_number": "१४", "content_sanskrit": "पितामहश्च मे पूर्वमृश्यशृङ्गश्च काश्यपः ।\nवटस्ताण्ड्यः कृपश्चैव कक्षीवान् कमठादयः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2191791, "chapter_id": 5080, "verse_number": "१५", "content_sanskrit": "यवक्रीतश्च नृपते द्रोणश्च वदतां वरः ।\nआयुर्मतङ्गो दत्तश्च द्रुपदो मत्स्यएव च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2191792, "chapter_id": 5080, "verse_number": "१६", "content_sanskrit": "एते स्वां प्रकृतिं प्राप्ता वैदेह तपसोऽऽश्रयात् ।\nप्रतिष्ठिता वेदविदो दमे तपसि चैव हि॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2191793, "chapter_id": 5080, "verse_number": "१७", "content_sanskrit": "मूलगोत्राणि चत्वारि समुत्पन्नानि पार्थिव ।\nअङ्गिराः कश्यपश्चैववसिष्ठो भृगुरेव च\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2191794, "chapter_id": 5080, "verse_number": "१८", "content_sanskrit": "कर्मतोऽन्यानि गोत्राणि समुत्पन्नानि पार्थिव ।\nनामधेयानि तपसा तानि च ग्रहणं सताम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2191795, "chapter_id": 5080, "verse_number": "", "content_sanskrit": "जनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2191796, "chapter_id": 5080, "verse_number": "१९", "content_sanskrit": "विशेषधर्मान् वर्णानां प्रब्रूहि भगवन्मम ।\nतथा सामान्यधर्मांश्च सर्वत्रकुशलो ह्यसि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2191797, "chapter_id": 5080, "verse_number": "", "content_sanskrit": "पराशरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2191798, "chapter_id": 5080, "verse_number": "२०", "content_sanskrit": "प्रतिग्रहो याजनंच तथैवाध्यापनं नृप ।\nविशेषधर्मो विप्राणां रक्षा क्षत्रस्य शोभना\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2191799, "chapter_id": 5080, "verse_number": "२१", "content_sanskrit": "कृषिश्च पाशुपाल्यं च वाणिज्यं च विशामपि।\nद्विजानां परिचर्या च शूद्रकर्म नराधिप\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2191800, "chapter_id": 5080, "verse_number": "२२", "content_sanskrit": "विशेषधर्मा नृपते वर्णानां परिकीर्तिताः ।\nधर्मान् साधारणांस्तात विस्तरेण शृणुष्व मे॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2191801, "chapter_id": 5080, "verse_number": "२३", "content_sanskrit": "आनृशंस्यमहिंसा चाप्रमादः संविभागिता।\nश्राद्धकर्मातिथेयं च सत्यमक्रोध एव च\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2191802, "chapter_id": 5080, "verse_number": "२४", "content_sanskrit": "स्वेषु दारेषु सन्तोषः शौचंनित्यानसूयता ।\nआत्मज्ञानं तितिक्षा च धर्माः साधारणा नृप\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2191803, "chapter_id": 5080, "verse_number": "२५", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्यास्त्रयो वर्णा द्विजातयः ।\nअत्र तेषामधीकारो धर्मेषु द्विपदां वर\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2191804, "chapter_id": 5080, "verse_number": "२६", "content_sanskrit": "विकर्मावस्थितावर्णाः पतन्ति नृपते त्रयः ।\nउन्नमन्ति यथासन्तमाश्रित्येह स्वकर्मसु\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2191805, "chapter_id": 5080, "verse_number": "२७", "content_sanskrit": "न चापि शूद्रः पततीति निश्चयो\nन चापि संस्कारमिहार्हतीति वा ।\nश्रुतिप्रवृत्तंन च धर्ममाप्नुते\nन चास्य धर्मे प्रतिषेधनं कृतम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2191806, "chapter_id": 5080, "verse_number": "२८", "content_sanskrit": "वैदेहकं शूद्रमुदाहरन्ति\nद्विजा महाराज श्रुतोपपन्नाः ।\nअहं हि पश्यामि नरेन्द्र देवं\nविश्वस्य विष्णुं जगतः प्रधानम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2191807, "chapter_id": 5080, "verse_number": "२९", "content_sanskrit": "सतां वृत्तमनुष्ठायनिहीना उज्जिहीर्षवः।\nमन्त्रवर्जं न दुष्यन्तिकुर्वाणाः पौष्टिकीः क्रियाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2191808, "chapter_id": 5080, "verse_number": "३०", "content_sanskrit": "यथा यथा हि सद्वृत्तमालम्बन्तीतरे जनाः ।\nतथा तथा सुखं प्राप्य प्रेत्य चेह च शेरते॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2191809, "chapter_id": 5080, "verse_number": "", "content_sanskrit": "जनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2191810, "chapter_id": 5080, "verse_number": "३१", "content_sanskrit": "किं कर्म दूषयत्येनमथ जातिर्महामुने ।\nसंदेहो मे समुत्पन्नस्तन्मे व्याख्यातुमर्हसि॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2191811, "chapter_id": 5080, "verse_number": "", "content_sanskrit": "पराशरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2191812, "chapter_id": 5080, "verse_number": "३२", "content_sanskrit": "असंशयं महाराज उभयं दोषकारकम्।\nकर्म चैव हि जातिश्च विशेषं तु निशामय॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2191813, "chapter_id": 5080, "verse_number": "३३", "content_sanskrit": "जात्या च कर्मणा चैव दुष्टं कर्म निषेवते ।\nजात्या दुष्टश्च यः पापं न करोति स पूरुषः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2191814, "chapter_id": 5080, "verse_number": "३४", "content_sanskrit": "जात्या प्रधानं पुरुषं कुर्वाणं कर्म धिक्कृतम् ।\nकर्म तद् दूषयत्येनं तस्मात् कर्म नशोभनम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2191815, "chapter_id": 5080, "verse_number": "", "content_sanskrit": "जनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2191816, "chapter_id": 5080, "verse_number": "३५", "content_sanskrit": "कानि कर्माणि धर्म्याणि लोकेऽस्मिन् द्विजसत्तम ।\nन हिंसन्तीह भूतानि क्रियमाणानि सर्वदा॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2191817, "chapter_id": 5080, "verse_number": "", "content_sanskrit": "पराशरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2191818, "chapter_id": 5080, "verse_number": "३६", "content_sanskrit": "शृणु मेऽत्र महाराज यन्मां त्वं परिपृच्छसि।\nयानि कर्माण्यहिंस्राणि नरं त्रायन्ति सर्वदा\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2191819, "chapter_id": 5080, "verse_number": "३७", "content_sanskrit": "संन्यस्याग्नीनुपासीनाः पश्यन्ति विगतज्वराः ।\nनैःश्रेयसं धर्मपथंसमारुह्य यथाक्रमम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2191820, "chapter_id": 5080, "verse_number": "३८", "content_sanskrit": "प्रश्रिता विनयोपेता दमनित्याः सुसंशिताः ।\nप्रयान्ति स्थानमजरं सर्वकर्मविवर्जिताः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2191821, "chapter_id": 5080, "verse_number": "३९", "content_sanskrit": "सर्वे वर्णा धर्मकार्याणि सम्यक्\nकृत्वा राजन् सत्यवाक्यानि चोक्त्वा ।\nत्यक्त्वाधर्मं दारुणं जीवलोके\nयान्तिस्वर्गं नात्र कार्यो विचारः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2191822, "chapter_id": 5080, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे अष्टाविंशोत्तरशततमोऽध्यायः ॥१२९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]