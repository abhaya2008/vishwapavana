[{"id": 7005870000, "chapter_id": 25870, "verse_number": "१-५३-१", "content_sanskrit": "सूत उवाच ।\nएवं ब्रह्माब्रवीच्छ्रुत्वा हरेरष्टनिधींस्था।\nतत्र पद्ममहापद्मौ तथा मकरकच्छपौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005870001, "chapter_id": 25870, "verse_number": "१-५३-२", "content_sanskrit": "मुकुन्दकु(न) न्दौ नीलश्च शङ्खश्चैवापरो निधि।\nसत्यामृद्धौ भवन्त्येते स्वरूपं कथयाम्यहम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005870002, "chapter_id": 25870, "verse_number": "१-५३-३", "content_sanskrit": "पद्मेन लक्षितश्चैव सात्त्विको जायते नर।\nदाक्षिण्यसारः पुरुषः सुवर्णादिकसंग्रहम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005870003, "chapter_id": 25870, "verse_number": "१-५३-४", "content_sanskrit": "रुप्यादि कुर्य्याद्दद्यात्तु यतिदैवादियज्वनाम्।\nमहापद्माङ्कितो दद्याद्धनाद्यं धार्मिकाय च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005870004, "chapter_id": 25870, "verse_number": "१-५३-५", "content_sanskrit": "निधी पद्ममहापद्मौ सात्त्विकौ पुरुषौ समृतौ।\nमकरेणाङ्कितः खड्गबाणकुन्तादिसंग्रही ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005870005, "chapter_id": 25870, "verse_number": "१-५३-६", "content_sanskrit": "दद्याच्छ्रुताय मैत्रीं च याति नित्यं च राजभिः ।\nद्रव्यार्थं शत्रूणां नाशं संग्रामे चापि संव्रजेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005870006, "chapter_id": 25870, "verse_number": "१-५३-७", "content_sanskrit": "मकरः कच्छपश्चैव तामसौ तु निधी स्मृतौ ।\nकच्छपी विश्वसेन्नैव न भुङ्केन (ना) ददाति च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005870007, "chapter_id": 25870, "verse_number": "१-५३-८", "content_sanskrit": "निधानमुर्व्यां कुरुते निधिः सोप्येकपूरुषः ।\nराजसेनमुकुन्देन लक्षिता राज्यसंग्रही ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005870008, "chapter_id": 25870, "verse_number": "१-५३-९", "content_sanskrit": "भुक्तभोगो गायनेभ्यो दद्याद्वेश्यादिकासु च ।\nरजस्तमोमयो नन्दी आधारः स्यात्कुलस्य च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005870009, "chapter_id": 25870, "verse_number": "१-५३-१०", "content_sanskrit": "स्तुतः प्रीतो भवति वै बहुभार्य्या भवन्ति।\nपूर्वमित्रेषु शैथिल्यं प्रीतिमन्यैः करोति च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005870010, "chapter_id": 25870, "verse_number": "१-५३-११", "content_sanskrit": "नीलेन चाङ्कितः सत्त्वतेजसा संयुतो भवेत् ।\nवस्त्रधान्यादिसंग्राही तडागादि करोति च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005870011, "chapter_id": 25870, "verse_number": "१-५३-१२", "content_sanskrit": "त्रिपू(पौ) रुषो निधिश्चैव आम्रारामादि कारयेत् ।\nएकस्य स्यान्निधिः शङ्खः स्वयं भुङ्क्ते धनादि(न्त)कम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005870012, "chapter_id": 25870, "verse_number": "१-५३-१३", "content_sanskrit": "कदन्नभुक्परिजनो न च शोभनवस्त्रधृक।\nस्वपोषणपरः शंखी दद्यात्परनरे वृथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005870013, "chapter_id": 25870, "verse_number": "१-५३-१४", "content_sanskrit": "मिश्रावलोकनान्मिश्रस्वभावफलदायिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005870014, "chapter_id": 25870, "verse_number": "१-५३-१५", "content_sanskrit": "निधीनां रूपमुक्तं तु हरिणापि हरादिके ।\nहरिर्भुवनकोशादि यथोवाच तथा वदे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]