[{"id": 2175942, "chapter_id": 4725, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2175943, "chapter_id": 4725, "verse_number": "१", "content_sanskrit": "कथं कुमारी भगवन् तपोयुक्ता ह्यभूत् पुरा ।\nकिमर्थं च तपस्तेपे को वाऽस्या नियमोऽभवत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2175944, "chapter_id": 4725, "verse_number": "२", "content_sanskrit": "सुदुष्करमिदं ब्रह्मन् त्वत्तः श्रुतमनुत्तमम् ।\nआख्याहि तत्त्वमखिलं कथं सा तपसि स्थिता\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2175945, "chapter_id": 4725, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2175946, "chapter_id": 4725, "verse_number": "३", "content_sanskrit": "ऋषिरासीन्महावीर्यः कुणिर्गार्ग्यो महायशाः ।\nतप्त्वा तु विपुलं राजन् तपस्तु तपतां वरः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2175947, "chapter_id": 4725, "verse_number": "४", "content_sanskrit": "तपसा संयुता सुभ्रूः समुत्पन्ना महात्मनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2175948, "chapter_id": 4725, "verse_number": "५", "content_sanskrit": "तां च दृष्ट्वा भृशं प्रीतः कुणिर्गार्ग्यो महायशाः ।\nजगाम त्रिदिवं राजन् सन्त्यज्य स्वकलेबरम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2175949, "chapter_id": 4725, "verse_number": "६", "content_sanskrit": "सुभ्रूः साऽप्यथ कल्याणी पुण्डरीकनिभेक्षणा ।\nमहता तपसोग्रेण कृत्वाऽऽश्रममनिन्दिता\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2175950, "chapter_id": 4725, "verse_number": "७", "content_sanskrit": "उपवासैः पूजयन्ती पितॄन् देवांश्च सा पुरा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2175951, "chapter_id": 4725, "verse_number": "८", "content_sanskrit": "तस्यास्तु तपसोग्रेण महान् कालोऽत्यगान्नृप\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2175952, "chapter_id": 4725, "verse_number": "९", "content_sanskrit": "सा पित्रा दीयमानाऽपि पतिं नैच्छदनिन्दिता ।\nआत्मनः सदृशं सा तु भर्तारं नान्वपद्यत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2175953, "chapter_id": 4725, "verse_number": "१०", "content_sanskrit": "ततः सा तपसोग्रेण पीडयित्वाऽऽत्मनस्तनुम् ।\nपितृदेवार्चनरता बभूव विजने वने\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2175954, "chapter_id": 4725, "verse_number": "११", "content_sanskrit": "साऽऽत्मानं मन्यमाना तु कृतकृत्यं श्रमान्विता ।\nजगाम वृद्धभावं च कौमारब्रह्मचारिणी\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2175955, "chapter_id": 4725, "verse_number": "१२", "content_sanskrit": "वार्धक्येन च राजेन्द्र तपसैव च कर्शिता\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2175956, "chapter_id": 4725, "verse_number": "१३", "content_sanskrit": "सा नाशकद् यदा गन्तुं पदात् पदमपि स्वयम् ।\nचकार गमने बुद्धिं परलोकाय वै तदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2175957, "chapter_id": 4725, "verse_number": "१४", "content_sanskrit": "मोक्तुकामां तु तां दृष्ट्वा शरीरं नारदोऽब्रवीत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2175958, "chapter_id": 4725, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2175959, "chapter_id": 4725, "verse_number": "१५", "content_sanskrit": "असंस्कृतायाः कन्यायाः कुतो लोकास्तवानघे ।\nएवं हि श्रुतमस्माभिर्देवलोके महाव्रते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2175960, "chapter_id": 4725, "verse_number": "", "content_sanskrit": "तपः परमकं प्राप्य न तु लोकास्त्वया जिताः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2175961, "chapter_id": 4725, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2175962, "chapter_id": 4725, "verse_number": "१६", "content_sanskrit": "तन्नारदवचः श्रुत्वा साऽब्रवीद् ऋषिसंसदि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2175963, "chapter_id": 4725, "verse_number": "", "content_sanskrit": "वृद्धकन्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2175964, "chapter_id": 4725, "verse_number": "१७", "content_sanskrit": "तपसोऽर्धं प्रयच्छामि पाणिग्राहस्य सत्तमाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2175965, "chapter_id": 4725, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2175966, "chapter_id": 4725, "verse_number": "१८", "content_sanskrit": "इत्युक्तेऽस्यास्तु जग्राह पाणिं गालवसम्भवः ।\nऋषिः प्राक् शृङ्गवान्नाम समयं चेममब्रवीत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2175967, "chapter_id": 4725, "verse_number": "", "content_sanskrit": "शृङ्गवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2175968, "chapter_id": 4725, "verse_number": "१९", "content_sanskrit": "समयेन तवाद्याहं पाणिं स्प्रक्ष्यामि शोभने ।\nयद्येकरात्रं वस्तव्यं त्वया सह ममेति ह\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2175969, "chapter_id": 4725, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2175970, "chapter_id": 4725, "verse_number": "२०", "content_sanskrit": "तथेति सा प्रतिश्रुत्य तस्य पाणिं ददौ ततः ।\nचक्रे च पाणिग्रहणं तदुद्वाहं च गालवः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2175971, "chapter_id": 4725, "verse_number": "२१", "content_sanskrit": "सा रात्राभवद् राजन् तरुणी दिव्यरूपिणी ।\nदिव्याभरणवस्त्रा च दिव्यस्रगनुलेपना\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2175972, "chapter_id": 4725, "verse_number": "२२", "content_sanskrit": "तां दृष्ट्वा गालवः प्रीतो दीपयन्तीमिवात्मना ।\nउवास च क्षपामेकां प्रभाते साऽब्रवीच्च तम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2175973, "chapter_id": 4725, "verse_number": "", "content_sanskrit": "वृद्धकन्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2175974, "chapter_id": 4725, "verse_number": "२३", "content_sanskrit": "यस्त्वया समयो ब्रह्मन् कृतो ब्रह्मर्षिसंसदि ।\nतेनोषिताऽस्मि भद्रं ते स्वस्ति तेऽस्तु व्रजाम्यहम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2175975, "chapter_id": 4725, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2175976, "chapter_id": 4725, "verse_number": "२४", "content_sanskrit": "सा तु ध्यात्वाऽब्रवीद् भूयो योऽस्मिंस्तीर्थे समाहितः ।\nउषित्वा रजनीमेकां तर्पयित्वा दिवौकसः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2175977, "chapter_id": 4725, "verse_number": "२५", "content_sanskrit": "चत्वारिंशतमष्टौ च द्वौ चाष्टौ सम्यगाचरेत् ।\nब्रह्मचर्यं हि शान्तात्मा फलं तस्य लभेत सः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2175978, "chapter_id": 4725, "verse_number": "२६", "content_sanskrit": "एवमुक्त्वा ततः साध्वी देहं त्यक्त्वा दिवं गता\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2175979, "chapter_id": 4725, "verse_number": "२७", "content_sanskrit": "ऋषेरप्यभवद् दीनो रूपं तस्या विचिन्तयन् ।\nसमयेन तपोऽर्धं च कृच्छ्रात् प्रतिगृहीतवान्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2175980, "chapter_id": 4725, "verse_number": "२८", "content_sanskrit": "साधयित्वा तदाऽऽत्मानं तस्याः सङ्गतिमन्वयात् ।\nदुःखितो भरतश्रेष्ठ तस्या रूपबलात्कृतः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2175981, "chapter_id": 4725, "verse_number": "२९", "content_sanskrit": "एतत् ते वृद्धकन्याया व्याख्यातं चरितं महत् ।\nतथैव ब्रह्मचर्यञ्च स्वर्गस्य च मतिः शुभा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2175982, "chapter_id": 4725, "verse_number": "३०", "content_sanskrit": "तत्रस्थोऽपि च शुश्राव हतं शल्यं हलायुधः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2175983, "chapter_id": 4725, "verse_number": "३१", "content_sanskrit": "तत्रापि दत्त्वा दानानि द्विजातिभ्यः परन्तप ।\nशुशोच शल्यं सङ्ग्रामे निहतं पाण्डवैस्तदा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2175984, "chapter_id": 4725, "verse_number": "३२", "content_sanskrit": "समन्तपञ्चकद्वारात् ततो निष्क्रम्य माधवः ।\nपप्रच्छर्षिगणान् रामः कुरुक्षेत्रस्य यत् फलम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2175985, "chapter_id": 4725, "verse_number": "३३", "content_sanskrit": "ते पृष्टा यदुसिंहेन कुरुक्षेत्रफलं विभो ।\nसमाचख्युर्महात्मानस्तस्मै सर्वं यथातथम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2175986, "chapter_id": 4725, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि वृद्धकन्याचरितं नाम त्रयोविंशोऽध्यायः ॥२३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]