[{"id": 2100031, "chapter_id": 3142, "verse_number": "१३-२७२-१", "content_sanskrit": "जनमेजय उवाच।\nशरतल्पगते भीष्मे कौरवाणां धुरन्धरे।\nशयाने वीरशयने पाण्डवैः समुपस्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100032, "chapter_id": 3142, "verse_number": "१३-२७२-२", "content_sanskrit": "युधिष्ठिरो महाप्राज्ञो मम पूर्वपितामहः।\nधर्माणामागमं श्रुत्वा विदित्वा सर्वसंशयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100033, "chapter_id": 3142, "verse_number": "१३-२७२-३", "content_sanskrit": "दानानां च विधिं श्रुत्वा च्छिन्नधर्मार्थसंशयः।\nयदन्यदकरोद्विप्र तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100034, "chapter_id": 3142, "verse_number": "१३-२७२-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100035, "chapter_id": 3142, "verse_number": "१३-२७२-४", "content_sanskrit": "अभून्मुहूर्तं स्तिमितं सर्वं तद्राजमण्डलम्।\nतूष्णींभूते ततस्तस्मिन्पटे चित्रमिवार्पितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100036, "chapter_id": 3142, "verse_number": "१३-२७२-५", "content_sanskrit": "मुहूर्तमिव च ध्यात्वा व्यासःक सत्यवतीसुतः।\nनृपं शयानं गाङ्गेयमिदमाह वचस्त्वरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100037, "chapter_id": 3142, "verse_number": "१३-२७२-६", "content_sanskrit": "राजन्प्रकृतिमापन्नः कुरुराजो युधिष्ठिरः।\nसहितो भ्रातृभिः सर्वैः पार्तिवैश्चानुयायिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100038, "chapter_id": 3142, "verse_number": "१३-२७२-७", "content_sanskrit": "उपास्ते त्वां नरव्याघ्र सह कृष्णेन धीमता।\nतमिमं पुरयानाय समनुज्ञातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100039, "chapter_id": 3142, "verse_number": "१३-२७२-८", "content_sanskrit": "एवमुक्तो भगवता व्यासेन पृथिवीपतिः।\nयुधिष्ठिरं सहामात्यमनुजज्ञे नदीसुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100040, "chapter_id": 3142, "verse_number": "१३-२७२-९", "content_sanskrit": "उवाच चैनं मधुरं नृपं शान्तनवो नृपः।\nप्रविशस्व पुरीं राजन्धर्मे च ध्रियतां मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100041, "chapter_id": 3142, "verse_number": "१३-२७२-१०", "content_sanskrit": "यजस्व विविधैर्यजैर्बह्वन्नैः स्वाप्तदक्षिणैः।\nययातिरिव राजेन्द्र श्रकद्धादमपुरःसरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100042, "chapter_id": 3142, "verse_number": "१३-२७२-११", "content_sanskrit": "क्षत्रधर्मरतः पार्थ पितॄन्देवांश्च तर्पय।\nश्रेयसा योक्ष्यसे चैव व्येतु ते मानसो ज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100043, "chapter_id": 3142, "verse_number": "१३-२७२-१२", "content_sanskrit": "रञ्जयस्व प्रजाः सर्वाः प्रकृतीः परिसान्त्वय।\nसुहृदः फलसत्कारैरर्चयस्व यथार्हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100044, "chapter_id": 3142, "verse_number": "१३-२७२-१३", "content_sanskrit": "अनुं त्वां तात जीवन्तु मित्राणि सुहृकदस्तथा।\nचैत्यस्थाने स्थितं वृक्षं फलवन्तमिव द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100045, "chapter_id": 3142, "verse_number": "१३-२७२-१४", "content_sanskrit": "आगन्तव्यं च भवता समये मम पार्थिव।\nविनिवृत्ते दिनकरे प्रवृत्ते चोत्तरायणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100046, "chapter_id": 3142, "verse_number": "१३-२७२-१५", "content_sanskrit": "तथेत्युक्त्वा च कौन्तेयः सोभिवाद्य पितामहम्।\nप्रययौ सपरीवारो नगरं नागसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100047, "chapter_id": 3142, "verse_number": "१३-२७२-१६", "content_sanskrit": "धृतराष्ट्रं पुरस्कृत्य गान्धारीं च पतिव्रताम्।\nसह तैर्ऋषिभिः सर्वैर्भ्रातृभिः केशवेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100048, "chapter_id": 3142, "verse_number": "१३-२७२-१७", "content_sanskrit": "पौरजानपदैश्चैव मन्त्रिवृद्धैश्च पार्थिव।\nप्रविवेश कुरुश्रेष्ठः पुरं वारणसाह्वयम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100049, "chapter_id": 3142, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्विसप्तत्यधिकद्विशततमोऽध्यायः॥ २७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]