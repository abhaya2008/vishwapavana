[{"id": 2066074, "chapter_id": 2396, "verse_number": "९-१४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2066075, "chapter_id": 2396, "verse_number": "९-१४-१", "content_sanskrit": "दुर्योधनो महाराज धृष्टद्युम्नश्च पार्षतः।\nचक्रतुः सुमहद्युद्धं शरशक्तिसमाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2066076, "chapter_id": 2396, "verse_number": "९-१४-२", "content_sanskrit": "ततो राजन्समापेतुः शरधाराः सहस्रशः।\nअम्बुदानां यथा काले जलधाराः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2066077, "chapter_id": 2396, "verse_number": "९-१४-३", "content_sanskrit": "राजा च पार्षतं विद्ध्वा शरैः पञ्चभिराशुगैः।\nद्रोणहन्तारमुग्रेषुं पुनर्विव्याध सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2066078, "chapter_id": 2396, "verse_number": "९-१४-४", "content_sanskrit": "धृष्टद्युम्नस्तु समरे बलवान्दृढविक्रमः।\nसप्तत्या विशिखानां वै दुर्योधनमपीडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2066079, "chapter_id": 2396, "verse_number": "९-१४-५", "content_sanskrit": "पीडितं वीक्ष्य राजानं सोदर्या भरतर्षभ।\nमहत्या सेनया सार्धं परिवव्रुः स्म पार्षतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2066080, "chapter_id": 2396, "verse_number": "९-१४-६", "content_sanskrit": "स तैः परिवृतः शूरः सर्वतोऽतिरथै र्भृशम्।\nव्यचरत्समरे राजन्दर्शयन्नस्त्रलाघवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2066081, "chapter_id": 2396, "verse_number": "९-१४-७", "content_sanskrit": "शिखण्डी कृतवर्माणं गौतमं च महारथम्॥\nप्रभद्रकैः समायुक्तो योधयामास धन्विनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2066082, "chapter_id": 2396, "verse_number": "९-१४-८", "content_sanskrit": "तत्रापि सुमहद्युद्धं घोररूपं विशाम्पते।\nप्राणान्सन्तजतां युद्धे प्राणद्यूताभिदेवने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2066083, "chapter_id": 2396, "verse_number": "९-१४-९", "content_sanskrit": "शल्यः सायकवर्षाणि विमुञ्जन्सर्वतोदिशम्।\nपाण्डवान्पीडयामास ससात्यकिवृकोदरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2066084, "chapter_id": 2396, "verse_number": "९-१४-१०", "content_sanskrit": "तथा तौ तु यमौ यमतुल्यपराक्रमौ।\nयोधयामास राजेन्द्र वीर्येणास्त्रबलेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2066085, "chapter_id": 2396, "verse_number": "९-१४-११", "content_sanskrit": "शल्यसायकनुन्नानां पाण्डवानां महामृधे।\nत्रातारं नाध्यगच्छन्त केचित्तत्र महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2066086, "chapter_id": 2396, "verse_number": "९-१४-१२", "content_sanskrit": "ततस्तु नकुलः शूरो धर्मराजे प्रपीडिते।\nअभिदुद्राव वेगेन मातुलं माद्रिनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2066087, "chapter_id": 2396, "verse_number": "९-१४-१३", "content_sanskrit": "सञ्छाद्य समरे वीरं नकुलः परवीरहा।\nविव्याध चैनं दशभिः स्मयमानः स्तनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2066088, "chapter_id": 2396, "verse_number": "९-१४-१४", "content_sanskrit": "सर्वपारसवैर्बाणैः कर्मारपरिमार्जितैः।\nस्वर्णपुङ्खैः शिलाधौतैर्धनुर्यन्त्रप्रचोदितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2066089, "chapter_id": 2396, "verse_number": "९-१४-१५", "content_sanskrit": "शल्यस्तु पीडितस्तेन स्वस्रीयेण हि मातुलः।\nनकुलं पीडयामास पत्रिभिर्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2066090, "chapter_id": 2396, "verse_number": "९-१४-१६", "content_sanskrit": "ततो युधिष्ठिरो राजा भीमसेनोऽथ सात्यकिः।\nसहदेवश्च माद्रेणो मद्रराजमुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2066091, "chapter_id": 2396, "verse_number": "९-१४-१७", "content_sanskrit": "तानापतत एवाशु पूरयाणान्रथस्वनैः।\nदिशश्च विदिशश्चैव कम्पयानांश्च मेदिनीम्।\nप्रतिजग्राह समरे सेनापतिरमित्रजित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2066092, "chapter_id": 2396, "verse_number": "९-१४-१८", "content_sanskrit": "युधिष्ठिरं त्रिभिर्विद्ध्वा भीमसेनं च पञ्चभिः।\nसात्यकिं च शतेनाजौ सहदेवं त्रिभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2066093, "chapter_id": 2396, "verse_number": "९-१४-१९", "content_sanskrit": "ततस्तु सशरं चापं नकुलस्य महात्मनः।\nमद्रेश्वरः क्षुरप्रेण मध्ये चिच्छेद मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2066094, "chapter_id": 2396, "verse_number": "९-१४-२०", "content_sanskrit": "तदपास्य धनुश्छिन्नं ततः शल्यस्य सायकैः।\nअथान्यद्धनुरादाय माद्रीपुत्रो महारथः।\nमद्रराजरथं तूर्णं पूरयामास पत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2066095, "chapter_id": 2396, "verse_number": "९-१४-२१", "content_sanskrit": "युधिष्ठिरस्तु मद्रेशं सहदेवश्च मारिष।\nदशभिर्दशभिर्बाणैरुरस्येनमविध्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2066096, "chapter_id": 2396, "verse_number": "९-१४-२२", "content_sanskrit": "भीमसेनस्तु तं षष्ट्या सात्यकिर्दशभिः शरैः।\nमद्रराजमभिद्रुत्य जघ्नतुः xxङ्कपत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2066097, "chapter_id": 2396, "verse_number": "९-१४-२३", "content_sanskrit": "मद्रराजस्ततः क्रुद्धः सात्यकिं नवभिः शरैः।\nविव्याध भूयः सप्तत्या शराणां नतपर्वणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2066098, "chapter_id": 2396, "verse_number": "९-१४-२४", "content_sanskrit": "अथास्य सशरं चापं मुष्टौ चिच्छेद मारिष।\nहयांश्च चतुरः सङ्ख्ये प्रेषयामास मृत्यवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2066099, "chapter_id": 2396, "verse_number": "९-१४-२५", "content_sanskrit": "विरथं सात्यकिं कृत्वा मद्रराजो महारथः।\nविशिखानां शतेनैनमाजघान समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2066100, "chapter_id": 2396, "verse_number": "९-१४-२६", "content_sanskrit": "माद्रीपुत्रं च संरब्धो भीमसेनं च पाण्डवम्।\nयुधिष्ठिरं च कौरव्य विव्याध दशभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2066101, "chapter_id": 2396, "verse_number": "९-१४-२७", "content_sanskrit": "तत्राद्भुतमपश्याम मद्रराजस्य पौरुषम्।\nयदेनं सहिताः पार्था नाभ्यवर्तन्त संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2066102, "chapter_id": 2396, "verse_number": "९-१४-२८", "content_sanskrit": "अथान्यं रथमास्थाय सात्यकिः सत्यविक्रमः।\nपीडितान्पाण्डवान्दृष्ट्वा मद्रराजवशं गतान्।\nअभिदुद्राव वेगेन मद्राणामधिपं बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2066103, "chapter_id": 2396, "verse_number": "९-१४-२९", "content_sanskrit": "आपतन्तं रथं तस्य शल्यः समितिशोभनः।\nप्रत्युद्ययौ रथेनैव मत्तो मत्तमिव द्विपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2066104, "chapter_id": 2396, "verse_number": "९-१४-३०", "content_sanskrit": "स सन्निपातस्तुमुलो बभूवाद्भुतदर्शनः।\nसात्यकेश्चैव शूरस्य मद्राणामधिपस्य च।\nयादृशो वै पुरा वृत्तः शम्बरामरराजयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2066105, "chapter_id": 2396, "verse_number": "९-१४-३१", "content_sanskrit": "सात्यकिः प्रेक्ष्य समरे मद्रराजमवस्थितम्।\nविव्याध दशभिर्बाणैस्तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2066106, "chapter_id": 2396, "verse_number": "९-१४-३२", "content_sanskrit": "मद्रराजस्तु सुभृशं विद्धस्तेन महात्मना।\nसात्यकिं प्रतिविव्याध चित्रपुङ्खैः शितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2066107, "chapter_id": 2396, "verse_number": "९-१४-३३", "content_sanskrit": "ततः पार्था महेष्वासाः सात्वताऽभिसृतं नृपम्।\nअभ्यवर्तन्रथैस्तूर्णं मातुलं वधकाङ्क्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2066108, "chapter_id": 2396, "verse_number": "९-१४-३४", "content_sanskrit": "तत आसीत्परामर्दस्तुमुलः शोणितोदकः।\nशूराणां युध्यमानानां सिंहानामिव नर्दताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2066109, "chapter_id": 2396, "verse_number": "९-१४-३५", "content_sanskrit": "तेषामासीन्महाराज व्यधिक्षेपः परस्परम्।\nसिंहानामामिषेप्सूनां कूजतामिव संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2066110, "chapter_id": 2396, "verse_number": "९-१४-३६", "content_sanskrit": "तेषां बाणसहस्रौघैराकीर्णा वसुधाऽभवत्।\nअन्तरिक्षं च सहसा बाणभूतमभूत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2066111, "chapter_id": 2396, "verse_number": "९-१४-३७", "content_sanskrit": "शरान्धकारं सहसा कृतं तेन समन्ततः।\nअभ्रच्छायेव सञ्जज्ञे शरैर्मुक्तैर्महात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2066112, "chapter_id": 2396, "verse_number": "९-१४-३८", "content_sanskrit": "तत्र राजञ्शरैर्मुक्तैर्निर्मुक्तैरिव पन्नैगः।\nस्वर्णपुङ्खैः प्रकाशद्भिर्व्यरोचन्त दिशस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2066113, "chapter_id": 2396, "verse_number": "९-१४-३९", "content_sanskrit": "तत्राद्भुतं परं चक्रे शल्यः शत्रुनिबर्हणः।\nयदेकः समरे शूरो योधयामास वै बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2066114, "chapter_id": 2396, "verse_number": "९-१४-४०", "content_sanskrit": "मद्रराजभुजोत्सृष्टैः कङ्कबर्हिणवाजितैः।\nसम्पतद्भिः शरैर्घोरैरवाकीर्यत मेदिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2066115, "chapter_id": 2396, "verse_number": "९-१४-४१", "content_sanskrit": "तत्र शल्यरथं राजन्विचरन्तं महाहवे।\nअपश्याम यथापूर्वं शक्रस्यासुरसंक्षये॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2066116, "chapter_id": 2396, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि अष्टादशदिवसयुद्धे चतुर्दशोऽध्यायः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]