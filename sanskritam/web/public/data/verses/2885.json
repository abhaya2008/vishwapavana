[{"id": 2088507, "chapter_id": 2885, "verse_number": "१३-१५-१", "content_sanskrit": "भीष्म उवाच।\nअत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nमद्रराजस्य संवादं व्यासस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088508, "chapter_id": 2885, "verse_number": "१३-१५-२", "content_sanskrit": "वैताने कर्मणि तते कुन्तीपुत्र यथा पुरा।\nउक्तः स भगवान्यज्ञे तथा तत्राशृणोद्भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088509, "chapter_id": 2885, "verse_number": "१३-१५-३x", "content_sanskrit": "मद्रराज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088510, "chapter_id": 2885, "verse_number": "१३-१५-३", "content_sanskrit": "कानि तीर्थानि भगवन्फलार्थाश्चेह केऽऽश्रमाः।\nक इज्यते कश्च यज्ञः को यूपः क्रमते च कः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088511, "chapter_id": 2885, "verse_number": "१३-१५-४", "content_sanskrit": "कश्चाध्वरे शस्यते गीतिशब्दैः\nकश्चाध्वरे गीयते वल्गुभाषैः।\nको ब्रह्मशब्दैः स्तुतिभिः स्तूयते च\nकस्येह वै हविरध्वर्यवः कल्पयन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088512, "chapter_id": 2885, "verse_number": "१३-१५-५", "content_sanskrit": "वर्णाश्रमे गोफले कश्च सोमे\nकश्चोंकारः कश्च वेदार्थमार्गः।\nपृष्टस्तन्मे ब्रूहि सर्वं महर्षे\nलोकज्येष्ठं कस्य विज्ञानमाहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088513, "chapter_id": 2885, "verse_number": "१३-१५-६x", "content_sanskrit": "द्वैपायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088514, "chapter_id": 2885, "verse_number": "१३-१५-६", "content_sanskrit": "लोकज्येष्ठं यस्य विज्ञानमाहु\nर्योनिज्येष्ठं यस्य वदन्ति जन्म।\nपूतात्मानो ब्राह्मणा वेदमुख्या\nअस्मिन्प्रश्नो दीयतां केशवाय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088515, "chapter_id": 2885, "verse_number": "१३-१५-७x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088516, "chapter_id": 2885, "verse_number": "१३-१५-७", "content_sanskrit": "बालो जात्या क्षत्रधर्मार्थशीलो\nजातो देवक्यां शूरपुत्रेण वीर।\nवेत्तुं वेदानर्हते क्षत्रियो वै\nदाशार्हाणामुत्तमः पुष्कराक्षः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088517, "chapter_id": 2885, "verse_number": "१३-१५-८x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088518, "chapter_id": 2885, "verse_number": "१३-१५-८", "content_sanskrit": "पाराशर्य ब्रूहि यद्ब्राह्मणेभ्यः\nप्रीतात्मा वै ब्रह्मकल्पः सुमेधाः।\nपृष्टो यज्ञार्थं पाण्डवस्यातितेजा\nएतच्छ्रेयस्तस्य लोकस्य चैव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088519, "chapter_id": 2885, "verse_number": "१३-१५-९x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088520, "chapter_id": 2885, "verse_number": "१३-१५-९", "content_sanskrit": "उक्तं वाक्यं यद्भवान्मामवोच-\nत्प्रश्नं चित्रं नाहमत्रोत्सहेऽद्य।\nछेत्तुं विस्पष्टं तिष्ठति त्वद्विधे वै\nलोकज्येष्ठे विश्वरूपे सुनाभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088521, "chapter_id": 2885, "verse_number": "१३-१५-१०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088522, "chapter_id": 2885, "verse_number": "१३-१५-१०", "content_sanskrit": "तत्त्वं वाक्यं ब्रूहि यत्त्वं महर्षे\nयस्मिन्कृष्णः प्रोच्यते वै यथावत्।\nप्रीतस्तेऽहं ज्ञानशक्त्या यथाव-\nत्तस्मान्निर्देशे कर्मणां ब्रूहि सिद्धिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088523, "chapter_id": 2885, "verse_number": "१३-१५-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088524, "chapter_id": 2885, "verse_number": "१३-१५-११", "content_sanskrit": "उक्तवाक्ये सत्तमे यादवानां\nकृष्णो व्यासः प्राञ्जलिर्वासुदेवम्।\nविप्रैः सार्धं पूजयन्देवदेवं\nकृष्णं विष्णुं वासुदेवं बभाषे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088525, "chapter_id": 2885, "verse_number": "१३-१५-१२x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088526, "chapter_id": 2885, "verse_number": "", "content_sanskrit": "आनन्त्यं ते विश्वकर्मंस्तवैवं\nरूपं पौराणं शाश्वतं च ध्रुवं च।\nकस्ते बुद्ध्येद्वेदवादेषु चैत-\nल्लोके ह्यस्मिञ्शासकस्त्वं पितेव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]