[{"id": 2112154, "chapter_id": 3420, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2112155, "chapter_id": 3420, "verse_number": "१", "content_sanskrit": "स तथा सह पुत्रेण रममाणो महीपतिः ।\nवर्तयामास वर्षाणि चत्वार्यतुलविक्रमः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2112156, "chapter_id": 3420, "verse_number": "२", "content_sanskrit": "स कदाचिद् वनं यातो यमुनामभितो नदीम् ।\nमहीपतिरनिर्देश्यमजिघ्रद् गन्धमुत्तमम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2112157, "chapter_id": 3420, "verse_number": "३", "content_sanskrit": "तस्य प्रभवमन्विच्छन् विचचार वनं नृपः ।\nस ददर्श तदा कन्यां दाशानां देवरूपिणीम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2112158, "chapter_id": 3420, "verse_number": "४", "content_sanskrit": "तामपृच्छत् ततो राजा कन्यां कमललोचनाम् ।\nकस्य त्वमसि का चासि किं च तेऽत्र चिकीर्षितम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2112159, "chapter_id": 3420, "verse_number": "५", "content_sanskrit": "साऽब्रवीद् दाशकन्याऽस्मि धर्मार्थं वाहये प्लवम् ।\nपितुर्नियोगाद् भद्रं ते दाशराज्ञो महात्मनः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2112160, "chapter_id": 3420, "verse_number": "६", "content_sanskrit": "ज्ञात्वा च पितरं तस्या वरयामास तां तदा ।\nरूपमाधुर्यगन्धैश्च संयुक्तां देवरूपिणीम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2112161, "chapter_id": 3420, "verse_number": "७", "content_sanskrit": "समीक्ष्य राजा दाशेयीं कामयामास शन्तनुः ।\nपर्यपृच्छत् ततस्तस्या पितरं चात्मकारणात्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2112162, "chapter_id": 3420, "verse_number": "८", "content_sanskrit": "सम्भ्रमात् प्रत्युवाचेदं दाशराजो महीपतिम् ।\nयाचमानाय वै देया वराय वरवर्णिनी \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2112163, "chapter_id": 3420, "verse_number": "९", "content_sanskrit": "हृदि कामस्तु मे कश्चित् तं निबोध जनेश्वर ।\nयदीमां धर्मपत्नीं त्वं मत्तः प्रार्थयसे नृप \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2112164, "chapter_id": 3420, "verse_number": "१०", "content_sanskrit": "सत्यवागसि सत्येन समयं कुरु पार्थिव ।\nततो दास्यामि राजेन्द्र तव कन्यामिमां नृप ।\nन हि मे त्वत्समः कश्चिद् वरो जातु भविष्यति \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2112165, "chapter_id": 3420, "verse_number": "", "content_sanskrit": "शन्तनुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2112166, "chapter_id": 3420, "verse_number": "११", "content_sanskrit": "श्रुत्वा तव वरं दाश व्यवसायो भविष्यति ।\nदातव्यं चेत् प्रदास्यामि न त्वदेयं कथञ्चन \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2112167, "chapter_id": 3420, "verse_number": "", "content_sanskrit": "दाशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2112168, "chapter_id": 3420, "verse_number": "१२", "content_sanskrit": "योऽस्यां जातस्तव सुतः स राजा त्वदनन्तरम् ।\nत्वदूर्ध्वमभिषेक्तव्यो नान्यः कश्चन भारत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2112169, "chapter_id": 3420, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2112170, "chapter_id": 3420, "verse_number": "१३", "content_sanskrit": "नाकामयत तं दातुं वरं दाशाय शन्तनुः ।\nशरीरजमसह्यं तं दीप्यमानमधारयत् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2112171, "chapter_id": 3420, "verse_number": "१४", "content_sanskrit": "स चिन्तयन्नेव तदा दाशकन्यां महीपतिः ।\nप्रत्ययाद्धस्तिनपुरं शोकोपहतचेतनः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2112172, "chapter_id": 3420, "verse_number": "१५", "content_sanskrit": "ततः कदाचिच्छोचन्तं शन्तनुं ध्यानमास्थितम् ।\nपुत्रो देवव्रतो ह्मेत्य पितरं वाक्यमब्रवीत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2112173, "chapter_id": 3420, "verse_number": "१६", "content_sanskrit": "सर्वत्र भवतां क्षेमं विधेयाः सर्वशत्रवः ।\nअकस्माद् राजशार्दूल शोचंस्तु परिदृश्यसे \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2112174, "chapter_id": 3420, "verse_number": "१७", "content_sanskrit": "तत् किमर्थमिहाभीक्ष्णं परिशोचसि दुःखितः ।\nकस्मान्न भुङ्क्षे राजंस्त्वं न किञ्चिदपि भाषसे \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2112175, "chapter_id": 3420, "verse_number": "१८", "content_sanskrit": "न चाश्व्येन च निर्यासि विवर्णो हरिणः कृशः ।\nव्याधिमिच्छामि ते ज्ञातुं प्रतिकुर्यां हि तत्र वै\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2112176, "chapter_id": 3420, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2112177, "chapter_id": 3420, "verse_number": "१९", "content_sanskrit": "स तं काममवाच्यं वै दाशकन्यां प्रतीदृशम् ।\nविवृतं नाशकत् तस्मै पिता पुत्राय शंसितुम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2112178, "chapter_id": 3420, "verse_number": "२०", "content_sanskrit": "एवमुक्तस्तु पुत्रेण शन्तनुः प्रत्यभाषत ।\nअसंशयं महाप्राज्ञ यथैवात्थ तथैव तत् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2112179, "chapter_id": 3420, "verse_number": "२१", "content_sanskrit": "अपत्यं नस्त्वमेवैकः कुले महति भारत ।\nअनुवृत्त्या स्मरन् नॄणामतः शोचामि पुत्रक\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2112180, "chapter_id": 3420, "verse_number": "२२", "content_sanskrit": "कथञ्चित् त्वयि गाङ्गेय विपन्ने नास्ति नः कुले ।\nअसंशयं त्वमेवैको मम पुत्रशताद् वरः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2112181, "chapter_id": 3420, "verse_number": "२३", "content_sanskrit": "न चाप्यहं वृथा भूयो दारान् कर्तुमिहोत्सहे ।\nसन्तानस्याविनाशं तु कामये भद्रमस्तु ते \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2112182, "chapter_id": 3420, "verse_number": "२४", "content_sanskrit": "अपुत्रतैकपुत्रत्वं सममाहुर्मनीषिणः ।\nचक्षुरेकं च पुत्रश्च अस्ति नास्ति यथा तथा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2112183, "chapter_id": 3420, "verse_number": "२५", "content_sanskrit": "चक्षुर्नाशे तनोर्नाशः पुत्रनाशे कुलक्षयः ।\nअग्निहोत्रं त्रयो वेदा यज्ञाश्च सहदक्षिणाः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2112184, "chapter_id": 3420, "verse_number": "२६", "content_sanskrit": "सर्वाण्येतान्यपत्यस्य कलां नार्हन्ति षोडशीम् ।\nएवमेव मनुष्येषु स्याच्च सर्वं प्रजास्वपि \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2112185, "chapter_id": 3420, "verse_number": "२७", "content_sanskrit": "यदपत्यं महाप्राज्ञ तत्र मे नास्ति संशयः ।\nअपत्यादनृणो लोके पितृणां नास्ति संशयः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2112186, "chapter_id": 3420, "verse_number": "२८", "content_sanskrit": "एषा त्रयी पुराणानामुत्तमानां च शाश्वती ।\nअपत्यं कर्म विद्या च त्रीणि ज्योतींषि भारत \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2112187, "chapter_id": 3420, "verse_number": "२९", "content_sanskrit": "तदिदं कारणं तात सर्वमाख्यातमञ्जसा ।\nत्वं च शूरः सदाऽमर्षी शस्त्रनित्यश्च भारत \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2112188, "chapter_id": 3420, "verse_number": "३०", "content_sanskrit": "नान्यत्र शस्त्रात् ते पुत्र निधनं विद्यतेऽनघ ।\nसोऽस्मि संशयमापन्नस्त्वयि शान्ते कथं भवेत् ।\nएतन्मे कारणं तात दुःखमूलमशेषतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2112189, "chapter_id": 3420, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2112190, "chapter_id": 3420, "verse_number": "३१", "content_sanskrit": "स तस्य पितुराज्ञाय मतं समनुचिन्त्य च ।\nदेवव्रतो महाबुद्धिः प्रयाणमनुचिन्तयन्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2112191, "chapter_id": 3420, "verse_number": "३२", "content_sanskrit": "अपत्यफलसंयुक्तमेतच्छ्रुत्वा पितुर्वचः ।\nसूतं भूयोऽभि सन्तप्तमाह्वयामास वै पितुः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2112192, "chapter_id": 3420, "verse_number": "३३", "content_sanskrit": "सूतस्तु कुरुमुख्यस्य उपयातस्तदाज्ञया ।\nतमुवाच महाप्राज्ञो भीष्मो वै सारथिं पितुः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2112193, "chapter_id": 3420, "verse_number": "३४", "content_sanskrit": "त्वं सारथे पितुर्मह्यं सखाऽसि रथधूर्गतः ।\nअभिजानासि यदि वै यस्यां भावो नृपस्य तु ।\nएतदाचक्ष्व मे पृष्टः करिष्ये न तदन्यथा \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2112194, "chapter_id": 3420, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2112195, "chapter_id": 3420, "verse_number": "३५", "content_sanskrit": "दाशकन्यां कुरुश्रेष्ठ तत्र भावः पितुर्गतः ।\nवृतः स नरदेवेन तदा वचनमब्रवीत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2112196, "chapter_id": 3420, "verse_number": "३६", "content_sanskrit": "योऽस्यां पुमान् भवेज्जातः स राजा त्वदनन्तरम् ।\nनाकामयत तं दातुं पिता तव वरं तदा \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2112197, "chapter_id": 3420, "verse_number": "३७", "content_sanskrit": "सदाऽपि निश्चयस्तस्य न च दद्यामतोऽन्यथा ।\nएतत् ते कथितं वीर कुरुष्व यदनन्तरम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2112198, "chapter_id": 3420, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2112199, "chapter_id": 3420, "verse_number": "३८", "content_sanskrit": "ततः स पितुराज्ञाय मतं सम्यगवेक्ष्य च ।\nज्ञात्वा विमनसं पुत्रः प्रययौ यमुनां प्रति \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2112200, "chapter_id": 3420, "verse_number": "३९", "content_sanskrit": "क्षत्रियैः सह धर्मात्मा पुराणैर्ब्रह्मचारिभिः ।\nउच्चैश्श्रवसमागम्य कन्यां वव्रे यशस्विनीम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2112201, "chapter_id": 3420, "verse_number": "४०", "content_sanskrit": "तं दाशः प्रतिजग्राह विधिवत् प्रतिपूज्य च ।\nअव्रवीच्चैनमागम्य राजसंसदि भारत\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2112202, "chapter_id": 3420, "verse_number": "४१", "content_sanskrit": "राज्यशुल्का प्रदातव्या कन्येयं याचतां वर ।\nअपत्यं यद् भवेत् तस्याः स राजाऽस्तु पितुः परम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2112203, "chapter_id": 3420, "verse_number": "४२", "content_sanskrit": "त्वमेवात्र महाबाहो शन्तनोर्वंशवर्धनः ।\nपुत्रः पुण्यवतां श्रेष्ठः किं नु वक्ष्यामि ते वचः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2112204, "chapter_id": 3420, "verse_number": "४३", "content_sanskrit": "कुमारिकायाः शुल्कार्थं किञ्चिद् वक्ष्यामि भारत ।\nको हि सम्बन्घकं श्लाघ्यमीप्सितं मान्यमीदृशम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2112205, "chapter_id": 3420, "verse_number": "४४", "content_sanskrit": "अतिक्रान्तं न तप्येत साक्षादपि शतक्रतुः ।\nअपत्यं हीदमार्यस्य यो युष्माकं समो गुणैः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2112206, "chapter_id": 3420, "verse_number": "४५", "content_sanskrit": "यस्य शुक्लात् सत्यवती प्रादुर्भूता यशस्विनी ।\nमया तव पिता पूर्वं बहुशः परिकीर्तितः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2112207, "chapter_id": 3420, "verse_number": "४६", "content_sanskrit": "अर्हतीयं सत्यवती पितरं ते ध्रुवं तथा ।\nअसितश्चापि राजर्षिः प्रत्यारव्यातः पुरा मया\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2112208, "chapter_id": 3420, "verse_number": "४७", "content_sanskrit": "स चाप्यासीत् सत्यवत्या भृशमर्थी महायशाः ।\nकन्यापितृत्वाद् वक्ष्यामि किञ्चित् तु भरतर्षभ \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2112209, "chapter_id": 3420, "verse_number": "४८", "content_sanskrit": "बलवत्सपत्नतामत्र दोषं पश्यामि केवलम् ।\nभूयांसं त्वयि पश्यामि तद्दोषमपराजित \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2112210, "chapter_id": 3420, "verse_number": "४९", "content_sanskrit": "यस्य हि त्वं सपत्नः स्या गन्धर्वस्यासुरस्य वा ।\nन स जातु सुखं विन्देत् त्वयि क्रुद्धे परन्तप \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2112211, "chapter_id": 3420, "verse_number": "५०", "content_sanskrit": "एतावानत्र दोषोऽस्ति नान्यः कश्चन विद्यते ।\nएतज्जानीहि भद्रं ते दानादाने त्वयि स्थिते\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2112212, "chapter_id": 3420, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2112213, "chapter_id": 3420, "verse_number": "५१", "content_sanskrit": "त एवमुक्तोऽथ गाङ्गेयस्तद्युक्तं प्रत्यभाषत ।\nशृण्वतां भूमिपालानां पितुरर्थाय धर्मवित्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2112214, "chapter_id": 3420, "verse_number": "", "content_sanskrit": "देवव्रतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2112215, "chapter_id": 3420, "verse_number": "५२", "content_sanskrit": "इदं वचनमादत्स्व नास्ति वक्ताऽस्य मत्समः ।\nअन्यो जातो न जनिता न च कश्चन सम्प्रति \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2112216, "chapter_id": 3420, "verse_number": "५३", "content_sanskrit": "एवमेतत् करिष्यामि यथा त्वमिह भाषसे ।\nयोऽस्यां जनिष्यते पुत्रः स नो राजा भविष्यति \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2112217, "chapter_id": 3420, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2112218, "chapter_id": 3420, "verse_number": "", "content_sanskrit": "इत्युक्तः पुनरेवाथ तं दाशः प्रत्यभाषत ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2112219, "chapter_id": 3420, "verse_number": "", "content_sanskrit": "दाशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2112220, "chapter_id": 3420, "verse_number": "५४", "content_sanskrit": "चिकीर्पुर्दुष्करं कर्म राज्यार्थे भरतर्षभ\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2112221, "chapter_id": 3420, "verse_number": "५५", "content_sanskrit": "त्वयैवात्र महाबाहो शन्तनुर्नाम नाथवान् ।\nईश्वरः कारणं च त्वं प्रभुर्दानाय चानघ \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2112222, "chapter_id": 3420, "verse_number": "५६", "content_sanskrit": "इदं तु वचनं मह्यं कार्यं वै शृणु भारत ।\nकुमारिकायाः शुल्केन वक्ष्याम्यहमरिन्दम \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2112223, "chapter_id": 3420, "verse_number": "५७", "content_sanskrit": "यत् त्वया सत्यमर्थं हि सत्यशील महाबल ।\nराज्ञां मध्ये प्रतिज्ञातमनुरूपं तवैव तत्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2112224, "chapter_id": 3420, "verse_number": "५८", "content_sanskrit": "तत् तथैव महाबाहो संशयो नात्र विद्यते ।\nनास्ति तस्यान्यथाभावस्त्वत्तो रिपुनिबर्हण \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2112225, "chapter_id": 3420, "verse_number": "५९", "content_sanskrit": "विद्यते पुरुषव्याघ्र त्वयि सत्यं महाव्रत ।\nअपत्यं यद् भवेत् तुभ्यं तत्र नः संशयो महान्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2112226, "chapter_id": 3420, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2112227, "chapter_id": 3420, "verse_number": "६०", "content_sanskrit": "तस्य तन्मतमाज्ञाय सर्वशस्त्रभृतां वरः ।\nप्रतिज्ञां प्रत्यजानात् स पितुः प्रियचिकीर्षया \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2112228, "chapter_id": 3420, "verse_number": "६१", "content_sanskrit": "उच्चैश्श्रवः समादत्स्व प्रतिज्ञां जनसंसदि ।\nऋषयो वाऽथ वा देवा भूतान्यन्तर्हितानि च \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2112229, "chapter_id": 3420, "verse_number": "६२", "content_sanskrit": "यानि यानीह शृण्वन्तु नास्य वक्ताऽस्ति मत्समः ।\nइदं वचनमादत्स्व सत्येन मम जल्पतः \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2112230, "chapter_id": 3420, "verse_number": "६३", "content_sanskrit": "शृण्वतां भूमिपालानां यद् ब्रवीमि पितुः कृते ।\nराज्यं तावत् पूर्वमेव मया त्यक्तं महाबल \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2112231, "chapter_id": 3420, "verse_number": "६४", "content_sanskrit": "अपत्यहेतोरपि च करोम्येष विनिश्चयम् ।\nअद्यप्रभृति मे दाश ब्रह्मचर्यं भविष्यति \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2112232, "chapter_id": 3420, "verse_number": "६५", "content_sanskrit": "अपुत्रस्यापि मे लोका भवितारो यथेप्सिताः ।\nन हि जन्मप्रभृत्युक्तं मम किञ्चिदिहानृतम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2112233, "chapter_id": 3420, "verse_number": "६६", "content_sanskrit": "यावत् प्राणा ध्रियन्ते वै मम देहं समाश्रिताः ।\nतावन्न जनयिष्यामि पित्रे कन्यां प्रयच्छ मे \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2112234, "chapter_id": 3420, "verse_number": "६७", "content_sanskrit": "परित्यजाम्यहं राज्यं मैथुनं चापि सर्वशः ।\nऊर्ध्वरेता भविष्यामि दाश सत्यं ब्रवीमि ते \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2112235, "chapter_id": 3420, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2112236, "chapter_id": 3420, "verse_number": "६८", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सम्प्रहृष्टतनूरुहः ।\nददानीत्येव तं दाशः कुमारं प्रत्यभाषत \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2112237, "chapter_id": 3420, "verse_number": "६९", "content_sanskrit": "ततोऽन्तरिक्षेऽप्सरसो देवाः सर्षिगणास्तदा ।\nतद् दृष्ट्वा दुष्करं कर्म प्रशसंसुश्च पार्थिवाः \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2112238, "chapter_id": 3420, "verse_number": "७०", "content_sanskrit": "प्रत्यवर्षन्त कुसुमैर्भीष्मोऽयमिति चाब्रुवन् ।\nततोऽस्य पितुरर्थाय तामुवाच यशस्विनीम्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2112239, "chapter_id": 3420, "verse_number": "७१", "content_sanskrit": "अधिरोह रथं मातर्गच्छामः स्वगृहं प्रति ।\nएवमुक्त्वा तु भीष्मस्तां रथमारोप्य भामिनीम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2112240, "chapter_id": 3420, "verse_number": "७२", "content_sanskrit": "आगम्य हस्तिनपुरं शन्तनोस्तन्न्यवेदयत् ।\nतस्य तद् दुष्करं कर्म प्रशशंसुर्नराधिपाः \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2112241, "chapter_id": 3420, "verse_number": "७३", "content_sanskrit": "समेताश्च पृथक् चैनं भीष्मोऽयमिति चाऽब्रुवन् ।\nतच्छ्रुत्वा दुष्करं कर्म कृतं भीष्मेण शन्तनुः \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2112242, "chapter_id": 3420, "verse_number": "७४", "content_sanskrit": "बभूव दुःखितो राजा चिररात्राय भारत ।\nस तेन कर्मणा सूनोः प्रीतस्तस्मै वरं ददौ \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2112243, "chapter_id": 3420, "verse_number": "७५", "content_sanskrit": "नाकाममरणं तात भविष्यति तवेति ह ।\nन ते प्रभविता मृत्युः यावदिच्छसि जीवितुम् ।\nस्वेन कामेन मर्त्योऽसि नाकामस्त्वं कथञ्चन \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2112244, "chapter_id": 3420, "verse_number": "४७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकोनशततमोऽध्यायः॥९९॥ ॥ इति सम्भवपर्वणि सप्तचत्वारिंशोऽध्यायः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2112245, "chapter_id": 3420, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]