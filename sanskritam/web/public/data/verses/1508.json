[{"id": 2023709, "chapter_id": 1508, "verse_number": "३-१४६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023710, "chapter_id": 1508, "verse_number": "३-१४६-१", "content_sanskrit": "ततः प्रयातमात्रेषु पाण्डवेषु महात्मसु।\nपद्भ्यामनुचिता गन्तुं द्रौपदी समुपाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023711, "chapter_id": 1508, "verse_number": "३-१४६-२", "content_sanskrit": "श्रान्ता दुःखपरीता च वातवर्षेण तेन च।\nसौकुमार्याच्च पाञ्चाली संमुमोह तपस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023712, "chapter_id": 1508, "verse_number": "३-१४६-३", "content_sanskrit": "सा कम्पमाना मोहेन बाहुभ्यामसितेक्षणा।\nरवृत्ताभ्यामनुरूपाभ्यामूरू समवलम्बत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023713, "chapter_id": 1508, "verse_number": "३-१४६-४", "content_sanskrit": "आलम्बमाना सहितावूरू गजकरोपमौ।\nरपपात सहसा भूमौ वेपन्ती कदली यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023714, "chapter_id": 1508, "verse_number": "३-१४६-५", "content_sanskrit": "तां पतन्तीं वरारोहां भज्यमानां लतामिव।\nनकुलः समभिद्रुत्य परिजग्राह वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023715, "chapter_id": 1508, "verse_number": "३-१४६-६x", "content_sanskrit": "नकुल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023716, "chapter_id": 1508, "verse_number": "३-१४६-६", "content_sanskrit": "राजन्पाञ्चालराजस्य सुतेयमसितक्षणा।\nश्रान्ता निपतिता भूमौ तामवेक्षस्व भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023717, "chapter_id": 1508, "verse_number": "३-१४६-७", "content_sanskrit": "अदुःखार्हा परं दुःखं प्राप्तेयं मृदुगामिनी।\nआश्वासय महाराज तामिमां श्रमकर्शिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023718, "chapter_id": 1508, "verse_number": "३-१४६-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023719, "chapter_id": 1508, "verse_number": "३-१४६-८", "content_sanskrit": "राजा तु वचनात्तस्य भृशं दुःखसमन्वितः।\nभीमश्च सहदेवश्च सहसा समुपाद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023720, "chapter_id": 1508, "verse_number": "३-१४६-९", "content_sanskrit": "तामवेक्ष्यतु कौन्तेयो विवर्णवदनां कृशाम्।\nअङ्कमानीय धर्मात्मा पर्यदेवयदातुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023721, "chapter_id": 1508, "verse_number": "३-१४६-१०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023722, "chapter_id": 1508, "verse_number": "३-१४६-१०", "content_sanskrit": "कथं वेश्मसु गुप्तेषु स्वास्तीर्णशयनोचिता।\nभूमौ निषतिता शेते सुखार्हा वरवर्णिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023723, "chapter_id": 1508, "verse_number": "३-१४६-११", "content_sanskrit": "सुकुमारौ कथं पादौ मुखं च कमलप्रभम्।\nमत्कृतेऽद्य वरार्हायाः श्यामतां समुपागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023724, "chapter_id": 1508, "verse_number": "३-१४६-१२", "content_sanskrit": "किमिदं द्यूतकामेन मया कृतमबुद्धिना।\nआदाय कृष्णां चरता वने मृगगणाकुले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023725, "chapter_id": 1508, "verse_number": "३-१४६-१३", "content_sanskrit": "सुखं प्राप्स्यसि कल्याणि पाण्डवान्प्राप्य वै पतीन्।\nइतिद्रुवदराजेन पित्रा दत्ताऽयतेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023726, "chapter_id": 1508, "verse_number": "३-१४६-१४", "content_sanskrit": "तत्सर्वमानवाप्येयं श्रमशोकाद्विकर्शिता।\nशेते निपतिता भूमौ पापस्य मम कर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023727, "chapter_id": 1508, "verse_number": "३-१४६-१५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023728, "chapter_id": 1508, "verse_number": "३-१४६-१५", "content_sanskrit": "तथा लालप्यमाने तु धर्मराजे युधिष्ठिरे।\nधौम्यप्रभृतयः सर्वे तत्राजग्मुर्द्विजोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023729, "chapter_id": 1508, "verse_number": "३-१४६-१६", "content_sanskrit": "ते समाश्वासयामासुराशीर्भिश्चाप्यपूजयन्।\nराक्षोघ्नांश्च तथा मन्त्राञ्जेपुश्चक्रुश्च ते क्रियाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023730, "chapter_id": 1508, "verse_number": "३-१४६-१७", "content_sanskrit": "पठ्यमानेषु मन्त्रेषु शान्त्यर्थं परमर्षिभिः।\nस्पृश्यमाना करैः शीतैः पाण्डवैश्च मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023731, "chapter_id": 1508, "verse_number": "३-१४६-१८", "content_sanskrit": "सेव्यमाना च शीतेन जलमिश्रेण वायुना।\nपाञ्चाली सुखमासाद्य लेभे चेतः शनैः शनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023732, "chapter_id": 1508, "verse_number": "३-१४६-१९", "content_sanskrit": "परिगृह्यच तां दीनां कृष्णामजिनसंस्तरे।\nपार्था विश्रामयामासुर्लब्धसंज्ञां तपस्विनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023733, "chapter_id": 1508, "verse_number": "३-१४६-२०", "content_sanskrit": "तस्या यमौ रक्ततलौ पादौ पूजितलक्षणौ।\nकराभ्यां किणजाताभ्यां शनकैः संववाहतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023734, "chapter_id": 1508, "verse_number": "३-१४६-२१", "content_sanskrit": "पर्याश्वासयदप्येनां धर्मराजो युधिष्ठिरः।\nउवाच च कुरुश्रेष्ठो भीमसेनमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2023735, "chapter_id": 1508, "verse_number": "३-१४६-२२", "content_sanskrit": "बहवः पर्वता मीम विषमा हिमदुर्गमाः।\nतेषु कृष्णा महाबाहो कथं नु विचरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2023736, "chapter_id": 1508, "verse_number": "३-१४६-२३x", "content_sanskrit": "भीमसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2023737, "chapter_id": 1508, "verse_number": "३-१४६-२३", "content_sanskrit": "त्वां राजन्राजपुत्रीं च यमौ च पुरुषर्षभ।\nस्वयं नेष्यामि राजेनद्र मा विषादे मनुः कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2023738, "chapter_id": 1508, "verse_number": "३-१४६-२४", "content_sanskrit": "अथवा यो मया जातो विहगो मद्बलोपमः।\nवहेदनघ सर्वान्नो वचनात्ते घटोत्कचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2023739, "chapter_id": 1508, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि षट्चत्वारिंशदधिकशततमोऽध्यायः ॥ १४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]