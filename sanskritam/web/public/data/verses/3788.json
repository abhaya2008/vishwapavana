[{"id": 2129517, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129518, "chapter_id": 3788, "verse_number": "१", "content_sanskrit": "अत्रोग्रसेनसमितेषु राजन्\nसमागतेष्वप्रतिमेषु राजसु ।\nन वै तितिक्षाम्यहमद्य वादिनां\nमहाजने हंसनिनादिनामिव\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129519, "chapter_id": 3788, "verse_number": "२", "content_sanskrit": "न मोक्ष्यसे वै वदमानो निमज्जन्\nजलं प्रपन्नः सरितामिवाध्वगः ।\nहुताशनस्येव समिद्धतेजसः\nस्थिरो भवस्वेह ममाद्य वन्दिन् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129520, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "वन्दी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129521, "chapter_id": 3788, "verse_number": "३", "content_sanskrit": "व्याघ्रं शयानं प्रतिबोधयित्वा\nआशीविषं सृक्विणी लेलिहानम् ।\nपदा हतस्येव शिरोऽभिहत्य\nनादष्टो वै मोक्ष्यसे तन्निबोध\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129522, "chapter_id": 3788, "verse_number": "४", "content_sanskrit": "यो वै दर्पात् संहननोपपन्नः\nसुदुर्बलः पर्वतमाविहन्ति ।\nतस्यैव पाणिः सनखो विदीर्यते\nन वापि शैलस्य तु दृश्यते व्रणः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129523, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129524, "chapter_id": 3788, "verse_number": "५", "content_sanskrit": "सर्वे राज्ञो मैथिलस्य मैनाकस्येव पर्वताः ।\nनिकृष्टभूता राजानो वत्सा अनडुहो यथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129525, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "यथा महेन्द्रः प्रवरः सुराणां नदीषु गङ्गा प्रवरा यथैव ।\nतथा नृपाणां प्रवरस्त्वमेको बन्दिं समभ्यानय मत्सकाशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129526, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129527, "chapter_id": 3788, "verse_number": "६", "content_sanskrit": "एवमष्टावक्रः समितौ हि गर्जन्\nजातक्रोधो बन्दिनमाह राजन् ।\nउक्ते वाक्ये चोत्तरं मे ब्रवीहि\nवाक्यस्य चाप्युत्तरं ते ब्रवीमि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129528, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "वन्दी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129529, "chapter_id": 3788, "verse_number": "७", "content_sanskrit": "एक एवाग्निर्बहुधा समिध्यते\nएकः सूर्यः सर्वमिदं प्रभासते ।\nएको वीरो देवराजो नियन्ता\nयमः पितॄणामीश्वरश्चैक एव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129530, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129531, "chapter_id": 3788, "verse_number": "८", "content_sanskrit": "द्वाविन्द्राग्नी चरतो वै सखायौ\nद्वौ देवर्षी नारदः पर्वतश्च ।\nद्वावश्विनौ द्वे च रथस्य चक्रे\nभार्यापती द्वौ विहितौ विधात्रा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129532, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "वन्दी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129533, "chapter_id": 3788, "verse_number": "९", "content_sanskrit": "त्रिः सूयते कर्मणा वै प्रजेयं त्रयो युक्ता वाजपेयं वहन्ति ।\nअध्वर्यवस्त्रिसवनानि तन्वते \tत्रयो लोकास्त्रीणि ज्योतींषि चाहुः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129534, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129535, "chapter_id": 3788, "verse_number": "१०", "content_sanskrit": "चतुष्टयं ब्राह्मणानां निकेतं\nचत्वारो वेदाः यज्ञमिमं वहन्ति ।\nदिशश्चतस्त्रश्चतुरश्च वेदाः\nचतुष्पदा गौरपि शश्वदुक्ता \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129536, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "वन्दी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129537, "chapter_id": 3788, "verse_number": "११", "content_sanskrit": "पञ्चाग्नयः पञ्चपदा च पङ्क्तिः\nयज्ञाः पञ्चैवाप्यथ पञ्चेन्द्रियाणि ।\nदृष्टा ह्येते पञ्चचूडाश्च पञ्च\nलोके ख्यातं पञ्चनदं च पुण्यम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129538, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129539, "chapter_id": 3788, "verse_number": "१२", "content_sanskrit": "षडाधाने दक्षिणामाहुरेके\nषडेते ऋतवः कालचक्रं तथैव ।\nषडिन्द्रियाण्युत षट् कृत्तिकाश्च\nषडेव यज्ञाः सर्ववेदेषु सिद्धाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129540, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "वन्दी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2129541, "chapter_id": 3788, "verse_number": "१३", "content_sanskrit": "सप्त ग्राम्याः पशवः सप्त वन्याः\nसप्त छन्दांसि क्रतुमेकं वहन्ति ।\nसप्तर्षयः सप्त चाप्यर्हणानि\nसप्ततन्त्री प्रथिता चैव वीणा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2129542, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2129543, "chapter_id": 3788, "verse_number": "१४", "content_sanskrit": "अष्टौ दिगीशानन्यतमान् वदन्ति तथाऽष्टपादः शरभाः सिंहघाती।\nअष्टौ वसून् शुश्रुमो देवतासु यूपोऽष्टाश्रः विहितश्च यज्ञे \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2129544, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "वन्दी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2129545, "chapter_id": 3788, "verse_number": "१५", "content_sanskrit": "नवैवोक्ताः सामिधेन्यः पितॄणां\nतथा प्राहुर्नवयोगं विसर्गम् ।\nनवाक्षरा बृहती सम्प्रदिष्टा\nनवैव योगो गणनामेति शश्वत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2129546, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2129547, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "दशा दशोक्ताः पुरुषस्य लोके सहस्रमाहुर्दश पूर्णं शतानि ।\nदशैव मासान् बिभ्रति गर्भवत्यो दशैरका दश दाशा दशार्णाः १६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2129548, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "वन्दी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2129549, "chapter_id": 3788, "verse_number": "१७", "content_sanskrit": "एकादशैकादशिनः पशूनाम्\nएकादशैवात्र भवन्ति यूपाः ।\nएकादश प्राणभृतां विकारा\nएकादशोक्ता दिवि देवेषु रुद्राः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2129550, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "अष्टावक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2129551, "chapter_id": 3788, "verse_number": "१८", "content_sanskrit": "संवत्सरं द्वादशमासमाहुः\nजगत्याः पादो द्वादशैवाक्षराणि ।\nद्वादशाहः प्राकृतो यज्ञ उक्तो\nद्वादशादित्यान् कथयन्तीह विप्राः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2129552, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "बन्दी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2129553, "chapter_id": 3788, "verse_number": "१९", "content_sanskrit": "त्रयोदशी तिथिरुक्ता प्रशस्ता\nत्रयोदशद्वीपवती मही च \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2129554, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2129555, "chapter_id": 3788, "verse_number": "२०", "content_sanskrit": "एतावदुक्त्वा विरराम बन्दी\nश्लोकस्यार्धं व्याजहाराष्टवक्रः ।\nत्रयोदशाहानि ससार केशी\nत्रयोदशादीन्यतिच्छन्दांसि चाहुः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2129556, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2129557, "chapter_id": 3788, "verse_number": "२१", "content_sanskrit": "ततो महानुदतिष्ठन्निनाद-\nस्तूष्णीम्भूतं सूतपुत्रं निशाम्य ।\nअधोमुखं ध्यानपरं तदानी-\nमष्टावक्रं चाप्युदीर्यन्तमेव \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2129558, "chapter_id": 3788, "verse_number": "२२", "content_sanskrit": "तस्मिंस्तथा सङ्कुले वर्तमाने\nस्फीते यज्ञे जनकस्योत राज्ञः ।\nअष्टावक्रं पूजयन्तोऽभ्युपेयु-\nर्विप्राः सर्वे प्राञ्जलयः प्रतीताः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2129559, "chapter_id": 3788, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि त्रिंशदुत्तरशततमोऽध्यायः ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2129560, "chapter_id": 3788, "verse_number": "", "content_sanskrit": "॥ तीर्थयात्रापर्वणि षडशीतितमोऽध्यायः ॥८६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]