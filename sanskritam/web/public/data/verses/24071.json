[{"id": 7004071000, "chapter_id": 24071, "verse_number": "४-२०-१", "content_sanskrit": "गणावूचतुः ।\nऔत्तानपादिर्निर्गत्य ततः काननतो द्विज ।\nरम्यं मधुवनं प्राप यमुनायास्तटे महत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004071001, "chapter_id": 24071, "verse_number": "४-२०-२", "content_sanskrit": "आद्यं भगवतः स्थानं तत्पुण्यं हरिमेधसः ।\nपापोपि जंतुस्तत्प्राप्य निष्पापो जायते ध्रुवम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004071002, "chapter_id": 24071, "verse_number": "४-२०-३", "content_sanskrit": "जपन्स वासुदेवाख्यं परंब्रह्म निरामयम् ।\nअपश्यत्तन्मयं विश्वं ध्यानस्तिमितलोचनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004071003, "chapter_id": 24071, "verse_number": "४-२०-४", "content_sanskrit": "हरिर्हरित्सु सर्वासु हरिर्हरिमरीचिषु ।\nशिवामृगमृगेंद्रादि रूपः काननगो हरिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004071004, "chapter_id": 24071, "verse_number": "४-२०-५", "content_sanskrit": "जले शालूरकूर्मादि रूपेण भगवान्हरिः ।\nहरिरश्वादिरूपेण मंदुरास्वपि भूभुजाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004071005, "chapter_id": 24071, "verse_number": "४-२०-६", "content_sanskrit": "अनंतरूपः पाताले गगनेऽनंतसंज्ञकः ।\nएकोप्यनंततां यातो रूपभेदैरनंतकैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004071006, "chapter_id": 24071, "verse_number": "४-२०-७", "content_sanskrit": "देवेषु यो वसेन्नित्यं देवानां वसतिर्हि यः ।\nस वासुदेवः सर्वत्र दीव्येद्यद्वासनावशात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004071007, "chapter_id": 24071, "verse_number": "४-२०-८", "content_sanskrit": "विष्लृव्याप्तावयंधातुर्यत्रसार्थकतां गतः ।\nते विष्णुनाम स्वरूपे हि सर्वव्यापनशीलिनि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004071008, "chapter_id": 24071, "verse_number": "४-२०-९", "content_sanskrit": "सर्वेषां च हृषीकाणामीशनात्परमेश्वरः ।\nहृषीकेश इति ख्यातो यः स सर्वत्रसंस्थितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004071009, "chapter_id": 24071, "verse_number": "४-२०-१०", "content_sanskrit": "न च्यवंतेपि यद्भक्ता महति प्रलये सति ।\nअतोऽच्युतोऽखिले लोके स एकः सर्वगोऽव्ययः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004071010, "chapter_id": 24071, "verse_number": "४-२०-११", "content_sanskrit": "इदं चराचरं विश्वं यो बभार स्वलीलया ।\nभृत्यास्वरूपसंपत्त्या सोऽत्र विश्वंभरोऽखिलम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004071011, "chapter_id": 24071, "verse_number": "४-२०-१२", "content_sanskrit": "तस्येक्षणे समीक्षेते नान्यद्विप्णुपदादृते ।\nनिरीक्ष्यः पुंडरीकाक्षो नान्यो नियमतो ह्यतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004071012, "chapter_id": 24071, "verse_number": "४-२०-१३", "content_sanskrit": "नान्य शब्दग्रहौ तस्य जातौ शब्दग्रहावपि ।\nविना मुकुंद गोविंद दामोदर चतुर्भुज ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004071013, "chapter_id": 24071, "verse_number": "४-२०-१४", "content_sanskrit": "गोविंदचरणार्थार्चां तत्प्रियंकर्मवै विना ।\nशंखचक्रांकितौ तस्य नान्यकर्मकरौकरौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004071014, "chapter_id": 24071, "verse_number": "४-२०-१५", "content_sanskrit": "निर्द्वंद्वचरणद्वंद्वं तन्मनो मनुते हरेः ।\nहित्वान्यन्मननं सर्वं निश्चलत्वमवाप ह ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004071015, "chapter_id": 24071, "verse_number": "४-२०-१६", "content_sanskrit": "चरणौ विष्णुशरणौ हित्वा नारायणांगणम् ।\nतस्य नो चरतोन्यत्र चरतो विपुलं तपः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004071016, "chapter_id": 24071, "verse_number": "४-२०-१७", "content_sanskrit": "वाणीप्रमाणी क्रियते गोविंदगुणवर्णने ।\nजोषं समासता तेन महासारं तपस्यता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004071017, "chapter_id": 24071, "verse_number": "४-२०-१८", "content_sanskrit": "नितांतकमलाकांत नामधेयसुधारसम् ।\nरसयंती न रसना तस्यान्यरसस्पृहा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004071018, "chapter_id": 24071, "verse_number": "४-२०-१९", "content_sanskrit": "श्रीमुकुंद पदद्वंद्व पद्मामोदप्रमोदितम् ।\nगंधांतरं न तद्घ्राणं परिजिघ्रत्यशीघ्रगम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004071019, "chapter_id": 24071, "verse_number": "४-२०-२०", "content_sanskrit": "त्वगिंद्रियं मधुरिपोः परिस्पृश्य पदद्वयम् ।\nसर्वस्पर्शसुखं प्राप तस्य भूजानिजन्मनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004071020, "chapter_id": 24071, "verse_number": "४-२०-२१", "content_sanskrit": "शब्दादिविषयाधारं सारं दामोदरं परम् ।\nध्रुवेंद्रियाणि संप्राप्य कृतार्थान्यभवंस्तदा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004071021, "chapter_id": 24071, "verse_number": "४-२०-२२", "content_sanskrit": "लुप्तानि सर्वतेजांसि तत्तपस्तपनोदये ।\nचंद्रसूर्यानलर्क्षाणां प्रदीपित जगत्त्रये ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004071022, "chapter_id": 24071, "verse_number": "४-२०-२३", "content_sanskrit": "इंद्र चंद्राग्नि वरुण समीरण धनाधिपाः ।\nयम नैरृतमुख्याश्च जाताः स्वपदशंकिताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004071023, "chapter_id": 24071, "verse_number": "४-२०-२४", "content_sanskrit": "वैमानिकास्तथाऽन्येपि वसुमुख्या दिवौकसः ।\nततो धुवात्समुत्त्रेसुः स्वाधिकारैधिताधयः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004071024, "chapter_id": 24071, "verse_number": "४-२०-२५", "content_sanskrit": "यत्र यत्र ध्रुवः पादं मिनोति पृथिवीतले ।\nधरा तस्य भराक्रांता विनमेत्तत्र तत्र वै ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004071025, "chapter_id": 24071, "verse_number": "४-२०-२६", "content_sanskrit": "अहो तदंगसंगीनि त्यक्त्वा जाड्यं जलान्यपि ।\nरसवंति पदस्थानि स्फुरंत्यन्यत्र तद्भयात् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004071026, "chapter_id": 24071, "verse_number": "४-२०-२७", "content_sanskrit": "यावंति विष्वक्तेजांसि सिद्धरूपगुणानि च ।\nनेत्रातिथीनि तावंति तत्तपस्तेजसाऽभवन् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004071027, "chapter_id": 24071, "verse_number": "४-२०-२८", "content_sanskrit": "अहो निजगुणस्पर्शः सततं मातरिश्वना ।\nदूरदेशांतरस्थोपि तत्त्वचो विषयीकृतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004071028, "chapter_id": 24071, "verse_number": "४-२०-२९", "content_sanskrit": "व्योम्नापि शब्दगुणिना ध्रुवाराधनबुद्धिना ।\nशब्दजातस्त्वशेषोपि तत्कर्ण शरणीकृतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004071029, "chapter_id": 24071, "verse_number": "४-२०-३०", "content_sanskrit": "आराधितोऽनुदिवसं सभूतैरपि पंचभिः ।\nतप एव परं मेने गोविंदार्पित मानसः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004071030, "chapter_id": 24071, "verse_number": "४-२०-३१", "content_sanskrit": "कौस्तुभोद्भासितहृदः पीतकौशेयवाससः ।\nध्यानात्तेजोमयं विश्वं तेनैक्षि नृपसूनुना ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004071031, "chapter_id": 24071, "verse_number": "४-२०-३२", "content_sanskrit": "मरुत्वतातिमहती चिंताऽप्ता तत्तपोभयात् ।\nमत्पदं चेदकांक्षिष्यदहरिष्यद्ध्रुवं धुवः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004071032, "chapter_id": 24071, "verse_number": "४-२०-३३", "content_sanskrit": "समर्थस्त्वप्सरोवर्गो नियंतुं यमिनां यमान् ।\nस तु यूनि प्रभवति नात्र बाले करोमि किम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004071033, "chapter_id": 24071, "verse_number": "४-२०-३४", "content_sanskrit": "तपस्विनां तपो हंतुं द्वौ मत्साहाय्यकारिणौ ।\nकामक्रौधौ न तावस्मिन्प्रभवेतां शिशौ ध्रुवे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004071034, "chapter_id": 24071, "verse_number": "४-२०-३५", "content_sanskrit": "एक एव किलोपायो बाले मे प्रभविष्यति ।\nभूतालिं भीषणाकारां प्रहिणोमीह तद्भिये ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004071035, "chapter_id": 24071, "verse_number": "४-२०-३६", "content_sanskrit": "बालत्वाद्भीषितो भूतैस्तपस्त्यक्ष्यत्यसौ ध्रुवम् ।\nइति निश्चित्य भूतालिं प्रेषयामास वासवः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004071036, "chapter_id": 24071, "verse_number": "४-२०-३७", "content_sanskrit": "भल्लूकाकारसर्वांग उष्ट्रलंबशिरोधरः ।\nकश्चिद्दुर्दर्शदशनस्त्वभ्यधावत्तमर्भकम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004071037, "chapter_id": 24071, "verse_number": "४-२०-३८", "content_sanskrit": "तं व्याघ्रवदनः कश्चिद्व्यादाय विकटाननम् ।\nद्विपोच्च देहसंस्थानो मुहुर्गर्जन्समभ्यगात् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004071038, "chapter_id": 24071, "verse_number": "४-२०-३९", "content_sanskrit": "रयात्तु मांसकं भुंजन्कश्चिद्विकटदंष्ट्रकः ।\nरोषात्तमभिदुद्राव दृष्ट्वा संतर्जयन्निव ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004071039, "chapter_id": 24071, "verse_number": "४-२०-४०", "content_sanskrit": "अतितीक्ष्णैर्विषाणाग्रैस्तटानुच्चान्विदारयन् ।\nखुराग्रैर्दलयन्भूमिं महोक्षोऽभिजगर्जतम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004071040, "chapter_id": 24071, "verse_number": "४-२०-४१", "content_sanskrit": "कश्चिद्धि पन्नगी भूय फटाटोपभयानकः ।\nअतिलोलद्विरसनः पुस्फूर्जनिकषाचितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004071041, "chapter_id": 24071, "verse_number": "४-२०-४२", "content_sanskrit": "कश्चिच्च महिषाकारः क्षिपञ्शृंगाग्रतो गिरोन् ।\nलांगूलताडितधरः श्वसन्वेगात्तमाप्तवान् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004071042, "chapter_id": 24071, "verse_number": "४-२०-४३", "content_sanskrit": "कश्चिद्दावानलालीढ खर्जूरद्रुमसन्निभम् ।\nबिभ्रदूरुद्वयंभूतो व्यात्तास्यस्तमभीषयत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004071043, "chapter_id": 24071, "verse_number": "४-२०-४४", "content_sanskrit": "मौलिजैरभ्रसंघर्षं कुर्वन्दीर्घकृशोदरः ।\nनिमग्नपिंगनयनः कश्चिद्भीषयति स्म तम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004071044, "chapter_id": 24071, "verse_number": "४-२०-४५", "content_sanskrit": "कृपाणपाणिर्भग्नास्यो वामहस्तकपालधृत् ।\nप्रचंडं क्ष्वेडयन्कश्चिदभ्यधावत्तमर्भकम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004071045, "chapter_id": 24071, "verse_number": "४-२०-४६", "content_sanskrit": "विशाल सालमादाय कुर्वन्किल किलारवम् ।\nकश्चित्तमभितो याति कालो दंडधरो यथा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004071046, "chapter_id": 24071, "verse_number": "४-२०-४७", "content_sanskrit": "तमः संकेतसदनं व्याघ्रं वै वदनं महत् ।\nकृतांतकं दराकारं बिभ्रत्कश्चित्तमभ्यगात् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004071047, "chapter_id": 24071, "verse_number": "४-२०-४८", "content_sanskrit": "उलूकाकारतां धृत्वा फूत्कारैरतिदारुणैः ।\nहृदयाकंपनैः कश्चिद्भीषयामास तं ध्रुवम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004071048, "chapter_id": 24071, "verse_number": "४-२०-४९", "content_sanskrit": "यक्षिणी काचिदानीय रुदंतं कस्यचिच्छिशुम् ।\nअपिबद्रुधिरं कोष्ठाच्चखादास्थि मृणालवत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004071049, "chapter_id": 24071, "verse_number": "४-२०-५०", "content_sanskrit": "पिपासिताद्य रुधिरं तेपि पास्याम्यहं धुव ।\nयथास्य बालस्य तथा चर्वित्वास्थीनि वादिनी ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004071050, "chapter_id": 24071, "verse_number": "४-२०-५१", "content_sanskrit": "अनीय तृणदारूणि परिस्तीर्य समंततः ।\nदावाग्निं ज्वालयामास काचिद्वात्याविवर्धितम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004071051, "chapter_id": 24071, "verse_number": "४-२०-५२", "content_sanskrit": "वेताली रूपमास्थाय भंक्त्वा काचित्तरून्गिरीन् ।\nरुरोध गगनाध्वानं कंपयंती च तं भृशम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004071052, "chapter_id": 24071, "verse_number": "४-२०-५३", "content_sanskrit": "अन्या सुनीतिरूपेण तमभिप्रेक्ष्य दूरतः ।\nरुरोदातीवदुःखार्ता वक्षोघातं मुहुर्मुहुः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004071053, "chapter_id": 24071, "verse_number": "४-२०-५४", "content_sanskrit": "उवाच च वचश्चाटु बहुमाया विनिर्मितम् ।\nकारुण्यपूर्ण वात्सल्यमतीवातन्वती सती ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004071054, "chapter_id": 24071, "verse_number": "४-२०-५५", "content_sanskrit": "त्वदेकशरणां वत्स बत मृत्युर्जिघांसति ।\nरक्षरक्ष गतासुं मां शरणागतवत्सल ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004071055, "chapter_id": 24071, "verse_number": "४-२०-५६", "content_sanskrit": "प्रतिग्रामं प्रतिपुरं प्रत्यध्वं प्रतिकाननम् ।\nप्रत्याश्रमं प्रतिगिरिं श्रांता त्वद्वीक्षणातुरा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004071056, "chapter_id": 24071, "verse_number": "४-२०-५७", "content_sanskrit": "यदा प्रभृति रे बाल निरगात्तपसे भवान् ।\nतदेव दिनमारभ्य निर्गताऽहं त्वदीक्षणे ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004071057, "chapter_id": 24071, "verse_number": "४-२०-५८", "content_sanskrit": "तैस्तैः सपत्नीदुर्वाक्यैर्दुनोपि त्वं यथार्भक ।\nतथाऽहमपि दूनास्मि नितरां तद्वचोऽग्निना ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004071058, "chapter_id": 24071, "verse_number": "४-२०-५९", "content_sanskrit": "न निद्रामि न जागर्मि नाश्नामि न पिबाम्यहम् ।\nध्यायामि केवलं त्वाऽहं योगिनीव वियोगिनी ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004071059, "chapter_id": 24071, "verse_number": "४-२०-६०", "content_sanskrit": "निद्रादरिद्रनयना स्वप्नेपि न तवाननम् ।\nआनंदि सर्वथा यन्मे मंदभाग्या विलोकये ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004071060, "chapter_id": 24071, "verse_number": "४-२०-६१", "content_sanskrit": "त्वदाननप्रतिनिधिर्विधुर्विधुरया मया ।\nउदित्वरोपिनालोकि तापं वै त्यक्तुकामया ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004071061, "chapter_id": 24071, "verse_number": "४-२०-६२", "content_sanskrit": "त्वदालापसमालापं कलयन्किलकाकलीम् ।\nकोकिलोपि मयाकर्णि नालकाकीर्णकर्णया ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004071062, "chapter_id": 24071, "verse_number": "४-२०-६३", "content_sanskrit": "त्वदंगसंगमधुरो ध्रुवधूपितयामया ।\nनानिलोपि मयालिंगि क्वचिद्विश्रांतया भृशम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004071063, "chapter_id": 24071, "verse_number": "४-२०-६४", "content_sanskrit": "के देशाः काश्च सरितः के शैलास्त्वत्कृते ध्रुव ।\nमया चरणचारिण्या राजपत्न्या न लंघिताः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004071064, "chapter_id": 24071, "verse_number": "४-२०-६५", "content_sanskrit": "अध्रुवं सर्वमेवैतत्पश्यंत्यंधीकृतास्म्यहम् ।\nधात्रीं त्रायस्व मां पुत्र प्राप्य त्वंमेंऽधयष्टिताम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004071065, "chapter_id": 24071, "verse_number": "४-२०-६६", "content_sanskrit": "मृदुलानि तवांगानि क्वेमानि क्व तपस्त्विदम् ।\nपरुषं पुरुषैः साध्यं परुषांगैर्नरर्षभ ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004071066, "chapter_id": 24071, "verse_number": "४-२०-६७", "content_sanskrit": "अनेन तपसा वत्स त्वयाऽप्यं किमनेनसा ।\nधराधीशतनूजत्वादधिकं तद्वदाधुना ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004071067, "chapter_id": 24071, "verse_number": "४-२०-६८", "content_sanskrit": "अनेन वयसा बाल खेलनीयं त्वयाऽनिशम् ।\nबालक्रीडनकैरन्यैः सवयः शिशुभिः समम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004071068, "chapter_id": 24071, "verse_number": "४-२०-६९", "content_sanskrit": "ततः कौमारमासाद्य वयोऽभिध्यानशीलिना ।\nभवता सर्वविद्यानां भाव्यं वै पारदृश्वना ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004071069, "chapter_id": 24071, "verse_number": "४-२०-७०", "content_sanskrit": "वयोथ चतुरं प्राप्य योषास्रक्चंदनादिकान् ।\nनिर्वेक्ष्यसि बहून्भोगानिंद्रियार्थान्कृतार्थयन् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004071070, "chapter_id": 24071, "verse_number": "४-२०-७१", "content_sanskrit": "उत्पाद्याथ बहून्पुत्रान्गुणिनो धर्मवत्सलान् ।\nपरिसंक्रामितश्रीकस्तेष्वथो त्वं तपश्चर ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004071071, "chapter_id": 24071, "verse_number": "४-२०-७२", "content_sanskrit": "इदानीमेव तपसि बाल्ये वयसि कः श्रमः ।\nपादांगुष्ठकरीषाग्निः कदा मौलिमवाप्स्यति ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004071072, "chapter_id": 24071, "verse_number": "४-२०-७३", "content_sanskrit": "विपक्षपरिभूतेन हृतमानेन केनचित् ।\nपरिभ्रष्टश्रिया वापि तप्तव्यं तेषु को भवान् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004071073, "chapter_id": 24071, "verse_number": "४-२०-७४", "content_sanskrit": "हृतमानेन तप्तव्यं निशम्येति वचो ध्रुवः ।\nदीर्घमुष्णं हि निःश्वस्य पुनर्दध्यौ हरिं हृदि ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004071074, "chapter_id": 24071, "verse_number": "४-२०-७५", "content_sanskrit": "जनयित्रीमनाभाष्य भूतभीतिं विहाय च ।\nध्रुवोऽच्युतध्यानपरः पुनरेव बभूव ह ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004071075, "chapter_id": 24071, "verse_number": "४-२०-७६", "content_sanskrit": "सापि भूतावली भीतिंबहुभीषणभूषणा ।\nदर्शयंती तमभितोऽद्राक्षीच्चक्रं सुदर्शनम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004071076, "chapter_id": 24071, "verse_number": "४-२०-७७", "content_sanskrit": "परितः परिवेषाभं सूर्यस्योच्चैः स्फुरत्प्रभम् ।\nरक्षणाय च रक्षोभ्यस्तस्याधोक्षज निर्मितम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004071077, "chapter_id": 24071, "verse_number": "४-२०-७८", "content_sanskrit": "भूतावली तमालोक्य स्फुरच्चक्रसुदर्शनम् ।\nज्वालामालाकुलं तीव्रं रक्षंतं परितो ध्रुवम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004071078, "chapter_id": 24071, "verse_number": "४-२०-७९", "content_sanskrit": "अतीव निष्कंपहृदं गोविदार्पितचेतसम् ।\nतपोंकुरमिवोद्भिद्य मेदिनीं समुदित्वरम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004071079, "chapter_id": 24071, "verse_number": "४-२०-८०", "content_sanskrit": "सापि प्रत्युतभीतातं ध्रुवं ध्रुवविनिश्चयम् ।\nनमस्कृत्य यथायातं याताव्यर्थमनोरथा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004071080, "chapter_id": 24071, "verse_number": "४-२०-८१", "content_sanskrit": "गर्जत्कादंबिनीजालं व्योम्नि वै व्याकुलं यथा ।\nवृथा भवति संप्राप्य मनागनिललोलताम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004071081, "chapter_id": 24071, "verse_number": "४-२०-८२", "content_sanskrit": "अथ जंभारिणा सार्धं भीताः सर्वे दिवौकसः ।\nसंमंत्र्य त्वरिता जग्मुर्ब्रह्माणं शरणं द्विज ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004071082, "chapter_id": 24071, "verse_number": "४-२०-८३", "content_sanskrit": "नत्वा विज्ञापयामासुः परिष्टुत्या पितामहम् ।\nवच्रोऽवसरमालोक्य पृष्टागमनकारणाः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004071083, "chapter_id": 24071, "verse_number": "४-२०-८४", "content_sanskrit": "देवा ऊचुः ।\nधातरुत्तानपादस्य तनयेन सुवर्चसा ।\nतपता तापिताः सर्वे त्रिलोकी तलवासिनः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004071084, "chapter_id": 24071, "verse_number": "४-२०-८५", "content_sanskrit": "सम्यक्संविद्महे तात धुवस्य न मनीषितम् ।\nपदं परिजिहीर्षुः स कस्यास्मासु महातपाः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004071085, "chapter_id": 24071, "verse_number": "४-२०-८६", "content_sanskrit": "इति विज्ञापितो देवैर्विहस्य चतुराननः ।\nप्रत्युवाचाथ तान्सर्वान्ध्रुवतो भीतमानसान् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004071086, "chapter_id": 24071, "verse_number": "४-२०-८७", "content_sanskrit": "ब्रह्मोवाच ।\nन भेतव्यं सुरास्तस्माद्ध्रुवाद्ध्रुवपदैषिणः ।\nव्रजंतु विज्वराः सर्वे न स वः पदमिच्छति ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004071087, "chapter_id": 24071, "verse_number": "४-२०-८८", "content_sanskrit": "न तस्माद्भगवद्भक्ताद्भेतव्यं केनचित्क्वचित् ।\nनिश्चितं विष्णुभक्ता ये न ते स्युः परतापिनः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004071088, "chapter_id": 24071, "verse_number": "४-२०-८९", "content_sanskrit": "आराध्य विष्णुं देवेशं लब्ध्वा तस्मात्स्वकांक्षितम् ।\nभवतामपि सर्वेषां पदानि स्थिरयिष्यति ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004071089, "chapter_id": 24071, "verse_number": "४-२०-९०", "content_sanskrit": "निशम्येति च गीर्वाणाः प्रणीतं ब्रह्मणो वचः ।\nप्रणिपत्य स्वधिष्ण्यानि प्रहृष्टाः परिवव्रजुः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004071090, "chapter_id": 24071, "verse_number": "४-२०-९१", "content_sanskrit": "अथ नारायणो देवस्तं दृष्ट्वा दृढमानसम् ।\nअनन्यशरणं बालं गत्वा तार्क्ष्यरथोऽब्रवीत् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004071091, "chapter_id": 24071, "verse_number": "४-२०-९२", "content_sanskrit": "श्रीविष्णुरुवाच ।\nप्रसन्नोस्मि महाभाग वरं वरय सुव्रत ।\nतपसोऽस्मान्निवर्तस्व चिरं खिन्नोसि बालक ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004071092, "chapter_id": 24071, "verse_number": "४-२०-९३", "content_sanskrit": "वचोऽमृतं समाकर्ण्य पर्युन्मील्य विलोचने ।\nइंद्रनीलमणिज्योतिः पटलीं पर्यलोकयत् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004071093, "chapter_id": 24071, "verse_number": "४-२०-९४", "content_sanskrit": "प्रत्यग्रविकसन्नीलोत्पलानां निकुरंबकैः ।\nप्रोत्फुल्लितां समंताच्च रोदसी सरसीमिव ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004071094, "chapter_id": 24071, "verse_number": "४-२०-९५", "content_sanskrit": "लक्ष्मीदेवीकटाक्षोघैः कटाक्षितमिवाखिलम् ।\nधुवस्तदानिरैक्षिष्ट द्यावाभूम्योर्यदंतरम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004071095, "chapter_id": 24071, "verse_number": "४-२०-९६", "content_sanskrit": "प्रोद्यत्कादंबिनीमध्य विद्युद्दामसमानरुक् ।\nपुरः पीतांबरः कृष्णस्तेन नेत्रातिथीकृतः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004071096, "chapter_id": 24071, "verse_number": "४-२०-९७", "content_sanskrit": "नभो निकष पाषाणो मेरुकांचन रेखितः ।\nयथातथा ध्रुवेणैक्षि तदा गरुडवाहनः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004071097, "chapter_id": 24071, "verse_number": "४-२०-९८", "content_sanskrit": "सुनीलगगनं यद्वद्भूषितं तु कलावता ।\nपीतेन वाससा युक्तं स ददर्श हरिं तदा ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004071098, "chapter_id": 24071, "verse_number": "४-२०-९९", "content_sanskrit": "दंडवत्प्रणिपत्याथ परितः परिलुठ्य च ।\nरुरोद दृष्ट्वेव चिरं पितरं दुःखितः शिशुः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004071099, "chapter_id": 24071, "verse_number": "४-२०-१००", "content_sanskrit": "नारदेन सनंदेन सनकेन सुसंस्तुतः ।\nअन्यैः सनत्कुमाराद्यैर्योगिभिर्योगिनां वरः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004071100, "chapter_id": 24071, "verse_number": "४-२०-१०१", "content_sanskrit": "कारुण्यवाष्पनीरार्द्र पुंडरीकविलोचनः ।\nध्रुवमुत्थापयांचक्रे चक्री धृत्वा करेण तम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004071101, "chapter_id": 24071, "verse_number": "४-२०-१०२", "content_sanskrit": "हरिस्तु परिपस्पर्श तदंगं धूलिधूसरम् ।\nकराभ्यां सुकठोराभ्यां नित्यं शास्त्रपरिग्रहात् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004071102, "chapter_id": 24071, "verse_number": "४-२०-१०३", "content_sanskrit": "स्पर्शनाद्देवदेवस्य सुसंस्कृतमयी शुभा ।\nवाणी प्रवृत्ता तस्यास्यात्तुष्टावाथ ध्रुवो हरिम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}]