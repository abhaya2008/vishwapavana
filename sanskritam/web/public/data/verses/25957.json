[{"id": 7005957000, "chapter_id": 25957, "verse_number": "१-१४०-१", "content_sanskrit": "हरिरुवाच । जनमेजयः पुरोश्चाभून्नमस्युर्जनमेजयात् ।\nतस्य पुत्रश्चाभयदः सुद्युश्चाभयदादभूत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005957001, "chapter_id": 25957, "verse_number": "१-१४०-२", "content_sanskrit": "सुद्योर्बहुगतिः पुत्रः संजातिस्तस्य चात्मजः ।\nवत्सजातिश्च सञ्जातेः रौद्राश्वश्च तदात्मजः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005957002, "chapter_id": 25957, "verse_number": "१-१४०-३", "content_sanskrit": "ऋतेयुः स्थण्डिलेयुश्च कक्षेयुश्च कृतेयुकः ।\nजलेयुः सन्ततेयुश्च रोद्राश्वस्य सुता वराः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005957003, "chapter_id": 25957, "verse_number": "१-१४०-४", "content_sanskrit": "रतिनार ऋतेयोश्च तस्य प्रतिरथः सुतः ।\nतस्य मेधातिथिः पुत्रस्तत्पुत्रश्चैनिलः स्मृतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005957004, "chapter_id": 25957, "verse_number": "१-१४०-५", "content_sanskrit": "ऐनिलस्य तु दुष्यन्तो भरतस्तस्य चातमजः ।\nशकुन्तलायां संजज्ञे वितथो भरतादभूत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005957005, "chapter_id": 25957, "verse_number": "१-१४०-६", "content_sanskrit": "वितथस्य सुतो मन्युर्मन्योश्चैव नरः स्मृतः। ।\nनरस्य संकृतिः पुत्रो गर्गो वै संकृतेः सुतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005957006, "chapter_id": 25957, "verse_number": "१-१४०-७", "content_sanskrit": "गर्गादमन्युः पुत्रो वै शिनिः पुत्रो व्यजात ।\nमन्युपुत्रान्महावीर्यात्सुतोऽभवदुरुक्षयः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005957007, "chapter_id": 25957, "verse_number": "१-१४०-८", "content_sanskrit": "उरुक्षयात्त्रय्यारुणिर्व्यूहक्षत्राच्च मन्यजात् ।\nसुहोत्रस्तस्य हस्ती च अजमीढद्विमीढकौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005957008, "chapter_id": 25957, "verse_number": "१-१४०-९", "content_sanskrit": "हस्तिनः पुरुमीढश्च कण्वोऽभूदजमीढतः ।\nकण्वान्मेधातिथिर्जज्ञे यतः काण्वायना द्विजाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005957009, "chapter_id": 25957, "verse_number": "१-१४०-१०", "content_sanskrit": "अजमीढाद्वृहदिषुस्तत्पुत्रश्च बृहद्धनुः ।\nबृहत्कर्मा तस्य पुत्रस्तस्य पुत्रो जयद्रथः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005957010, "chapter_id": 25957, "verse_number": "१-१४०-११", "content_sanskrit": "जयद्रथाद्विश्वजिच्च सेनजिच्च तदात्ज ।\nरुचिराश्वः सेनजितः पृथुसेनस्तदात्मजः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005957011, "chapter_id": 25957, "verse_number": "१-१४०-१२", "content_sanskrit": "पारस्तु पृथुसेनस्य पाराद्द्वीपोऽभवन्नृपः ।\nनृपस्य सृमरः पुत्रः सुकृतिश्च पृथोः सुतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005957012, "chapter_id": 25957, "verse_number": "१-१४०-१३", "content_sanskrit": "विभ्राजः सुकृतेः पुत्रो विभ्राजादश्वहोऽभवत् ।\nकृत्यां तस्माद्ब्रह्मदत्तो विष्वक्सेनस्तदात्मजः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005957013, "chapter_id": 25957, "verse_number": "१-१४०-१४", "content_sanskrit": "यवीनरो द्विमीढस्य धृतिमांश्च यवीनरात। ।\nधतिमतः सत्यधृतिर्दृढनेमिस्तदात्मजः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005957014, "chapter_id": 25957, "verse_number": "१-१४०-१५", "content_sanskrit": "दृढनेमेः सुपार्श्वोऽभूत्सुपार्श्वात्सन्नतिस्तथ। ।\nकृस्तु सन्नतेः पुत्रः कृतादुग्रायुधोऽभवत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005957015, "chapter_id": 25957, "verse_number": "१-१४०-१६", "content_sanskrit": "उग्रायुधाच्च क्षेम्यौऽभूत्सुधीरस्तु तदात्मज। ।\nपुरञ्जयः सुधीराच्च तस्य पुत्रो विदूरथः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005957016, "chapter_id": 25957, "verse_number": "१-१४०-१७", "content_sanskrit": "अजमीढान्नलिन्याञ्च नीलो नाम नृपोऽभवत् ।\nनीलाच्छान्तिरभूत्पुत्रः सुशान्तिस्तस्य चात्मजः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005957017, "chapter_id": 25957, "verse_number": "१-१४०-१८", "content_sanskrit": "सुशान्तेश्च पुरुर्जातो ह्यर्कस्तस्य सुतोऽभवत् ।\nअर्कस्य चैव हर्यश्वो हर्यश्वान्मुकुलोऽभवत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005957018, "chapter_id": 25957, "verse_number": "१-१४०-१९", "content_sanskrit": "यवीनरो बृहद्भानुः कम्पिल्लः सृञ्जयस्तथा ।\nपाञ्चालान्मुकुलाज्जज्ञे शरद्वान्वैष्णवो महान् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005957019, "chapter_id": 25957, "verse_number": "१-१४०-२०", "content_sanskrit": "दिवोदासो द्वितीयोऽस्य ह्यहल्यायां शरद्वतः ।\nशतानन्दोऽभवत्पुत्रस्तस्य सत्यधृतिः सतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005957020, "chapter_id": 25957, "verse_number": "१-१४०-२१", "content_sanskrit": "कृपः कृपी सत्यधृतेरुर्वश्यां वीर्यहानितः ।\nद्रोणपत्नी कृपी जज्ञे अश्वत्थामानमुत्तमम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005957021, "chapter_id": 25957, "verse_number": "१-१४०-२२", "content_sanskrit": "दिवोदासान्मित्रयुश्च मित्रयोश्च्यवनोऽभवत् ।\nसुदासश्च्यवनाज्जज्ञे सौदासस्तस्य जात्मजः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005957022, "chapter_id": 25957, "verse_number": "१-१४०-२३", "content_sanskrit": "सहदेवस्तस्य पुत्रः सहदेवात्तु सोमकः ।\nजन्तुस्तु सोमकाज्जज्ञे पृषतश्चापरो महान् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005957023, "chapter_id": 25957, "verse_number": "१-१४०-२४", "content_sanskrit": "पृषताद्द्रुपदो जज्ञे धृष्टद्युम्नस्ततोऽत् ।\nधृष्टद्युम्नाद्धृष्टकेतुरृक्षोऽभूतजमीढतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005957024, "chapter_id": 25957, "verse_number": "१-१४०-२५", "content_sanskrit": "ऋक्षात्संवरणो जज्ञे कुरुः संवरणादभूत् ।\nसुधनुश्च पीक्षिच्च जह्नुश्चैव कुरोः सुताः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005957025, "chapter_id": 25957, "verse_number": "१-१४०-२६", "content_sanskrit": "सुधनुषः सुहोत्रोऽभूच्च्यवनोऽभूत्सुहोत्रत। ।\nच्यवनात्कृतको जज्ञे तथोपरिचरो वसुः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005957026, "chapter_id": 25957, "verse_number": "१-१४०-२७", "content_sanskrit": "बृहद्रथश्च प्रत्यग्रः सत्याद्याश्च वसोःसताः ।\nबृहद्रथात्कुशाग्रश्च कुशाग्रादृषभोऽभवत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005957027, "chapter_id": 25957, "verse_number": "१-१४०-२८", "content_sanskrit": "ऋषभात्पुष्पवांस्तस्माज्जज्ञे सत्यहितो नृपः ।\nसत्यहितात्सुधन्वाभूज्जह्रुश्चव सुधन्वनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005957028, "chapter_id": 25957, "verse_number": "१-१४०-२९", "content_sanskrit": "बृहद्रथाज्जरासन्धः सहदेवस्तदात्मजः ।\nसहदेवाच्च च सोमापिः सोमापेः श्रुतवान्सुतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005957029, "chapter_id": 25957, "verse_number": "१-१४०-३०", "content_sanskrit": "भीमसेनोग्रसेनौ च श्रुतसेनोऽपराजितः ।\nजनमेजयस्तथान्योऽभूज्जह्नोस्तु सुरथोऽभवत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005957030, "chapter_id": 25957, "verse_number": "१-१४०-३१", "content_sanskrit": "विदूरथस्तु सुरथात्सार्वभौमो विदूरथात। ।\nजयसेनः सार्वभौमादावधीतस्तदात्मजः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005957031, "chapter_id": 25957, "verse_number": "१-१४०-३२", "content_sanskrit": "अयुतायुस्तस्य पुत्रस्तस्य चाक्रोधनः सुत। ।\nअक्रोधनस्यातिथिश्च ऋक्षोऽभूदतिथेः सुतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005957032, "chapter_id": 25957, "verse_number": "१-१४०-३३", "content_sanskrit": "ऋक्षाच्च भीमसेनोऽभूद्दिलीपो भीमसेनतः ।\nप्रतीपोऽभूद्दिलीपाच्च देवापिस्तु प्रतीपतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005957033, "chapter_id": 25957, "verse_number": "१-१४०-३४", "content_sanskrit": "शन्तनुश्चैव बाह्लीकस्त्रयस्ते भ्रातरो नृपा। ।\nबाह्लीकात्सोमदत्तोऽभूद्भूरिर्भूरिश्रवास्ततः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005957034, "chapter_id": 25957, "verse_number": "१-१४०-३५", "content_sanskrit": "शलश्च शन्तनोर्भोष्मो गङ्गायां धार्मिको महान् ।\nचित्राङ्गदविचित्रौ तु सत्यवत्यान्तु शन्तनोः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005957035, "chapter_id": 25957, "verse_number": "१-१४०-३६", "content_sanskrit": "भार्ये विचित्रवीर्यस्य त्वम्बिकाम्बालिके तयोः ।\nधृराष्ट्रं च पाण्डुञ्च तद्दास्यां विदुरन्तथा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005957036, "chapter_id": 25957, "verse_number": "१-१४०-३७", "content_sanskrit": "व्यास उत्पादयामास गान्धागी धृतराष्ट्रतः ।\nशतपुत्रं दुर्योधनाद्यं पाण्डोः पञ्च प्रजज्ञिरे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005957037, "chapter_id": 25957, "verse_number": "१-१४०-३८", "content_sanskrit": "प्रतिबिन्ध्यः श्रुतसोमः श्रुतकीर्तिस्तथार्जुनात् ।\nशतानीकः श्रुतकर्मा द्रौपद्यां पञ्च वै क्रमात् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005957038, "chapter_id": 25957, "verse_number": "१-१४०-३९", "content_sanskrit": "यौधेयी च हिडिम्बा च कौशी चैव सुभद्रिका ।\nविजया वै रेणुमती पञ्चभ्यस्तु सुताः क्रमात् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005957039, "chapter_id": 25957, "verse_number": "१-१४०-४०", "content_sanskrit": "देवको घचोत्कचश्च ह्यभिमन्युश्च सर्वग। ।\nसुहोत्रो निरमित्रश्च परीक्षिदभिमन्युजः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005957040, "chapter_id": 25957, "verse_number": "१-१४०-४१", "content_sanskrit": "जनमेजयोऽस्य ततो भविष्यांश्च नृपाञ्छृणु ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]