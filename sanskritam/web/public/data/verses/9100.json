[{"id": 5000100000, "chapter_id": 9100, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे त्रयोविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000100001, "chapter_id": 9100, "verse_number": "२-२३-१", "content_sanskrit": "इति ब्रुवति रामे तु लक्ष्मणोऽवाक् शिरा इव।\nध्यात्वा मध्यं जगामाशु सहसा दैन्यहर्षयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000100002, "chapter_id": 9100, "verse_number": "२-२३-२", "content_sanskrit": "तदा तु बद‍्ध्वा भ्रुकुटीं भ्रुवोर्मध्ये नरर्षभः।\nनिशश्वास महासर्पो बिलस्थ इव रोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000100003, "chapter_id": 9100, "verse_number": "२-२३-३", "content_sanskrit": "तस्य दुष्प्रतिवीक्ष्यं तद् भ्रुकुटीसहितं तदा।\nबभौ क्रुद्धस्य सिंहस्य मुखस्य सदृशं मुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000100004, "chapter_id": 9100, "verse_number": "२-२३-४", "content_sanskrit": "अग्रहस्तं विधुन्वंस्तु हस्ती हस्तमिवात्मनः।\nतिर्यगूर्ध्वं शरीरे च पातयित्वा शिरोधराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000100005, "chapter_id": 9100, "verse_number": "२-२३-५", "content_sanskrit": "अग्राक्ष्णा वीक्षमाणस्तु तिर्यग्भ्रातरमब्रवीत्।\nअस्थाने सम्भ्रमो यस्य जातो वै सुमहानयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000100006, "chapter_id": 9100, "verse_number": "२-२३-६", "content_sanskrit": "धर्मदोषप्रसङ्गेन लोकस्यानतिशङ्कया।\nकथं ह्येतदसम्भ्रान्तस्त्वद्विधो वक्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000100007, "chapter_id": 9100, "verse_number": "२-२३-७", "content_sanskrit": "यथा ह्येवमशौण्डीरं शौण्डीरः क्षत्रियर्षभः।\nकिं नाम कृपणं दैवमशक्तमभिशंससि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000100008, "chapter_id": 9100, "verse_number": "२-२३-८", "content_sanskrit": "पापयोस्ते कथं नाम तयोः शङ्का न विद्यते।\nसन्ति धर्मोपधासक्ता धर्मात्मन् किं न बुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000100009, "chapter_id": 9100, "verse_number": "२-२३-९", "content_sanskrit": "तयोः सुचरितं स्वार्थं शाठ्यात् परिजिहीर्षतोः।\nयदि नैवं व्यवसितं स्याद्धि प्रागेव राघव।\nतयोः प्रागेव दत्तश्च स्याद् वरः प्रकृतश्च सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000100010, "chapter_id": 9100, "verse_number": "२-२३-१०", "content_sanskrit": "लोकविद्विष्टमारब्धं त्वदन्यस्याभिषेचनम्।\nनोत्सहे सहितुं वीर तत्र मे क्षन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000100011, "chapter_id": 9100, "verse_number": "२-२३-११", "content_sanskrit": "येनैवमागता द्वैधं तव बुद्धिर्महामते।\nसोऽपि धर्मो मम द्वेष्यो यत्प्रसङ्गाद् विमुह्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000100012, "chapter_id": 9100, "verse_number": "२-२३-१२", "content_sanskrit": "कथं त्वं कर्मणा शक्तः कैकेयीवशवर्तिनः।\nकरिष्यसि पितुर्वाक्यमधर्मिष्ठं विगर्हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000100013, "chapter_id": 9100, "verse_number": "२-२३-१३", "content_sanskrit": "यदयं किल्बिषाद् भेदः कृतोऽप्येवं न गृह्यते।\nजायते तत्र मे दुःखं धर्मसङ्गश्च गर्हितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000100014, "chapter_id": 9100, "verse_number": "२-२३-१४", "content_sanskrit": "तवायं धर्मसंयोगो लोकस्यास्य विगर्हितः।\nमनसापि कथं कामं कुर्यात् त्वां कामवृत्तयोः।\nतयोस्त्वहितयोर्नित्यं शत्र्वोः पित्रभिधानयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000100015, "chapter_id": 9100, "verse_number": "२-२३-१५", "content_sanskrit": "यद्यपि प्रतिपत्तिस्ते दैवी चापि तयोर्मतम्।\nतथाप्युपेक्षणीयं ते न मे तदपि रोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000100016, "chapter_id": 9100, "verse_number": "२-२३-१६", "content_sanskrit": "विक्लवो वीर्यहीनो यः स दैवमनुवर्तते।\nवीराः सम्भावितात्मानो न दैवं पर्युपासते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000100017, "chapter_id": 9100, "verse_number": "२-२३-१७", "content_sanskrit": "दैवं पुरुषकारेण यः समर्थः प्रबाधितुम्।\nन दैवेन विपन्नार्थः पुरुषः सोऽवसीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000100018, "chapter_id": 9100, "verse_number": "२-२३-१८", "content_sanskrit": "द्रक्ष्यन्ति त्वद्य दैवस्य पौरुषं पुरुषस्य च।\nदैवमानुषयोरद्य व्यक्ता व्यक्तिर्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000100019, "chapter_id": 9100, "verse_number": "२-२३-१९", "content_sanskrit": "अद्य मे पौरुषहतं दैवं द्रक्ष्यन्ति वै जनाः।\nयैर्दैवादाहतं तेऽद्य दृष्टं राज्याभिषेचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000100020, "chapter_id": 9100, "verse_number": "२-२३-२०", "content_sanskrit": "अत्यङ्कुशमिवोद्दामं गजं मदजलोद्धतम्।\nप्रधावितमहं दैवं पौरुषेण निवर्तये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000100021, "chapter_id": 9100, "verse_number": "२-२३-२१", "content_sanskrit": "लोकपालाः समस्तास्ते नाद्य रामाभिषेचनम्।\nन च कृत्स्नास्त्रयो लोका विहन्युः किं पुनः पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000100022, "chapter_id": 9100, "verse_number": "२-२३-२२", "content_sanskrit": "यैर्विवासस्तवारण्ये मिथो राजन् समर्थितः।\nअरण्ये ते विवत्स्यन्ति चतुर्दश समास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000100023, "chapter_id": 9100, "verse_number": "२-२३-२३", "content_sanskrit": "अहं तदाशां धक्ष्यामि पितुस्तस्याश्च या तव।\nअभिषेकविघातेन पुत्रराज्याय वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000100024, "chapter_id": 9100, "verse_number": "२-२३-२४", "content_sanskrit": "मद‍्बलेन विरुद्धाय न स्याद् दैवबलं तथा।\nप्रभविष्यति दुःखाय यथोग्रं पौरुषं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000100025, "chapter_id": 9100, "verse_number": "२-२३-२५", "content_sanskrit": "ऊर्ध्वं वर्षसहस्रान्ते प्रजापाल्यमनन्तरम्।\nआर्यपुत्राः करिष्यन्ति वनवासं गते त्वयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000100026, "chapter_id": 9100, "verse_number": "२-२३-२६", "content_sanskrit": "पूर्वराजर्षिवृत्त्या हि वनवासोऽभिधीयते।\nप्रजा निक्षिप्य पुत्रेषु पुत्रवत् परिपालने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000100027, "chapter_id": 9100, "verse_number": "२-२३-२७", "content_sanskrit": "स चेद् राजन्यनेकाग्रे राज्यविभ्रमशङ्कया।\nनैवमिच्छसि धर्मात्मन् राज्यं राम त्वमात्मनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000100028, "chapter_id": 9100, "verse_number": "२-२३-२८", "content_sanskrit": "प्रतिजाने च ते वीर मा भूवं वीरलोकभाक्।\nराज्यं च तव रक्षेयमहं वेलेव सागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000100029, "chapter_id": 9100, "verse_number": "२-२३-२९", "content_sanskrit": "मङ्गलैरभिषिञ्चस्व तत्र त्वं व्यापृतो भव।\nअहमेको महीपालानलं वारयितुं बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000100030, "chapter_id": 9100, "verse_number": "२-२३-३०", "content_sanskrit": "न शोभार्थाविमौ बाहू न धनुर्भूषणाय मे।\nनासिराबन्धनार्थाय न शराः स्तम्भहेतवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000100031, "chapter_id": 9100, "verse_number": "२-२३-३१", "content_sanskrit": "अमित्रमथनार्थाय सर्वमेतच्चतुष्टयम्।\nन चाहं कामयेऽत्यर्थं यः स्याच्छत्रुर्मतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000100032, "chapter_id": 9100, "verse_number": "२-२३-३२", "content_sanskrit": "असिना तीक्ष्णधारेण विद्युच्चलितवर्चसा।\nप्रगृहीतेन वै शत्रुं वज्रिणं वा न कल्पये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000100033, "chapter_id": 9100, "verse_number": "२-२३-३३", "content_sanskrit": "खड्गनिष्पेषनिष्पिष्टैर्गहना दुश्चरा च मे।\nहस्त्यश्वरथिहस्तोरुशिरोभिर्भविता मही ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000100034, "chapter_id": 9100, "verse_number": "२-२३-३४", "content_sanskrit": "खड्गधाराहता मेऽद्य दीप्यमाना इवाग्नयः।\nपतिष्यन्ति द्विषो भूमौ मेघा इव सविद्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000100035, "chapter_id": 9100, "verse_number": "२-२३-३५", "content_sanskrit": "बद्धगोधाङ्गुलित्राणे प्रगृहीतशरासने।\nकथं पुरुषमानी स्यात् पुरुषाणां मयि स्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000100036, "chapter_id": 9100, "verse_number": "२-२३-३६", "content_sanskrit": "बहुभिश्चैकमत्यस्यन्नेकेन च बहूञ्जनान्।\nविनियोक्ष्याम्यहं बाणान्नृवाजिगजमर्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000100037, "chapter_id": 9100, "verse_number": "२-२३-३७", "content_sanskrit": "अद्य मेऽस्त्रप्रभावस्य प्रभावः प्रभविष्यति।\nराज्ञश्चाप्रभुतां कर्तुं प्रभुत्वं च तव प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000100038, "chapter_id": 9100, "verse_number": "२-२३-३८", "content_sanskrit": "अद्य चन्दनसारस्य केयूरामोक्षणस्य च।\nवसूनां च विमोक्षस्य सुहृदां पालनस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000100039, "chapter_id": 9100, "verse_number": "२-२३-३९", "content_sanskrit": "अनुरूपाविमौ बाहू राम कर्म करिष्यतः।\nअभिषेचनविघ्नस्य कर्तॄणां ते निवारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000100040, "chapter_id": 9100, "verse_number": "२-२३-४०", "content_sanskrit": "ब्रवीहि कोऽद्यैव मया वियुज्यतां\nतवासुहृत् प्राणयशःसुहृज्जनैः।\nयथा तवेयं वसुधा वशा भवेत्\nतथैव मां शाधि तवास्मि किंकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000100041, "chapter_id": 9100, "verse_number": "२-२३-४१", "content_sanskrit": "विमृज्य बाष्पं परिसान्त्व्य चासकृत्\nस लक्ष्मणं राघववंशवर्धनः।\nउवाच पित्रोर्वचने व्यवस्थितं\nनिबोध मामेष हि सौम्य सत्पथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000100042, "chapter_id": 9100, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे त्रयोविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]