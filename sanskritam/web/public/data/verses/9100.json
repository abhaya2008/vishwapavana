[{"id": 40010828, "chapter_id": 9100, "verse_number": "1", "content_sanskrit": "दर्शनार्थं तु वैदेह्यास्सर्वतः कपियूधपाः। व्यादिष्टाः कपिराजेन यथोक्तं जग्मुरञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40010829, "chapter_id": 9100, "verse_number": "2", "content_sanskrit": "सरांसि सरित काक्षानाकाशं नगराणि च। नदीदुर्गांस्तथा शैलान्विचिन्वन्ति समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40010830, "chapter_id": 9100, "verse_number": "3", "content_sanskrit": "सुग्रीवेण समाख्यातास्सर्वे वानरयूथपाः। प्रदेशान्प्रविचिन्वन्ति सशैलवनकाननान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40010831, "chapter_id": 9100, "verse_number": "4", "content_sanskrit": "विचित्य दिवसं सर्वे सीताधिगमने धृताः। समायान्ति स्म मेदिन्यां निशाकालेषु वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40010832, "chapter_id": 9100, "verse_number": "5", "content_sanskrit": "सर्वर्तुकमान् देशेषु वानारास्सफलद्रुमान्। आसाद्य रजनीं शय्यां चक्रुस्सर्वेष्वहस्सु ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40010833, "chapter_id": 9100, "verse_number": "6", "content_sanskrit": "तदहः प्रथमं कृत्वा मासे प्रश्रवणं गताः। कपिराजेन सङ्गम्य निराशाः कपियूधपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40010834, "chapter_id": 9100, "verse_number": "7", "content_sanskrit": "विचित्य तु दिशं पूर्वां यथोक्तां सचिवैस्सह। अदृष्ट्वा विनतस्सीतामाजगाम महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40010835, "chapter_id": 9100, "verse_number": "8", "content_sanskrit": "उत्तरां च दिशं सर्वां विचित्य स महाकपिः। आगतस्सह सैन्येन वीरश्शतवलिस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40010836, "chapter_id": 9100, "verse_number": "9", "content_sanskrit": "सुषेणः पश्चिमा माशां विचित्य सह वानरैः। समेत्य मासे सम्पूर्णे सुग्रीवमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40010837, "chapter_id": 9100, "verse_number": "10", "content_sanskrit": "तं प्रस्रवणपृष्ठस्थं समासाद्याभिवाद्य च। आसीनं सह रामेण सुग्रीवमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40010838, "chapter_id": 9100, "verse_number": "11", "content_sanskrit": "विचिताः पर्वतास्सर्वे वनानि गहनानि च। निम्नगास्सागरान्ताश्च सर्वे जनपदाश्च ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40010839, "chapter_id": 9100, "verse_number": "12", "content_sanskrit": "गुहाश्च विचितास्सर्वास्त्वया याः परिकीर्तिताः। विचिताश्च महागुल्मा लताविततसन्तताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40010840, "chapter_id": 9100, "verse_number": "13", "content_sanskrit": "गहनेषु च देशेषु दुर्गेषु विषमेषु च। सत्त्वान्यतिप्रमाणानि विचितानि हतानि च ॥ ये चैव गहना देशा विचितास्ते पुनः पुनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40010841, "chapter_id": 9100, "verse_number": "14", "content_sanskrit": "उदारसत्त्वाभिजनो महात्मा स मैथिलीं द्रक्ष्यति वानरेन्द्रः। दिशं तु यामेव गता तु सीता तामास्थितोवायुसुतो हनूमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]