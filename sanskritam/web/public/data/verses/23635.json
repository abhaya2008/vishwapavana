[{"id": 7003635000, "chapter_id": 23635, "verse_number": "१-२-२२-१", "content_sanskrit": "नारद उवाच ।\nएवं विप्रकृता देवा महेंद्रसहितास्तदा ।\nययुः स्वायंभुवं दाम मर्करूपमुपाश्रिताः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003635001, "chapter_id": 23635, "verse_number": "१-२-२२-२", "content_sanskrit": "ततश्च विस्मितो ब्रह्मा प्राह तान्सुरपुंगवान् ।\nस्वरूपेणेह तिष्ठध्वं नात्र वस्तारकाद्भयम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003635002, "chapter_id": 23635, "verse_number": "१-२-२२-३", "content_sanskrit": "ततो देवाः स्वरूपस्थाः प्रम्लानवदनांबुजाः ।\nतुष्टुवुः प्रणताः सर्वे पितरं पुत्रका यथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003635003, "chapter_id": 23635, "verse_number": "१-२-२२-४", "content_sanskrit": "नमो जगत्प्रसूत्यै ते हेतवे पालकाय च ।\nसंहर्त्रे च नमस्तुभ्यं तिस्रोऽवस्थास्तव प्रभो ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003635004, "chapter_id": 23635, "verse_number": "१-२-२२-५", "content_sanskrit": "त्वमपः प्रथमं सृष्ट्वा तासु वीर्यमवासृजः ।\nतदण्डमभवद्धैमं यस्मिल्लोकाश्चराचराः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003635005, "chapter_id": 23635, "verse_number": "१-२-२२-६", "content_sanskrit": "वेदेष्वाहुर्विराड्रूपं त्वामेकरूपमीदृशम् ।\nपातालं पादमूलं च पार्ष्णिपादे रसातलम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003635006, "chapter_id": 23635, "verse_number": "१-२-२२-७", "content_sanskrit": "महातलं चास्य गुल्फौ जंघे चापि तलातलम् ।\nसुतलं जानुनी चास्य ऊरू च वितलातले ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003635007, "chapter_id": 23635, "verse_number": "१-२-२२-८", "content_sanskrit": "महीतलं च जघनं नाभिश्चास्य नभस्तलम् ।\nज्योतिः पदमुरः स्थानं स्वर्लोको बाहुरुच्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003635008, "chapter_id": 23635, "verse_number": "१-२-२२-९", "content_sanskrit": "ग्रीवा महश्चवदनं जनलोकः प्रकीर्त्यते ।\nललाटं च तपोलोकः शीर्ष सत्यमुदाहृतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003635009, "chapter_id": 23635, "verse_number": "१-२-२२-१०", "content_sanskrit": "चन्द्रसूर्यौ च नयने दिशः श्रोत्रे नासिकाश्विनौ ।\nआत्मानं ब्रह्मरंध्रस्थमाहुस्त्वां वेदवादिनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003635010, "chapter_id": 23635, "verse_number": "१-२-२२-११", "content_sanskrit": "एवं ये ते विराड्रूपं संस्मरंत उपासते ।\nजन्मबन्धविनिर्मुक्ता यांति त्वां परमं पदम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003635011, "chapter_id": 23635, "verse_number": "१-२-२२-१२", "content_sanskrit": "एवं स्थूलं प्राणिमध्यं च शूक्ष्मं भावेभावे भावितं त्वां गृणंति ।\nसर्वत्रस्थं त्वामतः प्राहुर्वेदास्तस्मै तुभ्यं पदम्ज इद्विधेम ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003635012, "chapter_id": 23635, "verse_number": "१-२-२२-१३", "content_sanskrit": "एवं स्तुतो विरंचिस्तु कृपयाभिपरिप्लुतः ।\nजानन्नपि तदा प्राह तेषामाश्वासहेतवे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003635013, "chapter_id": 23635, "verse_number": "१-२-२२-१४", "content_sanskrit": "सर्वे भवन्तो दुःखार्ताः परिम्लानमुखांबुजाः ।\nभ्रष्टायुदास्तथाऽकस्माद्भ्रष्टा भरणवाससः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003635014, "chapter_id": 23635, "verse_number": "१-२-२२-१५", "content_sanskrit": "ममैवयं कृतिर्देवा भवतां यद्वडम्बना ।\nयद्वैराजशरीरे मे भवन्तो बाहुसंज्ञकाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003635015, "chapter_id": 23635, "verse_number": "१-२-२२-१६", "content_sanskrit": "यद्यद्विभूतिमत्सत्त्वं धार्मिकं चोर्जितं महत् ।\nतत्रासीद्बाहुनाशो मे बाहुस्थाने च ते मम ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003635016, "chapter_id": 23635, "verse_number": "१-२-२२-१७", "content_sanskrit": "तन्नूनं मम भग्नौ च बाहू तेन दुरात्मना ।\nयेन चोपहृतं देवास्तन्ममाख्यातु मर्हथ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003635017, "chapter_id": 23635, "verse_number": "१-२-२२-१८", "content_sanskrit": "देवा ऊचुः ।\nयोऽसौ वज्रांगतनयस्त्वया दत्तवरः प्रभो ।\nभृशं विप्रकृतास्तेन तत्त्वं जानासि तत्त्वतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003635018, "chapter_id": 23635, "verse_number": "१-२-२२-१९", "content_sanskrit": "यत्तन्महीसमुद्रस्य तटं शार्विकतीर्थकम् ।\nतदाक्रम्य कृतं तेन मरुभूमिसमं प्रभोः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003635019, "chapter_id": 23635, "verse_number": "१-२-२२-२०", "content_sanskrit": "ऋद्धयः सर्वदेवानां गृहीतास्तेन सर्वतः ।\nमहाभूतस्वरूपेण स एव च जगत्पतिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003635020, "chapter_id": 23635, "verse_number": "१-२-२२-२१", "content_sanskrit": "चंद्रसूर्यौ ग्रहास्तारा यच्चान्यद्देवपक्षतः ।\nतच्च सर्वं निराकृत्य स्थापितो दैत्यपक्षकः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003635021, "chapter_id": 23635, "verse_number": "१-२-२२-२२", "content_sanskrit": "वयं च विधृता स्तेन बहूपहसितास्तथा ।\nप्रसादान्मुक्ताश्च कथंचिदिव कष्टतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003635022, "chapter_id": 23635, "verse_number": "१-२-२२-२३", "content_sanskrit": "तद्वयं शरणं प्राप्ताः पीडिताः क्षुत्तृषार्दिताः ।\nधर्मरक्षा कराश्चेति संचिंत्य त्रातुमर्हसि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003635023, "chapter_id": 23635, "verse_number": "१-२-२२-२४", "content_sanskrit": "इत्युक्तः स्वात्मभूर्देवः सुरैर्दैत्यविचेष्टितम् ।\nसुरानुवाच भगवानतः संचिंत्य तत्त्वतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003635024, "chapter_id": 23635, "verse_number": "१-२-२२-२५", "content_sanskrit": "अवध्यस्तारको दैत्यः सर्वैरपि सुरासुरैः ।\nयस्य वध्यश्च नाद्यापि स जातो भगवान्पुनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003635025, "chapter_id": 23635, "verse_number": "१-२-२२-२६", "content_sanskrit": "मया च वरदानेन च्छन्दयित्वा निवारितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003635026, "chapter_id": 23635, "verse_number": "१-२-२२-२७", "content_sanskrit": "तपसा स हिदीप्तोऽभूत्त्रैलोक्यदहनात्मकः ।\nस च वव्रे वधं दैत्यः शिशतः सप्तवासरात् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003635027, "chapter_id": 23635, "verse_number": "१-२-२२-२८", "content_sanskrit": "स च सप्तदिनो बालः शंकराद्यो भविष्यति ।\nतारकस्य च वीरस्य वधकर्ता भविष्यति ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003635028, "chapter_id": 23635, "verse_number": "१-२-२२-२९", "content_sanskrit": "सतीनामा तु या देवी विनष्टा दक्षहेलया ।\nसा भविष्यति कल्याणी हिमाचलशरीरजा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003635029, "chapter_id": 23635, "verse_number": "१-२-२२-३०", "content_sanskrit": "शंकरस्य च तस्याश्च यत्नः कार्यः समागमे ।\nअहमप्यस्य कार्यस्य शेषं कर्ता न संशयः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003635030, "chapter_id": 23635, "verse_number": "१-२-२२-३१", "content_sanskrit": "इत्युक्तास्त्रिदशास्तेन साक्षात्कलयोनिना ।\nजग्मुर्मेरुं प्रणम्येशं मर्करूपेण संवृताः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003635031, "chapter_id": 23635, "verse_number": "१-२-२२-३२", "content_sanskrit": "ततो गतेषु देवेषु ब्रह्मा लोकपितामहः ।\nनिशां सस्मार भगवान्स्वां तनुं पूर्वसंभवाम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003635032, "chapter_id": 23635, "verse_number": "१-२-२२-३३", "content_sanskrit": "ततो भगवती रात्रिरुपतस्थे पितामहम् ।\nतां विविक्ते समालोक्य तथोवाच विभावरीम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003635033, "chapter_id": 23635, "verse_number": "१-२-२२-३४", "content_sanskrit": "विभावरि महाकार्यं विबुधानामुपस्थितम् ।\nतत्कर्तव्यं त्वया देवि श्रृणु कार्यस्य निश्चयम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003635034, "chapter_id": 23635, "verse_number": "१-२-२२-३५", "content_sanskrit": "तारकोनाम दैत्येंद्रः सुरकेतुरनिर्ज्जितः ।\nतस्याभावाय भगवाञ्जनयिष्यति यं शिवः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003635035, "chapter_id": 23635, "verse_number": "१-२-२२-३६", "content_sanskrit": "सुतः स भविता तस्य तारकस्यांतकारकः ।\nअहं त्वादौ यदा जातस्तदापश्यं पुरःस्थितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003635036, "chapter_id": 23635, "verse_number": "१-२-२२-३७", "content_sanskrit": "अर्धनारीश्वरं देवं व्याप्य विश्वमवस्थितम् ।\nदृष्ट्वा तमब्रुवं देवं भजस्वेति च भक्तितः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003635037, "chapter_id": 23635, "verse_number": "१-२-२२-३८", "content_sanskrit": "ततो नारी पृथग्जाता पुरुषश्च तथा पृथक् ।\nतस्याश्चैवांशजाः सर्वाः स्त्रियस्त्रिभुवने स्मृताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003635038, "chapter_id": 23635, "verse_number": "१-२-२२-३९", "content_sanskrit": "एकादश च रुद्राश्च पुरुषास्तस्य चांशजाः ।\nतां नारीमहामालोक्य पुत्रं दक्षमथा ब्रवम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003635039, "chapter_id": 23635, "verse_number": "१-२-२२-४०", "content_sanskrit": "भजस्व पुत्रीं जगती ममापि च तवापि च ।\nपुंदुःखनकात्त्रात्री पुत्री ते भाविनी त्वियम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003635040, "chapter_id": 23635, "verse_number": "१-२-२२-४१", "content_sanskrit": "एवमुक्तो मया दक्षः पुत्रीत्वे परि कल्पिताम् ।\nरुद्राय दत्तवान्भक्त्या नाम दत्त्वा सतीति यत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003635041, "chapter_id": 23635, "verse_number": "१-२-२२-४२", "content_sanskrit": "ततः काले चं कस्मिंश्चिदवमेने च तां पिता ।\nमुमूर्षुः पापसंकल्पो दुरात्मा कुलकज्जलः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003635042, "chapter_id": 23635, "verse_number": "१-२-२२-४३", "content_sanskrit": "ये रुद्रं नैव मन्यंते ते स्फुटं कुलकज्जलाः ।\nपिशाचास्ते दुरात्मानो भवंति ब्रह्मराक्षसाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003635043, "chapter_id": 23635, "verse_number": "१-२-२२-४४", "content_sanskrit": "अवमानेन तस्यापि यथा देवी जहौ तनुम् ।\nयथा यज्ञः स च ध्वस्तो भवेन विदितं हि ते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003635044, "chapter_id": 23635, "verse_number": "१-२-२२-४५", "content_sanskrit": "अधुना हिमशैलस्य भवित्री दुहिता च सा ।\nमहेश्वरं पतिं सा च पुनः प्राप्स्यति निश्चितम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003635045, "chapter_id": 23635, "verse_number": "१-२-२२-४६", "content_sanskrit": "तदिदं च त्वया कार्यं मेनागर्भे प्रविश्य च ।\nतस्याश्छविं कुरु कृष्णां यथा काली भवेत्तु सा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003635046, "chapter_id": 23635, "verse_number": "१-२-२२-४७", "content_sanskrit": "यदा रुद्रोपहसिता तपस्तप्स्यति सा महत् ।\nसमाप्तनियमा देवी यदा चोग्रा भविष्यति ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003635047, "chapter_id": 23635, "verse_number": "१-२-२२-४८", "content_sanskrit": "स्वयमेव यदा रूपं सुगौरं प्रतिपत्स्यते ।\nविरहेण हरश्चास्या मत्वा शून्यं जगत्त्रयम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003635048, "chapter_id": 23635, "verse_number": "१-२-२२-४९", "content_sanskrit": "तस्यैव हिमशैलस्य कंदरे सिद्धसेविते ।\nप्रतीक्षमाणस्तां देवीमुग्रं संतप्स्यते तपः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003635049, "chapter_id": 23635, "verse_number": "१-२-२२-५०", "content_sanskrit": "तयोः सुतप्ततपसोर्भविता यो महान्सुतः ।\nभविष्यति स दैत्यस्य तारकस्य निवारकः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003635050, "chapter_id": 23635, "verse_number": "१-२-२२-५१", "content_sanskrit": "तपसो हि विना नास्ति सिद्धिः कुत्रापि शोभने ।\nसर्वासां कर्मसिद्धीनां मूलं हि तप उच्यते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003635051, "chapter_id": 23635, "verse_number": "१-२-२२-५२", "content_sanskrit": "त्वयापि दानवो देवि देहनिर्गतया तदा ।\nचंडमुंडपुरोगाश्च हंतव्या लोकदुर्जयाः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003635052, "chapter_id": 23635, "verse_number": "१-२-२२-५३", "content_sanskrit": "यस्माच्चंडं च मुंडं च त्वं देवि निहनिष्यसि ।\nचामुंडेति ततो लोके ख्याता देवि भविष्यसि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003635053, "chapter_id": 23635, "verse_number": "१-२-२२-५४", "content_sanskrit": "ततस्त्वां वरदे देवी लोकः संपूजयिष्यति ।\nभेदेर्बहुविधाकारैः सर्वगां कामसाधनीम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003635054, "chapter_id": 23635, "verse_number": "१-२-२२-५५", "content_sanskrit": "ओंकारवक्त्रां गायत्रीं त्वामर्चंति द्विजोत्तमाः ।\nऊर्जितां बलदां पापि राजानः सुमहाबलाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003635055, "chapter_id": 23635, "verse_number": "१-२-२२-५६", "content_sanskrit": "वैश्याश्च भूतिमित्येव शिवां शूद्रास्तथा शुभे ।\nक्षांतिर्मुनीनामक्षोभ्या दया नियमिनामपि ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003635056, "chapter_id": 23635, "verse_number": "१-२-२२-५७", "content_sanskrit": "त्वं महोपाय सन्दोहा नीतिर्नयविसर्पिणाम् ।\nपरिस्थितिस्त्वमर्थानां त्वमहो प्राणिका मता ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003635057, "chapter_id": 23635, "verse_number": "१-२-२२-५८", "content_sanskrit": "त्वं युक्तिः सर्वभूतानां त्वं गतिः सर्वदेहिनाम् ।\nरतिस्त्वं रतिचित्तानां प्रीतिस्त्वं हृद्यदर्शिनाम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003635058, "chapter_id": 23635, "verse_number": "१-२-२२-५९", "content_sanskrit": "त्वं कांतिः शुभरूपाणां त्वं शांति शुभकर्मिणाम् ।\nत्वं भ्रांतिर्मूढचित्तानां त्वं फलं क्रतुयाजिनाम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003635059, "chapter_id": 23635, "verse_number": "१-२-२२-६०", "content_sanskrit": "जलधीनां महावेला त्वं च लीला विलासिनाम् ।\nसंभूतिस्त्वं पदार्थानां स्थितिस्त्वं लोकपालिनी ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003635060, "chapter_id": 23635, "verse_number": "१-२-२२-६१", "content_sanskrit": "त्वं कालरात्रिर्निःशेष भुवनावलिनाशिनी ।\nप्रियकंठग्रहानन्ददायिनी त्वं विभावरी ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003635061, "chapter_id": 23635, "verse_number": "१-२-२२-६२", "content_sanskrit": "प्रसीद प्रणतानस्मान्सौम्यदृष्ट्या विलोकय ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003635062, "chapter_id": 23635, "verse_number": "१-२-२२-६३", "content_sanskrit": "इति स्तुवंतो ये देवि पूजयिष्यंति त्वां शुभे ।\nते सर्वकामानाप्स्यंति नियता नात्र संशयः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003635063, "chapter_id": 23635, "verse_number": "१-२-२२-६४", "content_sanskrit": "इत्युक्ता तु निशादेवी तथेत्युक्त्वा कृताञ्जलिः ।\nजगाम त्वरिता पूर्वं गृहं हिमगिरेर्महत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003635064, "chapter_id": 23635, "verse_number": "१-२-२२-६५", "content_sanskrit": "तत्राऽसीनां महाहर्म्ये रत्नभित्तिसमाश्रये ।\nददर्श मेनामापांडुच्छविवक्त्रसरोरुहाम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003635065, "chapter_id": 23635, "verse_number": "१-२-२२-६६", "content_sanskrit": "किंचिच्छयाममुखोदग्रस्तनभागावनामिताम् ।\nमहौषधिगणबद्धमंत्रराजनिषेविताम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003635066, "chapter_id": 23635, "verse_number": "१-२-२२-६७", "content_sanskrit": "ततः किंचित्प्रमिलिते मेनानेत्रांबुजद्वये ।\nआविवेशमुखं रात्रिर्ब्रह्मणो वचनात्तदा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003635067, "chapter_id": 23635, "verse_number": "१-२-२२-६८", "content_sanskrit": "जन्मदाया जगन्मातुः क्रमेण जठरांतरम् ।\nअरंजयच्छविं देव्या गुहमातुर्विभावरी ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003635068, "chapter_id": 23635, "verse_number": "१-२-२२-६९", "content_sanskrit": "ततो जगन्मं गलदा मेना हिमगिरेः प्रिया ।\nब्राह्मे मुहूर्ते सुभगे प्रासूयत शुभाननाम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003635069, "chapter_id": 23635, "verse_number": "१-२-२२-७०", "content_sanskrit": "तस्यां तु जायमानायां जंतवः स्थाणुजंगमाः ।\nअभवन्सुखिनः सर्वे सर्वलोकनिवासिनः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003635070, "chapter_id": 23635, "verse_number": "१-२-२२-७१", "content_sanskrit": "अभवत्क्रूरसत्त्वानां चेतः शांतं च देहिनाम् ।\nज्योतिषामपि तेजस्त्वमभवत्सुतरां तदा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003635071, "chapter_id": 23635, "verse_number": "१-२-२२-७२", "content_sanskrit": "वनाश्रिताश्चौषधयः स्वादवंति फलानि च ।\nगंधवंति च माल्यानि विमलं च नभोऽभवत् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003635072, "chapter_id": 23635, "verse_number": "१-२-२२-७३", "content_sanskrit": "मारुतश्च सुखस्पर्शो दिशश्च सुमनोहराः ।\nविस्मृता नि च शास्त्राणि प्रादुर्भावं प्रपेदिरे ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003635073, "chapter_id": 23635, "verse_number": "१-२-२२-७४", "content_sanskrit": "प्रभावस्तीर्थमुख्यानां तदा पुण्यतमोऽभवत् ।\nसत्ये धर्मे चाध्ययने यज्ञे दाने तपस्यपि ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003635074, "chapter_id": 23635, "verse_number": "१-२-२२-७५", "content_sanskrit": "सर्वेषामभवच्छ्रद्धा जन्मकाले गुहारणेः ।\nअंतरिक्षेमराश्चापि प्रहर्षोत्फुल्ललोचनाः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003635075, "chapter_id": 23635, "verse_number": "१-२-२२-७६", "content_sanskrit": "हरिब्रह्ममहेंद्रार्कवायुवह्निपुरोगमाः ।\nपुष्पवृष्टिं प्रमुमुचुस्तस्मिन्मेनागृहे शुभे ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003635076, "chapter_id": 23635, "verse_number": "१-२-२२-७७", "content_sanskrit": "मेरुप्रभृतयश्चापि मूर्तिमंतो महानगाः ।\nतस्मिन्महोत्सवे प्राप्ता वीरकांस्योपशोभिताः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003635077, "chapter_id": 23635, "verse_number": "१-२-२२-७८", "content_sanskrit": "सागराः सरितश्चैव समाजग्मुश्च सर्वशः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003635078, "chapter_id": 23635, "verse_number": "१-२-२२-७९", "content_sanskrit": "हिमशैलोऽभवल्लोके तदा सर्वैश्चराचरैः ।\nसेव्यश्चाप्यभिगम्यश्च पूजनीयश्च भारत ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003635079, "chapter_id": 23635, "verse_number": "१-२-२२-८०", "content_sanskrit": "अनुभूयोत्सवं ते च जग्मुः स्वानालयांस्तदा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]