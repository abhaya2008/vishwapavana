[{"id": 7001093000, "chapter_id": 21093, "verse_number": "२-१-४-१", "content_sanskrit": "ऋषय ऊचुः ।\nसूत सूत महाप्राज्ञ वर्णिता ह्यद्भुता कथा ।\nधन्या तु शांभवी माया तदधीनं चराचरम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001093001, "chapter_id": 21093, "verse_number": "२-१-४-२", "content_sanskrit": "गतयोर्गणयोश्शंभोस्स्वयमात्मेच्छया विभोः ।\nकिं चकार मुनिः क्रुद्धो नारदः स्मरविह्वलः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001093002, "chapter_id": 21093, "verse_number": "२-१-४-३", "content_sanskrit": "सूत उवाच ।\nविमोहितो मुनिर्दत्त्वा तयोश्शापं यथोचितम् ।\nजले मुखं निरीक्ष्याथ स्वरूपं गिरिशेच्छया॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001093003, "chapter_id": 21093, "verse_number": "२-१-४-४", "content_sanskrit": "शिवेच्छया न प्रबुद्धः स्मृत्वा हरिकृतच्छलम् ।\nक्रोधं दुर्विषहं कृत्वा विष्णुलोकं जगाम ह॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001093004, "chapter_id": 21093, "verse_number": "२-१-४-५", "content_sanskrit": "उवाच वचनं कुद्धस्समिद्ध इव पावकः ।\nदुरुक्तिगर्भितं व्यङ्गः नष्टज्ञानश्शिवेच्छया॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001093005, "chapter_id": 21093, "verse_number": "२-१-४-६", "content_sanskrit": "नारद उवाच ।\nहे हरे त्वं महादुष्टः कपटी विश्वमोहनः ।\nपरोत्साहं न सहसे मायावी मलिनाशयः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001093006, "chapter_id": 21093, "verse_number": "२-१-४-७", "content_sanskrit": "मोहिनीरूपमादाय कपटं कृतवान्पुरा ।\nअसुरेभ्योऽपाययस्त्वं वारुणीममृतं न हि॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001093007, "chapter_id": 21093, "verse_number": "२-१-४-८", "content_sanskrit": "चेत्पिबेन्न विषं रुद्रो दयां कृत्वा महेश्वरः ।\nभवेन्नष्टाऽखिला माया तव व्याजरते हरे॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001093008, "chapter_id": 21093, "verse_number": "२-१-४-९", "content_sanskrit": "गतिस्स कपटा तेऽतिप्रिया विष्णो विशेषतः ।\nसाधुस्वभावो न भवान्स्वतंत्रः प्रभुणा कृतः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001093009, "chapter_id": 21093, "verse_number": "२-१-४-१०", "content_sanskrit": "कृतं समुचितन्नैव शिवेन परमात्मना ।\nतत्प्रभावबलं ध्यात्वा स्वतंत्रकृतिकारकः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001093010, "chapter_id": 21093, "verse_number": "२-१-४-११", "content_sanskrit": "त्वद्गतिं सुसमाज्ञाय पश्चात्तापमवाप सः ।\nविप्रं सर्वोपरि प्राह स्वोक्तवेद प्रमाणकृत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001093011, "chapter_id": 21093, "verse_number": "२-१-४-१२", "content_sanskrit": "तज्ज्ञात्वाहं हरे त्वाद्य शिक्षयिष्यामि तद्बलात् ।\nयथा न कुर्याः कुत्रापीदृशं कर्म कदाचन॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001093012, "chapter_id": 21093, "verse_number": "२-१-४-१३", "content_sanskrit": "अद्यापि निर्भयस्त्वं हि संगं नापस्तरस्विना ।\nइदानीं लप्स्यसे विष्णो फलं स्वकृतकर्मणः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001093013, "chapter_id": 21093, "verse_number": "२-१-४-१४", "content_sanskrit": "इत्थमुक्त्वा हरिं सोथ मुनिर्माया विमोहितः ।\nशशाप क्रोधनिर्विण्णो ब्रह्मतेजः प्रदर्शयन्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001093014, "chapter_id": 21093, "verse_number": "२-१-४-१५", "content_sanskrit": "स्त्रीकृते व्याकुलं विष्णो मामकार्षीर्विमोहकः ।\nअन्वकार्षीस्स्वरूपेण येन कापट्यकार्यकृत्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001093015, "chapter_id": 21093, "verse_number": "२-१-४-१६", "content_sanskrit": "तद्रूपेण मनुष्यस्त्वं भव तद्दुःखभुग्घरे ।\nयन्मुखं कृतवान्मे त्वं ते भवंतु सहायिनः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001093016, "chapter_id": 21093, "verse_number": "२-१-४-१७", "content_sanskrit": "त्वं स्त्रीवियोगजं दुःखं लभस्व परदुःखदः ।\nमनुष्यगतिकः प्रायो भवाज्ञानविमोहितः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001093017, "chapter_id": 21093, "verse_number": "२-१-४-१८", "content_sanskrit": "इति शप्त्वा हरिं मोहान्नारदोऽज्ञानमोहितः ।\nविष्णुर्जग्राह तं शापं प्रशंसञ्शांभवीमजाम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001093018, "chapter_id": 21093, "verse_number": "२-१-४-१९", "content_sanskrit": "अथ शंभुर्महालीलो निश्चकर्ष विमोहिनीम ।\nस्वमायां मोहितो ज्ञानी नारदोप्यभवद्यया॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001093019, "chapter_id": 21093, "verse_number": "२-१-४-२०", "content_sanskrit": "अंतर्हितायां मायायां पूर्ववन्मतिमानभूत् ।\nनारदो विस्मितमनाः प्राप्तबोधो निराकुलः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001093020, "chapter_id": 21093, "verse_number": "२-१-४-२१", "content_sanskrit": "पश्चात्तापमवाप्याति निनिन्द स्वं मुहुर्मुहुः ।\nप्रशशंस तदा मायां शांभवीं ज्ञानिमोहिनीम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001093021, "chapter_id": 21093, "verse_number": "२-१-४-२२", "content_sanskrit": "अथ ज्ञात्वा मुनिस्सर्वं मायाविभ्रममात्मनः ।\nअपतत्पादयोर्विष्णोर्नारदो वैष्णवोत्तमः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001093022, "chapter_id": 21093, "verse_number": "२-१-४-२३", "content_sanskrit": "हर्य्युपस्थापितः प्राह वचनं नष्ट दुर्मतिः ।\nमया दुरक्तयः प्रोक्ता मोहितेन कुबुद्धिना॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001093023, "chapter_id": 21093, "verse_number": "२-१-४-२४", "content_sanskrit": "दत्तश्शापोऽपि तेनाथ वितथं कुरु तं प्रभो ।\nमहत्पापमकार्षं हि यास्यामि निरयं धुवम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001093024, "chapter_id": 21093, "verse_number": "२-१-४-२५", "content_sanskrit": "कमुपायं हरे कुर्यां दासोऽहं ते तमादिश ।\nयेन पापकुलं नश्येन्निरयो न भवेन्मम॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001093025, "chapter_id": 21093, "verse_number": "२-१-४-२६", "content_sanskrit": "इत्युक्त्वा स पुनर्विष्णोः पादयोर्मुनिसत्तमः ।\nपपात सुमतिर्भक्त्या पश्चात्तापमुपागतः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001093026, "chapter_id": 21093, "verse_number": "२-१-४-२७", "content_sanskrit": "अथ विष्णुस्तमुत्थाप्य बभाषे सूनृतं वचः ।\nविष्णुरुवाच ।\nन खेदं कुरु मे भक्त वरस्त्वं नात्र संशयः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001093027, "chapter_id": 21093, "verse_number": "२-१-४-२८", "content_sanskrit": "शृणु तात प्रवक्ष्यामि सुहितं तव निश्चयात्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001093028, "chapter_id": 21093, "verse_number": "२-१-४-२९", "content_sanskrit": "निरयस्ते न भविता शिवश्शं ते विधास्यति॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001093029, "chapter_id": 21093, "verse_number": "२-१-४-३०", "content_sanskrit": "यदकार्षीश्शिववचो वितथं मदमोहितः ।\nस दत्तवानीदृशं ते फलं कर्म फलप्रदः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001093030, "chapter_id": 21093, "verse_number": "२-१-४-३१", "content_sanskrit": "शिवेच्छाऽखिलं जातं कुर्वित्थं निश्चितां मतिम् ।\nगर्वापहर्ता स स्वामी शंकरः परमेश्वरः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001093031, "chapter_id": 21093, "verse_number": "२-१-४-३२", "content_sanskrit": "परं ब्रह्म परात्मा स सच्चिदानंदबोधनः ।\nनिर्गुणो निर्विकारो च रजस्सत्वतमःपर॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001093032, "chapter_id": 21093, "verse_number": "२-१-४-३३", "content_sanskrit": "स एवमादाय मायां स्वां त्रिधा भवति रूपतः ।\nब्रह्मविष्णुमहेशात्मा निर्गुणोऽनिर्गुणोऽपि सः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001093033, "chapter_id": 21093, "verse_number": "२-१-४-३४", "content_sanskrit": "निर्गुणत्वे शिवाह्वो हि परमात्मा महेश्वरः ।\nपरं ब्रह्माव्ययोऽनंतो महादेवेति गीयते॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001093034, "chapter_id": 21093, "verse_number": "२-१-४-३५", "content_sanskrit": "तत्सेवया विधिस्स्रष्टा पालको जगतामहम् ।\nस्वयं सर्वस्य संहारी रुद्ररूपेण सर्वदा॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001093035, "chapter_id": 21093, "verse_number": "२-१-४-३६", "content_sanskrit": "साक्षी शिवस्वरूपेण मायाभिन्नस्स निर्गुणः ।\nस्वेच्छाचारी संविहारी भक्तानुग्रहकारकः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001093036, "chapter_id": 21093, "verse_number": "२-१-४-३७", "content_sanskrit": "शृणु त्वं नारद मुने सदुपायं सुखप्रदम् ।\nसर्वपापापहर्त्तारं भुक्तिमुक्तिप्रदं सदा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001093037, "chapter_id": 21093, "verse_number": "२-१-४-३८", "content_sanskrit": "इत्युक्त्वास्त्वसंशयं सर्वं शंकरसद्यशः ।\nशतनामशिवस्तोत्रं सदानन्यमतिर्जप॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001093038, "chapter_id": 21093, "verse_number": "२-१-४-३९", "content_sanskrit": "यज्जपित्वा द्रुतं सर्वं तव पापं विनश्यति ।\nइत्युक्त्वा नारदं विष्णुः पुनः प्राह दयान्वितः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001093039, "chapter_id": 21093, "verse_number": "२-१-४-४०", "content_sanskrit": "मुने न कुरु शोकं त्वं त्वया किंचित्कृतं नहि ।\nस्वेच्छया कृतवान्शंभुरिदं सर्वं न संशयः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001093040, "chapter_id": 21093, "verse_number": "२-१-४-४१", "content_sanskrit": "अहार्षित्त्वन्मतिं दिव्यां काम क्लेशमदात्स ते ।\nत्वन्मुखाद्दापयांचक्रे शापं मे स महेश्वरः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001093041, "chapter_id": 21093, "verse_number": "२-१-४-४२", "content_sanskrit": "इत्थं स्वचरितं लोके प्रकटीकृतवान् स्वयम् ।\nमृत्युंजयः कालकालो भक्तोद्धारपरायणः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001093042, "chapter_id": 21093, "verse_number": "२-१-४-४३", "content_sanskrit": "न मे शिवसमानोस्ति प्रियः स्वामी सुखप्रदः ।\nसर्वशक्तिप्रदो मेऽस्ति स एव परमेश्वरः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001093043, "chapter_id": 21093, "verse_number": "२-१-४-४४", "content_sanskrit": "तस्योपास्यां कुरु मुने तमेव सततं भज ।\nतद्यशः शृणु गाय त्वं कुरु नित्यं तदर्चनम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001093044, "chapter_id": 21093, "verse_number": "२-१-४-४५", "content_sanskrit": "कायेन मनसा वाचा यश्शंकरमुपैति भो ।\nस पण्डित इति ज्ञेयस्स जीवन्मुक्त उच्यते॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001093045, "chapter_id": 21093, "verse_number": "२-१-४-४६", "content_sanskrit": "शिवेति नामदावाग्नेर्महापातकप र्वताः ।\nभस्मीभवन्त्यनायासात्सत्यं सत्यं न संशयः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001093046, "chapter_id": 21093, "verse_number": "२-१-४-४७", "content_sanskrit": "पापमूलानि दुःखानि विविधान्यपि तान्यतः ।\nशिवार्चनैकनश्यानि नान्य नश्यानि सर्वथा॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001093047, "chapter_id": 21093, "verse_number": "२-१-४-४८", "content_sanskrit": "स वैदिकस्य पुण्यात्मा स धन्यस्स बुधो मुने ।\nयस्सदा कायवाक्चित्तैश्शरणं याति शंकरम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001093048, "chapter_id": 21093, "verse_number": "२-१-४-४९", "content_sanskrit": "भवंति विविधा धर्मा येषां सद्यःफलोन्मुखाः ।\nतेषां भवति विश्वासस्त्रिपुरांतकपूजने॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001093049, "chapter_id": 21093, "verse_number": "२-१-४-५०", "content_sanskrit": "पातकानि विनश्यंति यावंति शिवपूजया ।\nभुवि तावंति पापानि न संत्येव महामुने॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001093050, "chapter_id": 21093, "verse_number": "२-१-४-५१", "content_sanskrit": "ब्रह्महत्यादिपापानां राशयोप्यमिता मुने ।\nशिवस्मृत्या विनश्यंति सत्यंसत्यं वदाम्यहम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001093051, "chapter_id": 21093, "verse_number": "२-१-४-५२", "content_sanskrit": "शिवनामतरीं प्राप्य संसाराब्धिं तरंति ते ।\nसंसारमूलपापानि तस्य नश्यंत्यसंशयम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001093052, "chapter_id": 21093, "verse_number": "२-१-४-५३", "content_sanskrit": "संसारमूलभूतानां पातकानां महामुने ।\nशिवनामकुठारेण विनाशो जायते ध्रुवम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001093053, "chapter_id": 21093, "verse_number": "२-१-४-५४", "content_sanskrit": "शिवनामामृतं पेयं पापदावानलार्दितैः ।\nपापदावाग्नितप्तानां शांतिस्तेन विना न हि॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001093054, "chapter_id": 21093, "verse_number": "२-१-४-५५", "content_sanskrit": "शिवेति नामपीयूषवर्षधारापरिप्लुतः ।\nसंसारदवमध्यपि न शोचति न संशयः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001093055, "chapter_id": 21093, "verse_number": "२-१-४-५६", "content_sanskrit": "न भक्तिश्शंकरे पुंसां रागद्वेषरतात्मनाम् ।\nतद्विधानां हि सहसा मुक्तिर्भवति सर्वथा॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001093056, "chapter_id": 21093, "verse_number": "२-१-४-५७", "content_sanskrit": "अनंतजन्मभिर्येन तपस्तप्तं भविष्यति ।\nतस्यैव भक्तिर्भवति भवानी प्राणवल्लभे॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001093057, "chapter_id": 21093, "verse_number": "२-१-४-५८", "content_sanskrit": "जातापि शंकरे भक्तिरन्यसाधारणी वृथा ।\nपरं त्वव्यभिचारेण शिवभक्तिरपेक्षिता॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001093058, "chapter_id": 21093, "verse_number": "२-१-४-५९", "content_sanskrit": "यस्या साधारणी शंभौ भक्तिरव्यभिचारिणी ।\nतस्यैव मोक्षस्सुलभो नास्येतिन्य मतिर्मम॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001093059, "chapter_id": 21093, "verse_number": "२-१-४-६०", "content_sanskrit": "कृत्वाप्यनंतपापानि यदि भक्तिर्महेश्वरे ।\nसर्वपापविनिर्मुक्तो भवत्येव न संशयः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001093060, "chapter_id": 21093, "verse_number": "२-१-४-६१", "content_sanskrit": "भवंति भस्मसाद्वृक्षादवदग्धा यथा वने ।\nतथा भवंति दग्धानि शांकराणामघान्यपि॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001093061, "chapter_id": 21093, "verse_number": "२-१-४-६२", "content_sanskrit": "यो नित्यं भस्मपूतांगो शिवपूजोन्मुखो भवेत् ।\nस तरत्येव संसारमपारमतिदारुणम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001093062, "chapter_id": 21093, "verse_number": "२-१-४-६३", "content_sanskrit": "ब्रह्मस्वहरणं कृत्वा हत्वापि ब्राह्मणान्बहून् ।\nलिप्यते नरः पापैर्विरूपाक्षस्य सेवकः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001093063, "chapter_id": 21093, "verse_number": "२-१-४-६४", "content_sanskrit": "विलोक्य वेदानखिलाञ्छिवस्यैवार्चनम्परम् ।\nसंसारनाशनोपाय इति पूर्वैर्विनिश्चितम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001093064, "chapter_id": 21093, "verse_number": "२-१-४-६५", "content_sanskrit": "अद्यप्रभृति यत्नेन सावधानो यथाविधि ।\nसाम्बं सदाशिवं भक्त्या भज नित्यं महेश्वरम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001093065, "chapter_id": 21093, "verse_number": "२-१-४-६६", "content_sanskrit": "आपादमस्तकं सम्यक् भस्मनोद्धूल्य सादरम् ।\nसर्वश्रुतिश्रुतं शैवम्मंत्रञ्जप षडक्षरम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001093066, "chapter_id": 21093, "verse_number": "२-१-४-६७", "content_sanskrit": "सवार्ङ्गेषु प्रयत्नेन रुद्राक्षाञ्छिववल्लभान् ।\nधारयस्वातिसद्भक्त्या समन्त्रम्विधिपूर्वकम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001093067, "chapter_id": 21093, "verse_number": "२-१-४-६८", "content_sanskrit": "शृणु शैवीं कथां नित्यं वद शैवीं कथां सदा ।\nपूजयस्वातियत्नेन शिवभक्तान्पुनः पुनः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001093068, "chapter_id": 21093, "verse_number": "२-१-४-६९", "content_sanskrit": "अप्रमादेन सततं शिवैकशरणो भव ।\nशिवार्चनेन सततमानन्दः प्राप्यते यतः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001093069, "chapter_id": 21093, "verse_number": "२-१-४-७०", "content_sanskrit": "उरस्याधाय विशदे शिवस्य चरणाम्बुजौ ।\nशिवतीर्थानि विचर प्रथमं मुनिसत्तम॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001093070, "chapter_id": 21093, "verse_number": "२-१-४-७१", "content_sanskrit": "पश्यन्माहात्म्यमतुलं शंकरस्य परात्मनः ।\nगच्छानन्दवनं पश्चाच्छंभुप्रियतमं मुने॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001093071, "chapter_id": 21093, "verse_number": "२-१-४-७२", "content_sanskrit": "तत्र विश्वेश्वरं दृष्ट्वा पूजनं कुरु भक्तितः ।\nनत्वा स्तुत्वा विशेषेण निर्विकल्पो भविष्यसि॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001093072, "chapter_id": 21093, "verse_number": "२-१-४-७३", "content_sanskrit": "ततश्च भवता नूनं विधेयं गमनं मुने ।\nब्रह्मलोके स्वकामार्थं शासनान्मम भक्तितः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001093073, "chapter_id": 21093, "verse_number": "२-१-४-७४", "content_sanskrit": "नत्वा स्तुत्वा विशेषेण विधिं स्वजनकं मुने ।\nप्रष्टव्यं शिवमाहात्म्यं बहुशः प्रीतचेतसा॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001093074, "chapter_id": 21093, "verse_number": "२-१-४-७५", "content_sanskrit": "स शैवप्रवरो ब्रह्मा माहात्म्यं शंकरस्य ते ।\nश्रावयिष्यति सुप्रीत्या शतनामस्तवं च हि॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001093075, "chapter_id": 21093, "verse_number": "२-१-४-७६", "content_sanskrit": "अद्यतस्त्वं भव मुने शैवश्शिवपरायणः ।\nमुक्तिभागी विशेषेण शिवस्ते शं विधास्यति॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001093076, "chapter_id": 21093, "verse_number": "२-१-४-७७", "content_sanskrit": "इत्थं विष्णुर्मुनिं प्रीत्या ह्युपदिश्य प्रसन्नधीः ।\nस्मृत्वा नुत्वा शिवं स्तुत्वा ततस्त्वंतरधीयत॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]