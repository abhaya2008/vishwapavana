[{"id": 7000885000, "chapter_id": 20885, "verse_number": "६-२२८-१", "content_sanskrit": "श्रीमहादेव उवाच ।\nत्रिपाद्विभूतेर्लोकास्तु असंख्याताः प्रकीर्तिताः ।\nशुद्धसत्वमयाः सर्वे ब्रह्मानंदसुखाह्वयाः ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000885001, "chapter_id": 20885, "verse_number": "६-२२८-२", "content_sanskrit": "सर्वे नित्या निर्विकारा हेयरागादिवर्जिताः ।\nसर्वे हिरण्मयाश्शुद्धाः कोटिसूर्य्यसमप्रभाः ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000885002, "chapter_id": 20885, "verse_number": "६-२२८-३", "content_sanskrit": "सर्वे वेदमयार्दिव्याः काम क्रोधविवर्जिताः ।\nनारायणपदांभोज भक्त्येकरससेविताः ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000885003, "chapter_id": 20885, "verse_number": "६-२२८-४", "content_sanskrit": "निरंतरं सामगानपरिपूर्णसुखं श्रिताः ।\nसर्वे पंचोपनिषद स्वरूपा वेदवर्चसः ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000885004, "chapter_id": 20885, "verse_number": "६-२२८-५", "content_sanskrit": "सर्वे वेदमयैर्दिव्यैःपुरुषैः स्त्रीभिरावृताः ।\nवेदैकरसतोयाढ्यैस्सरोभिरुपशोभिताः ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000885005, "chapter_id": 20885, "verse_number": "६-२२८-६", "content_sanskrit": "श्रुतिस्मृतिपुराणादि रूपस्थावरसंयुताः ।\nसर्वं वर्णयितुं शक्यं न मया लोकविस्तृतम् ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000885006, "chapter_id": 20885, "verse_number": "६-२२८-७", "content_sanskrit": "विरजा परमव्योम्नोरंतरंकेवलं स्मृतम् ।\nतत्स्थानमुपभोक्तव्यमव्यक्तब्रह्मसेविनाम् ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000885007, "chapter_id": 20885, "verse_number": "६-२२८-८", "content_sanskrit": "स्वात्मानुभवजानंदसुखदं केवलं पदम् ।\nनिःश्रेयसं च निर्वाणं कैवल्यं मोक्ष उच्यते ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000885008, "chapter_id": 20885, "verse_number": "६-२२८-९", "content_sanskrit": "श्रीशांघ्रिभक्तिसेवैकरसभोगविवर्धिताः तम् ।\nतदिच्छन्त्यल्पमतयो मोक्षं सुखविवर्जितम् ।\nमहात्मानो महाभागा भगवत्पादसेवकाः ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000885009, "chapter_id": 20885, "verse_number": "६-२२८-१०", "content_sanskrit": "तद्विष्णोः परमं धाम यांति ब्रह्मसुखप्रदम् ।\nनानाजनपदाकीर्णं वैकुंठं तद्धरेः पदम् ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000885010, "chapter_id": 20885, "verse_number": "६-२२८-११", "content_sanskrit": "प्राकारैश्च विमानैश्च सौधैरत्नमयैर्वृतम् ।\nतन्मध्ये नगरी दिव्या साऽयोध्येति प्रकीर्तिता ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000885011, "chapter_id": 20885, "verse_number": "६-२२८-१२", "content_sanskrit": "मणिकांचनचित्राढ्य प्राकारैस्तोरणैर्वृता ।\nचतुर्द्वारसमायुक्ता रत्नगोपुरसंवृता ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000885012, "chapter_id": 20885, "verse_number": "६-२२८-१३", "content_sanskrit": "चंडादिद्वारपालैश्च कुमुदाद्यैश्च रक्षिता ।\nचंडप्रचंडौ प्राग्द्वार याम्ये भद्रसुभद्रकौ ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000885013, "chapter_id": 20885, "verse_number": "६-२२८-१४", "content_sanskrit": "वारुण्यां जयविजयौ सौम्ये धातृविधातरौ ।\nकुमुदः कुमुदाक्षश्च पुंडरीकोऽथ वामनः ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000885014, "chapter_id": 20885, "verse_number": "६-२२८-१५", "content_sanskrit": "शंकुकर्णः सर्वनेत्रः सुमुखः सुप्रतिष्ठितः ।\nएते दिक्पतयः प्रोक्ताः पुर्य्यामत्र शुभानने ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000885015, "chapter_id": 20885, "verse_number": "६-२२८-१६", "content_sanskrit": "कोटिवैश्वानरप्रख्य गृहपंक्तिभिरावृता ।\nआरूढयौवनैर्नित्यैर्दिव्यनारीनरैर्युता ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000885016, "chapter_id": 20885, "verse_number": "६-२२८-१७", "content_sanskrit": "अन्तःपुरं तु देवस्य मध्ये पुर्याम्मनोहरम् ।\nमणिप्राकारसंयुक्तं रत्नतोरणशोभितम् ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000885017, "chapter_id": 20885, "verse_number": "६-२२८-१८", "content_sanskrit": "विमानैर्गृहमुख्यैश्च प्रासादैर्बहुभिर्युतम् ।\nदिव्याप्सरोगणैः स्त्रीभिस्सर्वतस्समलंकृतम् ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000885018, "chapter_id": 20885, "verse_number": "६-२२८-१९", "content_sanskrit": "मध्ये तु मंडपं दिव्यं राजस्थानं महोच्छ्रयम् ।\nमाणिक्यस्तंभसाहस्रजुष्टं रत्नमयं शुभम् ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000885019, "chapter_id": 20885, "verse_number": "६-२२८-२०", "content_sanskrit": "दिव्यैर्मुक्तैः समाकीर्णं सामगानोपशोभितम् ।\nमध्ये सिंहासनं रम्यं सर्ववेदमयं शुभम् ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000885020, "chapter_id": 20885, "verse_number": "६-२२८-२१", "content_sanskrit": "धर्मादिदैवतैर्नित्यैर्वृंतवैदमयात्मकैः ।\nधर्म्मज्ञानमहैश्वर्यवैराग्यैः पादविग्रहैः ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000885021, "chapter_id": 20885, "verse_number": "६-२२८-२२", "content_sanskrit": "ऋग्यजुःसामचाथर्वैरूपैर्नित्यं वृतं क्रमात् ।\nशक्तिराधारशक्तिश्च चिच्छक्तिश्च सदाशिवा ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000885022, "chapter_id": 20885, "verse_number": "६-२२८-२३", "content_sanskrit": "धर्मादिदेवतानां च शक्तयः परिकीर्तिताः ।\nवसंति मध्यमे तत्र वह्निसूर्यसुधांशवः ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000885023, "chapter_id": 20885, "verse_number": "६-२२८-२४", "content_sanskrit": "कूर्मश्च नागराजश्च वैनतेयस्त्रयीश्वरः ।\nछंदासि सर्वमंत्राश्च पीठरूपत्वमास्थिताः ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000885024, "chapter_id": 20885, "verse_number": "६-२२८-२५", "content_sanskrit": "सर्वाक्षरमयं दिव्यं योगपीठमिति स्मृतम् ।\nतन्मध्येऽष्टदलं पद्ममुदयार्कसमप्रभम् ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000885025, "chapter_id": 20885, "verse_number": "६-२२८-२६", "content_sanskrit": "तन्मध्ये कर्णिकायां तु सावित्र्यां शुभदर्शने ।\nईश्वर्य्या सह देवेशस्तत्रासीनः परः पुमान् ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000885026, "chapter_id": 20885, "verse_number": "६-२२८-२७", "content_sanskrit": "इंदीवरदलश्यामः कोटिसूर्यप्रकाशवान् ।\nयुवाकुमारः स्निग्धश्च कोमलावयवैर्वृतः ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000885027, "chapter_id": 20885, "verse_number": "६-२२८-२८", "content_sanskrit": "फुल्लरक्तांबुजनिभः कोमलांघ्रिसरोजवान् ।\nप्रबुद्धः पुंडरीकाक्षः सुभ्रू लतायुगाङ्कितः ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000885028, "chapter_id": 20885, "verse_number": "६-२२८-२९", "content_sanskrit": "सुनासस्सुकपोलाढ्यस्सुश्रोत्रमुखपंकजः ।\nमुक्ताफलाभदन्ताढ्यः सस्मिताधरविद्रुमः ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000885029, "chapter_id": 20885, "verse_number": "६-२२८-३०", "content_sanskrit": "परिपूर्णेदुसंकाशः सुस्मिताननपंकजः ।\nतरुणादित्यवर्णाभ्यां कुंडलाभ्यां विराजितः ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000885030, "chapter_id": 20885, "verse_number": "६-२२८-३१", "content_sanskrit": "सस्निग्धनीलकुटिलकुन्तलैरुपशोभितः ।\nमन्दारपारिजाताढ्य कबरीकृतकेशवान् ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000885031, "chapter_id": 20885, "verse_number": "६-२२८-३२", "content_sanskrit": "प्रातरुद्यत्सहस्रांशुनिभकौस्तुभशोभितः ।\nहारस्वर्णस्रगासक्त कम्बुग्रीवो विराजितः ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000885032, "chapter_id": 20885, "verse_number": "६-२२८-३३", "content_sanskrit": "सिंहस्कंधनिभैः प्रोच्चैः पीनैरंसैर्विराजितः ।\nपीनवृत्तायतभुजैश्चतुर्भिरुपशोभितः ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000885033, "chapter_id": 20885, "verse_number": "६-२२८-३४", "content_sanskrit": "अङ्गुलीयैश्च कटकैः केयूरैः परिमण्डितः ।\nबालार्ककोटिसंकाशैः कौस्तुभाद्यैः सुभूषणैः ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000885034, "chapter_id": 20885, "verse_number": "६-२२८-३५", "content_sanskrit": "विराजितमहावक्षो वनमालाविभूषितः ।\nविधातृजननस्थान नाभिपङ्कजशोभितः ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000885035, "chapter_id": 20885, "verse_number": "६-२२८-३६", "content_sanskrit": "बालातपनिभश्लक्ष्ण पीतवस्त्रसमन्वितः ।\nनानारत्नविचित्रांघ्रिः कटकाभ्यां विराजितः ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000885036, "chapter_id": 20885, "verse_number": "६-२२८-३७", "content_sanskrit": "सज्योत्स्नचंद्रप्रतिम नखपंक्तिसमन्वितः ।\nकोटिकंदर्पलावण्य सौंदर्य्यनिधिरच्युतः ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000885037, "chapter_id": 20885, "verse_number": "६-२२८-३८", "content_sanskrit": "दिव्यचंदनलिप्तांगो दिव्यमालाविभूषितः ।\nगृहीतशंखचक्राभ्यामुद्बाहुभ्यां विराजितः ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000885038, "chapter_id": 20885, "verse_number": "६-२२८-३९", "content_sanskrit": "वरदाभयहस्ताभ्यामितराभ्यां तथैव च ।\nवामाङ्के संस्थिता देवी महालक्ष्मीर्महेश्वरी ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000885039, "chapter_id": 20885, "verse_number": "६-२२८-४०", "content_sanskrit": "हिरण्यवर्णा हरिणी सुवर्णरजतस्रजा ।\nसर्वलक्षणसंपन्ना यौवनारंभविग्रहा ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000885040, "chapter_id": 20885, "verse_number": "६-२२८-४१", "content_sanskrit": "रत्नकुंडलसंयुक्ता नीला कुंचितशीर्षजा ।\nदिव्यचंदनलिप्तांगी दिव्यपुष्पोपशोभिता ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000885041, "chapter_id": 20885, "verse_number": "६-२२८-४२", "content_sanskrit": "मंदारकेतकी जाती पुष्पाञ्चितसुकुंतला ।\nसुभ्रूस्सुनासा सुश्रोणी पीनोन्नतपयोधरा ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000885042, "chapter_id": 20885, "verse_number": "६-२२८-४३", "content_sanskrit": "परिपूंर्णेंदुसंकाशा सुस्मिताननपंकजा ।\nतरुणादित्यवर्णाभ्यां कुंडलाभ्यां विराजिता ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000885043, "chapter_id": 20885, "verse_number": "६-२२८-४४", "content_sanskrit": "तप्तकांचनवर्णाभा तप्तकांचनभूषणा ।\nहस्तैश्चतुर्भिः संयुक्ता कनकांबुजभूषिता ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000885044, "chapter_id": 20885, "verse_number": "६-२२८-४५", "content_sanskrit": "नानाविचित्ररत्नाढ्या कनकांबुजमालया ।\nहारकेयूरकटकैरंगुलीयैश्च शोभिता ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000885045, "chapter_id": 20885, "verse_number": "६-२२८-४६", "content_sanskrit": "भुजद्वयघृतोदग्र पद्मयुग्मोपशोभिता ।\nगृहीतमातुलुंगाख्य जांबूनदकराञ्चिता ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000885046, "chapter_id": 20885, "verse_number": "६-२२८-४७", "content_sanskrit": "एवं नित्यानपायिन्या महालक्ष्म्या महेश्वरः ।\nमोदते परमे व्योम्नि शाश्वते सर्वदा प्रभुः ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000885047, "chapter_id": 20885, "verse_number": "६-२२८-४८", "content_sanskrit": "पार्श्वयोर्धरणी नीले समासीने शुभासने ।\nअष्टदिक्षु दलाग्रेषु विमलाद्याश्च शक्तयः ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000885048, "chapter_id": 20885, "verse_number": "६-२२८-४९", "content_sanskrit": "विमलोत्कर्षिणी ज्ञानाक्रियायोगा तथैव च ।\nप्रह्वी सत्या तथेशाना शक्तयः परमात्मनः ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000885049, "chapter_id": 20885, "verse_number": "६-२२८-५०", "content_sanskrit": "गृहीत्वा चामरान्दिव्यान्सुधाकरसमप्रभान् ।\nसर्वलक्षणसंपन्ना मोदंते पतिमच्युतम् ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000885050, "chapter_id": 20885, "verse_number": "६-२२८-५१", "content_sanskrit": "दिव्याप्सरोगणाः पंच शतसंख्याश्च योषितः ।\nअंतःपुरनिवासिन्यः सर्वाभरणभूषिताः ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000885051, "chapter_id": 20885, "verse_number": "६-२२८-५२", "content_sanskrit": "पद्महस्ताश्च ताः सर्वाः कोटिवैश्वानरप्रभाः ।\nसर्वलक्षणसंपन्नाः शीतांशुसदृशाननाः ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000885052, "chapter_id": 20885, "verse_number": "६-२२८-५३", "content_sanskrit": "ताभिः परिवृतो राजा शुशुभे परमः पुमान् ।\nअनंतविहगाधीश सेनान्याद्यैस्सुरेश्वरे ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000885053, "chapter_id": 20885, "verse_number": "६-२२८-५४", "content_sanskrit": "अन्यैः परिजनैर्नित्यैर्मुक्तैश्च परिसंवृतः ।\nमोदते रमया सार्द्धं भोगैश्वर्यरतः पुमान् ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000885054, "chapter_id": 20885, "verse_number": "६-२२८-५५", "content_sanskrit": "एवं वैकुंठनाथोऽसौ राजते परमे पदे ।\nतद्व्यूहभेदांल्लोकांश्च वक्ष्यामि गिरिजे शुभे ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000885055, "chapter_id": 20885, "verse_number": "६-२२८-५६", "content_sanskrit": "प्राच्यां वैकुंठलोकस्य वासुदेवस्य मंदिरम् ।\nआग्नेय्यां लक्ष्म्यालोकस्तु याम्यां संकर्षणालयः ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000885056, "chapter_id": 20885, "verse_number": "६-२२८-५७", "content_sanskrit": "सारस्वतस्तु नैरृत्या प्राद्युम्नः पश्चिमे तथा ।\nरतिलोकस्तु वायव्यामुदीच्यामनिरुद्धभूः ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000885057, "chapter_id": 20885, "verse_number": "६-२२८-५८", "content_sanskrit": "ऐशान्यां शांतिलोकः स्यात्प्रथमावरणं स्मृतम् ।\nकेशवादिचतुर्विंशत्यमी लोकास्ततः क्रमात् ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000885058, "chapter_id": 20885, "verse_number": "६-२२८-५९", "content_sanskrit": "द्वितीयावरणं प्रोक्तं वैकुंठस्य शुभाह्वयम् ।\nमत्स्यकूर्मादिलोकास्तु तृतीयावरणं शुभम् ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000885059, "chapter_id": 20885, "verse_number": "६-२२८-६०", "content_sanskrit": "सत्याच्युतानंत दुर्गा विष्वक्सेन गजाननाः ।\nशंखपद्मनिधीलोकाश्चतुर्थावरणं शुभम् ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000885060, "chapter_id": 20885, "verse_number": "६-२२८-६१", "content_sanskrit": "ऋग्यजुः सामाथर्वाणो लोका दिक्षु महत्सु च ।\nसावित्र्या विहगेशस्य धर्मस्य च मखस्य च ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000885061, "chapter_id": 20885, "verse_number": "६-२२८-६२", "content_sanskrit": "पंचमावरणं प्रोक्तमक्षयं सर्ववाङ्मयम् ।\nशंखचक्रगदापद्मखड्गशार्ङ्गहलं तथा ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000885062, "chapter_id": 20885, "verse_number": "६-२२८-६३", "content_sanskrit": "मौशलं च तथा लोकाः सर्वशस्त्रास्त्रसंयुताः ।\nषष्ठमावरणं प्रोक्तं मंत्रास्त्रमयमक्षरम् ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000885063, "chapter_id": 20885, "verse_number": "६-२२८-६४", "content_sanskrit": "ऐंद्र पावकयाम्यानि नैरृतं वारुणं तथा ।\nवायव्यं सौम्यमैशानं सप्तमं मुनिभिः स्मृतम् ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000885064, "chapter_id": 20885, "verse_number": "६-२२८-६५", "content_sanskrit": "साध्या मरुद्गणाश्चैव विश्वेदेवास्तथैव च ।\nनित्याः सर्वे परे धाम्नि ये चान्ये च दिवौकसः ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000885065, "chapter_id": 20885, "verse_number": "६-२२८-६६", "content_sanskrit": "ते वै प्राकृतलोकेस्मिन्न नित्यास्त्रिदशेश्वराः ।\nते ह नाकं महिमानः सचंत इति वै श्रुतिः ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000885066, "chapter_id": 20885, "verse_number": "६-२२८-६७", "content_sanskrit": "एवं परं पदं नित्यैर्मुक्तैर्भोगपरायणैः ।\nदिव्याभिर्महिषीभिश्च राजते विभुरीश्वरः ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000885067, "chapter_id": 20885, "verse_number": "६-२२८-६८", "content_sanskrit": "न तद्भासयते सूर्यो न शंशांको न पावकः ।\nयद्गत्वा न निवर्त्तंते योगिनः संशितव्रताः ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000885068, "chapter_id": 20885, "verse_number": "६-२२८-६९", "content_sanskrit": "द्वयैकमंत्रनिष्ठा ये ते वै यांति तदव्ययम् ।\nन वेदयज्ञाध्ययनैर्न दानैर्न व्रतैः शुभैः ॥६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000885069, "chapter_id": 20885, "verse_number": "६-२२८-७०", "content_sanskrit": "न तपोभिर्निराहारैर्न च साधनकर्मभिः ।\nएकेन द्वयमंत्रेण तथा भक्त्या त्वनन्यथा ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000885070, "chapter_id": 20885, "verse_number": "६-२२८-७१", "content_sanskrit": "तद्गम्यं शाश्वतं स्थानं प्रपत्त्या वै सनातनम् ।\nपार्वत्युवाच ।\nसाधूक्तं परमं स्वर्गस्वरूपं भवता प्रभो ॥७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000885071, "chapter_id": 20885, "verse_number": "६-२२८-७२", "content_sanskrit": "परव्योम्नि स्थितो नित्यं कथं प्रकृतिमण्डले ।\nस्थितवान्किं निमित्तेन लीलया किं प्रयोजनम् ॥७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000885072, "chapter_id": 20885, "verse_number": "६-२२८-७३", "content_sanskrit": "शुद्धसत्वमये लोके संस्थितः परमेश्वरः ।\nकथं रजस्तमोमिश्र विभूत्या स्थिवान्प्रभुः ॥७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000885073, "chapter_id": 20885, "verse_number": "६-२२८-७४", "content_sanskrit": "रुद्र उवाच ।\nत्रिपाद्विभूतौ भगवानीश्वर्य्या परमेश्वरः ।\nनित्यमुक्त्यैकभोग्योऽसौ मोदते सततं विभुः ॥७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000885074, "chapter_id": 20885, "verse_number": "६-२२८-७५", "content_sanskrit": "तमीश्वरं महामाया प्रकृतिर्जगदाश्रया ।\nकृतांजलिपुटा भूत्वा तुष्टाव परमेश्वरम् ॥७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000885075, "chapter_id": 20885, "verse_number": "६-२२८-७६", "content_sanskrit": "महामायोवाच ।\nनमस्ते त्रिजगद्धाम्ने नमस्ते विश्वरूपिणे ।\nपुराणाय नमस्तुभ्यं जगदुत्पत्तिहेतवे ॥७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000885076, "chapter_id": 20885, "verse_number": "६-२२८-७७", "content_sanskrit": "श्रीभूलीलाधिपतये नमो नारायणाय च ।\nनमो भगवते तुभ्यं वासुदेवाय शार्ङ्गिणे ॥७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000885077, "chapter_id": 20885, "verse_number": "६-२२८-७८", "content_sanskrit": "सर्वदेवस्वरूपाय विष्णवे जिष्णवे नमः ।\nसहस्रमूर्तये तुभ्यमनंताय नमोस्तु ते ॥७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000885078, "chapter_id": 20885, "verse_number": "६-२२८-७९", "content_sanskrit": "अच्युताय विकाराय शुद्धसत्त्वस्वरूपिणे ।\nअदिमध्यांतरहित स्वरूपाय नमो नमः ॥७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000885079, "chapter_id": 20885, "verse_number": "६-२२८-८०", "content_sanskrit": "नमो हिरण्यगर्भाय ज्ञानाय परमात्मने ।\nसर्वभूतात्मने तुभ्यं सर्वभूताश्रयाय च ॥८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000885080, "chapter_id": 20885, "verse_number": "६-२२८-८१", "content_sanskrit": "ब्रह्मणे ज्योतिषे तुभ्यं नमस्ते विश्वरूपिणे ।\nनमः शुचिषदे तुभ्यं हंसाय परमाय च ॥८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000885081, "chapter_id": 20885, "verse_number": "६-२२८-८२", "content_sanskrit": "संकर्षणाय रुद्राय सर्वभूतधराय च ।\nहयग्रीवाय दीप्ताय कालाय हरये नमः ।\nनमस्ते यज्ञपुरुष हव्यकव्यस्वरूपिणे ॥८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000885082, "chapter_id": 20885, "verse_number": "६-२२८-८३", "content_sanskrit": "नमः प्रजापतये तस्मै सूर्याय शुभवर्चसे ।\nअग्नये हव्यभोक्त्रे च तस्मै यज्ञात्मने नमः ॥८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000885083, "chapter_id": 20885, "verse_number": "६-२२८-८४", "content_sanskrit": "नमस्ते प्रसवित्रे च सर्गस्थित्यंतहेतवे ।\nनमो वेदांतवेद्याय चतुरात्मस्वरूपिणे ॥८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000885084, "chapter_id": 20885, "verse_number": "६-२२८-८५", "content_sanskrit": "ब्रह्मणे विष्णवे तुभ्यं नमस्ते शंकाराय च ।\nत्रिगुणाय नमस्तुभ्यं सर्गस्थित्यंतहेतवे ॥८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000885085, "chapter_id": 20885, "verse_number": "६-२२८-८६", "content_sanskrit": "निर्गुणाय नमस्तुभ्यं सर्वात्मान्तरवर्तिने ।\nअव्यक्ताय नमस्तस्मै विष्णवे लोकसाक्षिणे ॥८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000885086, "chapter_id": 20885, "verse_number": "६-२२८-८७", "content_sanskrit": "नारायणाय श्रीशाय पूर्णषाड्गुण्यमूर्त्तये ।\nअनंतगुणपूर्णाय नमः सर्वार्थदायिने ॥८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000885087, "chapter_id": 20885, "verse_number": "६-२२८-८८", "content_sanskrit": "नमस्ते वासुदेवाय पंचावस्थस्वरूपिणे ।\nनमः पंचनवव्यूह भेदरूपाय ते नमः ॥८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000885088, "chapter_id": 20885, "verse_number": "६-२२८-८९", "content_sanskrit": "नमो यज्ञवराहाय गोविंदाय नमो नमः ।\nअविकाराय शुद्धाय हेयप्रतिभटाय च ॥८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000885089, "chapter_id": 20885, "verse_number": "६-२२८-९०", "content_sanskrit": "नमो रामाय कृष्णाय नरसिंहाय ते नमः ।\nकेशवाय नमस्तुभ्यं जगतां क्लेशहारिणे ॥९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000885090, "chapter_id": 20885, "verse_number": "६-२२८-९१", "content_sanskrit": "त्वमेव सर्वलोकानामाश्रयः पुरुषोत्तमः ।\nप्रसीद देवदेवेश सर्वलोकहिताय वै ॥९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000885091, "chapter_id": 20885, "verse_number": "६-२२८-९२", "content_sanskrit": "मत्संस्थाश्चेतनास्सर्वे निराधारा निराश्रयाः ।\nहीनदेहा निराकाराः सर्वेन्द्रियविवर्जिताः ॥९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000885092, "chapter_id": 20885, "verse_number": "६-२२८-९३", "content_sanskrit": "सर्वानुष्ठानरहिताः सततं दुःखभोगिनः ।\nतेषां लोकांश्च देहांश्च दातुमर्हसि केशव ॥९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000885093, "chapter_id": 20885, "verse_number": "६-२२८-९४", "content_sanskrit": "लीलाविभूतिं सर्वज्ञ यथापूर्वं प्रकल्पय ।\nचेतनाचेतनं कृत्स्नं जगत्स्थावरजंगमम् ॥९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000885094, "chapter_id": 20885, "verse_number": "६-२२८-९५", "content_sanskrit": "मया संमोहितं पश्य लीलार्थंपरमेश्वर ।\nप्राकृताण्डं मया सार्धं सृजस्व पुरुषोत्तम ॥९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000885095, "chapter_id": 20885, "verse_number": "६-२२८-९६", "content_sanskrit": "धर्म्माधर्म्मौ सुखं दुःखं तस्मिन्निक्षिप्य संसृतौ ।\nमामधिष्ठाय लीलां वै कर्तुमर्हसि मा चिरम् ॥९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000885096, "chapter_id": 20885, "verse_number": "६-२२८-९७", "content_sanskrit": "श्रीमहादेव उवाच ।\nएवमुक्तस्तया देव्या मायया परमेश्वरः ।\nतस्यां निवेश्य मायायां जगत्स्रष्टुं प्रचक्रमे ॥९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000885097, "chapter_id": 20885, "verse_number": "६-२२८-९८", "content_sanskrit": "योऽसौ प्रकृतिपुरुषः प्रोच्यते स इहाच्युतः ।\nस एव भगवान्विष्णुः प्रकृत्यां प्रविवेश ह ॥९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000885098, "chapter_id": 20885, "verse_number": "६-२२८-९९", "content_sanskrit": "असृजत्प्रकृतौ ब्रह्मभूतादिमहदाश्रयम् ।\nमहतः पुरुषादस्मादहंकारोऽभ्यजायत ॥९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000885099, "chapter_id": 20885, "verse_number": "६-२२८-१००", "content_sanskrit": "अहंकारात्तु वै तस्माद्गुणत्रयमजायत ।\nत्रिभ्यो गुणेभ्यस्तन्मात्रामसृजद्विश्वभावनः ॥१०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000885100, "chapter_id": 20885, "verse_number": "६-२२८-१०१", "content_sanskrit": "तन्मात्रेभ्योभ्यजायंत महाभूतानि तत्क्षणात् ।\nओंकारः प्रथमं जातो ब्रह्मणस्त्रिगुणात्मनः ॥१०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000885101, "chapter_id": 20885, "verse_number": "६-२२८-१०२", "content_sanskrit": "आकाशादभवद्वायुर्वायोरग्निरजायत ।\nअग्नेरापः समुद्भूता अद्भ्यश्च पृथिवी मता ॥१०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000885102, "chapter_id": 20885, "verse_number": "६-२२८-१०३", "content_sanskrit": "आकाशादीनि भूतानि सृष्टान्येकोत्तराणि वै ।\nशब्दस्पर्शश्च रूपं च रसो गंधश्च तद्गुणाः ॥१०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000885103, "chapter_id": 20885, "verse_number": "६-२२८-१०४", "content_sanskrit": "एकोत्तरगुणान्सृष्ट्वा तानादाय महाप्रभुः ।\nतेषां विमिश्रणं कृत्वा जगदंडं महत्तरम् ।\nअसृजत्तत्रलान्वै संख्यया ये चतुर्दश ॥१०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000885104, "chapter_id": 20885, "verse_number": "६-२२८-१०५", "content_sanskrit": "ब्रह्मादित्रिदशांस्तस्मिन्नसृजत्पुरुषोत्तमः ।\nदैवतिर्य्यक्तथा मर्त्यं स्थावरं च चतुर्व्विधम् ॥१०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000885105, "chapter_id": 20885, "verse_number": "६-२२८-१०६", "content_sanskrit": "तथा सृष्टो महासर्गन्तेन वै जलजेक्षणे ।\nतत्र कर्मानुरूपेण त्रिदशादिषु योनिषु ॥१०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000885106, "chapter_id": 20885, "verse_number": "६-२२८-१०७", "content_sanskrit": "संस्थिताः प्रकृतौ पूर्व आत्मनः प्रभवंति हि ॥१०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}]