[{"id": 2047988, "chapter_id": 2059, "verse_number": "६-१०८-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2047989, "chapter_id": 2059, "verse_number": "६-१०८-१", "content_sanskrit": "कथं शिखण्डी गाङ्गेयमभ्यवर्तत संयुगे।\nपाण्डवाश्च कथं भीष्मं तन्ममाचक्ष्व सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2047990, "chapter_id": 2059, "verse_number": "६-१०८-२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2047991, "chapter_id": 2059, "verse_number": "६-१०८-२", "content_sanskrit": "ततः प्रभाते विमले सूर्यस्योदयनं प्रति।\nताड्यमानासु भेरीषु मृदङ्गेष्वानकेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2047992, "chapter_id": 2059, "verse_number": "६-१०८-३", "content_sanskrit": "ध्मायमानेषु शङ्खेषु पाण्डरेषु समन्ततः ।\nशिखण्डिनं पुरस्कृत्य निर्याप्ताः पाण्डवा युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2047993, "chapter_id": 2059, "verse_number": "६-१०८-४", "content_sanskrit": "कृत्वा व्यूहं महाराज सर्वशत्रुनिबर्हणम् ।\nशिखण्डी सर्वसैन्यानामग्र आसीद्विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2047994, "chapter_id": 2059, "verse_number": "६-१०८-५", "content_sanskrit": "चक्ररक्षौ ततस्तस्य भीमसेनधनंजयौ ।\nपृष्ठतो द्रौपदेयाश्च सौभद्रश्चैव वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2047995, "chapter_id": 2059, "verse_number": "६-१०८-६", "content_sanskrit": "सात्यकिश्चेकितानश्च तेषां गोप्ता महारथः।\nधृष्टद्युम्नस्ततः पश्चात्पाञ्चालैरभिरक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2047996, "chapter_id": 2059, "verse_number": "६-१०८-७", "content_sanskrit": "ततो युधिष्ठिरो राजा यमाभ्यां सहितः प्रभुः।\nप्रययौ सिंहनादेन नादयन्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2047997, "chapter_id": 2059, "verse_number": "६-१०८-८", "content_sanskrit": "विराटस्तु ततः पश्चात्स्वेन सैन्येन संवृत्तः ।\nद्रुपदश्च महाबाहो ततः पञ्चादुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2047998, "chapter_id": 2059, "verse_number": "६-१०८-९", "content_sanskrit": "केकया भ्रातरः पञ्च धृष्टकेतुश्च वीर्यवान् ।\nजघनं पालयामासुः पाण्डवेयश्च राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2047999, "chapter_id": 2059, "verse_number": "६-१०८-१०", "content_sanskrit": "एवं व्यूह्य महासैन्यं पाण्डवास्तव वाहिनीम् ।\nअभ्यद्रवन्त संग्रामे त्यक्त्वा जीवितमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2048000, "chapter_id": 2059, "verse_number": "६-१०८-११", "content_sanskrit": "तथैव कुरवो राजन्भीष्मं कृत्वा महारथम् ।\nअग्रतः सर्वसैन्यानां प्रययुः पाण्डवान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2048001, "chapter_id": 2059, "verse_number": "६-१०८-१२", "content_sanskrit": "पुत्रैस्तव दुराधर्षो रक्षितः सुमहाबलैः ।\nततो द्रोणो महेष्वासः पुत्रश्चास्य महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2048002, "chapter_id": 2059, "verse_number": "६-१०८-१३", "content_sanskrit": "भगदत्तस्ततः पश्चाद्गजानीकेन संवृतः ।\nकृपश्च कृतवर्मा च भगदत्तमनुव्रतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2048003, "chapter_id": 2059, "verse_number": "६-१०८-१४", "content_sanskrit": "काम्भोजराजो बलवांस्ततः पश्चात्सुदक्षिणः ।\nमागधश्च जयत्सेनः सौबलश्च बृहद्बलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2048004, "chapter_id": 2059, "verse_number": "६-१०८-१५", "content_sanskrit": "तथैवान्ये महेष्वासाः सुशर्मप्रमुखा नृपाः ।\nजघनं पालयामासुस्तव सैन्यस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2048005, "chapter_id": 2059, "verse_number": "६-१०८-१६", "content_sanskrit": "दिवसेदिवसे प्राप्ते भीष्मः शान्तनवो युधि।\nआसुरानकरोद्व्यूहान्पैशाचानथ राक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2048006, "chapter_id": 2059, "verse_number": "६-१०८-१७", "content_sanskrit": "ततः प्रववृते युद्धं तव तेषां च भारत।\nअन्योन्यं निघ्नतां राजन्यमराष्ट्रविवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2048007, "chapter_id": 2059, "verse_number": "६-१०८-१८", "content_sanskrit": "अर्जुनप्रमुखाः पार्थाः पुरस्कृत्य शिखण्डिनम्।\nभीष्मं युद्धेऽभ्यवर्तन्त किरन्तो विविधाञ्शरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2048008, "chapter_id": 2059, "verse_number": "६-१०८-१९", "content_sanskrit": "तत्र भारत भीमेन ताडितास्तावकाः शरैः।\nरुधिरौघपरिक्लिन्नाः परलोकं ययुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2048009, "chapter_id": 2059, "verse_number": "६-१०८-२०", "content_sanskrit": "नकुलः सहदेवश्च सात्यकिश्च महारथः ।\nतव सैनयं समासाद्य पीडयामासुरोजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2048010, "chapter_id": 2059, "verse_number": "६-१०८-२१", "content_sanskrit": "ते वध्यामानाः समरे तावका भरतर्षभ ।\nनाशक्नुवन्वारयितुं पाण्डवानां महद्बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2048011, "chapter_id": 2059, "verse_number": "६-१०८-२२", "content_sanskrit": "ततस्तु तावकं सैन्यं वध्यमानं समन्ततः।\nसंप्राद्रवद्दशः दिशः काल्यमानं महारथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2048012, "chapter_id": 2059, "verse_number": "६-१०८-२३", "content_sanskrit": "त्रातारं नाध्यगच्छन्त तावका भरतर्षभ ।\nवध्यमानाः शितैर्बाणैः पाण्डवैः सह सृञ्जयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2048013, "chapter_id": 2059, "verse_number": "६-१०८-२४x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2048014, "chapter_id": 2059, "verse_number": "६-१०८-२४", "content_sanskrit": "पीड्यमानं बलं दृष्ट्वा पार्थैर्भीष्मः पराक्रमी ।\nयदकार्षीद्रणे क्रुद्धस्तन्ममाचक्ष्व सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2048015, "chapter_id": 2059, "verse_number": "६-१०८-२५", "content_sanskrit": "कथं वा पाण्डवा युद्धे प्रत्युद्याताः परंतपाः ।\nनिघ्नन्तो मामकान्वीरांस्तन्ममाचक्ष्व सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2048016, "chapter_id": 2059, "verse_number": "६-१०८-२६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2048017, "chapter_id": 2059, "verse_number": "६-१०८-२६", "content_sanskrit": "आचक्षे ते महाराज यदकार्षीत्पिता तव।\nपीडिते तव पुत्रस्य सैन्ये पाण्डव सृञ्जयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2048018, "chapter_id": 2059, "verse_number": "६-१०८-२७", "content_sanskrit": "प्रंहृष्टमनसः शूराः पाण्डवाः पाण्डुपूर्वज ।\nअभ्यवर्तन्त निघ्नन्तस्तव पुत्रस्य वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2048019, "chapter_id": 2059, "verse_number": "६-१०८-२८", "content_sanskrit": "तं विनाशं मनुष्येन्द्र नरवारणवाजिनाम् ।\nनामृष्यत तदा भीष्मः सैन्यघातं रणे परैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2048020, "chapter_id": 2059, "verse_number": "६-१०८-२९", "content_sanskrit": "स पाणडवान्महेष्वासः पञ्चालांश्चैव सृञ्जयान् ।\nनाराचैर्वत्सदन्तैश्च शितैरञ्जलिकैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2048021, "chapter_id": 2059, "verse_number": "६-१०८-३०", "content_sanskrit": "अभ्यवर्षत दुर्धर्षस्त्यक्त्वा जीवितमात्मनः ।\nस पाण्डवानां प्रवरान्पञ्च राजन्महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2048022, "chapter_id": 2059, "verse_number": "६-१०८-३१", "content_sanskrit": "आत्तशस्त्रो रणे यत्नाद्वारयामास सायकैः ।\nनानाशस्त्रास्त्रवर्षैस्तान्वीर्यामर्षप्रवेरितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2048023, "chapter_id": 2059, "verse_number": "६-१०८-३२", "content_sanskrit": "निजघ्ने समरे क्रुद्धो हस्त्यश्वं चामितं बहु।\nरथिनोऽपातयद्राजन्रथेभ्यः पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2048024, "chapter_id": 2059, "verse_number": "६-१०८-३३", "content_sanskrit": "सादिनश्चाश्वपृष्ठेभ्यः पादातांश्च समागतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2048025, "chapter_id": 2059, "verse_number": "६-१०८-३४", "content_sanskrit": "गजारोहान्गजेभ्यश्च परेषां जयकारिणः ।\nतमेकं समरे भीष्मं त्वरमाणं महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2048026, "chapter_id": 2059, "verse_number": "६-१०८-३५", "content_sanskrit": "पाण्डवाः समवर्तन्त वज्रहस्तमिवासुराः।\nशक्राशनिसमस्पर्शान्विमुञ्चन्निशिताञ्छरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2048027, "chapter_id": 2059, "verse_number": "६-१०८-३६", "content_sanskrit": "दिक्ष्वदृश्यत सर्वासु घोरं सन्धारयन्वपुः।\nमण्डलीभूतमेवास्य नित्यं धनुरदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2048028, "chapter_id": 2059, "verse_number": "६-१०८-३७", "content_sanskrit": "संग्रामे युध्यमानस्य शक्रचापोपमं महत् ॥\nतदृष्ट्वा समरे कर्म पुत्रास्तव विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2048029, "chapter_id": 2059, "verse_number": "६-१०८-३८", "content_sanskrit": "विस्मायं परमं गत्वा पितामहमपूजयन् ।\nपार्था विमनसो भूत्वा प्रैक्षन्त पितरं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2048030, "chapter_id": 2059, "verse_number": "६-१०८-३९", "content_sanskrit": "युध्यमानं रणे शूरं विप्रचित्तिमिवामराः ।\nन चैनं वारयामासुर्व्यात्ताननमिवान्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2048031, "chapter_id": 2059, "verse_number": "६-१०८-४०", "content_sanskrit": "दशमेऽहनि संप्राप्ते रथानीकं शिखण्डिनः ।\nअदहन्निशितैर्बाणैः कृष्णवर्त्मेव काननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2048032, "chapter_id": 2059, "verse_number": "६-१०८-४१", "content_sanskrit": "तं शिखण्डी त्रिभिर्बाणैरभ्यविध्यत्सनान्तरे ।\nआशीविषमिव क्रुद्धं कालसृष्टमिवान्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2048033, "chapter_id": 2059, "verse_number": "६-१०८-४२", "content_sanskrit": "स तेनातिभृशं विद्धः प्रेक्ष्य भीष्मः शिखण्डिनम् ।\nपुनर्नालोकयत्क्रुद्धः प्रहसन्निदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2048034, "chapter_id": 2059, "verse_number": "६-१०८-४३", "content_sanskrit": "कामं प्रहर वा मा वा न त्वां योत्स्ये कथंचन ।\nयैव हि त्वं कृता धात्रा सैव हि त्वं शिखण्डिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2048035, "chapter_id": 2059, "verse_number": "६-१०८-४४", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा शिखण्डी क्रोधमूर्च्छितः ।\nउवाच भीष्मं समरे सृक्विणी परिलेलिहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2048036, "chapter_id": 2059, "verse_number": "६-१०८-४५", "content_sanskrit": "जानामि त्वां महाबाहो क्षत्रियाणां भयंकरम् ।\nमया श्रुतं च ते युद्धं जामदग्न्येन वै सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2048037, "chapter_id": 2059, "verse_number": "६-१०८-४६", "content_sanskrit": "दिव्यश्च ते प्रभावोऽयं मया च बहुशः श्रुतः ।\nजनन्नपि प्रभावं ते योत्स्येऽद्याहं त्वया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2048038, "chapter_id": 2059, "verse_number": "६-१०८-४७", "content_sanskrit": "पाण्डवानां प्रियं कुर्वन्नात्मनश्च नरोत्तम ॥\nअद्य त्वां योधयिष्यामि रणे पुरुषसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2048039, "chapter_id": 2059, "verse_number": "६-१०८-४८", "content_sanskrit": "ध्रुवं च त्वां हनिष्यामि शपे सत्येन तेऽग्रतः ।\nएतच्छ्रुत्वा च मद्वाक्यं यत्कृत्यं तत्समाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2048040, "chapter_id": 2059, "verse_number": "६-१०८-४९", "content_sanskrit": "कामं युध्यस्व वा मा वा न मे जीवन्प्रमोक्ष्यसे ।\nसुदृष्टः क्रियतां भीष्म लोकोऽयं समितिंजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2048041, "chapter_id": 2059, "verse_number": "६-१०८-५०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2048042, "chapter_id": 2059, "verse_number": "६-१०८-५०", "content_sanskrit": "एवमुक्त्वा ततो भीष्मं पञ्चभिर्नतपर्वभिः।\nअविध्यत रणे भीष्मं प्रतुदन्वाक्यसायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2048043, "chapter_id": 2059, "verse_number": "६-१०८-५१", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सव्यसाची महारथः ।\nकालोऽयमिति संचिन्त्य शिखण्डिनमचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2048044, "chapter_id": 2059, "verse_number": "६-१०८-५२", "content_sanskrit": "अहं त्वामनुयास्यामि परान्विद्रावयञ्शरैः ।\nअभिद्रव सुसंरब्धो भीष्मं भीमपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2048045, "chapter_id": 2059, "verse_number": "६-१०८-५३", "content_sanskrit": "न हि ते संयुगे पीडां शक्ताः कर्तुं महाबलाः ।\nतस्मादद्य महाबाहो यत्नाद्भीष्यमभिद्रव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2048046, "chapter_id": 2059, "verse_number": "६-१०८-५४", "content_sanskrit": "अहत्वा समरे भीष्म यदि यास्यसि मारिष ।\nअवहास्योऽस्य लोकस्य भविष्यसि मया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2048047, "chapter_id": 2059, "verse_number": "६-१०८-५५", "content_sanskrit": "नावहास्या यथा वीर भवेम परमाहवे ।\nतथा कुरु रणे यत्नं साधयस्व पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2048048, "chapter_id": 2059, "verse_number": "६-१०८-५६", "content_sanskrit": "कुरूंश्च सहितान्सर्वान्यतमानान्महारथान् ।\nअहमावारयिष्यामि सावयस्व पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2048049, "chapter_id": 2059, "verse_number": "६-१०८-५७", "content_sanskrit": "द्रोणं च द्रोणपुत्रं च कृपं चाथ सुयोधनम् ।\nचित्रसेनं विकर्णं च सैन्धवं च यजद्रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2048050, "chapter_id": 2059, "verse_number": "६-१०८-५८", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ काम्भोजं च सुदक्षिणम् ।\nभगदत्तं तथा शूरं मागदं च महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2048051, "chapter_id": 2059, "verse_number": "६-१०८-५९", "content_sanskrit": "सौमदत्तिं तथा शूरमार्श्यशृङ्गिं च राक्षसम् ।\nत्रिगर्तराजं च रणे सह सर्वैर्महारथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2048052, "chapter_id": 2059, "verse_number": "६-१०८-६०", "content_sanskrit": "अहमावारयिष्यामि वेलेव मकरालयम् ।\nकुरूंश्च सहितान्सर्वान्युध्यमानान्महाबलान् ।\nनिवारयिष्यामि रणे साधयस्व पितामहम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2048053, "chapter_id": 2059, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि दशमदिवसयुद्धे अष्टाधिकशततमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-१०८-४३ कामं स्वच्छन्दम्। अभ्यस इति पाठे प्रक्षिप ॥ ६-१०८-४९ सुदृष्टः क्रियतां न पुनर्द्रक्ष्यसि लोकमिममिति भावः ॥ ६-१०८-५५ साधयस्वस्वीकुरु जहि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]