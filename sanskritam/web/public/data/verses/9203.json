[{"id": 5000203000, "chapter_id": 9203, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे सप्तमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000203001, "chapter_id": 9203, "verse_number": "३-७-१", "content_sanskrit": "रामस्तु सहितो भ्रात्रा सीतया च परंतपः।\nसुतीक्ष्णस्याश्रमपदं जगाम सह तैर्द्विजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000203002, "chapter_id": 9203, "verse_number": "३-७-२", "content_sanskrit": "स गत्वा दूरमध्वानं नदीस्तीर्त्वा बहूदकाः।\nददर्श विमलं शैलं महामेरुमिवोन्नतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000203003, "chapter_id": 9203, "verse_number": "३-७-३", "content_sanskrit": "ततस्तदिक्ष्वाकुवरौ सततं विविधैर्द्रुमैः।\nकाननं तौ विविशतुः सीतया सह राघवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000203004, "chapter_id": 9203, "verse_number": "३-७-४", "content_sanskrit": "प्रविष्टस्तु वनं घोरं बहुपुष्पफलद्रुमम्।\nददर्शाश्रममेकान्ते चीरमालापरिष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000203005, "chapter_id": 9203, "verse_number": "३-७-५", "content_sanskrit": "तत्र तापसमासीनं मलपङ्कजधारिणम्।\nरामः सुतीक्ष्णं विधिवत् तपोधनमभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000203006, "chapter_id": 9203, "verse_number": "३-७-६", "content_sanskrit": "रामोऽहमस्मि भगवन् भवन्तं द्रष्टुमागतः।\nतन्माभिवद धर्मज्ञ महर्षे सत्यविक्रम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000203007, "chapter_id": 9203, "verse_number": "३-७-७", "content_sanskrit": "स निरीक्ष्य ततो धीरो रामं धर्मभृतां वरम्।\nसमाश्लिष्य च बाहुभ्यामिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000203008, "chapter_id": 9203, "verse_number": "३-७-८", "content_sanskrit": "स्वागतं ते रघुश्रेष्ठ राम सत्यभृतां वर।\nआश्रमोऽयं त्वयाऽऽक्रान्तः सनाथ इव साम्प्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000203009, "chapter_id": 9203, "verse_number": "३-७-९", "content_sanskrit": "प्रतीक्षमाणस्त्वामेव नारोहेऽहं महायशः।\nदेवलोकमितो वीर देहं त्यक्त्वा महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000203010, "chapter_id": 9203, "verse_number": "३-७-१०", "content_sanskrit": "चित्रकूटमुपादाय राज्यभ्रष्टोऽसि मे श्रुतः।\nइहोपयातः काकुत्स्थ देवराजः शतक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000203011, "chapter_id": 9203, "verse_number": "३-७-११", "content_sanskrit": "उपागम्य च मे देवो महादेवः सुरेश्वरः।\nसर्वाल्ँ लोकाञ्जितानाह मम पुण्येन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000203012, "chapter_id": 9203, "verse_number": "३-७-१२", "content_sanskrit": "तेषु देवर्षिजुष्टेषु जितेषु तपसा मया।\nमत्प्रसादात् सभार्यस्त्वं विहरस्व सलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000203013, "chapter_id": 9203, "verse_number": "३-७-१३", "content_sanskrit": "तमुग्रतपसं दीप्तं महर्षिं सत्यवादिनम्।\nप्रत्युवाचात्मवान् रामो ब्रह्माणमिव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000203014, "chapter_id": 9203, "verse_number": "३-७-१४", "content_sanskrit": "अहमेवाहरिष्यामि स्वयं लोकान् महामुने।\nआवासं त्वहमिच्छामि प्रदिष्टमिह कानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000203015, "chapter_id": 9203, "verse_number": "३-७-१५", "content_sanskrit": "भवान् सर्वत्र कुशलः सर्वभूतहिते रतः।\nआख्यातं शरभङ्गेन गौतमेन महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000203016, "chapter_id": 9203, "verse_number": "३-७-१६", "content_sanskrit": "एवमुक्तस्तु रामेण महर्षिर्लोकविश्रुतः।\nअब्रवीन्मधुरं वाक्यं हर्षेण महता युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000203017, "chapter_id": 9203, "verse_number": "३-७-१७", "content_sanskrit": "अयमेवाश्रमो राम गुणवान् रम्यतामिति।\nऋषिसंघानुचरितः सदा मूलफलैर्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000203018, "chapter_id": 9203, "verse_number": "३-७-१८", "content_sanskrit": "इममाश्रममागम्य मृगसंघा महीयसः।\nअहत्वा प्रतिगच्छन्ति लोभयित्वाकुतोभयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000203019, "chapter_id": 9203, "verse_number": "३-७-१९", "content_sanskrit": "नान्यो दोषो भवेदत्र मृगेभ्योऽन्यत्र विद्धि वै।\nतच्छ्रुत्वा वचनं तस्य महर्षेर्लक्ष्मणाग्रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000203020, "chapter_id": 9203, "verse_number": "३-७-२०", "content_sanskrit": "उवाच वचनं धीरो विगृह्य सशरं धनुः।\nतानहं सुमहाभाग मृगसंघान् समागतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000203021, "chapter_id": 9203, "verse_number": "३-७-२१", "content_sanskrit": "हन्यां निशितधारेण शरेणानतपर्वणा।\nभवांस्तत्राभिषज्येत किं स्यात् कृच्छ्रतरं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000203022, "chapter_id": 9203, "verse_number": "३-७-२२", "content_sanskrit": "एतस्मिन्नाश्रमे वासं चिरं तु न समर्थये।\nतमेवमुक्त्वोपरमं रामः संध्यामुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000203023, "chapter_id": 9203, "verse_number": "३-७-२३", "content_sanskrit": "अन्वास्य पश्चिमां संध्यां तत्र वासमकल्पयत् ।\nसुतीक्ष्णस्याश्रमे रम्ये सीतया लक्ष्मणेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000203024, "chapter_id": 9203, "verse_number": "३-७-२४", "content_sanskrit": "ततः शुभं तापसयोग्यमन्नं\nस्वयं सुतीक्ष्णः पुरुषर्षभाभ्याम्।\nताभ्यां सुसत्कृत्य ददौ महात्मा\nसंध्यानिवृत्तौ रजनीं समीक्ष्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000203025, "chapter_id": 9203, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे सप्तमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]