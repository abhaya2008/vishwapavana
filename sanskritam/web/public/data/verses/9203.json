[{"id": 40014594, "chapter_id": 9203, "verse_number": "1", "content_sanskrit": "बृहस्पतेस्तुल्यमतेर्वचस्तन्निशम्ययत्नेनविभीषणस्य । ततोमहात्मावचनंबभाषेतत्रेन्द्रजिन्नैरृतयूथमुख्यः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014595, "chapter_id": 9203, "verse_number": "2", "content_sanskrit": "किंनामतेतातकनिष्ठवाक्यमनर्थकंचेवेसुबसुभीतवच्च । अस्मिन्कुलेयोऽपिभवेन्नजातस्सोऽपीदृशंनैववदेन्नकुर्यात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014596, "chapter_id": 9203, "verse_number": "3", "content_sanskrit": "सत्त्वेनवीर्येणपराक्रमेणशौर्येणधैर्येणचतेजसाच । एकःकुलेऽस्मिन्पुरुषोविमुक्तोविभीषणस्तातकनिष्ठएषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014597, "chapter_id": 9203, "verse_number": "4", "content_sanskrit": "किंनामतौमानुषराजपुत्रावस्माकमेकेनहिराक्षसेन । सुप्राकृतेनापिरणेनिहन्तुमेतौशक्यौकुतोभीषयसेस्मभीरो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014598, "chapter_id": 9203, "verse_number": "5", "content_sanskrit": "त्रिलोकनाथोननुदेवराजश्शक्रोमयाभूमितलेनिविष्टः । भयार्पिताश्चापिदिशःप्रपन्नास्सर्वेतथादेवगणास्समग्राः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014599, "chapter_id": 9203, "verse_number": "6", "content_sanskrit": "ऐरावतोविस्वरमुन्नदन् सनिपातितोभूमितलेमयातु । विकृष्यदन्तौतुमयाप्रसह्यवित्रासितादेवगणास्समग्राः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014600, "chapter_id": 9203, "verse_number": "7", "content_sanskrit": "सोऽहंसुराणामपिदर्पहन्तादैत्योत्तमानामपिशोकदाता । कथंनरेन्द्रात्मजयोर्नशक्तोमनुष्ययोःप्राकृतयोस्सुवीर्यः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014601, "chapter_id": 9203, "verse_number": "8", "content_sanskrit": "अथेन्द्रकल्पस्यदुरासदस्यमहौजसस्तद्वचनंनिशम्य । ततोमहार्थवचनंबभाषेविभीषणश्शस्त्रभृतांवरिष्ठः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014602, "chapter_id": 9203, "verse_number": "9", "content_sanskrit": "नतातमन्त्रेतवनिश्चयोऽस्तिबालस्त्वमद्याप्यविपक्वबुद्धि: । तस्मात्त्वयाप्यात्मविनाशनायवचोऽर्धहीनंबहुविप्रलप्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014603, "chapter_id": 9203, "verse_number": "10", "content_sanskrit": "पुत्रप्रवादेवतुरावणस्यत्वमिन्द्रजिन्मित्रमुखोऽसिशत्रुः । यस्येदृशंराघवतोविनाशंनिशम्यमोहादनुमन्यसेत्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014604, "chapter_id": 9203, "verse_number": "11", "content_sanskrit": "त्वमेववध्यश्चसुदुर्मतिश्चसचापिवध्योयइहाऽनयत्त्वाम् । बालंदृढंसाहसिकंचयोऽद्यप्रावेशयन्मन्त्रकृतांसमीपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014605, "chapter_id": 9203, "verse_number": "12", "content_sanskrit": "मूढोऽप्रगल्भोऽविनयोपपन्नस्तीक्षणस्वभावोऽल्पमतिर्दुरात्मा । मूर्खस्त्वमत्यर्थसुदुर्मतिश्चत्वमिन्द्रजिद्बालतयाब्रवीषि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014606, "chapter_id": 9203, "verse_number": "13", "content_sanskrit": "कोब्रह्मदण्डप्रतिमप्रकाशानर्चिष्मतःकालनिकाशरूपान् । सहेतबाणान्यमदण्डकल्पान्समक्षमुक्तान्युधिराघवेण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014607, "chapter_id": 9203, "verse_number": "14", "content_sanskrit": "धनानिरत्नानिसुभूषणानिवासांसिदिव्यानिमणींश्च । चित्रान् सीतांचरामायनिवेद्यदेवींवसेमराजन् निहवीतशोकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]