[{"id": 900001106, "chapter_id": 8213, "verse_number": "2.1", "content_sanskrit": "नमो भगवते तस्मै प्राणादिप्रभविष्णवे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001107, "chapter_id": 8213, "verse_number": "2.2", "content_sanskrit": "सुकेशा च भारद्वाजः शैब्यश्च सत्यकामः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001108, "chapter_id": 8213, "verse_number": "2.3", "content_sanskrit": "तान् ह स ऋषिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001109, "chapter_id": 8213, "verse_number": "2.4", "content_sanskrit": "अथ कबन्धी कात्यायन उपेत्य पप्रच्छ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001110, "chapter_id": 8213, "verse_number": "2.5", "content_sanskrit": "स मिथुनमुत्पादयते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001111, "chapter_id": 8213, "verse_number": "2.6", "content_sanskrit": "रथिर्वा एतत् सर्वं यन्मूर्तं चामूर्तं च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001112, "chapter_id": 8213, "verse_number": "2.7", "content_sanskrit": "स एष वैश्वानरो विश्वरूपः प्राणोऽग्निरुदयते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900001113, "chapter_id": 8213, "verse_number": "2.8", "content_sanskrit": "संवत्सरो वै प्रजापतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900001114, "chapter_id": 8213, "verse_number": "2.9", "content_sanskrit": "अथोत्तरेण तपसा ब्रह्मचर्येण श्रद्धया ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900001115, "chapter_id": 8213, "verse_number": "2.10", "content_sanskrit": "मासो वै प्रजापतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900001116, "chapter_id": 8213, "verse_number": "2.11", "content_sanskrit": "अन्नं वै प्रजापतिस्ततो हैतद् रेतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]