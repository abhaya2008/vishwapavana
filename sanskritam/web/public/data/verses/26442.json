[{"id": 7006442000, "chapter_id": 26442, "verse_number": "२-१०२-१", "content_sanskrit": "नारद उवाच\nसादिता मौरवाः पाशा निसुन्दनरकौ हतौ ।\nकृतः क्षेम्यः पुनः पन्थाः पुरं प्राग्ज्योतिषं प्रति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006442001, "chapter_id": 26442, "verse_number": "२-१०२-२", "content_sanskrit": "शौरिणा पृथिवीपालास्त्रासिताः स्पर्द्धिनो रणे ।\nधनुषश्च निनादेन पाञ्चजन्यस्वनेन च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006442002, "chapter_id": 26442, "verse_number": "२-१०२-३", "content_sanskrit": "मेघप्रख्यै रथानीकैर्दाक्षिणात्यैः सुरक्षितम् ।\nरुक्मिणं युधि निर्जित्य महाबलपराक्रमम् ।\nरुक्यिणीमाजहाराशु केशवो वृष्णिपुङ्गवः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006442003, "chapter_id": 26442, "verse_number": "२-१०२-४", "content_sanskrit": "ततः पर्जन्यघोषेण रथेनादित्यवर्चसा ।\nउवाह महिषीं भोज्यां शङ्खचक्रगदासिभृत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006442004, "chapter_id": 26442, "verse_number": "२-१०२-५", "content_sanskrit": "जारूथ्यामाह्वृतिः क्राथः शिशुपालश्च निर्जितः ।\nवक्रश्च सह सैन्येन शतधन्वाथ निर्जितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006442005, "chapter_id": 26442, "verse_number": "२-१०२-६", "content_sanskrit": "इन्द्रद्युम्नो हतः कोपाद् यवनश्च कशेरुमान् ।\nहतः सौभपतिः श्रीमाञ्छाल्वश्च दृढधन्वना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006442006, "chapter_id": 26442, "verse_number": "२-१०२-७", "content_sanskrit": "पर्वतानां सहस्रं च चक्रेण पुरुषोत्तमः ।\nविकीर्य पुण्डरीकाक्षो द्युमत्सेनं व्यपोथयत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006442007, "chapter_id": 26442, "verse_number": "२-१०२-८", "content_sanskrit": "महेन्द्रशिखरे चैव निमेषान्तरचारिणौ ।\nजग्राह पुरुषव्याघ्रो वरुणस्याभितश्चरौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006442008, "chapter_id": 26442, "verse_number": "२-१०२-९", "content_sanskrit": "इरावत्यां महाभोजावग्निसूर्यसमौ युधि ।\nगोपतिस्तालकेतुश्च निहतौ शार्ङ्गधन्वना ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006442009, "chapter_id": 26442, "verse_number": "२-१०२-१०", "content_sanskrit": "अक्षप्रपतने चैव डिम्भो हंसश्च दानवौ ।\nउभौ तावपि कृष्णेन सानुगौ विनिपातितौ ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006442010, "chapter_id": 26442, "verse_number": "२-१०२-११", "content_sanskrit": "दग्धा वाराणसी चैव केशवेन महात्मना ।\nसराष्ट्रः सानुबन्धश्च काशीनामधिपो हतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006442011, "chapter_id": 26442, "verse_number": "२-१०२-१२", "content_sanskrit": "विजित्य च यमं संख्ये शरैः संनतपर्वभिः ।\nअथैन्द्रसेनिरानीतः कृष्णेनाद्भुतकर्मणा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006442012, "chapter_id": 26442, "verse_number": "२-१०२-१३", "content_sanskrit": "सहितः सर्वयादोभिः सागरेषु महाबलः ।\nप्राप्य लोहितकूटं च कृष्णेन वरुणो जितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006442013, "chapter_id": 26442, "verse_number": "२-१०२-१४", "content_sanskrit": "महेन्द्रभवने जातो देवैर्गुप्तो महात्मभिः ।\nअचिन्तयित्वा देवेन्द्रं पारिजातद्रुमो हृतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006442014, "chapter_id": 26442, "verse_number": "२-१०२-१५", "content_sanskrit": "पाण्ड्यं पौण्ड्रं कलिङ्गं च मात्स्यं चैव जनार्दनः ।\nजघान सहितान् सर्वान् वङ्गराजं तथैव च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006442015, "chapter_id": 26442, "verse_number": "२-१०२-१६", "content_sanskrit": "एष चैकशतं हत्वा रणे राज्ञां महात्मनाम् ।\nगान्धारीमावहद् वीरो महिषीं प्रियदर्शनाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006442016, "chapter_id": 26442, "verse_number": "२-१०२-१७", "content_sanskrit": "तथा गाण्डीवधन्वानं क्रीडन्तं मधुसूदनः ।\nजिगाय भरतश्रेष्ठं कुन्त्याः प्रमुखतो विभुः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006442017, "chapter_id": 26442, "verse_number": "२-१०२-१८", "content_sanskrit": "द्रोणं-द्रौणिं कृपं कर्णं भीष्मं चैव सुयोधनम् ।\nचक्रानुयानैः प्रहृवणे जिगाय पुरुषोत्तमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006442018, "chapter_id": 26442, "verse_number": "२-१०२-१९", "content_sanskrit": "बभ्रोश्च प्रियमन्विच्छञ्छङ्खचक्रगदासिभृत् ।\nसौवीरराजस्य सुतां प्रसह्य हृतवान् प्रभुः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006442019, "chapter_id": 26442, "verse_number": "२-१०२-२०", "content_sanskrit": "पर्यस्तां पृथिवीं कृत्स्नां साश्वां सरथकुञ्जराम् ।\nवैणुदारिकृते यत्नाज्जिगाय पुरुषोत्तमः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006442020, "chapter_id": 26442, "verse_number": "२-१०२-२१", "content_sanskrit": "अवाप्य तपसो वीर्यं बलमोजश्च माधवः ।\nपूर्वदेहे जहारायं बलेस्त्रिभुवनं हरिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006442021, "chapter_id": 26442, "verse_number": "२-१०२-२२", "content_sanskrit": "वज्राशनिगदाखड्गैस्त्रासयद्भिश्च दानवैः ।\nयस्य नाधिगतो मृत्युः पुरं प्राग्ज्योतिषं प्रति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006442022, "chapter_id": 26442, "verse_number": "२-१०२-२३", "content_sanskrit": "अभिभूतश्च कृष्णेन सगणः सुमहाबलः ।\nबलेः पुत्रो महावीर्यो बाणो द्रविणवत्तरः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006442023, "chapter_id": 26442, "verse_number": "२-१०२-२४", "content_sanskrit": "पीठं तथा महाबाहुः कंसामात्यं जनार्दनः ।\nपैठिकं चासिलोमानं निजघान महाबलः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006442024, "chapter_id": 26442, "verse_number": "२-१०२-२५", "content_sanskrit": "जृम्भमैरावणं चापि विरूपं च महायशाः ।\nजघान पुरुषव्याघ्रो दैत्यं मानुषरूपिणम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006442025, "chapter_id": 26442, "verse_number": "२-१०२-२६", "content_sanskrit": "तथा नागपतिं तोये कालीयं च महौजसम् ।\nनिर्जित्य पुण्डरीकाक्षः प्रेषयामास सागरम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006442026, "chapter_id": 26442, "verse_number": "२-१०२-२७", "content_sanskrit": "संजीवयामास मृतं पुत्रं सान्दीपनेस्तथा ।\nनिर्जित्य पुरुषव्याघ्रो यमं वैवस्वतं हरिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006442027, "chapter_id": 26442, "verse_number": "२-१०२-२८", "content_sanskrit": "एवमेष महाबाहुः शास्ता तेषां दुरात्मनाम् ।\nदेवांश्च ब्राह्मणांश्चैव ये द्विषन्ति सदा नृप ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006442028, "chapter_id": 26442, "verse_number": "२-१०२-२९", "content_sanskrit": "निहत्य नरकं भौममाहृत्य मणिकुण्डले ।\nदेवमातुर्ददौ चैव प्रीत्यर्थं वज्रपाणिनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006442029, "chapter_id": 26442, "verse_number": "२-१०२-३०", "content_sanskrit": "एवं सदैव दैत्यानां सुराणां च महायशाः ।\nभयाभयकरः कृष्णः सर्वलोककरो विभुः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006442030, "chapter_id": 26442, "verse_number": "२-१०२-३१", "content_sanskrit": "संस्थाप्य धर्मान् मर्त्येषु यज्ञैरिष्ट्वाऽऽप्तदक्षिणैः ।\nकृत्वा देवार्थममितं स्वस्थानं प्रतिपत्स्यते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006442031, "chapter_id": 26442, "verse_number": "२-१०२-३२", "content_sanskrit": "कृष्णो भोगवतीं रम्यामृषिकान्तां महायशाः ।\nद्वारकामात्मसात्कृत्वा समुद्रं गमयिष्यति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006442032, "chapter_id": 26442, "verse_number": "२-१०२-३३", "content_sanskrit": "बहुरत्नसमाकीर्णो चैत्ययूपशताङ्किताम् ।\nद्वारकां वरुणावासं प्रवेक्ष्यति सकाननाम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006442033, "chapter_id": 26442, "verse_number": "२-१०२-३४", "content_sanskrit": "तां सूर्यसदनप्रख्यां मतज्ञः शार्ङ्गधन्वनः ।\nविसृष्टां वासुदेवेन सागरः प्लावयिष्यति ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006442034, "chapter_id": 26442, "verse_number": "२-१०२-३५", "content_sanskrit": "सुरासुरमनुष्येषु नासीन्न भविता क्वचित् ।\nय इमामावसेत्कश्चिदन्यो वै मधुसूदनात् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006442035, "chapter_id": 26442, "verse_number": "२-१०२-३६", "content_sanskrit": "एवमेष दशार्हाणां विधाय विधिमुत्तमम् ।\nविष्णुर्नारायणः सोमः सूर्यश्च भविता स्वयम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006442036, "chapter_id": 26442, "verse_number": "२-१०२-३७", "content_sanskrit": "अप्रमेयस्त्वचिन्त्यश्च यथा कामचरो वशी ।\nमोदत्येष सदा भूतैर्बालः क्रीडनकैरिव ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006442037, "chapter_id": 26442, "verse_number": "२-१०२-३८", "content_sanskrit": "न प्रमातुं महाबाहुः शक्योऽयं मधुसूदनः ।\nपरं ह्यपरमेतस्माद् विश्वरूपान्न विद्यते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006442038, "chapter_id": 26442, "verse_number": "२-१०२-३९", "content_sanskrit": "श्रुतोऽयमेव शतशस्तथा शतसहस्रशः ।\nअन्तो हि कर्मणामस्य दृष्टपूर्वो न केनचित् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006442039, "chapter_id": 26442, "verse_number": "२-१०२-४०", "content_sanskrit": "एवमेतानि कर्माणि शिशुमध्यगतस्तदा ।\nकृतवान् पुण्डरीकाक्षः संकर्षणसहायवान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006442040, "chapter_id": 26442, "verse_number": "२-१०२-४१", "content_sanskrit": "इत्युवाच पुरा व्यासस्तपोवीर्येण चक्षुषा ।\nमहायोगी महाबुद्धिः सर्वप्रत्यक्षदर्शिवान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006442041, "chapter_id": 26442, "verse_number": "२-१०२-४२", "content_sanskrit": "वैशम्पायन उवाच\nइति संस्तूय गोविन्दं महेन्द्रवचनान्मुनिः ।\nयदुभिः पूजितः सर्वैर्नारदस्त्रिदिवं ययौ ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006442042, "chapter_id": 26442, "verse_number": "२-१०२-४३", "content_sanskrit": "ततस्तद् वसु गोविन्दो दिदेशान्धकवृष्णिषु ।\nयथार्हं पुण्डरीकाक्षो विधिवन्मधुसूदनः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006442043, "chapter_id": 26442, "verse_number": "२-१०२-४४", "content_sanskrit": "यादवाश्च धनं प्राप्य विधिवद् भूरिदक्षिणैः ।\nयज्ञैरिष्ट्वा महात्मानो द्वारकामावसन् पुरीम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]