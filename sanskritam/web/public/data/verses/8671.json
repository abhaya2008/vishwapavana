[{"id": 900008661, "chapter_id": 8671, "verse_number": "52.1", "content_sanskrit": "युक्तयविरोध उक्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008662, "chapter_id": 8671, "verse_number": "52.2", "content_sanskrit": "तत्र समया द्विविधाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008663, "chapter_id": 8671, "verse_number": "52.3", "content_sanskrit": "अत्र तत्तत्समयोक्तानां पूर्वपक्षन्यायानां ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008664, "chapter_id": 8671, "verse_number": "52.4", "content_sanskrit": "अत्र यदुक्तमुभाभ्यां ‘‘रचनानुपपत्ते’’रित्यादि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008665, "chapter_id": 8671, "verse_number": "52.5", "content_sanskrit": "ननु कार्यरूपेण स्वतः परिणामो रचना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]