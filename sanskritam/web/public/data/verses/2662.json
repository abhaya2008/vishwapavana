[{"id": 2078331, "chapter_id": 2662, "verse_number": "१२-१६७-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078332, "chapter_id": 2662, "verse_number": "१२-१६७-१", "content_sanskrit": "विस्तरेणार्थसंबन्धं श्रोतुमिच्छामि तत्त्वतः।\nमित्रद्रोही कृतघ्नश्च यः प्रोक्तस्तं च मे वद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078333, "chapter_id": 2662, "verse_number": "१२-१६७-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078334, "chapter_id": 2662, "verse_number": "१२-१६७-२", "content_sanskrit": "हन्त ते वर्तयिष्येऽहमितिहासं पुरातनम्।\nउदीच्यां दिशि यद्वृत्तं म्लेच्छेषु मनुजाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078335, "chapter_id": 2662, "verse_number": "१२-१६७-३", "content_sanskrit": "ब्राह्मणो मध्यदेशीयः कृष्णाङ्गो ब्रह्मवर्जितः।\nग्रामं दस्युगणाकीर्णं प्राविशद्धनतृष्णया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078336, "chapter_id": 2662, "verse_number": "१२-१६७-४", "content_sanskrit": "तत्र दस्युर्धनयुतः सर्ववर्णविशेषवित्।\nब्रह्मण्यः सत्यसन्धश्च दाने च निरतोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078337, "chapter_id": 2662, "verse_number": "१२-१६७-५", "content_sanskrit": "तस्य क्षयमुपागम्य ततो भिक्षामयाचत।\nप्रतिश्रयं च वासार्थं भिक्षां चैवाथ वार्षिकीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078338, "chapter_id": 2662, "verse_number": "१२-१६७-६", "content_sanskrit": "प्रादात्तस्मै स विप्राय वस्त्रं च सदशं नवम्।\nनारीं चापि वयोपेतां भर्त्रा विरहितां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078339, "chapter_id": 2662, "verse_number": "१२-१६७-७", "content_sanskrit": "एतत्संप्राप्य हृष्टात्मा गौतमोऽथ द्विजस्तथा।\nतस्मिन्गृहवरे राजंस्तया रेमे स गौतमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078340, "chapter_id": 2662, "verse_number": "१२-१६७-८", "content_sanskrit": "कुटुस्बार्थं च दस्योश्च साहाय्यं चाप्यथाकरोत्।\nसोऽवसद्वर्षमेकं वै समृद्धे शबरालये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078341, "chapter_id": 2662, "verse_number": "१२-१६७-९", "content_sanskrit": "बाणवेधे परं यत्नमकरोच्चैव गौतमः।\nचक्राङ्गान्स च नित्यं वै सर्वतो वनगोचरान्।\nजघान गौतमो राजन्यथा दस्युगणास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078342, "chapter_id": 2662, "verse_number": "१२-१६७-१०", "content_sanskrit": "हिंसापटुर्घृणाहीनः सदा प्राणिवधे रतः।\nगौतमः सन्निकर्षेण दस्युभिः समतामियात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078343, "chapter_id": 2662, "verse_number": "१२-१६७-११", "content_sanskrit": "तथा तु वसतस्तस्य दस्युग्रामे सुखं तदा।\nअगमन्बहवो मासा निघ्नतः पक्षिणो बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078344, "chapter_id": 2662, "verse_number": "१२-१६७-१२", "content_sanskrit": "ततः कदाचिदपरो द्विजस्तं देशमागतः।\nजटाचीराजिनधरः स्वाध्यायनिरतः शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078345, "chapter_id": 2662, "verse_number": "१२-१६७-१३", "content_sanskrit": "विनीतो वेदशास्त्रेषु वेदान्तानां च पारगः।\nअदृश्यत ततस्तत्र सखा तस्यैव तु द्विजः।\nतं दस्युग्राममगमद्यत्रासौ गौतमोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078346, "chapter_id": 2662, "verse_number": "१२-१६७-१४", "content_sanskrit": "स तु विप्रगृहान्वेपी शूद्रान्नपरिवर्जकः।\nग्रामे दस्युसमाकीर्णे व्यचरत्सर्वतो द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078347, "chapter_id": 2662, "verse_number": "१२-१६७-१५", "content_sanskrit": "ततः स गौतमगृहं प्रविवेश द्विजोत्तमः।\nगौतमश्चापि संप्राप्तस्तावन्योन्येन संगतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078348, "chapter_id": 2662, "verse_number": "१२-१६७-१६", "content_sanskrit": "चक्राङ्गभारस्कन्धं तं धनुष्पाणिं धृतायुधम्।\nरुधिरेणावसिक्ताङ्गं गृहद्वारमुपागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078349, "chapter_id": 2662, "verse_number": "१२-१६७-१७", "content_sanskrit": "तं दृष्ट्वा पुरुषादाभमपध्वस्तं क्षमागतम्।\nअभिज्ञाय द्विजो व्रीडन्निदं वाक्यमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078350, "chapter_id": 2662, "verse_number": "१२-१६७-१८", "content_sanskrit": "किमिदं कुरुपे मोहाद्विप्रस्त्वं हि कुलोद्भवः।\nमध्यदेशपरिज्ञातो दस्युभावं गतः कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078351, "chapter_id": 2662, "verse_number": "१२-१६७-१९", "content_sanskrit": "पूर्वान्स्मर द्विज ज्ञातीन्प्रख्यातान्वेदपारगान्।\nयेषां वंशेऽभिजातस्त्वमीदृशः कुलपांसनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078352, "chapter_id": 2662, "verse_number": "१२-१६७-२०", "content_sanskrit": "अवबुध्यात्मनाऽऽत्मानं सत्वं शीलं श्रुतं दमम्।\nअनुक्रोशं च संस्मृत्य त्यज वासमिमं द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2078353, "chapter_id": 2662, "verse_number": "१२-१६७-२१", "content_sanskrit": "स एवमुक्तः सुहृदा तेन तत्र हितैपिणा।\nप्रत्युवाच ततो राजन्विनिश्वस्य तदाऽऽर्तबत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2078354, "chapter_id": 2662, "verse_number": "१२-१६७-२२", "content_sanskrit": "निर्धनोऽस्मि द्विजश्रेष्ठ नापि वेदविदप्यहम्।\nवित्तार्थमिह संप्राप्तं विद्धि मां द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2078355, "chapter_id": 2662, "verse_number": "१२-१६७-२३", "content_sanskrit": "त्वद्दर्शनात्तु विप्रेन्द्र कृतार्थोऽस्म्यद्य वै द्विज।\nअध्वानं सह यास्यावः श्वो वसस्वाद्य शर्वरीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2078356, "chapter_id": 2662, "verse_number": "१२-१६७-२४", "content_sanskrit": "स तत्र न्यवसद्विप्रो घृणी किंचिदसंस्पृशन्।\nक्षुधितश्छन्द्यमानोऽपि भोजनं नाभ्यनन्दत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2078357, "chapter_id": 2662, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वनि आपद्धर्मपर्वणि सप्तषष्ट्यधिकशततमोऽध्यायः॥ १६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]