[{"id": 2060585, "chapter_id": 2297, "verse_number": "८-१८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060586, "chapter_id": 2297, "verse_number": "८-१८-१", "content_sanskrit": "श्वेताश्वोऽपि महाराज व्यधमत्तावकं बलम्।\nयथा वायुः समासाद्य तूलराशिं समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060587, "chapter_id": 2297, "verse_number": "८-१८-२", "content_sanskrit": "प्रत्युद्ययुस्त्रिगर्तास्तं शिबयः कौरवैः सह।\nवसातयोऽथ साल्वाश्च गोपालाश्च यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060588, "chapter_id": 2297, "verse_number": "८-१८-३", "content_sanskrit": "सत्यदेवः सत्यकीर्तिर्मित्रदेवः श्रुतञ्जयः।\nसौश्रुतिश्चन्द्रदेवश्च मित्रवर्मा च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060589, "chapter_id": 2297, "verse_number": "८-१८-४", "content_sanskrit": "त्रिगर्तराजः समरे भ्रातृभिः परिवारितः।\nपुत्रैश्चैव महेष्वासैर्नानाशस्त्रविशारदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060590, "chapter_id": 2297, "verse_number": "८-१८-५", "content_sanskrit": "व्यसृजन्त शस्त्रातान्किरन्तोऽर्जुनमाहवे।\nअभ्यवर्तन्त सहसा वार्योघा इव सागरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060591, "chapter_id": 2297, "verse_number": "८-१८-६", "content_sanskrit": "ते त्वर्जुनं समासाद्य योधाः शतसहस्रशः।\nअगच्छन्विलयं सर्वे तार्क्ष्यं दृष्ट्वेव पन्नगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060592, "chapter_id": 2297, "verse_number": "८-१८-७", "content_sanskrit": "ते हन्यमानाः समरे न जहुः पाण्डवं रणे।\nहन्यमाना महाराज शलभा इव पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060593, "chapter_id": 2297, "verse_number": "८-१८-८", "content_sanskrit": "सत्यदेवस्त्रिभिर्बाणैर्विव्याध युधि पाण्डवम्।\nमित्रदेवस्त्रिषष्ट्या तु चन्द्रदेवस्तु सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060594, "chapter_id": 2297, "verse_number": "८-१८-९", "content_sanskrit": "मित्रवर्मा त्रिसप्तत्या सौश्रुतिश्चापि सप्तभिः।\nश्रुतंजयस्तु विंशत्या सुशर्मा नवभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060595, "chapter_id": 2297, "verse_number": "८-१८-१०", "content_sanskrit": "स विद्वो बहुभिः सङ्ख्ये प्रतिविव्याध तान्नृपान्।\nसौश्रुतिं सप्तभिर्विद्व्वा चन्द्रदेवं त्रिभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060596, "chapter_id": 2297, "verse_number": "८-१८-११", "content_sanskrit": "श्रुतंजयं च विंशत्या चन्द्रदेवं तथाऽष्टभिः।\nमित्रदेवं शतेनैव सत्यदेवं त्रिभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060597, "chapter_id": 2297, "verse_number": "८-१८-१२", "content_sanskrit": "नवभिर्मित्रवर्माणं सुशर्माणं तथाऽष्टभिः।\nश्रुतञ्जयं च राजानं हत्वा तत्र शिलाशितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060598, "chapter_id": 2297, "verse_number": "८-१८-१३", "content_sanskrit": "सौश्रुतेः सशिरस्त्राणं शिरः कायादपाहरत्।\nत्वरितश्चन्द्रदेवं च शरैर्निन्ये यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060599, "chapter_id": 2297, "verse_number": "८-१८-१४", "content_sanskrit": "तथेतरान्महाराज यतमानान्महारथान्।\nपञ्चभिः पञ्चभिर्बाणैरेकैकं प्रत्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060600, "chapter_id": 2297, "verse_number": "८-१८-१५", "content_sanskrit": "सत्यदेवस्तु सङ्क्रुद्वस्तोमरं व्यसृजन्महत्।\nसमुद्दिश्य रणे कृष्णं सिंहनादं ननाद च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060601, "chapter_id": 2297, "verse_number": "८-१८-१६", "content_sanskrit": "स निर्भिद्य भुजं सव्यं माधवस्य महात्मनः।\nअयस्मयः स्वर्णदण्डो जगाम धरणीं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060602, "chapter_id": 2297, "verse_number": "८-१८-१७", "content_sanskrit": "माधवस्य तु विद्धस्य तोमरेण महारणे।\nप्रतोदः प्रापतद्वस्ताद्रश्मयश्च विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060603, "chapter_id": 2297, "verse_number": "८-१८-१८", "content_sanskrit": "वासुदेवं विभिन्नाङ्गं दृष्ट्वा पार्थो धनञ्जयः।\nक्रोधमाहारयत्तीव्रं कृष्णं चेदमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060604, "chapter_id": 2297, "verse_number": "८-१८-१९", "content_sanskrit": "प्रापयाश्वान्महाबाहो सत्यदेवं प्रति प्रभो।\nयावदेनं शरैस्तीक्ष्णैर्नयामि यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060605, "chapter_id": 2297, "verse_number": "८-१८-२०", "content_sanskrit": "प्रतोदं गृह्य सोऽन्यत्तु रश्मीन्सङ्गृह्य च द्रुतम्।\nवाहयामास तानश्वान्सत्यदेवरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060606, "chapter_id": 2297, "verse_number": "८-१८-२१", "content_sanskrit": "विष्वक्सेनं सुनिर्विद्वं दृष्ट्वा पार्थो धनञ्जयः।\nसत्यदेवं शरैस्तीक्ष्णैर्वारयित्वा महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060607, "chapter_id": 2297, "verse_number": "८-१८-२२", "content_sanskrit": "ततः सुनिशितैर्भल्लै राज्ञस्तस्य महच्छिरः।\nकुम्डलोपचितं कायाच्चकर्त पृतनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060608, "chapter_id": 2297, "verse_number": "८-१८-२३", "content_sanskrit": "तन्निकृत्य शितैर्बाणैर्भित्रवर्माणमाक्षिपत्।\nवत्सदन्तेन तीक्ष्णेन सारथिं चास्य मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2060609, "chapter_id": 2297, "verse_number": "८-१८-२४", "content_sanskrit": "ततः शरशतैर्भूयः संशप्तकगणान्बली।\nपातयामास सङ्क्रुद्वः शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2060610, "chapter_id": 2297, "verse_number": "८-१८-२५", "content_sanskrit": "ततो रजतपुङ्खेन राजञ्शीर्षं महात्मनः।\nमित्रदेवस्य चिच्छेद क्षुरप्रेण महारथः।\nसुशर्माणं सुसङ्क्रुद्धो जत्रुदेशे समाहनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2060611, "chapter_id": 2297, "verse_number": "८-१८-२६", "content_sanskrit": "ततः संशप्तकाः सर्वे परिवार्य धनञ्जयम्।\nशस्त्रौघैर्ममृदुः क्रुद्वा नादयन्तो दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2060612, "chapter_id": 2297, "verse_number": "८-१८-२७", "content_sanskrit": "अभ्यर्दितस्तु तज्जिष्णुः शक्रतुल्यपराक्रमः।\nऐन्द्रमस्त्रममेयात्मा प्रादुश्चक्रे महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2060613, "chapter_id": 2297, "verse_number": "८-१८-२८", "content_sanskrit": "ततः शरसहस्राणि प्रादुरासन्विशाम्पते।\n`कार्मुकात्पाण्डुपुत्रस्य पार्थस्यामिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2060614, "chapter_id": 2297, "verse_number": "८-१८-२९", "content_sanskrit": "ततस्तु च्छिद्यमानानां ध्वजानां धनुषां तथा।\nरथानां सपताकानां तूणीराणां युगैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2060615, "chapter_id": 2297, "verse_number": "८-१८-३०", "content_sanskrit": "अक्षाणामथ चक्राणां योक्त्राणां रश्मिभिः सह।\nकूबराणां वरूथानां पृषत्कानां च संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2060616, "chapter_id": 2297, "verse_number": "८-१८-३१", "content_sanskrit": "अश्वानां पततां चापि प्रासानामृष्टिभिः सह।\nगदानां परिघानां च शक्तितोमरपट्टसैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2060617, "chapter_id": 2297, "verse_number": "८-१८-३२", "content_sanskrit": "शतघ्नीनां सचक्राणां भुजानां चोरुभिः सह।\nकण्ठसूत्राङ्गदानां च केयूराणां च मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2060618, "chapter_id": 2297, "verse_number": "८-१८-३३", "content_sanskrit": "हाराणामथ निष्काणां तनुत्राणां च भारत।\nछत्राणां व्यजनानां च शिरसां कुमुटैः सह।\nराशयश्चात्र दृश्यन्ते पतितानां महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2060619, "chapter_id": 2297, "verse_number": "८-१८-३४", "content_sanskrit": "सकुण्डलानि स्वक्षीमि पूर्णचन्द्रनिभानि च।\nशिरांस्युर्व्यामदृश्यन्त ताराजालमिवाम्बरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2060620, "chapter_id": 2297, "verse_number": "८-१८-३५", "content_sanskrit": "सुस्रग्वीणि सुवासांसि चन्दनेनोक्षितानि च।\nशरीराणि व्यदृश्यन्त निहतानां महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2060621, "chapter_id": 2297, "verse_number": "८-१८-३६", "content_sanskrit": "रुद्रस्याक्रीडसदृशं घोरमायोधनं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2060622, "chapter_id": 2297, "verse_number": "८-१८-३७", "content_sanskrit": "निहतै राजपुत्रैश्च क्षत्रियैश्च महाबलैः।\n`अर्जुनेन महाराज तत्रतत्र महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2060623, "chapter_id": 2297, "verse_number": "८-१८-३८", "content_sanskrit": "हस्तिभिः पतितैश्चैव तुरङ्गैश्चाभवन्मही।\nअगम्यरूपा समरे विशीर्णैरिव पर्वतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2060624, "chapter_id": 2297, "verse_number": "८-१८-३९", "content_sanskrit": "नासीद्रथपथस्तस्य पाण्डवस्य महात्मनः।\nनिघ्नतः शात्रवान्भल्लैर्हस्त्यश्वं चास्यतो महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2060625, "chapter_id": 2297, "verse_number": "८-१८-४०", "content_sanskrit": "स्वानुगा इव सीदन्ति रथचक्राणि मारिष।\nचरतस्तस्य सङ्ग्रामे तस्मिंल्लोहितकर्दमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2060626, "chapter_id": 2297, "verse_number": "८-१८-४१", "content_sanskrit": "सीदमानानि चक्राणि समुहूस्तुरगा भृशम्।\nश्रमेण महता युक्ता मनोमारुतरंहसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2060627, "chapter_id": 2297, "verse_number": "८-१८-४२", "content_sanskrit": "वध्यमानं तु तत्सैन्यं पाण्डुपुत्रेण धन्विना।\nप्रायशो विमुखं सर्वं नावतिष्ठत भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2060628, "chapter_id": 2297, "verse_number": "८-१८-४३", "content_sanskrit": "ताञ्जित्वा समरे जिष्णुः संशप्तकगणान्बहून्।\nविरराज तदा पार्थो विधूमोऽग्निरिव ज्वलन्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2060629, "chapter_id": 2297, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि षोडशदिवसयुद्धे अष्टादशोऽध्यायः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]