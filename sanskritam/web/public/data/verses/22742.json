[{"id": 7002742000, "chapter_id": 22742, "verse_number": "९-२७-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nतथा चान्यां प्रवक्ष्यामि तृतीयां पापनाशिनीम् ।\nलोकेषु नाम्ना विख्यातामार्द्रानंदकरीमिमाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002742001, "chapter_id": 22742, "verse_number": "९-२७-२", "content_sanskrit": "यदा शुक्लतृतीयायामाषाढर्क्षं भवेत्क्वचित् ।\nब्रह्मर्क्षं चाथ मार्गं वा व्रतं ग्राह्यं तदा शुभम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002742002, "chapter_id": 22742, "verse_number": "९-२७-३", "content_sanskrit": "दर्भगंधोदकैः स्नानं तदा सम्यक्समाचरेत् ।\nशुक्लमाल्यांबरधरः शुक्लगंधानुलेपनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002742003, "chapter_id": 22742, "verse_number": "९-२७-४", "content_sanskrit": "भवानीमर्चयेद्भक्त्या शुक्लपुष्पैः सुगंधिभिः ।\nमहादेवेन सहितामुपविष्टां वरासने ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002742004, "chapter_id": 22742, "verse_number": "९-२७-५", "content_sanskrit": "वासुदेव्यै नमः पादौ शंकराय नमो हरेः ।\nजंघे शोकविनाशिन्यायानन्दाय नमः प्रभो ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002742005, "chapter_id": 22742, "verse_number": "९-२७-६", "content_sanskrit": "रंभायै पूजयेदूरू शिवाय च पिनाकिनः ।\nआदित्यै च कटिं पूज्या शूलिनः शूलपाणये ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002742006, "chapter_id": 22742, "verse_number": "९-२७-७", "content_sanskrit": "माधव्यै च तथा नाभिमथ शंभोर्भवाय वै ।\nस्तनावानंदकारिण्यै शंकरायेंदुधारिणे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002742007, "chapter_id": 22742, "verse_number": "९-२७-८", "content_sanskrit": "उत्कंठिन्यै नमः कंठं नीलकंठाय वै हरेः ।\nकरावुत्पलधारिण्यै रुद्राय जगतीपतेः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002742008, "chapter_id": 22742, "verse_number": "९-२७-९", "content_sanskrit": "बाहुं च परिरंभिण्यै नृत्यशीलाय वै हरेः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002742009, "chapter_id": 22742, "verse_number": "९-२७-१०", "content_sanskrit": "देव्या मुखं विलासिन्यै वृषेशाय पुनर्विभोः ।\nस्मितं सस्मरशीलायै विश्ववक्त्राय वै विभोः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002742010, "chapter_id": 22742, "verse_number": "९-२७-११", "content_sanskrit": "नेत्रं मदनवासिन्यै विश्वधाम्ने त्रिशूलिने ।\nभ्रुवौ रतिप्रियायै च तांडवेशाय वै विभोः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002742011, "chapter_id": 22742, "verse_number": "९-२७-१२", "content_sanskrit": "देव्यै ललाटमिंद्राण्यै हव्यवाहाय वै विभोः ।\nस्वाहायै मुकुटं देव्या विभोः पञ्चशराय वै ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002742012, "chapter_id": 22742, "verse_number": "९-२७-१३", "content_sanskrit": "विश्वकायै विश्वमुख्यै विश्वपादकरौ शिवौ ।\nप्रसन्नवदनौ वंदे पार्वतीपरमेश्वरौ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002742013, "chapter_id": 22742, "verse_number": "९-२७-१४", "content_sanskrit": "एवं संपूज्य विधिवदग्रतः शिवयोः पुनः ।\nपद्मोत्पलानि च तथा नानावर्णानि कारयेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002742014, "chapter_id": 22742, "verse_number": "९-२७-१५", "content_sanskrit": "शङ्खचक्रे सकटके स्वस्तिकं वर्द्ध मानकम् ।\nगोमूत्रं गोमयं क्षीरं दधि सर्पिः कुशोदकम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002742015, "chapter_id": 22742, "verse_number": "९-२७-१६", "content_sanskrit": "शृंगोदकं बिल्वपत्रं वारि कुंभान्वितं तथा ।\nउशीरनीरं तद्वच्च यवचूर्णोदकं ततः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002742016, "chapter_id": 22742, "verse_number": "९-२७-१७", "content_sanskrit": "तिलोदकं च संप्राप्य स्वप्यान्मार्गशिरादिषु ।\nप्रतिपक्षद्वितीयायां प्राशनं समुदाहृतम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002742017, "chapter_id": 22742, "verse_number": "९-२७-१८", "content_sanskrit": "सर्वत्र शुक्लपुष्पाणि प्रशस्तानि शिवार्चने ।\nदानकालेषु सर्वेषु मंत्रमेतमुदीरयेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002742018, "chapter_id": 22742, "verse_number": "९-२७-१९", "content_sanskrit": "गौरी मे प्रीयतां नित्यमघनाशाय मंगला ।\nसौभाग्यायास्तु ललिता भवानी सर्वसिद्धये ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002742019, "chapter_id": 22742, "verse_number": "९-२७-२०", "content_sanskrit": "संवत्सरांते लवणं गुडकुंभं समर्जितम् ।\nचन्दनं नेत्रपट्टं च सितवस्त्रयुगान्वितम् ।\nउमामहेश्वरं हैमं तद्वदिक्षुफलैर्युतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002742020, "chapter_id": 22742, "verse_number": "९-२७-२१", "content_sanskrit": "प्रस्तरावरणं शय्यां सविश्रामां निवेदयेत् ।\nसपत्नीकाय विप्राय गौरी मे प्रीयतामिति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002742021, "chapter_id": 22742, "verse_number": "९-२७-२२", "content_sanskrit": "आर्द्रानन्दकरी नाम तृतीयैषा सनातनी ।\nयामुपोष्य नरो याति शंभोस्तत्परमं पदम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002742022, "chapter_id": 22742, "verse_number": "९-२७-२३", "content_sanskrit": "इह लोके यमानंदं प्राप्नोति धनसंचयात् ।\nआयुरारोग्यसंपन्नो न किञ्चिच्छोकमाप्नुयात् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002742023, "chapter_id": 22742, "verse_number": "९-२७-२४", "content_sanskrit": "नारी वा कुरुते या तु कुमारी विधवा तथा ।\nसापि तत्फलमाप्नोति देव्यनुग्रहलालिता ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002742024, "chapter_id": 22742, "verse_number": "९-२७-२५", "content_sanskrit": "प्रतिपक्षमुपोष्यैवं मंत्रार्चनविधानतः ।\nरुद्राणीलोकमाप्नोति पुनरावृत्तिवर्जितम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002742025, "chapter_id": 22742, "verse_number": "९-२७-२६", "content_sanskrit": "य इदं शृणुयान्नित्यं श्रावयेद्वापि मानवः ।\nशक्रलोके सगंधर्वैः पूज्यतेऽब्दशतत्रयम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002742026, "chapter_id": 22742, "verse_number": "९-२७-२७", "content_sanskrit": "आनंददां सकलदुःखहरां तृतीयां या स्त्री करोति विधिवत्सधवाधवा च ।\nसा स्वे गृहे सुखशतान्यनुभूय भूयो गौरीपुरं सदयिता मुदिता प्रयाति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]