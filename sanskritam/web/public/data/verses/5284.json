[{"id": 2201008, "chapter_id": 5284, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2201009, "chapter_id": 5284, "verse_number": "१", "content_sanskrit": "द्विजातयो व्रतोपेता हविस्ते यदि भुञ्जते ।\nअन्नं ब्राह्मणकामाय कथमेतत् पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2201010, "chapter_id": 5284, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2201011, "chapter_id": 5284, "verse_number": "२", "content_sanskrit": "अवेदोक्तव्रताश्चैव भुञ्जानाः कार्यकारिणः ।\nवेदोक्तेषु तु भुञ्जाना व्रतयुक्ता भवन्ति हि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2201012, "chapter_id": 5284, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2201013, "chapter_id": 5284, "verse_number": "३", "content_sanskrit": "यदिदं तप इत्याहुरुपवासं पृथग्जनाः ।\nतपः स्यादेतदिह वै तपोऽन्यद्वापि किं भवेत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2201014, "chapter_id": 5284, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2201015, "chapter_id": 5284, "verse_number": "४", "content_sanskrit": "मासार्धमासौ नोपवसेद् यत्तपो मन्यते जनः ।\nआत्मतन्त्रोपघाती यो न तपस्वी न धर्मवित्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2201016, "chapter_id": 5284, "verse_number": "५", "content_sanskrit": "त्यागस्यापि च सम्पत्तिः शिष्यते तप उत्तमम् ।\nसदोपवासी च भवेद् ब्रह्मचारी तथैव च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2201017, "chapter_id": 5284, "verse_number": "६", "content_sanskrit": "मुनिश्च स्यात् सदा विप्रो देवांश्चैव सदा यजेत् ।\nकुटुम्बिको धर्मकामः सदाऽस्वप्नश्च भारत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2201018, "chapter_id": 5284, "verse_number": "७", "content_sanskrit": "अमृताशी सदा च स्यात् पवित्री च सदा भवेत् ।\nऋतवादी सदा च स्यान्नियतश्च सदा भवेत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2201019, "chapter_id": 5284, "verse_number": "८", "content_sanskrit": "विघसाशी सदा च स्यात् सदा चैवातिथिप्रियः ।\nअमांसाशी सदा च स्यात् पवित्री च सदा भवेत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2201020, "chapter_id": 5284, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2201021, "chapter_id": 5284, "verse_number": "९", "content_sanskrit": "कथं सदोपवासी स्याद् ब्रह्मचारी च पार्थिव ।\nविघसाशी कथं च स्यात् कथं चैवातिथिप्रियः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2201022, "chapter_id": 5284, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2201023, "chapter_id": 5284, "verse_number": "१०", "content_sanskrit": "अन्तरा सायमाशं च प्रातराशं तथैव च ।\nसदोपवासी भवति यो न भुङ्क्तेऽन्तरा पुनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2201024, "chapter_id": 5284, "verse_number": "११", "content_sanskrit": "भार्यां गच्छन् ब्रह्मचारी सदा भवति चैव ह ।\nऋतवादी सदा च स्याद् दानशीलश्च मानवः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2201025, "chapter_id": 5284, "verse_number": "१२", "content_sanskrit": "अभक्षयन् वृथा मांसममांसाशी भवत्युत ।\nदानं ददत् पवित्री स्यादस्वप्नश्च दिवाऽस्वपन्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2201026, "chapter_id": 5284, "verse_number": "१३", "content_sanskrit": "भृत्यातिथिषु यो भुङ्क्ते भुक्तवत्सु नरः सदा ।\nअमृतं केवलं भुङ्क्ते इति विद्धि युधिष्ठिर\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2201027, "chapter_id": 5284, "verse_number": "१४", "content_sanskrit": "अभुक्तवत्सु नाश्नाति ब्राह्मणेषु तु यो नरः ।\nअभोजनेन तेनास्य जितः स्वर्गो भवत्युत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2201028, "chapter_id": 5284, "verse_number": "१५", "content_sanskrit": "देवेभ्यश्च पितृभ्यश्च भृत्येभ्योऽतिथिभिः सह ।\nअवशिष्टानि यो भुङ्क्ते तमाहुर्विघसाशिनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2201029, "chapter_id": 5284, "verse_number": "१६", "content_sanskrit": "तेषां लोका ह्यपर्यन्ताः सदने ब्रह्मणः स्मृताः ।\nउपस्थिता ह्यप्सरोभिर्गन्धर्वैश्च जनाधिप\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2201030, "chapter_id": 5284, "verse_number": "१७", "content_sanskrit": "देवतातिथिभिः सार्धं पितृभिश्चोपभुञ्जते ।\nरमन्ते पुत्रपौत्रैश्च तेषां गतिरनुत्तमा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2201031, "chapter_id": 5284, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे उपवासादिव्रतकथनं नाम पञ्चत्रिंशोत्तरशततमोऽध्यायः ॥१३६॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]