[{"id": 7006197000, "chapter_id": 26197, "verse_number": "२-२५-१", "content_sanskrit": "वसिष्ठ उवाच ततस्त द्रक्तियोगेन स प्रीतात्मा जगत्पतिः ।\nप्रत्यक्षमगमत्तस्य सर्वैः सह मरुद्गणैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006197001, "chapter_id": 26197, "verse_number": "२-२५-२", "content_sanskrit": "तं दृष्ट्वा देवदेवेशं त्रिनेत्रं चन्द्रशेखरम् ।\nवृषेन्द्रवाहनं शंभुं भूतकोटिसमन्वितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006197002, "chapter_id": 26197, "verse_number": "२-२५-३", "content_sanskrit": "ससंभ्रमं समुत्थाय हर्षेणाकुललोचनः ।\nप्रणाममकरोद्भक्त्या शर्वाय भुवि भार्गवः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006197003, "chapter_id": 26197, "verse_number": "२-२५-४", "content_sanskrit": "उत्थायोत्थाय देवेशं प्रणम्य शिरसासकृत् ।\nकृताञ्जलिपुटो रामस्तुष्टाव च जगत्पतिम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006197004, "chapter_id": 26197, "verse_number": "२-२५-५", "content_sanskrit": "राम उवाच नमस्ते देवदेवेश नमस्ते परमेश्वर ।\nनमस्ते जगतो नाथ नमस्ते त्रिपुरान्तक ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006197005, "chapter_id": 26197, "verse_number": "२-२५-६", "content_sanskrit": "नमस्ते सकलाध्यक्ष नमस्ते भक्तवत्सल ।\nनमस्ते सर्वभूतेश नमस्ते वृषभध्वज ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006197006, "chapter_id": 26197, "verse_number": "२-२५-७", "content_sanskrit": "नमस्ते सकलाधीश नमस्ते करुणाकर ।\nनमस्ते सकलावास नमस्ते नीललोहित ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006197007, "chapter_id": 26197, "verse_number": "२-२५-८", "content_sanskrit": "नमः सकलदेवारिगणनाशाय शूलिने ।\nकपालिने नमस्तुभ्यं सर्वलोकैकपालिने ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006197008, "chapter_id": 26197, "verse_number": "२-२५-९", "content_sanskrit": "श्मशानवासिने नित्यं नमः कैलासवासिने ।\nनमोऽस्तु पाशिने तुभ्यं कालकूटविषाशिने ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006197009, "chapter_id": 26197, "verse_number": "२-२५-१०", "content_sanskrit": "विभवेऽमरवन्द्याय प्रभवे ते स्वयंभुवे ।\nनमोऽखिलजगत्कर्मसाक्षिभूताय शंभवे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006197010, "chapter_id": 26197, "verse_number": "२-२५-११", "content_sanskrit": "नमस्त्रिपथ गाफेनभासिगार्द्धन्दुमौलिने ।\nमहाभोगीन्द्रहाराय शिवाय परमात्मने ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006197011, "chapter_id": 26197, "verse_number": "२-२५-१२", "content_sanskrit": "भस्मसंच्छन्नदेहाय नमोर्ऽकाग्नीन्दुचक्षुषे ।\nकपर्दिने नमस्तुभ्यमन्धकासुरमर्द्दिने ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006197012, "chapter_id": 26197, "verse_number": "२-२५-१३", "content_sanskrit": "त्रिपुरध्वंसिने दक्षयज्ञविध्वंसिने नमः ।\nगिरिजाकुचकाश्मीरविरञ्जितमहोरसे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006197013, "chapter_id": 26197, "verse_number": "२-२५-१४", "content_sanskrit": "महादेवाय मह ते नमस्ते कृत्तिवाससे ।\nयोगिध्येयस्वरूपाय शिवायाचिन्त्यतेजसे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006197014, "chapter_id": 26197, "verse_number": "२-२५-१५", "content_sanskrit": "स्वभक्तहृदयांभोजकर्णिकामध्यवर्त्तिने ।\nसकलागमसिद्धान्तसाररूपाय ते नमः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006197015, "chapter_id": 26197, "verse_number": "२-२५-१६", "content_sanskrit": "नमो निखिलयोगेन्द्रबोधनायामृतात्मने ।\nशङ्करायाखिलव्याप्तमहिम्ने परमात्मने ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006197016, "chapter_id": 26197, "verse_number": "२-२५-१७", "content_sanskrit": "नमः शर्वाय शान्ताय ब्रह्मणे विश्वरुपिणे ।\nआदिमध्यान्तहीनाय नित्यायाव्यक्तमूर्त्तये ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006197017, "chapter_id": 26197, "verse_number": "२-२५-१८", "content_sanskrit": "व्यक्ताव्यक्तस्वरूपाय स्थूलसूक्ष्मात्मने नमः ।\nनमो वेदान्तवेद्याय विश्वविज्ञानरूपिणे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006197018, "chapter_id": 26197, "verse_number": "२-२५-१९", "content_sanskrit": "नमः सुरासुरश्रेणिमौलिपुष्पार्चिताङ्घ्रये ।\nश्रीकण्ठाय जगद्धात्रे लोककर्त्रे नमोनमः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006197019, "chapter_id": 26197, "verse_number": "२-२५-२०", "content_sanskrit": "रजोगुणात्मने तुभ्यं विश्वसृष्टिविधायिने ।\nहिरण्यगर्भरूपाय हराय जगदादये ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006197020, "chapter_id": 26197, "verse_number": "२-२५-२१", "content_sanskrit": "नमो विश्वात्मने लोकस्थितिव्या पारकारिणे ।\nसत्त्वविज्ञानरुपाय पराय प्रत्यगात्मने ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006197021, "chapter_id": 26197, "verse_number": "२-२५-२२", "content_sanskrit": "तमोगुणविकाराय जगत्संहारकारिणे ।\nक्ल्पान्ते रुद्ररूपाय परापर विदे नमः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006197022, "chapter_id": 26197, "verse_number": "२-२५-२३", "content_sanskrit": "अविकाराय नित्याय नमः सदसदात्मने ।\nबुद्धिबुद्धिप्रबोधाय बुद्धीन्द्रियविकारिणे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006197023, "chapter_id": 26197, "verse_number": "२-२५-२४", "content_sanskrit": "वस्वादित्यमरुद्भिश्च साध्यरुद्राश्विभेदतः ।\nयन्मायाभिन्नमतयो देवास्तस्मै नमोनमः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006197024, "chapter_id": 26197, "verse_number": "२-२५-२५", "content_sanskrit": "अविकारमजं नित्यं सूक्ष्मरूपमनौपमम् ।\nतव यत्तन्न जानन्ति योगिनोऽपि सदामलाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006197025, "chapter_id": 26197, "verse_number": "२-२५-२६", "content_sanskrit": "त्वामविज्ञाय दुर्ज्ञेयं सम्यग्ब्रह्मादयोऽपि हि ।\nसंसरन्ति भवे नूनं न तत्कर्मात्मकाश्चिरम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006197026, "chapter_id": 26197, "verse_number": "२-२५-२७", "content_sanskrit": "यावन्नोपैति चरणौ तवाज्ञानविघातिनः ।\nतावद्भ्रमति संसारे पण्डितोऽचेतनोऽपि वा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006197027, "chapter_id": 26197, "verse_number": "२-२५-२८", "content_sanskrit": "स एव दक्षः स कृती स मुनिः स च पण्डितः ।\nभवतश्चरणांभोजे येन बुद्धिः स्थिरीकृता ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006197028, "chapter_id": 26197, "verse_number": "२-२५-२९", "content_sanskrit": "सुसूक्ष्मत्वेन गहनः सद्भावस्ते त्रयीमयः ।\nविदुषामपि मूढेन स मया ज्ञायते कथम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006197029, "chapter_id": 26197, "verse_number": "२-२५-३०", "content_sanskrit": "अशब्दगोजरत्वेन महिम्नस्तव सांप्रतम् ।\nस्तोतुमप्यनलं सम्यक्त्वा महं जडधीर्यतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006197030, "chapter_id": 26197, "verse_number": "२-२५-३१", "content_sanskrit": "तस्मादज्ञानतो वापि मया भक्त्यैव संस्तुतः ।\nप्रीतश्च भव देवेश ननु त्वं भक्तवत्सलः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006197031, "chapter_id": 26197, "verse_number": "२-२५-३२", "content_sanskrit": "वसिष्ठ उवाच इति स्तुतस्तदा तेन भक्त्या रामेण शङ्करः ।\nमेघगंभीरया वाचा तमुवाच हसन्निव ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006197032, "chapter_id": 26197, "verse_number": "२-२५-३३", "content_sanskrit": "भगवानुवाच रामाहं सुप्रसन्नोऽस्मि शोर्ंयशालितया तव ।\nतपसा मयि भक्त्या च स्तोत्रेण च विशेषतः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006197033, "chapter_id": 26197, "verse_number": "२-२५-३४", "content_sanskrit": "वरं वरय तस्मात्त्वं यद्यदिच्छसि चेतसा ।\nतुभ्यं तत्तदशेषेण दास्याम्यहमशेषतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006197034, "chapter_id": 26197, "verse_number": "२-२५-३५", "content_sanskrit": "वसिष्ठ उवाच इत्युक्तो देवदेवेन तं प्रणम्य भृगूद्वहः ।\nकृताञ्जलिपुटो भूत्वा राजन्निदमुवाच ह ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006197035, "chapter_id": 26197, "verse_number": "२-२५-३६", "content_sanskrit": "यदि देव प्रसन्नस्त्वं वारर्हेऽस्मि च यद्यहम् ।\nभवतस्तदभीप्सामि हेतुमस्त्राण्यशेषतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006197036, "chapter_id": 26197, "verse_number": "२-२५-३७", "content_sanskrit": "अस्त्रे शस्त्रे च शास्त्रे च न मत्तोऽभ्यधिको भवेत् ।\nलोकेषु मांरणेजेता न भवेत्त्वत्प्रसादतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006197037, "chapter_id": 26197, "verse_number": "२-२५-३८", "content_sanskrit": "वसिष्ठ उवाच तथेत्युक्त्वा ततः शंभुरस्त्रशस्त्राण्यशेषतः ।\nददौ रामाय सुप्रीतः समन्त्राणि क्रमान्नृप ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006197038, "chapter_id": 26197, "verse_number": "२-२५-३९", "content_sanskrit": "सप्रयोगं ससंहारमस्त्रग्रामं चतुर्विधम् ।\nप्रसादाभिमुखो रामं ग्राहयामास शङ्करः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006197039, "chapter_id": 26197, "verse_number": "२-२५-४०", "content_sanskrit": "असंगवेगं शुभ्राश्वं सुध्वजं च रथोत्तमम् ।\nइषुधी चाक्षयशरौ ददौ रामाय शङ्करः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006197040, "chapter_id": 26197, "verse_number": "२-२५-४१", "content_sanskrit": "अभेद्यमजरं दिव्यं दृढज्यं विजयं धनुः ।\nसर्वशस्त्रसहं चित्रं कवचं च महाधनम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006197041, "chapter_id": 26197, "verse_number": "२-२५-४२", "content_sanskrit": "अजेयत्वं च युद्धेषु शौर्यं चाप्रतिमं भुवि ।\nस्वेच्छया धारणे शाक्तिं प्राणानां च नराधिप ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006197042, "chapter_id": 26197, "verse_number": "२-२५-४३", "content_sanskrit": "ख्यातिं च बीजमेत्रेण तन्नाम्ना सर्वलौकिकीम् ।\nतपः प्रभावं च महत्प्रददौ भार्गवाय सः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006197043, "chapter_id": 26197, "verse_number": "२-२५-४४", "content_sanskrit": "भक्ति चात्मनि रामाय दत्त्वा राजन्यथोचिताम् ।\nसहितः सकलैर्भूतैश्चामरैश्चन्द्रशेखरः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006197044, "chapter_id": 26197, "verse_number": "२-२५-४५", "content_sanskrit": "तेनैव वपुषा शंभुः क्षिप्रमन्तरधाद्धरः ।\nकृतकृत्यस्ततो रामो लब्ध्वा सर्वमभीप्सितम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006197045, "chapter_id": 26197, "verse_number": "२-२५-४६", "content_sanskrit": "अदृश्यतां गते शर्वे महोदरमुवाच ह ।\nमहोदर मदर्थे त्वमिदं सर्वमशेषतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006197046, "chapter_id": 26197, "verse_number": "२-२५-४७", "content_sanskrit": "रथचापादिकं तावत्परिरक्षितुमर्हसि ।\nयदा कृत्यं ममैतेन तदानीं त्वं मया स्मृतः ।\nरथचापादिकं सर्वं प्रहिणु त्वं मदन्तिकम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006197047, "chapter_id": 26197, "verse_number": "२-२५-४८", "content_sanskrit": "वसिष्ठ उवाच तथेत्युक्त्वा गते तस्मिन्भृगुवर्यो महोदरे ।\nकृतकृत्यो गुरुजनं द्रष्टुं गन्तुमियेष सः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006197048, "chapter_id": 26197, "verse_number": "२-२५-४९", "content_sanskrit": "गच्छन्नथ तदासौ तु हिमाद्रिवनगह्वरे ।\nविवेश कन्दरं रामो भाविकर्मप्रचोदितः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006197049, "chapter_id": 26197, "verse_number": "२-२५-५०", "content_sanskrit": "स तत्र ददृशे बालं धृतप्राणमनुद्रुतम् ।\nव्याघ्रेण विप्रतनयं रुदन्तं भीतभीतवत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006197050, "chapter_id": 26197, "verse_number": "२-२५-५१", "content_sanskrit": "दृष्ट्वानुकंपहृदयस्तत्परित्राणकातरः ।\nतिष्ठतिष्ठेति तं व्याघ्रं वदन्नुच्चैरथान्वयात् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006197051, "chapter_id": 26197, "verse_number": "२-२५-५२", "content_sanskrit": "तमनुद्रुत्य वेगेन चिरादिव भृगूद्वहः ।\nआससाद वने घोरं शार्दूलमतिभीषणम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006197052, "chapter_id": 26197, "verse_number": "२-२५-५३", "content_sanskrit": "व्याघ्रेणानुद्रुतः सोऽपि पलायन्वनगह्वरे ।\nनिपपात द्विजसुतस्त्रस्तः प्राणभयातुरः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006197053, "chapter_id": 26197, "verse_number": "२-२५-५४", "content_sanskrit": "रामोऽपि क्रोधरक्ताक्षो विप्रपुत्रपरीप्सया ।\nतृणमूलं समादाय कुशास्त्रेणाभ्यमन्त्रयत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006197054, "chapter_id": 26197, "verse_number": "२-२५-५५", "content_sanskrit": "तावत्तरक्षुर्बलवानाद्रवत्पतितं द्विजम् ।\nदृष्ट्वा ननादसुभृशं रोदसी कम्पयन्निव ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006197055, "chapter_id": 26197, "verse_number": "२-२५-५६", "content_sanskrit": "दग्ध्वा त्वस्त्राग्निना व्याघ्रं प्रहरन्तं नखाङ्कुरैः ।\nअकृतव्रणमेवाशु मोक्षयामास तं द्विजम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006197056, "chapter_id": 26197, "verse_number": "२-२५-५७", "content_sanskrit": "सोऽपि ब्रह्माग्निनिर्दग्धदेहः पाप्मा नभस्तले ।\nगान्धर्वं वपुरास्थाय राममाहेति सादरम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006197057, "chapter_id": 26197, "verse_number": "२-२५-५८", "content_sanskrit": "विप्रशापेन भोपूर्वमहं प्राप्तस्तरक्षुताम् ।\nगच्छामि मोचितः शापात्त्वयाहमधुना दिवम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006197058, "chapter_id": 26197, "verse_number": "२-२५-५९", "content_sanskrit": "इत्युक्त्वा तु गते तस्मिन्रामो वेगेन विस्मितः ।\nपतितं द्विजपुत्रं तं कृपया व्यवपद्यत ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006197059, "chapter_id": 26197, "verse_number": "२-२५-६०", "content_sanskrit": "माभैरेवं वदन्वाणीमारादेव द्विजात्मजम् ।\nपरमृशत्तदङ्गानि शनैरुज्जीवयन्नृप ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006197060, "chapter_id": 26197, "verse_number": "२-२५-६१", "content_sanskrit": "रामेणोत्थापितश्चैवं स तदोन्मील्य लोचने ।\nविलोकयन्ददर्शाग्रे भृगुश्रेष्ठमवस्थितम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006197061, "chapter_id": 26197, "verse_number": "२-२५-६२", "content_sanskrit": "भस्मीकृतं च शार्दूलं दृष्टवा विस्मयमागतः ।\nगतभीराह कस्त्वं भोः कथं वेह समागतः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006197062, "chapter_id": 26197, "verse_number": "२-२५-६३", "content_sanskrit": "केन वायं निहन्तुं मामुद्यतो भस्मसात्कृतः ।\nतरक्षुर्भीषणाकारः साक्षान्मृत्युरिवापरः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006197063, "chapter_id": 26197, "verse_number": "२-२५-६४", "content_sanskrit": "भयसंमूढमनमो ममाद्यापि महामते ।\nहतेऽपि तस्मिन्नखिला भान्ति वै तन्मया दिशः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006197064, "chapter_id": 26197, "verse_number": "२-२५-६५", "content_sanskrit": "त्वामेव मन्ये सकलं पिता माता सुत्दृद्गुरू ।\nपरमापदमापन्नं त्वं मां समुपजीवयन् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006197065, "chapter_id": 26197, "verse_number": "२-२५-६६", "content_sanskrit": "आसीन्मुनिवरः कश्चिच्छान्तो नाम महातपाः ।\nपुत्रस्तस्यास्मि तीर्थार्थी शालग्राममयासिषम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006197066, "chapter_id": 26197, "verse_number": "२-२५-६७", "content_sanskrit": "तस्मात्संप्रस्थितश्शैलं दिदृक्षुर्गन्धमादनम् ।\nनानामुनिगणैर्जुष्टं पुण्यं बदरिकाश्रमम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006197067, "chapter_id": 26197, "verse_number": "२-२५-६८", "content_sanskrit": "गन्तुकामोऽपहायाहं पन्थानं तु हिमाचले ।\nप्रविशन्गहनं रम्यं प्रदेशालोकनाकुलम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006197068, "chapter_id": 26197, "verse_number": "२-२५-६९", "content_sanskrit": "दिशंप्राचीं समुद्दिश्य क्रोशमात्रमयासिषम् ।\nततो दिष्टवशेनाहं प्राद्रवं भयपीडितः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006197069, "chapter_id": 26197, "verse_number": "२-२५-७०", "content_sanskrit": "पतितश्च त्वया भूयोभूमेरुत्थापितोऽधुना ।\nपित्रेव नितरां पुत्रः प्रेम्णात्यर्थं दयालुना ।\nइत्येष मम वृत्तान्तः साकल्येनोदितस्तव ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006197070, "chapter_id": 26197, "verse_number": "२-२५-७१", "content_sanskrit": "वसिष्ठ उवाच इति पृष्टस्तदा तेन स्ववृत्तान्तमशेषतः ।\nकथयामास राजेन्द्र रामस्तस्मै यथाक्रमम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006197071, "chapter_id": 26197, "verse_number": "२-२५-७२", "content_sanskrit": "ततस्तौ प्रीतिसंयुक्तौ कथयन्तौ परस्परम् ।\nस्थित्वा नातिचिरं कालमथ गन्तुमियेष सः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006197072, "chapter_id": 26197, "verse_number": "२-२५-७३", "content_sanskrit": "अन्वीयमानस्तेनाथ रामस्तस्माद्गुहामुखात् ।\nनिष्क्रम्यावसथं पित्रोः संप्रतस्थे मुदान्वितः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006197073, "chapter_id": 26197, "verse_number": "२-२५-७४", "content_sanskrit": "अकृतव्रण एवासौ व्याघ्रेण भुवि पातितः ।\nरामेण रक्षितश्चाभुद्यस्माद्ध्याघ्रं विनिघ्नता ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006197074, "chapter_id": 26197, "verse_number": "२-२५-७५", "content_sanskrit": "तस्मात्तदेव नामास्य बभूव प्रथितं भुवि ।\nविप्रपुत्रस्य राजेन्द्र तदेतत्सोऽकृतव्रणः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006197075, "chapter_id": 26197, "verse_number": "२-२५-७६", "content_sanskrit": "तदा प्रभृति रामस्य च्छायेवातपगा भुवि ।\nबभूव मित्रमत्यर्थं सर्वावस्थासु पार्थिव ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006197076, "chapter_id": 26197, "verse_number": "२-२५-७७", "content_sanskrit": "स तेनानुगतो राजन्भृगोरासाद्य सन्निधिम् ।\nदृष्ट्वा ख्यातिं च सोऽभ्येत्य विनयेनाभ्यवादयत् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006197077, "chapter_id": 26197, "verse_number": "२-२५-७८", "content_sanskrit": "स ताभ्यां प्रियमाणाभ्यामाशीर्भिरभिनन्दितः ।\nदिनानि कतिचित्तत्र न्यवसत्तत्प्रियेप्सया ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006197078, "chapter_id": 26197, "verse_number": "२-२५-७९", "content_sanskrit": "ततस्तयोरनुमते च्यवनस्य महामुनेः ।\nआश्रमं प्रतिचक्राम शिष्यसंघैः समावृतम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006197079, "chapter_id": 26197, "verse_number": "२-२५-८०", "content_sanskrit": "नियन्त्रितान्तः करणं तं च संशान्तमानसम् ।\nसुकन्याचापि तद्भार्यामवन्दत महामनाः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006197080, "chapter_id": 26197, "verse_number": "२-२५-८१", "content_sanskrit": "ताभ्यां च प्रीतियुक्ताभ्यां रामः समभिनन्दितः ।\nऔर्वाश्रमं समापेदे द्रष्टुकामस्तपोनिधिम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006197081, "chapter_id": 26197, "verse_number": "२-२५-८२", "content_sanskrit": "तं चाभिवाद्य मेधावी तेन च प्रतिनन्दितः ।\nउवास तत्र तत्प्रीत्या दिनानि कतिचिन्नृप ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006197082, "chapter_id": 26197, "verse_number": "२-२५-८३", "content_sanskrit": "विसृष्टस्तेन शनकैरृचीकभवनं मुदा ।\nप्रतस्थे भार्गवः श्रीमानकृतव्रणसंयुतः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006197083, "chapter_id": 26197, "verse_number": "२-२५-८४", "content_sanskrit": "अवन्दत पितुः पित्रोर्नत्वा पादौ पृथक्पृथक् ।\nतौ च तं नृप संहर्षाच्चाशिषा प्रत्यनन्दताम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006197084, "chapter_id": 26197, "verse_number": "२-२५-८५", "content_sanskrit": "पृष्टश्च ताभ्यामखिलं निजवृत्तमुदारधीः ।\nकथयामास राजेन्द्र यथावृत्तमनुक्रमात् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006197085, "chapter_id": 26197, "verse_number": "२-२५-८६", "content_sanskrit": "स्थित्वा दिनानि कतिचित्तत्रापि तदनुज्ञया ।\nजगामावसथं पित्रोर्मुदा परमया युतः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006197086, "chapter_id": 26197, "verse_number": "२-२५-८७", "content_sanskrit": "अभ्येत्य पितरौ राजन्नासी नावाश्रमोत्तमे ।\nअवन्दत तयोः पादौ यथावद्भृगुनन्दन ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006197087, "chapter_id": 26197, "verse_number": "२-२५-८८", "content_sanskrit": "पादप्रणामावनतं समुत्थाप्य च सादरम् ।\nआश्लिष्य नेत्रसलिलैर्नन्दन्तौ पर्यषिञ्चताम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006197088, "chapter_id": 26197, "verse_number": "२-२५-८९", "content_sanskrit": "आशीर्भिरभिनन्द्याङ्के समारोप्य सुहुर्मुखम् ।\nविक्षन्तौ तस्य चाङ्गानि परिस्पृश्यापतुर्मुदम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006197089, "chapter_id": 26197, "verse_number": "२-२५-९०", "content_sanskrit": "अपृच्छताञ्च तौ रामं कलेनैतावता त्वया ।\nकिं कृतं पुत्र को वायं कुत्र वा त्वमुपस्थितः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006197090, "chapter_id": 26197, "verse_number": "२-२५-९१", "content_sanskrit": "कथं सह सकाशे त्वमास्थितो वात्र वागतः ।\nत्वयेतदखिलं वत्स कथ्यतां तथ्यमावयोः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]