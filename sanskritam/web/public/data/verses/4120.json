[{"id": 2144882, "chapter_id": 4120, "verse_number": "", "content_sanskrit": "वेशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2144883, "chapter_id": 4120, "verse_number": "१", "content_sanskrit": "समवेतेषु सर्वेषु तेषु राजसु भारत ।\nदुर्योधनमिदं वाक्यं भीष्मः शान्तनवोऽब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2144884, "chapter_id": 4120, "verse_number": "२", "content_sanskrit": "बृहस्पतिश्चोशना च ब्रह्माणं पर्युपस्थितौ ।\nमरुतश्च सहेन्द्रेण वसवश्चाग्निना सह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2144885, "chapter_id": 4120, "verse_number": "३", "content_sanskrit": "आदित्याश्चैव साध्याश्च ये च सप्तर्षयो दिवि ।\nविश्वावसुश्च गन्धर्वः सर्वे चाप्सरसां गणाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2144886, "chapter_id": 4120, "verse_number": "४", "content_sanskrit": "नमस्कृत्योपजग्मुस्ते लोकवृद्धं पितामहम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2144887, "chapter_id": 4120, "verse_number": "५", "content_sanskrit": "परिवार्य च विश्वेशं पर्यासत दिवौकसः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2144888, "chapter_id": 4120, "verse_number": "६", "content_sanskrit": "तेषां मनश्च तेजश्चाप्याददानाविवौजसा ।\nपूर्वदेवौ व्यतिक्रान्तौ नरनारायणावृषी\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2144889, "chapter_id": 4120, "verse_number": "७", "content_sanskrit": "बृहस्पतिश्च पप्रच्छ ब्रह्माणं काविमाविति ।\nभवन्तं नोपतिष्ठेते तौ नः शंस पितामह\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2144890, "chapter_id": 4120, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2144891, "chapter_id": 4120, "verse_number": "८", "content_sanskrit": "यावेतौ पृथिवीं द्यां च भासयन्तौ तपस्विनौ ।\nज्वलन्तौ रोचमानौ च व्याप्यातीतौ महाबलौ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2144892, "chapter_id": 4120, "verse_number": "९", "content_sanskrit": "नरनारायणावेतौ लोकाल्लोकं समाश्रितौ ।\nऊर्जितौ स्वेन तपसा महासत्वपराक्रमौ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2144893, "chapter_id": 4120, "verse_number": "१०", "content_sanskrit": "एतौ हि कर्मणा लोकं नन्दयामासतुर्ध्रुवौ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2144894, "chapter_id": 4120, "verse_number": "११", "content_sanskrit": "द्विधाभूतौ महाप्राज्ञौ विद्धि ब्रह्म परन्तपौ ।\nअसुराणां विनाशाय देवगन्धर्वपूजितौ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2144895, "chapter_id": 4120, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2144896, "chapter_id": 4120, "verse_number": "१२", "content_sanskrit": "जगाम शक्रस्तच्छ्रुत्वा यत्र तौ तेपतुस्तपः ।\nसार्धं देवगणैः सर्वैः सहस्राक्षः समावृतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2144897, "chapter_id": 4120, "verse_number": "१३", "content_sanskrit": "तस्मिन् देवासुरे युद्धे भये जाते दिवौकसाम् ।\nअयाचत महात्मानौ नरनारायणौ वरम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2144898, "chapter_id": 4120, "verse_number": "१४", "content_sanskrit": "तावब्रूतां वृणीष्वेति तदा भरतसत्तम ।\nअथैतावब्रवीच्छक्रः साह्यं नः क्रियतामिति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2144899, "chapter_id": 4120, "verse_number": "१५", "content_sanskrit": "ततस्तौ शक्रमब्रूतां करिष्यावो यदिच्छसि ।\nताभ्यां च सहितः शक्रो विजिग्ये दैत्यदानवान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2144900, "chapter_id": 4120, "verse_number": "१६", "content_sanskrit": "नर इन्द्रस्य सङ्ग्रामे हत्वा शत्रून् परन्तपः ।\nपौलोमान् कालकेयांश्च सहस्राणि शतानि च\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2144901, "chapter_id": 4120, "verse_number": "१७", "content_sanskrit": "एषोऽभ्रान्तो रथे तिष्ठन् भल्लेनापहरच्छिरः ।\nजम्भस्य ग्रसमानस्य तथा ह्यर्जुन आहवे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2144902, "chapter_id": 4120, "verse_number": "१८", "content_sanskrit": "एष पारे समुद्रस्य हिरण्यपुरमारुजत् ।\nहत्वा षष्टिसहस्राणि निवातकवचान् रणे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2144903, "chapter_id": 4120, "verse_number": "१९", "content_sanskrit": "एष देवान् सहेन्द्रेण जित्वा परपुरञ्जयः ।\nअतर्पयन्महाबाहुरर्जुनो जातवेदसम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2144904, "chapter_id": 4120, "verse_number": "२०", "content_sanskrit": "नारायणस्तथैवात्र भूयसोऽन्यान् जघान ह\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2144905, "chapter_id": 4120, "verse_number": "२१", "content_sanskrit": "एवमेतौ महावीर्यौ तौ पश्यत समागतौ ।\nवासुदेवार्जुनौ वीरौ समवेतौ महारथौ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2144906, "chapter_id": 4120, "verse_number": "२२", "content_sanskrit": "नरनारायणौ देवौ पूर्वदेवाविति श्रुतिः ।\nअजेयौ मानुषे लोके सेन्द्रैरपि सुरासुरैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2144907, "chapter_id": 4120, "verse_number": "२३", "content_sanskrit": "एष नारायणः कृष्णः फल्गुनश्च नरः स्मृतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2144908, "chapter_id": 4120, "verse_number": "२४", "content_sanskrit": "नारायणो नरश्चैव सत्त्वमेकं द्विधा कृतम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2144909, "chapter_id": 4120, "verse_number": "२५", "content_sanskrit": "एतौ हि कर्मणा लोकानश्नुवातेऽक्षयान् ध्रुवान् ।\nतत्र तत्रैव जायेते युद्धकाले पुनः पुनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2144910, "chapter_id": 4120, "verse_number": "२६", "content_sanskrit": "तस्मात् कर्मैव कर्तव्यमिति होवाच नारदः ।\nएतद्धि सर्वमाचष्ट वृष्णिचक्रस्य वेदवित्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2144911, "chapter_id": 4120, "verse_number": "२७", "content_sanskrit": "शङ्खचक्रगदाहस्तं यदा द्रक्ष्यसि केशवम् ।\nपर्याददानं चास्त्राणि भीमधन्वानमर्जुनम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2144912, "chapter_id": 4120, "verse_number": "२८", "content_sanskrit": "सनातनौ महात्मानौ कृष्णावेकरथे स्थितौ ।\nदुर्योधन तदा तात स्मर्तासि वचनं मम\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2144913, "chapter_id": 4120, "verse_number": "२९", "content_sanskrit": "नः चेदयमभावः स्यात् कुरूणां प्रत्युपस्थितः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2144914, "chapter_id": 4120, "verse_number": "३०", "content_sanskrit": "अर्थाच्च तात धर्माच्च तव बुद्धिरुपप्लुता ।\nन चेद् ग्रहीष्यसे वाक्यं श्रोतासि सुबहून् हतान्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2144915, "chapter_id": 4120, "verse_number": "३१", "content_sanskrit": "तवैव हि मतिं सर्वे कुरवः पर्युपासते ।\nत्रयाणामेव च मतं तत् त्वमेकोऽनुमन्यसे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2144916, "chapter_id": 4120, "verse_number": "३२", "content_sanskrit": "रामेण चैव शप्तस्य कर्णस्य भरतर्षभ ।\nदुर्जातेः सूतपुत्रस्य शकुनेः सौबलस्य च\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2144917, "chapter_id": 4120, "verse_number": "३३", "content_sanskrit": "तथा क्षुद्रस्य पापस्य भ्रातुर्दुःशासनस्य च\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2144918, "chapter_id": 4120, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2144919, "chapter_id": 4120, "verse_number": "३४", "content_sanskrit": "नैवमायुष्मता वाच्यं यन्मामात्थ पितामह ।\nक्षत्रधर्मे स्थितो ह्यस्मिन् स्वधर्मादनपेयिवान्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2144920, "chapter_id": 4120, "verse_number": "३५", "content_sanskrit": "किञ्चान्यन्मयि दुर्वृत्तं येन मां परिगर्हसे ।\nन हि मे व्रजिनं किञ्चिद् धार्तराष्ट्रा विदुः क्वचित्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2144921, "chapter_id": 4120, "verse_number": "३६", "content_sanskrit": "नाचरं व्रजिनं किञ्चिद् धार्तराष्ट्रस्य नित्यशः ।\nअहं हि पाण्डवान् सर्वान् हनिष्यामि रणे स्थितान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2144922, "chapter_id": 4120, "verse_number": "३७", "content_sanskrit": "प्राग्विरुद्धैः शमः सद्भिः कथं वा क्रियते पुनः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2144923, "chapter_id": 4120, "verse_number": "३८", "content_sanskrit": "राज्ञो हि धृतराष्ट्रस्य सर्वं कार्यं प्रियं मया ।\nतथा दुर्योधनस्यापि स हि राज्ये समाहितः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2144924, "chapter_id": 4120, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2144925, "chapter_id": 4120, "verse_number": "३९", "content_sanskrit": "कर्णस्य तु वचः श्रुत्वा भीष्मः शान्तनवः पुनः ।\nधृतराष्ट्रं महाराजमाभाष्येदं वचोऽब्रवीत्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2144926, "chapter_id": 4120, "verse_number": "४०", "content_sanskrit": "यदयं कत्थते नित्यं हन्ताऽहं पाण्डवानिति ।\nनायं कलाऽपि सम्पूर्णा पाण्डवानां महात्मनाम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2144927, "chapter_id": 4120, "verse_number": "४१", "content_sanskrit": "अनयो योऽयमागन्ता पुत्राणां ते दुरात्मनाम् ।\nतदस्य कर्म जानीहि सूतपुत्रस्य दुर्मतेः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2144928, "chapter_id": 4120, "verse_number": "४२", "content_sanskrit": "एतमाश्रित्य पुत्रस्ते मन्दबुद्धिः सुयोधनः ।\nअवमन्यति तान् वीरान् देवपुत्रानरिन्दमान्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2144929, "chapter_id": 4120, "verse_number": "४३", "content_sanskrit": "किञ्चाप्येतेन तत् कर्म कृतं पूर्वं न दुष्करम् ।\nतैर्यथा पाण्डवैः सर्वैरेकैकेन कृतं पुरा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2144930, "chapter_id": 4120, "verse_number": "४४", "content_sanskrit": "दृष्ट्वा विराटनगरे भ्रातरं निहतं प्रियम् ।\nधनञ्जयेन विक्रम्य किमनेन तदा कृतम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2144931, "chapter_id": 4120, "verse_number": "४५", "content_sanskrit": "सर्वे ह्यस्त्रविदः शूराः सर्वे प्राप्ता महद्यशः ।\nअपि सर्वामरैश्वर्यं त्यजेयुर्न पुनर्जयम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2144932, "chapter_id": 4120, "verse_number": "४६", "content_sanskrit": "सहितान् हि कुरून् सर्वान् अभियातो धनञ्जयः ।\nप्रमथ्य चाच्छिनद् वासः किमयं प्रेषितस्तदा\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2144933, "chapter_id": 4120, "verse_number": "४७", "content_sanskrit": "गन्धर्वैर्घोषयात्रायां ह्रियते यत् सुतस्तव ।\nक्व तदा सूतपुत्रोऽसौ य इदानीं वृषायते\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2144934, "chapter_id": 4120, "verse_number": "४८", "content_sanskrit": "ननु तत्रापि भीमेन पार्थेन च महात्मना ।\nयमाभ्यामेव सङ्गम्य गन्धर्वास्ते पराजिताः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2144935, "chapter_id": 4120, "verse_number": "४९", "content_sanskrit": "एतान्यस्य मृषोक्तानि बहूनि भरतर्षभ ।\nवैकर्तनस्य भद्रं ते सदा धर्मार्थलोपिनः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2144936, "chapter_id": 4120, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2144937, "chapter_id": 4120, "verse_number": "५०", "content_sanskrit": "भीष्मस्य वचनं श्रुत्वा भारद्वाजो महामनाः ।\nधृतराष्ट्रमुवाचेदं राजमध्येऽभिपूजयन्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2144938, "chapter_id": 4120, "verse_number": "५१", "content_sanskrit": "यदाह भरतश्रेष्ठो भीष्मस्तत् क्रियतां नृप ।\nन काममवलिप्तानां वचनं कर्तुमर्हसि\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2144939, "chapter_id": 4120, "verse_number": "५२", "content_sanskrit": "पुरा युद्धात् साधु मन्ये पाण्डवैः सह सङ्गतम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2144940, "chapter_id": 4120, "verse_number": "५३", "content_sanskrit": "यद्वाक्यमर्जुनेनोक्तं सञ्जयेन निवेदितम् ।\nसर्वं तदभिजानामि करिष्यति च पाण्डवः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2144941, "chapter_id": 4120, "verse_number": "५४", "content_sanskrit": "वधे नूनं भवेच्छान्तिः तव वा फल्गुनस्य वा ।\nन तु जेताऽर्जुनस्यास्ति हन्ता वाऽस्य न विद्यते\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2144942, "chapter_id": 4120, "verse_number": "५५", "content_sanskrit": "मन्युस्तस्य कथं शाम्येन्मन्दान् प्रति य उत्थितः ।\nअन्येऽप्यस्त्राणि जानन्ति युध्यन्ति विजयन्ति च\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2144943, "chapter_id": 4120, "verse_number": "५६", "content_sanskrit": "अयं हि विजयस्त्वेव श्रूयते फल्गुनस्य च ।\nत्रयस्त्रिंशत्सहेन्द्रेण खाण्डवेऽग्निमतर्पयत्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2144944, "chapter_id": 4120, "verse_number": "५७", "content_sanskrit": "विजिगाय सुरान् सर्वान् नास्य वेद्मि पराजयम् ।\nयस्य यन्ता हृषीकेशः शीलवृत्तसमो युधि\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2144945, "chapter_id": 4120, "verse_number": "५८", "content_sanskrit": "न ह्यस्य त्रिषु लोकेषु सदृशोऽस्ति धनुर्धरः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2144946, "chapter_id": 4120, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2144947, "chapter_id": 4120, "verse_number": "५९", "content_sanskrit": "अनादृत्य तु तद्वाक्यमर्थवद् द्रोणभीष्मयोः ।\nततः स सञ्जयं राजा पर्यपृच्छत पाण्डवान्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2144948, "chapter_id": 4120, "verse_number": "६०", "content_sanskrit": "तदैव कुरवः सर्वे निराशा जीवितेऽभवन् ।\nभीष्मद्रोणौ यदा राजा न सम्यगनुभाषते\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2144949, "chapter_id": 4120, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकपञ्चाशोऽध्यायः ॥५१॥ व्यासाभिगमनपर्वणि चतुर्थोऽध्यायः ॥४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]