[{"id": 50024251, "chapter_id": 11843, "verse_number": "1", "content_sanskrit": "॥ मेधातिथिः काण्वः। अग्निः, अग्निनाऽग्निरिति प्रथमपादस्य निर्मथ्याहवनीयौ अग्नी। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024252, "chapter_id": 11843, "verse_number": "2", "content_sanskrit": "अ॒ग्निं दू॒तं वृ॑णीमहे॒ होता॑रं वि॒श्ववे॑दसम्। अ॒स्य य॒ज्ञस्य॑ सु॒क्रतु॑म्॥ १२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024253, "chapter_id": 11843, "verse_number": "3", "content_sanskrit": "अ॒ग्निम॑ग्निं॒ हवी॑मभि॒ः सदा॑ हवन्त वि॒श्पति॑म्। ह॒व्य॒वाहं॑ पुरुप्रि॒यम्॥ १२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024254, "chapter_id": 11843, "verse_number": "4", "content_sanskrit": "अग्ने॑ दे॒वाँ इ॒हा व॑ह जज्ञा॒नो वृ॒क्तब॑र्हिषे। असि॒ होता॑ न॒ ईड्य॑ः॥ १२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024255, "chapter_id": 11843, "verse_number": "5", "content_sanskrit": "ताँ उ॑श॒तो वि बो॑धय॒ यद॑ग्ने॒ यासि॑ दू॒त्य॑म्। दे॒वैरा स॑त्सि ब॒र्हिषि॑॥ १२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024256, "chapter_id": 11843, "verse_number": "6", "content_sanskrit": "घृता॑हवन दीदिव॒ः प्रति॑ ष्म॒ रिष॑तो दह। अग्ने॒ त्वं र॑क्ष॒स्विन॑ः॥ १२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024257, "chapter_id": 11843, "verse_number": "7", "content_sanskrit": "अ॒ग्निना॒ग्निः समि॑ध्यते क॒विर्गृ॒हप॑ति॒र्युवा॑। ह॒व्य॒वाड्जु॒ह्वा॑स्यः॥ १२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024258, "chapter_id": 11843, "verse_number": "8", "content_sanskrit": "क॒विम॒ग्निमुप॑ स्तुहि स॒त्यध॑र्माणमध्व॒रे। दे॒वम॑मीव॒चात॑नम्॥ १२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024259, "chapter_id": 11843, "verse_number": "9", "content_sanskrit": "यस्त्वाम॑ग्ने ह॒विष्प॑तिर्दू॒तं दे॑व सप॒र्यति॑। तस्य॑ स्म प्रावि॒ता भ॑व॥ १२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024260, "chapter_id": 11843, "verse_number": "10", "content_sanskrit": "यो अ॒ग्निं दे॒ववी॑तये ह॒विष्माँ॑ आ॒विवा॑सति। तस्मै॑ पावक मृळय॥ १२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024261, "chapter_id": 11843, "verse_number": "11", "content_sanskrit": "स न॑ः पावक दीदि॒वोऽग्ने॑ दे॒वाँ इ॒हा व॑ह। उप॑ य॒ज्ञं ह॒विश्च॑ नः॥ १२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50024262, "chapter_id": 11843, "verse_number": "12", "content_sanskrit": "स न॒ः स्तवा॑न॒ आ भ॑र गाय॒त्रेण॒ नवी॑यसा। र॒यिं वी॒रव॑ती॒मिष॑म्॥ १२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50024263, "chapter_id": 11843, "verse_number": "13", "content_sanskrit": "अग्ने॑ शु॒क्रेण॑ शो॒चिषा॒ विश्वा॑भिर्दे॒वहू॑तिभिः। इ॒मं स्तोमं॑ जुषस्व नः॥ १२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]