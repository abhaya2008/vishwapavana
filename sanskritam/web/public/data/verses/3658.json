[{"id": 2124001, "chapter_id": 3658, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2124002, "chapter_id": 3658, "verse_number": "१", "content_sanskrit": "वनं गतेषु पार्थेषु निर्जितेषु दुरोदरे ।\nधृतराष्ट्रं महाराज तदा चिन्ता समाविशत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2124003, "chapter_id": 3658, "verse_number": "२", "content_sanskrit": "तं चिन्तयानमासीनं धृतराष्ट्रं जनेश्वरम् ।\nनिश्श्वसन्तमनेकाग्रमिति होवाच सञ्जयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2124004, "chapter_id": 3658, "verse_number": "३", "content_sanskrit": "अवाप्य वसुसम्पूर्णां वसुधां वसुधाधिप ।\nप्रव्राज्य पाण्डवान् राज्याद् राजन् किमनुशोचसि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2124005, "chapter_id": 3658, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2124006, "chapter_id": 3658, "verse_number": "४", "content_sanskrit": "अशोच्यत्वं कुतस्तेषां येषां वैरं भविष्यति ।\nपाण्डवैर्युद्धशौण्डैस्तु बलवद्भिर्महारथैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2124007, "chapter_id": 3658, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2124008, "chapter_id": 3658, "verse_number": "५", "content_sanskrit": "तवेदं स्वकृतं राजन् महद्वैरं भविष्यति ।\nविनाशः सर्वलोकस्य सानुबन्धो भविष्यति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2124009, "chapter_id": 3658, "verse_number": "६", "content_sanskrit": "वार्यमाणोऽपि भीष्मेण द्रोणेन विदुरेण च ।\nपाण्डवानां प्रियां भार्यां द्रौपदीं धर्मचारिणीम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2124010, "chapter_id": 3658, "verse_number": "७", "content_sanskrit": "प्राहिणोदानयेहेति पुत्रो दुर्योधनस्तव ।\nसूतपुत्रं सुमन्दात्मा निर्लज्जः प्रातिकामिनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2124011, "chapter_id": 3658, "verse_number": "८", "content_sanskrit": "यस्मै देवाः प्रयच्छन्ति पुरुषाय पराभवम् ।\nबुद्धिं तस्यापकर्षन्ति सोऽपनीतानि पश्यति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2124012, "chapter_id": 3658, "verse_number": "९", "content_sanskrit": "बुद्धौ कलुषभूतायां विनाशे पर्युपस्थिते ।\nअनयो नयसङ्काशो हृदयान्नापसर्पति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2124013, "chapter_id": 3658, "verse_number": "१०", "content_sanskrit": "अनर्थाश्चार्थरूपेण अर्थाश्चानर्थरूपिणः ।\nउत्तिष्ठन्ति विनश्यन्ति नूनं तच्चास्य रोचते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2124014, "chapter_id": 3658, "verse_number": "११", "content_sanskrit": "न कालो दण्डमुद्यम्य शिरः कृन्तति कस्यचित् ।\nकालस्य बलमेवैतद् विपरीतार्थदर्शनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2124015, "chapter_id": 3658, "verse_number": "१२", "content_sanskrit": "आसादितमिदं घोरं तुमुलं रोमहर्षणम् ।\nपाञ्चालीमपकर्षद्भिः सभामध्ये तपस्विनीम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2124016, "chapter_id": 3658, "verse_number": "१३", "content_sanskrit": "अयोनिजां रूपवतीं कुलजां तां विभावरीम् ।\nको नु तां सर्वधर्मज्ञां परिहूय यशस्विनीम् ।\nपर्यानयेत् सभामध्ये द्यूते दुर्द्यूतदेविनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2124017, "chapter_id": 3658, "verse_number": "१४", "content_sanskrit": "स्त्रीधर्मिणीं वरारोहां शोणितेन समुक्षिताम् ।\nएकवस्त्रां च पाञ्चालीं पाण्डवानप्यवेक्ष्य च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2124018, "chapter_id": 3658, "verse_number": "१५", "content_sanskrit": "हृतस्वान् भ्रष्टचित्तांस्तान् हृतदारान् ऋतप्रियान् ।\nविहीनान् सर्वकामेभ्यो दासभावमुपागतान् ।\nधर्मपाशपरिक्षिप्तान् अशक्तानिव विक्रमे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2124019, "chapter_id": 3658, "verse_number": "१६", "content_sanskrit": "क्रुद्धाममर्षितां कृष्णां दुःखितां कुरुसंसदि ।\nदुर्योधनश्च कर्णश्च कटुकान्यभ्यभाषताम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2124020, "chapter_id": 3658, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2124021, "chapter_id": 3658, "verse_number": "१७", "content_sanskrit": "तस्याः कृपणचक्षुर्भ्यां प्रदह्येतापि मेदिनी ।\nअविशेषं भवेदेषां पुत्राणामपि सञ्जय ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2124022, "chapter_id": 3658, "verse_number": "१८", "content_sanskrit": "भारतानां स्त्रियः सर्वा गान्धार्या सह संयुताः ।\nप्राक्रोशन् भैरवं तत्र दृष्ट्वा कृष्णां सभागताम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2124023, "chapter_id": 3658, "verse_number": "१९", "content_sanskrit": "अग्निहोत्राणि सायाह्ने न चाहूयन्त सर्वशः ।\nब्राह्मणाः कुपिताश्चासन् द्रौपद्याः परिकर्षणे ।\nआसीन्निष्ठातपो घोरो निर्घातश्च महानभूत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2124024, "chapter_id": 3658, "verse_number": "२०", "content_sanskrit": "दिव उल्काश्चापतन्त राहुश्चार्कमुपाग्रसत् ।\nअपर्वणि महाघोरं प्राणिनां जनयन् भयम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2124025, "chapter_id": 3658, "verse_number": "२१", "content_sanskrit": "तथैव रथशालासु प्रादुरासीद्धुताशनः ।\nध्वजाश्चाप्यवशीर्यन्त भारतानामभूतये ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2124026, "chapter_id": 3658, "verse_number": "२२", "content_sanskrit": "दुर्योधनस्याग्निहोत्रे सृगालोऽत्यभषद् भृशम् ।\nतं तथा प्रत्यवाश्यन्त रासभाः सर्वतोदिशम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2124027, "chapter_id": 3658, "verse_number": "२३", "content_sanskrit": "प्रातिष्ठत तदा भीष्मो द्रोणेन सह सञ्जय ।\nकृपश्च सोमदत्तश्च बाह्लीकश्च महारथः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2124028, "chapter_id": 3658, "verse_number": "२४", "content_sanskrit": "ततोऽहमब्रुवं तत्र विदुरेणाभिचोदितः ।\nवरं ददामि कृष्णायै काङ्क्षितं यद्यदिच्छति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2124029, "chapter_id": 3658, "verse_number": "२५", "content_sanskrit": "साऽवृणोत् तत्र पाञ्चाली पाण्डवानमितौजसः ।\nसरथान् सधनुष्कांश्चाप्यन्वज्ञासिषमप्यहम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2124030, "chapter_id": 3658, "verse_number": "२६", "content_sanskrit": "अथाब्रवीन्महाप्राज्ञो विदुरः सर्वधर्मवित् ।\nएतदन्ताः स्थ भरता यद्वः कृष्णा सभागता ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2124031, "chapter_id": 3658, "verse_number": "२७", "content_sanskrit": "एषा पाञ्चालराजस्य सुतेष्टा श्रीरनुत्तमा ।\nपाञ्चाली पाण्डवानेतान् देवसृष्टोपसर्पति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2124032, "chapter_id": 3658, "verse_number": "२८", "content_sanskrit": "तस्याः पार्था परिक्लेशं न क्षमन्ते ह्यमर्षिणः ।\nवृष्णयो वा महेष्वासाः पाञ्चालाश्चामितौजसः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2124033, "chapter_id": 3658, "verse_number": "२९", "content_sanskrit": "तेन सत्याभिसन्धेन वासुदेवेन रक्षिताः ।\nआगमिष्यति बीभत्सुः पाञ्चालैश्चाभिसेवितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2124034, "chapter_id": 3658, "verse_number": "३०", "content_sanskrit": "तेषां मध्ये महेष्वासो भीमसेनो महाबलः ।\nआगमिष्यति धून्वानो गदां दण्डमिवान्तकः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2124035, "chapter_id": 3658, "verse_number": "३१", "content_sanskrit": "ततो गाण्डीवनिर्घोषं श्रुत्वा पार्थस्य धीमतः ।\nगदावेगं च भीमस्य नालं सोढुं नराधिपाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2124036, "chapter_id": 3658, "verse_number": "३२", "content_sanskrit": "तत्र मे रोचते नित्यं पार्थैः साम न विग्रहः ।\nकुरुभ्यो हि सदा मन्ये पाण्डवान् शक्तिमत्तरान् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2124037, "chapter_id": 3658, "verse_number": "३३", "content_sanskrit": "तथाऽतिबलवान् राजा जरासन्धो महाद्युतिः ।\nबाहुप्रहरणेनैव भीमेन निहतो युधि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2124038, "chapter_id": 3658, "verse_number": "३४", "content_sanskrit": "तस्य ते शम एवास्तु पाण्डवैर्भरतर्षभ ।\nउभयोः पक्षयोर्युक्तं क्रियतामविशङ्कया ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2124039, "chapter_id": 3658, "verse_number": "३५", "content_sanskrit": "एवं गावल्गणे क्षत्ता धर्मार्थसहितं वचः ।\nउक्तवान् न गृहीतं वै मया पुत्रहितेप्सुना ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2124040, "chapter_id": 3658, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2124041, "chapter_id": 3658, "verse_number": "३६", "content_sanskrit": "समाप्ते पर्वणि तदा स्वशक्त्या तर्पयेत् द्विजान् ।\nपर्वपर्वणि चावश्यं होमं कुर्यात् प्रयत्नतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2124042, "chapter_id": 3658, "verse_number": "३७", "content_sanskrit": "आदौ च वाचके देयं वस्त्रं गन्धसमन्वितम् ।\nसभापर्वणि राजेन्द्र हविष्यं भोजयेद् द्विजान् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2124043, "chapter_id": 3658, "verse_number": "३८", "content_sanskrit": "तर्पयेद् विविधैः कामैर्दानैश्चोच्चावचैस्तथा ।\nअतिरात्रस्य यज्ञस्य फलं प्राप्नोति मानवः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2124044, "chapter_id": 3658, "verse_number": "३९", "content_sanskrit": "प्राप्नुयाच्च क्रतुफलं नरः पुस्तकपूजने ।\nअपुत्रः पुत्रमाप्नोति पुत्रवान् लभते धनम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2124045, "chapter_id": 3658, "verse_number": "४०", "content_sanskrit": "पुत्रैर्धनैश्च सहितो यशः कीर्तिं च विन्दति ।\nश्रुत्वाख्यानमिदं पुण्यं निष्पापो जायते नरः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2124046, "chapter_id": 3658, "verse_number": "४१", "content_sanskrit": "एतत्सर्वं सभापर्व ह्याख्यातं ते महाविभो ।\nग्रन्थाग्रं सप्तके याते व्याप्तौ चाष्टसमाख्यया ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2124047, "chapter_id": 3658, "verse_number": "४२", "content_sanskrit": "श्लोकानां द्वे सहस्रे तु पञ्चश्लोकशतानि च ।\nवेदव्यासेन मुनिना पर्वण्यस्मिन् प्रकीर्तिताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2124048, "chapter_id": 3658, "verse_number": "८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि शततमोऽध्यायः ॥१००॥\n॥ अनुद्यूतपर्वणि अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2124049, "chapter_id": 3658, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि कविकुलतिलकभाविसमीरश्रीमद्वादिराजतीर्थपूज्यचरणविरचित-\nलक्षालङ्काराख्यटीका समाप्ता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2124050, "chapter_id": 3658, "verse_number": "", "content_sanskrit": "॥ समाप्तं सभापर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2124051, "chapter_id": 3658, "verse_number": "", "content_sanskrit": "॥ श्रीमध्वेशार्पणमस्तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]