[{"id": 2195833, "chapter_id": 5173, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195834, "chapter_id": 5173, "verse_number": "१", "content_sanskrit": "पितामहवचः श्रुत्वा गरुडः पततांवरः ।\nजगाम गोकुलं किञ्चिन्नवनीतजिहीर्षया\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195835, "chapter_id": 5173, "verse_number": "२", "content_sanskrit": "नवनीतं तथाऽपश्यन्मथितं कलशे स्थितम् ।\nतदादाय ततोऽगच्छद् यतस्तद् रक्ष्यतेऽमृतम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195836, "chapter_id": 5173, "verse_number": "३", "content_sanskrit": "स तत्र गत्वा पतगस्तिर्यक्तोयं महाबलः ।\nहुताशनमपक्रम्य नवनीतमपातयत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195837, "chapter_id": 5173, "verse_number": "४", "content_sanskrit": "सोऽर्चिष्मान् मन्दवेगोऽभूत् सर्पिषा तेन तर्पितः ।\nधूमकेतुर्न जज्वाल धूममेव ससर्ज ह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195838, "chapter_id": 5173, "verse_number": "५", "content_sanskrit": "तमतीत्याशु गरुडो हृष्टात्मा जातवेदसम् ।\nरक्षांसि समतिक्रामत् पक्षवातेन पातयन्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195839, "chapter_id": 5173, "verse_number": "६", "content_sanskrit": "ते पतन्ति शिरोभिश्च जानुभिश्चरणैस्तथा ।\nउत्सृज्य शस्त्रावरणं पक्षिपक्षसमाहताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195840, "chapter_id": 5173, "verse_number": "७", "content_sanskrit": "उत्प्लुत्य चावृतान्नागान् हत्वा चक्रं व्यतीत्य च ।\nअरान्तरेण शिरसा भित्त्वा जालं समाद्रवत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195841, "chapter_id": 5173, "verse_number": "८", "content_sanskrit": "स भित्त्वा शिरसा जालं वज्रवेगसमो बली ।\nउज्जहार ततः शीघ्रममृतं भुजगाशनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195842, "chapter_id": 5173, "verse_number": "९", "content_sanskrit": "तदादायाद्रवच्छीघ्रं गरुडः श्वसनो यथा ।\nअथ सन्नाहमकरोद् वृत्रहा विबुधैः सह\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195843, "chapter_id": 5173, "verse_number": "१०", "content_sanskrit": "ततो मातलिसंयुक्तं हरिभिः स्वर्णमालिभिः ।\nआरुरोह रथं शीघ्रं सूर्याग्निसमतेजसम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195844, "chapter_id": 5173, "verse_number": "११", "content_sanskrit": "सोऽभ्यद्रवत् पक्षिराजं वृत्रहा पाकशासनः ।\nउद्यम्य निशितं वज्रं वज्रहस्तो महाबलः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2195845, "chapter_id": 5173, "verse_number": "१२", "content_sanskrit": "तथैव गरुडो राजन् वज्रहस्तं समाद्रवत् ।\nततो वै मातलिं प्राह शीघ्रं वाहय वाजिनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2195846, "chapter_id": 5173, "verse_number": "१३", "content_sanskrit": "अथ दिव्यं महाघोरं गरुडाय ससर्ज ह ।\nवज्रं सहस्रनयनस्तिग्मवेगपराक्रमः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2195847, "chapter_id": 5173, "verse_number": "१४", "content_sanskrit": "उत्सिसृक्षन्तमाज्ञाय वज्रं वै त्रिदशेश्वरम् ।\nतूर्णं वेगतरो भूत्वा जगाम पततांवरः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2195848, "chapter_id": 5173, "verse_number": "१५", "content_sanskrit": "पितामहनिसर्गेण ज्ञात्वा लब्धवरः खगः ।\nआयुधानां वरं वज्रमथ शक्रमुवाच ह\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2195849, "chapter_id": 5173, "verse_number": "१६", "content_sanskrit": "वृत्रहन्नेष वज्रस्ते वरो लब्धः पितामहात् ।\nअतः सम्मानमाकाङ्क्षन् मुञ्चाम्येकं तनूरुहम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2195850, "chapter_id": 5173, "verse_number": "१७", "content_sanskrit": "एतेनायुधराजेन यदि शक्तोसि वृत्रहन् ।\nहन्यास्त्वं परया शक्त्या गच्छाम्यहमनामयः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2195851, "chapter_id": 5173, "verse_number": "१८", "content_sanskrit": "तत्तु तूर्णं तदा वज्रं स्वेन वेगेन भारत ।\nजघान परया शक्त्या न चैनमदहद् भृशम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2195852, "chapter_id": 5173, "verse_number": "१९", "content_sanskrit": "ततो देवर्षयो राजन् गच्छन्तो वै विहायसा ।\nदृष्ट्वा वज्रं विषक्तं तं पक्षिपर्णेऽब्रुवन् वचः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2195853, "chapter_id": 5173, "verse_number": "२०", "content_sanskrit": "सुपर्णः पक्षिगरुडो यस्य पर्णे वरायुधम् ।\nविषक्तं देवराजस्य वृत्रहन्तुः सनातनम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2195854, "chapter_id": 5173, "verse_number": "२१", "content_sanskrit": "एवं सुपर्णो विहगो वैनतेयः प्रतापवान् ।\nऋषयस्तं विजानन्ति चाग्नेयं वैष्णवं पुनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2195855, "chapter_id": 5173, "verse_number": "२२", "content_sanskrit": "वेदाभिष्टुतमत्यर्थं स्वर्गमार्गफलप्रदम् ।\nतनुपर्णं सुपर्णस्य जगृहुर्बर्हिणस्तथा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2195856, "chapter_id": 5173, "verse_number": "२३", "content_sanskrit": "मयूरा विस्मिताः सर्वे आद्रवन्ति स्म वज्रिणम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2195857, "chapter_id": 5173, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे गरुडोपाख्याने सुपर्णस्य सुपर्णत्वं नाम चतुर्विंशोऽध्यायः ॥२४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]