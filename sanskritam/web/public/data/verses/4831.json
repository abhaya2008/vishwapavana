[{"id": 2180832, "chapter_id": 4831, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2180833, "chapter_id": 4831, "verse_number": "१", "content_sanskrit": "ततः स च हृषीकेशः स च राजा युधिष्ठिरः ।\nकृपादयश्च ते सर्वे चत्वारः पाण्डवाश्च ह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2180834, "chapter_id": 4831, "verse_number": "२", "content_sanskrit": "रथैस्ते नगराकारैः पताकाध्वजशोभितैः ।\nययुराशु कुरुक्षेत्रं वाजिभिः शीघ्रगामिभिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2180835, "chapter_id": 4831, "verse_number": "३", "content_sanskrit": "तेऽवतीर्य कुरुक्षेत्रं केशमज्जास्थिसङ्कुलम् ।\nदेहन्यासः कृतो यत्र क्षत्रियैस्तैर्महात्मभिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2180836, "chapter_id": 4831, "verse_number": "४", "content_sanskrit": "गजाश्वदेहास्थिचयैः पर्वतैरिव सञ्चितम् ।\nनरशीर्षकपालैश्च शङ्खैरिव समाचितम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2180837, "chapter_id": 4831, "verse_number": "५", "content_sanskrit": "चितासहस्रैर्निचितं वर्मशस्त्रसमाकुलम् ।\nआपानभूमिं कालस्य तदा भुक्तोज्झितामिव\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2180838, "chapter_id": 4831, "verse_number": "६", "content_sanskrit": "भूतसङ्घानुचरितं रक्षोगणनिषेवितम् ।\nपश्यन्तस्ते कुरुक्षेत्रं ययुराशु महारथाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2180839, "chapter_id": 4831, "verse_number": "७", "content_sanskrit": "गच्छन्नेव महाबाहुः सर्वयादवनन्दनः ।\nयुधिष्ठिराय प्रोवाच जामदग्न्यस्य विक्रमम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2180840, "chapter_id": 4831, "verse_number": "८", "content_sanskrit": "अमी रामह्रदाः पञ्च दृश्यन्ते पार्थ दूरतः ।\nयेषु सन्तर्पयामास पूर्वान् क्षत्रियशोणितैः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2180841, "chapter_id": 4831, "verse_number": "९", "content_sanskrit": "त्रिःसप्तकृत्वो वसुधां कृत्वा निःक्षत्रियां प्रभुः ।\nइहेदानीं ततो रामः कर्मणो विरराम ह\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2180842, "chapter_id": 4831, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2180843, "chapter_id": 4831, "verse_number": "१०", "content_sanskrit": "त्रिःसप्तकृत्वः पृथिवी कृता निःक्षत्रिया तदा ।\nरामेणेति यदात्थ त्वमत्र मे संशयो महान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2180844, "chapter_id": 4831, "verse_number": "११", "content_sanskrit": "क्षत्रबीजं यदा दग्धं रामेण यदुपुङ्गव ।\nकथं भूयः समुत्पत्तिः क्षत्रस्यामितविक्रम\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2180845, "chapter_id": 4831, "verse_number": "१२", "content_sanskrit": "महात्मना भगवता रामेण यदुपुङ्गव ।\nकथमुत्सादितं क्षत्रं कथं वृद्धिं पुनर्गतम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2180846, "chapter_id": 4831, "verse_number": "१३", "content_sanskrit": "महाभारतयुद्धे हि कोटिशः क्षत्रिया हताः ।\nतथाभूच्च मही कीर्णा क्षत्रियैर्वदतां वर\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2180847, "chapter_id": 4831, "verse_number": "१४", "content_sanskrit": "किमर्थं भार्गवेणेदं क्षत्रमुत्सादितं पुरा ।\nरामेण यदुशार्दूल कुरुक्षेत्रे महात्मना\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2180848, "chapter_id": 4831, "verse_number": "१५", "content_sanskrit": "एतं मे छिन्धि वार्ष्णेय संशयं तार्क्ष्यकेतन ।\nआगमो हि परः कृष्ण त्वत्तो नो वासवानुज\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2180849, "chapter_id": 4831, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2180850, "chapter_id": 4831, "verse_number": "१६", "content_sanskrit": "ततो व्रजन्नेव गदाग्रजः प्रभुः\nशशंस तस्मै निखिलेन तत्त्वतः ।\nयुधिष्ठिरायाप्रतिमौजसे तदा\nयथाऽभवत् क्षत्रियसङ्कुला मही\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2180851, "chapter_id": 4831, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे अष्टचत्वारिंशोऽध्यायः ॥ ४८ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]