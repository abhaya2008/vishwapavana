[{"id": 2029811, "chapter_id": 1651, "verse_number": "३-२८९-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029812, "chapter_id": 1651, "verse_number": "३-२८९-१", "content_sanskrit": "ततः श्रुत्वाहतं सङ्ख्ये कुम्भकर्णं सहानुगम्।\nप्रहस्तं च महेष्वासं धूम्राक्षं चातितेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029813, "chapter_id": 1651, "verse_number": "३-२८९-२", "content_sanskrit": "पुत्रमिनद्रजितं वीरं रावणः प्रत्यभाषत।\nजहिरामममित्रघ्न सुग्रीवं च सलक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029814, "chapter_id": 1651, "verse_number": "३-२८९-३", "content_sanskrit": "त्वया हि मम सत्पुत्र यशो दीप्तमुपार्जितम्।\nजित्वावज्रधरं सङ्ख्ये सहस्राक्षं शचीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029815, "chapter_id": 1651, "verse_number": "३-२८९-४", "content_sanskrit": "अन्तर्हितः प्रकाशो वा दिव्यैर्दत्तवरैः शरैः।\nजहि शत्रूनमित्रघ्न मम शस्त्रभृतांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029816, "chapter_id": 1651, "verse_number": "३-२८९-५", "content_sanskrit": "रामलक्ष्मणसुग्रीवाः शरस्पर्शं न तेऽनघ।\nसमर्थाः प्रतिसोढुं च कुतस्तदनुयायिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029817, "chapter_id": 1651, "verse_number": "३-२८९-६", "content_sanskrit": "अगता या प्रहस्तेन कुम्भकर्णेन चानघ।\nखरस्यापचितिः सङ्ख्ये तां गच्छ त्वे महाभुज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029818, "chapter_id": 1651, "verse_number": "३-२८९-७", "content_sanskrit": "त्वमद्य निशितैर्बाणैर्हत्वा शत्रून्ससैनिकान्।\nप्रतिनन्दय मां पुत्र पुरा जित्वेव वासवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029819, "chapter_id": 1651, "verse_number": "३-२८९-८", "content_sanskrit": "इत्युक्तः स तथेत्युक्त्वा रथमास्थाय दंशिथः।\nप्रययाविन्द्रजिद्राजंस्तूर्णमायोधनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029820, "chapter_id": 1651, "verse_number": "३-२८९-९", "content_sanskrit": "ततो विश्राव्य विस्पष्टं नाम राक्षसपुङ्गवः।\nआह्वयामास समरे लक्ष्मणं शुभलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029821, "chapter_id": 1651, "verse_number": "३-२८९-१०", "content_sanskrit": "तं लक्ष्मणोऽभ्यधावच्च प्रगृह्य सशरं धनुः।\nत्रासयंस्तलघोषेण सिंहः क्षुद्रमृगं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029822, "chapter_id": 1651, "verse_number": "३-२८९-११", "content_sanskrit": "तयोः समभवद्युद्धं सुमहज्जयगृद्धिनोः।\nदिव्यास्त्रविदुपोस्तीव्रमन्योन्यस्पर्धिनोस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029823, "chapter_id": 1651, "verse_number": "३-२८९-१२", "content_sanskrit": "रावणिस्तु यदा नैनं विशेषयति सायकैः।\nततो गुरुतरं यत्नमातिष्ठद्बलिनां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029824, "chapter_id": 1651, "verse_number": "३-२८९-१३", "content_sanskrit": "तत एवं महावेगैरर्दयामास तोमरैः।\nतानागतान्स चिच्छेद सौमित्रिर्निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029825, "chapter_id": 1651, "verse_number": "३-२८९-१४", "content_sanskrit": "ते निकृत्ताः शरैस्तीक्ष्णैर्न्यपतन्धरणीतले।\n`साधका रावणेराजौ शतशः शकलीकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029826, "chapter_id": 1651, "verse_number": "३-२८९-१५", "content_sanskrit": "तमङ्गदो वालिसुतः श्रीमानुद्यम्य पादपम्।\nअभिद्रुत्य महावेगस्ताडयामास मूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029827, "chapter_id": 1651, "verse_number": "३-२८९-१६", "content_sanskrit": "तस्येन्द्रजिदसंभ्रान्तः प्रासेनोरसि वीर्यवान्।\nप्रहर्तुमैच्छत्तं चास्य प्रासं चिच्छेद लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029828, "chapter_id": 1651, "verse_number": "३-२८९-१७", "content_sanskrit": "तमभ्याशगतं वीरमङ्गदं रावणात्मजः।\nगदयाऽताडयत्सव्ये पार्श्वेवानरपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029829, "chapter_id": 1651, "verse_number": "३-२८९-१८", "content_sanskrit": "तमचिन्त्य प्रहारं स बलवान्वालिनः सुतः।\nससर्जेन्द्रजितः क्रोधात्सालस्कन्धं तथाङ्गदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029830, "chapter_id": 1651, "verse_number": "३-२८९-१९", "content_sanskrit": "सोऽङ्गदेन रुपोत्सृष्टो वधायेन्द्रजितस्तरुः।\nजघानेन्द्रजितः पार्थ रथं साश्वं ससारथिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029831, "chapter_id": 1651, "verse_number": "३-२८९-२०", "content_sanskrit": "ततो हताश्वात्प्रस्कन्द्य रथात्स हतसारथिः।\nतत्रैवान्तर्दधे राजन्मायया रावणात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2029832, "chapter_id": 1651, "verse_number": "३-२८९-२१", "content_sanskrit": "अन्तर्हितं विदित्वा तं बहुमायं च राक्षसम्।\nरामस्तं देशमागम्य तत्सैन्यं पर्यरक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2029833, "chapter_id": 1651, "verse_number": "३-२८९-२२", "content_sanskrit": "स राममुद्दिश्य शरैस्ततो दत्तवरैस्तदा।\nविव्याध सर्वगात्रेषु लक्ष्मणं च महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2029834, "chapter_id": 1651, "verse_number": "३-२८९-२३", "content_sanskrit": "तमदृश्यंशरैः शूरौ माययाऽन्तर्हितं तदा।\nयोधयामासतुरुभौ रावणिं रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2029835, "chapter_id": 1651, "verse_number": "३-२८९-२४", "content_sanskrit": "स रुषा सर्वगात्रेषु तयोः पुरुषसिंहयोः।\nव्यसृजत्सायकान्भूयः शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2029836, "chapter_id": 1651, "verse_number": "३-२८९-२५", "content_sanskrit": "तमदृश्यं विचिन्वन्तः सृजन्तमनिशं शरान्।\nहरयो विविशुर्व्योम प्रगृह्य महतीः शिलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2029837, "chapter_id": 1651, "verse_number": "३-२८९-२६", "content_sanskrit": "तांश्च तौ चाप्यदृश्यः सशरैर्विव्याध राक्षसः।\nस भृशं ताडयामास रावणिर्मायया वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2029838, "chapter_id": 1651, "verse_number": "३-२८९-२७", "content_sanskrit": "तौ शरैरर्दितौ वीरौ भ्रारौ रामलक्ष्मणौ।\nपेततुर्गगनाद्भूमिं सूर्याचन्द्रमसाविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2029839, "chapter_id": 1651, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वणि एकोननवत्यधिकद्विशततमोऽध्यायः ॥ २८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]