[{"id": 6000216000, "chapter_id": 10216, "verse_number": null, "content_sanskrit": "अथ विंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000216001, "chapter_id": 10216, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.001.m4a", "display_order": 2}, {"id": 6000216002, "chapter_id": 10216, "verse_number": "१०-२०-१", "content_sanskrit": "हेमन्ते प्रथमे मासि नन्दव्रजकुमारिकाः।\nचेरुर्हविष्यं भुञ्जानाः कात्यायन्यर्चनव्रतम्॥ १०/२०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.002.m4a", "display_order": 3, "topics": [{"text": "व्रजकुमारीभिः अस्माकं श्रीकृष्णः पतिर्भूयादिति कात्यायनीव्रताचरणम्", "range": "१–७"}]}, {"id": 6000216003, "chapter_id": 10216, "verse_number": "१०-२०-२", "content_sanskrit": "आप्लुत्याम्भसि कालिन्द्या जलान्ते चोदितेऽरुणे।\nकृत्वा प्रतिकृतिं देवीमानर्चुर्नृप सैकतीम्॥ १०/२०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.003.m4a", "display_order": 4}, {"id": 6000216004, "chapter_id": 10216, "verse_number": "१०-२०-३", "content_sanskrit": "गन्धैर्माल्यैः सुरभिभिर्बलिभिर्धूपदीपकैः।\nउच्चावचैश्चोपहारैः प्रवालफलतण्डुलैः॥ १०/२०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.004.m4a", "display_order": 5}, {"id": 6000216005, "chapter_id": 10216, "verse_number": "१०-२०-४", "content_sanskrit": "‘कात्यायनि महामाये महायोगिन्यधीश्वरि।\nनन्दगोपसुतं देवि पतिं मे कुरु ते नमः’॥ १०/२०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.005.m4a", "display_order": 6}, {"id": 6000216006, "chapter_id": 10216, "verse_number": "१०-२०-५", "content_sanskrit": "इति मन्त्रं जपन्त्यस्ताः पूजां चक्रुः कुमारिकाः।\nउषस्यभ्येत्य ताः स्वैरमन्योन्याबद्धबाहवः॥ १०/२०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.006.m4a", "display_order": 7}, {"id": 6000216007, "chapter_id": 10216, "verse_number": "१०-२०-६", "content_sanskrit": "कृष्णमुच्चैर्जगुर्यान्त्यः कालिन्द्यां स्नातुमन्वहम्।\nएवं मासव्रतं चेरुः कुमार्यः कृष्णचेतसः॥ १०/२०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.007.m4a", "display_order": 8}, {"id": 6000216008, "chapter_id": 10216, "verse_number": "१०-२०-७", "content_sanskrit": "भद्रकालीं समानर्चुर्भूयान्नन्दस्नुषा इति। नदीं कदाचिदागत्य तीरे निक्षिप्य पूर्ववत्।\nवासांसि कृष्णं गायन्त्यो विजह्रुः सलिले मुदा॥ १०/२०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.008.m4a", "display_order": 9}, {"id": 6000216009, "chapter_id": 10216, "verse_number": "१०-२०-८", "content_sanskrit": "भगवांस्तदभिप्रेत्य कृष्णो योगेश्वरेश्वरः।\nवयस्यैरागतस्तत्र वृतस्तत्कर्मसिद्धये॥ १०/२०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.009.m4a", "display_order": 10, "topics": [{"text": "श्रीकृष्णेन तासां वस्त्रापहरणं वरदानं च", "range": "८–२८"}]}, {"id": 6000216010, "chapter_id": 10216, "verse_number": "१०-२०-९", "content_sanskrit": "तासां वासांस्युपादाय नीपमारुह्य सत्वरः।\nहसद्भिः प्रहसन् बालैः परिहासमुवाच ह॥ १०/२०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.010.m4a", "display_order": 11}, {"id": 6000216011, "chapter_id": 10216, "verse_number": "१०-२०-१०", "content_sanskrit": "अत्रागत्याबलाः कामं स्वंस्वं वासः प्रगृह्यताम्।\nसत्यं ब्रवाणि नो नर्म यद् यूयं व्रतकर्शिताः॥ १०/२०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.011.m4a", "display_order": 12}, {"id": 6000216012, "chapter_id": 10216, "verse_number": "१०-२०-११", "content_sanskrit": "न मयोदितपूर्वं वा अनृतं तदिमे विदुः।\nएकैकशः प्रतीच्छन्तु सहैवोत सुमध्यमाः॥ १०/२०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.012.m4a", "display_order": 13}, {"id": 6000216013, "chapter_id": 10216, "verse_number": "१०-२०-१२", "content_sanskrit": "तस्य तत् क्ष्वेलितं दृष्ट्वा गोप्यः प्रेमपरिप्लुताः।\nव्रीडिताः प्रेक्ष्य चान्योन्यं जातहासा न निर्ययुः॥ १०/२०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.013.m4a", "display_order": 14}, {"id": 6000216014, "chapter_id": 10216, "verse_number": "१०-२०-१३", "content_sanskrit": "एवं ब्रुवति गोविन्दे नर्मणाऽऽक्षिप्तचेतसः।\nआकण्ठमग्नाः शीतोदे वेपमानास्तमब्रुवन्॥ १०/२०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.014.m4a", "display_order": 15}, {"id": 6000216015, "chapter_id": 10216, "verse_number": "१०-२०-१४", "content_sanskrit": "माऽनयं त्वं कृथाः त्वां तु नन्दराजसुतं प्रियम्।\nजानीमोऽङ्गव्रज श्लाघ्यं देहि वासांसि वेपिताः॥ १०/२०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.015.m4a", "display_order": 16}, {"id": 6000216016, "chapter_id": 10216, "verse_number": "१०-२०-१५", "content_sanskrit": "स्याम सुन्दर ते दास्यः करवाम तवोदितम्। देहि वासांसि धर्मज्ञ वेपितानां महाबल।\nशीतार्दितानां बालानां नो चेद् राज्ञे ब्रुवामहे॥ १०/२०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.016.m4a", "display_order": 17}, {"id": 6000216017, "chapter_id": 10216, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.017.m4a", "display_order": 18}, {"id": 6000216018, "chapter_id": 10216, "verse_number": "१०-२०-१६", "content_sanskrit": "भवन्त्यो यदि मे दास्यो मयोक्तं वा करिष्यथ। अत्रागत्य स्ववासांसि प्रतीच्छत सुमध्यमाः ।\nनो चेन्नाहं प्रदास्ये किं क्रुद्धो राजा करिष्यति॥ १०/२०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.018.m4a", "display_order": 19}, {"id": 6000216019, "chapter_id": 10216, "verse_number": "१०-२०-१७", "content_sanskrit": "ततो जलाशयात् सर्वा दारिकाः शीतवेपिताः।\nपाणिभ्यां योनिमाच्छाद्य प्रोत्तेरुस्तीरमङ्गनाः॥ १०/२०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.019.m4a", "display_order": 20}, {"id": 6000216020, "chapter_id": 10216, "verse_number": "१०-२०-१८", "content_sanskrit": "भगवानथ ता वीक्ष्य मुग्धभावप्रसादितः।\nस्कन्धे निधाय वासांसि प्रीतः प्रोवाच सस्मितः॥ १०/२०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.020.m4a", "display_order": 21}, {"id": 6000216021, "chapter_id": 10216, "verse_number": "१०-२०-१९", "content_sanskrit": "यूयं विवस्‍त्रा यदपो धृतव्रता व्यगाहतैतद् तदु देवहेलनम्।\nबद्ध्वाऽञ्जलिं मूर्ध्न्यपनुत्तयेंऽहसः कृत्वा नमो वो वसनं प्रगृह्यताम्॥ १०/२०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.021.m4a", "display_order": 22}, {"id": 6000216022, "chapter_id": 10216, "verse_number": "१०-२०-२०", "content_sanskrit": "इत्यच्युतेनाभिहिता व्रजाबला मत्वा विवस्‍त्राप्लवनं व्रतच्युतिम्।\nतत्पूर्तिकामास्तदशेषकर्मणां साक्षात्कृतं नेमुरवद्यमुज्झितुम्॥ १०/२०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.022.m4a", "display_order": 23}, {"id": 6000216023, "chapter_id": 10216, "verse_number": "१०-२०-२१", "content_sanskrit": "तास्तथाऽमूर्नता दृष्ट्वा भगवान् देवकीसुतः।\nवासांसि ताभ्यः प्रायच्छत् करुणः स्नेहतोषितः॥ १०/२०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.023.m4a", "display_order": 24}, {"id": 6000216024, "chapter_id": 10216, "verse_number": "१०-२०-२२", "content_sanskrit": "दृढं प्रलब्धास्‍त्रपया च हापिताः प्रस्तोभिताः क्रीडनवच्च कारिताः।\nवस्‍त्राणि चैवापहृतान्यथाप्यमुं ता नाभ्यसूयन् प्रियसङ्गनिर्वृताः॥ १०/२०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.024.m4a", "display_order": 25}, {"id": 6000216025, "chapter_id": 10216, "verse_number": "१०-२०-२३", "content_sanskrit": "परिधाय स्ववासांसि प्रेष्ठसङ्गमसज्जिताः।\nगृहीतचित्ता नोच्चेलुस्तस्मिंल्लज्जेषितेक्षणाः॥ १०/२०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.025.m4a", "display_order": 26}, {"id": 6000216026, "chapter_id": 10216, "verse_number": "१०-२०-२४", "content_sanskrit": "तासां विज्ञाय भगवान् स्वपादस्पर्शकाम्यया।\nधृतव्रतानां सङ्कल्पमाह दामोदरोऽबलाः॥ १०/२०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.026.m4a", "display_order": 27}, {"id": 6000216027, "chapter_id": 10216, "verse_number": "१०-२०-२५", "content_sanskrit": "सङ्कल्पो विदितः साध्व्यो भवतीनां मदर्चनम्।\nमयाऽनुमोदितः सोऽसौ सत्यो भवितुमर्हति॥ १०/२०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.027.m4a", "display_order": 28}, {"id": 6000216028, "chapter_id": 10216, "verse_number": "१०-२०-२६", "content_sanskrit": "न मय्यावेशितधियां कामः कामाय कल्पते।\nभर्जिता क्‍वथिता धाना प्रायो बीजाय नेष्यते॥ १०/२०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.028.m4a", "display_order": 29}, {"id": 6000216029, "chapter_id": 10216, "verse_number": "१०-२०-२७", "content_sanskrit": "याताबला व्रजं सिद्धा मयेमा रंस्यथ क्षपाः।\nयदुद्दिश्य व्रतमिदं चरथार्चार्चनं सतीः॥ १०/२०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.029.m4a", "display_order": 30}, {"id": 6000216030, "chapter_id": 10216, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.030.m4a", "display_order": 31}, {"id": 6000216031, "chapter_id": 10216, "verse_number": "१०-२०-२८", "content_sanskrit": "इत्यादिष्टा भगवता लब्धकामाः कुमारिकाः।\nध्यायन्त्यस्तत्पदाम्भोजं कृच्छ्रान्निर्विविशुर्व्रजम्॥ १०/२०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.031.m4a", "display_order": 32}, {"id": 6000216032, "chapter_id": 10216, "verse_number": "१०-२०-२९", "content_sanskrit": "अथ गोपैः परिवृतो भगवान् देवकीसुतः।\nवृन्दावनाद् गतो दूरं चारयन् गाः सहाग्रजः॥ १०/२०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.032.m4a", "display_order": 33, "topics": [{"text": "निदाघकाले कृष्णेन सह वने गाश्चारयतां गोपानां बुभुक्षाधिगमः", "range": "२९–३९"}]}, {"id": 6000216033, "chapter_id": 10216, "verse_number": "१०-२०-३०", "content_sanskrit": "निदाघार्कातपे तिग्मे छायाभिः स्वाभिरात्मनः।\nआतपत्रायितान् वीक्ष्य द्रुमानाह व्रजौकसः॥ १०/२०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.033.m4a", "display_order": 34}, {"id": 6000216034, "chapter_id": 10216, "verse_number": "१०-२०-३१", "content_sanskrit": "हे स्तोक कृष्ण हे अंशो श्रीदामन् सुबलार्जुन।\nविशालर्षभ तेजस्विन् देवप्रस्थ वरूथप॥ १०/२०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.034.m4a", "display_order": 35}, {"id": 6000216035, "chapter_id": 10216, "verse_number": "१०-२०-३२", "content_sanskrit": "पश्यतैतान् महाभागान् परार्थैकान्तजीविनः।\nवातवर्षातपहिमान् सहन्तो वारयन्ति नः॥ १०/२०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.035.m4a", "display_order": 36}, {"id": 6000216036, "chapter_id": 10216, "verse_number": "१०-२०-३३", "content_sanskrit": "अहो एषां वरं जन्म सर्वप्राण्युपजीवनम्।\nसुजनस्येव येषां वै विमुखा यान्ति नार्थिनः॥ १०/२०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.036.m4a", "display_order": 37}, {"id": 6000216037, "chapter_id": 10216, "verse_number": "१०-२०-३४", "content_sanskrit": "पत्रपुष्पफलच्छायामूलवल्कलदारुभिः।\nगन्धनिर्यासभस्मास्थितोक्मैः कामान् वितन्वते॥ १०/२०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.037.m4a", "display_order": 38}, {"id": 6000216038, "chapter_id": 10216, "verse_number": "१०-२०-३५", "content_sanskrit": "एतावज्जन्मसाफल्यं देहिनामिह देहिषु।\nप्राणैरर्थैर्धिया वाचा श्रेयआचरणं सदा॥ १०/२०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.038.m4a", "display_order": 39}, {"id": 6000216039, "chapter_id": 10216, "verse_number": "१०-२०-३६", "content_sanskrit": "इति प्रवालस्तबकफलमूलदलोत्करैः।\nतरूणां नम्रशाखानां मध्येन यमुनां गतः॥ १०/२०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.039.m4a", "display_order": 40}, {"id": 6000216040, "chapter_id": 10216, "verse_number": "१०-२०-३७", "content_sanskrit": "तत्र गाः पाययित्वाऽपः सुमृष्टाः शीतलाः शिवाः।\nततो नृप स्वयं गोपाः कामं स्वादु पपुर्जलम्॥ १०/२०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.040.m4a", "display_order": 41}, {"id": 6000216041, "chapter_id": 10216, "verse_number": "१०-२०-३८", "content_sanskrit": "तस्या उपवने कामं चारयन्तः पशून् नृप।\nकृष्णरामावुपागम्य क्षुधार्ता इदमब्रुवन्॥ १०/२०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_020/BhP_10.020.041.m4a", "display_order": 42}, {"id": 6000216042, "chapter_id": 10216, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे विंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]