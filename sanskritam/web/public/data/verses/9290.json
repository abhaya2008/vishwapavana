[{"id": 40018615, "chapter_id": 9290, "verse_number": "1", "content_sanskrit": "शक्त्याविनिहतंदृष्टवारावणेनबलीयसा । लक्ष्मणंसमरेशूरंरूधिरौघपरिप्लुतम् ॥ स दत्त्वातुमुलंयुद्धंरावणस्यदुरात्मनः । विसृजन्नेवबाणौघान् सुषेणमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018616, "chapter_id": 9290, "verse_number": "2", "content_sanskrit": "शक्त्याविनिहतंदृष्टवारावणेनबलीयसा । लक्ष्मणंसमरेशूरंरूधिरौघपरिप्लुतम् ॥ स दत्त्वातुमुलंयुद्धंरावणस्यदुरात्मनः । विसृजन्नेवबाणौघान् सुषेणमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018617, "chapter_id": 9290, "verse_number": "3", "content_sanskrit": "एषरावणवीर्येणलक्ष्मणःपतितोभुविः । सर्पवच्चेष्टतेवीरोभूमौशोकमुदिरीयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018618, "chapter_id": 9290, "verse_number": "4", "content_sanskrit": "शोणितार्द्रमिमंवीरंप्राणैःप्रियतरंमम । पश्यतोममकाशक्तिर्योद्धुंपर्याकुलात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018619, "chapter_id": 9290, "verse_number": "5", "content_sanskrit": "अ यं स समरश्लाघीभ्रातामेशुभलक्षणः । यदिपञ्चत्वमापन्नःप्राणैर्मेकिंसुखेनवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018620, "chapter_id": 9290, "verse_number": "6", "content_sanskrit": "लज्जतीवहिवीर्यंभ्रश्यतीवकराद्धनुः । सायकाव्यवसीदन्तिदृष्टिर्भाष्पवशंगता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018621, "chapter_id": 9290, "verse_number": "7", "content_sanskrit": "अवसीदन्तिगात्राणिस्वप्नयानेनृणामिव । चिन्तामेवर्ततेतीव्रामुमूर्षापि च जायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018622, "chapter_id": 9290, "verse_number": "8", "content_sanskrit": "भ्रातरंनिहतंदृष्टवारावणेनदुरात्मना । विष्टनन्तंतुदुःखार्तंमर्मण्यभिहतंभृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018623, "chapter_id": 9290, "verse_number": "9", "content_sanskrit": "राघवोभ्रातरंदृष्टवाप्रियंप्राणंबहिश्चरम् । दुःखेनमहताविष्टोध्यानशोकपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018624, "chapter_id": 9290, "verse_number": "10", "content_sanskrit": "परंविषादमापन्नोविललापाकुलेन्द्रियः । भ्रातरंनिहतंदृष्टवालक्ष्मणंरणपांसुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018625, "chapter_id": 9290, "verse_number": "11", "content_sanskrit": "विजयोऽपिहिमेशूर न प्रियायोपकल्पते । अचक्षुर्विषयश्चन्द्रःकांप्रीतिंजनयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018626, "chapter_id": 9290, "verse_number": "12", "content_sanskrit": "किंमेयुद्धेनकिंप्राणैर्युद्धकार्यं न विद्यते । यत्रायंनिहतश्शेतेरणमूर्धनिलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018627, "chapter_id": 9290, "verse_number": "13", "content_sanskrit": "यथैवमांवनंयान्तमनुयातिमहाद्युतिः । अहमप्युपयास्यामितथैवैनंयमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018628, "chapter_id": 9290, "verse_number": "14", "content_sanskrit": "इष्टबन्धुजनोनित्यंमां स नित्यमनुव्रतः । इमामवस्थांगमितोराक्षसैःकूटयोधिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018629, "chapter_id": 9290, "verse_number": "15", "content_sanskrit": "देशेदेशेकलत्राणिदेशेदेशे च बान्दवाः । तंतुदेशं न पश्यामियत्रभ्रातासहोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40018630, "chapter_id": 9290, "verse_number": "16", "content_sanskrit": "इत्येवंविलपन्तंतंशोकविह्वलितेद्रनियम् । विवेष्टमानंकरुणमच्छवसन्तंपुनःपुनः ॥ राममाश्वासयनवीरसुषेनोवाक्यमब्रवीत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40018631, "chapter_id": 9290, "verse_number": "17", "content_sanskrit": "किनुराज्येनदुर्धर्षलक्ष्मणेनविनामम । कथंवक्ष्याम्यहंत्वम्बांसुमित्रांपुत्रवत्सलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40018632, "chapter_id": 9290, "verse_number": "18", "content_sanskrit": "न मृथोयंमहाबाहो लक्ष्मणोलक्षमिवर्धन: । न चास्यविक्रतंवक्त्रानापिशस्वासं न निष्प्रभं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018633, "chapter_id": 9290, "verse_number": "19", "content_sanskrit": "सुप्रभंसुप्रसन्नं च मुखमस्यनिरीक्ष्यताम् ॥ पद्मपत्रतलौहस्तौसुप्रसन्ने च लोचने ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018634, "chapter_id": 9290, "verse_number": "20", "content_sanskrit": "ऐ वं न विद्यतेरूपंगतासूनांविशम्पते ॥ माविषादंमृकृथावीरसप्राणोऽयमरिन्दम ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018635, "chapter_id": 9290, "verse_number": "21", "content_sanskrit": "आ ख्यासतितुप्रसुप्तस्यस्रस्तगात्रस्यभूतले ॥ सोच्छवासंहृदयंवीरकम्पमानंमुहुर्मुहुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audi