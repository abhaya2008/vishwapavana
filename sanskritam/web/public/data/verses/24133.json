[{"id": 7004133000, "chapter_id": 24133, "verse_number": "४-८२-१", "content_sanskrit": "पार्वत्युवाच ।\nवीरेशस्य महेशान श्रूयते महिमा महान् ।\nपरां सिद्धिं परोपतुस्तत्र सिद्धाः परः शताः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004133001, "chapter_id": 24133, "verse_number": "४-८२-२", "content_sanskrit": "कथमाविर्भवस्तस्य काश्यां लिंगवरस्य तु ।\nआशुसिद्धिप्रदस्येह तन्मे ब्रूहि जगत्पते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004133002, "chapter_id": 24133, "verse_number": "४-८२-३", "content_sanskrit": "महेश्वर उवाच ।\nनिशामय महादेवि वीरेशाविर्भवं परम् ।\nयं श्रुत्वापि नरः पुण्यं प्राप्नोति विपुलं शिवे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004133003, "chapter_id": 24133, "verse_number": "४-८२-४", "content_sanskrit": "आसीदमित्रजिन्नाम राजा परपुरंजयः ।\nधार्मिकः सत्त्वसंपन्नः प्रजारंजनतत्परः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004133004, "chapter_id": 24133, "verse_number": "४-८२-५", "content_sanskrit": "यशोधनो वदान्यश्च सुधीर्ब्राह्मणदैवतः ।\nसदैवावभृथस्नानपरिक्लिन्न शिरोरुहः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004133005, "chapter_id": 24133, "verse_number": "४-८२-६", "content_sanskrit": "विनीतो नीतिसंपन्नः कुशलः सर्वकर्मसु ।\nविद्याब्धिपारदृश्वा च गुणवान्गुणिवत्सलः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004133006, "chapter_id": 24133, "verse_number": "४-८२-७", "content_sanskrit": "कृतज्ञो मधुरालापः पापकर्मपराङ्मुखः ।\nसत्यवाक्छौचनिलयः स्वल्पवाग्विजितेंद्रियः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004133007, "chapter_id": 24133, "verse_number": "४-८२-८", "content_sanskrit": "रणांगणे कृतांताभः संख्यावांश्च सदोजिरे ।\nकामिनीकामकेलिज्ञो युवापि स्थविरप्रियः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004133008, "chapter_id": 24133, "verse_number": "४-८२-९", "content_sanskrit": "धर्मार्थैधितकोशश्च समृद्धबलवाहनः ।\nसुभगश्च सुरूपश्च सुमेधाः सुप्रजाश्रयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004133009, "chapter_id": 24133, "verse_number": "४-८२-१०", "content_sanskrit": "स्थैर्य धैर्य समापन्नो देशकालविचक्षणः ।\nमन्यमानप्रदो नित्यं सर्वदूषणवर्जितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004133010, "chapter_id": 24133, "verse_number": "४-८२-११", "content_sanskrit": "वासुदेवांघ्रियुगले चेतोवृत्तिं निधाय सः ।\nचकार राज्यं निर्द्वंद्वं विष्वगीति विवर्जितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004133011, "chapter_id": 24133, "verse_number": "४-८२-१२", "content_sanskrit": "अलंघ्यशासनः श्रीमान्विष्णुभक्तिपरायणः ।\nअभुनक्प्रचुरान्भोगान्समंताद्विष्णुसात्कृतान् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004133012, "chapter_id": 24133, "verse_number": "४-८२-१३", "content_sanskrit": "हरेरायतनान्युच्चैः प्रतिसौधं पदेपदे ।\nतस्य राज्ये समभवन्महाभाग्यनिधेः शिवे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004133013, "chapter_id": 24133, "verse_number": "४-८२-१४", "content_sanskrit": "गोविंदगोपगोपाल गोपीजनमनोहर ।\nगदापाणे गुणातीत गुणाढ्य गरुडध्वज ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004133014, "chapter_id": 24133, "verse_number": "४-८२-१५", "content_sanskrit": "केशिहृत्कैटभाराते कंसारे कमलापते ।\nकृष्णकेशव कंजाक्ष कीनाश भयनाशन ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004133015, "chapter_id": 24133, "verse_number": "४-८२-१६", "content_sanskrit": "पुरुषोत्तम पापारे पुंडरीकविलोचन ।\nपीतकौशेयवसन पद्मनाभ परात्पर ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004133016, "chapter_id": 24133, "verse_number": "४-८२-१७", "content_sanskrit": "जनार्दन जगन्नाथ जाह्नवीजलजन्मभूः ।\nजन्मिनां जन्महरण जंजपूकाघनाशन ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004133017, "chapter_id": 24133, "verse_number": "४-८२-१८", "content_sanskrit": "श्रीवत्सवक्षः श्रीकांत श्रीकर श्रेयसां निधे ।\nश्रीरंगशार्ङ्गकोदंड शौरे शीतांशुलोचन ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004133018, "chapter_id": 24133, "verse_number": "४-८२-१९", "content_sanskrit": "दैत्यारे दानवाराते दामोदर दुरंतक ।\nदेवकीहृदयानंद दंदशूकेश्वरेशय ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004133019, "chapter_id": 24133, "verse_number": "४-८२-२०", "content_sanskrit": "विष्णो वैकुंठनिलय बाणारे विष्टरश्रवः ।\nविष्वक्सेन विराधारे वनमालिन्वनप्रिय ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004133020, "chapter_id": 24133, "verse_number": "४-८२-२१", "content_sanskrit": "त्रिविक्रमत्रिलोकीश चक्रपाणे चतुर्भुज ।\nइत्यादीनि पवित्राणि नामानि प्रतिमंदिरम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004133021, "chapter_id": 24133, "verse_number": "४-८२-२२", "content_sanskrit": "स्त्रीवृद्धबालगोपाल वदनोदीरितानि तु ।\nश्रूयते यत्रकुत्रापि रम्याणि मधुविद्विषः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004133022, "chapter_id": 24133, "verse_number": "४-८२-२३", "content_sanskrit": "सुरसाकाननान्येव विलोक्यंते गृहेगृहे ।\nचरित्राणि विचित्राणि पवित्राण्यब्धिजापतेः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004133023, "chapter_id": 24133, "verse_number": "४-८२-२४", "content_sanskrit": "सौधभित्तिषु दृश्यंते चित्रकृन्निर्मितानि तु ।\nऋते हरिकथायास्तु नान्या वार्ता निशम्यते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004133024, "chapter_id": 24133, "verse_number": "४-८२-२५", "content_sanskrit": "हरिणा नैव विध्यंते हरिनामांशधारिणः ।\nतस्य राज्ञो भयाद्व्याधैररण्यसुखचारिणः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004133025, "chapter_id": 24133, "verse_number": "४-८२-२६", "content_sanskrit": "न मत्स्या नैव कमठा न वराहाश्च केनचित् ।\nहन्यंते क्वापि तद्भीत्या मत्स्यमांसाशिनापि वै ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004133026, "chapter_id": 24133, "verse_number": "४-८२-२७", "content_sanskrit": "अप्युत्तानशयास्तस्य राष्ट्रे मित्रजितः क्वचित् ।\nस्तनपानं न कुर्वंति संप्राप्य हरिवासरम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004133027, "chapter_id": 24133, "verse_number": "४-८२-२८", "content_sanskrit": "पशवोपि तृणाहारं परित्यज्य हरेर्दिने ।\nउपोषणपरा जाता अन्येषां का कथा नृणाम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004133028, "chapter_id": 24133, "verse_number": "४-८२-२९", "content_sanskrit": "महामहोत्सवः सर्वैः पुरौकोभिर्वितन्यते ।\nतस्मिन्प्रशासति भुवं संप्राप्ते हरिवासरे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004133029, "chapter_id": 24133, "verse_number": "४-८२-३०", "content_sanskrit": "स एव दंड्योऽभूत्तस्य राज्ञो मित्रजितः क्षितौ ।\nयो विष्णुभक्तिरहितः प्राणैरपि धनैरपि ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004133030, "chapter_id": 24133, "verse_number": "४-८२-३१", "content_sanskrit": "अंत्यजा अपि तद्राष्ट्रे शंखचक्रांकधारिणः ।\nसंप्राप्य वैष्णवीं दीक्षां दीक्षिता इव संबभुः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004133031, "chapter_id": 24133, "verse_number": "४-८२-३२", "content_sanskrit": "शुभानि यानि कर्माणि क्रियंतेऽनुदिनं जनैः ।\nवासुदेवे समर्प्यंते तानि तैरफलेप्सुभिः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004133032, "chapter_id": 24133, "verse_number": "४-८२-३३", "content_sanskrit": "विना मुकुंदं गोविदं परमानंदमच्युतम् ।\nनान्यो जप्येतमन्येत न भज्येत जनैः क्वचित् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004133033, "chapter_id": 24133, "verse_number": "४-८२-३४", "content_sanskrit": "कृष्ण एव परो देव कृष्णएव परागतिः ।\nकृष्ण एव परो बंधुस्तस्यासीदवनीपतेः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004133034, "chapter_id": 24133, "verse_number": "४-८२-३५", "content_sanskrit": "एवं तस्मिन्महीपाले राज्यं सम्यक्प्रशासति ।\nएकदा नारदः श्रीमांस्तं दिदृक्षुः समाययौ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004133035, "chapter_id": 24133, "verse_number": "४-८२-३६", "content_sanskrit": "राज्ञा समर्चितः सोथ मधुपर्क विधानतः ।\nनारदो वर्णयामास तममित्रजितं नृपम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004133036, "chapter_id": 24133, "verse_number": "४-८२-३७", "content_sanskrit": "नारद उवाच ।\nधन्योसि कृतकृत्योसि मान्योप्यसि दिवौकसाम् ।\nसर्वभूतेषु गोविंदं परिपश्यन्विशांपते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004133037, "chapter_id": 24133, "verse_number": "४-८२-३८", "content_sanskrit": "यो वेद पुरुषो विष्णुर्यो यज्ञपुरुषो हरिः ।\nयोंतरात्मास्य जगतः कर्ता हर्ताविता विभुः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004133038, "chapter_id": 24133, "verse_number": "४-८२-३९", "content_sanskrit": "तन्मयं पश्यतो विश्वं तव भूपालसत्तम ।\nदर्शनं प्राप्य शुभदं शुचित्वमगमं परम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004133039, "chapter_id": 24133, "verse_number": "४-८२-४०", "content_sanskrit": "एक एव हि सारोत्र संसारे क्षणभंगुरे ।\nकमलाकांत पादाब्ज भक्तिभावोऽखिलप्रदः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004133040, "chapter_id": 24133, "verse_number": "४-८२-४१", "content_sanskrit": "परित्यज्य हि यः सर्वं विप्णुमेकं सदा भजेत् ।\nसुमेधसं भजंते तं पदार्थाः सर्व एव हि ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004133041, "chapter_id": 24133, "verse_number": "४-८२-४२", "content_sanskrit": "हृषीकेशे हृषीकाणि यस्य स्थैर्यं गतान्यहो ।\nस एव स्थैर्यमाप्नोति ब्रह्मांडेऽतीव चंचले ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004133042, "chapter_id": 24133, "verse_number": "४-८२-४३", "content_sanskrit": "यौवनं धनमायुष्यं पद्मिनीजलबिंदुवत् ।\nअतीव चपलं ज्ञात्वाऽच्युतमेकं समाश्रयेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004133043, "chapter_id": 24133, "verse_number": "४-८२-४४", "content_sanskrit": "वाचि चेतसि सर्वत्र यस्य देवो जनार्दनः ।\nस एव सर्वदा वंद्यो नररूपी जनार्दनः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004133044, "chapter_id": 24133, "verse_number": "४-८२-४५", "content_sanskrit": "निर्व्याज प्रणिधानेन शीलयित्वा श्रियःपतिम् ।\nपुरुषोत्तमतां को न प्राप्तवानिह भूतले ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004133045, "chapter_id": 24133, "verse_number": "४-८२-४६", "content_sanskrit": "अनया विष्णुभक्त्या ते संतुष्टेंद्रियमानसः ।\nउपकर्तुमना ब्रूयां तन्निशामय भूपते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004133046, "chapter_id": 24133, "verse_number": "४-८२-४७", "content_sanskrit": "बाला विद्याधरसुता नाम्ना मलयगंधिनी ।\nक्रीडंती पितुराक्रोडे हृता कंकालकेतुना ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004133047, "chapter_id": 24133, "verse_number": "४-८२-४८", "content_sanskrit": "कपालकेतुपुत्रेण दानवेन बलीयसा ।\nआगामिन्यां तृतीयायां तस्याः पाणिग्रहृं किल ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004133048, "chapter_id": 24133, "verse_number": "४-८२-४९", "content_sanskrit": "पाताले चंपकावत्यां नगर्यां सास्ति सांप्रतम् ।\nहाटकेशात्समागच्छंस्तया हंसाश्रुनेत्रया ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004133049, "chapter_id": 24133, "verse_number": "४-८२-५०", "content_sanskrit": "दृष्टः प्रणम्य विज्ञप्तो यथा तच्च निथामय ।\nब्रह्मचारिन्मुनिश्रेष्ठ गंधमादनशैलतः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004133050, "chapter_id": 24133, "verse_number": "४-८२-५१", "content_sanskrit": "बालक्रीडनकासक्तां मोहयित्वा निनाय सः ।\nकंकालकेतुर्दुर्वृत्तो दुर्जयोन्यास्त्रघाततः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004133051, "chapter_id": 24133, "verse_number": "४-८२-५२", "content_sanskrit": "स्वस्य त्रिशूलघातेन म्रियते नान्यथा रणे ।\nजगत्पर्याकुलीकृत्य निद्रात्यत्रविनिर्भयः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004133052, "chapter_id": 24133, "verse_number": "४-८२-५३", "content_sanskrit": "यदि कोपि कृतज्ञो मां हत्वेमं दुष्टदानवम् ।\nमद्दत्तेन त्रिशूलेन नयेद्भद्रं भवेन्नरः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004133053, "chapter_id": 24133, "verse_number": "४-८२-५४", "content_sanskrit": "यदत्रोपचिकीर्षुस्त्वं रक्ष मां दुष्टदानवात् ।\nममापि हि वरो दत्तो भगवत्या महामुने ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004133054, "chapter_id": 24133, "verse_number": "४-८२-५५", "content_sanskrit": "विष्णुभक्तो युवा धीमान्पुत्रि त्वां परिणेष्यति ।\nआ तृतीया तिथि यथा तद्वाक्यं तथ्यतां व्रजेत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004133055, "chapter_id": 24133, "verse_number": "४-८२-५६", "content_sanskrit": "तथा निमित्तमात्रं त्वं भव यत्नं समाचर ।\nइति तद्वचनाद्राजन्विष्णुभक्तिपरायणम् ।\nयुवानं चापि धीमंतं त्वामनु प्राप्तवानहम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004133056, "chapter_id": 24133, "verse_number": "४-८२-५७", "content_sanskrit": "तद्गच्छ कार्यसिद्ध्यै त्वं हत्वा तं दुष्टदानवम् ।\nआनयाशु महाबाहो शुभां मलयगंधिनीम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004133057, "chapter_id": 24133, "verse_number": "४-८२-५८", "content_sanskrit": "सा तु विद्याधरी जीवेद्विलोक्य त्वां नरेश्वर ।\nपार्वतीवचनाद्दुष्टं घातयिष्यत्ययत्नतः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004133058, "chapter_id": 24133, "verse_number": "४-८२-५९", "content_sanskrit": "इति नारदवाक्यं स निशम्यामित्रजिन्नृपः ।\nअनल्पोत्कलिको जातो विद्याधरसुतां प्रति ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004133059, "chapter_id": 24133, "verse_number": "४-८२-६०", "content_sanskrit": "उपायं चापि पप्रच्छ गंतुं तां चंपकावतीम् ।\nनारदेन पुनः प्रोक्तः स राजा गिरिराजजे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004133060, "chapter_id": 24133, "verse_number": "४-८२-६१", "content_sanskrit": "तूर्णमर्णवमासाद्य पूर्णिमादिवसे नृप ।\nभवान्द्रक्ष्यति पोतस्थः कल्पवृंदारथस्थितम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004133061, "chapter_id": 24133, "verse_number": "४-८२-६२", "content_sanskrit": "तत्र दिव्यांगना काचिद्दिव्यपर्यंक संस्थिता ।\nवीणामादाय गायंती गाथां गास्यति सुस्वरम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004133062, "chapter_id": 24133, "verse_number": "४-८२-६३", "content_sanskrit": "यत्कर्मविहितं येन शुभं वाथ शुभेतरम् ।\nस एव भुंक्ते तत्तथ्यं विधिसूत्रनियंत्रितः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004133063, "chapter_id": 24133, "verse_number": "४-८२-६४", "content_sanskrit": "गाथामिमां सा संगीय सरथा स महीरुहा ।\nसपर्यंका क्षणादेव मध्ये सिंधुं प्रवेक्ष्यति ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004133064, "chapter_id": 24133, "verse_number": "४-८२-६५", "content_sanskrit": "भवानप्यविशंकं च ततः पोतान्महार्णवे ।\nतामनु व्रजतु क्षिप्रं यज्ञवाराहमास्तुवन् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004133065, "chapter_id": 24133, "verse_number": "४-८२-६६", "content_sanskrit": "ततो द्रक्ष्यसि पाताले नगरीं चंपकावतीम् ।\nमहामनोहरा राजन्सहितां बालयानया ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004133066, "chapter_id": 24133, "verse_number": "४-८२-६७", "content_sanskrit": "इत्युक्त्वांतर्हितो देवि स चतुर्मुखनंदनः ।\nराजाप्यर्णवमासाद्य यथोक्तं परिलक्ष्य च ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004133067, "chapter_id": 24133, "verse_number": "४-८२-६८", "content_sanskrit": "विवेशांतःसमुद्रं च नगरीमाससाद ताम् ।\nसाथ विद्याधरी बाला नेत्रप्राघुणकी कृता ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004133068, "chapter_id": 24133, "verse_number": "४-८२-६९", "content_sanskrit": "तेन राज्ञा त्रिजगती सौंदर्यश्रीरिवैकिका ।\nपातालदेवतेयं वा ममनेत्रोत्सवाय किम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004133069, "chapter_id": 24133, "verse_number": "४-८२-७०", "content_sanskrit": "निरणायि मधुद्वेष्ट्रा स्रष्टुः सृष्टिविलक्षणा ।\nकुहूराहुभयादेषा कांतिश्चांद्रमसी किमु ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004133070, "chapter_id": 24133, "verse_number": "४-८२-७१", "content_sanskrit": "योषिद्रूपं समाश्रित्य तिष्ठतेऽत्राकुतोऽभया ।\nइत्थं क्षणं तां निर्वर्ण्य स राजागात्तदंतिकम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004133071, "chapter_id": 24133, "verse_number": "४-८२-७२", "content_sanskrit": "सा विलोक्याथ तं बाला नितरां मधुराकृतिम् ।\nविशालोरस्थलतलं प्रलंबतुलसीस्रजम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004133072, "chapter_id": 24133, "verse_number": "४-८२-७३", "content_sanskrit": "शंखचक्रांकसुभग भुजद्वयविराजितम् ।\nहरिनामाक्षरसुधा सुधौत रदनावलिम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004133073, "chapter_id": 24133, "verse_number": "४-८२-७४", "content_sanskrit": "भवानीभक्तिबीजोत्थं भूरुहं पुरुषाकृतिम् ।\nमनोरथफलैः पूर्णमासीद्धृष्टतनूरुहा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004133074, "chapter_id": 24133, "verse_number": "४-८२-७५", "content_sanskrit": "दोलापर्यंकमुत्सृज्य ह्रीभरा नम्रकंधरा ।\nवेपथुं च परिष्टभ्य बाला प्रोवाच भूपतिम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004133075, "chapter_id": 24133, "verse_number": "४-८२-७६", "content_sanskrit": "कस्त्वमत्र कृतांतस्य भवनं मधुराकृते ।\nप्राप्तो मे मंदभाग्यायाश्चेतोवृत्तिं निरुंधयन् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004133076, "chapter_id": 24133, "verse_number": "४-८२-७७", "content_sanskrit": "यावन्नायाति सुभग स कठोरतराकृतिः ।\nअतिपर्याकुलीकृत्य त्रिलोकीं दानवो मुहुः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004133077, "chapter_id": 24133, "verse_number": "४-८२-७८", "content_sanskrit": "कंकालकेतुर्दुर्वृत्तस्त्ववध्यः परहेतिभिः ।\nतावद्गुप्तं समातिष्ठ शस्त्रागारेति गह्वरे ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004133078, "chapter_id": 24133, "verse_number": "४-८२-७९", "content_sanskrit": "न मे कन्याव्रतं भंक्तुं स समर्थ उमा वरात् ।\nआगामिन्यां तृतीयायां परश्वः पाणिपीडनम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004133079, "chapter_id": 24133, "verse_number": "४-८२-८०", "content_sanskrit": "संचिकीर्षति दुष्टात्मा गतायुर्मम शापतः ।\nमा तद्भीतिं कुरु युवंस्तत्कार्यं भविताचिरम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004133080, "chapter_id": 24133, "verse_number": "४-८२-८१", "content_sanskrit": "विद्याधर्येति चोक्तः स शस्त्रागारे निगूढवत् ।\nस्थितो वीरो महाबाहुर्दानवागमने क्षणः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004133081, "chapter_id": 24133, "verse_number": "४-८२-८२", "content_sanskrit": "अथ सायं समायातो दानवो भीषणाकृतिः ।\nत्रिशूलं कलयन्पाणौ मृत्योरपि भयावहम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004133082, "chapter_id": 24133, "verse_number": "४-८२-८३", "content_sanskrit": "आगत्य दानवो रौद्रः प्रलयांबुदनिस्वनः ।\nविद्याधरीं जगादेति मदाघूर्णितलोचनः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004133083, "chapter_id": 24133, "verse_number": "४-८२-८४", "content_sanskrit": "गृहाणेमानि रत्नानि दिव्यानि वरवर्णिनि ।\nकन्यात्वं च परश्वस्ते पाणिग्राहादपैष्यति ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004133084, "chapter_id": 24133, "verse_number": "४-८२-८५", "content_sanskrit": "दासीनामयुतं प्रातर्दास्यामि तव सुंदरि ।\nआसुरीणां सुरीणां च दानवीनां मनोहरम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004133085, "chapter_id": 24133, "verse_number": "४-८२-८६", "content_sanskrit": "गंधर्वीणां नरीणां च किन्नरीणां शतंशतम् ।\nविद्याधरीणां नागीनां यक्षिणीनां शतानि षट् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004133086, "chapter_id": 24133, "verse_number": "४-८२-८७", "content_sanskrit": "राक्षसीनां शतान्यष्टौ शतमप्सरसां वरम् ।\nएतास्ते परिचारिण्यो भविष्यंत्यमलाशये ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004133087, "chapter_id": 24133, "verse_number": "४-८२-८८", "content_sanskrit": "यावत्संपत्तिसंभारो दिक्पालानां गृहेषु वै ।\nमत्परिग्रहतां प्राप्य तावतस्त्वमिहेश्वरी ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004133088, "chapter_id": 24133, "verse_number": "४-८२-८९", "content_sanskrit": "दिव्यान्भोगान्मया सार्धं भोक्ष्यसे मत्परिग्रहात् ।\nकदा परश्वो भविता यस्मिन्वैवाहिको विधिः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004133089, "chapter_id": 24133, "verse_number": "४-८२-९०", "content_sanskrit": "त्वदंगसंगसंस्पर्श सुखसंदोह मेदुरः ।\nपरां निर्वृतिमाप्स्यामि परश्वो निकटं यदि ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004133090, "chapter_id": 24133, "verse_number": "४-८२-९१", "content_sanskrit": "मनोरथाश्चिरं यावद्यं मे हृदि समेधिताः ।\nतान्कृतार्थी करिष्यामि परश्वस्तव संगमात् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004133091, "chapter_id": 24133, "verse_number": "४-८२-९२", "content_sanskrit": "जित्वा देवान्रणे सर्वानिंद्रादीन्मृगलोचने ।\nत्रैलोक्यैश्वर्यसंपत्तेस्त्वां करिष्यामि चेश्वरीम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004133092, "chapter_id": 24133, "verse_number": "४-८२-९३", "content_sanskrit": "आधायांके त्रिशूलं स्वे सुष्वापेति प्रलप्य सः ।\nनरमांसवसास्वाद प्रमत्तो वीतसाध्वसः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004133093, "chapter_id": 24133, "verse_number": "४-८२-९४", "content_sanskrit": "वरं स्मरंती सा गौर्या विद्याधरकुमारिका ।\nविज्ञाय तं प्रमत्तं च सुसुप्तं चातिनिर्भयम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004133094, "chapter_id": 24133, "verse_number": "४-८२-९५", "content_sanskrit": "आहूय तं नरवरं वरं सर्वांगसुंदरम्॥  ।\nविष्णुभक्तिकृतत्राणं प्राणनाथेति जल्प्य च ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004133095, "chapter_id": 24133, "verse_number": "४-८२-९६", "content_sanskrit": "शूलं तदंकादादाय गृहाणेमं जहि द्रुतम् ।\nइति त्रिशूलं बालातो बालार्कसदृशद्युति ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004133096, "chapter_id": 24133, "verse_number": "४-८२-९७", "content_sanskrit": "समादाय महाबाहुः स तदा मित्रजिन्नृपः ।\nजहर्ष च जगादोच्चैर्बालायाश्चाभयं दिशन् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004133097, "chapter_id": 24133, "verse_number": "४-८२-९८", "content_sanskrit": "वामपादप्रहारेण तमाताड्य स निर्भयः ।\nसंस्मरंश्चक्रिणं चित्ते जगद्रक्षामणिं हरिम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004133098, "chapter_id": 24133, "verse_number": "४-८२-९९", "content_sanskrit": "जर्गाद तिष्ठ रे दुष्ट कन्याधर्षणलालस ।\nयुध्यस्वात्र मया सार्धं न सुप्तं हन्म्यहं रिपुम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004133099, "chapter_id": 24133, "verse_number": "४-८२-१००", "content_sanskrit": "इति संश्रुत्य संभ्रांत उत्थाय स दनोः सुतः ।\nत्रिशूलं देहि मे कांते प्रोवाचेति मुहुर्मुहुः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004133100, "chapter_id": 24133, "verse_number": "४-८२-१०१", "content_sanskrit": "कोयं मृत्युगृहं प्राप्तः कस्य रुष्टोऽद्य चांतकः ।\nक आयुषाद्य संत्यक्तो यः प्राप्तो मम गोचरम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004133101, "chapter_id": 24133, "verse_number": "४-८२-१०२", "content_sanskrit": "मम प्रचंड दोर्दंड कंडू कंडूयन क्षमः ।\nनाल्पो नरोयं भविता किं त्रिशूलेन सुंदरि ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004133102, "chapter_id": 24133, "verse_number": "४-८२-१०३", "content_sanskrit": "माभैर्मे कौतुकं पश्य भक्ष्योऽयं मम सांप्रतम् ।\nकालेन मत्तो भीतेन स्वयमेवोपढौकितः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004133103, "chapter_id": 24133, "verse_number": "४-८२-१०४", "content_sanskrit": "इत्युक्त्वा मुष्टिघातेन तेनोच्चैर्दनुसूनुना ।\nहृदये निहतो राजा शिलातिकठिने द्रुतम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004133104, "chapter_id": 24133, "verse_number": "४-८२-१०५", "content_sanskrit": "स चक्रिणा कृतत्राणः पीडामल्पीयसीमपि ।\nनो वेद कठिनोरस्कस्तत्करं प्रत्युतानुदत् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004133105, "chapter_id": 24133, "verse_number": "४-८२-१०६", "content_sanskrit": "अथ कोपवता राज्ञा हतो वक्त्रे चपेटया ।\nआघूर्णितशिरा भूमौ पतित्वा पुनरुत्थितः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004133106, "chapter_id": 24133, "verse_number": "४-८२-१०७", "content_sanskrit": "उवाच च वचो धैर्यमवष्टभ्य महाबली ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004133107, "chapter_id": 24133, "verse_number": "४-८२-१०८", "content_sanskrit": "दानव उवाच ।\nज्ञातं न त्वं मनुष्योसि नृरूपेण चतुर्भुजः ।\nआयातश्छिद्रमासाद्य हंतुं मां दानवांतकः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004133108, "chapter_id": 24133, "verse_number": "४-८२-१०९", "content_sanskrit": "एकं विधेहि मधुभिद्यदि त्वं बलवानसि ।\nविहायैतन्महच्छूलं युध्यस्व स्वायुधैर्मया ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004133109, "chapter_id": 24133, "verse_number": "४-८२-११०", "content_sanskrit": "त्वया कपटरूपेण बलिनः कैटभादयः ।\nन बलेन हताः संख्ये हता एवच्छलेन हि ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004133110, "chapter_id": 24133, "verse_number": "४-८२-१११", "content_sanskrit": "बलिं पातालमनयस्त्वं नृवामनतां दधत् ।\nनृमृगत्वेन भवता हिरण्यकशिपुर्हतः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004133111, "chapter_id": 24133, "verse_number": "४-८२-११२", "content_sanskrit": "त्वया जटिलरूपेण लंकेशो विनिपातितः ।\nगोपालवेषमासाद्य कंसाद्या घातितास्त्वया ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004133112, "chapter_id": 24133, "verse_number": "४-८२-११३", "content_sanskrit": "स्त्रीरूपेणाहरस्त्वं तु विप्रलाप्या सुरान्सुधाम् ।\nयादो रूपेण भवता शंखाद्यानि हता बहु ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004133113, "chapter_id": 24133, "verse_number": "४-८२-११४", "content_sanskrit": "मायाविनामग्रगण्य सर्वमर्मज्ञसाधक ।\nन त्वत्तोहं बिभेम्यद्य यदि शूलं विहास्यसि ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004133114, "chapter_id": 24133, "verse_number": "४-८२-११५", "content_sanskrit": "अथवा दैन्यवचनः किमेभिः कातरोचितैः ।\nन त्यक्ष्यसि त्रिशूलं त्वं न त्वां जेष्याम्यहं रणे ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004133115, "chapter_id": 24133, "verse_number": "४-८२-११६", "content_sanskrit": "अवश्यमेव मर्तव्यमद्य प्रातः शरीरिणा ।\nत्वत्करेण वरं मृत्युर्बलेनापिच्छलेन वा ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004133116, "chapter_id": 24133, "verse_number": "४-८२-११७", "content_sanskrit": "इयं विद्याधरी कन्या न मया दूषिता सती ।\nसाक्षाच्छ्रीरेव मंतव्या तवार्थं रक्षिता मया ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004133117, "chapter_id": 24133, "verse_number": "४-८२-११८", "content_sanskrit": "इत्युक्त्वा वामदोर्दंडप्रहारेणातिनिष्ठुरम् ।\nनिजघान दनोः सूनुस्तं शिलोच्चयकंपिना ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004133118, "chapter_id": 24133, "verse_number": "४-८२-११९", "content_sanskrit": "नृपो वक्षः प्रहारं तं विषह्य रण मूर्द्धनि ।\nलक्षीचकार तद्वक्षस्त्रिशूलं तोलयन्करे ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004133119, "chapter_id": 24133, "verse_number": "४-८२-१२०", "content_sanskrit": "निजघान महाबाहुः स च प्राणाञ्जहौ क्षणात् ।\nइत्थं कंकालकेतुं स निहत्य सुरकंपनम् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004133120, "chapter_id": 24133, "verse_number": "४-८२-१२१", "content_sanskrit": "विद्याधरीं प्रपश्यंतीं प्राह हृष्टतनूरुहाम् ।\nनारदस्य मुनेर्वाक्यात्तव सुश्रोणि वांछितम् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004133121, "chapter_id": 24133, "verse_number": "४-८२-१२२", "content_sanskrit": "कृतं मया कृतज्ञे किं करवाण्यधुना वद ।\nश्रुत्वेति तस्य सा वाक्यं प्राह गंभीरचेतसः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004133122, "chapter_id": 24133, "verse_number": "४-८२-१२३", "content_sanskrit": "मलयगंधिन्युवाच ।\nअथोदारमते वीर निज प्राणैः पणीकृताम् ।\nकिं मां पृच्छसि जीवातो कुलकन्या प्रदूषिताम् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004133123, "chapter_id": 24133, "verse_number": "४-८२-१२४", "content_sanskrit": "इति ब्रुवत्यां कन्यायां पुनः स्वैरचरो मुनिः ।\nअतर्कितागमः प्राप्तो नारदो देवलोकतः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004133124, "chapter_id": 24133, "verse_number": "४-८२-१२५", "content_sanskrit": "ततस्तुतुषतुस्तौ तु दृष्ट्वा तं मुनिसत्तमम् ।\nकृतप्रणामौ मुनिना परिविश्राणिताशिषौ ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004133125, "chapter_id": 24133, "verse_number": "४-८२-१२६", "content_sanskrit": "पाणिग्रहेण विधिनाऽभिषिक्तौ नारदेन तु ।\nजग्मतुर्नारदादिष्ट वर्त्मना कृतमंगलौ ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004133126, "chapter_id": 24133, "verse_number": "४-८२-१२७", "content_sanskrit": "तया मलयगंधिन्या युतः सोऽमित्रजिन्नृपः ।\nपुरीं वाराणसीं प्राप्य पौरैर्विहितमंगलाम् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7004133127, "chapter_id": 24133, "verse_number": "४-८२-१२८", "content_sanskrit": "यद्वीक्षणादपि नरो नारकी नैव जातुचित् ।\nगतिमाप्नोति मेधावी तां पुरीमविशन्नृपः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7004133128, "chapter_id": 24133, "verse_number": "४-८२-१२९", "content_sanskrit": "यस्यां पुर्यां प्रवेशं न लभंते वासवादयः ।\nकैवल्यजनयित्र्यां हि तां पुरीमविशन्नृपः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7004133129, "chapter_id": 24133, "verse_number": "४-८२-१३०", "content_sanskrit": "अपि स्मृत्वा पुरीं यां वै काशीं त्रैलोक्यकांक्षिताम् ।\nन नरो लिप्यते पापैस्तां विवेश स भूपतिः ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7004133130, "chapter_id": 24133, "verse_number": "४-८२-१३१", "content_sanskrit": "यस्यां पुर्यां प्रविष्टो ना महद्भिरपि पातकैः ।\nनाभिभूयेत तां काशीं प्राविशत्स विशांपतिः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7004133131, "chapter_id": 24133, "verse_number": "४-८२-१३२", "content_sanskrit": "सापि विद्याधरी काशी समृद्धिं वीक्ष्य दूरतः ।\nनिनिंद स्वर्गलोकं च पातालनगरीमपि ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7004133132, "chapter_id": 24133, "verse_number": "४-८२-१३३", "content_sanskrit": "प्राप्या मित्रजितं कांतं तथा हृष्टा न सा वधूः ।\nयथा दृष्ट्वाप्यहो काशीं परमानंदकेतनम् ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7004133133, "chapter_id": 24133, "verse_number": "४-८२-१३४", "content_sanskrit": "सा कृतार्थमिवात्मानं मन्यमाना मनस्विनी ।\nतेन पत्या च काश्या च परां निर्वृतिमाययौ ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7004133134, "chapter_id": 24133, "verse_number": "४-८२-१३५", "content_sanskrit": "सोप्यमित्रजिदासाद्य पत्नीं मलयगंधिनीम् ।\nधर्मप्रधानं संसेव्य कामं प्राप्तोत्तमं सुखम् ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7004133135, "chapter_id": 24133, "verse_number": "४-८२-१३६", "content_sanskrit": "सैकदा तं पतिं राज्ञी विष्णुभक्तिपरायणम् ।\nरहो विज्ञापयांचक्रे पतिभक्ता सुतार्थिनी ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7004133136, "chapter_id": 24133, "verse_number": "४-८२-१३७", "content_sanskrit": "राज्ञ्युवाच ।\nभूपाभीष्टतृतीयायाश्चरिष्यामि महाव्रतम् ।\nयद्यनुज्ञा भवेद्भर्तुः पुत्रकामार्थितप्रदम् ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7004133137, "chapter_id": 24133, "verse_number": "४-८२-१३८", "content_sanskrit": "राजोवाच ।\nदेव्यभीष्टतृतीयायां व्रतं कीदृग्भवेद्वद ।\nका देवता तत्र पूज्या विधानं चापि किं फलम् ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7004133138, "chapter_id": 24133, "verse_number": "४-८२-१३९", "content_sanskrit": "नारी पत्यननुज्ञाता या व्रतादि समाचरेत् ।\nजीवंती दुःखिनी सा स्यान्मृता निरयमृच्छति ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7004133139, "chapter_id": 24133, "verse_number": "४-८२-१४०", "content_sanskrit": "इति राज्ञोदिता राज्ञी प्रवक्तुमुपचक्रमे ।\nइति कर्तव्यतां तस्य व्रतस्य सरहस्यकाम् ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7004133140, "chapter_id": 24133, "verse_number": "४-८२-१४१", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां चतुर्थे काशीखण्डे उत्तरार्ध वीरेश्वराविर्भावेऽमित्रजित्पराक्रमो नाम द्व्यशीतितमोध्यायः ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}]