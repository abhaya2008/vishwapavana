[{"id": 7005965000, "chapter_id": 25965, "verse_number": "१-१४८-१", "content_sanskrit": "धन्वन्तरिरुवाच ।\nअथातो रक्तपित्तस्य निदानं प्रवदामयहम् ।\nभृशोष्णतिक्तकट्वम्ललवणादिविदाहिभिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005965001, "chapter_id": 25965, "verse_number": "१-१४८-२", "content_sanskrit": "कोद्रवोद्दालकैश्चान्यैस्तदुक्तैरति सेवितैः ।\nकुपितं पैत्तिकैः पित्तं द्रवं रक्तञ्च मूर्छति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005965002, "chapter_id": 25965, "verse_number": "१-१४८-३", "content_sanskrit": "तैर्मिथस्तुल्यरूपत्वमागम्य व्याप्नुवंस्तनम् ।\nपित्तरक्तस्य विकृतेः संसर्गाद्दषणादपि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005965003, "chapter_id": 25965, "verse_number": "१-१४८-४", "content_sanskrit": "गन्धवर्णानुवृत्तेषु रक्तेन व्यपदिश्यते ।\nप्रभवत्यसृजः स्थानात्प्लीहतो यकृतश्च सः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005965004, "chapter_id": 25965, "verse_number": "१-१४८-५", "content_sanskrit": "शिरोगुरुत्वमरुचिः शीतेच्छा धूमकोऽम्लकः ।\nछर्धितश्छर्दिबै भत्स्यं कासः श्वासो भ्रमः क्लमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005965005, "chapter_id": 25965, "verse_number": "१-१४८-६", "content_sanskrit": "लोहितो न हितो मत्स्यगन्धास्यात्वञ् विज्वरे ।\nरक्तहारिद्रहरितवर्णता नयनादिषु ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005965006, "chapter_id": 25965, "verse_number": "१-१४८-७", "content_sanskrit": "नीललोहित पीतानां वर्णानामविवेचनम् ।\nस्वप्ने इन्मादधर्मित्वं भवत्यस्मिन्भविष्यति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005965007, "chapter_id": 25965, "verse_number": "१-१४८-८", "content_sanskrit": "उर्ध्वं नासाक्षिकर्णास्यैर्मेढ्रयोनिगुदैरधः ।\nकुपितं रोमकूपैश्च समस्तैस्तत्प्रवर्तते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005965008, "chapter_id": 25965, "verse_number": "१-१४८-९", "content_sanskrit": "ऊर्ध्वं साध्यं कफाद्यस्मात्तद्विरेचनसाधितम ।\nबह्वौषधानि पित्तस्य विरेको हि वरौषधम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005965009, "chapter_id": 25965, "verse_number": "१-१४८-१०", "content_sanskrit": "अनुबन्धी कफो यत्र तत्र तस्यापि शुद्धिकृत् ।\nकषायाः स्वादवो यस्य विशुद्धौ श्लेष्मला हिताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005965010, "chapter_id": 25965, "verse_number": "१-१४८-११", "content_sanskrit": "कटुतिक्तकषाया वा ये निसर्गात्कफावहाः ।\nअधो याप्यञ्च नायुष्मांस्तत्प्रच्छर्दनसाधकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005965011, "chapter_id": 25965, "verse_number": "१-१४८-१२", "content_sanskrit": "अल्पौषधञ्च पित्तस्य वमनं नावमौषधम् ।\nअनुबन्धि बलं यस्य शान्तपित्तनरस्य च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005965012, "chapter_id": 25965, "verse_number": "१-१४८-१३", "content_sanskrit": "कषायश्च हितस्तस्य मधुरा एव केम् ।\nकफमारुतसंस्पृष्टमसाध्यमुपनामनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005965013, "chapter_id": 25965, "verse_number": "१-१४८-१४", "content_sanskrit": "असह्यं प्रतिलोमत्वादसाध्यादौषधस्य च ।\nन हि संशोधनं किञ्चिदस्य च प्रतिलोमिनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005965014, "chapter_id": 25965, "verse_number": "१-१४८-१५", "content_sanskrit": "शोधनं प्रतिलोमञ्च रक्तपित्तेऽभर्जितम् ।\nएवमेवोपशमनं संशोधनमिहेष्यते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005965015, "chapter_id": 25965, "verse_number": "१-१४८-१६", "content_sanskrit": "संसृष्टेषु हि दोषेषु सर्वथा छर्दनं हितम् ।\nतत्र दोषोऽत्र गमनं शिवास्त्र इव लक्ष्यते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005965016, "chapter_id": 25965, "verse_number": "१-१४८-१७", "content_sanskrit": "उपद्रवाश्च विकृतिं फलतस्तेषु साधितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]