[{"id": 2060853, "chapter_id": 2302, "verse_number": "८-२३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060854, "chapter_id": 2302, "verse_number": "८-२३-१", "content_sanskrit": "एवमुक्तो महाराज तव पुत्रः प्रतापवान्।\nमद्रेश्वरं प्रति रणे सुरसैन्यभयङ्करम्।\nसर्वं तथाऽकरोत्तूर्णं राधेयस्तद्यथाऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060855, "chapter_id": 2302, "verse_number": "८-२३-२", "content_sanskrit": "मद्राजं च समरे प्रणम्य च महारथम्।\nविनयेनोपसङ्गम्य प्रणयाद्वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060856, "chapter_id": 2302, "verse_number": "८-२३-३", "content_sanskrit": "सत्यव्रत महाभाग द्विषतां तापवर्धन।\nमद्रेश्वर रणेशूर परसैन्यभयङ्कर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060857, "chapter_id": 2302, "verse_number": "८-२३-४", "content_sanskrit": "`मत्प्रियार्थं हितार्थं च तथा पार्थवधाय च।\nश्रुतवानसि कर्णस्य ब्रुवतो वदतां वर।\nयथा नृपतिसिंहानां मध्ये त्वां वरये स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060858, "chapter_id": 2302, "verse_number": "८-२३-५", "content_sanskrit": "तत्त्वामप्रतिवीर्याद्य शत्रुपक्षक्षयावह।\nमद्रेश्वर प्रयाचेऽहं शिरसा विनयेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060859, "chapter_id": 2302, "verse_number": "८-२३-६", "content_sanskrit": "तस्मात्पार्थविनाशार्थं हितार्थं मम चैव हि।\nत्वं पाहि सर्वतः कर्णं भवं ब्रह्मेव सुव्रत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060860, "chapter_id": 2302, "verse_number": "८-२३-७", "content_sanskrit": "सारथ्यं रथिनां श्रेष्ठ प्रणयात्कर्तुमर्हसि।\nत्वयि यन्तरि राधेयो विद्विषो मे विजेष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060861, "chapter_id": 2302, "verse_number": "८-२३-८", "content_sanskrit": "अभीषूणां हि कर्णस्य ग्रहीतान्यो न विद्यते।\nऋते हि त्वां महाभाग वासुदेवसमं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060862, "chapter_id": 2302, "verse_number": "८-२३-९", "content_sanskrit": "स पाहि सर्वथा कर्णं यथा ब्रह्मा महेश्वरम्।\nयथा च सर्वथाऽऽपत्सु वार्ष्णेयः पाति पाण्डवम्।\nतथा मद्रेश्वराद्य त्वं राधेयं प्रतिपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060863, "chapter_id": 2302, "verse_number": "८-२३-१०", "content_sanskrit": "भीष्मो द्रोणः कृपः कर्णो भवान्भोजश्च वीर्यवान्।\nशकुनिः सौबलो द्रौणिरहमेव च नो बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060864, "chapter_id": 2302, "verse_number": "८-२३-११", "content_sanskrit": "एवमेष कृतो भागो नवधा पृथिवीपते।\nन च भागोऽत्र भीष्मस्य द्रोणस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060865, "chapter_id": 2302, "verse_number": "८-२३-१२", "content_sanskrit": "ताभ्यामतीत्य तौ भागौ निहता मम शत्रवः।\nवृद्वौ हि तौ महेष्वासौ छलेन निहतौ युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060866, "chapter_id": 2302, "verse_number": "८-२३-१३", "content_sanskrit": "कृत्वा चासुकरं कर्म गतौ स्वर्गमितोऽनघ।\nतथान्ये पुरुषव्याघ्राः परैर्विनिहता युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060867, "chapter_id": 2302, "verse_number": "८-२३-१४", "content_sanskrit": "अस्मदीयाश्च बहवः स्वर्गाय गमिताः परैः।\nत्यक्त्वा प्राणानय्थाशक्ति चेष्टां कृत्वा च पुष्कलाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060868, "chapter_id": 2302, "verse_number": "८-२३-१५", "content_sanskrit": "तदिदं हतभूयिष्ठं बलं मम नराधिप।\nपूर्वमप्यल्पकैः पार्थैर्हतं किमुत साम्प्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060869, "chapter_id": 2302, "verse_number": "८-२३-१६", "content_sanskrit": "बलवन्तो महात्मानः कौन्तेयाः सत्यविक्रमाः।\nबलं शेषं न हन्युर्मे यथा तत्कुरु पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060870, "chapter_id": 2302, "verse_number": "८-२३-१७", "content_sanskrit": "हतवीरमिदं सैन्यं पाण्डवैः समरे विभो।\nकर्णो ह्येको महाबाहुरस्मत्प्रियहिते रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060871, "chapter_id": 2302, "verse_number": "८-२३-१८", "content_sanskrit": "भवांश्च पुरुषव्याघ्र सर्वलोकमहारथः।\nशल्य कर्णोऽर्जुनेनाद्य योद्वुमिच्छति संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060872, "chapter_id": 2302, "verse_number": "८-२३-१९", "content_sanskrit": "तस्मिञ्जयाशा विपुला मद्रराज नराधिप।\nतस्याभीषुग्रहवरो नान्योऽस्ति भुवि कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060873, "chapter_id": 2302, "verse_number": "८-२३-२०", "content_sanskrit": "पार्थस्य समरे कृष्णो यथाऽभीषुग्रहो वरः।\nतथा त्वमपि कर्णस्य रथेऽभीषुग्रहो भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060874, "chapter_id": 2302, "verse_number": "८-२३-२१", "content_sanskrit": "तेन युक्तो रणे पार्थो रक्ष्यमाणश्च पार्थिव।\nयानि कर्माणि कुरुते प्रत्यक्षाणि तथैव तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060875, "chapter_id": 2302, "verse_number": "८-२३-२२", "content_sanskrit": "पूर्वं नः समरे ह्येवमधीदर्जुनो रिपून्।\nइदानीं विक्रमो ह्यस्य कृष्णेन सहितस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060876, "chapter_id": 2302, "verse_number": "८-२३-२३", "content_sanskrit": "कृष्णेन सहितः पार्थो धार्तराष्ट्रीं महाचमूम्।\nअहन्यहनि मद्रेश द्रावयन्दृश्यते युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2060877, "chapter_id": 2302, "verse_number": "८-२३-२४", "content_sanskrit": "भागोऽवशिष्टः कर्णस्य तव चैव महाद्युते।\nतं भागं सह कर्णेन युगपन्नाशयाद्य हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2060878, "chapter_id": 2302, "verse_number": "८-२३-२५", "content_sanskrit": "अरुणेन यथा सार्धं तमः सूर्यो व्यपोहति।\nतथा कर्णेन सहितो जहि पार्थं महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2060879, "chapter_id": 2302, "verse_number": "८-२३-२६", "content_sanskrit": "उद्यन्तौ च यथा सूर्यौ बालसूर्यसमप्रभौ।\nकर्णशल्यौ रणे दृष्ट्वा विद्रवन्तु महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2060880, "chapter_id": 2302, "verse_number": "८-२३-२७", "content_sanskrit": "सूर्यारुषौ यथा दृष्ट्वा तमो नश्यति मारिष।\nतथा नश्यन्तु कौन्तेयाः सपाञ्चालाः ससृञ्जयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2060881, "chapter_id": 2302, "verse_number": "८-२३-२८", "content_sanskrit": "रथिनां प्रवरः कर्णो यन्तॄणां प्रवरो भवान्।\nसंयोगो युवयोर्लोके नाभून्न च भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2060882, "chapter_id": 2302, "verse_number": "८-२३-२९", "content_sanskrit": "यथा सर्वास्ववस्थासु वार्ष्मेयः पाति पाण्डवम्।\nतथा भवान्परित्रातु कर्णं वैकर्तनं रणे।\n`सारथ्यं क्रियतां तस्य युध्यमानस्य संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2060883, "chapter_id": 2302, "verse_number": "८-२३-३०", "content_sanskrit": "यथा च समरे कृष्णो रक्षते सर्वतोऽर्जुनम्।\nतथा त्वमपि राधेयं रक्षस्व च महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2060884, "chapter_id": 2302, "verse_number": "८-२३-३१", "content_sanskrit": "त्वया सारथिना ह्येष अप्रधृष्यो भविष्यति।\nदेवतानामपि रणे सशक्राणां महीपते।\nकिं पुनः पाण्डवेयानां मा विशङ्कीर्वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2060885, "chapter_id": 2302, "verse_number": "८-२३-३२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2060886, "chapter_id": 2302, "verse_number": "८-२३-३२", "content_sanskrit": "दुर्योधनवचः श्रुत्वा शल्यः क्रोधसमन्वितः।\n`धार्तराष्ट्रमथोवाच सृक्विणी परिलेलिहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2060887, "chapter_id": 2302, "verse_number": "८-२३-३३", "content_sanskrit": "त्रिशिखां भ्रुकुटिं कृत्वा धुन्वन्हस्तौ पुनःपुनः।\nक्रोधरक्ते महानेत्रे परिवृत्य महाभुजः।\nकुलैश्वर्यश्रुतबलैर्दृप्तः शल्योऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2060888, "chapter_id": 2302, "verse_number": "८-२३-३४x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2060889, "chapter_id": 2302, "verse_number": "८-२३-३४", "content_sanskrit": "न मामर्हसि राजेद्र नियोक्तुं कर्मणीदृशे।\nन हि पापीयसः श्रेयान्प्रेष्यत्वं कर्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2060890, "chapter_id": 2302, "verse_number": "८-२३-३५", "content_sanskrit": "यो ह्यभ्युपगतं मित्रं गरीयांसं विशेषतः।\nवशे पापीयसो धत्ते तत्कार्यमधरोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2060891, "chapter_id": 2302, "verse_number": "८-२३-३६", "content_sanskrit": "ब्रह्मणा ब्राह्मणाः सृष्टा मुखात्क्षत्रं च बाहुतः।\nऊरुभ्यामथ वैश्या वै शूद्राः पद्भ्यामिति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2060892, "chapter_id": 2302, "verse_number": "८-२३-३७", "content_sanskrit": "तेभ्यो वर्णविशेषाश्च प्रतिलोमानुलोमजाः।\nअथान्योन्यस्य संयोगाच्चातुर्वर्ण्यस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2060893, "chapter_id": 2302, "verse_number": "८-२३-३८", "content_sanskrit": "गोप्तारः सङ्गृहीतारो दातारः क्षत्रियाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2060894, "chapter_id": 2302, "verse_number": "८-२३-३९", "content_sanskrit": "याजनाध्यापनैर्विप्रा विशुद्वैश्च प्रतिग्रहैः।\nलोकस्यानुग्रहार्थाय स्थापिता ब्राह्मणा भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2060895, "chapter_id": 2302, "verse_number": "८-२३-४०", "content_sanskrit": "कृषिश्च पाशुपाल्यं च विशां दानं च धर्मतः।\nब्रह्मक्षत्रविशां शूद्रा विहिताः परिचारकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2060896, "chapter_id": 2302, "verse_number": "८-२३-४१", "content_sanskrit": "ब्रह्मक्षत्रस्य विहिताः सूता वै परिचारकाः।\nन क्षत्रियो वै सूतानां शृणुयाच्च कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2060897, "chapter_id": 2302, "verse_number": "८-२३-४२", "content_sanskrit": "अहं मूर्धाभिषिक्तो हि राजर्षिकुलजो नृपः।\nमहारथसमाख्यातः सेव्यः स्तुत्यश्च वन्दिनां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2060898, "chapter_id": 2302, "verse_number": "८-२३-४३", "content_sanskrit": "सोऽमहेतादृशो भूत्वा नेहारिबलसूदनः।\nसूतपुत्रस्य सङ्ग्रामे सारथ्यं कर्तुमुत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2060899, "chapter_id": 2302, "verse_number": "८-२३-४४", "content_sanskrit": "अवमन्यसे मां गान्धारे ध्रुवं चाप्यतिशङ्कसे।\nयस्माद्ब्रवीषि विस्रब्धः सारथ्यं क्रियतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2060900, "chapter_id": 2302, "verse_number": "८-२३-४५", "content_sanskrit": "अस्मत्तोऽभ्यधिकं कर्णं मन्वानस्तं प्रशंससि।\nन चाहं युधि राधेयं गणये तुल्यमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2060901, "chapter_id": 2302, "verse_number": "८-२३-४६", "content_sanskrit": "आदिश्यतामभ्यधिको ममांशः पृथिवीपते।\nतमहं समरे हत्वा गमिष्यामि यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2060902, "chapter_id": 2302, "verse_number": "८-२३-४७", "content_sanskrit": "अथवाप्येक एवाहं योत्स्यामि तव शत्रुभिः।\nपश्य वीर्यं ममाद्य त्वं सङ्ग्रामे दहतो रिपून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2060903, "chapter_id": 2302, "verse_number": "८-२३-४८", "content_sanskrit": "न चापि कामान्कौरव्य निधाय हृदये पुमान्।\nअस्मद्विधः प्रवर्तेत मा मा त्वमतिशङ्किथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2060904, "chapter_id": 2302, "verse_number": "८-२३-४९", "content_sanskrit": "अपि चाप्यवमानो मे न कर्तव्यः कथञ्चन।\nपश्य भीमौ मम भुजौ वज्रसंहननौ दृढौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2060905, "chapter_id": 2302, "verse_number": "८-२३-५०", "content_sanskrit": "धनुः पश्य च मे चित्रं शरांश्चाशीविषपमान्।\nरथं च पश्य मे चित्रं सदश्वैर्वातवेगिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2060906, "chapter_id": 2302, "verse_number": "८-२३-५१", "content_sanskrit": "गदां च पश्य गान्धारे हेमपट्टविभूषिताम्।\nदारयेयं महीं क्रुद्धो विकिरेयं च पर्वतान्।\nशोषयेयं समुद्रांश्च पातयेयं च भास्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2060907, "chapter_id": 2302, "verse_number": "८-२३-५२", "content_sanskrit": "तं मामेवंविधं राजन्समर्थमरिनिग्रहे।\nकस्माद्युनङ्क्षि सारथ्ये सूतस्याधिरथेस्तु माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2060908, "chapter_id": 2302, "verse_number": "८-२३-५३", "content_sanskrit": "न चापि मम राधेयः कलामर्हति षोडशीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2060909, "chapter_id": 2302, "verse_number": "८-२३-५४", "content_sanskrit": "सकर्णा ये त्रयो लोकाः सार्जुनाः सजनार्दनाः।\nनिबद्वांस्तन्त्रणे राजन्न गणेयं कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2060910, "chapter_id": 2302, "verse_number": "८-२३-५५", "content_sanskrit": "न चाहं प्राकृतः कश्चिन्न चास्म्यधिगतः स्वयम्।\nअयं चाप्यवमानो मे न कर्तव्यः कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2060911, "chapter_id": 2302, "verse_number": "८-२३-५६", "content_sanskrit": "आपृच्छे त्वाद्य गान्धारे यास्यामि विषयं प्रति।\nन चाहं सूतपुत्रस्य सारथ्यमुपजग्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2060912, "chapter_id": 2302, "verse_number": "८-२३-५७", "content_sanskrit": "अवमानमहं प्राप्य न योत्स्यामि कथञ्चन।\nआपृच्छे त्वाऽद्य गान्धारे गमिष्यामि गृहाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2060913, "chapter_id": 2302, "verse_number": "८-२३-५८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2060914, "chapter_id": 2302, "verse_number": "८-२३-५८", "content_sanskrit": "एवमुक्त्वा महाराज शल्यः समितिशोभनः।\nउत्थाय प्रययौ तूर्णं राजमध्यादमर्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2060915, "chapter_id": 2302, "verse_number": "८-२३-५९", "content_sanskrit": "प्रणयाद्बहुमानाच्च तं निगृह्य सुतस्तव।\nअब्रवीन्मधुरं वाक्यं साम्ना सर्वार्थसाधकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2060916, "chapter_id": 2302, "verse_number": "८-२३-६०", "content_sanskrit": "यथा शल्य त्वमात्थेदमेवमेतदसंशयम्।\nअभिप्रायस्तु मे कश्चित्तं निबोध जनेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2060917, "chapter_id": 2302, "verse_number": "८-२३-६१", "content_sanskrit": "न कर्णोऽभ्यधिकस्त्वत्तो न चान्ये चैव पार्थिवाः।\nन च मद्रेश्वर त्वां वै कृष्णः सोढुं च शक्ष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2060918, "chapter_id": 2302, "verse_number": "८-२३-६२", "content_sanskrit": "ऋतमेव हि पूर्वास्ते वदन्ति पुरुषोत्तमाः।\nतस्मादार्तायनिः प्रोक्तो भवानिति मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2060919, "chapter_id": 2302, "verse_number": "८-२३-६३", "content_sanskrit": "शल्यबूतस्तु शत्रूणां यस्मात्त्वं युधि मानद।\nतस्माच्छल्येति ते नाम कथ्यते पृथिवीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2060920, "chapter_id": 2302, "verse_number": "८-२३-६४", "content_sanskrit": "यदेतद्व्याहृतं पूर्वं भवता भूरिदक्षिण।\nतदेव कुरु धर्मज्ञ मदर्थं यद्यदुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2060921, "chapter_id": 2302, "verse_number": "८-२३-६५", "content_sanskrit": "न च त्वत्तो हि राधेयो न चाहमपि वीर्यवान्।\nवृणेऽहं त्वां हयाग्र्याणां यन्तारमिह संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2060922, "chapter_id": 2302, "verse_number": "८-२३-६६", "content_sanskrit": "मन्ये चाभ्यधिकं शल्य गुणैः कर्णं धनञ्जयात्।\nभवन्तं वासुदेवाच्च लोकोऽयमतिमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2060923, "chapter_id": 2302, "verse_number": "८-२३-६७", "content_sanskrit": "कर्णो ह्यभ्यधिकः पार्थादस्त्रैरेव नरर्षभ।\nभवानभ्यधिकः कृष्णादश्वज्ञाने बले तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2060924, "chapter_id": 2302, "verse_number": "८-२३-६८", "content_sanskrit": "यथाऽश्वहृदयं वेद वासुदेवो महामनाः।\nद्विगुणं त्वं तथा वेत्सि मद्रराजेश्वरात्मज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2060925, "chapter_id": 2302, "verse_number": "८-२३-६९x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2060926, "chapter_id": 2302, "verse_number": "८-२३-६९", "content_sanskrit": "यन्मां ब्रवीषि गान्धारे मध्ये सैन्यस्य कौरव।\nविशिष्टं देवकीपुत्रात्प्रीतिमानस्म्यहं त्वयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2060927, "chapter_id": 2302, "verse_number": "८-२३-७०", "content_sanskrit": "एष सारथ्यमातिष्ठे राधेयस्य यशस्विनः।\nयुध्यतः पाण्डवाग्र्येण यथा त्वं वीर मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2060928, "chapter_id": 2302, "verse_number": "८-२३-७१", "content_sanskrit": "समयश्च हि मे वीर कश्चिद्वैकर्तनं प्रति।\nउत्सृजेयं यथाश्रद्वमहं वाचोऽस्य सन्निधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2060929, "chapter_id": 2302, "verse_number": "८-२३-७२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2060930, "chapter_id": 2302, "verse_number": "८-२३-७२", "content_sanskrit": "तथेति राजन्पुत्रस्ते सह कर्णेन भारत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2060931, "chapter_id": 2302, "verse_number": "८-२३-७२", "content_sanskrit": "अब्रवीन्मद्रराजस्य मतं भरतसxxxx॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2060932, "chapter_id": 2302, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि त्रयोविंशोऽध्यायः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]