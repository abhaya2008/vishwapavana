[{"id": 5000596000, "chapter_id": 9596, "verse_number": "७-६१-१", "content_sanskrit": "एवं ब्रुवद्भिर्ऋषिभिः काकुत्स्थो वाक्यमब्रवीत् ।\nकिं कार्यं ब्रूत मुनयो भयं तावदपैतु वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000596001, "chapter_id": 9596, "verse_number": "७-६१-२", "content_sanskrit": "तथा ब्रुवति काकुत्स्थे भार्गवो वाक्यमब्रवीत् ।\nभयानां शृणु यन्मूलं देशस्य च नरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000596002, "chapter_id": 9596, "verse_number": "७-६१-३", "content_sanskrit": "पूर्वं कृतयुगे राजन्दैतेयः सुमहाबलः ।\nलोलापुत्रो ऽभवज्ज्येष्ठो मधुर्नाम महासुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000596003, "chapter_id": 9596, "verse_number": "७-६१-४", "content_sanskrit": "ब्रह्मण्यश्च शरण्यश्च बुद्ध्या च परिनिष्ठितः ।\nसुरैश्च परमोदारैः प्रीतिस्तस्यातुला ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000596004, "chapter_id": 9596, "verse_number": "७-६१-५", "content_sanskrit": "स मधुर्वीर्यसम्पन्नो धर्मे च सुसमाहितः ।\nबहुवर्षसहस्राणि रुद्रप्रीत्या ऽकरोत्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000596005, "chapter_id": 9596, "verse_number": "७-६१-६", "content_sanskrit": "रुद्रः प्रीतो ऽभवत्तस्मै वरं दातुं ययौ च सः ।\nबहुमानाच्च रुद्रेण दत्तस्तस्याद्भुतो वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000596006, "chapter_id": 9596, "verse_number": "७-६१-७", "content_sanskrit": "शूलं शूलाद्विनिष्कृष्य महावीर्यं महाप्रभम् ।\nददौ महात्मा सुप्रीतो वाक्यं चैतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000596007, "chapter_id": 9596, "verse_number": "७-६१-८", "content_sanskrit": "त्वयायमतुलो धर्मो मत्प्रसादकरः कृतः ।\nप्रीत्या परमया युक्तो ददाम्यायुधमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000596008, "chapter_id": 9596, "verse_number": "७-६१-९", "content_sanskrit": "यावत्सुरैश्च विप्रैश्च न विरुध्येर्महासुर ।\nतावच्छूलं तवेदं स्यादन्यथा नाशमेप्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000596009, "chapter_id": 9596, "verse_number": "७-६१-१०", "content_sanskrit": "यश्च त्वामभियुञ्जीत युद्धाय विगतज्वरः ।\nतं शूलो भस्मसात्कृत्वा पुनरेष्यति ते करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000596010, "chapter_id": 9596, "verse_number": "७-६१-११", "content_sanskrit": "एवं रुद्राद्वरं लब्ध्वा भूय एव महासुरः ।\nप्रणिपत्य महादेवं वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000596011, "chapter_id": 9596, "verse_number": "७-६१-१२", "content_sanskrit": "भगवन्मम वंशस्य शूलमेतदनुत्तमम् ।\nभवेत्तु सततं देव सुराणामीश्वरो ह्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000596012, "chapter_id": 9596, "verse_number": "७-६१-१३", "content_sanskrit": "तं ब्रुवाणं मधुं देवः सर्वभूतपतिः शिवः ।\nप्रत्युवाच महातेजा नैतदेवं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000596013, "chapter_id": 9596, "verse_number": "७-६१-१४", "content_sanskrit": "मा भूत्ते विफला वाणी मत्प्रसादकृता शुभा ।\nभवतः पुत्रमेकं तु शूलमेतद्भजिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000596014, "chapter_id": 9596, "verse_number": "७-६१-१५", "content_sanskrit": "यावत्करस्थः शूलो ऽयं भविष्यति सुतस्य ते ।\nअवध्यः सर्वभूतानां शूलहस्तो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000596015, "chapter_id": 9596, "verse_number": "७-६१-१६", "content_sanskrit": "एवं मधुर्वरं लब्ध्वा देवात्सुमहदद्भुतम् ।\nभवनं सो ऽसुरश्रेष्ठः कारयामास सुप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000596016, "chapter_id": 9596, "verse_number": "७-६१-१७", "content_sanskrit": "तस्य पत्नी महाभागा प्रिया कुम्भीनसीति या ।\nविश्वावसोरपत्यं सा ह्यनलायां महाप्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000596017, "chapter_id": 9596, "verse_number": "७-६१-१८", "content_sanskrit": "तस्याः पुत्रो महावीर्यो लवणो नाम दारुणः ।\nबाल्यात्प्रभृति दुष्टात्मा पापान्येव समाचरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000596018, "chapter_id": 9596, "verse_number": "७-६१-१९", "content_sanskrit": "तं पुत्रं दुर्विनीतं तु दृष्ट्वा क्रोधसमन्वितः ।\nमधुः स शोकमापेदे न चैनं किञ्चिदब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000596019, "chapter_id": 9596, "verse_number": "७-६१-२०", "content_sanskrit": "स विहाय त्विमं लोकं प्रविष्टो वरुणालयम् ।\nशूलं निवेश्य लवणे वरं तस्मै न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000596020, "chapter_id": 9596, "verse_number": "७-६१-२१", "content_sanskrit": "स प्रभावेण शूलस्य दौरात्म्येनात्मनस्तथा ।\nसन्तापयति लोकांस्त्रीन्विशेषेण च तापसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000596021, "chapter_id": 9596, "verse_number": "७-६१-२२", "content_sanskrit": "एवंप्रभावो लवणः शूलं चैव तथाविधम् ।\nश्रुत्वा प्रमाणं काकुत्स्थ त्वं हि नः परमा गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000596022, "chapter_id": 9596, "verse_number": "७-६१-२३", "content_sanskrit": "बहवः पार्थिवा राम भयार्तैर्ऋषिभिः पुरा ।\nअभयं याचिता वीर त्रातारं न च विद्महे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000596023, "chapter_id": 9596, "verse_number": "७-६१-२४", "content_sanskrit": "ते वयं रावणं श्रुत्वा हतं सबलवाहनम् ।\nत्रातारं विद्महे तात नान्यं भुवि नराधिपम् ।\nतत्परित्रातुमिच्छामो लवणाद्भयपीडितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000596024, "chapter_id": 9596, "verse_number": "७-६१-२५", "content_sanskrit": "इति राम निवेदितं तु ते भयजं कारणमुत्थितं च यत् ।\nविनिवारयितुं भवान्क्षमः कुरु तं काममहीनविक्रम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000596025, "chapter_id": 9596, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे एकषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]