[{"id": 7000934000, "chapter_id": 20934, "verse_number": "७-२२-१", "content_sanskrit": "जैमिनिरुवाच ।\nगङ्गायाः शुभ माहात्म्यं विष्णुपूजाफलं तथा ।\nअन्नदानस्य माहात्म्यं जलदानस्य चोत्तमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000934001, "chapter_id": 20934, "verse_number": "७-२२-२", "content_sanskrit": "विप्रपादोदकस्यापि माहात्म्यं पापनाशनम् ।\nत्वत्प्रसादाच्छ्रुतं सर्वं सेतिहासं गुरो मया ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000934002, "chapter_id": 20934, "verse_number": "७-२२-३", "content_sanskrit": "इदानीं मुनिशार्दूल श्रोतुमिच्छामि सादरम् ।\nएकादश्याः फलं सर्वं सर्वपातकनाशनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000934003, "chapter_id": 20934, "verse_number": "७-२२-४", "content_sanskrit": "कस्मादेकादशी श्रेष्ठा तस्याः को वा विधिः स्मृतः ।\nकदाचित् क्रियते किं वा फलं तस्या वदस्व मे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000934004, "chapter_id": 20934, "verse_number": "७-२२-५", "content_sanskrit": "का वा पूज्यतमा तत्र देवता सद्गुणार्णव ।\nअकुर्वतः स्यात्को दोषस्तन्मे वक्तुमिहार्हसि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000934005, "chapter_id": 20934, "verse_number": "७-२२-६", "content_sanskrit": "व्यास उवाच ।\nएकादश्याः फलं सर्वं वक्तुं नारायणादृते ।\nशक्नोति नान्यो विप्रर्षे तस्माद्वच्मि समासतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000934006, "chapter_id": 20934, "verse_number": "७-२२-७", "content_sanskrit": "सृष्ट्वादौ पुरुषश्रेष्ठः संसारं सचराचरम् ।\nसर्वेषां दमनार्थाय सृष्टवान्पापपूरुषम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000934007, "chapter_id": 20934, "verse_number": "७-२२-८", "content_sanskrit": "द्विजातिहत्यामूर्द्धानं मदिरापानलोचनम् ।\nस्वर्णस्तेयं च वदनं गुरुतल्पगतिः श्रुतिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000934008, "chapter_id": 20934, "verse_number": "७-२२-९", "content_sanskrit": "स्त्रीहत्या नासिकं चैव गोहत्यादोष बाहुकम् ।\nन्यासापहारण ग्रीवं भ्रूणहत्या गलं तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000934009, "chapter_id": 20934, "verse_number": "७-२२-१०", "content_sanskrit": "परस्त्रीगतबुक्काग्रं सुहृल्लोकवधोदरम् ।\nशरणापन्नहत्यादि नाभिगर्तावधिं कटिम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000934010, "chapter_id": 20934, "verse_number": "७-२२-११", "content_sanskrit": "गुरुनिंदा सक्थिभागं कन्याविक्रय शेफसम् ।\nविश्वासवाक्यकथनं पायुं प्रीतिवधांघ्रिकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000934011, "chapter_id": 20934, "verse_number": "७-२२-१२", "content_sanskrit": "उपपातकरोमाणं महाकायं भयंकरम् ।\nकृष्णवर्णं पिंगनेत्रं स्वाश्रयात्यंतदुःखदम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000934012, "chapter_id": 20934, "verse_number": "७-२२-१३", "content_sanskrit": "तं दृष्ट्वा पापपुरुषमत्युग्रं पुरुषोत्तमम् ।\nसदयश्चिंतयामास प्रजाक्लेशहरः प्रभुः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000934013, "chapter_id": 20934, "verse_number": "७-२२-१४", "content_sanskrit": "सृष्टोऽयं दुर्जनः क्रूरः स्वाश्रयक्लेशदायकः ।\nप्रजानां दमनार्थाय सृजाम्येतस्य कारणम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000934014, "chapter_id": 20934, "verse_number": "७-२२-१५", "content_sanskrit": "अथासौ भगवान्विष्णुर्बभूव स्वयमंतकः ।\nससर्ज रौरवादींश्च निरयान्पापिदुःखदान् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000934015, "chapter_id": 20934, "verse_number": "७-२२-१६", "content_sanskrit": "पापं यः सेवते मूढो न याति परमं पदम् ।\nयमाज्ञया व्रजेत्तत्र नरकं रौरवादिकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000934016, "chapter_id": 20934, "verse_number": "७-२२-१७", "content_sanskrit": "एकदा भगवान्विष्णुः प्रजानां दुःखनाशनः ।\nवैनतेयं समारुह्य जगाम यममंदिरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000934017, "chapter_id": 20934, "verse_number": "७-२२-१८", "content_sanskrit": "तं दृष्ट्वा जगतामीशं नारायणमनामयम् ।\nधूपाद्यैः पूजयामास भास्करिस्तुष्टमानसः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000934018, "chapter_id": 20934, "verse_number": "७-२२-१९", "content_sanskrit": "यमेनाभ्यर्चितो विष्णुः सर्वलोकैकनायकः ।\nउवास द्विजशार्दूल पीठे कनकनिर्मिते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000934019, "chapter_id": 20934, "verse_number": "७-२२-२०", "content_sanskrit": "तत्रोपविष्टो भगवान्यमेन सह दैत्यहा ।\nशुश्राव क्रंदनं ध्यानं दक्षिणस्यां दिशि प्रभो ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000934020, "chapter_id": 20934, "verse_number": "७-२२-२१", "content_sanskrit": "अथासौ कमलाकांतो विस्मयाविष्टमानसः ।\nउवाचेति यमं तेषां कुतोऽयं क्रंदनध्वनिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000934021, "chapter_id": 20934, "verse_number": "७-२२-२२", "content_sanskrit": "यम उवाच ।\nदेवपातकिनो मर्त्या निरयेऽत्यंतदुःखदे ।\nस्वहस्तार्जितदोषेण सीदंति च ममालये ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000934022, "chapter_id": 20934, "verse_number": "७-२२-२३", "content_sanskrit": "पापवृक्षफलं विष्णो भोक्तुमत्यंतदुःखदम् ।\nरुदंति पापिनस्तस्मात्तेषां ध्वनिरसौ महान् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000934023, "chapter_id": 20934, "verse_number": "७-२२-२४", "content_sanskrit": "इत्युक्तः सूर्यपुत्रेण कृष्णः कमललोचनः ।\nजगाम सहसा तत्र पापवंतो रुदंति ते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000934024, "chapter_id": 20934, "verse_number": "७-२२-२५", "content_sanskrit": "तान्दृष्ट्वा पापिनो मर्त्यान्रौरवादिषु संस्थितान् ।\nभगवांश्चिंतयामास हृदिजातदयः प्रभुः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000934025, "chapter_id": 20934, "verse_number": "७-२२-२६", "content_sanskrit": "मया सृष्टाः प्रजाः सर्वा दोषेण निजकर्मणाम् ।\nमयि स्थितेऽपि नरके सीदंत्येकांतदुःखदे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000934026, "chapter_id": 20934, "verse_number": "७-२२-२७", "content_sanskrit": "एतच्चान्यच्च विप्रेन्द्र विचिंत्य करुणामयः ।\nबभूव सहसा तत्र स्वयमेकादशी तिथिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000934027, "chapter_id": 20934, "verse_number": "७-२२-२८", "content_sanskrit": "ततस्तान्पापिनः सर्वान्कारयामास तच्छ्रुतम् ।\nते च सर्वे परं धाम ययुर्गलितकल्मषाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000934028, "chapter_id": 20934, "verse_number": "७-२२-२९", "content_sanskrit": "तस्मादेकादशीं विष्णोमूर्तिं विद्धि परात्मनः ।\nसमस्तदुष्कृतिश्रेष्ठं व्रतानां व्रतमुत्तमम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000934029, "chapter_id": 20934, "verse_number": "७-२२-३०", "content_sanskrit": "एकादशीं तिथिं कृत्वा पावयंतीं जगत्त्रयम् ।\nशंकितः पापपुरुषो विष्णुं स्तोतुमुपाययौ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000934030, "chapter_id": 20934, "verse_number": "७-२२-३१", "content_sanskrit": "ततो बद्धाञ्जलिर्भक्त्या स पापपुरुषो द्विज ।\nतुष्टाव कमलाकांतं भगवंतं जनार्दनम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000934031, "chapter_id": 20934, "verse_number": "७-२२-३२", "content_sanskrit": "तस्यस्तवं समाकर्ण्य प्रसन्नः परमेश्वरः ।\nउवाचाहं प्रसन्नोऽस्मि किंतेऽभिमतमुच्यताम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000934032, "chapter_id": 20934, "verse_number": "७-२२-३३", "content_sanskrit": "पापपुरुष उवाच ।\nसृष्टो भगवता विष्णो निजानुग्रहदुःखदः ।\nएकदश्याः प्रभावेण क्षयं प्राप्नोमि सांप्रतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000934033, "chapter_id": 20934, "verse_number": "७-२२-३४", "content_sanskrit": "मृते मयि जगत्यस्मिन्सर्वे ते च शरीरिणः ।\nभविष्यंति विनिर्मुक्ता भवबंधैः शरीरिणः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000934034, "chapter_id": 20934, "verse_number": "७-२२-३५", "content_sanskrit": "सर्वेषु च विमुक्तेषु देहिश्रेष्ठेषु पूरुषम् ।\nसंसारकौतुकागारे कैस्त्वं क्रीडिष्यसे प्रभो ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000934035, "chapter_id": 20934, "verse_number": "७-२२-३६", "content_sanskrit": "क्रीडितुं यदि ते वांछा जगत्कौतुकमंदिरे ।\nएकादशी तिथि भयात्तदा मां त्राहि केशव ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000934036, "chapter_id": 20934, "verse_number": "७-२२-३७", "content_sanskrit": "अन्यैः पुण्यसहस्रैस्तु मां हंतुं न हि शक्यते ।\nशक्नोत्येकादशी पुण्या मां हंतुं वरदो भव ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000934037, "chapter_id": 20934, "verse_number": "७-२२-३८", "content_sanskrit": "मनुष्यपशुकीटेषु तथाऽन्येषु च जंतुषु ।\nपर्वतेषु च वृक्षेषु स्थानेषु च जलेषु च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000934038, "chapter_id": 20934, "verse_number": "७-२२-३९", "content_sanskrit": "नदीषु च समुद्रेषु वनेषु प्रांतरेषु च ।\nस्वर्गे मर्त्ये च पाताले देवगंधर्वपक्षिषु ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000934039, "chapter_id": 20934, "verse_number": "७-२२-४०", "content_sanskrit": "एकादशीतिथि भयाद्भूयान्विष्णो पलायितः ।\nकुत्रापि निर्भयस्थानं न च तेन च कुत्रचित् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000934040, "chapter_id": 20934, "verse_number": "७-२२-४१", "content_sanskrit": "कोटिब्रह्माण्डमध्येषु देवदेव सनातन ।\nएकादश्यां तिथौ स्थातुं मया स्थानं न लभ्यते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000934041, "chapter_id": 20934, "verse_number": "७-२२-४२", "content_sanskrit": "एकादश्यामहं कुत्र वत्स्यामि निर्भयः प्रभो ।\nतन्मे कथय देवेश त्वयासृष्टोऽस्म्यहेतुकः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000934042, "chapter_id": 20934, "verse_number": "७-२२-४३", "content_sanskrit": "व्यास उवाच ।\nइत्युक्त्वा पापपुरुषः क्लेशनाशनमच्युतम् ।\nभूमौ निपत्य चक्रंद स्रवद्वाष्पविलोचनः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000934043, "chapter_id": 20934, "verse_number": "७-२२-४४", "content_sanskrit": "ततः प्रहस्य भगवान्मधुकैटभमर्दनः ।\nएकादशी भयात्त्रस्तमुवाच पापपूरुषम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000934044, "chapter_id": 20934, "verse_number": "७-२२-४५", "content_sanskrit": "श्रीभगवानुवाच ।\nउत्तिष्ठ पापपुरुष त्यज शोकं मुदं कुरु ।\nएकादश्यां तिथौ यत्र तव स्थानं वदामि ते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000934045, "chapter_id": 20934, "verse_number": "७-२२-४६", "content_sanskrit": "एकादश्यां समायांत्यां प्रपुनन्त्यां जगत्त्रयम् ।\nस्थातव्यमन्नमाश्रित्य भवता पापपूरुषः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000934046, "chapter_id": 20934, "verse_number": "७-२२-४७", "content_sanskrit": "अन्नमाश्रित्य तिष्ठंतं भवंतं पापपूरुषम् ।\nन हनिष्यति मन्मूर्तिरियमेकादशी तिथिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000934047, "chapter_id": 20934, "verse_number": "७-२२-४८", "content_sanskrit": "ततो देवोऽपि विप्रर्षे तत्रैवांतर्हितोऽभवत् ।\nकृतार्थः पापपुरुषो ययौ च स यथागतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000934048, "chapter_id": 20934, "verse_number": "७-२२-४९", "content_sanskrit": "तस्मादन्नं न भोक्तव्यं कदाचिदपि सत्तमैः ।\nआत्मनो हितमिच्छद्भिः संप्राप्ते हरिवासरे ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000934049, "chapter_id": 20934, "verse_number": "७-२२-५०", "content_sanskrit": "संसारे यानि पापानि तान्येवैकादशीदिने ।\nअन्नमाश्रित्य तिष्ठंति श्रीमन्नारायणाज्ञया ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000934050, "chapter_id": 20934, "verse_number": "७-२२-५१", "content_sanskrit": "कुर्वतां सर्वपापानि नरकान्निष्कृतिर्भवेत् ।\nयेचान्नं भुञ्जतेऽत्रापि ते ज्ञेयाः पापिनां वराः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000934051, "chapter_id": 20934, "verse_number": "७-२२-५२", "content_sanskrit": "भूयोभूयो दृढं वच्मि श्रूयतां श्रूयतां जनाः ।\nन भोक्तव्यं न भोक्तव्यं न भोक्तव्यं कदाचन ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000934052, "chapter_id": 20934, "verse_number": "७-२२-५३", "content_sanskrit": "ब्रह्मक्षत्रियविट्शूद्रैरन्यैश्च द्विजसत्तम ।\nसर्वैरेकादशी कार्या चतुर्वर्गफलप्रदा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000934053, "chapter_id": 20934, "verse_number": "७-२२-५४", "content_sanskrit": "अष्टादशनिमेषास्तु काष्ठा प्रोक्ता मनीषिभिः ।\nक्षणं त्रिंशत्कलाभिः स्यान्मुहूर्तो द्वादशक्षणैः ।\nत्रिंशन्मुहूर्ता लोकानामहोरात्रः प्रकीर्तितः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000934054, "chapter_id": 20934, "verse_number": "७-२२-५५", "content_sanskrit": "तैः पंञ्चदशभिः पक्षो विज्ञेयो द्विजसत्तम ।\nपक्षाभ्यां शुक्लकृष्णाभ्यां मासस्तु परिकल्पितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000934055, "chapter_id": 20934, "verse_number": "७-२२-५६", "content_sanskrit": "तस्मिन्मासे द्विजश्रेष्ठ पक्षयोः शुक्ल कृष्णयोः ।\nमहापातकयुक्तोऽपि करोत्येकादशीं यदि ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000934056, "chapter_id": 20934, "verse_number": "७-२२-५७", "content_sanskrit": "सर्वपापविनिर्मुक्तो विष्णुलोकमवाप्नुयात् ।\nमाता न प्रोच्यते माता माता ह्येकादशी तिथिः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000934057, "chapter_id": 20934, "verse_number": "७-२२-५८", "content_sanskrit": "इहैव पालयेन्माता सर्वत्रैकादशी तिथिः ।\nएकादशीव्रतं त्यक्त्वा व्रतमन्यत्करोति यः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000934058, "chapter_id": 20934, "verse_number": "७-२२-५९", "content_sanskrit": "स्वकरस्थं मणिं त्यक्त्वा लोष्ठं गृह्णाति मूढधीः ।\nएकादशीव्रतं यैस्तु कृतं भक्तिसमन्वितैः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000934059, "chapter_id": 20934, "verse_number": "७-२२-६०", "content_sanskrit": "तैस्तु यज्ञा कृताः सर्वे व्रतानि सकलानि च ।\nएकादश्यां च भुञ्जन्ति ये मोहात्पापिनो नराः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000934060, "chapter_id": 20934, "verse_number": "७-२२-६१", "content_sanskrit": "शुक्लायां वापि कृष्णायां तेषां रुष्टः सदा हरिः ।\nतेन धर्माः कृताः सर्वे लङ्घिता येन सा तिथिः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000934061, "chapter_id": 20934, "verse_number": "७-२२-६२", "content_sanskrit": "यथा समस्तदेवानां श्रेष्ठो विष्णुः प्रकीर्तितः ।\nतथा सर्वव्रतानां च श्रेष्ठमेकादशी व्रतम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000934062, "chapter_id": 20934, "verse_number": "७-२२-६३", "content_sanskrit": "आदित्यानां यथा सूर्यो नक्षत्राणां यथा शशी ।\nतथा सर्वव्रतश्रेष्ठं प्रोक्तमेकादशीव्रतम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000934063, "chapter_id": 20934, "verse_number": "७-२२-६४", "content_sanskrit": "वृक्षाणां च यथाश्वत्थो वेदानां साम कीर्तितम् ।\nतथा सर्वव्रतश्रेष्ठं प्रोक्तमेकादशीव्रतम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000934064, "chapter_id": 20934, "verse_number": "७-२२-६५", "content_sanskrit": "कवीनामुशना श्रेष्ठो वर्णानां ब्राह्मणो यथा ।\nतथा सर्वव्रतश्रेष्ठं प्रोक्तमेकादशीव्रतम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000934065, "chapter_id": 20934, "verse_number": "७-२२-६६", "content_sanskrit": "व्यासः श्रेष्ठो मुनीनां च देवर्षीणां च नारदः ।\nतथा व्रतानां सर्वेषां श्रेष्ठमेकादशीव्रतम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000934066, "chapter_id": 20934, "verse_number": "७-२२-६७", "content_sanskrit": "यथा समस्तदानानामन्नदानं वरं स्मृतम् ।\nतथा सर्वव्रतश्रेष्ठं प्रोक्तमेकादशीव्रतम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000934067, "chapter_id": 20934, "verse_number": "७-२२-६८", "content_sanskrit": "यथा पुण्यसमं मित्रं नास्ति शास्त्रसमो गुरुः ।\nतथैवैकादशी तुल्यं व्रतं नास्ति जगत्त्रये ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000934068, "chapter_id": 20934, "verse_number": "७-२२-६९", "content_sanskrit": "इन्द्रियाणां यथा श्रेष्ठं मनः प्रोक्तं मनीषिभिः ।\nमासानां कार्तिकः श्रेष्ठः पाण्डवानां यथार्जुनः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000934069, "chapter_id": 20934, "verse_number": "७-२२-७०", "content_sanskrit": "यथा समस्तशास्त्राणां श्रेष्ठा वेदाः प्रकीर्तिताः ।\nतथा व्रतानां प्रवरं स्मृतमेकादशीव्रतम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000934070, "chapter_id": 20934, "verse_number": "७-२२-७१", "content_sanskrit": "वेदागमपुराणेषु शास्त्रेष्वन्येषु च द्विज ।\nकुत्राप्येकादशीतुल्यं व्रतं प्रोक्तं न कोविदैः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000934071, "chapter_id": 20934, "verse_number": "७-२२-७२", "content_sanskrit": "निर्भया मानवाः सर्वे तिष्ठंति क्षितिमण्डले ।\nएकादशीव्रतं कृत्वा किं करिष्यति भास्करिः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000934072, "chapter_id": 20934, "verse_number": "७-२२-७३", "content_sanskrit": "एकामेकादशीं सम्यक्कुर्वतां किंकरो यमः ।\nएकादशीव्रतं तस्मात्कर्तव्यं हि शुभप्रदम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000934073, "chapter_id": 20934, "verse_number": "७-२२-७४", "content_sanskrit": "एकादशीव्रतविधिं संक्षेपात्कथयाम्यहम् ।\nसमाहितमना भूत्वा शृणु सत्तम जैमिने ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000934074, "chapter_id": 20934, "verse_number": "७-२२-७५", "content_sanskrit": "दशम्यां प्रातरुत्थाय कर्तव्यं दंतधावनम् ।\nततस्तैलादृते स्नानं कर्तव्यमन्नवर्जनैः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000934075, "chapter_id": 20934, "verse_number": "७-२२-७६", "content_sanskrit": "ततो विष्णुं समभ्यर्च्य पाद्याद्यैर्जगदीश्वरम् ।\nहरिध्यानपरो भूत्वा एकभोजनमाचरेत् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000934076, "chapter_id": 20934, "verse_number": "७-२२-७७", "content_sanskrit": "आमिषं लवणं चैव तथा मांसं मसूरकम् ।\nबृहन्माषं तथा शाकं दशम्यां परिवर्जयेत् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000934077, "chapter_id": 20934, "verse_number": "७-२२-७८", "content_sanskrit": "द्विर्भोजनं परान्नं च मधूनि मैथुनं तथा ।\nभोजनं कांस्यपात्रेषु दशम्यां परिवर्जयेत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000934078, "chapter_id": 20934, "verse_number": "७-२२-७९", "content_sanskrit": "निम्बपत्रं च वृंताकं दग्धं जंबीरमेव च ।\nघृतहीनं तथा गव्यं दशम्यां परिवर्जयेत् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000934079, "chapter_id": 20934, "verse_number": "७-२२-८०", "content_sanskrit": "अत्यन्तभोजनं चैव अत्यन्ताशनभोजनम् ।\nतांबूलभक्षणं चैव दशम्यां परिवर्जयेत् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000934080, "chapter_id": 20934, "verse_number": "७-२२-८१", "content_sanskrit": "दशम्यां यानि वस्तूनि निषिद्धानि द्विजोत्तम ।\nद्वादश्यामपि तान्येव निषिद्धानि न संशयः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000934081, "chapter_id": 20934, "verse_number": "७-२२-८२", "content_sanskrit": "दशम्यां विप्रशार्दूल द्वादश्यामपि वैष्णवः ।\nसम्यग्व्रतफलप्रेप्सुर्न कुर्यान्निशि भोजनम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000934082, "chapter_id": 20934, "verse_number": "७-२२-८३", "content_sanskrit": "अतो हविष्यं कृत्वा तु दशम्यां सत्वरो व्रती ।\nअपराह्णे पुनः कुर्याद्विधिना दंतधावनम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000934083, "chapter_id": 20934, "verse_number": "७-२२-८४", "content_sanskrit": "सायं देवालयं गत्वा गृहीत्वा कुसुमाञ्जलिम् ।\nकेशवं मनसा ध्मायन्मंत्रमेतमुदीरयेत् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000934084, "chapter_id": 20934, "verse_number": "७-२२-८५", "content_sanskrit": "एतद्गृहीतं गोविंद मया त्वत्पुरतो व्रतम् ।\nसिद्धिं गच्छतु निर्विघ्नं तव पादानुकंपया ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000934085, "chapter_id": 20934, "verse_number": "७-२२-८६", "content_sanskrit": "अतिचंचलचित्तोऽहं लोभमोहमयो नरः ।\nशक्नोम्येतद्व्रतं कर्तुं किं तवानुग्रहादृते ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000934086, "chapter_id": 20934, "verse_number": "७-२२-८७", "content_sanskrit": "इमौ मंत्रौ पठित्वा तु तमेव कुसुमांजलिम् ।\nदत्वा नारायणायाथ दंडवत्प्रणमेद्भुवि ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000934087, "chapter_id": 20934, "verse_number": "७-२२-८८", "content_sanskrit": "तस्मिन्नेव गृहे विष्णोर्विष्णुस्मरणतत्परः ।\nकुशेन शय्यामास्तीर्य भूमौ शयनमाचरेत् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000934088, "chapter_id": 20934, "verse_number": "७-२२-८९", "content_sanskrit": "ततः प्रभाते विमले न कुर्याद्दंतधावनम् ।\nकल्लोलैर्मुखशुद्धिं तु कुर्याद्द्वादशभिर्बुधः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000934089, "chapter_id": 20934, "verse_number": "७-२२-९०", "content_sanskrit": "नित्यक्रियां प्रकुर्वीत विष्णुपूजादिकक्रियाम् ।\nततो निशायां विप्रेन्द्र सकलैर्व्रतिभिर्जनैः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000934090, "chapter_id": 20934, "verse_number": "७-२२-९१", "content_sanskrit": "एकत्र जागरं कुर्यात्पुरतो जगतांपतेः ।\nसमातृकः सभार्यश्च सभ्राता सपिता तथा ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000934091, "chapter_id": 20934, "verse_number": "७-२२-९२", "content_sanskrit": "तथा सपुत्रमित्रश्च कुरुते जागरं हरेः ।\nस तिष्ठेद्विष्णुभवने चिरं व्रतकरो द्विज ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000934092, "chapter_id": 20934, "verse_number": "७-२२-९३", "content_sanskrit": "शङ्खचक्रादिकं चित्रं यो लिखेद्विष्णुमंदिरे ।\nबहुजन्मकृतं पापं हरेत्तस्य जनार्दनः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000934093, "chapter_id": 20934, "verse_number": "७-२२-९४", "content_sanskrit": "तंडूलचूर्णपंकेन विष्णोरायतनेषु च ।\nअन्यैर्वन्यैश्च वा चित्रं लिखेत्तस्य फलं शृणु ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000934094, "chapter_id": 20934, "verse_number": "७-२२-९५", "content_sanskrit": "पुत्रपौत्रप्रपौत्रैश्च भुङ्क्ते च सकलं शुभम् ।\nशेषे विष्णुपुरं गत्वा तत्र मोक्षमवाप्नुयात् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000934095, "chapter_id": 20934, "verse_number": "७-२२-९६", "content_sanskrit": "वासरे कमलाभर्तुर्ध्वजारोपणकृन्नरः ।\nउद्धृत्य कोटिपुरुषान्नारायणपुरं व्रजेत् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000934096, "chapter_id": 20934, "verse_number": "७-२२-९७", "content_sanskrit": "पताकावल्लिभिर्युक्तं विष्णोरायतनं जनः ।\nमण्डयत्यवनीपालः स लभेत्प्रतिजन्मनि ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000934097, "chapter_id": 20934, "verse_number": "७-२२-९८", "content_sanskrit": "पताकाप्रचलंती च यावद्भवति वायुना ।\nतत्कर्तुः पातकं सर्वं तावदेव विनश्यति ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000934098, "chapter_id": 20934, "verse_number": "७-२२-९९", "content_sanskrit": "पताकावलयाः प्राज्ञैर्नानावर्णा हरेर्गृहे ।\nस्थापितव्याः परं स्थानमिच्छद्भिर्हरिवासरे ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000934099, "chapter_id": 20934, "verse_number": "७-२२-१००", "content_sanskrit": "विष्णोः शिरसि यच्छत्रं धत्ते चारुतरं जनः ।\nप्रतिजन्मनि विप्रर्षे क्षत्त्री भवति स क्षितौ ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000934100, "chapter_id": 20934, "verse_number": "७-२२-१०१", "content_sanskrit": "वासरे वासुदेवस्य पुष्पमंडपकृन्नरः ।\nप्रतिपुष्पं लभेत्पुण्यं वाजिमेधशतोत्तरम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000934101, "chapter_id": 20934, "verse_number": "७-२२-१०२", "content_sanskrit": "वासुदेवदिने पुष्पैः सुंगधैर्मंडयन्बुधः ।\nयत्नादपि च कर्तव्यं चतुर्वर्गफलाप्तये ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000934102, "chapter_id": 20934, "verse_number": "७-२२-१०३", "content_sanskrit": "यो वस्त्रगृहनिर्माणं कुरुते हरिवासरे ।\nस सौधवासी विप्रर्षे भवति त्रिदशालये ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000934103, "chapter_id": 20934, "verse_number": "७-२२-१०४", "content_sanskrit": "निर्माय वस्त्रभवनं तत्र बध्नाति मानवः ।\nश्वेतं वा लोहितं वापि कृष्णं वासोऽच्युतप्रियः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000934104, "chapter_id": 20934, "verse_number": "७-२२-१०५", "content_sanskrit": "शालिग्रामशिलां तत्र प्रतिमां वा श्रियःपतेः ।\nपञ्चामृतेन संस्नाप्य स्थापयेद्भक्तितो व्रती ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000934105, "chapter_id": 20934, "verse_number": "७-२२-१०६", "content_sanskrit": "आदौ स्वस्त्ययनं कुर्यात्संकल्पं च तथा बुधः ।\nयत्नादपि च कर्तव्यं चतुर्वर्गफलाप्तये ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000934106, "chapter_id": 20934, "verse_number": "७-२२-१०७", "content_sanskrit": "भूतशुद्धिं निजां विप्र विधानं शास्त्रभाषितैः ।\nततश्चैकमना भूत्वा गृहीत्वा पुष्पमुत्तमम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000934107, "chapter_id": 20934, "verse_number": "७-२२-१०८", "content_sanskrit": "ध्यायन्नारायणं देवं हृदयांभोजवासिनम् ।\nआसीनं हेमपीठे च तथा मणिमयेऽपि च ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000934108, "chapter_id": 20934, "verse_number": "७-२२-१०९", "content_sanskrit": "आसीनं हेमपीठे मणिमयज्वलनालंकृतं क्रीडवेशं बिभ्रल्ले ।\nखोज्ज्वलाभ्रद्युतिरुचिरतनुं दीर्घदोर्भिश्चतुर्भिः ।\nनित्यं विभ्राजमानं सकलकरलयैः सायुधैः पद्मनेत्रैः ।\nपश्यंतं श्रीमुखं तच्छ्रमनुदमनिशं तं भजेऽपाङ्गदृष्ट्या ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000934109, "chapter_id": 20934, "verse_number": "७-२२-११०", "content_sanskrit": "आगच्छ भगवन्देवसहितः श्रीपतेः प्रिय ।\nकर्तव्या हि मया भक्त्या सपर्यास्मिन्व्रते तव ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000934110, "chapter_id": 20934, "verse_number": "७-२२-१११", "content_sanskrit": "सर्वलक्षणसंपन्न लक्ष्म्या सह जगद्गुरो ।\nअस्मिन्वरासने तिष्ठ यावत्पूजां करोमि ते ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000934111, "chapter_id": 20934, "verse_number": "७-२२-११२", "content_sanskrit": "समस्तलोकविख्यात कीर्ते नारायणप्रभो ।\nकच्चित्ते कुशलं सर्वं सर्वं वद सुरार्चित ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000934112, "chapter_id": 20934, "verse_number": "७-२२-११३", "content_sanskrit": "पाद्यं गृहाण देवेश नारायणसुवासितम् ।\nपादद्वयरजोहारि पवित्रमतिशीतलम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000934113, "chapter_id": 20934, "verse_number": "७-२२-११४", "content_sanskrit": "अर्घ्यं ददामि ते विष्णो दूर्वापल्लवसंयुतम् ।\nअखंडतंडुलोपेतं पुंडरीकनिभेक्षण ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000934114, "chapter_id": 20934, "verse_number": "७-२२-११५", "content_sanskrit": "इदमाचमनीयं ते सुपवित्रं ददाम्यहम् ।\nगृहाण परमानंद परमानंदवर्द्धनम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000934115, "chapter_id": 20934, "verse_number": "७-२२-११६", "content_sanskrit": "मया दत्तेन गंधेन जरासंधविनाशन ।\nतवास्तु भूषितं गात्रं लक्ष्मीनाथ सुगंधिना ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000934116, "chapter_id": 20934, "verse_number": "७-२२-११७", "content_sanskrit": "ददाम्यहं पवित्रार्थं जगतामादिकारकम् ।\nइदमाचमनं देव तद्गृहाण सुरेश्वर ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000934117, "chapter_id": 20934, "verse_number": "७-२२-११८", "content_sanskrit": "सृष्टोऽयं विधिना पूर्वं देवानां तुष्टिवृद्धये ।\nअतस्तुभ्यं सुरश्रेष्ठ धूपोऽयं दीयते मया ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000934118, "chapter_id": 20934, "verse_number": "७-२२-११९", "content_sanskrit": "तमसः स्तोमसंहर्ता घृतपूर्णो जनार्दन ।\nतवास्तु प्रीतये देव एष दीपो जनार्दन ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000934119, "chapter_id": 20934, "verse_number": "७-२२-१२०", "content_sanskrit": "सोत्तरीयमिदं वस्त्रं बस्तिश्रोणिसुशोभनम् ।\nददाम्यहं ते देवेश सोपवीतं जगद्गुरो ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000934120, "chapter_id": 20934, "verse_number": "७-२२-१२१", "content_sanskrit": "अन्नं चतुर्विधं स्वादुरसैः षड्भिः समन्वितम् ।\nमया निवेदितं भक्त्या गृहाण परमेश्वर ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000934121, "chapter_id": 20934, "verse_number": "७-२२-१२२", "content_sanskrit": "मुखदुर्गन्धहरणं कर्पूरखदिरान्वितम् ।\nगृहाण विष्णो तांबूलं कैवल्यद महामते ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000934122, "chapter_id": 20934, "verse_number": "७-२२-१२३", "content_sanskrit": "विधिनानेन गोविन्दमुपहारैरनुत्तमैः ।\nपूजयेत्संवृतो भक्त्या प्रहरेषु चतुर्ष्वपि ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000934123, "chapter_id": 20934, "verse_number": "७-२२-१२४", "content_sanskrit": "नानोपहारान्हरये यो यच्छेद्धरिवासरे ।\nवित्तशाठ्यं न कर्तव्यं कर्मणां फलमिच्छता ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000934124, "chapter_id": 20934, "verse_number": "७-२२-१२५", "content_sanskrit": "ततस्तु व्रतिभिः सर्वैर्नारायणपरायणैः ।\nनिशि जागरणं कार्य्यं नृत्यगीतस्तवादिभिः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000934125, "chapter_id": 20934, "verse_number": "७-२२-१२६", "content_sanskrit": "प्रदक्षिणं द्विजश्रेष्ठ नामानि कमलापतेः ।\nसर्वपापविनाशीनि स्मर्तव्यानि व्रते रतैः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000934126, "chapter_id": 20934, "verse_number": "७-२२-१२७", "content_sanskrit": "स्फुरंतं प्रतिवक्त्रेभ्यो हरिनामध्वनिं जनाः ।\nशृण्वंति ते विमुक्ताः स्युर्महद्भिः पापसंचयैः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7000934127, "chapter_id": 20934, "verse_number": "७-२२-१२८", "content_sanskrit": "न पाखंण्डजनालापः कर्तव्यो हरिवासरे ।\nपाखंडालापमात्रेण सर्वधर्मो विनश्यति ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7000934128, "chapter_id": 20934, "verse_number": "७-२२-१२९", "content_sanskrit": "नारायणयशोगीतं प्रतिकंठं विनिःसृतम् ।\nश्रुत्वा मूढा न तृप्यंति श्वानो वीणाक्वणं यथा ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7000934129, "chapter_id": 20934, "verse_number": "७-२२-१३०", "content_sanskrit": "संतो हर्षं समायांति श्रुत्वा गीतं जगत्पतेः ।\nसमस्तपापविध्वंसि वीणाक्वाणं यथा मृगाः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7000934130, "chapter_id": 20934, "verse_number": "७-२२-१३१", "content_sanskrit": "गायंतं हरिगीतानि नृत्यंति नृत्यमुत्तमम् ।\nतृप्यंति व्रतिनो दृष्ट्वा तृप्यंति कमलापतेः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7000934131, "chapter_id": 20934, "verse_number": "७-२२-१३२", "content_sanskrit": "व्रतिनो येन तृप्यंति विष्णोरायतने द्विज ।\nप्रतिजन्मनि वै तेषां पशुता शाश्वती भवेत् ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7000934132, "chapter_id": 20934, "verse_number": "७-२२-१३३", "content_sanskrit": "न ये गीतानि गायंति व्रतिनो हरिवासरे ।\nविहीना वचनैस्ते च भ्रमंति प्रतिजन्मनि ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7000934133, "chapter_id": 20934, "verse_number": "७-२२-१३४", "content_sanskrit": "मृदंगादीनि वाद्यानि कर्तव्यानि हरेः पुरः ।\nयतो वाद्यैर्भवेत्तुष्टो भगवान्मधुसूदनः ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7000934134, "chapter_id": 20934, "verse_number": "७-२२-१३५", "content_sanskrit": "कुर्वंति जागरं विष्णोर्वेदाध्ययनमुत्तमम् ।\nपुराणपठनं वापि कर्तव्यं वैष्णवैर्जनैः ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7000934135, "chapter_id": 20934, "verse_number": "७-२२-१३६", "content_sanskrit": "रामायणं भागवतं भारतं व्यासभाषितम् ।\nअन्यानि च पुराणानि पाठ्यानि हरिवासरे ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7000934136, "chapter_id": 20934, "verse_number": "७-२२-१३७", "content_sanskrit": "ये पठंति पुरो विष्णोर्ये शृण्वन्ति हरेर्दिने ।\nप्रत्यक्षरे लभंते ते कपिलादानजं फलम् ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7000934137, "chapter_id": 20934, "verse_number": "७-२२-१३८", "content_sanskrit": "निशि जागरणं कुर्यात्सानंदो वैष्णवो जनः ।\nजितनिद्रो भवेत्सम्यग्ध्यायते केशवं हृदा ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7000934138, "chapter_id": 20934, "verse_number": "७-२२-१३९", "content_sanskrit": "प्रदक्षिणाकारतया भूयोभूयो हरेर्द्दिने ।\nनिपत्य दण्डवद्भूमौ प्रणमेच्च जनार्द्दनम् ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7000934139, "chapter_id": 20934, "verse_number": "७-२२-१४०", "content_sanskrit": "ततः प्रभाते विमले कृतपंचमहाध्वरः ।\nहरिं संस्नाप्य दुग्धेन पूजयेद्भक्तिमान्व्रती ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7000934140, "chapter_id": 20934, "verse_number": "७-२२-१४१", "content_sanskrit": "व्रतस्य दक्षिणां दद्यान्निजशक्त्या द्विजन्मने ।\nततस्तु द्वादशीमध्ये व्रती पारणमाचरेत् ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7000934141, "chapter_id": 20934, "verse_number": "७-२२-१४२", "content_sanskrit": "पारणं कुरुते यस्तु विलंघ्य द्वादशीतिथिम् ।\nजन्मकोट्यर्जितं पुण्यं तस्य चैव विनश्यति ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7000934142, "chapter_id": 20934, "verse_number": "७-२२-१४३", "content_sanskrit": "द्वादशीतिथिमध्ये तु कर्तव्यं पारणं बुधैः ।\nन कदाचित्त्रयोदश्यां व्रतस्य फलमिच्छुभिः ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7000934143, "chapter_id": 20934, "verse_number": "७-२२-१४४", "content_sanskrit": "उपवासदिने विप्र निशायामपि वैष्णवः ।\nउपवासफलप्रेप्सुर्यत्नात्स्वापं विवर्जयेत् ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7000934144, "chapter_id": 20934, "verse_number": "७-२२-१४५", "content_sanskrit": "विना जागरणं नूनमुपवासो निरर्थकः ।\nअतो जागरणं कार्य्यमुभयोरपि पक्षयोः ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7000934145, "chapter_id": 20934, "verse_number": "७-२२-१४६", "content_sanskrit": "एकादशीव्रतं येन विधिनानेन कुर्वते ।\nसत्यं सत्यं द्विजश्रेष्ठ सर्वे ते मोक्षगामिनः ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7000934146, "chapter_id": 20934, "verse_number": "७-२२-१४७", "content_sanskrit": "जन्ममृत्युहरणैकनिदानं सेंद्र देवनिकरैरपि कार्यम् ।\nवासुदेवदिवसव्रतसारं जैमिने त्वमनिशं कुरु यत्नात् ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}]