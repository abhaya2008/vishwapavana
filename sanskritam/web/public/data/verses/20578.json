[{"id": 7000578000, "chapter_id": 20578, "verse_number": "५-३७-१", "content_sanskrit": "शेष उवाच ।\nते पृष्टा मुनिवर्येण रामचारित्रमद्भुतम् ।\nधन्यं सभाग्यं मन्वानाः प्रोचुरात्मानमादरात्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000578001, "chapter_id": 20578, "verse_number": "५-३७-२", "content_sanskrit": "जना ऊचुः ।\nपवित्रिता वयं सर्वे दर्शनेन तवाधुना ।\nयद्रामकथयास्मान्वै पावयस्यधुना जनान्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000578002, "chapter_id": 20578, "verse_number": "५-३७-३", "content_sanskrit": "शृणुष्व वचनं तथ्यं भवान्ब्रह्मर्षिसत्तमः ।\nत्वया पृष्टं यदस्मभ्यं सर्वं तत्कथयाम वै॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000578003, "chapter_id": 20578, "verse_number": "५-३७-४", "content_sanskrit": "अगस्त्यवाक्याच्छ्रीरामो विप्रहत्यापनुत्तये ।\nयागं करोति सुमहान्सर्वसंभारसंभृतम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000578004, "chapter_id": 20578, "verse_number": "५-३७-५", "content_sanskrit": "तं पालयानाः सर्वे वै त्वदाश्रममुपागताः ।\nअश्वेन सहिता विप्र तज्जानीहि महामते॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000578005, "chapter_id": 20578, "verse_number": "५-३७-६", "content_sanskrit": "इति वाक्यं समाकर्ण्य मनोहारि रसायनम् ।\nअत्यंतं हर्षमापेदे ब्राह्मणो रामभक्तिमान्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000578006, "chapter_id": 20578, "verse_number": "५-३७-७", "content_sanskrit": "अद्य मे फलितो वृक्षो मनोरथश्रियान्वितः ।\nअद्य मे जननी धन्या जातं मां सुषुवे तु या॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000578007, "chapter_id": 20578, "verse_number": "५-३७-८", "content_sanskrit": "अद्य राज्यं मया प्राप्तं कंटकेन विवर्जितम् ।\nअद्य कोशाः सुसंपन्ना अद्य देवाः सुतोषिताः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000578008, "chapter_id": 20578, "verse_number": "५-३७-९", "content_sanskrit": "अग्निहोत्रफलं त्वद्य प्राप्तं मे हविषा हुतम् ।\nयद्द्रक्ष्ये रामचंद्रस्य चरणांभोरुहोर्युगम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000578009, "chapter_id": 20578, "verse_number": "५-३७-१०", "content_sanskrit": "यो नित्यं ध्यायते स्वांते अयोध्यायाः पतिः प्रभुः ।\nस मे दृग्गोचरो नूनं भविष्यति मनोहरः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000578010, "chapter_id": 20578, "verse_number": "५-३७-११", "content_sanskrit": "हनूमान्मां समालिंग्य प्रक्ष्यते कुशलं मम ।\nभक्तिं मे महतीं दृष्ट्वा तोषं प्राप्स्यति सत्तमः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000578011, "chapter_id": 20578, "verse_number": "५-३७-१२", "content_sanskrit": "इति वाक्यं समाकर्ण्य हनूमान्कपिसत्तमः ।\nजग्राह पादयुगलं मुनेरारण्यकस्य हि॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000578012, "chapter_id": 20578, "verse_number": "५-३७-१३", "content_sanskrit": "स्वामिन्हनूमान्विप्रर्षे सेवकोऽहं पुरःस्थितः ।\nजानीहि रामदासस्य रेणुकल्पं मुनीश्वर॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000578013, "chapter_id": 20578, "verse_number": "५-३७-१४", "content_sanskrit": "इत्युक्तवति तस्मिन्वै मुनिः परमहर्षितः ।\nआलिलिंग हनूमंतं रामभक्त्या सुशोभितम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000578014, "chapter_id": 20578, "verse_number": "५-३७-१५", "content_sanskrit": "उभौ प्रेमविनिर्भिन्नावुभावपि सुधाप्लुतौ ।\nस्थगितौ चित्रलिखिताविव तत्र बभूवतुः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000578015, "chapter_id": 20578, "verse_number": "५-३७-१६", "content_sanskrit": "उपविष्टौ कथास्तत्र चक्रतुः सुमनोहराः ।\nरघुनाथपदांभोजप्रीतिनिर्भरमानसौ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000578016, "chapter_id": 20578, "verse_number": "५-३७-१७", "content_sanskrit": "हनूमांस्तमुवाचेदं वचो विविधशोभनम् ।\nआरण्यकं मुनिवरं रामांघ्रिध्याननिर्भृतम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000578017, "chapter_id": 20578, "verse_number": "५-३७-१८", "content_sanskrit": "स्वामिन्नयं दशरथकुलहीरांकुरो महान् ।\nरामभ्राता महाशूरः शत्रुघ्नः प्रणमत्यसौ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000578018, "chapter_id": 20578, "verse_number": "५-३७-१९", "content_sanskrit": "लवणो येन निहतः सर्वलोकभयंकरः ।\nकृताश्च सुखिनः सर्वे मुनयः सुतपोधनाः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000578019, "chapter_id": 20578, "verse_number": "५-३७-२०", "content_sanskrit": "एष पुष्कलनामा त्वां नमत्युद्भटसेवितः ।\nयेनाधुना महावीरा जिताः समरमंडले॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000578020, "chapter_id": 20578, "verse_number": "५-३७-२१", "content_sanskrit": "जानीह्येनं बहुगुणं रामामात्यं महाबलम् ।\nप्राणप्रियं रघुपतेः सर्वज्ञं धर्मकोविदम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000578021, "chapter_id": 20578, "verse_number": "५-३७-२२", "content_sanskrit": "सुबाहुरयमत्युग्रो वैरिवंशदवानलः ।\nरामपादाब्जरोलंबो नमति त्वां महायशाः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000578022, "chapter_id": 20578, "verse_number": "५-३७-२३", "content_sanskrit": "सुमदोऽप्येष पार्वत्या दत्तरामांघ्रिसेवया ।\nप्राप्तोऽधुनासौ संसारवार्धिनिस्तरणं महत्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000578023, "chapter_id": 20578, "verse_number": "५-३७-२४", "content_sanskrit": "सत्यवानयमश्वं यः प्राप्तमाश्रुत्य सेवकात् ।\nराज्यं निवेदयामास स त्वां प्रणमति क्षितौ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000578024, "chapter_id": 20578, "verse_number": "५-३७-२५", "content_sanskrit": "इति वाक्यं समाकर्ण्य समालिंग्य समादरात् ।\nचकारारण्यक ऋषिः स्वागतं फलकादिना॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000578025, "chapter_id": 20578, "verse_number": "५-३७-२६", "content_sanskrit": "ते हृष्टास्तत्र वसतिं चक्रुर्मुनिवराश्रमे ।\nप्रातर्नित्यक्रियां कृत्वा रेवायां ते महोद्यमाः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000578026, "chapter_id": 20578, "verse_number": "५-३७-२७", "content_sanskrit": "नरयानमथारोप्य सेवकैः सहितं मुनिम् ।\nशत्रुघ्नः प्रापयामासायोध्यां रामकृतालयाम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000578027, "chapter_id": 20578, "verse_number": "५-३७-२८", "content_sanskrit": "स दूरान्नगरीं दृष्ट्वा सूर्यवंशनृपोषिताम् ।\nपदातिरभवद्वेगाद्रघुनाथदिदृक्षया॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000578028, "chapter_id": 20578, "verse_number": "५-३७-२९", "content_sanskrit": "संप्राप्य नगरीं रम्यामयोध्यां जनशोभिताम् ।\nमनोरथसहस्रेण संरूढो रामदर्शने॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000578029, "chapter_id": 20578, "verse_number": "५-३७-३०", "content_sanskrit": "ददर्श तत्र सरयूतीरे मंडपशोभिते ।\nरामं दूर्वादलश्यामं कंजकांतिविलोचनम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000578030, "chapter_id": 20578, "verse_number": "५-३७-३१", "content_sanskrit": "मृगशृंगं कटौ रम्यं धारयंतं श्रियान्वितम् ।\nऋषिवृंदैर्व्यासमुख्यैर्वृतं शूरैः सुसेवितम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000578031, "chapter_id": 20578, "verse_number": "५-३७-३२", "content_sanskrit": "भरतेन सुमित्रायास्तनूजेन परीवृतम् ।\nददतं दीनसंधेभ्यो दानानि प्रार्थितानि तम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000578032, "chapter_id": 20578, "verse_number": "५-३७-३३", "content_sanskrit": "विलोक्यारण्यकाख्योऽसौ कृतार्थ इत्यमन्यत ।\nमल्लोचने पद्मदलसमाने रामलोकके॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000578033, "chapter_id": 20578, "verse_number": "५-३७-३४", "content_sanskrit": "अद्य मे सर्वशास्त्रस्य ज्ञातृत्वं बहुसार्थकम् ।\nयेन श्रीराममाज्ञाय प्राप्तोऽयोध्यापुरीमिमाम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000578034, "chapter_id": 20578, "verse_number": "५-३७-३५", "content_sanskrit": "इत्येवमादिवचनानि बहूनि हृष्टो ।\nरामांघ्रिदर्शनसुहर्षित गात्रशोभी ।\nप्रायाद्रमेश्वरसमीपमगम्यमन्यै ।\nर्योगेश्वरैरपि विचारपरैः सुदूरम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000578035, "chapter_id": 20578, "verse_number": "५-३७-३६", "content_sanskrit": "धन्योऽहमद्य रामस्य चरणावक्षिगोचरौ ।\nकरिष्यामि वचो रम्यं वदन्राममवेक्षयन्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000578036, "chapter_id": 20578, "verse_number": "५-३७-३७", "content_sanskrit": "रामोऽपि वाडवश्रेष्ठं ज्वलंतं स्वेन तेजसा ।\nतपोमूर्तिधरं वीक्ष्य प्रत्युत्थानमथाकरोत्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000578037, "chapter_id": 20578, "verse_number": "५-३७-३८", "content_sanskrit": "रामचंद्रस्तस्य पादौ सुचिरं नतवान्महान् ।\nब्रह्मण्यदेवपावित्र्यं कृतमद्यतनोर्मम॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000578038, "chapter_id": 20578, "verse_number": "५-३७-३९", "content_sanskrit": "इति वाक्यं वदंस्तस्य पादयोः पतितः प्रभुः ।\nसुरासुरनमन्मौलिमणिनीराजितांघ्रिकः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000578039, "chapter_id": 20578, "verse_number": "५-३७-४०", "content_sanskrit": "प्रणतं तं नृपश्रेष्ठं वाडवेंद्रो महातपाः ।\nगृहीत्वा भुजयोर्मध्यमालिलिंग प्रियं प्रभुम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000578040, "chapter_id": 20578, "verse_number": "५-३७-४१", "content_sanskrit": "कौसल्यातनयस्तं वा उच्चैर्मणिमयासने ।\nसंस्थाप्य च पदोर्युग्मं जलेनाक्षालयत्प्रभुः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000578041, "chapter_id": 20578, "verse_number": "५-३७-४२", "content_sanskrit": "पादावनेजनोदं तु मस्तकेऽधाद्धरिः स्वयम् ।\nपवित्रितोऽद्य सगणः सकुटुंब इति ब्रुवन्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000578042, "chapter_id": 20578, "verse_number": "५-३७-४३", "content_sanskrit": "चंदनेन विलिप्याथ गां च प्रादात्पयस्विनीम् ।\nउवाच च वचो रम्यं देवदेवेंद्र सेवितः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000578043, "chapter_id": 20578, "verse_number": "५-३७-४४", "content_sanskrit": "स्वामिन्मखो मया वाजिमेधसंज्ञः क्रियेत ह ।\nसोयं त्वच्चरणा यातादद्यपूर्णो भविष्यति॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000578044, "chapter_id": 20578, "verse_number": "५-३७-४५", "content_sanskrit": "अद्य मे ब्रह्महत्योत्थ पापहानिं करिष्यति ।\nअश्वमेधः क्रतुर्युष्मच्चरणेन पवित्रितः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000578045, "chapter_id": 20578, "verse_number": "५-३७-४६", "content_sanskrit": "इति वाक्यं ब्रुवाणं तं राजराजेंद्रसेवितम् ।\nआरण्यक उवाचेदं हसन्माध्व्या गिरा मुनिः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000578046, "chapter_id": 20578, "verse_number": "५-३७-४७", "content_sanskrit": "स्वामिंस्तव तु युक्तं हि वचो ब्रह्मण्यभूमिप ।\nत्वन्मूर्तयो महाराज ब्राह्मणा वेदपारगाः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000578047, "chapter_id": 20578, "verse_number": "५-३७-४८", "content_sanskrit": "त्वं यदा ब्रह्मपूजादि शुभं कर्म करिष्यसि ।\nततोऽखिला नृपा विप्रं पूजयिष्यंति भूमिप॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000578048, "chapter_id": 20578, "verse_number": "५-३७-४९", "content_sanskrit": "त्वयोक्तं यन्महाराज विप्रहत्यापनुत्तये ।\nयागं करोमि विमलं तत्तु हास्यकरं वचः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000578049, "chapter_id": 20578, "verse_number": "५-३७-५०", "content_sanskrit": "त्वन्नामस्मरणान्मूढः सर्वशास्त्रविवर्जितः ।\nसर्वपापाब्धिमुत्तीर्य स गच्छेत्परमं पदम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000578050, "chapter_id": 20578, "verse_number": "५-३७-५१", "content_sanskrit": "सर्ववेदेतिहासानां सारार्थोऽयमिति स्फुटम् ।\nयद्रामनामस्मरणं क्रियते पापतारकम्॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000578051, "chapter_id": 20578, "verse_number": "५-३७-५२", "content_sanskrit": "तावद्गर्जंति पापानि ब्रह्महत्यासमानि च ।\nन यावत्प्रोच्यते नाम रामचंद्र तव स्फुटम्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000578052, "chapter_id": 20578, "verse_number": "५-३७-५३", "content_sanskrit": "त्वन्नामगर्जनं श्रुत्वा महापातककुंजराः ।\nपलायंते महाराज कुत्रचित्स्थानलिप्सया॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000578053, "chapter_id": 20578, "verse_number": "५-३७-५४", "content_sanskrit": "तस्मात्तव कथं हत्या महापुण्यददर्शन ।\nराम त्वत्सुकथां श्रुत्वा पूतः सद्यो भविष्यति॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000578054, "chapter_id": 20578, "verse_number": "५-३७-५५", "content_sanskrit": "मया पूर्वं कृतयुगे गंगायास्तीरवासिनाम् ।\nऋषीणां मुखतो वाक्यं श्रुतमेतत्पुराविदाम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000578055, "chapter_id": 20578, "verse_number": "५-३७-५६", "content_sanskrit": "तावत्पापभियः पुंसां कातराणां सुपापिनाम् ।\nयावन्न वदते वाचा रामनाममनोहरम्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000578056, "chapter_id": 20578, "verse_number": "५-३७-५७", "content_sanskrit": "तस्माद्धन्योऽहमधुना मम संसृतिनाशनम् ।\nसांप्रतं सुलभं रामचंद्र त्वद्दर्शनादभूत्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000578057, "chapter_id": 20578, "verse_number": "५-३७-५८", "content_sanskrit": "इत्युक्तवंतं स मुनिं पूजयामास तत्र वै ।\nसर्वे मुनिजनाः साधु साधु वाक्यमिति ब्रुवन्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000578058, "chapter_id": 20578, "verse_number": "५-३७-५९", "content_sanskrit": "शेष उवाच ।\nअत्याश्चर्यमभूत्तत्र तन्मे निगदतः शृणु ।\nवात्स्यायनमुनिश्रेष्ठ रामभक्तिपरायण॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000578059, "chapter_id": 20578, "verse_number": "५-३७-६०", "content_sanskrit": "रामं दृष्ट्वा महाराजं यादृशं ध्यानगोचरम् ।\nअत्यंतं हर्षमापन्नो जगाद स मुनीश्वरान्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000578060, "chapter_id": 20578, "verse_number": "५-३७-६१", "content_sanskrit": "मुनीश्वराः संशृणुत मद्वाक्यं सुमनोहरम् ।\nमादृशः को न भूलोके भविष्यति सुभाग्यवान्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000578061, "chapter_id": 20578, "verse_number": "५-३७-६२", "content_sanskrit": "नास्ति मत्सदृशः कोपि न जातो न भविष्यति ।\nयद्रामभद्रो मां नत्वा स्वागतं परिपृष्टवान्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000578062, "chapter_id": 20578, "verse_number": "५-३७-६३", "content_sanskrit": "यत्पादपंकजरजः श्रुतिमृग्यं सदैव हि ।\nसोऽद्य मत्पादयोः पाथः पीत्वा पूतममन्यत॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000578063, "chapter_id": 20578, "verse_number": "५-३७-६४", "content_sanskrit": "एवं प्रवदतस्तस्य ब्रह्मस्फोटोऽभवत्तदा ।\nनिर्गतं तद्भवं तेजो विवेश रघुनायके॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000578064, "chapter_id": 20578, "verse_number": "५-३७-६५", "content_sanskrit": "पश्यतां सर्वलोकानां सरयूतीरमंडपे ।\nसायुज्यमुक्तिं संप्राप दुर्ल्लभां योगिभिर्जनैः॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000578065, "chapter_id": 20578, "verse_number": "५-३७-६६", "content_sanskrit": "दिवि तूर्यनिनादोऽभूद्वीणानादोऽभवत्तदा ।\nपुष्पवृष्टिः पपाताग्रे पश्यतां चित्रमद्भुतम्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000578066, "chapter_id": 20578, "verse_number": "५-३७-६७", "content_sanskrit": "मुनयोऽप्येतदीक्षित्वा प्रशंसंतो मुनीश्वरम् ।\nकृतार्थोयं मुनिश्रेष्ठो यद्रामवपुषीक्षितः॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]