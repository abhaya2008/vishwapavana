[{"id": 2208236, "chapter_id": 5447, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2208237, "chapter_id": 5447, "verse_number": "१", "content_sanskrit": "अव्यक्तात् पूर्वमुत्पन्नो महानात्मा महामतिः ।\nअनिर्गुणानां सर्वेषां प्रथमः सर्ग उच्यते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2208238, "chapter_id": 5447, "verse_number": "२", "content_sanskrit": "महानात्मा विभुर्विष्णुर्जिष्णुः शम्भुश्च वीर्यवान् ।\nबुद्धिः प्रज्ञोपलब्धिश्च तथा ख्यातिर्धृतिः स्मृतिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2208239, "chapter_id": 5447, "verse_number": "३", "content_sanskrit": "पर्यायवाचकैः शब्दैर्महानात्मा विभाव्यते ।\nतज्ज्ञानाद् ब्राह्मणो विद्वान् प्रमोहं नैव गच्छति ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2208240, "chapter_id": 5447, "verse_number": "४", "content_sanskrit": "सर्वतः पाणिपादं च सर्वतोक्षिशिरोमुखम् ।\nसर्वतः श्रुतिमल्लोके सर्वमावृत्य तिष्ठति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2208241, "chapter_id": 5447, "verse_number": "५", "content_sanskrit": "महान् प्रभाभिः पुरुषः सर्वस्य हृदि संश्रितः ।\nअणिमा लघिमा प्राप्तिरीशानो ज्योतिरव्ययः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2208242, "chapter_id": 5447, "verse_number": "६", "content_sanskrit": "ये तु बद्धिमतां लोके सन्न्यासनिरताश्च ये ।\nध्यानिनो नित्ययोगाश्च सत्यसन्धा जितेन्द्रियाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2208243, "chapter_id": 5447, "verse_number": "७", "content_sanskrit": "ज्ञानवन्तश्च ये केचिद् अलुब्धा जितमन्यवः ।\nप्रसन्नमनसो धीरा निर्ममा निरहङ्कृताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2208244, "chapter_id": 5447, "verse_number": "८", "content_sanskrit": "विमुक्ताः सर्व एवैते महत्त्वमुपयान्ति वै ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2208245, "chapter_id": 5447, "verse_number": "९", "content_sanskrit": "आत्मनो महतो वेद यः पुण्यां गतिमुत्तमाम् ।\nस धीरः सर्वलोकेषु न मोहमधिगच्छति ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2208246, "chapter_id": 5447, "verse_number": "१०", "content_sanskrit": "विष्णुरेवादिसर्गेषु स्वयम्भूर्भवति प्रभुः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2208247, "chapter_id": 5447, "verse_number": "११", "content_sanskrit": "एवं हि यो वेद गुहाशयं प्रभुं\nनवं पुराणं पुरुषं विश्वरूपम् ।\nहिरण्मयं बुद्धिमतां परां गतिं\nस बुद्धिमान् बुद्धिमतीत्य तिष्ठति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2208248, "chapter_id": 5447, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अनुगीतासु अव्यक्तमहत्सर्गकथनं नाम एकचत्वारिंशोऽध्यायः ॥४१॥\nअनुगीतापर्वणि षड्विंशोऽध्यायः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]