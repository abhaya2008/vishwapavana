[{"id": 2046496, "chapter_id": 2033, "verse_number": "६-८२-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2046497, "chapter_id": 2033, "verse_number": "६-८२-१", "content_sanskrit": "प्रवृत्तमात्रे संग्रामे निवृत्ते च सुशर्मणि ।\nभग्नेषु चापि वीरेषु पाण्डवेन महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2046498, "chapter_id": 2033, "verse_number": "६-८२-२", "content_sanskrit": "क्षुभ्यमाणे बले तूर्णं सागरप्रतिमे तव।\nप्रत्युद्याते च गाङ्गेये त्वरितं विजयं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2046499, "chapter_id": 2033, "verse_number": "६-८२-३", "content_sanskrit": "दृष्ट्वा दुर्योधनो राजा रणे पार्थस्य विक्रमम् ।\nत्वरमाणः समभ्येत्य सर्वांस्तानब्रवीन्नृपान् ॥ ६-८२-४aतेषां तु प्रमुखे शूरं सुशर्माणं महाबलम् ।\nमध्ये सर्वस्य सैन्यस्य भृशं संहर्षयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2046500, "chapter_id": 2033, "verse_number": "६-८२-५", "content_sanskrit": "एष भीष्मः शान्तनवो योद्धुकामो धनञ्जयम् ।\nसर्वात्मना कुरुश्रेष्ठस्त्यक्त्वा जीवितमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2046501, "chapter_id": 2033, "verse_number": "६-८२-६", "content_sanskrit": "तं प्रयान्तं रणे वीरं सर्वसैन्येन भारतम् ।\nसंयत्ताः समरे सर्वे पालयध्वं पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2046502, "chapter_id": 2033, "verse_number": "६-८२-७", "content_sanskrit": "बाढमित्येवमुक्त्वा तु तान्यनीकानि सर्वशः ।\nनरेन्द्राणां महाराज समाजग्मुः पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2046503, "chapter_id": 2033, "verse_number": "६-८२-८", "content_sanskrit": "ततः प्रयातः सहसा भीष्मः शान्तनवोऽर्जुनम् ।\nरणे भारतमायान्तमाससाद महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2046504, "chapter_id": 2033, "verse_number": "६-८२-९", "content_sanskrit": "महाश्वेताश्वयुक्तेन भीमवानरकेतुना ।\nमहता मेघनादेन रथेनातिविराजता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2046505, "chapter_id": 2033, "verse_number": "६-८२-१०", "content_sanskrit": "समरे सर्वसैन्यानामुपयानं धनञ्जयम्।\nअभवत्तुमुलो नादो भयाद्दृष्ट्वा किरीटिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2046506, "chapter_id": 2033, "verse_number": "६-८२-११", "content_sanskrit": "अभीशुहस्तं कृष्णं च दृष्ट्वादित्यमिवापरम् ।\nमध्यंदिनगतं सङ्ख्ये न शेकुः प्रतिवीक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2046507, "chapter_id": 2033, "verse_number": "६-८२-१२", "content_sanskrit": "तथा शान्तनवं भीष्मं श्वेताश्वं श्वेतकार्मुकम् ।\nन शेकुः पाण्डवा द्रष्टुं श्वेतं ग्रहमिवोदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2046508, "chapter_id": 2033, "verse_number": "६-८२-१३", "content_sanskrit": "स सर्वतः परिवृतस्त्रिगर्तैः सुमहात्मभिः ।\nभ्रातृभिः सह पुत्रैश्च तथाऽन्यैश्च महारथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2046509, "chapter_id": 2033, "verse_number": "६-८२-१४", "content_sanskrit": "भारद्वाजस्तु समरे मत्स्यं विव्याध पत्रिणा।\nध्वजं चास्य शरेणाजौ धनुश्चैकेन चिच्छिदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2046510, "chapter_id": 2033, "verse_number": "६-८२-१५", "content_sanskrit": "तदपास्य धनुश्छिन्नं विराटो वाहिनीपतिः ।\nअन्यदादत्त वेगेन धनुर्भारसहं दृढम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2046511, "chapter_id": 2033, "verse_number": "६-८२-१६", "content_sanskrit": "शरांश्चाशीविषाकाराज्ज्वलितान्पन्नगानिव ।\nद्रोणं त्रिभिश्च विव्याध चतुर्भिश्चास्य वाजिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2046512, "chapter_id": 2033, "verse_number": "६-८२-१७", "content_sanskrit": "ध्वजमेकेन विव्याधक सारथिं चास्य पञ्चभिः ।\nधनुरेकेषुणाऽविध्यत्तत्राक्रुध्यद्द्विजर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2046513, "chapter_id": 2033, "verse_number": "६-८२-१८", "content_sanskrit": "तस्य द्रोणोऽवधीदश्वाञ्शरैः सन्नतपर्वभिः।\nअष्टाभिर्भरतश्रेष्ठ सूतमेकेन पत्रिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2046514, "chapter_id": 2033, "verse_number": "६-८२-१९", "content_sanskrit": "स हताश्वादवप्लुत्य स्यन्दनाद्धतसारथिः।\nआरुरोह रथं तूर्णं पुत्रस्य रथिनां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2046515, "chapter_id": 2033, "verse_number": "६-८२-२०", "content_sanskrit": "ततस्तु तौ पितापुत्रौ भारद्वाजं रथे स्थितौ ।\nमहता शरवर्षेण वारयामाससतुर्बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2046516, "chapter_id": 2033, "verse_number": "६-८२-२१", "content_sanskrit": "भारद्वाजस्ततः क्रुद्धः शरमाशीविषोपमम् ।\nचिक्षेप समरे तूर्णं शङ्खं प्रति जनेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2046517, "chapter_id": 2033, "verse_number": "६-८२-२२", "content_sanskrit": "स तस्य हृदयं भित्त्वा पीत्त्वा शोणितमाहवे।\nजगाम धरणीं बाणो लोहितार्द्रवरच्छदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2046518, "chapter_id": 2033, "verse_number": "६-८२-२३", "content_sanskrit": "स पपात रणे तूर्णं भारद्वाजशराहतः।\nधनुस्त्यक्त्वा शरांश्चैव पितुरेव समीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2046519, "chapter_id": 2033, "verse_number": "६-८२-२४", "content_sanskrit": "हतं तमात्मजं दृष्ट्वा विराटः प्राद्रवद्भयात्।\nउत्सृज्य समरे द्रोणं व्यात्ताननमिवान्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2046520, "chapter_id": 2033, "verse_number": "६-८२-२५", "content_sanskrit": "भारद्वाजस्ततस्तूर्णं पाण्डवानां महाचमूम्।\nदारयामास समरे शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2046521, "chapter_id": 2033, "verse_number": "६-८२-२६", "content_sanskrit": "शिखण्डी तु महाराज द्रौणिमासाद्य संयुगे।\nआजघान भ्रवोर्मध्ये नाराचैस्त्रिभिराशुगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2046522, "chapter_id": 2033, "verse_number": "६-८२-२७", "content_sanskrit": "स बभौ रथशार्दूलो ललाटे संस्थितैस्त्रिभिः ।\nशिखरैः काञ्चनमयैर्मेरुस्त्रिभिरिवोच्छ्रितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2046523, "chapter_id": 2033, "verse_number": "६-८२-२८", "content_sanskrit": "अश्वत्थाम ततः क्रुद्धो निमेषार्धाच्छिखण्डिनः ।\nध्वजं सूतमथो राजंस्तुरगानायुधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2046524, "chapter_id": 2033, "verse_number": "६-८२-२९", "content_sanskrit": "शरैर्बहुभिराच्छिद्य पातयामास संयुगे ष।\nस हताश्वादवप्लुत्य रथाद्वै रथिनां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2046525, "chapter_id": 2033, "verse_number": "६-८२-३०", "content_sanskrit": "खङ्गमादाय सुशितं विमलं च शरावरम् ।\nश्येनवद्व्यचरत्क्रुद्धः शिखण्डी शत्रुतापनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2046526, "chapter_id": 2033, "verse_number": "६-८२-३१", "content_sanskrit": "सखङ्गस्य महाराज चरतस्तस्य संयुगे ।\nनान्तरं ददृशे द्रौणिस्तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2046527, "chapter_id": 2033, "verse_number": "६-८२-३२", "content_sanskrit": "ततः शरसहस्राणि बहूनि भरतर्षभ ।\nप्रेषयामास समरे द्रौणिः परमकोपनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2046528, "chapter_id": 2033, "verse_number": "६-८२-३३", "content_sanskrit": "तामापतन्तीं समरे शरवृष्टिं सुदारुणाम्।\nअसिना तीक्ष्णधारेण चिच्छेद बलिनां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2046529, "chapter_id": 2033, "verse_number": "६-८२-३४", "content_sanskrit": "ततोऽस्य विमलं द्रौणिः शतचन्द्रं मनोरमम्।\nचर्माच्छिनदसिं चास्थ खण्डयामास संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2046530, "chapter_id": 2033, "verse_number": "६-८२-३५", "content_sanskrit": "शितैस्तु बहुशो राजंस्तं च विव्याध पत्रिभिः ।\nशिखण्डी तु ततः खङ्गं खण्डितं तेन सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2046531, "chapter_id": 2033, "verse_number": "६-८२-३६", "content_sanskrit": "आविध्य व्यसृजत्तूर्णं ज्वलन्तमिव पन्नगम् ।\nतमापतन्तं सहसा कालानलसमप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2046532, "chapter_id": 2033, "verse_number": "६-८२-३७", "content_sanskrit": "चिच्छेद समरे द्रौणिर्दर्शयन्पाणिलाघवम् ।\nशिखण्डिनं च विव्याध शरैर्बहुभिरायसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2046533, "chapter_id": 2033, "verse_number": "६-८२-३८", "content_sanskrit": "शिखण्डी तु भृशं राजंस्तड्यमानः शितैः शरैः ।\nआरुरोह रथं तूर्णं माधवस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2046534, "chapter_id": 2033, "verse_number": "६-८२-३९", "content_sanskrit": "सात्यकिश्चापि संक्रुद्धो राक्षसं क्रूरमाहवे।\nअलम्बुसं शरैस्तीक्ष्णैर्विव्याध बलिनां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2046535, "chapter_id": 2033, "verse_number": "६-८२-४०", "content_sanskrit": "राक्षसेन्द्रस्ततस्तस्य धनुश्चिच्छेद भारत।\nअर्धचन्द्रेण समरे तं च विव्याध सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2046536, "chapter_id": 2033, "verse_number": "६-८२-४१", "content_sanskrit": "मायां च राक्षसीं कृत्वा शरवर्षैरवाकिरत्।\nतत्राद्भुतमपश्याम शैनेयस्य पराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2046537, "chapter_id": 2033, "verse_number": "६-८२-४२", "content_sanskrit": "असंभ्रमस्तु समरे वध्यमानः शितैः शरैः ।\nऐन्द्रमस्त्रं च वार्ष्णेयो योजयामास भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2046538, "chapter_id": 2033, "verse_number": "६-८२-४३", "content_sanskrit": "विजयाद्यदनुप्राप्तं माधवेन यशस्विना।\nतदस्त्रं भस्मासात्कृत्वा मायां तां राक्षसीं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2046539, "chapter_id": 2033, "verse_number": "६-८२-४४", "content_sanskrit": "अलम्बुसं शरैरन्यैरभ्याकिरत सर्वतः।\nपर्वतं वारिधाराभिः प्रावृषीव बलाहकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2046540, "chapter_id": 2033, "verse_number": "६-८२-४५", "content_sanskrit": "तत्तथा पीडितं तेन माधवेन यशस्विना ।\nप्रदुद्राव भयाद्रक्षस्त्यक्त्वा सात्यकिमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2046541, "chapter_id": 2033, "verse_number": "६-८२-४६", "content_sanskrit": "........ माघवता जित्वा भारत सात्यकिः।\nशैनेयः प्राणद़ज्जित्वा योधानां तव पश्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2046542, "chapter_id": 2033, "verse_number": "६-८२-४७", "content_sanskrit": "न्यहनत्तावकांश्चापि सात्यकिः सत्यविक्रमः ।\nनिशितैर्बहुभिर्बाणैस्तेऽद्रवन्त भयार्दिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2046543, "chapter_id": 2033, "verse_number": "६-८२-४८", "content_sanskrit": "एतस्मिन्नेव काले तु द्रुपदस्यात्मजो बली।\nधृष्टद्युम्नो महाराज पुत्रं तव जनेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2046544, "chapter_id": 2033, "verse_number": "६-८२-४९", "content_sanskrit": "छादयामास समरे शरैः सन्नतपर्वभिः ।\nस च्छाद्यमानो विशिखैर्धृष्टद्युम्नेन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2046545, "chapter_id": 2033, "verse_number": "६-८२-५०", "content_sanskrit": "विव्यथे न च राजेन्द्र तव पुत्रो जनेश्वर ।\nधृष्टद्युम्नं च समरे तूर्णं विव्याध पत्रिभिःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2046546, "chapter_id": 2033, "verse_number": "६-८२-५१", "content_sanskrit": "षष्ट्या च त्रिंशता चैव तदद्भुतमिवाभवत् ।\nतस्य सेनापतिः क्रुद्धो धनुश्चिच्छेद मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2046547, "chapter_id": 2033, "verse_number": "६-८२-५२", "content_sanskrit": "हयांश्च चतुरः शीघ्रं निजघान महाबलः ।\nशरैश्चैनं सुनिशितैः क्षिप्रं विव्याध सप्तभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2046548, "chapter_id": 2033, "verse_number": "६-८२-५३", "content_sanskrit": "स हताश्वान्महाबाहुरवप्लुत्य रथाद्बली ।\nपदातिरसिमुद्यम्य प्राद्रवत्पार्षतं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2046549, "chapter_id": 2033, "verse_number": "६-८२-५४", "content_sanskrit": "शकुनिस्तं समभ्येत्य राजगृद्धी महाबलः ।\nराजानं सर्वलोकस्य रथमारोपयत्स्वकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2046550, "chapter_id": 2033, "verse_number": "६-८२-५५", "content_sanskrit": "ततो नृपं पराजित्य पार्षतः परवीरहा ।\nन्यहनत्तावकं सैन्यं वज्रपाणिरिवासुरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2046551, "chapter_id": 2033, "verse_number": "६-८२-५६", "content_sanskrit": "कृतवर्मा रणे भीमं शरैरार्च्छन्महारथः ।\nप्रच्छादयामास च तं महामेघो रविं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2046552, "chapter_id": 2033, "verse_number": "६-८२-५७", "content_sanskrit": "ततः प्रहस्य समरे भीमसेनः परंतपः ।\nप्रेषयामास संक्रुद्धः सायंकान्कृतवर्मणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2046553, "chapter_id": 2033, "verse_number": "६-८२-५८", "content_sanskrit": "तैरर्द्यमानोऽतिरथः सात्वतः शस्त्रकोविदः ।\nनाकम्पत महाराज भीमं चार्च्छच्छितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2046554, "chapter_id": 2033, "verse_number": "६-८२-५९", "content_sanskrit": "तस्याश्वांश्चतुरो हत्वा भीमसेनो महारथः ।\nसारथिं पातयामास सध्वजं सुपरिष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2046555, "chapter_id": 2033, "verse_number": "६-८२-६०", "content_sanskrit": "शरैर्बहुविधैश्चैनमाचिनोत्परवीरहा ।\nशकलीकृतसर्वाङ्गः श्वावित्तु शललैर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2046556, "chapter_id": 2033, "verse_number": "६-८२-६१", "content_sanskrit": "हताश्वश्च ततस्तूर्णं सुबलस्य रथं ययौ।\nस्वालस्य ते महाराज तव पुत्रस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2046557, "chapter_id": 2033, "verse_number": "६-८२-६२", "content_sanskrit": "भीमसेनोऽपि संक्रुद्धस्तव सैन्यमुपाद्रवत्।\nनिजघान च संक्रुद्धो दण्डपाणिरिवान्तकः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2046558, "chapter_id": 2033, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि सप्तमदिवसयुद्धे द्वशीतितमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-८२-६० सर्वाङ्गो हताश्वः प्रत्यदृश्यतेति झo पाठः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]