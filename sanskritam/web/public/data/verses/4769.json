[{"id": 2178268, "chapter_id": 4769, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178269, "chapter_id": 4769, "verse_number": "१", "content_sanskrit": "तत एनमुपातिष्ठन् शौचार्थं परिचारकाः ।\nकृतशौचं पुनश्चैनं प्रोवाच मधुसूदनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178270, "chapter_id": 4769, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178271, "chapter_id": 4769, "verse_number": "२", "content_sanskrit": "राजन्नधीता वेदास्ते शास्त्राणि विविधानि च ।\nश्रुतानि च पुराणानि राजधर्माश्च केवलाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178272, "chapter_id": 4769, "verse_number": "३", "content_sanskrit": "एवं विद्वान् महाप्राज्ञः समर्थः सत्ववान् बली ।\nआत्मापराधे कस्मात् त्वं कुरुषे रोषमीदृशम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178273, "chapter_id": 4769, "verse_number": "४", "content_sanskrit": "उक्तवांस्ते तथैवाहं भीष्मद्रोणौ च भारत ।\nविदुरः सञ्जयश्चैव त्वं तु राजन्नधः कृथाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178274, "chapter_id": 4769, "verse_number": "५", "content_sanskrit": "स वार्यमाणो नास्माकमकार्षीर्वचनं तदा ।\nपाण्डवानधिकान् जानन् बले शौर्ये च भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178275, "chapter_id": 4769, "verse_number": "६", "content_sanskrit": "राजा हि यः स्थिरः प्राज्ञः स्वयं दोषानवेक्षते ।\nदेशकालविभागं च परं श्रेयः स विन्दति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178276, "chapter_id": 4769, "verse_number": "७", "content_sanskrit": "उच्यमानं न यः श्रेयो गृह्णीते वै यथातथम् ।\nआपदं समनुप्राप्य सोऽभ्येति विलयं किल\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178277, "chapter_id": 4769, "verse_number": "८", "content_sanskrit": "अतोऽन्यवृत्तमात्मानं समवेक्षस्व भारत ।\nराजंस्त्वमविधेयात्मा दुर्योधनवशे स्थितः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178278, "chapter_id": 4769, "verse_number": "९", "content_sanskrit": "आत्मापराधादापन्नः तत् किं भीमजिघांसया ।\nतस्मात् संयच्छ कोपं त्वं स्वमनुस्मृत्य दुष्कृतम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178279, "chapter_id": 4769, "verse_number": "१०", "content_sanskrit": "यस्तु तां स्पर्धया क्षुद्रः पाञ्चालीमानयत् सभाम् ।\nस हतो भीमसेनेन वैरं प्रतिचिकीर्षता\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178280, "chapter_id": 4769, "verse_number": "११", "content_sanskrit": "आत्मनोऽतिक्रमं पश्य पुत्रस्य च दुरात्मनः ।\nयदनागसि पाण्डूनां परित्यागः परन्तप\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178281, "chapter_id": 4769, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178282, "chapter_id": 4769, "verse_number": "१२", "content_sanskrit": "एवमुक्तः स कृष्णेन नृपः सत्यं जनाधिप ।\nउवाच देवकीपुत्रं धृतराष्ट्रो महीपतिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178283, "chapter_id": 4769, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178284, "chapter_id": 4769, "verse_number": "१३", "content_sanskrit": "एवमेतन्महाभाग यथा वदसि माधव ।\nपुत्रस्नेहस्तु धर्मात्मान् धर्मान्मां समचालयन्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178285, "chapter_id": 4769, "verse_number": "१४", "content_sanskrit": "दिष्ट्या स पुरुषव्याघ्रो बलवान् सत्यविक्रमः ।\nत्वद्गुप्तो नागमत् कृष्ण भीमो बाह्वन्तरं मम\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178286, "chapter_id": 4769, "verse_number": "१५", "content_sanskrit": "इदानीं त्वहमेकाग्रो गतमन्युर्गतज्वरः ।\nमध्यमं पाण्डवं वीरं स्प्रष्टुमिच्छामि केशव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178287, "chapter_id": 4769, "verse_number": "१६", "content_sanskrit": "हतेषु पार्थिवेष्वेषु पुत्रेषु च हतेषु च ।\nपाण्डुपुत्रेषु मे धर्मः प्रीतिश्चाप्यवतिष्ठते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178288, "chapter_id": 4769, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178289, "chapter_id": 4769, "verse_number": "१७", "content_sanskrit": "ततः स भीमं च धनञ्जयं च\nमाद्र्याश्च पुत्रौ पुरुषप्रवीरौ ।\nपस्पर्श गात्रैः प्ररुदन् स्वगात्रम्\nआश्वास्य कल्याणमुवाच चैनान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178290, "chapter_id": 4769, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nधृतराष्ट्रकोपविसर्जनं नाम त्रयोदशोऽध्यायः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178291, "chapter_id": 4769, "verse_number": "", "content_sanskrit": "जलप्रदानपर्वणि त्रयोदशोऽध्यायः ॥१३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]