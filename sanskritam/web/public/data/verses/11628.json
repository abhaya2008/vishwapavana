[{"id": 50018782, "chapter_id": 11628, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50018783, "chapter_id": 11628, "verse_number": "2", "content_sanskrit": "ततः स्वयं देवपतिस्तुङ्गमारुह्य वारणम्। किरीटी बद्धतूणीरः प्रगृहीतशरासनः॥ १०/६७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50018784, "chapter_id": 11628, "verse_number": "3", "content_sanskrit": "अभ्यद्रवद् रणे कृष्णं गजः केसरिणं यथा। पारिजातकृते राजन् पौलोम्या वचनं स्मरन्॥ १०/६७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50018785, "chapter_id": 11628, "verse_number": "4", "content_sanskrit": "तमायान्तमभिप्रेक्ष्य हरिः परपुरञ्जयः। शङ्खं दध्मौ महानादं दिशः समभिपूरयन्॥ १०/६७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50018786, "chapter_id": 11628, "verse_number": "5", "content_sanskrit": "तमभिद्रुत्य देवेन्द्रो महद् विष्फारयन् धनुः। क्षुरप्रेण सुतीक्ष्णेन कृष्णं विव्याध सङ्गरे॥ १०/६७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50018787, "chapter_id": 11628, "verse_number": "6", "content_sanskrit": "हरिर्विद्धः क्षुरप्रेण देवराजेन वक्षसि। प्रहस्य साधु शक्रोऽसि युक्तं त इति चाब्रवीत्॥ १०/६७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50018788, "chapter_id": 11628, "verse_number": "7", "content_sanskrit": "भूयोऽपि बाणान् दश देवराजः सन्धाय चापे भुजगेन्द्रकल्पे। आकर्णपूर्णं विनिकृष्य कृष्णे मुमोच चक्रे स ह सिंहनादम्॥ १०/६७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50018789, "chapter_id": 11628, "verse_number": "8", "content_sanskrit": "तानन्तरे कंसरिपुर्महात्मा छित्त्वा त्रिधैकेन शरेण बाणान्। विव्याध बाणैर्दशभिः सुधौतैः पुरन्दरं भारत लीलयैव॥ १०/६७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50018790, "chapter_id": 11628, "verse_number": "9", "content_sanskrit": "ते शरा देवराजस्य गात्रं निर्भिद्य सावृति। शोणिताक्ताः प्रदृश्यन्ते भूयो वेगेन निर्गताः॥ १०/६७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50018791, "chapter_id": 11628, "verse_number": "10", "content_sanskrit": "पुनश्च शक्रः कोदण्डे शरान् सन्धाय षोडश। मुमोचाकृष्य गोविन्दस्तांश्चकर्त शरैस्त्रिभिः॥ १०/६७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50018792, "chapter_id": 11628, "verse_number": "11", "content_sanskrit": "भूयोऽपि बाणैस्त्रिंशद्भिः सुरराजानमाहवे। अयोधयद्धरिस्ते च ममज्जुः शक्रवक्षसि॥ १०/६७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50018793, "chapter_id": 11628, "verse_number": "12", "content_sanskrit": "ततश्चुकोप देवेन्द्रो दण्डाहत इवोरगः। प्रेषयामास तोत्रेण ताक्र्ष्यं प्रति महागजम्॥ १०/६७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50018794, "chapter_id": 11628, "verse_number": "13", "content_sanskrit": "स गजः प्राप्य गरुडं पाकशासनचोदितः। चतुर्भिर्घट्टयामास दन्तैर्बाहुयुगान्तरे॥ १०/६७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50018795, "chapter_id": 11628, "verse_number": "14", "content_sanskrit": "ततस्तुण्डेन गरुडः पक्षाभ्यां च तथा नखैः। मर्दयामास कौरव्य गजमैरावताह्वयम्॥ १०/६७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50018796, "chapter_id": 11628, "verse_number": "15", "content_sanskrit": "शक्रस्तु वज्रमुद्यम्य घोरं दानवभीषणम्। पश्यतां सर्वभूतानां प्रजहार वृषाकपिम्॥ १०/६७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50018797, "chapter_id": 11628, "verse_number": "16", "content_sanskrit": "तमागतं मधुरिपुर्वज्रं दुश्च्यवनायुधम्। वामेन पाणिना विष्णुर्जग्राह प्रजहास च॥ १०/६७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50018798, "chapter_id": 11628, "verse_number": "17", "content_sanskrit": "निरायुधः सुरपतिर्गरुडार्दितवाहनः। व्यावर्तत रणाद् राजन् व्रीळावनतकन्धरः॥ १०/६७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50018799, "chapter_id": 11628, "verse_number": "18", "content_sanskrit": "तं दृष्ट्वा भ्रष्टसङ्कल्पं पलायनपरायणम्। सत्यभामा सुरपतिं प्रहसन्तीदमब्रवीत्॥ १०/६७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50018800, "chapter_id": 11628, "verse_number": "19", "content_sanskrit": "सत्यभामोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50018801, "chapter_id": 11628, "verse_number": "20", "content_sanskrit": "एहि शक्र निवर्तस्व मा याहि कुलिशायुध। पलायनमयुक्तं हि पौलोभ्या वल्लभस्य ते॥ १०/६७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50018802, "chapter_id": 11628, "verse_number": "21", "content_sanskrit": "ऐश्वर्यमत्ता पौलोमी भर्तृपौरुषगर्विता। अवमंस्यति सद्यस्त्वां भार्या रणपराजितम्॥ १०/६७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50018803, "chapter_id": 11628, "verse_number": "22", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50018804, "chapter_id": 11628, "verse_number": "23", "content_sanskrit": "इत्थं देव्या गिरं शक्रः सोपालम्भमुदीरिताम्। निशम्याभिमुखो भूत्वा प्राह देवीं शुचिस्मिताम्॥ १०/६७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50018805, "chapter_id": 11628, "verse_number": "24", "content_sanskrit": "इन्द्र उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50018806, "chapter_id": 11628, "verse_number": "25", "content_sanskrit": "येनामरासुरमहोरगयक्षसिद्धगन्धर्वकिन्नरपिशाचनिशाचराद्याः। सृष्टास्त्रिलोकगुरुणा रणमूर्ध्नि तेन को वा न याति परिभूतिमलं विरुद्ध्य॥ १०/६७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50018807, "chapter_id": 11628, "verse_number": "26", "content_sanskrit": "वत्सो यथा तनुबलः सकृदेत्य मातर्यूधस्यपानसमये कुरुते विरोधम्। तद्वद् वयं च निजशैशवमप्रमेये नाथे विरुध्य पिशिताशनि दर्शयामः॥ १०/६७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50018808, "chapter_id": 11628, "verse_number": "27", "content_sanskrit": "इति सत्राजितः पुत्रीमुक्त्वा भारतसत्तम। कृताञ्जलिः प्रणम्याह वासुदेवं पुरन्दरः॥ १०/६७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50018809, "chapter_id": 11628, "verse_number": "28", "content_sanskrit": "इन्द्र उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50018810, "chapter_id": 11628, "verse_number": "29", "content_sanskrit": "नमस्ते देवदेवेश पुण्डरीकाक्ष माधव। क्षमस्व मत्कृतं विश्वमपराधं जगत्पते॥ १०/६७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50018811, "chapter_id": 11628, "verse_number": "30", "content_sanskrit": "न मां त्वदेकशरणं शरणागतवत्सलः। भूरिबालिशमक्षान्तं परित्यक्तुं त्वमर्हसि॥ १०/६७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50018812, "chapter_id": 11628, "verse_number": "31", "content_sanskrit": "ऐरावतश्च कुलिशः पारिजातश्च पादपः। देवराज्यं च भगवन्नियं चाप्यमरावती॥ १०/६७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50018813, "chapter_id": 11628, "verse_number": "32", "content_sanskrit": "त्वदधीनमिदं विश्वमहमाज्ञाकरस्तव। अत्र यद् रोचते नेतुं नीयतां तद् यथेच्छया॥ १०/६७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50018814, "chapter_id": 11628, "verse_number": "33", "content_sanskrit": "किन्तु वक्ष्यामि गोविन्द मूलं त्वयि विरुध्यतः। रमसे मानुषे लोके भगवंस्त्वमनन्यधीः॥ १०/६७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50018815, "chapter_id": 11628, "verse_number": "34", "content_sanskrit": "तत्र नीते पारिजाते भवता कल्पपादपे। तेन सञ्जायते स्वर्गान्निर्विशेषा वसुन्धरा॥ १०/६७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50018816, "chapter_id": 11628, "verse_number": "35", "content_sanskrit": "तेनाहं यदुशार्दूल विरोधं कृतवांस्त्वयि। तत् क्षन्तव्यं त्वया देव कार्याकार्यं विजानता॥ १०/६७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50018817, "chapter_id": 11628, "verse_number": "36", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50018818, "chapter_id": 11628, "verse_number": "37", "content_sanskrit": "इत्युक्तो देवराजेन देवदेवो जनार्दनः। पुरन्दरं कुरुश्रेष्ठ प्राह प्रहसिताननः॥ १०/६७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50018819, "chapter_id": 11628, "verse_number": "38", "content_sanskrit": "श्रीभगवानुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50018820, "chapter_id": 11628, "verse_number": "39", "content_sanskrit": "अपराधस्त्वया शक्र न कश्चिदपि चेष्टितः। यत् कृतं तत् ममैवागस्त्वभेदादावयोः परम्॥ १०/६७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50018821, "chapter_id": 11628, "verse_number": "40", "content_sanskrit": "यत् त्वयाऽद्य सहस्राक्ष चेष्टितं साध्वसाधु वा। मयैव तत् कृतं सर्वं नात्र कार्या विचारणा॥ १०/६७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50018822, "chapter_id": 11628, "verse_number": "41", "content_sanskrit": "पारिजातस्तरुश्रेष्ठो मय्यारूढे पुनर्दिवम्। मन्निर्देशात् सहस्राक्ष स्वयमेष्यति नन्दनम्॥ १०/६७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50018823, "chapter_id": 11628, "verse_number": "42", "content_sanskrit": "इत्युक्त्वा वासुदेवेन देवराजः कुरूद्वह। गोविन्दं सत्यभामां च प्रसाद्य गरुडं तथा॥ १०/६७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50018824, "chapter_id": 11628, "verse_number": "43", "content_sanskrit": "पुत्रो मे रक्षितव्यस्ते स्यालो बीभत्सुरित्यपि। भूयोभूयः प्रार्थयित्वा कृतानुज्ञः पुरन्दरः॥ १०/६७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50018825, "chapter_id": 11628, "verse_number": "44", "content_sanskrit": "सार्धं सकलदिक्पालैर्लब्धानुज्ञः पुरं ययौ। पुरन्दरं सदिक्पालं विसृज्य यदुनन्दनः॥ १०/६७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50018826, "chapter_id": 11628, "verse_number": "45", "content_sanskrit": "गरुडं प्राह कौरव्य यास्यामो द्वारकामिति। गोविन्दं सत्यभामां च पारिजातं च पादपम्॥ १०/६७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50018827, "chapter_id": 11628, "verse_number": "46", "content_sanskrit": "गरुडः पन्नगरिपुर्लीलयैव वहन् ययौ। सम्प्रविश्य पुरीं रम्यां द्वारतोरणभूषिताम्॥ १०/६७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50018828, "chapter_id": 11628, "verse_number": "47", "content_sanskrit": "पताकामालिनीं दिव्यां सिक्तसंमृष्टभूतळाम्। ऊढोपायनताम्बूलस्रग्गन्धकलशाक्षतैः॥ १०/६७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50018829, "chapter_id": 11628, "verse_number": "48", "content_sanskrit": "उपस्थितैर्यदुश्रेष्ठैः पूजितश्चाभिवन्दितः। तूर्यमङ्गळनिर्घोषैर्वेदस्वाध्यायनिःस्वनैः॥ १०/६७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50018830, "chapter_id": 11628, "verse_number": "49", "content_sanskrit": "प्रविवेश सभां दिव्यां सुधर्मां वृद्धसेविताम्। आहुकं वसुदेवं च बलभद्रं तथाऽग्रजम्॥ १०/६७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50018831, "chapter_id": 11628, "verse_number": "50", "content_sanskrit": "अभिवाद्य यथान्यायं पूजितस्तैर्यथोचितम्। उपविष्टः सभामध्ये काञ्चने परमासने॥ १०/६७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50018832, "chapter_id": 11628, "verse_number": "51", "content_sanskrit": "रराज राजशार्दूल बृहस्पतिपुरोगमैः। लोकपालैरुपासीनैर्दिवि वज्रधरो यथा॥ १०/६७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50018833, "chapter_id": 11628, "verse_number": "52", "content_sanskrit": "प्राङ्कणे सत्यभामायाः पारिजातं महाद्रुमम्। स्थापयामास गोविन्दः सर्वतो मणिकुट्टिमे॥ १०/६७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50018834, "chapter_id": 11628, "verse_number": "53", "content_sanskrit": "आयान्तं देवकापुत्रं योषित्सार्थेन भूरिणा। श्रुत्वा द्रष्टुमुपाजग्मुः सकला यादवस्त्रियः॥ १०/६७/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50018835, "chapter_id": 11628, "verse_number": "54", "content_sanskrit": "वसुदेवस्य कौरव्य रोहिण्याद्याः स्त्रियोऽखिलाः। आजग्मुः केशवं द्रष्टुं जितशत्रुमनामयम्॥ १०/६७/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50018836, "chapter_id": 11628, "verse_number": "55", "content_sanskrit": "स दृष्ट्वा मातरो विष्णुर्देवक्या सह सङ्गताः। चक्रे प्रणाममाशीर्भिस्ताश्च तं प्रत्यपूजयन्॥ १०/६७/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50018837, "chapter_id": 11628, "verse_number": "56", "content_sanskrit": "रुग्मिण्याद्यास्तथा सप्त महिष्यः कृष्णवल्लभाः। प्रणेमुर्देवमभ्येत्य दिव्यरूपाः स्वलङ्कृताः॥ १०/६७/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50018838, "chapter_id": 11628, "verse_number": "57", "content_sanskrit": "रेवती रामदयिता त्रिवक्रा च यशस्विनी। एकानङ्गा च तन्वङ्गी चित्रा च वरवर्णिनी॥ १०/६७/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50018839, "chapter_id": 11628, "verse_number": "58", "content_sanskrit": "अन्याश्च कुरुशार्दूल भोजवृष्ण्यन्धकस्त्रियः। आनीतप्रमादासार्थं जितशत्रुमनामयम्॥ १०/६७/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50018840, "chapter_id": 11628, "verse_number": "59", "content_sanskrit": "गोविन्दं सत्यभामां चाप्यानीतममरद्रुमम्। प्रीत्युत्फुल्लमुखाः सर्वे कौतुकाद् द्रष्टुमाययुः॥ १०/६७/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 50018841, "chapter_id": 11628, "verse_number": "60", "content_sanskrit": "ताः समेता यथाजोषं लाजप्रसवतन्दुलैः। स्पृष्ट्वा मूर्ध्नि मुकुन्दस्य जग्मुः स्वं स्वं निवेशनम्॥ १०/६७/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 50018842, "chapter_id": 11628, "verse_number": "61", "content_sanskrit": "इति श्रीमद्भागवते दशमस्कन्धे सप्तषष्टितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]