[{"id": 7003574000, "chapter_id": 23574, "verse_number": "२१४-१", "content_sanskrit": "ब्रह्मोवाच ।\nअन्तर्हितं ततस्तस्मिन्भवे वै भूतनायके ।\nबभूव दिव्यः स तदा नन्दी गणचमूपतिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003574001, "chapter_id": 23574, "verse_number": "२१४-२", "content_sanskrit": "चतुर्भुजस्त्रिणयनो दिव्यसंस्थानसंस्थितः ।\nदिव्यवर्णवपूश्चारुर्दिव्यागुरुसमन्वितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003574002, "chapter_id": 23574, "verse_number": "२१४-३", "content_sanskrit": "त्रिशूली परिघी दण्डी पिनाकी मौञ्जमेखली ।\nशुशुभे तेजता तत्र द्वितीय इव शंकरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003574003, "chapter_id": 23574, "verse_number": "२१४-४", "content_sanskrit": "आस्थितः पादमाकृष्य ह्याह्वयन्निव स द्विजः ।\nत्रिभिः क्रमैः क्रांतुमनास्त्रिविक्रम इवोद्यतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003574004, "chapter_id": 23574, "verse_number": "२१४-५", "content_sanskrit": "तं दृष्ट्वा खेचराः सर्वा देवताः परिशंकिताः ।\nआख्यातुं पुरुहूताय सम्भ्रान्ताः प्रययुर्दिवम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003574005, "chapter_id": 23574, "verse_number": "२१४-६", "content_sanskrit": "तेभ्यः श्रुत्वा सहस्राक्षः सर्वे चान्ये दिवौकसः ।\nविषादं परमं गत्वा चिन्तामापेदिरे भृशम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003574006, "chapter_id": 23574, "verse_number": "२१४-७", "content_sanskrit": "अयं कश्चिद्वरं लब्ध्वा ह्युमाकान्तान्महेश्वरात् ।\nअत्यूर्जितबलः श्रीमांस्त्रैलोक्यं प्राप्स्यति ध्रुवम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003574007, "chapter_id": 23574, "verse_number": "२१४-८", "content_sanskrit": "यादृशोऽस्य महोत्साहस्तेजोबलसमन्वितः ।\nनूनमेष महासत्त्वो हरेत्स्थानं दिवौकसाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003574008, "chapter_id": 23574, "verse_number": "२१४-९", "content_sanskrit": "यावच्चैवोजसा नाकमसौ चंक्रमते प्रभुः ।\nप्रसादयामो वरदं तावदेव महेश्वरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003574009, "chapter_id": 23574, "verse_number": "२१४-१०", "content_sanskrit": "एवमुक्त्वा तु ते तत्र मया सह सुरोत्तमाः ।\nगिरेर्मौञ्जवतः शृङ्गमाजग्मुर्देवनिर्मितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003574010, "chapter_id": 23574, "verse_number": "२१४-११", "content_sanskrit": "विधाता भगवान्विष्णुः प्रभुस्त्रिभुवनेश्वरः ।\nअभ्यधावंस्ततः सोऽथ स हि जानाति हृद्गतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003574011, "chapter_id": 23574, "verse_number": "२१४-१२", "content_sanskrit": "कृतेन तेन विबुधाः पश्यन्ति मुनयश्च तं ।\nततः स भगवान्विष्णुः सहदेवः सधातृकः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003574012, "chapter_id": 23574, "verse_number": "२१४-१३", "content_sanskrit": "जगाम तत्र यत्रासौ नन्दी तिष्ठति देववत् ।\nनन्द्युवाच ।\nसफलं जीवितं मेऽद्य सफलश्च परिश्रमः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003574013, "chapter_id": 23574, "verse_number": "२१४-१४", "content_sanskrit": "यन्मे दृष्टः सुराध्यक्षः सर्वलोकगुरुर्हरिः ।\nपर्याप्तं तन्ममाद्येह कृतकृत्योऽस्मि तेन वै ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003574014, "chapter_id": 23574, "verse_number": "२१४-१५", "content_sanskrit": "यच्च मे प्रभुरव्यग्रः प्रीतः पापहरो हरः ।\nविधाय पार्षदत्वं मे वरानिष्टान्ददौ शिवः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003574015, "chapter_id": 23574, "verse_number": "२१४-१६", "content_sanskrit": "परो मेऽनुग्रहः सोऽत्र पूतोऽस्मि खलु साम्प्रतम् ।\nयच्चोक्तं विधिना वाक्यं देवान्प्रति महात्मना ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003574016, "chapter_id": 23574, "verse_number": "२१४-१७", "content_sanskrit": "मामुद्दिश्य हितं तथ्यं तथैव च न चान्यथा ।\nयन्मां देवर्षयः प्रीत्या समागत्य प्रियंवदाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003574017, "chapter_id": 23574, "verse_number": "२१४-१८", "content_sanskrit": "तेनास्मि परमप्रीत आदृतः परमेष्ठिना ।\nदेवा ऊचुः ।\nवयं तं वरदं देवं द्रक्ष्यामस्ते वरप्रदम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003574018, "chapter_id": 23574, "verse_number": "२१४-१९", "content_sanskrit": "तवैष तपसा तुष्टः स्वयं प्रत्यक्षताङ्गतः ।\nइत्युक्तवन्तस्ते देवाः पुनरूचुर्द्विजोत्तमम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003574019, "chapter_id": 23574, "verse_number": "२१४-२०", "content_sanskrit": "कुत्र द्रक्ष्यामहे देवं भगवन्तं कपालिनम्।\nनन्द्युवाच ।\nअनुगृह्य तु मां देवस्तत्रैवादर्शनं गतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003574020, "chapter_id": 23574, "verse_number": "२१४-२१", "content_sanskrit": "न जाने कुत्र वा देवं कुत्रास्ते तद्गवेष्यताम्।\nसनत्कुमार उवाच ।\nकिमत्र नन्दिनं देवो येनासौ नोक्तवान्प्रभुम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003574021, "chapter_id": 23574, "verse_number": "२१४-२२", "content_sanskrit": "तन्मे कथय देवेश गुह्यं किं चास्ति शूलिनः ।\nब्रह्मोवाच ।\nयदुक्तवान्महेशानो नाख्येयोऽस्मि पुरान्जनि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003574022, "chapter_id": 23574, "verse_number": "२१४-२३", "content_sanskrit": "किमुक्तवान्महादेवो नन्दिनं तच्छृणुष्व मे ।\nईश्वर उवाच ।\nअस्ति कश्चित्समुद्देशः क्षितेः सिद्धोऽद्रिसंकटः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003574023, "chapter_id": 23574, "verse_number": "२१४-२४", "content_sanskrit": "पारे हिमवतः पुण्ये तपोवनगणैर्युतः ।\nतत्र श्लेष्मातको नाम वसते पन्नगोत्तमः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003574024, "chapter_id": 23574, "verse_number": "२१४-२५", "content_sanskrit": "सोऽनुग्राह्यो मयावश्यं तपसा दग्धकिल्बिषः ।\nतदभ्याशे च रुचिरं न चासौ वानराश्रयः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003574025, "chapter_id": 23574, "verse_number": "२१४-२६", "content_sanskrit": "तस्य नाम्ना च तत्स्थानं दिव्यं चिरतपोभृतम्।\nश्लेष्मातकवनं नाम पुण्यशीलशिलोच्चयम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003574026, "chapter_id": 23574, "verse_number": "२१४-२७", "content_sanskrit": "मृगरूपेण चरता तत्र वै त्रिदशा मया ।\nद्रष्टव्याः सञ्जिघृतक्षन्तः खिन्नाश्चान्वेषणे मम ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003574027, "chapter_id": 23574, "verse_number": "२१४-२८", "content_sanskrit": "नाख्यातव्यं त्वया तेषां देवताप्सरसामिदम् ।\nअनुगृह्य वरैस्तैश्च तत्रैवान्तरधीयत ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003574028, "chapter_id": 23574, "verse_number": "२१४-२९", "content_sanskrit": "विद्योतयन्दिशः सर्वास्त्रिदशैः परिवारितः ।\nबालकेन्दुनिभं दिव्यमर्च्चितं दिव्यबिन्दुभिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003574029, "chapter_id": 23574, "verse_number": "२१४-३०", "content_sanskrit": "कामगं रथमारुह्य महेन्द्रः समरुद्गणः ।\nआयातः शैलपृष्ठन्तमोजसा पूरयन्निव ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003574030, "chapter_id": 23574, "verse_number": "२१४-३१", "content_sanskrit": "गणावृतश्च वरदो वरुणो यादसांपतिः ।\nवज्रस्फटिक चित्रेण विमानेनातितेजसा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003574031, "chapter_id": 23574, "verse_number": "२१४-३२", "content_sanskrit": "तप्तकाञ्चनवर्णेन रत्नचित्रेण भास्वता ।\nविमानेनागतः शृङ्गे द्योतयन्वै धनाधिपः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003574032, "chapter_id": 23574, "verse_number": "२१४-३३", "content_sanskrit": "विमानशत कोटीभिरागतो यक्षराक्षसैः ।\nश्रीमद्भिर्बहुभिर्दिव्यैर्विमानैः सूर्यसन्निभैः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003574033, "chapter_id": 23574, "verse_number": "२१४-३४", "content_sanskrit": "अधिष्ठितः सुकृतिभिः प्रायाद्वैवस्वतोपमः ।\nचन्द्रादित्यौ ग्रहाः सर्वे समग्रं त्वृक्षमण्डलम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003574034, "chapter_id": 23574, "verse_number": "२१४-३५", "content_sanskrit": "विमानैरग्नितुल्याभैराजग्मुः खान्महीधरम् ।\nरुद्रास्त्वेकादशा याताः सूर्या द्वादश चैव तु ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003574035, "chapter_id": 23574, "verse_number": "२१४-३६", "content_sanskrit": "आगतावश्विनौ देवौ मौञ्जवन्तं महागिरिम् ।\nविश्वेदेवाश्च साध्याश्च गुरुश्च तपसान्वितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003574036, "chapter_id": 23574, "verse_number": "२१४-३७", "content_sanskrit": "संछाद्यैरावतपथं सहसाभ्याययुर्द्रुतम् ।\nस्कन्दश्चैव विशाखश्च भगवांश्च विनायकः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003574037, "chapter_id": 23574, "verse_number": "२१४-३८", "content_sanskrit": "संप्राप्तस्तं गिरिवरं मयूरशतनादितम् ।\nनारदस्तुम्बुरुश्चैव विश्वावसुपरावसू ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003574038, "chapter_id": 23574, "verse_number": "२१४-३९", "content_sanskrit": "हाहाहूहूस्तथा चान्ये सर्वे गन्धर्वसत्तमाः ।\nवैहायसैर्यानवरैर्विविधैर्वासवाज्ञया ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003574039, "chapter_id": 23574, "verse_number": "२१४-४०", "content_sanskrit": "अनिलश्चानलश्चैव धर्मः सत्यो ध्रुवोऽपरः ।\nदेवर्षयश्च सिद्धाश्च यक्षा विद्याधरास्तथा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003574040, "chapter_id": 23574, "verse_number": "२१४-४१", "content_sanskrit": "गुह्यकाश्च महात्मानः सर्व एव समागताः ।\nगन्धकाली घृताची च बुद्धा गौरी तिलोत्तमा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003574041, "chapter_id": 23574, "verse_number": "२१४-४२", "content_sanskrit": "उर्वशी मेनका रंभा पंचस्या च तथापरा ।\nएताश्चान्याश्च तच्छैलमाजग्मुर्देवयोषितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003574042, "chapter_id": 23574, "verse_number": "२१४-४३", "content_sanskrit": "पुलस्त्योऽत्रिर्मरीचिश्च वसिष्ठो भृगुरेव च ।\nकश्यपः पुलहश्चापि विश्वामित्रोऽथ गौतमः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003574043, "chapter_id": 23574, "verse_number": "२१४-४४", "content_sanskrit": "भारद्वाजोऽग्निवेश्यश्च तथा वृद्धपराशरः ।\nमार्कण्डेयोऽङ्गिरा गर्गः संवर्त्तः क्रतुरेव च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003574044, "chapter_id": 23574, "verse_number": "२१४-४५", "content_sanskrit": "मरीचिर्जमदग्निश्च भार्गवश्च्यवनस्तथा ।\nनियोगान्मम विष्णोश्च शक्रस्य त्रिदिवस्पतेः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003574045, "chapter_id": 23574, "verse_number": "२१४-४६", "content_sanskrit": "सिंधुश्च पुरुषश्चैव सरयूश्च महानदी ।\nताम्रारुणा चारुभागा वितस्ता कौशिकी तथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003574046, "chapter_id": 23574, "verse_number": "२१४-४७", "content_sanskrit": "पुण्या सरस्वती कोका नर्मदा बाहुदा तथा ।\nशतद्रूश्च विपाशा च गंडकी च सरिद्वरा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003574047, "chapter_id": 23574, "verse_number": "२१४-४८", "content_sanskrit": "गोदावरी च वेणी च तापी च सरिदुत्तमा ।\nकरतोया स शीता च तथा चीरवती नदी ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003574048, "chapter_id": 23574, "verse_number": "२१४-४९", "content_sanskrit": "नंदा च परनन्दा च तथा चर्मण्वती नदी ।\nपर्णाशा दैविका चैव वितस्ता च तथापरा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003574049, "chapter_id": 23574, "verse_number": "२१४-५०", "content_sanskrit": "सिंधुश्च पुरुषश्चैव प्रभासः सोम एव च ।\nलोहितश्चाययुस्तत्र गंगासागर एव च ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003574050, "chapter_id": 23574, "verse_number": "२१४-५१", "content_sanskrit": "अन्यानि चापि मेदिन्यां तीर्थान्यायतनानि च ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003574051, "chapter_id": 23574, "verse_number": "२१४-५२", "content_sanskrit": "निजस्वरूपेणाजग्मुस्तत्र पुण्यान्यनेकशः ।\nउपागतानि चेन्द्रस्य नियोगादुत्तमं गिरिम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003574052, "chapter_id": 23574, "verse_number": "२१४-५३", "content_sanskrit": "शैलोत्तमो महामेरुः कैलासो गन्धमादनः ।\nहिमवान्हेमकूटश्च निषधश्च महागिरिः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003574053, "chapter_id": 23574, "verse_number": "२१४-५४", "content_sanskrit": "विन्ध्यो महेन्द्रः सह्यश्च मलयो दर्दुरस्तथा ।\nमाल्यवांश्चित्रकूटश्च तथा द्रोणः शिलोच्चयः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003574054, "chapter_id": 23574, "verse_number": "२१४-५५", "content_sanskrit": "श्रीपर्वतो लतावेष्टः पारियात्रश्च शैलराट् ।\nआगताः सर्व एवैते शैलेन्द्राः काननौकसः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003574055, "chapter_id": 23574, "verse_number": "२१४-५६", "content_sanskrit": "सर्वे यज्ञाः सर्वविद्या वेदाश्चत्वार एव च ।\nधर्मः सत्यं दमः स्वर्गः कपिलश्च महानृषिः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003574056, "chapter_id": 23574, "verse_number": "२१४-५७", "content_sanskrit": "वासुकिश्च महाभागश्चामृताशी भुजङ्गराट्।\nज्वलत्फणासहस्रेण अनन्तश्च धराधरः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003574057, "chapter_id": 23574, "verse_number": "२१४-५८", "content_sanskrit": "फणींद्रो धृतराष्ट्रश्च किर्मीराङ्गश्च नागराट् ।\nअंभोधरश्च स श्रीमान्नागराजो महाद्युतिः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003574058, "chapter_id": 23574, "verse_number": "२१४-५९", "content_sanskrit": "अर्बुदो न्यर्बुदबलस्तथा चक्षुःश्रवाधिपः ।\nविद्युज्जिह्वो द्विजेह्वेंद्र शङ्खवर्च्चा महाद्युतिः ।५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003574059, "chapter_id": 23574, "verse_number": "२१४-६०", "content_sanskrit": "ख्यातस्त्रिभुवने धीमान्नहुषोऽनिमिषेश्वरः ।\nविरोचनसुतः सत्यः स्फुटोमणिशतैश्चितः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003574060, "chapter_id": 23574, "verse_number": "२१४-६१", "content_sanskrit": "फणाशतधरो रूपी भूरिशृङ्ग इवाचलः ।\nअरिमेजयसंयुक्तः प्रज्ञावान् भुजगेश्वरः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003574061, "chapter_id": 23574, "verse_number": "२१४-६२", "content_sanskrit": "विनतो नागराजश्च कम्बलाश्वतरौ तथा ।\nभुजगाधिपतिर्वीर एलापत्रस्तथैव च ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003574062, "chapter_id": 23574, "verse_number": "२१४-६३", "content_sanskrit": "उरगानामधिपती कर्कोटकधनञ्जयौ ।\nएवमाद्याः समायाता भुजगेन्द्रा महाबलाः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003574063, "chapter_id": 23574, "verse_number": "२१४-६४", "content_sanskrit": "अहोरात्र तथा पक्षा मासाः संवत्सरास्तथा ।\nद्यौर्मेदिनी दिशश्चैव विदिशश्च समागताः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003574064, "chapter_id": 23574, "verse_number": "२१४-६५", "content_sanskrit": "ततश्चैवागतैर्देवैर्यक्षैः सिद्धैश्च सर्वशः।\nअपूर्यत गिरेः शृङ्गे वेला काले यथोदधेः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003574065, "chapter_id": 23574, "verse_number": "२१४-६६", "content_sanskrit": "तस्मिन्देवसमाजे तु रम्ये शैलेन्द्रमूर्द्धनि ।\nपुष्पाणि मुमुचुस्तत्र तरवो ह्यनिलार्दिताः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003574066, "chapter_id": 23574, "verse_number": "२१४-६७", "content_sanskrit": "प्रगीता देवगन्धर्वाः प्रनृत्ताप्सरसां गणाः ।\nपक्षिणः संप्रहृष्टाश्च कूजन्ति मधुरं तदा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003574067, "chapter_id": 23574, "verse_number": "२१४-६८", "content_sanskrit": "पुण्यगन्धाः सुखस्पर्शास्तत्र वांति च वायवः ।\nएवमागत्य ते सर्वे देवा विष्णुपुरोगमाः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003574068, "chapter_id": 23574, "verse_number": "२१४-६९", "content_sanskrit": "श्रिया ज्वलन्तं ददृशुर्नन्दिनं पुरतः स्थितम् ।\nस च तानागतान्द्रष्ट्वा गन्धर्वाप्सरसां गणान् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003574069, "chapter_id": 23574, "verse_number": "२१४-७०", "content_sanskrit": "स हि तान्दैवराजेन सार्द्धमन्यैश्च दैवतैः ।\nमूर्ध्ना प्रणम्य चरणौ प्राञ्जलिः प्रयतात्मवान् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003574070, "chapter_id": 23574, "verse_number": "२१४-७१", "content_sanskrit": "सम्भ्रान्तः सहसा तेभ्यो नमस्कर्तुं प्रचक्रमे ।\nनमस्कृत्य च तान् सर्वान् स्वागतानभिभाष्य च ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003574071, "chapter_id": 23574, "verse_number": "२१४-७२", "content_sanskrit": "अर्घ्यपाद्यादिभिः शीघ्रमासनैश्च न्यमन्त्रयत् ।\nप्रणिधानेन तस्यार्थं श्रुत्वा तत्प्रतिपूजयेत् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003574072, "chapter_id": 23574, "verse_number": "२१४-७३", "content_sanskrit": "आदित्या वसवो रुद्रा मरुतश्चाश्विनावपि ।\nसाध्या विश्वे सगन्धर्वा गुह्यकाश्च प्रपूजयेत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003574073, "chapter_id": 23574, "verse_number": "२१४-७४", "content_sanskrit": "विश्वावसुर्हाहाहूहू तथा नारदतुम्बुरू ।\nचित्रसेनादयः सर्वे गन्धर्वास्तमपूजयन् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003574074, "chapter_id": 23574, "verse_number": "२१४-७५", "content_sanskrit": "तं वासुकिप्रभृतयः पन्नगेन्द्रा महौजसः ।\nसौम्यमभ्यर्च्चयन्ति स्म दृष्ट्वा नन्दीश्वरं तथा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003574075, "chapter_id": 23574, "verse_number": "२१४-७६", "content_sanskrit": "सिद्धचारणसङ्घाश्च विद्याश्चाप्सरसाङ्गणाः ।\nसत्कृतं देवदेवेन गणास्तमभिपूजयन् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003574076, "chapter_id": 23574, "verse_number": "२१४-७७", "content_sanskrit": "यक्षविद्याधराश्चैव ग्रहाः सागरपर्वताः ।\nसिद्धा ब्रह्मर्षयश्चैव गङ्गाद्याः सरितस्तथा ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003574077, "chapter_id": 23574, "verse_number": "२१४-७८", "content_sanskrit": "आशिषः प्रददुस्तस्य सर्व एव मुदान्विता ।\nदेवा ऊचुः ।\nस सुप्रीतोऽस्तु ते देवः सदा पशुपतिर्मुने ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003574078, "chapter_id": 23574, "verse_number": "२१४-७९", "content_sanskrit": "सर्वत्र चाप्रतिहता गतिश्चास्तु तवानघ ।\nभवान्देवैस्तु वा न स्यादत ऊर्ध्वं द्विजोत्तम ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003574079, "chapter_id": 23574, "verse_number": "२१४-८०", "content_sanskrit": "निरामयोऽमृतीभूतश्चरिष्यति विभुः सुखी ।\nलोकेषु सप्तसु विभो त्र्यम्बकेन सहाच्युत ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003574080, "chapter_id": 23574, "verse_number": "२१४-८१", "content_sanskrit": "इत्युक्तस्त्रिदशैर्नन्दी पुनस्तान्प्रत्युवाच ह ।\nनन्दिकेश्वर उवाच ।\nयद्भवद्भिः प्रियं सर्वैः प्रीतिमद्भिः सुरोत्तमैः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003574081, "chapter_id": 23574, "verse_number": "२१४-८२", "content_sanskrit": "आशिषाऽनुगृहीतोऽस्मि नियोज्योऽहं सदा हि वः ।\nब्रूत यूयं किमस्माभिः कर्त्तव्यं भवतामिह ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003574082, "chapter_id": 23574, "verse_number": "२१४-८३", "content_sanskrit": "आज्ञापयध्यमाज्ञप्तस्तस्माद्विबुधसत्तमाः ।\nतस्य तद्वचनं श्रुत्वा शक्रः प्रोवाच तं तदा ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003574083, "chapter_id": 23574, "verse_number": "२१४-८४", "content_sanskrit": "शक्र उवाच ।\nकुत्रासौ प्रस्थितो भद्र कुत्र वा स गतोऽपि वा ।\nपश्यामो विप्र तं सर्वे देवानामधिपं विभुम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003574084, "chapter_id": 23574, "verse_number": "२१४-८५", "content_sanskrit": "स्थाणुमुग्रं शिवं देवं शर्वमेव स्वयं मुने ।\nयदि जानासि भगवानीश्वरो यत्र तिष्ठति ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003574085, "chapter_id": 23574, "verse_number": "२१४-८६", "content_sanskrit": "तत्स्थानं नः समाख्याहि महर्षे शीघ्रमेव हि ।\nतच्छ्रुत्वा वचनं धीमदीरितं वज्रपाणिना ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003574086, "chapter_id": 23574, "verse_number": "२१४-८७", "content_sanskrit": "प्रत्युवाच ततः शक्रं नन्दी पशुपतिं स्मरन् ।\nनन्दिकेश्वर उवाच ।\nश्रोतुमर्हसि देवेन्द्र यथातत्त्वं दिवस्पते ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003574087, "chapter_id": 23574, "verse_number": "२१४-८८", "content_sanskrit": "अस्मिन्गिरौ मुञ्जवति स्थाणुरभ्यर्च्चतो मया ।\nप्रीतोऽसौ मां वरैर्दिव्यैरनुगृह्य हरः प्रभुः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003574088, "chapter_id": 23574, "verse_number": "२१४-८९", "content_sanskrit": "प्रीतो विनिर्गत इतस्तं विज्ञातुं बिभेम्यहम् ।\nयद्याज्ञापयसे देवं चाहं त्वच्छासने स्थितः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003574089, "chapter_id": 23574, "verse_number": "२१४-९०", "content_sanskrit": "मार्गयामो हि यत्नेन भगवन्तं तु वासव ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]