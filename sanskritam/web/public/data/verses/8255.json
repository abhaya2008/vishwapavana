[{"id": 900002153, "chapter_id": 8255, "verse_number": "12.1", "content_sanskrit": "यो ह वै ज्येष्ठं च श्रेष्ठं च वेद ज्येष्ठश्च श्रेष्ठश्च ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900002154, "chapter_id": 8255, "verse_number": "12.2", "content_sanskrit": "श्वेतकेतुर्ह वा आरुणेयः पञ्चालानां परिषदमाजगाम", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900002155, "chapter_id": 8255, "verse_number": "12.3", "content_sanskrit": "दृष्टादृष्टमहत्त्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900002156, "chapter_id": 8255, "verse_number": "12.4", "content_sanskrit": "नारायणो द्युशब्दोक्तः सर्वदा द्युतिहेतुतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900002157, "chapter_id": 8255, "verse_number": "12.5", "content_sanskrit": "तथाग्न्यादिरदनात्परमो भवेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900002158, "chapter_id": 8255, "verse_number": "12.6", "content_sanskrit": "नीचादयुत्तमा ज्ञानं शृणुयुर्लीलया क्वचित्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900002159, "chapter_id": 8255, "verse_number": "12.7", "content_sanskrit": "आदनादादित्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900002160, "chapter_id": 8255, "verse_number": "12.8", "content_sanskrit": "तदधीनं यतः सर्वं सर्वशब्दैस्ततो हरिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900002161, "chapter_id": 8255, "verse_number": "12.9", "content_sanskrit": "स यः कामयेत महत्प्राप्नुयामित्युदगयन आपूर्यमाणपक्षस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900002162, "chapter_id": 8255, "verse_number": "12.10", "content_sanskrit": "एषां वै भूतानां पृथिवी रसः पृथिव्या आपोऽपामोषधयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900002163, "chapter_id": 8255, "verse_number": "12.11", "content_sanskrit": "अथ वंशः पौतिमाषीपुत्रः कात्यायनीपुत्रात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900002164, "chapter_id": 8255, "verse_number": "12.12", "content_sanskrit": "पञ्चाग्निविद्यया चैव तथैव प्राणविद्यया", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900002165, "chapter_id": 8255, "verse_number": "12.13", "content_sanskrit": "नित्यानन्दमनौपमं परमजं सर्वत्रगं सुस्थिरं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900002166, "chapter_id": 8255, "verse_number": "12.14", "content_sanskrit": "यस्य त्रीण्युदितानि वेदवचने रूपाणि दिव्यान्यलं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900002167, "chapter_id": 8255, "verse_number": "12.15", "content_sanskrit": "हनुशब्दो ज्ञानवाची हनुमान्मतिशब्दितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900002168, "chapter_id": 8255, "verse_number": "12.16", "content_sanskrit": "ऋगाद्या इतिहासश्च पुराणं पञ्चरात्रकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900002169, "chapter_id": 8255, "verse_number": "12.17", "content_sanskrit": "दशेति सर्वमुद्दिष्टं सर्वं पूर्णमिहोच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900002170, "chapter_id": 8255, "verse_number": "12.18", "content_sanskrit": "त्रेतायां द्वापरे चैव कलौ चैते क्रमात्त्रयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900002171, "chapter_id": 8255, "verse_number": "12.19", "content_sanskrit": "पूर्णागण्यगुणोदारधाम्ने नित्याय वेधसे । अमन्दानन्दसान्द्राय प्रेयसे विष्णवे नमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]