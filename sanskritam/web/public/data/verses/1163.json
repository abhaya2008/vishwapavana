[{"id": 2008417, "chapter_id": 1163, "verse_number": "१-१६४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008418, "chapter_id": 1163, "verse_number": "१-१६४-१", "content_sanskrit": "तत्र तेषु शयानेषु हिडिम्बो नाम राक्षसः।\nअविदूरे वनात्तस्माच्छालवृक्षं समाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008419, "chapter_id": 1163, "verse_number": "१-१६४-२", "content_sanskrit": "क्रूरो मानुषमांसादो महावीर्यपराक्रमः।\nप्रावृड्जलधरश्यामः पिङ्गाक्षो दारुणाकृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008420, "chapter_id": 1163, "verse_number": "१-१६४-३", "content_sanskrit": "दष्ट्राकरालवदनः करालो भीमदर्शनः।\nलम्बस्फिग्लम्बजठरो रक्तश्मश्रुशिरोरुहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008421, "chapter_id": 1163, "verse_number": "१-१६४-४", "content_sanskrit": "महावृक्षगलस्कन्धः शङ्कर्णो विभीषणः।\nयदृच्छया तानपश्यत्पाण्डुपुत्रान्महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008422, "chapter_id": 1163, "verse_number": "१-१६४-५", "content_sanskrit": "विरूपरूपः पिङ्गाक्षः करालो घोरदर्शनः।\nपिशितेप्सुः क्षुधार्तश्च जिघ्रन्गन्धं यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008423, "chapter_id": 1163, "verse_number": "१-१६४-६", "content_sanskrit": "ऊर्ध्वाङ्गुलिः स कण्डूयन्धुन्वन्रूक्षाञ्शिरोरुहान्।\nजृम्भमाणो महावक्त्रः पुनःपुनरवेक्ष्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008424, "chapter_id": 1163, "verse_number": "१-१६४-७", "content_sanskrit": "हृष्टो मानुषमांसस्य महाकायो महाबलः।\nआघ्राय मानुषं गन्धं भगिनीमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008425, "chapter_id": 1163, "verse_number": "१-१६४-८", "content_sanskrit": "उपपन्नं चिरस्याद्य भक्ष्यं मम मनःप्रियम्।\nजिघ्रतः प्रस्रुता स्नेहाज्जिह्वा पर्येति मे मुखात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008426, "chapter_id": 1163, "verse_number": "१-१६४-९", "content_sanskrit": "अष्टौ दंष्ट्राः सुतीक्ष्णाग्राश्चिरस्यापातदुःसहाः।\nदेहेषु मज्जयिष्यामि स्निग्धेषु पिशितेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008427, "chapter_id": 1163, "verse_number": "१-१६४-१०", "content_sanskrit": "आक्रम्य मानुषं कण्ठमाच्छिद्य धमनीमपि।\nउष्णं नवं प्रपास्यामि फेनलिं रुधिरं बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008428, "chapter_id": 1163, "verse_number": "१-१६४-११", "content_sanskrit": "गच्छ जानीहि के त्वेते शेरते वनमाश्रिताः।\nमानुषो बलवान्गन्धो घ्राणं तर्पयतीव मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008429, "chapter_id": 1163, "verse_number": "१-१६४-१२", "content_sanskrit": "हत्वैतान्मानुषान्सर्वानानयस्व ममान्तिकम्।\nअस्मद्विषयसुप्तेभ्यो नैतेभ्यो भयमस्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008430, "chapter_id": 1163, "verse_number": "१-१६४-१३", "content_sanskrit": "एषामुत्कृत्य मांसानि मानुषाणां यथेष्टतः।\nभक्षयिष्याव सहितौ कुरु पूर्णं वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008431, "chapter_id": 1163, "verse_number": "१-१६४-१४", "content_sanskrit": "भक्षयित्वा च मांसानि मानुषाणां प्रकामतः।\nनृत्याव सहितावावां दत्ततालावनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008432, "chapter_id": 1163, "verse_number": "१-१६४-१५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008433, "chapter_id": 1163, "verse_number": "१-१६४-१५", "content_sanskrit": "एवमुक्ता हिडिम्बा तु हिडिम्बेन महावने।\nभ्रातुर्वचनमाज्ञाय त्वरमाणेव राक्षसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008434, "chapter_id": 1163, "verse_number": "१-१६४-१६", "content_sanskrit": "आप्लुत्याप्लुत्य च तरूनगच्छत्पाण्डवान्प्रति।\nजगाम तत्र यत्र स्म शेरते पाण्डवा वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008435, "chapter_id": 1163, "verse_number": "१-१६४-१७", "content_sanskrit": "ददर्श तत्र सा गत्वा पाण्डवान्पृथया सह।\nशयानान्भीमसेनं च जाग्रतं त्वपराजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008436, "chapter_id": 1163, "verse_number": "१-१६४-१८", "content_sanskrit": "उपास्यमानान्भीमेन रूपयौवनशालिनः।\nसुकुमारांश्च पार्थान्सा व्यायामेन च कर्शितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008437, "chapter_id": 1163, "verse_number": "१-१६४-१९", "content_sanskrit": "दुःखेन संप्रयुक्तांश्च सहज्येष्ठान्प्रमाथिनः।\nरौद्री सती राजपुत्रं दर्शनीयप्रदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008438, "chapter_id": 1163, "verse_number": "१-१६४-२०", "content_sanskrit": "दृष्ट्वैव भीमसेनं सा सालस्कन्धमिवोद्यतम्।\nराक्षसी कामयामास रूपेणाप्रतिमं भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008439, "chapter_id": 1163, "verse_number": "१-१६४-२१", "content_sanskrit": "अन्तर्गतेन मनसा चिन्तयामास राक्षसी।\nअयं श्यामो महाबाहुः सिंहस्कन्धो महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008440, "chapter_id": 1163, "verse_number": "१-१६४-२२", "content_sanskrit": "कम्बुग्रीवः पुष्कराक्षो भर्ता युक्तो भवेन्मम।\nनाहं भ्रातृवचो जातु कुर्यां क्रूरमसांप्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008441, "chapter_id": 1163, "verse_number": "१-१६४-२३", "content_sanskrit": "पतिस्नेहोऽतिबलवान्न तथा भ्रातृसौहृदम्।\nमुहूर्तमिव तृप्तिश्च भवेद्धातुर्ममैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2008442, "chapter_id": 1163, "verse_number": "१-१६४-२४", "content_sanskrit": "हतैरेतैरहत्वा तु मोदिष्ये शाश्वतीः समाः।\nनिश्चित्येत्थं हिडिम्बा सा भीमं दृष्ट्वा महाभुजं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2008443, "chapter_id": 1163, "verse_number": "१-१६४-२५", "content_sanskrit": "उत्सृज्य राक्षसं रूपं मानुषं रूपमास्थिता।\nसा कामरूपिणी रूपं कृत्वा मदनमोहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2008444, "chapter_id": 1163, "verse_number": "१-१६४-२६", "content_sanskrit": "उपतस्थे महात्मानं भीमसेनमनिन्दिता।\nइङ्गिताकारकुशला सोपासर्पच्छनैः शनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2008445, "chapter_id": 1163, "verse_number": "१-१६४-२७", "content_sanskrit": "विनम्यमानेव लता दिव्याभरणभूषिता।\nशनैः शनैश्च तां भीमः समीपमुपसर्पतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2008446, "chapter_id": 1163, "verse_number": "१-१६४-२८", "content_sanskrit": "हर्षमाणां तदा पश्यत्तन्वीं पीनपयोधराम्।\nचन्द्राननां पद्मनेत्रां नीलकुञ्चितमूर्धजाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2008447, "chapter_id": 1163, "verse_number": "१-१६४-२९", "content_sanskrit": "कृष्णां सुपाण्डुरैर्दन्तैर्बिम्बोष्ठीं चारुदर्शनाम्।\nदृष्ट्वा तां रूपसंपन्नां भीमो विस्मयमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2008448, "chapter_id": 1163, "verse_number": "१-१६४-३०", "content_sanskrit": "उपचारगुणैर्युक्तां ललितैर्हाससंमितैः।\nसमीपमुपसंप्राप्य भीमं साथ वरानता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2008449, "chapter_id": 1163, "verse_number": "१-१६४-३१", "content_sanskrit": "वचो वचनवेलायां भीमं प्रोवाच भामिनी।\nलज्जया नम्यमानेव सर्वाभरणभूषिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2008450, "chapter_id": 1163, "verse_number": "१-१६४-३२", "content_sanskrit": "स्मितपूर्वमिदं वाक्यं भीमसेनमथाब्रवीत्।\nकुतस्त्वमसि संप्राप्तः कश्चासि पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2008451, "chapter_id": 1163, "verse_number": "१-१६४-३३", "content_sanskrit": "क इमे शेरते चेह पुरुषा देवरूपिणः।\nकेयं वै बृहती श्यामा सुकुमारी तवानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2008452, "chapter_id": 1163, "verse_number": "१-१६४-३४", "content_sanskrit": "शेते वनमिदं प्राप्य विश्वस्ता स्वगृहे यथा।\nनेदं जानीथ गहनं वनं राक्षससेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2008453, "chapter_id": 1163, "verse_number": "१-१६४-३५", "content_sanskrit": "वसति ह्यत्र पापात्मा हिडिम्बो नाम राक्षसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2008454, "chapter_id": 1163, "verse_number": "१-१६४-३६", "content_sanskrit": "तेनाहं प्रेषिता भ्रात्रा दुष्टभावेन रक्षसा।\nबिभक्षयिषता मांसं युष्माकममरोपमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2008455, "chapter_id": 1163, "verse_number": "१-१६४-३७", "content_sanskrit": "साऽहं त्वमभिसंप्रेक्ष्य देवगर्भसमप्रभम्।\nनान्यं भर्तारमिच्छामि सत्यमेतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2008456, "chapter_id": 1163, "verse_number": "१-१६४-३८", "content_sanskrit": "एतद्विज्ञाय धर्मज्ञ युक्तं मयि समाचर।\nकामोपहतचित्तां हि भजमानां भजस्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2008457, "chapter_id": 1163, "verse_number": "१-१६४-३९", "content_sanskrit": "त्रास्यामि त्वां महाबाहो राक्षसात्पुरुषादकात्।\nवत्स्यावो गिरिदुर्गेषु भर्ता भव ममानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2008458, "chapter_id": 1163, "verse_number": "१-१६४-४०", "content_sanskrit": "इच्छामि वीर भद्रं ते मा मे प्राणान्विहासिषः।\nत्वया ह्यहं परित्यक्ता न जीवेयमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2008459, "chapter_id": 1163, "verse_number": "१-१६४-४१", "content_sanskrit": "अन्तरिक्षचरी ह्यस्मि कामतो विचरामि च।\nअतुलामाप्नुहि प्रीतिं तत्र तत्र मया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2008460, "chapter_id": 1163, "verse_number": "१-१६४-४२x", "content_sanskrit": "भीमसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2008461, "chapter_id": 1163, "verse_number": "१-१६४-४२", "content_sanskrit": "एष ज्येष्ठो मम भ्राता मान्यः परमको गुरुः।\nअनिविष्टो हि तन्नाहं परिविद्यां कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2008462, "chapter_id": 1163, "verse_number": "१-१६४-४३", "content_sanskrit": "मातरं भ्रातरं ज्येष्ठं कनिष्ठानपरानपि।\nपरित्यजेत कोन्वद्य प्रभवन्निह राक्षसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2008463, "chapter_id": 1163, "verse_number": "१-१६४-४४", "content_sanskrit": "को हि सुप्तानिमान्भ्रातॄन्दत्त्वा राक्षसभोजनम्।\nमातरं च नरो गच्छेत्कामार्त इव मद्विधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2008464, "chapter_id": 1163, "verse_number": "१-१६४-४५x", "content_sanskrit": "राक्षस्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2008465, "chapter_id": 1163, "verse_number": "१-१६४-४५", "content_sanskrit": "एकं त्वां मोक्षयिष्यामि सह मात्रा परन्तप।\nसोदरानुत्सृजैनांस्त्वमारोह जघनं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2008466, "chapter_id": 1163, "verse_number": "१-१६४-४६x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2008467, "chapter_id": 1163, "verse_number": "१-१६४-४६", "content_sanskrit": "नाहं जीवितुमाशंसे भ्रातॄनुत्सृज्य राक्षसि।\nयथाश्रद्धं व्रजैका हि विप्रियं मे प्रभाषसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2008468, "chapter_id": 1163, "verse_number": "१-१६४-४७x", "content_sanskrit": "राक्षस्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2008469, "chapter_id": 1163, "verse_number": "१-१६४-४७", "content_sanskrit": "यत्ते प्रियं तत्करिष्ये सर्वानेतान्प्रबोधय।\nमोक्षयिष्याम्यहं कामं राक्षसात्पुरुषादकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2008470, "chapter_id": 1163, "verse_number": "१-१६४-४८x", "content_sanskrit": "भीमसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2008471, "chapter_id": 1163, "verse_number": "१-१६४-४८", "content_sanskrit": "सुखसुप्तान्वने भ्रातॄन्मातरं चैव राक्षसि।\nन भयाद्बोधयिष्यामि भ्रातुस्तव दुरात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2008472, "chapter_id": 1163, "verse_number": "१-१६४-४९", "content_sanskrit": "न हि मे राक्षसा भीरु सोढुं शक्ताः पराक्रमम्।\nन मनुष्या न गन्धर्वा न यक्षाश्चारुलोचने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2008473, "chapter_id": 1163, "verse_number": "१-१६४-५०", "content_sanskrit": "गच्छ वा तिष्ठ वा भद्रे यद्वा पीच्छसि तत्कुरु।\nतं वा प्रेषय तन्वङ्गि भ्रातरं पुरुषादकम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2008474, "chapter_id": 1163, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि हिडिम्बवधपर्वणि चतुःषष्ट्यधिकशततमोऽध्यायः॥ १६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]