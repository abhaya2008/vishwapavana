[{"id": 2022955, "chapter_id": 1489, "verse_number": "३-१२७-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022956, "chapter_id": 1489, "verse_number": "३-१२७-१", "content_sanskrit": "मान्धाता राजशार्दूलस्त्रिषु लोकेषु विश्रुतः।\nकथं जातो महाब्रह्मन्यौवनाश्वो नृपोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022957, "chapter_id": 1489, "verse_number": "३-१२७-२", "content_sanskrit": "कथं चैनां परां ख्यातिं प्राप्तवानमितद्युतिः।\nयस्य लोकास्त्रयो वश्या विष्णोरिव महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022958, "chapter_id": 1489, "verse_number": "३-१२७-३", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं चरितं तस्य धीमतः।\n`सत्यकीर्तेर्हि मान्धातुः कथ्यमानं त्वयाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022959, "chapter_id": 1489, "verse_number": "३-१२७-४", "content_sanskrit": "यथा मान्धातृशब्दश्च तस्य शक्रसमद्युते।\nजन्म चाप्रतिवीर्यस् कुशलो ह्यसि भाषितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022960, "chapter_id": 1489, "verse_number": "३-१२७-५x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022961, "chapter_id": 1489, "verse_number": "३-१२७-५", "content_sanskrit": "शृणुष्वावहितो राजन्राज्ञस्तस्य महात्मनः।\nयथा मान्धातृशब्दो वै लोकेषु परिगीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022962, "chapter_id": 1489, "verse_number": "३-१२७-६", "content_sanskrit": "इक्ष्वाकुवंशप्रभवो युवनाश्वो महीपतिः।\nसोऽयजत्पृथिवीपालः क्रतुभिर्भूरिदक्षिणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022963, "chapter_id": 1489, "verse_number": "३-१२७-७", "content_sanskrit": "अश्वमेधसहस्रं च प्राप्य धर्मभृतांवरः।\nअन्यैश्च क्रतुभिर्मुख्यैरयजत्स्वाप्तदक्षिणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022964, "chapter_id": 1489, "verse_number": "३-१२७-८", "content_sanskrit": "अनपत्यस्तु राजर्षिः स महात्मा महाव्रतः।\nमन्त्रिष्वाधाय तद्राज्यं वनित्यो बभूव ह।\nशास्त्रदृष्टेन विधिना संयोज्यात्मानमात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022965, "chapter_id": 1489, "verse_number": "३-१२७-९", "content_sanskrit": "स कदाचिन्नृपो राजन्नुपवासेन दुःखितः।\nपिपासाशुष्कहृदयः प्रविवेशाश्रमं भृगोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022966, "chapter_id": 1489, "verse_number": "३-१२७-१०", "content_sanskrit": "तामेव रात्रिं राजेन्द्र महात्मा भृगुनन्दनः।\nइष्टिं चकार सौद्युम्नेर्महर्षिः पुत्रकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022967, "chapter_id": 1489, "verse_number": "३-१२७-११", "content_sanskrit": "संभृतो मन्त्रपूतेन वारिणा कलशो महान्।\nतत्रातिष्ठत राजेन्द्र पूर्वमेव समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022968, "chapter_id": 1489, "verse_number": "३-१२७-१२", "content_sanskrit": "यत्प्राश्य प्रसवेत्तस्य पत्नी शक्रसमं सुतम्।\n`तद्वारि विहितं राजन्यस्मिन्नासीत्सुसंस्कृतम्।\nतं न्यस्य वेद्यां कलशं सुषुपुस्ते महर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022969, "chapter_id": 1489, "verse_number": "३-१२७-१३", "content_sanskrit": "रात्रिजागरणाच्छ्रान्तान्सौद्युम्निः समतीत्य तान्।\nशुष्ककण्ठः पिपासार्तः पानीयार्थी भृशं नृपः।\nतं प्रविश्याश्रमं शान्तः पानीयं सोऽभ्ययाचत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022970, "chapter_id": 1489, "verse_number": "३-१२७-१४", "content_sanskrit": "तस्य श्रान्तस्य शुष्केण कण्ठेन क्रोशतस्तदा।\nनाश्रौषीत्कश्चन तदा शकुनेरिव वाशतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022971, "chapter_id": 1489, "verse_number": "३-१२७-१५", "content_sanskrit": "ततस्तं कलशं दृष्ट्वा जलपूर्णं स पार्थिवः।\nअभ्यद्रवत वेगेन पीत्वा चाम्भो व्यवासृजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022972, "chapter_id": 1489, "verse_number": "३-१२७-१६", "content_sanskrit": "स पीत्वा शीतलं तोयं पिपासार्तो महीपतिः।\nनिर्वाणमगमद्धीमान्सुसुखी चाभवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022973, "chapter_id": 1489, "verse_number": "३-१२७-१७", "content_sanskrit": "ततस्ते प्रत्यबुध्यन्त मुनयः सतपोधनाः।\nनिस्तोयं तं च कलशं ददृशुः सर्व एव ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022974, "chapter_id": 1489, "verse_number": "३-१२७-१८", "content_sanskrit": "कस्य कर्मेदमिति ते पर्यपृच्छन्समागताः।\nयुवनाश्वो ममेत्येवं सत्यं समभिपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022975, "chapter_id": 1489, "verse_number": "३-१२७-१९", "content_sanskrit": "न युक्तमिति तं प्राह भगवान्भार्गवस्तदा।\nसुतार्थं स्थापिता ह्यापस्तपसा चैव संभृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022976, "chapter_id": 1489, "verse_number": "३-१२७-२०", "content_sanskrit": "मया ह्यत्राहितं ब्रह्म तप आस्थाय दारुणम्।\nपुत्रार्थं तव राजर्षे महाबलपराक्रम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022977, "chapter_id": 1489, "verse_number": "३-१२७-२१", "content_sanskrit": "महाबलो महावीर्यस्तपोबलसमन्वितः।\nयः शक्रमपि वीर्येण गमयेद्यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022978, "chapter_id": 1489, "verse_number": "३-१२७-२२", "content_sanskrit": "अनेन विधिना राजन्मयैतदुपपादितम्।\nअब्भक्षणं त्वया राजन्न युक्तं कृतमद्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022979, "chapter_id": 1489, "verse_number": "३-१२७-२३", "content_sanskrit": "न त्वद्य शक्यमस्माभिरेतत्कर्तुमतोऽनय्था।\nनूनं दैवकृतं ह्येतद्यदेवं कृतवानसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022980, "chapter_id": 1489, "verse_number": "३-१२७-२४", "content_sanskrit": "पिपासितेन याः पीता विधिमन्त्रपुरस्कृताः।\nआपस्त्वया महाराज मत्तपोवीर्यसंभृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022981, "chapter_id": 1489, "verse_number": "३-१२७-२५", "content_sanskrit": "ताभ्यस्त्वमात्मना पुत्रमीदृशं जनयिष्यसि।\nविधास्यामो वयं तत्र तवेष्टिं परमाद्भुताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022982, "chapter_id": 1489, "verse_number": "३-१२७-२६", "content_sanskrit": "यथा शक्रसमं पुत्रं जनयिष्यसि वीर्यवान्।\n`न च प्राणैर्महाराज वियोगस्ते भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2022983, "chapter_id": 1489, "verse_number": "३-१२७-२७", "content_sanskrit": "मा खिदस्त्वं हि राजेनद्र दैवं हि बलवत्तरम्।\nगर्भधारणजं वाऽपि न खेदं समवाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2022984, "chapter_id": 1489, "verse_number": "३-१२७-२८", "content_sanskrit": "ततो वर्षशते पूर्णे तस्य राज्ञो महात्मनः।\nवामं पार्श्वं विनिर्भिद्य सुतः सूर्य इव स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2022985, "chapter_id": 1489, "verse_number": "३-१२७-२९", "content_sanskrit": "निश्चक्राम महातेजा न च तं मृत्युराविशत्।\nयुवनाश्वं नरपतिं तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2022986, "chapter_id": 1489, "verse_number": "३-१२७-३०", "content_sanskrit": "ततः शक्रो महातेजास्तं दिदृक्षुरुपागमत्।\nततो देवा महेन्द्रं तमपृच्छन्धास्यतीति किम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2022987, "chapter_id": 1489, "verse_number": "३-१२७-३१", "content_sanskrit": "प्रदेशिनीं ततोऽस्यास्ये शक्रः समभिसंदधे।\nमामयं धास्यतीत्येवं भाषिते चैव वज्रिणा।\nमांधातेति च नामास्य चक्रुः सेन्द्रा दिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2022988, "chapter_id": 1489, "verse_number": "३-१२७-३२", "content_sanskrit": "प्रदेशिनीं शक्रदत्तामाखाद्य स शिशुस्तदा।\nअवर्धत महातेजाः किष्कून्राजंस्त्र्योदश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2022989, "chapter_id": 1489, "verse_number": "३-१२७-३३", "content_sanskrit": "वेदास्तं सधनुर्वेदा दिव्यान्स्त्राणि चेश्वरम्।\nउपतस्थुर्महाराजं ध्यातमात्राणि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2022990, "chapter_id": 1489, "verse_number": "३-१२७-३४", "content_sanskrit": "धनुराजगवं नाम शराः शृङ्गोद्भवाश्च ये।\nअभेद्यं कवचं चैव सद्यस्तमुपशिश्रियुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2022991, "chapter_id": 1489, "verse_number": "३-१२७-३५", "content_sanskrit": "सोऽभिषिक्तो भगवता स्वयं शक्रेण भारत।\nधर्मेण व्यजयल्लोकांस्त्रीन्विष्णुरिव विक्रमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2022992, "chapter_id": 1489, "verse_number": "३-१२७-३६", "content_sanskrit": "तस्याप्रतिहतं चक्रं प्रावर्तत महात्मनः।\nरत्नानि चैव राजर्षिं स्वयमेवोपतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2022993, "chapter_id": 1489, "verse_number": "३-१२७-३७", "content_sanskrit": "तस्येयं वसुसंपूर्णा वसुधा वसुधाधिप।\nतेनेष्टं विविधैर्यज्ञैर्बहुभिः स्वाप्तदक्षिणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2022994, "chapter_id": 1489, "verse_number": "३-१२७-३८", "content_sanskrit": "चितचैत्यो महातेजा धर्मान्प्राप्य च पुष्कलान्।\nशक्रस्यार्धासनं राजँल्लब्धवानमितद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2022995, "chapter_id": 1489, "verse_number": "३-१२७-३९", "content_sanskrit": "एकाह्ना पृथिवी तेन धर्मनित्येन धीमता।\nविजिता शासनादेव सरत्नाकरपत्तना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2022996, "chapter_id": 1489, "verse_number": "३-१२७-४०", "content_sanskrit": "तस्य चैत्यैर्महाराज क्रतूनां दक्षिणावताम्।\nचतुरन्ता मही व्याप्ता नासीत्किंचिदनावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2022997, "chapter_id": 1489, "verse_number": "३-१२७-४१", "content_sanskrit": "तेन पद्मसहस्राणि गवां दश महात्मना।\nब्राह्मणेभ्यो महाराज दत्तानीति प्रचक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2022998, "chapter_id": 1489, "verse_number": "३-१२७-४२", "content_sanskrit": "तेन द्वादशवार्षिक्यामनावृष्ट्यां महात्मना।\nवृष्टं सस्यविवृद्ध्यर्थं मिषतो वज्रपाणिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2022999, "chapter_id": 1489, "verse_number": "३-१२७-४३", "content_sanskrit": "तेन सोमकुलोत्पन्नो गान्धाराधिपतिर्महान्।\nशर्जन्निव महामेघः प्रमथ्य निहतः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2023000, "chapter_id": 1489, "verse_number": "३-१२७-४४", "content_sanskrit": "प्रजाश्चतुर्विधास्तेन त्राता राजन्कृतात्मना।\nतेनात्मतपसा लोकास्तापिताश्चातितेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2023001, "chapter_id": 1489, "verse_number": "३-१२७-४५", "content_sanskrit": "तस्यैतद्देवयजनं स्थानमादित्यवर्चसः।\nयस्य पुण्यतमे देशे कुरुक्षेत्रेस्य मध्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2023002, "chapter_id": 1489, "verse_number": "३-१२७-४६", "content_sanskrit": "`तथा त्वमपि राजेन्द्र मान्धातेव महीपतिः।\nधर्मं कृत्वा महीं रक्ष स्वर्गलोकं गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2023003, "chapter_id": 1489, "verse_number": "३-१२७-४७", "content_sanskrit": "एतत्ते सर्वमाख्यातं मान्धातुश्चरितं महत्।\nजन्म चाग्र्यं महीपाल यन्मां त्वं परिपृच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2023004, "chapter_id": 1489, "verse_number": "३-१२७-४८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2023005, "chapter_id": 1489, "verse_number": "३-१२७-४८", "content_sanskrit": "एवमुक्तः स कौन्तेयो लोमशेन महर्षिणा।\nपप्रच्छानन्तरं भूयः सोमकं प्रति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2023006, "chapter_id": 1489, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि सप्तविंशत्यधिकशततमोऽध्यायः ॥ १२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]