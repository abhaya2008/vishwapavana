[{"id": 7006251000, "chapter_id": 26251, "verse_number": "३-५-१", "content_sanskrit": "श्रीगणेशाय नमः ।\nअथ श्रीललितोपाख्यानं प्रारभ्यते ।\nचतुर्भुजे चन्द्रकलावतंसे कुचोन्नते कुङ्कुमरागशोणे ।\nपुण्ड्रेक्षुपाशाङ्कुशपुष्पबाणहस्ते नमस्ते जगदेकमातः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006251001, "chapter_id": 26251, "verse_number": "३-५-२", "content_sanskrit": "अस्तु नः श्रेयसे नित्यं वस्तु वामाङ्गसुन्दरम् ।\nयतस्तृतीयो विदुषां तृतीयस्तु परं महः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006251002, "chapter_id": 26251, "verse_number": "३-५-३", "content_sanskrit": "अगस्त्यो नाम देवर्षिर्वेदवेदाङ्गपारगः ।\nसर्वसिद्धान्तसारज्ञो ब्रह्मानन्दरसात्मकः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006251003, "chapter_id": 26251, "verse_number": "३-५-४", "content_sanskrit": "चचाराद्भुतहेतूनि तीर्थान्यायतनानि च ।\nशैलारण्यापगामुख्यान्सर्वाञ्जनपदानपि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006251004, "chapter_id": 26251, "verse_number": "३-५-५", "content_sanskrit": "तेषु तेष्वखिलाञ्जन्तूनज्ञानतिमिरावृतान् ।\nशिश्नोदरपरान्दृष्ट्वा चिन्तयामास तान्प्रति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006251005, "chapter_id": 26251, "verse_number": "३-५-६", "content_sanskrit": "तस्य चिन्तयमानस्य चरतो वसुधामिमाम् ।\nप्राप्तमासीन्महापुण्यं काञ्चीनगरमुत्तमम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006251006, "chapter_id": 26251, "verse_number": "३-५-७", "content_sanskrit": "तत्र वारणशैलेनद्रमेकाम्रनिलयं शिवम् ।\nकामाक्षीं करिदोषध्नीमपूजयदथात्मवान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006251007, "chapter_id": 26251, "verse_number": "३-५-८", "content_sanskrit": "लोकहेतोर्दयार्द्रस्य धीमतश्चिन्तनो मुहुः ।\nचिरकालेन तपसा तोषितोऽभूज्जनार्दनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006251008, "chapter_id": 26251, "verse_number": "३-५-९", "content_sanskrit": "हयग्रीवां तनुं कृत्वा साक्षाच्चिन्मात्रविग्रहाम् ।\nशङ्खचक्राक्षवलयपुस्तकोज्ज्वलबाहुकाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006251009, "chapter_id": 26251, "verse_number": "३-५-१०", "content_sanskrit": "पूरयित्रीं जगत्कृत्स्नं प्रभया देहजातया ।\nप्रादुर्बभूव पुरतो मुनेरमिततेजसा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006251010, "chapter_id": 26251, "verse_number": "३-५-११", "content_sanskrit": "तं दृष्ट्वानन्दभरितः प्रणम्य च मुहुर्मुहुः ।\nविनयावनतो भूत्वा सन्तुष्टाव जगत्पतिम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006251011, "chapter_id": 26251, "verse_number": "३-५-१२", "content_sanskrit": "अथोवाच जगन्नाथस्तुष्टोऽस्मि तपसा तव ।\nवरं वरय भद्रं ते भविता भूसुरोत्तमः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006251012, "chapter_id": 26251, "verse_number": "३-५-१३", "content_sanskrit": "इति पृष्टो भगवता प्रोवाच मुनिसत्तमः ।\nयदि तुष्टोऽसि भगवन्निमे पामरजन्तवः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006251013, "chapter_id": 26251, "verse_number": "३-५-१४", "content_sanskrit": "केनोपायेन मुक्ताः स्युरेतन्मे वक्तुमर्हसि ।\nइति पृष्टो द्विजेनाथ देवदेवो जनार्दनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006251014, "chapter_id": 26251, "verse_number": "३-५-१५", "content_sanskrit": "एष एव पुरा प्रश्नः शिवेन चरितो मम ।\nअयमेव कृतः प्रश्नो ब्रह्मणा तु ततः परम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006251015, "chapter_id": 26251, "verse_number": "३-५-१६", "content_sanskrit": "कृतो दुर्वाससा पश्चाद्भवता तु ततः परम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006251016, "chapter_id": 26251, "verse_number": "३-५-१७", "content_sanskrit": "भवद्भिः सर्वभूतानां गुरुभूतैर्महात्मभिः ।\nममोपदेशो लोकेषु प्रथितोऽस्तु वरो मम ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006251017, "chapter_id": 26251, "verse_number": "३-५-१८", "content_sanskrit": "अहमादिर्हि भूतानामादिकर्ता स्वयं प्रभुः ।\nसृष्टिस्थितिलयानां तु सर्वेषामपि कारकः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006251018, "chapter_id": 26251, "verse_number": "३-५-१९", "content_sanskrit": "त्रिमूर्तिस्त्रिगुणातीतो गुणहीनो गुणाश्रयः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006251019, "chapter_id": 26251, "verse_number": "३-५-२०", "content_sanskrit": "इच्छाविहारो भूतात्मा प्रधानपुरुषात्मकः ।\nएवं भूतस्य मे ब्रह्मंस्त्रिजगद्रूपधारिणः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006251020, "chapter_id": 26251, "verse_number": "३-५-२१", "content_sanskrit": "द्विधाकृतमभूद्रूपं प्रधान पुरुषात्मकम् ।\nमम प्रधानं यद्रूपं सर्वलोकगुणात्मकम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006251021, "chapter_id": 26251, "verse_number": "३-५-२२", "content_sanskrit": "अपरं यद्गुणातीतं परात्परतरं महत् ।\nएवमेव तयोर्ज्ञात्वा मुच्यते ते उभे किमु ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006251022, "chapter_id": 26251, "verse_number": "३-५-२३", "content_sanskrit": "तपोभिश्चिरकालोत्थैर्यमैश्च नियमैरपि ।\nत्यागैर्दुष्कर्मनाशान्ते मुक्तिराश्वेव लभ्यते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006251023, "chapter_id": 26251, "verse_number": "३-५-२४", "content_sanskrit": "यद्रूपं यद्गुणयुतं तद्गुण्यैक्येन लभ्यते ।\nअन्यत्सर्वजगद्रूपं कर्मभोगपराक्रमम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006251024, "chapter_id": 26251, "verse_number": "३-५-२५", "content_sanskrit": "कर्मभिर्लभ्यते तच्च तत्त्यागेनापि लभ्यते ।\nदुस्तरस्तु तयोस्त्यागः सकलैरपि तापस ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006251025, "chapter_id": 26251, "verse_number": "३-५-२६", "content_sanskrit": "अनपायं च सुगमं सदसत्कर्मगोचरम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006251026, "chapter_id": 26251, "verse_number": "३-५-२७", "content_sanskrit": "आत्मस्थेन गुणेनैव सता चाप्यसतापिवा ।\nआत्मैक्येनैव यज्ज्ञानं सर्वसिद्धिग्रदायकम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006251027, "chapter_id": 26251, "verse_number": "३-५-२८", "content_sanskrit": "वर्णत्रयविहीनानां पापिष्ठानां नृणामपि ।\nयद्रूपध्यानमात्रेण दुष्कृतं सुकृतायते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006251028, "chapter_id": 26251, "verse_number": "३-५-२९", "content_sanskrit": "येर्ऽचयन्ति परां शक्तिं विधिनाविधिनापि वा ।\nन ते संसारिणो नूनं मुक्ता एव न संशयः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006251029, "chapter_id": 26251, "verse_number": "३-५-३०", "content_sanskrit": "शिवो वा यां समाराध्य ध्यानयोगबलेन च ।\nईश्वरः सर्वसिद्धानामर्द्धनारीश्वरोऽभवत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006251030, "chapter_id": 26251, "verse_number": "३-५-३१", "content_sanskrit": "अन्येऽब्जप्रमुखा देवाः सिद्धास्तद्ध्यानवैभवात् ।\nतस्मादशेषलोकानां त्रिपुराराधनं विना ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006251031, "chapter_id": 26251, "verse_number": "३-५-३२", "content_sanskrit": "न स्तो भोगापवर्गौं तु यौगपद्येन कुत्रचित् ।\nतन्मनास्तद्गतप्राणस्तद्याजी तद्गतेहकः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006251032, "chapter_id": 26251, "verse_number": "३-५-३३", "content_sanskrit": "तादात्म्येनैव कर्माणि कुर्वन्मुक्तिमवाप्स्यसि ।\nएतद्रहस्यमाख्यातं सर्वेषां हितकाम्यया ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006251033, "chapter_id": 26251, "verse_number": "३-५-३४", "content_sanskrit": "सन्तुष्टेनैव तपसा भवतो मुनिसत्तम ।\nदेवाश्च मुनयः सिद्धा मानुषाश्च तथापरे ।\nत्वन्मुखांभोजतोऽवाप्यसिद्धिं यान्तु परात्पराम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006251034, "chapter_id": 26251, "verse_number": "३-५-३५", "content_sanskrit": "इति तस्य वचः श्रुत्वा हयग्रीवस्य शार्ङ्गिणः ।\nप्रणिपत्य पुनर्वाक्यमुवाच मधुसूदनम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006251035, "chapter_id": 26251, "verse_number": "३-५-३६", "content_sanskrit": "भगवन्कीदृशं रूपं भवता यत्पुरोदितम् ।\nकिंविहारं किंप्रभावमेतन्मे वक्तुमर्हसि ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006251036, "chapter_id": 26251, "verse_number": "३-५-३७", "content_sanskrit": "हयग्रीव उवाच एषोंऽशभूतो देवर्षे हयग्रीवो ममापरः ।\nश्रोतुमिच्छसियद्यत्त्वं तत्सर्वं वक्तुमर्हति ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006251037, "chapter_id": 26251, "verse_number": "३-५-३८", "content_sanskrit": "इत्यादिश्य जगन्नाथो हयग्रीवं तपोधनम् ।\nपुरतः कुम्भजातस्य मुनेरन्तरधाद्धरिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006251038, "chapter_id": 26251, "verse_number": "३-५-३९", "content_sanskrit": "ततस्तु विस्मयाविष्टो हृष्टरोमा तपोधनः ।\nहयग्रीवेण मुनिना स्वाश्रमं प्रत्यपद्यत ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]