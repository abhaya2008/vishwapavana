[{"id": 2040972, "chapter_id": 1910, "verse_number": "५-१५५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040973, "chapter_id": 1910, "verse_number": "५-१५५-१", "content_sanskrit": "व्युष्टायां वै रजन्यां हि राजा दुर्योधनस्ततः।\nव्यभजत्तान्यनिकानि दश चैकं च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040974, "chapter_id": 1910, "verse_number": "५-१५५-२", "content_sanskrit": "नरहस्तिरथाश्वानां सारं मध्यं च फल्गु च।\nसर्वेष्वेतेष्वनीकेषु सन्दिदेश नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040975, "chapter_id": 1910, "verse_number": "५-१५५-३", "content_sanskrit": "सानुकर्षाः सतूणीराः सवरूथाः सतोमराः।\nसोपासङ्गाः सशक्तीकाः सनिषङ्गाः सहर्ष्टयः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040976, "chapter_id": 1910, "verse_number": "५-१५५-४", "content_sanskrit": "सध्वजाः सपताकाश्च सशरासनतोमराः ।\nरज्जुभिश्च विचित्राभिः सपाशाः सपरिच्छदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040977, "chapter_id": 1910, "verse_number": "५-१५५-५", "content_sanskrit": "सकचग्रहविक्षेपाः सतैलगुडवालुकाः ।\nसाशीविषघटाः सर्वे ससर्जरसपांसवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040978, "chapter_id": 1910, "verse_number": "५-१५५-६", "content_sanskrit": "सघण्टफलकाः सर्वे सायोगुडजलोपलाः ॥\nसशालभिन्दिपालाश्च समधूच्छिष्टमुद्गराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040979, "chapter_id": 1910, "verse_number": "५-१५५-७", "content_sanskrit": "सकाण्डदण्डकाः सर्वे ससीरविषतोमराः ।\nसशूर्पपिटकाः सर्वे सदात्राङ्कुशतोमराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040980, "chapter_id": 1910, "verse_number": "५-१५५-८", "content_sanskrit": "सकीलकवचाः सर्वे वाशीवृक्षादनान्विताः।\nव्याघ्रचर्मपरीवारा द्वीपिचर्मावृताश्च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040981, "chapter_id": 1910, "verse_number": "५-१५५-९", "content_sanskrit": "सहर्ष्टयः सश्रृङ्गाश्च सप्रासविविधायुधाः ।\nसकुठाराः सकुद्दालाः सतैलक्षौमसर्पिषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040982, "chapter_id": 1910, "verse_number": "५-१५५-१०", "content_sanskrit": "रुक्मजालप्रतिच्छन्ना नानामणिविभूषिताः ।\nचित्रानीकाः सुवपुषो ज्वलिता इव पावकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040983, "chapter_id": 1910, "verse_number": "५-१५५-११", "content_sanskrit": "तथा कवचिनः शूराः शस्त्रेषु कृतनिश्चयाः ।\nकुलीना हययोनिज्ञाः सारथ्ये विनिवेशिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040984, "chapter_id": 1910, "verse_number": "५-१५५-१२", "content_sanskrit": "बद्धारिष्टा बद्धकक्षा बद्धध्वजपताकिनः।\nबद्धाभरणनिर्यूहा बद्धचर्मासिपट्टिशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040985, "chapter_id": 1910, "verse_number": "५-१५५-१३", "content_sanskrit": "चतुर्युजो रथाः सर्वे सर्वे चोत्तमवाजिनः ।\nसप्रासऋष्टिकाः सर्वे सर्वे शतशरासनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040986, "chapter_id": 1910, "verse_number": "५-१५५-१४", "content_sanskrit": "धुर्ययोर्हकययोरेकस्तथान्यौ पर्ष्णिसारथी ।\nतौ चापि रथिनां श्रेष्ठौ रथी च हयवित्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040987, "chapter_id": 1910, "verse_number": "५-१५५-१५", "content_sanskrit": "नगराणीव गुप्तानि दुराधर्षाणि शत्रुभिः ।\nआसन्रथसहस्राणि हेममालीनि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040988, "chapter_id": 1910, "verse_number": "५-१५५-१६", "content_sanskrit": "यथा रथास्तथा नागा बद्धकक्षाः स्वलङ्कृताः ।\nबभूवुः सप्तपुरुषा रत्नवन्त इवाद्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040989, "chapter_id": 1910, "verse_number": "५-१५५-१७", "content_sanskrit": "द्वावङ्कुशधरौ तत्र द्वावुत्तमधनुर्धरौ ।\nद्वौ वरासिधरौ राजन्नेकः शक्तिपिनाकधृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040990, "chapter_id": 1910, "verse_number": "५-१५५-१८", "content_sanskrit": "गजैर्मत्तैः समाकीर्णं सर्वमायुधकोशकैः।\nतद्बभूव बलं राजन्कौरव्यस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040991, "chapter_id": 1910, "verse_number": "५-१५५-१९", "content_sanskrit": "आमुक्तकवचैर्युक्तैः सपताकैः स्वलङ्कृतैः ।\nसादिभिश्चोपपन्नास्तु तथा चायुतशो हयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040992, "chapter_id": 1910, "verse_number": "५-१५५-२०", "content_sanskrit": "असङ्ग्राहाः सुसंपन्ना हेमभाण्डपरिच्छदाः।\nअनेकशतसाहस्राः सर्वे सादिवशे स्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040993, "chapter_id": 1910, "verse_number": "५-१५५-२१", "content_sanskrit": "नानारूपविकाराश्च नानाकवचशस्त्रिणः ।\nपदातिनो नरास्तत्र बभूवुर्हेममालिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040994, "chapter_id": 1910, "verse_number": "५-१५५-२२", "content_sanskrit": "रथस्यासन्दश गजा गजस्य दश वाजिनः ।\nनरा दश हयस्यासन्पादरक्षाः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040995, "chapter_id": 1910, "verse_number": "५-१५५-२३", "content_sanskrit": "रथस्य नागाः पञ्चाशन्नागस्यासञ्शतं हयाः।\nहयस्य पुरुषाः सप्त भिन्नसन्धानकारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040996, "chapter_id": 1910, "verse_number": "५-१५५-२४", "content_sanskrit": "सेना पञ्चशतं नागा रथास्तावन्त एव च।\nदशसेना च पृतना पृतना दश वाहिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040997, "chapter_id": 1910, "verse_number": "५-१५५-२५", "content_sanskrit": "सेना च वाहिनी चैव पृतना ध्वजिनी चमूः ।\nअक्षौहिणीति पर्यायैर्निरुक्ता च वरूथिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040998, "chapter_id": 1910, "verse_number": "५-१५५-२६", "content_sanskrit": "एवं व्यूढान्यनीकानि कौरवेयेण धीमता।\nअक्षौहिण्यो दशैका च सङ्ख्याताः सप्त चैव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040999, "chapter_id": 1910, "verse_number": "५-१५५-२७", "content_sanskrit": "अक्षौहिण्यस्तु सप्तैव पाण्डवानामभूद्बलम् ।\nअक्षौहिण्यो दशैका च कौरवाणामभूद्बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2041000, "chapter_id": 1910, "verse_number": "५-१५५-२८", "content_sanskrit": "नराणां पञ्चपञ्चाशदेषा पत्तिर्विधीयते।\nसेनामुखं च तिस्रस्ता गुल्म इत्यभिशब्दितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2041001, "chapter_id": 1910, "verse_number": "५-१५५-२९", "content_sanskrit": "त्रयो गुल्मा गणस्त्वासीद्गणास्त्वयुतशोऽभवन् ।\nदुर्योधनस्य सेनासु योत्स्यमानाः प्रहारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2041002, "chapter_id": 1910, "verse_number": "५-१५५-३०", "content_sanskrit": "तत्र दुर्योधनो राजा शूरान्बुद्धिमतो नरान्।\nप्रसमीक्ष्य महाबाहुश्चक्रे सेनापतींस्तदा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2041003, "chapter_id": 1910, "verse_number": "५-१५५-३१", "content_sanskrit": "पृथगक्षौहिणीनां च प्रणेतॄन्नरसत्तमान् ।\nविधिवत्पूर्वमानीय पार्थिवानभ्यषेचयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2041004, "chapter_id": 1910, "verse_number": "५-१५५-३२", "content_sanskrit": "कृपं द्रोणं च शल्यं च सैन्धवं च जयद्रथम् ।\nसुदक्षिणं च काम्भोजं कृतवर्माणमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2041005, "chapter_id": 1910, "verse_number": "५-१५५-३३", "content_sanskrit": "द्रोणपुत्रं च कर्णं च भूरिश्रवसमेव च।\nशकुनिं सौबलं चैव बाह्लीकं च महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2041006, "chapter_id": 1910, "verse_number": "५-१५५-३४", "content_sanskrit": "दिवसे दिवसे तेषां प्रतिवेलं च भारत।\nचक्रे स विविधाः पूजाः प्रत्यक्षं च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2041007, "chapter_id": 1910, "verse_number": "५-१५५-३५", "content_sanskrit": "तथा विनियताः सर्वे ये च तेषां पदानुगाः।\nबभूवुः सैनिका राज्ञां प्रियं राज्ञश्चिकीर्षवः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2041008, "chapter_id": 1910, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सैन्यनिर्याणपर्वणि पञ्चपञ्चाशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]