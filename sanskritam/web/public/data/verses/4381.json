[{"id": 2155724, "chapter_id": 4381, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2155725, "chapter_id": 4381, "verse_number": "१", "content_sanskrit": "कथं शिखण्डी गाङ्गेयमभ्यवर्तत संयुगे ।\nपाण्डवाश्च तथा भीष्मं तन्ममाचक्ष्व सञ्जय\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2155726, "chapter_id": 4381, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2155727, "chapter_id": 4381, "verse_number": "२", "content_sanskrit": "ततः प्रभाते विमले सूर्यस्योदयनं प्रति ।\nवाद्यमानासु भेरीषु मृदङ्गेष्वानकेषु च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2155728, "chapter_id": 4381, "verse_number": "३", "content_sanskrit": "ध्मायत्सु दधिवर्णेषु जलजेषु समन्ततः ।\nशिखण्डिनं पुरस्कृत्य निर्याताः पाण्डवा युधि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2155729, "chapter_id": 4381, "verse_number": "४", "content_sanskrit": "कृत्वा व्यूहं महाराज सर्वशत्रुनिबर्हणम् ।\nशिखण्डी सर्वसैन्यानामग्र आसीद् विशाम्पते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2155730, "chapter_id": 4381, "verse_number": "५", "content_sanskrit": "चक्ररक्षौ ततस्तस्य भीमसेनधनञ्जयौ ।\nपृष्ठतो द्रौपदेयाश्च सौभद्रश्चैव वीर्यवान् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2155731, "chapter_id": 4381, "verse_number": "६", "content_sanskrit": "सात्यकिश्चेकितानश्च तेषां गोप्ता महारथः ।\nधृष्टद्युम्नस्ततः पश्चात् पाञ्चालैरभिरक्षितः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2155732, "chapter_id": 4381, "verse_number": "७", "content_sanskrit": "ततो युधिष्ठिरो राजा यमाभ्यां सहितः प्रभुः ।\nप्रययौ सिंहनादेन नादयन् भरतर्षभ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2155733, "chapter_id": 4381, "verse_number": "८", "content_sanskrit": "विराटस्तु ततः पश्चात् स्वेन सैन्येन संवृतः ।\nद्रुपदश्च महाराज ततः पश्चादुपाद्रवत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2155734, "chapter_id": 4381, "verse_number": "९", "content_sanskrit": "केकया भ्रातरः पञ्च धृष्टकेतुश्च वीर्यवान् ।\nजघनं पालयामास पाण्डुसैन्यस्य भारत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2155735, "chapter_id": 4381, "verse_number": "१०", "content_sanskrit": "एवं व्यूह्य महत्सैन्यं पाण्डवास्तव वाहिनीम् ।\nअभ्यद्रवन्त सङ्ग्रामे त्यक्त्वा जीवितमात्मनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2155736, "chapter_id": 4381, "verse_number": "११", "content_sanskrit": "तथैव कुरवो राजन् भीष्मं कृत्वा महाबलम् ।\nअग्रतः सर्वसैन्यानां प्रययुः पाण्डवान् प्रति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2155737, "chapter_id": 4381, "verse_number": "१२", "content_sanskrit": "पुत्रैस्तव दुराधर्षै रक्षितः सुमहाबलैः ।\nततो द्रोणो महेष्वासः पुत्रश्चास्य महारथः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2155738, "chapter_id": 4381, "verse_number": "१३", "content_sanskrit": "भगदत्तस्ततः पश्चाद् गजानीकेन संवृतः ।\nकृपश्च कृतवर्मा च भगदत्तमनुव्रतौ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2155739, "chapter_id": 4381, "verse_number": "१४", "content_sanskrit": "काम्बोजराजो बलवांस्ततः पश्चात् सुदक्षिणः ।\nमागधश्च जयत्सेनः सौबलश्च बृहद्बलः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2155740, "chapter_id": 4381, "verse_number": "१५", "content_sanskrit": "तथेतरे महेष्वासाः सुशर्मप्रमुखा नृपाः ।\nजघनं पालयामासुस्तव सैन्यस्य भारत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2155741, "chapter_id": 4381, "verse_number": "१६", "content_sanskrit": "दिवसे दिवसे प्राप्ते भीष्मः शान्तनवो युधि ।\nआसुरानकरोद् व्यूहान् पैशाचानथ राक्षसान् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2155742, "chapter_id": 4381, "verse_number": "१७", "content_sanskrit": "ततः प्रववृते युद्धं तव तेषां च भारत ।\nअन्योन्यं निघ्नतां राजन् यमराष्ट्रविवर्धनम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2155743, "chapter_id": 4381, "verse_number": "१८", "content_sanskrit": "अर्जुनप्रमुखाः पार्थाः पुरस्कृत्य शिखण्डिनम् ।\nभीष्मं युद्धेऽभ्यवर्तन्त किरन्तो विविधान् शरान् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2155744, "chapter_id": 4381, "verse_number": "१९", "content_sanskrit": "तत्र भारत भीमेन पीडितास्तावकाः शरैः ।\nरुधिरौघपरिक्लिन्नाः परलोकं ययुस्तदा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2155745, "chapter_id": 4381, "verse_number": "२०", "content_sanskrit": "नकुलः सहदेवश्च सात्यकिश्च महारथः ।\nतव सैन्यं समासाद्य पीडयामासुरोजसा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2155746, "chapter_id": 4381, "verse_number": "२१", "content_sanskrit": "ते वध्यमानाः समरे तावका भरतर्षभ ।\nनाशक्नुवन् वारयितुं पाण्डवानां महद्बलम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2155747, "chapter_id": 4381, "verse_number": "२२", "content_sanskrit": "ततस्तु तावकं सैन्यं वध्यमानं समन्ततः ।\nसम्प्राद्रवद् दिशो राजन् काल्यमानं महारथैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2155748, "chapter_id": 4381, "verse_number": "२३", "content_sanskrit": "त्रातारं नाध्यगच्छन्त तावका भरतर्षभ ।\nवध्यमानाः शितैर्बाणैः पाण्डवैः सहसृञ्जयैः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2155749, "chapter_id": 4381, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2155750, "chapter_id": 4381, "verse_number": "२४", "content_sanskrit": "पीड्यमानं बलं पार्थैर्दृष्ट्वा भीष्मः पराक्रमी ।\nयदकार्षीद् रणे क्रुद्धस्तन्ममाचक्ष्व सञ्जय\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2155751, "chapter_id": 4381, "verse_number": "२५", "content_sanskrit": "कथं वा पाण्डवान् युद्धे प्रत्युद्यातः परन्तपः ।\nविनिघ्नन् सोमकान् वीरांस्तन्ममाचक्ष्व सञ्जय\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2155752, "chapter_id": 4381, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2155753, "chapter_id": 4381, "verse_number": "२६", "content_sanskrit": "आचक्षे ते महाराज यदकार्षीत् पितामहः ।\nपीडिते तव पुत्रस्य सैन्ये पाण्डवसृञ्जयैः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2155754, "chapter_id": 4381, "verse_number": "२७", "content_sanskrit": "प्रहृष्टमनसः शूराः पाण्डवाः पाण्डुपूर्वज ।\nअभ्यवर्तन्त निघ्नन्तस्तव पुत्रस्य वाहिनीम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2155755, "chapter_id": 4381, "verse_number": "२८", "content_sanskrit": "तं विनाशं मनुष्येन्द्र नरवारणवाजिनाम् ।\nनामृष्यत तदा भीष्मः सैन्यघातं रणे परैः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2155756, "chapter_id": 4381, "verse_number": "२९", "content_sanskrit": "स पाण्डवान् महेष्वासः पाञ्चालांश्च ससृञ्जयान् ।\nअभ्यद्रवत दुर्धर्षस्त्यक्त्वा जीवितमात्मनः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2155757, "chapter_id": 4381, "verse_number": "३०", "content_sanskrit": "स पाण्डवानां प्रवरान् पञ्च राजन् महारथान् ।\nआत्तशस्त्रान् रणे यत्तान् वारयामास सायकैः ।\nनाराचैर्वत्सदन्तैश्च शितैरञ्जलिकैस्तथा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2155758, "chapter_id": 4381, "verse_number": "३१", "content_sanskrit": "निजघ्ने समरे क्रुद्धो हस्त्यश्वममितं बहु ।\nरथिनोऽपातयद् राजन् रथेभ्यः पुरुषर्षभः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2155759, "chapter_id": 4381, "verse_number": "३२", "content_sanskrit": "सादिनश्चाश्वपृष्ठेभ्यः पदातींश्च समागतान् ।\nगजारोहान् गजेभ्यश्च परेषां विदधद् भयम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2155760, "chapter_id": 4381, "verse_number": "३३", "content_sanskrit": "तमेकं समरे भीष्मं त्वरमाणं महारथम् ।\nपाण्डवाः समवर्तन्त वज्रपाणिमिवासुराः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2155761, "chapter_id": 4381, "verse_number": "३४", "content_sanskrit": "शक्राशनिसमस्पर्शान् विमुञ्चन् निशितान् शरान् ।\nदिक्ष्वदृश्यत सर्वासु घोरं सन्धारयन् वपुः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2155762, "chapter_id": 4381, "verse_number": "३५", "content_sanskrit": "मण्डलीकृतमेवास्य नित्यं धनुरदृश्यत ।\nसङ्ग्रामे युध्यमानस्य शक्रचापनिभं महत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2155763, "chapter_id": 4381, "verse_number": "३६", "content_sanskrit": "तद्दृष्ट्वा समरे कर्म तव पुत्रा विशाम्पते ।\nविस्मयं परमं प्राप्ताः पितामहमपूजयन् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2155764, "chapter_id": 4381, "verse_number": "३७", "content_sanskrit": "पार्था विमनसो भूत्वा प्रैक्षन्त पितरं तव ।\nयुध्यमानं रणे शूरं विप्रचीत्तिमिवामराः ।\nन चैनं वारयामासुर्व्यात्ताननमिवान्तकम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2155765, "chapter_id": 4381, "verse_number": "३८", "content_sanskrit": "दशमेऽहनि सम्प्राप्ते रथानीकं शिखण्डिनः ।\nअदहन्निशितैर्बाणैः कृष्णवर्त्मेव काननम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2155766, "chapter_id": 4381, "verse_number": "३९", "content_sanskrit": "तं शिखण्डी त्रिभिर्बाणैरभ्यविध्यत् स्तनान्तरे ।\nआशीविषमिव क्रुद्धं कालसृष्टमिवान्तकम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2155767, "chapter_id": 4381, "verse_number": "४०", "content_sanskrit": "स तेनातिभृशं विद्धः प्रेक्ष्य भीष्मः शिखण्डिनम् ।\nअनिच्छन्नपि सङ्क्रुद्धः प्रहसन्निदमब्रवीत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2155768, "chapter_id": 4381, "verse_number": "४१", "content_sanskrit": "काममभ्यास वा मा वा न त्वां योत्स्ये कथञ्चन ।\nयैव हि त्वं कृता धात्रा सैव हि त्वं शिखण्डिनी\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2155769, "chapter_id": 4381, "verse_number": "४२", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा शिखण्डी क्रोधमूर्च्छितः ।\nउवाच भीष्मं समरे सृक्किणी परिलेहिहन् \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2155770, "chapter_id": 4381, "verse_number": "४३", "content_sanskrit": "जानामि त्वां महाबाहो क्षत्रियाणां क्षयङ्करम् ।\nमया श्रुतं च ते युद्धं जामदग्न्येन वै सह\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2155771, "chapter_id": 4381, "verse_number": "४४", "content_sanskrit": "दिव्यश्च ते प्रभावोऽयं स मया बहुशः श्रुतः ।\nजानन्नपि प्रभावं ते योत्स्येऽद्याहं त्वया सह\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2155772, "chapter_id": 4381, "verse_number": "४५", "content_sanskrit": "पाण्डवानां प्रियं कुर्वन्नात्मनश्च नरोत्तम ।\nअद्य त्वा योधयिष्यामि रणे पुरुषसत्तम\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2155773, "chapter_id": 4381, "verse_number": "४६", "content_sanskrit": "ध्रुवं च त्वा हनिष्यामि शपे सत्येन तेऽग्रतः ।\nएतच्छ्रुत्वा वचो मह्यं यत् क्षमं तत् समाचर\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2155774, "chapter_id": 4381, "verse_number": "४७", "content_sanskrit": "काममभ्यास वा मा वा न मे जीवन् विमोक्ष्यसे ।\nसुदृष्टः क्रियतां भीष्म लोकोऽयं समितिञ्जय\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2155775, "chapter_id": 4381, "verse_number": "४८", "content_sanskrit": "एवमुक्त्वा ततो भीष्मं पञ्चभिर्नतपर्वभिः ।\nअविध्यत रणे राजन् प्रणुन्नं वाक्यसायकैः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2155776, "chapter_id": 4381, "verse_number": "४९", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सव्यसाची परन्तपः ।\nकालोऽयमिति सञ्चिन्त्य शिखण्डिनमचोदयत्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2155777, "chapter_id": 4381, "verse_number": "५०", "content_sanskrit": "अहं त्वामनुयास्यामि परान् विद्रावयन् शरैः ।\nअभिद्रव सुसंरब्धो भीष्मं भीमपराक्रमम् \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2155778, "chapter_id": 4381, "verse_number": "५१", "content_sanskrit": "न हि ते संयुगे पीडां शक्तः कर्तुं महाबलः ।\nतस्मादद्य महाबाहो वीर भीष्ममभिद्रव\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2155779, "chapter_id": 4381, "verse_number": "५२", "content_sanskrit": "अहत्वा समरे भीष्मं यदि यास्यसि मारिष ।\nअवहास्योऽस्य लोकस्य भविष्यसि मया सह\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2155780, "chapter_id": 4381, "verse_number": "५३", "content_sanskrit": "नावहास्या यथा वीर भवेम परमाहवे ।\nतथा कुरु रणे यत्नं साधयस्व पितामहम् \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2155781, "chapter_id": 4381, "verse_number": "५४", "content_sanskrit": "अहं ते रक्षणं युद्धे करिष्यामि परन्तप ।\nवारयन् रथिनः सर्वान् साधयस्व पितामहम् \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2155782, "chapter_id": 4381, "verse_number": "५५", "content_sanskrit": "द्रोणं च द्रोणपुत्रं च कृपं चाथ सुयोधनम् ।\nचित्रसेनं विकर्णं च सैन्धवं च जयद्रथम् \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2155783, "chapter_id": 4381, "verse_number": "५६", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ काम्बोजं च सुदक्षिणम् ।\nभगदत्तं तथा शूरं मागधं च महारथम् \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2155784, "chapter_id": 4381, "verse_number": "५७", "content_sanskrit": "सौमदत्तिं रणे शूरमार्श्यशृङ्गिं च राक्षसम् ।\nत्रिगर्तराजं च रणे सह सर्वैर्महारथैः ।\nअहमावारयिष्यामि वेलेव मकरालयम् \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2155785, "chapter_id": 4381, "verse_number": "५८", "content_sanskrit": "कुरूंश्च सहितान् सर्वान् ये चैषां सैनिकाः स्थिताः ।\nनिवारयिष्यामि रणे साधयस्व पितामहम् \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2155786, "chapter_id": 4381, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nभीष्मपर्वणि पञ्चाधिकशततमोऽध्यायः ॥१०५॥\nभीष्मवधपर्वणि पञ्चषष्टितमोऽध्यायः ॥६५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]