[{"id": 2040663, "chapter_id": 1902, "verse_number": "५-१४७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040664, "chapter_id": 1902, "verse_number": "५-१४७-१", "content_sanskrit": "आगम्य हास्तिनपुरादुपप्लाव्यमरिन्दमः ।\nपाण्डवानां यथावृत्तं केशवः सर्वमुक्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040665, "chapter_id": 1902, "verse_number": "५-१४७-२", "content_sanskrit": "संभाष्य सुचिरं कालं मन्त्रयित्वा पुनः पुनः ।\nस्वमेव भवनं शौरिर्विश्रमार्थं जगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040666, "chapter_id": 1902, "verse_number": "५-१४७-३", "content_sanskrit": "विसृज्य सर्वान्नृपतीन्विराटप्रमुखांस्तदा।\nपाण्डवा भ्रातरः पञ्च भानावस्तंगते सति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040667, "chapter_id": 1902, "verse_number": "५-१४७-४", "content_sanskrit": "सन्ध्यामुपास्य ध्यायन्तस्तमेव गतमानसाः।\nआनाय्य कृष्णं दाशार्हं पुनर्मन्त्रममन्त्रयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040668, "chapter_id": 1902, "verse_number": "५-१४७-५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040669, "chapter_id": 1902, "verse_number": "५-१४७-५", "content_sanskrit": "त्वया नागपुरं गत्वा सभायां धृतराष्ट्रजः।\nकिमुक्तः पुण्डरीकाक्ष तन्नः शंसितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040670, "chapter_id": 1902, "verse_number": "५-१४७-६x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040671, "chapter_id": 1902, "verse_number": "५-१४७-६", "content_sanskrit": "मया नागपुरं गत्वा सभायां धृतराष्ट्रजः।\nतथ्यं पथ्यं हितं चोक्तो न च गृह्णाति दुर्मतिः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040672, "chapter_id": 1902, "verse_number": "५-१४७-७x", "content_sanskrit": "युधिष्ठिर उवाच। ५-१४७-७aतस्मिन्नुत्पथमापन्ने कुरुवृद्धः पितामहः।\nकिमुक्तवान्हृषीकेश दुर्योधनममर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040673, "chapter_id": 1902, "verse_number": "५-१४७-८", "content_sanskrit": "आचार्यो वा महाभाग भारद्वाजः किमब्रवीत्।\nपितरौ धृतराष्ट्रस्तं गान्धारी वा किमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040674, "chapter_id": 1902, "verse_number": "५-१४७-९", "content_sanskrit": "पिता यवीयानस्माकं क्षत्ता धर्मविदां वरः।\nपुत्रशोकाभिसन्तप्तः किमाह धृतराष्ट्रजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040675, "chapter_id": 1902, "verse_number": "५-१४७-१०", "content_sanskrit": "किंच सर्वे नृपतयः सभायां ये समासते।\nउक्तवन्तो यथातत्त्वं तद्ब्रूहि त्वं जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040676, "chapter_id": 1902, "verse_number": "५-१४७-११", "content_sanskrit": "उक्तवान्हि भवान्सर्वं वचनं कुरुमुख्ययोः।\nधार्तराष्ट्रस्य तेषां हि वचनं कुरुसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040677, "chapter_id": 1902, "verse_number": "५-१४७-१२", "content_sanskrit": "कामलोभाभिभूतस्य मन्दस्य प्राज्ञमानिनः ।\nअप्रियं हृदये मह्यं तन्न तिष्ठति केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040678, "chapter_id": 1902, "verse_number": "५-१४७-१३", "content_sanskrit": "तेषां वाक्यानि गोविन्द श्रोतुमिच्छाम्यहं विभो।\nयथा च नाभिपद्येत कालस्तात तथा कुरु।\nभवान्हि नो गतिः कृष्ण भवान्नाथो भवान्गुरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040679, "chapter_id": 1902, "verse_number": "५-१४७-१४x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040680, "chapter_id": 1902, "verse_number": "५-१४७-१४", "content_sanskrit": "श्रृणु राजन्यथा वाक्यमुक्तो राजा सुयोधनः।\nमध्ये कुरूणां राजेन्द्र सभायां तन्निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040681, "chapter_id": 1902, "verse_number": "५-१४७-१५", "content_sanskrit": "मया विश्राविते वाक्ये जहास धृतराष्ट्रजः ।\nअथ भीष्मः सुसंक्रुद्ध इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040682, "chapter_id": 1902, "verse_number": "५-१४७-१६", "content_sanskrit": "दुर्योधन निबोधेदं कुलार्थे यद्ब्रवीमि ते।\nतच्छ्रुत्वा राजशार्दूल स्वकुलस्य हितं कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040683, "chapter_id": 1902, "verse_number": "५-१४७-१७", "content_sanskrit": "मम तात पिता राजञ्शन्तनुर्लोकविश्रुतः।\nतस्याहमेक एवासं पुत्रः पुत्रवतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040684, "chapter_id": 1902, "verse_number": "५-१४७-१८", "content_sanskrit": "तस्य बुद्धिः समुत्पन्ना द्वितीयः स्यात्कथं सुतः।\nएकपुत्रमपुत्रं वै प्रवदन्ति मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040685, "chapter_id": 1902, "verse_number": "५-१४७-१९", "content_sanskrit": "न चोच्छेदं कुलं यायाद्विस्तीर्येच्च कथं यशः।\nतस्याहमीप्सितं बुद्ध्वा कालीं मातरमावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040686, "chapter_id": 1902, "verse_number": "५-१४७-२०", "content_sanskrit": "प्रतिज्ञां दुष्करां कृत्वा पितुरर्थे कुलस्य च।\nअराजा चोर्ध्वरेताश्च यथा सुविदितं तव।\nप्रतीतो निवसाम्येष प्रतिज्ञामनुपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040687, "chapter_id": 1902, "verse_number": "५-१४७-२१", "content_sanskrit": "तस्यां जज्ञे महाबाहुः श्रीमान्कुरुकुलोद्वहः ।\nविचित्रवीर्यो धर्मात्मा कनीयान्मम पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040688, "chapter_id": 1902, "verse_number": "५-१४७-२२", "content_sanskrit": "स्वर्यातेऽहं पितरि तं स्वराज्ये सन्न्यवेशयम्।\nविचित्रवीर्यं राजानं भृत्यो भूत्वा ह्यधश्चरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040689, "chapter_id": 1902, "verse_number": "५-१४७-२३", "content_sanskrit": "तस्याहं सदृशान्दारान्राजेन्द्र समुपाहरम्।\nजित्वा पार्थिवसङ्घातमपि ते बहुशः श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040690, "chapter_id": 1902, "verse_number": "५-१४७-२४", "content_sanskrit": "ततो रामेण समरे द्वन्द्वयुद्धमुपागमम्।\nस हि रामभयादेभिर्नागरैर्विप्रवासितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040691, "chapter_id": 1902, "verse_number": "५-१४७-२५", "content_sanskrit": "दारेष्वप्यतिसक्तश्च यक्ष्माणं समपद्यत।\nयदा त्वराजके राष्ट्रे न ववर्ष सुरेश्वरः ।\nतदाभ्यधावन्मामेव प्रजाः क्षुद्भयपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040692, "chapter_id": 1902, "verse_number": "५-१४७-२६x", "content_sanskrit": "प्रजा ऊचुः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2040693, "chapter_id": 1902, "verse_number": "५-१४७-२६", "content_sanskrit": "उपक्षीणाः प्रजाः सर्वा राजा भव भवाय नः।\nईतीः प्रणुद भद्रं शन्तनोः कुलवर्धन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2040694, "chapter_id": 1902, "verse_number": "५-१४७-२७", "content_sanskrit": "पीड्यन्ते ते प्रजाः सर्वा व्याधिभिर्भृशदारुणैः ।\nअल्पावशिष्टा गाङ्गेय ताः परित्रातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2040695, "chapter_id": 1902, "verse_number": "५-१४७-२८", "content_sanskrit": "व्याधीन्प्रणुद्य वीर त्वं प्रजा धर्मेण पालय।\nत्वयि जिवती मा राष्ट्रं विनाशमुपगच्छतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2040696, "chapter_id": 1902, "verse_number": "५-१४७-२९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2040697, "chapter_id": 1902, "verse_number": "५-१४७-२९", "content_sanskrit": "प्रजानां क्रोशतीनां वै नैवाक्षुभ्यत मे मनः ।\nप्रतिज्ञां रक्षमाणस्य तद्वृत्तं स्मरतस्तथा ।\nततः पौरा महाराज माता काली च मे शुभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2040698, "chapter_id": 1902, "verse_number": "५-१४७-३०", "content_sanskrit": "भृत्याः पुरोहिताचार्या ब्राह्मणाश्च बहुश्रुताः।\nमामूचुर्भृशसंतप्ता भव राजेति सन्ततम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2040699, "chapter_id": 1902, "verse_number": "५-१४७-३१", "content_sanskrit": "प्रतीपरक्षितं राष्ट्रं त्वां प्राप्य विनशिष्यति।\nस त्वमस्मद्धितार्थं वै राजा भव महामते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2040700, "chapter_id": 1902, "verse_number": "५-१४७-३२", "content_sanskrit": "इत्युक्तः प्राञ्जलिर्भूत्वा दुःखितो भृशमातुरः ।\nतेभ्यो न्यवेदयं तत्र प्रतिज्ञां पितृगोरवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2040701, "chapter_id": 1902, "verse_number": "५-१४७-३३", "content_sanskrit": "ऊर्ध्वरेता ह्यराजा च कुलस्यार्थे पुनः पुनः ।\nविशेषतस्त्वदर्थं च धुरि मा मां नियोजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2040702, "chapter_id": 1902, "verse_number": "५-१४७-३४", "content_sanskrit": "ततोऽहं प्राञ्जलिर्भूत्वा मातरं संप्रसादयम्।\nनाम्ब शन्तनुना जातः कौरवं वंशमुद्वहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2040703, "chapter_id": 1902, "verse_number": "५-१४७-३५", "content_sanskrit": "प्रतिज्ञां वितथां कुर्यामिति राजन्पुनः पुनः ।\nविशेषतस्त्वदर्थं च प्रतिज्ञां कृतवानहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2040704, "chapter_id": 1902, "verse_number": "५-१४७-३६", "content_sanskrit": "अहं प्रेष्यश्च दासश्च तवाद्य सुतवत्सले ।\nएवं तामनुनीयाहं मातरं जनसन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2040705, "chapter_id": 1902, "verse_number": "५-१४७-३७", "content_sanskrit": "अयाचं भ्रतृदारेषु तदा व्यासं महामुनिम् ।\nसह मात्रा महाराज प्रसाद्य तमृषिं महामुनिम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2040706, "chapter_id": 1902, "verse_number": "५-१४७-३८", "content_sanskrit": "अपत्यार्थं महाराज प्रसादं कृतवांश्च सः ।\nत्रीन्स पुत्रानजनयत्तदा भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2040707, "chapter_id": 1902, "verse_number": "५-१४७-३९", "content_sanskrit": "अन्धः करणहीनत्वान्न वै राजा पिता तव।\nराजा तु पाण्डुरभवन्महात्मा लोकविश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2040708, "chapter_id": 1902, "verse_number": "५-१४७-४०", "content_sanskrit": "स राजा तस्य ते पुत्राः पितुर्दायाद्यहारिणः ।\nमा तात कलहं कार्षी राज्यस्यार्धं प्रदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2040709, "chapter_id": 1902, "verse_number": "५-१४७-४१", "content_sanskrit": "मयि जीवति राज्यं कः संप्रशासेत्पुमानिह।\nमावमंस्या वचो मह्यं शममिच्छामि वः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2040710, "chapter_id": 1902, "verse_number": "५-१४७-४२", "content_sanskrit": "न विशेषोऽस्ति मे पुत्र त्वयि तेषु च षार्थिव।\nमतमेतत्पितुस्तुभ्यं गान्धार्या विदुरस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2040711, "chapter_id": 1902, "verse_number": "५-१४७-४३", "content_sanskrit": "श्रोतव्यं खलु वृद्धानां नाभिशङ्कीर्वचो मम।\nनाशयिष्यसि मा सर्वमात्मानं पृथिवीं तथा ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2040712, "chapter_id": 1902, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि सप्तचत्वारिंशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]