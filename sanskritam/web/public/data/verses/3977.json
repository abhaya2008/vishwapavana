[{"id": 2137342, "chapter_id": 3977, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2137343, "chapter_id": 3977, "verse_number": "१", "content_sanskrit": "किं तद् गुह्यं न चाख्यातं कर्णायेहोष्णरश्मिना ।\nकीदृशे कुण्डले ते च कवचं चैव कीदृशम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2137344, "chapter_id": 3977, "verse_number": "२", "content_sanskrit": "कुतश्च कवचं तस्य कुण्डले चैव सत्तम ।\nएतदिच्छाम्यहं श्रोतुं तन्मे ब्रूहि तपोधन \t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2137345, "chapter_id": 3977, "verse_number": "", "content_sanskrit": "यत् तद् विवस्वतो गुह्यं यादृशे कुण्डले च ते ।\nउभयं तद् यथा ब्रह्मंस्तन्ममाचक्ष्व सत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2137346, "chapter_id": 3977, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2137347, "chapter_id": 3977, "verse_number": "३", "content_sanskrit": "अथ(यं) राजन् ब्रवीम्येतत् तस्य गुह्यं विभावसोः ।\nयादृशे कुण्डले ते च कवचं चैव यादृशम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2137348, "chapter_id": 3977, "verse_number": "४", "content_sanskrit": "कुन्तिभोजं पुरा राजन् ब्राह्मणः पर्युपस्थितः ।\nतिग्मतेजा महाप्रांशुः श्मश्रुदण्डजटाधरः \t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2137349, "chapter_id": 3977, "verse_number": "५", "content_sanskrit": "दर्शनीयोऽनवद्याङ्गस्तेजसा प्रज्वलन्निव ।\nमधुपिङ्गो मधुरवाक् तपःस्वाध्यायभूषणः ।\nस राजानं कुन्तिभोजमब्रवीत्सुमहातपाः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2137350, "chapter_id": 3977, "verse_number": "", "content_sanskrit": "ब्राह्मणः-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2137351, "chapter_id": 3977, "verse_number": "६", "content_sanskrit": "भिक्षामिच्छामि वै भोक्तुं तव गेहे विमत्सरः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2137352, "chapter_id": 3977, "verse_number": "७", "content_sanskrit": "न मे व्यलीकं कर्तव्यं त्वया वा तव चानुगैः ।\nएवं वत्स्यामि ते गेहे यदि ते रोचतेऽनघ \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2137353, "chapter_id": 3977, "verse_number": "८", "content_sanskrit": "यथाकामं च गच्छेयमागच्छेयं तथैव च ।\nशय्यासने च मे राजन् नापराध्येत कश्चन \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2137354, "chapter_id": 3977, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2137355, "chapter_id": 3977, "verse_number": "९", "content_sanskrit": "तमब्रवीत् कुन्तिभोजः प्रीतियुक्तमिदं वचः ।\nएवमस्तु परं चेति पुनश्चैनमथाब्रवीत् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2137356, "chapter_id": 3977, "verse_number": "", "content_sanskrit": "कुन्तिभोजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2137357, "chapter_id": 3977, "verse_number": "१०", "content_sanskrit": "मम कन्या महाप्राज्ञ पृथा नाम यशस्विनी ।\nशीलवृत्तान्विता साध्वी नियता चैव भाविनी\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2137358, "chapter_id": 3977, "verse_number": "११", "content_sanskrit": "उपस्थास्यति सा त्वां वै पूजयाना महाद्युते ।\nतस्याश्च शीलवृत्तेन तुष्टिं समुपयास्यसि \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2137359, "chapter_id": 3977, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2137360, "chapter_id": 3977, "verse_number": "१२", "content_sanskrit": "एवमुक्त्वा तु तं विप्रमभिपूज्य यथाविधि ।\nउवाच कन्यामभ्येत्य पृथां पृथुललोचनाम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2137361, "chapter_id": 3977, "verse_number": "", "content_sanskrit": "कुन्तिभोजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2137362, "chapter_id": 3977, "verse_number": "१३", "content_sanskrit": "अयं वत्से महाभागो ब्राह्मणो वस्तुमिच्छति ।\nमम गेहे मया चास्य तथेत्येवं प्रतिश्रुतम् \t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2137363, "chapter_id": 3977, "verse_number": "१४", "content_sanskrit": "त्वयि वत्से परायत्तं ब्राह्मणस्याभिराधनम् ।\nतन्मे वाक्यममिथ्या त्वां कर्तुमर्हसि कर्हिचित् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2137364, "chapter_id": 3977, "verse_number": "१५", "content_sanskrit": "अयं तपस्वी भगवान् स्वाध्यायनियतो द्विजः ।\nयद्यद् ब्रूयान्महातेजास्तत्तद् देयममत्सरात् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2137365, "chapter_id": 3977, "verse_number": "१६", "content_sanskrit": "ब्राह्मणो हि परं तेजो ब्राह्मणो हि परं तपः ।\nब्राह्मणानां नमस्कारैः सूर्यो दिवि विराजते \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2137366, "chapter_id": 3977, "verse_number": "१७", "content_sanskrit": "अमानयन् हि मानार्हान् वातापिश्च महासुरः ।\nनिहतो ब्रह्मदण्डेन तालजङ्घस्तथैव च \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2137367, "chapter_id": 3977, "verse_number": "१८", "content_sanskrit": "सोऽयं वत्से महाभार आहितस्त्वयि साम्प्रतम् ।\nत्वं सदा नियता कुर्या ब्राह्मणस्याभिराधनम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2137368, "chapter_id": 3977, "verse_number": "१९", "content_sanskrit": "जानामि प्रणिधानं ते बाल्यात् प्रभृति नन्दिनि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2137369, "chapter_id": 3977, "verse_number": "२०", "content_sanskrit": "ब्राह्मणेष्विह सर्वेषु गुरुबन्धुषु चैव ह ।\nतथा प्रेष्येषु सर्वेषु मित्रसम्बन्धिमातृषु ।\nमयि चैव यथावत्त्वं सर्वमावृत्य वर्तसे \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2137370, "chapter_id": 3977, "verse_number": "२१", "content_sanskrit": "न ह्यतुष्टो जनोऽस्तीह पुरे चान्तःपुरे च ते ।\nसम्यग्वृत्त्यानवद्याङ्गि तव भृत्यजनेष्वपि \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2137371, "chapter_id": 3977, "verse_number": "२२", "content_sanskrit": "सन्देष्टव्यां तु मन्ये त्वां द्विजातिं कोपनं प्रति ।\nपृथे बालेति कृत्वा वै सुता चासि ममेति च \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2137372, "chapter_id": 3977, "verse_number": "२३", "content_sanskrit": "वृष्णीनां च कुले जाता शूरस्य दयिता सुता ।\nदत्ता प्रीतिमता मह्यं पित्रा बाला पुरा स्वयम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2137373, "chapter_id": 3977, "verse_number": "२४", "content_sanskrit": "वसुदेवस्य भगिनी सुतानां प्रवरा मम ।\nअग्य्रमग्रे प्रतिज्ञाय तेनासि दुहिता मम \t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2137374, "chapter_id": 3977, "verse_number": "२५", "content_sanskrit": "तादृशे हि कुले जाता कुले चैव विवर्धिता ।\nसुखात् सुखमनुप्राप्ता ह्रदाद् ह्रदमिवागता \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2137375, "chapter_id": 3977, "verse_number": "२६", "content_sanskrit": "दौष्कुलेया विशेषेण कथञ्चित् प्रग्रहं गताः ।\nबालभावाद् विकुर्वन्ति प्रायशः प्रमदाः शुभे \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2137376, "chapter_id": 3977, "verse_number": "२७", "content_sanskrit": "पृथे राजकुले जन्म रूपं चापि तवाद्भुतम् ।\nतेन तेनासि सम्पन्ना समुपेता च भाविनी \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2137377, "chapter_id": 3977, "verse_number": "२८", "content_sanskrit": "सा त्वं दर्पं परित्यज्य दम्भं मानं च भाविनि ।\nआराध्य वरदं विप्रं श्रेयसा योक्ष्यसे पृथे \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2137378, "chapter_id": 3977, "verse_number": "२९", "content_sanskrit": "एवं प्राप्स्यसि कल्याणि कल्याणमनघे ध्रुवम् ।\nकोपिते च द्विजश्रेष्ठे कृत्स्नं दह्येत मे कुलम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2137379, "chapter_id": 3977, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि कुण्डलाहरणपर्वणि द्विवत्यधिकद्विशततमोऽध्यायः ॥२९२॥\nकुण्डलाहरणपर्वणि चतुर्थोऽध्यायः ॥४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]