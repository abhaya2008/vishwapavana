[{"id": 40014935, "chapter_id": 9211, "verse_number": "1", "content_sanskrit": "निमित्तानिनिमित्ताज्ञोदृष्टवालक्ष्मणपूर्वजः । सौमित्रिंसम्परिष्वज्यइदंवचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014936, "chapter_id": 9211, "verse_number": "2", "content_sanskrit": "निमित्तानिपरिगृह्योदकंशीतंवनानिफलवन्तिच । बलौघंसंविभज्येमंव्यूह्यतिष्ठेमलक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014937, "chapter_id": 9211, "verse_number": "3", "content_sanskrit": "लोकक्षयकरंभीमंभयंपश्याम्युपस्थितम् । निबर्हणंप्रवीराणामृक्षवानररक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014938, "chapter_id": 9211, "verse_number": "4", "content_sanskrit": "वाताश्चकलुषावान्तिकम्पतेचवसुन्धराः । पर्वताग्राणिवेपन्तेपतन्तिचमहीरुहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014939, "chapter_id": 9211, "verse_number": "5", "content_sanskrit": "मेघाःक्रव्यादसङ्काशाःपरुषाःपरुषस्वनाः । क्रूराःक्रूरंप्रवर्षन्तिमिश्रंशोणितबिन्दुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014940, "chapter_id": 9211, "verse_number": "6", "content_sanskrit": "रक्तचन्दनसङ्काशासन्ध्यापरमदारुणा । ज्वलतःप्रपतत्येतदादित्यादग्निमण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014941, "chapter_id": 9211, "verse_number": "7", "content_sanskrit": "दीनादीनस्वराःक्रूरास्सर्वतोमृगपक्षिणः । प्रत्यादित्यंविनर्धन्तिजनयन्तोमहाद्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014942, "chapter_id": 9211, "verse_number": "8", "content_sanskrit": "रजन्यामप्रकाशस्तुसन्तापयतिचन्द्रमाः । कृष्णरक्तांशुपर्यन्तोलोकक्षयइवोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014943, "chapter_id": 9211, "verse_number": "9", "content_sanskrit": "ह्रस्वोरूक्षोऽप्रशस्तश्चपरिवेषस्सुलोहितः । आदित्येविमलेनीलंलक्ष्मलक्ष्मणदृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014944, "chapter_id": 9211, "verse_number": "10", "content_sanskrit": "रजसामहताचापिनक्षत्राणिहतानिच । युगान्तमिवलोकानांपश्यशंसन्तीवलक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014945, "chapter_id": 9211, "verse_number": "11", "content_sanskrit": "काकाश्श्येनास्तथानीचागृध्राःपरिपतन्तिच । शिवाश्चाप्यशिवान्नादान्नदन्तिसुमहाभयान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014946, "chapter_id": 9211, "verse_number": "12", "content_sanskrit": "शैलैश्शूलैश्चखढगैश्चविसृष्टैःकपिराक्षसैः । भविष्यत्यावृताभूमिर्मांसशोणितकर्दमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014947, "chapter_id": 9211, "verse_number": "13", "content_sanskrit": "क्षिप्रमद्यैवदुर्दर्षांपुरींरावणपालिताम् । अभियामजनेनैवसर्वतोहरिभिर्ववृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014948, "chapter_id": 9211, "verse_number": "14", "content_sanskrit": "इत्येवमुक्त्वाधर्मात्माधनवीसङ्ग्रामहर्षणः । प्रतस्थेपुरतोरामोलङ्कामभिमुखोविभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014949, "chapter_id": 9211, "verse_number": "15", "content_sanskrit": "सविभीषणसुग्रीवास्ततस्तेवानरर्षभाः । प्रतस्थिरेविनर्दन्तोनिश्चिताद्विषतांवधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40014950, "chapter_id": 9211, "verse_number": "16", "content_sanskrit": "राघवस्यप्रियार्थंतुसुतरांवीर्यशालिनाम् । हरीणांकर्मचेष्टाभिस्तुतोषरघुपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]