[{"id": 5000211000, "chapter_id": 9211, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे पञ्चदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000211001, "chapter_id": 9211, "verse_number": "३-१५-१", "content_sanskrit": "ततः पंचवटीम् गत्वा नाना व्याल मृगायुताम् ।\nउवाच भ्रातरम् रामो लक्ष्मणम् दीप्त तेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000211002, "chapter_id": 9211, "verse_number": "३-१५-२", "content_sanskrit": "आगताः स्म यथा उद्दिष्टम् यम् देशम् मुनिः अब्रवीत् ।\nअयम् पंचवटी देशः सौम्य पुष्पित काननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000211003, "chapter_id": 9211, "verse_number": "३-१५-३", "content_sanskrit": "सर्वतः चार्यताम् दृष्टिः कानने निपुणो हि असि ।\nआश्रमः कतर अस्मिन् नः देशे भवति सम्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000211004, "chapter_id": 9211, "verse_number": "३-१५-४", "content_sanskrit": "रमते यत्र वैदेही त्वम् अहम् चैव लक्ष्मण ।\nतादृशो दृश्यताम् देशः संनिकृष्ट जलाशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000211005, "chapter_id": 9211, "verse_number": "३-१५-५", "content_sanskrit": "वन रामण्यकम् यत्र जल रामण्यकम् तथा ।\nसंनिकृष्टम् च यस्मिन् तु समित् पुष्प कुश उदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000211006, "chapter_id": 9211, "verse_number": "३-१५-६", "content_sanskrit": "एवम् उक्तः तु रामेण लक्मणः संयत अंजलिः ।\nसीता समक्षम् काकुत्स्थम् इदम् वचनम् अब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000211007, "chapter_id": 9211, "verse_number": "३-१५-७", "content_sanskrit": "परवान् अस्मि काकुत्स्थ त्वयि वर्ष शतम् स्थिते ।\nस्वयम् तु रुचिरे देशे क्रियताम् इति माम् वद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000211008, "chapter_id": 9211, "verse_number": "३-१५-८", "content_sanskrit": "सुप्रीतः तेन वाक्येन लक्ष्मणस्य महाद्युतिः ।\nविमृशन् रोचयामास देशम् सर्व गुण अन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000211009, "chapter_id": 9211, "verse_number": "३-१५-९", "content_sanskrit": "स तम् रुचिरम् आक्रम्य देशम् आश्रम कर्मणि ।\nहस्ते गृहीत्वा हस्तेन रामः सौमित्रिम् अब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000211010, "chapter_id": 9211, "verse_number": "३-१५-१०", "content_sanskrit": "अयम् देशः समः श्रीमान् पुष्पितैर् तरुभिर् वृतः ।\nइह आश्रम पदम् सौम्य यथावत् कर्तुम् अर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000211011, "chapter_id": 9211, "verse_number": "३-१५-११", "content_sanskrit": "इयम् आदित्य संकाशैः पद्मैः सुरभि गंधिभिः ।\nअदूरे दृश्यते रम्या पद्मिनी पद्म शोभिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000211012, "chapter_id": 9211, "verse_number": "३-१५-१२", "content_sanskrit": "यथा आख्यातम् अगस्त्येन मुनिना भावितात्मना ।\nइयम् गोदावरी रम्या पुष्पितैः तरुभिर् वृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000211013, "chapter_id": 9211, "verse_number": "३-१५-१३", "content_sanskrit": "हंस कारण्डव आकीर्णा चक्रवाक उपशोभिता ।\nन अतिदूरे न च आसन्ने मृग यूथ निपीडिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000211014, "chapter_id": 9211, "verse_number": "३-१५-१४", "content_sanskrit": "मयूर नादिता रम्याः प्रांशवो बहु कंदराः ।\nदृश्यन्ते गिरयः सौम्य फुल्लैः तरुभिर् आवृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000211015, "chapter_id": 9211, "verse_number": "३-१५-१५", "content_sanskrit": "सौवर्णै राजतैः ताम्रैः देशे देशे च धातुभिः ।\nगवाक्षिता इव आभान्ति गजाः परम भक्तिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000211016, "chapter_id": 9211, "verse_number": "३-१५-१६", "content_sanskrit": "सालैः तालैः तमालैः च खर्जूरैः पनसैः द्रुमैः ।\nनीवारैः तिनिशैः चैव पुन्नागैः च उपशोभिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000211017, "chapter_id": 9211, "verse_number": "३-१५-१७", "content_sanskrit": "चूतैर् अशोकैः तिलकैः केतकैर् अपि चंपकैः ।\nपुष्प गुल्म लता उपेतैः तैः तैः तरुभिर् आवृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000211018, "chapter_id": 9211, "verse_number": "३-१५-१८", "content_sanskrit": "स्यन्दनैः चंदनैः नीपैः पर्णासैः लकुचैः अपि ।\nधव अश्वकर्ण खदिरैः शमी किंशुक पाटलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000211019, "chapter_id": 9211, "verse_number": "३-१५-१९", "content_sanskrit": "इदम् पुण्यम् इदम् रम्यम् इदम् बहु मृग द्विजम् ।\nइह वत्स्याम सौमित्रे सार्धम् एतेन पक्षिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000211020, "chapter_id": 9211, "verse_number": "३-१५-२०", "content_sanskrit": "एवम् उक्तः तु रामेण लक्ष्मणः परवीरहा ।\nअचिरेण आश्रमम् भ्रातुः चकार सुमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000211021, "chapter_id": 9211, "verse_number": "३-१५-२१", "content_sanskrit": "पर्णशालाम् सुविपुलाम् तत्र संघात मृत्तिकाम् ।\nसुस्तंभाम् मस्करैर् दीर्घैः कृत वंशाम् सुशोभनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000211022, "chapter_id": 9211, "verse_number": "३-१५-२२", "content_sanskrit": "शमी शाखाभिः आस्तीर्य धृढ पाशावपाशितम् ।\nकुश काश शरैः पर्णैः सुपरिच्छादिताम् तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000211023, "chapter_id": 9211, "verse_number": "३-१५-२३", "content_sanskrit": "समीकृत तलाम् रम्याम् चकार सुमहाबलः ।\nनिवासम् राघवस्य अर्थे प्रेक्ष्णीयम् अनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000211024, "chapter_id": 9211, "verse_number": "३-१५-२४", "content_sanskrit": "स गत्वा लक्ष्मणः श्रीमान् नदीम् गोदावरीम् तदा ।\nस्नात्वा पद्मानि च आदाय सफलः पुनर् आगतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000211025, "chapter_id": 9211, "verse_number": "३-१५-२५", "content_sanskrit": "ततः पुष्प बलिम् कृत्वा शान्तिम् च स यथाविधि ।\nदर्शयामास रामाय तद् आश्रम पदम् कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000211026, "chapter_id": 9211, "verse_number": "३-१५-२६", "content_sanskrit": "स तम् दृष्ट्वा कृतम् सौम्यम् आश्रमम् सह सीतया ।\nराघवः पर्णशालायाम् हर्षम् आहारयत् परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000211027, "chapter_id": 9211, "verse_number": "३-१५-२७", "content_sanskrit": "सुसंहृष्टः परिष्वज्य बाहुभ्याम् लक्ष्मणम् तदा ।\nअति स्निग्धम् च गाढम् च वचनम् च इदम् अब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000211028, "chapter_id": 9211, "verse_number": "३-१५-२८", "content_sanskrit": "प्रीतो अस्मि ते महत् कर्म त्वया कृतम् इदम् प्रभो ।\nप्रदेयो यन् निमित्तम् ते परिष्वंगो मया कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000211029, "chapter_id": 9211, "verse_number": "३-१५-२९", "content_sanskrit": "भावज्ञेन कृतज्ञेन धर्मज्ञेन च लक्ष्मण ।\nत्वया पुत्रेण धर्मात्मा न संवृत्तः पिता मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000211030, "chapter_id": 9211, "verse_number": "३-१५-३०", "content_sanskrit": "एवम् लक्ष्मणम् उक्त्वा तु राघवो लक्ष्मिवर्धनः ।\nतस्मिन् देशे बहु फले न्यवसत् स सुखम् सुखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000211031, "chapter_id": 9211, "verse_number": "३-१५-३१", "content_sanskrit": "कंचित् कालम् स धर्मात्मा सीतया लक्ष्मणेन च अन्वास्यमानो न्यवसत् स्वर्ग लोके यथा अमरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000211032, "chapter_id": 9211, "verse_number": null, "content_sanskrit": "इति वाल्मीकि रामायणे आदि काव्ये अरण्यकाण्डे पञ्चदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]