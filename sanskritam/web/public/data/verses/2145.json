[{"id": 2051749, "chapter_id": 2145, "verse_number": "७-७२-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2051750, "chapter_id": 2145, "verse_number": "७-७२-१", "content_sanskrit": "अथ संशप्तकैः सार्धं युध्यमाने धनञ्जये।\nअभिमन्यौ हते चापि बाले बलवतां वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2051751, "chapter_id": 2145, "verse_number": "७-७२-२", "content_sanskrit": "महर्षिसत्तमे याते व्यासे स तु युधिष्ठिरः।\nपाण्डवाः किमथाऽकार्षुः शोकोपहतचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2051752, "chapter_id": 2145, "verse_number": "७-७२-३", "content_sanskrit": "कथं संशप्तकेभ्यो वा निवृत्तो वानरध्वजः।\nकेन वा कथितस्तस्य प्रशान्तः सुतपावकः।\nएतन्मे शंस तत्त्वेन सर्वमेवेह सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2051753, "chapter_id": 2145, "verse_number": "७-७२-४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2051754, "chapter_id": 2145, "verse_number": "७-७२-४", "content_sanskrit": "शृणु राजन्यथा तेभ्यो निवृत्तः कृष्णसारथिः।\nततः सर्वाणि सैन्यानि दहन्कृष्णगतिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2051755, "chapter_id": 2145, "verse_number": "७-७२-५", "content_sanskrit": "सम्प्रयातेऽस्तमादित्ये संध्याकाल उपस्थिते।\nअयातस्यात्मशिबिरं निमित्तैरघशंसिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2051756, "chapter_id": 2145, "verse_number": "७-७२-६", "content_sanskrit": "यच्चासीन्मानसं तस्य यच्च कृष्णेन भाषितम्।\nयथा च कथितस्तस्य निहतः सुतपावकः।\nविस्तरेणैव मे सर्वं ब्रुवतः शृणु मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2051757, "chapter_id": 2145, "verse_number": "७-७२-७", "content_sanskrit": "तस्मिन्नहनि निर्वृत्ते घोरे प्राणभृतां क्षये।\nआदित्येऽस्तङ्गते श्रीमान्सन्ध्याकाल उपस्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2051758, "chapter_id": 2145, "verse_number": "७-७२-८", "content_sanskrit": "व्यपयातेषु वासाय सर्वेषु भरतर्षभ।\nहत्वा संशप्तकव्रातान्दिव्यैरस्त्रैः कपिध्वजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2051759, "chapter_id": 2145, "verse_number": "७-७२-९", "content_sanskrit": "प्रायात्स्वशिबिरं जिष्णुर्जैत्रमास्थाय तं रथम्।\nगच्छन्नेव च गोविन्दं साश्रुकण्ठोऽभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2051760, "chapter_id": 2145, "verse_number": "७-७२-१०", "content_sanskrit": "किं तु मे हृदयं त्रस्तं वाक्व सज्जति केशव।\nस्यन्दने नावतिष्ठामि गात्रैः सीदामि चाच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2051761, "chapter_id": 2145, "verse_number": "७-७२-११", "content_sanskrit": "अनिष्टं चैव मे श्लिष्टं हृदयान्नापसर्पति।\nभुविये दिक्षु चात्युग्रा उत्पातास्त्रासयन्ति माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2051762, "chapter_id": 2145, "verse_number": "७-७२-१२", "content_sanskrit": "बहुप्रकारा दृश्यन्ते सर्व एवाघशंसिनः।\nअपि स्वस्ति भवेद्राज्ञः सामात्यस्य गुरोर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2051763, "chapter_id": 2145, "verse_number": "७-७२-१३x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2051764, "chapter_id": 2145, "verse_number": "७-७२-१३", "content_sanskrit": "व्यक्तं शिवं सहभ्रातुर्धर्मराजस्य पाण्डव।\nमा शुचःकिञ्चिदेवान्यत्तत्रानिष्टं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2051765, "chapter_id": 2145, "verse_number": "७-७२-१४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2051766, "chapter_id": 2145, "verse_number": "७-७२-१४", "content_sanskrit": "ततः सन्ध्यामुपास्यैव वीरौ वीरावसादने।\nकथयन्तौ रणे वृत्तं प्रयातौ रथमास्थितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2051767, "chapter_id": 2145, "verse_number": "७-७२-१५", "content_sanskrit": "ततः स्वशिबिरं प्राप्तौ हतामित्रौ हतद्विषौ।\nवासुदेवोऽर्जुनश्चैव कृत्वा कर्म सुदुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2051768, "chapter_id": 2145, "verse_number": "७-७२-१६", "content_sanskrit": "ध्वस्ताकारमिवालेख्यं संवीक्ष्य शिबिरं स्वकम्।\nबीभत्सुरब्रवीत्कृष्णमस्वस्थहृदयस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2051769, "chapter_id": 2145, "verse_number": "७-७२-१७", "content_sanskrit": "नदन्ति नाद्य तूर्याणि मङ्गल्यानि जनार्दन।\nमिश्रा दुन्दुभिनिर्धोषैः शङ्खाश्चाडम्बरैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2051770, "chapter_id": 2145, "verse_number": "७-७२-१८", "content_sanskrit": "वीणा नैवाद्य वाद्यन्ते शम्यातालस्वनैः सह।\nमङ्गल्यानि च गीतानि न गायन्ति पठन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2051771, "chapter_id": 2145, "verse_number": "७-७२-१९", "content_sanskrit": "स्तुतियुक्तानि रम्याणि ममानीकेषु बन्दिनः।\nयोधाश्चापि हि मां दृष्ट्वा निवर्तन्ते ह्यधोमुखाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2051772, "chapter_id": 2145, "verse_number": "७-७२-२०", "content_sanskrit": "कर्माणि च यथापूर्वं कृत्वा नाभिवदन्ति माम्।\nअपि स्वस्ति भवेदद्य भ्रातृभ्यो मम माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2051773, "chapter_id": 2145, "verse_number": "७-७२-२१", "content_sanskrit": "न हि शुद्ध्यति मे भावो दृष्ट्वा स्वजनमाकुलम्।\nअपि पाञ्चालराजस्य विराटस्य च मानद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2051774, "chapter_id": 2145, "verse_number": "७-७२-२२", "content_sanskrit": "सर्वेषां चैव योधानां सामग्र्यं स्यान्ममाच्युत।\nन च मामद्य सौभद्रः प्रहृष्टो भ्रातृभिः सह।\nरणादायान्तमुचितं प्रत्युद्याति हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2051775, "chapter_id": 2145, "verse_number": "७-७२-२३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2051776, "chapter_id": 2145, "verse_number": "७-७२-२३", "content_sanskrit": "एवं सङ्कथयन्तौ तौ प्रविष्टौ शिबिरं स्वकम्।\nददृशाते भृशास्वस्थान्पाण्डवान्नष्टचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2051777, "chapter_id": 2145, "verse_number": "७-७२-२४", "content_sanskrit": "दृष्ट्वा भ्रातृंश्च पुत्रांश्च विमना वानरध्वजः।\nअपश्यंश्चैव सौभद्रमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2051778, "chapter_id": 2145, "verse_number": "७-७२-२५", "content_sanskrit": "मुखवर्णोऽप्रसन्नो वः सर्वेषामेव लक्ष्यते।\nन चाभिमन्युं पश्यामि न च मां प्रतिनन्दथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2051779, "chapter_id": 2145, "verse_number": "७-७२-२६", "content_sanskrit": "मया श्रुतश्च द्रोणेन पद्मव्यूहो विनिर्मितः।\nन च वस्तस्य भेत्ताऽस्ति विना सौभद्रमर्भकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2051780, "chapter_id": 2145, "verse_number": "७-७२-२७", "content_sanskrit": "न चोपदिष्टस्तस्यासीन्मयानीकाद्विनिर्गमः।\nकच्चिन्न बालो युष्माभिः परानीकं प्रवेशितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2051781, "chapter_id": 2145, "verse_number": "७-७२-२८", "content_sanskrit": "भित्त्वाऽनीकं महेष्वासः परेषां बहुभिर्युधि।\nकच्चिन्न निहतः सङ्ख्ये सौभद्रः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2051782, "chapter_id": 2145, "verse_number": "७-७२-२९", "content_sanskrit": "लोहिताक्षं महाबाहुं जातं सिंहमिवाद्रिषु।\nउपेन्द्रसदृशं ब्रूत कथमायोधने हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2051783, "chapter_id": 2145, "verse_number": "७-७२-३०", "content_sanskrit": "सुकुमारं महेष्वासं वासवस्यात्मजात्मजम्।\nसदा मम प्रियं ब्रूत कथमायोधने हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2051784, "chapter_id": 2145, "verse_number": "७-७२-३१", "content_sanskrit": "सुभद्रायाः प्रियं पुत्रं द्रौपद्याः केशवस्य च।\nअम्बायाश्च प्रियं नित्यं कोवधीत्कालमोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2051785, "chapter_id": 2145, "verse_number": "७-७२-३२", "content_sanskrit": "सदृशो वृष्णिवीरस्य केशवस्य महात्मनः।\nविक्रमश्रुतमाहात्म्यैः कथमायोधने हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2051786, "chapter_id": 2145, "verse_number": "७-७२-३३", "content_sanskrit": "वार्ष्णेयीदयितं शूरं मया सततलालितम्।\nयदि पुत्रं न पश्यामि यास्यामि यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2051787, "chapter_id": 2145, "verse_number": "७-७२-३४", "content_sanskrit": "मृदुकुञ्चितकेशान्तं बालं बालमृगेक्षणम्।\nमत्तद्विरदविक्रान्तं सिंहपोतमिवोद्गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2051788, "chapter_id": 2145, "verse_number": "७-७२-३५", "content_sanskrit": "स्मिताभिभाषिणं दान्तं गुरुवाक्यकरं सदा।\nबाल्येऽप्यतुलकर्माणं प्रियवाक्यममत्सरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2051789, "chapter_id": 2145, "verse_number": "७-७२-३६", "content_sanskrit": "महोत्साहं महाबाहुं दीर्घराजीवलोचनम्।\nभक्तानुकम्पिनं दान्तं न च नीचानुसारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2051790, "chapter_id": 2145, "verse_number": "७-७२-३७", "content_sanskrit": "कृतज्ञं ज्ञानसम्पन्नं कृतास्त्रभनिवर्तिनम्।\nयुद्धाभिनन्दिनं नित्यं द्विषतां भयवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2051791, "chapter_id": 2145, "verse_number": "७-७२-३८", "content_sanskrit": "स्वेषां प्रियहिते युक्तं पितॄणां जयगृद्धिनम्।\nन च पूर्वं प्रहर्तारं सम्प्रमे नष्टसम्भ्रमम्।\nयदि पुत्रं न पश्यामि यास्यामि यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2051792, "chapter_id": 2145, "verse_number": "७-७२-३९", "content_sanskrit": "रथेषु गण्यमानेषु गणितं तं महारथम्।\nमयाऽध्यर्धगुणं सङ्ख्ये तरुणं बाहुशालिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2051793, "chapter_id": 2145, "verse_number": "७-७२-४०", "content_sanskrit": "प्रद्युम्नस्य प्रियं नित्यं केशवस्य ममैव च।\nयदि पुत्रं न पश्यामि यास्यामि यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2051794, "chapter_id": 2145, "verse_number": "७-७२-४१", "content_sanskrit": "सुनसं सुललाटान्तं स्वक्षिभ्रूदशनच्छदम्।\nअपश्यतस्तद्वदनं का शान्तिर्हृदयस्य मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2051795, "chapter_id": 2145, "verse_number": "७-७२-४२", "content_sanskrit": "तन्त्रीस्वनसुखं रम्यं पुंस्कोकिलसमध्वनिम्।\nअशृण्वतः स्वनं तस्य का शान्तिर्हृदयस्य मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2051796, "chapter_id": 2145, "verse_number": "७-७२-४३", "content_sanskrit": "रूपं चाप्रतिमं तस्य त्रिदशैश्चापि दुर्लभम्।\nअपश्यतो हि वीरस्य का शान्तिर्हृदयस्य मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2051797, "chapter_id": 2145, "verse_number": "७-७२-४४", "content_sanskrit": "अभिवादनदक्षं तं पितॄणां वचने रतम्।\nनाद्याहं यदि पश्यामि का शान्तिर्हृदयस्य मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2051798, "chapter_id": 2145, "verse_number": "७-७२-४५", "content_sanskrit": "सुकुमारः सदा वीरो महार्हशयनोचितः।\nभूमावनाथवच्छेते नूनं नाथवतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2051799, "chapter_id": 2145, "verse_number": "७-७२-४६", "content_sanskrit": "शयानं समुपासन्ति यं पुरा परमस्त्रियः।\nतमद्य विप्रविद्धाङ्गमुपासन्त्यशिवाः शिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2051800, "chapter_id": 2145, "verse_number": "७-७२-४७", "content_sanskrit": "यः पुरा बोध्यते सुप्तः सूतमागधबन्दिभिः।\nबोधयन्त्यद्य तं नूनं श्वापदा विकृतैः स्वनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2051801, "chapter_id": 2145, "verse_number": "७-७२-४८", "content_sanskrit": "छत्रच्छायासमुचितं तस्य तद्वदनं शुभम्।\nनूनमद्य रजोध्वस्तं रणरेणुः करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2051802, "chapter_id": 2145, "verse_number": "७-७२-४९", "content_sanskrit": "हा पुत्रकावितृप्तस्य सततं पुत्रदर्शने।\nभाग्यहीनस्य कालेन यथा मे नीयसे बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2051803, "chapter_id": 2145, "verse_number": "७-७२-५०", "content_sanskrit": "सा च संयमनी नूनं सदा सुकृतिनां गतिः।\nस्वभाभिर्मोहिता रम्या त्वयाऽत्यर्थं विराजते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2051804, "chapter_id": 2145, "verse_number": "७-७२-५१", "content_sanskrit": "नूनं वैवस्वतश्च त्वां वरुणश्च प्रियातिथिम्।\nशतक्रतुर्धनेशश्च प्राप्तमर्चन्त्यभीरुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2051805, "chapter_id": 2145, "verse_number": "७-७२-५२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2051806, "chapter_id": 2145, "verse_number": "७-७२-५२", "content_sanskrit": "एवं विलप्य बहुधा भिन्नपोतो वगिग्यथा।\nदुःखेन महताऽविष्टो युधिष्ठिरमपृच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2051807, "chapter_id": 2145, "verse_number": "७-७२-५३", "content_sanskrit": "`कथं त्वयि च भीमे च धृष्टद्युम्ने च जीवति।\nसात्यके शक्रविक्रान्ते सौभद्रो निहतः परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2051808, "chapter_id": 2145, "verse_number": "७-७२-५४", "content_sanskrit": "कच्चित्स कदनं कृत्वा परेषां कुरुनन्दन।\nस्वर्गतोऽभिमुखः सङ्ख्ये युध्यमानो नरर्षभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2051809, "chapter_id": 2145, "verse_number": "७-७२-५५", "content_sanskrit": "स नूनं बहुभिर्यत्तैर्युध्यमानो नरर्षभैः।\nअसहायः सहायार्थी मामनुध्यातवान्ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2051810, "chapter_id": 2145, "verse_number": "७-७२-५६", "content_sanskrit": "पीड्यमानः शरैर्बालस्तात साध्वभिधाव माम्।\nइति विप्रलपन्मन्ये नृशंसैर्भुवि पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2051811, "chapter_id": 2145, "verse_number": "७-७२-५७", "content_sanskrit": "अथवा मत्प्रसूतः स स्वस्रीयो माधवस्य च।\nसुभद्रायां च सम्भूतो न चैवं वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2051812, "chapter_id": 2145, "verse_number": "७-७२-५८", "content_sanskrit": "वज्रसारमयं नूनं हृदयं सुदृढं मम।\nअपश्यतो दीर्घबाहुं रक्ताक्षं यन्न दीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2051813, "chapter_id": 2145, "verse_number": "७-७२-५९", "content_sanskrit": "कथं बाले महेष्वासा नृशंसा मर्मभेदिनः।\nस्वस्रीये वासुदेवस्य मम पुत्रेऽक्षिपञ्शरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2051814, "chapter_id": 2145, "verse_number": "७-७२-६०", "content_sanskrit": "यो मां नित्यमदीनात्मा प्रत्युद्गम्याभिनन्दति।\nउपयान्तं रिपून्हत्वा सोऽद्य मां किं न पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2051815, "chapter_id": 2145, "verse_number": "७-७२-६१", "content_sanskrit": "नूनं स पातितः शेते धरण्यां रुधिरोक्षितः।\nशोभयन्मेदिनीं गात्रैरादित्य इव पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2051816, "chapter_id": 2145, "verse_number": "७-७२-६२", "content_sanskrit": "सुभद्रामनुशोचामि या पुत्रमपलायिनम्।\nरणे विनिहतं श्रुत्वा शोकार्ता वै विनङ्क्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2051817, "chapter_id": 2145, "verse_number": "७-७२-६३", "content_sanskrit": "सुभद्रा वक्ष्यते किं मामबिमन्युमपश्यती।\nद्रौपदीं चैव दुःखार्तां किं वा वक्ष्यामि तामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2051818, "chapter_id": 2145, "verse_number": "७-७२-६४", "content_sanskrit": "वज्रसारमयं नूनं हृदयं यन्न यास्यति।\nसहस्रधा वधूं दृष्ट्वा रुदतीं शोककर्शिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2051819, "chapter_id": 2145, "verse_number": "७-७२-६५", "content_sanskrit": "हृष्टानां धार्तराष्ट्राणां सिंहनादो मया श्रुतः।\nयुयुत्सुश्चापि कृष्णेन श्रुतो वीरानुपालभन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2051820, "chapter_id": 2145, "verse_number": "७-७२-६६", "content_sanskrit": "अशक्नुवन्तः पार्थस्य बालं हत्वा महाबलम्।\nकिं न लज्जन्त्यधर्मज्ञाः पार्थिवा दृश्यतां बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2051821, "chapter_id": 2145, "verse_number": "७-७२-६७", "content_sanskrit": "किं तयोर्विप्रियं कृत्वा केशवार्जुनयोर्मृधे।\nसिंहवन्नदथ प्रीताः शोककाल उपस्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2051822, "chapter_id": 2145, "verse_number": "७-७२-६८", "content_sanskrit": "आगमिष्यति वः क्षिप्रं फलं पापस्य कर्मणः।\nअधर्मो हि कृतस्तीव्रः कथं स्यादफलश्चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2051823, "chapter_id": 2145, "verse_number": "७-७२-६९", "content_sanskrit": "इति तान्परिभाषन्वै वैश्यापुत्रो महामतिः।\nअपायाच्छस्त्रमुत्सृज्य कोपदुःखसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2051824, "chapter_id": 2145, "verse_number": "७-७२-७०", "content_sanskrit": "किमर्थमेतन्नाख्यातं त्वया कृष्ण रणे मम।\nअधक्ष्यं तानहं क्रूरांस्तदा सर्वान्महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2051825, "chapter_id": 2145, "verse_number": "७-७२-७१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2051826, "chapter_id": 2145, "verse_number": "७-७२-७१", "content_sanskrit": "पुत्रशोकार्दितं पार्थं ध्यायन्तं साश्रुलोचनम्।\nनिगृह्य वासुदेवस्तं पुत्राधिभिरभिप्लुतम्।\nमैवमित्यब्रवीत्कृष्णस्तीव्रशोकसमन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2051827, "chapter_id": 2145, "verse_number": "७-७२-७२", "content_sanskrit": "सर्वेषामेष वै पन्थाः शूराणामनिवर्तिनाम्।\nक्षत्रियाणां विशेषेण येषां नः शस्त्रजीविका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2051828, "chapter_id": 2145, "verse_number": "७-७२-७३", "content_sanskrit": "एषा वै युध्यमानानां शूराणामनिवर्तिनाम्।\nविहिता सर्वशास्त्रज्ञैर्गतिर्मतिमतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2051829, "chapter_id": 2145, "verse_number": "७-७२-७४", "content_sanskrit": "ध्रुवं हि युद्धे मरणं शूरामामनिवर्तिनाम्।\nगतः पुण्यकृतां लोकानभिमन्युर्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2051830, "chapter_id": 2145, "verse_number": "७-७२-७५", "content_sanskrit": "एतच्च सर्ववीराणां काङ्क्षितं भरतर्षभ।\nसङ्ग्रामेऽभिमुखा मृत्युं प्राप्नुयामेति मानद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2051831, "chapter_id": 2145, "verse_number": "७-७२-७६", "content_sanskrit": "स च वीरान्रणे हत्वा राजपुत्रान्महाबलान्।\nवीरैराकाङ्क्षितं मृत्युं सम्प्राप्तोऽभिमुखं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2051832, "chapter_id": 2145, "verse_number": "७-७२-७७", "content_sanskrit": "मा शुचः पुरुषव्याघ्र पूर्वैरेष सनातनः।\nधर्मकृद्भिः कृतो धर्मः क्षत्रियाणां रणे क्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2051833, "chapter_id": 2145, "verse_number": "७-७२-७८", "content_sanskrit": "इमे ते भ्रातरः सर्वे दीना भरतसत्तम।\nत्वयि शोकसमाविष्टे नृपाश्च सुहृदस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2051834, "chapter_id": 2145, "verse_number": "७-७२-७९", "content_sanskrit": "एतांश्च वचसा साम्ना समाश्वासय मानद।\nविदितं वेदितव्यं ते न शोकं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2051835, "chapter_id": 2145, "verse_number": "७-७२-८०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2051836, "chapter_id": 2145, "verse_number": "७-७२-८०", "content_sanskrit": "एवमाश्वासितः पार्थः कृष्णेनाद्भुतकर्मणा।\nततोऽब्रवीत्तदा भ्रातॄन्सर्वान्पार्थः सगद्गदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2051837, "chapter_id": 2145, "verse_number": "७-७२-८१", "content_sanskrit": "स दीर्घबाहुः पृथ्वंसो दीर्घराजीवलोचनः।\nअभिमन्युर्यथा वृत्तः श्रोतुमिच्छाम्यहं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2051838, "chapter_id": 2145, "verse_number": "७-७२-८२", "content_sanskrit": "सनागस्यन्दनहयान्सङ्ग्रामे निहतान्मया।\nक्षिप्रं द्रक्ष्यन्ति ते नूनं मम पुत्रं निहत्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2051839, "chapter_id": 2145, "verse_number": "७-७२-८३", "content_sanskrit": "कथं च वः कृतास्त्राणां सर्वेषां शस्त्रपाणिनाम्।\nसौभद्रो निधनं गच्छेद्वज्रिणापि समागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2051840, "chapter_id": 2145, "verse_number": "७-७२-८४", "content_sanskrit": "यद्येवमहमज्ञास्यमशक्तान्रक्षणे मम।\nसूनोः पाण्डवपाञ्चालानगोप्स्यं तं महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2051841, "chapter_id": 2145, "verse_number": "७-७२-८५", "content_sanskrit": "कथं च वो रथस्यानां शरवर्षाणि मुञ्चताम्।\nनीतोऽभिमन्युर्निधनं कदर्थीकृत्य वः परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2051842, "chapter_id": 2145, "verse_number": "७-७२-८६", "content_sanskrit": "अहो वः पौरुषं नास्ति न च वोऽस्ति पराक्रमः।\nयत्राभिमन्युः समरे पश्यतां वो निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2051843, "chapter_id": 2145, "verse_number": "७-७२-८७", "content_sanskrit": "आत्मानमेव गर्हेयं यदहं वै सुदुर्बलान्।\nयुष्मानाज्ञाय निर्यातो भीरूनकृतनिश्चयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2051844, "chapter_id": 2145, "verse_number": "७-७२-८८", "content_sanskrit": "आहोस्विद्भूषणार्थाय वर्मशस्त्रायुधानि वः।\nवाचस्तु वक्तुं संसत्सु मम पुत्रमरक्षताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2051845, "chapter_id": 2145, "verse_number": "७-७२-८९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2051846, "chapter_id": 2145, "verse_number": "७-७२-८९", "content_sanskrit": "एवमुक्त्वा ततो वाक्यमतिष्ठद्वै वरासिमान्।\nन स्माशक्यत बीभत्सुः केनचित्प्रसमीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2051847, "chapter_id": 2145, "verse_number": "७-७२-९०", "content_sanskrit": "तमन्तकमिव क्रुद्धं निःश्वसन्तं मुहुर्मुहुः।\n`महेन्द्रमिव तिष्ठन्तं वज्रोद्यतमहाभुजम्।\nपुत्रशोकाभिसन्तप्तमश्रुपूर्णमुखं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2051848, "chapter_id": 2145, "verse_number": "७-७२-९१", "content_sanskrit": "न भाषितुं शक्नुवन्ति द्रष्टुं वा सुहृदोऽर्जुनम्।\nअन्यत्र वासुदेवाद्वा ज्येष्ठाद्वा पाण्डुनन्दनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2051849, "chapter_id": 2145, "verse_number": "७-७२-९२", "content_sanskrit": "सर्वास्ववस्थासु हितावर्जुनस्य मनोनुगौ।\nबहुमानात्प्रियत्वाच्च तावेनं वक्तमर्हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2051850, "chapter_id": 2145, "verse_number": "७-७२-९३", "content_sanskrit": "ततस्तं पुत्रशोकेन भृशं पीडितमानसम्।\nराजीवलोचनं क्रुद्धं राजा वचनमब्रवीत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2051851, "chapter_id": 2145, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि प्रतिज्ञापर्वणि द्विसप्ततितमोऽध्यायः॥ ७२ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-७२-११ श्लिष्टमनुबद्धम्॥ ५-७२-१७ आडम्बरैस्तूर्यरवैः॥ ५-७२-४९ यथेति कथमर्थे॥ ५-७२-७० वासुदेव उवाच। किमर्थमेतन्नाख्यातं त्वया पार्थ रणे मम इति ट.पाठः॥ ५-७२-७२ द्विसप्ततितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}]