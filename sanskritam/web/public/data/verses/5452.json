[{"id": 2208394, "chapter_id": 5452, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2208395, "chapter_id": 5452, "verse_number": "१", "content_sanskrit": "बुद्ध्याधारं मनस्तम्भमिन्द्रियग्रामवर्धनम् ।\nमहाभूतारविष्कम्भं निमेषपरिवेषणम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2208396, "chapter_id": 5452, "verse_number": "२", "content_sanskrit": "जराशोकसमाविष्टं व्याधिव्यसनपञ्जरम् ।\nदेशकालविचारीदं श्रमव्यायामनिःस्वनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2208397, "chapter_id": 5452, "verse_number": "३", "content_sanskrit": "अहोरात्रपरिक्षेपं शीतोष्णपरिमण्डलम् ।\nसुखदुःखसमश्लेषं क्षुत्पिपासावकीलनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2208398, "chapter_id": 5452, "verse_number": "४", "content_sanskrit": "छायातपविलेखं च निमेषोन्मेषविह्वलम् ।\nशोकमोहजराकीर्णं वर्तमानमचेतनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2208399, "chapter_id": 5452, "verse_number": "५", "content_sanskrit": "मासार्धमासगुणितं विषमं लोकसञ्चरम् ।\nतमोनियतपङ्कं च रजोवेगप्रवर्तकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2208400, "chapter_id": 5452, "verse_number": "६", "content_sanskrit": "सत्त्वालङ्कारदीप्तं च गुणसङ्घातमण्डलम् ।\nसारविग्रहनाभीकं शोकसङ्घातवर्तकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2208401, "chapter_id": 5452, "verse_number": "७", "content_sanskrit": "क्रियाकारणसंयुक्तं रागविस्तारमायतम् ।\nलोभेप्सापरसङ्घात-विवक्तज्ञानसम्भवम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2208402, "chapter_id": 5452, "verse_number": "८", "content_sanskrit": "भयमोहपरीवारं भूतसम्मोहकारकम् ।\nआनन्दप्रीतिचारं च कामक्रोधपरिग्रहम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2208403, "chapter_id": 5452, "verse_number": "९", "content_sanskrit": "महदादिविशेषान्तमसक्तं प्रभवाप्ययम् ।\nमनोजवमविश्रान्तं कालचक्रं प्रवर्तते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2208404, "chapter_id": 5452, "verse_number": "१०", "content_sanskrit": "एतद् द्वन्द्वसमायुक्तं कालचक्रमचेतनम् ।\nविसृजन् सङ्क्षिपंश्चापि बोधयन् स्वापयन् जगत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2208405, "chapter_id": 5452, "verse_number": "११", "content_sanskrit": "कालचक्रप्रवृत्तिं च निवृत्तिं चैव तत्त्वतः ।\nयस्तु वेद नरो नित्यं न स भूतेषु मुह्यति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2208406, "chapter_id": 5452, "verse_number": "१२", "content_sanskrit": "विमुक्तः सर्वसङ्क्लेशैः सर्वद्वन्द्वातिगो मुनिः ।\nविमुक्तः सर्वपापेभ्यः प्राप्नोति परमां गतिम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2208407, "chapter_id": 5452, "verse_number": "१३", "content_sanskrit": "गृहस्थो ब्रह्मचारी च वानप्रस्थोऽथ भिक्षुकः ।\nचत्वार आश्रमाः प्रोक्ताः सर्वे गार्हस्थ्यमूलकाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2208408, "chapter_id": 5452, "verse_number": "१४", "content_sanskrit": "यः कश्चिदिह लोके च ह्याश्रमः सम्प्रकीर्तितः ।\nतस्यान्तगमनं ज्ञेयं कीर्तिरेषा सनातनी ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2208409, "chapter_id": 5452, "verse_number": "१५", "content_sanskrit": "संस्कारैः सङ्कृतः पूर्वं यथावच्चरितव्रतः ।\nजातौ गुणविशिष्टायां समावर्तेत वेदवित् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2208410, "chapter_id": 5452, "verse_number": "१६", "content_sanskrit": "स्वदारनिरतो नित्यं शिष्टाचारो जितेन्द्रियः ।\nपञ्चभिश्च महायज्ञैः श्रद्दधानो यजेदिह ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2208411, "chapter_id": 5452, "verse_number": "१७", "content_sanskrit": "देवतातिथिशिष्टाशी निरतो वेदकर्मसु ।\nइज्याप्रदानयुक्तश्च यथाशक्ति यथाविधि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2208412, "chapter_id": 5452, "verse_number": "१८", "content_sanskrit": "न पाणिपादचपलो न नेत्रचपलो मुनिः ।\nन च वागङ्गचपल इति शिष्टस्य गोचरः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2208413, "chapter_id": 5452, "verse_number": "१९", "content_sanskrit": "नित्यं यज्ञोपवीती स्यात् शुक्लवासाः शुचिव्रतः ।\nनियतो दमदानाभ्यां सदा शिष्टैश्च संवदन् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2208414, "chapter_id": 5452, "verse_number": "२०", "content_sanskrit": "जितशिश्नोदरो मैत्रः शिष्टाचारसमाहितः ।\nवैणवीं धारयेद् यष्टिं सोदकं च कमण्डलुम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2208415, "chapter_id": 5452, "verse_number": "२१", "content_sanskrit": "त्रीणि धारयते नित्यं कमण्डलुमतन्द्रितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2208416, "chapter_id": 5452, "verse_number": "२२", "content_sanskrit": "एकमाचमनार्थाय एकं वै पादधावनम् ।\nएकं शौचविधानार्थमित्येतत् त्रितयं तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2208417, "chapter_id": 5452, "verse_number": "२३", "content_sanskrit": "अधीत्याध्यापनं कुर्यात् तथा यजनयाजने ।\nदानं प्रतिग्रहं चैव षड्गुणां वृत्तिमाचरेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2208418, "chapter_id": 5452, "verse_number": "२४", "content_sanskrit": "त्रीणि कर्माणि यानीह ब्राह्मणानां तु जीविकाः ।\nयाजनाध्यापने चोभे शुद्धाच्चापि प्रतिग्रहः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2208419, "chapter_id": 5452, "verse_number": "२५", "content_sanskrit": "अवशेषाणि चान्यानि त्रीणि कर्माणि यान्युत ।\nदानमध्ययनं यज्ञो धर्मयुक्तानि तानि तु ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2208420, "chapter_id": 5452, "verse_number": "२६", "content_sanskrit": "तेष्वप्रमादं कुर्वीत त्रिषु कर्मसु कर्मवित् ।\nदान्तो मैत्रः क्षमायुक्तः सर्वभूतेषु वै मुनिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2208421, "chapter_id": 5452, "verse_number": "२७", "content_sanskrit": "सर्वमेतद् यथाशक्ति विप्रो निर्वर्तयेच्छुचिः ।\nएवं युक्तो जयेत् स्वर्गं गृहस्थः संशितव्रतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2208422, "chapter_id": 5452, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अनुगीतासु त्रिकर्मशंसनं नाम षट्चत्वारिंशोऽध्यायः ॥४६॥\nअनुगीतापर्वणि एकत्रिंशोऽध्यायः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]