[{"id": 5000052000, "chapter_id": 9052, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे द्विपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000052001, "chapter_id": 9052, "verse_number": "१-५२-१", "content_sanskrit": "तं दृष्ट्वा परमप्रीतो विश्वामित्रो महाबलः।\nप्रणतो विनयाद् वीरो वसिष्ठं जपतां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000052002, "chapter_id": 9052, "verse_number": "१-५२-२", "content_sanskrit": "स्वागतं तव चेत्युक्तो वसिष्ठेन महात्मना।\nआसनं चास्य भगवान् वसिष्ठो व्यादिदेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000052003, "chapter_id": 9052, "verse_number": "१-५२-३", "content_sanskrit": "उपविष्टाय च तदा विश्वामित्राय धीमते।\nयथान्यायं मुनिवरः फलमूलमुपाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000052004, "chapter_id": 9052, "verse_number": "१-५२-४", "content_sanskrit": "प्रतिगृह्य तु तां पूजां वसिष्ठाद् राजसत्तमः।\nतपोऽग्निहोत्रशिष्येषु कुशलं पर्यपृच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000052005, "chapter_id": 9052, "verse_number": "१-५२-५", "content_sanskrit": "विश्वामित्रो महातेजा वनस्पतिगणे तदा।\nसर्वत्र कुशलं प्राह वसिष्ठो राजसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000052006, "chapter_id": 9052, "verse_number": "१-५२-६", "content_sanskrit": "सुखोपविष्टं राजानं विश्वामित्रं महातपाः।\nपप्रच्छ जपतां श्रेष्ठो वसिष्ठो ब्रह्मणः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000052007, "chapter_id": 9052, "verse_number": "१-५२-७", "content_sanskrit": "कच्चित्ते कुशलं राजन् कच्चिद् धर्मेण रञ्जयन्।\nप्रजाः पालयसे राजन् राजवृत्तेन धार्मिक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000052008, "chapter_id": 9052, "verse_number": "१-५२-८", "content_sanskrit": "कच्चित्ते सम्भृता भृत्याः कच्चित् तिष्ठन्ति शासने।\nकच्चित्ते विजिताः सर्वे रिपवो रिपुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000052009, "chapter_id": 9052, "verse_number": "१-५२-९", "content_sanskrit": "कच्चिद् बलेषु कोशेषु मित्रेषु च परंतप।\nकुशलं ते नरव्याघ्र पुत्रपौत्रे तथानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000052010, "chapter_id": 9052, "verse_number": "१-५२-१०", "content_sanskrit": "सर्वत्र कुशलं राजा वसिष्ठं प्रत्युदाहरत्।\nविश्वामित्रो महातेजा वसिष्ठं विनयान्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000052011, "chapter_id": 9052, "verse_number": "१-५२-११", "content_sanskrit": "कृत्वा तौ सुचिरं कालं धर्मिष्ठौ ताः कथास्तदा।\nमुदा परमया युक्तौ प्रीयेतां तौ परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000052012, "chapter_id": 9052, "verse_number": "१-५२-१२", "content_sanskrit": "ततो वसिष्ठो भगवान् कथान्ते रघुनन्दन।\nविश्वामित्रमिदं वाक्यमुवाच प्रहसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000052013, "chapter_id": 9052, "verse_number": "१-५२-१३", "content_sanskrit": "आतिथ्यं कर्तुमिच्छामि बलस्यास्य महाबल।\nतव चैवाप्रमेयस्य यथार्हं सम्प्रतीच्छ मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000052014, "chapter_id": 9052, "verse_number": "१-५२-१४", "content_sanskrit": "सत्क्रियां हि भवानेतां प्रतीच्छतु मया कृताम्।\nराजंस्त्वमतिथिश्रेष्ठः पूजनीयः प्रयत्नतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000052015, "chapter_id": 9052, "verse_number": "१-५२-१५", "content_sanskrit": "एवमुक्तो वसिष्ठेन विश्वामित्रो महामतिः।\nकृतमित्यब्रवीद् राजा पूजावाक्येन मे त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000052016, "chapter_id": 9052, "verse_number": "१-५२-१६", "content_sanskrit": "फलमूलेन भगवन् विद्यते यत् तवाश्रमे।\nपाद्येनाचमनीयेन भगवद्दर्शनेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000052017, "chapter_id": 9052, "verse_number": "१-५२-१७", "content_sanskrit": "सर्वथा च महाप्राज्ञ पूजार्हेण सुपूजितः।\nनमस्तेऽस्तु गमिष्यामि मैत्रेणेक्षस्व चक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000052018, "chapter_id": 9052, "verse_number": "१-५२-१८", "content_sanskrit": "एवं ब्रुवन्तं राजानं वसिष्ठं पुनरेव हि।\nन्यमन्त्रयत धर्मात्मा पुनः पुनरुदारधीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000052019, "chapter_id": 9052, "verse_number": "१-५२-१९", "content_sanskrit": "बाढमित्येव गाधेयो वसिष्ठं प्रत्युवाच ह।\nयथाप्रियं भगवतस्तथास्तु मुनिपुंगव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000052020, "chapter_id": 9052, "verse_number": "१-५२-२०", "content_sanskrit": "एवमुक्तस्तथा तेन वसिष्ठो जपतां वरः।\nआजुहाव ततः प्रीतः कल्माषीं धूतकल्मषाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000052021, "chapter_id": 9052, "verse_number": "१-५२-२१", "content_sanskrit": "एह्येहि शबले क्षिप्रं शृणु चापि वचो मम।\nसबलस्यास्य राजर्षेः कर्तुं व्यवसितोऽस्म्यहम्।\nभोजनेन महार्हेण सत्कारं संविधत्स्व मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000052022, "chapter_id": 9052, "verse_number": "१-५२-२२", "content_sanskrit": "यस्य यस्य यथाकामं षड्रसेष्वभिपूजितम्।\nतत् सर्वं कामधुग् दिव्ये अभिवर्ष कृते मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000052023, "chapter_id": 9052, "verse_number": "१-५२-२३", "content_sanskrit": "रसेनान्नेन पानेन लेह्यचोष्येण संयुतम्।\nअन्नानां निचयं सर्वं सृजस्व शबले त्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000052024, "chapter_id": 9052, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे द्विपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]