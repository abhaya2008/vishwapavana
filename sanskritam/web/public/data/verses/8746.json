[{"id": 900009492, "chapter_id": 8746, "verse_number": "4.1", "content_sanskrit": "नन्वेतदयुक्तम् । अविद्यानिवृत्तिर्हि मोक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009493, "chapter_id": 8746, "verse_number": "4.2", "content_sanskrit": "यच्चोच्यते ब्रह्मरूपायाः स्वप्रकाशचितोऽज्ञानसाधकत्वेन तदनिवर्तकत्वेऽपि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009494, "chapter_id": 8746, "verse_number": "4.3", "content_sanskrit": "यच्चोच्यते न वैशेषिकादीनामिवास्माकं मुक्तौ दुःखनिवृत्तिमात्रम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009495, "chapter_id": 8746, "verse_number": "4.4", "content_sanskrit": "यच्चोच्यते तत्त्वसाक्षात्कारेण नष्टाविद्योऽनुवृत्तदेहादिप्रतिभासश्च जीवन्मुक्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009496, "chapter_id": 8746, "verse_number": "4.5", "content_sanskrit": "ननु मुक्तौ न तारतम्यम् । मानाभावात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]