[{"id": 2169790, "chapter_id": 4629, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2169791, "chapter_id": 4629, "verse_number": "१", "content_sanskrit": "क्षत्रियास्ते महाराज परस्परवधैषिणः ।\nअन्योन्यं समरे जघ्नुः कृतवैराः परस्परम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2169792, "chapter_id": 4629, "verse_number": "२", "content_sanskrit": "रथौघाश्च हयौघाश्च नरौघाश्च समन्ततः ।\nगजौघाश्च महाराज संसक्ताः स्म परस्परम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2169793, "chapter_id": 4629, "verse_number": "३", "content_sanskrit": "गदानां परिघाणां च कणपानां च सर्पताम् ।\nप्रासानां भिण्डिपालानां मुसलानां च सर्वशः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2169794, "chapter_id": 4629, "verse_number": "४", "content_sanskrit": "सम्पातं चान्वपश्याम सङ्ग्रामे भृशदारुणे ।\nशलभा इव सम्पेतुः समन्तात् शरवृष्टयः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2169795, "chapter_id": 4629, "verse_number": "५", "content_sanskrit": "नागा नागान् समासाद्य व्यधमन्त परस्परम् ।\nहया हयांश्च समरे रथिनो रथिनस्तथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2169796, "chapter_id": 4629, "verse_number": "६", "content_sanskrit": "पत्तयः पत्तिसङ्घैश्च समासाद्य परस्परम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2169797, "chapter_id": 4629, "verse_number": "७", "content_sanskrit": "पत्तयो रथमातङ्गान् रथा हस्त्यश्वमेव च ।\nनागाश्च समरे त्र्यङ्गं ममृदुः शीघ्रगा नृप\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2169798, "chapter_id": 4629, "verse_number": "८", "content_sanskrit": "वध्यतां तत्र शूराणां क्रोशतां च परस्परम् ।\nघोरमायोधनं जज्ञे पशूनां वैशसं यथा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2169799, "chapter_id": 4629, "verse_number": "९", "content_sanskrit": "रुधिरेण समास्तीर्णा भाति भारत मेदिनी ।\nशक्रगोपगणाकीर्णा प्रावृषीव यथा धरा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2169800, "chapter_id": 4629, "verse_number": "१०", "content_sanskrit": "यथा वा वाससी शुक्ले महारजनरञ्जिते ।\nबिभृयाद् युवतिः श्यामा तद्वदासीद् वसुन्धरा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2169801, "chapter_id": 4629, "verse_number": "११", "content_sanskrit": "मांसशोणितचित्रेव शातकौम्भमयीव च\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2169802, "chapter_id": 4629, "verse_number": "१२", "content_sanskrit": "छिन्नानां चोत्तमाङ्गानां बाहूनां चोरुभिः सह ।\nकुण्डलानां प्रविद्धानां भूषणानां च भारत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2169803, "chapter_id": 4629, "verse_number": "१३", "content_sanskrit": "निष्काणामधिसूत्राणां शरीराणां च धन्विनाम् ।\nवर्मणां सपताकानां सङ्घास्तत्रापतन् भुवि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2169804, "chapter_id": 4629, "verse_number": "१४", "content_sanskrit": "गजान् गजाः समासाद्य विषाणाग्रैरदारयन् ।\nविषाणाभिहतास्ते च भ्राजन्ते द्विरदा यथा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2169805, "chapter_id": 4629, "verse_number": "१५", "content_sanskrit": "रुधिरेणावसिक्ताङ्गा गैरिकप्रभवा इव ।\nयथा भ्राजन्ति स्यन्दन्तः पर्वता धातुमण्डिताः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2169806, "chapter_id": 4629, "verse_number": "१६", "content_sanskrit": "तोमरान् गजिभिर्मुक्तान् प्रतीपानास्थितान् बहून् ।\nहस्तैर्विचिक्षिपुर्नागा बभञ्जुश्चापरे तथा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2169807, "chapter_id": 4629, "verse_number": "१७", "content_sanskrit": "नाराचैश्छिन्नवर्माणो भ्राजन्ते स्म गजोत्तमाः ।\nहिमागमे महाराज व्यभ्रा इव महीधराः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2169808, "chapter_id": 4629, "verse_number": "१८", "content_sanskrit": "शरैः कनकपुङ्खैस्तु चिता रेजुर्गजोत्तमाः ।\nउल्काभिः सम्प्रदीप्ताग्राः पर्वता इव मारिष\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2169809, "chapter_id": 4629, "verse_number": "१९", "content_sanskrit": "केचिदभ्याहता नागा नागैर्नगनिभा भुवि ।\nनिपेतुः समरे तस्मिन् छिन्नपक्ष इवाद्रयः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2169810, "chapter_id": 4629, "verse_number": "२०", "content_sanskrit": "अपरे प्राद्रवन्नागाः शल्यार्ता व्रणपीडिताः ।\nप्रतिमानैश्च कुम्भैश्च पेतुरुर्व्यां महाहवे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2169811, "chapter_id": 4629, "verse_number": "२१", "content_sanskrit": "विनेदुः संहतश्चान्ये नदन्तो भैरवान् रवान् ।\nबभ्रमुर्बहवो राजंश्चुक्रुशुश्च तथापरे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2169812, "chapter_id": 4629, "verse_number": "२२", "content_sanskrit": "हयाश्च निहता बाणैः स्वर्णभाण्डपरिच्छदाः ।\nविनेदुश्चैव पेतुश्च बभ्रमुश्च दिशो दश\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2169813, "chapter_id": 4629, "verse_number": "२३", "content_sanskrit": "अपरे क्लिश्यमानाश्च विवेष्टन्तो महीतळे ।\nभावान् बहुविधांश्चक्रुस्ताडिताः शरतोमरैः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2169814, "chapter_id": 4629, "verse_number": "२४", "content_sanskrit": "नरास्तु निहता भूमौ कूजन्तस्तत्र मारिष ।\nदृष्ट्वा च बान्धवानन्ये पितॄनन्ये पितामहान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2169815, "chapter_id": 4629, "verse_number": "२५", "content_sanskrit": "धावमानान् परांश्चैव दृष्ट्वान्ये तत्र भारत ।\nगोत्रनामानि ख्यातानि शशंसुरितरेतरम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2169816, "chapter_id": 4629, "verse_number": "२६", "content_sanskrit": "तेषां छिन्ना महाराज भुजाः कनकभूषणाः ।\nउद्वेष्टन्ते विवेष्टन्ते पतन्ते चोत्पतन्ति च\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2169817, "chapter_id": 4629, "verse_number": "२७", "content_sanskrit": "निपतन्ति तथा भूमौ स्फुरन्ति च सहस्रशः ।\nवेगांश्चान्ये रणे चक्रुः स्फुरन्त इव पन्नगाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2169818, "chapter_id": 4629, "verse_number": "२८", "content_sanskrit": "ते भुजा भोगिभोगाभाश्चन्दनाक्ता विशाम्पते ।\nलोहितार्द्रा भृशं रेजुस्तपनीयध्वजा इव\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2169819, "chapter_id": 4629, "verse_number": "२९", "content_sanskrit": "वर्तमाने तथा घोरे सङ्कुले सर्वतोदिशम् ।\nअविज्ञाताः स्म युध्यन्ते विनिघ्नन्तः परस्परम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2169820, "chapter_id": 4629, "verse_number": "३०", "content_sanskrit": "भौमेन रजसा कीर्णे शस्त्रसम्पातसङ्कुले ।\nनैव स्वे न परे राजन् व्यज्ञायन्त तमोवृते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2169821, "chapter_id": 4629, "verse_number": "३१", "content_sanskrit": "तथा तदभवद्युद्धं घोररूपं भयानकम् ।\nशोणितोदा महानद्यः प्रसस्रुस्तत्र चासकृत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2169822, "chapter_id": 4629, "verse_number": "३२", "content_sanskrit": "शीर्षपाषाणसञ्छन्नाः केशशैवलशाद्वलाः ।\nअस्थिमीनसमाकीर्णा धनुश्शरगदोडुपाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2169823, "chapter_id": 4629, "verse_number": "३३", "content_sanskrit": "मांसशोणितपङ्किन्यो शोणितौघाः सुदारुणाः ।\nनदीः प्रवर्तयामासुर्यमराष्ट्रविवर्धनीः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2169824, "chapter_id": 4629, "verse_number": "३४", "content_sanskrit": "भीरुवित्रासकारिण्यः शूराणां हर्षवर्धनाः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2169825, "chapter_id": 4629, "verse_number": "३५", "content_sanskrit": "ता नद्यो घोररूपाश्च नयन्त्यो यमसादनम् ।\nअवगाढा मज्जयन्त्यः क्षत्रस्याजनयन् भयम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2169826, "chapter_id": 4629, "verse_number": "३६", "content_sanskrit": "क्रव्यादानां नरव्याघ्र नर्दतां तत्र तत्र ह ।\nघोरमायोधनं जज्ञे प्रेतराजपुरोपमम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2169827, "chapter_id": 4629, "verse_number": "३७", "content_sanskrit": "उत्थितान्यगणेयानि कबन्धानि समन्ततः ।\nनृत्यन्ति वै भूतगणाः सन्तृप्ता मांसशोणितैः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2169828, "chapter_id": 4629, "verse_number": "३८", "content_sanskrit": "पीत्वा च शोणितं तत्र वसां पीत्वा च भारत ।\nमेदोमज्जावसातृप्तास्तृप्ता मांसस्य चैव हि\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2169829, "chapter_id": 4629, "verse_number": "३९", "content_sanskrit": "धावमानाश्च दृश्यन्ते काकगृध्रबकास्तथा\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2169830, "chapter_id": 4629, "verse_number": "४०", "content_sanskrit": "शूरास्तु समरे राजन् भयं त्यक्त्वा सुदुस्त्यजम् ।\nयोधव्रतं समास्थाय चक्रुः कर्माण्यभीतवत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2169831, "chapter_id": 4629, "verse_number": "४१", "content_sanskrit": "शरशक्तिसमाकीर्णे क्रव्यादगणसङ्कुले ।\nव्यचरन्त रणे शूराः ख्यापयन्तः स्वपौरुषम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2169832, "chapter_id": 4629, "verse_number": "४२", "content_sanskrit": "अन्योन्यं श्रावयन्ति स्म नामगोत्राणि भारत ।\nपितृनामानि च रणे गोत्रनामानि चाभितः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2169833, "chapter_id": 4629, "verse_number": "४३", "content_sanskrit": "श्रावयन्तो हि बहवस्तत्र योधा विशाम्पते ।\nअन्योन्यं समरे घ्नन्ति शक्तितोमरपट्टिशैः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2169834, "chapter_id": 4629, "verse_number": "४४", "content_sanskrit": "वर्तमाने तदा युद्धे घोररूपे सुदारुणे ।\nव्यषीदत् कौरवी सेना भिन्ना नौरिव सागरे\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2169835, "chapter_id": 4629, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nसङ्कुलयुद्धे एकोनपञ्चाशोऽध्यायः ॥४९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]