[{"id": 2017360, "chapter_id": 1361, "verse_number": "२-१०२-१", "content_sanskrit": "वैशम्पायन उवाच॥\nतमागतमथो राजा विदुरं दीर्घदर्शिनम्।\nसाशङ्क इव प्रपच्छ धृतराष्टोऽम्बिकासुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2017361, "chapter_id": 1361, "verse_number": "२-१०२-२", "content_sanskrit": "कथं गच्छति कौन्तेयो धर्मपुत्रो युधिष्ठिरः।\nभीमसेनः सव्यसाची माद्रीपुत्री च पाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2017362, "chapter_id": 1361, "verse_number": "२-१०२-३", "content_sanskrit": "धौम्यश्चैव कथं क्षत्तर्द्रौपदी च यशस्विनी।\nश्रोतुमिच्छाम्यहं सर्वं तेषां शंस विचेष्टितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2017363, "chapter_id": 1361, "verse_number": "२-१०२-४x", "content_sanskrit": "विदुर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2017364, "chapter_id": 1361, "verse_number": "२-१०२-४", "content_sanskrit": "वस्त्रेण संवृत्य मुखं कुन्तीपुत्रो युधिष्ठिरः।\nबाहू विशालौ सम्पश्यन्भीमो गच्छति पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2017365, "chapter_id": 1361, "verse_number": "२-१०२-५", "content_sanskrit": "सिकता वपन्सव्यसाची राजानमनुगच्छति।\nमाद्रीपुत्रः सहदेवो मुखमालिप्य गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2017366, "chapter_id": 1361, "verse_number": "२-१०२-६", "content_sanskrit": "पांसूपलिप्तसर्वाङ्गो नकुलश्चित्तविह्वलः।\nदर्शनीयतमो लोके राजानमनुगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2017367, "chapter_id": 1361, "verse_number": "२-१०२-७", "content_sanskrit": "कृष्णा तु केशैः प्रच्छाद्य मुखमायतलोचना।\nदर्शनीया प्ररुदती राजानमनुगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2017368, "chapter_id": 1361, "verse_number": "२-१०२-८", "content_sanskrit": "धौम्यो रौद्राणि सामानि याम्यानि च विशाम्पते।\nगायन्गच्छति मार्गेषु कुशानादाय पाणिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2017369, "chapter_id": 1361, "verse_number": "२-१०२-९x", "content_sanskrit": "धृतराष्ट्र उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2017370, "chapter_id": 1361, "verse_number": "२-१०२-९", "content_sanskrit": "विविधानीह रूपाणि कृत्वा गच्छन्ति पाण्डवाः।\nतन्ममाचक्ष्व विदुर कस्मादेवं व्रजन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2017371, "chapter_id": 1361, "verse_number": "२-१०२-१०x", "content_sanskrit": "विदुर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2017372, "chapter_id": 1361, "verse_number": "२-१०२-१०", "content_sanskrit": "निकृतस्यापि ते पुत्रैर्हृते राज्ये धनेषु च।\nन धर्माच्चलते बुद्धिर्धर्मराजस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2017373, "chapter_id": 1361, "verse_number": "२-१०२-११", "content_sanskrit": "योऽसौ राजा घृणी नित्यं धार्तराष्ट्रेषु भारत।\nनिकृत्या भ्रंशितः क्रोधान्नोन्मीलयति लोचने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2017374, "chapter_id": 1361, "verse_number": "२-१०२-१२", "content_sanskrit": "नाहं जनं निर्दहेयं दृष्ट्वा घोरेण चक्षुषा।\nस पिधाय मुखं राजा तस्माद्गच्छति पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2017375, "chapter_id": 1361, "verse_number": "२-१०२-१३", "content_sanskrit": "यथा च भीमो व्रजति निगदतः शृणु।\nबाह्वोर्बले नास्ति समो ममेति भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2017376, "chapter_id": 1361, "verse_number": "२-१०२-१४", "content_sanskrit": "बाहू विशालौ कृत्वाऽसौ तेन भीमोपि गच्छति।\nबाहू विदर्शयन्राजन्बाहुद्रविणदर्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2017377, "chapter_id": 1361, "verse_number": "२-१०२-१५", "content_sanskrit": "चिकीर्षन्कर्म शत्रुभ्यो बाहुद्रव्यानुरूपतः।\nप्रदिशञ्शरसम्पातान्कुन्तीपुत्रोऽर्जुनस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2017378, "chapter_id": 1361, "verse_number": "२-१०२-१६", "content_sanskrit": "सिकता वपन्सव्यसाची राजानमनुगच्छति।\nअसक्ताः सिकतास्तस्य यथा सम्प्रति भारत।\nअसक्तं शरवर्षाणि तथा मोक्ष्यति शत्रुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2017379, "chapter_id": 1361, "verse_number": "२-१०२-१७", "content_sanskrit": "न मे कश्चिद्विजानीयान्मुखमद्येति भारत।\nमुखमालिप्य तेनासौ सहदेवोऽपि गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2017380, "chapter_id": 1361, "verse_number": "२-१०२-१८", "content_sanskrit": "नाहं मनांस्याददेयं मार्गे स्त्रीणामिति प्रभो।\nपांसूपलिप्तसर्वाङ्गो नकुलस्तेन गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2017381, "chapter_id": 1361, "verse_number": "२-१०२-१९", "content_sanskrit": "एकवस्त्रा प्ररुदती मुक्तकेशी रजस्वला।\nशोणितेनाक्तवसना द्रौपदी वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2017382, "chapter_id": 1361, "verse_number": "२-१०२-२०", "content_sanskrit": "यत्कृतेऽहमिदं प्राप्ता तेषां वर्षे चतुर्दशे।\nहतपत्यो हतसुता हतबन्धुजनप्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2017383, "chapter_id": 1361, "verse_number": "२-१०२-२१", "content_sanskrit": "बन्धुशोणितदिग्धाङ्ग्यो मुक्तकेश्यो रजस्वलाः।\nएवं कृतोदका भार्याः प्रवेक्ष्यन्ति गजाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2017384, "chapter_id": 1361, "verse_number": "२-१०२-२२", "content_sanskrit": "कृत्वा तु नैर्ऋतान्दर्भान्धीरो धौम्यः पुरोहितः।\nसामानि गायन्याम्यानि पुरतो याति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2017385, "chapter_id": 1361, "verse_number": "२-१०२-२३", "content_sanskrit": "हतेषु भरतेष्वाजौ कुरूणां गुरवस्तदा।\nएवं सामानि -- न्तीत्युक्त्वा धौम्योपि गच्छति ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2017386, "chapter_id": 1361, "verse_number": "२-१०२-२४", "content_sanskrit": "प्रस्थाप्य पाण्डवाञ्शेषान्निः शेषस्ते भविष्यति।\nइति धौम्यो व्यवसितो रौद्रसामानि गायति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2017387, "chapter_id": 1361, "verse_number": "२-१०२-२५x", "content_sanskrit": "धृतराष्ट्र उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2017388, "chapter_id": 1361, "verse_number": "२-१०२-२५", "content_sanskrit": "किमब्रुवन्नैकृतिकः किं वा नागरिका जनाः।\nतथ्येन मे समाचक्ष्व क्षत्तः सर्वमशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2017389, "chapter_id": 1361, "verse_number": "२-१०२-२६x", "content_sanskrit": "विदुर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2017390, "chapter_id": 1361, "verse_number": "२-१०२-२६", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्रा येऽन्ये वदन्त्यथ।\nतच्छृणुष्व महाराज वक्ष्यते च मया तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2017391, "chapter_id": 1361, "verse_number": "२-१०२-२७x", "content_sanskrit": "प्रकृतय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2017392, "chapter_id": 1361, "verse_number": "२-१०२-२७", "content_sanskrit": "हाहा गच्छन्ति नो नाथाः समवेक्षध्वमीदृशम्।\nअहो धिक्कुरुवृद्धानां बालानामिव चेष्टितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2017393, "chapter_id": 1361, "verse_number": "२-१०२-२८", "content_sanskrit": "राष्ट्रेभ्यः पाण्डुदायादाँल्लोभान्निर्वासयन्ति ये।\nअनाथाः स्म वयं सर्वे वियुक्ताः पाण्डुनन्दनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2017394, "chapter_id": 1361, "verse_number": "२-१०२-२९", "content_sanskrit": "दुर्विनीतेषु लुब्धेषु का प्रीतिः कौरवेषु नः।\nइति पौराः सुदुः खार्ताः क्रोशन्ति स्म पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2017395, "chapter_id": 1361, "verse_number": "२-१०२-३०", "content_sanskrit": "एवमाकारलिङ्गैस्ते व्यवसायं मनोगतम्।\nकथयन्तश्च कौन्तेया वनं जग्मुर्मनस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2017396, "chapter_id": 1361, "verse_number": "२-१०२-३१", "content_sanskrit": "एवं तेषु नराग्र्येषु निर्यत्सु गजसाह्वयात्।\nअनभ्रे विद्युतश्चासन्भूमिश्च समकम्पत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2017397, "chapter_id": 1361, "verse_number": "२-१०२-३२", "content_sanskrit": "राहुरग्रसदादित्यमपर्वणि विशाम्पते।\nउल्का चाप्यपसव्येन पुरं कृत्वा व्यशीर्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2017398, "chapter_id": 1361, "verse_number": "२-१०२-३३", "content_sanskrit": "प्रत्याहरन्ति क्रव्यादा गृध्रगोमायुवायसाः।\nदेवायतनचैत्येषु प्राकाराट्टालकेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2017399, "chapter_id": 1361, "verse_number": "२-१०२-३४", "content_sanskrit": "एवमेते महोत्पाताः प्रादुरासन्दुरासदाः।\nभरतानामभावाय राजन्दुर्मन्त्रिते तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2017400, "chapter_id": 1361, "verse_number": "२-१०२-३५x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2017401, "chapter_id": 1361, "verse_number": "२-१०२-३५", "content_sanskrit": "एवं प्रवदतोरेव तयोस्तत्र विशाम्पते।\nधृतराष्ट्रस्य राज्ञश्च विदुरस्य च धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2017402, "chapter_id": 1361, "verse_number": "२-१०२-३६", "content_sanskrit": "नारदश्च सभामध्ये कुरूणामग्रतः स्थितः।\nमहर्षिभिः परिवृतो रौद्रं वाक्यमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2017403, "chapter_id": 1361, "verse_number": "२-१०२-३७", "content_sanskrit": "इतश्चतुर्दशे वर्षे विङ्क्ष्यन्तीह कौरवाः।\nदुर्योधनापराधेन भीमार्जुनबलेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2017404, "chapter_id": 1361, "verse_number": "२-१०२-३८", "content_sanskrit": "इत्युक्त्वा दिवमाक्रम्य क्षिप्रमन्तरधीयत।\nब्राह्मीं श्रियं सुविपुलां बिभ्रद्देवर्षिसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2017405, "chapter_id": 1361, "verse_number": "२-१०२-३९", "content_sanskrit": "ततो दुर्योधनः कर्णः शकुनिश्चापि सौबलः।\nद्रोणं द्वीपममन्यन्त राज्यं चास्मै न्यवेदयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2017406, "chapter_id": 1361, "verse_number": "२-१०२-४०", "content_sanskrit": "अथाब्रवीत्ततो द्रोणो दुर्योधनममर्षणम्।\nदुःशासनं च कर्णं च सर्वानेव च भारतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2017407, "chapter_id": 1361, "verse_number": "२-१०२-४१", "content_sanskrit": "अवध्यान्पाण्डवान्प्राहुर्देवपुत्रान्द्विजातयः।\nअहं चै शरणं प्राप्तान्वर्तमानो यथाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2017408, "chapter_id": 1361, "verse_number": "२-१०२-४२", "content_sanskrit": "गन्ता सर्वात्मना भक्त्या धार्तराष्ट्रान्सराजकान्।\nनोत्सहेयं परित्यक्तुं दैवं हि बलवत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2017409, "chapter_id": 1361, "verse_number": "२-१०२-४३", "content_sanskrit": "धर्मतः पाण्डुपुत्रा वै वनं गच्छन्ति निर्जिताः।\nते च द्वादश वर्षाणि वने वत्स्यन्ति पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2017410, "chapter_id": 1361, "verse_number": "२-१०२-४४", "content_sanskrit": "चरितब्रह्मचर्याश्च क्रोधामर्षवशानुगाः।\nवैरं निर्यातयिष्यन्ति महद्दुःखाय पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2017411, "chapter_id": 1361, "verse_number": "२-१०२-४५", "content_sanskrit": "मया च भ्रंशितो राजन्द्रुपदः सखिविग्रहे।\nपुत्रार्थमयजद्राजा वधाय मम भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2017412, "chapter_id": 1361, "verse_number": "२-१०२-४६", "content_sanskrit": "याजोपयाजतपसा पुत्रं लेभे स पावकात्।\nधृष्टद्युम्नं द्रौपदीं च वेदीमध्यात्सुमध्यमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2017413, "chapter_id": 1361, "verse_number": "२-१०२-४७", "content_sanskrit": "धृष्टद्युम्नस्तु पार्थानां स्यालः सम्बन्धतो मतः।\nपाण्डवानां प्रियरतस्तस्मान्मां भयमाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2017414, "chapter_id": 1361, "verse_number": "२-१०२-४८", "content_sanskrit": "ज्वालावर्णो देवदत्तो धनुष्मान्कवची शरी।\nमर्त्यधर्मतया तस्मादद्य मे साध्वसो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2017415, "chapter_id": 1361, "verse_number": "२-१०२-४९", "content_sanskrit": "गतो हि पक्षतां तेषां पार्षतः परवीरहा।\nरथातिरथसङ्ख्यायां योऽग्रणीरर्जुनो युवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2017416, "chapter_id": 1361, "verse_number": "२-१०२-५०", "content_sanskrit": "सृष्टप्राणो भृशतरं तेन चेत्सङ्गमो मम।\nकिमन्यद्दुःखमधिकं परमं भुवि कौरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2017417, "chapter_id": 1361, "verse_number": "२-१०२-५१", "content_sanskrit": "धृष्टद्युम्नो द्रोणमृत्युरिति विप्रथितं वचः।\nमद्वधायाश्रितोऽप्येष लोके चाप्यतिविश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2017418, "chapter_id": 1361, "verse_number": "२-१०२-५२", "content_sanskrit": "सोऽयं नूनमनुप्राप्तस्त्वत्कृते कालपर्ययः।\nत्वरितं कुरुत श्रेयो नैतदेतावता कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2017419, "chapter_id": 1361, "verse_number": "२-१०२-५३", "content_sanskrit": "मुहूर्तं सुखमेवैतत्तालच्छायेव हैमनी।\nजयध्वं च महायज्ञैर्भोगानश्नीत दत्त च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2017420, "chapter_id": 1361, "verse_number": "२-१०२-५४", "content_sanskrit": "इतश्चतुर्दशे वर्षे महत्प्राप्स्यथ वैशसम्।\nदुर्योधन निशम्यैतत्प्रतिपद्य यथेच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2017421, "chapter_id": 1361, "verse_number": "२-१०२-५५", "content_sanskrit": "शमं वा पाण्डुपुत्रेण प्रयुङ्क्ष्व यदि मन्यसे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2017422, "chapter_id": 1361, "verse_number": "२-१०२-५५x", "content_sanskrit": "वैशम्पायन उवाच॥\nद्रोणस्य --चनं श्रुत्वा धृतराष्ट्रोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2017423, "chapter_id": 1361, "verse_number": "२-१०२-५६", "content_sanskrit": "सम्यगाह गुरुः क्षत्तरुपावर्तय पाण्डवान्।\nयदि ते न निवर्तन्ते सत्कृता यान्तु पाण्डवाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2017424, "chapter_id": 1361, "verse_number": "२-१०२-५७", "content_sanskrit": "सशस्त्ररथपादाता भोगवन्तश्च पुत्रकाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2017425, "chapter_id": 1361, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अनुद्यतपर्वणि द्व्यधिकशततमोऽध्यायः॥ १०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]