[{"id": 2115757, "chapter_id": 3490, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115758, "chapter_id": 3490, "verse_number": "१", "content_sanskrit": "श्रुत्वा जतुगृहे वृत्तं ब्राह्मणाः सपुरोहिताः ।\nपाञ्चालराजं द्रुपदमिदं वचनमब्रुवन्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115759, "chapter_id": 3490, "verse_number": "२", "content_sanskrit": "धार्तराष्ट्राः सहामात्या मन्त्रयित्वा परस्परम् ।\nपाण्डवानां विनाशाय मतिं चक्रुः सुदुष्कराम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115760, "chapter_id": 3490, "verse_number": "३", "content_sanskrit": "दुर्योधनेन प्रहितः पुरोचन इति श्रुतः ।\nवारणावतमासाद्य कृत्वा जतुगृहं महत् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115761, "chapter_id": 3490, "verse_number": "४", "content_sanskrit": "तस्मिन् गृहे सुविश्वस्तान् पाण्डवान् पृथया सह ।\nअर्धरात्रे महाराज दग्धवान् स पुरोचनः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115762, "chapter_id": 3490, "verse_number": "५", "content_sanskrit": "अग्निना तु स्वयमपि दग्धः क्षुद्रो नृशंसवत् ।\nएतच्छ्रुत्वा सुसंहृष्टो धार्तराष्ट्रः सबान्धवः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115763, "chapter_id": 3490, "verse_number": "६", "content_sanskrit": "श्रुत्वा तु पाण्डवान् दग्धान् धृतराष्ट्रोऽम्बिकासुतः ।\nअल्पशोकः प्रहृष्टात्मा शशास विदुरं तदा \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115764, "chapter_id": 3490, "verse_number": "७", "content_sanskrit": "पाण्डवानां महाप्राज्ञ कुरु पिण्डोदकक्रियाम् ।\nअद्य पाण्डुर्हतः क्षत्तः पाण्डवानां विनाशने \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115765, "chapter_id": 3490, "verse_number": "८", "content_sanskrit": "तस्माद् भागीरथीं गत्वा कुरु पिण्डोदकक्रियाम् ।\nअहो विधिवशादेव गतास्ते यमसादनम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115766, "chapter_id": 3490, "verse_number": "९", "content_sanskrit": "इत्युक्त्वा प्रारुदत् तत्र धृतराष्ट्रः ससौबलः ।\nश्रुत्वा भीष्मोऽपि विदुरात् कृतवानौर्ध्वदेहिकम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115767, "chapter_id": 3490, "verse_number": "१०", "content_sanskrit": "पाण्डवानां विनाशाय कृतं कर्म दुरात्मना ।\nएतत्कार्यस्य कर्ता तु न दृष्टो न श्रुतः पुरा \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115768, "chapter_id": 3490, "verse_number": "११", "content_sanskrit": "एतद्वृत्तं महाभाग पाण्डवान् प्रति नः श्रुतम् ।\nश्रुत्वा तु वचनं तेषां यज्ञसेनो महामतिः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115769, "chapter_id": 3490, "verse_number": "१२", "content_sanskrit": "यथा स जनकः शोचेदौरसस्य विनाशने ।\nतथाऽतप्यत पाञ्चालः पाण्डवानां विनाशने \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115770, "chapter_id": 3490, "verse_number": "१३", "content_sanskrit": "समाहूय प्रकृतयः सहिताः सहबान्धवैः ।\nकारुण्यादेव पाञ्चालः प्रोवाचेदं वचस्तदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115771, "chapter_id": 3490, "verse_number": "", "content_sanskrit": "द्रुपदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115772, "chapter_id": 3490, "verse_number": "१४", "content_sanskrit": "अहो रूपमहो धैर्यमहो वीर्यं च शिक्षितम् ।\nचिन्तयामि दिवारात्रमर्जुनं प्रति बान्धवाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115773, "chapter_id": 3490, "verse_number": "१५", "content_sanskrit": "भ्रातृभिः सहितो मात्रा सोऽदह्यत हुताशने ।\nकिमाश्चर्यमितो लोके कालो हि दुरतिक्रमः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115774, "chapter_id": 3490, "verse_number": "१६", "content_sanskrit": "मिथ्याप्रतिज्ञो लोकेषु किं वदिष्यामि साम्प्रतम् ।\nअन्तर्गतेन दुःखेन दह्यमानो दिवानिशम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115775, "chapter_id": 3490, "verse_number": "१७", "content_sanskrit": "याजोपयाजौ सत्कृत्य याचितौ तौ मयाऽनघौ ।\nभारद्वाजस्य हन्तारं देवीं चापि तथाऽर्जुने \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115776, "chapter_id": 3490, "verse_number": "१८", "content_sanskrit": "लोकस्तद्वेद यच्चैव तथा याजेन मे श्रुतम् ।\nयाजेन पुत्रकामीयं हुत्वा चोत्पादितावुभौ \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115777, "chapter_id": 3490, "verse_number": "१९", "content_sanskrit": "धृष्टद्युम्नश्च कृष्णा च मम पुष्टिकरावुभौ ।\nकिं करिष्यामि ते नष्टाः पाण्डवाः पृथया सह \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115778, "chapter_id": 3490, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115779, "chapter_id": 3490, "verse_number": "२०", "content_sanskrit": "इत्येवमुक्त्वा पाञ्चालः शुशोच परमातुरः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115780, "chapter_id": 3490, "verse_number": "१६९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकोनसप्तत्यधिकशततमोऽध्यायः ॥१६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115781, "chapter_id": 3490, "verse_number": "२", "content_sanskrit": "॥ इति चैत्ररथपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115782, "chapter_id": 3490, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]