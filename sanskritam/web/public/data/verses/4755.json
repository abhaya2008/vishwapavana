[{"id": 2177790, "chapter_id": 4755, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177791, "chapter_id": 4755, "verse_number": "१", "content_sanskrit": "हतेषु सर्वसैन्येषु सौप्तिके तै रथैस्त्रिभिः ।\nशोचमानोऽब्रवीद् राजा पाण्डवो यदुनन्दनम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177792, "chapter_id": 4755, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177793, "chapter_id": 4755, "verse_number": "२", "content_sanskrit": "कथं नु कृष्ण पापेन क्षुद्रेण शठबुद्धिना ।\nद्रौणिना निहताः सर्वे मम पुत्रा महारथाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177794, "chapter_id": 4755, "verse_number": "३", "content_sanskrit": "तथा कृतास्त्रविक्रान्ताः सङ्ग्रामेष्वपलायिनः ।\nद्रुपदस्यात्मजाः सर्वे द्रौणिना निहताः कथम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177795, "chapter_id": 4755, "verse_number": "४", "content_sanskrit": "यस्य द्रोणो महेष्वासो न प्रादादाहवे मुखम् ।\nनिजघ्ने रथिनां श्रेष्ठं धृष्टद्युम्नं कथं नु सः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177796, "chapter_id": 4755, "verse_number": "५", "content_sanskrit": "किं नु तेन कृतं कर्म तथायुक्तं नरर्षभ ।\nयदेकः समरे सर्वान् अवधीद् वै गुरोः सुतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177797, "chapter_id": 4755, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177798, "chapter_id": 4755, "verse_number": "६", "content_sanskrit": "नूनं स देवदेवानामीश्वरेश्वरमव्ययम् ।\nजगाम शरणं द्रौणिरेकस्तेनावधीद् बहून्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177799, "chapter_id": 4755, "verse_number": "७", "content_sanskrit": "प्रसन्नो हि महादेवो दद्यादमरतामपि ।\nवीर्यं हि गिरिशो दद्याद् येनेन्द्रमपि शातयेत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177800, "chapter_id": 4755, "verse_number": "८", "content_sanskrit": "वेदाहं हि महादेवं तत्त्वेन भरतर्षभ ।\nयानि चास्य पुराणानि कर्माणि विविधानि च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177801, "chapter_id": 4755, "verse_number": "९", "content_sanskrit": "आदिरेष हि भूतानां मध्यमन्तश्च भारत ।\nविचेष्टते जगच्चेदं सर्वमस्यैव कर्मणा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177802, "chapter_id": 4755, "verse_number": "१०", "content_sanskrit": "एवं सिसृक्षुर्भूतानि ददर्श प्रथमं विभुः ।\nपितामहोऽब्रवीच्चैनं भूतानि सृज माचिरम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177803, "chapter_id": 4755, "verse_number": "११", "content_sanskrit": "हरिकेशस्तथेत्युक्त्वा दीर्घदर्शी तदा प्रभुः ।\nदीर्घकालं तपस्तेपे मग्नोऽम्भसि महातपाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177804, "chapter_id": 4755, "verse_number": "१२", "content_sanskrit": "सुमहान्तं ततः कालं प्रतीक्ष्यैनं पितामहः ।\nस्रष्टारं सर्वभूतानां ससर्ज मनसाऽपरम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177805, "chapter_id": 4755, "verse_number": "१३", "content_sanskrit": "सोऽब्रवीद् भ्रातरं दृष्ट्वा गिरिशं सुप्तमम्भसि ।\nयदि मे नाग्रजोऽस्त्यन्यस्ततः स्रक्ष्याम्यहं प्रजाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177806, "chapter_id": 4755, "verse_number": "१४", "content_sanskrit": "तमब्रवीत् पिता नास्ति त्वदन्यः पुरुषोऽग्रजः ।\nस्थाणुरेष जले मग्नो विस्रब्धः कुरु वै प्रजाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177807, "chapter_id": 4755, "verse_number": "१५", "content_sanskrit": "स सर्वभूतान्यसृजद् सप्त दक्षादींस्तु प्रजापतीन् ।\nयैरिमं व्यकरोत् सर्वं भूतग्रामं चतुर्विधम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177808, "chapter_id": 4755, "verse_number": "१६", "content_sanskrit": "ताः सृष्टमात्राः क्षुधिताः प्रजाः सर्वाः प्रजापतिम् ।\nबिभक्षयिषवो राजन् सहसाऽभ्यद्रवंस्तदा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177809, "chapter_id": 4755, "verse_number": "१७", "content_sanskrit": "स भक्ष्यमाणः प्राणार्थी पितामहमुपाद्रवत् ।\nआभ्यो मां रक्षतु भवान् वृत्तिरासां विधीयताम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2177810, "chapter_id": 4755, "verse_number": "१८", "content_sanskrit": "ततस्ताभ्यो ददावन्नमोषधीः स्थावराणि च ।\nजङ्गमानि च भूतानि दुर्बलानि बलीयसाम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2177811, "chapter_id": 4755, "verse_number": "१९", "content_sanskrit": "विहितान्नाः प्रजास्तास्तु जग्मुस्तुष्टा यथागतम् ।\nततो ववृधिरे राजन् प्रीतिमत्यः स्वयोनिषु\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2177812, "chapter_id": 4755, "verse_number": "२०", "content_sanskrit": "भूतग्रामे विवृद्धे तु सृष्टे देवासुरे तदा ।\nउदतिष्ठज्जलाज्ज्येष्ठः प्रजाश्चेमा ददर्श सः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2177813, "chapter_id": 4755, "verse_number": "२१", "content_sanskrit": "बहुरूपाः प्रजाः सृष्टा विवृद्धाश्च स्वतेजसा ।\nचुक्रोध बलवद् दृष्टा लिङ्गं स्वं प्रत्यविध्यत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2177814, "chapter_id": 4755, "verse_number": "२२", "content_sanskrit": "तत् प्रविद्धं तथा भूमौ तथैव प्रत्यतिष्ठत ।\nतमुवाचाव्ययो ब्रह्मा वचोभिः शमयन्निव\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2177815, "chapter_id": 4755, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2177816, "chapter_id": 4755, "verse_number": "२३", "content_sanskrit": "किं कृतं सलिले शर्व चिरकालस्थितेन ते ।\nकिमर्थं चेदमुत्पाद्य लिङ्गं भूमौ प्रवेशितम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2177817, "chapter_id": 4755, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2177818, "chapter_id": 4755, "verse_number": "२४", "content_sanskrit": "सोऽब्रवीज्जातसंरम्भस्तथा लोकगुरुर्गुरुम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2177819, "chapter_id": 4755, "verse_number": "", "content_sanskrit": "रुद्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2177820, "chapter_id": 4755, "verse_number": "२५", "content_sanskrit": "सृष्टाः प्रजाः परेणेमाः किं करिष्याम्यनेन वै\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2177821, "chapter_id": 4755, "verse_number": "२६", "content_sanskrit": "तपसाधिगतत्वान्नः प्रजार्थं हि पितामह ।\nओषध्यः परिवर्धन्ते यथैवं सततं प्रजाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2177822, "chapter_id": 4755, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2177823, "chapter_id": 4755, "verse_number": "२७", "content_sanskrit": "एवमुक्त्वा स सक्रोधो जगाम विमना भवः ।\nगिरेर्मुञ्जवतः पादं तपस्तप्तुं महातपाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2177824, "chapter_id": 4755, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nऐषीकपर्वणि नवमोऽध्यायः ॥९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]