[{"id": 2201356, "chapter_id": 5289, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2201357, "chapter_id": 5289, "verse_number": "१", "content_sanskrit": "एवं तदा प्रयाचन्तं भास्करं मुनिसत्तमः ।\nजमदग्निर्महातेजाः किं कार्यं प्रत्यपद्यत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2201358, "chapter_id": 5289, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2201359, "chapter_id": 5289, "verse_number": "२", "content_sanskrit": "तथा प्रयाचमानस्य मुनिरग्निसमप्रभः ।\nजमदग्निः शमं नैव जगाम कुरुनन्दन\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2201360, "chapter_id": 5289, "verse_number": "३", "content_sanskrit": "ततः सूर्यो मधुरया वाचा तमिदमब्रवीत् ।\nकृताञ्जलिर्विप्ररूपी प्रणम्येदं विशाम्पते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2201361, "chapter_id": 5289, "verse_number": "४", "content_sanskrit": "चलं निमित्तं विप्रर्षे सदा सूर्यस्य गच्छतः ।\nकथं चलं वेत्स्यसि त्वं सदा यान्तं दिवाकरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2201362, "chapter_id": 5289, "verse_number": "", "content_sanskrit": "जमदग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2201363, "chapter_id": 5289, "verse_number": "५", "content_sanskrit": "स्थिरं वापि चलं वापि जाने त्वां ज्ञानचक्षुषा ।\nअवश्यं विनयाधानं कार्यमद्य मया तव\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2201364, "chapter_id": 5289, "verse_number": "६", "content_sanskrit": "अपराह्णे निमेषार्धं तिष्ठसि त्वं दिवाकर ।\nतत्र वेत्स्यामि सूर्य त्वां न मेऽत्रास्ति विचारणा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2201365, "chapter_id": 5289, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2201366, "chapter_id": 5289, "verse_number": "७", "content_sanskrit": "असंशयं मां विप्रर्षे वेत्स्यसे धन्विनांवर ।\nअपकारिणं तु मां विद्धि भगवन् शरणागतम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2201367, "chapter_id": 5289, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2201368, "chapter_id": 5289, "verse_number": "८", "content_sanskrit": "ततः प्रहँस्य भगवान् जमदग्निरुवाच तम् ।\nन भीः सूर्य त्वया कार्या प्रणिपातगतो ह्यसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2201369, "chapter_id": 5289, "verse_number": "९", "content_sanskrit": "ब्राह्मणेष्वार्जवं यच्च स्थैर्यं च धरणीतळे ।\nसौम्यतां चैव सोमस्य गाम्भीर्यं वरुणस्य च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2201370, "chapter_id": 5289, "verse_number": "१०", "content_sanskrit": "दीप्तिमग्नेः प्रभां मेरोः प्रतापं तपनस्य च ।\nएतान्यतिक्रमेद् यो वै स हन्याच्छरणागतम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2201371, "chapter_id": 5289, "verse_number": "११", "content_sanskrit": "भवेत् स गुरुतल्पी च ब्रह्महा च तथा भवेत् ।\nसुरापानं च कुर्यात् स यो हन्याच्छरणागतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2201372, "chapter_id": 5289, "verse_number": "१२", "content_sanskrit": "एतस्य त्वपनीतस्य समाधिं तात चिन्तय ।\nयथा सुखगमः पन्था भवेत् त्वद्रश्मितापितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2201373, "chapter_id": 5289, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2201374, "chapter_id": 5289, "verse_number": "१३", "content_sanskrit": "एतावदुक्त्वा स तदा तूष्णीमासीद् भृगूद्वहः ।\nअथ सूर्यो ददौ तस्मै छत्रोपानहमाशु वै\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2201375, "chapter_id": 5289, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2201376, "chapter_id": 5289, "verse_number": "१४", "content_sanskrit": "महर्षे शिरसस्त्राणं छत्रं मद्रश्मिवारणम् ।\nप्रतिगृह्णीष्व पद्भ्यां च त्राणार्थं चर्मपादुके\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2201377, "chapter_id": 5289, "verse_number": "१५", "content_sanskrit": "अद्यप्रभृति चैवैतल्लोके सम्प्रचरिष्यति ।\nपुण्यदानेषु सर्वेषु परमक्षय्यमेव च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2201378, "chapter_id": 5289, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2201379, "chapter_id": 5289, "verse_number": "१६", "content_sanskrit": "उपानच्छत्रमेतद् वै सूर्येणेह प्रवर्तितम् ।\nपुण्यमेतदभिख्यातं त्रिषु लोकेषु भारत\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2201380, "chapter_id": 5289, "verse_number": "१७", "content_sanskrit": "तस्मात् प्रयच्छ विप्रेभ्यश्छत्रोपानहमुत्तमम् ।\nधर्मस्ते सुमहान् भावी न मेऽत्रास्ति विचारणा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2201381, "chapter_id": 5289, "verse_number": "१८", "content_sanskrit": "छत्रं हि भरतश्रेष्ठ यः प्रदद्याद् द्विजातये ।\nशुभ्रं शतशलाकं वै स प्रेत्य सुखमेधते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2201382, "chapter_id": 5289, "verse_number": "१९", "content_sanskrit": "स शक्रलोके वसति पूज्यमानो द्विजातिभिः ।\nअप्सरोभिश्च सततं देवैश्च भरतर्षभ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2201383, "chapter_id": 5289, "verse_number": "२०", "content_sanskrit": "दह्यमानाय विप्राय यः प्रयच्छत्युपानहौ ।\nस्नातकाय महाबाहो संशिताय द्विजातये\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2201384, "chapter_id": 5289, "verse_number": "२१", "content_sanskrit": "सोऽपि लोकानवाप्नोति दैवतैरभिपूजितान् ।\nगोलोके स मुदा युक्तो वसति प्रेत्य भारत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2201385, "chapter_id": 5289, "verse_number": "२२", "content_sanskrit": "एतत्ते भरतश्रेष्ठ मया कार्त्स्न्येन कीर्तितम् ।\nछत्रोपानहदानस्य फलं भरतसत्तम ।\nसूर्येण विहितं पूर्वमृषये जमदग्नये\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2201386, "chapter_id": 5289, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे छत्रोपानहदानफलकथनं नाम चत्वारिंशोत्तरशततमोऽध्यायः ॥१४०॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]