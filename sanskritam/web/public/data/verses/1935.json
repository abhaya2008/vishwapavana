[{"id": 2042068, "chapter_id": 1935, "verse_number": "५-१८०-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042069, "chapter_id": 1935, "verse_number": "५-१८०-१", "content_sanskrit": "आत्मनस्तु ततः सूतो हयानां च विशांपते।\nमम चापनयामास शल्यान्कुशलसंमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042070, "chapter_id": 1935, "verse_number": "५-१८०-२", "content_sanskrit": "स्नातापवृत्तैस्तुरगैर्लब्धतोयैरविह्वलैः।\nप्रभाते चोदिते सूर्ये ततो युद्धमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042071, "chapter_id": 1935, "verse_number": "५-१८०-३", "content_sanskrit": "दृष्ट्वा भां तूर्णमायान्तं दंशितं स्यन्दने स्थितम्।\nअकरोद्रथमत्यर्थं रामः सज्जं प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042072, "chapter_id": 1935, "verse_number": "५-१८०-४", "content_sanskrit": "ततोऽहं राममायान्तं दृष्ट्वा समरकाङ्क्षिणम् ।\nधनुःश्रेष्ठं समित्सृज्य सहसावतरं रथात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042073, "chapter_id": 1935, "verse_number": "५-१८०-५", "content_sanskrit": "अभिवाद्य तथैवाहं रथमारुह्य भारत ।\nयुयुत्सुर्जामदग्न्यस्य प्रमुखे वीतभीः स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042074, "chapter_id": 1935, "verse_number": "५-१८०-६", "content_sanskrit": "ततोऽहं शरवर्षेण महता समवाकिरम् ।\nस च मां शरवर्षेण वर्षन्तं समवाकिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042075, "chapter_id": 1935, "verse_number": "५-१८०-७", "content_sanskrit": "संक्रुद्धो जामदग्न्यस्तु पुनरेव सुतेजितान् ।\nसंप्रैषीन्मे शरान्घोरान्दीप्तास्यानुरगानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042076, "chapter_id": 1935, "verse_number": "५-१८०-८", "content_sanskrit": "ततोऽहं निशितैर्भल्लैः शतशोऽथ सहस्रशः ।\nअच्छिदं सहसा राजन्नन्तरिक्षे पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042077, "chapter_id": 1935, "verse_number": "५-१८०-९", "content_sanskrit": "ततस्त्वस्त्राणि दिव्यानि जामदग्न्यः प्रतापवान् ।\nमयि प्रयोजयामास तान्यहं प्रत्यषेधयम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042078, "chapter_id": 1935, "verse_number": "५-१८०-१०", "content_sanskrit": "अस्त्रैरेव महाबाहो चिकीर्षन्नधिकां क्रियाम्।\nततो विदि महान्नादः प्रादुरासीत्समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042079, "chapter_id": 1935, "verse_number": "५-१८०-११", "content_sanskrit": "ततोऽहमस्त्रं वायव्यं जामदग्न्ये प्रयुक्तवान्।\nप्रत्याजघ्ने च तद्रामो गुह्यकास्त्रेण भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042080, "chapter_id": 1935, "verse_number": "५-१८०-१२", "content_sanskrit": "ततोऽहमस्त्रमाग्नेयमनुमन्त्र्य प्रयुक्तवान् ।\nवारुणेनैव तद्रामो वारयामास मे विभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042081, "chapter_id": 1935, "verse_number": "५-१८०-१३", "content_sanskrit": "एवमस्त्राणि दिव्यानि रामस्याहमवारयम् ।\nरामश्च मम तेजस्वी दिव्यास्त्रविदरिन्दमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042082, "chapter_id": 1935, "verse_number": "५-१८०-१४", "content_sanskrit": "ततो मां सव्यतो राजन्रामः कुर्वन्द्विजोत्तमः।\nउरस्यविध्यत्संक्रुद्धो जामदग्न्यः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042083, "chapter_id": 1935, "verse_number": "५-१८०-१५", "content_sanskrit": "ततोऽहं भारतश्रेष्ठ संन्यषीदं रथोत्तमे।\nततो मां कश्मलाविष्टं सूतस्तूर्णमुदावहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042084, "chapter_id": 1935, "verse_number": "५-१८०-१६", "content_sanskrit": "ग्लायन्तं भरश्रेष्ठ रामबाणप्रपीडितम् ।\nततो मामपयातं वै भृशं विद्धमचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042085, "chapter_id": 1935, "verse_number": "५-१८०-१७", "content_sanskrit": "रामस्यानुचरा हृष्टाः सर्वे दृष्ट्वा विचुक्रुशुः ।\nअकृतव्रणप्रभृतयः काशिकन्या च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042086, "chapter_id": 1935, "verse_number": "५-१८०-१८", "content_sanskrit": "ततस्तु लब्धसंज्ञोऽहं ज्ञात्वा सूतमथाब्रुवम् ।\nयाहि सूत यतो रामः सज्जोऽहं गतवेदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042087, "chapter_id": 1935, "verse_number": "५-१८०-१९", "content_sanskrit": "ततो मामवहत्सूतो हयैः परमशोभितैः ।\nनृत्यद्भिरिव कौरव्य मारुतप्रतिमैर्गतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042088, "chapter_id": 1935, "verse_number": "५-१८०-२०", "content_sanskrit": "ततोऽहं राममासाद्य बाणवर्षैश्च कौरव ।\nअवाकिरं सुसंरब्धः संरब्धं च जिगीषया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042089, "chapter_id": 1935, "verse_number": "५-१८०-२१", "content_sanskrit": "तानापतत एवासौ रामो बाणानजिह्मगान्।\nबाणैरेवाच्छिनत्तूर्णमेकैकं त्रिभिराहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042090, "chapter_id": 1935, "verse_number": "५-१८०-२२", "content_sanskrit": "ततस्ते सूदिताः सर्वे मम बाणाः सुसंशिताः ।\nरामबाणैर्द्विधा च्छिन्नाः शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042091, "chapter_id": 1935, "verse_number": "५-१८०-२३", "content_sanskrit": "ततः पुनः शरं दीप्तं सुप्रभं कालसंमितम् ।\nअसृजं जामदग्न्याय रामायाहं जिघांसया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042092, "chapter_id": 1935, "verse_number": "५-१८०-२४", "content_sanskrit": "तेन त्वभिहतो गाढं बाणवेगवशं गतः।\nमुमोह समरे रामो भूमौ च निपपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2042093, "chapter_id": 1935, "verse_number": "५-१८०-२५", "content_sanskrit": "ततो हाहाकृतं कसर्वं रामे भूतलमाश्रिते ।\nजगद्भारत संविग्नं यथार्कपतने भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2042094, "chapter_id": 1935, "verse_number": "५-१८०-२६", "content_sanskrit": "तत एनं समुद्विग्नाः सर्व एवाभिदुद्रुवुः ।\nतपोधनास्ते सहसा काश्या च कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2042095, "chapter_id": 1935, "verse_number": "५-१८०-२७", "content_sanskrit": "तत एनं परिष्वज्य शनैराश्वासयंस्तदा ।\nपाणिभिर्जलशीतैश्च जयाशीर्भिश्च कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2042096, "chapter_id": 1935, "verse_number": "५-१८०-२८", "content_sanskrit": "ततः स विह्वलं वाक्यं राम उत्थाय चाब्रवीत्।\nतिष्ठ भीष्म हतोऽसीति बाणं संधाय कार्मुके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2042097, "chapter_id": 1935, "verse_number": "५-१८०-२९", "content_sanskrit": "स मुक्तो न्यपतत्तूर्णं सव्ये पार्श्वे महाहवे ।\nयेनाहं भृशमुद्विग्रो व्याघूर्णित इव द्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2042098, "chapter_id": 1935, "verse_number": "५-१८०-३०", "content_sanskrit": "हत्वा हयांस्ततो रामः शीघ्रास्त्रेण महाहवे ।\nअवाकिरन्मां विस्रब्धो बाणैस्तैर्लोमवाहिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2042099, "chapter_id": 1935, "verse_number": "५-१८०-३१", "content_sanskrit": "ततोऽहमपि शीघ्रास्त्रं समरप्रतिवारणम् ।\nअवासृजं महाबाहो तेन्तराधिष्ठिताः शराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2042100, "chapter_id": 1935, "verse_number": "५-१८०-३२", "content_sanskrit": "रामस्य मम चैवाशु व्योमावृत्य समन्ततः।\nन स्म सूर्यः प्रतपति शरजालसमावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2042101, "chapter_id": 1935, "verse_number": "५-१८०-३३", "content_sanskrit": "मातरिश्वा ततस्तस्मिन्मेघरुद्ध इवाभवत् ।\nततो वायोः प्रकम्पाच्च सूर्यस्य च गभस्तिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2042102, "chapter_id": 1935, "verse_number": "५-१८०-३४", "content_sanskrit": "अभिघातप्रभावाच्च पावकः समजायत ।\nते शराः स्वसमुत्थेन प्रदीप्ताश्चित्रभानुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2042103, "chapter_id": 1935, "verse_number": "५-१८०-३५", "content_sanskrit": "भूमौ सर्वे तदा राजन्भस्मभूताः प्रपेदिरे ।\nतदा शतसहस्राणि प्रयुतान्यर्बुदानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2042104, "chapter_id": 1935, "verse_number": "५-१८०-३६", "content_sanskrit": "अयुतान्यथ खर्वाणि निखर्वाणि च कौरव ।\nरामः शराणां संक्रुद्धो मयि तूर्णं न्यपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2042105, "chapter_id": 1935, "verse_number": "५-१८०-३७", "content_sanskrit": "ततोऽहं तानपि रणे शरैराशीविषोपमैः ।\nसंछिद्य भूमौ नृपते पातयेयं नगानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2042106, "chapter_id": 1935, "verse_number": "५-१८०-३८", "content_sanskrit": "एवं तदभवद्युद्वं तदा भरतसत्तम ।\nसन्ध्याकाले व्यतीते तु व्यपायात्स च मे गुरुः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2042107, "chapter_id": 1935, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वणि अशीत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]