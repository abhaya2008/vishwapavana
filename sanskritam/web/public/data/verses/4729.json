[{"id": 2176191, "chapter_id": 4729, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2176192, "chapter_id": 4729, "verse_number": "१", "content_sanskrit": "तदा दुर्योधनो राजा दृष्ट्वा भीमं तथाऽऽगतम् ।\nप्रत्युद्ययावदीनात्मा वेगेन महता नदन्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2176193, "chapter_id": 4729, "verse_number": "२", "content_sanskrit": "समासेदतुरायत्तौ शृङ्गिणौ वृषभाविव ।\nमहानिर्घातघोषश्च सन्निपाते तयोरभूत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2176194, "chapter_id": 4729, "verse_number": "३", "content_sanskrit": "अभवच्च तयोर्युद्धं तुमुलं रोमहर्षणम् ।\nजिघृक्षतोर्यथाऽन्योन्यमिन्द्रप्रह्लादयोरिव\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2176195, "chapter_id": 4729, "verse_number": "४", "content_sanskrit": "रुधिरोक्षितसर्वाङ्गौ गदाहस्तौ मनस्विनौ ।\nददृशाते महात्मानौ सुपुष्पाविव किंशुकौ\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2176196, "chapter_id": 4729, "verse_number": "५", "content_sanskrit": "तदा तस्मिन् वर्तमाने गदायुद्धे सुदारुणे ।\nखद्योतसङ्घैरिव खं दर्शनीयं व्यरोचत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2176197, "chapter_id": 4729, "verse_number": "६", "content_sanskrit": "तस्मिंस्तदा वर्तमाने सङ्कुले दारुणे भृशम् ।\nउभावपि परिश्रान्तौ युध्यामानावरिन्दमौ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2176198, "chapter_id": 4729, "verse_number": "७", "content_sanskrit": "तौ मुहूर्तं समाश्वास्य पुनरेव परन्तपौ ।\nसम्प्रहारयतां चित्रे सम्प्रगृह्य गदे शुभे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2176199, "chapter_id": 4729, "verse_number": "८", "content_sanskrit": "तौ तु दृष्ट्वा महासत्त्वौ समाश्वस्तौ नराधिप ।\nबलिनौ वारणौ यद्वद् वाशितार्थे मदोत्कटौ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2176200, "chapter_id": 4729, "verse_number": "९", "content_sanskrit": "अपारवीर्यौ सम्प्रेक्ष्य प्रगृहीतगदौ दृढौ ।\nप्रहर्षं परमं जग्मुर्देवगन्धर्वदानवाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2176201, "chapter_id": 4729, "verse_number": "१०", "content_sanskrit": "प्रगृहीतगदौ दृष्ट्वा दुर्योधनवृकोदरौ ।\nसंशयः सर्वभूतानां विजये समपद्यत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2176202, "chapter_id": 4729, "verse_number": "११", "content_sanskrit": "समागम्य ततो भूयो भ्रातरौ बलिनां वरौ ।\nअन्योन्यस्यान्तरप्रेप्सू प्रचक्रातेऽन्तरं प्रति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2176203, "chapter_id": 4729, "verse_number": "१२", "content_sanskrit": "यमदण्डोपमां गुर्वीमिन्द्राशनिसमस्वनाम् ।\nददृशुः प्रेक्षका राजन् रौद्रीं विशसनीं गदाम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2176204, "chapter_id": 4729, "verse_number": "१३", "content_sanskrit": "अविद्ध्यतो गदां तस्य भीमसेनस्य शुष्मिणः ।\nशब्दः सुतुमुलो घोरो मुहूर्तं समपद्यत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2176205, "chapter_id": 4729, "verse_number": "१४", "content_sanskrit": "आविद्ध्यन्तमभिप्रेक्ष्य धार्तराष्ट्रोऽथ पाण्डवम् ।\nगदामलघुवेगां तां विस्मितः स बभूव ह\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2176206, "chapter_id": 4729, "verse_number": "१५", "content_sanskrit": "चरंश्च विविधान् मार्गान् मण्डलानि च भागशः ।\nअशोभत तदा वीरो भूय एव वृकोदरः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2176207, "chapter_id": 4729, "verse_number": "१६", "content_sanskrit": "तौ परस्परमासाद्य यत्तावन्योन्यरक्षणे ।\nमार्जाराविव भक्षार्थे वितस्थाते मुहुर्मुहुः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2176208, "chapter_id": 4729, "verse_number": "१७", "content_sanskrit": "अचरद् भीमसेनस्तु मार्गान् बहुविधान् रणे ।\nमण्डलानि विचित्राणि स्थानानि विविधानि च\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2176209, "chapter_id": 4729, "verse_number": "१८", "content_sanskrit": "गोमूत्रिकाणि चित्राणि गतप्रत्यागतानि च ।\nपरिमोक्षं प्रहाराणां वर्जनं परिधावनम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2176210, "chapter_id": 4729, "verse_number": "१९", "content_sanskrit": "अभिद्रवणमाक्षेपमवस्थानमवग्रहम् ।\nपरावृत्तं सुसंवृत्तमुपप्लुतमुपद्रुतम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2176211, "chapter_id": 4729, "verse_number": "२०", "content_sanskrit": "उपन्यस्तमपन्यस्तं गदायुद्धविशारदौ ।\nएवं तौ विचरन्तौ तु परस्परमविध्यताम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2176212, "chapter_id": 4729, "verse_number": "२१", "content_sanskrit": "वञ्चयन्तौ पुनश्चैव चेरतुः कुरुपाण्डवौ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2176213, "chapter_id": 4729, "verse_number": "२२", "content_sanskrit": "विक्रीडन्तौ सुबलिनौ मण्डलानि विचेरतुः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2176214, "chapter_id": 4729, "verse_number": "२३", "content_sanskrit": "गदाहस्तौ ततस्तौ तु मण्डलावस्थितौ युधि ।\nदक्षिणं मण्डलं राजन् धार्तराष्ट्रोऽभ्यवर्तत\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2176215, "chapter_id": 4729, "verse_number": "२४", "content_sanskrit": "वामं तु मण्डलं तत्र भीमसेनोऽभ्यवर्तत\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2176216, "chapter_id": 4729, "verse_number": "२५", "content_sanskrit": "तथा विचरतस्तस्य भीमस्य रणमूर्धनि ।\nदुर्योधनो महाराज पार्श्वदेशेऽभ्यताडयत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2176217, "chapter_id": 4729, "verse_number": "२६", "content_sanskrit": "आहतस्तु ततो भीमः तव पुत्रेण भारत ।\nआविध्यत गदां गुर्वीं प्रहारं तमचिन्तयन्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2176218, "chapter_id": 4729, "verse_number": "२७", "content_sanskrit": "इन्द्राशनिसमां घोरां यमदण्डमिवोद्यताम् ।\nददृशुस्ते महाराज भीमसेनस्य तां गदाम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2176219, "chapter_id": 4729, "verse_number": "२८", "content_sanskrit": "आविध्यन्तं गदां दृष्ट्वा भीमसेनं तवात्मजः ।\nस्वामुद्यम्य गदां घोरां प्रत्ययुध्यत कौरवः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2176220, "chapter_id": 4729, "verse_number": "२९", "content_sanskrit": "गदामारुतवेगेन तव पुत्रस्य भारत ।\nशब्द आसीत् सुतुमुलस्तेजश्च समजायत\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2176221, "chapter_id": 4729, "verse_number": "३०", "content_sanskrit": "स चरन् विविधान् मार्गान् मण्डलानि च भारत ।\nसमशोभत तेजस्वी भूयो भीमात् सुयोधनः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2176222, "chapter_id": 4729, "verse_number": "३१", "content_sanskrit": "आविद्धा भीमसेनेन सुभीमा महती गदा ।\nसधूमं सार्चिषं चाग्निं मुमोचोग्रं महास्वनम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2176223, "chapter_id": 4729, "verse_number": "३२", "content_sanskrit": "आधूतां भीमसेनेन गदां दृष्ट्वा सुयोधनः ।\nअद्रिसारमयीं गुर्वीमाविध्यन् बह्वशोभत\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2176224, "chapter_id": 4729, "verse_number": "३३", "content_sanskrit": "गदां मारुतवेगां तां दृष्ट्वा तस्य महात्मनः ।\nभयं पाण्डूनाविवेश सर्वानेव ससात्यकान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2176225, "chapter_id": 4729, "verse_number": "३४", "content_sanskrit": "तौ दर्शयन्तौ समरे युद्धक्रीडां समन्ततः ।\nगदाभ्यां सहसाऽन्योन्यमाजघ्नतुररिन्दमौ\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2176226, "chapter_id": 4729, "verse_number": "३५", "content_sanskrit": "तौ परस्परमासाद्य दन्ताभ्यां द्विरदौ यथा ।\nअशोभेतां महाराज शोणितेन परिप्लुतौ\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2176227, "chapter_id": 4729, "verse_number": "३६", "content_sanskrit": "एवं तदभवद् युद्धं घोररूपमसंवृतम् ।\nपरावृत्तेऽहनि क्रूरं वृत्रवासवयोरिव\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2176228, "chapter_id": 4729, "verse_number": "३७", "content_sanskrit": "दृष्ट्वा व्यवस्थितं भीमं तव पुत्रो महारथः ।\nचरंश्चित्रतरान् मार्गान् कौन्तेयं समभिद्रवत्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2176229, "chapter_id": 4729, "verse_number": "३८", "content_sanskrit": "तस्य भीमो महावेगां जाम्बूनदविभूषिताम् ।\nअभिक्रुद्धस्य क्रुद्धस्तु ताडयामास तां गदाम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2176230, "chapter_id": 4729, "verse_number": "३९", "content_sanskrit": "सविष्फुलिङ्गो निर्ह्रादस्तयोस्तत्राभिघातजः ।\nप्रादुरासीन्महाराज घृष्टयोर्वज्रयोरिव\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2176231, "chapter_id": 4729, "verse_number": "४०", "content_sanskrit": "वेगवत्या तया तत्र भीमसेनप्रमुक्तया ।\nनिपतन्त्या महाराज पृथिवी समकम्पत\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2176232, "chapter_id": 4729, "verse_number": "४१", "content_sanskrit": "तां नामृष्यत कौरव्यो गदां प्रतिहतां रणे ।\nमत्तो द्विप इव क्रुद्धः प्रतिकुञ्जरदर्शनात्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2176233, "chapter_id": 4729, "verse_number": "४२", "content_sanskrit": "स सव्यं मण्डलं राजन्नुद्भ्राम्य विगतक्लमः ।\nआजघ्ने मूर्ध्नि कौन्तेयं गदया भीमवेगया\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2176234, "chapter_id": 4729, "verse_number": "४३", "content_sanskrit": "तया त्वभिहतो भीमस्तव पुत्रेण पाण्डवः ।\nनाकम्पत महाराज तदद्भुतमिवाभवत्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2176235, "chapter_id": 4729, "verse_number": "४४", "content_sanskrit": "आश्चर्यं चापि तद्राजन् सर्वसैन्यान्यपूजयन् ।\nयद्गदाभिहतो भीमो नाकम्पत पदात् पदम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2176236, "chapter_id": 4729, "verse_number": "४५", "content_sanskrit": "ततो गुरुतरां दीप्तां गदां हेमपरिष्कृताम् ।\nदुर्योधनाय व्यसृजत् तदद्भुतमिवाभवत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2176237, "chapter_id": 4729, "verse_number": "४६", "content_sanskrit": "तं प्रहारमसम्भ्रान्तो लाघवेन महाबलः ।\nमोघं दुर्योधनश्चक्रे तत्राभूद् विस्मयो महान्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2176238, "chapter_id": 4729, "verse_number": "४७", "content_sanskrit": "सा तु मोघा गदा राजन् पतन्ती भीमचोदिता ।\nचालयामास पृथिवीं महानिर्घातनिःस्वना\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2176239, "chapter_id": 4729, "verse_number": "४८", "content_sanskrit": "आस्थाय कैशिकान् मार्गान् उत्पपात पुनः पुनः ।\nगदानिपातं विज्ञाय भीमसेनमवञ्चयत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2176240, "chapter_id": 4729, "verse_number": "४९", "content_sanskrit": "वञ्चयित्वा ततो भीमं गदया कुरुसत्तमः ।\nअताडयदसम्भ्रान्तो वक्षोदेशे महाबलः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2176241, "chapter_id": 4729, "verse_number": "५०", "content_sanskrit": "गदयाऽभिहतो भीमो मुह्यमानो महारणे ।\nनाभिजानाति कर्तव्यं पुत्रेणाभ्यहतस्तव\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2176242, "chapter_id": 4729, "verse_number": "५१", "content_sanskrit": "तस्मिंस्तथा गते भीमे राजन् सोमकपाण्डवाः ।\nभृशोपहतसङ्कल्पा नातिप्रमनसोऽभवन्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2176243, "chapter_id": 4729, "verse_number": "५२", "content_sanskrit": "स तु तेन प्रहारेण मातङ्ग इव रोषितः ।\nहस्तीव हस्तिसङ्काशमभिदुद्राव ते सुतम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2176244, "chapter_id": 4729, "verse_number": "५३", "content_sanskrit": "ततः सरभसो भीमो गदया तनयं तव ।\nअभिदुद्राव वेगेन सिंहो वनगजं यथा\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2176245, "chapter_id": 4729, "verse_number": "५४", "content_sanskrit": "उपसृत्य तु राजानं गदामोक्षविशारदः ।\nआविध्यत गदां घोरां समुद्दिश्य सुतं तव\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2176246, "chapter_id": 4729, "verse_number": "५५", "content_sanskrit": "अताडयद् भीमसेनः पार्श्वे दुर्योधनं तदा ।\nस विह्वलः प्रहारेण जानुभ्यामवनिं गतः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2176247, "chapter_id": 4729, "verse_number": "५६", "content_sanskrit": "तस्मिंस्तु भरतश्रेष्ठे जानुभ्यामवनीं गते ।\nउदतिष्ठन्महानादः सृञ्जयानां जगत्पते\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2176248, "chapter_id": 4729, "verse_number": "५७", "content_sanskrit": "तेषां तु निनदं श्रुत्वा सृञ्जयानां जनाधिपः ।\nअमर्षाद् भरतश्रेष्ठः पुत्रस्ते समकुप्यत\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2176249, "chapter_id": 4729, "verse_number": "५८", "content_sanskrit": "उत्थाय तु महाबाहुः क्रुद्धो नाग इव श्वसन् ।\nदिधक्षन्निव नेत्राभ्यां भीमसेनमवैक्षत\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2176250, "chapter_id": 4729, "verse_number": "५९", "content_sanskrit": "ततः स भरतश्रेष्ठो भीमसेनमभिद्रवत् ।\nप्रमथिष्यन्निव शिरो भीमसेनस्य संयुगे\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2176251, "chapter_id": 4729, "verse_number": "६०", "content_sanskrit": "स महात्मा महात्मानं भीमसेनमरिन्दमम् ।\nअताडयत् शङ्खदेशे चचालाचलोपमः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2176252, "chapter_id": 4729, "verse_number": "६१", "content_sanskrit": "भूयः स शुशुभे पार्थस्ताडितो गदया भृशम् ।\nउद्भिन्नरुधिरो राजन् प्रभिन्न इव कुञ्जरः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2176253, "chapter_id": 4729, "verse_number": "६२", "content_sanskrit": "ततो गदां वीरहणीमयस्मयीं\nप्रगृह्य वज्राशनितुल्यनिःस्वनाम् ।\nअताडयच्छत्रुममित्रकर्शनो\nबलेन विक्रम्य धनञ्जयाग्रजः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2176254, "chapter_id": 4729, "verse_number": "६३", "content_sanskrit": "स भीमसेनाभिहतस्तवात्मजः\nपपात सङ्कम्पितदेहबन्धनः ।\nसुपुष्पितो मारुतवेगताडितो\nवने महासाल इवावचूर्णितः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2176255, "chapter_id": 4729, "verse_number": "६४", "content_sanskrit": "ततः प्रणेदुर्जहृषुश्च पाण्डवाः\nसमीक्ष्य पुत्रं पतितं क्षितौ तव ।\nततः सुतस्ते प्रतिलभ्य चेतनां\nसमुत्पपात द्विरदो ह्रदाविव\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2176256, "chapter_id": 4729, "verse_number": "६५", "content_sanskrit": "स पार्थिवो नित्यममर्षितस्तदा\nमहारथः शिक्षितवत् परिभ्रमन् ।\nअताडयत् पाण्डवमग्रतः स्थितं\nस विह्वलाङ्गो जगतीमुपास्पृशत्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2176257, "chapter_id": 4729, "verse_number": "६६", "content_sanskrit": "स सिंहनादान् विननाद पार्थिवो\nनिपात्य भूमौ युधि भीममोजसा ।\nबिभेद चेन्द्राशनितुल्यतेजसा\nगदानिपातेन शरीररक्षणम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2176258, "chapter_id": 4729, "verse_number": "६७", "content_sanskrit": "ततोऽन्तरिक्षे निनदो महानभूद्\nदिवौकसामप्सरसां निषेदुषाम् ।\nपपात चोच्चैरमरप्रचोदितं\nविचित्रपुष्पोत्करवर्षमुत्तमम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2176259, "chapter_id": 4729, "verse_number": "६८", "content_sanskrit": "ततः परानाविशदुत्तमं भयं\nसमीक्ष्य भीमं पतितं नरर्षभम् ।\nअहीयमानं च बलेन कौरवं\nनिशाम्य भेदं च दृढस्य वर्मणः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2176260, "chapter_id": 4729, "verse_number": "६९", "content_sanskrit": "ततो मुहूर्तात् प्रतिलभ्य चेतनां\nप्रमृज्य वक्त्रं रुधिरार्द्रमात्मनः ।\nधृतिं समालम्ब्य विवृत्तलोचनो\nबलेन संस्तभ्य वृकोदरः स्थितः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2176261, "chapter_id": 4729, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि भीमसेननिपातो नाम सप्तविंशोऽध्यायः ॥२७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]