[{"id": 5000573000, "chapter_id": 9573, "verse_number": "७-३८-१", "content_sanskrit": "एवमास्ते महाबाहुरहन्यहनि राघवः ।\nप्रशासत्सर्वकार्याणि पौरजानपदेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000573001, "chapter_id": 9573, "verse_number": "७-३८-२", "content_sanskrit": "ततः कतिपयाहःसु वैदेहं मिथिलाधिपम् ।\nराघवः प्राञ्जलिर्भूत्वा वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000573002, "chapter_id": 9573, "verse_number": "७-३८-३", "content_sanskrit": "भवान्हि गतिरव्यग्रा भवता पालिता वयम् ।\nभवतस्तेजसोग्रेण रावणो निहतो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000573003, "chapter_id": 9573, "verse_number": "७-३८-४", "content_sanskrit": "इक्ष्वाकूणां च सर्वेषां मैथिलानां च सर्वशः ।\nअतुलाः प्रीतयो राजन्सम्बन्धकपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000573004, "chapter_id": 9573, "verse_number": "७-३८-५", "content_sanskrit": "तद्भवान्स्वपुरं यातु रत्नान्यादाय पार्थिव ।\nभरतश्च सहायार्थं पृष्ठतस्ते ऽनुयास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000573005, "chapter_id": 9573, "verse_number": "७-३८-६", "content_sanskrit": "स तथेति नृपः कृत्वा राघवं वाक्यमब्रवीत् ।\nप्रीतो ऽस्मि भवतो राजन्दर्शनेन नयेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000573006, "chapter_id": 9573, "verse_number": "७-३८-७", "content_sanskrit": "यान्येतानि तु रत्नानि मदर्थं सञ्चितानि वै ।\nदुहित्रे तानि वै राजन्सर्वाण्येव ददामि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000573007, "chapter_id": 9573, "verse_number": "७-३८-८", "content_sanskrit": "एवमुक्त्वा तु काकुत्स्थं जनको हृष्टमानसः ।\nप्रययौ मिथिलां श्रीमांस्तमनुज्ञाय राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000573008, "chapter_id": 9573, "verse_number": "७-३८-९", "content_sanskrit": "ततः प्रयाते जनके केकयं मातुलं प्रभुः ।\nराघवः प्राञ्जलिर्भूत्वा वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000573009, "chapter_id": 9573, "verse_number": "७-३८-१०", "content_sanskrit": "इदं राज्यमहं चैव भरतश्च सलक्ष्मणः ।\nआयत्तास्त्वं हि नो राजन्गतिश्च पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000573010, "chapter_id": 9573, "verse_number": "७-३८-११", "content_sanskrit": "राजा हि वृद्धः सन्तापं त्वदर्थमुपयास्यति ।\nतस्माद्गमनमद्यैव रोचते तव पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000573011, "chapter_id": 9573, "verse_number": "७-३८-१२", "content_sanskrit": "लक्ष्मणेनानुयात्रेण पृष्ठतो ऽनुगमिष्यते ।\nधनमादाय विपुलं रत्नानि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000573012, "chapter_id": 9573, "verse_number": "७-३८-१३", "content_sanskrit": "युधाजित्तु तथेत्याह गमनं प्रति राघवम् ।\nरत्नानि च धनं चैव त्वय्येवाक्षय्यमस्त्विति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000573013, "chapter_id": 9573, "verse_number": "७-३८-१४", "content_sanskrit": "प्रदक्षिणं स राजानं कृत्वा केकयवर्धनः ।\nरामेण हि कृतः पूर्वमभिवाद्य प्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000573014, "chapter_id": 9573, "verse_number": "७-३८-१५", "content_sanskrit": "लक्ष्मणेन सहायेन प्रयातः केकयेश्वरः ।\nहते ऽसुरे यथा वृत्रे विष्णुना सह वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000573015, "chapter_id": 9573, "verse_number": "७-३८-१६", "content_sanskrit": "तं विसृज्य ततो रामो वयस्यमकुतोभयम् ।\nप्रतर्दनं काशिपतिं परिष्वज्येदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000573016, "chapter_id": 9573, "verse_number": "७-३८-१७", "content_sanskrit": "दर्शिता भवता प्रीतिर्दर्शितं सौहृदं परम् ।\nउद्योगश्च कृतो राजन्भरतेन त्वया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000573017, "chapter_id": 9573, "verse_number": "७-३८-१८", "content_sanskrit": "तद्भवानद्य काशेय पुरीं वाराणसीं व्रज ।\nरमणीयां त्वया गुप्तां सुप्रकाशां सुतोरणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000573018, "chapter_id": 9573, "verse_number": "७-३८-१९", "content_sanskrit": "एतावदुक्त्वा चोत्थाय काकुत्स्थः परमासनात् ।\nपर्यष्वजत धर्मात्मा निरन्तरमुरोगतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000573019, "chapter_id": 9573, "verse_number": "७-३८-२०", "content_sanskrit": "विसर्जयामास तदा कौसल्यानन्दवर्धनः ।\nराघवेणाभ्यनुज्ञातः काशीशो ऽप्यकुतोभयः ।\nवाराणसीं ययौ तूर्णं राघवेण विसर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000573020, "chapter_id": 9573, "verse_number": "७-३८-२१", "content_sanskrit": "विसृज्य तं काशिपतिं त्रिशतं पृथिवीपतीन् ।\nप्रहसन्राघवो वाक्यमुवाच मधुराक्षरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000573021, "chapter_id": 9573, "verse_number": "७-३८-२२", "content_sanskrit": "भवतां प्रीतिरव्यग्रा तेजसा परिरक्षिता ।\nधर्मश्च नियतो नित्यं सत्यं च भवतां सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000573022, "chapter_id": 9573, "verse_number": "७-३८-२३", "content_sanskrit": "युष्माकं चानुभावेन तेजसा च महात्मनाम् ।\nहतो दुरात्मा दुर्बुद्धी रावणो राक्षसाधमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000573023, "chapter_id": 9573, "verse_number": "७-३८-२४", "content_sanskrit": "हेतुमात्रमहं तत्र भवतां तेजसा हतः ।\nरावणः सगणो युद्धे सपुत्रामात्यबान्धवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000573024, "chapter_id": 9573, "verse_number": "७-३८-२५", "content_sanskrit": "भवन्तश्च समानीता भरतेन महात्मना ।\nश्रुत्वा जनकराजस्य काननात्तनयां हृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000573025, "chapter_id": 9573, "verse_number": "७-३८-२६", "content_sanskrit": "उद्युक्तानां च सर्वेषां पार्थिवानां महात्मनाम् ।\nकालो व्यतीतः सुमहान्गमनं रोचयाम्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000573026, "chapter_id": 9573, "verse_number": "७-३८-२७", "content_sanskrit": "प्रत्यूचुस्तं च राजानो हर्षेण महता वृताः ।\nदिष्ट्यां त्वं विजयी राम स्वराज्ये ऽपि प्रतिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000573027, "chapter_id": 9573, "verse_number": "७-३८-२८", "content_sanskrit": "दिष्ट्या प्रत्याहृता सीता दिष्ट्या शत्रुः पराजितः ।\nएष नः परमः काम एषा नः पीतिरुत्तमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000573028, "chapter_id": 9573, "verse_number": "७-३८-२९", "content_sanskrit": "यत्त्वां विजयिनं राम पश्यामो हतशात्रवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000573029, "chapter_id": 9573, "verse_number": "७-३८-३०", "content_sanskrit": "एतत्त्वय्युपपन्नं च यदस्मांस्त्वं प्रशंससे ।\nप्रशंसार्ह न जानीमः प्रशंसां वक्तुमीदृशीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000573030, "chapter_id": 9573, "verse_number": "७-३८-३१", "content_sanskrit": "आपृच्छामो गमिष्यामो हृदिस्थो नः सदा भवान् ।\nवर्तामहे महाबाहो प्रीत्यात्र महता वृताः ।\nभवेच्च ते महाराज प्रीतिरस्मासु नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000573031, "chapter_id": 9573, "verse_number": "७-३८-३२", "content_sanskrit": "बाढमित्येव राजानो हर्षेण परमान्विताः ।\nउचुः प्राञ्जलयः सर्वे राघवं गमनोत्सुकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000573032, "chapter_id": 9573, "verse_number": "७-३८-३३", "content_sanskrit": "पूजिताश्चैव रामेण जग्मुर्देशान्स्वकान्स्वकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000573033, "chapter_id": 9573, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे ऽष्टात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]