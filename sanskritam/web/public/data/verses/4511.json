[{"id": 2162649, "chapter_id": 4511, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2162650, "chapter_id": 4511, "verse_number": "१", "content_sanskrit": "यौ तौ कर्णश्च भीमश्च सम्प्रयुद्धौ महाबलौ ।\nअर्जुनस्य रथोपान्ते कीदृशः सोऽभवद् रणः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2162651, "chapter_id": 4511, "verse_number": "२", "content_sanskrit": "पूर्वं हि निर्जितः कर्णो भीमसेनेन संयुगे ।\nकथं भूयस्तु राधेयो भीममागान्महारथः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2162652, "chapter_id": 4511, "verse_number": "३", "content_sanskrit": "भीमो वा सूततनयं प्रत्युद्यातः कथं रणे ।\nमहारथसमाख्यातं पृथिव्यां प्रवरं रथम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2162653, "chapter_id": 4511, "verse_number": "४", "content_sanskrit": "भीष्मद्रोणावतिक्रम्य धर्मपुत्रो युधिष्ठिरः ।\nनान्यतो भयमादत्त विना कर्णं धनुर्धरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2162654, "chapter_id": 4511, "verse_number": "५", "content_sanskrit": "भयान्न शेते सततं चिन्तयन् वै महारथम् ।\nतं कथं सूतपुत्रं हि भीमोऽयुद्ध्यत संयुगे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2162655, "chapter_id": 4511, "verse_number": "६", "content_sanskrit": "ब्रह्मण्यं वीर्यसम्पन्नं समरेष्वनिवर्तिनम् ।\nकथं कर्णं युधांश्रेष्ठं भीमोऽयुद्ध्यत संयुगे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2162656, "chapter_id": 4511, "verse_number": "७", "content_sanskrit": "यौ तौ समीयतुर्वीरावर्जुनस्य रथं प्रति ।\nकथं नु तावयुद्ध्येतां सूतपुत्रवृकोदरौ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2162657, "chapter_id": 4511, "verse_number": "८", "content_sanskrit": "भ्रातृत्वं दर्शितं पूर्वं घृणी चापि स सूतजः ।\nकथं भीमेन युयुधे कुन्त्या वाक्यमनुस्मरन्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2162658, "chapter_id": 4511, "verse_number": "९", "content_sanskrit": "भीमो वा सूतपुत्रेण स्मरन् वैरं पुरा कृतम् ।\nसोऽयुद्ध्यत कथं वीरः कर्णेन सह संयुगे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2162659, "chapter_id": 4511, "verse_number": "१०", "content_sanskrit": "आशास्ते च सदा सूत पुत्रो दुर्योधनो मम ।\nकर्णो जेष्यति सङ्ग्रामे सहितान् पाण्डवानिति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2162660, "chapter_id": 4511, "verse_number": "११", "content_sanskrit": "जयाशा यत्र मन्दस्य पुत्रस्य मम संयुगे ।\nस कथं भीमकर्माणं भीमसेनमयुद्ध्यत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2162661, "chapter_id": 4511, "verse_number": "१२", "content_sanskrit": "यं समाश्रित्य पुत्रैर्मे कृतं वैरं महारथैः ।\nतं सूततनयं तात कथं भीमो ह्ययोधयत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2162662, "chapter_id": 4511, "verse_number": "१३", "content_sanskrit": "अनेकान् विप्रकारांश्च सूतपुत्रसमुद्भवान् ।\nस्मरमाणः कथं भीमो युयुधे सूतसूनुना\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2162663, "chapter_id": 4511, "verse_number": "१४", "content_sanskrit": "योऽजयत् पृथिवीं सर्वां रथेनैकेन वीर्यवान् ।\nतं सूततनयं युद्धे कथं भीमो ह्ययोधयत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2162664, "chapter_id": 4511, "verse_number": "१५", "content_sanskrit": "यो जातः कुण्डलाभ्यां च कवचेन सहैव च ।\nतं सूतपुत्रं समरे भीमः कथमयोधयत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2162665, "chapter_id": 4511, "verse_number": "१६", "content_sanskrit": "यथा तयोर्युद्धमभूद्यश्चासीद् विजयी तयोः ।\nतन्ममाचक्ष्व तत्त्वेन कुशलो ह्यसि सञ्जय\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2162666, "chapter_id": 4511, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2162667, "chapter_id": 4511, "verse_number": "१७", "content_sanskrit": "भीमसेनस्तु राधेयमुत्सृज्य रथिनां वरम् ।\nइयेष गन्तुं यत्रास्तां वीरौ कृष्णधनञ्जयौ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2162668, "chapter_id": 4511, "verse_number": "१८", "content_sanskrit": "तं प्रयान्तमभिद्रुत्य राधेयः कङ्कपत्रिभिः ।\nअभ्यवर्षन्महाराज मेघो वृष्ट्येव पर्वतम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2162669, "chapter_id": 4511, "verse_number": "१९", "content_sanskrit": "फुल्लता पङ्कजेनेव वक्त्रेणाभ्युत्स्मयन् बली ।\nआजुहाव रणे यान्तं भीममाधिरथिस्तदा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2162670, "chapter_id": 4511, "verse_number": "२०", "content_sanskrit": "भीमसेनस्तदाह्वानं कर्णान्नामर्षयद् युधि ।\nअर्धमण्डलमावृत्य सूतपुत्रमयोधयत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2162671, "chapter_id": 4511, "verse_number": "२१", "content_sanskrit": "अवक्रगामिभिर्बाणैरभ्यवर्षन् महायसैः ।\nद्वैरथे दंसितं यत्तं सर्वशस्त्रभृतां वरम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2162672, "chapter_id": 4511, "verse_number": "२२", "content_sanskrit": "विधित्सुः कलहस्यान्तं जिघांसुः कर्णमैक्षत ।\nतं च हत्वेतरान् सर्वान् हन्तुकामो महाबलः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2162673, "chapter_id": 4511, "verse_number": "२३", "content_sanskrit": "तस्मै प्रासृजदुग्राणि विविधानि परन्तपः ।\nअमर्षी पाण्डवः क्रुद्धः शरवर्षाणि मारिष\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2162674, "chapter_id": 4511, "verse_number": "२४", "content_sanskrit": "तस्य तानीषुवर्षाणि मत्तद्विरदगामिनः ।\nसूतपुत्रोऽस्त्रमायाभिरग्रसत् सुमहायशाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2162675, "chapter_id": 4511, "verse_number": "२५", "content_sanskrit": "स यथावन्महाराज विद्यया वै सुपूजितः ।\nआचार्यवन्महेष्वासः कर्णः पर्यचरद् रणे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2162676, "chapter_id": 4511, "verse_number": "२६", "content_sanskrit": "संरम्भेण तु युद्ध्यन्तं भीमसेनं स्मयन्निव ।\nअभ्यपद्यत राधेयस्तममर्षी वृकोदरम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2162677, "chapter_id": 4511, "verse_number": "२७", "content_sanskrit": "तन्नामृष्यत कौन्तेयः कर्णस्य स्मितमाहवे ।\nयुद्ध्यमानेषु वीरेषु पश्यत्सु च समन्ततः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2162678, "chapter_id": 4511, "verse_number": "२८", "content_sanskrit": "तं भीमसेनः सम्प्राप्तं वत्सदन्तैः स्तनान्तरे ।\nविव्याध बलवान् क्रुद्धस्तोत्त्रैरिव महाद्विपम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2162679, "chapter_id": 4511, "verse_number": "२९", "content_sanskrit": "सूतं तु सूतपुत्रस्य सुपुङ्खैर्निशितैः शरैः ।\nसुमुक्तैश्चित्रवर्माणं निर्बिभेद त्रिसप्तभिः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2162680, "chapter_id": 4511, "verse_number": "३०", "content_sanskrit": "कर्णो जाम्बूनदैर्जालैः सञ्छन्नान् वातरंहसः ।\nविव्याध तुरगान् वीरः पञ्चभिः पञ्चभिः शरैः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2162681, "chapter_id": 4511, "verse_number": "३१", "content_sanskrit": "ततो बाणमयं जालं भीमसेनरथं प्रति ।\nकर्णेन विहितं राजन्निमेषार्धाददृश्यत\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2162682, "chapter_id": 4511, "verse_number": "३२", "content_sanskrit": "सरथः सध्वजस्तत्र ससूतः पाण्डवस्तदा ।\nप्राच्छाद्यत महाराज कर्णचापच्युतैः शरैः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2162683, "chapter_id": 4511, "verse_number": "३३", "content_sanskrit": "तस्य कर्णश्चतुःषष्ट्या व्यधमत् कवचं दृढम् ।\nक्रुद्धश्चाप्यहनत् पार्श्वे शरैः कङ्कालभेदिभिः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2162684, "chapter_id": 4511, "verse_number": "३४", "content_sanskrit": "ततोऽचिन्त्य महावेगान् कर्णकार्मुकनिःसृतान् ।\nसमाश्लिष्यदसम्भ्रान्तः सूतपुत्रं वृकोदरः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2162685, "chapter_id": 4511, "verse_number": "३५", "content_sanskrit": "स कर्णचापप्रभवानिषूनाशीविषोपमान् ।\nबिभ्रद् भीमो महाराज न जगाम व्यथां रणे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2162686, "chapter_id": 4511, "verse_number": "३६", "content_sanskrit": "ततो द्वात्रिंशता भल्लैर्निशितैस्तिग्मतेजनैः ।\nविव्याध समरे कर्णं भीमसेनः प्रतापवान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2162687, "chapter_id": 4511, "verse_number": "३७", "content_sanskrit": "अयत्नेनैव तं कर्णः शरैरुप समाकिरत् ।\nभीमसेनं महाबाहुं सैन्धवस्य वधैषिणम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2162688, "chapter_id": 4511, "verse_number": "३८", "content_sanskrit": "मृदुपूर्वं च राधेयो भीममाजावयोधयत् ।\nक्रोधपूर्वं तथा भीमः पूर्ववैरमनुस्मरन्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2162689, "chapter_id": 4511, "verse_number": "३९", "content_sanskrit": "तं भीमसेनो नामृष्यदवमानममर्षणः ।\nस तस्मै व्यसृजत्तूर्णं शरवर्षममित्रजित्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2162690, "chapter_id": 4511, "verse_number": "४०", "content_sanskrit": "ते शराः प्रेषिता राजन् भीमसेनेन संयुगे ।\nनिपेतुः सर्वतो भीमाः कूजन्त इव पक्षिणः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2162691, "chapter_id": 4511, "verse_number": "४१", "content_sanskrit": "हेमपुङ्खा महाराज भीमसेनधनुश्च्युताः ।\nअभ्यद्रवंस्ते राधेयं वृकाः क्षुद्रमृगं यथा\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2162692, "chapter_id": 4511, "verse_number": "४२", "content_sanskrit": "कर्णस्तु रथिनां श्रेष्ठश्छाद्यमानः समन्ततः ।\nराजन् व्यसृजदुग्राणि शरवर्षाणि संयुगे\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2162693, "chapter_id": 4511, "verse_number": "४३", "content_sanskrit": "तस्य तानशनिप्रख्यानिषून् समरशोभिनः ।\nचिच्छेद बहुभिर्भल्लैरसम्प्राप्तान् वृकोदरः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2162694, "chapter_id": 4511, "verse_number": "४४", "content_sanskrit": "पुनश्च शरवर्षेण छादयामास भारत ।\nकर्णो वैकर्तनो युद्धे भीमसेनं महारथम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2162695, "chapter_id": 4511, "verse_number": "४५", "content_sanskrit": "तत्र भारत भीमं तु दृष्टवन्तः स्म सायकैः ।\nसमाचिततनुं सङ्खे श्वाविधं शललैरिव\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2162696, "chapter_id": 4511, "verse_number": "४६", "content_sanskrit": "हेमपुङ्खान् शिलाधौतान् कर्णचापच्युतान् शरान् ।\nदधार समरे वीरः स्वरश्मीनिव भास्करः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2162697, "chapter_id": 4511, "verse_number": "४७", "content_sanskrit": "रुधिरोक्षितसर्वाङ्गो भीमसेनो व्यरोचत ।\nतपनीयनिभैः पुष्पैः पलाश इव कानने\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2162698, "chapter_id": 4511, "verse_number": "४८", "content_sanskrit": "तत्तु भीमो महाराज कर्णस्य चरितं रणे ।\nनामृष्यत महेष्वासः क्रोधादुद्वृत्य चक्षुषी\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2162699, "chapter_id": 4511, "verse_number": "४९", "content_sanskrit": "स कर्णं पञ्चविंशत्या नाराचानां समार्पयत् ।\nमहीधरमिव श्वेतं गूढपादैर्विषोल्बणैः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2162700, "chapter_id": 4511, "verse_number": "५०", "content_sanskrit": "तं विव्याध पुनर्भीमः षड्भिरष्टाभिरेव च ।\nमर्मस्वमरविक्रान्तः सूतपुत्रं महारणे\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2162701, "chapter_id": 4511, "verse_number": "५१", "content_sanskrit": "ततः कर्णस्य सङ्क्रुद्धो भीमसेनः प्रतापवान् ।\nचिच्छेद कार्मुकं तूर्णं सर्वोपकरणानि च\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2162702, "chapter_id": 4511, "verse_number": "५२", "content_sanskrit": "जघान चतुरश्चाश्वान् सूतं च त्वरितः शरैः ।\nनाराचैरर्करश्म्याभैः कर्णं विव्याध चोरसि\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2162703, "chapter_id": 4511, "verse_number": "५३", "content_sanskrit": "ते जग्मुर्धरणीं सर्वे कर्णं निर्भिद्य मारिष ।\nयथा हि जलदं भित्त्वा राजन् सूर्यस्य रश्मयः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2162704, "chapter_id": 4511, "verse_number": "५४", "content_sanskrit": "स वैकल्यं महत् प्राप्य छिन्नधन्वा शरार्दितः ।\nतथा पुरुषमानी स प्रत्यपायाद् रथान्तरम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2162705, "chapter_id": 4511, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि षोडशाधिकशततमोऽध्यायः ॥ ११६ ॥\nजयद्रथवधपर्वणि चत्वारिंशोऽध्यायः ॥ ४० ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]