[{"id": 7000847000, "chapter_id": 20847, "verse_number": "६-१९०-१", "content_sanskrit": "ईश्वर उवाच ।\nअतः परं प्रवक्ष्यामि षोडशाध्यायगौरवम् ।\nआकर्णय कुरंगाक्षि हर्षोत्कंठप्रवर्षिणि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000847001, "chapter_id": 20847, "verse_number": "६-१९०-२", "content_sanskrit": "अस्ति सौराष्ट्रिकं नाम्ना पुरं गुर्जरमंडले ।\nतत्रासीत्खङ्गबाहुश्च राजा चंद्र इवापरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000847002, "chapter_id": 20847, "verse_number": "६-१९०-३", "content_sanskrit": "यदीय कुसुमामोदमालासुरभितोदरे ।\nवारांनिधौ हरिः स्वास्थ्यादशेत सह पद्मया ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000847003, "chapter_id": 20847, "verse_number": "६-१९०-४", "content_sanskrit": "यदीय कीर्तिकर्पूरकणाभांतिनभोंगणे ।\nकीर्णा वैरिकृतश्वास मारुतैस्तारकाछलात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000847004, "chapter_id": 20847, "verse_number": "६-१९०-५", "content_sanskrit": "यस्यासिधारा तीर्थेषु स्नाता वै रिपुभूभुजः ।\nव्यावर्त्तं ते दिवोऽद्यापि स्वर्गस्त्रीवाग्विमोहिताः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000847005, "chapter_id": 20847, "verse_number": "६-१९०-६", "content_sanskrit": "तस्यारिमर्दनोनाम मदहस्ती मदोद्धुरः ।\nमदांबुधारा सलिले गुंजद्भ्रमरमंडलः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000847006, "chapter_id": 20847, "verse_number": "६-१९०-७", "content_sanskrit": "कपोलफलकोत्तीर्ण मदधाराजलाविलः ।\nबभौ यो निर्झरोद्गोरैरंजनाद्रिरिवाच्चकैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000847007, "chapter_id": 20847, "verse_number": "६-१९०-८", "content_sanskrit": "यस्यांगेषु व्यराजंत चामराश्चंद्रिकोज्ज्वलाः ।\nकिरणाइव शीतांशोः पतिताः काननोदरे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000847008, "chapter_id": 20847, "verse_number": "६-१९०-९", "content_sanskrit": "सिंदूरपांसुपटली राजत्कुंभस्थलो बभौ ।\nयः संध्यावारिदव्याप्तं वियत्खंडमिव स्थितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000847009, "chapter_id": 20847, "verse_number": "६-१९०-१०", "content_sanskrit": "स कदाचिन्मोचयित्वा शृंखलान्निगडानपि ।\nभंक्त्वा लौहदृढस्तंभं प्रसह्य निशि निर्गतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000847010, "chapter_id": 20847, "verse_number": "६-१९०-११", "content_sanskrit": "आधोरणगणान्सर्वान्पार्ष्णिविस्फूर्जदंकुशान् ।\nक्रोधादवगणय्यैव निजशालां बभंज सः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000847011, "chapter_id": 20847, "verse_number": "६-१९०-१२", "content_sanskrit": "तीक्ष्णांकुशमुखैर्विष्वखन्यमानोऽपि वैणवैः ।\nदंडैस्तु त्रासयामासुः सादिनो न मनागपि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000847012, "chapter_id": 20847, "verse_number": "६-१९०-१३", "content_sanskrit": "ततो राजा समागत्य निशम्येदं कुतूहलम् ।\nतत्र हस्तिकलाभिज्ञैः समं राजकुमारकैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000847013, "chapter_id": 20847, "verse_number": "६-१९०-१४", "content_sanskrit": "अदृश्यत समागत्य राज्ञा दंतावलो बली ।\nमोहयन्नुद्भटाटोपो हृताट्टालिकमालिकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000847014, "chapter_id": 20847, "verse_number": "६-१९०-१५", "content_sanskrit": "ददृशुस्तं महाभीमं पौरा दूरतरं स्थिताः ।\nगोपायंतः शिशून्भीत्या निवृत्तान्यकुतूहलाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000847015, "chapter_id": 20847, "verse_number": "६-१९०-१६", "content_sanskrit": "रुद्धेषु तत्र मार्गेषु पलायनपरैर्जनैः ।\nवासितेषु तदीयोग्रदानधारांबुसीकरैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000847016, "chapter_id": 20847, "verse_number": "६-१९०-१७", "content_sanskrit": "स्नात्वा तेनाध्वना यातः सरसः कश्चन द्विजः ।\nगीतानां षोडशाध्यायश्लोकान्कतिपयाञ्जपन् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000847017, "chapter_id": 20847, "verse_number": "६-१९०-१८", "content_sanskrit": "निषिद्ध्यमानो बहुधा पौरैराधोरणैरपि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000847018, "chapter_id": 20847, "verse_number": "६-१९०-१९", "content_sanskrit": "अमन्यमानः करिणो भीतान्चलितवांस्ततः ।\nफूत्कारेण स आवृण्वञ्जनान्विपरिमर्दयन् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000847019, "chapter_id": 20847, "verse_number": "६-१९०-२०", "content_sanskrit": "स्पृशन्दानांबुजं तस्य स्वस्तिमान्निर्गतो द्विजः ।\nततो महानभूत्तत्र विस्मयो वागगोचरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000847020, "chapter_id": 20847, "verse_number": "६-१९०-२१", "content_sanskrit": "मानसे भूमिपालस्य पौराणामपि पश्यताम् ।\nसमाहूय ततो राजा फुल्लराजीवलोचनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000847021, "chapter_id": 20847, "verse_number": "६-१९०-२२", "content_sanskrit": "तमापृच्छद्द्विजं वाहादवतीर्य प्रणम्य च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000847022, "chapter_id": 20847, "verse_number": "६-१९०-२३", "content_sanskrit": "राजोवाच ।\nअलौकिकमिदं विप्र त्वयाद्याचरितं महत् ।\nकृतांतकल्पादेतस्मात्कथं निर्यातवान्गजात् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000847023, "chapter_id": 20847, "verse_number": "६-१९०-२४", "content_sanskrit": "कमर्चयसि गीर्वाणं कं मंत्रं जपसि प्रभो ।\nका च सिद्धिस्तवास्तीति द्विजन्मन्समुदीरय ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000847024, "chapter_id": 20847, "verse_number": "६-१९०-२५", "content_sanskrit": "द्विज उवाच ।\nगीतायाः षोडशोध्यायः श्लोकान्कतिपयानहम् ।\nजपामि प्रत्यहं भूप तेनैताः सर्वसिद्धयः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000847025, "chapter_id": 20847, "verse_number": "६-१९०-२६", "content_sanskrit": "ततो विहाय द्विरदं कौतूहलरसं नृपः ।\nआजगाम द्विजन्मानमादाय निजमंदिरम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000847026, "chapter_id": 20847, "verse_number": "६-१९०-२७", "content_sanskrit": "शुभं मुहूर्तमन्वीक्ष्य तोषयित्वा द्विजोत्तमम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000847027, "chapter_id": 20847, "verse_number": "६-१९०-२८", "content_sanskrit": "सुवर्णैर्लक्ष्यसंख्याकैर्गीतामंत्रमुपाददे ।\nगीतायाः षोडशाध्यायश्लोकान्कतिपयानपि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000847028, "chapter_id": 20847, "verse_number": "६-१९०-२९", "content_sanskrit": "समभ्यस्य ततो राजा सत्कारेण सकौतुकः ।\nअथैकदा विनिर्गत्य बाह्यालीं सह सैनिकैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000847029, "chapter_id": 20847, "verse_number": "६-१९०-३०", "content_sanskrit": "तमेवामोचयद्राजा मत्तमाधोरणाद्गजम् ।\nविस्पष्टमिति वाक्यानि राज्यसौख्यममानयन् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000847030, "chapter_id": 20847, "verse_number": "६-१९०-३१", "content_sanskrit": "तृणवज्जीवितं राजा गजस्याग्रेविशत्ततः ।\nआदाय गंडफलकं मदपंक्तिनिरंकुशम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000847031, "chapter_id": 20847, "verse_number": "६-१९०-३२", "content_sanskrit": "आययौ मंत्रिविश्वासान्नृपः साहसिकाग्रणीः ।\nराहोरिव मुखादिंदुः कालास्यादिव धार्मिकः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000847032, "chapter_id": 20847, "verse_number": "६-१९०-३३", "content_sanskrit": "साधुः खलस्य वदनान्नृयोनिरगमद्गजात् ।\nआगत्य नगरं राजा त्वभिषिच्य कुमारकम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000847033, "chapter_id": 20847, "verse_number": "६-१९०-३४", "content_sanskrit": "गीतायाः षोडशाध्यायादवाप परमां गतिम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]