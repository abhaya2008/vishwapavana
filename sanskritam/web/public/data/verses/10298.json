[{"id": 6000298000, "chapter_id": 10298, "verse_number": null, "content_sanskrit": "अथ द्व्यधिकशततमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000298001, "chapter_id": 10298, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.001.m4a", "display_order": 2}, {"id": 6000298002, "chapter_id": 10298, "verse_number": "१०-१०२-१", "content_sanskrit": "कदाचिद् वाजिमेधेन यष्टुमुद्यम्य केशवः।\nमहीं प्रदक्षिणीकर्तुं प्राहिणोत् प्रोक्षितं हयम्॥ १०/१०२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.002.m4a", "display_order": 3, "topics": [{"text": "कृष्णस्याश्वमेधयागानुष्ठानं मध्ये मृतविप्रपुत्रानयनं च", "range": "१–७३"}]}, {"id": 6000298003, "chapter_id": 10298, "verse_number": "१०-१०२-२", "content_sanskrit": "हार्दिक्यं कृतवर्माणं युयुधानं च सात्यकिम्।\nचारुदेष्णं सुदेष्णं च प्रद्युम्नं साम्बमेव च॥ १०/१०२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.003.m4a", "display_order": 4}, {"id": 6000298004, "chapter_id": 10298, "verse_number": "१०-१०२-३", "content_sanskrit": "अंशुमन्तं सुभानुं च बहुसैन्यांश्च यादवान्।\nरक्षणार्थं तुरङ्गस्य प्राहिणोद् यदुनन्दनः॥ १०/१०२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.004.m4a", "display_order": 5}, {"id": 6000298005, "chapter_id": 10298, "verse_number": "१०-१०२-४", "content_sanskrit": "ते वै प्रदक्षिणं कृत्वा वसुधां प्रोक्षितं हयम्।\nउपानिन्युरदीर्घेण कालेन भरतर्षभ॥ १०/१०२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.005.m4a", "display_order": 6}, {"id": 6000298006, "chapter_id": 10298, "verse_number": "१०-१०२-५", "content_sanskrit": "यष्टुकामं हरिं श्रुत्वा हयमेधेन भारत।\nआजग्मुर्दीर्घतपसो मुनयः संशितव्रताः॥ १०/१०२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.006.m4a", "display_order": 7}, {"id": 6000298007, "chapter_id": 10298, "verse_number": "१०-१०२-६", "content_sanskrit": "होतारं च तथाऽध्वर्युमुद्गातारं च केशवः।\nकल्पयित्वा यथान्यायं तथाऽन्यानपि ऋत्विजः॥ १०/१०२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.007.m4a", "display_order": 8}, {"id": 6000298008, "chapter_id": 10298, "verse_number": "१०-१०२-७", "content_sanskrit": "ऋषिभिर्ब्राह्मणश्रेष्ठैर्यज्ञविद्याविचक्षणैः।\nदीक्षां प्रपेदे भगवान् कृतपुण्याहमङ्गलः॥ १०/१०२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.008.m4a", "display_order": 9}, {"id": 6000298009, "chapter_id": 10298, "verse_number": "१०-१०२-८", "content_sanskrit": "तमुपास्तुं महीपाला नानाजनपदेश्वराः।\nआजग्मुर्देवसङ्काशाः किरीटमुकुटोज्वलाः॥ १०/१०२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.009.m4a", "display_order": 10}, {"id": 6000298010, "chapter_id": 10298, "verse_number": "१०-१०२-९", "content_sanskrit": "पाण्डवाश्च महीपाला यज्ञदर्शनमिच्छवः।\nआहूता वासुदेवेन द्वारकामाययुर्नृप॥ १०/१०२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.010.m4a", "display_order": 11}, {"id": 6000298011, "chapter_id": 10298, "verse_number": "१०-१०२-१०", "content_sanskrit": "तस्मिंस्तथा वर्तमाने हयमेधमहोत्सवे।\nआसंस्तृप्ता द्विजा भोज्यवस्‍त्रगोभूमिकाञ्चनैः॥ १०/१०२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.011.m4a", "display_order": 12}, {"id": 6000298012, "chapter_id": 10298, "verse_number": "१०-१०२-११", "content_sanskrit": "दीक्षां प्रविश्य गोविन्दः कामैस्तर्पयति द्विजान्।\nभुञ्जानेषु द्विजाग्र्येषु प्रत्यगृह्णात् सुवाञ्छितम्॥ १०/१०२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.012.m4a", "display_order": 13}, {"id": 6000298013, "chapter_id": 10298, "verse_number": "१०-१०२-१२", "content_sanskrit": "आसीनेषु यथायोगं भूपालेषु समन्ततः।\nवदत्सु मा शब्द इति वेत्रझर्झरपाणिषु॥ १०/१०२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.013.m4a", "display_order": 14}, {"id": 6000298014, "chapter_id": 10298, "verse_number": "१०-१०२-१३", "content_sanskrit": "तृणमूलधरः कश्चिद् ब्राह्मणोऽभ्येत्य सत्वरः।\nचुक्रोश आर्त उद्बाहुर्यज्ञवाटमुखे स्थितः॥ १०/१०२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.014.m4a", "display_order": 15}, {"id": 6000298015, "chapter_id": 10298, "verse_number": "१०-१०२-१४", "content_sanskrit": "क्षुत्क्षामकण्ठः शुष्कास्यो गलद्बाष्पाकुलेक्षणः।\nइदं चोवाच विलपन्नातुरो दीनमानसः॥ १०/१०२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.015.m4a", "display_order": 16}, {"id": 6000298016, "chapter_id": 10298, "verse_number": "१०-१०२-१५", "content_sanskrit": "ब्रह्मद्विषः शठधियो लुब्धस्य विषयात्मनः।\nक्षत्रबन्धोः कर्मदोषात् पञ्चत्वं मे गताः सुताः॥ १०/१०२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.016.m4a", "display_order": 17}, {"id": 6000298017, "chapter_id": 10298, "verse_number": "१०-१०२-१६", "content_sanskrit": "हिंसाविहारं नृपतिं दुःशीलमजितेन्द्रियम्।\nप्रजा भजन्त्यः सीदन्ति दरिद्रा नित्यदुःखिताः॥ १०/१०२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.017.m4a", "display_order": 18}, {"id": 6000298018, "chapter_id": 10298, "verse_number": "१०-१०२-१७", "content_sanskrit": "एवं द्वितीयं विप्रर्षिस्तृतीयं त्वेवमेव च।\nइत्युक्त्वा स पुनश्चैव चुक्रोश भृशदुःखितः॥ १०/१०२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.018.m4a", "display_order": 19}, {"id": 6000298019, "chapter_id": 10298, "verse_number": "१०-१०२-१८", "content_sanskrit": "तदाकर्ण्यार्जुनो मानी समुत्थाय वरासनात्।\nअपृच्छत् स्वयमासाद्य ब्राह्मणं केशवान्तिकात्॥ १०/१०२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.019.m4a", "display_order": 20}, {"id": 6000298020, "chapter_id": 10298, "verse_number": "१०-१०२-१९", "content_sanskrit": "किमासन्नर्भका ब्रह्मंस्तव केनासि दुःखितः।\nब्रूहि तत्वमशेषेण त्वामद्य सुखयाम्यहम्॥ १०/१०२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.020.m4a", "display_order": 21}, {"id": 6000298021, "chapter_id": 10298, "verse_number": "१०-१०२-२०", "content_sanskrit": "इत्युक्तो ब्राह्मणः प्राह जातो जातोऽर्भको मम।\nनीयते तात केनापि तत्क्षणे सूतिकागृहात्॥ १०/१०२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.021.m4a", "display_order": 22}, {"id": 6000298022, "chapter_id": 10298, "verse_number": "१०-१०२-२१", "content_sanskrit": "तदाकर्ण्यार्जुनः प्राह स्मयमान इव द्विजम्।\nकिं ब्राह्मण त्वन्निवासे इह नास्ति धनुर्धरः॥ १०/१०२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.022.m4a", "display_order": 23}, {"id": 6000298023, "chapter_id": 10298, "verse_number": "१०-१०२-२२", "content_sanskrit": "राजन्यबन्धोरेते वै ब्राह्मणाः सत्रमासते॥ १०/१०२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.023.m4a", "display_order": 24}, {"id": 6000298024, "chapter_id": 10298, "verse_number": "१०-१०२-२३", "content_sanskrit": "धनदारात्मजैर्भृत्या यत्र शोचन्ति ब्राह्मणाः।\nते वै राजन्यवेषेण नटा जीवन्त्यसुम्भराः॥ १०/१०२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.024.m4a", "display_order": 25}, {"id": 6000298025, "chapter_id": 10298, "verse_number": "१०-१०२-२४", "content_sanskrit": "अहं प्रजा वै रक्षिष्ये भगवन् दीनयोरिह।\nअनिस्तीर्णप्रतिज्ञोऽग्निं प्रवेक्ष्येऽहतकल्मषः॥ १०/१०२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.025.m4a", "display_order": 26}, {"id": 6000298026, "chapter_id": 10298, "verse_number": null, "content_sanskrit": "ब्राह्मण उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.026.m4a", "display_order": 27}, {"id": 6000298027, "chapter_id": 10298, "verse_number": "१०-१०२-२५", "content_sanskrit": "सङ्कर्षणो वासुदेवः प्रद्युम्नो धन्विनां वरः।\nअनिरुद्धोऽप्रतिरथो न त्रातुं शक्नुवन्ति यत्॥ १०/१०२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.027.m4a", "display_order": 28}, {"id": 6000298028, "chapter_id": 10298, "verse_number": "१०-१०२-२६", "content_sanskrit": "तत् कथं नु भवान् कर्म दुष्करं जगदीश्वरैः।\nचिकीर्षतीह बालिश्यात् तन्न श्रद्दध्महे वयम्॥ १०/१०२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.028.m4a", "display_order": 29}, {"id": 6000298029, "chapter_id": 10298, "verse_number": null, "content_sanskrit": "अर्जुन उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.029.m4a", "display_order": 30}, {"id": 6000298030, "chapter_id": 10298, "verse_number": "१०-१०२-२७", "content_sanskrit": "नाहं सङ्कर्षणो ब्रह्मन् न कृष्णः कार्ष्णिरेव च।\nअहं धनञ्जयो नाम गाण्डीवं पश्य कार्मुकम्॥ १०/१०२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.030.m4a", "display_order": 31}, {"id": 6000298031, "chapter_id": 10298, "verse_number": "१०-१०२-२८", "content_sanskrit": "मा वमंस्था मम ब्रह्मन् वीर्यं त्र्यम्बकतोषणम्।\nमृत्युं विजित्य प्रधनेऽप्यानयिष्ये तव प्रजाः॥ १०/१०२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.031.m4a", "display_order": 32}, {"id": 6000298032, "chapter_id": 10298, "verse_number": "१०-१०२-२९", "content_sanskrit": "इति विस्रम्भयित्वा तं कृष्णमाहार्जुनो नृप।\nअनुज्ञां देहि भगवन् ब्राह्मणार्थे प्रयास्यतः॥ १०/१०२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.032.m4a", "display_order": 33}, {"id": 6000298033, "chapter_id": 10298, "verse_number": "१०-१०२-३०", "content_sanskrit": "यजतां वाजिमेधेन भवानेभिर्महात्मभिः। इति ब्रुवन्तं बीभत्सुमनुज्ञां प्रेप्सुमच्युतः।\nबद्धतूणं सगाण्डीवं स्मयमानोऽब्रवीद् वचः॥ १०/१०२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.033.m4a", "display_order": 34}, {"id": 6000298034, "chapter_id": 10298, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.034.m4a", "display_order": 35}, {"id": 6000298035, "chapter_id": 10298, "verse_number": "१०-१०२-३१", "content_sanskrit": "अहमेवागमिष्यामि न त्वया शक्यतेऽर्जुन।\nतमसाधारणं भूतं मन्ये येन हतोऽर्भकः॥ १०/१०२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.035.m4a", "display_order": 36}, {"id": 6000298036, "chapter_id": 10298, "verse_number": null, "content_sanskrit": "अर्जुन उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.036.m4a", "display_order": 37}, {"id": 6000298037, "chapter_id": 10298, "verse_number": "१०-१०२-३२", "content_sanskrit": "सलोकपालो देवेन्द्रः खाण्डवे विजितो मया।\nकिरातरूपी युद्धेन तोषितश्च त्रियम्बकः॥ १०/१०२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.037.m4a", "display_order": 38}, {"id": 6000298038, "chapter_id": 10298, "verse_number": "१०-१०२-३३", "content_sanskrit": "निवातकवचाश्चैव वासवेनापि दुर्जयाः।\nमयैव निहताः सङ्ख्येे हिरण्यपुरवासिनः॥ १०/१०२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.038.m4a", "display_order": 39}, {"id": 6000298039, "chapter_id": 10298, "verse_number": "१०-१०२-३४", "content_sanskrit": "तेभ्योऽधिकतरं भूतं किं नु दानवसूदन।\nविभीषयसि मां कस्मादनुज्ञां देहि साम्प्रतम्॥ १०/१०२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.039.m4a", "display_order": 40}, {"id": 6000298040, "chapter_id": 10298, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.040.m4a", "display_order": 41}, {"id": 6000298041, "chapter_id": 10298, "verse_number": "१०-१०२-३५", "content_sanskrit": "इत्युक्तः प्रददौ कृष्णस्त्वनुज्ञां सव्यसाचिने।\nनिर्ययौ यज्ञशालायाः स गृहीतशरासनः॥ १०/१०२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.041.m4a", "display_order": 42}, {"id": 6000298042, "chapter_id": 10298, "verse_number": "१०-१०२-३६", "content_sanskrit": "रथमास्थाय विपुलं समुच्छ्रितकपिध्वजम्।\nअग्रे ब्राह्मणमारोप्य तद्ग्राममभितो ययौ॥ १०/१०२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.042.m4a", "display_order": 43}, {"id": 6000298043, "chapter_id": 10298, "verse_number": "१०-१०२-३७", "content_sanskrit": "तत्र गत्वा प्रविष्टायां तत्पत्न्यां सूतिकागृहम्।\nब्राह्मणं प्राह बीभत्सुरवरोप्य रथान्नृप॥ १०/१०२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.043.m4a", "display_order": 44}, {"id": 6000298044, "chapter_id": 10298, "verse_number": null, "content_sanskrit": "अर्जुन उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.044.m4a", "display_order": 45}, {"id": 6000298045, "chapter_id": 10298, "verse_number": "१०-१०२-३८", "content_sanskrit": "याहि स्वभवनं ब्रह्मन्नभयं तव सर्वतः।\nदत्तं मयाऽद्य तद् भीतां पत्नीमाश्वासयाशु ते॥ १०/१०२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.045.m4a", "display_order": 46}, {"id": 6000298046, "chapter_id": 10298, "verse_number": "१०-१०२-३९", "content_sanskrit": "इति विस्रम्भितो विप्रः फल्गुनेन परन्तप।\nजगाम स्वगृहे प्रीत्या पार्थवीर्यं निशम्य तत्॥ १०/१०२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.046.m4a", "display_order": 47}, {"id": 6000298047, "chapter_id": 10298, "verse_number": "१०-१०२-४०", "content_sanskrit": "प्रसूतिकाल आसन्ने भार्याया द्विजसत्तमः।\nप्रोवाच द्रुतमभ्येत्य पार्थं शस्‍त्रभृतां वरम्॥ १०/१०२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.047.m4a", "display_order": 48}, {"id": 6000298048, "chapter_id": 10298, "verse_number": null, "content_sanskrit": "ब्राह्मण उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.048.m4a", "display_order": 49}, {"id": 6000298049, "chapter_id": 10298, "verse_number": "१०-१०२-४१", "content_sanskrit": "एहि पार्थ महाबाहो यत्तो भव युधां वर।\nअत्र पूर्वकृतानां हि पौरुषाणां निदर्शनम्॥ १०/१०२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.049.m4a", "display_order": 50}, {"id": 6000298050, "chapter_id": 10298, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.050.m4a", "display_order": 51}, {"id": 6000298051, "chapter_id": 10298, "verse_number": "१०-१०२-४२", "content_sanskrit": "इत्युक्तो रथमारुह्य सज्यं कृत्वा तु गाण्डिवम्।\nत्वरन् जगाम बीभत्सुः सूतिकाभवनान्तिकम्॥ १०/१०२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.051.m4a", "display_order": 52}, {"id": 6000298052, "chapter_id": 10298, "verse_number": "१०-१०२-४३", "content_sanskrit": "ब्राह्मणोऽपि प्रविश्याह मुहूर्ते सूतिकागृहे।\nगते तु पाहि पाहीति मृत्योरर्जुनमातुरः॥ १०/१०२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.052.m4a", "display_order": 53}, {"id": 6000298053, "chapter_id": 10298, "verse_number": "१०-१०२-४४", "content_sanskrit": "स उपस्पृश्य शुच्यम्भो नमस्कृत्य महेश्वरम्।\nदिव्यास्‍त्राणि च संस्मृत्य सज्यं गाण्डीवमाददे॥ १०/१०२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.053.m4a", "display_order": 54}, {"id": 6000298054, "chapter_id": 10298, "verse_number": "१०-१०२-४५", "content_sanskrit": "न्यरुणत् सूतिकागारं शरैर्नानास्‍त्रयोजितैः।\nतिर्यगूर्ध्वमधः पार्थश्चकार शरपञ्जरम्॥ १०/१०२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.054.m4a", "display_order": 55}, {"id": 6000298055, "chapter_id": 10298, "verse_number": "१०-१०२-४६", "content_sanskrit": "ततः कुमारः सञ्जातो विप्रपत्न्या रुदन् मुहुः।\nसद्योऽदर्शनमापेदे सशरीरो विहायसा॥ १०/१०२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.055.m4a", "display_order": 56}, {"id": 6000298056, "chapter_id": 10298, "verse_number": "१०-१०२-४७", "content_sanskrit": "तदाऽऽह विप्रो विजयं विनिन्दन् कृष्णसन्निधौ।\nमौढ्याद् यस्य तवाहं वै श्रद्दधे क्लीबकत्थनम्॥ १०/१०२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.056.m4a", "display_order": 57}, {"id": 6000298057, "chapter_id": 10298, "verse_number": "१०-१०२-४८", "content_sanskrit": "न प्रद्युम्नोऽनिरुद्धो वा न रामो न च केशवः।\nयस्य शेकुः परित्रातुं कोऽन्यस्तदधिकेश्वरः॥ १०/१०२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.057.m4a", "display_order": 58}, {"id": 6000298058, "chapter_id": 10298, "verse_number": "१०-१०२-४९", "content_sanskrit": "धिगर्जुनं वृथावाचं धिगात्मश्लाघिनो धनुः।\nदैवोपसृष्टयोर्मौढ्यादानिनीषति दुर्मतिः॥ १०/१०२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.058.m4a", "display_order": 59}, {"id": 6000298059, "chapter_id": 10298, "verse_number": "१०-१०२-५०", "content_sanskrit": "एवं शपति विप्रर्षौ विद्यामास्थाय फल्गुनः।\nययौ संयमनीमाशु यत्रास्ते भगवान् यमः॥ १०/१०२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.059.m4a", "display_order": 60}, {"id": 6000298060, "chapter_id": 10298, "verse_number": "१०-१०२-५१", "content_sanskrit": "विप्रापत्यमचक्षाणस्तत ऐन्द्रीमगात् पुरम्।\nआग्नेयीं नैर्ऋतीं सौम्यां वायव्यां वारुणीमथ॥ १०/१०२/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.060.m4a", "display_order": 61}, {"id": 6000298061, "chapter_id": 10298, "verse_number": "१०-१०२-५२", "content_sanskrit": "रसातलं नागपुरं धिष्ण्यान्यन्यान्युदायुधः।\nततोऽलब्धद्विजसुतो ह्यनिस्तीर्णप्रतिश्रुतः॥ १०/१०२/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.061.m4a", "display_order": 62}, {"id": 6000298062, "chapter_id": 10298, "verse_number": "१०-१०२-५३", "content_sanskrit": "अग्निं विविक्षुः कृष्णेन प्रत्युक्तः प्रतिषेधता। दर्शये द्विजसूनूंस्ते मा वध्यात्मानमात्मना।\nएतेन कीर्तिं विमलां मानुष्यं स्थापयिष्यसि॥ १०/१०२/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.062.m4a", "display_order": 63}, {"id": 6000298063, "chapter_id": 10298, "verse_number": "१०-१०२-५४", "content_sanskrit": "इति सम्भाष्य भगवानर्जुनं स महेश्वरः।\nसहैव रथमास्थाय प्राचीं दिशमवीविशत्॥ १०/१०२/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.063.m4a", "display_order": 64}, {"id": 6000298064, "chapter_id": 10298, "verse_number": "१०-१०२-५५", "content_sanskrit": "सप्तद्वीपान् सप्तसिन्धून् सप्त सप्त गिरीनथ।\nलोकालोकं तथाऽतीत्य विवेश सुमहत् तमः॥ १०/१०२/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.064.m4a", "display_order": 65}, {"id": 6000298065, "chapter_id": 10298, "verse_number": "१०-१०२-५६", "content_sanskrit": "तत्राश्वाः शैब्यसुग्रीवमेघपुष्पबलाहकाः।\nतमसा भ्रष्टगतयो बभूवुर्भरतर्षभ॥ १०/१०२/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.065.m4a", "display_order": 66}, {"id": 6000298066, "chapter_id": 10298, "verse_number": "१०-१०२-५७", "content_sanskrit": "तद् दृष्ट्वा भगवान् कृष्णो महायोगेश्वरेश्वरः।\nसहस्रादित्यसङ्काशं स्वचक्रं प्राहिणोत् पुरः॥ १०/१०२/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.066.m4a", "display_order": 67}, {"id": 6000298067, "chapter_id": 10298, "verse_number": "१०-१०२-५८", "content_sanskrit": "तमः सुघोरं गगनच्छदं महद् विदारयद् भूरितरेण रोचिषा।\nमनोजवं निर्विविशे सुदर्शनं गुणच्युतो रामशरो यथा चमूः॥ १०/१०२/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.067.m4a", "display_order": 68}, {"id": 6000298068, "chapter_id": 10298, "verse_number": "१०-१०२-५९", "content_sanskrit": "द्वारेण चक्रानुपथे यदूत्तमं परात्परं ज्योतिरनन्तपारम्।\nसमश्नुवानं प्रसमीक्ष्य फल्गुनः प्रदीपिताक्षः पिदधेऽक्षिणी उभे॥ १०/१०२/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.068.m4a", "display_order": 69}, {"id": 6000298069, "chapter_id": 10298, "verse_number": "१०-१०२-६०", "content_sanskrit": "ततः प्रविष्टः सलिलं नभस्वता बलीयसैजद्बृहदूर्मिभीषणम्।\nतत्राद्भुतं वै भवनं द्युमत्तमं भ्राजन्मणिस्तम्भसहस्रशोभितम्॥ १०/१०२/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.069.m4a", "display_order": 70}, {"id": 6000298070, "chapter_id": 10298, "verse_number": "१०-१०२-६१", "content_sanskrit": "तस्मिन् महाभीममनन्तमद्भुतं सहस्रमूर्धन्यफणामणिद्युतिम्।\nविभ्राजमानं द्विगुणेक्षणोल्बणं सिताम्बराभंं शितिकण्ठजिह्मगम्॥ १०/१०२/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.070.m4a", "display_order": 71}, {"id": 6000298071, "chapter_id": 10298, "verse_number": "१०-१०२-६२", "content_sanskrit": "ददर्श तद्भोगसुखासनं विभुं महानुभावं पुरुषोत्तमोत्तमम्।\nसान्द्राम्बुदाभं सुपिशङ्गवाससं प्रसन्नवक्त्रं रुचिरस्मितेक्षणम्॥ १०/१०२/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.071.m4a", "display_order": 72}, {"id": 6000298072, "chapter_id": 10298, "verse_number": "१०-१०२-६३", "content_sanskrit": "महामणिव्रातकिरीटकुण्डलत्विषा परिष्वक्तसहस्रकुन्तलम्।\nप्रलम्बचार्वष्टभुजं सकौस्तुभं श्रीवत्सलक्ष्मं वनमालयाऽऽवृतम्॥ १०/१०२/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.072.m4a", "display_order": 73}, {"id": 6000298073, "chapter_id": 10298, "verse_number": "१०-१०२-६४", "content_sanskrit": "सुनन्दनन्दप्रमुखैश्च पार्षदैश्चक्रादिभिर्मूर्तिधरैर्निजायुधैः।\nपुष्ट्या श्रिया कीर्त्यजयाऽखिलर्द्धिभिर्निषेव्यमाणं परमेष्ठिनां पतिम्॥ १०/१०२/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.073.m4a", "display_order": 74}, {"id": 6000298074, "chapter_id": 10298, "verse_number": "१०-१०२-६५", "content_sanskrit": "ववन्द आत्मानमनन्तमच्युतो जिष्णुश्च तद्दर्शनजातसाध्वसः।\nस चाह भूमा परमेष्ठिनां प्रभुर्बद्धाञ्जलिं सस्मितपूर्वया गिरा॥ १०/१०२/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.074.m4a", "display_order": 75}, {"id": 6000298075, "chapter_id": 10298, "verse_number": "१०-१०२-६६", "content_sanskrit": "द्विजात्मजास्ते युवयोर्दिदृक्षया मयोपनीता भुवि धर्मगुप्तये।\nकलावतीर्णोऽस्यवनेर्भरासुरान् हत्वेह भूयस्त्वरयैहि मेऽन्तिकम्॥ १०/१०२/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.075.m4a", "display_order": 76}, {"id": 6000298076, "chapter_id": 10298, "verse_number": "१०-१०२-६७", "content_sanskrit": "पूर्णकामावपि युवां नरनारायणावृषी।\nधर्ममाचरतां स्थित्यै वृषभौ लोकसङ्ग्रहम्॥ १०/१०२/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.076.m4a", "display_order": 77}, {"id": 6000298077, "chapter_id": 10298, "verse_number": "१०-१०२-६८", "content_sanskrit": "इत्यादिष्टौ भगवता तौ कृष्णौ परमेष्ठिना।\nओमित्यानन्दभूमानमादाय द्विजदारकान्॥ १०/१०२/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.077.m4a", "display_order": 78}, {"id": 6000298078, "chapter_id": 10298, "verse_number": "१०-१०२-६९", "content_sanskrit": "न्यवर्ततां स्वकं धाम सम्प्रहृष्टौ यथागतम्।\nविप्राय ददतुः पुत्रान् यथारूपं प्रसूयताम्॥ १०/१०२/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.078.m4a", "display_order": 79}, {"id": 6000298079, "chapter_id": 10298, "verse_number": "१०-१०२-७०", "content_sanskrit": "निशाम्य वैष्णवं धाम पार्थः परमविस्मितः।\nयत् किञ्चित् पौरुषं पुंसां मेने कृष्णानुकम्पितम्॥ १०/१०२/७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.079.m4a", "display_order": 80}, {"id": 6000298080, "chapter_id": 10298, "verse_number": "१०-१०२-७१", "content_sanskrit": "तदा प्रविश्य गोविन्दो यज्ञवाटं पुनः स्वयम्।\nपूर्णं पुरोहितैर्विप्रैर्ऋत्विग्भिः क्षत्रियर्षभैः॥ १०/१०२/७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.080.m4a", "display_order": 81}, {"id": 6000298081, "chapter_id": 10298, "verse_number": "१०-१०२-७२", "content_sanskrit": "प्रायश्चित्तं तु चलने दीक्षायां य उदाहृतः।\nतं चकार यथान्यायं ब्राह्मणैरनुमोदितः॥ १०/१०२/७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.081.m4a", "display_order": 82}, {"id": 6000298082, "chapter_id": 10298, "verse_number": "१०-१०२-७३", "content_sanskrit": "समाप्य यज्ञं विधिवत् तर्पयित्वाऽर्थिनो द्विजान्।\nऋत्विग्भ्यः पूजयित्वाऽन्यान् ऋषींश्च कुरुसत्तम॥ १०/१०२/७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_102/BhP_10.102.082.m4a", "display_order": 83}, {"id": 6000298083, "chapter_id": 10298, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे द्व्यधिकशततमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]