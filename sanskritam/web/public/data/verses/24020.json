[{"id": 7004020000, "chapter_id": 24020, "verse_number": "३-२-३१-१", "content_sanskrit": "श्रीराम उवाच ।\nभगवन्यानि तीर्थानि सेवितानि त्वया विभो ।\nएतेषां परमं तीर्थं तन्ममाचक्ष्व मानद॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004020001, "chapter_id": 24020, "verse_number": "३-२-३१-२", "content_sanskrit": "मया तु सीताहरणे निहता ब्रह्मराक्षसाः ।\nतत्पापस्य विशुदयर्थं वद तीर्थोत्तमोत्तमम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004020002, "chapter_id": 24020, "verse_number": "३-२-३१-३", "content_sanskrit": "वसिष्ठ उवाच ।\nगंगा च नर्मदा तापी यमुना च सरस्वती ।\nगंडकी गोमती पूर्णा एता नद्यः सुपावनाः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004020003, "chapter_id": 24020, "verse_number": "३-२-३१-४", "content_sanskrit": "एतासां नर्मदा श्रेष्ठा गंगा त्रिपथगामिनी ।\nदहते किल्बिषं सर्वं दर्शनादेव राघव॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004020004, "chapter_id": 24020, "verse_number": "३-२-३१-५", "content_sanskrit": "दृष्ट्वा जन्मशतं पापं गत्वा जन्मशतत्रयम् ।\nस्नात्वा जन्मसहस्रं च हंति रेवा कलौ युगे॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004020005, "chapter_id": 24020, "verse_number": "३-२-३१-६", "content_sanskrit": "नर्मदातीरमाश्रित्य शाकमूलफलैरपि ।\nएकस्मिन्भोजिते विप्रे कोटि भोजफलं लभेत॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004020006, "chapter_id": 24020, "verse_number": "३-२-३१-७", "content_sanskrit": "गंगा गंगेति यो ब्रूयाद्योजनानां शतैरपि ।\nमुच्यते सर्वपापेभ्यो विष्णुलोकं स गच्छति॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004020007, "chapter_id": 24020, "verse_number": "३-२-३१-८", "content_sanskrit": "फाल्गुनांते कुहूं प्राप्य तथा प्रौष्ठपदेऽसिते ।\nपक्षे गंगामधि प्राप्य स्नानं च पितृतर्पणम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004020008, "chapter_id": 24020, "verse_number": "३-२-३१-९", "content_sanskrit": "कुरुते पिंडदानानि सोऽक्षयं फलमश्नुते ।\nशुचौ मासे च संप्राप्ते स्नानं वाप्यां करोति यः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004020009, "chapter_id": 24020, "verse_number": "३-२-३१-१०", "content_sanskrit": "चतुरशीतिनरकान्न पश्यति नरो नृप ।\nतपत्याः स्मरणे राम महापातकिनामपि॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004020010, "chapter_id": 24020, "verse_number": "३-२-३१-११", "content_sanskrit": "उद्धरेत्सप्तगोत्राणि कुलमेकोत्तरं शतम् ।\nयमुनायां नरः स्नात्वा सर्वपापैः प्रमुच्यते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004020011, "chapter_id": 24020, "verse_number": "३-२-३१-१२", "content_sanskrit": "महापातकयुक्तोऽपि स गच्छेत्परमां गतिम् ।\nकार्त्तिक्यां कृत्तिकायोगे सरस्वत्यां निमज्जयेत्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004020012, "chapter_id": 24020, "verse_number": "३-२-३१-१३", "content_sanskrit": "गच्छेत्स गरुडारूढः स्तूयमानः सुरोत्तमैः ।\nस्नात्वा यः कार्तिके मासि यत्र प्राची सरस्वती॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004020013, "chapter_id": 24020, "verse_number": "३-२-३१-१४", "content_sanskrit": "प्राचीं माधवमास्तूय स गच्छेत्परमां गतिम् ।\nगंडकीपुण्यतीर्थे हि स्नानं यः कुरुते नरः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004020014, "chapter_id": 24020, "verse_number": "३-२-३१-१५", "content_sanskrit": "शालग्रामशिलामर्च्य न भूयः स्तनपो भवेत् ।\nगोमतीजलकल्लोलैर्मज्जयेत्कृष्णसन्निधौ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004020015, "chapter_id": 24020, "verse_number": "३-२-३१-१६", "content_sanskrit": "चतुर्भुजो नरो भूत्वा वैकुण्ठे मोदते चिरम् ।\nचर्मण्वतीं नमस्कृत्य अपः स्पृशति यो नरः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004020016, "chapter_id": 24020, "verse_number": "३-२-३१-१७", "content_sanskrit": "स तारयति पूर्वजान्दश पूर्वान्दशापरान् ।\nद्वयोश्च संगमं दृष्ट्वा श्रुत्वा वा सागरध्वनिम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004020017, "chapter_id": 24020, "verse_number": "३-२-३१-१८", "content_sanskrit": "ब्रह्महत्यायुतो वापि पूतो गच्छेत्परां गतिम् ।\nमाघमासे प्रयागे तु मज्जनं कुरुते नरः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004020018, "chapter_id": 24020, "verse_number": "३-२-३१-१९", "content_sanskrit": "इह लोके सुखं भुक्त्वा अन्ते विष्णुपदं व्रजेत् ।\nप्रभासे ये नरा राम त्रिरात्रं ब्रह्मचारिणः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004020019, "chapter_id": 24020, "verse_number": "३-२-३१-२०", "content_sanskrit": "यमलोकं न पश्येयुः कुंभीपाकादिकं तथा ।\nनैमिषारण्यवासी यो नरो देवत्वमाप्नुयात्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004020020, "chapter_id": 24020, "verse_number": "३-२-३१-२१", "content_sanskrit": "देवानामालयं यस्मात्तदेव भुवि दुर्लभम् ।\nकुरुक्षेत्रे नरो राम ग्रहणे चन्द्रसूर्ययोः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004020021, "chapter_id": 24020, "verse_number": "३-२-३१-२२", "content_sanskrit": "हेमदानाच्च राजेंद्र न भूयः स्तनपो भवेत् ।\nश्रीस्थले दर्शनं कृत्वा नरः पापात्प्रमुच्यते॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004020022, "chapter_id": 24020, "verse_number": "३-२-३१-२३", "content_sanskrit": "सर्वदुःखविनाशे च विष्णुलोके महीयते ।\nकाश्यपीं स्पर्शयेद्यो गां मानवो भुवि राघव॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004020023, "chapter_id": 24020, "verse_number": "३-२-३१-२४", "content_sanskrit": "सर्वकामदुघावासमृषिलोकं स गच्छति ।\nउज्जयिन्यां तु वैशाखे शिप्रायां स्नानमाचरेत्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004020024, "chapter_id": 24020, "verse_number": "३-२-३१-२५", "content_sanskrit": "मोचयेद्रौरवाद्घोरात्पूर्वजांश्च सहस्रशः ।\nसिंधुस्नानं नरो राम प्रकरोति दिनत्रयम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004020025, "chapter_id": 24020, "verse_number": "३-२-३१-२६", "content_sanskrit": "सर्वपापविशुद्धात्मा कैलासे मोदते नरः ।\nकोटितीर्थे नरः स्नात्वा दृष्ट्वा कोटीश्वरं शिवम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004020026, "chapter_id": 24020, "verse_number": "३-२-३१-२७", "content_sanskrit": "ब्रह्महत्यादिभिः पापैर्लिप्यते न च स क्वचित् ।\nअज्ञानामपि जंतूनां महाऽमेध्ये तु गच्छताम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004020027, "chapter_id": 24020, "verse_number": "३-२-३१-२८", "content_sanskrit": "पादोद्भूतं पयः पीत्वा सर्वपापं प्रणश्यति ।\nवेदवत्यां नरो यस्तु स्नाति सूर्योदये शुभे॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004020028, "chapter_id": 24020, "verse_number": "३-२-३१-२९", "content_sanskrit": "सर्वरोगात्प्रमुच्येत परं सुखमवाप्नुयात् ।\nतीर्थानि राम सर्वत्र स्नानपानावगाहनैः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004020029, "chapter_id": 24020, "verse_number": "३-२-३१-३०", "content_sanskrit": "नाशयंति मनुष्याणां सर्वपापानि लीलया ।\nतीर्थानां परमं तीर्थं धर्मारण्यं प्रचक्षते॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004020030, "chapter_id": 24020, "verse_number": "३-२-३१-३१", "content_sanskrit": "ब्रह्मविष्णुशिवाद्यैर्यदादौ संस्थापितं पुरा ।\nअरण्यानां च सर्वेषां तीर्थानां च विशेषतः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004020031, "chapter_id": 24020, "verse_number": "३-२-३१-३२", "content_sanskrit": "धर्मारण्यात्परं नास्ति भुक्तिमुक्तिप्रदायकम् ।\nस्वर्गे देवाः प्रशंसंति धर्मारण्यनिवासिनः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004020032, "chapter_id": 24020, "verse_number": "३-२-३१-३३", "content_sanskrit": "ते पुण्यास्ते पुण्यकृतो ये वसंति कलौ नराः ।\nधर्मारण्ये रामदेव सर्वकिल्बिषनाशने॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004020033, "chapter_id": 24020, "verse_number": "३-२-३१-३४", "content_sanskrit": "ब्रह्महत्यादिपापानि सर्वस्तेयकृतानि च ।\nपरदारप्रसंगादि अभक्ष्यभक्षणादि वै॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004020034, "chapter_id": 24020, "verse_number": "३-२-३१-३५", "content_sanskrit": "अगम्यागमना यानि अस्पर्शस्पर्शनादि च ।\nभस्मीभवंति लोकानां धर्मारण्यावगाहनात्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004020035, "chapter_id": 24020, "verse_number": "३-२-३१-३६", "content_sanskrit": "ब्रह्मघ्नश्च कृतघ्नश्च बालघ्नोऽनृतभाषणः ।\nस्त्रीगोघ्नश्चैव ग्रामघ्रो धर्मारण्ये विमुच्यते॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004020036, "chapter_id": 24020, "verse_number": "३-२-३१-३७", "content_sanskrit": "नातः परं पावनं हि पापिनां प्राणिनां भुवि ।\nस्वर्ग्यं यशस्यमायुष्यं वांछितार्थप्रदं शुभम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004020037, "chapter_id": 24020, "verse_number": "३-२-३१-३८", "content_sanskrit": "कामिनां कामदं क्षेत्रं यतीनां मुक्तिदायकम् ।\nसिद्धानां सिद्धिदं प्रोक्तं धर्मारण्यं युगेयुगे॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004020038, "chapter_id": 24020, "verse_number": "३-२-३१-३९", "content_sanskrit": "ब्रह्मोवाच ।\nवसिष्ठवचनं श्रुत्वा रामो धर्मभृतां वरः ।\nपरं हर्षमनुप्राप्य हृदयानंदकारकम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004020039, "chapter_id": 24020, "verse_number": "३-२-३१-४०", "content_sanskrit": "प्रोत्फुल्लहृदयो रामो रोमाचिंततनूरुहः ।\nगमनाय मतिं चक्रे धर्मारण्ये शुभव्रतः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004020040, "chapter_id": 24020, "verse_number": "३-२-३१-४१", "content_sanskrit": "यस्मिन्कीटपतंगादिमानुषाः पशवस्तथा ।\nत्रिरात्रसेवनेनैव मुच्यन्ते सर्वपातकैः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004020041, "chapter_id": 24020, "verse_number": "३-२-३१-४२", "content_sanskrit": "कुशस्थली यथा काशी शूलपाणिश्च भैरवः ।\nयथा वै मुक्तिदो राम धर्मारण्यं तथोत्तमम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004020042, "chapter_id": 24020, "verse_number": "३-२-३१-४३", "content_sanskrit": "ततो रामो महेष्वासो मुदा परमया युतः ।\nप्रस्थितस्तीर्थयात्रायां सीतया भ्रातृभिः सह॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004020043, "chapter_id": 24020, "verse_number": "३-२-३१-४४", "content_sanskrit": "अनुजग्मुस्तदा रामं हनुमांश्च कपीश्वरः ।\nकौशल्या च सुमित्रा च कैकेयी च मुदान्विता॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004020044, "chapter_id": 24020, "verse_number": "३-२-३१-४५", "content_sanskrit": "लक्ष्मणो लक्षणोपेतो भरतश्च महामतिः ।\nशत्रुघ्नः सैन्यसहितोप्ययोध्यावासिनस्तथा॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004020045, "chapter_id": 24020, "verse_number": "३-२-३१-४६", "content_sanskrit": "प्रकृतयो नरव्याघ्र धर्मारण्ये विनिर्ययुः ।\nअनुजग्मुस्तदा रामं मुदा परमया युताः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004020046, "chapter_id": 24020, "verse_number": "३-२-३१-४७", "content_sanskrit": "तीर्थयात्राविधिं कर्तुं गृहात्प्रचलितो नृपः ।\nवसिष्ठं स्वकुलाचार्यमिदमाह महीपते॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004020047, "chapter_id": 24020, "verse_number": "३-२-३१-४८", "content_sanskrit": "श्रीराम उवाच ।\nएतदाश्चर्यमतुलं किमादि द्वारकाभवत् ।\nकियत्कालसमुत्पन्ना वसिष्ठेदं वदस्व मे॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004020048, "chapter_id": 24020, "verse_number": "३-२-३१-४९", "content_sanskrit": "वसिष्ठ उवाच ।\nन जानामि महाराज कियत्कालादभूदिदम् ।\nलोमशो जांबवांश्चैव जानातीति च कारणम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004020049, "chapter_id": 24020, "verse_number": "३-२-३१-५०", "content_sanskrit": "शरीरे यत्कृतं पापं नानाजन्मांतरेष्वपि ।\nप्रायश्चितं हि सर्वेषामेतत्क्षेत्र परं स्मृतम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004020050, "chapter_id": 24020, "verse_number": "३-२-३१-५१", "content_sanskrit": "श्रुत्वेति वचनं तस्य रामं ज्ञानवतां वरः ।\nगन्तुं कृतमतिस्तीर्थं यात्राविधिमथाचरत्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004020051, "chapter_id": 24020, "verse_number": "३-२-३१-५२", "content_sanskrit": "वसिष्ठं चाग्रतः कृत्वा महामांडलिकैर्नृपैः ।\nपुनश्चरविधिं कृत्वा प्रस्थितश्चोत्तरां दिशम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004020052, "chapter_id": 24020, "verse_number": "३-२-३१-५३", "content_sanskrit": "वसिष्ठं चाग्रतः कृत्वा प्रतस्थे पश्चिमां दिशम् ।\nग्रामाद्ग्राममतिक्रम्य देशाद्देशं वनाद्वनम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004020053, "chapter_id": 24020, "verse_number": "३-२-३१-५४", "content_sanskrit": "विमुच्य निर्ययौ रामः ससैन्यः सपरिच्छदः ।\nगजवाजिसहस्रौघै रथैर्यानैश्च कोटिभिः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004020054, "chapter_id": 24020, "verse_number": "३-२-३१-५५", "content_sanskrit": "शिबिकाभिश्चासंख्याभिः प्रययौ राघवस्तदा ।\nगजारूढः प्रपश्यंश्च देशान्विविधसौहृदान्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004020055, "chapter_id": 24020, "verse_number": "३-२-३१-५६", "content_sanskrit": "श्वेतातपत्रं विधृत्य चामरेण शुभेन च ।\nवीजितश्च जनौघेन रामस्तत्र समभ्यगात्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004020056, "chapter_id": 24020, "verse_number": "३-२-३१-५७", "content_sanskrit": "वादित्राणां स्वनैघोरैर्नृत्यगीतपुरःसरैः ।\nस्तूयमानोपि सूतैश्च ययौ रामो मुदान्वितः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004020057, "chapter_id": 24020, "verse_number": "३-२-३१-५८", "content_sanskrit": "दशमेऽहनि संप्राप्तं धर्मारण्यमनुत्तमम् ।\nअदूरे हि ततो रामो दृष्ट्वा मांडलिकं पुरम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004020058, "chapter_id": 24020, "verse_number": "३-२-३१-५९", "content_sanskrit": "तत्र स्थित्वा ससैन्यस्तु उवास निशि तां पुरीम् ।\nश्रुत्वा तु निर्जनं क्षेत्रमुद्वसं च भयानकम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004020059, "chapter_id": 24020, "verse_number": "३-२-३१-६०", "content_sanskrit": "व्याघ्रसिंहाकुलं तत्र यक्षराक्षससेवितम् ।\nश्रुत्वा जनमुखाद्रामो धर्मारण्यमरण्यकम् ।\nतच्छ्रुत्वा रामदेवस्तु न चिंता क्रियतामिति॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004020060, "chapter_id": 24020, "verse_number": "३-२-३१-६१", "content_sanskrit": "तत्रस्थान्वणिजः शूरान्दक्षान्स्वव्यवसायके॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004020061, "chapter_id": 24020, "verse_number": "३-२-३१-६२", "content_sanskrit": "समर्थान्हि महाकायान्महाबलपराक्रमान् ।\nसमाहूय तदा काले वाक्यमेतदथाब्रवीत्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004020062, "chapter_id": 24020, "verse_number": "३-२-३१-६३", "content_sanskrit": "शिबिकां सुसुवणां मे शीघ्रं वाहयताचिरम् ।\nयथा क्षणेन चैकेन धर्मरण्यं व्रजाम्यहम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004020063, "chapter_id": 24020, "verse_number": "३-२-३१-६४", "content_sanskrit": "तत्र स्नात्वा च पीत्वा च सर्वपापात्प्रमुच्यते ।\nएवं ते वणिजः सर्वै रामेण प्रेरितास्तदा॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004020064, "chapter_id": 24020, "verse_number": "३-२-३१-६५", "content_sanskrit": "तथेत्युक्त्वा च ते सर्वे ऊहुस्तच्छिबिकां तदा ।\nक्षेत्रमध्ये यदा रामः प्रविष्टः सहसैनिकः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004020065, "chapter_id": 24020, "verse_number": "३-२-३१-६६", "content_sanskrit": "तद्यानस्य गतिर्मंदा संजाता किल भारत ।\nमंदशब्दानि वाद्यानि मातंगा मंदगामिनः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004020066, "chapter_id": 24020, "verse_number": "३-२-३१-६७", "content_sanskrit": "हयाश्च तादृशा जाता रामो विस्मय मागतः ।\nगुरुं पप्रच्छ विनयाद्वशिष्ठं मुनिपुंगवम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004020067, "chapter_id": 24020, "verse_number": "३-२-३१-६८", "content_sanskrit": "किमेतन्मंदगतयश्चित्रं हृदि मुनीश्वर ।\nत्रिकालज्ञो मुनिः प्राह धर्मक्षेत्रमुपागतम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004020068, "chapter_id": 24020, "verse_number": "३-२-३१-६९", "content_sanskrit": "तीर्थे पुरातने राम पादचारेण गम्यते ।\nएवं कृते ततः पश्चात्सैन्यसौख्यं भविष्यति॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004020069, "chapter_id": 24020, "verse_number": "३-२-३१-७०", "content_sanskrit": "पादचारी ततौ रामः सैन्येन सह संयुतः ।\nमधुवासनके ग्रामे प्राप्तः परमभावनः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004020070, "chapter_id": 24020, "verse_number": "३-२-३१-७१", "content_sanskrit": "गुरुणा चोक्तमार्गेण मातॄणां पूजनं कृतम् ।\nनानोपहारैर्विविधैः प्रतिष्ठाविधिपूर्वकम्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004020071, "chapter_id": 24020, "verse_number": "३-२-३१-७२", "content_sanskrit": "ततो रामो हरिक्षेत्रं सुवर्णादक्षिणे तटे ।\nनिरीक्ष्य यज्ञयोग्याश्च भूमीर्वै बहुशस्तथा॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004020072, "chapter_id": 24020, "verse_number": "३-२-३१-७३", "content_sanskrit": "कृतकृत्यं तदात्मानं मेने रामो रघूद्वहः ।\nधर्मस्थानं निरीक्ष्याथ सुवर्णाक्षोत्तरे तटे॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004020073, "chapter_id": 24020, "verse_number": "३-२-३१-७४", "content_sanskrit": "सैन्यसंघं समुत्तीर्य्य बभ्राम क्षेत्रमध्यतः ।\nतत्र तीर्थेषु सर्वेषु देवतायतनेषु च॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004020074, "chapter_id": 24020, "verse_number": "३-२-३१-७५", "content_sanskrit": "यथोक्तानि च कर्माणि रामश्चक्रे विधानतः ।\nश्राद्धानि विधिवच्चक्रे श्रद्धया परया युतः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004020075, "chapter_id": 24020, "verse_number": "३-२-३१-७६", "content_sanskrit": "स्थापयामास रामेशं तथा कामेश्वरं पुनः ।\nस्थानाद्वायुप्रदेशे तु सुवर्णो भयतस्तटे॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004020076, "chapter_id": 24020, "verse_number": "३-२-३१-७७", "content_sanskrit": "कृत्वैवं कृतकृत्योऽभूद्रामो दशरथात्मजः ।\nकृत्वा सर्वविधिं चैव सभायां समुपाविशत्॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004020077, "chapter_id": 24020, "verse_number": "३-२-३१-७८", "content_sanskrit": "तां निशां स नदीतीरे सुष्वाप रघुनंदनः ।\nततोऽर्द्धरात्रे संजाते रामो राजीवलोचनः॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004020078, "chapter_id": 24020, "verse_number": "३-२-३१-७९", "content_sanskrit": "जागृतस्तु तदा काल एकाकी धर्मवत्सलः ।\nअश्रौषीच्च क्षणे तस्मिन्रामो नारीविरोदनम्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004020079, "chapter_id": 24020, "verse_number": "३-२-३१-८०", "content_sanskrit": "निशायां करुणैर्वाक्यै रुदंतीं कुररीमिव ।\nचारैर्विलोकयामास रामस्तामतिसंभ्रमात्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004020080, "chapter_id": 24020, "verse_number": "३-२-३१-८१", "content_sanskrit": "दृष्ट्वातिविह्वलां नारीं क्रंदन्तीं करुणैः स्वरैः ।\nपृष्टा सा दुःखिता नारी रामदूतैस्तदानघ॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004020081, "chapter_id": 24020, "verse_number": "३-२-३१-८२", "content_sanskrit": "दूता ऊचुः ।\nकासि त्वं सुभगे नारि देवी वा दानवी नु किम् ।\nकेन वा त्रासितासि त्वं मुष्टं केन धनं तव॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004020082, "chapter_id": 24020, "verse_number": "३-२-३१-८३", "content_sanskrit": "विकला दारुणाञ्छब्दानुद्गिरंती मुहुर्मुहुः ।\nकथयस्व यथातथ्यं रामो राजाभिपृच्छति॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004020083, "chapter_id": 24020, "verse_number": "३-२-३१-८४", "content_sanskrit": "तयोक्तं स्वामिनं दूताः प्रेषयध्वं ममांतिकम् ।\nयथाहं मानसं दुःखं शांत्यै तस्मै निवेदये॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004020084, "chapter_id": 24020, "verse_number": "३-२-३१-८५", "content_sanskrit": "तथेत्युक्त्वा ततो दूता राममागत्य चाब्रुवन्॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]