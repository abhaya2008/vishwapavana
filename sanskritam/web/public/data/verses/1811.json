[{"id": 2037578, "chapter_id": 1811, "verse_number": "५-५६-०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037579, "chapter_id": 1811, "verse_number": "५-५६-१", "content_sanskrit": "अक्षौहिणीः सप्त लब्ध्वा राजभिः सह सञ्जय।\nकिंस्विदिच्छति कौन्तेयो युद्धप्रेप्सुर्युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037580, "chapter_id": 1811, "verse_number": "५-५६-२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037581, "chapter_id": 1811, "verse_number": "५-५६-२", "content_sanskrit": "अतीव मुदितो राजन्युद्धप्रेप्युर्युधिष्ठिरः।\nभीमसेनार्जुनौ चोभौ यमावपि न बिभ्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037582, "chapter_id": 1811, "verse_number": "५-५६-३", "content_sanskrit": "रथं तु दिव्यं कौन्तेयः सर्वा विभ्राजयन्दिशः।\nमन्त्रं जिज्ञासमानः सन्बीभत्सुः समयोजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037583, "chapter_id": 1811, "verse_number": "५-५६-४", "content_sanskrit": "तमपश्याम सन्नद्धं मेघं विद्युद्युतं यथा।\nसमन्तात्समभिध्या हृष्यमाणोऽभ्यभाषत।\nपूर्वरूपमिदं पश्य वयं जेष्याम सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037584, "chapter_id": 1811, "verse_number": "५-५६-५", "content_sanskrit": "बीभत्सुर्मां यथोवाच तथाऽवैम्यहमप्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037585, "chapter_id": 1811, "verse_number": "५-५६-६x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037586, "chapter_id": 1811, "verse_number": "५-५६-६", "content_sanskrit": "प्रशंसस्यभिनन्दंस्तान्पार्थानक्षपराजितान्।\nअर्जुनस्य रथे ब्रूहि कथमश्वाः कथं ध्वजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037587, "chapter_id": 1811, "verse_number": "५-५६-७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037588, "chapter_id": 1811, "verse_number": "५-५६-७", "content_sanskrit": "भौमनः सह शक्रेण बहुचित्रं विशांपते।\nरूपाणि कल्पयामास त्वष्टा धाता सदा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037589, "chapter_id": 1811, "verse_number": "५-५६-८", "content_sanskrit": "ध्वजे हि तस्मिन्रूपाणि चक्रुस्ते देवमायया।\nमहाधनानि दिव्यानि महान्ति च लघूनि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037590, "chapter_id": 1811, "verse_number": "५-५६-९", "content_sanskrit": "भीमसेनानुरोधायक हनूमान्मारुतात्मजः।\nआत्मप्रतिकृतिं तस्मिन्ध्वज आरोपयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037591, "chapter_id": 1811, "verse_number": "५-५६-१०", "content_sanskrit": "सर्वा दिशो योजनमात्रमन्तरं\nसतिर्यगूर्ध्वं च रुरोध वै ध्वजः।\nन संसञ्जेत्तरुभिः संवृतोऽपि\nतथा हि माया विहिता भौमनेन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037592, "chapter_id": 1811, "verse_number": "५-५६-११", "content_sanskrit": "यथाऽऽकाशे शक्रधनुः प्रकाशते\nन चैकवर्णं न च वेद्मि किं नु तत्।\nतथा ध्वजो विहितो भौमनेन\nबह्वाकारं दृश्यते रूपमस्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037593, "chapter_id": 1811, "verse_number": "५-५६-१२", "content_sanskrit": "यथाऽग्निधूमो दिवमेति रुद्ध्वा।\nवर्णान्बिभ्रत्तैजसांश्चित्ररूपान्।\nतथा ध्वजो विहितो भौमनेन\nन चेद्भारो भविता नोत रोधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037594, "chapter_id": 1811, "verse_number": "५-५६-१३", "content_sanskrit": "श्वेतास्तस्मिन्वातवेगाः सदश्वा\nदिव्या युक्ताश्चित्ररथेन दत्ताः।\nभुव्यन्तरिक्षे दिवि वा नरेन्द्र\nयेषां गतिर्हीयते नात्र सर्वा ।\nशतं यत्तत्पूर्यते नित्यकालं\nहतंहतं दत्तवरं पुरस्तात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037595, "chapter_id": 1811, "verse_number": "५-५६-१४", "content_sanskrit": "तथा राज्ञो दन्तवर्णा बृहन्तो\nरथे युक्ता भान्ति तद्वीर्यतुल्याः।\nऋक्षप्रख्या भीमसेनस्य वाहा\nरथे वायोस्तुल्यवेग बभूवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2037596, "chapter_id": 1811, "verse_number": "५-५६-१५", "content_sanskrit": "कल्माषाङ्गास्तित्तिरिचित्रपृष्ठा\nभ्रात्रा दत्ताः प्रीयता फाल्गुनेन।\nभ्रातुर्बीरस्य स्वैस्तुरङ्गैर्विशिष्टा\nमुदा युक्ताः सहदेवं वहन्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2037597, "chapter_id": 1811, "verse_number": "५-५६-१६", "content_sanskrit": "माद्रीपुत्रं नकुलं त्वाजमीढं\nमहेन्द्रदत्ता हरयो वाजिमुख्याः ।\nसमा वायोर्बलवन्तस्तरस्विनो\nवहन्ति वीरं वृत्रशत्रुं यथेन्द्रम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2037598, "chapter_id": 1811, "verse_number": "५-५६-१७", "content_sanskrit": "तुल्याश्चैभिर्वयसा विक्रमेण\nमहाजवाश्रित्ररूपाः सदश्वाः ।\nसौभद्रादीन्द्रौपदेयान्कुमारान्\nवहन्त्यश्वा देवदत्ता बृहन्तः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2037599, "chapter_id": 1811, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि षट्पञ्चाशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]