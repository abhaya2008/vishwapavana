[{"id": 2186594, "chapter_id": 4964, "verse_number": "", "content_sanskrit": "भृगुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2186595, "chapter_id": 4964, "verse_number": "१", "content_sanskrit": "न प्रणाशोऽस्ति जीवानां दत्तस्य च कृतस्य च ।\nयाति देहान्तरं प्राणी शरीरं तु विशीर्यते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2186596, "chapter_id": 4964, "verse_number": "२", "content_sanskrit": "न शरीराश्रितो जीवस्तस्मिन्नष्टे प्रणश्यति ।\nयथा समित्सु दग्धासु न प्रणश्यति पावकः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2186597, "chapter_id": 4964, "verse_number": "", "content_sanskrit": "भरद्वाजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2186598, "chapter_id": 4964, "verse_number": "३", "content_sanskrit": "अग्नेर्यथा तथा तस्य यदि नाशो न विद्यते ।\nइन्धनस्योपयोगान्ते स चाग्निर्नोपलभ्यते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2186599, "chapter_id": 4964, "verse_number": "४", "content_sanskrit": "नश्यतीत्येव जानामि शान्तमग्निमनिन्धनम् ।\nगतिर्यस्य प्रमाणं वा संस्थानं वा न दृश्यते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2186600, "chapter_id": 4964, "verse_number": "", "content_sanskrit": "भृगुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2186601, "chapter_id": 4964, "verse_number": "५", "content_sanskrit": "समिधामुपयोगान्ते स्वलिङ्गैरुपलभ्यते।\nआकाशानुगतत्वाद्धि दुर्ग्रहः स निराश्रयः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2186602, "chapter_id": 4964, "verse_number": "६", "content_sanskrit": "तथा शरीरसन्त्यागे जीवो ह्याकाशवत्स्थितः ।\nन गृह्यते सुसूक्ष्मत्वाद्यथा ज्योतिर्न संशयः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2186603, "chapter_id": 4964, "verse_number": "७", "content_sanskrit": "प्राणान् धारयते ह्यग्निः स जीव उपधीयते ।\nवायुसन्धारणो ह्यग्निर्नश्यत्युच्छ्वासनिग्रहात्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2186604, "chapter_id": 4964, "verse_number": "८", "content_sanskrit": "तस्मिन्नष्टे शरीराग्नौ शरीरं तदचेतनम् ।\nपतितं याति भूमित्वमयनं तस्य हि क्षितिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2186605, "chapter_id": 4964, "verse_number": "९", "content_sanskrit": "जङ्गमानां हि सर्वेषां स्थावराणां तथैव च ।\nआकाशं पवनोऽभ्येति ज्योतिस्तमनुगच्छति ।\nतत्र त्रयाणामेकत्वं द्वयं भूमौ प्रतिष्ठितम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2186606, "chapter_id": 4964, "verse_number": "१०", "content_sanskrit": "यत्र खं तत्र पवनस्तत्राग्निर्यत्र मारुतः ।\nअमूर्तयस्ते विज्ञेया आपो मूर्तास्तथा क्षितिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2186607, "chapter_id": 4964, "verse_number": "", "content_sanskrit": "भरद्वाजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2186608, "chapter_id": 4964, "verse_number": "११", "content_sanskrit": "यद्यग्निमारुतौ भूमिः खमापश्च शरीरिषु ।\nजीवः किंलक्षणस्तत्रेत्येतदाचक्ष्व मेऽनघ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2186609, "chapter_id": 4964, "verse_number": "१२", "content_sanskrit": "पञ्चात्मके पञ्चरतौ पञ्चविज्ञानसंयुते ।\nशरीरे प्राणिनां जीवं ज्ञातुमिच्छामि यादृशम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2186610, "chapter_id": 4964, "verse_number": "१३", "content_sanskrit": "मांसशोणितसङ्घाते मेदःस्नाय्वस्थिसञ्चये ।\nभिद्यमाने शरीरे तु जीवो नैवोपलभ्यते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2186611, "chapter_id": 4964, "verse_number": "१४", "content_sanskrit": "यद्यजीवं शरीरं तु पञ्चभूतसमन्वितम् ।\nशारीरे मानसे दुःखे कस्तां वेदयते रुजम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2186612, "chapter_id": 4964, "verse_number": "१५", "content_sanskrit": "शृणोति कथितं जीवः कर्णाभ्यां न शृणोति तत् ।\nमहर्षे मनसि व्यग्रे तस्माज्जीवो निरर्थकः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2186613, "chapter_id": 4964, "verse_number": "१६", "content_sanskrit": "सर्वं पश्यति यद्दृश्यं मनोयुक्तेन चक्षुषा ।\nमनसि व्याकुले तद्धि पश्यन्नपि न पश्यति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2186614, "chapter_id": 4964, "verse_number": "१७", "content_sanskrit": "न पश्यति न च ब्रूते न शृणोति न जिघ्रति ।\nन च स्पर्शरसौ वेत्ति निद्रावशगतः पुनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2186615, "chapter_id": 4964, "verse_number": "१८", "content_sanskrit": "हृष्यति क्रुध्यति च कः शोचत्युद्विजते च कः ।\nइच्छति ध्यायति द्वेष्टि वाचमीरयते च कः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2186616, "chapter_id": 4964, "verse_number": "", "content_sanskrit": "भृगुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2186617, "chapter_id": 4964, "verse_number": "१९", "content_sanskrit": "न पञ्चसाधारणमत्र किंचि-\nच्छरीरमेको वहतेऽन्तरात्मा ।\nस वेत्ति गन्धांश्च रसान् श्रुतीश्च\nस्पर्शं च रूपं च गुणाश्च येऽन्ये\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2186618, "chapter_id": 4964, "verse_number": "२०", "content_sanskrit": "पञ्चात्मके पञ्चगुणप्रदर्शी\nस सर्वगात्रानुगतोऽन्तरात्मा ।\nस वेत्ति दुःखानि सुखानि चात्र\nतद्विप्रयोगात्तु न वेत्ति देहः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2186619, "chapter_id": 4964, "verse_number": "२१", "content_sanskrit": "यदा न रूपं न स्पर्शो नोष्मभावश्च पावके ।\nतदा शान्ते शरीराग्नौ देहं त्यक्त्वा स नश्यति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2186620, "chapter_id": 4964, "verse_number": "२२", "content_sanskrit": "अम्मयं सर्वमेवेदमापो मूर्तिः शरीरिणाम् ।\nतत्रात्मा मानसो ब्रह्मा सर्वभूतेषु लोककृत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2186621, "chapter_id": 4964, "verse_number": "२३", "content_sanskrit": "आत्मानं तं विजानीहि तं वै तस्य विधायकम् ।\nतस्मिन् यः संश्रितो देहे ह्यब्बिन्दुरिव पुष्करे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2186622, "chapter_id": 4964, "verse_number": "२४", "content_sanskrit": "क्षेत्रज्ञं तं विजानीहि नित्यं लोकहितात्मकम् ।\nतमो रजश्च सत्त्वं च विद्धि जीवगुणानिमान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2186623, "chapter_id": 4964, "verse_number": "२५", "content_sanskrit": "सचेतनं जीवगुणं वदन्ति\nस चेष्टते चेष्टयते च सर्वम् ।\nततः परं क्षेत्रविदो वदन्ति\nप्रावर्तयद्यो भुवनानि सप्त\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2186624, "chapter_id": 4964, "verse_number": "२६", "content_sanskrit": "न जीवनाशोऽस्ति हि देहभेदे\nमिथ्यैतदाहुर्मृत इत्यबुद्धाः ।\nजीवस्तु देहान्तरितः प्रयाति\nदशार्धतैवास्य शरीरभेदः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2186625, "chapter_id": 4964, "verse_number": "२७", "content_sanskrit": "एवं सर्वेषु भूतेषु गूढश्चरति संवृतः ।\nदृश्यते त्वग्र्यया बुद्ध्या सूक्ष्मया तत्त्वदर्शिभिः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2186626, "chapter_id": 4964, "verse_number": "२८", "content_sanskrit": "तं पूर्वापररात्रेषु युञ्जानः सततं बुधः ।\nलघ्वाहारो विशुद्धात्मा पश्यत्यात्मानमात्मनि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2186627, "chapter_id": 4964, "verse_number": "२९", "content_sanskrit": "चित् तस्य हि प्रसादेन हित्वा कर्म शुभाशुभम् ।\nप्रसन्नात्मात्मनि स्थित्वा सुखमक्षयमश्नुते\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2186628, "chapter_id": 4964, "verse_number": "३०", "content_sanskrit": "मानसोऽग्निः शरीरेषु जीव इत्यभिधीयते ।\nसृष्टिः प्रजापतेरेषा भूताध्यात्मविनिश्चये\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2186629, "chapter_id": 4964, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे त्रयोदशोऽध्यायः ॥ १३ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]