[{"id": 6000300000, "chapter_id": 10300, "verse_number": null, "content_sanskrit": "अथ चतुराधिकशततमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000300001, "chapter_id": 10300, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_104/BhP_10.104.001.m4a", "display_order": 2}, {"id": 6000300002, "chapter_id": 10300, "verse_number": "१०-१०४-१", "content_sanskrit": "सुखं स्वपुर्यां न्यवसद् द्वारकायां श्रियः पतिः।\nसर्वसम्पत्समृद्धायां जुष्टायां वृष्णिपुङ्गवैः॥ १०/१०४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_104/BhP_10.104.002.m4a", "display_order": 3, "topics": [{"text": "द्वारावत्यां पत्नीभिः सहर्षं जलक्रीडादिभिः कृष्णस्य कालयापनम्", "range": "१–१३"}]}, {"id": 6000300003, "chapter_id": 10300, "verse_number": "१०-१०४-२", "content_sanskrit": "स्‍त्रीभिश्चोत्तमवेषाभिर्नवयौवनकान्तिभिः।\nकन्दुकैर्हर्म्यसौधेषु क्रीडन्तीभिस्तडिद्द्युभिः॥ १०/१०४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_104/BhP_10.104.003.m4a", "display_order": 4}, {"id": 6000300004, "chapter_id": 10300, "verse_number": "१०-१०४-३", "content_sanskrit": "नित्यं सङ्कुलमार्गायां मदच्युद्भिर्मतङ्गजैः।\nस्वलङ्कृतैर्भटैरश्वै रथैश्च कनकोज्वलैः॥ १०/१०४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_104/BhP_10.104.004.m4a", "display_order": 5}, {"id": 6000300005, "chapter_id": 10300, "verse_number": "१०-१०४-४", "content_sanskrit": "उद्यानोपवनाढ्यायां पुष्पितद्रुमराजिषु।\nनिर्विशद्भृङ्गविहगैर्नादितायां समन्ततः॥ १०/१०४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_104/BhP_10.104.005.m4a", "display_order": 6}, {"id": 6000300006, "chapter_id": 10300, "verse_number": "१०-१०४-५", "content_sanskrit": "रेमे षोडशसाहस्रपत्नीनामेकवल्लभः।\nतावन्ति बिभ्रद् रूपाणि तद्गेहेषु महर्द्धिषु॥ १०/१०४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_104/BhP_10.104.006.m4a", "display_order": 7}, {"id": 6000300007, "chapter_id": 10300, "verse_number": "१०-१०४-६", "content_sanskrit": "प्रोत्फुल्लोत्पलकल्हारकुमुदाम्भोजरेणुभिः।\nवासितामलतोयेषु कूजद्द्विजकुलेषु च॥ १०/१०४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_104/BhP_10.104.007.m4a", "display_order": 8}, {"id": 6000300008, "chapter_id": 10300, "verse_number": "१०-१०४-७", "content_sanskrit": "विजहार विगाह्याम्भो ह्रदिनीषु महोदयः।\nकुचकुङ्कुमलिप्ताङ्गः परिरब्धः स्वयोषिताम्॥ १०/१०४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_104/BhP_10.104.008.m4a", "display_order": 9}, {"id": 6000300009, "chapter_id": 10300, "verse_number": "१०-१०४-८", "content_sanskrit": "उपगीयमानो गन्धर्वैर्मृदङ्गपणवानकान्।\nवादयद्भिर्मुदा वीणाः सूतमागधवन्दिभिः॥ १०/१०४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_104/BhP_10.104.009.m4a", "display_order": 10}, {"id": 6000300010, "chapter_id": 10300, "verse_number": "१०-१०४-९", "content_sanskrit": "सेव्यमानोऽच्युतस्ताभिर्हसन्तीभिश्च रेचकैः।\nप्रतिषिञ्चन् विचिक्रीडे मुखरः शक्तिभिः स्वयम्॥ १०/१०४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_104/BhP_10.104.010.m4a", "display_order": 11}, {"id": 6000300011, "chapter_id": 10300, "verse_number": "१०-१०४-१०", "content_sanskrit": "ताः क्लिन्नवस्‍त्रविवृतोरुकुचप्रदेशाः सिञ्चन्त्य उद्धृतबृहत्कबरप्रसूनाः।\nकान्तस्य रेचकजिहीर्षतयोपगूह्य जातस्मरोत्स्मयलसद्वदना विरेजुः॥ १०/१०४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_104/BhP_10.104.011.m4a", "display_order": 12}, {"id": 6000300012, "chapter_id": 10300, "verse_number": "१०-१०४-११", "content_sanskrit": "कृष्णस्तु तत्स्तनविषज्जितकुङ्कुमस्रक्‍क्रीडाभिसङ्गतसकुन्तलकुन्दगन्धः।\nसिञ्चन् मुहुर्युवतिभिः परिषिच्यमानो रेमे करेणुभिरिवेभपतिः परीतः॥ १०/१०४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_104/BhP_10.104.012.m4a", "display_order": 13}, {"id": 6000300013, "chapter_id": 10300, "verse_number": "१०-१०४-१२", "content_sanskrit": "गृहेषु तासामनिवार्य ईश्वरो निरस्तसाम्यातिशयो व्यवस्थितः।\nरेमे रमाभिर्निजसौख्यसम्प्लुतो यथेतरो गार्हकमेधिकांश्चरन्॥ १०/१०४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_104/BhP_10.104.013.m4a", "display_order": 14}, {"id": 6000300014, "chapter_id": 10300, "verse_number": "१०-१०४-१३", "content_sanskrit": "इत्थं रमापतिमवाप्य पतिं स्‍त्रियस्ता ब्रह्मादयोऽपि पदवीं न विदुर्यदीयाम्।\nभेजुर्मुदाऽविरतमेधितयाऽनुरागहासावलोकनवसङ्गमलज्जयैव॥ १०/१०४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_104/BhP_10.104.014.m4a", "display_order": 15}, {"id": 6000300015, "chapter_id": 10300, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे चतुरधिकशततमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]