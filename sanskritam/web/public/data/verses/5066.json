[{"id": 2190991, "chapter_id": 5066, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2190992, "chapter_id": 5066, "verse_number": "१", "content_sanskrit": "अहो धर्मिष्ठता तात वृत्रस्यामिततेजसः ।\nयस्य विज्ञानमतुलं विष्णोर्भक्तिश्च तादृशी\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2190993, "chapter_id": 5066, "verse_number": "२", "content_sanskrit": "दुर्विज्ञेयमिदं तात विष्णोरमिततेजसः ।\nकथं वा राजशार्दूल पदं तज्ज्ञातवानसौ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2190994, "chapter_id": 5066, "verse_number": "३", "content_sanskrit": "भवता कथितं ह्येतच्छ्रद्दधे चाहमच्युत ।\nभूयस्तु मे समुत्पन्ना बुद्धिरव्यक्तदर्शनात्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2190995, "chapter_id": 5066, "verse_number": "४", "content_sanskrit": "कथं विनिहतो वृत्रः शक्रेण भरतर्षभ ।\nधर्मिष्ठो विष्णुभक्तश्च तत्त्वज्ञश्च पदान्वये\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2190996, "chapter_id": 5066, "verse_number": "५", "content_sanskrit": "एतन्मे संशयं ब्रूहि पृच्छतो भरतर्षभ ।\nवृत्रस्तु राजशार्दूल यथा शक्रेण निर्जितः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2190997, "chapter_id": 5066, "verse_number": "६", "content_sanskrit": "यथा चैवाभवद् युद्धं तच्चाचक्ष्व पितामह ।\nविस्तरेण महाबाहो परं कौतूहलं हि मे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2190998, "chapter_id": 5066, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2190999, "chapter_id": 5066, "verse_number": "७", "content_sanskrit": "रथेनेन्द्रः प्रयातो वै सार्धं सुरगणैः पुरा ।\nददर्शाथाग्रतो वृत्रं विष्ठितं पर्वतोपमम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2191000, "chapter_id": 5066, "verse_number": "८", "content_sanskrit": "योजनानां शतान्यूर्ध्वं पञ्चोच्छ्रितमरिन्दम ।\nशतानि विस्तरेणाथ त्रीण्येवाभ्यधिकानि तु\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2191001, "chapter_id": 5066, "verse_number": "९", "content_sanskrit": "तत् प्रेक्ष्य तादृशं रूपं त्रैलोक्येनापि दुर्जयम् ।\nवृत्रस्य देवाः सन्त्रस्ता न शान्तिमुपलेभिरे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2191002, "chapter_id": 5066, "verse_number": "१०", "content_sanskrit": "शक्रस्य तु तदा राजन्नूरुस्तम्भो व्यजायत ।\nभयाद्वृत्रस्य सहसा दृष्ट्वा तद्रूपमुत्तमम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2191003, "chapter_id": 5066, "verse_number": "११", "content_sanskrit": "ततो नादः समभवद् वादित्राणां च निस्वनः ।\nदेवासुराणां सर्वेषां तस्मिन् युद्ध उपस्थिते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2191004, "chapter_id": 5066, "verse_number": "", "content_sanskrit": "अथ वृत्रस्य कौरव्य दृष्ट्वा शक्रमुपस्थितम् ।\nन सम्भ्रमो न भीः काचिदास्था वा समजायत\t॥१२ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2191005, "chapter_id": 5066, "verse_number": "१३", "content_sanskrit": "ततः समभवद् युद्धं त्रैलोक्यस्य भयङ्करम् ।\nशक्रस्य च सुरेन्द्रस्य वृत्रस्य च महात्मनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2191006, "chapter_id": 5066, "verse_number": "१४", "content_sanskrit": "असिभिः पट्टिशैः शूलैः शक्तितोमरमुद्गरैः ।\nशिलाभिर्विविधाभिश्च कार्मुकैश्च महास्वनैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2191007, "chapter_id": 5066, "verse_number": "१५", "content_sanskrit": "अस्त्रैश्च विविधैर्दिव्यैः पावकोल्काभिरेव च ।\nदेवासुरैस्ततः सैन्यैः सर्वमासीत् समाकुलम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2191008, "chapter_id": 5066, "verse_number": "१६", "content_sanskrit": "पितामहपुरोगाश्च सर्वे देवगणास्तथा ।\nऋषयश्च महाभागास्तद्युद्धं द्रष्टुमागमन्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2191009, "chapter_id": 5066, "verse_number": "१७", "content_sanskrit": "विमानाग्र्यैर्महाराज सिद्धाश्च भरतर्षभ ।\nगन्धर्वाश्च विमानाग्र्यैरप्सरोभिः समागमन्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2191010, "chapter_id": 5066, "verse_number": "१८", "content_sanskrit": "ततोऽन्तरिक्षमावृत्य वृत्रो धर्मभृतां वरः ।\nअश्मवर्षेण देवेन्द्रं पर्वतात् समवाकिरत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2191011, "chapter_id": 5066, "verse_number": "१९", "content_sanskrit": "ततो देवगणाः क्रुद्धाः सर्वतः शस्त्रवृष्टिभिः ।\nअश्मवर्षमपोहन्त वृत्रप्रेरितमाहवे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2191012, "chapter_id": 5066, "verse_number": "२०", "content_sanskrit": "वृत्रश्च कुरुशार्दूल महामायो महाबलः ।\nमोहयामास देवेन्द्रं मायायुद्धेन सर्वतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2191013, "chapter_id": 5066, "verse_number": "२१", "content_sanskrit": "तस्य वृत्रार्दितस्याथ मोह आसीच्छतक्रतोः ।\nरथन्तरेण तं तत्र वसिष्ठः समबोधयत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2191014, "chapter_id": 5066, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2191015, "chapter_id": 5066, "verse_number": "२२", "content_sanskrit": "देवश्रेष्ठोऽसि देवेन्द्र सुरारिविनिबर्हण ।\nत्रैलोक्यबलसंयुक्तः कस्माच्छक्र विषीदसि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2191016, "chapter_id": 5066, "verse_number": "२३", "content_sanskrit": "एष ब्रह्मा च विष्णुश्च शिवश्चैव जगत्प्रभुः ।\nसोमश्च भगवान्देवः सर्वे च परमर्षयः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2191017, "chapter_id": 5066, "verse_number": "२४", "content_sanskrit": "मा कार्षीः कश्मलं शक्र कश्चिदेवेतरो यथा ।\nआर्यां युद्धे मतिं कृत्वा जहि शत्रुं सुरेश्वर\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2191018, "chapter_id": 5066, "verse_number": "२५", "content_sanskrit": "एष लोकगुरुस्त्र्यक्षः सर्वलोकनमस्कृतः ।\nनिरीक्षते त्वां भगवांस्त्यज मोहं सुरेश्वर\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2191019, "chapter_id": 5066, "verse_number": "२६", "content_sanskrit": "एते ब्रह्मर्षयश्चैव बृहस्पतिपुरोगमाः ।\nस्तवेन शक्र दिव्येन स्तुवन्ति त्वां जयाय वै\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2191020, "chapter_id": 5066, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2191021, "chapter_id": 5066, "verse_number": "२७", "content_sanskrit": "एवं सम्बोद्ध्यमानस्य वसिष्ठेन महात्मना ।\nअतीव वासवस्यासीद् बलमुत्तमतेजसः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2191022, "chapter_id": 5066, "verse_number": "२८", "content_sanskrit": "ततो बुद्धिमुपागम्य भगवान् पाकशासनः ।\nयोगेन महता युक्तस्तां मायां व्यपकर्षत\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2191023, "chapter_id": 5066, "verse_number": "२९", "content_sanskrit": "ततोऽङ्गिरःसुतः श्रीमांस्ते चैव परमर्षयः ।\nदृष्ट्वा वृत्रस्य विक्रान्तमुपगम्य महेश्वरम्॥\nऊचुर्वृत्रविनाशार्थं लोकानां हितकाम्यया\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2191024, "chapter_id": 5066, "verse_number": "३०", "content_sanskrit": "ततो भगवतस्तेजो ज्वरो भूत्वा जगत्पतेः ।\nसमाविशन् महारौद्रं वृत्रं दैत्यवरं तदा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2191025, "chapter_id": 5066, "verse_number": "३१", "content_sanskrit": "विष्णुश्च भगवान् देवः सर्वलोकाभिपूजितः ।\nऐन्द्रं समाविशद् वज्रं लोकसंरक्षणे रतः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2191026, "chapter_id": 5066, "verse_number": "३२", "content_sanskrit": "ततो बृहस्पतिर्धीमानुपागम्य शतक्रतुम् ।\nवसिष्ठश्च महातेजाः सर्वे च परमर्षयः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2191027, "chapter_id": 5066, "verse_number": "३३", "content_sanskrit": "ते समासाद्य वरदं वासवं लोकपूजितम् ।\nऊचुरेकाग्रमनसो जहि वृत्रमिति प्रभो\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2191028, "chapter_id": 5066, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2191029, "chapter_id": 5066, "verse_number": "३४", "content_sanskrit": "एष वृत्रो महान् शक्र बलेन महता वृतः ।\nविश्वात्मा सर्वगश्चैव बहुमायश्च विश्रुतः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2191030, "chapter_id": 5066, "verse_number": "३५", "content_sanskrit": "तदेनमसुरश्रेष्ठं त्रैलोक्येनापि दुर्जयम् ।\nजहि त्वं योगमास्थाय मावमंस्थाः सुरेश्वर\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2191031, "chapter_id": 5066, "verse_number": "३६", "content_sanskrit": "अनेन हि तपस्तप्तं बलार्थममराधिप ।\nषष्टिं वर्षसहस्राणि ब्रह्मा चास्मै वरं ददौ\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2191032, "chapter_id": 5066, "verse_number": "३७", "content_sanskrit": "महत्त्वं योगिनां चैव महामायत्वमेव च ।\nमहाबलत्वं च तथा तेजश्चाग्र्यं सुरेश्वर\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2191033, "chapter_id": 5066, "verse_number": "३८", "content_sanskrit": "एतद्वै मामकं तेजः समाविशति वासव ।\nवृत्रमेनं त्वमप्येवं जहि वज्रेण दानवम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2191034, "chapter_id": 5066, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2191035, "chapter_id": 5066, "verse_number": "३९", "content_sanskrit": "भगवंस्त्वत्प्रसादेन दितिजं सुदुरासदम् ।\nवज्रेण निहनिष्यामि पश्यतस्ते सुरर्षभ\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2191036, "chapter_id": 5066, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2191037, "chapter_id": 5066, "verse_number": "४०", "content_sanskrit": "आविश्यमाने दैत्ये तु ज्वरेणाथ महासुरे ।\nदेवतानामृषीणां च हर्षान्नादो महानभूत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2191038, "chapter_id": 5066, "verse_number": "४१", "content_sanskrit": "ततो दुन्दुभयश्चैव शङ्खाश्च सुमहास्वनाः ।\nमुरजा डिण्डिमाश्चैव प्रावाद्यन्त सहस्रशः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2191039, "chapter_id": 5066, "verse_number": "४२", "content_sanskrit": "असुराणां तु सर्वेषां स्मृतिलोपोऽभवन्महान् ।\nप्रज्ञानाशश्च बलवान् क्षणेन समपद्यत\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2191040, "chapter_id": 5066, "verse_number": "४३", "content_sanskrit": "तमाविष्टमथो ज्ञात्वा ऋषयो देवतास्तथा ।\nस्तुवन्तः शक्रमीशानं तथा प्राचोदयन्नपि\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2191041, "chapter_id": 5066, "verse_number": "४४", "content_sanskrit": "रथस्थस्य हि शक्रस्य युद्धकाले महात्मनः ।\nऋषिभिः स्तूयमानस्य रूपमासीत् सुदुर्दृशम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2191042, "chapter_id": 5066, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे पञ्चदशाधिकशततमोऽध्यायः ॥११५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]