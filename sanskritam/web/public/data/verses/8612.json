[{"id": 900008001, "chapter_id": 8612, "verse_number": "3.1", "content_sanskrit": "न च बाष्पारोपितधूमेन धूमवत्त्वं व्यभिचरति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008002, "chapter_id": 8612, "verse_number": "3.2", "content_sanskrit": "न च बाष्पारोपितधूमेन धूमवत्त्वं व्यभिचरति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008003, "chapter_id": 8612, "verse_number": "3.3", "content_sanskrit": "न च भावाभावविलक्षणं क्वचिदागमो वक्ति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008004, "chapter_id": 8612, "verse_number": "3.4", "content_sanskrit": "नासदासीन्नो सदासीत्तदानीं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008005, "chapter_id": 8612, "verse_number": "3.5", "content_sanskrit": "पारिशेष्येणानिर्वचनीयत्वाङ्गीकारे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008006, "chapter_id": 8612, "verse_number": "3.6", "content_sanskrit": "मूर्तं सदिति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008007, "chapter_id": 8612, "verse_number": "3.7", "content_sanskrit": "‘यदन्यद्वायोश्चान्तरिक्षाच्चैतत्सत्’ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008008, "chapter_id": 8612, "verse_number": "3.8", "content_sanskrit": "यदन्यद्वायोश्चान्तरिक्षाच्चैतत्सत्’..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008009, "chapter_id": 8612, "verse_number": "3.9", "content_sanskrit": "यदन्यद्वायोश्चान्तरिक्षाच्चैतत्सत्’..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008010, "chapter_id": 8612, "verse_number": "3.10", "content_sanskrit": "अद्भुतत्वादनिर्वाच्यं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008011, "chapter_id": 8612, "verse_number": "3.11", "content_sanskrit": "ऋ गताविति धेतोस्तु ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008012, "chapter_id": 8612, "verse_number": "3.12", "content_sanskrit": "विश्वं सत्यं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008013, "chapter_id": 8612, "verse_number": "3.13", "content_sanskrit": "असत्यमप्रतिष्ठं ते जगदाहुरनीश्वरम् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008014, "chapter_id": 8612, "verse_number": "3.14", "content_sanskrit": "विश्वं सत्यं मघवाना ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900008015, "chapter_id": 8612, "verse_number": "3.15", "content_sanskrit": "न चार्थापत्त्या अनिर्वचनीयत्वसिद्धिः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900008016, "chapter_id": 8612, "verse_number": "3.16", "content_sanskrit": "न चार्थापत्त्या अनिर्वचनीयत्वसिद्धिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900008017, "chapter_id": 8612, "verse_number": "3.17", "content_sanskrit": "असतः प्रतीतिं विनाऽसद्वैलक्षण्यज्ञानानुपपत्तेः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900008018, "chapter_id": 8612, "verse_number": "3.18", "content_sanskrit": "असतः प्रतीतिं विनाऽसद्वैलक्षण्यज्ञानानुपपत्तेः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]