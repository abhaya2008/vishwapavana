[{"id": 2149736, "chapter_id": 4244, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149737, "chapter_id": 4244, "verse_number": "१", "content_sanskrit": "ततस्ते तापसाः सर्वे कार्यवन्तोऽभवंस्तदा ।\nतां कन्यां चिन्तयन्तस्ते किं कार्यमिति धर्मिणः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149738, "chapter_id": 4244, "verse_number": "२", "content_sanskrit": "केचिदाहुः पितुर्वेश्म नीयतामिति तापसाः ।\nकेचिदस्मदुपालम्भे मतिं चक्रुर्द्विजोत्तमाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149739, "chapter_id": 4244, "verse_number": "३", "content_sanskrit": "केचित् साल्वपतिं गत्वा नियोक्ष्यामीति मेनिरे ।\nनेति केचिद् व्यवस्यन्ति प्रत्याख्याता यथा हि सा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149740, "chapter_id": 4244, "verse_number": "४", "content_sanskrit": "एवं गते तु किं शक्यं भद्रे कर्तुं मनीषिभिः ।\nपुनरूचुश्च ते सर्वे तापसाः संशितव्रताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149741, "chapter_id": 4244, "verse_number": "५", "content_sanskrit": "अलं प्रव्रजितेनेह भद्रे शृणु हितं वचः ।\nइतो गच्छस्व भद्रं ते पितुरेव निवेशनम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149742, "chapter_id": 4244, "verse_number": "६", "content_sanskrit": "प्रतिवक्ष्यति राजाऽसौ पिता ते यदनन्तरम् ।\nतत्र वत्स्यसि कल्याणि सुखं सर्वगुणान्विता\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149743, "chapter_id": 4244, "verse_number": "७", "content_sanskrit": "न च तेऽन्या गतिर्न्याय्या भवेद् भद्रे यथा पिता ।\nपतिर्वाऽपि गतिर्नार्याः पिता वा वरवर्णिनि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149744, "chapter_id": 4244, "verse_number": "८", "content_sanskrit": "गतिः पतिः समस्थाया विषमे तु पिता गतिः ।\nप्रव्रज्या हि सुदुःखेयं सुकुमार्या विशेषतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149745, "chapter_id": 4244, "verse_number": "९", "content_sanskrit": "राजपुत्र्याः प्रकृत्या च कुमार्यास्तव भामिनि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149746, "chapter_id": 4244, "verse_number": "१०", "content_sanskrit": "भद्रे दोषा हि विद्यन्ते बहवो वरवर्णिनि ।\nआश्रमे वै वसन्त्यास्ते न भवेयुः पितुर्गृहे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149747, "chapter_id": 4244, "verse_number": "११", "content_sanskrit": "ततस्त्वन्येऽब्रुवन् वाक्यं तापसास्तां तपस्विनीम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149748, "chapter_id": 4244, "verse_number": "१२", "content_sanskrit": "त्वामिहैकाकिनीं दृष्ट्वा निर्जने गहने वने ।\nप्रार्थयिष्यन्ति राजानस्तस्मान्मैवं मनः कृथाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149749, "chapter_id": 4244, "verse_number": "", "content_sanskrit": "अम्बा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149750, "chapter_id": 4244, "verse_number": "१३", "content_sanskrit": "न शक्यं काशिनगरं पुनर्गन्तुं पितुर्गृहान् ।\nअवज्ञाता भविष्यामि बान्धवानां न संशयः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149751, "chapter_id": 4244, "verse_number": "१४", "content_sanskrit": "उषिता ह्यन्यथा बाल्ये पितुर्वेश्मनि तापसाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149752, "chapter_id": 4244, "verse_number": "१५", "content_sanskrit": "नाहं गमिष्ये भद्रं वस्तत्र यत्र पिता मम ।\nतपस्तप्तुमभीप्सामि तापसैः परिपालिता\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149753, "chapter_id": 4244, "verse_number": "१६", "content_sanskrit": "यथा परेऽपि मे लोके न स्यादेवं महात्ययम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149754, "chapter_id": 4244, "verse_number": "१७", "content_sanskrit": "दौर्भाग्यं ब्राह्मणश्रेष्ठास्तस्मात् तप्स्याम्यहं तपः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149755, "chapter_id": 4244, "verse_number": "१८", "content_sanskrit": "इत्येवं तेषु विप्रेषु चिन्तयत्सु यथातथम् ।\nराजर्षिस्तद्वनं प्राप्तस्तपस्वी होत्रवाहनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149756, "chapter_id": 4244, "verse_number": "१९", "content_sanskrit": "तां तथाभाविनीं दृष्ट्वा श्रुत्वा चोद्विग्नमानसः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149757, "chapter_id": 4244, "verse_number": "२०", "content_sanskrit": "ततस्ते तापसाः सर्वे पूजयन्ति स्म तं नृपम् ।\nपूजाभिः स्वागताद्याभिरासनेनोदकेन च\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149758, "chapter_id": 4244, "verse_number": "२१", "content_sanskrit": "तस्योपविष्टस्य सतो विश्रान्तस्योपशृण्वतः ।\nपुनरेव कथां चक्रुः कन्यां प्रति वनौकसः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149759, "chapter_id": 4244, "verse_number": "२२", "content_sanskrit": "अम्बायास्तां कथां श्रुत्वा काशिराज्ञश्च भारत ।\nराजर्षिः स महातेजा बभूवोद्विग्नमानसः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149760, "chapter_id": 4244, "verse_number": "२३", "content_sanskrit": "तां तथावादिनीं श्रुत्वा दृष्ट्वा च स महातपाः ।\nराजर्षिः कृपयाऽऽविष्टो महात्मा होत्रवाहनः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149761, "chapter_id": 4244, "verse_number": "२४", "content_sanskrit": "स वेपमान उत्थाय मातुस्तस्याः पिता तदा ।\nतां कन्यामङ्कमारोप्य पर्याश्वासयत प्रभो\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149762, "chapter_id": 4244, "verse_number": "२५", "content_sanskrit": "स तामपृच्छत् कार्त्स्न्येन व्यसनोत्पत्तिमादितः ।\nसा च तस्मै यथावृत्तं विस्तरेण न्यवेदयत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149763, "chapter_id": 4244, "verse_number": "२६", "content_sanskrit": "ततः स राजर्षिरभूद् दुःखशोकसमन्वितः ।\nकार्यं च प्रतिपेदे तन्मनसा सुमहातपाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149764, "chapter_id": 4244, "verse_number": "२७", "content_sanskrit": "अब्रवीद् वेपमानश्च कन्यामार्तां सुदुःखिताम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149765, "chapter_id": 4244, "verse_number": "२८", "content_sanskrit": "मा गाः पितृगृहं भद्रे मातुस्ते जनको ह्यहम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149766, "chapter_id": 4244, "verse_number": "२९", "content_sanskrit": "दुःखं छेत्स्यामि तेऽहं वै मयि वर्तस्व पुत्रवत् ।\nपर्याप्तं ते तपः पुत्रि यदेवं परिशुष्यसि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149767, "chapter_id": 4244, "verse_number": "३०", "content_sanskrit": "गच्छ मद्वचनाद् रामं जामदग्न्यं तपस्विनम् ।\nरामस्ते सुमहद्दुःखं शोकं चैवापनेष्यति\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2149768, "chapter_id": 4244, "verse_number": "३१", "content_sanskrit": "हनिष्यति रणे भीष्मं न करिष्यति चेद् वचः ।\nतं गच्छ भार्गवश्रेष्ठं कालाग्निसमतेजसम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2149769, "chapter_id": 4244, "verse_number": "३२", "content_sanskrit": "प्रतिष्ठापयिता स त्वां धर्म्ये पथि निरामये\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2149770, "chapter_id": 4244, "verse_number": "३३", "content_sanskrit": "ततस्तु सुस्वरं बाष्पमुत्सृजन्ती पुनः पुनः ।\nअब्रवीत् पितरं मातुः सा तदा होत्रवाहनम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2149771, "chapter_id": 4244, "verse_number": "३४", "content_sanskrit": "अभिवादयित्वा शिरसा गमिष्ये तव शासनात् ।\nअपि नामाद्य पश्येयमार्यं तं लोकविश्रुतम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2149772, "chapter_id": 4244, "verse_number": "३५", "content_sanskrit": "कथं च तीव्रं दुःखं मे नाशयिष्यति भार्गवः ।\nएतदिच्छाम्यहं श्रोतुं यथा यास्यामि तत्र वै\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2149773, "chapter_id": 4244, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि पञ्चसप्तत्युत्तरशततमोऽध्यायः ॥१७५॥\nअम्बोपाख्यानपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]