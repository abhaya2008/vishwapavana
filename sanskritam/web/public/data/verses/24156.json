[{"id": 7004156000, "chapter_id": 24156, "verse_number": "५-१-५-१", "content_sanskrit": "व्यास उवाच ।\nयुद्धे निवारिते तत्र रक्तस्वेदजयोः पुरा ।\nकिं कृतं ब्रह्मणा तत्र प्रायश्चित्तं च कर्मणाम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004156001, "chapter_id": 24156, "verse_number": "५-१-५-२", "content_sanskrit": "जनार्दनेन किं कर्म शंकरेण च यन्मुने ।\nएतत्सर्वं समाख्याहि प्रसीद वदतांवर॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004156002, "chapter_id": 24156, "verse_number": "५-१-५-३", "content_sanskrit": "सनत्कुमार उवाच ।\nब्रह्मा जुह्वन्नग्निहोत्रं वनौषधिफलच्छदैः ।\nशस्तैः कुशसमिद्भिश्च यथोक्तं हरिणा पुरा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004156003, "chapter_id": 24156, "verse_number": "५-१-५-४", "content_sanskrit": "बदर्याश्रममासाद्य नरनारायणावृषी ।\nतेपतुस्तौ तपश्चोग्रं हितार्थं सर्वदेहिनाम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004156004, "chapter_id": 24156, "verse_number": "५-१-५-५", "content_sanskrit": "कपालपाणिर्देवेशः पर्यटन्वसुधामिमाम् ।\nकुशस्थलीं समासाद्य प्रविष्टस्तद्वनोत्तमम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004156005, "chapter_id": 24156, "verse_number": "५-१-५-६", "content_sanskrit": "नानाद्रुमलताकीर्णं नानापुष्पोपशोभितम् ।\nनानापक्षिरवाकीर्णं नानामृगसमाकुलम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004156006, "chapter_id": 24156, "verse_number": "५-१-५-७", "content_sanskrit": "द्रुमपुष्पभरामोदवासितं यत्सुवायुना ।\nबुद्धिपूर्वमिव न्यस्तैः फलपुष्पैः सुपूजितम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004156007, "chapter_id": 24156, "verse_number": "५-१-५-८", "content_sanskrit": "नानागंधरसाढ्यैश्च पक्वापक्वफलोद्भवैः ।\nफलैः सुवर्णरूपाढ्यैरासमन्तान्मनोरमैः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004156008, "chapter_id": 24156, "verse_number": "५-१-५-९", "content_sanskrit": "जीर्णपत्रतृणादीनि शुष्क काष्ठफलानि च ।\nबहिः क्षिपंति जातानि मरुतोनुग्रहाणि च॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004156009, "chapter_id": 24156, "verse_number": "५-१-५-१०", "content_sanskrit": "नानापुष्पसमूहानां गन्धमादाय मारुतः ।\nशीतलो वाति तं भूमिदेशं यत्र विवेश सः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004156010, "chapter_id": 24156, "verse_number": "५-१-५-११", "content_sanskrit": "हरितस्निग्धनिच्छिद्रैः पर्णैरञ्छिद्रकोटरैः ।\nवृक्षैरनेकसंख्यैश्च भूषितं शिरसान्वितैः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004156011, "chapter_id": 24156, "verse_number": "५-१-५-१२", "content_sanskrit": "अरोगिदर्शनीयैश्च सुवृत्तैः क्वचि दुद्धतैः ।\nकुटुम्बैरिव विप्राणां सिद्धिर्वै भाति सर्वतः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004156012, "chapter_id": 24156, "verse_number": "५-१-५-१३", "content_sanskrit": "शोभनैर्वायुसंकीर्णैरंकुरैः प्रावृता द्रुमाः ।\nकुलीनैरिव निच्छिद्रैः स्वगणैः प्रावृता नराः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004156013, "chapter_id": 24156, "verse_number": "५-१-५-१४", "content_sanskrit": "पवनोद्धूतशिखरैः स्पर्शयंति परस्परम् ।\nआरात्पवनतोऽन्योन्यस्पृष्टशाखावतंसकाः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004156014, "chapter_id": 24156, "verse_number": "५-१-५-१५", "content_sanskrit": "नागवृक्षाः क्वचित्पुष्पैर्भ्रमरालीनकेस रैः ।\nनयनैरिव शोभंते धवलैः कृष्णतारकैः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004156015, "chapter_id": 24156, "verse_number": "५-१-५-१६", "content_sanskrit": "पुष्पसन्नद्धशिखराः कर्णिकारद्रुमाः क्वचित् ।\nयुग्मयुग्मविवाहे च शोभंते साधु दंपतीः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004156016, "chapter_id": 24156, "verse_number": "५-१-५-१७", "content_sanskrit": "सुपुष्पविभवाटोपैः सिन्दुवारस्य पंक्तयः ।\nमूर्तिमत्य इवाभांति पूजिता वनदेवताः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004156017, "chapter_id": 24156, "verse_number": "५-१-५-१८", "content_sanskrit": "क्वचित्क्वचित्कुन्दलताः सुपुष्पाभरणोज्ज्वलाः ।\nदिक्षुदिक्षु प्रशोभन्ते बालचन्द्रा इवोद्यताः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004156018, "chapter_id": 24156, "verse_number": "५-१-५-१९", "content_sanskrit": "अतिविद्रुमशोभाढ्या कासंत्यो यूथिकालताः ।\nपुष्पिताः पुष्पविटपान्वीज यंत्य इवोत्थिताः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004156019, "chapter_id": 24156, "verse_number": "५-१-५-२०", "content_sanskrit": "शालार्जुनाः क्वचिद्भांति वनोद्देशेषु पुष्पिताः ।\nधौतकौशेयवासोभिः प्रावृताः पुरुषोत्तमाः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004156020, "chapter_id": 24156, "verse_number": "५-१-५-२१", "content_sanskrit": "अविमुक्तं तु वल्लीभिः पुष्पितास्तु द्रुमास्तथा ।\nउपगूढा विराजन्ते नारीभिरिव सुप्रिया॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004156021, "chapter_id": 24156, "verse_number": "५-१-५-२२", "content_sanskrit": "चूताश्च तिलकाश्चैव मञ्जरीभिः करैरिव ।\nवायुप्रत्ताभिरन्योन्यं ढौकन्तीव हि सज्जनान्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004156022, "chapter_id": 24156, "verse_number": "५-१-५-२३", "content_sanskrit": "परस्परं च संयुक्तैस्तिलकाशोकपल्लवैः ।\nहस्तैर्हस्तान्स्पृशंतीव सुहृदश्चित्तसंगताः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004156023, "chapter_id": 24156, "verse_number": "५-१-५-२४", "content_sanskrit": "फलपुष्पनगा नम्राः पेशलेनेव सज्जनाः ।\nअन्योन्यमर्पयंतीव सपुष्पाणि फलानि च॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004156024, "chapter_id": 24156, "verse_number": "५-१-५-२५", "content_sanskrit": "मारुताश्लिष्टसंतुष्टैः पादपाः शालिवारिभिः ।\nआर्याः समागता लोके प्रीतिदाय इव स्थिताः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004156025, "chapter_id": 24156, "verse_number": "५-१-५-२६", "content_sanskrit": "पुष्पाणामिव वेगेन स्वशोभार्थं व्रजंति वै ।\nसमसन्नाहमासाद्य पुरुषाः स्पर्धयेव हि॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004156026, "chapter_id": 24156, "verse_number": "५-१-५-२७", "content_sanskrit": "पुष्पशोभाभरनतैः शिखरैः कंपसंयुतैः ।\nनृत्यन्ति पक्षिणो मत्ता युक्ताः शोभनशेखरैः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004156027, "chapter_id": 24156, "verse_number": "५-१-५-२८", "content_sanskrit": "भृंगाः पवनविक्षिप्तामृतवल्लीलताश्रिताः ।\nसवल्लिकाः प्रनृत्यन्ति मानवा इव सप्रियाः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004156028, "chapter_id": 24156, "verse_number": "५-१-५-२९", "content_sanskrit": "पुष्पाभिः कुन्दवल्लीभिः पादपाः क्वचिदावृताः ।\nभाति तारागणैश्चित्रैः शरदीव नभस्तलम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004156029, "chapter_id": 24156, "verse_number": "५-१-५-३०", "content_sanskrit": "द्रुमा णामप्यथाग्रेषु पुष्पिता माधवी लता ।\nशिखरा इव शोभन्ते रचिता बुद्धिपूर्वकम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004156030, "chapter_id": 24156, "verse_number": "५-१-५-३१", "content_sanskrit": "हरिताः कांचनच्छायाः फलिताः पुष्पिता द्रुमाः ।\nसौहृदं दर्शयन्तीव नराः साधुसमागमे॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004156031, "chapter_id": 24156, "verse_number": "५-१-५-३२", "content_sanskrit": "पुष्पकिंजल्कबहुलाः किंजल्कबहुलोदराः ।\nकिंजल्कमत्तमधुपा विशदा इव शारिका॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004156032, "chapter_id": 24156, "verse_number": "५-१-५-३३", "content_sanskrit": "शिरीष पुष्पसंकाशाः शुका मिथुनतः क्वचित् ।\nकीर्तयंति गिरश्चित्राः पूजिता ब्राह्मणा यथा॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004156033, "chapter_id": 24156, "verse_number": "५-१-५-३४", "content_sanskrit": "संयुक्ताः सहचारिण्या मयूराश्चित्रबर्हिणः ।\nवनांतरे व्यतिष्ठंत एकांत इव संस्थिताः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004156034, "chapter_id": 24156, "verse_number": "५-१-५-३५", "content_sanskrit": "कूजंति पत्रिसंघाता नानाद्भुतविराविणः ।\nकुर्वंति रमणीयं हि रमणीयतरं वनम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004156035, "chapter_id": 24156, "verse_number": "५-१-५-३६", "content_sanskrit": "नाना मृगगणाकीर्णं नित्यं समुदितांडजम् ।\nतद्वनं नंदनसमं मनोदृष्टिविवर्धनम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004156036, "chapter_id": 24156, "verse_number": "५-१-५-३७", "content_sanskrit": "कपालपाणिर्भगवांस्तथारूपं वनोत्तमम् ।\nददर्श शंकरो दृष्ट्या सौम्यया नंदनोपमम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004156037, "chapter_id": 24156, "verse_number": "५-१-५-३८", "content_sanskrit": "ता वृक्षपंक्तयः सर्वा दृष्ट्वा रुद्रं समागतम् ।\nनिवेद्य शंभवे भक्त्या मुमुचुः पुष्पसंपदम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004156038, "chapter_id": 24156, "verse_number": "५-१-५-३९", "content_sanskrit": "पुष्पप्रतिग्रहं कृत्वा पादपानां महेश्वरः ।\nवरं वृणीध्वं भद्रं वः पादपानित्युवाच सः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004156039, "chapter_id": 24156, "verse_number": "५-१-५-४०", "content_sanskrit": "एवमुक्ते भगवता तरवो निरवग्रहाः ।\nऊचुः प्रांजलयः सर्वे नमस्कृत्य महेश्वरम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004156040, "chapter_id": 24156, "verse_number": "५-१-५-४१", "content_sanskrit": "वरं ददासि देवेश प्रसन्न जनवत्सल ।\nइहैव भगवन्नित्य वने सन्निहितो भव॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004156041, "chapter_id": 24156, "verse_number": "५-१-५-४२", "content_sanskrit": "एष नः परमः कामो देवदेव नमोऽस्तु ते ।\nत्वं चेद्वससि देवेश वनेऽस्मिन्विश्वभावन॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004156042, "chapter_id": 24156, "verse_number": "५-१-५-४३", "content_sanskrit": "सर्वात्मना प्रपन्ना वै याचामहे वरोत्तमम् ।\nकिमन्यवरकोटीभिरेष नो दीयतां वरः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004156043, "chapter_id": 24156, "verse_number": "५-१-५-४४", "content_sanskrit": "इत्युक्तः पादपैः सर्वैः शरणागतवत्सलः ।\nवरं ददौ पादपेभ्यः प्रोच्यमानं मया शृणु॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004156044, "chapter_id": 24156, "verse_number": "५-१-५-४५", "content_sanskrit": "महेश्वर उवाच ।\nबाढं मे मनसा वासो नित्यमत्र वनोत्तमे ।\nवरं ददामि भूयो वो न वृथा दर्शनं मम॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004156045, "chapter_id": 24156, "verse_number": "५-१-५-४६", "content_sanskrit": "नाग्निर्न वायुर्न जलं न सूर्यकिरणातपः ।\nन विद्युदशनिः शीतं रुजं वो जनयिष्यति॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004156046, "chapter_id": 24156, "verse_number": "५-१-५-४७", "content_sanskrit": "नित्यं पुष्पवरोपेता नित्यं सुस्थिरयौवनाः ।\nकामगाः कामरूपाश्च कामरूपफलप्रदाः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004156047, "chapter_id": 24156, "verse_number": "५-१-५-४८", "content_sanskrit": "कामसंदर्शनाः पुंसां तपःसंध्याज्वलदृशाम् ।\nश्रिया परमया युक्ता मत्प्रसादाद्भविष्यथ॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004156048, "chapter_id": 24156, "verse_number": "५-१-५-४९", "content_sanskrit": "एवं स वरदः शंभुरनुजग्राह पादपान् ।\nस्थित्वा वर्षसहस्रं तु कपालं चाक्षिपद्भुवि॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004156049, "chapter_id": 24156, "verse_number": "५-१-५-५०", "content_sanskrit": "क्षितिं निपतता तेन कंपते स्म रसातलम् ।\nविवशास्तत्यजुर्वेलां सागराः क्षुभितोर्मयः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004156050, "chapter_id": 24156, "verse_number": "५-१-५-५१", "content_sanskrit": "शक्राशनिहतानीव व्याघ्रव्यालान्वितानि च ।\nशिखराणि व्यशीर्यंत पर्वतानां सहस्रशः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004156051, "chapter_id": 24156, "verse_number": "५-१-५-५२", "content_sanskrit": "देवसिद्धविमानानि गंधर्वनगराणि च ।\nप्रस्फुरन्ति विनिष्पेतुर्विनिनेशुर्धरातले॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004156052, "chapter_id": 24156, "verse_number": "५-१-५-५३", "content_sanskrit": "कपोतमेषाश्चात्यंतं पुनः संघातदर्शनाः ।\nज्योतिर्ग्रहाश्छादयंतो बभूवुस्तीर्णभास्कराः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004156053, "chapter_id": 24156, "verse_number": "५-१-५-५४", "content_sanskrit": "महता तस्य शब्देन जडांधबधिरं कृतम् ।\nबभूव व्याकुलं सर्वं त्रैलोक्यं सचराचरम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004156054, "chapter_id": 24156, "verse_number": "५-१-५-५५", "content_sanskrit": "सुरासुराणां सर्वेषां शरीराणि मनांसि च ।\nअवसे दुश्चकंपुश्च किमेतदिति जज्ञिरे॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004156055, "chapter_id": 24156, "verse_number": "५-१-५-५६", "content_sanskrit": "धैर्यमालंब्य सर्वेऽपि समागम्येंद्रपूर्वकाः ।\nब्रह्मलोकं समासाद्य ब्रह्माणमिदमूचिरे॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004156056, "chapter_id": 24156, "verse_number": "५-१-५-५७", "content_sanskrit": "किं निमित्तं तु भगवन्नेतदुत्पातदर्शने ।\nत्रैलोक्यं कंपितं येन संयुक्तं कालकर्मणा॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004156057, "chapter_id": 24156, "verse_number": "५-१-५-५८", "content_sanskrit": "जातं कल्पावसानं च भिन्नमर्यादसागरम् ।\nचत्वारो दिग्गजाः किं नु बभूवुरचलाश्चलाः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004156058, "chapter_id": 24156, "verse_number": "५-१-५-५९", "content_sanskrit": "धरा समाधृता कस्मात्सप्तसागरवारिणा ।\nउत्पत्तिर्नास्ति सर्वस्य भगवन्न प्रयोजनम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004156059, "chapter_id": 24156, "verse_number": "५-१-५-६०", "content_sanskrit": "यादृशोऽयं श्रुतः शब्दो न भूतो नापि विश्रुतः ।\nत्रैलोक्यमाकुलं येन चक्रे रौद्रेण भूयसा॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004156060, "chapter_id": 24156, "verse_number": "५-१-५-६१", "content_sanskrit": "एवमुक्तोऽब्रवीद्ब्रह्मा परमेशानुभावितः ।\nतत्प्रसादात्प्रति ज्ञानी ज्ञात्वा रुद्रमुपस्थितम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004156061, "chapter_id": 24156, "verse_number": "५-१-५-६२", "content_sanskrit": "यत्पृष्टं मरुतः सर्वे शृणुध्वं तत्र कारणम् ।\nनिश्चयेनात्र विज्ञेयं श्रद्दधानैर्यथाविधि॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004156062, "chapter_id": 24156, "verse_number": "५-१-५-६३", "content_sanskrit": "मुखं छित्त्वा नखाग्रेण मद्देहात्पंचमं शिरः ।\nकपालपाणिर्भगवान्विष्णोराश्रममभ्यगात्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004156063, "chapter_id": 24156, "verse_number": "५-१-५-६४", "content_sanskrit": "ययाचे पात्रमादाय भिक्षां नारायणं प्रभुम् ।\nउत्पपात मुनिस्तत्र नरोनाम धनुर्धरः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004156064, "chapter_id": 24156, "verse_number": "५-१-५-६५", "content_sanskrit": "ततः कुशस्थलीमेत्य भगवांस्तद्वनोत्तमम् ।\nविवेश तरुमार्गेण पुष्पामोदाभिनंदितः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004156065, "chapter_id": 24156, "verse_number": "५-१-५-६६", "content_sanskrit": "अनुगृह्याथ भगवान्वनं तत्सर्वगांडजम् ।\nजगतोऽनुग्रहार्थाय तत्र वासमरोचयत्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004156066, "chapter_id": 24156, "verse_number": "५-१-५-६७", "content_sanskrit": "तत्कपालं करस्थं यन्न्यस्तं भगवता क्षितौ ।\nतेनैषा कम्पिता भूमिः कृतं त्रैलोक्यमाकुलम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004156067, "chapter_id": 24156, "verse_number": "५-१-५-६८", "content_sanskrit": "तद्द्रक्ष्यथ विरूपाक्षं प्रपद्यत मया सह ।\nआराध्यमानो भग वान्प्रदास्यति वरं हि वः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004156068, "chapter_id": 24156, "verse_number": "५-१-५-६९", "content_sanskrit": "इत्युक्त्वा भगवान्ब्रह्मा सह तैर्देवदानवैः ।\nजगाम तद्वनोद्देशं यत्रास्ते वृषभध्वजः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004156069, "chapter_id": 24156, "verse_number": "५-१-५-७०", "content_sanskrit": "प्रहृष्टमनसः सर्वे कोकिलालापलापिताम् ।\nपुष्पोच्चयोक्षितां सीमां विविशुः शंकरेप्सवः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004156070, "chapter_id": 24156, "verse_number": "५-१-५-७१", "content_sanskrit": "संप्राप्तं सर्वमेतैस्तद्वनं नंदनसंमितम् ।\nसुवल्लीगृहशोभाढ्यं सुदृढं शुशुभे तदा॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004156071, "chapter_id": 24156, "verse_number": "५-१-५-७२", "content_sanskrit": "दृष्ट्वा तद्वनमुत्तमं तनुभृतामाह्रादकं चेतसां नानासत्फलपुष्पपादपवनैरासेवितं सर्वतः ।\nतस्मिन्बर्हिणहंससारसकुलै र्मंडूकमत्स्यैर्युते द्रक्ष्यामो हरमत्र चेतसि सुराः प्रापुर्मुदं ते तदा॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]