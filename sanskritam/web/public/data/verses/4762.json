[{"id": 2178034, "chapter_id": 4762, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178035, "chapter_id": 4762, "verse_number": "१", "content_sanskrit": "अहो खलु महद् दुःखं कृच्छ्रं वासं वसत्यसौ ।\nकथं तत्र रतिस्तस्य तुष्टिर्वा वदतां वर\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178036, "chapter_id": 4762, "verse_number": "२", "content_sanskrit": "स देशः क्व नु यत्रासौ वसते धर्मसङ्कटे ।\nकथं वा स विमुच्येत नरस्तस्मान्महाभयात्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178037, "chapter_id": 4762, "verse_number": "३", "content_sanskrit": "एतद्वै सर्वमाचक्ष्व साधु चेष्टामहे तथा ।\nतथा कृपा मे महती जाता ह्युद्धरणेन च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178038, "chapter_id": 4762, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178039, "chapter_id": 4762, "verse_number": "४", "content_sanskrit": "उपाख्यानमिदं राजन् मोक्षविद्भिरुदाहृतम् ।\nसुगतिं विन्दते येन परलोकेषु मानवः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178040, "chapter_id": 4762, "verse_number": "५", "content_sanskrit": "यत् तदुच्येत कान्तारं महत् संसार एव सः ।\nयत्र दुर्गं हि यत्त्वेतत् संसारगहनं हि तत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178041, "chapter_id": 4762, "verse_number": "६", "content_sanskrit": "ये चैव प्रथिता व्याला व्याधयस्ते प्रकीर्तिताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178042, "chapter_id": 4762, "verse_number": "७", "content_sanskrit": "या सा नारी बृहत्काया अधितिष्ठति तत्र वै ।\nतामाहुस्तु जरां प्राज्ञा वर्णरूपविनाशिनीम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178043, "chapter_id": 4762, "verse_number": "८", "content_sanskrit": "स यस्तु कूपो नृपते स तु देहः शरीरिणाम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178044, "chapter_id": 4762, "verse_number": "९", "content_sanskrit": "यस्तत्र वसतेऽधस्तान्महाहिः काल एव सः ।\nअन्तकः सर्वभूतानां देहिनां प्राणहार्यसौ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178045, "chapter_id": 4762, "verse_number": "१०", "content_sanskrit": "कूपमध्ये च या जाता वल्ली यत्र स मानवः ।\nप्रताने लम्बते लग्नो जीविताशा शरीरिणाम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178046, "chapter_id": 4762, "verse_number": "११", "content_sanskrit": "स यस्तु कूपपीनाहे वृक्षं विपरिसर्पति ।\nषड्वक्त्रः कुञ्जरो राजन् स तु संवत्सरः स्मृतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178047, "chapter_id": 4762, "verse_number": "१२", "content_sanskrit": "षण्मुखा ऋतवो मासाः पादा द्वादश कीर्तिताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178048, "chapter_id": 4762, "verse_number": "१३", "content_sanskrit": "ये तु वक्षं निकृन्तन्ति मूषिकाः पतगास्तथा ।\nरात्र्यहनि च तान् प्राहुः भूतानां परिचिन्तकाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178049, "chapter_id": 4762, "verse_number": "१४", "content_sanskrit": "ये ते मधुकरास्तत्र कामास्ते परिकीर्तिताः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178050, "chapter_id": 4762, "verse_number": "१५", "content_sanskrit": "यास्तु ता बहुशो धाराः स्रवन्ति बहुविस्तरम् ।\nतांस्तु कामरसान् विद्याद् यत्र सज्जन्ति मानवाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178051, "chapter_id": 4762, "verse_number": "१६", "content_sanskrit": "एवं संसारचक्रस्य परिवृत्तिं विदुर्बुधाः ।\nयेन संसारचक्रस्य पाशं छिन्दन्ति वै बुधाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178052, "chapter_id": 4762, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nधृतराष्ट्रविशोके षष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178053, "chapter_id": 4762, "verse_number": "", "content_sanskrit": "जलप्रदानपर्वणि षष्ठोऽध्यायः ॥६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]