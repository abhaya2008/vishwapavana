[{"id": 2039296, "chapter_id": 1862, "verse_number": "५-१०७-०x", "content_sanskrit": "नारद उवच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039297, "chapter_id": 1862, "verse_number": "५-१०७-१", "content_sanskrit": "एवमुक्तस्तदा तेन विश्वामित्रेण धीमता।\nनास्ते न शेते नाहारं कुरुते गालवस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039298, "chapter_id": 1862, "verse_number": "५-१०७-२", "content_sanskrit": "त्वगस्थिभूतो हरिणाश्चिन्ताशोकपरायणः।\nशोचमानोऽतिमात्रं स दह्यमानश्च मन्युना ।\nगालवो दुःखितो दुःखाद्विललाप सुयोधन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039299, "chapter_id": 1862, "verse_number": "५-१०७-३", "content_sanskrit": "कुतः पुष्टानि मित्राणि कुतोऽर्थाः सञ्चयः कृतः ।\nहयानां चन्द्रशुभ्राणां शतान्यष्टौ कुतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039300, "chapter_id": 1862, "verse_number": "५-१०७-४", "content_sanskrit": "कुतो मे भोजने श्रद्धा सुखश्रद्धा कुतश्च मे।\nश्रद्धा मे जीवितस्यापि छिन्ना किं जीवितेन मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039301, "chapter_id": 1862, "verse_number": "५-१०७-५", "content_sanskrit": "अहं पारे समुद्रस्य पृथिव्या वा परं परात्।\nगत्वाऽऽत्मानं विमुञ्चामि किं फलं जीवितेन मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039302, "chapter_id": 1862, "verse_number": "५-१०७-६", "content_sanskrit": "अदनस्याकृतार्थस्य त्यक्तस्य विविधैः फलैः ।\nऋणं धारयमाणस्य कुतः सुखमनीहया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039303, "chapter_id": 1862, "verse_number": "५-१०७-७", "content_sanskrit": "सुहृदां हि धनं भुक्त्वा कृत्वा प्रणयमीप्सितम् ।\nप्रतिकर्तुमशक्तस्य जीवितान्मरणं वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039304, "chapter_id": 1862, "verse_number": "५-१०७-८", "content_sanskrit": "प्रतिश्रुत्य करिष्येति कर्तव्यं तदकुर्वतः ।\nमिथ्यावचनदग्धस्य इष्टापूर्तं प्रणश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039305, "chapter_id": 1862, "verse_number": "५-१०७-९", "content_sanskrit": "न रूपमनृतस्यास्ति नानृतस्यास्ति सन्ततिः ।\nनानृतस्याधिपत्यं च कुत एव गतिः शुभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039306, "chapter_id": 1862, "verse_number": "५-१०७-१०", "content_sanskrit": "कुतः कृतघ्नस्य यशः कुतः स्थानं कुतः सुखम्।\nअश्रद्धेयः कृतघ्नो हि कृतघ्ने नास्ति निष्कृतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039307, "chapter_id": 1862, "verse_number": "५-१०७-११", "content_sanskrit": "न जीवत्यधनः पापः कुतः पापस्य तन्त्रणम्।\nपापो ध्रुवमवाप्नोति विनाशं नाशयन्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039308, "chapter_id": 1862, "verse_number": "५-१०७-१२", "content_sanskrit": "सोऽहं पापः कृतघ्नस्य कृपणश्चानृतोऽपि च ।\nगुरोर्यः कृतकार्यः संस्तत्करोमि न भाषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039309, "chapter_id": 1862, "verse_number": "५-१०७-१३", "content_sanskrit": "सोऽहं प्राणान्विमोक्ष्यामि कृत्वा यत्नमनुत्तमम् ।\nअर्थिता न मया काचित्कृतपूर्वा दिवौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039310, "chapter_id": 1862, "verse_number": "५-१०७-१४", "content_sanskrit": "मानयन्ति च मां सर्वे त्रिदशा यज्ञसंस्तरे।\nअहं तु विबुधश्रेष्ठं देवं त्रिभुवनेश्वरम् ।\nविष्णुं गच्छाम्यहं कृष्णं गतिं गतिमतां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039311, "chapter_id": 1862, "verse_number": "५-१०७-१५", "content_sanskrit": "भोगा यस्मात्प्रतिष्ठन्ते व्याप्य सर्वान्सुरासुरान्।\nप्रणतो द्रष्टुमिच्छामि कृष्णं योगिनमव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039312, "chapter_id": 1862, "verse_number": "५-१०७-१६", "content_sanskrit": "एवमुक्ते सखा तस्य गरुडो विनतात्मजः ।\nदर्शयामास तं प्राह संहृष्टः प्रियकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039313, "chapter_id": 1862, "verse_number": "५-१०७-१७", "content_sanskrit": "सहृद्भवान्मम मतः सुहृदां च मतः सुहृत्।\nईप्सितेनाभिलाषेण योक्तव्यो विभवे सति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039314, "chapter_id": 1862, "verse_number": "५-१०७-१८", "content_sanskrit": "विभवश्चास्ति मे विप्र वासवावरजो द्विज ।\nपूर्वमुक्तस्त्वदर्थं च कृतः कामश्च तेन मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039315, "chapter_id": 1862, "verse_number": "", "content_sanskrit": "स भवानेतु गच्छाव नयिष्ये त्वां यथासुखम् ।\nदेशं पारं पृथिव्या वा गच्छ गालव मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]