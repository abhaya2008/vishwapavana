[{"id": 2128569, "chapter_id": 3759, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128570, "chapter_id": 3759, "verse_number": "१", "content_sanskrit": "तानुवाच समेतांस्तु ब्रह्मा लोकपितामहः ।\nनिर्ह्रादिन्या गिरा राजन् देवानाश्वासयंस्तदा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128571, "chapter_id": 3759, "verse_number": "२", "content_sanskrit": "गच्छध्वं विबुधाः सर्वे यथाकामं यथेप्सितम् ।\nमहता कालयोगेन प्रकृतिं यास्यतेऽर्णवः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128572, "chapter_id": 3759, "verse_number": "३", "content_sanskrit": "ज्ञातीन् वै कारणं कृत्वा महाराजो भगीरथः ।\nपूरयिष्यति तोयौधैः समुद्रं निधिमम्भसाम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128573, "chapter_id": 3759, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128574, "chapter_id": 3759, "verse_number": "४", "content_sanskrit": "कथं वै ज्ञातयो ब्रह्मन् कारणं चाभवन् मुने ।\nकथं समुद्रः पूर्णश्च भगीरथपरिश्रमात्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128575, "chapter_id": 3759, "verse_number": "५", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं विस्तरेण तपोधन ।\nकथ्यमानं त्वया विप्र राज्ञां चरितमुत्तमम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128576, "chapter_id": 3759, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128577, "chapter_id": 3759, "verse_number": "६", "content_sanskrit": "एवमुक्तस्तु विप्रेन्द्रो धर्मराजेन धीमता ।\nकथयामास माहात्म्यं सगरस्य महात्मनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128578, "chapter_id": 3759, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128579, "chapter_id": 3759, "verse_number": "७", "content_sanskrit": "इक्ष्वाकूणां कुले जातः सगरो नाम पार्थिवः ।\nरूपसत्त्वबलोपेतः स चापुत्रः प्रतापवान् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128580, "chapter_id": 3759, "verse_number": "८", "content_sanskrit": "स हैहयान् समुत्साद्य तालजङ्घांश्च भारत ।\nवशे कृत्वा तु राज्ञोऽन्यान् स्वराज्यमनुशिष्टवान् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128581, "chapter_id": 3759, "verse_number": "९", "content_sanskrit": "तस्य भार्ये ह्यभवतां रूपयौवनदर्पिते ।\nवैदर्भी भरतश्रेष्ठ शैब्या च कुरुनन्दन\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128582, "chapter_id": 3759, "verse_number": "१०", "content_sanskrit": "स पुत्रकामो नृपतिः तताप सुमहत् तपः ।\nपत्नीभ्यां सह राजेन्द्र कैलासं गिरिमास्थितः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128583, "chapter_id": 3759, "verse_number": "११", "content_sanskrit": "स तप्यमानः सुमहत् तपोयोगसमन्वितः ।\nआराधयन्महात्मानं शर्वं त्रिभुवनेश्वरम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128584, "chapter_id": 3759, "verse_number": "१२", "content_sanskrit": "शङ्करं भवमीशानं शूलपाणिं पिनाकिनम् ।\nत्र्यम्बकं च शिवं श्रेष्ठं बहुरूपमुमापतिम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128585, "chapter_id": 3759, "verse_number": "१३", "content_sanskrit": "स तं दृष्ट्वैव वरदं पत्नीभ्यां सहितो नृपः ।\nप्रणिपत्य महाबाहुः पुत्रार्थं समयाचत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128586, "chapter_id": 3759, "verse_number": "१४", "content_sanskrit": "तं प्रीतिमान् हरः प्राह सभार्यं नृपसत्तमम् ।\nयस्मिन् वृतो मुहूर्तेऽहं त्वयेह नृपते वरम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2128587, "chapter_id": 3759, "verse_number": "१५", "content_sanskrit": "पुत्राः षष्टिसहस्राणि शूराः परमदर्पिताः ।\nएकस्यां सम्भविष्यन्ति पत्न्यां तव नरोत्तम \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2128588, "chapter_id": 3759, "verse_number": "१६", "content_sanskrit": "ते चैवापि सहिताः क्षयं यास्यन्ति पार्थिव ।\nएको वंशधरः शूर एकस्यां सम्भविष्यति \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2128589, "chapter_id": 3759, "verse_number": "१७", "content_sanskrit": "एवमुक्त्वा तु तं रुद्रः तत्रैवान्तरधीयत ।\nस चापि सगरो राजा जगाम स्वं निवेशनम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2128590, "chapter_id": 3759, "verse_number": "१८", "content_sanskrit": "पत्नीभ्यां सहितस्तत्र प्रहृष्टोऽन्तरात्मना ।\nकालं शम्भुवरप्राप्तं प्रतीक्षन् सगरोऽनयत् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2128591, "chapter_id": 3759, "verse_number": "१९", "content_sanskrit": "तस्याथ भरतश्रेष्ठ ते भार्ये कमलेक्षणे ।\nवैदर्भी चैव शैब्या च गर्भिण्यौ सम्बभूवतुः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2128592, "chapter_id": 3759, "verse_number": "२०", "content_sanskrit": "ततः कालेन वैदर्भी गर्भालाबुं ह्यजायत ।\nशैब्या च सुषुवे पुत्रं कुमारं देवरूपिणम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2128593, "chapter_id": 3759, "verse_number": "२१", "content_sanskrit": "तदाऽलाबुं समुत्स्रष्टुं मनश्चक्रेऽथ पार्थिवः ।\nअथान्तरिक्षात् शुश्राव वाचं गम्भीरनिस्वनाम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2128594, "chapter_id": 3759, "verse_number": "२२", "content_sanskrit": "राजन् मा साहसं कार्षीः पुत्रान् न त्यक्तुमर्हसि ।\nअलाबुमध्यान्निष्कृष्य बीजं यत्नेन धार्यताम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2128595, "chapter_id": 3759, "verse_number": "२३", "content_sanskrit": "सोपस्वेदेषु भाण्डेषु घृतपूर्णेषु भागशः ।\nततः पुत्रसहस्राणि षष्टिं प्राप्स्यसि पार्थिव\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2128596, "chapter_id": 3759, "verse_number": "२४", "content_sanskrit": "महादेवेन दिष्टं ते पुत्रजन्म नराधिप ।\nअनेन क्रमयोगेन मा ते बुद्धिरतोऽन्यथा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2128597, "chapter_id": 3759, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि एकाधिकशततमोऽध्यायः ॥१०१॥ तीर्थयात्रापर्वणि सप्तपञ्चाशोऽध्यायः ॥५७॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]