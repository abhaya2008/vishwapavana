[{"id": 2149354, "chapter_id": 4231, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149355, "chapter_id": 4231, "verse_number": "१", "content_sanskrit": "उलूकस्य वचः श्रुत्वा कुन्तीपुत्रो युधिष्ठिरः ।\nसेनां निर्यापयामास धृष्टद्युम्नपुरोगमाम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149356, "chapter_id": 4231, "verse_number": "२", "content_sanskrit": "पादातिनीं नागवतीं रथिनीमश्वबृन्दिनीम् ।\nचतुर्विधबलां भीमामकम्प्यां पृथिवीमिव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149357, "chapter_id": 4231, "verse_number": "३", "content_sanskrit": "भीमसेनादिभिर्गुप्तां सार्जुनैश्च महारथैः ।\nधृष्टद्युम्नवशां दुर्गां सागरस्तिमितोपमाम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149358, "chapter_id": 4231, "verse_number": "४", "content_sanskrit": "तस्यास्त्वग्रे महेष्वासः पाञ्चाल्यो युद्धदुर्मदः ।\nद्रोणप्रेप्सुरनीकानि धृष्टद्युम्नो व्यकर्षत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149359, "chapter_id": 4231, "verse_number": "५", "content_sanskrit": "यथाबलं यथोत्साहं रथिनः समुपादिशत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149360, "chapter_id": 4231, "verse_number": "६", "content_sanskrit": "अर्जुनं सूतपुत्राय भीमं दुर्योधनाय च ।\nधृष्टकेतुं च शल्याय गौतमायोत्तमौजसम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149361, "chapter_id": 4231, "verse_number": "७", "content_sanskrit": "अश्वत्थाम्ने च नकुलं शैब्यं च कृतवर्मणे ।\nसैन्धवाय च वार्ष्णेयं युयुधानं समादिशत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149362, "chapter_id": 4231, "verse_number": "८", "content_sanskrit": "शिखण्डिनं च भीष्माय प्रमुखे तमकल्पयत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149363, "chapter_id": 4231, "verse_number": "९", "content_sanskrit": "सहदेवं शकुनये चेकितानं शलाय च ।\nद्रौपदेयांस्तथा पञ्च त्रिगर्तेभ्यः समादिशत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149364, "chapter_id": 4231, "verse_number": "१०", "content_sanskrit": "वृषसेनाय सौभद्रं शेषाणां च महीक्षिताम् ।\nसमर्थं तं च मेने वै पार्थादभ्यधिकं रणे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149365, "chapter_id": 4231, "verse_number": "११", "content_sanskrit": "एवं विभज्य योधांस्तान् पृथक् च सह चैव ह ।\nज्वालावर्णो महेष्वासो द्रोणमंशमकल्पयत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149366, "chapter_id": 4231, "verse_number": "१२", "content_sanskrit": "धृष्टद्युम्नो महेष्वासः सेनापतिपतिस्ततः ।\nविधिवद् व्यूह्य मेधावी युद्धाय धृतमानसः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149367, "chapter_id": 4231, "verse_number": "१३", "content_sanskrit": "यथोद्दिष्टानि सैन्यानि पाण्डवानामयोजयत् ।\nजयाय पाण्डुपुत्राणां यत्तस्तस्थौ रणाजिरे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149368, "chapter_id": 4231, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि द्विषष्ट्युत्तरशततमोऽध्यायः ॥१६२॥\nउलूकदूतागमनपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149369, "chapter_id": 4231, "verse_number": "", "content_sanskrit": "॥ समाप्तम् उलूकदूतागमनपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]