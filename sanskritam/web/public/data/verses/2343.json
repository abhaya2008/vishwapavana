[{"id": 2063095, "chapter_id": 2343, "verse_number": "८-६४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2063096, "chapter_id": 2343, "verse_number": "८-६४-१", "content_sanskrit": "ततः सरथनागाश्वाः पाञ्चालाः पाण्डुसृञ्जयाः।\nसेनापतिं परीप्सन्तो रुरुधुस्तनयं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2063097, "chapter_id": 2343, "verse_number": "८-६४-२", "content_sanskrit": "ततः प्रववृते युद्वं तावकानां परैः सह।\nघोरं प्राणभृतां काले भीमरूपं परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2063098, "chapter_id": 2343, "verse_number": "८-६४-३", "content_sanskrit": "नकुलो वृषसेनं तु विद्ध्वा पञ्चभिरायसैः।\nपितुः समीपे तिष्ठन्तं त्रिभिरन्त्यैरविध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2063099, "chapter_id": 2343, "verse_number": "८-६४-४", "content_sanskrit": "नकुलं तु ततः शूरो वृषसेनो हसन्निव।\nनाराचेन सुतीक्ष्णेन विव्याध हृदये भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2063100, "chapter_id": 2343, "verse_number": "८-६४-५", "content_sanskrit": "सोऽतिविद्धो बलवता शत्रुणा शत्रुकर्शन।\nशत्रुं विव्याध विंशत्या सूतं चैवास्य सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2063101, "chapter_id": 2343, "verse_number": "८-६४-६", "content_sanskrit": "ततः शरसहस्रेण तावुभौ पुरुषर्षभौ।\nअन्योन्यमाच्छादयतां तवाभज्यत वाहिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2063102, "chapter_id": 2343, "verse_number": "८-६४-७", "content_sanskrit": "स दृष्ट्वा प्रद्रुतां सेनां धार्तराष्ट्रस्य सूतजः।\nनिवारयामास बलादनुपत्य विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2063103, "chapter_id": 2343, "verse_number": "८-६४-८", "content_sanskrit": "`एतस्मिन्नन्तरे युद्धं कष्टमासीद्विशाम्पते।\nनिवृत्ते तु ततः सैन्ये नकुलः कौरवान्ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2063104, "chapter_id": 2343, "verse_number": "८-६४-९", "content_sanskrit": "कर्णपुत्रस्तु समरे हित्वा नकुलमेव तु।\nजुगोप चक्रं त्वरितो राधेयस्यैव मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2063105, "chapter_id": 2343, "verse_number": "८-६४-१०", "content_sanskrit": "उलूकस्तु रणे क्रुद्धः सहदेवेन मारिष।\n`निवारितः शरशतैः क्रुद्धेन रणमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2063106, "chapter_id": 2343, "verse_number": "८-६४-११", "content_sanskrit": "तस्याश्वांश्चतुरो हत्वा सहदेवः प्रतापवान्।\nसारथिं प्रेषयामास यमस्य सदनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2063107, "chapter_id": 2343, "verse_number": "८-६४-१२", "content_sanskrit": "उलूकस्तु ततो यानादवप्लुत्य विशाम्पते।\nत्रिगर्तानां बलं तूर्णं जगाम पितृनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2063108, "chapter_id": 2343, "verse_number": "८-६४-१३", "content_sanskrit": "सात्यकिः शकुनिं विद्ध्वा विंशत्या निशितैः शरैः।\nध्वजं चिच्छेद भल्लेन सौबलस्य हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2063109, "chapter_id": 2343, "verse_number": "८-६४-१४", "content_sanskrit": "सौबलस्तस्य समरे क्रुद्धो राजन्प्रतापवान्।\nविदार्य कवचं भूयो ध्वजं चिच्छेद काञ्चनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2063110, "chapter_id": 2343, "verse_number": "८-६४-१५", "content_sanskrit": "तथैनं निशितैर्बाणैः सात्यकिः प्रत्यविध्यत।\nसारथिं च महाराज त्रिभिरेव समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2063111, "chapter_id": 2343, "verse_number": "८-६४-१६", "content_sanskrit": "अथास्य वाहांस्त्वरितः शरैर्नित्ये यमक्षयम्।\nततोऽवप्लुत्य सहसा शकुनिर्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2063112, "chapter_id": 2343, "verse_number": "८-६४-१७", "content_sanskrit": "आरुरोह रथं तूर्णमुलूकस्य महात्मनः।\nअपोवाहाथ शीघ्रं स शैनेयाद्युद्धशालिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2063113, "chapter_id": 2343, "verse_number": "८-६४-१८", "content_sanskrit": "सात्यकिस्तु रण राजंस्तावकानामनीकिनीम्।\nअभिदुद्राव वेगेन ततोऽनीकमभज्वत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2063114, "chapter_id": 2343, "verse_number": "८-६४-१९", "content_sanskrit": "शैनेयशरसञ्छन्नं तव सैन्यं विशाम्पते।\nभेजे दशा दिशस्तूर्णं न्यपतच्च गतासुवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2063115, "chapter_id": 2343, "verse_number": "८-६४-२०", "content_sanskrit": "भीमसेनं तव सुतो वारयामास संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2063116, "chapter_id": 2343, "verse_number": "८-६४-२१", "content_sanskrit": "तं तु भीमो मुहूर्तेन व्यश्वसूतरथध्वजम्।\nचक्रे लोकेश्वरं तत्र तेनातुष्यन्त वै जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2063117, "chapter_id": 2343, "verse_number": "८-६४-२२", "content_sanskrit": "ततोऽपायान्नृपस्तस्माद्भीमसेनभयार्दितः।\nकुरुसैन्यं ततः सर्वं भीमसेनमुपाद्रवत्।\nतत्र नादो महानासीद्धीमसेनं जिघांसताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2063118, "chapter_id": 2343, "verse_number": "८-६४-२३", "content_sanskrit": "युधामन्युः कृपं विद्ध्वा धनुरस्याशु चिच्छदे।\nअथान्यद्धनुरादाय कृपः शस्त्रभृतां वरः।\nयुधामन्योर्ध्वजं सूतं छत्रं चापातयत्क्षितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2063119, "chapter_id": 2343, "verse_number": "८-६४-२४", "content_sanskrit": "ततोऽपायाद्रथेनैव युधामन्युर्महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2063120, "chapter_id": 2343, "verse_number": "८-६४-२५", "content_sanskrit": "उत्तमौजाश्च हार्दिक्यं भीमं भीमपराक्रमम्।\nछादयामास सहसा मेघो वृष्ट्येव पर्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2063121, "chapter_id": 2343, "verse_number": "८-६४-२६", "content_sanskrit": "तद्युद्धमासीत्सुमहद्धोररूपं परन्तप।\nतादृशं न मया युद्धं दृष्टपूर्वं विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2063122, "chapter_id": 2343, "verse_number": "८-६४-२७", "content_sanskrit": "कृतवर्मा ततो राजन्नुत्तमौजसमाहवे।\nहृदि विव्याध सहसा रथोपस्थ उपाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2063123, "chapter_id": 2343, "verse_number": "८-६४-२८", "content_sanskrit": "सारथिस्तमपोवाह रथेन रथिनां वरम्।\nततस्तु सात्वतो राजन्पाण्डुसैन्यमभिद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2063124, "chapter_id": 2343, "verse_number": "८-६४-२९", "content_sanskrit": "[दुःशासनः सौबलश्च गजानीकेन पाण्डवम्।\nमहता परिवार्यैव क्षुद्रकैरभ्यताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2063125, "chapter_id": 2343, "verse_number": "८-६४-३०", "content_sanskrit": "ततो भीमः शरशतैर्दुर्योधनममर्षणम्।\nविमुखीकृत्य तरसा गजानीकमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2063126, "chapter_id": 2343, "verse_number": "८-६४-३१", "content_sanskrit": "तमापतन्तं सहसा गजानीकं वृकोदरः।\nदृष्ट्वैव सुभृशं क्रुद्धो दिव्यमस्त्रमुदैरयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2063127, "chapter_id": 2343, "verse_number": "८-६४-३२", "content_sanskrit": "गजैर्गजानभ्यहनद्वज्रेणेन्द्र इवासुरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2063128, "chapter_id": 2343, "verse_number": "८-६४-३३", "content_sanskrit": "ततोऽन्तरिक्षं बाणौघैः शलभैरिव पादपम्।\nछादयामास समरे गजान्निघ्नन्वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2063129, "chapter_id": 2343, "verse_number": "८-६४-३४", "content_sanskrit": "ततः कुञ्जरयूथानि समेतानि सहस्रशः।\nव्यधमत्तरसा भीमो मेघसङ्घानिवानिलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2063130, "chapter_id": 2343, "verse_number": "८-६४-३५", "content_sanskrit": "सुवर्णजालापिहिता मणिजालैश्च कुञ्जराः।\nरेजुरभ्यधिकं संख्ये विद्युत्वन्त इवाम्बुदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2063131, "chapter_id": 2343, "verse_number": "८-६४-३६", "content_sanskrit": "ते वध्यमाना भीमेन गजा राजन्विदुद्रुवुः।\nकेचिद्विभिन्नहृदयाः कुञ्जरा न्यपतन्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2063132, "chapter_id": 2343, "verse_number": "८-६४-३७", "content_sanskrit": "पतितैर्निपतद्भिश्च गजैर्हेमविभूषितैः।\nअशोभत मही तत्र विशीर्णैरिव पर्वतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2063133, "chapter_id": 2343, "verse_number": "८-६४-३८", "content_sanskrit": "दीप्ताभै रत्नवद्भिश्च पतितैर्गजयोधिभिः।\nरराज भूमिः पतितैः क्षीणपुण्यैरिव ग्रहैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2063134, "chapter_id": 2343, "verse_number": "८-६४-३९", "content_sanskrit": "ततो भिन्नकटा नागा भिन्नकुम्भकरास्तथा।\nदुद्रुवुः शतशः संख्ये भीमसेनशराहताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2063135, "chapter_id": 2343, "verse_number": "८-६४-४०", "content_sanskrit": "केचिद्वमन्तो रुधिरं भयार्ताः पर्वतोपमाः।\nव्यद्रवञ्छरविद्धाङ्गा धातुचित्रा इवाचलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2063136, "chapter_id": 2343, "verse_number": "८-६४-४१", "content_sanskrit": "महाभुजगसङ्काशौ चन्दनागुरुरूषितौ।\nअपश्यं भीमसेनस्य धनुर्विक्षिपतो भुजौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2063137, "chapter_id": 2343, "verse_number": "८-६४-४२", "content_sanskrit": "तस्य ज्यातलनिर्घोषं श्रुत्वाशनिसमस्वनम्।\nविमुञ्चन्तः शकृन्मूत्रं गजाः प्रादुद्रुवुर्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2063138, "chapter_id": 2343, "verse_number": "८-६४-४३", "content_sanskrit": "भीमसेनस्य तत्कर्म राजन्नेकस्य धीमतः।\nनिघ्नतः सर्वभूतानि रुद्रस्येव च निर्बभौ॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2063139, "chapter_id": 2343, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे चतुःषष्टितमोऽध्यायः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]