[{"id": 50026119, "chapter_id": 12068, "verse_number": "1", "content_sanskrit": "दुर्गात्रिष्टुप् कश्यपोक्ता तत्र वर्णोऽग्निवत् स्मृतः॥ ५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50026120, "chapter_id": 12068, "verse_number": "2", "content_sanskrit": "त्रिनेत्रत्वं च दुर्गायाः प्रायः सर्वत्र कथ्यते। पादैः समस्तेन तथा षडर्णेनाङ्गमुच्यते॥ ६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50026121, "chapter_id": 12068, "verse_number": "3", "content_sanskrit": "रमाया एव रूपाणि त्वेतानि हि विदो विदुः। मुख्यतो जामदग्न्यस्तु देवताऽस्य मनोः स्मृतः॥ ६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]