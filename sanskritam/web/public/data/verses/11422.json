[{"id": 50009392, "chapter_id": 11422, "verse_number": "1", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50009393, "chapter_id": 11422, "verse_number": "2", "content_sanskrit": "मनोस्तु शतरूपायां तिस्रः कन्याश्च जज्ञिरे आकूतिर्देवहूतिश्च प्रसूतिरिति विश्रुताः॥ ४/१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50009394, "chapter_id": 11422, "verse_number": "3", "content_sanskrit": "आकूतिं रुचये प्रादादपि भ्रातृमतीं नृपः पुत्रिकाधर्ममाश्रित्य शतरूपानुमोदितः॥ ४/१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50009395, "chapter_id": 11422, "verse_number": "4", "content_sanskrit": "प्रजापतिः स भगवान्रुचिस्तस्यामज्ईजनत् मिथुनं ब्रह्मवर्चस्वी परमेण समाधिना॥ ४/१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50009396, "chapter_id": 11422, "verse_number": "5", "content_sanskrit": "यस्तयोः पुरुषः साक्षाद्विष्णुर्यज्ञस्वरूपधृक् या स्त्री सा दक्षिणा भूतेरंशभूतानपायिनी॥ ४/१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50009397, "chapter_id": 11422, "verse_number": "6", "content_sanskrit": "आनिन्ये स्वगृहं पुत्र्याः पुत्रं विततरोचिषम् स्वायम्भुवो मुदा युक्तो रुचिर्जग्राह दक्षिणाम्॥ ४/१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50009398, "chapter_id": 11422, "verse_number": "7", "content_sanskrit": "तां कामयानां भगवानुवाह यजुषां पतिः तुष्टायां तोषमापन्नोऽ जनयद्द्वादशात्मजान्॥ ४/१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50009399, "chapter_id": 11422, "verse_number": "8", "content_sanskrit": "तोषः प्रतोषः सन्तोषो भद्रः शान्तिरिडस्पतिः इध्मः कविर्विभुः स्वह्नः सुदेवो रोचनो द्विषट्॥ ४/१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50009400, "chapter_id": 11422, "verse_number": "9", "content_sanskrit": "तुषिता नाम ते देवा आसन्स्वायम्भुवान्तरे मरीचिमिश्रा ऋषयो यज्ञः सुरगणेश्वरः॥ ४/१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50009401, "chapter_id": 11422, "verse_number": "10", "content_sanskrit": "प्रियव्रतोत्तानपादौ मनुपुत्रौ महौजसौ तत्पुत्रपौत्रनप्तॄणामनुवृत्तं तदन्तरम्॥ ४/१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50009402, "chapter_id": 11422, "verse_number": "11", "content_sanskrit": "देवहूतिमदात्तात कर्दमायात्मजां मनुः तत्सम्बन्धि श्रुतप्रायं भवता गदतो मम॥ ४/१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50009403, "chapter_id": 11422, "verse_number": "12", "content_sanskrit": "दक्षाय ब्रह्मपुत्राय प्रसूतिं भगवान्मनुः प्रायच्छद्यत्कृतः सर्गस्त्रिलोक्यां विततो महान्॥ ४/१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50009404, "chapter_id": 11422, "verse_number": "13", "content_sanskrit": "याः कर्दमसुताः प्रोक्ता नव ब्रह्मर्षिपत्नयः तासां प्रसूतिप्रसवं प्रोच्यमानं निबोध मे॥ ४/१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50009405, "chapter_id": 11422, "verse_number": "14", "content_sanskrit": "पत्नी मरीचेस्तु कला सुषुवे कर्दमात्मजा कश्यपं पूर्णिमानं च ययोरापूरितं जगत्॥ ४/१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50009406, "chapter_id": 11422, "verse_number": "15", "content_sanskrit": "पूर्णिमासूत विरजं विश्वगं च परन्तप देवकुल्यां हरेः पाद शौचाद्याभूत्सरिद्दिवः॥ ४/१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50009407, "chapter_id": 11422, "verse_number": "16", "content_sanskrit": "अत्रेः पत्न्यनसूया त्रीञ्जज्ञे सुयशसः सुतान् दत्तं दुर्वाससं सोममात्मेशब्रह्मसम्भवान्॥ ४/१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50009408, "chapter_id": 11422, "verse_number": "17", "content_sanskrit": "विदुर उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50009409, "chapter_id": 11422, "verse_number": "18", "content_sanskrit": "अत्रेर्गृहे सुरश्रेष्ठाः स्थित्युत्पत्त्यन्तहेतवः किञ्चिच्चिकीर्षवो जाता एतदाख्याहि मे गुरो॥ ४/१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50009410, "chapter_id": 11422, "verse_number": "19", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50009411, "chapter_id": 11422, "verse_number": "20", "content_sanskrit": "ब्रह्मणा चोदितः सृष्टावत्रिर्ब्रह्मविदां वरः सह पत्न्या ययावृक्षं कुलाद्रिं तपसि स्थितः॥ ४/१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50009412, "chapter_id": 11422, "verse_number": "21", "content_sanskrit": "तस्मिन्प्रसूनस्तबक पलाशाशोककानने वार्भिः स्रवद्भिरुद्घुष्टे निर्विन्ध्यायाः समन्ततः॥ ४/१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50009413, "chapter_id": 11422, "verse_number": "22", "content_sanskrit": "प्राणायामेन संयम्य मनो वर्षशतं मुनिः अतिष्ठदेकपादेन निर्द्वन्द्वोऽनिलभोजनः॥ ४/१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50009414, "chapter_id": 11422, "verse_number": "23", "content_sanskrit": "शरणं तं प्रपद्येऽहं य एव जगदीश्वरः प्रजामात्मसमां मह्यं प्रयच्छत्विति चिन्तयन्॥ ४/१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50009415, "chapter_id": 11422, "verse_number": "24", "content_sanskrit": "तप्यमानं त्रिभुवनं प्राणायामैधसाग्निना निर्गतेन मुनेर्मूर्ध्नः समीक्ष्य प्रभवस्त्रयः॥ ४/१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50009416, "chapter_id": 11422, "verse_number": "25", "content_sanskrit": "अप्सरोमुनिगन्धर्व सिद्धविद्याधरोरगैः वितायमानयशसस्तदाश्रमपदं ययुः॥ ४/१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50009417, "chapter_id": 11422, "verse_number": "26", "content_sanskrit": "तत्प्रादुर्भावसंयोग विद्योतितमना मुनिः उत्तिष्ठन्नेकपादेन ददर्श विबुधर्षभान्॥ ४/१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50009418, "chapter_id": 11422, "verse_number": "27", "content_sanskrit": "प्रणम्य दण्डवद्भूमावुपतस्थेऽर्हणाञ्जलिः वृषहंससुपर्णस्थान्स्वैः स्वैश्चिह्नैश्च चिह्नितान्॥ ४/१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50009419, "chapter_id": 11422, "verse_number": "28", "content_sanskrit": "कृपावलोकेन हसद् वदनेनोपलम्भितान् तद्रोचिषा प्रतिहते निमील्य मुनिरक्षिणी॥ ४/१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50009420, "chapter_id": 11422, "verse_number": "29", "content_sanskrit": "चेतस्तत्प्रवणं युञ्जन्नस्तावीत्संहताञ्जलिः श्लक्ष्णया सूक्तया वाचा सर्वलोकगरीयसः॥ ४/१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50009421, "chapter_id": 11422, "verse_number": "30", "content_sanskrit": "अत्रिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50009422, "chapter_id": 11422, "verse_number": "31", "content_sanskrit": "विश्वोद्भवस्थितिलयेषु विभज्यमानैर्- मायागुणैरनुयुगं विगृहीतदेहाः ते ब्रह्मविष्णुगिरिशाः प्रणतोऽस्म्यहं वस्- तेभ्यः क एव भवतां म इहोपहूतः॥ ४/१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50009423, "chapter_id": 11422, "verse_number": "32", "content_sanskrit": "एको मयेह भगवान्विविधप्रधानैश् चित्तीकृतः प्रजननाय कथं नु यूयम् अत्रागतास्तनुभृतां मनसोऽपि दूराद् ब्रूत प्रसीदत महानिह विस्मयो मे॥ ४/१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50009424, "chapter_id": 11422, "verse_number": "33", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50009425, "chapter_id": 11422, "verse_number": "34", "content_sanskrit": "इति तस्य वचः श्रुत्वा त्रयस्ते विबुधर्षभाः प्रत्याहुः श्लक्ष्णया वाचा प्रहस्य तमृषिं प्रभो॥ ४/१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50009426, "chapter_id": 11422, "verse_number": "35", "content_sanskrit": "देवा ऊचुः यथा कृतस्ते सङ्कल्पो भाव्यं तेनैव नान्यथा सत्सङ्कल्पस्य ते ब्रह्मन्यद्वै ध्यायति ते वयम्॥ ४/१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50009427, "chapter_id": 11422, "verse_number": "36", "content_sanskrit": "अथास्मदंशभूतास्ते आत्मजा लोकविश्रुताः भवितारोऽङ्ग भद्रं ते विस्रप्स्यन्ति च ते यशः॥ ४/१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50009428, "chapter_id": 11422, "verse_number": "37", "content_sanskrit": "एवं कामवरं दत्त्वा प्रतिजग्मुः सुरेश्वराः सभाजितास्तयोः सम्यग्दम्पत्योर्मिषतोस्ततः॥ ४/१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50009429, "chapter_id": 11422, "verse_number": "38", "content_sanskrit": "सोमोऽभूद्ब्रह्मणोऽंशेन दत्तो विष्णोस्तु योगवित् दुर्वासाः शङ्करस्यांशो निबोधाङ्गिरसः प्रजाः॥ ४/१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50009430, "chapter_id": 11422, "verse_number": "39", "content_sanskrit": "श्रद्धा त्वङ्गिरसः पत्नी चतस्रोऽसूत कन्यकाः सिनीवाली कुहू राका चतुर्थ्यनुमतिस्तथा॥ ४/१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50009431, "chapter_id": 11422, "verse_number": "40", "content_sanskrit": "तत्पुत्रावपरावास्तां ख्यातौ स्वारोचिषेऽन्तरे उतथ्यो भगवान्साक्षाद्ब्रह्मिष्ठश्च बृहस्पतिः॥ ४/१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50009432, "chapter_id": 11422, "verse_number": "41", "content_sanskrit": "पुलस्त्योऽजनयत्पत्न्यामगस्त्यं च हविर्भुवि सोऽन्यजन्मनि दह्राग्निर्विश्रवाश्च महातपाः॥ ४/१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50009433, "chapter_id": 11422, "verse_number": "42", "content_sanskrit": "तस्य यक्षपतिर्देवः कुबेरस्त्विडविडासुतः रावणः कुम्भकर्णश्च तथान्यस्यां विभीषणः॥ ४/१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50009434, "chapter_id": 11422, "verse_number": "43", "content_sanskrit": "पुलहस्य गतिर्भार्या त्रीनसूत सती सुतान् कर्मश्रेष्ठं वरीयांसं सहिष्णुं च महामते॥ ४/१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50009435, "chapter_id": 11422, "verse_number": "44", "content_sanskrit": "क्रतोरपि क्रिया भार्या वालखिल्यानसूयत ऋषीन्षष्टिसहस्राणि ज्वलतो ब्रह्मतेजसा॥ ४/१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50009436, "chapter_id": 11422, "verse_number": "45", "content_sanskrit": "ऊर्जायां जज्ञिरे पुत्रा वसिष्ठस्य परन्तप चित्रकेतुप्रधानास्ते सप्त ब्रह्मर्षयोऽमलाः॥ ४/१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50009437, "chapter_id": 11422, "verse_number": "46", "content_sanskrit": "चित्रकेतुः सुरोचिश्च विरजा मित्र एव च उल्बणो वसुभृद्यानो द्युमान्शक्त्यादयोऽपरे॥ ४/१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50009438, "chapter_id": 11422, "verse_number": "47", "content_sanskrit": "चित्तिस्त्वथर्वणः पत्नी लेभे पुत्रं धृतव्रतम् दध्यञ्चमश्वशिरसं भृगोर्वंशं निबोध मे॥ ४/१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50009439, "chapter_id": 11422, "verse_number": "48", "content_sanskrit": "भृगुः ख्यात्यां महाभागः पत्न्यां पुत्रानजीजनत् धातारं च विधातारं श्रियं च भगवत्पराम्॥ ४/१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50009440, "chapter_id": 11422, "verse_number": "49", "content_sanskrit": "आयतिं नियतिं चैव सुते मेरुस्तयोरदात् ताभ्यां तयोरभवतां मृकण्डः प्राण एव च॥ ४/१/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50009441, "chapter_id": 11422, "verse_number": "50", "content_sanskrit": "मार्कण्डेयो मृकण्डस्य प्राणाद्वेदशिरा मुनिः कविश्च भार्गवो यस्य भगवानुशना सुतः॥ ४/१/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50009442, "chapter_id": 11422, "verse_number": "51", "content_sanskrit": "त एते मुनयः क्षत्तर्लोकान्सर्गैरभावयन् एष कर्दमदौहित्र सन्तानः कथितस्तव शृण्वतः श्रद्दधानस्य सद्यः पापहरः परः॥ ४/१/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50009443, "chapter_id": 11422, "verse_number": "52", "content_sanskrit": "प्रसूतिं मानवीं दक्ष उपयेमे ह्यजात्मजः तस्यां ससर्ज दुहितॄः षोडशामललोचनाः॥ ४/१/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50009444, "chapter_id": 11422, "verse_number": "53", "content_sanskrit": "त्रयोदशादाद्धर्माय तथैकामग्नये विभुः पितृभ्य एकां युक्तेभ्यो भवायैकां भवच्छिदे॥ ४/१/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50009445, "chapter_id": 11422, "verse_number": "54", "content_sanskrit": "श्रद्धा मैत्री दया शान्तिस्तुष्टिः पुष्टिः क्रियोन्नतिः बुद्धिर्मेधा तितिक्षा ह्रीर्मूर्तिर्धर्मस्य पत्नयः॥ ४/१/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50009446, "chapter_id": 11422, "verse_number": "55", "content_sanskrit": "श्रद्धासूत शुभं मैत्री प्रसादमभयं दया शान्तिः सुखं मुदं तुष्टिः स्मयं पुष्टिरसूयत॥ ४/१/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50009447, "chapter_id": 11422, "verse_number": "56", "content_sanskrit": "योगं क्रियोन्नतिर्दर्पमर्थं बुद्धिरसूयत मेधा स्मृतिं तितिक्षा तु क्षेमं ह्रीः प्रश्रयं सुतम्॥ ४/१/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50009448, "chapter_id": 11422, "verse_number": "57", "content_sanskrit": "मूर्तिः सर्वगुणोत्पत्तिर्नरनारायणावृषी॥ ४/१/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50009449, "chapter_id": 11422, "verse_number": "58", "content_sanskrit": "ययोर्जन्मन्यदो विश्वमभ्यनन्दत्सुनिर्वृतम् मनांसि ककुभो वाताः प्रसेदुः सरितोऽद्रयः॥ ४/१/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50009450, "chapter_id": 11422, "verse_number": "59", "content_sanskrit": "दिव्यवाद्यन्त तूर्याणि पेतुः कुसुमवृष्टयः मुनयस्तुष्टुवुस्तुष्टा जगुर्गन्धर्वकिन्नराः॥ ४/१/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 50009451, "chapter_id": 11422, "verse_number": "60", "content_sanskrit": "नृत्यन्ति स्म स्त्रियो देव्य आसीत्परममङ्गलम् देवा ब्रह्मादयः सर्वे उपतस्थुरभिष्टवैः॥ ४/१/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 50009452, "chapter_id": 11422, "verse_number": "61", "content_sanskrit": "देवा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 50009453, "chapter_id": 11422, "verse_number": "62", "content_sanskrit": "यो मायया विरचितं निजयात्मनीदं खे रूपभेदमिव तत्प्रतिचक्षणाय एतेन धर्मसदने ऋषिमूर्तिनाद्य प्रादुश्चकार पुरुषाय नमः परस्मै॥ ४/१/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 50009454, "chapter_id": 11422, "verse_number": "63", "content_sanskrit": "सोऽयं स्थितिव्यतिकरोपशमाय सृष्टान् सत्त्वेन नः सुरगणाननुमेयतत्त्वः दृश्याददभ्रकरुणेन विलोकनेन यच्छ्रीनिकेतममलं क्षिपतारविन्दम्॥ ४/१/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 50009455, "chapter_id": 11422, "verse_number": "64", "content_sanskrit": "एवं सुरगणैस्तात भगवन्तावभिष्टुतौ लब्धावलोकैर्ययतुरर्चितौ गन्धमादनम्॥ ४/१/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 50009456, "chapter_id": 11422, "verse_number": "65", "content_sanskrit": "ताविमौ वै भगवतो हरेरंशाविहागतौ भारव्ययाय च भुवः कृष्णौ यदुकुरूद्वहौ॥ ४/१/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 50009457, "chapter_id": 11422, "verse_number": "66", "content_sanskrit": "स्वाहाभिमानिनश्चाग्नेरात्मजांस्त्रीनजीजनत् पावकं पवमानं च शुचिं च हुतभोजनम्॥ ४/१/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 50009458, "chapter_id": 11422, "verse_number": "67", "content_sanskrit": "तेभ्योऽग्नयः समभवन्चत्वारिंशच्च पञ्च च त एवैकोनपञ्चाशत्साकं पितृपितामहैः॥ ४/१/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 50009459, "chapter_id": 11422, "verse_number": "68", "content_sanskrit": "वैतानिके कर्मणि यन् नामभिर्ब्रह्मवादिभिः आग्नेय्य इष्टयो यज्ञे निरूप्यन्तेऽग्नयस्तु ते॥ ४/१/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 50009460, "chapter_id": 11422, "verse_number": "69", "content_sanskrit": "अग्निष्वात्ता बर्हिषदः सौम्याः पितर आज्यपाः साग्नयोऽनग्नयस्तेषां पत्नी दाक्षायणी स्वधा॥ ४/१/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 50009461, "chapter_id": 11422, "verse_number": "70", "content_sanskrit": "तेभ्यो दधार कन्ये द्वे वयुनां धारिणीं स्वधा उभे ते ब्रह्मवादिन्यौ ज्ञानविज्ञानपारगे॥ ४/१/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 50009462, "chapter_id": 11422, "verse_number": "71", "content_sanskrit": "भवस्य पत्नी तु सती भवं देवमनुव्रता आत्मनः सदृशं पुत्रं न लेभे गुणशीलतः॥ ४/१/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 50009463, "chapter_id": 11422, "verse_number": "72", "content_sanskrit": "पितर्यप्रतिरूपे स्वे भवायानागसे रुषा अप्रौढैवात्मनात्मानमजहाद्योगसंयुता॥ ४/१/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 50009464, "chapter_id": 11422, "verse_number": "73", "content_sanskrit": "इति श्रीमद्भागवते चतुर्थस्कन्धे प्रथमोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]