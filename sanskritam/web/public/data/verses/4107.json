[{"id": 2144255, "chapter_id": 4107, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2144256, "chapter_id": 4107, "verse_number": "१", "content_sanskrit": "अनीश्वरोऽयं पुरुषो भवाभवे\nसूत्रप्रोता दारुमयीव योषा ।\nधात्रा तु दिष्टस्य वशे कृतोऽहं\nतस्माद् वद त्वं श्रवणे धृतोऽहम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2144257, "chapter_id": 4107, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2144258, "chapter_id": 4107, "verse_number": "२", "content_sanskrit": "अप्राप्तकालं वचनं बृहस्पतिरपि ब्रुवन् ।\nलभते बुद्ध्यवज्ञानमवमानं च भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2144259, "chapter_id": 4107, "verse_number": "३", "content_sanskrit": "प्रियो भवति दानेन प्रियवादेन चापरः ।\nमन्त्रमूलबलेनान्यो यः प्रियः प्रिय एव सः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2144260, "chapter_id": 4107, "verse_number": "४", "content_sanskrit": "द्वेष्यो न साधुर्भवति न मेधावी न पण्डितः ।\nप्रिये शुभानि कर्माणि द्वेष्ये पापानि चैव ह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2144261, "chapter_id": 4107, "verse_number": "५", "content_sanskrit": "उक्तं मया जातमात्रेऽपि राजन्\nदुर्योधनं त्यज पुत्रं त्वमेकम् ।\nतस्य त्यागात् पुत्रशतस्य वृद्धिः\nअस्यात्यागात् पुत्रशतस्य नाशः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2144262, "chapter_id": 4107, "verse_number": "६", "content_sanskrit": "न वृद्धिर्बहुमन्तव्या या वृद्धिः क्षयमावहेत् ।\nक्षयोऽपि बहुमन्तव्यो यः क्षयो वृद्धिमावहेत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2144263, "chapter_id": 4107, "verse_number": "७", "content_sanskrit": "न स क्षयो महाराज यः क्षयो वृद्धिमावहेत् ।\nक्षयः स त्विह मन्तव्यो यं लब्ध्वा बहु नाशयेत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2144264, "chapter_id": 4107, "verse_number": "८", "content_sanskrit": "समृद्धा गुणतः केचिद् भवन्ति धनतोऽपरे ।\nधनवृद्धान् गुणैर्हीनान् धृतराष्ट्र विवर्जय\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2144265, "chapter_id": 4107, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2144266, "chapter_id": 4107, "verse_number": "९", "content_sanskrit": "सर्वं त्वमायतीयुक्तं वदसि प्राज्ञसम्मतम् ।\nन चोत्सहे सुतं त्यक्तुं यतो धर्मस्ततो जयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2144267, "chapter_id": 4107, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2144268, "chapter_id": 4107, "verse_number": "१०", "content_sanskrit": "अतीवगुणसम्पन्नो न जातु विनयान्वितः ।\nसुसूक्ष्ममपि भूतानामुपमर्दमपेक्षते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2144269, "chapter_id": 4107, "verse_number": "११", "content_sanskrit": "परापवादनिरता परदुःखोदयेषु च ।\nपरस्परविरोधे च यतन्ते सततोत्थिताः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2144270, "chapter_id": 4107, "verse_number": "१२", "content_sanskrit": "सदोषं दर्शनं येषां संवासे सुमहद्भयम् ।\nअर्थादाने महान् दोषः प्रदाने च महद्भयम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2144271, "chapter_id": 4107, "verse_number": "१३", "content_sanskrit": "ये वै भेदनशीलास्तु सकामा निस्त्रपाः शठाः ।\nये पापा इति विख्याताः संवासे परिगर्हिताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2144272, "chapter_id": 4107, "verse_number": "१४", "content_sanskrit": "युक्ताश्चान्यैर्महादोषैर्ये नरास्तान् विवर्जयेत् ।\nनीते या फलनिर्वृत्तिः सौहृदे चैव यत् सुखम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2144273, "chapter_id": 4107, "verse_number": "१५", "content_sanskrit": "निवर्तमाने सौभाग्ये प्रीतिर्नीचे विनश्यति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2144274, "chapter_id": 4107, "verse_number": "१६", "content_sanskrit": "यतते चापवादाय यत्नमारभते क्षये\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2144275, "chapter_id": 4107, "verse_number": "१७", "content_sanskrit": "स्वल्पेऽप्यपकृते मोहान्न शान्तिमुपगच्छति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2144276, "chapter_id": 4107, "verse_number": "१८", "content_sanskrit": "तादृशैः सङ्गतं नीचैर्नृशंसैरकृतात्मभिः ।\nनिशम्य निपुणं बुद्ध्या विद्वान् दूराद् विवर्जयेत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2144277, "chapter_id": 4107, "verse_number": "१९", "content_sanskrit": "यो ज्ञातिमनुगृह्णाति दरिद्रं दीनमातुरम् ।\nस पुत्रपशुवृद्धिं च श्रेयश्चानन्तमश्नुते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2144278, "chapter_id": 4107, "verse_number": "२०", "content_sanskrit": "ज्ञातयो वर्धनीयास्तैर्य इच्छन्त्यात्मनः सुखम् ।\nकुलवृद्धिं च राजेन्द्र तस्मात् साधु समाचर\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2144279, "chapter_id": 4107, "verse_number": "२१", "content_sanskrit": "श्रेयसा योक्ष्यसे राजन् कुर्वाणो ज्ञातिसत्क्रियाम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2144280, "chapter_id": 4107, "verse_number": "२२", "content_sanskrit": "विगुणा ह्यपि संरक्ष्या ज्ञातयो भरतर्षभ ।\nकिं पुनर्गुणवन्तस्ते त्वत्प्रसादाभिकाङ्क्षिणः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2144281, "chapter_id": 4107, "verse_number": "२३", "content_sanskrit": "प्रसादं कुरु वीराणां पाण्डवानां विशाम्पते ।\nदीयतां ग्रामकाः केचित् तेषां वृत्त्यर्थमीश्वर\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2144282, "chapter_id": 4107, "verse_number": "२४", "content_sanskrit": "एवं लोके यशः प्राप्तं भविष्यति नराधिप ।\nवृद्धेन हि त्वया कार्यं पुत्राणां तात रक्षणम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2144283, "chapter_id": 4107, "verse_number": "२५", "content_sanskrit": "मया चापि हितं वाच्यं विद्धि मां त्वद्धितैषिणम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2144284, "chapter_id": 4107, "verse_number": "२६", "content_sanskrit": "ज्ञातिभिर्विग्रहस्तात न कर्तव्यो भवार्थिना ।\nसुखानि सहभोज्यानि ज्ञातिभिर्भरतर्षभ\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2144285, "chapter_id": 4107, "verse_number": "२७", "content_sanskrit": "सभोजनं सङ्कथनं सम्प्रीतिश्च परस्परम् ।\nज्ञातिभिः सह कार्याणि न विरोधः कदाचन\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2144286, "chapter_id": 4107, "verse_number": "२८", "content_sanskrit": "ज्ञातयस्तारयन्तीह ज्ञातयो मज्जयन्ति च ।\nसुवृत्तास्तारयन्तीह दुर्वृत्ता मज्जयन्ति च\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2144287, "chapter_id": 4107, "verse_number": "२९", "content_sanskrit": "सुवृत्तो भव राजेन्द्र पाण्डवान् प्रति मानद ।\nअधर्षणीयः शत्रूणां तैर्वृतस्त्वं भविष्यसि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2144288, "chapter_id": 4107, "verse_number": "३०", "content_sanskrit": "श्रीमन्तं ज्ञातिरासाद्य यो ज्ञातिमवसीदति ।\nदिग्धहस्तात् मृग इव स एनस्तस्य विन्दति\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2144289, "chapter_id": 4107, "verse_number": "३१", "content_sanskrit": "पश्चादपि नरश्रेष्ठ तव तापो भविष्यति ।\nतान् वा हतान् सुतान् वाऽपि श्रुत्वा तदनुचिन्तय\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2144290, "chapter_id": 4107, "verse_number": "३२", "content_sanskrit": "येन खट्वां समारूढः परितप्येत कर्मणा ।\nआदावेव न तत् कुर्यादध्रुवे जीविते सति\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2144291, "chapter_id": 4107, "verse_number": "३३", "content_sanskrit": "न कश्चिन्नापनयते पुमानन्यत्र भार्गवात् ।\nशेषसम्प्रतिपत्तिस्तु बुद्धिमत्स्ववतिष्ठति\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2144292, "chapter_id": 4107, "verse_number": "३४", "content_sanskrit": "दुर्योधनेन यद्येतत् तत् पापं ते पुराकृतम् ।\nत्वया तत्कुलवृद्धेन प्रत्यानेयं जनेश्वर\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2144293, "chapter_id": 4107, "verse_number": "३५", "content_sanskrit": "तान् स्वे पदे प्रतिष्ठाप्य लोके विगतकल्मषः ।\nभविष्यसि नरश्रेष्ठ पूजनीयो मनीषिणाम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2144294, "chapter_id": 4107, "verse_number": "३६", "content_sanskrit": "सुव्याहृतानि धीराणां फलतः परिचिन्त्य च ।\nअध्यवस्यति कार्येषु चिरं यशसि तिष्ठति\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2144295, "chapter_id": 4107, "verse_number": "३७", "content_sanskrit": "असम्यगुपयुक्तं हि ज्ञानं सुकुशलैरपि ।\nउपलभ्यं चाविदितं विदितं चाननुष्ठितम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2144296, "chapter_id": 4107, "verse_number": "३८", "content_sanskrit": "पापोदयफलं विद्वान् यो नारभति वर्धते\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2144297, "chapter_id": 4107, "verse_number": "३९", "content_sanskrit": "यस्तु पूर्वकृतं पापमविमृश्यानुवर्तते ।\nअगाधपङ्के दुर्मेधा विषमे विनिपात्यते \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2144298, "chapter_id": 4107, "verse_number": "४०", "content_sanskrit": "मन्त्रभेदस्य षट् प्राज्ञो द्वाराणीमानि लक्षयेत् ।\nअर्थसन्ततिकामश्च रक्षेदेतानि नित्यशः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2144299, "chapter_id": 4107, "verse_number": "४१", "content_sanskrit": "मद्यं स्वप्नमविज्ञानमाकारं चात्मसम्भवम् ।\nदुष्टामात्येषु विस्रम्भं दूताच्चाकुशलादपि\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2144300, "chapter_id": 4107, "verse_number": "४२", "content_sanskrit": "द्वाराण्येतानि यो ज्ञात्वा संवृणोति सदा नृपः ।\nत्रिवर्गाचरणे युक्तः स शत्रूनधितिष्ठति\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2144301, "chapter_id": 4107, "verse_number": "४३", "content_sanskrit": "न वै श्रुतमविज्ञाय वृद्धाननुपसेव्य वा ।\nधर्मार्थौ वेदितुं शक्यौ बृहस्पतिसमैरपि\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2144302, "chapter_id": 4107, "verse_number": "४४", "content_sanskrit": "नष्टं समुद्रे पतितं नष्टं वाक्यमशृण्वति ।\nअनात्मनि श्रुतं नष्टं नष्टं हुतमनग्निकम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2144303, "chapter_id": 4107, "verse_number": "४५", "content_sanskrit": "सत्यं परीक्ष्य मेधावी बुद्ध्या सम्पाद्य चासकृत् ।\nश्रुत्वा दृष्ट्वाऽथ विज्ञाय प्राज्ञैर्मैत्रीं समाचरेत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2144304, "chapter_id": 4107, "verse_number": "४६", "content_sanskrit": "अवृत्तं विनयो हन्ति हन्त्यनर्थं पराक्रमः ।\nहन्ति नित्यं क्षमा क्रोधमाचारो हन्त्यलक्षणम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2144305, "chapter_id": 4107, "verse_number": "४७", "content_sanskrit": "परिच्छदेन क्षेत्रेण वेश्मना ब्रह्मचर्यया ।\nपरीक्षेत कुलं राजन् भोजनाच्छादनेन च\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2144306, "chapter_id": 4107, "verse_number": "४८", "content_sanskrit": "ययोश्चित्तेन वा चित्तं निभृतं निभृतेन वा ।\nसमेति प्रज्ञया प्रज्ञा तयोर्मैत्री न जीर्यते\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2144307, "chapter_id": 4107, "verse_number": "४९", "content_sanskrit": "दुर्बुद्धिमकृतप्रज्ञं छन्नं कूपं तृणैरिव ।\nविवर्जयीत मेधावी तस्मिन् मैत्री प्रणश्यति\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2144308, "chapter_id": 4107, "verse_number": "५०", "content_sanskrit": "अवलिप्तेषु मूर्खेषु रौद्रसाहसिकेषु च ।\nतथैवापेतधर्मेषु न मैत्रीमाचरेद् बुधः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2144309, "chapter_id": 4107, "verse_number": "५१", "content_sanskrit": "कृतज्ञं धार्मिकं सत्यमक्षुद्रं दृढभक्तिकम् ।\nजितेन्द्रियं स्थितं स्थित्यां मित्रमित्यभिवाञ्छति\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2144310, "chapter_id": 4107, "verse_number": "५२", "content_sanskrit": "इन्द्रियाणामनुत्सर्गोऽमृत्युना च विशिष्यते ।\nअत्यर्थं पुनरुत्सर्गः शातयेद् दैवतान्यपि\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2144311, "chapter_id": 4107, "verse_number": "५३", "content_sanskrit": "मार्दवं सर्वभूतानामनसूया क्षमा धृतिः ।\nआयुष्याणि बुधाः प्राहुर्मित्राणां चाविमानना\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2144312, "chapter_id": 4107, "verse_number": "५४", "content_sanskrit": "अप(वि)नीतं सुनीतेन येऽर्थं प्रत्यानिनीषति ।\nमतिमास्थाय सुदृढां तदेकं पुरुषव्रतम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2144313, "chapter_id": 4107, "verse_number": "५५", "content_sanskrit": "आयत्यां प्रतिकारज्ञः तथात्वे दृढनिश्चयः ।\nअतीते कार्यशेषज्ञो नरोऽर्थैर्न प्रहीयते\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2144314, "chapter_id": 4107, "verse_number": "५६", "content_sanskrit": "कर्मणा मनसा वाचा यदभीक्ष्णं निषेवते ।\nतदेवापहरत्येनं तस्मात् कल्याणमाचरेत्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2144315, "chapter_id": 4107, "verse_number": "५७", "content_sanskrit": "मङ्गलालापनं योगः श्रुतमुत्थानमार्जवम् ।\nभूतिमेतानि कुर्वन्ति सतां चाभीक्ष्णदर्शनम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2144316, "chapter_id": 4107, "verse_number": "५८", "content_sanskrit": "अनिर्वेदः श्रियो मूलं लाभस्य च शुभस्य च ।\nमहान् भवत्यनिर्विण्णः सुखं चानन्तमश्नुते\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2144317, "chapter_id": 4107, "verse_number": "५९", "content_sanskrit": "नातः श्रीमत्तरं किञ्चिदन्यत् पथ्यतमं मतम् ।\nप्रभविष्णोर्यथा तात क्षमा सर्वत्र सर्वदा\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2144318, "chapter_id": 4107, "verse_number": "६०", "content_sanskrit": "क्षमेदशक्तः सर्वस्य शक्तिमान् धर्मकारणात् ।\nअर्थानर्थौ समौ यस्य तस्य नित्यं क्षमा हिता\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2144319, "chapter_id": 4107, "verse_number": "६१", "content_sanskrit": "यत्सुखं सेवमानोऽपि धर्मार्थाभ्यां न हीयते ।\nकामं तदुपसेवेत न मूढव्रतमाचरेत्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2144320, "chapter_id": 4107, "verse_number": "६२", "content_sanskrit": "दुःखार्तेषु प्रमत्तेषु नास्तिकेष्वलसेषु च ।\nन श्रीर्वर्तत्यदान्तेषु ये चोत्साहविवर्जिताः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2144321, "chapter_id": 4107, "verse_number": "६३", "content_sanskrit": "आर्जवेन नरं युक्तं मार्दवात् सव्यपत्रपम् ।\nअशक्तं मन्यमानास्तु धर्षयन्ति कुबुद्धयः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2144322, "chapter_id": 4107, "verse_number": "६४", "content_sanskrit": "अत्यार्यमतिदातारमतिशूरमतिव्रतम् ।\nप्रज्ञाभिमानिनं चैव श्रीर्भयान्नोपसर्पति\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2144323, "chapter_id": 4107, "verse_number": "६५", "content_sanskrit": "न चातिगुणवत्स्वेषा नात्यन्तं निर्गुणेषु च ।\nउन्मत्ता गौरिवान्धा श्रीः क्वचिदेवावतिष्ठते\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2144324, "chapter_id": 4107, "verse_number": "६६", "content_sanskrit": "अग्निहोत्रफला वेदाः शीलवृत्तफलं श्रुतम् ।\nरतिपुत्रफला नारी दत्तभुक्तफलं धनम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2144325, "chapter_id": 4107, "verse_number": "६७", "content_sanskrit": "अधर्मोपार्जितैरर्थैर्यः करोत्यौर्ध्वदेहिकम् ।\nन स तस्य फलं प्रेत्य भुङ्क्तेऽर्थस्य दुरागमात्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2144326, "chapter_id": 4107, "verse_number": "६८", "content_sanskrit": "कान्तारवनदुर्गेषु कृच्छ्रास्वापत्सु सम्भ्रमे ।\nउद्यतेषु च शस्त्रेषु नास्ति सत्ववतां भयम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2144327, "chapter_id": 4107, "verse_number": "६९", "content_sanskrit": "उत्थानं संयमो दाक्ष्यमप्रमादो धृतिः स्मृतिः ।\nसमीक्ष्य च समारम्भो वृद्धिमूलं भवस्य तु\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2144328, "chapter_id": 4107, "verse_number": "७०", "content_sanskrit": "तपो बलं तापसानां ब्रह्म ब्रह्मविदां बलम् ।\nहिंसा बलमसाधूनां क्षमा गुणवतां बलम्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2144329, "chapter_id": 4107, "verse_number": "७१", "content_sanskrit": "अष्टौ तान्यव्रतघ्नानि आपो मूलं घृतं पयः ।\nहविर्ब्राह्मणकामा च गुरोर्वचनमौषधम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2144330, "chapter_id": 4107, "verse_number": "७२", "content_sanskrit": "न तत् परस्य सन्दिह्यात् प्रतिकूलं यदात्मनः ।\nसङ्ग्रहेणैव धर्मः स्यात् कामादन्यः प्रवर्तते\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2144331, "chapter_id": 4107, "verse_number": "७३", "content_sanskrit": "अक्रोधेन जयेत् क्रोधमसाधुं साधुना जयेत् ।\nजयेत् कदर्यं दानेन जयेत् सत्येन चानृतम्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2144332, "chapter_id": 4107, "verse_number": "७४", "content_sanskrit": "स्त्रीषु धूर्तेऽलसे भीरौ चण्डे परुषवादिनि ।\nचोरे कृतघ्ने विश्वासो न कार्यो न च नास्तिके\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2144333, "chapter_id": 4107, "verse_number": "७५", "content_sanskrit": "अभिवादनशीलस्य नित्यं वृद्धोपसेवितः ।\nचत्वारि सम्प्रवर्धन्ते आयुः प्रज्ञा यशो बलम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2144334, "chapter_id": 4107, "verse_number": "७६", "content_sanskrit": "अतिक्लेशेन येऽर्थाः स्युर्धर्मस्यातिक्रमेण च ।\nअरेर्वा प्रणिपातेन मा स्म तेषु मनः कृथाः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2144335, "chapter_id": 4107, "verse_number": "७७", "content_sanskrit": "अविद्यः पुरुषः शोच्यः शोच्यं मैथुनमप्रजम् ।\nनिराहाराः प्रजाः शोच्याः शोच्यं राष्ट्रमराजकम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2144336, "chapter_id": 4107, "verse_number": "७८", "content_sanskrit": "अध्वा जरा देहभृतां पर्वतानां जलं जरा ।\nअसम्भोगो जरा स्त्रीणां वाक्छल्यं मनसो जरा\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2144337, "chapter_id": 4107, "verse_number": "७९", "content_sanskrit": "अनाम्नायमला वेदा ब्राह्मणस्याव्रतं मलम् ।\nमलं पृथिव्या बाह्लीकाः पुरुषस्यानृतं मलम्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2144338, "chapter_id": 4107, "verse_number": "८०", "content_sanskrit": "कौतूहलमला साध्वी विप्रवासमलाः स्त्रियः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2144339, "chapter_id": 4107, "verse_number": "८१", "content_sanskrit": "सुवर्णस्य मलं रूप्यं रूप्यस्यापि मलं त्रपु ।\nज्ञेयं त्रपुमलं सीसं सीसस्यापि मलं मलम्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2144340, "chapter_id": 4107, "verse_number": "८२", "content_sanskrit": "नस्वप्नेन जयेन्निद्रां नकामेन जयेत् स्त्रियः ।\nनेन्धनेन जयेदग्निं नपानेन सुरां जयेत्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2144341, "chapter_id": 4107, "verse_number": "८३", "content_sanskrit": "यस्य दानजितं मित्रं शत्रवो युधि निर्जिताः ।\nअन्नपानजिता दाराः सफलं तस्य जीवितम्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2144342, "chapter_id": 4107, "verse_number": "८४", "content_sanskrit": "सहस्रिणोऽपि जीवन्ति जीवन्ति शतिनस्तथा ।\nधृतराष्ट्र विमुञ्चेच्छां न कथञ्चिन्न जीर्यति\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2144343, "chapter_id": 4107, "verse_number": "८५", "content_sanskrit": "यत् पृथिव्यां व्रीहियवं हिरण्यं पशवः स्त्रियः ।\nनालमेकस्य तत् सर्वमिति पश्यन् न मुह्यति\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2144344, "chapter_id": 4107, "verse_number": "८६", "content_sanskrit": "राजन् भूयो ब्रवीमि त्वां पुत्रेषु सममाचर ।\nसमता यदि ते राजन् स्वेषु पाण्डुसुतेषु च\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2144345, "chapter_id": 4107, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकोनचत्वारिंशोऽध्यायः ॥३९॥ प्रजागरपर्वणि अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]