[{"id": 2131631, "chapter_id": 3844, "verse_number": "३३५", "content_sanskrit": "ऊषुश्च चतुरोऽब्दांस्ते पुनर्मेरौ प्रमोदिनः ॥३३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131632, "chapter_id": 3844, "verse_number": "३३६", "content_sanskrit": "कथाभिर्वासुदेवस्य ध्यानेनाभ्यर्चनेन च ।\nययौ कालः सुखेनैव तेषां विष्णुरतात्मनाम् ॥३३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131633, "chapter_id": 3844, "verse_number": "३३७", "content_sanskrit": "नैव शत्रूननुत्साद्य नानादाय महद् यशः ।\nनाकृत्वा वासुदेवाज्ञां राज्ञां मुख्यगतिर्भवेत् ॥३३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131634, "chapter_id": 3844, "verse_number": "३३८", "content_sanskrit": "तदन्येषां तु वर्णानां क्षमा बाह्येषु शत्रुषु ।\nप्रायो धर्म इति प्रोक्तो हरेराज्ञाऽखिलस्य च ॥३३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131635, "chapter_id": 3844, "verse_number": "समाप्तिः", "content_sanskrit": "इति भीमवचः श्रुत्वा ससोदर्यो युधिष्ठिरः ।\nराक्षसस्कन्धमारूढः कृष्णया चाऽययौ पुनः ॥३३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]