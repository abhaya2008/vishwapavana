[{"id": 7005527000, "chapter_id": 25527, "verse_number": "२-४४-१", "content_sanskrit": "कूर्म उवाच ।\nअतः परं प्रवक्ष्यामि प्रतिसर्गमनुत्तमम ।\nप्राकृतं हि समासेन श्रृणुध्वं गदतो मम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005527001, "chapter_id": 25527, "verse_number": "२-४४-२", "content_sanskrit": "गते पराधीद्वितये कालो लोकप्रकालनः ।\nकालाग्निर्भस्मसात कर्तुं करोति निखिलं मतिम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005527002, "chapter_id": 25527, "verse_number": "२-४४-३", "content_sanskrit": "स्वात्मन्यात्मानमावेश्य भूत्वा देवो महेश्वरः ।\nदहेदशेषं ब्रह्माण्डं सदेवासुरमानुषम ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005527003, "chapter_id": 25527, "verse_number": "२-४४-४", "content_sanskrit": "तमाविश्य महादेवो भगवान्नीललोहितः ।\nकरोति लोकसंहारं भीषणं रुपमाश्रितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005527004, "chapter_id": 25527, "verse_number": "२-४४-५", "content_sanskrit": "प्रविश्य मण्डलं सौरं कृत्वासौ बहुधा पुनः ।\nनिर्दहत्याखिलं लोकं सप्तसप्तिस्वरुपधृक ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005527005, "chapter_id": 25527, "verse_number": "२-४४-६", "content_sanskrit": "स दग्ध्वा सकलं सत्वमस्त्रं ब्रह्माशिरो महत ।\nदेवतानां शरीरेषु क्षिपत्यखिलदाहकम ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005527006, "chapter_id": 25527, "verse_number": "२-४४-७", "content_sanskrit": "दग्धेष्वशेषदेवेषु देवी गिरिवरात्मजा ।\nएका सा साक्षिणी शम्भोस्तिष्ठते वैदिकी श्रुतिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005527007, "chapter_id": 25527, "verse_number": "२-४४-८", "content_sanskrit": "शिरः कपालैर्देवानां कृतस्त्रग्वरभुषणः ।\nआदित्यचन्द्रादिगणैः पुरयन व्योममण्डलम ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005527008, "chapter_id": 25527, "verse_number": "२-४४-९", "content_sanskrit": "सहस्त्रनयनो देवः सहस्त्राकृतिरिश्वरः ।\nसहस्त्रहस्तचरव्णः सहस्त्रार्चिर्महाभुजः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005527009, "chapter_id": 25527, "verse_number": "२-४४-१०", "content_sanskrit": "दंष्ट्राकरालवदनः प्रदीप्तानललोचनः ।\nत्रिशुली कृत्तिवसनो योगमैश्वरमास्थितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005527010, "chapter_id": 25527, "verse_number": "२-४४-११", "content_sanskrit": "पीत्वा तत्परमानन्दं प्रभूतममृतं स्वयम ।\nकरोति ताण्डवं देवीमालोक्य परमेश्वरः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005527011, "chapter_id": 25527, "verse_number": "२-४४-१२", "content_sanskrit": "पीत्वा नृत्तामृतं देवी भर्तुः परममंगला ।\nयोगमास्थाय देवस्य देहमायाति शुलिनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005527012, "chapter_id": 25527, "verse_number": "२-४४-१३", "content_sanskrit": "संत्यक्त्वा ताण्डवरसं स्वेच्छयैव पिनाकधृक ।\nज्योतिः स्वभावं भगवान दग्ध्वा ब्रह्माण्डमन्डलम ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005527013, "chapter_id": 25527, "verse_number": "२-४४-१४", "content_sanskrit": "संस्थितेष्वथ देवेषु ब्रह्माविष्णुपिनाकिषु ।\nगुणैरशेषैः पृथिवी विलयं याति वारिषु ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005527014, "chapter_id": 25527, "verse_number": "२-४४-१५", "content_sanskrit": "सवारितत्वं सगुणं ग्रसते हव्यवाहनः ।\nतेजस्तु गुणसंयुक्तं वायौ संयति संक्षयम ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005527015, "chapter_id": 25527, "verse_number": "२-४४-१६", "content_sanskrit": "आकाशे सगुणो वायुः प्रलयं याति विश्‍वभृत ।\nभुतादौ च तथाकाशं लीयते गुणसंयुतम ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005527016, "chapter_id": 25527, "verse_number": "२-४४-१७", "content_sanskrit": "इन्द्रियाणि च सर्वाणि तैजसे यान्ति संक्षयम ।\nवैकारिके देवगणाः प्रलयं यान्ति सत्तमाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005527017, "chapter_id": 25527, "verse_number": "२-४४-१८", "content_sanskrit": "वैकारिकस्तैजसश्च भूतदिश्‍चेति सत्तमाः ।\nत्रिविधोऽयमहंकारो महति प्रलयं व्रजेत ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005527018, "chapter_id": 25527, "verse_number": "२-४४-१९", "content_sanskrit": "महान्तमेभिः सहिंत ब्रह्माणमतितेजसम ।\nअव्यक्तं जगतो योनिः संहरेदेकमव्ययम ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005527019, "chapter_id": 25527, "verse_number": "२-४४-२०", "content_sanskrit": "एवं सहृत्यं भूतानि तत्वानि च महेश्वरः ।\nवियोजयति चान्योन्यं प्रधानं पुरुषं परम ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005527020, "chapter_id": 25527, "verse_number": "२-४४-२१", "content_sanskrit": "प्रधानपुंसोरजयोरेष संहार ईरितः ।\nमहेश्वरेच्छाजनितो न स्वयं विद्यते लयः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005527021, "chapter_id": 25527, "verse_number": "२-४४-२२", "content_sanskrit": "गुणसाम्यं तदव्यक्तं प्रकृतिः परिगीयते ।\nप्रधानं जगतो योनिर्मायतत्त्वमचेतनम ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005527022, "chapter_id": 25527, "verse_number": "२-४४-२३", "content_sanskrit": "कुटस्थश्चिन्मयो ह्मात्मा केवलः पंचविशंकः ।\nगीयते मुनिभिः साक्षी महानेकः पितामहः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005527023, "chapter_id": 25527, "verse_number": "२-४४-२४", "content_sanskrit": "एवं संहारकरणी शक्तिर्महेश्वरी ध्रुवा ।\nप्रधानाद्यं विशेषान्तं दहेद रुद्र इति श्रुतिः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005527024, "chapter_id": 25527, "verse_number": "२-४४-२५", "content_sanskrit": "योगिनामथ सर्वेषां ज्ञानविन्यस्तचेतसाम ।\nआत्यन्तिकं चैव लयं विदधातीह शंकरः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005527025, "chapter_id": 25527, "verse_number": "२-४४-२६", "content_sanskrit": "इत्येष भगवान रुद्रः संहारं कुरुते वशी ।\nस्थापिका मोहनी शक्तिर्नारायण इति श्रुतिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005527026, "chapter_id": 25527, "verse_number": "२-४४-२७", "content_sanskrit": "हिरण्यगर्भो भगवान जगत सदसदात्मकम ।\nसृजेदशेषं प्रकृतेस्तन्मयः पंचविंशकः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005527027, "chapter_id": 25527, "verse_number": "२-४४-२८", "content_sanskrit": "सर्वज्ञः सर्वगाः शान्ताः स्वात्मन्येव व्यवस्थिताः ।\nशक्तयो ब्रह्माविष्णवीशा भुक्तिमुक्तिफलप्रदाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005527028, "chapter_id": 25527, "verse_number": "२-४४-२९", "content_sanskrit": "सर्वेश्वराः सर्वनद्याः शाश्वतानन्तभोगिनः ।\nएकमेवाक्षरं तत्त्वं पुंप्रधानेश्वरात्मकम ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005527029, "chapter_id": 25527, "verse_number": "२-४४-३०", "content_sanskrit": "अन्याश्च शक्तयो दिव्याः सन्ति तत्र सहस्त्रशः ।\nइज्यन्ते विविधैर्यज्ञैः शक्रादित्यादयोऽमराः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005527030, "chapter_id": 25527, "verse_number": "२-४४-३१", "content_sanskrit": "एकैकस्य सहस्त्रणि देहानां वै शतानि च ।\nकथ्यन्ते चैव माहात्म्याच्छक्तिरेकैव निर्गुणा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005527031, "chapter_id": 25527, "verse_number": "२-४४-३२", "content_sanskrit": "तां तां शक्ति समाधाय स्वयं देवो महेश्वरः ।\nकरोति देहान विविधान ग्रसते चैव लीलयाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005527032, "chapter_id": 25527, "verse_number": "२-४४-३३", "content_sanskrit": "इज्यते सर्वयज्ञेषु ब्राह्मणैर्वेदवादिभिः ।\nसर्वकामप्रदो रुद्र इत्येषा वैदिकी श्रुतिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005527033, "chapter_id": 25527, "verse_number": "२-४४-३४", "content_sanskrit": "सर्वासामेव शक्तिनां ब्रह्माविष्णुमहेश्वराः ।\nप्राधान्येन स्मृता देवाः शक्तयः परमात्मनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005527034, "chapter_id": 25527, "verse_number": "२-४४-३५", "content_sanskrit": "आद्यः परास्ताद भगवान परमात्मा सनातनः ।\nगीयते सर्वशक्त्यात्मा शुलपाणिर्महेश्वरः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005527035, "chapter_id": 25527, "verse_number": "२-४४-३६", "content_sanskrit": "एनमेके वदन्त्यग्निं नारायणमथापरे ।\nइन्द्रमेके परे विश्‍वान ब्रह्माणमापरे जगुः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005527036, "chapter_id": 25527, "verse_number": "२-४४-३७", "content_sanskrit": "ब्रह्माविष्णुवग्निवरुणाः सर्वे देवास्तथर्षयः ।\nएकस्यैवाथ रुद्रस्य भेदास्ते परिकीर्तिताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005527037, "chapter_id": 25527, "verse_number": "२-४४-३८", "content_sanskrit": "यं यं भेदं समाश्रित्य यजन्ति परमेश्वरम ।\nतत तद रुपं समास्थाय प्रददति फलं शिवः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005527038, "chapter_id": 25527, "verse_number": "२-४४-३९", "content_sanskrit": "तस्मादेकतरं भेदं समाश्रित्यापि शाश्‍वतम ।\nआराधयन्महादेवं याति तत्परमम पदम ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005527039, "chapter_id": 25527, "verse_number": "२-४४-४०", "content_sanskrit": "किन्तुं देवं महादेव सर्वशक्ति सनातनम ।\nआराधयेद वै गिरिशं सगुणं वाथ निर्गुणम ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005527040, "chapter_id": 25527, "verse_number": "२-४४-४१", "content_sanskrit": "मया प्रोक्तो हि भवतां योगः प्रागेव निर्गुणः ।\nआरुरुक्षुस्तु सगुणं पूजयेत परमेश्वरम ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005527041, "chapter_id": 25527, "verse_number": "२-४४-४२", "content_sanskrit": "पिनकिनं त्रिनयनं जटिलं कृत्तवाससम ।\nपद्मासनस्थं रुक्माभं चिन्तयेद वैदिकी श्रुतिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005527042, "chapter_id": 25527, "verse_number": "२-४४-४३", "content_sanskrit": "एष योगः समुद्धिष्टः सबीजो मुनिसत्तमाः ।\nतस्मात सर्वान परित्यज्य देवान ब्रह्मापुरोगमान ।\nआराधयेद विरुपाक्षमादिमध्यान्तसंस्थितम ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005527043, "chapter_id": 25527, "verse_number": "२-४४-४४", "content_sanskrit": "भक्तियोगसमायुक्तः स्वधर्मनिरतः शुचिः ।\nतादृशं रुपमास्थाय समायात्यन्तिकः शिवम ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005527044, "chapter_id": 25527, "verse_number": "२-४४-४५", "content_sanskrit": "एष योगः समृद्दिष्टः सबीजोऽत्यन्तभावने ।\nयथाविधि प्रकृर्वाणः प्राप्नुयादैश्वरं पदम ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005527045, "chapter_id": 25527, "verse_number": "२-४४-४६", "content_sanskrit": "अत्राप्यशक्तोऽथ हरं विष्णुं ब्रह्माणमर्चयेत ।\nअथ चेदसमर्थः स्यात तत्रापि मुनिपुंगवाः ।\nततो वाय्वाग्निशक्रादीन पुजयेद भक्तिसंयुक्तः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005527046, "chapter_id": 25527, "verse_number": "२-४४-४७", "content_sanskrit": "ये चान्ये भावने शुद्धे प्रागृक्ते भगवामिह ।\nअथापि कथितो योगो निबीजश्च सबीजकः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005527047, "chapter_id": 25527, "verse_number": "२-४४-४८", "content_sanskrit": "ज्ञानं तदुक्तं निर्बीजं पुर्वं हि भवतां मया ।\nविष्णुं रुद्रं विरत्र्चिं स सबीजं भावयेद बुधः ।\nअथवाग्न्यादिकान देवास्तंप्तरः संयतेन्द्रियः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005527048, "chapter_id": 25527, "verse_number": "२-४४-४९", "content_sanskrit": "पुजयेत पुरुषं विष्णुं चतुर्मुर्तिधरं हरिम ।\nअनादिनिधनं देवं वासुदेवं सनातनम ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005527049, "chapter_id": 25527, "verse_number": "२-४४-५०", "content_sanskrit": "नारायणं जगदयोनिमाकाशं परमं पदम ।\nतल्लिंगधारीअ नियतं तदभक्तस्तदपाश्रयः ।\nएष एव विधिब्राह्मो भावने चान्तिके मतः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005527050, "chapter_id": 25527, "verse_number": "२-४४-५१", "content_sanskrit": "इत्येतत कथितं ज्ञानं भावनासंश्रयं परम ।\nइन्द्रद्युम्राय मुनये कथितं यन्मया पुरा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005527051, "chapter_id": 25527, "verse_number": "२-४४-५२", "content_sanskrit": "अव्यक्तात्मकमेवेद चेतनाचेतनं जगत ।\nतदीश्वरः परं ब्रह्मा तस्माद ब्रह्मामयं जगत ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005527052, "chapter_id": 25527, "verse_number": "२-४४-५३", "content_sanskrit": "सुत उवाच ।\nएतावदुक्त्वा भगवान विरराम जनार्दनः ।\nतुष्टुवुर्मुनयो विष्णुं शक्रेण सह माधवम ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005527053, "chapter_id": 25527, "verse_number": "२-४४-५४", "content_sanskrit": "मुनय ऊचुः  ।\nनमस्ते कूर्मरुपाय विष्णवे परमात्मने ।\nनारायणाय विश्‍वाय वासुदेवाय ते नमः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005527054, "chapter_id": 25527, "verse_number": "२-४४-५५", "content_sanskrit": "नमो नमस्ते कृष्णाय गोविन्दाय नमो नमः ।\nमाधवाय नमस्तुभ्यं नमो यज्ञेश्वराय च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005527055, "chapter_id": 25527, "verse_number": "२-४४-५६", "content_sanskrit": "सहस्त्रशिरसे तुभ्यं सहस्त्राक्षायं ते नमः ।\nनमः सहस्त्रहस्ताय सहस्त्रचरणाय च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005527056, "chapter_id": 25527, "verse_number": "२-४४-५७", "content_sanskrit": "ॐ नमो ज्ञानरुपाय परमात्मस्वरुपिणे ।\nआनन्दाय नमस्तुभ्यं मायातीताय ते नमः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005527057, "chapter_id": 25527, "verse_number": "२-४४-५८", "content_sanskrit": "नमो गूढशरीराय निर्गुणाय नमोऽस्तु ते ।\nपुरुषाय पुराणाय सत्तामात्रस्वरुपिणे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005527058, "chapter_id": 25527, "verse_number": "२-४४-५९", "content_sanskrit": "नमः सांख्याय योगाय केवलाय नमोऽस्तु ते ।\nधर्मज्ञानाधिगम्याय निष्कालाय नमो नमः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005527059, "chapter_id": 25527, "verse_number": "२-४४-६०", "content_sanskrit": "नमोऽस्तु व्योमतत्त्वाय महायोगेश्वराय च ।\nपरावराणां प्रभवे वेदवेद्याय ते नमः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005527060, "chapter_id": 25527, "verse_number": "२-४४-६१", "content_sanskrit": "नमो बुद्धाय शुद्धाय नमो युक्ताय हेतवे ।\nनमो नमो नमस्तुभ्यं मायिने वेधसे नमः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005527061, "chapter_id": 25527, "verse_number": "२-४४-६२", "content_sanskrit": "नमोऽस्तु ते वराहाय नारसिंहाय ते नमः ।\nवामनाय नमस्तुभ्यं हृषीकेशाय ते नमः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005527062, "chapter_id": 25527, "verse_number": "२-४४-६३", "content_sanskrit": "नमोऽस्तु कालरुद्राय कालरुपाय ते नमः ।\nस्वर्गापवर्गदात्रे च नमोऽप्रतिहतात्मने ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005527063, "chapter_id": 25527, "verse_number": "२-४४-६४", "content_sanskrit": "नमो योगधिगम्याय योगिने योगदायिने ।\nदेवानां पतये तुभ्यं देवार्तिशमनाय ते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005527064, "chapter_id": 25527, "verse_number": "२-४४-६५", "content_sanskrit": "भगवंत्स्वत्प्रसादेन सर्वसंसारनाशनम ।\nअस्माभिर्विदितं ज्ञानं यज्ज्ञात्वामृतमश्‍नुते ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005527065, "chapter_id": 25527, "verse_number": "२-४४-६६", "content_sanskrit": "श्रुतास्तु विविधां धर्मा वंशा मन्वन्तराणि च ।\nसर्गश्च प्रतिसर्गच ब्रह्माण्दस्यास्य विस्तरः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005527066, "chapter_id": 25527, "verse_number": "२-४४-६७", "content_sanskrit": "त्वं हि सर्वजगत्साक्षी विष्णो नारायणः परः ।\nत्रातुमर्हस्यनन्तात्मंस्त्वमेव शरणं गतिः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005527067, "chapter_id": 25527, "verse_number": "२-४४-६८", "content_sanskrit": "सुत उवाच ।\nएतद वः कथितं विप्रा योगमोक्षप्रदायकम ।\nकौर्मंक पुराणमखिलं यज्जगाद गदाधरः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005527068, "chapter_id": 25527, "verse_number": "२-४४-६९", "content_sanskrit": "अस्मिन पुराणे लक्ष्यास्तु सम्भवः कथितः पुरा ।\nमोहायाशेषभुतानां वासुदेवेन योजनम ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005527069, "chapter_id": 25527, "verse_number": "२-४४-७०", "content_sanskrit": "प्रजापतीनां सर्गस्तु वर्णधर्माश्च वृत्तयः ।\nधर्मार्थकाममोक्षाणां यथावल्लक्षणं शुभम ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005527070, "chapter_id": 25527, "verse_number": "२-४४-७१", "content_sanskrit": "पितामहस्य विष्णोश्च महेशस्य च धीमतः ।\nएकत्वं च पृथक्त्वं च विशेषश्‍चोपवर्णितः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005527071, "chapter_id": 25527, "verse_number": "२-४४-७२", "content_sanskrit": "भक्तानां लक्षणं प्रोक्तं समाचारश्‍च शोभनः ।\nवर्णाश्रमाणां कथितं यथावदिह लक्षणम ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005527072, "chapter_id": 25527, "verse_number": "२-४४-७३", "content_sanskrit": "आदिसर्गस्ततः पश्चादण्डावरणसप्तकम ।\nहिरणगर्भसर्गश्च कीर्तितो मुनिपुंगवाः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005527073, "chapter_id": 25527, "verse_number": "२-४४-७४", "content_sanskrit": "कालसंख्याप्रकथनं माहात्म्यं चेश्वरस्य च ।\nब्रह्माणः शयनं चाप्सु नामनिर्वचनं तथा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005527074, "chapter_id": 25527, "verse_number": "२-४४-७५", "content_sanskrit": "वराहवपुषा भूयो भुमेरुद्धरणं पुनः ।\nमुख्यादिसर्गकथनंक मुनिसर्गस्तथापरः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005527075, "chapter_id": 25527, "verse_number": "२-४४-७६", "content_sanskrit": "व्याख्यातो रुद्रसर्गश्च ऋषिसर्गश्च तापसः ।\nधर्मस्य च प्रजासर्गस्तामसात पूर्वमेव तु ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005527076, "chapter_id": 25527, "verse_number": "२-४४-७७", "content_sanskrit": "ब्रह्माविष्णुविवाद स्यादन्तर्देहप्रवेशनम ।\nपद्मोद्भवत्वं देवस्य मोहस्तस्य च धीमतः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005527077, "chapter_id": 25527, "verse_number": "२-४४-७८", "content_sanskrit": "दर्शन च महेशस्य माहात्म्यं विष्णुनेरितम ।\nदिव्यदृष्टिप्रदानं च ब्रह्माणः परमेष्ठिनः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005527078, "chapter_id": 25527, "verse_number": "२-४४-७९", "content_sanskrit": "संस्तवो देवदेवस्य ब्रह्माणा परमेष्ठिना ।\nप्रसादो गिरिशस्याथ वरदानं तथैव च ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7005527079, "chapter_id": 25527, "verse_number": "२-४४-८०", "content_sanskrit": "संवादो विष्णुना सार्धं शंकरस्य महात्मनः ।\nवरदानं तथापुर्वमन्तधानं पिनाकिनः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7005527080, "chapter_id": 25527, "verse_number": "२-४४-८१", "content_sanskrit": "वधश्‍च कथितो विप्रा मधुकैटभयोः पुरा ।\nअवतारोऽथ देवस्य ब्रह्माणो नाभिपंकजात ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7005527081, "chapter_id": 25527, "verse_number": "२-४४-८२", "content_sanskrit": "एकीभावश्‍च देवस्य विष्णुनां कथितस्ततः ।\nविमोहो ब्रह्माणश्‍चाथ संज्ञालाभो हरेस्ततः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7005527082, "chapter_id": 25527, "verse_number": "२-४४-८३", "content_sanskrit": "तपश्‍चरणमाख्यातं देवदेवस्य धीमतः ।\nप्रादुर्भावो महेश्स्य ललाटात कथितस्ततः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7005527083, "chapter_id": 25527, "verse_number": "२-४४-८४", "content_sanskrit": "रुद्राणां कथिता सृष्टिब्रह्माणः प्रतिषेधनम ।\nभूतिश्‍च देवदेवस्य वरदानोपरदेशकौ ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7005527084, "chapter_id": 25527, "verse_number": "२-४४-८५", "content_sanskrit": "अन्तर्धानं च रुद्रस्य तपश्चर्याण्डजस्य च ।\nदर्शनं देवदेवस्य नरनारीशरीरता ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7005527085, "chapter_id": 25527, "verse_number": "२-४४-८६", "content_sanskrit": "देव्या विभागकथनं देवदेवात पिनाकिनः ।\nदेव्यास्तु पश्‍चात कथितं दक्षपुत्रीत्वमेव च ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7005527086, "chapter_id": 25527, "verse_number": "२-४४-८७", "content_sanskrit": "हिमवदुदुहितृत्वं च देव्या माहात्म्यमेव च ।\nदर्शनं दिव्यरुपस्य वैश्यरुपस्य दर्शनम ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7005527087, "chapter_id": 25527, "verse_number": "२-४४-८८", "content_sanskrit": "नाम्रा सहस्त्रं कथितं पित्रा हिमवता स्वयम ।\nउपदेशो महादेव्या वरदानवं तथैव च ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7005527088, "chapter_id": 25527, "verse_number": "२-४४-८९", "content_sanskrit": "भृग्वादीनां प्रजासर्गो राज्ञां वंशस्य विस्तरः ।\nप्राचेतसत्वं दक्षस्य दक्षयज्ञविमर्दनम ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7005527089, "chapter_id": 25527, "verse_number": "२-४४-९०", "content_sanskrit": "दधीचस्य च दक्षस्य विवादः कथितस्तदा ।\nततश्च शापः कथितो मुनीनां मुनिपुंगवाः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7005527090, "chapter_id": 25527, "verse_number": "२-४४-९१", "content_sanskrit": "रुद्रागतिः प्रसादश्‍च अन्तर्धानं पिनाकिनः ।\nपितामहस्योपदेशः कीर्त्यते रक्षणाय तु ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7005527091, "chapter_id": 25527, "verse_number": "२-४४-९२", "content_sanskrit": "दक्षस्य च प्रजासर्गः कश्यपस्य महात्मनः ।\nहिरण्यकशिपोर्नाशो हिरण्याक्षवधस्तथा ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7005527092, "chapter_id": 25527, "verse_number": "२-४४-९३", "content_sanskrit": "ततश्च शापः कथितो देवदारुवनौकसाम ।\nनिग्रहश्‍चान्धकस्याथ गाणपत्यमनुत्तमम ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7005527093, "chapter_id": 25527, "verse_number": "२-४४-९४", "content_sanskrit": "प्रह्रादनिग्रहश्चाथ बलेः संयमनं ततः ।\nबाणस्य निग्रहश्चाथ प्रसादस्तस्य शूलिनः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7005527094, "chapter_id": 25527, "verse_number": "२-४४-९५", "content_sanskrit": "ऋषीणां वंशविस्तारो राज्ञां वंशाः प्रकीर्तिताः ।\nवसुदेवात ततो विष्णोरुप्तत्तिः स्वेच्छया हरेः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7005527095, "chapter_id": 25527, "verse_number": "२-४४-९६", "content_sanskrit": "दर्शनं चोपमन्योर्वै तपश्चरमेव च ।\nवरलाभो,महादेवं दृष्टा साम्बं त्रिलोचनम ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7005527096, "chapter_id": 25527, "verse_number": "२-४४-९७", "content_sanskrit": "कैलासगमनं चाथ निवासस्तत्र शागिंणः ।\nततश्च कथ्यते भीतिर्द्वारवत्या निवासिनाम ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7005527097, "chapter_id": 25527, "verse_number": "२-४४-९८", "content_sanskrit": "रक्षणं गरुडेनाथ जित्वा शत्रुन महाबलान ।\nनारदागमनं चैव यात्रा चैव गरुत्मतः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7005527098, "chapter_id": 25527, "verse_number": "२-४४-९९", "content_sanskrit": "ततश्च कृष्णागमनं मुनीनामागतिस्ततः ।\nनैत्यकं वासुदेवस्य शिवलिंगर्चनं तथा ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7005527099, "chapter_id": 25527, "verse_number": "२-४४-१००", "content_sanskrit": "मार्कण्डेयस्य च मुनेः प्रश्‍नः प्रोक्तस्ततः परम ।\nलिंगर्चननिमित्तं च लिंगस्यापि सलिंगिनः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7005527100, "chapter_id": 25527, "verse_number": "२-४४-१०१", "content_sanskrit": "याथात्म्यकथनं चाथ लिंगाविर्भाव एव च ।\nब्रह्माविष्णोस्तथा मध्ये कीर्तितो मुनिपुंगवाः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7005527101, "chapter_id": 25527, "verse_number": "२-४४-१०२", "content_sanskrit": "मोहस्तयोस्तु कथितो गमनं चोर्ध्वतोऽप्यधः ।\nसंस्तवो देवदेवस्य प्रसादः परमेष्ठिनः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7005527102, "chapter_id": 25527, "verse_number": "२-४४-१०३", "content_sanskrit": "अन्तर्धानं च लिंगस्य साम्बोप्तत्तिस्ततः परम ।\nकीर्तिता चानिरुद्धस्य समुत्पत्तिर्द्विजोत्तमाः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7005527103, "chapter_id": 25527, "verse_number": "२-४४-१०४", "content_sanskrit": "कृष्णस्य गमने बुद्धिऋषीणामागतिस्तथा ।\nअनुशासितं च कृष्णेन वरदानं महात्मनः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7005527104, "chapter_id": 25527, "verse_number": "२-४४-१०५", "content_sanskrit": "गमनं चैव कृष्णस्य पार्थस्यापि च दर्शनम ।\nकृष्णाद्वैपायनस्योक्ता युगधर्माः सनातनाः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7005527105, "chapter_id": 25527, "verse_number": "२-४४-१०६", "content_sanskrit": "अनुग्रहोऽथ पार्थस्य वाराणसीगतिस्ततः ।\nपाराशर्यस्य च मुनेर्व्यासस्यादभुतकर्मणः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7005527106, "chapter_id": 25527, "verse_number": "२-४४-१०७", "content_sanskrit": "वाराणस्याश्च माहात्म्यं तीर्थानां चैव वर्णनम ।\nतीर्थयात्रा च व्यासस्य देव्याश्चैवाथ दर्शनम ।\nउद्वासन च कथितं वरदान तथैव च ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7005527107, "chapter_id": 25527, "verse_number": "२-४४-१०८", "content_sanskrit": "प्रयागस्य च माहात्म्यं क्षेत्रानामथ कीर्तनम ।\nफलं च विपुलं विप्रा मार्कण्डेयस्य निर्गमः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7005527108, "chapter_id": 25527, "verse_number": "२-४४-१०९", "content_sanskrit": "भुवनानां स्वरुपं च ज्योतिषां च निवेशनम ।\nकीर्त्यन्ते चैव वर्षाणि नदीनां चैव निर्णयः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7005527109, "chapter_id": 25527, "verse_number": "२-४४-११०", "content_sanskrit": "पर्वतानां च कथनं स्थानानि च दिवौकसाम ।\nद्वीपाना प्रविभागश्च श्‍वेतद्वीपोपवर्णनमः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7005527110, "chapter_id": 25527, "verse_number": "२-४४-१११", "content_sanskrit": "शयनं केशवस्याथ माहात्म्यं च महात्मनः ।\nमन्वन्तराणां कथनं विष्णोर्माहात्म्यमेव च ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7005527111, "chapter_id": 25527, "verse_number": "२-४४-११२", "content_sanskrit": "वेदशाखाप्रणयनं व्यासानां कथनं ततः ।\nअवेदस्य च वेदानां कथनं मुनिपुंगवाः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7005527112, "chapter_id": 25527, "verse_number": "२-४४-११३", "content_sanskrit": "योगेश्वराणां च कथा शिष्याणांचाथ कीर्तनाम ।\nगीताश्च विविधा गुह्मा ईश्वरस्याथ कीर्तिताः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7005527113, "chapter_id": 25527, "verse_number": "२-४४-११४", "content_sanskrit": "वर्णाश्रमाणामाचाराः प्रायश्चित्तविधिस्ततः ।\nकपालित्वं च रुद्रस्य भिक्षाचरणमेव च ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7005527114, "chapter_id": 25527, "verse_number": "२-४४-११५", "content_sanskrit": "पतिव्रतायाश्चाख्यानं तीर्थानां च वनिर्णयः ।\nतथा मंकणकस्याथ निग्रहः कीर्त्यते द्विजाः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7005527115, "chapter_id": 25527, "verse_number": "२-४४-११६", "content_sanskrit": "वधश्च कथितो विप्राः कालस्य च समासतः ।\nदेवदारुवने शम्भोः प्रवेशो माधवस्य च ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7005527116, "chapter_id": 25527, "verse_number": "२-४४-११७", "content_sanskrit": "दर्शनं षटकुलीयानां देवदेवस्य धीमत ।\nवरदानं च देवस्य नन्दिने तु प्रकीर्तितम ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7005527117, "chapter_id": 25527, "verse_number": "२-४४-११८", "content_sanskrit": "नैमित्तिकस्तु कथितः प्रतिसर्गस्ततः परम ।\nप्राकृतः प्रलयश्चोर्ध्वं सबीजो योग एव च ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7005527118, "chapter_id": 25527, "verse_number": "२-४४-११९", "content_sanskrit": "एवं ज्ञात्वा पुराणस्य संक्षेपं कीर्तयेत तु यः ।\nसर्वपापविनिर्मुक्तो ब्रह्मालोके महीयते ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7005527119, "chapter_id": 25527, "verse_number": "२-४४-१२०", "content_sanskrit": "एवमुक्त्त्वा श्रियं देवीमादाय पुरुषोत्तमः ।\nसंत्यज्य कूर्मसंस्थानं स्वस्थानं च जगाम ह ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7005527120, "chapter_id": 25527, "verse_number": "२-४४-१२१", "content_sanskrit": "देवाश्च सर्वे मुनयः स्वानि स्थानानि भेजिरे ।\nप्रणस्य पुरुषं विष्णुं गृहीत्वा ह्ममृतं द्विजाः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7005527121, "chapter_id": 25527, "verse_number": "२-४४-१२२", "content_sanskrit": "एतत पुराणं परमं भाषितं कूर्मरुपिणा ।\nसाक्षाद देवादिदेवेन विष्णुना विश्‍वयोनिना ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7005527122, "chapter_id": 25527, "verse_number": "२-४४-१२३", "content_sanskrit": "यः पठेत सततं मर्त्यो नियमेन समाहितः ।\nसर्वपापविनिर्मुक्तो ब्रह्मालोके महीयते ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7005527123, "chapter_id": 25527, "verse_number": "२-४४-१२४", "content_sanskrit": "लिखित्वा चैव यो दद्याद वैशाखे मासि सुव्रतः ।\nविप्राय वेदविदुषे तस्य पुण्यं निबोधत ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7005527124, "chapter_id": 25527, "verse_number": "२-४४-१२५", "content_sanskrit": "सर्वपापविनिर्मुक्तः सर्वेश्वर्यसमन्वितः ।\nभुक्त्वाच विपुलान स्वर्गे भोगान दिव्यान सुशोभनान ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7005527125, "chapter_id": 25527, "verse_number": "२-४४-१२६", "content_sanskrit": "ततः स्वर्गात परिभ्रष्टो विप्राणां जायते कुले ।\nपुर्वसंस्कारमाहात्म्याद ब्रह्माविद्यामवाप्नुयात ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7005527126, "chapter_id": 25527, "verse_number": "२-४४-१२७", "content_sanskrit": "पठित्वाध्यायमेवैकं सर्वपापैः प्रमुच्यते ।\nयोऽर्थ विचारयेत सम्यक स प्राप्नोति परं पदम ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7005527127, "chapter_id": 25527, "verse_number": "२-४४-१२८", "content_sanskrit": "अध्येतव्यमिदं नित्यं विप्रैः पर्वणि पर्वणि ।\nश्रोतव्यं च द्विजश्रेष्टा महापातकनाशनम ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7005527128, "chapter_id": 25527, "verse_number": "२-४४-१२९", "content_sanskrit": "एकतस्तु पुराणानि सेतिहासानि कृत्स्नशवः ।\nएकत्र चेदं परममेतदेवातिरिच्यते ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7005527129, "chapter_id": 25527, "verse_number": "२-४४-१३०", "content_sanskrit": "धर्मनैपुण्यकामानां ज्ञाननैपुण्यकामिनाम ।\nइदं पुराणं मुक्त्वैक नास्त्यन्यत साधनं परम ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7005527130, "chapter_id": 25527, "verse_number": "२-४४-१३१", "content_sanskrit": "यथावदत्र भगवान देवो नारायणो हरिः ।\nकथ्यते हि यथा विष्णुनं तथान्येषु सुव्रताः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7005527131, "chapter_id": 25527, "verse_number": "२-४४-१३२", "content_sanskrit": "ब्राह्मी पौराणिकी चेयं संहिता पापनाशिनी ।\nअत्र तत परमं ब्रह्मा कीर्त्यते हि यथार्थतः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7005527132, "chapter_id": 25527, "verse_number": "२-४४-१३३", "content_sanskrit": "तीर्थानां परमं तीर्थ तपसां च परं तपः ।\nज्ञानानां परमं ज्ञानं व्रतानां परमं व्रतम ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7005527133, "chapter_id": 25527, "verse_number": "२-४४-१३४", "content_sanskrit": "नाध्येतव्यमिदं शास्त्रं वृषलस्य च संनिधौ ।\nयोऽधीते स तु मोहात्मा स याति नरकान बहून ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7005527134, "chapter_id": 25527, "verse_number": "२-४४-१३५", "content_sanskrit": "श्राद्धे वा दैविके कार्ये श्रावणीयं द्विजातिभिः ।\nयज्ञान्ते तु विशेषेण सर्वदोषविशोधनम ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7005527135, "chapter_id": 25527, "verse_number": "२-४४-१३६", "content_sanskrit": "मुमुक्षुणामिदं शास्त्रमध्येतव्यं विशेषतः ।\nश्रोतव्यं चाथ मन्तव्यं वेदार्थपरिबृंहणम ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7005527136, "chapter_id": 25527, "verse_number": "२-४४-१३७", "content_sanskrit": "ज्ञात्वा यथावद विप्रेन्द्रान श्रावयेद भक्तिसंयुतान ।\nसर्वपापविनिमुक्तो ब्रह्मासायुज्यमाप्नुयात ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7005527137, "chapter_id": 25527, "verse_number": "२-४४-१३८", "content_sanskrit": "योऽश्रद्धधाने पुरुषे दध्याच्चाधार्मिके तथा ।\nस प्रेत्य गत्वा निरयान शुनां योनिं व्रजत्यधः ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7005527138, "chapter_id": 25527, "verse_number": "२-४४-१३९", "content_sanskrit": "नमस्कृत्वा हरिं विष्णुं जगद्योनिं सनातनम ।\nअध्येतव्यामिदं शास्त्रं कृष्णाद्वैपायनं तथा ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7005527139, "chapter_id": 25527, "verse_number": "२-४४-१४०", "content_sanskrit": "इत्याज्ञा देवदेवस्य विष्णोरमिततेजसः ।\nपाराशर्यस्य विप्रर्षर्व्यासस्य च महात्मनः ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7005527140, "chapter_id": 25527, "verse_number": "२-४४-१४१", "content_sanskrit": "श्रुत्वा नारायणाद दिव्यां नारदो भगवानृषिः ।\nगौतमाय ददौ पुर्व तस्माच्चैव पराशरः ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7005527141, "chapter_id": 25527, "verse_number": "२-४४-१४२", "content_sanskrit": "पराशरोऽपि भगवान गंगाद्वारे मुनीश्वराः ।\nमनिभ्यः कथयामास धर्मकामार्थमोक्षदम ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7005527142, "chapter_id": 25527, "verse_number": "२-४४-१४३", "content_sanskrit": "ब्रह्माणा कथितं पुर्वं सनकाय च धीमते ।\nसनत्कुमाराय तथा सर्वपापप्रणाशनम ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7005527143, "chapter_id": 25527, "verse_number": "२-४४-१४४", "content_sanskrit": "सनकाद भगवान साक्षाद देवलो योगवित्तमः ।\nआवाप्तवान पंचशिखो देवलादिदमुत्तमम ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7005527144, "chapter_id": 25527, "verse_number": "२-४४-१४५", "content_sanskrit": "सनत्कुमाराद भगवान मुनिः सत्यवतीसुतः ।\nलेभे पुराणं परमं व्यासः सर्वार्थसंचयम ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7005527145, "chapter_id": 25527, "verse_number": "२-४४-१४६", "content_sanskrit": "तस्माद व्यासादहं श्रुत्वां पापनाशनम ।\nऊचिवान वै भवद्भिश्च दातव्यं धार्मिके जने ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7005527146, "chapter_id": 25527, "verse_number": "२-४४-१४७", "content_sanskrit": "तस्मै व्यासाय गुरवे सर्वज्ञाय महर्षये ।\nपाराशर्याय शान्ताय नमो नारायणात्मने ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7005527147, "chapter_id": 25527, "verse_number": "२-४४-१४८", "content_sanskrit": "यस्मात संजायते कृत्स्नं यत्र चैवं प्रलीयते ।\nनमस्तस्मै सुरेशाय विष्णवे कूर्मरुपिणे ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}]