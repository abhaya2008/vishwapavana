[{"id": 2039804, "chapter_id": 1880, "verse_number": "५-१२५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039805, "chapter_id": 1880, "verse_number": "५-१२५-१", "content_sanskrit": "ततः शान्तनवो भीष्मो दुर्योधनममर्षणम् ।\nकेशवस्य वचः श्रुत्वा प्रोवाच भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039806, "chapter_id": 1880, "verse_number": "५-१२५-२", "content_sanskrit": "कृष्णेन वाक्यमुक्तोऽसि सृहृदां शममिच्छता ।\nअन्वपद्यस्व तत्तात मा मन्युवशमन्वगाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039807, "chapter_id": 1880, "verse_number": "५-१२५-३", "content_sanskrit": "अकृत्वा वचनं तात केशवस्य महात्मनः ।\nश्रेयो न जातु न सुखं न कल्याणमवाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039808, "chapter_id": 1880, "verse_number": "५-१२५-४", "content_sanskrit": "धर्म्यमर्थ्यं महाबाहुराह त्वां तात केशवः ।\nतदर्थमभिपद्यस्व मा राजन्नीनशः प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039809, "chapter_id": 1880, "verse_number": "५-१२५-५", "content_sanskrit": "ज्वलितां त्वमिमां लक्ष्मीं भारतीं सर्वराजसु ।\nजीवतो धृतराष्ट्रस्य दौरात्म्याद्भंशयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039810, "chapter_id": 1880, "verse_number": "५-१२५-६", "content_sanskrit": "आत्मानं च सहामात्यं सपुत्रभ्रातृबान्धवम् ।\nअहमित्यनया बुद्ध्या जीविताद्धंशयिष्यतसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039811, "chapter_id": 1880, "verse_number": "५-१२५-७", "content_sanskrit": "अतिक्रामन्केशवस्य तथ्यं वचनमर्थवत्।\nपितुश्च भारतश्रेष्ठ विदुरस्य च धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039812, "chapter_id": 1880, "verse_number": "५-१२५-८", "content_sanskrit": "मा कुलघ्नः कुपुरुषो दुर्मतिः कापथं गमः।\nमातरं पितरं चैव मा मञ्जीः शोकसागरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039813, "chapter_id": 1880, "verse_number": "५-१२५-९", "content_sanskrit": "अथ द्रोणोऽब्रवीत्तत्र दुर्योधनमिदं वचः।\nअमर्षवशमापन्नं निःश्वसन्तं पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039814, "chapter_id": 1880, "verse_number": "५-१२५-१०", "content_sanskrit": "धर्मार्थयुक्तं वचनमाह त्वां तात केशवः ।\nतथा भीष्मः शान्तनवस्तञ्जुषस्व नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039815, "chapter_id": 1880, "verse_number": "५-१२५-११", "content_sanskrit": "प्राज्ञौ मेधाविनौ दान्तावर्थकामौ बहुश्रुतौ ।\nआहतुस्त्वां हितं वाक्यं तञ्जुषस्व नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039816, "chapter_id": 1880, "verse_number": "५-१२५-१२", "content_sanskrit": "अनुतिष्ठ महाप्राज्ञ कृष्णभीष्मौ यदूचतुः ।\nमाधवं बुद्धिमोहेन माऽवमंस्थाः परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039817, "chapter_id": 1880, "verse_number": "५-१२५-१३", "content_sanskrit": "ये त्वां प्रोत्साहयन्त्येते नैते कृत्याय कर्हिचित् ।\nवैरं परेषां ग्रीवायां प्रतिमोक्ष्यन्ति संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039818, "chapter_id": 1880, "verse_number": "५-१२५-१४", "content_sanskrit": "मा जीघनः प्रजाः सर्वाः पुत्रान्भ्रातॄंस्तथैव च ।\nवासुदेवार्जुनौ यत्र विद्ध्यजेयानलं हि तान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039819, "chapter_id": 1880, "verse_number": "५-१२५-१५", "content_sanskrit": "एतच्चैव मतं सत्यं सुहृदोः कृष्णभीष्मयोः।\nयदि नादास्यसे तात पश्चात्तप्स्यसि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039820, "chapter_id": 1880, "verse_number": "५-१२५-१६", "content_sanskrit": "यथोक्तं जामदग्न्येन भूयानेष ततोऽर्जुनः।\nकृष्णो हि देवकीपुत्रो देवैरपि सुदुःसहः ।\nकिं ते सुखप्रियेणेह प्रोक्तेन भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039821, "chapter_id": 1880, "verse_number": "५-१२५-१७", "content_sanskrit": "एतत्ते सर्वमाख्यातं यथेच्छसि तथा कुरु।\nन हि त्वामुत्सहे वक्तुं भूयो भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039822, "chapter_id": 1880, "verse_number": "५-१२५-१८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039823, "chapter_id": 1880, "verse_number": "५-१२५-१८", "content_sanskrit": "तस्मिन्वाक्यान्तरे वाक्यं क्षत्ताऽपि विदुरोऽब्रवीत्।\nदुर्योधनमभिप्रेक्ष्य धार्तराष्ट्रममर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039824, "chapter_id": 1880, "verse_number": "५-१२५-१९", "content_sanskrit": "दुर्योधन न शोचामि त्वामहं भरतर्षभ ।\nइमो तु वृद्धौ शोचामि गान्धारीं पितरं च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039825, "chapter_id": 1880, "verse_number": "५-१२५-२०", "content_sanskrit": "यावनाथौ चरिष्येते त्वया नाथेन दुर्हृदा।\nहतमित्रौ हतामात्यौ लूनपक्षाविवाण्डजौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039826, "chapter_id": 1880, "verse_number": "५-१२५-२१", "content_sanskrit": "भिक्षुकौ विचरिष्येते शोचन्तौ पृथिवीमिमाम्।\nकुलघ्नमीदृशं पापं जनयित्वा कुपूरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039827, "chapter_id": 1880, "verse_number": "५-१२५-२२", "content_sanskrit": "अथ दुर्योधं राजा धृतराष्ट्रोऽभ्यभाषत।\nआसीनं भ्रातृभिः सार्धं राजभिः परिवारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039828, "chapter_id": 1880, "verse_number": "५-१२५-२३", "content_sanskrit": "दुर्योधन निबोधेदं शौरिणोक्तं महात्मना ।\nआदत्स्व शिवमत्यन्तं योगक्षेमवदव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039829, "chapter_id": 1880, "verse_number": "५-१२५-२४", "content_sanskrit": "अनेन हि सहायेन कृष्णेनाक्लिष्टकर्मणा ।\nइष्टान्सर्वानभिप्रायान्प्राप्स्यामः सर्वराजसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039830, "chapter_id": 1880, "verse_number": "५-१२५-२५", "content_sanskrit": "सुसंहतः केशवेन तात गच्छ युधिष्ठिरम् ।\nचर स्वस्त्ययनं कृत्स्नं भरतानामनामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2039831, "chapter_id": 1880, "verse_number": "५-१२५-२६", "content_sanskrit": "वासुदेवेन तीर्थेन तात गच्छस्व संशमम् ।\nकालप्राप्तमिदं मन्ये मा त्वं दुर्योधनातिगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2039832, "chapter_id": 1880, "verse_number": "५-१२५-२७", "content_sanskrit": "शमं चेद्याचमानं त्वं प्रत्याख्यास्यसि केशवम् ।\nत्वदर्थमभिजल्पन्तं न तवास्त्यपराभवः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2039833, "chapter_id": 1880, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवाद्यनपर्वणि पञ्चविंशत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]