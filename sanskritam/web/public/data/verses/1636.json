[{"id": 2029176, "chapter_id": 1636, "verse_number": "३-२७४-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029177, "chapter_id": 1636, "verse_number": "३-२७४-१", "content_sanskrit": "एवं हृतायां कृष्णायां प्राप्य क्लेशमनुत्तमम्।\nअत ऊर्द्वं नरव्याघ्राः किमकुर्वत पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029178, "chapter_id": 1636, "verse_number": "३-२७४-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029179, "chapter_id": 1636, "verse_number": "३-२७४-२", "content_sanskrit": "एवं कृष्णां मोक्षयित्वाविनिर्जित्य जयद्रथम्।\nआसांचक्रे मुनिगणैर्धर्मराजो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029180, "chapter_id": 1636, "verse_number": "३-२७४-३", "content_sanskrit": "तेषां मध्येमहर्षीणां शृण्वतामनुशोचताम्।\nमार्कण्डेयमिदं वाक्यमब्रवीत्पाण्डुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029181, "chapter_id": 1636, "verse_number": "३-२७४-४", "content_sanskrit": "भगवन्देवर्षीणां त्वं ख्यातो भूतभविष्यवित्।\nसंशयं परिपृच्छमि च्छिन्धि मे हृदि संस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029182, "chapter_id": 1636, "verse_number": "३-२७४-५", "content_sanskrit": "द्रुपदस्य सुता ह्येषा वेदिमध्यात्समुत्थिता।\nअयोनिजा महाभागास्नुषा पाण्डोर्महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029183, "chapter_id": 1636, "verse_number": "३-२७४-६", "content_sanskrit": "मन्ये कालश्च भगवान्दैवं च दुरतिक्रमम्।\nभवितव्यं च भूतानां यस् नास्ति व्यतिक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029184, "chapter_id": 1636, "verse_number": "३-२७४-७", "content_sanskrit": "कथं हि पत्नीमस्माकं धर्मज्ञां धर्मचारिणीम्।\nसंस्पृशेदीदृशो भावः शुचिं स्तैन्यमिवानृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029185, "chapter_id": 1636, "verse_number": "३-२७४-८", "content_sanskrit": "न हि पापं कृतंकिंचित्कर्म वा निन्दितं क्वचित्।\nद्रौपद्या ब्राह्मणेष्वेव धर्मः सुचरितो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029186, "chapter_id": 1636, "verse_number": "३-२७४-९", "content_sanskrit": "तां जहार बलाद्राजा मूढबुद्धिर्जयद्रथः।\nतस्याः संहरणात्पापः शिरसः केशवापनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029187, "chapter_id": 1636, "verse_number": "३-२७४-१०", "content_sanskrit": "पराजयं च संग्रामे ससहाः समाप्तवान्।\nप्रत्याहृता तथाऽस्माभिर्हत्वा तत्सैन्धवं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029188, "chapter_id": 1636, "verse_number": "३-२७४-११", "content_sanskrit": "तद्दारहरणं प्राप्तमस्माभिरवितर्कितम्।\nदुःखश्चायं वने वासो मृगयायां च जीविका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029189, "chapter_id": 1636, "verse_number": "३-२७४-१२", "content_sanskrit": "हिंसा च मृगजातीनां वनौकोभिर्वनौकसाम्।\nज्ञातिभिर्विप्रवासश्च मिथ्याव्यवसितैरियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029190, "chapter_id": 1636, "verse_number": "३-२७४-१३", "content_sanskrit": "अस्ति नूनं मया कश्चिदल्पभाग्यतरो नरः।\nभवता दृष्टपूर्वो वा श्रुतपूर्वोऽपि वा क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029191, "chapter_id": 1636, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वणि चतुःसप्तत्यधिकद्विशततमोऽध्यायः ॥ २७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]