[{"id": 2210282, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "नकुलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2210283, "chapter_id": 5499, "verse_number": "१", "content_sanskrit": "अत्र वो वर्तयिष्यामि दानस्य फलमुत्तमम् ।\nन्यायलब्धस्य सूक्ष्मस्य विप्रे दत्तस्य वै द्विजाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2210284, "chapter_id": 5499, "verse_number": "२", "content_sanskrit": "धर्मक्षेत्रे कुरुक्षेत्रे धर्मज्ञैर्बहुभिर्वृते ।\nउञ्छवृत्तिर्द्विजः कश्चित् कापोतिरभवत् तदा(पुरा) ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2210285, "chapter_id": 5499, "verse_number": "३", "content_sanskrit": "सभार्यः सह पुत्रेण सस्नुषस्तपसि स्थितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2210286, "chapter_id": 5499, "verse_number": "४", "content_sanskrit": "वधूचतुर्थो वृद्धः स धर्मात्मा नियतेन्द्रियः ।\nषष्ठे काले सदा विप्रो भुङ्क्ते तैः सह सुव्रतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2210287, "chapter_id": 5499, "verse_number": "५", "content_sanskrit": "षष्ठे काले कदाचित्तु तस्याहारो न विद्यते ।\nभुङ्क्तेऽन्यस्मिन् कदाचित् स षष्ठे काले द्विजोत्तमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2210288, "chapter_id": 5499, "verse_number": "६", "content_sanskrit": "कापोतधर्मिणस्तस्य दुर्भिक्षे सति दारुणे ।\nनाविद्यत तदा विप्राः सञ्चयस्तन्निबोधत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2210289, "chapter_id": 5499, "verse_number": "७", "content_sanskrit": "क्षीणौषधिसमावापो द्रव्यहीनोऽभवत् तदा ।\nक्षीणे कालेऽस्य सम्प्राप्ते नैवाविद्यत भोजनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2210290, "chapter_id": 5499, "verse_number": "८", "content_sanskrit": "क्षुधापरिगताः सर्वे प्रातिष्ठन्त तदा तु ते ।\nउञ्छं तदा शुक्लपक्षे मध्यं तपति भास्करे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2210291, "chapter_id": 5499, "verse_number": "९", "content_sanskrit": "उष्णार्तश्च क्षुधार्तश्च विप्रस्तपसि निष्ठितः ।\nउञ्छमप्राप्तवानेव सार्धं परिजनेन ह ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2210292, "chapter_id": 5499, "verse_number": "१०", "content_sanskrit": "स तथैव क्षुधाविष्टः स्पृष्ट्वा तोयं यथाविधि ।\nक्षपयामास तं कालं सार्धं परिजनेन ह ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2210293, "chapter_id": 5499, "verse_number": "११", "content_sanskrit": "अथ षष्ठे गते काले ते यवप्रस्थमार्जयन् ।\nयवप्रस्थं च तत् सक्तून् अकुर्वन्त तपस्विनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2210294, "chapter_id": 5499, "verse_number": "१२", "content_sanskrit": "कृतजप्याह्निकास्ते तु हुत्वा वह्निं यथाविधि ।\nकुडुपं कुडुपं सर्वे व्यभजन्त तपस्विनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2210295, "chapter_id": 5499, "verse_number": "१३", "content_sanskrit": "अथागमद् द्विजः कश्चिद् अथिथिर्भुञ्जतां तदा ।\nते तं दृष्ट्वाऽतिथिं तत्र प्रहृष्टमनसोऽभवन् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2210296, "chapter_id": 5499, "verse_number": "१४", "content_sanskrit": "तेऽभिवाद्य सुखप्रश्नं पृष्ट्वा तमतिथिं तदा ।\nविशुद्धमनसो दान्ताः श्रद्धादमसमन्विताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2210297, "chapter_id": 5499, "verse_number": "१५", "content_sanskrit": "अनसूया गतक्रोधाः साधवो गतमत्सराः ।\nत्यक्तात्मानो जितक्रोधा धर्मज्ञा द्विजसत्तमाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2210298, "chapter_id": 5499, "verse_number": "१६", "content_sanskrit": "सब्रह्मचर्यं ते गोत्रमाख्यायाथ परस्परम् ।\nकुटीं प्रवेशयामासुः क्षुधार्थमतिथिं तदा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2210299, "chapter_id": 5499, "verse_number": "१७", "content_sanskrit": "इदमर्घ्यं च पाद्यं च बृसी चेयं तवानघ ।\nशुचयः सक्तवश्चेमे नियमोपार्जिताः प्रभो ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2210300, "chapter_id": 5499, "verse_number": "१८", "content_sanskrit": "प्रतिगृह्णीष्व भद्रं ते मया दत्तान् द्विजोतम ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2210301, "chapter_id": 5499, "verse_number": "१९", "content_sanskrit": "इत्युक्तः प्रतिगृह्याद्य सक्तूनां कुडुपं द्विजः ।\nभक्षयामास राजेन्द्र न च तुष्टिं जगाम सः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2210302, "chapter_id": 5499, "verse_number": "२०", "content_sanskrit": "स उञ्छवृत्तिस्तं प्रेक्ष्य क्षुधापरिगतं द्विजम् ।\nआहारं चिन्तयामास कथं तुष्टो भवेदिति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2210303, "chapter_id": 5499, "verse_number": "२१", "content_sanskrit": "तस्य भार्याऽब्रवीद् राजन् मद्भागो दीयतामयम् ।\nगच्छत्वेष यथाकामं सन्तुष्टो द्विजसत्तमः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2210304, "chapter_id": 5499, "verse_number": "समाप्तिः", "content_sanskrit": "इति ब्रुवन्तीं तां साध्वीं धर्मात्मा स द्विजर्षभः ।\nक्षुधापरिगतां ज्ञात्वा सक्तूंस्तान् नाभ्यनन्दत ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2210305, "chapter_id": 5499, "verse_number": "२३", "content_sanskrit": "जानन् वृद्धां क्षुधार्तां च श्रान्तां ग्लानां तपस्विनीम् ।\nत्वगस्थिभूतां ध्यायन्तीं ततो भार्यामुवाच ताम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2210306, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2210307, "chapter_id": 5499, "verse_number": "२४", "content_sanskrit": "अपि कीटपतङ्गानां मृगाणां चैव शोभने ।\nस्त्रियो रक्ष्याश्च पोष्याश्च नैवं त्वं वक्तुमर्हसि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2210308, "chapter_id": 5499, "verse_number": "२५", "content_sanskrit": "अनुकम्प्यो नरः पत्न्या पुष्टो रक्षित एव च ।\nप्रपतेन्निरयं दीप्तं न च लोकानवाप्नुयात् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2210309, "chapter_id": 5499, "verse_number": "२६", "content_sanskrit": "इत्युक्तः स तथा प्राह धर्मार्थौ तौ समौ मुने ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2210310, "chapter_id": 5499, "verse_number": "२७", "content_sanskrit": "सक्तुप्रस्थ चतुर्भागं गृहाण त्वं प्रसीद मे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2210311, "chapter_id": 5499, "verse_number": "२८", "content_sanskrit": "सत्यं रतिश्च धर्मश्च स्वर्गश्च गुणनिर्जितः ।\nस्त्रीणां पतिसमाधानं तपश्चेदं द्विजोत्तम ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2210312, "chapter_id": 5499, "verse_number": "२९", "content_sanskrit": "भ्रातुर्मातुः पितुर्बीजं दैवतं परमं पतिः ।\nभर्तुः प्रसादात् स्त्रीणां वै रतिपुत्रफलं तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2210313, "chapter_id": 5499, "verse_number": "३०", "content_sanskrit": "पालनाद्धि पतिस्त्वं मे भर्ताऽसि भरणान्वितः ।\nपुत्रप्रदानाद् वरदः तस्मात् सक्तून् गृहाण मे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2210314, "chapter_id": 5499, "verse_number": "३१", "content_sanskrit": "जरापरिगतो वृद्धः क्षुधार्तो दुर्बलोऽदृढः ।\nउपवासपरिश्रान्तो यदा त्वमपि कर्शितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2210315, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2210316, "chapter_id": 5499, "verse_number": "३२", "content_sanskrit": "इत्युक्तः स तया सक्तून् प्रगृह्येदं वचोऽब्रवीत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2210317, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "भर्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2210318, "chapter_id": 5499, "verse_number": "३३", "content_sanskrit": "द्विज सक्तूनिमान् भूयः प्रतिगृह्णीष्व सत्तम ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2210319, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2210320, "chapter_id": 5499, "verse_number": "३४", "content_sanskrit": "स तान् प्रगृह्य भुक्त्वा च न तुष्टिमगमन्मुनिः ।\nतमुञ्छवृत्तिरालक्ष्य ततश्चिन्तापरोऽभवत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2210321, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "पुत्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2210322, "chapter_id": 5499, "verse_number": "३५", "content_sanskrit": "सक्तूनिमान् प्रगृह्य त्वं देहि विप्राय सत्तम ।\nइत्येव सुकृतं मन्ये तस्मादेतत् करोम्यहम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2210323, "chapter_id": 5499, "verse_number": "३६", "content_sanskrit": "भवान् हि परिपाल्यो मे सर्वयत्नैर्द्विजोत्तम ।\nसाधूनां काङ्क्षितं ह्येतत् पितुर्वृद्धस्य पोषणम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2210324, "chapter_id": 5499, "verse_number": "३७", "content_sanskrit": "पुत्रार्थो विहितो ह्येष स्थाविर्ये परिपालनम् ।\nश्रुतिरेषा हि विप्रर्षे त्रिषु लोकेषु शाश्वती ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2210325, "chapter_id": 5499, "verse_number": "३८", "content_sanskrit": "प्राणधारणमात्रेण शक्यं कर्तुं तपस्त्वया ।\nप्राणा हि परमो धर्मः स्थिता देहेषु देहिनाम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2210326, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "पिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2210327, "chapter_id": 5499, "verse_number": "३९", "content_sanskrit": "अपि वर्षसहस्रं बाल एव मतो मम ।\nउत्पाद्य पुत्रं हि पिता कृतकृत्यो भवत्युत ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2210328, "chapter_id": 5499, "verse_number": "४०", "content_sanskrit": "बालानां क्षुद्बलवती जानाम्येतदहं तव ।\nवृद्धोऽहं धारयिष्यामि त्वं बली भव पुत्रक ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2210329, "chapter_id": 5499, "verse_number": "४१", "content_sanskrit": "जीर्णेन वयसा पुत्र न मां क्षुद्बाधतेऽपि च ।\nदीर्घकालं तपस्तप्तं न मे मरणतो भयम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2210330, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "पुत्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2210331, "chapter_id": 5499, "verse_number": "४२", "content_sanskrit": "अपत्यमस्मि ते पुत्रः त्राणात् पुत्रो हि विश्रुतः ।\nआत्मा पुत्रः स्मृतस्तस्मात् त्राह्यात्मानमिहात्मना ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2210332, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "पिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2210333, "chapter_id": 5499, "verse_number": "४३", "content_sanskrit": "रूपेण सदृशस्त्वं मे शीलेन बलेन च ।\nपरीक्षितस्य बहुधा सक्तूनादद्मि ते सुत ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2210334, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2210335, "chapter_id": 5499, "verse_number": "४४", "content_sanskrit": "इत्युक्त्वाऽऽदाय तान् सक्तून् प्रीतात्मा द्विजसत्तमः ।\nप्रहसन्निव विप्राय स तस्मै प्रददौ तदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2210336, "chapter_id": 5499, "verse_number": "४५", "content_sanskrit": "भुक्त्वा तानपि सक्तून् स नैव तुष्टो बभूव ह ।\nउञ्छवृत्तिस्तु सव्रीलो बभूव द्विजसत्तमः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2210337, "chapter_id": 5499, "verse_number": "४६", "content_sanskrit": "तदा वधूः स्थिता साध्वी ब्राह्मणप्रियकाम्यया ।\nसक्तूनादाय संहृष्टा गुरुं तं वाक्यमब्रवीत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2210338, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "वधूः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2210339, "chapter_id": 5499, "verse_number": "४७", "content_sanskrit": "सन्तानात् तव सन्तानं ममापि प्रभविष्यति ।\nसक्तूनिमानतिथये गृहीत्वा त्वं प्रयच्छ मे ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2210340, "chapter_id": 5499, "verse_number": "४८", "content_sanskrit": "तव प्रसवनिर्वृत्या मम लोकाः किलाक्षयाः ।\nपौत्रेण तानवाप्नोति यत्र गत्वा न शोचति ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2210341, "chapter_id": 5499, "verse_number": "४९", "content_sanskrit": "धर्मं याति तथा त्रेता वह्नित्रेता तथैव च ।\nतथैव पुत्रपौत्राणां स्वर्गे त्रेताः किलाक्षयाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2210342, "chapter_id": 5499, "verse_number": "५०", "content_sanskrit": "पितॄणां तारणात् तस्मात् पुत्र इत्यनुशुश्रुमः ।\nपुत्रपौत्रैश्च नियतः साधुलोकानुपाश्नुते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2210343, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "श्वशुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2210344, "chapter_id": 5499, "verse_number": "५१", "content_sanskrit": "वातातपविशीर्णाङ्गीं त्वं विशीर्णां निरीक्ष्य वै ।\nकर्शितां सुव्रताचारैः क्षुधाविह्वलचेतसम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2210345, "chapter_id": 5499, "verse_number": "५२", "content_sanskrit": "कथं सक्तून् ग्रहीष्यामि भूत्वा धर्मोपघातकः ।\nकल्याणवृत्ते कल्याणि नैवं त्वं वक्तुमर्हसि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2210346, "chapter_id": 5499, "verse_number": "५३", "content_sanskrit": "षष्ठे काले व्रतवतीं शीलशौचतपोन्विताम् ।\nकृच्छ्रवृत्तिं निराहारां द्रक्ष्यामि त्वां कथं न्वहम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2210347, "chapter_id": 5499, "verse_number": "५४", "content_sanskrit": "बाला क्षुधार्ता नारी च रक्ष्या त्वं सततं मया ।\nउपवासपरिश्रान्ता त्वं हि बान्धवनन्दिनी ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2210348, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "स्नुषा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2210349, "chapter_id": 5499, "verse_number": "५५", "content_sanskrit": "गुरोर्मम गुरुस्त्वं हि यतो दैवतदैवतम् ।\nदेवातिदेवस्तस्मात् त्वं सक्तूनादत्स्व मे विभो ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2210350, "chapter_id": 5499, "verse_number": "५६", "content_sanskrit": "देहः प्राणाश्च धर्मश्च शुश्रूषार्थमिदं गुरो ।\nतव विप्र प्रसादेन लोकान् प्राप्स्याम्यभीप्सितान् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2210351, "chapter_id": 5499, "verse_number": "५७", "content_sanskrit": "अवेक्ष्या हीति कृत्वा त्वं दृढभक्तेति मां द्विज ।\nचिन्त्या ममेयमिति वा सक्तूनादातुमर्हसि ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2210352, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "श्वशुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2210353, "chapter_id": 5499, "verse_number": "५८", "content_sanskrit": "अनेन नित्यं साध्वी त्वं शीलवृत्तेन शोभसे ।\nयत् त्वं धर्मपथोपेता गुरुवृत्तिमवेक्षसे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2210354, "chapter_id": 5499, "verse_number": "५९", "content_sanskrit": "तस्मात् सक्तून् ग्रहीष्यामि वधूर्नार्हसि वञ्चनाम् ।\nगणयित्वा महाभागे त्वं हि धर्मभृतां वरे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2210355, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2210356, "chapter_id": 5499, "verse_number": "६०", "content_sanskrit": "इत्युक्त्वा तानुपादाय सक्तून् प्रादाद् द्विजातये ।\nततस्तुष्टोऽभवद् विप्रस्तस्य साधोर्महात्मनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2210357, "chapter_id": 5499, "verse_number": "६१", "content_sanskrit": "प्रीतात्मा स तु तं वाक्यमिदमाह द्विजर्षभम् ।\nवाग्मी तदा द्विजश्रेष्ठो धर्मः पुरुषविग्रहः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2210358, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2210359, "chapter_id": 5499, "verse_number": "६२", "content_sanskrit": "अनेन सक्तुदानेन न्यायोपेतेन तत्त्वतः ।\nयथाशक्ति विमुक्तेन प्रीतोऽस्मि तव सत्तम ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2210360, "chapter_id": 5499, "verse_number": "६३", "content_sanskrit": "अहो दानं विघुष्टं ते स्वर्गे स्वर्गनिवासिभिः ।\nगगनात् पुष्पवर्षं च पश्य त्वं पतितं भुवि ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2210361, "chapter_id": 5499, "verse_number": "६४", "content_sanskrit": "सुरा देवर्षिगन्धर्वा ये च देवपुरःसराः ।\nस्तुवन्तो देवदूताश्च सिद्धाश्चापि सुविस्मिताः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2210362, "chapter_id": 5499, "verse_number": "६५", "content_sanskrit": "ब्रह्मर्षयो विमानस्था ब्रह्मलोकगताश्च ये ।\nकाक्षन्ते दर्शनं त्वद्य दिवं गच्छ द्विजर्षभ ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2210363, "chapter_id": 5499, "verse_number": "६६", "content_sanskrit": "पितृलोकगताः सर्वे तारिताः पितरस्त्वया ।\nअनागताश्च बहवः सुबहूनि युगानि च ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2210364, "chapter_id": 5499, "verse_number": "६७", "content_sanskrit": "ब्रह्मचर्येण यज्ञेन दानेन तपसाऽथवा ।\nअगह्वरेण धर्मेण तस्माद् गच्छ दिवं द्विज ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2210365, "chapter_id": 5499, "verse_number": "६८", "content_sanskrit": "श्रद्धया परया यत् त्वं तपश्चरसि सुव्रत ।\nतस्माद् देवास्तवानेन प्रीता द्विजवरोत्तम ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2210366, "chapter_id": 5499, "verse_number": "६९", "content_sanskrit": "सर्वस्वमेतद् यस्मात् ते त्यक्तं शुद्धेन चेतसा ।\nकृच्छ्रकाले ततः स्वर्गो जितोऽयं तव कर्मणा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2210367, "chapter_id": 5499, "verse_number": "७०", "content_sanskrit": "क्षुधा निर्णुदति प्रज्ञां धर्म्यां बुद्धिं व्यपोहति ।\nक्षुधापरिगतज्ञानो धृतिं त्यजति चैव हि ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2210368, "chapter_id": 5499, "verse_number": "७१", "content_sanskrit": "बुभुक्षां जयते यस्तु स स्वर्गं जयते ध्रुवम् ।\nयदा दानरुचेर्भावस्तदा धर्मो नु सिद्ध्यति ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2210369, "chapter_id": 5499, "verse_number": "७२", "content_sanskrit": "अनवेक्ष्य सुतस्नेहं कलत्रस्नेहमेव च ।\nधर्ममेव गुरुं ज्ञात्वा तृष्णा न गणिता त्वया ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2210370, "chapter_id": 5499, "verse_number": "७३", "content_sanskrit": "द्रव्यागमो नृणां सूक्ष्मः पात्रे दानं ततः परम् ।\nकालः परतरो दानात् श्रद्धा चापि ततः परा ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2210371, "chapter_id": 5499, "verse_number": "७४", "content_sanskrit": "स्वर्गद्वारं सुसूक्ष्मं हि नरैर्मोहान्न दृश्यते ।\nसङ्गार्गलं लोभकीलं रागगुप्तं दुरासदम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2210372, "chapter_id": 5499, "verse_number": "७५", "content_sanskrit": "तं तु पश्यन्ति पुरुषा जितक्रोधा जितेन्द्रियाः ।\nब्राह्मणास्तपसा युक्ता यथाश्रद्धाप्रदायिनः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2210373, "chapter_id": 5499, "verse_number": "७६", "content_sanskrit": "सहस्रशक्तिश्च शतं शतशक्तिर्दशापि च ।\nदद्यादपश्च यः शक्त्या सर्वे तुल्यफलाः स्मृताः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2210374, "chapter_id": 5499, "verse_number": "७७", "content_sanskrit": "रन्तिदेवोऽपि नृपतिरापः प्रादादकिञ्चनः ।\nशुद्धेन मनसा विप्र नाकपृष्ठं ततो गतः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2210375, "chapter_id": 5499, "verse_number": "७८", "content_sanskrit": "न धर्मः प्रीयते तात दानैर्दत्तैर्महाफलैः ।\nन्यायलब्धैर्यथा सूक्ष्मैः श्रद्धापूतैः स तुष्यति ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2210376, "chapter_id": 5499, "verse_number": "७९", "content_sanskrit": "गोप्रदानसहस्राणि द्विजातिभ्यो नृगो नृपः ।\nएकं दत्वा परस्वं तु नरकं समवाप्तवान् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2210377, "chapter_id": 5499, "verse_number": "८०", "content_sanskrit": "आत्ममांसप्रदानेन शिबिरौशीनरो नृपः ।\nप्राप्य पुण्यकृतान् लोकान् मोदते दिवि सुव्रतः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2210378, "chapter_id": 5499, "verse_number": "८१", "content_sanskrit": "विभवेन नृणां पुण्यं स्वशक्त्या स्वार्जितं नृणाम् ।\nन यज्ञैर्विविधैर्विप्र यथा न्यायेन सञ्चितैः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2210379, "chapter_id": 5499, "verse_number": "८२", "content_sanskrit": "क्रोधो दानफलं हन्ति लोभात् स्वर्गं न गच्छति ।\nन्यायवृत्तिर्हि तपसा दानवित् स्वर्गमश्नुते ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2210380, "chapter_id": 5499, "verse_number": "८३", "content_sanskrit": "न राजसूयैर्बहुभिरिष्ट्वा विपुलदक्षिणैः ।\nन चाश्वमेधैर्बहुभिः फलं सममिदं तव ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2210381, "chapter_id": 5499, "verse_number": "८४", "content_sanskrit": "सक्तुप्रस्थेन हि जितो ब्रह्मलोकस्त्वयाऽनघ ।\nविरजो ब्रह्मसदनं गच्छ विप्र यथेप्सितम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2210382, "chapter_id": 5499, "verse_number": "८५", "content_sanskrit": "सर्वेषां वो द्विजश्रेष्ठ दिव्यं यानमुपस्थितम् ।\nआरोहत यथाकामं धर्मोऽस्मि द्विजसत्तम ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2210383, "chapter_id": 5499, "verse_number": "८६", "content_sanskrit": "पावितो हि त्वया देहो लोके कीर्तिः स्थिरा च ते ।\nसभार्यः सहपुत्रश्च सस्नुषश्च दिवं व्रज ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2210384, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "नकुलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2210385, "chapter_id": 5499, "verse_number": "८७", "content_sanskrit": "इत्युक्तवाक्यो धर्मेण यानमारुह्य स द्विजः ।\nसभार्यः सस्नुषश्चापि ससुतश्च दिवं ययौ ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2210386, "chapter_id": 5499, "verse_number": "८८", "content_sanskrit": "तस्मिन् विप्रे गते स्वर्गं सपुत्रे सस्नुषे तदा ।\nभार्याचतुर्थे धर्मज्ञे ततोऽहं निःसृतो बिलात् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2210387, "chapter_id": 5499, "verse_number": "८९", "content_sanskrit": "ततस्तु सक्तुगन्धेन क्लेदेन सलिलस्य च ।\nदिव्यपुष्पावमर्दाच्च साधोर्दानलवैश्च तैः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2210388, "chapter_id": 5499, "verse_number": "९०", "content_sanskrit": "विप्रस्य तपसा तस्य शिरो मे काञ्चनीकृतम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2210389, "chapter_id": 5499, "verse_number": "९१", "content_sanskrit": "तस्य सत्याभिसन्धस्य सूक्ष्मदानेन चैव ह ।\nशरीरार्धं च मे विप्राः शातकुम्भमयं कृतम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2210390, "chapter_id": 5499, "verse_number": "९२", "content_sanskrit": "पश्यतेदं सुविपुलं तपसा तस्य धीमतः ।\nकथमेवंविधं मे स्यात् अन्यत् पार्श्वमिति द्विजाः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2210391, "chapter_id": 5499, "verse_number": "९३", "content_sanskrit": "तपोवनानि यज्ञांश्च हृष्टोऽभ्येमि पुनः पुनः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2210392, "chapter_id": 5499, "verse_number": "९४", "content_sanskrit": "यज्ञं त्वहमिमं श्रुत्वा कुरुराजस्य धीमतः ।\nआशया परया प्राप्तो न चाहं काञ्चनः कृतः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2210393, "chapter_id": 5499, "verse_number": "९५", "content_sanskrit": "ततो मयोक्तं तत्पुण्यं प्रशस्य द्विजसत्तमाः ।\nसक्तुप्रस्थेन यज्ञोऽयं सम्मितो नेति सर्वथा ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2210394, "chapter_id": 5499, "verse_number": "९६", "content_sanskrit": "सक्तुप्रस्थलवैस्तैर्हि तदाऽहं काञ्चनीकृतः ।\nन हि यज्ञो महानेष सदृशस्तैर्मतो मम ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2210395, "chapter_id": 5499, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2210396, "chapter_id": 5499, "verse_number": "९७", "content_sanskrit": "इत्युक्त्वा नकुलः सर्वान् यज्ञे द्विजवरांस्तदा ।\nजगामादर्शनं राजन् ते च विप्रा ययुर्गृहान् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2210397, "chapter_id": 5499, "verse_number": "९८", "content_sanskrit": "एतत् ते सर्वमाख्यातं मया परपुरञ्जय ।\nयदाश्चर्यमभूत् तस्मिन्नश्वमेधे महाक्रतौ ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2210398, "chapter_id": 5499, "verse_number": "९९", "content_sanskrit": "न विस्मयस्ते नृपते यज्ञे कार्यः कथञ्चन ।\nऋषिकोटिसहस्राणि तपोभिर्ये दिवं गताः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2210399, "chapter_id": 5499, "verse_number": "१००", "content_sanskrit": "अद्रोहः सर्वभूतेषु सन्तोषः शीलमार्जवम् ।\nतपो दमश्च सत्यं च प्रदानं चेति सम्मितम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2210400, "chapter_id": 5499, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि सक्तुप्रस्थयज्ञप्रशंसनं नाम त्रिनवतितमोऽध्यायः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}]