[{"id": 2136256, "chapter_id": 3954, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136257, "chapter_id": 3954, "verse_number": "१", "content_sanskrit": "ततस्तां भर्तृशोकार्तां दीनां मलिनवाससम् ।\nमणिशेषाभ्यलङ्कारां रुदतीं च पतिव्रताम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136258, "chapter_id": 3954, "verse_number": "२", "content_sanskrit": "राक्षसीभिरुपास्यन्तीं समासीनां शिलातळे ।\nरावणः कामबाणार्तो ददर्शोपससर्प च \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136259, "chapter_id": 3954, "verse_number": "३", "content_sanskrit": "देवदानवगन्धर्वयक्षकिम्पुरुषैर्युधि ।\nअजितोऽशोकवनिकां ययौ कन्दर्पपीडितः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136260, "chapter_id": 3954, "verse_number": "४", "content_sanskrit": "दिव्याम्बरधरः श्रीमान्सुमृष्टमणिकुण्डलः ।\nविचित्रमाल्यमुकुटो वसन्त इव मूर्तिमान् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136261, "chapter_id": 3954, "verse_number": "५", "content_sanskrit": "न कल्पवृक्षसदृशो यत्नादपि विभूषितः ।\nश्मशानचैत्यद्रुमवद् भूषितोऽपि भयङ्करः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136262, "chapter_id": 3954, "verse_number": "६", "content_sanskrit": "स तस्यास्तनुमध्यायाः समीपे रजनीचरः ।\nददृशे रोहिणीमेत्य शनैश्चर इव ग्रहः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136263, "chapter_id": 3954, "verse_number": "७", "content_sanskrit": "स तामामन्त्र्य सुश्रोणीं पुष्पकेतुशराहतः।\nइदमित्यब्रवीद् बालां त्रस्तां मृगवधूमिव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136264, "chapter_id": 3954, "verse_number": "", "content_sanskrit": "रावणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136265, "chapter_id": 3954, "verse_number": "८", "content_sanskrit": "सीते पर्याप्तमेतावत्कृतो भर्तृरनुग्रहः ।\nप्रसादं कुरु तन्वङ्गि क्रियतां परिकर्म ते \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136266, "chapter_id": 3954, "verse_number": "९", "content_sanskrit": "भजस्व मां वरारोहे माहार्हाभरणाम्बरा ।\nभव मे सर्वनारीणामुत्तमा वरवर्णिनी \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136267, "chapter_id": 3954, "verse_number": "१०", "content_sanskrit": "सन्ति मे देवकन्याश्च गन्धर्वाणां च योषितः ।\nसन्ति दानवकन्याश्च दैत्यानां चापि योषितः ।\nतासामद्य विशालाक्षि सर्वासां मे भवोत्तमा \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136268, "chapter_id": 3954, "verse_number": "११", "content_sanskrit": "चतुर्दश पिशाचानां कोट्यो मे वचनस्थिताः ।\nद्विस्तावत् पुरुषादानां रक्षसां भीमकर्मणाम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136269, "chapter_id": 3954, "verse_number": "१२", "content_sanskrit": "ततो मे त्रिगुणा यक्षा ये मद्वचनकारिणः।\nकेचिदेव धनाध्यक्षं भ्रातरं मे समाश्रिताः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136270, "chapter_id": 3954, "verse_number": "१३", "content_sanskrit": "गन्धर्वाप्सरसो भद्रे मामापानगतं सदा ।\nउपा(प)तिष्ठन्ति वामोरु यथैव भ्रातरं मम \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136271, "chapter_id": 3954, "verse_number": "१४", "content_sanskrit": "पुत्रोऽहमपि विप्रर्षेः साक्षाद् विश्रवसो मुनेः।\nपञ्चमो लोकपालानामिति मे प्रथितं यशः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136272, "chapter_id": 3954, "verse_number": "१५", "content_sanskrit": "दिव्यानि भक्ष्यभोज्यानि पानानि विविधानि च ।\nयथैव त्रिदशेशस्य तथैव मम भामि(वि)नि \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2136273, "chapter_id": 3954, "verse_number": "१६", "content_sanskrit": "क्षीयतां दुष्कृतं कर्म वनवासकृतं तव ।\nभार्या मे भव सुश्रोणि यथा मण्डो(मन्दो)दरी तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2136274, "chapter_id": 3954, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2136275, "chapter_id": 3954, "verse_number": "१७", "content_sanskrit": "इत्युक्ता तेन वैदेही परिवृत्य शुभाननम्(नना)।\nतृणमन्तरितं(रतः) कृत्वा क्रोधसंरक्तलोचना\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2136276, "chapter_id": 3954, "verse_number": "१८", "content_sanskrit": "अशिवेनातिवामोरूरजस्रं नेत्रवारिणा ।\nस्तनावपतितौ बाला संहतावभिवर्षती \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2136277, "chapter_id": 3954, "verse_number": "१९", "content_sanskrit": "व्यवस्थाप्य कथञ्चित् सा विषादादतिमोहिता ।\nउवाच वाक्यं तं क्षुद्रं वैदेही पतिदेवता \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2136278, "chapter_id": 3954, "verse_number": "२०", "content_sanskrit": "असकृद् वदतो वाक्यमीदृशं राक्षसेश्वर ।\nविषादयुक्तमेतत् ते मया श्रुतमभाग्यया \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2136279, "chapter_id": 3954, "verse_number": "२१", "content_sanskrit": "तद् भद्रसुख भद्रं ते मानसं विनिवर्त्यताम् ।\nपरदारास्म्यलभ्या च सततं च पतिव्रता \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2136280, "chapter_id": 3954, "verse_number": "२२", "content_sanskrit": "न चैवौ(वो)पयिकी भार्या मानुषी तव राक्षस ।\nविवशां धर्षयित्वा च कां त्वं प्रीतिमवाप्स्यसि \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2136281, "chapter_id": 3954, "verse_number": "२३", "content_sanskrit": "प्रजापतिसमो विप्रो ब्रह्मयोनिः पिता तव ।\nन च पालयसे धर्मं लोकपालसमः कथम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2136282, "chapter_id": 3954, "verse_number": "२४", "content_sanskrit": "भ्रातरं राजराजं च महेश्वरसखं प्रभुम् ।\nधनेश्वरं व्यपदिशन् कथं त्विह न लज्जसे \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2136283, "chapter_id": 3954, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2136284, "chapter_id": 3954, "verse_number": "२५", "content_sanskrit": "इत्युक्त्वा प्रारुदत् सीता कम्पयन्ती पयोधरौ ।\nशिरोधरां च तन्वङ्गी मुखं प्रच्छाद्य वाससा \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2136285, "chapter_id": 3954, "verse_number": "२६", "content_sanskrit": "तस्या रुदत्या भामि(वि)न्या दीर्घा वेणी सुसंयता ।\nददृशेऽतितरां स्निग्धा काली व्यालीव मूर्धनि \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2136286, "chapter_id": 3954, "verse_number": "२७", "content_sanskrit": "श्रुत्वा तद् रावणो वाक्यं सीतयोक्तं सुनिष्ठुरम् ।\nप्रत्याख्यातोऽपि दुर्मेधाः पुनरेवाब्रवीद् वचः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2136287, "chapter_id": 3954, "verse_number": "", "content_sanskrit": "रावणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2136288, "chapter_id": 3954, "verse_number": "२८", "content_sanskrit": "काममङ्गानि मे सीते दुनोतु मकरध्वजः।\nन त्वामकामां सुश्रोणीं समेष्ये चारुहासिनीम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2136289, "chapter_id": 3954, "verse_number": "२९", "content_sanskrit": "किं नु शक्यं मया कर्तुं यत्त्वमद्यापि मानुषम् ।\nआहारभूतमस्माकं राममेवानुरुध्यसे \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2136290, "chapter_id": 3954, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2136291, "chapter_id": 3954, "verse_number": "३०", "content_sanskrit": "इत्युक्त्वा तामनिन्द्याङ्गीं स राक्षसमहेश्वरः।\nतत्रैवान्तर्हितो भूत्वा जगामाभिमतां दिशम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2136292, "chapter_id": 3954, "verse_number": "३१", "content_sanskrit": "राक्षसीभिः परिवृता वैदेही शोककर्शिता ।\nसेव्यमाना त्रिजटया तत्रैव न्यवसत् तदा \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2136293, "chapter_id": 3954, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि सप्तत्यधिकद्विशततमोऽध्यायः ॥२७०॥\nरामोपाख्यानपर्वणि सीतारावणसंवादे दशमोऽध्यायः ॥१०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]