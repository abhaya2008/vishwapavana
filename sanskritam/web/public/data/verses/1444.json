[{"id": 2021367, "chapter_id": 1444, "verse_number": "३-८२-०x", "content_sanskrit": "पुलस्त्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2021368, "chapter_id": 1444, "verse_number": "३-८२-१", "content_sanskrit": "ततो गच्छेन्महाराज धर्मतीर्थमनुत्तमम्।\n[यत्र धर्मो महाभागस्तप्तवानुत्तमं तपः ॥\nतेन तीर्थं कृतंपुण्यं स्वेन नाम्ना च विश्रुतम् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2021369, "chapter_id": 1444, "verse_number": "३-८२-२", "content_sanskrit": "तत्रस्नात्वा नरो राजन्धर्मशील समाहितः।\nआसप्तमं कुलं चैव पुनीते नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2021370, "chapter_id": 1444, "verse_number": "३-८२-३", "content_sanskrit": "ततो गच्छेत राजेन्द्र ज्ञानपावनमुत्तमम्।\nअग्निष्टोममवाप्नोति मुनिलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2021371, "chapter_id": 1444, "verse_number": "३-८२-४", "content_sanskrit": "सौगन्धिकवनं राजंस्ततो गच्छेत मानवः।\nतत्रब्रह्मादयो देवा ऋषयश्च तपोधनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2021372, "chapter_id": 1444, "verse_number": "३-८२-५", "content_sanskrit": "सिद्धचारणगन्धर्वाः किन्नराश्च महोरगाः।\nकतद्वनं प्रविशन्नेव सर्वपापैः प्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2021373, "chapter_id": 1444, "verse_number": "३-८२-६", "content_sanskrit": "ततश्चापि सरिचच्छ्रेष्ठा नदीनामुत्तमा नदी।\nप्लक्षा देवी स्मृता राजन्पुण्या देवी सरस्वती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2021374, "chapter_id": 1444, "verse_number": "३-८२-७", "content_sanskrit": "तत्राभिषेकं कुर्वीत वल्मीकान्निः सृतेजले।\nअर्चयित्वा पितॄन्देवानश्वमेधफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2021375, "chapter_id": 1444, "verse_number": "३-८२-८", "content_sanskrit": "कवेराध्युषितं नाम तत्र तीर्थं सुदुर्लभम्।\nपट्सु शम्यानिपातेषु वल्मीकादिति निश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2021376, "chapter_id": 1444, "verse_number": "३-८२-९", "content_sanskrit": "कपिलानां सहस्रं च वाजिमेधं च विन्दति।\nतत्र स्नात्वा नरव्याघ्र दृष्टमेतत्पुरातने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2021377, "chapter_id": 1444, "verse_number": "३-८२-१०", "content_sanskrit": "सुगन्धां शतकुम्भां च पञ्चयक्षां च भारत।\nअभिगम्य नरश्रेष्ठ स्वर्गलोके महीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2021378, "chapter_id": 1444, "verse_number": "३-८२-११", "content_sanskrit": "त्रिशूलखातं तत्रैव तीर्थमासाद्य भारत।\nतत्राभिषेकं कुर्वीत पितृदेवार्चने रतः।\nगाणपत्यं च लभते देहं त्यक्त्वा न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2021379, "chapter_id": 1444, "verse_number": "३-८२-१२", "content_sanskrit": "ततो गच्छेत राजेन्द्र देव्याः स्थानं सुदुर्लभम्।\nशाकम्भरीति विख्याता त्रिषु लोकेषु विश्रुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2021380, "chapter_id": 1444, "verse_number": "३-८२-१३", "content_sanskrit": "दिव्यं वर्षसहस्रं हि शाकेन किल सुव्रता।\nआहारं सा कृतवती मासिमासि नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2021381, "chapter_id": 1444, "verse_number": "३-८२-१४", "content_sanskrit": "ऋषयोऽभ्यागतास्तत्रदेव्या भक्त्या तपोधनाः।\nआतिथ्यं च कृतं तेषां शाकेन किल भारत।\nततः शाकम्भरीत्येव नाम तस्याः प्रतिष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2021382, "chapter_id": 1444, "verse_number": "३-८२-१५", "content_sanskrit": "शाकम्भरीं समासाद्य ब्रह्मचारी समाहितः।\nत्रिरात्रमुषितः शाकं भक्षयित्वा नरः शुचिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2021383, "chapter_id": 1444, "verse_number": "३-८२-१६", "content_sanskrit": "शाकाहारस्य यत्किंचिद्वर्षैर्द्वादशभिः कृतम्।\nतत्फलं तस्य भवति देव्याश्छन्देन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2021384, "chapter_id": 1444, "verse_number": "३-८२-१७", "content_sanskrit": "ततो गच्छेत्सुवर्णाख्यं त्रिषु लोकेषु विश्रुतम्।\nतत्र विष्णुः प्रसादार्थं रुद्रकमाराधयत्पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2021385, "chapter_id": 1444, "verse_number": "३-८२-१८", "content_sanskrit": "वरांश्च सुबर्हूल्लेभे दैवतेषु सुदुर्लभान्।\nउक्तश्च त्रिपुरघ्नेन परितुष्टेन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2021386, "chapter_id": 1444, "verse_number": "३-८२-१९", "content_sanskrit": "अपिच त्वं प्रियतरो लोके कृष्ण भविष्यसि।\nत्वन्मुखं च जगत्सर्वं भविष्ति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2021387, "chapter_id": 1444, "verse_number": "३-८२-२०", "content_sanskrit": "तत्राभिगम्य राजेन्द्र पूजयित्वा वृषध्वजम्।\nअश्वमेधमवाप्नोति गाणपत्यं च विन्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2021388, "chapter_id": 1444, "verse_number": "३-८२-२१", "content_sanskrit": "धूमावतीं ततो गच्छेत्रिरात्रोपोषितो नरः।\nमनसा प्रार्थितान्कार्माल्लभते नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2021389, "chapter_id": 1444, "verse_number": "३-८२-२२", "content_sanskrit": "देव्यास्तु दक्षिणार्धेन रथावर्तो नराधिप।\nतत्रारोहेत धर्मज्ञ श्रद्दधानो जितेन्द्रियः।\nमहादेवप्रसादाद्धि गच्छेत परमां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2021390, "chapter_id": 1444, "verse_number": "३-८२-२३", "content_sanskrit": "प्रदक्षिणमुपावृत्य गच्छेत भरतर्षभ।\nधारां नाम महाप्रात्र सर्वपापप्रमोचनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2021391, "chapter_id": 1444, "verse_number": "३-८२-२४", "content_sanskrit": "तत्र स्नात्वा नरव्याघ्र न शोचति नराधिप।\nततो गच्छेत धर्मज्ञ नमस्कृत् महागिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2021392, "chapter_id": 1444, "verse_number": "३-८२-२५", "content_sanskrit": "`अशीतियोजनशतं पुष्करं स्वर्गमुच्यते।\nअशीतिं धर्मपृष्ठात्तु प्रवदन्ति मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2021393, "chapter_id": 1444, "verse_number": "३-८२-२६", "content_sanskrit": "षष्टिं प्रयागाद्राजेन्द्र कुरुक्षेत्रात्तु द्वादश।\nसंयुक्तमेव राजेन्द्र गङ्गाद्वारं त्रिविष्टपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2021394, "chapter_id": 1444, "verse_number": "३-८२-२७", "content_sanskrit": "स्वर्गद्वारेण यत्तुल्यं गङ्गाद्वारं न संशयः।\nतत्राभिषेकं कुर्वीत कोटितीर्थे समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2021395, "chapter_id": 1444, "verse_number": "३-८२-२८", "content_sanskrit": "पौण्डरीकमवाप्नोति कुलं चैव समुद्धरेत्।\nउष्यैकां रजनीं तत्र गोसहस्रफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2021396, "chapter_id": 1444, "verse_number": "३-८२-२९", "content_sanskrit": "सप्तगङ्गे त्रिगङ्गे च शक्रावर्ते च तर्पयन्।\nदेवान्पितॄंश्च विधिवत्पुण्ये लोके महीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2021397, "chapter_id": 1444, "verse_number": "३-८२-३०", "content_sanskrit": "ततः कनस्वले स्नात्वा त्रिरात्रोपोषितो नरः।\nअश्वमेधमवाप्नोति स्वर्गलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2021398, "chapter_id": 1444, "verse_number": "३-८२-३१", "content_sanskrit": "कपिलावटं ततो गच्छेत्तीर्थसेवी नराधिप।\nउपोष्य रजनीं तत्र गोसहस्रफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2021399, "chapter_id": 1444, "verse_number": "३-८२-३२", "content_sanskrit": "नागराजस्य राजेन्द्र कपिलस्य महात्मनः।\nतीर्थं कुरुवरश्रेष्ठ सर्वलोकेषु विश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2021400, "chapter_id": 1444, "verse_number": "३-८२-३३", "content_sanskrit": "तत्राभिषेकं कुर्वीत नागतीर्थे नराधिप।\nकपिलानां सहस्रस्य फलं विन्दति मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2021401, "chapter_id": 1444, "verse_number": "३-८२-३४", "content_sanskrit": "ततो ललितकं गच्छेच्छन्तनोस्तीर्थमुत्तमम्।\nतत्र स्नात्वा नरो राजन्न दुर्गतिमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2021402, "chapter_id": 1444, "verse_number": "३-८२-३५", "content_sanskrit": "गङ्गायमुनयोर्मध्ये स्नाति यः संगमे नरः।\nदशाश्वमेधानाप्नोति कुलं चैव समुद्धरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2021403, "chapter_id": 1444, "verse_number": "३-८२-३६", "content_sanskrit": "ततो गच्छेत राजेन्द्र सुगन्धं लोकविथुतम्।\nसर्वपापविशुद्धात्मा ब्रह्मलोके महीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2021404, "chapter_id": 1444, "verse_number": "३-८२-३७", "content_sanskrit": "रुद्रावर्तं ततो गच्छेत्तीर्थसेवी नराधिप।\nतत्रस्नात्वा नरो राजन्स्वर्गलोके च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2021405, "chapter_id": 1444, "verse_number": "३-८२-३८", "content_sanskrit": "गङ्गायाश्च नरश्रेष्ठ सरस्वत्याश्च संगमे।\nस्नात्वाऽश्वमेधं प्राप्नोति स्वर्गलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2021406, "chapter_id": 1444, "verse_number": "३-८२-३९", "content_sanskrit": "भद्रकर्णएश्वरं गत्वा देवमर्च्य यथाविधि।\nन दुर्गतिमवाप्नोति नाकपृष्ठे च पूज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2021407, "chapter_id": 1444, "verse_number": "३-८२-४०", "content_sanskrit": "तत कुब्जावतीं गच्छेत्तीर्थसेवी नराधिप।\nरगोसहस्रमवाप्नोति स्वर्गलोकं च नच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2021408, "chapter_id": 1444, "verse_number": "३-८२-४१", "content_sanskrit": "अरुन्धतीवटं गच्छेत्तीर्थसेवी नराधिप।\nसामुद्रकमुपस्पृश्य ब्रह्मचारी समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2021409, "chapter_id": 1444, "verse_number": "३-८२-४२", "content_sanskrit": "अश्वमेधमवाप्नोति त्रिरात्रोपोषितो नरः।\nगोसहस्रफलं विद्यात्कुलं चैव समुद्धरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2021410, "chapter_id": 1444, "verse_number": "३-८२-४३", "content_sanskrit": "कब्र्हमावर्तं ततो गच्छेद्ब्रह्मचारी समाहितः।\nअश्वमेधमवाप्नोति सोमलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2021411, "chapter_id": 1444, "verse_number": "३-८२-४४", "content_sanskrit": "यमुनाप्रभवं गत्वा समुपस्पृश्य यामुनम्।\nअश्वमेधफंल लब्ध्वा स्वर्गलोके महीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2021412, "chapter_id": 1444, "verse_number": "३-८२-४५", "content_sanskrit": "दर्वीसंक्रमणं प्राप्य तीर्थं त्रैलोक्यपूजितम्।\nअश्वमेधमवाप्नोति स्वर्गलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2021413, "chapter_id": 1444, "verse_number": "३-८२-४६", "content_sanskrit": "सिन्धोश्च प्रभवं गत्वा सिद्धगन्धर्वसेवितम्।\nतत्रोष्य रजनीः पञ्च विन्देद्बहु सुवर्णकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2021414, "chapter_id": 1444, "verse_number": "३-८२-४७", "content_sanskrit": "अथ वेदीं समासाद्य नरः परमदुर्गमाम्।\nअश्वमेधमवाप्नोति गच्छेदौशनसीं गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2021415, "chapter_id": 1444, "verse_number": "३-८२-४८", "content_sanskrit": "ऋषिकुल्यां समासाद्य वासिष्ठं चैवभारत।\nवासिष्ठीं समतिक्रम्य सर्वे वर्णा द्विजातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2021416, "chapter_id": 1444, "verse_number": "३-८२-४९", "content_sanskrit": "ऋषिकुल्यां समासाद्य नरः स्नात्वा विकल्मषः।\nदेवान्पितॄंश्चार्चयित्वा ऋषिलोकं प्रपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2021417, "chapter_id": 1444, "verse_number": "३-८२-५०", "content_sanskrit": "यदि तत्रवसेन्मासं शाकाहारो नराधिप।\n`द्वादशाहस्य यज्ञस्य फलं स लभते नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2021418, "chapter_id": 1444, "verse_number": "३-८२-५१", "content_sanskrit": "भृगुतुङ्गं समासाद्य वाजिमेधफलं लभेत्।\nगत्वा वीरप्रमोक्षं च सर्वपापैः प्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2021419, "chapter_id": 1444, "verse_number": "३-८२-५२", "content_sanskrit": "कृत्तिकामघयोश्चैव तीर्थमासाद्य भारत।\nअग्निष्टोमातिरात्राभ्यां फलमाप्नोति मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2021420, "chapter_id": 1444, "verse_number": "३-८२-५३", "content_sanskrit": "तत्र संध्यां समासाद्य विद्यातीर्थमनुत्तमम्।\nउपस्पृश्य च वै विद्यां यत्र तत्रोपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2021421, "chapter_id": 1444, "verse_number": "३-८२-५४", "content_sanskrit": "महाश्रमे वसेद्रात्रिं सर्वपापप्रमोचने।\nएककालं निराहारो लोकानावसते शुभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2021422, "chapter_id": 1444, "verse_number": "३-८२-५५", "content_sanskrit": "षष्ठाकालोपवासेन मासमुष्य महालये।\nसर्वपापविशुद्दात्मा विन्देद्बहु सुवर्णकम्।\nदशापरान्दशपूर्वान्नरानुद्धरते कुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2021423, "chapter_id": 1444, "verse_number": "३-८२-५६", "content_sanskrit": "अथ वेतसिकां गत्वा पितामहनिषेविताम्।\nअश्वमेधमवाप्नोति गच्छेदौशनसीं गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2021424, "chapter_id": 1444, "verse_number": "३-८२-५७", "content_sanskrit": "अथ सुन्दरिकातीर्थं प्राप्य सिद्धनिषेवितम्।\nरूपस्य भागी भवति दृष्टमेतत्पुरातनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2021425, "chapter_id": 1444, "verse_number": "३-८२-५८", "content_sanskrit": "ततो वै ब्राह्मणं गत्वा ब्रह्मचारी जितेन्द्रियः।\nपद्मवर्णेन यानेन ब्रह्मलोकं प्रपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2021426, "chapter_id": 1444, "verse_number": "३-८२-५९", "content_sanskrit": "ततस्तु नैमिषं गच्छेत्पुण्यं सिद्धनिषेवितम्।\nतत्र नित्यं निवसति ब्रह्मा देवगणैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2021427, "chapter_id": 1444, "verse_number": "३-८२-६०", "content_sanskrit": "नैमिषं मृगयाणस् पापस्यार्धं प्रणश्यति।\nप्रविष्टमात्रस्तु नरः सर्वपापैः प्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2021428, "chapter_id": 1444, "verse_number": "३-८२-६१", "content_sanskrit": "तत्र मासं वसेद्धीरो नैमिषे तीर्थतत्परः।\nपृथिव्यां यानि तीर्थानि तानि तीर्थानि नैंमिषे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2021429, "chapter_id": 1444, "verse_number": "३-८२-६२", "content_sanskrit": "कृताभिषेकस्तत्रैव नियतो नियताशनः।\nगवां मेधस्य यज्ञस्य फलं प्राप्नोति भारत।\nपुनात्यासप्तमं चैव कुलं भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2021430, "chapter_id": 1444, "verse_number": "३-८२-६३", "content_sanskrit": "यस्त्यजेन्नैमिषे प्राणानुपवासपरायणः।\nस मोदेत्सर्वलोकेषु एवमाहुर्मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2021431, "chapter_id": 1444, "verse_number": "३-८२-६४", "content_sanskrit": "नित्यं मेध्यं च पुण्यं च नैमिषं नृपसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2021432, "chapter_id": 1444, "verse_number": "३-८२-६५", "content_sanskrit": "गङ्गोद्भेदं समासाद्य त्रिरात्रोपोषितो नरः।\nवाजपेयमवाप्नोति ब्रह्मभूतो भवेत्सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2021433, "chapter_id": 1444, "verse_number": "३-८२-६६", "content_sanskrit": "सरस्वतीं समासाद्य तर्पयेत्पितृदेवताः।\nसारस्वतेषु लोकेषु मोदते नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2021434, "chapter_id": 1444, "verse_number": "३-८२-६७", "content_sanskrit": "ततश्च बाहुदां गच्छेद्ब्रह्मचारी समाहितः।\nतत्रोष्य रजनीमेकां स्वर्गलोके महीयते।\nदेवसत्रस्य यज्ञस्य फलंप्राप्नोति कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2021435, "chapter_id": 1444, "verse_number": "३-८२-६८", "content_sanskrit": "ततः क्षीरवतीं गच्छेत्पुण्यां पुण्यतरैर्वृताम्।\nपितृदेवार्चनपरो वाजपेयमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2021436, "chapter_id": 1444, "verse_number": "३-८२-६९", "content_sanskrit": "विमलाशोकमासाद्य ब्र्हमचारी समाहितः।\nतत्रोष्य रजनीमेकां स्वर्गलोके महीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2021437, "chapter_id": 1444, "verse_number": "३-८२-७०", "content_sanskrit": "गोप्रतारं ततो गच्छेत्सरय्वास्तीर्थमुत्तमम्।\nयत्र रामो गतः स्वर्गं सभृत्यबलवाहनः।\nदेहं त्यक्त्वा महाराज तस्य तीर्थस्य तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2021438, "chapter_id": 1444, "verse_number": "३-८२-७१", "content_sanskrit": "रामस्य च प्रसादेन व्यवसायाच्च भारत।\nतस्मिंस्तीर्थे नरः स्नात्वा गोप्रतारे नराधिप।\nसर्वपापविशुद्धात्मा स्वर्गलोके महीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2021439, "chapter_id": 1444, "verse_number": "३-८२-७२", "content_sanskrit": "रामतीर्थे नरः स्नात्वा गोमत्यां कुरुनन्दन।\nअश्वमेधमवाप्नोति पुनाति च कुलं नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2021440, "chapter_id": 1444, "verse_number": "३-८२-७३", "content_sanskrit": "शतसाहस्रकं तीर्थं तत्रैव भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2021441, "chapter_id": 1444, "verse_number": "३-८२-७४", "content_sanskrit": "तत्रोपस्पर्शनं कृत्वा नियतो नियताशनः।\nगोसहस्रफलं पुण्यं प्राप्नोति भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2021442, "chapter_id": 1444, "verse_number": "३-८२-७५", "content_sanskrit": "रततो गच्छेत राजेनद्र भर्तृस्थानमनुत्तमम्।\nअश्वमेधस्य यज्ञस्य फलं प्राप्नोति मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2021443, "chapter_id": 1444, "verse_number": "३-८२-७६", "content_sanskrit": "कोटितीर्थे नरः स्नात्वा अर्चयित्वा गुहं नृप।\nगोसहस्रफंल विद्यात्तेजस्वी च भवेन्नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2021444, "chapter_id": 1444, "verse_number": "३-८२-७७", "content_sanskrit": "ततो वाराणसीं गत्वा अर्चयित्वा नृषध्वजम्।\nकपिलाह्रदे नरः स्नात्वाराजसूयमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2021445, "chapter_id": 1444, "verse_number": "३-८२-७८", "content_sanskrit": "अविमुक्तं समासाद्य तीर्थसेवी कुरूद्वह।\nदर्शनाद्देवदेवस्य मुच्यते ब्रह्महत्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2021446, "chapter_id": 1444, "verse_number": "३-८२-७९", "content_sanskrit": "प्राणानुत्सृज्यतत्रैव मोक्षं प्राप्नोति मानवः।\nमार्कण्डेयस्य राजेन्द्र तीर्थमासाद्य दुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2021447, "chapter_id": 1444, "verse_number": "३-८२-८०", "content_sanskrit": "गोमतीगङ्गयोश्चैव संगमे लोकविश्रुते।\nअग्निष्टोममवाप्नोति कुलं चैव समुद्धरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2021448, "chapter_id": 1444, "verse_number": "३-८२-८१", "content_sanskrit": "ततो गयां समासाद्य ब्रह्मचारी समाहितः।\nअश्वमेधमवाप्नोति कुलं चैव समुद्धरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2021449, "chapter_id": 1444, "verse_number": "३-८२-८२", "content_sanskrit": "तत्राक्षयवटो नाम त्रिषु लोकेषु विश्रुतः।\nतत्र दत्तं पितृभ्यस्तु भवत्यक्षयमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2021450, "chapter_id": 1444, "verse_number": "३-८२-८३", "content_sanskrit": "महानद्यामुपस्पृश्य तर्पयेत्पितृदेवताः।\nअक्षयान्प्राप्नुयाल्लोकान्कुलं चैव समुद्धरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2021451, "chapter_id": 1444, "verse_number": "३-८२-८४", "content_sanskrit": "ततो ब्रह्मसरो गत्वा धर्मारण्योपशोभितम्।\nब्रह्मलोकमवाप्नोति प्रभातामेव शर्वरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2021452, "chapter_id": 1444, "verse_number": "३-८२-८५", "content_sanskrit": "ब्रह्मणा तत्र सरसि यूपश्रेष्ठः समुच्छ्रितः।\nयूपं प्रदक्षिणीकृत्य वाजपेयफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2021453, "chapter_id": 1444, "verse_number": "३-८२-८६", "content_sanskrit": "ततो गच्छेत राजेन्द्र धेनुकं लोकविश्रुतम्।\nएकरात्रोषितो राजन्प्रयच्छेत्तिलधेनुकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2021454, "chapter_id": 1444, "verse_number": "३-८२-८७", "content_sanskrit": "सर्वपापविशुद्धात्मा सोमलोकं ब्रजेद्भुवम्।\nतत्र चिह्निं महद्राजन्नद्यापि सुमहद्भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2021455, "chapter_id": 1444, "verse_number": "३-८२-८८", "content_sanskrit": "कपिलायाः सवत्सायाश्चरन्त्याः पर्वते कृतम्।\nसवत्सायाः पदानि स्म दृश्यन्तेऽद्यापि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2021456, "chapter_id": 1444, "verse_number": "३-८२-८९", "content_sanskrit": "तेषूपस्पृश्य राजेन्द्रपदेषु नृपसत्तम।\nयत्कंचिदशुभं कर्म तत्प्रणश्यति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2021457, "chapter_id": 1444, "verse_number": "३-८२-९०", "content_sanskrit": "ततो गृध्रवटं गच्छेत्स्थानं देवस्य धीमतः।\nस्नायीत भस्मना तत्र अभिगम्य वृषध्वजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2021458, "chapter_id": 1444, "verse_number": "३-८२-९१", "content_sanskrit": "ब्राह्मणेन भवेच्चीर्णं व्रतं द्वादशवार्षिकम्।\nइतरेषां तु वर्णानां सर्वपापं प्रणश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2021459, "chapter_id": 1444, "verse_number": "३-८२-९२", "content_sanskrit": "उद्यन्तं च ततो गच्छेत्पर्वतं गीतनादितम्।\nसावित्र्यास्तु पदं तत्र दृश्यते भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2021460, "chapter_id": 1444, "verse_number": "३-८२-९३", "content_sanskrit": "तत्रसंध्यामुपासीत ब्राह्मणः संशितव्रतः।\nउपासिता भवेत्संध्या तेन द्वादशवार्षिकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2021461, "chapter_id": 1444, "verse_number": "३-८२-९४", "content_sanskrit": "योनिद्वारं च तत्रैव विश्रुतं भरतर्षभ।\nतत्राभिगम्य मुच्येत पुरुषो योनिसंकरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2021462, "chapter_id": 1444, "verse_number": "३-८२-९५", "content_sanskrit": "कृष्णशुक्लावुभौ पक्षौ गयायां यो वसेन्नरः।\nपुनात्यासप्तमं राजन्कुलं नास्त्यत्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2021463, "chapter_id": 1444, "verse_number": "३-८२-९६", "content_sanskrit": "एष्टव्या बहवः पुत्रा यद्येकोपि गयां व्रजेत्।\nगौरीं वा वरयेत्कन्यां नीलं वा वृषमुत्सृजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2021464, "chapter_id": 1444, "verse_number": "३-८२-९७", "content_sanskrit": "ततः फल्गुं व्रजेद्राजंस्तीर्थसेवी नराधिप।\nअश्वमेधमवाप्नोति सिद्धिं च महतीं व्रजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2021465, "chapter_id": 1444, "verse_number": "३-८२-९८", "content_sanskrit": "ततो गच्छेत राजेन्द्र धर्मप्रस्थं समाहितः।\nतत्र धर्मो महाराज नित्यमास्ते युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2021466, "chapter_id": 1444, "verse_number": "३-८२-९९", "content_sanskrit": "तत्र कूपोदकं कृत्वा तेन स्नातः शुचिस्तथा।\nपितॄन्देवांस्तु संतर्प्य मुक्तपापो दिवं व्रजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2021467, "chapter_id": 1444, "verse_number": "३-८२-१००", "content_sanskrit": "मतङ्गस्याश्रमस्तत्रमहर्षेर्भावितात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2021468, "chapter_id": 1444, "verse_number": "३-८२-१०१", "content_sanskrit": "तं प्रविश्याश्रमं श्रीमच्छ्रमशोकविनाशनम्।\nगवामयनयज्ञस्य फलंप्राप्नोति मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2021469, "chapter_id": 1444, "verse_number": "३-८२-१०२", "content_sanskrit": "धर्मं तत्राभिसंस्पृश्य वाजिमेधमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2021470, "chapter_id": 1444, "verse_number": "३-८२-१०३", "content_sanskrit": "ततो गच्छेत राजेन्द्र ब्रह्मस्थानमनुत्तमम्।\nतत्राभिगम्य राजेन्द्र ब्रह्माणं पुरुषर्षभ।\nराजसूयाश्वमेधाभ्यां फलं विन्दति मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2021471, "chapter_id": 1444, "verse_number": "३-८२-१०४", "content_sanskrit": "ततो राजगृहं गच्छेत्तीर्थसेवी नराधिप।\nउपस्पृश्य ततस्तत्रकक्षीवानिव मोदते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2021472, "chapter_id": 1444, "verse_number": "३-८२-१०५", "content_sanskrit": "यक्षिण्या नैत्यकं तत्र प्राश्नीन पुरुषः शुचिः।\nयक्षिण्यास्तु प्रसादेन मुच्यते ब्र्हमहत्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2021473, "chapter_id": 1444, "verse_number": "३-८२-१०६", "content_sanskrit": "मणइनागं ततो गत्वा गोसहस्रफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2021474, "chapter_id": 1444, "verse_number": "३-८२-१०७", "content_sanskrit": "तैर्थिकं भुञ्जते यस्तु मणिनागस् भारत।\nदष्टस्याशीविषेणापि न तस्य क्रमते विपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2021475, "chapter_id": 1444, "verse_number": "३-८२-१०८", "content_sanskrit": "तत्रोष् रजनीभेकां गोसहस्रफंल लभेत्।\nततो गच्छेत ब्रह्मर्पेर्गौतमस्य वनं प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2021476, "chapter_id": 1444, "verse_number": "३-८२-१०९", "content_sanskrit": "अहल्याया ह्रदे स्नात्वा व्रजेत परमां गतिम्।\nअभिगम्याश्रमं राजन्विनद्ते श्रियमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2021477, "chapter_id": 1444, "verse_number": "३-८२-११०", "content_sanskrit": "तत्रोदपानं धर्मज्ञ त्रिपु लोकेषु विश्रुतम्।\nतत्राभिषेकं कृत्वा तु वाजिमेधमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2021478, "chapter_id": 1444, "verse_number": "३-८२-१११", "content_sanskrit": "जनकस् तु राजर्षेः कूपस्त्रिदशपूजितः।\nतत्राभिषेकं कृत्वा तु विष्णुलोकमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2021479, "chapter_id": 1444, "verse_number": "३-८२-११२", "content_sanskrit": "ततो विनशनं गच्छेत्सर्वपापप्रमोचनम्।\nवाजपेयमवाप्नोति सोमलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2021480, "chapter_id": 1444, "verse_number": "३-८२-११३", "content_sanskrit": "गण्डकीं तु समासाद्य सर्वतीर्थजलोद्भवाम्।\nवाजपेयमवाप्नोति सूर्यलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2021481, "chapter_id": 1444, "verse_number": "३-८२-११४", "content_sanskrit": "कततो विशल्यामासाद्य नदीं त्रैलोक्यविश्रुताम्।\nअग्निष्टोममवाप्नोति स्वर्गलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2021482, "chapter_id": 1444, "verse_number": "३-८२-११५", "content_sanskrit": "ततोऽधिवङ्गं धर्मज्ञ समाविश्य ततो वनम्।\nगुह्यकेषु महाराज मोदते नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2021483, "chapter_id": 1444, "verse_number": "३-८२-११६", "content_sanskrit": "कम्पनां तु समासद्य नदीं सिद्धनिवेषिताम्।\nपुण्डरीकमवाप्नोति स्वर्गलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2021484, "chapter_id": 1444, "verse_number": "३-८२-११७", "content_sanskrit": "अथ माहेश्वरीं धारां समासाद्य धराधिप।\nअश्वमेधमवाप्नोति कुलं चैव समुद्धरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2021485, "chapter_id": 1444, "verse_number": "३-८२-११८", "content_sanskrit": "दिवौकसां पुष्करिणीं समासाद्य नराधिप।\nन दुर्गतिमवाप्नोति वाजिमेधं च विन्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2021486, "chapter_id": 1444, "verse_number": "३-८२-११९", "content_sanskrit": "अथ सोमपदं गच्छेद्ब्रह्मचारी समाहितः।\nमाहेश्वरपदे स्नात्वा वाजिमेधफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2021487, "chapter_id": 1444, "verse_number": "३-८२-१२०", "content_sanskrit": "तत्रकोटी तु तीर्थानां विश्रुता भरतर्षभ।\nकूर्मरूपेण राजेन्द्र ह्यसुरेण दुरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2021488, "chapter_id": 1444, "verse_number": "३-८२-१२१", "content_sanskrit": "ह्रियमाणा हृता राजन्विष्णुना प्रभविष्णुना।\nतत्राभिषेकं कुर्वीत तीर्थकोट्यां युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2021489, "chapter_id": 1444, "verse_number": "३-८२-१२२", "content_sanskrit": "पुण्डरीकमवाप्नोति विष्णुलोकं च गच्छति।\nततो गच्छेत राजेन्द्रस्थानं नारायणस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2021490, "chapter_id": 1444, "verse_number": "३-८२-१२३", "content_sanskrit": "सदा सन्निहितो यत्रविष्णुर्वसति भारत।\nयत्रब्रह्मादयो देवा ऋषयश्च तपोधनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2021491, "chapter_id": 1444, "verse_number": "३-८२-१२४", "content_sanskrit": "आदित्या वसवो रुद्रा जनार्दनमुपासते।\nशालग्राम इति ख्यातो विष्णुरद्भुतकर्मकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2021492, "chapter_id": 1444, "verse_number": "३-८२-१२५", "content_sanskrit": "अभिगम्य त्रिलोकेशं वरदं विष्णुमव्ययम्।\nअश्वमेधमवाप्नोति विष्णुलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2021493, "chapter_id": 1444, "verse_number": "३-८२-१२६", "content_sanskrit": "तत्रोपदानं धर्मज्ञ सर्वपापप्रमोचनम्।\nसमुद्रास्तत्रचत्वारः कूपे संनिहिताः सदा।\nतत्रोपस्पृश् राजेन्द्र न दुर्गतिमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2021494, "chapter_id": 1444, "verse_number": "३-८२-१२७", "content_sanskrit": "अभिगम्य त्रिलोकेशं वरदं विष्णुमव्ययम्।\nविराजति यथासोमो मेघैर्मुक्तो नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2021495, "chapter_id": 1444, "verse_number": "३-८२-१२८", "content_sanskrit": "जातिस्मरमुपस्पृश्य शुचिः प्रयतमानसः।\nजातिस्मरत्वमाप्नोति स्नात्वा तत्र न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2021496, "chapter_id": 1444, "verse_number": "३-८२-१२९", "content_sanskrit": "वदेश्वरपुरं गत्वा अर्चयित्वा तु केशवम्।\nईप्सिताँल्लभते कामानुपवासान्न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2021497, "chapter_id": 1444, "verse_number": "३-८२-१३०", "content_sanskrit": "ततस्तु वामनं गत्वा सर्वपापप्रमोचनम्।\nअभिगम्य हरिं देवं न दुर्गतिमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2021498, "chapter_id": 1444, "verse_number": "३-८२-१३१", "content_sanskrit": "भरतस्याश्रमं गच्छेत्सर्वपापप्रमोचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2021499, "chapter_id": 1444, "verse_number": "३-८२-१३२", "content_sanskrit": "कौशिकीं तत्र गच्छेत महापापप्रणाशिनीम्।\nराजसूयस्य यज्ञस्य फलं प्राप्नोति मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2021500, "chapter_id": 1444, "verse_number": "३-८२-१३३", "content_sanskrit": "ततो गच्छेत राजेन्द्र चम्पकारण्यमुत्तमम्।\nतत्रोष्य रजनीमेकां गोसहस्रफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2021501, "chapter_id": 1444, "verse_number": "३-८२-१३४", "content_sanskrit": "अथ जेष्ठिलमासाद्य तीर्धं परमदुर्लभम्।\nतत्रोष्य रजनीमेकां गोसहस्रफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2021502, "chapter_id": 1444, "verse_number": "३-८२-१३५", "content_sanskrit": "तत्र विश्वेश्वरं दृष्ट्वा देव्या सह महाद्युतिम्।\nमित्रावरुणयोर्लोकानाप्नोति पुरुषर्षभ।\nत्रिरात्रोपोषितस्तत्रअग्निष्टोमफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2021503, "chapter_id": 1444, "verse_number": "३-८२-१३६", "content_sanskrit": "कन्यासंवेद्यमासाद्य नियतो नयिताशनः।\nमनोः प्रजापतेर्लोकानाप्नोति पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2021504, "chapter_id": 1444, "verse_number": "३-८२-१३७", "content_sanskrit": "कन्यायां ये प्रयच्छन्ति दानमण्वपि भारत।\nतदक्षय्यमिति प्राहुर्ऋषयः संशितव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2021505, "chapter_id": 1444, "verse_number": "३-८२-१३८", "content_sanskrit": "ततो निर्वीरमासाद्य त्रिपु लोकेपु विश्रुतम्।\nअश्वमेधमवाप्नोति विष्णुलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2021506, "chapter_id": 1444, "verse_number": "३-८२-१३९", "content_sanskrit": "ये त्विन्धनं प्रयच्छन्ति निर्वीरासंगमे नराः।\nते यान्ति नरशार्दूल शक्रलोकमनामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2021507, "chapter_id": 1444, "verse_number": "३-८२-१४०", "content_sanskrit": "तत्राश्रमो वसिष्ठस् त्रिषु लोकेषु विश्रुतः।\nतत्राभिषेकं कुर्वाणो वाजपेयमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2021508, "chapter_id": 1444, "verse_number": "३-८२-१४१", "content_sanskrit": "देवकूटं समासाद्य ब्रह्मर्षिगणसेवितम्।\nअश्वमेधमवाप्नोति कुलं चैव समुद्धरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2021509, "chapter_id": 1444, "verse_number": "३-८२-१४२", "content_sanskrit": "ततो गच्छेत राजेन्द्र कौशिकस्य मुनेर्ह्रदम्।\nयत्र सिद्धिं परां प्राप्तो विश्वामित्रोथ कौशिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2021510, "chapter_id": 1444, "verse_number": "३-८२-१४३", "content_sanskrit": "तत्र मासं वसेद्वीर कौशिक्यां भरतर्षभ।\nअश्वमेधस्य यत्पुण्यं तन्मासेनाधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2021511, "chapter_id": 1444, "verse_number": "३-८२-१४४", "content_sanskrit": "सर्वतीर्थवरे चैव यो वसेत महाह्रदे।\nन दुर्गतिमवाप्नोति विन्द्याद्बहु सुवर्णकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2021512, "chapter_id": 1444, "verse_number": "३-८२-१४५", "content_sanskrit": "कुमारमभिगम्याथ वीराश्रमनिवासिनम्।\nअश्वमेधमवाप्नोति नरो नास्त्यत्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2021513, "chapter_id": 1444, "verse_number": "३-८२-१४६", "content_sanskrit": "अग्निधारां समासाद्य त्रिषु लोकेषु विश्रुताम्।\nतत्राभिषेकं कुर्वाणो ह्यग्निष्टोममवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 2021514, "chapter_id": 1444, "verse_number": "३-८२-१४७", "content_sanskrit": "अभिगम्य महादेवं वरदं विष्णुमव्ययम्।\nपितामहसरो गत्वा शैलराजसमीपतः।\nतत्राभिषेकं कुर्वाणो ह्यग्निष्टोममवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 2021515, "chapter_id": 1444, "verse_number": "३-८२-१४८", "content_sanskrit": "पितामहस्य सरसः प्रस्रुता लोकपावनी।\nकुमारधारा तत्रैव त्रिषु लोकेषु विश्रुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 2021516, "chapter_id": 1444, "verse_number": "३-८२-१४९", "content_sanskrit": "यत्रस्नात्वा कृतार्थोस्मीत्यात्मानमवगच्छति।\nषष्ठकालोपवासेन मुच्यते ब्रह्महत्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 2021517, "chapter_id": 1444, "verse_number": "३-८२-१५०", "content_sanskrit": "ततो गच्छेत धर्मज्ञ तीर्थसेवनतत्परः।\nशिखरं वै महादेव्या गौर्यास्त्रैलोक्यविश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 2021518, "chapter_id": 1444, "verse_number": "३-८२-१५१", "content_sanskrit": "समारुह्य नरश्रेष्ठ स्तनकुण्डेषु संविशेत्।\nस्तनकुण्डमुपस्पृश्य वाजपेयफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 2021519, "chapter_id": 1444, "verse_number": "३-८२-१५२", "content_sanskrit": "तत्राभिषेकं कुर्वाणः पितृदेवार्चने रतः।\nहयमेधमवाप्नोति शक्रलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 2021520, "chapter_id": 1444, "verse_number": "३-८२-१५३", "content_sanskrit": "ताम्रारुणं समासाद्य ब्रह्मचारी समाहितः।\nअश्वमेमवाप्नोति ब्रह्मलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 2021521, "chapter_id": 1444, "verse_number": "३-८२-१५४", "content_sanskrit": "नन्दिन्यां च समासाद्य कूपं देवनिषेवितम्।\nनरमेधस् यत्पुण्यं तदाप्तोति नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 2021522, "chapter_id": 1444, "verse_number": "३-८२-१५५", "content_sanskrit": "कालिकासंगमे स्नात्वा कौशिक्यरुणयोर्गतः।\nत्रिरात्रोपोषितो राजन्सर्वपापैः प्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 2021523, "chapter_id": 1444, "verse_number": "३-८२-१५६", "content_sanskrit": "उर्वशीतीर्थमासाद्य ततः सोमाश्रमं बुधः।\nकुम्भकर्णाश्रमं गत्वा पूज्यते भुविमानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 2021524, "chapter_id": 1444, "verse_number": "३-८२-१५७", "content_sanskrit": "कोकामुखमुपस्पृश् ब्रह्मचारी यतव्रतः।\nजातिस्मरत्वमाप्नोति दृष्टमेतत्पुरातनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 2021525, "chapter_id": 1444, "verse_number": "३-८२-१५८", "content_sanskrit": "प्राङ्गदीं च समासाद्य कृतात्मा भवति द्विजः।\nसर्वपापविशुद्धात्मा शक्रलोकं च गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 2021526, "chapter_id": 1444, "verse_number": "३-८२-१५९", "content_sanskrit": "ऋषभद्वीपमासाद्य मेध्यं क्रौञ्चनिषूदनम्।\nसरस्वत्यामुपस्पृश्य विमानस्थो विराजते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}, {"id": 2021527, "chapter_id": 1444, "verse_number": "३-८२-१६०", "content_sanskrit": "औद्दालकं महाराज तीर्थं मुनिनिषेवितम्।\nतत्राभिषेकं कृत्वा वै सर्वपापैः प्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 161}, {"id": 2021528, "chapter_id": 1444, "verse_number": "३-८२-१६१", "content_sanskrit": "धर्मतीर्थं समासाद्य पुण्यं ब्रह्मर्षिसेवितम्।\nवाजपेयमवाप्नोति विमानस्थश्च पूज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 162}, {"id": 2021529, "chapter_id": 1444, "verse_number": "३-८२-१६२", "content_sanskrit": "अथ पम्पां समासाद्य भागीरथ्यां कृतोदकः।\nदण्डार्तमभिगत्वा तु गोसहस्रफलं लभेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 163}, {"id": 2021530, "chapter_id": 1444, "verse_number": "३-८२-१६३", "content_sanskrit": "`ततो लेवलिकां गच्छेत्पुण्यां पुण्योपसेविताम्।\nवाजपेयमवाप्नोति विमानस्थश्च पूज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 164}, {"id": 2021531, "chapter_id": 1444, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि द्व्यशीतितमोऽध्यायः ॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 165}]