[{"id": 2174691, "chapter_id": 4707, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2174692, "chapter_id": 4707, "verse_number": "१", "content_sanskrit": "तस्मिन् युद्धे महाराज सम्प्रवृत्ते भयानके ।\nउपाविष्टेषु सर्वेषु पाण्डवेषु महात्मसु\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2174693, "chapter_id": 4707, "verse_number": "२", "content_sanskrit": "ततस्ताळध्वजो रामस्तयोर्युद्ध उपस्थिते ।\nश्रुत्वा तच्छिष्ययोर्युद्धमाजगाम महाबलः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2174694, "chapter_id": 4707, "verse_number": "३", "content_sanskrit": "तं दृष्ट्वा परमप्रीताः पूजयित्वा महाबलाः ।\nशिष्ययोः कौशलं युद्धे पश्य रामेति चाब्रुवन्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2174695, "chapter_id": 4707, "verse_number": "४", "content_sanskrit": "अब्रवीच्च तदा रामो दृष्ट्वा कृष्णं च पाण्डवम् ।\nदुर्योधनं च कौरव्यं गदापाणिमवस्थितम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2174696, "chapter_id": 4707, "verse_number": "", "content_sanskrit": "बलरामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2174697, "chapter_id": 4707, "verse_number": "५", "content_sanskrit": "चत्वारिंशद् दिनान्यद्य द्वे चान्ये निःसृतस्य मे ।\nपुष्येण सम्प्रयातोऽस्मि श्रवणे पुनरागतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2174698, "chapter_id": 4707, "verse_number": "६", "content_sanskrit": "शिष्ययोर्वै गदायुद्धं द्रष्टुकामोऽस्मि माधव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2174699, "chapter_id": 4707, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2174700, "chapter_id": 4707, "verse_number": "७", "content_sanskrit": "ततस्तदा गदाहस्तौ दुर्योधनवृकोदरौ ।\nयुद्धभूमिगता वीरावुभावेव विराजतुः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2174701, "chapter_id": 4707, "verse_number": "८", "content_sanskrit": "ततो युधिष्ठिरो राजा परिष्वज्य हलायुधम् ।\nस्वागतं कुशलं चास्मै पर्यपृच्छद्यथातथम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2174702, "chapter_id": 4707, "verse_number": "९", "content_sanskrit": "कृष्णौ चापि महेष्वासावभिवाद्य हलायुधम् ।\nसस्वजाते परं प्रीत्या प्रीयमाणौ यशस्विनौ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2174703, "chapter_id": 4707, "verse_number": "१०", "content_sanskrit": "माद्रीपुत्रौ तथा शूरौ द्रौपद्याः पञ्च चात्मजाः ।\nअभिवाद्य स्थिता राजन् रौहिणेयं महाबलम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2174704, "chapter_id": 4707, "verse_number": "११", "content_sanskrit": "भीमसेनोऽपि बलवान् पुत्रश्च तव भारत ।\nतौ तथैवोद्यतगदौ पूजयेतां हलायुधम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2174705, "chapter_id": 4707, "verse_number": "१२", "content_sanskrit": "स्वागतेन च ते तत्र प्रतिपूज्य पुनः पुनः ।\nपश्य युद्धं महाबाह्वोरिति ते राममब्रुवन्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2174706, "chapter_id": 4707, "verse_number": "१३", "content_sanskrit": "एवमूचुर्महात्मानं रौहिणेयं नराधिप\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2174707, "chapter_id": 4707, "verse_number": "१४", "content_sanskrit": "परिष्वज्य तदा रामः पाण्डवान् सृञ्जयानपि ।\nअपृच्छत् कुशलं सर्वान् पाण्डवांश्चामितौजसः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2174708, "chapter_id": 4707, "verse_number": "१५", "content_sanskrit": "तथैव ते समासाद्य पप्रच्छुस्तमनामयम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2174709, "chapter_id": 4707, "verse_number": "१६", "content_sanskrit": "तान् प्रत्यर्च्य हली सर्वान् क्षत्रियांश्चामितौजसः ।\nकृत्वा कुशलसम्प्रश्नं संविदं च यथावयः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2174710, "chapter_id": 4707, "verse_number": "१७", "content_sanskrit": "जनार्दनं सात्यकिं च प्रेम्णा सम्परिषस्वजे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2174711, "chapter_id": 4707, "verse_number": "१८", "content_sanskrit": "मूर्ध्नि चैतावुपाघ्राय कुशलं पर्यपृच्छत\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2174712, "chapter_id": 4707, "verse_number": "१९", "content_sanskrit": "तौ चैनं विधिवद् राजन् पूजयामासतुर्गुरुम् ।\nब्रह्माणमिव देवेशमिन्द्रोपेन्द्रौ मुदा युतौ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2174713, "chapter_id": 4707, "verse_number": "२०", "content_sanskrit": "ततोऽब्रवीद् धर्मसुतो रौहिणेयमरिन्दमम् ।\nइदं भ्रात्रोर्महायुद्धं पश्य रामेति भारत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2174714, "chapter_id": 4707, "verse_number": "२१", "content_sanskrit": "तेषां मध्ये महाबाहुः श्रीमान् केशवपूर्वजः ।\nन्यविशत् परमप्रीतः प्रीयमाणो महारथैः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2174715, "chapter_id": 4707, "verse_number": "२२", "content_sanskrit": "स बभौ राजमध्यस्थो नीलावासाः सितप्रभः ।\nदिवीव नक्षत्रगणैः परिकीर्णो निशाकरः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2174716, "chapter_id": 4707, "verse_number": "२३", "content_sanskrit": "ततस्तयोः सन्निपातस्तुमुलो रोमहर्षणः ।\nआसीदन्तकरो राजन् वैरस्यान्तं विधित्सतोः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2174717, "chapter_id": 4707, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]