[{"id": 6000215000, "chapter_id": 10215, "verse_number": null, "content_sanskrit": "अथ एकोनविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "वेणुगीतम्", "range": null}]}, {"id": 6000215001, "chapter_id": 10215, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.001.m4a", "display_order": 2}, {"id": 6000215002, "chapter_id": 10215, "verse_number": "१०-१९-१", "content_sanskrit": "इत्थं शरत्स्वच्छजलं पद्माकरसुगन्धिना।\nन्यविशद् वायुनावीतं सगोगोपालकोऽच्युतः॥ १०/१९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णस्य वेणुगानमाकर्ण्य गोपीभिस्तद्गुणवर्णनम्", "range": "१–२१"}]}, {"id": 6000215003, "chapter_id": 10215, "verse_number": "१०-१९-२", "content_sanskrit": "कुसुमितवनराजि शुष्मिभृङ्गद्विजकुलघुष्टसरस्सरिन्महीध्रम्।\nमधुपतिरवगाह्य चारयन् गाः सहपशुपालबलश्चुकूज वेणुम्॥ १०/१९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.003.m4a", "display_order": 4}, {"id": 6000215004, "chapter_id": 10215, "verse_number": "१०-१९-३", "content_sanskrit": "तद् व्रजस्‍त्रिय आश्रुत्य वेणुगीतं महोदयम्।\nकाश्चित् परोक्षं कृष्णस्य स्वसखीभ्योऽन्ववेदयन्॥ १०/१९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.004.m4a", "display_order": 5}, {"id": 6000215005, "chapter_id": 10215, "verse_number": "१०-१९-४", "content_sanskrit": "तद् वर्णयितुमारब्धाः स्मरन्त्यः कृष्णचेष्टितम्।\nनाशकन् स्मरवेगेन विक्षिप्तमनसो नृप॥ १०/१९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.005.m4a", "display_order": 6}, {"id": 6000215006, "chapter_id": 10215, "verse_number": "१०-१९-५", "content_sanskrit": "बर्हापीडं नटवरवपुः कर्णयोः कर्णिकारं बिभ्रद्वासः कनककपिशं वैजयन्तीं च मालाम्।\nरन्ध्रान् वेणोरधरसुधया पूरयन् गोपवृन्दैः वृन्दारण्यं स्वपदरमणं प्राविशद् गीतकीर्तिः॥ १०/१९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.006.m4a", "display_order": 7}, {"id": 6000215007, "chapter_id": 10215, "verse_number": "१०-१९-६", "content_sanskrit": "बर्हापिच्छो वनचरवपुः कर्णयोः कर्णिकारः सव्ये बाहौ निहितवदनः सज्जमन्यत्र हस्ते।\nभ्रूविन्यासाङ्गुलिभि रणयन् गापयन् गोपवृन्दान् भूतग्रामं तर्हि रमयन् ब्रह्म गान्धर्वमेव॥ १०/१९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.007.m4a", "display_order": 8}, {"id": 6000215008, "chapter_id": 10215, "verse_number": "१०-१९-७", "content_sanskrit": "इति वेणुरवं राजन् सर्वभूतमनोहरम्।\nश्रुत्वा व्रजस्‍त्रियः सर्वा वर्णयन्त्योऽभिरेभिरे॥ १०/१९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.008.m4a", "display_order": 9}, {"id": 6000215009, "chapter_id": 10215, "verse_number": null, "content_sanskrit": "गोप्य ऊचुः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.009.m4a", "display_order": 10}, {"id": 6000215010, "chapter_id": 10215, "verse_number": "१०-१९-८", "content_sanskrit": "अक्षण्वतां फलमिदं न परं विदामः सख्यः पशूनभिनिवेशयतोर्वयस्यैः।\nवक्त्रं व्रजेशसुतयोरनुवेणुजुष्टं यैर्यैर्निपीतमनुरक्तकटाक्षमोक्षम्॥ १०/१९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.010.m4a", "display_order": 11}, {"id": 6000215011, "chapter_id": 10215, "verse_number": "१०-१९-९", "content_sanskrit": "चूतप्रवालबर्हस्तबकोत्पलाब्जमालानुरक्तपरिधानविचित्रवेषौ।\nमध्ये विरेजतुरलं पशुपालगोष्ठ्यां रङ्गे यथा नटवरौ क्‍वच गायमानौ॥ १०/१९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.011.m4a", "display_order": 12}, {"id": 6000215012, "chapter_id": 10215, "verse_number": "१०-१९-१०", "content_sanskrit": "गोप्यः किमाचरदयं कुशलं स्म वेणुः दामोदराधरसुधासरसाग्य्रगेयम्।\nभुङ्क्ते स्वयं यदवशिष्टरसौघमार्गे हृष्टत्वचोऽश्रु मुमुचुस्तरवः सदर्भाः॥ १०/१९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.012.m4a", "display_order": 13}, {"id": 6000215013, "chapter_id": 10215, "verse_number": "१०-१९-११", "content_sanskrit": "वृन्दावनं सखि भुवो वितनोति कीर्तिं यद् देवकीसुतपदाम्बुजलब्धलक्ष्मि।\nगोविन्दवेणुमनुमत्तमयूरनृत्यं प्रेक्ष्यादृतानुचरितान्यसमस्तसत्त्वम्॥ १०/१९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.013.m4a", "display_order": 14}, {"id": 6000215014, "chapter_id": 10215, "verse_number": "१०-१९-१२", "content_sanskrit": "धन्याः सुमूढमतयोऽपि हरिण्य एतायन्नन्दनन्दनमुपात्तविचित्रवेषम्।\nआपीय वेणुरचितं च सकृष्णसाराः पूजां दधुर्विरचितां प्रणयावलोकैः॥ १०/१९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.014.m4a", "display_order": 15}, {"id": 6000215015, "chapter_id": 10215, "verse_number": "१०-१९-१३", "content_sanskrit": "कृष्णं निरीक्ष्य वनितोत्सवरूपसारं श्रुत्वा च तत्क्‍वणितवेणुविचित्रगीतम्।\nदेव्यो विमानगतयः स्मरनुन्नसारा भ्रश्यत्प्रसूनकबरा मुमुहुर्विनीव्यः॥ १०/१९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.015.m4a", "display_order": 16}, {"id": 6000215016, "chapter_id": 10215, "verse_number": "१०-१९-१४", "content_sanskrit": "गावश्च कृष्णमुखनिर्गतवेणुगीतपीयूषमुत्तभितकर्णपुटैः पिबन्त्यः।\nसानन्दनम्रतनवः कवलाः स्म तस्थुर्गोविन्दमात्मनि दृशाऽश्रुकणान् स्रवन्त्यः॥ १०/१९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.016.m4a", "display_order": 17}, {"id": 6000215017, "chapter_id": 10215, "verse_number": "१०-१९-१५", "content_sanskrit": "प्रायो बताम्ब मुनयो विहगा वनेऽस्मिन् कृष्णेक्षणास्तदुदितं कलवेणुगीतम्।\nआरुह्य ये द्रुमभुजान् रुचिरप्रवालान् शृण्वन्ति मीलितदृशो विगतान्यवाचः॥ १०/१९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.017.m4a", "display_order": 18}, {"id": 6000215018, "chapter_id": 10215, "verse_number": "१०-१९-१६", "content_sanskrit": "नद्यस्तदा तदुपधार्य मुकुन्दगीतमावर्तलक्षितमनोभवभग्नवेगाः।\nआलिङ्गनप्रमुदितोर्मिभुजैर्मुरारेः गृह्णन्ति पादयुगलं कमलोपहाराः॥ १०/१९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.018.m4a", "display_order": 19}, {"id": 6000215019, "chapter_id": 10215, "verse_number": "१०-१९-१७", "content_sanskrit": "दृष्ट्वाऽऽतपे व्रजपशून् सह रामगोपैः सञ्चारयन्तमनु वेणुमुदीरयन्तम्।\nप्रेमप्रवृद्धहृषितः कुसुमावलीभिः सख्युर्व्यधात् स्ववपुषाऽम्बुद आतपत्रम्॥ १०/१९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.019.m4a", "display_order": 20}, {"id": 6000215020, "chapter_id": 10215, "verse_number": "१०-१९-१८", "content_sanskrit": "पूर्णाः पुलिन्द्य उरुगायपदाब्जरागश्रीकुङ्कुमेन दयितास्तनमण्डितेन।\nतद्दर्शनस्मररुजस्तृणरूषितेन लिम्पन्त्य आननकुचेषु जहुस्तदाधिम्॥ १०/१९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.020.m4a", "display_order": 21}, {"id": 6000215021, "chapter_id": 10215, "verse_number": "१०-१९-१९", "content_sanskrit": "हन्तायमद्रिरबला हरिदासवर्यो यद् रामकृष्णचरणस्पर्शप्रमोदः।\nमानं तनोति सहगोगणयोस्तयोर्यत् पानीयसूयवसकन्दरकन्दमूलैः॥ १०/१९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.021.m4a", "display_order": 22}, {"id": 6000215022, "chapter_id": 10215, "verse_number": "१०-१९-२०", "content_sanskrit": "गा गोपकैरनुवनं नयतोरुदारवेणुस्वनैः कलपदैस्तनुभृत्सु सख्यम्।\nअस्पन्दनं गतिमतां पुलकस्तरूणां निर्योगपाशकृतलक्षणयोर्विचित्रम्॥ १०/१९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.022.m4a", "display_order": 23}, {"id": 6000215023, "chapter_id": 10215, "verse_number": "१०-१९-२१", "content_sanskrit": "एवंविधा भगवतो या वृन्दावनचारिणः।\nवर्णयन्त्यो मिथो गोप्यः क्रीडास्तन्मयतां ययुः॥ १०/१९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_019/BhP_10.019.023.m4a", "display_order": 24}, {"id": 6000215024, "chapter_id": 10215, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे एकोनविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]