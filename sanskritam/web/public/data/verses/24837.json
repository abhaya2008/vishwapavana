[{"id": 7004837000, "chapter_id": 24837, "verse_number": "७-१-२०-१", "content_sanskrit": "ईश्वर उवाच ।\nअथ दैत्यावताराणां क्रमो हि कथ्यते पुनः ।\nहिरण्यकशिपू राजा वर्षाणामर्बुदं बभौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004837001, "chapter_id": 24837, "verse_number": "७-१-२०-२", "content_sanskrit": "तथा शत सहस्राणि यानि कानि द्विसप्ततिम् ।\nअशीतिं च सहस्राणि त्रैलोक्यस्येश्वरोऽभवत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004837002, "chapter_id": 24837, "verse_number": "७-१-२०-३", "content_sanskrit": "सौत्येऽहन्यतिरात्रस्य कश्यपस्याश्वमेधिके ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004837003, "chapter_id": 24837, "verse_number": "७-१-२०-४", "content_sanskrit": "उपक्षिप्ता सनं यत्तु होतुरर्थे हिरण्मयम् ।\nनिषसाद स गर्तो ऽत्र हिरण्यकशिपुस्ततः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004837004, "chapter_id": 24837, "verse_number": "७-१-२०-५", "content_sanskrit": "शतवर्षसहस्राणां तपश्चक्रे सुदुश्चरम् ।\nदशवर्षसहस्राणि दित्या गर्भे स्थितः पुरा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004837005, "chapter_id": 24837, "verse_number": "७-१-२०-६", "content_sanskrit": "हिणयकशिपोर्दैत्यैः श्लोको गीतः पुरातनः ।\nराजा हिरण्यकशिपुर्यां यामाशां निरीक्षते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004837006, "chapter_id": 24837, "verse_number": "७-१-२०-७", "content_sanskrit": "तस्यां तस्यां दिशि सुरा नमश्चक्रुः सहर्षिभिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004837007, "chapter_id": 24837, "verse_number": "७-१-२०-८", "content_sanskrit": "पर्याये तस्य राजाभूद्बलिर्वर्षार्बुदं पुनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004837008, "chapter_id": 24837, "verse_number": "७-१-२०-९", "content_sanskrit": "षष्टिं चैव सहस्राणि त्रिंशच्च नियुतानि च ।\nबले राज्याधिकारस्तु याव त्कालं बभूव ह ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004837009, "chapter_id": 24837, "verse_number": "७-१-२०-१०", "content_sanskrit": "प्रह्लादो निगृहीतोऽभूत्तावत्कालं तथा सुरैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004837010, "chapter_id": 24837, "verse_number": "७-१-२०-११", "content_sanskrit": "इंद्रादयस्ते विख्याता असुराञ्जघ्नुरोजसा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004837011, "chapter_id": 24837, "verse_number": "७-१-२०-१२", "content_sanskrit": "दैत्यसंस्थमिदं सर्वमा सीद्दशयुगं किल ।\nअसपत्नं ततः सर्वमष्टादशयुगं पुनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004837012, "chapter_id": 24837, "verse_number": "७-१-२०-१३", "content_sanskrit": "त्रैलोक्यमिदमव्यग्रं महेंद्रेण तु पालितम् ।\nत्रेतायुगे तु दशमे कार्त्तवीर्यो महाबलः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004837013, "chapter_id": 24837, "verse_number": "७-१-२०-१४", "content_sanskrit": "पंचाशीतिसहस्राणि वर्षाणां वै नराधिपः ।\nस सप्तरत्नवान्सम्राट् चक्रवर्ती बभूव ह ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004837014, "chapter_id": 24837, "verse_number": "७-१-२०-१५", "content_sanskrit": "द्वीपेषु सप्तसु स वै खड्गी चर्मी शरासनी ।\nरथी राजा सानुचरो योगाच्चौरानपश्यत ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004837015, "chapter_id": 24837, "verse_number": "७-१-२०-१६", "content_sanskrit": "प्रणष्टद्रव्यता यस्य स्मरणान्न भवेन्नृणाम् ।\nचतुर्युगे त्वतिक्रांते मनौ ह्येकादशे प्रभौ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004837016, "chapter_id": 24837, "verse_number": "७-१-२०-१७", "content_sanskrit": "अर्द्धावशिष्टे तस्मिंस्तु द्वापरे संप्रवर्तिते ।\nमानवस्य नरिष्यंतो ह्यासीत्पुत्रो मदः किल ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004837017, "chapter_id": 24837, "verse_number": "७-१-२०-१८", "content_sanskrit": "नवमस्तस्य दायादस्तृणबिंदुरिति स्मृतः ।\nत्रेतायुगमुखे राजा तृतीये संबभूव ह ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004837018, "chapter_id": 24837, "verse_number": "७-१-२०-१९", "content_sanskrit": "तस्य कन्या त्विलविला रूपे णाप्रतिमाऽभवत् ।\nपुलस्त्याय स राजर्षिस्तां कन्यां प्रत्यपादयत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004837019, "chapter_id": 24837, "verse_number": "७-१-२०-२०", "content_sanskrit": "ऋषिरैलविलो यस्यां विश्रवाः समपद्यत ।\nतस्य पत्न्यश्च तिस्रस्तु पौलस्त्यकुलमंडनाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004837020, "chapter_id": 24837, "verse_number": "७-१-२०-२१", "content_sanskrit": "बृहस्पतेः शुभा कन्या नाम्ना वै वेदवर्णिनी ।\nपुष्पोत्कटा च वीका च उभे माल्यवतः सुते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004837021, "chapter_id": 24837, "verse_number": "७-१-२०-२२", "content_sanskrit": "केकसी मालिनः कन्या तस्यां देवि शृणु प्रजाः ।\nज्येष्ठं वैश्रवणं तस्य सुषुवे वरवर्णिनी ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004837022, "chapter_id": 24837, "verse_number": "७-१-२०-२३", "content_sanskrit": "अष्टदं हरिच्छ्मश्रुं शंकुकर्णं विलोहितम् ।\nश्वपादं ह्रस्वबाहुं च पिंगलं शुचिभूषणम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004837023, "chapter_id": 24837, "verse_number": "७-१-२०-२४", "content_sanskrit": "त्रिपादं तु महाकायं स्थूलशीर्षं महाहनुम् ।\nएवंविधं सुतं दृष्ट्वा विरूपं रूपतस्तदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004837024, "chapter_id": 24837, "verse_number": "७-१-२०-२५", "content_sanskrit": "तदा दृष्ट्वाब्रवीत्तं तु कुबेरोऽयमिति स्वयम् ।\nकुत्सायां क्वितिशब्दोयं शरीरं वेरमुच्यते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004837025, "chapter_id": 24837, "verse_number": "७-१-२०-२६", "content_sanskrit": "कुबेरः कुशरीरत्वान्नाम्ना तेन च सोंकितः ।\nतस्य भार्य्याऽभवद्वृद्धिः पुत्रस्तु नलकूबरः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004837026, "chapter_id": 24837, "verse_number": "७-१-२०-२७", "content_sanskrit": "कैकस्यजनयत्पुत्रं रावणं राक्षसाधिपम् ।\nशंकुकर्णं दशग्रीवं पिगलं रक्तमूर्द्धजम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004837027, "chapter_id": 24837, "verse_number": "७-१-२०-२८", "content_sanskrit": "वसुपादं विंशद्भुजं महाकायं महाबलम् ।\nकालांजननिभं चैव दंष्ट्रिणं रक्तलोचनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004837028, "chapter_id": 24837, "verse_number": "७-१-२०-२९", "content_sanskrit": "राक्षसेनौजसा युक्तं रूपेण च बलेन च ।\nनिसर्गाद्दारुणः क्रूरो रावणाद्रावणः स्मृतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004837029, "chapter_id": 24837, "verse_number": "७-१-२०-३०", "content_sanskrit": "हिरण्यकशिपुस्त्वासीत्स राजा पूर्वजन्मनि ।\nचतुर्युगानि राजा तु तथा दश स राक्षसः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004837030, "chapter_id": 24837, "verse_number": "७-१-२०-३१", "content_sanskrit": "पंच कोटीस्तु वर्षाणां संख्यताः संख्याया प्रिये ।\nनियुतान्येकषष्टिं च संख्यावद्भिरुदाहृतम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004837031, "chapter_id": 24837, "verse_number": "७-१-२०-३२", "content_sanskrit": "षष्टिं चैव सहस्राणि वर्षाणां स हि रावणः ।\nदेवतानामृषीणां च घोरं कृत्वा प्रजागरम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004837032, "chapter_id": 24837, "verse_number": "७-१-२०-३३", "content_sanskrit": "त्रेतायुगे चतुर्विंशे रावणस्तपसः क्षयात् ।\nरामं दाशरथिं प्राप्य सगणः क्षयमेयिवान् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004837033, "chapter_id": 24837, "verse_number": "७-१-२०-३४", "content_sanskrit": "योऽसौ देवि दशग्रीवः संबभूवारिमर्द्दनः ।\nदमघोषस्य राजर्षेः पुत्रो विख्यातपौरुषः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004837034, "chapter_id": 24837, "verse_number": "७-१-२०-३५", "content_sanskrit": "श्रुतश्रवायां चैद्यस्तु शिशुपालो बभूव ह ।\nरावणं कुंभकर्णं च कन्यां शूर्पणखां तथा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004837035, "chapter_id": 24837, "verse_number": "७-१-२०-३६", "content_sanskrit": "विभीषणं चतुर्थं च कैकस्यजनयत्सुतान् ।\nमनोहरः प्रहस्तश्च महापार्श्वः खरस्तथा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004837036, "chapter_id": 24837, "verse_number": "७-१-२०-३७", "content_sanskrit": "पुष्पोत्कटायास्ते पुत्राः कन्या कुम्भीनसी तथा ।\nत्रिशिरा दूषणश्चैव विद्युज्जिह्वश्च राक्षसः ।\nकन्यैका श्यामिका नाम वीकायाः प्रसवः स्मृतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004837037, "chapter_id": 24837, "verse_number": "७-१-२०-३८", "content_sanskrit": "इत्येते क्रूरकर्माणः पौलस्त्या राक्षसा नव ।\nविभीषणो विशुद्धात्मा दशमः परिकीर्तितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004837038, "chapter_id": 24837, "verse_number": "७-१-२०-३९", "content_sanskrit": "पुलहस्य मृगाः पुत्राः सर्वे व्यालाश्च दंष्ट्रिणः ।\nभूताः पिशाचाः सर्पाश्च शूकरा हस्तिनस्तथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004837039, "chapter_id": 24837, "verse_number": "७-१-२०-४०", "content_sanskrit": "अनपत्यः क्रतुस्त्वस्मिन्स्मृतो वैवस्वतेंतरे ।\nअत्रेः पत्न्यो दशैवासन्सुन्दर्यश्च पतिव्रताः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004837040, "chapter_id": 24837, "verse_number": "७-१-२०-४१", "content_sanskrit": "भद्राश्वस्य घृताच्यंता जज्ञिरे दश चाप्सराः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004837041, "chapter_id": 24837, "verse_number": "७-१-२०-४२", "content_sanskrit": "भद्रा शूद्रा च मद्रा च नलदा जलदा तथा ।\nउर्णा पूर्णा च देवेशि या च गोपुच्छला स्मृता ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004837042, "chapter_id": 24837, "verse_number": "७-१-२०-४३", "content_sanskrit": "तथा तामरसा नाम दशमी रक्तकोटिका ।\nएतासां च महादेवि ख्यातो भर्त्ता प्रभाकरः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004837043, "chapter_id": 24837, "verse_number": "७-१-२०-४४", "content_sanskrit": "स्वर्भानुना हते सूर्ये पतितेस्मिन्दिवो महीम् ।\nतमोऽभिभूते लोकेस्मिन्प्रभा येन प्रवर्त्तिता॥ ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004837044, "chapter_id": 24837, "verse_number": "७-१-२०-४५", "content_sanskrit": "स्वस्ति तेस्त्विति चैवोक्तः पतन्निह दिवाकरः ।\nब्रह्मर्षेर्वचनात्तस्य न पपात यतः प्रभुः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004837045, "chapter_id": 24837, "verse_number": "७-१-२०-४६", "content_sanskrit": "ततः प्रभाकरेत्युक्तः प्रभुरेवं महर्षिभिः ।\nभद्रायां जनयामाम् सोमं पुत्रं यशस्विनम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004837046, "chapter_id": 24837, "verse_number": "७-१-२०-४७", "content_sanskrit": "त्विषिमान्धर्मपुत्रस्तु सोमो देवो वरस्तु सः ।\nशीतरश्मिः समुत्पन्नः कृत्तिकासु निशाचरः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004837047, "chapter_id": 24837, "verse_number": "७-१-२०-४८", "content_sanskrit": "पिता सोमस्य वै देवि जज्ञेऽत्रिर्भगवानृषिः ।\nतत्रात्रिः सर्वलोकेशं भृत्वा स्वे नयने स्थितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004837048, "chapter_id": 24837, "verse_number": "७-१-२०-४९", "content_sanskrit": "कर्मणा मनसा वाचा शुभान्येव समा चरत् ।\nकाष्ठकुड्यशिलाभूत ऊर्द्ध्वबाहुर्महाद्युतिः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004837049, "chapter_id": 24837, "verse_number": "७-१-२०-५०", "content_sanskrit": "सुदुस्तरं नाम तपस्तेन तप्तं महत्पुरा ।\nत्रीणि वर्षसहस्राणि दिव्यानि सुरसुंदरि ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004837050, "chapter_id": 24837, "verse_number": "७-१-२०-५१", "content_sanskrit": "तस्योर्द्ध्वरेतसस्तत्र स्थितस्यानिमिषस्य ह ।\nसोमत्वं वपुरापेदे महाबुद्धेस्तु वै शुभे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004837051, "chapter_id": 24837, "verse_number": "७-१-२०-५२", "content_sanskrit": "ऊर्द्ध्वमाचक्रमे तस्य सोमसंभावितात्मनः ।\nनेत्राभ्यां सोमः सुस्राव दशधा द्योतयन्दिशः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004837052, "chapter_id": 24837, "verse_number": "७-१-२०-५३", "content_sanskrit": "तद्गर्भं विधिना दृष्टा दिशोदश दधुस्तदा ।\nसमेत्य धारयामासुर्न च धर्तुमशक्नुवन् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004837053, "chapter_id": 24837, "verse_number": "७-१-२०-५४", "content_sanskrit": "स ताभ्यः सहसैवेह दिग्भ्यो गर्भश्च शाश्वतः॥ पपात भावयंल्लोकाञ्छीतांशुः सर्वभावनः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004837054, "chapter_id": 24837, "verse_number": "७-१-२०-५५", "content_sanskrit": "यदा न धारणे शक्तास्तस्य गर्भस्य ताः स्त्रियः ।\nततस्ताभ्यः स शीतांशुर्निपपात वसुंधराम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004837055, "chapter_id": 24837, "verse_number": "७-१-२०-५६", "content_sanskrit": "पतितं सोममालोक्य ब्रह्मा लोकपितामहः ।\nरथमारोपयामास लोकानां हितका म्यया ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004837056, "chapter_id": 24837, "verse_number": "७-१-२०-५७", "content_sanskrit": "स तदैव मया देवि धर्मार्थं सत्यसंगरः ।\nयुक्तो वाजिसहस्रेण सितेन सुरसुंदरि ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004837057, "chapter_id": 24837, "verse_number": "७-१-२०-५८", "content_sanskrit": "तस्मिन्निपतिते देवि पुत्रेत्रेः परमात्म नि ।\nतुष्टुवुर्ब्रह्मणः पुत्रा मानसाः सप्त ये श्रुताः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004837058, "chapter_id": 24837, "verse_number": "७-१-२०-५९", "content_sanskrit": "तथैवांगिरसः सर्वे भृगोश्चैवात्मजास्तथा ।\nऋग्भिस्तु सामभिश्चैव तथैवांगिरसैरपि ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004837059, "chapter_id": 24837, "verse_number": "७-१-२०-६०", "content_sanskrit": "तस्य संस्तूयमानस्य तेजः सोमस्य भास्वतः ।\nआप्यायमानं लोकांस्त्रीन्भासयामास सर्वशः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004837060, "chapter_id": 24837, "verse_number": "७-१-२०-६१", "content_sanskrit": "स तेन रथमुख्येन सागरांतां वसुंधराम् ।\nत्रिःसप्तकृत्वोतियशाश्चकाराभिप्रदक्षिणम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004837061, "chapter_id": 24837, "verse_number": "७-१-२०-६२", "content_sanskrit": "तस्य यच्चापि तत्तेजः पृथिवीमन्वपद्यत ।\nओषध्यस्ताः समुत्पन्नास्ते जसाऽज्वलयन्पुनः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004837062, "chapter_id": 24837, "verse_number": "७-१-२०-६३", "content_sanskrit": "ताभिर्धिनोत्ययं लोकं प्रजाश्चैव चतुर्विधाः ।\nओषध्यः फलपाकांताः कणाः सप्तदश स्मृताः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004837063, "chapter_id": 24837, "verse_number": "७-१-२०-६४", "content_sanskrit": "व्रीहयश्च यवाश्चैव गोधूमा अणवस्तिलाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004837064, "chapter_id": 24837, "verse_number": "७-१-२०-६५", "content_sanskrit": "प्रियंगुः कोविदारश्च कोरदूषाः सतीनकाः ।\nमाषा मुद्गा मसूराश्च निष्पावाः सकुलत्थकाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004837065, "chapter_id": 24837, "verse_number": "७-१-२०-६६", "content_sanskrit": "आढक्यश्चणकाश्चैव कणाः सप्तदश स्मृताः ।\nइत्येता ओषधीनां च ग्राम्याणां जातयः स्मृताः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004837066, "chapter_id": 24837, "verse_number": "७-१-२०-६७", "content_sanskrit": "ओषध्यो यज्ञियाश्चैव ग्राम्या रण्याश्चतुर्द्दश ।\nव्रीहयश्च यवाश्चैव गोधूमास्त्वणवस्तिलाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004837067, "chapter_id": 24837, "verse_number": "७-१-२०-६८", "content_sanskrit": "प्रियंगुषष्ठा इत्येते सप्तमास्तु कुलत्थकाः ।\nश्यामाकास्त्वथ नीवारा जर्तिलाः सगवेधुकाः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004837068, "chapter_id": 24837, "verse_number": "७-१-२०-६९", "content_sanskrit": "ऊरुविन्दा मर्कटकास्तथा वेणुयवाश्च ये ।\nग्राम्यारण्यास्तथा ह्येता ओषध्यस्तु चतुर्दश ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004837069, "chapter_id": 24837, "verse_number": "७-१-२०-७०", "content_sanskrit": "तृणगुल्मलता वीरुद्वल्लीगुच्छादि कोटिशः ।\nएतेषामधिपश्चन्द्रो धारयत्यखिलं जगत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004837070, "chapter_id": 24837, "verse_number": "७-१-२०-७१", "content_sanskrit": "ज्योत्स्नाभिर्भगवान्सोमो जगतो हितकाम्यया ।\nततस्तस्मै ददौ राज्यं ब्रह्मा ब्रह्मविदां वरः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004837071, "chapter_id": 24837, "verse_number": "७-१-२०-७२", "content_sanskrit": "बीजौषधीनां विप्राणां मंत्राणां च वरानने ।\nसोऽभिषिक्तो महातेजा राजा राज्ये निशाकरः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004837072, "chapter_id": 24837, "verse_number": "७-१-२०-७३", "content_sanskrit": "त्रींल्लोकान्भावयामास स्वभासा भास्वतां वरः ।\nतं सिनी च कुहूश्चैव द्युतिःपुष्टिः प्रभा वसुः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004837073, "chapter_id": 24837, "verse_number": "७-१-२०-७४", "content_sanskrit": "कीर्तिर्धृतिश्च लक्ष्मीश्च नव देव्यः सिषेविरे ।\nसप्तविंशतिरिंदोस्तु दाक्षायण्यो महाव्रताः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004837074, "chapter_id": 24837, "verse_number": "७-१-२०-७५", "content_sanskrit": "ददौ प्राचेतसो दक्षो नक्षत्राणीति या विदुः ।\nस तत्प्राप्य मह्द्राज्यं सोमः सोमवतां वरः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004837075, "chapter_id": 24837, "verse_number": "७-१-२०-७६", "content_sanskrit": "समाजह्रे राजसूयं सहस्रशतदक्षिणम् ।\nहिरण्यगर्भश्चोद्गाता ब्रह्मा ब्रह्मत्वमेयिवान् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004837076, "chapter_id": 24837, "verse_number": "७-१-२०-७७", "content_sanskrit": "सदस्यस्तस्य भगवान्हरिर्नारायणः प्रभुः ।\nसनत्कुमारप्रमुखैराद्यैर्ब्रह्मर्षिभिर्वृतः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004837077, "chapter_id": 24837, "verse_number": "७-१-२०-७८", "content_sanskrit": "दक्षिणामददात्सोमस्त्रींल्लोकांस्तु वरानने ।\nतेभ्यो ब्रह्मर्षिमुख्येभ्यः सदस्येभ्यश्च वै शुभे ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004837078, "chapter_id": 24837, "verse_number": "७-१-२०-७९", "content_sanskrit": "प्राप्यावभृथमव्यग्रः सर्वदेवर्षिपूजितः ।\nअतिराजति राजेन्द्रो दशधा भावयन्दिशः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004837079, "chapter_id": 24837, "verse_number": "७-१-२०-८०", "content_sanskrit": "तेन तत्प्राप दुष्प्राप्यमैश्वर्य्यमकृता त्मभिः ।\nस एवं वर्त्तते चन्द्रश्चात्रेय इति विश्रुतः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004837080, "chapter_id": 24837, "verse_number": "७-१-२०-८१", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये चन्द्रोत्पत्तिवर्णनंनाम विंशोऽध्यायः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]