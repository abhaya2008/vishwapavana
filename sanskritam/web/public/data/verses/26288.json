[{"id": 7006288000, "chapter_id": 26288, "verse_number": "३-४२-१", "content_sanskrit": "अगस्त्य उवाच मुद्राविरचनारीतिमश्वानन निवेदय ।\nयाभिर्विरचिताभिस्तु श्रीदेवी संप्रसीदति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006288001, "chapter_id": 26288, "verse_number": "३-४२-२", "content_sanskrit": "हयग्रीव उवाच आवाहनी महामुद्रा त्रिखण्डेति प्रकीर्तिता ।\nपरिवृत्य करौ स्पष्टमङ्गुष्ठौ कारयेत्समौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006288002, "chapter_id": 26288, "verse_number": "३-४२-३", "content_sanskrit": "अनामान्तर्गते कृत्वा तर्जन्यौ कुटिलाकृती ।\nकनिष्ठिके नियुञ्जीत निजस्थाने तपोधन ।\nसंक्षोभिण्याख्यामुद्रां तु कथयाम्यधुना श्रुणु ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006288003, "chapter_id": 26288, "verse_number": "३-४२-४", "content_sanskrit": "मध्यमे मध्यगे कृत्वा कनिष्ठाङ्गुष्टरोधिते ।\nतर्जन्यो दण्डवत्कृत्वा मध्यमोपर्यनामिके ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006288004, "chapter_id": 26288, "verse_number": "३-४२-५", "content_sanskrit": "एतस्या एव मुद्राया मध्यमे सरले यदि ।\nक्रियते विन्ध्यदर्पारे मुद्रा विद्राविणी तथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006288005, "chapter_id": 26288, "verse_number": "३-४२-६", "content_sanskrit": "मध्यमातर्जनीभ्यां तु कनिष्ठानामिके समे ।\nअङ्कुशाकाररूपाभ्यां मध्यगे कलशोद्भव ।\nइयमाकर्षिणी मुद्रा त्रैलोक्याकर्षणे क्षमा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006288006, "chapter_id": 26288, "verse_number": "३-४२-७", "content_sanskrit": "पुटाकारौ करौ कृत्वा तर्जन्यावङ्कुशाकृती ।\nपरिवर्तक्रमेणैव मध्यमे तदधोगते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006288007, "chapter_id": 26288, "verse_number": "३-४२-८", "content_sanskrit": "क्रमेणानेन देवर्षे मध्यमामध्यगेऽनुजे ।\nअनामिके तु सरले तद्बहिस्तर्जनीद्वयम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006288008, "chapter_id": 26288, "verse_number": "३-४२-९", "content_sanskrit": "दण्डाकारौ ततोंऽगुष्ठौ मध्यमावर्तदेशगौ ।\nमुद्रैषोन्मादिनी नाम्ना ख्याता वातापितापन ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006288009, "chapter_id": 26288, "verse_number": "३-४२-१०", "content_sanskrit": "अस्यास्त्वनामिकायुग्ममधः कृत्वाङ्कुशाकृति ।\nतर्जन्यावपि तेनैव क्रमेण विनियोजयेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006288010, "chapter_id": 26288, "verse_number": "३-४२-११", "content_sanskrit": "इयं महाङ्कुशा मुद्रा सर्वकार्यार्थसाधिका ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006288011, "chapter_id": 26288, "verse_number": "३-४२-१२", "content_sanskrit": "सव्यं दक्षिणादेशे तु दक्षिणं सव्यदेशतः ।\nबाहू कृत्वा तु देवर्षे हस्तौ सम्परिवर्त्य च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006288012, "chapter_id": 26288, "verse_number": "३-४२-१३", "content_sanskrit": "कनिष्ठानामिके युक्ते क्रमेणानेन तापस ।\nतर्जनीभ्यां समाक्रान्ते सर्वोर्ध्वमपि मध्यमे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006288013, "chapter_id": 26288, "verse_number": "३-४२-१४", "content_sanskrit": "लोपामुद्रापतेङ्गुष्ठौ कारयेत्सकलावपि ।\nइयं तु खेचरी नाम मुद्रा सर्वोत्तमोत्तमा ।\nएतद्विज्ञानमात्रेण योगिनीनां प्रियो भवेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006288014, "chapter_id": 26288, "verse_number": "३-४२-१५", "content_sanskrit": "परिवर्त्य करौ स्पृष्टावर्धचन्द्रसमाकृती ।\nतर्जन्यङ्गुष्ठयुगलं युगपद्योजयेत्ततः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006288015, "chapter_id": 26288, "verse_number": "३-४२-१६", "content_sanskrit": "अधः कनिष्ठावष्टब्धमध्यमे विनियोजयेत् ।\nअथैते कुटिले युक्त्वा सर्वाधस्तादनामिके ।\nबीजमुद्रेयमाचिरात्सर्वसिद्धप्रवर्तिनी ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006288016, "chapter_id": 26288, "verse_number": "३-४२-१७", "content_sanskrit": "मध्याग्रे कुटिलाकारे तर्जन्युपरि संस्थिते ।\nअनामिकामध्यगते तथैव हि कनिष्टिके ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006288017, "chapter_id": 26288, "verse_number": "३-४२-१८", "content_sanskrit": "सर्वा एकत्र संयोज्य चाङ्गुष्ठपरिपीडिताः ।\nएषा तु प्रथमा मुद्रा योनिमुद्रेति संज्ञिता ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006288018, "chapter_id": 26288, "verse_number": "३-४२-१९", "content_sanskrit": "एता मुद्रास्तु देवर्षे श्रीदेव्याः प्रीतिहेतवः ।\nपूजाकाले प्रयोक्तव्या यथानुक्रमयोगतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]