[{"id": 2022572, "chapter_id": 1477, "verse_number": "३-११५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022573, "chapter_id": 1477, "verse_number": "३-११५-१", "content_sanskrit": "ततः प्रयातः कौशिक्याः पाण्डवो जनमेजय।\nआनुपूर्व्येण सर्वाणि जगामायतनान्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022574, "chapter_id": 1477, "verse_number": "३-११५-२", "content_sanskrit": "स सागरं समासाद्य गङ्गायाः संगमे नृप।\nनदीशतानां पञ्चानां मध्ये चक्रे समाप्लवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022575, "chapter_id": 1477, "verse_number": "३-११५-३", "content_sanskrit": "ततः समुद्रतीरेण जगाम वसुधाधिपः।\nभ्रातृभिः सहितो वीरः कलिङ्गान्प्रति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022576, "chapter_id": 1477, "verse_number": "३-११५-४x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022577, "chapter_id": 1477, "verse_number": "३-११५-४", "content_sanskrit": "एते कलिङ्गाः कौन्तेय यत्र वैतरणी नदी।\nयत्रायजत धर्मोपि देवाञ्शरणमेत्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022578, "chapter_id": 1477, "verse_number": "३-११५-५", "content_sanskrit": "ऋषिभिः समुपायुक्तं यज्ञियं गिरिशोभितम्।\nउत्तरं तीरमेतद्धि सततं द्विजसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022579, "chapter_id": 1477, "verse_number": "३-११५-६", "content_sanskrit": "समेन देवयानेन पथा स्वर्गमुपेयुषः।\nअत्रवै ऋषयोऽन्येऽपि पुरा क्रतुभिरीजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022580, "chapter_id": 1477, "verse_number": "३-११५-७", "content_sanskrit": "अत्रैव रुद्रो राजेन्द्र पशुमादत्तवान्मखे।\nपशुमादाय राजेन्द्र भागोयमिति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022581, "chapter_id": 1477, "verse_number": "३-११५-८", "content_sanskrit": "हृते पशौ तदा देवास्तमूचुर्भरतर्षभ।\nमा परस्वमभिद्रोग्धा माधर्म्यान्नीनशः पथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022582, "chapter_id": 1477, "verse_number": "३-११५-९", "content_sanskrit": "`स्वयं यज्ञेश्वरो भूत्वा कर्मणां फलदायकः।\nयज्ञं विहन्तुं भगवान्नार्हसे जगदीश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022583, "chapter_id": 1477, "verse_number": "३-११५-१०", "content_sanskrit": "इतिकल्याणरूपाभिर्वाग्भिस्ते रुद्रमस्तुवन्।\nइष्ट्या चैनं तर्पयित्वा मानयांचक्रिरे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022584, "chapter_id": 1477, "verse_number": "३-११५-११", "content_sanskrit": "ततः स पशुमुत्सृज्य देवयानेन जग्मिवान्।\nतत्रानुवंशो रुद्रस्यतं निबोध युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022585, "chapter_id": 1477, "verse_number": "३-११५-१२", "content_sanskrit": "अयातयामं सर्वेभ्यो भागेभ्यो भागमुत्तमम्।\nदेवाः संकल्पयामासुर्भयाद्रुद्रस्य शाश्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022586, "chapter_id": 1477, "verse_number": "३-११५-१३", "content_sanskrit": "इमां गाथामत्र गायन्नपः स्पृशति यो नरः।\nदेवयानोऽस्य पन्थाश्च चक्षुषाऽभिप्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022587, "chapter_id": 1477, "verse_number": "३-११५-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022588, "chapter_id": 1477, "verse_number": "३-११५-१४", "content_sanskrit": "ततो वैतरणीं सर्वे पाण्डवा द्रौपदी तथा।\nअवतीर्य महाभागास्तर्पयांचक्रिरे पितृन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022589, "chapter_id": 1477, "verse_number": "३-११५-१५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022590, "chapter_id": 1477, "verse_number": "३-११५-१५", "content_sanskrit": "उपस्पृश्येह विधिवदस्यां नद्यां तपोबलात्।\nमानुषादस्मि विषयादपेतः पश्य लोमश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022591, "chapter_id": 1477, "verse_number": "३-११५-१६", "content_sanskrit": "सर्वाल्लोँकान्प्रपश्यामि प्रसादात्तव सुव्रत।\nवैखानसानां जपतामेष शब्दो महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022592, "chapter_id": 1477, "verse_number": "३-११५-१७x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022593, "chapter_id": 1477, "verse_number": "३-११५-१७", "content_sanskrit": "त्रिशतं वै सहस्राणि योजनानां युधिष्ठिर।\nयत्रध्वनिं शृणोष्येनं तूष्णीमास्स्व विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022594, "chapter_id": 1477, "verse_number": "३-११५-१८", "content_sanskrit": "एतत्स्वयंभुवो राजन्वनं दिव्यं प्रकाशते।\nयत्रायजत राजेन्द्र विश्वकर्मा प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022595, "chapter_id": 1477, "verse_number": "३-११५-१९", "content_sanskrit": "यस्मिन्यज्ञे हि भूर्दत्ता कश्यपाय महात्मने।\nसपर्वतवनोद्देशा दक्षिणार्थे स्वयंभुवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022596, "chapter_id": 1477, "verse_number": "३-११५-२०", "content_sanskrit": "अवासीदच्च कौन्तेय दत्तमात्रा मही तदा।\nउवाच चापि कुपिता लोकश्वरमिदं प्रभुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022597, "chapter_id": 1477, "verse_number": "३-११५-२१", "content_sanskrit": "न मां मर्त्याय भगवन्कस्मैचिद्दातुमर्हसि।\nप्रदानं मोघमेतत्ते यास्याम्येषा रसातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022598, "chapter_id": 1477, "verse_number": "३-११५-२२", "content_sanskrit": "विषीदन्तीं तु तां दृष्ट्वा कश्यपो भगवानृषिः।\nप्रसादयांबभूवाथ ततो भूमिं विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022599, "chapter_id": 1477, "verse_number": "३-११५-२३", "content_sanskrit": "ततः प्रसन्ना पृथिवी तपसा तस्य पाण्डव।\nपुनरुन्नह्य सलिलाद्देदीरूपास्थिता बभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2022600, "chapter_id": 1477, "verse_number": "३-११५-२४", "content_sanskrit": "सैषा प्रकाशते राजन्वेदीसंस्थानलक्षणा।\nआरुह्यात्र महाराज वीर्यवान्वै भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2022601, "chapter_id": 1477, "verse_number": "३-११५-२५", "content_sanskrit": "सैषा सागरमास्राद्य राजन्वेदी समाश्रिता।\nएतामारुह्य भद्रं ते त्वमेकस्तर सागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2022602, "chapter_id": 1477, "verse_number": "३-११५-२६", "content_sanskrit": "अहं च ते स्वस्त्ययनं प्रयोक्ष्ये\nयथा त्वमेनामधिरोहसेऽद्य।\nस्पृष्टा हि मर्त्येन ततः समुद्र-\nमेषा वेदी प्रविशत्याजमीढ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2022603, "chapter_id": 1477, "verse_number": "३-११५-२७", "content_sanskrit": "ओंनमो विश्वगुप्ताय नमो विश्वपराय ते।\nसान्निध्यं कुरु देवेश सागरे लवणाम्भसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2022604, "chapter_id": 1477, "verse_number": "३-११५-२८", "content_sanskrit": "अग्निर्मित्रो योनिरापोऽथ देव्यो\nविष्णो रेतस्त्वममृतस्य नाभिः।\nएवं ब्रुवन्पाण्डव सत्यवाक्यं\nवेदीमिमां त्वं तरसाऽधिरोह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2022605, "chapter_id": 1477, "verse_number": "३-११५-२९", "content_sanskrit": "अग्निश्च ते योनिरिडा च देहो\nरेतोधा विष्णोरमृतस्य नाभिः।\nएवं ब्रुवन्पाण्डव सत्यवाक्यं\nततोऽवगाहेत पतिं नदीनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2022606, "chapter_id": 1477, "verse_number": "३-११५-३०", "content_sanskrit": "अन्यथा हि कुरुश्रेष्ठ देवयोनिरपांपतिः।\nकुशाग्रेणापि कौन्तेय न स्प्रष्टव्यो महोदधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2022607, "chapter_id": 1477, "verse_number": "३-११५-३१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2022608, "chapter_id": 1477, "verse_number": "३-११५-३१", "content_sanskrit": "ततः कृतस्वस्त्ययनो महात्मा\nयुधिष्ठिरः सागरमभ्यगच्छत्।\nकृत्वा च तच्छासनमस्य सर्वं\nमहेन्द्रमासाद्य निशामुवास ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2022609, "chapter_id": 1477, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि पञ्चदशाधिकशततमोऽध्यायः ॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]