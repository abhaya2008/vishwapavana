[{"id": 7005758000, "chapter_id": 25758, "verse_number": "२३१-१", "content_sanskrit": "शान्तिविधानवर्णनम्गर्ग उवाच ।\nअनग्निर्दीप्यते यत्र राष्ट्रे यस्य निरन्धनः ।\nन दीप्यते चेन्धनवान् तद्राष्ट्रं पीड्यते नृपैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005758001, "chapter_id": 25758, "verse_number": "२३१-२", "content_sanskrit": "प्रज्वलेदप्सु मांसं वा तथार्द्रं वापि किञ्चन ।\nप्राकारं तोरणं द्वारं नृपवेश्म सुरालयम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005758002, "chapter_id": 25758, "verse_number": "२३१-३", "content_sanskrit": "एतानि यत्र दीप्यन्ते तत्र राज्ञो भयं भवेत् ।\nविद्युता वा प्रदह्यन्ते तदापि नृपतेर्भयम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005758003, "chapter_id": 25758, "verse_number": "२३१-४", "content_sanskrit": "अनैशानि तमांसि स्युर्विना पांसुरजांसि च ।\nधूमश्चानग्निजो यत्र तत्र विन्द्यन्महाभयम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005758004, "chapter_id": 25758, "verse_number": "२३१-५", "content_sanskrit": "तडित्त्वनभ्रे गगने भयं स्यादृक्षवर्जिते ।\nदिवा सतारे गगने तथैव भयमादिशेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005758005, "chapter_id": 25758, "verse_number": "२३१-६", "content_sanskrit": "ग्रहनक्षत्र-वैकृत्ये ताराविषमदर्शने ।\nपुरुवाहन-यानेषु चतुष्पान्मृगपक्षिषु ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005758006, "chapter_id": 25758, "verse_number": "२३१-७", "content_sanskrit": "आयुधेषु च दीप्तेषु धूमायत्सु तथैव च ।\nनिर्गमत्सु च कोशाच्च सङ्ग्रामस्तुमुलो भवेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005758007, "chapter_id": 25758, "verse_number": "२३१-८", "content_sanskrit": "विनाग्निं विस्फुलिङ्गाश्च दृश्यन्ते यत्र कुत्रचित् ।\nस्वभावाच्चापि पूर्यन्ते धनूंषिं विकृतानि च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005758008, "chapter_id": 25758, "verse_number": "२३१-९", "content_sanskrit": "विकारश्चायुधानं स्यात् तत्र सङ्ग्राममादिशेत् ।\nत्रिरात्रो पोषितश्चात्र पुरोधाः सुसमाहितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005758009, "chapter_id": 25758, "verse_number": "२३१-१०", "content_sanskrit": "समिद्भिः क्षीरवृक्षाणां सर्षपैश्च घृतेन च ।\nहोमं कुर्यादग्निमन्त्रैः ब्राह्मणांश्चैव भोजयेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005758010, "chapter_id": 25758, "verse_number": "२३१-११", "content_sanskrit": "दद्यात्सुवर्णञ्च तथा द्विजेभ्यो गाश्चैव वस्त्राणि तथा भुवञ्च ।\nएवं कृते पापमुपैति नाशं यदग्नि-वैकृत्यभवं द्विजेन्द्र! ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]