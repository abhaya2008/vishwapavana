[{"id": 2088496, "chapter_id": 2884, "verse_number": "१३-१४-१", "content_sanskrit": "भीष्म उवाच।\nभूयस्तु शृणु राजेन्द्र धर्मान्धर्मभृतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088497, "chapter_id": 2884, "verse_number": "१३-१४-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nइन्द्राग्न्योः सूर्यशच्योश्च तन्मे निगदतः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088498, "chapter_id": 2884, "verse_number": "१३-१४-३x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088499, "chapter_id": 2884, "verse_number": "१३-१४-३", "content_sanskrit": "राज्ये विप्रान्प्रपश्यामि कामक्रोधविवर्जितान्।\nएतेन सत्यवाक्येन पादः कुम्भस्य पूर्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088500, "chapter_id": 2884, "verse_number": "१३-१४-४x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088501, "chapter_id": 2884, "verse_number": "१३-१४-४", "content_sanskrit": "यथाऽहं तत्र नाश्नामि यत्र नाश्नन्ति वै द्विजाः\nएतेन सत्यवाक्येन पादः कुम्भस्य पूर्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088502, "chapter_id": 2884, "verse_number": "१३-१४-५x", "content_sanskrit": "सूर्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088503, "chapter_id": 2884, "verse_number": "१३-१४-५", "content_sanskrit": "यथा गोब्राह्मणस्यार्थे न तपामि यथाबलम्।\nएतेन सत्यवाक्येन पादः कुम्भस्य पूर्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088504, "chapter_id": 2884, "verse_number": "१३-१४-६x", "content_sanskrit": "शच्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088505, "chapter_id": 2884, "verse_number": "१३-१४-६", "content_sanskrit": "कर्मणा मनसा वाचा नावमन्ये पुरन्दरम्।\nएतेन सत्यवाक्येन पादः कुम्भस्य पूर्यताम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088506, "chapter_id": 2884, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुर्दशोऽध्यायः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]