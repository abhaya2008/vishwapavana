[{"id": 2130821, "chapter_id": 3822, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2130822, "chapter_id": 3822, "verse_number": "१", "content_sanskrit": "आर्ष्टिषेणाश्रमे तस्मिन् मम पूर्वपितामहाः ।\nपाण्डोः पुत्रा महात्मानः सर्वे दिव्यपराक्रमाः ।\nकियन्तं कालमवसन् पर्वते गन्धमादने \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2130823, "chapter_id": 3822, "verse_number": "", "content_sanskrit": "किं च चक्रुर्महावीर्याः सर्वेऽतिबलपौरुषाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2130824, "chapter_id": 3822, "verse_number": "२", "content_sanskrit": "कानि चाभ्यवहार्याणि तत्र तेषां महात्मनाम् ।\nवसतां लोकवीराणामासंस्तद् ब्रूहि सत्तम\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2130825, "chapter_id": 3822, "verse_number": "३", "content_sanskrit": "विस्तरेण च मे शंस भीमसेनपराक्रमम् ।\nयद्यच्चक्रे महाबाहुस्तस्मिन् हैमवते गिरौ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2130826, "chapter_id": 3822, "verse_number": "४", "content_sanskrit": "न खल्वासीत् पुनर्युद्धं तस्य यक्षैर्द्विजोत्तम ।\nधनदाध्युषिते नित्यं वसतस्तत्र पर्वते \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2130827, "chapter_id": 3822, "verse_number": "५", "content_sanskrit": "कच्चित् समागमस्तेषामासीद् वैश्रवणस्य च ।\nतत्र ह्यायाति धनद आर्ष्टिषेणो यथाऽब्रवीत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2130828, "chapter_id": 3822, "verse_number": "६", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं विस्तरेण तपोधन ।\nन हि मे शृण्वतस्तृप्तिरस्ति तेषां विचेष्टितम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2130829, "chapter_id": 3822, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2130830, "chapter_id": 3822, "verse_number": "७", "content_sanskrit": "एतदात्महितं श्रुत्वा तस्याप्रतिमतेजसः ।\nशासनं सततं चक्रुस्तथैव भरतर्षभाः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2130831, "chapter_id": 3822, "verse_number": "८", "content_sanskrit": "भुञ्जाना मुनिभोज्यानि रसवन्ति फलानि च ।\nशुद्धबाणहतानां च मृगाणां पिशितानि च \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2130832, "chapter_id": 3822, "verse_number": "९", "content_sanskrit": "मेध्यानि हिमवत्पृष्ठे मधूनि विविधानि च ।\nरसायनसमृद्धानि तत्रोषुस्ते स्म भारताः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2130833, "chapter_id": 3822, "verse_number": "१०", "content_sanskrit": "तथा निवसतां तेषां पञ्चमं वर्षमभ्यगात् ।\nशृण्वतां लोमशोक्तानि वाक्यानि विविधान्युत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2130834, "chapter_id": 3822, "verse_number": "११", "content_sanskrit": "कृत्यकाल उपस्थास्य इति चोक्त्वा घटोत्कचः ।\nराक्षसैः सह सर्वैश्च पूर्वमेव गतः प्रभो\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2130835, "chapter_id": 3822, "verse_number": "१२", "content_sanskrit": "आर्ष्टिषेणाश्रमे तेषां वसतां वै महात्मनाम् ।\nअगच्छन् बहवो मासाः पश्यतां महदद्भुतम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2130836, "chapter_id": 3822, "verse_number": "१३", "content_sanskrit": "तैस्तत्र विहरद्भिश्च रममाणैश्च पाण्डवैः ।\nप्रीतिमन्तो महाभागा मुनयश्चारणास्तथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2130837, "chapter_id": 3822, "verse_number": "१४", "content_sanskrit": "आजग्मुः पाण्डवान् द्रष्टुं शुद्धात्मानो यतव्रताः ।\nते तैः सह कथां चक्रुर्दिव्यां भरतसत्तमाः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2130838, "chapter_id": 3822, "verse_number": "१५", "content_sanskrit": "ततः कतिपयाहस्य महाह्रदनिवासिनम् ।\nऋद्धिमन्तं महानागं सुपर्णः सहसाऽऽहरत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2130839, "chapter_id": 3822, "verse_number": "१६", "content_sanskrit": "प्राकम्पत महाशैलः प्रामृद्यन्त महाद्रुमाः ।\nददृशुः सर्वभूतानि पाण्डवाश्च तदद्भुतम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2130840, "chapter_id": 3822, "verse_number": "१७", "content_sanskrit": "ततः शैलोत्तमस्याग्रात् पाण्डवान् प्रति मारुतः ।\nअवहत् सर्वमाल्यानि गन्धवन्ति शुभानि च \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2130841, "chapter_id": 3822, "verse_number": "१८", "content_sanskrit": "तत्र पुष्पाणि दिव्यानि सुहृद्भिः सह पाण्डवाः ।\nददृशुः पञ्चवर्णानि द्रौपदी च यशस्विनी\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2130842, "chapter_id": 3822, "verse_number": "१९", "content_sanskrit": "भीमसेनं ततः कृष्णा काले वचनमब्रवीत् ।\nविविक्ते पर्वतोद्देशे सुखासीनं महाभुजम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2130843, "chapter_id": 3822, "verse_number": "२०", "content_sanskrit": "सुपर्णानिलवेगेन श्वसनेन महाचलात् ।\nपञ्चवर्णानि पात्यन्ते पुष्पाणि भरतर्षभ\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2130844, "chapter_id": 3822, "verse_number": "२१", "content_sanskrit": "दिव्यवर्णानि दिव्यानि दिव्यगन्धवहानि च ।\nमदयन्तीव गन्धेन मनो मे भरतर्षभ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2130845, "chapter_id": 3822, "verse_number": "२२", "content_sanskrit": "येषां तु दर्शनात् स्पर्शात् सौरभ्याच्च तथैव च ।\nनश्यतीव मनोदुःखं ममेदं शत्रुतापन\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2130846, "chapter_id": 3822, "verse_number": "२३", "content_sanskrit": "ईदृशैः कुसुमैर्दिव्यैः दिव्यगन्धवहैः शुभैः ।\nदेवतान्यर्चयित्वाहमिच्छेयं सङ्गमं त्वया\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2130847, "chapter_id": 3822, "verse_number": "२४", "content_sanskrit": "इदं तु पुरुषव्याघ्र विशेषेणाम्बुजं शुभम् ।\nगन्धसंस्थानसम्पन्नं मम मानसवर्धनम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2130848, "chapter_id": 3822, "verse_number": "२५", "content_sanskrit": "वासुदेवसहाय्येन वासुदेवप्रियेण च ।\nखाण्डवे सत्यसन्धेन भ्रात्रा तव महात्मना \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2130849, "chapter_id": 3822, "verse_number": "२६", "content_sanskrit": "गन्धर्वोरगरक्षांसि वासवश्च निवारितः ।\nहता मायाविनश्चोग्रा धनुः प्राप्तं च गाण्डिवम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2130850, "chapter_id": 3822, "verse_number": "२७", "content_sanskrit": "तवापि सुमहत् तेजो महद् बाहुबलं च ते ।\nअविषँह्यमनाधृष्यं शक्रतुल्यबलोपमम्(पराक्रम)\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2130851, "chapter_id": 3822, "verse_number": "२८", "content_sanskrit": "त्वद्बाहुबलवेगेन त्रासिताः सर्वराक्षसाः ।\nहित्वा शैलं प्रपद्यन्तां भीमसेन दिशो दश\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2130852, "chapter_id": 3822, "verse_number": "२९", "content_sanskrit": "ततः शैलोत्तमस्याग्रं चित्रमाल्यधरं शिवम् ।\nव्यपेतभयसम्मोहाः पश्यन्तु सुहृदस्तव \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2130853, "chapter_id": 3822, "verse_number": "", "content_sanskrit": "साशनं सततं कुर्युस्तथैव भरतर्षभ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2130854, "chapter_id": 3822, "verse_number": "३०", "content_sanskrit": "एवं प्रणिहितं भीम चिरात् प्रभृति मे मनः ।\nद्रष्टुमिच्छामि शैलाग्रं त्वद्बाहुबलपालिता\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2130855, "chapter_id": 3822, "verse_number": "३१", "content_sanskrit": "इच्छामि च नरव्याघ्र पुष्पं प्रत्यक्षमीदृशम् ।\nआनीयमानं क्षिप्रं वै त्वया भरतसत्तम \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2130856, "chapter_id": 3822, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2130857, "chapter_id": 3822, "verse_number": "३२", "content_sanskrit": "ततः क्षिप्तमिवात्मानं द्रौपद्या स परन्तपः ।\nनामृष्यत महाबाहुः प्रहारमिव सद्गवः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2130858, "chapter_id": 3822, "verse_number": "३३", "content_sanskrit": "सिंहर्षभगतिः श्रीमानुदारः कनकप्रभः ।\nमनस्वी बलवान् दृप्तो मानी शूरश्च पाण्डवः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2130859, "chapter_id": 3822, "verse_number": "३४", "content_sanskrit": "लोहिताक्षः पृथुव्यंसो मत्तवारणविक्रमः ।\nसिंहदंष्ट्रो बृहत्स्कन्धः शालपोत इवोद्गतः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2130860, "chapter_id": 3822, "verse_number": "३५", "content_sanskrit": "महात्मा चारुसर्वाङ्गः कम्बुग्रीवो महाभुजः ।\nरुग्मपृष्ठं धनुः खड्गं तूणांश्चापि परामृशत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2130861, "chapter_id": 3822, "verse_number": "३६", "content_sanskrit": "स केसरीव चोत्सिक्तः प्रभिन्न इव वारणः ।\nव्यपेतभयसम्मोहः शैलमभ्यपतद् बली\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2130862, "chapter_id": 3822, "verse_number": "३७", "content_sanskrit": "तं मृगेन्द्रमिवायान्तं प्रभिन्नमिव वारणम् ।\nददृशुः सर्वभूतानि बाणकार्मुकधारिणम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2130863, "chapter_id": 3822, "verse_number": "३८", "content_sanskrit": "द्रौपद्या वर्धयन् हर्षं गदामादाय पाण्डवः ।\nव्यपेतभयसम्मोहः शैलराजं समाश्रितः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2130864, "chapter_id": 3822, "verse_number": "३९", "content_sanskrit": "न ग्लानिर्न च कार्तर्यं न वैक्लव्यं न मत्सरः ।\nकदाचिज्जुषते पार्थमात्मजं मातरिश्वनः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2130865, "chapter_id": 3822, "verse_number": "४०", "content_sanskrit": "तदेकायनमासाद्य विषमं भीमदर्शनम् ।\nबहुतालोच्छ्रयं शृङ्गमारुरोह महाबलः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2130866, "chapter_id": 3822, "verse_number": "४१", "content_sanskrit": "सकिन्नरमहानागमुनिगन्धर्वराक्षसान् ।\nहर्षयन् पर्वतस्याग्रमारुह्य स महाबलः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2130867, "chapter_id": 3822, "verse_number": "४२", "content_sanskrit": "ततो वैश्रवणावासं ददर्श भरतर्षभः ।\nकाञ्चनैः स्फाटिकैश्चैव वेश्मभिः समलङ्कृतम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2130868, "chapter_id": 3822, "verse_number": "४३", "content_sanskrit": "प्राकारेण परिक्षिप्तं सौवर्णेन समन्ततः ।\nसर्वरत्नद्युतिमता सर्वोद्यानवता तथा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2130869, "chapter_id": 3822, "verse_number": "", "content_sanskrit": "शैलादभ्युच्छ्रयवता चयाट्टालकशोभिना ।\nद्वारतोरणनिर्व्यूहध्वजसंवाहशोभिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2130870, "chapter_id": 3822, "verse_number": "", "content_sanskrit": "विलासिनीभिरत्यर्थं नृत्यन्तीभिः समन्ततः ।\nवायुना धूयमानाभिः पताकाभिरलङ्कृतम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2130871, "chapter_id": 3822, "verse_number": "", "content_sanskrit": "धनुष्कोटिमवष्टभ्य वक्रभावेन बाहुना ।\nपश्यमानः स खेदेन द्रविणाधिपतेः पुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2130872, "chapter_id": 3822, "verse_number": "", "content_sanskrit": "मोदयन् सर्वभूतानि गन्धमादनसम्भवः ।\nसर्वगन्धवहस्तत्र मारुतः सुसुखो ववौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2130873, "chapter_id": 3822, "verse_number": "४४", "content_sanskrit": "चित्रा विविधवर्णाभाश्चित्रमञ्जरिधारिणः ।\nअचिन्त्या विविधास्तत्र द्रुमाः परमशोभिनः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2130874, "chapter_id": 3822, "verse_number": "४५", "content_sanskrit": "रत्नजालपरिक्षिप्तं चित्रमाल्यविभूषितम् ।\nराक्षसाधिपतेः स्थानं ददृशे भरतर्षभः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2130875, "chapter_id": 3822, "verse_number": "४६", "content_sanskrit": "गदाखड्गधनुष्पाणिः समभित्यक्तजीवितः ।\nभीमसेनो महाबाहुस्तस्थौ गिरिरिवाचलः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2130876, "chapter_id": 3822, "verse_number": "४७", "content_sanskrit": "ततः शङ्खमुपाध्मासीद् द्विषतां लोमहर्षणम् ।\nज्याघोषतळशब्दं च कृत्वा भूतान्यमोहयत्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2130877, "chapter_id": 3822, "verse_number": "४८", "content_sanskrit": "ततः प्रहृष्टरोमाणस्तं शब्दमभिदुद्रुवुः ।\nयक्षराक्षसगन्धर्वाः पाण्डवस्य समीपतः \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2130878, "chapter_id": 3822, "verse_number": "४९", "content_sanskrit": "गदापरिघनिस्त्रिंशशूलशक्तिपरश्वधाः ।\nप्रगृहीता व्यरोचन्त यक्षराक्षसबाहुभिः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2130879, "chapter_id": 3822, "verse_number": "५०", "content_sanskrit": "ततः प्रववृते युद्धं तेषां तस्य च भारत ।\nसंरब्धानां महाघोषं सिंहानामिव नर्दताम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2130880, "chapter_id": 3822, "verse_number": "५१", "content_sanskrit": "तै प्रयुक्तान् महामायैः शूलशक्तिपरश्वधान् ।\nभल्लैर्भीमः प्रचिच्छेद भीमवेगतरैस्ततः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2130881, "chapter_id": 3822, "verse_number": "५२", "content_sanskrit": "अन्तरिक्षगतानां च भूमिष्ठानां च गर्जताम् ।\nशरैर्विव्याध गात्राणि राक्षसानां महाबलः \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2130882, "chapter_id": 3822, "verse_number": "५३", "content_sanskrit": "शोणितस्य ततः पेतुर्घनानामिव भारत ।\nगात्रेभ्यः प्रत्युत धाराः राक्षसानां समन्ततः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2130883, "chapter_id": 3822, "verse_number": "५४", "content_sanskrit": "सा लोहितमहावृष्टिरभ्यवर्षन्महाबलम् ।\nकायेभ्यः प्रच्युता धारा राक्षसानां समन्ततः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2130884, "chapter_id": 3822, "verse_number": "५५", "content_sanskrit": "गदापरिघपाणीनां रक्षसां कायसम्भवाः \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2130885, "chapter_id": 3822, "verse_number": "५६", "content_sanskrit": "भीमबाहुबलोत्सृष्टैरायुधैर्यक्षरक्षसाम् ।\nविनिकृत्तानि दृश्यन्ते शरीराणि शिरांसि च \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2130886, "chapter_id": 3822, "verse_number": "५७", "content_sanskrit": "प्रच्छाद्यमानं रक्षोभिः पाण्डवं प्रियदर्शनम् ।\nददृशुः सर्वभूतानि सूर्यमभ्रगणैरिव \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2130887, "chapter_id": 3822, "verse_number": "५८", "content_sanskrit": "स रश्मिभिरिवादित्यः शरैररिनिघातिभिः ।\nसर्वानार्च्छन् महाबाहुर्बलवान् सत्यविक्रमः \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2130888, "chapter_id": 3822, "verse_number": "५९", "content_sanskrit": "अभितर्जयमानाश्च रुवन्तश्च महारवान् ।\nन मोहं भीमसेनस्य ददृशुः सर्वराक्षसाः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2130889, "chapter_id": 3822, "verse_number": "६०", "content_sanskrit": "यक्षा विकृतसर्वाङ्गा भीमसेनभयार्दिताः ।\nभीममार्तस्वरं चक्रुर्विप्रकीर्णमहायुधाः \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2130890, "chapter_id": 3822, "verse_number": "६१", "content_sanskrit": "उत्सृज्य ते गदाशूलानसिशक्तिपरश्वधान् ।\nदक्षिणां दिशमाजग्मुस्त्रासिता दृढधन्वना\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2130891, "chapter_id": 3822, "verse_number": "६२", "content_sanskrit": "तत्र शूलगदापाणिर्व्यूढोरस्को महाभुजः ।\nसखा वैश्रवणस्यासीत् मणिमान्नाम राक्षसः \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2130892, "chapter_id": 3822, "verse_number": "६३", "content_sanskrit": "आदर्शयत् प्रतीकारं पौरुषं च महाबलः ।\nस तान् दृष्ट्वा परावृत्तान् स्मयमान इवाब्रवीत्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2130893, "chapter_id": 3822, "verse_number": "६४", "content_sanskrit": "एकेन बहवः सङ्खे मानुषेण पराजिताः ।\nप्राप्य वैश्रवणावासं किं वक्ष्यथ धनेश्वरम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2130894, "chapter_id": 3822, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2130895, "chapter_id": 3822, "verse_number": "६५", "content_sanskrit": "एवमाभाष्य तान्सर्वानभ्यवर्तत राक्षसः ।\nशक्तिशूलगदापाणिरभ्यधावत् स पाण्डवम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2130896, "chapter_id": 3822, "verse_number": "६६", "content_sanskrit": "तमापतन्तं वेगेन प्रभिन्नमिव वारणम् ।\nवत्सदन्तैस्त्रिभिः पार्श्वे भीमसेनः समार्दयत्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2130897, "chapter_id": 3822, "verse_number": "६७", "content_sanskrit": "मणिमानपि सङ्क्रुद्धः प्रगृह्य महतीं गदाम् ।\nप्राहिणोद् भीमसेनाय परिगृह्य महाबलः \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2130898, "chapter_id": 3822, "verse_number": "६८", "content_sanskrit": "विद्युद्रूपां महाघोरामाकाशे महतीं गदाम् ।\nशरैर्बहुभिरभ्यार्च्छद् भीमसेनः शिलाशितैः \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2130899, "chapter_id": 3822, "verse_number": "६९", "content_sanskrit": "प्रत्यहन्यन्त ते सर्वे गदामासाद्य सायकाः ।\nन वेगं धारयामासुर्गदावेगस्य वेगिताः \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2130900, "chapter_id": 3822, "verse_number": "७०", "content_sanskrit": "गदायुद्धसमाचारं बुद्ध्यमानः स वीर्यवान् ।\nव्यंसयामास तं तस्य प्रहारं भीमविक्रमः \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2130901, "chapter_id": 3822, "verse_number": "७१", "content_sanskrit": "ततः शक्तिं महाघोरां रुग्मदण्डामयस्मयीम् ।\nतस्मिन्नेवान्तरे धीमान् प्रजहाराथ राक्षसः \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2130902, "chapter_id": 3822, "verse_number": "७२", "content_sanskrit": "सा भुजं भीमनिर्ह्रादा भित्त्वा भीमस्य दक्षिणम् ।\nसाग्निज्वाला महारौद्रा पपात सहसा भुवि\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2130903, "chapter_id": 3822, "verse_number": "७३", "content_sanskrit": "सोऽतिविद्धो महेष्वासः शक्त्याऽमितपराक्रमः ।\nगदां जग्राह कौन्तेयः क्रोधपर्याकुलेक्षणः \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2130904, "chapter_id": 3822, "verse_number": "७४", "content_sanskrit": "रुग्मपट्टपिनद्धां तां शत्रूणां भयवर्धिनीम् ।\nप्रगृह्याथ नदन् भीमः सर्वशैक्यायसीं गदाम् ।\nतरसा चाभिदुद्राव मणिमन्तं महाबलम्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2130905, "chapter_id": 3822, "verse_number": "७५", "content_sanskrit": "दीप्यमानं महाशूलं प्रगृह्य मणिमानपि ।\nप्राहिणोद् भीमसेनाय वेगेन महता नदन्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2130906, "chapter_id": 3822, "verse_number": "७६", "content_sanskrit": "भङ्क्त्वा शूलं गदाग्रेण गदायुद्धविशारदः ।\nअभिदुद्राव तं हन्तुं गरुत्मानिव पन्नगम्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2130907, "chapter_id": 3822, "verse_number": "७७", "content_sanskrit": "सोऽन्तरिक्षमवप्लुत्य विधूय सहसा गदाम् ।\nप्रचिक्षेप महाबाहुर्विनद्य रणमूर्धनि\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2130908, "chapter_id": 3822, "verse_number": "", "content_sanskrit": "ततस्तं गदया भीमो मणिमन्तं निशाचरम् ।\nजघान सहसा मूर्ध्नि स पपात ममार च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2130909, "chapter_id": 3822, "verse_number": "७८", "content_sanskrit": "सेन्द्राशनिरिवेन्द्रेण विसृष्टा वातरंहसा ।\nहत्वा रक्षः क्षितिं प्राप्य कृत्येव निपपात ह \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2130910, "chapter_id": 3822, "verse_number": "७९", "content_sanskrit": "तं राक्षसं भीमबलं भीमसेनेन पातितम् ।\nददृशुः सर्वभूतानि सिंहेनेव गवां पतिम्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2130911, "chapter_id": 3822, "verse_number": "८०", "content_sanskrit": "तं प्रेक्ष्य निहतं भूमौ हतशेषा निशाचराः ।\nभीममार्तस्वरं कृत्वा जग्मुः प्राचीं दिशं प्रति\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2130912, "chapter_id": 3822, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2130913, "chapter_id": 3822, "verse_number": "१५६", "content_sanskrit": "षट्पञ्चाशदधिकशततमोऽध्यायः ॥ १५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2130914, "chapter_id": 3822, "verse_number": "३", "content_sanskrit": "यक्षयुद्धपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2130915, "chapter_id": 3822, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]