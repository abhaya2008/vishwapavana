[{"id": 2034742, "chapter_id": 1749, "verse_number": "४-७२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2034743, "chapter_id": 1749, "verse_number": "४-७२-१", "content_sanskrit": "सभाज्यमानः पौरैश्च स्त्रीभिर्जानपदैरपि।\nआसाद्यान्तःपुरद्वारं पित्रे संप्रत्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2034744, "chapter_id": 1749, "verse_number": "४-७२-२", "content_sanskrit": "ततो द्वाःस्थः समासाद्य प्रणिपत्य कृताञ्जलिः ।\nवर्धयित्वा जयाशीर्भिरिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2034745, "chapter_id": 1749, "verse_number": "४-७२-३", "content_sanskrit": "राजन्पृथुयशस्तुभ्यं जित्वा शत्रून्समागतः।\nउत्तरः सह सूतेन द्वारि तिष्ठति वारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2034746, "chapter_id": 1749, "verse_number": "४-७२-४", "content_sanskrit": "कुमारो योधमुख्यैस्च गणिकाभिस्च संवृतः ।\nपौरजानपदैर्युक्तः पूज्यमानो जयाशिषाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2034747, "chapter_id": 1749, "verse_number": "४-७२-५", "content_sanskrit": "ततो हृष्टो महीपालः क्षत्तारमिदमब्रवीत् ।\nप्रवेशयोभौ तौ तूर्णं दर्शनेप्सुरहं तयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2034748, "chapter_id": 1749, "verse_number": "४-७२-६", "content_sanskrit": "क्षत्तारं कुरुराजस्तु शनैः कर्ण उपाजपत्।\nउत्तरः प्रविशत्वेको न प्रवेश्या बृहन्नलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2034749, "chapter_id": 1749, "verse_number": "४-७२-७", "content_sanskrit": "तस्य हि महाबाहोर्व्रतं नित्यं महात्मनः।\nयो ममाङ्गे व्रणं कुर्याच्छोणितं वा प्रदर्शयेत्।\nअन्यत्र संग्रामगतान्न स जीवेत्कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2034750, "chapter_id": 1749, "verse_number": "४-७२-८", "content_sanskrit": "व्यक्तं भृसं सुसंक्रुद्धो मां दृष्ट्वैव सशोणितम्।\nविराटमिह सामात्यं हन्यात्सबलावाहनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2034751, "chapter_id": 1749, "verse_number": "४-७२-९", "content_sanskrit": "इन्द्रं वापि कुबेरं वा यमं वा वरुणं तथा।\nमम शोणितकर्तारं मृद्गीयात्किं पुनर्नरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2034752, "chapter_id": 1749, "verse_number": "४-७२-१०", "content_sanskrit": "क्षणमात्रं तु तत्रैव द्वारि तिष्ठतु वीर्यवान् ।\nइति प्रोवाच धर्मात्मा युधिष्ठिर उदारधीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2034753, "chapter_id": 1749, "verse_number": "४-७२-११", "content_sanskrit": "इत्युक्त्वा क्षमया युक्तो धर्मराजो घृणान्वितः।\nसभायां सह मात्स्येन तूष्णीमुपविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2034754, "chapter_id": 1749, "verse_number": "४-७२-१२", "content_sanskrit": "ततो राजसुतो ज्येष्ठः प्राविशत्पृथिवींजयः।\nववन्दे स पितुः पादौ कङ्कं चाप्युपतिष्ठत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2034755, "chapter_id": 1749, "verse_number": "४-७२-१३", "content_sanskrit": "पश्यन्युधिष्ठिरं दृष्ट्या वक्रया चरणौ पितुः।\nअभिवाद्य ततो दृष्ट्वा कङ्कस्य रुधिरप्लुतम् ।\nहृदयेऽदह्यत तदा मृत्युग्रस्त इवोत्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2034756, "chapter_id": 1749, "verse_number": "४-७२-१४", "content_sanskrit": "ततो रुधिरसिक्ताङ्गमनेकाग्रमनागसम्।\nभूमावेकान्त आसीनं सैरन्ध्र्या समुपासितम्।\nततः पप्रच्छ राजानं त्वरमाण इवोत्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2034757, "chapter_id": 1749, "verse_number": "४-७२-१५", "content_sanskrit": "केनायं ताडितः कङ्कः केन पापमिदं कृतम्।\nको वा जिगमिषुर्मृत्युं केन स्पृष्टः पदोरगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2034758, "chapter_id": 1749, "verse_number": "४-७२-१६", "content_sanskrit": "श्रोत्रियो ब्राह्मणश्रेष्ठ इन्द्रासनरतिक्षमः।\nपूजनीयोऽभिवाद्यश्च न प्रबाध्योऽयमीदृशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2034759, "chapter_id": 1749, "verse_number": "४-७२-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2034760, "chapter_id": 1749, "verse_number": "४-७२-१७", "content_sanskrit": "स पुत्रस्य वचः श्रुत्वा विराटो राष्ट्रवर्धनः।\nप्रत्युवाचोत्तरं वाक्यं साध्वसाद्ध्वस्तमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2034761, "chapter_id": 1749, "verse_number": "४-७२-१८", "content_sanskrit": "पुत्र ते विजयं श्रुत्वा प्रहृष्टोऽहं मुदा भृशम्।\nअक्षक्रीडनयाऽनेन कालक्षेपमकारिषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2034762, "chapter_id": 1749, "verse_number": "४-७२-१९", "content_sanskrit": "तत्राजयत्कुरून्सर्वानुत्तरो राष्ट्रवर्धनः।\nइत्युक्तं हि मया पुत्र नेति कङ्को बृहन्नला।\nअजयत्सा कुरून्सर्वानिति मामब्रवीन्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2034763, "chapter_id": 1749, "verse_number": "४-७२-२०", "content_sanskrit": "प्रशंसिते मया पुत्र विजये तव विश्रुते।\nबृहन्नलाया विजयं कङ्कोऽस्तुवत वै रुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2034764, "chapter_id": 1749, "verse_number": "४-७२-२१", "content_sanskrit": "मया प्रशस्यमाने तु त्वयि पण्डं प्रशंसति।\nबृहन्नलाप्रशंसाभिरभ्यसूयमहं तदा।\nताडितोऽयं मया पुत्र दुरात्मा शत्रुपक्षकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2034765, "chapter_id": 1749, "verse_number": "४-७२-२२", "content_sanskrit": "ताडितोऽयं यतिः कङ्क इत्युक्तं तद्वचोत्तरः।\nश्रुत्वा पितुर्भृशं क्रुद्धः पितरं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2034766, "chapter_id": 1749, "verse_number": "४-७२-२३", "content_sanskrit": "अकार्यं ते कृतं राजन्क्षिप्रमेष प्रसाद्यताम्।\nमा त्वा ब्रह्मविषं घोरं समूलमुपनिर्दहेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2034767, "chapter_id": 1749, "verse_number": "४-७२-२४", "content_sanskrit": "यावन्न क्षयमायाति कुलं सर्वमशेषनः।\nस्फीतं वृद्धं च मात्स्यानामयं तावत्प्रसाद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2034768, "chapter_id": 1749, "verse_number": "४-७२-२५", "content_sanskrit": "प्रणम्य पादयोरस्य दण्डवत्क्षितिमण्डले ।\nप्रगृह्य पादौ पाणिभ्यामयं तावत्प्रसाद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2034769, "chapter_id": 1749, "verse_number": "४-७२-२६", "content_sanskrit": "दक्षेण पाणिना स्पृष्ट्वा शपे त्वां क्षपितं मया।\nइति यावद्वदेत्कङ् अयं तावत्प्रसाद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2034770, "chapter_id": 1749, "verse_number": "४-७२-२७", "content_sanskrit": "स पुत्रस्य वचः श्रुत्वा विराटः साध्वसाकुलः।\nक्षमयामास कौन्तेयं छन्नं ब्राह्मणवर्चसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2034771, "chapter_id": 1749, "verse_number": "४-७२-२८", "content_sanskrit": "क्षमयन्तं तु राजानं पाण्डवः प्रत्यभाषत।\nचिरं क्षान्तं मया राजन्मन्युर्मम न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2034772, "chapter_id": 1749, "verse_number": "४-७२-२९", "content_sanskrit": "यदि स्म तत्पतेद्भूमौ रुधिरं मम पार्थिव ।\nसराष्ट्रस्त्वमिहोच्छेदमापद्येथा नरर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2034773, "chapter_id": 1749, "verse_number": "४-७२-३०", "content_sanskrit": "न दूषयामि राजेन्द्र यस्तु हन्याददूषकम्।\nफलं तस्य महाराज क्षिप्रं दारुणमाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2034774, "chapter_id": 1749, "verse_number": "४-७२-३१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2034775, "chapter_id": 1749, "verse_number": "४-७२-३१", "content_sanskrit": "शोणिते तु व्यतिक्रान्ते प्रविवेश बृहन्नला।\nअभिवाद्य महाराजं कङ्कं चाप्युपतिष्ठत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2034776, "chapter_id": 1749, "verse_number": "४-७२-३२", "content_sanskrit": "क्षमयित्वा तु कौरव्यं रणादुत्तरमागतम् ।\nपरिष्वज्य दृढं राजा प्रवेश्य भवनोत्तमम्।\nप्रशशंस ततो मात्स्यः शृण्वतः सव्यसाचिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2034777, "chapter_id": 1749, "verse_number": "४-७२-३३x", "content_sanskrit": "विराट उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2034778, "chapter_id": 1749, "verse_number": "४-७२-३३", "content_sanskrit": "त्वया दायादवानस्मि कैकेयीनन्दिवर्धन।\nत्वया मे सदृशः पुत्रो न भूतो न भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2034779, "chapter_id": 1749, "verse_number": "४-७२-३४", "content_sanskrit": "पदं पदसहस्रेण यश्चरन्नापराध्नुयात्।\nतेन कर्णेन ते तात कथमासीत्समागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2034780, "chapter_id": 1749, "verse_number": "४-७२-३५", "content_sanskrit": "रणे यं प्रेक्ष्य सीदन्ति हृतवीर्यपराक्रमाः।\nकृपेन तेन ते तात कथमासीत्समागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2034781, "chapter_id": 1749, "verse_number": "४-७२-३६", "content_sanskrit": "यस्य तद्विश्रुतं लोके महद्वृत्तमनुत्तमम् ।\nपितुः कृते कृतं घोरं ब्रह्मचर्यमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2034782, "chapter_id": 1749, "verse_number": "४-७२-३७", "content_sanskrit": "योऽयोधीत्समरे रामं जामदग्न्यं प्रतापिनम्।\nभीष्मोसौ पुरुषव्याघ्र न च युद्धे पराजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2034783, "chapter_id": 1749, "verse_number": "४-७२-३८", "content_sanskrit": "पराक्रमी च दुर्धर्षो विद्वाञ्शूरो जितेन्द्रियः।\nदृढवेधी क्षिप्रकारी विश्रुतः सर्वकर्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2034784, "chapter_id": 1749, "verse_number": "४-७२-३९", "content_sanskrit": "तेन ते सह भीष्मेण कुरुवृद्धेन संयुगे ।\nयुद्धमासीत्कथं तात सर्वमेतद्ब्रवीहि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2034785, "chapter_id": 1749, "verse_number": "४-७२-४०", "content_sanskrit": "पर्वतं यो विनिर्भिन्द्याद्राजपुत्रो वरेषुभिः।\nदुर्योधनेन ते तात कथमासीत्समागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2034786, "chapter_id": 1749, "verse_number": "४-७२-४१", "content_sanskrit": "आचार्यो वृष्णिरीराणां पाञ्चालानां च यः प्रभुः।\nकुरूणां पाण्डवानां च सर्वक्षत्रस्य यो गुरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2034787, "chapter_id": 1749, "verse_number": "४-७२-४२", "content_sanskrit": "सर्वशस्त्रभृतां श्रेष्ठः सर्वलोकेषु विश्रुतः।\nतेन द्रोणेन ते तात कथमासीत्समागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2034788, "chapter_id": 1749, "verse_number": "४-७२-४३", "content_sanskrit": "आचार्यपुत्रो यः शूरो द्रोणादनवमो रणे।\nतेन वीरेण ते तात कथमासीत्समागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2034789, "chapter_id": 1749, "verse_number": "४-७२-४४", "content_sanskrit": "सर्वे चैव महावीर्या धार्तराष्ट्रः महारथाः ।\nतैस्तैर्वीरैश्च ते तात कथमासीत्समागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2034790, "chapter_id": 1749, "verse_number": "४-७२-४५x", "content_sanskrit": "उत्तर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2034791, "chapter_id": 1749, "verse_number": "४-७२-४५", "content_sanskrit": "न मया निर्जिता गावो न मया कुरवो जिताः।\nकृतं च कर्म तत्सर्वं देवपुत्रेण केनचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2034792, "chapter_id": 1749, "verse_number": "४-७२-४६", "content_sanskrit": "स हि भीतं द्रवन्तं मां भीष्मद्रोणमुखान्कुरून्।\nदृष्ट्वा विषण्णं संग्रामे देवपुत्रो न्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2034793, "chapter_id": 1749, "verse_number": "४-७२-४७", "content_sanskrit": "स हि तिष्ठन्रथोपस्थे वज्रपाणिनिभो युवा।\nतेन ते निर्जिता गावस्तेन ते कुरवो जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2034794, "chapter_id": 1749, "verse_number": "४-७२-४८", "content_sanskrit": "तस्य तत्कर्म वीरस्य न मया तात तत्कृतम् ।\nस हि शारद्वतं द्रोणं द्रोणपुत्रं च वीर्यवान् ।ट\nसूतपुत्रं च भीष्मं च चकार विमुखाञ्शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2034795, "chapter_id": 1749, "verse_number": "४-७२-४९", "content_sanskrit": "दुर्योदनं च समरे प्रभिन्नमिव कुञ्जरम्।\nप्रभग्नमब्रवीद्भीतं राजपुत्रं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2034796, "chapter_id": 1749, "verse_number": "४-७२-५०", "content_sanskrit": "न हास्तिनपुरे त्राणं तव पश्यामि किंचन।\nन हास्तिनपुरे भोगा भोक्तुं शक्याः पलायता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2034797, "chapter_id": 1749, "verse_number": "४-७२-५१", "content_sanskrit": "व्यायामेन परीप्सस्व जीवितं कौरवात्मज ।\nन मोक्ष्यसे पलायंस्त्वं लोके युद्धमना भव।\nपृथिवीं भोक्ष्यसे जित्वा हतो वा स्वर्गमाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2034798, "chapter_id": 1749, "verse_number": "४-७२-५२", "content_sanskrit": "स निवृत्तो नरव्याघ्रो मुञ्चन्वज्रनिभाञ्शरान्।\nसचिवैः संवृतो राजा भीष्मद्रोणकृपादिभिः ।\nततो मे रोमहर्षोऽभूदूरुस्तम्भश्च मेऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2034799, "chapter_id": 1749, "verse_number": "४-७२-५३", "content_sanskrit": "यदभूद्धनसंकाशमनीकं व्यधमच्छरैः।\nतत्प्रपुद्य रथानीकं सिंहदर्पसमो युवा।\nतान्कुरुन्द्रावयद्राजन्रणे नाग इव श्वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2034800, "chapter_id": 1749, "verse_number": "४-७२-५४", "content_sanskrit": "एकेन तेन शूरेण षड्रथाः परिनिर्जिताः ।\nशार्दूलेनेव मत्तेन मृगास्तृणचरा यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2034801, "chapter_id": 1749, "verse_number": "४-७२-५५", "content_sanskrit": "हयानां च गजानां च शूराणां च धनुष्मताम्।\nनिहतानि सहस्राणि भग्ना च कुरुवाहिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2034802, "chapter_id": 1749, "verse_number": "४-७२-५६", "content_sanskrit": "सूतपुत्रं शतैर्विद्ध्वा हयान्हत्वा महारथः ।\nअस्त्रेण मोहयित्वा तं रक्तवस्त्रं समाददे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2034803, "chapter_id": 1749, "verse_number": "४-७२-५७", "content_sanskrit": "चतुर्भिः पुनरानर्च्छद्भीष्मं शान्तनवं शरैः।\nस तं विद्ध्वा हयांश्चाशु नास्य वस्त्रं समाददे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2034804, "chapter_id": 1749, "verse_number": "४-७२-५८", "content_sanskrit": "दुर्योधनं च बलवान्बाणैर्विव्याध सप्तभिः।\nतं स विद्ध्वा हयांश्चास्य पीतवस्त्रं समाददे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2034805, "chapter_id": 1749, "verse_number": "४-७२-५९", "content_sanskrit": "द्रोणं कृपं च बलवान्सोमदत्तं जयद्रथम्।\nभूरिश्रवसमिन्द्राभं शकुनिं च महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2034806, "chapter_id": 1749, "verse_number": "४-७२-६०", "content_sanskrit": "त्रिभिस्त्रिभिः स विद्ध्वा तु दुःशासनमुखानपि।\nविविधानि च वस्त्राणि महार्हाण्याजहार सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2034807, "chapter_id": 1749, "verse_number": "४-७२-६१", "content_sanskrit": "द्वाभ्यां शराभ्यां विद्ध्वाऽथ तथाऽऽचार्यसुतं रणे।\nचापं छित्त्वा विकर्णस्य नीले चादत्त वाससी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2034808, "chapter_id": 1749, "verse_number": "४-७२-६२x", "content_sanskrit": "विराट उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2034809, "chapter_id": 1749, "verse_number": "४-७२-६२", "content_sanskrit": "क्व स वीरो महाबाहुर्देवपुत्रो महायशाः।\nयो ममामोचयत्पुत्रं कुरुभिर्ग्रस्तमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2034810, "chapter_id": 1749, "verse_number": "४-७२-६३", "content_sanskrit": "इच्छामि तममित्रघ्नं दुष्टुमर्चितुमेव च।\nयेन मे त्वं च गावश्च मोक्षिता देवसूनुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2034811, "chapter_id": 1749, "verse_number": "४-७२-६४", "content_sanskrit": "तस्मै दास्यामि तां पुत्रीं ग्रामांश्चैव तु हाटकान्।\nस्फुरितं कटिसूत्रं च स्त्रीसहस्रशतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2034812, "chapter_id": 1749, "verse_number": "४-७२-६५x", "content_sanskrit": "उत्तर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2034813, "chapter_id": 1749, "verse_number": "४-७२-६५", "content_sanskrit": "अन्तर्धानं गतस्तात देवपुत्रः प्रतापवान्।\nअद्य श्वो वा परश्वो वा मन्ये प्रादुर्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2034814, "chapter_id": 1749, "verse_number": "४-७२-६६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2034815, "chapter_id": 1749, "verse_number": "४-७२-६६", "content_sanskrit": "एवमाख्यायमानस्तु छन्नं सत्रेण पाण्डवम्।\nवसन्तं तं तु नाज्ञासीद्विराटः पार्थमर्जुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2034816, "chapter_id": 1749, "verse_number": "४-७२-६७", "content_sanskrit": "ततः पार्थोऽभ्यनुज्ञातो विराटेन महात्मना।\nसह पुत्रेण मात्स्यस्य मन्त्रयित्वा धनंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2034817, "chapter_id": 1749, "verse_number": "४-७२-६८", "content_sanskrit": "इत्येवं ब्रूहि राजानं विराटं समुपस्थितम्।\nइत्युक्त्वा सहसा पार्थः प्रविश्यान्तःपुरं शुभम्।\nददौ वस्त्राणि रन्तानि विराटदुहितुः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2034818, "chapter_id": 1749, "verse_number": "४-७२-६९", "content_sanskrit": "उत्तरा तु महार्हाणि वस्त्राण्याभरणानि च।\nप्रगृह्य तानि सर्वाणि प्रीता सानुचराऽभवत् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2034819, "chapter_id": 1749, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि द्विसप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]