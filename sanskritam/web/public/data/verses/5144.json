[{"id": 2194896, "chapter_id": 5144, "verse_number": "", "content_sanskrit": "नागः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2194897, "chapter_id": 5144, "verse_number": "१", "content_sanskrit": "अथ ब्राह्मणरूपेण कं तं समनुपश्यसि ।\nमानुषं केवलं विप्रं देवं वाथ शुचिस्मिते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2194898, "chapter_id": 5144, "verse_number": "२", "content_sanskrit": "को हि मां मानुषः शक्तो द्रष्टुकामो यशस्विनि ।\nसंदर्शनरुचिर्वाक्यमाज्ञापूर्वं वदिष्यति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2194899, "chapter_id": 5144, "verse_number": "३", "content_sanskrit": "सुरासुरगणानां च देवर्षीणां च भामिनि ।\nननु नागा महावीर्याः सौरसेयास्तरस्विनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2194900, "chapter_id": 5144, "verse_number": "४", "content_sanskrit": "वन्दनीयाश्च वरदा वयमप्यनुयायिनः ।\nमनुष्याणां विशेषेण नावेक्ष्या इति मे मतिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2194901, "chapter_id": 5144, "verse_number": "", "content_sanskrit": "नागभार्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2194902, "chapter_id": 5144, "verse_number": "५", "content_sanskrit": "आर्जवेनाभिजानामि नासौ देवोऽनिलाशन ।\nएकं त्वस्य विजानामि भक्तिमानतिरोषण\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2194903, "chapter_id": 5144, "verse_number": "६", "content_sanskrit": "स हि कार्यान्तराकाङ्क्षी जलेप्सुः स्तोकको यथा ।\nवर्षं वर्षप्रियः पक्षी दर्शनं तव काङ्क्षति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2194904, "chapter_id": 5144, "verse_number": "७", "content_sanskrit": "न हि त्वा दैवतं किञ्चिद् विविग्नं प्रतिपालयेत् ।\nतुल्ये ह्यभिजने जातो न कश्चित् पर्युपासते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2194905, "chapter_id": 5144, "verse_number": "८", "content_sanskrit": "तद्रोषं सहजं त्यक्त्वा त्वमेनं द्रष्टुमर्हसि ।\nआशाछेदेन तस्याद्य नात्मानं दग्धुमर्हसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2194906, "chapter_id": 5144, "verse_number": "९", "content_sanskrit": "आशया त्वभिपन्नानामकृत्वाश्रुप्रमार्जनम् ।\nराजा वा राजपुत्रो वा भ्रूणहत्यैव युज्यते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2194907, "chapter_id": 5144, "verse_number": "१०", "content_sanskrit": "मौनाज्ज्ञानफलावाप्तिर्दानेन च यशो महत् ।\nवाग्मित्वं सत्यवाक्येन परत्र च महीयते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2194908, "chapter_id": 5144, "verse_number": "११", "content_sanskrit": "भूमिप्रदानेन गतिं लभत्याश्रमसम्मिताम् ।\nनष्टस्यार्थस्य सम्प्राप्तिं कृत्वा फलमुपाश्नुते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2194909, "chapter_id": 5144, "verse_number": "१२", "content_sanskrit": "अभिप्रेतामसङ्क्लिष्टां कृत्वाकामवतीं क्रियाम् ।\nन याति निरयं कश्चिदिति धर्मविदो विदुः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2194910, "chapter_id": 5144, "verse_number": "", "content_sanskrit": "नागः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2194911, "chapter_id": 5144, "verse_number": "१३", "content_sanskrit": "अभिमानेन मानो मे जातिदोषेण वै महान् ।\nरोषः सङ्कल्पजः साध्वि दग्धो वाचाग्निना त्वया\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2194912, "chapter_id": 5144, "verse_number": "१४", "content_sanskrit": "न च रोषादहं साध्वि पश्येयमधिकं तमः ।\nयस्य वक्तव्यतां यान्ति विशेषेण भुजङ्गमाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2194913, "chapter_id": 5144, "verse_number": "१५", "content_sanskrit": "रोषस्य हि वशं गत्वा दशग्रीवः प्रतापवान् ।\nतथा शक्रप्रतिस्पर्धी हतो रामेण संयुगे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2194914, "chapter_id": 5144, "verse_number": "१६", "content_sanskrit": "अन्तःपुरगतं वत्सं श्रुत्वा रामेण निर्हृतम् ।\nधर्षणाद्रोषसंविग्नाः कार्तवीर्यसुता हताः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2194915, "chapter_id": 5144, "verse_number": "१७", "content_sanskrit": "जामदग्न्येन रामेण सहस्रनयनोपमः ।\nसंयुगे निहतो रोषात् कार्तवीर्यो महाबलः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2194916, "chapter_id": 5144, "verse_number": "१८", "content_sanskrit": "तदेष तपसां शत्रुः श्रेयसश्च निपातनः ।\nनिगृहीतो मया रोषः श्रुत्वैव वचनं तव\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2194917, "chapter_id": 5144, "verse_number": "१९", "content_sanskrit": "आत्मानं च विशेषेण प्रशंसाम्यनपायिनि ।\nयस्य मे त्वं विशालाक्षि भार्या सर्वगुणान्विता\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2194918, "chapter_id": 5144, "verse_number": "२०", "content_sanskrit": "एष तत्रैव गच्छामि यत्र तिष्ठत्यसौ द्विजः ।\nसर्वथा चोक्तवान् वाक्यं नाकृतार्थः प्रयास्यति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2194919, "chapter_id": 5144, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे त्रिनवत्युत्तरशततमोऽध्यायः ॥१९३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]