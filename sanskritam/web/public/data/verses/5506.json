[{"id": 2210771, "chapter_id": 5506, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2210772, "chapter_id": 5506, "verse_number": "१", "content_sanskrit": "श्रुत्वैवं सात्विकं दानं राजसं तामसं तथा ।\nपृथक् पृथक् फलं चैव गतिं चापि पृथक् पृथक् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2210773, "chapter_id": 5506, "verse_number": "२", "content_sanskrit": "अवितृप्तः प्रहृष्टात्मा पुण्यं धर्मामृतं पुनः ।\nयुधिष्ठिरो धर्मनित्यः केशवं पुनरब्रवीत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2210774, "chapter_id": 5506, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2210775, "chapter_id": 5506, "verse_number": "३", "content_sanskrit": "बीजयोनिविशुद्धानां लक्षणानि वदस्व मे ।\nबीजदोषेण लोके च जायन्ते च कथं नराः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2210776, "chapter_id": 5506, "verse_number": "४", "content_sanskrit": "आचारदोषान् देवेश वक्तुमर्हस्यशेषतः ।\nब्राह्मणानां विशेषं च गुणदोषौ च केशव ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2210777, "chapter_id": 5506, "verse_number": "५", "content_sanskrit": "चातुर्वर्ण्यस्य कृत्स्नस्य वर्तमानाः प्रतिग्रहे ।\nकेन विप्रा विशेषेण तरन्ते तारयन्ति च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2210778, "chapter_id": 5506, "verse_number": "६", "content_sanskrit": "एतत् कथय देवेश त्वद्भक्तस्य नमोऽस्तु ते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2210779, "chapter_id": 5506, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2210780, "chapter_id": 5506, "verse_number": "७", "content_sanskrit": "शृणु राजन् यथातत्त्वं बीजयोनिशुभाशुभम् ।\nयेन तिष्ठति लोकोऽयं विनश्यति च पाण्डव ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2210781, "chapter_id": 5506, "verse_number": "८", "content_sanskrit": "अविप्लुतब्रह्मचर्यो यस्तु विप्रो यथाविधि ।\nस बीजी नाम विज्ञेयस्तस्य बीजं शुभं भवेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2210782, "chapter_id": 5506, "verse_number": "९", "content_sanskrit": "कन्या चाक्षतयोनिर्वा कुलीना पितृमातृतः ।\nब्राह्मादिषु विवाहेषु परिणीता यथाविधि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2210783, "chapter_id": 5506, "verse_number": "१०", "content_sanskrit": "सा प्रशस्ता वरारोहा शुद्धयोनिः प्रशस्यते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2210784, "chapter_id": 5506, "verse_number": "११", "content_sanskrit": "मनसा कर्मणा वाचा या गच्छेत् परपूरुषम् ।\nयोनिस्तस्या नरश्रेष्ठ गर्भाधानं न चार्हति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2210785, "chapter_id": 5506, "verse_number": "१२", "content_sanskrit": "स्वैरिण्या यस्तु पापात्मा सन्तानार्थमिहेच्छति ।\nस कुलान् पातयत्याशु दश पूर्वान् दशापरान् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2210786, "chapter_id": 5506, "verse_number": "१३", "content_sanskrit": "दुष्टयोनौ तु यो मोहाद् रेतः सिञ्चति मूढधीः ।\nतद् रेतसा समुत्पन्नः षडङ्गविदपि द्विजः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2210787, "chapter_id": 5506, "verse_number": "१४", "content_sanskrit": "साधुभिः स बहिष्कार्यः श्वपाक इव पार्थिव ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2210788, "chapter_id": 5506, "verse_number": "१५", "content_sanskrit": "कर्मणा मनसा वाचा या भवेत् स्वैरचारिणी ।\nसा कुलघ्नीति विज्ञेया तस्यां जातः श्वपाचकः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2210789, "chapter_id": 5506, "verse_number": "१६", "content_sanskrit": "दैवे पित्र्ये तथा दाने भोजने सह भाषणे ।\nशयने सह सम्बन्धे न योग्या दुष्टयोनिजाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2210790, "chapter_id": 5506, "verse_number": "१७", "content_sanskrit": "न तस्माद् दुष्टयोन्यां तु गर्भमुत्पादयेद् बुधः ।\nमोहेन कुरुते यस्तु कुलं हन्ति त्रिपूरुषम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2210791, "chapter_id": 5506, "verse_number": "१८", "content_sanskrit": "कानीनश्च सहोढश्च तथोभौ कुण्डगोलकौ ।\nआरूढपतिताज्जातः पतितस्यापि यः सुतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2210792, "chapter_id": 5506, "verse_number": "१९", "content_sanskrit": "षडेते विप्रचण्डाला निषिद्धाः श्वपचादपि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2210793, "chapter_id": 5506, "verse_number": "२०", "content_sanskrit": "यो यत्र तत्र वा रेतः सिक्त्वा शूद्रासु वा चरेत् ।\nकामचारी स पापात्मा बीजं तस्याशुभं भवेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2210794, "chapter_id": 5506, "verse_number": "२१", "content_sanskrit": "अशुभं तद् भवेद् बीजं शुद्धां योनिं च नार्हति ।\nशुद्धां हविर्भुजो ज्वालां शुना लीढं हविर्यथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2210795, "chapter_id": 5506, "verse_number": "२२", "content_sanskrit": "शूद्रयोनौ पतेद् बीजं हाहाशब्दं द्विजन्मनः ।\nकुर्यात् पुरीषमार्गेषु पतितोऽस्मीति दुःखितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2210796, "chapter_id": 5506, "verse_number": "२३", "content_sanskrit": "मामधः पातयत्येष पापात्मा काममोहितः ।\nअधोगतिं व्रजेत् क्षिप्रमिति शप्त्वा पतेत् तु तत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2210797, "chapter_id": 5506, "verse_number": "२४", "content_sanskrit": "आत्मा हि शुक्लमुद्दिष्टं दैवतं परमं महत् ।\nतस्मात् सर्वप्रयत्नेन निरुन्ध्याच्छुक्लमात्मनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2210798, "chapter_id": 5506, "verse_number": "२५", "content_sanskrit": "आयुस्तेजो बलं वीर्यं प्रज्ञा श्रीश्च महायशः ।\nपुण्यं च मत्प्रियत्वं च लभते ब्रह्मचर्यया ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2210799, "chapter_id": 5506, "verse_number": "२६", "content_sanskrit": "अविप्लुतब्रह्मचर्यैर्गृहस्थाश्रममाश्रितैः ।\nपञ्चयज्ञपरैर्धर्मः स्थाप्यते पृथिवीतळे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2210800, "chapter_id": 5506, "verse_number": "२७", "content_sanskrit": "सायं प्रातस्तु ये सन्ध्यां सम्यङ् नित्यमुपासते ।\nनावं वेदमयीं कृत्वा तरन्ते तारयन्ति च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2210801, "chapter_id": 5506, "verse_number": "२८", "content_sanskrit": "यो जपेत् पावनीं देवीं गायत्रीं वेदमातरम् ।\nन सीदेत् प्रतिगृह्णानः पृथिवीं च ससागराम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2210802, "chapter_id": 5506, "verse_number": "२९", "content_sanskrit": "ये च स्युर्दुःस्थिताः केचिद् ग्रहाः सूर्यादयो दिवि ।\nते चास्य सौम्या जायन्ते शिवाः शुभकरास्तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2210803, "chapter_id": 5506, "verse_number": "३०", "content_sanskrit": "यत्र तत्र स्थिताश्चैव दारुणाः पिशिताशनाः ।\nघोररूपा महाकाया धर्षयन्ति न तं द्विजम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2210804, "chapter_id": 5506, "verse_number": "३१", "content_sanskrit": "पुनन्तीह पृथिव्यां हि चीर्णवेदव्रता नराः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2210805, "chapter_id": 5506, "verse_number": "३२", "content_sanskrit": "अचीर्णव्रतवेदा ये विकर्मपथमाश्रिताः ।\nब्राह्मणा नाममात्रेण तेऽपि पूज्या नराधिप ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2210806, "chapter_id": 5506, "verse_number": "३३", "content_sanskrit": "किं पुनर्यस्तु सन्ध्ये द्वे नित्यमेवोपतिष्ठते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2210807, "chapter_id": 5506, "verse_number": "३४", "content_sanskrit": "शीलमध्ययनं दानं शौचं मार्दवमार्जवम् ।\nतस्माद् वेदाद् विशिष्टान् वै मनुराह प्रजापतिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2210808, "chapter_id": 5506, "verse_number": "३५", "content_sanskrit": "भूर्भुवःस्वरिति ब्रह्म यो वेदनिरतो द्विजः ।\nस्वदारनिरतो दान्तः स विद्वान् स च भूसुरः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2210809, "chapter_id": 5506, "verse_number": "३६", "content_sanskrit": "सन्ध्यामुपासते विप्रा नियमेन द्विजोत्तमाः ।\nते यान्ति नरशार्दूल ब्रह्मलोकं न संशयः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2210810, "chapter_id": 5506, "verse_number": "३७", "content_sanskrit": "सावित्रीमात्रसारोऽपि वरो विप्रः सुयन्त्रितः ।\nनायन्त्रितश्चतुर्वेदी सर्वाशी सर्वविक्रयी ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2210811, "chapter_id": 5506, "verse_number": "३८", "content_sanskrit": "सावित्रीं चैव वेदांश्च तुलयाऽतुलयन् पुरा ।\nदेवा ऋषिगणाश्चैव सर्वे ब्रह्मपुरःसराः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2210812, "chapter_id": 5506, "verse_number": "३९", "content_sanskrit": "चतुर्णामपि वेदानां सा हि राजन् गरीयसी ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2210813, "chapter_id": 5506, "verse_number": "४०", "content_sanskrit": "यथा विकसिते पुष्पे मधु गृह्णन्ति षट्पदाः ।\nसमुत्सृज्य रसं सर्वं निरर्थकमसारवत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2210814, "chapter_id": 5506, "verse_number": "४१", "content_sanskrit": "एवं गृहीता सावित्री सर्ववेदे च पाण्डव ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2210815, "chapter_id": 5506, "verse_number": "४२", "content_sanskrit": "एवं हि सर्ववेदानां सावित्री प्राण उच्यते ।\nनिर्जीवा हीतरे वेदा विना सावित्रिया नृप ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2210816, "chapter_id": 5506, "verse_number": "४३", "content_sanskrit": "एवं हि यश्चतुर्वेदी शीलभ्रष्टः स कुत्सितः ।\nशीलवृत्तसमायुक्तः सावित्रीपाठको वरः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2210817, "chapter_id": 5506, "verse_number": "४४", "content_sanskrit": "सहस्रपरमां देवीं शतमध्यां दशावराम् ।\nसावित्रीं जप कौन्तेय सर्वपापप्रणाशिनीम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2210818, "chapter_id": 5506, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2210819, "chapter_id": 5506, "verse_number": "४५", "content_sanskrit": "त्रैलोक्यनाथ भो कृष्ण सर्वभूतात्मको ह्यसि ।\nनानायोगधर श्रेष्ठ तुष्यसे केन कर्मणा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2210820, "chapter_id": 5506, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2210821, "chapter_id": 5506, "verse_number": "४६", "content_sanskrit": "यदि भारसहस्रं तु गुगुल्वादि प्रधूपयेत् ।\nकरोति चेन्नमस्कारमुपहारं च कारयेत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2210822, "chapter_id": 5506, "verse_number": "४७", "content_sanskrit": "पूजयेत् स्तुतिभिर्मां च ऋग्यजुःसामभिः सदा ।\nन तोषयति चेद् विप्रान् नाहं तुष्यामि भारत ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2210823, "chapter_id": 5506, "verse_number": "४८", "content_sanskrit": "ब्राह्मणे पूजिते नित्यं पूजितोऽस्मि न संशयः ।\nआक्रुष्टे चाहमाक्रुष्टो भवामि भरतर्षभ ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2210824, "chapter_id": 5506, "verse_number": "४९", "content_sanskrit": "परा मयि गतिस्तेषां पूजयन्तीह मां हि ते ।\nयदहं द्विजरूपेण वसामि वसुधातले ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2210825, "chapter_id": 5506, "verse_number": "५०", "content_sanskrit": "यस्तान् पूजयति प्राज्ञो मद्गतेनान्तरात्मना ।\nतमहं स्वेन रूपेण पश्यामि नरपुङ्गव ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2210826, "chapter_id": 5506, "verse_number": "५१", "content_sanskrit": "काणाः कुब्जा वामनाश्च दरिद्रा व्याधितास्तथा ।\nनावमान्याः द्विजाः प्राज्ञैर्मम रूपा हि ते द्विजाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2210827, "chapter_id": 5506, "verse_number": "५२", "content_sanskrit": "ये केचित् सागरान्तायां पृथिव्यां द्विजसत्तमाः ।\nमम रूपेषु तेष्वेवमर्चितेष्वर्चितोऽस्म्यहम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2210828, "chapter_id": 5506, "verse_number": "५३", "content_sanskrit": "बहवस्तु न जानन्ति नरा ज्ञानबहिष्कृताः ।\nयथा हि द्विजरूपेण वसामि वसुधातळे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2210829, "chapter_id": 5506, "verse_number": "५४", "content_sanskrit": "अवमन्यन्ति ये विप्रान् स्वधर्मात् पातयन्ति च ।\nप्रेषयन्ते च सततं शुश्रूषां कारयन्ति च ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2210830, "chapter_id": 5506, "verse_number": "५५", "content_sanskrit": "मृतांस्तान् करपत्रेण यमदूता महाबलाः ।\nनिकृन्तन्ति यथाकामं सूत्रमार्गेण शिल्पिनः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2210831, "chapter_id": 5506, "verse_number": "५६", "content_sanskrit": "आक्रोशपरिवादाभ्यां ये रमन्ते द्विजातिषु ।\nतान् मृतान् यमलोकस्थान् निपात्य धरणीतळे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2210832, "chapter_id": 5506, "verse_number": "५७", "content_sanskrit": "आक्रम्योरसि पादेन क्रुद्धाः संरक्तलोचनाः ।\nअग्निवर्णैस्तु सन्दंशैर्यमो जिह्वां समुद्धरेत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2210833, "chapter_id": 5506, "verse_number": "५८", "content_sanskrit": "ये च विप्रान् निरीक्षन्ते पापाः पापेन चक्षुषा ।\nअब्रह्मण्याः श्रुतेर्बाह्या नित्यं ब्रह्मद्विषो नराः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2210834, "chapter_id": 5506, "verse_number": "५९", "content_sanskrit": "तेषां घोरा महाकाया वक्रतुण्डा महाबलाः ।\nउद्धरन्ति मुहूर्तेन खगाश्चक्षुर्यमाज्ञया ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2210835, "chapter_id": 5506, "verse_number": "६०", "content_sanskrit": "यः प्रहारं द्विजेन्द्राय दद्यात् कुर्याच्च शोणितम् ।\nअस्थिभङ्गं च यः कुर्यात् प्राणैर्वा विप्रयोजयेत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2210836, "chapter_id": 5506, "verse_number": "६१", "content_sanskrit": "सोऽनुपूर्व्येण यातीमान् नरकानेकविंशतिम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2210837, "chapter_id": 5506, "verse_number": "६२", "content_sanskrit": "शूलमारोपितो गत्वा ज्वलनेनापि दह्यते ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2210838, "chapter_id": 5506, "verse_number": "६३", "content_sanskrit": "बहुवर्षसहस्राणि पच्यमानस्त्ववाक्छिराः ।\nनावमुञ्चति दुर्मेधा न तस्य क्षीयते मतिः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2210839, "chapter_id": 5506, "verse_number": "६४", "content_sanskrit": "ब्राह्मणायवगुर्यैव व्रजन्ति वधकाङ्क्षया ।\nशतवर्षसहस्राणि तामिस्रे परिपच्यते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2210840, "chapter_id": 5506, "verse_number": "६५", "content_sanskrit": "उत्पाद्य शोणितं गात्रात् संरम्भान्मतिपूर्वकम् ।\nस पर्यायेण यातीमान् नरकानेकविंशतिम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2210841, "chapter_id": 5506, "verse_number": "६६", "content_sanskrit": "तस्मान्नाकुशलं ब्रूयात् न शुग्धां गिरमीरयेत् ।\nन ब्रूयात् परुषां वाणीं न चैवैतानतिक्रमेत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2210842, "chapter_id": 5506, "verse_number": "६७", "content_sanskrit": "ये विप्रान् श्रद्धया वाचा पूजयन्ति नरोत्तमाः ।\nअर्चितश्च स्तुतश्चैव तैर्भवामि युधिष्ठिर ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2210843, "chapter_id": 5506, "verse_number": "६८", "content_sanskrit": "तर्जयन्ति च ये विप्रान् क्रोशयन्ति च भारत ।\nआक्रुष्टस्तर्जितश्चाहं तैर्भवामि न संशयः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2210844, "chapter_id": 5506, "verse_number": "६९", "content_sanskrit": "यश्चन्दनैश्चागरुधूपदीपैः\nअभ्यर्चयेत् काष्ठमयीं ममार्चाम् ।\nतेनार्चितो नैव भवामि सम्यग्\nविप्रार्चनादर्चितोऽहं भवामि ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2210845, "chapter_id": 5506, "verse_number": "७०", "content_sanskrit": "विप्रप्रसादाद् धरणीधरोऽहं\nविप्रप्रसादादसुरान् जयामि ।\nविप्रप्रसादाच्च सदक्षिणोऽहं\nविप्रप्रसादादजितोऽहमस्मि ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2210846, "chapter_id": 5506, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि वैष्णवधर्मशास्त्रे विप्रप्रसादमाहात्म्यं नाम शततमोऽध्यायः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]