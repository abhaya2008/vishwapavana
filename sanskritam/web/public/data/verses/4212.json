[{"id": 2148432, "chapter_id": 4212, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148433, "chapter_id": 4212, "verse_number": "१", "content_sanskrit": "असिद्धानुनये कृष्णे कुरुभ्यः पाण्डवान् गते ।\nअभिगम्य पृथां क्षत्ता शनैः शोचन्निवाब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148434, "chapter_id": 4212, "verse_number": "२", "content_sanskrit": "जानासि मे जीवपुत्रि भावं नित्यमविग्रहे ।\nक्रोशतो न च गृह्णाति वचनं मे सुयोधनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148435, "chapter_id": 4212, "verse_number": "३", "content_sanskrit": "उपपन्नो ह्यसौ राजा चेदिपाञ्चालकेकयैः ।\nभीमार्जुनाभ्यां कृष्णेन युयुधानयमैरपि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148436, "chapter_id": 4212, "verse_number": "४", "content_sanskrit": "उपप्लाव्ये निविष्टोऽपि धर्मराजो युधिष्ठिरः ।\nकाङ्क्षते ज्ञातिभिः सन्धिं बलवान् दुर्बलो यथा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148437, "chapter_id": 4212, "verse_number": "५", "content_sanskrit": "राजा तु धृतराष्ट्रोऽयं वयोवृद्धो न शाम्यति ।\nमत्तः पुत्रमदेनैव विधर्मे पथि वर्तते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148438, "chapter_id": 4212, "verse_number": "६", "content_sanskrit": "जयद्रथस्य कर्णस्य तथा दुःशासनस्य च ।\nसौबलस्य च दुर्बुद्ध्या मिथो भेदः प्रवर्तते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148439, "chapter_id": 4212, "verse_number": "७", "content_sanskrit": "अधर्मेण हि धर्मिष्ठं ह्रियते राज्यमीदृशम् ।\nयेषां तेषामयं धर्मः सानुबन्धो भविष्यति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148440, "chapter_id": 4212, "verse_number": "८", "content_sanskrit": "ह्रियमाणे बलाद् धर्मे कुरुभिः को न सञ्ज्वरेत् ।\nअसाम्ना केशवे याते समुदेष्यन्ति पाण्डवाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148441, "chapter_id": 4212, "verse_number": "९", "content_sanskrit": "ततः कुरूणामनयो भविता वीरनाशनः ।\nचिन्तयन् न लभे निद्रामहस्सु च निशासु च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148442, "chapter_id": 4212, "verse_number": "", "content_sanskrit": "वैशम्पायनः(?)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148443, "chapter_id": 4212, "verse_number": "१०", "content_sanskrit": "श्रुत्वा तु कुन्ती तद्वाक्यमर्थकामेन भाषितम् ।\nसा निःश्वसन्ती दुःखार्ता मनसा विममर्श ह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148444, "chapter_id": 4212, "verse_number": "११", "content_sanskrit": "धिगस्त्वर्थं यत्कृतेऽयं सुमहान् ज्ञातिसङ्क्षयः ।\nवर्तते सुहृदां चैव युद्धेऽस्मिन् वै पराभवः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148445, "chapter_id": 4212, "verse_number": "१२", "content_sanskrit": "पाण्डवाश्चेदिपाञ्चाला यादवाश्च समागताः ।\nभारतैः सह योत्स्यन्ति किं नु दुःखमतः परम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148446, "chapter_id": 4212, "verse_number": "१३", "content_sanskrit": "पश्ये दोषं ध्रुवं युद्धे तथाऽयुद्धे पराभवम् ।\nअधनस्य मृतं श्रेयो न हि ज्ञातिक्षयो जयः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148447, "chapter_id": 4212, "verse_number": "समाप्तिः", "content_sanskrit": "इति मे चिन्तयन्त्या वै हृदि दुःखं प्रवर्तते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148448, "chapter_id": 4212, "verse_number": "१५", "content_sanskrit": "पितामहः शान्तनव आचार्यश्च युधाम्पतिः ।\nकर्णश्च धार्तराष्ट्रार्थं वर्धयन्ति भयं मम\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148449, "chapter_id": 4212, "verse_number": "१६", "content_sanskrit": "नाचार्यः कामवान् शिष्यैः द्रोणो युद्ध्येत जातुचित् ।\nपाण्डवेषु कथं हार्दं कुर्यान्न च पितामहः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148450, "chapter_id": 4212, "verse_number": "१७", "content_sanskrit": "अथ त्वेको वृथादृष्टिः धार्तराष्ट्रस्य दुर्मतेः ।\nमोहानुवर्ती सततं पापो द्वेष्टि च पाण्डवान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148451, "chapter_id": 4212, "verse_number": "१८", "content_sanskrit": "महत्यनर्थे निर्बन्धी बलवांश्च विशेषतः ।\nकर्णः सदा पाण्डवद्विट् तन्मे दहति सम्प्रति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148452, "chapter_id": 4212, "verse_number": "१९", "content_sanskrit": "आशंसे त्वद्य कर्णस्य मनोऽहं पाण्डवान् प्रति ।\nप्रसादयितुमासाद्य दर्शयन्ती यथातथम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148453, "chapter_id": 4212, "verse_number": "२०", "content_sanskrit": "तोषितो भगवान् यत्र दुर्वासा मे वरं ददौ ।\nआह्वानं मन्त्रसंयुक्तं वसन्त्याः पितृवेश्मनि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148454, "chapter_id": 4212, "verse_number": "२१", "content_sanskrit": "साऽहमन्तःपुरे राज्ञः कुन्तिभोजपुरस्कृता ।\nचिन्तयन्ती बहुविधं हृदयेन विदूयता\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2148455, "chapter_id": 4212, "verse_number": "२२", "content_sanskrit": "बलाबलं च मन्त्राणां ब्राह्मणस्य च वाग्बलम् ।\nस्त्रीभावाद् बालभावाच्च चिन्तयन्ती पुनः पुनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2148456, "chapter_id": 4212, "verse_number": "२३", "content_sanskrit": "धात्र्या विस्रब्धया गुप्ता सखीजनवृता तदा ।\nदोषं परिहरन्ती च पितुश्चारित्ररक्षिणी\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2148457, "chapter_id": 4212, "verse_number": "२४", "content_sanskrit": "कथं नु सुकृतं मे स्यान्नापराधवती कथम् ।\nभवेयमिति सञ्चिन्त्य ब्राह्मणं तं नमस्य च\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2148458, "chapter_id": 4212, "verse_number": "२५", "content_sanskrit": "कौतूहलात् सुतं लब्ध्वा बालिश्यादाचरं तदा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2148459, "chapter_id": 4212, "verse_number": "२६", "content_sanskrit": "कन्या सती देवमर्कमासादयमहं ततः ।\nयोऽसौ कानीनगर्भो मे पुत्रवत् परिरक्षितः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2148460, "chapter_id": 4212, "verse_number": "२७", "content_sanskrit": "कस्मान्न कुर्याद् वचनं पथ्यं भ्रातृहितं तथा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2148461, "chapter_id": 4212, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2148462, "chapter_id": 4212, "verse_number": "समाप्तिः", "content_sanskrit": "इति कुन्ती विनिश्चित्य कार्यनिश्चयमुत्तमम् ।\nकार्यार्थमभिनिर्याय ययौ भागीरथीं प्रति\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2148463, "chapter_id": 4212, "verse_number": "२९", "content_sanskrit": "आत्मजस्य ततस्तस्य घृणिनः सत्यसङ्गिनः ।\nगङ्गातीरे पृथाऽश्रौषीत् तदाऽध्ययननिस्वनम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2148464, "chapter_id": 4212, "verse_number": "३०", "content_sanskrit": "प्राङ्मुखस्योर्ध्वबाहोः सा पर्यतिष्ठत पृष्ठतः ।\nजप्यावसाने कार्यार्थं प्रतीक्षन्ती तपस्विनी\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2148465, "chapter_id": 4212, "verse_number": "३१", "content_sanskrit": "अतिष्ठत् सूर्यतापार्ता कर्णस्योत्तरवासिनी ।\nकौरव्यपत्नी वार्ष्णेयी पद्ममालेव शुष्यती\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2148466, "chapter_id": 4212, "verse_number": "३२", "content_sanskrit": "आपृष्ठतापाज्जप्त्वाऽसौ परिवृत्य यतव्रतः ।\nदृष्ट्वा कुन्तीमुपातिष्ठद् अभिवाद्य कृताञ्जलिः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2148467, "chapter_id": 4212, "verse_number": "३३", "content_sanskrit": "यथान्यायं महातेजा मानी धर्मभृतां वरः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2148468, "chapter_id": 4212, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि त्रिचत्वारिंशोत्तरशततमोऽध्यायः ॥१४३॥\nविवादपर्वणि पञ्चमोऽध्यायः ॥५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]