[{"id": 50025129, "chapter_id": 11983, "verse_number": "1", "content_sanskrit": "॥ उक्तदोषाणां बहुजीववादिमतेऽतिदेशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50025130, "chapter_id": 11983, "verse_number": "2", "content_sanskrit": "बहुजीववादिपक्षेऽपि भेदस्य मिथ्यात्वाङ्गीकारे, एते दोषा भवन्त्येव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50025131, "chapter_id": 11983, "verse_number": "3", "content_sanskrit": "॥ तत्समर्थनाय मिथ्योपाधिकृतभेदनिरसनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50025132, "chapter_id": 11983, "verse_number": "4", "content_sanskrit": "मिथ्योपाधिकृतं हि तेषामपि बहुत्वम्। नच मिथ्योपाधिकृतो भेदः क्वापि दृष्टः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50025133, "chapter_id": 11983, "verse_number": "5", "content_sanskrit": "॥ अधिष्ठानसदृशाभावयुक्त्या मिथ्योपाधिनिरसनं च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50025134, "chapter_id": 11983, "verse_number": "6", "content_sanskrit": "आत्मन्यनात्मकल्पनारूपत्वान्मिथ्योपाधिरेव न युज्यते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50025135, "chapter_id": 11983, "verse_number": "7", "content_sanskrit": "॥ मायाकल्पितेष्वप्यधिष्ठानसदृशादेरावश्यकत्वनिरूपणद्वारा विश्वस्य मायाकल्पितत्वनिरासः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50025136, "chapter_id": 11983, "verse_number": "8", "content_sanskrit": "मायामयी सृष्टिरपि तत्सदृशस्यान्यस्य विद्यमानत्व एव दृष्टा। द्रव्यत्वादिसादृश्ययुतं किञ्चिदधिष्ठानमाश्रित्यैव च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50025137, "chapter_id": 11983, "verse_number": "9", "content_sanskrit": "“अधिष्ठानं च सदृशं तथ्यवस्तुद्वयं विना। न भ्रान्तिर्भवति क्वापि स्वप्नमायादिकेष्वपि। मानस्यां वासनायां तु बहिर्वस्तुत्वकल्पनम्। स्वाप्नो भ्रमश्च मायायां कर्तृदेहादिवस्तुषु। चतुरङ्गबलत्वादिकल्पनं भ्रम इष्यते। न भ्रान्तिकल्पितं विश्वमतो विष्णुबलाश्रयम्॥” इति ब्रह्मवैवर्ते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50025138, "chapter_id": 11983, "verse_number": "10", "content_sanskrit": "॥ पुराणोक्तानुमानान्तराभ्यामपि विश्वस्य मायाकल्पितत्वनिरासः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50025139, "chapter_id": 11983, "verse_number": "11", "content_sanskrit": "॥ ईश्वरेण मायावित्वाभिमतेन दृश्यत्वयुक्त्या विश्वस्य मायाकल्पितत्वनिरासः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50025140, "chapter_id": 11983, "verse_number": "12", "content_sanskrit": "“नच मायाविना माया दृश्यते विश्वमीश्वरः। सदा पश्यति तेनेदं न मायेत्यवधार्यताम् ॥” इति च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50025141, "chapter_id": 11983, "verse_number": "13", "content_sanskrit": "॥ अधिष्ठानापरोक्षज्ञानवता दृश्यत्वयुक्त्या विश्वस्य मायाकल्पितत्वनिरासः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50025142, "chapter_id": 11983, "verse_number": "14", "content_sanskrit": "“अपरोक्षदृशो मिथ्या-दर्शनं न क्वचिद् भवेत्। सर्वापरोक्षविद् विष्णुर्विश्वदृक् तन्न तन्मृषा ॥” इति च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]