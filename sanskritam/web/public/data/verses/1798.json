[{"id": 2036930, "chapter_id": 1798, "verse_number": "५-४३-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2036931, "chapter_id": 1798, "verse_number": "५-४३-१", "content_sanskrit": "कस्यैष मौनः कतरन्नु मौनं\nप्रब्रूहि विद्वन्निह मौनभावम्।\nमौनेन विद्वानुत याति मौनं\nकथं मुने मौनमिहाचरन्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2036932, "chapter_id": 1798, "verse_number": "५-४३-२x", "content_sanskrit": "सनत्सुजात उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2036933, "chapter_id": 1798, "verse_number": "५-४३-२", "content_sanskrit": "यतो न वेदा मनसा सहैन-\nमनुप्रविशन्ति ततोऽथ मौनम्।\nयत्रोत्थितो वेदशब्दस्तथायं\nस तन्मयत्वेन विभाति राजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2036934, "chapter_id": 1798, "verse_number": "५-४३-३x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2036935, "chapter_id": 1798, "verse_number": "५-४३-३", "content_sanskrit": "ऋचो यजूंषि यो वेद सामवेदं च वेद यः।\nपापानि कुर्वन्पापेन लिप्यते किं न लिप्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2036936, "chapter_id": 1798, "verse_number": "५-४३-४x", "content_sanskrit": "सनत्सुजात उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2036937, "chapter_id": 1798, "verse_number": "५-४३-४", "content_sanskrit": "नैनं सामान्यृचो वापि न यजूंष्यविचक्षणम्।\nत्रायन्ते कर्मणः पापान्न ते मिथ्या ब्रवीम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2036938, "chapter_id": 1798, "verse_number": "५-४३-५", "content_sanskrit": "न च्छन्दांसि वृजिनात्तारयन्ति\nमायाविनं मायया सर्वमानम्।\nनीडं शकुन्ता इव जातपक्षा-\nश्छन्दांस्येनं प्रजहत्यन्तकाले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2036939, "chapter_id": 1798, "verse_number": "५-४३-६x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2036940, "chapter_id": 1798, "verse_number": "५-४३-६", "content_sanskrit": "न चेद्वेदा वेदविदं त्रातुं शक्ता विचक्षण।\nअथ कस्मात्प्रलापोऽयं ब्राह्मणानां सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2036941, "chapter_id": 1798, "verse_number": "५-४३-७x", "content_sanskrit": "सनत्सुजात उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2036942, "chapter_id": 1798, "verse_number": "५-४३-७", "content_sanskrit": "तस्यैव नामादिविशेषरूपै-\nरिदं जगद्भाति महानुभाव ।\nनिर्दिश्य सम्यक्प्रवदन्ति वेदा-\nस्तद्विश्ववैरूप्यमुदाहरन्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2036943, "chapter_id": 1798, "verse_number": "५-४३-८", "content_sanskrit": "तदर्थयुक्तं तप एतदिज्या\nताभ्यामसौ पुण्यमुपैति विद्वान्।\nपुण्येन पापं विनिहत्य पश्चा-\nत्संजायते ज्ञानविदीपितात्मा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2036944, "chapter_id": 1798, "verse_number": "५-४३-९", "content_sanskrit": "ज्ञानेन चात्मानमुपैति विद्वा-\nनथान्यथा वर्गफलानुकाङ्क्षी।\nअस्मिन्कृतं तत्परिगृह्य सर्व-\nममुत्र भुङ्क्ते पुनरेति मार्गम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2036945, "chapter_id": 1798, "verse_number": "५-४३-१०", "content_sanskrit": "अस्मिँल्लोके तपस्तप्तं फलमन्यत्र भुज्यते।\nब्राह्मणानामिमे लोका वृद्धे तपसि संयताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2036946, "chapter_id": 1798, "verse_number": "५-४३-११", "content_sanskrit": "` ब्राह्मणानां तपः स्वृद्धमन्येषां तावदेव तत्।\nएतत्समृद्धमत्यृद्धं तपो भवति केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2036947, "chapter_id": 1798, "verse_number": "५-४३-१२x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2036948, "chapter_id": 1798, "verse_number": "५-४३-१२", "content_sanskrit": "कथं समृद्धमप्यृद्धं तपो भवति केवलम्।\nसनत्सुजात तद्ब्रूहि यथा विद्याम तद्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2036949, "chapter_id": 1798, "verse_number": "५-४३-१३x", "content_sanskrit": "सनत्सुजात उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2036950, "chapter_id": 1798, "verse_number": "५-४३-१३", "content_sanskrit": "निष्कल्मषं तपस्त्वेतत्केवलं परिचक्षते।\nएतत्समृद्धमप्यृद्धं तपो भवति केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2036951, "chapter_id": 1798, "verse_number": "५-४३-१४", "content_sanskrit": "तपोमूलमिदं सर्वं यन्मां पृच्छसि क्षत्रिय।\nतपसा वेदविद्वांसः परं त्वमृतमाप्नुयुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2036952, "chapter_id": 1798, "verse_number": "५-४३-१५x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2036953, "chapter_id": 1798, "verse_number": "५-४३-१५", "content_sanskrit": "कल्मषं तपसो ब्रूहि श्रुतं निष्कल्मषं तपः।\nसनत्सुजात येनेदं विद्यां गुह्यं सनातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2036954, "chapter_id": 1798, "verse_number": "५-४३-१६x", "content_sanskrit": "सनत्सुजात उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2036955, "chapter_id": 1798, "verse_number": "५-४३-१६", "content_sanskrit": "क्रोधादयो द्वादश यस्य दोषा-\nस्तथा नृशंसानि दश त्रि राजन्।\nधर्मादयो द्वादशैते पितॄणां\nशास्त्रे गुणा ये विदिता द्विजानाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2036956, "chapter_id": 1798, "verse_number": "५-४३-१७", "content_sanskrit": "क्रोधः कामो लोभमोहौ विधित्सा-\nऽकृपाऽसूये मानशोकौ स्पृहा च।\nईर्ष्या जुगुप्सा च मनुष्यदोषा\nवर्ज्याः सदा द्वादशैते नराणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2036957, "chapter_id": 1798, "verse_number": "५-४३-१८", "content_sanskrit": "एकैकमेते राजेन्द्र मनुष्यान्पर्युपासते।\nलिप्समानोन्तरं तेषां मृगाणामिव लुब्धकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2036958, "chapter_id": 1798, "verse_number": "५-४३-१९", "content_sanskrit": "विकत्थनः स्पृहयालुर्मनस्वी\nबिभ्रत्कोषं चपलो रोषणश्च।\nएतान्पापाः षण्णराः पापधर्मान्\nप्रकुर्वते नो त्रसन्तः सुदुर्गे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2036959, "chapter_id": 1798, "verse_number": "५-४३-२०", "content_sanskrit": "संभोगसंविद्विषमोऽतिमानी\nदत्तानुतापी कृपणो बलीयान्।\nवर्गप्रशंसी वनितासु द्वेष्टा\nएते परे सप्त नृशंसवर्गाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2036960, "chapter_id": 1798, "verse_number": "५-४३-२१", "content_sanskrit": "धर्मश्च सत्यं च दमस्तपश्च\nआमात्सर्यं ह्रीस्तितिक्षानसूया।\nयज्ञश्च दानं च धृतिः श्रुतं च\nव्रतानि वै द्वादश ब्राह्मणस्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2036961, "chapter_id": 1798, "verse_number": "५-४३-२२", "content_sanskrit": "यस्त्वेतेभ्यः प्रभवेद्द्वादशभ्यः\nसर्वामपीमां पृथिवीं स शिष्यात्।\nत्रिभिर्द्वाभ्यामेकतो वार्थितो य-\nस्तस्य स्वमस्तीति स वेदितव्यः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2036962, "chapter_id": 1798, "verse_number": "५-४३-२३", "content_sanskrit": "दमस्त्यागोऽप्रमादश्च एतेष्वमृतमाहितम्।\nतानि सत्यमुखान्याहुर्ब्राह्मणा ये मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2036963, "chapter_id": 1798, "verse_number": "५-४३-२४", "content_sanskrit": "दमोऽष्टादशदोषः स्यात्प्रातिकूल्यं कृते भवेत् ।\nअनृतं चाभ्यसूया च कामार्थौ च तथा स्पृहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2036964, "chapter_id": 1798, "verse_number": "५-४३-२५", "content_sanskrit": "क्रोधः शोकस्तथा तृष्णा लोभः पैशून्यमेव च।\nमत्सरश्च विहिंसा च परितापस्तथाऽरतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2036965, "chapter_id": 1798, "verse_number": "५-४३-२६", "content_sanskrit": "अपस्मारश्चातिवादस्तथा संभावनात्मनि।\nएतैर्विमुक्तो दोषैर्यः स दान्तः सद्भिरुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2036966, "chapter_id": 1798, "verse_number": "५-४३-२७", "content_sanskrit": "मदोऽष्टादशदोषः स्यात्त्यागो भवति षड्विधः।\nविपर्ययाः स्मृता एते मददोषा उदाहृताः ।\nदोषा दमस्य ये प्रोक्तास्तान्दोषान्परिवर्जयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2036967, "chapter_id": 1798, "verse_number": "५-४३-२८", "content_sanskrit": "श्रेयांस्तु षड्विधस्त्यागस्तृतीयो दुष्करो भवेत् ।\nतेन दुःखं तरत्येव भिन्नं तस्मिञ्जितं कृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2036968, "chapter_id": 1798, "verse_number": "५-४३-२९", "content_sanskrit": "श्रेयांस्तु षड्विधस्त्यागः श्रियं प्राप्य न हृष्यति ।\nइष्टापूर्ते द्वितीयं स्यान्नित्यवैराग्ययोगतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2036969, "chapter_id": 1798, "verse_number": "५-४३-३०", "content_sanskrit": "कामत्यागश्च राजेन्द्र स तृतीय इति स्मृतः ॥\nअप्यवाच्यं वदन्त्येतं स तृतीयो गुणः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2036970, "chapter_id": 1798, "verse_number": "५-४३-३१", "content_sanskrit": "त्यक्तैर्द्रव्यैर्यद्भवति नोपयुक्तैश्च कामतः।\nन च द्रव्यैस्तद्भवति नोपयुक्तैश्च कामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2036971, "chapter_id": 1798, "verse_number": "५-४३-३२", "content_sanskrit": "न च कर्मस्वसिद्धेषु दुःखं ते न च न ग्लपेत्।\nसर्वैरेव गुणैर्युक्तो द्रव्यवानपि यो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2036972, "chapter_id": 1798, "verse_number": "५-४३-३३", "content_sanskrit": "अप्रिये च समुत्पन्ने व्यथां जातु न गच्छति।\nइष्टान्पुत्रांश्च दारांश्च न याचेत कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2036973, "chapter_id": 1798, "verse_number": "५-४३-३४", "content_sanskrit": "अर्हते याचमानाय प्रदेयं तच्छुभं भवेत्।\nअप्रमादी भवेदेतैः स चाप्यष्टगुणो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2036974, "chapter_id": 1798, "verse_number": "५-४३-३५", "content_sanskrit": "सत्यं ध्यानं समाधानं चोद्यं वैराग्यमेव च।\nअस्तेयं ब्रह्मचर्यं च तथाऽसंग्रहमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2036975, "chapter_id": 1798, "verse_number": "५-४३-३६", "content_sanskrit": "एवं दोषा मदस्योक्तास्तान्दोषान्परिवर्जयेत्।\nतथा त्यागोऽप्रमादश्च स चाप्यष्टगुणो मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2036976, "chapter_id": 1798, "verse_number": "५-४३-३७", "content_sanskrit": "अष्टौ दोषाः प्रमादस्य तान्दोषान्परिवर्जयेत्।\nइन्द्रियेभ्यश्च पञ्चभ्यो मनसश्चैव भारत।\nअतीतानागतेभ्यश्च मुक्त्युपेतः सुखी भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2036977, "chapter_id": 1798, "verse_number": "५-४३-३८", "content_sanskrit": "सत्यात्मा भव राजेन्द्र सत्ये लोकाः प्रतिष्ठिताः।\nतांस्तु सत्यमुखानाहुः सत्ये ह्यमृतमाहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2036978, "chapter_id": 1798, "verse_number": "५-४३-३९", "content_sanskrit": "निवृत्तेनैव दोषेण तपो व्रतमिहाचरेत्।\nएतद्धातृकृतं वृत्तं सत्यमेव सतां व्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2036979, "chapter_id": 1798, "verse_number": "५-४३-४०", "content_sanskrit": "दोषैरेतैर्वियुक्तस्तु गुणैरेतैः समन्वितः ।\nएतत्समृद्धमत्यर्थं तपो भवति केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2036980, "chapter_id": 1798, "verse_number": "५-४३-४१", "content_sanskrit": "यन्मां पृच्छसि राजेन्द्र संक्षेपात्प्रब्रवीमि ते।\nएतत्पापहरं पुण्यं जन्ममृत्युजरापहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2036981, "chapter_id": 1798, "verse_number": "५-४३-४२x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2036982, "chapter_id": 1798, "verse_number": "५-४३-४२", "content_sanskrit": "आख्यानप़ञ्चमैर्वेदैर्भूयिष्ठं कथ्यते जनः।\nतथा चान्ये चतुर्वेदास्त्रिधेदाश्च तथा परे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2036983, "chapter_id": 1798, "verse_number": "५-४३-४३", "content_sanskrit": "द्विवेदाश्चैकवेदाश्चाप्यनृचश्च तथा परे।\nतेषां तु कतरः स स्याद्यमहं वेद वै द्विजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2036984, "chapter_id": 1798, "verse_number": "५-४३-४४x", "content_sanskrit": "सनत्सुजात उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2036985, "chapter_id": 1798, "verse_number": "५-४३-४४", "content_sanskrit": "एकस्य वेस्याज्ञानाद्वेदास्ते बहवः कृताः।\nसत्यस्यैकस्य राजेन्द्र सत्ये कश्चिदवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2036986, "chapter_id": 1798, "verse_number": "५-४३-४५", "content_sanskrit": "एवं वेदमविज्ञाय प्राज्ञोऽहमिति मन्यते।\nदानमध्ययनं यज्ञो लोभादेतत्प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2036987, "chapter_id": 1798, "verse_number": "५-४३-४६", "content_sanskrit": "सत्यात्प्रच्यवमानानां सङ्कल्पो वितथो भवेत्।\nततो यज्ञः प्रतायेत सत्यस्यानवधारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2036988, "chapter_id": 1798, "verse_number": "५-४३-४७", "content_sanskrit": "मनसान्यस्य भवति वाचान्यस्याथ कर्मणा।\nसङ्कल्पसिद्धः पुरुषः सङ्कल्पानधितिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2036989, "chapter_id": 1798, "verse_number": "५-४३-४८", "content_sanskrit": "अनैभृत्येन चैतस्य दीक्षितव्रतमाचरेत्।\nनामैतद्धातुनिर्वृत्तं सत्यमेव सतां परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2036990, "chapter_id": 1798, "verse_number": "५-४३-४९", "content_sanskrit": "ज्ञानं वै नाम प्रत्यक्षं परोक्षं जायते तपः।\nविद्याद्बहु पठन्तं तु द्विजं वै बहुपाठिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2036991, "chapter_id": 1798, "verse_number": "५-४३-५०", "content_sanskrit": "तस्मात्क्षत्रिय मा मंस्था जल्पितेनैव वै द्विजम्।\nय एव सत्यान्नापैति स ज्ञेयो ब्राह्मणस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2036992, "chapter_id": 1798, "verse_number": "५-४३-५१", "content_sanskrit": "छन्दांसि नाम क्षत्रिय तान्यथर्वा\nपुरा जगौ महर्षिसङ्घ एषः\nछन्दोविदस्ते य उत नाधीतवेदा\nन वेदवेद्यस्य विदुर्हि तत्त्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2036993, "chapter_id": 1798, "verse_number": "५-४३-५२", "content_sanskrit": "छन्दांसि नाम द्विपदां वरिष्ठ\nस्वच्छन्दयोगेन भवन्ति तत्र।\nछन्दोविदस्ते न च तानधीत्य\nगता न वेदस्य न वेद्यमार्याः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2036994, "chapter_id": 1798, "verse_number": "५-४३-५३", "content_sanskrit": "न वेदानां वेदिता कश्चिदस्ति\nकश्चित्त्वेतान्बुद्ध्यते वापि राजन्।\nयो वेद वेदान्न स वेद वेद्यं\nसत्ये स्थितो यस्तु स वेद वेद्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2036995, "chapter_id": 1798, "verse_number": "५-४३-५४", "content_sanskrit": "न वेदानां वेदिता कश्चिदस्ति\nवेद्येन वेदं न विदुर्न वेद्यम् ।\nयो वेद वेदं स च वेद वेद्यं\nयो वेद वेद्यं न स वेद सत्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2036996, "chapter_id": 1798, "verse_number": "५-४३-५५", "content_sanskrit": "यो वेद वेदान्स च वेद वेद्यं\nन तं विदुर्वेदविदो न वेदाः।\nतथापि वेदेन विदन्ति वेदं\nये ब्राह्मणा वेदविदो भवन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2036997, "chapter_id": 1798, "verse_number": "५-४३-५६", "content_sanskrit": "धामांशभागस्य तथा हि वेदा\nयथा च शाखा हि महीरुहस्य।\nसंवेदने चैव यथामनन्ति\nतस्मिन्हि सत्ये परमात्मनोऽर्थे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2036998, "chapter_id": 1798, "verse_number": "५-४३-५७", "content_sanskrit": "अभिजानामि ब्राह्मणं व्याख्यातारं विचक्षणम्।\nयश्छिन्नविचिकित्सः स व्याचष्टे सर्वसंशयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2036999, "chapter_id": 1798, "verse_number": "५-४३-५८", "content_sanskrit": "नास्य पर्येषणं गच्छेत्प्रचीनं नोत दक्षिणम्।\nनार्वाचीनं कुतस्तिर्यङ्गादिशन्तु कथञ्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2037000, "chapter_id": 1798, "verse_number": "५-४३-५९", "content_sanskrit": "तस्य पर्येषणं गच्छेत्प्रत्यर्थिषु कथञ्चन।\nअविचिन्वन्निमं वेदे तपः पश्यति तं प्रभुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2037001, "chapter_id": 1798, "verse_number": "५-४३-६०", "content_sanskrit": "तूष्णींभूत उपासीत न चेष्टेन्मनसापि च।\nउपावर्तस्व तद्ब्रह्म अन्तरात्मनि विश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2037002, "chapter_id": 1798, "verse_number": "५-४३-६१", "content_sanskrit": "मौनान्न स मुनिर्भवति नारण्यवसनान्मुनिः ।\nस्वलक्षणं तु यो वेद स मुनिः श्रेष्ठ उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2037003, "chapter_id": 1798, "verse_number": "५-४३-६२", "content_sanskrit": "सर्वार्थानां व्याकरणाद्वैयाकरण उच्यते।\nतन्मूलतो व्याकरणं व्याकरोतीति तत्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2037004, "chapter_id": 1798, "verse_number": "५-४३-६३", "content_sanskrit": "प्रत्यक्षदर्शी लोकानां सर्वदर्शी भवेन्नरः ।\nसत्ये वै ब्राह्मणस्तिष्ठंस्तद्विद्वान्सर्वविद्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2037005, "chapter_id": 1798, "verse_number": "५-४३-६४", "content_sanskrit": "धर्मादिषु स्थितोऽप्येवं क्षत्रिय ब्रह्म पश्यति।\nवेदानां चानुपूर्व्येण एतद्बुद्ध्या ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2037006, "chapter_id": 1798, "verse_number": "", "content_sanskrit": "॥इति श्रीमन्महाभारते उद्योगपर्वणि सनत्सुजातपर्वणि त्रिचत्वारिंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]