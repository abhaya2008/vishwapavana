[{"id": 2023456, "chapter_id": 1501, "verse_number": "३-१३९-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023457, "chapter_id": 1501, "verse_number": "३-१३९-१", "content_sanskrit": "भरद्वाजस्तु कौन्तेय कृत्वा स्वाध्यायमाह्निकम्।\nसमित्कलापमादाय प्रविवेश स्वमाश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023458, "chapter_id": 1501, "verse_number": "३-१३९-२", "content_sanskrit": "तं स्म दृष्ट्वा पुरा सर्वे प्रत्युत्तिष्ठिन्ति पावकाः।\nन त्वेनमुपतिष्ठन्ति हतपुत्रं तदाऽग्नयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023459, "chapter_id": 1501, "verse_number": "३-१३९-३", "content_sanskrit": "वैकृतंत्वग्निहोत्रे स लक्षयित्वा महातपाः।\nतमन्धं शूद्रमासीनं गृहपालमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023460, "chapter_id": 1501, "verse_number": "३-१३९-४", "content_sanskrit": "किंनु मे नाग्नयः शूद्र प्रतिनन्दन्ति दर्शनम्।\nत्वं चापि न यथापूर्वं कच्चित्क्षेममिहाश्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023461, "chapter_id": 1501, "verse_number": "३-१३९-५", "content_sanskrit": "कच्चिन्न रैभ्यं पुत्रो मे गतवानल्पचेतनः।\nएतदाचक्ष्व मे शीघ्रं न हि शुद्ध्यति मे मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023462, "chapter_id": 1501, "verse_number": "३-१३९-६x", "content_sanskrit": "शूद्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023463, "chapter_id": 1501, "verse_number": "३-१३९-६", "content_sanskrit": "रैभ्यं यातो नूनमयं पुत्रस्ते मन्दचेतनः।\nतथाहि निहतः शेते राक्षसेन महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023464, "chapter_id": 1501, "verse_number": "३-१३९-७", "content_sanskrit": "प्रकाल्यमानस्तेनायं शूलहस्तेन रक्षसा।\nअग्न्यगारं प्रतिद्वारि मया दोर्भ्यां निवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023465, "chapter_id": 1501, "verse_number": "३-१३९-८", "content_sanskrit": "ततः स विहताशोऽत्रजलकामोशुचिर्ध्रुवम्।\nनिहतः सोऽतिवेगेन शूलहस्तेन रक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023466, "chapter_id": 1501, "verse_number": "३-१३९-८x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023467, "chapter_id": 1501, "verse_number": "३-१३९-९", "content_sanskrit": "भरद्वाजस्तु तच्छ्रुत्वा शूद्रस्य विप्रियं महत्।\nगतासुं पुत्रमादाय विललाप सुदुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023468, "chapter_id": 1501, "verse_number": "३-१३९-१०x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023469, "chapter_id": 1501, "verse_number": "३-१३९-१०", "content_sanskrit": "रब्राह्मणानां किलार्थाय ननु त्वं तप्तवांस्तपः।\nद्विजानामनधीता वै वेदाः संप्रतिभान्त्विति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023470, "chapter_id": 1501, "verse_number": "३-१३९-११", "content_sanskrit": "तथा कल्याणशीलस्त्वं ब्राह्मणेषुमहात्मसु।\nअनागाः सर्वभूतेषु कर्कशत्वमुपेयिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023471, "chapter_id": 1501, "verse_number": "३-१३९-१२", "content_sanskrit": "प्रतिषिद्धो मया तात रैभ्यावसथदर्शनात्।\nगतवानेव तं क्षुद्रं कालान्तकयमोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023472, "chapter_id": 1501, "verse_number": "३-१३९-१३", "content_sanskrit": "यः स जानन्महातेजा वृद्धस्यैकं ममात्मजम्।\nगतवानेव कोपस्य वशं परमदुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023473, "chapter_id": 1501, "verse_number": "३-१३९-१४", "content_sanskrit": "पुत्रशोकमनुप्राप्त एष रैभ्यस्य कर्मणा।\nत्यक्ष्यामि त्वामृतेपुत्र प्राणानिष्टतमान्भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023474, "chapter_id": 1501, "verse_number": "३-१३९-१५", "content_sanskrit": "यथाऽहं पुत्रशोकेन देहं त्यक्ष्यामि किल्विषी।\nतथा ज्येष्ठः सुतो रैभ्यं हिंस्याच्छीघ्रमनागसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023475, "chapter_id": 1501, "verse_number": "३-१३९-१६", "content_sanskrit": "सुखिनो वै नरा येषां जाया पुत्रो न विद्यते।\nये पुत्रशोकमप्राप्य विचरन्ति यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023476, "chapter_id": 1501, "verse_number": "३-१३९-१७", "content_sanskrit": "ये तु पुत्रकृताच्छोकाद्भृशं व्याकुलचेतसः।\nशपन्तीष्टान्सखीनार्तास्तेभ्यः पापतरो नु कः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023477, "chapter_id": 1501, "verse_number": "३-१३९-१८", "content_sanskrit": "परासुश्च सुतो दृष्टः शप्तश्चैष्टः सखा मया।\nईदृशीमापदं कोत्र द्वितीयोऽनुविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023478, "chapter_id": 1501, "verse_number": "३-१३९-१९x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023479, "chapter_id": 1501, "verse_number": "३-१३९-१९", "content_sanskrit": "विलप्यैवं बहुविधं भरद्वाजोऽदहत्सुतम्।\nसुसमिद्धं ततः पश्चात्प्रविवेश हुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023480, "chapter_id": 1501, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि एकोनचत्वारिंशदधिकशततमोऽध्यायः ॥ १३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]