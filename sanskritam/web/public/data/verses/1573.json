[{"id": 2026771, "chapter_id": 1573, "verse_number": "३-२११-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026772, "chapter_id": 1573, "verse_number": "३-२११-१", "content_sanskrit": "स तु विप्रो महाप्राज्ञ धर्मव्याधमपृच्छत।\nशिष्टाचारं कथमहं विद्यामिति नरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026773, "chapter_id": 1573, "verse_number": "३-२११-२", "content_sanskrit": "`पञ्च कानि पवित्राणि शिष्टाचारेषु नित्यदा।\nएतदिच्छामि भद्रं ते श्रोतुं धर्मभृतांवर।\nत्वत्तो महामते व्याध तद्ब्रवीहि यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026774, "chapter_id": 1573, "verse_number": "३-२११-३x", "content_sanskrit": "व्याध उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026775, "chapter_id": 1573, "verse_number": "३-२११-३", "content_sanskrit": "यज्ञो दानं तपो वेदाः सत्यं च द्विजसत्तम।\nपञ्चैतानि पवित्राणि शिष्टाचारेषु नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026776, "chapter_id": 1573, "verse_number": "३-२११-४", "content_sanskrit": "कामक्रोधौ वशे कृत्वा दम्भं लोभमनार्जवम्।\nधर्ममित्येवं संतुष्टास्ते शिष्टाः शिष्टसंमताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026777, "chapter_id": 1573, "verse_number": "३-२११-५", "content_sanskrit": "न तेषां भिद्यते वृत्तं यज्ञस्वाध्यायशीलिनाम्।\nआचारपालनं चैव द्वितीयं शिष्टलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026778, "chapter_id": 1573, "verse_number": "३-२११-६", "content_sanskrit": "गुरुशुश्रूषणं सत्यमक्रोधो दानमेव च।\nएतच्चतुष्टयं ब्रह्मञ्शिष्टाचारेषु नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026779, "chapter_id": 1573, "verse_number": "३-२११-७", "content_sanskrit": "शिष्टाचारे मनः कृत्वा प्रतिष्ठाप्य च सर्वशः।\nयामयं लभते तुष्टिं सा न शक्या ह्यतोऽन्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026780, "chapter_id": 1573, "verse_number": "३-२११-८", "content_sanskrit": "वेदस्योपनिषत्सत्यं सत्यस्योपनिषद्दमः।\nदमस्योपनिषत्त्यागः शिष्टाचारेषु नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026781, "chapter_id": 1573, "verse_number": "३-२११-९", "content_sanskrit": "ये तु धर्मानसूयन्ते बुद्धिमोहान्विता नराः।\nअपथा गच्छतां तेषामनुयाता च पीड्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026782, "chapter_id": 1573, "verse_number": "३-२११-१०", "content_sanskrit": "ये तु शिष्टाः सुनियताः श्रुतित्यागपरायणाः।\nधर्मपन्थानमारूढाः सत्यधर्मपरायणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026783, "chapter_id": 1573, "verse_number": "३-२११-११", "content_sanskrit": "नियच्छन्ति परां बुद्धिं शिष्टाचारान्विता जनाः।\nउपाध्यायमते युक्ताः स्थित्या धर्मार्थदर्शिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026784, "chapter_id": 1573, "verse_number": "३-२११-१२", "content_sanskrit": "नास्तिकान्भिन्नमर्यादान्क्रूरान्पापमतौ स्थितान्।\nत्यज ताञ्ज्ञानमाश्रित्य धार्मिकानुपसेव्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026785, "chapter_id": 1573, "verse_number": "३-२११-१३", "content_sanskrit": "कामलोभग्रहाकीर्णं पञ्चेन्द्रियजलां नदीम्।\nनावं धृतिमयीं कृत्वा जन्मदुर्गाणि संतर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2026786, "chapter_id": 1573, "verse_number": "३-२११-१४", "content_sanskrit": "क्रमेण संचितो धर्मो बुद्धियोगमयो महान्।\nशिष्टाचारे भवेत्साधू रागः शुक्ले व वाससि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2026787, "chapter_id": 1573, "verse_number": "३-२११-१५", "content_sanskrit": "अहिंसा सत्यवचनं सर्वभूतहितं परम्।\nअहिंसा परमो धर्मः स च सत्ये प्रतिष्ठितः।\nसत्यं कृत्वा प्रतिष्ठां तु प्रवर्तन्ते प्रवृत्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2026788, "chapter_id": 1573, "verse_number": "३-२११-१६", "content_sanskrit": "सत्यमेव गरीयस्तु शिष्टाचारनिषेवितम्।\nआचारश्च सतां धर्मः सन्तो ह्याचारलक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2026789, "chapter_id": 1573, "verse_number": "३-२११-१७", "content_sanskrit": "यो यथा प्रकृतिर्जन्तुः स स्वां प्रकृतिमश्नुते।\nपापात्मा क्रोधकामादीन्दोषानाप्नोत्यनात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2026790, "chapter_id": 1573, "verse_number": "३-२११-१८", "content_sanskrit": "आरम्भो न्याययुक्तो यः स हि धऱ्म इति स्मृतः।\nअनाचारस्त्वध्रमेति एतच्छिष्टानुशासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2026791, "chapter_id": 1573, "verse_number": "३-२११-१९", "content_sanskrit": "अक्रुध्यन्तोऽनसूयन्तो निरहंकारमत्सराः।\nऋजवः शमसंपन्नाः शिष्टाचारा भवन्ति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2026792, "chapter_id": 1573, "verse_number": "३-२११-२०", "content_sanskrit": "त्रैविद्यवृद्धाः शुचयो वृत्तवन्तो मनस्विनः।\nगुरुशुश्रूषवो दान्ताः शिष्टाचारा भवन्त्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2026793, "chapter_id": 1573, "verse_number": "३-२११-२१", "content_sanskrit": "तेषामहीनसत्वानां दुष्कराचारकर्मणाम्।\nस्वैः कर्मभिः सत्कृतानां घोरत्वं संप्रणश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2026794, "chapter_id": 1573, "verse_number": "३-२११-२२", "content_sanskrit": "तं तदाचारमाश्चर्यं पुराणं शाश्वतं ध्रुवम्।\nधर्म्यं धर्मेण पश्यन्तः स्वर्गं यान्ति मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2026795, "chapter_id": 1573, "verse_number": "३-२११-२३", "content_sanskrit": "आस्तिका मानहीनाश्च द्विजातिजनपूजकाः।\nश्रुतवृत्तोपसंपन्नास्ते सन्तः स्वर्गगामिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2026796, "chapter_id": 1573, "verse_number": "३-२११-२४", "content_sanskrit": "वेदोक्तः प्रथमो धर्मो धर्मशास्त्रेषु चापरः।\nशिष्टाचीर्णश् शिष्टानां त्रिविधं धर्मलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2026797, "chapter_id": 1573, "verse_number": "३-२११-२५", "content_sanskrit": "धारणं चापि वेदानां तीर्थानामवगाहनम्।\nक्षमा सत्यार्जवं शौचं शिष्टाचारनिदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2026798, "chapter_id": 1573, "verse_number": "३-२११-२६", "content_sanskrit": "सर्वभूतदयावन्तो ह्यहिंसानिरताः सदा।\nपरुषं च न भाषन्ते सदा सन्तो द्विजप्रियाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2026799, "chapter_id": 1573, "verse_number": "३-२११-२७", "content_sanskrit": "शुभानामशुभानां च कर्मणां सबलाश्रयम्।\nविपाकमभिजानन्ति ते शिष्टाः शिष्टसंमताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2026800, "chapter_id": 1573, "verse_number": "३-२११-२८", "content_sanskrit": "न्यायोपेता गुणोपेताः सर्वलोकहितैषिणः।\nसन्तः स्वर्गजितः शक्त्या सन्निविष्टाश्च सत्पथे।\nदातारः संविभक्तारो दीनानुग्रहकारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2026801, "chapter_id": 1573, "verse_number": "३-२११-२९", "content_sanskrit": "सर्वपूज्याः श्रुतधनास्तथैव च तपस्विनः।\nसर्वभूतदयावन्तस्ते शिष्टाः शिष्टसंमताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2026802, "chapter_id": 1573, "verse_number": "३-२११-३०", "content_sanskrit": "दाननित्याः सुखान्याशु प्राप्नुवन्त्यपि च श्रियम्।\nपीडया च कलत्रस्य भृत्यानां च समाहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2026803, "chapter_id": 1573, "verse_number": "३-२११-३१", "content_sanskrit": "अतिशक्त्या प्रयच्छन्ति सन्तः सद्भिः समागताः।\nलोकयात्रां च पशय्न्तो धर्ममात्महितानि च।\nएवं सन्तोवर्तमानास्त्वेधन्ते शाश्वतीः समाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2026804, "chapter_id": 1573, "verse_number": "३-२११-३२", "content_sanskrit": "अहिंसा सत्यवचनमानृशंस्यवथार्जवम्।\nअद्रोहो नातिमानश्च ह्रीस्तितिक्षा दमः शमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2026805, "chapter_id": 1573, "verse_number": "३-२११-३३", "content_sanskrit": "धीमन्तो धृतिमन्तश्च भूतानामनुकम्पकाः।\nअकामद्वेषसंयुक्तास्ते सन्तो लोकसत्कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2026806, "chapter_id": 1573, "verse_number": "३-२११-३४", "content_sanskrit": "त्रीण्येव तु पदान्याहुः सतां वृत्तमनुस्मरन्।\nन चैव द्रुह्येद्दद्याच्च सत्यं चैव सदा वदेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2026807, "chapter_id": 1573, "verse_number": "३-२११-३५", "content_sanskrit": "सर्वत्र च दयावन्तः सन्तः करुणवेदिनः।\nगच्छन्तीह सुसंतुष्टा धर्म्यं पन्थानमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2026808, "chapter_id": 1573, "verse_number": "३-२११-३६", "content_sanskrit": "शिष्टाचारा महात्मानो येषां धर्मः सुनिश्चितः।\nअनसूया क्षमा शान्तिः संतोषः प्रियवादिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2026809, "chapter_id": 1573, "verse_number": "३-२११-३७", "content_sanskrit": "कामक्रोधपरित्यागः शिष्टाचारनिषेवणम्।\nकर्म च श्रुतसंपन्नं सतां मार्गमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2026810, "chapter_id": 1573, "verse_number": "३-२११-३८", "content_sanskrit": "शिष्टाचारं निषेवन्ते नित्यं ध्रममनुव्रताः।\nप्रज्ञाप्रासादमारूह्य मुह्यतो महतो जनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2026811, "chapter_id": 1573, "verse_number": "३-२११-३९", "content_sanskrit": "प्रेक्षन्ते लोकवृत्तानि विविधानि द्विजोत्तमाः।\nअतिषुण्यानि दानानि तानि द्विजवरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2026812, "chapter_id": 1573, "verse_number": "३-२११-४०", "content_sanskrit": "एतत्ते सर्वमाख्यातं यथाप्रज्ञं यथाश्रुतम्।\nशिष्टाचारगुणान्ब्रह्मन्पुरस्कृत्य द्विजर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2026813, "chapter_id": 1573, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि एकादशाधिकद्विशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]