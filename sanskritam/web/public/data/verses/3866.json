[{"id": 2132782, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2132783, "chapter_id": 3866, "verse_number": "१", "content_sanskrit": "भूय एव ब्राह्मणमहाभाग्यं वक्तुमर्हसीत्यब्रवीत् पाण्डवेयो मार्कण्डेयम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2132784, "chapter_id": 3866, "verse_number": "२", "content_sanskrit": "अथाचष्ट मार्कण्डेयोऽपूर्वमिदं श्रूयतां ब्राह्मणानां चरितम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2132785, "chapter_id": 3866, "verse_number": "३", "content_sanskrit": "अयोध्यायामिक्ष्वाकुकुलोद्वहः पार्थिवः परीक्षिन्नाम मृगयाम- गमत् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2132786, "chapter_id": 3866, "verse_number": "४", "content_sanskrit": "तमेकाश्वेन मृगमनुसरन्तं मृगो दूरमपाहरत् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2132787, "chapter_id": 3866, "verse_number": "५", "content_sanskrit": "अध्वनि जातश्रमः क्षुत्तृष्णाभिभूतश्चैकस्मिन् देशे नीलं गहनं वनखण्डमपश्यत् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2132788, "chapter_id": 3866, "verse_number": "६", "content_sanskrit": "तच्च विवेश ततस्तस्य वनखण्डस्य मध्येऽतीव रमणीयं सरो दृष्ट्वा साश्व एव व्यगाहत \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2132789, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "अथाश्वस्तः स बिसमृणालमश्वायाग्रतो निक्षिप्य पुष्करिणी- तीरे संविवेश । ततः शयानो मधुरं गीतमशृणोत् \t॥७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2132790, "chapter_id": 3866, "verse_number": "८", "content_sanskrit": "स श्रुत्वा चिन्तयन्नेह मनुष्यगतिं पश्यामि कस्य खल्वयं गीतशब्द इति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2132791, "chapter_id": 3866, "verse_number": "९", "content_sanskrit": "अथापश्यत्कन्यां परमरूपदर्शनीयां पुष्पाण्यवचिन्वन्तीं गायन्तीं च । अथ सा राज्ञः समीपे पर्यक्रामत् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2132792, "chapter_id": 3866, "verse_number": "१०", "content_sanskrit": "तामब्रवीद् राजा कस्यासि भद्रे का वा त्वमिति \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2132793, "chapter_id": 3866, "verse_number": "११", "content_sanskrit": "सा प्रत्युवाच कन्याऽस्मीति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2132794, "chapter_id": 3866, "verse_number": "१२", "content_sanskrit": "तां राजोवाचार्थी त्वयाऽहमिति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2132795, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "अथोवाच कन्या समयेनाहं शक्या त्वया लब्धुं नान्यथेति \t१३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2132796, "chapter_id": 3866, "verse_number": "१४", "content_sanskrit": "राजा तां समयमपृच्छत् । कः समय इति \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2132797, "chapter_id": 3866, "verse_number": "१५", "content_sanskrit": "कन्योवाच नोदकं मे दर्शयितव्यमिति \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2132798, "chapter_id": 3866, "verse_number": "१६", "content_sanskrit": "स राजा तां बाढमित्युक्त्वा तामुपयेमे कृतोद्वाहश्च राजा परीक्षित् क्रीडमानो मुदा परमया युक्तस्तूष्णीं सङ्गम्य तया सहास्ते \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2132799, "chapter_id": 3866, "verse_number": "१७", "content_sanskrit": "ततस्तत्रैवासीने राजनि सेनाऽन्वगच्छत् । सा सेनोपविष्टं राजानं परिवार्यातिष्ठत् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2132800, "chapter_id": 3866, "verse_number": "१८", "content_sanskrit": "पर्याश्वस्तश्च राजा तयैव सह शिबिकया प्रायादवघोटितया स स्वं नगरमनुप्राप्य रहसि तया सहास्ते \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2132801, "chapter_id": 3866, "verse_number": "१९", "content_sanskrit": "तत्राभ्याशस्थोऽपि कश्चिन्नापश्यदथ प्रधानामात्योऽभ्याश- चरास्तस्य स्त्रियोऽपृच्छत् । किमत्र प्रयोजनं वर्तते इत्यथा- ब्रुवंस्ताः स्त्रियः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2132802, "chapter_id": 3866, "verse_number": "२०", "content_sanskrit": "अपूर्वमिव पश्याम उदकं नात्र नीयत \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2132803, "chapter_id": 3866, "verse_number": "२१", "content_sanskrit": "इत्यथामात्योऽनुदकं वनं कारयित्वोदारवृक्षं बहुपुष्पफलमूलं तस्य मध्ये मुक्ताजालमयीं पार्श्वे वापीं गूढां सुधासलिललिप्तां स रहस्युपगम्य राजानमब्रवीत् । वनमिदमुदारमनुदकं साध्वत्र रम्यतामिति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2132804, "chapter_id": 3866, "verse_number": "२२", "content_sanskrit": "स तस्य वचनात् तयैव सह देव्या तद्वनं प्राविशत् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2132805, "chapter_id": 3866, "verse_number": "२३", "content_sanskrit": "स कदाचित् तस्मिन् कानने रम्ये तयैव सह व्यवाहरदथ क्षुत्तृष्णार्दितः श्रान्तोऽतिमुक्तकागारमपश्यत् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2132806, "chapter_id": 3866, "verse_number": "२४", "content_sanskrit": "तत्प्रविश्य राजा सह प्रियया सुधाकृतां विमलां सलिलपूर्णां वापीमपश्यत् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2132807, "chapter_id": 3866, "verse_number": "२५", "content_sanskrit": "दृष्ट्वैव च तां तस्याश्च तीरे सहैव तया देव्यावातिष्ठत् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2132808, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "अथ तां देवीं स राजाऽब्रवीत् साध्ववतर वापीसलिलमिति\t ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2132809, "chapter_id": 3866, "verse_number": "२७", "content_sanskrit": "सा तद्वचः श्रुत्वाऽवतीर्य वापीं न्यमज्जन्न पुनरुदमज्जत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2132810, "chapter_id": 3866, "verse_number": "२८", "content_sanskrit": "तां स मृगयमाणो राजा नापश्यत् । वापीमपि निःस्राव्य मण्डूकं श्वभ्रमुखे दृष्ट्वा क्रुद्ध आज्ञापयामास स राजा । सर्वत्र मण्डूकवधः क्रियतामिति यो मयार्थी स मां मृतमण्डूकोपा- यनमादायोपतिष्ठेदिति \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2132811, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "अथ मण्डूकवधे घोरे क्रियमाणे दिक्षु सर्वासु मण्डूकान् भयमाविवेश । ते भीता मण्डूकराज्ञे यथावृत्तं न्यवेदयन्\t ॥२९", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2132812, "chapter_id": 3866, "verse_number": "३०", "content_sanskrit": "ततो मण्डूकराट् तापसवेषधारी राजानमभ्यगच्छदुपेत्य चैनमुवाच ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2132813, "chapter_id": 3866, "verse_number": "३१", "content_sanskrit": "मा राजन् क्रोधवशं गमः प्रसादं कुरु । नार्हसि मण्डूका- नामनपराधिनां वधं कर्तुमिति \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2132814, "chapter_id": 3866, "verse_number": "३२", "content_sanskrit": "श्लोकौ चात्र भवतः –\nमा मण्डूकान् जिघांस त्वं कोपं सन्धारयाच्युत ।\nप्रक्षीयन्ते वधाद् भेका जनानामविजानताम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2132815, "chapter_id": 3866, "verse_number": "३३", "content_sanskrit": "प्रतिजानीहि नैतांस्त्वं प्राप्य क्रोधं विमोक्ष्यसि ।\nअलं कृत्वा तवाधर्मं मण्डूकैः किं हतैर्हि ते \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2132816, "chapter_id": 3866, "verse_number": "३४", "content_sanskrit": "तमेवंवादिनमिष्टजनशोकपरीतात्मा राजाथोवाच । न हि क्षम्यते तन्मया हनिष्याम्येतानेतैर्दुरात्मभिः प्रिया मे भक्षिता सर्वथैव मे वध्या मण्डूका नार्हसि विद्वन् मामुपरोद्धुमिति \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2132817, "chapter_id": 3866, "verse_number": "३५", "content_sanskrit": "स तद्वाक्यमुपलभ्य व्यथितेन्द्रियमनाः प्रोवाच प्रसीद राजन्नहमायुर्नाम मण्डूकराजो मम सा दुहिता सुशोभना नाम । तस्या हि दौःशील्यमेतद् बहवस्तया राजानो विप्रलब्धाः पूर्वा इति \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2132818, "chapter_id": 3866, "verse_number": "३६", "content_sanskrit": "तमब्रवीद् राजा तयाऽहमर्थी सा मे दीयतामिति\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2132819, "chapter_id": 3866, "verse_number": "३७", "content_sanskrit": "अथैनां राज्ञे पितादादब्रवीच्चैनामेनं राजानं शुश्रूषस्वेति \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2132820, "chapter_id": 3866, "verse_number": "३८", "content_sanskrit": "स एवमुक्त्वा दुहितरं क्रुद्धः शशाप यस्मात् त्वया राजानो विप्रलब्धा बहवस्तस्मादब्रह्मण्यानि तवापत्यानि भविष्यन्त्या- नृतिकत्वात् तवेति\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2132821, "chapter_id": 3866, "verse_number": "३९", "content_sanskrit": "स च राजा तामुपलभ्य तस्यां सुरतगुणनिबद्धहृदयो लोक- त्रयैश्वर्यमिवोपलभ्य हर्षेण बाष्पकलया वाचा प्रणिपत्याभिपूज्य मण्डूकराजमब्रवीदनुगृहीतोऽस्मीति \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2132822, "chapter_id": 3866, "verse_number": "४०", "content_sanskrit": "स च मण्डूकराजो दुहितरमनुज्ञाप्य यथागतमगच्छत् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2132823, "chapter_id": 3866, "verse_number": "४१", "content_sanskrit": "अथ कस्यचित्कालस्य तस्यां कुमारास्त्रयस्तस्य राज्ञः सम्बभूवुः शलो दलो बलश्चेति \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2132824, "chapter_id": 3866, "verse_number": "४२", "content_sanskrit": "ततस्तेषां ज्येष्ठं शलं समये पिता राज्येऽभिषिच्य तपसि धृतात्मा वनं जगाम\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2132825, "chapter_id": 3866, "verse_number": "४३", "content_sanskrit": "अथ कदाचिच्छलो मृगयामनुचरन् मृगमासाद्य रथेनान्व- धावत् । सूतं चोवाच । शीघ्रं मां वाहयस्वेति\t। स तथोक्तः सूतो राजानमब्रवीत् \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2132826, "chapter_id": 3866, "verse_number": "४४", "content_sanskrit": "मा क्रियतामनुबन्धो नैष शक्यस्त्वया मृगोऽयं ग्रहीतुं\nयद्यपि ते रथे युक्तौ वाम्यौ स्यातामिति \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2132827, "chapter_id": 3866, "verse_number": "४५", "content_sanskrit": "ततोऽब्रवीद् राजा सूतमाचक्ष्व मे वाम्यौ हन्मि च त्वामिति \t\t\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2132828, "chapter_id": 3866, "verse_number": "४६", "content_sanskrit": "स एवमुक्तो राजभयभीतः सूतो वामदेवशापभीतश्च सन्नाचख्यौ राज्ञे । वामदेवस्याश्वौ वाम्यौ मनोजवाविति\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2132829, "chapter_id": 3866, "verse_number": "४७", "content_sanskrit": "अथैनमेवं ब्रुवाणमब्रवीद् राजा वामदेवाश्रमं प्रयाहीति\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2132830, "chapter_id": 3866, "verse_number": "४८", "content_sanskrit": "स गत्वा वामदेवाश्रमं तमृषिमब्रवीत् । भगवन् मृगो मे विद्धः पलायते सम्भावयितुम् अर्हसि वाम्यौ दातुमिति \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2132831, "chapter_id": 3866, "verse_number": "४९", "content_sanskrit": "तमब्रवीदृषिर्ददानि ते वाम्यौ । कृतकार्येण भवता । ममैव वाम्यौ निर्यात्यौ क्षिप्रमिति \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2132832, "chapter_id": 3866, "verse_number": "५०", "content_sanskrit": "स च तावश्वौ प्रतिगृह्यानुज्ञाप्य ऋषिं प्रायाद् वामी-\nप्रयुक्तेन रथेन मृगं प्रतिगच्छंश्चाब्रवीत् सूतम् अश्वरत्ना- विमावयोग्यौ ब्राह्मणानां नैतौ प्रतिदेयौ वामदेवायेत्युक्त्वा मृग- मवाप्य स्वनगरमेत्याश्वावन्तःपुरेऽस्थापयत् \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2132833, "chapter_id": 3866, "verse_number": "५१", "content_sanskrit": "अथर्षिश्चिन्तयामास तरुणो राजपुत्रः कल्याणं पत्रमासाद्य रमते न प्रतिनिर्यातयत्यहो कष्टमिति \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2132834, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "स मनसा विचिन्त्य मासि पूर्णे शिष्यमब्रवीत् । गच्छात्रेय राजानं ब्रूहि यदि पर्याप्तं निर्यातयोपाध्यायवाम्याविति \t॥५२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2132835, "chapter_id": 3866, "verse_number": "५३", "content_sanskrit": "स गत्वैवं तं राजानमब्रवीत् तत्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2132836, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "राजा प्रत्युवाच राज्ञामेतद् वाहनमनर्हा ब्राह्मणा रत्नाना- मेवंविधानां किं ब्राह्मणानाम् अश्वैः कार्यं साधु गम्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2132837, "chapter_id": 3866, "verse_number": "५५", "content_sanskrit": "स गत्वैतदुपाध्यायायाचष्ट \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2132838, "chapter_id": 3866, "verse_number": "५६", "content_sanskrit": "तच्छ्रुत्वा वचनमप्रियं वामदेवः क्रोधपरीतात्मा स्वयमेव राजानमभिगम्याश्वार्थमचोदयन्न चाददद् राजा \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2132839, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "वामदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2132840, "chapter_id": 3866, "verse_number": "५७", "content_sanskrit": "प्रयच्छ वाम्यौ मम पार्थिव त्वं\nकृतं हि ते कार्यमन्यैर(माभ्याम)शक्यम् ।\nमा त्वा वधीद् वरुणो घोरपाशै-\nर्ब्रह्मक्षत्रस्यान्तरे वर्तमानः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2132841, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2132842, "chapter_id": 3866, "verse_number": "५८", "content_sanskrit": "अनड्वाहौ सुव्रतौ साधु दान्ता-\nवेतद् विप्राणां वाहनं वामदेव ।\nताभ्यां याहि त्वं तत्र कामो महर्षे\nछन्दांसि वै त्वादृशं संवहन्ति \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2132843, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "वामदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2132844, "chapter_id": 3866, "verse_number": "५९", "content_sanskrit": "छन्दांसि वै मादृशं संवहन्ति\nलोकेऽमुष्मिन्पार्थिव यानि सन्ति ।\nअस्मिंस्तु लोके मम यानमेतद-\nस्मद् विधानामपरेषां च राजन् \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2132845, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2132846, "chapter_id": 3866, "verse_number": "६०", "content_sanskrit": "चत्वारस्त्वां वा गर्दभाः संवहन्तु\nश्रेष्ठाश्वतर्यो हरयो वातरंहाः ।\nतैस्त्वं याहि क्षत्रियस्यैष वाहो\nममैव वाम्यौ न तवैतौ हि विद्धि \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2132847, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "वामदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2132848, "chapter_id": 3866, "verse_number": "६१", "content_sanskrit": "घोरं व्रतं ब्राह्मणस्यैतदाहु-\nरेतद् राजन् यदिहाजीवमानः ।\nअयस्मया घोररूपा महान्त-\nश्चत्वारो वा यातुधानाः सुरौद्राः ।\nमया प्रयुक्तास्त्वद् वधमीप्समाना\nवहन्तु त्वां शितशूलाश्चतुर्धा \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2132849, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2132850, "chapter_id": 3866, "verse_number": "६२", "content_sanskrit": "ये त्वां विदुर्ब्राह्मणं वामदेव\nवाचा हन्तुं मनसा कर्मणा वा ।\nते त्वां सशिष्यमिह पातयन्तु\nमद्वाक्यनुन्नाः शितशूलासिहस्ताः \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2132851, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "(वामदेवः –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2132852, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "ममैतौ वाम्यौ प्रतिगृह्य राजन् पुनर्ददानीति प्रपद्य मे त्वम् ।\nप्रयच्छ शीघ्रं मम वाम्यौ त्वमश्वौ यद्यात्मानं जीवितुं ते क्षमं स्यात्। राजा –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2132853, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "न ब्राह्मणेभ्यो मृगया प्रसूता न त्वानुशास्म्यद्य प्रभृति ह्यसत्यम् ।\nतवैवाज्ञां सम्प्रणिधाय सर्वां तथा ब्रह्मन्पुपयलोकं लभेयम् ।)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2132854, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "वामदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2132855, "chapter_id": 3866, "verse_number": "६३", "content_sanskrit": "नानुयोगा ब्राह्मणानां भवन्ति\nवाचा राजन् मनसा कर्मणा वा ।\nयस्त्वेतद्ब्रह्म तपसाऽत्येति विद्वां-\nस्तेन श्रेष्ठो भवति हि जीवमानः \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2132856, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2132857, "chapter_id": 3866, "verse_number": "६४", "content_sanskrit": "एवमुक्ते वामदेवेन राजन्\nसमुत्तस्थू राक्षसा घोररूपाः ।\nतै शूलहस्तैर्वध्यमानः स राजा\nप्रोवाचेदं वाक्यमुच्चैस्तदानीम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2132858, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "राजा-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2132859, "chapter_id": 3866, "verse_number": "६५", "content_sanskrit": "ऐक्ष्वाकवो यदि ब्रह्मन् दलो वा\nविधेया मे यदि वाऽन्ये विशोऽपि ।\nनोत्स्रक्ष्येऽहं वामदेवस्य वाम्यौ\nनैवंविधा धर्मशीला भवन्ति\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2132860, "chapter_id": 3866, "verse_number": "६६", "content_sanskrit": "एवं ब्रुवन्नेव स यातुधानै-\nर्हतो जगामाशु महीं क्षितीशः ।\nततो विदित्वा नृपतिं निपातित-\nमिक्ष्वाकवो वै दलमभ्यषिञ्चन् \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2132861, "chapter_id": 3866, "verse_number": "६७", "content_sanskrit": "राज्ये तदा तत्र गत्वा स विप्रः\nप्रोवाचेदं वचनं वामदेवः ।\nदलं राजानं ब्राह्मणानां हि देय-\nमेवं राजन् सर्वधर्मेषु दृष्टम् \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2132862, "chapter_id": 3866, "verse_number": "६८", "content_sanskrit": "बिभेषि चेत् त्वमधर्मान् नरेन्द्र\nप्रयच्छ मे शीघ्रमेवाद्य वाम्यौ ।\nएतच्छ्रुत्वा वामदेवस्य वाक्यं\nस पार्थिवः सूतमुवाच रोषात् \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2132863, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "दलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2132864, "chapter_id": 3866, "verse_number": "६९", "content_sanskrit": "एकं हि सायकं चित्ररूपं\nदिग्धं विषेणाहर सङ्गृहीतम् ।\nयेन विद्धो वामदेवः शयीत\nसन्दश्यमानः श्वभिरार्तरूपः \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2132865, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "वामदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2132866, "chapter_id": 3866, "verse_number": "७०", "content_sanskrit": "जानामि पुत्रं दशवर्षं तवाहं\nजातं महिष्यां श्येनजितं नरेन्द्र ।\nतं जहि त्वं मद्वचनात् प्रणुन्न-\nस्तूर्णं प्रियैः(यं) सायकैर्घोररूपैः \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2132867, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2132868, "chapter_id": 3866, "verse_number": "७१", "content_sanskrit": "एवमुक्तो वामदेवेन राजन्\nअन्तःपुरे राजपुत्रं जघान ।\nस सायकस्तिग्मतेजा विसृष्टः\nश्रुत्वा दलस्तत्र वाक्यं बभाषे \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2132869, "chapter_id": 3866, "verse_number": "७२", "content_sanskrit": "इक्ष्वाकवो हन्त चरामि वः प्रियं\nनिहन्मीमं विप्रमद्य प्रमथ्य ।\nआनीयतामपरस्तिग्मतेजाः\nपश्यध्वं मे वीर्यमद्य क्षितीशाः \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2132870, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "वामदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2132871, "chapter_id": 3866, "verse_number": "७३", "content_sanskrit": "यत् त्वमेनं सायकं घोररूपं\nविषेण दिग्धं मम सन्दधासि ।\nन त्वेतं त्वं शरवर्षं विमोक्तुं\nसन्धातुं वा शक्यसे मानवेन्द्र \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2132872, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2132873, "chapter_id": 3866, "verse_number": "७४", "content_sanskrit": "इक्ष्वाकवः पश्यत मां गृहीतं\nन वै शक्नोम्येष शरं विमोक्तुम् ।\nन चास्य कर्तुं नाशमभ्युत्सहामि\nआयुष्मान् वै जीवतु वामदेवः \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2132874, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "वामदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2132875, "chapter_id": 3866, "verse_number": "७५", "content_sanskrit": "संस्पृश्यैनां महिषीं सायकेन\nततस्तस्मादेनसो मोक्ष्यसे त्वम् \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2132876, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2132877, "chapter_id": 3866, "verse_number": "७६", "content_sanskrit": "ततस्तथा कृतवान् पार्थिवस्तु\nततो मुनिं राजपुत्री बभाषे \t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2132878, "chapter_id": 3866, "verse_number": "७७", "content_sanskrit": "यथा युक्ता वामदेवाहमेनं\nदिने दिने सन्दिशन्ती नृशंसम् ।\nब्राह्मणेभ्यो मृगयती सूनृतानि\nतथा ब्रह्मन् पुण्यलोकं लभेयम् \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2132879, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "वामदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2132880, "chapter_id": 3866, "verse_number": "७८", "content_sanskrit": "त्वया त्रातं राजकुलं शुभेक्षणे\nवरं वृणीष्वाप्रतिमं ददानि ते ।\nप्रशाधीमं स्वजनं राजपुत्रि\nइक्ष्वाकुराज्यं सुमहच्चाप्यनिन्द्ये \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2132881, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "राजपुत्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2132882, "chapter_id": 3866, "verse_number": "७९", "content_sanskrit": "वरं वृणे भगवंस्त्वेवमेष\nविमुच्यतां किल्बिषादद्य भर्ता ।\nशिवेन चाध्याहि सपुत्रबान्धवं\nवरो वृतो ह्येष मया द्विजाग्र्य\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2132883, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2132884, "chapter_id": 3866, "verse_number": "८०", "content_sanskrit": "श्रुत्वा वचः स मुनी राजपुत्र्याः\nतथास्त्विति प्राह कुरुप्रवीर ।\nततः स राजा मुदितो बभूव\nवाम्यौ चास्मै प्रददौ सम्प्रणम्य \t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2132885, "chapter_id": 3866, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि सप्ताशीत्यधिकशततमोऽध्यायः ॥ १८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2132886, "chapter_id": 3866, "verse_number": "", "content_sanskrit": "मार्कण्डेयसमास्यापर्वणि द्वादशोऽध्यायः ॥१२॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}]