[{"id": 7006259000, "chapter_id": 26259, "verse_number": "३-१३-१", "content_sanskrit": "देवा ऊचुः जय देवि जगन्मातर्जय देवि परात्परे ।\nजय कल्याणनिलये जय कामकलात्मिके ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006259001, "chapter_id": 26259, "verse_number": "३-१३-२", "content_sanskrit": "जयकारि च वामाक्षि जय कामाक्षि सुन्दरि ।\nजयाखिलसुराराध्ये जय कामेशि मानदे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006259002, "chapter_id": 26259, "verse_number": "३-१३-३", "content_sanskrit": "जय ब्रह्ममये देवि ब्रह्मात्मकरसात्मिके ।\nजय नारायणि परे नन्दिताशेषविष्टपे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006259003, "chapter_id": 26259, "verse_number": "३-१३-४", "content_sanskrit": "जय श्रीकण्ठदयिते जय श्रीललितेंबिके ।\nजय श्रीविजये देवि विजय श्रीसमृद्धिदे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006259004, "chapter_id": 26259, "verse_number": "३-१३-५", "content_sanskrit": "जातस्य जायमानस्य इष्टापूर्तस्य हेतवे ।\nनमस्तस्यै त्रिजगतां पालयित्र्यै परात्परे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006259005, "chapter_id": 26259, "verse_number": "३-१३-६", "content_sanskrit": "कलामुहूर्तकाष्ठाहर्मासर्तुशरदात्मने ।\nनमः सहस्रशीर्षायै सहस्रमुखलोचने ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006259006, "chapter_id": 26259, "verse_number": "३-१३-७", "content_sanskrit": "नमः सहस्रहस्ताब्जपादपङ्कजशोभिते ।\nअणोरणुतरे देवि महतोऽपि महीयसि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006259007, "chapter_id": 26259, "verse_number": "३-१३-८", "content_sanskrit": "परात्परतरे मातस्तेजस्तेजीयसामपि ।\nअतलं तु भवेत्पादौ वितलं जानुनी तव ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006259008, "chapter_id": 26259, "verse_number": "३-१३-९", "content_sanskrit": "रसातलं कटीदेशः कुक्षिस्ते धरणी भवेत् ।\nहृदयं तु भुवर्लोकः स्वस्ते मुखमुदाहृतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006259009, "chapter_id": 26259, "verse_number": "३-१३-१०", "content_sanskrit": "दृशश्चन्द्रार्कदहना दिशस्ते बाहवोंबिके ।\nमरुतस्तु तवोच्छ्वासा वाचस्ते श्रुतयोऽखिलाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006259010, "chapter_id": 26259, "verse_number": "३-१३-११", "content_sanskrit": "क्रीडा ते लोकरचना सखा ते चिन्मयः शिवः ।\nआहारस्ते सदानन्दो वासस्ते हृदये सताम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006259011, "chapter_id": 26259, "verse_number": "३-१३-१२", "content_sanskrit": "दृश्यादृश्य स्वरूपाणि रूपाणि भुवनानि ते ।\nशिरोरुहा घनास्ते तु तारकाः कुसुमानि ते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006259012, "chapter_id": 26259, "verse_number": "३-१३-१३", "content_sanskrit": "धर्माद्या बाहवस्ते स्युरधर्माद्यायुधानि ते ।\nयमाश्च नियमाश्चैव करपादरुहास्तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006259013, "chapter_id": 26259, "verse_number": "३-१३-१४", "content_sanskrit": "स्तनौ स्वाहास्वधाकरौ लोकोज्जीवनकारकौ ।\nप्राणायामस्तु ते नासा रसना ते सरस्वती ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006259014, "chapter_id": 26259, "verse_number": "३-१३-१५", "content_sanskrit": "प्रत्याहारस्त्विद्रिंयाणि ध्यानं ते धीस्तु सत्तमा ।\nमनस्ते धारणाशक्तिर्हृदयं ते समाधिकः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006259015, "chapter_id": 26259, "verse_number": "३-१३-१६", "content_sanskrit": "महीरुहास्तेङ्गरुहाः प्रभातं वसनं तव ।\nभूतं भव्यं भविष्यच्च नित्यं च तव विग्रहः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006259016, "chapter_id": 26259, "verse_number": "३-१३-१७", "content_sanskrit": "यज्ञरूपा जगद्धात्री विश्वरूपा च पावनी ।\nआदौ या तु दयाभूता ससर्ज निखिलाः प्रजाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006259017, "chapter_id": 26259, "verse_number": "३-१३-१८", "content_sanskrit": "हृदयस्थापि लोकानामदृश्या मोहनात्मिका ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006259018, "chapter_id": 26259, "verse_number": "३-१३-१९", "content_sanskrit": "नामरूपविभागं च या करोति स्वलीलया ।\nतान्यधिष्ठाय तिष्ठन्ती तेष्वसक्तार्थकामदा ।\nनमस्तस्यै महादेव्यै सर्वशक्त्यै नमोनमः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006259019, "chapter_id": 26259, "verse_number": "३-१३-२०", "content_sanskrit": "यदाज्ञया प्रवर्तन्ते वह्निसूर्यैदुमारुताः ।\nपृथिव्यादीनि भूतानि तस्यै देव्यै नमोनमः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006259020, "chapter_id": 26259, "verse_number": "३-१३-२१", "content_sanskrit": "या ससर्जादिधातारं सर्गादावादिभूरिदम् ।\nदधार स्वयमेवैका तस्यै देव्यै नमोनमः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006259021, "chapter_id": 26259, "verse_number": "३-१३-२२", "content_sanskrit": "यथा धृता तु धरिणी ययाकाशममेयया ।\nयस्यामुदेति सविता तस्यै देव्यै नमोनमः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006259022, "chapter_id": 26259, "verse_number": "३-१३-२३", "content_sanskrit": "यत्रोदेति जगत्कृत्स्नं यत्र तिष्ठति निर्भरम् ।\nयत्रान्तमेति काले तु तस्यै देव्यै नमोनमः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006259023, "chapter_id": 26259, "verse_number": "३-१३-२४", "content_sanskrit": "नमोनमस्ते रजसे भवायै नमोनमः सात्त्विकसंस्थितायै ।\nनमोनमस्ते तमसे हरायै नमोनमो निर्गुणतः शिवायै ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006259024, "chapter_id": 26259, "verse_number": "३-१३-२५", "content_sanskrit": "नमोनमस्ते जगदेकमात्रे नमोनमस्ते जगदेकपित्रे ।\nनमोनमस्तेऽखिलरूपतन्त्रे नमोनमस्तेऽखिलयन्त्ररूपे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006259025, "chapter_id": 26259, "verse_number": "३-१३-२६", "content_sanskrit": "नमोनमो लोकगुरुप्रधाने नमोनमस्तेऽखिलवाग्विभूत्यै ।\nनमोऽस्तु लक्ष्म्यै जगदेकतुष्ट्यै नमोनमः शांभवि सर्वशक्त्यै ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006259026, "chapter_id": 26259, "verse_number": "३-१३-२७", "content_sanskrit": "अनादिमध्यान्तमपाञ्चभौतिकं ह्यवाङ्मनोगम्यमतर्क्यवैभवम् ।\nअरूपमद्वन्द्वमदृष्टगोचरं प्रभावमग्र्यं कथमंब वर्णये ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006259027, "chapter_id": 26259, "verse_number": "३-१३-२८", "content_sanskrit": "प्रसीद विश्वेश्वरि विश्ववन्दिते प्रसीद विद्येश्वरि वेदरूपिणि ।\nप्रसीद मायामयि मन्त्राविग्रहे प्रसीद सर्वेश्वरि सर्वरूपिणि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006259028, "chapter_id": 26259, "verse_number": "३-१३-२९", "content_sanskrit": "इति स्तत्वा महादेवीं देवाः सर्वे सवासवाः ।\nभूयोभूयो नमस्कृत्य शरणं जगमुरञ्जसा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006259029, "chapter_id": 26259, "verse_number": "३-१३-३०", "content_sanskrit": "ततः प्रसन्ना सा देवी प्रणतं वीक्ष्य वासवम् ।\nवरेण च्छन्दयामास वरदाखिलदेहिनाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006259030, "chapter_id": 26259, "verse_number": "३-१३-३१", "content_sanskrit": "इन्द्र उवाच यदि तुष्टासि कर्याणि वरं दैत्येन्द्र पीडितः ।\nदुर्धरं जीवितं देहि त्वां गताः शरणार्थिनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006259031, "chapter_id": 26259, "verse_number": "३-१३-३२", "content_sanskrit": "श्रीदेव्युवाच अहमेव विनिर्जित्य भण्डं दैत्यकुलोद्भवम् ।\nअचिरात्तव दास्यामि त्रैलोक्यं सचराचरम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006259032, "chapter_id": 26259, "verse_number": "३-१३-३३", "content_sanskrit": "निर्भया मुदिताः सन्तु सर्वे देवगणास्तथा ।\nये स्तोष्यन्ति च मां भक्त्या स्तवेनानेन मानवाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006259033, "chapter_id": 26259, "verse_number": "३-१३-३४", "content_sanskrit": "भाजनं ते भविष्यन्ति धर्मश्रीयशसां सदा ।\nविद्याविनयसंपन्ना नीरोगा दीर्घजीविनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006259034, "chapter_id": 26259, "verse_number": "३-१३-३५", "content_sanskrit": "पुत्रमित्रकल त्राढ्या भवन्तु मदनुग्रहात् ।\nइति लब्धवरा देवा देवेन्द्रोऽपि महाबलः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006259035, "chapter_id": 26259, "verse_number": "३-१३-३६", "content_sanskrit": "आमोदं परमं जग्मुस्तां विलोक्य मुहुर्मुहुः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]