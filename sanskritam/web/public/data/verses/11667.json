[{"id": 50020592, "chapter_id": 11667, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50020593, "chapter_id": 11667, "verse_number": "2", "content_sanskrit": "गोविन्दभुजगुप्तायां द्वारकायां कुरूद्वह। अवात्सीन्नारदोऽभीक्ष्णं कृष्णोपासनलालसः॥ ११/२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50020594, "chapter_id": 11667, "verse_number": "3", "content_sanskrit": "को नु राजन्निन्द्रियवान् मुकुन्दचरणाम्बुजम्। न भजेत् सर्वतोमृत्युरुपास्यममरोत्तमैः॥ ११/२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50020595, "chapter_id": 11667, "verse_number": "4", "content_sanskrit": "तमेकदा तु देवर्षिं वसुदेवो गृहागतम्। अर्चितं सुखमासीनमभिवन्द्येदमब्रवीत्॥ ११/२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50020596, "chapter_id": 11667, "verse_number": "5", "content_sanskrit": "वसुदेव उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50020597, "chapter_id": 11667, "verse_number": "6", "content_sanskrit": "भगवन् भवतो यात्रा स्वस्तये सर्वदेहिनाम्। कृपणानां यथा पित्रोरुत्तमश्लोकवर्त्मनः॥ ११/२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50020598, "chapter_id": 11667, "verse_number": "7", "content_sanskrit": "भूतानां देवचरितं दुःखाय च सुखाय च। सुखायैव हि साधूनां त्वादृशामच्युतात्मनाम्॥ ११/२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50020599, "chapter_id": 11667, "verse_number": "8", "content_sanskrit": "भजन्ति ये यथा देवान् देवा अपि तथैव तान्। छायेव कर्मसचिवाः साधवो दीनवत्सलाः॥ ११/२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50020600, "chapter_id": 11667, "verse_number": "9", "content_sanskrit": "ब्रह्मंस्तथापि पृच्छामो धर्मान् भागवतांस्तव। यान् श्रुत्वा श्रद्धया मर्त्यो मुच्यते सर्वतोभयात्॥ ११/२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50020601, "chapter_id": 11667, "verse_number": "10", "content_sanskrit": "अहं किल पुराऽनन्तं प्रजार्थे भुवि मुक्तिदम्। अपूजयं न मोक्षाय मोहितो देवमायया॥ ११/२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50020602, "chapter_id": 11667, "verse_number": "11", "content_sanskrit": "यथा विचित्रव्यसनाद् भवेऽस्मिन् विश्वतोभयात्। मुच्येमह्यञ्जसैवाद्धा तथा नः शाधि सुव्रत॥ ११/२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50020603, "chapter_id": 11667, "verse_number": "12", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50020604, "chapter_id": 11667, "verse_number": "13", "content_sanskrit": "राजन्नेवंकृतप्रश्नो वसुदेवेन धीमता। प्रीतस्तमाह देवर्षिर्हरेः संस्मारितो गुणैः॥ ११/२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50020605, "chapter_id": 11667, "verse_number": "14", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50020606, "chapter_id": 11667, "verse_number": "15", "content_sanskrit": "सम्यगेतद् व्यवसितं भवता सात्वतर्षभ। यत् पृच्छसे भागवतान् धर्मांस्त्वं विश्वभावनान्॥ ११/२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50020607, "chapter_id": 11667, "verse_number": "16", "content_sanskrit": "श्रुतोऽनुपठितो ध्यात आदृतो वाऽनुमोदितः। सद्यः पुनाति सद्धर्मो देवविश्वद्रुहोऽपि हि॥ ११/२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50020608, "chapter_id": 11667, "verse_number": "17", "content_sanskrit": "त्वया परमकल्याण पुण्यश्रवणकार्तनः। स्मारितो भगवानद्य देवो नारायणो मम॥ ११/२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50020609, "chapter_id": 11667, "verse_number": "18", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्। आर्षभाणां च संवादं विदेहस्य महात्मनः॥ ११/२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50020610, "chapter_id": 11667, "verse_number": "19", "content_sanskrit": "प्रियव्रतो नाम सुतो मनोः स्वायम्भुवस्य यः। तस्याग्नीध्रस्ततो नाभिऋर्षभस्तत्सुतः स्मृतः॥ ११/२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50020611, "chapter_id": 11667, "verse_number": "20", "content_sanskrit": "तमाहुर्वासुदेवांशं मोक्षधर्मविवक्षया। अवतीर्णं सुतशतं तस्यासीद् ब्रह्मपारगम्॥ ११/२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50020612, "chapter_id": 11667, "verse_number": "21", "content_sanskrit": "तेषां वै भरतो ज्येष्ठो नारायणपरायणः। विख्यातं वर्षमेतद् यन्नाम्ना भारतमद्भुतम्॥ ११/२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50020613, "chapter_id": 11667, "verse_number": "22", "content_sanskrit": "स भुक्तभोगां त्यक्त्वेमां निर्गतस्तपसा हरिम्। उपासीनस्तत्पदवीं लेभे वै जन्मभिस्त्रिभिः॥ ११/२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50020614, "chapter_id": 11667, "verse_number": "23", "content_sanskrit": "तेषां नव नवद्वीपपतयोऽस्य समन्ततः। कर्मतन्त्रप्रणेतार एकाशीतिर्द्विजातयः॥ ११/२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50020615, "chapter_id": 11667, "verse_number": "24", "content_sanskrit": "नवाभवन् महाभागा मुनयो ह्यूर्ध्वमन्थिनः। श्रमणा वातरशना आत्मविद्याविशारदाः॥ ११/२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50020616, "chapter_id": 11667, "verse_number": "25", "content_sanskrit": "कविर्हरिरन्तरिक्षः प्रबुद्धः पिप्पलायनः। आविर्होत्रोऽथ द्रुमिलश्चमसः करभाजनः॥ ११/२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50020617, "chapter_id": 11667, "verse_number": "26", "content_sanskrit": "त एते भगवद्रूपं विश्वं सदसदात्मकम्। आत्मनो व्यतिरेकेण पश्यन्तो व्यचरन् महीम्॥ ११/२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50020618, "chapter_id": 11667, "verse_number": "27", "content_sanskrit": "अव्याहतात्मगतयः सुरसिद्धसाध्य- गन्धर्वयक्षनरकिन्नरनागलोकान्। मुक्ताश्चरन्ति मुनिचारणभूतनाथ- विद्याधरद्विजगवां भवनानि कामम्॥ ११/२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50020619, "chapter_id": 11667, "verse_number": "28", "content_sanskrit": "त एकदा निमेः सत्रमुपजग्मुर्यदृच्छया। वितायमानमृषिभिराञ्जनाभा महात्मनः॥ ११/२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50020620, "chapter_id": 11667, "verse_number": "29", "content_sanskrit": "तान् दृष्ट्वा सूर्यसङ्काशान् महाभागवतान् नृप। यजमानोऽग्नयो विप्राः सर्व एवोपतस्थिरे॥ ११/२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50020621, "chapter_id": 11667, "verse_number": "30", "content_sanskrit": "विदेहस्तानभिप्रेत्य नारायणपरायणान्। प्रीतः सम्पूजयाञ्चक्र आसनस्थान् यथार्हतः॥ ११/२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50020622, "chapter_id": 11667, "verse_number": "31", "content_sanskrit": "तान् रोचमानान् स्वरुचा ब्रह्मपुत्रोपमान् नव। पप्रच्छ परमप्रीतः प्रश्रयावनतो नृपः॥ ११/२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50020623, "chapter_id": 11667, "verse_number": "32", "content_sanskrit": "विदेह उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50020624, "chapter_id": 11667, "verse_number": "33", "content_sanskrit": "मन्ये भगवतः साक्षात् पार्षदान् वो मधुद्विषः। विष्णोर्भूतानि लोकानां पावनाय चरन्ति हि॥ ११/२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50020625, "chapter_id": 11667, "verse_number": "34", "content_sanskrit": "दुर्लभो मानुषो देहो देहिनां क्षणभङ्गुरः। तत्रापि दुर्लभं मन्ये वैकुण्ठप्रियदर्शनम्॥ ११/२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50020626, "chapter_id": 11667, "verse_number": "35", "content_sanskrit": "अत आत्यन्तिकं क्षेमं पृच्छामो भवतोऽनघाः। संसारेऽस्मिन् क्षणार्धोऽपि सत्सङ्गः शेवधिर्नृणाम्॥ ११/२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50020627, "chapter_id": 11667, "verse_number": "36", "content_sanskrit": "धर्मान् भागवतान् ब्रूत यदि नः श्रुतये क्षमम्। यैः प्रसन्नः प्रपन्नाय दास्यत्यात्मानमप्यजः॥ ११/२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50020628, "chapter_id": 11667, "verse_number": "37", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50020629, "chapter_id": 11667, "verse_number": "38", "content_sanskrit": "एवं ते निमिना पृष्टा वसुदेव महत्तमाः। प्रतिपूज्याब्रुवन् प्रीत्या ससदर्स्यत्विजं नृपम्॥ ११/२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50020630, "chapter_id": 11667, "verse_number": "39", "content_sanskrit": "कविरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50020631, "chapter_id": 11667, "verse_number": "40", "content_sanskrit": "मन्येऽकुतश्चिद्भयमच्युतस्य पादाम्बुजोपासनमत्र नित्यम्। उद्विग्नबुद्धेरसदात्मभावाद् विश्वात्मना यत्र निवर्तते भीः॥ ११/२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50020632, "chapter_id": 11667, "verse_number": "41", "content_sanskrit": "ये वै भगवता प्रोक्ता उपाया आत्मलब्धये। अञ्जः पुंसामविदुषां विद्धि भागवतान् हि तान्॥ ११/२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50020633, "chapter_id": 11667, "verse_number": "42", "content_sanskrit": "यानास्थाय नरो राजन् न प्रमाद्येत कर्हिचित्। धावन्नुन्मील्य वा नेत्रे न स्खलेन्न पतेदिह॥ ११/२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50020634, "chapter_id": 11667, "verse_number": "43", "content_sanskrit": "कायेन वाचा मनसेन्द्रियैर्वा बुध्द्यात्मना वाऽनुसृतः स्वभावम्। करोति यद्यत् सकलं परस्मै नारायणायेति समर्पयेत् तत्॥ ११/२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50020635, "chapter_id": 11667, "verse_number": "44", "content_sanskrit": "भयं द्वितीयाभिनिवेशतः स्यादीशादपेतस्य विपर्ययोऽस्मृतिः। यन्माययाऽतो बुध आभजेत् तं भक्त्यैकयेशं गुरुदेवतात्मा॥ ११/२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50020636, "chapter_id": 11667, "verse_number": "45", "content_sanskrit": "अविद्यमानोऽप्यवभाति हि द्वयो ध्यातुर्धिया स्वप्नमनोरथो यथा। तत्कर्म सङ्कल्पविकल्पकं मनो बुधो निदध्यादभयं ततः स्यात्॥ ११/२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50020637, "chapter_id": 11667, "verse_number": "46", "content_sanskrit": "शृण्वन् सुभद्राणि रथाङ्गपाणेर्जन्मानि कर्माणि च यानि लोके। गीतानि नामानि तदर्थकानि गायन् विलज्जो विचरेदसङ्गः॥ ११/२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50020638, "chapter_id": 11667, "verse_number": "47", "content_sanskrit": "एवंव्रतश्च प्रियनामकार्त्या१ जातानुरागो द्रुतचित्त उच्चैः। हसत्यथो रोदिति रौति गायत्युन्मादवन्नृत्यति लोकबाह्यः॥ ११/२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50020639, "chapter_id": 11667, "verse_number": "48", "content_sanskrit": "खं वायुमग्निं सलिलं महीं च ज्योतींषि सत्वानि दिशो द्रुमादीन्। सरित् समुद्रांश्च हरेःशरीरं यत् किञ्च भूतं प्रणमेदनन्यम्॥ ११/२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50020640, "chapter_id": 11667, "verse_number": "49", "content_sanskrit": "भक्तिः परे स्वेऽनुभवो विरक्तिरन्यत्र चैष त्रिक एककालः। प्रपद्यमानस्य यथाऽश्नतः स्युस्तुष्टिः पुष्टिः क्षुदपायोऽनुघासम्॥ ११/२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50020641, "chapter_id": 11667, "verse_number": "50", "content_sanskrit": "इत्यच्युताङ्घ्रिं भजतोऽनुवृत्त्या भक्तिर्विरक्तिर्भगवत्प्रबोधः। भवन्ति वै भागवतस्य राजन् ततः परां शान्तिमुपैति साक्षात्॥ ११/२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50020642, "chapter_id": 11667, "verse_number": "51", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50020643, "chapter_id": 11667, "verse_number": "52", "content_sanskrit": "अथ भागवतं ब्रूत यद्धर्मो यादृशो नृणाम्। यथा चरति यद् ब्रूते यैर्लिङ्गैर्भगवत्प्रियः॥ ११/२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50020644, "chapter_id": 11667, "verse_number": "53", "content_sanskrit": "हरिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50020645, "chapter_id": 11667, "verse_number": "54", "content_sanskrit": "सर्वभूतेषु यः पश्येद् भगवद्भावमात्मनः। भूतानि भगवत्यात्मन्नेष भागवतोत्तमः॥ ११/२/ ४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50020646, "chapter_id": 11667, "verse_number": "55", "content_sanskrit": "ईश्वरे तदधीनेषु बालिशेषु द्विषत्सु च। पेरममैत्रीकृपोपेक्षा यः करोति स मध्यमः॥ ११/२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50020647, "chapter_id": 11667, "verse_number": "56", "content_sanskrit": "अर्चायामेव हरये पूजां यः श्रद्धयेहते। न तद्भक्तेषु चान्येषु स भक्तः प्राकृतः स्मृतः॥ ११/२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50020648, "chapter_id": 11667, "verse_number": "57", "content_sanskrit": "गृहीत्वापीन्द्रियैरर्थान् यो न द्वेष्टि न हृष्यति। विष्णोर्मायामिमां पश्यन् स वै भागवतोत्तमः॥ ११/२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50020649, "chapter_id": 11667, "verse_number": "58", "content_sanskrit": "देहोन्द्रयप्राणमनोधियां यो जन्माप्ययक्षुद्भयतर्षकृच्छ्रौः। संसारधर्मैरविमुह्यमानः स्मृत्या हरेर्भागवतप्रधानः॥ ११/२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50020650, "chapter_id": 11667, "verse_number": "59", "content_sanskrit": "यः कामकर्मबीजानि पश्यत्येषां च सम्भवम्। वासुदेवैकनिलयः स वै भागवतोत्तमः॥ ११/२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 50020651, "chapter_id": 11667, "verse_number": "60", "content_sanskrit": "न यस्य जन्मकर्मभ्यां न वर्णाश्रमजातिभिः। साञ्ज्ञतेऽऽस्मन्नहम्भावो देहे वै स हरेः प्रियः॥ ११/२/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 50020652, "chapter_id": 11667, "verse_number": "61", "content_sanskrit": "न यस्य स्वः पर इति चित्ते स्वात्मनि वाऽभिदा। सर्वभूतसमः शान्तः स वै भागवतोत्तमः॥ ११/२/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 50020653, "chapter_id": 11667, "verse_number": "62", "content_sanskrit": "त्रिभुवनविभवहेतुभिर्विकुण्ठ- स्मृतिभिरजेशसुरादिभिर्विमृग्यात्। न चलति भगवत्पदारविन्दा- ल्लवनिमिषार्धमपि स्म स वैष्णवाग्य्रः॥ ११/२/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 50020654, "chapter_id": 11667, "verse_number": "63", "content_sanskrit": "भगवत उरुविक्रमाङ्घ्रिशाखा- नखमणिचन्द्रिकया निरस्ततापे। हृदि कथमुपसीदतां पुनः स प्रभवति चन्द्र इवोदितेऽर्कतापः॥ ११/२/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 50020655, "chapter_id": 11667, "verse_number": "64", "content_sanskrit": "विसृजति हृदयं न यस्य साक्षाद् हरिरवशाभिहितोऽप्यघौघनाशः। प्रणयरशनया धृताङ्घ्रिपदम्ः स भवति भागवतप्रधान उक्तः॥ ११/२/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 50020656, "chapter_id": 11667, "verse_number": "65", "content_sanskrit": "इति श्रीमद्भागवते एकादशस्कन्धे द्वितीयोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]