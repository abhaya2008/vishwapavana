[{"id": 2209687, "chapter_id": 5484, "verse_number": "", "content_sanskrit": "अर्जुनेन मणलूरपुरं प्रति गमनम् । तथा पितृभक्त्या विनेयेनागतं चित्राङ्गदायां जातं स्वात्मजं बभ्रुवाहनं प्रति क्षत्रधर्मपरित्यागजरोषादुपालम्भः । तमसहमानाया उलूप्या नागलोकादेत्य बभ्रुवाहनस्यार्जुनेन सह युद्धप्रोत्साहनम् । बभ्रुवाहनेन स्वशरगाढाभिघातेन निपातिते पार्थे पितृमारणशोकेन मोहाधिगमः । ततश्चित्राङ्गदया रणाङ्गणमेत्य बहुधा विलापः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209688, "chapter_id": 5484, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209689, "chapter_id": 5484, "verse_number": "१", "content_sanskrit": "ततो गाण्डीवभृच्छूरो युद्धाय समुपस्थितः ।\nविबभौ युधि दुर्धर्षो हिमवानचलो यथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209690, "chapter_id": 5484, "verse_number": "२", "content_sanskrit": "ततः सैन्धवयोधास्ते पुनरेव व्यवस्थिताः ।\nविमुञ्चन्तः सुसंरब्धाः शरवर्षाणि भारत ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209691, "chapter_id": 5484, "verse_number": "३", "content_sanskrit": "तान् प्रहस्य महावीर्यः पुनरेव व्यवस्थितान् ।\nततः प्रोवाच कौन्तेयो मुमूर्षुन् श्लक्ष्णया गिरा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209692, "chapter_id": 5484, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209693, "chapter_id": 5484, "verse_number": "४", "content_sanskrit": "युध्यध्वं परया शक्त्या यतध्वं च वधे मम ।\nकुरुध्वं सर्वकार्याणि महद् वो भयमागतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209694, "chapter_id": 5484, "verse_number": "५", "content_sanskrit": "एष योत्स्यामि वः सर्वान् निवार्य शरवागुराम् ।\nतिष्ठध्वं युद्धमनसो दर्पान् विनयितास्मि वः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209695, "chapter_id": 5484, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209696, "chapter_id": 5484, "verse_number": "६", "content_sanskrit": "एतावदुक्त्वा कौरव्यो रोषाद् गाण्डीवभृत् तदा ।\nन तताप वचः स्मृत्वा भ्रातुर्ज्येष्ठस्य भारत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209697, "chapter_id": 5484, "verse_number": "७", "content_sanskrit": "न हन्तव्या रणे तात क्षत्रिया विजिगीषवः ।\nजेतव्याश्चेति यत्प्रोक्तं धर्मराज्ञा महात्मना ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209698, "chapter_id": 5484, "verse_number": "८", "content_sanskrit": "चिन्तयामास च तदा फल्गुनः पुरुषर्षभः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209699, "chapter_id": 5484, "verse_number": "९", "content_sanskrit": "इत्युक्तोऽहं नरेन्द्रेण न हन्तव्या नृपा इति ।\nकथं तन्न मृषेह स्याद् धर्मराजवचः शुभम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209700, "chapter_id": 5484, "verse_number": "१०", "content_sanskrit": "न हन्तव्याश्च राजानो राज्ञश्चाज्ञा कृता भवेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209701, "chapter_id": 5484, "verse_number": "समाप्तिः", "content_sanskrit": "इति सञ्चिन्त्य तु तदा भ्रातुः प्रियहिते रतः ।\nप्रोवाच वाक्यं धर्मज्ञः सैन्धवान् युद्धदुर्मदान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209702, "chapter_id": 5484, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209703, "chapter_id": 5484, "verse_number": "१२", "content_sanskrit": "बालांस्त्रियो वा युद्धेषु न हिंसे समुपस्थितान् ।\nयश्च वक्ष्यति सङ्ग्रामे तवास्मीति पराजितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209704, "chapter_id": 5484, "verse_number": "१३", "content_sanskrit": "एतच्छ्रुत्वा वचो मह्यं कुरुध्वं हितमात्मनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209705, "chapter_id": 5484, "verse_number": "१४", "content_sanskrit": "अतोऽन्यथा कृच्छ्रगता भविष्यथ मयाऽर्दिताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209706, "chapter_id": 5484, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209707, "chapter_id": 5484, "verse_number": "१५", "content_sanskrit": "एवमुक्त्वा तु तान् वीरान् युयुधे नरपुङ्गवः ।\nअत्वरावानसंरब्धः संरब्धैर्विजिगीषुभिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209708, "chapter_id": 5484, "verse_number": "१६", "content_sanskrit": "ततः शतसहस्राणि शराणां नतपर्वणाम् ।\nमुमुचुः सैन्धवा राजन् तदा गाण्डीवधन्वनि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209709, "chapter_id": 5484, "verse_number": "१७", "content_sanskrit": "स तानापततः क्रूरान् आशीविषविषोपमान् ।\nचिच्छेद निशितैर्बाणैरन्तरिक्षे धनञ्जयः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209710, "chapter_id": 5484, "verse_number": "१८", "content_sanskrit": "छित्त्वा तु तानाशु जवान् कङ्कपत्रान् शिलासितान् ।\nएकैकमेष दशभिर्बिभेद समरे शरैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209711, "chapter_id": 5484, "verse_number": "१९", "content_sanskrit": "ततः प्रासांश्च शक्तीश्च पुनरेव धनञ्जये ।\nजयद्रथं हतं स्मृत्वा चिक्षिपुः सैन्धवा नृप ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209712, "chapter_id": 5484, "verse_number": "२०", "content_sanskrit": "तेषां किरीटी सङ्कल्पं मोघं चक्रे महामनाः ।\nसर्वांस्तानन्तरा च्छित्त्वा मुदा चुक्रोश पाण्डवः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209713, "chapter_id": 5484, "verse_number": "२१", "content_sanskrit": "तथैवापततां तेषां योधानां जयगृद्धिनाम् ।\nशिरांसि पातयामास भल्लैः सन्नतपर्वभिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209714, "chapter_id": 5484, "verse_number": "२२", "content_sanskrit": "तेषां विद्रवतां चैव पुनरेव च धावताम् ।\nनिवृत्तानां च शब्दोऽभूत् पूर्णस्येव महोदधेः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209715, "chapter_id": 5484, "verse_number": "२३", "content_sanskrit": "ते वध्यमाना हि तदा पार्थेनामिततेजसा ।\nयथोत्साहं यथाशक्ति योधयामासुरर्जुनम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209716, "chapter_id": 5484, "verse_number": "२४", "content_sanskrit": "ततस्ते फल्गुनेनाजौ शरैः सन्नतपर्वभिः ।\nकृता विसञ्ज्ञा भूयिष्ठाः क्लान्तवाहनसैनिकाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2209717, "chapter_id": 5484, "verse_number": "२५", "content_sanskrit": "तांस्तु सर्वान् परिग्लानान् विदित्वा धृतराष्ट्रजा ।\nदुःशला बालमादाय नप्तारं प्रययौ तदा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2209718, "chapter_id": 5484, "verse_number": "२६", "content_sanskrit": "महारथसुतं वीरं रथेनानुगतं तदा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2209719, "chapter_id": 5484, "verse_number": "२७", "content_sanskrit": "शान्त्यर्थं सर्वयोधानामभ्यगच्छद्धि पाण्डवम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2209720, "chapter_id": 5484, "verse_number": "२८", "content_sanskrit": "सा धनञ्जयमासाद्य मुमोचार्तस्वरं तदा ।\nधनञ्जयोऽपि तां दृष्ट्वा धनुर्विससृजे तदा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2209721, "chapter_id": 5484, "verse_number": "२९", "content_sanskrit": "समुत्सृष्टधनुः पार्थो विधिवद् भगिनीं तदा ।\nप्राह किं करवाणीति सा च तं वाक्यमब्रवीत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2209722, "chapter_id": 5484, "verse_number": "", "content_sanskrit": "दुःशला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2209723, "chapter_id": 5484, "verse_number": "३०", "content_sanskrit": "एष ते भरतश्रेष्ठ स्वस्रीयस्यात्मजः शिशुः ।\nअभिवादयते वीर तं पश्य भरतर्षभ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2209724, "chapter_id": 5484, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2209725, "chapter_id": 5484, "verse_number": "३१", "content_sanskrit": "इत्युक्तस्तस्य पितरं स पप्रच्छार्जुनस्तदा ।\nक्वासाविति ततो राजन् दुःशला वाक्यमब्रवीत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2209726, "chapter_id": 5484, "verse_number": "", "content_sanskrit": "दुःशला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2209727, "chapter_id": 5484, "verse_number": "३२", "content_sanskrit": "पितृशोकाभिसन्तप्तो विषादार्तोऽस्य वै पिता ।\nपञ्चत्वमगमद् वीरो यथा तन्मे निशामय ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2209728, "chapter_id": 5484, "verse_number": "३३", "content_sanskrit": "स पूर्वं पितरं श्रुत्वा हतं युद्धे त्वयाऽनघ ।\nत्वामागतं च संश्रुत्या युद्धाय हयसारिणम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2209729, "chapter_id": 5484, "verse_number": "३४", "content_sanskrit": "पितुश्च मृत्युदुःखार्तो जहौ प्राणान् धनञ्जय ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2209730, "chapter_id": 5484, "verse_number": "३५", "content_sanskrit": "प्राप्तो बीभत्सुरित्येव नाम श्रुत्वैव तेऽनघ ।\nविषादार्तः पपातोर्व्यां ममार च ममात्मजः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2209731, "chapter_id": 5484, "verse_number": "३६", "content_sanskrit": "तं दृष्ट्वाऽहं निपतितं ततस्तस्यात्मजं विभो ।\nगृहीत्वा समनुप्राप्ता त्वामद्य शरणैषिणी ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2209732, "chapter_id": 5484, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2209733, "chapter_id": 5484, "verse_number": "३७", "content_sanskrit": "इत्युक्त्वाऽऽर्तस्वरं सा तु मुमोच धृतराष्ट्रजा ।\nदीना दीनं स्थितं पार्थमब्रवीच्चाप्यधोमुखम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2209734, "chapter_id": 5484, "verse_number": "", "content_sanskrit": "दुःशला", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2209735, "chapter_id": 5484, "verse_number": "३८", "content_sanskrit": "स्वसारं मामवेक्षस्व स्वस्रीयात्मजमेव च ।\nकर्तुमर्हसि धर्मज्ञ दयां मयि कुरूद्वह ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2209736, "chapter_id": 5484, "verse_number": "३९", "content_sanskrit": "विस्मृत्य कुरुराजानं तं च मन्दं जयद्रथम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2209737, "chapter_id": 5484, "verse_number": "४०", "content_sanskrit": "अभिमन्योर्यथा जातः परीक्षित् परवीरहा ।\nतथाऽयं सुरथाज्जातो मम पौत्रो महाभुज ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2209738, "chapter_id": 5484, "verse_number": "४१", "content_sanskrit": "तमादाय नरव्याघ्र प्राप्ताऽस्म्यद्य तवान्तिकम् ।\nशमार्थं सर्वयोधानां शृणु चेदं वचो मम ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2209739, "chapter_id": 5484, "verse_number": "४२", "content_sanskrit": "आगतोऽयं महाबाहो तस्य मन्दस्य पुत्रकः ।\nप्रसादमस्य बालस्य तस्मात् त्वं कर्तुमर्हसि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2209740, "chapter_id": 5484, "verse_number": "४३", "content_sanskrit": "एष प्रसाद्य शिरसा मया सार्धमरिन्दम ।\nयाचते त्वां महाबाहो शमं गच्छ धनञ्जय ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2209741, "chapter_id": 5484, "verse_number": "४४", "content_sanskrit": "बालस्य हतबन्धोश्च पार्थ किञ्चिदजानतः ।\nप्रसादं कुरु धर्मज्ञ मा त्वं मन्युवशं गमः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2209742, "chapter_id": 5484, "verse_number": "४५", "content_sanskrit": "तमनार्थं नृशंसं च विस्मृत्यास्य पितामहम् ।\nआगस्कारिणमत्यर्थं प्रसादं कर्तुमर्हसि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2209743, "chapter_id": 5484, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2209744, "chapter_id": 5484, "verse_number": "४६", "content_sanskrit": "एवं ब्रुवत्यां करुणं दुःशलायां धनञ्जयः ।\nसंस्मृत्य देवीं गान्धारीं धृतराष्ट्रं जनेश्वरम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2209745, "chapter_id": 5484, "verse_number": "४७", "content_sanskrit": "प्रोवाच पुत्रशोकार्तः क्षत्रधर्मं विगर्हयन् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2209746, "chapter_id": 5484, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2209747, "chapter_id": 5484, "verse_number": "४८", "content_sanskrit": "धिक् तं दुर्योधनं क्षुद्रं राज्यलुब्धं च मानिनम् ।\nयत्कृते बान्धवाः सर्वे मया नीता यमक्षयम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2209748, "chapter_id": 5484, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2209749, "chapter_id": 5484, "verse_number": "४९", "content_sanskrit": "इत्युक्त्वा बहु सान्त्वादि प्रसादमकोरज्जयः ।\nपरिष्वज्य च तां प्रीतो विससर्ज गृहान् प्रति ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2209750, "chapter_id": 5484, "verse_number": "५०", "content_sanskrit": "दुःशला चापि तान् सर्वान् निवार्य महतो रणात् ।\nसम्पूज्य पार्थं प्रययौ गृहान् प्रति शुभानना ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2209751, "chapter_id": 5484, "verse_number": "५१", "content_sanskrit": "ततः सैन्धवकान् योधान् निर्जित्य स नरर्षभः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2209752, "chapter_id": 5484, "verse_number": "५२", "content_sanskrit": "पुनरेवाश्वमेधार्थं हयं कामविचारिणम् । तारामृगमिवाकाशं देवदेवः पिनाकधृक् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2209753, "chapter_id": 5484, "verse_number": "५३", "content_sanskrit": "ससार तं तथा वीरो विधिवत् यज्ञियं हयम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2209754, "chapter_id": 5484, "verse_number": "५४", "content_sanskrit": "स पार्थिवान् वशे कृत्वा तांस्तान् देशान् यथासुखम् ।\nविचचार यथाकामं कर्म पार्थस्य वर्धयन् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2209755, "chapter_id": 5484, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अश्वसम्भरणे वज्रदत्तविसर्जनं नाम अष्टसप्ततितमोऽध्यायः ॥७८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]