[{"id": 2065539, "chapter_id": 2386, "verse_number": "९-१६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2065540, "chapter_id": 2386, "verse_number": "९-१६-१", "content_sanskrit": "एवमुक्तस्ततो राजा गौतमेन तपस्विना।\nनिःश्वस्य दीर्घमुष्णं च तूष्णीमासीद्विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2065541, "chapter_id": 2386, "verse_number": "९-१६-२", "content_sanskrit": "ततो मुहूर्तं स ध्यात्वा तव पुत्रो महामनाः।\nकृपं शारद्वतं वाक्यमित्युवाच परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2065542, "chapter_id": 2386, "verse_number": "९-१६-३", "content_sanskrit": "यत्किञ्चित्सुहृदा वाच्यं तत्सर्वं श्रावितो ह्यहम्।\nकृतं च भवता सर्वं प्राणान्सन्त्यज्य युध्यता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2065543, "chapter_id": 2386, "verse_number": "९-१६-४", "content_sanskrit": "गाहमानमनीकानि युध्यमानं महारथैः।\nपाण्डवैरतितेजोभिर्लोकस्त्वामनुदृष्टवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2065544, "chapter_id": 2386, "verse_number": "९-१६-५", "content_sanskrit": "सुहृदा यदिदं वाक्यं भवता श्रावितो ह्यहम्।\nन मां प्रीणाति तत्सर्वं मुमूर्षोरिव भेषजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2065545, "chapter_id": 2386, "verse_number": "९-१६-६", "content_sanskrit": "हेतुकारणसंयुक्तं हितं वचनमुत्तमम्।\nउच्यमानं महाबाहो न मे विप्राग्र्य रोचने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2065546, "chapter_id": 2386, "verse_number": "९-१६-७", "content_sanskrit": "राज्याद्विनिकृतोऽस्माभिःकथं सोस्मासु विश्वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2065547, "chapter_id": 2386, "verse_number": "९-१६-८", "content_sanskrit": "अक्षद्यूते च नृपतिर्जितोऽस्माभिर्महाधनः।\nस कथं मम वाक्यानि श्रद्दध्याद्भूय एव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2065548, "chapter_id": 2386, "verse_number": "९-१६-९", "content_sanskrit": "तथा दूत्येन सम्प्राप्तः कृष्णः पार्थहिते रतः।\nप्रलब्धश्च हृषीकेशस्तच्च कर्माविचारितम्।\nस च मे वचनं ब्रह्मन्कथमेवाभिमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2065549, "chapter_id": 2386, "verse_number": "९-१६-१०", "content_sanskrit": "विललाप च यत्कृष्णा सभामध्ये समेयुषी।\nन तन्मर्षयते कृष्णो न राज्यहरणं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2065550, "chapter_id": 2386, "verse_number": "९-१६-११", "content_sanskrit": "एकप्राणावुभौ कृष्णावन्योन्यमभिसंश्रितौ।\nपुरा यच्छ्रुतमेवासीदद्य पश्यामि तत्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2065551, "chapter_id": 2386, "verse_number": "९-१६-१२", "content_sanskrit": "स्वस्रीयं निहतं दृष्ट्वा दुःखं स्वपिति केशवः।\nकृतागसो व यं तस्य हितं मे स कथं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2065552, "chapter_id": 2386, "verse_number": "९-१६-१३", "content_sanskrit": "अभिमन्योर्विनाशेन न शर्म लभतेऽर्जुनः।\nस कथं मद्धिते यत्नं प्रकरिष्यति याचितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2065553, "chapter_id": 2386, "verse_number": "९-१६-१४", "content_sanskrit": "मध्यमः पाण्डवस्तीक्ष्णो भीमसेनो महाबलः।\nप्रतिज्ञातं च तेनोग्रं भज्येतापि न सन्नमेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2065554, "chapter_id": 2386, "verse_number": "९-१६-१५", "content_sanskrit": "उभौ तौ बद्धनिस्त्रिंशावुभौ चाबद्धकङ्कटौ।\nकृतवैरावुभौ वीरौ यमावपि यमोपमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2065555, "chapter_id": 2386, "verse_number": "९-१६-१६", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च कृतवैरौ मया सह।\nतौ कथं मद्विते यत्नं कुर्यातां द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2065556, "chapter_id": 2386, "verse_number": "९-१६-१७", "content_sanskrit": "दुःशासनेन यत्कृष्णा एकवस्त्रा रजस्वला।\nपरिक्लिष्टा सभामध्ये सर्वलोकस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2065557, "chapter_id": 2386, "verse_number": "९-१६-१८", "content_sanskrit": "तथा विवसनां दीनां स्मरन्त्यद्यापि पाण्डवाः।\nन निवारयितुं शक्याः सङ्ग्रामात्ते परन्तपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2065558, "chapter_id": 2386, "verse_number": "९-१६-१९", "content_sanskrit": "यदा च द्रौपदी क्लिष्टा मद्विनाशाय दुःखिता।\nउग्रं तेपे तपः कृष्णा भर्तॄणामर्थसिद्धये।\nस्थण्डिले नित्यदा शेते यावद्वैरस्य यातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2065559, "chapter_id": 2386, "verse_number": "९-१६-२०", "content_sanskrit": "निक्षिप्य मानं दर्पं च वासुदेवसहोदरा।\nकृष्णायाः प्रेष्यवद्भूत्वा शुश्रूषां कुरुते सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2065560, "chapter_id": 2386, "verse_number": "९-१६-२१", "content_sanskrit": "इति सर्वं समुन्नद्धं न निर्वाति कथञ्चन।\nअभिमन्योर्विनाशेन स सन्धेयः कथं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2065561, "chapter_id": 2386, "verse_number": "९-१६-२२", "content_sanskrit": "कथं च राजा भुक्त्वेमां पृथिवीं सागराम्बराम्।\nपाण्डवानां प्रसादेन भोक्ष्ये राज्यमहं कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2065562, "chapter_id": 2386, "verse_number": "९-१६-२३", "content_sanskrit": "उपर्युपरि राज्ञां वै ज्वलित्वा भास्करो यथा।\nयुधिष्ठिरं कथं पञ्चादनुयास्यामि दासवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2065563, "chapter_id": 2386, "verse_number": "९-१६-२४", "content_sanskrit": "कथं भुक्त्वा स्वयं भोगान्दत्त्वा दायांश्च पुष्कलान्।\nकृपणं वर्तयिष्यामि कृपणैः सह जीविकाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2065564, "chapter_id": 2386, "verse_number": "९-१६-२५", "content_sanskrit": "नाभ्यसूयामि ते वाक्यमुक्तं स्निग्धं हितं त्वया॥\nन तु सन्धिमहं मन्ये प्राप्तकालं कथञ्चन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2065565, "chapter_id": 2386, "verse_number": "९-१६-२६", "content_sanskrit": "सुनीतमनुपश्यामि सुयुद्धेन परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2065566, "chapter_id": 2386, "verse_number": "९-१६-२७", "content_sanskrit": "नायं क्लीबायितुं कालः संयोद्वुं काल एव नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2065567, "chapter_id": 2386, "verse_number": "९-१६-२८", "content_sanskrit": "इष्टं मे बहुभिर्जज्ञैर्दत्ता विप्रेषु दक्षिणाः।\nप्राप्ताः कामाः श्रुता वेदाः शत्रूणां मूर्ध्नि च स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2065568, "chapter_id": 2386, "verse_number": "९-१६-२९", "content_sanskrit": "भृत्या मे सुभृतास्तात दीनश्चाभ्युद्वृतो जनः।\nनोत्साहेऽद्य द्विजश्रेष्ठ पाण्डवान्वक्तुमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2065569, "chapter_id": 2386, "verse_number": "९-१६-३०", "content_sanskrit": "जितानि परराष्ट्राणि स्वराष्ट्रमनुपालितम्।\nभुक्ताश्च विविधा भोगास्त्रिवर्गः सेवितो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2065570, "chapter_id": 2386, "verse_number": "९-१६-३१", "content_sanskrit": "पितॄणां गतमानृण्यं क्षत्रधर्मस्य चोभयोः।\nन ध्रुवं सुखमस्तीह कुतो राष्ट्रं कुतो यशः।\nइह कीर्तिर्विचेतव्या सा च युद्वेन नान्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2065571, "chapter_id": 2386, "verse_number": "९-१६-३२", "content_sanskrit": "वृथा च यत्क्षत्रियस्य निधनं तद्विगर्हितम्।\nअधर्मः सुमहानेष यच्छय्यामरणं गृहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2065572, "chapter_id": 2386, "verse_number": "९-१६-३३", "content_sanskrit": "अरण्ये यो विमुच्येत सङ्ग्रामे वा तनुं नृपः।\nक्रतूनाहृत्य महतो महिमानं स गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2065573, "chapter_id": 2386, "verse_number": "९-१६-३४", "content_sanskrit": "कृपणं विलपन्नार्तो जरयाऽभिपरिप्लुतः।\nम्रियते रुदतां मध्ये ज्ञातीनां न स पूरुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2065574, "chapter_id": 2386, "verse_number": "९-१६-३५", "content_sanskrit": "त्यक्त्वा तु विविधान्भोगान्प्राप्तानां परमां गतिम्।\nअपीदानीं सुयुद्धेन गच्छेयं यत्सलोकताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2065575, "chapter_id": 2386, "verse_number": "९-१६-३६", "content_sanskrit": "शूराणामार्यवृत्तानां सङ्क्रामेष्वनिवर्तिनाम्।\nधीमतां सत्यसन्धानां सर्वेषां क्रतुयाजिनाम्।\nशस्त्रावभृथपूतानां ध्रुवो वासस्त्रिविष्टपे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2065576, "chapter_id": 2386, "verse_number": "९-१६-३७", "content_sanskrit": "मुदा नूनं प्रपश्यन्ति युद्वे ह्यप्सरसां गणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2065577, "chapter_id": 2386, "verse_number": "९-१६-३८", "content_sanskrit": "पश्यन्ति नूनं पितरः पूजितान्सुरसंसदि।\nअप्सरोभिः परिवृतान्मोदमानांस्त्रिविष्टपे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2065578, "chapter_id": 2386, "verse_number": "९-१६-३९", "content_sanskrit": "पन्थानममरैर्यान्तं शूरैश्चैवानिवर्तिभिः।\nअपि तत्सङ्गतं मार्गं वयमध्यारुहेमहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2065579, "chapter_id": 2386, "verse_number": "९-१६-४०", "content_sanskrit": "पितामहेन वृद्वेन तथाऽचार्येण धीमता।\nजयद्रथेन कर्णेन तथा दुःशासनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2065580, "chapter_id": 2386, "verse_number": "९-१६-४१", "content_sanskrit": "घटमाना मदर्थेऽस्मिन्हताः शूरा जनाधिपाः।\nशेरते लोहिताक्ताङ्गाः पृथिव्यां शरविक्षताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2065581, "chapter_id": 2386, "verse_number": "९-१६-४२", "content_sanskrit": "उत्तमास्त्रविदः शूरा यथोक्तक्रतुयाजिनः।\nत्यक्त्वा प्राणान्यथान्यायमिन्द्रसद्मसु धिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2065582, "chapter_id": 2386, "verse_number": "९-१६-४३", "content_sanskrit": "तैः स्वयं रचितो मार्गो दुर्गमो हि पुनर्भवेत्।\nसम्पतद्भिर्महावेगैरितो यास्यामि सद्गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2065583, "chapter_id": 2386, "verse_number": "९-१६-४४", "content_sanskrit": "ये मदर्थे हताः शूरास्तेषां कृतमनुस्मरन्।\nऋणं तत्प्रतियुञ्जानो न राज्ये मन आदधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2065584, "chapter_id": 2386, "verse_number": "९-१६-४५", "content_sanskrit": "पातयित्वा वयस्यांश्च भ्रातृनथ पितामहान्।\nजीवितं यदि रक्षेयं लोको मां गर्हयेद्व्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2065585, "chapter_id": 2386, "verse_number": "९-१६-४६", "content_sanskrit": "कीदृशं च भवेद्राज्यं मम हीनस्य बन्धुभिः।\nसखिभिश्च विशेषेण प्रणिपत्य च पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2065586, "chapter_id": 2386, "verse_number": "९-१६-४७", "content_sanskrit": "सोऽहमेतादृशं कृत्वा जगतोऽस्य पराभवम्।\nसुयुद्धेन हतः स्वर्गं प्राप्सामि न तदन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2065587, "chapter_id": 2386, "verse_number": "९-१६-४८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2065588, "chapter_id": 2386, "verse_number": "९-१६-४८", "content_sanskrit": "एं दुर्योधनेनोक्ते सर्वे सम्पूज्य तद्वचः।\nसाधुसाध्विति राजानं क्षत्रियाः सम्बभाषिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2065589, "chapter_id": 2386, "verse_number": "९-१६-४९", "content_sanskrit": "पराजयमशोचन्तः कृतचित्ताश्च विक्रमे।\nसर्वे सुनिश्चिता योद्धुमुदग्रमनसोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2065590, "chapter_id": 2386, "verse_number": "९-१६-५०", "content_sanskrit": "ततो वाहान्समाश्वास्य सर्वे युद्धाभिनन्दिनः।\nऊने द्वियोजने गत्वा प्रत्यतिष्ठन्त कौरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2065591, "chapter_id": 2386, "verse_number": "९-१६-५१", "content_sanskrit": "आकाशे विद्रुमे पुण्ये प्रस्थे हिमवतः शुभे।\nअरुणां सरस्वतीं प्राप्य पपुः सस्नुश्च तेजलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2065592, "chapter_id": 2386, "verse_number": "९-१६-५२", "content_sanskrit": "तव पुत्रकृतोत्साहाः पर्यवर्तन्त ते ततः।\nपर्यवस्थाप्य चात्मानमन्योन्येन पुनस्तदा।\nसर्वे राजन्न्यवर्तन्त क्षत्रियाः कालचोदिताः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2065593, "chapter_id": 2386, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि चतुर्थोऽध्यायः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]