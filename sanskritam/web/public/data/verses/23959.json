[{"id": 7003959000, "chapter_id": 23959, "verse_number": "३-१-२२-१", "content_sanskrit": "श्रीसूत उवाच ।\nलक्ष्मीतीर्थे शुभे पुंसां सर्वैश्वर्यैककारणे ।\nस्नात्वा नरस्ततो गच्छेदग्नितीर्थं द्विजोत्तमाः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003959001, "chapter_id": 23959, "verse_number": "३-१-२२-२", "content_sanskrit": "अग्नितीर्थं महापुण्यं महापातकनाशनम् ।\nतीर्थानामुत्तमं तीर्थं सर्वाभीष्टैकसाधनम् ।\nतत्र स्नायान्नरो भक्त्या स्वपापपरिशुद्धये॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003959002, "chapter_id": 23959, "verse_number": "३-१-२२-३", "content_sanskrit": "ऋषय ऊचुः ।\nअग्निर्तार्थमितिख्यातिः कथं तस्य मुनीश्वर॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003959003, "chapter_id": 23959, "verse_number": "३-१-२२-४", "content_sanskrit": "कुत्रैदमग्नितीर्थं च कीदृशं तस्य वैभवम् ।\nएतन्नः श्रद्दधानानां विस्तराद्वक्तुमर्हसि॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003959004, "chapter_id": 23959, "verse_number": "३-१-२२-५", "content_sanskrit": "श्रीसूत उवाच ।\nसम्यक्पृष्टं हि युष्माभिः शृणुध्वं मुनिपुंगवाः ।\nपुरा हि राघवो हत्वा रावणं सपरिच्छदम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003959005, "chapter_id": 23959, "verse_number": "३-१-२२-६", "content_sanskrit": "स्थापयित्वा तु लंकायां भर्तारं च विभीषणम् ।\nसीतासौमित्रिसंयुक्तो रामो दशरथात्मजः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003959006, "chapter_id": 23959, "verse_number": "३-१-२२-७", "content_sanskrit": "सिद्धचारणगंधवैर्देवैरप्सरसां गणैः ।\nस्तूयमानो मुनिगणैः सत्याशीस्तीर्थकौतुकी॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003959007, "chapter_id": 23959, "verse_number": "३-१-२२-८", "content_sanskrit": "धारयंल्लीलया चापं रामोऽसह्यपराक्रमः ।\nआत्मनः शुद्धिमाधातुं जानकीं शोधितु तथा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003959008, "chapter_id": 23959, "verse_number": "३-१-२२-९", "content_sanskrit": "इंद्रादिदेववृन्दैश्च मुनिभिः पितृभिस्तथा ।\nविभीषणेन सहितः सर्वेरपि च वानरैः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003959009, "chapter_id": 23959, "verse_number": "३-१-२२-१०", "content_sanskrit": "आययौ सेतुमार्गेण गंधमादनपर्वतम् ।\nलक्ष्मीतीर्थतटे स्थित्वा जानकीशोधनाय सः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003959010, "chapter_id": 23959, "verse_number": "३-१-२२-११", "content_sanskrit": "अग्निमावाहयामास देवर्षिपितृसन्निधौ ।\nअथोत्तस्थौ महांभोधेर्लक्ष्मीतीर्थाद्विदूरतः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003959011, "chapter_id": 23959, "verse_number": "३-१-२२-१२", "content_sanskrit": "पश्यत्सु सर्वलोकेषु लिहन्नंभांसि पावकः ।\nआताम्रलोचनः पीतवासा धनुर्धरः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003959012, "chapter_id": 23959, "verse_number": "३-१-२२-१३", "content_sanskrit": "सप्तभिश्चैव जिह्वाभिर्लेलिहानो दिशो दश ।\nदृष्ट्वा रघुपतिं शूरं लीलामानुषरूपिणम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003959013, "chapter_id": 23959, "verse_number": "३-१-२२-१४", "content_sanskrit": "जगाद वचनं रम्यं जानकीशुद्धिकारणात् ।\nरामराम महाबाहो राक्षसानां भयावह॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003959014, "chapter_id": 23959, "verse_number": "३-१-२२-१५", "content_sanskrit": "पातिव्रत्येन जानक्या रावणं हतवान्भवान् ।\nसत्यंसत्यं पुनः सत्यं नात्र कार्या विचारणा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003959015, "chapter_id": 23959, "verse_number": "३-१-२२-१६", "content_sanskrit": "कमलेयं जगन्माता लीलामानुषविग्रहा ।\nदेवत्वे देवदेहेयं मनुष्यत्वे च मानुषी॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003959016, "chapter_id": 23959, "verse_number": "३-१-२२-१७", "content_sanskrit": "विष्णोर्देहानुरूपां वै करोत्ये षात्मनस्तनुम् ।\nयदायदा जगत्स्वामिन्देवदेव जनार्द्दन॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003959017, "chapter_id": 23959, "verse_number": "३-१-२२-१८", "content_sanskrit": "अवतारान्करोषि त्वं तदेयं त्वत्सहायिनी ।\nयदा त्वं भार्गवो रामस्तदाभूद्धरणी त्वियम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003959018, "chapter_id": 23959, "verse_number": "३-१-२२-१९", "content_sanskrit": "अधुना जानकी जाता भवित्री रुक्मिणी ततः ।\nअन्येषु चावतारेषु विष्णोरेषा सहायिनी॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003959019, "chapter_id": 23959, "verse_number": "३-१-२२-२०", "content_sanskrit": "तस्मामद्वचनादेनां प्रति गृह्णीष्व राघव ।\nपावकस्य तु तद्वाक्यं श्रुत्वा देवा महर्षयः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003959020, "chapter_id": 23959, "verse_number": "३-१-२२-२१", "content_sanskrit": "विद्याधराश्च गंधर्वा मानवाः पन्नगास्तथा ।\nअन्ये च भूतनिवहा रामं दश रथात्मजम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003959021, "chapter_id": 23959, "verse_number": "३-१-२२-२२", "content_sanskrit": "जानकीं मैथिलीं चैव प्रशशंसुः पुनःपुनः ।\nरामोऽग्निवचनात्सीतां प्रतिजग्राह निर्मलाम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003959022, "chapter_id": 23959, "verse_number": "३-१-२२-२३", "content_sanskrit": "एवं सीताविशुद्ध्यर्थं रामेणाक्लिष्टकर्मणा ।\nआवाहने कृते वह्निर्लक्ष्मीतीर्थाद्विदूरतः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003959023, "chapter_id": 23959, "verse_number": "३-१-२२-२४", "content_sanskrit": "यतः प्रदेशादुत्तस्थावंबुधेर्द्विजसत्तमाः ।\nअग्नितीर्थं विजानीत तं प्रदेशमनुत्तमम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003959024, "chapter_id": 23959, "verse_number": "३-१-२२-२५", "content_sanskrit": "ततो विनिर्गमादग्नेरग्नितीर्थमितीर्यते ।\nअत्र स्नात्वा नरो भक्त्या वह्नेस्तीर्थे विमुक्तिदे॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003959025, "chapter_id": 23959, "verse_number": "३-१-२२-२६", "content_sanskrit": "उपोष्य वेदविदुषो ब्राह्मणा नपि भोजयेत् ।\nतेभ्यो वस्त्रं धनं भूमिं दद्यात्कन्यां च भूषिताम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003959026, "chapter_id": 23959, "verse_number": "३-१-२२-२७", "content_sanskrit": "सर्वपापविनिर्मुक्तो विष्णुसायुज्यमाप्नुयात् ।\nअग्नितीर्थस्य कूलेस्मि न्नन्नदानं विशिष्यते॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003959027, "chapter_id": 23959, "verse_number": "३-१-२२-२८", "content_sanskrit": "अग्नितीर्थसमं तीर्थं न भूतं न भविष्यति ।\nदुष्पण्योपि महापापो यत्र स्नानात्पिशाचताम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003959028, "chapter_id": 23959, "verse_number": "३-१-२२-२९", "content_sanskrit": "परित्यज्य महा घोरां दिव्यं रूपमवाप्तवान् ।\nपशुमान्नाम वैश्योऽभूत्पुरा पाटलिपुत्रके॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003959029, "chapter_id": 23959, "verse_number": "३-१-२२-३०", "content_sanskrit": "स वै धर्मपरो नित्यं ब्राह्मणाराधने रतः ।\nकृषिं निरंतरं कुर्वन्गो रक्षां चैव सर्वदा॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003959030, "chapter_id": 23959, "verse_number": "३-१-२२-३१", "content_sanskrit": "पण्यवीथ्यां च विक्रीणन्कांचनादीनि धर्मतः ।\nपशुमन्नामधेयस्य वणिक्छ्रेष्ठस्य तस्य वै॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003959031, "chapter_id": 23959, "verse_number": "३-१-२२-३२", "content_sanskrit": "बभूव भार्यात्रितयं पतिशुश्रूषणे रतम् ।\nज्येष्ठा त्रीन्सुषुवे पुत्रान्वैश्यवंशविवर्द्धनान्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003959032, "chapter_id": 23959, "verse_number": "३-१-२२-३३", "content_sanskrit": "सुपण्यं पण्यवतं च चारुपण्यं तथैव च ।\nमध्यमा सुषुते पुत्रौ सुकोश बहुकोशकौ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003959033, "chapter_id": 23959, "verse_number": "३-१-२२-३४", "content_sanskrit": "तृतीयायां त्रयः पुत्रास्तस्य वैश्यस्य जज्ञिरे ।\nमहापण्यो महाकोशो दुष्पण्य इति विश्रुताः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003959034, "chapter_id": 23959, "verse_number": "३-१-२२-३५", "content_sanskrit": "एवं पशुमतस्तस्य वैश्यस्य द्विजसत्तमाः ।\nबभूवुरष्टौ तनयास्तासु स्त्रीषु तिसृष्वपि॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003959035, "chapter_id": 23959, "verse_number": "३-१-२२-३६", "content_sanskrit": "ते सुपण्यमुखाः सर्वे पुत्रा ववृधिरे क्रमात ।\nधूलिकेलिं वितन्वन्तः पित रौ तोषयंति ते॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003959036, "chapter_id": 23959, "verse_number": "३-१-२२-३७", "content_sanskrit": "पंचहायनतां प्राप्ताः क्रमात्ते वैश्यनंदनाः ।\nपशुमानपि वैश्येंद्रः सर्वानपि च तान्सुतान्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003959037, "chapter_id": 23959, "verse_number": "३-१-२२-३८", "content_sanskrit": "बाल्यमारभ्य सततं स्वकृत्येषु व्यशिक्षयत् ।\nकृषिगोत्राणवाणिज्यकर्मसु क्रमशिक्षिताः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003959038, "chapter_id": 23959, "verse_number": "३-१-२२-३९", "content_sanskrit": "सुपण्यमुख्याः सप्तैव पितृवाक्यमशृण्वत ।\nपशुमान्वक्ति यत्कार्यं तत्क्ष णान्निरवर्तयन्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003959039, "chapter_id": 23959, "verse_number": "३-१-२२-४०", "content_sanskrit": "नैपुण्यं प्रापुरत्यंतं ते सुवर्णक्रियास्वपि ।\nदुष्पण्यस्त्वष्टमः पुत्रो बाल्यमारभ्य संततम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003959040, "chapter_id": 23959, "verse_number": "३-१-२२-४१", "content_sanskrit": "दुर्मार्गनिरतो भूत्वा नाशृणोत्पितृभा षितम् ।\nधूलिकेलिं समारभ्य दुर्मार्गनिरतोऽभवत्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003959041, "chapter_id": 23959, "verse_number": "३-१-२२-४२", "content_sanskrit": "स बाल एव सन्पुत्रो बालानन्यानबाधत ।\nदुष्कर्मनिरतं दृष्ट्वा तं पिता पशुमांस्तथा॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003959042, "chapter_id": 23959, "verse_number": "३-१-२२-४३", "content_sanskrit": "उपेक्षा मेवकृतवान्बालिशोऽयमितीरयन् ।\nअथाष्टावपि वैश्यस्य प्रापुर्यौवनमात्मजाः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003959043, "chapter_id": 23959, "verse_number": "३-१-२२-४४", "content_sanskrit": "ततोऽयमष्टमः पुत्रो दुष्णयो बलिनां वरः ।\nगृहीत्वा पाणियु गलेबालान्नगरवर्तिनः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003959044, "chapter_id": 23959, "verse_number": "३-१-२२-४५", "content_sanskrit": "निचिक्षेप स कूपेषु सरित्सु च सरःस्वपि ।\nन कोऽपि तस्य जानाति दुश्चरित्रमिदं जनः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003959045, "chapter_id": 23959, "verse_number": "३-१-२२-४६", "content_sanskrit": "यावन्म्रियंते ते बालास्तावन्निक्षिप्तवाञ्जले ।\nतेषां मृतानां बालानां पितरो मातरस्तथा॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003959046, "chapter_id": 23959, "verse_number": "३-१-२२-४७", "content_sanskrit": "गवेषयंति तान्सर्वान्नगरेषु हि सर्वशः ।\nतान् दृष्ट्वा च मृतान्पुत्रान्के वलं प्रारुदञ्जनाः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003959047, "chapter_id": 23959, "verse_number": "३-१-२२-४८", "content_sanskrit": "जलेष्वथ शवान्दृष्ट्वा जनाश्चक्रुर्यथोचितम् ।\nएवं प्रतिदिनं बालान्दुष्पण्यो मारयन्पुरे॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003959048, "chapter_id": 23959, "verse_number": "३-१-२२-४९", "content_sanskrit": "जनैरप्यपरिज्ञातश्चिरमेवमवर्तत ।\nम्रियमाणेषु बालेषु वैश्यपुत्रस्य कर्मणा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003959049, "chapter_id": 23959, "verse_number": "३-१-२२-५०", "content_sanskrit": "प्रजानां वृद्धिराहित्याच्छून्यप्रायमभूत्पुरम् ।\nततः समेत्य पौरास्तद्वृत्तं राज्ञे न्यवेद यन्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003959050, "chapter_id": 23959, "verse_number": "३-१-२२-५१", "content_sanskrit": "श्रुत्वा नृपस्तद्वचनमाहूय ग्रामपालकान् ।\nकारणं बालमरणे चिंत्यतामिति सोऽन्वशात्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003959051, "chapter_id": 23959, "verse_number": "३-१-२२-५२", "content_sanskrit": "ग्रामपालास्तथेत्युक्त्वा तत्र तत्र व्यवस्थिताः ।\nसम्यग्गवेषयामासुः कारणं बालमारणे॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003959052, "chapter_id": 23959, "verse_number": "३-१-२२-५३", "content_sanskrit": "ते वै गवेषंयतोऽपि नाविंदन्बालमारकम् ।\nते पुनर्नृपमासाद्य भीता वाक्यमथाब्रु वन्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003959053, "chapter_id": 23959, "verse_number": "३-१-२२-५४", "content_sanskrit": "गवेषयंतोऽपि वयं तन्न विंदामहे नृप ।\nयो बालान्नगरे स्थित्वा सततं मारयत्यपि॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003959054, "chapter_id": 23959, "verse_number": "३-१-२२-५५", "content_sanskrit": "पुनश्च नागराः सर्वे राजानं प्राप्य दुःखिताः ।\nपुनः प्रजानां मरणमब्रुवन्वाष्पसंकुलाः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003959055, "chapter_id": 23959, "verse_number": "३-१-२२-५६", "content_sanskrit": "राजा तत्कारणाज्ञानात्तूष्णीमास्ते विचिंत्य तु ।\nकदाचिद्वैश्यपुत्रोयं पंचभिर्बा लकैः सह॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003959056, "chapter_id": 23959, "verse_number": "३-१-२२-५७", "content_sanskrit": "तटाकांतिकमापेदे पंकजाहरणच्छलात् ।\nबलाद्गृहीत्वा तान्बालान्दुष्पण्यः क्रोशतस्तदा॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003959057, "chapter_id": 23959, "verse_number": "३-१-२२-५८", "content_sanskrit": "क्रूरात्मा मज्जयामास कंठ दघ्ने सरोजले ।\nमृतान्मत्वा च ताञ्छीघ्रं दुष्पण्यः स्वगृहं ययौ॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003959058, "chapter_id": 23959, "verse_number": "३-१-२२-५९", "content_sanskrit": "पञ्चानां पितरस्तेषां मार्गयंतः सुतान्पुरे ।\nतेषु वै मार्गमाणेषु पंच तेना तिबालकाः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003959059, "chapter_id": 23959, "verse_number": "३-१-२२-६०", "content_sanskrit": "निक्षिप्ता अपि तोयेषु नाम्रियंत यदृच्छया ।\nते शनैः कूलमासाद्य पंचापि क्लिन्नमौलयः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003959060, "chapter_id": 23959, "verse_number": "३-१-२२-६१", "content_sanskrit": "अशक्ता नगरं गंतुं बाल्यात्तत्रैव बभ्रमुः ।\nदूरादुच्चार्यमाणानि स्वनामानि स्वबंधुभिः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003959061, "chapter_id": 23959, "verse_number": "३-१-२२-६२", "content_sanskrit": "श्रुत्वा पंचापि ते बालाः प्रतिशब्दमकुर्वत ।\nततस्तत्पितरः श्रुत्वा तत्रागत्यसरस्तटे॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003959062, "chapter_id": 23959, "verse_number": "३-१-२२-६३", "content_sanskrit": "पुत्रान्दृष्ट्वा तु सप्राणान्प्रहर्षमतुलं गताः ।\nकिमेतदिति पित्राद्यैः पृष्टास्ते बालकास्तदा॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003959063, "chapter_id": 23959, "verse_number": "३-१-२२-६४", "content_sanskrit": "दुष्पण्यस्याथ दुष्कृत्यं बन्धुभ्यस्ते न्यवेदयन् ।\nततो विदितवृत्तांता राजानं प्राप्य नागराः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003959064, "chapter_id": 23959, "verse_number": "३-१-२२-६५", "content_sanskrit": "पंचभिः कथितं वृत्तं दुष्पण्यस्य न्यवेदयन् ।\nततो राजा समाहूय पशुमंतं वणिग्वरम् ।\nपौरेष्वपि च शृण्वत्सु वाक्यमेतदभाषत॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003959065, "chapter_id": 23959, "verse_number": "३-१-२२-६६", "content_sanskrit": "राजोवाच ।\nदुष्पण्यनामा पशुमन्बहुप्रजमिदं पुरम्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003959066, "chapter_id": 23959, "verse_number": "३-१-२२-६७", "content_sanskrit": "शून्यप्रायं कृतं पश्य त्वत्पुत्रेण दुरात्मना ।\nइदानीं बालिशानेतान्मज्जयामास वै जले॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003959067, "chapter_id": 23959, "verse_number": "३-१-२२-६८", "content_sanskrit": "यदृच्छया च सप्राणाः पुनरप्या गताः पुरम् ।\nअस्मिन्नित्थं गते कार्ये किं कर्तव्यं वदाधुना॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003959068, "chapter_id": 23959, "verse_number": "३-१-२२-६९", "content_sanskrit": "अद्य त्वामेव पृच्छामि यतस्त्वं धर्मतत्परः ।\nइत्युक्तः पशुमान्राज्ञा धर्मज्ञो युक्तमब्रवीत्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003959069, "chapter_id": 23959, "verse_number": "३-१-२२-७०", "content_sanskrit": "पशुमानुवाच ।\nपुरं निःशेषितं येन वधमेवायमर्हति ।\nन ह्यत्र विषये किंचित्प्रष्टव्यं विद्यते नृप॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003959070, "chapter_id": 23959, "verse_number": "३-१-२२-७१", "content_sanskrit": "न ह्ययं मम पुत्रः स्याच्छत्रुरेवातिपापकृत् ।\nन ह्यस्य निष्कृतिं पश्ये येन निःशेषितं पुरम्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003959071, "chapter_id": 23959, "verse_number": "३-१-२२-७२", "content_sanskrit": "वध्यतामेव दुष्टात्मा सत्यमेव ब्रवीम्यहम् ।\nश्रुत्वा पशुमतो वाक्यं नागराः सर्व एव हि॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003959072, "chapter_id": 23959, "verse_number": "३-१-२२-७३", "content_sanskrit": "वणिग्वरं श्लाघमाना राजानमिदमूचिरे ।\nन वध्यतामयं दुष्टस्तूष्णीं निर्वास्यतां पुरात्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003959073, "chapter_id": 23959, "verse_number": "३-१-२२-७४", "content_sanskrit": "ततः स राजा दुष्पण्यं समाहूयेदमब्रवीत् ।\nअस्माद्देशाद्भवाञ्छीघ्रं दुष्टात्मन्गच्छ सांप्रतम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003959074, "chapter_id": 23959, "verse_number": "३-१-२२-७५", "content_sanskrit": "यदि तिष्ठेस्त्वमत्रैव दण्डयेयं वधेन वै ।\nइति राज्ञा विनिर्भर्त्स्य दूतैर्निर्वासितः पुरात्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003959075, "chapter_id": 23959, "verse_number": "३-१-२२-७६", "content_sanskrit": "दुष्पण्यस्त्वथ तं देशं परित्यज्य भयान्वितः ।\nमुनिमंडलसंबाधं वनमेव ययौ तदा॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003959076, "chapter_id": 23959, "verse_number": "३-१-२२-७७", "content_sanskrit": "तत्राप्येकं मुनिसुतं स तोयेषु न्यमज्जयत् ।\nकेल्यर्थमागता दृष्ट्वा मुनिपुत्रा मृतं शिशुम्॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003959077, "chapter_id": 23959, "verse_number": "३-१-२२-७८", "content_sanskrit": "तत्पित्रे कथयामासुरभ्येत्य भृशदुःखिताः ।\nतत उग्रश्रवाः श्रुत्वा तेभ्यः पुत्रं जले मृतम्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003959078, "chapter_id": 23959, "verse_number": "३-१-२२-७९", "content_sanskrit": "तपोमहिम्ना दुष्प ण्यचरितं तदमन्यत ।\nउग्रश्रवाः शशापैनं दुष्पण्यं वैश्यनंदनम्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003959079, "chapter_id": 23959, "verse_number": "३-१-२२-८०", "content_sanskrit": "उग्रश्रवा उवाच ।\nमत्सुतं पयसि क्षिप्य यत्त्वं मारि तवानसि ।\nतवापि मरणं भूयाज्जल एव निमज्जनात्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003959080, "chapter_id": 23959, "verse_number": "३-१-२२-८१", "content_sanskrit": "मृतश्च सुचिरं कालं पिशाचस्त्वं भविष्यसि ।\nइति शापे श्रुते सद्यो दुष्पण्यः खिन्नमानसः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003959081, "chapter_id": 23959, "verse_number": "३-१-२२-८२", "content_sanskrit": "तद्वै वनं परित्यज्य घोरमन्यद्वनं ययौ ।\nसिंहादिक्रूरसत्वाढ्यं तस्मिन्प्राप्ते वनांतरम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003959082, "chapter_id": 23959, "verse_number": "३-१-२२-८३", "content_sanskrit": "पांसुवर्षं मह्द्वर्षन्वृक्षानामोटय न्मुहुः ।\nवज्रघातसमस्पर्शो ववौ झंझानिलो महान्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003959083, "chapter_id": 23959, "verse_number": "३-१-२२-८४", "content_sanskrit": "वेगेन गात्रं भिंदन्ती वृष्टिश्चासीत्सुदुःसहा ।\nतद्दृष्ट्वा स तु दुष्पण्यश्चिंतयन्भृशदुः खितः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003959084, "chapter_id": 23959, "verse_number": "३-१-२२-८५", "content_sanskrit": "मृतं शुष्कं महाकायं गजमेकमपश्यत ।\nमहावातं महावर्षं तदा सोढुमशक्नुवन्॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003959085, "chapter_id": 23959, "verse_number": "३-१-२२-८६", "content_sanskrit": "गजास्यविवरेणैव विवेशोदरगह्वरम् ।\nतस्मिन्प्रविष्टमात्रे तु वृष्टिरासीत्सुभूयसी॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003959086, "chapter_id": 23959, "verse_number": "३-१-२२-८७", "content_sanskrit": "ततो वर्षजलैः सर्वैः प्रवाहः सुमहानभूत् ।\nस प्रवाहो वने तस्मिन्नदी काचिदजायत॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003959087, "chapter_id": 23959, "verse_number": "३-१-२२-८८", "content_sanskrit": "अथ तैर्वर्षसलिलैः स गजः पूरितोदरः ।\nप्लवमानो महापूरे नीरंध्रः समजायत॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003959088, "chapter_id": 23959, "verse_number": "३-१-२२-८९", "content_sanskrit": "ततो निर्विवरस्यास्य जलपूर्णोदरस्य च ।\nगजस्य जठरात्सोऽयं निर्गंतु न शशाक ह॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003959089, "chapter_id": 23959, "verse_number": "३-१-२२-९०", "content_sanskrit": "ततश्च वृष्टितोयानां प्रवाहो भीमवेगवान् ।\nउदरस्थितदुष्पण्यं समुद्रं प्रापयद्गजम्॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003959090, "chapter_id": 23959, "verse_number": "३-१-२२-९१", "content_sanskrit": "दुष्पण्यः सलिले मग्नः क्षणात्प्राणैर्व्ययुज्यत ।\nमृत एव स दुष्पण्यः पिशाचत्वमवाप्तवान्॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003959091, "chapter_id": 23959, "verse_number": "३-१-२२-९२", "content_sanskrit": "पीडितः क्षुत्पिपासाभ्यां दुर्गमं वनमाश्रितः ।\nघोरेषु घर्मकालेषु समाक्रोशन्भयानकम्॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003959092, "chapter_id": 23959, "verse_number": "३-१-२२-९३", "content_sanskrit": "अतिष्ठद्गहनेऽरण्ये दुःखान्यनुभवन्बहु ।\nकल्पकोटिसहस्राणि कल्पकोटिशतानि च॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003959093, "chapter_id": 23959, "verse_number": "३-१-२२-९४", "content_sanskrit": "स पिशाचो महादुःखी न्यवसद्घोरकानने ।\nवनाद्वनांतरं धावन्देशाद्देशाद्देशांतरं तथा॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003959094, "chapter_id": 23959, "verse_number": "३-१-२२-९५", "content_sanskrit": "सर्वत्रानुभवन्दुःखमाययौ दण्डकान्क्रमात् ।\nअगस्त्यादाश्रमात्पुण्यान्नातिदूरे स संचरन्॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003959095, "chapter_id": 23959, "verse_number": "३-१-२२-९६", "content_sanskrit": "नदन्भैरवनादं च वाक्यमुच्चैरभाषत ।\nभोभोस्तपोधनाः सर्वे शृणुध्वं मामकं वचः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003959096, "chapter_id": 23959, "verse_number": "३-१-२२-९७", "content_sanskrit": "भवन्तो हि कृपावन्तः सर्वभूतहिते रताः ।\nकृपादृष्ट्यानुगृह्णीत मां दुःखैरतिपीडितम्॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003959097, "chapter_id": 23959, "verse_number": "३-१-२२-९८", "content_sanskrit": "पुरा दुष्पण्यनामाहं वैश्यः पाटलिपुत्रके ।\nपुत्रः पशु मतश्चापि बहून्बालानमारयम्॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003959098, "chapter_id": 23959, "verse_number": "३-१-२२-९९", "content_sanskrit": "ततो विवासितो राज्ञा तस्माद्देशाद्वनं गतः ।\nअमारयं जले पुत्रं तत्रोग्रश्रवसो मुनेः॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003959099, "chapter_id": 23959, "verse_number": "३-१-२२-१००", "content_sanskrit": "स मुनिर्दत्त वाञ्छापं ममापि मरणं जले ।\nपिशाचतां च मे घोरां दत्तवान्दुःखभूयसीम्॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003959100, "chapter_id": 23959, "verse_number": "३-१-२२-१०१", "content_sanskrit": "कल्पकोटिसहस्राणि कल्पकोटिशतान्यपि ।\nपिशाच तानुभूतेयं शून्यकाननभूमिषु॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003959101, "chapter_id": 23959, "verse_number": "३-१-२२-१०२", "content_sanskrit": "नाहं सोढुं समर्थोऽस्मि पिपासां क्षुधमेव च ।\nरक्षध्वं कृपया यूयमतो मां बहुदुःखिनम्॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003959102, "chapter_id": 23959, "verse_number": "३-१-२२-१०३", "content_sanskrit": "यथा मुच्येय पैशाच्यात्तथा कुरुत तापसाः ।\nइति श्रुत्वा पिशाचस्य वचनं ते तपोधनाः॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003959103, "chapter_id": 23959, "verse_number": "३-१-२२-१०४", "content_sanskrit": "लोपामुद्रासहचरमूचिरे कुम्भसंभवम्॥  ।\nतापसा ऊचुः ।\nपिशाचस्यास्य भगवन्ब्रूहि निष्कृतिमुत्तमाम्॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003959104, "chapter_id": 23959, "verse_number": "३-१-२२-१०५", "content_sanskrit": "एवंविधानां पापानां त्वं समर्थो हि रक्षणे ।\nतेषामगस्त्यः श्रुतवान्कृपया परया युतः ।\nप्रियशिष्यं समाहूय सुतीक्ष्णं वाक्यमब्रवीत्॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003959105, "chapter_id": 23959, "verse_number": "३-१-२२-१०६", "content_sanskrit": "अगस्त्य उवाच ।\nसुतीक्ष्ण गच्छ त्वरितं पर्वतं गंधमादनम्॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003959106, "chapter_id": 23959, "verse_number": "३-१-२२-१०७", "content_sanskrit": "तत्राग्नितीर्थं सुमहद्विद्यते पापनाशनम् ।\nपिशाचमोक्षणार्थाय तत्र स्नाहि महामते॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003959107, "chapter_id": 23959, "verse_number": "३-१-२२-१०८", "content_sanskrit": "पिशाचार्थं त्वयि स्नाते तत्र संकल्पपूर्वकम् ।\nपिशाचभावमुन्मुच्य दिव्यतामेष यास्यति॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003959108, "chapter_id": 23959, "verse_number": "३-१-२२-१०९", "content_sanskrit": "निष्कृतिं नास्य पश्यामि विना तत्तीर्थसेवनात ।\nअतः सुतीक्ष्णकृपया रक्षस्वैनं पिशाचकम्॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003959109, "chapter_id": 23959, "verse_number": "३-१-२२-११०", "content_sanskrit": "अगस्त्येनैवमुक्तस्तु सुतीक्ष्णो गन्धमादनम् ।\nप्राप्याग्नितीर्थे संकल्प्य पिशाचार्थं कृपानिधिः॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003959110, "chapter_id": 23959, "verse_number": "३-१-२२-१११", "content_sanskrit": "सस्नौ तत्र पिशाचार्थं नियमेन दिनत्रयम् ।\nरामनाथादिकं सेव्य तत्तीर्थं प्रतिगृह्य च॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003959111, "chapter_id": 23959, "verse_number": "३-१-२२-११२", "content_sanskrit": "स्वाश्रमं प्रति गत्वाथ सुतीक्ष्णो विप्रसत्तमः ।\nतत्तीर्थ प्रोक्षणात्सद्यः सवियुज्य पिशाचताम्॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003959112, "chapter_id": 23959, "verse_number": "३-१-२२-११३", "content_sanskrit": "वैभवात्तस्य तीर्थस्य सद्यो दिव्यत्वमाप्तवान् ।\nविमानवरमारूढो दिव्यस्त्रीपरिवारितः॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003959113, "chapter_id": 23959, "verse_number": "३-१-२२-११४", "content_sanskrit": "सुतीक्ष्णं चाप्यगस्त्यं च तथान्यांश्च तपोधनान् ।\nपुनःपुनर्नमस्कृत्य तांश्चामंत्र्य प्रहर्षितः॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003959114, "chapter_id": 23959, "verse_number": "३-१-२२-११५", "content_sanskrit": "स्वर्गमेवारुहत्तूर्णं देवैरपि स पूजितः ।\nअग्नितीर्थस्य माहात्म्याद्दुष्पण्यो वैश्यनंदनः॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003959115, "chapter_id": 23959, "verse_number": "३-१-२२-११६", "content_sanskrit": "पैशाच्यं शापजं त्यक्त्वा दिव्यतामित्थमाप्तवान् ।\nएवं वः कथितं विप्रा अग्नितीर्थस्य वैभवम्॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003959116, "chapter_id": 23959, "verse_number": "३-१-२२-११७", "content_sanskrit": "यः पठेदिममध्यायं शृणुयाद्वा सभक्तिकम् ।\nपिशाचमोक्षणाख्यानं मुच्यते सर्वपातकैः॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003959117, "chapter_id": 23959, "verse_number": "३-१-२२-११८", "content_sanskrit": "इह भुक्त्वा महाभोगान्परत्रापि सुखं लभेत्॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}]