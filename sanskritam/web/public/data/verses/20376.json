[{"id": 7000376000, "chapter_id": 20376, "verse_number": "२-४८-१", "content_sanskrit": "ब्राह्मण्युवाच ।\nमाथुरे विषये रम्ये मथुरायां नृपोत्तमः ।\nउग्रसेनेति विख्यातो यादवः परवीरहा॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000376001, "chapter_id": 20376, "verse_number": "२-४८-२", "content_sanskrit": "सर्वधर्मार्थतत्त्वज्ञो वेदज्ञः श्रुतवान्बली ।\nदाता भोक्ता गुणग्राही सद्गुणान्वेत्ति भूपतिः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000376002, "chapter_id": 20376, "verse_number": "२-४८-३", "content_sanskrit": "राज्यं चकार मेधावी प्रजा धर्मेण पालयेत् ।\nएवं स च महातेजा उग्रसेनः प्रतापवान्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000376003, "chapter_id": 20376, "verse_number": "२-४८-४", "content_sanskrit": "वैदर्भे विषये पुण्ये सत्यकेतुः प्रतापवान् ।\nतस्य कन्या महाभागा पद्माक्षी कमलानना॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000376004, "chapter_id": 20376, "verse_number": "२-४८-५", "content_sanskrit": "नाम्ना पद्मावती नाम सत्यधर्मपरायणा ।\nसा तु स्त्रीणां गुणैर्युक्ता द्वितीयेव समुद्रजा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000376005, "chapter_id": 20376, "verse_number": "२-४८-६", "content_sanskrit": "वैदर्भी शुशुभे राजन्स्वगुणैः सत्यकारणैः ।\nमाथुर उग्रसेनस्तु उपयेमे सुलोचनाम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000376006, "chapter_id": 20376, "verse_number": "२-४८-७", "content_sanskrit": "तया सह महाभाग सुखं रेमे प्रतापवान् ।\nअतिप्रीतो गुणैस्तस्यास्तया सह सुखीभवेत्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000376007, "chapter_id": 20376, "verse_number": "२-४८-८", "content_sanskrit": "तस्याः स्नेहेन प्रीत्या च संमुग्धो माथुरेश्वरः ।\nपद्मावती महाभागा तस्य प्राणप्रियाभवत्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000376008, "chapter_id": 20376, "verse_number": "२-४८-९", "content_sanskrit": "तया विना न बुभुजे तया सह प्रक्रीडयेत् ।\nतया विना न सेवेत परमं सुखमेव सः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000376009, "chapter_id": 20376, "verse_number": "२-४८-१०", "content_sanskrit": "एवं प्रीतिकरौ जातौ परस्परमनुत्तमौ ।\nस्नेहवंतौ द्विजश्रेष्ठ सुखसंप्रीतिदायकौ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000376010, "chapter_id": 20376, "verse_number": "२-४८-११", "content_sanskrit": "सत्यकेतुश्च राजेंद्रः सस्मार स पद्मावतीम् ।\nस्वसुतां तां महाभागो माता तस्याः सुदुःखिता॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000376011, "chapter_id": 20376, "verse_number": "२-४८-१२", "content_sanskrit": "स दूतान्प्रेषयामास वैदर्भो मथुरां प्रति ।\nउग्रसेनं नृवीरेंद्रं सादरेण द्विजोत्तम॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000376012, "chapter_id": 20376, "verse_number": "२-४८-१३", "content_sanskrit": "उग्रसेनं महाराजं स दूतो वाक्यमब्रवीत् ।\nविदर्भाधिपतिर्वीरो भक्त्या स्नेहेन नंदयन्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000376013, "chapter_id": 20376, "verse_number": "२-४८-१४", "content_sanskrit": "आत्मनः कुशलं ब्रूते भवतां परिपृच्छति ।\nसत्यकेतुर्महाराज त्वामेवं परिपृष्टवान्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000376014, "chapter_id": 20376, "verse_number": "२-४८-१५", "content_sanskrit": "दर्शनाय प्रेषयस्व सुतां पद्मावतीं मम ।\nयदि त्वं मन्यसे नाथ प्रीतिस्नेहं हितस्य च॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000376015, "chapter_id": 20376, "verse_number": "२-४८-१६", "content_sanskrit": "प्रेषयस्व महाभागां प्रियां प्रीतिकरां तव ।\nऔत्कण्ठ्येन महाराज स सोत्कंठेन वर्तते॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000376016, "chapter_id": 20376, "verse_number": "२-४८-१७", "content_sanskrit": "समाकर्ण्य ततो वाक्यमुग्रसेनो नृपोत्तमः ।\nप्रीत्या स्नेहेन तस्यापि सत्यकेतोर्महात्मनः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000376017, "chapter_id": 20376, "verse_number": "२-४८-१८", "content_sanskrit": "दाक्षिण्येन च विप्रेंद्र प्रेषयामास भूपतिः ।\nपद्मावतीं प्रियां भार्यामुग्रसेनः प्रतापवान्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000376018, "chapter_id": 20376, "verse_number": "२-४८-१९", "content_sanskrit": "प्रेषितानेन राजेंद्र गता पद्मावती स्वकम् ।\nपूर्वं गृहं सती सा तु महाहर्षेण संकुला॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000376019, "chapter_id": 20376, "verse_number": "२-४८-२०", "content_sanskrit": "पितृपूर्वं कुटुंबं तु ददृशे चारुमंगला ।\nपितुः पादौ ननामाथ शिरसा सत्यतत्परा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000376020, "chapter_id": 20376, "verse_number": "२-४८-२१", "content_sanskrit": "आगतायां महाराजा पद्मावत्यां द्विजोत्तम ।\nहर्षेण महताविष्टो विदर्भाधिपतिर्नृपः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000376021, "chapter_id": 20376, "verse_number": "२-४८-२२", "content_sanskrit": "वर्द्धिता दानमानैश्च वस्त्रालंकारभूषणैः ।\nपद्मावती सुखेनापि पितुर्गेहे प्रवर्तते॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000376022, "chapter_id": 20376, "verse_number": "२-४८-२३", "content_sanskrit": "सखीभिः सहिता सा तु निःशंका परिवर्तते ।\nरमते सा तदा तत्र यथापूर्वं तथैव च॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000376023, "chapter_id": 20376, "verse_number": "२-४८-२४", "content_sanskrit": "गृहे वने तडागेषु प्रासादे च तथैव सा ।\nपुनर्बालेव भूता सा निर्लज्जा संप्रवर्तते॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000376024, "chapter_id": 20376, "verse_number": "२-४८-२५", "content_sanskrit": "निःशंका वर्तते विप्र सखीभिः सह सर्वदा ।\nपतिव्रता महाभागा हर्षेण महतान्विता॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000376025, "chapter_id": 20376, "verse_number": "२-४८-२६", "content_sanskrit": "सुखं तु पितृगेहस्य दुर्लभं श्वशुरे गृहे ।\nएवं ज्ञात्वा तदा रेमे कदा ईदृग्भविष्यति॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000376026, "chapter_id": 20376, "verse_number": "२-४८-२७", "content_sanskrit": "अनेन मोहभावेन क्रीडालुब्धा वरानना ।\nसखीभिः सहिता नित्यं वनेषूपवने तदा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]