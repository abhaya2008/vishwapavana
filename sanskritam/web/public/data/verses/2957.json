[{"id": 2091983, "chapter_id": 2957, "verse_number": "१३-८७-१", "content_sanskrit": "युधिष्ठिर उवाच।\nसंशयो मे महाप्राज्ञ सुमहान्सागरोपम।\nतं मे शृणु महाबाहो श्रुत्वा व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091984, "chapter_id": 2957, "verse_number": "१३-८७-२", "content_sanskrit": "कौतूहलं मे सुमहज्जामदग्न्यं प्रति प्रभो।\nरामं धर्मभृतां श्रेष्ठं तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091985, "chapter_id": 2957, "verse_number": "१३-८७-३", "content_sanskrit": "`ब्राह्मे बले सुपूर्णानामेतेषां च्यवनादिनाम्।\nकथमेष समुत्पन्नो रामः सत्यपराक्रमः।\nकथं ब्रह्मर्षिवंशोऽयं क्षत्रधर्मा व्यजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091986, "chapter_id": 2957, "verse_number": "१३-८७-४", "content_sanskrit": "तदस्य सम्भवं राजन्निखिलेनानुकीर्तय।\nकौशिकश्च कथं वंशात्क्षात्राद्वै ब्राह्मणोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091987, "chapter_id": 2957, "verse_number": "१३-८७-५", "content_sanskrit": "अहो प्रभावः सुमहानासीद्वै सुमहात्मनोः।\nरामस्य च नरव्याघ्र विश्वामित्रस्य चैव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091988, "chapter_id": 2957, "verse_number": "१३-८७-६", "content_sanskrit": "कथं पुत्रानतिक्रम्य तेषां नप्तृष्वथाभवत्।\nएष दोषो महाप्राज्ञ तत्त्वं व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091989, "chapter_id": 2957, "verse_number": "१३-८७-७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091990, "chapter_id": 2957, "verse_number": "१३-८७-७", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nच्यवनस्य च संवादं कुशिकस्य च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091991, "chapter_id": 2957, "verse_number": "१३-८७-८", "content_sanskrit": "एतं दोषं पुरा दृष्ट्वा भार्गवश्च्यवनस्तदा।\nआगामिनं महाबुद्धिः स्ववंशे मुनिसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091992, "chapter_id": 2957, "verse_number": "१३-८७-९", "content_sanskrit": "निश्चित्य मनसा सर्वं गुणदोषबलाबलम्।\nदग्धुकामः कुलं सर्वं कुशिकानां तपोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091993, "chapter_id": 2957, "verse_number": "१३-८७-१०", "content_sanskrit": "च्यवनस्तमनुप्राप्य कुशिकं वाक्यमब्रवीत्।\nवस्तुमिच्छा समुत्पन्ना त्वया सह ममानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091994, "chapter_id": 2957, "verse_number": "१३-८७-११x", "content_sanskrit": "कुशिक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091995, "chapter_id": 2957, "verse_number": "१३-८७-११", "content_sanskrit": "भगवन्सहधर्मोऽयं पण्डितैरिह चर्यते।\nप्रदानकाले कन्यानामुच्यते च सदा बुधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091996, "chapter_id": 2957, "verse_number": "१३-८७-१२", "content_sanskrit": "यत्तु तावदतिक्रान्तं धर्मद्वारं तपोधन।\nतत्कार्यं प्रकरिष्यामि तदनुज्ञातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091997, "chapter_id": 2957, "verse_number": "१३-८७-१३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091998, "chapter_id": 2957, "verse_number": "१३-८७-१३", "content_sanskrit": "अथासनमुपादाय च्यवनस्य महामुनेः।\nकुशिको भार्यया सार्धमाजगाम यतो मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091999, "chapter_id": 2957, "verse_number": "१३-८७-१४", "content_sanskrit": "प्रगृह्य राजा भृङ्गारं पाद्यमस्मै न्यवेदयत्।\nकारयामास सर्वाश्च क्रियास्तस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092000, "chapter_id": 2957, "verse_number": "१३-८७-१५", "content_sanskrit": "ततः स राजा च्यवनं मधुपर्कं यथाविधि।\nग्राहयामास चाव्यग्रो महात्मा नियतव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092001, "chapter_id": 2957, "verse_number": "१३-८७-१६", "content_sanskrit": "सत्कृत्य तं तथा विप्रमिदं पुनरथाब्रवीत्।\nभगवन्परवन्तौ स्वो ब्रूहि किं करवावहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092002, "chapter_id": 2957, "verse_number": "१३-८७-१७", "content_sanskrit": "यदि राज्यं यदि धनं यदि गाः संशितव्रत।\nयज्ञदानानि च तथा ब्रूहि सर्वं ददामि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092003, "chapter_id": 2957, "verse_number": "१३-८७-१८", "content_sanskrit": "इदं गृहमिदं राज्यमिदं धर्मासनं च ते।\nराजा त्वमसि शाध्युर्वीं भृत्योऽहं परवान्स्त्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2092004, "chapter_id": 2957, "verse_number": "१३-८७-१९", "content_sanskrit": "एवमुक्ते ततो वाक्ये च्यवनो भार्गवस्तदा।\nकुशिकं प्रत्युवाचेदं मुदा परमया युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2092005, "chapter_id": 2957, "verse_number": "१३-८७-२०", "content_sanskrit": "न राज्यं कामये राजन्न धनं न च योषितः।\nन च गा न च वै देशान्न यज्ञं श्रूयतामिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2092006, "chapter_id": 2957, "verse_number": "१३-८७-२१", "content_sanskrit": "नियमं किञ्चिदारप्स्ये युवयोर्यदि रोचते।\nपरिचर्योस्मि यत्ताभ्यां युवाभ्यामविशङ्कया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2092007, "chapter_id": 2957, "verse_number": "१३-८७-२२", "content_sanskrit": "एवमुक्ते तदा तेन दम्पती तौ जहर्षतुः।\nप्रत्यब्रूतां च तमृषिमेवमस्त्विति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2092008, "chapter_id": 2957, "verse_number": "१३-८७-२३", "content_sanskrit": "अथ तं कुशिको हृष्टः प्रावेशयदनुत्तमम्।\nगृहोद्देशं ततस्तस्य दर्शनीयमदर्शयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2092009, "chapter_id": 2957, "verse_number": "१३-८७-२४", "content_sanskrit": "इयं शय्या भगवतो यथाकाममिहोष्यताम्।\nप्रयतिष्यावहे प्रीतिमाहर्तुं ते तपोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2092010, "chapter_id": 2957, "verse_number": "१३-८७-२५", "content_sanskrit": "अथ सूर्योतिचक्राम तेषां संवदतां तथा।\nअथर्षिश्चोदयामास पानमन्नं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2092011, "chapter_id": 2957, "verse_number": "१३-८७-२६", "content_sanskrit": "तमपृच्छत्ततो राजा कुशिकः प्रणतस्तदा।\nकिमन्नजातमिष्टं ते किमुपस्थापयाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2092012, "chapter_id": 2957, "verse_number": "१३-८७-२७", "content_sanskrit": "ततः स परया प्रीत्या प्रत्युवाच नराधिपम्।\nऔपपत्तिकमाहारं प्रयच्छस्वेति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2092013, "chapter_id": 2957, "verse_number": "१३-८७-२८", "content_sanskrit": "तद्वचः पूजयित्वा तु तथेत्याह स पार्थिवः।\nयथोपपन्नमाहारं तस्मै प्रादाज्जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2092014, "chapter_id": 2957, "verse_number": "१३-८७-२९", "content_sanskrit": "ततः स भुक्त्वा भगवन्दम्पती प्राह धर्मवित्।\nस्वप्तुमिच्छाम्यहं निद्रा बाधते मामिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2092015, "chapter_id": 2957, "verse_number": "१३-८७-३०", "content_sanskrit": "ततः शय्यागृहं प्राप्य भगवानृषिसत्तमः।\nसंविवेश नरेशस्तु सपत्नीकः स्थितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2092016, "chapter_id": 2957, "verse_number": "१३-८७-३१", "content_sanskrit": "न प्रबोध्योस्मि संसुप्त इत्युवाचाथ भार्गवः।\nसंवाहितव्यौ मे पादौ जागर्तव्यं च वां निशि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2092017, "chapter_id": 2957, "verse_number": "१३-८७-३२", "content_sanskrit": "अविशङ्कस्तु कुशिकस्तथेत्येवाह धर्मवित्।\nन प्राबोधयतां तौ च दंपती रजनीक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2092018, "chapter_id": 2957, "verse_number": "१३-८७-३३", "content_sanskrit": "यथादेशं महर्षेस्तु शुश्रूषापरमौ तदा।\nबभूवतुर्महाराज प्रयतावथ दम्पती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2092019, "chapter_id": 2957, "verse_number": "१३-८७-३४", "content_sanskrit": "ततः स भगवान्विप्रः समादिश्य नराधिपम्।\nसुष्वापैकेन पार्श्वेन दिवसानेकविंशतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2092020, "chapter_id": 2957, "verse_number": "१३-८७-३५", "content_sanskrit": "स तु राजा निराहारः सभार्यः कुरुनन्दन।\nपर्युपासत तं हृष्टश्च्यवनाराधने रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2092021, "chapter_id": 2957, "verse_number": "१३-८७-३६", "content_sanskrit": "भार्गवस्तु समुत्तस्थौ स्वयमेव तपोधनः।\nअकिञ्चिदुक्त्वा तु गृहान्निश्चक्राम महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2092022, "chapter_id": 2957, "verse_number": "१३-८७-३७", "content_sanskrit": "तमन्वगच्छतां तौ च क्षुधितौ श्रमकर्शितौ।\nभार्यापती मुनिश्रेष्ठस्तावेतौ नावलोकयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2092023, "chapter_id": 2957, "verse_number": "१३-८७-३८", "content_sanskrit": "तयोस्तु प्रेक्षतोऽरेव भार्गवाणां कुलोद्वहः।\nअन्तर्हितोभूद्राजेन्द्र ततो राजाऽपतत्क्षितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2092024, "chapter_id": 2957, "verse_number": "१३-८७-३९", "content_sanskrit": "ततो मुहूर्तादाश्वस्य सह देव्या महामुनेः।\nपुनरन्वेषणे यत्नमकरोत्स महीपतिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2092025, "chapter_id": 2957, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्ताशीतितमोऽध्यायः॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]