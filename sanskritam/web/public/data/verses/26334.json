[{"id": 7006334000, "chapter_id": 26334, "verse_number": "१-४४-१", "content_sanskrit": "वैशम्पायन उवाच श्रुतस्ते दैत्यसैन्यस्य विस्तरस्तात विग्रहे ।\nसुराणां सर्वसैन्यस्य विस्तरं वैष्णवं शृणु ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006334001, "chapter_id": 26334, "verse_number": "१-४४-२", "content_sanskrit": "आदित्या वसवो रुद्रा अश्विनौ च महाबलौ ।\nसबलाः सानुगाश्चैव संनह्यन्त यथाबलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006334002, "chapter_id": 26334, "verse_number": "१-४४-३", "content_sanskrit": "पुरुहूतस्तु पुरतो लोकपालः सहस्रदृक् ।\nग्रामणीः सर्वदेवानामारुरोह सुरद्विपम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006334003, "chapter_id": 26334, "verse_number": "१-४४-४", "content_sanskrit": "सव्ये चास्य रथः पार्श्वे पक्षिप्रवरवेगवान् ।\nसुचारुचक्रचरणो हेमवज्रपरिष्कृतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006334004, "chapter_id": 26334, "verse_number": "१-४४-५", "content_sanskrit": "देवगन्धर्वयक्षौघैरनुयातः सहस्रशः ।\nदीप्तिमद्भिः सदस्यैश्च ब्रह्मर्षिभिरभिष्टुतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006334005, "chapter_id": 26334, "verse_number": "१-४४-६", "content_sanskrit": "वज्रविस्फूर्जितोद्धूतैर्विद्युदिन्द्रायुधान्वितैः ।\nगुप्तो बलाहकगणैः कामगैरिव पर्वतैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006334006, "chapter_id": 26334, "verse_number": "१-४४-७", "content_sanskrit": "समारूढः स भगवान् पर्येति मघवा गजम् ।\nहविर्धानेषु गायन्ति विप्राः सोममखे स्थिताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006334007, "chapter_id": 26334, "verse_number": "१-४४-८", "content_sanskrit": "स्वर्गे शक्रानुयानेषु देवतूर्यनिनादिषु ।\nइन्द्रं समुपनृत्यन्ति शतशो ह्यप्सरोगणाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006334008, "chapter_id": 26334, "verse_number": "१-४४-९", "content_sanskrit": "केतुना वंशजातेन राजमानो यथा रविः ।\nयुक्तो हरिसहस्रेण मनोमारुतरंहसा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006334009, "chapter_id": 26334, "verse_number": "१-४४-१०", "content_sanskrit": "स स्यन्दनवरो भाति युक्तो मातलिना तदा ।\nकृत्स्नः परिवृतो मेरुर्भास्करस्येव तेजसा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006334010, "chapter_id": 26334, "verse_number": "१-४४-११", "content_sanskrit": "यमस्तु दण्डमुद्यम्य कालयुक्तं च मुद्गरम् ।\nतस्थौ सुरगणानीके दैत्यान् नादेन भीषयन् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006334011, "chapter_id": 26334, "verse_number": "१-४४-१२", "content_sanskrit": "चतुर्भिः सागरैर्गुप्तो लेलिहानैश्च पन्नगैः ।\nशङ्खमुक्ताङ्गदधरो बिभ्रत्तोयमयं वपुः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006334012, "chapter_id": 26334, "verse_number": "१-४४-१३", "content_sanskrit": "कालपाशं समाविध्य हयैः शशिकरोपमैः ।\nवाय्वीरितजलोद्गारैः कुर्वंल्लीलाः सहस्रशः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006334013, "chapter_id": 26334, "verse_number": "१-४४-१४", "content_sanskrit": "पाण्डुरोद्धूतवसनः प्रवालरुचिराधरः ।\nमणिश्यामोत्तमवपुर्हारभारार्पितोदरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006334014, "chapter_id": 26334, "verse_number": "१-४४-१५", "content_sanskrit": "वरुणः पाशभृन्मध्ये देवानीकस्य तस्थिवान् ।\nयुद्धवेलामभिलषत् भिन्नवेल इवार्णवः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006334015, "chapter_id": 26334, "verse_number": "१-४४-१६", "content_sanskrit": "यक्षराक्षससैन्येन गुह्यकानां गणैरपि ।\nमणिश्यामोत्तमवपुः कुबेरो नरवाहनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006334016, "chapter_id": 26334, "verse_number": "१-४४-१७", "content_sanskrit": "युक्तश्च शङ्खपद्माभ्यां निधीनामधिपः प्रभुः ।\nराजराजेश्वरः श्रीमान् गदापाणिरदृश्यत ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006334017, "chapter_id": 26334, "verse_number": "१-४४-१८", "content_sanskrit": "विमानयोधी धनदो विमाने पुष्पके स्थितः ।\nस राजराजः शुशुभे युद्धार्थी नरवाहनः ।\nप्रेक्ष्यमाणः शिवसखः साक्षादिव शिवः स्वयम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006334018, "chapter_id": 26334, "verse_number": "१-४४-१९", "content_sanskrit": "पूर्वं पक्षं सहस्राक्षः पितृराजस्तु दक्षिणम् ।\nवरुणः पश्चिमं पक्षमुत्तरं नरवाहनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006334019, "chapter_id": 26334, "verse_number": "१-४४-२०", "content_sanskrit": "चतुर्षु युक्ताश्चत्वारो लोकपाला बलोत्कटाः ।\nस्वासु दिक्ष्वभ्यरक्षन् वै तस्य देवबलस्य ह ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006334020, "chapter_id": 26334, "verse_number": "१-४४-२१", "content_sanskrit": "सूर्यः सप्ताश्वयुक्तेन रथेनाम्बरगामिना ।\nश्रिया जाज्वल्यमानेन दीप्यमानैश्च रश्मिभिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006334021, "chapter_id": 26334, "verse_number": "१-४४-२२", "content_sanskrit": "उदयास्तमयं चक्रे मेरुपर्यन्तगामिना ।\nत्रिदिवद्वारचक्रेण तपता लोकमव्ययम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006334022, "chapter_id": 26334, "verse_number": "१-४४-२३", "content_sanskrit": "सहस्ररश्मियुक्तेन भ्राजमानः स्वतेजसा ।\nचचार मध्ये देवानां द्वादशात्मा दिनेश्वरः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006334023, "chapter_id": 26334, "verse_number": "१-४४-२४", "content_sanskrit": "सोमः श्वेतहयैर्भाति स्यन्दने शीतरश्मिवान् ।\nहिमतोयप्रपूर्णाभिर्भाभिराह्लादयञ्जगत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006334024, "chapter_id": 26334, "verse_number": "१-४४-२५", "content_sanskrit": "तमृक्षयोगानुगतं शिशिरांशुं द्विजेश्वरम् ।\nजगच्छायाङ्किततनुं नैशस्य तमसः क्षयम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006334025, "chapter_id": 26334, "verse_number": "१-४४-२६", "content_sanskrit": "ज्योतिषामीश्वरं व्योम्नि रसानां रसनं प्रभुम् ।\nओषधीनां परित्राणं निधानममृतस्य च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006334026, "chapter_id": 26334, "verse_number": "१-४४-२७", "content_sanskrit": "जगतः प्रथमं भागं सौम्यं शीतमयं रसम ।\nददृशुर्दानवाः सोमं हिमप्रहरणस्थितम् ॥२७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006334027, "chapter_id": 26334, "verse_number": "१-४४-२८", "content_sanskrit": "यः प्राणः सर्वभूतानां पञ्चधा भिद्यते नृषु ।\nसप्तस्कन्धगतो लोकांस्त्रीन्दधार चराचरान् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006334028, "chapter_id": 26334, "verse_number": "१-४४-२९", "content_sanskrit": "यमाहुरग्नेर्यन्तारं सर्वप्रभवमीश्वरम् ।\nसप्तस्वरगता यस्य योनिर्गीतिरुदीर्यते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006334029, "chapter_id": 26334, "verse_number": "१-४४-३०", "content_sanskrit": "यं वदन्त्युत्तमं भूतं यं वदन्त्यशरीरिणम् ।\nयमाहुराकाशगमं शीघ्रगं शब्दयोनिजम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006334030, "chapter_id": 26334, "verse_number": "१-४४-३१", "content_sanskrit": "स वायुः सर्वभूतायुरुद्भूतः    स्वेन तेजसा ।\nववौ प्रव्यथयन् दैत्यान् प्रतिलोमः सतोयदः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006334031, "chapter_id": 26334, "verse_number": "१-४४-३२", "content_sanskrit": "मरुतो देवगन्धर्वा विद्याधरगणैः सह ।\nचिक्रीडुरसिभिः शुभ्रैर्निर्मुक्तैरिव पन्नगैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006334032, "chapter_id": 26334, "verse_number": "१-४४-३३", "content_sanskrit": "सृजन्तः सर्पपतयस्तीव्रं रोषमयं विषम् ।\nशरभूताः सुरेन्द्राणां चेरुर्व्यात्तमुखा दिवि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006334033, "chapter_id": 26334, "verse_number": "१-४४-३४", "content_sanskrit": "पर्वतास्तु शिलाशृङ्गैः शतशाखैश्च पादपैः ।\nउपतस्थुः सुरगणान् प्रहर्तुं दानवं बलम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006334034, "chapter_id": 26334, "verse_number": "१-४४-३५", "content_sanskrit": "यः स देवो इषीकेशः पद्मनाभस्त्रिविक्रमः ।\nकृष्णवर्त्मा युगान्ताभो विश्वस्य जगतः प्रभुः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006334035, "chapter_id": 26334, "verse_number": "१-४४-३६", "content_sanskrit": "समुद्रयोनिर्मधुहा हव्यभुक्क्रतुसत्कृतः ।\nभूरापोव्योमभूतात्मा समः शान्तिकरोऽरिहा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006334036, "chapter_id": 26334, "verse_number": "१-४४-३७", "content_sanskrit": "जगद्योनिर्जगद्बीजो जगद्गुरुरुदारधीः ।\nसोऽर्कमग्निमिवोद्यन्तमुद्यम्योत्तमतेजसम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006334037, "chapter_id": 26334, "verse_number": "१-४४-३८", "content_sanskrit": "अरिघ्नममरानीके चक्रं चक्रगदाधरः ।\nसपरीवेषमुद्यन्तं सवितुर्मण्डलं यथा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006334038, "chapter_id": 26334, "verse_number": "१-४४-३९", "content_sanskrit": "सव्येनालम्ब्य महतीं सर्वासुरविनाशिनीम् ।\nकरेण कालीं वपुषा शत्रुकालप्रदां गदाम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006334039, "chapter_id": 26334, "verse_number": "१-४४-४०", "content_sanskrit": "शेषैर्भुजैः प्रदीप्तानि भुजगारिध्वजः प्रभुः ।\nदधारायुधजालानि शार्ङ्गादीनि महायशाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006334040, "chapter_id": 26334, "verse_number": "१-४४-४१", "content_sanskrit": "स कश्यपस्यात्मभवं द्विजं भुजगभोजनम् ।\nपवनाधिकसम्पातं गगनक्षोभणं खगम् ।\nभुजगेन्द्रेण वदने निविष्टेन विराजितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006334041, "chapter_id": 26334, "verse_number": "१-४४-४२", "content_sanskrit": "अमृतारम्भनिर्मुक्तं मन्दराद्रिमिवोच्छ्रितम् ।\nदेवासुरविमर्देषु शतशो दृष्टविक्रमम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006334042, "chapter_id": 26334, "verse_number": "१-४४-४३", "content_sanskrit": "महेन्द्रेणामृतस्यार्थे वज्रेण कृतलक्षणम् ।\nशिखिनं चूडिनं चैव तप्तकुण्डलभूषणम् ।\nविचित्रपक्षवसनं धातुमन्तमिवाचलम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006334043, "chapter_id": 26334, "verse_number": "१-४४-४४", "content_sanskrit": "स्फीतक्रोडावलम्बेन शीतांशुसमतेजसा ।\nभोगिभोगावसक्तेन मणिरत्नेन भास्वता ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006334044, "chapter_id": 26334, "verse_number": "१-४४-४५", "content_sanskrit": "पक्षाभ्यां चारुचित्राभ्यामावृत्य दिवि लीलया ।\nयुगान्ते सेन्द्रचापाभ्यां तोयदाभ्यामिवाम्बरम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006334045, "chapter_id": 26334, "verse_number": "१-४४-४६", "content_sanskrit": "नीललोहितपीताभिः पताकाभिरलंकृतम् ।\nकेतुवेषप्रतिच्छन्नं महाकायनिकेतनम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006334046, "chapter_id": 26334, "verse_number": "१-४४-४७", "content_sanskrit": "अरुणावरजं श्रीमानारुह्य समरे हरिः ।\nसुवर्णं स्वेन वपुषा सुपर्णं खेचरोत्तमम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006334047, "chapter_id": 26334, "verse_number": "१-४४-४८", "content_sanskrit": "तमन्वयुर्देवगणा मुनयश्च तपोधनाः ।\nगीर्भिः परममन्त्राभिस्तुष्टुवुश्च गदाधरम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006334048, "chapter_id": 26334, "verse_number": "१-४४-४९", "content_sanskrit": "तद्वैश्रवणसंश्लिष्टं वैवस्वतपुरस्सरम् ।\nवारिराजपरिक्षिप्तं देवराजविराजितम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006334049, "chapter_id": 26334, "verse_number": "१-४४-५०", "content_sanskrit": "चन्द्रप्रभाभिर्विमलं युद्धाय समुपस्थितम् ।\nपवनाबद्धनिर्घोषं सम्प्रदीप्तहुताशनम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006334050, "chapter_id": 26334, "verse_number": "१-४४-५१", "content_sanskrit": "विष्णोर्जिष्णोः सहिष्णोश्च भ्राजिष्णोस्तेजसा वृतम् ।\nबलं बलवदुद्भूतं युद्धाय समवर्तत ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006334051, "chapter_id": 26334, "verse_number": "१-४४-५२", "content_sanskrit": "स्वस्त्यस्तु देवेभ्य इति स्तुत्वा तत्राङ्गिराऽब्रवीत् ।\nस्वस्त्यस्तु दैत्येभ्य इति उशना वाक्यमाददे ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]