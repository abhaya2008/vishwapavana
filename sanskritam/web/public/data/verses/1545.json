[{"id": 2025346, "chapter_id": 1545, "verse_number": "३-१८३-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2025347, "chapter_id": 1545, "verse_number": "३-१८३-१", "content_sanskrit": "भवानेतादृशो लोके वेदवेदाङ्गपारगः।\nब्रूहि किं कुर्वतः कर्म भवेद्गतिरनुत्तमा ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2025348, "chapter_id": 1545, "verse_number": "३-१८३-२x", "content_sanskrit": "सर्प उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2025349, "chapter_id": 1545, "verse_number": "३-१८३-२", "content_sanskrit": "पात्रे दत्त्वा प्रियाण्युक्त्वा सत्यमुक्त्वा च भारत।\nअहिंसानिरतः स्वर्गं गच्छेदिति मतिर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2025350, "chapter_id": 1545, "verse_number": "३-१८३-३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2025351, "chapter_id": 1545, "verse_number": "३-१८३-३", "content_sanskrit": "दानाद्वा सर्प सत्याद्वा किमतो गुरु दृश्यते।\nअहिंसाप्रिययोश्चैव गुरुलाघवमुच्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2025352, "chapter_id": 1545, "verse_number": "३-१८३-४x", "content_sanskrit": "सर्प उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2025353, "chapter_id": 1545, "verse_number": "३-१८३-४", "content_sanskrit": "दानं च सत्यं तत्त्वं वा अहिंसा प्रियमेव च।\nएषां कार्यगरीयस्त्वाद्दृश्यते गुरुलाघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2025354, "chapter_id": 1545, "verse_number": "३-१८३-५", "content_sanskrit": "क्वचिद्दानप्रयोगाद्धि सत्यमेव विशिष्यते।\nसत्यवाक्याच्च राजेनद्र क्वचिद्दानं विशिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2025355, "chapter_id": 1545, "verse_number": "३-१८३-६", "content_sanskrit": "एवमेव महेष्वास प्रियवाक्यान्महीपते।\nअहिंसा दृश्यते गुर्वी ततश्च प्रियमिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2025356, "chapter_id": 1545, "verse_number": "३-१८३-७", "content_sanskrit": "एवमेतद्भवेद्राजन्कार्यापेक्षमनन्तरम्।\nयदभिप्रेतमन्यत्ते ब्रूहि यावद्ब्रवीम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2025357, "chapter_id": 1545, "verse_number": "३-१८३-८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2025358, "chapter_id": 1545, "verse_number": "३-१८३-८", "content_sanskrit": "कथं स्वर्गे गतिः सर्प कर्मणां च फलं ध्रुवम्।\nअशरीरस्य दृश्येत प्रब्रूहि विषयांश्च मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2025359, "chapter_id": 1545, "verse_number": "३-१८३-९x", "content_sanskrit": "सर्प उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2025360, "chapter_id": 1545, "verse_number": "३-१८३-९", "content_sanskrit": "तिस्रो वै गतयो राजन्परिदृष्टाः स्वकर्मभिः।\nमानुषं स्वर्गवासश्च तिर्यग्योनिश्च तत्रिधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2025361, "chapter_id": 1545, "verse_number": "३-१८३-१०", "content_sanskrit": "तत्र वै मानुषाल्लोकाद्दानादिभिरनादिभिः।\nअहिंसार्थसमायुक्तैः कारणैः स्वर्गमश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2025362, "chapter_id": 1545, "verse_number": "३-१८३-११", "content_sanskrit": "विपरीतैश्च राजेन्द्र कारणैर्मानुषो भवेत्।\nतिर्यग्योनिस्तथा तात विशेषश्चात्र वक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2025363, "chapter_id": 1545, "verse_number": "३-१८३-१२", "content_sanskrit": "क्रामक्रोधसमायुक्तो हिंसालोभसमनवितः।\nमनुष्यत्वात्परिब्रष्टस्तिर्यग्योनौ प्रसूयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2025364, "chapter_id": 1545, "verse_number": "३-१८३-१३", "content_sanskrit": "तिर्यग्योन्याः पृथग्भावो मनुष्यार्थे विधीयते।\nगवादिभ्यस्तथाऽश्वेभ्यो देवत्वमपि दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2025365, "chapter_id": 1545, "verse_number": "३-१८३-१४", "content_sanskrit": "सोयमेता गतीस्तात जन्तुश्चरति कार्यवान्।\nनिम्ने महति चात्मानमवस्थाप्य च वै नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2025366, "chapter_id": 1545, "verse_number": "३-१८३-१५", "content_sanskrit": "जातो जातश्च बलवान्भुङ्क्ते नाम्नाऽथ देहवान्।\nफलार्थस्तात निष्पृक्तः प्रजालक्षणभावनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2025367, "chapter_id": 1545, "verse_number": "३-१८३-१६x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2025368, "chapter_id": 1545, "verse_number": "३-१८३-१६", "content_sanskrit": "शब्दे स्पर्शे च रूपे च तथैव रसगन्धयोः।\nतस्याधिष्ठानमव्यग्रो ब्रूहि सर्प यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2025369, "chapter_id": 1545, "verse_number": "३-१८३-१७", "content_sanskrit": "किं न गृह्णासि विषयान्युगपत्त्वं महामते।\nएतावदुच्यतां चोक्तं सर्वं पन्नगसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2025370, "chapter_id": 1545, "verse_number": "३-१८३-१८x", "content_sanskrit": "सर्प उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2025371, "chapter_id": 1545, "verse_number": "३-१८३-१८", "content_sanskrit": "तदात्मद्रव्यमायुष्मन्देहसंश्रयणान्वितम्।\nकरणाधिष्ठितं भोगानुपभुङ्क्ते यथाविथि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2025372, "chapter_id": 1545, "verse_number": "३-१८३-१९", "content_sanskrit": "ज्ञानं चैवात्र बुद्धिश्च कमश्च भरतर्षभ।\nतस्य भोगाधिकरणे करणानि निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2025373, "chapter_id": 1545, "verse_number": "३-१८३-२०", "content_sanskrit": "मनसा तात पर्येति क्रमशो विषयानिमान्।\nविषयायतनत्वेन भूतात्मा क्षेत्रविष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2025374, "chapter_id": 1545, "verse_number": "३-१८३-२१", "content_sanskrit": "तत्रचापि नरव्याघ्र मनो जन्तोर्विधीयते।\nतस्माद्युगपदत्रास्य ग्रहणं नोपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2025375, "chapter_id": 1545, "verse_number": "३-१८३-२२", "content_sanskrit": "स आत्मा पुरुषव्याघ्र भ्रुवोरन्तरमाश्रितः।\nबुद्धिं द्रव्येषु सृजति विविधेषु परावराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2025376, "chapter_id": 1545, "verse_number": "३-१८३-२३", "content_sanskrit": "बुद्धेरुत्तरकालं च वेदना दृश्यते बुधैः।\nएष वै राजशार्दूल विधिः क्षेत्रज्ञभावनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2025377, "chapter_id": 1545, "verse_number": "३-१८३-२४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2025378, "chapter_id": 1545, "verse_number": "३-१८३-२४", "content_sanskrit": "मनसश्चापि बुद्धेश्च ब्रूहि मे लक्षणं परम्।\nएतदध्यात्मविदुषां परं कार्यं विधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2025379, "chapter_id": 1545, "verse_number": "३-१८३-२५x", "content_sanskrit": "सर्प उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2025380, "chapter_id": 1545, "verse_number": "३-१८३-२५", "content_sanskrit": "बुद्धिरात्मानुगाऽतीव उत्पातेन विधीयते।\nतदाश्रिता हि सा ज्ञेया बुद्धिस्तस्यैषिणी भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2025381, "chapter_id": 1545, "verse_number": "३-१८३-२६", "content_sanskrit": "बुद्धिरुत्पद्यते कार्यान्मनस्तूत्पन्नमेव हि।\nबुद्धेर्गुणविधानेन मनस्तद्गुणवद्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2025382, "chapter_id": 1545, "verse_number": "३-१८३-२७", "content_sanskrit": "एतद्विशेषणं तात मनोबुद्ध्योर्मयेरितम्।\nत्वमप्यत्राभिसंबुद्धः कथं वा मनय्से स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2025383, "chapter_id": 1545, "verse_number": "३-१८३-२८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2025384, "chapter_id": 1545, "verse_number": "३-१८३-२८", "content_sanskrit": "अहो बुद्धिमतांश्रेष्ठ शुभा बुद्धिरियं तव।\nविदितं वेदितव्यं ते कस्मान्नहुष पृच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2025385, "chapter_id": 1545, "verse_number": "३-१८३-२९", "content_sanskrit": "सर्वज्ञं त्वां कथं मोह आविशत्स्वर्गवासिनम्।\nएवमद्भुतकर्माणमिति मे संशयो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2025386, "chapter_id": 1545, "verse_number": "३-१८३-३०x", "content_sanskrit": "सर्प उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2025387, "chapter_id": 1545, "verse_number": "३-१८३-३०", "content_sanskrit": "सुप्रज्ञमपि चेच्छूरमृद्धिर्मोहयते नरम्।\nवर्तमानः सुखे सर्वो नावैतीति मतिर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2025388, "chapter_id": 1545, "verse_number": "३-१८३-३१", "content_sanskrit": "सोहमैश्वर्यमोहेन मदाविष्टो युधिष्ठिर।\nपतितः प्रतिसंबुद्धस्त्वां तु संबोधयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2025389, "chapter_id": 1545, "verse_number": "३-१८३-३२", "content_sanskrit": "कृतंकार्यं महाराज त्वया मम परंतप।\nक्षीणः शाप सुकृच्छ्रो मे त्वया संभाष्य साधुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2025390, "chapter_id": 1545, "verse_number": "३-१८३-३३", "content_sanskrit": "अहं हि दिवि दिव्येन विमानन चरन्पुरा।\nअभिमानेन मत्तः सन्कंचिन्नान्यमचिन्तयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2025391, "chapter_id": 1545, "verse_number": "३-१८३-३४", "content_sanskrit": "ब्रह्मर्षिदेघगन्धर्वयक्षराक्षसपन्नगाः।\nवरं मम प्रयच्छन्ति सर्वे त्रैलोक्यवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2025392, "chapter_id": 1545, "verse_number": "३-१८३-३५", "content_sanskrit": "चक्षुषा यं प्रपश्यामि प्राणिनं पृथिवीपते।\nतस्य तेजो हराम्याशु तद्धि दृष्टेर्बलं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2025393, "chapter_id": 1545, "verse_number": "३-१८३-३६", "content_sanskrit": "ब्रह्मर्षीणां सरस्रं हि उवाह शिबिकां मम।\nकस मामपनयो राजन्भ्रंशयामास वै श्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2025394, "chapter_id": 1545, "verse_number": "३-१८३-३७", "content_sanskrit": "तत्र ह्यगस्त्यः पादेन वहन्स्पृष्टो महामुनिः।\nअगस्त्येन ततोस्म्युक्तो ध्वंस सर्पेति वैरुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2025395, "chapter_id": 1545, "verse_number": "३-१८३-३८", "content_sanskrit": "ततस्तस्माद्विमानाग्र्यात्प्रच्युतश्च्युतलक्षणः।\nप्रपतन्बुबुधेऽऽत्मानं व्यालीभूतमधोमुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2025396, "chapter_id": 1545, "verse_number": "३-१८३-३९", "content_sanskrit": "अयाचं तमहं विप्रं शापस्यान्तो भवेदिति।\nप्रमादात्संप्रमूढस्य भगवन्क्षन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2025397, "chapter_id": 1545, "verse_number": "३-१८३-४०", "content_sanskrit": "ततः स मामुवाचेदं प्रपतन्तं कृपानवितः।\nयुधिष्ठिरो धर्मराजः शापात्त्वां मोक्षयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2025398, "chapter_id": 1545, "verse_number": "३-१८३-४१", "content_sanskrit": "अभिमानस्य वै तस्य बलस्य च नराधिप।\nफले क्षीणे महाराज फलं पुण्यमवाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2025399, "chapter_id": 1545, "verse_number": "३-१८३-४२", "content_sanskrit": "ततो मे विस्मयो जातस्तद्दृष्ट्वा तपसो बलम्।\nब्रह्म च ब्राह्मणत्वं च येन त्वाऽहमचूचुदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2025400, "chapter_id": 1545, "verse_number": "३-१८३-४३", "content_sanskrit": "सत्यं दमस्तपो योगमहिंसा ज्ञाननित्यता।\nसाधकानि सतां पुंसां न जातिर्नकुलं नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2025401, "chapter_id": 1545, "verse_number": "३-१८३-४४", "content_sanskrit": "अरिष्ट कएष ते भ्राता मुक्तो बीमो महाभुज।\nस्वस्ति तेऽस्तु महाराज गमिष्यामि दिवं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2025402, "chapter_id": 1545, "verse_number": "३-१८३-४५", "content_sanskrit": "`स चायं पुरुषव्याघ्र कालः पुण्य उपागतः।\nतदस्मात्कारणात्पार्थ कार्यं तन्मे महत्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2025403, "chapter_id": 1545, "verse_number": "३-१८३-४६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2025404, "chapter_id": 1545, "verse_number": "३-१८३-४६", "content_sanskrit": "`ततस्तस्मिन्मुहूर्ते तु विमानं कामगामि वै।\nअवपातेन महता तत्रावाप तदुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2025405, "chapter_id": 1545, "verse_number": "३-१८३-४७", "content_sanskrit": "इत्युक्त्वाऽऽजगरं देहं मुक्त्वा स नहुषो नृपः।\nदिव्यं वपुः समास्थाय गतस्त्रिदिवमेव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2025406, "chapter_id": 1545, "verse_number": "३-१८३-४८", "content_sanskrit": "युधिष्ठिरोपि धर्मात्मा भ्रात्रा भीमेन संगतः।\nधौम्येन सहितः श्रीमानाश्रमं पुनरागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2025407, "chapter_id": 1545, "verse_number": "३-१८३-४९", "content_sanskrit": "ततो द्विजेभ्यः सर्वेभ्यः समेतेभ्यो यथातथम्।\nकथयामास तत्सर्वं धर्मराजो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2025408, "chapter_id": 1545, "verse_number": "३-१८३-५०", "content_sanskrit": "तच्छ्रुत्वा ते द्विजाः सर्वे भ्रातरश्चास्य ते त्रयः।\nआसन्सुव्रीडिता राजन्द्रौपदी च यशस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2025409, "chapter_id": 1545, "verse_number": "३-१८३-५१", "content_sanskrit": "ते तु सर्वेद्विजश्रेष्ठाः पाण्डवानां हितेप्सया।\nमैवमित्यब्रुवन्भीमं गर्हयन्तोऽस् साहसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2025410, "chapter_id": 1545, "verse_number": "", "content_sanskrit": "पाण्डवास्तु भयान्पुक्तं प्रेक्ष्य भीमं महाबलम्।\nहर्षमाहारयांचक्रुर्विजह्रुश्च मुदा युताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]