[{"id": 7003491000, "chapter_id": 23491, "verse_number": "१३१-१", "content_sanskrit": "अथ दन्तकाष्ठाचर्वणप्रायश्चित्तम् ।\nश्रीवराह उवाच ।\nदन्तकाष्ठमचर्वित्वा यो हि मामुपसर्पति ।\nपूर्वकालकृतं कर्म तेन चैकेन नश्यति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003491001, "chapter_id": 23491, "verse_number": "१३१-२", "content_sanskrit": "नारायणवचः श्रुत्वा पृथिवी धर्मसंश्रितः ।\nविष्णुभक्तसुखार्थाय हृषीकेशमुवाच ह ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003491002, "chapter_id": 23491, "verse_number": "१३१-३", "content_sanskrit": "धरण्युवाच ।\nसर्वकालकृतं कर्म क्लेशेन महताऽनघ ।\nकथमेकापराधेन सर्वमेव प्रणश्यति ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003491003, "chapter_id": 23491, "verse_number": "१३१-४", "content_sanskrit": "श्रीवराह उवाच ।\nशृणु सुन्दरि तत्त्वेन कथ्यमानं मयाऽनघे ।\nयेन चैकापराधेन पूर्वकर्म प्रणश्यति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003491004, "chapter_id": 23491, "verse_number": "१३१-५", "content_sanskrit": "मनुष्यः किल्बिषी भद्रे कफपित्तसमन्वितः ।\nपूयशोणितसम्पूर्णं दुर्गन्धि मुखमस्य तत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003491005, "chapter_id": 23491, "verse_number": "१३१-६", "content_sanskrit": "तत्सर्वबीजं नश्येत दन्तकाष्ठस्य भक्षणात् ।\nशुद्धिर्भागवती चैव आचारेण विवर्जिता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003491006, "chapter_id": 23491, "verse_number": "१३१-७", "content_sanskrit": "धरण्युवाच ।\nदन्तकाष्ठमखादित्वा यः कर्माणि करोति ते ।\nप्रायश्चित्तं च मे ब्रूहि येन धर्मो न नश्यति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003491007, "chapter_id": 23491, "verse_number": "१३१-८", "content_sanskrit": "श्रीवराह उवाच ।\nएवमेतन्महाभागे यन्मां त्वं परिपृच्छसि ।\nकथयिष्यामि हीदं ते यथा शुद्ध्यन्ति मानवाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003491008, "chapter_id": 23491, "verse_number": "१३१-९", "content_sanskrit": "आकाशशयनं कृत्वा दिनानि द्वे च पंच च ।\nअभुक्तदन्तकाष्ठाश्च एवं शुध्यन्ति मानवाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003491009, "chapter_id": 23491, "verse_number": "१३१-१०", "content_sanskrit": "एवं ते कथितं भद्रे दन्तकाष्ठस्य भक्षणम् ।\nय एतेन विधानेन प्रायश्चित्तं समाचरेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003491010, "chapter_id": 23491, "verse_number": "१३१-११", "content_sanskrit": "कुतस्तस्यापराधोऽस्ति एवमेव न संशयः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]