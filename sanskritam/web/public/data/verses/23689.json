[{"id": 7003689000, "chapter_id": 23689, "verse_number": "१-३-१०-१", "content_sanskrit": "ब्रह्मोवाच ।\nअथ देवा महीं हित्वा महिषासुरपीडिताः ।\nनत्वा गौरीं तपस्यंतीं जग्मुः शरणमाकुलाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003689001, "chapter_id": 23689, "verse_number": "१-३-१०-२", "content_sanskrit": "अथ तानभयं देहि देवीति भयविह्वलान् ।\nअमरान्वीक्ष्य सा देवी किं कार्यमिति चाभ्यधात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003689002, "chapter_id": 23689, "verse_number": "१-३-१०-३", "content_sanskrit": "ततो विज्ञापयामासुर्दैत्येंद्राद्भयमात्मनाम् ।\nदेव्यै बद्धांजलिपुटा देवा इंद्रपुरोगमाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003689003, "chapter_id": 23689, "verse_number": "१-३-१०-४", "content_sanskrit": "देवा ऊचुः ।\nअप्सरोभिः परिवृतः सुखं क्रीडति नंदने ।\nऐरावतमुखान्सर्वान्दिङ्नागान्निजमंदिरे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003689004, "chapter_id": 23689, "verse_number": "१-३-१०-५", "content_sanskrit": "आवसयन्विनोदार्थमंगनाभिः सहागतान् ।\nउच्चैःश्रवःपुरोगानामुपभोगं करोत्यसौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003689005, "chapter_id": 23689, "verse_number": "१-३-१०-६", "content_sanskrit": "मंदुरास्वस्य रम्यासु दृश्यंते लक्षकोटयः ।\nहुताशवाहनं मेषं पुत्रारोहार्थमीप्सति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003689006, "chapter_id": 23689, "verse_number": "१-३-१०-७", "content_sanskrit": "याम्यं महिषमानीय शकटे सोऽभ्यवाहयत् ।\nसिद्धीराकृष्य सकला गृहकर्मणि चादिशत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003689007, "chapter_id": 23689, "verse_number": "१-३-१०-८", "content_sanskrit": "अप्सरःसंघमखिलमात्मसेवार्थमानयत् ।\nअन्यत्किमपि यद्वस्तु रत्नभूतं जगत्त्रये ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003689008, "chapter_id": 23689, "verse_number": "१-३-१०-९", "content_sanskrit": "अनाहृतं पुनर्हर्तुं न विश्राम्यति कोपवान् ।\nवयं च सेवका भूत्वा नित्यं भीतिसमन्विताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003689009, "chapter_id": 23689, "verse_number": "१-३-१०-१०", "content_sanskrit": "पूजयंतश्च तस्याज्ञां नान्यां वीक्षामहे गतिम् ।\nशरणागतसंत्राणं तपःफलमुदाहृतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003689010, "chapter_id": 23689, "verse_number": "१-३-१०-११", "content_sanskrit": "दुर्जयोऽयं वरो दैत्यः सर्वेषां बलिनामपि ।\nसुराणामपि दैत्यानां शिवाल्लब्धवरोदयः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003689011, "chapter_id": 23689, "verse_number": "१-३-१०-१२", "content_sanskrit": "अस्य शृंगाहतः सिंधुर्व्यावर्जितमिति ब्रुवन् ।\nरत्नोपहारदानेन नित्यं तत्प्रीतिमिच्छति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003689012, "chapter_id": 23689, "verse_number": "१-३-१०-१३", "content_sanskrit": "पर्वतांश्च समुत्क्षिप्य शृंगाग्रेण महोद्धतः ।\nक्रीडति क्षोदिताशेषधातुधूलिविलेपनैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003689013, "chapter_id": 23689, "verse_number": "१-३-१०-१४", "content_sanskrit": "न शक्यमतुलं तस्य बलमन्यदुरासदम् ।\nस्वयमेव विजानीहि हत्वा ते निजतेजसा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003689014, "chapter_id": 23689, "verse_number": "१-३-१०-१५", "content_sanskrit": "शंभुशक्तिः परा सेयं स्त्रीरूपेणात्र दृश्यते ।\nत्वयैवायं निहंतव्यः शिवाल्लब्धवरो ह्ययम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003689015, "chapter_id": 23689, "verse_number": "१-३-१०-१६", "content_sanskrit": "न जानीमो वयं देवि किंचिच्छंभुविचेष्टितम् ।\nकेवलं पालनीयाः स्म जगन्मात्रा सदा त्वया ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003689016, "chapter_id": 23689, "verse_number": "१-३-१०-१७", "content_sanskrit": "इति तेषां भयार्तानामाकर्ण्य वचनं शुभम् ।\nव्याजहार प्रसन्नात्मा देवी दत्त्वाभयं तदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003689017, "chapter_id": 23689, "verse_number": "१-३-१०-१८", "content_sanskrit": "शरणागतसंत्राणं तपसि स्थितया मया ।\nकर्त्तव्यममराः कालात्क्षीणः शत्रुर्भविष्यति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003689018, "chapter_id": 23689, "verse_number": "१-३-१०-१९", "content_sanskrit": "उपायेन समाकृष्य हनिष्यामि महासुरम् ।\nनिरागसस्तु हननमद्य मे न हि युज्यते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003689019, "chapter_id": 23689, "verse_number": "१-३-१०-२०", "content_sanskrit": "धर्मगे धर्मभेत्तारः शलभत्वं व्रजंति हि ।\nदेवास्तद्वचनं श्रुत्वा प्रणम्य गिरिकन्यकाम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003689020, "chapter_id": 23689, "verse_number": "१-३-१०-२१", "content_sanskrit": "जग्मुर्यथागतं सर्वे निर्भया हृष्टचेतसः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003689021, "chapter_id": 23689, "verse_number": "१-३-१०-२२", "content_sanskrit": "गतेषु तेषु देवेषु गौरी कमललोचना ।\nबभूव मोहिनी शक्तिः कांतियुक्ता ततोदरी ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003689022, "chapter_id": 23689, "verse_number": "१-३-१०-२३", "content_sanskrit": "सा देवी दिक्षु शैलेषु चतुर्ष्वरुणभूभृतः ।\nरक्षार्थं स्थापितवती चतुरो बटुकान्वरान् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003689023, "chapter_id": 23689, "verse_number": "१-३-१०-२४", "content_sanskrit": "यदा कैलासशिखरादागता शैलकन्यका ।\nअन्वगच्छन्सेवमानाश्चतस्रो मातरस्तदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003689024, "chapter_id": 23689, "verse_number": "१-३-१०-२५", "content_sanskrit": "दुन्दुभिः सत्यवत्याख्या तथा चानवमी परा ।\nसुन्दरीति चतस्रस्तामन्वयुः परिचारिकाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003689025, "chapter_id": 23689, "verse_number": "१-३-१०-२६", "content_sanskrit": "विमुञ्चतातिथिं श्रांतं क्षुत्पिपासा समन्वितम् ।\nअरुणाद्रिमिमं द्रष्टुं नान्यमित्यब्रवीच्च तान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003689026, "chapter_id": 23689, "verse_number": "१-३-१०-२७", "content_sanskrit": "सीमाशलस्थितान्वीरांस्तानादिश्य बलाधिकान् ।\nतपश्चचाराद्रिकन्या गौतमाश्रमसन्निधौ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003689027, "chapter_id": 23689, "verse_number": "१-३-१०-२८", "content_sanskrit": "तस्यां तपत्यां तन्वंग्यां न तापः कश्चिदप्यभूत् ।\nववर्ष काले जलदः सफलाश्चाभवन्द्रुमाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003689028, "chapter_id": 23689, "verse_number": "१-३-१०-२९", "content_sanskrit": "विरोधीनि च सत्त्वानि मुमुचुः पूर्वमत्सरम् ।\nआश्रमः सर्वजन्तूनां शरण्योऽभूद्भयापहः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003689029, "chapter_id": 23689, "verse_number": "१-३-१०-३०", "content_sanskrit": "योजनद्वयपर्यंतं सीमाशैलेषु संस्थितैः ।\nचतुभिर्वटकैः शूरै रक्षितश्चारुणाचलः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003689030, "chapter_id": 23689, "verse_number": "१-३-१०-३१", "content_sanskrit": "नोदभूत्कश्चन त्रासो न च दृष्टो भयोदयः ।\nन व्याधिपीडनं चासीत्तत्र नारिविजृंभणम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003689031, "chapter_id": 23689, "verse_number": "१-३-१०-३२", "content_sanskrit": "कृतार्था मुनयः सर्वे प्रशंसंतो नगात्मजाम् ।\nशिवलोकपदं केचित्प्रत्यशंसंस्तथाश्रमम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003689032, "chapter_id": 23689, "verse_number": "१-३-१०-३३", "content_sanskrit": "सा च गौरी तपो घोरं कुर्वती च दिवानिशम् ।\nन तृप्तिमाययौ बाला शिवसंतोषकारकम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003689033, "chapter_id": 23689, "verse_number": "१-३-१०-३४", "content_sanskrit": "महिषश्च महावीर्यो मृगयां कर्तुमुद्यतः ।\nचचार काननं सर्वं विदूरे शोणभूभृतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003689034, "chapter_id": 23689, "verse_number": "१-३-१०-३५", "content_sanskrit": "दैत्यसैन्यसमायुक्तो मृगयूथान्यनेकशः ।\nवनेषु निघ्नस्तरसा विचचाराशु भक्षयन् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003689035, "chapter_id": 23689, "verse_number": "१-३-१०-३६", "content_sanskrit": "धन्विभिर्बलिभिर्वीरैर्मृगाः केचिदनुद्रुताः ।\nभयार्त्ताः परिधावंतः प्राविशंस्तं तथाश्रमम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003689036, "chapter_id": 23689, "verse_number": "१-३-१०-३७", "content_sanskrit": "अनुव्रजन्तो दितिजा मृगांस्तान्हंतुमुद्यताः ।\nवारिता बटुकैर्वीरैर्मा यातात्रेति सत्वरैः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003689037, "chapter_id": 23689, "verse_number": "१-३-१०-३८", "content_sanskrit": "किमत्रेति तदा पृष्टा बटुका दुष्टदानवैः ।\nतपस्यति वरारोहा कन्यात्रेत्याहुरंजसा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003689038, "chapter_id": 23689, "verse_number": "१-३-१०-३९", "content_sanskrit": "न केनचित्प्रवेष्टव्यं बलिना मुनिसेवितम् ।\nतपःस्थानमिदं देव्याः शरणागतरक्षकम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003689039, "chapter_id": 23689, "verse_number": "१-३-१०-४०", "content_sanskrit": "इति तेषां वचः श्रुत्वा बलिनो दुष्टदानवाः ।\nतथेति विनिवृत्त्याशु कर्त्तव्यं समचिंतयन् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003689040, "chapter_id": 23689, "verse_number": "१-३-१०-४१", "content_sanskrit": "मायया पक्षिरूपास्ते प्रविश्याश्रममादरात् ।\nआरामवृक्षशाखासु निषेदुः खादिहेक्षितुम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003689041, "chapter_id": 23689, "verse_number": "१-३-१०-४२", "content_sanskrit": "सा पुनर्ल्लसितारण्ये सर्वर्तुकुसुमान्विते ।\nतपस्यन्ती तदा दृष्टा माया दैत्यस्य सैनिकैः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003689042, "chapter_id": 23689, "verse_number": "१-३-१०-४३", "content_sanskrit": "रूपलावण्यते तस्या निश्चयं तपसि स्थितम् ।\nवीक्ष्य ते विस्मयोपेता गत्वा तस्मै न्यवेदयन् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003689043, "chapter_id": 23689, "verse_number": "१-३-१०-४४", "content_sanskrit": "स स्मरार्तो वृद्धरूपः प्रविवेशाश्रमं तदा ।\nपूजितोऽस्याः सखीभिश्च गतश्रांतिरिव स्थितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003689044, "chapter_id": 23689, "verse_number": "१-३-१०-४५", "content_sanskrit": "वृद्धोऽपृच्छत्किमर्थं तु तपोऽस्या इति तास्तथा ।\nबाला कांतप्रसादार्थं चिरमत्र तपस्यति ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003689045, "chapter_id": 23689, "verse_number": "१-३-१०-४६", "content_sanskrit": "परं स बलवान्कांतो न कदापि प्रसीदति ।\nकार्यं विवाहसमये मनोरथं यथोचितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003689046, "chapter_id": 23689, "verse_number": "१-३-१०-४७", "content_sanskrit": "अपूर्वप्रभुणा तेन नवोपकरणं महत् ।\nसद्योजातकुलालेन सद्यः सृष्टैर्विपाचितैः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003689047, "chapter_id": 23689, "verse_number": "१-३-१०-४८", "content_sanskrit": "भाजनरपि साद्यस्कैर्न्यस्तः पक्वैश्च शालिभिः ।\nतादृशैः साधनैः सर्वैस्तादृशैर्द्रव्यसंचयैः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003689048, "chapter_id": 23689, "verse_number": "१-३-१०-४९", "content_sanskrit": "अपूर्वदृष्टविभवैः कार्यं स्यादुपकारणम् ।\nसिद्धे तथोपकरणेऽस्याः सद्योऽस्तु स्वयंवरः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003689049, "chapter_id": 23689, "verse_number": "१-३-१०-५०", "content_sanskrit": "इति तासां वचः श्रुत्वा विहसन्महिषोऽभ्यधात् ।\nतपःफलमहं प्राप्तः सत्यमस्या इति स्थितम् ।\nमदीया सकलां भूतिं शृणु बाले तपस्विनि ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003689050, "chapter_id": 23689, "verse_number": "१-३-१०-५१", "content_sanskrit": "महिषोऽहं महावीरो दैत्येन्द्रः सुरवंदितः ।\nजगत्त्रयमिदं सर्वं मयैव परिगृह्यते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003689051, "chapter_id": 23689, "verse_number": "१-३-१०-५२", "content_sanskrit": "अनन्यवीरसद्भावो मय्येव भुजशुष्मणा ।\nकामरूपोस्म्यहं बाले सर्वभोगप्रदायकः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003689052, "chapter_id": 23689, "verse_number": "१-३-१०-५३", "content_sanskrit": "भज मां तव भर्त्तारं प्राणिनां तपसः फलम् ।\nसर्वं संपादयिष्यामि कल्पवृक्षैः समाहृतैः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003689053, "chapter_id": 23689, "verse_number": "१-३-१०-५४", "content_sanskrit": "सृजामि तपसा चाहं विश्वकर्माणमादितः ।\nकामधेनुसहस्राणि सृजामि तपसा क्षणात् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003689054, "chapter_id": 23689, "verse_number": "१-३-१०-५५", "content_sanskrit": "नवभिर्निधिभिः प्राप्तैः पार्श्वस्थैर्नित्यदा मम ।\nअपेक्षितार्थसंसिद्धिः सहसैवोपपाद्यते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003689055, "chapter_id": 23689, "verse_number": "१-३-१०-५६", "content_sanskrit": "इति तस्य वचः श्रुत्वा स्मृतदेवाभवत्क्रमात् ।\nविसृज्य मौनं शनकैर्विहसंती तमब्रवीत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003689056, "chapter_id": 23689, "verse_number": "१-३-१०-५७", "content_sanskrit": "अहं बलवतो भार्या भविष्यामि तपश्चिरम् ।\nकरोमि यद्यसि बली बलं दर्शय मे निजम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003689057, "chapter_id": 23689, "verse_number": "१-३-१०-५८", "content_sanskrit": "विरच स्त्रीस्वभावं स्वं श्रुत्वा तद्वाक्यमुत्थितम् ।\nहते कोयमिति क्रोधान्ननर्द महिषासुरः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003689058, "chapter_id": 23689, "verse_number": "१-३-१०-५९", "content_sanskrit": "जिघृक्षतं समायांतं वीक्ष्य तं महिषासुरम् ।\nअभूद्दुरासदा दुर्गा कन्या सा ज्वलनाकृतिः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003689059, "chapter_id": 23689, "verse_number": "१-३-१०-६०", "content_sanskrit": "महामायां समालोक्य ज्वलंती पुरतः स्थिताम् ।\nस्वयं स महिषाकारो ववृधे मेरुसन्निभः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003689060, "chapter_id": 23689, "verse_number": "१-३-१०-६१", "content_sanskrit": "कुलभूधरशृंगाणि शृंगाभ्यां मुहुराक्षिपन् ।\nआजुहाव निजां सेनामापूरितदिगंतराम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003689061, "chapter_id": 23689, "verse_number": "१-३-१०-६२", "content_sanskrit": "अथ ब्रह्ममुखा देवाः प्रणम्य विविधायुधैः ।\nपूजयामासुरात्मीयैर्दुर्गां कालाग्निरूपिणीम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003689062, "chapter_id": 23689, "verse_number": "१-३-१०-६३", "content_sanskrit": "पंचहेतीर्हरिः प्रादाद्दश चापि सदाशिवः ।\nब्रह्मा चतस्रश्च तदा तस्यै मायातिरोहिताः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003689063, "chapter_id": 23689, "verse_number": "१-३-१०-६४", "content_sanskrit": "दिक्पालाश्च सुराश्चान्ये पर्वताश्च पयोधयः ।\nस्वीयैराभरणैः शस्त्रैरधृष्यास्तामपूजयन् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003689064, "chapter_id": 23689, "verse_number": "१-३-१०-६५", "content_sanskrit": "माया सा बहुभिर्हस्तैर्ज्वलदायुधसंचयैः ।\nआबद्धकवचा तूर्णं दुर्गाभूत्सिंहवाहना ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003689065, "chapter_id": 23689, "verse_number": "१-३-१०-६६", "content_sanskrit": "आपूरितदिशाभोगा तेजस्तत्सोढुमक्षमः ।\nदुर्गाया घोरमालोक्य महिषस्तु पलायितः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003689066, "chapter_id": 23689, "verse_number": "१-३-१०-६७", "content_sanskrit": "अथ तेजो निजं घोरं प्रज्वलत्सोढुमक्षमम् ।\nपलायमानमालोक्य महिषं सा व्यचिंतयत् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003689067, "chapter_id": 23689, "verse_number": "१-३-१०-६८", "content_sanskrit": "उपायेन निहंतव्यो दुष्टोऽयं महिषासुरः ।\nमदपूर्वं निवृत्यंते मृगा मृगयुभिर्वने ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003689068, "chapter_id": 23689, "verse_number": "१-३-१०-६९", "content_sanskrit": "दूतोक्तिभिः समाकृष्य मृद्वीभिर्मर्मवृत्तिभिः ।\nकोपमस्य समुद्भाव्य करिष्येभिमुखं क्षणात् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003689069, "chapter_id": 23689, "verse_number": "१-३-१०-७०", "content_sanskrit": "अधर्मवृत्तियुक्तानां धर्मवाक्यपरिश्रवात् ।\nकोपः समुद्भवेत्सद्यः स्वजीवक्षयकारणम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003689070, "chapter_id": 23689, "verse_number": "१-३-१०-७१", "content_sanskrit": "अथवा धर्मबुद्धिस्सन्यदि शांतो भविष्यति ।\nतदा हितोपदेशेन धर्मलोपो न संभवेत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003689071, "chapter_id": 23689, "verse_number": "१-३-१०-७२", "content_sanskrit": "तपस्यद्भिः सदा कार्यः कोपत्यागः फलान्वितः ।\nधर्महानिर्न सोढव्या तत्कोपो हि तपः परम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003689072, "chapter_id": 23689, "verse_number": "१-३-१०-७३", "content_sanskrit": "इति संचिंत्य सा गौरी नाम्ना सुरगुरुं मुनिम् ।\nसंकल्प्य वानरमुखं प्राहिणोदसुरं प्रति ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003689073, "chapter_id": 23689, "verse_number": "१-३-१०-७४", "content_sanskrit": "गच्छ त्वं मायया युक्तो महर्षे वानरानन ।\nमहिषं बोधयित्वा च वचनं शीघ्रमाव्रज ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003689074, "chapter_id": 23689, "verse_number": "१-३-१०-७५", "content_sanskrit": "मैव त्वमरुणाद्रीशमुपपीडय दुर्मते ।\nअत्र दुर्मनसां वीर्यमदृश्यं भवति क्षणात् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003689075, "chapter_id": 23689, "verse_number": "१-३-१०-७६", "content_sanskrit": "न कलेरुपतापोऽत्र नासुरैरपि पीडनम् ।\nन साहसं च शुभदं शिवभक्तिमतामपि ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003689076, "chapter_id": 23689, "verse_number": "१-३-१०-७७", "content_sanskrit": "पूर्वजन्मकृतैः पुण्यैर्लब्धवीर्यमहोदयः ।\nमा त्वं शोणाचलेशाग्नौ शलभत्वं भजासुर ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003689077, "chapter_id": 23689, "verse_number": "१-३-१०-७८", "content_sanskrit": "शिवेन दत्ता विभवास्तव पूर्वतपोबलात् ।\nदह्येरन्यत्र तरसा दाववह्नौ यथा द्रुमाः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003689078, "chapter_id": 23689, "verse_number": "१-३-१०-७९", "content_sanskrit": "अत्र धर्मात्मनां वासः शिवभक्तिमतां सदा ।\nपरपीडाप्रसक्तानां भवेद्रोगशतावृतः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003689079, "chapter_id": 23689, "verse_number": "१-३-१०-८०", "content_sanskrit": "ऐश्वर्य्यमतुलं प्राप्तो बलमन्यद्दुरासदम् ।\nकिमर्थं स्वल्पबुद्धिः सन्स्वदोषैर्नाशमेष्यसि ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003689080, "chapter_id": 23689, "verse_number": "१-३-१०-८१", "content_sanskrit": "मया कन्या पुनर्दृष्टा विशेषादबला मता ।\nअंतर्गतोरुणाद्रीश एतस्मात्सा विशिष्यते ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003689081, "chapter_id": 23689, "verse_number": "१-३-१०-८२", "content_sanskrit": "अथवा युक्तिभेदैस्त्वं शास्त्रैर्वा शिवसंमतैः ।\nअनिग्राह्यमनोवृत्तिरात्मसैन्यं समानय ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003689082, "chapter_id": 23689, "verse_number": "१-३-१०-८३", "content_sanskrit": "येन लोकान्समस्तांस्त्वं बाधसे बलगर्वितः ।\nतत्सैन्यं तव वृद्धं च क्षणाद्धक्ष्यामि तेजसा ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003689083, "chapter_id": 23689, "verse_number": "१-३-१०-८४", "content_sanskrit": "आनीय सकलं सैन्यमग्रे स्थापय सायुधम् ।\nसद्यस्त्वात्मबलैः सृष्टेः संहरिष्यामि तत्क्षणात् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003689084, "chapter_id": 23689, "verse_number": "१-३-१०-८५", "content_sanskrit": "मच्छस्त्र परिकृत्तस्य ससैन्यस्य तवायुषः ।\nमुक्तिरत्रैव भविता को जानाति शिवेहितम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003689085, "chapter_id": 23689, "verse_number": "१-३-१०-८६", "content_sanskrit": "वार्यमाणोऽपि पूर्वेण कर्मणा प्रेरितो जनः ।\nअवशः कर्म कुरुते भुंक्ते च सदृशं फलम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003689086, "chapter_id": 23689, "verse_number": "१-३-१०-८७", "content_sanskrit": "त्वयापि करुणावाक्यं वक्तव्यं किल भूरिभिः ।\nअकार्यविनिवृत्त्यर्थं नित्यधर्मानुपालने ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003689087, "chapter_id": 23689, "verse_number": "१-३-१०-८८", "content_sanskrit": "इति गौर्या समादिष्टा वाचं कपिमुखो मुनिः ।\nदूतः सन्सर्वमाचष्ट महिषस्याग्रतः स्थितः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003689088, "chapter_id": 23689, "verse_number": "१-३-१०-८९", "content_sanskrit": "सोऽपि सर्वं समाकर्ण्य क्रोधवेगसमाकुलः ।\nतं भक्षयितुमारेभे सोपि मायाबलाद्ययौ ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003689089, "chapter_id": 23689, "verse_number": "१-३-१०-९०", "content_sanskrit": "अथ सैन्यं निजं सर्वं समाहूय दुराशयः ।\nसन्नद्धं सायुधं योद्धुमादिशल्लोकभीषणम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003689090, "chapter_id": 23689, "verse_number": "१-३-१०-९१", "content_sanskrit": "युगांतसमयोद्वेलचतुरर्णवसंनिभम् ।\nसैन्यानां सैन्यमतुलं शोणाद्रिं पर्यवेष्टयत् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003689091, "chapter_id": 23689, "verse_number": "१-३-१०-९२", "content_sanskrit": "अथ गौरी समालोक्य दैत्यानां सैन्यमद्भुतम् ।\nससर्ज तैजसाञ्शूरान्घोरान्भूतगणान्बहून् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003689092, "chapter_id": 23689, "verse_number": "१-३-१०-९३", "content_sanskrit": "एकपादाक्षिचरणा लंबकर्णपयोधराः ।\nपाणिपादशिरःकुक्षिवक्त्राः केचिद्विनिर्गताः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003689093, "chapter_id": 23689, "verse_number": "१-३-१०-९४", "content_sanskrit": "अहं ग्रसामि सकलमपर्याप्तमिदं मम ।\nअहमेव हनिष्यामि दैत्यसैन्यमशेषतः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003689094, "chapter_id": 23689, "verse_number": "१-३-१०-९५", "content_sanskrit": "किं त्वयात्र पुनः कार्यं वीक्ष्य त्वं तिष्ठ केवलम् ।\nअहमेवात्र योत्स्यामीत्यभाषंत परस्परम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003689095, "chapter_id": 23689, "verse_number": "१-३-१०-९६", "content_sanskrit": "तेषां कथयतां शंखं गणानां योगिनीगणैः ।\nअधमत्सा भगवती हंतुं तद्दैत्यमंडलम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003689096, "chapter_id": 23689, "verse_number": "१-३-१०-९७", "content_sanskrit": "आलोक्य तां तथारूपामापतंस्तस्य सैनिकाः ।\nदर्शयंतः स्ववीर्याणि स्वामिनोग्रे धृतायुधाः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003689097, "chapter_id": 23689, "verse_number": "१-३-१०-९८", "content_sanskrit": "ववृषुः शस्त्रवर्षाणि दैत्याः प्रतिदिगन्तरम् ।\nबाणैः कार्मुकनिर्मुक्तैस्तानि सा तु न्यवारयत् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003689098, "chapter_id": 23689, "verse_number": "१-३-१०-९९", "content_sanskrit": "रथानां वारणेंद्राणां हयानां लक्षकोटिभिः ।\nयुयुधुर्भूतवेताला देव्या सृष्टास्तु दुर्जयाः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003689099, "chapter_id": 23689, "verse_number": "१-३-१०-१००", "content_sanskrit": "मातरो विविधाकारा डाकिन्यो योगिनीगणाः ।\nसृष्टाश्च तेजसा भूयः पिशाचाः प्रेतराक्षसाः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003689100, "chapter_id": 23689, "verse_number": "१-३-१०-१०१", "content_sanskrit": "देव्या सृष्टेन सैन्येन दुर्जयेन महासुराः ।\nभक्षिताश्चूर्णिता भिन्ना दारिता निहताः क्षणात् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003689101, "chapter_id": 23689, "verse_number": "१-३-१०-१०२", "content_sanskrit": "देवी च सायुधा दृष्टा ज्वलंती निहतासुरैः ।\nनृत्यद्भूतगणैर्भुक्तै रक्तैर्मांसैश्च तोषितैः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003689102, "chapter_id": 23689, "verse_number": "१-३-१०-१०३", "content_sanskrit": "यदा कैलासशिखरात्प्राप्ता कर्त्तुं तपो भुवम् ।\nतदा समागताः काश्चिन्मातृका देहगुप्तये ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003689103, "chapter_id": 23689, "verse_number": "१-३-१०-१०४", "content_sanskrit": "दुंदुभिः सत्यवत्याख्या तथा चान्तवती परा ।\nसुंदरीति चतस्रस्ता अन्वयुः परिचारिकाः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003689104, "chapter_id": 23689, "verse_number": "१-३-१०-१०५", "content_sanskrit": "देव्या सृष्टा च चामुंडा दंष्ट्रावलयभीपणा ।\nदैत्यकृत्तिवसा मांसरक्ततृप्ता चचार सा ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003689105, "chapter_id": 23689, "verse_number": "१-३-१०-१०६", "content_sanskrit": "असुरं कंचिदाक्रम्य नटनं सा चकार ह ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003689106, "chapter_id": 23689, "verse_number": "१-३-१०-१०७", "content_sanskrit": "अथ तां समवेक्ष्य दुर्मदो हि ज्वलयामास च कोपवह्निना सः ।\nअतितीव्रविवृत्तभीष्मनेत्रश्रुतिशृंगाग्रविभिन्नमेघजालः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003689107, "chapter_id": 23689, "verse_number": "१-३-१०-१०८", "content_sanskrit": "ज्वलदग्निशिखाभदीर्घजिह्वापरिलीढोन्नतशैलशृंगभागः ।\nअवनिं दलयन्खुराभिघातैरसकृत्पांसुभिरास्वनन्दिगंतान् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003689108, "chapter_id": 23689, "verse_number": "१-३-१०-१०९", "content_sanskrit": "अतिघर्घर दीर्घघोरनादस्फुटदंडभ्रममोहितामरो यः ।\nधृतवालधिदंडताड्यमानप्रतिशीर्णामितशस्त्रवर्षसंघः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003689109, "chapter_id": 23689, "verse_number": "१-३-१०-११०", "content_sanskrit": "मृतये व्यगमद्बलित्रयाढ्यां मृगराजस्थितिभासुरां भवानीम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}]