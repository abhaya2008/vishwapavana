[{"id": 2209179, "chapter_id": 5468, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209180, "chapter_id": 5468, "verse_number": "१", "content_sanskrit": "एतच्छ्रुत्वा तु पुत्रस्य वचः शूरात्मजस्तदा ।\nविहाय शोकं धर्मात्मा ददौ श्राद्धमनुत्तमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209181, "chapter_id": 5468, "verse_number": "२", "content_sanskrit": "तथैव वासुदेवोऽपि स्वस्रीयस्य महात्मनः ।\nदयितस्य पितुर्नित्यमकरोदौर्ध्वदैहिकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209182, "chapter_id": 5468, "verse_number": "३", "content_sanskrit": "षष्टिं शतसहस्राणि ब्राह्मणानां महाभुज ।\nविधिवद् भोजयामास भोज्यं सर्वगुणान्वितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209183, "chapter_id": 5468, "verse_number": "४", "content_sanskrit": "आच्छाद्य च महाबाहुर्धनतृष्णामपानुदत् ।\nब्राह्मणानां तदा कृष्णस्तदभूद् रोमहर्षणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209184, "chapter_id": 5468, "verse_number": "५", "content_sanskrit": "सुवर्णं चैव गाश्चैव शयनाच्चादनं तथा ।\nदीयमानं तदा विप्राः प्रभूतमिति चाब्रुवन् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209185, "chapter_id": 5468, "verse_number": "६", "content_sanskrit": "वासुदेवोऽथ दाशार्हो बलदेवः ससात्यकिः ।\nअभिमन्योस्तदा श्राद्धमकुर्वन् सत्यविक्रमाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209186, "chapter_id": 5468, "verse_number": "७", "content_sanskrit": "ततः शोकं कुरुश्रेष्ठ जहि त्वमरिमर्दन ।\nअतीव दुःखसन्तप्ता न शमं चोपलेभिरे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209187, "chapter_id": 5468, "verse_number": "८", "content_sanskrit": "तथैव पाण्डवा धीरा नगरे नागसाह्वये ।\nनोपागच्छंस्तथा शान्तिमभिमन्युविनाकृताः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209188, "chapter_id": 5468, "verse_number": "९", "content_sanskrit": "सुबहूनि च राजेन्द्र दिवसानि विराटजा ।\nनाभुङ्क्त पतिशोकार्ता तदभूत् करुणं महत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209189, "chapter_id": 5468, "verse_number": "१०", "content_sanskrit": "ध्रियमाणे तु तस्मिंस्तु गर्भे कुक्षिस्थ एव च ।\nआजगाम तदा व्यासो ज्ञात्वा दिव्येन चक्षुषा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209190, "chapter_id": 5468, "verse_number": "११", "content_sanskrit": "आगम्य चाब्रवीद् धीमान् पृथां पृथुललोचनाम् ।\nउत्तरां च महातेजाः शोकः सन्त्यज्यतामिति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209191, "chapter_id": 5468, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209192, "chapter_id": 5468, "verse_number": "१२", "content_sanskrit": "जनिष्यति महातेजाः पुत्रस्तव यशस्विनि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209193, "chapter_id": 5468, "verse_number": "१३", "content_sanskrit": "प्रभावाद् वासुदेवस्य मम व्याहरणादपि ।\nपाण्डवानामयं चान्ते पालयिष्यति मेदिनीम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209194, "chapter_id": 5468, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209195, "chapter_id": 5468, "verse_number": "१४", "content_sanskrit": "धनञ्जयं च सम्प्रेक्ष्य धर्मराजस्य पश्यतः ।\nव्यासो वाक्यमुवाचेदं हर्षयन्निव भारत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209196, "chapter_id": 5468, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209197, "chapter_id": 5468, "verse_number": "१५", "content_sanskrit": "पौत्रो ध्रुवं महाभागो भविष्यति महामतिः ।\nपृथ्वीं सागरपर्यन्तां पालयिष्यति चैव ह ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209198, "chapter_id": 5468, "verse_number": "१६", "content_sanskrit": "तस्माच्छोकं कुरुश्रेष्ठ जहि त्वमरिमर्दन ।\nविचार्यमत्र न हि ते सत्यमेतद् भविष्यति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209199, "chapter_id": 5468, "verse_number": "१७", "content_sanskrit": "यच्चापि वृष्णिवीरेण कृष्णेन कुरुनन्दन ।\nपुरा चोक्तं तथा भावि मा ते भूदत्र संशयः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209200, "chapter_id": 5468, "verse_number": "१८", "content_sanskrit": "विबुधानां गतो लोकान् अक्षयानात्मनिर्जितान् ।\nन स शोच्यस्तथा वत्स न चान्यैः कुरुभिस्तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209201, "chapter_id": 5468, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209202, "chapter_id": 5468, "verse_number": "१९", "content_sanskrit": "एवं पितामहेनोक्तो धर्मात्मा स धनञ्जयः ।\nत्यक्त्वा शोकं महाराज हष्टरूपोऽभवद् तदा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209203, "chapter_id": 5468, "verse_number": "२०", "content_sanskrit": "पिताऽपि तव धर्मज्ञ गर्भे तस्मिन् महामते ।\nअवर्धत यथाकालं शुक्लपक्षे यथा शशी ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209204, "chapter_id": 5468, "verse_number": "२१", "content_sanskrit": "ततः सञ्चोदयामास व्यासो धर्मात्मजं नृपम् ।\nअश्वमेधं प्रति तदा ततः सोऽन्तर्हितोऽभवत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209205, "chapter_id": 5468, "verse_number": "२२", "content_sanskrit": "धर्मराजश्च मेधावी श्रुत्वा व्यासस्य तद् वचः ।\nवित्तोपनयने तात चकार महिमान् मतिम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209206, "chapter_id": 5468, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि व्यासवचनं नाम द्विषष्टितमोऽध्यायः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]