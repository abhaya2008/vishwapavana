[{"id": 5000629000, "chapter_id": 9629, "verse_number": "७-९४-१", "content_sanskrit": "तौ रजन्यां प्रभातायां स्नातौ हुतहुताशनौ ।\nयथोक्तमृषिणा पूर्वं सर्वं तत्रोपगायताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000629001, "chapter_id": 9629, "verse_number": "७-९४-२", "content_sanskrit": "तां स शुश्राव काकुत्स्थः पूर्वाचार्यविजिर्मिताम् ।\nअपूर्वां पाठ्यजातिं च गेयेन समलङ्कृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000629002, "chapter_id": 9629, "verse_number": "७-९४-३", "content_sanskrit": "प्रमाणैर्बहुभिर्बद्धां तन्त्रीलयसमन्विताम् ।\nबालाभ्यां राघवः श्रुत्वा कौतूहलपरो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000629003, "chapter_id": 9629, "verse_number": "७-९४-४", "content_sanskrit": "अथ कर्मान्तरे राजा समाहूय महामुनीन् ।\nपार्थिवांश्च नरव्याघ्रः पण्डितान्नैगमांस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000629004, "chapter_id": 9629, "verse_number": "७-९४-५", "content_sanskrit": "पौराणिकाञ्छब्दविदो ये च वृद्धा द्विजातयः ।\nस्वराणां लक्षणज्ञांश्च उत्सुकान्द्विजसत्तमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000629005, "chapter_id": 9629, "verse_number": "७-९४-६", "content_sanskrit": "लक्षणज्ञांश्च गान्धर्वान्नैगमांश्च विशेषतः ।\nपादाक्षरसमासज्ञांश्छन्दःसु परिनिष्ठितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000629006, "chapter_id": 9629, "verse_number": "७-९४-७", "content_sanskrit": "कलामात्राविशेषज्ञाञ्ज्योतिषे च परं गतान् ।\nक्रियाकल्पविदश्चैव तथा कार्यविदो जनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000629007, "chapter_id": 9629, "verse_number": "७-९४-८", "content_sanskrit": "भाषाज्ञानिङ्गितज्ञांश्च नैगमांश्चाप्यशेषतः ।\nहेतूपचारकुशलान् वचने चापि हैतुकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000629008, "chapter_id": 9629, "verse_number": "७-९४-९", "content_sanskrit": "छन्दोविदः पुराणज्ञान्वैदिकान्द्विजसत्तमान् ।\nचित्रज्ञान्वृत्तसूत्रज्ञान्गीतनृत्यविशारदान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000629009, "chapter_id": 9629, "verse_number": "७-९४-१०", "content_sanskrit": "शास्त्रज्ञान्नीतिनिपुणान्वेदान्तार्थप्रबोधकान् ।\nएतान्सर्वान्समानीय गातारौ समवेशयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000629010, "chapter_id": 9629, "verse_number": "७-९४-११", "content_sanskrit": "दृष्ट्वा मुनिगणाः सर्वे पार्थिवाश्च महौजसः ।\nपिबन्त इव चक्षुर्भ्यां राजानं गायकौ च तौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000629011, "chapter_id": 9629, "verse_number": "७-९४-१२", "content_sanskrit": "ऊचुः परस्परं चेदं सर्व एव समन्ततः ।\nउभौ रामस्य सदृशौ बिम्बाद्बिम्बमिवोत्थितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000629012, "chapter_id": 9629, "verse_number": "७-९४-१३", "content_sanskrit": "जटिलौ यदि न स्यातां न वल्कलधरौ यदि ।\nविशेषं नाधिगच्छामो गायतो राघवस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000629013, "chapter_id": 9629, "verse_number": "७-९४-१४", "content_sanskrit": "तेषां संवदतामेवं श्रोतऽणां हर्षवर्धनम् ।\nगेयं प्रचक्रतुस्तत्र तावुभौ मुनिदारकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000629014, "chapter_id": 9629, "verse_number": "७-९४-१५", "content_sanskrit": "ततः प्रवृत्तं मधुरं गान्धर्वमतिमानुषम् ।\nन च तृप्तिं ययुः सर्वे श्रोतारो गानसम्पदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000629015, "chapter_id": 9629, "verse_number": "७-९४-१६", "content_sanskrit": "प्रवृत्तमादितः पूर्वसर्गं नारददर्शितम् ।\nततः प्रभृति सर्गांश्च यावद्विंशत्यगायताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000629016, "chapter_id": 9629, "verse_number": "७-९४-१७", "content_sanskrit": "ततो ऽपराह्णसमये राघवः समभाषत ।\nश्रुत्वा विंशतिसर्गांस्तान्भ्रातरं भ्रातृवत्सलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000629017, "chapter_id": 9629, "verse_number": "७-९४-१८", "content_sanskrit": "अष्टादशसहस्राणि सुवर्णस्य महात्मनोः ।\nप्रयच्छ शीघ्रं काकुत्स्थ यदन्यदभिकाङ्क्षितम् ।\nददौ शीघ्रं स काकुत्स्थो बालयोर्वै पृथक्पृथक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000629018, "chapter_id": 9629, "verse_number": "७-९४-१९", "content_sanskrit": "दीयमानं सुवर्णं तु नागृह्णीतां कुशीलवौ ।\nऊचतुश्च महात्मानौ किमनेनेति विस्मितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000629019, "chapter_id": 9629, "verse_number": "७-९४-२०", "content_sanskrit": "वन्येन फलमूलेन निरतौ वनवासिनौ ।\nसुवर्णेन हिरण्येन किं करिष्यावहे वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000629020, "chapter_id": 9629, "verse_number": "७-९४-२१", "content_sanskrit": "तथा तयोः प्रब्रुवतोः कौतूहलसमन्विताः ।\nश्रोतारश्चैव रामश्च सर्व एव सुविस्मिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000629021, "chapter_id": 9629, "verse_number": "७-९४-२२", "content_sanskrit": "तस्य चैवागमं रामः काव्यस्य श्रोतुमुत्सुकः ।\nपप्रच्छ तौ महातेजास्तावुभौ मुनिदारकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000629022, "chapter_id": 9629, "verse_number": "७-९४-२३", "content_sanskrit": "किम्प्रमाणमिदं काव्यं का प्रतिष्ठा महात्मनः ।\nकर्ता काव्यस्य महतः क्व चासौ मुनिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000629023, "chapter_id": 9629, "verse_number": "७-९४-२४", "content_sanskrit": "पृच्छन्तं राघवं वाक्यमूचतुर्मुनिदारकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000629024, "chapter_id": 9629, "verse_number": "७-९४-२५", "content_sanskrit": "वाल्मीकिर्भगवान्कर्ता सम्प्राप्तो यज्ञसंविधम् ।\nयेनेदं चरितं तुभ्यमशेषं सम्प्रदर्शितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000629025, "chapter_id": 9629, "verse_number": "७-९४-२६", "content_sanskrit": "सन्निबद्धं हि श्लोकानां चतुर्विशत्सहस्रकम् ।\nउपाख्यानशतं चैव भार्गवेण तपस्विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000629026, "chapter_id": 9629, "verse_number": "७-९४-२७", "content_sanskrit": "आदिप्रभृति वै राजन्पञ्चसर्गशतानि च ।\nकाण्डानि षट् कृतानीह सोत्तराणि महात्मना ।\nकृतानि गुरुणास्माकमृषिणा चरितं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000629027, "chapter_id": 9629, "verse_number": "७-९४-२८", "content_sanskrit": "प्रतिष्ठा ऽ ऽजीवितं यावत्तावत्सर्वस्य वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000629028, "chapter_id": 9629, "verse_number": "७-९४-२९", "content_sanskrit": "सोत्तराणि महात्मना ।\nयदि बुद्धिः कृता राजञ्छ्रवणाय महारथ ।\nकर्मान्तरे क्षणीभूतस्तच्छृणुष्व सहानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000629029, "chapter_id": 9629, "verse_number": "७-९४-३०", "content_sanskrit": "बाढमित्यब्रवीद्रामस्तौ चानुज्ञाप्य राघवम् ।\nप्रहृष्टौ जग्मतुः स्थानं यत्रास्ते मुनिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000629030, "chapter_id": 9629, "verse_number": "७-९४-३१", "content_sanskrit": "रामो ऽपि मुनिभिः सार्धं पार्थिवैश्च महात्मभिः ।\nश्रुत्वा तद्गीतिमाधुर्यं कर्मशालामुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000629031, "chapter_id": 9629, "verse_number": "७-९४-३२", "content_sanskrit": "शुश्राव तत्ताललयोपपन्नं सर्गान्वितं स स्वरशब्दयुक्तम् ।\nतन्त्रीलयव्यञ्जनयोगयुक्तं कुशीलवाभ्यां परिगीयमानम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000629032, "chapter_id": 9629, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे चतुर्नवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]