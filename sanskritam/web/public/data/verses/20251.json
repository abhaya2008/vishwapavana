[{"id": 7000251000, "chapter_id": 20251, "verse_number": "१-५-१", "content_sanskrit": "भीष्म उवाच ।\nकथं सती दक्षसुता देहं त्यक्तवती शुभा ।\nदक्षयज्ञस्तु रुद्रेण विध्वस्तः केन हेतुना॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000251001, "chapter_id": 20251, "verse_number": "१-५-२", "content_sanskrit": "एतन्मे कौतुकं ब्रह्मन्कथं देवो महेश्वरः ।\nजगामाथ क्रोधवशं त्रिपुरारिर्महायशाः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000251002, "chapter_id": 20251, "verse_number": "१-५-३", "content_sanskrit": "पुलस्त्य उवाच ।\nगंगाद्वारे पुरा भीष्म दक्षो यज्ञमथारभत् ।\nतत्र देवासुरगणाः पितरोथ महर्षयः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000251003, "chapter_id": 20251, "verse_number": "१-५-४", "content_sanskrit": "समाजग्मुर्मुदायुक्ताः सर्वे देवाः सवासवाः ।\nनागा यक्षाः सुपर्णाश्च वीरुदोषधयस्तथा॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000251004, "chapter_id": 20251, "verse_number": "१-५-५", "content_sanskrit": "कश्यपो भगवानत्रिः पुलस्त्यः पुलहः क्रतुः ।\nप्रचेतसोंगिराश्चैव वसिष्ठश्च महातपाः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000251005, "chapter_id": 20251, "verse_number": "१-५-६", "content_sanskrit": "तत्र वेदीं समां कृत्वा चातुर्होत्रं न्यवेशयत् ।\nहोता वसिष्ठस्तत्रासीदंगिराध्वर्युसत्तमः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000251006, "chapter_id": 20251, "verse_number": "१-५-७", "content_sanskrit": "बृहस्पतिरथोद्गाता ब्रह्मा वै नारदस्तथा ।\nयज्ञकर्मप्रवृत्तौ तु हूयमानेषु चाग्निषु॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000251007, "chapter_id": 20251, "verse_number": "१-५-८", "content_sanskrit": "आगता वसवः सर्व आदित्या द्वादशैव तु ।\nअश्विनौ मरुतश्चैव मनवश्च चतुर्दश॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000251008, "chapter_id": 20251, "verse_number": "१-५-९", "content_sanskrit": "एवं यज्ञे प्रवृत्ते तु हूयमानेषु चाग्निषु ।\nविभूतिं तां परां तत्र भक्ष्यभोज्यकृतां शुभाम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000251009, "chapter_id": 20251, "verse_number": "१-५-१०", "content_sanskrit": "आलोक्य सर्वतो भूमिं समंताद्दशयोजनम् ।\nमहावेदी कृता तत्र सर्वैस्तत्र समन्वितैः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000251010, "chapter_id": 20251, "verse_number": "१-५-११", "content_sanskrit": "सर्वान्देवान्शक्रमुख्यान्यज्ञे दृष्ट्वा सती शुभा ।\nतदासानुनयं वाक्यं प्रजापतिमभाषत॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000251011, "chapter_id": 20251, "verse_number": "१-५-१२", "content_sanskrit": "सत्युवाच ।\nऐरावतं समारूढो देवराजः शतक्रतुः ।\nपत्न्या शच्या सहायातः कृतावासः शतक्रतुः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000251012, "chapter_id": 20251, "verse_number": "१-५-१३", "content_sanskrit": "पापानां यो यमयिता धर्मेणाधर्मिणां प्रभुः ।\nपत्न्या धूमोर्णया सार्द्धमिहायातः स दृश्यते॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000251013, "chapter_id": 20251, "verse_number": "१-५-१४", "content_sanskrit": "यादसां च पतिर्द्देवो वरुणो लोकभावनः ।\nगौर्य्या पत्न्या सहायातः प्रचेता मंडपे त्विह॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000251014, "chapter_id": 20251, "verse_number": "१-५-१५", "content_sanskrit": "सर्वयक्षाधिपो देवः पुत्रो विश्रवसो मुनेः ।\nपत्न्या त्विह समायातः सह देव्या धनाधिपः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000251015, "chapter_id": 20251, "verse_number": "१-५-१६", "content_sanskrit": "मुखं यः सर्वदेवानां जंतूनामुदरे स्थितः ।\nवेदा यदर्थमुत्पन्नास्सोयं यज्ञमुपागतः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000251016, "chapter_id": 20251, "verse_number": "१-५-१७", "content_sanskrit": "निऋती राक्षसेन्द्रोऽसौ दिक्पतित्वे नियोजितः ।\nस च त्विहागतस्तात पत्न्या सार्द्धं क्रताविह॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000251017, "chapter_id": 20251, "verse_number": "१-५-१८", "content_sanskrit": "आयुःप्रदो जगत्यस्मिन्ब्रह्मणा निर्मितः पुरा ।\nप्राणोपानोव्यानौदानस्समानाह्वयस्तथा॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000251018, "chapter_id": 20251, "verse_number": "१-५-१९", "content_sanskrit": "एकोनपंचाशत्केन गणेन परिवारितः ।\nयज्ञे प्रजापतिश्चासौ वायुर्देवःसमागतः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000251019, "chapter_id": 20251, "verse_number": "१-५-२०", "content_sanskrit": "द्वादशात्मा ग्रहाध्यक्षःचक्षुषी जगतस्त्विह ।\nपाति वै भुवनं सर्वं देवानां यः परायणः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000251020, "chapter_id": 20251, "verse_number": "१-५-२१", "content_sanskrit": "आयुषश्च वनानां च दिवसानां पतिर्हि यः ।\nसंज्ञा पतिरिहायातो भास्करो लोकपावनः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000251021, "chapter_id": 20251, "verse_number": "१-५-२२", "content_sanskrit": "अत्रिवंशसमुद्भूतो द्विजराजो महायशाः ।\nनयनानंदजननो लोकनाथो धरातले॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000251022, "chapter_id": 20251, "verse_number": "१-५-२३", "content_sanskrit": "ओषधीनां पतिश्चापि वीरुधामपि सर्वशः ।\nउडुनाथः सपत्नीक इहायातः शशी तव॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000251023, "chapter_id": 20251, "verse_number": "१-५-२४", "content_sanskrit": "वसवोष्टौ समायाता अश्विनौ च समागतौ ।\nवृक्षो वनस्पतिश्चापि गन्धर्वाप्सरसां गणाः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000251024, "chapter_id": 20251, "verse_number": "१-५-२५", "content_sanskrit": "विद्याधरा भूतसंघा वेताला यक्षराक्षसाः ।\nपिशाचाश्चोग्रकर्माणस्तथान्ये जीवहारकाः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000251025, "chapter_id": 20251, "verse_number": "१-५-२६", "content_sanskrit": "नद्यो नदाः समुद्राश्च द्वीपाश्च सह पर्वतैः ।\nग्राम्यारण्याश्च पशवो यदिङ्गं यच्च नेङ्गति॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000251026, "chapter_id": 20251, "verse_number": "१-५-२७", "content_sanskrit": "कश्यपो भगवानत्रिर्वसिष्ठश्चापरैः सह ।\nपुलस्त्यः पुलहश्चैव सनकाद्या महर्षयः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000251027, "chapter_id": 20251, "verse_number": "१-५-२८", "content_sanskrit": "पुण्या राजर्षयश्चैव पृथिव्यां ये च पार्थिवाः ।\nवर्णाश्चाश्रमिणश्चैव सर्वे ये कर्मकारिणः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000251028, "chapter_id": 20251, "verse_number": "१-५-२९", "content_sanskrit": "किमत्र बहुनोक्तेन ब्राह्मी सृष्टिरिहागता ।\nभगिन्यो भागिनेयाश्च भगिनीपतयस्त्विमे॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000251029, "chapter_id": 20251, "verse_number": "१-५-३०", "content_sanskrit": "स्वभार्यासहिताः सर्वे सपुत्रास्सह बांधवाः ।\nत्वया समर्चिताः सर्वे दानमानपरिग्रहैः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000251030, "chapter_id": 20251, "verse_number": "१-५-३१", "content_sanskrit": "आमंत्रणा मंत्रितानां सर्वेषां मानना कृता ।\nएक एवात्र भगवान्पतिर्मे न समागतः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000251031, "chapter_id": 20251, "verse_number": "१-५-३२", "content_sanskrit": "विना तेन त्विदं सर्वं शून्यवत्प्रतिभाति मे ।\nमन्ये चाहं तु भवता पतिर्मे न निमंत्रितः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000251032, "chapter_id": 20251, "verse_number": "१-५-३३", "content_sanskrit": "विस्मृतस्ते भवेन्नूनं सर्वं शंसतु मे भवान् ।\nपुलस्य उवाच ।\nतस्यास्तदुक्तं वचनं श्रुत्वा दक्षः प्रजापतिः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000251033, "chapter_id": 20251, "verse_number": "१-५-३४", "content_sanskrit": "पतिस्नेह समायुक्तां प्राणेभ्योपि गरीयसीम् ।\nअंकमारोप्य तां बालां साध्वीं पतिपरायणाम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000251034, "chapter_id": 20251, "verse_number": "१-५-३५", "content_sanskrit": "पतिव्रतां महाभागां पतिप्रियहितैषिणीम् ।\nप्राह गंभीरभावेन शृणु वत्से यथातथम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000251035, "chapter_id": 20251, "verse_number": "१-५-३६", "content_sanskrit": "येनाद्य कारणेनेह पतिस्ते न निमंत्रितः ।\nकपालपात्रधृक्चर्मी भस्मावृत तनुस्तथा॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000251036, "chapter_id": 20251, "verse_number": "१-५-३७", "content_sanskrit": "शूली मुण्डी च नग्नश्च श्मशाने रमते सदा ।\nविभूत्याङ्गानि सर्वाणि परिमार्ष्टि च नित्यशः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000251037, "chapter_id": 20251, "verse_number": "१-५-३८", "content_sanskrit": "व्याघ्रचर्मपरीधानो हस्तिचर्मपरिच्छदः ।\nकपालमालं शिरसि खट्वागं च करे स्थितं॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000251038, "chapter_id": 20251, "verse_number": "१-५-३९", "content_sanskrit": "कट्यां वै गोनसं बध्वा लिंगेऽस्थ्नां वलयं तथा ।\nपन्नगानां तु राजानमुपवीतं च वासुकिम्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000251039, "chapter_id": 20251, "verse_number": "१-५-४०", "content_sanskrit": "कृत्वा भ्रमति चानेन रूपेण सततं क्षितौ ।\nनग्ना गणाः पिशाचाश्च भूतसंघा ह्यनेकशः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000251040, "chapter_id": 20251, "verse_number": "१-५-४१", "content_sanskrit": "त्रिनेत्रश्च त्रिशूली च गीतनृत्यरतस्सदा ।\nकुत्सितानि तथान्यानि सदा ते कुरुते पतिः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000251041, "chapter_id": 20251, "verse_number": "१-५-४२", "content_sanskrit": "त्रपाकरो भवेन्मह्यं देवानां संनिधिः कथं ।\nकीदृक्च वसनं तस्य केतनं प्रति नार्हति॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000251042, "chapter_id": 20251, "verse_number": "१-५-४३", "content_sanskrit": "एतैर्दोषैर्मया वत्से लोकानां चैव लज्जया ।\nनाह्वानं तु कृतं तस्य कारणेन मया सुते॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000251043, "chapter_id": 20251, "verse_number": "१-५-४४", "content_sanskrit": "यज्ञस्यास्य समाप्तौ तु पूजां कृत्वा त्वया सह ।\nआनीय तव भर्त्तारं त्वया सह त्रिलोचनम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000251044, "chapter_id": 20251, "verse_number": "१-५-४५", "content_sanskrit": "त्रैलोक्यस्याधिकां पूजां करिष्यामि च सत्कृतैः ।\nएतत्ते सर्वमाख्यातं त्रपायाः कारणं महत्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000251045, "chapter_id": 20251, "verse_number": "१-५-४६", "content_sanskrit": "नात्र मन्युस्त्वया कार्यः सर्वः स्वं भागमर्हति ।\nअन्यजन्मनि यैर्यादृक्कृतं कर्म शुभाशुभम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000251046, "chapter_id": 20251, "verse_number": "१-५-४७", "content_sanskrit": "इह जन्मनि ते तादृक्पुत्रिके भुंजते फलम् ।\nपरितापं मा कृथास्त्वं फलं भुंक्ष्व पुराकृतम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000251047, "chapter_id": 20251, "verse_number": "१-५-४८", "content_sanskrit": "श्रियं परगतां दृष्ट्वा रूपसौभाग्यशोभनाम् ।\nरूपं च कांतिसौभाग्यं रम्याण्याभरणानि च॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000251048, "chapter_id": 20251, "verse_number": "१-५-४९", "content_sanskrit": "कुलेमहतिवैजन्मवपुश्चातीवसुंदरम् ।\nपूर्वभाग्यैस्तु लभ्यंते नरैरेतानि सुव्रते॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000251049, "chapter_id": 20251, "verse_number": "१-५-५०", "content_sanskrit": "मात्मानं परिनिंदेथामाच भाग्यानि सुव्रते ।\nफलं चैवं विधिकृतं दातुं कस्य तु कः क्षमः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000251050, "chapter_id": 20251, "verse_number": "१-५-५१", "content_sanskrit": "नास्ति वै बलवान्कश्चिन्नमूढो न च पंडितः ।\nपांडित्यं च बलं चैव जायते पूर्वकर्मणः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000251051, "chapter_id": 20251, "verse_number": "१-५-५२", "content_sanskrit": "एते देवा दिवं प्राप्ताः शोभमानाः स्थिताश्चिरम् ।\nपुण्येन तपसा चैव क्षेत्रेषुविविधेषुच॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000251052, "chapter_id": 20251, "verse_number": "१-५-५३", "content_sanskrit": "यदेभिरार्जितं पुण्यं तस्यैते फलभागिनः ।\nएवमुक्ता ततः सा तु सती भीष्मरुषान्विता॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000251053, "chapter_id": 20251, "verse_number": "१-५-५४", "content_sanskrit": "विनिंदमाना पितरं क्रोधेनारुणितेक्षणा ।\nएवमेतद्यथा तात त्वया चोक्तं ममाग्रतः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000251054, "chapter_id": 20251, "verse_number": "१-५-५५", "content_sanskrit": "सर्वो जनः पुण्यभागी पुण्येन लभते श्रियं ।\nपुण्येन लभते जन्म पुण्ये भोगाः प्रतिष्ठिताः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000251055, "chapter_id": 20251, "verse_number": "१-५-५६", "content_sanskrit": "तदयं जगतामीशः सर्वेषामुत्तमोत्तमः ।\nस्थानान्येतानि सर्वेषां दत्तान्येतेन धीमता॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000251056, "chapter_id": 20251, "verse_number": "१-५-५७", "content_sanskrit": "ये गुणास्तस्य देवस्य वक्तुं जिह्वापि वेधसः ।\nन शक्ता ख्यापने तस्य देवस्य परमेष्ठिनः॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000251057, "chapter_id": 20251, "verse_number": "१-५-५८", "content_sanskrit": "भस्मास्थि च कपालानि श्मशाने वसतिस्तथा ।\nगोनसाद्याश्च ये सर्पाः सर्वे ते भूषणीकृताः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000251058, "chapter_id": 20251, "verse_number": "१-५-५९", "content_sanskrit": "भूतप्रेतगणास्तस्य पिशाचा गुह्यकास्तथा ।\nएष धाता विधाता च एष पालयिता दिशः॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000251059, "chapter_id": 20251, "verse_number": "१-५-६०", "content_sanskrit": "प्रसादेन च रुद्रस्य प्राप्तस्वर्गः पुरंदरः ।\nयदि रुद्रेस्ति देवत्वं यदि सर्वगतः शिवः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000251060, "chapter_id": 20251, "verse_number": "१-५-६१", "content_sanskrit": "सत्येन तेन ते यज्ञं विध्वंसयतु शंकरः ।\nयद्यस्ति मे तपः किंचित्कश्चिद्धर्मोथवा कृतः॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000251061, "chapter_id": 20251, "verse_number": "१-५-६२", "content_sanskrit": "फलेन तस्य धर्मस्य यज्ञस्ते नाशमर्हति ।\nप्रियाहं यदि देवस्य यदि मां तारयिष्यति॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000251062, "chapter_id": 20251, "verse_number": "१-५-६३", "content_sanskrit": "तेन सत्येन ते गर्वः समाप्तिमभिगच्छतु ।\nइत्युक्त्वा योगमास्थाय स्वदेहस्थेन तेजसा॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000251063, "chapter_id": 20251, "verse_number": "१-५-६४", "content_sanskrit": "निर्ददाह तदात्मानं सदेवासुरपन्नगैः ।\nकिंकिमेतदिति प्रोक्ते गंधर्वगणगुह्यकैः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000251064, "chapter_id": 20251, "verse_number": "१-५-६५", "content_sanskrit": "गंगाकूले तदा मुक्तो देहो वै क्रुद्धया तया ।\nसौनकं नाम तत्तीर्थं गंगायाः पश्चिमे तटे॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000251065, "chapter_id": 20251, "verse_number": "१-५-६६", "content_sanskrit": "श्रुत्वा रुद्रस्तु तद्वार्त्तां पत्न्यानाश सुदुःखितः ।\nहंतुं यज्ञं धीरभवत्देवानामिह पश्यताम्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000251066, "chapter_id": 20251, "verse_number": "१-५-६७", "content_sanskrit": "गणकोटिः समादिष्टा ग्रहा वैनायकास्तथा ।\nभूतप्रेतपिशाचाश्च दक्षयज्ञ विनाशने॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000251067, "chapter_id": 20251, "verse_number": "१-५-६८", "content_sanskrit": "तैर्गत्वा विबुधास्सर्वे यज्ञे निर्जित्य नाशिताः ।\nहते यज्ञे तदा दक्षो निरुत्साहो निरुद्यमः॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000251068, "chapter_id": 20251, "verse_number": "१-५-६९", "content_sanskrit": "उपगम्याब्रवीत्त्रस्तो देवदेवं पिनाकिनम् ।\nन ज्ञातोसि मया देव देवानां प्रभुरीश्वरः॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000251069, "chapter_id": 20251, "verse_number": "१-५-७०", "content_sanskrit": "त्वमस्य जगतोधीशः सुरास्सर्वे त्वया जिताः ।\nकृपां कुरु महेशान गणान्सर्वान्निवर्त्तय॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000251070, "chapter_id": 20251, "verse_number": "१-५-७१", "content_sanskrit": "गणैर्नानाविधैर्घोरैर्नानाभूषणभूषितैः ।\nनानावदनदंतौष्ठैर्नाना प्रहरणोद्यतैः॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000251071, "chapter_id": 20251, "verse_number": "१-५-७२", "content_sanskrit": "नाना नागेंद्रसंदष्ट जटाभारोपशोभितैः ।\nसुदृढोद्धत दर्पाढ्यैर्घोरैर्घोरनिघातिभिः॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000251072, "chapter_id": 20251, "verse_number": "१-५-७३", "content_sanskrit": "कामरूपैरकांतैश्च सर्वकामसमन्वितैः ।\nअनिवार्यबलैश्चोग्रैर्योगिभिर्योगगामिभिः॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000251073, "chapter_id": 20251, "verse_number": "१-५-७४", "content_sanskrit": "व्यालोलकेसरजटैर्दंष्ट्रोत्कटहसन्मुखैः ।\nकरींद्रकरटाटोप पाटवैः सिंहदेहिभिः॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000251074, "chapter_id": 20251, "verse_number": "१-५-७५", "content_sanskrit": "केचित्परमदाघ्राण घूर्णद्दीपसमप्रभैः ।\nविचित्रचित्रवसनैर्द्धीरधीरवारदिभिः॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000251075, "chapter_id": 20251, "verse_number": "१-५-७६", "content_sanskrit": "मृगव्याघ्रसिंहरुतैस्तरक्ष्वजिनधारिभिः ।\nभुजंगहारवलयकृतयज्ञोपवीतकैः॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000251076, "chapter_id": 20251, "verse_number": "१-५-७७", "content_sanskrit": "शूलासिपट्टिशधरैः परशुप्रासहस्तकैः ।\nवज्रक्रकचकोदंडकालदंडास्त्रपाणिभिः॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000251077, "chapter_id": 20251, "verse_number": "१-५-७८", "content_sanskrit": "गणेश्वरैः सुदुर्द्धर्षैर्वृतः सूर्यो ग्रहैरिव ।\nदेवदेवमहादेव नष्टो यज्ञो दिवं गतः॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000251078, "chapter_id": 20251, "verse_number": "१-५-७९", "content_sanskrit": "मृगरूपधरो भूत्वा भयभीतस्तु शंकर ।\nनमः शङ्खाभदेवाय सगणाय सनंदिने॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000251079, "chapter_id": 20251, "verse_number": "१-५-८०", "content_sanskrit": "वृषासनाय सोमाय क्रतुकालांतकाय च ।\nनमो दिक्चर्मवस्त्राय नमस्ते तीव्रतेजसे॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000251080, "chapter_id": 20251, "verse_number": "१-५-८१", "content_sanskrit": "ब्रह्मणे ब्रह्मदेहाय ब्रह्मण्यायामिताय च ।\nगिरीशाय सुरेशाय ईशानाय नमोनमः॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000251081, "chapter_id": 20251, "verse_number": "१-५-८२", "content_sanskrit": "रुद्राय प्रतिवज्राय शिवाय क्रथनाय च ।\nसुरासुराधिपतये यतीनां पतये नमः॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000251082, "chapter_id": 20251, "verse_number": "१-५-८३", "content_sanskrit": "धूम्रोग्राय विरूपाय यज्वने घोररूपिणे ।\nविरूपाक्षाशुभाक्षाय सहस्राक्षाय वै नमः॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000251083, "chapter_id": 20251, "verse_number": "१-५-८४", "content_sanskrit": "मुंडाय चंडमुण्डाय वरखट्वाङ्गधारिणे ।\nकव्यरूपाय हव्याय सर्वसंहारिणे नमः॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000251084, "chapter_id": 20251, "verse_number": "१-५-८५", "content_sanskrit": "भक्तानुकंपिनेत्यर्थं रुद्रजाप्यस्तुताय च ।\nविरूपाय सुरूपाय रूपाणां शतकारिणे॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000251085, "chapter_id": 20251, "verse_number": "१-५-८६", "content_sanskrit": "पंचास्याय शुभास्याय चंद्रास्याय नमो नमः ।\nवरदाय वरार्हाय कूर्माय च मृगाय च॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000251086, "chapter_id": 20251, "verse_number": "१-५-८७", "content_sanskrit": "लीलालकशिखंडाय कमंडलुधराय च ।\nविश्वनाम्नेथ विश्वाय विश्वेशाय नमोनमः॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000251087, "chapter_id": 20251, "verse_number": "१-५-८८", "content_sanskrit": "त्रिनेत्रत्राणमस्माकं त्रिपुरघ्नविधीयतां ।\nवाङ्मनः कायभावैस्तु प्रपन्नस्य महेश्वर॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000251088, "chapter_id": 20251, "verse_number": "१-५-८९", "content_sanskrit": "एवं स्तुतस्तदा देवो दक्षेणापन्नदेहिना ।\nदिव्येनानेन स्तोत्रेण भृशमाराधितस्तदा॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000251089, "chapter_id": 20251, "verse_number": "१-५-९०", "content_sanskrit": "समग्रं ते यज्ञफलं मया दत्तं प्रजापते ।\nसर्वकामप्रसिर्द्ध्य्थंफलंप्राप्स्यस्यनुत्तमम्॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000251090, "chapter_id": 20251, "verse_number": "१-५-९१", "content_sanskrit": "एवमुक्तो भगवता प्रणम्याथ सुरेश्वरम् ।\nजगाम स्वनिकेतं तु गणानामेव पश्यताम्॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000251091, "chapter_id": 20251, "verse_number": "१-५-९२", "content_sanskrit": "पत्न्याः शोकेन वै देवो गंगाद्वारे तदास्थितः ।\nतां सतीं चिंतयानस्तु क्व नु सामेप्रियागता॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000251092, "chapter_id": 20251, "verse_number": "१-५-९३", "content_sanskrit": "तस्य शोकाभिभूतस्य नारदो भवसंन्निधौ ।\nसा ते सती या देवेश भार्या प्राणसमामृता॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000251093, "chapter_id": 20251, "verse_number": "१-५-९४", "content_sanskrit": "हिमवद्दुहिता सा च मेनागर्भसमुद्भवा ।\nजग्राह देहमन्यं सा वेदवेदार्थवेदिनी॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000251094, "chapter_id": 20251, "verse_number": "१-५-९५", "content_sanskrit": "श्रुत्वा देवस्तदा ध्यानमवतीर्णामपश्यत ।\nकृतकृत्यमथात्मानं कृत्वा देवस्तदास्थितः॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000251095, "chapter_id": 20251, "verse_number": "१-५-९६", "content_sanskrit": "संप्राप्तयौवना देवी पुनरेव विवाहिता ।\nएवं हि कथितं भीष्म यथा यज्ञो हतः पुरा॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}]