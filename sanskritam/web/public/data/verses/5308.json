[{"id": 2202236, "chapter_id": 5308, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2202237, "chapter_id": 5308, "verse_number": "१", "content_sanskrit": "सर्वेषामेव वर्णानां म्लेच्छानां च पितामह ।\nउपवासे मतिरियं कारणं च न विद्महे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2202238, "chapter_id": 5308, "verse_number": "२", "content_sanskrit": "ब्रह्मक्षत्रेण नियमाश्चर्तव्या इति नः श्रुतम् ।\nउपवासे कथं तेषां कृत्यमस्ति पितामह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2202239, "chapter_id": 5308, "verse_number": "३", "content_sanskrit": "नियमाश्चोपवासांश्च सर्वेषां ब्रूहि पार्थिव ।\nअवाप्नोति गतिं कां च उपवासपरायणः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2202240, "chapter_id": 5308, "verse_number": "४", "content_sanskrit": "उपवासः परं पुण्यमुपवासः परायणम् ।\nउपोष्येह नरश्रेष्ठ किं फलं प्रतिपद्यते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2202241, "chapter_id": 5308, "verse_number": "५", "content_sanskrit": "अधर्मान्मुच्यते केन धर्ममाप्नोति वै कथम् ।\nस्वर्ग्यं पुण्यं च लभते कथं भरतसत्तम\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2202242, "chapter_id": 5308, "verse_number": "६", "content_sanskrit": "उपोष्य चापि किं तेन प्रदेयं स्यान्नराधिप ।\nधर्मेण च सुखानर्थान् लभेद् येन ब्रवीहि तम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2202243, "chapter_id": 5308, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2202244, "chapter_id": 5308, "verse_number": "७", "content_sanskrit": "एवं ब्रुवाणं कौन्तेयं धर्मज्ञं धर्मतत्त्ववित् ।\nधर्मपुत्रमिदं वाक्यं भीष्मः शान्तनवोऽब्रवीत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2202245, "chapter_id": 5308, "verse_number": "८", "content_sanskrit": "इदं खलु महाराज श्रुतमासीत् पुरातनम् ।\nउपवासविधौ श्रेष्ठा ये गुणा भरतर्षभ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2202246, "chapter_id": 5308, "verse_number": "९", "content_sanskrit": "प्राजापत्यं ह्यङ्गिरसं पृष्टवानस्मि भारत ।\nयथा मां त्वं तथैवाहं पृष्टवांस्तं तपोधनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2202247, "chapter_id": 5308, "verse_number": "१०", "content_sanskrit": "प्रश्नमेतं मया पृष्टो भगवानग्निसम्भवः ।\nउपवासविधिं पुण्यमाचष्ट भरतर्षभ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2202248, "chapter_id": 5308, "verse_number": "", "content_sanskrit": "अङ्गिराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2202249, "chapter_id": 5308, "verse_number": "११", "content_sanskrit": "ब्रह्मक्षत्रे त्रिरात्रं तु विहितं कुरुनन्दन ।\nद्विस्त्रिरात्रमथैकाहं निर्दिष्टं पुरुषर्षभ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2202250, "chapter_id": 5308, "verse_number": "१२", "content_sanskrit": "वैश्यशूद्रौ तु यौ मोहादुपवासं प्रकुर्वते ।\nत्रिरात्रं द्विस्त्रिरात्रं वा तयोः पुष्टिर्न विद्यते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2202251, "chapter_id": 5308, "verse_number": "१३", "content_sanskrit": "चतुर्थभक्ताक्रमणं वैश्यशूद्रे विधीयते ।\nत्रिरात्रं न तु धर्मज्ञैर्विहितं ब्रह्मवादिभिः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2202252, "chapter_id": 5308, "verse_number": "१४", "content_sanskrit": "पञ्चम्यां चैव षष्ठ्यां च पौर्णमास्यां च भारत ।\nक्षमावान् रूपसम्पन्नः श्रुतवांश्चैव जायते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2202253, "chapter_id": 5308, "verse_number": "१५", "content_sanskrit": "नानपत्यो भवेत् प्राज्ञो दरिद्रो वा कदाचन ।\nयजिष्णुः पञ्चमीं षष्ठीं कुलेभ्यो भोजयेद् द्विजान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2202254, "chapter_id": 5308, "verse_number": "१६", "content_sanskrit": "अष्टमीमथ कौन्तेय शुक्लपक्षे चतुर्दशीम् ।\nउपोष्य व्याधिरहितो वीर्यवानभिजायते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2202255, "chapter_id": 5308, "verse_number": "१७", "content_sanskrit": "मार्गशीर्षं तु यो मासमेकभुक्तेन सङ्क्षिपेत् ।\nभोजयेच्च द्विजान् भक्त्या स मुच्यते व्याधिकिल्बिषैः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2202256, "chapter_id": 5308, "verse_number": "१८", "content_sanskrit": "सर्वकल्याणसम्पूर्णः सर्वौषधिसमन्वितः ।\nकृषिभागी बहुधनो बहुपुत्रश्च जायते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2202257, "chapter_id": 5308, "verse_number": "१९", "content_sanskrit": "पौषमासं तु कौन्तेय भक्तेनैकेन यः क्षपेत् ।\nसुभगो दर्शनीयश्च कुले महति जायते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2202258, "chapter_id": 5308, "verse_number": "२०", "content_sanskrit": "पितृभक्तो माघमासमेकभक्तेन यः क्षपेत् ।\nश्रीमत्कुले ज्ञातिमध्ये स महत्त्वं प्रपद्यते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2202259, "chapter_id": 5308, "verse_number": "२१", "content_sanskrit": "भगदैवं तु यो मासमेकभक्तेन यः क्षपेत् ।\nस्त्रीषु वल्लभतां याति वश्याश्चास्य भवन्ति ताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2202260, "chapter_id": 5308, "verse_number": "२२", "content_sanskrit": "चैत्रं तु नियतो मासमेकभक्तेन यः क्षपेत् ।\nसुवर्णमणिमुक्ताढ्ये कुले महति जायते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2202261, "chapter_id": 5308, "verse_number": "२३", "content_sanskrit": "निस्तरेदेकभक्तेन वैशाखं यो जितेन्द्रियः ।\nनरो वा यदि वा नारी ज्ञातीनां श्रेष्ठतां व्रजेत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2202262, "chapter_id": 5308, "verse_number": "२४", "content_sanskrit": "ज्येष्ठामूलं तु यो मासमेकभक्तेन सङ्क्षपेत् ।\nऐश्वर्यमतुलं श्रेष्ठं पुमान् स्त्री वाऽभिपद्यते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2202263, "chapter_id": 5308, "verse_number": "२५", "content_sanskrit": "आषाढमेकभक्तेन स्थित्वा मासमतन्द्रितः ।\nबहुधान्यो बहुधनो बहुपुत्रश्च जायते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2202264, "chapter_id": 5308, "verse_number": "२६", "content_sanskrit": "श्रावणं मासमेकेन भक्तेन यः क्षपेत् ।\nयत्र तत्राभिषेकेण युज्यते ज्ञातिवर्धनः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2202265, "chapter_id": 5308, "verse_number": "२७", "content_sanskrit": "प्रौष्ठपदं तु यो मासमेकाहारो भवेन्नरः ।\nधनाढ्यं स्फीतमचलमैश्वर्यं प्रतिपद्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2202266, "chapter_id": 5308, "verse_number": "२८", "content_sanskrit": "तथैवाश्वयुजं मासमेकभक्तेन यः क्षपेत् ।\nप्रजावान् वाहनाढ्यश्च बहुपुत्रश्च जायते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2202267, "chapter_id": 5308, "verse_number": "२९", "content_sanskrit": "कार्त्तिकं तु नरो मासं यः कुर्यादेकभोजनम् ।\nशूरश्च बहुभार्यश्च कीर्तिमांश्चैव जायते\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2202268, "chapter_id": 5308, "verse_number": "समाप्तिः", "content_sanskrit": "इति मासा नरव्याघ्र क्षपतां परिकीर्तिताः ।\nविधीनां नियमांश्चैव शृणु तानपि पार्थिव\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2202269, "chapter_id": 5308, "verse_number": "३१", "content_sanskrit": "पक्षे पक्षे गते यस्तु भक्तमश्नाति भारत ।\nगवाढ्यो बहुपुत्रश्च दीर्घायुश्च स जायते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2202270, "chapter_id": 5308, "verse_number": "३२", "content_sanskrit": "मासि मासि त्रिरात्राणि कृत्वा वर्षाणि द्वादश ।\nगणाधिपत्यं प्राप्नोति निःसपत्नमनाविलम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2202271, "chapter_id": 5308, "verse_number": "३३", "content_sanskrit": "एते तु नियमाः सर्वे कर्तव्याः शरदो दश ।\nद्वे चान्ये भरतश्रेष्ठ स्ववृत्तिमनुतिष्ठता\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2202272, "chapter_id": 5308, "verse_number": "३४", "content_sanskrit": "यस्तु प्रातस्तथा सायं भुञ्जानो नान्तरा पिबेत् ।\nअहिंसानिरतो नित्यं जुह्वानो जातवेदसम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2202273, "chapter_id": 5308, "verse_number": "३५", "content_sanskrit": "षड्भिः स वर्षैर्नृपते सिध्यते नात्र संशयः ।\nअग्निष्टोमस्य यज्ञस्य फलं प्राप्नोति मानवः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2202274, "chapter_id": 5308, "verse_number": "३६", "content_sanskrit": "अधिवासे सोऽप्सरसां नृत्यगीतविनादिते ।\nतप्तकाञ्चनवर्णाभं विमानमधिरोहति\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2202275, "chapter_id": 5308, "verse_number": "३७", "content_sanskrit": "पूर्णं वर्षसहस्रं तु ब्रह्मलोके महीयते ।\nतत्क्षयादिह चागम्य माहात्म्यं प्रतिपद्यते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2202276, "chapter_id": 5308, "verse_number": "३८", "content_sanskrit": "यस्तु संवत्सरं पूर्णमेकाहारो भवेन्नरः ।\nअतिरात्रस्य यज्ञस्य स फलं समुपाश्नुते\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2202277, "chapter_id": 5308, "verse_number": "३९", "content_sanskrit": "दशवर्षसहस्राणि स्वर्गे च स महीयते ।\nतत्क्षयादिह चागम्य माहात्म्यं प्रतिपद्यते\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2202278, "chapter_id": 5308, "verse_number": "४०", "content_sanskrit": "यस्तु संवत्सरं पूर्णं चतुर्थं भक्तमश्नुते ।\nअहिंसानिरतो नित्यं सत्यवाङ् नियतेन्द्रियः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2202279, "chapter_id": 5308, "verse_number": "४१", "content_sanskrit": "वाजपेयस्य यज्ञस्य फलं वै समुपाश्नुते ।\nत्रिंशद्वर्षसहस्राणि स्वर्गे च स महीयते\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2202280, "chapter_id": 5308, "verse_number": "४२", "content_sanskrit": "षष्ठे काले तु कौन्तेय नरः संवत्सरं क्षपेत् ।\nअश्वमेधस्य यज्ञस्य फलं सम्प्राप्नुयान्नरः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2202281, "chapter_id": 5308, "verse_number": "४३", "content_sanskrit": "चक्रवाकप्रयुक्तेन विमानेन स गच्छति ।\nचत्वारिंशत्सहस्राणि वर्षाणां दिवि मोदते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2202282, "chapter_id": 5308, "verse_number": "४४", "content_sanskrit": "अष्टमेन तु भक्तेन जीवन् संवत्सरं नृप ।\nगवामयस्य यज्ञस्य फलं प्राप्नोति मानवः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2202283, "chapter_id": 5308, "verse_number": "४५", "content_sanskrit": "हंससारसयुक्तेन विमानेन स गच्छति ।\nपञ्चाशतं सहस्राणि वर्षाणां दिवि मोदते\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2202284, "chapter_id": 5308, "verse_number": "४६", "content_sanskrit": "पक्षे पक्षे गते राजन् योऽश्नीयाद् वर्षमेव तु ।\nषण्मासानशनं तस्य भगवानङ्गिराब्रवीत् ।\nषष्टिं वर्षसहस्राणि दिवमावसते च सः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2202285, "chapter_id": 5308, "verse_number": "४७", "content_sanskrit": "वीणानां वल्लकीनां च वेणूनां च विशाम्पते ।\nसुघोषैर्मधुरैः शब्दैः सुप्तः स प्रतिबोध्यते\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2202286, "chapter_id": 5308, "verse_number": "४८", "content_sanskrit": "संवत्सरमिहैकं तु मासि मासि पिबेत् पयः ।\nफलं विश्वजितस्तात प्राप्नोति सुमनोरमम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2202287, "chapter_id": 5308, "verse_number": "४९", "content_sanskrit": "सिंहव्याघ्रप्रयुक्तेन विमानेन स गच्छति ।\nसप्ततिं च सहस्राणि वर्षाणां दिवि मोदते\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2202288, "chapter_id": 5308, "verse_number": "५०", "content_sanskrit": "मासादूर्ध्वं नरव्याघ्र नोपवासो विधीयते ।\nविधिं त्वनशनस्याहुः पार्थ धर्मविदो जनाः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2202289, "chapter_id": 5308, "verse_number": "५१", "content_sanskrit": "अनार्तो व्याधिरहितो गच्छेदनशनं तु यः ।\nपदे पदे यज्ञफलं प्राप्नोत्येव न संशयः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2202290, "chapter_id": 5308, "verse_number": "५२", "content_sanskrit": "दिवं हंसप्रयुक्तेन विमानेन स गच्छति ।\nशतं चाप्सरसः कन्या रमयन्त्यपि तं नरम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2202291, "chapter_id": 5308, "verse_number": "५३", "content_sanskrit": "आर्तो वा व्याधितो वापि गच्छेदनशनं तु यः ।\nशतं वर्षसहस्राणां मोदते दिवि स प्रभो ।\nकाञ्चीनूपुरशब्देन प्रसुप्तः प्रतिबुध्यते\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2202292, "chapter_id": 5308, "verse_number": "५४", "content_sanskrit": "सहस्रहंससंयुक्ते विमाने सोमवर्चसि ।\nस गत्वा स्त्रीशताकीर्णे रमते भरतर्षभ\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2202293, "chapter_id": 5308, "verse_number": "५५", "content_sanskrit": "क्षीणस्याप्यायनं दृष्टं क्षतस्य क्षतरोहणम् ।\nव्याधितस्यौषधग्रामः क्रुद्धस्य च प्रसादनम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2202294, "chapter_id": 5308, "verse_number": "५६", "content_sanskrit": "दुःखितस्यार्थमानाभ्यां द्रव्याणां प्रतिपादनम् ।\nन चैते स्वर्गकामस्य रोचन्ते सुखमेधसः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2202295, "chapter_id": 5308, "verse_number": "५७", "content_sanskrit": "अतः स कामसंयुक्तो विमाने हेमसन्निभे ।\nरमते स्त्रीशताकीर्णे पुरुषोऽलङ्कृतः शुभे\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2202296, "chapter_id": 5308, "verse_number": "५८", "content_sanskrit": "स्वस्थः सफलसङ्कल्पः सुखी विगतकल्मषः ।\nअनश्नन् देहमुत्सृज्य फलं प्राप्नोति मानवः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2202297, "chapter_id": 5308, "verse_number": "५९", "content_sanskrit": "बालसूर्यप्रतीकाशे विमाने हेमवर्चसि ।\nवैडूर्यमुक्ताखचिते वीणामुरजनादिते\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2202298, "chapter_id": 5308, "verse_number": "६०", "content_sanskrit": "पताकादीपिकाकीर्णे दिव्यघण्टानिनादिते ।\nस्त्रीसहस्रानुचरिते स नरः सुखमेधते\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2202299, "chapter_id": 5308, "verse_number": "६१", "content_sanskrit": "यावन्ति रोमकूपाणि तस्य गात्रेषु पाण्डव ।\nतावन्त्येव सहस्राणि वर्षाणां दिवि मोदते\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2202300, "chapter_id": 5308, "verse_number": "६२", "content_sanskrit": "नास्ति वेदात् परं शास्त्रं नास्ति मातृसमो गुरुः ।\nन धर्मात्परमो लाभः तपो नानशनात् परम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2202301, "chapter_id": 5308, "verse_number": "६३", "content_sanskrit": "ब्राह्मणेभ्यः परं नास्ति पावनं दिवि चेह च ।\nउपवासैस्तथा तुल्यं तपःकर्म न विद्यते\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2202302, "chapter_id": 5308, "verse_number": "६४", "content_sanskrit": "उपोष्य विधिवद् देवास्त्रिदिवं प्रतिपेदिरे ।\nऋषयश्च परां सिद्धिमुपवासैरवाप्नुवन्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2202303, "chapter_id": 5308, "verse_number": "६५", "content_sanskrit": "दिव्यं वर्षसहस्रं हि विश्वामित्रेण धीमता ।\nक्षान्तमेकेन भक्तेन तेन विप्रत्वमागतः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2202304, "chapter_id": 5308, "verse_number": "६६", "content_sanskrit": "च्यवनो जमदग्निश्च वसिष्ठो गौतमो भृगुः ।\nसर्व एव दिवं प्राप्ताः क्षमावन्तो महर्षयः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2202305, "chapter_id": 5308, "verse_number": "६७", "content_sanskrit": "इदमङ्गिरसा पूर्वं महर्षिभ्यः प्रदर्शितम् ।\nयः प्रदर्शयते नित्यं न स दुःखमवाप्नुयात्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2202306, "chapter_id": 5308, "verse_number": "६८", "content_sanskrit": "इमं तु कौन्तेय यथाक्रमं विधिं\nप्रवर्तितं ह्यङ्गिरसा मनीषिणा ।\nपठेत यो वै शृणुयाच्च नित्यदा\nन विद्यते तस्य नरस्य किल्बिषम् \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2202307, "chapter_id": 5308, "verse_number": "६९", "content_sanskrit": "विमुच्यते चापि स सर्वसङ्करैः\nन चास्य दोषैरभिभूयते मनः ।\nवियोनिजानां च विजानते रुतं\nध्रुवां च कीर्तिं लभते नरोत्तमः \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2202308, "chapter_id": 5308, "verse_number": "१५९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे उपवासविधिर्नाम एकोनषष्ट्युत्तरशततमोऽध्यायः ॥१५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2202309, "chapter_id": 5308, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]