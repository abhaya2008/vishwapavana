[{"id": 2092498, "chapter_id": 2968, "verse_number": "१३-९८-१", "content_sanskrit": "युधिष्ठिर उवाच।\nकानि दानानि लोकेऽस्मिन्दातुकामो महीपतिः।\nगुणाधिकेभ्यो विप्रेभ्यो दद्याद्भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092499, "chapter_id": 2968, "verse_number": "१३-९८-२", "content_sanskrit": "केन तुष्यन्ति ते सद्यः किं तुष्टाः प्रदिशन्ति च।\nशंस मे तन्महाबाहो फलं पुण्यकृतं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092500, "chapter_id": 2968, "verse_number": "१३-९८-३", "content_sanskrit": "दत्तं किं फलवद्राजन्निह लोकें परत्र च।\nभवतः श्रोतुमिच्छामि तन्मे विस्तरतो वद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092501, "chapter_id": 2968, "verse_number": "१३-९८-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092502, "chapter_id": 2968, "verse_number": "१३-९८-४", "content_sanskrit": "इममर्थं पुरा पृष्टो नारदो देवदर्शनः।\nयदुक्तवानसौ वाक्यं तन्मे निगदतः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092503, "chapter_id": 2968, "verse_number": "१३-९८-५x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092504, "chapter_id": 2968, "verse_number": "१३-९८-५", "content_sanskrit": "अन्नमेव प्रशंसन्ति देवा ऋषिगणास्तथा।\nलोकतन्त्रं हि यज्ञाश्च सर्वमन्ने प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092505, "chapter_id": 2968, "verse_number": "१३-९८-६", "content_sanskrit": "अन्नेन सदृशं दानं न भूतं न भविष्यति।\nतस्मादन्नं विशेषेणि दातुमिच्छन्ति मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092506, "chapter_id": 2968, "verse_number": "१३-९८-७", "content_sanskrit": "अन्नमूर्जस्करं लोके प्राणाश्चान्ने प्रतिष्ठिताः।\nअन्नेन धार्यते सर्वं विश्वं जगदिदं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092507, "chapter_id": 2968, "verse_number": "१३-९८-८", "content_sanskrit": "अन्नाद्गृहस्था लोकेऽस्मिन्भिक्षवस्तापसास्तथा॥\nअन्नाद्भवन्ति वै प्राणाः प्रत्यक्षं नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092508, "chapter_id": 2968, "verse_number": "१३-९८-९", "content_sanskrit": "कटुम्बिने सीदते च ब्राह्मणाय महात्मने।\nदातव्यं भिक्षवे चान्नमात्मनो भूतिमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092509, "chapter_id": 2968, "verse_number": "१३-९८-१०", "content_sanskrit": "ब्राह्मणायाभिरूपाय यो दद्यादन्नमर्थिने।\nनिदधाति निधिं श्रेष्ठं पारलौकिकमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092510, "chapter_id": 2968, "verse_number": "१३-९८-११", "content_sanskrit": "श्रान्तमध्वनि वर्तन्तं वृद्धमर्हमुपस्थितम्।\nअर्ययेद्भूतिमन्विच्छन्गृहस्थो गृहमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092511, "chapter_id": 2968, "verse_number": "१३-९८-१२", "content_sanskrit": "क्रोधमुत्पतितं हित्वा सुशीलो वीतमत्सरः।\nअन्नदः प्राप्नुते राजन्दिवि चेह च यत्सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092512, "chapter_id": 2968, "verse_number": "१३-९८-१३", "content_sanskrit": "नावमन्येदभिगतं न प्रणुद्यात्कदाचन।\nअपि श्वपाके शुनि वा नान्नदानं प्रणश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092513, "chapter_id": 2968, "verse_number": "१३-९८-१४", "content_sanskrit": "यो दद्यादपरिक्लिष्टमन्नमध्वनि वर्तते।\nआर्तायादृष्टपूर्वाय स महद्धर्ममाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092514, "chapter_id": 2968, "verse_number": "१३-९८-१५", "content_sanskrit": "पितॄन्देवानृपीन्विप्रानतिथींश्च जनाधिप।\nयो नरः प्रीणयत्यन्नैस्तस्य पुण्यफलं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092515, "chapter_id": 2968, "verse_number": "१३-९८-१६", "content_sanskrit": "कृत्वाऽतिपातकं कर्म यो दद्यादन्नमर्थिने।\nब्राह्मणाय विशेषेण न स पापेन मुह्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092516, "chapter_id": 2968, "verse_number": "१३-९८-१७", "content_sanskrit": "ब्राह्मणेष्वक्षयं दानमन्नं शूद्रे महाफलम्।\nअन्नदानं हि शूद्रे च ब्राह्मणे च विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092517, "chapter_id": 2968, "verse_number": "१३-९८-१८", "content_sanskrit": "न पृच्छेद्गोत्रचरणं स्वाध्यायं देशमेव च।\nभिक्षितो ब्राह्मणेनान्नं दद्यादेवाविचारतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092518, "chapter_id": 2968, "verse_number": "१३-९८-१९", "content_sanskrit": "अन्नदस्यान्नदा वृक्षाः सर्वकामफलप्रदाः।\nभवन्ति चेह चामुत्र नृपते नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2092519, "chapter_id": 2968, "verse_number": "१३-९८-२०", "content_sanskrit": "आशंसन्ते हि पितरः सुवृष्टिमिव कर्षकाः।\nअस्माकमपि पुत्रो वा पौत्रो वाऽन्नं प्रदास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2092520, "chapter_id": 2968, "verse_number": "१३-९८-२१", "content_sanskrit": "ब्राह्मणो हि महद्भूतं स्वयं देहीति याचते।\nअकामो वा सकामो वा दत्त्वा पुण्यमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2092521, "chapter_id": 2968, "verse_number": "१३-९८-२२", "content_sanskrit": "ब्राह्मणः सर्वभूतानामतिथिः प्रसृताग्रभुक्।\nविप्रा यदधिगच्छन्ति भिक्षमाणा गृहं सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2092522, "chapter_id": 2968, "verse_number": "१३-९८-२३", "content_sanskrit": "सत्कताश्च निवर्तन्ते तदतीव प्रवर्धते।\nमहाभागे कुले प्रेत्य जन्म चाप्नोति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2092523, "chapter_id": 2968, "verse_number": "१३-९८-२४", "content_sanskrit": "दत्त्वा त्वन्नं नरो लोके तथा स्थानमनुत्तमम्।\nस्विष्टमृष्टान्नदायी तु स्वर्गे वसति सत्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2092524, "chapter_id": 2968, "verse_number": "१३-९८-२५", "content_sanskrit": "अन्नं प्राणा नराणां हि सर्वमन्ने प्रतिष्ठिम्।\nअन्नदः पशुमान्पुत्री धनवान्भोगवानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2092525, "chapter_id": 2968, "verse_number": "१३-९८-२६", "content_sanskrit": "प्राणवांश्चापि भवति रूपवांश्च तथा नृप।\nअन्नदः प्राणदो लोके सर्वदः प्रोच्यते तु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2092526, "chapter_id": 2968, "verse_number": "१३-९८-२७", "content_sanskrit": "अन्नं हि दत्त्वाऽतिथये ब्राह्मणाय यथाविधि।\nप्रदाता सुखमाप्नोति दैवतैश्चापि पूज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2092527, "chapter_id": 2968, "verse_number": "१३-९८-२८", "content_sanskrit": "ब्राह्मणो हि महद्भूतं क्षेत्रभूतं युधिष्ठिर।\nउप्यते तत्रि यद्बीजं तद्धि पुण्यफलं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2092528, "chapter_id": 2968, "verse_number": "१३-९८-२९", "content_sanskrit": "प्रत्यक्षं प्रीतिजननं भोक्तुर्दातुर्भवत्युत।\nसर्वाण्यन्यानि दानानि परोक्षफलवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2092529, "chapter_id": 2968, "verse_number": "१३-९८-३०", "content_sanskrit": "अन्नाद्धि प्रसवं यान्ति रतिरन्नाद्धि भारत।\nधर्मार्थावन्नतो विद्धि रोगनाशं तथाऽन्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2092530, "chapter_id": 2968, "verse_number": "१३-९८-३१", "content_sanskrit": "अन्नं ह्यमृतमित्याह पुरा कल्पे प्रजापतिः।१३-९८-३ab अन्नं भुवं दिवं खं च सर्वमन्ने प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2092531, "chapter_id": 2968, "verse_number": "१३-९८-३२", "content_sanskrit": "अन्नप्रणाशे भिद्यन्ते शरीरे पञ्च धातवः।\nबलं बलवतोपीह प्रणश्यत्यन्नहानितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2092532, "chapter_id": 2968, "verse_number": "१३-९८-३३", "content_sanskrit": "आवाहाश्च विवाहाश्च यज्ञाश्चान्नमृते तथा।\nनिवर्तन्ते नरश्रेष्ठ ब्रह्म चात्र प्रलीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2092533, "chapter_id": 2968, "verse_number": "१३-९८-३४", "content_sanskrit": "अन्नतः सर्वमेतद्धि यत्किञ्चित्स्थाणु जङ्गमम्।\nत्रिषु लोकेषु धर्मार्थमन्नं देयमतो बुधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2092534, "chapter_id": 2968, "verse_number": "१३-९८-३५", "content_sanskrit": "अन्नदस्य मनुष्यस्य बलमोजो यशांसि च।\nकीर्तिश्च वर्धते शश्वत्त्रिषु लोकेषु पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2092535, "chapter_id": 2968, "verse_number": "१३-९८-३६", "content_sanskrit": "मेघेषूर्ध्वं सन्निधत्ते प्राणानां पवनः पतिः।\nतच्च मेघगतं वारि शक्रो वर्षति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2092536, "chapter_id": 2968, "verse_number": "१३-९८-३७", "content_sanskrit": "आदत्ते च रसान्भौनानादित्यः स्वगभस्तिभिः।\nवायुरादित्यतस्तांश्च रसान्देवः प्रवर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2092537, "chapter_id": 2968, "verse_number": "१३-९८-३८", "content_sanskrit": "तद्यदा मेघतो वारि पतितं भवति क्षितौ।\nतदा वसुमती देवी स्निग्धा भवति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2092538, "chapter_id": 2968, "verse_number": "१३-९८-३९", "content_sanskrit": "ततः सस्यानि रोहन्ति येन वर्तयते जगत्।\nमांसमेदोस्थिशुक्राणां प्रादुर्भावस्ततः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2092539, "chapter_id": 2968, "verse_number": "१३-९८-४०", "content_sanskrit": "सम्भवन्ति ततः शुक्रात्प्राणिनः पृथिवीपते।\nअग्नीषोमौ हि तच्छुक्रं सृजतः पुष्यतश्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2092540, "chapter_id": 2968, "verse_number": "१३-९८-४१", "content_sanskrit": "एवमन्नाद्धि सूर्यश्च पवनः शक्रमेव च।\nएक एव स्मृतो राशिस्ततो भूतानि जज्ञिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2092541, "chapter_id": 2968, "verse_number": "१३-९८-४२", "content_sanskrit": "प्राणान्ददाति भूतानां तेजश्च भरतर्षभ।\nगृहमभ्यागतायाथ यो दद्यादन्नमर्थिने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2092542, "chapter_id": 2968, "verse_number": "१३-९८-४३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2092543, "chapter_id": 2968, "verse_number": "१३-९८-४३", "content_sanskrit": "नारदेनैवमुक्तोऽहमन्नदानं सदा नृप।\nअनसूयुस्त्वमप्यन्नं तस्माद्देहि गतज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2092544, "chapter_id": 2968, "verse_number": "१३-९८-४४", "content_sanskrit": "दत्त्वाऽन्नं विधिवद्राजन्विप्रेभ्यस्त्वमपि प्रभो।\nयथावदनुरूपेभ्यस्ततः स्वर्गमवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2092545, "chapter_id": 2968, "verse_number": "१३-९८-४५", "content_sanskrit": "अन्नदानां हि ये लोकास्तांस्त्वं शृणु जनाधिप।\nभवनानि प्रकाशन्ते दिवि तेषां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2092546, "chapter_id": 2968, "verse_number": "१३-९८-४६", "content_sanskrit": "नानासंस्थानि रूपाणि नानास्तम्भान्वितानि च।\nचन्द्रमण्डलशुभ्राणि किंकिणीजालवन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2092547, "chapter_id": 2968, "verse_number": "१३-९८-४७", "content_sanskrit": "तरुणादित्यवर्णानि स्थावराणि चराणि च।\nअनेकशतभौमानि सान्तर्जलचराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2092548, "chapter_id": 2968, "verse_number": "१३-९८-४८", "content_sanskrit": "वैदूर्यार्कप्रकाशानि रौप्यरुक्ममयानि च।\nसर्वकामफलाश्चापि वृक्षा भवनसंस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2092549, "chapter_id": 2968, "verse_number": "१३-९८-४९", "content_sanskrit": "वाप्यो वीथ्यः सभाः कूपा दीर्घिकाश्चैव सर्वशः।\nघोषवन्ति च यानानि युक्तान्यथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2092550, "chapter_id": 2968, "verse_number": "१३-९८-५०", "content_sanskrit": "भक्ष्यभोज्यमयाः शैला वासांस्याभरणानि च।\nक्षीरं स्रवन्ति सरितस्तथा चैवान्नपर्वताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2092551, "chapter_id": 2968, "verse_number": "१३-९८-५१", "content_sanskrit": "प्रासादाः पाण्डुराभ्राभाः शय्याश्च कनकोञ्ज्वलाः।\nतान्यन्नदाः प्रपद्यन्ते तस्मादन्नप्रदो भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2092552, "chapter_id": 2968, "verse_number": "१३-९८-५२", "content_sanskrit": "एते लोकाः पुण्यकृता अन्नदानां महात्मनाम्।\nतस्मादन्नं प्रयत्नेन दातव्यं मानवैर्भुवि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2092553, "chapter_id": 2968, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टनवतितमोऽध्यायः॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]