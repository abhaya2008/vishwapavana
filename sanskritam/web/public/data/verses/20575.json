[{"id": 7000575000, "chapter_id": 20575, "verse_number": "५-३४-१", "content_sanskrit": "शेष उवाच ।\nरथैः सदश्वैः शोभाढ्यैः सर्वशस्त्रास्त्रपूरितैः ।\nनानारत्नसमायुक्तैर्ययुस्ते राक्षसाधमम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000575001, "chapter_id": 20575, "verse_number": "५-३४-२", "content_sanskrit": "तान्दृष्ट्वा कामगे याने स्थितः प्रोवाच राक्षसः ।\nमेघगंभीरया वाचा तर्जयन्निव भूरिशः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000575002, "chapter_id": 20575, "verse_number": "५-३४-३", "content_sanskrit": "मायां तु सुभटा योद्धुं गच्छंतु निजमंदिरम् ।\nमा त्यजंतु स्वकान्प्राणान्न मोक्ष्ये वाजिनं वरम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000575003, "chapter_id": 20575, "verse_number": "५-३४-४", "content_sanskrit": "विद्युन्मालीति विख्यातो रावणस्य सुहृत्सखा ।\nमत्सख्युः प्रेतभूतस्य निष्कृतिं कर्तुमेयिवान्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000575004, "chapter_id": 20575, "verse_number": "५-३४-५", "content_sanskrit": "क्वासौ रामो य आहत्य सखायं रावणं गतः ।\nतस्य भ्रातापि कुत्रास्ते सर्वशूरशिरोमणिः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000575005, "chapter_id": 20575, "verse_number": "५-३४-६", "content_sanskrit": "तं हत्वा निष्कृतिं तस्य प्राप्स्ये रामस्य चानुजम् ।\nपिबन्रुधिरमुद्भूतं कंठनालस्य बुद्बुदैः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000575006, "chapter_id": 20575, "verse_number": "५-३४-७", "content_sanskrit": "इति वाक्यं समाकर्ण्य योधानां प्रवरोत्तमः ।\nपुष्कलो निजगादैनं वीर्यशौर्यसमन्वितम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000575007, "chapter_id": 20575, "verse_number": "५-३४-८", "content_sanskrit": "पुष्कल उवाच ।\nविकत्थनं न कुर्वंति संग्रामे सुभटा नराः ।\nपराक्रमं दर्शयंति निजशस्त्रास्त्रवर्षणैः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000575008, "chapter_id": 20575, "verse_number": "५-३४-९", "content_sanskrit": "रावणो निहतो येन ससुहृत्स्वजनैर्वृतः ।\nतस्य वाजिनमाहृत्य कुत्र गंतासि दुर्मद॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000575009, "chapter_id": 20575, "verse_number": "५-३४-१०", "content_sanskrit": "पतिष्यसि त्वं शत्रुघ्नबाणैः कोदंडनिर्गतैः ।\nत्वामत्स्यंति शिवा भूमौ पतितं प्राणवर्जितम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000575010, "chapter_id": 20575, "verse_number": "५-३४-११", "content_sanskrit": "मा गर्ज दुष्ट रामस्य सेवके मयि संस्थिते ।\nगर्जंति सुभटा युद्धे शत्रुं जित्वा महोदयात्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000575011, "chapter_id": 20575, "verse_number": "५-३४-१२", "content_sanskrit": "शेष उवाच ।\nएवं ब्रुवंतं तं वीरं पुष्कलं रणदुर्मदम् ।\nजघान शक्त्या सुभृशं हृदि राक्षससत्तमः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000575012, "chapter_id": 20575, "verse_number": "५-३४-१३", "content_sanskrit": "आयांतीं तां महाशक्तिमायसीं कांचनाश्रिताम् ।\nचिच्छेद त्रिभिरत्युग्रैः शितैर्बाणैः स पुष्कलः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000575013, "chapter_id": 20575, "verse_number": "५-३४-१४", "content_sanskrit": "सा त्रिधा ह्यपतद्भूमौ विशिखैर्निष्प्रभीकृता ।\nपतंती विरराजासौ विष्णोः शक्तित्रयीव किम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000575014, "chapter_id": 20575, "verse_number": "५-३४-१५", "content_sanskrit": "तां छिन्नां शक्तिकां दृष्ट्वा राक्षसः परतापनः ।\nजग्राह शूलं तरसा त्रिशिखं लोहनिर्मितम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000575015, "chapter_id": 20575, "verse_number": "५-३४-१६", "content_sanskrit": "तीक्ष्णाग्रं ज्वलनप्रख्यं राक्षसेंद्रो व्यमोचयत् ।\nआयांतं तिलशश्चक्रे बाणैः पुष्कलसंज्ञितः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000575016, "chapter_id": 20575, "verse_number": "५-३४-१७", "content_sanskrit": "छित्त्वा त्रिशूलं तरसा राघवस्य हि सेवकः ।\nपुष्कलश्चाप आधत्त बाणांस्तीक्ष्णान्मनोजवान्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000575017, "chapter_id": 20575, "verse_number": "५-३४-१८", "content_sanskrit": "ते बाणा हृदि तस्याशु लग्ना रागं बतासृजन् ।\nवैष्णवस्य यथा स्वांते गुणा विष्णोर्मनोहराः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000575018, "chapter_id": 20575, "verse_number": "५-३४-१९", "content_sanskrit": "तद्बाणवेधदुःखार्तो विद्युन्माली सुदुर्मदः ।\nजग्राह मुद्गरं घोरं पुष्कलं हंतुमुद्यतः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000575019, "chapter_id": 20575, "verse_number": "५-३४-२०", "content_sanskrit": "मुद्गरः प्रहितस्तेन विद्युन्माल्यभिधेन हि ।\nहृदि लग्नोसृजच्छीघ्रं कश्मलं तदकारयत्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000575020, "chapter_id": 20575, "verse_number": "५-३४-२१", "content_sanskrit": "मुद्गरप्रहतो वीरः कंपमानः सवेपथुः ।\nपपात स्यंदनोपस्थे पुष्कलः शत्रुतापनः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000575021, "chapter_id": 20575, "verse_number": "५-३४-२२", "content_sanskrit": "उग्रदंष्ट्रोऽथ तद्भ्राता लक्ष्मीनिधिमयोधयत् ।\nशस्त्रास्त्रैर्बहुधा मुक्तैर्वीरप्राणहृतिंकरैः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000575022, "chapter_id": 20575, "verse_number": "५-३४-२३", "content_sanskrit": "पुष्कलस्तत्क्षणात्प्राप्य संज्ञां राक्षसमब्रवीत् ।\nधन्योसि राक्षसश्रेष्ठ महीयांस्ते पराक्रमः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000575023, "chapter_id": 20575, "verse_number": "५-३४-२४", "content_sanskrit": "पश्येदानीं ममाप्युच्चैः प्रतिज्ञां शूरमानिताम् ।\nविमानात्पातयाम्यद्य भूमौ त्वां शितसायकैः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000575024, "chapter_id": 20575, "verse_number": "५-३४-२५", "content_sanskrit": "इत्युक्त्वा निशितं बाणं समगृह्णाद्दुरासदम् ।\nज्वलंतमग्नितेजस्कं महौदार्यसमन्वितम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000575025, "chapter_id": 20575, "verse_number": "५-३४-२६", "content_sanskrit": "स यावत्तत्प्रतीकर्तुं विधत्ते स्वपराक्रमम् ।\nतावद्धृदिगतोऽत्युग्रस्तीक्ष्णधारः ससायकः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000575026, "chapter_id": 20575, "verse_number": "५-३४-२७", "content_sanskrit": "तेन बाणेन विभ्रांतो भ्रमच्चित्तः स राक्षसः ।\nपपात कामगोपस्थाद्भूमौ विगतचेतनः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000575027, "chapter_id": 20575, "verse_number": "५-३४-२८", "content_sanskrit": "उग्रदंष्ट्रेण वै दृष्टः पतमानो निजाग्रजः ।\nगृहीत्वा तं विमानांतर्निनाय रिपुशंकितः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000575028, "chapter_id": 20575, "verse_number": "५-३४-२९", "content_sanskrit": "प्राह चारिं महारोषात्पुष्कलं बलिनां वरम् ।\nमद्भ्रातरं पातयित्वा कुत्र यास्यसि दुर्मते॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000575029, "chapter_id": 20575, "verse_number": "५-३४-३०", "content_sanskrit": "मां वै युधि विनिर्जित्य गंतासि जयमुत्तमम् ।\nस्थिते मयि तव स्वांते जयाशा विनिवर्त्य ताम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000575030, "chapter_id": 20575, "verse_number": "५-३४-३१", "content_sanskrit": "एवं ब्रुवंतं तरसा जघान दशभिः शरैः ।\nहृदये तस्य दुष्टस्य रोषपूरितलोचनः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000575031, "chapter_id": 20575, "verse_number": "५-३४-३२", "content_sanskrit": "स ताडितो दशशरैः पुष्कलेन महात्मना ।\nचुक्रोध हृदि दुर्बुद्धिस्तं हंतुमुपचक्रमे॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000575032, "chapter_id": 20575, "verse_number": "५-३४-३३", "content_sanskrit": "दंतान्निष्पिष्य सक्रोधो मुष्टिमुद्यम्य चाहनत् ।\nव्यनदद्वज्रनिर्घातपातशंकां सृजन्हृदि॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000575033, "chapter_id": 20575, "verse_number": "५-३४-३४", "content_sanskrit": "मुष्टिनाभिहतो वीरः पुष्कलः परमास्त्रवित् ।\nनाकंपत विनिष्पेषं वांछंस्तस्य दुरात्मनः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000575034, "chapter_id": 20575, "verse_number": "५-३४-३५", "content_sanskrit": "वत्सदंतान्महातीक्ष्णान्मुमोच हृदि सायकान् ।\nतैर्बाणैर्व्यथितो दैत्यस्त्रिशूलं तु समाददे॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000575035, "chapter_id": 20575, "verse_number": "५-३४-३६", "content_sanskrit": "जाज्वल्यमानं त्रिशिखं ज्वालामालातिभीषणम् ।\nलग्नं हृदि महावीर पुष्कलस्य तु दारुणम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000575036, "chapter_id": 20575, "verse_number": "५-३४-३७", "content_sanskrit": "मूर्च्छितस्तेन शूलेन निहतो धन्विसत्तमः ।\nकश्मलं परमं प्राप्तः पपात स्यंदनोपरि॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000575037, "chapter_id": 20575, "verse_number": "५-३४-३८", "content_sanskrit": "मूर्च्छां प्राप्तं तमाज्ञाय हनूमान्पवनात्मजः ।\nकोपव्याकुलितस्वांतो बभाषे तं तु राक्षसम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000575038, "chapter_id": 20575, "verse_number": "५-३४-३९", "content_sanskrit": "कुत्र गच्छसि दुर्बुद्धे मयि योद्धरि संस्थिते ।\nत्वां हन्मि चरणाघातैर्वाजिहर्तारमागतम्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000575039, "chapter_id": 20575, "verse_number": "५-३४-४०", "content_sanskrit": "एवमुक्त्वा महादैत्याञ्जघान परसैनिकान् ।\nविमानस्थान्नखाग्रेण दारयन्नभसि स्थितः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000575040, "chapter_id": 20575, "verse_number": "५-३४-४१", "content_sanskrit": "लांगूलेनाहताः केचित्केचित्पादतला हताः ।\nबाहुभ्यां दारिताः केचित्पवनस्य तनूभुवा॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000575041, "chapter_id": 20575, "verse_number": "५-३४-४२", "content_sanskrit": "नश्यंति केचिन्निहताः केचिन्मूर्च्छंति संहताः ।\nपलायंते पदाघातभयपीडाहतास्ततः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000575042, "chapter_id": 20575, "verse_number": "५-३४-४३", "content_sanskrit": "अनेके निहतास्तत्र राक्षसाश्चातिदारुणाः ।\nछिन्ना भिन्ना द्विधा जाताः पवनस्य सुतेन वै॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000575043, "chapter_id": 20575, "verse_number": "५-३४-४४", "content_sanskrit": "कामगंतुविमानं तद्भिन्नप्राकारतोरणम् ।\nहाहा कुर्वद्भिरसुरैः समंतात्परिवारितम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000575044, "chapter_id": 20575, "verse_number": "५-३४-४५", "content_sanskrit": "हनूमति महाशूरे क्षणं भूमौ क्षणं दिवि ।\nइतस्ततः प्रदृश्येत कामयानं दुरासदम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000575045, "chapter_id": 20575, "verse_number": "५-३४-४६", "content_sanskrit": "यत्रयत्र विमानं तत्तत्रतत्र समीरजः ।\nप्रहरन्नेव दृश्येत कामरूपधरः कपिः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000575046, "chapter_id": 20575, "verse_number": "५-३४-४७", "content_sanskrit": "एवं तदाकुलीभूते विमानस्थे महाजने ।\nउग्रदंष्ट्रस्तु दैत्येंद्रो हनूमंतमुपेयिवान्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000575047, "chapter_id": 20575, "verse_number": "५-३४-४८", "content_sanskrit": "कपे त्वया महत्कर्म कृतं यद्भटपातनम् ।\nक्षणं तिष्ठसि चेत्कुर्वे तव प्राणवियोजनम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000575048, "chapter_id": 20575, "verse_number": "५-३४-४९", "content_sanskrit": "एवमुक्त्वा हनूमंतं प्रजघान स दुर्मतिः ।\nत्रिशूलेन सुतीक्ष्णेन ज्वलत्पावककांतिना॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000575049, "chapter_id": 20575, "verse_number": "५-३४-५०", "content_sanskrit": "तदागतं त्रिशूलं च मुखे जग्राह वीर्यवान् ।\nचूर्णयामास सकलं सर्वलोहविनिर्मितम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000575050, "chapter_id": 20575, "verse_number": "५-३४-५१", "content_sanskrit": "चूर्णयित्वा त्रिशूलं तदायसं दैत्यमोचितम् ।\nजघान तं चपेटाभिर्बह्वीभिर्हनुमान्बली॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000575051, "chapter_id": 20575, "verse_number": "५-३४-५२", "content_sanskrit": "स आहतः कपीन्द्रेण चपेटाभिरितस्ततः ।\nव्यथितो व्यसृजन्मायां सर्वलोकभयंकरीम्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000575052, "chapter_id": 20575, "verse_number": "५-३४-५३", "content_sanskrit": "तदा तमोभवत्तीव्रं यत्र को वा न लक्ष्यते ।\nयत्र स्वीयो न पारक्यो विदामास जनान्बहून्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000575053, "chapter_id": 20575, "verse_number": "५-३४-५४", "content_sanskrit": "शिलाः पर्वतशृंगाभाः पतंति सुभटोपरि ।\nताभिर्हतास्तु ते सर्वे व्याकुला अथ जज्ञिरे॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000575054, "chapter_id": 20575, "verse_number": "५-३४-५५", "content_sanskrit": "विद्युतो विलसंत्यत्र गर्जंति जलदा घनम् ।\nवर्षंति पूयरुधिरं मुंचंति समलं जलम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000575055, "chapter_id": 20575, "verse_number": "५-३४-५६", "content_sanskrit": "आकाशात्पतमानानि कबंधानि बहूनि च ।\nदृश्यंते छिन्नशीर्षाणि सकुंडलयुतानि च॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000575056, "chapter_id": 20575, "verse_number": "५-३४-५७", "content_sanskrit": "नग्ना विरूपाः सुभृशं कीर्णकेशाः सुदुर्मुखाः ।\nदृश्यंते सर्वतो दैत्या दारुणा भयकारिणः॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000575057, "chapter_id": 20575, "verse_number": "५-३४-५८", "content_sanskrit": "तदा व्याकुलिता लोकाः परस्परभयाकुलाः ।\nपलायनपरा जाता महोत्पातममंसत॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000575058, "chapter_id": 20575, "verse_number": "५-३४-५९", "content_sanskrit": "तदा शत्रुघ्न आयातो रथे स्थित्वा महायशाः ।\nश्रीरामस्मरणं कृत्वा चापे संधाय सायकान्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000575059, "chapter_id": 20575, "verse_number": "५-३४-६०", "content_sanskrit": "तां मायां स विधूयाथ मोहनास्त्रेण वीर्यवान् ।\nशरधाराः किरन्व्योम्नि ववर्ष समरेसुरम्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000575060, "chapter_id": 20575, "verse_number": "५-३४-६१", "content_sanskrit": "तदादिशः प्रसेदुस्ता रविस्त्वपरिवेषवान् ।\nमेघा यथागतं याता विद्युतः शांतिमागताः॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000575061, "chapter_id": 20575, "verse_number": "५-३४-६२", "content_sanskrit": "तदा विमानं पुरतो दृश्यते राक्षसैर्युतम् ।\nछिंधि भिंधीति भाषाभिर्व्याकुलं सुतरां महत्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000575062, "chapter_id": 20575, "verse_number": "५-३४-६३", "content_sanskrit": "बाणाश्च शतसाहस्राः स्वर्णपुंखैश्च शोभिताः ।\nपेतुर्विमाने नभसि स्थिते कामगमे मुहुः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000575063, "chapter_id": 20575, "verse_number": "५-३४-६४", "content_sanskrit": "तदा भग्नं विमानं हि दृश्यते न तदुच्चकैः ।\nस्वपुरी खण्डमेकत्र भग्नांगमिव भूतले॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000575064, "chapter_id": 20575, "verse_number": "५-३४-६५", "content_sanskrit": "तदा प्रकुपितो दैत्यो बाणान्धनुषि संदधे ।\nतैर्बाणैर्विकिरन्रामभ्रातरं चाभिगर्जितः॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000575065, "chapter_id": 20575, "verse_number": "५-३४-६६", "content_sanskrit": "ते बाणाः शतशस्तस्य लग्ना वपुषि भूरिशः ।\nशोभामापुः शोणितौघान्वहंतस्तीक्ष्णवक्त्रिणः॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000575066, "chapter_id": 20575, "verse_number": "५-३४-६७", "content_sanskrit": "शत्रुघ्नः परया शक्त्या संयुक्तो वायुदैवतम् ।\nअस्त्रं धनुषि चाधत्त राक्षसानां प्रकम्पनम्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000575067, "chapter_id": 20575, "verse_number": "५-३४-६८", "content_sanskrit": "तेनास्त्रेण विमानात्खात्पतन्तो मुक्तमूर्धजाः ।\nदृश्यंते भूतवेतालसंघा इव नभश्चराः॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000575068, "chapter_id": 20575, "verse_number": "५-३४-६९", "content_sanskrit": "तदस्त्रं रघुनाथस्य भ्रात्रा मुक्तं विलोक्य सः ।\nअस्त्रं च पाशुपत्यं स चापे धाद्दनुजात्मजः॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000575069, "chapter_id": 20575, "verse_number": "५-३४-७०", "content_sanskrit": "ततः प्रवृत्ता वेताला भूताः प्रेतनिशाचराः ।\nकपालकर्तरीयुक्ताः पिबन्तः शोणितं बहु॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000575070, "chapter_id": 20575, "verse_number": "५-३४-७१", "content_sanskrit": "ते वै शत्रुघ्नवीराणां रुधिराणि पपुर्मुदा ।\nजीवतामपि दुर्वाराः कर्तरीपाणिशोभिताः॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000575071, "chapter_id": 20575, "verse_number": "५-३४-७२", "content_sanskrit": "तदस्त्रं व्याप्नुवद्दृष्ट्वा सर्ववीरप्रभंजनम् ।\nमुमोच तन्निरासाय चास्त्रं नारायणाभिधम्॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000575072, "chapter_id": 20575, "verse_number": "५-३४-७३", "content_sanskrit": "नारायणास्त्रं तान्सर्वान्वारयामास तत्क्षणात् ।\nते सर्वे विलयं प्रापुर्निशाचरप्रणोदिताः॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000575073, "chapter_id": 20575, "verse_number": "५-३४-७४", "content_sanskrit": "तदा क्रुद्धो निशाचारी विद्युन्माली समाददे ।\nत्रिशूलं निशितं घोरं शत्रुघ्नं हंतुमुल्बणम्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000575074, "chapter_id": 20575, "verse_number": "५-३४-७५", "content_sanskrit": "शूलहस्तं समायांतं विद्युन्मालिनमाहवे ।\nसायकैः प्राहरत्तस्य भुजे त्वर्धशशिप्रभैः॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000575075, "chapter_id": 20575, "verse_number": "५-३४-७६", "content_sanskrit": "तैर्बाणैश्छिन्नहस्तः स शिरसा हंतुमुद्यतः ।\nहतोसि याहि शत्रुघ्न कस्त्वां त्राता भविष्यति॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000575076, "chapter_id": 20575, "verse_number": "५-३४-७७", "content_sanskrit": "इति ब्रुवाणं तरसा चिच्छेद शितसायकैः ।\nमस्तकं तस्य बलिनः शूरस्य सह कुंडलम्॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000575077, "chapter_id": 20575, "verse_number": "५-३४-७८", "content_sanskrit": "तं छिन्नशिरसं दृष्ट्वा उग्रदंष्ट्रः प्रतापवान् ।\nमुष्टिना हंतुमारेभे शत्रुघ्नं शूरसेवितम्॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000575078, "chapter_id": 20575, "verse_number": "५-३४-७९", "content_sanskrit": "शत्रुघ्नस्तु क्षुरप्रेण सायकेनाच्छिनच्छिरः ।\nप्रधावतो रणे वीरान्सर्वशस्त्रास्त्रकोविदान्॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000575079, "chapter_id": 20575, "verse_number": "५-३४-८०", "content_sanskrit": "हतशेषा ययुः सर्वे राक्षसा नाथवर्जिताः ।\nशत्रुघ्नं प्रणिपत्याथ ददुर्वाजिनमाहृतम्॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000575080, "chapter_id": 20575, "verse_number": "५-३४-८१", "content_sanskrit": "ततो वीणानिनादाश्च शंखनादाः समंततः ।\nश्रूयंते शूरवीराणां जयनादा मनोहराः॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]