[{"id": 50014585, "chapter_id": 11537, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50014586, "chapter_id": 11537, "verse_number": "2", "content_sanskrit": "इत्युक्तवन्तं पुरुषं सनातनं महानुभावोऽखिलसाधुसम्मतः। बद्धाञ्जलिर्बाष्पकळाकुलेक्षणो भक्त्युत्कलो गद्गदया गिराऽब्रवीत्॥ ८/२२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50014587, "chapter_id": 11537, "verse_number": "3", "content_sanskrit": "बलिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50014588, "chapter_id": 11537, "verse_number": "4", "content_sanskrit": "अहो प्रसादोऽस्य कृतः समुद्यतः प्रपन्नभक्तार्थविधौ समाहितः। यल्लोकपालैस्तदनुग्रहोऽमरैरलब्धपूर्वोऽपशदेऽसुरेऽर्पितः॥ ८/२२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50014589, "chapter_id": 11537, "verse_number": "5", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50014590, "chapter_id": 11537, "verse_number": "6", "content_sanskrit": "इत्युक्त्वा हरिमानम्य ब्रह्माणं सभवं ततः। विवेश सुतळं प्रीतो बलिर्मुक्तः सहासुरैः॥ ८/२२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50014591, "chapter_id": 11537, "verse_number": "7", "content_sanskrit": "एवमिन्द्राय भगवान् प्रीत्याऽऽनीय त्रिविष्टपम्। पूरयित्वाऽदितेः काममशासत् सकलं जगत्॥ ८/२२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50014592, "chapter_id": 11537, "verse_number": "8", "content_sanskrit": "लब्धप्रसादनिर्मुक्तं पौत्रं वंशधरं बलिम्। निशाम्य भक्तिप्रवणं प्रह्लाद इदमब्रवीत्॥ ८/२२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50014593, "chapter_id": 11537, "verse_number": "9", "content_sanskrit": "प्रह्लाद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50014594, "chapter_id": 11537, "verse_number": "10", "content_sanskrit": "नेमं विरिञ्चो लभते प्रसादं न श्रीर्न शर्वः किमुतापरे ते। यन्नोऽसुराणामसि दुर्गपालो विश्वाभिवन्द्यैरभिवन्दिताङ्घ्रिः॥ ८/२२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50014595, "chapter_id": 11537, "verse_number": "11", "content_sanskrit": "यत्पादपदम्मकरन्दनिषेवणेन ब्रह्मादयः शरणदाश्नुवते विभूतीः। कस्माद् वयं कुसृतयः खलयोनयस्ते दाक्षिण्यदृष्टिपदवीं भगवन् प्रणीताः॥ ८/२२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50014596, "chapter_id": 11537, "verse_number": "12", "content_sanskrit": "चित्रं तवेहितमहोऽमितयोगमायालीलाविसृष्टभुवनस्य विशारदस्य। सर्वात्मनः समदृशो विषमस्वभावो भक्तप्रियो यदसि कल्पतरुस्वभावः॥ ८/२२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50014597, "chapter_id": 11537, "verse_number": "13", "content_sanskrit": "श्रीभगवानुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50014598, "chapter_id": 11537, "verse_number": "14", "content_sanskrit": "वत्स प्रह्लाद भद्रं ते प्रयाहि सुतळालयम्। मोदमानः स्वपौत्रेण ज्ञातीनां सुखमावह॥ ८/२२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50014599, "chapter_id": 11537, "verse_number": "15", "content_sanskrit": "नित्यं द्रष्टासि मां तत्र गदापाणिमवस्थितम्। मद्दर्शनमहाह्लादध्वस्तकर्मनिबन्धनः॥ ८/२२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50014600, "chapter_id": 11537, "verse_number": "16", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50014601, "chapter_id": 11537, "verse_number": "17", "content_sanskrit": "आज्ञां भगवतो राजन् प्रह्लादो बलिना सह। बाढमित्यमलप्रज्ञो मूध्र्न्याधाय कृताञ्जलिः॥ ८/२२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50014602, "chapter_id": 11537, "verse_number": "18", "content_sanskrit": "परिक्रम्यादिपुरुषं सर्वासुरचमूपतिः। प्रणतस्तदनुज्ञातः प्रविवेश महाबिलम्॥ ८/२२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50014603, "chapter_id": 11537, "verse_number": "19", "content_sanskrit": "अथाहोशनसं राजन् हरिर्नारायणोऽन्तिके। आसीनमृत्विजां मध्ये सदसि ब्रह्मवादिनाम्॥ ८/२२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50014604, "chapter_id": 11537, "verse_number": "20", "content_sanskrit": "ब्रह्मन् सन्तनु शिष्यस्य कर्मच्छिद्रं वितन्वतः। यत् तत् कर्म सुवैषम्यं ब्रह्मदृष्टं समं भवेत्॥ ८/२२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50014605, "chapter_id": 11537, "verse_number": "21", "content_sanskrit": "शुक्र उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50014606, "chapter_id": 11537, "verse_number": "22", "content_sanskrit": "कुतस्तत्कर्मवैषम्यं यस्य कर्मेश्वरो भवान्। यज्ञेश्वरो यज्ञपुरुषः सर्वभावेन पूजितः॥ ८/२२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50014607, "chapter_id": 11537, "verse_number": "23", "content_sanskrit": "मन्त्रतस्तन्त्रतश्छिद्रं देशकालार्हवस्तुतः। सर्वं करोति निश्छिद्रमनुसङ्कीर्तनं तव॥ ८/२२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50014608, "chapter_id": 11537, "verse_number": "24", "content_sanskrit": "तथापि वदतो भूमन् करिष्याम्यनुशासनम्। एतच्छ्रेयः परं पुंसां यत् तवाज्ञानुपालनम्॥ ८/२२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50014609, "chapter_id": 11537, "verse_number": "25", "content_sanskrit": "प्रतिनन्द्य हरेराज्ञामुशना भगवानिति। यज्ञच्छिद्रं समतनोद् बलेर्विप्रर्षिभिः सह॥ ८/२२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50014610, "chapter_id": 11537, "verse_number": "26", "content_sanskrit": "एवं बलेर्महीं राजन् भिक्षित्वा वामनो हरिः। ददौ भ्रात्रे महेन्द्राय त्रिदिवं यत् परैर्हृतम्॥ ८/२२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50014611, "chapter_id": 11537, "verse_number": "27", "content_sanskrit": "प्रजापतिपतिर्ब्रह्मा देवर्षिपितृभूमिपैः। दक्षभृग्वङ्गिरोमुख्यैः कुमारेण भवेन च॥ ८/२२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50014612, "chapter_id": 11537, "verse_number": "28", "content_sanskrit": "कश्यपस्यादितेः प्रीत्यै सर्वभूताभयाय च। लोकानां लोकपालानामकरोद् वामनं पतिम्॥ ८/२२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50014613, "chapter_id": 11537, "verse_number": "29", "content_sanskrit": "वेदानां सर्वदेवानां धर्मस्य यशसः श्रियः। मङ्गळानां व्रतानां च कल्यं स्वर्गापवर्गयोः॥ ८/२२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50014614, "chapter_id": 11537, "verse_number": "30", "content_sanskrit": "उपेन्द्रं कल्पयाञ्चक्र इति सर्वविभूतये। तदा सर्वाणि भूतानि भृशं मुमुदिरे नृप॥ ८/२२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50014615, "chapter_id": 11537, "verse_number": "31", "content_sanskrit": "ततस्त्विन्द्रः पुरस्कृत्य देवयानेन वामनम्। लोकपालैर्दिवं निन्ये ब्रह्मणा चानुमोदितः॥ ८/२२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50014616, "chapter_id": 11537, "verse_number": "32", "content_sanskrit": "प्राप्य त्रिभुवनं चेन्द्र उपेन्द्रभुजपालितम्। श्रिया परमया जुष्टो मुमुदे गतसाध्वसः॥ ८/२२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50014617, "chapter_id": 11537, "verse_number": "33", "content_sanskrit": "ब्रह्मा शर्वः कुमारश्च भृग्वाद्या मुनयो नृप। पितरः सर्वभूतानि सिद्धा वैमानिकाश्च ये॥ ८/२२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50014618, "chapter_id": 11537, "verse_number": "34", "content_sanskrit": "सुमहत् कर्म तद् विष्णोर्गायन्तः परमाद्भुतम्। धिष्ण्यानि स्वानि ते जग्मुरदितिं च शशंसिरे॥ ८/२२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50014619, "chapter_id": 11537, "verse_number": "35", "content_sanskrit": "सर्वमेतन्मयाख्यातं भवतः कुलनन्दन। उरुक्रमस्य चरितं श्रोतॄणामघमोचनम्॥ ८/२२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50014620, "chapter_id": 11537, "verse_number": "36", "content_sanskrit": "पारं महिम्न उरुविक्रमतो मुरारेर्यः पार्थिवानि विममेऽपि रजांसि मर्त्यः। किं जायमान उत जात उपैति मर्त्य इत्याह मन्त्रदृगृषिः पुरुषस्य यस्य॥ ८/२२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50014621, "chapter_id": 11537, "verse_number": "37", "content_sanskrit": "य इदं देवदेवस्य हरेरद्भुतकर्मणः। अवतारानुचरितं शृण्वन् याति परां गतिम्॥ ८/२२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50014622, "chapter_id": 11537, "verse_number": "38", "content_sanskrit": "क्रियमाणे कर्मणीदं दैवे पित्र्येऽथ मानुषे। यत्रयत्रानुकार्त्येत तत् तेषां सुकृतं विदुः॥ ८/२२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50014623, "chapter_id": 11537, "verse_number": "39", "content_sanskrit": "इति श्रीमद्भागवते अष्टमस्कन्धे द्वाविंशोऽध्यायः\\patha{प्राचीनकोशेष्वत्र एकविंशाध्यायसमाप्तिः - इति पूर्णप्रज्ञविद्यापीठस्य संशोधकः शेषगिरि आचार्यः।॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]