[{"id": 2048491, "chapter_id": 2068, "verse_number": "६-११७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2048492, "chapter_id": 2068, "verse_number": "६-११७-१", "content_sanskrit": "शिखण्डी तु रणे भीष्ममासाद्य पुरुषर्षभम् ।\nदशभिर्निशितैर्भल्लैराजघान स्तनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2048493, "chapter_id": 2068, "verse_number": "६-११७-२", "content_sanskrit": "शिखण्डिनं तु गाङ्गेयः क्रोधदीप्तेन चक्षुषा ।\nसंप्रेक्षत कटाक्षेण निर्दहन्निव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2048494, "chapter_id": 2068, "verse_number": "६-११७-३", "content_sanskrit": "स्त्रीत्वं तस्य स्मरन्राजन्सर्वलोकस्य पश्यतः।\nनाजघान रणे भीष्मः स च तन्नावबुद्धवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2048495, "chapter_id": 2068, "verse_number": "६-११७-४", "content_sanskrit": "अर्जुनस्तु महाराज शिखण्डिनमभाषत ।\nअभित्वरस्वास्य वधे शिखण्डिन्रथसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2048496, "chapter_id": 2068, "verse_number": "६-११७-५", "content_sanskrit": "किं ते विवक्षया वीर जहि भीष्मं महारथम् ।\nन ह्यन्यमनुपश्यामि कंचिद्यौधिष्ठिरे बले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2048497, "chapter_id": 2068, "verse_number": "६-११७-६", "content_sanskrit": "यः शक्तः समरे भीष्मं योधयेत पितामहम् ।\nऋते त्वां पुरुषव्याघ्र सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2048498, "chapter_id": 2068, "verse_number": "६-११७-७", "content_sanskrit": "एवमुक्तस्तु पार्थेन शिखण्डी भरतर्षभ ।\nशरैर्नानाविधैस्तूर्णं पितामहमुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2048499, "chapter_id": 2068, "verse_number": "६-११७-८", "content_sanskrit": "अचिन्तयित्वा तान्बाणान्पिता देवव्रतस्तव ।\nअर्जुनं समरे क्रुद्धं वारयामास सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2048500, "chapter_id": 2068, "verse_number": "६-११७-९", "content_sanskrit": "तथैव च चमूं सर्वां पाण्डवानां महारथः ।\nअप्रैषीत्स शरैस्तीक्ष्णैः परलोकाय मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2048501, "chapter_id": 2068, "verse_number": "६-११७-१०", "content_sanskrit": "तथैव पाण्डवा राजन्सैन्येन महता वृताः ।\nभीष्मं संछादयामासुर्मेघा इव दिवाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2048502, "chapter_id": 2068, "verse_number": "६-११७-११", "content_sanskrit": "स समन्तात्परिवृतो भीष्मो हि भरतर्षभ ।\nनिर्ददाह रणे शूरान्वने वह्निरिव ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2048503, "chapter_id": 2068, "verse_number": "६-११७-१२", "content_sanskrit": "तत्राद्भुतमपश्याम तव पुत्रस्य पौरुषम् ।\nअयोधयच्च यत्पार्थं जुगोप च पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2048504, "chapter_id": 2068, "verse_number": "६-११७-१३", "content_sanskrit": "कर्मणा तेन समरे तव पुत्रस्य धन्विनः ।\nदुःशासनस्य तुतुषुः सर्वे लोका महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2048505, "chapter_id": 2068, "verse_number": "६-११७-१४", "content_sanskrit": "यदेकः समरे पार्थान्सानुगान्समयोधयत् ।\nन चैनं पाण्डवा युद्धे वारयामासुरुल्बणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2048506, "chapter_id": 2068, "verse_number": "६-११७-१५", "content_sanskrit": "दुःशासनेन समरे रथिनो विरथीकृताः ।\nसादिनश्च महेष्वासा हस्तिनश्च महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2048507, "chapter_id": 2068, "verse_number": "६-११७-१६", "content_sanskrit": "विनिर्भिन्नाः शरैस्तीक्ष्णैर्निपेतुर्वसुधातले ।\nशरातुरास्तथैवान्ये दन्तिनो विद्रुता दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2048508, "chapter_id": 2068, "verse_number": "६-११७-१७", "content_sanskrit": "यथाग्निरिन्धनं प्राप्य ज्वलेद्दीप्तार्चिरुल्बणम् ।\nतथा जज्वाल पुत्रस्ते पाण्डुसेनां विनिर्दहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2048509, "chapter_id": 2068, "verse_number": "६-११७-१८", "content_sanskrit": "तं भारतमहामात्रं पाण्डवानां महारथः ।\nजेतुं नोत्सहते कश्चिन्नाभ्युद्यातुं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2048510, "chapter_id": 2068, "verse_number": "६-११७-१९", "content_sanskrit": "ऋते महेन्द्रतनयाच्छ्वेताश्वात्कृष्णसारथेः ।\nस हि तं समरे राजन्निर्जित्य विजयोऽर्जुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2048511, "chapter_id": 2068, "verse_number": "६-११७-२०", "content_sanskrit": "भीष्ममेवाभिदुद्राव सर्वसैन्यस्य पश्यतः ।\nविजितस्तव पुत्रोऽपि भीष्मबाहुव्यपाश्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2048512, "chapter_id": 2068, "verse_number": "६-११७-२१", "content_sanskrit": "पुनः पुनः समाश्वस्य प्रायुध्यत मदोत्कटः ।\nअर्जुनस्तु रणे राजन्योधयन्संव्यराजत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2048513, "chapter_id": 2068, "verse_number": "६-११७-२२", "content_sanskrit": "शिखण्डी तु रणे राजन्विव्याधैव पितामहम् ।\nशरैरशनिसंस्पर्शैस्तथा सर्पविषोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2048514, "chapter_id": 2068, "verse_number": "६-११७-२३", "content_sanskrit": "न च स्म ते रुजं चक्रुः पितुस्तव जनेश्वर ।\nस्मय्रमानस्तु गाङ्गेयस्तान्बाणाञ्जगृहे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2048515, "chapter_id": 2068, "verse_number": "६-११७-२४", "content_sanskrit": "उष्णार्तो हि नरो यद्वज्जलधाराः प्रतीच्छति ।\nतथा जग्राह गाङ्गेयः शरधाराः शिखण्डिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2048516, "chapter_id": 2068, "verse_number": "६-११७-२५", "content_sanskrit": "तं क्षत्रिया महाराज ददृशुर्घोरमाहवे।\nभीष्मं दहन्तं सैन्यानि पाण्डवानां महात्मनां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2048517, "chapter_id": 2068, "verse_number": "६-११७-२६", "content_sanskrit": "ततोऽब्रवीत्तव सुतः सर्वसैन्यानि मारिष ।\nअभिद्रवत संग्रामे फल्गुनं सर्वतो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2048518, "chapter_id": 2068, "verse_number": "६-११७-२७", "content_sanskrit": "भीष्मो वः समरे सर्वान्पायिष्यति धर्मवित्।\nतद्भयं सुमहत्त्यक्त्वा पाण्डवान्प्रति युध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2048519, "chapter_id": 2068, "verse_number": "६-११७-२८", "content_sanskrit": "एष तालेन महता भीष्मस्तिष्ठति पालयन्।\nसर्वेषां धार्तराष्ट्राणां समरे शर्म वर्म च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2048520, "chapter_id": 2068, "verse_number": "६-११७-२९", "content_sanskrit": "देवा अपि समुद्युक्ता नालं भीष्मं समासितुम् ।\nकिमु पार्था महात्मानं मर्त्यभूता महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2048521, "chapter_id": 2068, "verse_number": "६-११७-३०", "content_sanskrit": "तस्माद्द्रवत मा योधाः फल्गुनं प्राप्य संयुगे ।\nअहमद्य रणे यत्तो योधयिष्यामि पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2048522, "chapter_id": 2068, "verse_number": "६-११७-३१", "content_sanskrit": "सहितः सर्वतो यत्तैर्भवद्भिर्वसुधाधिपैः ।\nतच्छ्रुत्वा तु वचो राजंस्तव पुत्रस्य धन्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2048523, "chapter_id": 2068, "verse_number": "६-११७-३२", "content_sanskrit": "अर्जुनं प्रति संयत्ता बलवन्तो महाबलाः ।\nते विदेहाः कलिङ्गाश्च दासेरकगणाश्च ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2048524, "chapter_id": 2068, "verse_number": "६-११७-३३", "content_sanskrit": "अभिपेतुर्निषादाश्च सौवीराश्च महारणे ।\nबाह्लीका दरदाश्चैव प्रतीच्योदीच्यमालवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2048525, "chapter_id": 2068, "verse_number": "६-११७-३४", "content_sanskrit": "अभीषाहाः शूरसेनाः शिबयोऽथ वसातयः ।\nसाल्वः शकास्त्रिगर्ताश्च अम्बष्ठाः केकयौः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2048526, "chapter_id": 2068, "verse_number": "६-११७-३५", "content_sanskrit": "अभिपेतू रणे पार्थं पतङ्गा इव पावकम् ।\nस तान्सर्वान्सहानीकान्महाराज महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2048527, "chapter_id": 2068, "verse_number": "६-११७-३६", "content_sanskrit": "दिव्यान्यस्त्राणि संचिन्त्य प्रसंधाय धनञ्जयः ।\nस तैरस्त्रैर्महावेगैर्ददाह सुमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2048528, "chapter_id": 2068, "verse_number": "६-११७-३७", "content_sanskrit": "शरप्रतापैर्बीभत्सुः पतङ्गानिव पावकः ।\nतस्य बाणसहस्राणि सृजतो दृढधन्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2048529, "chapter_id": 2068, "verse_number": "६-११७-३८", "content_sanskrit": "दीप्यमानमिवाकाशे गाण्डीवं समदृश्यत।\nते शरार्ता महाराज विप्रकीर्णमहाध्वजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2048530, "chapter_id": 2068, "verse_number": "६-११७-३९", "content_sanskrit": "नाभ्यवर्तन्त राजानः सहिता वानरध्वजम् ।\nसध्वजा रथिनः पेतुर्हयारोहा हयैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2048531, "chapter_id": 2068, "verse_number": "६-११७-४०", "content_sanskrit": "सगजाश्च गजारोहाः किरीटिशरताडिताः ।\nततोऽर्जुनभुजोत्सृष्टैरावृताऽऽसीद्वसुंधरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2048532, "chapter_id": 2068, "verse_number": "६-११७-४१", "content_sanskrit": "विद्रुतं दिक्षु सर्वासु शरैर्बलमदृश्यत ।\nअथ पार्थो महाराज द्रावयित्वा वरूथिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2048533, "chapter_id": 2068, "verse_number": "६-११७-४२", "content_sanskrit": "दुःशासनाय सुबहून्प्रेषयामास सायकान् ।\nते तु भित्त्वा तव सुतं दुःशासनमयोमुखाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2048534, "chapter_id": 2068, "verse_number": "६-११७-४३", "content_sanskrit": "धरणीं विविशुः सर्वे वल्मीकमिव पन्नगाः ।\nहयांश्चास्य ततो जघ्ने सारथिं च न्यपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2048535, "chapter_id": 2068, "verse_number": "६-११७-४४", "content_sanskrit": "विविंशतिं च विंशत्या विरथीकृतवान्प्रभुः ।\nआजघान भृशं चैव पञ्चभिर्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2048536, "chapter_id": 2068, "verse_number": "६-११७-४५", "content_sanskrit": "कृपं विकर्णं शल्यं च विद्ध्वा बहुभिरायसैः ।\nचकार विरथांश्चैव कौन्तेयः श्वेतवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2048537, "chapter_id": 2068, "verse_number": "६-११७-४६", "content_sanskrit": "एवं ते विरथाः सर्वे कृपः शल्यश्च मारिष ।\nदुःशासनो विकर्णश्च तथैव च विविंशतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2048538, "chapter_id": 2068, "verse_number": "६-११७-४७", "content_sanskrit": "संप्राद्रवन्त समरे निर्जिताः सव्यसाचिना ।\nपूर्वाह्णे भरतश्रेष्ठ पराजित्य महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2048539, "chapter_id": 2068, "verse_number": "६-११७-४८", "content_sanskrit": "प्रजज्वाल रणे पार्थो विधूम इव पावकः ।\nतथैव शरवर्षेण भास्करो रश्मिवानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2048540, "chapter_id": 2068, "verse_number": "६-११७-४९", "content_sanskrit": "अन्यानपि महाराज तापयामास पार्थिवान् ।\nपराङ्मुखीकृत्य तथा शरवर्षैर्महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2048541, "chapter_id": 2068, "verse_number": "६-११७-५०", "content_sanskrit": "प्रावर्तयत संग्रामे शोणितोदां महानदीम् ।\nमध्येन कुरुसैन्यानां पाण्डवानां च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2048542, "chapter_id": 2068, "verse_number": "६-११७-५१", "content_sanskrit": "तस्मिन्नतिमहाभीमे राजन्वीरवरक्षये ।\nभीष्मं प्रति पराक्रान्ताः पाण्डवाः सह सृञ्जयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2048543, "chapter_id": 2068, "verse_number": "६-११७-५२", "content_sanskrit": "ते पराक्रान्तमालोक्य युधि राजन्पितामहम् ।\nन न्यवर्तन्त ते पुत्रा ब्रह्मलोकपुरस्कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2048544, "chapter_id": 2068, "verse_number": "६-११७-५३", "content_sanskrit": "इच्छन्तो निधनं युद्धे स्वर्गलोकपरायणाः ।\nपाण्डवानभ्यवर्तन्त तावका युद्धदुर्मदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2048545, "chapter_id": 2068, "verse_number": "६-११७-५४", "content_sanskrit": "पाण्डवाश्च महाराज स्मरन्तो विविधान्बहून् ।\nक्लेशान्कृतान्सपुत्रेण त्वया पूर्वं नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2048546, "chapter_id": 2068, "verse_number": "६-११७-५५", "content_sanskrit": "भयं त्यक्त्वा रणे शूराः स्वर्गलोकपुरस्कृताः।\nतावकांस्तव पुत्रांश्च योधयन्ति स्म हृष्टवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2048547, "chapter_id": 2068, "verse_number": "६-११७-५६", "content_sanskrit": "गजाश्च रथसङ्घाश्च बहुधा रथिभिर्हताः ।\nरथाश्च निहता नागैर्हयाश्चैव पदातिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2048548, "chapter_id": 2068, "verse_number": "६-११७-५७", "content_sanskrit": "अन्तरा च्छिद्यमानानि शरीराणि शिरांसि च ।\nनिपेतुर्दिक्षु सर्वासु गजाश्वरथयोधिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2048549, "chapter_id": 2068, "verse_number": "६-११७-५८", "content_sanskrit": "छन्नमायोधनं राजन्कुण्डलाङ्गदधारिभिः।\nपतितैः पात्यमानैश्च राजपुत्रैर्महारथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2048550, "chapter_id": 2068, "verse_number": "६-११७-५९", "content_sanskrit": "रथनेमिनिकृत्तैश्च गजैश्चैवावपोथितैः ।\nपादातश्चाप्यधावन्त साश्वाश्च हययोधिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2048551, "chapter_id": 2068, "verse_number": "६-११७-६०", "content_sanskrit": "गजाश्च रथयोधाश्च परिपेतुः समन्ततः ।\nविकीर्णाश्च रथा भूमौ भग्रचक्रयुगध्वजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2048552, "chapter_id": 2068, "verse_number": "६-११७-६१", "content_sanskrit": "तद्गजाश्वरथौघानां रुधिरेण समुक्षितम ।\nछन्नमायोधनं रेजे रक्ताभ्रमिव शारदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2048553, "chapter_id": 2068, "verse_number": "६-११७-६२", "content_sanskrit": "श्वानः काकाश्च गृध्राश्च वृका गोमायुभिः सह ।\nप्रणेर्दुर्भक्ष्यमासाद्य विकृताश्च सगद्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2048554, "chapter_id": 2068, "verse_number": "६-११७-६३", "content_sanskrit": "ववुर्बहुविधश्चैव दिक्षु सर्वासु मारुताः।\nदृश्यमानेषु रक्षःसु भूतेषु च नदत्सु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2048555, "chapter_id": 2068, "verse_number": "६-११७-६४", "content_sanskrit": "काञ्चनानि च दामानि पताकाश्च महाधनाः ।\nधूयमाना व्यदृश्यन्त सहसा मारुतेरिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2048556, "chapter_id": 2068, "verse_number": "६-११७-६५", "content_sanskrit": "श्वेतच्छत्रसहस्राणि सध्वजाश्च महारथाः ।\nविकीर्णाः समदृश्यन्त शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2048557, "chapter_id": 2068, "verse_number": "६-११७-६६", "content_sanskrit": "सपताकाश्च मातङ्गा दिशो जग्मुः शरातुराः।\nक्षत्रियाश्च मनुष्येन्द्र गदाशक्तिधनुर्धराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2048558, "chapter_id": 2068, "verse_number": "६-११७-६७", "content_sanskrit": "समन्ततश्च दृश्यन्ते पतिता धरणीतले । ६-११७-६७b`इषुभिस्ताड्यमानाश्च नाराचैश्च सहस्रशः।\nपेतुरार्तस्वरं कृत्वा तत्रतत्र महागजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2048559, "chapter_id": 2068, "verse_number": "६-११७-६८", "content_sanskrit": "सेनापतिस्तु समरे प्राह सेनां महारथः ।\nअभ्यद्रवत गाङ्गेयं सैनिकाः किं कृतेन वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2048560, "chapter_id": 2068, "verse_number": "६-११७-६९", "content_sanskrit": "सेनापतिवचः श्रुत्वा सोमकाः सह सृञ्जयैः ।\nअभ्यद्रवन्त गोङ्गेयं शस्त्रवृष्ट्या समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2048561, "chapter_id": 2068, "verse_number": "६-११७-७०", "content_sanskrit": "ततो भीष्मो महाराज दिव्यमस्त्रमुदीरयन् ।\nअभ्यधावत कौन्तेयं मिषतां सर्वधन्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2048562, "chapter_id": 2068, "verse_number": "६-११७-७१", "content_sanskrit": "तं शिखण्डी रणे यान्तमभ्यद्रवत दंशितः ।\nततः समाहरद्भीष्मस्तदस्त्रं पावकोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2048563, "chapter_id": 2068, "verse_number": "६-११७-७२", "content_sanskrit": "एतस्मिन्नेव काले तु कौन्तेयः श्वेतवाहनः।\nनिजघ्ने तावकं सैन्यं मोहयित्वा पितामहम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2048564, "chapter_id": 2068, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि दशमदिवसयुद्धे सप्तदशाधिकशततमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-११७-५ विवक्षया विचारेण संशयेन वा ॥ ६-११७-९ तीक्ष्णैस्तदा शरैः प्रैषीत् इति डo पाठः ॥ ६-११७-१४ उल्बणमुग्रम् ॥ ६-११७-१८ भारतमहामात्रं भरतवंशश्रेष्ठम् ॥ ६-११७-२८ शर्म सुखहेतुत्वात्। वर्म रक्षाहेतुत्वात् ॥ ६-११७-२९ समासितुं उपसर्पितुं नाशयितुं वा। मर्त्यभूताः मर्त्यस्वरूपाः ॥ ६-११७-३० तस्माद्द्रवत हे योधाः इति कo पाठः ॥ ६-११७-६३ भूतेषु प्रेतेषु ॥ ६-११७-६४ महाधनाः बहुमूल्याः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]