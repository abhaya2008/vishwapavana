[{"id": 7000828000, "chapter_id": 20828, "verse_number": "६-१७१-१", "content_sanskrit": "महादेव उवाच ।\nसंगमस्य समीपे तु सत्तीर्थं लोकविश्रुतम् ।\nआदित्याख्यं परं तस्मान्न भूतं न भविष्यति॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000828001, "chapter_id": 20828, "verse_number": "६-१७१-२", "content_sanskrit": "यस्य वै दर्शनं कार्यं स्नानं वै पुष्करेण तु ।\nपूजनं चार्कपुष्पेण करवीरैस्तथा पुनः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000828002, "chapter_id": 20828, "verse_number": "६-१७१-३", "content_sanskrit": "तत्र श्राद्धं च दानं च कुर्युर्वै मानवाः सदा ।\nइदमादित्यकं तीर्थं पवित्रं पापनाशनम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000828003, "chapter_id": 20828, "verse_number": "६-१७१-४", "content_sanskrit": "दर्शनात्पुण्यदं तीर्थं महापातकिनामपि॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]