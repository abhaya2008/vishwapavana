[{"id": 2051021, "chapter_id": 2121, "verse_number": "७-४८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2051022, "chapter_id": 2121, "verse_number": "७-४८-१", "content_sanskrit": "स कर्णं कर्णिना कर्णे पुनर्विव्याध फाल्गुनिः।\nशरैः पञ्चाशता चैनमविध्यत्कोपयन्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2051023, "chapter_id": 2121, "verse_number": "७-४८-२", "content_sanskrit": "प्रतिविव्याध राधेयस्तावद्भिरथ तं पुनः।\nशरैराचितसर्वाङ्गो बह्वशोभत भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2051024, "chapter_id": 2121, "verse_number": "७-४८-३", "content_sanskrit": "कर्णं चाप्यकरोत्क्रुद्धो रुधिरोत्पीडवाहिनम्।\nकर्णोऽपि विबभौ शूरः शरैश्छिन्नोऽसृगातप्लुः।\n`सन्धानुगतपर्यन्तः शरदीव दिवाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2051025, "chapter_id": 2121, "verse_number": "७-४८-४", "content_sanskrit": "तावुभौ शरचित्राङ्गौ रुधिरेण समुक्षितौ।\nबभूवतुर्महात्मानौ पुष्पिताविव किंशुकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2051026, "chapter_id": 2121, "verse_number": "७-४८-५", "content_sanskrit": "अथ कर्णस्य सचिवान्षट् शूरांश्चित्रयोधिनः।\nसाश्वसूतध्वजरथान्सौभद्रो निजघान ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2051027, "chapter_id": 2121, "verse_number": "७-४८-६", "content_sanskrit": "तथेतरान्महेष्वासान्दशभिर्दशभिः शरैः।\nप्रत्यविध्यदसम्भ्रान्तस्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2051028, "chapter_id": 2121, "verse_number": "७-४८-७", "content_sanskrit": "मागधस्य तथा पुत्रं हत्वा षड्भिरजिह्मगैः।\nसाश्वं ससूतं तरुणमश्वकेतुमपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2051029, "chapter_id": 2121, "verse_number": "७-४८-८", "content_sanskrit": "मार्तिकावतकं भोजं ततः कुञ्जरकेतनम्।\nक्षुरप्रेण समुन्मथ्य ननाद विसृजन्शरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2051030, "chapter_id": 2121, "verse_number": "७-४८-९", "content_sanskrit": "तस्य दौःशासनिर्विद्ध्वा चतुर्भिश्चतुरो हयान्।\nसूतमेकेन विव्याध दशभिश्चार्जुनात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2051031, "chapter_id": 2121, "verse_number": "७-४८-१०", "content_sanskrit": "ततो दौःशासनिं कार्ष्णिर्विद्ध्वा सप्तभिराशुगैः।\nसंरम्भाद्रक्तनयनो वाक्यमुच्चैरथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2051032, "chapter_id": 2121, "verse_number": "७-४८-११", "content_sanskrit": "पिता तवाहवं त्यक्त्वा गतः कापुरुषो यथा।\nदिष्ट्या त्वमपि जानीषे योद्धुं न त्वद्य मोक्ष्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2051033, "chapter_id": 2121, "verse_number": "७-४८-१२", "content_sanskrit": "एतावदुक्त्वा वचनं कर्मारपरिमार्जितम्।\nनाराचं विससर्जास्मै तं द्रौणिस्त्रिभिराच्छिनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2051034, "chapter_id": 2121, "verse_number": "७-४८-१३", "content_sanskrit": "तस्यार्जुनिर्ध्वजं छित्त्वा शल्यं त्रिभिरताडयत्।\nतं शल्यो नवभिर्बाणैर्गार्ध्रपत्रैरताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2051035, "chapter_id": 2121, "verse_number": "७-४८-१४", "content_sanskrit": "हृद्यसम्भ्रान्तवद्राजंस्तदद्भुतमिवाभवत्।\nतस्यार्जुनिर्ध्वजं छित्त्वा हत्वोभौ पार्ष्णिसारथी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2051036, "chapter_id": 2121, "verse_number": "७-४८-१५", "content_sanskrit": "तं विव्याधायसैः षड्भिः सोपाक्रामद्रथान्तरम्।\nशत्रुञ्जयं चन्द्रकेतुं मेघवेगं सुवर्चसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2051037, "chapter_id": 2121, "verse_number": "७-४८-१६", "content_sanskrit": "सूर्यभासं च पञ्चैतान्हत्वा विव्याध सौबलम्।\nतं सौबलस्त्रिभिर्विद्ध्वा दुर्योधनमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2051038, "chapter_id": 2121, "verse_number": "७-४८-१७", "content_sanskrit": "सर्व एनं विमथ्नीमः पुरैकैकं हिनस्ति नः।\nअथाब्रवीत्पुनर्द्रोणं कर्णो वैकर्तनो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2051039, "chapter_id": 2121, "verse_number": "७-४८-१८", "content_sanskrit": "पुरा सर्वान्प्रमथ्नाति ब्रूह्यस्य वधम्माशु नः।\nततो द्रोणो महेष्वासः सर्वांस्तान्प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2051040, "chapter_id": 2121, "verse_number": "७-४८-१९", "content_sanskrit": "अस्ति वाऽस्यान्तरं किञ्चित्कुमारस्याथ पश्यत।\nअन्वस्य पितरं चाद्य चरतः सर्वतो दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2051041, "chapter_id": 2121, "verse_number": "७-४८-२०", "content_sanskrit": "शीघ्रतां नरसिंहस्य पाण्डवेयस्य पश्यत।\nधनुर्मण्डलमेवास्य रथमार्गेषु दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2051042, "chapter_id": 2121, "verse_number": "७-४८-२१", "content_sanskrit": "संदधानस्य विशिखाञ्शीघ्रं चैव विमुञ्चतः।\nआरुजन्नपि मे प्राणान्मोहयन्नपि सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2051043, "chapter_id": 2121, "verse_number": "७-४८-२२", "content_sanskrit": "प्रहर्षयति मां भूयः सौभद्रः परवीरहा।\nअतिमानं दधात्येष सौभद्रो विचरन्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2051044, "chapter_id": 2121, "verse_number": "७-४८-२३", "content_sanskrit": "अन्तरं यस्य संरब्धा न पश्यन्ति महारथाः।\nअस्यतो लघुहस्तस्य दिशः सर्वा महेषुभिः।\nन विशेषं प्रपश्यामि रणे गाण्डीवधन्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2051045, "chapter_id": 2121, "verse_number": "७-४८-२४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2051046, "chapter_id": 2121, "verse_number": "७-४८-२४", "content_sanskrit": "अथ कर्णः पुनर्द्रोणमाहार्जुनिशराहतः।\nस्थातव्यमिति तिष्ठामि पीड्यमानोऽभिमन्युना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2051047, "chapter_id": 2121, "verse_number": "७-४८-२५", "content_sanskrit": "तेजस्विनः कुमारस्य शराः परमदारुणाः।\nक्षिण्वन्ति हृदयं मेऽद्य घोराः पावकतेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2051048, "chapter_id": 2121, "verse_number": "७-४८-२६", "content_sanskrit": "तमाचार्योऽब्रवीत्कर्णं शनकैः प्रहसन्निव।\nअभेद्यमस्य कवचं युवा चाशुपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2051049, "chapter_id": 2121, "verse_number": "७-४८-२७", "content_sanskrit": "उपदिष्टा मया चास्य पितुः कवचधारणा।\nतामेष निखिलां वेत्ति ध्रुवं परपुरञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2051050, "chapter_id": 2121, "verse_number": "७-४८-२८", "content_sanskrit": "शक्यं त्वस्य धनुश्छेत्तुं ज्यां च बाणैः समाहितैः।\nअभीषूंश्च हयांश्चैव तथोभौ पार्ष्णिसारथी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2051051, "chapter_id": 2121, "verse_number": "७-४८-२९", "content_sanskrit": "एतत्कुरु महेष्वास राधेय यदि शक्यते।\nअथैनं विमुखीकृत्य पश्चात्प्रहरणं कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2051052, "chapter_id": 2121, "verse_number": "७-४८-३०", "content_sanskrit": "सधनुष्को न शक्योऽयमपि जेतुं सुरासुरैः।\nविरथं विधनुष्कं च कुरुष्वैनं यदीच्छसि॥\n`पुनः स्थितेन केनापि दुःशको जेतुमार्जुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2051053, "chapter_id": 2121, "verse_number": "७-४८-३१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2051054, "chapter_id": 2121, "verse_number": "७-४८-३१", "content_sanskrit": "तदाचार्यवचः श्रुत्वा कर्णो वैकर्तनस्त्वरन्।\nअस्यतो लघुहस्तस्य पृष्ठतो धनुराच्छिनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2051055, "chapter_id": 2121, "verse_number": "७-४८-३२", "content_sanskrit": "अश्वानस्यावधीद्दोणो गौतमः पार्ष्णिसारथी।\nशेषास्तु च्छिन्नधन्वानं शरवर्षैरवाकिरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2051056, "chapter_id": 2121, "verse_number": "७-४८-३३", "content_sanskrit": "त्वरमाणास्त्वराकाले विरथं षण्महारथाः।\nशरवर्षैरकरुणा बालमेकमवाकिरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2051057, "chapter_id": 2121, "verse_number": "७-४८-३४", "content_sanskrit": "स च्छिन्नधन्वा विरथः स्वधर्ममनुपालयन्।\nखङ्गचर्मधरः श्रीमानुत्पपात विहायसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2051058, "chapter_id": 2121, "verse_number": "७-४८-३५", "content_sanskrit": "मार्गैः सकौशिकाद्यैश्च लाघवेन बलेन च।\nआर्जुनिर्व्यचरद्य्वोम्नि भृशं वै पक्षिराडिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2051059, "chapter_id": 2121, "verse_number": "७-४८-३६", "content_sanskrit": "मय्येव निपतत्येष सासिरित्यूर्ध्वदृष्टयः।\nविव्यधुस्तं महेष्वासं समरे छिद्रदर्सिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2051060, "chapter_id": 2121, "verse_number": "७-४८-३७", "content_sanskrit": "क्षुरप्रेण महातेजास्त्वरमाणः सपत्नजित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2051061, "chapter_id": 2121, "verse_number": "७-४८-३८", "content_sanskrit": "राधेयो निशितैर्बाणैर्व्यधमच्चर्म चोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2051062, "chapter_id": 2121, "verse_number": "७-४८-३९", "content_sanskrit": "व्यसिचर्मेषुपूर्णाङ्गः सोऽन्तरिक्षात्पुनः क्षितिम्।\nआस्थितश्चक्रमुद्यम्य द्रोणं क्रुद्धोऽभ्यधावत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2051063, "chapter_id": 2121, "verse_number": "७-४८-४०", "content_sanskrit": "स चक्ररेणूकज्ज्वलशोभिताङ्गो\nबभावतीवोज्ज्वलचक्रपाणिः।\nरणेऽभिमन्युः क्षणमास रौद्रः\nस वासुदेवानुकृतिं प्रकुर्वन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2051064, "chapter_id": 2121, "verse_number": "७-४८-४१", "content_sanskrit": "स्रुतरुधिरकृतैकरागवस्त्रो\nभ्रुकुटिपुटाकुलितोऽतिसिंहनादः।\nप्रभुरमितबलो रणेऽभिमन्यु--\nर्नृपवरमध्यगतो भृशं व्यराजत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2051065, "chapter_id": 2121, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि त्रयोदशदिवसयुद्धे अष्टचत्वारिंशोऽध्यायः॥ ४८ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-४८-१८ वधं वधोपायम्॥ ५-४८-१९ अण्वप्यस्यान्तरं ह्यद्य इति झ.पाठः॥ ५-४८-३५ कौशिकं सर्वतोभद्रम्॥ ५-४८-४८ अष्टचत्वारिंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]