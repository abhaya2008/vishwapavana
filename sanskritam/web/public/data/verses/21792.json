[{"id": 7001792000, "chapter_id": 21792, "verse_number": "२-५३-१", "content_sanskrit": "मोहिन्युवाच ।\nब्रूहि मे मुनिशार्दूल यत्पृच्छामि पुरातनम् ।\nयथा ताः प्रतिमाः पूर्वमिंद्रद्युम्नेन निर्मिताः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001792001, "chapter_id": 21792, "verse_number": "२-५३-२", "content_sanskrit": "केन चैव प्रकारेण तुष्टस्तस्मै स माधवः ।\nतत्सर्वं वद मे विप्र श्रोतुं कौतूहलं मम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001792002, "chapter_id": 21792, "verse_number": "२-५३-३", "content_sanskrit": "वसुरुवाच ।\nश्रृणुष्व चारुनयने पुराणं वेदसंमितम् ।\nकथयामि पुरावृत्तं प्रतिमानां च संभवम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001792003, "chapter_id": 21792, "verse_number": "२-५३-४", "content_sanskrit": "प्रवृत्ते च महायज्ञे प्रासादे चैव निर्मिते ।\nचिंता तस्य बभूवाथ प्रतिमार्थमहर्निशम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001792004, "chapter_id": 21792, "verse_number": "२-५३-५", "content_sanskrit": "केनोपायेन देवेशं सर्वलोकविभावनम् ।\nसर्गस्थित्यंतकर्त्तारं पश्यामि पुरुषोत्तमम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001792005, "chapter_id": 21792, "verse_number": "२-५३-६", "content_sanskrit": "चिंताविष्टो नरेन्द्रस्तु नैवं शेते दिवानिशम् ।\nन भुंक्ते विविधान्भोगान्न च स्नानं प्रसाधनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001792006, "chapter_id": 21792, "verse_number": "२-५३-७", "content_sanskrit": "शैलजा दारुजा वापि धातुजा वा महीतले ।\nविष्णोर्योग्यास्तु प्रतिमाः सर्वलक्षणलक्षिताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001792007, "chapter_id": 21792, "verse_number": "२-५३-८", "content_sanskrit": "एतैरेव त्रयाणां तु दयितं यत्सुरार्चिताम् ।\nस्थापिते प्रीतिमभ्येति इति चिंतापरोऽभवत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001792008, "chapter_id": 21792, "verse_number": "२-५३-९", "content_sanskrit": "पंचरात्रविधानेन संपूज्य पुरुषोत्तमम् ।\nचिंताविष्टो महीपालः संस्तोतुमुपचक्रमे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001792009, "chapter_id": 21792, "verse_number": "२-५३-१०", "content_sanskrit": "इंद्रद्युम्न उवाच ।\nवासुदेव नमस्तेऽस्तु नमस्ते मोक्षकारण ।\nत्राहि मां सर्वलोकेश जन्मसंसारसागरात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001792010, "chapter_id": 21792, "verse_number": "२-५३-११", "content_sanskrit": "निर्मलांशुकसंकाश नमस्ते पुरुषोत्तम ।\nसंकर्षण नमस्तेऽस्तु त्राहि मां धरणीधर ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001792011, "chapter_id": 21792, "verse_number": "२-५३-१२", "content_sanskrit": "नमस्ते हेमगर्भाय नमस्ते मकरध्वज ।\nरतिकांत नमस्तुभ्यं त्राहि मां शंबरांतक ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001792012, "chapter_id": 21792, "verse_number": "२-५३-१३", "content_sanskrit": "नमस्ते मेघसंकाश नमस्ते भक्तवत्सल ।\nअनिरुद्ध्‌ नमस्तेऽस्तु त्राहि मां वरदो भव ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001792013, "chapter_id": 21792, "verse_number": "२-५३-१४", "content_sanskrit": "नमस्ते विबुधावास नमस्ते विबुधप्रिय ।\nनारायण नमस्तेऽस्तु त्राहि मां शरणागतम् । ५३-१४ ।\nनमस्ते बलिनां श्रेष्ठं नमस्ते लांगलायुध ।\nनमस्ते विबुधश्रष्ठ नमस्ते कमलोद्भव ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001792014, "chapter_id": 21792, "verse_number": "२-५३-१५", "content_sanskrit": "चतुर्मुख जगद्धातस्त्राहि मां प्रपितामह ।\nनमस्ते नीलमेघाभ नमस्ते त्रिदशार्चित ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001792015, "chapter_id": 21792, "verse_number": "२-५३-१६", "content_sanskrit": "त्राहि विष्णो जगन्नाथ मग्नं मां भवसागरे ।\nप्रलयानलसंकाश नमस्ते दितिजांतक ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001792016, "chapter_id": 21792, "verse_number": "२-५३-१७", "content_sanskrit": "नरसिंह महावीर्य त्राहि मां दीप्तलोचन ।\nयथा रसातलाजाच्चोर्वी जले मग्नोद्धृता पुरा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001792017, "chapter_id": 21792, "verse_number": "२-५३-१८", "content_sanskrit": "तथा महावराह त्वं त्राहि मां दुःखसागरात् ।\nतवाङ्गमूर्तयः कृष्ण वरदाः संस्तुता मया ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001792018, "chapter_id": 21792, "verse_number": "२-५३-१९", "content_sanskrit": "त्वं चेमे बलदेवाद्याः पृथग्रूपेण संस्थिताः ।\nअंगानि तव देवेश गरुडाद्यास्तथा प्रभो ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001792019, "chapter_id": 21792, "verse_number": "२-५३-२०", "content_sanskrit": "दिक्पालाः सायुधाश्चैव वासवाद्या स्तथाच्युत ।\nये चान्ये तव देवेश भेदाः प्रोक्ता मनीषिभिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001792020, "chapter_id": 21792, "verse_number": "२-५३-२१", "content_sanskrit": "तेऽपि सर्वे जगन्नाथ प्रसन्नायतलोचन ।\nये वार्चिताः स्तुताः सर्वे तथा यूयं नमस्कृताः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001792021, "chapter_id": 21792, "verse_number": "२-५३-२२", "content_sanskrit": "प्रयच्छत वरं मह्यं धर्मकामार्थमोक्षदम् ।\nभेदास्ते कीर्तिता ये तु हरे संकर्षणादयः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001792022, "chapter_id": 21792, "verse_number": "२-५३-२३", "content_sanskrit": "तव पूजार्थसंबद्धास्ततस्त्वयि समाश्रिताः ।\nन भेदस्तव देवेश विद्यते परमार्थतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001792023, "chapter_id": 21792, "verse_number": "२-५३-२४", "content_sanskrit": "विविधं तव यद्रूपं युक्तं तदुपचारतः ।\nअद्वैतं त्वां कथं द्वेतं वक्तुं शक्नोति मानवः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001792024, "chapter_id": 21792, "verse_number": "२-५३-२५", "content_sanskrit": "एकस्त्वं हि हरे व्यापी चित्स्वभावो निरंजनः ।\nपरमं तव यद्रूपं भावाभावविवर्जितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001792025, "chapter_id": 21792, "verse_number": "२-५३-२६", "content_sanskrit": "निर्लेपं निर्मलं सूक्ष्मं कूटस्थमचलं ध्रुवम् ।\nसर्वोपाधिविनिर्मुक्तं सत्तामात्रं व्यवस्थितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001792026, "chapter_id": 21792, "verse_number": "२-५३-२७", "content_sanskrit": "तद्देवोऽपि न जानाति कथं जानाम्यहं प्रभो ।\nअपरं तव यद्रूपं पीतवस्त्रं चतुर्भुजम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001792027, "chapter_id": 21792, "verse_number": "२-५३-२८", "content_sanskrit": "शंखचक्रगदापाणिं मुकुटांगदधारिणम् ।\nश्रीवत्सवक्षसा युक्तं वनमालाविभूषितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001792028, "chapter_id": 21792, "verse_number": "२-५३-२९", "content_sanskrit": "तदर्चयंति विबुधा ये चान्ये त्वत्समाश्रयाः ।\nदेव सर्वसुरश्रेष्ठ भक्तानामभयप्रद ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001792029, "chapter_id": 21792, "verse_number": "२-५३-३०", "content_sanskrit": "त्राहि मां चारुपद्माक्ष मग्नं विषयसागरे ।\nनान्यं पश्यामि लोकेश यस्याहं शरणं व्रजे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001792030, "chapter_id": 21792, "verse_number": "२-५३-३१", "content_sanskrit": "त्वामृते कमलाकांत प्रसीद मधुसूदन ।\nजराव्याधिशतैर्युक्तो नानादुःखैर्निपीडितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001792031, "chapter_id": 21792, "verse_number": "२-५३-३२", "content_sanskrit": "हर्षशोकान्वितो मृढः कर्मपाशैः सुयंत्रितः ।\nपतितोऽहं महारौद्रे घोरे संसारसागरे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001792032, "chapter_id": 21792, "verse_number": "२-५३-३३", "content_sanskrit": "विषयोदकदुष्पारे रागद्वेषसमाकुले ।\nइंद्रियांवर्तगभीरे तृष्णाशोकोर्मिसंकुले ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001792033, "chapter_id": 21792, "verse_number": "२-५३-३४", "content_sanskrit": "निराश्रये निरालम्बे निःसारेऽत्यंतचंचले ।\nमायया मोहितस्तत्र भ्रमामि सुचिरं प्रभो ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001792034, "chapter_id": 21792, "verse_number": "२-५३-३५", "content_sanskrit": "नानाजातिसहस्रेषु जायमानः पुनः पुनः ।\nमया जन्मान्यनेकानि सहस्राण्ययुतानि च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001792035, "chapter_id": 21792, "verse_number": "२-५३-३६", "content_sanskrit": "विविधान्यनुभूतानि संसारेऽस्मिञ्जनार्दन ।\nवेदाः सांगा मयाधीताः शास्त्राणि विवधानि च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001792036, "chapter_id": 21792, "verse_number": "२-५३-३७", "content_sanskrit": "इतिहासपुराणानि तथा शिल्पान्यनेकशः ।\nअसंतोषाश्च संतोषाः संचया बहवो व्ययाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001792037, "chapter_id": 21792, "verse_number": "२-५३-३८", "content_sanskrit": "मया प्राप्ता जगन्नाथ क्षयवृद्ध्युदये तराः ।\nभार्यामित्रस्वबंधूनां वियोगाः संगमास्तथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001792038, "chapter_id": 21792, "verse_number": "२-५३-३९", "content_sanskrit": "पितरो विविधा दृष्टा मातरश्च तथा मया ।\nदुःखानि चानुभूतानि मया सौख्यान्यनेकशः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001792039, "chapter_id": 21792, "verse_number": "२-५३-४०", "content_sanskrit": "प्राप्ताश्च बांधवा स्वसृभ्रातरो ज्ञातयस्तथा ।\nमयोषितं तथा स्त्रीणां कोष्ठे विण्मूत्रपिच्छिले ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001792040, "chapter_id": 21792, "verse_number": "२-५३-४१", "content_sanskrit": "गर्भवासे महादुःखमनुभूतं तथा प्रभो ।\nदुःखानि यान्यनेकानि बाल्ये यौवनगर्विते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001792041, "chapter_id": 21792, "verse_number": "२-५३-४२", "content_sanskrit": "वार्द्धक्ये च हृषीकेश तानि प्राप्तानि वै मया ।\nमरणे यानि दुःखानि गुप्तमार्गे यमालये ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001792042, "chapter_id": 21792, "verse_number": "२-५३-४३", "content_sanskrit": "मया तान्यनुभूतानि नरके यातनाकुले ।\nक्रिमिकीटद्रुमाणां च हस्त्यश्वमृगपक्षिणाम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001792043, "chapter_id": 21792, "verse_number": "२-५३-४४", "content_sanskrit": "महिषाणां गवां चैव तथान्येषां वनौकसाम् ।\nद्विजातीनां च सर्वेषां शूद्राणां चैव योनिषु ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001792044, "chapter_id": 21792, "verse_number": "२-५३-४५", "content_sanskrit": "धनिनां क्षत्रियाणां च दरिद्राणां तपस्विनाम् ।\nनृपभृत्यानां तथान्येषां च देहिनाम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001792045, "chapter_id": 21792, "verse_number": "२-५३-४६", "content_sanskrit": "गृहे तेषां समुत्पन्नो देव चाहं पुनः पुनः ।\nगतोऽस्मि दासतां नाथ भृत्यानां बहुशो नृणाम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001792046, "chapter_id": 21792, "verse_number": "२-५३-४७", "content_sanskrit": "दरिद्रत्वं स्वामित्वं च तथा गतः ।\nहता मया हतश्चान्चैर्हतं मे घातिता मया ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001792047, "chapter_id": 21792, "verse_number": "२-५३-४८", "content_sanskrit": "दत्तं मेऽन्यैरथान्येभ्यो मया दत्तमनेकशः ।\nपितृमातृसुहृद्वर्गकलत्राणां कृतेन च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001792048, "chapter_id": 21792, "verse_number": "२-५३-४९", "content_sanskrit": "अहं हृष्टोऽसकृद्दैन्यैश्चाश्रुधौताननो गतः ।\nदेवतिर्यङ्मनुष्येषु चरेषु स्थावरेषु च ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001792049, "chapter_id": 21792, "verse_number": "२-५३-५०", "content_sanskrit": "न विद्यते च तत्स्थानं यत्राहं न गतः प्रभो ।\nकदा मे नरके वासः कदा स्वर्गे जगत्पते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001792050, "chapter_id": 21792, "verse_number": "२-५३-५१", "content_sanskrit": "कदा मनुष्यलोकेषु कदा तिर्यग्गतेषु च ।\nजलयंत्रे तथा चक्रे कदाऽवटनिबंधने ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001792051, "chapter_id": 21792, "verse_number": "२-५३-५२", "content_sanskrit": "पातितोऽधस्तथोर्द्ध्वं च कदा मध्ये स्थितस्त्वहम् ।\nतथा चाहं सुरश्रेष्ठ कर्म्मवल्लीं समाश्रितः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001792052, "chapter_id": 21792, "verse_number": "२-५३-५३", "content_sanskrit": "एवं संसारचक्रेऽस्मिन्भैरवे लोमहर्षणे ।\nभ्रमामि सुचिरं कालं नांतं पश्यामि कर्हिचित् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001792053, "chapter_id": 21792, "verse_number": "२-५३-५४", "content_sanskrit": "न जाने किं करोम्येष हरे व्याकुलितेंद्रियः ।\nशोकतृष्णाभिभूतश्च कांदिशीको विचेतनः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001792054, "chapter_id": 21792, "verse_number": "२-५३-५५", "content_sanskrit": "इदानीं त्वामहं देव विकलः शरणं गतः ।\nत्राहि मां दुःखितं कृष्ण मग्नं संसारसागरे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001792055, "chapter_id": 21792, "verse_number": "२-५३-५६", "content_sanskrit": "कृपां कुरु जगन्नाथ भक्तोऽहं यदिमन्यसे ।\nत्वामृते नास्ति मे बंधुर्योऽसौ चिंतां करिष्यति ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001792056, "chapter_id": 21792, "verse_number": "२-५३-५७", "content_sanskrit": "देव त्वां नाथमासाद्य न भयं मेऽस्ति कुत्रचित् ।\nजीविते मरण चैव योगक्षेमे तथा प्रभो ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001792057, "chapter_id": 21792, "verse_number": "२-५३-५८", "content_sanskrit": "ये तु त्वां विधिवद्देव नार्चयंति नराधमाः ।\nसुगतिस्तु कथं तेषां भवेत्संसारबंधनात् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001792058, "chapter_id": 21792, "verse_number": "२-५३-५९", "content_sanskrit": "किं तेषां कुलशीलेन विद्यया जीवितेन च ।\nयेषां न जायते भक्तिर्जगद्धातरि केशवे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001792059, "chapter_id": 21792, "verse_number": "२-५३-६०", "content_sanskrit": "प्रकृतिं त्वासुरीं प्राप्य ये त्वां निंदंति मोहिताः ।\nपतंति नरके घोरे जायमानाः पुनःपुनः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001792060, "chapter_id": 21792, "verse_number": "२-५३-६१", "content_sanskrit": "न तेषां निष्कृतिस्तस्माद्विद्यते नरकार्णवात् ।\nये दूषयंति दुर्वृत्तास्ते देव पुरुषाधमाः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001792061, "chapter_id": 21792, "verse_number": "२-५३-६२", "content_sanskrit": "यत्र यत्र भवेज्जन्म मम कर्मनिबंधनात् ।\nतत्र तत्र हरे भक्तिस्त्वयि स्तादक्षता सदा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001792062, "chapter_id": 21792, "verse_number": "२-५३-६३", "content_sanskrit": "आराध्य त्वां परं दैत्या नराश्चान्येऽपि संगताः ।\nअवापुः परमां सिद्धिं कस्त्वां देव न पूजयेत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001792063, "chapter_id": 21792, "verse_number": "२-५३-६४", "content_sanskrit": "न शक्नुवंति ब्रह्माद्याः स्तोतुं त्वां प्रकृतेः परम् ।\nयथा चाज्ञानभावेन संस्तुतोऽसि मया प्रभो ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001792064, "chapter_id": 21792, "verse_number": "२-५३-६५", "content_sanskrit": "तत्क्षमस्वापराधान्मे यदि तेऽस्ति दया मयि ।\nकृतापराधेऽपि हरे क्षमां कुर्वंति साधवः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001792065, "chapter_id": 21792, "verse_number": "२-५३-६६", "content_sanskrit": "तस्मात्प्रसीद देवेश भक्त्या स्नेहं समाश्रितः ।\nस्तुतोऽसि यन्मया देव भक्तिभावेन चेतसा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001792066, "chapter_id": 21792, "verse_number": "२-५३-६७", "content_sanskrit": "सांगं भवतु तत्सर्वं वासुदेव नमोऽस्तु ते ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]