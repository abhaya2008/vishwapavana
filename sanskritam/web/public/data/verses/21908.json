[{"id": 7001908000, "chapter_id": 21908, "verse_number": "८७-१", "content_sanskrit": "ऋषिरुवाच ।\nआज्ञप्तास्ते ततो दैत्याश्चण्डमुण्डपुरोगमाः ।\nचतुरङ्गबलोपेता ययुरभ्युद्यतायुधाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001908001, "chapter_id": 21908, "verse_number": "८७-२", "content_sanskrit": "ददृशुस्ते ततो देवीमीषद्धासां व्यवस्थिताम् ।\nसिंहस्योपरि शैलेन्द्रशृङ्गे महति काञ्चने ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001908002, "chapter_id": 21908, "verse_number": "८७-३", "content_sanskrit": "ते दृष्ट्वा तां समादातुमुद्यमं चक्रुरुद्यताः ।\nआकृष्टचापासिधरास्तथान्ये सत्समीपगाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001908003, "chapter_id": 21908, "verse_number": "८७-४", "content_sanskrit": "ततः कोपं चकारोच्चैरम्बिका तानरीन् प्रति ।\nकोपेन चास्या वदनं मषीवर्णमभूत्तदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001908004, "chapter_id": 21908, "verse_number": "८७-५", "content_sanskrit": "भ्रुकुटीकुटिलात्तस्या ललाटफलकाद् द्रुतम् ।\nकाली करालवदना विनिष्क्रान्तासिपाशिनी ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001908005, "chapter_id": 21908, "verse_number": "८७-६", "content_sanskrit": "विचित्रखट्वाङ्गधरा नरमालाविभूषणा ।\nद्वीपिचर्मपरीधाना शुष्कमांसातिभैरवा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001908006, "chapter_id": 21908, "verse_number": "८७-७", "content_sanskrit": "अतिविस्तारवदना जिह्वाललनभीषणा ।\nनिमग्नारक्तनयना नादापूरितदिङ्मुखा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001908007, "chapter_id": 21908, "verse_number": "८७-८", "content_sanskrit": "सा वेगेनाभिपतिता घतयन्ती महासुरान् ।\nसैन्ये तत्र सुरारीणामभक्षयत तद्वलम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001908008, "chapter_id": 21908, "verse_number": "८७-९", "content_sanskrit": "पार्ष्णिग्राहाङ्कुशग्राहियोधघण्टासमन्वितान् ।\nसमादायैकहस्तेन मुखे चिक्षेप वारणान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001908009, "chapter_id": 21908, "verse_number": "८७-१०", "content_sanskrit": "तथैव योधं तुरगै रथं सारथिना सह ।\nनिक्षिप्य वक्त्रे दशनैश्चर्वयन्त्यतिभैरवम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001908010, "chapter_id": 21908, "verse_number": "८७-११", "content_sanskrit": "एकं जग्राह केशेषु ग्रीवायामथ चापरम् ।\nपादेनाक्रम्य चैवान्यमुरसान्यमपोथयत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001908011, "chapter_id": 21908, "verse_number": "८७-१२", "content_sanskrit": "तैर्मुक्तानि च शस्त्रणि महास्त्राणि तथासुरैः ।\nमुखेन जग्राह रुषा दशनैर्मथितान्यपि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001908012, "chapter_id": 21908, "verse_number": "८७-१३", "content_sanskrit": "बलिनां तद्बलं सर्वमसुराणां दुरात्मनाम् ।\nममर्दाभक्षयच्चान्यानन्यांश्चाताडयत्तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001908013, "chapter_id": 21908, "verse_number": "८७-१४", "content_sanskrit": "असिना निहताः केचित्केचित्खट्वाङ्गताडिताः ।\nजग्मुर्विनाशमसुरा दन्ताग्राभिहता रणे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001908014, "chapter_id": 21908, "verse_number": "८७-१५", "content_sanskrit": "क्षणेन तन्महासैन्यमसुराणां निपातितम् ।\nदृष्ट्वा चण्डोऽभिमैर्भोमाक्षीं तां महासुरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001908015, "chapter_id": 21908, "verse_number": "८७-१६", "content_sanskrit": "शरवर्षैर्महाभीमैर्भोमाक्षीं तां महासुरः ।\nछादयामास चक्रैश्च मुण्डः क्षिप्तैः सहस्रशः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001908016, "chapter_id": 21908, "verse_number": "८७-१७", "content_sanskrit": "तानि चक्राण्यनेकानि विशमानानि तन्मुखम् ।\nबभुर्यथार्कबिम्बानि सुबहूनि घनोदरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001908017, "chapter_id": 21908, "verse_number": "८७-१८", "content_sanskrit": "ततो जहासातिरुषा भीमं भैरवनादिनी ।\nकाली करालवक्त्रान्तर्दुर्दर्शदशनोज्ज्वला ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001908018, "chapter_id": 21908, "verse_number": "८७-१९", "content_sanskrit": "उत्थाय च महासिंहं देवी चण्डमधावत ।\nगृहीत्वा चास्य केशेषु शिरस्तेनासिनाच्छिनत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001908019, "chapter_id": 21908, "verse_number": "८७-२०", "content_sanskrit": "छिन्ने शिरसि दैत्येन्द्रश्चक्रे नादं सुभैरवम् ।\nतेन नादेन महता त्रासितं भुवनत्रयम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001908020, "chapter_id": 21908, "verse_number": "८७-२१", "content_sanskrit": "अथ मुण्डोऽभ्यधावत्तां दृष्ट्वा चण्डं निपातितम् ।\nतमप्यपातयद् भूमौ सा खड्गाभिहतं रुषा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001908021, "chapter_id": 21908, "verse_number": "८७-२२", "content_sanskrit": "हतशेषं ततः सैन्यं दृष्ट्वा चण्डं निपातितम् ।\nमुण्डं च सुमहावीर्यं दिशो भेजे भयातुरम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001908022, "chapter_id": 21908, "verse_number": "८७-२३", "content_sanskrit": "शिरञ्चण्डस्य काली च गृहीत्वा मुण्डमेव च ।\nप्राह प्रचण्डाट्टहासमिश्रमभ्येत्य चण्डिकाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001908023, "chapter_id": 21908, "verse_number": "८७-२४", "content_sanskrit": "मया तवात्रोपहृतौ चण्डमुण्डौ महापशू ।\nयुद्धयज्ञे स्वयं शुम्भं निशुम्भं च हनिष्यसि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001908024, "chapter_id": 21908, "verse_number": "८७-२५", "content_sanskrit": "ऋषिरुवाच ।\nतावानीतौ ततो दृष्ट्वा चणाडमुण्डौ महासुरौ ।\nउवाच कालीं कल्याणी ललितं चण्डिका वचः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001908025, "chapter_id": 21908, "verse_number": "८७-२६", "content_sanskrit": "श्रीदेव्युवाच ।\nयस्माच्चण्डं च मुण्डं च गृहीत्वा त्वमुपागता ।\nचामुण्डेति ततो लोके ख्याता देवि भविष्यसि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]