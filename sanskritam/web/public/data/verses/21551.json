[{"id": 7001551000, "chapter_id": 21551, "verse_number": "१-४८-१", "content_sanskrit": "॥सूत उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001551001, "chapter_id": 21551, "verse_number": "१-४८-२", "content_sanskrit": "दक्षिणेनापि वर्षस्य भारतस्य निबोधत ।\nदशयोजनसाहस्रं समतीत्य महार्णवम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001551002, "chapter_id": 21551, "verse_number": "१-४८-३", "content_sanskrit": "त्रीण्येव तु सहस्राणि योजनानां समायतम् ।\nअतस्त्रिभागविस्तीर्णं नानापुष्पफलोदयम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001551003, "chapter_id": 21551, "verse_number": "१-४८-४", "content_sanskrit": "विद्युत्वन्तं महाशैलं तत्रैकं कुलपर्वतम् ।\nयेन कूटतटैर्नैकैस्तद्द्वीपं समलंकृतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001551004, "chapter_id": 21551, "verse_number": "१-४८-५", "content_sanskrit": "प्रसन्नस्वादुसलिलास्तत्र नद्यः सहस्रशः ।\nवाप्यस्तस्य तु द्वीपस्य प्रवृत्ता विमलोदकाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001551005, "chapter_id": 21551, "verse_number": "१-४८-६", "content_sanskrit": "तस्य शैलस्य छिद्रेषु विस्तीर्णेष्वायतेषु च ।\nअनेकेषु समृद्धानि नानाकाराणि सर्व्वशः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001551006, "chapter_id": 21551, "verse_number": "१-४८-७", "content_sanskrit": "नरनारीसमाढ्यानि मुदितानि महान्ति च ।\nतेषां तलप्रवेशानि सहस्राणि शतानि च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001551007, "chapter_id": 21551, "verse_number": "१-४८-८", "content_sanskrit": "पुराणि सन्निविष्टानि पर्वतान्तर्गतानि च ।\nसुसम्बद्धानि चान्योन्यमेकद्वाराणि चान्यथ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001551008, "chapter_id": 21551, "verse_number": "१-४८-९", "content_sanskrit": "दीर्घश्मश्रुधरात्मानो नीला मेघसमप्रभाः ।\nजातमात्राः प्रजास्तत्र अशीतिपरमायुषः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001551009, "chapter_id": 21551, "verse_number": "१-४८-१०", "content_sanskrit": "शाखामृगसधर्माणः फलमूलाशिनस्तथा ।\nगोधर्माणो ह्यनिर्दिष्टाः शौचाचारविवर्जिताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001551010, "chapter_id": 21551, "verse_number": "१-४८-११", "content_sanskrit": "तद्द्वीपं तादृशैः पूर्णं मनुजैः क्षुद्रमानुषैः  ।\nएवमेतेऽन्तरद्वीपा व्याख्याता आनुपूर्वशः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001551011, "chapter_id": 21551, "verse_number": "१-४८-१२", "content_sanskrit": "विंशत्र्रिंशच्च पञ्चाशत् षष्ट्यशीतिः शतं तथा ।\nसहस्रमपि चाप्युक्तं योजनानां समन्ततः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001551012, "chapter_id": 21551, "verse_number": "१-४८-१३", "content_sanskrit": "विस्तीर्णाश्चायताश्चैव नानासत्त्वसमाकुलाः ।\nबर्हिणद्वीपपर्वाणि क्षुद्रद्वीपाः सहस्रशः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001551013, "chapter_id": 21551, "verse_number": "१-४८-१४", "content_sanskrit": "जम्बूद्वीपप्रदेशात्तु षडन्ये विविधाश्रयाः ।\nअत्र द्वीपाः समाख्याता नानारत्नाकराः क्षितौ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001551014, "chapter_id": 21551, "verse_number": "१-४८-१५", "content_sanskrit": "अङ्गद्वीपं यमद्वीपं मलयद्वीपमेव च ।\nशङ्खद्वीपं कुशद्वीपं वराहद्वीपमेव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001551015, "chapter_id": 21551, "verse_number": "१-४८-१६", "content_sanskrit": "अङ्गद्वीपं निबोध त्वं नानासङ्घसमाकुलम् ।\nनानाम्लेच्छगणाकीर्णं तद्द्वीपं बहुविस्तरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001551016, "chapter_id": 21551, "verse_number": "१-४८-१७", "content_sanskrit": "हेमविद्रुमपूर्णानां रत्नानामाकरं क्षितौ ।\nनदीशैलवनैश्चित्रं सन्निभं लवणाम्भसा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001551017, "chapter_id": 21551, "verse_number": "१-४८-१८", "content_sanskrit": "तत्र चक्रगिरिर्नाम नैक निर्झरकन्दरः ।\nतत्र सा तु दरी चास्य नानासत्वसमाश्रया ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001551018, "chapter_id": 21551, "verse_number": "१-४८-१९", "content_sanskrit": "स मध्ये नागदेशस्य नैकदेशो महागिरिः ।\nकोटिभ्यां नागनिलयं प्राप्तो नदनदी पतिम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001551019, "chapter_id": 21551, "verse_number": "१-४८-२०", "content_sanskrit": "यमद्वीपमिति प्रोक्तं नानारत्नाकराचितम्  ।\nतत्रापि द्युतिमान्नाम पर्वतो धातुमण्डितः ।\nसमुद्रगानां प्रभवः प्रभवः काञ्चनस्य तु ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001551020, "chapter_id": 21551, "verse_number": "१-४८-२१", "content_sanskrit": "तथैव मलयद्वीपमेवमेव सुसंवृतम् ।\nमणिरत्नाकरं स्फीतमाकरं कनकस्य च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001551021, "chapter_id": 21551, "verse_number": "१-४८-२२", "content_sanskrit": "आकरं चन्दनानाञ्च समुद्राणां तथाकरम् ।\nनानाम्लेच्छगणाकीर्णं नदीपर्वतमण्डितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001551022, "chapter_id": 21551, "verse_number": "१-४८-२३", "content_sanskrit": "तत्र श्रीमांस्तु मलयः पर्वतो रजताकरः ।\nमहामलय इत्येवं विख्यातो वरपर्वतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001551023, "chapter_id": 21551, "verse_number": "१-४८-२४", "content_sanskrit": "द्वितीयं मन्दरं नाम प्रथितञ्च सदा क्षितौ ।\nआगस्त्यभवनं तत्र देवासुरनमस्कृतम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001551024, "chapter_id": 21551, "verse_number": "१-४८-२५", "content_sanskrit": "तथा काञ्चनपादस्य मलयस्यापरस्य हि ।\nनिकुञ्जैस्तृणसोमाङ्गैराश्रमं पुण्यसेवितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001551025, "chapter_id": 21551, "verse_number": "१-४८-२६", "content_sanskrit": "नानापुष्पफलोपेतं स्वर्गादपि विशिष्यते ।\nतत्रावतरते स्वर्गः सदा पर्वसु पर्वसु ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001551026, "chapter_id": 21551, "verse_number": "१-४८-२७", "content_sanskrit": "तथा त्रिकूटनिलये नानाधातुविभूषिते  ।\nअनेकयोजनोत्सेधे चित्रसानुदरीगृहे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001551027, "chapter_id": 21551, "verse_number": "१-४८-२८", "content_sanskrit": "तस्य कूटतटे रम्ये हेमप्राकारतोरणा ।\nनिर्यूहवलभीचित्रा हर्म्यप्रासादमालिनी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001551028, "chapter_id": 21551, "verse_number": "१-४८-२९", "content_sanskrit": "शतयोजनविस्तीर्णा त्रिंशदायामयोजना ।\nनित्यप्रमुदिता स्फीता लङ्का नाम महापुरी ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001551029, "chapter_id": 21551, "verse_number": "१-४८-३०", "content_sanskrit": "सा कामरूपिणां स्थानं राक्षसानां महात्मनाम्  ।\nआवासो बलदृप्तानां तद्विद्याद्देवविद्विषाम् ।\nमानुषाणामसम्बाधा ह्यगम्या सा महापुरी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001551030, "chapter_id": 21551, "verse_number": "१-४८-३१", "content_sanskrit": "तस्य द्वीपस्य वै पूर्वे तीरे नदनदीपतेः ।\nगोकर्णनामधेयस्य शङ्करस्यालयं महत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001551031, "chapter_id": 21551, "verse_number": "१-४८-३२", "content_sanskrit": "तथैकराज्यं विज्ञेयं शङ्खद्वीपसमास्थितम् ।\nशतयोजनविस्तीर्णं नानाम्लेच्छगणालयम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001551032, "chapter_id": 21551, "verse_number": "१-४८-३३", "content_sanskrit": "तत्र शङ्खगिरिर्नाम धौतशङ्खदलप्रभः ।\nनानारत्नाकरः पुण्यः पुण्यकृद्भिर्निषेवितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001551033, "chapter_id": 21551, "verse_number": "१-४८-३४", "content_sanskrit": "शङ्ख नागा महापुण्या यस्मात् प्रभवते नदी ।\nयत्र शङ्खमुखो नाम नागराजः कृतालयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001551034, "chapter_id": 21551, "verse_number": "१-४८-३५", "content_sanskrit": "तथैव कुमुदद्वीपं नानापुण्योपशोभितम् ।\nनानाग्रामसमा कीर्णं नानारत्नाकरं शिवम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001551035, "chapter_id": 21551, "verse_number": "१-४८-३६", "content_sanskrit": "कुमुदाख्या महाभागा दुष्टचित्तनिबर्हणी ।\nमहादेवस्य भगिनी प्रभाभिस्ताभिरिज्यते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001551036, "chapter_id": 21551, "verse_number": "१-४८-३७", "content_sanskrit": "तथा वराहद्वीपे च नानाम्लेच्छगणाकुले ।\nनानाजालिसमाकीर्णे नानाधिष्ठानपत्तने ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001551037, "chapter_id": 21551, "verse_number": "१-४८-३८", "content_sanskrit": "धनधान्ययुते स्फीते धर्म्मिष्ठजनसङ्कुले ।\nनदीशैलवनैश्चित्रैर्बहुपुष्पफलोपगैः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001551038, "chapter_id": 21551, "verse_number": "१-४८-३९", "content_sanskrit": "वराहपर्व्वतो नाम तत्र रम्यः शिलोच्चयः ।\nअनेककन्दरदरीगुहानिर्झरशोभितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001551039, "chapter_id": 21551, "verse_number": "१-४८-४०", "content_sanskrit": "तस्मात्सुरसपानीया पुण्यतीर्थतरङ्गिणी ।\nवाराही नाम वरदा प्रवृत्तास्य महानदी ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001551040, "chapter_id": 21551, "verse_number": "१-४८-४१", "content_sanskrit": "वाराहरूपिणे तत्र विष्णवे प्रभविष्णवे ।\nअनन्यदेवतास्तस्मै नमस्कुर्वन्ति विप्रजाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001551041, "chapter_id": 21551, "verse_number": "१-४८-४२", "content_sanskrit": "एवं षडेते कथिता अनुद्वीपाः समन्ततः ।\nभारतद्वीपदेशो वै दक्षिणे बहुविस्तरः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001551042, "chapter_id": 21551, "verse_number": "१-४८-४३", "content_sanskrit": "एवमेकमिदं वर्षं बहुद्वीपमिहोच्यते ।\nसमुद्रजलसम्बिन्नं खण्डं खण्डीकृतं स्मृतम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001551043, "chapter_id": 21551, "verse_number": "१-४८-४४", "content_sanskrit": "एवञ्चतुर्महाद्वीपः सान्तरद्वीपमण्डितः ।\nसानुद्वीपः समाख्यातो जम्बूद्वीपस्य विस्तरः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001551044, "chapter_id": 21551, "verse_number": "१-४८-४५", "content_sanskrit": "इति महापुराणे वायुप्रोक्ते भुवनविन्यासो नामाष्टचत्वारिंशो ध्यायः ॥ ४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]