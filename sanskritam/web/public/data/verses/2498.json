[{"id": 2071123, "chapter_id": 2498, "verse_number": "१२-३-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071124, "chapter_id": 2498, "verse_number": "१२-३-१", "content_sanskrit": "कर्णस्य बाहुवीर्येण प्रश्रयेण दमेन च।\nतुतोष भृगुशार्दूलो गुरुशुश्रूषया तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071125, "chapter_id": 2498, "verse_number": "१२-३-२", "content_sanskrit": "ततस्तस्मै महातेजा ब्रह्मास्त्रं सनिवर्तनम्।\nप्रोवाच सुमहाप्रज्ञः स तपस्वी तपस्विने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071126, "chapter_id": 2498, "verse_number": "१२-३-३", "content_sanskrit": "विदितास्त्रस्ततः कर्णो रममाणोऽऽश्रमे भृगोः।\nचकार वै धनुर्वेदे यत्नमद्भुतविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071127, "chapter_id": 2498, "verse_number": "१२-३-४", "content_sanskrit": "ततः कदाचिद्रामस्तु चरन्नाश्रममन्तिकात्।\nकर्णेन सहितो धीमानुपवासेन कर्शितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071128, "chapter_id": 2498, "verse_number": "१२-३-५", "content_sanskrit": "सुष्वाप जामदग्न्यस्तु विस्रम्भोत्पन्नसौहृदः।\nतस्योत्सङ्गे समाधाय शिरः क्लान्तमना गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071129, "chapter_id": 2498, "verse_number": "१२-३-६", "content_sanskrit": "अथ क्रिमिः श्लेष्ममयो मांसशोणितभोजनः।\nदारुणो दारुणाकारः कर्णस्याभ्याशमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071130, "chapter_id": 2498, "verse_number": "१२-३-७", "content_sanskrit": "स तस्योरुमथासाद्य बिभेद रुधिराशनः।\nन चैनमशकत्क्षेप्तुं वक्तुं वाऽपि गुरोर्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071131, "chapter_id": 2498, "verse_number": "१२-३-८", "content_sanskrit": "स दश्यमानोऽपि तथा कृमिणा तेन भारत।\nगुरोः प्रबोधनाकाङ्क्षी तमुपैक्षत सूर्यजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071132, "chapter_id": 2498, "verse_number": "१२-३-९", "content_sanskrit": "कर्णस्तु वेदनां धैर्यादसह्यां विनिगृह्य ताम्।\nअकम्पयन्नव्यथयन्धारयामास भार्गवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071133, "chapter_id": 2498, "verse_number": "१२-३-१०", "content_sanskrit": "यदा स रुधिरेणाङ्गे परिस्पृष्टोऽभवद्गुरुः।\nतदाऽबुध्यत तेजस्वी संरब्धश्चैनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071134, "chapter_id": 2498, "verse_number": "१२-३-११", "content_sanskrit": "अहोऽस्म्यशुचितां प्राप्तः किमिदं च कृतं त्वया।\nकथयस्व भयं त्यक्त्वा याथातथ्यमिदं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071135, "chapter_id": 2498, "verse_number": "१२-३-१२", "content_sanskrit": "तस्य कर्णस्तदाचष्ट कृमिणा परिभक्षणम्।\nददर्श रामस्तं चापि कृमिं सूकरसंस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071136, "chapter_id": 2498, "verse_number": "१२-३-१३", "content_sanskrit": "अष्टपादं तीक्ष्णदंष्ट्रं सूचीभिः परिसंवृतम्।\nरोमभिः सन्निरुद्धाङ्गमलर्कं नाम नामतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071137, "chapter_id": 2498, "verse_number": "१२-३-१४", "content_sanskrit": "स दृष्टमात्रो रामेण किमिः प्राणानवासृजत्।\nतस्मिन्नेवासृजि क्लिन्नस्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071138, "chapter_id": 2498, "verse_number": "१२-३-१५", "content_sanskrit": "ततोऽन्तरिक्षे ददृशे विश्वरूपः करालवान्।\nराक्षसो लोहितग्रीवः कृष्णाङ्गो मेघवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071139, "chapter_id": 2498, "verse_number": "१२-३-१६", "content_sanskrit": "स रामं प्राञ्जलिर्भूत्वा बभाषे पूर्णमानसः।\nस्वस्ति ते भृगुशार्दूल गमिष्येऽहं यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071140, "chapter_id": 2498, "verse_number": "१२-३-१७", "content_sanskrit": "मोक्षितो नरकादस्माद्भवता मुनिसत्तम।\nभद्रं च तेऽस्तु सिद्धिश्च प्रियं मे भवता कृतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071141, "chapter_id": 2498, "verse_number": "१२-३-१८", "content_sanskrit": "तमुवाच महाबाहुर्जामदग्न्यः प्रतापवान्।\nकस्त्वं कस्माच्च नरकं प्रतिपन्नो ब्रवीहि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071142, "chapter_id": 2498, "verse_number": "१२-३-१९", "content_sanskrit": "सोऽब्रवीदहमासं प्राग्दंशो नाम महासुरः।\nपुरा देवयुगे तात भृगोस्तु सवया इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071143, "chapter_id": 2498, "verse_number": "१२-३-२०", "content_sanskrit": "सोऽहं भृगोः सुदयितां भार्यामपहरं बलात्।\nमहर्षेरभिशापेन क्रिमिभूतोऽपतं भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071144, "chapter_id": 2498, "verse_number": "१२-३-२१", "content_sanskrit": "अब्रवीद्धि स मां क्रुद्धस्तव पूर्वपितामहः।\nमूत्र श्लेष्माशनः पाय निरयं प्रतिपत्स्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071145, "chapter_id": 2498, "verse_number": "१२-३-२२", "content_sanskrit": "शापस्यान्तो भवेद्ब्रह्मन्नित्येवं तमथाब्रवम्।\nभविता भार्गवाद्रामादिंति मामब्रवीद्भृगुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2071146, "chapter_id": 2498, "verse_number": "१२-३-२३", "content_sanskrit": "सोऽहमेनां गतिं प्राप्तो यथा नकुशलस्तथा।\nत्वया साधो समागम्य विमुक्तः पापयोनितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2071147, "chapter_id": 2498, "verse_number": "१२-३-२४", "content_sanskrit": "एवमुक्त्वा नमस्कृत्य ययौ रामं महासुरः।\nरामः कर्णं तु सक्रोधमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2071148, "chapter_id": 2498, "verse_number": "१२-३-२५", "content_sanskrit": "अतिदुःखमिदं मूढ न जातु ब्राह्मणः सहेत्।\nक्षत्रियस्येव ते धैर्यं कामया सत्यमुच्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2071149, "chapter_id": 2498, "verse_number": "१२-३-२६", "content_sanskrit": "तमुवाच ततः कर्णः शापाद्भीतः प्रसादयन्।\nब्रह्मक्षत्रान्तरे जातं सूतं मां विद्धि भार्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2071150, "chapter_id": 2498, "verse_number": "१२-३-२७", "content_sanskrit": "राधेयः कर्ण इति मां प्रवदन्ति जना भुवि।\nप्रसादं कुरु मे ब्रह्मन्नस्त्रलुब्धस्य भार्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2071151, "chapter_id": 2498, "verse_number": "१२-३-२८", "content_sanskrit": "पिता गुरुर्न संदेहो वेदविद्याप्रदः प्रभुः।\nअतो भार्गव इत्युक्तं मया गोत्रं तवान्तिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2071152, "chapter_id": 2498, "verse_number": "१२-३-२९", "content_sanskrit": "तमुवाच भृगुश्रेष्ठः सरोपः प्रदहन्निव।\nभूमौ निपतितं दीनं वेपमानं कृताञ्जलिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2071153, "chapter_id": 2498, "verse_number": "१२-३-३०", "content_sanskrit": "यस्मान्मिथ्याविचीर्णोऽहमस्त्रलोभादिह त्वया।\nतस्मादेतन्न ते मूढ ब्रह्मास्त्रं प्रतिभास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2071154, "chapter_id": 2498, "verse_number": "१२-३-३१", "content_sanskrit": "अन्यत्र वधकालात्ते सदृशे न समीयुपः।\nअब्राह्मणे न हि ब्रह्म चिरं तिष्ठेत्कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2071155, "chapter_id": 2498, "verse_number": "१२-३-३२", "content_sanskrit": "गच्छेदानीं न ते स्थानमनृतस्येह विद्यते।\nन त्वया सदृशो युद्धे भविता क्षत्रियो भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2071156, "chapter_id": 2498, "verse_number": "१२-३-३३", "content_sanskrit": "एवमुक्तः स रामेण न्यायेनोपजगामह।\nदुर्योधनमुपागम्य कृतास्त्रोऽस्मीति चाब्रवीत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2071157, "chapter_id": 2498, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि तृतीयोऽध्यायः॥ ३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]