[{"id": 5000508000, "chapter_id": 9508, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000508001, "chapter_id": 9508, "verse_number": "६-१०१-१", "content_sanskrit": "शक्त्या निपातितं दृष्ट्वा रावणेन बलीयसा।\nलक्ष्मणं समरे शूरं शोणितौघपरिप्लुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000508002, "chapter_id": 9508, "verse_number": "६-१०१-२", "content_sanskrit": "स दत्त्वा तुमुलं युद्धं रावणस्य दुरात्मनः।\nविसृजन्नेव बाणौघान् सुषेणमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000508003, "chapter_id": 9508, "verse_number": "६-१०१-३", "content_sanskrit": "एष रावणवीर्येण लक्ष्मणः पतितो भुवि।\nसर्पवच्चेष्टते वीरो मम शोकमुदीरयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000508004, "chapter_id": 9508, "verse_number": "६-१०१-४", "content_sanskrit": "शोणितार्द्रमिमं वीरं प्राणैः प्रियतरं मम।\nपश्यतो मम का शक्तिर्योद‍्धुं पर्याकुलात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000508005, "chapter_id": 9508, "verse_number": "६-१०१-५", "content_sanskrit": "अयं स समरश्लाघी भ्राता मे शुभलक्षणः।\nयदि पञ्चत्वमापन्नः प्राणैर्मे किं सुखेन वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000508006, "chapter_id": 9508, "verse_number": "६-१०१-६", "content_sanskrit": "लज्जतीव हि मे वीर्यं भ्रश्यतीव कराद् धनुः।\nसायका व्यवसीदन्ति दृष्टिर्बाष्पवशं गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000508007, "chapter_id": 9508, "verse_number": "६-१०१-७", "content_sanskrit": "अवसीदन्ति गात्राणि स्वप्नयाने नृणामिव।\nचिन्ता मे वर्धते तीव्रा मुमूर्षापि च जायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000508008, "chapter_id": 9508, "verse_number": "६-१०१-८", "content_sanskrit": "भ्रातरं निहतं दृष्ट्वा रावणेन दुरात्मना।\nविष्टनन्तं तु दुःखार्तं मर्मण्यभिहतं भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000508009, "chapter_id": 9508, "verse_number": "६-१०१-९", "content_sanskrit": "राघवो भ्रातरं दृष्ट्वा प्रियं प्राणं बहिश्चरम्।\nदुःखेन महताविष्टो ध्यानशोकपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000508010, "chapter_id": 9508, "verse_number": "६-१०१-१०", "content_sanskrit": "परं विषादमापन्नो विललापाकुलेन्द्रियः।\nभ्रातरं निहतं दृष्ट्वा लक्ष्मणं रणपांसुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000508011, "chapter_id": 9508, "verse_number": "६-१०१-११", "content_sanskrit": "विजयोऽपि हि मे शूर न प्रियायोपकल्पते।\nअचक्षुर्विषयश्चन्द्रः कां प्रीतिं जनयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000508012, "chapter_id": 9508, "verse_number": "६-१०१-१२", "content_sanskrit": "किं मे युद्धेन किं प्राणैर्युद्धकार्यं न विद्यते।\nयत्रायं निहतः शेते रणमूर्धनि लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000508013, "chapter_id": 9508, "verse_number": "६-१०१-१३", "content_sanskrit": "यथैव मां वनं यान्तमनुयाति महाद्युतिः।\nअहमप्यनुयास्यामि तथैवैनं यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000508014, "chapter_id": 9508, "verse_number": "६-१०१-१४", "content_sanskrit": "इष्टबन्धुजनो नित्यं मां स नित्यमनुव्रतः।\nइमामवस्थां गमितो राक्षसैः कूटयोधिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000508015, "chapter_id": 9508, "verse_number": "६-१०१-१५", "content_sanskrit": "देशे देशे कलत्राणि देशे देशे च बान्धवाः।\nतं तु देशं न पश्यामि यत्र भ्राता सहोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000508016, "chapter_id": 9508, "verse_number": "६-१०१-१६", "content_sanskrit": "किं नु राज्येन दुर्धर्षलक्ष्मणेन विना मम।\nकथं वक्ष्याम्यहं त्वम्बां सुमित्रां पुत्रवत्सलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000508017, "chapter_id": 9508, "verse_number": "६-१०१-१७", "content_sanskrit": "उपालम्भं न शक्ष्यामि सोढुं दत्तं सुमित्रया।\nकिं नु वक्ष्यामि कौसल्यां मातरं किं नु कैकयीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000508018, "chapter_id": 9508, "verse_number": "६-१०१-१८", "content_sanskrit": "भरतं किं नु वक्ष्यामि शत्रुघ्नं च महाबलम्।\nसह तेन वनं यातो विना तेनागतः कथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000508019, "chapter_id": 9508, "verse_number": "६-१०१-१९", "content_sanskrit": "इहैव मरणं श्रेयो न तु बन्धुविगर्हणम्।\nकिं मया दुष्कृतं कर्म कृतमन्यत्र जन्मनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000508020, "chapter_id": 9508, "verse_number": "६-१०१-२०", "content_sanskrit": "येन मे धार्मिको भ्राता निहतश्चाग्रतः स्थितः।\nहा भ्रातर्मनुजश्रेष्ठ शूराणां प्रवर प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000508021, "chapter_id": 9508, "verse_number": "६-१०१-२१", "content_sanskrit": "एकाकी किं नु मां त्यक्त्वा परलोकाय गच्छसि।\nविलपन्तं च मां भ्रातः किमर्थं नावभाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000508022, "chapter_id": 9508, "verse_number": "६-१०१-२२", "content_sanskrit": "उत्तिष्ठ पश्य किं शेषे दीनं मां पश्य चक्षुषा।\nशोकार्तस्य प्रमत्तस्य पर्वतेषु वनेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000508023, "chapter_id": 9508, "verse_number": "६-१०१-२३", "content_sanskrit": "विषण्णस्य महाबाहो समाश्वासयिता मम।\nराममेवं ब्रुवाणं तु शोकव्याकुलितेन्द्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000508024, "chapter_id": 9508, "verse_number": "६-१०१-२४", "content_sanskrit": "आश्वासयन्नुवाचेदं सुषेणः परमं वचः।\nत्यजेमां नरशार्दूल बुद्धिं वैक्लव्यकारिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000508025, "chapter_id": 9508, "verse_number": "६-१०१-२५", "content_sanskrit": "शोकसंजननीं चिन्तां तुल्यां बाणैश्चमूमुखे।\nनैव पञ्चत्वमापन्नो लक्ष्मणो लक्ष्मिवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000508026, "chapter_id": 9508, "verse_number": "६-१०१-२६", "content_sanskrit": "नह्यस्य विकृतं वक्त्रं न च श्यामत्वमागतम्।\nसुप्रभं च प्रसन्नं च मुखमस्य निरीक्ष्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000508027, "chapter_id": 9508, "verse_number": "६-१०१-२७", "content_sanskrit": "पद्मपत्रतलौ हस्तौ सुप्रसन्ने च लोचने।\nनेदृशं दृश्यते रूपं गतासूनां विशां पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000508028, "chapter_id": 9508, "verse_number": "६-१०१-२८", "content_sanskrit": "विषादं मा कृथा वीर सप्राणोऽयमरिंदम।\nआख्याति तु प्रसुप्तस्य स्रस्तगात्रस्य भूतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000508029, "chapter_id": 9508, "verse_number": "६-१०१-२९", "content_sanskrit": "सोच्छ्वासं हृदयं वीर कम्पमानं मुहुर्मुहुः।\nएवमुक्त्वा महाप्राज्ञः सुषेणो राघवं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000508030, "chapter_id": 9508, "verse_number": "६-१०१-३०", "content_sanskrit": "समीपस्थमुवाचेदं हनूमन्तं महाकपिम्।\nसौम्य शीघ्रमितो गत्वा पर्वतं हि महोदयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000508031, "chapter_id": 9508, "verse_number": "६-१०१-३१", "content_sanskrit": "पूर्वं तु कथितो योऽसौ वीर जाम्बवता तव।\nदक्षिणे शिखरे जातां महौषधिमिहानय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000508032, "chapter_id": 9508, "verse_number": "६-१०१-३२", "content_sanskrit": "विशल्यकरणीं नाम्ना सावर्ण्यकरणीं तथा।\nसंजीवकरणीं वीर संधानीं च महौषधीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000508033, "chapter_id": 9508, "verse_number": "६-१०१-३३", "content_sanskrit": "संजीवनार्थं वीरस्य लक्ष्मणस्य त्वमानय।\nइत्येवमुक्तो हनुमान् गत्वा चौषधिपर्वतम्।\nचिन्तामभ्यगमच्छ्रीमानजानंस्ता महौषधीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000508034, "chapter_id": 9508, "verse_number": "६-१०१-३४", "content_sanskrit": "तस्य बुद्धिः समुत्पन्ना मारुतेरमितौजसः।\nइदमेव गमिष्यामि गृहीत्वा शिखरं गिरेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000508035, "chapter_id": 9508, "verse_number": "६-१०१-३५", "content_sanskrit": "अस्मिंस्तु शिखरे जातामोषधीं तां सुखावहाम्।\nप्रतर्केणावगच्छामि सुषेणो ह्येवमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000508036, "chapter_id": 9508, "verse_number": "६-१०१-३६", "content_sanskrit": "अगृह्य यदि गच्छामि विशल्यकरणीमहम्।\nकालात्ययेन दोषः स्याद् वैक्लव्यं च महद्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000508037, "chapter_id": 9508, "verse_number": "६-१०१-३७", "content_sanskrit": "इति संचिन्त्य हनुमान् गत्वा क्षिप्रं महाबलः।\nआसाद्य पर्वतश्रेष्ठं त्रिः प्रकम्प्य गिरेः शिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000508038, "chapter_id": 9508, "verse_number": "६-१०१-३८", "content_sanskrit": "फुल्लनानातरुगणं समुत्पाट्य महाबलः।\nगृहीत्वा हरिशार्दूलो हस्ताभ्यां समतोलयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000508039, "chapter_id": 9508, "verse_number": "६-१०१-३९", "content_sanskrit": "स नीलमिव जीमूतं तोयपूर्णं नभस्तलात्।\nउत्पपात गृहीत्वा तु हनूमान् शिखरं गिरेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000508040, "chapter_id": 9508, "verse_number": "६-१०१-४०", "content_sanskrit": "समागम्य महावेगः संन्यस्य शिखरं गिरेः।\nविश्रम्य किंचिद्धनुमान् सुषेणमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000508041, "chapter_id": 9508, "verse_number": "६-१०१-४१", "content_sanskrit": "औषधीर्नावगच्छामि ता अहं हरिपुङ्गव।\nतदिदं शिखरं कृत्स्नं गिरेस्तस्याहृतं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000508042, "chapter_id": 9508, "verse_number": "६-१०१-४२", "content_sanskrit": "एवं कथयमानं तु प्रशस्य पवनात्मजम्।\nसुषेणो वानरश्रेष्ठो जग्राहोत्पाट्य चौषधीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000508043, "chapter_id": 9508, "verse_number": "६-१०१-४३", "content_sanskrit": "विस्मितास्तु बभूवुस्ते सर्वे वानरपुङ्गवाः।\nदृष्ट्वा तु हनुमत्कर्म सुरैरपि सुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000508044, "chapter_id": 9508, "verse_number": "६-१०१-४४", "content_sanskrit": "ततः संक्षोदयित्वा तामोषधीं वानरोत्तमः।\nलक्ष्मणस्य ददौ नस्तः सुषेणः सुमहाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000508045, "chapter_id": 9508, "verse_number": "६-१०१-४५", "content_sanskrit": "सशल्यः स समाघ्राय लक्ष्मणः परवीरहा।\nविशल्यो विरुजः शीघ्रमुदतिष्ठन्महीतलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000508046, "chapter_id": 9508, "verse_number": "६-१०१-४६", "content_sanskrit": "तमुत्थितं तु हरयो भूतलात् प्रेक्ष्य लक्ष्मणम्।\nसाधुसाध्विति सुप्रीता लक्ष्मणं प्रत्यपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000508047, "chapter_id": 9508, "verse_number": "६-१०१-४७", "content_sanskrit": "एह्येहीत्यब्रवीद् रामो लक्ष्मणं परवीरहा।\nसस्वजे गाढमालिङ्गय बाष्पपर्याकुलेक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000508048, "chapter_id": 9508, "verse_number": "६-१०१-४८", "content_sanskrit": "अब्रवीच्च परिष्वज्य सौमित्रिं राघवस्तदा।\nदिष्ट्या त्वां वीर पश्यामि मरणात् पुनरागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000508049, "chapter_id": 9508, "verse_number": "६-१०१-४९", "content_sanskrit": "नहि मे जीवितेनार्थः सीतया च जयेन वा।\nको हि मे जीवितेनार्थस्त्वयि पञ्चत्वमागते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000508050, "chapter_id": 9508, "verse_number": "६-१०१-५०", "content_sanskrit": "इत्येवं ब्रुवतस्तस्य राघवस्य महात्मनः।\nखिन्नः शिथिलया वाचा लक्ष्मणो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000508051, "chapter_id": 9508, "verse_number": "६-१०१-५१", "content_sanskrit": "तां प्रतिज्ञां प्रतिज्ञाय पुरा सत्यपराक्रम।\nलघुः कश्चिदिवासत्त्वो नैवं त्वं वक्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000508052, "chapter_id": 9508, "verse_number": "६-१०१-५२", "content_sanskrit": "नहि प्रतिज्ञां कुर्वन्ति वितथां सत्यवादिनः।\nलक्षणं हि महत्त्वस्य प्रतिज्ञापरिपालनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000508053, "chapter_id": 9508, "verse_number": "६-१०१-५३", "content_sanskrit": "नैराश्यमुपगन्तुं च नालं ते मत्कृतेऽनघ।\nवधेन रावणस्याद्य प्रतिज्ञामनुपालय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000508054, "chapter_id": 9508, "verse_number": "६-१०१-५४", "content_sanskrit": "न जीवन् यास्यते शत्रुस्तव बाणपथं गतः।\nनर्दतस्तीक्ष्णदंष्ट्रस्य सिंहस्येव महागजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000508055, "chapter_id": 9508, "verse_number": "६-१०१-५५", "content_sanskrit": "अहं तु वधमच्छामि शीघ्रमस्य दुरात्मनः।\nयावदस्तं न यात्येष कृतकर्मा दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000508056, "chapter_id": 9508, "verse_number": "६-१०१-५६", "content_sanskrit": "यदि वधमिच्छसि रावणस्य संख्ये\nयदि च कृतां हि तवेच्छसि प्रतिज्ञाम्।\nयदि तव राजसुताभिलाष आर्य\nकुरु च वचो मम शीघ्रमद्य वीर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000508057, "chapter_id": 9508, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे एकाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]