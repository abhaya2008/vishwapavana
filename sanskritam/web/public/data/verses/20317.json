[{"id": 7000317000, "chapter_id": 20317, "verse_number": "१-७१-१", "content_sanskrit": "व्यास उवाच ।\nअथान्यो नमुचिः क्रुद्धः स्यंदनस्थो दिवौकसः ।\nविशिखैरर्दयामस घोरैराशीविषोपमैः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000317001, "chapter_id": 20317, "verse_number": "१-७१-२", "content_sanskrit": "ततस्तु संयुगे देवाः सिद्धकिन्नरपन्नगाः ।\nन शक्नुवंति बाणानां वेगं सोढुं समंततः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000317002, "chapter_id": 20317, "verse_number": "१-७१-३", "content_sanskrit": "रथमुच्चैश्श्रवोश्वेन युक्तं मातलिनेरितम् ।\nपुरुहूतः समास्थाय प्रागमत्तं महाबलम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000317003, "chapter_id": 20317, "verse_number": "१-७१-४", "content_sanskrit": "दृष्ट्वा शक्रं महावीर्यं नमुचिर्दैत्यपुंगवः ।\nअब्रवीद्वासवं संख्ये वचनं सानुगं तदा॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000317004, "chapter_id": 20317, "verse_number": "१-७१-५", "content_sanskrit": "प्राकृतं निर्जरं हत्वा न यशोस्ति न च प्रियम् ।\nन लाभकृतकं वापि न जयस्तु पुरष्टुत॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000317005, "chapter_id": 20317, "verse_number": "१-७१-६", "content_sanskrit": "तस्मात्वयि हतेत्रैव सर्वं भवति शाश्वतम् ।\nदेवराज्यं प्रलप्स्यामि सुखं भोग्यं सुरालये॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000317006, "chapter_id": 20317, "verse_number": "१-७१-७", "content_sanskrit": "तमब्रवीन्महातेजाः शक्रः परपुरंजयः ।\nशूरता वाक्यमात्रेण सर्वत्र सुलभा भवेत्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000317007, "chapter_id": 20317, "verse_number": "१-७१-८", "content_sanskrit": "महापराक्रमं यद्वा अस्ति ते दानवाधम ।\nदर्शयस्वाहवे वीर्यं पुरं नेष्यामि भास्करेः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000317008, "chapter_id": 20317, "verse_number": "१-७१-९", "content_sanskrit": "एतच्छ्रुत्वा महातेजाश्चुकोप दैत्यपुंगवः ।\nपंचभिर्निशितैर्बाणैर्जघान सुरसत्तमम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000317009, "chapter_id": 20317, "verse_number": "१-७१-१०", "content_sanskrit": "तांस्तु चिच्छेद मघवा क्षुरप्रैः पंचभिर्द्रुतम् ।\nजग्मतुस्तौ महावीर्यौ समरे विषयैषिणौ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000317010, "chapter_id": 20317, "verse_number": "१-७१-११", "content_sanskrit": "अन्योन्यं सहसा वेगाच्छरैश्चिच्छिदतुः शरान् ।\nबिभिदातेथ गात्राणि विशिखैर्भिदुरोपमैः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000317011, "chapter_id": 20317, "verse_number": "१-७१-१२", "content_sanskrit": "अत्यपूर्वं कृतं कर्म ताभ्यामेव रणे भृशम् ।\nलाघवं शरसंधान ग्रहमोक्षं सुदुर्लभम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000317012, "chapter_id": 20317, "verse_number": "१-७१-१३", "content_sanskrit": "दृष्ट्वा तु विस्मयं जग्मुर्देवासुरगणास्तदा ।\nएतस्मिन्नंतरे दैत्यो मायास्संप्रमुमोच ह॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000317013, "chapter_id": 20317, "verse_number": "१-७१-१४", "content_sanskrit": "विशिखाः शतशस्तत्र विनिश्चेरुस्समंततः ।\nशक्रः कोपात्पुनः शीघ्रं धनुरुद्यम्य वीर्यवान्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000317014, "chapter_id": 20317, "verse_number": "१-७१-१५", "content_sanskrit": "जघान विशिखैरुग्रैः सर्वगात्रेषु संज्वलन् ।\nततो मार्गणसाहस्रैरष्टभिस्त्वधिकं तथा॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000317015, "chapter_id": 20317, "verse_number": "१-७१-१६", "content_sanskrit": "बिभिदाते ततोन्योन्यं चिच्छिदाते परस्परम् ।\nशरैर्निरंतराकाशं ददृशुस्तत्र संयुगे॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000317016, "chapter_id": 20317, "verse_number": "१-७१-१७", "content_sanskrit": "निपतंति धरापृष्ठे खड्गपातैः सहस्रशः ।\nएवं सुदीर्घकाले तु गते तस्मिन्महाहवे॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000317017, "chapter_id": 20317, "verse_number": "१-७१-१८", "content_sanskrit": "मायास्त्रं दर्शयामास क्रूरकृन्नमुचिस्तदा ।\nतामसं त्रिषुलोकेषु कृतं स्यात्तु निरंतरम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000317018, "chapter_id": 20317, "verse_number": "१-७१-१९", "content_sanskrit": "परस्परं न पश्यंति देवासुरगणा भृशम् ।\nसूर्यचंद्रग्रहाणां च वह्नीनां च दिवौकसाम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000317019, "chapter_id": 20317, "verse_number": "१-७१-२०", "content_sanskrit": "तस्मिंस्तमसि दुष्पारे गभस्तिर्नैव दृश्यते ।\nदैत्यस्य च ततस्तूर्णं शरैरग्निशिखोपमैः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000317020, "chapter_id": 20317, "verse_number": "१-७१-२१", "content_sanskrit": "विभग्नाः सर्वदेवाश्च शक्रश्चरणसंमुखे ।\nशरैर्विभिन्नदेहास्तु निपेतुर्धरणीतले॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000317021, "chapter_id": 20317, "verse_number": "१-७१-२२", "content_sanskrit": "प्रभग्नाश्चापरे शूरास्संयांति च दिशो दश ।\nकूटं तस्य परिज्ञाय सर्वदेवार्चितो हरिः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000317022, "chapter_id": 20317, "verse_number": "१-७१-२३", "content_sanskrit": "सौम्यमस्त्रं मुमोचाथ दिवि सूर्यशतप्रभम् ।\nविलंबितं समालोक्य शक्त्या च बहुघंटया॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000317023, "chapter_id": 20317, "verse_number": "१-७१-२४", "content_sanskrit": "जघानोरसि दैत्यस्य स पपात व्यथान्वितः ।\nचिरात्संलभ्य संज्ञां च दैतेयः क्रोधमूर्च्छितः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000317024, "chapter_id": 20317, "verse_number": "१-७१-२५", "content_sanskrit": "गत्वा वेगात्सुरश्रेष्ठमैरावतं दधार ह ।\nत्रासयामास सुतरामिंद्रस्य द्विरदं रुषा॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000317025, "chapter_id": 20317, "verse_number": "१-७१-२६", "content_sanskrit": "धृत्वा स तु गजं सेंद्रं मुमोच धरणीतले ।\nततो भूमिगतः शक्रः कश्मलं च क्षणं गतः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000317026, "chapter_id": 20317, "verse_number": "१-७१-२७", "content_sanskrit": "अवप्लुत्य स दैत्येंद्रो गजदंतांतरस्थितः ।\nशक्रं ग्रहीतुकामस्य वधार्थं यूथपस्य सः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000317027, "chapter_id": 20317, "verse_number": "१-७१-२८", "content_sanskrit": "असिनाऽसुरमुख्यस्य शिरश्छित्वा न्यपातयत् ।\nसर्वे प्रजहृषुर्देवा गंधर्वा ललितं जगुः ।\nमुदितास्ते च मुनयः स्तुवंति सुरसत्तमम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]