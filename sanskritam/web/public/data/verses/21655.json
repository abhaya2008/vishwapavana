[{"id": 7001655000, "chapter_id": 21655, "verse_number": "१-४१-१", "content_sanskrit": "नारद उवाच ।\nआख्यातं भवता सर्वं मुने तत्त्वार्थ कोविद ।\nइदानीं श्रोतुमिच्छामि युगानां स्थितिलक्षणम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001655001, "chapter_id": 21655, "verse_number": "१-४१-२", "content_sanskrit": "सनक उवाच ।\nसाधु साधु महाप्राज्ञ मुने लोकोपकारक ।\nयुगधर्मान्प्रबक्ष्यामि सर्वलोकोपकारकान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001655002, "chapter_id": 21655, "verse_number": "१-४१-३", "content_sanskrit": "धर्मो विवृद्धिमायाति काले कस्मिंस्चिदुत्तम ।\nतथा विनासमायाति धर्म्म एव महीतले ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001655003, "chapter_id": 21655, "verse_number": "१-४१-४", "content_sanskrit": "कृतं त्रेता द्वापरं च कलिश्चेति चतुर्युगम् ।\nदिव्यैर्द्वादशभिर्ज्ञेयं वत्सरैस्तत्र सत्तम ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001655004, "chapter_id": 21655, "verse_number": "१-४१-५", "content_sanskrit": "संध्यासन्ध्यांशयुक्तानि युगानि सदृशानि वै ।\nकालतो वेदितव्यानि इत्युक्तं तत्त्वादर्शिभिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001655005, "chapter_id": 21655, "verse_number": "१-४१-६", "content_sanskrit": "आद्ये कृतयुगं प्राहुस्ततस्त्रेताविधानकम् ।\nततश्च द्वापरं प्राहुः कलिमंत्यं विदुः क्रमात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001655006, "chapter_id": 21655, "verse_number": "१-४१-७", "content_sanskrit": "देवदानवगंधर्वा यक्षराक्षसपन्नगाः ।\nनासन्कृतयुगे विप्र सर्वे देवसमाः स्मृताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001655007, "chapter_id": 21655, "verse_number": "१-४१-८", "content_sanskrit": "सर्वे हृष्टाश्च धर्मिष्टा न तत्र क्रयविक्रयौ ।\nवेदानां च विभागश्च न युगे कृतसंज्ञके ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001655008, "chapter_id": 21655, "verse_number": "१-४१-९", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्राः स्वाचारतत्पराः ।\nसदा नारायणपरास्तपोध्यानपरायणाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001655009, "chapter_id": 21655, "verse_number": "१-४१-१०", "content_sanskrit": "कामादिदोषनिर्मुक्ताः शमादिगुणतत्पराः ।\nधर्मसाधनचित्ताश्च गतासूया अदांभिकाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001655010, "chapter_id": 21655, "verse_number": "१-४१-११", "content_sanskrit": "सत्यवाक्यरताः सर्वे चतुराश्रमधर्मिणः ।\nवेदाध्ययनसंपन्नाः सर्वशास्त्रविचक्षणाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001655011, "chapter_id": 21655, "verse_number": "१-४१-१२", "content_sanskrit": "चतुराश्रमयुक्तेन कर्मणा कालयोनिना ।\nअकामफलसंयोगाः प्रयांति परमां गतिम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001655012, "chapter_id": 21655, "verse_number": "१-४१-१३", "content_sanskrit": "नारायणः कृतयुगे शुक्लवर्णः सुनिर्मलः ।\nत्रेताधर्मान्प्रवक्ष्यामि श्रृणुष्व सुसमाहितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001655013, "chapter_id": 21655, "verse_number": "१-४१-१४", "content_sanskrit": "धर्मः पांडुरतां याति त्रेतायां मुनिसत्तम ।\nहरिस्तु रक्तातां याति किंचित्क्लेशान्विता जनाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001655014, "chapter_id": 21655, "verse_number": "१-४१-१५", "content_sanskrit": "क्रियायोगरताः सर्वे यज्ञकर्मसु निष्टिताः ।\nसत्यव्रता ध्यानपराः सदाध्यानपरायणाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001655015, "chapter_id": 21655, "verse_number": "१-४१-१६", "content_sanskrit": "द्विपादो वर्तते धर्मो द्वापरे च मुनीश्वर ।\nहरिः पीतत्वमायाति वेदश्चापि विभज्यते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001655016, "chapter_id": 21655, "verse_number": "१-४१-१७", "content_sanskrit": "असत्यनिरताश्चापि केचित्तत्र द्विजोत्तमाः ।\nब्राह्मणाद्याश्च वर्णाः स्युः केचिद्रागादिदुर्गुणाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001655017, "chapter_id": 21655, "verse_number": "१-४१-१८", "content_sanskrit": "केचित्स्वर्गापवर्गार्थं विप्रयज्ञान्प्रकुर्वते ।\nकेचिद्धनादिकामाश्च केचित्कल्मषचेतसः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001655018, "chapter_id": 21655, "verse_number": "१-४१-१९", "content_sanskrit": "धर्माधर्मौ समौ स्यातां द्वापरे विप्रसत्तम ।\nअधर्मस्य प्रभावेण क्षीयंते च प्रजास्तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001655019, "chapter_id": 21655, "verse_number": "१-४१-२०", "content_sanskrit": "अल्पायुषो भविष्यंति केचिञ्चापि मुनीश्वर ।\nकेचित्पुण्यरतान् दृष्ट्वा असूयां विप्र कुर्वते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001655020, "chapter_id": 21655, "verse_number": "१-४१-२१", "content_sanskrit": "कलिस्थितिं प्रवक्ष्यामि तच्छृणुष्व समाहितः ।\nधर्मः कलियुगे प्राप्ते पादेनैकेन वर्तते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001655021, "chapter_id": 21655, "verse_number": "१-४१-२२", "content_sanskrit": "तामसं युगमासाद्य हरिः कृष्णत्वमेति च ।\nयः कश्चिदपि धर्मात्मा यज्ञाचारान्करोति च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001655022, "chapter_id": 21655, "verse_number": "१-४१-२३", "content_sanskrit": "यः कश्चिदपि पुण्यात्मा क्रियायोगरतो भवेत् ।\nनरं धर्मरतं दृष्ट्वा सर्वेऽसूयां प्रकुर्वते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001655023, "chapter_id": 21655, "verse_number": "१-४१-२४", "content_sanskrit": "व्रताचाराः प्रणश्यंति ज्ञानयज्ञादयस्तथा ।\nउपद्रवा भविष्यंति ह्यधर्मस्य प्रवतनात् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001655024, "chapter_id": 21655, "verse_number": "१-४१-२५", "content_sanskrit": "असूयानिरताः सर्वे दंभाचारपरायणाः ।\nप्रजाश्चाल्पायुषः सर्वा भविष्यंति कलौ युगे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001655025, "chapter_id": 21655, "verse_number": "१-४१-२६", "content_sanskrit": "नारद उवाच ।\nयुगधर्माः समाख्यातास्त्वया संक्षेपतो मुने ।\nकलिं विस्तरतो ब्रूहि त्वं हि धर्मविदां वरः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001655026, "chapter_id": 21655, "verse_number": "१-४१-२७", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्चमुनिसत्तम ।\nकिमाहाराः किमाचाराः भविष्यंति कलौ युगे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001655027, "chapter_id": 21655, "verse_number": "१-४१-२८", "content_sanskrit": "सनक उवाच ।\nश्रृणुष्व मुनिशार्दूल सर्वलोकोपकारक ।\nकलिधर्मान्प्रवक्ष्यामि विस्तरेण यथातथम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001655028, "chapter_id": 21655, "verse_number": "१-४१-२९", "content_sanskrit": "सर्वे धर्मा विनश्यंति कृष्णे कृष्णत्वमागते ।\nतस्मात्कलिर्महाघोरः सर्वपातकसंकरः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001655029, "chapter_id": 21655, "verse_number": "१-४१-३०", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्रा धर्मपराङ्मुखाः ।\nघोरे कलियुगे प्राप्ते द्विजा वेदपराङ्मुखाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001655030, "chapter_id": 21655, "verse_number": "१-४१-३१", "content_sanskrit": "व्याजधर्मरताः सर्वे असूयानिरतास्तथा ।\nवृथाहंकारदुष्टाश्च सत्यहीनाश्च पंडिताः ४१-३१ ।\nअहमेवाधिक इति सर्वेऽपि विवदंति च ।\nअधर्मलोलुपाः सर्वे तथा वैतंहिका नराः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001655031, "chapter_id": 21655, "verse_number": "१-४१-३२", "content_sanskrit": "अतः स्वल्पायुषः सर्वे भविष्यंति कलौ युगे ।\nअल्पायुष्ट्वान्मनुष्याणां न विद्याग्रहणं द्विज ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001655032, "chapter_id": 21655, "verse_number": "१-४१-३३", "content_sanskrit": "विद्याग्रहणशून्यत्वादधर्मो वर्तते पुनः ।\nयुत्क्रमेण प्रजाः सर्वा म्रियंते पापतत्पराः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001655033, "chapter_id": 21655, "verse_number": "१-४१-३४", "content_sanskrit": "ब्राह्मणाद्यास्तथा वर्णाः संकीर्यंते परस्परम् ।\nकामक्रोधपरा मूढा वृथासंतापपीडिताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001655034, "chapter_id": 21655, "verse_number": "१-४१-३५", "content_sanskrit": "शूद्रतुल्या भविष्यंति सर्वे वर्णा कलौ युगे ।\nउत्तमा नीचतां यांति नीचाश्चोत्तमतां तथा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001655035, "chapter_id": 21655, "verse_number": "१-४१-३६", "content_sanskrit": "राजनो द्रव्यनिरतास्तथा ह्यन्यायवर्त्तिनः ।\nपीडयंति प्रजाश्चैव करैरत्यर्थयोजितैः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001655036, "chapter_id": 21655, "verse_number": "१-४१-३७", "content_sanskrit": "शववाहाभविष्यंति शूद्राणां च द्विजातयः ।\nधर्मस्त्रीष्वपि गच्छंति पतयो जारधर्मिणः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001655037, "chapter_id": 21655, "verse_number": "१-४१-३८", "content_sanskrit": "द्विषंति पितरं पुत्रा भर्तारं च स्त्रियोऽखिलाः ।\nपरिस्त्रीनिरतः सर्वे परद्रव्यपरायणाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001655038, "chapter_id": 21655, "verse_number": "१-४१-३९", "content_sanskrit": "मत्स्यामिषेण जीवंति दुहंतश्चाप्यजीविकाम् ।\nघोरे कलियुगे विप्र सर्वे पापरता जनाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001655039, "chapter_id": 21655, "verse_number": "१-४१-४०", "content_sanskrit": "सतामसूयानिरतां उपहासं प्रकुर्वते ।\nसरित्तीरेषु कुद्दालैर्वापयिष्यंति चौषधीः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001655040, "chapter_id": 21655, "verse_number": "१-४१-४१", "content_sanskrit": "पृथ्वी निष्फलतां याति बीजं पुष्पं विनश्यति ।\nवेश्यालावंयशीलेषु स्पृहा कुर्वंति योषितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001655041, "chapter_id": 21655, "verse_number": "१-४१-४२", "content_sanskrit": "धर्मविक्रयिणो विप्राः स्त्रियश्च भगविक्रयाः ।\nवेदविक्रयकाश्चान्ये शूद्राचाररता द्विजाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001655042, "chapter_id": 21655, "verse_number": "१-४१-४३", "content_sanskrit": "साधूनां विधवानां च वित्तान्यपहरंति च ।\nन व्रतानि चरिष्यन्ति ब्राह्मणा द्रव्यलोलुपाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001655043, "chapter_id": 21655, "verse_number": "१-४१-४४", "content_sanskrit": "धर्माचारं परित्यज्य वृथावादैर्विषज्जिताः ।\nद्विजाः कुर्वंति दंभार्थं पितृश्राद्धादिकाः क्रियाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001655044, "chapter_id": 21655, "verse_number": "१-४१-४५", "content_sanskrit": "अपात्रेष्वेव दानानि प्रयच्छंति नराधमाः ।\nदुग्धलोभनिमित्तेन गोषु प्रीतिं च कुर्वते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001655045, "chapter_id": 21655, "verse_number": "१-४१-४६", "content_sanskrit": "न कुर्वंति तथा विप्राः स्नानशौचादिकाः क्रियाः ।\nअपात्रेष्वेव दानानि प्रयच्छंति नराधमाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001655046, "chapter_id": 21655, "verse_number": "१-४१-४७", "content_sanskrit": "साधुनिंदापराश्चैव विप्रनिंदापरास्तथा ।\nन कस्यापि मनो विप्र विष्णुभक्तिपरं भवेत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001655047, "chapter_id": 21655, "verse_number": "१-४१-४८", "content_sanskrit": "यज्विनश्च द्विजानैव धनार्थराजकिंकराः ।\nताडयंति द्विजान्दुष्टाः कृष्णे कृष्णत्वमागते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001655048, "chapter_id": 21655, "verse_number": "१-४१-४९", "content_sanskrit": "दानहीना नराः सर्वे घोरे कलियुगे मुने ।\nप्रतिग्रहं प्रकुर्वंति पतितानामपि द्विजाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001655049, "chapter_id": 21655, "verse_number": "१-४१-५०", "content_sanskrit": "कलेः प्रथमपादेऽपि विंनिंदंति हरिं नराः ।\nयुगान्ते च हरेर्नाम नैवकश्चिद्वदिष्यति ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001655050, "chapter_id": 21655, "verse_number": "१-४१-५१", "content_sanskrit": "शूद्रस्त्रीसंगनिरता विधवासंगलोलुपाः ।\nशूद्रान्नभोगनिरता भविष्यंति कलौ द्विजाः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001655051, "chapter_id": 21655, "verse_number": "१-४१-५२", "content_sanskrit": "विहाय वेदसन्मार्गं कुपथाचारसंगताः ।\nपाषंडाश्चभविशष्यंतिचतुराश्रमनिंदकाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001655052, "chapter_id": 21655, "verse_number": "१-४१-५३", "content_sanskrit": "न चद्विजा तिशुश्रूषां कुर्वंति चरणोद्भवाः ।\nद्विजातिधर्मान्गृह्णन्ति पाखण्डलिङ्गिनोऽधमाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001655053, "chapter_id": 21655, "verse_number": "१-४१-५४", "content_sanskrit": "काषायपरिवीताश्च जटिला भस्मधूलिताः ।\nशूद्राधर्मान्प्रवक्ष्यंती कूटयुक्तपरायणाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001655054, "chapter_id": 21655, "verse_number": "१-४१-५५", "content_sanskrit": "द्विजाःस्वाचारमुत्स्सृज्यचपरपाकान्नभोजिनः ।\nभविष्यंतिदुरात्मानः शूद्राः प्रव्रजितास्तथा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001655055, "chapter_id": 21655, "verse_number": "१-४१-५६", "content_sanskrit": "उत्कोचजीविनस्तत्र भविष्यंति कलौ मुने ।\nधर्मटीनास्तु पाषंडा कापाला भिक्षवोऽधमाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001655056, "chapter_id": 21655, "verse_number": "१-४१-५७", "content_sanskrit": "धर्मविध्वंसशीलानां द्विजानां द्विजसत्तम ।\nशूद्रा धर्मान्प्रवक्ष्यंतिह्यधिरुह्योत्तमासनम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001655057, "chapter_id": 21655, "verse_number": "१-४१-५८", "content_sanskrit": "एते चान्येच बहवो नग्नरक्तपटादिकाः ।\nपाषंडाः प्रचारिष्यंति प्रायो वेदविदूषकाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001655058, "chapter_id": 21655, "verse_number": "१-४१-५९", "content_sanskrit": "गीतवादित्रकुशलाः क्षुद्रधर्मसमाश्रयाः ।\nभविष्यंतिकलौ प्रायो धर्मविध्वंसका नराः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001655059, "chapter_id": 21655, "verse_number": "१-४१-६०", "content_sanskrit": "अल्पद्रव्या वृथालिंगा वृथाहंकारदूषिताः ।\nहर्तारं परवित्तानां भवितारो नराधमाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001655060, "chapter_id": 21655, "verse_number": "१-४१-६१", "content_sanskrit": "प्रतिग्रहपरा नित्यं जगदुन्मार्गशीलिनः ।\nआत्मस्तुतिपराः सर्वे परनिंदापरास्तथा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001655061, "chapter_id": 21655, "verse_number": "१-४१-६२", "content_sanskrit": "विश्वस्तघातिनः क्रूरा दयाधर्मविवर्जिताः ।\nभविष्यंति नरा विप्र कलौ चाधर्मबांधवाः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001655062, "chapter_id": 21655, "verse_number": "१-४१-६३", "content_sanskrit": "परमायुश्च भविता तदा वर्षाणि षोडश ।\nघोरे कलियुगे विप्र पंचवर्षा प्रसूयते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001655063, "chapter_id": 21655, "verse_number": "१-४१-६४", "content_sanskrit": "सप्तवर्षाष्टवर्षाश्च युवानोऽतः परे जरा ।\nस्वकर्मत्यागिनः सर्वे कृतघ्नाभिन्नवृत्तयः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001655064, "chapter_id": 21655, "verse_number": "१-४१-६५", "content_sanskrit": "याचकाश्चद्विजा नित्यं भविष्यंति कलौ युगे ।\nपरावमाननिरताः प्रहृष्टाः परवेश्मनि ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001655065, "chapter_id": 21655, "verse_number": "१-४१-६६", "content_sanskrit": "तत्रैव निंदानिरता वृथाविश्रंभिणो जनाः ।\nनिदां कुर्वंति सततं पितृमातृसुतेषु च ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001655066, "chapter_id": 21655, "verse_number": "१-४१-६७", "content_sanskrit": "वदंति वाचा धर्मांश्च चेतसा पापलोलुपाः ।\nधनविद्यावयोमत्ताः सर्वदुःखपरायणाः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001655067, "chapter_id": 21655, "verse_number": "१-४१-६८", "content_sanskrit": "व्याधितस्करदुर्भिक्षैः पीडिता अतिमांयिनः ।\nप्रपुष्यंति वृथैवामी न विचार्य च दुष्कृतम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001655068, "chapter_id": 21655, "verse_number": "१-४१-६९", "content_sanskrit": "धर्ममार्गप्रणेतारं तिरस्कुर्वंति पापिनः ।\nधर्मकार्ये रतं चैव वृथाविश्रंभिणो जनाः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001655069, "chapter_id": 21655, "verse_number": "१-४१-७०", "content_sanskrit": "भविष्यंति कलौ प्राप्ते राजानो म्लेच्छजातयः ।\nशूद्रा भैक्ष्यरताश्चैव तेषां शुश्रूषणे द्विजाः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001655070, "chapter_id": 21655, "verse_number": "१-४१-७१", "content_sanskrit": "न शिष्यो न गुरुः कश्चिन्न पुत्रो न पिता तथा ।\nन भार्या न पतिश्चैव भवितारोऽत्र संकरे ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001655071, "chapter_id": 21655, "verse_number": "१-४१-७२", "content_sanskrit": "कलौ गते भविष्यंति धनाढ्या अपि याचकाः ।\nरस विक्रयिणश्चापि भविष्यंति द्विजातयः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001655072, "chapter_id": 21655, "verse_number": "१-४१-७३", "content_sanskrit": "धर्मकंचुकसंवीता मुनिवेषधरा द्विजाः ।\nअपण्यविक्रयरता अगम्यागामिनस्तथा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001655073, "chapter_id": 21655, "verse_number": "१-४१-७४", "content_sanskrit": "वेदनिंदापराश्चैव धर्मशास्त्रविनिंदुकाः ।\nशूद्रवृत्त्यैव जीवंति नरकार्हा द्विजा मुने ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001655074, "chapter_id": 21655, "verse_number": "१-४१-७५", "content_sanskrit": "अनावृष्टभयं प्राप्ता गगनासक्तदृष्टयः ।\nभविष्यंति कलौ मर्त्यासर्वे क्षुद्भयकातराः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001655075, "chapter_id": 21655, "verse_number": "१-४१-७६", "content_sanskrit": "कंदपर्णफलाहारास्तापंसा इव मानवाः ।\nआत्मानं तारयिष्यंति अनावृष्ट्यातिदुखिताः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001655076, "chapter_id": 21655, "verse_number": "१-४१-७७", "content_sanskrit": "कामार्ता ह्रस्वदेहाश्च लुब्धा श्चाधर्मतत्पराः ।\nकलौ सर्वे भविष्यंति स्वल्पभाग्या बहुप्रजाः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001655077, "chapter_id": 21655, "verse_number": "१-४१-७८", "content_sanskrit": "स्त्रियः स्वपोषणपरा वेश्या लावण्यशीलिकाः ।\nपतिवाक्यमनादृत्य सदान्यगृहतत्पराः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001655078, "chapter_id": 21655, "verse_number": "१-४१-७९", "content_sanskrit": "दुःशीला दुष्टशीलेषु करिष्यिंति सदा स्पृहाम् ।\nअसद्वृत्ता भविष्यंति पुरुषेषु कुलांगनाः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001655079, "chapter_id": 21655, "verse_number": "१-४१-८०", "content_sanskrit": "चौरादिभयभीताश्च काष्टयंत्राणि कुर्वते ।\nदुर्भिक्षकरपीडाभिरतीवोपद्रुता जनाः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001655080, "chapter_id": 21655, "verse_number": "१-४१-८१", "content_sanskrit": "गोधूमान्नयवान्नाढ्ये देशे यास्यंति दुःखिताः ।\nनिधाय हृद्यकर्मणि प्रेरयंति वचः शुभम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001655081, "chapter_id": 21655, "verse_number": "१-४१-८२", "content_sanskrit": "स्वकार्यसिद्धिपर्यंतं बंधुतां कुर्वते जनाः ।\nभिक्षवश्चाव मित्रादिस्नेहसंबंधयंत्रिताः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001655082, "chapter_id": 21655, "verse_number": "१-४१-८३", "content_sanskrit": "अन्नोपाधिनिमित्तेन शिष्यान्गृह्णंति भिक्षवः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001655083, "chapter_id": 21655, "verse_number": "१-४१-८४", "content_sanskrit": "उभाभ्यामथ पाणिभ्यां शिरःकंडूयनं स्त्रियः ।\nकुर्वंत्यो गुरुभर्तॄणामाज्ञामुल्लंघयंति च ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001655084, "chapter_id": 21655, "verse_number": "१-४१-८५", "content_sanskrit": "पाषंडालापनिरताः पाषंडजनसंगिनः ।\nयदा द्विजा भविष्यंति तदा वृद्धिं कलिर्व्रजेत् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001655085, "chapter_id": 21655, "verse_number": "१-४१-८६", "content_sanskrit": "यदा प्रजा न यक्ष्यंति न होष्यंति द्विजातयः ।\nतदैव तु कलेर्वृद्धिरनुमेया विचक्षणैः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001655086, "chapter_id": 21655, "verse_number": "१-४१-८७", "content_sanskrit": "अधर्मवृद्धिर्भविता बासमृत्युरपि द्विजा ।\nसर्वधर्मेषु नष्टेषु याति निःश्रीकतां जगत् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001655087, "chapter_id": 21655, "verse_number": "१-४१-८८", "content_sanskrit": "एवं कलेः स्वरूपं ते कथितं विप्रसत्तम ।\nहरिभक्तिपरानेष न कलिर्बाधते क्वचित् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001655088, "chapter_id": 21655, "verse_number": "१-४१-८९", "content_sanskrit": "ततः परं कृतयुगे त्रेतायुगे त्रेतायां ध्यानमेव च ।\nद्वापरे यज्ञमेवाहुर्दानमेकं कलौ युगे ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001655089, "chapter_id": 21655, "verse_number": "१-४१-९०", "content_sanskrit": "यत्कृते दशभिर्वर्षैस्त्रेतायां शरदा च यत् ।\nद्वापरे यञ्च मासेन ह्यहोरात्रेण तत्कलौ ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001655090, "chapter_id": 21655, "verse_number": "१-४१-९१", "content_sanskrit": "ध्यायन्कृते जयन्यज्ञैस्त्रेतायां द्वापरेऽर्चयन् ।\nयदाप्नोति तदाप्नोति कलौ संकीर्त्य केशवम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001655091, "chapter_id": 21655, "verse_number": "१-४१-९२", "content_sanskrit": "अहोरात्रं हरेर्नाम कीर्तयंति च ये नराः ।\nकुर्वंति हरिपूजां वा न कलिर्बाधते च तान् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001655092, "chapter_id": 21655, "verse_number": "१-४१-९३", "content_sanskrit": "नमो नारायणायेति कीर्तयंति च ये नराः ।\nनिष्कामा वा सकामा वा न कलिर्बाधते च तान् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001655093, "chapter_id": 21655, "verse_number": "१-४१-९४", "content_sanskrit": "हरिनामपरा ये तु घोरे कलियुगे द्विज ।\nत एव कृतकृत्याश्च न कलिर्बाधते हि तान् ॥९५ ॥.", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001655094, "chapter_id": 21655, "verse_number": "१-४१-९५", "content_sanskrit": "हरिपूजापरा ये च हरिनामपरायणाः ।\n&nbsp;त एव शिवतुल्याश्च नात्र कार्या विचारणा ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001655095, "chapter_id": 21655, "verse_number": "१-४१-९६", "content_sanskrit": "समस्तजगदाधारं परमार्थस्वरुपिणम् ।\nघोरे कलियुगे प्राप्ते विष्णुं ध्यायन्न सीदति ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001655096, "chapter_id": 21655, "verse_number": "१-४१-९७", "content_sanskrit": "अहो अति सुभाग्यास्ते सकृद्वै केशवार्चकाः ।\nघोरें कलियुगे प्राप्ते सर्वधर्मविवर्जिते ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001655097, "chapter_id": 21655, "verse_number": "१-४१-९८", "content_sanskrit": "न्यूनातिरिक्तदोषाणां कलौ वेदोक्तकर्मणाम् ।\nहरिस्मरणमेवात्र संपूर्णत्वविधायकम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001655098, "chapter_id": 21655, "verse_number": "१-४१-९९", "content_sanskrit": "हरे केशव गोविंद वासुदेव जगन्मय ।\nइतीरयंति ये नित्यं नहि तान्बाधते कलिः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001655099, "chapter_id": 21655, "verse_number": "१-४१-१००", "content_sanskrit": "शिव शंकर रुद्रेश नीलकंठ त्रिलोचन ।\nइति जल्पंति ये वापि कलिस्तान्नापि बाधते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001655100, "chapter_id": 21655, "verse_number": "१-४१-१०१", "content_sanskrit": "महादेव विरूपाक्ष गंगाधर मृडाव्यय ।\nइत्थं वदंति ये विप्र ते कृतार्था न संशयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001655101, "chapter_id": 21655, "verse_number": "१-४१-१०२", "content_sanskrit": "जनार्दन जगन्नात पीतांबरधराच्युत ।\nइति वाप्युञ्चरंतीह न च तेषां कलेर्भयम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001655102, "chapter_id": 21655, "verse_number": "१-४१-१०३", "content_sanskrit": "संसारे सुलभाः पुंसां पुत्रदारधनादयः ।\nघोरे कलियुगे विप्र हरिभक्तस्तु दुर्लभा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7001655103, "chapter_id": 21655, "verse_number": "१-४१-१०४", "content_sanskrit": "कर्मश्रद्धाविहीना ये पाषंडा वेदनिंदकाः ।\nअधर्मनिरता नैव नरकार्हा हरिस्मृतेः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7001655104, "chapter_id": 21655, "verse_number": "१-४१-१०५", "content_sanskrit": "वेदमार्गबहिष्टानां जनानां पापकर्मणाम् ।\nमनः शुद्धिविहीनानां हरिनाम्नैव निष्कृतिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7001655105, "chapter_id": 21655, "verse_number": "१-४१-१०६", "content_sanskrit": "दैवाधीनं जगत्सर्वमिदं स्थावरजंगमम् ।\nयथाप्रेरितमेतेन तथैव कुरुतें द्विज ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7001655106, "chapter_id": 21655, "verse_number": "१-४१-१०७", "content_sanskrit": "शक्तितः सर्वकर्माणि वेदोक्तानि विधाय च ।\nसमर्पयेन्महाविष्णौ नारायणपरायणः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7001655107, "chapter_id": 21655, "verse_number": "१-४१-१०८", "content_sanskrit": "समर्पितानि कर्माणि महविष्णौ परात्मनि ।\nसंपूर्णतां प्रयांत्येव हरिस्मरणमात्रतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7001655108, "chapter_id": 21655, "verse_number": "१-४१-१०९", "content_sanskrit": "हरिभक्तिरतानां च पापबंधो न जायते ।\nअतोऽतिदुर्लभा लोके हरिभक्तिर्दुरात्मनाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7001655109, "chapter_id": 21655, "verse_number": "१-४१-११०", "content_sanskrit": "अहो हरिपरा ये तु कलौ घोरे भयंकरे ।\nते सुभाग्या महात्मानः सत्संगर हिता अपि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7001655110, "chapter_id": 21655, "verse_number": "१-४१-१११", "content_sanskrit": "हरिस्मरणनिष्टानां शिवनामरतात्मनाम् ।\nसत्यं समस्तकर्माणि यांति संपूर्णतां द्विज ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7001655111, "chapter_id": 21655, "verse_number": "१-४१-११२", "content_sanskrit": "अहो भाग्यमहो भाग्यं हरिनाम रतात्मनाम् ।\nत्रिदर्शेरपि ते पूज्याः किमन्यैर्बहुभाषितैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7001655112, "chapter_id": 21655, "verse_number": "१-४१-११३", "content_sanskrit": "तस्मात्समस्तलोकानां हितमेव मयोच्यते ।\nहरिनामपरान्मर्त्यान्न कलिर्बाधर्तक्वचित् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7001655113, "chapter_id": 21655, "verse_number": "१-४१-११४", "content_sanskrit": "हरेर्नामैव नामैव नामैव मम जीवनम् ।\nकलौ नास्त्येव नास्त्येव गतिरन्यथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7001655114, "chapter_id": 21655, "verse_number": "१-४१-११५", "content_sanskrit": "सूत उवाच ।\nएवं स नारदो विप्राः सनकेन प्रबोधितः ।\nपरां निर्वृत्तिमापन्नः पुनरेतदुवाच ह ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7001655115, "chapter_id": 21655, "verse_number": "१-४१-११६", "content_sanskrit": "नारद उवाच ।\nभगवन्सर्वशास्त्रज्ञ स्वयातिकरुणात्मना ।\nप्रकाशितं जगज्ज्योतिः परं ब्रह्म सनातनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7001655116, "chapter_id": 21655, "verse_number": "१-४१-११७", "content_sanskrit": "एतदेव परं पुण्यमेतदेव परं तपः ।\nयः स्मरेत्पुंडरीकाक्षं सर्वपापविनाशनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7001655117, "chapter_id": 21655, "verse_number": "१-४१-११८", "content_sanskrit": "ब्रह्मन्नानाजगञ्चैतदेकचित्संप्रकाशितम् ।\nत्वयोक्तं तत्प्रतीयेऽहं कथं दृष्टांतमंतरा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7001655118, "chapter_id": 21655, "verse_number": "१-४१-११९", "content_sanskrit": "तस्माद्येन यथा ब्रह्म प्रतीतं बोधितेन तु ।\nतदाख्याहि यथा चित्तं सीदत्स्थितिमवाप्नुयात् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7001655119, "chapter_id": 21655, "verse_number": "१-४१-१२०", "content_sanskrit": "एतच्छ्रुत्वा वचो विप्रा नारदस्य महात्मनः ।\nसनकः प्रत्युवाचेदं स्मरन्नारायणं परम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7001655120, "chapter_id": 21655, "verse_number": "१-४१-१२१", "content_sanskrit": "सनक उवाच ।\nब्रह्मन्नहं ध्यानपरो भवेयं सनंदनं पृच्छ यथाभिलाषम् ।\nवेदांतशास्त्रे कुशलस्तवायं निवर्तयेद्वा परमार्यवंद्यः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7001655121, "chapter_id": 21655, "verse_number": "१-४१-१२२", "content_sanskrit": "इतीरितं समाकर्ण्य सनकस्य स नारदः ।\nसनंदनं मोक्षधर्मान्प्रष्टुं समुपचक्रमे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}]