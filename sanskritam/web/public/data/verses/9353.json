[{"id": 5000353000, "chapter_id": 9353, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे चतुर्दशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000353001, "chapter_id": 9353, "verse_number": "५-१४-१", "content_sanskrit": "स मुहूर्तमिव ध्यात्वा मनसा चाधिगम्य ताम्।\nअवप्लुतो महातेजाः प्राकारं तस्य वेश्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000353002, "chapter_id": 9353, "verse_number": "५-१४-२", "content_sanskrit": "स तु संहृष्टसर्वांगः प्राकारस्थो महाकपिः।\nपुष्पिताग्रान् वसन्तादौ ददर्श विविधान् द्रुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000353003, "chapter_id": 9353, "verse_number": "५-१४-३", "content_sanskrit": "सालानशोकान् भव्यांश्च चम्पकांश्च सुपुष्पितान्।\nउद्दालकान् नागवृक्षांश्चूतान् कपिमुखानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000353004, "chapter_id": 9353, "verse_number": "५-१४-४", "content_sanskrit": "तथाऽऽम्रवणसम्पन्नाँल्लताशतसमन्वितान्।\nज्यामुक्त इव नाराचः पुप्लुवे वृक्षवाटिकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000353005, "chapter_id": 9353, "verse_number": "५-१४-५", "content_sanskrit": "स प्रविश्य विचित्रां तां विहगैरभिनादिताम्।\nराजतैः काञ्चनैश्चैव पादपैः सर्वतो वृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000353006, "chapter_id": 9353, "verse_number": "५-१४-६", "content_sanskrit": "विहगैर्मृगसङ्घैश्च विचित्रां चित्रकाननाम्।\nउदितादित्यसंकाशां ददर्श हनुमान् बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000353007, "chapter_id": 9353, "verse_number": "५-१४-७", "content_sanskrit": "वृतां नानाविधैर्वृक्षैः पुष्पोपगफलोपगैः।\nकोकिलैर्भृङ्गराजैश्च मत्तैर्नित्यनिषेविताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000353008, "chapter_id": 9353, "verse_number": "५-१४-८", "content_sanskrit": "प्रहृष्टमनुजां काले मृगपक्षिमदाकुलाम्।\nमत्तबर्हिणसंघुष्टां नानाद्विजगणायुताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000353009, "chapter_id": 9353, "verse_number": "५-१४-९", "content_sanskrit": "मार्गमाणो वरारोहां राजपुत्रीमनिन्दिताम्।\nसुखप्रसुप्तान् विहगान् बोधयामास वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000353010, "chapter_id": 9353, "verse_number": "५-१४-१०", "content_sanskrit": "उत्पतद्भिर्द्विजगणैः पक्षैर्वातैः समाहताः।\nअनेकवर्णा विविधा मुमुचुः पुष्पवृष्टयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000353011, "chapter_id": 9353, "verse_number": "५-१४-११", "content_sanskrit": "पुष्पावकीर्णः शुशुभे हनूमान् मारुतात्मजः।\nअशोकवनिकामध्ये यथा पुष्पमयो गिरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000353012, "chapter_id": 9353, "verse_number": "५-१४-१२", "content_sanskrit": "दिशः सर्वाभिधावन्तं वृक्षखण्डगतं कपिम्।\nदृष्ट्वा सर्वाणि भूतानि वसन्त इति मेनिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000353013, "chapter_id": 9353, "verse_number": "५-१४-१३", "content_sanskrit": "वृक्षेभ्यः पतितैः पुष्पैरवकीर्णाः पृथग्विधैः।\nरराज वसुधा तत्र प्रमदेव विभूषिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000353014, "chapter_id": 9353, "verse_number": "५-१४-१४", "content_sanskrit": "तरस्विना ते तरवस्तरसा बहु कम्पिताः।\nकुसुमानि विचित्राणि ससृजुः कपिना तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000353015, "chapter_id": 9353, "verse_number": "५-१४-१५", "content_sanskrit": "निर्धूतपत्रशिखराः शीर्णपुष्पफलद्रुमाः।\nनिक्षिप्तवस्त्राभरणा धूर्ता इव पराजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000353016, "chapter_id": 9353, "verse_number": "५-१४-१६", "content_sanskrit": "हनूमता वेगवता कम्पितास्ते नगोत्तमाः।\nपुष्पपत्रफलान्याशु मुमुचुः फलशालिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000353017, "chapter_id": 9353, "verse_number": "५-१४-१७", "content_sanskrit": "विहंगसङ्घैर्हीनास्ते स्कन्धमात्राश्रया द्रुमाः।\nबभूवुरगमाः सर्वे मारुतेन विनिर्धुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000353018, "chapter_id": 9353, "verse_number": "५-१४-१८", "content_sanskrit": "विधूतकेशी युवतिर्यथा मृदितवर्णका।\nनिपीतशुभदन्तोष्ठी नखैर्दन्तैश्च विक्षता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000353019, "chapter_id": 9353, "verse_number": "५-१४-१९", "content_sanskrit": "तथा लांगूलहस्तैस्तु चरणाभ्यां च मर्दिता।\nतथैवाशोकवनिका प्रभग्नवनपादपा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000353020, "chapter_id": 9353, "verse_number": "५-१४-२०", "content_sanskrit": "महालतानां दामानि व्यधमत् तरसा कपिः।\nयथा प्रावृषि वेगेन मेघजालानि मारुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000353021, "chapter_id": 9353, "verse_number": "५-१४-२१", "content_sanskrit": "स तत्र मणिभूमीश्च राजतीश्च मनोरमाः।\nतथा काञ्चनभूमीश्च विचरन् ददृशे कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000353022, "chapter_id": 9353, "verse_number": "५-१४-२२", "content_sanskrit": "वापीश्च विविधाकाराः पूर्णाः परमवारिणा।\nमहार्हैर्मणिसोपानैरुपपन्नास्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000353023, "chapter_id": 9353, "verse_number": "५-१४-२३", "content_sanskrit": "मुक्ताप्रवालसिकताः स्फाटिकान्तरकुट्टिमाः।\nकाञ्चनैस्तरुभिश्चित्रैस्तीरजैरुपशोभिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000353024, "chapter_id": 9353, "verse_number": "५-१४-२४", "content_sanskrit": "बुद्धपद्मोत्पलवनाश्चक्रवाकोपशोभिताः।\nनत्यूहरुतसंघुष्टा हंससारसनादिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000353025, "chapter_id": 9353, "verse_number": "५-१४-२५", "content_sanskrit": "दीर्घाभिर्द्रुमयुक्ताभिः सरिद्भिश्च समन्ततः।\nअमृतोपमतोयाभिः शिवाभिरुपसंस्कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000353026, "chapter_id": 9353, "verse_number": "५-१४-२६", "content_sanskrit": "लताशतैरवतताः संतानकुसुमावृताः।\nनानागुल्मावृतवनाः करवीरकृतान्तराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000353027, "chapter_id": 9353, "verse_number": "५-१४-२७", "content_sanskrit": "ततोऽम्बुधरसंकाशं प्रवृद्धशिखरं गिरिम्।\nविचित्रकूटं कूटैश्च सर्वतः परिवारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000353028, "chapter_id": 9353, "verse_number": "५-१४-२८", "content_sanskrit": "शिलागृहैरवततं नानावृक्षसमावृतम्।\nददर्श कपिशार्दूलो रम्यं जगति पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000353029, "chapter_id": 9353, "verse_number": "५-१४-२९", "content_sanskrit": "ददर्श च नगात् तस्मान्नदीं निपतितां कपिः।\nअंकादिव समुत्पत्य प्रियस्य पतितां प्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000353030, "chapter_id": 9353, "verse_number": "५-१४-३०", "content_sanskrit": "जले निपतिताग्रैश्च पादपैरुपशोभिताम्।\nवार्यमाणामिव क्रुद्धां प्रमदां प्रियबन्धुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000353031, "chapter_id": 9353, "verse_number": "५-१४-३१", "content_sanskrit": "पुनरावृत्ततोयां च ददर्श स महाकपिः।\nप्रसन्नामिव कान्तस्य कान्तां पुनरुपस्थिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000353032, "chapter_id": 9353, "verse_number": "५-१४-३२", "content_sanskrit": "तस्यादूरात् स पद्मिन्यो नानाद्विजगणायुताः।\nददर्श कपिशार्दूलो हनूमान् मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000353033, "chapter_id": 9353, "verse_number": "५-१४-३३", "content_sanskrit": "कृत्रिमां दीर्घिकां चापि पूर्णां शीतेन वारिणा।\nमणिप्रवरसोपानां मुक्तासिकतशोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000353034, "chapter_id": 9353, "verse_number": "५-१४-३४", "content_sanskrit": "विविधैर्मृगसङ्घैश्च विचित्रां चित्रकाननाम्।\nप्रासादैः सुमहद्भिश्च निर्मितैर्विश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000353035, "chapter_id": 9353, "verse_number": "५-१४-३५", "content_sanskrit": "काननैः कृत्रिमैश्चापि सर्वतः समलंकृताम्।\nये केचित् पादपास्तत्र पुष्पोपगफलोपगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000353036, "chapter_id": 9353, "verse_number": "५-१४-३६", "content_sanskrit": "सच्छत्राः सवितर्दीकाः सर्वे सौवर्णवेदिकाः।\nलताप्रतानैर्बहुभिः पर्णैश्च बहुभिर्वृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000353037, "chapter_id": 9353, "verse_number": "५-१४-३७", "content_sanskrit": "काञ्चनीं शिंशपामेकां ददर्श स महाकपिः।\nवृतां हेममयीभिस्तु वेदिकाभिः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000353038, "chapter_id": 9353, "verse_number": "५-१४-३८", "content_sanskrit": "सोऽपश्यद् भूमिभागांश्च नगप्रस्रवणानि च।\nसुवर्णवृक्षानपरान् ददर्श शिखिसंनिभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000353039, "chapter_id": 9353, "verse_number": "५-१४-३९", "content_sanskrit": "तेषां द्रुमाणां प्रभया मेरोरिव महाकपिः।\nअमन्यत तदा वीरः काञ्चनोऽस्मीति सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000353040, "chapter_id": 9353, "verse_number": "५-१४-४०", "content_sanskrit": "तान् काञ्चनान् वृक्षगणान् मारुतेन प्रकम्पितान्।\nकिङ्किणीशतनिर्घोषान् दृष्ट्वा विस्मयमागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000353041, "chapter_id": 9353, "verse_number": "५-१४-४१", "content_sanskrit": "सुपुष्पिताग्रान् रुचिरांस्तरुणाङ्कुरपल्लवान्।\nतामारुह्य महावेगः शिंशपां पर्णसंवृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000353042, "chapter_id": 9353, "verse_number": "५-१४-४२", "content_sanskrit": "इतो द्रक्ष्यामि वैदेहीं रामदर्शनलालसाम्।\nइतश्चेतश्च दुःखार्तां सम्पतन्तीं यदृच्छया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000353043, "chapter_id": 9353, "verse_number": "५-१४-४३", "content_sanskrit": "अशोकवनिका चेयं दृढं रम्या दुरात्मनः।\nचन्दनैश्चम्पकैश्चापि बकुलैश्च विभूषिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000353044, "chapter_id": 9353, "verse_number": "५-१४-४४", "content_sanskrit": "इयं च नलिनी रम्या द्विजसङ्घनिषेविता।\nइमां सा राजमहिषी नूनमेष्यति जानकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000353045, "chapter_id": 9353, "verse_number": "५-१४-४५", "content_sanskrit": "सा रामा राजमहिषी राघवस्य प्रिया सती।\nवनसंचारकुशला ध्रुवमेष्यति जानकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000353046, "chapter_id": 9353, "verse_number": "५-१४-४६", "content_sanskrit": "अथवा मृगशावाक्षी वनस्यास्य विचक्षणा।\nवनमेष्यति साद्येह रामचिन्तासुकर्शिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000353047, "chapter_id": 9353, "verse_number": "५-१४-४७", "content_sanskrit": "रामशोकाभिसंतप्ता सा देवी वामलोचना।\nवनवासरता नित्यमेष्यते वनचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000353048, "chapter_id": 9353, "verse_number": "५-१४-४८", "content_sanskrit": "वनेचराणां सततं नूनं स्पृहयते पुरा।\nरामस्य दयिता चार्या जनकस्य सुता सती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000353049, "chapter_id": 9353, "verse_number": "५-१४-४९", "content_sanskrit": "संध्याकालमनाः श्यामा ध्रुवमेष्यति जानकी।\nनदीं चेमां शुभजलां संध्यार्थे वरवर्णिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000353050, "chapter_id": 9353, "verse_number": "५-१४-५०", "content_sanskrit": "तस्याश्चाप्यनुरूपेयमशोकवनिका शुभा।\nशुभायाः पार्थिवेन्द्रस्य पत्नी रामस्य सम्मता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000353051, "chapter_id": 9353, "verse_number": "५-१४-५१", "content_sanskrit": "यदि जीवति सा देवी ताराधिपनिभानना।\nआगमिष्यति सावश्यमिमां शीतजलां नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000353052, "chapter_id": 9353, "verse_number": "५-१४-५२", "content_sanskrit": "एवं तु मत्वा हनुमान् महात्मा\nप्रतीक्षमाणो मनुजेन्द्रपत्नीम्।\nअवेक्षमाणश्च ददर्श सर्वं\nसुपुष्पिते पर्णघने निलीनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000353053, "chapter_id": 9353, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे चतुर्दशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]