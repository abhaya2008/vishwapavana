[{"id": 40021307, "chapter_id": 9353, "verse_number": "1", "content_sanskrit": "अर्जुनेन विमुक्तस्तु रावणो राक्षसाधिपः । चचार पृथिवीं सर्वामनिर्विण्णस्तथा कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40021308, "chapter_id": 9353, "verse_number": "2", "content_sanskrit": "राक्षसं वा मनुष्यं वा शृणुते ऽयं बलाधिकम् । रावणस्तं समासाद्य युद्धे ह्वयति दर्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40021309, "chapter_id": 9353, "verse_number": "3", "content_sanskrit": "ततः कदाचित्किष्किन्धां नगरीं वालिपालिताम् । गत्वा ह्वयति युद्धाय वालिनं हेममालिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40021310, "chapter_id": 9353, "verse_number": "4", "content_sanskrit": "ततस्तु वानरामात्यस्तारस्तारापिता प्रभुः । उवाच वानरो वाक्यं युद्धप्रेप्सुमुपागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40021311, "chapter_id": 9353, "verse_number": "5", "content_sanskrit": "राक्षसेन्द गतो वाली यस्ते प्रतिबलो भवेत् । को ऽन्यः प्रमुखतः स्थातुं तव शक्तः प्लवङ्गमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40021312, "chapter_id": 9353, "verse_number": "6", "content_sanskrit": "चतुर्भ्यो ऽपि समुद्रेभ्यः सन्ध्यामन्वास्य रावण । इमं मुहूर्तमायाति वाली तिष्ठ मुहूर्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40021313, "chapter_id": 9353, "verse_number": "7", "content_sanskrit": "एतानस्थिचयान्पश्य य एते शङ्खपाण्डुराः । युद्धार्थिनामिमे राजन्वानराधिपतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40021314, "chapter_id": 9353, "verse_number": "8", "content_sanskrit": "यद्वा ऽमृतरसः पीतस्त्वया रावण राक्षस । तदा वालिनमासाद्य तदन्तं तव जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40021315, "chapter_id": 9353, "verse_number": "9", "content_sanskrit": "पश्येदानीं जगच्चित्रमिमं विश्रवसः सुत । इदं मुहूर्तं तिष्ठस्व दुर्लभं ते भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40021316, "chapter_id": 9353, "verse_number": "10", "content_sanskrit": "अथवा त्वरसे मर्तुं गच्छ दक्षिणसागरम् । वालिनं द्रक्ष्यसे तत्र भूमिस्थमिव पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40021317, "chapter_id": 9353, "verse_number": "11", "content_sanskrit": "स तु तारं विनिर्भर्त्स्य रावणो लोकरावणः । पुष्पकं तत्समारुह्य प्रययौ दक्षिणार्णवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40021318, "chapter_id": 9353, "verse_number": "12", "content_sanskrit": "तत्र हेमगिरिप्रख्यं तरुणार्कनिभाननम् । रावणो वालिनं दृष्ट्वा सन्ध्योपासनतत्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40021319, "chapter_id": 9353, "verse_number": "13", "content_sanskrit": "पुष्पकादवरुह्याथ रावणो ऽञ्जनसन्निभः । ग्रहीतुं वालिनं तूर्णं निःशब्दपदमाव्रजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40021320, "chapter_id": 9353, "verse_number": "14", "content_sanskrit": "यदृच्छया तदा दृष्टो वालिनापि स रावणः । पापाभिप्रायवान् दृष्ट्वा चकार न तु सम्भ्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40021321, "chapter_id": 9353, "verse_number": "15", "content_sanskrit": "शशमालक्ष्य सिंहो वा पन्नगं गरुडो यथा । न चिन्तयति तं वाली रावणं पापनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40021322, "chapter_id": 9353, "verse_number": "16", "content_sanskrit": "जिघृक्षमाणमायान्तं रावणं पापचेतसम् । कक्षावलम्बिनं कृत्वा गमिष्ये त्रीन्महार्णवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40021323, "chapter_id": 9353, "verse_number": "17", "content_sanskrit": "द्रक्ष्यन्त्यरिं ममाङ्कस्थं स्रंसदूरुकराम्बरम् । लम्बमानं दशग्रीवं गरुडस्येव पन्नगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40021324, "chapter_id": 9353, "verse_number": "18", "content_sanskrit": "इत्येवं मतिमास्थाय वाली कर्णमुपाश्रितः । जपन्वै नैगमान्मन्त्रांस्तस्थौ पर्वतराडिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40021325, "chapter_id": 9353, "verse_number": "19", "content_sanskrit": "तावन्योन्यं जिघृक्षन्तौ हरिराक्षसपार्थिवौ । प्रयत्नवन्तौ तत्कर्म ईहतुर्बलदर्पितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40021326, "chapter_id": 9353, "verse_number": "20", "content_sanskrit": "हस्तग्राहं तु तं मत्वा पादशब्देन रावणम् । पराङ्मुखो ऽपि जग्राह वाली सर्पमिवाण्डजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40021327, "chapter_id": 9353, "verse_number": "21", "content_sanskrit": "ग्रहीतुकामं तं गृह्य रक्षसामीश्वरं हरिः । खमुत्पपात वेगेन कृत्वा कक्षावलम्बिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40021328, "chapter_id": 9353, "verse_number": "22", "content_sanskrit": "तं चापीडयमानं तु वितुदन्तं नखैर्मुहुः । जहार रावणं वाली पवनस्तोयदं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40021329, "chapter_id": 9353, "verse_number": "23", "content_sanskrit": "अथ ते राक्षसामात्या ह्रियमाणं दशाननम् । मुमोक्षयिषवो वालिं रवमाणा अभिद्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40021330, "chapter_id": 9353, "verse_number": "24", "content_sanskrit": "अन्वीयमानस्तैर्वाली भ्राजते ऽम्बरमध्यगः । अन्वीयमानो मेघौघैरम्बरस्थ इवांशुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40021331, "chapter_id": 9353, "verse_number": "25", "content_sanskrit": "ते ऽशक्नुवन्तः सम्प्राप्तुं वालिनं राक्षसोत्तमाः । तस्य बाहूरुवेगेन परिश्रान्ता व्यवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40021332, "chapter_id": 9353, "verse_number": "26", "content_sanskrit": "वालिमार्गादपाक्रामन्पर्वतेन्द्रो हि गच्छतः । किं पुनर्जीवितप्रेप्सुर्बिभ्रद्वै मांसशोणितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40021333, "chapter_id": 9353, "verse_number": "27", "content_sanskrit": "अपक्षिगणसम्पातान्वानरेन्द्रो महाजवः । क्रमशः सागरान्सर्वान्सन्ध्याकालमवन्दत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40021334, "chapter_id": 9353, "verse_number": "28", "content_sanskrit": "सभाज्यमानो भूतैस्तु खैचरैः खैचरोत्तमः । पश्चिमं सागरं वाली ह्याजगाम सरावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40021335, "chapter_id": 9353, "verse_number": "29", "content_sanskrit": "तस्मिन्सन्ध्यामुपासित्वा स्नात्वा जप्त्वा च वानरः । उत्तरं सागरं प्रायाद्वहमानो दशाननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40021336, "chapter_id": 9353, "verse_number": "30", "content_sanskrit": "बहुयोजनसाहस्रं वहमानो महाहरिः । वायुवच्च मनोवच्च जगाम सह शत्रुणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40021337, "chapter_id": 9353, "verse_number": "31", "content_sanskrit": "उत्तरे सागरे सन्ध्यामुपासित्वा दशाननम् । वहमानो ऽगमद्वाली पूर्वं वै स महोदधिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40021338, "chapter_id": 9353, "verse_number": "32", "content_sanskrit": "तत्रापि सन्ध्यामन्वास्य वासविः सहरीश्वरः । किष्किन्धामभितो गृह्य रावणं पुनरागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40021339, "chapter_id": 9353, "verse_number": "33", "content_sanskrit": "चतुर्ष्वपि समुद्रेषु सन्ध्यामन्वास्य वानरः । रावणोद्वहनश्रान्तः किष्किन्धोपवने ऽपतत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40021340, "chapter_id": 9353, "verse_number": "34", "content_sanskrit": "रावणं तु मुमोचाथ स्वकक्षात्कपिसत्तमः । कुतस्त्वमिति चोवाच प्रहसन्रावणं मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40021341, "chapter_id": 9353, "verse_number": "35", "content_sanskrit": "विस्मयं तु महद्गत्वा श्रमलोलनिरीक्षणः । राक्षसेन्द्रो हरीन्द्रं तमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40021342, "chapter_id": 9353, "verse_number": "36", "content_sanskrit": "वानरेन्द्र महेन्द्राभ राक्षसेन्द्रो ऽस्मि रावणः । युद्धेप्सुरिह सम्प्राप्तः स चाद्यासादितस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40021343, "chapter_id": 9353, "verse_number": "37", "content_sanskrit": "अहो बलमहो वीर्यमहो गाम्भीर्यमेव च । येनाहं पशुवद्गृह्य भ्रामितश्चतुरो ऽर्णवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40021344, "chapter_id": 9353, "verse_number": "38", "content_sanskrit": "एवमश्रान्तवद्वीर शीघ्रमेव महार्णवान् । मां चैवोद्वहमानस्तु को ऽन्यो वीरः क्रमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40021345, "chapter_id": 9353, "verse_number": "39", "content_sanskrit": "त्रयाणामेव भूतानां गतिरेषा प्लवङ्गम । मनोनिलसुपर्णानां तव चात्र न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40021346, "chapter_id": 9353, "verse_number": "40", "content_sanskrit": "सो ऽहं दृष्टबलस्तुभ्यमिच्छामि हरिपुङ्गव । त्वया सह चिरं सख्यं सुस्निग्धं पावकाग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40021347, "chapter_id": 9353, "verse_number": "41", "content_sanskrit": "दाराः पुत्राः पुरं राष्ट्रं भोगाच्छादनभोजनम् । सर्वमेवाविभक्तं नौ भविष्यति हरीश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40021348, "chapter_id": 9353, "verse_number": "42", "content_sanskrit": "ततः प्रज्वालयित्वाग्निं तावुभौ हरीराक्षसौ । भ्रातृत्वमुपसम्पन्नौ परिष्वज्य परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40021349, "chapter_id": 9353, "verse_number": "43", "content_sanskrit": "अन्योन्यं लम्बितकरौ ततस्तौ हरिराक्षसौ । किष्किन्धां विशतुर्हृष्टौ सिंहौ गिरिगुहामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40021350, "chapter_id": 9353, "verse_number": "44", "content_sanskrit": "स तत्र मासमुषितः सुग्रीव इव रावणः । अमात्यैरागतैर्नीतस्त्रैलोक्योत्सादनार्थिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40021351, "chapter_id": 9353, "verse_number": "45", "content_sanskrit": "एवमेतत्पुरावृत्तं वालिना रावणः प्रभो । धर्षितश्च कृतश्चापि भ्राता पावकसन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40021352, "chapter_id": 9353, "verse_number": "46", "content_sanskrit": "बलमप्रतिमं राम वालिनो ऽभवदुत्तमम् । सो ऽपि त्वया विनिर्दग्धः शलभो वह्निना यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]