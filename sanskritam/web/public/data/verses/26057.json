[{"id": 7006057000, "chapter_id": 26057, "verse_number": "२-१-१", "content_sanskrit": "धर्मन्दृढबद्धमूलो वेदस्कन्धः पुराणशाखाढ्यः ।\nक्रतुकुसुमो मोक्षफलो मधुसूदनपादपो जयति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006057001, "chapter_id": 26057, "verse_number": "२-१-२", "content_sanskrit": "नैमिषेऽनिमिषक्षेत्रे शौनकाद्या मुनीश्वराः ।\nकर्मणामन्तरे सूतं स्वासीनमिदमब्रुवन् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006057002, "chapter_id": 26057, "verse_number": "२-१-३", "content_sanskrit": "सूत जानासि सकलं वस्तु व्यासप्रसादतः ।\nतेन नः सन्दिहानानां सन्देहं छेत्तुमर्हसि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006057003, "chapter_id": 26057, "verse_number": "२-१-४", "content_sanskrit": "यथा तृणजलौकेति न्यायमा श्रित्य कञ्चन ।\nदेहिनोऽन्यतनुप्राप्तिं केचित्त्वेवं वदन्ति हि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006057004, "chapter_id": 26057, "verse_number": "२-१-५", "content_sanskrit": "केचित्पुनर्यातनानां यामीनामुपभोगतः ।\nपश्चाद्देहान्तरप्राप्तिं वदन्ति किमु तत्रसत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006057005, "chapter_id": 26057, "verse_number": "२-१-६", "content_sanskrit": "सूत उवाच ।\nसाधु पृष्टं महाभागाः शृणुध्वं भवतां पुनः ।\nसन्देहो नोपपद्येत लोकार्थं किल पृच्छताम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006057006, "chapter_id": 26057, "verse_number": "२-१-७", "content_sanskrit": "तदहं कृष्णगरुडसंवादद्वारकं द्विजाः ।\nअपाकरिष्ये सन्देहं भवतां भावितात्मनाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006057007, "chapter_id": 26057, "verse_number": "२-१-८", "content_sanskrit": "नमः कृष्णाय मुनये य एनं समुपाश्रिताः ।\nअञ्जस्तरन्ति संसारसागरं कुनदीमिव ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006057008, "chapter_id": 26057, "verse_number": "२-१-९", "content_sanskrit": "एकदा वैनतेयस्य लोकानां लोकनस्पृहा ।\nबभूव सोऽथ बभ्राम तेषु नाम हरेर्गृणन् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006057009, "chapter_id": 26057, "verse_number": "२-१-१०", "content_sanskrit": "स पातालं भुवं स्वर्गं भ्रान्त्वालब्धशमाशयः ।\nलोकदुः खेनातिदुः खी पुनर्वैकुण्ठमागमत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006057010, "chapter_id": 26057, "verse_number": "२-१-११", "content_sanskrit": "न रजो न तमश्चैव सत्त्वं ताभ्यां च मिश्रितम् ।\nयत्र प्रवर्तते नैव सत्त्वमेव प्रवर्तते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006057011, "chapter_id": 26057, "verse_number": "२-१-१२", "content_sanskrit": "न यत्र माया नाशश्च न चै रागादयो मलाः ।\nश्यामावदाताः सुरुचः शतपत्रविलोचनाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006057012, "chapter_id": 26057, "verse_number": "२-१-१३", "content_sanskrit": "सुरासुरार्चिता यत्र गणा विष्णोः सुपेशसः ।\nपिशङ्गवस्त्राभारणा मणियुङ्निष्कभूषिताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006057013, "chapter_id": 26057, "verse_number": "२-१-१४", "content_sanskrit": "चतुर्भुजाः कुण्डलिनो मौलिनो मालिनस्तथा ।\nभ्राजिष्णुभिर्विमानानां पङ्किभिर्ये महात्मनाम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006057014, "chapter_id": 26057, "verse_number": "२-१-१५", "content_sanskrit": "द्योतन्ते द्योतमानानां प्रमदानां च पङ्क्तिभिः ।\nश्रीर्यत्र नानाविभवैर्हरेः पादौ मुदार्चति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006057015, "chapter_id": 26057, "verse_number": "२-१-१६", "content_sanskrit": "हरिं गायति दोलास्थं गीयमानालिभिः स्वयम् ।\nददर्श श्रीहरिं तत्र श्रीपतिं सात्वतां पतिम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006057016, "chapter_id": 26057, "verse_number": "२-१-१७", "content_sanskrit": "जगत्पतिं यज्ञपतिं पार्षदैः परिषेवितम् ।\nसुनन्दनन्दप्रबलार्हणमुख्यैर्निरन्तरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006057017, "chapter_id": 26057, "verse_number": "२-१-१८", "content_sanskrit": "भृत्यप्रसादसुमुखमायतारुणलोचनम् ।\nकिरीटिनं कुण्डलिनं श्रिया वक्षसि लक्षितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006057018, "chapter_id": 26057, "verse_number": "२-१-१९", "content_sanskrit": "पीतांशुकं चतुर्बाहुं प्रसन्नहसिताननम् ।\nअभ्यर्हणासनासीनं ताभिः शक्तिभिरावृतम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006057019, "chapter_id": 26057, "verse_number": "२-१-२०", "content_sanskrit": "प्रधानपुरुषाभ्यां च महता चाहमा तथा ।\nएकादशोन्द्रियैश्चैव पञ्चभूतैस्तथैव च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006057020, "chapter_id": 26057, "verse_number": "२-१-२१", "content_sanskrit": "स्वरूपेरममाणं तमीश्वरं विनतासुतः ।\nतद्दर्शनाह्लादयुतस्वान्तो हृष्यत्तनूरुहः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006057021, "chapter_id": 26057, "verse_number": "२-१-२२", "content_sanskrit": "लोचनाभ्यामश्रु मुञ्चन्प्रेममग्नो ननाम ह ।\nनमागतं नतं स्वीय वाहनं विष्णुरब्रवीत् ।\nभूमिः का लङ्घिता पक्षिंस्त्वयेयन्तमनेहसम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006057022, "chapter_id": 26057, "verse_number": "२-१-२३", "content_sanskrit": "गरुड उवाच ।\nतव प्रसादाद्वैकुण्ठ त्रैलोक्यं सचराचरम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006057023, "chapter_id": 26057, "verse_number": "२-१-२४", "content_sanskrit": "मया विलोकितं सर्वं जगत्स्थावरजङ्गमम् ।\nभूर्लोकात्सत्यपर्यन्तं पुरं याम्यं विना प्रभो ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006057024, "chapter_id": 26057, "verse_number": "२-१-२५", "content_sanskrit": "भूर्लोकः सर्वलोकानां प्रचुरः सर्वजन्तुषु ।\nमानुष्यं सर्वभूतानां भुक्तिमुक्त्यालयं शुभम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006057025, "chapter_id": 26057, "verse_number": "२-१-२६", "content_sanskrit": "अतः सुकृतिनां लोको न भूतो न भविष्यति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006057026, "chapter_id": 26057, "verse_number": "२-१-२७", "content_sanskrit": "गायन्ति देवाः किल गीतकानि धन्यास्तु ये भारतभूमिभागे ।\nस्वर्गापवर्गस्य फलार्जनाय भवन्ति भूयः पुरुषाः सुरत्वात् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006057027, "chapter_id": 26057, "verse_number": "२-१-२८", "content_sanskrit": "प्रेतः कौक्षिप्यते कस्मात्पञ्चरत्नं मुखे कथम् ।\nअधस्ताच्चालिता दर्भाः पादौ याम्यां व्यवस्थितौ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006057028, "chapter_id": 26057, "verse_number": "२-१-२९", "content_sanskrit": "किमर्थं पुत्रपौत्राश्च तस्य तिष्ठन्ति चाग्रतः ।\nकिमर्थं दीयते दानं गोदानमपि केशव ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006057029, "chapter_id": 26057, "verse_number": "२-१-३०", "content_sanskrit": "बन्धुमित्राण्यमित्राश्च क्षमापयन्ति तत्कथम् ।\nतिलालोहं हिरण्यं च कर्पासं लवणं तथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006057030, "chapter_id": 26057, "verse_number": "२-१-३१", "content_sanskrit": "सप्तधान्यं क्षितिर्गावो दीयन्ते केनहेतुना ।\nकथं हि म्रियते जन्तुर्मृतो वै कुत्र गच्छति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006057031, "chapter_id": 26057, "verse_number": "२-१-३२", "content_sanskrit": "अतिवाहशरीरं च कथं हि श्रयते तदा ।\nशवं स्कन्धे वहेत्पुत्रो अग्निदाता च पौत्रकः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006057032, "chapter_id": 26057, "verse_number": "२-१-३३", "content_sanskrit": "आज्येनाभ्यञ्जनं कस्मात्कुत एकाहुतिक्रिया ।\nवसुन्धरा किमर्थं च कुतः स्त्रीशब्दकीर्तनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006057033, "chapter_id": 26057, "verse_number": "२-१-३४", "content_sanskrit": "यमसूक्तं किमर्थं च उदीच्या दिशमाहरेत् ।\nपानीयमेकवस्त्रेण सूर्यबिम्बनिरीक्षणम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006057034, "chapter_id": 26057, "verse_number": "२-१-३५", "content_sanskrit": "यवसर्षपदूर्वास्तु पाषाणे निम्बपत्रकम् ।\nवस्त्रं नरश्च नारी च विदध्यादधरोत्तरम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006057035, "chapter_id": 26057, "verse_number": "२-१-३६", "content_sanskrit": "अन्नाद्यं गृहमागत्य न भोक्तव्यं जनैः सह ।\nनवकांश्चैव पिण्डांश्च किमर्थं ददते सुताः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006057036, "chapter_id": 26057, "verse_number": "२-१-३७", "content_sanskrit": "किमर्थं चत्वरे दुग्धं यात्रे पक्वे च मृन्मये ।\nकाष्ठत्रयं गणाबद्धं कृत्वा रात्रौ चतुष्पथे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006057037, "chapter_id": 26057, "verse_number": "२-१-३८", "content_sanskrit": "निशायां दीयते दीपो यावदब्दं दिनेदिन ।\nदाहोदकं किमर्थं च किमर्थं च जनैः सह ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006057038, "chapter_id": 26057, "verse_number": "२-१-३९", "content_sanskrit": "भगवन्नाति वाहश्च नव पिण्डाः प्रदापयेत् ।\nकथं देयं पितृभ्यश्च वाहस्यावाहनं कथम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006057039, "chapter_id": 26057, "verse_number": "२-१-४०", "content_sanskrit": "इदञ्चेत्क्रियते देव कस्मात्पिण्डं प्रदापयेत् ।\nकिं तत्प्रदीयते तस्य पिण्डदानाद्यनन्तरम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006057040, "chapter_id": 26057, "verse_number": "२-१-४१", "content_sanskrit": "अस्थिसञ्चयनं चैव घटस्फोटं तथैव च ।\nद्वितीयेऽह्नि कुतः स्नानं चतुर्थे साग्निके द्विजे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006057041, "chapter_id": 26057, "verse_number": "२-१-४२", "content_sanskrit": "दशमे किं मलस्नानं कार्यं सर्वजनैः सह ।\nकस्मात्तैलोद्वर्तनं च स्कन्धवाहगृहं नयेत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006057042, "chapter_id": 26057, "verse_number": "२-१-४३", "content_sanskrit": "तैलोद्वर्तनकं चापि दधुः स्थूलजलाशये ।\nदशमेऽहनि यत्पिण्डं तद्दद्या दामिषेण तु ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006057043, "chapter_id": 26057, "verse_number": "२-१-४४", "content_sanskrit": "पिणाञ्चैकादशे कस्माद्वृषोत्सर्गादिपूर्वकम् ।\nभाजनोपानहौ च्छत्रं वासांसि त्वङ्गुलीयकम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006057044, "chapter_id": 26057, "verse_number": "२-१-४५", "content_sanskrit": "त्रयोदशेऽह्नि देयं स्यात्पददानं किमर्थकम् ।\nश्राद्धानि षोडशैतानि अब्दं यावत्कुतो घटः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006057045, "chapter_id": 26057, "verse_number": "२-१-४६", "content_sanskrit": "अन्नाद्येनोदकेनैव षष्ट्याधिकशतत्रयम् ।\nदिनेदिने च दातव्यं घटान्नं प्रेततृप्तये ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006057046, "chapter_id": 26057, "verse_number": "२-१-४७", "content_sanskrit": "प्राप्ते काले वै म्रियते अनित्या मानवाः प्रभो ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006057047, "chapter_id": 26057, "verse_number": "२-१-४८", "content_sanskrit": "छिद्रं तु नैव पश्यामि कुतो जीवः स निर्गतः ।\nकुतो गच्छन्ति भूतानि पृथिव्यापो मनस्तथा ।\nतेजो वदस्व मे नाथ वायुराकाशमेव च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006057048, "chapter_id": 26057, "verse_number": "२-१-४९", "content_sanskrit": "कुतः कर्मेन्द्रियाणीह पञ्चबुद्धीन्द्रियाणि च ।\nवायवश्चैव पञ्चैते कथं गच्छन्ति चात्ययम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006057049, "chapter_id": 26057, "verse_number": "२-१-५०", "content_sanskrit": "लोभमोहादयः पञ्च शरीरे चैव तस्कराः ।\nतृष्णा कामो ह्यहङ्कारः कुतो यान्ति जनार्दना ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006057050, "chapter_id": 26057, "verse_number": "२-१-५१", "content_sanskrit": "पुण्यं वाप्यथवापुण्यं यत्किञ्चित्सुकृतं तथा ।\nनष्टे देहे कुतो यान्ति दानानि विविधानि च ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006057051, "chapter_id": 26057, "verse_number": "२-१-५२", "content_sanskrit": "सपिण्डनं किमर्थं च पूर्णे संवत्सरेऽपि वा ।\nप्रेतस्य मेलनं केषां किंविधं तत्र कारयेत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006057052, "chapter_id": 26057, "verse_number": "२-१-५३", "content_sanskrit": "मूर्छनात्पननाद्वापि विपत्तिर्यदि जायते ।\nये दग्धा ये त्वदग्धाश्च पतिता ये नरा भुवि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006057053, "chapter_id": 26057, "verse_number": "२-१-५४", "content_sanskrit": "यानि चान्यानि भूतानि तेषामन्ते भवेच्च किम् ।\nपापिनो ये दुराचारा ये चान्ये गतबुद्धयः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006057054, "chapter_id": 26057, "verse_number": "२-१-५५", "content_sanskrit": "आत्मघाती ब्रह्महा च स्तेयी विश्वासघातकः ।\nकपिलायाः पिबेच्छूद्रो यः पठेदिदमक्षरम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006057055, "chapter_id": 26057, "verse_number": "२-१-५६", "content_sanskrit": "धारयेद्ब्रह्मसूत्रं वा का गतिस्तस्य माधव ।\nशूद्रस्य ब्राह्मणी भार्या संगृहीता यदा भवेत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006057056, "chapter_id": 26057, "verse_number": "२-१-५७", "content_sanskrit": "भीतोऽहं पापिनस्तस्मात्तन्मे वद जगत्प्रभो ।\nअन्यच्च शृणु विश्वात्मन्मया कौतुकिना रयात् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006057057, "chapter_id": 26057, "verse_number": "२-१-५८", "content_sanskrit": "लोकांल्लोकयता लोके जगाहे विश्वमण्डलम् ।\nतत्राजनि जनान्दृष्ट्वा दुः खेष्वेव निमज्जतः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006057058, "chapter_id": 26057, "verse_number": "२-१-५९", "content_sanskrit": "स्वान्ते मे दुर्धरा पीडा तत्पीडातो गरीयसी ।\nत्रिदिवे दितिजातेभ्यो भूमौ मृत्युरुगादिभिः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006057059, "chapter_id": 26057, "verse_number": "२-१-६०", "content_sanskrit": "इष्टवस्तुवियो गैश्च पाताले मामकं भयम् ।\nएवं न निर्भयं स्थानमन्यदीश भवत्पदात् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006057060, "chapter_id": 26057, "verse_number": "२-१-६१", "content_sanskrit": "असत्यं स्वप्नमायावत्कालेन कवलीकृतम् ।\nतत्रापि भारते वर्षे बहुदुः खस्य भागिनः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006057061, "chapter_id": 26057, "verse_number": "२-१-६२", "content_sanskrit": "जना दृष्टा मया रागद्वेषमोहादिविप्लुताः ।\nकेचिदन्धाः केकराक्षास्खलद्वाचस्तु पङ्गवः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006057062, "chapter_id": 26057, "verse_number": "२-१-६३", "content_sanskrit": "खञ्जाः काणाश्च बधिरा मूकाः कुष्ठाश्च लोमशाः ।\nनानारोगपरीताश्च खपुष्पाच्चाभिमानिनः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006057063, "chapter_id": 26057, "verse_number": "२-१-६४", "content_sanskrit": "तेषां दोषस्य वैचित्र्यं मृत्योर्गोचरतामपि ।\nदृष्ट्वा प्रसुमनाः प्राप्तः को मृत्युश्चित्रता कथम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006057064, "chapter_id": 26057, "verse_number": "२-१-६५", "content_sanskrit": "मृतिर्यस्य विधानेन मरणादप्यनन्तरम् ।\nविधिनाब्दक्रिया यस्य न स दुर्गतिमाप्नुयात् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006057065, "chapter_id": 26057, "verse_number": "२-१-६६", "content_sanskrit": "ऋषिभ्यस्तु मया पूर्वमिति सामान्यतः श्रुतम् ।\nज्ञानाय तद्द्विशेषस्य पृच्छामीदमिति प्रभो ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006057066, "chapter_id": 26057, "verse_number": "२-१-६७", "content_sanskrit": "म्रियमाणस्य किं कृत्यं किं दानं वासवानुज ।\nवाहमृत्योरन्तराले को विधिर्दहनस्य च ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006057067, "chapter_id": 26057, "verse_number": "२-१-६८", "content_sanskrit": "सद्यो विलम्बतो वा किं देहमन्यं प्रपद्यते ।\nसंयमन्यां क्रम्यमाणमावर्षं का मृतिक्रिया ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006057068, "chapter_id": 26057, "verse_number": "२-१-६९", "content_sanskrit": "प्रायश्चित्तं दुर्मतेः किं पञ्चकादिमृतस्य च ।\nप्रसादं कुरु मे मोहं छेत्तुमर्हस्यशेषतः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006057069, "chapter_id": 26057, "verse_number": "२-१-७०", "content_sanskrit": "सर्वमन्तेमया पृष्टं ब्रूहि लोकहिताय वै ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]