[{"id": 2204063, "chapter_id": 5350, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2204064, "chapter_id": 5350, "verse_number": "१", "content_sanskrit": "भगवन् भगनेत्रघ्न कालसूदन शङ्कर ।\nइमे तु वर्णाश्चत्वारो विहिताः स्वित्स्वभावतः ।\nउताहो क्रियया वर्णाः सम्भवन्ति महेश्वर\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2204065, "chapter_id": 5350, "verse_number": "२", "content_sanskrit": "एष मे संशयप्रश्नस्तं मे छेत्तुं त्वमर्हसि\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2204066, "chapter_id": 5350, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2204067, "chapter_id": 5350, "verse_number": "३", "content_sanskrit": "स्वभावादेव विद्यन्ते चत्वारो ब्राह्मणादयः ।\nएकजात्या सुदुष्प्रापमन्यवर्णत्वमागतम्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2204068, "chapter_id": 5350, "verse_number": "४", "content_sanskrit": "तच्च कर्मविशेषेण पुनर्जन्मनि जायते ।\nतस्मात्ते सम्प्रवक्ष्यामि तत्सर्वं कर्मपाकतः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2204069, "chapter_id": 5350, "verse_number": "५", "content_sanskrit": "ब्राह्मणस्तु नरो भूत्वा स्वजातिमनुपालयेत् ।\nदृढं ब्राह्मणकर्माणि वेदोक्तानि समाचरेत्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2204070, "chapter_id": 5350, "verse_number": "६", "content_sanskrit": "सत्यार्जवपरो भूत्वा दानयज्ञपरस्तथा ।\nतस्यां जात्यां समुदितो जातिधर्मान् न हापयेत्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2204071, "chapter_id": 5350, "verse_number": "७", "content_sanskrit": "एवं संवर्तमानस्तु कालधर्मं गतः पुनः ।\nस्वर्लोके चाभिजायेत स्वर्गभोगाय भामिनि\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2204072, "chapter_id": 5350, "verse_number": "८", "content_sanskrit": "तत्क्षये ब्राह्मणो भूत्वा तथैव नृषु जायते ।\nएवं स्वकर्मणा मर्त्यः स्वजातिं लभते पुनः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2204073, "chapter_id": 5350, "verse_number": "९", "content_sanskrit": "अपरस्तु तथा कश्चिद् ब्रह्मयोनिसमुद्भवः ।\nअवमत्यैव तां जातिमज्ञानतमसावृतः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2204074, "chapter_id": 5350, "verse_number": "१०", "content_sanskrit": "अन्यथा वर्तमानस्तु जातिकर्माणि वर्जयेत् ।\nशूद्रवद् विचरेल्लोके शूद्रकर्माभिलाषया ।\nशूद्रैः सह चरन् नित्यं शौचमङ्गलवर्जितः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2204075, "chapter_id": 5350, "verse_number": "११", "content_sanskrit": "स चापि कालधर्मस्थो यमलोकेषु दण्डितः ।\nयदि जायेत मर्त्येषु शूद्र एवाभिजायते\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2204076, "chapter_id": 5350, "verse_number": "१२", "content_sanskrit": "शूद्र एव भवेद् देवि ब्राह्मणोऽपि स्वकर्मणा\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2204077, "chapter_id": 5350, "verse_number": "१३", "content_sanskrit": "तथैव शूद्रस्त्वपरः शूद्रकर्माणि वर्जयेन् ।\nसत्यार्जवपरो भूत्वा दानधर्मपरस्तथा ।\nमन्त्रब्राह्मणसत्कर्ता मनसा ब्राह्मणप्रियः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2204078, "chapter_id": 5350, "verse_number": "१४", "content_sanskrit": "एवं युक्तसमाचारः शूद्रोऽपि मरणं गतः ।\nस्वर्गलोकेऽभिजायेत तत्क्षये नृषु जायते ।\nब्राह्मणानां कुले मुख्ये वेदस्वाध्यायसंयुते\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2204079, "chapter_id": 5350, "verse_number": "१५", "content_sanskrit": "एवमेव सदा लोके शूद्रो ब्राह्मण्यमाप्नुयात्\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2204080, "chapter_id": 5350, "verse_number": "१६", "content_sanskrit": "एवं क्षत्रियवैश्याश्च जातिधर्मेण संयुताः ।\nस्वकर्मणैव जायन्ते विशिष्टेष्वधमेषु च\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2204081, "chapter_id": 5350, "verse_number": "१७", "content_sanskrit": "एवं जातिविपर्यासः प्रेत्यभावे भवेन्नृणाम् ।\nअन्यथा तु न शक्यन्ते लोकसंस्थितिकारणात्\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2204082, "chapter_id": 5350, "verse_number": "१८", "content_sanskrit": "तस्माज्जातिं विशिष्टां तु कथञ्चित् प्राप्य पण्डितः ।\nसर्वथा तां तथा रक्षेन्न पुनर्भ्रश्यते यथा ।\nइति ते कथितं देवि भूयः श्रोतुं किमिच्छसि\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2204083, "chapter_id": 5350, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2204084, "chapter_id": 5350, "verse_number": "१९", "content_sanskrit": "जन्मप्रभृति कैः शुद्धो लभेज्जन्मफलं नरः ।\nशोभनाशोभनं सर्वमधिकारवशात् स्वयम्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2204085, "chapter_id": 5350, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2204086, "chapter_id": 5350, "verse_number": "२०", "content_sanskrit": "कर्म कुर्वन्न लिप्येत आर्जवेन समाचरन् ।\nआत्मैव तच्छुभं कुर्यादशुभे नैव योजयेत्\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2204087, "chapter_id": 5350, "verse_number": "२१", "content_sanskrit": "शठेषु शठवत् कुर्यादार्येष्वृजुवदाचरेत् ।\nआपत्सु नावसीदेच्च घोरान् सङ्क्रामयेत् परात् ।\nसाम्नैव सर्वकार्याणि कर्तुं पूर्वं समारभेत्\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2204088, "chapter_id": 5350, "verse_number": "२२", "content_sanskrit": "अनर्थाधर्मशोकांस्तु यथा न प्राप्नुयात् स्वयम् ।\nप्रयतेत तथा कर्तुमेतद् वृत्तं समासतः\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2204089, "chapter_id": 5350, "verse_number": "२३", "content_sanskrit": "एतद् वृत्तं समासाद्य गृहमाश्रित्य मानवाः ।\nनिराहारा निरुद्वेगाः प्राप्नुवन्त्युत्तमां गतिम्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2204090, "chapter_id": 5350, "verse_number": "", "content_sanskrit": "एतज्जन्मफलं नित्यं सर्वेषां गृहवासिनाम् ।\nएवं गृहगतैर्नित्यं वर्तितव्यमिति स्थितिः ।\nएतत्सर्वं मया प्रोक्तं किं भूयः श्रोतुमिच्छसि\t ॥२४", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2204091, "chapter_id": 5350, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2204092, "chapter_id": 5350, "verse_number": "२५", "content_sanskrit": "सुरासुरपते देव वरद प्रीतिवर्धन ।\nमानुषेष्वेव ये केचिदाढ्याः क्लेशविवर्जिताः ।\nभुञ्जाना विविधान् भोगान् दृश्यन्ते निरुपद्रवाः\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2204093, "chapter_id": 5350, "verse_number": "२६", "content_sanskrit": "अपरे क्लेशसंयुक्ता दरिद्रा भोगवर्जिताः\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2204094, "chapter_id": 5350, "verse_number": "२७", "content_sanskrit": "किमर्थं मानुषे लोके न समत्वेन कल्पिताः ।\nएतच्छ्रोतुं महादेव कौतूहलमतीव मे\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2204095, "chapter_id": 5350, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2204096, "chapter_id": 5350, "verse_number": "२८", "content_sanskrit": "न्यायतस्त्वं महाभागे श्रोतुकामासि भामिनि ।\nशृणु तत्सर्वमखिलं मानुषाणां हितं वचः\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2204097, "chapter_id": 5350, "verse_number": "२९", "content_sanskrit": "आदिसर्गे पुरा ब्रह्मा समत्वेनासृजत् प्रजाः ।\nनित्यं न भवतो ह्यस्य रागद्वेषौ प्रजापतेः ।\nतदा तस्मात् समाः सर्वे बभूवुः सर्वतो नराः\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2204098, "chapter_id": 5350, "verse_number": "३०", "content_sanskrit": "एवं संवर्तमाने तु युगे कालविपर्ययात् ।\nकेचित् प्रपेदिरे तत्र विषमं बुद्धिमोहिताः\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2204099, "chapter_id": 5350, "verse_number": "३१", "content_sanskrit": "तेषां हानिं ततो दृष्ट्वा तुल्यानामेव भामिनि ।\nब्रह्माणं ते समाजग्मुस्तत्कारणनिवेदकाः\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2204100, "chapter_id": 5350, "verse_number": "३२", "content_sanskrit": "कर्तुं नार्हसि देवेश पक्षपातं त्वमीदृशम् ।\nपुत्रभावे समे देव किमर्थं नो भवेत् कलिः\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2204101, "chapter_id": 5350, "verse_number": "३३", "content_sanskrit": "इत्येवं तैरुपालब्धो ब्रह्मा वचनमब्रवीत् ।\nयूयं मा कार्ष्ट मे दोषं स्वकृतं स्मरत प्रजाः\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2204102, "chapter_id": 5350, "verse_number": "३४", "content_sanskrit": "युष्माभिरेव युष्माकं ग्रथितं हि शुभाशुभम् ।\nयादृशं कुरुते कर्म तादृशं फलमश्नुते ।\nस्वकृतस्य फलं भुङ्क्ते नान्यस्तद् भोक्तुमर्हति\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2204103, "chapter_id": 5350, "verse_number": "३५", "content_sanskrit": "एवं सम्बोधितास्तेन लोककर्त्रा स्वयम्भुवा ।\nपुनर्निवृत्य कर्माणि शुभान्येव प्रपेदिरे\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2204104, "chapter_id": 5350, "verse_number": "३६", "content_sanskrit": "एवं विज्ञाततत्त्वास्ते दानधर्मपरायणाः ।\nशुभानि विधिवत् कृत्वा कालधर्मगताः पुनः ।\nतानि दानफलान्येव भुञ्जते सुखभोगिनः\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2204105, "chapter_id": 5350, "verse_number": "३७", "content_sanskrit": "स्वकृतं तु नरस्तस्मात् स्वयमेव प्रपद्यते\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2204106, "chapter_id": 5350, "verse_number": "३८", "content_sanskrit": "अपरे धर्मकामेभ्यो निवृत्तास्तु शुभेक्षणे ।\nकदर्या निरनुक्रोशाः प्रायेणात्मपरायणाः\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2204107, "chapter_id": 5350, "verse_number": "३९", "content_sanskrit": "तादृशा मरणं प्राप्ताः पुनर्जन्मनि शोभने ।\nदरिद्राः क्लेशसंयुक्ता भवन्त्येव न संशयः\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2204108, "chapter_id": 5350, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2204109, "chapter_id": 5350, "verse_number": "४०", "content_sanskrit": "मानुषेष्वथ ये केचिद् धनधान्यसमन्विताः ।\nभोगहीनाः प्रदृश्यन्ते सर्वभोगेषु सत्स्वपि ।\nन भुञ्जते किमर्थं ते तन्मे शंसितुमर्हसि\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2204110, "chapter_id": 5350, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2204111, "chapter_id": 5350, "verse_number": "४१", "content_sanskrit": "परैः सञ्चोदिता धर्मं कुर्वते न स्वकामतः ।\nस्वयं श्रद्धां बहिष्कृत्य कुर्वन्ति च रुदन्ति च\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2204112, "chapter_id": 5350, "verse_number": "", "content_sanskrit": "तादृशा मरणं प्राप्ताः पुनर्जन्मनि शोभने ।\nफलानि तानि सम्प्राप्य भुञ्जते न कदाचन ।\nरक्षन्तो वर्धयन्तश्च आसते निधिपालवत्\t ॥४२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2204113, "chapter_id": 5350, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2204114, "chapter_id": 5350, "verse_number": "", "content_sanskrit": "केचिद् धनवियुक्ताश्च भोगयुक्ता महेश्वर ।\nमानुषाः सम्प्रदृश्यन्ते तन्मे शंसितुमर्हसि\t ॥४३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2204115, "chapter_id": 5350, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2204116, "chapter_id": 5350, "verse_number": "४४", "content_sanskrit": "आनृशंस्यपरा ये तु धर्मकामाश्च दुर्गताः ।\nपरोपकारं कुर्वन्ति दीनानुग्रहकारणात्\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2204117, "chapter_id": 5350, "verse_number": "४५", "content_sanskrit": "प्रतिदद्युः परधनं नष्टं वाऽन्यैर्हृतं धनम् ।\nनित्यं ये दातुमनसो नरा वित्तेष्वसत्स्वपि\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2204118, "chapter_id": 5350, "verse_number": "४६", "content_sanskrit": "कालधर्मवशं प्राप्ताः पुनर्जन्मनि ते नराः ।\nएते धनवियुक्ताश्च भोगयुक्ता भवन्त्युत\t ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2204119, "chapter_id": 5350, "verse_number": "४७", "content_sanskrit": "धर्मदानोपदेशं वा कर्तव्यमिति निश्चयः ।\nइति ते कथितं देवि किं भूयः श्रोतुमिच्छसि\t ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2204120, "chapter_id": 5350, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे वर्णविभागादिनिमित्तकथनं नाम एकोत्तरद्विशततमोऽध्यायः ॥२०१॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]