[{"id": 2023353, "chapter_id": 1499, "verse_number": "३-१३७-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023354, "chapter_id": 1499, "verse_number": "३-१३७-१", "content_sanskrit": "एषा मधुविला नाम समङ्गा संप्रकाशते।\nएतत्कर्दमिलं नाम भरतस्याभिषेचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023355, "chapter_id": 1499, "verse_number": "३-१३७-२", "content_sanskrit": "अलक्ष्म्या किल संयुक्तो वृत्रं हत्वा शचीपतिः।\nआप्लुतः सर्वपापेभ्यः समङ्गायां व्यमुच्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023356, "chapter_id": 1499, "verse_number": "३-१३७-३", "content_sanskrit": "एतद्विनशनं कुक्षौ मैनाकस्य नरर्षभ।\nअदितिर्यत्रपुत्रार्थं तदन्नमपचत्पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023357, "chapter_id": 1499, "verse_number": "३-१३७-४", "content_sanskrit": "एनं पर्वतराजानमारुह्य भरतर्षभाः।\nअयशस्यामसंशब्द्यामलक्ष्मीं व्यपनोत्स्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023358, "chapter_id": 1499, "verse_number": "३-१३७-५", "content_sanskrit": "एते कनखला राजन्नृषीणां दयिता नगाः।\nएषा प्रकाशते गङ्गा युधिष्ठिर यशस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023359, "chapter_id": 1499, "verse_number": "३-१३७-६", "content_sanskrit": "सनत्कुमारो भगवानत्र सिद्धिमगात्पुरा।\nआजमीढावगाह्यैनां सर्वपापैः प्रमोक्ष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023360, "chapter_id": 1499, "verse_number": "३-१३७-७", "content_sanskrit": "अपां ह्रदं च पुण्याख्यं भृगुतुन्दं च पर्वतम्।\nतूष्णीं गङ्गां च कौन्तेय सानुजः समुपस्पृश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023361, "chapter_id": 1499, "verse_number": "३-१३७-८", "content_sanskrit": "आश्रमः स्थूलशिरसो रमणीयः प्रकाशते।\nअत्र मानं च कौन्तेय क्रोधं चैव विवर्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023362, "chapter_id": 1499, "verse_number": "३-१३७-९", "content_sanskrit": "एष रैभ्याश्रमः श्रीमान्पाण्डवेय प्रकाशते।\nभारद्वाजो यत्रकविर्यवक्रीतो व्यनश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023363, "chapter_id": 1499, "verse_number": "३-१३७-१०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023364, "chapter_id": 1499, "verse_number": "३-१३७-१०", "content_sanskrit": "कथं युक्तोऽभवदृषिर्भरद्वाजः प्रतापवान्।\nकिमर्थं च यवक्रीतः पुत्रोऽनश्यत वै मुनेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023365, "chapter_id": 1499, "verse_number": "३-१३७-११", "content_sanskrit": "एतत्सर्वं यथावृत्तं श्रोतुमिच्छामि तत्त्वतः।\nकर्मभिर्देवकल्पानां कीर्त्यमानैर्भृशं रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023366, "chapter_id": 1499, "verse_number": "३-१३७-१२x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023367, "chapter_id": 1499, "verse_number": "३-१३७-१२", "content_sanskrit": "भरद्वाजश्च रैभ्यश्च सखायौ संबभूवतुः।\nतावूषतुरिहात्यन्तं प्रीयमाणौ वनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023368, "chapter_id": 1499, "verse_number": "३-१३७-१३", "content_sanskrit": "रैभ्यस्य तु सुतावास्तामर्वावसुपरावसू।\nआसीद्यवक्रीः पुत्रस्तु भरद्वाजस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023369, "chapter_id": 1499, "verse_number": "३-१३७-१४", "content_sanskrit": "रैभ्यो विद्वान्सहापत्यस्तपस्वी चेतरोऽभवत्।\nतयोश्चाप्यतुला प्रीतिरभवद्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023370, "chapter_id": 1499, "verse_number": "३-१३७-१५", "content_sanskrit": "यवक्रीः पितरं दृष्ट्वा तपस्विनमसत्कृतम्।\nदृष्ट्वा च सत्कृतं विप्रै रैभ्यं पुत्रैः सहानघः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023371, "chapter_id": 1499, "verse_number": "३-१३७-१६", "content_sanskrit": "पर्यतप्यत तेजस्वी मन्युनाऽभिपरिप्लुतः।\nतपस्तेपे ततो घोरं वेदज्ञानाय पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023372, "chapter_id": 1499, "verse_number": "३-१३७-१७", "content_sanskrit": "सुसमिद्धे महत्यग्नौ शरीरमुपतापयन्।\nजनयामास संतापमिन्द्रस्य सुमहातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023373, "chapter_id": 1499, "verse_number": "३-१३७-१८", "content_sanskrit": "तत इन्द्रो यवक्रीतमुपगम्य युधिष्ठिर।\nअब्रवीत्कस्य हेतोस्त्वमास्थितस्तप उत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023374, "chapter_id": 1499, "verse_number": "३-१३७-१९x", "content_sanskrit": "यवक्रीत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023375, "chapter_id": 1499, "verse_number": "३-१३७-१९", "content_sanskrit": "द्विजानामनधीता वै वेदाः सुरगणार्चित।\nप्रतिभान्त्विति तप्येहमिदं परमकं तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023376, "chapter_id": 1499, "verse_number": "३-१३७-२०", "content_sanskrit": "स्वाध्यायार्थं समारम्भो ममायं पाकशासन।\nतपसा ज्ञातुमिच्छामि सर्वज्ञानानि कौशिक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023377, "chapter_id": 1499, "verse_number": "३-१३७-२१", "content_sanskrit": "कालेन महता वेदाः शक्या गुरुमुखाद्विभो।\nप्राप्तुं तस्मादयं यत्नः परमो मे समास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023378, "chapter_id": 1499, "verse_number": "३-१३७-२२x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2023379, "chapter_id": 1499, "verse_number": "३-१३७-२२", "content_sanskrit": "अमार्ग एष विप्रर्षे येन त्वं यातुमिच्छसि।\nकिं विघातेन ते विप्र गच्छाधीहि गुरोर्मुखात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2023380, "chapter_id": 1499, "verse_number": "३-१३७-२३x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2023381, "chapter_id": 1499, "verse_number": "३-१३७-२३", "content_sanskrit": "एवमुक्त्वा गतः शक्रो यवक्रीरपि भारत।\nभूय एवाकरोद्यत्नं तपस्यमितविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2023382, "chapter_id": 1499, "verse_number": "३-१३७-२४", "content_sanskrit": "घोरेण तपसा राजंस्तप्यमानो महत्तपः।\nसंतापयामास भृशं देवेन्द्रमिति नः श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2023383, "chapter_id": 1499, "verse_number": "३-१३७-२५", "content_sanskrit": "तं तथा तप्यमानं तु तपस्तीव्रं महामुनिम्।\nउपेत्य बलभिद्देवो वारयामास वै पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2023384, "chapter_id": 1499, "verse_number": "३-१३७-२६", "content_sanskrit": "अशक्योऽर्थः समारब्धो नैतद्बुद्धिकृतं तव।\nप्रतिभास्यन्ति वै वेदास्तव चैव पितुश्च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2023385, "chapter_id": 1499, "verse_number": "३-१३७-२७x", "content_sanskrit": "यवक्रीत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2023386, "chapter_id": 1499, "verse_number": "३-१३७-२७", "content_sanskrit": "न चैतदेवं क्रियते देवराजसमीप्सितम्।\nमहता नियमेनाहं तप्स्ये घोरतरं तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2023387, "chapter_id": 1499, "verse_number": "३-१३७-२८", "content_sanskrit": "समिद्धेऽग्नावुपकृत्याङ्गमङ्गं\nहोष्यामि वा मघवंस्तन्निबोध।\nयद्येतदेवं न करोषि कामं\nममेप्सितं देवराजेह सर्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2023388, "chapter_id": 1499, "verse_number": "३-१३७-२९x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2023389, "chapter_id": 1499, "verse_number": "३-१३७-२९", "content_sanskrit": "निश्चयं तमभिज्ञाय मुनेस्तस्य महात्मनः।\nप्रतिवारणहेत्वर्थं बुद्ध्या संचिन्त्य बुद्धिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2023390, "chapter_id": 1499, "verse_number": "३-१३७-३०", "content_sanskrit": "तत इन्द्रोऽकरोद्रूपं ब्राह्मणस्य तपस्विनः।\nअनेकशतवर्षस्य दुर्बलस्य सयक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2023391, "chapter_id": 1499, "verse_number": "३-१३७-३१", "content_sanskrit": "यवक्रीतस्य यत्तीर्थमुचितं शैचकर्मणि।\nभागीरथ्यां तत्र सेतुं वालुकाभिश्चकार सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2023392, "chapter_id": 1499, "verse_number": "३-१३७-३२", "content_sanskrit": "यदाऽस्य वदतो वाक्यं न स चक्रे द्विजोत्तमः।\nवालुकाभिस्ततः शक्रो गङ्गां समभिपूरयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2023393, "chapter_id": 1499, "verse_number": "३-१३७-३३", "content_sanskrit": "वालुकामुष्टिमनिशं भागीरथ्यां व्यसर्जयत्।\nस्नातुमभ्यागतं शक्रो यवक्रीतमदर्शयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2023394, "chapter_id": 1499, "verse_number": "३-१३७-३४", "content_sanskrit": "तं ददर्श यवक्रीतो यत्नवन्तं निबन्धने।\nप्रहसंश्चाब्रवीद्वाक्यमिदं स मुनिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2023395, "chapter_id": 1499, "verse_number": "३-१३७-३५", "content_sanskrit": "किमिदं वर्तते ब्रह्मन्किंच ते ह चिकीर्षितम्।\nअतीव हि महान्यत्नः क्रियतेऽयं निरर्थकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2023396, "chapter_id": 1499, "verse_number": "३-१३७-३६x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2023397, "chapter_id": 1499, "verse_number": "३-१३७-३६", "content_sanskrit": "बन्धिष्ये सेतुना गङ्गां सुखः पन्था भविष्यति।\nक्लिश्यते हि जनस्तात तरमाणः पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2023398, "chapter_id": 1499, "verse_number": "३-१३७-३७x", "content_sanskrit": "यवक्रीत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2023399, "chapter_id": 1499, "verse_number": "३-१३७-३७", "content_sanskrit": "नायं शक्यस्त्वया बद्धुं महानोघस्तपोधन।\nअशक्याद्विनिवर्तस्व शक्यमर्थं समारभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2023400, "chapter_id": 1499, "verse_number": "३-१३७-३८x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2023401, "chapter_id": 1499, "verse_number": "३-१३७-३८", "content_sanskrit": "यथैव भवता चेद तपो वेदार्थमुद्यतम्।\nअशक्यं तद्वदस्माभिरयं भारः समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2023402, "chapter_id": 1499, "verse_number": "३-१३७-३९x", "content_sanskrit": "यवक्रीत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2023403, "chapter_id": 1499, "verse_number": "३-१३७-३९", "content_sanskrit": "यथा तव निरर्थोऽयमारम्भस्त्रिदशेश्वर।\nतथा यदि ममापीदं मन्यसे पाकशासन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2023404, "chapter_id": 1499, "verse_number": "३-१३७-४०", "content_sanskrit": "क्रियतां यद्भवेच्छक्यं त्वया सुरगणेश्वर।\nवरांश्च मे प्रयच्छान्यासन्यैर्विद्वान्भवितास्म्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2023405, "chapter_id": 1499, "verse_number": "३-१३७-४१x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2023406, "chapter_id": 1499, "verse_number": "३-१३७-४१", "content_sanskrit": "तस्मै प्रादाद्वरानिन्द्र उक्तवान्यान्महातपाः।\nप्रतिभास्यन्ति ते वेदाः पित्रा सह यथेप्सिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2023407, "chapter_id": 1499, "verse_number": "३-१३७-४२", "content_sanskrit": "यच्चान्यत्काङ्क्षसे कामं यवक्रीर्गम्यतामिति।\nस लब्धकाम पितरं समेत्याथेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2023408, "chapter_id": 1499, "verse_number": "३-१३७-४३x", "content_sanskrit": "यवक्रीत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2023409, "chapter_id": 1499, "verse_number": "३-१३७-४३", "content_sanskrit": "प्रतिभास्यन्ति वै वेदा मम तातस्य चोभयोः।\nअपि चान्यान्भविष्यावो वरा लब्धास्तथा मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2023410, "chapter_id": 1499, "verse_number": "३-१३७-४४x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2023411, "chapter_id": 1499, "verse_number": "३-१३७-४४", "content_sanskrit": "दर्पस्ते भविता तात वराँल्लब्ध्वा यथेप्सितान्।\nस दर्पपर्णः कृपणः क्षिप्रमेव विनङ्क्ष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2023412, "chapter_id": 1499, "verse_number": "३-१३७-४५", "content_sanskrit": "अत्राप्युदाहरन्तीमा गाथा देवैरुदाहृताः।\nमुनिरासीत्पुरा पुत्र बालधिर्नाम विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2023413, "chapter_id": 1499, "verse_number": "३-१३७-४६", "content_sanskrit": "स पुत्रशोकादुद्विग्रस्तपस्तेपे सुदुष्करम्।\nभवेन्मम सुतोऽमर्त्य इतितं लब्धवांश्च सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2023414, "chapter_id": 1499, "verse_number": "३-१३७-४७", "content_sanskrit": "तस्य प्रसादो वै देवैः कृतो न त्वमरैः समः।\nनामर्त्यो विद्यते मर्त्यो निमित्तायुर्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2023415, "chapter_id": 1499, "verse_number": "३-१३७-४८x", "content_sanskrit": "बालधिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2023416, "chapter_id": 1499, "verse_number": "३-१३७-४८", "content_sanskrit": "यथेमे पर्वताः शश्वत्तिष्ठन्ति सुरसत्तमाः।\nतावज्जीवेन्मम् सुतो निर्वाणमुत मे मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2023417, "chapter_id": 1499, "verse_number": "३-१३७-४९x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2023418, "chapter_id": 1499, "verse_number": "३-१३७-४९", "content_sanskrit": "तस्य पुत्रस्तदा जत्रे मेधावी क्रोधनस्तदा।\nस तु लब्धवरो दर्पादृषींश्चैवावमन्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2023419, "chapter_id": 1499, "verse_number": "३-१३७-५०", "content_sanskrit": "विकुर्वाणो मुनीनां च व्यचरत्स महीमिमाम्।\nआससाद महावीर्यं धनुषाक्षं मनीषिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2023420, "chapter_id": 1499, "verse_number": "३-१३७-५१", "content_sanskrit": "तस्यापचक्रे मेधावी तं शशाप स वीर्यवान्।\nभव भस्मेति चोक्तः स न भस्म समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2023421, "chapter_id": 1499, "verse_number": "३-१३७-५२", "content_sanskrit": "धनुषाक्षस्तु तं दृष्ट्वा मेधाविनमनामयम्।\n`मुनिस्तत्कारणं ज्ञात्वा स्वयं महिषरूपधृत्।\nशृङ्गेणाद्रीनचलयत्ततोऽयंभस्मसादभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2023422, "chapter_id": 1499, "verse_number": "३-१३७-५३", "content_sanskrit": "निमित्तमस्य महर्षिर्भेदयामास पर्वतान्।\nस निमित्ते विनष्टे तु ममार सहसा शिशुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2023423, "chapter_id": 1499, "verse_number": "३-१३७-५४", "content_sanskrit": "तं मृतं पुत्रमादाय विललाप ततः पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2023424, "chapter_id": 1499, "verse_number": "३-१३७-५५", "content_sanskrit": "लालप्यमानं तं दृष्ट्वा मुनयः परमार्तवत्।\nऊचुर्वेदविदः सर्वै गाथां यां तां निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2023425, "chapter_id": 1499, "verse_number": "३-१३७-५६", "content_sanskrit": "न दिष्टमर्थमत्येतुमीशोऽमर्त्यः कथंचन।\nमहर्षिर्भेदयामास धनुषाक्षो महीधरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2023426, "chapter_id": 1499, "verse_number": "३-१३७-५७", "content_sanskrit": "एवं लब्ध्वा वरान्बाला दर्पपूर्णास्तपस्विनः।\nक्षिप्रमेव विनश्यन्ति यथा न स्यात्तथा भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2023427, "chapter_id": 1499, "verse_number": "३-१३७-५८", "content_sanskrit": "एष रैभ्यो महावीर्यः पुत्रौ चास्य तथाविधौ।\nतं यथा पुत्र नाभ्येषि तथा कुर्यास्त्वतन्द्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2023428, "chapter_id": 1499, "verse_number": "३-१३७-५९", "content_sanskrit": "स हि क्रुद्धः समर्थस्त्वां पुत्र पीडयितुं रुषा।\nरैभ्यश्चापि तपस्वी च कोपनश्च महानृषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2023429, "chapter_id": 1499, "verse_number": "३-१३७-६०x", "content_sanskrit": "यवक्रीत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2023430, "chapter_id": 1499, "verse_number": "३-१३७-६०", "content_sanskrit": "एव करिष्ये मा तापं तात कार्षीः कथंचन।\nयथा हि मे भवान्मान्यस्तथा रैभ्यः पिता मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2023431, "chapter_id": 1499, "verse_number": "३-१३७-६१x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2023432, "chapter_id": 1499, "verse_number": "३-१३७-६१", "content_sanskrit": "उक्त्वा स पितरं श्लक्ष्ण यवक्रीरकुतोभयः।\nविप्रकुर्वन्नृषीनन्यानतुष्यत्परया मुदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2023433, "chapter_id": 1499, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि सप्तत्रिंशदधिकशततमोऽध्यायः ॥ १३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]