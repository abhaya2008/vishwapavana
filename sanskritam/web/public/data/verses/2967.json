[{"id": 2092394, "chapter_id": 2967, "verse_number": "१३-९७-१", "content_sanskrit": "युधिष्ठिर उवाच।\nइदं देयमिदं देयमितीयं श्रुतिचोदनात्।\nबहुदेयाश्च राजानः किंस्विद्देयमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092395, "chapter_id": 2967, "verse_number": "१३-९७-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092396, "chapter_id": 2967, "verse_number": "१३-९७-२", "content_sanskrit": "अति दानानि सर्वाणि पृथिवीदानमुच्यते।\nअचला ह्यक्षया भूमिर्दोग्ध्री कामानिहोत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092397, "chapter_id": 2967, "verse_number": "१३-९७-३", "content_sanskrit": "दोग्ध्री वासांसि रत्नानि पशून्व्रीहियवांस्तथा।\nभूमिदः सर्वभूतेषु शाश्वतीरेधते समाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092398, "chapter_id": 2967, "verse_number": "१३-९७-४", "content_sanskrit": "यावद्भूमेरायुरिह तावद्भूमिद एधते।\nन भूमिदानादस्तीह परं किञ्चिद्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092399, "chapter_id": 2967, "verse_number": "१३-९७-५", "content_sanskrit": "अप्यल्पं प्रददुः सर्वे पृथिव्या इति नः श्रुतम्।\nभूमिमेव ददुः सर्वे भूमिं ते भुञ्जते जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092400, "chapter_id": 2967, "verse_number": "१३-९७-६", "content_sanskrit": "स्वकर्मैवोपजीवन्ति नरा इह परत्र च।\nभूमिः पतिं महादेवी दातारं कुरुते प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092401, "chapter_id": 2967, "verse_number": "१३-९७-७", "content_sanskrit": "य एतां दक्षिणां दद्यादक्षयां राजसत्तम।\nपुनर्नरत्वं सम्प्राप्य भवेत्स पृथिवीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092402, "chapter_id": 2967, "verse_number": "१३-९७-८", "content_sanskrit": "यथा दानं तथा भोग इति धर्मेषु निश्चयः।\nसङ्ग्रामे वा तनुं जह्याद्दद्याच्च पृथिवीमिमांम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092403, "chapter_id": 2967, "verse_number": "१३-९७-९", "content_sanskrit": "इत्येतत्क्षत्रबन्धूनां वदन्ति परमाशिषः।\nपुनाति दत्ता पृथिवी दातारमिति शुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092404, "chapter_id": 2967, "verse_number": "१३-९७-१०", "content_sanskrit": "अपि पापसमाचारं ब्रह्मघ्नमपि चानृतम्।\nसैव पापं प्लावयति सैव पापात्प्रमोचयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092405, "chapter_id": 2967, "verse_number": "१३-९७-११", "content_sanskrit": "अपि पापकृतां राज्ञां प्रतिगृह्णन्ति साधवः।\nपृथिवीं नान्यदिच्छन्ति पावनं जगती यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092406, "chapter_id": 2967, "verse_number": "१३-९७-१२", "content_sanskrit": "नामास्याः प्रियदत्तेति गुह्यं देव्याः सनातनम्।\nदानं वाऽप्यथवाऽदानं नामास्याः प्रथमप्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092407, "chapter_id": 2967, "verse_number": "१३-९७-१३", "content_sanskrit": "य एतां विदुषे दद्यात्पृथिवीं पृथिवीपतिः।\nपृथिव्यामेतदिष्टं स राजा राज्यमितो व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092408, "chapter_id": 2967, "verse_number": "१३-९७-१४", "content_sanskrit": "पुनश्चासौ जनिं प्राप्य राजवत्स्यान्न संशयः।\nतस्मात्प्राप्यैव पृथिवीं दद्याद्विप्राय पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092409, "chapter_id": 2967, "verse_number": "१३-९७-१५", "content_sanskrit": "नाभूमिपतिना भूमिरधिष्ठेया कथञ्चन।\nन च वस्त्रेणि वा गूहेदन्तर्धानेन वा चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092410, "chapter_id": 2967, "verse_number": "१३-९७-१६", "content_sanskrit": "ये चान्ये भूमिमिच्छेयुः कुर्युरेवं न संशयः।\nयः साधोर्भूमिमादत्ते न भूमिं विन्दते तु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092411, "chapter_id": 2967, "verse_number": "१३-९७-१७", "content_sanskrit": "भूमिं दत्त्वा तु साधुभ्यो विन्दते भूमिमुत्तमाम्।\nप्रेत्य चेह च धर्मात्मा सम्प्राप्नोति महद्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092412, "chapter_id": 2967, "verse_number": "१३-९७-१८", "content_sanskrit": "`एकाहारकरीं दत्त्वा षष्ठिसाहस्रमूर्ध्वगः।\nतावत्या हरणे पृथ्व्या नरकं द्विगुणोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092413, "chapter_id": 2967, "verse_number": "१३-९७-१९", "content_sanskrit": "यस्य विप्रास्तु शंसन्ति साधोर्भूमिं सदैव हि।\nन तस्य शत्रवो राजन्प्रशंसन्ति वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092414, "chapter_id": 2967, "verse_number": "१३-९७-२०", "content_sanskrit": "यत्किञ्चित्पुरुषः पापं कुरुते वृत्तिकर्शितः।\nअपि गोचर्ममात्रेण भूमिदानेन पूयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2092415, "chapter_id": 2967, "verse_number": "१३-९७-२१", "content_sanskrit": "येऽपि सङ्गीर्णाकर्माणो राजानो रौद्रकर्मिणः।\nतेभ्यः पवित्रमाख्येयं भूमिदानमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2092416, "chapter_id": 2967, "verse_number": "१३-९७-२२", "content_sanskrit": "अल्पान्तरमिदं शश्वत्पुराणा मेनिरे जनाः।\nयो यजेताश्वमेधेन दद्याद्वा साधवे महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2092417, "chapter_id": 2967, "verse_number": "१३-९७-२३", "content_sanskrit": "अपि चेत्सुकृतं कृत्वा शङ्केरन्नपि पण्डिताः।\nअशंक्यमेकमेवैतद्भूमिदानमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2092418, "chapter_id": 2967, "verse_number": "१३-९७-२४", "content_sanskrit": "सुवर्णं रजतं वस्त्रं मणिमुक्तावसूनि च।\nसर्वमेतन्महाप्राज्ञो ददाति वसुधां ददत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2092419, "chapter_id": 2967, "verse_number": "१३-९७-२५", "content_sanskrit": "तपो यज्ञः श्रुतं शीलमलोभः सत्यसन्धता।\nगुरुदैवतपूजा च एता वर्तन्ति भूमिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2092420, "chapter_id": 2967, "verse_number": "१३-९७-२६", "content_sanskrit": "भर्तुनिःश्रेयसे युक्तास्त्यक्तात्मानो रणे हताः।\nब्रह्मलोकगताः सिद्धा नातिक्रामन्ति भूमिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2092421, "chapter_id": 2967, "verse_number": "१३-९७-२७", "content_sanskrit": "यथा जनित्री स्वं पुत्रं क्षीरेण भरते सदा।\nअनुगृह्णाति दातारं तथा सर्वरसैर्मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2092422, "chapter_id": 2967, "verse_number": "१३-९७-२८", "content_sanskrit": "मृत्युर्वैकिंकरो दण्डस्तापो वह्नेः सुदारुणः।\nघोराश्च वारुणाः पाशा नोपसर्पन्ति भूमिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2092423, "chapter_id": 2967, "verse_number": "१३-९७-२९", "content_sanskrit": "पितॄंश्च पितृलोकस्थान्देवलोके च देवताः।\nसन्तर्पयति शान्तात्मा यो ददाति वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2092424, "chapter_id": 2967, "verse_number": "१३-९७-३०", "content_sanskrit": "कृशाय म्रियमाणाय वृत्तिग्लानाय सीदते।\nभूमिं वृत्तिकरीं दत्त्वा सत्री भवति मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2092425, "chapter_id": 2967, "verse_number": "१३-९७-३१", "content_sanskrit": "यथा धावति गौर्वत्सं स्रवन्ती वत्सला पयः।\nएवमेव महाभाग भूमिर्भरति भूमिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2092426, "chapter_id": 2967, "verse_number": "१३-९७-३२", "content_sanskrit": "हलकृष्टां महीं दत्त्वा सबीजां सफलामपि।\nसोदकं वाऽपि शरणं तथा भवति कामदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2092427, "chapter_id": 2967, "verse_number": "१३-९७-३३", "content_sanskrit": "ब्राह्मणं वृत्तसम्पन्नमाहिताग्निं शुचिव्रतम्।\nनरः प्रतिग्राह्य महीं न याति यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2092428, "chapter_id": 2967, "verse_number": "१३-९७-३४", "content_sanskrit": "यथा चन्द्रमसो वृद्धिरहन्यहनि जायते।\nतथा भूमिकृतं दानं सस्येसस्ये विवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2092429, "chapter_id": 2967, "verse_number": "१३-९७-३५", "content_sanskrit": "अत्र गाथा भूमिगीताः कीर्तयन्ति पुराविदः।\nयाः श्रुत्वा जामदग्न्येन दत्ता भूः काश्यपाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2092430, "chapter_id": 2967, "verse_number": "१३-९७-३६", "content_sanskrit": "मामेवादत्त मां दत्त मां दत्त्वा मामवाप्स्यथ।\nअस्मिँल्लोके परे चैव तद्दत्तं जायते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2092431, "chapter_id": 2967, "verse_number": "१३-९७-३७", "content_sanskrit": "य इमां व्याहृतिं वेद ब्राह्मणो वेदसम्मिताम्।\nश्राद्धस्य हूयमानस्य ब्रह्मभूयं स गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2092432, "chapter_id": 2967, "verse_number": "१३-९७-३८", "content_sanskrit": "कृत्यानामभिशप्तानामरिष्टशमनं महत्।\nप्रायश्चित्तं महीं दत्त्वा पुनात्युभयतो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2092433, "chapter_id": 2967, "verse_number": "१३-९७-३९", "content_sanskrit": "पुनाति य इदं वेद वेदवादं तथैव च।\nप्रकृतिः सर्वभूतानां भूमिर्वै शाश्वती मता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2092434, "chapter_id": 2967, "verse_number": "१३-९७-४०", "content_sanskrit": "अभिषिच्यैव नृपतिं श्रावयेदिममागमम्।\nयथा श्रुत्वा महीं दद्यान्नादद्यात्साधुतश्च तां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2092435, "chapter_id": 2967, "verse_number": "१३-९७-४१", "content_sanskrit": "सोऽयं कृत्स्नो ब्राह्मणार्थो राजार्थश्चाप्यसंशयः।\nराजा हि धर्मकुशलः प्रथमं भूतिलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2092436, "chapter_id": 2967, "verse_number": "१३-९७-४२", "content_sanskrit": "अथ येषामधर्मज्ञो राजा भवति नास्तिकः।\nन ते सुखं प्रबुध्यन्ति न सुखं प्रस्वपन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2092437, "chapter_id": 2967, "verse_number": "१३-९७-४३", "content_sanskrit": "सदा भवन्ति चोद्विग्नास्तस्य दुश्चरितैर्नराः।\nयोगक्षेमा हि बहवो राष्ट्रं नास्याविशन्ति तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2092438, "chapter_id": 2967, "verse_number": "१३-९७-४४", "content_sanskrit": "अथ येषां पुनः प्राज्ञो राजा भवति धार्मिकः।\nसुखं ते प्रतिबुध्यन्ते सुसुखं प्रस्वपन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2092439, "chapter_id": 2967, "verse_number": "१३-९७-४५", "content_sanskrit": "तस्य राज्ञः शुभे राज्ये कर्मभिर्निर्वृता नराः।\nयोगक्षेमेण वृष्ट्या च विवर्धन्ते स्वकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2092440, "chapter_id": 2967, "verse_number": "१३-९७-४६", "content_sanskrit": "स कुलीनः स पुरुषः स बन्धुः स च पुण्यकृत्।\nस दाता स च विक्रान्तो यो ददाति वसुन्धरां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2092441, "chapter_id": 2967, "verse_number": "१३-९७-४७", "content_sanskrit": "आदित्या इव दीप्यन्ते तेजसा भुवि मानवाः।\nददन्ति वसुधां स्फीतां ये वेदविदुषि द्विजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2092442, "chapter_id": 2967, "verse_number": "१३-९७-४८", "content_sanskrit": "यथा सस्यानि रोहन्ति प्रकीर्णानि महीतले।\nतथा कामाः प्ररोहन्ति भूमिदानसमार्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2092443, "chapter_id": 2967, "verse_number": "१३-९७-४९", "content_sanskrit": "आदित्यो वरुणो विष्णुर्ब्रह्मा सोमो हुताशनः।\nशूलिपाणिश्च भगवान्प्रतिनन्दन्ति भूमिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2092444, "chapter_id": 2967, "verse_number": "१३-९७-५०", "content_sanskrit": "भूमौ जायन्ति पुरुषा भूमौ निष्ठां व्रजन्ति च।\nचतुर्विधो हि लोकोऽयं योऽयं भूमिगुणात्मकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2092445, "chapter_id": 2967, "verse_number": "१३-९७-५१", "content_sanskrit": "एषा माता पिता चैव जगतः पृथिवीपते।\nनानया सदृशं भूतं किञ्चिदस्ति जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2092446, "chapter_id": 2967, "verse_number": "१३-९७-५२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nबृहस्पतेश्च संवादमिन्द्रस्य च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2092447, "chapter_id": 2967, "verse_number": "१३-९७-५३", "content_sanskrit": "इष्ट्वा क्रतुशतेनाथ महता दक्षिणावता।\nमघवा वाग्विदांश्रेष्ठं पप्रच्छेदं बृहस्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2092448, "chapter_id": 2967, "verse_number": "१३-९७-५४", "content_sanskrit": "भगवन्केन दानेन स्वर्गतः सुखमेधते।\nयदक्षयमहार्यं च तद्ब्रूहि वदतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2092449, "chapter_id": 2967, "verse_number": "१३-९७-५५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2092450, "chapter_id": 2967, "verse_number": "१३-९७-५५", "content_sanskrit": "इत्युक्तृः स सुरेन्द्रेण ततो देवपुलोहितः।\nबृहस्पतिर्बृहत्तेजाः प्रत्युवाच शतक्रतुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2092451, "chapter_id": 2967, "verse_number": "१३-९७-५६", "content_sanskrit": "सुवर्णदानं गोदानं भूमिदानं च वृत्रहन्।\n`विद्यादानं च कन्यानां दानं पापहरं परम्।\nदददेतान्महाप्राज्ञः सर्वपापैः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2092452, "chapter_id": 2967, "verse_number": "१३-९७-५७", "content_sanskrit": "न भूमिदानाद्देवेन्द्र परं किञ्चिदिति प्रभो।\nविशिष्टमिति मन्येऽहं यता प्राहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2092453, "chapter_id": 2967, "verse_number": "१३-९७-५८", "content_sanskrit": "`ब्राह्मणार्थे गवार्थे वा राष्ट्रघातेऽथ स्वामिनः।\nकुलस्त्रीणां परिभवे मृतास्ते भूमिपैः समाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2092454, "chapter_id": 2967, "verse_number": "१३-९७-५९", "content_sanskrit": "ये शूरा निहता युद्धे स्वर्याता रणगृद्धिनः।\nसर्वे ते विबुधश्रेष्ठ नातिक्रामन्ति भूमिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2092455, "chapter_id": 2967, "verse_number": "१३-९७-६०", "content_sanskrit": "भर्तुर्निःश्रेयसे युक्तास्त्यक्तात्मानो रणे हताः।\nब्राह्मलोकगता युक्ता नातिक्रामन्ति भूमिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2092456, "chapter_id": 2967, "verse_number": "१३-९७-६१", "content_sanskrit": "पञ्च पूर्वा हि पुरुषाः षडन्ये वसुधां गताः।\nएकादश ददद्भूमिं परित्रातीह मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2092457, "chapter_id": 2967, "verse_number": "१३-९७-६२", "content_sanskrit": "रत्नोपकीर्णां वसुधां यो ददाति पुरंदर।\nस मुक्तः सर्वकलुषैः स्वर्गलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2092458, "chapter_id": 2967, "verse_number": "१३-९७-६३", "content_sanskrit": "महीं स्फीतां ददद्राजन्सर्वकामगुणान्विताम्।\nराजाधिराजो भवति तद्धि दानमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2092459, "chapter_id": 2967, "verse_number": "१३-९७-६४", "content_sanskrit": "सर्वकामसमायुक्तां काश्यपीं यः प्रयच्छति।\nसर्वभूतानि मन्यन्ते मां ददातीति वासव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2092460, "chapter_id": 2967, "verse_number": "१३-९७-६५", "content_sanskrit": "सर्वकामदुघां धेनुं सर्वकामगुणान्विताम्।\nददाति यः सहस्राक्ष स्वर्गं याति स मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2092461, "chapter_id": 2967, "verse_number": "१३-९७-६६", "content_sanskrit": "मधुसर्पिःप्रवाहिण्यः पयोदधिवहास्तथा।\nसरितस्तपर्यन्तीह सुरेन्द्र वसुधाप्रदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2092462, "chapter_id": 2967, "verse_number": "१३-९७-६७", "content_sanskrit": "भूमिप्रदानान्नृपतिर्मुच्यते सर्वकिल्बिषात्।\nन हि भूमिप्रदानेन दानमन्यद्विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2092463, "chapter_id": 2967, "verse_number": "१३-९७-६८", "content_sanskrit": "ददाति यः समुन्द्रान्तां पृथिवीं शस्त्रनिर्जिताम्।\nतं जनाः कथयन्तीह यावद्धरति गौरियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2092464, "chapter_id": 2967, "verse_number": "१३-९७-६९", "content_sanskrit": "पुण्यामृद्धिरसां भूमिं यो ददाति पुरंदर।\nन तस्य लोकाः क्षीयन्ते भूमिदानगुणान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2092465, "chapter_id": 2967, "verse_number": "१३-९७-७०", "content_sanskrit": "सर्वदा पार्थिवेनेह सततं भूतिमिच्छता।\nभूर्देया विधिवच्छक्र पात्रे सुखमभीप्सुनां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2092466, "chapter_id": 2967, "verse_number": "१३-९७-७१", "content_sanskrit": "अपि कृत्वा नरः पापं भूमिं दत्त्वा द्विजातये।\nसमुत्सृजति तत्पापं जीर्णां त्वचमिवोरगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2092467, "chapter_id": 2967, "verse_number": "१३-९७-७२", "content_sanskrit": "सागरान्सरितः शैलान्काननानि च सर्वशः।\nसर्वमेतन्नरः शक्र ददाति वसुधां ददत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2092468, "chapter_id": 2967, "verse_number": "१३-९७-७३", "content_sanskrit": "तटाकान्युदपानानि स्रोतांसि च सरांसि च।\nस्नेहान्सर्वरसांश्चैव ददाति वसुधां ददत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2092469, "chapter_id": 2967, "verse_number": "१३-९७-७४", "content_sanskrit": "ओषधीर्वीर्यसम्पन्नानगान्पुष्पफलान्वितान्।\nकाननोपलशैलांश्च ददाति वसुधां ददत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2092470, "chapter_id": 2967, "verse_number": "१३-९७-७५", "content_sanskrit": "अग्निष्टोमप्रभृतिभिरिष्ट्वा च स्वाप्तदक्षिणैः।\nन तत्फलमवाप्नोति भूमिदानाद्यदश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2092471, "chapter_id": 2967, "verse_number": "१३-९७-७६", "content_sanskrit": "दाता दशानुगृह्णाति दश हन्ति तथा क्षिपन्।\nपूर्वदत्तां हरन्भूमिं नरकायोपगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2092472, "chapter_id": 2967, "verse_number": "१३-९७-७७", "content_sanskrit": "न ददाति प्रतिश्रुत्य दत्त्वाऽपि च हरेत्तु यः।\nस बद्धो वारुणैः पाशैस्तप्यते मृत्युसासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2092473, "chapter_id": 2967, "verse_number": "१३-९७-७८", "content_sanskrit": "आहिताग्निं सदायज्ञं कृशवृत्तिं प्रियातिथिम्।\nये भरन्ति द्विजश्रेष्ठं नोपसर्पन्ति ते यमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2092474, "chapter_id": 2967, "verse_number": "१३-९७-७९", "content_sanskrit": "ब्राह्मणेष्वनृणीभूतः पार्थिवः स्यात्पुरंदर।\nइतरेषां तु वर्णानां तारयेत्कृशदुर्बलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2092475, "chapter_id": 2967, "verse_number": "१३-९७-८०", "content_sanskrit": "नाच्छिन्द्यात्स्पर्शितां भूमिं परेण त्रिदशाधिप।\nब्राह्मणस्य सुरश्रेष्ठ कृशवृत्तेः कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2092476, "chapter_id": 2967, "verse_number": "१३-९७-८१", "content_sanskrit": "यथाश्रु पतितं तेषां दीनानामथ सीदताम्।\nब्राह्मणानां हृते क्षेत्रे हन्यात्त्रिपुरुषं कुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2092477, "chapter_id": 2967, "verse_number": "१३-९७-८२", "content_sanskrit": "भूमिपालं च्युतं राष्ट्राद्यस्तु संस्थापयेत्पुनः।\nतस्य वासः सहस्राक्ष नाकपृष्ठे महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2092478, "chapter_id": 2967, "verse_number": "१३-९७-८३", "content_sanskrit": "`सुनिर्मितां सुविक्रीतां सुभृतां स्थापयेन्नृप।\nइक्षुभिः सन्ततां भूमिं यवगोधूमसालिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2092479, "chapter_id": 2967, "verse_number": "१३-९७-८४", "content_sanskrit": "गोश्ववाहनपूर्णां वा यो ददाति वसुन्धराम्।\nविमुक्तः सर्वपापेभ्यः स्वर्गलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2092480, "chapter_id": 2967, "verse_number": "१३-९७-८५", "content_sanskrit": "निधिगर्भां ददद्भूमिं सर्वरत्नपरिच्छदाम्।\nअक्षयाँल्लभते लोकान्भूमिसत्रं हि तस्य तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2092481, "chapter_id": 2967, "verse_number": "१३-९७-८६", "content_sanskrit": "विधूय कलुषं सर्वं विरजाः सम्मतः सताम्।\nलोके महीयते सद्भिर्यो ददाति वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2092482, "chapter_id": 2967, "verse_number": "१३-९७-८७", "content_sanskrit": "यथाऽप्सु पतितः शक्र तैलबिन्दुर्विसर्पति।\nतथा भूमिकृतं दानं सस्येसस्ये विवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2092483, "chapter_id": 2967, "verse_number": "१३-९७-८८", "content_sanskrit": "ये रणाग्रे महीपालाः शूराः समितिशोभनाः।\nवध्यन्तेऽभिमुखाः शक्र ब्रह्मलोकं व्रजन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2092484, "chapter_id": 2967, "verse_number": "१३-९७-८९", "content_sanskrit": "नृत्तगीतपरा नार्यो दिव्यमाल्यविभूषिताः।\nउपतिष्ठन्ति देवेन्द्र यथा भूमिप्रदं दिवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2092485, "chapter_id": 2967, "verse_number": "१३-९७-९०", "content_sanskrit": "मोदते च सुखं स्वर्गे देवगन्धर्वपूजितः।\nयो ददाति महीं सम्यग्विधिनेह द्विजातये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2092486, "chapter_id": 2967, "verse_number": "१३-९७-९१", "content_sanskrit": "शतमप्सरसश्चैव दिव्यमाल्यविभूषिताः।\nउपतिष्ठन्ति देवेन्द्र ब्रह्मलोके धराप्रदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2092487, "chapter_id": 2967, "verse_number": "१३-९७-९२", "content_sanskrit": "उपतिष्ठन्ति पुण्यानि सदा भूमिप्रदं नरम्।\nशङ्खं भद्रासनं छत्रं वराश्वा वरवाहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2092488, "chapter_id": 2967, "verse_number": "१३-९७-९३", "content_sanskrit": "भूमिप्रदानात्पुष्पाणि हिरण्यनिचयास्तथा।\nआज्ञा सदाऽप्रतिहता जयशब्दा वसूनि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2092489, "chapter_id": 2967, "verse_number": "१३-९७-९४", "content_sanskrit": "भूमिदानस्य पुण्यानि फलं स्वर्गः पुरन्दर।\nहिरण्यपुष्पाश्चौषध्यः कुशकाञ्चनशाद्वलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2092490, "chapter_id": 2967, "verse_number": "१३-९७-९५", "content_sanskrit": "अमृतप्रसवां भूमिं प्राप्नोति पुरुषो ददत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2092491, "chapter_id": 2967, "verse_number": "१३-९७-९६", "content_sanskrit": "नास्ति भूमिसमं दानं नास्ति मातृसमो गुरुः।\nनास्ति सत्यसमो धर्मो नास्ति दानसमो निधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2092492, "chapter_id": 2967, "verse_number": "१३-९७-९७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2092493, "chapter_id": 2967, "verse_number": "१३-९७-९७", "content_sanskrit": "एतदाङ्गिरसाच्छ्रुत्वा वासवो वसुधामिमाम्।\nवसुरत्नसमाकीर्णां ददावाङ्गिरसे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2092494, "chapter_id": 2967, "verse_number": "१३-९७-९८", "content_sanskrit": "य इदं श्रावयेच्छ्राद्धे भूमिदानस्य संस्तवम्।\nन तस्य रक्षसां भागो नासुराणां भवत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2092495, "chapter_id": 2967, "verse_number": "१३-९७-९९", "content_sanskrit": "अक्षयं च भवेद्दत्तं पितृभ्यस्तन्न संशयः।\nतस्माच्छ्राद्धेष्विदं विद्वान्भुञ्जतः श्रावयेद्द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2092496, "chapter_id": 2967, "verse_number": "१३-९७-१००", "content_sanskrit": "इत्येतत्सर्वदानानां श्रेष्ठमुक्तं तवानघ।\nमया भरतशार्दूल किं भूयः श्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2092497, "chapter_id": 2967, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तनवतितमोऽध्यायः॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}]