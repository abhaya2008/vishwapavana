[{"id": 2094493, "chapter_id": 3020, "verse_number": "१३-१५०-१", "content_sanskrit": "`पराशर उवाच।\nशुश्रूषानिरतो नित्यमरिष्टान्युपलक्षयेत्।\nत्रैवार्षिकं द्विवार्षिकं वा वार्षिकं वा समुत्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094494, "chapter_id": 3020, "verse_number": "१३-१५०-२", "content_sanskrit": "षाण्मासिकं मासिकं वा साप्तरात्रिकमेव वा।\nसर्वांस्तदर्थान्वा विद्यात्तेषां चिह्नानि लभयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094495, "chapter_id": 3020, "verse_number": "१३-१५०-३", "content_sanskrit": "पुरुषं हिरण्मयं यस्तु तिष्ठन्तं दक्षिणामुखम्।\nलक्षयेदुत्तरेणैव मृत्युस्त्रैवार्षिको भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094496, "chapter_id": 3020, "verse_number": "१३-१५०-४", "content_sanskrit": "शुद्धमण्डलमादित्यमरश्मिं सम्प्रपश्यतः।\nसंवत्सरद्वयेनैव तस्य मत्युं समादिशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094497, "chapter_id": 3020, "verse_number": "१३-१५०-५", "content_sanskrit": "ज्योत्स्नायामात्मनश्छायां सच्छिद्रां यः प्रपश्यति।\nमृत्युं संवत्सरेणैव जानीयात्सुविचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094498, "chapter_id": 3020, "verse_number": "१३-१५०-६", "content_sanskrit": "विशिरस्कां यदा छायां पश्येत्पुरुष आत्मनः।\nजानीयादात्मनो मृत्युं षाण्मासेनेह बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094499, "chapter_id": 3020, "verse_number": "१३-१५०-७", "content_sanskrit": "कर्णौ पिधाय हस्ताभ्यां शब्दं न शृणुते यदि।\nजानीयादात्मनो मृत्युं मासेनैव विचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094500, "chapter_id": 3020, "verse_number": "१३-१५०-८", "content_sanskrit": "शवगन्धमुपाघ्राति अन्यद्वा सुरभिं नरः।\nदेवतायतनस्थो वै सप्तरात्रेण मृत्युभाक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094501, "chapter_id": 3020, "verse_number": "१३-१५०-९", "content_sanskrit": "कर्णनासापनयनं दन्यदृष्टिविरागता।\nलुप्तसंज्ञं हि करणं सद्यो मृत्युं समादिशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094502, "chapter_id": 3020, "verse_number": "१३-१५०-१०", "content_sanskrit": "एवमेषामरिष्टानां पश्येदन्यतमं यदि।\nन तं कालं परीक्षेत यथाऽरिष्टं प्रकल्पितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094503, "chapter_id": 3020, "verse_number": "१३-१५०-११", "content_sanskrit": "अभ्यासेन तु कालस्य गच्छेत पुलिनं शुचि।\nतत्र प्राणान्प्रमुञ्चेत तमीशानमनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094504, "chapter_id": 3020, "verse_number": "१३-१५०-१२", "content_sanskrit": "ततोऽन्यदेहमासाद्य गान्धर्वं स्थानमाप्नुयात्।\nतत्रस्थो वसते विंशत्पद्मानि सुहहाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094505, "chapter_id": 3020, "verse_number": "१३-१५०-१३", "content_sanskrit": "गन्धर्वैश्चित्रसेनाद्यैः सहितः सत्कृतस्तथा।\nनीलवैडूर्यवर्णेन विमानेनावभासयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094506, "chapter_id": 3020, "verse_number": "१३-१५०-१४", "content_sanskrit": "नभस्थलमदीनात्मा सार्धमप्सरसां गणैः।\nछन्दकामानुसारी च तत्रतत्र महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094507, "chapter_id": 3020, "verse_number": "१३-१५०-१५", "content_sanskrit": "मोदतेऽमरतुल्यात्मा सदाऽमरगणैः सह।\nपतितश्च क्षये काले क्षणेन विमलद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2094508, "chapter_id": 3020, "verse_number": "१३-१५०-१६", "content_sanskrit": "वैश्यस्य बहुवित्तस्य कुलेऽग्र्ये बहुगोधने।\nअवाप्य तत्र वै जन्म स पूतो देवकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2094509, "chapter_id": 3020, "verse_number": "१३-१५०-१७", "content_sanskrit": "छन्दसा जागतेनैव प्राप्तोपनयनं ततः।\nक्षौमवस्त्रोपकरणं द्विजत्वं समवाप्य तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2094510, "chapter_id": 3020, "verse_number": "१३-१५०-१८", "content_sanskrit": "अधीयमानो वेदार्थान्गुरुशुश्रूषणे रतः।\nब्रह्मचारी जितक्रोधस्तपस्वी जायते ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2094511, "chapter_id": 3020, "verse_number": "१३-१५०-१९", "content_sanskrit": "अधीत्य दक्षिणां दत्त्वा गुरवे विधिपूर्वकम्।\nकृतदारः समुपैति गृहस्थव्रतमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2094512, "chapter_id": 3020, "verse_number": "१३-१५०-२०", "content_sanskrit": "ददाति यजते चैव चज्ञैर्विपुलदक्षिणैः।\nअग्निहोत्रमुपासन्वै जुह्वच्चैव यथाविधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2094513, "chapter_id": 3020, "verse_number": "१३-१५०-२१", "content_sanskrit": "धर्मं सञ्चिनुते नित्यं मृदुगामी जितेन्द्रियः।\nस कालपरिणामात्तु मृत्युना सम्प्रयुज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2094514, "chapter_id": 3020, "verse_number": "१३-१५०-२२", "content_sanskrit": "संस्कृतश्चाग्निहोत्रेण कृतपात्रोपधानवान्।\nसंस्कृतो देहमुत्सृज्य मरुद्भिरुपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2094515, "chapter_id": 3020, "verse_number": "१३-१५०-२३", "content_sanskrit": "मरुद्भिः सहितश्चापि तुल्यतेजा महाद्युतिः।\nबालार्कसमवर्णेन विमानेन विराजता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2094516, "chapter_id": 3020, "verse_number": "१३-१५०-२४", "content_sanskrit": "सुखं चरति तत्रस्तो गन्थर्वाप्सरसां गणैः।\nविरजोम्बरसंवीतस्तप्तकाञ्चनभूषणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2094517, "chapter_id": 3020, "verse_number": "१३-१५०-२५", "content_sanskrit": "छन्दकामानुसारी च द्विगुणं कालमावसेत्।\nसन्निवर्तेत कालेन स्थानादस्मात्परिच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2094518, "chapter_id": 3020, "verse_number": "१३-१५०-२६", "content_sanskrit": "अवितृप्तविहारार्थो दिव्यभोगान्विहाय तु।\nसञ्जायते नृपकुले गजाश्वरथसंकुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2094519, "chapter_id": 3020, "verse_number": "१३-१५०-२७", "content_sanskrit": "पार्थिवीं श्रियमापन्नः श्रीमान्धर्मपतिर्यथा।\nजन्मप्रभृति संस्कारं चौलोपनयनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2094520, "chapter_id": 3020, "verse_number": "१३-१५०-२८", "content_sanskrit": "प्राप्य राजकुले तत्र यथावद्विधिपूर्वकम्।\nछ्दसा त्रैष्टुभेनेह द्विजत्वमुपनीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2094521, "chapter_id": 3020, "verse_number": "१३-१५०-२९", "content_sanskrit": "अधीत्य वेदमखिलं धनुर्वेदं च मुख्यशः।\nसमावृत्तस्ततः पित्रा यौवराज्येऽभिषिच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2094522, "chapter_id": 3020, "verse_number": "१३-१५०-३०", "content_sanskrit": "कृतदारक्रियः श्रीमान्राज्यं सम्प्राप्य धर्मतः।\nप्रजाः पालयते सम्यक् षड्भागकृतसंविधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2094523, "chapter_id": 3020, "verse_number": "१३-१५०-३१", "content_sanskrit": "यज्ञैर्बहुभिरीजानः सम्यगाप्तार्थदक्षिणैः।\nप्रशासति महीं श्रीमान्राज्यमिन्द्रसमुद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2094524, "chapter_id": 3020, "verse_number": "१३-१५०-३२", "content_sanskrit": "स्वधर्मनिरतो नित्यं पुत्रपौत्रसहायवान्।\nकालस्य वशमापन्नः प्राणांस्त्यजति संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2094525, "chapter_id": 3020, "verse_number": "१३-१५०-३३", "content_sanskrit": "देवराजस्य भवनमिन्द्रलोकमवाप्नुते।\nसम्पूज्यमानस्त्रिदिवैर्विचचार यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2094526, "chapter_id": 3020, "verse_number": "१३-१५०-३४", "content_sanskrit": "राजर्षिभिः पुण्यकृद्भिर्यथा देवपतिस्तथा।\nतैः स्तूयते बन्दिभिस्तु नानावाद्यैः प्रबोध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2094527, "chapter_id": 3020, "verse_number": "१३-१५०-३५", "content_sanskrit": "दिव्यजाम्बूनदमयं भ्राजमानं समन्ततः।\nवराप्सरोभिः सम्पूर्णं देवगन्धर्वसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2094528, "chapter_id": 3020, "verse_number": "१३-१५०-३६", "content_sanskrit": "यानमारुह्य विचरेद्यथा शक्रः शचीपतिः।\nस तत्र वसते षष्टिं पद्मानीह मुदान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2094529, "chapter_id": 3020, "verse_number": "१३-१५०-३७", "content_sanskrit": "सर्वाँल्लोकाननुचरन्महर्द्धिरवभासयन्।\nअथ पुण्यक्षयात्तस्मात्स्थाप्यते भुवि भारत।\nजायते च द्विजकुले वेदवेदाङ्गपारगे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2094530, "chapter_id": 3020, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चाशदधिकशततमोऽध्यायः॥ १५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]