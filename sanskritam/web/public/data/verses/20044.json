[{"id": 7000044000, "chapter_id": 20044, "verse_number": "४४-१", "content_sanskrit": "इन्द्रद्युम्नस्य दक्षिणोदधितटगमनम् ब्रह्मोवाच तस्यां स नृपतिः पूर्वं कुर्वनाज्यमनुत्तमम् ।\nपालयामास मतिमान्प्रजाः पूत्रानिवौरसान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000044001, "chapter_id": 20044, "verse_number": "४४-२", "content_sanskrit": "सत्यवादी महाप्राज्ञः शूरः सर्वगुणाकरः ।\nमतिमान्धर्मसंपन्नः सर्वशास्त्रभृतां वरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000044002, "chapter_id": 20044, "verse_number": "४४-३", "content_sanskrit": "सत्यवाञ्छीलवान्दान्तः श्रीमान्परपुरंजयः ।\nआदित्य इव तेजोभी रूपैरास्विनयोरिव ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000044003, "chapter_id": 20044, "verse_number": "४४-४", "content_sanskrit": "वर्धमानसुराश्चर्यः शक्रतुल्यपराक्रमः ।\nशारदेन्दुरिवाऽऽभाति लक्षणैः समलंकृतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000044004, "chapter_id": 20044, "verse_number": "४४-५", "content_sanskrit": "आहर्ता सर्वयज्ञानां हयमेधादिकृत्तथा ।\nदानैर्यज्ञैस्तपोभिश्च तत्तुल्यो नास्ति भूपतिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000044005, "chapter_id": 20044, "verse_number": "४४-६", "content_sanskrit": "सुवर्णमणिमुक्तानां गजाश्वानां च भूपतिः ।\nप्रददौ विप्रमुख्येभ्यो यागे यागे महाधनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000044006, "chapter_id": 20044, "verse_number": "४४-७", "content_sanskrit": "हस्त्यश्वरथमुख्यानां कम्बलाजिनवाससाम् ।\nरत्नानां धनधान्यानामन्तस्तस्य न विद्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000044007, "chapter_id": 20044, "verse_number": "४४-८", "content_sanskrit": "एवं सर्वघनैर्युक्तो गुणैः सर्वैरलंकृतः ।\nसर्वकामसमृद्धात्मा कुर्वनाज्यमकण्टकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000044008, "chapter_id": 20044, "verse_number": "४४-९", "content_sanskrit": "तस्येयं मतिरुत्पन्ना सर्वयोगेश्वरं हरिम् ।\nकथमाराधयिष्यामि भुक्तिमुक्तिप्रदं प्रभुम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000044009, "chapter_id": 20044, "verse_number": "४४-१०", "content_sanskrit": "विचार्य सर्वशास्त्राणि तन्त्राण्यागमविस्तरम् ।\nइतिहासपुराणानि वेदाङ्गानि च सर्वशः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000044010, "chapter_id": 20044, "verse_number": "४४-११", "content_sanskrit": "धर्मशास्त्राणि सर्वाणि नियमानृषिभाषितान् ।\nवेदाङ्गानि च शास्त्राणि विद्यास्थानानि यानि च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000044011, "chapter_id": 20044, "verse_number": "४४-१२", "content_sanskrit": "गुरुं संसेव्य यत्नेन ब्रह्मणान्वेपारगान् ।\nआधाय परमां काष्ठां कृतकृत्योऽभवत्तदा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000044012, "chapter_id": 20044, "verse_number": "४४-१३", "content_sanskrit": "संप्राप्य परमं तत्त्वं वासुदेवाख्यमव्ययम् ।\nभ्रान्तिज्ञानादतीतस्तु मुमुक्षुः सेयतेन्द्रियः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000044013, "chapter_id": 20044, "verse_number": "४४-१४", "content_sanskrit": "कथमाराधयिष्यामि देवदेवं सनातनम् ।\nपीतवस्त्रं चतुर्बाहुं शङ्खचक्रगदाधरम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000044014, "chapter_id": 20044, "verse_number": "४४-१५", "content_sanskrit": "वनमालावृतोरस्कं पद्मपत्रायतेक्षणम् ।\nश्रीवत्सोरःसमायुक्तं मुकुटाङ्गदशोभितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000044015, "chapter_id": 20044, "verse_number": "४४-१६", "content_sanskrit": "स्वपुरात्स तु निष्क्रान्त उज्जयिन्याः प्रजापतिः ।\nबलेन महता युक्तः सभृत्यः सपुरोहितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000044016, "chapter_id": 20044, "verse_number": "४४-१७", "content_sanskrit": "अनुजग्मुस्तु तं सर्वे रथिनः शस्त्रपाणयः ।\nरथैर्विमानसंकाशैः पतकाध्वजसेवितैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000044017, "chapter_id": 20044, "verse_number": "४४-१८", "content_sanskrit": "सादिनश्च तथा सर्वे प्रासतोमरपामयः ।\nअश्वैः पवनसंकाशैरनुजग्मुस्तु तं तृपम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000044018, "chapter_id": 20044, "verse_number": "४४-१९", "content_sanskrit": "हिमवत्संभवैर्मत्तैर्वारणैः पर्वतोपमैः ।\nईषादन्तैः सदा मत्तैः प्रचण्डैः षष्टिहायनैः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000044019, "chapter_id": 20044, "verse_number": "४४-२०", "content_sanskrit": "हेमकक्षैः सपताकैर्घण्टकुण्डलाः ।\nअनुजग्मुश्च तं सर्वे गजयुद्धविशारदाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000044020, "chapter_id": 20044, "verse_number": "४४-२१", "content_sanskrit": "संख्येयाश्च पादाता धनुष्प्रासासिपाणयः ।\nदिव्यमाल्याम्बधरा दिव्यगन्धानुलेपनाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000044021, "chapter_id": 20044, "verse_number": "४४-२२", "content_sanskrit": "अनुजग्मुश्च तं सर्वे युवानो मृष्टकुण्डलाः ।\nसर्वास्त्रकुशलाः शूराः सदा सङ्ग्रामलालसाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000044022, "chapter_id": 20044, "verse_number": "४४-२३", "content_sanskrit": "अन्तःपुरनिवासिन्यः स्त्रियः सर्वाः स्वलंकृताः ।\nविम्बौष्ठचारुदशनाः सर्वाभरणभूषिताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000044023, "chapter_id": 20044, "verse_number": "४४-२४", "content_sanskrit": "दिव्यवस्त्रधराः सर्वा दिव्यमाल्यविभूषिताः ।\nदिव्यगन्धानुलिप्ताङ्गाः शरच्चन्द्रनिभाननाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000044024, "chapter_id": 20044, "verse_number": "४४-२५", "content_sanskrit": "सुमध्यमाश्चारुवेषाश्चारुकर्णाकाञ्चिताः ।\nताम्बूलरञ्जितमुखा रक्षिभिस्च सुरक्षिताः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000044025, "chapter_id": 20044, "verse_number": "४४-२६", "content_sanskrit": "यानैरुच्चावचैः शुभ्रैर्मणिकाञ्चनभूषितैः ।\nउपगीयमानास्ताः सर्वा गायनैः स्तुतिपाठकैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000044026, "chapter_id": 20044, "verse_number": "४४-२७", "content_sanskrit": "वेष्टिताः शस्त्रहस्तैश्च पद्मपत्रायतेक्षणाः ।\nब्राह्मणाः क्षत्रिया वैश्या अनुजग्मुस्च तं नृपम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000044027, "chapter_id": 20044, "verse_number": "४४-२८", "content_sanskrit": "वणिग्ग्रामगणाःसर्वे नानापुरनिवासिनः ।\nधनै रत्नैः सुवर्णेश्च सदाराः सपरिच्छदाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000044028, "chapter_id": 20044, "verse_number": "४४-२९", "content_sanskrit": "अस्त्रविक्रयकाश्चैव ताम्बूलपण्यजीविनः ।\nतृमविक्रयकाश्चैव काष्ठविक्रयकारकाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000044029, "chapter_id": 20044, "verse_number": "४४-३०", "content_sanskrit": "रङ्गोपजीविनः सर्वे मांसविक्रयिणस्तथा ।\nतैलविक्रयकाश्चैव वस्त्रविक्रयकास्तथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000044030, "chapter_id": 20044, "verse_number": "४४-३१", "content_sanskrit": "फलविक्रयिणश्चैव पत्रविक्रयिणस्तथा ।\nतथा जवसहाराश्च रजकाश्च सहस्रशः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000044031, "chapter_id": 20044, "verse_number": "४४-३२", "content_sanskrit": "गोपाला नापिताश्चैव तताऽन्ये वस्त्रसूचकाः ।\nमेषपालास्चाजपाला मृगपालाश्च हंसकाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000044032, "chapter_id": 20044, "verse_number": "४४-३३", "content_sanskrit": "धान्यविक्रयिणश्चैव सक्तुविक्रयिणश्च ये ।\nगुडविक्रयिकाश्चैव तथा लवणजीविनः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000044033, "chapter_id": 20044, "verse_number": "४४-३४", "content_sanskrit": "गायना नर्तकाश्चैव तथा मङ्गलपाठकाः ।\nशैलूषाः कथकाश्चैव पुराणार्थविशारदाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000044034, "chapter_id": 20044, "verse_number": "४४-३५", "content_sanskrit": "कवयः काव्यकर्तारो नानाकाव्यविशारदाः ।\nविषध्ना गारुडाश्चैव नानारत्नपरीक्षकाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000044035, "chapter_id": 20044, "verse_number": "४४-३६", "content_sanskrit": "व्योकारास्ताम्रकाराश्च कांस्यकाराश्चरूठकाः ।\nकौषकाराश्चित्रकाराः कुन्दकाराश्च पावकाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000044036, "chapter_id": 20044, "verse_number": "४४-३७", "content_sanskrit": "दण्डकाराश्चासिकाराः सुराधूतोपजीविनः ।\nमल्ला दूताश्च कायस्था ये चान्ये कर्मकारिणः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000044037, "chapter_id": 20044, "verse_number": "४४-३८", "content_sanskrit": "तन्तुवाया रूपकारा वार्तिकास्तैलपाठकाः ।\nलावजीवास्तैत्तिरिका मृगपक्ष्युपजीविनः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000044038, "chapter_id": 20044, "verse_number": "४४-३९", "content_sanskrit": "गजवैद्याश्च वैद्याश्च नरवैद्याश्च यै नराः ।\nवृक्षवैद्यास्च गोवैद्या ये चान्ये छेददाहकाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000044039, "chapter_id": 20044, "verse_number": "४४-४०", "content_sanskrit": "एते नागरकाः सर्वे ये चान्ये नानुकीर्तिताः ।\nअनुजग्मुस्तु राजानं समस्तपुरवासिनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000044040, "chapter_id": 20044, "verse_number": "४४-४१", "content_sanskrit": "यथा व्रजन्तं पितरं ग्रामान्तरं समुत्सुकाः ।\nअनुयान्ति यथा पुत्रास्तथा तं तेऽपि नागराः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000044041, "chapter_id": 20044, "verse_number": "४४-४२", "content_sanskrit": "एवं स नृपतिः श्रीमान्वृतः सर्वैर्महाजनैः ।\nहस्त्श्वरथपादातैर्जगाम च शनैः शनैः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000044042, "chapter_id": 20044, "verse_number": "४४-४३", "content_sanskrit": "एवं गत्वा स नृपतिर्दक्षिणस्योदधेस्तटम् ।\nसर्वैस्तैर्दीर्घकालेन बलैरनुगतः प्रभुः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000044043, "chapter_id": 20044, "verse_number": "४४-४४", "content_sanskrit": "ददर्श सागरं रम्यं नृत्यन्तमिव च स्थितम् ।\nअनेकशतसाहस्रैरूर्मिभिश्च समाकुलम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000044044, "chapter_id": 20044, "verse_number": "४४-४५", "content_sanskrit": "नानारत्नालयं पूर्णं नानाप्राणिसमाकुलम् ।\nवीचीतरङ्गबहुलं महाश्चर्यसमन्वितम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000044045, "chapter_id": 20044, "verse_number": "४४-४६", "content_sanskrit": "तीर्थराजं महाशब्दमपारं सुभयंकरम् ।\nमेघवृन्दप्रतीकाशमगाधं मकरालयम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000044046, "chapter_id": 20044, "verse_number": "४४-४७", "content_sanskrit": "सत्स्यैः कूर्मैश्च शङ्खैश्च सुक्तिकान्क्रशङ्कुभिः ।\nशिशुमारैः कर्कटैश्च वृतं सर्पैर्महाविषैः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000044047, "chapter_id": 20044, "verse_number": "४४-४८", "content_sanskrit": "लवणोदं हरेः स्थानं शयनस्य नदीपतिम् ।\nसर्वपापहरं पुण्यं सर्ववाञ्छाफलप्रदम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000044048, "chapter_id": 20044, "verse_number": "४४-४९", "content_sanskrit": "अनेकावर्तगम्भीरं दानवानां समाश्रयम् ।\nअमृतस्यारणिं दिव्यं देवयोनिमपां पतिम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000044049, "chapter_id": 20044, "verse_number": "४४-५०", "content_sanskrit": "विशिष्टं सर्वभूतानां प्राणिनां जीवधारणम् ।\nसुपवित्रं पवित्राणां मङ्गलानां च मङ्गलम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000044050, "chapter_id": 20044, "verse_number": "४४-५१", "content_sanskrit": "तीर्थानामुत्तमं तीर्थमव्ययं यादसां पतिम् ।\nचन्द्रवृद्धिक्षयस्येव यस्य मानं प्रतिष्ठितम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000044051, "chapter_id": 20044, "verse_number": "४४-५२", "content_sanskrit": "अभेद्यं सर्वभूतानां देवानाममृतालयम् ।\nउत्पत्तिस्थितिसंहारहेतुभूतं सनातनम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000044052, "chapter_id": 20044, "verse_number": "४४-५३", "content_sanskrit": "उपजीव्यं च सर्वेषां पुण्यं नदनदीपतिम् ।\nदृष्ट्वा तं नृपतिश्रेष्ठो विस्मयं परमं गतः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000044053, "chapter_id": 20044, "verse_number": "४४-५४", "content_sanskrit": "निवासमकरोत्तत्र वेलामासाद्य सागरीम् ।\nपुण्ये मनोहरे देशे सर्वभूमिगुणैर्युते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000044054, "chapter_id": 20044, "verse_number": "४४-५५", "content_sanskrit": "वृतं शालैः कदम्बैश्च पुंनागैः सरलद्रुमैः ।\nपनसैर्नारिकेलैश्च बकुलैर्नागकेसरैः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000044055, "chapter_id": 20044, "verse_number": "४४-५६", "content_sanskrit": "तालैः पिप्लैः खर्जूरैर्नारङ्गैर्बीदजपूरकैः ।\nशालैराम्रातकैर्लोध्रैर्बकुलैर्बहुवारकैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000044056, "chapter_id": 20044, "verse_number": "४४-५७", "content_sanskrit": "कपित्थैः कर्णिकारैस्च पाटलालशोकचम्पकैः ।\nदाडिमैश्च तमालैश्च पारिजातैस्तथाऽर्जुनैः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000044057, "chapter_id": 20044, "verse_number": "४४-५८", "content_sanskrit": "प्राचीनामलकैर्बिल्वैः प्रियंगुवटखादिरैः ।\nइङ्गदीसप्तपर्णैश्च अश्वत्थागस्त्यजम्बुनकैः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000044058, "chapter_id": 20044, "verse_number": "४४-५९", "content_sanskrit": "मधुकैः कर्णिकारैश्च बहुवारैः सतिन्दुकैः ।\nपलाशबदरैर्नीपैः सिद्धनिम्बशुभाठ्जनैः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000044059, "chapter_id": 20044, "verse_number": "४४-६०", "content_sanskrit": "वारकैः कोविदारैश्च भल्लातामलकैस्तथा ।\nइति हिन्तालकाङ्कोलैः करञ्जैः सविभीतकैः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000044060, "chapter_id": 20044, "verse_number": "४४-६१", "content_sanskrit": "ससर्जमधुकाश्मर्यैः शाल्मलीदेवदारुभिः ।\nशाखोटकैर्निम्बवटैः कुम्भीकोष्ठहरीतकैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000044061, "chapter_id": 20044, "verse_number": "४४-६२", "content_sanskrit": "गुग्गुलैश्चन्दनैर्वृक्षैस्तथैवागुरूपाटलैः ।\nजम्बीरकरुणैर्वृक्षैस्तिन्तिडीरक्तचन्दनैः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000044062, "chapter_id": 20044, "verse_number": "४४-६३", "content_sanskrit": "एवं नानाविधैर्वृक्षैस्तथाऽन्यैर्बहुपादपैः ।\nकल्पद्रुमैर्नित्यफलैः सर्वर्तुकुसुमोत्करैः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000044063, "chapter_id": 20044, "verse_number": "४४-६४", "content_sanskrit": "नानापक्षिरुतैर्दिव्यैर्मत्तकोकिलनादितैः ।\nमयूरवरसंघुष्टैः शुकसारिकसंकुलैः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000044064, "chapter_id": 20044, "verse_number": "४४-६५", "content_sanskrit": "हारीतैर्भृङ्गराजैश्च चातकैर्बहुपुत्रकैः ।\nजीवंजीवककाकोलैः कलविङ्कै कपोतकैः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000044065, "chapter_id": 20044, "verse_number": "४४-६६", "content_sanskrit": "खगैर्नानाविधश्चान्यैः श्रोत्ररम्यैर्मनोहरैः ।\nपुष्पिताग्रेषु वृक्षेषु कूजद्मिश्चार्वधिष्ठितैः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000044066, "chapter_id": 20044, "verse_number": "४४-६७", "content_sanskrit": "केतकीवनखण्डैश्च सदा पुष्पधरैः सितैः ।\nमल्लिकाकुन्दकुसुमैर्यूथिकातगरैस्तथा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000044067, "chapter_id": 20044, "verse_number": "४४-६८", "content_sanskrit": "कुटजैर्बाणपुष्पैश्च अतिमुक्तैः सकुब्जकैः ।\nमालतीकरवीरैश्च तथा कदलकाञ्चनैः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000044068, "chapter_id": 20044, "verse_number": "४४-६९", "content_sanskrit": "अनयैर्नानाविधैः पुष्पैः सुगन्धैश्चारुदर्शनैः ।\nवनोद्यानोपवनजैर्नानावर्णैः सुगन्धिभिः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000044069, "chapter_id": 20044, "verse_number": "४४-७०", "content_sanskrit": "विद्याधरगणाकीर्णैः सिद्धचारणसेवितैः ।\nगन्धर्वोरगरक्षोभिर्भूताप्सरसकिंनरैः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000044070, "chapter_id": 20044, "verse_number": "४४-७१", "content_sanskrit": "मुनियक्षगणाकीर्णैर्नानासत्त्वनिषेवितैः ।\nमृगैः शाखामृगैः सिंहैर्वराहमहिषाकुलैः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000044071, "chapter_id": 20044, "verse_number": "४४-७२", "content_sanskrit": "तथाऽन्यैः कृष्णसाराद्यैर्मृगैः सर्वत्र शोभितैः ।\nशार्दूलैर्दीप्तमातङ्गैस्तथाऽन्यैर्वनचारिभिः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000044072, "chapter_id": 20044, "verse_number": "४४-७३", "content_sanskrit": "एवं नानाविधैर्वृक्षैरुद्यानैर्नन्दनोपमैः ।\nलतागुल्मवितानैस्च विविधैश्च जलाशयैः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000044073, "chapter_id": 20044, "verse_number": "४४-७४", "content_sanskrit": "हंसकारण्डवाकीर्णैः पद्मिनीखण्डमण्डितैः ।\nकादम्बैश्च प्लवैर्हंसैश्चक्रवाकोपसोभितैः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000044074, "chapter_id": 20044, "verse_number": "४४-७५", "content_sanskrit": "कमलैः शतपत्रैश्च कह्लारैः कुमुदोत्पलैः ।\nखगैर्जलचरैस्चान्यैः पुष्पैर्जलसमुद्‌भवैः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000044075, "chapter_id": 20044, "verse_number": "४४-७६", "content_sanskrit": "पर्वतैर्दीप्तशिखरैश्चारुकन्दरमण्डितैः ।\nनानावृक्षसमाकीर्णैर्नानाधातुविभूषितैः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000044076, "chapter_id": 20044, "verse_number": "४४-७७", "content_sanskrit": "सर्वाश्चर्यमयैः श्रृङ्गैः सर्वभूतालयैः शुभैः ।\nसर्वौषधिसमायुक्तैर्विपुलैश्चित्रसानुभिः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000044077, "chapter_id": 20044, "verse_number": "४४-७८", "content_sanskrit": "एवं सर्वैः समुदितैः शोभितं सुमनोहरैः ।\nददर्श स महीपालः स्थानं त्रैलोक्यपूजितम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000044078, "chapter_id": 20044, "verse_number": "४४-७९", "content_sanskrit": "दशयोजनविस्तीर्ण पञ्चयोजनमायतम् ।\nनानाश्चर्यसमायुक्तं क्षेत्रं परमुर्लभम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]