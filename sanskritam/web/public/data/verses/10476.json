[{"id": 50001183, "chapter_id": 10476, "verse_number": "1", "content_sanskrit": "“पाराशर्यो जातूकर्ण्यः 【पाठभेदः: BG—जातुकर्ण्यः】 पराशरसुतावुभौ। विप्रायामेव भार्यायां तृतीयः कृष्ण एव च॥” इति ब्रह्माण्डे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50001184, "chapter_id": 10476, "verse_number": "2", "content_sanskrit": "“परस्य ब्रह्मणो विष्णोर्हयशीर्षादधीतवान्। ब्रह्मविद्यामिमां ब्रह्मा ततः सनक एव च॥” इति गारुडे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50001185, "chapter_id": 10476, "verse_number": "3", "content_sanskrit": "॥ इति वंशब्राह्मणम्॥ ४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50001186, "chapter_id": 10476, "verse_number": "4", "content_sanskrit": "इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते श्रीमद्बृहदारण्यकोपनिषद्भाष्ये चतुर्थोध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50001187, "chapter_id": 10476, "verse_number": "5", "content_sanskrit": "॥ पञ्चमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]