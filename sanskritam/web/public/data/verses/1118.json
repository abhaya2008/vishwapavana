[{"id": 2005990, "chapter_id": 1118, "verse_number": "१-११९-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005991, "chapter_id": 1118, "verse_number": "१-११९-१", "content_sanskrit": "गुणैः समुदितं सम्यगिदं नः प्रथितं कुलम्।\nअत्यन्यान्पृथिवीपालान्पृथिव्यामधिराज्यभाक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005992, "chapter_id": 1118, "verse_number": "१-११९-२", "content_sanskrit": "रक्षितं राजभिः पूर्वं धर्मविद्भिर्महात्मभिः।\nनोत्सादमगमच्चेदं कदाचिदिह नः कुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005993, "chapter_id": 1118, "verse_number": "१-११९-३", "content_sanskrit": "मया च सत्यवत्या च कृष्णेन च महात्मना।\nसमवस्थापित भूयो युष्मासु कुलतन्तुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005994, "chapter_id": 1118, "verse_number": "१-११९-४", "content_sanskrit": "तच्चैतद्वर्धते भूयः कुलं सागरवद्यथा।\nतथा मया विधातव्यं त्वया चैव न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005995, "chapter_id": 1118, "verse_number": "१-११९-५", "content_sanskrit": "श्रूयते यादवी कन्या स्वनुरूपा कुलस्य नः।\nसुबलस्यात्मजा चैव तथा मद्रेश्वरस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005996, "chapter_id": 1118, "verse_number": "१-११९-६", "content_sanskrit": "कुलीना रूपवत्यश्च ताः कन्याः पुत्र सर्वशः।\nउचिताश्चैव संबन्धे तेऽस्माकं क्षत्रियर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005997, "chapter_id": 1118, "verse_number": "१-११९-७", "content_sanskrit": "मन्ये वरयितव्यास्ता इत्यहं धीमतां वर।\nसन्तानार्थं कुलस्यास्य यद्वा विदुर मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005998, "chapter_id": 1118, "verse_number": "१-११९-८x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005999, "chapter_id": 1118, "verse_number": "१-११९-८", "content_sanskrit": "भवान्पिता भावन्माता भवान्नः परमो गुरुः।\nतस्मात्स्वयं कुलस्यास्य विचार्य कुरु यद्धितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006000, "chapter_id": 1118, "verse_number": "१-११९-९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006001, "chapter_id": 1118, "verse_number": "१-११९-९", "content_sanskrit": "अथ शुश्राव विप्रेभ्यो गान्धारीं सुबलात्मजाम्।\nआराध्य वरदं देवं भगनेत्रहरं हरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006002, "chapter_id": 1118, "verse_number": "१-११९-१०", "content_sanskrit": "गान्धारी किल पुत्राणां शतं लेभे वरं शुभा।\nइति शुश्राव तत्त्वेन भीष्मः कुरुपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006003, "chapter_id": 1118, "verse_number": "१-११९-११", "content_sanskrit": "ततो गान्धारराजस्य प्रेषयामास भारत।\nअचक्षुरिति तत्रासीत्सुबलस्य विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006004, "chapter_id": 1118, "verse_number": "१-११९-१२", "content_sanskrit": "कुलं ख्यातिं च वृत्तं च बुद्ध्या तु प्रसमीक्ष्य सः।\nददै तां धृतराष्ट्राय गान्धारीं धर्मचारिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006005, "chapter_id": 1118, "verse_number": "१-११९-१३", "content_sanskrit": "गान्धारी त्वथ शुश्राव धृतराष्ट्रमचक्षुषम्।\nआत्मानं दिप्सितं चास्मै पित्रा मात्रा च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006006, "chapter_id": 1118, "verse_number": "१-११९-१४", "content_sanskrit": "ततः सा पटमादाय कृत्वा बहुगुणं तदा।\nबबन्ध नेत्रे स्वे राजन्पतिव्रतपरायणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006007, "chapter_id": 1118, "verse_number": "१-११९-१५", "content_sanskrit": "नाभ्यसूयां पतिमहमित्येवं कृतनिश्चया।\nततो गान्धारराजस्य पुत्रः शकुनिरभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006008, "chapter_id": 1118, "verse_number": "१-११९-१६", "content_sanskrit": "स्वसारं परया लक्ष्म्या युक्तामादाय कौरवान्।\nतां तदा धृतराष्ट्राय ददौ परमसत्कृताम्।\nभीष्मस्यानुमते चैव विवाहं समकारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006009, "chapter_id": 1118, "verse_number": "१-११९-१७", "content_sanskrit": "दत्त्वा स भगिनीं वीरो यथार्हं च परिच्छदम्।\nपुनरायात्स्वनगरं भीष्मेण प्रतिपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006010, "chapter_id": 1118, "verse_number": "१-११९-१८", "content_sanskrit": "गान्धार्यपि वरारोहा शीलाचारविचिषेटितैः।\nतुष्टिं कुरूणां सर्वेषां जनयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006011, "chapter_id": 1118, "verse_number": "१-११९-१९", "content_sanskrit": "गान्धारी सा पतिं दृष्ट्वा प्रज्ञाचक्षुषमीश्वरम्।\nअतिचाराद्भृशं भीता भर्तुः सा समचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2006012, "chapter_id": 1118, "verse_number": "१-११९-२०", "content_sanskrit": "सा दृष्टिविनिवृत्त्या हि भर्तुश्च समतां ययौ।\nनहि सूक्ष्मेप्यतीचारे भर्तुः सा ववृते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2006013, "chapter_id": 1118, "verse_number": "१-११९-२१", "content_sanskrit": "वृत्तेनाराध्य तान्सर्वान्गुरून्पतिपरायणा।\nवाचापि पुरुषानन्यान्सुव्रता नान्वकीर्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2006014, "chapter_id": 1118, "verse_number": "१-११९-२२", "content_sanskrit": "तस्याः सहोदरीः कन्याः पुनरेव ददौ दश।\nगान्धारराजः सुबलो भीष्मेण च वृतस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2006015, "chapter_id": 1118, "verse_number": "१-११९-२३", "content_sanskrit": "सत्यव्रतां सत्यसेनां सुदेष्णां चापि संहिताम्।\nतेजश्श्र्वां सुश्रवां च तथैव निकृतिं शुभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2006016, "chapter_id": 1118, "verse_number": "१-११९-२४", "content_sanskrit": "शंभ्वठां च दशार्णां च गान्धारीर्दश विश्रुताः।\nएकाह्ना प्रतिजग्राह धृतराष्ट्रो जनेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2006017, "chapter_id": 1118, "verse_number": "१-११९-२५", "content_sanskrit": "ततः शान्तनवो भीष्मो धानुष्कस्तास्ततस्ततः।\nअददाद्धृतराष्ट्रस्य राजपुत्रीः परश्शतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2006018, "chapter_id": 1118, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि एकोनविंशत्यधिकशततमोऽध्यायः॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]