[{"id": 900000962, "chapter_id": 8198, "verse_number": "6.1", "content_sanskrit": "पराश्चि खानि व्यतृणात् स्वयम्भूः तस्मात् पराक् पश्यति नान्तरात्मन्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900000963, "chapter_id": 8198, "verse_number": "6.2", "content_sanskrit": "पराचः कामाननुयन्ति बालास्ते मृत्योर्यन्ति विततस्य पाशम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900000964, "chapter_id": 8198, "verse_number": "6.3", "content_sanskrit": "येन रूपं रसं गन्धं शब्दान् स्पर्शांश्च मैथुनान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900000965, "chapter_id": 8198, "verse_number": "6.4", "content_sanskrit": "स्वप्नान्तं जागरितान्तं चोभौ येनानुपश्यति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900000966, "chapter_id": 8198, "verse_number": "6.5", "content_sanskrit": "य इदं मध्वदं वेदाsत्मानं जीवमन्तिकात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900000967, "chapter_id": 8198, "verse_number": "6.6", "content_sanskrit": "यः पूर्वं तपसोऽजातमद्भ्यः पूर्वमजायत", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900000968, "chapter_id": 8198, "verse_number": "6.7", "content_sanskrit": "यः पूर्वं तपसोऽजातमद्भ्यः पूर्वमजायत", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900000969, "chapter_id": 8198, "verse_number": "6.8", "content_sanskrit": "या प्राणेन संविशत्यदितिर्देवतामयी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900000970, "chapter_id": 8198, "verse_number": "6.9", "content_sanskrit": "अरण्योर्निहितो जातवेदा गर्भ इव सुभृतो गर्भिणीभिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900000971, "chapter_id": 8198, "verse_number": "6.10", "content_sanskrit": "यतश्चोदेति सूर्योऽस्तं यत्र च गच्छति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900000972, "chapter_id": 8198, "verse_number": "6.11", "content_sanskrit": "यदेवेह तदमुत्र यदमुत्र तदन्विह", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900000973, "chapter_id": 8198, "verse_number": "6.12", "content_sanskrit": "मनसैवेदमाप्तव्यं नेह नानाऽस्ति किञ्चन", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900000974, "chapter_id": 8198, "verse_number": "6.13", "content_sanskrit": "अङ्गुष्ठमात्रः पुरुषो मध्य आत्मनि तिष्ठति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900000975, "chapter_id": 8198, "verse_number": "6.14", "content_sanskrit": "अङ्गुष्ठमात्रः पुरुषो ज्योतिरिवाधूमकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900000976, "chapter_id": 8198, "verse_number": "6.15", "content_sanskrit": "यथोदकं दुर्गे वृष्टं पर्वतेषु विधावति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900000977, "chapter_id": 8198, "verse_number": "6.16", "content_sanskrit": "यथोदकं शुद्धे शुद्धमासिक्तं तादृगेव भवति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]