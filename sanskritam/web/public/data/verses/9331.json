[{"id": 40020322, "chapter_id": 9331, "verse_number": "1", "content_sanskrit": "राक्षसेन्द्रो ऽभिषिक्तस्तु भ्रातृभ्यां सहितस्तदा । ततः प्रदानं राक्षस्या भगिन्याः समचिन्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40020323, "chapter_id": 9331, "verse_number": "2", "content_sanskrit": "स्वसारं कालकेयाय दानवेन्द्राय राक्षसीम् । ददौ शूर्पणखां नाम विद्युज्जिह्वाय नामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40020324, "chapter_id": 9331, "verse_number": "3", "content_sanskrit": "अथ दत्त्वा स्वयं रक्षो मृगयामटते स्म तत् । तत्रापश्यत्ततो राम मयं नाम दितेः सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40020325, "chapter_id": 9331, "verse_number": "4", "content_sanskrit": "कन्यासहायं तं दृष्ट्वा दशग्रीवो निशाचरः । अपृच्छत्को भवानेको निर्मनुष्यमृगे वने । अनया मृगशावाक्ष्या किमर्थं सह तिष्ठसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40020326, "chapter_id": 9331, "verse_number": "5", "content_sanskrit": "मयस्तथाब्रवीद्राम पृच्छन्तं तं निशाचरम् । श्रूयतां सर्वमाख्यास्ये यथावृत्तमिदं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40020327, "chapter_id": 9331, "verse_number": "6", "content_sanskrit": "हेमा नामाप्सरास्तात श्रुतपूर्वा यदि त्वया । दैवतैर्मम सा दत्ता पौलोमीव शतक्रतोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40020328, "chapter_id": 9331, "verse_number": "7", "content_sanskrit": "तस्यां सक्तमनास्तात पञ्चवर्षशतान्यहम् । सा च दैवतकार्येण त्रयोदश समा गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40020329, "chapter_id": 9331, "verse_number": "8", "content_sanskrit": "वर्षं चतुर्दशं चैव ततो हेममयं पुरम् । वज्रवैडूर्यचित्रं च मायया निर्मितं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40020330, "chapter_id": 9331, "verse_number": "9", "content_sanskrit": "तत्राहमवसं दीनस्तया हीनः सुदुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40020331, "chapter_id": 9331, "verse_number": "10", "content_sanskrit": "तस्मात्पुराद्दुहितरं गृहीत्वा वनमागतः । इयं ममात्मजा राजंस्तस्याः कुक्षौ विवर्धिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40020332, "chapter_id": 9331, "verse_number": "11", "content_sanskrit": "भर्तारमनया सार्धमस्याः प्राप्तो ऽस्मि मार्गितुम् । कन्यापितृत्वं दुःखं हि सर्वेषां मानकाङ्क्षिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40020333, "chapter_id": 9331, "verse_number": "12", "content_sanskrit": "कन्या हि द्वे कुले नित्यं संशये स्थाप्य तिष्ठति । पुत्रद्वयं ममाप्यस्यां भार्यायां सम्बभूव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40020334, "chapter_id": 9331, "verse_number": "13", "content_sanskrit": "मायावी प्रथमस्तात दुन्दुभिस्तदनन्तरः । एवं ते सर्वमाख्यातं याथातथ्येन पृच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40020335, "chapter_id": 9331, "verse_number": "14", "content_sanskrit": "त्वामिदानीं कथं तात जानीयां को भवानिति । एवमुक्तस्तु तद्रक्षो विनीतमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40020336, "chapter_id": 9331, "verse_number": "15", "content_sanskrit": "अहं पौलस्त्यतनयो दशग्रीवश्च नामतः । मुनेर्विश्रवसो यस्तु तृतीयो ब्रह्मणो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40020337, "chapter_id": 9331, "verse_number": "16", "content_sanskrit": "एवमुक्तस्तदा राम राक्षसेन्द्रेण दानवः । महर्षेस्तनयं ज्ञात्वा मयो हर्षमुपागतः । दातुं दुहितरं तस्मै रोचयामास यत्र वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40020338, "chapter_id": 9331, "verse_number": "17", "content_sanskrit": "करेण तु करं तस्या ग्राहयित्वा मयस्तदा । प्रहसन्प्राह दैत्येन्द्रो राक्षसेन्द्रमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40020339, "chapter_id": 9331, "verse_number": "18", "content_sanskrit": "इयं ममात्मजा राजन्हेमया ऽप्सरसा धृता । कन्या मन्दोदरी नाम पत्न्यर्थं प्रतिगृह्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40020340, "chapter_id": 9331, "verse_number": "19", "content_sanskrit": "बाढमित्येव तं राम दशग्रीवो ऽभ्यभाषत । प्रज्चाल्य तत्र चैवाग्निमकरोत्पाणिसङ्ग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40020341, "chapter_id": 9331, "verse_number": "20", "content_sanskrit": "स हि तस्य मयो राम शापाभिज्ञस्तपोधनात् । विदित्वा तेन सा दत्ता तस्य पैतामहं कुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40020342, "chapter_id": 9331, "verse_number": "21", "content_sanskrit": "अमोघां तस्य शक्तिं च प्रददौ परमाद्भुताम् । परेण तपसा लब्धां जघ्निवाँल्लक्ष्मणं यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40020343, "chapter_id": 9331, "verse_number": "22", "content_sanskrit": "एवं सीकृतदारो वै लङ्काया ईश्वरः प्रभुः । गत्वा तु नगरीं भार्ये भ्रातृभ्यां समुपाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40020344, "chapter_id": 9331, "verse_number": "23", "content_sanskrit": "वैरोचनस्य दौहित्रीं वज्रज्वालेति नामतः । तां भार्यां कुम्भकर्णस्य रावणः समकल्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40020345, "chapter_id": 9331, "verse_number": "24", "content_sanskrit": "गन्धर्वराजस्य सुतां शैलूषस्य महात्मनः । सरमां नाम धर्मज्ञां लेभे भार्यां विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40020346, "chapter_id": 9331, "verse_number": "25", "content_sanskrit": "तीरे तु सरसो वै तु सञ्जज्ञे मानसस्य हि । सरस्तदा मानसं तु ववृधे जलदागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40020347, "chapter_id": 9331, "verse_number": "26", "content_sanskrit": "मात्रा तु तस्याः कन्यायाः स्नेहेनाक्रन्दितं वचः । सरो मा वर्धयस्वेति ततः सा सरमा ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40020348, "chapter_id": 9331, "verse_number": "27", "content_sanskrit": "एवं ते कृतदारा वै रेमिरे तत्र राक्षसाः । स्वां स्वां भार्यामुपागम्य गन्धर्वा इव नन्दने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40020349, "chapter_id": 9331, "verse_number": "28", "content_sanskrit": "ततो मन्दोदरी पुत्रं मेघनादमजीजनत् । स एष इन्द्रजिन्नाम युष्माभिरभिधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40020350, "chapter_id": 9331, "verse_number": "29", "content_sanskrit": "जातमात्रेण हि पुरा तेन रावणसूनुना । रुदता सुमहान्मुक्तो नादो जलधरोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40020351, "chapter_id": 9331, "verse_number": "30", "content_sanskrit": "जडीकृता च सा लङ्का तस्य नादेन राघव । पिता तस्याकरोन्नाम मेघनाद इति स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40020352, "chapter_id": 9331, "verse_number": "31", "content_sanskrit": "सो ऽवर्धत तदा राम रावणान्तःपुरे शुभे । रक्ष्यमाणो वरस्त्रीभिश्छन्नः काष्ठैरिवानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40020353, "chapter_id": 9331, "verse_number": "32", "content_sanskrit": "मातापित्रोर्महाहर्षं जनयन्रावणात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]