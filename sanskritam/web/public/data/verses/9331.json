[{"id": 5000331000, "chapter_id": 9331, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे एकोनषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000331001, "chapter_id": 9331, "verse_number": "४-५९-१", "content_sanskrit": "ततस्तदमृतास्वादं गृध्रराजेन भाषितम्।\nनिशम्य वदता हृष्टास्ते वचः प्लवगर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000331002, "chapter_id": 9331, "verse_number": "४-५९-२", "content_sanskrit": "जाम्बवान् वानरश्रेष्ठः सह सर्वैः प्लवङ्गमैः।\nभूतलात् सहसोत्थाय गृध्रराजानमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000331003, "chapter_id": 9331, "verse_number": "४-५९-३", "content_sanskrit": "क्व सीता केन वा दृष्टा को वा हरति मैथिलीम्।\nतदाख्यातु भवान् सर्वं गतिर्भव वनौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000331004, "chapter_id": 9331, "verse_number": "४-५९-४", "content_sanskrit": "को दाशरथिबाणानां वज्रवेगनिपातिनाम्।\nस्वयं लक्ष्मणमुक्तानां न चिन्तयति विक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000331005, "chapter_id": 9331, "verse_number": "४-५९-५", "content_sanskrit": "स हरीन् प्रतिसम्मुक्तान् सीताश्रुतिसमाहितान्।\nपुनराश्वासयन् प्रीत इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000331006, "chapter_id": 9331, "verse_number": "४-५९-६", "content_sanskrit": "श्रूयतामिह वैदेह्या यथा मे हरणं श्रुतम्।\nयेन चापि ममाख्यातं यत्र चायतलोचना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000331007, "chapter_id": 9331, "verse_number": "४-५९-७", "content_sanskrit": "अहमस्मिन् गिरौ दुर्गे बहुयोजनमायते।\nचिरान्निपतितो वृद्धः क्षीणप्राणपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000331008, "chapter_id": 9331, "verse_number": "४-५९-८", "content_sanskrit": "तं मामेवंगतं पुत्रः सुपार्श्वो नाम नामतः।\nआहारेण यथाकालं बिभर्ति पततां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000331009, "chapter_id": 9331, "verse_number": "४-५९-९", "content_sanskrit": "तीक्ष्णकामास्तु गन्धर्वास्तीक्ष्णकोपा भुजङ्गमाः।\nमृगाणां तु भयं तीक्ष्णं ततस्तीक्ष्णक्षुधा वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000331010, "chapter_id": 9331, "verse_number": "४-५९-१०", "content_sanskrit": "स कदाचित् क्षुधार्तस्य ममाहाराभिकांक्षिणः।\nगतसूर्येऽहनि प्राप्तो मम पुत्रो ह्यनामिषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000331011, "chapter_id": 9331, "verse_number": "४-५९-११", "content_sanskrit": "स मयाऽऽहारसंरोधात् पीडितः प्रीतिवर्धनः।\nअनुमान्य यथातत्त्वमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000331012, "chapter_id": 9331, "verse_number": "४-५९-१२", "content_sanskrit": "अहं तात यथाकालमामिषार्थी खमाप्लुतः।\nमहेन्द्रस्य गिरेर्द्वारमावृत्य सुसमाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000331013, "chapter_id": 9331, "verse_number": "४-५९-१३", "content_sanskrit": "तत्र सत्त्वसहस्राणां सागरान्तरचारिणाम्।\nपन्थानमेकोऽध्यवसं संनिरोद‍्धुमवाङ्मुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000331014, "chapter_id": 9331, "verse_number": "४-५९-१४", "content_sanskrit": "तत्र कश्चिन्मया दृष्टः सूर्योदयसमप्रभाम्।\nस्त्रियमादाय गच्छन् वै भिन्नाञ्जनचयोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000331015, "chapter_id": 9331, "verse_number": "४-५९-१५", "content_sanskrit": "सोऽहमभ्यवहारार्थं तौ दृष्ट्वा कृतनिश्चयः।\nतेन साम्ना विनीतेन पन्थानमनुयाचितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000331016, "chapter_id": 9331, "verse_number": "४-५९-१६", "content_sanskrit": "नहि सामोपपन्नानां प्रहर्ता विद्यते भुवि।\nनीचेष्वपि जनः कश्चित् किमङ्ग बत मद्विधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000331017, "chapter_id": 9331, "verse_number": "४-५९-१७", "content_sanskrit": "स यातस्तेजसा व्योम संक्षिपन्निव वेगितः।\nअथाहं खेचरैर्भूतैरभिगम्य सभाजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000331018, "chapter_id": 9331, "verse_number": "४-५९-१८", "content_sanskrit": "दिष्ट्या जीवति सीतेति ह्यब्रुवन् मां महर्षयः।\nकथंचित् सकलत्रोऽसौ गतस्ते स्वस्त्यसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000331019, "chapter_id": 9331, "verse_number": "४-५९-१९", "content_sanskrit": "एवमुक्तस्ततोऽहं तैः सिद्धैः परमशोभनैः।\nस च मे रावणो राजा रक्षसां प्रतिवेदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000331020, "chapter_id": 9331, "verse_number": "४-५९-२०", "content_sanskrit": "पश्यन् दाशरथेर्भार्यां रामस्य जनकात्मजाम्।\nभ्रष्टाभरणकौशेयां शोकवेगपराजिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000331021, "chapter_id": 9331, "verse_number": "४-५९-२१", "content_sanskrit": "रामलक्ष्मणयोर्नाम क्रोशन्तीं मुक्तमूर्धजाम्।\nएष कालात्ययस्तात इति वाक्यविदां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000331022, "chapter_id": 9331, "verse_number": "४-५९-२२", "content_sanskrit": "एतदर्थं समग्रं मे सुपार्श्वः प्रत्यवेदयत् ।\nतच्छ्रुत्वापि हि मे बुद्धिर्नासीत् काचित् पराक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000331023, "chapter_id": 9331, "verse_number": "४-५९-२३", "content_sanskrit": "अपक्षो हि कथं पक्षी कर्म किंचित् समारभेत्।\nयत् तु शक्यं मया कर्तुं वाग्बुद्धिगुणवर्तिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000331024, "chapter_id": 9331, "verse_number": "४-५९-२४", "content_sanskrit": "श्रूयतां तत्र वक्ष्यामि भवतां पौरुषाश्रयम्।\nवाङ्मतिभ्यां हि सर्वेषां करिष्यामि प्रियं हि वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000331025, "chapter_id": 9331, "verse_number": "४-५९-२५", "content_sanskrit": "यद्धि दाशरथेः कार्यं मम तन्नात्र संशयः।\nतद् भवन्तो मतिश्रेष्ठा बलवन्तो मनस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000331026, "chapter_id": 9331, "verse_number": "४-५९-२६", "content_sanskrit": "प्रहिताः कपिराजेन देवैरपि दुरासदाः।\nरामलक्ष्मणबाणाश्च विहिताः कङ्कपत्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000331027, "chapter_id": 9331, "verse_number": "४-५९-२७", "content_sanskrit": "त्रयाणामपि लोकानां पर्याप्तास्त्राणनिग्रहे।\nकामं खलु दशग्रीवस्तेजोबलसमन्वितः।\nभवतां तु समर्थानां न किंचिदपि दुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000331028, "chapter_id": 9331, "verse_number": "४-५९-२८", "content_sanskrit": "तदलं कालसङ्गेन क्रियतां बुद्धिनिश्चयः।\nनहि कर्मसु सज्जन्ते बुद्धिमन्तो भवद्विधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000331029, "chapter_id": 9331, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे एकोनषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]