[{"id": 5000630000, "chapter_id": 9630, "verse_number": "७-९५-१", "content_sanskrit": "रामो बहून्यहान्येवं तद्गीतं परमं शुभम् ।\nशुश्राव मुनिभिः सार्धं पार्थिवैः सह वानरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000630001, "chapter_id": 9630, "verse_number": "७-९५-२", "content_sanskrit": "तस्मिन्गीते तु विज्ञाय सीतापुत्रौ कुशीलवौ ।\nतस्याः परिषदो मध्ये रामो वचनमब्रवीत् ।\nदूताञ्छुद्धसमाचारानाहूयात्ममनीषया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000630002, "chapter_id": 9630, "verse_number": "७-९५-३", "content_sanskrit": "मद्वचो ब्रूत गच्छध्वमितो भगवतो ऽन्तिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000630003, "chapter_id": 9630, "verse_number": "७-९५-४", "content_sanskrit": "परिषदो मध्ये रामो वचनमब्रवीत् ।\nयदि शुद्धसमाचारा यदि वा वीतकल्मषा ।\nकरोत्विहात्मनः शुद्धिमनुमान्य महामुनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000630004, "chapter_id": 9630, "verse_number": "७-९५-५", "content_sanskrit": "छन्दं मुनेश्च विज्ञाय सीतायाश्च मनोगतम् ।\nप्रत्ययं दातुकामायास्ततः शंसत मे लघु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000630005, "chapter_id": 9630, "verse_number": "७-९५-६", "content_sanskrit": "श्वः प्रभाते तु शपथं मैथिली जनकात्मजा ।\nकरोतु परिषन्मध्ये शोधनार्थं ममैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000630006, "chapter_id": 9630, "verse_number": "७-९५-७", "content_sanskrit": "श्रुत्वा तु ऱागवस्यैतद्वचः परममद्भुतम् ।\nदूताः सम्प्रययुर्बाटं यत्रास्ते मुनिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000630007, "chapter_id": 9630, "verse_number": "७-९५-८", "content_sanskrit": "ते प्रणम्य महात्मानं ज्वलन्तममितप्रभम् ।\nऊचुस्ते रामवाक्यानि मृदूनि मधुराणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000630008, "chapter_id": 9630, "verse_number": "७-९५-९", "content_sanskrit": "तेषां तद्व्याहृतं श्रुत्वा रामस्य च मनोगतम् ।\nविज्ञाय सुमहातेजा मुनिर्वाक्यमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000630009, "chapter_id": 9630, "verse_number": "७-९५-१०", "content_sanskrit": "एवं भवतु भद्रं वो यथा वदति राघवः ।\nतथा करिष्यते सीता दैवतं हि पतिः स्त्रियाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000630010, "chapter_id": 9630, "verse_number": "७-९५-११", "content_sanskrit": "तथोक्ता मुनिना सर्वे राजदूता महौजसम् ।\nप्रत्येत्य राघवं क्षिप्रं मुनिवाक्यं बभाषिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000630011, "chapter_id": 9630, "verse_number": "७-९५-१२", "content_sanskrit": "ततः प्रहृष्टः काकुत्स्थः श्रुत्वा वाक्यं महात्मनः ।\nऋषींस्तत्र समेतांश्च राज्ञश्चैवाभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000630012, "chapter_id": 9630, "verse_number": "७-९५-१३", "content_sanskrit": "भगवन्तः सशिष्या वै सानुगाश्च नराधिपाः ।\nपश्यन्तु सीताशपथं यश्चैवान्यो ऽपि काङ्क्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000630013, "chapter_id": 9630, "verse_number": "७-९५-१४", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा राघवस्य महात्मनः ।\nसर्वेषामृषिमुख्यानां साधुवादो महानभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000630014, "chapter_id": 9630, "verse_number": "७-९५-१५", "content_sanskrit": "राजानश्च महात्मानः प्रशंसन्ति स्म राघवम् ।\nउपपन्नं नरश्रेष्ठ त्वय्येव भुवि नान्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000630015, "chapter_id": 9630, "verse_number": "७-९५-१६", "content_sanskrit": "एवं विनिश्चयं कृत्वा श्वोभूत इति राघवः ।\nविसर्जयामास तदा सर्वांस्ताञ्छत्रुसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000630016, "chapter_id": 9630, "verse_number": "७-९५-१७", "content_sanskrit": "इति सम्प्रविचार्य राजसिंहः श्वोभूते शपथस्य निश्चयं वै ।\nविससर्ज मुनीन्नृपांश्च सर्वान्स महात्मा महतो महानुभावः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000630017, "chapter_id": 9630, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे पञ्चनवतितमः सर्ग ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]