[{"id": 2084530, "chapter_id": 2800, "verse_number": "१२-३०५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084531, "chapter_id": 2800, "verse_number": "१२-३०५-१", "content_sanskrit": "सत्यं दमं क्षमां प्रज्ञां प्रशंसन्ति पितामह।\nविद्वांसो मनुजा लोके कथमेतन्मतं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084532, "chapter_id": 2800, "verse_number": "१२-३०५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084533, "chapter_id": 2800, "verse_number": "१२-३०५-२", "content_sanskrit": "अत्र ते वर्तयिष्येऽहमितिहासं पुरातनम्।\nसाध्यानामिह संवादं हंसस्य च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084534, "chapter_id": 2800, "verse_number": "१२-३०५-३", "content_sanskrit": "हंसो भूत्वाऽथ सौवर्णस्त्वजो नित्यः प्रजापतिः।\nस वै पर्येति लोकांस्त्रीनथ साध्यानुपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084535, "chapter_id": 2800, "verse_number": "१२-३०५-४x", "content_sanskrit": "साध्या ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084536, "chapter_id": 2800, "verse_number": "१२-३०५-४", "content_sanskrit": "शकुने वयं स्म देवा वै साध्यास्त्वामनुयुङ्क्ष्महे।\nपृच्छामस्त्वां मोक्षधर्मं भवांश्च किल मोक्षवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084537, "chapter_id": 2800, "verse_number": "१२-३०५-५", "content_sanskrit": "श्रुतोसि नः पण्डितो धीरवादी\nसाधुः शब्दश्चरते ते पतत्रिन्।\nकिं मन्यसे श्रेष्ठतमं द्विज त्वं\nकस्मिन्मनस्ते रमते महात्मन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084538, "chapter_id": 2800, "verse_number": "१२-३०५-६", "content_sanskrit": "तन्नः कार्यं पक्षिवर प्रशाधि\nयत्कार्याणां मन्यसे श्रेष्ठमेकम्।\nयत्कृत्वा वै पुरुषः सर्वबन्धै\nर्विमुच्यते विहगेन्द्रेह शीघ्रम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084539, "chapter_id": 2800, "verse_number": "१२-३०५-७x", "content_sanskrit": "हंस उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084540, "chapter_id": 2800, "verse_number": "१२-३०५-७", "content_sanskrit": "इदं कार्यममृताशाः शृणुध्वं\nतपो दमः सत्यमात्माभिगुप्तिः।\nग्रन्थीन्विमुच्य हृदयस्य सर्वा\nन्प्रियाप्रिये स्वं वशमानयीत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084541, "chapter_id": 2800, "verse_number": "१२-३०५-८", "content_sanskrit": "नारुतुदः स्यान्न नृशंसवादी\nन हीनतः परमभ्याददीत।\nययाऽस्य वाचा पर उद्विजेत\nन तां वदेदुशतिं पापलोक्याम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084542, "chapter_id": 2800, "verse_number": "१२-३०५-९", "content_sanskrit": "वाक्सायका वदनान्निष्यतन्ति\nयैराहतः शोचति रात्र्यहानि।\nपरस्य नामर्मसु ते पतन्ति\nतान्पण्डितो नावसृजेत्परेषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084543, "chapter_id": 2800, "verse_number": "१२-३०५-१०", "content_sanskrit": "परश्चेदेनमतिवादवाणै\nर्भृशं विध्येच्छम एवेह कार्यः।\nसंरोष्यमाणः प्रतिहृष्यते यः\nस आदत्ते सुकृतं वै परस्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084544, "chapter_id": 2800, "verse_number": "१२-३०५-११", "content_sanskrit": "क्षेपायमाणमभिषङ्गव्यलीकं\nनिगृह्णाति ज्वलितं यश्च मन्युम्।\nअदुष्टचेता मुदितोऽनसूयुः\nस आदत्ते सुकृतं वै परेषाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084545, "chapter_id": 2800, "verse_number": "१२-३०५-१२", "content_sanskrit": "आक्रुश्यमानो न वदामि किंचि\nत्क्षमाम्यहं ताड्यमानश्च नित्यम्।\nश्रेष्ठं ह्येतद्यत्क्षमामाहुरार्याः\nसत्यं तथैवार्जवमानृशंस्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084546, "chapter_id": 2800, "verse_number": "१२-३०५-१३", "content_sanskrit": "वेदस्योपनिषत्सत्यं सत्यस्योपनिषद्दमः।\nदमस्योपनिषन्मोक्ष एतत्सर्वानुशासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084547, "chapter_id": 2800, "verse_number": "१२-३०५-१४", "content_sanskrit": "वाचो वेगं मनसः क्रोधवेगं\nविधित्सावेगमुदरोपस्थवेगम्।\nएतान्वेगान्यो विषहेदुदीर्णां\nस्तं मन्येऽहं ब्राह्मणं वै मुनिं च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084548, "chapter_id": 2800, "verse_number": "१२-३०५-१५", "content_sanskrit": "अक्रोधनः क्रुध्यतां वै विशिष्ट\nस्तथा तितिक्षुरतितिक्षोर्विशिष्टः।\nअमानुषान्मानुषो वै विशिष्ट\nस्तथाऽज्ञानाज्ज्ञानवान्वै विशिष्टः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084549, "chapter_id": 2800, "verse_number": "१२-३०५-१६", "content_sanskrit": "आक्रुश्यमानो नाक्रोशेन्मन्युरेवं तितिक्षतः।\nआक्रोष्टारं निर्दहति सुकृतं चास्य विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084550, "chapter_id": 2800, "verse_number": "१२-३०५-१७", "content_sanskrit": "यो नायुक्तः प्राह रूक्षं प्रियं वा\nयो वा हतो न प्रतिहन्ति धैर्यात्।\nपापं च यो नेच्छति तस्य हन्तु\nस्तस्येह देवाः स्पृहयन्ति नित्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084551, "chapter_id": 2800, "verse_number": "१२-३०५-१८", "content_sanskrit": "पापीयसः क्षमेतैव श्रेयसः सदृशस्य च।\nविमानितो हतोक्रुष्ट एवं सिद्धिं गमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084552, "chapter_id": 2800, "verse_number": "१२-३०५-१९", "content_sanskrit": "सदाऽहमार्यान्निभृतोप्युपासे\nन मे विधित्सोत्सहते न रोषः।\nन चाप्यहं लिप्समानः परैमि\nन चैव किंचिद्विषमेण यामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084553, "chapter_id": 2800, "verse_number": "१२-३०५-२०", "content_sanskrit": "नाहं शप्तः प्रतिशपामि कंचि\nद्दमं द्वारं ह्यमृतस्येह वेद्मि।\nगुह्यं ब्रह्म तदिदं ब्रवीमि\nन मानुषाच्छ्रेष्ठतरं हि किंचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084554, "chapter_id": 2800, "verse_number": "१२-३०५-२१", "content_sanskrit": "निर्मुच्यमानः पापेभ्यो घनेभ्य इव चन्द्रमाः।\nविरजाः कालमाकाङ्क्षन्धीरो धैर्येण सिध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2084555, "chapter_id": 2800, "verse_number": "१२-३०५-२२", "content_sanskrit": "यः सर्वेषां भवति ह्यर्चनीय\nउत्सेचने स्तम्भ इवाभिजातः।\nयस्मै वाचं सुप्रसन्नां वदन्ति\nस वै देवान्गच्छति संयतात्मा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2084556, "chapter_id": 2800, "verse_number": "१२-३०५-२३", "content_sanskrit": "न तथा वक्तुमिच्छन्ति कल्याणान्पुरुषे गुणान्।\nयथैषां वक्तुमिच्छन्ति नैर्गुण्यमनुयुञ्जकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2084557, "chapter_id": 2800, "verse_number": "१२-३०५-२४", "content_sanskrit": "यस्य वाङ्भनसी गुप्ते सम्यक्प्रणिहिते सदा।\nवेदास्तपश्च त्यागश्च स इदं सर्वमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2084558, "chapter_id": 2800, "verse_number": "१२-३०५-२५", "content_sanskrit": "आक्रोशनविमानाभ्यां नाबुधान्बोधयेद्बुधः।\nतस्मान्न वर्धयेदन्यं न चात्मानं विहिंसयेंत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2084559, "chapter_id": 2800, "verse_number": "१२-३०५-२६", "content_sanskrit": "अमृतस्येव संतृप्येदवमानस्य पण्डितः।\nसुखं ह्यवमतः शेते योऽवमन्ता स नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2084560, "chapter_id": 2800, "verse_number": "१२-३०५-२७", "content_sanskrit": "यत्क्रोधनो यजति यद्ददाति\nयद्वा तपस्तप्यति यज्जुहोति।\nवैवस्वतस्तद्धरतेऽस्य सर्वं\nमोघः श्रमो भवति हि क्रोधनस्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2084561, "chapter_id": 2800, "verse_number": "१२-३०५-२८", "content_sanskrit": "चत्वारि यस्य द्वाराणि सुगुप्तान्यमरोत्तमाः।\nउपस्थमुदरं हस्तौ वाक्चतुर्थी स धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2084562, "chapter_id": 2800, "verse_number": "१२-३०५-२९", "content_sanskrit": "सत्यं दमं ह्यार्जवमानृशंस्यं\nधृतिं तितिक्षामभिसेवमानः।\nस्वाध्यायनित्योऽस्पृहयन्यरेषा\nमेकान्तशील्यूर्ध्वगतिर्भवेत्सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2084563, "chapter_id": 2800, "verse_number": "१२-३०५-३०", "content_sanskrit": "सर्वान्देदाननुचरन्वत्सवच्चतुरः स्तनान्।\nन पावनतमं किंचित्सत्याद्गध्यगमं क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2084564, "chapter_id": 2800, "verse_number": "१२-३०५-३१", "content_sanskrit": "आचक्षेऽहं मनुष्येभ्यो देवेभ्यः प्रतिसंचरन्।\nसत्यं स्वर्गस्य सोपानं पारावारस्य नौरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2084565, "chapter_id": 2800, "verse_number": "१२-३०५-३२", "content_sanskrit": "यादृशैः संविवदते यादृशांश्चोपसेवते।\nयादृगिच्छेच्च भवितुं तादृग्भवति पूरुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2084566, "chapter_id": 2800, "verse_number": "१२-३०५-३३", "content_sanskrit": "यदि सन्तं सेवति यद्यसन्तं\nतपस्विनं यदि वा स्तेनमेव।\nवासो यथा रागवशं प्रयाति\nतथा स तेषां वशमभ्युपैति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2084567, "chapter_id": 2800, "verse_number": "१२-३०५-३४", "content_sanskrit": "सदा देवाः साधुभिः संवदन्ते\nन मानुषं विषयं यान्ति द्रष्टुम्।\nनेन्दुः समः स्यादसमो हि वायु\nरुच्चावचं विषयं यः स वेद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2084568, "chapter_id": 2800, "verse_number": "१२-३०५-३५", "content_sanskrit": "अदुष्टं वर्तमाने तु हृदयान्तरपूरुषे।\nतेनैव देवाः प्रीयन्ते सतां मार्गस्थितेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2084569, "chapter_id": 2800, "verse_number": "१२-३०५-३६", "content_sanskrit": "विश्नोदरे ये निरताः सदैव\nस्तेना नरा वाक्यरुषाश्च नित्यम्।\nअपेतधर्मानिति तान्विदित्वा\nदूराद्देवः संपरिवर्जयन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2084570, "chapter_id": 2800, "verse_number": "१२-३०५-३७", "content_sanskrit": "न वै देवा हीनसत्वेन तोष्याः\nसर्वाशिना दुष्कृतकर्मणा वा।\nसत्यव्रता ये तु नराः कृतज्ञा\nधर्मे रतास्तैः सह संभजन्ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2084571, "chapter_id": 2800, "verse_number": "१२-३०५-३८", "content_sanskrit": "अव्याहृतं व्याहृताच्छ्रेय आहुः\nसत्यं वदेद्व्याहृतं तद्द्वितीयम्।\nधर्म्यं वदेद्व्याहृतं तत्तृतीयं\nप्रियं वदेद्व्याहृतं तच्चतुर्थम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2084572, "chapter_id": 2800, "verse_number": "१२-३०५-३९x", "content_sanskrit": "साध्या ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2084573, "chapter_id": 2800, "verse_number": "१२-३०५-३९", "content_sanskrit": "केनायमावृतो लोकः केन वा न प्रकाशते।\nकेन त्यजति मित्राणि केन स्वर्गं न गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2084574, "chapter_id": 2800, "verse_number": "१२-३०५-४०x", "content_sanskrit": "हंस उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2084575, "chapter_id": 2800, "verse_number": "१२-३०५-४०", "content_sanskrit": "अज्ञानेनावृतो लोको मात्सर्यान्न प्रकाशते।\nलोभात्त्यजति मित्राणि सङ्गात्स्वर्गं न गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2084576, "chapter_id": 2800, "verse_number": "१२-३०५-४१x", "content_sanskrit": "साध्या ऊचः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2084577, "chapter_id": 2800, "verse_number": "१२-३०५-४१", "content_sanskrit": "कः स्विदेको रमते ब्राह्मणानां\nकः स्विदेको बहुभिर्जोषमास्ते।\nकः स्विदेको बलवान्दुर्बलोपि\nकः स्विदेषां कलहं नान्ववैति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2084578, "chapter_id": 2800, "verse_number": "१२-३०५-४२x", "content_sanskrit": "हंस उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2084579, "chapter_id": 2800, "verse_number": "१२-३०५-४२", "content_sanskrit": "प्राज्ञ एको रमते ब्राह्मणानां\nप्राज्ञश्चैको बहुभिर्जोषमास्ते\nप्राज्ञ एको बलवान्दुर्बलोऽपि\nप्राज्ञ एषां कलहं नान्वबैति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2084580, "chapter_id": 2800, "verse_number": "१२-३०५-४३x", "content_sanskrit": "साध्या ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2084581, "chapter_id": 2800, "verse_number": "१२-३०५-४३", "content_sanskrit": "किं ब्राह्मणानां देवत्वं किंच साधुत्वमुच्यते।\nअसाधुत्वे च किं तेषां किमेषां मानुषं मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2084582, "chapter_id": 2800, "verse_number": "१२-३०५-४४x", "content_sanskrit": "हंस उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2084583, "chapter_id": 2800, "verse_number": "१२-३०५-४४", "content_sanskrit": "स्वाध्याय एषां देवत्वं व्रतं साधुत्वमुच्यते।\nअसाधुत्वं परीवादो मृत्युर्मानुष्यमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2084584, "chapter_id": 2800, "verse_number": "१२-३०५-४५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2084585, "chapter_id": 2800, "verse_number": "१२-३०५-४५", "content_sanskrit": "` इत्युक्त्वा परमो देवो भगवान्नित्य अव्ययः।\nसाध्यैर्देवगणैः सार्धं दिवमेवारुरोह सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2084586, "chapter_id": 2800, "verse_number": "१२-३०५-४६", "content_sanskrit": "एतद्यशस्यमायुष्यं पुण्यं स्वर्गाय च ध्रुवम्।\nदर्शितं देवदेवेन परमेणाव्ययेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2084587, "chapter_id": 2800, "verse_number": "१२-३०५-४७", "content_sanskrit": "संवाद इत्ययं श्रेष्ठः साध्यानां परिकीर्तितः।\nक्षेत्रं वै कर्मणां योनिः सद्भावः सत्यमुच्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2084588, "chapter_id": 2800, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि पञ्चाधिकत्रिशततमोऽध्यायः॥ ३०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]