[{"id": 2195742, "chapter_id": 5170, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195743, "chapter_id": 5170, "verse_number": "१", "content_sanskrit": "तथेत्युक्त्वा तु विहगः प्रतिज्ञाय महाद्युतिः ।\nअमृताहरणे वाचं ततः पितरमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195744, "chapter_id": 5170, "verse_number": "२", "content_sanskrit": "कामं वै सूनृता वाचो विसृज्य च मुहुर्मुहुः ।\nयच्चाप्यनुज्ञां मातुर्वै न च सा ह्यनुमन्यते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195745, "chapter_id": 5170, "verse_number": "३", "content_sanskrit": "भगवन् विनता दासी मम माता महाद्युते ।\nसा मा बहुविधा वाचो वज्रकल्पा विसृज्य वै \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195746, "chapter_id": 5170, "verse_number": "४", "content_sanskrit": "कद्रूः प्रेषयते चैव दासीयमिति चाब्रवीत् ।\nआहरामृतमित्येव मोक्ष्यते विनता ततः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195747, "chapter_id": 5170, "verse_number": "५", "content_sanskrit": "सोऽहं मातृविमोक्षार्थमाहरिष्य इति ब्रुवन् ।\nअमृतं प्रार्थितस्तूर्णमाहर्तुं प्रतिनन्द्य वै\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195748, "chapter_id": 5170, "verse_number": "", "content_sanskrit": "पिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195749, "chapter_id": 5170, "verse_number": "६", "content_sanskrit": "अमृतं तात दुष्प्रापं देवैरपि कुतस्त्वया ।\nरक्ष्यते हि भृशं पुत्र रक्षिभिस्तन्निबोध मे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195750, "chapter_id": 5170, "verse_number": "७", "content_sanskrit": "गुप्तमद्भिर्भृशं साधु सर्वतः परिवारितम् ।\nअनन्तरमथो गुप्तं ज्वलता जातवेदसा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195751, "chapter_id": 5170, "verse_number": "८", "content_sanskrit": "ततः शतसहस्राणि प्रयुतान्यर्बुदानि च ।\nरक्षन्त्यमृतमत्यर्थं किङ्करा नाम राक्षसाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195752, "chapter_id": 5170, "verse_number": "९", "content_sanskrit": "तेषां शक्त्यृष्टिशूलाश्च शतघ्न्यः पट्टसास्तथा ।\nआयुधा रक्षिणां तात वज्रकल्पाः शिलास्तथा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195753, "chapter_id": 5170, "verse_number": "१०", "content_sanskrit": "ततो जालेन महता अवनद्धं समन्ततः ।\nअयस्मयेन वै तात वृत्रहन्तुः स्म शासनात्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2195754, "chapter_id": 5170, "verse_number": "११", "content_sanskrit": "तत् त्वमेवंविधं तात कथं प्रार्थयसेऽमृतम् ।\nसुरक्षितं वज्रभृता वैनतेय विहङ्गम ।\nइन्द्रेण देवैर्नागैश्च खड्गैर्गिरिजलादिभिः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2195755, "chapter_id": 5170, "verse_number": "", "content_sanskrit": "गरुडः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2195756, "chapter_id": 5170, "verse_number": "१२", "content_sanskrit": "पुत्रगृद्ध्या ब्रवीष्येतच्छृणु तात विनिश्चयम् ।\nबलवानुपायवानस्मि भूयः किं करवाणि ते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2195757, "chapter_id": 5170, "verse_number": "१३", "content_sanskrit": "तमब्रवीत् पिता हृष्टः प्रहसन् वै पुनः पुनः ।\nयदि तौ भक्षयेस्तात क्रूरौ कच्छपवारणौ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2195758, "chapter_id": 5170, "verse_number": "१४", "content_sanskrit": "तथाबलममेयं ते भविता तन्न संशयः ।\nअमृतस्यैव चाहर्ता भविष्यसि न संशयः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2195759, "chapter_id": 5170, "verse_number": "", "content_sanskrit": "गरुडः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2195760, "chapter_id": 5170, "verse_number": "१५", "content_sanskrit": "क्व तौ क्रूरौ महाभाग वर्तेते हस्तिकच्छपौ ।\nभक्षयिष्याम्यहं तात बलस्याप्यायनं प्रति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2195761, "chapter_id": 5170, "verse_number": "", "content_sanskrit": "कश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2195762, "chapter_id": 5170, "verse_number": "१६", "content_sanskrit": "पर्वतो वै समुद्रान्ते नभः स्तब्ध्वेव तिष्ठति ।\nउरगो नाम दुष्प्रापः पुरा देवगणैरपि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2195763, "chapter_id": 5170, "verse_number": "१७", "content_sanskrit": "गोरुतं तु स विस्तीर्णः पुष्पितद्रुमसानुमान् ।\nतत्र पन्थाः कृतस्तात कुञ्जरेण बलीयसा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2195764, "chapter_id": 5170, "verse_number": "१८", "content_sanskrit": "गोरुतान्युदयस्तस्य नव सप्त च पुत्रक ।\nगच्छताऽगच्छता चैव क्षपितः स महागिरिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2195765, "chapter_id": 5170, "verse_number": "१९", "content_sanskrit": "तावान् भूमिसमस्तात कृतः पन्थाः समुत्थितः ।\nतेन गत्वा स मातङ्गः पिपासुर्युद्धमिच्छति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2195766, "chapter_id": 5170, "verse_number": "२०", "content_sanskrit": "तमतीत्य तु शैलेन्द्रं ह्रदः कोकनदायुतः ।\nकनकेति च विख्यातस्तत्र कूर्मो महाबलः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2195767, "chapter_id": 5170, "verse_number": "२१", "content_sanskrit": "गोरुतानि स विस्तीर्णः कच्छपः कुञ्जरश्च सः ।\nआयामतश्चापि समौ तेजोबलसमन्वितौ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2195768, "chapter_id": 5170, "verse_number": "२२", "content_sanskrit": "पुनरावृत्तिमापन्नौ तावेतौ मधुकैटभौ ।\nजन्मान्तरे विप्रमूढौ परस्परवधैषिणौ\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2195769, "chapter_id": 5170, "verse_number": "२३", "content_sanskrit": "यदा स नागो बृंहति पिपासुस्तं जलाशयम् ।\nतदैनं कच्छपो रोषात् प्रतियाति महाबलः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2195770, "chapter_id": 5170, "verse_number": "२४", "content_sanskrit": "नखैश्च दशनैश्चापि निमज्योन्मज्य वाऽसकृत् ।\nविददाराग्रहस्तेन कुञ्जरं तं जलेचरः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2195771, "chapter_id": 5170, "verse_number": "२५", "content_sanskrit": "नागराडपि तोयार्थी पिपासुश्चरणैरपि ।\nअग्रहस्तेन दन्ताभ्यां निवारयति वारिजम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2195772, "chapter_id": 5170, "verse_number": "२६", "content_sanskrit": "स तु तोयादनुत्तिष्ठन् वारिजो गजयूथपम् ।\nनखैश्च दशनैश्चैव द्विरदं प्रतिषेधति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2195773, "chapter_id": 5170, "verse_number": "२७", "content_sanskrit": "निवारितो गजश्रेष्ठः पुनर्गच्छति स्वं वनम् ।\nपिपासुः क्लिन्नहस्ताग्रो रुधिरेण समुक्षितः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2195774, "chapter_id": 5170, "verse_number": "२८", "content_sanskrit": "तौ गच्छ सहितौ पुत्र यदि शक्नोषि भक्षय ।\nन तौ पृथक्तया शक्यावप्रमत्तौ बले स्थितौ\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2195775, "chapter_id": 5170, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे गरुडोपाख्याने गजकच्छपवर्णनं नाम एकविंशोऽध्यायः ॥२१॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]