[{"id": 2135410, "chapter_id": 3934, "verse_number": "", "content_sanskrit": "देवदूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2135411, "chapter_id": 3934, "verse_number": "१", "content_sanskrit": "महर्षे आर्यबुद्धिस्त्वं यः स्वर्गसुखमुत्तमम् ।\nसम्प्राप्तं बहु मन्तव्यं विमृशस्यबुधो यथा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2135412, "chapter_id": 3934, "verse_number": "", "content_sanskrit": "(नन्दनादीनि रम्याणि तत्रोद्यानानि मुद्गल ।\nसर्वकामफलैर्वृक्षैः शोभितानि समन्ततः ॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2135413, "chapter_id": 3934, "verse_number": "२", "content_sanskrit": "उपरिष्टादसौ लोको योऽयं स्वरिति सञ्ज्ञितः ।\nऊर्ध्वगः सत्पथः शश्वद् देवयानचरो मुने \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2135414, "chapter_id": 3934, "verse_number": "३", "content_sanskrit": "नातप्ततपसः पुंसो नामहायज्ञयाजिनः ।\nनानृता नास्तिकाश्चैव तत्र गच्छन्ति मुद्गल \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2135415, "chapter_id": 3934, "verse_number": "४", "content_sanskrit": "धर्मात्मानो जितात्मानः शान्ता दान्ता विमत्सराः ।\nदानधर्मपरा नित्यं शूराश्चाहवलक्षणाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2135416, "chapter_id": 3934, "verse_number": "५", "content_sanskrit": "तत्र गच्छन्ति कर्माग्र्यं कृत्वा शमदमात्मकम् ।\nलोकान् पुण्यकृतां ब्रह्मन् सद्भिराचरितान् नृभिः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2135417, "chapter_id": 3934, "verse_number": "६", "content_sanskrit": "देवाः साध्यास्तथा विश्वे तथैव च महर्षयः ।\nधर्मो धामाश्च मौद्गल्य गन्धर्वाप्सरसस्तथा \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2135418, "chapter_id": 3934, "verse_number": "७", "content_sanskrit": "एषां देवनिकायानां पृथक्पृथगनेकशः ।\nभास्वन्तः कामसम्पन्ना लोकास्तेजोमयाः शुभाः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2135419, "chapter_id": 3934, "verse_number": "८", "content_sanskrit": "त्रयस्त्रिशंत्सहस्राणि योजनानि हिरण्मयः ।\nमेरुः पर्वतराड् यत्र देवोद्यानानि मुद्गल \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2135420, "chapter_id": 3934, "verse_number": "९", "content_sanskrit": "नन्दनादीनि पुण्यानि विहाराः पुण्यकर्मणाम्।\nन क्षुत्पिपासे न ग्लानिर्न शीतोष्णभयं तथा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2135421, "chapter_id": 3934, "verse_number": "१०", "content_sanskrit": "बीभत्समशुभं वापि तत्र किञ्चिन्न विद्यते ।\nमनोज्ञाः सर्वतो गन्धाः सुखस्पर्शाश्च सर्वशः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2135422, "chapter_id": 3934, "verse_number": "११", "content_sanskrit": "शब्दाः श्रुतिमनोग्राह्याः सर्वतस्तत्र वै मुने ।\nन शोको न जरा तत्र नायासः परिदेवनम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2135423, "chapter_id": 3934, "verse_number": "१२", "content_sanskrit": "ईदृशः स मुने लोकः स्वकर्मफलहेतुकः ।\nसुकृतैस्तत्र पुरुषाः सम्भवन्त्यात्मकर्मभिः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2135424, "chapter_id": 3934, "verse_number": "१३", "content_sanskrit": "तैजसानि शरीराणि भवन्त्यत्रोपपद्यताम् ।\nकर्मजान्येव मौद्गल्य न मातृपितृजान्युत \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2135425, "chapter_id": 3934, "verse_number": "१४", "content_sanskrit": "न च स्वेदो न दौर्गन्ध्यं पुरीषं मूत्रमेव च ।\nतेषां न च रजो वस्त्रं बाधते तत्र वै मुने \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2135426, "chapter_id": 3934, "verse_number": "१५", "content_sanskrit": "न म्लायन्ति स्रजस्तेषां दिव्यगन्धा मनोरमाः ।\nसंयुज्यन्ते विमानैश्च ब्रह्मन्नेवंविधैश्च ते \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2135427, "chapter_id": 3934, "verse_number": "१६", "content_sanskrit": "ईर्ष्याशोकक्लमापेता मोहमात्सर्यवर्जिताः ।\nसुखं स्वर्गजितस्तत्र वर्तयन्ते महामुने \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2135428, "chapter_id": 3934, "verse_number": "१७", "content_sanskrit": "तेषां तथाविधानां तु लोकानां मुनिपुङ्गव ।\nउपर्युपरि लोकस्य लोका दिव्या गुणान्विताः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2135429, "chapter_id": 3934, "verse_number": "१८", "content_sanskrit": "परस्ताद् ब्राह्मणास्तत्र लोकास्तेजोमयाः शुभाः ।\nयत्र यान्त्यृषयो ब्रह्मन् पूताः स्वैः कर्मभिः शुभैः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2135430, "chapter_id": 3934, "verse_number": "१९", "content_sanskrit": "ऋजवो नाम तत्रान्ये देवानामपि देवताः ।\nतेषां लोकात् परतरे यान्यजन्तीह देवताः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2135431, "chapter_id": 3934, "verse_number": "२०", "content_sanskrit": "स्वयम्प्रभास्ते भास्वन्तो लोकाः कामदुघाः परे।\nन तेषां स्त्रीकृतस्तापो न लोकैश्वर्यमत्सरः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2135432, "chapter_id": 3934, "verse_number": "२१", "content_sanskrit": "न वर्तयन्त्याहुतिभिस्ते नाप्यमृतभोजनाः ।\nतथा दिव्यशरीरास्ते न च विग्रहमूर्तयः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2135433, "chapter_id": 3934, "verse_number": "२२", "content_sanskrit": "नासुखाः सुखकामास्ते देवदेवाः सनातनाः ।\nन कल्पपरिवर्तेषु परिवर्तन्ति ते तथा \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2135434, "chapter_id": 3934, "verse_number": "२३", "content_sanskrit": "जरा मृत्युः कुतस्तेषां हर्षः प्रीतिः सुखं न च ।\nन दुःखं न सुखं चापि रागद्वेषौ कुतो मुने \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2135435, "chapter_id": 3934, "verse_number": "२४", "content_sanskrit": "देवानामपि मौद्गल्य काङ्क्षिता सा गतिः परा ।\nदुष्प्रापा परमा सिद्धिरगम्या कामगोचरैः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2135436, "chapter_id": 3934, "verse_number": "२५", "content_sanskrit": "त्रयस्त्रिशंदिमे देवा येषां लोका मनीषिभिः ।\nगम्यन्ते नियमैः श्रेष्ठैर्दानैर्वा विधिपूर्वकैः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2135437, "chapter_id": 3934, "verse_number": "२६", "content_sanskrit": "सेयं दानकृता व्युष्टिरनुप्राप्ता सुखावहा ।\nतां भुङ्क्ष्व सुकृतैर्लब्धां तपसा द्योतितप्रभः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2135438, "chapter_id": 3934, "verse_number": "२७", "content_sanskrit": "एतत् स्वर्गसुखं विप्र लोका नानाविधास्तथा ।\nगुणाः स्वर्गस्य प्रोक्तास्ते दोषानपि निबोध मे \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2135439, "chapter_id": 3934, "verse_number": "२८", "content_sanskrit": "कृतस्य कर्मणस्तत्र भुज्यते यत्फलं दिवि ।\nन चान्यत् क्रियते कर्म मूलच्छेदेन भुज्यते \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2135440, "chapter_id": 3934, "verse_number": "२९", "content_sanskrit": "सोऽत्र दोषो मम मतस्तस्यान्ते पतनं च यत् ।\nसुखव्याप्तस्य सहसा पतनं यच्च मुद्गल \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2135441, "chapter_id": 3934, "verse_number": "३०", "content_sanskrit": "असन्तोषः परीतापो दृष्ट्वा दीप्तां परश्रियम् ।\nयद् भवत्यमरस्थाने स्थितानां तत् सुदुष्करम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2135442, "chapter_id": 3934, "verse_number": "३१", "content_sanskrit": "सञ्ज्ञामोहश्च पततां रजसा च प्रधर्षणम् ।\nप्रम्लानेषु च माल्येषु ततः पिपतिषोर्भयम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2135443, "chapter_id": 3934, "verse_number": "३२", "content_sanskrit": "आब्रह्मभवनादेते दोषा मौद्गल्य दारुणाः ।\nनाकलोके सुकृतिनां गुणास्त्वयुतशो नृणाम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2135444, "chapter_id": 3934, "verse_number": "३३", "content_sanskrit": "अयं त्वन्यो गुणः श्रेष्ठश्च्युतानां स्वर्गतो मुने ।\nशुभानुशययोगेन मनुष्येषूपजायते \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2135445, "chapter_id": 3934, "verse_number": "३४", "content_sanskrit": "तत्रापि स महाभागः सुखभागभिजायते ।\nन चेत् सम्बुध्यते तत्र गच्छत्यधमतां ततः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2135446, "chapter_id": 3934, "verse_number": "३५", "content_sanskrit": "इह यत् क्रियते कर्म तत् परत्रोपभुज्यते।\nकर्मभूमिरियं ब्रह्मन् फलभूमिरसौ मता \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2135447, "chapter_id": 3934, "verse_number": "३६", "content_sanskrit": "एतत् ते सर्वमाख्यातं यन्मां पृच्छसि मुद्गल ।\nतवानुकम्पया साधो साधु गच्छाम माचिरम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2135448, "chapter_id": 3934, "verse_number": "", "content_sanskrit": "मौद्गल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2135449, "chapter_id": 3934, "verse_number": "३७", "content_sanskrit": "महान्तः खल्वमी दोषा त्वया स्वर्गस्य कीर्तिताः ।\nनिर्दोष एव यस्त्वन्यो लोकं तं वै वदस्व मे \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2135450, "chapter_id": 3934, "verse_number": "", "content_sanskrit": "देवदूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2135451, "chapter_id": 3934, "verse_number": "३८", "content_sanskrit": "ब्रह्मणः सदनादूर्ध्वं तद् विष्णोः परमं पदम् ।\nशुद्धं सनातनं ज्योतिः परं ब्रह्मेति यं विदुः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2135452, "chapter_id": 3934, "verse_number": "३९", "content_sanskrit": "न तत्र विप्र गच्छन्ति पुरुषा विषयात्मकाः ।\nडम्भलोभमदक्रोधमोहद्रोहैरभिद्रुताः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2135453, "chapter_id": 3934, "verse_number": "४०", "content_sanskrit": "निर्ममा निरहङ्कारा निर्द्वन्द्वाः संयतेन्द्रियाः ।\nध्यानयोगपराश्चैव तत्र गच्छन्ति मानवाः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2135454, "chapter_id": 3934, "verse_number": "", "content_sanskrit": "श्रीव्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2135455, "chapter_id": 3934, "verse_number": "४१", "content_sanskrit": "एतच्छ्रुत्वा तु मौद्गल्यो वाक्यं विममृशे धिया ।\nविमृश्य च मुनिश्रेष्ठो देवदूतमुवाच ह \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2135456, "chapter_id": 3934, "verse_number": "४२", "content_sanskrit": "देवदूत नमस्तेऽस्तु गच्छ तात यथासुखम्।\nमहादोषेण मे कार्यं न स्वर्गेण सुखेन वा \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2135457, "chapter_id": 3934, "verse_number": "४३", "content_sanskrit": "पतनान्ते महद् दुःखं परितापः सुदारुणः ।\nस्वर्गभाजश्चरन्तीह तस्मात् स्वर्गं न कामये \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2135458, "chapter_id": 3934, "verse_number": "४४", "content_sanskrit": "यत्र गत्वा न शोचन्ति न व्यथन्ते चलन्ति वा ।\nतदहं स्थानमत्यन्तं मार्गयिष्यामि केवलम् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2135459, "chapter_id": 3934, "verse_number": "", "content_sanskrit": "व्यासः-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2135460, "chapter_id": 3934, "verse_number": "४५", "content_sanskrit": "इत्युक्त्वा स मुनिर्वाक्यं देवदूतं विसृज्य तम् ।\nसिलोञ्छवृत्तिर्धर्मात्मा शममातिष्ठदुत्तमम् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2135461, "chapter_id": 3934, "verse_number": "४६", "content_sanskrit": "तुल्यनिन्दास्तुतिर्भूत्वा समलोष्टाश्मकाञ्चनः ।\nज्ञानयोगेन शुद्धेन ध्याननित्यो बभूव ह \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2135462, "chapter_id": 3934, "verse_number": "४७", "content_sanskrit": "विनिगृह्येन्द्रियग्रामं समयोजयदात्मनि ।\nयुक्तचिन्तं तथात्मानं युयोज परमेश्वरे ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2135463, "chapter_id": 3934, "verse_number": "४८", "content_sanskrit": "ध्यानयोगाद् बलं लब्ध्वा प्राप्य बुद्धिमनुत्तमाम् ।\nजगाम शाश्वतीं सिद्धि परां निर्वाणलक्षणाम् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2135464, "chapter_id": 3934, "verse_number": "४९", "content_sanskrit": "तस्मात् त्वमपि कौन्तेय न शोकं कर्तुमर्हसि ।\nराज्यात् स्फीतात् परिभ्रष्टस्तपसा तदवाप्स्यसि \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2135465, "chapter_id": 3934, "verse_number": "५०", "content_sanskrit": "सुखस्यानन्तरं दुःखं दुःखस्यानन्तरं सुखम् ।\nपर्यायेणोपसर्पन्ते नरं नेमिमरा इव \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2135466, "chapter_id": 3934, "verse_number": "५१", "content_sanskrit": "पितृपैतामहं राज्यं प्राप्स्यस्यमितविक्रम ।\nवर्षात् त्रयोदशादूर्ध्वं व्येतु ते मानसो ज्वरः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2135467, "chapter_id": 3934, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2135468, "chapter_id": 3934, "verse_number": "५२", "content_sanskrit": "स एवमुक्त्वा भगवान् व्यासः पाण्डवनन्दनम् ।\nजगाम तपसे धीमान् पुनरेवाश्रमं प्रति \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2135469, "chapter_id": 3934, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि व्रीहिद्रौणिकपर्वणि मुद्गलदेवदूतसंवादे एकपञ्चाशदधिकद्विशततमोऽध्यायः ॥२५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2135470, "chapter_id": 3934, "verse_number": "४", "content_sanskrit": "॥ व्रीहिद्रौणिकपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2135471, "chapter_id": 3934, "verse_number": "", "content_sanskrit": "॥ समाप्तं व्रीहीद्रौणिकपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2135472, "chapter_id": 3934, "verse_number": "", "content_sanskrit": "––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]