[{"id": 2072267, "chapter_id": 2524, "verse_number": "१२-२९-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072268, "chapter_id": 2524, "verse_number": "१२-२९-१", "content_sanskrit": "स कथं काञ्चनष्ठीवी सृञ्जयस्य सुतोऽभवत्।\nपर्वतेन किमथे वा दत्तस्तेन ममार च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072269, "chapter_id": 2524, "verse_number": "१२-२९-२", "content_sanskrit": "यदा वर्षसहस्रायुस्तदा भवति मानवः।\nकथमप्राप्तकौमारः सृञ्जयस्य सुतो मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072270, "chapter_id": 2524, "verse_number": "१२-२९-३", "content_sanskrit": "उताहो नाममात्रं वै सुवर्णष्ठीविनोऽभवत्।\nकथं वा काञ्चनष्ठीवीत्येतदिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072271, "chapter_id": 2524, "verse_number": "१२-२९-४x", "content_sanskrit": "श्रीकृष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072272, "chapter_id": 2524, "verse_number": "१२-२९-४", "content_sanskrit": "अत्र ते वर्णयिष्यामि यथावृत्तं जनेश्वर।\nनारदः पर्वतश्चैव द्वावृवी लोकसत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072273, "chapter_id": 2524, "verse_number": "१२-२९-५", "content_sanskrit": "मातुलो भागिनेयश्च देवलोकादिहागतौ।\nविहर्तुकामौ संप्रीत्या मानुषेषु पुरा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072274, "chapter_id": 2524, "verse_number": "१२-२९-६", "content_sanskrit": "हविःपवित्रभोज्येन देवभोज्येन चैव हि।\nनारदो मातुलस्तत्र भागिनेयश्च पर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072275, "chapter_id": 2524, "verse_number": "१२-२९-७", "content_sanskrit": "तावुभौ तपसोपेताववनीतलचारिणौ।\nभुञ्जानौ मानुषान्भोगान्यथावत्पर्यधावताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072276, "chapter_id": 2524, "verse_number": "१२-२९-८", "content_sanskrit": "प्रीतिमन्तौ मुदा युक्तौ समयं चैव चक्रतुः।\nयो भवेद्धृदि संकल्पः शुभो वा यदि वाऽशुभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072277, "chapter_id": 2524, "verse_number": "१२-२९-९", "content_sanskrit": "अन्योन्यस्य च आख्येयो मृषा शापोऽन्यथा भवेत्।\nतौ तथेति प्रतिज्ञाय महर्षी लोकपूजितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072278, "chapter_id": 2524, "verse_number": "१२-२९-१०", "content_sanskrit": "सृञ्जयं श्वैत्यमभ्येत्य राजानमिदमूचतुः।\nआवां भवति वत्स्यावः कंचित्कालं हिताय ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072279, "chapter_id": 2524, "verse_number": "१२-२९-११", "content_sanskrit": "यथावत्पृथिवीपाल आवयोः प्रगुणीभव।\nतथेति कृत्वा राजा तौ सत्कृत्योपचचार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072280, "chapter_id": 2524, "verse_number": "१२-२९-१२", "content_sanskrit": "ततः कदाचित्तौ राजा महात्मानौ तपोधनौ।\nअब्रवीत्परमप्रीतः सुतेयं देवरूपिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072281, "chapter_id": 2524, "verse_number": "१२-२९-१३", "content_sanskrit": "एकैव मम कन्यैषा युवां परिचरिष्यति।\nदर्शनीयानवद्याङ्गी शीलवृत्तसमाहिता।\nसुकुमारी कुमारी च पझकिञ्जल्कसुप्रभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072282, "chapter_id": 2524, "verse_number": "१२-२९-१४", "content_sanskrit": "परमं सौम्यमित्युक्तं ताभ्यां राजा शशास ताम्।\nकन्ये विप्रावुपचर देववत्पितृवच्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072283, "chapter_id": 2524, "verse_number": "१२-२९-१५", "content_sanskrit": "सा तु कन्या तथेत्युक्त्वा पितरं धर्मचारिणी।\nयथानिदेशं राज्ञस्तौ सत्कृत्योपचचार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072284, "chapter_id": 2524, "verse_number": "१२-२९-१६", "content_sanskrit": "तस्यास्तेनोपचारेण रूपेणाप्रतिमेन च।\nनारदं हृच्छयस्तूर्णं सहसैवाभ्यपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072285, "chapter_id": 2524, "verse_number": "१२-२९-१७", "content_sanskrit": "ववृधे हि ततस्तस्य हृदि कामो महात्मनः।\nयथा शुक्लस्य पक्षस्य प्रवृत्तौ चन्द्रमाः शनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072286, "chapter_id": 2524, "verse_number": "१२-२९-१८", "content_sanskrit": "न च तं भागिनेयाय पर्वताय महात्मने।\nशशंस मन्मथं तीव्रं व्रीडमानः स धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072287, "chapter_id": 2524, "verse_number": "१२-२९-१९", "content_sanskrit": "तपसा चेङ्गितैश्चैव पर्वतोऽथ बुबोध तम्।\nकामार्तं नारदं क्रुद्धः शशापैनं ततो भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2072288, "chapter_id": 2524, "verse_number": "१२-२९-२०", "content_sanskrit": "कृत्वा समयमव्यग्रो भवान्वै सहितो मया।\nयो भवेद्धृदि संकल्पः शुभो वा यदि वाऽशुभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2072289, "chapter_id": 2524, "verse_number": "१२-२९-२१", "content_sanskrit": "अन्योन्यस्य स आख्येय इति तद्वै मृषा कृतम्।\nभवता वचनं ब्रह्मंस्तस्मादेष शपाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2072290, "chapter_id": 2524, "verse_number": "१२-२९-२२", "content_sanskrit": "न हि कामं प्रवर्तन्तं भवानाचष्ट मे पुरा।\nसुकुमार्यां कुमार्यां ते तस्मान्नैष क्षमाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2072291, "chapter_id": 2524, "verse_number": "१२-२९-२३", "content_sanskrit": "ब्रह्मचारी गुरुर्यस्मात्तपस्वी ब्राह्मणश्च सन्।\nअकार्षीः समयभ्रंशमावाभ्यां यः कृतो मिथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2072292, "chapter_id": 2524, "verse_number": "१२-२९-२४", "content_sanskrit": "शप्स्ये तस्मात्सुसंक्रुद्धो भवन्तं तं निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2072293, "chapter_id": 2524, "verse_number": "१२-२९-२५", "content_sanskrit": "सुकुमारी च ते भार्या भविष्यति न संशयः।\nवानरत्वं च ते कन्या विवाहात्प्रभृति प्रभो।\nसंद्रक्ष्यन्ति नराश्चान्ये स्वरूपेण विनाकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2072294, "chapter_id": 2524, "verse_number": "१२-२९-२६", "content_sanskrit": "स तद्वाक्यं तु विज्ञाय नारदः पर्वतं तथा।\nअशपत्तमपि क्रोधाद्भागिनेयं स मातुलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2072295, "chapter_id": 2524, "verse_number": "१२-२९-२७", "content_sanskrit": "तपसा ब्रह्मचर्येण सत्येन च दमेन च।\nयुक्तोऽपि नित्यधर्मश्च न वै स्वर्गमवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2072296, "chapter_id": 2524, "verse_number": "१२-२९-२८", "content_sanskrit": "तौ तु शावा भृशं क्रुद्धौ परस्परममर्षणौ।\nप्रतिजग्मतुहृन्योन्यं क्रुद्धाविव गजोत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2072297, "chapter_id": 2524, "verse_number": "१२-२९-२९", "content_sanskrit": "पर्वतः पृथिवीं कृत्स्नां विचचार महामतिः।\nपूज्यमानो यथान्यांयं तेजसा स्वेन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2072298, "chapter_id": 2524, "verse_number": "१२-२९-३०", "content_sanskrit": "अथ तामलभत्कन्यां नारदः सृञ्जयात्मजाम्।\nधर्मेण विप्रप्रवरः सुकुमारीमनिन्दिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2072299, "chapter_id": 2524, "verse_number": "१२-२९-३१", "content_sanskrit": "सा तु कन्या यथाशापं नारदं तं ददर्श ह।\nपाणिग्रहणमन्त्राणां नियोगादेव नारदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2072300, "chapter_id": 2524, "verse_number": "१२-२९-३२", "content_sanskrit": "सुकुमारी च देवर्षि वानरप्रतिमाननम्।\nनैवावमन्यत तदा प्रीतिमत्येव चाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2072301, "chapter_id": 2524, "verse_number": "१२-२९-३३", "content_sanskrit": "उपतस्थे च भर्तारं न चान्यं मनसाऽप्यगात्।\nदेवं मुनीं वा यक्षं वा पतित्वे पतिवत्सला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2072302, "chapter_id": 2524, "verse_number": "१२-२९-३४", "content_sanskrit": "ततः कदाचिद्भगवान्पर्वतोऽनुचचार ह।\nवनं विरहितं किंचित्तत्रापश्यत्स नारदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2072303, "chapter_id": 2524, "verse_number": "१२-२९-३५", "content_sanskrit": "ततोऽभिवाद्य प्रोवाच नारदं पर्वतस्तदा।\nभवान्प्रसादं कुरुतात्स्वर्गादेशाय ये प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2072304, "chapter_id": 2524, "verse_number": "१२-२९-३६", "content_sanskrit": "तमुवाच ततो दृष्ट्वा पर्वतं नारदस्तथा।\nकृताञ्जलिमुपासीनं दीनं दीनतरः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2072305, "chapter_id": 2524, "verse_number": "१२-२९-३७", "content_sanskrit": "त्वयाऽहं प्रथमं शप्तो वानरस्त्वं भविष्यसि।\nइत्युक्तेन मया पश्चाच्छप्तस्तवमपि मत्सरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2072306, "chapter_id": 2524, "verse_number": "१२-२९-३८", "content_sanskrit": "अद्यप्रभृति वै वासं स्वर्गे नावाप्स्यसीति ह।\nतव नैतद्विसदृशं पुत्रस्थाने हि मे भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2072307, "chapter_id": 2524, "verse_number": "१२-२९-३९", "content_sanskrit": "निवर्तयेतां तौ शापावन्योन्येन तदा मुनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2072308, "chapter_id": 2524, "verse_number": "१२-२९-४०", "content_sanskrit": "श्रीसमृद्धं तदा दृष्ट्वा नारदं देवरूपिणम्।\nसुकुमारी प्रदुद्राव परपुंसविशङ्कया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2072309, "chapter_id": 2524, "verse_number": "१२-२९-४१", "content_sanskrit": "तां पर्वतस्ततो दृष्ट्वा प्रद्रवन्तीमनिन्दिताम्।\nअब्रवीत्तव भर्तैष नात्र कार्या विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2072310, "chapter_id": 2524, "verse_number": "१२-२९-४२", "content_sanskrit": "ऋषिः परमधर्मात्मा नारदो भगवान्प्रभुः।\nतवैवाभेद्यहृदयो मा ते भूदत्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2072311, "chapter_id": 2524, "verse_number": "१२-२९-४३", "content_sanskrit": "सानुनीता बहुविधं पर्वतेन महात्मना।\nशापदोषं च तं भर्तुः श्रुत्वा प्रकृतिमागता।\nपर्वतोऽथ ययौ स्वर्गं नारदोऽभ्यगमद्गृहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2072312, "chapter_id": 2524, "verse_number": "१२-२९-४४x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2072313, "chapter_id": 2524, "verse_number": "१२-२९-४४", "content_sanskrit": "प्रत्यक्षकर्ता सर्वस्य नारदो भगवानृषिः।\nएष वक्ष्यति ते पृष्टो यथावृत्तं नरोत्तम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2072314, "chapter_id": 2524, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकोनत्रिंशोऽध्यायः॥ २९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]