[{"id": 2079297, "chapter_id": 2688, "verse_number": "१२-१९३-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2079298, "chapter_id": 2688, "verse_number": "१२-१९३-१", "content_sanskrit": "हन्त वक्ष्यामि ते पार्थ ध्यानयोगं चतुर्विधम्।\nयं ज्ञात्वा शाश्वतीं सिद्धिं गच्छन्तीह महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2079299, "chapter_id": 2688, "verse_number": "१२-१९३-२", "content_sanskrit": "यथा स्वनुष्ठितं ध्यानं तथा कुर्वन्ति योगिनः।\nमहर्षयो ज्ञानतृप्ता निर्वाणगतमानसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2079300, "chapter_id": 2688, "verse_number": "१२-१९३-३", "content_sanskrit": "नावर्तन्ते पुनः पार्थ मुक्ताः संसारदोषतः।\nअन्मदोषपरिक्षीणाः स्वभावे पर्युपस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2079301, "chapter_id": 2688, "verse_number": "१२-१९३-४", "content_sanskrit": "निर्द्वन्द्वा नित्यसत्वस्था विमुक्तिं नित्यमश्रिताः।\nअसङ्गीन्यविवादीनि मनः शान्तिकराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2079302, "chapter_id": 2688, "verse_number": "१२-१९३-५", "content_sanskrit": "तत्र ध्यानेन संश्लिष्टमेकाग्रे धारयेन्मनः।\nतत्र च ध्यानसंरोधादथ ज्ञानी भवत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2079303, "chapter_id": 2688, "verse_number": "१२-१९३-६", "content_sanskrit": "चतुर्विधेषु भावेषु योऽर्थसक्तः सदैव हि।\nतज्ज्ञात्वा वास्तवं तेषामर्थेषु परिवर्तते।\nपिण्डीकृत्येन्द्रियग्राममासीनः काष्ठवन्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2079304, "chapter_id": 2688, "verse_number": "१२-१९३-७", "content_sanskrit": "शब्दं न विन्देच्छ्रोत्रेण त्वचा स्पर्शं न वेदयेत्।\nरूपं न चक्षुषा विद्याज्जिह्वया न रसांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2079305, "chapter_id": 2688, "verse_number": "१२-१९३-८", "content_sanskrit": "घ्रेयाण्यपि च सर्वाणि जह्याद्राणेन योगवित्।\nपञ्चवर्गप्रमाथीनि नेच्छेच्चैतानि वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2079306, "chapter_id": 2688, "verse_number": "१२-१९३-९", "content_sanskrit": "ततो मनसि संसृज्य पञ्चवर्ग विचक्षणः।\nसमादध्यान्मनो भ्रान्तमिन्द्रियैः सह पञ्चमिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2079307, "chapter_id": 2688, "verse_number": "१२-१९३-१०", "content_sanskrit": "विसंचारि निरालम्बं पञ्चद्वारं चलाचलम्।\nपूर्वं ध्यानपदे धीरः समादध्यान्मनो नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2079308, "chapter_id": 2688, "verse_number": "१२-१९३-११", "content_sanskrit": "इन्द्रियाणि मनश्चैव यदा पिण्डीकरोत्ययम्।\nएव ध्यानपथः पूर्वो मया समनुवर्णितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2079309, "chapter_id": 2688, "verse_number": "१२-१९३-१२", "content_sanskrit": "तस्य तत्पूर्वसंरुद्धमात्सषष्ठं मनोऽन्तरा।\nस्फुरिष्यति समुद्धान्तं विद्युदम्बुधरे यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2079310, "chapter_id": 2688, "verse_number": "१२-१९३-१३", "content_sanskrit": "जलबिन्दुर्यथा लोलः पर्णस्थः सर्वतश्चलः।\nएवमेवास्य तच्चित्तं भ्रमति ध्यानवर्त्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2079311, "chapter_id": 2688, "verse_number": "१२-१९३-१४", "content_sanskrit": "समाहितं क्षणं किंचिद्ध्यानवर्त्मनि तिष्ठति।\nपुनर्वायुपथं प्राप्तं मनो भवति वायुवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2079312, "chapter_id": 2688, "verse_number": "१२-१९३-१५", "content_sanskrit": "अनिर्वेदो गतक्लेशो गततन्द्रीरमत्सरः।\nसमादध्यात्पुनश्चेतो ध्यानेन ध्यानयोगवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2079313, "chapter_id": 2688, "verse_number": "१२-१९३-१६", "content_sanskrit": "विचारश्च विवेकश्च वितर्कश्चोपजायते।\nमुनेः समादधानस्य प्रथमं ध्यानमादितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2079314, "chapter_id": 2688, "verse_number": "१२-१९३-१७", "content_sanskrit": "मनसा क्लिश्यमानस्तु समाधानं च कारयेत्।\nन निर्वेदं मुनिर्गच्छेत्कुर्यादेवात्मनो हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2079315, "chapter_id": 2688, "verse_number": "१२-१९३-१८", "content_sanskrit": "पांसुभस्मकरीषाणां यथा वै राशयश्चिताः।\nसहसा वारिणा सिक्ता न यान्ति परिभावनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2079316, "chapter_id": 2688, "verse_number": "१२-१९३-१९", "content_sanskrit": "किंचित्स्निग्धं यथा च स्याच्छुष्कचूर्णमभावितम्।\nक्रमशस्तु शनैर्गच्छेत्सर्वं तत्परिभावनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2079317, "chapter_id": 2688, "verse_number": "१२-१९३-२०", "content_sanskrit": "एवमेवेन्द्रियग्रामं शनैः संपरिभावयेत्।\nसंहरेत्क्रमशश्चैनं स सम्यक्प्रशमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2079318, "chapter_id": 2688, "verse_number": "१२-१९३-२१", "content_sanskrit": "स्वयमेव मनश्चैवं पञ्चवर्गं च भारत।\nपूर्वं ध्यानपथे स्थाप्य नित्ययोगेन शाम्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2079319, "chapter_id": 2688, "verse_number": "१२-१९३-२२", "content_sanskrit": "न तत्पुरुषकारेण न च दैवेन केनचित्।\nसुखमेष्यति तत्तस्य न भवन्ति विपत्तयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2079320, "chapter_id": 2688, "verse_number": "१२-१९३-२३", "content_sanskrit": "सुखेन तेन संयुक्तो रस्यते ध्यानकर्मणि।\nगच्छन्ति योगिनो ह्येवं निर्वाणं तन्निरामयम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2079321, "chapter_id": 2688, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्रिनवत्यधिकशततमोऽध्यायः॥ १९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]