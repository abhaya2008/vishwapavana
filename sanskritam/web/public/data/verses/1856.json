[{"id": 2039108, "chapter_id": 1856, "verse_number": "५-१०१-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039109, "chapter_id": 1856, "verse_number": "५-१०१-१", "content_sanskrit": "अयं लोकः सुपर्णानां पक्षिणां पन्नगाशिनाम् ।\nविक्रमे गमने भारे नैषामस्ति परिश्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039110, "chapter_id": 1856, "verse_number": "५-१०१-२", "content_sanskrit": "वैनतेयसुतैः सूत पङ्भिस्ततमिदं कुलम् ।\nसुमुखेन सुनाम्ना च सुनेत्रेण सुवर्चसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039111, "chapter_id": 1856, "verse_number": "५-१०१-३", "content_sanskrit": "सुरुचा पक्षिराजेन सुबलेन च मातले।\nवर्धितानि प्रसृत्या वै विनाताकुलकर्तृभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039112, "chapter_id": 1856, "verse_number": "५-१०१-४", "content_sanskrit": "पक्षिराजाभिजात्यानां सहस्राणि शतानि च।\nकश्यपस्य ततो वंशे जातैर्भूतिविवर्धनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039113, "chapter_id": 1856, "verse_number": "५-१०१-५", "content_sanskrit": "सर्वे ह्येते श्रिया युक्ताः सर्वे श्रीवत्सलक्षणाः ।\nसर्वे श्रियमभीप्सन्तो धारयन्ति बलान्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039114, "chapter_id": 1856, "verse_number": "५-१०१-६", "content_sanskrit": "कर्मणा क्षत्रियाश्चैते निर्घृणा भोगिभोजिनः ।\nज्ञातिसङ्क्षयकर्तृत्वाद्ब्राह्मण्यं न लभन्ति वैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039115, "chapter_id": 1856, "verse_number": "५-१०१-७", "content_sanskrit": "नामानि चैषां वक्ष्यामि यथाप्राधान्यतः श्रृणु ।\nमातले श्लाघ्यमेतद्धि कुलं विष्णुपरिग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039116, "chapter_id": 1856, "verse_number": "५-१०१-८", "content_sanskrit": "दैवतं विष्णुरेतेषां विष्णुरेव परायणम् ।\nहृदि चैषां सदा विष्णुर्विष्णुरेव सदा गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039117, "chapter_id": 1856, "verse_number": "५-१०१-९", "content_sanskrit": "सुवर्णचूडो नागाशी दारुणश्चण्डतुण्डकः ।\nअनिलश्चानलश्चैव विशालाक्षोऽथ कुण्डली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039118, "chapter_id": 1856, "verse_number": "५-१०१-१०", "content_sanskrit": "पङ्कजिद्वज्रविष्कम्भो वैनतेयोऽथ वामनः ।\nवातवेगो दिशाचक्षुर्निमेषोऽनिमिषस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039119, "chapter_id": 1856, "verse_number": "५-१०१-११", "content_sanskrit": "त्रिरावः सप्तरावश्च वाल्मीकिर्दीपकस्तथा ।\nदैत्यद्वीपः सरिद्द्वीपः सारसः पद्मकेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039120, "chapter_id": 1856, "verse_number": "५-१०१-१२", "content_sanskrit": "सुमुखश्चित्रकेतुश्च चित्रबर्हस्तथाऽनघः।\nमेषहृत्कुमुदो दक्षः सर्पान्तः सोमभोजनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039121, "chapter_id": 1856, "verse_number": "५-१०१-१३", "content_sanskrit": "गुरुभारः कपोतश्च सूर्यनेत्रश्चिरान्तकः ।\nविष्णुधर्मा कुमारश्च परिबर्हो हरिस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039122, "chapter_id": 1856, "verse_number": "५-१०१-१४", "content_sanskrit": "सुस्वरो मधुपर्कश्च हेमवर्णस्तथैव च।\nमालयो मातरिश्वा च निशाकरदिवाकरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039123, "chapter_id": 1856, "verse_number": "५-१०१-१५", "content_sanskrit": "एते प्रदेशमात्रेण मयोक्ता गरुडात्मजाः ।\nप्राधान्यतस्ते यशसा कीर्तिताः प्राणिनश्चये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039124, "chapter_id": 1856, "verse_number": "५-१०१-१६", "content_sanskrit": "यद्यत्र न रुचिः काचिदेहि गच्छाव मातले ।\nतं नयिष्यामि देशं त्वां वरं यत्रोपलप्स्यसे ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039125, "chapter_id": 1856, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि एकाधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]