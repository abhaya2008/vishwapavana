[{"id": 6000200000, "chapter_id": 10200, "verse_number": null, "content_sanskrit": "अथ चतुर्थाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000200001, "chapter_id": 10200, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.001.m4a", "display_order": 2}, {"id": 6000200002, "chapter_id": 10200, "verse_number": "१०-४-१", "content_sanskrit": "अथ सर्वगुणोपेतः कालः परमशोभनः।\nयर्ह्येवाजनजन्मर्क्षः शान्तर्क्षग्रहतारकः॥ १०/४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.002.m4a", "display_order": 3, "topics": [{"text": "शङ्खचक्राद्यायुधधारिचतुर्भुजरूपेण श्रीकृष्णजननम्", "range": "१–१३"}]}, {"id": 6000200003, "chapter_id": 10200, "verse_number": "१०-४-२", "content_sanskrit": "दिशः प्रसेदुर्गगनं निर्मलोडुगणोदयम्।\nमही मङ्गलभूयिष्ठपुरग्रामव्रजाकरा॥ १०/४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.003.m4a", "display_order": 4}, {"id": 6000200004, "chapter_id": 10200, "verse_number": "१०-४-३", "content_sanskrit": "नद्यः प्रसन्नसलिला ह्रदा जलरुहश्रियः।\nद्विजालिकुलसन्नादस्तबका वनराजयः॥ १०/४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.004.m4a", "display_order": 5}, {"id": 6000200005, "chapter_id": 10200, "verse_number": "१०-४-४", "content_sanskrit": "ववौ वायुः सुखस्पर्शः पुण्यगन्धवहः शुचिः।\nअग्नयश्च द्विजातीनां शान्तास्तत्र समिन्धत॥ १०/४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.005.m4a", "display_order": 6}, {"id": 6000200006, "chapter_id": 10200, "verse_number": "१०-४-५", "content_sanskrit": "मनांस्यासन् प्रसन्नानि साधूनामसुरद्रुहाम्।\nजायमानेऽजने तस्मिन् नेदुर्दुन्दुभयो दिवि॥ १०/४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.006.m4a", "display_order": 7}, {"id": 6000200007, "chapter_id": 10200, "verse_number": "१०-४-६", "content_sanskrit": "जगुः किन्नरगन्धर्वास्तुष्टुवुः सिद्धचारणाः।\nविद्याधराश्च ननृतुरप्सरोभिः समं मुदा॥ १०/४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.007.m4a", "display_order": 8}, {"id": 6000200008, "chapter_id": 10200, "verse_number": "१०-४-७", "content_sanskrit": "मुमुचुर्मुनयो देवाः सुमनांसि मुदान्विताः।\nमन्दं मन्दं जलधरा जगर्जुरनुसागरम्॥ १०/४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.008.m4a", "display_order": 9}, {"id": 6000200009, "chapter_id": 10200, "verse_number": "१०-४-८", "content_sanskrit": "निशीथे तम उद्भूते जायमाने जनार्दने।\nदेवक्यां देवरूपिण्यां विष्णुः सर्वगुहाशयः॥ १०/४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.009.m4a", "display_order": 10}, {"id": 6000200010, "chapter_id": 10200, "verse_number": "१०-४-९", "content_sanskrit": "प्रादुरासीद् यथा प्राच्यां दिशीन्दुरिव पुष्कलः॥ १०/४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.010.m4a", "display_order": 11}, {"id": 6000200011, "chapter_id": 10200, "verse_number": "१०-४-१०", "content_sanskrit": "तमद्भुतं बालकमम्बुजेक्षणं चतुर्भुजं शङ्खगदाद्युदायुधम्।\nश्रीवत्सलक्ष्मं गलशोभिकौस्तुभं पीताम्बरं सान्द्रपयोदसौभगम्॥ १०/४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.011.m4a", "display_order": 12}, {"id": 6000200012, "chapter_id": 10200, "verse_number": "१०-४-११", "content_sanskrit": "महार्हवैढूर्यकिरीटकुण्डलत्विषा परिष्वक्तसहस्रकुन्तलम्।\nउद्दामकाञ्च्यङ्गदकङ्कणादिभिर्विरोचमानं वसुदेव ऐक्षत॥ १०/४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.012.m4a", "display_order": 13}, {"id": 6000200013, "chapter_id": 10200, "verse_number": "१०-४-१२", "content_sanskrit": "स विस्मयोत्फुल्लविलोचनो हरिं सुतं विलोक्यानकदुन्दुभिस्तदा।\nकृष्णावतारोत्सवसम्भ्रमोऽस्पृशन्मुदा द्विजेभ्योऽयुतमाप्लुतो गवाम्॥ १०/४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.013.m4a", "display_order": 14}, {"id": 6000200014, "chapter_id": 10200, "verse_number": "१०-४-१३", "content_sanskrit": "अथैनमस्तौदवधार्य पूरुषं परं नताङ्गः कृतधीः कृताञ्जलिः।\nस्वरोचिषा भारत सूतिकागृहं विरोचयन्तं गतभीः प्रभाववित्॥ १०/४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.014.m4a", "display_order": 15}, {"id": 6000200015, "chapter_id": 10200, "verse_number": null, "content_sanskrit": "वसुदेव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.015.m4a", "display_order": 16}, {"id": 6000200016, "chapter_id": 10200, "verse_number": "१०-४-१४", "content_sanskrit": "विदितोऽसि भवान् साक्षात् पुरुषः प्रकृतेः परः।\nकेवलानुभवानन्दस्वरूपः सर्वबुद्धिदृक्॥ १०/४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.016.m4a", "display_order": 17, "topics": [{"text": "वसुदेवेन श्रीकृष्णस्तुतिः", "range": "१४–२४"}]}, {"id": 6000200017, "chapter_id": 10200, "verse_number": "१०-४-१५", "content_sanskrit": "स एव स्वप्रकृत्येदं सृष्ट्वाऽग्रे त्रिगुणात्मकम्।\nतदनु त्वं ह्यप्रविष्टः प्रविष्ट इव भाव्यसे॥ १०/४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.017.m4a", "display_order": 18}, {"id": 6000200018, "chapter_id": 10200, "verse_number": "१०-४-१६", "content_sanskrit": "य एतेऽविकृता भावाः सप्त ते विकृतैः सह।\nनानावीर्याः पृथग्भूता विराजं शयनं तव॥ १०/४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.018.m4a", "display_order": 19}, {"id": 6000200019, "chapter_id": 10200, "verse_number": "१०-४-१७", "content_sanskrit": "सन्निपत्य समुत्पाद्य दृश्यन्तेऽनुगता इव।\nप्रागेव विद्यमानत्वान्न तेषामिह सम्भवः॥ १०/४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.019.m4a", "display_order": 20}, {"id": 6000200020, "chapter_id": 10200, "verse_number": "१०-४-१८", "content_sanskrit": "एवं भवान् बुद्ध्यनुमेयलक्षणो ग्राह्यैर्गुणैः सन्नपि तद्गुणाग्रहः।\nअनावृतत्वाद् बहिरन्तरं न ते सर्वस्य सर्वात्मन आत्मवस्तुनः॥ १०/४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.020.m4a", "display_order": 21}, {"id": 6000200021, "chapter_id": 10200, "verse_number": "१०-४-१९", "content_sanskrit": "यदात्मनो दृश्यगुणेषु सन्निधेर्व्यवस्यसेऽस्वव्यतिरेकतोऽबुधैः।\nविनाऽनुवादं न च तन्मनीषितं सम्यग् वचो व्यक्तमुपाददत्पुमान्॥ १०/४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.021.m4a", "display_order": 22}, {"id": 6000200022, "chapter_id": 10200, "verse_number": "१०-४-२०", "content_sanskrit": "त्वत्तोऽस्य जन्मस्थितिसंयमान् विभो वदन्त्यनीहादगुणादविक्रियात्।\nत्वयीश्वरे ब्रह्मणि नो विरुद्ध्यते तदाश्रयत्वादुपचर्यसे गुणैः॥ १०/४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.022.m4a", "display_order": 23}, {"id": 6000200023, "chapter_id": 10200, "verse_number": "१०-४-२१", "content_sanskrit": "सत्त्वं त्रिलोकस्थितये स्वमायया बिभर्षि शुक्लं खलु वर्णमात्मनः।\nसर्गाय रक्तं रजसोपबृहितं कृष्णं च वर्णं तमसा जनात्यये॥ १०/४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.023.m4a", "display_order": 24}, {"id": 6000200024, "chapter_id": 10200, "verse_number": "१०-४-२२", "content_sanskrit": "त्वमस्य लोकस्य विभो रिरक्षिषुर्गृहेऽवतीर्णोऽसि ममाखिलेश्वर।\nराजन्यसंज्ञासुरकोटियूथपैर्निर्व्यूह्यमानां निहनिष्यसे चमूम्॥ १०/४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.024.m4a", "display_order": 25}, {"id": 6000200025, "chapter_id": 10200, "verse_number": "१०-४-२३", "content_sanskrit": "अयं तमस्यस्तव जन्म मे गृहे श्रुत्वाऽग्रजांस्ते न्यहनत् सुरेश्वर।\nस तेऽवतारं पुरुषैः समर्पितं श्रुत्वाऽधुनैवाभिसरत्युदायुधः॥ १०/४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.025.m4a", "display_order": 26}, {"id": 6000200026, "chapter_id": 10200, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.026.m4a", "display_order": 27}, {"id": 6000200027, "chapter_id": 10200, "verse_number": "१०-४-२४", "content_sanskrit": "अथैनमात्मजं वीक्ष्य महापुरुषलक्षणम्।\nदेवकी तमुपाधावत् कंसाद् भीता शुचिस्मिता॥ १०/४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.027.m4a", "display_order": 28}, {"id": 6000200028, "chapter_id": 10200, "verse_number": null, "content_sanskrit": "देवक्युवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.028.m4a", "display_order": 29}, {"id": 6000200029, "chapter_id": 10200, "verse_number": "१०-४-२५", "content_sanskrit": "रूपं यत् तत् प्राहुरव्यक्तमाद्यं ब्रह्म ज्योतिर्निर्गुणं निर्विकारम्।\nसत्तामात्रं निर्विशेषं निरीहं स त्वं साक्षाद् विष्णुरध्यात्मदीपम्॥ १०/४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.029.m4a", "display_order": 30, "topics": [{"text": "देवक्या श्रीकृृष्णस्तुतिः", "range": "२५–३२"}]}, {"id": 6000200030, "chapter_id": 10200, "verse_number": "१०-४-२६", "content_sanskrit": "नष्टे लोके द्विपरार्धावसाने महाभूतेष्वादिभूतं गतेषु।\nव्यक्तेऽव्यक्तं कालवेगेन याते भवानेकः शिष्यतेऽशेषसंज्ञः॥ १०/४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.030.m4a", "display_order": 31}, {"id": 6000200031, "chapter_id": 10200, "verse_number": "१०-४-२७", "content_sanskrit": "योऽयं कालस्तस्य तेऽव्यक्तबन्धो चेष्टामाहुश्चेष्टते येन विश्वम्।\nनिमेषादिर्वत्सरान्तो महीयांस्तं त्वेशानं क्षेमधाम प्रपद्ये॥ १०/४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.031.m4a", "display_order": 32}, {"id": 6000200032, "chapter_id": 10200, "verse_number": "१०-४-२८", "content_sanskrit": "मर्त्यो मृत्युव्यालभीतः पलायन् लोकान् सर्वान् निर्भयं नाध्यगच्छत्।\nत्वत्पादाब्जं प्राप्य यदृच्छयाऽऽद्य स्वस्थः शेते मृत्युरस्मादपैति॥ १०/४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.032.m4a", "display_order": 33}, {"id": 6000200033, "chapter_id": 10200, "verse_number": "१०-४-२९", "content_sanskrit": "स त्वं घोरादुग्रसेनात्मजान्नस्‍त्राहि त्रस्तान् भृत्यवित्रासहाऽसि।\nरूपं चेदं पौरुषं ध्यानधिष्ण्यमप्रत्यक्षं मादृशां त्वं कृषीष्ठाः॥ १०/४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.033.m4a", "display_order": 34}, {"id": 6000200034, "chapter_id": 10200, "verse_number": "१०-४-३०", "content_sanskrit": "जन्म ते मय्यसौ पापो मा विद्यान्मधुसूदन।\nसमुद्विजे भवद्धेतोः कंसादहमधीरधीः॥ १०/४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.034.m4a", "display_order": 35}, {"id": 6000200035, "chapter_id": 10200, "verse_number": "१०-४-३१", "content_sanskrit": "उपसंहर विश्वात्मन्नदो रूपमलौकिकम्।\nशङ्खचक्रगदापद्मश्रिया जुष्टं चतुर्भुजम्॥ १०/४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.035.m4a", "display_order": 36}, {"id": 6000200036, "chapter_id": 10200, "verse_number": "१०-४-३२", "content_sanskrit": "विश्वं यदेतत् स्वतनौ निशान्ते यथावकाशं पुरुषः परो भवान्।\nबिभर्ति सोऽयं मम गर्भगोऽभूदहो नृलोकस्य विडम्बनं महत्॥ १०/४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.036.m4a", "display_order": 37}, {"id": 6000200037, "chapter_id": 10200, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.037.m4a", "display_order": 38}, {"id": 6000200038, "chapter_id": 10200, "verse_number": "१०-४-३३", "content_sanskrit": "त्वमेव पूर्वसर्गेऽभूः पृश्निः स्वायम्भुवे सति।\nतदाऽयं सुतपा नाम प्रजापतिरकल्मषः॥ १०/४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.038.m4a", "display_order": 39, "topics": [{"text": "वसुदेवेन श्रीकृष्णस्य गोकुलनयनम्, ततो यशोदासुताया दुर्गाया आनयनं च", "range": "३३–५२"}]}, {"id": 6000200039, "chapter_id": 10200, "verse_number": "१०-४-३४", "content_sanskrit": "युवां वै ब्रह्मणाऽऽदिष्टौ प्रजासर्गे यदा ततः।\nसन्नियम्येन्द्रियग्रामं तेपाथे परमं तपः॥ १०/४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.039.m4a", "display_order": 40}, {"id": 6000200040, "chapter_id": 10200, "verse_number": "१०-४-३५", "content_sanskrit": "वर्षवातातपहिमघर्मकालगुणाननु।\nसहमानौ श्वासरोधविनिर्धूतमनोमलौ॥ १०/४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.040.m4a", "display_order": 41}, {"id": 6000200041, "chapter_id": 10200, "verse_number": "१०-४-३६", "content_sanskrit": "शीर्णपर्णानिलाहारावुपशान्तेन चेतसा।\nमत्तः कामानभीप्सन्तौ मदाराधनमीहतुः॥ १०/४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.041.m4a", "display_order": 42}, {"id": 6000200042, "chapter_id": 10200, "verse_number": "१०-४-३७", "content_sanskrit": "एवं वां तप्यतोर्भद्रे तपः परमदुष्करम्।\nदिव्यवर्षसहस्राणि द्वादशेयुर्मदात्मनोः॥ १०/४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.042.m4a", "display_order": 43}, {"id": 6000200043, "chapter_id": 10200, "verse_number": "१०-४-३८", "content_sanskrit": "तदा वां परितुष्टोऽहममुना वपुषाऽनघे।\nतपसा श्रद्धया नित्यं भक्त्या च हृदि भावितः॥ १०/४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.043.m4a", "display_order": 44}, {"id": 6000200044, "chapter_id": 10200, "verse_number": "१०-४-३९", "content_sanskrit": "प्रादुरासं वरदराड् युवयोः कामदित्सया।\nव्रियतां वर इत्युक्ते मादृशो वां वृतः सुतः॥ १०/४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.044.m4a", "display_order": 45}, {"id": 6000200045, "chapter_id": 10200, "verse_number": "१०-४-४०", "content_sanskrit": "अजुष्टग्राम्यविषयावनपत्यौ च दम्पती।\nन वव्राथेऽपवर्गं मे मोहितौ मम मायया॥ १०/४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.045.m4a", "display_order": 46}, {"id": 6000200046, "chapter_id": 10200, "verse_number": "१०-४-४१", "content_sanskrit": "गते मयि युवां लब्ध्वा वरं मत्सदृशं सुतम्।\nग्राम्यान् भोगानभुञ्जाथां युवां प्राप्तमनोरथौ॥ १०/४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.046.m4a", "display_order": 47}, {"id": 6000200047, "chapter_id": 10200, "verse_number": "१०-४-४२", "content_sanskrit": "अदृष्ट्वाऽन्यतमं लोके शीलौदार्यगुणैः समम्।\nअहं सुतो वामभवं पृश्निगर्भ इति स्मृतः॥ १०/४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.047.m4a", "display_order": 48}, {"id": 6000200048, "chapter_id": 10200, "verse_number": "१०-४-४३", "content_sanskrit": "तयोर्वां पुनरेवाहमदित्यामास कश्यपात्।\nउपेन्द्र इति विख्यातो वामनत्वाच्च वामनः॥ १०/४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.048.m4a", "display_order": 49}, {"id": 6000200049, "chapter_id": 10200, "verse_number": "१०-४-४४", "content_sanskrit": "तृतीयेऽस्मिन् भवेऽहं वै तेनैव वपुषाऽनघे।\nजातो भूयस्तयोरेवं सत्यं मे व्याहृतं सति॥ १०/४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.049.m4a", "display_order": 50}, {"id": 6000200050, "chapter_id": 10200, "verse_number": "१०-४-४५", "content_sanskrit": "एतद् वां दर्शितं रूपं प्राग्जन्मस्मरणाय मे।\nनान्यथा मद्भवज्ञानं मर्त्यलिङ्गेन जन्यते॥ १०/४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.050.m4a", "display_order": 51}, {"id": 6000200051, "chapter_id": 10200, "verse_number": "१०-४-४६", "content_sanskrit": "युवां मां पुत्रभावेन ब्रह्मभावेन चासकृत्।\nचिन्तयन्तौ कृतस्नेहौ यास्येथे मद्गतिं पराम्॥ १०/४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.051.m4a", "display_order": 52}, {"id": 6000200052, "chapter_id": 10200, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.052.m4a", "display_order": 53}, {"id": 6000200053, "chapter_id": 10200, "verse_number": "१०-४-४७", "content_sanskrit": "इत्युक्त्वाऽऽसीद् हरिस्तूष्णीं भगवानात्ममायया।\nपित्रोः सम्पश्यतोः सद्यो बभूव प्राकृतः शिशुः॥ १०/४/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.053.m4a", "display_order": 54}, {"id": 6000200054, "chapter_id": 10200, "verse_number": "१०-४-४८", "content_sanskrit": "ततश्च शौरिर्भगवत्प्रचोदितः सुतं समादाय स सूतिकागृहात्।\nयदा बहिर्गन्तुमियेष तर्ह्यजा या योगमायाऽजनि नन्दजायया॥ १०/४/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.054.m4a", "display_order": 55}, {"id": 6000200055, "chapter_id": 10200, "verse_number": "१०-४-४९", "content_sanskrit": "तया हृतप्रत्ययसर्ववृत्तिषु द्वाःस्थेषु पौरेषु च यापितेष्वथ।\nद्वारस्तु सर्वाः पिहिता दुरत्ययाः बृहत्कपाटायसकीलशृङ्खलैः॥ १०/४/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.055.m4a", "display_order": 56}, {"id": 6000200056, "chapter_id": 10200, "verse_number": "१०-४-५०", "content_sanskrit": "ताः कृष्णवाहे वसुदेव आगते स्वयं व्यशीर्यन्त यथा तमो रवेः।\nववर्ष पर्जन्य उपांशुगर्जितः शेषोऽन्वगाद् वारि निवारयन् फणैः॥ १०/४/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.056.m4a", "display_order": 57}, {"id": 6000200057, "chapter_id": 10200, "verse_number": "१०-४-५१", "content_sanskrit": "मघोनि वर्षत्यसकृद् यमानुजा गम्भीरतोयौघजवोर्मिफेनिला।\nभयानकावर्तशताकुला नदी मार्गं ददौ सिन्धुरिव श्रियः पतेः॥ १०/४/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.057.m4a", "display_order": 58}, {"id": 6000200058, "chapter_id": 10200, "verse_number": "१०-४-५२", "content_sanskrit": "नन्दव्रजं शौरिरुपेत्य तत्र तान् गोपान् सुषुप्तानुपलभ्य निद्रया।\nशिशुं यशोदाशयने निधाय तत्सुतामुपादाय पुनर्गृहानगात्॥ १०/४/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.058.m4a", "display_order": 59}, {"id": 6000200059, "chapter_id": 10200, "verse_number": "१०-४-५३", "content_sanskrit": "देवक्याः शयने न्यस्य वसुदेवोऽथ दारिकाम्।\nप्रतिमुच्य पदोर्लोहमास्ते पूर्ववदावृतः॥ १०/४/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.059.m4a", "display_order": 60}, {"id": 6000200060, "chapter_id": 10200, "verse_number": "१०-४-५४", "content_sanskrit": "यशोदा नन्दपत्नी च जातं परमबुध्यत।\nन तल्लिङ्गं परिश्रान्ता निद्रयाऽपगतस्मृतिः॥ १०/४/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_004/BhP_10.004.060.m4a", "display_order": 61}, {"id": 6000200061, "chapter_id": 10200, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे चतुर्थाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]