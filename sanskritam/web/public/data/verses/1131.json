[{"id": 2006589, "chapter_id": 1131, "verse_number": "१-१३२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006590, "chapter_id": 1131, "verse_number": "१-१३२-१", "content_sanskrit": "जाते बलवतां श्रेष्ठे पाण्डुश्चिन्तापरोऽभवत्।\nकथमन्यो मम सुतो लोके श्रेष्ठो भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006591, "chapter_id": 1131, "verse_number": "१-१३२-२", "content_sanskrit": "दैवे पुरुषकारे च लोकोऽयं संप्रतिष्ठितः।\nतत्र दैवं तु विधिना कालयुक्तेन लभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006592, "chapter_id": 1131, "verse_number": "१-१३२-३", "content_sanskrit": "इन्द्रो हि राजा देवानां प्रधान इति नः श्रुतम्।\nअप्रमेयबलोत्साहो वीर्यवानमितद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006593, "chapter_id": 1131, "verse_number": "१-१३२-४", "content_sanskrit": "तं तोषयित्वा तपसा पुत्रं लप्स्ये महाबलम्।\nयं दास्यति स मे पुत्रं स वीरयान्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006594, "chapter_id": 1131, "verse_number": "१-१३२-५", "content_sanskrit": "अमानुषान्मानुषांश्च संग्रामे स हनिष्यति।\nकर्मणा मनसा वाचा तस्मात्तप्स्ये महत्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006595, "chapter_id": 1131, "verse_number": "१-१३२-६", "content_sanskrit": "ततः पाण्डुर्महाराजो मन्त्रयित्वा महर्षिभिः।\nदिदेश कुन्त्याः कौरव्यो व्रतं सांवत्सरं शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006596, "chapter_id": 1131, "verse_number": "१-१३२-७", "content_sanskrit": "आत्मना च महाबाहुरेकपादस्थितोऽभवत्।\nउग्रं स तप आस्थाय परमेण समाधिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006597, "chapter_id": 1131, "verse_number": "१-१३२-८", "content_sanskrit": "आरिराधयिषुर्देवं त्रिदशानां तमीश्वरम्।\nसूर्येण सह धर्मात्मा पर्यतप्यत भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006598, "chapter_id": 1131, "verse_number": "१-१३२-९", "content_sanskrit": "तं तु कालेन महता वासवः प्रत्यपद्यत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006599, "chapter_id": 1131, "verse_number": "१-१३२-९x", "content_sanskrit": "शक्र उवाच।\nपुत्रं तव प्रदास्यामि त्रिषु लोकेषु विश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006600, "chapter_id": 1131, "verse_number": "१-१३२-१०", "content_sanskrit": "ब्राह्मणानां गवां चैव सुहृदां चार्थसाधकम्।\nदुर्हृदां शोकजननं सर्वबान्धवनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006601, "chapter_id": 1131, "verse_number": "१-१३२-११", "content_sanskrit": "सुतं तेऽग्र्यं प्रदास्यामि सर्वामित्रविनाशनम्।\nइत्युक्तः कारैवो राजा वासवेन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006602, "chapter_id": 1131, "verse_number": "१-१३२-१२", "content_sanskrit": "उवाच कुन्तीं धर्मात्मा देवराजवचः स्मरन्।\nउदर्कस्तव कल्याणि तुष्टो देवगणेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006603, "chapter_id": 1131, "verse_number": "१-१३२-१३", "content_sanskrit": "दातुमिच्छति ते पुत्रं यथा संकल्पितं त्वया।\nअतिमानुषकर्माणं यशस्विनमरिन्दमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006604, "chapter_id": 1131, "verse_number": "१-१३२-१४", "content_sanskrit": "नीतिमन्तं महात्मानमादित्यसमतेजसम्।\nदुराधर्षं क्रियावन्तमतीवाद्भुतदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006605, "chapter_id": 1131, "verse_number": "१-१३२-१५", "content_sanskrit": "पुत्रं जनय सुश्रोणि धाम क्षत्रियतेजसाम्।\nलब्धः प्रसादो देवेन्द्रात्तमाह्वय शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006606, "chapter_id": 1131, "verse_number": "१-१३२-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006607, "chapter_id": 1131, "verse_number": "१-१३२-१६", "content_sanskrit": "एवमुक्ता ततः शक्रमाजुहाव यशस्विनी।\nअथाजगाम देवेन्द्रो जनयामास चार्जुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006608, "chapter_id": 1131, "verse_number": "१-१३२-१७", "content_sanskrit": "उत्तराभ्यां तु पूर्वाभ्यां फल्गुनीभ्यां ततो दिवा।\nजातस्तु फाल्गुने मासि तेनासौ फल्गुनःस्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006609, "chapter_id": 1131, "verse_number": "१-१३२-१८", "content_sanskrit": "जातमात्रे कुमारे तु सर्वभूतप्रहर्षिणी।\nसूतके वर्तमानां तां वागुवाचाशरीरिणी।\nमहागम्भीरनिर्घोषा नभो नादयती तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006610, "chapter_id": 1131, "verse_number": "१-१३२-१९", "content_sanskrit": "शृण्वतां सर्वभूतानां तेषां चाश्रमवासिनाम्।\nकुन्तीमाभाष्य विस्पष्टमुवाचेदं शुचिस्मिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2006611, "chapter_id": 1131, "verse_number": "१-१३२-२०", "content_sanskrit": "कार्तवीर्यसमः कुन्ति शिवतुल्यपराक्रमः।\nएष शक्र इवाजय्यो यशस्ते प्रथयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2006612, "chapter_id": 1131, "verse_number": "१-१३२-२१", "content_sanskrit": "अदित्या विष्णुना प्रीतिर्यथाऽभूदभिवर्धिता।\nतथा विष्णुसमः प्रीतिं वर्धयिष्यति तेऽर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2006613, "chapter_id": 1131, "verse_number": "१-१३२-२२", "content_sanskrit": "एष मद्रान्वशे कृत्वा कुरूंश्च सह सोमकैः।\nचेदिकाशिकरूषांश्च कुरुलक्ष्मीं वहिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2006614, "chapter_id": 1131, "verse_number": "१-१३२-२३", "content_sanskrit": "एतस्य भुजवीर्येण खाण्डवे हव्यवाहनः।\nमेदसा सर्वभूतानां तृप्तिं यास्यति वै पराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2006615, "chapter_id": 1131, "verse_number": "१-१३२-२४", "content_sanskrit": "ग्रामणीश्च महीपालानेष जित्वा महाबलः।\nभ्रातृभिः सहितो वीरस्त्रीन्मेधानाहरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2006616, "chapter_id": 1131, "verse_number": "१-१३२-२५", "content_sanskrit": "जामदग्न्यसमः कुन्ति विष्णुतुल्यपराक्रमः।\nएष वीर्यवतां श्रेष्ठो भविष्यति महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2006617, "chapter_id": 1131, "verse_number": "१-१३२-२६", "content_sanskrit": "एष युद्धे महादेवं तोषयिष्यति शङ्करम्।\nअस्त्रं पाशुपतं नाम तस्मात्तुष्टादवाप्स्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2006618, "chapter_id": 1131, "verse_number": "१-१३२-२७", "content_sanskrit": "निवातकवचा नाम दैत्या विबुधविद्विषः।\nशक्राज्ञया महाबाहुस्तान्वधिष्यति ते सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2006619, "chapter_id": 1131, "verse_number": "१-१३२-२८", "content_sanskrit": "तथा दिव्यानि चास्त्राणि निखिलेनाहरिष्यति।\nविप्रनष्टां श्रियं चायमाहर्ता पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2006620, "chapter_id": 1131, "verse_number": "१-१३२-२९", "content_sanskrit": "एतामत्यद्भुतां वाचं कुन्ती शुश्राव सूतके।\nवाचमुच्चरितामुच्चैस्तां निशम्य तपस्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2006621, "chapter_id": 1131, "verse_number": "१-१३२-३०", "content_sanskrit": "बभूव पमो हर्षः शतशृङ्गनिवासिनाम्।\nतथा देवमहर्षीणां सेन्द्राणां च दिवौकसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2006622, "chapter_id": 1131, "verse_number": "१-१३२-३१", "content_sanskrit": "आकाशे दुन्दुभीनां च बभूव तुमुलः स्वनः।\nउदतिष्ठन्महाघोरः पुष्पवृष्टिभिरावृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2006623, "chapter_id": 1131, "verse_number": "१-१३२-३२", "content_sanskrit": "समवेत्य च देवानां गणाः पार्थमपूजयन्।\nकाद्रवेया वैनतेया गन्धर्वाप्सरसस्तथा।\nप्रजानां पतयः सर्वे सप्त चैव महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2006624, "chapter_id": 1131, "verse_number": "१-१३२-३३", "content_sanskrit": "भरद्वाजः खस्यपो गौतमश्च\nविश्वामित्रो जमदग्निर्वसिष्ठः।\nयश्चोदितो भास्करेऽभूत्प्रनष्टे\nसोऽप्यत्रात्रिर्भगवानाजगाम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2006625, "chapter_id": 1131, "verse_number": "१-१३२-३४", "content_sanskrit": "मरीचिरङ्गिराश्चैव पुलस्त्यः पुलहः क्रतुः।\nदक्षः प्रजापतिश्चैव गन्धर्वाप्सरसस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2006626, "chapter_id": 1131, "verse_number": "१-१३२-३५", "content_sanskrit": "दिव्यमाल्याम्बरधराः सर्वालङ्कारभूषिताः।\nउपगायन्ति बीभत्सुं नृत्यन्तेऽप्सरसां गणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2006627, "chapter_id": 1131, "verse_number": "१-१३२-३६", "content_sanskrit": "तथा महर्षयश्चापि जेपुस्तत्र समन्ततः।\nगन्धर्वैः सहितः श्रीमान्प्रागायत च तुम्बुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2006628, "chapter_id": 1131, "verse_number": "१-१३२-३७", "content_sanskrit": "भीमसेनोग्रसेनौ च ऊर्णायुरनघस्तथा।\nगोपतिर्धृतराष्ट्रश्च सूर्यवर्चास्तथाष्टमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2006629, "chapter_id": 1131, "verse_number": "१-१३२-३८", "content_sanskrit": "युगपस्तृणपः कार्ष्णिर्नन्दिश्चित्ररथस्तथा।\nत्रयोदशः शालिशिराः पर्जन्यश्च चतुर्दशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2006630, "chapter_id": 1131, "verse_number": "१-१३२-३९", "content_sanskrit": "कलिः पञ्चदशश्चैव नारदश्चात्र षोडशः।\nऋत्वा बृहत्त्वा बृहकः करालश्च महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2006631, "chapter_id": 1131, "verse_number": "१-१३२-४०", "content_sanskrit": "ब्रह्मचारी बहुगुणः सुवर्णश्चेति विश्रुतः।\nविश्वावसुर्भुमन्युश्च सुचन्द्रश्च शरुस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2006632, "chapter_id": 1131, "verse_number": "१-१३२-४१", "content_sanskrit": "गीतमाधुर्यसंपन्नौ विख्यातौ च हहाहुहू।\nइत्येते देवगन्धर्वा जग्मुस्तत्र नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2006633, "chapter_id": 1131, "verse_number": "१-१३२-४२", "content_sanskrit": "तथैवाप्सरसो हृष्टाः सर्वालङ्कारभूषिताः।\nननृतुर्वै महाभागा जगुश्चायतलोचनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2006634, "chapter_id": 1131, "verse_number": "१-१३२-४३", "content_sanskrit": "अनूचानाऽनवद्या च गुणमुख्या गुणावरा।\nअद्रिका च तथा सोमा मिश्रकेशी त्वलम्बुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2006635, "chapter_id": 1131, "verse_number": "१-१३२-४४", "content_sanskrit": "मरीचिः शुचिका चैव विद्युत्पर्णा तिलोत्तमा।\nअम्बिका लक्षणा क्षेमा देवी रम्भा मनोरमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2006636, "chapter_id": 1131, "verse_number": "१-१३२-४५", "content_sanskrit": "असिता च सुबाहुश्च सुप्रिया च वपुस्तथा।\nपुण्डरीका सुगन्धा च सुरसा च प्रमाथिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2006637, "chapter_id": 1131, "verse_number": "१-१३२-४६", "content_sanskrit": "काम्या शारद्वती चैव ननृतुस्तत्र संघशः।\nमेनका सहजन्या च कर्णिका पुञ्जिकस्थला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2006638, "chapter_id": 1131, "verse_number": "१-१३२-४७", "content_sanskrit": "ऋतुस्थला घृताची च विश्वाची पूर्वचित्त्यपि।\nउम्लोचेति च विख्याता प्रम्लोचेति च ता दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2006639, "chapter_id": 1131, "verse_number": "१-१३२-४८", "content_sanskrit": "उर्वश्येकादशी तासां जगुश्चायतलोचनाः।\nधाताऽर्यमा च मित्रश्च वरुणोंऽशो भगस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2006640, "chapter_id": 1131, "verse_number": "१-१३२-४९", "content_sanskrit": "इन्द्रो विवस्वान्पूषा च पर्जन्यो दशमः स्मृतः।\nततस्त्वष्टा ततो विष्णुरजघन्यो जघन्यजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2006641, "chapter_id": 1131, "verse_number": "१-१३२-५०", "content_sanskrit": "इत्येते द्वादशादित्या ज्वलन्तः सूर्यवर्चसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2006642, "chapter_id": 1131, "verse_number": "१-१३२-५१", "content_sanskrit": "मृगव्याधश्च सर्पश्च निर्ऋतिश्च महायशाः।\nअजैकपादहिर्बुध्न्यः पिनाकी च परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2006643, "chapter_id": 1131, "verse_number": "१-१३२-५२", "content_sanskrit": "दहनोऽथेश्वरश्चैव कपाली च विशांपते।\nस्थाणुर्भगश्च भगवान्रुद्रास्तत्रावतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2006644, "chapter_id": 1131, "verse_number": "१-१३२-५३", "content_sanskrit": "अश्विनौ वसवश्चाष्टौ मरुतश्च महाबलाः।\nविश्वेदेवास्तथा साध्यास्तत्रासन्परितः स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2006645, "chapter_id": 1131, "verse_number": "१-१३२-५४", "content_sanskrit": "कर्कोटकोऽथ सर्पश्च वासुकिश्च भुजङ्गमः।\nकच्छपश्चाथ कुण्डश्च तक्षकश्च महोरगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2006646, "chapter_id": 1131, "verse_number": "१-१३२-५५", "content_sanskrit": "आययुस्तपसा युक्ता महाक्रोधा महाबलाः।\nएते चान्ये च बहवस्तत्र नागा व्यवस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2006647, "chapter_id": 1131, "verse_number": "१-१३२-५६", "content_sanskrit": "तार्क्ष्यश्चारिष्टनेमिश्च गरुडश्चासितध्वजः।\nअरुणश्चारुणिश्चैव वैनतेया व्यवस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2006648, "chapter_id": 1131, "verse_number": "१-१३२-५७", "content_sanskrit": "तांश्च देवगणान्सर्वांस्तपःसिद्धा महर्षयः।\nविमानगिर्यग्रगतान्ददृशुर्नेतरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2006649, "chapter_id": 1131, "verse_number": "१-१३२-५८", "content_sanskrit": "तद्दृष्ट्वा महदाश्चर्यं विस्मिता मुनिसत्तमाः।\nअधिकां स्म ततो वृत्तिमवर्तन्पाण्डवं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2006650, "chapter_id": 1131, "verse_number": "१-१३२-५९", "content_sanskrit": "पाण्डुः प्रीतेन मनसा देवतादीनपूजयत्।\nपाण्डुना पूजिता देवाः प्रत्यूचुर्नरसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2006651, "chapter_id": 1131, "verse_number": "१-१३२-६०", "content_sanskrit": "प्रादुर्बूतो ह्ययं धर्मो देवतानां प्रसादतः।\nमातरिश्वा ह्ययं भीमो बलवानरिमर्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2006652, "chapter_id": 1131, "verse_number": "१-१३२-६१", "content_sanskrit": "साक्षादिन्द्रः स्वयं जातः प्रसादाच्च शतक्रतोः।\nपितृत्वाद्देवतानां हि नास्ति पुण्यतरस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2006653, "chapter_id": 1131, "verse_number": "१-१३२-६२", "content_sanskrit": "पितॄणामृणनिर्मुक्तः स्वर्गं प्राप्स्यसि पुण्यभाक्।\nइत्युक्त्वा देवताः सर्वा विप्रजग्मुर्यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2006654, "chapter_id": 1131, "verse_number": "१-१३२-६३", "content_sanskrit": "पाण्डुस्तु पुनरेवैनां पुत्रलोभान्महायशाः।\nप्रादिशद्दर्शनीयार्थी कुन्ती त्वेनमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2006655, "chapter_id": 1131, "verse_number": "१-१३२-६४", "content_sanskrit": "नातश्चतुर्थं प्रसवमापस्त्वपि वदन्त्युत।\nअतःपरं स्वैरिणी स्याद्बन्धकी पञ्चमे भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2006656, "chapter_id": 1131, "verse_number": "१-१३२-६५", "content_sanskrit": "स त्वं विद्वन्धर्ममिममधिगम्य कथं नु माम्।\nअपत्यार्थं समुत्क्रम्य प्रमादादिव भाषसे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2006657, "chapter_id": 1131, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि द्वात्रिंशदधिकशततमोऽध्यायः॥ १३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]