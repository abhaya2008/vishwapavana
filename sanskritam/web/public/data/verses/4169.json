[{"id": 2146855, "chapter_id": 4169, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146856, "chapter_id": 4169, "verse_number": "१", "content_sanskrit": "अयं लोकः सुपर्णानां पक्षिणां पन्नगाशिनाम् ।\nविक्रमे गमने भारे नैषामस्ति परिश्रमः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146857, "chapter_id": 4169, "verse_number": "२", "content_sanskrit": "वैनतेयसुतैः सूत षड्भिस्ततमिदं कुलम्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146858, "chapter_id": 4169, "verse_number": "३", "content_sanskrit": "सुमुखेन सुदाम्ना च सुनेत्रेण सुवर्चसा ।\nसुरुचा पक्षिराजेन सुबलेन च मातले\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146859, "chapter_id": 4169, "verse_number": "४", "content_sanskrit": "वर्धितानि प्रसूत्या वै विनताकुलकर्तृभिः ।\nपक्षिराजाभिजात्यानां सहस्राणि शतानि च\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146860, "chapter_id": 4169, "verse_number": "५", "content_sanskrit": "कश्यपस्य ततो वंशे जातैर्भूतिविवर्धनैः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146861, "chapter_id": 4169, "verse_number": "६", "content_sanskrit": "सर्वे ह्येते श्रिया युक्ताः सर्वे श्रीवत्सलक्षणाः ।\nसर्वे श्रियमभीप्सन्तो धारयन्ति बलान्युत\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146862, "chapter_id": 4169, "verse_number": "७", "content_sanskrit": "कर्मणा क्षत्रिया ह्येते निर्घृणा भोगिभोजिनः ।\nज्ञातिसङ्क्षयकर्तृत्वात् ब्राह्मण्यं न भजन्ति वै\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146863, "chapter_id": 4169, "verse_number": "८", "content_sanskrit": "नामानि चैषां वक्ष्यामि यथा प्राधान्यतः शृणु ।\nमातले श्लाघ्यमेतद्धि कुलं विष्णुपरिग्रहम्\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146864, "chapter_id": 4169, "verse_number": "९", "content_sanskrit": "दैवतं विष्णुरेतेषां विष्णुरेव परायणम् ।\nहृदि चैषां सदा विष्णुः विष्णुरेव गतिस्तथा\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146865, "chapter_id": 4169, "verse_number": "१०", "content_sanskrit": "सुवर्णचूडो नागाशी दारुणश्चण्डतुण्डकः ।\nअनिलश्चानलश्चैव विशालाक्षोऽथ कुण्डली\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146866, "chapter_id": 4169, "verse_number": "११", "content_sanskrit": "काश्यपिर्ध्वजविष्कम्भो वैनतेयोऽथ वामनः ।\nवातवेगो निशाचक्षुः निमेषोऽनिमिषस्तथा\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146867, "chapter_id": 4169, "verse_number": "१२", "content_sanskrit": "त्रिवारः सप्तवारश्च वाल्मीकिर्द्वीपकस्तथा ।\nदैत्यद्वीपस्तपोद्वीपः सारसः पद्मलोचनः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146868, "chapter_id": 4169, "verse_number": "१३", "content_sanskrit": "सुमुखश्चित्रकेतुश्च चित्रबर्हस्तथाऽनघः ।\nमेघहृत् कुमुदो दक्षः सर्पान्तः सोमभोजनः\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146869, "chapter_id": 4169, "verse_number": "१४", "content_sanskrit": "गुरुभारः कपोतश्च सूर्यनेत्रश्चिरान्तकः ।\nविष्णुधन्वा कुमारश्च परिबर्हो हरिस्तथा\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146870, "chapter_id": 4169, "verse_number": "१५", "content_sanskrit": "सुस्वरो मधुपर्कश्च हेमवर्णस्तथैव च ।\nमलयो मातरिश्वा च दिवाकरनिशाकरौ\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146871, "chapter_id": 4169, "verse_number": "१६", "content_sanskrit": "एते प्रादेशमात्रेण मयोक्ता गरुडात्मजाः ।\nप्राधान्यतस्ते यशसा कीर्तिताः पक्षिणश्च ये\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146872, "chapter_id": 4169, "verse_number": "१७", "content_sanskrit": "यद्यत्र न रुचिः काचिद् एहि गच्छाव मातले ।\nतं नयिष्यामि देशं त्वां वरं यत्रोपलप्स्यसे\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146873, "chapter_id": 4169, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि शततमोऽध्यायः ॥१००॥\nभगवद्यानपर्वणि एकत्रिंशोऽध्यायः ॥३१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]