[{"id": 2136993, "chapter_id": 3970, "verse_number": "१", "content_sanskrit": "अथ भार्यासहायः स फलान्यादाय वीर्यवान् ।\nकठिनं पूरयामास ततः काष्ठान्यपाटयत् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136994, "chapter_id": 3970, "verse_number": "२", "content_sanskrit": "तस्य पाटयतः काष्ठं स्वेदो वै समजायत ।\nव्यायामेन च तेनास्य जज्ञे शिरसि वेदना ।\nसोऽभिगम्य प्रियां भार्यामुवाच श्रमपीडितः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136995, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सत्यवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136996, "chapter_id": 3970, "verse_number": "३", "content_sanskrit": "व्यायामेन च मानेन जाता शिरसि वेदना \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136997, "chapter_id": 3970, "verse_number": "४", "content_sanskrit": "अङ्गानि चैव सावित्रि हृदयं दूयतीव च ।\nअस्वस्थमिव चात्मानं लक्षये मितभाषिणि \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136998, "chapter_id": 3970, "verse_number": "५", "content_sanskrit": "शूलैरिव शिरो विद्धमिदं संलक्षयाम्यहम् ।\nतत्स्वप्तुमिच्छे कल्याणि न स्थातुं शक्तिरस्ति मे \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136999, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "भ्रमन्तीव दिशः सर्वाश्चक्रारूढं मनो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2137000, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2137001, "chapter_id": 3970, "verse_number": "६", "content_sanskrit": "सा समासाद्य सावित्री भर्तारमुपगम्य च ।\nउत्सङ्गेऽस्य शिरः कृत्वा निषसाद महीतले \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2137002, "chapter_id": 3970, "verse_number": "७", "content_sanskrit": "ततः सा नारदवचो विमृशन्ती तपस्विनी ।\nतं मुहूर्तं क्षणं वेलां दिवसं च युयोज ह \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2137003, "chapter_id": 3970, "verse_number": "८", "content_sanskrit": "हन्त प्राप्तः स कालोऽयमिति चिन्तापरा सती ।\nमुहूर्तादेव चापश्यत् पुरुषं रक्तवाससम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2137004, "chapter_id": 3970, "verse_number": "९", "content_sanskrit": "बद्धमौलिं वपुष्मन्तमादित्यसमतेजसम् ।\nश्यामावदातं रक्ताक्षं पाशहस्तं भयावहम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2137005, "chapter_id": 3970, "verse_number": "१०", "content_sanskrit": "स्थितं सत्यवतः पार्श्वं निरीक्षन्तं तमेव च ।\nतं दृष्ट्वा सहसोत्थाय भर्तुर्न्यस्य शनैः शिरः ।\nकृताञ्जलिरुवाचार्ता हृदयेन प्रवेपती \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2137006, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2137007, "chapter_id": 3970, "verse_number": "११", "content_sanskrit": "दैवतं त्वाभिजानामि वपुरेतद्ध्यमानुषम् ।\nकामया ब्रूहि देवेश कस्त्वं किं च चिकीर्षसि \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2137008, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2137009, "chapter_id": 3970, "verse_number": "१२", "content_sanskrit": "पतिव्रतासि सावित्रि तथैव च तपोऽन्विता ।\nअतस्त्वामभिभाषामि विद्धि मां त्वं शुभे यमम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2137010, "chapter_id": 3970, "verse_number": "१३", "content_sanskrit": "अयं ते सत्यवान् भर्ता क्षीणायुः पार्थिवात्मजः ।\nनेष्यामि तमहं बद्ध्वा विद्ध्येतन्मे चिकीर्षितम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2137011, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2137012, "chapter_id": 3970, "verse_number": "१४", "content_sanskrit": "श्रूयते भगवन् दूतास्तवागच्छन्ति मानवान् ।\nनेतुं किल भवान् कस्मादागतोऽसि स्वयं प्रभो \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2137013, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2137014, "chapter_id": 3970, "verse_number": "१५", "content_sanskrit": "इत्युक्तः पितृराजस्तां भगवान् स्वचिकीर्षितम् ।\nयथावत् सर्वमाख्यातुं तत् प्रियार्थं प्रचक्रमे \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2137015, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2137016, "chapter_id": 3970, "verse_number": "१६", "content_sanskrit": "अयं च धर्मसंयुक्तो रूपवान् गुणसागरः ।\nनार्हो मत्पुरुषैर्नेतुमतोऽस्मि स्वयमागतः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2137017, "chapter_id": 3970, "verse_number": "१७", "content_sanskrit": "ततः सत्यवतः कायात् पाशबद्धं वशंगतम् ।\nअङ्गुष्ठमात्रं पुरुषं निश्चक्राम यमो बलात् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2137018, "chapter_id": 3970, "verse_number": "१८", "content_sanskrit": "ततः समुद्धृतप्राणं गतश्वासं हतप्रभम् ।\nनिर्विचेष्टं शरीरं तद्बभूवाप्रियदर्शनम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2137019, "chapter_id": 3970, "verse_number": "१९", "content_sanskrit": "यमस्तु तं ततो बद्ध्वा प्रयातो दक्षिणामुखः ।\nसावित्री चैव दुःखार्ता यममेवान्वगच्छत\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2137020, "chapter_id": 3970, "verse_number": "२०", "content_sanskrit": "भर्तुश्शरीररक्षां च विधाय हि तपस्विनी ।\nभर्तारमनुगच्छन्ती तथावस्थं सुमध्यमा \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2137021, "chapter_id": 3970, "verse_number": "२१", "content_sanskrit": "नियमव्रतसंसिद्धा महाभागा पतिव्रता \t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2137022, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2137023, "chapter_id": 3970, "verse_number": "२२", "content_sanskrit": "निवर्त गच्छ सावित्रि कुरुष्वास्यौर्ध्वदैहिकम् ।\nकृतं भर्तुस्त्वयाऽऽनृण्यं यावद् गम्यं गतं त्वया \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2137024, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2137025, "chapter_id": 3970, "verse_number": "२३", "content_sanskrit": "यत्र मे नीयते भर्ता स्वयं वा यत्र गच्छति ।\nमया च तत्र गन्तव्यमेष धर्मः सनातनः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2137026, "chapter_id": 3970, "verse_number": "२४", "content_sanskrit": "तपसा गुरुभक्त्या च भर्तुः स्नेहाद् व्रतेन च ।\nतव चैव प्रसादेन न मे प्रतिहता गतिः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2137027, "chapter_id": 3970, "verse_number": "२५", "content_sanskrit": "प्राहुः सप्तपदं मित्रं बुधास्तत्त्वार्थदर्शिनः ।\nमित्रतां च पुरस्कृत्य किञ्चिद् वक्ष्यामि तच्छ्रुणु \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2137028, "chapter_id": 3970, "verse_number": "२६", "content_sanskrit": "नानात्मवन्तस्तु वने चरन्ति\nधर्मं च वासं च परिश्रमं च ।\nविज्ञानतो धर्ममुदाहरन्ति\nतस्मात् सन्तो धर्ममाहुः प्रधानम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2137029, "chapter_id": 3970, "verse_number": "२७", "content_sanskrit": "एकस्य धर्मेण सतां मतेन\nसर्वे स्म तं मार्गमनुप्रपन्नाः ।\nमा वै द्वितीयं मा तृतीयं च वाञ्छे\nतस्मात् सन्तो धर्ममाहुः प्रधानम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2137030, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2137031, "chapter_id": 3970, "verse_number": "२८", "content_sanskrit": "निवर्त तुष्टोऽस्मि तवानया गिरा\nस्वराक्षरव्यञ्जनहेतुयुक्तया ।\nवरं वृणीष्वेह विनास्य जीवितं\nददानि ते सर्वमनिन्दिते वरम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2137032, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2137033, "chapter_id": 3970, "verse_number": "२९", "content_sanskrit": "च्युतः स्वराज्याद् वनवासमाश्रितो\nविनष्टचक्षुः श्वशुरो ममाश्रमे ।\nस लब्धचक्षुर्बलवान् भवेन्नृपः\nतव प्रसादाज्ज्वलनार्कसन्निभः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2137034, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2137035, "chapter_id": 3970, "verse_number": "३०", "content_sanskrit": "ददानि तेऽहं तमनिन्दिते वरं\nयथा त्वयोक्तं भविता च तत् तथा ।\nतवाध्वना ग्लानिमिवोपलक्षये निवर्त\nगच्छस्व न ते श्रमो भवेत् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2137036, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2137037, "chapter_id": 3970, "verse_number": "३१", "content_sanskrit": "श्रमः कुतो भर्तृसमीपतो हि मे\nयतो हि भर्ता मम सा गतिर्ध्रुवा ।\nयतः पतिं नेष्यसि तत्र मे गतिः\nसुरेश भूयश्च वचो निबोध मे \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2137038, "chapter_id": 3970, "verse_number": "३२", "content_sanskrit": "सतां सकृत्सङ्गतमीप्सितं परं\nततः परं मित्रमिति प्रचक्षते ।\nन चाफलं सत्पुरुषेण सङ्गतं\nततः सतां सन्निवसेत् समागमे \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2137039, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2137040, "chapter_id": 3970, "verse_number": "३३", "content_sanskrit": "मनोऽनुकूलं बुधबुद्धिवर्धनं\nत्वया यदुक्तं वचनं हिताश्रयम् ।\nविना पुनः सत्यवतोऽस्य जीवितं\nवरं द्वितीयं वरयस्व भामिनि \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2137041, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2137042, "chapter_id": 3970, "verse_number": "३४", "content_sanskrit": "हृतं पुरा मे श्वशुरस्य धीमतः\nस्वमेव राज्यं लभतां स पार्थिव ।\nजह्यात् स्वधर्मं न च मे गुरुर्यथा\nद्वितीयमेतद् वरयामि ते वरम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2137043, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2137044, "chapter_id": 3970, "verse_number": "३५", "content_sanskrit": "स्वमेव राज्यं प्रतिपत्स्यतेऽचिरात्\nन च स्वधर्मात् परिहास्यते नृपः ।\nकृतेन कामेन मया नृपात्मजे\nनिवर्त गच्छस्व न ते श्रमो भवेत् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2137045, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सावित्री-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2137046, "chapter_id": 3970, "verse_number": "३६", "content_sanskrit": "प्रजास्त्वयैता नियमेन संयता\nनियम्य चैता नयसे निकामया ।\nततो यम त्वं तव देव विश्रुतं\nनिबोध चेमां गिरमीरितां मया \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2137047, "chapter_id": 3970, "verse_number": "३७", "content_sanskrit": "अद्रोहः सर्वभूतेषु कर्मणा मनसा गिरा ।\nअनुग्रहश्च दानं च सतां धर्मः सनातनः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2137048, "chapter_id": 3970, "verse_number": "३८", "content_sanskrit": "एवं प्रायश्च लोकोऽयं मनुष्याः भ(श)क्तिपेशलाः ।\nसन्तस्त्वेवाप्यमित्रेषु दयां प्राप्तेषु कुर्वते \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2137049, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2137050, "chapter_id": 3970, "verse_number": "३९", "content_sanskrit": "पिपासितस्येव भवेद् यथा पयः\nतथा त्वया वाक्यमिदं समीरितम् ।\nविना पुनः सत्यवतोऽस्य जीवितं\nवरं वृणीष्वेह शुभे यदिच्छसि \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2137051, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2137052, "chapter_id": 3970, "verse_number": "४०", "content_sanskrit": "ममानपत्यः पृथिवीपतिः पिता\nभवेत् पितुः पुत्रशतं तथौरसम् ।\nकुलस्य सन्तानकरं च यद् भवेत्\nतृतीयमेतद् वरयामि ते वरम् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2137053, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2137054, "chapter_id": 3970, "verse_number": "४१", "content_sanskrit": "कुलस्य सन्तानकरं सुवर्चसं\nशतं सुतानां पितुरस्तु ते शुभे ।\nकृतेन कामेन नराधिपात्मजे\nनिवर्त दूरं हि पथस्त्वमागता \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2137055, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2137056, "chapter_id": 3970, "verse_number": "४२", "content_sanskrit": "न दूरमेतन्मम भर्तृसंनिधौ\nमनो हि मे दूरतरं प्रधावति ।\nअथ व्रजन्नेव गिरं समुद्यतां\nमयोच्यमानां शृणु भूय एव च \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2137057, "chapter_id": 3970, "verse_number": "४३", "content_sanskrit": "विवस्वतस्त्वं तनयः प्रतापवान्\nततो हि वैवस्वत उच्यसे बुधैः ।\nसमेन धर्मेण चरन्ति ताः प्रजाः\nततस्तवेहेश्वर धर्मराजता \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2137058, "chapter_id": 3970, "verse_number": "४४", "content_sanskrit": "आत्मन्यपि न विश्वासस्तथा भवति सत्सु यः ।\nतस्मात् सत्सु विशेषेण सर्वः प्रणयमिच्छति \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2137059, "chapter_id": 3970, "verse_number": "४५", "content_sanskrit": "सौहृदात् सर्वभूतानां विश्वासो नाम जायते ।\nतस्मात् सत्सु विशेषेण विश्वासं कुरुते जनः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2137060, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2137061, "chapter_id": 3970, "verse_number": "४६", "content_sanskrit": "उदाहृतं ते वचनं यदङ्गने\nशुभे न तादृक्त्वदृते श्रुतं मया ।\nअनेन तुष्टोऽस्मि विनास्य जीवितं\nवरं चतुर्थं वरयस्व गच्छ च \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2137062, "chapter_id": 3970, "verse_number": "४७", "content_sanskrit": "ममात्मजं सत्यवतस्तथौरसं\nभवेदुभाभ्यामिह यत् कुलोद्वहम् ।\nशतं सुतानां बलवीर्यशालिनाम्\nइदं चतुर्थं वरयामि ते वरम् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2137063, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2137064, "chapter_id": 3970, "verse_number": "४८", "content_sanskrit": "वरं वृणे सत्यवतो मयि प्रभो\nभवेत् सुतानां शतमेतदीप्सितम् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2137065, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2137066, "chapter_id": 3970, "verse_number": "४९", "content_sanskrit": "शतं सुतानां बलवीर्यशालिनां\nभविष्यति प्रीतिकरं तवाबले ।\nपरिश्रमस्ते न भवेन्नृपात्मजे\nनिवर्त दूरं हि पथस्त्वमागता ।\nतथास्तु ते पुत्रशतं शुभानने\nद्रुतं निवर्तस्व परिश्रमो न ते \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2137067, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2137068, "chapter_id": 3970, "verse_number": "५०", "content_sanskrit": "सतां सदा शाश्वतधर्मवृत्तिः\nसन्तो न सीदन्ति न च व्यथन्ति ।\nसतां सद्भिर्नाफलं सङ्गमोऽस्ति\nसद्भ्यो भयं नानुवर्तन्ति सन्तः \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2137069, "chapter_id": 3970, "verse_number": "५१", "content_sanskrit": "सन्तो हि सत्येन नयन्ति सूर्यं\nसन्तो भूमिं तपसा धारयन्ति ।\nसन्तो गतिर्भूतभव्यस्य राजन्\nसतां मध्ये नावसीदन्ति सन्तः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2137070, "chapter_id": 3970, "verse_number": "५२", "content_sanskrit": "आर्यजुष्टमिदं वृत्तमिति विज्ञाय शाश्वतम् ।\nसन्तः परार्थं कुर्वाणा नावेक्षन्ति परस्परम् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2137071, "chapter_id": 3970, "verse_number": "५३", "content_sanskrit": "न च प्रसादः सत्पुरुषेषु मोघो\nन चाप्यर्थो नश्यति नापि मानः ।\nयस्मादेतन्नियतं सत्सु नित्यं\nतस्मात् सन्तो रक्षितारो भवन्ति \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2137072, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2137073, "chapter_id": 3970, "verse_number": "५४", "content_sanskrit": "यथा यथा भाषसि धर्मसंहितं\nमनोऽनुकूलं सुपदं महार्थवत् ।\nतथा तथा मे त्वयि भक्तिरुत्तमा\nवरं वृणीष्वाप्रतिमं पतिव्रते \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2137074, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2137075, "chapter_id": 3970, "verse_number": "५५", "content_sanskrit": "न तेऽपवर्गः सुकृताद् विना कृतः\nतथा यथान्येषु वरेषु मानद ।\nवरं वृणे जीवतु सत्यवानयं\nयथा मृता ह्येवमहं पतिं विना \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2137076, "chapter_id": 3970, "verse_number": "५६", "content_sanskrit": "न कामये भर्तृविनाकृता सुखं\nन कामये भर्तृविनाकृता दिवम् ।\nन कामये भर्तृविनाकृता श्रियं\nन भर्तृहीना व्यवसामि जीवितुम् \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2137077, "chapter_id": 3970, "verse_number": "५७", "content_sanskrit": "वरातिसर्गः शतपुत्रता मम\nत्वयैव दत्तो ह्रियते च मे पतिः ।\nवरं वृणे जीवतु सत्यवानयं\nतवैव सत्यं वचनं भविष्यति \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2137078, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2137079, "chapter_id": 3970, "verse_number": "५८", "content_sanskrit": "तथेत्युक्त्वा तु तं पाशं मुक्त्वा वैवस्वतो यमः ।\nधर्मराजः प्रहृष्टात्मा सावित्रीमिदमब्रवीत् \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2137080, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2137081, "chapter_id": 3970, "verse_number": "५९", "content_sanskrit": "एष भद्रे मया मुक्तो भर्ता ते कुलनन्दिनि ।\nतोषितोऽहं त्वया साध्वि वाक्यैर्धर्मार्थसंहितैः \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2137082, "chapter_id": 3970, "verse_number": "६०", "content_sanskrit": "अरोगस्तव नेयश्च सिद्धार्थः स भविष्यति ।\nचतुर्वर्षशतायुश्च त्वया सार्धमवाप्स्यति \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2137083, "chapter_id": 3970, "verse_number": "६१", "content_sanskrit": "इष्ट्वा यज्ञैश्च धर्मेण ख्यातिं लोके गमिष्यति ।\nत्वयि पुत्रशतं चैव सत्यवान् जनयिष्यति \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2137084, "chapter_id": 3970, "verse_number": "६२", "content_sanskrit": "ते चापि सर्वे राजानः क्षत्रियाः पुत्रपौत्रिणः ।\nख्यातास्त्वन्नामधेयाश्च भविष्यन्तीह शाश्वताः \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2137085, "chapter_id": 3970, "verse_number": "६३", "content_sanskrit": "पितुश्च ते पुत्रशतं भविता तव मातरि ।\nमालव्यां मालवा नाम शाश्वताः पुत्रपौत्रिणः ।\nभ्रातरस्ते भविष्यन्ति क्षत्रियास्त्रिदशोपमाः \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2137086, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2137087, "chapter_id": 3970, "verse_number": "६४", "content_sanskrit": "एवं तस्यै वरं दत्त्वा धर्मराजः प्रतापवान् ।\nनिवर्तयित्वा सावित्रीं स्वमेव भवनं ययौ \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2137088, "chapter_id": 3970, "verse_number": "६५", "content_sanskrit": "सावित्र्यपि यमे याते भर्तारं प्रतिलभ्य च ।\nजगाम तत्र यत्रास्या भर्तुः शावं कलेवरम् \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2137089, "chapter_id": 3970, "verse_number": "६६", "content_sanskrit": "सा भूमौ प्रेक्ष्य भर्तारमुपसृत्योपगृह्य च ।\nउत्सङ्गे शिर आरोप्य भूमावुपविवेश ह \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2137090, "chapter_id": 3970, "verse_number": "६७", "content_sanskrit": "सञ्ज्ञां च स पुनर्लब्ध्वा सावित्रीमभ्यभाषत ।\nप्रोष्यागत इव प्रेम्णा पुनः पुनरुदीक्ष्य वै \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2137091, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सत्यवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2137092, "chapter_id": 3970, "verse_number": "६८", "content_sanskrit": "सुचिरं बत सुप्तोऽस्मि किमर्थं नावबोधितः ।\nक्व चासौ पुरुषः श्यामो योऽसौ मां सञ्चकर्ष ह \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2137093, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2137094, "chapter_id": 3970, "verse_number": "६९", "content_sanskrit": "सुचिरं त्वं प्रसुप्तोऽसि ममाङ्के पुरुषर्षभ ।\nगतः स भगवान् देवः प्रजासंयमनो यमः \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2137095, "chapter_id": 3970, "verse_number": "७०", "content_sanskrit": "विश्रान्तोऽसि महाभाग विनिद्रश्च नृपात्मज ।\nयदि सह्यं समुत्तिष्ठ विगाढां पश्य शर्वरीम् \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2137096, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2137097, "chapter_id": 3970, "verse_number": "७१", "content_sanskrit": "उपलभ्य ततः सञ्ज्ञां सुखसुप्त इवोत्थितः ।\nदिशः सर्वा वनान्तांश्च निरीक्ष्योवाच सत्यवान् \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2137098, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सत्यवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2137099, "chapter_id": 3970, "verse_number": "७२", "content_sanskrit": "फलाहारोऽस्मि निष्क्रान्तस्त्वया सह सुमध्यमे ।\nततः पाटयतः काष्ठं शिरसो मे रुजाभवत् \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2137100, "chapter_id": 3970, "verse_number": "७३", "content_sanskrit": "शिरोऽभितापसन्तप्तः स्थातुं चिरमशक्नुवन् ।\nतवोत्सङ्गे प्रसुप्तोऽस्मि इति सर्वं स्मरे शुभे \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2137101, "chapter_id": 3970, "verse_number": "७४", "content_sanskrit": "त्वयोपगूढस्य च मे निद्रयापहृतं मनः।\nततोऽपश्यं तमो घोरं पुरुषं च महौजसम् \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2137102, "chapter_id": 3970, "verse_number": "७५", "content_sanskrit": "तद् यदि त्वं विजानासि किं तद् ब्रूहि सुमध्यमे ।\nस्वप्नो मे यदि वा दृष्टो यदि वा सत्यमेव तत् \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2137103, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2137104, "chapter_id": 3970, "verse_number": "७६", "content_sanskrit": "तमुवाचाथ सावित्री रजनी व्यवगाहते ।\nश्वस्ते सर्वं यथावृत्तमाख्यास्यामि नृपात्मज \t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2137105, "chapter_id": 3970, "verse_number": "७७", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ भद्रं ते पितरौ पश्य सुव्रत ।\nविगाढा रजनी चेयं निवृत्तश्च दिवाकरः \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2137106, "chapter_id": 3970, "verse_number": "७८", "content_sanskrit": "नक्तञ्चराश्चरन्त्येते हृष्टाः क्रूराभिभाषिणः ।\nश्रूयन्ते पर्णशब्दाश्च मृगाणां चरतां वने \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2137107, "chapter_id": 3970, "verse_number": "७९", "content_sanskrit": "एता घोरं शिवा नादान् दिशं दक्षिणपश्चिमाम् ।\nआस्थाय विरुवन्त्युग्राः कम्पयन्त्यो मनो मम \t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2137108, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सत्यवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2137109, "chapter_id": 3970, "verse_number": "८०", "content_sanskrit": "वनं प्रतिभयाकारं घनेन तमसाऽऽवृतम् ।\nन विज्ञास्यसि पन्थानं गन्तुं चैव न शक्ष्यसि \t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2137110, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2137111, "chapter_id": 3970, "verse_number": "८१", "content_sanskrit": "अस्मिन्नद्य वने दग्धे शुष्कवृक्षः स्थितोज्वलम् ।\nवायुना धूयमानोऽत्र दृश्यतेऽग्निः क्वचित् क्वचित् \t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2137112, "chapter_id": 3970, "verse_number": "८२", "content_sanskrit": "ततोऽग्निमानयित्वेह ज्वालयिष्यामि सर्वतः ।\nकाष्ठानीमानि सन्तीह जहि सन्तापमात्मनः \t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2137113, "chapter_id": 3970, "verse_number": "८३", "content_sanskrit": "यदि नोत्सहसे गन्तुं सरुजं त्वां हि लक्षये ।\nन च ज्ञास्यसि पन्थानं तमसा संवृते वने \t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2137114, "chapter_id": 3970, "verse_number": "८४", "content_sanskrit": "श्वः प्रभाते वने दृश्ये यास्यावोऽनुमते तव ।\nवसावेह क्षपामेकां रुचितं यदि तेऽनघ \t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2137115, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सत्यवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2137116, "chapter_id": 3970, "verse_number": "८५", "content_sanskrit": "शिरोरुजा निवृत्ता मे स्वस्थान्यङ्गानि लक्षये ।\nमातापितृभ्यामिच्छामि सङ्गमं त्वत्प्रसादजम् \t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2137117, "chapter_id": 3970, "verse_number": "८६", "content_sanskrit": "न कदाचिद् विकालं हि गतपूर्वो मयाऽऽश्रमः ।\nअनागतायां सन्ध्यायां माता मे प्ररुणद्धि माम् \t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2137118, "chapter_id": 3970, "verse_number": "८७", "content_sanskrit": "दिवापि मयि निष्क्रान्ते सन्तप्येते गुरू मम ।\nविचिनोति हि मां तातः सहैवाश्रमवासिभिः \t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2137119, "chapter_id": 3970, "verse_number": "८८", "content_sanskrit": "मात्रा पित्रा च सुभृशं दुःखिताभ्यामहं पुरा ।\nउपालब्धश्च बहुशश्चिरेणागच्छसीति ह \t ॥ ८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2137120, "chapter_id": 3970, "verse_number": "८९", "content_sanskrit": "का त्ववस्था तयोरद्य मदर्थमिति चिन्तये ।\nतयोरदृश्ये मयि च महद् दुःखं भविष्यति \t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2137121, "chapter_id": 3970, "verse_number": "९०", "content_sanskrit": "पुरा मामूचतुश्चैव रात्रावस्त्रायमाणकौ ।\nभृशं सुदुःखितौ वृद्धौ बहुशः प्रीतिसंयुतौ \t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2137122, "chapter_id": 3970, "verse_number": "९१", "content_sanskrit": "त्वया हीनौ न जीवाव मुहूर्तमपि पुत्रक ।\nयावद्धरिष्यसे पुत्र तावन्नौ जीवितं ध्रुवम् \t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2137123, "chapter_id": 3970, "verse_number": "९२", "content_sanskrit": "वृद्धयोरन्धयोर्दृष्टिस्त्वयि वंशः प्रतिष्ठितः ।\nत्वयि पिण्डश्च कीर्तिश्च सन्तानं चावयोरिति \t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2137124, "chapter_id": 3970, "verse_number": "९३", "content_sanskrit": "तौ रात्रौ मामपश्यन्तौ कामवस्थां गमिष्यतः \t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2137125, "chapter_id": 3970, "verse_number": "९४", "content_sanskrit": "निद्रायाश्चाभ्यसूयामि यस्या हेतोः पिता मम ।\nमाता च संशयं प्राप्ता मत्कृतेऽनपकारिणी \t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2137126, "chapter_id": 3970, "verse_number": "९५", "content_sanskrit": "अहं च संशयं प्राप्तः कृच्छ्रामापदमास्थितः ।\nमातापितृभ्यां हि विना नाहं जीवितुमुत्सहे\t ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2137127, "chapter_id": 3970, "verse_number": "९६", "content_sanskrit": "व्यक्तमाकुलया बुद्ध्या प्रज्ञाचक्षुः पिता मम ।\nएकैकमस्यां वेलायां पृच्छत्याश्रमवासिनम् \t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2137128, "chapter_id": 3970, "verse_number": "९७", "content_sanskrit": "नात्मानमनुशोचामि यथाहं पितरं शुभे ।\nभर्तारं चाप्यनुगतां मातरं परिदुर्बलाम् \t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2137129, "chapter_id": 3970, "verse_number": "९८", "content_sanskrit": "मत्कृतेन हि तावद्य सन्तापं परमेष्यतः ।\nजीवन्तावनुजीवामि भर्तव्यौ तौ मयेति ह \t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2137130, "chapter_id": 3970, "verse_number": "९९", "content_sanskrit": "तयोः प्रियं मे कर्तव्यमिति जानामि चाप्यहम् ।\nपरमं दैवतं तौ मे पूजनीयौ सदा मया \t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2137131, "chapter_id": 3970, "verse_number": "१००", "content_sanskrit": "तयोस्तु मे सदास्त्येवं व्रतमेतत् पुरातनम् \t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2137132, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2137133, "chapter_id": 3970, "verse_number": "१०१", "content_sanskrit": "एवमुक्त्वा स धर्मात्मा गुरुभक्तो गुरुप्रियः ।\nउच्छ्रित्य बाहू दुःखार्तः सुस्वरं प्ररुरोद ह \t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2137134, "chapter_id": 3970, "verse_number": "१०२", "content_sanskrit": "ततोऽब्रवीत् तथा दृष्ट्वा भर्तारं शोककर्शितम् \t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2137135, "chapter_id": 3970, "verse_number": "१०३", "content_sanskrit": "प्रमृज्याश्रूणि नेत्राभ्यां सावित्री धर्मचारिणी ।\nयदि मेऽस्ति तपस्तप्तं यदि दत्तं हुतं यदि ।\nश्वश्रूश्वशुरभर्तॄणां मम पुण्यास्तु शर्वरी \t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2137136, "chapter_id": 3970, "verse_number": "१०४", "content_sanskrit": "न स्मराम्युक्तपूर्वं वै स्वैरेष्वप्यनृतां गिरम् ।\nतेन सत्येन तावद्य ध्रियेतां श्वशुरौ मम \t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2137137, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सत्यवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2137138, "chapter_id": 3970, "verse_number": "१०५", "content_sanskrit": "कामये दर्शंनं पित्रोर्याहि सावित्रि माचिरम् ।\nअपि नाम गुरू तौ हि पश्येयं प्रीयमाणकौ \t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2137139, "chapter_id": 3970, "verse_number": "१०६", "content_sanskrit": "पुरा मातुःपितुर्वापि यदि पश्यामि विप्रियम् ।\nन जीविष्ये वरारोहे सत्येनात्मानमालभे \t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 2137140, "chapter_id": 3970, "verse_number": "१०७", "content_sanskrit": "यदि धर्मे च ते बुद्धिर्मां चेज्जीवन्तमिच्छसि।\nमम प्रियं वा कर्तव्यं गच्छावाश्रममन्तिकात् \t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 2137141, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 2137142, "chapter_id": 3970, "verse_number": "१०८", "content_sanskrit": "सावित्री तत उत्थाय केशान् संयम्य भाविनी ।\nपतिमुत्थापयामास बाहुभ्यां परिगृह्य वै \t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 2137143, "chapter_id": 3970, "verse_number": "१०९", "content_sanskrit": "उत्थाय सत्यवांश्चापि प्रमृज्याङ्गानि पाणिना ।\nसर्वा दिशः समालोक्य कठिने दृष्टिमादधे \t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 2137144, "chapter_id": 3970, "verse_number": "११०", "content_sanskrit": "तमुवाचाथ सावित्री श्वः फलानि हरिष्यसि ।\nयोगक्षेमार्थमेतं ते नेष्यामि परशुं त्वहम् \t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 2137145, "chapter_id": 3970, "verse_number": "१११", "content_sanskrit": "कृत्वा कठिनभारं सा वृक्षशाखावलम्बिनम् ।\nगृहीत्वा परशुं भर्तुः सकाशे पुनरागमत् \t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 2137146, "chapter_id": 3970, "verse_number": "११२", "content_sanskrit": "वामे स्कन्धे तु वामोरूर्भर्तुर्बाहुं निवेश्य च ।\nदक्षिणेन परिष्वज्य जगाम गजगामिनी \t॥११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 2137147, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "सत्यवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 2137148, "chapter_id": 3970, "verse_number": "११३", "content_sanskrit": "अभ्यासगमनाद् भीरु पन्थानो विदिता मम ।\nवृक्षान्तरालोकितया ज्योत्स्नया चापि लक्षये \t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 2137149, "chapter_id": 3970, "verse_number": "११४", "content_sanskrit": "आगतौ स्वः पथा येन फलान्यवचितानि च ।\nयथागतं शुभे गच्छ पन्थानं मा विचारय \t॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 2137150, "chapter_id": 3970, "verse_number": "११५", "content_sanskrit": "पलाशखण्डे चैतस्मिन् पन्था व्यावर्तते द्विधा ।\nतस्योत्तरेण यः पन्थास्तेन गच्छ त्वरस्व च\t॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 2137151, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "स्वस्थोऽस्मि बलवानस्मि दिदृक्षुः पितरावुभौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 2137152, "chapter_id": 3970, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}, {"id": 2137153, "chapter_id": 3970, "verse_number": "११६", "content_sanskrit": "ब्रुवन्नेवं त्वरायुक्तः सम्प्रायादाश्रमं प्रति ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 161}, {"id": 2137154, "chapter_id": 3970, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि षडशीत्यधिकद्विशततमोऽध्यायः ॥२८६॥\nपतिव्रतामाहात्म्यपर्वणि सावित्र्युपाख्यानपर्वणि पञ्चमोऽध्यायः ॥५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 162}]