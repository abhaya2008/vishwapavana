[{"id": 2094323, "chapter_id": 3015, "verse_number": "१३-१४५-१", "content_sanskrit": "युधिष्ठिर उवाच।\nएवं प्रयाचति तदा भास्करे मुनिसत्तमः।\nजमदग्निर्महातेजाः किं कार्यं प्रत्यपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094324, "chapter_id": 3015, "verse_number": "१३-१४५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094325, "chapter_id": 3015, "verse_number": "१३-१४५-२", "content_sanskrit": "स तथा याचमानस्य मुनिरग्निसमप्रभः।\nजमदग्निः शमं नैव जगाम कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094326, "chapter_id": 3015, "verse_number": "१३-१४५-३", "content_sanskrit": "ततः सूर्यो मधुरया वाचा तमिदमब्रवीत्।\nकृताञ्जलिर्विप्ररूपी प्रणम्यैनं विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094327, "chapter_id": 3015, "verse_number": "१३-१४५-४", "content_sanskrit": "चलं निमित्तं विप्रर्षे सदा सूर्यस्य गच्छतः।\nकतं चलं भेत्स्यसि त्वं सदा यान्तं दिवाकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094328, "chapter_id": 3015, "verse_number": "१३-१४५-५x", "content_sanskrit": "जमदग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094329, "chapter_id": 3015, "verse_number": "१३-१४५-५", "content_sanskrit": "स्थिरं चापि चलं चापि जाने त्वां ज्ञानचक्षुषा।\nअवस्यं विनयाधानं कार्यमद्य मया तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094330, "chapter_id": 3015, "verse_number": "१३-१४५-६", "content_sanskrit": "मध्याह्ने वै निमेषार्धं तिष्टसि त्वं दिवाकर।\nतत्र भेत्स्यामि सूर्य त्वां न मेऽत्रास्ति विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094331, "chapter_id": 3015, "verse_number": "१३-१४५-७x", "content_sanskrit": "सूर्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094332, "chapter_id": 3015, "verse_number": "१३-१४५-७", "content_sanskrit": "असंशयं मां विप्रर्षे भेत्स्यसे धन्विनांवर।\nअपकारिणं मां विद्दि भगवञ्शरणागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094333, "chapter_id": 3015, "verse_number": "१३-१४५-८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094334, "chapter_id": 3015, "verse_number": "१३-१४५-८", "content_sanskrit": "ततः प्रहस्य भगवाञ्जमदग्निरुवाच तम्।\nन भीः सूर्य त्वया कार्या प्रणिपातगतो ह्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094335, "chapter_id": 3015, "verse_number": "१३-१४५-९", "content_sanskrit": "ब्राह्मणेष्वार्जवं यच्च स्थैर्यं च धरणीतले।\nसौम्यतां चैव सोमस्य गाम्भीर्यं वरुणस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094336, "chapter_id": 3015, "verse_number": "१३-१४५-१०", "content_sanskrit": "दीप्तिमग्नेः प्रभां मेरोः प्रतापं धनदस्य च।\nएतान्यतिक्रमेद्यो वै स हन्याच्छरणागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094337, "chapter_id": 3015, "verse_number": "१३-१४५-११", "content_sanskrit": "भवेत्स गुरुतल्पी च ब्रह्मिहा च स वै भवेत्।\nसुरापानं स कुर्याच्च यो हन्याच्छरणागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2094338, "chapter_id": 3015, "verse_number": "१३-१४५-१२", "content_sanskrit": "एतस्य त्वपनीतस्य समाधिं तात चिन्तय।\nयथा सुखगमः पन्था भवेत्त्वद्रश्मितापितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2094339, "chapter_id": 3015, "verse_number": "१३-१४५-१३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2094340, "chapter_id": 3015, "verse_number": "१३-१४५-१३", "content_sanskrit": "एतावदुक्त्वा स तदा तूष्णीमासीद्भृगूत्तमः।\nअथ सूर्योऽददत्तस्मै छत्रोपानहमाशु वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2094341, "chapter_id": 3015, "verse_number": "१३-१४५-१४x", "content_sanskrit": "सूर्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2094342, "chapter_id": 3015, "verse_number": "१३-१४५-१४", "content_sanskrit": "महर्षे शिरसस्त्राणां छत्रं मद्रश्मिवारणम्।\nप्रतिगृह्णीष्व पद्भ्यां च त्राणार्थं चर्मपादुके।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2094343, "chapter_id": 3015, "verse_number": "१३-१४५-१५", "content_sanskrit": "अद्यप्रभृति चैवेह लोके सम्प्रचरिष्यति।\nपुण्यकेषु च सर्वेषु परमक्षय्यमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2094344, "chapter_id": 3015, "verse_number": "१३-१४५-१६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2094345, "chapter_id": 3015, "verse_number": "१३-१४५-१६", "content_sanskrit": "उपानहौ च च्छत्रं च सूर्येणैतत्प्रवर्तितम्।\nपुण्यमेतदभिख्यातं त्रिषु लोकेषु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2094346, "chapter_id": 3015, "verse_number": "१३-१४५-१७", "content_sanskrit": "तस्मात्प्रयच्छ विप्रेषु छत्रोपानहमुत्तमम्।\nधर्मस्ते सुमहान्भावी न मेऽत्रास्ति विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2094347, "chapter_id": 3015, "verse_number": "१३-१४५-१८", "content_sanskrit": "छत्रं हि भरतश्रेष्ठः यः प्रदद्याद्द्विजातये।\nशुभ्रं शतशलाकं वै स प्रेत्य सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2094348, "chapter_id": 3015, "verse_number": "१३-१४५-१९", "content_sanskrit": "स शक्रलोके वसति पूज्यमानो द्विजातिभिः।\nअप्सरोभिश्च सततं देवैश्च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2094349, "chapter_id": 3015, "verse_number": "१३-१४५-२०", "content_sanskrit": "उपानहौ च यो दद्याच्छ्लक्ष्णौ स्नेहसमन्वितौ।\nस्नातकाय महाबाहो संशिताय द्विजातये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2094350, "chapter_id": 3015, "verse_number": "१३-१४५-२१", "content_sanskrit": "सोपि लोकानवाप्नोति देवतैरभिपूजितान्।\nगोलोके स मुदा युक्तो वसति प्रेत्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2094351, "chapter_id": 3015, "verse_number": "१३-१४५-२२", "content_sanskrit": "एतत्ते भरतश्रेष्ठ मया कार्त्स्न्येन कीर्तितम्।\nछत्रोपानहदानस्य फलं भरतसत्तम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2094352, "chapter_id": 3015, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चचत्वारिंशदधिकशततमोऽध्यायः॥ १४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]