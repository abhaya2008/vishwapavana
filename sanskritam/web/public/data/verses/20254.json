[{"id": 7000254000, "chapter_id": 20254, "verse_number": "१-८-१", "content_sanskrit": "भीष्म उवाच ।\nबहुभिर्द्धरणी भुक्ता भूपालैः श्रूयते पुरा ।\nपार्थिवाः पृथिवीयोगात्पृथिवी कस्य योगतः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000254001, "chapter_id": 20254, "verse_number": "१-८-२", "content_sanskrit": "किमर्थं च कृता संज्ञा भूमेस्सा पारिभाषिकी ।\nगौरितीयं च संज्ञा वा भुवः कस्माद्ब्रवीहि मे॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000254002, "chapter_id": 20254, "verse_number": "१-८-३", "content_sanskrit": "पुलस्त्य उवाच ।\nपुरा कृतयुगस्यासीदंगो नाम प्रजापतिः ।\nमृत्योस्तु दुहिता तेन परिणीतातिदुर्मुखी॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000254003, "chapter_id": 20254, "verse_number": "१-८-४", "content_sanskrit": "सुनीथा नाम तस्यास्तु वेनो नाम सुतः पुरा ।\nअधर्मनिरतः कामी बलवान्वसुधाधिपः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000254004, "chapter_id": 20254, "verse_number": "१-८-५", "content_sanskrit": "लोकस्याधर्मकृच्चापि परभार्यापहारकः ।\nअथ तस्य प्रसिद्यर्थं जगदर्थं महर्षिभिः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000254005, "chapter_id": 20254, "verse_number": "१-८-६", "content_sanskrit": "अनुनीतोपि न ददावशुद्धात्माऽभयं ततः ।\nशापेन मारयित्वैनमराजकभयार्दिताः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000254006, "chapter_id": 20254, "verse_number": "१-८-७", "content_sanskrit": "ममंथुर्ब्राह्मणास्तस्य बलाद्देहमकल्मषाः ।\nतत्कायान्मथ्यमानात्तु जनिता म्लेच्छजातयः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000254007, "chapter_id": 20254, "verse_number": "१-८-८", "content_sanskrit": "शरीरे मातुरंशेन कृष्णांजनसमप्रभाः ।\nपितुरंशस्य संगेन धार्मिको धर्मकारकः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000254008, "chapter_id": 20254, "verse_number": "१-८-९", "content_sanskrit": "उत्पन्नो दक्षिणाद्धस्तात्सधनुः सशरो गदी ।\nदिव्यतेजोमयः पुत्रस्सरत्नकवचांगदः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000254009, "chapter_id": 20254, "verse_number": "१-८-१०", "content_sanskrit": "पृथुरेवाभवन्नाम्ना स च विष्णुरजायत ।\nस विप्रैरभिषिक्तः संस्तपः कृत्वा सुदुष्करं॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000254010, "chapter_id": 20254, "verse_number": "१-८-११", "content_sanskrit": "विष्णोर्वरेण सर्वस्य प्रभुत्वमगमत्प्रभुः ।\nनिःस्वाध्यायवषट्कारं निर्द्धर्मं वीक्ष्य भूतलं॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000254011, "chapter_id": 20254, "verse_number": "१-८-१२", "content_sanskrit": "वेद्धुमेवोद्यतः कोपाच्छरेणामितविक्रमः ।\nततो गोरूपमास्थाय भूः पलायितुमुद्यता॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000254012, "chapter_id": 20254, "verse_number": "१-८-१३", "content_sanskrit": "पृष्ठे त्वन्वगमत्तस्याः पृथुः सेषुशरासनः ।\nततः स्थित्वैकदेशे तु किं करोमीति चाब्रवीत्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000254013, "chapter_id": 20254, "verse_number": "१-८-१४", "content_sanskrit": "पृथुरप्यवदद्वाक्यमीप्सितं देहि सुव्रते ।\nसर्वस्य जगतः शीघ्रं स्थावरस्य चरस्य च॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000254014, "chapter_id": 20254, "verse_number": "१-८-१५", "content_sanskrit": "तथेति चाब्रवीद्भूमिर्दुदोह स नराधिपः ।\nस्वके पाणौ पृथुर्वत्सं कृत्वा स्वायंभुवं मनुं॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000254015, "chapter_id": 20254, "verse_number": "१-८-१६", "content_sanskrit": "तदन्नमभवद्दुग्धं प्रजा जीवंति येन तु ।\nततस्तु ऋषिभिर्दुग्धा वत्सः सोमस्तदाभवत्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000254016, "chapter_id": 20254, "verse_number": "१-८-१७", "content_sanskrit": "दोग्धा वाचस्पतिरभूत्पात्रं वेदस्तपो रसः ।\nदेवैश्च वसुधा दुग्धा मरुद्दोग्धा तदाभवत्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000254017, "chapter_id": 20254, "verse_number": "१-८-१८", "content_sanskrit": "इन्द्रो वत्सः समभवत्क्षीरमूर्ज्जस्वलं बलं ।\nदेवानां कांचनं पात्रं पितृणां राजतं तथा॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000254018, "chapter_id": 20254, "verse_number": "१-८-१९", "content_sanskrit": "अंतकश्चाभवद्दोग्धा यमो वत्सः स्वधा रसः ।\nबिलं च पात्रं नागानां तक्षको वत्सकोभवत्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000254019, "chapter_id": 20254, "verse_number": "१-८-२०", "content_sanskrit": "विषं क्षीरं ततो दोग्धा धृतराष्ट्रोभवत्पुनः ।\nअसुरैरपि दुग्धेयं आयसे शत्रुपीडनम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000254020, "chapter_id": 20254, "verse_number": "१-८-२१", "content_sanskrit": "पात्रे मायामभूद्वत्सःप्राल्हादिस्तुविरोचनः ।\nदोग्धा त्रिमूर्द्धा तत्रासीन्माया येन प्रवर्तिता॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000254021, "chapter_id": 20254, "verse_number": "१-८-२२", "content_sanskrit": "यक्षैश्च वसुधा दुग्धा पुरांतर्द्धानमीप्सुभिः ।\nकृत्वा विश्वावसुं वत्सं मणिमंतं महीपते॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000254022, "chapter_id": 20254, "verse_number": "१-८-२३", "content_sanskrit": "प्रेतरक्षोगणैर्दुग्धा वसा रुधिरमुल्बणं ।\nरौप्यनाभोभवद्दोग्धा सुमाली वत्स एव च॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000254023, "chapter_id": 20254, "verse_number": "१-८-२४", "content_sanskrit": "गंधर्वैश्च पुनर्दुग्धा वसुधा साप्सरोगणैः ।\nवत्सं चित्ररथं कृत्वा गंधान्पद्मदले तथा॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000254024, "chapter_id": 20254, "verse_number": "१-८-२५", "content_sanskrit": "दोग्धावसुरुचिर्नामाथर्ववेदस्य पारगः ।\nगिरिभिर्वसुधा दुग्धा रत्नानि विविधानि च॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000254025, "chapter_id": 20254, "verse_number": "१-८-२६", "content_sanskrit": "औषधानि च दिव्यानि दोग्धा मेरुर्महीधरः ।\nवत्सोभूद्धिमवांस्तत्र पात्रं शैलमयं पुनः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000254026, "chapter_id": 20254, "verse_number": "१-८-२७", "content_sanskrit": "वृक्षैश्च वसुधा दुग्धा क्षीरं छिन्नप्ररोहणं ।\nपालाशपात्रे दोग्धा तु सालः पुष्पवनाकुलः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000254027, "chapter_id": 20254, "verse_number": "१-८-२८", "content_sanskrit": "प्लक्षोभवत्ततो वत्सः सर्ववृक्षवनाधिपः ।\nएवमन्यैश्च वसुधा तथा दुग्धा यथेच्छतः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000254028, "chapter_id": 20254, "verse_number": "१-८-२९", "content_sanskrit": "आयुर्द्धनानि सौख्यं च पृथौ राज्यं प्रशासति ।\nन दारिद्र्यं तथा रोगी नाधनोनचपापकृत्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000254029, "chapter_id": 20254, "verse_number": "१-८-३०", "content_sanskrit": "नोपसर्गा न चाघातः पृथौ राज्यं प्रशासति ।\nनित्यंप्रमुदितालोका दुःखशोकविवर्जिताः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000254030, "chapter_id": 20254, "verse_number": "१-८-३१", "content_sanskrit": "धनुः कोट्या च शैलेंद्रानुत्सार्य स महाबलः ।\nभूमंडलं समं चक्रे लोकानां हितकाम्यया॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000254031, "chapter_id": 20254, "verse_number": "१-८-३२", "content_sanskrit": "न पुरग्रामदुर्गाणि न चायुधधरा नराः ।\nम्रियंते यत्र दुःखं च नार्थशास्त्रस्य चादरः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000254032, "chapter_id": 20254, "verse_number": "१-८-३३", "content_sanskrit": "धर्मैकतानाः पुरुषाः पृथौ राज्यं प्रशासति ।\nकथितानि च पात्राणि यत्क्षीरं च यथा तव॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000254033, "chapter_id": 20254, "verse_number": "१-८-३४", "content_sanskrit": "येषां येन रुचिस्तत्र तेभ्यो दत्तं विजानता ।\nयज्ञश्रीदेषु सर्वेषु मया तुभ्यं निवेदितं॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000254034, "chapter_id": 20254, "verse_number": "१-८-३५", "content_sanskrit": "दुहितृत्वं गता यस्मात्पृथोः पृथ्वी महामते ।\nतस्यानुसारयोगाच्च पृथिवी विश्रुता बुधैः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000254035, "chapter_id": 20254, "verse_number": "१-८-३६", "content_sanskrit": "भीष्म उवाच ।\nआदित्यवंशमखिलं वद ब्रह्मन्यथाक्रमं ।\nसोमवंशं च तत्त्वज्ञ यथावद्वक्तुमर्हसि॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000254036, "chapter_id": 20254, "verse_number": "१-८-३७", "content_sanskrit": "पुलस्त्य उवाच ।\nविवस्वान्कश्यपात्पूर्वमदित्यामभवत्पुरा ।\nतस्य पत्नीत्रयं तद्वत्संज्ञा राज्ञी प्रभा तथा॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000254037, "chapter_id": 20254, "verse_number": "१-८-३८", "content_sanskrit": "रैवतस्य सुता राज्ञी रेवतं सुषुवे सुतं ।\nप्रभा प्रभातं सुषुवे त्वाष्ट्रं संज्ञा तथा मनुं॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000254038, "chapter_id": 20254, "verse_number": "१-८-३९", "content_sanskrit": "यमश्च यमुना चैव यमलौ च बभूवतुः ।\nततस्तेजोमयं रूपमसहंती विवस्वतः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000254039, "chapter_id": 20254, "verse_number": "१-८-४०", "content_sanskrit": "नारीमुत्पादयामास स्वशरीरादनिंदितां ।\nत्वाष्ट्री स्वरूपरूपेण नाम्ना छायेति भामिनी॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000254040, "chapter_id": 20254, "verse_number": "१-८-४१", "content_sanskrit": "किंकरोमीति पुरतः संस्थितां तामभाषत ।\nछाये त्वं भज भर्तारं मदीयं तं वरानने॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000254041, "chapter_id": 20254, "verse_number": "१-८-४२", "content_sanskrit": "अपत्यानि मदीयानि मातृस्नेहेन पालय ।\nतथेत्युक्त्वा च सा देवमगात्कामाय सुव्रता॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000254042, "chapter_id": 20254, "verse_number": "१-८-४३", "content_sanskrit": "कामयामास देवोपि संज्ञेयमिति चादरात् ।\nजनयामास सावर्णिं मनुं मनुस्वरूपिणम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000254043, "chapter_id": 20254, "verse_number": "१-८-४४", "content_sanskrit": "सवर्णत्वाच्च सावर्णेर्मनोर्वैवस्वतस्य तु ।\nततः सुतां च तपतीं त्वाष्ट्रीं चैव क्रमेण तु॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000254044, "chapter_id": 20254, "verse_number": "१-८-४५", "content_sanskrit": "छायायां जनयामास संज्ञेयमिति भास्करः ।\nछाया स्वपुत्रे त्वधिकं स्नेहं चक्रे मनौ तदा॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000254045, "chapter_id": 20254, "verse_number": "१-८-४६", "content_sanskrit": "न चक्षमे मनुः पूर्वस्तद्यमः क्रोधमूर्छितः ।\nसंतर्जयामास तदा पादमुत्क्षिप्य दक्षिणं॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000254046, "chapter_id": 20254, "verse_number": "१-८-४७", "content_sanskrit": "शशाप च यमं छाया भवतु क्रिमिसंयुतः ।\nपादोयमेको भविता पूयशोणितविस्रवः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000254047, "chapter_id": 20254, "verse_number": "१-८-४८", "content_sanskrit": "निवेदयामास पितुर्यमः शापेन धर्षितः ।\nनिःकारणमहं शप्तो मात्रा देव सकोपया॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000254048, "chapter_id": 20254, "verse_number": "१-८-४९", "content_sanskrit": "बालभावान्मया किंचिदुद्यतश्चरणः सकृत् ।\nमनुना वार्यमाणापि मम शापमदाद्विभो॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000254049, "chapter_id": 20254, "verse_number": "१-८-५०", "content_sanskrit": "प्रायो न माता सास्माकमसमा स्नेहतो यतः ।\nदेवोप्याह यमं भूयः किं करोमि महामते॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000254050, "chapter_id": 20254, "verse_number": "१-८-५१", "content_sanskrit": "सौख्यात्कस्य न दुःखं स्यादथवा कर्मसंततिः ।\nअनिवार्या भवस्यापि का कथान्येषु जंतुषु॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000254051, "chapter_id": 20254, "verse_number": "१-८-५२", "content_sanskrit": "कृकवाकुस्तव पदे स क्रिमिं भक्षयिष्यति ।\nखंजं च रुचिरं चैव पादमेतद्भविष्यति॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000254052, "chapter_id": 20254, "verse_number": "१-८-५३", "content_sanskrit": "एवमुक्तः समाश्वस्तस्तपस्तीव्रं चकार ह ।\nवैराग्यात्पुष्करे तीर्थे फलफेनानिलाशनः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000254053, "chapter_id": 20254, "verse_number": "१-८-५४", "content_sanskrit": "पितामहं समाराध्य यावद्वर्षायुतं पुनः ।\nतपःप्रभावाद्देवेशः संतुष्टः पद्मसंभवः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000254054, "chapter_id": 20254, "verse_number": "१-८-५५", "content_sanskrit": "वव्रे स लोकपालत्वं पितृलोकं तथाक्षयं ।\nधर्माधर्मात्मकस्यास्य जगतस्तु परीक्षणम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000254055, "chapter_id": 20254, "verse_number": "१-८-५६", "content_sanskrit": "एवं स लोकपालत्वमगमत्पद्मसंभवात् ।\nपितॄणामाधिपत्यं च धर्माधर्मस्य चानघ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000254056, "chapter_id": 20254, "verse_number": "१-८-५७", "content_sanskrit": "विवस्वानथ तज्ज्ञात्वा संज्ञायाः कर्मचेष्टितं ।\nत्वष्टुः समीपमगमदाचचक्षे सरोषवान्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000254057, "chapter_id": 20254, "verse_number": "१-८-५८", "content_sanskrit": "तमुवाच ततस्त्वष्टा सांत्वपूर्वमिदं वचः ।\nतवासहंती भगवंस्तेजस्तीव्रं तमोनुद॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000254058, "chapter_id": 20254, "verse_number": "१-८-५९", "content_sanskrit": "बडवारूपमास्थाय मत्सकाशमिहागता ।\nनिवारिता मया सा च त्वद्भयेन दिवस्पते॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000254059, "chapter_id": 20254, "verse_number": "१-८-६०", "content_sanskrit": "यस्मादविज्ञातमना मत्सकाशमिहागता ।\nतस्मान्मदीयं भवनं प्रवेष्टुं न तवार्हति॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000254060, "chapter_id": 20254, "verse_number": "१-८-६१", "content_sanskrit": "एवमुक्ता जगामाशु मरुदेशमनिंदिता ।\nबडवारूपमास्थाय भूतले संप्रतिष्ठिता॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000254061, "chapter_id": 20254, "verse_number": "१-८-६२", "content_sanskrit": "तस्मात्प्रसादं कुरु मे यद्यनुग्रहभागहम् ।\nअपनेष्यामि ते तेजः कृत्वा यंत्रे दिवाकरम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000254062, "chapter_id": 20254, "verse_number": "१-८-६३", "content_sanskrit": "रूपं तव करिष्यामि लोकानंदकरं प्रभो ।\nतथेत्युक्तः स रविणा भ्रमे कृत्वा दिवाकरं॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000254063, "chapter_id": 20254, "verse_number": "१-८-६४", "content_sanskrit": "पृथक्चकार तेजश्च चक्रं विष्णोः प्रकल्पयत् ।\nत्रिशूलं चापि रुद्रस्य वज्रमिंद्रस्य चापरं॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000254064, "chapter_id": 20254, "verse_number": "१-८-६५", "content_sanskrit": "दैत्यदानवसंहर्तृ सहस्रकिरणात्मकं ।\nरूपं चाप्रतिमं चक्रे त्वष्टा पद्भ्यामृते महत्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000254065, "chapter_id": 20254, "verse_number": "१-८-६६", "content_sanskrit": "न शशाक च तद्द्रष्टुं पादरूपं रवेः पुनः ।\nअद्यापि च ततः पादौ न कश्चित्कारयेत्क्वचित्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000254066, "chapter_id": 20254, "verse_number": "१-८-६७", "content_sanskrit": "यः करोति स पापिष्ठो गतिमाप्नोति निंदितां ।\nकुष्ठरोगमवाप्नोति लोकेस्मिन्दुःखसंज्ञितं॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000254067, "chapter_id": 20254, "verse_number": "१-८-६८", "content_sanskrit": "तस्मान्न धर्मकामार्थी चित्रेष्वायतनेषु च ।\nन क्वचित्कारयेत्पादौ देवदेवस्य धीमतः॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000254068, "chapter_id": 20254, "verse_number": "१-८-६९", "content_sanskrit": "ततः स भगवान्गत्वा भूर्लोकममराधिपः ।\nकामयामास कामार्तो मुख एव दिवाकरः॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000254069, "chapter_id": 20254, "verse_number": "१-८-७०", "content_sanskrit": "अश्वरूपेण महता तेजसा च समन्वितः ।\nसंज्ञा च मनसा क्षोभमगमद्भयविह्वला॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000254070, "chapter_id": 20254, "verse_number": "१-८-७१", "content_sanskrit": "नासापुटाभ्यामुत्सृष्टं परोयमिति शंकया ।\nतस्याथ रेतसो जातावश्विनाविति नः श्रुतम्॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000254071, "chapter_id": 20254, "verse_number": "१-८-७२", "content_sanskrit": "दस्रौ श्रुतित्वात्संजातौ नासत्यौ नासिकाग्रतः ।\nज्ञात्वा चिराच्च तं देवं संतोषमगमत्परं॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000254072, "chapter_id": 20254, "verse_number": "१-८-७३", "content_sanskrit": "विमानेनागमत्स्वर्गे पत्न्या सह मुदान्वितः ।\nसावर्ण्योपि मनुर्मेरावद्यापि तपते तपः॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000254073, "chapter_id": 20254, "verse_number": "१-८-७४", "content_sanskrit": "शनिस्तपोबलाच्चापि ग्रहाणां समतां गतः ।\nयमुना तपती चैव पुनर्नद्यौ बभूवतुः॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000254074, "chapter_id": 20254, "verse_number": "१-८-७५", "content_sanskrit": "विष्ठिर्घोरात्मिका तद्वत्कालत्वेन व्यवस्थिता ।\nमनोर्वैवस्वतस्यापि दश पुत्रा महाबलाः॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000254075, "chapter_id": 20254, "verse_number": "१-८-७६", "content_sanskrit": "इलस्तु प्रथमस्तेषां पुत्रेष्ट्या समकल्पि यः ।\nइक्ष्वाकुः कुशनाभश्च अरिष्टो धृष्ट एव च॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000254076, "chapter_id": 20254, "verse_number": "१-८-७७", "content_sanskrit": "नरिष्यंतः करूषश्च शर्यातिश्च महाबलः ।\nपृषध्रश्चाथ नाभागः सर्वे ते दिव्यमानुषाः॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000254077, "chapter_id": 20254, "verse_number": "१-८-७८", "content_sanskrit": "अभिषिच्य मनुः पूर्वमिलं पुत्रं स धार्मिकम् ।\nजगाम तपसे भूयः पुष्करं स तपोवनं॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000254078, "chapter_id": 20254, "verse_number": "१-८-७९", "content_sanskrit": "अथाजगाम सिध्यर्थं तस्य ब्रह्मा वरप्रदः ।\nवरं वरय भद्रं ते मानवेय यथेप्सितं॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000254079, "chapter_id": 20254, "verse_number": "१-८-८०", "content_sanskrit": "उवाच स तदा देवं पद्माक्षं पद्मजं विभुं ।\nवंशे मे धर्मसंयुक्ताः पृथिव्यां सर्वपार्थिवाः॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000254080, "chapter_id": 20254, "verse_number": "१-८-८१", "content_sanskrit": "भवेयुरीश्वराः स्वामिन्प्रसादात्तव कंजज ।\nतथेत्युक्त्वा तु देवेशस्तत्रैवांतरधीयत॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000254081, "chapter_id": 20254, "verse_number": "१-८-८२", "content_sanskrit": "ततोयोध्यां समागत्य समतिष्ठद्यथा पुरा ।\nअथैकदा रथारूढ इलो निज सुतो मनोः॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000254082, "chapter_id": 20254, "verse_number": "१-८-८३", "content_sanskrit": "निर्जगामार्थसिध्यर्थमिनप्रायां महीमिमां ।\nभ्रमन्द्वीपानि सर्वाणि क्ष्माभृतः संप्रसाधयन्॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000254083, "chapter_id": 20254, "verse_number": "१-८-८४", "content_sanskrit": "जगामोपवनं शंभोरथाकृष्टः प्रतापवान् ।\nकल्पद्रुमलताकीर्णं नाम्ना शरवणं महत्॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000254084, "chapter_id": 20254, "verse_number": "१-८-८५", "content_sanskrit": "रमते यत्र देवेशः सोमः सोमार्द्धशेखरः ।\nउमया समयस्तत्र पुरा शरवणे कृतः॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000254085, "chapter_id": 20254, "verse_number": "१-८-८६", "content_sanskrit": "पुंनामसंज्ञं यत्किंचिदागमिष्यति नो वनं ।\nस्त्रीत्वमेष्यति तत्सर्वं दशयोजनमंडले॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000254086, "chapter_id": 20254, "verse_number": "१-८-८७", "content_sanskrit": "अज्ञातसमयो राजा इलः शरवणं गतः ।\nस्त्रीत्वं जगाम सहसा बडवाश्वोऽभवत्क्षणात्॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000254087, "chapter_id": 20254, "verse_number": "१-८-८८", "content_sanskrit": "पुरुषत्वे कृतं सर्वं स्त्रीकाये विस्मृतं ततः ।\nइलेति साभवन्नारी पीनोन्नतघनस्तनी॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000254088, "chapter_id": 20254, "verse_number": "१-८-८९", "content_sanskrit": "उन्नतश्रोणिजघना पद्मपत्रायतेक्षणा ।\nपूर्णेन्दुवदना तन्वी विलासिन्यसितेक्षणा॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000254089, "chapter_id": 20254, "verse_number": "१-८-९०", "content_sanskrit": "पीनोन्नतायतभुजा नीलकुंचितमूर्द्धजा ।\nतनुलोमा सुवदना मृदुगद्गदभाषिणी॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000254090, "chapter_id": 20254, "verse_number": "१-८-९१", "content_sanskrit": "श्यामागौरेण वर्णेन तनुताम्रनखांकुरा ।\nकार्मुकभ्रूयुगोपेता हंसावरणगामिनी॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000254091, "chapter_id": 20254, "verse_number": "१-८-९२", "content_sanskrit": "भ्रममाणा वने तस्मिन्चिंतयामास भामिनी ।\nको मे पिता वा भ्राता वा को मे त्राता भवेदिह॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000254092, "chapter_id": 20254, "verse_number": "१-८-९३", "content_sanskrit": "कस्य भर्त्तुरहं दत्ता कियद्वर्षास्मि भूतले ।\nचिंतयंती च ददृशे सोमपुत्रेण साङ्गना॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000254093, "chapter_id": 20254, "verse_number": "१-८-९४", "content_sanskrit": "इलारूप समाक्षिप्त मनसा वरवर्णिनी ।\nबुधस्तदाप्तये यत्नमकरोत्कामपीडितः॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000254094, "chapter_id": 20254, "verse_number": "१-८-९५", "content_sanskrit": "विशिष्टाकारवान्मुंडी स कमंडलुपुस्तकः ।\nवेणुदंडकृतावेशः पवित्रक खनित्रकः॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000254095, "chapter_id": 20254, "verse_number": "१-८-९६", "content_sanskrit": "द्विजरूपः शिखी ब्रह्म निगदन्कर्णकुंडली ।\nवटुभिश्चार्थिभिर्युक्तः समित्पुष्पकुशोदकैः॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000254096, "chapter_id": 20254, "verse_number": "१-८-९७", "content_sanskrit": "कालेन्विष्यां ततस्तस्मिन्नाजुहाव स तामिलाम् ।\nबहिर्वनस्यांतरितः किल पादपमंडपे॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000254097, "chapter_id": 20254, "verse_number": "१-८-९८", "content_sanskrit": "ससंभ्रममकस्माच्च सोपालंभमिवाभवत् ।\nत्यक्त्वाग्निहोत्रशुश्रूषां क्व गता मंदिरान्मम॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000254098, "chapter_id": 20254, "verse_number": "१-८-९९", "content_sanskrit": "इयं विहारवेला ते अतिक्रामति सांप्रतम् ।\nएह्येहि पृथुसुश्रोणि संभ्रांता केन हेतुना॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000254099, "chapter_id": 20254, "verse_number": "१-८-१००", "content_sanskrit": "इयं सायंतनी वेला विहारस्येह वर्त्तते ।\nकृत्वोपलेपनं पुष्पैरलंकुरु गृहं मम॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000254100, "chapter_id": 20254, "verse_number": "१-८-१०१", "content_sanskrit": "साब्रवीद्विस्मृताहं च सर्वमेव तपोधन ।\nआत्मानं त्वां च भर्त्तारं कुलं च वद मेनघ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000254101, "chapter_id": 20254, "verse_number": "१-८-१०२", "content_sanskrit": "बुधः प्रोवाच तां तन्वीमिला त्वं वरवर्णिनी ।\nअहं च कामुको नाम बहुविद्यो बुधः स्मृतः॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000254102, "chapter_id": 20254, "verse_number": "१-८-१०३", "content_sanskrit": "तेजस्विनः कुले जातः पिता मे ब्राह्मणाधिपः ।\nइति सा तस्यवचनात्प्रविष्टा बुधमंदिरम्॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000254103, "chapter_id": 20254, "verse_number": "१-८-१०४", "content_sanskrit": "रत्नस्तंभसमाकीर्णं दिव्यमायाविनिर्मितम् ।\nइला कृतार्थमात्मानं मेने तद्भवने स्थिता॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000254104, "chapter_id": 20254, "verse_number": "१-८-१०५", "content_sanskrit": "अहो वृत्तमहोरूपमहो धनमहोकुलम् ।\nमम चास्य च भर्त्तुर्वा अहो लावण्यमुत्तमम्॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000254105, "chapter_id": 20254, "verse_number": "१-८-१०६", "content_sanskrit": "रेमे च सा तेन सममतिकालमिला वने ।\nसर्वभोगमये गेहे यथेंद्रभवने तथा॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000254106, "chapter_id": 20254, "verse_number": "१-८-१०७", "content_sanskrit": "अथान्विष्यंतो राजानं भ्रातरस्तस्य मानवाः ।\nइक्ष्वाकुप्रमुखा जग्मुस्तदा शरवणांतिकम्॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000254107, "chapter_id": 20254, "verse_number": "१-८-१०८", "content_sanskrit": "ततस्ते ददृशुः सर्वे वडवामग्रतः स्थिताम् ।\nरत्नपर्यंतकिरणदीप्यमानामनुत्तमाम्॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000254108, "chapter_id": 20254, "verse_number": "१-८-१०९", "content_sanskrit": "संप्राप्य प्रत्यभिज्ञानात्सर्वे विस्मयमागताः ।\nअयं चंद्रप्रभो नाम वाजी तस्य महात्मनः॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000254109, "chapter_id": 20254, "verse_number": "१-८-११०", "content_sanskrit": "अगमद्वडवारूपमुत्तमं केन हेतुना ।\nततस्तु मैत्रावरुणिं पप्रच्छुः स्वपुरोहितम्॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000254110, "chapter_id": 20254, "verse_number": "१-८-१११", "content_sanskrit": "किमेतदित्यभूच्चित्रं वद योगविदां वर ।\nवसिष्ठोप्यब्रवीत्सर्वं दृष्ट्वा तं ध्यानचक्षुषा॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000254111, "chapter_id": 20254, "verse_number": "१-८-११२", "content_sanskrit": "समयः शंभुदयिता कृतः शरवणे पुरा ।\nयः पुमान्प्रविशेच्चात्र स नारीत्वमवाप्स्यति॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000254112, "chapter_id": 20254, "verse_number": "१-८-११३", "content_sanskrit": "अयमश्वोपि नारीत्वमगाद्राज्ञा सहैव तु ।\nइलः पुरुषतामेति यथासौ धनदोपमः॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000254113, "chapter_id": 20254, "verse_number": "१-८-११४", "content_sanskrit": "तथैव यत्नः कर्त्तव्य आराध्य च पिनाकिनम् ।\nततस्ते मानवा जग्मुर्यत्र देवो महेश्वरः॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000254114, "chapter_id": 20254, "verse_number": "१-८-११५", "content_sanskrit": "तुष्टवुर्विविधैः स्तोत्रैः पार्वतीपरमेश्वरौ ।\nतावूचतुरलं चैष समयः किं नु सांप्रतं॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000254115, "chapter_id": 20254, "verse_number": "१-८-११६", "content_sanskrit": "इक्ष्वाकोरश्वमेधेन यत्फलं स्यात्तदावयोः ।\nदत्वा किंपुरुषो वीरः स भविष्यत्यसंशयम्॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000254116, "chapter_id": 20254, "verse_number": "१-८-११७", "content_sanskrit": "तथेत्युक्त्वा तु ते सर्वे जग्मुर्वैवस्वतात्मजाः ।\nइष्ट्वाश्वमेधेन तत इला किंपुरुषोभवत्॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000254117, "chapter_id": 20254, "verse_number": "१-८-११८", "content_sanskrit": "मासमेकं पुमान्वीरः स्त्रीत्वं मासमभूत्पुनः ।\nबुधस्य भवने तिष्ठन्निलो गर्भधरोभवत्॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000254118, "chapter_id": 20254, "verse_number": "१-८-११९", "content_sanskrit": "अजीजनत्पुत्रमेकमनेकगुणसंयुतम् ।\nबुध उत्पाद्य तं पूरुं स स्वर्गमगमत्पुनः॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000254119, "chapter_id": 20254, "verse_number": "१-८-१२०", "content_sanskrit": "इलस्य नाम्ना तद्वर्षमिलावृतमभूत्तदा ।\nसोमार्कवंशजो राजा इलोभूद्वंशवर्द्धनः॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000254120, "chapter_id": 20254, "verse_number": "१-८-१२१", "content_sanskrit": "एवं पुरूरवाः पूरोरभवद्वंशवर्द्धनः ।\nइक्ष्वाकुरर्कवंशस्य तथैवोक्तो नरेश्वरः॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000254121, "chapter_id": 20254, "verse_number": "१-८-१२२", "content_sanskrit": "इलः किंपुरुषत्वे च सुद्युम्न इति चोच्यते ।\nपुनः पुत्रत्रयमभूत्सुद्युम्नस्यापराजितम्॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000254122, "chapter_id": 20254, "verse_number": "१-८-१२३", "content_sanskrit": "उत्कलोथ गयस्तद्वद्धरिताश्वश्च वीर्यवान् ।\nउत्कलस्योत्कला नाम गयस्य तु गयापुरी॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000254123, "chapter_id": 20254, "verse_number": "१-८-१२४", "content_sanskrit": "हरिताश्वस्य दिग्याम्या संज्ञाता कुरुभिः सह ।\nप्रतिष्ठानेभिषिच्याथ स पुरूरवसं सुतम्॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000254124, "chapter_id": 20254, "verse_number": "१-८-१२५", "content_sanskrit": "जगामेलावृतं भोक्तुं दिव्यं वर्षं फलाशनः ।\nइक्ष्वाकुर्ज्येष्ठदायादो मध्यदेशमवाप्तवान्॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000254125, "chapter_id": 20254, "verse_number": "१-८-१२६", "content_sanskrit": "नरिष्यंतस्य पुत्रोभूच्छुको नाम महाबलः ।\nनाभागादंबरीषस्तु धृष्टस्य तु सुतत्रयम्॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000254126, "chapter_id": 20254, "verse_number": "१-८-१२७", "content_sanskrit": "धृष्टकेतुः स्वधर्माथो रणधृष्टश्च वीर्यवान् ।\nआनर्तो नाम शर्यातेः सुकन्या चैव दारिका॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7000254127, "chapter_id": 20254, "verse_number": "१-८-१२८", "content_sanskrit": "आनर्तस्याभवत्पुत्रो रोचमानः प्रतापवान् ।\nआनर्तो नाम देशोभून्नगरी च कुशस्थली॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7000254128, "chapter_id": 20254, "verse_number": "१-८-१२९", "content_sanskrit": "रोचमानस्य रेवोभूद्रेवाद्रैवत एव च ।\nककुद्मी चापरं नाम ज्येष्ठः पुत्रशतस्य च॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7000254129, "chapter_id": 20254, "verse_number": "१-८-१३०", "content_sanskrit": "रेवती तस्य सा कन्या भार्या रामस्य विश्रुता ।\nकरूषाच्चैव कारूषा बहवः प्रथिता भुवि॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7000254130, "chapter_id": 20254, "verse_number": "१-८-१३१", "content_sanskrit": "पृषध्रो गोवधाच्छूद्रो गुरुशापादजायत ।\nइक्ष्वाकुपुत्रा नाम्नाथ विकुक्षि निमिदंडकाः॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7000254131, "chapter_id": 20254, "verse_number": "१-८-१३२", "content_sanskrit": "श्रेष्ठाः पुत्रशतस्यासन्पंचाशच्चाथ तत्सुताः ।\nमेरोरुत्तरतस्ते तु जाताः पार्थिवसत्तमाः॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7000254132, "chapter_id": 20254, "verse_number": "१-८-१३३", "content_sanskrit": "चत्वारिंशत्तथाष्टान्ये शतमध्ये च येभवन् ।\nमेरोर्दक्षिणतश्चैव राजानस्ते प्रकीर्तिताः॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7000254133, "chapter_id": 20254, "verse_number": "१-८-१३४", "content_sanskrit": "ज्येष्ठात्ककुत्स्थनामाभूत्सुतस्तस्य सुयोधनः ।\nतस्य पुत्रः पृथृर्नाम विश्वस्तस्य पृथोः सुतः॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7000254134, "chapter_id": 20254, "verse_number": "१-८-१३५", "content_sanskrit": "आर्द्रस्तस्य च पुत्रोभूद्युवनाश्वस्ततोभवत् ।\nयुवनाश्वस्य पुत्रोभूच्छावस्तो नाम वीर्यवान्॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7000254135, "chapter_id": 20254, "verse_number": "१-८-१३६", "content_sanskrit": "निर्मिता येन शावस्ती ह्यंगदेशे नराधिप ।\nशावस्ताद्बृहदश्वो भूत्कुवलाश्वस्ततोभवत्॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7000254136, "chapter_id": 20254, "verse_number": "१-८-१३७", "content_sanskrit": "धुंधुमारत्वमगमद्धुंधुं हत्वाऽसुरं पुरा ।\nतस्य पुत्रास्त्रयो जाता दृढाश्वो घृणिरेव च॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7000254137, "chapter_id": 20254, "verse_number": "१-८-१३८", "content_sanskrit": "कपिलाश्वश्च विख्यातो धौंधुमारिः प्रतापवान् ।\nदृढाश्वस्य प्रमोदस्तु हर्यश्वस्तस्य चात्मजः॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7000254138, "chapter_id": 20254, "verse_number": "१-८-१३९", "content_sanskrit": "हर्यश्वस्य निकुंभोभूत्संहताश्वस्ततोभवत् ।\nअकृताश्वो रणाश्वश्च संहताश्व सुतावुभौ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7000254139, "chapter_id": 20254, "verse_number": "१-८-१४०", "content_sanskrit": "युवनाश्वो रणाश्वस्य मांधाता च ततोभवत् ।\nमांधातुः पुरुकुत्सोभूद्धर्मसेतुश्च पार्थिवः॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7000254140, "chapter_id": 20254, "verse_number": "१-८-१४१", "content_sanskrit": "मुचुकुन्दश्च विख्यातश्शक्रमित्रः प्रतापवान् ।\nपुरुकुत्सस्य पुत्रोभूद्दुस्सहो नर्मदापतिः॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7000254141, "chapter_id": 20254, "verse_number": "१-८-१४२", "content_sanskrit": "संभूतिस्तस्य पुत्रोभूत्त्रिधन्वा च ततोभवत् ।\nत्रिधन्वनः सुतो जातस्त्रय्यारुण इति स्मृतः॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7000254142, "chapter_id": 20254, "verse_number": "१-८-१४३", "content_sanskrit": "तस्य सत्यव्रतो नाम तस्मात्सत्यरथः स्मृतः ।\nतस्य पुत्रो हरिश्चन्द्रो हरिश्चंद्राच्च रोहितः॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7000254143, "chapter_id": 20254, "verse_number": "१-८-१४४", "content_sanskrit": "रोहताच्च वृको जातो वृकाद्बाहुरजायत ।\nसगरस्तस्य पुत्रोभूद्राजा परमधार्मिकः॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7000254144, "chapter_id": 20254, "verse_number": "१-८-१४५", "content_sanskrit": "द्वे भार्ये सगरस्यापि प्रभा भानुमती तथा ।\nताभ्यामाराधितः पूर्वमौर्वाग्निः पुत्रकाम्यया॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7000254145, "chapter_id": 20254, "verse_number": "१-८-१४६", "content_sanskrit": "और्वस्तुष्टस्तयोः प्रादाद्यथेष्टं वरमुत्तमम् ।\nएका षष्टिसहस्राणि सुतमेकं तथापरा॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7000254146, "chapter_id": 20254, "verse_number": "१-८-१४७", "content_sanskrit": "अगृह्णाद्वंशकर्तारं प्रभाऽगृह्णाद्बहून्सुतान् ।\nएकं भानुमती पुत्रमगृह्णादसमंजसं॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7000254147, "chapter_id": 20254, "verse_number": "१-८-१४८", "content_sanskrit": "ततः षष्टिसहस्राणि सुषुवे यादवी प्रभा ।\nखनंतः पृथिवीं दग्धा विष्णुना ये ऽश्वमार्गणे॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7000254148, "chapter_id": 20254, "verse_number": "१-८-१४९", "content_sanskrit": "असमंजस्तु तनयो ह्यंशुमान्नाम विश्रुतः ।\nतस्य पुत्रो दिलीपस्तु दिलीपात्तु भगीरथः॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7000254149, "chapter_id": 20254, "verse_number": "१-८-१५०", "content_sanskrit": "येन भागीरथी गङ्गा तपः कृत्वावतारिता ।\nभगीरथस्य तनयो नाभाग इति विश्रुतः॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7000254150, "chapter_id": 20254, "verse_number": "१-८-१५१", "content_sanskrit": "नाभागस्यांबरीषोभूत्सिंधुद्वीपस्ततोभवत् ।\nतस्यायुतायुः पुत्रोभूदृतुपर्णस्ततोभवत्॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7000254151, "chapter_id": 20254, "verse_number": "१-८-१५२", "content_sanskrit": "तस्य कल्माषपादस्तु सर्वकर्मा ततः स्मृतः ।\nतस्यानरण्यः पुत्रोभून्निघ्नस्तस्य सुतोभवत्॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7000254152, "chapter_id": 20254, "verse_number": "१-८-१५३", "content_sanskrit": "निघ्नपुत्रावुभौ जातावनमित्र रघूत्तमौ ।\nअनमित्रो वनमगादरिनाशकृते नृप॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 7000254153, "chapter_id": 20254, "verse_number": "१-८-१५४", "content_sanskrit": "रघोरभूद्दिलीपस्तु दिलीपाच्चाप्यजस्तथा ।\nदीर्घबाहुरजाज्जातः प्रजापालस्ततोभवत्॥१५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 7000254154, "chapter_id": 20254, "verse_number": "१-८-१५५", "content_sanskrit": "ततो दशरथो जातस्तस्य पुत्रचतुष्टयं ।\nनारायणात्मकाः सर्वे रामस्तस्याग्रजोभवत्॥१५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 7000254155, "chapter_id": 20254, "verse_number": "१-८-१५६", "content_sanskrit": "रावणांतकरस्तद्वद्रघूणां वंशवर्द्धनः ।\nवाल्मीकिर्यस्य चरितं चक्रे भार्गवसत्तमः॥१५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 7000254156, "chapter_id": 20254, "verse_number": "१-८-१५७", "content_sanskrit": "तस्य पुत्रः कुशो नाम इक्ष्वाकुकुलवर्द्धनः ।\nअतिथिस्तु कुशाज्जातो निषधस्तस्य चात्मजः॥१५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 7000254157, "chapter_id": 20254, "verse_number": "१-८-१५८", "content_sanskrit": "नलस्तु निषधाज्जातो नभास्तस्मादजायत ।\nनभसः पुंडरीकोभूत्क्षेमधन्वा ततः परम्॥१५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 7000254158, "chapter_id": 20254, "verse_number": "१-८-१५९", "content_sanskrit": "तस्यपुत्रोभवद्वीरो देवानीकः प्रतापवान् ।\nअहीनगुस्तस्य सुतः सहस्राश्वस्ततः परः॥१५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 7000254159, "chapter_id": 20254, "verse_number": "१-८-१६०", "content_sanskrit": "ततश्चंद्रावलोकस्तु तारापीडस्ततोभवत् ।\nतस्यात्मजश्चन्द्रगिरिश्चंद्रस्तस्य सुतोभवत्॥१६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}, {"id": 7000254160, "chapter_id": 20254, "verse_number": "१-८-१६१", "content_sanskrit": "श्रुतायुरभवत्तस्माद्भारते यो निपातितः ।\nनलौ द्वावेव विख्यातौ वंशे यस्य विशेषतः॥१६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 161}, {"id": 7000254161, "chapter_id": 20254, "verse_number": "१-८-१६२", "content_sanskrit": "वीरसेनसुतस्तद्वन्नैषधश्च नराधिपः ।\nएते विवस्वतो वंशे राजानो भूरिदक्षिणाः॥१६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 162}, {"id": 7000254162, "chapter_id": 20254, "verse_number": "१-८-१६३", "content_sanskrit": "इक्ष्वाकुवंशप्रभवाः प्राधान्येन प्रकीर्तिताः॥१६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 163}]