[{"id": 7004774000, "chapter_id": 24774, "verse_number": "६-२३६-१", "content_sanskrit": "ब्रह्मोवाच ।\nइष्टवस्तुप्रदो विष्णुर्लोकश्चेष्टरुचिः सदा ।\nतस्मात्सर्वप्रयत्नेन चातुमास्ये त्यजेच्च तत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004774001, "chapter_id": 24774, "verse_number": "६-२३६-२", "content_sanskrit": "नारायणस्य प्रीत्यर्थं तदेवाक्षय्यमाप्यते ।\nमर्त्यस्त्यजति श्रद्धावान्सोऽनंतफलभाग्भवेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004774002, "chapter_id": 24774, "verse_number": "६-२३६-३", "content_sanskrit": "कांस्यभाजनसंत्यागाज्जायते भूपतिर्भुवि ।\nपालाशपत्रे भुञ्जानो ब्रह्मभूयस्त्वमश्नुते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004774003, "chapter_id": 24774, "verse_number": "६-२३६-४", "content_sanskrit": "ताम्रपात्रे न भुञ्जीत कदाचिद्वा गृही नरः ।\nचातुर्मास्ये विशेषेण ताम्रपात्रं विवर्जयेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004774004, "chapter_id": 24774, "verse_number": "६-२३६-५", "content_sanskrit": "अर्कपत्रेषु भुञ्जानोऽनुपमं लभते फलम् ।\nवटपत्रेषु भोक्तव्यं चातुर्मास्ये विशेषतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004774005, "chapter_id": 24774, "verse_number": "६-२३६-६", "content_sanskrit": "अश्वत्थपत्रसंभोगः कार्यो बुधजनैः सदा ।\nएकान्नभोजी राजा स्यात्सकलं भूमिमण्डले ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004774006, "chapter_id": 24774, "verse_number": "६-२३६-७", "content_sanskrit": "तथा च लवणत्यागात्सुभगो जायते नरः ।\nगोधूमान्नपरित्यागाज्जायते जनवलभः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004774007, "chapter_id": 24774, "verse_number": "६-२३६-८", "content_sanskrit": "अशाकभोजी दीर्घायुश्चातुर्मास्येऽभिजायते ।\nरसत्यागान्महाप्राणी मधुत्यागात्सुलोचनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004774008, "chapter_id": 24774, "verse_number": "६-२३६-९", "content_sanskrit": "मुद्गत्यागाद्रिपुमृती राजमाषाद्धनाढ्यता ।\nअश्वाप्तिस्तंडुलत्यागाच्चातुर्मास्येऽभिजायते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004774009, "chapter_id": 24774, "verse_number": "६-२३६-१०", "content_sanskrit": "फलत्यागाद्बहुसुतस्तैलत्यागात्सुरूपिता ।\nज्ञानी तुवरिसंत्यागाद्बलं वीर्यं सदैव हि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004774010, "chapter_id": 24774, "verse_number": "६-२३६-११", "content_sanskrit": "मार्गमांसपरित्यागान्नरकं न च पश्यति ।\nशौकरस्य पीरत्यागाद्ब्रह्मवासमवाप्नुयात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004774011, "chapter_id": 24774, "verse_number": "६-२३६-१२", "content_sanskrit": "ज्ञानं लावकसन्त्यागादाज्यत्यागे महत्सुखम् ।\nआसवं सम्परित्यज्य मुक्तिस्तस्य न दुर्लभा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004774012, "chapter_id": 24774, "verse_number": "६-२३६-१३", "content_sanskrit": "सबलः कनकत्यागाद्रूप्यत्यागेन मानुषः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004774013, "chapter_id": 24774, "verse_number": "६-२३६-१४", "content_sanskrit": "दधिदुग्धपरित्यागी गोलोके सुख भाग्भवेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004774014, "chapter_id": 24774, "verse_number": "६-२३६-१५", "content_sanskrit": "ब्रह्मा पायससंत्यागात्क्षिप्रात्यागान्महेश्वरः ।\nकन्दर्पोऽपूपसंत्यागान्मोदकत्याजकः सुखी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004774015, "chapter_id": 24774, "verse_number": "६-२३६-१६", "content_sanskrit": "गृहाश्रमपरित्यागी बाह्या श्रमनिषेवकः ।\nचातुर्मास्यं हरिप्रीत्यै न मातुर्जठरे शिशुः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004774016, "chapter_id": 24774, "verse_number": "६-२३६-१७", "content_sanskrit": "नृपो मरीचसंत्यागाच्छुण्ठीत्यागेन सत्कविः ।\nशर्करायाः परित्यागाज्जायते राजपूजितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004774017, "chapter_id": 24774, "verse_number": "६-२३६-१८", "content_sanskrit": "गुडत्यागान्महाभूतिस्तथा दाडिमवर्जनात् ।\nरक्तवस्त्रपरित्यागाज्जायते जनवल्लभः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004774018, "chapter_id": 24774, "verse_number": "६-२३६-१९", "content_sanskrit": "पट्टकूलपरित्यागादक्षय्यं स्वर्ग माप्नुयात् ।\nमाषान्नचणकान्नस्य त्यागान्नैव पुनर्भवः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004774019, "chapter_id": 24774, "verse_number": "६-२३६-२०", "content_sanskrit": "कृष्णवस्त्रं सदा त्याज्यं चातुर्मास्ये विशेषतः ।\nसूर्यसंदर्शनाच्छुद्धिर्नीलवस्त्रस्य दर्शनात् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004774020, "chapter_id": 24774, "verse_number": "६-२३६-२१", "content_sanskrit": "चंदनस्य परित्यागाद्गांधर्वं लोकमश्नुते ।\nकर्पूरस्य परित्यागाद्यावज्जीवं महाधनी ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004774021, "chapter_id": 24774, "verse_number": "६-२३६-२२", "content_sanskrit": "कुसुम्भस्य परित्यागान्नैव पश्येद्यमाल यम् ।\nकेशरस्य परित्यागान्मनुष्यो राजवल्लभः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004774022, "chapter_id": 24774, "verse_number": "६-२३६-२३", "content_sanskrit": "यक्षकर्दमसंत्यागाद्ब्रह्मलोके महीयते ।\nज्ञानी पुष्पपरित्यागाच्छय्यात्यागे महत्सु खम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004774023, "chapter_id": 24774, "verse_number": "६-२३६-२४", "content_sanskrit": "भार्यावियोगं नाप्नोति चातुर्मास्ये न संशयः ।\nअलीकवादसंत्यागान्मोक्षद्वारमपावृतम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004774024, "chapter_id": 24774, "verse_number": "६-२३६-२५", "content_sanskrit": "परमर्मप्रकाशश्च सद्यःपापसमा गमः ।\nचातुर्मास्ये हरौ सुप्ते परनिन्दां विवर्जयेत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004774025, "chapter_id": 24774, "verse_number": "६-२३६-२६", "content_sanskrit": "परनिन्दा महापापं परनिन्दा महाभयम् ।\nपरनिन्दा महद्दुःखं न तस्यां पातकं परम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004774026, "chapter_id": 24774, "verse_number": "६-२३६-२७", "content_sanskrit": "केवलं निन्दने चैव तत्पापं लभते गुरु ।\nयथा शृण्वान एव स्यात्पातकी न ततः परः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004774027, "chapter_id": 24774, "verse_number": "६-२३६-२८", "content_sanskrit": "केशसंस्कारसंत्यागात्तापत्रयविवर्जितः ।\nनखरोमधरो यस्तु हरौ सुप्ते विशेषतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004774028, "chapter_id": 24774, "verse_number": "६-२३६-२९", "content_sanskrit": "दिवसेदिवसे तस्य गंगास्नानफलं भवेत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004774029, "chapter_id": 24774, "verse_number": "६-२३६-३०", "content_sanskrit": "सर्वोपायैर्विष्णुरेव प्रसाद्यो योगिध्येयः प्रवरैः सर्ववर्णेः ।\nविष्णोर्नाम्ना मुच्यते घोरबन्धाच्चातुर्मास्ये स्मर्यतेऽसौ विशेषात् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004774030, "chapter_id": 24774, "verse_number": "६-२३६-३१", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहिता यां षष्ठे नागरखण्डे हाटकेश्वरक्षेत्रमाहात्म्ये शेषशाय्युपाख्याने चातुर्मास्यमाहात्म्ये ब्रह्मनारदसंवाद इष्टवस्तुपरित्यागमहिमवर्णनंनाम षट्त्रिंशदुत्तरद्वि शततमोऽध्यायः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]