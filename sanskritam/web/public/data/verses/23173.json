[{"id": 7003173000, "chapter_id": 23173, "verse_number": "४-१०९-१", "content_sanskrit": "नारायण उवाच ।\nएतस्मिन्नन्तरे राज्ञी रुक्मिणीजननी शभा ।\nपतिपुत्रवतीभिश्च साध्वीभिः सहिता मुदा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003173001, "chapter_id": 23173, "verse_number": "४-१०९-२", "content_sanskrit": "आगत्य मङ्गलं कृत्वा तत्र निर्मञ्छनादिकम् ।\nदंपती वेशयामास रत्ननिर्माणमन्दिरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003173002, "chapter_id": 23173, "verse_number": "४-१०९-३", "content_sanskrit": "नानाचित्रविचित्राढ्यं हीरहारेण भूषितम् ।\nमुक्तामाणिक्यरत्नेन मुदीप्तं दर्पणेन च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003173003, "chapter_id": 23173, "verse_number": "४-१०९-४", "content_sanskrit": "ददर्श कृष्णस्तत्रैव दुर्गां दुर्गतिनाशिनीम् ।\nसरस्वतीं च सावित्रीं रतिं च रोहिणीं सतीम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003173004, "chapter_id": 23173, "verse_number": "४-१०९-५", "content_sanskrit": "देवपत्नीं राजपत्नीं मुनिपत्नीं पतिव्रताम् ।\nरत्नमिहानस्थां च रत्नभूषणभूषिताम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003173005, "chapter_id": 23173, "verse_number": "४-१०९-६", "content_sanskrit": "उत्तस्थुराराद्दृष्ट्वा च श्रीकृष्णं जगतीपतिम् ।\nरत्नसिहासने रम्ये वारयामास तां मुदा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003173006, "chapter_id": 23173, "verse_number": "४-१०९-७", "content_sanskrit": "स्तुतिं चक्रुश्च देवाश्च मुनिपत्न्यश्च माधवम् ।\nपुटाञ्जलियुतास्तत्र त्रमेण च पृधक्पृथक् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003173007, "chapter_id": 23173, "verse_number": "४-१०९-८", "content_sanskrit": "भोजयामास राज्ञी च वरेण सह कन्यकाम् ।\nसकर्पूरं सताम्बूलं प्रददौ वासितं जलम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003173008, "chapter_id": 23173, "verse_number": "४-१०९-९", "content_sanskrit": "दुर्गा कृष्णाय प्रददौ तत्र मङ्गलपत्रिकाम् ।\nसर्वासामाज्ञया देवी पठेति तमुवाच सा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003173009, "chapter_id": 23173, "verse_number": "४-१०९-१०", "content_sanskrit": "पपाठ पत्रिकां कृष्णो देवीसंसदि सस्मितः ।\nलक्ष्मी सरस्वती दुर्गा सावित्री राधिका सती ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003173010, "chapter_id": 23173, "verse_number": "४-१०९-११", "content_sanskrit": "तुलसी पृथिवी गङ्गाऽरुन्धति यमुनाऽदितिः ।\nशतरूपा च सीता च देवहूतिश्च मेनका ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003173011, "chapter_id": 23173, "verse_number": "४-१०९-१२", "content_sanskrit": "दैव्यश्चैताश्च दंपत्योः कुर्वन्तु परम् ।\nपपाठ चेति कृष्णश्च शुश्रुवुर्जहसुश्च ताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003173012, "chapter_id": 23173, "verse_number": "४-१०९-१३", "content_sanskrit": "पार्वत्युवाचरुक्मिणीं रुक्मिणीकान्त त्वां पश्यन्तीं च सस्मिताम् ।\nपश्य प्रौढां रुपवतीं सुन्दरीं नवयौवनाम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003173013, "chapter_id": 23173, "verse_number": "४-१०९-१४", "content_sanskrit": "शच्युवाच ।\nतव योग्या च युवती रत्नभूषणभूषिता ।\nत्वां प्रार्थयन्ती सुचिरमवमन्यान्यमीश्वरम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003173014, "chapter_id": 23173, "verse_number": "४-१०९-१५", "content_sanskrit": "सावित्र्युवाच ।\nयथा वरस्तथा कन्या विधिना योजिता पुरा ।\nविदग्धाया विदग्धेन सर्वत्र संगमः शुभः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003173015, "chapter_id": 23173, "verse_number": "४-१०९-१६", "content_sanskrit": "रत्युवाच ।\nईश्वरेण परीहासं का वा कर्तुं क्षमा भुवि ।\nध्यानासाध्यो दुराराध्यश्चावमन्यान्यमीश्वरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003173016, "chapter_id": 23173, "verse_number": "४-१०९-१७", "content_sanskrit": "गायत्र्युवाच ।\nयथा वरस्तथा कन्या चाक्षुब्धे भैष्मके गृहे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003173017, "chapter_id": 23173, "verse_number": "४-१०९-१८", "content_sanskrit": "रोहिण्युवाच ।\nसत्यं ब्रूहि जगन्नाथ कामिनीनां च संसदि ।\nकीदृशी राधिका रम्या रुक्मिणी चापि कीदृशी ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003173018, "chapter_id": 23173, "verse_number": "४-१०९-१९", "content_sanskrit": "सरस्वत्युवाच ।\nराधायां यादृशी प्रीती रुक्मिण्यां नैव तादृशी ।\nसा सङ्गिनी पूर्वकाले सर्वक्रीडासु वर्धिनी ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003173019, "chapter_id": 23173, "verse_number": "४-१०९-२०", "content_sanskrit": "प्राणाधिष्ठातुदेवी सा पञ्चप्राणाधिका सती ।\nरुक्मिणी कमला साक्षात्संपदामधिदेवता ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003173020, "chapter_id": 23173, "verse_number": "४-१०९-२१", "content_sanskrit": "सर्वशक्तिस्वरूपा च कृष्णस्य परमात्मनः ।\nबुद्धेरप्यधिदेवी च दुर्गा नारायणी परा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003173021, "chapter_id": 23173, "verse_number": "४-१०९-२२", "content_sanskrit": "देवाधिष्ठातृदेवी त्वं सावित्री वेदमातृका ।\nविद्याधिदेवताऽहं च ततोऽन्याश्च कलाकलाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003173022, "chapter_id": 23173, "verse_number": "४-१०९-२३", "content_sanskrit": "न ब्रह्मणि शिवे शेषे गणेशे च दिनेश्वरे ।\nन भक्तेषु च पद्मायां न शिवायां च मय्यपि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003173023, "chapter_id": 23173, "verse_number": "४-१०९-२४", "content_sanskrit": "प्रसादो यादृशस्तस्यामन्येषु च न तादृशः ।\nत्रैलोक्ये पृथिवी धन्या सुपुण्यं भारतं यतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003173024, "chapter_id": 23173, "verse_number": "४-१०९-२५", "content_sanskrit": "तत्र वृन्दावनं धन्यं राधापादाब्जचिह्नितम् ।\nसर्वासामपि देवीनां राधा पुण्यवती सती ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003173025, "chapter_id": 23173, "verse_number": "४-१०९-२६", "content_sanskrit": "राधापादाब्जनखरे ददौ स्निग्धमलक्तकम् ।\nअयमेवमिति श्रुत्वा जहसुः सर्वयोषितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003173026, "chapter_id": 23173, "verse_number": "४-१०९-२७", "content_sanskrit": "ध्यायन्ते दूर्तः सर्वा राधा वक्षःस्थलस्थिता ।\nतस्माद्राधां नमस्कृत्य तुलनां मन्यते किल ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003173027, "chapter_id": 23173, "verse_number": "४-१०९-२८", "content_sanskrit": "सरस्वतीवचः श्रुत्वा सावित्री पार्वती सती ।\nअन्याश्च योषितः सर्वाः साध्वित्यूचुश्च संसदि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003173028, "chapter_id": 23173, "verse_number": "४-१०९-२९", "content_sanskrit": "लोपामुद्राऽनसूया चाप्यहल्याऽरुन्धती तथा ।\nसर्वास्ता मुनिपत्न्यश्च रभसं चक्रुरीश्वरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003173029, "chapter_id": 23173, "verse_number": "४-१०९-३०", "content_sanskrit": "अथ देवांश्च भूपांश्च मुनीद्रांश्चापि भीष्मकः ।\nपूजयामास विधिना भोजयामास सादरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003173030, "chapter_id": 23173, "verse_number": "४-१०९-३१", "content_sanskrit": "खाद्यतां लोका दीयतां दीयतामिति ।\nशब्दो बभूव नगरे वाद्यसंगीतमङ्गलैः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003173031, "chapter_id": 23173, "verse_number": "४-१०९-३२", "content_sanskrit": "अथ प्रभाते ब्रह्मेशसेषास्त्रिदशास्तथा ।\nयानमारोहणं भूपाश्चक्रिरे च त्वरान्विताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003173032, "chapter_id": 23173, "verse_number": "४-१०९-३३", "content_sanskrit": "राजा महोग्रसेनश्च वसुदेवस्त्वरान्वितः ।\nकारयामास यात्रां च श्रीकृष्णं रुक्मिणीं सतीम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003173033, "chapter_id": 23173, "verse_number": "४-१०९-३४", "content_sanskrit": "सुभद्रा रुक्मिणीमाता कन्यां कृत्वा स्ववक्षसि ।\nरुरोदोच्चैस्तत्सखीभिर्बान्धवैरित्युवाच सा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003173034, "chapter_id": 23173, "verse_number": "४-१०९-३५", "content_sanskrit": "सुभद्रोवाच ।\nक्व यासि मां परित्यज्य वत्से मातरमीश्वरीम् ।\nकथं जीवामि त्वां त्यक्त्वा कथं त्वं वाऽपि जीवसि ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003173035, "chapter_id": 23173, "verse_number": "४-१०९-३६", "content_sanskrit": "महालक्ष्मीर्मम गृहात्कन्यारूपा च मायया ।\nवसुदेवालयं यासि वासुदेवप्रिया सतीः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003173036, "chapter_id": 23173, "verse_number": "४-१०९-३७", "content_sanskrit": "इत्युक्त्वा कन्यकां शोकात्सिषेव नेत्रजैर्जलैः ।\nभीष्मकः साश्रुनेत्रश्च कन्यां कृष्णे समर्प्य च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003173037, "chapter_id": 23173, "verse_number": "४-१०९-३८", "content_sanskrit": "तं च कृत्वा परीहारं रुरोदोच्चैरतीव सः ।\nरुरोद रुक्मिणी देवी श्रीकृष्णश्चापि मायया ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003173038, "chapter_id": 23173, "verse_number": "४-१०९-३९", "content_sanskrit": "रथमारोपयामास वसुदेवः सुतं वधूम् ।\nएतस्मिन्नन्तरे राजा जामात्रे यौतुकं ददौ ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003173039, "chapter_id": 23173, "verse_number": "४-१०९-४०", "content_sanskrit": "गचेन्द्राणां सहस्रं च षङ्गुणं च तुरंगमम् ।\nदासीनां च सहस्रं च किंकराणां शतं शतम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003173040, "chapter_id": 23173, "verse_number": "४-१०९-४१", "content_sanskrit": "रत्नानां च सहस्रं चैवामुल्यरत्नभूषणम् ।\nस्वर्णानां परिशुद्धानां पञ्चलक्षं च सादरम ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003173041, "chapter_id": 23173, "verse_number": "४-१०९-४२", "content_sanskrit": "तोयभोजनपात्राणि कुतानि विश्वकर्मणा ।\nसौवर्णानि च रम्याणि सुरभीः प्रददौ मुदा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003173042, "chapter_id": 23173, "verse_number": "४-१०९-४३", "content_sanskrit": "दुग्धवतीनां धेनुनां सवत्सानां सहस्रकम् ।\nअमूल्यानि च रम्याणि वह्निशुद्धांशुकानि च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003173043, "chapter_id": 23173, "verse_number": "४-१०९-४४", "content_sanskrit": "वसुदेवश्चोग्रसेनो देवैश्च मुनीभिः सह ।\nप्रहृष्टवदनः शीघ्रं द्वारकाभिसुखं ययौ ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003173044, "chapter_id": 23173, "verse_number": "४-१०९-४५", "content_sanskrit": "प्रविश्य स्वपुरीं रम्या कारयामास मङ्गलम् ।\nवाद्यं च वादयामास सुन्दरं सुमनोहरम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003173045, "chapter_id": 23173, "verse_number": "४-१०९-४६", "content_sanskrit": "देवकी रोहिणी रम्या यशोदा नन्दगेहिनी ।\nअदितिश्च दितिश्चैव तथा च वरकामिनी ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003173046, "chapter_id": 23173, "verse_number": "४-१०९-४७", "content_sanskrit": "श्रीकृष्णं रुक्मिणीं रम्यां विलोक्य च पुनः पुनः ।\nगृहं प्रवेशयामास कारयामास मङ्गलम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003173047, "chapter_id": 23173, "verse_number": "४-१०९-४८", "content_sanskrit": "चतुर्विधं भोजयित्वा देवांश्च मुनिपुंगवान् ।\nनृपांश्च बान्धवांश्चैव परीहारं चकार च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003173048, "chapter_id": 23173, "verse_number": "४-१०९-४९", "content_sanskrit": "भट्टेभ्यो ब्राह्मणेभ्योऽपि ददौ रत्नादिकं मुदा ।\nतांश्चपि भोजयामास परितुष्टांश्च सस्मितान् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003173049, "chapter_id": 23173, "verse_number": "४-१०९-५०", "content_sanskrit": "एवं भुक्त्वा धनं लब्ध्वा ययुः सर्वे गृहं मुदा ।\nमङ्गलं कारयामास वसुदेवस्य वल्लभा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]