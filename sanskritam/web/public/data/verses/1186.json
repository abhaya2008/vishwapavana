[{"id": 2009457, "chapter_id": 1186, "verse_number": "१-१८७-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009458, "chapter_id": 1186, "verse_number": "१-१८७-१", "content_sanskrit": "तापत्य इति यद्वाक्यमुक्तवानसि मामिह।\nतदहं ज्ञातुमिच्छामि तापत्यार्थं विनिश्चितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009459, "chapter_id": 1186, "verse_number": "१-१८७-२", "content_sanskrit": "तपती नाम का चैषा तापत्या यत्कृते वयम्।\nकौन्तेया हि वयं साधो तत्त्वमिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009460, "chapter_id": 1186, "verse_number": "१-१८७-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009461, "chapter_id": 1186, "verse_number": "१-१८७-३", "content_sanskrit": "एवमुक्तः स गन्धर्वः कुन्तीपुत्रं धनञ्जयम्।\nविश्रुतं त्रिषु लोकेषु श्रावयामास वै कथाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009462, "chapter_id": 1186, "verse_number": "१-१८७-४", "content_sanskrit": "हन्त ते कथयिष्यामि कथामेतां मनोरमाम्।\nयथावदखिलां पार्थ सर्वबुद्धिमतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009463, "chapter_id": 1186, "verse_number": "१-१८७-५", "content_sanskrit": "उक्तवानस्मि येन त्वां तापत्य इति यद्वचः।\nतत्तेऽहं कथयिष्यामि शृणुष्वैकमना भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009464, "chapter_id": 1186, "verse_number": "१-१८७-६", "content_sanskrit": "य एष दिवि धिष्ण्येन नाकं व्याप्नोति तेजसा।\nएतस्य तपती नाम बभूव सदृशी सुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009465, "chapter_id": 1186, "verse_number": "१-१८७-७", "content_sanskrit": "विवस्वतो वै देवस्य सावित्र्यवरजा विभो।\nविश्रुता त्रिषु लोकेषु तपती तपसा युता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009466, "chapter_id": 1186, "verse_number": "१-१८७-८", "content_sanskrit": "न देवी नासुरी चैव न यक्षी न च राक्षसी।\nनाप्सरा न च गन्धर्वी तथा रूपेण काचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009467, "chapter_id": 1186, "verse_number": "१-१८७-९", "content_sanskrit": "सुविभक्तानवद्याङ्गी स्वसितायतलोचना।\nस्वाचारा चैव साध्वी च सुवेषा चैव भामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009468, "chapter_id": 1186, "verse_number": "१-१८७-१०", "content_sanskrit": "त तस्याः सदृशं कंचित्त्रिषु लोकेषु भारत।\nभर्तारं सविता मेने रूपशीलगुणश्रुतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009469, "chapter_id": 1186, "verse_number": "१-१८७-११", "content_sanskrit": "संप्राप्तयौवनां पश्यन्देयां दुहितरं तु ताम्।\nद्व्यष्टवर्षां तु तां श्यामां सविता रूपशालिनीम्।\nनोपलेभे ततः शान्तिं संप्रदानं विचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009470, "chapter_id": 1186, "verse_number": "१-१८७-१२", "content_sanskrit": "अथर्क्षपुत्रः क्रान्तेय कुरूणामृषभो बली।\nसूर्यमाराधयामास नृपः संवरणस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009471, "chapter_id": 1186, "verse_number": "१-१८७-१३", "content_sanskrit": "अर्ध्यमाल्योपहाराद्यैर्गन्धैश्च नियतः शुचिः।\nनियमैरुपवासैश्च तपोभिर्विविधैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009472, "chapter_id": 1186, "verse_number": "१-१८७-१४", "content_sanskrit": "सुश्रूषुरनहंवादी शुचिः पौरवनन्दन।\nअंशुमन्तं समुद्यन्तं पूजयामास भक्तिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009473, "chapter_id": 1186, "verse_number": "१-१८७-१५", "content_sanskrit": "ततः कृतज्ञं धर्मज्ञं रूपेणासदृशं भुवि।\nतपत्याः सदृशं मेने सूर्यः संवरणं पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009474, "chapter_id": 1186, "verse_number": "१-१८७-१६", "content_sanskrit": "दातुमैच्छत्ततः कन्यां तस्मै संवरणाय ताम्।\nनृपोत्तमाय कौरव्य विश्रुताभिजनाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009475, "chapter_id": 1186, "verse_number": "१-१८७-१७", "content_sanskrit": "यथा हि दिवि दीप्तांशुः प्रभासयति तेजसा।\nतथा भुवि महिपालो दीप्त्या संवरणोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009476, "chapter_id": 1186, "verse_number": "१-१८७-१८", "content_sanskrit": "यथाऽर्चयन्ति चादित्यमुद्यन्तं ब्रह्मवादिनः।\nतथा संवरणं पार्थ ब्राह्मणावरजाः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009477, "chapter_id": 1186, "verse_number": "१-१८७-१९", "content_sanskrit": "स सोममति कान्तत्वादादित्यमति तेजसा।\nबभूव नृपतिः श्रीमान्सुहृदां दुर्हृदामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009478, "chapter_id": 1186, "verse_number": "१-१८७-२०", "content_sanskrit": "एवंगुणस्य नृपतेस्तथावृत्तस्य कौरव।\nतस्मै दातुं मनश्चक्रे तपतीं तपनः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009479, "chapter_id": 1186, "verse_number": "१-१८७-२१", "content_sanskrit": "स कदाचिदथो राजा श्रीमानमितविक्रमः।\nचचार मृगयां पार्थ पर्वतोपवने किल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009480, "chapter_id": 1186, "verse_number": "१-१८७-२२", "content_sanskrit": "चरतो मृगयां तस्य क्षुत्पिपासासमन्वितः।\nममार राज्ञः कौन्तेय गिरावप्रतिमो हयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009481, "chapter_id": 1186, "verse_number": "१-१८७-२३", "content_sanskrit": "स मृताश्वश्चरन्पार्थ पद्भ्यामेव गिरौ नृपः।\nददर्शासदृशीं लोके कन्यामायतलोचनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2009482, "chapter_id": 1186, "verse_number": "१-१८७-२४", "content_sanskrit": "स एव एकामासाद्य कन्यां परबलार्दनः।\nतस्थौ नृपतिशार्दूलः पश्यन्नविचलेक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2009483, "chapter_id": 1186, "verse_number": "१-१८७-२५", "content_sanskrit": "स हि तां तर्कयामास रूपतो नृपतिः श्रियम्।\nपुनः संतर्कयामास रवेर्भ्रष्टामिव प्रभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2009484, "chapter_id": 1186, "verse_number": "१-१८७-२६", "content_sanskrit": "वपुषा वर्चसा चैव शिखामिव विभावसोः।\nप्रसन्नत्वेन कान्त्या च चन्द्ररेखामिवामलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2009485, "chapter_id": 1186, "verse_number": "१-१८७-२७", "content_sanskrit": "गिरिपृष्ठे तु सा यस्मिन्स्थिता स्वसितलोचना।\nविभ्राजमाना शुशुभे प्रतिमेव हिरण्मयी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2009486, "chapter_id": 1186, "verse_number": "१-१८७-२८", "content_sanskrit": "तस्या रूपेण स गिरिर्वेषेण च विशेषतः।\nससवृक्षक्षुपलतो हिरण्मय इवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2009487, "chapter_id": 1186, "verse_number": "१-१८७-२९", "content_sanskrit": "अवमेने च तां दृष्ट्वा सर्वलोकेषु योषितः।\nअवाप्तं चात्मनो मेने स राजा चक्षुषः फलं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2009488, "chapter_id": 1186, "verse_number": "१-१८७-३०", "content_sanskrit": "जन्मप्रभृति यत्किचिंद्दृष्टवान्स महीपतिः।\nरूपं न सदृशं तस्यास्तर्कयामास किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2009489, "chapter_id": 1186, "verse_number": "१-१८७-३१", "content_sanskrit": "तया बद्धमनश्चक्षुः पाशैर्गुणमयैस्तदा।\nन चचाल ततो देशाद्बुबुधे न च किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2009490, "chapter_id": 1186, "verse_number": "१-१८७-३२", "content_sanskrit": "अस्या नूनं विशालाक्ष्याः सदेवासुरमानुषम्।\nलोकं निर्मथ्य धात्रेदं रूपमाविष्कृतं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2009491, "chapter_id": 1186, "verse_number": "१-१८७-३३", "content_sanskrit": "एवं संतर्कयामास रूपद्रविणसंपदा।\nकन्यामसदृशीं लोके नृपः संवरणस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2009492, "chapter_id": 1186, "verse_number": "१-१८७-३४", "content_sanskrit": "तां च दृष्ट्वैव कल्याणीं कल्याणाभिजनो नृपः।\nजगाम मनसा चिन्तां कामबाणेन पीडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2009493, "chapter_id": 1186, "verse_number": "१-१८७-३५", "content_sanskrit": "दह्यमानः स तीव्रेण नृपतिर्मन्मथाग्निना।\nअप्रगल्भां प्रगल्भस्तां तदोवाच मनोहराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2009494, "chapter_id": 1186, "verse_number": "१-१८७-३६", "content_sanskrit": "काऽसि कस्यासि रम्भोरु किमर्थं चेह तिष्ठसि।\nकथं च निर्जनेऽरण्ये चरस्येका शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2009495, "chapter_id": 1186, "verse_number": "१-१८७-३७", "content_sanskrit": "त्वं हि सर्वानवद्याङ्गी सर्वाभरणभूषिता।\nविभूषणमिवैतेषां भूषणानामभीप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2009496, "chapter_id": 1186, "verse_number": "१-१८७-३८", "content_sanskrit": "न देवीं नासुरीं चैव न यक्षीं न च राक्षसीम्।\nन च भोगवतीं मन्ये न गन्धवीं न मानुषीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2009497, "chapter_id": 1186, "verse_number": "१-१८७-३९", "content_sanskrit": "या हि दृष्टा मया काश्चिच्छ्रुता वाऽपि वराङ्गनाः।\nन तासां सदृशीं मन्ये त्वामहं मत्तकाशिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2009498, "chapter_id": 1186, "verse_number": "१-१८७-४०", "content_sanskrit": "दृष्ट्वैव चारुवदने चन्द्रात्कान्ततरं तव।\nवदनं पद्मपत्राक्षं मां मथ्नातीव मन्मथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2009499, "chapter_id": 1186, "verse_number": "१-१८७-४१", "content_sanskrit": "एवं तां स महीपालो बभाषे न तु सा तदा।\nकामार्तं निर्जनेऽरण्ये प्रत्यबाषथ किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2009500, "chapter_id": 1186, "verse_number": "१-१८७-४२", "content_sanskrit": "ततो लालप्यमानस्य पार्थिवस्यायतेक्षणा।\nसौदामिनीव चाभ्रेषु तत्रैवान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2009501, "chapter_id": 1186, "verse_number": "१-१८७-४३", "content_sanskrit": "तामन्वेष्टुं स नृपतिः परिचक्राम सर्वतः।\nवनं वनजपत्राक्षीं भ्रमन्नुन्मत्तवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2009502, "chapter_id": 1186, "verse_number": "१-१८७-४४", "content_sanskrit": "अपश्यमानः स तु तां बहु तत्र विलप्य च।\nनिश्चेष्टः पार्थिवश्रेष्ठो मुहूर्तं स व्यतिष्ठत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2009503, "chapter_id": 1186, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वणि सप्ताशीत्यधिकशततमोऽध्यायः॥ १८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]