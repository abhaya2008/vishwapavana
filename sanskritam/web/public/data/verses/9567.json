[{"id": 5000567000, "chapter_id": 9567, "verse_number": "७-३२-१", "content_sanskrit": "नर्मदापुलिने यत्र राक्षसेन्द्रः सुदारुणः ।\nपुष्पोपहारं कुरुते तस्माद्देशाददूरतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000567001, "chapter_id": 9567, "verse_number": "७-३२-२", "content_sanskrit": "अर्जुनो जयतां श्रेष्ठो माहिष्मत्याः पतिः प्रभुः ।\nक्रीडते सह नारीभिर्नर्मदातोयमाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000567002, "chapter_id": 9567, "verse_number": "७-३२-३", "content_sanskrit": "तासां मध्यगतो राजा रराज च तदार्जुनः ।\nकरेणूनां सहस्रस्य मध्यस्थ इव कुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000567003, "chapter_id": 9567, "verse_number": "७-३२-४", "content_sanskrit": "जिज्ञासुः स तु बाहूनां सहस्रस्योत्तमं बलम् ।\nरुरोध नर्मदावेगं बाहुभिर्बहुभिर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000567004, "chapter_id": 9567, "verse_number": "७-३२-५", "content_sanskrit": "कार्तवीर्यभुजासक्तं तज्जलं प्राप्य निर्मलम् ।\nकूलोपहारं कुर्वाणं प्रतिस्रोतः प्रधावति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000567005, "chapter_id": 9567, "verse_number": "७-३२-६", "content_sanskrit": "समीननक्रमकरः सपुष्पकुशसंस्तरः ।\nस नर्मदाम्भसो वेगः प्रावृट्काल इवाबभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000567006, "chapter_id": 9567, "verse_number": "७-३२-७", "content_sanskrit": "स वेगः कार्तवीर्येण सम्प्रेषित इवाम्भसः ।\nपुष्पोपहारं सकलं रावणस्य जहार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000567007, "chapter_id": 9567, "verse_number": "७-३२-८", "content_sanskrit": "रावणो ऽर्धसमाप्तं तमुत्सृज्य नियमं तदा ।\nनर्मदां पश्यते कान्तां प्रतिकूलां यथा प्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000567008, "chapter_id": 9567, "verse_number": "७-३२-९", "content_sanskrit": "पश्चिमेन तु तं दृष्ट्वा सागरोद्गारसन्निभम् ।\nवर्धन्तमम्भसो वेगं पूर्वामाशां प्रविश्य तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000567009, "chapter_id": 9567, "verse_number": "७-३२-१०", "content_sanskrit": "ततो ऽनुभ्रान्तशकुनां स्वभावोपरमे स्थिताम् ।\nनिर्विकाराङ्गनाभासामपश्यद्रावणो नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000567010, "chapter_id": 9567, "verse_number": "७-३२-११", "content_sanskrit": "सव्येतरकराङ्गुल्या सशब्दं च दशाननः ।\nवेगप्रभावमन्वेष्टुं सो ऽदिशच्छुकसारणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000567011, "chapter_id": 9567, "verse_number": "७-३२-१२", "content_sanskrit": "तौ तु रावणसन्दिष्टौ भ्रातरौ शुकसारणौ ।\nव्योमान्तरगतौ वीरौ प्रस्थितौ पश्चिमामुखौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000567012, "chapter_id": 9567, "verse_number": "७-३२-१३", "content_sanskrit": "अर्धयोजनमात्रं तु गत्वा तौ रजनीचरौ ।\nपश्येतां पुरुषं तोये क्रीडन्तं सहयोषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000567013, "chapter_id": 9567, "verse_number": "७-३२-१४", "content_sanskrit": "बृहत्सालप्रतीकाशं तोयव्याकुलमूर्धजम् ।\nमदरक्तान्तनयनं मदव्याकुलतेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000567014, "chapter_id": 9567, "verse_number": "७-३२-१५", "content_sanskrit": "नदीं बाहुसहस्रेण रुन्धन्तमरिमर्दनम् ।\nगिरिं पादसहस्रेण रुन्धन्तमिव मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000567015, "chapter_id": 9567, "verse_number": "७-३२-१६", "content_sanskrit": "बालानां वरनारीणां सहस्रेण समावृतम् ।\nसमदानां करेणूनां सहस्रेणेव कुञ्जरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000567016, "chapter_id": 9567, "verse_number": "७-३२-१७", "content_sanskrit": "तमद्भुततमं दृष्ट्वा राक्षसौ शुकसारणौ ।\nसन्निवृत्तावुपागम्य रावणं तमथोचतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000567017, "chapter_id": 9567, "verse_number": "७-३२-१८", "content_sanskrit": "बृहत्सालप्रतीकाशः को ऽप्यसौ राक्षसेश्वर ।\nनर्मदां रोधवद्रुद्ध्वा क्रीडापयति योषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000567018, "chapter_id": 9567, "verse_number": "७-३२-१९", "content_sanskrit": "तेन बाहुसहस्रेण सन्निरुद्धजला नदी ।\nसागरोद्गारसङ्काशानुद्गारान्सृजते मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000567019, "chapter_id": 9567, "verse_number": "७-३२-२०", "content_sanskrit": "इत्येवं भाषमाणौ तौ निशाम्य शुकसारणौ ।\nरावणो ऽर्जुन इत्युक्त्वा प्रययौ युद्धलालसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000567020, "chapter_id": 9567, "verse_number": "७-३२-२१", "content_sanskrit": "अर्जुनाभिमुखे तस्मिन्रावणे राक्षसाधिपे ।\nचण्डः प्रवाति पवनः सनादः सुरजास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000567021, "chapter_id": 9567, "verse_number": "७-३२-२२", "content_sanskrit": "सकृदेव कृतो रावः सरक्तः प्रेषितो घनैः ।\nमहोदरमहापार्श्वधूम्राक्षशुकसारणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000567022, "chapter_id": 9567, "verse_number": "७-३२-२३", "content_sanskrit": "संवृतो राक्षसेन्द्रस्तु तत्रागाद्यत्र चार्जुनः ।\nअदीर्घेणैव कालेन स तदा राक्षसो बली ।\nतं नर्मदाह्रदं भीममाजगामाञ्जनप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000567023, "chapter_id": 9567, "verse_number": "७-३२-२४", "content_sanskrit": "स तत्र स्त्रीपरिवृतं वाशिताभिरिव द्विपम् ।\nनरेन्द्रं पश्यते राजा राक्षसानां तदार्जुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000567024, "chapter_id": 9567, "verse_number": "७-३२-२५", "content_sanskrit": "स रोषाद्रक्तनयनो राक्षसेन्द्रो बलोद्धतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000567025, "chapter_id": 9567, "verse_number": "७-३२-२६", "content_sanskrit": "इत्येवमर्जुनामात्यनाह गम्भीरया गिरा ।\nअमात्याः क्षिप्रमाख्यात हैहयस्य नृपस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000567026, "chapter_id": 9567, "verse_number": "७-३२-२७", "content_sanskrit": "युद्धार्थी समनुप्राप्तो रावणो नाम राक्षसः ।\nरावणस्य वचः श्रुत्वा मन्त्रिणो ऽथार्जुनस्य ते ।\nउत्तस्थुः सायुधास्त्राश्च रावणं वाक्यमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000567027, "chapter_id": 9567, "verse_number": "७-३२-२८", "content_sanskrit": "युद्धस्य कालो विज्ञेयः साधु भोः साधु रावण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000567028, "chapter_id": 9567, "verse_number": "७-३२-२९", "content_sanskrit": "चः श्रुत्वा मन्त्रिणो ऽथार्जुनस्य ते ।\nयः क्षीबं स्त्रीवृतं चैव योद्धुमुत्सहते नृपम् ।\nस्त्रीसमक्षं कथं यत्तद्योद्धुमुत्सहसे ऽर्जुनम् ।\nवाशितामध्यगं मत्तं शार्दूल इव कुञ्जरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000567029, "chapter_id": 9567, "verse_number": "७-३२-३०", "content_sanskrit": "क्षमस्वाद्य दशग्रीव चोष्यतां रजनी त्वया ।\nयुद्धे श्रद्धा च यद्यस्ति श्वस्तात समरे ऽर्जुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000567030, "chapter_id": 9567, "verse_number": "७-३२-३१", "content_sanskrit": "यद्यद्यास्ति मतिर्योद्धुं युद्धतृष्णासमावृता ।\nनिहत्यास्मांस्ततो युद्धमर्जुनेनोपयास्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000567031, "chapter_id": 9567, "verse_number": "७-३२-३२", "content_sanskrit": "ततस्ते रावणामात्यैरमात्याः पार्थिवस्य तु ।\nसूदिताश्चापि ते युद्धे भक्षिताश्च बुभुक्षितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000567032, "chapter_id": 9567, "verse_number": "७-३२-३३", "content_sanskrit": "ततो हलहलाशब्दो नर्मदातीर आबभौ ।\nअर्जुनस्यानुयातऽणां रावणस्य च मन्त्रिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000567033, "chapter_id": 9567, "verse_number": "७-३२-३४", "content_sanskrit": "इषुभिस्तोमरैः शूलैस्त्रिशूलैर्वज्रकर्षणैः ।\nसरावणानर्दयन्तः समन्तात्समभिद्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000567034, "chapter_id": 9567, "verse_number": "७-३२-३५", "content_sanskrit": "हैहयाधिपयोधानां वेग आसीत्सुदारुणः ।\nसनक्रमीनमकरसमुद्रस्येव निःस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000567035, "chapter_id": 9567, "verse_number": "७-३२-३६", "content_sanskrit": "रावणस्य तु ते ऽमात्याः प्रहस्तशुकसारणाः ।\nकार्तवीर्यबलं क्रुद्धा निर्दहन्ति स्म तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000567036, "chapter_id": 9567, "verse_number": "७-३२-३७", "content_sanskrit": "अर्जुनाय तु तत्कर्म रावणस्य समन्त्रिणः ।\nक्रीडमानाय कथितं पुरुषैर्द्वाररक्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000567037, "chapter_id": 9567, "verse_number": "७-३२-३८", "content_sanskrit": "श्रुत्वा न भेतव्यमिति स्त्रीजनं तं ततो ऽर्जुनः ।\nउत्ततार जलात्तस्माद्गङ्गातोयादिवाञ्जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000567038, "chapter_id": 9567, "verse_number": "७-३२-३९", "content_sanskrit": "क्रोधदूषितनेत्रस्तु स ततो ऽर्जुनपावकः ।\nप्रजज्वाल महाघोरो युगान्त इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000567039, "chapter_id": 9567, "verse_number": "७-३२-४०", "content_sanskrit": "स तूर्णतरमादाय वरहेमाङ्गदो गदाम् ।\nअभिदुद्राव रक्षांसि तमांसीव दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000567040, "chapter_id": 9567, "verse_number": "७-३२-४१", "content_sanskrit": "बाहुविक्षेपकरणां समुद्यम्य महागदाम् ।\nगारुडं वेगमास्थाय चापपातैव सो ऽर्जुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000567041, "chapter_id": 9567, "verse_number": "७-३२-४२", "content_sanskrit": "तस्य मार्गं समारुद्ध्य विन्ध्यो ऽर्कस्येव पर्वतः ।\nस्थितो विन्ध्य इवाकम्प्यः प्रहस्तो मुसलायुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000567042, "chapter_id": 9567, "verse_number": "७-३२-४३", "content_sanskrit": "ततो ऽस्य मुसलं घोरं लोहबद्धं महोद्धतः ।\nप्रहस्तः प्रेषयन्क्रुद्धो ररास च यथाम्बुदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000567043, "chapter_id": 9567, "verse_number": "७-३२-४४", "content_sanskrit": "तस्याग्रे मुसलस्याग्निरशोकापीडसन्निभः ।\nप्रहस्तकरमुक्तस्य बभूव प्रदहन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000567044, "chapter_id": 9567, "verse_number": "७-३२-४५", "content_sanskrit": "अथायान्तं तु मुसलं कार्तवीर्यस्तदार्जुनः ।\nनिपुणं वञ्चयामास सगदो ऽगदविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000567045, "chapter_id": 9567, "verse_number": "७-३२-४६", "content_sanskrit": "ततस्तमभिदुद्राव प्रहस्तं हैहयाधिपः ।\nभ्रामयानो गदां गुर्वीं पञ्चबाहुशतोच्छ्रयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000567046, "chapter_id": 9567, "verse_number": "७-३२-४७", "content_sanskrit": "तथा हतो ऽतिवेगेन प्रहस्तो गदया तदा ।\nनिपपात स्थितः शैलो वज्रिवज्रहतो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000567047, "chapter_id": 9567, "verse_number": "७-३२-४८", "content_sanskrit": "प्रहस्तं पतितं दृष्ट्वा मारीचशुकसारणाः ।\nसमहोदरधूम्राक्षा ह्यपसृष्टा रणाजिरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000567048, "chapter_id": 9567, "verse_number": "७-३२-४९", "content_sanskrit": "अपक्रान्तेष्वमात्येषु प्रहस्ते वै निपातिते ।\nरावणो ऽभ्यद्रवत्तूर्णमर्जुनं नृपसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000567049, "chapter_id": 9567, "verse_number": "७-३२-५०", "content_sanskrit": "सहस्रबाहोस्तद्युद्धं विंशद्बाहोश्च दारुणम् ।\nनृपराक्षसयोस्तत्र चारब्धं रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000567050, "chapter_id": 9567, "verse_number": "७-३२-५१", "content_sanskrit": "सागराविव संरब्धौ चलन्मूलाविवाचलौ ।\nतेजोयुक्ताविवादित्यौ प्रदहन्ताविवानलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000567051, "chapter_id": 9567, "verse_number": "७-३२-५२", "content_sanskrit": "बलोद्धतौ यथा नागौ वाशितार्थे यथा वृषौ ।\nमेघाविव विनर्दन्तौ सिंहाविव बलोत्कटौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000567052, "chapter_id": 9567, "verse_number": "७-३२-५३", "content_sanskrit": "रुद्रकालाविव क्रुद्धौ तदा तौ राक्षसार्जुनौ ।\nपरस्परं गदाभ्यां तौ ताडयामासतुर्भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000567053, "chapter_id": 9567, "verse_number": "७-३२-५४", "content_sanskrit": "वज्रप्रहारानचला यथा घोरान्विषेहिरे ।\nगदाप्रहारांस्तौ तत्र सेहाते नरराक्षसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000567054, "chapter_id": 9567, "verse_number": "७-३२-५५", "content_sanskrit": "यथा ऽ शनिरवेभ्यस्तु जायते ऽथ प्रतिश्रुतिः ।\nतथा तयोर्गदापोथैर्दिशः सर्वाः प्रतिश्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000567055, "chapter_id": 9567, "verse_number": "७-३२-५६", "content_sanskrit": "अर्जुनस्य गदा सा तु पात्यमाना ऽहितोरसि ।\nकाञ्चनाभं नभश्चक्रे विद्युत्सौदामिनी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000567056, "chapter_id": 9567, "verse_number": "७-३२-५७", "content_sanskrit": "तथैव रावणेनापि पात्यमाना मुहुर्मुहुः ।\nअर्जुनोरसि निर्भाति गदोल्केव महागिरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000567057, "chapter_id": 9567, "verse_number": "७-३२-५८", "content_sanskrit": "नार्जुनः खेदमायाति न राक्षसगणेश्वरः ।\nइदमासीत्तयोर्युद्धं यथा पूर्वं बलीन्द्रयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000567058, "chapter_id": 9567, "verse_number": "७-३२-५९", "content_sanskrit": "शृङ्गैरिव वृषायुध्यन्दन्ताग्रैरिव कुञ्जरौ ।\nपरस्परं तौ निघ्नन्तौ नरराक्षससत्तमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000567059, "chapter_id": 9567, "verse_number": "७-३२-६०", "content_sanskrit": "ततो ऽर्जुनेन क्रुद्धेन सर्वप्राणेन सा गदा ।\nस्तनयोरन्तरे मुक्ता रावणस्य महोरसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000567060, "chapter_id": 9567, "verse_number": "७-३२-६१", "content_sanskrit": "वरदानकृतत्राणे सा गदा रावणोरसि ।\nदुर्बलेव यथावेगं द्विधाभूत्वा ऽपतत्क्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000567061, "chapter_id": 9567, "verse_number": "७-३२-६२", "content_sanskrit": "स त्वर्जुनप्रमुक्तेन गदापातेन रावणः ।\nअपासर्पद्धनुर्मात्रं निषसाद च निष्टनन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000567062, "chapter_id": 9567, "verse_number": "७-३२-६३", "content_sanskrit": "स विह्वलं तदालक्ष्य दशग्रीवं ततो ऽर्जुनः ।\nसहसोत्पत्य जग्राह गरुत्मानिव पन्नगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000567063, "chapter_id": 9567, "verse_number": "७-३२-६४", "content_sanskrit": "स तु बाहुसहस्रेण बलाद्गृह्य दशाननम् ।\nबबन्ध बलवान्राजा बलिं नारायणो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000567064, "chapter_id": 9567, "verse_number": "७-३२-६५", "content_sanskrit": "बध्यमाने दशग्रीवे सिद्धचारणदेवताः ।\nसाध्वीतिवादिनः पुष्पैः किरन्त्यर्जुनमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000567065, "chapter_id": 9567, "verse_number": "७-३२-६६", "content_sanskrit": "व्याघ्रो मृगमिवादाय मृगराडिव दन्तिनम् ।\nननाद हैहयो राजा हर्षादम्बुदवन्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000567066, "chapter_id": 9567, "verse_number": "७-३२-६७", "content_sanskrit": "प्रहस्तस्तु समाश्वस्तो दृष्ट्वा बद्धं दशाननम् ।\nसह तै राक्षसैः क्रुद्धश्चाभिदुद्राव पार्थिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000567067, "chapter_id": 9567, "verse_number": "७-३२-६८", "content_sanskrit": "नक्तञ्चराणां वेगस्तु तेषामापततां बभौ ।\nउद्भूत आतपापाये पयोदानामिवाम्बुधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000567068, "chapter_id": 9567, "verse_number": "७-३२-६९", "content_sanskrit": "मुञ्च मुञ्चेति भाषन्तस्तिष्ठतिष्ठेति चासकृत् ।\nमुसलानि सशूलानि सोत्ससर्ज तदार्जुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000567069, "chapter_id": 9567, "verse_number": "७-३२-७०", "content_sanskrit": "अप्राप्तान्येव तान्याशु असम्भ्रान्तस्तदार्जुनः ।\nआयुधान्यमरारीणां जग्राहारिनिषूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000567070, "chapter_id": 9567, "verse_number": "७-३२-७१", "content_sanskrit": "ततस्तैरेव रक्षांसि दुर्धरैः प्रवरायुधैः ।\nभित्त्वा विद्रावयामास वायुरम्बुधरानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000567071, "chapter_id": 9567, "verse_number": "७-३२-७२", "content_sanskrit": "राक्षसांस्त्रासयित्वा तु कार्तवीर्यो ऽर्जुनस्तदा ।\nरावणं गृह्य नगरं प्रविवेश सुहृद्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000567072, "chapter_id": 9567, "verse_number": "७-३२-७३", "content_sanskrit": "स कीर्यमाणः कुसुमाक्षतोत्करैर्द्विजैः सपौरैः पुरुहूतसन्निभः ।\nतदा ऽर्जुनः सम्प्रविवेश तां पुरीं बलिं निगृह्येव सहस्रलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000567073, "chapter_id": 9567, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे द्वात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]