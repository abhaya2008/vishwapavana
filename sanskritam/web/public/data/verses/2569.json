[{"id": 2074319, "chapter_id": 2569, "verse_number": "१२-७४-०x", "content_sanskrit": "`युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074320, "chapter_id": 2569, "verse_number": "१२-७४-१", "content_sanskrit": "ब्रह्मक्षत्रस्य सामर्थ्यं कथितं ते पितामह।\nपुरोहितप्रभावश्च लक्षणं च पुरोधसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074321, "chapter_id": 2569, "verse_number": "१२-७४-२", "content_sanskrit": "इदानीं श्रोतुमिच्छामि ब्रह्मक्षत्रविनिर्णयम्।\nब्रह्मक्षत्रं हि सर्वस्य कारणं जगतः परम्।\nयोगक्षेमो हि राष्ट्रस्य ताभ्यामायत्त एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074322, "chapter_id": 2569, "verse_number": "१२-७४-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074323, "chapter_id": 2569, "verse_number": "१२-७४-३", "content_sanskrit": "योगक्षेमो हि राष्ट्रस्य राजन्यायत्त उच्यते।\nयोगक्षेमो हि राज्ञो हि समायत्तः पुरोहिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074324, "chapter_id": 2569, "verse_number": "१२-७४-४", "content_sanskrit": "यत्रादृष्टं भयं ब्रह्म प्रजानां शमयत्युत।\nदृष्टं च राजा बाहुभ्यां तद्राज्यं सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074325, "chapter_id": 2569, "verse_number": "१२-७४-५", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nमुचुकुन्दस्य संवादं राज्ञो वैश्रवणस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074326, "chapter_id": 2569, "verse_number": "१२-७४-६", "content_sanskrit": "मुचुकुन्दो विजित्येमां पृथिवीं पृथिवीपतिः।\nजिज्ञासमानः स बलमभ्ययादलकाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074327, "chapter_id": 2569, "verse_number": "१२-७४-७", "content_sanskrit": "ततो वैश्रवणो राजा राक्षसानसृजत्तदा।\nते बलान्यवमृद्गन्त मुचुकुन्दस्य नैर्ऋताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074328, "chapter_id": 2569, "verse_number": "१२-७४-८", "content_sanskrit": "स हन्यमाने सैन्ये स्वे मुचुकुन्दो नराधिपः।\nगर्हयामास विद्वांसं पुरोहितमरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074329, "chapter_id": 2569, "verse_number": "१२-७४-९", "content_sanskrit": "तत उग्रं तपस्तप्त्वा वसिष्ठो धर्मवित्तमः।\nरक्षांस्युपावधीत्तत्र पन्थानं चाप्यविन्दत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074330, "chapter_id": 2569, "verse_number": "१२-७४-१०", "content_sanskrit": "ततो वैश्रवणो राजा मुचुकुन्दमगर्हयत्।\nवध्यमानेषु सैन्येषु वचनं चेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074331, "chapter_id": 2569, "verse_number": "१२-७४-११x", "content_sanskrit": "धनद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074332, "chapter_id": 2569, "verse_number": "१२-७४-११", "content_sanskrit": "बलवन्तस्त्वया पूर्वे राजानः सपुरोहिताः।\nन चैवं समवर्तन्त यथा त्वमिव वर्तसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074333, "chapter_id": 2569, "verse_number": "१२-७४-१२", "content_sanskrit": "ते खल्वपि कृतास्त्राश्च बलवन्तश्च भूमिपाः।\nआगम्य पर्युपासन्ते मामीशं सुखदुःखयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074334, "chapter_id": 2569, "verse_number": "१२-७४-१३", "content_sanskrit": "यद्यस्ति बाहुवीर्यं ते तद्दर्शयितुमर्हसि।\nकिं ब्राह्मणबलेन त्वमतिमात्रं प्रवर्तसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074335, "chapter_id": 2569, "verse_number": "१२-७४-१४", "content_sanskrit": "मुचुकुन्दस्ततः क्रुद्धः प्रत्युवाच धनेश्वरम्।\nन्यायपूर्वमसंलब्धमसंभ्रान्तमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074336, "chapter_id": 2569, "verse_number": "१२-७४-१५", "content_sanskrit": "ब्रह्मक्षत्रमिदं सृष्टमेकयोनि स्वयंभुवा।\nपृथग्बलविधानं च तल्लोकं परिपालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074337, "chapter_id": 2569, "verse_number": "१२-७४-१६", "content_sanskrit": "तपोमन्त्रबलं नित्यं ब्राह्मणेषु प्रतिष्ठितम्।\nअस्रबाहुबलं नित्यं क्षत्रियेषु प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074338, "chapter_id": 2569, "verse_number": "१२-७४-१७", "content_sanskrit": "ताभ्यां संभूय कर्तव्यं प्रजानां परिपालनम्।\nतथा च मां प्रवर्तन्तं किं गर्हस्यलकाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074339, "chapter_id": 2569, "verse_number": "१२-७४-१८", "content_sanskrit": "ततोऽब्रवीद्वैश्रवणो राजानं सपुरोहितम्।\nनाहं राज्यमनिर्दिष्टं कस्मैचिद्विदधाम्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074340, "chapter_id": 2569, "verse_number": "१२-७४-१९", "content_sanskrit": "नाच्छिन्दे वाऽप्यनिर्दिष्टमिति जानीहि पार्थिव।\nप्रशाधि पृथिवीं कृत्स्नां मद्दत्तामखिलामिमाम्।\n[एवमुक्तः प्रत्युवाच मुचुकुन्दो महीपतिः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074341, "chapter_id": 2569, "verse_number": "१२-७४-२०", "content_sanskrit": "नाहं राज्यं भवद्दत्तं भोक्तुमिच्छामि पार्थिव।\nबाहुवीर्यार्जितं राज्यमश्नीयामिति कामये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074342, "chapter_id": 2569, "verse_number": "१२-७४-२१x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074343, "chapter_id": 2569, "verse_number": "१२-७४-२१", "content_sanskrit": "ततो वैश्रवणो राजा विस्मयं परमं ययौ।\nक्षत्रधर्मे स्थितं दृष्ट्वा मुचुकुन्दमरिन्दमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074344, "chapter_id": 2569, "verse_number": "१२-७४-२२", "content_sanskrit": "ततो राजा मुचुकुन्दः सोन्वशासद्वसुंधराम्।\nबाहुवीर्यार्जितां सम्यक्क्षत्रधर्ममनुव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074345, "chapter_id": 2569, "verse_number": "१२-७४-२३", "content_sanskrit": "एवं यो ब्रह्मविद्राजा ब्रह्मपूर्वं प्रवर्तते।\nस भुङ्क्ते विजितामुवीं यशश्च महदश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074346, "chapter_id": 2569, "verse_number": "१२-७४-२४", "content_sanskrit": "नित्योदकी ब्राह्मणः स्यान्नित्यशस्त्रश्च क्षत्रियः।\nतयोर्हि सर्वमायत्तं यत्किंचिज्जगतीगतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074347, "chapter_id": 2569, "verse_number": "१२-७४-२५", "content_sanskrit": "यशश्च तेजश्व महीं च कृत्स्नां\nप्राप्नोति राजन्विपुलां च कीर्तिम्।\nप्रधानधर्मं नृपते नियच्छ\nतथा च धर्मस्य चतुर्थमंशम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074348, "chapter_id": 2569, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि चतुःसप्ततितमोऽध्यायः॥ ७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]