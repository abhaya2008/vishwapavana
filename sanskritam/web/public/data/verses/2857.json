[{"id": 2087635, "chapter_id": 2857, "verse_number": "१२-३६२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087636, "chapter_id": 2857, "verse_number": "१२-३६२-१", "content_sanskrit": "धर्माः पितामहेनोक्ता मोक्षधर्माश्रिताः शुभाः।\nधर्ममाश्रमिणां श्रेष्ठं वक्तुमर्हति मे भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087637, "chapter_id": 2857, "verse_number": "१२-३६२-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087638, "chapter_id": 2857, "verse_number": "१२-३६२-२", "content_sanskrit": "सर्वत्र विहितो धर्मः सत्यः सत्यफलोदयः।\nबहुद्वारस्य धर्मस्य नेहास्ति विफला क्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087639, "chapter_id": 2857, "verse_number": "१२-३६२-३", "content_sanskrit": "यस्मिन्यस्मिंश्च विषये यो यो याति विनिश्चयम्।\nस तमेवाभिजानाति नान्यं भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087640, "chapter_id": 2857, "verse_number": "१२-३६२-४", "content_sanskrit": "इमां च त्वं नरव्याघ्र श्रोतुमर्हसि मे कथाम्।\nपुरा शक्रस्य कथितां नारदेन महर्षिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087641, "chapter_id": 2857, "verse_number": "१२-३६२-५", "content_sanskrit": "महर्षिर्नारदो राजन्सिद्धस्त्रैलोक्यसंमतः।\nपर्येति क्रमशो लोकान्वायुरव्याहतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087642, "chapter_id": 2857, "verse_number": "१२-३६२-६", "content_sanskrit": "स कदाचिन्महेष्वास देवराजालयं गतः।\nसत्कृतश्च महेन्द्रेण प्रत्यासन्नगतोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087643, "chapter_id": 2857, "verse_number": "१२-३६२-७", "content_sanskrit": "तं कृतक्षणमासीनं पर्यपृच्छच्छत्तीपतिः।\nमहर्षे किंचिदाश्चर्यमस्ति दृष्टं त्वयाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087644, "chapter_id": 2857, "verse_number": "१२-३६२-८", "content_sanskrit": "दृष्टमेव हि विप्रर्षे त्रैलोक्यं सचराचरम्।\nजातकौतूहलो नित्यं सिद्धश्चरसि साक्षिवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087645, "chapter_id": 2857, "verse_number": "१२-३६२-९", "content_sanskrit": "न ह्यस्त्यविदितं लोके देवर्षे तव किंचन।\nश्रुतं वाऽप्यनुभूतं वा दृष्टं वा कथयस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087646, "chapter_id": 2857, "verse_number": "१२-३६२-१०", "content_sanskrit": "तस्मै राजन्सुरेन्द्राय नारदो वदतांवरः।\nआसीनायोपपन्नाय प्रोक्तवान्विपुलां कथाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087647, "chapter_id": 2857, "verse_number": "१२-३६२-११", "content_sanskrit": "यथा येन च कल्पेन स तस्मै द्विजसत्तमः।\nकथां कथितवान्पृष्टस्तथा त्वमपि मे शृणु॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087648, "chapter_id": 2857, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि द्विषष्ट्यधिकत्रिशततमोऽध्यायः॥ ३६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]