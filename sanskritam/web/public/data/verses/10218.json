[{"id": 6000218000, "chapter_id": 10218, "verse_number": null, "content_sanskrit": "अथ द्वाविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000218001, "chapter_id": 10218, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.001.m4a", "display_order": 2}, {"id": 6000218002, "chapter_id": 10218, "verse_number": "१०-२२-१", "content_sanskrit": "भगवानपि तत्रैव बलदेवेन संयुतः।\nअपश्यन्निवसन् गोपानिन्द्रयागकृतोद्यमान्॥ १०/२२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णेन इन्द्रमुद्दिश्य नन्दादिभिः क्रियमाणं मखं व्यावर्त्य गोवर्धनपर्वतमुद्दिश्य मखप्रवर्तनम्", "range": "१–३८"}]}, {"id": 6000218003, "chapter_id": 10218, "verse_number": "१०-२२-२", "content_sanskrit": "तदभिज्ञोऽपि भगवान् सर्वात्मा सर्वदर्शनः।\nप्रश्रयावनतोऽपृच्छद् वृद्धान् नन्दपुरोगमान्॥ १०/२२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.003.m4a", "display_order": 4}, {"id": 6000218004, "chapter_id": 10218, "verse_number": "१०-२२-३", "content_sanskrit": "कथ्यतां मे पितः कोऽयं सम्भ्रमो व उपागतः।\nकिं फलं कस्य चोद्देशः केन वा साध्यते मखः॥ १०/२२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.004.m4a", "display_order": 5}, {"id": 6000218005, "chapter_id": 10218, "verse_number": "१०-२२-४", "content_sanskrit": "एतद् ब्रूहि महान् कामो मह्यं शुश्रूषवे पितः।\nन हि गोप्यं हि साधूनां कीर्त्यं सर्वात्मना त्विह॥ १०/२२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.005.m4a", "display_order": 6}, {"id": 6000218006, "chapter_id": 10218, "verse_number": "१०-२२-५", "content_sanskrit": "अस्त्यस्वपरदृष्टीनाममित्रोदासविद्विषाम्।\nउदासीनोऽरिवद् वर्ज्य आत्मवत् सुहृदुच्यते॥ १०/२२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.006.m4a", "display_order": 7}, {"id": 6000218007, "chapter_id": 10218, "verse_number": "१०-२२-६", "content_sanskrit": "ज्ञात्वाऽज्ञात्वा च कर्माणि जनोऽयमनुतिष्ठते।\nविदुषः कर्मसिद्धिः स्यात् तथा नाविदुषो भवेत्॥ १०/२२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.007.m4a", "display_order": 8}, {"id": 6000218008, "chapter_id": 10218, "verse_number": "१०-२२-७", "content_sanskrit": "तत्र तावत् क्रियायोगा भवता किं विचारिताः।\nअथवा लौकिकास्तन्मे पृच्छतः साधु भण्यताम्॥ १०/२२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.008.m4a", "display_order": 9}, {"id": 6000218009, "chapter_id": 10218, "verse_number": null, "content_sanskrit": "नन्द उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.009.m4a", "display_order": 10}, {"id": 6000218010, "chapter_id": 10218, "verse_number": "१०-२२-८", "content_sanskrit": "पर्जन्यो भगवानिन्द्रो मेघास्तस्यात्ममूर्तयः।\nअभिवर्षन्ति भूतानां प्राणनं जीवनं पयः॥ १०/२२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.010.m4a", "display_order": 11}, {"id": 6000218011, "chapter_id": 10218, "verse_number": "१०-२२-९", "content_sanskrit": "तत् तात वयमन्ये च वार्मुचां पतिमीश्वरम्।\nद्रव्यैस्तद्रेतसा सिद्धैर्यजन्ते क्रतुभिर्नराः॥ १०/२२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.011.m4a", "display_order": 12}, {"id": 6000218012, "chapter_id": 10218, "verse_number": "१०-२२-१०", "content_sanskrit": "तच्छेषेणोपजीवन्ति त्रिवर्गफलहेतवे।\nपुंसां पुरुषकाराणां पर्जन्यः फलभावनः॥ १०/२२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.012.m4a", "display_order": 13}, {"id": 6000218013, "chapter_id": 10218, "verse_number": "१०-२२-११", "content_sanskrit": "य एवं विसृजेद् धर्मं पारम्पर्यागतं नरः।\nकामाल्लोभाद् भयाद् द्वेषात् स वै नाप्नोति शोभनम्॥ १०/२२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.013.m4a", "display_order": 14}, {"id": 6000218014, "chapter_id": 10218, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.014.m4a", "display_order": 15}, {"id": 6000218015, "chapter_id": 10218, "verse_number": "१०-२२-१२", "content_sanskrit": "वचो निशम्य नन्दस्य तथाऽन्येषां व्रजौकसाम्।\nइन्द्राय मन्युं जनयन् पितरं प्राह केशवः॥ १०/२२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.015.m4a", "display_order": 16}, {"id": 6000218016, "chapter_id": 10218, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.016.m4a", "display_order": 17}, {"id": 6000218017, "chapter_id": 10218, "verse_number": "१०-२२-१३", "content_sanskrit": "कर्मणा जायते जन्तुः कर्मणैव प्रलीयते।\nसुखं दुःखं भयं मोक्षं कर्मणैवाभिपद्यते॥ १०/२२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.017.m4a", "display_order": 18}, {"id": 6000218018, "chapter_id": 10218, "verse_number": "१०-२२-१४", "content_sanskrit": "अस्ति चेदीश्वरः कश्चित् फलरूपः स कर्मणः।\nकर्तारं भजते सोऽपि न ह्यकर्तुः प्रभुर्हि सः॥ १०/२२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.018.m4a", "display_order": 19}, {"id": 6000218019, "chapter_id": 10218, "verse_number": "१०-२२-१५", "content_sanskrit": "किमिन्द्रेणेह भूतानां स्वस्वकर्मानुवर्तिनाम्।\nअनीशेनान्यथाकर्तुं स्वभावविहितं नृणाम्॥ १०/२२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.019.m4a", "display_order": 20}, {"id": 6000218020, "chapter_id": 10218, "verse_number": "१०-२२-१६", "content_sanskrit": "स्वभावतन्त्रो हि जनः स्वभावमनुवर्तते।\nस्वभावस्थमिदं सर्वं सदेवासुरमानुषम्॥ १०/२२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.020.m4a", "display_order": 21}, {"id": 6000218021, "chapter_id": 10218, "verse_number": "१०-२२-१७", "content_sanskrit": "देहानुच्चावचान् जन्तुः प्राप्योत्सृजति कर्मणा।\nशत्रुर्मित्रमुदासीनः कर्मैव गुरुरीश्वरः॥ १०/२२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.021.m4a", "display_order": 22}, {"id": 6000218022, "chapter_id": 10218, "verse_number": "१०-२२-१८", "content_sanskrit": "तस्मात् सुपूजयेत् कर्म स्वभावस्थः स्वकर्मकृत्।\nअञ्जसा येन वर्तेत तदेवास्य हि दैवतम्॥ १०/२२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.022.m4a", "display_order": 23}, {"id": 6000218023, "chapter_id": 10218, "verse_number": "१०-२२-१९", "content_sanskrit": "वर्तेत ब्रह्मणा विप्रो राजन्यो रक्षया भुवः।\nवैश्यस्तु वार्तया जीवेच्छूद्रस्तु द्विजसेवया॥ १०/२२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.023.m4a", "display_order": 24}, {"id": 6000218024, "chapter_id": 10218, "verse_number": "१०-२२-२०", "content_sanskrit": "कृषिवाणिज्यगोरक्षाः कुसीदं तुर्यमुच्यते।\nवार्ता चतुर्विधा तत्र वयं गोवृत्तयोऽनिशम्॥ १०/२२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.024.m4a", "display_order": 25}, {"id": 6000218025, "chapter_id": 10218, "verse_number": "१०-२२-२१", "content_sanskrit": "सत्त्वं रजस्तम इति स्थित्युत्पत्त्यन्तहेतवः।\nरजसोत्पद्यते विश्वमन्योन्यं विविधं जगत्॥ १०/२२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.025.m4a", "display_order": 26}, {"id": 6000218026, "chapter_id": 10218, "verse_number": "१०-२२-२२", "content_sanskrit": "रजसा चोदिता मेघा वर्षन्त्यम्बूनि सर्वतः।\nप्रजास्तैरेव सिद्ध्यन्ति महेन्द्रः किं करिष्यति॥ १०/२२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.026.m4a", "display_order": 27}, {"id": 6000218027, "chapter_id": 10218, "verse_number": "१०-२२-२३", "content_sanskrit": "न नः पुरो जनपदा न ग्रामगृहिणो वयम्।\nवनौकसस्तात नित्यं काननाभिनिवासिनः॥ १०/२२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.027.m4a", "display_order": 28}, {"id": 6000218028, "chapter_id": 10218, "verse_number": "१०-२२-२४", "content_sanskrit": "आजीव्यैकतरं भावं यस्त्वन्यमुपधावति।\nन तस्माद् विन्दते क्षेमं जारं नार्यसती यथा॥ १०/२२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.028.m4a", "display_order": 29}, {"id": 6000218029, "chapter_id": 10218, "verse_number": "१०-२२-२५", "content_sanskrit": "तस्माद् गवां ब्राह्मणानामद्रेश्चारभ्यतां मखः।\nय इन्द्रयागसम्भारास्तैरयं साध्यतां मखः॥ १०/२२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.029.m4a", "display_order": 30}, {"id": 6000218030, "chapter_id": 10218, "verse_number": "१०-२२-२६", "content_sanskrit": "पच्यन्तां विविधाः पाकाः सूपान्धःपायसादयः।\nसंयावापूपशष्कुल्यः सर्वदोहश्च गृह्यताम्॥ १०/२२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.030.m4a", "display_order": 31}, {"id": 6000218031, "chapter_id": 10218, "verse_number": "१०-२२-२७", "content_sanskrit": "हूयन्तामग्नयः सम्यग् ब्राह्मणैर्ब्रह्मवादिभिः।\nअन्नं बहुगुणं तेभ्यो दीयतां धेनुदक्षिणाः॥ १०/२२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.031.m4a", "display_order": 32}, {"id": 6000218032, "chapter_id": 10218, "verse_number": "१०-२२-२८", "content_sanskrit": "अन्येभ्यश्चाश्वचाण्डालपतितेभ्यो यथार्हतः।\nयवसं च गवां दत्वा गिरये दीयतां बलिः॥ १०/२२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.032.m4a", "display_order": 33}, {"id": 6000218033, "chapter_id": 10218, "verse_number": "१०-२२-२९", "content_sanskrit": "स्वलङ्कृता भुक्तवन्तः स्वनुलिप्ताः सुवाससः।\nप्रदक्षिणं च कुरुत गोविप्रानलपर्वतान्॥ १०/२२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.033.m4a", "display_order": 34}, {"id": 6000218034, "chapter_id": 10218, "verse_number": "१०-२२-३०", "content_sanskrit": "एतन्मम मतं तात क्रियतां यदि रोचते।\nअयं गोब्राह्मणाद्रीणां मह्यं च दयितो मखः॥ १०/२२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.034.m4a", "display_order": 35}, {"id": 6000218035, "chapter_id": 10218, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.035.m4a", "display_order": 36}, {"id": 6000218036, "chapter_id": 10218, "verse_number": "१०-२२-३१", "content_sanskrit": "कालात्मना भगवता शक्रदर्पजिघांसया।\nप्रोक्तं निशम्य नन्दाद्याः साध्वगृह्णन्त तद्वचः॥ १०/२२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.036.m4a", "display_order": 37}, {"id": 6000218037, "chapter_id": 10218, "verse_number": "१०-२२-३२", "content_sanskrit": "तथा च विदधुः सर्वे यथाऽऽह मधुसूदनः।\nवाचयित्वा स्वस्त्ययनं द्रव्यैर्गोविप्रभूभृताम्॥ १०/२२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.037.m4a", "display_order": 38}, {"id": 6000218038, "chapter_id": 10218, "verse_number": "१०-२२-३३", "content_sanskrit": "उपहृत्य बलीन् सर्वानादृता यवसं गवाम्।\nगोधनानि पुरस्कृत्य गिरिं चक्रुः प्रदक्षिणम्॥ १०/२२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.038.m4a", "display_order": 39}, {"id": 6000218039, "chapter_id": 10218, "verse_number": "१०-२२-३४", "content_sanskrit": "अनांस्यनडुद्युक्तानि ते चारुह्य स्वलङ्कृताः।\nगोप्यश्च कृष्णवीर्याणि गायन्त्यः सद्विजाशिषः॥ १०/२२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.039.m4a", "display_order": 40}, {"id": 6000218040, "chapter_id": 10218, "verse_number": "१०-२२-३५", "content_sanskrit": "कृष्णस्त्वन्यतमं रूपं गोपविश्रम्भणं गतः।\nशैलोऽस्मीति ब्रुवन् भूरि बलिमादद् बृहद्वपुः॥ १०/२२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.040.m4a", "display_order": 41}, {"id": 6000218041, "chapter_id": 10218, "verse_number": "१०-२२-३६", "content_sanskrit": "तस्मै नमो व्रजजनैः स चक्रे ह्यात्मनाऽऽत्मने।\nअहो पश्यत शैलोऽसौ रूपी नोऽनुग्रहं व्यधात्॥ १०/२२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.041.m4a", "display_order": 42}, {"id": 6000218042, "chapter_id": 10218, "verse_number": "१०-२२-३७", "content_sanskrit": "एषोऽवजानतो मर्त्यान् कामरूपी वनेचरः।\nहन्ति ह्यस्मै नमस्यामः शर्मणे आत्मनो गवाम्॥ १०/२२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.042.m4a", "display_order": 43}, {"id": 6000218043, "chapter_id": 10218, "verse_number": "१०-२२-३८", "content_sanskrit": "इत्यद्रिगोद्विजमखं वासुदेवप्रचोदिताः।\nयथा विधाय गोपालाः सहकृष्णा व्रजं ययुः॥ १०/२२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_022/BhP_10.022.043.m4a", "display_order": 44}, {"id": 6000218044, "chapter_id": 10218, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे द्वाविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]