[{"id": 7006159000, "chapter_id": 26159, "verse_number": "१-२-२०-१", "content_sanskrit": "सूत उवाच ।\nएतदुक्वा महाबुद्धिर्वायुर्ल्लोकहिते रतः ।\nज्जाप जप्यं भगवान्मध्यं प्राप्ते दिवाकरे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006159001, "chapter_id": 26159, "verse_number": "१-२-२०-२", "content_sanskrit": "ऋषयश्चापि ते सर्वे ये तत्रासन्समागताः ।\nते सर्वे नियतात्मानस्तस्थुः प्रांजलयस्तथा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006159002, "chapter_id": 26159, "verse_number": "१-२-२०-३", "content_sanskrit": "य इज्यो नियमस्यांते प्राणिनां जीवनः प्रभुः ।\nनीलकंठ नमस्तेऽस्तु इत्युवाच सदागतिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006159003, "chapter_id": 26159, "verse_number": "१-२-२०-४", "content_sanskrit": "श्रुत्वा तु भावितात्मानो मुनयः शंसितव्रताः ।\nवालखिल्येति विख्याताः पतंगसहचारिणः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006159004, "chapter_id": 26159, "verse_number": "१-२-२०-५", "content_sanskrit": "अष्टाशीतिसहस्रामि ऋषीणामूर्ध्वरेतसाम् ।\nते स्म पृच्छंति वायु च वायुपर्णांबु भोजनाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006159005, "chapter_id": 26159, "verse_number": "१-२-२०-६", "content_sanskrit": "नीलकंठेति यत्प्रोक्तं त्वया पवनसत्तम ।\nएतद्गुह्यं पवित्राणां पुष्णं पुण्यविदां वरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006159006, "chapter_id": 26159, "verse_number": "१-२-२०-७", "content_sanskrit": "तद्वयं श्रोतुमिच्छाम स्तन्नो निगद सत्तम ।\nतत्सर्व श्रोतुमिच्छामस्त्वत्प्रसादात्प्रभंजन ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006159007, "chapter_id": 26159, "verse_number": "१-२-२०-८", "content_sanskrit": "नीलता येन कंठस्य कारणेनांविकापतेः ।\nश्रोतुमिच्छामहे देव तव वक्त्राद्विशेषतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006159008, "chapter_id": 26159, "verse_number": "१-२-२०-९", "content_sanskrit": "यावद्वाचः प्रवर्त्तंते सर्वास्ताः प्रेरितस्त्वया ।\nवर्णस्थानगते वायो वाग्विधिः संप्रवर्त्तते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006159009, "chapter_id": 26159, "verse_number": "१-२-२०-१०", "content_sanskrit": "ज्ञान पूर्वमथोत्साहस्त्वत्तो वायो प्रवर्त्तते ।\nत्वयि निष्पूयमाने तु शेषा वर्णप्रवृत्तयः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006159010, "chapter_id": 26159, "verse_number": "१-२-२०-११", "content_sanskrit": "यत्र वाचो निवर्त्तंते देहवर्णाश्च दुर्लभाः ।\nत्वत्तो हि वर्णसद्भावः सर्वगस्त्वं सदानिल ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006159011, "chapter_id": 26159, "verse_number": "१-२-२०-१२", "content_sanskrit": "नान्यः सर्वगतो देवस्त्वदृतेऽस्ति समीरण ।\nएष वै जीवलोकस्ते प्रत्यक्षः सर्वतोऽनिल ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006159012, "chapter_id": 26159, "verse_number": "१-२-२०-१३", "content_sanskrit": "वेत्थ वाचस्पतिं देवं मनोनायकमीश्वरम् ।\nब्रूहि तत्कंठदेशे तु किं कृत्वा रूपविक्रिया ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006159013, "chapter_id": 26159, "verse_number": "१-२-२०-१४", "content_sanskrit": "वचः श्रुत्वा ततस्तेषां मुनीनां भावितात्मनाम ।\nप्रत्युवाच महातेजा वायुर्ल्लोकनमस्कृतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006159014, "chapter_id": 26159, "verse_number": "१-२-२०-१५", "content_sanskrit": "पुरा कृतयुगे विप्रो वेदनिर्णयतत्परः ।\nवसिष्ठो नाम धर्मात्मा मानसो वै प्रजापतिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006159015, "chapter_id": 26159, "verse_number": "१-२-२०-१६", "content_sanskrit": "पप्रच्छ कार्त्तिकेयं वै मयूरवरवाहनम् ।\nमहिषासुरनारीणां नयनांजनतस्करम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006159016, "chapter_id": 26159, "verse_number": "१-२-२०-१७", "content_sanskrit": "महासेनं महात्मनं मेघस्तनितनिस्वनम् ।\nउमामनः प्रहर्षाणां बारकच्छद्मरूपिणम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006159017, "chapter_id": 26159, "verse_number": "१-२-२०-१८", "content_sanskrit": "क्रौंचजीवितहर्तारं गौरीहृदयनंदनम् ।\nयदेतद्दृश्यते वर्य शुभ्रं शुभ्रांजनोपमम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006159018, "chapter_id": 26159, "verse_number": "१-२-२०-१९", "content_sanskrit": "तत्किमर्थं समुत्पन्नं कंठे कंठेकुंदेंदुसप्रभे ।\nएतद्दीप्तांय दांताय भक्ताय ब्रूहि पृच्छते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006159019, "chapter_id": 26159, "verse_number": "१-२-२०-२०", "content_sanskrit": "कथां मंगलसंयुक्तां पवित्रां पापनाशिनीम् ।\nमत्प्रियार्थंमहाभाग वक्तुमर्हस्यशेषतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006159020, "chapter_id": 26159, "verse_number": "१-२-२०-२१", "content_sanskrit": "श्रुत्वा वाक्यं ततस्तस्य वसिष्ठस्य महात्मनः ।\nप्रत्युवाच महातेजा देवारिबलसूदनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006159021, "chapter_id": 26159, "verse_number": "१-२-२०-२२", "content_sanskrit": "श्रृणुष्व वदतां श्रेष्टकथ्यमानं वचो मम ।\nउमोत्संगोपविष्टेन यथापूर्वं मया श्रुतम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006159022, "chapter_id": 26159, "verse_number": "१-२-२०-२३", "content_sanskrit": "पार्वत्या सह संवादः शर्वस्य च महात्मनः ।\nतमहं संप्रवक्ष्यामि त्वत्प्रियार्थं महामुने ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006159023, "chapter_id": 26159, "verse_number": "१-२-२०-२४", "content_sanskrit": "कैलासशिखरे रम्ये नानाधातुविचित्रिते ।\nतरुणादित्यसंकाशे तप्तचामीकरप्रभे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006159024, "chapter_id": 26159, "verse_number": "१-२-२०-२५", "content_sanskrit": "वज्रस्फटिकसोपाने चित्रपादशिलातले ।\nजांबूनदमये दिव्ये नानाधातु विचित्रिते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006159025, "chapter_id": 26159, "verse_number": "१-२-२०-२६", "content_sanskrit": "नानाद्रुमलताकीर्णे नानापुष्पफलोपगे ।\nहंसकारंडवाकीर्णे चक्रवाकोपशोभिते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006159026, "chapter_id": 26159, "verse_number": "१-२-२०-२७", "content_sanskrit": "षट्पदोद्गीतबहुले धारासंपातनादिते ।\nमत्तक्रौंचमयूराणां नादैर्विक्रुष्टकंदरे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006159027, "chapter_id": 26159, "verse_number": "१-२-२०-२८", "content_sanskrit": "अप्सरोगणसंकीर्णे किन्नरैरुपशोभिते ।\nजीवं जीवकजातीनां विरावैरुपकूजिते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006159028, "chapter_id": 26159, "verse_number": "१-२-२०-२९", "content_sanskrit": "कोकिलारावबहुले सिद्धचारणसेविते ।\nसौरभेयनिनादाढ्यं मेघस्तनितनिस्वने ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006159029, "chapter_id": 26159, "verse_number": "१-२-२०-३०", "content_sanskrit": "विनायकभयोद्विग्नकुं जरैर्मुक्तकंदरैः ।\nवीणावादित्रनिर्घेषैः श्रोत्रेंद्रियमनोरमैः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006159030, "chapter_id": 26159, "verse_number": "१-२-२०-३१", "content_sanskrit": "दोलालंबितसंघाते वनितासंघसेविते ।\nध्वजालंबितदोलानां घंटानां निनदाकुले ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006159031, "chapter_id": 26159, "verse_number": "१-२-२०-३२", "content_sanskrit": "वल्लकीवेणुबहुले त्रिंशद्बर्हिणसंकुले ।\nमुखमर्द्दलवादित्रैर्वलितास्फोटितैस्तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006159032, "chapter_id": 26159, "verse_number": "१-२-२०-३३", "content_sanskrit": "क्रीडावेगविवादानां निर्घोषैः पूर्णकंदरे ।\nहंसैः परावतैश्चैव बकराजैः सुखस्थिते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006159033, "chapter_id": 26159, "verse_number": "१-२-२०-३४", "content_sanskrit": "देहबंधैर्विचित्रैश्चप्रक्रीडितगणेश्वरे ।\nसिंहव्याघ्रमुखैर्घोरवाशितैश्चंडवेगितैः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006159034, "chapter_id": 26159, "verse_number": "१-२-२०-३५", "content_sanskrit": "मृगमषमुखैश्चान्यैर्गजवाजिमुखैस्तथा ।\nबिडालवदनैश्चोग्रैः क्रोष्टुकाकारसूर्त्तिभिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006159035, "chapter_id": 26159, "verse_number": "१-२-२०-३६", "content_sanskrit": "ह्रस्वैर्दीर्घैश्च सुकृशैर्लंबोदरमहीदरैः ।\nह्रस्वजंघैः प्रलेबोष्ठैस्तालजंघैस्तथापरैः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006159036, "chapter_id": 26159, "verse_number": "१-२-२०-३७", "content_sanskrit": "गोकर्णैरेककर्णैश्च महाकर्णैरकर्णकैः ।\nबहुपादैर्महापादैरेकपादैरपादकैः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006159037, "chapter_id": 26159, "verse_number": "१-२-२०-३८", "content_sanskrit": "बहुनेत्रैर्महानेत्रैरेकनेत्रैरनेत्रकैः ।\nएकदंष्ट्रैर्महादंष्ट्रैर्बहुदंष्ट्रैरदंष्ट्रकैः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006159038, "chapter_id": 26159, "verse_number": "१-२-२०-३९", "content_sanskrit": "एकशीर्षैर्महाशीर्षबहुशीर्षैरशीर्षकैः ।\nएकजिह्वैर्महाजिह्वैर्बहुजिह्वैरजिह्वकैः ।\nएवंरूपैर्महायोगैभूतर्भूतपतिर्वृतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006159039, "chapter_id": 26159, "verse_number": "१-२-२०-४०", "content_sanskrit": "विशुद्धमुक्तामणिरत्नभूषिते शिलातले स्वर्णमये सुरम्यके ।\nसुखोपविष्टं मदनागनाशनं प्रोवाच वाक्यं गिरिराजपुत्री ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006159040, "chapter_id": 26159, "verse_number": "१-२-२०-४१", "content_sanskrit": "भगवन्भूतभव्येश गोवृषांकितशासन ।\nतव कंठे महादेव भ्राजतेंबुदसन्निभम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006159041, "chapter_id": 26159, "verse_number": "१-२-२०-४२", "content_sanskrit": "नात्युल्बणं शुभंशुभ्रे नीलाबुजचयोपमम् ।\nकिमिदं दीप्यते देव कंठे कामांगनाशन ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006159042, "chapter_id": 26159, "verse_number": "१-२-२०-४३", "content_sanskrit": "को हेतुः कारणं किं वा कंठे नीलस्त्त्वमीश्वर ।\nएतत्सर्वं यथान्यायं बूहि कौतूहलं हि मे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006159043, "chapter_id": 26159, "verse_number": "१-२-२०-४४", "content_sanskrit": "श्रुत्वा वाक्यं ततस्तस्याः पार्वत्याः पावतीप्रियः ।\nकथां मंगलसंयुक्तां कथयामास शंकरः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006159044, "chapter_id": 26159, "verse_number": "१-२-२०-४५", "content_sanskrit": "महेश्वर उवाच ।\nमथ्यमानेऽमृते पूर्वं क्षीरोदे सुरदानवैः ।\nअग्रे समुत्थितं घोरं विषंकालानलप्रभम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006159045, "chapter_id": 26159, "verse_number": "१-२-२०-४६", "content_sanskrit": "तं दृष्ट्वा सुरसंघस्च दैत्याश्चैव वरानने ।\nविषण्णवदनाः सर्वे गतास्ते ब्रह्मणोऽन्तकम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006159046, "chapter_id": 26159, "verse_number": "१-२-२०-४७", "content_sanskrit": "दृष्ट्वा सुरगणान्भीतान्ब्रह्मोवाच महाद्युतिः ।\nकिमर्थं वै महाभागा भीता उद्विग्नचेतनाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006159047, "chapter_id": 26159, "verse_number": "१-२-२०-४८", "content_sanskrit": "मया त्रिगुणमैश्वर्यं भवतां संप्रकल्पितम् ।\nतेन व्यावर्त्तितैश्वर्या यूयं भो सुरसत्तमाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006159048, "chapter_id": 26159, "verse_number": "१-२-२०-४९", "content_sanskrit": "त्रलोक्यस्येश्वरा यूयं सर्वे वै विगतज्वराः ।\nप्रजासर्गे न सोऽस्तीह यश्चाज्ञां मेऽतिवर्तयेत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006159049, "chapter_id": 26159, "verse_number": "१-२-२०-५०", "content_sanskrit": "विमानचारिण सर्वे सर्वे स्वच्छंदगामिनः ।\nआध्यात्मिके चाधिभूते अधिदैवे च नित्यशः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006159050, "chapter_id": 26159, "verse_number": "१-२-२०-५१", "content_sanskrit": "प्रजाः कर्मविपाकेन शक्ता यूयं प्रवर्त्तितुम् ।\nतत्किमर्थं भयोद्विग्ना मृगाः सिंहार्दिता इव ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006159051, "chapter_id": 26159, "verse_number": "१-२-२०-५२", "content_sanskrit": "किं दुःशं कोऽनुसंतापः कुतो वा भयमागतम् ।\nएतत्सर्वं यथान्यायं शीघ्रमाख्या तुमर्हथ ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006159052, "chapter_id": 26159, "verse_number": "१-२-२०-५३", "content_sanskrit": "श्रुत्वा वाक्यं ततस्तस्य ब्रह्मणः परमात्मनः ।\nऊचुस्ते ऋषिभिः सार्द्धं सुरदैत्येंद्रदानवाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006159053, "chapter_id": 26159, "verse_number": "१-२-२०-५४", "content_sanskrit": "सुरासुरैर्मथ्यमाने पजोराशौ पितमाह ।\nभुजंगभृंगसंकाशं नीलजीमूतसन्निभम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006159054, "chapter_id": 26159, "verse_number": "१-२-२०-५५", "content_sanskrit": "प्रादुर्भूतं विषं घोरं संवर्ताग्निसमप्रभम् ।\nकालमृत्युरिवोद्भूतं युगांतादित्यवर्चसम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006159055, "chapter_id": 26159, "verse_number": "१-२-२०-५६", "content_sanskrit": "त्रैलोक्योत्सादसूर्याभं विस्फुरत्तत् समंततः ।\nविषेणोत्तिष्ठमानेन कालानलसमत्विषा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006159056, "chapter_id": 26159, "verse_number": "१-२-२०-५७", "content_sanskrit": "निर्दग्धो रक्तगौरांगो कृतः कृष्णो जनार्द्दनः ।\nतं दृष्ट्वा रक्तगौरांगं कृतं कृष्णं जनार्द्दनम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006159057, "chapter_id": 26159, "verse_number": "१-२-२०-५८", "content_sanskrit": "ततः सर्वे वयं भीतास्त्वा मेव शरणं गताः ।\nसुराणामसुराणां च श्रुत्वा वाक्यं भयावहम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006159058, "chapter_id": 26159, "verse_number": "१-२-२०-५९", "content_sanskrit": "प्रत्युवाच महातेजा ब्रह्मा लोकपितामहः ।\nश्रृण्वंतु देवताः सर्वे ऋषयश्च तपोधनाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006159059, "chapter_id": 26159, "verse_number": "१-२-२०-६०", "content_sanskrit": "यत्तदग्रे समुत्पन्नं मथ्यमाने महोदधौ ।\nविषं कालानलप्रख्यं कालकूटमिति श्रुतम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006159060, "chapter_id": 26159, "verse_number": "१-२-२०-६१", "content_sanskrit": "येन प्रोद्भूतमात्रेण न व्यराजंत देवताः ।\nतस्य विष्णुरहं वापि सर्वे वा सुरपुंगवाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006159061, "chapter_id": 26159, "verse_number": "१-२-२०-६२", "content_sanskrit": "न शक्नुवंति वै सोढुं वेगमन्यत्र शंकरात् ।\nइत्युक्त्वा पद्मगर्भाभः पद्मायोनिरयोनिजः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006159062, "chapter_id": 26159, "verse_number": "१-२-२०-६३", "content_sanskrit": "ओंकारं समनुस्मृत्य ध्यायञ्जयोतिः समंततः ।\nततः स्तोतुं समारब्धो ब्रह्मा वेद विदां वरः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006159063, "chapter_id": 26159, "verse_number": "१-२-२०-६४", "content_sanskrit": "नमस्तुभ्यं विरूपाक्ष नमस्ते दिव्यचक्षुषे ।\nनमः पिनाकहस्ताय वज्रहस्ताय वै नमः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006159064, "chapter_id": 26159, "verse_number": "१-२-२०-६५", "content_sanskrit": "नमस्त्रैलोक्य नाथाय भूतानां पतये नमः ।\nनमः सुरारिहंत्रे च सोमसूर्याग्निचक्षुषे ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006159065, "chapter_id": 26159, "verse_number": "१-२-२०-६६", "content_sanskrit": "ब्रह्मणे चैव रुद्राय विष्णवे चैव ते नमः ।\nसांख्याय चैव योगाय भूतग्रामाय वै नमः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006159066, "chapter_id": 26159, "verse_number": "१-२-२०-६७", "content_sanskrit": "मन्मथांगविनाशाय कालपृष्ठाय वै नमः ।\nसुरेतसेऽथ रुद्राय देवदेवाय रंहसे ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006159067, "chapter_id": 26159, "verse_number": "१-२-२०-६८", "content_sanskrit": "कपर्दिने करालाय शंकराय हराय च ।\nकपालिने विरूपाय शिवाय वरदाय च ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006159068, "chapter_id": 26159, "verse_number": "१-२-२०-६९", "content_sanskrit": "त्रिपुरघ्नमखघ्नाय मातॄणां पतये नमः ।\nवृद्धाय चैव शुद्धाय मुक्तायैव बलाय च ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006159069, "chapter_id": 26159, "verse_number": "१-२-२०-७०", "content_sanskrit": "लोकत्रयैकवीराय चंद्राय वरुणाय च ।\nअग्राय चैव चोग्राय विप्रायानेकचक्षुषे ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006159070, "chapter_id": 26159, "verse_number": "१-२-२०-७१", "content_sanskrit": "रजसे चैव सत्त्वाय नमस्तेऽव्यक्तयोनये ।\nनित्याय चैवानित्याय नित्यानित्याय वै नमः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006159071, "chapter_id": 26159, "verse_number": "१-२-२०-७२", "content_sanskrit": "व्यक्ताय चैवाव्यक्ताय व्यक्ताव्यक्ताय वै नमः ।\nचिंत्याय चैवाचिंत्याय चिंत्याचिंत्याय वै नमः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006159072, "chapter_id": 26159, "verse_number": "१-२-२०-७३", "content_sanskrit": "जगतामार्त्तिनाशाय प्रियनारायणाय च ।\nउमाप्रियाय शर्वाय नंदिवक्त्रांकिताय च ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006159073, "chapter_id": 26159, "verse_number": "१-२-२०-७४", "content_sanskrit": "पक्षमासाह्द्धमासाय ऋतुसंवत्सराय च ।\nबहुरूपाय मुंडाय दंडिने च वरूथिने ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006159074, "chapter_id": 26159, "verse_number": "१-२-२०-७५", "content_sanskrit": "नमः कपालहस्ताय दिग्वासाय शिखंडिने ।\nधन्विने रथिने चैव यमिने ब्रह्मचारिणे ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006159075, "chapter_id": 26159, "verse_number": "१-२-२०-७६", "content_sanskrit": "ऋग्यजुः सामवेदाय पुरुषायेश्वराय च ।\nइत्येव मादिचरितैः स्तोत्रैः स्तुत्य नमीऽस्तु ते ।\nएवं स्तुत्वा ततो ब्रह्मा प्रणिपत्य वरानने ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006159076, "chapter_id": 26159, "verse_number": "१-२-२०-७७", "content_sanskrit": "ज्ञात्वा तु भक्तिं मम देवतानां गंगाजला स्फालितमुक्तकेशः ।\nसूक्ष्मोऽसि योगातिशयादचिंत्यो न हि प्रभो व्यक्तिमुफैषि रुद्रः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006159077, "chapter_id": 26159, "verse_number": "१-२-२०-७८", "content_sanskrit": "एवं भगवता पूर्वं ब्रह्मणा लोककर्तृणा ।\nस्तुतोऽहं विविधैः स्तोत्रैर्वेदवेदांगसंभवैः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006159078, "chapter_id": 26159, "verse_number": "१-२-२०-७९", "content_sanskrit": "ततोऽहं मुख्यया वाचा पितामहमथाब्रवम् ।\nभूतभव्यभवन्नाथ लोकनाथ जगत्पते ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006159079, "chapter_id": 26159, "verse_number": "१-२-२०-८०", "content_sanskrit": "किं कार्यं ते मया ब्रह्मन्कर्त्तव्यं वद सुव्रत ।\nश्रुत्वा वाक्यं ततो ब्रह्मा प्रत्युवाचांबुजेक्षणः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006159080, "chapter_id": 26159, "verse_number": "१-२-२०-८१", "content_sanskrit": "भूतभव्यभवन्नाथ श्रूयतां कारणेश्वर ।\nसुरासुरैर्मथ्यमाने पयोधौ पंकजेक्षण ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006159081, "chapter_id": 26159, "verse_number": "१-२-२०-८२", "content_sanskrit": "भगवन्मेघसंकाशं नीलजीमूतसन्निभम् ।\nप्रादुर्भूतं विषं घोरं संवर्त्ताग्निसमप्रभम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006159082, "chapter_id": 26159, "verse_number": "१-२-२०-८३", "content_sanskrit": "तं दृष्ट्वा च वयं सर्वे भीताः संभ्रांतचेतसः ।\nतत्पिबस्व महादेव लोकानां हितकाम्यया ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006159083, "chapter_id": 26159, "verse_number": "१-२-२०-८४", "content_sanskrit": "भवाञ्छक्तश्च भोक्ता वै भवान्देववरः प्रभो ।\nत्वदृतेऽन्यो महादेव वेगं सोढुं न विद्यते ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006159084, "chapter_id": 26159, "verse_number": "१-२-२०-८५", "content_sanskrit": "एवं तस्य वचः श्रुत्वा ब्रह्मणः परमेष्ठिनः ।\nबाढ मित्येव तद्वाक्यं प्रतिगृह्य वरानने ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006159085, "chapter_id": 26159, "verse_number": "१-२-२०-८६", "content_sanskrit": "ततोऽहं पातुमारब्धो विषमंतकसन्निभम् ।\nपिबतो मे महाघोरं विषं सुरभयप्रदम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006159086, "chapter_id": 26159, "verse_number": "१-२-२०-८७", "content_sanskrit": "कंठः समभवत्तूर्णं कृष्णो वै वरवर्णिनि ।\nतं दृष्ट्वोत्पलपत्राभं कंठसक्तमिवोरगम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006159087, "chapter_id": 26159, "verse_number": "१-२-२०-८८", "content_sanskrit": "तक्षकं नागराजानं लेलिहानमिवोत्थितम् ।\nअथोवाच महातेजा ब्रह्मा लोकपितामहः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006159088, "chapter_id": 26159, "verse_number": "१-२-२०-८९", "content_sanskrit": "शोभसे त्वं महादेव कंठेनानेन सुव्रत ।\nततस्तस्य वचःश्रुत्वा मया गिरिवरात्मजे ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006159089, "chapter_id": 26159, "verse_number": "१-२-२०-९०", "content_sanskrit": "कंठे धृतं विषं घोरं नीलकण्ठस्ततोऽस्म्यहम् ।\nपश्यतां सुरसंघानां दैत्यानां च वरानने ।\nयक्षगंधर्वभूतानां पिशाचोरगरक्षसाम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006159090, "chapter_id": 26159, "verse_number": "१-२-२०-९१", "content_sanskrit": "तत्कालकूटं विषमुग्रवेगं कंठे धृतं पर्वतराजपुत्रि ।\nनिवेश्यमानं सुरदैत्यसंघो दृष्ट्वा परं विस्मयमाजगाम ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006159091, "chapter_id": 26159, "verse_number": "१-२-२०-९२", "content_sanskrit": "ततः मुरगणाः सर्वे सदैत्योरगराक्षसाः ।\nऊचुः प्रांजलयो भूत्वा मत्तमातंगगामिनि ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006159092, "chapter_id": 26159, "verse_number": "१-२-२०-९३", "content_sanskrit": "अहोबलं वीर्यपराक्रमस्ते त्वहो वपुर्योगबलं तवेश ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006159093, "chapter_id": 26159, "verse_number": "१-२-२०-९४", "content_sanskrit": "अहो प्रभुत्वं तव देवदेव महाद्भुतं मन्मथदेहनाशन ।\nत्वमेव विष्णुश्चतुराननस्त्वं त्वमेव मृत्युर्वरदस्त्वमेव ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006159094, "chapter_id": 26159, "verse_number": "१-२-२०-९५", "content_sanskrit": "त्वमेव सूर्यो रजनीकरश्च व्यक्तिस्त्वमेवास्य चराचरस्य ।\nत्वमेव वह्निः पवनस्त्वमेव त्वमेव भूमिः सलिलं त्वमेव ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006159095, "chapter_id": 26159, "verse_number": "१-२-२०-९६", "content_sanskrit": "त्वमेव सर्वस्य चराचरस्य धाता विधाता प्रलयस्त्वमेव ।\nइत्येव मुक्त्वा वचनं सुरेंद्राः प्रगृह्य सोमं प्रणिपत्य मूर्ध्रा ।\nगता विमानैरनिलोपवेगैर्महानगं मेरुमुपेत्य सर्वे ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006159096, "chapter_id": 26159, "verse_number": "१-२-२०-९७", "content_sanskrit": "इत्येतत्परमं गुह्यं पुण्यात्पुण्यतमं महत् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006159097, "chapter_id": 26159, "verse_number": "१-२-२०-९८", "content_sanskrit": "नीलकंठ इति प्रोक्तं त्रिषु लोकेषु विश्रुतम् ।\nस्वयंभुवा स्वयं प्रोक्ता कथा पापप्रणाशिनी ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006159098, "chapter_id": 26159, "verse_number": "१-२-२०-९९", "content_sanskrit": "यस्तु धारयते नित्यं ब्रह्मोद्गीतामिमां शुभाम् ।\nतस्याऽहं संप्रवक्ष्यामि फलं सुविपुलं महत् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006159099, "chapter_id": 26159, "verse_number": "१-२-२०-१००", "content_sanskrit": "विषं तस्य वरारोहे स्थावरं जंगमं तथा ।\nगात्रं प्राप्य तु सुश्रोणि क्षप्रं तत्प्रतिहन्यते ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006159100, "chapter_id": 26159, "verse_number": "१-२-२०-१०१", "content_sanskrit": "शमायत्यशुभं घोरं दुःखप्नं चापकर्षति ।\nस्त्रीषु वल्लभतां याति सभायां पार्थिवस्य च ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006159101, "chapter_id": 26159, "verse_number": "१-२-२०-१०२", "content_sanskrit": "विवादे जयमाप्नोति युद्धे विजयमेव च ।\nगच्छति क्षेममध्वानं गृहेभ्यो नित्यसंपदा ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006159102, "chapter_id": 26159, "verse_number": "१-२-२०-१०३", "content_sanskrit": "शरीरस्येह वक्ष्यामि गतिं तस्य वरानने ।\nहरिश्मश्रुर्नीलकंठः शशांकांकितमूर्द्धजः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006159103, "chapter_id": 26159, "verse_number": "१-२-२०-१०४", "content_sanskrit": "त्र्यक्षस्त्रिशूलपाणिश्च वृष चानः पिनाकधृक् ।\nनंदितुल्यबलः श्रीमान्नंदितुल्यपराक्रमः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006159104, "chapter_id": 26159, "verse_number": "१-२-२०-१०५", "content_sanskrit": "विचरत्यखिलाँल्लोकाम्सप्तलोकान्ममाज्ञया ।\nन हन्यते गति स्तस्य अनिलस्य यथांबरे ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006159105, "chapter_id": 26159, "verse_number": "१-२-२०-१०६", "content_sanskrit": "मम तुल्यबलो भूत्वा तिष्ठत्याभूतसंप्लवात् ।\nमम भक्तया वरारोहे ये च श्रृम्वंति मानवाः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7006159106, "chapter_id": 26159, "verse_number": "१-२-२०-१०७", "content_sanskrit": "तेषां गतिं प्रवक्ष्यामि त्विह लोके परत्र च ।\nब्राह्मणो वेदमाप्नोति क्षत्रियो विंदते महीम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7006159107, "chapter_id": 26159, "verse_number": "१-२-२०-१०८", "content_sanskrit": "वैश्यस्तु लभते लाभं शूद्रः सुखमवाप्नुयात् ।\nव्याधितो मुच्यते रोगाद्बद्धो मुच्येत बंधनात् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7006159108, "chapter_id": 26159, "verse_number": "१-२-२०-१०९", "content_sanskrit": "गुर्विणी लभते पुत्रं कन्या विदति सत्पतिम् ।\nनष्टं च लभते द्रव्यमिह लोके परत्र च ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7006159109, "chapter_id": 26159, "verse_number": "१-२-२०-११०", "content_sanskrit": "गवां शतसहस्रस्य सम्यग्दत्तस्य यत्फलम् ।\nतत्फलं लभते मर्त्यः श्रुत्वा दिव्या मिमां कथाम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7006159110, "chapter_id": 26159, "verse_number": "१-२-२०-१११", "content_sanskrit": "पादं वाथार्द्धपादं वा श्र्लोकं श्र्लोकार्द्धमेव वा ।\nयस्तु धारयते नित्यं रुद्रलोकं स गच्छति ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7006159111, "chapter_id": 26159, "verse_number": "१-२-२०-११२", "content_sanskrit": "अथवा सर्वमेवेदं देवब्राह्मणसन्निधौ ।\nयः पठेन्मानवो नित्यं मद्गतेनांतरात्मना ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7006159112, "chapter_id": 26159, "verse_number": "१-२-२०-११३", "content_sanskrit": "श्रद्धधानः सदा भक्तो रूद्रलोकं स गच्छति ।\nपठेच्च देवि भक्त्या च पाठयेच्च नरः सदा ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7006159113, "chapter_id": 26159, "verse_number": "१-२-२०-११४", "content_sanskrit": "अतः परतरं स्तोत्रं न भूतं न भविष्यति ।\nनापि यक्षाः पिशाचा वा न भूता न विनायकाः ।\nकुर्युर्विघ्नं गृहे तस्य यत्रायं तिष्ठति स्तवः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7006159114, "chapter_id": 26159, "verse_number": "१-२-२०-११५", "content_sanskrit": "मया नु तुष्टेन तवांबुजेक्षणे स्तवस्य माहात्म्यम घौघनाशनम् ।\nनिवेदितं पुण्यफलादियुक्तं स्वयं च कीतं चतुराननेन ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7006159115, "chapter_id": 26159, "verse_number": "१-२-२०-११६", "content_sanskrit": "कथामिमां पुण्यफलादियुक्तां निवेद्य देव्यै शशिबद्धमूर्द्धजः ।\nवृषस्य पृष्ठेन सहोमया प्रभुजगाम कैलासगुहां गुहप्रियः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7006159116, "chapter_id": 26159, "verse_number": "१-२-२०-११७", "content_sanskrit": "श्रुतं मया पापहरं तदंतिके निवेदितं तेऽथ मया प्रजापतेः ।\nअधीत्य सर्वं त्वखिलं सलक्षणं प्रयाति चादित्यपदं द्विजोत्तमः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}]